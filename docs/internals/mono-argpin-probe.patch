+
+// PROBE: parameter `i` of call `ix` at its call row's binding (rep row where the row is keyed there).
+export function callParamBoundTyProbe(ix: i32, i: i32): i32 {
+  const r = callBindRowOf(ix)
+  if r < 0 { return -1 }
+  const decl = elabCallDeclOf(ix)
+  if decl < 0 || decl >= P.nodes.length { return -1 }
+  const sig = nodeTyIxOf(decl)
+  if sig < 0 || sig >= T.tys.length { return -1 }
+  const f = tyAt(sig)
+  if !(f is TyFunc) || i < 0 || i >= f.fnParamTypes.length { return -1 }
+  const tys = if callBindRepKeyedAt(r) { callBindRepTysAt(r) } else { callBindTysAt(r) }
+  const q = inferQuiet
+  inferQuiet = true
+  const rt = substTyDeep(f.fnParamTypes[i], callBindNamesAt(r), tys)
+  inferQuiet = q
+  if rt < 0 || tyHasTyVar(rt) || tyHasHole(rt) { -1 } else { rt }
+}
