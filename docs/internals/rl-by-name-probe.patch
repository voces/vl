+// PROBE: notes how the by-name row `byName` compares with the row element type `colTy` keys.
+export function rlNameProbe(site: string, byName: i32, colTy: i32): i32 {
+  if !repShadowOn { return 0 }
+  const col = rlSlotOfRowTy(rlRowTyOfElem(colTy))
+  let d = "EQ"
+  if byName < 0 && col < 0 { d = "NONE" } else if byName < 0 { d = "COLONLY" } else if col < 0 { d = "NAMEONLY" } else if byName != col { d = "NE" }
+  repABNote("rlname", site, d)
+  0
+}
