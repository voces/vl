type Color = "red" | "green"
type B = { kind: "b", y: string }
function color(p) {
  match p {
    "green" => print(0)
  }
}
function value(p) {
  match p {
    B => print(p.y)
  }
  match p {
    string => print(p + "!")
  }
  match p {
    "green" => print(0)
  }
}
function nullable(p) {
  match p {
    "red" => print(1)
    "green" => print(0)
    null => print(-1)
  }
}
function wild(p) {
  match p {
    "red" => print(1)
  }
}
const c: Color | null = null
nullable(c)
nullable("red")
