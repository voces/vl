// Bit-counting intrinsics: popcnt / clz / ctz over a dense integer sweep of 1..n.
// VL exposes all three as free functions that take their width from the operand.
function main() {
  const n: i32 = 200_000_000
  let sum: i64 = 0
  let i: i32 = 0
  while i < n {
    const v: i32 = i + 1
    sum = sum + (popcnt(v) as i64) + (clz(v) as i64) + (ctz(v) as i64)
    i = i + 1
  }
  print(sum)
}
main()
