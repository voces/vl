// Float ops with no transcendentals: sqrt, abs, floor, min, max.
// Each is a single wasm opcode in VL, exposed as a width-directed free function.
// The five terms are summed into `term` first so that every runtime performs the
// additions in the identical order — float addition is not associative.
function main() {
  const n: i32 = 200_000_000
  let s: f64 = 0.0
  let i: i32 = 0
  while i < n {
    const t: f64 = ((i & 1023) as f64) + 0.5
    const term: f64 = sqrt(t) +
      abs(t - 512.0) * 0.001 +
      floor(t * 0.25) * 0.001 +
      min(t, 100.0) * 0.001 +
      max(t, 900.0) * 0.001
    s = s + term
    i = i + 1
  }
  print(s)
}
main()
