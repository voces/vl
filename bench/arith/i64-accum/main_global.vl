// SAME i64 accumulate, but every binding is TOP-LEVEL, so `sum`/`i`/`n` are module
// globals rather than function locals. Pairs with main.vl to quantify the globals cliff.
const n: i64 = 1_000_000_000
let sum: i64 = 0
let i: i64 = 0
while i < n {
  sum = sum + (i & 65535)
  i = i + 1
}
print(sum)
