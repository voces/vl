// Mixed-width arithmetic: three accumulators of three widths driven off one i32
// induction variable, with every cross-width step written as an explicit `as` cast
// (VL widens implicitly only when the widening is lossless).
function main() {
  const n: i32 = 300_000_000
  let si: i32 = 0
  let sl: i64 = 0
  let sf: f64 = 0.0
  let i: i32 = 0
  while i < n {
    si = si + (i & 1023)
    sl = sl + ((i & 4095) as i64) * 7
    sf = sf + ((i & 63) as f64) * 0.1
    i = i + 1
  }
  print(si)
  print(sl)
  print(sf)
}
main()
