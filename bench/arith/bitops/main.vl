// Bit manipulation: xorshift32 (three shift/xor rounds), a rotate, and an and/or
// reduction. Every operand stays a 32-bit pattern; `>>>` is the logical shift.
function main() {
  const n: i32 = 200_000_000
  let x: i32 = 123456789
  let sum: i32 = 0
  let i: i32 = 0
  while i < n {
    x = x ^ (x << 13)
    x = x ^ (x >>> 17)
    x = x ^ (x << 5)
    x = rotl(x, 7)
    sum = sum + ((x & 65535) | (x >>> 24))
    i = i + 1
  }
  print(sum)
}
main()
