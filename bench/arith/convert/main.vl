// i32 <-> f64 round trip: widen an integer to a double, scale it, truncate back.
// Both conversions are explicit `as` casts; VL never inserts a lossy widening.
function main() {
  const n: i32 = 400_000_000
  let sum: i64 = 0
  let i: i32 = 0
  while i < n {
    const f: f64 = (i & 65535) as f64
    const k: i32 = (f * 1.5 + 0.25) as i32
    sum = sum + (k as i64)
    i = i + 1
  }
  print(sum)
}
main()
