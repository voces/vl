// HAND-OPTIMIZED variant (NOT the idiomatic spelling — see main.vl).
// One divide instead of two: the remainder is recovered as `i - q * d` rather than
// asking for `i % d` a second time. x86 IDIV already produces quotient and remainder
// together, so a backend that recognised the pair would make this rewrite pointless.
function main() {
  const n: i32 = 200_000_000
  let sum: i32 = 0
  let i: i32 = 0
  while i < n {
    const d: i32 = (i & 1023) + 1
    const q: i32 = i / d
    sum = sum + q + (i - q * d)
    i = i + 1
  }
  print(sum)
}
main()
