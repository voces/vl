// Integer divide and modulo by a loop-varying divisor, so no strength reduction is
// possible and a real hardware divide runs every iteration. All operands are
// non-negative, so truncating and flooring division agree across the four runtimes.
function main() {
  const n: i32 = 200_000_000
  let sum: i32 = 0
  let i: i32 = 0
  while i < n {
    const d: i32 = (i & 1023) + 1
    sum = sum + i / d + i % d
    i = i + 1
  }
  print(sum)
}
main()
