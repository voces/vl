// i32 accumulate: wrapping 32-bit sum of a masked induction variable.
// The mask keeps LLVM's scalar-evolution pass from closing the loop into n*(n-1)/2.
function main() {
  const n: i32 = 1_000_000_000
  let sum: i32 = 0
  let i: i32 = 0
  while i < n {
    sum = sum + (i & 65535)
    i = i + 1
  }
  print(sum)
}
main()
