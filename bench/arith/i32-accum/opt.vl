// HAND-OPTIMIZED variant (NOT the idiomatic spelling — see main.vl).
// Four independent partial sums, unrolled 4x, to break the single accumulator
// dependency and hand the backend the instruction-level parallelism that rustc -O
// finds on its own by vectorizing main.rs. i32 addition is associative and exact,
// so the printed result is bit-identical to main.vl.
function main() {
  const n: i32 = 1_000_000_000
  let a: i32 = 0
  let b: i32 = 0
  let c: i32 = 0
  let d: i32 = 0
  let i: i32 = 0
  while i < n {
    a = a + (i & 65535)
    b = b + ((i + 1) & 65535)
    c = c + ((i + 2) & 65535)
    d = d + ((i + 3) & 65535)
    i = i + 4
  }
  print(a + b + c + d)
}
main()
