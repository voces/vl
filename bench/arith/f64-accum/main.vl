// f64 accumulate: sum of a bounded chaotic generator (logistic map, r = 3.9).
// Chaos means no compiler can close the loop, and float addition is non-associative
// so no runtime may reassociate or vectorize it. All bindings are function LOCALS.
function main() {
  const n: i32 = 300_000_000
  let s: f64 = 0.0
  let x: f64 = 0.5
  let i: i32 = 0
  while i < n {
    x = x * 3.9 * (1.0 - x)
    s = s + x
    i = i + 1
  }
  print(s)
}
main()
