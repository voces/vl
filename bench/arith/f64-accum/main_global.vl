// SAME f64 accumulate with every binding TOP-LEVEL, i.e. module globals instead of
// function locals. Pairs with main.vl to quantify the globals cliff.
const n: i32 = 300_000_000
let s: f64 = 0.0
let x: f64 = 0.5
let i: i32 = 0
while i < n {
  x = x * 3.9 * (1.0 - x)
  s = s + x
  i = i + 1
}
print(s)
