// Deep LINEAR NON-TAIL recursion at depth 5_000, repeated.
// The combine happens AFTER the recursive call returns, and it is
// `f(n-1) * 3 + n` rather than a plain sum, so no compiler can rewrite it into
// an accumulator loop -- all four runtimes really do build 5_000 frames.
// `seed` threads the caller's accumulator through, so the call is not loop
// invariant and cannot be hoisted or constant-folded.
// Paired with bench/recursion/tailcall: same depth, same ops, tail position.
function digest(n: i32, seed: i32): i32 {
  if n == 0 { return seed }
  return (digest(n - 1, seed) * 3 + n) & 1_048_575
}

let acc = 0
let r = 0
while r < 120_000 {
  acc = digest(5_000, acc)
  r = r + 1
}

print(acc)
