// Same program as main.vl with the driver moved inside a function, so `acc`
// and `r` are wasm LOCALS instead of module GLOBALS -- the spelling that
// quantifies the documented top-level-let cliff on a recursion-heavy shape.
function digest(n: i32, seed: i32): i32 {
  if n == 0 { return seed }
  return (digest(n - 1, seed) * 3 + n) & 1_048_575
}

function main() {
  let acc = 0
  let r = 0
  while r < 120_000 {
    acc = digest(5_000, acc)
    r = r + 1
  }
  print(acc)
}

main()
