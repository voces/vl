// A flat loop that calls a tiny leaf function N times.
// Paired with bench/recursion/flatcall-inlined, which is the SAME loop with
// `step`'s body written out. The difference between the two is the per-call
// cost; the body itself is xor + mul + add + and.
// `acc` feeds the next iteration's argument, so the loop is a genuine serial
// dependency chain that cannot be vectorized or reassociated away.
// The inner bound is capped at 600M rather than raised, because `(acc ^ i) * 3`
// must stay inside i32 in all four languages; the outer loop supplies the rest.
function step(x: i32): i32 { return (x * 3 + 1) & 1_048_575 }

let acc = 0
let r = 0
while r < 2 {
  let i = 0
  while i < 600_000_000 {
    acc = step(acc ^ i)
    i = i + 1
  }
  r = r + 1
}

print(acc)
