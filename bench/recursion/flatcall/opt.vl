// Same program as main.vl with the driver moved inside a function, so `acc`,
// `r` and `i` are wasm LOCALS instead of module GLOBALS. This is the spelling
// that quantifies the documented top-level-let cliff.
function step(x: i32): i32 { return (x * 3 + 1) & 1_048_575 }

function main() {
  let acc = 0
  let r = 0
  while r < 2 {
    let i = 0
    while i < 600_000_000 {
      acc = step(acc ^ i)
      i = i + 1
    }
    r = r + 1
  }
  print(acc)
}

main()
