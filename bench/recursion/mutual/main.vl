// MUTUAL recursion: evenStep and oddStep call each other all the way down, so
// the descent alternates between two functions and neither can be resolved
// without the other. Which one lands on the base case encodes the parity of n
// -- oddStep's base applies one extra transform -- so this is the isEven/isOdd
// shape with a digest `s` threaded through it.
//
// The digest is load-bearing, not decoration: with the classic
//   isEven(n) = if n == 0 { 1 } else { isOdd(n - 1) }
// rustc -O collapses the whole cycle to an O(1) parity test (verified:
// is_even(2_000_000_000) returns instantly), and the benchmark measures
// nothing. `s * 3 + 1` / `s * 5 + 2` is a multiplicative recurrence LLVM cannot
// close-form, so all four runtimes really do walk every level.
// `acc` also seeds the call, which stops the inner loop being loop-invariant.
// Depth is bounded by 800, so CPython runs this under its default recursion
// limit of 1000 unchanged.
function evenStep(n: i32, s: i32): i32 {
  if n == 0 { return s }
  return oddStep(n - 1, (s * 3 + 1) & 1_048_575)
}

function oddStep(n: i32, s: i32): i32 {
  if n == 0 { return (s * 7 + 5) & 1_048_575 }
  return evenStep(n - 1, (s * 5 + 2) & 1_048_575)
}

let acc = 0
let r = 0
while r < 2_500 {
  let i = 0
  while i < 800 {
    acc = evenStep(i + (acc & 1), acc)
    i = i + 1
  }
  r = r + 1
}

print(acc)
