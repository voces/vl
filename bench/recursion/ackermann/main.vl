// Ackermann as a pure call-overhead stress: ack(3,10) is 44_698_325 calls to
// produce a single number 8_189, and the body is nothing but two compares, two
// decrements and a NESTED recursive call in argument position. Nothing here can
// be strength-reduced, memoized or vectorized; it is very close to a pure
// measurement of how much a call costs.
// `10 - (acc & 1)` alternates between ack(3,10) and ack(3,9) so the call is not
// loop-invariant and cannot be hoisted out of the repeat loop.
// Peak recursion depth is 8_190 frames.
function ack(m: i32, n: i32): i32 {
  if m == 0 { return n + 1 }
  if n == 0 { return ack(m - 1, 1) }
  return ack(m - 1, ack(m, n - 1))
}

let acc = 0
let r = 0
while r < 20 {
  acc = (acc + ack(3, 10 - (acc & 1))) % 1_000_003
  r = r + 1
}

print(acc)
