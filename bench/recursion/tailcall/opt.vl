// HAND-OPTIMIZED — DO NOT read this as a recommendation. It exists only to
// quantify what the idiomatic tail recursion in main.vl leaves on the table.
// The recursion is unrolled BY HAND into a while loop; it computes exactly the
// same value. That a user would have to do this is the defect: VL emits a plain
// `call` in tail position instead of wasm `return_call`, which both costs ~2x
// and caps the recursion at ~16_200 frames. Patching the SAME emitted module's
// `call` to `return_call` (binaryen wasm-as --enable-tail-call, run on the
// unmodified vl host) reproduces this speedup without any source change.
function digestLoop(n: i32, acc: i32): i32 {
  let a = acc
  let k = n
  while k > 0 {
    a = (a * 3 + k) & 1_048_575
    k = k - 1
  }
  return a
}

let acc = 0
let r = 0
while r < 120_000 {
  acc = digestLoop(5_000, acc)
  r = r + 1
}

print(acc)
