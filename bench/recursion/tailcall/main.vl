// The TAIL-POSITION twin of bench/recursion/deeprec: same depth, same ops per
// level, but the combine happens BEFORE the recursive call, so the call is the
// entire return expression. A runtime with proper tail calls (wasm
// `return_call`, or LLVM's tail-call elimination) needs O(1) stack for this;
// one without it needs 5_000 frames, exactly like deeprec.
function digestTail(n: i32, acc: i32): i32 {
  if n == 0 { return acc }
  return digestTail(n - 1, (acc * 3 + n) & 1_048_575)
}

let acc = 0
let r = 0
while r < 120_000 {
  acc = digestTail(5_000, acc)
  r = r + 1
}

print(acc)
