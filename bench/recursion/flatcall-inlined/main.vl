// The CONTROL for bench/recursion/flatcall: the identical loop with `step`'s
// body written out at the call site. Same N, same arithmetic, same output.
// time(flatcall) - time(flatcall-inlined) IS the per-call overhead of a static
// direct call to a tiny leaf function.
let acc = 0
let r = 0
while r < 2 {
  let i = 0
  while i < 600_000_000 {
    acc = ((acc ^ i) * 3 + 1) & 1_048_575
    i = i + 1
  }
  r = r + 1
}

print(acc)
