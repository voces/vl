// A recursive walk over a REAL recursive heap structure: a perfect binary tree
// of depth 19 (1_048_575 nodes), built recursively and then summed recursively.
// Unlike the arithmetic benchmarks this one is pointer-chasing: every level is
// a null test plus a field load plus a call, so it measures recursion over
// heap-allocated nodes rather than over registers.
type Tree = { value: i32, left: Tree | null, right: Tree | null }

function build(depth: i32, v: i32): Tree {
  if depth == 0 { return { value: v, left: null, right: null } }
  return {
    value: v,
    left: build(depth - 1, (v * 2) % 1_000),
    right: build(depth - 1, (v * 2 + 1) % 1_000),
  }
}

function sum(t: Tree): i32 {
  let s = t.value
  if t.left != null { s = s + sum(t.left) }
  if t.right != null { s = s + sum(t.right) }
  return s
}

const tree = build(19, 1)

let acc = 0
let r = 0
while r < 150 {
  // Mutating the root each pass keeps the walk from being loop-invariant:
  // without this, rustc hoists all 150 walks into one.
  tree.value = (tree.value + 1) % 1_000
  acc = (acc + sum(tree)) % 1_000_000_007
  r = r + 1
}

print(acc)
