// fill-sum — allocate an i32 array of N, then ROUNDS rounds of (fill in place, sum).
// Axis: hot-loop element write + read on a pre-allocated array; per-access bounds
// checks. The array is allocated ONCE and rewritten in place, so growth/allocation
// is not part of the steady-state measurement.
const N = 2_000_000
const ROUNDS = 200

function run(n: i32, rounds: i32): i64 {
  const a: i32[] = []
  let i = 0
  while i < n {
    a.push(0)
    i = i + 1
  }
  let total: i64 = 0
  let r = 0
  while r < rounds {
    i = 0
    while i < n {
      a[i] = (i + r) & 65535
      i = i + 1
    }
    let s: i64 = 0
    i = 0
    while i < n {
      s = s + a[i] as i64
      i = i + 1
    }
    total = total + s
    r = r + 1
  }
  return total
}

function main() {
  print(run(N, ROUNDS))
}
main()
