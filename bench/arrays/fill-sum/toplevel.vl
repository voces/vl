// fill-sum, TOP-LEVEL spelling — byte-for-byte the same algorithm as main.vl, but
// written as a script (no enclosing function), which is the natural first spelling in
// a "scripting-feel" language. Every binding here is a module GLOBAL rather than a
// function LOCAL. Measures the globals-vs-locals cliff; NOT a separate algorithm.
const N = 2_000_000
const ROUNDS = 200

const a: i32[] = []
let i = 0
while i < N {
  a.push(0)
  i = i + 1
}
let total: i64 = 0
let r = 0
while r < ROUNDS {
  i = 0
  while i < N {
    a[i] = (i + r) & 65535
    i = i + 1
  }
  let s: i64 = 0
  i = 0
  while i < N {
    s = s + a[i] as i64
    i = i + 1
  }
  total = total + s
  r = r + 1
}
print(total)
