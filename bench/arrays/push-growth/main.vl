// push-growth — build a list of N elements from EMPTY by repeated push, ROUNDS times.
// Axis: growth amortization (reallocate + copy on capacity overflow) plus the push
// fast path itself. Each round starts from a fresh empty list, so every round pays
// the full geometric-growth schedule. The result is consumed by sampling every 64th
// element (cheap relative to the pushes, but enough to defeat dead-code elimination).
const N = 1_000_000
const ROUNDS = 200

function run(n: i32, rounds: i32): i64 {
  let total: i64 = 0
  let r = 0
  while r < rounds {
    const a: i32[] = []
    let i = 0
    while i < n {
      a.push((i ^ r) & 1023)
      i = i + 1
    }
    total = total + a.length as i64
    i = 0
    while i < n {
      total = total + a[i] as i64
      i = i + 64
    }
    r = r + 1
  }
  return total
}

function main() {
  print(run(N, ROUNDS))
}
main()
