// struct-aos — ARRAY OF STRUCTS traversal. N records of four i32 fields; each pass
// reads two of the four fields (x and z) from every record. The companion benchmark
// `struct-soa` computes the BYTE-IDENTICAL result from four parallel scalar arrays,
// so the pair isolates the layout cost: AoS touches a whole record's worth of memory
// (and, on a WasmGC/JS heap, chases one pointer per element) to use half its fields.
// The `^ r` makes every round's sum genuinely depend on the round, so no round can be
// hoisted out as loop-invariant.
type P = { x: i32, y: i32, z: i32, w: i32 }

const N = 1_000_000
const ROUNDS = 500

function run(n: i32, rounds: i32): i64 {
  const ps: P[] = []
  let i = 0
  while i < n {
    ps.push({ x: i & 1023, y: (i * 3) & 1023, z: (i * 7) & 1023, w: (i * 11) & 1023 })
    i = i + 1
  }
  let total: i64 = 0
  let r = 0
  while r < rounds {
    let s: i64 = 0
    i = 0
    while i < n {
      const p = ps[i]
      s = s + ((p.x ^ r) + p.z) as i64
      i = i + 1
    }
    total = total + s
    r = r + 1
  }
  return total
}

function main() {
  print(run(N, ROUNDS))
}
main()
