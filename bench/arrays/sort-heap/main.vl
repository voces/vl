// sort-heap — HAND-WRITTEN heapsort (iterative sift-down), the SAME algorithm in all
// four languages. Deliberately NOT a library sort: nothing here calls Array.sort /
// sort_unstable / sorted, so this measures the language's array read/write/compare
// path, not a library. Axis: branchy, cache-hostile random access over a large array.
// Each round re-seeds the array from a continuing MINSTD stream, so every round sorts
// fresh unsorted data and the work is linear in ROUNDS.
const N = 1_000_000
const ROUNDS = 4

// NOTE: the sift-down loop uses an explicit `cont` flag instead of an early `return`
// because VL's emitter rejects a bare `return` in a void function
// ("emitProgram: bare return is not supported" — `vl check` reports it clean). The
// SAME flag restructuring is applied to all four languages so they stay equivalent.
function siftDown(a: i32[], start: i32, last: i32) {
  let root = start
  let cont = true
  while cont && root * 2 + 1 <= last {
    let child = root * 2 + 1
    if child + 1 <= last {
      if a[child] < a[child + 1] {
        child = child + 1
      }
    }
    if a[root] < a[child] {
      const t = a[root]
      a[root] = a[child]
      a[child] = t
      root = child
    } else {
      cont = false
    }
  }
}

function heapsort(a: i32[], n: i32) {
  let i = (n - 2) >> 1
  while i >= 0 {
    siftDown(a, i, n - 1)
    i = i - 1
  }
  let last = n - 1
  while last > 0 {
    const t = a[0]
    a[0] = a[last]
    a[last] = t
    last = last - 1
    siftDown(a, 0, last)
  }
}

function run(n: i32, rounds: i32): i64 {
  const a: i32[] = []
  let i = 0
  while i < n {
    a.push(0)
    i = i + 1
  }
  let seed: i64 = 123456789
  let chk: i64 = 0
  let inv: i64 = 0
  let lastSum: i64 = 0
  let r = 0
  while r < rounds {
    i = 0
    while i < n {
      seed = (seed * 48271) % 2147483647
      a[i] = seed as i32
      i = i + 1
    }
    heapsort(a, n)
    i = 0
    while i < n {
      chk = chk + a[i] as i64
      i = i + 4096
    }
    i = 1
    while i < n {
      if a[i - 1] > a[i] {
        inv = inv + 1
      }
      i = i + 1
    }
    lastSum = 0
    i = 0
    while i < n {
      lastSum = lastSum + a[i] as i64
      i = i + 1
    }
    r = r + 1
  }
  print(chk)
  print(inv)
  return lastSum
}

function main() {
  print(run(N, ROUNDS))
}
main()
