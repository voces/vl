// reverse-inplace, TOP-LEVEL spelling — the same algorithm as main.vl written as a
// script with no enclosing function, so every binding is a module GLOBAL instead of a
// function LOCAL. Second data point for the globals-vs-locals cliff (the first is
// fill-sum/toplevel.vl). NOT a separate algorithm.
const N = 4_000_000
const ROUNDS = 400

const a: i32[] = []
let i = 0
while i < N {
  a.push((i * 7 + 3) & 1048575)
  i = i + 1
}
let chk: i64 = 0
let r = 0
while r < ROUNDS {
  const bump = r % N
  a[bump] = a[bump] + 1
  let lo = 0
  let hi = N - 1
  while lo < hi {
    const t = a[lo]
    a[lo] = a[hi]
    a[hi] = t
    lo = lo + 1
    hi = hi - 1
  }
  i = 0
  while i < N {
    chk = chk + a[i] as i64
    i = i + 65536
  }
  r = r + 1
}
print(chk)
