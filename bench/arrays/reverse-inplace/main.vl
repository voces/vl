// reverse-inplace — two-pointer in-place reverse of an N-element i32 array, ROUNDS
// times. Axis: pure element read/write with two cursors walking toward each other
// (streaming from both ends), i.e. two bounds-checked reads and two bounds-checked
// writes per iteration with no arithmetic to hide them behind.
// One element is bumped at the start of every round so that "reverse twice is the
// identity" is not true and no round can be folded away; the result is consumed by
// sampling every 65536th element.
const N = 4_000_000
const ROUNDS = 400

function run(n: i32, rounds: i32): i64 {
  const a: i32[] = []
  let i = 0
  while i < n {
    a.push((i * 7 + 3) & 1048575)
    i = i + 1
  }
  let chk: i64 = 0
  let r = 0
  while r < rounds {
    const bump = r % n
    a[bump] = a[bump] + 1
    let lo = 0
    let hi = n - 1
    while lo < hi {
      const t = a[lo]
      a[lo] = a[hi]
      a[hi] = t
      lo = lo + 1
      hi = hi - 1
    }
    i = 0
    while i < n {
      chk = chk + a[i] as i64
      i = i + 65536
    }
    r = r + 1
  }
  return chk
}

function main() {
  print(run(N, ROUNDS))
}
main()
