// binsearch — QUERIES binary searches over a sorted i32 array of N elements.
// Axis: latency-bound, unpredictable random access over a working set far larger
// than L2, with a data-dependent branch per step. ~log2(N) probes per query.
// Keys come from a MINSTD stream over [0, 3N), and the array holds 0,3,6,...,
// so about one query in three hits.
const N = 4_000_000
const QUERIES = 6_000_000

function bsearch(a: i32[], n: i32, key: i32): i32 {
  let lo = 0
  let hi = n - 1
  let found = -1
  while lo <= hi {
    const mid = (lo + hi) >> 1
    const v = a[mid]
    if v < key {
      lo = mid + 1
    } else {
      if v > key {
        hi = mid - 1
      } else {
        found = mid
        lo = hi + 1
      }
    }
  }
  return found
}

function run(n: i32, queries: i32): i64 {
  const a: i32[] = []
  let i = 0
  while i < n {
    a.push(i * 3)
    i = i + 1
  }
  let seed: i64 = 987654321
  let hits: i64 = 0
  let idxSum: i64 = 0
  let q = 0
  while q < queries {
    seed = (seed * 48271) % 2147483647
    const key = (seed % (3 * n as i64)) as i32
    const idx = bsearch(a, n, key)
    if idx >= 0 {
      hits = hits + 1
      idxSum = idxSum + idx as i64
    }
    q = q + 1
  }
  print(hits)
  return idxSum
}

function main() {
  print(run(N, QUERIES))
}
main()
