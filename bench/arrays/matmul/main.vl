// matmul — naive dense N x N f64 matrix multiply, i-k-j order, over FLAT arrays
// (row-major, index i*n+j). Axis: cache behaviour on a 3-deep loop nest plus the
// per-access bounds check on the innermost read/modify/write. ROUNDS repeats the
// multiply ACCUMULATING into the same C (no re-zeroing), so the work is exactly
// linear in ROUNDS and no round can be folded away.
const N = 600
const ROUNDS = 3

function run(n: i32, rounds: i32): i64 {
  const a: f64[] = []
  const b: f64[] = []
  const c: f64[] = []
  let i = 0
  while i < n * n {
    a.push(((i * 31 + 7) % 97) as f64 * 0.125 - 6.0)
    b.push(((i * 17 + 3) % 89) as f64 * 0.125 - 5.5)
    c.push(0.0)
    i = i + 1
  }
  let r = 0
  while r < rounds {
    i = 0
    while i < n {
      let k = 0
      while k < n {
        const aik = a[i * n + k]
        let j = 0
        while j < n {
          c[i * n + j] = c[i * n + j] + aik * b[k * n + j]
          j = j + 1
        }
        k = k + 1
      }
      i = i + 1
    }
    r = r + 1
  }
  let s = 0.0
  i = 0
  while i < n * n {
    s = s + c[i]
    i = i + 1
  }
  return (s * 1000.0) as i64
}

function main() {
  print(run(N, ROUNDS))
}
main()
