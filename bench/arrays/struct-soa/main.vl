// struct-soa — STRUCT OF ARRAYS traversal: the same records as `struct-aos`, but held
// as four parallel scalar arrays. Each pass reads only the two arrays it needs (xs and
// zs), so it touches half the bytes of the AoS twin and does one indexed load per field
// instead of an indexed load plus a field load through a per-record reference.
// Prints the BYTE-IDENTICAL result to struct-aos, so the pair is a clean layout A/B.
const N = 1_000_000
const ROUNDS = 500

function run(n: i32, rounds: i32): i64 {
  const xs: i32[] = []
  const ys: i32[] = []
  const zs: i32[] = []
  const ws: i32[] = []
  let i = 0
  while i < n {
    xs.push(i & 1023)
    ys.push((i * 3) & 1023)
    zs.push((i * 7) & 1023)
    ws.push((i * 11) & 1023)
    i = i + 1
  }
  let total: i64 = 0
  let r = 0
  while r < rounds {
    let s: i64 = 0
    i = 0
    while i < n {
      s = s + ((xs[i] ^ r) + zs[i]) as i64
      i = i + 1
    }
    total = total + s
    r = r + 1
  }
  return total
}

function main() {
  print(run(N, ROUNDS))
}
main()
