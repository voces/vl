// slice-extract — HAND-OPTIMISED VL. Not a recommendation: a defect witness.
//
// The idiomatic spelling in main.vl asks for the window as a value
// (`s.slice(i, i + W)`) and then reads it. VL materialises that window: a
// fresh WasmGC i32 array plus a copy, per offset. Rust's `&s[i..i+W]` costs
// nothing at all, and V8 can back a slice with a view. The only way to avoid
// the copy in VL is to give up on having the substring as a value and index
// the parent string with a biased offset.
//
// Same output as main.vl.

const ALPHA = "abcdefghijklmnopqrstuvwxyz"

const LEN = 200_000
const W = 12
const PASSES = 180

function buildInput(n: i32): string {
  let chunk = ""
  let i = 0
  while i < 1024 {
    const k = (i * 31 + (i / 7) * 17) % 26
    chunk = chunk + ALPHA.slice(k, k + 1)
    i = i + 1
  }
  let s = chunk
  while s.length < n { s = s + s }
  return s.slice(0, n)
}

function main() {
  const s = buildInput(LEN)
  let acc: i64 = 0
  let r = 0
  while r < PASSES {
    let i = 0
    const limit = s.length - W
    while i <= limit {
      let h = 0
      let j = 0
      while j < W {
        h = (h * 31 + s[i + j]) % 1_000_003
        j = j + 1
      }
      acc = acc + h
      i = i + 1
    }
    r = r + 1
  }
  print(acc)
}

main()
