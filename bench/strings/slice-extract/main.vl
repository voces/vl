// slice-extract — sliding-window substring extraction.
// Axis: cost of producing a substring (`s.slice(a,b)`) and reading it back.
// A W-character window is extracted at every offset of a long ASCII string
// and hashed; the windows are re-extracted PASSES times.
//
// STRUCTURAL NOTE: in Rust `&s[i..i+W]` is a BORROW — no allocation, no copy —
// so Rust measures the hash only. VL, JS and Python all materialise a new
// string per window (V8 may use a SlicedString view for long slices; VL and
// CPython always copy). That difference is the point of the benchmark, not a
// flaw in it.

const ALPHA = "abcdefghijklmnopqrstuvwxyz"

const LEN = 200_000
const W = 12
const PASSES = 180

function buildInput(n: i32): string {
  let chunk = ""
  let i = 0
  while i < 1024 {
    const k = (i * 31 + (i / 7) * 17) % 26
    chunk = chunk + ALPHA.slice(k, k + 1)
    i = i + 1
  }
  let s = chunk
  while s.length < n { s = s + s }
  return s.slice(0, n)
}

function main() {
  const s = buildInput(LEN)
  let acc: i64 = 0
  let r = 0
  while r < PASSES {
    let i = 0
    const limit = s.length - W
    while i <= limit {
      const t = s.slice(i, i + W)
      let h = 0
      let j = 0
      while j < W {
        h = (h * 31 + t[j]) % 1_000_003
        j = j + 1
      }
      acc = acc + h
      i = i + 1
    }
    r = r + 1
  }
  print(acc)
}

main()
