// int-format — integer to decimal string.
// Axis: the number->string formatter, plus reading the produced digits back.
// N integers (one in five negative) are rendered and every produced character
// is summed, so the digits themselves are part of the checked output. The
// value sequence is an LCG that stays below 10^6, so no runtime ever has to
// wrap or promote, at any N.

const N = 30_000_000

function main() {
  let totalLen: i64 = 0
  let acc: i64 = 0
  let v = 1
  let i = 0
  while i < N {
    v = (v * 31 + 17) % 999_983
    let out = v
    if i % 5 == 0 { out = 0 - out }
    const s = toString(out)
    totalLen = totalLen + s.length
    let j = 0
    while j < s.length {
      acc = acc + s[j]
      j = j + 1
    }
    i = i + 1
  }
  print(totalLen)
  print(acc)
}

main()
