// int-format — VARIANT (not an optimisation): the same program with the
// `toString(i32)` compiler builtin replaced by `std:fmt`'s pure-VL `toStr()`.
// It prices the library renderer (a `digitChar` ladder + a `+`-prepend loop
// through i64) against the intrinsic, so the cost of "the same thing written
// in VL" is on the record. Same output as main.vl.

import { toStr } from "std:fmt"

const N = 30_000_000

function main() {
  let totalLen: i64 = 0
  let acc: i64 = 0
  let v = 1
  let i = 0
  while i < N {
    v = (v * 31 + 17) % 999_983
    let out = v
    if i % 5 == 0 { out = 0 - out }
    const s = toStr(out)
    totalLen = totalLen + s.length
    let j = 0
    while j < s.length {
      acc = acc + s[j]
      j = j + 1
    }
    i = i + 1
  }
  print(totalLen)
  print(acc)
}

main()
