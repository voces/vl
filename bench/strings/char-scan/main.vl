// char-scan — scan a long ASCII string character by character.
// Axis: per-character read throughput (`s[i]`) plus a cheap predicate.
// All four runtimes build the SAME 1_000_000-char ASCII string and scan it
// PASSES times, summing code points and counting vowels.

const ALPHA = "abcdefghijklmnopqrstuvwxyz"

const LEN = 1_000_000
const PASSES = 600

// Deterministic ASCII input: a varied 1024-char chunk, then doubled up to LEN.
// Doubling keeps the build O(n) in every runtime so it does not dominate.
function buildInput(n: i32): string {
  let chunk = ""
  let i = 0
  while i < 1024 {
    if i % 9 == 8 {
      chunk = chunk + " "
    } else {
      const k = (i * 31 + (i / 7) * 17) % 26
      chunk = chunk + ALPHA.slice(k, k + 1)
    }
    i = i + 1
  }
  let s = chunk
  while s.length < n { s = s + s }
  return s.slice(0, n)
}

function main() {
  const s = buildInput(LEN)
  let acc: i64 = 0
  let vowels = 0
  let r = 0
  while r < PASSES {
    let i = 0
    while i < s.length {
      const c = s[i]
      acc = acc + c
      if c == 97 || c == 101 || c == 105 || c == 111 || c == 117 {
        vowels = vowels + 1
      }
      i = i + 1
    }
    r = r + 1
  }
  print(acc)
  print(vowels)
}

main()
