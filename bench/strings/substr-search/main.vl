// substr-search — `indexOf` of a 12-character needle in a 1_000_000-char text.
// Axis: the substring search routine itself. Half the needles are present near
// the front (cheap); half contain an uppercase 'Q', which never occurs in the
// input, so they force a full scan of the whole text.
//
// API NOTE: VL's `indexOf` takes no start offset, so "find every occurrence"
// is not expressible without re-slicing the remainder (quadratic). This
// benchmark therefore searches many DIFFERENT needles rather than iterating
// occurrences of one.

const ALPHA = "abcdefghijklmnopqrstuvwxyz"

const LEN = 1_000_000
const NEEDLE_W = 12
const NN = 16
const PASSES = 60

function buildInput(n: i32): string {
  let chunk = ""
  let i = 0
  while i < 16_384 {
    const k = (i * 31 + (i / 7) * 17 + (i / 601) * 5) % 26
    chunk = chunk + ALPHA.slice(k, k + 1)
    i = i + 1
  }
  let s = chunk
  while s.length < n { s = s + s }
  return s.slice(0, n)
}

function main() {
  const s = buildInput(LEN)
  const needles: string[] = []
  let k = 0
  while k < NN {
    const off = k * 977
    const t = s.slice(off, off + NEEDLE_W)
    if k % 2 == 1 {
      needles.push(t.slice(0, 6) + "Q" + t.slice(7, NEEDLE_W))
    } else {
      needles.push(t)
    }
    k = k + 1
  }
  let acc: i64 = 0
  let r = 0
  while r < PASSES {
    let q = 0
    while q < NN {
      acc = acc + s.indexOf(needles[q])
      q = q + 1
    }
    r = r + 1
  }
  print(acc)
}

main()
