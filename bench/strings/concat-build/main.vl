// concat-build — the quadratic trap.
// Axis: repeated single-character append (`s = s + c`), the spelling every
// beginner writes. REPS independent strings of N characters are built; each
// build uses a different character sequence so nothing can be hoisted or
// memoised. Total appends = REPS * N.
//
// Whether a runtime is O(n) or O(n^2) here is the whole point: doubling N
// (not REPS) multiplies an O(n^2) runtime's time by ~4 and an O(n) runtime's
// by ~2. See meta.json for the measured verdict per runtime.

const ALPHA = "abcdefghijklmnopqrstuvwxyz"

const N = 5_000
const REPS = 1_000

function main() {
  let total: i64 = 0
  let r = 0
  while r < REPS {
    let s = ""
    let i = 0
    while i < N {
      const k = (i + r) % 26
      s = s + ALPHA.slice(k, k + 1)
      i = i + 1
    }
    total = total + s.length + s[s.length - 1]
    r = r + 1
  }
  print(total)
}

main()
