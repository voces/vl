// concat-build — HAND-OPTIMISED VL. Not a recommendation: a defect witness.
//
// The idiomatic `s = s + c` loop in main.vl is O(n^2) in VL (every `+`
// allocates a fresh WasmGC code-point array and copies both operands), while
// Rust / deno / Python all make the same spelling amortised O(1). The only
// way out today is to know about the `fromCodePoints(i32[]) -> string`
// builtin, collect code points into an i32[] first, and convert once.
//
// Same output as main.vl.

const ALPHA = "abcdefghijklmnopqrstuvwxyz"

const N = 5_000
const REPS = 1_000

function main() {
  let total: i64 = 0
  let r = 0
  while r < REPS {
    const buf: i32[] = []
    let i = 0
    while i < N {
      const k = (i + r) % 26
      buf.push(ALPHA[k])
      i = i + 1
    }
    const s = fromCodePoints(buf)
    total = total + s.length + s[s.length - 1]
    r = r + 1
  }
  print(total)
}

main()
