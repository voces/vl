// token-count — tokenising scan over a large ASCII text.
// Axis: a character state machine over a long string (the shape every lexer,
// CSV reader and word counter has). Counts maximal runs of non-space
// characters, their total length, and the longest one.
//
// The state machine is written by hand in all four languages so the ALGORITHM
// is identical. Rust's `split_whitespace()` and Python's `str.split()` would
// dispatch to library code with a different cost model; see meta.json notes
// for those measured separately.

const ALPHA = "abcdefghijklmnopqrstuvwxyz"

const LEN = 1_000_000
const PASSES = 1_000

// A 1024-char chunk with irregular spacing (so token lengths vary), doubled
// up to LEN. Doubling keeps the build O(n) in every runtime.
function buildInput(n: i32): string {
  let chunk = ""
  let i = 0
  while i < 1024 {
    if (i * 7 + i / 5) % 11 == 0 {
      chunk = chunk + " "
    } else {
      const k = (i * 31 + (i / 7) * 17) % 26
      chunk = chunk + ALPHA.slice(k, k + 1)
    }
    i = i + 1
  }
  let s = chunk
  while s.length < n { s = s + s }
  return s.slice(0, n)
}

function main() {
  const s = buildInput(LEN)
  let tokens: i64 = 0
  let totalLen: i64 = 0
  let maxLen = 0
  let r = 0
  while r < PASSES {
    let inTok = false
    let curLen = 0
    let i = 0
    const n = s.length
    while i < n {
      const c = s[i]
      if c == 32 {
        if inTok {
          tokens = tokens + 1
          totalLen = totalLen + curLen
          if curLen > maxLen { maxLen = curLen }
          inTok = false
          curLen = 0
        }
      } else {
        inTok = true
        curLen = curLen + 1
      }
      i = i + 1
    }
    if inTok {
      tokens = tokens + 1
      totalLen = totalLen + curLen
      if curLen > maxLen { maxLen = curLen }
    }
    r = r + 1
  }
  print(tokens)
  print(totalLen)
  print(maxLen)
}

main()
