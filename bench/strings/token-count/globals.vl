// token-count — SAME program, written at TOP LEVEL instead of inside `main()`.
// Every `let`/`const` here becomes a module GLOBAL rather than a function
// LOCAL. This file exists only to price that difference; it is not a
// different algorithm and it produces the identical output to main.vl.

const ALPHA = "abcdefghijklmnopqrstuvwxyz"

const LEN = 1_000_000
const PASSES = 1_000

function buildInput(n: i32): string {
  let chunk = ""
  let i = 0
  while i < 1024 {
    if (i * 7 + i / 5) % 11 == 0 {
      chunk = chunk + " "
    } else {
      const k = (i * 31 + (i / 7) * 17) % 26
      chunk = chunk + ALPHA.slice(k, k + 1)
    }
    i = i + 1
  }
  let s = chunk
  while s.length < n { s = s + s }
  return s.slice(0, n)
}

const src = buildInput(LEN)
let tokens: i64 = 0
let totalLen: i64 = 0
let maxLen = 0
let r = 0
while r < PASSES {
  let inTok = false
  let curLen = 0
  let i = 0
  const n = src.length
  while i < n {
    const c = src[i]
    if c == 32 {
      if inTok {
        tokens = tokens + 1
        totalLen = totalLen + curLen
        if curLen > maxLen { maxLen = curLen }
        inTok = false
        curLen = 0
      }
    } else {
      inTok = true
      curLen = curLen + 1
    }
    i = i + 1
  }
  if inTok {
    tokens = tokens + 1
    totalLen = totalLen + curLen
    if curLen > maxLen { maxLen = curLen }
  }
  r = r + 1
}
print(tokens)
print(totalLen)
print(maxLen)
