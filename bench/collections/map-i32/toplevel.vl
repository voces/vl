// TOP-LEVEL spelling of main.vl — measurement of the known globals-vs-locals
// cliff, NOT part of the four-language comparison. Same algorithm, same output;
// the only difference is that every binding is declared at module scope (so it
// becomes a wasm GLOBAL) instead of inside `main()` (where it is a LOCAL).
//
// Compare `vl run toplevel.wasm` against `vl run main.wasm`.

const n = 200_000
const r = 100
const total = 2 * n

const probe: i32[] = []
let i = 0
while i < n {
  probe.push(i * 7 + 3)
  i = i + 1
}
i = 0
while i < n {
  probe.push(i * 7 + 4)
  i = i + 1
}

const m: {[i32]: i32} = Map()
i = 0
while i < n {
  m[i * 7 + 3] = i * 3 + 1
  i = i + 1
}

let hits: i64 = 0
let misses: i64 = 0
let pass = 0
while pass < r {
  i = 0
  while i < total {
    const v = m[probe[i]] ?? -1
    if v == -1 { misses = misses + 1 } else { hits = hits + (v as i64) }
    i = i + 1
  }
  pass = pass + 1
}

let iter: i64 = 0
for v in m.values() { iter = iter + (v as i64) }

print(m.length)
print(hits)
print(misses)
print(iter)
