// i32-keyed map (VL `{[i32]: i32}` — the dedicated mono key rep).
//
// Deliberately the SAME loop skeleton as ../map-string, with only the key type
// changed, so the two numbers are directly comparable and isolate the cost of
// the string key (hash over a code-point array + `__str_eq__`) from the cost of
// the map machinery itself (probe / resize / tombstones are shared code).
//
//   phase 1  insert N keys (i*7+3 — spread, and coprime with any pow2 table)
//   phase 2  R passes of lookups over a 2N probe array (N hit, N miss)
//            misses are i*7+4, which is never a stored key
//   phase 3  one full iteration of the values

function main() {
  const n = 200_000
  const r = 100
  const total = 2 * n

  const probe: i32[] = []
  let i = 0
  while i < n {
    probe.push(i * 7 + 3)
    i = i + 1
  }
  i = 0
  while i < n {
    probe.push(i * 7 + 4)
    i = i + 1
  }

  const m: {[i32]: i32} = Map()
  i = 0
  while i < n {
    m[i * 7 + 3] = i * 3 + 1
    i = i + 1
  }

  let hits: i64 = 0
  let misses: i64 = 0
  let pass = 0
  while pass < r {
    i = 0
    while i < total {
      const v = m[probe[i]] ?? -1
      if v == -1 { misses = misses + 1 } else { hits = hits + (v as i64) }
      i = i + 1
    }
    pass = pass + 1
  }

  let iter: i64 = 0
  for v in m.values() { iter = iter + (v as i64) }

  print(m.length)
  print(hits)
  print(misses)
  print(iter)
}
main()
