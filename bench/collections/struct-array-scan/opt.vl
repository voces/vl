// HAND-OPTIMIZED VL variant of main.vl — same output, contorted spelling.
//
// main.vl stores `Rec[]`, which in VL (and in JS, and in Python) is an array of
// REFERENCES: every element visit is a pointer chase into a separately allocated
// 4-field cell. Rust's `Vec<Rec>` stores the records INLINE, so its scan is a
// contiguous stream. VL has no way to ask for that layout.
//
// This variant works around it by hand: the record is exploded into four
// parallel `i32[]` columns (struct-of-arrays), which is the layout Rust gets for
// free from `Vec<Rec>` — better, in fact, since only the two columns the scan
// actually reads are touched. The cost is that `Rec` stops existing as a type:
// there is no record to pass to a function, no field names at the use site, and
// every future field addition means another parallel array to keep in sync.
//
// The delta between this file and main.vl is the price of VL not having an
// inline-struct array representation.

function main() {
  const n = 2_000_000
  const r = 100

  const id: i32[] = []
  const fa: i32[] = []
  const fb: i32[] = []
  const fc: i32[] = []
  let i = 0
  while i < n {
    id.push(i)
    fa.push(i & 7)
    fb.push((i * 3) & 65535)
    fc.push((i * 7) & 4095)
    i = i + 1
  }

  let sumB: i64 = 0
  let cnt: i64 = 0
  let sumC: i64 = 0
  let pass = 0
  while pass < r {
    i = 0
    while i < n {
      sumB = sumB + (fb[i] as i64)
      if fa[i] == 0 {
        cnt = cnt + 1
        sumC = sumC + (fc[i] as i64)
      }
      i = i + 1
    }
    pass = pass + 1
  }

  print(id.length)
  print(sumB)
  print(cnt)
  print(sumC)
}
main()
