// An array of structs, scanned by field.
//
// N records are built once, then R passes sum one field over the whole array and
// conditionally sum a second field. This is the layout benchmark: Rust's
// `Vec<Rec>` is ONE contiguous block (16 bytes/record, ~4 records per cache
// line), while VL's `Rec[]`, JS's array-of-objects and Python's list-of-objects
// are arrays of REFERENCES — one pointer chase per element. N is sized so the
// data does not fit in L2 and the layout difference actually shows.

type Rec = { id: i32, a: i32, b: i32, c: i32 }

function main() {
  const n = 2_000_000
  const r = 100

  const recs: Rec[] = []
  let i = 0
  while i < n {
    recs.push({ id: i, a: i & 7, b: (i * 3) & 65535, c: (i * 7) & 4095 })
    i = i + 1
  }

  let sumB: i64 = 0
  let cnt: i64 = 0
  let sumC: i64 = 0
  let pass = 0
  while pass < r {
    i = 0
    while i < n {
      const rec = recs[i]
      sumB = sumB + (rec.b as i64)
      if rec.a == 0 {
        cnt = cnt + 1
        sumC = sumC + (rec.c as i64)
      }
      i = i + 1
    }
    pass = pass + 1
  }

  print(recs.length)
  print(sumB)
  print(cnt)
  print(sumC)
}
main()
