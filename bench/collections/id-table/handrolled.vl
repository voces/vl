type Obj = { a: i32, b: i32 }
let tT: (Obj | null)[] = []
function tGet(id: i32): Obj | null {
  if id < 0 || id >= tT.length { null } else { tT[id] }
}
function tSet(id: i32, v: Obj | null) {
  if id < 0 { return }
  while tT.length <= id { tT.push(null) }
  tT[id] = v
}

const LIVE = 2000
const STEP = 7
let next = 0
let seed = 12345
let sum = 0
while next < 1000000 {
  tSet(next * STEP, { a: next, b: 1 })
  if next >= LIVE { tSet((next - LIVE) * STEP, null) }
  let q = 0
  while q < 32 {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff
    const k = (next - seed % (LIVE + 256)) * STEP
    const o = tGet(k)
    if o != null { sum += o.a }
    q += 1
  }
  next += 1
}
print(sum)
