type Obj = { a: i32, b: i32 }
const t: {[i32]: Obj} = Map()
const LIVE = 2000
const STEP = 7
let next = 0
let seed = 12345
let sum = 0
while next < 1000000 {
  t[next * STEP] = { a: next, b: 1 }
  if next >= LIVE { t.delete((next - LIVE) * STEP) }
  let q = 0
  while q < 32 {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff
    const k = (next - seed % (LIVE + 256)) * STEP
    const o = t[k]
    if o != null { sum += o.a }
    q += 1
  }
  next += 1
}
print(sum)
