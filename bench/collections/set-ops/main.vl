// Set operations over string elements.
//
// A = {w0 .. w(N-1)}, B = {w(N/2) .. w(3N/2-1)} — they overlap in exactly N/2.
// R passes compute |A ∩ B|, |A \ B| and |B \ A| by explicit membership tests,
// then one iteration of A sums the element lengths.
//
// The membership loops walk the backing ARRAYS (not the sets) so all four
// runtimes do the identical work and the measurement is `has`, not iteration.
// B's elements are built in their own loop, so an element of A∩B is a DIFFERENT
// string object in B than in A — otherwise every compare short-circuits on
// pointer identity and the benchmark measures nothing.
//
// NOTE: VL's Set surface is `.add`/`.has`/`.delete`/`.length`/`.values()` only —
// there is no set ALGEBRA (`intersection`/`union`/`difference`), which Rust,
// Python and (as of ES2025) JS all have. The explicit-loop spelling below is
// therefore the only spelling available in VL, and is what all four use.

function main() {
  const n = 100_000
  const r = 100
  const half = n / 2

  const aw: string[] = []
  let i = 0
  while i < n {
    aw.push("w" + toString(i))
    i = i + 1
  }
  const bw: string[] = []
  i = 0
  while i < n {
    bw.push("w" + toString(i + half))
    i = i + 1
  }

  const a: {[string]: boolean} = Set()
  i = 0
  while i < n {
    a.add(aw[i])
    i = i + 1
  }
  const b: {[string]: boolean} = Set()
  i = 0
  while i < n {
    b.add(bw[i])
    i = i + 1
  }

  let inter: i64 = 0
  let onlyA: i64 = 0
  let onlyB: i64 = 0
  let pass = 0
  while pass < r {
    i = 0
    while i < n {
      if b.has(aw[i]) { inter = inter + 1 } else { onlyA = onlyA + 1 }
      i = i + 1
    }
    i = 0
    while i < n {
      if a.has(bw[i]) { onlyB = onlyB + 0 } else { onlyB = onlyB + 1 }
      i = i + 1
    }
    pass = pass + 1
  }

  let lensum: i64 = 0
  for x in a.values() { lensum = lensum + (x.length as i64) }

  print(a.length)
  print(b.length)
  print(inter)
  print(onlyA)
  print(onlyB)
  print(lensum)
}
main()
