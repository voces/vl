// TOP-LEVEL spelling of main.vl — measurement of the known globals-vs-locals
// cliff, NOT part of the four-language comparison. Byte-for-byte the same
// algorithm and the same output as main.vl; the only difference is that every
// binding is declared at module scope (so it becomes a wasm GLOBAL) instead of
// inside `main()` (where it is a LOCAL).
//
// Compare `vl run toplevel.wasm` against `vl run main.wasm`.

type V3 = { x: i32, y: i32, z: i32 }
type Body = { pos: V3, vel: V3, mass: i32 }

const n = 300_000_000
const m = 200_000_000

const p: V3 = { x: 1, y: 2, z: 3 }
let acc: i64 = 0
let i = 0
while i < n {
  p.x = (p.x + 3) & 1023
  p.y = (p.y + p.x) & 1023
  p.z = (p.z + p.y) & 1023
  acc = acc + (p.z as i64)
  i = i + 1
}

const b: Body = {
  pos: { x: 1, y: 2, z: 3 },
  vel: { x: 5, y: 7, z: 11 },
  mass: 1,
}
let acc2: i64 = 0
i = 0
while i < m {
  b.pos.x = (b.pos.x + b.vel.x) & 1023
  b.pos.y = (b.pos.y + b.vel.y) & 1023
  b.pos.z = (b.pos.z + b.vel.z) & 1023
  b.vel.x = (b.vel.x + 1) & 63
  acc2 = acc2 + ((b.pos.x + b.pos.y + b.pos.z) as i64)
  i = i + 1
}

print(p.x)
print(p.y)
print(p.z)
print(acc)
print(b.pos.x)
print(b.vel.x)
print(acc2)
