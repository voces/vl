// String-keyed map (VL `{[string]: i32}`).
//
//   phase 1  insert N distinct string keys
//   phase 2  R passes of lookups over a 2N-entry probe array (N hit, N miss)
//   phase 3  one full iteration of the values
//
// The probe keys are built in their OWN loop, so a probe string is a DIFFERENT
// object from the equal-content key that was inserted. That is deliberate and is
// the realistic case (a lookup key is normally built from input, not reused from
// the insert site) — reusing the same object lets every runtime short-circuit the
// key compare on pointer identity, which halves VL's time and measures nothing.
//
// NOTE: the idiomatic hit/miss discrimination `const v = m[k]; if v != null` is an
// EMIT ERROR in VL today for an i32-valued map (see meta.json), so this uses the
// `?? -1` sentinel — one lookup, and exactly what the other three do.

function main() {
  const n = 100_000
  const r = 150
  const total = 2 * n

  const insKeys: string[] = []
  let i = 0
  while i < n {
    insKeys.push("key" + toString(i))
    i = i + 1
  }
  // Distinct objects, equal content for the first n; the last n are never inserted.
  const probe: string[] = []
  i = 0
  while i < total {
    probe.push("key" + toString(i))
    i = i + 1
  }

  const m: {[string]: i32} = Map()
  i = 0
  while i < n {
    m[insKeys[i]] = i * 3 + 1
    i = i + 1
  }

  let hits: i64 = 0
  let misses: i64 = 0
  let pass = 0
  while pass < r {
    i = 0
    while i < total {
      const v = m[probe[i]] ?? -1
      if v == -1 { misses = misses + 1 } else { hits = hits + (v as i64) }
      i = i + 1
    }
    pass = pass + 1
  }

  let iter: i64 = 0
  for v in m.values() { iter = iter + (v as i64) }

  print(m.length)
  print(hits)
  print(misses)
  print(iter)
}
main()
