// Word frequency — the classic mixed map + string benchmark.
//
// A synthetic corpus of D documents, each K words drawn from a V-word vocabulary
// with a quadratic (Zipf-ish) skew from a MINSTD LCG. R passes tokenize every
// document by scanning code points and slicing out each word — so every token is
// a FRESH string object, which is what a real tokenizer produces and what makes
// the map do real hashing and real character comparison instead of short-
// circuiting on pointer identity.
//
// The count is a read-modify-write upsert. VL has no single-probe upsert (no
// `entry` API), so `m[w] = (m[w] ?? 0) + 1` costs TWO probes; idiomatic Rust
// (`*m.entry(w).or_insert(0) += 1`) costs one. That asymmetry is deliberate —
// it is a real property of the surfaces being compared.
//
// The corpus is built as D separate document strings rather than one large one
// because VL's `s = s + x` accumulator is O(n^2) (measured: 25k appends 0.56s,
// 50k 2.8s, 100k 19.7s), so a single multi-hundred-kilochar corpus string is not
// constructible in VL in reasonable time.

function main() {
  const v = 2_000
  const d = 4_000
  const k = 20
  const r = 120

  const vocab: string[] = []
  let i = 0
  while i < v {
    vocab.push("w" + toString(i))
    i = i + 1
  }

  // MINSTD LCG; every product stays under 2^53 so JS doubles are exact too.
  let seed: i64 = 42
  const docs: string[] = []
  i = 0
  while i < d {
    let doc = ""
    let j = 0
    while j < k {
      seed = (seed * 48271) % 2147483647
      const t = (seed % (v as i64)) as i32
      const idx = (t * t) / v
      if j > 0 { doc = doc + " " }
      doc = doc + vocab[idx]
      j = j + 1
    }
    docs.push(doc)
    i = i + 1
  }

  const freq: {[string]: i32} = Map()
  let tokens: i64 = 0
  let pass = 0
  while pass < r {
    i = 0
    while i < d {
      const doc = docs[i]
      let start = 0
      let j = 0
      while j < doc.length {
        if doc[j] == 32 {
          if j > start {
            const w = doc.slice(start, j)
            freq[w] = (freq[w] ?? 0) + 1
            tokens = tokens + 1
          }
          start = j + 1
        }
        j = j + 1
      }
      if j > start {
        const w = doc.slice(start, j)
        freq[w] = (freq[w] ?? 0) + 1
        tokens = tokens + 1
      }
      i = i + 1
    }
    pass = pass + 1
  }

  let maxCount = 0
  let checksum: i64 = 0
  i = 0
  while i < v {
    const c = freq[vocab[i]] ?? 0
    if c > maxCount { maxCount = c }
    checksum = checksum + ((c as i64) * ((i + 1) as i64))
    i = i + 1
  }

  print(freq.length)
  print(tokens)
  print(maxCount)
  print(checksum)
}
main()
