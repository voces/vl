// A live table of LIVE structs held for the whole run, plus CHURN short-lived
// struct allocations in a hot loop — plumb's x86 decoder's shape (an Insn
// struct plus a small operand list per instruction, over a live symbol table),
// which ran 8.6x slower under `vl run` than a faithful Rust port while the same
// module ran at Rust parity under V8.
//
// The axis is a HOST config, not VL code: wasmtime's copying collector only
// grows its heap once the live set nearly fills a semispace, so a heap that
// starts at 0 collects (and re-copies the whole live table) every few MiB of
// churn. docs/internals/perf-decoder-gap-2026-09.md attributes 78% of the
// decoder gap to this and fixed it by starting `vl run`'s heap at 64 MiB.

import { toString } from "std:fmt"

type Cell = { a: i32, b: i32, c: i32 }

function main() {
  const live = 50_000
  const churn = 75_000_000

  const keep: Cell[] = []
  let i = 0
  while i < live {
    keep.push({ a: i, b: i + 1, c: i + 2 })
    i = i + 1
  }

  let s = 0
  i = 0
  while i < churn {
    const t: Cell = { a: i, b: i & 7, c: 1 }
    s += t.a + t.b + keep[i % live].c
    i = i + 1
  }
  print("sum " + s.toString())
}
main()
