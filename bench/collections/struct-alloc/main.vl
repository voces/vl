// Allocating many short-lived structs — the binary-trees GC-pressure shape.
//
// Builds and immediately discards ~14.6M two-pointer nodes, then keeps one
// long-lived tree. This is the real GC comparison: WasmGC (VL) vs V8's
// generational GC (JS) vs CPython refcounting (Python) vs Rust's `Box` over
// malloc with no GC at all. A recursive type FORCES heap allocation in every
// one of the four — there is no spelling where Rust keeps the nodes on the
// stack, so this is an apples-to-apples allocator measurement rather than a
// comparison against zero work.

type Nd = { l: Nd | null, r: Nd | null }

function build(d: i32): Nd {
  if d == 0 { return { l: null, r: null } }
  return { l: build(d - 1), r: build(d - 1) }
}

function count(n: Nd): i32 {
  let s = 1
  const l = n.l
  if l != null { s = s + count(l) }
  const r = n.r
  if r != null { s = s + count(r) }
  return s
}

function main() {
  const maxDepth = 16
  const rounds = 4

  let total: i64 = 0
  let d = 4
  while d <= maxDepth {
    const iters = (1 << (maxDepth - d + 4)) * rounds
    let s: i64 = 0
    let i = 0
    while i < iters {
      s = s + (count(build(d)) as i64)
      i = i + 1
    }
    total = total + s
    d = d + 2
  }

  const longLived = build(maxDepth)

  print(total)
  print(count(longLived))
}
main()
