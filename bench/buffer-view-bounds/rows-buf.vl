// SHAPE `rows`, spelling `buf` — the unfenced twin of the nested grid loop.
import { Buf, Buffer, loadI32, storeI32 } from "std:buffer"

const ROWS = 1024
const W = 1024
const N = 1048576
const R = 501

function seed(b: Buf, n: i32, x: i32) {
  const a = b.base
  let i = 0
  while i < n {
    __store_i32__(a + (i << 2), x)
    i = i + 1
  }
}

function bump(b: Buf, rows: i32, w: i32) {
  let r = 0
  while r < rows {
    const rb = r * w
    let c = 0
    while c < w {
      b.storeI32((rb + c) << 2, b.loadI32((rb + c) << 2) + 1)
      c = c + 1
    }
    r = r + 1
  }
}

function main(): i32 {
  const buf = Buffer(N * 4)
  const hdr = Buffer(64)
  seed(buf, N, 0)
  let t = 0
  while t < R {
    bump(buf, ROWS, W)
    t = t + 1
  }
  hdr.storeI32(0, t)
  return buf.loadI32((N - 1) << 2)
}

print(main())
