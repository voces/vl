// SHAPE `reduce`, spelling `view` — a READ-ONLY sweep of one i32 column, the
// shape of a checksum over sim state. One access per element, so one bounds
// check per element rather than the two `scale` pays.
import { Buffer, I32View, byteAddrI32, i32view, storeI32 } from "std:buffer"

const N = 1048576
const R = 501

function seed(g: I32View, x: i32) {
  const a = g.byteAddrI32(0)
  const n = g.length
  let i = 0
  while i < n {
    __store_i32__(a + (i << 2), x)
    i = i + 1
  }
}

function sum(g: I32View): i32 {
  let s = 0
  let i = 0
  while i < g.length {
    s = s + g[i]
    i = i + 1
  }
  return s
}

function main(): i32 {
  const buf = Buffer(N * 4)
  const hdr = Buffer(64)
  const g = buf.i32view(0, N)
  seed(g, 1)
  let total = 0
  let t = 0
  while t < R {
    total = total + sum(g)
    t = t + 1
  }
  hdr.storeI32(0, t)
  return total
}

print(main())
