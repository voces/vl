// SHAPE `gscale`, spelling `view` — `scale-view` with the view held in a MODULE
// `const` instead of built in `main` and passed down (#9676, buffer-design §M11).
// Every inlined `v[i]` reads the view's descriptor through its global, so this
// row measures what holding a module record costs per access.
import { Buffer, F32View, byteAddrF32, f32view, storeI32 } from "std:buffer"

const N = 1048576
const R = 501

const pages = __memory_size__()
const one: f32 = (pages as f32) / (pages as f32)
const two: f32 = one + one
const half: f32 = one / two

const buf = Buffer(N * 4)
const hdr = Buffer(64)
const v = buf.f32view(0, N)

function seed(x: f32) {
  const a = v.byteAddrF32(0)
  const n = v.length
  let i = 0
  while i < n {
    __store_f32__(a + (i << 2), x)
    i = i + 1
  }
}

function scale(k: f32) {
  let i = 0
  while i < v.length {
    v[i] = v[i] * k
    i = i + 1
  }
}

function main(): f32 {
  seed(one)
  let t = 0
  let k = two
  while t < R {
    scale(k)
    if k == two { k = half } else { k = two }
    t = t + 1
  }
  hdr.storeI32(0, t)
  return v[N - 1]
}

print(main())
