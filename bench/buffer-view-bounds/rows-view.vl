// SHAPE `rows`, spelling `view` — a nested loop: the inner one walks ONE ROW of
// a 1024x1024 i32 grid (a pathing grid), so the index is `rowBase + c` rather
// than the induction variable itself. This is the shape where a hoist would
// need to know `rowBase + c < length` from `rowBase <= (rows-1)*w` and `c < w`,
// i.e. the one a per-loop range analysis is least able to discharge.
import { Buffer, I32View, byteAddrI32, i32view, storeI32 } from "std:buffer"

const ROWS = 1024
const W = 1024
const N = 1048576
const R = 501

function seed(g: I32View, x: i32) {
  const a = g.byteAddrI32(0)
  const n = g.length
  let i = 0
  while i < n {
    __store_i32__(a + (i << 2), x)
    i = i + 1
  }
}

function bump(g: I32View, rows: i32, w: i32) {
  let r = 0
  while r < rows {
    const rb = r * w
    let c = 0
    while c < w {
      g[rb + c] = g[rb + c] + 1
      c = c + 1
    }
    r = r + 1
  }
}

function main(): i32 {
  const buf = Buffer(N * 4)
  const hdr = Buffer(64)
  const g = buf.i32view(0, N)
  seed(g, 0)
  let t = 0
  while t < R {
    bump(g, ROWS, W)
    t = t + 1
  }
  hdr.storeI32(0, t)
  return g[N - 1]
}

print(main())
