// SHAPE `scale`, spelling `hoist` — the STATED FAST PATTERN. The view still
// owns the extent (and its construction-time check still ran); the base address
// and the element count are taken ONCE, before the loop, and the loop body is
// the bare intrinsic. No call, no per-access check.
import { Buffer, F32View, byteAddrF32, f32view, storeI32 } from "std:buffer"

const N = 1048576
const R = 501

const pages = __memory_size__()
const one: f32 = (pages as f32) / (pages as f32)
const two: f32 = one + one
const half: f32 = one / two

function seed(v: F32View, x: f32) {
  const a = v.byteAddrF32(0)
  const n = v.length
  let i = 0
  while i < n {
    __store_f32__(a + (i << 2), x)
    i = i + 1
  }
}

function scale(v: F32View, k: f32) {
  const a = v.byteAddrF32(0)
  const n = v.length
  let i = 0
  while i < n {
    __store_f32__(a + (i << 2), __load_f32__(a + (i << 2)) * k)
    i = i + 1
  }
}

function main(): f32 {
  const buf = Buffer(N * 4)
  const hdr = Buffer(64)
  const v = buf.f32view(0, N)
  seed(v, one)
  let t = 0
  let k = two
  while t < R {
    scale(v, k)
    if k == two { k = half } else { k = two }
    t = t + 1
  }
  hdr.storeI32(0, t)
  return v[N - 1]
}

print(main())
