// SHAPE `scale`, spelling `buf` — the UNFENCED twin of `scale-view.vl`. Same
// loop, same one wasm `call` per access, NO bounds check: `Buf`'s byte-offset
// accessors obey the tier's engine-trap-only rule. (view - buf) is the price of
// the fence; (buf - hoist) is the price of the call.
import { Buf, Buffer, loadF32, storeF32, storeI32 } from "std:buffer"

const N = 1048576
const R = 501

const pages = __memory_size__()
const one: f32 = (pages as f32) / (pages as f32)
const two: f32 = one + one
const half: f32 = one / two

function seed(b: Buf, n: i32, x: f32) {
  const a = b.base
  let i = 0
  while i < n {
    __store_f32__(a + (i << 2), x)
    i = i + 1
  }
}

function scale(b: Buf, n: i32, k: f32) {
  let i = 0
  while i < n {
    b.storeF32(i << 2, b.loadF32(i << 2) * k)
    i = i + 1
  }
}

function main(): f32 {
  const buf = Buffer(N * 4)
  const hdr = Buffer(64)
  seed(buf, N, one)
  let t = 0
  let k = two
  while t < R {
    scale(buf, N, k)
    if k == two { k = half } else { k = two }
    t = t + 1
  }
  hdr.storeI32(0, t)
  return buf.loadF32((N - 1) << 2)
}

print(main())
