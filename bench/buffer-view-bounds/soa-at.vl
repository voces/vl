// SHAPE `soa`, spelling `at` — THE SAME SIX-COLUMN KERNEL, HOISTED AND STILL FENCED.
//
// `soa-view` written against `getF32At` / `setF32At`: each column's base and
// element count come out into locals ONCE at the top of the tick, and the loop
// body holds no view reference at all. Everything else — the four updates, the
// twelve accesses, the twenty-four compares — is unchanged.
//
// This is the row webcraft A1 asked for. Against `soa-view`'s twenty-four
// per-element `struct.get` this reads ZERO, with the identical twenty-four traps
// and the identical eight loads and four stores. The fence is not what costs.
import {
  Buffer,
  F32View,
  byteAddrF32,
  f32view,
  getF32At,
  setF32At,
  storeI32,
} from "std:buffer"

const N = 65536
const R = 101

const pages = __memory_size__()
const one: f32 = (pages as f32) / (pages as f32)

function seed(v: F32View, x: f32) {
  const a = v.byteAddrF32(0)
  const n = v.length
  let i = 0
  while i < n {
    __store_f32__(a + (i << 2), x)
    i = i + 1
  }
}

function step(
  px: F32View,
  py: F32View,
  vx: F32View,
  vy: F32View,
  ax: F32View,
  ay: F32View,
  dt: f32,
) {
  const pb = px.byteAddrF32(0)
  const pn = px.length
  const qb = py.byteAddrF32(0)
  const qn = py.length
  const ub = vx.byteAddrF32(0)
  const un = vx.length
  const wb = vy.byteAddrF32(0)
  const wn = vy.length
  const eb = ax.byteAddrF32(0)
  const en = ax.length
  const fb = ay.byteAddrF32(0)
  const fn = ay.length
  let i = 0
  while i < pn {
    setF32At(ub, un, i, getF32At(ub, un, i) + getF32At(eb, en, i) * dt)
    setF32At(wb, wn, i, getF32At(wb, wn, i) + getF32At(fb, fn, i) * dt)
    setF32At(pb, pn, i, getF32At(pb, pn, i) + getF32At(ub, un, i) * dt)
    setF32At(qb, qn, i, getF32At(qb, qn, i) + getF32At(wb, wn, i) * dt)
    i = i + 1
  }
}

function main(): f32 {
  const buf = Buffer(N * 24)
  const hdr = Buffer(64)
  const px = buf.f32view(0, N)
  const py = buf.f32view(N * 4, N)
  const vx = buf.f32view(N * 8, N)
  const vy = buf.f32view(N * 12, N)
  const ax = buf.f32view(N * 16, N)
  const ay = buf.f32view(N * 20, N)
  seed(px, one - one)
  seed(py, one - one)
  seed(vx, one - one)
  seed(vy, one - one)
  seed(ax, one)
  seed(ay, one)
  let t = 0
  while t < R {
    step(px, py, vx, vy, ax, ay, one)
    t = t + 1
  }
  hdr.storeI32(0, t)
  return px[N - 1]
}

print(main())
