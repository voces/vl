// SHAPE `axpy`, spelling `hoist` — the fast pattern with TWO views: both bases
// and the count taken once, bare intrinsics inside.
import { Buffer, F32View, byteAddrF32, f32view, storeI32 } from "std:buffer"

const N = 1048576
const R = 501

const pages = __memory_size__()
const one: f32 = (pages as f32) / (pages as f32)

function seed(v: F32View, x: f32) {
  const a = v.byteAddrF32(0)
  const n = v.length
  let i = 0
  while i < n {
    __store_f32__(a + (i << 2), x)
    i = i + 1
  }
}

function axpy(y: F32View, x: F32View, dt: f32) {
  const ya = y.byteAddrF32(0)
  const xa = x.byteAddrF32(0)
  const n = y.length
  let i = 0
  while i < n {
    __store_f32__(
      ya + (i << 2),
      __load_f32__(ya + (i << 2)) + __load_f32__(xa + (i << 2)) * dt,
    )
    i = i + 1
  }
}

function main(): f32 {
  const buf = Buffer(N * 8)
  const hdr = Buffer(64)
  const y = buf.f32view(0, N)
  const x = buf.f32view(N * 4, N)
  seed(y, one - one)
  seed(x, one)
  let t = 0
  while t < R {
    axpy(y, x, one)
    t = t + 1
  }
  hdr.storeI32(0, t)
  return y[N - 1]
}

print(main())
