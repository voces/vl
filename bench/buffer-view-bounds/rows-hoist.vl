// SHAPE `rows`, spelling `hoist` — the fast pattern on the nested grid loop:
// the base is taken once OUTSIDE both loops.
import { Buffer, I32View, byteAddrI32, i32view, storeI32 } from "std:buffer"

const ROWS = 1024
const W = 1024
const N = 1048576
const R = 501

function seed(g: I32View, x: i32) {
  const a = g.byteAddrI32(0)
  const n = g.length
  let i = 0
  while i < n {
    __store_i32__(a + (i << 2), x)
    i = i + 1
  }
}

function bump(g: I32View, rows: i32, w: i32) {
  const a = g.byteAddrI32(0)
  let r = 0
  while r < rows {
    const rb = r * w
    let c = 0
    while c < w {
      __store_i32__(a + ((rb + c) << 2), __load_i32__(a + ((rb + c) << 2)) + 1)
      c = c + 1
    }
    r = r + 1
  }
}

function main(): i32 {
  const buf = Buffer(N * 4)
  const hdr = Buffer(64)
  const g = buf.i32view(0, N)
  seed(g, 0)
  let t = 0
  while t < R {
    bump(g, ROWS, W)
    t = t + 1
  }
  hdr.storeI32(0, t)
  return g[N - 1]
}

print(main())
