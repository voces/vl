// SHAPE `reduce`, spelling `buf` — the unfenced twin: same call per access, no
// check.
import { Buf, Buffer, loadI32, storeI32 } from "std:buffer"

const N = 1048576
const R = 501

function seed(b: Buf, n: i32, x: i32) {
  const a = b.base
  let i = 0
  while i < n {
    __store_i32__(a + (i << 2), x)
    i = i + 1
  }
}

function sum(b: Buf, n: i32): i32 {
  let s = 0
  let i = 0
  while i < n {
    s = s + b.loadI32(i << 2)
    i = i + 1
  }
  return s
}

function main(): i32 {
  const buf = Buffer(N * 4)
  const hdr = Buffer(64)
  seed(buf, N, 1)
  let total = 0
  let t = 0
  while t < R {
    total = total + sum(buf, N)
    t = t + 1
  }
  hdr.storeI32(0, t)
  return total
}

print(main())
