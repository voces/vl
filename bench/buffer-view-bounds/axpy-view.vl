// SHAPE `axpy`, spelling `view` — TWO views in one loop, webcraft P1.1's own
// canonical integrate step (`y[i] += x[i] * dt`). Three accesses per element,
// so three bounds checks, and the loop bound is read off ONE of the two views
// while the other is indexed with the same induction variable — the case a
// range analysis would have to relate two extents to discharge.
import { Buffer, F32View, byteAddrF32, f32view, storeI32 } from "std:buffer"

const N = 1048576
const R = 501

const pages = __memory_size__()
const one: f32 = (pages as f32) / (pages as f32)

function seed(v: F32View, x: f32) {
  const a = v.byteAddrF32(0)
  const n = v.length
  let i = 0
  while i < n {
    __store_f32__(a + (i << 2), x)
    i = i + 1
  }
}

function axpy(y: F32View, x: F32View, dt: f32) {
  let i = 0
  while i < y.length {
    y[i] = y[i] + x[i] * dt
    i = i + 1
  }
}

function main(): f32 {
  const buf = Buffer(N * 8)
  const hdr = Buffer(64)
  const y = buf.f32view(0, N)
  const x = buf.f32view(N * 4, N)
  seed(y, one - one)
  seed(x, one)
  let t = 0
  while t < R {
    axpy(y, x, one)
    t = t + 1
  }
  hdr.storeI32(0, t)
  return y[N - 1]
}

print(main())
