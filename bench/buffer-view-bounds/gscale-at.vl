// SHAPE `gscale`, spelling `at` — `gscale-view` with the column's base and count
// hoisted into locals once per call and the loop written against `getF32At` /
// `setF32At`: the same fence per access, no descriptor read in the loop. The
// target `gscale-view` is measured against (#9676).
import {
  Buffer,
  F32View,
  byteAddrF32,
  f32base,
  f32view,
  getF32At,
  setF32At,
  storeI32,
} from "std:buffer"

const N = 1048576
const R = 501

const pages = __memory_size__()
const one: f32 = (pages as f32) / (pages as f32)
const two: f32 = one + one
const half: f32 = one / two

const buf = Buffer(N * 4)
const hdr = Buffer(64)
const v = buf.f32view(0, N)

function seed(x: f32) {
  const a = v.byteAddrF32(0)
  const n = v.length
  let i = 0
  while i < n {
    __store_f32__(a + (i << 2), x)
    i = i + 1
  }
}

function scale(k: f32) {
  const b = f32base(v)
  const n = v.length
  let i = 0
  while i < n {
    setF32At(b, n, i, getF32At(b, n, i) * k)
    i = i + 1
  }
}

function main(): f32 {
  seed(one)
  let t = 0
  let k = two
  while t < R {
    scale(k)
    if k == two { k = half } else { k = two }
    t = t + 1
  }
  hdr.storeI32(0, t)
  return v[N - 1]
}

print(main())
