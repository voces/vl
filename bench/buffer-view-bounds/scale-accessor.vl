// SHAPE `scale`, spelling `accessor` — `scale-view.vl` with the bracket written
// out as the UFCS accessor call it forwards to. Identical semantics, identical
// bounds check; the ONLY difference is one forwarding hop.
//
// It is here because at the unoptimized rung the bracket is not free: `"[]"` is
// a real function whose body is `return getF32(self, i)`, so `v[i]` executes TWO
// calls per access where `v.getF32(i)` executes one. That makes this the only
// spelling that isolates the CHECK from the CALL COUNT at `none` — it and
// `scale-buf` execute the same one call per access, and only this one checks.
// Both rungs of wasm-opt inline the hop away, so the difference is a `none`-rung
// effect and nothing more.
import {
  Buffer,
  F32View,
  byteAddrF32,
  f32view,
  getF32,
  setF32,
  storeI32,
} from "std:buffer"

const N = 1048576
const R = 501

const pages = __memory_size__()
const one: f32 = (pages as f32) / (pages as f32)
const two: f32 = one + one
const half: f32 = one / two

function seed(v: F32View, x: f32) {
  const a = v.byteAddrF32(0)
  const n = v.length
  let i = 0
  while i < n {
    __store_f32__(a + (i << 2), x)
    i = i + 1
  }
}

function scale(v: F32View, k: f32) {
  let i = 0
  while i < v.length {
    v.setF32(i, v.getF32(i) * k)
    i = i + 1
  }
}

function main(): f32 {
  const buf = Buffer(N * 4)
  const hdr = Buffer(64)
  const v = buf.f32view(0, N)
  seed(v, one)
  let t = 0
  let k = two
  while t < R {
    scale(v, k)
    if k == two { k = half } else { k = two }
    t = t + 1
  }
  hdr.storeI32(0, t)
  return v.getF32(N - 1)
}

print(main())
