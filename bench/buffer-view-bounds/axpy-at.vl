// SHAPE `axpy`, spelling `at` — THE STD SURFACE FOR THE FENCE WITHOUT THE RELOAD.
//
// `axpy-fencedhoist` is the hand-written control that proved the `axpy-view`
// price is the field RELOAD and not the CHECK, and its header says outright that
// it "is deliberately NOT a proposed API" — it is the experiment a
// `getF32At(base, length, i)`-shaped std addition would turn on.
//
// It turned on. `getF32At` / `setF32At` ship in `std:buffer`, and this file is
// the same kernel written against them instead of against six hand-written
// compares. The row it pins must MATCH `axpy-fencedhoist` at the rung that
// matters: at `-O3` the per-element reload is gone (7 -> 4, and those 4 are the
// view construction in the TRIP loop) while all six per-access compares survive.
// At `none` the traps sit in the callees, so this reads like `axpy-view`.
//
// The six-column `soa` pair is where the win is stated cleanly — this shape is
// two views, which understates it. webcraft P1.1 ask A1;
// `docs/internals/buffer-design.md` §M8.
import {
  Buffer,
  F32View,
  byteAddrF32,
  f32view,
  getF32At,
  setF32At,
  storeI32,
} from "std:buffer"

const N = 1048576
const R = 501

const pages = __memory_size__()
const one: f32 = (pages as f32) / (pages as f32)

function seed(v: F32View, x: f32) {
  const a = v.byteAddrF32(0)
  const n = v.length
  let i = 0
  while i < n {
    __store_f32__(a + (i << 2), x)
    i = i + 1
  }
}

function axpy(y: F32View, x: F32View, dt: f32) {
  // The hoist is two lines per column and the loop body holds no reference.
  const ya = y.byteAddrF32(0)
  const n = y.length
  const xa = x.byteAddrF32(0)
  const m = x.length
  let i = 0
  while i < n {
    setF32At(ya, n, i, getF32At(ya, n, i) + getF32At(xa, m, i) * dt)
    i = i + 1
  }
}

function main(): f32 {
  const buf = Buffer(N * 8)
  const hdr = Buffer(64)
  const y = buf.f32view(0, N)
  const x = buf.f32view(N * 4, N)
  seed(y, one - one)
  seed(x, one)
  let t = 0
  while t < R {
    axpy(y, x, one)
    t = t + 1
  }
  hdr.storeI32(0, t)
  return y[N - 1]
}

print(main())
