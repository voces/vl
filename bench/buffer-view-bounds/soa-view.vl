// SHAPE `soa`, spelling `view` — WEBCRAFT'S OWN KERNEL, the one A1 was filed on.
//
// The `axpy` shape is TWO views and three accesses, and webcraft's A1 says
// plainly "our kernels are not two-view". This shape is the one they measured: a
// movement integrator over SIX columns (`px py vx vy ax ay`), four updates per
// element, twelve accesses per trip. It exists because the two-view rows
// UNDERSTATE the reload cost — the per-trip view-construction reads dominate
// there, and here they do not.
//
// The columns are taken as PARAMETERS, which is what a sim's tick function does
// and what keeps the construction check out of the measured loop entirely. So
// this shape's `sget` column is per-ELEMENT and nothing else: twenty-four, being
// two descriptor fields times twelve accesses. Its `at` twin reads zero.
import { Buffer, F32View, byteAddrF32, f32view, storeI32 } from "std:buffer"

const N = 65536
const R = 101

const pages = __memory_size__()
const one: f32 = (pages as f32) / (pages as f32)

function seed(v: F32View, x: f32) {
  const a = v.byteAddrF32(0)
  const n = v.length
  let i = 0
  while i < n {
    __store_f32__(a + (i << 2), x)
    i = i + 1
  }
}

function step(
  px: F32View,
  py: F32View,
  vx: F32View,
  vy: F32View,
  ax: F32View,
  ay: F32View,
  dt: f32,
) {
  const n = px.length
  let i = 0
  while i < n {
    vx[i] = vx[i] + ax[i] * dt
    vy[i] = vy[i] + ay[i] * dt
    px[i] = px[i] + vx[i] * dt
    py[i] = py[i] + vy[i] * dt
    i = i + 1
  }
}

function main(): f32 {
  const buf = Buffer(N * 24)
  const hdr = Buffer(64)
  const px = buf.f32view(0, N)
  const py = buf.f32view(N * 4, N)
  const vx = buf.f32view(N * 8, N)
  const vy = buf.f32view(N * 12, N)
  const ax = buf.f32view(N * 16, N)
  const ay = buf.f32view(N * 20, N)
  seed(px, one - one)
  seed(py, one - one)
  seed(vx, one - one)
  seed(vy, one - one)
  seed(ax, one)
  seed(ay, one)
  let t = 0
  while t < R {
    step(px, py, vx, vy, ax, ay, one)
    t = t + 1
  }
  hdr.storeI32(0, t)
  return px[N - 1]
}

print(main())
