// SHAPE `axpy`, spelling `buf` — the unfenced twin: three calls per element, no
// check. The two columns are two byte windows into one `Buf`, which is exactly
// the aliasing the fenced spelling gives two views of.
import { Buf, Buffer, loadF32, storeF32, storeI32 } from "std:buffer"

const N = 1048576
const R = 501

const pages = __memory_size__()
const one: f32 = (pages as f32) / (pages as f32)

function seed(b: Buf, off: i32, n: i32, x: f32) {
  const a = b.base + off
  let i = 0
  while i < n {
    __store_f32__(a + (i << 2), x)
    i = i + 1
  }
}

function axpy(b: Buf, yoff: i32, xoff: i32, n: i32, dt: f32) {
  let i = 0
  while i < n {
    b.storeF32(
      yoff + (i << 2),
      b.loadF32(yoff + (i << 2)) + b.loadF32(xoff + (i << 2)) * dt,
    )
    i = i + 1
  }
}

function main(): f32 {
  const buf = Buffer(N * 8)
  const hdr = Buffer(64)
  seed(buf, 0, N, one - one)
  seed(buf, N * 4, N, one)
  let t = 0
  while t < R {
    axpy(buf, 0, N * 4, N, one)
    t = t + 1
  }
  hdr.storeI32(0, t)
  return buf.loadF32((N - 1) << 2)
}

print(main())
