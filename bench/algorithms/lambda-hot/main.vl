// lambda-hot — the cost of CALLING, in a hot loop, in four spellings of the
// same function `(x) => (x + k) & 15`:
//
//   phase 1  inlined by hand (no call at all)      — the floor
//   phase 2  a named top-level function            — a direct call
//   phase 3  a non-capturing lambda in a local     — a call through a value
//   phase 4  a lambda that CAPTURES a local        — a closure call
//
// Each phase uses its own k so no phase can be folded into another, and the
// accumulator is a serial dependency (`acc = (acc + f(i)) & 1048575`) so no
// runtime can vectorise the loop away. Values stay under 2^20 throughout, so
// all four languages agree exactly without any integer-overflow rules.

function bump(x: i32): i32 {
  return (x + 1) & 15
}

function main() {
  const n = 100_000_000
  const mask = 1048575

  // phase 1 — no call
  let a1 = 0
  let i1 = 0
  while i1 < n {
    a1 = (a1 + (i1 & 15)) & mask
    i1 = i1 + 1
  }
  print(a1)

  // phase 2 — direct call to a named function
  let a2 = 0
  let i2 = 0
  while i2 < n {
    a2 = (a2 + bump(i2)) & mask
    i2 = i2 + 1
  }
  print(a2)

  // phase 3 — a non-capturing lambda held in a local
  const f3 = (x: i32) => (x + 2) & 15
  let a3 = 0
  let i3 = 0
  while i3 < n {
    a3 = (a3 + f3(i3)) & mask
    i3 = i3 + 1
  }
  print(a3)

  // phase 4 — a lambda that captures a local
  let k = 3
  const f4 = (x: i32) => (x + k) & 15
  let a4 = 0
  let i4 = 0
  while i4 < n {
    a4 = (a4 + f4(i4)) & mask
    i4 = i4 + 1
  }
  print(a4)
}

main()
