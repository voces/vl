// lambda-hot, hand-contorted VL — THIS IS THE DEFECT, NOT A TIP.
//
// Identical output to main.vl. The only change is that phases 3 and 4 no
// longer hold their function in a value: the lambda bodies have been lifted
// into named top-level functions and called directly, and phase 4's captured
// `k` has been turned into an extra parameter. That is the contortion a VL
// user is currently pushed into, and it is exactly what a lambda is supposed
// to save them from.
//
// Measured (n = 50,000,000 per phase, prebuilt module, min-of-3):
//   phase 3 as a lambda value      0.666 s      as a named call  0.048 s
//   phase 4 as a capturing lambda  0.670 s      as a named call  0.048 s
//
// The same 14x is also recovered with NO source change at all by passing
// `-O` or `-O3` to `vl build` (binaryen devirtualises the call_ref), which is
// what says the emitter has the information and is not using it.

function bump(x: i32): i32 {
  return (x + 1) & 15
}

function bump2(x: i32): i32 {
  return (x + 2) & 15
}

function bumpK(x: i32, k: i32): i32 {
  return (x + k) & 15
}

function main() {
  const n = 100_000_000
  const mask = 1048575

  // phase 1 — no call
  let a1 = 0
  let i1 = 0
  while i1 < n {
    a1 = (a1 + (i1 & 15)) & mask
    i1 = i1 + 1
  }
  print(a1)

  // phase 2 — direct call to a named function
  let a2 = 0
  let i2 = 0
  while i2 < n {
    a2 = (a2 + bump(i2)) & mask
    i2 = i2 + 1
  }
  print(a2)

  // phase 3 — was a non-capturing lambda; now a named direct call
  let a3 = 0
  let i3 = 0
  while i3 < n {
    a3 = (a3 + bump2(i3)) & mask
    i3 = i3 + 1
  }
  print(a3)

  // phase 4 — was a capturing lambda; the capture is now a parameter
  let k = 3
  let a4 = 0
  let i4 = 0
  while i4 < n {
    a4 = (a4 + bumpK(i4, k)) & mask
    i4 = i4 + 1
  }
  print(a4)
}

main()
