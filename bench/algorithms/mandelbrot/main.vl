// mandelbrot — adapted from the Computer Language Benchmarks Game `mandelbrot`
// program. Float + array heavy: a w*h grid, up to 50 complex-square iterations
// per pixel, results packed 8-to-a-byte into a row buffer.
//
// ADAPTATION: the reference writes a binary PBM to stdout. Comparing binary
// stdout across four runtimes is not what this measures, so all four print a
// TEXT summary of exactly the same bitmap instead: the number of in-set pixels
// and a rolling checksum over the packed bytes, kept in i64 modulo 1000000007
// so no runtime has to reproduce another's integer-overflow rules. Every byte
// of the reference bitmap is still produced and consumed.

function main() {
  const w = 8000
  const h = 8000
  const iter = 50
  const limit = 4.0

  const rowBytes = w / 8
  const row: i32[] = []
  let k = 0
  while k < rowBytes {
    row.push(0)
    k = k + 1
  }

  let inSet = 0
  let checksum: i64 = 0

  let y = 0
  while y < h {
    const ci = 2.0 * (y as f64) / (h as f64) - 1.0
    let byteAcc = 0
    let bitNum = 0
    let bytePos = 0
    let x = 0
    while x < w {
      const cr = 2.0 * (x as f64) / (w as f64) - 1.5
      let zr = 0.0
      let zi = 0.0
      let tr = 0.0
      let ti = 0.0
      let i = 0
      while i < iter {
        if tr + ti > limit {
          break
        }
        zi = 2.0 * zr * zi + ci
        zr = tr - ti + cr
        tr = zr * zr
        ti = zi * zi
        i = i + 1
      }
      byteAcc = byteAcc << 1
      if tr + ti <= limit {
        byteAcc = byteAcc | 1
        inSet = inSet + 1
      }
      bitNum = bitNum + 1
      if bitNum == 8 {
        row[bytePos] = byteAcc
        bytePos = bytePos + 1
        byteAcc = 0
        bitNum = 0
      }
      x = x + 1
    }
    let b = 0
    while b < rowBytes {
      checksum = (checksum * 31 + row[b]) % 1000000007
      b = b + 1
    }
    y = y + 1
  }

  print(inSet)
  print(checksum)
}

main()
