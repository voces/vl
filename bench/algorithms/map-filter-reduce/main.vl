// map-filter-reduce — callback-heavy pipeline over a large array, in the
// three spellings a programmer actually chooses between:
//
//   phase A  the builtin methods:  xs.map(f).filter(g).reduce(h, 0)
//   phase B  hand-written loops that build the SAME two intermediate arrays
//   phase C  one fused hand-written loop, no intermediate arrays
//
// A vs B isolates the cost of the callback + method machinery (identical
// allocation). B vs C is the cost of materialising the intermediates. All
// three print the same total, which is the equivalence check.

import { reduce } from "std:array"

function main() {
  const n = 20_000_000

  const xs: i32[] = []
  let i = 0
  while i < n {
    xs.push(i & 1023)
    i = i + 1
  }

  // phase A — builtin map / filter / reduce with lambda callbacks
  const ys = xs.map((x: i32) => x * 3 + 1)
  const zs = ys.filter((y: i32) => (y & 7) == 3)
  const totalA = zs.reduce((acc: i64, z: i32) => acc + z, 0)
  print(totalA)

  // phase B — hand-written loops building the same two intermediate arrays
  const ys2: i32[] = []
  let b = 0
  while b < xs.length {
    ys2.push(xs[b] * 3 + 1)
    b = b + 1
  }
  const zs2: i32[] = []
  let c = 0
  while c < ys2.length {
    const y = ys2[c]
    if (y & 7) == 3 {
      zs2.push(y)
    }
    c = c + 1
  }
  let totalB: i64 = 0
  let d = 0
  while d < zs2.length {
    totalB = totalB + zs2[d]
    d = d + 1
  }
  print(totalB)

  // phase C — one fused loop, no intermediates
  let totalC: i64 = 0
  let e = 0
  while e < xs.length {
    const y = xs[e] * 3 + 1
    if (y & 7) == 3 {
      totalC = totalC + y
    }
    e = e + 1
  }
  print(totalC)
}

main()
