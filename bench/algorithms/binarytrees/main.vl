// binary-trees — adapted from the Computer Language Benchmarks Game
// `binarytrees` program (the single-threaded, no-arena reference shape).
// Allocation / GC heavy: builds and immediately discards millions of two-field
// nodes, so it measures the allocator and the collector, not arithmetic.
//
// Kept faithful to the reference: same minDepth=4, same stretch tree, same
// long-lived tree, same iteration counts, same output text.

import { toStr } from "std:fmt"

type Node = { left: Node | null, right: Node | null }

function bottomUpTree(depth: i32): Node {
  if depth == 0 {
    return {left: null, right: null}
  }
  return {left: bottomUpTree(depth - 1), right: bottomUpTree(depth - 1)}
}

function itemCheck(node: Node): i32 {
  const l = node.left
  if l == null {
    return 1
  }
  const r = node.right
  if r == null {
    return 1
  }
  return 1 + itemCheck(l) + itemCheck(r)
}

function main() {
  const n = 20
  const minDepth = 4
  let maxDepth = minDepth + 2
  if n > maxDepth {
    maxDepth = n
  }
  const stretchDepth = maxDepth + 1

  print("stretch tree of depth " + stretchDepth.toStr() + "\t check: " + itemCheck(bottomUpTree(stretchDepth)).toStr())

  const longLivedTree = bottomUpTree(maxDepth)

  let depth = minDepth
  while depth <= maxDepth {
    const iterations = 1 << (maxDepth - depth + minDepth)
    let check = 0
    let i = 1
    while i <= iterations {
      check = check + itemCheck(bottomUpTree(depth))
      i = i + 1
    }
    print(iterations.toStr() + "\t trees of depth " + depth.toStr() + "\t check: " + check.toStr())
    depth = depth + 2
  }

  print("long lived tree of depth " + maxDepth.toStr() + "\t check: " + itemCheck(longLivedTree).toStr())
}

main()
