// dispatch-table — function values called INDIRECTLY, the shape every plugin
// registry / interpreter / state machine has:
//
//   phase 1  an if/else chain calling the four operations directly — the floor
//   phase 2  the four operations in an ARRAY of function values, indexed
//   phase 3  the four operations in a FIELD of a struct, in an array of structs
//
// Each phase folds the same serial accumulator `acc = (acc + op(i)) & 1048575`
// over the same 4-way rotation, so all three print the same number. Values
// stay under 2^20, so no runtime has to reproduce another's overflow rules.

type Op = { f: (i32) => i32, name: string }

function op0(x: i32): i32 { return (x + 1) & 15 }
function op1(x: i32): i32 { return (x + 2) & 15 }
function op2(x: i32): i32 { return (x * 3) & 15 }
function op3(x: i32): i32 { return (x ^ 5) & 15 }

function main() {
  const n = 50_000_000
  const mask = 1048575

  // phase 1 — an if/else chain, direct calls
  let a1 = 0
  let i1 = 0
  while i1 < n {
    const k = i1 & 3
    let v = 0
    if k == 0 {
      v = op0(i1)
    } else {
      if k == 1 {
        v = op1(i1)
      } else {
        if k == 2 {
          v = op2(i1)
        } else {
          v = op3(i1)
        }
      }
    }
    a1 = (a1 + v) & mask
    i1 = i1 + 1
  }
  print(a1)

  // phase 2 — an array of function values
  const fs: ((i32) => i32)[] = [op0, op1, op2, op3]
  let a2 = 0
  let i2 = 0
  while i2 < n {
    a2 = (a2 + fs[i2 & 3](i2)) & mask
    i2 = i2 + 1
  }
  print(a2)

  // phase 3 — a function value in a STRUCT FIELD
  const ops: Op[] = [
    {f: op0, name: "add1"},
    {f: op1, name: "add2"},
    {f: op2, name: "mul3"},
    {f: op3, name: "xor5"},
  ]
  let a3 = 0
  let i3 = 0
  while i3 < n {
    a3 = (a3 + ops[i3 & 3].f(i3)) & mask
    i3 = i3 + 1
  }
  print(a3)
}

main()
