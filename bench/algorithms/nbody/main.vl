// n-body — adapted from the Computer Language Benchmarks Game `nbody` program
// (the classic 5-body Jovian-planets simulation, Mark C. Lewis' shape).
// Float + struct heavy: an array of mutable structs, an O(n^2) pairwise loop.
//
// ADAPTATION: the reference prints with printf("%.9f"). VL has no f64->string
// formatter in std, so all four languages here print through the SAME
// integer-scaling algorithm (fmt9 below) instead of each runtime's printf, so
// the outputs are byte-identical by construction and no formatting library is
// inside the measurement.
//
// The i64 renderer is written out longhand rather than imported from `std:fmt`
// because `import { toStr } from "std:fmt"` makes this module fail to EMIT
// ("object literal matches no union variant") — see the finding filed with this
// benchmark. It is called twice per run, so it is not in the measurement.

type Body = { x: f64, y: f64, z: f64, vx: f64, vy: f64, vz: f64, mass: f64 }

function digit(d: i64): string {
  if d == 0 { return "0" }
  if d == 1 { return "1" }
  if d == 2 { return "2" }
  if d == 3 { return "3" }
  if d == 4 { return "4" }
  if d == 5 { return "5" }
  if d == 6 { return "6" }
  if d == 7 { return "7" }
  if d == 8 { return "8" }
  return "9"
}

function renderU64(n: i64): string {
  if n == 0 { return "0" }
  let m = n
  let out = ""
  while m > 0 {
    out = digit(m % 10) + out
    m = m / 10
  }
  return out
}

function fmt9(v: f64): string {
  let a = v
  let sign = ""
  if v < 0.0 {
    a = 0.0 - v
    sign = "-"
  }
  const scaled: i64 = (a * 1000000000.0 + 0.5) as i64
  const ip: i64 = scaled / 1000000000
  const fp: i64 = scaled % 1000000000
  let f = renderU64(fp)
  while f.length < 9 {
    f = "0" + f
  }
  return sign + renderU64(ip) + "." + f
}

function makeBodies(): Body[] {
  const pi = 3.141592653589793
  const solarMass = 4.0 * pi * pi
  const daysPerYear = 365.24
  const bodies: Body[] = [
    // Sun
    {x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: solarMass},
    // Jupiter
    {
      x: 4.84143144246472090,
      y: -1.16032004402742839,
      z: -0.103622044471123109,
      vx: 0.00166007664274403694 * daysPerYear,
      vy: 0.00769901118419740425 * daysPerYear,
      vz: -0.0000690460016972063023 * daysPerYear,
      mass: 0.000954791938424326609 * solarMass,
    },
    // Saturn
    {
      x: 8.34336671824457987,
      y: 4.12479856412430479,
      z: -0.403523417114321381,
      vx: -0.00276742510726862411 * daysPerYear,
      vy: 0.00499852801234917238 * daysPerYear,
      vz: 0.0000230417297573763929 * daysPerYear,
      mass: 0.000285885980666130812 * solarMass,
    },
    // Uranus
    {
      x: 12.8943695621391310,
      y: -15.1111514016986312,
      z: -0.223307578892655734,
      vx: 0.00296460137564761618 * daysPerYear,
      vy: 0.00237847173959480950 * daysPerYear,
      vz: -0.0000296589568540237556 * daysPerYear,
      mass: 0.0000436624404335156298 * solarMass,
    },
    // Neptune
    {
      x: 15.3796971148509165,
      y: -25.9193146099879641,
      z: 0.179258772950371181,
      vx: 0.00268067772490389322 * daysPerYear,
      vy: 0.00162824170038242295 * daysPerYear,
      vz: -0.0000951592254519715870 * daysPerYear,
      mass: 0.0000515138902046611451 * solarMass,
    },
  ]
  return bodies
}

function offsetMomentum(bodies: Body[]) {
  const pi = 3.141592653589793
  const solarMass = 4.0 * pi * pi
  let px = 0.0
  let py = 0.0
  let pz = 0.0
  for b in bodies {
    px = px + b.vx * b.mass
    py = py + b.vy * b.mass
    pz = pz + b.vz * b.mass
  }
  const sun = bodies[0]
  sun.vx = 0.0 - px / solarMass
  sun.vy = 0.0 - py / solarMass
  sun.vz = 0.0 - pz / solarMass
}

function energy(bodies: Body[]): f64 {
  let e = 0.0
  const n = bodies.length
  for i in 0 to n - 1 {
    const bi = bodies[i]
    e = e + 0.5 * bi.mass * (bi.vx * bi.vx + bi.vy * bi.vy + bi.vz * bi.vz)
    for j in i + 1 to n - 1 {
      const bj = bodies[j]
      const dx = bi.x - bj.x
      const dy = bi.y - bj.y
      const dz = bi.z - bj.z
      const d = sqrt(dx * dx + dy * dy + dz * dz)
      e = e - bi.mass * bj.mass / d
    }
  }
  return e
}

function advance(bodies: Body[], dt: f64) {
  const n = bodies.length
  for i in 0 to n - 1 {
    const bi = bodies[i]
    for j in i + 1 to n - 1 {
      const bj = bodies[j]
      const dx = bi.x - bj.x
      const dy = bi.y - bj.y
      const dz = bi.z - bj.z
      const d2 = dx * dx + dy * dy + dz * dz
      const mag = dt / (d2 * sqrt(d2))
      const mj = bj.mass * mag
      const mi = bi.mass * mag
      bi.vx = bi.vx - dx * mj
      bi.vy = bi.vy - dy * mj
      bi.vz = bi.vz - dz * mj
      bj.vx = bj.vx + dx * mi
      bj.vy = bj.vy + dy * mi
      bj.vz = bj.vz + dz * mi
    }
  }
  for b in bodies {
    b.x = b.x + dt * b.vx
    b.y = b.y + dt * b.vy
    b.z = b.z + dt * b.vz
  }
}

function main() {
  const n = 50_000_000
  const bodies = makeBodies()
  offsetMomentum(bodies)
  print(fmt9(energy(bodies)))
  for i in 1 to n {
    advance(bodies, 0.01)
  }
  print(fmt9(energy(bodies)))
}

main()
