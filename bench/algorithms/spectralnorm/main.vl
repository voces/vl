// spectral-norm — adapted from the Computer Language Benchmarks Game
// `spectralnorm` program. Float + array heavy: two O(n^2) dense
// matrix-free multiplies per iteration, 10 iterations, over f64 arrays.
//
// ADAPTATION: the reference prints with printf("%.9f"); all four languages
// here print through the same integer-scaling `fmt9` so the outputs are
// byte-identical by construction.
//
// The i64 renderer is written out longhand rather than imported from
// `std:fmt` — see the nbody benchmark's note about the emit failure that
// import triggers. It runs once, so it is not in the measurement.

function digit(d: i64): string {
  if d == 0 { return "0" }
  if d == 1 { return "1" }
  if d == 2 { return "2" }
  if d == 3 { return "3" }
  if d == 4 { return "4" }
  if d == 5 { return "5" }
  if d == 6 { return "6" }
  if d == 7 { return "7" }
  if d == 8 { return "8" }
  return "9"
}

function renderU64(n: i64): string {
  if n == 0 { return "0" }
  let m = n
  let out = ""
  while m > 0 {
    out = digit(m % 10) + out
    m = m / 10
  }
  return out
}

function fmt9(v: f64): string {
  let a = v
  let sign = ""
  if v < 0.0 {
    a = 0.0 - v
    sign = "-"
  }
  const scaled: i64 = (a * 1000000000.0 + 0.5) as i64
  const ip: i64 = scaled / 1000000000
  const fp: i64 = scaled % 1000000000
  let f = renderU64(fp)
  while f.length < 9 {
    f = "0" + f
  }
  return sign + renderU64(ip) + "." + f
}

// A(i, j) = 1 / ((i + j) * (i + j + 1) / 2 + i + 1)
function aij(i: i32, j: i32): f64 {
  const s = i + j
  const d = s * (s + 1) / 2 + i + 1
  return 1.0 / (d as f64)
}

function multiplyAv(n: i32, v: f64[], out: f64[]) {
  let i = 0
  while i < n {
    let sum = 0.0
    let j = 0
    while j < n {
      sum = sum + aij(i, j) * v[j]
      j = j + 1
    }
    out[i] = sum
    i = i + 1
  }
}

function multiplyAtv(n: i32, v: f64[], out: f64[]) {
  let i = 0
  while i < n {
    let sum = 0.0
    let j = 0
    while j < n {
      sum = sum + aij(j, i) * v[j]
      j = j + 1
    }
    out[i] = sum
    i = i + 1
  }
}

function multiplyAtAv(n: i32, v: f64[], out: f64[], tmp: f64[]) {
  multiplyAv(n, v, tmp)
  multiplyAtv(n, tmp, out)
}

function main() {
  const n = 5500
  const u: f64[] = []
  const v: f64[] = []
  const tmp: f64[] = []
  let k = 0
  while k < n {
    u.push(1.0)
    v.push(0.0)
    tmp.push(0.0)
    k = k + 1
  }

  let it = 0
  while it < 10 {
    multiplyAtAv(n, u, v, tmp)
    multiplyAtAv(n, v, u, tmp)
    it = it + 1
  }

  let vBv = 0.0
  let vv = 0.0
  let i = 0
  while i < n {
    vBv = vBv + u[i] * v[i]
    vv = vv + v[i] * v[i]
    i = i + 1
  }
  print(fmt9(sqrt(vBv / vv)))
}

main()
