{
  "tasks": {
    "build": "npx esbuild src/extension.ts --outdir=dist --bundle --format=cjs --external:vscode --sourcemap --platform=node && npx esbuild src/server.ts --outfile=dist/server.mjs --bundle --format=esm --target=node18 --external:vscode --sourcemap --platform=node --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" && deno run -A scripts/bundle-seed.ts",
    "dev": "npx esbuild src/server.ts --outfile=dist/server.mjs --bundle --format=esm --target=node18 --external:vscode --sourcemap --platform=node --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --watch",
    "bundle-seed": "deno run -A scripts/bundle-seed.ts"
  },
  "imports": {
    "std/": "https://deno.land/std@0.212.0/",
    "esbuild": "https://deno.land/x/esbuild@v0.19.11/mod.js",
    "esbuild-deno-loader": "https://deno.land/x/esbuild_deno_loader@0.8.3/mod.ts",
    "vscode": "npm:@types/vscode@1.85.0",
    "vscode-languageclient/node": "npm:vscode-languageclient@9.0.1/node",
    "vscode-languageserver/node": "npm:vscode-languageserver@9.0.1/node",
    "vscode-languageserver-textdocument": "npm:vscode-languageserver-textdocument@1.0.12",
    "path": "node:path"
  },
  "compilerOptions": {
    "lib": [
      "node",
      "dom",
      "es2022"
    ]
  }
}
