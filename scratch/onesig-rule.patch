--- a/compiler/check_fn_tag.vl
+++ b/compiler/check_fn_tag.vl
@@ -14,6 +14,7 @@ import {
   handBackShared,
 } from "./check_hand_back"
 import { demangleName } from "./check_suggest"
+import { i32ToStr } from "./ast"
 // Which sets of functions a value holds as the i32 id of its member rather than as a closure
 // (D3975). A set is tagged when some call through it needs a member's own instance, and every
 // node carrying it is a place the emitter can lower as an id: a name of a member, a binding, a
@@ -825,6 +826,7 @@ function ftTry(rootIx: i32, s: i32, calls: i32[], mint: i32[]) {
 // `ftTry` reading facts `mint`.
 function ftTryWith(rootIx: i32, s: i32, calls: i32[], mint: i32[]) {
   if fnTagSetIsTagged(s) { return 0 }
+  if ftOneSigScratch(s, calls, mint) { return 0 }
   ftP = ftRecNew()
   ftSubNeed = []
   ftAssume = [s]
@@ -6854,3 +6856,28 @@ function ftLiteralArg(x: i32): boolean {
   const n = if v >= 0 && v < P.nodes.length { nodeAt(v) } else { null }
   return n is ArrayLit || n is ObjLit
 }
+
+function ftOneSigScratch(s: i32, calls: i32[], mint: i32[]): boolean {
+  if fnTagMembers(s).length != 1 { return false }
+  for r in mint {
+    if mintFactSetOf(r) == s { return false }
+  }
+  let sig = ""
+  let seen = false
+  for c in calls {
+    if fnTagCallSetOf(c) == s {
+      const cn = nodeAt(c)
+      if !(cn is Call) { return false }
+      let k = ""
+      for a in cn.callArgs {
+        const at = nodeTyIxOf(a)
+        if at < 0 || tyHasTyVar(at) || tyHoldsHole(at) { return false }
+        k = k + "," + i32ToStr(at)
+      }
+      if seen && k != sig { return false }
+      sig = k
+      seen = true
+    }
+  }
+  return seen
+}
