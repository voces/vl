index 68060c46..531449fc 100644
--- a/compiler/check_elab_cap.vl
+++ b/compiler/check_elab_cap.vl
@@ -1,3 +1,4 @@
+import { nodeToks } from "./ast"
 // `check_elab_cap.vl` — what one elaboration records while it re-checks an instance body: each
 // node's type at the instance, and each call's closed bindings. Recording is live only at the
 // elaboration's own quiet depth, so a probe nested inside the body records nothing.
@@ -6001,3 +6002,22 @@ export function elabParamCopyOf(d: i32, fn: FuncDecl): i32 {
   }
   return -1
 }
+
+export function msrSetRows(): string[] {
+  const out: string[] = []
+  let s = 0
+  while s < fnSets.length {
+    let m = ""
+    for d in fnSets[s] { m = m + i32ToStr(nodeLineOfMsr(d)) + "," }
+    out.push("msr set " + i32ToStr(s) + " [" + m + "] " + fnSetRep(s))
+    s = s + 1
+  }
+  return out
+}
+function nodeLineOfMsr(at: i32): i32 {
+  if at >= 0 && at < nodeToks.length {
+    const tk = nodeToks[at]
+    if tk >= 0 && tk < P.toks.length { return P.toks[tk].line }
+  }
+  return 0
+}
