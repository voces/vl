// The `-O` escape step's choice and renames, ported from the host
// (docs/internals/optimizer-in-vl.md, rung R3): the small callees inlined first so a caller's
// per-call struct or small record stays off the GC heap (DECISIONS.md, "`-O` inlines the
// helpers a per-call struct is passed to"). The host stages the module with `optInLoad` and
// calls `optEscapeChoose`, runs `wasm-opt` with `--no-inline=L4n.*` on its answer, stages
// that output and calls `optEscapeRestore`; both answer through `optOut*`.

import {
  RUN_ONCE_INLINE_LEAF_BYTES,
  ScanState,
  isDefined,
  newScanState,
  optInBytes,
  optOutSet,
  runOnceSet,
  scanModule,
} from "./opt_scan"
import { wnEntry, wnRead, wnTable, wnWrite } from "./wasm_names"
import { i32ListHas } from "./listutil"

// A chosen callee's body is at most this many bytes.
const ESCAPE_INLINE_MAX_BYTES = 320
// A record a producer's result is inlined for has at most this many fields.
const ESCAPE_RECORD_MAX_FIELDS = 8
// A chosen callee with its own chosen callees inlined is at most this many bytes.
const ESCAPE_INLINE_EXPANDED_BYTES = 4096
// The step grows the code section by at most this many bytes plus half its size.
const ESCAPE_INLINE_GROWTH_FLOOR = 65536
const SATURATED = 0x7fffffff

// The module the last `optEscapeChoose` renamed, and per function index the bytes
// `[nameAt, nameAt + nameLen)` of its name there (-1 for none), for `optEscapeRestore`.
let chosenFrom: u8[] = []
let fromNameAt: i32[] = []
let fromNameLen: i32[] = []
let restorePending = false

// Chooses the callees to inline for the staged module. Returns 1 with `optOut` holding the
// module renamed for the step, every chosen callee `L4c.<index>` and every other defined
// function `L4n.<index>`; 0 with an empty answer when nothing is chosen or the module does
// not decode.
export function optEscapeChoose(): i32 {
  optOutSet([])
  restorePending = false
  const b = optInBytes()
  const s = newScanState(true)
  if !scanModule(s) { return 0 }
  const chosen = escapeChoice(s)
  if chosen.length == 0 { return 0 }
  const w = wnRead(b)
  if !w.ok { return 0 }
  const n = s.nImports + s.bodySize.length
  const table = wnTable(w, n)
  const entries: u8[] = []
  let count = 0
  fromNameAt = []
  fromNameLen = []
  let f = 0
  while f < n {
    const r = table[f]
    fromNameAt.push(if r >= 0 { w.at[r] } else { -1 })
    fromNameLen.push(if r >= 0 { w.len[r] } else { 0 })
    if f >= s.nImports {
      const name: u8[] = []
      for cp in if chosen[f] { "L4c." } else { "L4n." } { name.push(cp) }
      putDecimal(name, f)
      wnEntry(entries, f, name, 0, name.length)
      count = count + 1
    } else if r >= 0 {
      wnEntry(entries, f, b, w.at[r], w.len[r])
      count = count + 1
    }
    f = f + 1
  }
  optOutSet(wnWrite(b, w, count, entries))
  chosenFrom = b
  restorePending = true
  1
}

// Gives the staged output of the step every function's name back from the module
// `optEscapeChoose` renamed: 1 with `optOut` holding the restored module; 0 when some defined
// function lost the name the step gave it; -1 when the module does not decode; -2 with no
// renamed module to restore from.
export function optEscapeRestore(): i32 {
  optOutSet([])
  if !restorePending { return -2 }
  restorePending = false
  const b = optInBytes()
  const s = newScanState(true)
  if !scanModule(s) { return -1 }
  const w = wnRead(b)
  if !w.ok { return -1 }
  const n = s.nImports + s.bodySize.length
  const table = wnTable(w, n)
  const entries: u8[] = []
  let count = 0
  let f = 0
  while f < n {
    const r = table[f]
    if f < s.nImports {
      if r >= 0 {
        wnEntry(entries, f, b, w.at[r], w.len[r])
        count = count + 1
      }
    } else {
      const o = if r >= 0 { originalIndex(b, w.at[r], w.len[r]) } else { -1 }
      if o == -1 { return 0 }
      if o >= 0 && o < fromNameAt.length && fromNameAt[o] >= 0 {
        wnEntry(entries, f, chosenFrom, fromNameAt[o], fromNameLen[o])
        count = count + 1
      }
    }
    f = f + 1
  }
  optOutSet(wnWrite(b, w, count, entries))
  1
}

// The original index a step name `L4c.<u32>` or `L4n.<u32>` carries (an optional `+`, then
// decimal digits): -1 when the name is no such name, -2 for an index past 2^31 - 1.
function originalIndex(b: u8[], at: i32, len: i32): i32 {
  if len < 5 || b[at] != 0x4c || b[at + 1] != 0x34 || b[at + 3] != 0x2e {
    return -1
  }
  if b[at + 2] != 0x63 && b[at + 2] != 0x6e { return -1 }
  let i = at + 4
  const end = at + len
  if b[i] == 0x2b { i = i + 1 }
  if i == end { return -1 }
  let k = i
  while k < end {
    if b[k] < 0x30 || b[k] > 0x39 { return -1 }
    k = k + 1
  }
  while i < end - 1 && b[i] == 0x30 { i = i + 1 }
  const digits = end - i
  if digits > 10 { return -1 }
  if digits == 10 {
    if digitsAbove(b, i, "4294967295") { return -1 }
    if digitsAbove(b, i, "2147483647") { return -2 }
  }
  let v = 0
  while i < end {
    v = v * 10 + (b[i] - 0x30)
    i = i + 1
  }
  v
}

// Whether the ten digits at `at` spell a number above the ten digits of `limit`.
function digitsAbove(b: u8[], at: i32, limit: string): boolean {
  let k = 0
  for d in limit {
    const x: i32 = b[at + k]
    if x != d { return x > d }
    k = k + 1
  }
  false
}

// Appends a non-negative `v` in decimal.
function putDecimal(out: u8[], v: i32) {
  if v >= 10 { putDecimal(out, v / 10) }
  out.push(48 + v % 10)
}

// Per function index, whether the step inlines it; empty when it inlines nothing. A small
// callee outside every call cycle and run-once code is chosen when it takes a struct type no
// heap location holds and hands it only to chosen callees, or returns a small record a caller
// keeps (DECISIONS.md, "`-O` inlines the helpers a per-call struct is passed to").
function escapeChoice(s: ScanState): boolean[] {
  const e = escapeFacts(s)
  const n = s.nImports + s.bodySize.length
  const allowed: boolean[] = []
  let f = 0
  while f < n {
    allowed.push(e.eligible[f] && e.gives[f].length > 0)
    f = f + 1
  }
  // Two rounds, not a fixpoint: the second drops the takers only a futile producer made worth
  // choosing.
  const first = escapeRound(s, e, producers(s, e, allowed))
  const chosen = escapeRound(s, e, first.useful).chosen
  let any = false
  f = 0
  while f < n {
    if chosen[f] { any = true }
    f = f + 1
  }
  if !any { return [] }
  // Every call from an unchosen function into a chosen one becomes a copy of that callee's
  // expanded body.
  const memo = fill(n, -1)
  let growth = 0
  let code = 0
  let b = 0
  while b < s.bodySize.length {
    code = satAdd(code, s.bodySize[b])
    const caller = s.nImports + b
    if !chosen[caller] {
      let k = s.bodySiteStart[b]
      const end = siteEnd(s, b)
      while k < end {
        const g = s.siteCallee[k]
        if g < n && chosen[g] {
          growth = satAdd(growth, expanded(s, g, chosen, memo))
        }
        k = k + 1
      }
    }
    b = b + 1
  }
  if growth > ESCAPE_INLINE_GROWTH_FLOOR + code / 2 { return [] }
  chosen
}

// What the choice reads, per function index: the per-call struct types its parameters take
// and the small records its results give back, whether it may be chosen at all, and its
// direct callers (`callerOf[callerStart[f] .. callerStart[f + 1])`).
type EscapeFacts = {
  takes: i32[][],
  gives: i32[][],
  eligible: boolean[],
  callerStart: i32[],
  callerOf: i32[],
}

type EscapeRound = { chosen: boolean[], useful: boolean[] }

function escapeFacts(s: ScanState): EscapeFacts {
  const n = s.nImports + s.bodySize.length
  const nt = s.typeStruct.length
  const excluded = fill(nt, 0)
  for t in s.held {
    if t < nt { excluded[t] = 1 }
  }
  for t in s.subtyped {
    if t >= 0 && t < nt { excluded[t] = 1 }
  }
  const takes: i32[][] = []
  const gives: i32[][] = []
  let f = 0
  while f < n {
    const take: i32[] = []
    const give: i32[] = []
    const b = f - s.nImports
    if b >= 0 && b < s.funcTypes.length {
      const ty = s.funcTypes[b]
      if ty >= 0 && ty < nt {
        for t in s.typeParams[ty] {
          if perCallStruct(s, excluded, t) { take.push(t) }
        }
        for t in s.typeResults[ty] {
          if perCallStruct(s, excluded, t) && smallRecord(s, t) { give.push(t) }
        }
      }
    }
    takes.push(take)
    gives.push(give)
    f = f + 1
  }
  // Callers by callee, counted then placed.
  const callerStart = fill(n + 1, 0)
  for g in s.siteCallee {
    if g >= 0 && g < n { callerStart[g + 1] = callerStart[g + 1] + 1 }
  }
  f = 0
  while f < n {
    callerStart[f + 1] = callerStart[f + 1] + callerStart[f]
    f = f + 1
  }
  const place: i32[] = []
  f = 0
  while f < n {
    place.push(callerStart[f])
    f = f + 1
  }
  const callerOf = fill(callerStart[n], 0)
  let k = 0
  while k < s.siteCallee.length {
    const g = s.siteCallee[k]
    if g >= 0 && g < n {
      callerOf[place[g]] = s.siteCaller[k]
      place[g] = place[g] + 1
    }
    k = k + 1
  }
  const once = runOnceSet(s)
  const cyclic = cyclicSet(s)
  const eligible: boolean[] = []
  f = 0
  while f < n {
    let ok = isDefined(s, f)
      && s.bodySize[f - s.nImports] <= ESCAPE_INLINE_MAX_BYTES
      && !cyclic[f]
    if ok && !leaf(s, f) {
      // Neither run-once code nor called from it, and called at all.
      ok = !once[f] && callerStart[f + 1] > callerStart[f]
      let c = callerStart[f]
      while ok && c < callerStart[f + 1] {
        if once[callerOf[c]] { ok = false }
        c = c + 1
      }
    }
    eligible.push(ok)
    f = f + 1
  }
  {
    takes: takes,
    gives: gives,
    eligible: eligible,
    callerStart: callerStart,
    callerOf: callerOf,
  }
}

// A struct type that no field, element, global or table holds, no cast targets, and no
// subtyping names.
function perCallStruct(s: ScanState, excluded: i32[], t: i32): boolean {
  t < s.typeStruct.length && s.typeStruct[t] && excluded[t] == 0
}

// A struct type of at most `ESCAPE_RECORD_MAX_FIELDS` fields, each a number or a reference to
// a struct type.
function smallRecord(s: ScanState, t: i32): boolean {
  const fields = s.typeFields[t]
  if fields.length > ESCAPE_RECORD_MAX_FIELDS { return false }
  for x in fields {
    if x == -2 { return false }
    if x >= 0 && (x >= s.typeStruct.length || !s.typeStruct[x]) { return false }
  }
  true
}

// A tiny loop-free function calling no defined one, which may go into run-once code.
function leaf(s: ScanState, f: i32): boolean {
  const b = f - s.nImports
  !s.bodyLoop[b]
    && !s.bodyCalls[b]
    && s.bodySize[b] <= RUN_ONCE_INLINE_LEAF_BYTES
}

// The producers among `allowed`: a worklist from those that allocate what they give back up
// through their callers that give back a type in common.
function producers(
  s: ScanState,
  e: EscapeFacts,
  allowed: boolean[],
): boolean[] {
  const n = allowed.length
  const found: boolean[] = []
  const work: i32[] = []
  let f = 0
  while f < n {
    let seed = false
    if allowed[f] {
      for t in e.gives[f] {
        if allocates(s, f, t) { seed = true }
      }
    }
    found.push(seed)
    if seed { work.push(f) }
    f = f + 1
  }
  while work.length > 0 {
    const g = work.pop() ?? -1
    let k = e.callerStart[g]
    while k < e.callerStart[g + 1] {
      const c = e.callerOf[k]
      if !found[c] && allowed[c] && overlaps(e.gives[c], e.gives[g]) {
        found[c] = true
        work.push(c)
      }
      k = k + 1
    }
  }
  found
}

// One round: the seed producers, the takers they and the allocating callers make worth
// choosing, the drops, and then the producers left whose record stays in some caller.
function escapeRound(
  s: ScanState,
  e: EscapeFacts,
  seed: boolean[],
): EscapeRound {
  const n = seed.length
  const chosen: boolean[] = []
  for x in seed { chosen.push(x) }
  // A fixpoint, since a chosen callee can make its own callees worth choosing.
  let changed = true
  while changed {
    changed = false
    let f = s.nImports
    while f < n {
      if !chosen[f] && e.eligible[f] && taker(s, e, f, chosen) {
        chosen[f] = true
        changed = true
      }
      f = f + 1
    }
  }
  // Drop, to a fixpoint, a callee that hands a type it takes to a function not chosen, and
  // one whose chain of chosen callees inlines to more than the expanded bound.
  changed = true
  while changed {
    changed = false
    const leaks: i32[] = []
    let f = s.nImports
    while f < n {
      if chosen[f] && handsOn(s, e, f, chosen) { leaks.push(f) }
      f = f + 1
    }
    for x in leaks { chosen[x] = false }
    const memo = fill(n, -1)
    const tooBig: i32[] = []
    f = s.nImports
    while f < n {
      if (
        chosen[f]
        && expanded(s, f, chosen, memo) > ESCAPE_INLINE_EXPANDED_BYTES
      ) {
        tooBig.push(f)
      }
      f = f + 1
    }
    for x in tooBig { chosen[x] = false }
    changed = leaks.length > 0 || tooBig.length > 0
  }
  // A producer that takes no struct is worth inlining only where what it gives back stays in
  // some caller: a least fixpoint by worklist, where a caller that returns the record counts
  // once it is itself useful or a chosen taker.
  const pure: boolean[] = []
  const work: i32[] = []
  let f = 0
  while f < n {
    const p = chosen[f] && e.takes[f].length == 0 && e.gives[f].length > 0
    pure.push(p)
    if p { work.push(f) }
    f = f + 1
  }
  const isUseful: boolean[] = []
  while isUseful.length < n { isUseful.push(false) }
  while work.length > 0 {
    const g = work.pop() ?? -1
    if !isUseful[g] && kept(s, e, g, chosen, pure, isUseful) {
      isUseful[g] = true
      let k = s.bodySiteStart[g - s.nImports]
      const end = siteEnd(s, g - s.nImports)
      while k < end {
        const h = s.siteCallee[k]
        if h < n && pure[h] { work.push(h) }
        k = k + 1
      }
    }
  }
  f = 0
  while f < n {
    if pure[f] && !isUseful[f] { chosen[f] = false }
    f = f + 1
  }
  { chosen: chosen, useful: isUseful }
}

// Whether some caller of `f` makes a type `f` takes, or is chosen and takes a type in common.
function taker(
  s: ScanState,
  e: EscapeFacts,
  f: i32,
  chosen: boolean[],
): boolean {
  let k = e.callerStart[f]
  while k < e.callerStart[f + 1] {
    const c = e.callerOf[k]
    for t in e.takes[f] {
      if makes(s, e, c, t, chosen) { return true }
    }
    if chosen[c] && overlaps(e.takes[f], e.takes[c]) { return true }
    k = k + 1
  }
  false
}

// Whether `f` hands a type it takes to a defined function that is not chosen.
function handsOn(
  s: ScanState,
  e: EscapeFacts,
  f: i32,
  chosen: boolean[],
): boolean {
  const n = chosen.length
  let k = s.bodySiteStart[f - s.nImports]
  const end = siteEnd(s, f - s.nImports)
  while k < end {
    const g = s.siteCallee[k]
    if g != f && g < n && !chosen[g] && overlaps(e.takes[f], e.takes[g]) {
      return true
    }
    k = k + 1
  }
  false
}

// Whether what pure producer `f` gives back stays in some caller.
function kept(
  s: ScanState,
  e: EscapeFacts,
  f: i32,
  chosen: boolean[],
  pure: boolean[],
  useful: boolean[],
): boolean {
  let k = e.callerStart[f]
  while k < e.callerStart[f + 1] {
    const c = e.callerOf[k]
    const returnsOk = chosen[c] && (!pure[c] || useful[c])
    for t in e.gives[f] {
      if stays(s, e, c, t, chosen, returnsOk) { return true }
    }
    k = k + 1
  }
  false
}

// Whether `c` holds a fresh `t` of its own: it allocates one, or a chosen callee that gives
// `t` back is inlined into it.
function makes(
  s: ScanState,
  e: EscapeFacts,
  c: i32,
  t: i32,
  chosen: boolean[],
): boolean {
  if allocates(s, c, t) { return true }
  const n = chosen.length
  let k = s.bodySiteStart[c - s.nImports]
  const end = siteEnd(s, c - s.nImports)
  while k < end {
    const g = s.siteCallee[k]
    if g < n && chosen[g] && i32ListHas(e.gives[g], t) { return true }
    k = k + 1
  }
  false
}

// Whether a `t` held by `c` stays in `c` once the chosen callees are inlined: `c` hands it to
// no defined function that is not chosen, and returns it only when `returnsOk`.
function stays(
  s: ScanState,
  e: EscapeFacts,
  c: i32,
  t: i32,
  chosen: boolean[],
  returnsOk: boolean,
): boolean {
  const n = chosen.length
  let k = s.bodySiteStart[c - s.nImports]
  const end = siteEnd(s, c - s.nImports)
  while k < end {
    const g = s.siteCallee[k]
    if g != c && g < n && !chosen[g] && i32ListHas(e.takes[g], t) {
      return false
    }
    k = k + 1
  }
  !i32ListHas(e.gives[c], t) || returnsOk
}

// `f`'s body size with every chosen callee of its own inlined, memoised in `memo` (-1 for
// not yet), saturating. The chosen graph has no cycle, so the walk ends.
function expanded(s: ScanState, f: i32, chosen: boolean[], memo: i32[]): i32 {
  if memo[f] >= 0 { return memo[f] }
  memo[f] = SATURATED
  const b = f - s.nImports
  let size = s.bodySize[b]
  let k = s.bodySiteStart[b]
  const end = siteEnd(s, b)
  while k < end {
    const g = s.siteCallee[k]
    if g < chosen.length && chosen[g] {
      size = satAdd(size, expanded(s, g, chosen, memo))
    }
    k = k + 1
  }
  memo[f] = size
  size
}

// Whether body `f` allocates a `t` with `struct.new` or `struct.new_default`.
function allocates(s: ScanState, f: i32, t: i32): boolean {
  const b = f - s.nImports
  let k = s.bodyAllocStart[b]
  const end = if b + 1 < s.bodyAllocStart.length { s.bodyAllocStart[b + 1] } else { s.allocType.length }
  while k < end {
    if s.allocType[k] == t { return true }
    k = k + 1
  }
  false
}

// The end of body `b`'s call-site rows.
function siteEnd(s: ScanState, b: i32): i32 {
  if b + 1 < s.bodySiteStart.length {
    s.bodySiteStart[b + 1]
  } else {
    s.siteCallee.length
  }
}

// Every defined function in a call cycle: a strongly connected component of the direct call
// graph with more than one member, or one calling itself. Iterative Tarjan.
function cyclicSet(s: ScanState): boolean[] {
  const ni = s.nImports
  const nb = s.bodySize.length
  const out: boolean[] = []
  while out.length < ni + nb { out.push(false) }
  const index = fill(nb, -1)
  const low = fill(nb, 0)
  const onStack: boolean[] = []
  while onStack.length < nb { onStack.push(false) }
  const stack: i32[] = []
  // The walk: a node, and the next of its call-site rows to visit.
  const node: i32[] = []
  const pos: i32[] = []
  let next = 0
  let root = 0
  while root < nb {
    if index[root] < 0 {
      index[root] = next
      low[root] = next
      next = next + 1
      stack.push(root)
      onStack[root] = true
      node.push(root)
      pos.push(s.bodySiteStart[root])
      while node.length > 0 {
        const top = node.length - 1
        const v = node[top]
        const p = pos[top]
        if p < siteEnd(s, v) {
          pos[top] = p + 1
          const callee = s.siteCallee[p]
          if isDefined(s, callee) {
            const w = callee - ni
            if index[w] < 0 {
              index[w] = next
              low[w] = next
              next = next + 1
              stack.push(w)
              onStack[w] = true
              node.push(w)
              pos.push(s.bodySiteStart[w])
            } else if onStack[w] && index[w] < low[v] {
              low[v] = index[w]
            }
          }
        } else {
          node.pop()
          pos.pop()
          if node.length > 0 {
            const u = node[node.length - 1]
            if low[v] < low[u] { low[u] = low[v] }
          }
          if low[v] == index[v] { closeComponent(s, v, stack, onStack, out) }
        }
      }
    }
    root = root + 1
  }
  out
}

// Pops `v`'s component off `stack` and marks it in `out` when it is a cycle.
function closeComponent(
  s: ScanState,
  v: i32,
  stack: i32[],
  onStack: boolean[],
  out: boolean[],
) {
  const comp: i32[] = []
  let done = false
  while !done && stack.length > 0 {
    const w = stack.pop() ?? -1
    onStack[w] = false
    comp.push(w)
    done = w == v
  }
  let cycle = comp.length > 1
  if !cycle {
    let k = s.bodySiteStart[v]
    const end = siteEnd(s, v)
    while k < end {
      if s.siteCallee[k] == s.nImports + v { cycle = true }
      k = k + 1
    }
  }
  if cycle {
    for w in comp { out[s.nImports + w] = true }
  }
}

function overlaps(a: i32[], b: i32[]): boolean {
  for x in a {
    if i32ListHas(b, x) { return true }
  }
  false
}

function fill(n: i32, v: i32): i32[] {
  const out: i32[] = []
  while out.length < n { out.push(v) }
  out
}

function satAdd(a: i32, b: i32): i32 {
  if a > SATURATED - b { SATURATED } else { a + b }
}
