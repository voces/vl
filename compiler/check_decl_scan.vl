import { collectRetValues } from "./check_nj_join"

// `cBoundDecls` — every `type Showable = { toString(): string }` in the program, name → the
// declaration's bound-body annotation node. Registered in pass 0a instead of `cUserTypes`:
// a bound constrains a type parameter and has no values, so it is not a type, and
// `declaredTyOfName` turns a value-position use into a sentence rather than into a struct.
export let cBoundDecls: {[string]: i32} = Map()
export function cBoundDeclsSetAt(k: string, v: i32) { cBoundDecls[k] = v }

// The function a local `let`/`const` is declared in, and the binding a plain `x = e` write stores
// into, keyed on `e`: what a pin asks to tell whether a call can reach the written value.
export let letDeclFn: {[i32]: i32} = Map()
export function letDeclFnPut(k: i32, v: i32) { letDeclFn.set(k, v) }

// The function each function body is checked inside, -1 at module scope, -2 when two checks of
// the body disagreed.
export let fnDeclParent: {[i32]: i32} = Map()
export function fnDeclParentPut(k: i32, v: i32) {
  const was = fnDeclParent.get(k) ?? v
  if was != v { fnDeclParent.set(k, -2) } else { fnDeclParent.set(k, v) }
}

export let wrDstDecl: {[i32]: i32} = Map()
export function wrDstDeclPut(k: i32, v: i32) { wrDstDecl.set(k, v) }

// The integer-literal initializer of each top-level `const`, by name: what a memory
// intrinsic's offset may name besides a literal (`memOffsetArgCheck`).
export let moduleConstIntInit: {[string]: i32} = Map()
export function moduleConstIntInitSetAt(k: string, v: i32) {
  moduleConstIntInit[k] = v
}

// Annotation atom-count sidecar: how many top-level union atoms the annotation node's emit-time
// spelling is joined from, banked by `canonEmitTypeNames`, the producer of that spelling. The
// count cannot be recovered from the arena — an annotation over two same-shape declared structs
// dedups to a plain `TyObj`. Keyed by node, holding the `TypeRef`s only: every other node reads -1.
export let annUnionAtoms: {[i32]: i32} = Map()

// ── the declaration fill registry (pass 0a / 0b) ─────────────────────────────
export function annUnionAtomsSet(v: {[i32]: i32}) { annUnionAtoms = v }
export function annUnionAtomsSetAt(k: i32, v: i32) { annUnionAtoms[k] = v }

// D1045 — the nominal declarations declared inside a block, keyed by their mangled name. A nominal
// type is its name, so one whose name goes out of scope takes the nominal identity with it:
// nothing can spell the return of `function fresh() { type Id = new i32; return 7 as Id }`, and
// the checker refuses the inferred return. Only nominal rows; a local struct escapes freely.
export let nwBodyScopedNames: {[string]: i32} = Map()
export function nwBodyScopedNamesSetAt(k: string, v: i32) {
  nwBodyScopedNames[k] = v
}

// The checker type of SIMD row `row`, built from its operand shape.
function simdRowTy(row: i32): i32 {
  const v = TY_V128
  const sig = simdSigs[row]
  if sig == SIMD_SIG_V_V { return mkFuncTy([v], v) }
  if sig == SIMD_SIG_VV_V { return mkFuncTy([v, v], v) }
  if sig == SIMD_SIG_VVV_V { return mkFuncTy([v, v, v], v) }
  if sig == SIMD_SIG_V_I { return mkFuncTy([v], TY_I32) }
  if sig == SIMD_SIG_VI_V { return mkFuncTy([v, TY_I32], v) }
  if sig == SIMD_SIG_I_V { return mkFuncTy([TY_I32], v) }
  if sig == SIMD_SIG_L_V { return mkFuncTy([TY_I64], v) }
  if sig == SIMD_SIG_F_V { return mkFuncTy([TY_F32], v) }
  if sig == SIMD_SIG_LOAD { return mkFuncTy([TY_I32], v) }
  if sig == SIMD_SIG_STORE { return mkFuncTy([TY_I32, v], TY_VOID) }
  if sig == SIMD_SIG_LANE_I { return mkFuncTy([v, TY_I32], TY_I32) }
  if sig == SIMD_SIG_LANE_L { return mkFuncTy([v, TY_I32], TY_I64) }
  if sig == SIMD_SIG_LANE_F { return mkFuncTy([v, TY_I32], TY_F32) }
  if sig == SIMD_SIG_REPL_I { return mkFuncTy([v, TY_I32, TY_I32], v) }
  if sig == SIMD_SIG_REPL_L { return mkFuncTy([v, TY_I32, TY_I64], v) }
  if sig == SIMD_SIG_REPL_F { return mkFuncTy([v, TY_I32, TY_F32], v) }
  let lanes = -1
  if sig == SIMD_SIG_SHUF4 { lanes = 4 }
  if sig == SIMD_SIG_SHUF16 { lanes = 16 }
  // No other shape exists; an unknown one types as an error rather than as some shuffle.
  if lanes < 0 { return TY_ERR }
  const ps: i32[] = [v, v]
  while ps.length < lanes + 2 { ps.push(TY_I32) }
  mkFuncTy(ps, v)
}

// Declares every SIMD row at the type its operand shape names.
export function declareSimdIntrinsics() {
  if simdNames.length == 0 { simdTableBuild() }
  let i = 0
  while i < simdNames.length {
    declareAmbient(simdNames[i], simdRowTy(i))
    i = i + 1
  }
  0
}

export function declareTruncSatIntrinsics() {
  let op = 0
  while op < TRUNC_SAT_NAMES.length {
    let arg = TY_F32
    if truncSatFromF64(op) { arg = TY_F64 }
    let ret = TY_I32
    if truncSatIsI64(op) { ret = TY_I64 }
    declareAmbient(TRUNC_SAT_NAMES[op], mkFuncTy([arg], ret))
    op = op + 1
  }
  0
}

// The checker type of atomic row `row`, built from its operand shape and value width.
function atomicRowTy(row: i32): i32 {
  const a = TY_I32
  let v = TY_I32
  if atomicI64[row] { v = TY_I64 }
  const sig = atomicSigs[row]
  if sig == ATOMIC_SIG_LOAD { return mkFuncTy([a], v) }
  if sig == ATOMIC_SIG_STORE { return mkFuncTy([a, v], TY_VOID) }
  if sig == ATOMIC_SIG_RMW { return mkFuncTy([a, v], v) }
  if sig == ATOMIC_SIG_CMPXCHG { return mkFuncTy([a, v, v], v) }
  if sig == ATOMIC_SIG_WAIT { return mkFuncTy([a, v, TY_I64], TY_I32) }
  if sig == ATOMIC_SIG_NOTIFY { return mkFuncTy([a, TY_I32], TY_I32) }
  const noParams: i32[] = []
  if sig == ATOMIC_SIG_FENCE { return mkFuncTy(noParams, TY_VOID) }
  TY_ERR
}

// Declares every atomic row at the type its operand shape names.
export function declareAtomicIntrinsics() {
  if atomicNames.length == 0 { atomicTableBuild() }
  let i = 0
  while i < atomicNames.length {
    declareAmbient(atomicNames[i], atomicRowTy(i))
    i = i + 1
  }
  0
}

// The collection methods that can remove or replace a cell — the only intrinsic calls that falsify
// a narrowing of a cell of their own receiver: a removal, and a map's `set`, which writes the key's
// value like `m[k] = v`. Deliberately not `cwMutatesList`'s whole set: `push` appends and `add`
// inserts, neither of which can change what `xs[0]` or `m["a"]` holds.
export function cellRemovingMethod(p: string): boolean {
  builtinMethodEffect(p) == BME_CELLS
}

// Whether any written sub-path in the summary `sum` is `path` itself or a prefix of it; true when
// `sum` is opaque. Writing `o.a` replaces the sub-object, so it kills `o.a.v` and `o.a[0]` as
// surely as writing them does.
export function pathHitsAny(path: string, sum: WeSet): boolean {
  if sum.opaque { return true }
  for id in sum.parts {
    const w = wePartTextOf(id)
    if path == w || keyHasPrefix(path, w + ".") || keyHasPrefix(path, w + "[") {
      return true
    }
  }
  false
}

// The occurrence recorded for node `ix`, or -1.
function lbiOccOfNode(ix: i32): i32 {
  if ix < 0 || ix >= nodeToks.length { return -1 }
  const tok = nodeToks[ix]
  let i = symOccTok.length - 1
  while i >= 0 {
    if symOccTok[i] == tok { return i }
    i = i - 1
  }
  -1
}

// Give each rewritten read's occurrence the type its literal took there.
export function lbiSymTypes() {
  let i = 0
  while i < lbiOccIx.length {
    const n = lbiOccNode[i]
    let o = lbiOccIx[i]
    if o < 0 { o = lbiOccOfNode(n) }
    const t = lbiUseTy[n] ?? nodeTyOf(n)
    if t >= 0 && o >= 0 && o < symOccTy.length { symOccTy[o] = t }
    if o >= 0 { lbiOccLit[o] = n }
    i = i + 1
  }
  0
}

// Fill `lbiModLit` from the top-level statements `stmts`, following copies in any order.
export function lbiScanModLits(stmts: i32[]) {
  lbiModLit = Map()
  let grew = true
  while grew {
    grew = false
    for st in stmts {
      const d = nodeAt(st)
      if d is LetDecl {
        if (
          d.letKw == "const"
          && d.letType < 0
          && d.letInit >= 0
          && !lbiModLit.has(d.letName)
        ) {
          let lit = lbiInitLit(d.letInit)
          if lit < 0 && cexFoldModInit(d.letInit) {
            lit = lbiInitLit(d.letInit)
          }
          if lit >= 0 {
            lbiModLit[d.letName] = lit
            grew = true
          }
        }
      }
    }
  }
  // Every other module initializer that is a constant tree is its literal too, so the declaration
  // pass sees it as the bare spelling (an annotated `const`, a `let`).
  for st in stmts {
    const d = nodeAt(st)
    if d is LetDecl {
      if d.letInit >= 0 && (d.letKw != "const" || d.letType >= 0) {
        cexFoldModInit(d.letInit)
      }
    }
  }
  0
}

// ── exact constants (DECISIONS.md, "Exact constant arithmetic") ─────────────────────────────
// A tree of numeric literals, literal `const`s and arithmetic, bitwise and shift operators is
// computed exactly and rewritten into the literal of its value, which each use then types as it
// would that literal written there.

// Fold the module initializer `init` before the module is checked, so its reads anywhere are
// its literal; false when it is not (yet) a constant tree.
function cexFoldModInit(init: i32): boolean {
  const p = parenPeelIx(init)
  if p < 0 || !cexRootShape(p) { return false }
  cexModScan = true
  const v = cexEvalAt(p, 0)
  cexModScan = false
  if !cexOk(v) || cexPastF64(v) { return false }
  cexRewrite(p, v)
  true
}

// A read `ix` of the name `name`, recorded when it is a candidate's.
export function lbiNoteRead(ix: i32, name: string) {
  if inferQuiet || !lbiNameSeen[lbiNameKey(name)] { return 0 }
  const c = lbiCandOfName(ix, name)
  if c >= 0 {
    lbiReadNode.push(ix)
    lbiReadCand.push(c)
    lbiReadWide.push(-1)
  }
  0
}

// The primitive spellings. -1 means "not a primitive" — every hit is a fixed arena index, all >= 0,
// so the sentinel cannot collide with an answer. Exported because the emit side's name bridge
// (`emit_rep.declTyIxOfName`) asks it directly, and the answers are the arena's seeded indices, so
// the emit-side rung and this resolver's leaf are the same value by construction.
export function primTyOfName(name: string) {
  const t = primTyIxOfName(name)
  if t == TY_V128 { v128Seen = true }
  t
}

// `primTyOfName` with no side effect: a spelling's seeded primitive index, or -1. A `v128` is
// not noted as used, so a caller asking only whether a spelling is a primitive may ask it.
export function primTyIxOfName(name: string): i32 {
  if name == "i32" { return TY_I32 }
  if name == "i64" { return TY_I64 }
  if name == "f64" { return TY_F64 }
  if name == "f32" { return TY_F32 }
  if name == "boolean" { return TY_BOOL }
  if name == "string" { return TY_STR }
  if name == "void" { return TY_VOID }
  // The `null` type itself — the check type of `x is null` (host: an Alias
  // named "null"); union members spell it through the `|`-split / `TS_NULL`.
  if name == "null" { return TY_NULL }
  // The SIMD substrate, spelled so `std:simd` can brand it (`type F32x4 = new v128`).
  if name == "v128" { return TY_V128 }
  // `never` and the storage type `u8` are not spellings a declaration seeds.
  if name == "never" { return -1 }
  if name == "u8" { return -1 }
  -1
}

// D-MAPKEYDIAG — the spelling node whose key the unsupported-map-key diagnostic names, or -1 when
// this annotation opens no map spelling. The structural dual of `tyname.mapSpellKeyName`'s gate,
// which is deliberately wider than a whole map span: a list of boolean-keyed maps and a nullable
// one are the same mistake. Read structurally, that width is a descent down the left spine.
export function tsMapKeyNodeOf(root: i32) {
  let ix = root
  let out = -1
  let going = true
  while going {
    going = false
    if ix >= 0 {
      const k = tsKind[ix]
      if k == TS_MAP {
        out = ix
      } else if k == TS_ARR || k == TS_UNION || k == TS_ISECT {
        if tsKidCount[ix] > 0 {
          ix = tsKids[tsKidStart[ix]]
          going = true
        }
      }
    }
  }
  out
}

// ── `tsToTy` — the structural dual of `nameToTy` ─────────────────────────────

// `nameToTy` below is the compiler's second recursive-descent type parser; the first is
// `parseTypeName`, which returned a concatenated string. This consumes the flat spelling tree that
// parser keeps — arm for arm, in `nameToTy`'s order, with the same constructors in the same
// sequence, because the arena is not hash-consed and a dual that allocates differently is not one.

// Whether the call at `callIx` ends the narrowing keyed `key` by a rule that holds at every pin:
// an opaque callee, a cell-removing method on the path's own receiver, or a callee whose
// summary writes the path by name through an argument or a free variable.
export function callKillSure(callIx: i32, key: string): boolean {
  const cn = nodeAt(callIx)
  if !(cn is Call) { return false }
  if cn.callFn >= 0 {
    const rmRecv = nodeAt(cn.callFn)
    if rmRecv is Member {
      if cellRemovingMethod(rmRecv.memProp) {
        const rmRoot = placeKeyOf(rmRecv.memObj)
        if rmRoot != "" && keyHasPrefix(key, rmRoot + "[") { return true }
      }
    }
  }
  const declIx = callDeclFnIx(cn, callIx)
  if declIx == -1 { return !crCalleeUnresolved(callIx) }
  if declIx < 0 { return false }
  crAskUsePath(key)
  const free = fnWriteFreePaths(declIx)
  if pathHitsAny(key, free) { return true }
  const args = callArgPlaces(cn, callIx)
  let i = 0
  while i < args.length {
    const ak = placeKeyOf(args[i])
    if ak != "" && keyHasPrefix(key, ak + ".") {
      const sum = fnWriteEffects(declIx, i)
      if pathHitsAny(key.slice(ak.length + 1, key.length), sum) { return true }
    }
    i = i + 1
  }
  false
}

// Whether unnamed call `c` cannot reach the function value row `ci` writes to a local binding:
// the call sits in the binding's own function, is not through it, and that function reads the
// binding only as a callee or a write target. Type variables bind by name, so the call's bindings
// would otherwise adjudicate a write whose generic merely shares a parameter name (D4890).
export function wrUnreachedBy(ci: i32, c: i32, calleeFn: i32): boolean {
  if calleeFn != CSTR_NODECL { return false }
  const got = letCstr.got[ci]
  if got < 0 || got >= T.tys.length || !(tyAt(got) is TyFunc) { return false }
  const d = wrDstDecl.get(letCstr.ix[ci]) ?? -1
  if d < 0 || d >= P.nodes.length || c < 0 || c >= P.nodes.length {
    return false
  }
  const dn = nodeAt(d)
  if !(dn is LetDecl) { return false }
  const cn = nodeAt(c)
  if !(cn is Call) { return false }
  // A call through this binding reaches it; one through another binding of the same name does
  // not (D5972). An unresolved callee of the name counts as this one's.
  if identNameAt(cn.callFn) == dn.letName {
    const cr = identDeclOf(cn.callFn)
    if cr == d || cr < 0 { return false }
  }
  const fx = letDeclFn.get(d) ?? -1
  if fx < 0 || fx >= P.nodes.length { return false }
  const fd = nodeAt(fx)
  if !(fd is FuncDecl) { return false }
  const quiet: {[i32]: i32} = Map()
  const stack: i32[] = [fd.fnBody]
  let inside = false
  while stack.length > 0 {
    const at = stack.pop() ?? -1
    if at >= 0 && at < P.nodes.length {
      const n = nodeAt(at)
      if at == c { inside = true }
      if n is Call { quiet.set(n.callFn, 1) }
      if n is BinExpr && n.binOp == "=" { quiet.set(n.binLeft, 1) }
      // A read of another binding of the name is not this one's; an unresolved read counts.
      if identNameAt(at) == dn.letName && !quiet.has(at) {
        const r = identDeclOf(at)
        if r == d || r < 0 { return false }
      }
      for k in nodeChildren(at) { stack.push(k) }
    }
  }
  // Elsewhere, a call instantiates the binding's body only if that body or one around it is
  // generic; a row no top-level function owns is a lambda's at module scope (D5972).
  const ow = letCstr.fn[ci]
  inside || (wrFnChainClosed(fx) && (ow < 0 || wrFnClosed(ow)))
}

// Whether `fx` and every function its body is checked inside are closed (`wrFnClosed`).
function wrFnChainClosed(fx: i32): boolean {
  let p = fx
  let hops = 0
  while p != -1 {
    if !wrFnClosed(p) || hops > P.nodes.length { return false }
    p = fnDeclParent.get(p) ?? -2
    hops = hops + 1
  }
  true
}

// Whether declaration `fx` is a function with no type parameter and no un-annotated parameter.
function wrFnClosed(fx: i32): boolean {
  if fx < 0 || fx >= P.nodes.length { return false }
  const fd = nodeAt(fx)
  if !(fd is FuncDecl) || fd.fnTyParams.length > 0 { return false }
  for p in fd.fnParams {
    const pn = nodeAt(p)
    if !(pn is Param) || pn.parType < 0 { return false }
  }
  true
}

// The container each written value lands in, keyed on the value: the receiver of a write method,
// or the base of an index write.
export let ctnWrRecv: {[i32]: i32} = Map()
export function ctnWrRecvPut(k: i32, v: i32) { ctnWrRecv.set(k, v) }

// The program's top-level statements, the reach scan's root for a module binding.
export let ctnRootStmts: i32[] = []
export function ctnRootStmtsSet(v: i32[]) { ctnRootStmts = v }

// Per container declaration: the arena length its scan saw, and the `get` bindings it found, or
// null when some read hands its elements elsewhere.
let ctnScanAt: {[i32]: i32} = Map()
let ctnScanGets: {[i32]: string[] | null} = Map()

// Whether call `c` cannot reach the function value `v` that a deferred row of owner `owner`
// writes into a container binding: every read of the binding writes into it, calls an element,
// binds a `.get` that is only called or compared with `null`, or hands it to a function that only
// writes into it, or reads its length — and `c` is none of those calls (D10020).
export function ctnWrUnreachedBy(
  v: i32,
  got: i32,
  owner: i32,
  c: i32,
): boolean {
  if got < 0 || got >= T.tys.length || !(tyAt(got) is TyFunc) { return false }
  if c < 0 || c >= P.nodes.length { return false }
  const cn = nodeAt(c)
  if !(cn is Call) { return false }
  const r = ctnPeel(ctnWrRecv.get(v) ?? -1)
  if r < 0 { return false }
  const rn = nodeAt(r)
  if !(rn is Ident) { return false }
  const d = identDeclOf(r)
  if d < 0 || d >= P.nodes.length { return false }
  if owner >= 0 && !wrFnClosed(owner) { return false }
  if nodeAt(d) is Param {
    const args = ctnParamArgDecls(d)
    if args == null { return false }
    for a in args {
      if !ctnDeclUnreachedBy(a, cn) { return false }
    }
    return true
  }
  ctnDeclUnreachedBy(d, cn)
}

// Whether call `cn` cannot reach a value written into the `let`/`const` binding `d`.
function ctnDeclUnreachedBy(d: i32, cn: Call): boolean {
  const dn = nodeAt(d)
  if !(dn is LetDecl) { return false }
  const fx = letDeclFn.get(d) ?? -1
  if !wrFnChainClosed(fx) { return false }
  const gets = ctnScan(d, dn.letName, fx)
  if gets == null { return false }
  const f = ctnPeel(cn.callFn)
  if f < 0 { return false }
  const fname = identNameAt(f)
  if fname != "" { return !strListHas(gets, fname) }
  !ctnElemRead(f, dn.letName, d)
}

// Per parameter declaration: the arena length its scan saw, and the bindings it found.
let ctnParamAt: {[i32]: i32} = Map()
let ctnParamArgs: {[i32]: i32[] | null} = Map()

// The `let`/`const` bindings passed to parameter `p` of a top-level function that only writes
// into it, one per call, or null when the function is used other than by a direct call or a call
// passes it anything else (D10083).
function ctnParamArgDecls(p: i32): i32[] | null {
  if (ctnParamAt.get(p) ?? -1) == P.nodes.length {
    return ctnParamArgs.get(p) ?? null
  }
  const res = ctnParamArgScan(p)
  ctnParamAt.set(p, P.nodes.length)
  ctnParamArgs.set(p, res)
  res
}

function ctnParamArgScan(p: i32): i32[] | null {
  let fdIx = -1
  let k = -1
  for s in ctnRootStmts {
    const sn = nodeAt(s)
    if sn is FuncDecl {
      let i = 0
      while i < sn.fnParams.length {
        if sn.fnParams[i] == p {
          fdIx = s
          k = i
        }
        i = i + 1
      }
    }
  }
  if fdIx < 0 { return null }
  const fd = nodeAt(fdIx)
  const pn = nodeAt(p)
  if !(fd is FuncDecl) || !(pn is Param) { return null }
  const noGets: string[] = []
  if !ctnReadsKept([fd.fnBody], pn.parName, p, noGets) || noGets.length > 0 {
    return null
  }
  const out: i32[] = []
  let total = 0
  let calls = 0
  const stack: i32[] = []
  for r in ctnRootStmts { stack.push(r) }
  while stack.length > 0 {
    const at = stack.pop() ?? -1
    if at >= 0 && at < P.nodes.length {
      const n = nodeAt(at)
      if n is Ident && n.identName == fd.fnName {
        const rd = identDeclOf(at)
        if rd == fdIx || rd < 0 { total = total + 1 }
      } else if n is Call {
        const f = ctnPeel(n.callFn)
        if (
          f >= 0
          && identNameAt(f) == fd.fnName
          && (identDeclOf(f) == fdIx || identDeclOf(f) < 0)
        ) {
          calls = calls + 1
          if hasNamedArgs(n.callArgNames) || k >= n.callArgs.length {
            return null
          }
          let si = 0
          while si <= k {
            if nodeAt(n.callArgs[si]) is Spread { return null }
            si = si + 1
          }
          const a = ctnPeel(n.callArgs[k])
          if a < 0 || !(nodeAt(a) is Ident) { return null }
          const ad = identDeclOf(a)
          if ad < 0 || ad >= P.nodes.length || !(nodeAt(ad) is LetDecl) {
            return null
          }
          out.push(ad)
        }
      }
      for c in nodeChildren(at) { stack.push(c) }
    }
  }
  if total != calls { return null }
  out
}

// The `let`/`const` declaration whose binding the value `v` is written into by a write method
// or an index write, or -1 when the receiver is no such binding.
export function ctnWrDeclOf(v: i32): i32 {
  ctnBindingDeclOf(ctnPeel(ctnWrRecv.get(v) ?? -1))
}

// The `let`/`const` declaration `ix` reads, directly or through element reads (`ys[1]`), or -1.
export function ctnBindingDeclOf(ix: i32): i32 {
  const p = ctnPeel(ix)
  if p < 0 { return -1 }
  const n = nodeAt(p)
  if n is Index { return ctnBindingDeclOf(n.idxArr) }
  if !(n is Ident) { return -1 }
  const d = identDeclOf(p)
  if d < 0 || d >= P.nodes.length || !(nodeAt(d) is LetDecl) { return -1 }
  d
}

// The flow cut of a delivery of a `let`: values stored into `ctnCutDecl` before token
// `ctnCutTok`, outside a nested function, are replaced by an assignment every path to the
// delivery runs, so the delivery's judges skip them (D10202).
let ctnCutDecl = -1
let ctnCutTok = -1
let ctnCutOwn: {[i32]: boolean} = Map()
let ctnCutNested: {[i32]: boolean} = Map()

export function ctnCutClear() {
  ctnCutDecl = -1
  ctnCutTok = -1
  ctnCutOwn = Map()
  ctnCutNested = Map()
}

// Arms the cut for the binding declaration `d` read at `at`: the last assignment to it that is
// a statement of a block holding `at`, or, for `at` in one nested function, of `d`'s scope
// before that function can first run. False when `d`'s scope cannot be walked; not judged then.
export function ctnCutArm(d: i32, at: i32): boolean {
  ctnCutClear()
  if d < 0 || d >= P.nodes.length { return true }
  const ld = nodeAt(d)
  if !(ld is LetDecl) { return false }
  if ld.letKw == "const" { return true }
  let roots = ctnRootStmts
  const fx = letDeclFn.get(d) ?? -1
  if fx >= 0 {
    const fd = nodeAt(fx)
    if !(fd is FuncDecl) { return false }
    roots = [fd.fnBody]
  }
  const path: i32[] = []
  let found = false
  for r in roots {
    if !found && ctnPathTo(r, at, path) { found = true }
  }
  if !found { return true }
  const on: {[i32]: boolean} = Map()
  let fnAt = -1
  let k = 0
  while k < path.length {
    const p = path[k]
    on.set(p, true)
    if p != at && nodeAt(p) is FuncDecl {
      if fnAt >= 0 { return true }
      fnAt = k
    }
    k = k + 1
  }
  let cut = -1
  const blocks: i32[][] = []
  if fx < 0 && fnAt < 0 { blocks.push(roots) }
  k = fnAt + 1
  while k < path.length {
    const pn = nodeAt(path[k])
    if pn is Block { blocks.push(pn.blkStmts) }
    k = k + 1
  }
  const atTok = nodeStartTok(at)
  for ss in blocks { cut = ctnCutLast(ss, on, ld.letName, d, atTok, cut) }
  if cut < 0 && fnAt >= 0 {
    let outer = roots
    if fx >= 0 {
      const body = nodeAt(roots[0])
      if !(body is Block) { return true }
      outer = body.blkStmts
    }
    const first = ctnFnFirstRun(path[fnAt], roots)
    if first >= 0 { cut = ctnCutLast(outer, on, ld.letName, d, first, -1) }
  }
  if cut < 0 { return true }
  ctnCutDecl = d
  ctnCutTok = cut
  ctnCutMark(ld.letInit, true, false)
  for r in roots { ctnCutWalk(r, ld.letName, d) }
  true
}

// The start token of the last statement of `ss` off the path `on` that assigns binding `d`
// named `name` and starts before token `before`, or `cut` when none starts after `cut`.
function ctnCutLast(
  ss: i32[],
  on: {[i32]: boolean},
  name: string,
  d: i32,
  before: i32,
  cut: i32,
): i32 {
  let c = cut
  for s in ss {
    const sn = nodeAt(s)
    const st = nodeStartTok(s)
    if (
      !on.has(s)
      && sn is BinExpr
      && sn.binOp == "="
      && ctnIsRead(sn.binLeft, name, d)
      && st < before
      && st > c
    ) {
      c = st
    }
  }
  c
}

// The first token from which the nested function `f` under `roots` can run: a lambda where it
// is made, a named function at its first reference, past every token when it has none. -1 when
// it is exported or referenced from another nested function, which may run it at any time.
function ctnFnFirstRun(f: i32, roots: i32[]): i32 {
  const fd = nodeAt(f)
  if !(fd is FuncDecl) { return -1 }
  if fd.fnName == "" { return nodeStartTok(f) }
  if declHasExportKw(f) { return -1 }
  const first: i32[] = [-1]
  for r in roots {
    if !ctnFnRefs(r, f, fd.fnName, false, first) { return -1 }
  }
  if first[0] < 0 { return P.toks.length }
  first[0]
}

// Lowers `first[0]` to the start of each reference of function `f` named `name` under `ix`;
// false on a reference inside a nested function other than `f` itself.
function ctnFnRefs(
  ix: i32,
  f: i32,
  name: string,
  nested: boolean,
  first: i32[],
): boolean {
  if ix < 0 || ix >= P.nodes.length || ix == f { return true }
  const n = nodeAt(ix)
  let isRef = false
  if n is Ident && n.identName == name {
    isRef = identDeclOf(ix) == f || identDeclOf(ix) < 0
  }
  if n is Member && n.memProp == name { isRef = true }
  if isRef {
    if nested { return false }
    const t = nodeStartTok(ix)
    if first[0] < 0 || t < first[0] { first[0] = t }
  }
  const inner = nested || n is FuncDecl
  for c in nodeChildren(ix) {
    if !ctnFnRefs(c, f, name, inner, first) { return false }
  }
  true
}

// Whether the value node `v` is stored into the armed cut's binding before the cut: by its
// initialiser or an assignment, or written into it or into a `const` alias of it.
export function ctnCutKills(v: i32): boolean {
  if ctnCutDecl < 0 || v < 0 || v >= P.nodes.length || ctnCutNested.has(v) {
    return false
  }
  if nodeStartTok(v) >= ctnCutTok { return false }
  if ctnCutOwn.has(v) { return true }
  const wd = ctnWrDeclOf(v)
  if wd == ctnCutDecl { return true }
  if wd < 0 || wd >= P.nodes.length { return false }
  const wn = nodeAt(wd)
  wn is LetDecl
    && wn.letKw == "const"
    && ctnBindingDeclOf(wn.letInit) == ctnCutDecl
}

// Whether `at` is under `ix`, with the nodes from `ix` down to `at` pushed onto `path`.
function ctnPathTo(ix: i32, at: i32, path: i32[]): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  path.push(ix)
  if ix == at { return true }
  for k in nodeChildren(ix) {
    if ctnPathTo(k, at, path) { return true }
  }
  path.pop()
  false
}

// Marks the nodes under `ix` as in a nested function, or as stored into the cut's binding.
function ctnCutMark(ix: i32, own: boolean, nested: boolean) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  if nested { ctnCutNested.set(ix, true) }
  if own && !nested { ctnCutOwn.set(ix, true) }
  for k in nodeChildren(ix) { ctnCutMark(k, own, nested) }
  0
}

function ctnCutWalk(ix: i32, name: string, d: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is FuncDecl {
    ctnCutMark(ix, false, true)
    return 0
  }
  if n is BinExpr && n.binOp == "=" && ctnIsRead(n.binLeft, name, d) {
    ctnCutMark(n.binRight, true, false)
  }
  for k in nodeChildren(ix) { ctnCutWalk(k, name, d) }
  0
}

// Whether `ix` is an element read of binding `d` named `name`.
function ctnElemRead(ix: i32, name: string, d: i32): boolean {
  const n = nodeAt(ix)
  n is Index && ctnIsRead(n.idxArr, name, d)
}

// `ix` with its parentheses removed, or -1 when `ix` is no arena node.
function ctnPeel(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = nodeAt(ix)
  if n is Paren { return ctnPeel(n.parInner) }
  ix
}

// Whether `ix` reads binding `d` named `name`; an unresolved read of the name counts.
function ctnIsRead(ix: i32, name: string, d: i32): boolean {
  const p = ctnPeel(ix)
  if p < 0 { return false }
  const n = nodeAt(p)
  if !(n is Ident) || n.identName != name { return false }
  const rd = identDeclOf(p)
  rd == d || rd < 0
}

function ctnWriteProp(prop: string): boolean {
  prop == "push" || prop == "unshift" || prop == "set" || prop == "add"
}

// The `get` bindings of container `d`, or null when a read of it is none of the forms
// `ctnWrUnreachedBy` names; memoised per arena length.
function ctnScan(d: i32, name: string, fx: i32): string[] | null {
  if (ctnScanAt.get(d) ?? -1) == P.nodes.length {
    return ctnScanGets.get(d) ?? null
  }
  let roots = ctnRootStmts
  if fx >= 0 {
    const fd = nodeAt(fx)
    if !(fd is FuncDecl) { return null }
    roots = [fd.fnBody]
  }
  const gets: string[] = []
  let res: string[] | null = gets
  if !ctnReadsKept(roots, name, d, gets) {
    res = null
  } else {
    for g in gets {
      if !ctnGetKept(roots, g) { res = null }
    }
  }
  ctnScanAt.set(d, P.nodes.length)
  ctnScanGets.set(d, res)
  res
}

// Whether every read of `d` under `roots` is a write into it, an element call, a `.get` bound by
// a `const` (its name pushed to `gets`), a length read, or an argument a top-level function only
// writes into. A `let`/`const` `d` may also be delivered into an annotated binding outside any
// generic, directly or through a function handing it back, since the delivery judges its writes.
function ctnReadsKept(
  roots: i32[],
  name: string,
  d: i32,
  gets: string[],
): boolean {
  let total = 0
  let kept = 0
  const delivers = nodeAt(d) is LetDecl
  const viaFns: i32[] = []
  const walked: i32[] = []
  const stack: i32[] = []
  const inGen: boolean[] = []
  for r in roots {
    stack.push(r)
    inGen.push(false)
  }
  while stack.length > 0 {
    const at = stack.pop() ?? -1
    let gen = inGen.pop() ?? true
    if at >= 0 && at < P.nodes.length {
      const n = nodeAt(at)
      if n is FuncDecl && n.fnTyParams.length > 0 { gen = true }
      if delivers && !gen && n is LetDecl && n.letType >= 0 {
        const li = ctnPeel(n.letInit)
        if li >= 0 && (ctnIsRead(li, name, d) || ctnElemRead(li, name, d)) {
          kept = kept + 1
        } else {
          const fx = ctnHandsBack(li, name, d)
          if fx >= 0 { viaFns.push(fx) }
        }
      }
      if n is Ident {
        if n.identName == name {
          const rd = identDeclOf(at)
          if rd == d || rd < 0 { total = total + 1 }
        }
      } else if n is Call {
        const fi = ctnPeel(n.callFn)
        if fi >= 0 && (ctnWriteRecv(fi, name, d) || ctnElemRead(fi, name, d)) {
          kept = kept + 1
        }
        let ai = 0
        while ai < n.callArgs.length {
          if ctnIsRead(n.callArgs[ai], name, d) && ctnArgWriteOnly(n, ai) {
            kept = kept + 1
          }
          ai = ai + 1
        }
      } else if n is Member {
        if (
          (n.memProp == "length" || n.memProp == "size")
          && ctnIsRead(n.memObj, name, d)
        ) {
          kept = kept + 1
        }
      } else if n is BinExpr {
        const li = ctnPeel(n.binLeft)
        if n.binOp == "=" && li >= 0 && ctnElemRead(li, name, d) {
          kept = kept + 1
        }
      } else if n is LetDecl {
        if n.letKw == "const" && ctnGetOf(ctnPeel(n.letInit), name, d) {
          kept = kept + 1
          gets.push(n.letName)
        }
      }
      if n is FuncDecl { walked.push(at) }
      for k in nodeChildren(at) {
        stack.push(k)
        inGen.push(gen)
      }
    }
  }
  const done: i32[] = []
  for fx in viaFns {
    const fd = nodeAt(fx)
    if fd is FuncDecl && !i32ListHas(done, fx) && i32ListHas(walked, fx) {
      done.push(fx)
      let calls = 0
      for g in viaFns {
        if g == fx { calls = calls + 1 }
      }
      if ctnNameReads(roots, fd.fnName, fx) == calls {
        const rv: i32[] = []
        collectRetValues(fd.fnBody, rv)
        kept = kept + rv.length
      }
    }
  }
  total == kept
}

// The top-level function with no type parameter and no un-annotated parameter that call `ix`
// names, when every value it hands back reads binding `d` named `name`; -1 otherwise.
function ctnHandsBack(ix: i32, name: string, d: i32): i32 {
  if ix < 0 { return -1 }
  const c = nodeAt(ix)
  if !(c is Call) { return -1 }
  const f = ctnPeel(c.callFn)
  const fname = identNameAt(f)
  if fname == "" { return -1 }
  const fx = fnDeclIx[fname] ?? -1
  if !wrFnClosed(fx) { return -1 }
  const fd = nodeAt(fx)
  if !(fd is FuncDecl) || fd.fnBody < 0 || fd.fnRet >= 0 { return -1 }
  const fdecl = identDeclOf(f)
  if fdecl != fx && fdecl >= 0 { return -1 }
  const rv: i32[] = []
  collectRetValues(fd.fnBody, rv)
  if rv.length == 0 { return -1 }
  for v in rv {
    if !ctnIsRead(v, name, d) { return -1 }
  }
  fx
}

// How many reads of the name `fname` under `roots` resolve to function `fx`, or to nothing.
function ctnNameReads(roots: i32[], fname: string, fx: i32): i32 {
  let total = 0
  const stack: i32[] = []
  for r in roots { stack.push(r) }
  while stack.length > 0 {
    const at = stack.pop() ?? -1
    if at >= 0 && at < P.nodes.length {
      const n = nodeAt(at)
      if n is Ident && n.identName == fname {
        const rd = identDeclOf(at)
        if rd == fx || rd < 0 { total = total + 1 }
      }
      for k in nodeChildren(at) { stack.push(k) }
    }
  }
  total
}

// Whether `ix` is a writing method of binding `d` named `name`, as a call's callee.
function ctnWriteRecv(ix: i32, name: string, d: i32): boolean {
  const n = nodeAt(ix)
  n is Member && ctnWriteProp(n.memProp) && ctnIsRead(n.memObj, name, d)
}

// Whether `ix` is a one-argument `.get` call on binding `d` named `name`; -1 is none.
function ctnGetOf(ix: i32, name: string, d: i32): boolean {
  if ix < 0 { return false }
  const n = nodeAt(ix)
  if !(n is Call) || n.callArgs.length != 1 { return false }
  const g = ctnPeel(n.callFn)
  if g < 0 { return false }
  const gn = nodeAt(g)
  gn is Member && gn.memProp == "get" && ctnIsRead(gn.memObj, name, d)
}

// Whether every read of the name `g` under `roots` calls it or compares it with `null`.
function ctnGetKept(roots: i32[], g: string): boolean {
  let total = 0
  let kept = 0
  const stack: i32[] = []
  for r in roots { stack.push(r) }
  while stack.length > 0 {
    const at = stack.pop() ?? -1
    if at >= 0 && at < P.nodes.length {
      const n = nodeAt(at)
      if n is Ident {
        if n.identName == g { total = total + 1 }
      } else if n is Call {
        const fi = ctnPeel(n.callFn)
        if fi >= 0 && identNameAt(fi) == g { kept = kept + 1 }
      } else if n is BinExpr {
        const l = ctnPeel(n.binLeft)
        const r = ctnPeel(n.binRight)
        if (n.binOp == "==" || n.binOp == "!=") && l >= 0 && r >= 0 {
          if identNameAt(l) == g && nodeAt(r) is NullLit { kept = kept + 1 }
          if identNameAt(r) == g && nodeAt(l) is NullLit { kept = kept + 1 }
        }
      }
      for k in nodeChildren(at) { stack.push(k) }
    }
  }
  total == kept
}

// Whether argument `ai` of call `n` goes to a top-level function whose parameter there is only
// written into.
function ctnArgWriteOnly(n: Call, ai: i32): boolean {
  if hasNamedArgs(n.callArgNames) { return false }
  let si = 0
  while si <= ai {
    if nodeAt(n.callArgs[si]) is Spread { return false }
    si = si + 1
  }
  const callee = ctnPeel(n.callFn)
  const cname = identNameAt(callee)
  if cname == "" { return false }
  const fdIx = fnDeclIx[cname] ?? -1
  if fdIx < 0 { return false }
  // A call the walk has not reached yet resolves to nothing, as an unresolved read counts.
  const cd = identDeclOf(callee)
  if cd != fdIx && cd >= 0 { return false }
  const fd = nodeAt(fdIx)
  if !(fd is FuncDecl) || ai >= fd.fnParams.length { return false }
  const pn = nodeAt(fd.fnParams[ai])
  if !(pn is Param) { return false }
  const noGets: string[] = []
  ctnReadsKept([fd.fnBody], pn.parName, fd.fnParams[ai], noGets)
    && noGets.length == 0
}

// Whether `dIx` is a form allowed as a parameter default. A default is substituted into each
// direct call site that omits the argument, so its expression resolves names at the
// declaration but evaluates in the caller's frame — v1 admits only a literal, a module
// `const` (marked so no caller-local can capture it), and `__callsite__`; anything else needs evaluating inside the callee, which is an ABI change.
export function paramDefaultIsLiteral(dIx: i32) {
  if dIx < 0 { return false }
  const d = nodeAt(dIx)
  match d {
    NumLit => {
      return true
    }
    StrLit => {
      return true
    }
    CharLit => {
      return true
    }
    BoolLit => {
      return true
    }
    NullLit => {
      return true
    }
    Unary => {
      // A SIGNED numeric literal (`-1`): the sign is a `Unary` over the literal,
      // and it is still name-free.
      if d.unOp == "-" || d.unOp == "+" {
        // Bound-tested: `unArg` is a node index, and an unbounded `P.nodes[…]` read on one is a
        // compiler trap rather than a diagnostic (D1440's shape).
        if d.unArg >= 0 && d.unArg < P.nodes.length {
          const inner = nodeAt(d.unArg)
          if inner is NumLit { return true }
        }
      }
    }
    Ident => {
      if declDepthOf(identConstDeclOf(dIx)) == 0 {
        markDefaultGlobalRef(dIx)
        return true
      }
    }
    // any other default needs evaluating inside the callee
    BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// The spelling root of the bound `annIx` names: an inline object literal directly, or one hop
// through a bound-alias name. -1 when the annotation is not a bound. One hop, not a chain — a
// bound alias's body is always a `{ … }` with a method member, so there is nothing for a
// second hop to reach; `type S2 = Showable` is not a bound alias (it parses as a union alias).
export function boundObjRootOf(annIx: i32) {
  if annIx < 0 { return -1 }
  const root = annTsOf(annIx)
  if root < 0 { return -1 }
  if tsKind[root] == TS_OBJ { return root }
  if tsKind[root] == TS_NAME {
    const hit = cBoundDecls[tsText[root]] ?? -1
    if hit >= 0 { return annTsOf(hit) }
  }
  -1
}

// The builtin type a catalog leaf spells, or -1 for any other name.
export function stdRecvLeafTy(sp: string): i32 {
  if sp == "u8" { return TY_U8 }
  if sp == "void" || sp == "v128" { return -1 }
  primTyOfName(sp)
}

// The offset value `memOffsetArgCheck` accepts at `argIx`, or -1. A sum adds exactly, with no
// i32 wrap, and must itself stay within `MEM_OFFSET_MAX`.
export function memOffsetCheckedValue(argIx: i32): i64 {
  const ox = parenPeelIx(argIx)
  if ox < 0 || ox >= P.nodes.length { return -1 }
  const e = nodeAt(ox)
  if e is NumLit { return memOffsetLexValue(e.numText) }
  if e is BinExpr { return memOffsetSumValue(e) }
  memOffsetNameValue(ox)
}

// The exact sum of a `+` of two accepted offsets, or -1 for another operator or a term that is
// not one.
function memOffsetSumValue(e: BinExpr): i64 {
  if e.binOp != "+" { return -1 }
  const l = memOffsetCheckedValue(e.binLeft)
  const r = memOffsetCheckedValue(e.binRight)
  if l < 0 || r < 0 || l + r > MEM_OFFSET_MAX { return -1 }
  l + r
}

// The value of the top-level integer `const` the name at `ix` denotes when no nearer binding
// shadows it; -1 for anything else, which is every node that is not such a name.
function memOffsetNameValue(ix: i32): i64 {
  const e = nodeAt(ix)
  if e is Ident {
    if identDepthOf(ix, e.identName) != 0 { return -1 }
    const init = moduleConstIntInit[e.identName] ?? -1
    if init >= 0 && init < P.nodes.length {
      const lit = nodeAt(init)
      if lit is NumLit { return memOffsetLexValue(lit.numText) }
    }
  }
  -1
}

// Set once a program names `v128` or calls a SIMD intrinsic, so `v128NestCheck` costs a program
// that never touches a vector nothing.
export let v128Seen = false
export function v128SeenSet(v: boolean) { v128Seen = v }

// Annotation atom count (#1055): how many top-level `|`-joined atoms the annotation node
// `ix`'s emit-time spelling has, banked by `canonEmitTypeNames`. -1 for a node that is not a
// `TypeRef` or that postdates the bank (an emitter-synthesized annotation); >= 1 otherwise.
export function annUnionAtomsOf(ix: i32) {
  if ix < 0 { return -1 }
  annUnionAtoms[ix] ?? -1
}

// D1045's nominal-escape rule (DECISIONS.md): the source name of a body-scoped nominal type
// reachable inside `tyIx`, or "". Descends `TyFunc` (unlike `tyHasRepHoleAt` above) because
// this asks whether a caller could write the type down, not what rep a slot needs. Demangled,
// since the name goes into a diagnostic a person reads.
export function localNomEscapeAt(tyIx: i32, depth: i32): string {
  if tyIx < 0 { return "" }
  if depth > 8 { return "" }
  const nwn = nomNameOfTy(tyIx)
  if nwn != "" {
    if nwBodyScopedNames.has(nwn) { return demangleName(nwn) }
  }
  const t = tyAt(tyIx)
  match t {
    TyArray => {
      return localNomEscapeAt(t.aElem, depth + 1)
    }
    TyNullable => {
      return localNomEscapeAt(t.nInner, depth + 1)
    }
    TyMap => {
      const k = localNomEscapeAt(t.mKey, depth + 1)
      if k != "" { return k }
      return localNomEscapeAt(t.mVal, depth + 1)
    }
    TyObj => {
      const ofts = t.objFieldTypes
      let i = 0
      while i < ofts.length {
        const f = localNomEscapeAt(ofts[i], depth + 1)
        if f != "" { return f }
        i = i + 1
      }
      return ""
    }
    TyUnion => {
      const ums = t.uMembers
      let u = 0
      while u < ums.length {
        const m = localNomEscapeAt(ums[u], depth + 1)
        if m != "" { return m }
        u = u + 1
      }
      return ""
    }
    TyFunc => {
      const ps = t.fnParamTypes
      let p = 0
      while p < ps.length {
        const a = localNomEscapeAt(ps[p], depth + 1)
        if a != "" { return a }
        p = p + 1
      }
      return localNomEscapeAt(t.fnRet, depth + 1)
    }
    // a leaf type names no nominal
    TyPrim | TyErr | TyVar | TyLit | TyNeg => {}
  }
  ""
}

// A value/struct union box (the emitter's union registry) or a nullable-numeric-literal-union base
// (`nulNumLitUnionBaseName`) — wider than "excludes a nullable niche and a literal union"
// alone suggests. Keep this and `isUNameAnnAB(s, ix) && !nodeTyIsLitUnionAlias(ix)` in sync; they are
// not interchangeable.
export function nodeTyIsUnionAlias(ix: i32) {
  const ty0 = nodeTyIxOf(ix)
  if ty0 < 0 { return false }
  // A one-member union wrapper is transparent here — a self-referential union with a `null`
  // arm interns one level deeper than the non-recursive spelling, so unwrap to ask the same question.
  let ty = ty0
  const tw = tyAt(ty0)
  if tw is TyUnion {
    if tw.uMembers.length == 1 { ty = tw.uMembers[0] }
  }
  const t = tyAt(ty)
  // A value/struct union box (inline or declared) — the emitter registers both in `unNames`
  // (its union registry). Excludes a nullable niche and a literal union (an interned atom, not a box).
  if isValueUnionBox(ty) { return true }
  // D1027 — a nullable over a union that already boxes is still that box: the niche exclusion
  // above is wrong once the inner is a value-union box, since the composition IS the union.
  if t is TyNullable {
    // Peels to a fixpoint: `Json | null` interns as nested `TyNullable`/one-member-`TyUnion`
    // wrappers, so one unwrap is not always enough to reach the underlying box.
    let nin = t.nInner
    let guard = 0
    while nin >= 0 && guard < 8 {
      const nw = tyAt(nin)
      if nw is TyNullable {
        nin = nw.nInner
      } else if nw is TyUnion {
        if nw.uMembers.length == 1 { nin = nw.uMembers[0] } else { guard = 8 }
      } else {
        guard = 8
      }
      guard = guard + 1
    }
    if nin >= 0 {
      if isValueUnionBox(nin) { return true }
    }
  }
  if t is TyNullable {
    const inner = t.nInner
    if inner >= 0 {
      const it = tyAt(inner)
      if it is TyPrim {
        const pn = it.primName
        if (
          pn == "i32"
          || pn == "f64"
          || pn == "i64"
          || pn == "f32"
          || pn == "v128"
        ) {
          return true
        }
      }
      if isValueUnionBox(inner) { return true }
    }
  }
  // A nullable numeric literal union (`1 | 2 | null`) is the box too — its rep is `<base scalar>
  // | null`, matched via `nulNumLitUnionBaseName` since inline/declared forms intern differently.
  nulNumLitUnionBaseName(ty) != ""
}

// Whether the bare name `nm` resolves as a type here, so the pattern stays a type pattern.
export function matchPatNamesType(nm: string) {
  if nm == "null" || nm == "Map" || nm == "Set" { return true }
  if primTyOfName(nm) >= 0 || tpEnvTyOfName(nm) >= 0 { return true }
  if cUserTypes.has(nm) || cBoundDecls.has(nm) { return true }
  gaIndexOf(nm) >= 0
}

export function declScanReset() {
  cBoundDecls = Map()
  letDeclFn = Map()
  fnDeclParent = Map()
  wrDstDecl = Map()
  ctnWrRecv = Map()
  ctnRootStmts = []
  ctnScanAt = Map()
  ctnScanGets = Map()
  ctnParamAt = Map()
  ctnParamArgs = Map()
  moduleConstIntInit = Map()
  annUnionAtoms = Map()
  nwBodyScopedNames = Map()
  v128Seen = false
}
