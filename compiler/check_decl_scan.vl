  nomNameOfTy,
  tyAt,
} from "./check_types"
import { keyHasPrefix, parenPeelIx, placeKeyOf } from "./check_places"
import { demangleName } from "./check_suggest"
import {
  ATOMIC_SIG_CMPXCHG,
  ATOMIC_SIG_FENCE,
  ATOMIC_SIG_LOAD,
  ATOMIC_SIG_NOTIFY,
  ATOMIC_SIG_RMW,
  ATOMIC_SIG_STORE,
  ATOMIC_SIG_WAIT,
  MEM_OFFSET_MAX,
  SIMD_SIG_F_V,
  SIMD_SIG_I_V,
  SIMD_SIG_LANE_F,
  SIMD_SIG_LANE_I,
  SIMD_SIG_LANE_L,
  SIMD_SIG_LOAD,
  SIMD_SIG_L_V,
  SIMD_SIG_REPL_F,
  SIMD_SIG_REPL_I,
  SIMD_SIG_REPL_L,
  SIMD_SIG_SHUF16,
  SIMD_SIG_SHUF4,
  SIMD_SIG_STORE,
  SIMD_SIG_VI_V,
  SIMD_SIG_VVV_V,
  SIMD_SIG_VV_V,
  SIMD_SIG_V_I,
  SIMD_SIG_V_V,
