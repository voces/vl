// Declaration scans run before the body walk: bound declarations, the function a binding or
// write belongs to, module integer constants, union atoms of annotations, nominal names
// scoped to a body, and the SIMD, atomic and saturating intrinsics' types.
// Emptied by `declScanReset`. Does not import the checker.
import { cexPastF64, cexRootShape, lbiNameKey } from "./check_num_lits"
import {
  declDepthOf,
  declareAmbient,
  identConstDeclOf,
  identDepthOf,
} from "./check_scopes"
import { cexOk } from "./const_exact"
import { crAskUsePath } from "./check_call_retire"
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  ImportDecl,
  Index,
  IsExpr,
  LetDecl,
  LoopVar,
  MatchExpr,
  Member,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  Program,
  RetStmt,
  Spread,
  StrLit,
  TS_ARR,
  TS_ISECT,
  TS_MAP,
  TS_NAME,
  TS_OBJ,
  TS_UNION,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  annTsOf,
  declHasExportKw,
  hasNamedArgs,
  markDefaultGlobalRef,
  nodeAt,
  nodeChildren,
  nodeToks,
  tsKidCount,
  tsKidStart,
  tsKids,
  tsKind,
  tsText,
} from "./ast"
import { nodeStartTok } from "./fmt_util"
import { identDeclOf } from "./symbols"
import { symOccTok, symOccTy } from "./check_state"
import {
  T,
  TY_BOOL,
  TY_ERR,
  TY_F32,
  TY_F64,
  TY_I32,
  TY_I64,
  TY_NULL,
  TY_STR,
  TY_U8,
