import { cpCount, pushCps } from "./strutil"

// Pure formatting helpers: they reference no `format.vl` module state — only the
// parser arena (`P`) and AST node variants, each other, and one deterministic memo
// (`indentCache`) — so they live in a leaf module that `format.vl` imports back.

import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  ImportDecl,
  Index,
  IsExpr,
  LetDecl,
  MatchExpr,
  Member,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  Program,
  RetStmt,
  StrLit,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
} from "./ast"

// Two-space indent strings, memoized per depth. `emitLine` asks for one per emitted
// line, and rebuilding with `s = s + "  "` allocates O(depth) intermediate strings —
// each an `array.new` plus `array.copy` under wasmtime. Depth `n` always maps to `2n`
// spaces, so persisting the cache across formats is invisible.
const indentCache: string[] = []
export function indentStr(n: i32) {
  if n <= 0 { return "" }
  while indentCache.length <= n {
    if indentCache.length == 0 {
      indentCache.push("")
    } else {
      indentCache.push(indentCache[indentCache.length - 1] + "  ")
    }
  }
  indentCache[n]
}

// The start char offset (`pos`) of arena node `ix`; -1 only for an out-of-range or
// synthesized node. It narrows per variant because VL has no cross-variant field read,
// and the chain is exhaustive over `Node` with an annotated return, so a new AST
// variant is a checker error here rather than a silent -1 the formatter slices on.
export function nodePos(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = P.nodes[ix]
  if n is NumLit { n.pos }
  else if n is StrLit { n.pos }
  else if n is CharLit { n.pos }
  else if n is BoolLit { n.pos }
  else if n is NullLit { n.pos }
  else if n is Ident { n.pos }
  else if n is Unary { n.pos }
  else if n is BinExpr { n.pos }
  else if n is Call { n.pos }
  else if n is Member { n.pos }
  else if n is OptMember { n.pos }
  else if n is Paren { n.pos }
  else if n is ErrExpr { n.pos }
  else if n is LetDecl { n.pos }
  else if n is Param { n.pos }
  else if n is TypeRef { n.pos }
  else if n is FuncDecl { n.pos }
  else if n is IfStmt { n.pos }
  else if n is MatchExpr { n.pos }
  else if n is WhileStmt { n.pos }
  else if n is BreakStmt { n.pos }
  else if n is ContinueStmt { n.pos }
  else if n is RetStmt { n.pos }
  else if n is Block { n.pos }
  else if n is Program { n.pos }
  else if n is FieldDef { n.pos }
  else if n is TypeDecl { n.pos }
  else if n is FieldInit { n.pos }
  else if n is ObjLit { n.pos }
  else if n is ArrayLit { n.pos }
  else if n is Index { n.pos }
  else if n is UnionDecl { n.pos }
  else if n is IsExpr { n.pos }
  else if n is AsExpr { n.pos }
  else if n is ForRange { n.pos }
  else if n is ForIn { n.pos }
  else if n is ImportDecl { n.pos }
}

export function isWs(c: i32) { c == ' ' || c == '\t' || c == '\n' || c == '\r' }

// Trim leading + trailing ASCII whitespace.
export function trimWs(s: string) {
  let a = 0
  let b = s.length
  while a < b && isWs(s[a]) { a = a + 1 }
  while b > a && isWs(s[b - 1]) { b = b - 1 }
  // Nothing to trim: hand back `s` itself (strings are immutable values, so
  // this is indistinguishable from a full-range slice — minus the allocation).
  if a == 0 && b == s.length { return s }
  const r = s.slice(a, b)
  r
}

// Trim only leading whitespace.
export function trimWsStart(s: string) {
  let a = 0
  while a < s.length && isWs(s[a]) { a = a + 1 }
  if a == 0 { return s }
  const r = s.slice(a, s.length)
  r
}

// Strip trailing spaces/tabs/CR (not newlines).
export function rstrip(s: string) {
  let b = s.length
  let going = b > 0
  while going {
    const c = s[b - 1]
    if c == ' ' || c == '\t' || c == '\r' {
      b = b - 1
      going = b > 0
    } else {
      going = false
    }
  }
  // The common already-clean line: no trailing whitespace, no fresh slice.
  if b == s.length { return s }
  const r = s.slice(0, b)
  r
}

// Collapse every run of ASCII whitespace to a single space and trim — the type-slice
// normalization the host spells as a regex. It collects code points into a buffer and
// materializes once; a per-char `out = out + c` accumulator is O(n²) allocation under
// the non-freeing GC, the cost class `joinLinesRange` explains.
export function collapseWs(s: string) {
  const out: i32[] = []
  let inWs = false
  // `for c in s` yields code points, and the buffer is a code-point buffer
  // (`fromCodePoints` below); indexing `s[i]` would push bytes into it instead.
  for c in s {
    if isWs(c) {
      inWs = true
    } else {
      if inWs && out.length > 0 { out.push(' ') }
      inWs = false
      out.push(c)
    }
  }
  fromCodePoints(out)
}

// Whether `s` contains a newline.
export function hasNewline(s: string) {
  let i = 0
  while i < s.length {
    if s[i] == '\n' { return true }
    i = i + 1
  }
  false
}

// Split `s` on '\n' into a list of lines.
export function splitLines(s: string) {
  const parts: string[] = []
  let start = 0
  let i = 0
  while i < s.length {
    if s[i] == '\n' {
      parts.push(s.slice(start, i))
      start = i + 1
    }
    i = i + 1
  }
  parts.push(s.slice(start, s.length))
  parts
}

export function spaces(n: i32) {
  if n <= 0 { return "" }
  // One allocation, not the O(n²)-copy `s = s + " "` accumulator.
  const buf = __array_new__(n, ' ')
  fromCodePoints(buf)
}

// Concatenate `parts[lo..hi)` with a `\n` between adjacent pairs by sizing one
// code-point buffer and materializing it once — O(n) allocation and copying. A running
// `s = s + parts[i]` accumulator is O(n²) and exhausts the non-freeing heap on a large
// file; even a divide-and-conquer concat leaves O(n log n) `array.new`/`array.copy`.
export function joinLinesRange(parts: string[], lo: i32, hi: i32) {
  if hi - lo <= 0 { return "" }
  if hi - lo == 1 { return parts[lo] }
  // A growing code-point buffer, not an exact-fit `__array_new__`: a byte pre-size and
  // code-point elements disagree on non-ASCII input; `.push`'s 2x growth bounds copying.
  const buf: i32[] = []
  let i = lo
  while i < hi {
    if i > lo { buf.push('\n') }
    pushCps(buf, parts[i])
    i = i + 1
  }
  fromCodePoints(buf)
}

export function joinLines(parts: string[]) {
  joinLinesRange(parts, 0, parts.length)
}

export function isBlankLine(line: string) {
  let i = 0
  while i < line.length {
    if line[i] != ' ' && line[i] != '\t' { return false }
    i = i + 1
  }
  true
}

// First non-space char starts a `//` — the line is a comment of its own, not a
// trailing comment, and so breaks an alignment block.
export function isOwnLineComment(line: string) {
  let i = 0
  while i < line.length && (line[i] == ' ' || line[i] == '\t') { i = i + 1 }
  i + 1 < line.length && line[i] == '/' && line[i + 1] == '/'
}

// First non-space char is `}` — a closing-brace line. It carries its own
// trailing-comment spacing and must not join a trailing-comment alignment run, else a
// short `}` line gets its comment dragged out to the column of the wide siblings.
export function isCloseBraceLine(line: string) {
  let i = 0
  while i < line.length && (line[i] == ' ' || line[i] == '\t') { i = i + 1 }
  i < line.length && line[i] == '}'
}

// The char offset where a line's trailing comment begins, or -1 if it has none. A `//`
// inside a string or char literal does not count, and neither does an own-line comment.
export function trailingCommentAt(line: string) {
  if isOwnLineComment(line) { return -1 }
  let i = 0
  let inStr = 0 // 0 = code, 1 = inside "…", 2 = inside '…'
  while i < line.length {
    const c = line[i]
    if inStr == 0 {
      if c == '"' {
        inStr = 1
        i = i + 1
      } else if c == '\'' {
        inStr = 2
        i = i + 1
      } else if c == '/' && i + 1 < line.length && line[i + 1] == '/' {
        return i
      } else {
        i = i + 1
      }
    } else if c == '\\' {
      i = i + 2 // skip an escaped char inside the literal
    } else {
      if inStr == 1 && c == '"' { inStr = 0 }
      if inStr == 2 && c == '\'' { inStr = 0 }
      i = i + 1
    }
  }
  -1
}

// ── the formatter's width unit ───────────────────────────────────────────────
// The display width of `s` in columns — the only unit compared against `fmtWidth`.
// Not `s.length`, a byte count and so an offset for `slice`: read as a width it wraps
// any line with a non-ASCII character far too early (`str-byte-semantics.md` §R1/§Width).
export function dispWidth(s: string) { cpCount(s) }

// The code width of a line up to offset `c`, with trailing spaces and tabs removed.
// A byte offset — what `line.slice(0, …)` consumes. For the column the same code ends
// at, see `codeColumnBefore`; a caller that both slices and aligns needs both.
export function codeWidthBefore(line: string, c: i32) {
  let w = c
  while w > 0 && (line[w - 1] == ' ' || line[w - 1] == '\t') { w = w - 1 }
  w
}

// The column a line's code ends at, before its trailing comment at byte offset `c` —
// the width twin of `codeWidthBefore`, and the one compared against `fmtWidth` and used
// as the alignment target. Measuring it in bytes pushes a trailing comment one column
// right per non-ASCII byte on the line, dragging the whole run's column with it.
export function codeColumnBefore(line: string, c: i32) {
  dispWidth(line.slice(0, codeWidthBefore(line, c)))
}

// The count of leading spaces on a line (its indentation depth in columns). Offset and
// column coincide here and always will: the counted bytes are literal `' '`, so the byte
// count is the code-point count and no `dispWidth` conversion is possible or needed.
export function leadingSpaces(line: string) {
  let i = 0
  while i < line.length && line[i] == ' ' { i = i + 1 }
  i
}

// Strip all trailing ASCII whitespace (spaces, tabs, CR, and newlines).
export function rstripWsAll(s: string) {
  let b = s.length
  while b > 0 && isWs(s[b - 1]) { b = b - 1 }
  const r = s.slice(0, b)
  r
}

// Strip a single trailing newline.
export function rstripNl(s: string) {
  if s.length > 0 && s[s.length - 1] == '\n' { return s.slice(0, s.length - 1) }
  s
}

// Final normalization: strip per-line trailing whitespace, collapse 2+ blank
// lines to one, strip leading blank lines, ensure a single trailing newline.
export function normalizeProgram(text: string) {
  const lines = splitLines(text)
  // Collect the kept lines and join once — a running `out = out + line` accumulator
  // here is O(n²) and exhausts the non-freeing heap on a large file.
  const out: string[] = []
  let blanks = 0
  let started = false
  let i = 0
  while i < lines.length {
    const line = rstrip(lines[i])
    if line.length == 0 {
      blanks = blanks + 1
    } else {
      if started && blanks > 0 { out.push("") }
      out.push(line)
      started = true
      blanks = 0
    }
    i = i + 1
  }
  if out.length == 0 { return "" }
  joinLines(out) + "\n"
}

// A real braced block: a `Block` node with a source span (`pos >= 0`). A
// synthesized one-statement wrapper (bare-else/bare-fn-body sugar) has `pos < 0`.
export function isBracedBlock(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = P.nodes[ix]
  if n is Block { return n.pos >= 0 }
  false
}

// Any `Block` node — braced or synthesized. The formatter renders both braced,
// so a branch check only needs the node kind, not the source span.
export function isBlockNode(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = P.nodes[ix]
  if n is Block { return true }
  false
}

// Index of the token whose `start` is exactly `pos`, or -1. Tokens are in source order
// with distinct ascending `start`, so this binary-searches; a linear scan is O(tokens)
// per call and runs per declaration and field, which is O(n²) on a large file.
export function tokIndexAt(pos: i32) {
  let lo = 0
  let hi = P.toks.length - 1
  while lo <= hi {
    const mid = lo + (hi - lo) / 2
    const s = P.toks[mid].start
    if s == pos { return mid }
    if s < pos { lo = mid + 1 } else { hi = mid - 1 }
  }
  -1
}

// `export`-modifier recovery: the parser drops `export`, so look at the token
// immediately before the declaration's start token for an `EXPORT` keyword.
export function exportPrefix(ix: i32) {
  const p = nodePos(ix)
  if p < 0 { return "" }
  const i = tokIndexAt(p)
  if i > 0 && P.toks[i - 1].kind == "EXPORT" { return "export " }
  ""
}

// Whether the `else` chain of `node` is itself an `if` (an `else if` chain).
export function elseIsIf(elseIx: i32) {
  if elseIx < 0 || elseIx >= P.nodes.length { return false }
  const n = P.nodes[elseIx]
  if n is IfStmt { return true }
  false
}

// A leaf statement holds no nested statement list (so it can collapse to a line).
export function isLeafStmt(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = P.nodes[ix]
  if n is WhileStmt { return false }
  if n is ForRange { return false }
  if n is ForIn { return false }
  if n is IfStmt { return false }
  if n is Block { return false }
  if n is FuncDecl { return false }
  true
}

// Binary operator precedence (mirrors the parser / host precedence table).
export function binPrecOf(op: string) {
  if op == "||" { return 4 }
  if op == "&&" { return 6 }
  if op == "|" { return 7 }
  if op == "^" { return 8 }
  if op == "&" { return 9 }
  if op == "==" { return 10 }
  if op == "!=" { return 10 }
  if op == "<" { return 12 }
  if op == "<=" { return 12 }
  if op == ">" { return 12 }
  if op == ">=" { return 12 }
  if op == "<<" { return 13 }
  if op == ">>" { return 13 }
  if op == ">>>" { return 13 }
  if op == "+" { return 14 }
  if op == "-" { return 14 }
  if op == "*" { return 16 }
  if op == "/" { return 16 }
  if op == "%" { return 16 }
  0
}

// Parenthesize a chain operand when its own operator binds looser than the chain.
export function parenForChain(ix: i32, rendered: string, parentPrec: i32) {
  const n = P.nodes[ix]
  if n is BinExpr {
    const looser = n.binOp != "=" && binPrecOf(n.binOp) < parentPrec
    if looser { return "(" + rendered + ")" }
  }
  rendered
}

// ── conditional heads (`if` / `else if` / `while`) ───────────────────────────
// A condition that would overflow wraps in parentheses, one operand per line, so the
// `)` row separates it from the body. fmt adds those parens, so on a re-format the
// condition is a `Paren` node: peel one layer before re-wrapping, or output drifts.
export function unwrapOuterParen(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return ix }
  const n = P.nodes[ix]
  if n is Paren { return n.parInner }
  ix
}

// The callee text, paren-wrapped if it is a composite (non-postfix) expression.
export function calleePrimary(ix: i32, rendered: string) {
  const n = P.nodes[ix]
  let composite = false
  if n is BinExpr { composite = true }
  else if n is Unary { composite = true }
  else if n is IsExpr { composite = true }
  else if n is IfStmt { composite = true }
  if composite { return "(" + rendered + ")" }
  rendered
}

// Whether a synthesized one-statement branch holds a simple expression.
export function branchIsSimple(blockIx: i32) {
  const n = P.nodes[blockIx]
  if n is Block {
    const st = n.blkStmts
    if st.length != 1 { return false }
    const s = P.nodes[st[0]]
    if s is Block { return false }
    if s is IfStmt { return false }
    if s is WhileStmt { return false }
    if s is ForRange { return false }
    if s is ForIn { return false }
    return true
  }
  false
}
