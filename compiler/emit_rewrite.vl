// `emit_rewrite.vl` — the emitter's PRE-EMIT AST REWRITES: in-place arena
// mutations that run before collection/lowering — self-method / operator /
// index-trap dispatch rewriting (`dispatchRewrite`), captured-mutation boxing
// (`captureBoxRewrite`), and the synthesized return/param annotations
// (`synthRetAnnots`/`synthParamAnnots`) that pin checker-inferred types onto
// declarations for the later phases. Consults the classifiers
// (`emit_classify.vl`); writes no bytes. Carved out of `wasmEmit.vl`
// (review N18).

import {
  arrElemNameRaw,
  nameIsArray,
  nameIsSpaceFree,
  splitUnionAtoms,
} from "./tyname"
import {
  inferRetNameByNode,
  inferRetRowByNode,
  inferRetRungIsLitUnionElemList,
  inferRetRungIsMapElemList,
  inferRetRungIsNestedElemUnionList,
  inferRetRungIsNestedLeafList,
  inferRetRungIsNullable,
  inferRetRungIsParenUnionElemList,
  inferRetTyIxByNode,
  isValueUnionName,
  litUnionAliasNameOfTy,
  mkArrayTy,
  nameIsLitUnionArmValueUnion,
  nameIsLitUnionType,
  nodeTyIsLitUnionAlias,
  nodeTyIsNullable,
  nodeTyIsUnion,
  nodeTyIxOf,
  nodeTyName,
  numLitUnionAliasName,
  numLitUnionBaseName,
  opIdxFnAtNode,
  recordNodeTyFrom,
  tyIsLitUnion,
  tyToEmitName,
} from "./typecheck"
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  Call,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  Index,
  IsExpr,
  LetDecl,
  Member,
  NumLit,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  RetStmt,
  StrLit,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  fillArgDefaults,
  hasNamedArgs,
  mkArrayLit,
  mkCall,
  mkIdent,
  mkIndex,
  mkMember,
  mkNum,
  orderArgsByParamNames,
  paramDefaultOf,
  ufcsAliasOf,
} from "./ast"
import {
  annArrowAt,
  capHas,
  drwDispatchOp,
  nameIsF32Array,
  nameIsF64Array,
  nameIsI64Array,
  nameIsMapMemberUnion,
  nameIsStructWithLitUnionField,
  nameIsStructWithMapField,
  nameIsStructWithUnionField,
  nodeIsTypeDecl,
  nullablePartOf,
} from "./emit_base"
import { fnIndexOfInScopeChain } from "./emit_collect"
import { fnStmts, fnValUsed, startStmts, unNames } from "./emit_state"
import {
  drwFieldClosure,
  exprIsClosure,
  fnIndexOf,
  isUName,
  nameIsWholeSpanShape,
  resolveShapeToNominal,
  sFieldIndex,
  structIndexOfExpr,
  synthTypeRefTy,
} from "./emit_classify"

// ── self-method / operator / index-trap dispatch REWRITE (B13 + B14) ─────────
// The HOST resolves these in its type-aware parser; the native parser is
// type-free, so the emitter rewrites the arena BEFORE monomorphization:
//   o.f(args)  → f(o, args)         a free `self`-function, receiver a struct
//                                   that lacks a field `f` (UFCS)
//   a op b     → op(a, b)           a free `self`-function named for the
//                                   operator, struct left operand
//   a op b     → (a."op")(b)        the left operand carries an operator
//                                   closure FIELD ("*", "/", …)
//   o[k]       → (o."[]")(k)        a "[]" trap field (native arrays/maps/
//                                   strings never classify as structs, so they
//                                   keep their fast paths)
//   o[k] = v   → (o."[]=")(k, v)    a "[]=" trap field on the assignment form
// The walk is POST-ORDER (children first, parents store the returned — possibly
// new — child index back into their i32 child fields), so a chained `a[1][2]`
// rewrites its inner trap before the outer looks at its receiver. The rewritten
// forms ride the EXISTING lowerings: plain calls monomorphize per receiver
// shape; field-closure calls use the member-call machinery. Usage-gated: a
// program with none of these shapes rewrites nothing (byte-identical bytes).

// The `fnStmts` index of a free `self`-function `name` of `argc` total params
// (first param NAMED `self`), or -1 — the host's UFCS reachability rule, so a
// non-`self` function is NOT a method (objects/self-method-pollution.vl).
function drwSelfFnOf(name: string, argc: i32) {
  const fe = fnIndexOf(name)
  if fe < 0 { return -1 }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    const ps = fn.fnParams
    if ps.length != argc { return -1 }
    if ps.length > 0 {
      const p0 = P.nodes[ps[0]]
      if p0 is Param {
        if p0.parName == "self" { return fe }
      }
    }
  }
  -1
}

// Normalize a DIRECT call to its callee's FULL arity, appending the
// declaration's DEFAULT expressions for the trailing arguments the call omitted.
//
// This is the whole emit-side of parameter defaults. It runs before
// monomorphization and before signature collection, so mono, `collectCloSigs`
// and the emitter's per-parameter argument coercion all see an ordinary
// full-arity call and need to know nothing about defaults. That is also what
// keeps the feature clear of the `$fnsig` value-call ABI: the callee's declared
// signature never changes, no call site is reclassified, and no new signature
// key is minted — `fnSigKeyOf` reads the DECLARATION's parameter list, which
// this does not touch.
//
// The callee is resolved with `fnIndexOfInScopeChain` — the SAME classifier
// `emitCall` uses to choose the direct/captured path over `call_ref`, so a call
// is normalized here exactly when it will be emitted as a direct call. A call
// through a function VALUE resolves no function and keeps its full arity, which
// leaves an under-supplied value call as the arity error the checker reported.
function drwFillDefaults(ix: i32, ctx: i32) {
  const n = P.nodes[ix]
  if n is Call {
    const cf = P.nodes[n.callFn]
    if cf is Ident {
      const fe = fnIndexOfInScopeChain(cf.identName, ctx)
      if fe < 0 { return 0 }
      const fn = P.nodes[fnStmts[fe]]
      if fn is FuncDecl {
        const ps = fn.fnParams
        const args = n.callArgs
        if hasNamedArgs(n.callArgNames) {
          // A NAMED call may skip a MIDDLE parameter (`f(1, c: 3)`), so the
          // gap is found by binding names to slots rather than by counting.
          // Binding it here — and dropping the name list once the arguments are
          // in parameter order — is the only way the gap survives to emit: the
          // emitter's own reorder (`orderedDirectArgs`) has no way to fill one.
          const pNames: string[] = []
          let pn = 0
          while pn < ps.length {
            const pnode = P.nodes[ps[pn]]
            if pnode is Param { pNames.push(pnode.parName) }
            pn = pn + 1
          }
          if pNames.length != ps.length { return 0 }
          const ordered = orderArgsByParamNames(pNames, args, n.callArgNames)
          if ordered.length != ps.length { return 0 }
          let gap = false
          let gi = 0
          while gi < ordered.length {
            if ordered[gi] < 0 { gap = true }
            gi = gi + 1
          }
          // No gap: leave the call exactly as it was, so every named call that
          // works today keeps taking the emitter's own reorder path.
          if !gap { return 0 }
          if fillArgDefaults(ordered, ps) >= 0 { return 0 }
          const noNames: string[] = []
          n.callArgs = ordered
          n.callArgNames = noNames
          return 0
        }
        if args.length >= ps.length { return 0 }
        let i = args.length
        while i < ps.length {
          const d = paramDefaultOf(ps[i])
          if d < 0 { return 0 }
          args.push(d)
          i = i + 1
        }
      }
    }
  }
  0
}

// Post-order rewrite of the tree at `ix` (inside function `ctx`, -1 = top
// level). Returns the node index to use in `ix`'s place (usually `ix` itself).
function drwWalk(ix: i32, ctx: i32) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Call {
    const args = n.callArgs
    let i = 0
    while i < args.length {
      args[i] = drwWalk(args[i], ctx)
      i = i + 1
    }
    const callee = P.nodes[n.callFn]
    if callee is Member {
      callee.memObj = drwWalk(callee.memObj, ctx)
      // UFCS (host parser.ts case 2): `o.f(args)` where `f` is a free function
      // whose FIRST parameter is named `self` (arity matching) lowers to the
      // direct call `f(o, args)`. The receiver TYPE does not gate it — string,
      // i32, and value-union receivers dispatch identically to struct ones.
      // The Call node mutates in place: the receiver shifts in as argument 0,
      // the callee becomes a bare Ident, and any named args slide right of the
      // unnamed receiver ("" rides slot 0).
      //
      // The module merge mangles a free `self`-function (`shout` → `shout$m1`)
      // but leaves the call's property plain so field precedence still resolves
      // from the receiver shape; `ufcsAliasOf` maps the plain property to the
      // mangled function, and the rebuilt direct-call Ident carries that name so
      // every downstream pass (string detection, print routing, coercion) sees a
      // normal named call. Identity single-file.
      const uName = ufcsAliasOf(callee.memProp)
      // Precedence, mirroring the host:
      //   • a REAL struct field of that name wins (a value access, not a call);
      //   • a callable FIELD (closure-valued, kind 14) wins as a `call_ref`
      //     member-call (`exprIsClosure`), so it is NOT UFCS-rewritten.
      // A non-struct receiver has no fields, so neither precedence case can
      // apply — the rewrite fires once a matching `self`-function exists.
      const si = structIndexOfExpr(callee.memObj, ctx)
      let ufcs = false
      if si >= 0 {
        if sFieldIndex(si, callee.memProp) < 0 {
          if drwSelfFnOf(uName, args.length + 1) >= 0 { ufcs = true }
        }
      }
      if si < 0 {
        if !exprIsClosure(n.callFn, ctx) {
          if drwSelfFnOf(uName, args.length + 1) >= 0 { ufcs = true }
        }
      }
      if ufcs {
        const recvIx = callee.memObj
        args.push(-1)
        let j = args.length - 1
        while j > 0 {
          args[j] = args[j - 1]
          j = j - 1
        }
        args[0] = recvIx
        // Named-arg parity: the injected receiver is an UNNAMED slot-0
        // positional. Only when the call already carries names does the name
        // list need a leading "" (an all-positional call keeps its empty
        // list, so `hasNamedArgs` stays false downstream).
        if hasNamedArgs(n.callArgNames) {
          const nm = n.callArgNames
          nm.push("")
          let k = nm.length - 1
          while k > 0 {
            nm[k] = nm[k - 1]
            k = k - 1
          }
          nm[0] = ""
        }
        n.callFn = mkIdent(uName, -1)
      }
      drwFillDefaults(ix, ctx)
      return ix
    }
    n.callFn = drwWalk(n.callFn, ctx)
    drwFillDefaults(ix, ctx)
    return ix
  }
  if n is Block {
    const bs = n.blkStmts
    let i2 = 0
    while i2 < bs.length {
      bs[i2] = drwWalk(bs[i2], ctx)
      i2 = i2 + 1
    }
    return ix
  }
  if n is LetDecl {
    n.letInit = drwWalk(n.letInit, ctx)
    return ix
  }
  if n is IfStmt {
    n.ifCond = drwWalk(n.ifCond, ctx)
    n.ifThen = drwWalk(n.ifThen, ctx)
    n.ifElse = drwWalk(n.ifElse, ctx)
    return ix
  }
  if n is WhileStmt {
    n.whileCond = drwWalk(n.whileCond, ctx)
    n.whileBody = drwWalk(n.whileBody, ctx)
    return ix
  }
  if n is ForRange {
    n.frFrom = drwWalk(n.frFrom, ctx)
    n.frTo = drwWalk(n.frTo, ctx)
    n.frStep = drwWalk(n.frStep, ctx)
    n.frBody = drwWalk(n.frBody, ctx)
    return ix
  }
  if n is ForIn {
    n.fiIter = drwWalk(n.fiIter, ctx)
    n.fiBody = drwWalk(n.fiBody, ctx)
    return ix
  }
  if n is RetStmt {
    n.retArg = drwWalk(n.retArg, ctx)
    return ix
  }
  if n is BinExpr {
    // The index WRITE-TRAP form `o[k] = v` — handled BEFORE the general child
    // walk so the assignment-target Index is not first rewritten into a READ
    // trap (host: the assignment parser recovers the object + key).
    if n.binOp == "=" {
      const tgt = P.nodes[n.binLeft]
      if tgt is Index {
        tgt.idxArr = drwWalk(tgt.idxArr, ctx)
        tgt.idxIndex = drwWalk(tgt.idxIndex, ctx)
        n.binRight = drwWalk(n.binRight, ctx)
        // A free `"[]="` OPERATOR function (B14) — the checker resolved it by the
        // receiver's TYPE and banked it on THIS assignment node, so the rewrite
        // never re-derives the choice (and cannot disagree with what was typed).
        const wOp = opIdxFnAtNode(ix)
        if wOp != "" {
          const woargs: i32[] = []
          woargs.push(tgt.idxArr)
          woargs.push(tgt.idxIndex)
          woargs.push(n.binRight)
          return mkCall(mkIdent(wOp, -1), woargs, -1)
        }
        const wsi = structIndexOfExpr(tgt.idxArr, ctx)
        if drwFieldClosure(wsi, "[]=") {
          const wargs: i32[] = []
          wargs.push(tgt.idxIndex)
          wargs.push(n.binRight)
          return mkCall(mkMember(tgt.idxArr, "[]=", -1), wargs, -1)
        }
        return ix
      }
    }
    n.binLeft = drwWalk(n.binLeft, ctx)
    n.binRight = drwWalk(n.binRight, ctx)
    if drwDispatchOp(n.binOp) {
      const osi = structIndexOfExpr(n.binLeft, ctx)
      if osi >= 0 {
        // A free `self`-function named for the operator wins (host parser
        // order); else an operator closure FIELD dispatches member-call style.
        if drwSelfFnOf(n.binOp, 2) >= 0 {
          const oargs: i32[] = []
          oargs.push(n.binLeft)
          oargs.push(n.binRight)
          return mkCall(mkIdent(n.binOp, -1), oargs, -1)
        }
        if drwFieldClosure(osi, n.binOp) {
          const fargs: i32[] = []
          fargs.push(n.binRight)
          return mkCall(mkMember(n.binLeft, n.binOp, -1), fargs, -1)
        }
      }
    }
    return ix
  }
  if n is Unary {
    n.unArg = drwWalk(n.unArg, ctx)
    return ix
  }
  if n is Paren {
    n.parInner = drwWalk(n.parInner, ctx)
    return ix
  }
  if n is Member {
    n.memObj = drwWalk(n.memObj, ctx)
    return ix
  }
  if n is OptMember {
    n.omObj = drwWalk(n.omObj, ctx)
    return ix
  }
  if n is Index {
    n.idxArr = drwWalk(n.idxArr, ctx)
    n.idxIndex = drwWalk(n.idxIndex, ctx)
    // A free `"[]"` OPERATOR function (B14): a DIRECT call, resolved by the
    // checker from the receiver's type and banked on this node. Ahead of the
    // closure-field trap below, mirroring the `a op b` arm's order.
    const rOp = opIdxFnAtNode(ix)
    if rOp != "" {
      const roargs: i32[] = []
      roargs.push(n.idxArr)
      roargs.push(n.idxIndex)
      return mkCall(mkIdent(rOp, -1), roargs, -1)
    }
    // The index READ trap: a struct receiver carrying a "[]" closure field.
    const tsi = structIndexOfExpr(n.idxArr, ctx)
    if drwFieldClosure(tsi, "[]") {
      const targs: i32[] = []
      targs.push(n.idxIndex)
      return mkCall(mkMember(n.idxArr, "[]", -1), targs, -1)
    }
    return ix
  }
  if n is IsExpr {
    n.isObj = drwWalk(n.isObj, ctx)
    return ix
  }
  if n is AsExpr {
    n.asObj = drwWalk(n.asObj, ctx)
    return ix
  }
  if n is ArrayLit {
    const es = n.arrElems
    let i3 = 0
    while i3 < es.length {
      es[i3] = drwWalk(es[i3], ctx)
      i3 = i3 + 1
    }
    return ix
  }
  if n is ObjLit {
    const fs = n.objFields
    let i4 = 0
    while i4 < fs.length {
      const f = P.nodes[fs[i4]]
      if f is FieldInit { f.fiValue = drwWalk(f.fiValue, ctx) }
      i4 = i4 + 1
    }
    return ix
  }
  ix
}

// The dispatch-rewrite driver: top-level statements, then every lifted
// function's body (a nested FuncDecl was lambda-lifted into `fnStmts`).
export function dispatchRewrite(stmts: i32[]) {
  let i = 0
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    if s is FuncDecl {
    } else if s is LetDecl {
      s.letInit = drwWalk(s.letInit, -1)
    } else if nodeIsTypeDecl(stmts[i]) {
    } else if s is UnionDecl {
    } else {
      const oldIx = stmts[i]
      const newIx = drwWalk(oldIx, -1)
      if newIx != oldIx {
        // The statement node was REPLACED (e.g. `o[k] = v` → the `(o."[]=")(k,v)`
        // write-trap call). `startStmts` captured the OLD arena index during
        // `collectFns` — repoint it so the start function emits the rewritten form.
        stmts[i] = newIx
        let ssj = 0
        while ssj < startStmts.length {
          if startStmts[ssj] == oldIx { startStmts[ssj] = newIx }
          ssj = ssj + 1
        }
      }
    }
    i = i + 1
  }
  let fe = 0
  while fe < fnStmts.length {
    const fn = P.nodes[fnStmts[fe]]
    if fn is FuncDecl { fn.fnBody = drwWalk(fn.fnBody, fnStmts[fe]) }
    fe = fe + 1
  }
  0
}

// Pin every un-annotated lambda that returns a UNION to that union, by CONSUMING the contextual return
// type the CHECKER already computed — instead of re-deriving it per boundary in the emitter.
//
// An un-annotated lambda's body-inferred return for a union join (`if … { aCat } else { aDog }`)
// collapses to ONE arm (a struct / string), so its emitted functype result and `$fnsig` key (`i>s0;` /
// `i>S`) disagree with a call site's `i>u` — leaving the value call un-interned and the body un-boxed.
// Pinning `fnRet` to the union makes the lambda emit the boxed-union result (like an annotated `: Cat |
// Dog` function): it interns `i>u`, boxes each arm via `emitReturnValue`'s `retUNm`, and the call's
// `ref.cast` + `is`-narrow resolve. The checker proved the union the lambda returns AT ITS BOUNDARY
// (binding / function-return / struct field / array element / call argument) and recorded it under a
// node-index sentinel (`inferRetNameByNode`, the #533 channel) — so reading it pins the return at EVERY
// position UNIFORMLY, with no per-boundary walk (the abstraction the emitter's syntactic re-derivation
// otherwise lacks). Runs BEFORE monomorphization (a HOF-bound clone inherits `nret = fnRet`) and the
// shape passes (the union's box + variants intern for the return). A non-union recorded return / an
// already-annotated lambda is left untouched → byte-identical (the compiler has no union-returning
// lambdas, so the native fixpoint is unaffected).
//
// EVERY ARM BELOW READS THE SAME WAY: the checker proved/adopted shape X at the lambda's boundary,
// and pinning `fnRet` routes the lambda through the lowering the ANNOTATED named-function spelling
// already has. Each arm states only what is its own — the recorder, the witness, and the failure the
// pin prevents.
export function synthRetAnnots() {
  if !fnValUsed { return 0 }
  let fe = 0
  while fe < fnStmts.length {
    const lamIx = fnStmts[fe]
    const fn = P.nodes[lamIx]
    if fn is FuncDecl {
      if fn.fnRet < 0 {
        const ctx = inferRetNameByNode(lamIx)
        if ctx != "" {
          const ctxTy = inferRetTyIxByNode(lamIx)
          // THE ROW, so this ladder can ask WHICH PRODUCER answered instead of re-deriving the
          // answer from the name that producer built. See the nullable arm below for the first
          // arm converted; the rest are specified in the destringify programme's B26/B27.
          const ctxRow = inferRetRowByNode(lamIx)
          // `nameIsLitUnionArmValueUnion`: a value union with a litunion-ALIAS arm
          // (`K0 | i64`) never registers as a union alias (`isUName` false — the box
          // is the value box, its alias arm the string atom), but the pinned TypeRef
          // lowers exactly like the annotated named-function spelling, so pin it too.
          if (
            isUName(ctx) ||
            isValueUnionName(ctx) ||
            nameIsLitUnionType(ctx) ||
            nameIsLitUnionArmValueUnion(ctx)
          ) {
            // A litunion ALIAS return (`(i32) => K = (x) => "b"`, recorded by the checker's
            // return adoption): pin `fnRet` to the alias so the lambda's `$fnsig` result keys
            // the i32 atom (`vtKindOfType` → `>i`) matching the value call, and `emitReturnValue`
            // encodes the member literal as its atom id. Shares the union-pin arm (a litunion is a
            // declared union alias, `nameIsLitUnionType`).
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsNullable(ctxRow) {
            // ASKED OF THE RUNG, not of the name. This arm used to run `nullablePartOf(ctx)` — a
            // depth-aware, quote-aware `|` scan — over a spelling the checker had just rendered
            // from a type it was holding. The producer that built that spelling already knew the
            // answer: only `nullableRetName` and `nulLitUnionRetName` mint a top-level nullable
            // name, and both mint `<part> + "|null"` and nothing else.
            //
            // MEASURED, and the discrimination checked separately from the agreement: 22 corpus
            // files reach this arm, the two contributing rungs are BOTH exercised (39 rows from
            // `nullableRetName`, 8 from `nulLitUnionRetName`), NO third rung reaches it, and there
            // are 0 disagreements. The middle two clauses are what make the last one mean
            // something — a clean agreement over rows from one producer would say nothing about
            // the other.
            //
            // A value union with a `null` member (`i32|null`) does NOT come here: it is
            // `valueUnionRetName`'s, and the arm above claims it via `isValueUnionName`.
            //
            // A NULLABLE-ref return (`P | null`, `string | null`) the checker proved at the lambda's
            // boundary — pin it so the lambda's `$fnsig` result keys the nullable token (`>n<idx>;` /
            // `>N`), matching the value call's key. The niche/nullable-struct lowering already exists
            // for the annotated form; this routes the anonymous lambda through it. (Nullable dual of
            // the union pin.)
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if nameIsMapMemberUnion(ctx) {
            // A MAP-MEMBER-UNION return (`{[string]:f32} | {w:i32}`): the `$fnsig` result keys the
            // union box (`>u`) and `emitReturnValue` boxes the struct/map arm through the #865/#868
            // map-union rep, matching the value call's key. (Map-union dual of the value-union pin.)
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
            // MEASURED THE WAY ARM 2's CONVERSION IS, because nine rungs at once is where a bare
            // agreement count stops meaning anything: 16 corpus files reach this arm; ALL NINE
            // contributing rungs are exercised (8:2 · 9:5 · 10:3 · 11:14 · 12:3 · 13:11 · 14:2 ·
            // 15:4 · 19:3 rows); NO TENTH rung reaches it; 0 disagreements against the ladder
            // position computed both ways. The middle two clauses are what make the last one
            // mean something.
            //
            // ARM 3 IS THE LAST UNCONVERTED NAME TEST ABOVE THIS ONE. Every rung here declines it
            // (`nameIsMapMemberUnion` needs a leading `{[`, and all nine render a `(`-leading
            // array), but converting arm 3 changes which rungs can REACH arm 4, so every
            // equivalence above has to be re-argued at that point rather than assumed.
          } else if inferRetRungIsParenUnionElemList(ctxRow) {
            // An ELEMENT-VALUE-UNION list return (`(f64|null)[]`, `(i32|null)[]`, `(i64|boolean)[]`,
            // `(i64|string)[]`): `emitReturnValue` seeds each element through the value-union-box
            // list rep (`refArrElemKind == 2`). `parenUnionArrElemName` extracts the box element (a
            // `<v>|null` nullable value union OR a plain value union `i64|boolean`), the
            // distinguishing mark of the niche/box list shape.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsNestedElemUnionList(ctxRow) {
            // A NESTED (2-D+) union-element array return (`({f: (…) => boolean} | i32)[][]`,
            // `(i64 | boolean)[][]`, recorded by `nestedElemUnionListRetName`): `emitReturnValue`'s
            // `tyAnnRefListKind`/`tyAnnRefListSlot` thread the OUTER ref-list slot into the body's
            // nested array literal (each inner list builds the kind-2 box element). Un-pinned,
            // `fnRet < 0` gave no thread and the outer array self-classified `i32[][]` from its
            // first inner list's leaf, storing a union-list element into the i32-list backing —
            // INVALID-WASM (fuzz sweep wo7cNe declared, seed 174529790). The 1-D
            // `parenUnionArrElemName` arm above rejects it (its `][]`-suffix guard).
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsNestedLeafList(ctxRow) {
            // A NESTED scalar/string-leaf array return (`() => i64[][]`, `(i32) => f64[][]`):
            // the body literal builds under the RETURN-position seed (`tyAnnRefListKind` →
            // the arm's slot: `() => ([[100]])` under `() => i64[][]` builds i64 inner lists,
            // not the self-classified i32 default), and the `$fnsig` result keys the SAME
            // reflist slot the annotation-side `annRetKind` resolves — the two producers must
            // byte-match, else the value call finds no interned signature (or, pre-pin, the
            // mismatched self-classified build emitted a wrapper-heap INVALID-WASM for an
            // i64-magnitude leaf). (Nested-array dual of the union pin.)
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsLitUnionElemList(ctxRow) {
            // A LITUNION-ALIAS-element array return (`(i32) => K0[] = (q0) => (["4664"])`):
            // the body member literals build the i32 ATOM list under the annotated return's
            // threading. Un-pinned they self-classify a STRING list into the i32-list
            // functype result — invalid wasm.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsMapElemList(ctxRow) {
            // A MAP-ELEMENT array return (`(i32) => {[string]: f32}[] = (q1) => ([h0])`):
            // the `$fnsig` result keys the SAME `>r<slot>;` the annotation-side `annRetKind`
            // resolves (`tyAnnRefListSlot` — the kind-3 map-element slot `ensureRefElem`
            // interns). Un-pinned, the literal-side element spelling diverged and the value
            // call found no interned signature.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if (
            nameIsI64Array(ctx) ||
            nameIsF64Array(ctx) ||
            nameIsF32Array(ctx)
          ) {
            // The three classifiers are `emit_base`'s one-line homes; this arm hand-wrote
            // their bodies as whole-spelling equalities (`ctx == "i64[]" || …`) in a file
            // that already imports that module. Three copies of three homes, and a
            // whole-spelling compare decides a COMPOSITE type by its rendered characters —
            // the homes ask the array grammar's one CUT and compare only the leaf name.
            // (`typecheck.isScalarListRetName`, named below, is a FOURTH copy of the same
            // three-way set; it cannot route here — `typecheck` is the module `emit_base`
            // imports, so the edge only runs the other way. Left for its owner.)
            //
            // A DISTINCT-BACKING SCALAR-LEAF list return (`(i32) => f32[] = (q0) => ([97.5])`,
            // `() => i64[] = () => ([5])`, `isScalarListRetName`'s recordable set): the body
            // literal builds the leaf's wrapper under the RETURN-position seed and the pinned
            // TypeRef collects its list types — the value-call index read requires them;
            // un-pinned, the read fails "list type not collected". An i32-backed list (`i32[]`,
            // `boolean[]`, `K0[]`) is never recorded here (self-classification already agrees
            // with the annotation), so it never reaches this arm.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if nameIsStructWithLitUnionField(ctx) {
            // A STRUCT-with-LITUNION-field return (`{f:K0}`, recorded by `objLitWidenFields`'
            // litunion arm): the body literal builds the i32-ATOM struct and the `$fnsig`
            // result keys the SAME struct every annotated consumer codes. Reached only where
            // NO annotation threads into the lambda (nested through a union's closure arm
            // inside another lambda's expression body — fuzz seed 26306770 d4); the direct-arg
            // spelling already built the atom struct via the param-annotation seed.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if (
            ctx.length > 2 &&
            nameIsArray(ctx) &&
            nameIsStructWithUnionField(arrElemNameRaw(ctx))
          ) {
            // A UNION-FIELD-STRUCT-element LIST return (`{f:{f:f64}|boolean}[]`, recorded by
            // `structFieldBoxElemListRetName`): the body array literal builds boxed-field
            // elements and the `$fnsig` result keys the SAME reflist slot the annotated
            // `(): {f:…|boolean}[]` spelling resolves. Un-pinned, the self-inferred
            // plain-element list stored a struct ref into the boxed field's i32 tag slot —
            // INVALID-WASM (fuzz-nightly run 29874629450, seed 214588500 d6).
            // (Element-list sibling of the struct arm below.)
            //
            // The guard's `[]` TEST and `[]` CUT are `emit_base`'s two homes (`nameIsArray` /
            // `arrElemNameRaw`, #1175) — this arm and the next spelled both halves out by
            // hand. `ctx.length > 2` stays IN FRONT of the test: it excludes the degenerate
            // `"[]"`, which `nameIsArray` accepts and whose raw cut is "", exactly as the
            // hand-written form did.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if (
            ctx.length > 2 &&
            nameIsArray(ctx) &&
            nameIsWholeSpanShape(arrElemNameRaw(ctx))
          ) {
            // A PLAIN-STRUCT-element LIST return (`{a:i64,f:f64,z:{…}}[]`, recorded by
            // `structElemListRetName`) — pin it so the element literals build under the
            // annotated threading. Un-pinned, a program with same-fieldset TWIN rows in
            // scope fieldset-matched the element onto the wrong row and boxed the list —
            // INVALID-WASM (fuzz sweep3 multiobs leg, seed 369283890 case_00290).
            // NOMINAL-resolved: a `{v:i32}[]` render over a declared `type S = {v:i32}`
            // pins `S[]` so the `$fnsig` result keys the SAME ref-list slot the
            // annotation-side value call resolves (un-resolved, the inline spelling
            // keyed a twin slot — "no interned signature" on the ref-list ABI cases).
            // Same two `[]` homes as the arm above (`nameIsArray` / `arrElemNameRaw`).
            fn.fnRet = synthTypeRefTy(resolveShapeToNominal(ctx), -1, ctxTy)
          } else if nameIsStructWithUnionField(ctx) {
            // A STRUCT-with-UNION/NULLABLE-field return (`{f: boolean | {w: i32}}`,
            // `{f: i64 | string}`, recorded by `objRetWidenAdopt`'s boxing-widen arm): the
            // `$fnsig` result is the union-FIELD struct (`retStructIndex` → the boxed-field
            // shape) and `emitReturnValue` coerces the body ObjLit into the boxed field slot,
            // matching the value call. Un-pinned, the lambda's result was the plain
            // body-inferred struct (`{f: boolean}` / `{f: i32}`), so the value call
            // mis-recovered the boxed field — a MISMATCH (`t0(1).f is boolean` read the wrong
            // tag) or INVALID-WASM (an i64 field read where an i32 was stored). (Struct-field
            // dual of the map-member-union pin.)
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if nameIsStructWithMapField(ctx) {
            // A MAP-carrying STRUCT return (`{a:string,f:{f:{[string]:{f:i64}}},z:f32}`,
            // recorded canonically by `structMapFieldRetName`): the body ObjLit's NESTED
            // literals thread the annotation's per-field struct indices. Un-pinned, the inner
            // `{f: h0}` resolved by first-field-name-set match onto the map's own VALUE struct
            // `{f: i64}` (interned first), the map ref took the i64 field widen, and the outer
            // literal minted a WRONG-layout twin row — INVALID-WASM (`i64.extend_i32_s` on a
            // map ref; fuzz-nightly seed 184510897 d6). (Map-field sibling of the
            // union-field-struct pin above.)
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if nameIsWholeSpanShape(ctx) && nameIsSpaceFree(ctx) {
            // A PLAIN struct return recorded CANONICALLY (`structPlainRetName` —
            // `{f:f32}`, `{a:i64,f:f64,z:{…}}`): pin it so the body literal builds
            // under the annotated threading. Un-pinned, a same-fieldset TWIN row in
            // scope fieldset-matched the wrong row (`{f: 4.5}` took the `{f: f64}`
            // twin where the context declared `{f: f32}` — INVALID-WASM, fuzz sweep3
            // multiobs leg, seed 784841544 case_00222). CANON-ONLY (the space
            // guard): a legacy SPACED record (a struct whose composite fields
            // `structPlainRetName` declines, recorded via the `recordable` render)
            // must keep its established un-pinned route. NOMINAL-resolved: a shape
            // with a declared twin (`{v:i32}` beside `type S = {v:i32}`) pins the
            // NOMINAL name so the `$fnsig` matches the annotation-side key.
            //
            // THE SPACE GUARD IS `tyname.nameIsSpaceFree` (W7). It was spelled
            // `!strContains(ctx, " ")` — the ONE writing of this rule that no
            // character-anchored census could see, because it asks the question as a
            // substring CALL rather than as a `' '` compare. The two are equal on every
            // input by construction, not by reachability: with a one-character needle
            // `strContains` rejects the empty string on its `sub.length > s.length` line
            // (where the home answers "space-free", true — and the negation makes those
            // the same answer) and otherwise walks exactly the same `s[i] == ' '` compare.
            // Retiring it takes `strContains` out of this file's `emit_base` import list.
            fn.fnRet = synthTypeRefTy(resolveShapeToNominal(ctx), -1, ctxTy)
          }
        }
      }
    }
    fe = fe + 1
  }
  0
}

// THE PIN an un-annotated UNION param takes — chosen by the param's OWN union REP, never by
// `unNames` DECLARATION ORDER.
//
// THREE reps answer to one `nodeTyIsUnion`: a BOXED union (`i32 | string`, `Cat | Dog`) is the
// shared `{tag, value}` `$uBox`, a STRING LITUNION (`"a" | "b"`, `type K = "a" | "b"`) is an
// interned i32 ATOM, and a NUMERIC litunion (`0 | 1`, `type Z = 0 | 1`) is its plain BASE
// SCALAR. `unNames` holds ALL THREE — `collectU` pushes every declared `type … = … | …`
// alias in source order, litunion aliases of either flavour included — so `unNames[0]` picked
// the pin by which alias the FILE happened to declare first, and no two of the reps substitute
// for each other in EITHER direction:
//   · `type K = "a"|"b"` declared ahead of an `(i32|string)` callback param pinned the param to
//     the ATOM, so the value call's `ref.cast` found an i32 where the box was declared — TRAP
//     (and INVALID WASM, `expected (ref $type), found i32`, once the lambda body USES the
//     param). Moving the same litunion declaration BELOW a value-union alias made the identical
//     program correct — the defect was the ORDER, not the program.
//   · the mirror: a litunion-ALIAS param (`(K) => i32`) behind ANY declared boxed union pinned
//     the atom param to the box — the same trap, the same invalid wasm when the body uses it.
//   · and BOTH again on the numeric axis (`type Z = 0 | 1` for `type K`), which the string-only
//     `nameIsLitUnionType` / `tyIsLitUnion` predicates could not see at all.
//
// The BOXED half keeps the arm's shortcut and states its bound: every boxed union shares
// `$uBox` and program-global variant tags, so ANY declared BOXED alias routes emission
// identically and the checker has already validated the precise type — the pin only has to
// carry the REP. The LITUNION half cannot borrow that argument, because a litunion's atom ids
// are its own member strings; it pins the param's OWN rendered type instead, which is the same
// name an explicit annotation spells and the same move the nullable arm below makes.
//
// "" means NO PIN — the param keeps its un-pinned route, which is exactly what the arm did
// when `unNames` was empty (that guard now lives here; see the call site). Reachable only for a
// BOXED param in a program that registers no boxed alias at all — a struct union with no
// `type U = A | B` alias, since `registerValueUnionName` declines a non-scalar member set. The
// litunion half never returns "": its pin is the param's own spelling, not a registered row.
function unionParamPinName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if tyIsLitUnion(ty) {
    // A litunion param, and its rep follows the SPELLING the context was written in — the
    // `canonEmitTypeNames` soften invariant `tyToEmitNameGo`'s union arm states: a DECLARED
    // alias (`(K) => i32`) is preserved and reps as the i32 ATOM, an INLINE member spelling
    // (`("a"|"b") => i32`) softens to `string` and reps as the string ref. So the pin has to
    // reproduce the context's spelling, not merely its rep, and `nodeTyIsLitUnionAlias` is the
    // question that separates them — the alias's OWN arena index (`cUnionTyIxs`), not the
    // member-set match, which an inline spelling satisfies too.
    if nodeTyIsLitUnionAlias(ix) {
      const al = litUnionAliasNameOfTy(ty)
      if al != "" { return al }
    }
    // The inline spelling's own emit name: `string`, by that same soften.
    return tyToEmitName(ty)
  }
  // A NUMERIC literal union (`0 | 1`, `1.5 | 2.5`, the alias-of-an-alias `type Y = Z`) is
  // the SECOND HALF of the arm above, and `tyIsLitUnion` cannot see it: that predicate
  // rejects any member whose `litKind != "str"`, so every numeric litunion falls past it
  // into the boxed loop below — a rep it does not have. Its rep is the BASE SCALAR
  // (`i32` / `i64` / `f64`), and `numLitUnionBaseName` is that rule's home. So the pin is
  // the base name, which is byte-for-byte the name the ANNOTATION side now carries too:
  // #1273 made `canonEmitName` canon the interior of a function type, so `(Z) => i32`
  // reaches the `$fnsig` producers as `(i32) => i32`. That is what makes this arm a pin
  // rather than a second answer — canon rewrites the annotation's NAMES, and this selector
  // reads the type ARENA, which canon never touches. The FLOAT base is the witness that the
  // arm is load-bearing at all: `1.5 | 2.5` is wrong in every declaration order, including
  // with no boxed row declared, because the un-pinned param defaults to i32.
  //
  // NO SPELLING SPLIT, unlike the string half: an alias `Z` and an inline `0 | 1` soften
  // to the SAME base scalar (the alias name is not an atom identity to preserve — the
  // members ARE i32s), so one answer serves both and `nodeTyIsLitUnionAlias` is not asked.
  const nb = numLitUnionBaseName(ty)
  if nb != "" { return nb }
  let u = 0
  while u < unNames.length {
    const nm = unNames[u]
    // …AND THE SAME BLIND SPOT ON THE OTHER SIDE OF THE SELECTOR. `nameIsLitUnionType` is
    // the string-only reject, so a `type Z = 0 | 1` row was offered as a BOXED pin to an
    // unrelated `(i32 | string)` callback — and being row 0 it won, which reproduces #1270's
    // defect verbatim on the numeric axis: one numeric litunion alias declared ABOVE a union
    // callback trapped it, and moving the same line BELOW a boxed alias made the identical
    // program correct. A numeric row does not rep as the box any more than a string one
    // does; skip both, and declaration order stops being an input here too.
    if !nameIsLitUnionType(nm) {
      if numLitUnionAliasName(nm) == "" { return nm }
    }
    u = u + 1
  }
  ""
}

// THE NAME an un-annotated parameter's RECORDED type pins to — "what its annotation would
// have said". "" when the checker recorded no usable type, which is exactly the still-open
// inference HOLE: a `TyVar` is neither a union nor a nullable and `nodeTyName` renders ""
// for it, so a genuine hole falls through all three arms and keeps its un-pinned route.
//
// ONE answer with two readers: `synthParamAnnots` below MINTS the annotation from it, and
// the monomorphizer's un-annotated-parameter pin CONSULTS it before deriving one from the
// argument type (`monoArgTyName`). A parameter the checker has already decided — solved
// from its own body usage, or pinned contextually by a receiver — must not get a second,
// argument-derived answer: the two disagree exactly where the rep depends on the SPELLING,
// and the body was checked against the parameter, not against the argument.
//
// THREE ARMS, one per rep family, and the union/nullable pair cannot fold into the general
// arm because `nodeTyName` renders "" for both:
//
//   UNION (`xs.filter((a) => a is Cat)`, a solved litunion) — a name of the SAME REP, so
//   the `is`-narrowing and the closure `$fnsig` param token (kind 4) resolve.
//   `unionParamPinName` is which name, and why DECLARATION ORDER is not it. Its ""
//   ("no pin available" — a boxed param in a program that registers no boxed alias) is the
//   faithful answer; the `unNames.length > 0` guard that used to stand at the call site was
//   a proxy for it, true only of the boxed half, and it silently withheld the pin from a
//   program whose only union is an INLINE litunion — leaving the param on the i32 default
//   while the annotation keyed the string soften (TRAP / invalid wasm).
//
//   NULLABLE (`const f: (i32 | null) => i32 = (_k) => 1`) — a `T | null` is a `TyNullable`,
//   NOT a `TyUnion`, so it reaches neither of the other arms. The union arm's shortcut (pin
//   ANY declared alias) must NOT be imitated: every boxed union shares one `$uBox`, but
//   nullables do NOT share a rep — `i32|null` boxes, `string|null`/`S|null`/`i32[]|null` are
//   NICHE refs, `boolean|null` is the 0/1/2 i32 sentinel. So the pin is the parameter's OWN
//   type, rendered by the arena and resolved to the emitter's nominal spelling exactly as
//   the general arm does, which is what makes the pinned name identical to an explicit
//   annotation's. Three outcomes, all measured, all reached by that ONE pin because the rep
//   the name selects IS the difference between them (the annotated twin is the control):
//     · `i32|null`, `i64|null`, `f64|null`, `f32|null` (boxed): the plain i32 param declared
//       a functype the value call's `ref.cast` did not — a cast-failure TRAP. Pinned, both
//       sides key the box: CORRECT.
//     · `f64|null` / `f32|null` whose lambda USES the param (`(k) => useN(k)`): the i32 param
//       fed the callee's box coercion an i32 where the wide scalar was stored — INVALID
//       WASM. Pinned: CORRECT.
//     · `string|null`, `S|null`, `i32[]|null` (niche refs): the pinned-i32 param made the
//       value's own `$fnsig` key NON-EMPTY, so `emitClosureValueCore`'s
//       `cloSigKeyExt(fe) == ""` floor never fired and the raw ref reached an i32 param —
//       INVALID WASM. Pinned with the real nullable the key is "" and the floor fires: the
//       same CLEAN REJECT ("a function value may not take a nullable parameter") the
//       annotated twin has always produced.
//   `boolean|null` was already correct un-annotated (its niche IS an i32, so the default
//   happened to agree) and stays correct — the pin makes it agree by construction.
//
//   EVERYTHING ELSE — `resolveShapeToNominal` maps the checker's shape name to the emitter's
//   nominal form (a struct / variant shape to its declared name, a ref-array shape
//   recursively to `<element>[]`) so `checkParams` and the struct- / ref-list-param
//   machinery key on it. A scalar / string / closure name passes through.
export function recordedParamPinName(pIx: i32) {
  if nodeTyIsUnion(pIx) { return unionParamPinName(pIx) }
  if nodeTyIsNullable(pIx) {
    const nty = tyToEmitName(nodeTyIxOf(pIx))
    if nty == "" { return "" }
    // Resolve the SHAPE under the null, not the whole spelling — the SAME rule the general
    // arm applies, asked through the `|null` suffix that `resolveShapeToNominal` (a
    // field-set / element match) does not look through on its own. `nullablePartOf` is the
    // depth-aware split, so a `{y:string|i32}|null` keeps its FIELD union intact rather than
    // splitting on the inner bar.
    //
    // MEASURED INERT TODAY, and recorded as such rather than claimed load-bearing:
    // `{w:i32}|null` and `W|null` produce the same outcome on every shape reachable now,
    // because every composite nullable reaches the "not yet supported" floor BEFORE any
    // nominal-keyed consumer runs. It stays because it is one rule spelled the same way in
    // both arms: were the general arm's `resolveShapeToNominal` absent here, a reader would
    // have to explain the asymmetry, and whoever graduates the floor would have to
    // rediscover it.
    const nbase = nullablePartOf(nty)
    if nbase != "" {
      const nnom = resolveShapeToNominal(nbase)
      if nnom != "" { return nnom + "|null" }
    }
    return nty
  }
  const tn = nodeTyName(pIx)
  if tn == "" { return "" }
  resolveShapeToNominal(tn)
}

export function synthParamAnnots() {
  let fe = 0
  while fe < fnStmts.length {
    const fn = P.nodes[fnStmts[fe]]
    if fn is FuncDecl {
      const ps = fn.fnParams
      let pi = 0
      while pi < ps.length {
        const p = P.nodes[ps[pi]]
        if p is Param {
          if p.parType < 0 {
            const upin = recordedParamPinName(ps[pi])
            if upin != "" {
              // THE PARSE THIS SITE USED TO PAY FOR WAS ALWAYS DISCARDED. `synthTypeRef` is
              // `synthTypeRefTy(…, -1)`, and -1 means "resolve the name" — which mints a
              // structurally identical `Ty` row, `nameToTy` not being hash-consed — and then
              // `recordNodeTyFrom` below OVERWROTE the result unconditionally with the very
              // type handed over here. 534 wasted parses over the corpus, the largest single
              // remaining site. This is the funnel-records-then-caller-re-records shape the
              // programme doc names at B8, in its pure form: the funnel's answer was not
              // merely duplicated, it was thrown away.
              //
              // `recordNodeTyFrom` is KEPT rather than deleted, and that is what makes this
              // exactly equivalent instead of nearly so. When `srcTy >= 0` it now rewrites the
              // same value (a no-op); when it is -1 — which the header above argues cannot
              // happen, since `upin != ""` means the param HAS a recorded type — the hand-over
              // declines, `recordClonedNodeTyKnown` falls to its PLACEHOLDER, and the copy
              // overwrites that placeholder with -1 exactly as it did before. Deleting it would
              // change that unreachable arm from -1 to a placeholder.
              const srcTy = nodeTyIxOf(ps[pi])
              const un = synthTypeRefTy(upin, -1, srcTy)
              // Carry the parameter's recorded arena type onto the synthesized annotation,
              // so a consumer classifies the pin STRUCTURALLY instead of re-deriving it
              // from the name: the pinned name may be an interned `#anonN` shape name
              // `nameToTy` cannot resolve, and `exprIsLitAtom` asks
              // `nodeTyIsLitUnionAlias(p.parType)` of every Ident naming a parameter.
              // Without it a litunion param pinned `K` — so its wasm param IS the i32 atom
              // — while the annotation node carried no type, and every atom-consuming site
              // in the body still took the string route: a `const r: K = u` lowered the
              // string→atom widen (`select` over a `__str_eq__` of an i32 param, INVALID
              // WASM) and a bare `print(u)` printed the raw atom id. The pin NAME and the
              // recorded TYPE are one answer or they are a bug.
              //
              // Faithful for the softened half too: an INLINE `"a"|"b"` pins to `string`
              // and its arena index is NOT a registered alias, so `nodeTyIsLitUnionAlias`
              // still answers no — the name and the arena agree.
              //
              // This is ALSO what retires the ref-list ROW record that used to sit in the
              // general arm (destringify D-ANNRLREC): the record's only readers are
              // `annRefArrSlot` and `annTyNulFlag`, and BOTH consult the node's recorded
              // arena type first. `upin != ""` means the param HAS a recorded type, so
              // `nodeTyIxOf(un) >= 0` and `annTyNulFlag(un)` can never reach `annRlNulAt` —
              // that half is dead by construction. The slot half is dead by measurement:
              // the recorded row and `annRefArrSlot`'s own arena rung agreed on 2 of 2
              // answering calls and the name leg never answered where the arena declined,
              // over 15,760 reaches (1,274 corpus files + 50,400 fuzz programs). Rows only
              // ever append, so a row the arena resolves HERE it still resolves at the
              // consumer.
              recordNodeTyFrom(un, ps[pi])
              p.parType = un
            }
          }
        }
        pi = pi + 1
      }
    }
    fe = fe + 1
  }
  0
}

// ── captured-MUTATION boxing ──────────────────────────────────────────────────────────────
// Closures capture by VALUE (the env struct copies each captured local), so a local MUTATED
// inside a closure cannot be reflected back — and a bare `c = …` in the closure has no local
// slot, failing at emit ("assignment target is not a parameter, local, or global"). The fix is
// a pure AST rewrite, done before monomorphization so instances inherit it: a captured-mutated
// local is boxed as a LENGTH-1 ARRAY (a shared heap ref both scopes index). `let c = init`
// becomes `let c = [init]`, and EVERY use of `c` (read OR assignment target) becomes `c[0]`, so
// the closure's `c = c + 1` lowers to the indexed write `c[0] = c[0] + 1` into the shared array,
// visible in the maker. Arrays are already capturable + index-assignable through a closure.
//
// Conservative: only a DIRECT `let` of the maker that is assigned INSIDE a nested lambda and is
// NOT shadowed by any nested binding (param / let / loop var) is boxed. Anything else is left
// untouched, falling back to the existing loud error rather than risking a mis-rewrite.

// One scan of a maker body: `dlets` = the maker's own `let` names (depth 0); `alam` = names
// ASSIGNED inside a nested lambda (depth > 0); `ndecls` = every binding declared inside a nested
// lambda (params / lets / loop vars) — the shadow set.
function cboxScan(
  ix: i32,
  depth: i32,
  dlets: string[],
  alam: string[],
  ndecls: string[],
) {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is FuncDecl {
    const ps = n.fnParams
    let pi = 0
    while pi < ps.length {
      const p = P.nodes[ps[pi]]
      if p is Param {
        if !capHas(ndecls, p.parName) { ndecls.push(p.parName) }
      }
      pi = pi + 1
    }
    return cboxScan(n.fnBody, depth + 1, dlets, alam, ndecls)
  }
  if n is LetDecl {
    if depth == 0 {
      if !capHas(dlets, n.letName) { dlets.push(n.letName) }
    } else {
      if !capHas(ndecls, n.letName) { ndecls.push(n.letName) }
    }
    return cboxScan(n.letInit, depth, dlets, alam, ndecls)
  }
  if n is Block {
    const bs = n.blkStmts
    let i = 0
    while i < bs.length {
      cboxScan(bs[i], depth, dlets, alam, ndecls)
      i = i + 1
    }
    return 0
  }
  if n is BinExpr {
    if n.binOp == "=" {
      if depth > 0 {
        const t = P.nodes[n.binLeft]
        if t is Ident {
          if !capHas(alam, t.identName) { alam.push(t.identName) }
        }
      }
    }
    cboxScan(n.binLeft, depth, dlets, alam, ndecls)
    return cboxScan(n.binRight, depth, dlets, alam, ndecls)
  }
  if n is IfStmt {
    cboxScan(n.ifCond, depth, dlets, alam, ndecls)
    cboxScan(n.ifThen, depth, dlets, alam, ndecls)
    return cboxScan(n.ifElse, depth, dlets, alam, ndecls)
  }
  if n is WhileStmt {
    cboxScan(n.whileCond, depth, dlets, alam, ndecls)
    return cboxScan(n.whileBody, depth, dlets, alam, ndecls)
  }
  if n is ForRange {
    if !capHas(ndecls, n.frVar) { ndecls.push(n.frVar) }
    cboxScan(n.frFrom, depth, dlets, alam, ndecls)
    cboxScan(n.frTo, depth, dlets, alam, ndecls)
    cboxScan(n.frStep, depth, dlets, alam, ndecls)
    return cboxScan(n.frBody, depth, dlets, alam, ndecls)
  }
  if n is ForIn {
    if !capHas(ndecls, n.fiVar) { ndecls.push(n.fiVar) }
    cboxScan(n.fiIter, depth, dlets, alam, ndecls)
    return cboxScan(n.fiBody, depth, dlets, alam, ndecls)
  }
  if n is RetStmt { return cboxScan(n.retArg, depth, dlets, alam, ndecls) }
  if n is Unary { return cboxScan(n.unArg, depth, dlets, alam, ndecls) }
  if n is Paren { return cboxScan(n.parInner, depth, dlets, alam, ndecls) }
  if n is Member { return cboxScan(n.memObj, depth, dlets, alam, ndecls) }
  if n is OptMember { return cboxScan(n.omObj, depth, dlets, alam, ndecls) }
  if n is Index {
    cboxScan(n.idxArr, depth, dlets, alam, ndecls)
    return cboxScan(n.idxIndex, depth, dlets, alam, ndecls)
  }
  if n is IsExpr { return cboxScan(n.isObj, depth, dlets, alam, ndecls) }
  if n is AsExpr { return cboxScan(n.asObj, depth, dlets, alam, ndecls) }
  if n is Call {
    cboxScan(n.callFn, depth, dlets, alam, ndecls)
    const args = n.callArgs
    let ci = 0
    while ci < args.length {
      cboxScan(args[ci], depth, dlets, alam, ndecls)
      ci = ci + 1
    }
    return 0
  }
  if n is ArrayLit {
    const es = n.arrElems
    let ei = 0
    while ei < es.length {
      cboxScan(es[ei], depth, dlets, alam, ndecls)
      ei = ei + 1
    }
    return 0
  }
  if n is ObjLit {
    const fs = n.objFields
    let fi = 0
    while fi < fs.length {
      const f = P.nodes[fs[fi]]
      if f is FieldInit { cboxScan(f.fiValue, depth, dlets, alam, ndecls) }
      fi = fi + 1
    }
    return 0
  }
  0
}

// Rewrite the maker body (and its nested lambda bodies): a USE of a boxed name → `c[0]`, and a
// boxed `let c = init` → `let c = [init]`. Returns the (possibly replaced) node index so parents
// reassign — mirrors `drwWalk`, plus descending into `FuncDecl` bodies.
function cboxWalk(ix: i32, boxed: string[]) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Ident {
    if capHas(boxed, n.identName) {
      return mkIndex(mkIdent(n.identName, -1), mkNum("0", -1), -1)
    }
    return ix
  }
  if n is FuncDecl {
    n.fnBody = cboxWalk(n.fnBody, boxed)
    return ix
  }
  if n is Block {
    const bs = n.blkStmts
    let i = 0
    while i < bs.length {
      bs[i] = cboxWalk(bs[i], boxed)
      i = i + 1
    }
    return ix
  }
  if n is LetDecl {
    n.letInit = cboxWalk(n.letInit, boxed)
    if capHas(boxed, n.letName) {
      // Convert a SCALAR annotation to its array form so the boxed length-1 list classifies as the
      // matching list type (`let c: f64` → `let c: f64[]`; an `f32` annotation is what makes the
      // `[0.0]` literal build f32, not the f64 default). An UN-annotated local needs no conversion —
      // the `[init]` literal infers its element type (`let c = 0` → i32[], `= 0.0` → f64[]).
      if n.letType >= 0 {
        const lt = P.nodes[n.letType]
        if lt is TypeRef {
          // THE ARRAY TYPE IS CONSTRUCTED, NOT RE-PARSED. This site appends `[]` to a name
          // and `recordClonedNodeTy` used to parse the result straight back — a string
          // built and taken apart in two adjacent statements, the destringify programme's
          // own headline shape. The element's arena index is on the annotation node the
          // checker already recorded, so the array type is one `mkArrayTy` over it and the
          // name is left as the node's spelling for the consumers that still read it.
          //
          // GATED ON THE NAME BEING A SINGLE TOP-LEVEL ATOM, AND THAT GATE IS THE WHOLE
          // CORRECTNESS OF THE HUNK. `nm + "[]"` is an array spelling only when `nm` is an
          // atom: `"i32 | string" + "[]"` is `"i32 | string[]"`, which denotes
          // `i32 | (string[])` — a union whose second arm is a list, not a list of the
          // union. That concat has always been malformed, and it was HARMLESS because both
          // halves were wrong together: the name parsed back to the union, `nodeTyIx` held
          // the union, the indexed-assignment lowering saw a non-array and rejected loudly.
          //
          // Handing the type over UNGATED fixes one half and leaves the other, which is
          // worse than fixing neither: the arena says `(i32 | string)[]` so every
          // array-shaped check passes, the name-keyed lowering still reads
          // `"i32 | string[]"`, and the disagreement lands in codegen —
          // `let u: i32 | string` captured by a closure went from a loud
          // `indexed-assignment target is not an array` to check-clean INVALID WASM.
          //
          // So the hand-over runs only where the SPELLING denotes the type it is handed. A
          // composite keeps the name path and master's loud reject; widening that reject
          // into working code is a capability change (a parenthesized `(i32 | string)[]`
          // does compile and run) and belongs to its own slice with its own fuzz gate.
          const atoms: string[] = []
          splitUnionAtoms(lt.tyName, atoms)
          let boxedTy = -1
          if atoms.length == 1 {
            if annArrowAt(lt.tyName) < 0 {
              const elemTy = nodeTyIxOf(n.letType)
              if elemTy >= 0 { boxedTy = mkArrayTy(elemTy) }
            }
          }
          n.letType = synthTypeRefTy(lt.tyName + "[]", -1, boxedTy)
        }
      }
      const els: i32[] = []
      els.push(n.letInit)
      n.letInit = mkArrayLit(els, -1)
    }
    return ix
  }
  if n is BinExpr {
    n.binLeft = cboxWalk(n.binLeft, boxed)
    n.binRight = cboxWalk(n.binRight, boxed)
    return ix
  }
  if n is IfStmt {
    n.ifCond = cboxWalk(n.ifCond, boxed)
    n.ifThen = cboxWalk(n.ifThen, boxed)
    n.ifElse = cboxWalk(n.ifElse, boxed)
    return ix
  }
  if n is WhileStmt {
    n.whileCond = cboxWalk(n.whileCond, boxed)
    n.whileBody = cboxWalk(n.whileBody, boxed)
    return ix
  }
  if n is ForRange {
    n.frFrom = cboxWalk(n.frFrom, boxed)
    n.frTo = cboxWalk(n.frTo, boxed)
    n.frStep = cboxWalk(n.frStep, boxed)
    n.frBody = cboxWalk(n.frBody, boxed)
    return ix
  }
  if n is ForIn {
    n.fiIter = cboxWalk(n.fiIter, boxed)
    n.fiBody = cboxWalk(n.fiBody, boxed)
    return ix
  }
  if n is RetStmt {
    n.retArg = cboxWalk(n.retArg, boxed)
    return ix
  }
  if n is Unary {
    n.unArg = cboxWalk(n.unArg, boxed)
    return ix
  }
  if n is Paren {
    n.parInner = cboxWalk(n.parInner, boxed)
    return ix
  }
  if n is Member {
    n.memObj = cboxWalk(n.memObj, boxed)
    return ix
  }
  if n is OptMember {
    n.omObj = cboxWalk(n.omObj, boxed)
    return ix
  }
  if n is Index {
    n.idxArr = cboxWalk(n.idxArr, boxed)
    n.idxIndex = cboxWalk(n.idxIndex, boxed)
    return ix
  }
  if n is IsExpr {
    n.isObj = cboxWalk(n.isObj, boxed)
    return ix
  }
  if n is AsExpr {
    n.asObj = cboxWalk(n.asObj, boxed)
    return ix
  }
  if n is Call {
    n.callFn = cboxWalk(n.callFn, boxed)
    const args = n.callArgs
    let ci = 0
    while ci < args.length {
      args[ci] = cboxWalk(args[ci], boxed)
      ci = ci + 1
    }
    return ix
  }
  if n is ArrayLit {
    const es = n.arrElems
    let ei = 0
    while ei < es.length {
      es[ei] = cboxWalk(es[ei], boxed)
      ei = ei + 1
    }
    return ix
  }
  if n is ObjLit {
    const fs = n.objFields
    let fi = 0
    while fi < fs.length {
      const f = P.nodes[fs[fi]]
      if f is FieldInit { f.fiValue = cboxWalk(f.fiValue, boxed) }
      fi = fi + 1
    }
    return ix
  }
  return ix
}

// The INIT of the maker's direct `let name` (searching statements, NOT descending into a nested
// lambda or an expression), or -1. Used to gate boxing on a known element type.
function cboxInitOf(ix: i32, name: string) {
  if ix < 0 { return -1 }
  const n = P.nodes[ix]
  if n is LetDecl {
    if n.letName == name { return n.letInit }
    return -1
  }
  if n is Block {
    const bs = n.blkStmts
    let i = 0
    while i < bs.length {
      const r = cboxInitOf(bs[i], name)
      if r >= 0 { return r }
      i = i + 1
    }
    return -1
  }
  if n is IfStmt {
    const rt = cboxInitOf(n.ifThen, name)
    if rt >= 0 { return rt }
    return cboxInitOf(n.ifElse, name)
  }
  if n is WhileStmt { return cboxInitOf(n.whileBody, name) }
  if n is ForRange { return cboxInitOf(n.frBody, name) }
  if n is ForIn { return cboxInitOf(n.fiBody, name) }
  -1
}

// True if `initIx` is a SCALAR LITERAL — an integer (`i32`/`i64`), float (`f64`, or `f32` via the
// annotation), or string. A captured-mutated local with such an init boxes cleanly into a length-1
// list of the matching scalar type: `cboxWalk` converts the annotation to its array form, the list
// type is collected (`cboxForceListUse`), and the CLOSURE classifies the captured env field's list
// kind (`capturedKindOf`, consulted by `exprF64Array`/`exprI64Array`/`exprF32Array`/
// `exprStringArray`). Covers the counter/accumulator case at every scalar type. A non-scalar-literal
// init (struct / closure / call) is left to the loud error rather than mis-lowered.
function cboxInitScalar(initIx: i32) {
  if initIx < 0 { return false }
  const n = P.nodes[initIx]
  if n is NumLit { return true }
  if n is StrLit { return true }
  false
}

// Per top-level function: box each direct `let` that is assigned inside a nested lambda and not
// shadowed (and, for now, has an i32 integer init). Usage-gated — a program with no such local
// rewrites nothing (identical bytes).
export function captureBoxRewrite(_stmts: i32[]) {
  let fe = 0
  while fe < fnStmts.length {
    const fn = P.nodes[fnStmts[fe]]
    if fn is FuncDecl {
      const dlets: string[] = []
      const alam: string[] = []
      const ndecls: string[] = []
      cboxScan(fn.fnBody, 0, dlets, alam, ndecls)
      const boxed: string[] = []
      let di = 0
      while di < dlets.length {
        const nm = dlets[di]
        if capHas(alam, nm) {
          if !capHas(ndecls, nm) {
            if cboxInitScalar(cboxInitOf(fn.fnBody, nm)) { boxed.push(nm) }
          }
        }
        di = di + 1
      }
      if boxed.length > 0 { fn.fnBody = cboxWalk(fn.fnBody, boxed) }
    }
    fe = fe + 1
  }
  0
}
