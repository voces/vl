} from "./emit_state"
import {
  capMemoNoteEdit,
  drwFieldClosure,
  exprIsClosure,
  exprReReadable,
  fnIndexOf,
  letDeclIsClosureNoLocal,
  nameIsWholeSpanShape,
  resolveShapeToNominal,
  sFieldIndex,
  shapeNominalOfTy,
