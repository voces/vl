// ── dead block tails ──────────────────────────────────────────────────────────────────────────

// Drops the statements that end a block after one that always exits, as recorded by the checker,
// so no later pass classifies or lowers a value the checker typed out of the block (D8720). A
// dropped function declaration is unreachable too: a local is visible only after it is declared.
export function deadTailDrop() {
  for b in deadTailBlks {
    const bn = nodeAt(b)
    if bn is Block {
      while blockTailIsDead(bn.blkStmts) { bn.blkStmts.pop() }
    }
  }
  0
}

// ── loop and labelled-block values ────────────────────────────────────────────────────────────

// A loop or labelled block whose value is used becomes `if true { let $lv: T [= null]; <loop>;
// $lv } else { __trap__() }`, each `break v` storing `$lv = v` first. A nullable `T` starts
// `null`; a non-null one has only value exits, whose frame carries the value out (`whileLv`).
// DECISIONS.md, "Labels are marked at the exit, and any loop carries a value".

// The loops are gathered in pre-order and rewritten in reverse, so a nested loop is rewritten
// before any loop its `break`s may leave; `atStmt` records whether each stands in a statement
// list, where the statement walks collect its locals. An explicit stack, for deep chains.
export function loopValueRewrite(rootIx: i32) {
  exitArmsEndNever()
  if !loopValAny() { return 0 }
  const todo: i32[] = [rootIx]
  const todoStmt: boolean[] = [true]
  const loops: i32[] = []
  const loopStmt: boolean[] = []
  const coalesces: i32[] = []
  while todo.length > 0 {
    const ix = todo.pop() ?? -1
    const atStmt = todoStmt.pop() ?? false
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if (
        (n is WhileStmt || n is ForRange || n is ForIn)
        && loopValTyOf(ix) >= 0
      ) {
        loops.push(ix)
        loopStmt.push(atStmt)
      }
      if n is BinExpr {
        if n.binOp == "??" && lvIsNullableLoop(unwrapParen(n.binLeft)) {
          coalesces.push(ix)
        }
      }
      const inList = n is Block || n is Program
      const kids = nodeChildren(ix)
      let i = 0
      while i < kids.length {
        todo.push(kids[i])
        todoStmt.push(inList)
        i = i + 1
      }
    }
  }
  let k = loops.length - 1
  const moved: {[i32]: i32} = Map()
  while k >= 0 {
    const y = lvRewriteAt(loops[k], loopValTyOf(loops[k]), loopStmt[k])
    if y >= 0 && !(nodeAt(y) is WhileStmt) { moved[loops[k]] = y }
    k = k - 1
  }
  // A `for` range loop declares its variable, and its uses follow it to its new node; a `for` in
  // loop's variables are their own declarations, and follow it by pointing at its new node.
  if identAuditDrop != IDENT_DROP_LOOP_MOVE {
    identRedirect(moved)
    for l in loops { loopVarsMoveTo(moved[l] ?? -1) }
  }
  for q in coalesces { lvCoalesceIntoArm(q) }
  capMemoNoteEdit()
  plCacheBust()
  0
}

// Is `ix` a loop whose used value is nullable?
function lvIsNullableLoop(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if !(n is WhileStmt || n is ForRange || n is ForIn) { return false }
  const ty = loopValTyOf(ix)
  ty >= 0 && tyBearsNull(ty)
}

// `(loop) ?? d` at `q`, its loop already rewritten, becomes the if-expression with `$lv ?? d` as
// its value: an arm's own binding has no rep until the arm lowers, so a `??` over the whole `if`
// found none, where one over the binding reads it as any local (D3370).
function lvCoalesceIntoArm(q: i32) {
  const c = nodeAt(q)
  if c is BinExpr {
    const s = nodeAt(unwrapParen(c.binLeft))
    if s is IfStmt {
      const tb = nodeAt(s.ifThen)
      if tb is Block {
        const st = tb.blkStmts
        if st.length == 0 { return 0 }
        const ty = nodeTyIxOf(q)
        const co = mkBinary("??", st[st.length - 1], c.binRight, c.pos)
        nodeTyRecord(co, ty)
        st[st.length - 1] = co
        nodeTyRecord(s.ifThen, ty)
        const w: Node = {
          ifCond: s.ifCond,
          ifThen: s.ifThen,
          ifElse: s.ifElse,
          pos: s.pos,
        }
        arenaSetNode(q, w)
        nodeTyRecord(q, ty)
        valueIfAdd(q)
      }
    }
  }
  0
}

// Rewrites the loop at `x`, whose used value has type `ty`, in place into the if-expression,
// and returns the loop's new node, or -1 when it failed.
function lvRewriteAt(x: i32, ty: i32, atStmt: boolean): i32 {
  const loop = nodeAt(x)
  const pos = loop.pos
  const name = "$lv" + i32ToStr(x)
  const nullable = tyBearsNull(ty)
  // A generic body's value names its type parameters, which each instance re-resolves.
  const spell = lvSpellOf(ty)
  if spell == "" {
    emitFailAt("emitProgram: a loop value's type has no spelling", x)
    return -1
  }
  if loop is WhileStmt && lvBlockIsOwnValue(x, ty) {
    lvTailBreaks(loop.whileBody, loop.whileLabel, ty, true)
    lvIfAt(x, loop.whileBody, ty, atStmt)
    return x
  }
  const label = lvLabelOf(x)
  const body = lvBodyOf(x)
  // A choice among functions of an open signature carries the index of the one chosen.
  const fns = lvOpenFnChoice(x, ty)
  let cty = ty
  if fns.length > 0 { cty = TY_I32 }
  // The loop moves to a fresh node, and the if-expression takes its place.
  const y = addNode(loop)
  identFrom(y, x)
  if x < nodeToks.length && y < nodeToks.length { nodeToks[y] = nodeToks[x] }
  let init = -1
  let seeded = false
  if nullable {
    init = mkNull("null", pos)
    nodeTyRecord(init, lvTyNull())
    recordRepTyAdopt(init, ty, 6)
  } else {
    // A wide scalar binding declares with a zero; the frame's value overwrites it before any read.
    const prim = tyPrimNameOf(cty)
    if prim != null {
      if prim == "f64" || prim == "f32" { init = mkNumTyped("0.0", pos, cty) }
      if prim == "i64" { init = mkNumTyped("0", pos, cty) }
    }
    if init < 0 && fns.length == 0 {
      const sr = lvOpenFnSeedRead(x, ty)
      if sr >= 0 { init = drwRecvClone(sr) }
      seeded = init >= 0
    }
  }
  // A spelling naming a type parameter is resolved from its name, as each instance's own is.
  let annTy = cty
  if tyHasTyVar(cty) { annTy = -1 }
  let spellC = spell
  if fns.length > 0 { spellC = lvSpellOf(cty) }
  let tr = -1
  if !seeded {
    tr = synthTypeRefTy(spellC, pos, annTy)
    if annTy != cty { monoAnnOpenTyNote(tr, cty) }
  }
  // The carrier is typed as the checker joined the exits (`lpPopResult`), or as the index a
  // choice among functions stores.
  const decl = mkLet("let", name, tr, init, pos)
  nodeTyRecord(decl, cty)
  if loop is WhileStmt {
    if !nullable { loop.whileLv = decl }
    if loop.whileBlk == 1 {
      lvRewriteTail(body, loopValTailOf(x), name, decl, cty)
    }
  }
  lvRewriteBreaks(body, label, name, decl, cty, 0, false, [])
  lvChoiceIndex = Map()
  const thenSt: i32[] = []
  thenSt.push(decl)
  thenSt.push(y)
  if fns.length > 0 {
    thenSt.push(lvChoiceOf(fns, name, decl, ty, pos))
  } else {
    const rd = mkIdent(name, pos)
    identFromDecl(rd, decl)
    nodeTyRecord(rd, ty)
    thenSt.push(rd)
  }
  const thenB = mkBlock(thenSt, pos)
  lvIfAt(x, thenB, ty, atStmt)
  y
}

// Each exit value `lvOpenFnChoice` moved into the choice, to the index `lvAssign` stores instead.
let lvChoiceIndex: {[i32]: i32} = Map()

// The body of the loop or labelled block at `x`, or -1 for any other node.
function lvBodyOf(x: i32): i32 {
  const n = nodeAt(x)
  if n is WhileStmt { return n.whileBody }
  if n is ForRange { return n.frBody }
  if n is ForIn { return n.fiBody }
  lvNoBody(x)
}

// Every other kind has no body a `break` leaves.
function lvNoBody(_ix: i32): i32 { -1 }

// `lvOpenFnExits` for the loop at `x`, noting each exit to store its index, so the carrier is an
// `i32`; the functions, the first exit naming each moved into the choice.
function lvOpenFnChoice(x: i32, ty: i32): i32[] {
  lvChoiceIndex = Map()
  const vals: i32[] = []
  const idx: i32[] = []
  const fns = lvOpenFnExits(x, ty, vals, idx)
  let i = 0
  while i < vals.length && fns.length > 0 {
    const num = mkNumTyped(i32ToStr(idx[i]), nodeAt(vals[i]).pos, TY_I32)
    lvChoiceIndex[vals[i]] = num
    i = i + 1
  }
  fns
}

// For the loop at `x` whose non-null value of type `ty` is a function of an open signature that
// every exit hands over as a function declared outside it, or inside it reading nothing else it
// declares (D12841): those functions, each exit's value
// pushed onto `vals` and its function's position among them onto `idx` (D7080). Else empty.
function lvOpenFnExits(x: i32, ty: i32, vals: i32[], idx: i32[]): i32[] {
  const none: i32[] = []
  const body = lvBodyOf(x)
  if ty < 0 || body < 0 || tyBearsNull(ty) || !tyHasTyVar(ty) { return none }
  if !(tyAt(ty) is TyFunc) { return none }
  lvRewriteBreaks(body, lvLabelOf(x), "", -1, ty, 0, false, vals)
  const n = nodeAt(x)
  if n is WhileStmt && n.whileBlk == 1 {
    const tail = loopValTailOf(x)
    if tail < 0 { return none }
    vals.push(tail)
  }
  if vals.length == 0 { return none }
  const fns: i32[] = []
  for v in vals {
    const u = unwrapParen(v)
    if u < 0 || !(nodeAt(u) is Ident) { return none }
    const d = identDeclOf(u)
    if d < 0 || d >= P.nodes.length || !(nodeAt(d) is FuncDecl) { return none }
    if nodeContains(body, d) && lvReadsScopeLocal(d, body, d) { return none }
    let k = 0
    while k < fns.length && identDeclOf(fns[k]) != d { k = k + 1 }
    if k == fns.length { fns.push(u) }
    idx.push(k)
  }
  fns
}

// For the loop at `x` whose value of type `ty` is a function of an open signature, the exit whose
// read seeds the carrier, an un-annotated `let` as a written `let c = f` is (D13082): a function
// some exit hands over, declared ahead of the loop and outside it. Every exit stores into the
// carrier before it is read. -1 when no exit names such a function.
function lvOpenFnSeedRead(x: i32, ty: i32): i32 {
  if x < 0 || x >= P.nodes.length { return -1 }
  const body = lvBodyOf(x)
  if ty < 0 || body < 0 || !tyHasTyVar(ty) || !(tyAt(ty) is TyFunc) {
    return -1
  }
  const vals: i32[] = []
  lvRewriteBreaks(body, lvLabelOf(x), "", -1, ty, 0, false, vals)
  const n = nodeAt(x)
  if n is WhileStmt && n.whileBlk == 1 { vals.push(loopValTailOf(x)) }
  for v in vals {
    let u = -1
    if v >= 0 { u = unwrapParen(v) }
    if u >= 0 && nodeAt(u) is Ident {
      const d = identDeclOf(u)
      if (
        d >= 0
        && d < P.nodes.length
        && lvSeedableDecl(d)
        && !nodeContains(body, d)
        && nodeAt(d).pos < n.pos
      ) {
        return u
      }
    }
  }
  -1
}

// Whether declaration `d` names one function for as long as it is in scope: a function
// declaration or a `const`.
function lvSeedableDecl(d: i32): boolean {
  const dn = nodeAt(d)
  dn is FuncDecl || (dn is LetDecl && dn.letKw == "const")
}

// Whether a read under `ix` names a binding declared inside `scope` but outside function `fn`,
// or one with no recorded declaration: `fn` holds a value only that scope can rebuild (D12841).
function lvReadsScopeLocal(ix: i32, scope: i32, fn: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  if nodeAt(ix) is Ident {
    const d = identDeclOf(ix)
    if d == -1 { return true }
    return d >= 0 && nodeContains(scope, d) && !nodeContains(fn, d)
  }
  for k in nodeChildren(ix) {
    if lvReadsScopeLocal(k, scope, fn) { return true }
  }
  false
}

// The value `if $lv == 0 { f0 } else if … else { fN }` of type `ty`, choosing among `fns` by
// the index held in the carrier `name` that `decl` declares.
function lvChoiceOf(
  fns: i32[],
  name: string,
  decl: i32,
  ty: i32,
  pos: i32,
): i32 {
  let k = fns.length - 1
  let acc = fns[k]
  while k > 0 {
    k = k - 1
    const rd = mkIdent(name, pos)
    identFromDecl(rd, decl)
    nodeTyRecord(rd, TY_I32)
    const num = mkNumTyped(i32ToStr(k), pos, TY_I32)
    const cond = mkBinary("==", rd, num, pos)
    nodeTyRecord(cond, lvTyBool())
    let els = acc
    if !(nodeAt(acc) is IfStmt) { els = lvChoiceArm(acc, ty, pos) }
    const w = mkIf(cond, lvChoiceArm(fns[k], ty, pos), els, pos)
    nodeTyRecord(w, ty)
    valueIfAdd(w)
    acc = w
  }
  acc
}

// One arm `{ f }` of a choice, typed `ty`.
function lvChoiceArm(f: i32, ty: i32, pos: i32): i32 {
  const st: i32[] = [f]
  const b = mkBlock(st, pos)
  nodeTyRecord(b, ty)
  b
}

// Whether node `x` is a labelled block whose value, of type `ty`, holds a function of an open
// signature, and every `break` leaving it ends a branch its value takes: it is its own value,
// since a carrier's annotation could not spell that signature (D6990, D7010).
function lvBlockIsOwnValue(x: i32, ty: i32): boolean {
  if x < 0 || x >= P.nodes.length || ty < 0 { return false }
  const n = nodeAt(x)
  if !(n is WhileStmt) || n.whileBlk != 1 { return false }
  if !tyHasTyVar(ty) || !tyMayHoldFn(ty, 0) { return false }
  const all = lvRewriteBreaks(
    n.whileBody,
    n.whileLabel,
    "",
    -1,
    ty,
    0,
    false,
    [],
  )
  all == lvTailBreaks(n.whileBody, n.whileLabel, ty, false)
}

// The `break`s leaving the block labelled `label` that end block `b` or, through an `if` ending
// it, an arm; with `strip` each is removed, so its value ends the branch.
function lvTailBreaks(b: i32, label: string, ty: i32, strip: boolean): i32 {
  if b < 0 || b >= P.nodes.length { return 0 }
  const n = nodeAt(b)
  if n is IfStmt {
    if n.ifElse < 0 { return 0 }
    const k = lvTailBreaks(n.ifThen, label, ty, strip)
      + lvTailBreaks(n.ifElse, label, ty, strip)
    if strip && k > 0 {
      nodeTyRecord(b, ty)
      valueIfAdd(b)
    }
    return k
  }
  if !(n is Block) { return 0 }
  lvTailFrom(b, 0, label, ty, strip)
}

// `lvTailBreaks` over block `b`'s statements from `from`. An `if` with no `else` whose arm ends
// in such a `break` guards the rest, which `strip` moves into that `if`'s `else`.
function lvTailFrom(
  b: i32,
  from: i32,
  label: string,
  ty: i32,
  strip: boolean,
): i32 {
  const n = nodeAt(b)
  if !(n is Block) { return 0 }
  const st = n.blkStmts
  let k = st.length
  if k <= from { return 0 }
  let i = from
  while i < k - 1 {
    const s = nodeAt(st[i])
    if (
      s is IfStmt
      && s.ifElse < 0
      && lvTailBreaks(s.ifThen, label, ty, false) > 0
    ) {
      if !strip {
        return lvTailBreaks(s.ifThen, label, ty, false)
          + lvTailFrom(b, i + 1, label, ty, false)
      }
      const rest: i32[] = []
      let j = i + 1
      while j < k {
        rest.push(st[j])
        j = j + 1
      }
      while st.length > i + 1 { st.pop() }
      s.ifElse = mkBlock(rest, s.pos)
      return lvTailFrom(b, i, label, ty, true)
    }
    i = i + 1
  }
  // An arm that exits ends in the `__trap__` `exitArmsEndNever` appended after its `break`.
  const tl = nodeAt(st[k - 1])
  const trapped = k - from > 1
    && tl is Call
    && isIdentNamed(tl.callFn, "__trap__")
    && nodeAt(st[k - 2]) is BreakStmt
  if trapped { k = k - 1 }
  const last = nodeAt(st[k - 1])
  if last is BreakStmt {
    if (
      k - from < 2
      || last.brkHasVal != 1
      || !lvLeaves(last.brkLabel, label, 0, false)
    ) {
      return 0
    }
    if strip {
      if trapped { st.pop() }
      st.pop()
      nodeTyRecord(b, ty)
    }
    return 1
  }
  const r = lvTailBreaks(st[k - 1], label, ty, strip)
  if strip && r > 0 { nodeTyRecord(b, ty) }
  r
}

// Writes at `x` the if-expression `if true { thenB } else { __trap__() }` of type `ty`, in a
// value position unless `atStmt`.
function lvIfAt(x: i32, thenB: i32, ty: i32, atStmt: boolean) {
  const pos = nodeAt(x).pos
  nodeTyRecord(thenB, ty)
  const trapFn = mkIdent("__trap__", pos)
  identFromDecl(trapFn, IDENT_BUILTIN)
  const trap = mkCall(trapFn, [], pos)
  nodeTyRecord(trap, lvTyNever())
  markCallNever(trap)
  const elseSt: i32[] = []
  elseSt.push(trap)
  const elseB = mkBlock(elseSt, pos)
  const cond = mkBool(1, -1)
  nodeTyRecord(cond, lvTyBool())
  const w: Node = { ifCond: cond, ifThen: thenB, ifElse: elseB, pos: pos }
  arenaSetNode(x, w)
  nodeTyRecord(x, ty)
  if !atStmt { valueIfAdd(x) }
  0
}

// The annotation spelling of type `ty` for a synthesized binding, or "" when it has none: a
// type parameter's by name, and a literal union's by its members, since its emit name is the
// softened `string`.
function lvSpellOf(ty: i32): string {
  let spell = tyToEmitName(ty)
  if spell == "" && tyHasTyVar(ty) { spell = lvSpaceless(tyToStr(ty)) }
  if tyIsLitUnion(ty) || tyIsLitUnion(nonNullTy(ty)) { spell = tyToStr(ty) }
  spell
}

// `s` without its spaces: the emitter's annotation spellings are spaceless (`T|null`).
function lvSpaceless(s: string): string {
  let out = ""
  let i = 0
  while i < s.length {
    if s[i] != 32 { out = out + s.slice(i, i + 1) }
    i = i + 1
  }
  out
}

// Ends each value-`if` arm block that always exits with `__trap__()`, after the exit: the
// statements run as the arm's prelude and the dead `never` value meets any blocktype (D3222).
function exitArmsEndNever() {
  exitFirstLetsAnnotate()
  let i = 0
  while i < exitArmCount() {
    const blk = exitArmBlockAt(i)
    if blk < 0 || blk >= P.nodes.length { return 0 }
    const b = nodeAt(blk)
    if b is Block {
      const trapFn = mkIdent("__trap__", b.pos)
      identFromDecl(trapFn, IDENT_BUILTIN)
      const trap = mkCall(trapFn, [], b.pos)
      nodeTyRecord(trap, lvTyNever())
      markCallNever(trap)
      b.blkStmts.push(trap)
    }
    i = i + 1
  }
  0
}

// Annotates each un-annotated binding whose initializer's first arm always exits with the type
// the checker gave it, so the emitter classifies the binding by the arm that has a value. A
// `null` value arm makes the binding a null hole, typed by what later writes filled it with; a
// hole nothing filled is left to the rep a bare `null` binding takes (D3355).
function exitFirstLetsAnnotate() {
  let i = 0
  while i < exitFirstLetCount() {
    const li = exitFirstLetAt(i)
    if li >= 0 && li < P.nodes.length {
      const d = nodeAt(li)
      if d is LetDecl {
        let ty = nodeTyIxOf(d.letInit)
        const lx = unwrapParen(d.letInit)
        const lty = loopValTyOf(lx)
        if lvBlockIsOwnValue(lx, lty) { ty = -1 }
        // A choice among open functions resolves at each call, so the binding keeps no type.
        if lvOpenFnExits(lx, lty, [], []).length > 0 { ty = -1 }
        if lvOpenFnSeedRead(lx, lty) >= 0 { ty = -1 }
        if letNullHoleUnfilled(li) { ty = -1 }
        const filled = letNullHoleFilledTy(li)
        if filled >= 0 { ty = filled }
        let spell = ""
        if ty >= 0 { spell = lvSpellOf(ty) }
        if d.letType < 0 && spell != "" {
          let annTy = ty
          if tyHasTyVar(ty) { annTy = -1 }
          d.letType = synthTypeRefTy(spell, -1, annTy)
          if annTy != ty { monoAnnOpenTyNote(d.letType, ty) }
        }
      }
    }
    i = i + 1
  }
  0
}

// `name = v` for the value `v` a loop exit hands over, typed as the checker typed `v`; `decl`
// declares `name`.
function lvAssign(name: string, decl: i32, v0: i32, ty: i32): i32 {
  const v = lvChoiceIndex[v0] ?? v0
  // An inner loop value rewritten as a statement is a value from here on, so the collect pass
  // must walk its arms for their locals.
  if v >= 0 && nodeAt(v) is IfStmt { valueIfAdd(v) }
  const t = mkIdent(name, -1)
  identFromDecl(t, decl)
  nodeTyRecord(t, ty)
  const a = mkBinary("=", t, v, -1)
  nodeTyCarry(a, v)
  a
}

// A labelled block's value tail `tail`, the last statement of its body `body`, becomes `name = tail`.
function lvRewriteTail(body: i32, tail: i32, name: string, decl: i32, ty: i32) {
  if tail < 0 { return 0 }
  const b = nodeAt(body)
  if b is Block {
    const st = b.blkStmts
    if st.length > 0 && st[st.length - 1] == tail {
      st[st.length - 1] = lvAssign(name, decl, tail, ty)
    }
  }
  0
}

// Rewrites each `break v` under `ix` that leaves the loop labelled `label` (`depth` 0 while no
// loop or block lies between them) so its value statement stores into `name`, and counts them;
// `name` "" only counts, pushing each value onto `vals`. A labelled `break` leaves it only while
// no nearer loop or block takes the same label (`shadow`).
function lvRewriteBreaks(
  root: i32,
  label: string,
  name: string,
  decl: i32,
  ty: i32,
  depth0: i32,
  shadow0: boolean,
  vals: i32[],
) {
  const todo: i32[] = [root]
  const todoDepth: i32[] = [depth0]
  const todoShadow: boolean[] = [shadow0]
  let found = 0
  while todo.length > 0 {
    const ix = todo.pop() ?? -1
    const depth = todoDepth.pop() ?? 0
    const shadow = todoShadow.pop() ?? false
    if ix >= 0 && ix < P.nodes.length && !(nodeAt(ix) is FuncDecl) {
      found = found
        + lvRewriteBlockBreaks(
        ix,
        label,
        name,
        decl,
        ty,
        depth,
        shadow,
        vals,
      )
      let d = depth
      let sh = shadow
      const inner = lvLabelOf(ix)
      if inner != LV_NOT_A_LOOP {
        d = depth + 1
        if label != "" && inner == label { sh = true }
      }
      const kids = nodeChildren(ix)
      let i = 0
      while i < kids.length {
        todo.push(kids[i])
        todoDepth.push(d)
        todoShadow.push(sh)
        i = i + 1
      }
    }
  }
  found
}

// What `lvLabelOf` answers for a node no `break` can leave: `%` spells no label.
const LV_NOT_A_LOOP = "%"

// The label of the loop or labelled block at `ix` ("" for none), else `lvNotALoop`'s answer.
function lvLabelOf(ix: i32): string {
  const n = nodeAt(ix)
  if n is WhileStmt { return n.whileLabel }
  if n is ForRange { return n.frLabel }
  if n is ForIn { return n.fiLabel }
  lvNotALoop(ix)
}

// Every other kind: an expression, a declaration or a statement no `break` leaves.
function lvNotALoop(_ix: i32): string { LV_NOT_A_LOOP }

// `lvRewriteBreaks` for the statement list of one block `ix`, `depth` loops inside the target;
// the number of `break`s it found.
function lvRewriteBlockBreaks(
  ix: i32,
  label: string,
  name: string,
  decl: i32,
  ty: i32,
  depth: i32,
  shadow: boolean,
  vals: i32[],
) {
  const n = nodeAt(ix)
  let found = 0
  if n is Block {
    const st = n.blkStmts
    let j = 1
    while j < st.length {
      if st[j] >= 0 && st[j] < P.nodes.length {
        const b = nodeAt(st[j])
        if b is BreakStmt {
          if b.brkHasVal == 1 && lvLeaves(b.brkLabel, label, depth, shadow) {
            if name != "" {
              st[j - 1] = lvAssign(name, decl, st[j - 1], ty)
            } else {
              vals.push(st[j - 1])
            }
            found = found + 1
          }
        }
      }
      j = j + 1
    }
  }
  found
}

// Whether a `break` labelled `brk` leaves the loop labelled `label` from `depth` loops inside it.
function lvLeaves(
  brk: string,
  label: string,
  depth: i32,
  shadow: boolean,
): boolean {
  if brk == "" { return depth == 0 }
  brk == label && !shadow
}

// ── nullable scalar locals (SP-046) ────────────────────────────────────────────────────────

// A function-local `const g = e` of type `S | null`, `S` a wide numeric scalar, whose every use
// is a null test, a narrowed read or `g ?? d`, becomes `let $np: boolean = true` and
// `const $nv: S = e ?? (if true { $np = false  0 } else { 0 })`: the fused `??` reads the
// value without a box. Any other use, a capture or a shadowing name keeps the boxed binding.
export function nulScalarSplit(rootIx: i32) {
  const todo: i32[] = [rootIx]
  const todoMode: i32[] = [0]
  const blocks: i32[] = []
  const lets: i32[] = []
  while todo.length > 0 {
    const ix = todo.pop() ?? -1
    let mode = todoMode.pop() ?? 0
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if n is FuncDecl {
        if n.fnTyParams.length > 0 || mode == 2 { mode = 2 } else { mode = 1 }
      }
      if n is Block {
        if mode == 1 {
          for s in n.blkStmts {
            if nssCandidate(s) {
              blocks.push(ix)
              lets.push(s)
            }
          }
        }
      }
      const nk = nodeChildrenPush(ix, todo)
      let j = 0
      while j < nk {
        todoMode.push(mode)
        j = j + 1
      }
    }
  }
  let i = 0
  while i < lets.length {
    nssTry(blocks[i], lets[i])
    i = i + 1
  }
  if lets.length > 0 {
    capMemoNoteEdit()
    plCacheBust()
  }
  0
}

// The scalar `S` of a `const` whose initializer is typed `S | null`, or -1.
function nssScalarOf(letIx: i32): i32 {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letKw != "const" || d.letInit < 0 { return -1 }
    const t = nodeTyIxOf(d.letInit)
    if t < 0 { return -1 }
    const s = nonNullTy(t)
    if s == t { return -1 }
    const prim = tyPrimNameOf(s)
    if prim == "i32" || prim == "i64" || prim == "f64" || prim == "f32" {
      if nssFusedInit(d.letInit) { return s }
    }
  }
  -1
}

// True when `e ?? d` over the initializer `ix` is a fused read that makes no box: a map read
// (`m[k]`, `m.get(k)`), a scalar list's `.get(i)` or `.pop()`. Any other
// producer already hands over a box, and splitting it only hides the box from the optimizer.
function nssFusedInit(ix: i32): boolean {
  const e = nodeAt(unwrapParen(ix))
  if e is Index { return tyIsMap(nodeTyIxOf(e.idxArr)) }
  if e is Call {
    if e.callFn < 0 { return nssBoxedProducer(ix) }
    const callee = nodeAt(e.callFn)
    if callee is Member {
      const rt = nodeTyIxOf(callee.memObj)
      if callee.memProp == "get" && e.callArgs.length == 1 {
        return tyIsMap(rt) || tyArrayElemIx(rt) >= 0
      }
      if callee.memProp == "pop" && e.callArgs.length == 0 {
        return tyArrayElemIx(rt) >= 0
      }
    }
  }
  nssBoxedProducer(ix)
}

// Every other initializer, a call returning `S | null` among them, is a producer whose value
// is already a box when it arrives, so it is never split.
function nssBoxedProducer(_ix: i32): boolean { false }

function nssCandidate(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  nssScalarOf(ix) >= 0
}

// Whether node `ix` is a read of the `let` at `letIx`.
function nssReadOf(ix: i32, letIx: i32): boolean {
  if ix < 0 || ix >= P.nodes.length || !(nodeAt(ix) is Ident) { return false }
  identDeclOf(ix) == letIx
}

// Classifies every use of the `const` at `letIx`, the statement of block `blk`, and rewrites
// them and the binding when all qualify.
function nssTry(blk: i32, letIx: i32) {
  const b = nodeAt(blk)
  const d = nodeAt(letIx)
  if b is Block {
    if d is LetDecl {
      const s = nssScalarOf(letIx)
      const t = nodeTyIxOf(d.letInit)
      const st = b.blkStmts
      let at = -1
      let i = 0
      while i < st.length {
        if st[i] == letIx { at = i }
        i = i + 1
      }
      if at < 0 { return 0 }
      // The uses, by kind: a test yielding presence, one yielding absence, a read, a `??`.
      const pres: i32[] = []
      const abs: i32[] = []
      const reads: i32[] = []
      const coals: i32[] = []
      const todo: i32[] = []
      const inFn: boolean[] = []
      let j = st.length - 1
      while j > at {
        todo.push(st[j])
        inFn.push(false)
        j = j - 1
      }
      while todo.length > 0 {
        const ix = todo.pop() ?? -1
        const fn = inFn.pop() ?? false
        if ix >= 0 && ix < P.nodes.length {
          const n = nodeAt(ix)
          // The checker desugars a `match` before this pass, so one here is not expected.
          if n is MatchExpr { return 0 }
          let kids = true
          if n is Ident {
            if identDeclOf(ix) == letIx {
              if fn || !tyEq(nodeTyIxOf(ix), s) { return 0 }
              reads.push(ix)
            }
          } else if n is BinExpr {
            const op = n.binOp
            if op == "==" || op == "!=" {
              let operand = -1
              if (
                nssReadOf(n.binLeft, letIx)
                && nodeAt(n.binRight) is NullLit
              ) {
                operand = n.binLeft
              }
              if (
                nssReadOf(n.binRight, letIx)
                && nodeAt(n.binLeft) is NullLit
              ) {
                operand = n.binRight
              }
              if operand >= 0 {
                if fn || !tyEq(nodeTyIxOf(operand), t) { return 0 }
                if op == "==" { abs.push(ix) } else { pres.push(ix) }
                kids = false
              }
            } else if op == "??" && nssReadOf(n.binLeft, letIx) {
              if fn || !tyEq(nodeTyIxOf(n.binLeft), t) { return 0 }
              coals.push(ix)
              todo.push(n.binRight)
              inFn.push(fn)
              kids = false
            }
          } else if n is IsExpr {
            if nssReadOf(n.isObj, letIx) {
              if fn || !tyEq(nodeTyIxOf(n.isObj), t) { return 0 }
              if n.isVariant == "null" { abs.push(ix) }
              else if n.isVariant == tyToStr(s) { pres.push(ix) }
              else { return 0 }
              kids = false
            }
          }
          if kids {
            const inner = fn || n is FuncDecl
            for k in nodeChildren(ix) {
              todo.push(k)
              inFn.push(inner)
            }
          }
        }
      }
      nssRewrite(b, at, d, s, pres, abs, reads, coals)
    }
  }
  0
}

// A synthesized type annotation naming arena type `ty`, recorded against that type.
function synthTypeRefOfTy(ty: i32, pos: i32) {
  synthTypeRefTy(tyToEmitName(ty), pos, ty)
}

// Applies `nssTry`'s verdict: the two bindings replace the `const` at `st[at]`, and each use
// is overwritten in place with its read of them.
function nssRewrite(
  b: Block,
  at: i32,
  d: LetDecl,
  s: i32,
  pres: i32[],
  abs: i32[],
  reads: i32[],
  coals: i32[],
) {
  const pos = d.pos
  const np = "$np" + i32ToStr(b.blkStmts[at])
  const nv = "$nv" + i32ToStr(b.blkStmts[at])
  const tb = lvTyBool()
  const init = mkBool(1, pos)
  nodeTyRecord(init, tb)
  const npDecl = mkLet("let", np, synthTypeRefTy("boolean", pos, tb), init, pos)
  nodeTyRecord(npDecl, tb)
  const npT = mkIdent(np, pos)
  identFromDecl(npT, npDecl)
  nodeTyRecord(npT, tb)
  const clr = mkBool(0, pos)
  nodeTyRecord(clr, tb)
  const asg = mkBinary("=", npT, clr, pos)
  nodeTyCarry(asg, clr)
  const missSt: i32[] = [asg, nssZero(s, pos)]
  const miss = mkBlock(missSt, pos)
  nodeTyRecord(miss, s)
  const otherSt: i32[] = [nssZero(s, pos)]
  const other = mkBlock(otherSt, pos)
  nodeTyRecord(other, s)
  const cond = mkBool(1, -1)
  nodeTyRecord(cond, tb)
  const def = mkIf(cond, miss, other, pos)
  nodeTyRecord(def, s)
  valueIfAdd(def)
  const co = mkBinary("??", d.letInit, def, pos)
  nodeTyRecord(co, s)
  const nvDecl = mkLet("const", nv, synthTypeRefOfTy(s, pos), co, pos)
  nodeTyRecord(nvDecl, s)
  const old = b.blkStmts
  const st: i32[] = []
  let i = 0
  while i < old.length {
    if i == at {
      st.push(npDecl)
      st.push(nvDecl)
    } else {
      st.push(old[i])
    }
    i = i + 1
  }
  b.blkStmts = st
  for ix in pres { nssSetName(ix, np, tb, npDecl) }
  for ix in abs {
    const id = mkIdent(np, -1)
    identFromDecl(id, npDecl)
    nodeTyRecord(id, tb)
    const un: Node = { unOp: "!", unArg: id, pos: nodeAt(ix).pos }
    arenaSetNode(ix, un)
    nodeTyRecord(ix, tb)
  }
  for ix in reads { nssSetName(ix, nv, s, nvDecl) }
  for ix in coals {
    const c = nodeAt(ix)
    if c is BinExpr {
      const ty = nodeTyIxOf(ix)
      const cp = mkIdent(np, -1)
      identFromDecl(cp, npDecl)
      nodeTyRecord(cp, tb)
      const cv = mkIdent(nv, -1)
      identFromDecl(cv, nvDecl)
      nodeTyRecord(cv, s)
      const thenSt: i32[] = [cv]
      const thenB = mkBlock(thenSt, -1)
      nodeTyRecord(thenB, ty)
      const elseSt: i32[] = [c.binRight]
      const elseB = mkBlock(elseSt, -1)
      nodeTyRecord(elseB, ty)
      const w: Node = { ifCond: cp, ifThen: thenB, ifElse: elseB, pos: c.pos }
      arenaSetNode(ix, w)
      nodeTyRecord(ix, ty)
      valueIfAdd(ix)
    }
  }
  0
}

// Overwrites node `ix` with a read of the name `name` declared at `decl`, typed `ty`.
function nssSetName(ix: i32, name: string, ty: i32, decl: i32) {
  const w: Node = { identName: name, pos: nodeAt(ix).pos }
  arenaSetNode(ix, w)
  sidNoteNodeName(ix, decl)
  nodeTyRecord(ix, ty)
  0
}

// A zero of scalar `s`, the value the miss arm yields and nothing reads.
function nssZero(s: i32, pos: i32): i32 {
  const prim = tyPrimNameOf(s)
  if prim == "f64" || prim == "f32" { return mkNumTyped("0.0", pos, s) }
  mkNumTyped("0", pos, s)
}
// ── the build-decided `if` ───────────────────────────────────────────────────

// Whether the statement at `ix` is an else-less `if __memory_shared__() { … }` whose call the
// checker resolved to the intrinsic (`memSharedCalls`), the one condition the build decides.
function isMemSharedIf(ix: i32): boolean {
  if ix < 0 { return false }
  const s = nodeAt(ix)
  if s is IfStmt {
    if s.ifElse >= 0 { return false }
    let i = 0
    while i < memSharedCalls.length {
      if memSharedCalls[i] == s.ifCond { return true }
      i = i + 1
    }
  }
  false
}

// Folds each `isMemSharedIf` statement before any other pass reads the tree: a shared
// build keeps its body as a bare block, any other build drops the statement, so the
// shared-only code costs a default build no byte (DECISIONS.md, "std:buffer's allocator
// over a shared memory"). The checker has typed both arms. Edits lists in place.
function foldMemSharedList(stmts: i32[]) {
  let r = 0
  let w = 0
  while r < stmts.length {
    const ix = stmts[r]
    if isMemSharedIf(ix) {
      if gSharedMemPages > 0 {
        const s = nodeAt(ix)
        if s is IfStmt { s.ifCond = mkBool(1, s.pos) }
        stmts[w] = ix
        w = w + 1
      }
    } else {
      stmts[w] = ix
      w = w + 1
    }
    r = r + 1
  }
  while stmts.length > w { stmts.pop() }
  0
}

// The pass: every statement list in the arena, so a nested or top-level fold is met too.
export function foldMemShared() {
  // With no resolved `__memory_shared__()` call no statement folds.
  if memSharedCalls.length == 0 { return 0 }
  const n = P.nodes.length
  let i = 0
  while i < n {
    const nd = nodeAt(i)
    if nd is Block { foldMemSharedList(nd.blkStmts) }
    else if nd is Program { foldMemSharedList(nd.progStmts) }
    i = i + 1
  }
  0
}

// ── self-method / operator / index-trap dispatch rewrite ─────────────────────
// The host resolves these in its type-aware parser; the native parser is
// type-free, so the emitter rewrites the arena before monomorphization: UFCS
// (`o.f(args)` → `f(o, args)`), an operator closure field, and a `[]`/`[]=` trap field.

// The `fnStmts` index of a free `self`-function `name` reachable at `argc` total
// params (first param named `self`), or -1 — the host's UFCS reachability rule.
// `argc` is matched against the arity range, not the exact length, since a UFCS
// call takes trailing defaults the same way the direct spelling does.
export function drwSelfFnOf(name: string, argc: i32) {
  const fe = fnIndexOf(name)
  if fe < 0 { return -1 }
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    const ps = fn.fnParams
    if argc > ps.length { return -1 }
    if argc < fnRequiredArity(ps) { return -1 }
    if ps.length > 0 {
      const p0 = nodeAt(ps[0])
      if p0 is Param {
        if p0.parName == "self" { return fe }
      }
    }
  }
  -1
}

// The declaration member call `ix` dispatches to at `argc` total arguments: the method the
// binder recorded for its spelling when that takes `argc`, else -1; -2 when the spelling
// recorded none, which leaves the answer to the module function `drwSelfFnOf` names.
export function drwSelfDeclAt(ix: i32, argc: i32): i32 {
  const d = memberDeclOf(ix)
  if d < 0 { return -2 }
  const f = memberMethodOf(ix)
  if f < 0 { return -1 }
  const ps = fnParamsOfDecl(f)
  if argc > ps.length || argc < fnRequiredArity(ps) { return -1 }
  d
}

// Whether member call `ix` dispatches to a `self`-function named `name` at `argc` arguments.
function drwDispatches(ix: i32, name: string, argc: i32): boolean {
  const d = drwSelfDeclAt(ix, argc)
  if d != -2 { return d >= 0 }
  drwSelfFnOf(name, argc) >= 0
}

// The callee member call `ix` dispatches to: the recorded declaration, else the function `name`.
function drwSelfFnRef(ix: i32, name: string, argc: i32) {
  const d = drwSelfDeclAt(ix, argc)
  if d < 0 { return drwFnRef(name) }
  const id = mkIdent(binderNameAt(d), -1)
  identFromDecl(id, d)
  nodeTyCarry(id, memberMethodOf(ix))
  id
}

// Normalizes a direct call to its callee's full arity, appending the declaration's
// default expressions for the trailing arguments the call omitted — runs before
// monomorphization, so every later pass sees an ordinary full-arity call and no
// new `$fnsig` key is minted. A call through a function value resolves nothing.
export function drwFillDefaults(ix: i32, ctx: i32) {
  const n = nodeAt(ix)
  if n is Call {
    if n.callFn < 0 { return 0 }
    const cf = nodeAt(n.callFn)
    if cf is Ident {
      const fe = fnIndexOfInScopeChainAt(
        sidOfNode(n.callFn),
        cf.identName,
        ctx,
        n.callFn,
      )
      if fe < 0 { return 0 }
      // A call whose callee reads a binding is not the module function's: filling that
      // function's defaults hands the binding an argument it has no parameter for (D1602).
      const cd = identDeclOf(n.callFn)
      if !(cd >= 0 && nodeAt(cd) is FuncDecl) { return 0 }
      const fn = nodeAt(fnStmts[fe])
      if fn is FuncDecl {
        const ps = fn.fnParams
        const args = n.callArgs
        if hasNamedArgs(n.callArgNames) {
          // A named call may skip a middle parameter (`f(1, c: 3)`), found by binding
          // names to slots; the name list is dropped once arguments are in param order.
          const pNames: string[] = []
          let pn = 0
          while pn < ps.length {
            const pnode = nodeAt(ps[pn])
            if pnode is Param { pNames.push(pnode.parName) }
            pn = pn + 1
          }
          if pNames.length != ps.length { return 0 }
          const ordered = orderArgsByParamNames(pNames, args, n.callArgNames)
          if ordered.length != ps.length { return 0 }
          let gap = false
          let gi = 0
          while gi < ordered.length {
            if ordered[gi] < 0 { gap = true }
            gi = gi + 1
          }
          // No gap: leave the call unchanged, so every working named call keeps
          // taking the emitter's own reorder path.
          if !gap { return 0 }
          if fillArgDefaults(ordered, ps, ix) >= 0 { return 0 }
          const noNames: string[] = []
          n.callArgs = ordered
          n.callArgNames = noNames
          return capMemoNoteEdit()
        }
        if args.length >= ps.length { return 0 }
        let i = args.length
        while i < ps.length {
          let d = paramDefaultOf(ps[i])
          if d < 0 { return 0 }
          // `__callsite__` is the one default whose value is the call site, so it
          // takes the per-call node `csPreMintLocs` banked rather than the
          // declaration's own marker — the same substitution the checker made,
          // keyed on the same Call node.
          if paramDefaultIsCallsite(d) { d = callSiteLocOf(ix) }
          if d < 0 { return 0 }
          args.push(d)
          capMemoNoteEdit()
          i = i + 1
        }
      }
    }
  }
  0
}

// Post-order rewrite of the tree at `ix` (inside function `ctx`, -1 = top
// level). Returns the node index to use in `ix`'s place (usually `ix` itself).
// True if `ix` is a map index read (`m[k]`), parens peeled — the shape whose `??` has a
// fused lowering in `emitMapGetOr` and must not be desugared into a re-reading `if`.
function drwIsMapRead(ix: i32) {
  const n = nodeAt(unwrapParen(ix))
  if n is Index { return nodeTyIsMap(n.idxArr) }
  false
}

// Whether `recvIx` is a parameter of the generic `ctx` still typed by a type parameter, so the
// member `recv.prop(…)` names (built-in, field or `self`-function) differs per instance and the
// rewrite leaves the call to `monoPinBinOps` (D2517). An un-annotated parameter counts: it takes
// any type too.
function drwRecvIsTyParam(recvIx: i32, ctx: i32) {
  if ctx < 0 { return false }
  const fn = nodeAt(ctx)
  if fn is FuncDecl {
    const r = nodeAt(unwrapParen(recvIx))
    if r is Ident {
      const ps = fn.fnParams
      let pi = -1
      let piHole = false
      let i = 0
      while i < ps.length {
        const pp = nodeAt(ps[i])
        if pp is Param {
          if pp.parName == r.identName {
            pi = i
            piHole = pp.parType < 0
          }
        }
        i = i + 1
      }
      if pi < 0 { return false }
      if fn.fnTyParams.length == 0 && !piHole { return false }
      if fn.fnName == "" { return false }
      return tyHasTyVar(nodeTyIxOf(recvIx))
    }
  }
  false
}

// Whether the rewrite left member call `callIx` to each instance (`drwRecvIsTyParam`).
export function drwMemberDeferred(callIx: i32) {
  memberCallRungOf(callIx) == MC_RUNG_PER_INSTANCE
}

// A minted callee naming the module function `name`, resolved to its declaration.
function drwFnRef(name: string) {
  const id = mkIdent(name, -1)
  let d = identModuleDeclOf(name)
  if d < 0 { d = fnDeclNamed(name) }
  if d < 0 && externLinkOf(name) >= 0 { d = IDENT_BUILTIN }
  identFromDecl(id, d)
  id
}

// `fnDeclNamed`'s index over the `fnStmts` prefix `fdnLen`: name to its one declaration, or -1
// when several share it. Valid while `fnPosEpochNow()` is what `fdnGenKey` last read.
const fdnGenKey = memoKeyNew(1)
let fdnLen = 0
let fdnDecl: {[string]: i32} = Map()

// The one function declaration `fnStmts` holds under `name`, or -1 when none or several do.
export function fnDeclNamed(name: string) {
  if memoMoved(fdnGenKey, 0, fnPosEpochNow()) || fdnLen > fnStmts.length {
    fdnLen = 0
    fdnDecl = Map()
  }
  while fdnLen < fnStmts.length {
    const d = fnStmts[fdnLen]
    const f = nodeAt(d)
    if f is FuncDecl {
      if fdnDecl.has(f.fnName) {
        fdnDecl[f.fnName] = -1
      } else {
        fdnDecl[f.fnName] = d
      }
    }
    fdnLen = fdnLen + 1
  }
  fdnDecl[name] ?? -1
}

// A fresh node denoting the same place as `ix`, so the guard's null test and the call never
// share one arena index. Only the place forms `exprReReadable` admits are minted; anything
// else is handed back unchanged, its caller having already declined (D1814).
function drwRecvClone(ix: i32) {
  const n = nodeAt(ix)
  if n is Paren { return drwRecvClone(n.parInner) }
  if n is Ident {
    const cId = mkIdent(n.identName, n.pos)
    identFrom(cId, ix)
    nodeTyCarry(cId, ix)
    return cId
  }
  if n is Member {
    const cMem = mkMember(n.memObj, n.memProp, n.pos)
    nodeTyCarry(cMem, ix)
    return cMem
  }
  if n is Index {
    const cIdx = mkIndex(n.idxArr, n.idxIndex, n.pos)
    nodeTyCarry(cIdx, ix)
    return cIdx
  }
  drwRecvNotAPlace(ix)
}

// Every `Node` kind `drwRecvClone` does not mint, as one answer: a value rather than a place,
// so there is nothing to re-read and its caller declined the guard before asking.
function drwRecvNotAPlace(ix: i32) { ix }

// Wraps a rewritten optional call in the one guard its `?.` asks for — `if recv != null
// { call } else { null }` — so the call itself lowers through the path it would have had
// without the `?.`. `recvIx` is -1 for every other call, which passes through untouched
// (D1814).
function drwOptGuard(
  res: i32,
  ix: i32,
  recvIx: i32,
  pos: i32,
  atStmt: boolean,
) {
  if recvIx < 0 { return res }
  const gThen: i32[] = []
  gThen.push(res)
  // A `void` call has no value to fold a null through, and neither has one whose value the
  // statement discards — a bare `null` there reaches `emitNullLitNode` with no destination.
  let gElse = -1
  if !atStmt && !nodeTyExcludesNull(ix) {
    const gElseStmts: i32[] = []
    gElseStmts.push(mkNull("null", pos))
    gElse = mkBlock(gElseStmts, pos)
  }
  const gIf = mkIf(
    mkBinary("!=", drwRecvClone(recvIx), mkNull("null", pos), pos),
    mkBlock(gThen, pos),
    gElse,
    pos,
  )
  // D969 — the `| null` belongs to the `if` from here on, and the call node keeps the
  // return the guarded arm actually leaves on the stack.
  nodeTyCarry(gIf, ix)
  optCallRestamp(ix)
  gIf
}

// True while `drwWalk` is entering a node in STATEMENT position — one whose value is
// discarded. Read and cleared at the walk's top, so the statement itself sees it and no
// sub-expression inherits it. A block's LAST statement is deliberately not marked: it may be
// the block's value.
let drwAtStmt = false

// A user operator's call `call`, standing for the operator expression `opIx`: it carries the
// checked type, so a reader of the rewritten node (a walk's element, a print) sees the result.
function drwOpCall(call: i32, opIx: i32): i32 {
  nodeTyCarry(call, opIx)
  call
}

// `drwWalk`'s block arm: walks block `n`'s statements in order, splicing each compound place's
// spills in ahead of it.
function drwWalkBlock(n: Block, ctx: i32) {
  const bs = n.blkStmts
  let i2 = 0
  while i2 < bs.length {
    // The spills land ahead of the write and are walked next, as ordinary statements.
    const cpOut: i32[] = []
    if spillCompoundPlace(bs[i2], cpOut, ctx) {
      const cn = cpOut.length
      let cj = bs.length - 1
      while bs.length < cj + 1 + cn { bs.push(-1) }
      while cj >= i2 {
        bs[cj + cn] = bs[cj]
        cj = cj - 1
      }
      cj = 0
      while cj < cn {
        bs[i2 + cj] = cpOut[cj]
        cj = cj + 1
      }
      capMemoNoteEdit()
      plCacheBust()
    }
    drwAtStmt = i2 + 1 < bs.length
    bs[i2] = drwBareBlock(drwWalk(bs[i2], ctx))
    i2 = i2 + 1
  }
}

// `drwWalk`'s `if` arm: walks the condition and branches of the `if` at `ix`, following an
// `else if` chain along its spine, so its depth costs no stack (D1990).
function drwWalkIfChain(ix: i32, ctx: i32) {
  let cur = ix
  while cur >= 0 {
    const c = nodeAt(cur)
    cur = -1
    if c is IfStmt {
      c.ifCond = drwWalk(c.ifCond, ctx)
      c.ifThen = drwWalk(c.ifThen, ctx)
      if c.ifElse >= 0 {
        if nodeAt(c.ifElse) is IfStmt {
          drwAtStmt = false
          cur = c.ifElse
        } else {
          c.ifElse = drwWalk(c.ifElse, ctx)
        }
      }
    }
  }
}

// `drwWalk`'s `?.` read arm for `n` at `ix`: walks the receiver, then answers the plain read
// over a receiver that cannot be null, a record-union field's guarded read, or `ix` itself.
function drwWalkOptMember(ix: i32, n: OptMember, ctx: i32): i32 {
  n.omObj = drwWalk(n.omObj, ctx)
  // A guard over a receiver that cannot be null is the plain read: the null arm is
  // unreachable, and the standalone `?.` lowering has no rep to build for a result the
  // guard never widened. Folded here for the reason `x ?? d` over a non-nullable left
  // operand is (D1815).
  if nodeTyExcludesNull(n.omObj) {
    const omFold = mkMember(n.omObj, n.omProp, n.pos)
    nodeTyCarry(omFold, ix)
    return omFold
  }
  const omTys: i32[] = []
  if recUnionReadTys(n.omObj, n.omProp, nodeTyIxOf(ix), omTys) {
    return recUnionOptRead(ix, n, omTys)
  }
  return ix
}

// The struct row of `recv` where some row carries a field named `name`, else -1: only such a
// row can answer `drwFieldClosure`, and most programs declare no operator field at all.
function drwFieldRowOf(recv: i32, ctx: i32, name: string): i32 {
  if !structFieldNameUsed(name) { return -1 }
  structIndexOfExpr(recv, ctx)
}

// `drwWalk`'s index arm for `n` at `ix`: walks both operands, then answers a free `"[]"`
// operator's call, a `"[]"` closure field's call on a struct receiver, or `ix` itself.
function drwWalkIndex(ix: i32, n: Index, ctx: i32): i32 {
  n.idxArr = drwWalk(n.idxArr, ctx)
  n.idxIndex = drwWalk(n.idxIndex, ctx)
  // A free `"[]"` operator function: a direct call, resolved by the checker from
  // the receiver's type and banked on this node — ahead of the closure-field trap
  // below, mirroring the `a op b` arm's order.
  const rOp = opIdxFnAtNode(ix)
  if rOp != "" {
    const roargs: i32[] = []
    roargs.push(n.idxArr)
    roargs.push(n.idxIndex)
    return drwOpCall(mkCall(drwFnRef(rOp), roargs, -1), ix)
  }
  // The index read trap: a struct receiver carrying a "[]" closure field.
  if drwFieldClosure(drwFieldRowOf(n.idxArr, ctx, "[]"), "[]") {
    const targs: i32[] = []
    targs.push(n.idxIndex)
    return drwOpCall(mkCall(mkMember(n.idxArr, "[]", -1), targs, -1), ix)
  }
  return ix
}

// Every node this returns in place of `ix` is freshly minted, except the `??` fold's left
// operand, which reports itself to the capture memo (D2017).
function drwWalk(ix: i32, ctx: i32) {
  if ix < 0 { return ix }
  const atStmt = drwAtStmt
  drwAtStmt = false
  const n = nodeAt(ix)
  match n {
    Call => {
      const args = n.callArgs
      let i = 0
      while i < args.length {
        args[i] = drwWalk(args[i], ctx)
        i = i + 1
      }
      // `p?.f(args)` — the callee becomes the plain member read, so UFCS, a callable field and
      // every builtin method lower through the path they already have, and `drwOptGuard` moves
      // the whole call into the non-null arm of one guard below.
      let optWasOpt = false
      if n.callFn < 0 { return ix }
      const c0 = nodeAt(n.callFn)
      if c0 is OptMember {
        optWasOpt = true
        n.callFn = mkMember(c0.omObj, c0.omProp, c0.pos)
        arenaNoteRefWrite()
      }
      const callee = nodeAt(n.callFn)
      if callee is Member {
        return drwWalkMemberCall(ix, n, callee, optWasOpt, ctx, atStmt)
      }
      const nfn = drwWalk(n.callFn, ctx)
      if nfn != n.callFn { arenaNoteRefWrite() }
      n.callFn = nfn
      drwFillDefaults(ix, ctx)
      return ix
    }
    Block => {
      drwWalkBlock(n, ctx)
      return ix
    }
    LetDecl => {
      n.letInit = drwWalk(n.letInit, ctx)
      return ix
    }
    IfStmt => {
      drwWalkIfChain(ix, ctx)
      return ix
    }
    WhileStmt => {
      n.whileCond = drwWalk(n.whileCond, ctx)
      n.whileBody = drwWalk(n.whileBody, ctx)
      return ix
    }
    ForRange => {
      n.frFrom = drwWalk(n.frFrom, ctx)
      n.frTo = drwWalk(n.frTo, ctx)
      n.frStep = drwWalk(n.frStep, ctx)
      n.frBody = drwWalk(n.frBody, ctx)
      return ix
    }
    ForIn => {
      n.fiIter = drwWalk(n.fiIter, ctx)
      n.fiBody = drwWalk(n.fiBody, ctx)
      return ix
    }
    RetStmt => {
      n.retArg = drwWalk(n.retArg, ctx)
      return ix
    }
    BinExpr => {
      return drwWalkBin(ix, n, ctx)
    }
    Unary => {
      n.unArg = drwWalk(n.unArg, ctx)
      return ix
    }
    Paren => {
      n.parInner = drwWalk(n.parInner, ctx)
      return ix
    }
    Member => {
      n.memObj = drwWalk(n.memObj, ctx)
      return ix
    }
    OptMember => {
      return drwWalkOptMember(ix, n, ctx)
    }
    Index => {
      return drwWalkIndex(ix, n, ctx)
    }
    IsExpr => {
      n.isObj = drwWalk(n.isObj, ctx)
      return ix
    }
    AsExpr => {
      n.asObj = drwWalk(n.asObj, ctx)
      return ix
    }
    // A spread's source is an operand like any other (D2334).
    Spread => {
      n.spdArg = drwWalk(n.spdArg, ctx)
      return ix
    }
    ArrayLit => {
      const es = n.arrElems
      let i3 = 0
      while i3 < es.length {
        es[i3] = drwWalk(es[i3], ctx)
        i3 = i3 + 1
      }
      return ix
    }
    ObjLit => {
      const fs = n.objFields
      let i4 = 0
      while i4 < fs.length {
        const f = nodeAt(fs[i4])
        if f is FieldInit { f.fiValue = drwWalk(f.fiValue, ctx) }
        i4 = i4 + 1
      }
      return ix
    }
    // every other kind holds no call or operator this pass desugars, and is kept
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | ErrExpr | Param | TypeRef | FuncDecl | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | MatchExpr | ImportDecl | LoopVar => {}
  }
  ix
}

// `drwWalk`'s method-call arm: `n` is the call at `ix` whose callee `callee` is a member read,
// already un-`?.`'d when `optWasOpt`. Walks the receiver, then rewrites a map `get`, a UFCS
// call or the `?.` guard; returns the node that replaces `ix`.
function drwWalkMemberCall(
  ix: i32,
  n: Call,
  callee: Member,
  optWasOpt: boolean,
  ctx: i32,
  atStmt: boolean,
): i32 {
  const args = n.callArgs
  let optRecv = -1
  callee.memObj = drwWalk(callee.memObj, ctx)
  if optWasOpt {
    // A receiver that cannot be null needs no guard; one the lowering cannot read twice
    // keeps the `?.` callee, which `emitCall` refuses by name rather than silently
    // calling through a null.
    if !nodeTyExcludesNull(callee.memObj) {
      if exprReReadable(callee.memObj) {
        optRecv = callee.memObj
      } else {
        n.callFn = mkOptMember(callee.memObj, callee.memProp, false, callee.pos)
        arenaNoteRefWrite()
        return ix
      }
    }
  }
  // D1522 — a map `m.get(k)` is the read `m[k]`, rewritten here so every consumer
  // classifier reads the Index node (it carries the checked type) rather than claiming a
  // box the read never left. Only where the checker took the built-in: a set's is a function.
  if callee.memProp == "get" && memberCallRungOf(ix) != MC_RUNG_SELF_FN {
    let mgRecv = callee.memObj
    if optRecv >= 0 {
      // Under `?.` the read takes a fresh receiver at the map's non-null type, which is what
      // the guard's arm reads it as (D10030).
      const mgTy = nonNullTy(nodeTyIxOf(unwrapParen(optRecv)))
      if tyIsMap(mgTy) { mgRecv = drwNarrowedClone(optRecv, mgTy) }
    }
    if args.length == 1 && nodeTyIsMap(mgRecv) {
      const mgIx = mkIndex(mgRecv, args[0], n.pos)
      nodeTyCarry(mgIx, ix)
      return drwOptGuard(mgIx, ix, optRecv, n.pos, atStmt)
    }
  }
  // UFCS: `o.f(args)`, where `f` is a free function whose first parameter is named
  // `self`, lowers to `f(o, args)` — the receiver's type does not gate it. D1120 — a
  // module merge mangles a free `self`-function (`shout` → `shout$m1`) but leaves the
  // call's property plain, so `ufcsAliasAtSite` maps it per call site, not by name alone.
  const uName = ufcsAliasAtSite(ix, callee.memProp)
  // Precedence, mirroring the host: a real struct field wins as a value access, a
  // callable field wins as a `call_ref` member-call, and only then is UFCS tried.
  // D1070 — asks the receiver's checked type (`tyFieldTyOf`) rather than the emit-side
  // struct row, which answers -1 inside a function body; this can only turn UFCS off.
  const recvFieldTy = tyFieldTyOf(nodeTyIxOf(callee.memObj), callee.memProp)
  const recvHasField = recvFieldTy >= 0
  const si = structIndexOfExpr(callee.memObj, ctx)
  let ufcs = false
  // A call the checker resolved to a built-in method stays one: that is the rung a
  // `self`-function of the same name loses to on this receiver (D2476).
  const builtinRung = memberCallRungOf(ix) == MC_RUNG_BUILTIN
  // And one it resolved to a `self`-function stays one where the struct row has the field
  // but the checked type does not: a `P | null` receiver's row is `P`'s.
  const selfFnRung = memberCallRungOf(ix) == MC_RUNG_SELF_FN
  if si >= 0 && !recvHasField && !builtinRung {
    if sFieldIndex(si, callee.memProp) < 0 || selfFnRung {
      if drwDispatches(ix, uName, args.length + 1) { ufcs = true }
    }
  }
  if si < 0 && !recvHasField && !builtinRung {
    if !exprIsClosure(n.callFn, ctx) {
      if drwDispatches(ix, uName, args.length + 1) {
        // A type-parameter receiver has no struct row yet, so `si < 0` alone cannot
        // mean "no field, so UFCS": each instance answers for itself.
        if drwRecvIsTyParam(callee.memObj, ctx) {
          memberCallRungAdd(ix, MC_RUNG_PER_INSTANCE)
        } else {
          ufcs = true
        }
      }
    }
  }
  if ufcs {
    const recvIx = callee.memObj
    args.push(-1)
    let j = args.length - 1
    while j > 0 {
      args[j] = args[j - 1]
      j = j - 1
    }
    args[0] = recvIx
    // Named-arg parity: the injected receiver is an unnamed slot-0 positional.
    // Only when the call already carries names does the name list need a leading
    // "" — an all-positional call keeps its empty list, so `hasNamedArgs` stays
    // false downstream.
    if hasNamedArgs(n.callArgNames) {
      const nm = n.callArgNames
      nm.push("")
      let k = nm.length - 1
      while k > 0 {
        nm[k] = nm[k - 1]
        k = k - 1
      }
      nm[0] = ""
    }
    const ufcsFn = drwSelfFnRef(ix, uName, args.length)
    noteCallOrigin(ufcsFn, ix)
    n.callFn = ufcsFn
    arenaNoteRefWrite()
  }
  drwFillDefaults(ix, ctx)
  return drwOptGuard(ix, ix, optRecv, n.pos, atStmt)
}

// `drwWalk`'s binary arm: an index write through a `[]=` operator or closure field, the `??`
// folds and desugarings, and a dispatched user operator. Returns the node that replaces `ix`.
function drwWalkBin(ix: i32, n: BinExpr, ctx: i32): i32 {
  // The index write-trap form `o[k] = v` is handled before the general child walk,
  // so the assignment-target Index is not first rewritten into a read trap.
  if n.binOp == "=" {
    const tgt = nodeAt(n.binLeft)
    if tgt is Index {
      tgt.idxArr = drwWalk(tgt.idxArr, ctx)
      tgt.idxIndex = drwWalk(tgt.idxIndex, ctx)
      n.binRight = drwWalk(n.binRight, ctx)
      // A free `"[]="` operator function: the checker resolved it by the receiver's
      // type and banked it on this assignment node, so the rewrite never re-derives
      // the choice.
      const wOp = opIdxFnAtNode(ix)
      if wOp != "" {
        const woargs: i32[] = []
        woargs.push(tgt.idxArr)
        woargs.push(tgt.idxIndex)
        woargs.push(n.binRight)
        return mkCall(drwFnRef(wOp), woargs, -1)
      }
      if drwFieldClosure(drwFieldRowOf(tgt.idxArr, ctx, "[]="), "[]=") {
        const wargs: i32[] = []
        wargs.push(tgt.idxIndex)
        wargs.push(n.binRight)
        return mkCall(mkMember(tgt.idxArr, "[]=", -1), wargs, -1)
      }
      return ix
    }
  }
  // `r?.f ?? d` over a re-readable nullable union of records whose field `f` is never null
  // is the null test choosing between the field read and the default (D5243).
  if n.binOp == "??" {
    const cl = nodeAt(unwrapParen(n.binLeft))
    if cl is OptMember {
      const clTy = nodeTyIxOf(unwrapParen(n.binLeft))
      const clTys: i32[] = []
      if (
        recUnionReadTys(cl.omObj, cl.omProp, clTy, clTys)
        && clTys[2] == 0
        && exprReReadable(unwrapParen(cl.omObj))
      ) {
        const crRecv = drwWalk(cl.omObj, ctx)
        const crIf = recUnionGuard(
          crRecv,
          cl.omProp,
          clTys[0],
          clTys[1],
          drwWalk(n.binRight, ctx),
          n.pos,
        )
        nodeTyCarry(crIf, ix)
        capMemoNoteEdit()
        return crIf
      }
    }
  }
  n.binLeft = drwWalk(n.binLeft, ctx)
  n.binRight = drwWalk(n.binRight, ctx)
  // `x ?? d` over a provably non-nullable lhs is `x`: the default can never be
  // selected, so the coalesce folds away here rather than in `emitCoalesce` — every
  // consumer classifier dispatches on the `??` node and only handles a nullable left
  // operand, so lowering the identity there keeps the wrong type on a non-nullable lhs.
  if n.binOp == "??" {
    // Peeled because parens must not change `??` semantics: a `Paren` banks a copy of
    // its inner's checked type, but a type the checker re-records later (`as?`'s pin)
    // lands on the inner node only. D1371 — without peeling, `(a as? i32) ?? 0` read the
    // stale parenthesized type while the un-parenthesised spelling ran correctly.
    const coalLhs = unwrapParen(n.binLeft)
    if (nodeTyExcludesNull(coalLhs)) {
      capMemoNoteEdit()
      return n.binLeft
    }
    // `x ?? null` is `x` for every `x`: a null left selects a null default. Folded so the
    // read lowers at its own nullable rep instead of through a coalesce whose arms assume
    // the default is the non-null half (D2247).
    if nodeAt(unwrapParen(n.binRight)) is NullLit {
      capMemoNoteEdit()
      return n.binLeft
    }
    // `null ?? d` is `d`, the type the checker gave it (D2261).
    if coalLhs >= 0 && nodeAt(coalLhs) is NullLit {
      capMemoNoteEdit()
      return n.binRight
    }
    // A read of a `{[K]: V}` map with a nullable default is `V | null`, a rep the fused
    // get-with-default builds only for some values, so a re-readable one desugars to the
    // null test, whose join every value rep lowers (D2248). An atom value's read is the `-1`
    // niche, which the `??` lowers directly where that join does not (D7448).
    if coalLhs >= 0 && drwIsMapRead(n.binLeft) && exprReReadable(coalLhs) {
      const mdRead = nodeAt(coalLhs)
      if (
        mdRead is Index
        && nodeTyMapValExcludesNull(mdRead.idxArr)
        && !nodeTyMapValIsLitUnion(mdRead.idxArr)
        && nodeTyIsNullable(unwrapParen(n.binRight))
      ) {
        const mdThen: i32[] = []
        mdThen.push(n.binLeft)
        const mdElse: i32[] = []
        mdElse.push(n.binRight)
        const mdIf = mkIf(
          mkBinary("!=", n.binLeft, mkNull("null", n.pos), n.pos),
          mkBlock(mdThen, n.pos),
          mkBlock(mdElse, n.pos),
          n.pos,
        )
        nodeTyCarry(mdIf, ix)
        return mdIf
      }
    }
    // D962 — `x ?? d` over a nullable value-union box desugars here rather than in an
    // emit arm, since the lowering names the operand twice and only a re-readable left
    // operand is safe (a call operand keeps the `??`, refused at emit). Not over a map
    // read: a map miss is a bare `ref.null`, not a null-tagged box — `emitMapGetOr` owns that.
    if exprReReadable(coalLhs) && !drwIsMapRead(n.binLeft) {
      if tyIsNulValueUnionBox(nodeTyIxOf(coalLhs)) {
        const dsThen: i32[] = []
        dsThen.push(drwNonNullReRead(n.binLeft, coalLhs))
        const dsElse: i32[] = []
        dsElse.push(n.binRight)
        const dsIf = mkIf(
          mkBinary("!=", n.binLeft, mkNull("null", n.pos), n.pos),
          mkBlock(dsThen, n.pos),
          mkBlock(dsElse, n.pos),
          n.pos,
        )
        // D969 — hands the `??`'s checked type to the synthesized `if`. Without it an
        // un-annotated destination has nothing left to ask (the erased `??` node carried
        // the type), so the binding takes a scalar cell while the box goes into it —
        // check-clean invalid wasm. The desugaring is meaning-preserving either way.
        nodeTyCarry(dsIf, ix)
        return dsIf
      }
    }
  }
  if drwDispatchOp(n.binOp) {
    const osi = drwFieldRowOf(n.binLeft, ctx, n.binOp)
    // The checker banked the receiver-keyed operator it resolved (`+@Vec3`); name that
    // declaration directly — the `a op b` twin of the `"[]"` arm's `opIdxFnAtNode` read.
    // Empty unless the left operand is a dispatched object, in which case an operator
    // closure field dispatches member-call style below (D1934).
    const opFn = opBinFnAtNode(ix)
    if opFn != "" {
      const oargs: i32[] = []
      oargs.push(n.binLeft)
      oargs.push(n.binRight)
      return drwOpCall(mkCall(drwFnRef(opFn), oargs, -1), ix)
    }
    if osi >= 0 {
      if drwFieldClosure(osi, n.binOp) {
        const fargs: i32[] = []
        fargs.push(n.binRight)
        return drwOpCall(
          mkCall(mkMember(n.binLeft, n.binOp, -1), fargs, -1),
          ix,
        )
      }
    }
  }
  return ix
}

// The read of `??` operand `lhs` (`lhsIx` unwrapped) in the present arm of its null-test
// desugaring: a fresh copy of a name, field or element read typed at the operand's non-null
// part, as the checker would have narrowed it under the test, or `lhs` itself otherwise.
function drwNonNullReRead(lhs: i32, lhsIx: i32): i32 {
  if lhsIx < 0 { return lhs }
  const ln = nodeAt(lhsIx)
  if !(ln is Ident || ln is Member || ln is Index) { return lhs }
  drwNarrowedClone(lhsIx, nonNullTy(nodeTyIxOf(lhsIx)))
}

// `drwRecvClone` of `src` typed `ty`, the type a null test narrowed it to. A name read also
// records the storage it reads, as the checker does for the reads it narrows.
function drwNarrowedClone(src: i32, ty: i32) {
  const c = drwRecvClone(src)
  nodeTyRecord(c, ty)
  if c >= 0 && nodeAt(c) is Ident { narrowedFromTyCarry(c, unwrapParen(src)) }
  c
}

// `if recv != null { recv.prop } else { other }`: the fresh receiver is typed `objTy`, the type
// the checker gives the same place under `!= null`, and the field read `readTy`. `recv` is a
// re-readable place; the caller types the result.
function recUnionGuard(
  recv: i32,
  prop: string,
  objTy: i32,
  readTy: i32,
  other: i32,
  pos: i32,
): i32 {
  const rObj = drwNarrowedClone(recv, objTy)
  const rRead = mkMember(rObj, prop, pos)
  nodeTyRecord(rRead, readTy)
  const rThen: i32[] = []
  rThen.push(rRead)
  const rElse: i32[] = []
  rElse.push(other)
  mkIf(
    mkBinary("!=", recv, mkNull("null", pos), pos),
    mkBlock(rThen, pos),
    mkBlock(rElse, pos),
    pos,
  )
}

// For `r?.prop` typed `omTy`, `recv` its receiver, read as a record-union field's guarded read:
// pushes the guard's receiver type, its field type, and 1 when the field admits `null` (else 0)
// onto `out`. A hole receiver is read at derived holes, so each instance reads its own pin
// (D13080). False, `out` untouched, when no read of `r` needs the guard.
function recUnionReadTys(
  recv: i32,
  prop: string,
  omTy: i32,
  out: i32[],
): boolean {
  const recvTy = nodeTyIxOf(recv)
  const ft = recUnionFieldTyOf(recvTy, prop, omTy)
  if ft >= 0 {
    out.push(nonNullTy(nodeTyIxOf(unwrapParen(recv))))
    out.push(ft)
    out.push(if tyBearsNull(ft) { 1 } else { 0 })
    return true
  }
  if !tyIsHole(recvTy) { return false }
  let wants = false
  let nul = 0
  for p in holePinsOfTy(recvTy) {
    if tyHasTyVar(p) { return false }
    const pf = optFieldAtPin(nonNullTy(p), prop)
    if pf < 0 { return false }
    if tyBearsNull(pf) { nul = 1 }
    if recUnionFieldTyOf(p, prop, optFieldAtPin(p, prop)) >= 0 { wants = true }
  }
  if !wants { return false }
  const face = nonNullNarrowTy(recvTy)
  const fld = mkDerivedHole(HD_FLD, prop, -1, -1, face)
  if face < 0 || fld < 0 { return false }
  out.push(face)
  out.push(fld)
  out.push(nul)
  true
}

// A bare `r?.f` read as `ix`, the guard's types in `tys` (`recUnionReadTys`): the guarded read
// with a `null` default, or `ix` unchanged when `r` cannot be read twice. A computed receiver is
// bound to a name before the checker runs (D5300).
function recUnionOptRead(ix: i32, n: OptMember, tys: i32[]): i32 {
  if !exprReReadable(unwrapParen(n.omObj)) { return ix }
  const g = recUnionGuard(
    n.omObj,
    n.omProp,
    tys[0],
    tys[1],
    mkNull("null", n.pos),
    n.pos,
  )
  nodeTyCarry(g, ix)
  capMemoNoteEdit()
  g
}

// The type of field `prop` read off the non-null part of `recvTy`, when that is a union of
// two or more records each holding the field, or one arm of a declared union, which is laid out
// at its variant row rather than a struct chain (D12820); `omTy` is the `?.` read's type. Else -1.
function recUnionFieldTyOf(recvTy: i32, prop: string, omTy: i32): i32 {
  if omTy < 0 || !tyBearsNull(recvTy) { return -1 }
  const arms: i32[] = []
  flattenVariantsInto(recvTy, arms)
  let recs = 0
  let lone = -1
  let fieldNul = false
  for a in arms {
    if a != TY_NULL {
      const ft = tyFieldTyOf(a, prop)
      if !tyIsRecord(a) || ft < 0 { return -1 }
      if tyBearsNull(ft) { fieldNul = true }
      recs = recs + 1
      lone = a
    }
  }
  if recs == 0 || (recs == 1 && !repTyHasArmShape(lone)) { return -1 }
  if fieldNul { omTy } else { nonNullTy(omTy) }
}

// D1253 — a bare `{ … }` statement becomes `if true { … }`, as a rewrite rather than an
// `emitStmt` arm: every per-function scratch-frame scan dispatches on statement kind and
// has no `Block` arm, so an emit-only lowering compiled against locals nobody declared.
// Meaning-preserving: the checker types a bare block `void`, same as an else-less `if`.
function drwBareBlock(ix: i32) {
  if ix < 0 { return ix }
  const b = nodeAt(ix)
  if b is Block { return mkBareBlockIf(ix, b.pos) }
  ix
}

// The dispatch-rewrite driver: top-level statements, then every lifted function's
// body (a nested FuncDecl is lambda-lifted into `fnStmts`).
export function dispatchRewrite(stmts: i32[]) {
  let i = 0
  while i < stmts.length {
    const s = nodeAt(stmts[i])
    if s is FuncDecl {
    } else if s is LetDecl {
      s.letInit = drwWalk(s.letInit, -1)
    } else if nodeIsTypeDecl(stmts[i]) {
    } else if s is UnionDecl {
    } else {
      const oldIx = stmts[i]
      // A top-level compound write spills into a block of its own, so the spills stay
      // locals of the start function rather than becoming module globals.
      let topIx = oldIx
      const topOut: i32[] = []
      if spillCompoundPlace(oldIx, topOut, -1) {
        topOut.push(oldIx)
        topIx = mkBlock(topOut, nodeAt(oldIx).pos)
        capMemoNoteEdit()
      }
      drwAtStmt = true
      const newIx = drwBareBlock(drwWalk(topIx, -1))
      if newIx != oldIx {
        // The statement node changed (e.g. `o[k] = v` → the write-trap call).
        // `startStmts` captured the old arena index during `collectFns`; repoint it
        // so the start function emits the rewritten form.
        stmts[i] = newIx
        let ssj = 0
        while ssj < startStmts.length {
          if startStmts[ssj] == oldIx { startStmts[ssj] = newIx }
          ssj = ssj + 1
        }
      }
    }
    i = i + 1
  }
  let fe = 0
  while fe < fnStmts.length {
    const fn = nodeAt(fnStmts[fe])
    if fn is FuncDecl {
      const drwBody = drwWalk(fn.fnBody, fnStmts[fe])
      if drwBody != fn.fnBody { bodyRebuiltFrom.set(drwBody, fn.fnBody) }
      fn.fnBody = drwBody
      if fe < fRetVoid.length && fRetVoid[fe] == 0 {
        spillTail(fn.fnBody, fnStmts[fe])
      }
    }
    fe = fe + 1
  }
  0
}

// ── value-position writes to a field or element (D2170) ──────────────────────────────────────
// An assignment yields its right-hand side, which a re-read of the target delivers at the
// value's rep only for a name. So in a function that yields a value, a tail `o[i] = r` becomes
// `const o2 = o; const i2 = i; const v = r; o2[i2] = v; v`, in source order (D1510).

// Spills the value-position tail of the block at `blockIx`: its last statement, or every arm
// of a last `if` the checker says yields a value.
function spillTail(blockIx: i32, fnIx: i32) {
  if blockIx < 0 { return 0 }
  const b = nodeAt(blockIx)
  if b is Block {
    const n = b.blkStmts.length
    if n == 0 { return 0 }
    const last = b.blkStmts[n - 1]
    if nodeAt(last) is IfStmt {
      if ifYieldsNoValue(last) { return 0 }
      let cur = last
      while cur >= 0 {
        const c = nodeAt(cur)
        cur = elseIfLink(cur)
        if c is IfStmt {
          spillTail(c.ifThen, fnIx)
          if cur < 0 { spillTail(c.ifElse, fnIx) }
        }
      }
      return 0
    }
    const out: i32[] = []
    const val = spillWrite(last, out)
    if val < 0 { return 0 }
    b.blkStmts.pop()
    let k = 0
    while k < out.length {
      b.blkStmts.push(out[k])
      k = k + 1
    }
    b.blkStmts.push(last)
    b.blkStmts.push(val)
    capMemoNoteEdit()
    plCacheBust()
  }
  0
}

// Rewrites the field or element write at `asgIx` to store a spilled value into a spilled place,
// pushing the spills onto `out` in source order; the node that yields the value, or -1 for any
// other node. A right side the checker typed at the place's type, a literal built at it, is
// stored unspilled and yielded by re-reading the spilled place (D2395).
function spillWrite(asgIx: i32, out: i32[]): i32 {
  const a = nodeAt(asgIx)
  if a is BinExpr {
    if a.binOp != "=" { return -1 }
    const t = unwrapParen(a.binLeft)
    if t < 0 { return -1 }
    const byPlace = asgValueNode(asgIx) == a.binLeft
    let place = -1
    let reread = -1
    const tn = nodeAt(t)
    if tn is Member {
      const obj = spillLocal(tn.memObj, asgIx, "o", out, a.pos)
      place = mkMember(obj, tn.memProp, tn.pos)
      if byPlace { reread = mkMember(spillRead(obj), tn.memProp, tn.pos) }
    } else if tn is Index {
      const recv = spillLocal(tn.idxArr, asgIx, "o", out, a.pos)
      let idx = tn.idxIndex
      // A number re-evaluates to itself; any other index is spilled with the receiver.
      const idxLit = nodeAt(idx)
      if idxLit is NumLit {
        if byPlace {
          const idx2 = mkNumTyped(idxLit.numText, idxLit.pos, nodeTyIxOf(idx))
          reread = mkIndex(spillRead(recv), idx2, tn.pos)
        }
      } else {
        idx = spillLocal(idx, asgIx, "i", out, a.pos)
        if byPlace { reread = mkIndex(spillRead(recv), spillRead(idx), tn.pos) }
      }
      place = mkIndex(recv, idx, tn.pos)
    }
    if place < 0 { return -1 }
    nodeTyCarry(place, t)
    a.binLeft = place
    // A compound write reads its target inside the right-hand side, through the same node.
    const inner = nodeAt(a.binRight)
    if inner is BinExpr {
      if unwrapParen(inner.binLeft) == t { inner.binLeft = place }
    }
    // A bare `null` has no rep of its own to spill into, so the tail yields a fresh one.
    const rv = unwrapParen(a.binRight)
    if rv >= 0 && nodeAt(rv) is NullLit {
      const nul = mkNull("null", a.pos)
      nodeTyCarry(nul, rv)
      return nul
    }
    if reread >= 0 {
      nodeTyCarry(reread, t)
      return reread
    }
    // A number re-evaluates to itself: it is stored as built at the place, and the tail yields a
    // fresh one at the type the assignment yields, which may be narrower (`9` into an `f64`).
    if rv >= 0 && nodeTyIxOf(asgIx) >= 0 {
      const rn = nodeAt(rv)
      if rn is NumLit {
        return mkNumTyped(rn.numText, rn.pos, nodeTyIxOf(asgIx))
      }
    }
    const val = spillLocal(a.binRight, asgIx, "v", out, a.pos)
    spillTypeByTarget(out[out.length - 1], val, t)
    a.binRight = val
    return spillRead(val)
  }
  -1
}

// A compound write `p op= v` (or `++p`) reads its place through the same target node it
// writes, so a receiver or index that is not re-readable would run twice. Spills each such
// operand once, receiver first, onto `out` and points the target at the spill; true if any.
function spillCompoundPlace(asgIx: i32, out: i32[], ctx: i32): boolean {
  const a = nodeAt(asgIx)
  if a is BinExpr {
    if a.binCompound == "" || a.binOp != "=" { return false }
    const t = unwrapParen(a.binLeft)
    if t < 0 { return false }
    const tn = nodeAt(t)
    if tn is Index {
      if cpReReadable(tn.idxIndex, ctx) {
        if cpReReadable(tn.idxArr, ctx) { return false }
        tn.idxArr = spillLocal(tn.idxArr, asgIx, "co", out, a.pos)
        return true
      }
      // An index with an effect runs after the receiver, so the receiver is taken first.
      tn.idxArr = spillLocal(tn.idxArr, asgIx, "co", out, a.pos)
      tn.idxIndex = spillLocal(tn.idxIndex, asgIx, "ci", out, a.pos)
      return true
    }
    return spillCompoundRecv(t, asgIx, out, a.pos, ctx)
  }
  false
}

// `spillCompoundPlace` for every target that is not an element: a field's receiver is spilled
// when it is not re-readable, and a name has nothing to spill.
function spillCompoundRecv(
  t: i32,
  asgIx: i32,
  out: i32[],
  pos: i32,
  ctx: i32,
): boolean {
  const tn = nodeAt(t)
  if tn is Member {
    if cpReReadable(tn.memObj, ctx) { return false }
    tn.memObj = spillLocal(tn.memObj, asgIx, "co", out, pos)
    return true
  }
  false
}

// `exprReReadable` for a compound write's place, except that an element read a user `"[]"`
// answers is a call, whose effects a second read would repeat.
function cpReReadable(ix: i32, ctx: i32): boolean {
  const u = unwrapParen(ix)
  if u < 0 { return false }
  const e = nodeAt(u)
  if e is Index {
    if opIdxFnAtNode(u) != "" { return false }
    if drwFieldClosure(drwFieldRowOf(e.idxArr, ctx, "[]"), "[]") {
      return false
    }
    return cpReReadable(e.idxArr, ctx) && cpReReadable(e.idxIndex, ctx)
  }
  cpRecvReReadable(u, ctx)
}

// `cpReReadable` for a node that is not an element read: a field read asks of its receiver,
// and anything else is `exprReReadable`'s.
function cpRecvReReadable(u: i32, ctx: i32): boolean {
  if u < 0 { return false }
  const e = nodeAt(u)
  if e is Member { return cpReReadable(e.memObj, ctx) }
  exprReReadable(u)
}

// Pushes `const asg#<asgIx>#<tag> = <ix>` onto `out` and answers a read of it, both typed as `ix`.
function spillLocal(
  ix: i32,
  asgIx: i32,
  tag: string,
  out: i32[],
  pos: i32,
): i32 {
  const name = "asg#" + i32ToStr(asgIx) + "#" + tag
  const decl = mkLet("const", name, -1, ix, pos)
  nodeTyCarry(decl, ix)
  // A record literal is built at the record the checker stored it as, so its spill holds that;
  // the read keeps the literal's own type.
  const held = spillHeldTy(ix)
  if held >= 0 { nodeTyRecord(decl, held) }
  out.push(decl)
  const rd = mkIdent(name, pos)
  identFromDecl(rd, decl)
  nodeTyCarry(rd, ix)
  refViewCarry(ix, rd)
  rd
}

// The closed record a record literal `ix` is stored as when the checker stored it as other than
// its own type, else -1.
function spillHeldTy(ix: i32): i32 {
  const u = unwrapParen(ix)
  if u < 0 || !(nodeAt(u) is ObjLit) { return -1 }
  const rt = nodeRepTyIxOf(u)
  if rt < 0 || rt == nodeTyIxOf(u) || tyHasTyVar(rt) || !(tyAt(rt) is TyObj) {
    return -1
  }
  rt
}

// A second read of the spilled name `rd` reads, with its type.
function spillRead(rd: i32): i32 {
  const n = nodeAt(rd)
  if n is Ident {
    const r2 = mkIdent(n.identName, n.pos)
    identFrom(r2, rd)
    nodeTyCarry(r2, rd)
    return r2
  }
  -1
}

// A literal-union target stores the atom, so the spilled value `decl` takes the target's alias
// and holds the atom too; any other target keeps the right-hand side's own type.
function spillTypeByTarget(decl: i32, rd: i32, t: i32) {
  const ty = nodeTyIxOf(t)
  const al = litUnionAliasNameOfTy(ty)
  if al == "" { return 0 }
  const d = nodeAt(decl)
  if d is LetDecl { d.letType = synthTypeRefTy(al, -1, ty) }
  nodeTyRecord(decl, ty)
  nodeTyRecord(rd, ty)
  0
}

// ── value-position writes to a wider name (D2398) ─────────────────────────────────────────────
// An assignment yields its right side, a name's re-read its storage. Where the two types
// differ (`5` into an `f64`), a write on its statement's leading evaluation path moves ahead
// of the statement as `const v = e; a = v`, and the statement reads `v`.

// The declarations read, in evaluation order, by operands the walk has already passed; a write
// the walk moves ahead of them must not change what they read.
let asvReads: i32[] = []
// Set once the walk passes an operand that it cannot prove the moved write leaves alone.
let asvStop = false
// Whether the statement walked is a top-level binding, which has room for one moved write.
let asvTopLet = false

// Records the operand at `ix` as passed: a name's declaration joins `asvReads`, and any operand
// other than a name or a literal (`exprReReadable` of a leaf) ends the walk.
function asvPassOperand(ix: i32) {
  const u = unwrapParen(ix)
  if u < 0 { return 0 }
  if nodeAt(u) is Ident {
    asvReads.push(identDeclOf(u))
    return 0
  }
  if !asvIsLeaf(u) { asvStop = true }
  0
}

// A literal or a name: an operand whose evaluation neither writes nor depends on order.
function asvIsLeaf(ix: i32): boolean {
  if ix < 0 { return false }
  if nodeAt(ix) is Member || nodeAt(ix) is Index { return false }
  exprReReadable(ix)
}

// Whether evaluating `ix` can write anything: an assignment under an operator, or any node
// `exprReReadable` does not answer for, a call among them.
function asvMayWrite(ix: i32): boolean {
  if ix < 0 { return false }
  const n = nodeAt(ix)
  if n is BinExpr {
    if n.binOp == "=" { return true }
    return asvMayWrite(n.binLeft) || asvMayWrite(n.binRight)
  }
  if n is Unary { return asvMayWrite(n.unArg) }
  asvLeafMayWrite(ix)
}

// Whether a node that is not an operator can write: any node `exprReReadable` does not
// answer for, a call among them.
function asvLeafMayWrite(ix: i32): boolean { !exprReReadable(ix) }

// Whether the value-position write `a = e` at `asgIx` moves ahead: its name's type is not the
// value's, neither is a literal-union atom (a store that encodes one keeps its re-read, as
// D2285's does), the value is not a bare `null`, and no operand already passed reads the name
// or anything `e` may write.
function asvMoves(asgIx: i32): boolean {
  if !asvTypeMoves(asgIx) { return false }
  const a = nodeAt(asgIx)
  if !(a is BinExpr) { return false }
  if !(nodeAt(a.binLeft) is Ident) { return false }
  const td = identDeclOf(a.binLeft)
  let i = 0
  let spilled = true
  while i < asvReads.length {
    if asvReads[i] == td { return false }
    if !asvIsSpill(asvReads[i]) { spilled = false }
    i = i + 1
  }
  spilled || !asvMayWrite(a.binRight)
}

// Whether declaration `d` is a spill `spillLocal` minted, which no write can reach.
function asvIsSpill(d: i32): boolean {
  if d < 0 { return false }
  const dn = nodeAt(d)
  if dn is LetDecl { return dn.letName.slice(0, 4) == "asg#" }
  false
}

// True when `ix` is a number literal, or a plain write whose value is one (`gi = 14`).
function asvLitValue(ix: i32): boolean {
  const n = nodeAt(unwrapParen(ix))
  if n is BinExpr && n.binOp == "=" && n.binCompound == "" {
    return asvLitValue(n.binRight)
  }
  cexLitPeel(ix) >= 0
}

// `asvMoves`'s half that reads only the write at `asgIx`: a plain write to a name whose
// storage type is not the value's, where neither is a literal-union atom or holds a type
// variable, and the value is neither a bare `null` nor a number literal.
function asvTypeMoves(asgIx: i32): boolean {
  const a = nodeAt(asgIx)
  if !(a is BinExpr) { return false }
  if a.binOp != "=" || a.binCompound != "" { return false }
  if !(nodeAt(a.binLeft) is Ident) { return false }
  if nodeAt(unwrapParen(a.binRight)) is NullLit { return false }
  // A number literal's value is built where it is read (`asgLitWidth`), so it stays in place.
  if asvLitValue(a.binRight) { return false }
  const lt = asgStoreTyOf(asgIx)
  const vt = nodeTyIxOf(asgIx)
  if lt < 0 || vt < 0 || tySame(lt, vt) { return false }
  if tyIsLitUnionOrLit(nonNullTy(lt)) || tyIsLitUnionOrLit(vt) { return false }
  !(tyHasTyVar(lt) || tyHasTyVar(vt))
}

// Walks the operands of `ix` that run first, moving each value-position write `asvMoves`
// accepts onto `out`; answers the node that replaces `ix`. `isValue` is false only for a
// statement's own top-level write, whose value nothing reads.
function asvWalk(ix: i32, out: i32[], isValue: boolean): i32 {
  if ix < 0 || asvStop { return ix }
  const n = nodeAt(ix)
  if (
    n is Ident
    || n is NumLit
    || n is StrLit
    || n is CharLit
    || n is BoolLit
    || n is NullLit
  ) {
    return ix
  }
  if n is Paren {
    n.parInner = asvWalk(n.parInner, out, isValue)
    return ix
  }
  if n is BinExpr {
    if n.binOp == "=" { return asvWalkWrite(ix, n, out, isValue) }
    n.binLeft = asvWalk(n.binLeft, out, true)
    asvPassOperand(n.binLeft)
    if n.binOp == "&&" || n.binOp == "||" || n.binOp == "??" { asvStop = true }
    n.binRight = asvWalk(n.binRight, out, true)
    return ix
  }
  if n is Unary {
    n.unArg = asvWalk(n.unArg, out, true)
    return ix
  }
  if n is Call {
    if n.callFn < 0 { return asvHalt(ix) }
    const callee = nodeAt(n.callFn)
    if callee is Member {
      callee.memObj = asvWalk(callee.memObj, out, true)
      asvPassOperand(callee.memObj)
    } else if callee is Ident {
      // A callee a binding holds is read before the arguments run.
      const cd = identDeclOf(n.callFn)
      if cd >= 0 && !(nodeAt(cd) is FuncDecl) { asvPassOperand(n.callFn) }
    } else {
      asvStop = true
    }
    // Named arguments run in parameter order, not source order (D2343), so none moves.
    if hasNamedArgs(n.callArgNames) { return asvHalt(ix) }
    asvWalkList(n.callArgs, out)
    return ix
  }
  if n is ArrayLit {
    asvWalkList(n.arrElems, out)
    return ix
  }
  if n is ObjLit { return asvWalkObj(ix, n, out) }
  if n is Spread {
    n.spdArg = asvWalk(n.spdArg, out, true)
    return ix
  }
  if n is Member {
    n.memObj = asvWalk(n.memObj, out, true)
    return ix
  }
  if n is Index {
    n.idxArr = asvWalk(n.idxArr, out, true)
    asvPassOperand(n.idxArr)
    n.idxIndex = asvWalk(n.idxIndex, out, true)
    return ix
  }
  if n is IsExpr {
    n.isObj = asvWalk(n.isObj, out, true)
    return ix
  }
  if n is AsExpr {
    n.asObj = asvWalk(n.asObj, out, true)
    return ix
  }
  asvHalt(ix)
}

// The end of the walk at `ix`, a node whose operands it does not model (a lambda, a `match`,
// an `if` used as a value): no later write moves past it. Answers `ix` unchanged.
function asvHalt(ix: i32): i32 {
  asvStop = true
  ix
}

// `asvWalk` over operands that run in order, each passed before the next is walked.
function asvWalkList(xs: i32[], out: i32[]) {
  let i = 0
  while i < xs.length {
    xs[i] = asvWalk(xs[i], out, true)
    asvPassOperand(xs[i])
    i = i + 1
  }
  0
}

// A record literal's fields run in layout order, not source order, so only a literal whose
// other fields are all literals has an operand that provably runs first.
function asvWalkObj(ix: i32, n: ObjLit, out: i32[]): i32 {
  let lead = -1
  let i = 0
  while i < n.objFields.length {
    const f = nodeAt(n.objFields[i])
    if f is FieldInit {
      const v = nodeAt(unwrapParen(f.fiValue))
      if !(v is NumLit || v is StrLit || v is CharLit || v is BoolLit) {
        if lead >= 0 {
          asvStop = true
          return ix
        }
        lead = n.objFields[i]
      }
    }
    i = i + 1
  }
  if lead >= 0 {
    const lf = nodeAt(lead)
    if lf is FieldInit { lf.fiValue = asvWalk(lf.fiValue, out, true) }
  }
  asvStop = true
  ix
}

// Passes the operands a write's target `ti` evaluates before its right side: a field's
// receiver, or an element's receiver and index. A name evaluates none; any other target ends
// the walk.
function asvPassTarget(ti: i32) {
  if ti < 0 { return asvHalt(ti) }
  const t = nodeAt(ti)
  if t is Member { return asvPassOperand(t.memObj) }
  if t is Index {
    asvPassOperand(t.idxArr)
    return asvPassOperand(t.idxIndex)
  }
  if t is Ident { return 0 }
  asvHalt(ti)
}

// An assignment on the leading path: its right side runs first; a name target of a value
// write `asvMoves` accepts becomes `const v = e; a = v` on `out` and the read of `v`. A field
// or element target is walked only when its receiver and index are names or literals.
function asvWalkWrite(ix: i32, n: BinExpr, out: i32[], isValue: boolean): i32 {
  asvPassTarget(unwrapParen(n.binLeft))
  n.binRight = asvWalk(n.binRight, out, true)
  if asvStop || !isValue || !asvMoves(ix) { return ix }
  if asvTopLet { asvStop = true }
  const v = spillLocal(n.binRight, ix, "nv", out, n.pos)
  n.binRight = v
  out.push(ix)
  spillRead(v)
}

// The statement at `ix` with its leading value-position writes moved onto `out`: a binding's
// initialiser, a return's value, an `if`'s condition, a `match`'s subject, or the expression.
function asvStmt(ix: i32, out: i32[]) {
  asvReads = []
  asvStop = false
  const s = nodeAt(ix)
  if s is LetDecl {
    s.letInit = asvWalk(s.letInit, out, true)
  } else if s is RetStmt {
    s.retArg = asvWalk(s.retArg, out, true)
  } else if s is IfStmt {
    s.ifCond = asvWalk(s.ifCond, out, true)
  } else if s is MatchExpr {
    s.matchScrut = asvWalk(s.matchScrut, out, true)
  } else if (
    !(s is FuncDecl
      || s is WhileStmt
      || s is ForRange
      || s is ForIn
      || s is Block)
  ) {
    asvWalk(ix, out, false)
  }
  0
}

// Rewrites one statement list, once after every statement is walked (D2872): the moved writes
// land ahead of their statement. A top-level statement other than a binding takes them inside a
// bare block of its own, so they stay locals of the start function. A top-level binding moves
// one write, as a module binding and a statement ahead of it, at the start function's order.
function asvList(stmts: i32[], top: boolean) {
  const res: i32[] = []
  let moved = false
  let i = 0
  while i < stmts.length {
    const out: i32[] = []
    asvTopLet = top && nodeAt(stmts[i]) is LetDecl
    asvStmt(stmts[i], out)
    if out.length > 0 { moved = true }
    if out.length > 0 && top && !asvTopLet {
      const blk = mkBareBlockIf(mkBlock(out, -1), nodeAt(stmts[i]).pos)
      out.push(stmts[i])
      res.push(blk)
    } else {
      let k = 0
      while k < out.length {
        res.push(out[k])
        k = k + 1
      }
      res.push(stmts[i])
    }
    i = i + 1
  }
  if !moved { return 0 }
  i = 0
  while i < res.length {
    if i < stmts.length { stmts[i] = res[i] } else { stmts.push(res[i]) }
    i = i + 1
  }
  plCacheBust()
  0
}

// Whether function `fnIx` yields its body's value: un-annotated and not adopted as a void
// callback, or annotated with a type other than `void`.
function asvFnYields(fnIx: i32): boolean {
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return false }
  if fn.fnRet < 0 { return !lambdaVoidAdoptedAt(fnIx) }
  const rt = nodeAt(fn.fnRet)
  if rt is TypeRef { return rt.tyName != "void" }
  false
}

// The value tail of the block at `blockIx`, arm by arm along a tail `if`'s `else if` spine: a
// write `asvMoves` accepts becomes `const v = e; a = v; v`, as `spillTail` does for a field.
function asvTail(blockIx: i32) {
  const b = nodeAt(blockIx)
  if !(b is Block) { return 0 }
  const st = b.blkStmts
  if st.length == 0 { return 0 }
  const tx = st[st.length - 1]
  if nodeAt(tx) is IfStmt {
    if ifYieldsNoValue(tx) || !asvChainHasElse(tx) { return 0 }
    let cur = tx
    while cur >= 0 {
      const c = nodeAt(cur)
      cur = elseIfLink(cur)
      if c is IfStmt {
        asvTail(c.ifThen)
        if cur < 0 { asvTail(c.ifElse) }
      }
    }
    return 0
  }
  if !(nodeAt(tx) is BinExpr) { return 0 }
  asvReads = []
  asvStop = false
  asvTopLet = false
  const out: i32[] = []
  const v = asvWalk(tx, out, true)
  if out.length == 0 { return 0 }
  st.pop()
  let k = 0
  while k < out.length {
    st.push(out[k])
    k = k + 1
  }
  st.push(v)
  plCacheBust()
  0
}

// Whether the `else if` chain from the `if` at `ix` ends in an `else`, which a value needs.
function asvChainHasElse(ix: i32): boolean {
  let cur = ix
  let last = ix
  while cur >= 0 {
    last = cur
    cur = elseIfLink(cur)
  }
  const l = nodeAt(last)
  if l is IfStmt { return l.ifElse >= 0 }
  false
}

// The pass: every statement list in the arena, before collection reads the module's bindings.
export function assignValueSpill(stmts: i32[]) {
  const n = P.nodes.length
  // A program whose every write stores its right side's own type has nothing to move.
  if !asgAnyWiderStore() { return 0 }
  let i = 0
  while i < n {
    const nd = nodeAt(i)
    if nd is Block { asvList(nd.blkStmts, false) }
    if nd is FuncDecl {
      if asvFnYields(i) { asvTail(nd.fnBody) }
    }
    i = i + 1
  }
  asvList(stmts, true)
  0
}

// Pins every un-annotated lambda that returns a union to that union, consuming the
// contextual return type the checker already computed. A body-inferred return for a
// union join (`if … { aCat } else { aDog }`) collapses to one arm, so without the pin
// the lambda's functype and `$fnsig` key disagree with the call site's, un-interning it.
export function synthRetAnnots() {
  if !fnValUsed { return 0 }
  let fe = 0
  while fe < fnStmts.length {
    const lamIx = fnStmts[fe]
    const fn = nodeAt(lamIx)
    if fn is FuncDecl {
      if fn.fnRet < 0 {
        // Void-context lambda (`lambdaVoidAdoptedAt`): checked against an expected
        // `(…) => void` and adopted the void return, so `fnRet` pins to a synthesized
        // `void` TypeRef and `fRetVoid` is set now, ahead of `buildFnMap#2`'s rebuild.
        // Claimed first: a void-adopted lambda records no inferred-return row of its own.
        if lambdaVoidAdoptedAt(lamIx) {
          fn.fnRet = synthTypeRefTy("void", -1, -1)
          if fe < fRetVoid.length { fRetVoid[fe] = 1 }
          fe = fe + 1
          continue
        }
        // A lambda returning a join of records wider than its tails takes the join (D2731), as
        // a named function does, so its signature and its built value name one row.
        const ljt = tyStepRet(nodeTyIxOf(lamIx))
        if fnRetJoinsWiderRecord(lamIx, ljt) {
          const ljn = tyToEmitName(ljt)
          if ljn != "" {
            fn.fnRet = synthTypeRefTy(ljn, -1, ljt)
            fe = fe + 1
            continue
          }
        }
        const ctx = inferRetNameByNode(lamIx)
        if ctx != "" {
          const ctxTy = inferRetTyIxByNode(lamIx)
          // The row lets this ladder ask which producer answered, instead of
          // re-deriving the answer from the name that producer built.
          const ctxRow = inferRetRowByNode(lamIx)
          // Asked of the rung, not the name: a name test here depended on a later pass
          // having already filled the union registry (`registerInlineUnion`), a
          // cross-pass dependence asking the recording producer removes entirely — see
          // `inferRetRungIsBoxedUnion` for which producers this rung covers.
          if inferRetRungIsBoxedUnion(ctxRow) {
            // A litunion-alias return (`(i32) => K = (x) => "b"`): pins `fnRet` to the
            // alias so the lambda's `$fnsig` result keys the i32 atom matching the value
            // call, and `emitReturnValue` encodes the member literal as its atom id.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsNullable(ctxRow) {
            // A nullable-ref return (`P | null`, `string | null`) the checker proved at
            // the lambda's boundary: pins so the `$fnsig` result keys the nullable token,
            // matching the value call. A value union with a `null` member does not come
            // here — that is `valueUnionRetName`'s, claimed by the union arm above.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
            // No separate map-member-union arm: it would pin the identical body the boxed-
            // union arm above already reaches, and keeping it would silently mask a gap in
            // that arm's rung set instead of surfacing an un-pinned row.
          } else if inferRetRungIsNulListRet(ctxRow) {
            // A nullable list at a distinct-backing element (`string[] | null`): pins as the
            // named function's pin does, so the result declares the nullable wrapper (D2399).
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsParenUnionElemList(ctxRow) {
            // An element-value-union list return (`(f64|null)[]`, `(i64|boolean)[]`): each
            // element seeds through the value-union-box list rep (`refArrElemKind == 2`),
            // whose box element `parenUnionArrElemName` extracts — the shape's distinguishing
            // mark, and this rung's own gate.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsNestedElemUnionList(ctxRow) {
            // A nested (2-D+) union-element array return (`(i64 | boolean)[][]`): pins so
            // `emitReturnValue`'s `tyAnnRefListSlot` thread the outer
            // ref-list slot into the body's nested literal. Un-pinned, the outer array
            // self-classified `i32[][]` from its first leaf — invalid wasm.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsNestedLeafList(ctxRow) {
            // A nested scalar/string-leaf array return (`() => i64[][]`): pins so the body
            // literal builds under the return-position seed instead of self-classifying an
            // i32 default, and the `$fnsig` result keys the same reflist slot the
            // annotation side resolves — the two producers must byte-match.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsLitUnionElemList(ctxRow) {
            // A litunion-alias-element array return (`(i32) => K0[] = (q0) => (["4664"])`):
            // pins so the body's member literals build the i32 atom list under the
            // annotated threading; un-pinned they self-classify a string list into the
            // i32-list functype result — invalid wasm.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsMapElemList(ctxRow) {
            // A map-element array return (`(i32) => {[string]: f32}[] = (q1) => ([h0])`):
            // pins so the `$fnsig` result keys the same reflist slot the annotation side
            // resolves. Un-pinned, the literal-side element spelling diverged and the
            // value call found no interned signature.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsScalarListRet(ctxRow) {
            // A distinct-backing scalar-leaf list return (`() => i64[] = () => ([5])`): the
            // pin collects the leaf wrapper's list types, which the value-call index read
            // requires; un-pinned it fails "list type not collected". Agrees with the
            // litunion-alias arm above only by ladder position — reorder-sensitive.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if tyIsStructWithLitUnionField(ctxTy) {
            // A struct-with-litunion-field return (`{f:K0}`): pins so the body literal
            // builds the i32-atom struct and the `$fnsig` result keys the same struct every
            // annotated consumer codes. Reached only where no annotation threads into the
            // lambda; the direct-arg spelling already builds it via the param-annotation seed.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if tyIsStructListWithUnionField(ctxTy) {
            // A union-field-struct-element list return (`{f:{f:f64}|boolean}[]`): pins so
            // the body array literal builds boxed-field elements under the same reflist slot
            // the annotated spelling resolves; un-pinned the self-inferred plain-element
            // list stored a struct ref into the boxed field's tag slot — invalid wasm.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsStructElemList(ctxRow) {
            // A plain-struct-element list return (`{a:i64,f:f64,z:{…}}[]`): pins, nominal-
            // resolved, so element literals build under the annotated threading and the
            // `$fnsig` keys the annotation side's ref-list slot. Un-pinned, a same-fieldset
            // twin row fieldset-matched the wrong row and boxed the list — invalid wasm.
            fn.fnRet = synthTypeRefTy(shapeNominalOr(ctxTy, ctx), -1, ctxTy)
          } else if tyIsStructWithUnionField(ctxTy) {
            // A struct-with-union/nullable-field return (`{f: boolean | {w: i32}}`): pins so
            // the `$fnsig` result is the union-field struct and `emitReturnValue` coerces the
            // body `ObjLit` into the boxed field slot. Un-pinned, the plain body-inferred
            // struct made the value call mis-recover the boxed field — a mismatch or invalid wasm.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if tyStructHasMapField(ctxTy, 0) {
            // A map-carrying struct return (`{a:string,f:{f:{[string]:{f:i64}}},z:f32}`):
            // pins so the body `ObjLit`'s nested literals thread the annotation's per-field
            // struct indices. Un-pinned, a nested literal resolved by first-field-name-set
            // match onto the map's own value struct and minted a wrong-layout twin — invalid wasm.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
            // Deliberately stays on the name rather than a rung test: a struct whose field
            // is a literal union can render the same brace spelling at a different rung, so
            // a rung test here would be narrower and could miss a row that needs this pin —
            // narrowing a pin that exists to stop invalid wasm is the dangerous direction.
          } else if nameIsWholeSpanShape(ctx) && nameIsSpaceFree(ctx) {
            // A plain struct return recorded canonically (`structPlainRetName` — `{f:f32}`):
            // pins, nominal-resolved, so the body literal builds under the annotated
            // threading. Un-pinned, a same-fieldset twin row fieldset-matched the wrong row
            // — invalid wasm. The space guard excludes a legacy spaced record's un-pinned route.
            fn.fnRet = synthTypeRefTy(shapeNominalOr(ctxTy, ctx), -1, ctxTy)
          }
        }
        // A lambda the checker's general rung adopted onto its contextual result pins to
        // it when no rung above did, so it builds as the annotated spelling builds.
        if fn.fnRet < 0 && lambdaCtxRetAdoptedAt(lamIx) {
          const cty = tyStepRet(nodeTyIxOf(lamIx))
          if cty >= 0 { fn.fnRet = synthTypeRefOfTy(cty, -1) }
        }
      }
    }
    fe = fe + 1
  }
  0
}

// D1062 — pins an inferred nullable-list return on a named function, so it lowers through
// the annotation the user did not write: `if n == 0 { return [1, 2] }; return null` infers
// `i32[] | null`, but the inferred spelling has no nullable-list arm in the `fRetKind`
// cascade. A pin rather than cascade arms, since the annotated spelling is served at four sites.

export function synthNulListRetAnns() {
  let i = 0
  while i < fnStmts.length {
    const fn = nodeAt(fnStmts[i])
    if fn is FuncDecl {
      if fn.fnRet < 0 && fn.fnName != "" {
        // D1220 — the nullable-struct return is the same pin, one type family over:
        // `function set(y: C) { if y.v > 0 { g = y } }` infers `C | null`, and un-pinned
        // it declared a `(ref null $C)` result over a body with no `ref.null` fallback —
        // a trap at `vl check` rc 0. `fnRetNullBearing`/`emitNullForRet` both read `fn.fnRet`.
        const irk = inferRetFnKey(fnStmts[i], fn.fnName)
        if inferRetNulPinned(irk) {
          const nm = inferRetNameOf(irk)
          if nm != "" { fn.fnRet = synthTypeRefTy(nm, -1, inferRetTyIxOf(irk)) }
        } else {
          // A return joining records into one (D2731) takes the joined type, so each
          // returned literal is built at its row as under the annotated spelling.
          const jty = tyStepRet(nodeTyIxOf(fnStmts[i]))
          // So does a return set joining lists of different storage, built as the union box,
          // and a union with a function member, which un-pinned lowered as a bare closure (D4349).
          const pinsUnion = tyIsListUnion(jty) || tyIsFnArmUnion(jty)
          if (
            pinsUnion
            || tyIsJoinedRecord(jty)
            || fnRetJoinsWiderRecord(fnStmts[i], jty)
          ) {
            let jnm = ""
            if tyIsListUnion(jty) {
              jnm = listUnionEmitName(jty)
            } else {
              jnm = tyToEmitName(jty)
            }
            if pinsUnion {
              if synthUnionRet(fn, jty, jnm) < 0 { return -1 }
            } else if jnm != "" {
              fn.fnRet = synthTypeRefTy(jnm, -1, jty)
            }
          } else {
            // An inferred return that is one union arm is pinned to the arm's nominal name, so a
            // returned binding narrowed to it is unboxed exactly as under `: Arm` (D4555).
            const jvr = repVariantShapeRowOf(jty)
            if jvr >= 0 && jvr < uVariants.length {
              fn.fnRet = synthTypeRefTy(uVariants[jvr], -1, jty)
            }
          }
        }
      }
    }
    i = i + 1
  }
  0
}

// Pins `fn`'s return to the union `jty` spelled `jnm`, registering the union a record list arm
// or a function arm needs after `collectU` has run, as an annotated spelling registers it there
// (D2768, D4349). No pin when `jnm` is "".
function synthUnionRet(fn: FuncDecl, jty: i32, jnm: string): i32 {
  if jnm == "" || emitRootIx < 0 { return 0 }
  const root = nodeAt(emitRootIx)
  if root is Program {
    const before = uVariants.length
    if registerInlineUnionOfTy(root.progStmts, jnm, jty) < 0 { return -1 }
    if uVariants.length != before {
      if assignTags() < 0 { return -1 }
    }
  }
  fn.fnRet = synthTypeRefTy(jnm, -1, jty)
  0
}

// The pin an un-annotated union param takes, chosen by the param's own union rep, never
// by `unNames` declaration order — a boxed union shares `$uBox` so any boxed alias works,
// but a litunion's atom ids are its own member strings, so it must pin the param's own
// rendered type. "" means no pin: a boxed param with no boxed alias registered at all.
function unionParamPinName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if tyIsLitUnion(ty) {
    // A litunion param's rep follows the spelling its context is written in: a declared alias
    // (`(K) => i32`) reps as the i32 atom, an inline member spelling (`("a"|"b") => i32`)
    // softens to `string`. `nodeTyIsLitUnionAlias` is what separates them — the alias's
    // own arena index, not a member-set match an inline spelling would also satisfy.
    if nodeTyIsLitUnionAlias(ix) {
      const al = litUnionAliasNameOfTy(ty)
      if al != "" { return al }
    }
    // An inline spelling softens to `string`, the name every all-string literal union
    // renders to at the root.
    return "string"
  }
  // A numeric literal union (`0 | 1`, `1.5 | 2.5`) reps as its base scalar, not the boxed
  // loop below: `tyIsLitUnion` rejects any member whose `litKind != "str"`, so a numeric
  // litunion needs its own rung (`numLitUnionBaseName`). No spelling split, unlike the
  // string half: an alias and an inline spelling soften to the same base scalar.
  const nb = numLitUnionBaseName(ty)
  if nb != "" { return nb }
  // The param's own row first: the pin's spelling is what an `is` in the body is decided
  // against, so another union's alias folds a test on a member it lacks (D3039).
  const own = unRowOfCanon(ty)
  if own >= 0 { return unNames[own] }
  let u = 0
  while u < unNames.length {
    const nm = unNames[u]
    // A literal union, string or numeric, reps as its atom or base scalar, never as the box, so
    // its row is no pin for an unrelated union. Tested off the row's own type (`unTyIx`); a row
    // with no type is passed over, since nothing says what it reps as.
    const row = unTyIx[u]
    let skip = true
    if row >= 0 { skip = tyIsLitUnion(row) || numLitUnionHasBase(row) }
    if !skip { return nm }
    u = u + 1
  }
  ""
}

// The name an un-annotated parameter's recorded type pins to — "what its annotation would
// have said" — or "" when the checker recorded no usable type (a `TyVar`, the still-open
// inference hole). Nullable cannot share the union arm's "pin any declared alias" shortcut:
// `i32|null` boxes, `string|null` niches, `boolean|null` is an i32 sentinel — each pins its own.
export function recordedParamPinName(pIx: i32) {
  if nodeTyIsUnion(pIx) { return unionParamPinName(pIx) }
  if nodeTyIsNullable(pIx) {
    const nty = tyToEmitName(nodeTyIxOf(pIx))
    if nty == "" { return "" }
    // Resolves the shape under the null on the arena, the rule the general arm applies below;
    // the render stays as the fall-through and as the inference-hole gate.
    const nnom = shapeNominalOfTy(nonNullTy(nodeTyIxOf(pIx)))
    if nnom != "" { return nnom + "|null" }
    return nty
  }
  // A map typed only by its context pins its own spelling, so its reads are a map receiver's
  // (D9990); an open hole in it still pins nothing.
  if nodeTyIsMap(pIx) {
    if tyHasTyVar(nodeTyIxOf(pIx)) { return "" }
    return nodeTyMapName(pIx)
  }
  const tn = nodeTyName(pIx)
  if tn == "" { return "" }
  // A list of nullable records pins the declared struct's row, as its own binding does.
  const nrl = nulRecListNominalName(nodeTyIxOf(pIx))
  if nrl != "" { return nrl }
  // The shape-to-nominal decision moves onto the arena (`shapeNominalOfTy`), but the render
  // (`tn`) stays: it is the artefact `synthParamAnnots` mints from, and its emptiness is the
  // inference-hole gate (a `TyVar` renders ""). The gate order is deliberately unchanged —
  // hoisting the arena rung above the render would make the hole gate conditional.
  const nom = shapeNominalOfTy(nodeTyIxOf(pIx))
  if nom != "" { return nom }
  tn
}

export function synthParamAnnots() {
  let fe = 0
  while fe < fnStmts.length {
    const fn = nodeAt(fnStmts[fe])
    if fn is FuncDecl {
      const ps = fn.fnParams
      let pi = 0
      while pi < ps.length {
        const p = nodeAt(ps[pi])
        if p is Param {
          if p.parType < 0 {
            const upin = recordedParamPinName(ps[pi])
            if upin != "" {
              // `recordNodeTyFrom` is kept rather than deleted, which is what makes passing
              // `srcTy` here exactly equivalent to the old code path rather than nearly so:
              // it rewrites the same value when `srcTy >= 0`, and at -1 (argued unreachable
              // above) the copy still overwrites the placeholder with -1 as it did before.
              const srcTy = nodeTyIxOf(ps[pi])
              const un = synthTypeRefTy(upin, -1, srcTy)
              // Carries the parameter's recorded arena type onto the synthesized annotation,
              // so a consumer classifies the pin structurally instead of re-deriving it from
              // the name. Without it a litunion param's wasm slot and its annotation type
              // disagreed — invalid wasm, and a bare `print` on the raw atom id.
              recordNodeTyFrom(un, ps[pi])
              p.parType = un
            }
          }
        }
        pi = pi + 1
      }
    }
    fe = fe + 1
  }
  0
}

// ── capture by reference ──────────────────────────────────────────────────────────────────
// A closure copies its captures, so a binding that can change after a closure captured it is
// boxed in a one-element list both scopes index: `let c = init` becomes `let c = [init]` and
// every use `c[0]`; a parameter or loop variable gets a cell `c$cb` seeded from it (D2339).

// Every table below is keyed by a binding's declaration node: a `let`, a parameter, a for-range
// loop or a for-in `LoopVar`. A read finds its binding by `identDeclOf`, so a nested binding of
// the same name is a different key and needs no shadow bookkeeping.

// The declarations already in the current frame's `dlets`, so its dedupe is a probe rather than
// a scan of every earlier binding (D2090). Reset per frame by `cboxFrameReset`.
let cboxDletSeen: {[i32]: i32} = Map()

// What declared each of the frame's bindings: a `let`, a parameter, a for-in variable or a
// for-range variable.
const CBOX_LET = 0
const CBOX_PARAM = 1
const CBOX_FORIN = 2
const CBOX_FORRANGE = 3
let cboxKind: {[i32]: i32} = Map()

// The loops of the frame as a tree (`cboxLoopUp[l]` encloses loop `l`, -1 is the frame's top),
// the loop being scanned, and the loop each binding is declared in. A binding declared inside a
// loop is a fresh one per iteration.
let cboxLoopUp: i32[] = []
let cboxLoopAt = -1
let cboxDeclLoop: {[i32]: i32} = Map()

// The `if` arms of the frame as a tree the same way: arm `a` is side `cboxArmSide[a]` (0 then,
// 1 else) of the `if` at node `cboxArmIf[a]`. Two events in different arms of one `if` exclude
// each other, unless a loop re-runs the `if`.
let cboxArmUp: i32[] = []
let cboxArmIf: i32[] = []
let cboxArmSide: i32[] = []
let cboxArmAt = -1

// In walk order, each capture (a function nested one level in the frame that names the binding)
// and each assignment by the frame itself, as per-binding lists threaded through `*Next`, with the
// loop and arm it sits in. `cboxFn*` describe the nested function being scanned.
let cboxOrd = 0
let cboxFnOrd = -1
let cboxFnLoop = -1
let cboxFnArm = -1
// The walk order a call with named arguments starts at, or -1: its arguments run in parameter
// order, not source order, so a closure among them counts as created before any of them.
let cboxArgFloor = -1
let cboxCapSeen: {[i32]: i32} = Map()
let cboxCapHead: {[i32]: i32} = Map()
let cboxCapNext: i32[] = []
let cboxCapOrd: i32[] = []
let cboxCapLoop: i32[] = []
let cboxCapArm: i32[] = []
let cboxAsgHead: {[i32]: i32} = Map()
let cboxAsgNext: i32[] = []
let cboxAsgOrd: i32[] = []
let cboxAsgLoop: i32[] = []
let cboxAsgArm: i32[] = []

// The cell a boxed parameter or loop variable is read through; a boxed `let` is its own cell.
let cboxCellOf: {[i32]: string} = Map()
// The `let` declaring the cell of each boxed parameter or loop variable, which a read of the
// cell resolves to.
let cboxCellDecl: {[i32]: i32} = Map()

// The arena type of each boxed binding's cell list, or absent when the binding carries no
// annotation. The `c` a use is rewritten to reads it, so a store through `c[0]` sees the
// element type the checker gave the binding (D2168).
let cboxCellTy: {[i32]: i32} = Map()

// The declaration the `Ident` at `ix` reads, when it is one of the frame's boxed bindings, or -1.
function cboxBoxedDeclOf(ix: i32, boxed: i32[]): i32 {
  const d = identDeclOf(ix)
  if d >= 0 && i32ListHas(boxed, d) { return d }
  -1
}

// Clears the per-frame tables before a frame is scanned.
function cboxFrameReset() {
  cboxDletSeen = Map()
  cboxCellTy = Map()
  cboxVecCells = Map()
  cboxKind = Map()
  cboxLoopUp = []
  cboxLoopAt = -1
  cboxDeclLoop = Map()
  cboxOrd = 0
  cboxFnOrd = -1
  cboxFnLoop = -1
  cboxFnArm = -1
  cboxArgFloor = -1
  cboxArmUp = []
  cboxArmIf = []
  cboxArmSide = []
  cboxArmAt = -1
  cboxCapSeen = Map()
  cboxCapHead = Map()
  cboxCapNext = []
  cboxCapOrd = []
  cboxCapLoop = []
  cboxCapArm = []
  cboxAsgHead = Map()
  cboxAsgNext = []
  cboxAsgOrd = []
  cboxAsgLoop = []
  cboxAsgArm = []
  cboxCellOf = Map()
  cboxCellDecl = Map()
  0
}

// Lists the binding declared at `decl`, of kind `kind`, among the frame's own, declared in the
// current loop.
function cboxDeclare(kind: i32, decl: i32, dlets: i32[]) {
  if decl < 0 || (cboxDletSeen[decl] ?? 0) != 0 { return 0 }
  cboxDletSeen[decl] = 1
  dlets.push(decl)
  cboxKind[decl] = kind
  cboxDeclLoop[decl] = cboxLoopAt
  0
}

// Opens a loop nested in the current one; `cboxLoopClose` returns to its parent.
function cboxLoopOpen() {
  cboxLoopUp.push(cboxLoopAt)
  cboxLoopAt = cboxLoopUp.length - 1
  0
}

function cboxLoopClose() {
  if cboxLoopAt >= 0 { cboxLoopAt = cboxLoopUp[cboxLoopAt] }
  0
}

// Records that the nested function being scanned reads the binding declared at `d`, once per
// function.
function cboxNoteCap(d: i32) {
  if d < 0 || (cboxCapSeen[d] ?? -1) == cboxFnOrd { return 0 }
  cboxCapSeen[d] = cboxFnOrd
  cboxCapNext.push(cboxCapHead[d] ?? -1)
  cboxCapHead[d] = cboxCapOrd.length
  cboxCapOrd.push(cboxFnOrd)
  cboxCapLoop.push(cboxFnLoop)
  cboxCapArm.push(cboxFnArm)
  0
}

// Records an assignment by the frame itself to the binding declared at `d`, ordered after its
// operands.
function cboxNoteAsg(d: i32) {
  cboxOrd = cboxOrd + 1
  if d < 0 { return 0 }
  cboxAsgNext.push(cboxAsgHead[d] ?? -1)
  cboxAsgHead[d] = cboxAsgOrd.length
  cboxAsgOrd.push(cboxOrd)
  cboxAsgLoop.push(cboxLoopAt)
  cboxAsgArm.push(cboxArmAt)
  0
}

// Opens side `side` of the `if` at node `ifIx` as an arm nested in the current one.
function cboxArmOpen(ifIx: i32, side: i32) {
  cboxArmUp.push(cboxArmAt)
  cboxArmIf.push(ifIx)
  cboxArmSide.push(side)
  cboxArmAt = cboxArmUp.length - 1
  0
}

// True when arms `a` and `b` lie in different sides of one `if`, so one pass runs at most one.
function cboxArmsExclude(a: i32, b: i32) {
  let x = a
  while x >= 0 {
    let y = b
    while y >= 0 {
      if cboxArmIf[y] == cboxArmIf[x] {
        return cboxArmSide[y] != cboxArmSide[x]
      }
      y = cboxArmUp[y]
    }
    x = cboxArmUp[x]
  }
  false
}

// The innermost loop enclosing both loop `a` and loop `b`, or -1 for the frame's top.
function cboxLoopMeet(a: i32, b: i32) {
  let x = a
  while x >= 0 {
    let y = b
    while y >= 0 {
      if y == x { return x }
      y = cboxLoopUp[y]
    }
    x = cboxLoopUp[x]
  }
  -1
}

// True when a closure can observe a change to the binding declared at `d` made after it
// captured it: a closure writes it (`alam`), the frame assigns it later in walk order than a
// capture and not in the other arm of an `if`, or the two share a loop that re-runs the capture
// against the same binding (a loop other than the one the binding is declared in).
function cboxByRef(d: i32, alam: i32[]) {
  if i32ListHas(alam, d) { return true }
  const declLoop = cboxDeclLoop[d] ?? -1
  let ci = cboxCapHead[d] ?? -1
  while ci >= 0 {
    let ai = cboxAsgHead[d] ?? -1
    while ai >= 0 {
      if cboxLoopMeet(cboxCapLoop[ci], cboxAsgLoop[ai]) != declLoop {
        return true
      }
      if (
        cboxAsgOrd[ai] > cboxCapOrd[ci]
        && !cboxArmsExclude(cboxCapArm[ci], cboxAsgArm[ai])
      ) {
        return true
      }
      ai = cboxAsgNext[ai]
    }
    ci = cboxCapNext[ci]
  }
  false
}

// `cboxScan`'s `if` arm: each link of an `else if` chain, its arms opened in turn at depth 0.
function cboxScanIf(ix: i32, depth: i32, dlets: i32[], alam: i32[]) {
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990); each
  // link's condition and arms sit in the else arm of the link before it.
  const armMark = cboxArmAt
  let cur = ix
  while cur >= 0 {
    const c = nodeAt(cur)
    const at = cur
    cur = -1
    if c is IfStmt {
      cboxScan(c.ifCond, depth, dlets, alam)
      const up = cboxArmAt
      if depth == 0 { cboxArmOpen(at, 0) }
      cboxScan(c.ifThen, depth, dlets, alam)
      cboxArmAt = up
      if c.ifElse >= 0 {
        if depth == 0 { cboxArmOpen(at, 1) }
        if nodeAt(c.ifElse) is IfStmt {
          cur = c.ifElse
        } else {
          cboxScan(c.ifElse, depth, dlets, alam)
        }
      }
    }
  }
  cboxArmAt = armMark
  0
}

// `cboxScan`'s range-loop arm: the bounds, then the body, with the loop variable declared when
// the loop is the frame's own.
function cboxScanForRange(
  ix: i32,
  n: ForRange,
  depth: i32,
  dlets: i32[],
  alam: i32[],
) {
  cboxScan(n.frFrom, depth, dlets, alam)
  cboxScan(n.frTo, depth, dlets, alam)
  cboxScan(n.frStep, depth, dlets, alam)
  if depth == 0 {
    cboxLoopOpen()
    cboxDeclare(CBOX_FORRANGE, ix, dlets)
  }
  cboxScan(n.frBody, depth, dlets, alam)
  if depth == 0 { cboxLoopClose() }
  0
}

// `cboxScan`'s for-in arm: the iterable, then the body, with its one or two variables declared
// when the loop is the frame's own.
function cboxScanForIn(n: ForIn, depth: i32, dlets: i32[], alam: i32[]) {
  cboxScan(n.fiIter, depth, dlets, alam)
  if depth == 0 {
    cboxLoopOpen()
    cboxDeclare(CBOX_FORIN, n.fiDecl1, dlets)
    if n.fiVar2 != "" { cboxDeclare(CBOX_FORIN, n.fiDecl2, dlets) }
  }
  cboxScan(n.fiBody, depth, dlets, alam)
  if depth == 0 { cboxLoopClose() }
  0
}

// The binding the `Ident` at `ix` reads, in `alam` unless already there.
function cboxAlamNote(ix: i32, alam: i32[]) {
  const d = identDeclOf(ix)
  if d >= 0 && !i32ListHas(alam, d) { alam.push(d) }
  0
}

// One scan of a frame body at nesting `depth` (0 is the frame's own code): lists the frame's
// bindings in `dlets`, the bindings a nested function assigns in `alam`, and the captures,
// assignments and loops `cboxByRef` compares.
function cboxScan(ix: i32, depth: i32, dlets: i32[], alam: i32[]) {
  if ix < 0 { return 0 }
  const n = nodeAt(ix)
  match n {
    Ident => {
      if depth > 0 { cboxNoteCap(identDeclOf(ix)) }
      return 0
    }
    FuncDecl => {
      if depth == 0 {
        cboxOrd = cboxOrd + 1
        cboxFnOrd = cboxOrd
        if cboxArgFloor >= 0 { cboxFnOrd = cboxArgFloor }
        cboxFnLoop = cboxLoopAt
        cboxFnArm = cboxArmAt
      }
      return cboxScan(n.fnBody, depth + 1, dlets, alam)
    }
    LetDecl => {
      cboxScan(n.letInit, depth, dlets, alam)
      if depth == 0 { cboxDeclare(CBOX_LET, ix, dlets) }
      return 0
    }
    Block => {
      const bs = n.blkStmts
      let i = 0
      while i < bs.length {
        cboxScan(bs[i], depth, dlets, alam)
        i = i + 1
      }
      return 0
    }
    BinExpr => {
      if n.binOp == "=" && depth > 0 && nodeAt(n.binLeft) is Ident {
        cboxAlamNote(n.binLeft, alam)
      }
      cboxScan(n.binLeft, depth, dlets, alam)
      cboxScan(n.binRight, depth, dlets, alam)
      if n.binOp == "=" && depth == 0 {
        const wl = unwrapParen(n.binLeft)
        if wl >= 0 && nodeAt(wl) is Ident { cboxNoteAsg(identDeclOf(wl)) }
      }
      return 0
    }
    IfStmt => {
      return cboxScanIf(ix, depth, dlets, alam)
    }
    WhileStmt => {
      if depth == 0 { cboxLoopOpen() }
      cboxScan(n.whileCond, depth, dlets, alam)
      cboxScan(n.whileBody, depth, dlets, alam)
      if depth == 0 { cboxLoopClose() }
      return 0
    }
    ForRange => {
      return cboxScanForRange(ix, n, depth, dlets, alam)
    }
    ForIn => {
      return cboxScanForIn(n, depth, dlets, alam)
    }
    RetStmt => {
      return cboxScan(n.retArg, depth, dlets, alam)
    }
    Unary => {
      return cboxScan(n.unArg, depth, dlets, alam)
    }
    Paren => {
      return cboxScan(n.parInner, depth, dlets, alam)
    }
    Member => {
      return cboxScan(n.memObj, depth, dlets, alam)
    }
    OptMember => {
      return cboxScan(n.omObj, depth, dlets, alam)
    }
    Index => {
      cboxScan(n.idxArr, depth, dlets, alam)
      return cboxScan(n.idxIndex, depth, dlets, alam)
    }
    IsExpr => {
      cboxScan(n.isObj, depth, dlets, alam)
      // `x is L` may store an empty `L` back into `x`, so it writes `x` as an assignment does.
      const wo = unwrapParen(n.isObj)
      if wo >= 0 && nodeAt(wo) is Ident && cboxIsMayStore(ix, n.isObj) {
        if depth == 0 {
          cboxNoteAsg(identDeclOf(wo))
        } else {
          cboxAlamNote(wo, alam)
        }
      }
      return 0
    }
    AsExpr => {
      return cboxScan(n.asObj, depth, dlets, alam)
    }
    Call => {
      cboxScan(n.callFn, depth, dlets, alam)
      const savedFloor = cboxArgFloor
      if depth == 0 && savedFloor < 0 && hasNamedArgs(n.callArgNames) {
        cboxArgFloor = cboxOrd
      }
      const args = n.callArgs
      let ci = 0
      while ci < args.length {
        cboxScan(args[ci], depth, dlets, alam)
        ci = ci + 1
      }
      cboxArgFloor = savedFloor
      return 0
    }
    // A spread's source is an operand like any other (D2334).
    Spread => {
      return cboxScan(n.spdArg, depth, dlets, alam)
    }
    ArrayLit => {
      const es = n.arrElems
      let ei = 0
      while ei < es.length {
        cboxScan(es[ei], depth, dlets, alam)
        ei = ei + 1
      }
      return 0
    }
    ObjLit => {
      const fs = n.objFields
      let fi = 0
      while fi < fs.length {
        const f = nodeAt(fs[fi])
        if f is FieldInit { cboxScan(f.fiValue, depth, dlets, alam) }
        fi = fi + 1
      }
      return 0
    }
    // every other kind binds and captures nothing, so it has no capture to box
    NumLit | StrLit | CharLit | BoolLit | NullLit | ErrExpr | Param | TypeRef | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | MatchExpr | ImportDecl | LoopVar => {}
  }
  0
}

// Whether `is` test `isIx` over operand `obj` may store an empty list of its tested type back
// into the operand: the test names a list type and the operand is a union with another list
// arm, which fits when empty (D4949).
function cboxIsMayStore(isIx: i32, obj: i32): boolean {
  const chk = isVarTyIxOf(isIx)
  const ot = nodeTyIxOf(obj)
  if chk < 0 || chk >= T.tys.length || ot < 0 || ot >= T.tys.length {
    return false
  }
  if !(tyAt(chk) is TyArray) { return false }
  const u = tyAt(ot)
  if u is TyUnion {
    for m in u.uMembers {
      if m >= 0 && m < T.tys.length && tyAt(m) is TyArray && !tySame(m, chk) {
        return true
      }
    }
  }
  false
}

// The boxed binding read on the left of `n` when `n` is a `??` or an `=` (`c ?? d`, `(c) = e`),
// or -1.
function cboxTypedLeftDecl(n: BinExpr, boxed: i32[]) {
  if n.binOp != "??" && n.binOp != "=" { return -1 }
  const l = unwrapParen(n.binLeft)
  if l < 0 || !(nodeAt(l) is Ident) { return -1 }
  cboxBoxedDeclOf(l, boxed)
}

// An un-annotated function whose value is a write `v = e` to a boxed cell yields `e` at the
// assignment's type; a re-read of `v[0]` yields the cell's. Where they differ (`Q` into
// `Q | null`) the tail becomes `const t = e; v = t; t` with `t` read at its own type, arm by arm
// under a tail `if`; a literal `e` keeps its store and is yielded as a copy (D2285).
let cboxYieldCtr = 0

// The `__cbv` locals `cboxYieldTail` moved a binding write's value into, by declaration. That
// value is still one a binding is written with, which the emitter tells apart from any other
// value (D4123).
let cboxWriteLets: {[i32]: i32} = Map()
// Whether `let` `d`, or the declaration a monomorphized copy `d` stands for, is such a local.
export function cboxIsWriteLet(d: i32): boolean {
  (cboxWriteLets[cboxDeclKey(d)] ?? 0) == 1
}
function cboxYieldTail(blockIx: i32, boxed: i32[]) {
  const b = nodeAt(blockIx)
  if !(b is Block) { return 0 }
  const st = b.blkStmts
  if st.length == 0 { return 0 }
  const tx = st[st.length - 1]
  const tn = nodeAt(tx)
  if tn is IfStmt {
    if tn.ifElse < 0 { return 0 }
    cboxYieldTail(tn.ifThen, boxed)
    if nodeAt(tn.ifElse) is IfStmt {
      const eb: i32[] = []
      eb.push(tn.ifElse)
      tn.ifElse = mkBlock(eb, -1)
    }
    return cboxYieldTail(tn.ifElse, boxed)
  }
  if !(tn is BinExpr) { return 0 }
  const bd = cboxTypedLeftDecl(tn, boxed)
  if bd < 0 || tn.binOp != "=" { return 0 }
  if nodeAt(unwrapParen(tn.binRight)) is NullLit { return 0 }
  const elemTy = tyArrayElemIx(cboxCellTy[bd] ?? -1)
  const valTy = nodeTyIxOf(tx)
  if elemTy < 0 || valTy < 0 || tySame(elemTy, valTy) { return 0 }
  if tyIsLitUnionOrLit(elemTy) { return 0 }
  const lit = cboxLitCopy(tn.binRight)
  if lit >= 0 {
    nodeTyRecord(lit, valTy)
    st.push(lit)
    plCacheBust()
    return 0
  }
  const tname = "__cbv" + i32ToStr(cboxYieldCtr)
  cboxYieldCtr = cboxYieldCtr + 1
  const tlet = mkLet("const", tname, -1, tn.binRight, tn.pos)
  cboxWriteLets[tlet] = 1
  // The temp holds the value as written, which a literal adapts to the cell (`0xfffffffe` into `i64`).
  const initTy = nodeTyIxOf(unwrapParen(tn.binRight))
  const heldTy = if initTy >= 0 { initTy } else { valTy }
  nodeTyRecord(tlet, heldTy)
  const store = mkIdent(tname, -1)
  identFromDecl(store, tlet)
  nodeTyRecord(store, heldTy)
  tn.binRight = store
  const yielded = mkIdent(tname, -1)
  identFromDecl(yielded, tlet)
  nodeTyRecord(yielded, heldTy)
  st[st.length - 1] = tlet
  st.push(tx)
  st.push(yielded)
  plCacheBust()
  0
}

// A fresh copy of the literal at `ix` (string, number, char, boolean), or -1 for any other node.
function cboxLitCopy(ix: i32) {
  const n = nodeAt(unwrapParen(ix))
  match n {
    StrLit => {
      return mkStr(n.strText, -1)
    }
    NumLit => {
      return mkNumTyped(n.numText, -1, nodeTyIxOf(unwrapParen(ix)))
    }
    CharLit => {
      return mkChar(n.charText, -1)
    }
    BoolLit => {
      return mkBool(n.boolVal, -1)
    }
    // any other kind is not a literal and has no copy
    NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// Turns `let` `ix` into its cell: `let c: T = e` becomes `let c: T[] = [e]`, and the cell's
// list type is recorded under `key`, the binding whose reads become `c[0]`. A scalar annotation
// takes its array form so the list classifies as the matching list type (`[0.0]` builds an
// f64 list); an un-annotated cell is the list of its init's recorded type.
function cboxBoxLet(ix: i32, key: i32) {
  const n = nodeAt(ix)
  if !(n is LetDecl) { return 0 }
  if cboxVecBoxLet(ix, n, key) { return 0 }
  if n.letType >= 0 {
    const lt = nodeAt(n.letType)
    if lt is TypeRef {
      // A composite element (`i32 | string`, `S | null`, a function type) is parenthesized,
      // since `nm + "[]"` would bind to its last atom.
      const elemTy = nodeTyIxOf(n.letType)
      let boxedTy = -1
      if elemTy >= 0 { boxedTy = mkArrayTy(elemTy) }
      if boxedTy >= 0 { cboxCellTy[key] = boxedTy }
      const elemName = cboxElemName(n.letType, lt.tyName, elemTy)
      let cellName = elemName + "[]"
      if cboxElemNeedsParens(n.letType, elemName) {
        cellName = "(" + elemName + ")[]"
      }
      n.letType = synthTypeRefTy(cellName, -1, boxedTy)
    }
  }
  if n.letType < 0 {
    // An init that read another cell is already `c[0]`, untyped, its read's type banked aside.
    let initTy = nodeTyIxOf(n.letInit)
    if initTy < 0 && n.letInit >= 0 { initTy = cboxReadTy[n.letInit] ?? -1 }
    if initTy >= 0 { cboxCellTy[key] = mkArrayTy(initTy) }
    // The binding's inferred value union described the value, which is now the cell's
    // element: left standing, it would box the cell literal itself (D2392).
    nliForgetLet(ix)
  }
  const els: i32[] = []
  els.push(n.letInit)
  n.letInit = mkArrayLit(els, -1)
  nodeTyRecord(n.letInit, cboxCellTy[key] ?? -1)
  // The binding holds the cell now, so its own type is the cell's.
  if (cboxCellTy[key] ?? -1) >= 0 { nodeTyRecord(ix, cboxCellTy[key] ?? -1) }
  0
}

// The cell element's spelling: a written annotation's own, and for one the emitter minted
// before the struct table existed, a record (or nullable record) respelled by its declared name,
// since a list of the anonymous shape has no rep.
function cboxElemName(ann: i32, name: string, elemTy: i32): string {
  if annUnionAtomsOf(ann) >= 0 || elemTy < 0 { return name }
  const nn = nonNullTy(elemTy)
  if nn < 0 { return name }
  const nom = shapeNominalOfTy(nn)
  if nom == "" || tyAt(nn) is TyArray { return name }
  if nn != elemTy { return nom + "|null" }
  nom
}

// Whether the cell element spelled `name` at annotation `ann` is composite. An annotation the
// emitter minted has no atom count, so its spelling answers: a top-level `|` or arrow.
function cboxElemNeedsParens(ann: i32, name: string): boolean {
  if annArrowAt(name) >= 0 { return true }
  const atoms = annUnionAtomsOf(ann)
  if atoms < 0 { return tyTopIndexOf(name, '|', 0, 0) >= 0 }
  atoms != 1
}

// A vector has no list backing, so its cell is a list of `v128 | null` boxes: every read
// unboxes with `as!`, and a store boxes (D2826). Keeps such a cell in `cboxVecCells`.
let cboxVecCells: {[i32]: i32} = Map()
// Set while `cboxWalk` rewrites the bare target of an `=`, which a vector cell stores into
// rather than unboxes.
let cboxStoreTarget = false
function cboxVecBoxLet(ix: i32, n: LetDecl, key: i32): boolean {
  let vty = -1
  if n.letType >= 0 {
    vty = nodeTyIxOf(n.letType)
  } else {
    vty = nodeTyIxOf(n.letInit)
  }
  if tyPrimNameOf(vty) != "v128" { return false }
  const cellTy = mkArrayTy(mkNullableTyOf(vty))
  cboxCellTy[key] = cellTy
  cboxVecCells[key] = 1
  if n.letType < 0 { nliForgetLet(ix) }
  n.letType = synthTypeRefTy("(v128|null)[]", -1, cellTy)
  const els: i32[] = []
  els.push(n.letInit)
  n.letInit = mkArrayLit(els, -1)
  nodeTyRecord(n.letInit, cellTy)
  true
}

// A `let <name>$cb = [<name>]` that seeds the cell of boxed parameter or loop variable `name`,
// declared at `decl`, whose value has type `ty` and annotation `annot` (-1 for none). Reads of
// `name` go through the cell from here on, and the cell stands for `decl`.
function cboxSeedLet(name: string, decl: i32, annot: i32, ty: i32) {
  const src = mkIdent(name, -1)
  identFromDecl(src, decl)
  if ty >= 0 { nodeTyRecord(src, ty) }
  const cell = name + "$cb"
  const lx = mkLet("let", cell, annot, src, -1)
  cboxCellDecl[decl] = lx
  cboxCellDecls[cboxDeclKey(lx)] = 1
  cboxBoxLet(lx, decl)
  nodeTyRecord(lx, cboxCellTy[decl] ?? -1)
  cboxCellOf[decl] = cell
  lx
}

// Block `blk` with `first` put before its statements.
function cboxPrepend(blk: i32, first: i32) {
  const b = nodeAt(blk)
  if b is Block {
    const out: i32[] = []
    out.push(first)
    let i = 0
    while i < b.blkStmts.length {
      out.push(b.blkStmts[i])
      i = i + 1
    }
    b.blkStmts = out
    plCacheBust()
  }
  0
}

// `name = cell[0]`: a boxed range variable, declared by the loop `decl`, handed back to the
// loop, which steps from it.
function cboxStoreBack(name: string, decl: i32) {
  const cell = mkIdent(cboxCellOf[decl] ?? name, -1)
  identFromDecl(cell, cboxCellDecl[decl] ?? -1)
  const cellTy = cboxCellTy[decl] ?? -1
  if cellTy >= 0 { nodeTyRecord(cell, cellTy) }
  const tgt = mkIdent(name, -1)
  identFromDecl(tgt, decl)
  mkBinary("=", tgt, mkIndex(cell, mkNumTyped("0", -1, TY_I32), -1), -1)
}

// Puts `name = cell[0]` before each `continue` under `ix` that targets the range loop `decl`
// being rewritten: an unlabelled one outside any inner loop (`nest` 0), or one naming `label`.
function cboxContStoreBack(
  ix: i32,
  name: string,
  decl: i32,
  label: string,
  nest: i32,
) {
  let cur = ix
  while cur >= 0 {
    const n = nodeAt(cur)
    if n is FuncDecl { return 0 }
    if n is Block {
      const bs = n.blkStmts
      const out: i32[] = []
      let i = 0
      while i < bs.length {
        const s = nodeAt(bs[i])
        if s is ContinueStmt {
          if (
            (s.contLabel == "" && nest == 0)
            || (s.contLabel != "" && s.contLabel == label)
          ) {
            out.push(cboxStoreBack(name, decl))
          }
        } else {
          cboxContStoreBack(bs[i], name, decl, label, nest)
        }
        out.push(bs[i])
        i = i + 1
      }
      n.blkStmts = out
      plCacheBust()
      return 0
    }
    let inner = nest
    if n is WhileStmt || n is ForRange || n is ForIn { inner = nest + 1 }
    const kids = nodeValueSpineChildren(cur)
    let k = 0
    while k < kids.length {
      cboxContStoreBack(kids[k], name, decl, label, inner)
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

// Restarts the two name serials at compile start, so the names a program's rewrite mints do not
// depend on what an earlier compile on the instance minted.
export function rewriteCountersReset() {
  cboxYieldCtr = 0
  shrSerial = 0
  0
}

// Point the arm-join rows banked at `ix` (an `if`, or the statement a value-position `if` is the
// whole value of) that name a boxed binding, or a path off one, at the cell the rewritten reads
// go through (`c[0]`, `c[0].v`), so the push after the statement lands on them.
// The rows already renamed: a body is walked once per frame that holds it.
let cboxRenamedRows: {[i32]: boolean} = Map()

function cboxRenameJoins(ix: i32, boxed: i32[]) {
  let r = joinHeadOf(ix)
  while r >= 0 {
    const key = joinRowName(r)
    if cboxRenamedRows[r] ?? false {
      r = joinRowNext(r)
      continue
    }
    const d = declMovedOf(joinRowDecl(r))
    if d >= 0 && i32ListHas(boxed, d) && (cboxVecCells[d] ?? 0) == 0 {
      let cut = 0
      while cut < key.length && key[cut] != '.' && key[cut] != '[' {
        cut = cut + 1
      }
      const cell = cboxCellOf[d] ?? key.slice(0, cut)
      joinRowRename(r, cell + "[0]" + key.slice(cut, key.length))
      cboxRenamedRows[r] = true
    }
    r = joinRowNext(r)
  }
  0
}

// Rewrites the maker body (and its nested lambda bodies): a read of a boxed binding → `c[0]`,
// and a boxed `let c = init` → `let c = [init]`. Returns the (possibly replaced) node index so
// parents reassign — mirrors `drwWalk`, plus descending into `FuncDecl` bodies.
function cboxWalk(ix: i32, boxed: i32[]) {
  if ix < 0 { return ix }
  const n = nodeAt(ix)
  match n {
    Ident => {
      return cboxWalkIdent(ix, n, boxed)
    }
    FuncDecl => {
      if n.fnRet < 0 && !lambdaVoidAdoptedAt(ix) {
        cboxYieldTail(n.fnBody, boxed)
      }
      n.fnBody = cboxWalk(n.fnBody, boxed)
      return ix
    }
    Block => {
      const bs = n.blkStmts
      let i = 0
      while i < bs.length {
        bs[i] = cboxWalk(bs[i], boxed)
        i = i + 1
      }
      return ix
    }
    LetDecl => {
      cboxRenameJoins(ix, boxed)
      n.letInit = cboxWalk(n.letInit, boxed)
      if i32ListHas(boxed, ix) { cboxBoxLet(ix, ix) }
      return ix
    }
    BinExpr => {
      return cboxWalkBin(ix, n, boxed)
    }
    IfStmt => {
      return cboxWalkIf(ix, boxed)
    }
    WhileStmt => {
      n.whileCond = cboxWalk(n.whileCond, boxed)
      n.whileBody = cboxWalk(n.whileBody, boxed)
      return ix
    }
    ForRange => {
      return cboxWalkForRange(ix, n, boxed)
    }
    ForIn => {
      return cboxWalkForIn(ix, n, boxed)
    }
    RetStmt => {
      n.retArg = cboxWalk(n.retArg, boxed)
      return ix
    }
    Unary => {
      n.unArg = cboxWalk(n.unArg, boxed)
      return ix
    }
    Paren => {
      n.parInner = cboxWalk(n.parInner, boxed)
      return ix
    }
    Member => {
      n.memObj = cboxWalk(n.memObj, boxed)
      return ix
    }
    OptMember => {
      n.omObj = cboxWalk(n.omObj, boxed)
      return ix
    }
    Index => {
      n.idxArr = cboxWalk(n.idxArr, boxed)
      n.idxIndex = cboxWalk(n.idxIndex, boxed)
      return ix
    }
    IsExpr => {
      n.isObj = cboxWalk(n.isObj, boxed)
      return ix
    }
    AsExpr => {
      n.asObj = cboxWalk(n.asObj, boxed)
      return ix
    }
    Call => {
      const nfn = cboxWalk(n.callFn, boxed)
      if nfn != n.callFn { arenaNoteRefWrite() }
      n.callFn = nfn
      const args = n.callArgs
      let ci = 0
      while ci < args.length {
        args[ci] = cboxWalk(args[ci], boxed)
        ci = ci + 1
      }
      return ix
    }
    // A spread's source is an operand like any other (D2334).
    Spread => {
      n.spdArg = cboxWalk(n.spdArg, boxed)
      return ix
    }
    ArrayLit => {
      const es = n.arrElems
      let ei = 0
      while ei < es.length {
        es[ei] = cboxWalk(es[ei], boxed)
        ei = ei + 1
      }
      return ix
    }
    ObjLit => {
      const fs = n.objFields
      let fi = 0
      while fi < fs.length {
        const f = nodeAt(fs[fi])
        if f is FieldInit { f.fiValue = cboxWalk(f.fiValue, boxed) }
        fi = fi + 1
      }
      return ix
    }
    // every other kind reads no boxed capture, so it is kept as it is
    NumLit | StrLit | CharLit | BoolLit | NullLit | ErrExpr | Param | TypeRef | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | MatchExpr | ImportDecl | LoopVar => {}
  }
  return ix
}

// `cboxWalk`'s name read: a read of a boxed binding becomes `c[0]` over its cell, typed for the
// element questions later phases ask; any other read is `ix` unchanged.
function cboxWalkIdent(ix: i32, n: Ident, boxed: i32[]): i32 {
  const bd = cboxBoxedDeclOf(ix, boxed)
  if bd >= 0 {
    // The cell `c` carries the type of its list, so an element question about `c[0]` has
    // the binding's declared type to answer from. A read `c[0]` records the type the name
    // read had; a store target is typed by the `BinExpr` arm, and a function-typed read
    // stays untyped for the reassigned-binding signature check (rep-descriptor-campaign §13.23).
    const cell = mkIdent(cboxCellOf[bd] ?? n.identName, -1)
    if identAuditDrop != IDENT_DROP_CBOX_READ {
      const cd = cboxCellDecl[bd] ?? -1
      if cd >= 0 { identFromDecl(cell, cd) } else { identFrom(cell, ix) }
    }
    const cellTy = cboxCellTy[bd] ?? -1
    if cellTy >= 0 { nodeTyRecord(cell, cellTy) }
    const rd = mkIndex(cell, mkNumTyped("0", -1, TY_I32), -1)
    const rty = nodeTyIxOf(ix)
    if (cboxVecCells[bd] ?? 0) == 1 {
      if cboxStoreTarget { return rd }
      nodeTyRecord(rd, tyArrayElemIx(cellTy))
      const un = mkAsExpr(rd, "v128", "trap", -1)
      if rty >= 0 { nodeTyRecord(un, rty) }
      return un
    }
    if rd >= 0 && rty >= 0 { cboxReadTy[rd] = rty }
    if rd >= 0 && cboxStoreTarget { cboxStoreCells[rd] = 1 }
    if rd >= 0 && rty >= 0 && !cboxStoreTarget && !(tyAt(rty) is TyFunc) {
      nodeTyRecord(rd, rty)
    }
    if rd >= 0 && !cboxStoreTarget { narrowedFromTyCopy(ix, rd) }
    return rd
  }
  return ix
}

// `cboxWalk`'s binary operator: renames its join rows, walks both operands with the left
// flagged as a store target under `=`, and types a boxed left at its cell's element. Returns `ix`.
function cboxWalkBin(ix: i32, n: BinExpr, boxed: i32[]): i32 {
  cboxRenameJoins(ix, boxed)
  const leftDecl = cboxTypedLeftDecl(n, boxed)
  cboxStoreTarget = n.binOp == "=" && nodeAt(unwrapParen(n.binLeft)) is Ident
  n.binLeft = cboxWalk(n.binLeft, boxed)
  cboxStoreTarget = false
  n.binRight = cboxWalk(n.binRight, boxed)
  // The left of a `??` or `=` is typed at the binding's declared type: the coalesce lowers
  // from its operand's type (a closure may have written the cell since any narrowing), and
  // an assignment re-reads its target as its value only where that type is the value's.
  // A literal-union cell stays untyped: its re-read is the atom whatever the member (D2168).
  if leftDecl >= 0 {
    const elemTy = tyArrayElemIx(cboxCellTy[leftDecl] ?? -1)
    if n.binOp == "??" || !tyIsLitUnionOrLit(elemTy) {
      nodeTyRecord(unwrapParen(n.binLeft), elemTy)
    }
  }
  return ix
}

// `cboxWalk`'s `if`: renames its join rows and walks the `else if` chain. Returns `ix`.
function cboxWalkIf(ix: i32, boxed: i32[]): i32 {
  cboxRenameJoins(ix, boxed)
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    const c = nodeAt(cur)
    cur = -1
    if c is IfStmt {
      c.ifCond = cboxWalk(c.ifCond, boxed)
      c.ifThen = cboxWalk(c.ifThen, boxed)
      if c.ifElse >= 0 {
        if nodeAt(c.ifElse) is IfStmt {
          cur = c.ifElse
        } else {
          c.ifElse = cboxWalk(c.ifElse, boxed)
        }
      }
    }
  }
  return ix
}

// `cboxWalk`'s range loop: walks the bounds and body, and gives a boxed range variable a
// cell per iteration that hands its value back to the counter. Returns `ix`.
function cboxWalkForRange(ix: i32, n: ForRange, boxed: i32[]): i32 {
  n.frFrom = cboxWalk(n.frFrom, boxed)
  n.frTo = cboxWalk(n.frTo, boxed)
  n.frStep = cboxWalk(n.frStep, boxed)
  // A boxed range variable gets a cell per iteration, seeded from the counter, and hands the
  // cell's value back to the counter wherever the iteration ends and the loop steps on.
  let rseed = -1
  if i32ListHas(boxed, ix) { rseed = cboxSeedLet(n.frVar, ix, -1, TY_I32) }
  n.frBody = cboxWalk(n.frBody, boxed)
  if rseed >= 0 {
    cboxContStoreBack(n.frBody, n.frVar, ix, n.frLabel, 0)
    const rb = nodeAt(n.frBody)
    if rb is Block {
      rb.blkStmts.push(cboxStoreBack(n.frVar, ix))
      plCacheBust()
    }
    cboxPrepend(n.frBody, rseed)
  }
  return ix
}

// `cboxWalk`'s for-in loop: walks the iterable and body, and gives each boxed loop variable a
// cell per iteration seeded from the element. Returns `ix`.
function cboxWalkForIn(ix: i32, n: ForIn, boxed: i32[]): i32 {
  n.fiIter = cboxWalk(n.fiIter, boxed)
  // A boxed for-in variable gets a cell per iteration, seeded from the element.
  let iseed = -1
  let iseed2 = -1
  const iterTy = strLitRecvTy(nodeTyIxOf(n.fiIter))
  if i32ListHas(boxed, n.fiDecl1) {
    iseed = cboxSeedLet(n.fiVar, n.fiDecl1, -1, forInBindTy(iterTy, false))
  }
  if n.fiVar2 != "" && i32ListHas(boxed, n.fiDecl2) {
    iseed2 = cboxSeedLet(n.fiVar2, n.fiDecl2, -1, forInBindTy(iterTy, true))
  }
  n.fiBody = cboxWalk(n.fiBody, boxed)
  if iseed2 >= 0 { cboxPrepend(n.fiBody, iseed2) }
  if iseed >= 0 { cboxPrepend(n.fiBody, iseed) }
  return ix
}

// A zero value for a `let` annotated `letType` that has no init, typed at the annotation, or
// -1 where the type has none to offer; the box needs something to hold before the first
// assignment (a read before it is a definite-assignment error).
function cboxZeroInit(letType: i32) {
  if letType < 0 { return -1 }
  const lt = nodeAt(letType)
  if !(lt is TypeRef) { return -1 }
  const nm = lt.tyName
  let lit = -1
  if nm == "i32" || nm == "i64" || nm == "u8" {
    lit = mkNumTyped("0", -1, nodeTyIxOf(letType))
  }
  if nm == "f64" || nm == "f32" {
    lit = mkNumTyped("0.0", -1, nodeTyIxOf(letType))
  }
  if nm == "boolean" { lit = mkBool(0, -1) }
  if nm == "string" { lit = mkStr("", -1) }
  if lit >= 0 { nodeTyRecord(lit, nodeTyIxOf(letType)) }
  lit
}

// The refusal for shared binding `nm` whose type has no zero value (D2340). Built in two
// short chains: an interpolated string in the compiler source leaves the seed importing `print`.
function cboxNoInitMsg(nm: string) {
  const q = "`" + nm + "`"
  q
    + " is assigned after a closure captures it, so the closure shares it, and a shared binding of its type needs an initializer: give "
    + q
    + " one"
}

// The frame's bindings `cboxByRef` says a closure must share, from `dlets`. A `let` with no
// init takes a zero value to box; one whose type has none cannot be boxed and is refused,
// since capturing it by value would be silently wrong. A declaration in `unboxed` stays a local.
function cboxPick(dlets: i32[], alam: i32[], unboxed: i32[]) {
  const boxed: i32[] = []
  let di = 0
  while di < dlets.length {
    const d = dlets[di]
    if cboxByRef(d, alam) && !i32ListHas(unboxed, d) {
      let ok = true
      const isLet = (cboxKind[d] ?? CBOX_LET) == CBOX_LET
      if isLet {
        const ld = nodeAt(d)
        if ld is LetDecl {
          if ld.letInit < 0 { ld.letInit = cboxZeroInit(ld.letType) }
          if ld.letInit < 0 {
            emitFailAt(cboxNoInitMsg(ld.letName), d)
            ok = false
          }
        }
      }
      if ok {
        boxed.push(d)
        // A `let` becomes its own cell; any other binding's `$cb` cell is marked where it is seeded.
        if isLet { cboxCellDecls[cboxDeclKey(d)] = 1 }
      }
    }
    di = di + 1
  }
  boxed
}

// The frame's `let`s of a scalar type that `cboxByRef` says a closure must share: those a
// lifted closure can take by value and hand back (D3664). Returns their names, with each
// declaration pushed to `decls` and its type to `tys` in step.
function cboxScalarLets(
  dlets: i32[],
  alam: i32[],
  decls: i32[],
  tys: i32[],
): string[] {
  const out: string[] = []
  let di = 0
  while di < dlets.length {
    const d = dlets[di]
    if (cboxKind[d] ?? CBOX_LET) == CBOX_LET && cboxByRef(d, alam) {
      const ld = nodeAt(d)
      if ld is LetDecl {
        let ty = -1
        if ld.letType >= 0 {
          ty = nodeTyIxOf(ld.letType)
        } else {
          ty = nodeTyIxOf(ld.letInit)
        }
        const pn = tyPrimNameOf(ty)
        if (
          pn == "i32"
          || pn == "i64"
          || pn == "f64"
          || pn == "f32"
          || pn == "boolean"
        ) {
          out.push(ld.letName)
          decls.push(d)
          tys.push(ty)
        }
      }
    }
    di = di + 1
  }
  out
}

// Per function frame (top-level or nested): boxes each binding a closure must share with it
// (`cboxByRef`) — a `let`, a parameter, or a loop variable — and rewrites every use to go
// through the cell. Usage-gated: a frame with no such binding rewrites nothing.
export function captureBoxRewrite(_stmts: i32[]) {
  cboxWriteLets = Map()
  cboxCellDecls = Map()
  cboxReadTy = Map()
  cboxStoreCells = Map()
  cboxRenamedRows = Map()
  let fe = 0
  while fe < fnStmts.length {
    const fn = nodeAt(fnStmts[fe])
    if fn is FuncDecl {
      cboxFrameReset()
      const dlets: i32[] = []
      const alam: i32[] = []
      const ps = fn.fnParams
      let pi = 0
      while pi < ps.length {
        const p = nodeAt(ps[pi])
        if p is Param { cboxDeclare(CBOX_PARAM, ps[pi], dlets) }
        pi = pi + 1
      }
      cboxScan(fn.fnBody, 0, dlets, alam)
      const cdecls: i32[] = []
      const tys: i32[] = []
      const cands = cboxScalarLets(dlets, alam, cdecls, tys)
      const unboxedNames = cloUnboxPick(fe, cands, tys)
      const unboxed: i32[] = []
      let ui = 0
      while ui < cands.length {
        if strListHas(unboxedNames, cands[ui]) { unboxed.push(cdecls[ui]) }
        ui = ui + 1
      }
      const boxed = cboxPick(dlets, alam, unboxed)
      if boxed.length > 0 {
        // A parameter's cell is seeded at the top of the body, from the argument. An optional
        // parameter's annotation names only the non-null part, so it takes its recorded type.
        const seeds: i32[] = []
        pi = 0
        while pi < ps.length {
          const p = nodeAt(ps[pi])
          if p is Param {
            if i32ListHas(boxed, ps[pi]) {
              let annot = p.parType
              if p.parOpt != 0 { annot = -1 }
              seeds.push(
                cboxSeedLet(p.parName, ps[pi], annot, nodeTyIxOf(ps[pi])),
              )
            }
          }
          pi = pi + 1
        }
        fn.fnBody = cboxWalk(fn.fnBody, boxed)
        let si = seeds.length - 1
        while si >= 0 {
          cboxPrepend(fn.fnBody, seeds[si])
          si = si - 1
        }
      }
    }
    fe = fe + 1
  }
  cboxModuleFrame()
}

// The module frame's share of the rule: a `let` in a module-scope block, and a module-scope
// loop variable, is a start-function local, so it boxes as a function frame's does. A
// top-level binding is a global, which a closure reads and assigns in place, and is not among
// these statements.
function cboxModuleFrame() {
  cboxFrameReset()
  const dlets: i32[] = []
  const alam: i32[] = []
  let si = 0
  while si < startStmts.length {
    cboxScan(startStmts[si], 0, dlets, alam)
    si = si + 1
  }
  const none: i32[] = []
  const boxed = cboxPick(dlets, alam, none)
  if boxed.length == 0 { return 0 }
  let wi = 0
  while wi < startStmts.length {
    startStmts[wi] = cboxWalk(startStmts[wi], boxed)
    wi = wi + 1
  }
  0
}

// ── shadow respelling (D2068) ─────────────────────────────────────────────────────────────
// Capture questions are asked by name within a frame, while a binding is scoped by its block.
// So a binding that makes such a question ambiguous is respelled here, with every read it
// denotes; `shrDeclare` states which bindings those are.

// The names read inside a function nested in the frame being walked.
let shrLamNames: {[string]: i32} = Map()
let shrLamAny = false
// Names a function nested in the frame being walked takes as a parameter, and names such a
// function reads where no nested function around the read takes one of that name (D3025).
let shrLamParams: {[string]: i32} = Map()
let shrLamFree: {[string]: i32} = Map()
// The module's top-level bindings and function names, visible from every frame.
let shrGlobals: {[string]: i32} = Map()
// Per source name, the spelling of its innermost open binding ("" when none is open) and the
// frame depth that binding belongs to.
let shrCur: {[string]: string} = Map()
let shrCurDepth: {[string]: i32} = Map()
// The names the frame being walked has bound so far, in any of its blocks.
let shrFrameSeen: {[string]: i32} = Map()
// The one spelling the frame being walked gives its bindings that shadow an enclosing frame's.
let shrFrameShared: {[string]: string} = Map()
let shrDepth = 0
// The open bindings as (source name, shadowed spelling, shadowed depth), trimmed on scope exit.
const shrTrailName: string[] = []
const shrTrailPrev: string[] = []
const shrTrailPrevDepth: i32[] = []
let shrSerial = 0

// Records in `shrLamNames` every identifier under `ix` that sits inside a nested function;
// `inFn` says whether `ix` already does. An `else if` chain is walked along its spine.
function shrCollect(ix: i32, inFn: boolean) {
  let cur = ix
  while cur >= 0 && cur < P.nodes.length {
    const n = nodeAt(cur)
    if n is Ident {
      if inFn {
        shrLamNames[n.identName] = 1
        shrLamAny = true
      }
      return 0
    }
    let inner = inFn
    if n is FuncDecl { inner = true }
    const kids = nodeValueSpineChildren(cur)
    let i = 0
    while i < kids.length {
      shrCollect(kids[i], inner)
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

// Records `shrLamParams` and `shrLamFree` under `ix`, where `ps` holds the parameters of the
// nested functions around it and `inFn` says whether there is one. An `else if` chain is walked
// along its spine.
function shrCollectParams(ix: i32, ps: string[], inFn: boolean) {
  let cur = ix
  while cur >= 0 && cur < P.nodes.length {
    const n = nodeAt(cur)
    if n is Ident {
      if inFn && !strListHas(ps, n.identName) { shrLamFree[n.identName] = 1 }
      return 0
    }
    if n is FuncDecl {
      const inner: string[] = []
      let i = 0
      while i < ps.length {
        inner.push(ps[i])
        i = i + 1
      }
      let pi = 0
      while pi < n.fnParams.length {
        const pn = nodeAt(n.fnParams[pi])
        if pn is Param {
          shrLamParams[pn.parName] = 1
          inner.push(pn.parName)
        }
        pi = pi + 1
      }
      return shrCollectParams(n.fnBody, inner, true)
    }
    const kids = nodeValueSpineChildren(cur)
    let i = 0
    while i < kids.length {
      shrCollectParams(kids[i], ps, inFn)
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

// Whether a binding of `name` in the frame being walked is read by a nested function that
// reaches it through another nested function taking a parameter of that name: a capture
// forwarded by name would resolve to the parameter, so the binding needs its own spelling.
function shrParamShadows(name: string): boolean {
  (shrLamFree[name] ?? 0) == 1 && (shrLamParams[name] ?? 0) == 1
}

// A fresh spelling of `name`.
function shrMint(name: string): string {
  shrSerial = shrSerial + 1
  name + "$s" + i32ToStr(shrSerial)
}

// Opens a binding of `name` and returns the spelling it carries. With `respell`, a binding a
// nested function reads gets a unique spelling when another binding of the name is visible or
// earlier in the frame, since captures resolve by name within a frame; one that shadows an
// enclosing frame's binding or a module name, or the frame's shared spelling, gets that spelling.
function shrDeclare(name: string, respell: boolean): string {
  let sp = name
  if respell && name != "" {
    const open = (shrCur[name] ?? "") != ""
    if (
      (shrLamNames[name] ?? 0) == 1
      && (open
        || (shrFrameSeen[name] ?? 0) == 1
        || (shrGlobals[name] ?? 0) == 1
        || shrParamShadows(name))
    ) {
      sp = shrMint(name)
    } else if (
      (open && (shrCurDepth[name] ?? 0) < shrDepth)
      || (open && shrCur[name] == (shrFrameShared[name] ?? ""))
      || (!open && (shrGlobals[name] ?? 0) == 1)
    ) {
      const shared = shrFrameShared[name] ?? ""
      if shared != "" {
        sp = shared
      } else {
        sp = shrMint(name)
        shrFrameShared[name] = sp
      }
    }
  }
  shrOpen(name, sp)
}

// Opens a binding of `name` spelled `sp`, and returns `sp`.
function shrOpen(name: string, sp: string): string {
  shrTrailName.push(name)
  shrTrailPrev.push(shrCur[name] ?? "")
  shrTrailPrevDepth.push(shrCurDepth[name] ?? 0)
  shrCur[name] = sp
  shrCurDepth[name] = shrDepth
  shrFrameSeen[name] = 1
  sp
}

// Closes the bindings opened since `mark` (a `shrTrailName.length`), so each name again
// denotes what it denoted before them.
function shrTrim(mark: i32) {
  while shrTrailName.length > mark {
    const top = shrTrailName.length - 1
    shrCur[shrTrailName[top]] = shrTrailPrev[top]
    shrCurDepth[shrTrailName[top]] = shrTrailPrevDepth[top]
    shrTrailName.pop()
    shrTrailPrev.pop()
    shrTrailPrevDepth.pop()
  }
  0
}

// Opens function `fnIx`'s own frame — a fresh one, whose parameters keep their spellings and
// whose nested functions' reads are collected anew — walks its body, and closes it again.
function shrWalkFrame(fnIx: i32) {
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    const savedSeen = shrFrameSeen
    const savedShared = shrFrameShared
    const savedLam = shrLamNames
    const savedAny = shrLamAny
    const savedParams = shrLamParams
    const savedFree = shrLamFree
    shrFrameSeen = Map()
    shrFrameShared = Map()
    shrLamNames = Map()
    shrLamAny = false
    shrLamParams = Map()
    shrLamFree = Map()
    shrCollect(fn.fnBody, false)
    shrCollectParams(fn.fnBody, [], false)
    shrDepth = shrDepth + 1
    const mark = shrTrailName.length
    const ps = fn.fnParams
    // A parameter keeps its spelling, which a named argument matches, so one that needs its own
    // is copied into a respelled local at the top of the body.
    const seeds: i32[] = []
    let pi = 0
    while pi < ps.length {
      const p = nodeAt(ps[pi])
      if p is Param {
        if shrParamNeedsSeed(p.parName, fn.fnBody) {
          const sp = shrMint(p.parName)
          let annot = p.parType
          if p.parOpt != 0 { annot = -1 }
          const src = mkIdent(p.parName, -1)
          identFromDecl(src, ps[pi])
          const pty = nodeTyIxOf(ps[pi])
          if pty >= 0 { nodeTyRecord(src, pty) }
          const seed = mkLet("let", sp, annot, src, -1)
          if pty >= 0 { nodeTyRecord(seed, pty) }
          identFromDecl(seed, ps[pi])
          seeds.push(seed)
          shrOpen(p.parName, sp)
        } else {
          shrDeclare(p.parName, false)
        }
      }
      pi = pi + 1
    }
    shrWalk(fn.fnBody)
    let si = seeds.length - 1
    while si >= 0 {
      cboxPrepend(fn.fnBody, seeds[si])
      si = si - 1
    }
    shrTrim(mark)
    shrDepth = shrDepth - 1
    shrFrameSeen = savedSeen
    shrFrameShared = savedShared
    shrLamNames = savedLam
    shrLamAny = savedAny
    shrLamParams = savedParams
    shrLamFree = savedFree
  }
  0
}

// Whether parameter `name` of the frame whose body is `body` is seeded into a respelled local:
// `shrParamShadows` holds and the body is a block to seed.
function shrParamNeedsSeed(name: string, body: i32): boolean {
  if name == "" || name == "self" { return false }
  if !shrParamShadows(name) { return false }
  if body < 0 || body >= P.nodes.length { return false }
  nodeAt(body) is Block
}

// Respells the bindings under `ix` that `shrDeclare` decides to, and every read of one. A
// block closes its bindings and a loop its variables; an `else if` chain is walked along its
// spine, so its depth costs no stack.
// The arm-join rows already respelled: a row names its binding as the checker spelled it.
let shrJoinDone: {[i32]: boolean} = Map()

// Respell the arm-join rows banked at `ix` whose root this pass gave a new spelling, as it
// respells the reads they describe.
function shrRespellJoins(ix: i32) {
  let r = joinHeadOf(ix)
  while r >= 0 {
    if !(shrJoinDone[r] ?? false) {
      shrJoinDone[r] = true
      const key = joinRowName(r)
      let cut = 0
      while cut < key.length && key[cut] != '.' && key[cut] != '[' {
        cut = cut + 1
      }
      const sp = shrCur[key.slice(0, cut)] ?? ""
      if sp != "" && sp != key.slice(0, cut) {
        joinRowRename(r, sp + key.slice(cut, key.length))
      }
    }
    r = joinRowNext(r)
  }
  0
}

function shrWalk(ix: i32) {
  let cur = ix
  while cur >= 0 && cur < P.nodes.length {
    const n = nodeAt(cur)
    if n is IfStmt || n is LetDecl || n is BinExpr { shrRespellJoins(cur) }
    if n is Ident {
      const sp = shrCur[n.identName] ?? ""
      if sp != "" && sp != n.identName {
        n.identName = sp
        sidNoteNodeName(cur, identDeclOf(cur))
      }
      return 0
    }
    if n is LetDecl {
      shrWalk(n.letInit)
      const lsp = shrDeclare(n.letName, true)
      if lsp != n.letName {
        n.letName = lsp
        sidNoteNodeName(cur, cur)
      }
      return 0
    }
    if n is Block {
      const bmark = shrTrailName.length
      const bs = n.blkStmts
      let bi = 0
      while bi < bs.length {
        shrWalk(bs[bi])
        bi = bi + 1
      }
      shrTrim(bmark)
      return 0
    }
    if n is ForRange {
      shrWalk(n.frFrom)
      shrWalk(n.frTo)
      shrWalk(n.frStep)
      const rmark = shrTrailName.length
      const rsp = shrDeclare(n.frVar, true)
      if rsp != n.frVar {
        n.frVar = rsp
        sidNoteNodeName(cur, cur)
      }
      shrWalk(n.frBody)
      shrTrim(rmark)
      return 0
    }
    if n is ForIn {
      shrWalk(n.fiIter)
      const imark = shrTrailName.length
      const isp = shrDeclare(n.fiVar, true)
      if isp != n.fiVar {
        n.fiVar = isp
        sidNoteNodeName(cur, cur)
      }
      if n.fiVar2 != "" { n.fiVar2 = shrDeclare(n.fiVar2, true) }
      shrWalk(n.fiBody)
      shrTrim(imark)
      return 0
    }
    if n is FuncDecl {
      if n.fnName != "" { shrDeclare(n.fnName, false) }
      return shrWalkFrame(cur)
    }
    const kids = nodeValueSpineChildren(cur)
    let i = 0
    while i < kids.length {
      shrWalk(kids[i])
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

// The pass: the module frame's statements, then each top-level function, each walked only
// when a closure inside it reads some name. Runs before any pass that asks about captures.
export function shadowRespell(stmts: i32[]) {
  shrGlobals = Map()
  shrJoinDone = Map()
  let gi = 0
  while gi < stmts.length {
    const g = nodeAt(stmts[gi])
    if g is LetDecl { shrGlobals[g.letName] = 1 }
    if g is FuncDecl {
      if g.fnName != "" { shrGlobals[g.fnName] = 1 }
    }
    gi = gi + 1
  }
  shrDepth = 0
  shrLamNames = Map()
  shrLamAny = false
  shrLamParams = Map()
  shrLamFree = Map()
  let mi = 0
  while mi < stmts.length {
    if nodeAt(stmts[mi]) !is FuncDecl {
      shrCollect(stmts[mi], false)
      shrCollectParams(stmts[mi], [], false)
    }
    mi = mi + 1
  }
  if shrLamAny {
    shrCur = Map()
    shrCurDepth = Map()
    shrFrameSeen = Map()
    shrFrameShared = Map()
    let si = 0
    while si < stmts.length {
      const st = nodeAt(stmts[si])
      if st is LetDecl {
        // A top-level binding is a module global rather than a frame local, so only its
        // initialiser, which may hold a closure, is walked.
        shrWalk(st.letInit)
      } else if st !is FuncDecl {
        shrWalk(stmts[si])
      }
      si = si + 1
    }
    shrTrim(0)
  }
  let fi = 0
  while fi < stmts.length {
    const fn = nodeAt(stmts[fi])
    if fn is FuncDecl {
      shrLamNames = Map()
      shrLamAny = false
      shrCollect(fn.fnBody, false)
      if shrLamAny {
        shrCur = Map()
        shrCurDepth = Map()
        shrWalkFrame(stmts[fi])
      }
    }
    fi = fi + 1
  }
  0
}

// ── synthVoidTwins — the void twin mint for coerced function values ─────────────
// The emitter half of the `(P…) => T` → `(P…) => void` value coercion. A coerced value is
// called through a `>v` `$fnsig`, so the closure at the seam needs a callee with 0 results
// — the original cannot be it, so this mints one capture-free void twin per coerced target.
let voidTwinTargetFe: i32[] = []
let voidTwinFe: i32[] = []

// The twin minted for target `fe`, or -1.
function voidTwinOfTarget(fe: i32) {
  let i = 0
  while i < voidTwinTargetFe.length {
    if voidTwinTargetFe[i] == fe { return voidTwinFe[i] }
    i = i + 1
  }
  -1
}

// The function void twin `fe` stands in for, or -1 when `fe` is no twin.
export function voidTwinTargetOf(fe: i32) {
  let i = 0
  while i < voidTwinFe.length {
    if voidTwinFe[i] == fe { return voidTwinTargetFe[i] }
    i = i + 1
  }
  -1
}

// The twin to swap in at expression node `nodeIx` resolving to function `fe`, or -1. Both
// keys must agree: the checker granted the coercion at this node, and emit-side scope
// resolution resolves to the very target the twin targets. Either alone is not enough — a
// same-named nested function must keep the original closure.
export function voidTwinForNode(nodeIx: i32, fe: i32) {
  if !voidCoerceValAt(nodeIx) { return -1 }
  voidTwinOfTarget(fe)
}

// The top-level function named `name` (`fnParent < 0`), or -1 — the emit-side twin of
// the checker's `fnDeclIx` gate (duplicates are a checker error).
function topLevelFnByName(name: string) {
  let i = 0
  while i < fnStmts.length {
    if i < fnParent.length {
      if fnParent[i] < 0 {
        const fn = nodeAt(fnStmts[i])
        if fn is FuncDecl {
          if fn.fnName == name { return i }
        }
      }
    }
    i = i + 1
  }
  -1
}

export function synthVoidTwins(_stmts: i32[]) {
  voidTwinTargetFe = []
  voidTwinFe = []
  const nSeams = voidCoerceValCount()
  let i = 0
  while i < nSeams {
    const name = voidCoerceValNameAt(i)
    const target = topLevelFnByName(name)
    if target >= 0 && voidTwinOfTarget(target) < 0 {
      const tfn = nodeAt(fnStmts[target])
      if tfn is FuncDecl {
        // The checker's grant already excluded generics and non-declarations; these
        // emit-side re-checks fail closed — an unmintable target simply gets no twin,
        // and the un-swapped closure keeps its existing behaviour at the call.
        if tfn.fnTyParams.length == 0 {
          let mintable = true
          const nps: i32[] = []
          const argIds: i32[] = []
          let pj = 0
          while pj < tfn.fnParams.length {
            const pn = nodeAt(tfn.fnParams[pj])
            if pn is Param {
              if pn.parType < 0 { mintable = false }
              // Fresh Param nodes sharing the original's annotation node, so the twin's
              // param valtypes — and its `$fnsig` param tokens — byte-match the
              // original's (only the result differs: `>v`).
              const np = mkParam(
                pn.parName,
                pn.parType,
                -1,
                0,
                pn.parRest,
                pn.pos,
              )
              identFrom(np, tfn.fnParams[pj])
              nps.push(np)
              const arg = mkIdent(pn.parName, tfn.pos)
              identFromDecl(arg, np)
              argIds.push(arg)
            } else {
              mintable = false
            }
            pj = pj + 1
          }
          if mintable {
            const noTyParams: string[] = []
            const callee = mkIdent(name, tfn.pos)
            identFromDecl(callee, fnStmts[target])
            const callIx = mkCall(callee, argIds, tfn.pos)
            const bodyIx = mkBlock([callIx], tfn.pos)
            const twin = mkFunc(
              name + "$voidtw",
              noTyParams,
              nps,
              synthTypeRefTy("void", -1, -1),
              bodyIx,
              tfn.pos,
            )
            fnStmts.push(twin)
            fnParent.push(-1)
            fnDispNames.push("")
            fnValUsed = true
            voidTwinTargetFe.push(target)
            voidTwinFe.push(fnStmts.length - 1)
          }
        }
      }
    }
    i = i + 1
  }
  0
}

// ── synthExternValues — a callee for an `extern` taken as a value ────────────────
// A function value is called with its closure env as the leading argument, which a host
// import does not take. So each extern read other than as a callee gets one capture-free
// forwarding function `<name>$extv`, a spelling no program can write, and the read is respelled to name it (D2618).

// `extValFe[k]`: the `fnStmts` position of the forwarding function minted for link row `k`, or -1.
let extValFe: i32[] = []

export function synthExternValues() {
  extValFe = []
  if !externValueSeen() || emitRootIx < 0 { return 0 }
  while extValFe.length < externCount() { extValFe.push(-1) }
  const root = nodeAt(emitRootIx)
  if root is Program {
    let s = 0
    while s < root.progStmts.length {
      extvRespellIn(root.progStmts[s], -1)
      s = s + 1
    }
  }
  const nFns = fnStmts.length
  let fe = 0
  while fe < nFns {
    const fn = nodeAt(fnStmts[fe])
    if fn is FuncDecl { extvRespellIn(fn.fnBody, fnStmts[fe]) }
    fe = fe + 1
  }
  0
}

// Respell every extern read as a value in the subtree at `ix`, which lies in the frame of
// function node `fnIx` (-1 for the module's statements). A nested function is its own
// `fnStmts` frame and is not entered; a callee is a call to the import and is left alone.
// A read means the extern when it resolves to no declaration of the program.
function extvRespellIn(ix: i32, fnIx: i32) {
  let cur = ix
  while cur >= 0 && cur < P.nodes.length {
    const n = nodeAt(cur)
    if n is FuncDecl { return 0 }
    if n is Ident {
      const nm = n.identName
      const k = externLinkOf(nm)
      if k >= 0 && k < extValFe.length && identDeclOf(cur) == IDENT_BUILTIN {
        if extValFe[k] < 0 { synthExternValueFn(nm, k, n.pos) }
        if extValFe[k] >= 0 {
          n.identName = nm + "$extv"
          sidNoteNodeName(cur, fnStmts[extValFe[k]])
        }
      }
      return 0
    }
    let skip = -1
    if n is Call {
      if nodeAt(unwrapParen(n.callFn)) is Ident { skip = n.callFn }
    }
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      if kids[k] != skip { extvRespellIn(kids[k], fnIx) }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

// Mint `function <name>$extv(a0: P0, …): R { name(a0, …) }` for the extern `name` at link row
// `k`, from that row's own parameter and result spellings.
function synthExternValueFn(name: string, k: i32, pos: i32) {
  const n = externArityAt(k)
  if n < 0 { return 0 }
  const ps: i32[] = []
  const args: i32[] = []
  let i = 0
  while i < n {
    const pn = "__a" + i32ToStr(i)
    const pty = synthTypeRefTy(externParamAt(k, i), pos, -1)
    const par = mkParam(pn, pty, -1, 0, 0, pos)
    ps.push(par)
    const arg = mkIdent(pn, pos)
    identFromDecl(arg, par)
    recordNodeTyFrom(arg, pty)
    args.push(arg)
    i = i + 1
  }
  let ret = externRetAt(k)
  if ret == "" || ret == "never" { ret = "void" }
  const rty = synthTypeRefTy(ret, pos, -1)
  const noTyParams: string[] = []
  // The minted nodes postdate the checker, so each carries the type its annotation names.
  const call = mkCall(drwFnRef(name), args, pos)
  recordNodeTyFrom(call, rty)
  const fe = mkFunc(
    name + "$extv",
    noTyParams,
    ps,
    rty,
    mkBlock([call], pos),
    pos,
  )
  fnStmts.push(fe)
  fnParent.push(-1)
  fnDispNames.push("")
  fnValUsed = true
  extValFe[k] = fnStmts.length - 1
  0
}

// ── synthRecEqCores — a compare function for each recursive record ────────────
// An inline field-wise compare of a record that reaches itself through a list field would
// unfold forever, so each such row gets `<row>$eqc(a, b): boolean { a == b }`, a name no
// program can write, called per list element (D5282); only when an `==` operand is recursive.
export function synthRecEqCores() {
  eqgCoresReset()
  // The first `==`/`!=` with an operand whose type is recursive. Either side: an inferred
  // literal on the left has a finite type while its compare still runs through the right's row.
  const onPath: i32[] = []
  const done: i32[] = []
  let pos = -1
  let ix = 0
  while ix < P.nodes.length && pos < 0 {
    const n = nodeAt(ix)
    if n is BinExpr {
      const eqOp = n.binOp == "==" || n.binOp == "!="
      if eqOp && !(nodeAt(n.binRight) is NullLit) {
        if recEqTyCyclic(nodeTyIxOf(n.binLeft), onPath, done) { pos = n.pos }
        if pos < 0 && recEqTyCyclic(nodeTyIxOf(n.binRight), onPath, done) {
          pos = n.pos
        }
      }
    }
    ix = ix + 1
  }
  if pos < 0 { return 0 }
  let r = 0
  while r < sNames.length {
    if eqgRowIsCyclic(r) { synthRecEqCoreFn(r, pos) }
    r = r + 1
  }
  0
}

// Whether arena type `ty` reaches a type already on `onPath` through record fields, list
// elements, nullable inners and union members. `done` holds types explored without one.
function recEqTyCyclic(ty: i32, onPath: i32[], done: i32[]): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  if i32ListHas(onPath, ty) { return true }
  if i32ListHas(done, ty) { return false }
  onPath.push(ty)
  const kids: i32[] = []
  const t = tyAt(ty)
  if t is TyObj {
    let fi = 0
    while fi < t.objFieldTypes.length {
      kids.push(t.objFieldTypes[fi])
      fi = fi + 1
    }
  } else if t is TyArray {
    kids.push(t.aElem)
  } else if t is TyNullable {
    kids.push(t.nInner)
  } else if t is TyUnion {
    let mi = 0
    while mi < t.uMembers.length {
      kids.push(t.uMembers[mi])
      mi = mi + 1
    }
  }
  let k = 0
  while k < kids.length {
    if recEqTyCyclic(kids[k], onPath, done) { return true }
    k = k + 1
  }
  onPath.pop()
  done.push(ty)
  false
}

// Mint `function <row>$eqc(a: <row>, b: <row>): boolean { a == b }` for struct row `row`.
function synthRecEqCoreFn(row: i32, pos: i32) {
  const nm = sNames[row]
  const ps: i32[] = []
  const args: i32[] = []
  const pnames = ["a", "b"]
  let i = 0
  while i < 2 {
    const pty = synthTypeRefTy(nm, pos, -1)
    const par = mkParam(pnames[i], pty, -1, 0, 0, pos)
    ps.push(par)
    const arg = mkIdent(pnames[i], pos)
    identFromDecl(arg, par)
    recordNodeTyFrom(arg, pty)
    args.push(arg)
    i = i + 1
  }
  const eq = mkBinary("==", args[0], args[1], pos)
  nodeTyRecord(eq, TY_BOOL)
  const noTyParams: string[] = []
  const fe = mkFunc(
    nm + "$eqc",
    noTyParams,
    ps,
    synthTypeRefTy("boolean", pos, TY_BOOL),
    mkBlock([eq], pos),
    pos,
  )
  fnStmts.push(fe)
  fnParent.push(-1)
  fnDispNames.push("")
  eqgCoreAdd(row, fnStmts.length - 1)
  0
}
