// ── self-method / operator / index-trap dispatch REWRITE (B13 + B14) ─────────
// The HOST resolves these in its type-aware parser; the native parser is
// type-free, so the emitter rewrites the arena BEFORE monomorphization:
//   o.f(args) → f(o, args)   a free `self`-function, receiver a struct with no
//                            field `f` (UFCS); `a op b` → `op(a, b)` likewise
//   a op b    → (a."op")(b)  left operand carries an operator closure FIELD
//   o[k]      → (o."[]")(k)  a "[]" trap field; `o[k] = v` → `(o."[]=")(k, v)`
//                            (arrays/maps/strings never classify as structs,
//                            so they keep their fast paths)
// POST-ORDER (parents store the returned child index back), so `a[1][2]`
// rewrites its inner trap before the outer looks at its receiver. The rewritten
// forms ride the EXISTING lowerings, and a program with none of these shapes rewrites nothing.

// The `fnStmts` index of a free `self`-function `name` reachable at `argc` total
// params (first param NAMED `self`), or -1 — the host's UFCS reachability rule,
// so a non-`self` function is NOT a method (objects/self-method-pollution.vl).
//
// `argc` is matched against the ARITY RANGE, not the exact length: a UFCS call
// takes trailing defaults exactly as the direct spelling does (`5.scale(2)` ==
// `scale(5, 2)`), and `drwFillDefaults` — which runs right after the receiver is
// injected — is what fills the omitted tail. The checker admits the same range
// (`ufcsCallTy`), so the two agree by construction; a mismatch here would be the
// rewrite disagreeing with the type it was checked against.
export function drwSelfFnOf(name: string, argc: i32) {
  const fe = fnIndexOf(name)
  if fe < 0 { return -1 }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    const ps = fn.fnParams
    if argc > ps.length { return -1 }
    if argc < fnRequiredArity(ps) { return -1 }
    if ps.length > 0 {
      const p0 = P.nodes[ps[0]]
      if p0 is Param {
        if p0.parName == "self" { return fe }
      }
    }
  }
  -1
}

// Normalize a DIRECT call to its callee's FULL arity, appending the declaration's
// DEFAULT expressions for the trailing arguments the call omitted.
//
// This is the whole emit-side of parameter defaults. It runs before
// monomorphization and signature collection, so mono, `collectCloSigs` and the
// per-parameter argument coercion all see an ordinary full-arity call. It is also
// what keeps the feature clear of the `$fnsig` value-call ABI: the callee's
// declared signature never changes and no new signature key is minted.
//
// The callee is resolved with `fnIndexOfInScopeChain` — the SAME classifier
// `emitCall` uses to pick the direct path over `call_ref` — so a call through a
// function VALUE resolves nothing and keeps the arity error the checker reported.
function drwFillDefaults(ix: i32, ctx: i32) {
  const n = P.nodes[ix]
  if n is Call {
    const cf = P.nodes[n.callFn]
    if cf is Ident {
      const fe = fnIndexOfInScopeChain(cf.identName, ctx)
      if fe < 0 { return 0 }
      const fn = P.nodes[fnStmts[fe]]
      if fn is FuncDecl {
        const ps = fn.fnParams
        const args = n.callArgs
        if hasNamedArgs(n.callArgNames) {
          // A NAMED call may skip a MIDDLE parameter (`f(1, c: 3)`), so the
          // gap is found by binding names to slots rather than by counting.
          // Binding it here — and dropping the name list once the arguments are
          // in parameter order — is the only way the gap survives to emit: the
          // emitter's own reorder (`orderedDirectArgs`) has no way to fill one.
          const pNames: string[] = []
          let pn = 0
          while pn < ps.length {
            const pnode = P.nodes[ps[pn]]
            if pnode is Param { pNames.push(pnode.parName) }
            pn = pn + 1
          }
          if pNames.length != ps.length { return 0 }
          const ordered = orderArgsByParamNames(pNames, args, n.callArgNames)
          if ordered.length != ps.length { return 0 }
          let gap = false
          let gi = 0
          while gi < ordered.length {
            if ordered[gi] < 0 { gap = true }
            gi = gi + 1
          }
          // No gap: leave the call exactly as it was, so every named call that
          // works today keeps taking the emitter's own reorder path.
          if !gap { return 0 }
          if fillArgDefaults(ordered, ps, ix) >= 0 { return 0 }
          const noNames: string[] = []
          n.callArgs = ordered
          n.callArgNames = noNames
          return 0
        }
        if args.length >= ps.length { return 0 }
        let i = args.length
        while i < ps.length {
          let d = paramDefaultOf(ps[i])
          if d < 0 { return 0 }
          // `__callsite__` is the one default whose value is the SITE, so it
          // takes the per-call node `csPreMintLocs` banked rather than the
          // declaration's marker — the same substitution the checker made when
          // it typed this call, keyed on the same Call node.
          if paramDefaultIsCallsite(d) { d = callSiteLocOf(ix) }
          if d < 0 { return 0 }
          args.push(d)
          i = i + 1
        }
      }
    }
  }
  0
}

// Post-order rewrite of the tree at `ix` (inside function `ctx`, -1 = top
// level). Returns the node index to use in `ix`'s place (usually `ix` itself).
// True if `ix` is a map INDEX read (`m[k]`), parens peeled — the shape whose `??` has a
// fused lowering in `emitMapGetOr` and must not be desugared into a re-reading `if`.
function drwIsMapRead(ix: i32) {
  const n = P.nodes[unwrapParen(ix)]
  if n is Index { return nodeTyIsMap(n.idxArr) }
  false
}

// Does ANY instantiation of the enclosing generic resolve `prop` as a FIELD of the
// receiver — so the answer differs per instance and this member call is not one
// rewrite's to make?
//
// The rewrite runs BEFORE monomorphization, so `drwWalk` meets `x.m()` while `x` is
// still a type parameter and would rewrite once for every instance the generic will
// ever have — `vl check` rc 0, invalid wasm at any instance carrying `m` as a closure
// FIELD (D1002). The BODY cannot answer; the CALL SITES can, because the checker
// recorded a type on every argument node. Declining hands the call to the
// field-closure lowering, which resolves per FUNCTION and is right at every instance.
// "Any" (not unanimity) is enough because `monoPinBinOps` re-runs the rewrite PER
// INSTANCE off the pinned receiver type — D1063 is the price unanimity charged.
function drwAnyInstanceTakesField(recvIx: i32, prop: string, ctx: i32) {
  if ctx < 0 { return false }
  // ORDERED BY COST, and the order is load-bearing. `tyHasTyVar` fans out over a union's
  // members and an object's fields to depth 12 with no memo, so on a recursive `Node`-shaped
  // union it is exponential — asking it ahead of the two structural tests below made the
  // compiler's own self-compile measurably slower for an answer that is `false` at every
  // non-generic declaration.
  const fn = P.nodes[ctx]
  if fn is FuncDecl {
    if fn.fnTyParams.length == 0 { return false }
    const r = P.nodes[unwrapParen(recvIx)]
    if r is Ident {
      // The receiver's own recorded type must still be a HOLE — this is the pre-instance
      // question and nothing else. A concrete receiver was already answered by
      // `structIndexOfExpr`.
      if !tyHasTyVar(nodeTyIxOf(recvIx)) { return false }
      const ps = fn.fnParams
      let pi = -1
      let i = 0
      while i < ps.length {
        const pp = P.nodes[ps[i]]
        if pp is Param {
          if pp.parName == r.identName { pi = i }
        }
        i = i + 1
      }
      if pi < 0 { return false }
      const gname = fn.fnName
      if gname == "" { return false }
      let seen = 0
      let k = 0
      while k < P.nodes.length {
        const nd = P.nodes[k]
        if nd is Call {
          const ce = P.nodes[nd.callFn]
          // A UFCS call naming this generic reaches it through a receiver this scan
          // cannot line up with a parameter position — decline rather than guess.
          if ce is Member {
            if ce.memProp == gname { return false }
          }
          if ce is Ident {
            if ce.identName == gname {
              if pi >= nd.callArgs.length { return false }
              if tyFieldTyOf(nodeTyIxOf(nd.callArgs[pi]), prop) >= 0 {
                seen = seen + 1
              }
            }
          }
        }
        k = k + 1
      }
      return seen > 0
    }
  }
  false
}

function drwWalk(ix: i32, ctx: i32) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Call {
    const args = n.callArgs
    let i = 0
    while i < args.length {
      args[i] = drwWalk(args[i], ctx)
      i = i + 1
    }
    const callee = P.nodes[n.callFn]
    if callee is Member {
      callee.memObj = drwWalk(callee.memObj, ctx)
      // UFCS (host parser.ts case 2): `o.f(args)` where `f` is a free function
      // whose FIRST parameter is named `self` lowers to the direct call
      // `f(o, args)`. The receiver TYPE does not gate it. The Call node mutates
      // in place: the receiver shifts in as argument 0, the callee becomes a bare
      // Ident, and any named args slide right of the unnamed receiver.
      //
      // The module merge mangles a free `self`-function (`shout` → `shout$m1`) but
      // leaves the call's property plain, so `ufcsAliasAtSite` maps the plain
      // property to the mangled function and every downstream pass sees a normal
      // named call. D1120 — asked AT THE SITE (`ix` is this Call's arena node, the
      // index the merge walk banked `modSelfFnTarget` on), so two merged modules'
      // same-named `self`-functions no longer collapse onto whichever came first.
      const uName = ufcsAliasAtSite(ix, callee.memProp)
      // Precedence, mirroring the host:
      //   • a REAL struct field of that name wins (a value access, not a call);
      //   • a callable FIELD (closure-valued, kind 14) wins as a `call_ref`
      //     member-call (`exprIsClosure`), so it is NOT UFCS-rewritten.
      // A non-struct receiver has no fields, so neither case can apply.
      //
      // D1070 — FIELD-FIRST IS THE CHECKER'S PREDICATE, ASKED FIRST, IN EVERY SCOPE.
      // `structIndexOfExpr` answers for a module global and a param but -1 inside a
      // function body (`localNames` is filled long after this pass), so the emit-side
      // ROW decided the rule scope-dependently. Ask the RECEIVER'S CHECKED TYPE
      // instead (`tyFieldTyOf`, what `ufcsCallTy` uses), ahead of the row lookup and
      // STRICTLY NARROWING: it can only turn a UFCS rewrite off, never on.
      const recvFieldTy = tyFieldTyOf(nodeTyIxOf(callee.memObj), callee.memProp)
      const recvHasField = recvFieldTy >= 0
      const si = structIndexOfExpr(callee.memObj, ctx)
      let ufcs = false
      if si >= 0 && !recvHasField {
        if sFieldIndex(si, callee.memProp) < 0 {
          if drwSelfFnOf(uName, args.length + 1) >= 0 { ufcs = true }
        }
      }
      if si < 0 && !recvHasField {
        if !exprIsClosure(n.callFn, ctx) {
          if drwSelfFnOf(uName, args.length + 1) >= 0 {
            // A TYPE-PARAMETER receiver has no struct row YET, and `si < 0` is the arm
            // that reads that as "no field, so UFCS". It is not the same fact — see
            // `drwAnyInstanceTakesField`. Asked LAST, after the `self`-function has
            // actually matched: the predicate walks the arena and then the node table,
            // and every `.push` / `.slice` receiver in a real program reaches this arm.
            if !drwAnyInstanceTakesField(callee.memObj, callee.memProp, ctx) {
              ufcs = true
            }
          }
        }
      }
      if ufcs {
        const recvIx = callee.memObj
        args.push(-1)
        let j = args.length - 1
        while j > 0 {
          args[j] = args[j - 1]
          j = j - 1
        }
        args[0] = recvIx
        // Named-arg parity: the injected receiver is an UNNAMED slot-0
        // positional. Only when the call already carries names does the name
        // list need a leading "" (an all-positional call keeps its empty
        // list, so `hasNamedArgs` stays false downstream).
        if hasNamedArgs(n.callArgNames) {
          const nm = n.callArgNames
          nm.push("")
          let k = nm.length - 1
          while k > 0 {
            nm[k] = nm[k - 1]
            k = k - 1
          }
          nm[0] = ""
        }
        n.callFn = mkIdent(uName, -1)
      }
      drwFillDefaults(ix, ctx)
      return ix
    }
    n.callFn = drwWalk(n.callFn, ctx)
    drwFillDefaults(ix, ctx)
    return ix
  }
  if n is Block {
    const bs = n.blkStmts
    let i2 = 0
    while i2 < bs.length {
      bs[i2] = drwBareBlock(drwWalk(bs[i2], ctx))
      i2 = i2 + 1
    }
    return ix
  }
  if n is LetDecl {
    n.letInit = drwWalk(n.letInit, ctx)
    return ix
  }
  if n is IfStmt {
    n.ifCond = drwWalk(n.ifCond, ctx)
    n.ifThen = drwWalk(n.ifThen, ctx)
    n.ifElse = drwWalk(n.ifElse, ctx)
    return ix
  }
  if n is WhileStmt {
    n.whileCond = drwWalk(n.whileCond, ctx)
    n.whileBody = drwWalk(n.whileBody, ctx)
    return ix
  }
  if n is ForRange {
    n.frFrom = drwWalk(n.frFrom, ctx)
    n.frTo = drwWalk(n.frTo, ctx)
    n.frStep = drwWalk(n.frStep, ctx)
    n.frBody = drwWalk(n.frBody, ctx)
    return ix
  }
  if n is ForIn {
    n.fiIter = drwWalk(n.fiIter, ctx)
    n.fiBody = drwWalk(n.fiBody, ctx)
    return ix
  }
  if n is RetStmt {
    n.retArg = drwWalk(n.retArg, ctx)
    return ix
  }
  if n is BinExpr {
    // The index WRITE-TRAP form `o[k] = v` — handled BEFORE the general child
    // walk so the assignment-target Index is not first rewritten into a READ
    // trap (host: the assignment parser recovers the object + key).
    if n.binOp == "=" {
      const tgt = P.nodes[n.binLeft]
      if tgt is Index {
        tgt.idxArr = drwWalk(tgt.idxArr, ctx)
        tgt.idxIndex = drwWalk(tgt.idxIndex, ctx)
        n.binRight = drwWalk(n.binRight, ctx)
        // A free `"[]="` OPERATOR function (B14) — the checker resolved it by the
        // receiver's TYPE and banked it on THIS assignment node, so the rewrite
        // never re-derives the choice (and cannot disagree with what was typed).
        const wOp = opIdxFnAtNode(ix)
        if wOp != "" {
          const woargs: i32[] = []
          woargs.push(tgt.idxArr)
          woargs.push(tgt.idxIndex)
          woargs.push(n.binRight)
          return mkCall(mkIdent(wOp, -1), woargs, -1)
        }
        const wsi = structIndexOfExpr(tgt.idxArr, ctx)
        if drwFieldClosure(wsi, "[]=") {
          const wargs: i32[] = []
          wargs.push(tgt.idxIndex)
          wargs.push(n.binRight)
          return mkCall(mkMember(tgt.idxArr, "[]=", -1), wargs, -1)
        }
        return ix
      }
    }
    n.binLeft = drwWalk(n.binLeft, ctx)
    n.binRight = drwWalk(n.binRight, ctx)
    // `x ?? d` OVER A PROVABLY NON-NULLABLE LHS **IS** `x` — the default can never be
    // selected, so the coalesce FOLDS AWAY here, before collection and classification.
    //
    // WHY A REWRITE AND NOT AN EMIT ARM. Lowering the identity inside `emitCoalesce`
    // produces the right BYTES and the wrong TYPE: every consumer classifier
    // (`exprString`, `exprIsLitAtom`, the print-import chooser, the local-cell ladder)
    // dispatches on the `??` NODE and answers only for a NULLABLE left operand, so a
    // non-nullable LHS fell to the i32 default while the emit pushed the LHS's real rep
    // — invalid wasm and wrong values. Folding the node leaves nothing left to classify.
    //
    // Safe this EARLY because every fused `??` lowering (`m[k]`, `m.get`, `xs.get`,
    // `xs.pop`) needs a NULLABLE left operand, which `nodeTyExcludesNull` declines.
    if n.binOp == "??" {
      if nodeTyExcludesNull(n.binLeft) { return n.binLeft }
      // D962 — `x ?? d` OVER A NULLABLE VALUE-UNION BOX DESUGARS HERE, for the reason
      // the fold above lives here: a lowering the consumer classifiers do not know
      // about is correct bytes in the wrong envelope. Two emit arms for this rep were
      // built and both proved it (D960) — the second's correct `(if (result (ref
      // $box)) …)` was wrapped in a SECOND `struct.new $box` by the return path.
      //
      // RE-READABLE LEFT OPERANDS ONLY, and here that is CORRECTNESS, not cost: the
      // desugaring names the operand twice. A CALL operand keeps the `??` and the
      // emitter's refusal, which is why D960 stays open. AND NOT OVER A MAP READ: a
      // map MISS is a bare `ref.null` in the vals slot, not a null-tagged box, so the
      // synthesized `!= null` read a tag off a nullable ref (D1019). `emitMapGetOr`
      // already lowers that shape correctly and probes the map once.
      if exprReReadable(unwrapParen(n.binLeft)) && !drwIsMapRead(n.binLeft) {
        if tyIsNulValueUnionBox(nodeTyIxOf(n.binLeft)) {
          const dsThen: i32[] = []
          dsThen.push(n.binLeft)
          const dsElse: i32[] = []
          dsElse.push(n.binRight)
          const dsIf = mkIf(
            mkBinary("!=", n.binLeft, mkNull("null", n.pos), n.pos),
            mkBlock(dsThen, n.pos),
            mkBlock(dsElse, n.pos),
            n.pos,
          )
          // D969 — HAND THE `??`'s CHECKED TYPE TO THE `if`. Without it this rewrite is
          // type-BLINDING as well as node-erasing, and the un-annotated destination had
          // nothing left to ask: the binding took a scalar cell and the box went into it
          // (`vl check` rc 0, invalid wasm) where pre-D962 it was a loud refusal. The
          // desugaring is meaning-preserving, so the coalesce's join IS the if's type.
          nodeTyCarry(dsIf, ix)
          return dsIf
        }
      }
    }
    if drwDispatchOp(n.binOp) {
      const osi = structIndexOfExpr(n.binLeft, ctx)
      // A free `self`-function named for the operator wins (host parser
      // order); else an operator closure FIELD dispatches member-call style.
      //
      // THE SELF-FN GATE ASKS THE CHECKER AND THE FIELD GATE ASKS THE EMITTER'S STRUCT
      // TABLE, and until D424 both asked the table. `structIndexOfExpr` does not know a
      // plain function-body LOCAL — its slot is minted by the emit pass this rewrite
      // runs ahead of — so `const a: V = { … }` in a body did not dispatch: `a < b`
      // emitted `i32.lt_s` over two struct refs, check-clean INVALID WASM. The same
      // program at module scope runs, which is why the tree's ONE operator fixture
      // (`tests/cases/objects/operator-self-method.vl`, all globals) stayed green.
      // The self-fn branch asks only "is the left operand an OBJECT" — the CHECKER's
      // own question (`opSelfFnTy`); the FIELD branch needs the ROW and cannot (D424).
      if osi >= 0 || nodeTyIsObj(n.binLeft) {
        if drwSelfFnOf(n.binOp, 2) >= 0 {
          const oargs: i32[] = []
          oargs.push(n.binLeft)
          oargs.push(n.binRight)
          return mkCall(mkIdent(n.binOp, -1), oargs, -1)
        }
      }
      if osi >= 0 {
        if drwFieldClosure(osi, n.binOp) {
          const fargs: i32[] = []
          fargs.push(n.binRight)
          return mkCall(mkMember(n.binLeft, n.binOp, -1), fargs, -1)
        }
      }
    }
    return ix
  }
  if n is Unary {
    n.unArg = drwWalk(n.unArg, ctx)
    return ix
  }
  if n is Paren {
    n.parInner = drwWalk(n.parInner, ctx)
    return ix
  }
  if n is Member {
    n.memObj = drwWalk(n.memObj, ctx)
    return ix
  }
  if n is OptMember {
    n.omObj = drwWalk(n.omObj, ctx)
    return ix
  }
  if n is Index {
    n.idxArr = drwWalk(n.idxArr, ctx)
    n.idxIndex = drwWalk(n.idxIndex, ctx)
    // A free `"[]"` OPERATOR function (B14): a DIRECT call, resolved by the
    // checker from the receiver's type and banked on this node. Ahead of the
    // closure-field trap below, mirroring the `a op b` arm's order.
    const rOp = opIdxFnAtNode(ix)
    if rOp != "" {
      const roargs: i32[] = []
      roargs.push(n.idxArr)
      roargs.push(n.idxIndex)
      return mkCall(mkIdent(rOp, -1), roargs, -1)
    }
    // The index READ trap: a struct receiver carrying a "[]" closure field.
    const tsi = structIndexOfExpr(n.idxArr, ctx)
    if drwFieldClosure(tsi, "[]") {
      const targs: i32[] = []
      targs.push(n.idxIndex)
      return mkCall(mkMember(n.idxArr, "[]", -1), targs, -1)
    }
    return ix
  }
  if n is IsExpr {
    n.isObj = drwWalk(n.isObj, ctx)
    return ix
  }
  if n is AsExpr {
    n.asObj = drwWalk(n.asObj, ctx)
    return ix
  }
  if n is ArrayLit {
    const es = n.arrElems
    let i3 = 0
    while i3 < es.length {
      es[i3] = drwWalk(es[i3], ctx)
      i3 = i3 + 1
    }
    return ix
  }
  if n is ObjLit {
    const fs = n.objFields
    let i4 = 0
    while i4 < fs.length {
      const f = P.nodes[fs[i4]]
      if f is FieldInit { f.fiValue = drwWalk(f.fiValue, ctx) }
      i4 = i4 + 1
    }
    return ix
  }
  ix
}

// D1253 — A BARE `{ … }` STATEMENT BECOMES `if true { … }`, and that is why it is a rewrite
// rather than an `emitStmt` arm. The lowering is trivial (`emitStmts`, one lexical frame) but
// EVERY per-function scan that reserves a scratch frame — `blockHasStrOpScan`,
// `blockPushPopBits`, `mfScan`, `leqScanBlock` and the rest — dispatches on statement kind and
// none has a `Block` arm, so an emit-only arm compiled the block against locals nobody
// declared: measured 20 of 90 cells check-clean invalid wasm, every one a string op or a
// `.push` inside the block. An `if` is a statement kind all of them already walk, so the
// coverage is by construction instead of by a list. The checker types a bare block `void`
// (`{ 5 }` in an `: i32` function is `expected i32, got void`), which is exactly what a
// statement-position `if` with no else is, so the wrap is meaning-preserving.
function drwBareBlock(ix: i32) {
  if ix < 0 { return ix }
  const b = P.nodes[ix]
  if b is Block { return mkIf(mkBool(1, b.pos), ix, -1, b.pos) }
  ix
}

// The dispatch-rewrite driver: top-level statements, then every lifted
// function's body (a nested FuncDecl was lambda-lifted into `fnStmts`).
export function dispatchRewrite(stmts: i32[]) {
  let i = 0
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    if s is FuncDecl {
    } else if s is LetDecl {
      s.letInit = drwWalk(s.letInit, -1)
    } else if nodeIsTypeDecl(stmts[i]) {
    } else if s is UnionDecl {
    } else {
      const oldIx = stmts[i]
      const newIx = drwBareBlock(drwWalk(oldIx, -1))
      if newIx != oldIx {
        // The statement node was REPLACED (e.g. `o[k] = v` → the `(o."[]=")(k,v)`
        // write-trap call). `startStmts` captured the OLD arena index during
        // `collectFns` — repoint it so the start function emits the rewritten form.
        stmts[i] = newIx
        let ssj = 0
        while ssj < startStmts.length {
          if startStmts[ssj] == oldIx { startStmts[ssj] = newIx }
          ssj = ssj + 1
        }
      }
    }
    i = i + 1
  }
  let fe = 0
  while fe < fnStmts.length {
    const fn = P.nodes[fnStmts[fe]]
    if fn is FuncDecl { fn.fnBody = drwWalk(fn.fnBody, fnStmts[fe]) }
    fe = fe + 1
  }
  0
}

// Pin every un-annotated lambda that returns a UNION to that union, by CONSUMING the
// contextual return type the CHECKER already computed rather than re-deriving it per
// boundary in the emitter.
//
// A body-inferred return for a union join (`if … { aCat } else { aDog }`) collapses to
// ONE arm, so the lambda's functype result and `$fnsig` key disagree with the call
// site's `i>u` and the value call goes un-interned, the body un-boxed. Pinning `fnRet`
// to the union makes the lambda emit the boxed-union result exactly as the ANNOTATED
// spelling does. The checker recorded the boundary's proof under a node-index sentinel
// (`inferRetNameByNode`), so one read pins every position uniformly. Runs BEFORE
// monomorphization and the shape passes. EVERY ARM BELOW READS THE SAME WAY: it states
// only its own recorder, witness, and the failure the pin prevents.
export function synthRetAnnots() {
  if !fnValUsed { return 0 }
  let fe = 0
  while fe < fnStmts.length {
    const lamIx = fnStmts[fe]
    const fn = P.nodes[lamIx]
    if fn is FuncDecl {
      if fn.fnRet < 0 {
        // VOID-CONTEXT LAMBDA (the checker's `lambdaVoidAdoptedAt` ledger): the lambda
        // was checked against an expected `(…) => void` and ADOPTED the void return —
        // pin `fnRet` to a synthesized `void` TypeRef so `buildFnMap#2`'s
        // `retVoidAnnFlag` seed classifies it (functype `()`-result, `$fnsig` key `>v`,
        // tail routed through the statement/drop path), and every mono clone inherits
        // the pin (`nret = fnRet`). `fRetVoid` is also set NOW for the passes that run
        // between this pin and the `buildFnMap#2` rebuild. Claimed before the
        // inferred-return pin ladder below: a void-adopted lambda records no
        // inferred-return row, so the two writers are disjoint by construction.
        if lambdaVoidAdoptedAt(lamIx) {
          fn.fnRet = synthTypeRefTy("void", -1, -1)
          if fe < fRetVoid.length { fRetVoid[fe] = 1 }
          fe = fe + 1
          continue
        }
        const ctx = inferRetNameByNode(lamIx)
        if ctx != "" {
          const ctxTy = inferRetTyIxByNode(lamIx)
          // THE ROW, so this ladder can ask WHICH PRODUCER answered instead of re-deriving the
          // answer from the name that producer built. See the nullable arm below for the first
          // arm converted; the rest are specified in the destringify programme's B26/B27.
          const ctxRow = inferRetRowByNode(lamIx)
          // ASKED OF THE RUNG. This four-way disjunction was the ladder's largest name
          // test, and for four of its eight rungs it reduced to `isUName(ctx)` alone —
          // a lookup in the module's union REGISTRY, filled by a LATER pass. So the pin
          // depended on `collectU`'s inferred-return loop reaching `registerInlineUnion`;
          // asking the PRODUCER instead removes that cross-pass dependence entirely. See
          // `inferRetRungIsBoxedUnion` for the chain, and for the safety net it trades away.
          //
          // The `nameIsLitUnionArmValueUnion` disjunct it replaces was there because a
          // value union with a litunion-ALIAS arm (`K0 | i64`) never registers as a union
          // alias — the box is the value box, its alias arm the string atom — yet the
          // pinned TypeRef lowers exactly like the annotated spelling. That case is one
          // rung in the set above, needing no clause once the question is which producer answered.
          if inferRetRungIsBoxedUnion(ctxRow) {
            // A litunion ALIAS return (`(i32) => K = (x) => "b"`, recorded by the checker's
            // return adoption): pin `fnRet` to the alias so the lambda's `$fnsig` result keys
            // the i32 atom (`vtKindOfType` → `>i`) matching the value call, and `emitReturnValue`
            // encodes the member literal as its atom id. Shares the union-pin arm (a litunion is a
            // declared union alias, `nameIsLitUnionType`).
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsNullable(ctxRow) {
            // ASKED OF THE RUNG, not of the name. This arm used to run `nullablePartOf(ctx)`
            // — a depth-aware, quote-aware `|` scan — over a spelling the checker had just
            // rendered from a type it was holding. The producer that built that spelling
            // already knew: only `nullableRetName` and `nulLitUnionRetName` mint a top-level
            // nullable name, and both mint `<part> + "|null"` and nothing else. A value union
            // with a `null` member (`i32|null`) does NOT come here — it is
            // `valueUnionRetName`'s, claimed by the arm above via `isValueUnionName`.
            //
            // A NULLABLE-ref return (`P | null`, `string | null`) the checker proved at the
            // lambda's boundary — pin it so the lambda's `$fnsig` result keys the nullable
            // token, matching the value call's key. The niche/nullable-struct lowering already
            // exists for the annotated form; this routes the anonymous lambda through it.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
            // THE MAP-MEMBER-UNION ARM IS GONE, and its deletion is load-bearing rather than
            // tidy. It read `nameIsMapMemberUnion(ctx)` and pinned `{[string]:f32} | {w:i32}`
            // with a body IDENTICAL to arm 1's. Only `mapUnionRetName` can render such a name
            // — no other producer emits a `{[`-leading name with two or more top-level atoms,
            // and the `recordable` fall-through cannot (`isObjShapeName` rejects a top-level
            // `|`) — and that rung is in arm 1's set above.
            //
            // KEEPING IT WOULD MASK A DEFECT. Since the bodies are identical, this arm can
            // only ever fire when arm 1's rung set MISSED a row it should have claimed, and it
            // would paper over that silently by pinning anyway. Deleted so that a gap in arm
            // 1's set shows up as an un-pinned row rather than as nothing at all. No corpus
            // file reached it.
          } else if inferRetRungIsParenUnionElemList(ctxRow) {
            // ASKED OF THE RUNG, like arm 2, and checked the same three ways: every
            // contributing rung exercised, no further rung reaching the arm, and no
            // disagreement against the ladder position computed both ways. The middle
            // clause is what makes the last one mean something.
            //
            // EVERY ARM ABOVE THIS ONE IS NOW A RUNG TEST. Arm 3 (`nameIsMapMemberUnion`) used
            // to sit here and went with arm 1's conversion — every rung in this set declined it
            // anyway (it needs a leading `{[` and all of these render a `(`-leading array).
            //
            // An ELEMENT-VALUE-UNION list return (`(f64|null)[]`, `(i64|boolean)[]`): each
            // element is seeded through the value-union-box list rep (`refArrElemKind == 2`),
            // whose box element `parenUnionArrElemName` extracts — the shape's distinguishing mark.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsNestedElemUnionList(ctxRow) {
            // A NESTED (2-D+) union-element array return (`({f: (…) => boolean} | i32)[][]`,
            // `(i64 | boolean)[][]`, recorded by `nestedElemUnionListRetName`): `emitReturnValue`'s
            // `tyAnnRefListKind`/`tyAnnRefListSlot` thread the OUTER ref-list slot into the body's
            // nested array literal (each inner list builds the kind-2 box element). Un-pinned,
            // `fnRet < 0` gave no thread and the outer array self-classified `i32[][]` from its
            // first inner list's leaf, storing a union-list element into the i32-list backing —
            // INVALID-WASM (fuzz sweep wo7cNe declared, seed 174529790). The 1-D
            // `parenUnionArrElemName` arm above rejects it (its `][]`-suffix guard).
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsNestedLeafList(ctxRow) {
            // A NESTED scalar/string-leaf array return (`() => i64[][]`, `(i32) => f64[][]`):
            // the body literal builds under the RETURN-position seed (`tyAnnRefListKind` →
            // the arm's slot: `() => ([[100]])` under `() => i64[][]` builds i64 inner lists,
            // not the self-classified i32 default), and the `$fnsig` result keys the SAME
            // reflist slot the annotation-side `annRetKind` resolves — the two producers must
            // byte-match, else the value call finds no interned signature (or, pre-pin, the
            // mismatched self-classified build emitted a wrapper-heap INVALID-WASM for an
            // i64-magnitude leaf). (Nested-array dual of the union pin.)
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsLitUnionElemList(ctxRow) {
            // A LITUNION-ALIAS-element array return (`(i32) => K0[] = (q0) => (["4664"])`):
            // the body member literals build the i32 ATOM list under the annotated return's
            // threading. Un-pinned they self-classify a STRING list into the i32-list
            // functype result — invalid wasm.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsMapElemList(ctxRow) {
            // A MAP-ELEMENT array return (`(i32) => {[string]: f32}[] = (q1) => ([h0])`):
            // the `$fnsig` result keys the SAME `>r<slot>;` the annotation-side `annRetKind`
            // resolves (`tyAnnRefListSlot` — the kind-3 map-element slot `ensureRefElem`
            // interns). Un-pinned, the literal-side element spelling diverged and the value
            // call found no interned signature.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsScalarListRet(ctxRow) {
            // ASKED OF THE GATE that admitted the row: this arm's three-way predicate and
            // `isScalarListRetName`'s admitted set are the same strings by construction, since
            // `arrElemNameRaw` drops exactly the trailing `[]`. Every other producer is excluded
            // structurally — except `litUnionElemListRetName`, whose body is `alias + "[]"` for
            // any REGISTERED alias and nothing reserves prim spellings for a `type` declaration,
            // so `type f64 = "a"|"b"` makes a `K[]` return render `f64[]`. That row is ARM 6's,
            // which sits above this one with an identical body — so the two agree only by ladder
            // POSITION, not independently. RE-ARGUE THIS ARM IF THE ARMS ABOVE ARE REORDERED.
            //
            // A DISTINCT-BACKING SCALAR-LEAF list return (`() => i64[] = () => ([5])`): the pin
            // collects the leaf wrapper's list types, which the value-call index read requires;
            // un-pinned it fails "list type not collected". An i32-backed list never gets here.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if nameIsStructWithLitUnionField(ctx) {
            // A STRUCT-with-LITUNION-field return (`{f:K0}`, recorded by `objLitWidenFields`'
            // litunion arm): the body literal builds the i32-ATOM struct and the `$fnsig`
            // result keys the SAME struct every annotated consumer codes. Reached only where
            // NO annotation threads into the lambda (nested through a union's closure arm
            // inside another lambda's expression body — fuzz seed 26306770 d4); the direct-arg
            // spelling already built the atom struct via the param-annotation seed.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if (
            ctx.length > 2 &&
            nameIsArray(ctx) &&
            nameIsStructWithUnionField(arrElemNameRaw(ctx))
          ) {
            // A UNION-FIELD-STRUCT-element LIST return (`{f:{f:f64}|boolean}[]`, recorded by
            // `structFieldBoxElemListRetName`): the body array literal builds boxed-field
            // elements and the `$fnsig` result keys the SAME reflist slot the annotated
            // `(): {f:…|boolean}[]` spelling resolves. Un-pinned, the self-inferred
            // plain-element list stored a struct ref into the boxed field's i32 tag slot —
            // INVALID-WASM (fuzz-nightly run 29874629450, seed 214588500 d6). Element-list
            // sibling of the struct arm below.
            //
            // The guard's `[]` TEST and `[]` CUT are `emit_base`'s two homes (`nameIsArray` /
            // `arrElemNameRaw`) — this arm and the next spelled both halves out by hand.
            // `ctx.length > 2` stays IN FRONT of the test: it excludes the degenerate `"[]"`,
            // which `nameIsArray` accepts and whose raw cut is "", as the hand-written form did.
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if inferRetRungIsStructElemList(ctxRow) {
            // THE RUNG COLUMN, not the spelling: the old guard re-derived from the RENDER what
            // `recordInferRet` had already banked — this row was recorded BY
            // `structElemListRetName`, and `inferRetRungAt` says so directly. The two
            // disagreements are both the canon SOFTENING again (an element struct with a
            // litunion-ALIAS field, which the name test accepts and the rung column does not);
            // both corpus files and three constructed witnesses are unchanged across the two
            // builds, so the narrowing is exercised on purpose and still inert.
            //
            // A PLAIN-STRUCT-element LIST return (`{a:i64,f:f64,z:{…}}[]`): pin it so element
            // literals build under the annotated threading — un-pinned, same-fieldset TWIN rows
            // fieldset-matched the wrong row and boxed the list (INVALID-WASM, fuzz seed
            // 369283890). NOMINAL-resolved, so the `$fnsig` keys the annotation side's ref-list slot.
            fn.fnRet = synthTypeRefTy(resolveShapeToNominal(ctx), -1, ctxTy)
          } else if nameIsStructWithUnionField(ctx) {
            // A STRUCT-with-UNION/NULLABLE-field return (`{f: boolean | {w: i32}}`,
            // `{f: i64 | string}`, recorded by `objRetWidenAdopt`'s boxing-widen arm): the
            // `$fnsig` result is the union-FIELD struct (`retStructIndex` → the boxed-field
            // shape) and `emitReturnValue` coerces the body ObjLit into the boxed field slot,
            // matching the value call. Un-pinned, the lambda's result was the plain
            // body-inferred struct (`{f: boolean}` / `{f: i32}`), so the value call
            // mis-recovered the boxed field — a MISMATCH (`t0(1).f is boolean` read the wrong
            // tag) or INVALID-WASM (an i64 field read where an i32 was stored). (Struct-field
            // dual of the map-member-union pin.)
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
          } else if tyStructHasMapField(ctxTy, 0) {
            // A MAP-carrying STRUCT return (`{a:string,f:{f:{[string]:{f:i64}}},z:f32}`,
            // recorded canonically by `structMapFieldRetName`): the body ObjLit's NESTED
            // literals thread the annotation's per-field struct indices. Un-pinned, the inner
            // `{f: h0}` resolved by first-field-name-set match onto the map's own VALUE struct
            // `{f: i64}` (interned first), the map ref took the i64 field widen, and the outer
            // literal minted a WRONG-layout twin row — INVALID-WASM (`i64.extend_i32_s` on a
            // map ref; fuzz-nightly seed 184510897 d6). (Map-field sibling of the
            // union-field-struct pin above.)
            fn.fnRet = synthTypeRefTy(ctx, -1, ctxTy)
            // STAYS ON THE NAME — a DECLINE on measurement (B81), against a derivation that said the
            // conversion was provably safe. `inferRetRungAt(ctxRow) == IR_RUNG_STRUCT_PLAIN`
            // looks like an exact twin (every `recordable` struct render is SPACED, so the only
            // space-free brace render is `structPlainRetName`'s), and that argument is correct
            // and still gets the wrong answer: the canon SOFTENING lets a struct whose field is
            // a literal union render `{v:string}` at a DIFFERENT rung, so such a row
            // legitimately arrives here and takes the NOMINAL-resolved pin. The rung test is
            // therefore NARROWER, and this arm's whole job is stopping a same-fieldset twin row
            // from being fieldset-matched wrong — INVALID-WASM, per the fuzz seeds cited below.
            // Narrowing a pin that exists to stop invalid wasm is the dangerous direction.
            // AND THE CORPUS CANNOT ADJUDICATE IT: forcing this arm off entirely moves nothing
            // here, so a clean A/B would have measured a site with no observable effect.
          } else if nameIsWholeSpanShape(ctx) && nameIsSpaceFree(ctx) {
            // A PLAIN struct return recorded CANONICALLY (`structPlainRetName` — `{f:f32}`,
            // `{a:i64,f:f64,z:{…}}`): pin it so the body literal builds under the annotated
            // threading. Un-pinned, a same-fieldset TWIN row in scope fieldset-matched the
            // wrong row (`{f: 4.5}` took the `{f: f64}` twin where the context declared
            // `{f: f32}` — INVALID-WASM, fuzz sweep3 multiobs leg, seed 784841544 case_00222).
            // NOMINAL-resolved: a shape with a declared twin pins the NOMINAL name so the
            // `$fnsig` matches the annotation-side key.
            //
            // CANON-ONLY, and that is what the space guard is for: a legacy SPACED record (a
            // struct whose composite fields `structPlainRetName` declines, recorded via the
            // `recordable` render) must keep its established un-pinned route. The guard's home
            // is `tyname.nameIsSpaceFree` (W7), not this file's own `strContains` spelling.
            fn.fnRet = synthTypeRefTy(resolveShapeToNominal(ctx), -1, ctxTy)
          }
        }
      }
    }
    fe = fe + 1
  }
  0
}

// D1062 — PIN AN INFERRED NULLABLE-LIST RETURN ON A NAMED FUNCTION, so it lowers through the
// annotation the user did not write. `if n == 0 { return [1, 2] }; return null` infers
// `i32[] | null`, and the ANNOTATED twin runs; the inferred spelling had no nullable-LIST arm
// in the `fRetKind` cascade, fell to `criClassify` (which sees only the non-null arm), and the
// bare `return null` reached `emitNullLitNode` with no seed at all.
//
// A PIN RATHER THAN CASCADE ARMS, because of the fan-out: `vtKindOfType` resolves five distinct
// kinds for the annotated spelling and each is served at four sites — twenty places to keep in
// agreement, versus one pin that agrees BY CONSTRUCTION. The arena index rides along
// (`synthTypeRefTy`'s third argument) so classifiers answer from the CHECKER's type. SCOPED to
// the NAMED function (a lambda's row is `#<nodeIx>`-keyed and is `synthRetAnnots`'), and runs
// BEFORE `monomorphize` — an instance is cloned with `nret = fnRet`.

// The inferred return of `name` is `S | null` over a DECLARED struct row — the D1220 leg of
// the pin above. Asks the same pair `inferNulStructRow` does, so the pin and the emitter's
// `retNulRefIndex` cannot resolve different rows.
function snrNulStructRet(name: string): boolean {
  const part = nullablePartOf(inferRetNameOf(name))
  if part == "" { return false }
  structIndexOfTypeName(part) >= 0
}

export function synthNulListRetAnns() {
  let i = 0
  while i < fnStmts.length {
    const fn = P.nodes[fnStmts[i]]
    if fn is FuncDecl {
      if fn.fnRet < 0 && fn.fnName != "" {
        // D1220 — AND THE NULLABLE-STRUCT RETURN IS THE SAME PIN, one type family over.
        // `function set(y: C) { if y.v > 0 { g = y } }` over a struct GLOBAL infers
        // `C | null`, and the annotated `: C | null` twin runs while the inferred one
        // declared a `(ref null $C)` result over a body that left nothing — a
        // compiler-emitted `unreachable`, i.e. a TRAP at `vl check` rc 0.
        // `fnRetNullBearing` and `emitNullForRet` both read `fn.fnRet`, so the pin is what
        // lets the fall-through emit this rep's `ref.null` instead of the dead padding.
        if inferRetIsNulList(fn.fnName) || snrNulStructRet(fn.fnName) {
          const nm = inferRetNameOf(fn.fnName)
          if nm != "" {
            fn.fnRet = synthTypeRefTy(nm, -1, inferRetTyIxOf(fn.fnName))
          }
        }
      }
    }
    i = i + 1
  }
  0
}

// THE PIN an un-annotated UNION param takes — chosen by the param's OWN union REP, never by
// `unNames` DECLARATION ORDER.
//
// THREE reps answer to one `nodeTyIsUnion`: a BOXED union is the shared `{tag, value}` `$uBox`,
// a STRING LITUNION an interned i32 ATOM, a NUMERIC litunion its plain BASE SCALAR. `unNames`
// holds all three in source order, so `unNames[0]` picked the pin by whichever alias the FILE
// declared first — and no two reps substitute in EITHER direction: moving one declaration above
// or below another flipped the same program between correct and TRAP / INVALID WASM.
// The BOXED half keeps that shortcut (every boxed union shares `$uBox` and program-global tags,
// so the pin need only carry the REP); the LITUNION half cannot — atom ids are its own member
// strings — so it pins the param's OWN rendered type. "" means NO PIN: a boxed param in a
// program that registers no boxed alias at all.
function unionParamPinName(ix: i32) {
  const ty = nodeTyIxOf(ix)
  if tyIsLitUnion(ty) {
    // A litunion param, and its rep follows the SPELLING the context was written in — the
    // `canonEmitTypeNames` soften invariant `tyToEmitNameGo`'s union arm states: a DECLARED
    // alias (`(K) => i32`) is preserved and reps as the i32 ATOM, an INLINE member spelling
    // (`("a"|"b") => i32`) softens to `string` and reps as the string ref. So the pin has to
    // reproduce the context's spelling, not merely its rep, and `nodeTyIsLitUnionAlias` is the
    // question that separates them — the alias's OWN arena index (`cUnionTyIxs`), not the
    // member-set match, which an inline spelling satisfies too.
    if nodeTyIsLitUnionAlias(ix) {
      const al = litUnionAliasNameOfTy(ty)
      if al != "" { return al }
    }
    // The inline spelling's own emit name: `string`, by that same soften.
    return tyToEmitName(ty)
  }
  // A NUMERIC literal union (`0 | 1`, `1.5 | 2.5`, the alias-of-an-alias `type Y = Z`) is the
  // SECOND HALF of the arm above, and `tyIsLitUnion` cannot see it: that predicate rejects any
  // member whose `litKind != "str"`, so every numeric litunion fell past it into the boxed loop
  // below — a rep it does not have. Its rep is the BASE SCALAR; `numLitUnionBaseName` is that
  // rule's home, and the base name it pins is what the ANNOTATION side carries too, since #1273
  // made `canonEmitName` canon the interior of a function type. That is what makes this a pin
  // rather than a second answer: canon rewrites the annotation's NAMES, this selector reads the
  // type ARENA, which canon never touches. The FLOAT base proves the arm load-bearing — `1.5 |
  // 2.5` is wrong in EVERY declaration order, the un-pinned param defaulting to i32.
  //
  // NO SPELLING SPLIT, unlike the string half: an alias `Z` and an inline `0 | 1` soften to the
  // SAME base scalar, so one answer serves both and `nodeTyIsLitUnionAlias` is not asked.
  const nb = numLitUnionBaseName(ty)
  if nb != "" { return nb }
  let u = 0
  while u < unNames.length {
    const nm = unNames[u]
    // …AND THE SAME BLIND SPOT ON THE OTHER SIDE OF THE SELECTOR. `nameIsLitUnionType` is
    // the string-only reject, so a `type Z = 0 | 1` row was offered as a BOXED pin to an
    // unrelated `(i32 | string)` callback — and being row 0 it won, reproducing #1270's
    // defect verbatim on the numeric axis. A numeric row does not rep as the box any more
    // than a string one does; skip both, and declaration order stops being an input here too.
    //
    // THE ROW, not the name. Both predicates below are `cUserTypes[nm]` followed by a
    // structural test — the exact lookup `unTyIx` already performed at mint ("B-1 step 1:
    // resolve ONCE at mint"), so asking them by name re-resolves a row this loop is holding.
    // Dual-written against the name pair over the corpus with no row missing, the one arm
    // that could diverge (a synthetic spelling absent from `cUserTypes`) exercised and
    // agreeing. The NAME is still what this function RETURNS: this converts the decision.
    const row = unTyIx[u]
    let skip = nameIsLitUnionType(nm) || numLitUnionAliasName(nm) != ""
    if row >= 0 { skip = tyIsLitUnion(row) || numLitUnionHasBase(row) }
    if !skip { return nm }
    u = u + 1
  }
  ""
}

// THE NAME an un-annotated parameter's RECORDED type pins to — "what its annotation would have
// said". "" when the checker recorded no usable type: a `TyVar` renders "" and keeps its
// un-pinned route, which is exactly the still-open inference HOLE.
//
// ONE answer with two readers — `synthParamAnnots` MINTS the annotation, the monomorphizer's
// un-annotated-parameter pin CONSULTS it before deriving one from the ARGUMENT type. The two
// disagree exactly where the rep depends on the SPELLING; the body was checked against the param.
//
// THREE ARMS, one per rep family; union and nullable cannot fold into the general one because
// `nodeTyName` renders "" for both. NULLABLE is the trap — nullables do NOT share a rep
// (`i32|null` boxes, `string|null` niches, `boolean|null` is an i32 sentinel), so the union
// arm's "pin ANY declared alias" shortcut must not be imitated: pin the parameter's OWN type.
export function recordedParamPinName(pIx: i32) {
  if nodeTyIsUnion(pIx) { return unionParamPinName(pIx) }
  if nodeTyIsNullable(pIx) {
    const nty = tyToEmitName(nodeTyIxOf(pIx))
    if nty == "" { return "" }
    // Resolve the SHAPE under the null, not the whole spelling — the SAME rule the general
    // arm applies, asked through the `|null` suffix that `resolveShapeToNominal` (a
    // field-set / element match) does not look through on its own. `nullablePartOf` is the
    // depth-aware split, so a `{y:string|i32}|null` keeps its FIELD union intact rather than
    // splitting on the inner bar.
    //
    // MEASURED INERT TODAY, and recorded as such rather than claimed load-bearing:
    // `{w:i32}|null` and `W|null` produce the same outcome on every shape reachable now,
    // because every composite nullable reaches the "not yet supported" floor BEFORE any
    // nominal-keyed consumer runs. It stays because it is one rule spelled the same way in
    // both arms — drop it and a reader has to explain the asymmetry, and whoever graduates
    // the floor has to rediscover it.
    const nbase = nullablePartOf(nty)
    if nbase != "" {
      const nnom = resolveShapeToNominal(nbase)
      if nnom != "" { return nnom + "|null" }
    }
    return nty
  }
  const tn = nodeTyName(pIx)
  if tn == "" { return "" }
  // The shape-to-nominal DECISION on the arena. The RENDER above is still taken and stays: at
  // this site the name is the ARTEFACT (`synthParamAnnots` mints an annotation from it) and its
  // emptiness is the inference-HOLE gate — a `TyVar` renders "", the un-pinned route. What moves
  // off the string is the MATCHING. The gate ORDER is deliberately unchanged: hoisting the arena
  // rung above the render would make the hole gate conditional, the shape of the B191 regression.
  //
  // AND THE NAME LADDER IS GONE. `resolveShapeToNominal(tn)` stood here — parse the RENDER's
  // field set, match it against the struct rows, then the variant rows, else return the spelling
  // unchanged. `shapeNominalOfTy` asks all three of those of the TYPE instead, and by B205's
  // rule (ask whether the thing being retired still does work) the ladder had stopped resolving
  // `tn` to anything but itself. Returning `tn` is the RIGHT answer where the two could still
  // differ — a render matching where the arena declines has softened away the ruling distinction.
  const nom = shapeNominalOfTy(nodeTyIxOf(pIx))
  if nom != "" { return nom }
  tn
}

export function synthParamAnnots() {
  let fe = 0
  while fe < fnStmts.length {
    const fn = P.nodes[fnStmts[fe]]
    if fn is FuncDecl {
      const ps = fn.fnParams
      let pi = 0
      while pi < ps.length {
        const p = P.nodes[ps[pi]]
        if p is Param {
          if p.parType < 0 {
            const upin = recordedParamPinName(ps[pi])
            if upin != "" {
              // THE PARSE THIS SITE USED TO PAY FOR WAS ALWAYS DISCARDED. `synthTypeRef` is
              // `synthTypeRefTy(…, -1)`, and -1 means "resolve the name" — which mints a
              // structurally identical `Ty` row, `nameToTy` not being hash-consed — and then
              // `recordNodeTyFrom` below OVERWROTE the result unconditionally with the very
              // type handed over here. The funnel's answer was not merely duplicated, it was
              // thrown away (the programme doc's B8 shape, in its pure form).
              //
              // `recordNodeTyFrom` is KEPT rather than deleted, and that is what makes this
              // exactly equivalent instead of nearly so: with `srcTy >= 0` it rewrites the same
              // value, and at -1 — which the header above argues cannot happen — the hand-over
              // declines and the copy overwrites `recordClonedNodeTyKnown`'s PLACEHOLDER with
              // -1 exactly as it did before. Deleting it would change that unreachable arm.
              const srcTy = nodeTyIxOf(ps[pi])
              const un = synthTypeRefTy(upin, -1, srcTy)
              // Carry the parameter's recorded arena type onto the synthesized annotation, so a
              // consumer classifies the pin STRUCTURALLY instead of re-deriving it from the
              // name: the pinned name may be an interned `#anonN` shape name `nameToTy` cannot
              // resolve, and `exprIsLitAtom` asks `nodeTyIsLitUnionAlias(p.parType)` of every
              // Ident naming a parameter. Without it a litunion param pinned `K` — so its wasm
              // param IS the i32 atom — while the annotation node carried no type, and every
              // atom-consuming site in the body still took the string route (INVALID WASM, and
              // a bare `print(u)` printing the raw atom id). The pin NAME and the recorded TYPE
              // are one answer or they are a bug. Faithful for the softened half too: an INLINE
              // `"a"|"b"` pins to `string` and its arena index is NOT a registered alias.
              // This also retires the ref-list ROW record that sat in the general arm: both its
              // readers consult the node's recorded arena type first (destringify D-ANNRLREC).
              recordNodeTyFrom(un, ps[pi])
              p.parType = un
            }
          }
        }
        pi = pi + 1
      }
    }
    fe = fe + 1
  }
  0
}

// ── captured-MUTATION boxing ──────────────────────────────────────────────────────────────
// Closures capture by VALUE (the env struct copies each captured local), so a local MUTATED
// inside a closure cannot be reflected back — and a bare `c = …` in the closure has no local
// slot, failing at emit ("assignment target is not a parameter, local, or global"). The fix is
// a pure AST rewrite, done before monomorphization so instances inherit it: a captured-mutated
// local is boxed as a LENGTH-1 ARRAY (a shared heap ref both scopes index). `let c = init`
// becomes `let c = [init]`, and EVERY use of `c` (read OR assignment target) becomes `c[0]`, so
// `c = c + 1` in the closure lowers to `c[0] = c[0] + 1` into the shared array — and arrays are
// already capturable and index-assignable through a closure.
//
// Conservative: only a DIRECT `let` of the maker, assigned INSIDE a nested lambda and NOT
// shadowed by any nested binding, is boxed; anything else keeps the existing loud error.

// One scan of a maker body: `dlets` = the maker's own `let` names (depth 0); `alam` = names
// ASSIGNED inside a nested lambda (depth > 0); `ndecls` = every binding declared inside a nested
// lambda (params / lets / loop vars) — the shadow set.
function cboxScan(
  ix: i32,
  depth: i32,
  dlets: string[],
  alam: string[],
  ndecls: string[],
) {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is FuncDecl {
    const ps = n.fnParams
    let pi = 0
    while pi < ps.length {
      const p = P.nodes[ps[pi]]
      if p is Param {
        if !capHas(ndecls, p.parName) { ndecls.push(p.parName) }
      }
      pi = pi + 1
    }
    return cboxScan(n.fnBody, depth + 1, dlets, alam, ndecls)
  }
  if n is LetDecl {
    if depth == 0 {
      if !capHas(dlets, n.letName) { dlets.push(n.letName) }
    } else {
      if !capHas(ndecls, n.letName) { ndecls.push(n.letName) }
    }
    return cboxScan(n.letInit, depth, dlets, alam, ndecls)
  }
  if n is Block {
    const bs = n.blkStmts
    let i = 0
    while i < bs.length {
      cboxScan(bs[i], depth, dlets, alam, ndecls)
      i = i + 1
    }
    return 0
  }
  if n is BinExpr {
    if n.binOp == "=" {
      if depth > 0 {
        const t = P.nodes[n.binLeft]
        if t is Ident {
          if !capHas(alam, t.identName) { alam.push(t.identName) }
        }
      }
    }
    cboxScan(n.binLeft, depth, dlets, alam, ndecls)
    return cboxScan(n.binRight, depth, dlets, alam, ndecls)
  }
  if n is IfStmt {
    cboxScan(n.ifCond, depth, dlets, alam, ndecls)
    cboxScan(n.ifThen, depth, dlets, alam, ndecls)
    return cboxScan(n.ifElse, depth, dlets, alam, ndecls)
  }
  if n is WhileStmt {
    cboxScan(n.whileCond, depth, dlets, alam, ndecls)
    return cboxScan(n.whileBody, depth, dlets, alam, ndecls)
  }
  if n is ForRange {
    if !capHas(ndecls, n.frVar) { ndecls.push(n.frVar) }
    cboxScan(n.frFrom, depth, dlets, alam, ndecls)
    cboxScan(n.frTo, depth, dlets, alam, ndecls)
    cboxScan(n.frStep, depth, dlets, alam, ndecls)
    return cboxScan(n.frBody, depth, dlets, alam, ndecls)
  }
  if n is ForIn {
    if !capHas(ndecls, n.fiVar) { ndecls.push(n.fiVar) }
    cboxScan(n.fiIter, depth, dlets, alam, ndecls)
    return cboxScan(n.fiBody, depth, dlets, alam, ndecls)
  }
  if n is RetStmt { return cboxScan(n.retArg, depth, dlets, alam, ndecls) }
  if n is Unary { return cboxScan(n.unArg, depth, dlets, alam, ndecls) }
  if n is Paren { return cboxScan(n.parInner, depth, dlets, alam, ndecls) }
  if n is Member { return cboxScan(n.memObj, depth, dlets, alam, ndecls) }
  if n is OptMember { return cboxScan(n.omObj, depth, dlets, alam, ndecls) }
  if n is Index {
    cboxScan(n.idxArr, depth, dlets, alam, ndecls)
    return cboxScan(n.idxIndex, depth, dlets, alam, ndecls)
  }
  if n is IsExpr { return cboxScan(n.isObj, depth, dlets, alam, ndecls) }
  if n is AsExpr { return cboxScan(n.asObj, depth, dlets, alam, ndecls) }
  if n is Call {
    cboxScan(n.callFn, depth, dlets, alam, ndecls)
    const args = n.callArgs
    let ci = 0
    while ci < args.length {
      cboxScan(args[ci], depth, dlets, alam, ndecls)
      ci = ci + 1
    }
    return 0
  }
  if n is ArrayLit {
    const es = n.arrElems
    let ei = 0
    while ei < es.length {
      cboxScan(es[ei], depth, dlets, alam, ndecls)
      ei = ei + 1
    }
    return 0
  }
  if n is ObjLit {
    const fs = n.objFields
    let fi = 0
    while fi < fs.length {
      const f = P.nodes[fs[fi]]
      if f is FieldInit { cboxScan(f.fiValue, depth, dlets, alam, ndecls) }
      fi = fi + 1
    }
    return 0
  }
  0
}

// Rewrite the maker body (and its nested lambda bodies): a USE of a boxed name → `c[0]`, and a
// boxed `let c = init` → `let c = [init]`. Returns the (possibly replaced) node index so parents
// reassign — mirrors `drwWalk`, plus descending into `FuncDecl` bodies.
function cboxWalk(ix: i32, boxed: string[]) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Ident {
    if capHas(boxed, n.identName) {
      return mkIndex(mkIdent(n.identName, -1), mkNum("0", -1), -1)
    }
    return ix
  }
  if n is FuncDecl {
    n.fnBody = cboxWalk(n.fnBody, boxed)
    return ix
  }
  if n is Block {
    const bs = n.blkStmts
    let i = 0
    while i < bs.length {
      bs[i] = cboxWalk(bs[i], boxed)
      i = i + 1
    }
    return ix
  }
  if n is LetDecl {
    n.letInit = cboxWalk(n.letInit, boxed)
    if capHas(boxed, n.letName) {
      // Convert a SCALAR annotation to its array form so the boxed length-1 list classifies as the
      // matching list type (`let c: f64` → `let c: f64[]`; an `f32` annotation is what makes the
      // `[0.0]` literal build f32, not the f64 default). An UN-annotated local needs no conversion —
      // the `[init]` literal infers its element type (`let c = 0` → i32[], `= 0.0` → f64[]).
      if n.letType >= 0 {
        const lt = P.nodes[n.letType]
        if lt is TypeRef {
          // THE ARRAY TYPE IS CONSTRUCTED, NOT RE-PARSED. This site appends `[]` to a name and
          // `recordClonedNodeTy` used to parse the result straight back; the element's arena index
          // is on the annotation node the checker recorded, so the array type is one `mkArrayTy`
          // over it. The atom count is BANKED too (`annUnionAtomsOf`, written by
          // `canonEmitTypeNames` — the pass that PRODUCED this spelling), not re-scanned.
          //
          // GATED ON THE NAME BEING A SINGLE TOP-LEVEL ATOM, AND THAT GATE IS THE WHOLE
          // CORRECTNESS OF THE HUNK. `nm + "[]"` is an array spelling only when `nm` is an atom:
          // `"i32 | string" + "[]"` denotes `i32 | (string[])`. The concat was always malformed
          // and HARMLESS only because both halves were wrong together, so handing the type over
          // UNGATED fixes one half and turns a loud reject into check-clean INVALID WASM. A
          // composite keeps the name path; widening that reject is a capability change of its own.
          let boxedTy = -1
          if annUnionAtomsOf(n.letType) == 1 {
            if annArrowAt(lt.tyName) < 0 {
              const elemTy = nodeTyIxOf(n.letType)
              if elemTy >= 0 { boxedTy = mkArrayTy(elemTy) }
            }
          }
          n.letType = synthTypeRefTy(lt.tyName + "[]", -1, boxedTy)
        }
      }
      const els: i32[] = []
      els.push(n.letInit)
      n.letInit = mkArrayLit(els, -1)
    }
    return ix
  }
  if n is BinExpr {
    n.binLeft = cboxWalk(n.binLeft, boxed)
    n.binRight = cboxWalk(n.binRight, boxed)
    return ix
  }
  if n is IfStmt {
    n.ifCond = cboxWalk(n.ifCond, boxed)
    n.ifThen = cboxWalk(n.ifThen, boxed)
    n.ifElse = cboxWalk(n.ifElse, boxed)
    return ix
  }
  if n is WhileStmt {
    n.whileCond = cboxWalk(n.whileCond, boxed)
    n.whileBody = cboxWalk(n.whileBody, boxed)
    return ix
  }
  if n is ForRange {
    n.frFrom = cboxWalk(n.frFrom, boxed)
    n.frTo = cboxWalk(n.frTo, boxed)
    n.frStep = cboxWalk(n.frStep, boxed)
    n.frBody = cboxWalk(n.frBody, boxed)
    return ix
  }
  if n is ForIn {
    n.fiIter = cboxWalk(n.fiIter, boxed)
    n.fiBody = cboxWalk(n.fiBody, boxed)
    return ix
  }
  if n is RetStmt {
    n.retArg = cboxWalk(n.retArg, boxed)
    return ix
  }
  if n is Unary {
    n.unArg = cboxWalk(n.unArg, boxed)
    return ix
  }
  if n is Paren {
    n.parInner = cboxWalk(n.parInner, boxed)
    return ix
  }
  if n is Member {
    n.memObj = cboxWalk(n.memObj, boxed)
    return ix
  }
  if n is OptMember {
    n.omObj = cboxWalk(n.omObj, boxed)
    return ix
  }
  if n is Index {
    n.idxArr = cboxWalk(n.idxArr, boxed)
    n.idxIndex = cboxWalk(n.idxIndex, boxed)
    return ix
  }
  if n is IsExpr {
    n.isObj = cboxWalk(n.isObj, boxed)
    return ix
  }
  if n is AsExpr {
    n.asObj = cboxWalk(n.asObj, boxed)
    return ix
  }
  if n is Call {
    n.callFn = cboxWalk(n.callFn, boxed)
    const args = n.callArgs
    let ci = 0
    while ci < args.length {
      args[ci] = cboxWalk(args[ci], boxed)
      ci = ci + 1
    }
    return ix
  }
  if n is ArrayLit {
    const es = n.arrElems
    let ei = 0
    while ei < es.length {
      es[ei] = cboxWalk(es[ei], boxed)
      ei = ei + 1
    }
    return ix
  }
  if n is ObjLit {
    const fs = n.objFields
    let fi = 0
    while fi < fs.length {
      const f = P.nodes[fs[fi]]
      if f is FieldInit { f.fiValue = cboxWalk(f.fiValue, boxed) }
      fi = fi + 1
    }
    return ix
  }
  return ix
}

// The INIT of the maker's direct `let name` (searching statements, NOT descending into a nested
// lambda or an expression), or -1. Used to gate boxing on a known element type.
function cboxInitOf(ix: i32, name: string) {
  if ix < 0 { return -1 }
  const n = P.nodes[ix]
  if n is LetDecl {
    if n.letName == name { return n.letInit }
    return -1
  }
  if n is Block {
    const bs = n.blkStmts
    let i = 0
    while i < bs.length {
      const r = cboxInitOf(bs[i], name)
      if r >= 0 { return r }
      i = i + 1
    }
    return -1
  }
  if n is IfStmt {
    const rt = cboxInitOf(n.ifThen, name)
    if rt >= 0 { return rt }
    return cboxInitOf(n.ifElse, name)
  }
  if n is WhileStmt { return cboxInitOf(n.whileBody, name) }
  if n is ForRange { return cboxInitOf(n.frBody, name) }
  if n is ForIn { return cboxInitOf(n.fiBody, name) }
  -1
}

// True if `initIx` is a SCALAR LITERAL — an integer (`i32`/`i64`), float (`f64`, or `f32` via the
// annotation), or string. A captured-mutated local with such an init boxes cleanly into a length-1
// list of the matching scalar type: `cboxWalk` converts the annotation to its array form, the list
// type joins the module's used set (`fa64Used`/`ia64Used`/…, read back through `scalarListUsed`),
// and the CLOSURE classifies the captured env field's list kind (`capturedKindOf`, consulted by
// `exprF64Array`/`exprI64Array`/`exprF32Array`/`exprStringArray`).
// Covers the counter/accumulator case at every scalar type. A non-scalar-literal
// init (struct / closure / call) is left to the loud error rather than mis-lowered.
function cboxInitScalar(initIx: i32) {
  if initIx < 0 { return false }
  const n = P.nodes[initIx]
  if n is NumLit { return true }
  if n is StrLit { return true }
  false
}

// Per top-level function: box each direct `let` that is assigned inside a nested lambda and not
// shadowed (and, for now, has an i32 integer init). Usage-gated — a program with no such local
// rewrites nothing (identical bytes).
export function captureBoxRewrite(_stmts: i32[]) {
  let fe = 0
  while fe < fnStmts.length {
    const fn = P.nodes[fnStmts[fe]]
    if fn is FuncDecl {
      const dlets: string[] = []
      const alam: string[] = []
      const ndecls: string[] = []
      cboxScan(fn.fnBody, 0, dlets, alam, ndecls)
      const boxed: string[] = []
      let di = 0
      while di < dlets.length {
        const nm = dlets[di]
        if capHas(alam, nm) {
          if !capHas(ndecls, nm) {
            if cboxInitScalar(cboxInitOf(fn.fnBody, nm)) { boxed.push(nm) }
          }
        }
        di = di + 1
      }
      if boxed.length > 0 { fn.fnBody = cboxWalk(fn.fnBody, boxed) }
    }
    fe = fe + 1
  }
  0
}

// ── synthVoidTwins — the VOID TWIN mint for coerced function VALUES ─────────────
// The emitter half of the `(P…) => T` → `(P…) => void` wholesale value coercion
// (DECISIONS: void contexts discard implicit tail values, clause 3; the checker half
// is `fnValVoidCoerce`). A coerced value is CALLED through a `>v` `$fnsig` and
// `call_indirect` signature-checks the callee, so the closure built at the coercion
// seam must reference a function whose OWN functype has 0 results. The original cannot
// be it (its other callers want the value), so this pass mints ONE capture-free VOID
// TWIN per coerced target; the swap is node-keyed at `emitExpr`'s Ident value arm
// (`voidTwinForNode`). Runs POST-monomorphization (fnStmts positions are final — a
// pre-mono mint would store positions the renumbering invalidates) and BEFORE
// `buildFnMap#2`. Targets are TOP-LEVEL declarations only, the same set the checker's
// grant admits, so the two gates cannot disagree on nested/shadowing namesakes.
let voidTwinTargetFe: i32[] = []
let voidTwinFe: i32[] = []

// The twin minted for target `fe`, or -1.
function voidTwinOfTarget(fe: i32) {
  let i = 0
  while i < voidTwinTargetFe.length {
    if voidTwinTargetFe[i] == fe { return voidTwinFe[i] }
    i = i + 1
  }
  -1
}

// The twin to SWAP IN at expression node `nodeIx` resolving to function `fe`, or -1.
// Both keys must agree: the node is one the checker granted the coercion at, AND the
// emit-side scope resolution landed on the very target a twin was minted for. Either
// alone is not enough — a same-named nested function, or an uncoerced use of the same
// function elsewhere, must keep the original closure.
export function voidTwinForNode(nodeIx: i32, fe: i32) {
  if !voidCoerceValAt(nodeIx) { return -1 }
  voidTwinOfTarget(fe)
}

// The TOP-LEVEL function named `name` (`fnParent < 0`), or -1 — the emit-side twin
// of the checker's `fnDeclIx` gate (top-level declarations only, duplicates are a
// checker error).
function topLevelFnByName(name: string) {
  let i = 0
  while i < fnStmts.length {
    if i < fnParent.length {
      if fnParent[i] < 0 {
        const fn = P.nodes[fnStmts[i]]
        if fn is FuncDecl {
          if fn.fnName == name { return i }
        }
      }
    }
    i = i + 1
  }
  -1
}

export function synthVoidTwins(_stmts: i32[]) {
  voidTwinTargetFe = []
  voidTwinFe = []
  const nSeams = voidCoerceValCount()
  let i = 0
  while i < nSeams {
    const name = voidCoerceValNameAt(i)
    const target = topLevelFnByName(name)
    if target >= 0 && voidTwinOfTarget(target) < 0 {
      const tfn = P.nodes[fnStmts[target]]
      if tfn is FuncDecl {
        // The checker's grant already excluded generics (`fnTyHasHole`) and
        // non-declarations; these emit-side re-checks fail CLOSED — an unmintable
        // target simply gets no twin, and the un-swapped closure keeps today's
        // behaviour at the call.
        if tfn.fnTyParams.length == 0 {
          let mintable = true
          const nps: i32[] = []
          const argIds: i32[] = []
          let pj = 0
          while pj < tfn.fnParams.length {
            const pn = P.nodes[tfn.fnParams[pj]]
            if pn is Param {
              if pn.parType < 0 { mintable = false }
              // Fresh Param nodes SHARING the original's annotation node, so the
              // twin's param valtypes — and with them its `$fnsig` param tokens —
              // byte-match the original's (only the result differs: `>v`).
              nps.push(mkParam(pn.parName, pn.parType, -1, 0, pn.pos))
              argIds.push(mkIdent(pn.parName, tfn.pos))
            } else {
              mintable = false
            }
            pj = pj + 1
          }
          if mintable {
            const noTyParams: string[] = []
            const callIx = mkCall(mkIdent(name, tfn.pos), argIds, tfn.pos)
            const bodyIx = mkBlock([callIx], tfn.pos)
            const twin = mkFunc(
              "__voidtw_" + name,
              noTyParams,
              nps,
              synthTypeRefTy("void", -1, -1),
              bodyIx,
              tfn.pos,
            )
            fnStmts.push(twin)
            fnParent.push(-1)
            fnDispNames.push("")
            fnValUsed = true
            voidTwinTargetFe.push(target)
            voidTwinFe.push(fnStmts.length - 1)
          }
        }
      }
    }
    i = i + 1
  }
  0
}
