} from "./ast"
import {
  annArrowAt,
  capHas,
  drwDispatchOp,
  nameIsStructWithLitUnionField,
  nameIsStructWithUnionField,
  nodeIsTypeDecl,
  nullablePartOf,
  unwrapParen,
} from "./emit_base"
import { fnIndexOfInScopeChain } from "./emit_collect"
import {
  fRetVoid,
  fnDispNames,
  fnParent,
  fnStmts,
  fnValUsed,
  startStmts,
  unNames,
