// `emit_rewrite.vl` — the emitter's pre-emit AST rewrites: in-place arena mutations
// that run before collection and lowering — self-method / operator / index-trap
// dispatch rewriting (`dispatchRewrite`), captured-mutation boxing
// (`captureBoxRewrite`), and the synthesized return/param annotations
// (`synthRetAnnots`/`synthParamAnnots`) that pin checker-inferred types onto
// declarations for later phases. Consults the classifiers (`emit_classify.vl`);
// writes no bytes.

import { arrElemNameRaw, nameIsArray, nameIsSpaceFree } from "./tyname"
import {
  annUnionAtomsOf,
  ifYieldsNoValue,
  inferRetFnKey,
  inferRetIsNulList,
  inferRetNameByNode,
  inferRetNameOf,
  inferRetRowByNode,
  inferRetRungIsBoxedUnion,
  inferRetRungIsLitUnionElemList,
  inferRetRungIsMapElemList,
  inferRetRungIsNestedElemUnionList,
  inferRetRungIsNestedLeafList,
  inferRetRungIsNullable,
  inferRetRungIsParenUnionElemList,
  inferRetRungIsScalarListRet,
  inferRetRungIsStructElemList,
  inferRetTyIxByNode,
  inferRetTyIxOf,
  lambdaVoidAdoptedAt,
  litUnionAliasNameOfTy,
  mkArrayTy,
  nameIsLitUnionType,
  nodeTyCarry,
  nodeTyExcludesNull,
  nodeTyIsLitUnionAlias,
  nodeTyIsMap,
  nodeTyIsNullable,
  nodeTyIsUnion,
  nodeTyIxOf,
  nodeTyMapValExcludesNull,
  nodeTyName,
  nodeTyRecord,
  numLitUnionAliasName,
  numLitUnionBaseName,
  numLitUnionHasBase,
  opBinFnAtNode,
  opIdxFnAtNode,
  optCallRestamp,
  recordNodeTyFrom,
  tyArrayElemIx,
  tyFieldTyOf,
  tyHasTyVar,
  tyIsLitUnion,
  tyIsLitUnionOrLit,
  tyIsNulValueUnionBox,
  tySame,
  tyToEmitName,
  voidCoerceValAt,
  voidCoerceValCount,
  voidCoerceValNameAt,
} from "./typecheck"
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  Call,
  CharLit,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  Index,
  IsExpr,
  LetDecl,
  Member,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  RetStmt,
  StrLit,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  callSiteLocOf,
  elseIfLink,
  fillArgDefaults,
  fnRequiredArity,
  hasNamedArgs,
  i32ToStr,
  mkArrayLit,
  mkBareBlockIf,
  mkBinary,
  mkBlock,
  mkBool,
  mkCall,
  mkChar,
  mkFunc,
  mkIdent,
  mkIf,
  mkIndex,
  mkLet,
  mkMember,
