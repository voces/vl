// `emit_rewrite.vl` — the emitter's PRE-EMIT AST REWRITES: in-place arena
// mutations that run before collection/lowering — self-method / operator /
// index-trap dispatch rewriting (`dispatchRewrite`), captured-mutation boxing
// (`captureBoxRewrite`), and the synthesized return/param annotations
// (`synthRetAnnots`/`synthParamAnnots`) that pin checker-inferred types onto
// declarations for the later phases. Consults the classifiers
// (`emit_classify.vl`); writes no bytes. Carved out of `wasmEmit.vl`
// (review N18).

import { arrElemNameRaw, nameIsArray, nameIsSpaceFree } from "./tyname"
import {
  annUnionAtomsOf,
  inferRetIsNulList,
  inferRetNameByNode,
  inferRetNameOf,
  inferRetRowByNode,
  inferRetRungIsBoxedUnion,
  inferRetRungIsLitUnionElemList,
  inferRetRungIsMapElemList,
  inferRetRungIsNestedElemUnionList,
  inferRetRungIsNestedLeafList,
  inferRetRungIsNullable,
  inferRetRungIsParenUnionElemList,
  inferRetRungIsScalarListRet,
  inferRetRungIsStructElemList,
  inferRetTyIxByNode,
  inferRetTyIxOf,
  lambdaVoidAdoptedAt,
  litUnionAliasNameOfTy,
  mkArrayTy,
  nameIsLitUnionType,
  nodeTyCarry,
  nodeTyExcludesNull,
  nodeTyIsLitUnionAlias,
  nodeTyIsMap,
  nodeTyIsNullable,
  nodeTyIsObj,
  nodeTyIsUnion,
  nodeTyIxOf,
  nodeTyName,
  numLitUnionAliasName,
  numLitUnionBaseName,
  numLitUnionHasBase,
  opIdxFnAtNode,
  recordNodeTyFrom,
  tyFieldTyOf,
  tyHasTyVar,
  tyIsLitUnion,
  tyIsNulValueUnionBox,
  tyToEmitName,
  voidCoerceValAt,
  voidCoerceValCount,
  voidCoerceValNameAt,
} from "./typecheck"
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  Call,
  FieldInit,
