// Escape queries over a body: the scoped names a private part may live in, whether an
// expression is a freshly built literal, and which declaration a call reaches.
// Does not import the checker.
import {
  ArrayLit,
  BinExpr,
  Call,
  FieldInit,
  FuncDecl,
  Ident,
  Member,
  ObjLit,
  P,
  externLinkOf,
  getDeclPropOf,
  nodeAt,
  opDeclLabel,
  opDeclOpOf,
  ufcsAliasAtSite,
} from "./ast"
import {
  TyLit,
  TyObj,
  TyPrim,
  TyVar,
  objFieldType,
  tyAt,
  tyToStr,
} from "./check_types"
import { cwPeel, declFirstParamIsSelf, fnDeclIx } from "./check_write_scan"
import { nomErasedTyIx } from "./check_ty_rep"
import { nodeTyIxOf } from "./check_node_tys"
import {
  esBindCount,
  esBindNames,
  esBindStart,
  esBindTys,
  esDecl,
  esScopeKind,
  esScopeNames,
} from "./check_effect_rows"
import { findFnDeclIn } from "./check_callee"
import { memberDeclOf, methodFnOfDecl } from "./symbols"

export function esScopePush(name: string, kind: i32) {
  esScopeNames.push(name)
  esScopeKind.push(kind)
  0
}

export function esScopeTruncate(mark: i32) {
  while esScopeNames.length > mark {
    esScopeNames.pop()
    esScopeKind.pop()
  }
  0
}

// Whether node `ix` is a struct or list literal every part of which is private to it: a scalar
// or string value, or another such literal. A part holding a reference it did not build (a
// parameter's object) makes a write through the literal a write to that object.
export function esIsBuiltLiteral(ix: i32): boolean {
  const u = cwPeel(ix)
  if u < 0 || u >= P.nodes.length { return false }
  const n = nodeAt(u)
  if n is ObjLit {
    let i = 0
    while i < n.objFields.length {
      const f = nodeAt(n.objFields[i])
      if f is FieldInit {
        if !esIsPrivatePart(f.fiValue) { return false }
      } else {
        return false
      }
      i = i + 1
    }
    return true
  }
  esIsBuiltList(u)
}

function esIsBuiltList(u: i32): boolean {
  const n = nodeAt(u)
  if n is ArrayLit {
    let i = 0
    while i < n.arrElems.length {
      if !esIsPrivatePart(n.arrElems[i]) { return false }
      i = i + 1
    }
    return true
  }
  false
}

// Whether value node `ix` shares no mutable object with anything: a scalar or string, or a
// literal `esIsBuiltLiteral` accepts.
function esIsPrivatePart(ix: i32): boolean {
  if esIsBuiltLiteral(ix) { return true }
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return false }
  const t = tyAt(nomErasedTyIx(ty))
  if t is TyPrim { return true }
  t is TyLit
}

// ── the summary walk ─────────────────────────────────────────────────────────

// Whether either operand of `n` is typed by a bare type parameter, so its operator is decided
// per instance.
export function esBinOverTyVar(n: BinExpr): boolean {
  esIsTyVar(nodeTyIxOf(n.binLeft)) || esIsTyVar(nodeTyIxOf(n.binRight))
}

export function esIsBareName(ix: i32): boolean {
  const u = cwPeel(ix)
  if u < 0 || u >= P.nodes.length { return false }
  const n = nodeAt(u)
  n is Ident
}

export function esIsTyVar(ty: i32): boolean {
  if ty < 0 { return false }
  const t = tyAt(ty)
  t is TyVar
}

// The `FuncDecl` call `n` at node `ix` inside declaration `owner` reaches statically, or -1.
// `kind` is how the callee name is bound where the call is (`esLocalKind`): 3, a function the
// owner's body declared; any other local binding, a function value; -1, the top-level function
// of that name. A UFCS member call resolves to its `self`-function; an extern is not one.
export function esCalleeDecl(owner: i32, n: Call, ix: i32, kind: i32): i32 {
  if owner < 0 || owner >= P.nodes.length { return -1 }
  if n.callFn < 0 { return -1 }
  const cf = nodeAt(n.callFn)
  if cf is Ident {
    const nm = cf.identName
    if externLinkOf(nm) >= 0 { return -1 }
    if kind == 3 {
      const d = nodeAt(owner)
      if d is FuncDecl {
        const nested = findFnDeclIn(d.fnBody, nm)
        if nested >= 0 && nested != owner { return nested }
      }
      return -1
    }
    if kind >= 0 { return -1 }
    return fnDeclIx[nm] ?? -1
  }
  esUfcsCallee(n.callFn, ix)
}

// The `self`-function the member callee at node `calleeIx` of UFCS call `ix` resolves to, or
// -1 when the callee is not a member, is a field holding a function, or names a built-in method.
function esUfcsCallee(calleeIx: i32, ix: i32): i32 {
  const cf = nodeAt(calleeIx)
  if cf is Member {
    if esCalleeIsField(cf) { return -1 }
    const d = memberDeclOf(ix)
    if d >= 0 {
      if methodFnOfDecl(d) == d { return d }
      return -1
    }
    const name = ufcsAliasAtSite(ix, cf.memProp)
    const u = fnDeclIx[name] ?? -1
    if u >= 0 && declFirstParamIsSelf(name) { return u }
  }
  -1
}

// Whether member callee `cf` reads a struct field holding a function value.
export function esCalleeIsField(cf: Member): boolean {
  const rt = nodeTyIxOf(cf.memObj)
  if rt < 0 { return false }
  const t = tyAt(nomErasedTyIx(rt))
  if t is TyObj { return objFieldType(t, cf.memProp) >= 0 }
  false
}

// Call `n`'s arguments in parameter order: a UFCS receiver first, as `m(o, a)` declares it.
// A call naming any argument answers none, so its type parameters stay open rather than bind
// to the wrong argument.
export function esCallArgs(n: Call): i32[] {
  const out: i32[] = []
  let k = 0
  while k < n.callArgNames.length {
    if n.callArgNames[k] != "" { return out }
    k = k + 1
  }
  if n.callFn >= 0 {
    const cf = nodeAt(n.callFn)
    if cf is Member { out.push(cf.memObj) }
  }
  let i = 0
  while i < n.callArgs.length {
    out.push(n.callArgs[i])
    i = i + 1
  }
  out
}

// The type bindings of row `r` as `<T = i32, U = string>`, or "" for an unpinned row.
export function esBindText(r: i32): string {
  if esBindCount[r] == 0 { return "" }
  let s = "<"
  let k = esBindStart[r]
  while k < esBindStart[r] + esBindCount[r] {
    if k > esBindStart[r] { s = s + ", " }
    s = s + esBindNames[k] + " = " + tyToStr(esBindTys[k])
    k = k + 1
  }
  s + ">"
}

// A dump line's name: `get p` for a getter, `operator "+" for P` for a user operator, the
// function's name otherwise.
export function esDumpLabel(r: i32): string {
  const d = nodeAt(esDecl[r])
  if d is FuncDecl {
    const prop = getDeclPropOf(d.fnName)
    if prop != "" { return "get " + prop }
    if opDeclOpOf(d.fnName) != "" { return "operator " + opDeclLabel(d.fnName) }
    return d.fnName
  }
  "?"
}
