// The classifier phase census (`$VL_CLS_CENSUS=1`): how often each type-blind classifier in
// `emit_classify.vl` is entered, per emit phase and per call site, read by no pass. Off by
// default; an unarmed compile pays one boolean test per classifier entry. The call sites are
// numbered only in a probe compiler `scripts/classifier-census.vl --callers` builds, which
// wraps each call's last argument in `clsCensusAtI`/`B`/`S`; elsewhere every site reads -1.

import { i32ToStr } from "./ast"
import { emitPhase } from "./emit_state"

export let clsCensusOn = false
let clsSite = -1
let clsKeys: string[] = []
let clsIx: {[string]: i32} = Map()
let clsN: i32[] = []

// Arms the census for this instance when `v` is non-zero; 0 on success.
export function setClsCensus(v: i32): i32 {
  clsCensusOn = v != 0
  0
}

// Empties the counts at compile start.
export function clsCensusReset() {
  clsSite = -1
  clsKeys = []
  clsIx = Map()
  clsN = []
}

// Counts one entry of classifier `fname` under the pending call site and the current phase.
export function clsCensusEnter(fname: string) {
  const key = fname + "\t" + i32ToStr(clsSite) + "\t" + emitPhase
  clsSite = -1
  const at = clsIx.get(key) ?? -1
  if at >= 0 {
    clsN[at] = clsN[at] + 1
    return
  }
  clsIx[key] = clsKeys.length
  clsKeys.push(key)
  clsN.push(1)
}

// Marks call site `site` as the next classifier entry's caller and returns `v` unchanged.
export function clsCensusAtI(site: i32, v: i32): i32 {
  clsSite = site
  v
}

export function clsCensusAtB(site: i32, v: boolean): boolean {
  clsSite = site
  v
}

export function clsCensusAtS(site: i32, v: string): string {
  clsSite = site
  v
}

// The report rows, `<fn>\t<site>\t<phase>\t<count>`, read by the host one code unit at a time.
export function clsCensusCount(): i32 { clsKeys.length }

export function clsCensusLen(i: i32): i32 {
  clsKeys[i].length + 1 + i32ToStr(clsN[i]).length
}

export function clsCensusAt(i: i32, j: i32): i32 {
  const row = clsKeys[i] + "\t" + i32ToStr(clsN[i])
  row[j]
}
