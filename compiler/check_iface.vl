// `check_iface.vl` — each body's scheme record: the bounds it deferred for its call sites, held by
// the owning declaration (`l2-inferred-interfaces-design.md` §2.1). A bound is a row of its kind's
// log, and its index there is its identity: delivery marks and rollback name rows by index. Each
// owner's `Iface` lists its own rows per kind in recording order, so a call reads its callee's rows
// and module scope's instead of scanning every owner's. Depends on nothing.

// One deferred demand: the type it is over (`on`), up to three operands (`a`, `b`, `c`, -1 when
// unused), a spelling (`s`), the node that recorded it, the owner (-1 at module scope), a
// body-order stamp (`seq`, set by `bndPush`) and other nodes it stands for (`more`, `bndNoMore`
// when none). Each kind's constant says what its operands mean.
export type Bound = {
  on: i32,
  a: i32,
  b: i32,
  c: i32,
  site: i32,
  fn: i32,
  s: string,
  seq: i32,
  more: i32[],
}

// One owner's rows per kind, each list ascending.
export type Iface = {
  fn: i32,
  print: i32[],
  arrDef: i32[],
  nest: i32[],
  isTest: i32[],
  ret: i32[],
  write: i32[],
  method: i32[],
  member: i32[],
  ufcs: i32[],
  binary: i32[],
  arg: i32[],
}

// A `print` of a type touching a hole, re-asked at the pin against the print floors.
export const BND_PRINT = 0
// An `__array_new_default__` list whose element is a hole, re-asked for a default.
export const BND_ARRDEF = 1
// A composite holding a hole, re-asked against the vector-container refusals.
export const BND_NEST = 2
// An `is` test of record type `a` (spelled `s`) on an operand of type `on` touching a hole.
export const BND_IS = 3
// A return of `on` where `a` is expected, either side touching a hole (D551). `b` is 1 when only
// `a` does: a hole on the declared side alone has no cast to write, so it is exempt from the
// newtype rule. `site` is the returned expression.
export const BND_RET = 4
// A write of `on` into a binding or place of type `a` in a generic body, where `assignable` is
// vacuous and a return's bound cannot see it (D572). `s` names the binding ("" for a place) and
// picks the sentence. Owner `CSTR_DELIVERY_ONLY` is judged only by
// a delivery of the binding.
export const BND_LET = 5
// A builtin method argument `on` delivered where `a` is expected: a builtin has no declaration for
// an argument bound to name (D582). `b` is the other type its sentence names (-1 when none), `c`
// the method's form and `s` its label.
export const BND_BM = 6
// A member read, index or layout constant `s` on a receiver of type `on` touching a hole (D1431):
// `a` is 1 when it asks a demand, refused in the inference hole's words, and 0 when it asks a
// classification that keeps the direct spelling's sentence.
export const BND_MEM = 7
// A `self`-function call `s` whose receiver `on` touches a hole, selected by name alone in the
// body (D1005). `a` is the selected function's parameter-0 type (-1 for an overloaded call);
// `more` lists the other call nodes the row stands for.
export const BND_UFCS = 8
// A binary operator `s` over `on` and `a`, one touching a hole, which `binOpDefinedFor` re-asks at
// the pin. `site` is the expression (the direct spelling's numeric pair rule asks it) and `b` its
// literal shape (D2757): bounds of one body alike but for a node of the same shape are one bound.
export const BND_BIN = 9
// An argument `on` delivered to a parameter of type `a` of callee `s`, one touching a hole. `c` is
// the form (`ACF_*`, or N >= 1 for argument N of a call through a hole callee), `site` that
// argument's node or -1, and `b` the hole call itself, kept as the demand moves out (D13201).
export const BND_ARG = 10

// One flat log per kind: a nested list of records is far costlier for the compiler to compile.
let printLog: Bound[] = []
let arrDefLog: Bound[] = []
let nestLog: Bound[] = []
let isLog: Bound[] = []
let retLog: Bound[] = []
let letLog: Bound[] = []
let bmLog: Bound[] = []
let memLog: Bound[] = []
let ufcsLog: Bound[] = []
let binLog: Bound[] = []
let argLog: Bound[] = []
let ifaces: Iface[] = []
let ifaceSlot: {[i32]: i32} = Map()
const bndNone: i32[] = []

// The next body-order stamp: one counter over every kind, so the pin pass applies a body's writes
// in check order wherever each is deferred (D2218), and a solver can walk bounds in body order.
let bndSeq = 0

// The `more` of a bound that stands for no other node; never pushed onto.
export const bndNoMore: i32[] = []

// Clears every log and record (called from `initChecker`).
export function ifaceReset() {
  printLog = []
  arrDefLog = []
  nestLog = []
  isLog = []
  retLog = []
  letLog = []
  bmLog = []
  memLog = []
  ufcsLog = []
  binLog = []
  argLog = []
  ifaces = []
  ifaceSlot = Map()
  bndSeq = 0
  return 0
}

// The record of owner `fn`, made on first use.
function ifaceAt(fn: i32): Iface {
  const s = ifaceSlot[fn] ?? -1
  if s >= 0 { return ifaces[s] }
  const f: Iface = {
    fn: fn,
    print: [],
    arrDef: [],
    nest: [],
    isTest: [],
    ret: [],
    write: [],
    method: [],
    member: [],
    ufcs: [],
    binary: [],
    arg: [],
  }
  ifaceSlot[fn] = ifaces.length
  ifaces.push(f)
  return f
}

// The log of kind `k`.
function bndLog(k: i32): Bound[] {
  if k == BND_PRINT { return printLog }
  if k == BND_ARRDEF { return arrDefLog }
  if k == BND_NEST { return nestLog }
  if k == BND_IS { return isLog }
  if k == BND_RET { return retLog }
  if k == BND_LET { return letLog }
  if k == BND_BM { return bmLog }
  if k == BND_MEM { return memLog }
  if k == BND_UFCS { return ufcsLog }
  if k == BND_BIN { return binLog }
  if k == BND_ARG { return argLog }
  return []
}

// Owner record `f`'s list of kind `k`.
function ifaceRows(f: Iface, k: i32): i32[] {
  if k == BND_PRINT { return f.print }
  if k == BND_ARRDEF { return f.arrDef }
  if k == BND_NEST { return f.nest }
  if k == BND_IS { return f.isTest }
  if k == BND_RET { return f.ret }
  if k == BND_LET { return f.write }
  if k == BND_BM { return f.method }
  if k == BND_MEM { return f.member }
  if k == BND_UFCS { return f.ufcs }
  if k == BND_BIN { return f.binary }
  if k == BND_ARG { return f.arg }
  return []
}

// How many bounds of kind `k` are recorded.
export function bndCount(k: i32): i32 { return bndLog(k).length }

// Bound `i` of kind `k`; `i` is below `bndCount(k)`.
export function bndAt(k: i32, i: i32): Bound { return bndLog(k)[i] }

// Appends bound `b` of kind `k`, stamping its `seq`, and returns its index.
export function bndPush(k: i32, b: Bound): i32 {
  b.seq = bndSeq
  bndSeq = bndSeq + 1
  const log = bndLog(k)
  const i = log.length
  log.push(b)
  ifaceRows(ifaceAt(b.fn), k).push(i)
  return i
}

// Drops every bound of kind `k` from index `n` on, from the log and from each owner's list.
export function bndTruncate(k: i32, n: i32) {
  const log = bndLog(k)
  while log.length > n {
    const b = log.pop()
    if b != null { ifaceRows(ifaceAt(b.fn), k).pop() }
  }
  return 0
}

// Whether any bound of kind `k`, of any owner, sits at node `site`.
export function bndSiteHas(k: i32, site: i32): boolean {
  for b in bndLog(k) {
    if b.site == site { return true }
  }
  return false
}

// Owner `fn`'s rows of kind `k`, ascending; a caller must not change the list.
export function bndOwnRows(k: i32, fn: i32): i32[] {
  const s = ifaceSlot[fn] ?? -1
  if s < 0 { return bndNone }
  return ifaceRows(ifaces[s], k)
}

// The first row of kind `k` after `after` and below `n` that a call of `callee` may own, else `n`:
// the next row for an undeclared callee (-1 or below), else the next of the callee's and module
// scope's. The caller still filters each by ownership; this only skips rows no filter could take.
export function bndNextRow(k: i32, callee: i32, after: i32, n: i32): i32 {
  if callee < 0 { return if after + 1 < n { after + 1 } else { n } }
  const x = bndFirstAbove(bndOwnRows(k, callee), after, n)
  const y = bndFirstAbove(bndOwnRows(k, -1), after, n)
  return if x < y { x } else { y }
}

// The least entry of ascending `rows` above `after`, if below `n`; else `n`.
function bndFirstAbove(rows: i32[], after: i32, n: i32): i32 {
  let lo = 0
  let hi = rows.length
  while lo < hi {
    const mid = (lo + hi) / 2
    if rows[mid] <= after { lo = mid + 1 } else { hi = mid }
  }
  if lo < rows.length && rows[lo] < n { return rows[lo] }
  return n
}
