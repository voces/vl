// The operator a deferred unary negation is recorded under, both operands its argument.
export const OP_NEG = "unary -"

// The same for a deferred bitwise not `~`, which also refuses a float.
export const OP_BNOT = "unary ~"

// The operator a deferred `as` over a gradual union is recorded under, the target on the right.
export const OP_AS = "as"

// The constraint an operator records when a 64-bit integer constant meets a type-parameter
// operand: the pin refuses a type narrower than the constant (D2712).
export const OP_LITFIT = "constant width"

export const ACF_PLAIN = 0

export const ACF_TPL = -1

// A composite argument carrying a hole (`xs: T[]`, `[x]`, `[...xs]`), re-asked at the pin by
// its own node, as a binding's is, so a literal still adapts element-wise (D3253).
export const ACF_COMP = -2

// A list index carrying a hole, held at the pin to the direct spelling's `i32` rule (D3584).
export const ACF_INDEX = -3

// An argument a call through a slot holding a generic hands a function written there, which the
// generic's instance makes it take at exactly the argument's type, as at closed types (D12238).
export const ACF_EXACT = -4

// The result such a call takes from the generic's instance, which the function written there
// must return exactly, as at closed types (D12331).
export const ACF_EXACT_RET = -5

// A call at open argument types through a choice or a re-pointed `let` of un-annotated
// functions, its node the callee: the pin judges every function it may run at the closed types,
// as a call there does (D13782). Both sides are the call's function type, so it always fits.
export const ACF_CHOICE = -6

// The `memCstr.prop` a call through a hole records: not a field name, so no member row shares it.
export const OP_CALL_PIN = "()"

// A call under a null test of its callee: a pin of the `null` type leaves the branch dead, so
// the call is not refused there, though the direct spelling refuses it (D3197).
export const OP_CALL_GUARDED_PIN = "?()"

export const SUBST_DECLARED = 1

// D1591 — empty-collection holes delivered to an inferred return. At a declared return
// `constrainEmptyExpr` pins on the spot; under inference the destination is the join of every
// return and is not final until the body ends. `irhMarks` scopes the recorded rows to one body,
// and `irhConcrete` banks the first concrete witness, since the join can keep the open side.
export const irhExprs: i32[] = []

export const irhTys: i32[] = []

export const irhMarks: i32[] = []

export const irhConcrete: i32[] = []

// Every value delivered to the inferred return of the bodies being checked, with its type, one
// frame per body: `inferRetF32Join` reads them to type an f32 value beside literals f32.
export const irwExprs: i32[] = []

export const irwTys: i32[] = []

export const irwMarks: i32[] = []

// A path's state after a kill no later write replaced: the join cannot narrow over it (D3285).
export const NAR_UNKNOWN = -3

// The last index of `v` in `xs`, or -1.
export function i32ListLastIx(xs: i32[], v: i32): i32 {
  let i = xs.length - 1
  while i >= 0 {
    if xs[i] == v { return i }
    i = i - 1
  }
  -1
}

// Whether the `if` at `ix` is itself the statement being checked, the unit a post-guard
// narrowing joins after.
export function narIfIsStmt(ix: i32): boolean {
  const top = crStmtIxs.length - 1
  top >= 0 && crStmtIxs[top] == ix
}

// Does type-arena index `ty` still reach an unresolved collection hole — an empty `[]` element
// (`aElem < 0`) or a bare `Map()`/`Set()` key/value (`mKey`/`mVal < 0`) that no annotation and
// no downstream use ever pinned?
export function unresolvedHole(ty: i32) {
  if ty < 0 { return false }
  const t = tyAt(ty)
  match t {
    TyArray => t.aElem < 0
    TyMap => t.mKey < 0 || t.mVal < 0
    // Every other row holds no collection hole of its own.
    TyPrim | TyErr | TyObj | TyFunc | TyUnion | TyNullable | TyVar | TyLit | TyNeg => false
  }
}

// Open the deferred-pin frame for one function body (D1591). Pushed and popped with the
// body scope, so the rows a nested body records are its own.
export function pushInferRetHoles() {
  irhMarks.push(irhExprs.length)
  irhConcrete.push(-1)
  irwMarks.push(irwExprs.length)
  0
}

// Record a value delivered to an inferred return — a `return e`, the body's trailing expression,
// or a tail `if`/`else` arm. One that still reaches an open collection hole becomes a row to
// pin; the first one that does not is this body's destination witness, which is what the rows
// are pinned against at the flush (D1591).
export function noteInferRetWitness(srcExpr: i32, srcTy: i32) {
  if irhMarks.length == 0 { return 0 }
  if srcTy < 0 { return 0 }
  // A chain link names no node here; its caller records the link itself.
  if srcExpr >= 0 { noteInferRetValue(srcExpr, srcTy) }
  if tyReachesEmptyHole(srcTy, 8) {
    irhExprs.push(srcExpr)
    irhTys.push(srcTy)
    return 0
  }
  const top = irhConcrete.length - 1
  if irhConcrete[top] < 0 && tyPinsEmptyHoles(srcTy, 8) {
    irhConcrete[top] = srcTy
  }
  0
}

// Record the value `srcExpr`, typed `srcTy`, delivered to the inferred return of the body being
// checked, for `inferRetF32Join`.
export function noteInferRetValue(srcExpr: i32, srcTy: i32) {
  if irwMarks.length == 0 || srcTy < 0 { return 0 }
  irwExprs.push(srcExpr)
  irwTys.push(srcTy)
  0
}

// Whether an inferred return and a list literal adopt f32 as an `if` join does. Off: each reads
// f64 today and runs where an f64 is accepted, so adopting changes values (D2774).
export function f32JoinRetypesRunning(): boolean { false }

// Hand `src`'s resolved element to `dst`'s open one, enforcing the link's own invariant that the
// two rows carry the same element. True when the pin moved, which is what the fixpoint below
// iterates on.
export function holeLinkPinFrom(src: i32, dst: i32) {
  if src < 0 || dst < 0 { return false }
  const s = tyAt(src)
  if s is TyArray {
    if s.aElem >= 0 {
      const d = tyAt(dst)
      if d is TyArray {
        if d.aElem < 0 {
          d.aElem = s.aElem
          tyMutEpoch = tyMutEpoch + 1 // in-place element pin — canonical keys change
          return true
        }
      }
    }
  }
  false
}

// An element type this pass must not judge: a `TyErr`, whose own diagnostic is already raised
// and a second one on the same expression is the cascade `TyErr` exists to stop, or a `TyVar`,
// a generic body's hole the instance decides. Both answer `false` to `elemHasZero`, which is
// why they need naming ahead of it.
export function arrDefElemDeferred(el: i32) {
  if el < 0 { return true }
  const t = tyAt(el)
  if t is TyErr { return true }
  t is TyVar
}

// Whether the witness `noteInferredRet` is handed next is a literal, set by its caller.
export let inferRetNextLit = false
export function inferRetNextLitSet(v: boolean) { inferRetNextLit = v }

// True while an explicit `return`'s argument is checked: an `if` there is a value slot, so its
// verdict never rewinds the inferred return (the slot's own void check refuses it instead).
export let inRetArg = false
export function inRetArgSet(v: boolean) { inRetArg = v }

// The value type of the most recently checked `Block` — its trailing expression's type, or
// `TY_VOID` when the block ends in a statement. `checkNode(Block)` itself returns `TY_VOID`, so
// this carries the tail value out of band for an `if … { v } else { w }` expression to join its
// branch values. Read immediately after a `checkNode(block)`.
export let blockTailTy = -1
export function blockTailTySet(v: i32) { blockTailTy = v }

// The node `blockTailTy` came from, or -1 for a valueless block. Written in the same place and
// read in the same breath, so a tail `if`/`else` arm can hand its own expression to
// `constrainEmptyExpr` rather than the arms' join, which is a different arena row (D1591).
export let blockTailIx = -1
export function blockTailIxSet(v: i32) { blockTailIx = v }

// True while checking a node whose value is the enclosing function's return — the body's tail
// statement, and by propagation the tail of each branch of a tail `if`/`else`. It gates seeding
// `inferObserved` from a branch value, so a base-case branch pins the type before a recursive
// sibling is checked, without a non-tail `if`'s branch values polluting the inferred return.
export let retTailPos = false
export function retTailPosSet(v: boolean) { retTailPos = v }

// Whether the `match` being checked is in return-tail position, where its join seeds the
// inferred return and so keeps the reading it has today (D2774).
export let matchInRetTail = false
export function matchInRetTailSet(v: boolean) { matchInRetTail = v }

// Depth counter for the literal-adoption window (`nomLitAdopts`): while positive, `assignableGo`'s
// brand test stands down. Only ever raised around a walk whose source is a scalar literal, which
// is what makes waiving the whole walk equivalent to waiving the destination's own brand.
export let nomLitRelax = 0
export function nomLitRelaxSet(v: i32) { nomLitRelax = v }

// The empty answer of a call no destination binds, shared and never written.
export const NO_DST_NAMES: string[] = []

// The last "not a JSON shape" reason, banked rather than raised — see `jsonDeepIsSite`.
export let jwBadMsg = ""
export function jwBadMsgSet(v: string) { jwBadMsg = v }

// Set to make every statically-known callee answer opaque — the broad rule, "any call receiving
// the object invalidates every narrowing rooted at it" — kept as one switch so the two candidate
// rules are one code path and one measurement harness. The effect-based rule is what ships;
// `docs/internals/open-rulings.md`.
export const ALIAS_RULE_BROAD = false

// The cell tag of a subscript step whose container is typed `t`; "" for a field step or when unknown.
export function keyStepTag(step: string, t: i32): string {
  if step[0] == '[' && t >= 0 && !tyHasTyVar(t) { return cellTagOfTy(t) }
  ""
}

// The object a field write stores into (`q` for `q.f = …`); a cell write's is `idxRecvIx`'s.
export function aliasWriteRecvIx(tgtIx: i32): i32 {
  const t = nodeAt(peelParenIx(tgtIx))
  if t is Member { return peelParenIx(t.memObj) }
  idxRecvIx(peelParenIx(tgtIx))
}

// The container a cell write `xs[i] = …` stores into, or -1 for a target that is no cell.
function idxRecvIx(ix: i32): i32 {
  const t = nodeAt(ix)
  if t is Index { return peelParenIx(t.idxArr) }
  -1
}

// Whether a write of `rt` into a place declared `dcl` leaves the place reading at the member
// its pin lands on (`HD_TVW`): a value typed at a declared type parameter, into a concrete
// declaration admitting `null`. Each instance re-reads the place at its pin, so a local, a
// global, a field and a cell all take the pin's read over any union (D3240, D8820).
export function tvPlaceWrite(dcl: i32, rt: i32): boolean {
  if (!tyIsDeclaredParam(rt) || !tyAdmitsNull(dcl) || tyHasTyVar(dcl)) {
    return false
  }
  const nn = nonNullTy(dcl)
  nn >= 0 && nn < T.tys.length
}

// The type a place declared `dcl` reads at after `tvPlaceWrite` stored `rt`: `cur` when it
// already is that read, else a fresh `HD_TVW` hole over `rt`.
export function tvWriteTy(dcl: i32, rt: i32, cur: i32): i32 {
  if tyIsTvWriteOf(cur, dcl, rt) { return cur }
  mkDerivedHole(HD_TVW, "", dcl, -1, rt)
}

// A list place `p` declared `declTy` and narrowed to `nt` (`xs is K[]`) holds its narrowing only
// while no element is written wider, so each nesting depth whose element `nt` narrows gets an
// entry `xs[*]…[*]` the path rules end at a store or an append through any alias (D4926).
export function narFitElems(p: i32, declTy: i32, nt: i32) {
  const d0 = nonNullTy(declTy)
  if d0 < 0 { return 0 }
  const du = tyAt(d0)
  const mems = if du is TyUnion { du.uMembers } else { [d0] }
  for m in mems {
    if narFitElemsOf(p, m, nonNullTy(nt)) { return 0 }
  }
  0
}

// `narFitElems` against one declared list `d`: pushes the entries and answers true when some
// depth of `d` holds wider elements than `n`.
function narFitElemsOf(p: i32, d0: i32, n0: i32): boolean {
  let d = d0
  let n = n0
  const keys: i32[] = []
  const tys: i32[] = []
  let key = p
  while d >= 0 && n >= 0 && tyAt(d) is TyArray && tyAt(n) is TyArray {
    const da = tyAt(d)
    const na = tyAt(n)
    if da is TyArray && na is TyArray {
      key = placeWith(key, LIST_EVERY_STEP)
      keys.push(key)
      tys.push(na.aElem)
      d = da.aElem
      n = na.aElem
    }
  }
  if keys.length == 0 || key < 0 || d < 0 || n < 0 || tySame(d, n) {
    return false
  }
  let i = 0
  while i < keys.length {
    nfSlotsPush(npKeys.length)
    nfNamesPush(placeText(p))
    npKeysPush(keys[i])
    npTysPush(tys[i])
    npInvByPush(-1)
    npEpochsPush(narFnEpoch)
    npSettlePush(-2)
    npCapByPush(-1)
    npAsgPush(0)
    i = i + 1
  }
  true
}

// The list `ix` reads (a name or field path, or a subscript chain over one) as a message spells
// it: a literal or named subscript as written, any other as `[…]`.
export function narRowText(ix: i32): string {
  const p = peelParenIx(ix)
  if p < 0 || p >= P.nodes.length { return "" }
  const n = nodeAt(p)
  if n is Ident { return n.identName }
  if n is Member { return narRowText(n.memObj) + "." + n.memProp }
  if n is OptMember { return narRowText(n.omObj) + "?." + n.omProp }
  if !(n is Index) { return "" }
  const k = nodeAt(peelParenIx(n.idxIndex))
  const sub = if k is NumLit { k.numText } else if k is Ident { k.identName } else { "…" }
  narRowText(n.idxArr) + "[" + sub + "]"
}

// The `.map(…)` that copies a list `depth` lists deep whose elements are narrowed: one `map` per
// level, so no inner list of the narrowed one is shared with the copy.
export function mapCopyText(depth: i32): string {
  const vars = ["x", "r", "q", "p"]
  let text = ".map((x) => x)"
  let k = 1
  while k < depth {
    let v = "e" + i32ToStr(k)
    if k < vars.length { v = vars[k] }
    text = ".map((" + v + ") => " + v + text + ")"
    k = k + 1
  }
  text
}

// The innermost overlay slot holding an element entry of the place `base` (`base[*]…`, `base` a
// name or a field or literal-subscript path), whether or not it is still in force, or -1.
export function elemEverySlotOf(base: string): i32 {
  const pfx = base + LIST_EVERY_STEP
  let i = npKeys.length - 1
  while i >= 0 {
    const k = npKeys[i]
    if keyHasPrefix(k, pfx) && keyIsListEvery(k) && elemKeyBase(k) == base {
      return i
    }
    i = i - 1
  }
  -1
}

// Whether `name`, bound at slot `s`, holds a live element narrowing (`name is K[]`). A function
// capturing it may run after any element write, which no assignment of `name` marks, so it reads
// `name` as declared.
export function crElemNarrowLive(s: i32, name: string): boolean {
  const i = narrowedPathIx(placeFind(s, name + LIST_EVERY_STEP))
  i >= 0 && npInvBy[i] < 0
}

// The emitter's read of the names `crCaptureWiden` widened in the nested function `fnIx`.
export function capWidenOf(fnIx: i32): string[] {
  crCapWidenBank[fnIx] ?? crNoNames
}

// Whether the element entry at place `p` stands beside a narrowing of its list's name, so a store
// or append through that name is checked against the narrowed element.
export function elemKeyStoresChecked(p: i32): boolean {
  const i = narrowedPathIx(p)
  i >= 0 && narFitNameOf(i) != ""
}

// The value a plain `=` assignment at `atIx` stores, or -1 for any other node.
export function asgRhsIx(atIx: i32): i32 {
  if atIx < 0 || atIx >= P.nodes.length { return -1 }
  const an = nodeAt(atIx)
  if an is BinExpr {
    if an.binOp == "=" { return an.binRight }
  }
  -1
}

// How many element steps the place `ix` reads below the base of its element prefix
// (`elemRecvPrefix`: `b[i][j]` is 2, `o.xs[i]` is 1), or -1 when it has none.
export function elemDepthOf(ix: i32): i32 {
  const pfx = elemRecvPrefix(ix)
  if pfx == "" { return -1 }
  elemKeyDepth(pfx)
}

// How many `[*]` steps end the element key `k`.
export function elemKeyDepth(k: string): i32 {
  (k.length - elemKeyBase(k).length) / LIST_EVERY_STEP.length
}

// The element key `k` without the `[*]` steps that end it: the place its list entry is keyed on
// (`b[*][*]` is `b`, `o.xs[*]` is `o.xs`).
export function elemKeyBase(k: string): string {
  let e = k.length
  while (
    e >= LIST_EVERY_STEP.length
    && k.slice(e - LIST_EVERY_STEP.length, e) == LIST_EVERY_STEP
  ) {
    e = e - LIST_EVERY_STEP.length
  }
  k.slice(0, e)
}

// Before a `for` over a list is checked, gives its variable the element type the declared list
// holds, and the callbacks in its body their parameters' (`cbPendCollect`), so a method called on
// one resolves to the built-in rather than an opaque writer.
export function cbPendForLoop(loopIx: i32) {
  cbPendClear()
  const n = nodeAt(loopIx)
  if !(n is ForIn) { return 0 }
  const lt = placeDeclListTy(n.fiIter)
  if lt < 0 { return 0 }
  const la = tyAt(lt)
  if !(la is TyArray) || la.aElem < 0 { return 0 }
  const bound: string[] = []
  fnBoundNames(loopIx, bound)
  let seen = 0
  for b in bound {
    if b == n.fiVar { seen = seen + 1 }
  }
  if seen != 1 { return 0 }
  cbPendNames.push(n.fiVar)
  cbPendTys.push(la.aElem)
  cbPendCollect(n.fiBody, bound)
  0
}

// The declared, non-null list type of the place `ix` names — a binding, or a subscript chain
// over one — before it is checked, or -1.
function placeDeclListTy(ix: i32): i32 {
  const p = peelParenIx(ix)
  if p < 0 || p >= P.nodes.length { return -1 }
  const n = nodeAt(p)
  if n is Ident {
    const t = identTyOf(p, n.identName)
    if t < 0 { return -1 }
    return nonNullTy(t)
  }
  if !(n is Index) { return -1 }
  const inner = placeDeclListTy(n.idxArr)
  if inner < 0 { return -1 }
  const it = tyAt(inner)
  if !(it is TyArray) || it.aElem < 0 { return -1 }
  nonNullTy(it.aElem)
}

// Whether the expression at `exprIx` (peeled through parens) is a `match` — the void-typed
// expression form every void-in-value-slot gate exempts, and the one predicate all of them ask.
// An if-expression is not exempt: an else-less `if` used as a value is `T | null` in every value
// position, so an `if` that still types `void` here has a void arm, which is what the gates catch.
export function voidSlotExemptExpr(exprIx: i32) {
  if exprIx < 0 { return false }
  let vi = exprIx
  const vp = nodeAt(vi)
  if vp is Paren { vi = vp.parInner }
  const vn = nodeAt(vi)
  if vn is MatchExpr { return true }
  false
}

// The arm of the if-expression at `ix` whose last statement yields no value, or `ix` itself when
// the expression is not an if or no arm is found.
export function ifNoValueArmAt(ix: i32): i32 {
  let vi = ix
  const vp = nodeAt(vi)
  if vp is Paren { vi = vp.parInner }
  const vn = nodeAt(vi)
  if vn is IfStmt {
    const t = blockNoValueTail(vn.ifThen)
    if t >= 0 { return t }
    if vn.ifElse >= 0 {
      const en = nodeAt(vn.ifElse)
      if en is IfStmt {
        const r = ifNoValueArmAt(vn.ifElse)
        if r != vn.ifElse { return r }
      } else {
        const e = blockNoValueTail(vn.ifElse)
        if e >= 0 { return e }
      }
    }
  }
  ix
}

// `match` when the expression at `ix` is a match (or its desugared if), else `if`.
export function valueBranchKeyword(ix: i32): string {
  let vi = ix
  const vp = nodeAt(vi)
  if vp is Paren { vi = vp.parInner }
  if nodeAt(vi) is MatchExpr || njMatchDesugared(vi) { return "match" }
  "if"
}

// The last statement of the block at `b` when it yields no value (the block itself when empty),
// or -1 when it yields one.
function blockNoValueTail(b: i32): i32 {
  if b < 0 { return -1 }
  const bn = nodeAt(b)
  if bn is Block {
    if bn.blkStmts.length == 0 { return b }
    const last = bn.blkStmts[bn.blkStmts.length - 1]
    const lt = nodeTyIxOf(last)
    if lt < 0 || isVoidTy(lt) { return last }
  }
  -1
}

// Append one narrowing fact (place key → type) when the place is stable and
// the narrowed type resolved (-1 means "no fact" and is skipped).
// A list `cur` that keeps its storage under `xs is chk` (a string list against a string literal
// set) still narrows its innermost element reads: the fact `xs[*]…[*]` holds `chk`'s leaf.
export function pushElemReadFact(
  placeIx: i32,
  cur: i32,
  chk: i32,
  places: i32[],
  tys: i32[],
) {
  let d = nonNullTy(cur)
  let n = chk
  let depth = 0
  while d >= 0 && n >= 0 && tyAt(d) is TyArray && tyAt(n) is TyArray {
    const da = tyAt(d)
    const na = tyAt(n)
    if da is TyArray && na is TyArray {
      depth = depth + 1
      d = da.aElem
      n = na.aElem
    }
  }
  if d < 0 || n < 0 || tySame(d, n) { return 0 }
  let key = placeOf(placeIx)
  while depth > 0 && key >= 0 {
    key = placeWith(key, LIST_EVERY_STEP)
    depth = depth - 1
  }
  if key < 0 || !placeIsPath(key) { return 0 }
  places.push(key)
  tys.push(n)
  0
}

export function pushNarrowFact(
  placeIx: i32,
  ty: i32,
  places: i32[],
  tys: i32[],
) {
  if ty < 0 { return 0 }
  const p = placeOf(placeIx)
  if p < 0 { return 0 }
  places.push(p)
  tys.push(ty)
  0
}

// How a discriminant fact selects surviving arms. `"intersect"` keeps an arm whose field type can
// still be the fact — the rule for a positive test, and for the complement of an `is`, where the
// fact is already the subtracted remainder. `"exclude"` keeps an arm whose field type is not wholly
// the fact — the complement of an equality, where only an arm pinned to that literal is ruled out.
export type DiscrimMode = "intersect" | "exclude"

// May the else arm of `if <hole> is T` carry a deferred remainder (`HD_GNOT`)? Two exclusions,
// neither a design rule. A literal-bearing `T` is the emitter's reach: `litElseNarrow` reads the
// pin's softened spelling, so the literal matches no member and the arm reads the raw box (D1412).
// A shape `T` would re-base the hole's field demands onto a derived hole no argument check sees.
export function holeElseRemainderOk(tIdx: i32): boolean {
  if tIdx < 0 { return false }
  const t = tyAt(tIdx)
  if t is TyObj { return false }
  true
}

// Is `ix` a `const` with no annotation and a list, object or `Map()`/`Set()` initializer? A
// `let` may be re-pointed at any list, so its initializer says nothing about its value.
export function letDeclIsUnannotCtnLit(ix: i32): boolean {
  const n = nodeAt(ix)
  if n is LetDecl {
    if n.letKw != "const" { return false }
    if n.letType >= 0 { return false }
    if n.letInit < 0 { return false }
    const iv = nodeAt(n.letInit)
    if iv is ArrayLit { return true }
    if iv is ObjLit { return true }
    return exprIsCollCtorCall(n.letInit)
  }
  false
}

// Is `ix` a `let`/`const` with no annotation and an object-literal initializer? The one shape
// `markObjLitBinding` records, asked at both the hoist and the pass-2 declaration.
export function letDeclIsUnannotObjLit(ix: i32): boolean {
  const n = nodeAt(ix)
  if n is LetDecl {
    if n.letType >= 0 { return false }
    if n.letInit < 0 { return false }
    const iv = nodeAt(n.letInit)
    if iv is ObjLit { return true }
  }
  false
}

// Module-level un-annotated `const`s holding a numeric literal, written there or copied from
// another such `const` by name: the name to the literal.
// Top-level names declared both as a function and as a value binding, refused as redeclared;
// a read of one is that refusal's cascade (DV-401).
export let modClashNames: {[string]: boolean} = Map()
export function modClashNamesSet(v: {[string]: boolean}) { modClashNames = v }

// The name braced as the whole last statement of block `body`, `{ steps }`, or -1.
export function braceNameTail(body: i32): i32 {
  if body < 0 || body >= P.nodes.length { return -1 }
  const b = nodeAt(body)
  if b is Block {
    if b.blkStmts.length == 0 { return -1 }
    const last = nodeAt(b.blkStmts[b.blkStmts.length - 1])
    if last is Block {
      if (
        last.blkStmts.length == 1
        && i32ListHas(braceNameStmts, last.blkStmts[0])
      ) {
        return last.blkStmts[0]
      }
    }
  }
  -1
}

// An operand typed `otherTy`, when `i64`, beside a type-parameter operand typed `holeTy` is
// computed at the parameter's width, so a narrower pin must refuse it (D2712).
export function cexNoteHoleWidth(holeTy: i32, otherTy: i32) {
  if otherTy != TY_I64 || !tyHasHole(holeTy) || tyHasHole(otherTy) { return 0 }
  noteBinCstr(holeTy, OP_LITFIT, otherTy)
}

// An annotated literal binding read as the `??` default `ix`, whose left operand is `ctx` once
// null is removed, would be delivered at `ctx` without its annotation, which may not hold it.
export function lbiNoteCoalDefault(ix: i32, ctx: i32) {
  if lbiBindName.length == 0 || inferQuiet || ctx < 0 { return 0 }
  const c = lbiOperandCand(ix)
  if c >= 0 && lbiAnn[c] >= 0 && lbiAnn[c] != ctx { lbiCoalUnsafe[c] = true }
  0
}

// Does a return expression's type get pinned by the return annotation rather than inferred on its
// own? An empty `[]`/`{}`/`Map()`/`Set()` or a bare `null` resolves from the declared return
// through `T.curRet`, so the annotation is load-bearing.
export function retInfluencedByAnnot(ix: i32) {
  if ix < 0 { return false }
  const nd = nodeAt(ix)
  match nd {
    ArrayLit => {
      return nd.arrElems.length == 0
    }
    ObjLit => {
      return nd.objFields.length == 0
    }
    NullLit => {
      return true
    }
    Call => {
      if nd.callFn < 0 { return false }
      const cn = nodeAt(nd.callFn)
      if cn is Ident {
        if cn.identName == "Map" || cn.identName == "Set" {
          return nd.callArgs.length == 0
        }
      }
    }
    // Every other expression types on its own, without the annotation.
    NumLit | StrLit | CharLit | BoolLit | Ident | Unary | BinExpr | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// Whether `t` is a union holding a declared type parameter, the shape `tpGradualView` opens.
export function tyIsGradualUnion(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const u = tyAt(t)
  if u is TyUnion { return unionHasDeclaredParam(u.uMembers) }
  false
}

// Whether `lt op rt` is `==` or `!=` against `null`: a nullness test, not a numeric comparison.
export function nullTestOp(op: string, lt: i32, rt: i32): boolean {
  (op == "==" || op == "!=") && (isNullTy(lt) || isNullTy(rt))
}

// Whether the next `joinTys` keeps two runtime numeric types apart (`numApartJoin`); read and
// cleared at its entry, so a join nested inside it (a record's fields) is not affected.
export let njApart = false
export function njApartSet(v: boolean) { njApart = v }

// `njApart` for a return-inference join (`inferRetJoin`).
export let njApartRet = false
export function njApartRetSet(v: boolean) { njApartRet = v }

// Whether function `fx` declares type parameters.
export function njFnTyParams(fx: i32): boolean {
  if fx < 0 || fx >= P.nodes.length { return false }
  const fn = nodeAt(fx)
  if fn is FuncDecl { return fn.fnTyParams.length > 0 }
  false
}

// Whether function `fx` is checked again at each pin: it declares type parameters or has an
// un-annotated parameter.
export function njFnOpen(fx: i32): boolean {
  if njFnTyParams(fx) { return true }
  if fx < 0 || fx >= P.nodes.length { return false }
  const fn = nodeAt(fx)
  if fn is FuncDecl {
    for p in fn.fnParams {
      const pn = nodeAt(p)
      if pn is Param {
        if pn.parType < 0 { return true }
      }
    }
  }
  false
}

// Set for one `rejoinMembers` call whose members are runtime values, joined apart.
export let njRejoinApart = false
export function njRejoinApartSet(v: boolean) { njRejoinApart = v }

// Whether the value at `ix` is a list literal, which a join builds at its joined type as the
// direct spelling's `listJoinWidenCheck` does. Any other list keeps its own storage.
export function listLitFresh(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const x = parenPeelIx(ix)
  x >= 0 && x < P.nodes.length && nodeAt(x) is ArrayLit
}

// Removes every literal member of `kept` whose base scalar is also a member, which already holds
// it: `K | null` beside a `string` joins as `string | null`, and `9000000000 | 1` beside an `i32`
// as `9000000000 | i32`, so no literal sits beside the scalar that owns its rep (D5522).
export function dropLitsBesideBase(kept: i32[]) {
  let w = 0
  for k in kept {
    let lit = false
    if k >= 0 && tyAt(k) is TyLit {
      const base = softenLitTy(k)
      for o in kept {
        if o != k && tySame(o, base) { lit = true }
      }
    }
    if !lit {
      kept[w] = k
      w = w + 1
    }
  }
  while kept.length > w { kept.pop() }
  0
}

// A literal container's slot-by-slot constraints, for the one case where a container-level
// constraint cannot exist at all: `checkArrayLitNode` joins its element types, and a hole is
// permissively assignable both ways, so `[true, self]` inside a generic keeps `boolean`, drops the
// hole and records nothing. The ask is the slot, not the collection, and no binding name is given.
export function noteLitElemCstrs(srcExpr: i32, dstTy: i32, depth: i32) {
  if depth <= 0 || srcExpr < 0 || dstTy < 0 { return 0 }
  const e = nodeAt(srcExpr)
  if e is Paren { return noteLitElemCstrs(e.parInner, dstTy, depth - 1) }
  // The unfilled A-infer-null hole is why this loop tests the index before reading it. `let x =
  // null` binds `mkNullableTy(-1)` — a nullable whose inner is not yet a type — and `tyHasHole`
  // answers false for it, a `-1` not being a `TyVar`, so it reaches here. One peel takes `dtix` to
  // `-1`, and a second read of `T.tys[-1]` traps the compiler.
  let dtix = dstTy
  let peel = true
  while peel {
    if dtix < 0 {
      peel = false
    } else {
      const dn = tyAt(dtix)
      if dn is TyNullable { dtix = dn.nInner } else { peel = false }
    }
  }
  if dtix < 0 { return 0 }
  const d = tyAt(dtix)
  if e is ArrayLit {
    if d is TyArray {
      let i = 0
      while i < e.arrElems.length {
        noteLitElemCstrs(e.arrElems[i], d.aElem, depth - 1)
        i = i + 1
      }
    }
    return 0
  }
  if e is ObjLit {
    if d is TyObj {
      const fl = e.objFields
      let k = 0
      while k < fl.length {
        const fn = nodeAt(fl[k])
        if fn is FieldInit {
          const ft = objFieldType(d, fn.fiName)
          if ft >= 0 { noteLitElemCstrs(fn.fiValue, ft, depth - 1) }
        }
        k = k + 1
      }
    }
    return 0
  }
  const vt = coalPinTy(srcExpr, nodeTyIxOf(srcExpr))
  if tyHasHole(vt) { noteLetCstr(vt, dtix, srcExpr, "") }
  0
}

// D591 — did the element join produce a rep the destination does not have? A literal types as the
// join of its elements, and `assignableExpr`'s array-literal recursion then accepts it element-wise
// against a destination the join is not assignable to, leaving the literal node at the joined type.
// Keyed on the mismatch, not the destination; a destination that is itself a union is excluded.
export function arrLitJoinUnionElem(srcExpr: i32, dtix: i32): boolean {
  if srcExpr < 0 || dtix < 0 { return false }
  const st = nodeTyIxOf(srcExpr)
  if st < 0 { return false }
  const s = tyAt(st)
  if !(s is TyArray) { return false }
  if s.aElem < 0 { return false }
  const se = tyAt(s.aElem)
  if !(se is TyUnion) { return false }
  const d = tyAt(dtix)
  if !(d is TyArray) { return false }
  if d.aElem < 0 { return false }
  const de = tyAt(d.aElem)
  if de is TyUnion { return false }
  true
}

// Whether the array literal `srcExpr`, delivered element-wise into the list `dtix`, carries a
// softened element union: the destination's element is a union with a list member over a
// literal union, which the literal's own inference reads as `string` (D12561). Its row is keyed
// under the destination's spelling, so the literal takes the destination's type.
export function arrLitSoftenedUnionElem(srcExpr: i32, dtix: i32): boolean {
  if srcExpr < 0 || dtix < 0 { return false }
  const st = nodeTyIxOf(srcExpr)
  if st < 0 || st == dtix { return false }
  const d = tyAt(dtix)
  if !(d is TyArray) || d.aElem < 0 { return false }
  const de = tyAt(d.aElem)
  if de is TyUnion {
    for m in de.uMembers {
      const mt = tyAt(m)
      if mt is TyArray {
        if tyIsLitUnion(mt.aElem) || tyIsNullableLitUnion(mt.aElem) {
          return true
        }
      }
    }
  }
  false
}

// Every other node delivers its value whole, at its own checked type: no literal in it takes the
// destination's width.
export function radixLitNoParts(): i32 { 0 }

// Whether the array literal `ix`, recorded `f64[]`, is delivered element-wise into an `f32`
// element `dElem`: its elements adopt f32 (`[if c { 0.25 } else { 1 }]`), so the list is f32's.
export function f32ElemsAdoptedOver(ix: i32, dElem: i32): boolean {
  if primNameOf(dElem) != "f32" { return false }
  const lt = nodeTyIxOf(ix)
  if lt < 0 { return false }
  primNameOf(tyArrayElemIx(lt)) == "f64"
}

// Whether paren `ix` is recorded `f64[]` over an `inner` its delivery re-recorded `f32[]`.
export function f32ListUnder(ix: i32, inner: i32): boolean {
  if ix >= nodeTyIx.length { return false }
  const pt = nodeTyIxOf(ix)
  const it = nodeTyIxOf(inner)
  if pt < 0 || it < 0 { return false }
  primNameOf(tyArrayElemIx(pt)) == "f64"
    && primNameOf(tyArrayElemIx(it)) == "f32"
}

// Whether a join whose arms are typed `a` and `b` could be one `joinF32LitTails` re-types: one
// arm is an f32 value and the other is typed otherwise.
export function joinMayAdoptF32(a: i32, b: i32): boolean {
  if a == b { return false }
  primNameOf(a) == "f32" || primNameOf(b) == "f32"
}

// Is the expression at `ix`, peeling parens, an integer literal of magnitude exactly 2^31 — the one
// operand whose negation fits i32 while the bare literal does not? Companion of
// `numLexIs2Pow31` for the unary `-` arm.
export function isNegI32MinLit(ix: i32) {
  if ix < 0 { return false }
  const e = nodeAt(ix)
  match e {
    Paren => {
      return isNegI32MinLit(e.parInner)
    }
    NumLit => {
      if numLexIsFloat(e.numText) { return false }
      return numLexIs2Pow31(e.numText)
    }
    // Any other expression is not an integer literal.
    StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// The AST node — a `TypeRef` or annotation child — that diagnostics raised inside name resolution
// anchor to: the generic-alias arity error and the bare-generic-use error. Resolution is name-keyed
// and no node flows through it, so the positioned entry points bank their `TypeRef` node here
// through `nameToTyAt` / `resolveAnnotAt`; -1 outside them, as in the emitter's re-resolutions.
export let annotDiagAt = -1
export function annotDiagAtSet(v: i32) { annotDiagAt = v }

// The one wording for a written negation type, raised by both annotation routes so a rule
// enforced on one is not one a re-render walks around. A design refusal: a negation says what
// a value is NOT, naming no rep a storing position can choose. `!is` is unaffected — there the
// subtraction is from a known union and is never written as a type (D1773).
export function negInAnnotationMsg(spelling: string) {
  "`"
    + spelling
    + "` is a NEGATION, which says what a value is not and so names no rep a value can be stored at. A negation may only appear in a `!is` guard: write the positive type here, and narrow with `if x !is T { … }`"
}

// A storage type named where a value type is required. Banks the reason on the `unkTyClash` wire —
// the same channel the union rep-clash uses — so every `unknownTyText` caller reports why without
// gaining an arm, and returns the -1 that poisons the enclosing annotation exactly as an unresolved
// name does. The message names the rule: wasm has i8 as a storage type only, and VL mirrors that.
export function storageTyLeafFail() {
  unkTyClashSet(
    "`u8` is a storage type, not a value type — it may be an array element (`u8[]`), but a local, parameter, return, field, map value or generic argument is a value, and values are `i32`",
  )
  -1
}

// The wrong-count sentence for `Map<…>` / `Set<…>`.
export function collTyArgCountMsg(head: string, want: i32, got: i32): string {
  let what = " type arguments but got "
  if want == 1 { what = " type argument but got " }
  "`" + head + "` expects " + i32ToStr(want) + what + i32ToStr(got)
}

// A bare `Map` / `Set` names the collection without its type arguments, which no position can
// complete, so the suggestion is banked on `unkTyClash` rather than adding an arm. Reached only
// after the declared-name lookup, so a user `type Map = …` still wins.
export function builtinCtorTyLeafFail(name: string) {
  if name == "Map" {
    unkTyClashSet(
      "`Map` needs its key and value types — write `Map<K, V>`, e.g. `Map<string, i32>`",
    )
  } else if name == "Set" {
    unkTyClashSet(
      "`Set` needs its element type — write `Set<T>`, e.g. `Set<string>`",
    )
  }
  -1
}

// Whether two written arms stay apart as a return set keeps them: `T[] | i32[]` is two arms,
// `string[] | i32[]` at `T := string` (D4922, D2859).
export function annArmsPart(a: i32, b: i32): boolean {
  const saved = tpApartConcrete
  tpApartConcrete = true
  const part = tyParamsPart(a, b, 0)
  tpApartConcrete = saved
  part
}

// The collection flavor of a binding initializer: "Set" when the init is a `Set()`
// call, else "Map". Lets the i32-keyed diagnostic name the right constructor.
export function initMapCtorName(initIx: i32) {
  if initIx < 0 { return "Map" }
  const inode = nodeAt(initIx)
  if inode is Call {
    if inode.callFn < 0 { return "Map" }
    const cn = nodeAt(inode.callFn)
    if cn is Ident {
      if cn.identName == "Set" { return "Set" }
    }
  }
  return "Map"
}

// The unsupported-key refusal's sentence, shared by the index signature and `Map<K, V>`.
export function mapKeyUnsupportedMsg(keyText: string, ctor: string): string {
  "A "
    + keyText
    + "-keyed "
    + ctor
    + " isn't supported yet — `Map`/`Set` keys must be `string`, `i32` or `i64`"
}

// True if the one-member alias body at spelling root `root` is a bare type name or a
// generic application — the two spellings that make `type N = …` a plain alias reference.
// Asks the parser (`parseVariantName`'s `udTsRootAt` bank), not the rendered string, since a
// string scanner cannot tell `type X = null` apart from a bare name. A root of -1 answers false.
export function aliasRefIsPlainRoot(root: i32) {
  if root < 0 { return false }
  const k = tsKind[root]
  k == TS_NAME || k == TS_APP || k == TS_NULL
}

// The byte width a sub-word storage spelling names as a `flat` FIELD, or 0. `u8`/`i8` are one
// byte, `u16`/`i16` two — a flat-field-only storage width (like a `u8[]` element), read back as
// `i32` through `loadU8`/`loadI16`/... . `u32`/`u64` are excluded: they do not widen losslessly
// into a value type, so the ruling stops byte-multiples at 16 bits.
export function flatStorageSpellWidth(name: string) {
  if name == "u8" || name == "i8" { return 1 }
  if name == "u16" || name == "i16" { return 2 }
  0
}

// The declared type spelling of a `FieldDef`'s annotation, or "" when it has none. The
// nested-record test must ask the spelling, not the arena: a resolved `TyObj` carries no
// name, so it cannot say whether the record it describes is declared `flat`.
export function flatFieldTyName(fdIx: i32) {
  if fdIx < 0 { return "" }
  const fd = nodeAt(fdIx)
  if fd is FieldDef {
    if fd.fdType >= 0 {
      const tr = nodeAt(fd.fdType)
      if tr is TypeRef { return tr.tyName }
    }
  }
  ""
}

// Whether an unusable field type is one the declaration pass already reported (an
// unresolvable annotation lands as the error type). Suppresses a second message on the same field.
export function flatTyAlreadyErrored(tyIx: i32) {
  if tyIx < 0 { return true }
  const t = tyAt(tyIx)
  if t is TyErr { return true }
  false
}

// —— the one home for "is this `+` a list concat", the `+` twin of the `==` home above ——
// The element axis does not decide a concat: `emitListConcatG` allocates one backing and
// moves storage with two `array.copy`s, needing only the `{backing, len, cap}` wrapper every
// list rep has. An emitter floor (`binConcatRepUnresolved`) replaced the old element refusal (D721).
export function binPlusIsListByTy(lt: i32, rt: i32) {
  // Bound-checked before the arena read, since the emitter floor hands it an index
  // documented to be absent: `nodeTyIxOf` answers -1 for a node the checker banked nothing
  // on, and `T.tys[-1]` is an out-of-bounds read — a compiler trap with no diagnostic.
  if (lt < 0 || rt < 0) { return false }
  const lA = tyAt(lt)
  if lA is TyArray {
    const rA = tyAt(rt)
    if rA is TyArray { return true }
  }
  false
}

// Whether a function slot widens a string literal union's atom to `string` (or `string | null`).
// The reps differ, so a delivered function value is wrapped in an adapter that converts at the
// call (`fvaAdapt`); a function held inside a container is refused there instead (D4351).
export function fnSlotAtomToString(src: i32, dst: i32): boolean {
  if elemStoreClassOf(src, 8) != ESC_ATOM { return false }
  const d = nonNullTy(dst)
  d >= 0 && primNameOf(d) == "string"
}

// The half of a function slot's valtype `elemStoreClassOf` deliberately does not carry:
// nullability. `(ref null $str)` and `(ref $str)` are different wasm valtypes, so a
// `$fnsig` built at one is not the `$fnsig` a call site built at the other — the slot asks
// this extra question rather than changing what the shared classifier means for arrays and maps.
export function fnSlotNulDiffers(src: i32, dst: i32) {
  if elemStoreClassOf(src, 8) == ESC_UNKNOWN { return false }
  if elemStoreClassOf(dst, 8) == ESC_UNKNOWN { return false }
  // A nullable atom is the atom's own i32 with a reserved null id, so the valtype agrees.
  if (
    elemStoreClassOf(src, 8) == ESC_ATOM
    && elemStoreClassOf(dst, 8) == ESC_ATOM
  ) {
    return false
  }
  tyBearsNull(src) != tyBearsNull(dst)
}

// The expression at `ix` with `(…)` peeled — the syntactic form, for the constructor
// exemption in `objShapeAdapterless`. -1 stays -1.
export function ctorExprOf(ix: i32) {
  let cur = ix
  let peel = true
  while peel {
    if cur < 0 { return -1 }
    const e = nodeAt(cur)
    if e is Paren { cur = e.parInner } else { peel = false }
  }
  cur
}

// Whether `p` is a list method's spelling, rather than one only a map or set has
// (`set`/`add`/`delete`/`has`/`keys`).
function collIsListSpelling(p: string): boolean {
  p == "push"
    || p == "pop"
    || p == "clear"
    || p == "get"
    || p == "includes"
    || p == "indexOf"
    || p == "join"
}

// The joined type `listJoinWidenCheck` last walked each `if`, `match` or block against.
// Every leaf under such a node is then reported or fits, so a later walk against the same type
// skips it, and an `else if` chain whose links each join it costs one walk (D4557).
export let ljwWalked: {[i32]: i32} = Map()
export function ljwWalkedSet(v: {[i32]: i32}) { ljwWalked = v }

// `valueTailSplit` for `listJoinWidenCheck` at `j`: a node below `op` already walked against
// `j` is left out with its leaves.
export function ljwTailSplit(op: i32, j: i32, spine: i32[], leaves: i32[]) {
  const root = cwPeel(op)
  const todo: i32[] = [op]
  while todo.length > 0 {
    const at = cwPeel(todo.pop() ?? -1)
    if at >= 0 && at < P.nodes.length {
      if at != root && (ljwWalked.get(at) ?? -1) == j {
        0
      } else if (
        tailPushIfArms(at, todo)
        || tailPushMatchArms(at, todo)
        || tailPushBlockTail(at, todo)
      ) {
        spine.push(at)
      } else {
        leaves.push(at)
      }
    }
  }
  0
}

// Set beside the claimed pair: a readonly list reached through `| null` that needs a
// converting copy, one nested in another list, or a map whose list values widen (D2196).
export let shapeAdaptNulCopy = false
export function shapeAdaptNulCopySet(v: boolean) { shapeAdaptNulCopy = v }

export let shapeAdaptNestedCopy = false
export function shapeAdaptNestedCopySet(v: boolean) { shapeAdaptNestedCopy = v }

export let shapeAdaptMapShared = false
export function shapeAdaptMapSharedSet(v: boolean) { shapeAdaptMapShared = v }

export let shapeAdaptRecField = false
export function shapeAdaptRecFieldSet(v: boolean) { shapeAdaptRecField = v }

// Set beside a claimed record pair that stores a field differently (`recWidenWalk`), with the
// first such field's name.
export let shapeAdaptRecStorage = false
export function shapeAdaptRecStorageSet(v: boolean) { shapeAdaptRecStorage = v }

export let shapeAdaptRecStorageField = ""
export function shapeAdaptRecStorageFieldSet(v: string) {
  shapeAdaptRecStorageField = v
}

// `callResultIsInferred`, with the callee resolved by `identBoundFnDeclOf`.
export function recCallResultInferred(ix: i32): boolean {
  const e = nodeAt(ix)
  if e is Call {
    if e.callFn < 0 { return false }
    const cn = nodeAt(e.callFn)
    if cn is Ident {
      if cn.identName == "__array_new__" { return true }
      const fd = identBoundFnDeclOf(e.callFn)
      if fd >= 0 {
        const f = nodeAt(fd)
        if f is FuncDecl {
          if f.fnRet < 0 { return !noRetFnRelaysList(fd, e) }
          if f.fnTyParams.length > 0 && fnDeclRetHasTyVar(fd) {
            return !callPassesList(e)
          }
        }
      }
    }
  }
  false
}

// The records this pass's annotations spell inline (`{ f: i32 }`); each is a declared row too.
export let recAnnObjs: i32[] = []
export function recAnnObjsSet(v: i32[]) { recAnnObjs = v }

// The value expression the object literal at `lit` gives field `name`, or -1.
export function objLitFieldExpr(lit: i32, name: string): i32 {
  if lit < 0 { return -1 }
  const ol = nodeAt(lit)
  if ol is ObjLit {
    let i = 0
    while i < ol.objFields.length {
      const fi = nodeAt(ol.objFields[i])
      if fi is FieldInit {
        if fi.fiName == name { return fi.fiValue }
      }
      i = i + 1
    }
  }
  -1
}

// The field names `src` carries that `dst` does not, rendered `` `a`, `b` ``.
export function objDroppedFieldList(src: i32, dst: i32) {
  const s = tyAt(src)
  const d = tyAt(dst)
  let out = ""
  if s is TyObj {
    if d is TyObj {
      let i = 0
      while i < s.objFieldNames.length {
        if objFieldType(d, s.objFieldNames[i]) < 0 {
          if out != "" { out = out + ", " }
          out = out + "`" + s.objFieldNames[i] + "`"
        }
        i = i + 1
      }
    }
  }
  out
}

// The growable list over the same element as `ty` (a `readonly T[]` gives `T[]`), so a hint
// naming a source's declaration never proposes a view the source is then written through.
export function listMutableTwin(ty: i32): i32 {
  const t = tyAt(ty)
  if t is TyArray {
    if t.aRead == 1 { return mkArrayTy(t.aElem) }
  }
  ty
}

// The type to declare a delivered source at so it needs no widening: the destination with its
// outer `| null` and `readonly` taken off, since the source is a non-null value built to be
// written (`readonly f64[] | null` gives `f64[]`).
export function sourceBuildTy(dst: i32): i32 {
  if dst < 0 || dst >= T.tys.length { return dst }
  const d = tyAt(dst)
  if d is TyNullable { return listMutableTwin(d.nInner) }
  listMutableTwin(dst)
}

// Why a readonly list that needs a converting copy is refused where it sits: under `| null` or
// nested in another list, the copy has no lowering yet (D2196).
export function containerCopyGapWhy(underNul: boolean): string {
  let where = "a list nested in another list"
  if underNul { where = "a list that may be null" }
  ": its elements would be stored differently, so it would take a converting copy, and a "
    + "copy into "
    + where
    + " is not built yet (D2196)."
}

// `dst` with every list that pairs with a list of `src` made a view, through `| null`; any
// other type is kept as it stands. -1 only for a hole.
export function viewifyLists(src: i32, dst: i32, depth: i32): i32 {
  if src < 0 || dst < 0 || src >= T.tys.length || dst >= T.tys.length {
    return -1
  }
  if depth <= 0 { return dst }
  const d = tyAt(dst)
  const s = tyAt(src)
  let sIn = src
  if s is TyNullable {
    sIn = s.nInner
    if sIn < 0 || sIn >= T.tys.length { return -1 }
  }
  match d {
    TyNullable => {
      const inner = viewifyLists(sIn, d.nInner, depth - 1)
      if inner < 0 { return -1 }
      return mkNullableTy(inner)
    }
    TyArray => {
      const sa = tyAt(sIn)
      if sa is TyArray {
        const el = viewifyLists(sa.aElem, d.aElem, depth - 1)
        if el < 0 { return -1 }
        return mkArrayViewTy(el)
      }
      return dst
    }
    // No other destination has a view spelling; it is kept as it stands.
    TyPrim | TyErr | TyObj | TyFunc | TyUnion | TyMap | TyVar | TyLit | TyNeg => {
      return dst
    }
  }
}

// Whether the object literal `e` sets a field the record `dst` does not declare.
export function objLitSetsUndeclared(e: ObjLit, dst: i32): boolean {
  const d = tyAt(dst)
  if d is TyObj {
    let i = 0
    while i < e.objFields.length {
      const f = nodeAt(e.objFields[i])
      if f is FieldInit {
        if objFieldType(d, f.fiName) < 0 { return true }
      }
      i = i + 1
    }
  }
  false
}

// Look up a generic binding by type-param name in the parallel bind arrays.
export function bindOf(bNames: string[], bTys: i32[], name: string) {
  let i = 0
  while i < bNames.length {
    if bNames[i] == name { return bTys[i] }
    i = i + 1
  }
  -1
}

// The array builtin methods that constrain an un-annotated-param hole receiver to an array
// (rather than growing a `{method: any}` struct shape). Element-bearing and array-specific —
// a map exposes `set`/`add`/`has`/`delete`/`keys`/`values`, never these — so recognizing them
// on a hole can't hijack a genuine map/struct use.
export function holeArrMethod(name: string) {
  name == "map" || name == "filter" || name == "push" || name == "pop"
}

// The map/set builtin methods that constrain an un-annotated-param hole receiver to a map —
// the exact dual of `holeArrMethod`. Disjoint from the array methods and from every string
// method; `length`/`size` are not here because they are member reads shared by all three
// collections and already special-cased at the member arm.
export function holeMapMethod(name: string) {
  name == "set"
    || name == "get"
    || name == "has"
    || name == "delete"
    || name == "add"
    || name == "keys"
    || name == "values"
}

// Get-or-create hole `name`'s demanded map: an open `{[?]: ?}` on first use, then the same
// arena entry for every later map operation, accumulating onto one type. `isSet` mints the
// Set flavor, the only thing `.add` on a hole can mean. True if the demand still has an open
// half — the callee only reads the map, pinning neither key nor value.
export function holeMapDemandOpen(ty: i32) {
  if ty < 0 { return true }
  const t = tyAt(ty)
  if t is TyMap {
    // A hole in either half counts as open, not just the `-1` no-type-yet: `q[k] = v`
    // inside a callee whose `k`/`v` are themselves un-annotated params pins the demand to
    // those holes, a non-negative index that is still undecided.
    if t.mKey < 0 || t.mVal < 0 { return true }
    return tyIsHole(t.mKey) || tyIsHole(t.mVal)
  }
  true
}

// `ty` with a bare literal type softened to its base, as a recorded equality operand is
// compared and reported everywhere but `eqLitMemberOk`.
export function softenBareLitTy(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length || !(tyAt(ty) is TyLit) { return ty }
  softenLitTy(ty)
}

// Whether a pushed or set value of type `got` is a function with holes, or a record or list
// holding one, and the slot's type `want` has none: the store a binding would check, so
// `{ f: inc0 }` into an `{ f: (a: i32) => f64 }` slot is judged as `const r: R` is (D9471).
export function pushHoleFnToConcrete(got: i32, want: i32): boolean {
  if got < 0 || want < 0 || got >= T.tys.length || want >= T.tys.length {
    return false
  }
  if tyHasHole(want) || !tyHasHole(got) { return false }
  const g = tyAt(got)
  if g is TyFunc { return tyAt(want) is TyFunc }
  (g is TyObj || g is TyArray) && holdsHoleFn(got, 0)
}

// Whether `ty` is a function with holes, or a record field or list element holds one.
function holdsHoleFn(ty: i32, depth: i32): boolean {
  if ty < 0 || ty >= T.tys.length || depth > 8 { return false }
  const t = tyAt(ty)
  match t {
    TyFunc => {
      return tyHasHole(ty)
    }
    TyObj => {
      for ft in t.objFieldTypes {
        if holdsHoleFn(ft, depth + 1) { return true }
      }
      return false
    }
    TyArray => {
      return holdsHoleFn(t.aElem, depth + 1)
    }
    TyPrim | TyErr | TyVar | TyLit | TyNeg | TyNullable | TyUnion | TyMap => {
      return false
    }
  }
}

// The redirect for another language's element-count member read on a list, map, set or
// string. VL spells every collection's count `.length`; DECISIONS.md §"Every collection
// counts with `.length`".
export function lengthSpellNote(prop: string): string {
  if prop == "size" || prop == "count" { return "; did you mean '.length'?" }
  ""
}

export function noteUfcsWhy(memIx: i32, msg: string, data: string) {
  if memIx < 0 { return 0 }
  if msg == "" { return 0 }
  if ufcsWhyRow(memIx) >= 0 { return 0 }
  ufcsWhyAtPush(memIx)
  ufcsWhyMsgPush(msg)
  ufcsWhyDataPush(data)
  0
}

// A call's own sentence at a pin: "" when the callee resolves to a function `site` (the call, or -1)
// passes the right number of arguments, or defers. Otherwise the direct spelling's refusal, so a
// `| null` field is not called (D3197) and a function value keeps its exact arity (D5750).
export function callFloorMsg(fnTy: i32, site: i32) {
  if fnTy < 0 { return "" }
  const t = tyAt(fnTy)
  if t is TyFunc { return callPinArityMsg(t, site) }
  if t is TyErr { return "" }
  if tyHasHole(fnTy) { return "" }
  "called value is not a function (" + tyToStr(fnTy) + ")"
}

// The direct spelling's arity refusal when call `site` passes `f` a count other than its parameter
// count, as a call through a function value does; "" otherwise, or for a spread argument.
function callPinArityMsg(f: TyFunc, site: i32): string {
  if site < 0 || site >= P.nodes.length { return "" }
  const c = nodeAt(site)
  if !(c is Call) { return "" }
  const got = c.callArgs.length
  if got == f.fnParamTypes.length || hasSpreadItem(c.callArgs) { return "" }
  "wrong number of arguments: expected "
    + i32ToStr(f.fnParamTypes.length)
    + ", got "
    + i32ToStr(got)
}

// The `memCstr.prop` of a built-in method call on a gradual union, before the method's name.
export const MC_METHOD_MARK = "()"

export function noteKillSure(by: i32, key: string) {
  npKillSure[i32ToStr(by) + "|" + key] = true
  0
}

// Records a deferred UFCS-receiver constraint when the receiver still carries a hole, so
// the generic call site re-asks whether it is a receiver this `self`-function takes, under
// substitution. Stamped with the owning declaration for the by-name `TyVar` reason
// `noteMemCstr` needs it.
export function noteUfcsCstr(recv: i32, prop: string, ix: i32, p0: i32) {
  if recv < 0 { return 0 }
  if tyHasHole(recv) {
    const owner = cstrOwnerTop()
    let k = 0
    while k < ufcsCstr.ty.length {
      if (
        ufcsCstr.fn[k] == owner
        && ufcsCstr.prop[k] == prop
        && ufcsCstr.p0[k] == p0
      ) {
        if tyEqSameHoles(ufcsCstr.ty[k], recv) {
          if ix != ufcsCstr.ix[k] && !i32ListHas(ufcsCstr.more[k], ix) {
            ufcsCstr.more[k].push(ix)
          }
          return 0
        }
      }
      k = k + 1
    }
    // An overloaded call's row (`p0` -1) makes its owner's instances pick per call.
    if p0 < 0 && owner >= 0 && !i32ListHas(ovDepFns, owner) {
      ovDepFnsPush(owner)
    }
    ufcsCstr.ty.push(recv)
    ufcsCstr.prop.push(prop)
    ufcsCstr.ix.push(ix)
    ufcsCstr.fn.push(owner)
    ufcsCstr.p0.push(p0)
    const noMore: i32[] = []
    ufcsCstr.more.push(noMore)
    cvMark(CV_UFCS, ufcsCstr.fn.length - 1)
  }
  0
}

// The pin half of a `min` / `max` / `abs` a generic body deferred (`minMaxHoleOperand`): the direct
// spelling's two accepted forms — both operands integer, or both at most as wide as a float
// the call can compute at (an `i64` never widens to a float).
export function minMaxPinOk(lt: i32, rt: i32): boolean {
  const l = primNameOf(lt)
  const r = primNameOf(rt)
  const lInt = l == "i32" || l == "i64"
  const rInt = r == "i32" || r == "i64"
  if lInt && rInt { return true }
  const lFloat = l == "i32" || l == "f32" || l == "f64"
  const rFloat = r == "i32" || r == "f32" || r == "f64"
  lFloat && rFloat
}

// The node demand `ci`'s argument came from: the call's argument for a parameter hole this call
// binds, else the argument expression the demand carries (-1 for a hole moved out to a caller).
export function holeArgOriginNode(
  ci: i32,
  hNames: string[],
  hArgNode: i32[],
): i32 {
  const at = argCstr.at[ci]
  if at < 0 || at >= T.tys.length { return -1 }
  const t = tyAt(at)
  if t is TyVar {
    let k = 0
    while k < hNames.length && k < hArgNode.length {
      if hNames[k] == t.tvName { return hArgNode[k] }
      k = k + 1
    }
  }
  if ci < 0 || ci >= argCstr.node.length { return -1 }
  argCstr.node[ci]
}

// Records a hole's flow into a concrete destination while the parameter-solve probe runs.
// The destination must be fully concrete — anything still reaching a `TyVar` carries no
// answer and is skipped. A demanded shape (`{bar: _}`, accumulated from field usage) is a
// lower bound collected from usage, never adopted as the parameter's exact type.
export function noteHoleFlow(src: i32, dst: i32, at: i32) {
  if !paramSolveProbe { return 0 }
  if expObsFn >= 0 { expObsPin(src, dst, at) }
  noteHoleFlowGo(src, dst, 6)
}

// Records a deferred join that escaped call `ix` to callee `who` lossily — the collapse kept
// one arm and dropped the rest because the join still named unpinned holes. Idempotent per
// `(ty, ix)`. Never recorded from a quiet probe body, since a probe's tables are truncated
// but a constraint validated later, outside the probe, is not.
export function noteEscJoin(ty: i32, ix: i32, who: string) {
  if inferQuiet { return 0 }
  if ty < 0 || ix < 0 { return 0 }
  let k = 0
  while k < escJoinTy.length {
    if escJoinTy[k] == ty && escJoinIx[k] == ix { return 0 }
    k = k + 1
  }
  escJoinTy.push(ty)
  escJoinIx.push(ix)
  escJoinWho.push(who)
  escJoinFn.push(cstrOwnerTop())
  0
}

// The argument each bare-hole parameter came from, as three parallel arrays keyed by the
// parameter's type-variable name — a deferred constraint is reported at the call but is about
// one argument, which only the call site knows. `selfOff` is 1 for the UFCS spelling, whose
// receiver contributes no entry; only a bare type-variable parameter is recorded, since a hole reached through a shape (`xs: T[]`) is not the argument's own type.
export function holeArgOrigins(
  params: i32[],
  args: i32[],
  selfOff: i32,
  hNames: string[],
  hArgNo: i32[],
  hArgNode: i32[],
) {
  let p = selfOff
  while p < params.length {
    if p - selfOff < args.length {
      const t = tyAt(params[p])
      if t is TyVar {
        hNames.push(t.tvName)
        hArgNo.push(p + 1 - selfOff)
        hArgNode.push(args[p - selfOff])
      }
    }
    p = p + 1
  }
  0
}

// The FIRST 1-based argument number whose parameter is spelled with the operand's own type
// variable, or 0 when none is — a concrete operand (`a + 1`), a UFCS receiver, or a hole
// reached through a shape.
export function cstrArgNoOf(tyIx: i32, hNames: string[], hArgNo: i32[]): i32 {
  if tyIx < 0 || tyIx >= T.tys.length { return 0 }
  const t = tyAt(tyIx)
  if t is TyVar {
    let k = 0
    while k < hNames.length {
      if hNames[k] == t.tvName { return hArgNo[k] }
      k = k + 1
    }
  }
  0
}

// How many parameters share that type variable — the guard on naming which argument an
// operand is. `function g<T>(a: T, b: T) { a ^ b }` records `T ^ T` for both `a ^ b` and
// `a ^ a`, so naming one argument would be a guess and "uses it on both sides" would be
// false; a shared type variable keeps the un-attributed sentence.
export function cstrArgCountOf(tyIx: i32, hNames: string[]): i32 {
  if tyIx < 0 || tyIx >= T.tys.length { return 0 }
  const t = tyAt(tyIx)
  let n = 0
  if t is TyVar {
    let k = 0
    while k < hNames.length {
      if hNames[k] == t.tvName { n = n + 1 }
      k = k + 1
    }
  }
  n
}

// The argument EXPRESSION node for 1-based argument `argNo`, or -1.
export function cstrArgNodeOf(argNo: i32, hArgNo: i32[], hArgNode: i32[]): i32 {
  let k = 0
  while k < hArgNo.length {
    if hArgNo[k] == argNo { return hArgNode[k] }
    k = k + 1
  }
  -1
}

// A guarded return member (`HD_GALT`): the type a `return` inside an `is`-guard's
// then-branch contributes, reachable only by an argument that satisfies the guard's tested
// type. The branch and tested types are stable arena indices on the derivation row, so the
// member survives the `holeAlt*` table being truncated. Minted only for a concrete branch type.
export function mkGuardedRetTy(t: i32) {
  if t < 0 { return t }
  if tyIsHole(t) { return t }
  if guardAltStack.length == 0 { return t }
  const row = guardAltStack[guardAltStack.length - 1]
  if row < 0 { return t }
  if row >= holeAltNames.length { return t }
  const altTy = holeAltTys[row]
  if altTy < 0 { return t }
  const g = mkDerivedHole(HD_GALT, "", t, altTy, holeAltHoleIx[row])
  if g < 0 { return t }
  g
}

// Re-bases derivation `row` onto the hole its base resolved to: "field `bar` of `<hInner>`"
// under a binding `<hInner> := <hOuter>` is "field `bar` of `<hOuter>`" — the same read, now
// named by the caller's hole, so a constraint recorded in a generic body is re-validated when
// the caller's hole pins. `inner` is the row's operand under the same binding.
export function rebaseDerivedHole(row: i32, innerTy: i32, inner: i32) {
  if innerTy < 0 { return -1 }
  if row < 0 || row >= hdKind.length { return -1 }
  const it = tyAt(innerTy)
  if it is TyVar {
    if hdDepthOf(innerTy) >= HOLE_REBASE_MAX { return -1 }
    return hdMint(
      hdKind[row],
      hdField[row],
      inner,
      hdAlt[row],
      hdAltAdopts[row],
      innerTy,
    )
  }
  -1
}

// Is argument `argIx`, parentheses peeled, a list or object literal?
export function argIsLitAggregate(argIx: i32): boolean {
  const ax = cwPeel(argIx)
  if ax < 0 || ax >= P.nodes.length { return false }
  const a = nodeAt(ax)
  a is ArrayLit || a is ObjLit
}

// The call's bindings with each union-arm binding whose name the call left unbound appended:
// what the deferred checks judge the body at.
export function withUnionArmBinds(
  bNames: string[],
  bTys: i32[],
  uNames: string[],
  uTys: i32[],
  outN: string[],
  outT: i32[],
) {
  let i = 0
  while i < bNames.length {
    outN.push(bNames[i])
    outT.push(bTys[i])
    i = i + 1
  }
  let j = 0
  while j < uNames.length {
    if bindOf(bNames, bTys, uNames[j]) < 0 {
      outN.push(uNames[j])
      outT.push(uTys[j])
    }
    j = j + 1
  }
  0
}

// Whether two union members are the same list type at two arena indices.
export function substListTwin(a: i32, b: i32): boolean {
  if a < 0 || b < 0 { return false }
  if !(tyAt(a) is TyArray) || !(tyAt(b) is TyArray) { return false }
  tyEq(a, b)
}

// `r` with each literal arm a later, wider member subsumes dropped: a left fold keeps `"a"`
// beside a `string` joined after it, where the chain's own join absorbs it (D3266).
export function rejoinDropSubsumed(r: i32): i32 {
  if r < 0 || r >= T.tys.length { return r }
  let u = r
  const rt = tyAt(r)
  if rt is TyNullable { u = rt.nInner }
  if u < 0 || u >= T.tys.length { return r }
  const ut = tyAt(u)
  if !(ut is TyUnion) { return r }
  const kept: i32[] = []
  if !unionDropSubsumedArms(ut.uMembers, kept) { return r }
  let nu = kept[0]
  if kept.length > 1 { nu = mkUnionTy(kept) }
  if u != r { return mkNullableTy(nu) }
  nu
}

// `inner | null`: a member of `ms` that already is that nullable, so a fold that changes nothing
// but the nesting keeps the binding's arena row, else a new one.
export function substNullableOver(ms: i32[], inner: i32): i32 {
  for m in ms {
    if m >= 0 && m < T.tys.length {
      const mt = tyAt(m)
      if mt is TyNullable && mt.nInner == inner { return m }
    }
  }
  mkNullableTy(inner)
}

// Whether every one of `names` is an inference hole's, none a declared type parameter's.
export function namesAllHoles(names: string[]): boolean {
  if names.length == 0 { return false }
  for nm in names {
    if nm == "" || nm[0] != '?' { return false }
  }
  true
}

// Marks the rows of `ty` naming one of `tps`, nested generic `decl`'s own parameters.
export function markNestRows(ty: i32, tps: string[], decl: i32, depth: i32) {
  if ty < 0 || ty >= T.tys.length || depth > 8 { return 0 }
  const t = tyAt(ty)
  match t {
    TyVar => {
      if strListHas(tps, t.tvName) && !tvNestOf.has(ty) {
        tvNestOf.set(ty, decl)
      }
    }
    TyArray => {
      markNestRows(t.aElem, tps, decl, depth + 1)
    }
    TyNullable => {
      markNestRows(t.nInner, tps, decl, depth + 1)
    }
    TyMap => {
      markNestRows(t.mKey, tps, decl, depth + 1)
      markNestRows(t.mVal, tps, decl, depth + 1)
    }
    TyObj => {
      for ft in t.objFieldTypes { markNestRows(ft, tps, decl, depth + 1) }
    }
    TyFunc => {
      for pt in t.fnParamTypes { markNestRows(pt, tps, decl, depth + 1) }
      markNestRows(t.fnRet, tps, decl, depth + 1)
    }
    TyUnion => {
      for m in t.uMembers { markNestRows(m, tps, decl, depth + 1) }
    }
    TyPrim | TyErr | TyLit | TyNeg => {}
  }
  0
}

// A `self` annotation that can never be the left operand of an operator dispatch, so a binary
// operator declared over it can never fire (D425's third gate, after D444's arity and D445's
// index receiver). Derived from the dispatch gate rather than restated, so the two cannot
// drift: it subtracts any hole-carrying annotation (a live dispatch receiver) and the error type (already reported at the annotation).
export function binOpDeadSelf(ty: i32) {
  if ty < 0 { return false }
  if tyHasHole(ty) { return false }
  const t = tyAt(ty)
  if t is TyErr { return false }
  if tyIsV128Brand(ty) { return false }
  !tyDenotesObj(ty)
}

// How many leading arguments a call to a variadic function must supply: the fixed head, less
// any of it that carries a default. The rest parameter itself is never required — with no
// argument reaching it, it is the empty list.
export function restRequiredArity(dParams: i32[], restIx: i32) {
  const req = fnRequiredArity(dParams)
  if req > restIx { return restIx }
  req
}

// Whether `ty` has the `__callsite__` shape (`{ file: string, line: i32, col: i32 }`).
// Structural on purpose: a std alias of this shape resolves to the same `TyObj`, so a
// parameter typed with the alias satisfies this without the compiler ever learning the std
// name. Field order is not part of the test, but the field set is exact.
export function tyIsCallerLoc(ty: i32) {
  if ty < 0 { return false }
  const t = tyAt(ty)
  if t is TyObj {
    if t.objFieldNames.length != 3 { return false }
    let seen = 0
    let i = 0
    while i < t.objFieldNames.length {
      const nm = t.objFieldNames[i]
      const ft = t.objFieldTypes[i]
      if nm == "file" {
        if isStringTy(ft) { seen = seen + 1 }
      } else if nm == "line" {
        if ft == TY_I32 { seen = seen + 1 }
      } else if nm == "col" {
        if ft == TY_I32 { seen = seen + 1 }
      }
      i = i + 1
    }
    return seen == 3
  }
  false
}

// ", which is `p`'s" for the parameter declared at index `at`, or "" when there is none.
export function namedOrderSlotOwner(paramNames: string[], at: i32): string {
  if at < 0 || at >= paramNames.length { return "" }
  ", which is `" + paramNames[at] + "`'s"
}

// The result type of a `TyFunc`, or `TY_ERR` — the one place a bound member's
// declared result is read out for a message.
export function retOfFuncTy(tyIx: i32) {
  if tyIx < 0 { return TY_ERR }
  const t = tyAt(tyIx)
  if t is TyFunc { return t.fnRet }
  TY_ERR
}

// `boundMemberTy`'s third answer: the member EXISTS but its own annotation did not
// resolve. Kept apart from -1 ("no such member") because the two need different
// sentences and only one of them is the author's spelling mistake.
export const BOUND_UNRESOLVED = -2

// Whether annotation member `sp` spells a list, `X[]`.
export function stdRecvIsList(sp: string) {
  sp.length > 2 && sp.slice(sp.length - 2, sp.length) == "[]"
}

// `s` split at each `sep`, every piece stripped of spaces; [] for "".
export function stdRecvSplit(s: string, sep: i32): string[] {
  const out: string[] = []
  let cur = ""
  let i = 0
  while i < s.length {
    const c = s[i]
    if c == sep {
      out.push(cur)
      cur = ""
    } else if c != ' ' {
      cur = cur + s.slice(i, i + 1)
    }
    i = i + 1
  }
  if cur != "" || out.length > 0 { out.push(cur) }
  out
}

// The RESULT type of the bitcast named `name` — the SAME 32/64 bit width read at the
// other type, which is the whole point: no value conversion, only a reinterpretation.
export function bitcastRetTy(name: string) {
  if name == "f32bits" { return TY_I32 }
  if name == "f64bits" { return TY_I64 }
  if name == "f32fromBits" { return TY_F32 }
  if name == "f64fromBits" { return TY_F64 }
  -1
}

// The WIDTH an integer intrinsic call computes at: i64 when an operand is i64 (the i32
// side widens losslessly), else i32 — the selection rule the i64 binary operators use.
export function intIntrWidth(argTys: i32[]) {
  let i = 0
  while i < argTys.length {
    if primNameOf(softenLitTy(argTys[i])) == "i64" { return TY_I64 }
    i = i + 1
  }
  TY_I32
}

// Is this `min` / `max` / `abs` over integers only? Then it computes at the integer width
// (`intIntrWidth`) rather than the float one, so `min(i, j)` is an i32 and not an f64.
// An operand that is not a concrete integer primitive (a literal type counts as its base) keeps
// the float rule.
export function intMinMaxOperands(name: string, argTys: i32[]): boolean {
  if name != "min" && name != "max" && name != "abs" { return false }
  let i = 0
  while i < argTys.length {
    const p = primNameOf(softenLitTy(argTys[i]))
    if p != "i32" && p != "i64" && p != "u8" { return false }
    i = i + 1
  }
  true
}

// The hole a `min` / `max` / `abs` over an un-annotated operand defers to, or -1. Its width is
// the pin's to decide, as `a - b` over a hole's is: the call answers the hole, and each instance
// re-checks the call with the bound type. A concrete float operand decides f64/f32 already.
export function minMaxHoleOperand(name: string, argTys: i32[]) {
  if name != "min" && name != "max" && name != "abs" { return -1 }
  let hole = -1
  let i = 0
  while i < argTys.length {
    const t = argTys[i]
    if tyIsHole(t) {
      if hole < 0 { hole = t }
    } else {
      const p = primNameOf(softenLitTy(t))
      if p != "i32" && p != "i64" { return -1 }
    }
    i = i + 1
  }
  hole
}

// The list methods that change the list's own shape, and so the ones a `readonly T[]` view
// refuses. Deliberately not `cwMutatesList`'s set, which also names the map/set spellings
// (`set`/`add`/`delete`) a list receiver never reaches.
export function listMethodMutates(p: string): boolean {
  cwMutatesList(p) && collIsListSpelling(p)
}

// Whether a `self`-function named `prop` is in scope at member call `ix`, so a hole receiver
// stays open and each pin picks the built-in, a field or the function (D2518). A callback method,
// or a site the emitter cannot re-dispatch per instance (`ufcsSitePinnable`), keeps the demand.
export function holeMethodIsSelfFn(prop: string, ix: i32): boolean {
  if prop == "map" || prop == "filter" { return false }
  if !ufcsSitePinnable(ix, cstrOwnerTop()) { return false }
  const d = memberDeclOf(ix)
  if d >= 0 { return methodFnOfDecl(d) >= 0 }
  const name = ufcsAliasAtSite(ix, prop)
  if moduleNameTyOf(name) < 0 { return false }
  declFirstParamIsSelf(name)
}

// The generic `FuncDecl` the call `c` names by a plain identifier or a method name, or -1.
export function callGenericDeclIx(c: Call): i32 {
  const d = cwCalleeDeclOf(c.callFn)
  if d < 0 || d >= P.nodes.length { return -1 }
  const dn = nodeAt(d)
  if dn is FuncDecl {
    if dn.fnTyParams.length > 0 { return d }
  }
  -1
}

// Whether `t` is still being inferred: it holds a hole, or is an open `_ | null` slot (D2506).
export function dstTyOpen(t: i32): boolean {
  if tyHasHole(t) { return true }
  const d = tyAt(t)
  if d is TyNullable { return d.nInner < 0 }
  false
}

// The destination `dst` a call's arguments bind from: a nullable one only when the return `ret`
// is a bare type parameter and some argument is a bare `null`, else its non-null type, which a
// literal adapts to as an annotated one does.
export function dstForArgs(dst: i32, args: i32[], ret: i32): i32 {
  if dst < 0 || dst >= T.tys.length { return dst }
  // A destination still being inferred chooses nothing.
  if dstTyOpen(dst) { return -1 }
  const t = tyAt(dst)
  if t is TyNullable {
    if ret >= 0 && tyAt(ret) is TyVar {
      for a in args {
        if argIsNullLit(a) { return dst }
      }
    }
    return t.nInner
  }
  dst
}

// Seeds each value a tail `if`/`else` or `match` yields with the declared return, as the bare
// tail expression is seeded, so an arm's lambda or literal reads the return type (D2234), and
// banks the return on each join, so a list-literal arm can type at it (D5287).
export function seedTailArms(ix: i32, ret: i32) {
  seedJoinWant(ix, ret)
  const leaves: i32[] = []
  tailValueLeaves(ix, leaves)
  let i = 0
  while i < leaves.length {
    if !isStmtNode(leaves[i]) { seedExpected(leaves[i], ret) }
    i = i + 1
  }
  0
}

// Whether the if-arm block `armIx` ends in a bare `{ … }` block, whose value is the open
// bare-block-as-expression ruling.
export function armTailUndecided(armIx: i32): boolean {
  if armIx < 0 { return false }
  const a = nodeAt(armIx)
  if !(a is Block) { return false }
  const n = a.blkStmts.length
  n > 0 && nodeAt(a.blkStmts[n - 1]) is Block
}

// Every deferred-constraint row recorded so far, over all nine tables. A stable count
// means no table moved.
export function cstrRowCount(): i32 {
  binCstr.op.length
    + argCstr.at.length
    + printCstr.ty.length
    + nestCstr.ty.length
    + isCstr.ty.length
    + retCstr.got.length
    + letCstr.got.length
    + bmCstr.got.length
    + memCstr.ty.length
    + ufcsCstr.ty.length
}

// The top-level function declaration a module global's initializer names bare, or -1.
export function globalInitFnAlias(init: i32): i32 {
  if init < 0 { return -1 }
  const n = nodeAt(parenPeelIx(init))
  if n is Ident { return fnDeclIx[n.identName] ?? -1 }
  -1
}

// The uncovered union members of the last non-exhaustive `is`-chain `ifChainExhausts`
// analyzed (rendered, comma-joined), so the diagnostic can name what is missing. "" when the
// chain is exhaustive, or non-exhaustive for a reason other than member coverage (a
// non-coverable arm shape, an uncovered `null` path) — there is no member list to name then.
export let chainMissing = ""
export function chainMissingSet(v: string) { chainMissing = v }

// The chain's LAST arm, or -1 when `ifIx` does not end in an else-less `IfStmt`.
export function chainLastArmOf(ifIx: i32) {
  let cur = ifIx
  let found = -1
  let walking = true
  while walking {
    const n = nodeAt(cur)
    if n is IfStmt {
      if n.ifElse < 0 {
        found = cur
        walking = false
      } else {
        const nxt = nodeAt(n.ifElse)
        if nxt is IfStmt { cur = n.ifElse } else { walking = false }
      }
    } else {
      walking = false
    }
  }
  found
}

// Whether `ix` is a bare `{}` value (parentheses peeled), not a `{}` statement.
export function bareBraceNode(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const at = peelParenIx(ix)
  if at < 0 || at >= P.nodes.length { return false }
  const e = nodeAt(at)
  if e is ObjLit {
    return e.objFields.length == 0 && !i32ListHas(stmtBraceNodes, at)
  }
  false
}

// Whether ANY of arm `k`'s patterns carries a clause — the or-pattern reject reads this, not
// `matchArmBindsOf`, so `A | B{x} => …` is caught as well as `A{x} | B => …`.
export function matchArmHasBinds(n: MatchExpr, k: i32) {
  let j = 0
  while j < n.matchArmCount[k] {
    if n.matchBinds[n.matchArmStart[k] + j] >= 0 { return true }
    j = j + 1
  }
  false
}

// D1580 — the return tail is a spine, not a subtree: `retTailPos` may follow only the chain
// of nodes whose own value is the function's return (a block's last statement, an
// if-expression's arms, a `return`'s argument, a paren). Every other parent — an object
// field, a list element, a call argument — merely contains the expression, so its `if` arms belong to that container's type, not the function's.
export function tailSpineNode(ix: i32) {
  if ix < 0 { return false }
  const nd = nodeAt(ix)
  nd is Block || nd is IfStmt || nd is RetStmt || nd is Paren
}

// The container-of-vector refusal, one wording for the direct site and the generic pin.
export function v128NestMsg(t: i32): string {
  tyToStr(t)
    + " holds a 128-bit vector inside an array, struct field or map, which has no lowering yet — keep the vector in a local, parameter, return or global, or in a `v128 | null`, or store its lanes to a `Buf`"
}

// The BOXED-value-union refusal that survives the dispatch: a union the emitter boxes whose
// arms it cannot all print. Empty when the program is fine.
export function printUnionRefusal(pt: i32): string {
  if !tyPrintsAsUnionBox(pt) { return "" }
  if tyPrintUnionArmsInDomain(pt, 24) { return "" }
  "print of a union value ("
    + tyToStr(pt)
    + ") is type-valid but not yet supported by codegen — narrow it first, e.g. `if v is i32 { print(v) }`"
}

// The emitter-format name of a distinct-backing scalar-leaf list return `er` — `i64[]`,
// `f64[]`, `f32[]`: a `TyArray` whose element has its own list backing. `synthRetAnnots` pins
// a lambda to it so the body literal builds the leaf's wrapper and the value-call index finds
// it collected. An `i32[]`/`boolean[]`/`string[]`/litunion element is excluded (shared backing).
export function scalarLeafListRetName(er: i32) {
  if er < 0 { return "" }
  const t = tyAt(er)
  if t is TyArray {
    if t.aElem < 0 { return "" }
    const et = tyAt(t.aElem)
    if et is TyPrim {
      const pn = et.primName
      if pn == "i64" || pn == "f64" || pn == "f32" { return pn + "[]" }
    }
  }
  ""
}

// The declaration an extern-global disagreement quotes: `let: i64` or `const: i32`.
export function externGlobalSig(mut: i32, ty: string): string {
  if mut == 1 { return "let: " + ty }
  "const: " + ty
}

// A scalar-list inferred-return name the emitter's closure-result classifier carries (the
// `f64list`/`i64list`/`f32list` kinds) but which `isClassifiableRetName` deliberately omits —
// those array names must not reach the redundant-return lint. Recorded for an anonymous
// lambda since the checker's per-node f32[] typing is unreliable (a float literal types f64).
export function isScalarListRetName(nm: string) {
  const elem = arrElemNameRaw(nm)
  elem == "i64" || elem == "f32" || elem == "f64"
}

// D970 — does this body return two different concrete types? The A20 gate uses it to tell a
// join over the function's own literals (which every instantiation shares) from a per-call-site
// result (which must not register a box). A return whose type carries a type variable is
// ignored, which is what keeps the deferred-join family on the old path.
export function a20RetSetDisagrees(blockIx: i32): boolean {
  const rets: i32[] = []
  a20CollectRets(blockIx, rets)
  let seen = -1
  let i = 0
  while i < rets.length {
    const rt = nodeTyIxOf(rets[i])
    if rt >= 0 {
      if !tyHasTyVar(rt) {
        if seen < 0 { seen = rt }
        else if seen != rt { return true }
      }
    }
    i = i + 1
  }
  false
}

export function a20CollectRets(blockIx: i32, out: i32[]) {
  a20RetWalk(blockIx, true, out)
}

// Records one optional call's guarded return and the value-union spelling of its result.
export function noteOptCallRet(ix: i32, ty: i32, name: string) {
  if ix < 0 || ty < 0 { return 0 }
  let i = 0
  while i < optCallRetIx.length {
    if optCallRetIx[i] == ix {
      optCallRetTySetAt(i, ty)
      optCallRetNameSetAt(i, name)
      return 0
    }
    i = i + 1
  }
  optCallRetIxPush(ix)
  optCallRetTyPush(ty)
  optCallRetNamePush(name)
  0
}

// Restamps the optional call at `ix` with its guarded return, so the desugared then-arm is
// classified by what the call actually leaves on the stack. A no-op for any other node.
export function optCallRestamp(ix: i32) {
  if ix < 0 { return 0 }
  let i = 0
  while i < optCallRetIx.length {
    if optCallRetIx[i] == ix {
      while nodeTyIx.length <= ix { nodeTyIx.push(-1) }
      nodeTySet(ix, optCallRetTy[i])
      return 0
    }
    i = i + 1
  }
  0
}

// True when the `ObjLit` `e`'s field-name set corresponds one-to-one with the struct type
// `mt`'s declared field names (order-independent) — `recordRepTyAdopt`'s light dual of
// `objLitWidenFields`'s correspondence check, without the assignability re-entry.
export function objLitFieldsCorrespond(e: ObjLit, mt: TyObj): boolean {
  const dfn = mt.objFieldNames
  if e.objFields.length != dfn.length { return false }
  let k = 0
  while k < e.objFields.length {
    const f = nodeAt(e.objFields[k])
    if f is FieldInit {
      let found = false
      let j = 0
      while j < dfn.length {
        if dfn[j] == f.fiName { found = true }
        j = j + 1
      }
      if !found { return false }
    } else {
      return false
    }
    k = k + 1
  }
  true
}

// Copies the type the checker already recorded on `srcNode` onto a synthesized annotation
// node `destNode` — for a synthesis name the emitter's `nameToTy` can't resolve (an interned
// anonymous shape `#anonN`), where the source node still carries the real arena type.
export function recordNodeTyFrom(destNode: i32, srcNode: i32) {
  if destNode < 0 { return 0 }
  const ty = nodeTyIxOf(srcNode)
  while nodeTyIx.length <= destNode { nodeTyIx.push(-1) }
  nodeTySet(destNode, ty)
  0
}

// The arena index of the `i32` primitive. The monomorphizer's all-i32 param arm mints no
// annotation node at all (`parType` stays -1), so it has no `recordClonedNodeTy` return to
// bank; this is the one type it needs and the constant is here rather than exported mutable.
export function i32TyIx() { TY_I32 }

// The function a call runs through when its callee's pin is `ty`: `ty` itself, or the function
// a `| null` pin holds (D3192). -1 when `ty` is neither.
export function callPinFnTy(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  if tyAt(ty) is TyFunc { return ty }
  const f = nonNullTy(ty)
  if f < 0 || f >= T.tys.length { return -1 }
  if tyAt(f) is TyFunc { return f }
  -1
}

// Whether the program uses any literal-union type — a single `P.nodes` pass, run once, so the
// emitter's per-node atom detectors can early-out when none exists. Every usage surfaces as a
// `TypeRef` annotation, so one scan via `nameIsLitUnionType` covers both named and inline forms.
export function anyLitUnionUsed() {
  let i = 0
  while i < P.nodes.length {
    const n = nodeAt(i)
    if n is TypeRef {
      // A litunion used only as a map value counts too — without detecting it here, compare/print
      // classifiers would treat the interned atom id as a string, invalid wasm at the read.
      if tyMapValIsLitUnion(nodeTyIxOf(i), 4) { return true }
      // So does one used only as a record field, which a hole parameter reads (D2866).
      if tyObjFieldIsLitUnion(nodeTyIxOf(i), 4) { return true }
      // And one used only as a function type's result or parameter, a list element's or a map
      // value's included, which a call in an instance reads (D3193, D3199).
      const pe = tyPeelElems(nodeTyIxOf(i), 4)
      if tyFnRetIsLitUnion(pe) || tyFnParamIsLitUnion(pe) { return true }
      if tyObjFieldIsLitUnion(pe, 4) { return true }
    }
    // A field typed by one bare string literal is its one-member set's atom (D7220).
    if n is FieldDef {
      if tyIsOneStrLit(nodeTyIxOf(n.fdType)) { return true }
    }
    // …and so is one on an inline record arm of a declared union, whose row a fresh literal
    // adopts even where no annotation names the union.
    if n is UnionDecl {
      if tyObjFieldIsLitUnion(cUserTypes[n.udName] ?? -1, 4) { return true }
    }
    // A litunion used only as an array element (or any expression the checker typed as one)
    // also counts — checked on the recorded type, not the annotation name, at every node.
    if nodeTyIsLitUnion(i) { return true }
    if nodeTyIsNulLitUnion(i) { return true }
    const et = nodeArrayElemTyIx(i)
    if et >= 0 {
      if tyIsLitUnion(et) || tyIsNullableLitUnion(et) { return true }
    }
    i = i + 1
  }
  false
}

// The map receiver node of a fused map read — `m[k]` and its method spelling `m.get(k)` are
// the same fused get, so every rule keying a `??` on the receiver's value type must see both
// or it is taught half a set. Returns the receiver node index, or -1 when `lhsIx` is not a
// read shape — deliberately a pure shape query; the caller still asks the receiver's own type.
export function fusedMapReadRecvIx(lhsIx: i32) {
  if lhsIx < 0 { return -1 }
  const l = nodeAt(lhsIx)
  match l {
    Index => {
      return l.idxArr
    }
    Call => {
      if l.callFn < 0 { return -1 }
      const c = nodeAt(l.callFn)
      if c is Member {
        if c.memProp == "get" {
          if l.callArgs.length == 1 { return c.memObj }
        }
      }
    }
    // Any other left-hand side is not a fused map read.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  -1
}

// A binary operator's result type, deferred to the pin when the body cannot decide it
// (D532). The gate is the exact precondition of the correction, not a heuristic: the hole can
// resolve to anything but `bTy` only through a declared top-level `self`-function named for
// the operator, so a program declaring no overload records exactly what it recorded before.
export function mkBinOpRetTy(
  n: BinExpr,
  bTy: i32,
  lt: i32,
  wide: i32,
  adopts: boolean,
) {
  if bTy < 0 { return bTy }
  if bTy == TY_ERR { return bTy }
  // A compound assignment shares its target node between the read and the write, and is left
  // whole — an overload has no second answer for a form the direct spelling doesn't lower either.
  if n.binCompound != "" { return bTy }
  const op = n.binOp
  // Arithmetic over a hole operand answers per member of its join, each at its base scalar once
  // pinned: a literal-set pin holds no result outside the set, and beside a wider `wide` operand
  // the pin computes at that width (D9631).
  if binArithOp(op) && tyIsHole(bTy) {
    const pm = mkBinOpPerMember(op, lt, wide, adopts)
    if pm >= 0 { return pm }
  }
  if binArithOp(op) && tyIsHole(bTy) {
    let alt = wide
    if alt == bTy { alt = lt }
    const ad = mkBinOpHole(op, bTy, alt, adopts, bTy)
    if ad >= 0 { return ad }
  }
  if !tyIsHole(lt) { return bTy }
  // `+` over a hole has a second answer with no overload declared: a pinned literal union
  // CONCATENATES, and the result is `string` rather than the operand the arithmetic tail
  // handed back. Only that shape defers — a body answer that is not the operand already
  // names its own type (D1739).
  const plusDefers = op == "+" && bTy == lt
  if !plusDefers {
    // Only an operator a user can declare can carry an overload, so nothing else has a second
    // answer at a pin (`ast.vl:isBinOpFuncName`, the ten names a declaration admits).
    if !isBinOpFuncName(op) { return bTy }
    if !binOpSymDeclared(op) { return bTy }
  }
  // An annotated body is not excluded: D551 re-checks the annotation against the
  // resolved body type at each pin (`noteRetCstr`/`validateRetCstrs`), so a per-pin deferral is safe.
  const d = mkDerivedHole(HD_BINOP, op, bTy, -1, lt)
  if d < 0 { return bTy }
  d
}

// The join of arithmetic `op` over each member of `u`, a union of type variables only; -1 for
// any other operand.
function mkBinOpPerMember(op: string, u: i32, wide: i32, adopts: boolean): i32 {
  if u < 0 || u >= T.tys.length { return -1 }
  const ut = tyAt(u)
  if !(ut is TyUnion) { return -1 }
  const ms: i32[] = []
  for m in ut.uMembers {
    if m < 0 || m >= T.tys.length || !(tyAt(m) is TyVar) { return -1 }
    const d = mkBinOpHole(op, m, wide, adopts, m)
    if d < 0 { return -1 }
    ms.push(d)
  }
  const r = mkUnionTy(ms)
  tpJoinCarry(u, r)
  r
}

// Why a scrutinee is refused: a `match` needs a closed member SET to be complete over, or an
// INTEGER, which has no member set and takes a `_` instead (D1572).
export function matchScrutRejectMsg(st: i32) {
  "match scrutinee must be a union or an integer, got " + tyToStr(st)
}

// What an integer scrutinee refuses in pattern position, named for the type it actually is.
// Two callers — a node kind that is no literal at all, and a `Unary` that is not `-` over one.
export function intArmRejectMsg(st: i32) {
  "invalid match pattern — a pattern over "
    + tyToStr(st)
    + " is an integer literal, a `const` with a literal value, or the `_` wildcard"
}

// An integer-literal pattern's lexeme, sign included, for a diagnostic that quotes it back.
export function matchIntPatLexeme(numIx: i32, neg: boolean) {
  const nn = nodeAt(numIx)
  if nn is NumLit {
    if neg { return "-" + nn.numText }
    return nn.numText
  }
  ""
}

// An integer-literal pattern's 64-bit value as `[hi, lo]`, or an empty list when it has none.
// Two arms are duplicates iff their pairs agree, so `0x10` and `16` are one arm and `-1` is not
// `1` — a lexeme compare would miss both. The negative spelling takes its two's complement,
// which also makes `-0` and `0` one key, as the emitted compare chain would.
export function matchIntPatValue(numIx: i32, neg: boolean) {
  const empty: i32[] = []
  const nn = nodeAt(numIx)
  if nn is NumLit {
    if numLexIsFloat(nn.numText) { return empty }
    return intLexPair(nn.numText, neg)
  }
  empty
}

// The 64-bit value of the integer lexeme `text` as `[hi, lo]`, negated when `neg`.
function intLexPair(text: string, neg: boolean) {
  const pair = parseI64Pair(text)
  if !neg { return pair }
  const hi0 = pair[0]
  const lo0 = pair[1]
  let negHi = ~hi0
  if lo0 == 0 { negHi = ~hi0 + 1 }
  const out: i32[] = []
  out.push(negHi)
  out.push(~lo0 + 1)
  out
}

// The value of the integer literal type `ty` as `[hi, lo]`, the key `matchIntPatValue` gives
// the pattern that names it; an empty list when `ty` is no integer literal type.
export function matchIntLitTyValue(ty: i32) {
  const empty: i32[] = []
  if ty < 0 { return empty }
  const t = tyAt(ty)
  if t is TyLit {
    if t.litKind != "int" { return empty }
    const s = t.litText
    if s.length > 1 && s[0] == '-' {
      return intLexPair(s.slice(1, s.length), true)
    }
    return intLexPair(s, false)
  }
  empty
}

// `match` over a value union desugars to the `is`-chain `desugarMatchAt` already builds (each
// type pattern parses as an `IsExpr`), so there is no second narrowing or tag test. What match
// adds is completeness: every member must be named or a `_` must be present. Three passes run
// in different orders (pattern diagnostics in source order, narrowing in chain order).
export function matchBodyDeclares(bodyIx: i32, name: string) {
  if bodyIx < 0 { return false }
  const b = nodeAt(bodyIx)
  if b is Block {
    let i = 0
    while i < b.blkStmts.length {
      const st = nodeAt(b.blkStmts[i])
      match st {
        LetDecl => {
          if st.letName == name { return true }
        }
        FuncDecl => {
          if st.fnName == name { return true }
        }
        // Any other statement declares no name in the arm's scope.
        NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | Param | TypeRef | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
      }
      i = i + 1
    }
  }
  false
}

// How a litunion diagnostic quotes arm pattern `patIx` of member text `inner`: a constant by its
// name and value, a literal by its text.
export function matchStrPatLabel(patIx: i32, inner: string) {
  const p = nodeAt(patIx)
  if p is Ident { return "`" + p.identName + "` (\"" + inner + "\")" }
  "\"" + inner + "\""
}

// The `null` clause of the litunion pattern vocabulary's message: named only where the
// scrutinee carries a `null` member, so a bare set's sentence is unchanged (D1898).
export function matchNulPatHint(nulLit: boolean) {
  if nulLit { return ", `null`" }
  ""
}

// The node on a function body's tail spine being checked, or -1: a block, `if` or `match` there
// hands it to its last statement or arms, whose joins lower as the function's returns, so an
// exiting arm there needs no `never` tail (D3222). One node, not a flag, so leaving the spine
// costs nothing; `ifChainSpine`, `ifChainOnFnTail` and `matchOnSpine` are the constructs' own.
export let spineAt = -1
export function spineAtSet(v: i32) { spineAt = v }

export let ifChainSpine = false
export function ifChainSpineSet(v: boolean) { ifChainSpine = v }

export let ifChainOnFnTail = false
export function ifChainOnFnTailSet(v: boolean) { ifChainOnFnTail = v }

// Whether the `match` being checked is a value, so its arms are value arms (`valueArmAt`).
export let matchValued = false
export function matchValuedSet(v: boolean) { matchValued = v }

// The third member of the trio, offered beside `as!`/`as?` only where it can apply: `as%`
// keeps the low bits of an integer, so the note needs an integer operand and target alike.
export function castWrapNote(asTy: string, src: i32): string {
  if src < 0 { return "" }
  const sn = primNameStr(primNameOf(src))
  if sn != "i32" && sn != "i64" { return "" }
  if asTy == "i32" || asTy == "u8" { return ", or `as%` to keep its low bits" }
  ""
}

// The cast operand's identifier name, through parens, or "" for any other expression shape.
export function castOperandIdent(ix: i32): string {
  if ix < 0 || ix >= P.nodes.length { return "" }
  const n = nodeAt(ix)
  match n {
    Paren => castOperandIdent(n.parInner)
    Ident => n.identName
    // Any other operand names no binding.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | Member | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => ""
  }
}

// D1341 — `as?` yields `T | null` exactly when the cast can fail, and at a hole operand
// `numCastCanFail` answered false, so the node typed the bare arm while the monomorphizer
// pinned the operand to a box. Re-records the result from the pinned answer; the cell that
// must not move is one where the pin makes the cast infallible.
export function castPinNullResult(castIx: i32, target: i32) {
  const nt = mkNullableTy(target)
  if nt < 0 { return 0 }
  if castIx >= 0 && castIx < nodeTyIx.length { nodeTySet(castIx, nt) }
  0
}

// The `as%` refusal over a `boolean`, shared by the direct spelling and the pin.
export const AS_WRAP_BOOL_MSG = "`as%` wraps between integer widths, and a boolean is not one — convert it with `as`"

// The refusal's tail, by cast mode: at an integer domain the trapping and nullable forms over a
// misfit are a trap or a null on every run, and an integer that misfits may want the wrap. A
// fraction names the explicit rounding, since a named constant's retune is what usually lands here.
export function castConstModeTail(mode: string, dom: string, v: Cex): string {
  if dom == "f32" || dom == "f64" { return "" }
  if v.cxFloat && !cexIsWhole(v) {
    return " — round it first: `trunc(…) as! "
      + dom
      + "` or `floor(…) as! "
      + dom
      + "`"
  }
  if mode == "trap" { return " — `as!` on it would trap on every run" }
  if mode == "null" { return " — `as?` on it would be null on every run" }
  if v.cxFloat { return "" }
  " — write `as%` to keep its low bits"
}

// Make the cast over the constant `v`, which `dom` holds, one with no runtime test: a fallible
// `u8` or `i32` cast becomes the `i32` literal of `v`, and a fallible `i64` cast's operand the
// integer literal it converts exactly. A float domain rounds and never fails.
export function castConstSettle(
  n: AsExpr,
  ix: i32,
  v: Cex,
  arg: i32,
  dom: string,
) {
  if dom == "f32" || dom == "f64" { return 0 }
  if !numCastCanFail(primNameStr(primNameOf(arg)), dom) { return 0 }
  let iv = cexOfLexeme(cexDecText(v))
  if v.cxNeg { iv = cexNeg(iv) }
  if dom != "i64" {
    cexRewrite(ix, iv)
    return cexRetype(ix, TY_I32)
  }
  cexRewrite(parenPeelIx(n.asObj), iv)
  cexRetype(n.asObj, numLitOwnTy(n.asObj))
  numLitAdoptDeep(n.asObj, TY_I64, 6)
}

// The steps `x is "a" | "b"` costs: each string literal is compared in turn, so the sum of
// their lengths. Over a literal union the test is a tag compare and costs 0.
export function gcIsLitSteps(n: IsExpr, ix: i32): i32 {
  if gwErasedIs(nodeTyIxOf(n.isObj)) == "lit" { return 0 }
  const ty = isVarTyIxOf(ix)
  if ty < 0 { return 0 }
  const lens: i32[] = []
  const one = gwStrLitTyLen(ty)
  if one >= 0 { lens.push(one) }
  const t = tyAt(ty)
  if one < 0 && t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      const m = gwStrLitTyLen(t.uMembers[i])
      if m >= 0 { lens.push(m) }
      i = i + 1
    }
  }
  let c = 0
  let k = 0
  while k < lens.length {
    if lens[k] > 0 {
      c = gcAdd(c, lens[k])
      gcTrail.push(0 - lens[k])
    }
    k = k + 1
  }
  c
}

// The lambda `(params): ret => { tail }`, as a node not yet placed in the arena.
export function fvaLambda(
  params: i32[],
  ret: i32,
  tail: i32,
  site: i32,
  pos: i32,
): Node {
  const stmts: i32[] = []
  stmts.push(tail)
  const noTyParams: string[] = []
  const n: Node = {
    fnName: "",
    fnTyParams: noTyParams,
    fnParams: params,
    fnRet: ret,
    fnBody: luAt(mkBlock(stmts, pos), site),
    pos: pos,
  }
  n
}

// The element key prefix of the list `ix` reads: its place (a name, a field path `o.xs`, or a
// literal subscript `m[0]` an element entry is keyed on), then `[*]` per subscript (`m[i]` is
// `m[*]`), or "" when it is no subscript chain over a place.
export function elemRecvPrefix(ix: i32): string {
  const p = peelParenIx(ix)
  if p < 0 || p >= P.nodes.length { return "" }
  const n = nodeAt(p)
  if n is Ident { return n.identName }
  const own = placeKeyOf(p)
  if n is Member || n is OptMember { return own }
  if !(n is Index) { return "" }
  if own != "" && elemEverySlotOf(own) >= 0 { return own }
  const inner = elemRecvPrefix(n.idxArr)
  if inner == "" { return "" }
  inner + LIST_EVERY_STEP
}

// Gives the single parameter of the callback literal `cbIx`, run over a list of type `listTy`, its
// element type in `cbPendNames`, when the name is bound nowhere else in `bound`.
export function cbPendAdd(cbIx: i32, listTy: i32, bound: string[]) {
  if listTy < 0 || cbIx < 0 || cbIx >= P.nodes.length { return 0 }
  const lt = tyAt(nonNullTy(listTy))
  const fd = nodeAt(cbIx)
  if !(lt is TyArray) || !(fd is FuncDecl) || fd.fnParams.length != 1 {
    return 0
  }
  if lt.aElem < 0 { return 0 }
  const p = nodeAt(fd.fnParams[0])
  if !(p is Param) { return 0 }
  let seen = 0
  let i = 0
  while i < bound.length {
    if bound[i] == p.parName { seen = seen + 1 }
    i = i + 1
  }
  if seen != 1 { return 0 }
  cbPendNames.push(p.parName)
  cbPendTys.push(lt.aElem)
  0
}

// Every callback literal in the subtree `ix` handed to `map`/`filter` on a list `recvTyOf` knows
// gets its parameter typed by `cbPendAdd`, outer calls first.
export function cbPendCollect(ix: i32, bound: string[]) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is Call && n.callFn >= 0 {
    const cf = nodeAt(n.callFn)
    if cf is Member && n.callArgs.length == 1 {
      if cf.memProp == "map" || cf.memProp == "filter" {
        const cb = peelParenIx(n.callArgs[0])
        if cb >= 0 && nodeAt(cb) is FuncDecl {
          cbPendAdd(cb, recvTyOf(cf.memObj), bound)
        }
      }
    }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      cbPendCollect(kids[k], bound)
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

// The first field before `fields[i]` giving the same key, or -1.
export function objLitEarlierKey(fields: i32[], i: i32): i32 {
  const f = nodeAt(fields[i])
  if f is FieldInit {
    let j = 0
    while j < i {
      const g = nodeAt(fields[j])
      if g is FieldInit {
        if g.fiName == f.fiName { return fields[j] }
      }
      j = j + 1
    }
  }
  -1
}

// Whether node `ix` is an object literal giving some key twice.
export function objLitHasDupKey(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const o = nodeAt(ix)
  if o is ObjLit {
    let i = 1
    while i < o.objFields.length {
      if objLitEarlierKey(o.objFields, i) >= 0 { return true }
      i = i + 1
    }
  }
  false
}

// Whether `m` is already one of the ` | `-joined members of `s`. A flattened receiver can
// name the same arm twice, and a duplicated member is a different union to the tables that
// hold one — dedupes the spelling before any registration happens.
export function jsonSpellHas(s: string, m: string): boolean {
  let i = 0
  while i + m.length <= s.length {
    if s.slice(i, i + m.length) == m {
      let leftOk = i == 0
      if i >= 3 {
        if s.slice(i - 3, i) == " | " { leftOk = true }
      }
      let rightOk = i + m.length == s.length
      if i + m.length + 3 <= s.length {
        if s.slice(i + m.length, i + m.length + 3) == " | " { rightOk = true }
      }
      if leftOk && rightOk { return true }
    }
    i = i + 1
  }
  false
}

// `litSetMeetTy`'s answer when the two sets share no value.
export const LIT_MEET_NONE = -2

// The GUARDED type of the optional-chain link just checked — the field's own type, before
// the `| null` the chain re-wraps around it. Read by the next link in the same chain, which
// is the only reader: a `.` link inherits an earlier `?.`'s guard and so may not re-guard a
// field that is nullable in its own right (D1815).
let omGuardIx = -1

let omGuardTy = -1

export function omGuardSet(ix: i32, ty: i32) {
  omGuardIx = ix
  omGuardTy = ty
  0
}

// The guarded type recorded for node `ix`, or -1 when `ix` is not the link just checked —
// a receiver that is a name, a call or a parenthesised chain answers -1 and ends the chain.
export function omGuardTyAt(ix: i32) {
  if ix >= 0 && omGuardIx == ix { return omGuardTy }
  -1
}

// The receiver type an optional-chain link reads its field off: the link below's guarded
// type when the receiver is itself a link of this chain, else the receiver's own type.
export function omRecvTy(objIx: i32, recv: i32) {
  const g = omGuardTyAt(objIx)
  if g >= 0 { return g }
  recv
}

// The separator a chain link carries in the source, so a diagnostic quotes the program the
// author wrote and not the normalised node.
export function omDotStr(n: OptMember) {
  if n.omDot { return "." }
  "?."
}

// The `boolean`, `null` and `never` rows, for the nodes the loop-value rewrite synthesizes.
export function lvTyBool(): i32 { TY_BOOL }

export function lvTyNull(): i32 { TY_NULL }

export function lvTyNever(): i32 { TY_NEVER }

// The soft `to`/`until` keyword's token index, recovered from the end bound's own start:
// `parseFor` advances past it and parses the bound right after, so the keyword is the token
// before the bound's first, via `nodeStartTok` (resolved in the bound's own module, D1652).
// Verified at the token — a mismatch falls back to the bound's own anchor (D1588).
export function forToKwTok(toIx: i32) {
  const i = nodeStartTok(toIx)
  if i <= 0 || i - 1 >= P.toks.length { return -1 }
  const t = P.toks[i - 1]
  if t.kind == "IDENT" && (t.text == "to" || t.text == "until") { return i - 1 }
  -1
}

// Whether a range bound or step is float-typed. Split out so the refusal can name the form
// that works instead of the type it wanted — a float range is a language question, not a gap
// (`open-rulings.md` §B8-for-float-range).
export function forRangeFloatish(ty: i32) {
  primNameOf(ty) == "f64" || primNameOf(ty) == "f32"
}

// The type a for-in loop binds to its first variable (`second` false) or its second, over an
// iterable of type `iterTy`, or TY_ERR where it is not iterable. A sequence's second binding
// is its index and a map's the value at the key; a set is a sequence here, since its `mVal`
// is the internal membership boolean (`collections-design.md` C2.4).
export function forInBindTy(iterTy: i32, second: boolean): i32 {
  if iterTy < 0 { return TY_ERR }
  const it = tyAt(iterTy)
  if it is TyArray {
    if second { return TY_I32 }
    // A `u8[]` loop var binds an `i32`, never a `u8` — one iteration is one element read,
    // and a `u8` in a value position is exactly what `u8` may not be (same rule as an index read).
    if primNameOf(it.aElem) == "u8" { return TY_I32 }
    return it.aElem
  }
  if it is TyMap {
    // `for k in m` over a map / set iterates its keys (the key type) — like
    // `for k in m.keys()`.
    if !second { return it.mKey }
    if it.mSet == 1 { return TY_I32 }
    return it.mVal
  }
  // `for ch in s` iterates a string's code units, each an i32, exactly as `s[i]` reads
  // one — a string is a `{backing, start, len}` view over an i32 array (Stage 2b).
  if isStringTy(iterTy) { return TY_I32 }
  TY_ERR
}
