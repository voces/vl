// The opaque-label switch (`$VL_OPAQUE_SNAMES`): a measuring instrument, armed by the host
// before a compile. When on, a shape row minted by the interner is labelled `#rowN` instead of
// its rendered spelling, so any pass that decides on a row's label rather than its type moves
// the program. Off by default, when it changes nothing.

let opaqueSNamesMode = 0

// Arms (1) or disarms (0) the opaque labels for this compile; 0 on success.
export function setOpaqueSNames(v: i32): i32 {
  opaqueSNamesMode = v
  0
}

// Whether shape rows are labelled `#rowN` in this compile.
export function opaqueSNamesOn(): boolean { opaqueSNamesMode == 1 }
