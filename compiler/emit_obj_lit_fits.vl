// ── the union arm-path walk, from the arena ─────────────────────────────────────

// The `unionArmPath*` family answers "does this union arm's field path `a.b.c` leaf at a
// map / a list-of-maps / a closure / a closure-array / a closure-carrying value" by walking
// the arena structurally instead of the emitter's per-field lowering codes — narrowing-blind
// and conservative, so an unresolvable arm answers "no".

// The arena type of field `name` of the object type `ty` (nullable-peeled — a code-15
// hop follows `S` and `S | null` alike), or -1 when `ty` is not an object or has no
// such field.
function tyObjFieldTy(ty: i32, name: string): i32 {
  const b = tyPeelNul(ty)
  if b < 0 { return -1 }
  const t = tyAt(b)
  if t is TyObj {
    let i = 0
    while i < t.objFieldNames.length {
      if t.objFieldNames[i] == name { return t.objFieldTypes[i] }
      i = i + 1
    }
  }
  -1
}

// Walks the field path `path` from the union member type `m` and returns the arena type of
// the leaf field, or -1. Mid hops must be object-typed — a map/union-box/list mid field
// yields no field — mirroring the lowering-code walk's own `code != 15` guard. The leaf
// comes back unclassified so each consumer applies its own predicate.
function tyArmPathLeaf(m: i32, path: string[]): i32 {
  if m < 0 || path.length == 0 { return -1 }
  let cur = m
  let hop = 0
  while hop < path.length {
    const ft = tyObjFieldTy(cur, path[hop])
    if ft < 0 { return -1 }
    if hop == path.length - 1 { return ft }
    cur = ft
    hop = hop + 1
  }
  -1
}

// `tyArmPathIsMap`'s leaf: a MAP field (code 19). NOT nullable-peeled — a
// `{[string]: V} | null` field is code 29, which the code walk does not accept.
export function tyArmPathIsMap(m: i32, path: string[]): boolean {
  const leaf = tyArmPathLeaf(m, path)
  if leaf < 0 { return false }
  const t = tyAt(leaf)
  if t is TyMap { return true }
  false
}

// `tyArmPathIsMapList`'s leaf: a LIST-OF-MAPS field (code 5 whose element renders as
// a map) — a `TyArray` over a `TyMap`.
export function tyArmPathIsMapList(m: i32, path: string[]): boolean {
  const leaf = tyArmPathLeaf(m, path)
  if leaf < 0 { return false }
  const t = tyAt(leaf)
  if t is TyArray {
    if t.aElem < 0 { return false }
    const e = tyAt(t.aElem)
    if e is TyMap { return true }
  }
  false
}

// True when `ty` contains a `TyFunc` anywhere in its structure (fields, elements, map
// values, nullable inners, union members) within `depth` wrapper hops.
export function tyReachesFuncD(ty: i32, depth: i32): boolean {
  if ty < 0 || depth <= 0 { return false }
  const t = tyAt(ty)
  // Exhaustive over `Ty` and `_`-less: a new arena variant that can hold a function owes this
  // walk a descent, and a silent leaf answers `false` for a type that reaches one.
  match t {
    TyFunc => {
      return true
    }
    TyArray => {
      return tyReachesFuncD(t.aElem, depth - 1)
    }
    TyNullable => {
      return tyReachesFuncD(t.nInner, depth - 1)
    }
    TyMap => {
      return tyReachesFuncD(t.mVal, depth - 1)
    }
    TyUnion => {
      let i = 0
      while i < t.uMembers.length {
        if tyReachesFuncD(t.uMembers[i], depth - 1) { return true }
        i = i + 1
      }
      return false
    }
    TyObj => {
      let j = 0
      while j < t.objFieldTypes.length {
        if tyReachesFuncD(t.objFieldTypes[j], depth - 1) { return true }
        j = j + 1
      }
      return false
    }
    TyPrim | TyErr | TyVar | TyLit | TyNeg => {
      // A leaf: nothing under it to reach a function.
    }
  }
  false
}

// The map-value compat of an object literal's field value against a variant's code-19 field,
// whose value has arena type `elemTy` (or -1): the literal's map value type must not
// contradict that rep. Lenient when the value isn't a map (it fails loudly downstream); an
// atom-valued literal field is compatible with any mono elem.
export function objMapFieldCompat(
  objIx: i32,
  fname: string,
  elemTy: i32,
): boolean {
  const valIx = objFieldVal(objIx, fname)
  if valIx < 0 { return true }
  if !nodeTyIsMap(valIx) { return true }
  // A hole value (an unconstrained `Map()`) contradicts no rep.
  if nodeMapValTyIx(valIx) < 0 { return true }
  if nodeTyMapValIsLitUnion(valIx) { return mvValKindOfTy(elemTy) == MVK_MONO }
  mvValTysCompat(nodeMapValTyIx(valIx), elemTy)
}

// Whether a literal's map-typed field value has variant `vi`'s key type and is a `Set` exactly
// when that field is — the columns the value rep alone cannot see (D2493, D4056). True when
// either side's arena type is unknown, open, or not a map.
export function objMapFieldKeyFits(
  objIx: i32,
  fname: string,
  vi: i32,
): boolean {
  const valIx = objFieldVal(objIx, fname)
  if valIx < 0 || vi < 0 || vi >= uVarTyIx.length { return true }
  const vt = nodeRepTyIxOf(valIx)
  const ft = tyFieldTyOf(uVarTyIx[vi], fname)
  if vt < 0 || vt >= T.tys.length || ft < 0 || ft >= T.tys.length {
    return true
  }
  const t = tyAt(vt)
  const f = tyAt(ft)
  if !(t is TyMap) || !(f is TyMap) { return true }
  if t.mKey < 0 || tyHasTyVar(t.mKey) || tyHasTyVar(vt) { return true }
  t.mSet == f.mSet && tySame(t.mKey, f.mKey)
}

// The nested-struct compat of an object literal's field value against a candidate
// variant's code-15 field of element type `elemTy`: a nested literal value fits the row that type
// is stored at by `objLitFitsRow`. A non-literal value stays lenient (it fails loudly downstream if wrong).
export function objNestedFieldCompat(
  objIx: i32,
  fname: string,
  elemTy: i32,
  fnIx: i32,
): boolean {
  const valIx = objFieldVal(objIx, fname)
  if valIx < 0 { return true }
  objLitFitsRow(unwrapParen(valIx), structRowOfValueTy(elemTy), 8, true, fnIx)
}

// Whether the object literal at `litIx` fits struct row `si`: each scalar field of a kind the
// row's stores (`declRowFieldKindFits`) and each nested literal fitting its own target row, to
// `depth` levels (D3031); with `exact`, also the same field-name set, less any nullable field
// the literal leaves out (D4601). True for a non-literal or an unknown row.
export function objLitFitsRow(
  litIx: i32,
  si: i32,
  depth: i32,
  exact: boolean,
  fnIx: i32,
): boolean {
  if litIx < 0 || si < 0 || si >= sFieldCount.length || depth <= 0 {
    return true
  }
  const v = nodeAt(litIx)
  if v is ObjLit {
    if exact && v.objFields.length > sFieldCount[si] { return false }
    let present = 0
    let fi = 0
    while fi < sFieldCount[si] {
      const name = sFieldNames[sFieldStart[si] + fi]
      const fv = objFieldVal(litIx, name)
      if fv >= 0 { present = present + 1 }
      if fv < 0 {
        if exact && !structRowFieldMayOmit(si, name) { return false }
      } else if fieldRowIsRecordRef(sFieldStart[si] + fi) {
        if (
          !objLitFitsRow(
            unwrapParen(fv),
            sFieldTgtStructIdx(si, fi),
            depth - 1,
            exact,
            fnIx,
          )
        ) {
          return false
        }
      } else if !declRowFieldKindFits(litIx, name, si, fi, fnIx) {
        return false
      }
      fi = fi + 1
    }
    if exact && present != v.objFields.length { return false }
  }
  true
}

// Whether struct row `si`'s field `name` bears null, so a literal may leave it out; true when
// the row records no type to ask.
function structRowFieldMayOmit(si: i32, name: string): boolean {
  if si < 0 || si >= sTyIx.length { return true }
  const ty = sTyIx[si]
  if ty < 0 || ty >= T.tys.length { return true }
  const o = tyAt(ty)
  if !(o is TyObj) { return true }
  let k = 0
  while k < o.objFieldNames.length {
    if o.objFieldNames[k] == name { return tyBearsNull(o.objFieldTypes[k]) }
    k = k + 1
  }
  true
}

// The signature of the object literal at `objIx` — its field names in `fieldNameOrder`,
// comma-joined, the construction `variantSig` applies to a variant's own already-canonical
// name column. Duplicate names are kept, so two spellings differ exactly where the sets do.
export function objLitFieldSig(objIx: i32) {
  const o = nodeAt(objIx)
  const names: string[] = []
  if o is ObjLit {
    let i = 0
    while i < o.objFields.length {
      const f = nodeAt(o.objFields[i])
      // One name per ENTRY, so the signature counts what the matcher counts. A malformed
      // entry contributes "", which no variant field can spell, so it matches nothing —
      // the answer the matcher reaches by failing to find that entry's name.
      let nm = ""
      if f is FieldInit { nm = f.fiName }
      names.push(nm)
      i = i + 1
    }
  }
  fieldNamesSig(names)
}

// The signature of a field-name list: the names in `fieldNameOrder`, comma-joined.
export function fieldNamesSig(names: string[]) {
  const ord = fieldNameOrder(names)
  let out = ""
  let j = 0
  while j < ord.length {
    if j > 0 { out = out + "," }
    out = out + names[ord[j]]
    j = j + 1
  }
  out
}

// Whether variant `vi` stores field `name` of the object literal at `objIx` at the scalar kind
// the checker gave it, by `declRowFieldKindFits`'s rule: an `i32` field is no `string` slot,
// whatever names the two share (D3024). Refutation only: an unknown kind on either side agrees.
export function variantFieldKindFits(
  objIx: i32,
  name: string,
  vi: i32,
): boolean {
  if vi < 0 || vi >= uVarTyIx.length { return true }
  const vt = uVarTyIx[vi]
  if vt < 0 || vt >= T.tys.length { return true }
  const rft = tyFieldTyOf(vt, name)
  const fv = objFieldVal(objIx, name)
  // A `null`-typed field stores only null: a value whose type excludes it is another row.
  if tyIsNullUnit(rft) && fv >= 0 && tyExcludesNull(nodeRepTyIxOf(fv)) {
    return false
  }
  let rk = fieldScalarKindOf(rft)
  // An integer literal set stores as its base scalar.
  if rk == 0 && litSetBaseTy(rft) >= 0 {
    rk = fieldScalarKindOf(litSetBaseTy(rft))
  }
  // The field value's own type refutes across kind classes only: a literal typed by its
  // union destination may carry the destination's arm, while a width still adapts. A record
  // value is no scalar field, and a scalar value no record one.
  let vk = 0
  if fv >= 0 { vk = fieldScalarKindOf(nodeRepTyIxOf(fv)) }
  if rk == 0 {
    if fv >= 0 && fieldValueIsRecord(fv) {
      return tyHoldsRecord(nonNullTy(rft))
    }
    if !tyIsRecord(nonNullTy(rft)) { return true }
    return vk == 0 && !fieldValueIsScalarLit(fv)
  }
  if fv >= 0 && fieldValueIsRecord(fv) { return false }
  let lk = 0
  const ot = nodeRepTyIxOf(objIx)
  if ot >= 0 && ot < T.tys.length {
    lk = fieldScalarKindOf(tyFieldTyOf(ot, name))
  }
  if vk != 0 && fieldKindClass(vk) != fieldKindClass(rk) { return false }
  if lk == 0 { lk = vk }
  if lk == 0 { return true }
  // A string value may be a member of a string literal set; a literal one is asked.
  if (lk == 6 || lk == 14) && (rk == 7 || rk == 15) {
    if fv < 0 { return true }
    const lit = nodeAt(unwrapParen(fv))
    if lit is StrLit {
      return strListHas(tyLitSetMemberLexes(nonNullTy(rft)), lit.strText)
    }
    return true
  }
  fieldKindWidens(lk, rk)
}

// Whether field value node `fv` is a record: an object literal, or typed as a record.
function fieldValueIsRecord(fv: i32): boolean {
  if nodeAt(unwrapParen(fv)) is ObjLit { return true }
  const t = nodeRepTyIxOf(fv)
  t >= 0 && tyIsRecord(t)
}

// Whether field value node `fv` is a number, string, char or boolean literal.
function fieldValueIsScalarLit(fv: i32): boolean {
  if fv < 0 { return false }
  const n = nodeAt(unwrapParen(fv))
  n is NumLit || n is StrLit || n is CharLit || n is BoolLit
}

// Whether type `t` is a record or a union with a record member.
function tyHoldsRecord(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return true }
  if tyIsRecord(t) { return true }
  const u = tyAt(t)
  if u is TyUnion {
    let i = 0
    while i < u.uMembers.length {
      const m = u.uMembers[i]
      if m >= 0 && m < T.tys.length && tyIsRecord(m) { return true }
      i = i + 1
    }
  }
  false
}

// The class of a `fieldScalarKindOf` kind, nullability dropped: 1 numeric, 2 `boolean`,
// 3 a string or string literal set, 0 none.
function fieldKindClass(k: i32): i32 {
  let b = k
  if b > 8 { b = b - 8 }
  if b == 1 || b == 3 || b == 4 || b == 5 { return 1 }
  if b == 2 { return 2 }
  if b == 6 || b == 7 { return 3 }
  0
}

// True if the plain struct at table index `ssi` has the same field layout (name set, count,
// per-field type code) as the union-variant arm `vi` — the struct-index dual of
// `objMatchesVariantIdxOmit`. Recognizes a struct-typed value (an ident/call result, built as a
// distinct heap type from the arm's variant struct) as a union member so it can be re-boxed.
export function structIdxMatchesVariantIdx(ssi: i32, vi: i32): boolean {
  if ssi < 0 { return false }
  // The bound this parallel-table read lacked: an unguarded read past these arrays traps the
  // compiler instead of surfacing the diagnostic `emitFail` already recorded.
  if ssi >= sFieldCount.length { return false }
  if vi < 0 { return false }
  if vi >= uFieldCount.length { return false }
  const cnt = uFieldCount[vi]
  if cnt != sFieldCount[ssi] { return false }
  const start = uFieldStart[vi]
  let fj = 0
  while fj < cnt {
    const fname = sFieldNames[start + fj]
    const sfi = sFieldIndex(ssi, fname)
    if sfi < 0 { return false }
    if !fieldRowsStoreAlike(sFieldFlatRow(ssi, sfi), start + fj) {
      return false
    }
    fj = fj + 1
  }
  true
}

// Whether struct row `ssi` has arm `vi`'s field names, each field stored as the arm stores it
// or as a number the arm's field holds wider (`i32` into `f64`), so a copy can build the arm.
export function structIdxConvertsToVariantIdx(ssi: i32, vi: i32): boolean {
  if ssi < 0 || ssi >= sFieldCount.length { return false }
  if vi < 0 || vi >= uFieldCount.length { return false }
  const cnt = uFieldCount[vi]
  if cnt != sFieldCount[ssi] { return false }
  const start = uFieldStart[vi]
  let fj = 0
  while fj < cnt {
    const sfi = sFieldIndex(ssi, sFieldNames[start + fj])
    if sfi < 0 { return false }
    const sr = sFieldFlatRow(ssi, sfi)
    const vr = start + fj
    if !fieldRowsStoreAlike(sr, vr) {
      const sk = fieldRowNumKind(sr)
      const vk = fieldRowNumKind(vr)
      if sk < 0 || vk < 0 { return false }
      if !(vk == 4 || (vk == 3 && sk == 0) || (vk == 5 && sk == 0)) {
        return false
      }
    }
    fj = fj + 1
  }
  true
}

// The variant arm of union type `unionTy` whose own heap type IS `heapIx`, or
// -1 — the rep dual of the layout compare above. A value already built as the arm's heap type
// rides the box's anyref unchanged, so its tag is the whole of what boxing it needs.
export function unionArmVariantWithHeap(unionTy: i32, heapIx: i32): i32 {
  if heapIx < 0 { return -1 }
  const u = unRowOfTyKey(unionTy)
  if u < 0 || u >= unVarStart.length || u >= unVarCount.length { return -1 }
  let vi = unVarStart[u]
  while vi < unVarStart[u] + unVarCount[u] {
    if vi < uVarRow.length && variantHeap(vi) == heapIx { return vi }
    vi = vi + 1
  }
  -1
}

// True if re-evaluating the expression at `exprIx` is side-effect-free and yields the same
// value — a literal, an ident (local/param/global/captured), a parenthesized such, or a pure
// field/index navigation of one. A call is not re-readable (its effects, and any
// allocation, would fire again). Gates the field-copy variant re-box, re-emitted per field.
export function exprReReadable(exprIx: i32): boolean {
  if exprIx < 0 { return false }
  const e = nodeAt(exprIx)
  match e {
    Ident => {
      return true
    }
    // A literal recomputes to itself. Without this arm a CONSTANT subscript made its whole
    // index read un-re-readable, which is what refused `xs[0]?.f()` (D1814).
    NumLit | StrLit | BoolLit | CharLit | NullLit => {
      return true
    }
    Paren => {
      return exprReReadable(e.parInner)
    }
    Member => {
      return exprReReadable(e.memObj)
    }
    Index => {
      return exprReReadable(e.idxArr) && exprReReadable(e.idxIndex)
    }
    // a call, an operator or any other node may have effects or allocate
    Unary | BinExpr | Call | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// Whether a shared field the members store at different reps reads as a value-union box: every
// member's field is a value atom, which the read boxes under that atom's tag (D3562). The checker
// types such a read as the union of the members' field types, numbers kept apart.
export function sharedFieldArmsBoxable(vis: i32[], fis: i32[]): boolean {
  let atoms = 0
  let i = 0
  while i < vis.length {
    if sharedFieldArmBoxKind(vis[i], fis[i]) >= 0 {
      atoms = atoms + 1
    } else if sharedFieldArmNulStr(vis[i], fis[i]) {
      atoms = atoms + 1
    } else if (
      !sharedFieldArmValueBox(vis[i], fis[i])
      && !sharedFieldArmNull(vis[i], fis[i])
    ) {
      return false
    }
    i = i + 1
  }
  vis.length > 1 && atoms > 0
}

// The read rep of a shared field some members store as an atom set and the rest as strings or
// `null`, or -1. The read's type decides: `FC_I32` when it is a string literal union,
// `FC_NUL_LIT_UNION` when it is one with `null` (a member stored as `null` reads `-1`), else
// `FC_STR`, or with no read the members' own storage; each other member converts (D5105).
export function sharedFieldLitSetPlan(
  vis: i32[],
  fis: i32[],
  readIx: i32,
): i32 {
  let atoms = 0
  let lone = 0
  let sets = 0
  let plain = 0
  let nuls = 0
  let i = 0
  while i < vis.length && i < fis.length {
    const k = sharedFieldLitArmKind(vis[i], fis[i])
    if k < 0 { return -1 }
    if k == 0 { atoms = atoms + 1 }
    if k == 1 { lone = lone + 1 }
    if k == 2 { sets = sets + 1 }
    if k == 3 { plain = plain + 1 }
    if k == 4 { nuls = nuls + 1 }
    i = i + 1
  }
  if nuls > 0 {
    if readIx < 0 || lone + sets + plain > 0 { return -1 }
    const rt = nodeTyIxOf(readIx)
    if tyIsNullableLitUnion(rt) { return FC_NUL_LIT_UNION }
    // A read narrowed past `null` never takes a `null` member.
    if tyIsLitUnion(rt) { return FC_I32 }
    return -1
  }
  if atoms == 0 { return -1 }
  if readIx >= 0 {
    if tyIsLitUnion(nodeTyIxOf(readIx)) { return FC_I32 }
    return FC_STR
  }
  if plain > 0 { return FC_STR }
  if sets > 0 || lone == 0 { return -1 }
  FC_I32
}

// The read rep of a shared field every member stores as `boolean`, `boolean | null` or `null`:
// `FC_NUL_BOOL` when the read is typed `boolean | null` (a member stored as `null` reads the
// niche's `2`), `FC_I32` when a narrowing excluded `null`, else -1.
export function sharedFieldNulBoolPlan(
  vis: i32[],
  fis: i32[],
  readIx: i32,
): i32 {
  if readIx < 0 { return -1 }
  let bools = 0
  let nuls = 0
  let i = 0
  while i < vis.length && i < fis.length {
    const code = variantFieldTypeAt(vis[i], fis[i])
    if code == FC_NUL_BOOL {
      bools = bools + 1
      nuls = nuls + 1
    } else if code == FC_NUL_NONE {
      nuls = nuls + 1
    } else if sharedFieldArmAtomKind(vis[i], fis[i]) == 1 {
      bools = bools + 1
    } else {
      return -1
    }
    i = i + 1
  }
  if bools == 0 || nuls == 0 { return -1 }
  const rt = nodeTyIxOf(readIx)
  if rt < 0 || rt >= T.tys.length { return -1 }
  const t = tyAt(rt)
  if t is TyNullable {
    if tyIsBooleanPrim(t.nInner) { return FC_NUL_BOOL }
    return -1
  }
  if tyIsBooleanPrim(rt) { return FC_I32 }
  -1
}

// The read rep of a shared field every member stores as `string`, `string | null` or `null`:
// `FC_NUL_STR` when the read is typed `string | null`, the niche every member's ref fits as it
// is, `FC_STR` when a narrowing excluded `null`, else -1.
export function sharedFieldNulStrPlan(
  vis: i32[],
  fis: i32[],
  readIx: i32,
): i32 {
  if readIx < 0 { return -1 }
  let strs = 0
  let nuls = 0
  let i = 0
  while i < vis.length && i < fis.length {
    const code = variantFieldTypeAt(vis[i], fis[i])
    if code == FC_NUL_STR {
      strs = strs + 1
      nuls = nuls + 1
    } else if code == FC_NUL_NONE {
      nuls = nuls + 1
    } else if code == FC_STR {
      strs = strs + 1
    } else {
      return -1
    }
    i = i + 1
  }
  if strs == 0 || nuls == 0 { return -1 }
  const rt = nodeTyIxOf(readIx)
  if rt < 0 || rt >= T.tys.length { return -1 }
  const t = tyAt(rt)
  if t is TyNullable {
    if tyIsStringPrim(t.nInner) { return FC_NUL_STR }
    return -1
  }
  if tyIsStringPrim(rt) { return FC_STR }
  -1
}

// The read rep of a shared field every member stores as one record or `null`: `FC_STRUCT`, the
// record's nullable ref, when the read is typed in frame `fnIx` as that record or `null`, else -1.
export function sharedFieldNulStructPlan(
  vis: i32[],
  fis: i32[],
  readIx: i32,
  fnIx: i32,
): i32 {
  if readIx < 0 { return -1 }
  let row = -1
  let nuls = 0
  let i = 0
  while i < vis.length && i < fis.length {
    const code = variantFieldTypeAt(vis[i], fis[i])
    if code == FC_NUL_NONE {
      nuls = nuls + 1
    } else if code == FC_STRUCT {
      const si = uFieldTgtStructIdx(vis[i], fis[i])
      if si < 0 || (row >= 0 && si != row) { return -1 }
      row = si
    } else {
      return -1
    }
    i = i + 1
  }
  if row < 0 || nuls == 0 { return -1 }
  const rt = nodeTyInOf(readIx, fnIx)
  if rt < 0 || rt >= T.tys.length { return -1 }
  const t = tyAt(rt)
  if t is TyNullable {
    const inner = t.nInner
    if inner >= 0 && inner < T.tys.length && tyAt(inner) is TyObj {
      return FC_STRUCT
    }
  }
  -1
}

// The first member of a shared read that stores its field at a value rather than at `null`: the
// arm the dispatch's blocktype names; 0 when every member does.
export function sharedFieldValueArm(vis: i32[], fis: i32[]): i32 {
  let i = 0
  while i < vis.length && i < fis.length {
    if !sharedFieldArmNull(vis[i], fis[i]) { return i }
    i = i + 1
  }
  0
}

// Whether `ty` is the primitive `string`.
function tyIsStringPrim(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  t is TyPrim && t.primName == "string"
}

// The box tag under which a shared read typed as the union of records `rt` (in its instance)
// stores member `vi`'s record field `fi`: the tag of that union's arm built at the field's own
// heap type, so the record rides the box unchanged. -1 when the field is no record or no arm is that heap.
export function sharedFieldArmStructTag(vi: i32, fi: i32, rt: i32): i32 {
  if !variantFieldIsRecordRef(vi, fi) { return -1 }
  const si = uFieldTgtStructIdx(vi, fi)
  if si < 0 || si >= sHeapIdx.length { return -1 }
  if rt < 0 || rt >= T.tys.length || !(tyAt(rt) is TyUnion) { return -1 }
  const av = unionArmVariantWithHeap(rt, sHeapIdx[si])
  if av < 0 || av >= uTags.length { return -1 }
  uTags[av]
}

// Whether a shared read whose members store its record field at different rows reads as the box
// of the union the read is typed as: every member's record is an arm of that union.
export function sharedFieldStructBoxPlan(
  vis: i32[],
  fis: i32[],
  readTy: i32,
): boolean {
  if vis.length < 2 || fis.length != vis.length { return false }
  let apart = false
  let i = 0
  while i < vis.length {
    if sharedFieldArmStructTag(vis[i], fis[i], readTy) < 0 { return false }
    if (
      uFieldTgtStructIdx(vis[i], fis[i])
      != uFieldTgtStructIdx(vis[0], fis[0])
    ) {
      apart = true
    }
    i = i + 1
  }
  apart
}

// The union row name a `sharedFieldStructBoxPlan` read delivers the box of, or "".
export function sharedFieldStructBoxName(
  vis: i32[],
  fis: i32[],
  readTy: i32,
): string {
  if !sharedFieldStructBoxPlan(vis, fis, readTy) { return "" }
  const u = unionRowKeyAB(85, readTy)
  if u < 0 || u >= unNames.length { return "" }
  unNames[u]
}

// Whether `ty` is the primitive `boolean`.
function tyIsBooleanPrim(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  t is TyPrim && t.primName == "boolean"
}

// Whether `ty` is a string literal union with `null`, stored as its atom with `-1` as `null`.
function tyIsNullableLitUnion(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  t is TyNullable && tyIsLitUnion(t.nInner)
}

// How member `vi` stores shared field `fi` for `sharedFieldLitSetPlan`: 0 a string literal set
// at the atom, 1 one string literal at the string, 2 a wider string literal set at the string,
// 3 a plain `string`, 4 `null` or a string literal set with `null` at `-1`, -1 anything else.
function sharedFieldLitArmKind(vi: i32, fi: i32): i32 {
  const code = variantFieldTypeAt(vi, fi)
  if code == FC_NUL_NONE || code == FC_NUL_LIT_UNION { return 4 }
  const n = sharedFieldArmLitTexts(vi, fi).length
  if code == FC_I32 {
    if n > 0 && variantFieldIsLitUnion(vi, fi) { return 0 }
    return -1
  }
  if code != FC_STR { return -1 }
  if n == 1 { return 1 }
  if n > 1 { return 2 }
  if vi < 0 || vi >= uFieldStart.length { return -1 }
  const at = uFieldStart[vi] + fi
  if at < 0 || at >= sFieldNames.length { return -1 }
  if at < sFieldLitTyIx.length && sFieldLitTyIx[at] >= 0 { return -1 }
  if vi >= uVarTyIx.length { return -1 }
  if tyIsPlainString(tyFieldTyOf(uVarTyIx[vi], sFieldNames[at])) {
    3
  } else {
    -1
  }
}

// The string literal texts member `vi` declares shared field `fi` at, from its arena type and
// else the field row's literal column; empty when the field is no string literal set.
export function sharedFieldArmLitTexts(vi: i32, fi: i32): string[] {
  tyLitMemberTexts(sharedFieldArmLitTy(vi, fi))
}

// The type `sharedFieldArmLitTexts` reads its texts off, or -1 when the member has no such field.
export function sharedFieldArmLitTy(vi: i32, fi: i32): i32 {
  if vi < 0 || vi >= uFieldStart.length { return -1 }
  const at = uFieldStart[vi] + fi
  if at < 0 || at >= sFieldNames.length { return -1 }
  if vi < uVarTyIx.length && uVarTyIx[vi] >= 0 {
    const ft = tyFieldTyOf(uVarTyIx[vi], sFieldNames[at])
    if ft >= 0 { return ft }
  }
  if at < armFieldLitTyIx().length { return armFieldLitTyIx()[at] }
  -1
}

// The literal set a shared-field plan's members store, read off the member whose set holds
// every other member's texts; -1 when no member's does (D5164).
export function sharedFieldPlanLitTy(vis: i32[], fis: i32[]): i32 {
  let k = 0
  while k < vis.length && k < fis.length {
    const ty = sharedFieldArmLitTy(vis[k], fis[k])
    const own = tyLitMemberTexts(ty)
    let covers = own.length > 0
    let j = 0
    while covers && j < vis.length && j < fis.length {
      if !textsWithin(sharedFieldArmLitTexts(vis[j], fis[j]), own) {
        covers = false
      }
      j = j + 1
    }
    if covers { return ty }
    k = k + 1
  }
  -1
}

// The variant row an `is` test's tested type `ty` names (D15250): the one row of the receiver
// `recvIx`'s union holding it, else the one row of the program holding it. -1 for none, or when
// rows of two names hold it.
export function isTestedRowOf(ty: i32, recvIx: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  if recvIx >= 0 {
    const ut = unionTyOfRecv(nodeTyInOf(unwrapParen(recvIx), emitCurFnIx))
    const u = if ut >= 0 { unRowOfTyKey(ut) } else { -1 }
    if u >= 0 && u < unVarStart.length && u < unVarCount.length {
      const lo = unVarStart[u]
      const hi = lo + unVarCount[u]
      for how in [1, 2, 3] {
        const r = isTestedRowIn(lo, hi, ty, how)
        if r != -1 { return if r >= 0 { r } else { -1 } }
      }
    }
  }
  for how in [1, 2, 3] {
    const r = isTestedRowIn(0, uVariants.length, ty, how)
    if r != -1 { return if r >= 0 { r } else { -1 } }
  }
  -1
}

// The first of rows `lo` to `hi` holding `ty` by `isTestedRowHolds`' test `how`, as the first row
// of its member type: -1 for none, -2 when two on different heaps do.
function isTestedRowIn(lo: i32, hi: i32, ty: i32, how: i32): i32 {
  let found = -1
  let r = lo
  while r < hi {
    if isTestedRowHolds(r, ty, how) {
      if found >= 0 && variantHeap(r) != variantHeap(found) { return -2 }
      if found < 0 { found = r }
    }
    r = r + 1
  }
  if found >= 0 { exactArmRowOfTy(uVarTyIx[found]) } else { -1 }
}

// Whether row `r` stores `ty`: 1 as that very type, 2 as one member (a record by its row's own
// fields, D5143), 3 once a Set is spelled as its boolean map (D4668).
function isTestedRowHolds(r: i32, ty: i32, how: i32): boolean {
  if r < 0 || r >= uVarTyIx.length || uVarTyIx[r] < 0 { return false }
  const rt = uVarTyIx[r]
  if how == 1 { return rt == ty }
  if how == 3 { return tySameSpelled(rt, ty, TY_WALK_DEPTH) }
  if tyAt(ty) is TyObj {
    return armRowIsMember(r, ty) || tySameSet(rt, ty, TY_WALK_DEPTH)
  }
  tySame(rt, ty) || mapTwinSame(rt, ty)
}

// Whether row `vi` holds more than one member of the receiver `recvIx`'s union, so its tag
// alone does not say which member a value is and `is` reads the fields as well (D5157).
export function armRowSharedAtRecv(recvIx: i32, vi: i32): boolean {
  if recvIx < 0 { return false }
  const ut = unionTyOfRecv(nodeTyInOf(unwrapParen(recvIx), emitCurFnIx))
  if ut < 0 { return false }
  const rt = tyAt(ut)
  if !(rt is TyUnion) { return false }
  if vi < 0 || vi >= uFieldCount.length { return false }
  let pairs = 0
  for m in rt.uMembers {
    const mt = tyAt(m)
    if mt is TyObj {
      if mt.objFieldNames.length == uFieldCount[vi] && armRowIsMember(vi, m) {
        pairs = pairs + 1
        if pairs > 1 { return true }
      }
    }
  }
  false
}

// Whether the receiver `recvIx` is typed at exactly record `ty`, as the checker narrows a shared
// row's value once its other members are ruled out, so `is ty` holds (D5157).
export function recvIsTestedRecord(recvIx: i32, ty: i32): boolean {
  if recvIx < 0 || ty < 0 || !tyIsRecord(ty) { return false }
  const rt = nodeTyInOf(unwrapParen(recvIx), emitCurFnIx)
  rt >= 0 && tyEq(rt, ty)
}

// The union type `t` is, through one `| null`, or -1.
export function unionTyOfRecv(t: i32): i32 {
  if t < 0 || t >= T.tys.length { return -1 }
  let u = t
  const rt = tyAt(t)
  if rt is TyNullable { u = rt.nInner }
  if u < 0 || u >= T.tys.length { return -1 }
  if tyAt(u) is TyUnion { u } else { -1 }
}

// Whether row `vi` is record `ty` as a row stores it: equal with a lone literal at its base,
// and every literal set the row records at a field is `ty`'s set there.
function armRowIsMember(vi: i32, ty: i32): boolean {
  if (
    vi < 0
    || vi >= uVarTyIx.length
    || vi >= uFieldCount.length
    || vi >= uFieldStart.length
  ) {
    return false
  }
  if uVarTyIx[vi] < 0 || ty < 0 || ty >= T.tys.length { return false }
  if !(tyAt(ty) is TyObj) { return false }
  if !tyEqSoftLits(uVarTyIx[vi], ty) { return false }
  let fi = 0
  while fi < uFieldCount[vi] {
    const at = uFieldStart[vi] + fi
    let own = sharedFieldArmLitTexts(vi, fi)
    if own.length == 0 && at < sFieldLitTyIx.length {
      own = tyLitMemberTexts(sFieldLitTyIx[at])
    }
    if own.length > 0 {
      const want = tyLitMemberTexts(tyFieldTyOf(ty, sFieldNames[at]))
      if !textSetsEqual(own, want) { return false }
    }
    fi = fi + 1
  }
  true
}

// Whether `a` and `b` hold the same texts, as sets.
function textSetsEqual(a: string[], b: string[]): boolean {
  textsWithin(a, b) && textsWithin(b, a)
}

// Whether every text of `a` is in `b`.
function textsWithin(a: string[], b: string[]): boolean {
  for x in a {
    let hit = false
    for y in b {
      if x == y { hit = true }
    }
    if !hit { return false }
  }
  true
}

// Whether a shared read at plan `code` converts member `vi`'s field `fi` between the atom and
// the string: the members' plan is `sharedFieldLitSetPlan`'s and this member stores the other.
export function sharedFieldArmConverts(code: i32, vi: i32, fi: i32): boolean {
  const own = variantFieldTypeAt(vi, fi)
  (code == FC_I32 && own == FC_STR) || (code == FC_STR && own == FC_I32)
}

// Whether some member of a shared read stores its field as a scalar the read boxes.
export function sharedPlanBoxesSome(vis: i32[], fis: i32[]): boolean {
  let i = 0
  while i < vis.length && i < fis.length {
    if !variantFieldIsUnionBox(vis[i], fis[i]) { return true }
    i = i + 1
  }
  false
}

// The element type of the first member of a shared read storing the field as a value box, or -1.
export function sharedPlanBoxTy(vis: i32[], fis: i32[]): i32 {
  let i = 0
  while i < vis.length && i < fis.length {
    if sharedFieldArmValueBox(vis[i], fis[i]) {
      return uFieldElemTyIxAt(vis[i], fis[i])
    }
    i = i + 1
  }
  -1
}

// The element type every member of a shared read stores its field as, or -1 when two members
// store different boxes or one stores none.
export function sharedPlanOneBoxTy(vis: i32[], fis: i32[]): i32 {
  const t = sharedPlanBoxTy(vis, fis)
  if t < 0 { return -1 }
  let i = 0
  while i < vis.length && i < fis.length {
    if !tySame(uFieldElemTyIxAt(vis[i], fis[i]), t) { return -1 }
    i = i + 1
  }
  t
}

// Whether member `vi` stores its field `fi` as a value-union box, which a mixed shared read
// delivers as stored beside the members it boxes (D4056). Read off the field's recorded type.
function sharedFieldArmValueBox(vi: i32, fi: i32): boolean {
  variantFieldIsUnionBox(vi, fi) && valueBoxOfTy(uFieldElemTyIxAt(vi, fi))
}

// Whether member `vi` stores its field `fi` as `string | null`, which a mixed shared read boxes
// under the string tag or the null tag by whether the stored ref is null (D13361).
export function sharedFieldArmNulStr(vi: i32, fi: i32): boolean {
  variantFieldIsNulStr(vi, fi)
}

// Whether member `vi` stores its field `fi` at the `null` type, which a mixed shared read
// delivers as the null-tagged box without reading the field.
export function sharedFieldArmNull(vi: i32, fi: i32): boolean {
  variantFieldIsNulNone(vi, fi)
}

// Whether some member of a shared read stores its field at the `null` type.
export function sharedFieldPlanHasNull(vis: i32[], fis: i32[]): boolean {
  let i = 0
  while i < vis.length && i < fis.length {
    if sharedFieldArmNull(vis[i], fis[i]) { return true }
    i = i + 1
  }
  false
}

// Whether the checker typed node `ix` as a union: the cheap test ahead of a shared-field plan.
export function nodeTyIsUnionRow(ix: i32): boolean {
  const t = nodeTyIxOf(ix)
  t >= 0 && t < T.tys.length && tyAt(t) is TyUnion
}

// Registers the value union a field read at `memIx` over a union receiver `recvIx` is typed as,
// so its box and value-box types exist when the read boxes its members' atoms. A read whose type
// names a type variable registers the union each instance closes it to (D15605).
export function registerSharedReadUnion(memIx: i32, recvIx: i32) {
  const rx = unwrapParen(recvIx)
  const t = nodeTyIxOf(memIx)
  if t < 0 || t >= T.tys.length { return 0 }
  registerSharedReadUnionAt(t, nodeTyIxOf(rx))
  if !tyHasTyVar(t) { return 0 }
  const rs = elabNodeInstTys(rx)
  const ts = elabNodeInstTys(memIx)
  for it in ts {
    if it != t {
      for ir in rs { registerSharedReadUnionAt(it, ir) }
    }
  }
  0
}

// `registerSharedReadUnion` at the read's type `t` over the receiver's type `r`.
function registerSharedReadUnionAt(t: i32, r0: i32) {
  if t < 0 || t >= T.tys.length { return 0 }
  // A join holding `null` is a nullable over the union, boxed the same way (D13361).
  const tt = tyAt(t)
  const ti = if tt is TyNullable { tt.nInner } else { t }
  if ti < 0 || ti >= T.tys.length { return 0 }
  if !(tyAt(ti) is TyUnion) && !(tt is TyNullable) { return 0 }
  let r = r0
  if r < 0 || r >= T.tys.length { return 0 }
  const rt = tyAt(r)
  if rt is TyNullable { r = rt.nInner }
  if r < 0 || r >= T.tys.length { return 0 }
  if !(tyAt(r) is TyUnion) { return 0 }
  if valueUnionKeyTextOfTy(t) != "" {
    registerValueUnionOfTy(51, t)
    return 0
  }
  // A join of a literal set and a scalar is named by its type above (D14750); one that is not
  // has no value union to box with.
  if valueUnionNameOfSoftTy(t) != "" {
    return emitFail(
      "emitProgram: a shared field read joins a literal set whose value union no type names",
    )
  }
  0
}

// The scalar or string atom kind member `vi` stores its field `fi` as, or -1 for any other
// field: a struct, a nullable, a union box, a list, or a literal-typed field (a discriminant,
// whose reads keep their own lowering), none of which is boxed here.
export function sharedFieldArmAtomKind(vi: i32, fi: i32): i32 {
  if variantFieldIsUnionBox(vi, fi) { return -1 }
  if vi < 0 || vi >= uFieldStart.length { return -1 }
  const at = uFieldStart[vi] + fi
  if at < 0 || at >= armFieldNames().length { return -1 }
  if at < sFieldLitTyIx.length && sFieldLitTyIx[at] >= 0 { return -1 }
  if variantFieldIsLitUnion(vi, fi) { return -1 }
  if vi >= uVarTyIx.length || uVarTyIx[vi] < 0 { return -1 }
  const ft = tyFieldTyOf(uVarTyIx[vi], armFieldNames()[at])
  if ft < 0 { return -1 }
  const k = boxTagOfTy(ft)
  if k < 0 || k > 5 || k == nullValKind() { return -1 }
  k
}

// The atom kind a boxing shared read tags member `vi`'s field `fi` under: its own scalar kind,
// or the string's (2) for a string literal set stored at the atom, which the read widens to its
// string. -1 for any other field.
export function sharedFieldArmBoxKind(vi: i32, fi: i32): i32 {
  const k = sharedFieldArmAtomKind(vi, fi)
  if k >= 0 { return k }
  if sharedFieldArmBoxesAtomSet(vi, fi) { return 2 }
  -1
}

// Whether member `vi` stores shared field `fi` as a string literal set at the atom, which a
// boxing read widens to its string before boxing it under the string tag.
export function sharedFieldArmBoxesAtomSet(vi: i32, fi: i32): boolean {
  sharedFieldLitArmKind(vi, fi) == 0
}

// The narrowing opcode from value atom `wk` back to the atom `k` a delivery widened it from
// (`i32` from `i64`, `f64` or `f32`, `f32` from `f64`), or -1: `unwidenI32From`'s table by kind.
export function atomNarrowOp(wk: i32, k: i32): i32 {
  if k == 0 && wk == 3 {
    return 167 // i32.wrap_i64
  }
  if k == 0 && wk == 4 {
    return 170 // i32.trunc_f64_s
  }
  if k == 0 && wk == 5 {
    return 168 // i32.trunc_f32_s
  }
  if k == 5 && wk == 4 {
    return 182 // f32.demote_f64
  }
  -1
}

// Whether a box retag widens value atom `fk` to `tk`: `i32` to `i64` or `f64`, `f32` to `f64`.
export function atomWidens(fk: i32, tk: i32): boolean {
  (fk == 0 && (tk == 3 || tk == 4)) || (fk == 5 && tk == 4)
}

// The kind member `p` (type `pt`) of `from` is stored as in a union `to` (member types `toTys`)
// lacking it, or -1: the FIRST member of `to`, in `to`'s order, that `from` lacks and `p` widens
// to. A read inverts exactly this first-match rule (`boxNarrowAtomFor`), so the two directions
// cannot disagree.
export function boxWidenAtomFor(
  p: string,
  pt: i32,
  to: string[],
  toTys: i32[],
  from: string[],
): i32 {
  if strListHas(to, p) { return -1 }
  const fk = boxAtomKindOfMemberTy(pt)
  let j = 0
  while j < to.length && j < toTys.length {
    const k = boxAtomKindOfMemberTy(toTys[j])
    if !strListHas(from, to[j]) && atomWidens(fk, k) { return k }
    j = j + 1
  }
  -1
}

// The kind of the one member of `own` (types `ownTys`) that `boxWidenAtomFor` stores as the stored
// member `p` (type `pt`), -1 when none is, or -2 when two are and a read cannot tell them apart.
export function boxNarrowAtomFor(
  p: string,
  pt: i32,
  own: string[],
  ownTys: i32[],
  stored: string[],
  storedTys: i32[],
): i32 {
  const pk = boxAtomKindOfMemberTy(pt)
  if pk < 0 || strListHas(own, p) { return -1 }
  let found = -1
  let j = 0
  while j < own.length && j < ownTys.length {
    if boxWidenAtomFor(own[j], ownTys[j], stored, storedTys, own) == pk {
      if found >= 0 { return -2 }
      found = boxAtomKindOfMemberTy(ownTys[j])
    }
    j = j + 1
  }
  found
}

// ── ref-array-typedness of expressions (G7-ref) ─────────────────────────────────

// Parallel to the i32-array family: decide whether an expression / param / local produces
// a ref list — `Tok[]` / `Node[]`, a row's wrapper. Receiver shapes mirror `exprArray`
// but for `S[]`/`N[]` annotations. `localIsRef` code `5` flags a ref-list local.

// True if the read `readIx` is of a parameter of `fnIx` with a NULLABLE ref-array type (`<ref-array> | null`,
// kind 18 — e.g. `i32[][] | null`, `S[] | null`): `vtKindOfType`
// (already `| null`-aware) recognizes the annotation. Lets `exprNullableRefArray` / `exprRefArray` classify
// a nulreflist PARAM (its `!= null` narrow + narrowed indexing), which #877 wired only for a LOCAL.
export function paramNulRefArray(fnIx: i32, readIx: i32) {
  vtKindOfType(paramTypeNodeOfRead(fnIx, readIx)) == "nulreflist"
}

// The ref-list ELEMENT type-NAME the ref-array param of function `fnIx` that the read `readIx`
// resolves to declares (`p: Tok[]` → `Tok`), or "" if not a ref-array param.
export function paramRefArrayName(fnIx: i32, readIx: i32) {
  const pos = paramPosOfRead(fnIx, readIx)
  if pos < 0 { return "" }
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    const params = fn.fnParams
    let i = 0
    while i < params.length {
      const p = nodeAt(params[i])
      if p is Param {
        if i == pos {
          if p.parType >= 0 {
            const ty = nodeAt(p.parType)
            // The row keyed by the annotation's element type; "" for a non-ref-array
            // annotation is the same "" the next line returns.
            if ty is TypeRef { return annBareRefArrElemName(p.parType) }
          }
          return ""
        }
      }
      i = i + 1
    }
  }
  ""
}

// The INNER ref-list slot a function `name` returns when its return is a NULLABLE ref array
// (`i32[][] | null` → the row of `i32[]`), else -1. Read off the return-type node, since
// `fRetRArrElem` records only a non-null ref-array element.
export function fnRetNulRefArraySlotSid(
  sid: i32,
  name: string,
  fnIx: i32,
  at: i32,
): i32 {
  const i = fnIndexOfInScopeAt(sid, name, fnIx, at)
  if i < 0 { return -1 }
  const fn = nodeAt(fnStmts[i])
  if fn is FuncDecl {
    if fn.fnRet >= 0 {
      const rty = nodeTyIxOf(fn.fnRet)
      if rty < 0 { return -1 }
      const rt = tyAt(rty)
      if rt is TyNullable {
        if !tyIsRefArray(rt.nInner) { return -1 }
        const sl = rlSlotOfTy(tyStepElem(rt.nInner))
        if sl >= 0 && sl < rlElemName.length { return sl }
      }
    }
  }
  -1
}

// The element name of the row `fnRetNulRefArraySlotSid` finds, or "". A consumer
// `const t = mk()` infers the kind-18 niche and its narrowed indexing reads that row.
export function fnRetNulRefArrayNameSid(
  sid: i32,
  name: string,
  fnIx: i32,
  at: i32,
) {
  const sl = fnRetNulRefArraySlotSid(sid, name, fnIx, at)
  if sl < 0 { return "" }
  rlElemName[sl]
}

// The ref-list row slot the local read at `ix` is declared at (recorded in `localStructIdx` for a
// code-5 local), or -1.
export function declaredRefArraySlot(ix: i32): i32 {
  const i = declaredSlotOf(ix)
  if i < 0 || localIsRef[i] != "reflist" { return -1 }
  const slot = localStructIdx[i]
  if slot >= 0 && slot < rlElemName.length { slot } else { -1 }
}

// The ref-list row keyed by the element type recorded on the empty `[]` at `exprIx` in instance
// `fnIx`, or -1.
export function emptyArrHoleElemSlot(exprIx: i32, fnIx: i32) {
  const ax = emptyArrLitIxOf(exprIx)
  if ax < 0 { return -1 }
  repSlotOfKind("reflist", nodeTyAt(ax, fnIx))
}
