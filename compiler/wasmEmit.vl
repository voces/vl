} from "./emit_plan_if_join"

export function capCacheBuild() {
  capStartTbl = []
  capCountTbl = []
  capNamesFlat = []
  let fe = 0
  while fe < fnStmts.length {
    // Only a nested function or a lambda can capture, so with none every list is empty.
    let caps: string[] = []
    if fnNestUsed { caps = capComputeNamesOf(fe) }
    capStartTbl.push(capNamesFlat.length)
    capCountTbl.push(caps.length)
    let ci = 0
    while ci < caps.length {
      capNamesFlat.push(caps[ci])
      ci = ci + 1
    }
    fe = fe + 1
  }
  cloCellTarget = []
  cloCellUsed = false
  while cloCellTarget.length < fnStmts.length { cloCellTarget.push(0) }
  for name in capNamesFlat {
    const t = capCellTargetOf(name)
    if t >= 0 {
      // A cell stands for an env its declaring frame keeps, so its function must capture.
      if t >= capCountTbl.length || capCountTbl[t] == 0 {
        return emitFail(
          "emitProgram: a function-value cell names a function with no env",
        )
      }
      cloCellTarget[t] = 1
      cloCellUsed = true
    }
  }
  return 0
}

// The scalar element kind (`"f64"`/`"i64"`/`"f32"`/`"v128"`) of an mv map-value slot whose value
// is a non-i32 scalar, else null (a ref value rides the nullable valStash instead). The
// chokepoint the map get/set/push consult to branch scalar-store vs ref-store.
function mvScalarValKind(slot: i32): VKind | null {
  if slot < 0 || slot >= mvValRep.length { return null }
  const k = mvValRep[slot].mrKind
  if k == "f64" || k == "i64" || k == "f32" || k == "v128" { return k }
  return null
}

// Open the value-typed `if` a fused `?? d` list read joins on, at the element's own rep. A
// string element is a REF, so it takes `fbIfRef` where every other kind takes a valtype
// byte; one speller, so the two arms of the read cannot disagree about the join type.
function fbIfForScalarListElem(elemKind: VKind) {
  if elemKind == "str" { return fbIfRef(sTy()) }
  return fbIf(scalarListBlocktype(elemKind))
}

// The `array.get` result blocktype byte for a scalar element kind (i32 `0x7f`, f64
// `0x7c`, i64 `0x7e`). A `u8[]` element reads as i32 (`array.get_u` widens), so it shares
// the plain i32 blocktype; a `string` element has no byte and goes through `fbIfRef`.
function scalarListBlocktype(elemKind: VKind) {
  if elemKind == "u8list" { return 127 }
  if elemKind == "f64" { return 124 }
  if elemKind == "i64" { return 126 }
  if elemKind == "f32" { return 125 }
  if elemKind == "v128" { return 123 }
  if elemKind == "i32" { return 127 }
  return scalarListKindUnlisted(127)
}

// Whether the module-global list types for a scalar element kind are collected — the
// loud-fail guard every list op shares. An unlisted kind answers false, which is the
// caller's own loud refusal rather than a silent read at the i32 list's types.
export function scalarListUsed(elemKind: VKind) {
  match elemKind {
    "u8list" => {
      return true
    }
    "f64" => {
      return true
    }
    "i64" => {
      return true
    }
    // The f32 and v128 pairs mint on first read.
    "f32" | "v128" => {
      return true
    }
    // The string and i32 lists mint on first read too.
    "str" => {
      return true
    }
    "i32" => {
      return true
    }
    // No other kind is a scalar list element, so its list types are never collected.
    "struct" | "list" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "f64list" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "v128list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulu8list" | "nulmap" | "nulnone" => {}
  }
  return false
}

// Emit `exprIx` coerced to a scalar element kind's value rep — the f64/i64 widen of a
// narrower literal/`i32` so a list element / `?? d` default matches the backing type.
// A `u8[]` value is an ordinary i32 (WasmGC has no `u8`; the truncation to one byte is
// `array.set`'s masked write, not this call's), so it passes through like plain i32.
function emitScalarValue(exprIx: i32, fnIx: i32, elemKind: VKind) {
  if elemKind == "f64" { return emitWidened(exprIx, 4, fnIx) }
  if elemKind == "i64" { return emitWidened(exprIx, 3, fnIx) }
  if elemKind == "f32" { return emitWidened(exprIx, 5, fnIx) }
  return emitExpr(exprIx, fnIx)
}

// The `pushFieldStorage` slot argument for struct `si`'s field `fi` — the one place the three
// tables a field code can name are chosen between (nested-struct row, map shape, ref-list
// row). `emitTypeSection`, the supertype prefix test and the object-literal order stash
// (D1510) all read it, so the declared slot and the stash local cannot disagree.
export function sFieldStorageSlot(si: i32, fi: i32): i32 {
  // Only a ref-list field reads a ref-list slot; asking for any other would mint an unused row.
  return match fieldRowSlotTable(sFieldStart[si] + fi) {
    "struct" => sFieldTgtStructIdx(si, fi)
    "map" => sFieldMapShape(si, fi)
    "reflist" => sFieldRefSlot(si, fi)
    "packed" => fieldRowPackedRow(sFieldStart[si] + fi)
    "none" => -1
  }
}

// The null an omitted or explicit-`null` field `fi` of struct row `si` takes, where it is one
// `emitNullOwn` writes (`NULL_OWN_*`): the `boolean | null`, `K | null` or `string | null` niche,
// the `null` unit, or the null-tagged box of a union with a `null` member. -1 for a typed ref's
// null or a field with no null of its own.
export function fieldNullOwnOf(si: i32, fi: i32): i32 {
  if si < 0 || si >= sFieldStart.length { return -1 }
  const r = sFieldStart[si] + fi
  const k = fieldRowKind(r)
  if k == null { return -1 }
  return match k {
    "nulstr" => NULL_OWN_STR
    "nulbool" => NULL_OWN_BOOL
    // A plain `i32` has no null; `K | null` rides the niche below every member id.
    "i32" => if fieldRowIsPlainI32(r) { -1 } else { NULL_OWN_ATOM }
    "nulnone" => NULL_OWN_NONE
    // A value-union field defaults to null only when `null` is a member: its banked null code.
    "union" => if unionHasAtomK(msSetOfTy(sFieldElemTyIxAt(si, fi)), "null", nullValKind()) { NULL_OWN_BOX } else { -1 }
    "nullist" | "nulu8list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulf64list" | "nulstrlist" | "nulclosure" | "nulstruct" | "nulvariant" | "nulreflist" | "nulmap" | "i64" | "f64" | "f32" | "v128" | "struct" | "list" | "str" | "reflist" | "map" | "variant" | "closure" | "u8list" | "i64list" | "f32list" | "v128list" | "f64list" | "strlist" => -1
  }
}

// Whether field `fi` of struct row `si` has a typed reference's null whose heap is fixed when emit
// starts, `ref.null` of it: a nullable list or closure, or a nullable record or ref list whose row is
// interned. A map's null takes its map shape's heap, which a later mint may move.
export function fieldTypedNullHas(si: i32, fi: i32): boolean {
  if si < 0 || si >= sFieldStart.length { return false }
  const k = fieldRowKind(sFieldStart[si] + fi)
  if k == null { return false }
  return match k {
    "nullist" | "nulu8list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulf64list" | "nulstrlist" | "nulclosure" => true
    "nulstruct" | "nulvariant" => sFieldTgtStructIdx(si, fi) >= 0
    "nulreflist" => sFieldRefSlot(si, fi) >= 0 && sFieldRefSlot(si, fi) < rlWrapIdx.length
    "nulmap" | "nulstr" | "nulbool" | "i32" | "nulnone" | "union" | "i64" | "f64" | "f32" | "v128" | "struct" | "list" | "str" | "reflist" | "map" | "variant" | "closure" | "u8list" | "i64list" | "f32list" | "v128list" | "f64list" | "strlist" => false
  }
}

// The null value of an omitted nullable field (`si`/`fi`) in a struct literal: `fieldNullOwnOf`'s
// null, else `ref.null` of the field's own backing for the typed ref codes. -1 when not nullable.
export function emitOmittedFieldNull(si: i32, fi: i32) {
  const own = fieldNullOwnOf(si, fi)
  if own >= 0 {
    emitNullOwn(own)
    return 0
  }
  if si < 0 || si >= sFieldStart.length { return -1 }
  const r = sFieldStart[si] + fi
  const k = fieldRowKind(r)
  if k == null { return -1 }
  if !fieldTypedNullHas(si, fi) && k != "nulmap" { return -1 }
  match k {
    "nullist" | "nulu8list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulf64list" | "nulstrlist" | "nulclosure" => {
      fbRefNullForKind(
        k,
        if k == "nulu8list" { fieldRowPackedRow(r) } else { -1 },
      )
      return 0
    }
    "nulstruct" | "nulvariant" => {
      const tgt = sFieldTgtStructIdx(si, fi)
      if tgt < 0 { return -1 }
      fbRefNull(sHeapIdx[tgt])
      return 0
    }
    "nulreflist" => {
      const rs = sFieldRefSlot(si, fi)
      if rs >= 0 && rs < rlWrapIdx.length {
        fbRefNull(rlWrapIdx[rs])
        return 0
      }
      return -1
    }
    "nulmap" => {
      fbRefNull(mapTypeIdxOf(sFieldMapShape(si, fi)))
      return 0
    }
    // `fieldNullOwnOf` wrote these where they have a null; here they have none.
    "nulstr" | "nulbool" | "i32" | "nulnone" | "union" | "i64" | "f64" | "f32" | "v128" | "struct" | "list" | "str" | "reflist" | "map" | "variant" | "closure" | "u8list" | "i64list" | "f32list" | "v128list" | "f64list" | "strlist" => {
      return -1
    }
  }
}

// The arm record field `fi` of struct row `si` takes value `valIx` at, in
// `emitStructFieldValue`'s order: a refusal, a conversion, or `plain`, the value as itself.
// `pastNull` once an explicit `null` found no null of the field's own.
export type StructFieldArm = "mapClash" | "holder" | "noKind" | "nested" | "cloArray" | "lambda"
  | "explicitNull" | "refSlot" | "union" | "f64" | "i64" | "f32" | "nulStrAtom" | "strAtom"
  | "nulnone" | "armDelivery" | "plain"
export function structFieldArmOf(
  si: i32,
  fi: i32,
  valIx: i32,
  fnIx: i32,
  pastNull: boolean,
): StructFieldArm {
  // A fresh `Map()` the field's row stores at another map struct than the call builds would not
  // validate: the row and the call took the value's functions at different reps (D17015).
  if fieldRowKind(sFieldStart[si] + fi) == "map" && mapNewCallAt(valIx) {
    const built = mapNewShapeOf(unwrapParen(valIx), fnIx)
    const held = sFieldMapShape(si, fi)
    if built != -3 && held != -3 && mapTypeIdxOf(built) != mapTypeIdxOf(held) {
      return "mapClash"
    }
  }
  // A holder stored into a field of one closure type stores its record's member of that type.
  const sm = elabStoreMemberOf(nodeSrc[valIx] ?? valIx)
  if sm >= 0 && emitHolderRead(valIx, fnIx) { return "holder" }
  const sk = fieldRowKind(sFieldStart[si] + fi)
  if sk == null { return "noKind" }
  // A struct value goes only into a record-ref field or a box-union field.
  if !eqKindIsRecord(sk) && sk != "union" && exprStruct(valIx, fnIx) {
    return "nested"
  }
  const vn = nodeAt(unwrapParen(valIx))
  // A same-name shape collision can code a closure-array field as a bare closure.
  if sk == "closure" && vn is ArrayLit { return "cloArray" }
  // A lambda the decision made a leaf of a tagged set is stored as its id.
  if !fieldKindTakesClosure(sk) && vn is FuncDecl && fnTagLeafId(valIx) < 0 {
    return "lambda"
  }
  // An explicit `null` is the field's own null, as an omitted one is.
  if !pastNull && vn is NullLit { return "explicitNull" }
  if sk == "reflist" && sFieldRefSlot(si, fi) >= rlElemTyIx.length {
    return "refSlot"
  }
  return match sk {
    "union" => "union"
    "f64" => "f64"
    "i64" => "i64"
    "f32" => "f32"
    "nulstr" => if exprIsLitAtom(valIx, fnIx) { "nulStrAtom" } else { "plain" }
    "str" => if exprIsLitAtom(valIx, fnIx) { "strAtom" } else { "plain" }
    "nulnone" => "nulnone"
    // A literal-union field lowers its member as the interned atom id; any other narrowed arm
    // into a record field is `emitArmDelivery`'s.
    "nulstruct" | "nulvariant" => if sFieldIsLitUnion(si, fi) || sFieldIsLitUnionArray(si, fi) { "plain" } else { "armDelivery" }
    "i32" | "v128" | "struct" | "list" | "reflist" | "map" | "variant" | "closure" | "nulbool" | "nulclosure" | "nulmap" | "u8list" | "i64list" | "f32list" | "v128list" | "f64list" | "strlist" | "nullist" | "nulu8list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulf64list" | "nulstrlist" | "nulreflist" => "plain"
  }
}

// One struct field's value, through the arm `structFieldArmOf` names, then the non-null recovery
// the construct owes. Carved out of `emitObj`'s layout loop so the source-order stash pass
// (D1510) runs exactly the same lowering, once per field.
function emitStructFieldValue(si: i32, fi: i32, valIx: i32, fnIx: i32) {
  let arm = structFieldArmOf(si, fi, valIx, fnIx, false)
  if arm == "explicitNull" {
    if emitOmittedFieldNull(si, fi) == 0 { return 0 }
    arm = structFieldArmOf(si, fi, valIx, fnIx, true)
  }
  const rc = match arm {
    "mapClash" => emitFailAt(
      "emitProgram: a record field holds a fresh `Map()` whose values store functions at one rep while the record's row stores them at another, so the two map types differ; building it at one rep is not done yet",
      valIx,
    )
    "holder" => {
      return emitBundleMemberPick(
        valIx,
        elabStoreMemberOf(nodeSrc[valIx] ?? valIx),
        fnIx,
      )
    }
    "noKind" => emitFail("emitProgram: struct field has no storage kind")
    "nested" => emitFail("emitProgram: nested struct fields are not supported")
    "cloArray" => emitFail("emitProgram: a closure-array struct-field literal is not supported")
    "lambda" => emitFail(
      "emitProgram: a lambda field value resolved to a non-closure field slot",
    )
    "refSlot" => emitFail("emitProgram: ref-list field element type is not interned")
    "explicitNull" => emitFail("emitProgram: internal: an explicit null field past its null")
    // A raw scalar, string or null goes into the box with its atom tag (`emitUnionBoxArg`).
    "union" => emitUnionBoxOwed("", structFieldBoxTy(si, fi), valIx, fnIx)
    "f64" => emitWidened(valIx, 4, fnIx)
    "i64" => emitWidened(valIx, 3, fnIx)
    "f32" => emitWidened(valIx, 5, fnIx)
    // A literal-union atom (an i32 id) widens to its member string.
    "nulStrAtom" => emitStrValue(valIx, fnIx)
    "strAtom" => emitAtomToStr(valIx, fnIx)
    // The `null` unit type's slot holds only `ref.null none`; the value runs for effect (D4671).
    "nulnone" => {
      if emitNulNoneForEffect(valIx, fnIx) < 0 { return -1 }
      fbRefNullNone()
    }
    "armDelivery" => emitArmDelivery(valIx, fnIx, sFieldTgtHeapOf(si, fi))
    "plain" => emitExpr(valIx, fnIx)
  }
  if rc < 0 { return -1 }
  // D1222: a narrowed nullable ref keeps its `(ref null $H)`, so a `{f: y}` under a non-null
  // guard recovers before a `(ref $H)` field, as the other deliveries do.
  if nulNicheRecoverOwed(sFieldStoreKind(si, fi), valIx, fnIx) {
    fbRefAsNonNull()
  }
  return 0
}

// Lower an object literal `{ f: v, … }` onto `body`: build the struct of its recorded type
// (its destination's, when the checker adopted one), push each field in declared order, then
// `struct.new`. A nullable field may be omitted (`emitOmittedFieldNull`); any other must match.
// `row` >= 0 is a container's struct row the literal is built at instead.
function emitObj(objIx: i32, fnIx: i32, row: i32) {
  if !sDeclared {
    return emitFail("emitProgram: object literal but no struct type declared")
  }
  if objIx < 0 { return -1 }
  const o = nodeAt(objIx)
  if o is ObjLit {
    const si = if row >= 0 { row } else { structIndexOfObjCtx(objIx, fnIx) }
    if si < 0 {
      return emitFail(
        "emitProgram: object literal field count does not match struct",
      )
    }
    const cnt = sFieldCount[si]
    // D1510 — source-order evaluation. `struct.new` takes its operands in layout order,
    // sorted by field name, so evaluating each initialiser as it is pushed runs a literal
    // written in another order permuted. When the permutation is observable, evaluate in
    // source order into one scratch local per field; `stash` is empty otherwise.
    const stash: i32[] = []
    // A field the layout drops also takes the stash, so its initialiser runs, in source
    // order, for its effect (D1696).
    if objLitStashes(objIx, si) {
      let pi = 0
      while pi < cnt {
        stash.push(0 - 1)
        pi = pi + 1
      }
      const pairs = objFieldSrcPairs(objIx, sFieldNames, sFieldStart[si], cnt)
      let oi = 0
      while oi + 1 < pairs.length {
        const ofi = pairs[oi]
        const ovIx = pairs[oi + 1]
        oi = oi + 2
        if ofi < 0 {
          if emitExpr(ovIx, fnIx) < 0 { return -1 }
          fbDrop()
          continue
        }
        if emitStructFieldValue(si, ofi, ovIx, fnIx) < 0 { return -1 }
        const oslot = objOrderStashSlot(
          fieldRowStorageKind(sFieldFlatRow(si, ofi)),
          sFieldTypeAt(si, ofi),
          sFieldStorageSlot(si, ofi),
        )
        stash[ofi] = oslot
        fbLocalSet(oslot)
      }
    }
    let fi = 0
    while fi < cnt {
      const valIx = objFieldVal(objIx, sFieldNames[sFieldStart[si] + fi])
      if valIx < 0 {
        // An omitted field pushes a constant, so it has no source position to keep and
        // stays in the layout loop even under the stash.
        if emitOmittedFieldNull(si, fi) < 0 {
          return emitFail(
            "emitProgram: object literal is missing a struct field",
          )
        }
        fi = fi + 1
        continue
      }
      if stash.length > 0 {
        fbLocalGet(stash[fi])
        fi = fi + 1
        continue
      }
      if emitStructFieldValue(si, fi, valIx, fnIx) < 0 { return -1 }
      fi = fi + 1
    }
    return objStructNewTail(si)
  }
  return emitFail("emitProgram: expected an object literal")
}

// Whether `ix` is a read of `name`, through parentheses.
function nameIsBareIn(name: string, ix: i32): boolean {
  const x = unwrapParen(ix)
  if x < 0 { return false }
  const n = nodeAt(x)
  return n is Ident && n.identName == name
}

// Does `name` appear as a value — any position other than the callee of a direct
// `name(...)` call — in the subtree at `ix`? A generic function bound to `name` is sound
// only when every use is a direct call, since `monomorphize` rewrites each call to its
// instance and a value use escapes to a call the binding cannot type. Mirrors `monoWalk`.
function nameUsedAsValueIn(name: string, ix: i32) {
  if ix < 0 { return false }
  const n = nodeAt(ix)
  match n {
    Ident => {
      return n.identName == name
    }
    Call => {
      if n.callFn < 0 { return false }
      const callee = nodeAt(n.callFn)
      let direct = false
      if callee is Ident {
        if callee.identName == name { direct = true }
      }
      if !direct {
        if nameUsedAsValueIn(name, n.callFn) { return true }
      }
      const args = n.callArgs
      let i = 0
      while i < args.length {
        if nameUsedAsValueIn(name, args[i]) { return true }
        i = i + 1
      }
      return false
    }
    Block => {
      const bs = n.blkStmts
      let i2 = 0
      while i2 < bs.length {
        if nameUsedAsValueIn(name, bs[i2]) { return true }
        i2 = i2 + 1
      }
      return false
    }
    LetDecl => {
      return nameUsedAsValueIn(name, n.letInit)
    }
    IfStmt => {
      if nameUsedAsValueIn(name, n.ifCond) { return true }
      if nameUsedAsValueIn(name, n.ifThen) { return true }
      return nameUsedAsValueIn(name, n.ifElse)
    }
    WhileStmt => {
      if nameUsedAsValueIn(name, n.whileCond) { return true }
      return nameUsedAsValueIn(name, n.whileBody)
    }
    ForRange => {
      if nameUsedAsValueIn(name, n.frFrom) { return true }
      if nameUsedAsValueIn(name, n.frTo) { return true }
      if nameUsedAsValueIn(name, n.frStep) { return true }
      return nameUsedAsValueIn(name, n.frBody)
    }
    ForIn => {
      if nameUsedAsValueIn(name, n.fiIter) { return true }
      return nameUsedAsValueIn(name, n.fiBody)
    }
    RetStmt => {
      return nameUsedAsValueIn(name, n.retArg)
    }
    // A compared name is read for its identity, which calls nothing (D7383).
    BinExpr => {
      if n.binOp == "==" || n.binOp == "!=" {
        if (
          !nameIsBareIn(name, n.binLeft)
          && nameUsedAsValueIn(name, n.binLeft)
        ) {
          return true
        }
        return !nameIsBareIn(name, n.binRight)
          && nameUsedAsValueIn(name, n.binRight)
      }
      if nameUsedAsValueIn(name, n.binLeft) { return true }
      return nameUsedAsValueIn(name, n.binRight)
    }
    Unary => {
      return nameUsedAsValueIn(name, n.unArg)
    }
    Paren => {
      return nameUsedAsValueIn(name, n.parInner)
    }
    Member => {
      return nameUsedAsValueIn(name, n.memObj)
    }
    OptMember => {
      return nameUsedAsValueIn(name, n.omObj)
    }
    Index => {
      if nameUsedAsValueIn(name, n.idxArr) { return true }
      return nameUsedAsValueIn(name, n.idxIndex)
    }
    IsExpr => {
      return nameUsedAsValueIn(name, isExprKid(n))
    }
    AsExpr => {
      return nameUsedAsValueIn(name, n.asObj)
    }
    // A spread's source is an operand like any other (D2334).
    Spread => {
      return nameUsedAsValueIn(name, n.spdArg)
    }
    ArrayLit => {
      const es = n.arrElems
      let i3 = 0
      while i3 < es.length {
        if nameUsedAsValueIn(name, es[i3]) { return true }
        i3 = i3 + 1
      }
      return false
    }
    ObjLit => {
      const fs = n.objFields
      let i4 = 0
      while i4 < fs.length {
        const f = nodeAt(fs[i4])
        if f is FieldInit {
          if nameUsedAsValueIn(name, f.fiValue) { return true }
        }
        i4 = i4 + 1
      }
      return false
    }
    // No other node holds a value use of a name.
    NumLit | StrLit | CharLit | BoolLit | NullLit | ErrExpr | Param | TypeRef | FuncDecl | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | MatchExpr | ImportDecl | LoopVar => {}
  }
  return false
}

// A generic function (un-annotated parameters) taken as a value would emit its params at
// the i32 default, so a `call_indirect` traps the signature check at any other type.
// Reject it as a value unless it is an anonymous lambda used only as a direct-call callee
// (`criFnIsAnonLambda`), which is sound and routes straight to `emitClosureValueCore`.
export function emitClosureValue(fe: i32, fnIx: i32) {
  const why = closureValueWhy(fe)
  if why != "" { return emitFail(why) }
  return emitClosureValueOf(cloAdapterCanonOf(fe), fnIx)
}

// The refusal `emitClosureValue` raises for function `fe`, or "": a generic function's, then
// `closureValueCoreWhy`'s.
export function closureValueWhy(fe: i32): string {
  if fnHasUnannotatedParam(fe) && !criFnIsAnonLambda(fe) {
    return genericFnValueRejectMsg(fe)
  }
  return closureValueCoreWhy(fe)
}

// The closure-value fat pointer for lifted function `fe`: `struct.new $cloStruct [ env, id,
// decl ]`. The env is `ref.null struct` for a non-capturing function, else a `struct.new
// $envStruct` of the enclosing frame's captured values; `id` is the lifted wasm index, the
// `call_indirect` operand; `decl` is the `==` identity token (`cloDeclOf`).
export function emitClosureValueCore(fe: i32, fnIx: i32) {
  const why = closureValueCoreWhy(fe)
  if why != "" { return emitFail(why) }
  return emitClosureValueOf(cloAdapterCanonOf(fe), fnIx)
}

// The refusal `emitClosureValueCore` raises for function `fe`, or "". A signature with no
// closure `$fnsig` cannot be called as a value: the call would `call_indirect` at the wrong type.
export function closureValueCoreWhy(fe: i32): string {
  if fe < 0 || fe >= fnStmts.length {
    return "emitProgram: function value with no lifted function"
  }
  if cloLifted(fe) {
    return "emitProgram: a lambda-lifted local function was taken as a value"
  }
  if cloSigKeyExt(fe) == "" {
    return "emitProgram: a function value's signature is not yet supported — "
      + cloSigRejectWhat(fe)
      + " has no representation in the function-value ABI; annotate and call it as a "
      + "named function instead"
  }
  return ""
}

// The function a function-value adapter `fe` calls (`fvaAdapt` in check_assignable.vl): it takes
// at least one parameter, all named `$fp<k>`, and its body is one call of a declared function
// passing them in order; this returns that function's position. -1 for any other function.
function fvaAdapterCallee(fe: i32): i32 {
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const d = nodeAt(fnStmts[fe])
  if !(d is FuncDecl) { return -1 }
  if d.fnName != "" && !keyHasPrefix(d.fnName, "__lambda_") { return -1 }
  const ps = d.fnParams
  if ps.length == 0 || d.fnBody < 0 || d.fnBody >= P.nodes.length { return -1 }
  const b = nodeAt(d.fnBody)
  if !(b is Block) || b.blkStmts.length != 1 { return -1 }
  const c = nodeAt(unwrapParen(b.blkStmts[0]))
  if !(c is Call) || c.callArgs.length != ps.length { return -1 }
  if c.callFn < 0 || c.callFn >= P.nodes.length { return -1 }
  if !(nodeAt(c.callFn) is Ident) { return -1 }
  let i = 0
  while i < ps.length {
    const p = nodeAt(ps[i])
    if !(p is Param) || p.parName != "$fp" + i32ToStr(i) { return -1 }
    if !nameIsBareIn(p.parName, c.callArgs[i]) { return -1 }
    i = i + 1
  }
  return fnIndexOfAt(sidOfNode(c.callFn), fnStmts[fe], c.callFn)
}

// The function whose closure id stands for capture-free adapter `fe`: its callee when the callee
// has the adapter's closure signature, else the first adapter emitted of the same callee at that
// signature; `fe` itself for any other function (D7382).
function cloAdapterCanonOf(fe: i32): i32 {
  if fnEnvIdxOf(fe) >= 0 { return fe }
  const callee = fvaAdapterCallee(fe)
  if callee < 0 { return fe }
  const sk = cloSigKeyExt(fe)
  if callee < fnStmts.length && fnEnvIdxOf(callee) < 0 && !cloLifted(callee) {
    if !fnHasUnannotatedParam(callee) && cloSigKeyExt(callee) == sk {
      return callee
    }
  }
  const key = i32ToStr(callee) + "|" + sk
  const have = cloAdapterCanon[key] ?? -1
  if have >= 0 { return have }
  cloAdapterCanon[key] = fe
  return fe
}

// A bound on `cloDeclOf`'s walk, which takes one hop per void twin or adapter layer; a chain
// is a few layers deep, so the bound only guards against a cycle.
const CLO_DECL_MAX_HOPS = 16

// The function a closure of `fe` names in its identity field: the one standing for `fe`'s source
// declaration, reached through adapters, void twins and generic instances, so every delivery of
// one declaration compares equal at whatever signature it is delivered (D7180).
function cloDeclOf(fe: i32): i32 {
  const have = cloDeclAt[fe] ?? -1
  if have >= 0 { return have }
  let cur = fe
  let hops = 0
  while hops < CLO_DECL_MAX_HOPS {
    let next = voidTwinTargetOf(cur)
    if next < 0 { next = fvaAdapterCallee(cur) }
    if next < 0 || next == cur { break }
    cur = next
    hops = hops + 1
  }
  if cur >= monoOrigNode.length {
    let q = 0
    while q < monoInstFe.length && q < monoInstOrig.length {
      if monoInstFe[q] == cur {
        cur = monoInstOrig[q]
        break
      }
      q = q + 1
    }
  }
  cloDeclAt[fe] = cur
  return cur
}

// The local holding the env of capturing function `fe` in the frame being emitted, or -1 when
// that frame does not declare `fe` (`envCacheFes`).
// Whether nested function `fe`'s declaration drops a cached environment where it stands.
export function irEnvCached(fe: i32): boolean {
  return envCacheFes.length > 0 && envCacheSlotOf(fe) >= 0
}

// The frame slot caching nested function `fe`'s environment, or -1 when this frame caches none.
export function envCacheSlotOfFe(fe: i32): i32 {
  return if envCacheFes.length > 0 { envCacheSlotOf(fe) } else { -1 }
}

// Drops the environment of `fe` this frame caches, if any, where its declaration runs.
export function emitEnvCacheDrop(fe: i32) {
  const ck = envCacheSlotOfFe(fe)
  if ck >= 0 {
    fbRefNull(envCacheTys[ck - envCacheBase])
    fbLocalSet(ck)
  }
  return 0
}

// Opens the build of a cached environment in slot `ck`: only when the slot is still empty.
export function emitEnvCacheOpen(ck: i32) {
  fbLocalGet(ck)
  fbRefIsNull()
  fbIf(64) // 0x40 void
  return 0
}

// Closes it: the new environment into the slot, then the slot's environment.
export function emitEnvCacheClose(ck: i32) {
  fbLocalSet(ck)
  fbEnd()
  fbLocalGet(ck)
  return 0
}

function envCacheSlotOf(fe: i32): i32 {
  let k = 0
  while k < envCacheFes.length {
    if envCacheFes[k] == fe { return envCacheBase + k }
    k = k + 1
  }
  return -1
}

// `emitClosureValueCore` for a function already checked to have a closure signature.
function emitClosureValueOf(fe: i32, fnIx: i32) {
  const envIdx = fnEnvIdxOf(fe)
  if envIdx < 0 {
    // Capture-free: the module's one constant closure of `fe`. Equality reads the identity
    // field and the (null) env, never the struct, so sharing it is unobservable from VL.
    const g = synthGlobalIdx(SYNTH_CLOSURE, fe)
    if g >= 0 {
      markFnAddrTaken(fe)
      cloDeclOf(fe)
      return fbGlobalGet(g)
    }
    fbRefNullStruct()
  } else if cloCellReaches(fe, fnIx) {
    // Every frame that reads `fe` as a value reaches one cell, so the first read fills it and
    // every later one, in any frame, is the same function value (D7700).
    if emitCloCellRef(fe, fnIx) < 0 { return -1 }
    fbStructGet(cloCellIdx, 0)
    fbRefIsNull()
    fbIf(64) // 0x40 void
    if emitCloCellRef(fe, fnIx) < 0 { return -1 }
    if emitClosureEnvOf(fe, fnIx, envIdx) < 0 { return -1 }
    emitClosureIds(fe)
    fbStructSet(cloCellIdx, 0)
    fbEnd()
    if emitCloCellRef(fe, fnIx) < 0 { return -1 }
    fbStructGet(cloCellIdx, 0)
    fbRefAsNonNull()
    return 0
  } else {
    // In the frame that declares `fe`, the env is built once per activation and kept in the
    // frame's cache slot, so two reads of the function compare equal (D7480).
    const ck = envCacheSlotOf(fe)
    if ck >= 0 { emitEnvCacheOpen(ck) }
    if emitClosureEnvOf(fe, fnIx, envIdx) < 0 { return -1 }
    if ck >= 0 { emitEnvCacheClose(ck) }
  }
  return emitClosureIds(fe)
}

// Builds a fresh env of capturing function `fe` from frame `fnIx`: one read per capture.
function emitClosureEnvOf(fe: i32, fnIx: i32, envIdx: i32) {
  const caps = captureNamesOf(fe)
  let ci = 0
  while ci < caps.length {
    if emitCaptureRead(caps[ci], fnIx) < 0 { return -1 }
    ci = ci + 1
  }
  fbStructNew(envIdx)
  return 0
}

// Completes a closure of `fe` over the env on the stack: its id and declaration, then the struct.
export function emitClosureIds(fe: i32) {
  // The one place a wasm function index becomes a closure id, so the one place the
  // address-taken set is recorded: the element section lists exactly these entries, and an
  // id no expression here produces cannot reach a `call_indirect`.
  markFnAddrTaken(fe)
  fbI32RelOf(RS_SLOT, fe, gImports + fe + relSkew(RS_SLOT))
  const decl = cloDeclOf(fe)
  fbI32RelOf(RS_SLOT, decl, gImports + decl + relSkew(RS_SLOT))
  fbStructNew(cloStructIdx)
  return 0
}

// Whether frame `fnIx` reaches `fe`'s cell: it declares `fe`, or its env carries the cell.
export function cloCellReaches(fe: i32, fnIx: i32): boolean {
  if (
    !cloCellUsed
    || fe < 0
    || fe >= cloCellTarget.length
    || cloCellTarget[fe] == 0
  ) {
    return false
  }
  if envCacheSlotOf(fe) >= 0 { return true }
  const at = fnStmtsPosOf(fnIx)
  return at >= 0 && strListHas(captureNamesOf(at), capCellName(fe))
}

// Pushes `fe`'s cell as frame `fnIx` reaches it: the frame's own slot, allocated at its first
// use in an activation, when the frame declares `fe`, else the field the frame's env carries.
function emitCloCellRef(fe: i32, fnIx: i32) {
  const ck = envCacheSlotOf(fe)
  if ck >= 0 {
    fbLocalGet(ck)
    fbRefIsNull()
    fbIf(64) // 0x40 void
    fbRefNull(cloStructIdx)
    fbStructNew(cloCellIdx)
    fbLocalSet(ck)
    fbEnd()
    fbLocalGet(ck)
    return 0
  }
  if emitCapturedRead(capCellName(fe), fnIx, -1) == 1 { return 0 }
  return emitFail(
    "emitProgram: a function-value cell is not reachable from this frame",
  )
}

// The rep recovery an env-field read owes after its `struct.get`, decided by
// `captureValKind` so the recovery cannot disagree with the field's own type. A
// `nulstr` capture must recover to non-null here; every other nullable cell
// recovers at its own use site instead.
function emitCapturedReadRecover(
  fe: i32,
  name: string,
  readIx: i32,
  fnIx: i32,
) {
  if captureValKind(fe, name) == "nulstr" {
    if nulStrReadRecovers(readIx, fnIx) { fbRefAsNonNull() }
  }
  return 0
}

// If `name` is a captured variable of the capturing function `fnIx`, read it from the env
// struct (`ref.cast` local 0 to the env, then `struct.get` the field index) and return 1;
// else return 0 for the caller's param/local/global path. `recoverIx` is the read to recover, -1
// for the env-to-env copy building a nested closure's frame, where recovering traps a null capture.
export function emitCapturedRead(name: string, fnIx: i32, recoverIx: i32) {
  const fi = captureSlotOf(name, fnIx)
  if fi < 0 { return 0 }
  const fe = fnStmtsPosOf(fnIx)
  emitCaptureSlotRead(fe, fnEnvIdxOf(fe), fi)
  if recoverIx >= 0 { emitCapturedReadRecover(fe, name, recoverIx, fnIx) }
  return 1
}

// Pushes capture `fi` of lifted function `fe`: its own parameter after the env when the
// function is lambda-lifted (SP-037), else field `fi` of the env struct.
function emitCaptureSlotRead(fe: i32, envIdx: i32, fi: i32) {
  if cloLifted(fe) {
    fbLocalGet(1 + fi)
    return 0
  }
  fbLocalGet(0)
  fbRefCast(envIdx)
  fbStructGet(envIdx, fi)
  return 0
}

// Read captured variable `name` in the enclosing frame `fnIx` for an env-struct build: a
// param/local is `local.get`, a module global `global.get`, and a transitive capture (the
// enclosing frame is itself a lifted closure re-capturing `name`) reads that frame's own
// env, so the value flows env-to-env down any nesting depth.
function emitCaptureRead(name: string, fnIx: i32) {
  const cellOf = capCellTargetOf(name)
  if cellOf >= 0 { return emitCloCellRef(cellOf, fnIx) }
  const idx = captureHomeOf(fnIx, name)
  if idx >= 0 {
    fbLocalGet(idx)
    return 0
  }
  const gIdx = globalIndexOf(name)
  if gIdx >= 0 { return emitUserGlobalGet(gIdx) }
  if emitCapturedRead(name, fnIx, -1) == 1 { return 0 }

  // capture analysis records every free identifier not bound locally, as a global or as a
  // collected function; an intrinsic is none of those, so name it rather than a variable.
  if isNumIntrinsicName(name) {
    return emitFail(
      "emitProgram: the numeric intrinsic '"
        + name
        + "' is mistaken for a captured variable here — it is not yet callable from a lambda, nor from a named function in a module that uses function values",
    )
  }
  return emitFail("emitProgram: captured variable not found in enclosing frame")
}

// ── the variant field-span invariant, enforced rather than assumed ───────────

// `uFieldStart` / `uFieldCount` are parallel to `uVariants` and slice the flat `armFieldNames`
// and `armFieldStoreTy` stores, and nothing keeps the lengths in step: a registration helper that
// pushes a variant row and then refuses one of its fields leaves a start with no count.
// `emitFail` keeps emitting, so an unguarded span read traps the compiler instead (D1152).
function guardVariantFieldSpan(vi: i32, where: string) {
  if vi >= 0 && vi < uFieldStart.length && vi < uFieldCount.length {
    const end = uFieldStart[vi] + uFieldCount[vi]
    if (
      uFieldStart[vi] >= 0
      && uFieldCount[vi] >= 0
      && end <= sFieldNames.length
      && end <= sFieldNames.length
    ) {
      return 0
    }
  }
  return emitFail(
    "emitProgram: "
      + where
      + ": union-variant "
      + i32ToStr(vi)
      + " is outside the parallel field-span tables — "
      + i32ToStr(uVariants.length)
      + " variants but "
      + i32ToStr(uFieldStart.length)
      + " field starts / "
      + i32ToStr(uFieldCount.length)
      + " field counts / "
      + i32ToStr(armFieldNames().length)
      + " field names / "
      + i32ToStr(armFieldNames().length)
      + " field types",
  )
}

// One union-variant field's value — `emitStructFieldValue`'s twin, one table over, carved out
// for the same reason: the source-order stash pass (D1510) runs exactly this lowering once per
// field. The caller's context is restored on every exit.
function emitVariantFieldValue(vi: i32, fj: i32, valIx: i32, fnIx: i32) {
  return emitVariantFieldValueUnder(vi, fj, valIx, fnIx)
}

// Whether a field stored at `k` can hold a closure: a closure slot, nullable or not, or the box.
function fieldKindTakesClosure(k: VKind): boolean {
  return k == "closure" || k == "nulclosure" || k == "union"
}

// The arm variant row `vi`'s field `fj` takes value `valIx` at, in `emitVariantFieldValueUnder`'s
// order: a refusal, a conversion, or `plain`, the value as itself.
export type VariantFieldArm = "noKind" | "lambda" | "f64" | "i64" | "f32" | "nulnone" | "box"
  | "strAtom" | "plain"
export function variantFieldArmOf(
  vi: i32,
  fj: i32,
  valIx: i32,
  fnIx: i32,
): VariantFieldArm {
  const vk = eqRowFieldKind(-1 - vi, fj)
  if vk == null { return "noKind" }
  if nodeAt(unwrapParen(valIx)) is FuncDecl && !fieldKindTakesClosure(vk) {
    return "lambda"
  }
  return match vk {
    "f64" => "f64"
    "i64" => "i64"
    "f32" => "f32"
    "nulnone" => "nulnone"
    "union" => if variantFieldIsLitUnionArray(vi, fj) { "plain" } else { "box" }
    // A literal-union atom widens to its member string here.
    "str" => if !variantFieldIsLitUnionArray(vi, fj) && exprIsLitAtom(valIx, fnIx) { "strAtom" } else { "plain" }
    "i32" | "v128" | "struct" | "list" | "reflist" | "map" | "variant" | "nulvariant" | "nulstruct" | "closure" | "nulstr" | "nulbool" | "nulclosure" | "nulmap" | "u8list" | "i64list" | "f32list" | "v128list" | "f64list" | "strlist" | "nullist" | "nulu8list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulf64list" | "nulstrlist" | "nulreflist" => "plain"
  }
}

// `emitVariantFieldValue`'s body, through the arm `variantFieldArmOf` names.
function emitVariantFieldValueUnder(vi: i32, fj: i32, valIx: i32, fnIx: i32) {
  const rc = match variantFieldArmOf(vi, fj, valIx, fnIx) {
    "noKind" => emitFail("emitProgram: union variant field has no storage kind")
    "lambda" => emitFail(
      "emitProgram: a lambda field value resolved to a non-closure variant field slot",
    )
    "f64" => emitWidened(valIx, 4, fnIx)
    "i64" => emitWidened(valIx, 3, fnIx)
    "f32" => emitWidened(valIx, 5, fnIx)
    "nulnone" => {
      if emitNulNoneForEffect(valIx, fnIx) < 0 { return -1 }
      fbRefNullNone()
    }
    "box" => emitVariantFieldBox(vi, fj, valIx, fnIx)
    "strAtom" => emitStrValue(valIx, fnIx)
    "plain" => emitExpr(valIx, fnIx)
  }
  return if rc < 0 { -1 } else { 0 }
}

// Whether variant literal `objIx` at row `vi` drops fields a wider record wrote, running each
// dropped initialiser for its effect in source order (D1696, D15093).
function variantLitDrops(objIx: i32, vi: i32, fnIx: i32): boolean {
  return objLitHasFieldOutside(objIx, uFieldStart[vi], uFieldCount[vi])
    && objLitBuildVariantRow(objIx, fnIx) == vi
    && nodeRepTyAt(objIx, fnIx) != nodeTyAt(objIx, fnIx)
}

// The variant row object literal `objIx` is built at by `emitVariantStruct`'s layout loop alone:
// its span sound, every field written, none outside the row, no stash; -1 otherwise.
export function objLitVariantLayoutOf(objIx: i32, fnIx: i32): i32 {
  return objLitVariantLayoutAt(objIx, objLitBuildVariantRow(objIx, fnIx))
}

// `objLitVariantLayoutOf` at variant row `vi`, the row a coerce builds the literal at: `vi`, or -1.
export function objLitVariantLayoutAt(objIx: i32, vi: i32): i32 {
  if vi < 0 || vi >= uFieldStart.length || vi >= uFieldCount.length {
    return -1
  }
  const start = uFieldStart[vi]
  const cnt = uFieldCount[vi]
  if start < 0 || cnt < 0 || start + cnt > sFieldNames.length { return -1 }
  if objLitHasFieldOutside(objIx, start, cnt) { return -1 }
  if objLitNeedsOrderStash(objIx, sFieldNames, start, cnt) { return -1 }
  let fj = 0
  while fj < cnt {
    if objFieldVal(objIx, sFieldNames[start + fj]) < 0 { return -1 }
    fj = fj + 1
  }
  return vi
}

// The variant row object literal `objIx` is built at by `emitVariantStruct`'s order stash: as
// `objLitVariantLayoutOf`, but its source order observable; -1 otherwise.
export function objLitVariantStashOf(objIx: i32, fnIx: i32): i32 {
  return objLitVariantStashAt(objIx, objLitBuildVariantRow(objIx, fnIx))
}

// `objLitVariantStashOf` at variant row `vi`: `vi`, or -1.
export function objLitVariantStashAt(objIx: i32, vi: i32): i32 {
  if vi < 0 || vi >= uFieldStart.length || vi >= uFieldCount.length {
    return -1
  }
  const start = uFieldStart[vi]
  const cnt = uFieldCount[vi]
  if start < 0 || cnt < 0 || start + cnt > sFieldNames.length { return -1 }
  if objLitHasFieldOutside(objIx, start, cnt) { return -1 }
  if !objLitNeedsOrderStash(objIx, sFieldNames, start, cnt) { return -1 }
  let fj = 0
  while fj < cnt {
    if objFieldVal(objIx, sFieldNames[start + fj]) < 0 { return -1 }
    fj = fj + 1
  }
  return vi
}

// After a variant literal's fields in layout order: `struct.new` of row `vi`'s heap type.
export function variantStructNewTail(vi: i32): i32 {
  fbStructNew(variantHeap(vi))
  return 0
}

function emitVariantStruct(objIx: i32, vi: i32, fnIx: i32) {
  if guardVariantFieldSpan(vi, "emitVariantStruct") < 0 { return -1 }
  if vi < 0 { return -1 }
  const start = uFieldStart[vi]
  const cnt = uFieldCount[vi]
  // D1510 — source-order evaluation, `emitObj`'s rule for the union-arm literal. A variant
  // row's fields are laid out sorted by name too, so `{ kind: "rect", w: f(), h: g() }` is
  // pushed `h, kind, w` and would run its initialisers permuted without this.
  const stash: i32[] = []
  // A literal the checker built at this arm from a wider record runs each initialiser the arm
  // drops for its effect, in source order, as `emitObj` does (D1696, D15093).
  const drops = variantLitDrops(objIx, vi, fnIx)
  // A constant dropped initialiser cannot be observed, so it is skipped (D5342).
  if drops && objLitDropsField(objIx, sFieldNames, start, cnt) {
    let pj = 0
    while pj < cnt {
      stash.push(0 - 1)
      pj = pj + 1
    }
    const pairs = objFieldSrcPairs(objIx, sFieldNames, start, cnt)
    let oi = 0
    while oi + 1 < pairs.length {
      const ofj = pairs[oi]
      const ovIx = pairs[oi + 1]
      oi = oi + 2
      if ofj < 0 {
        if emitExpr(ovIx, fnIx) < 0 { return -1 }
        fbDrop()
        continue
      }
      if emitVariantFieldValue(vi, ofj, ovIx, fnIx) < 0 { return -1 }
      const dslot = objOrderStashSlot(
        variantFieldStorageKind(vi, ofj),
        variantFieldTypeAt(vi, ofj),
        uFieldStorageSlot(vi, ofj),
      )
      stash[ofj] = dslot
      fbLocalSet(dslot)
    }
  } else if objLitNeedsOrderStash(objIx, sFieldNames, start, cnt) {
    let pj = 0
    while pj < cnt {
      stash.push(0 - 1)
      pj = pj + 1
    }
    const ord = objFieldSrcOrder(objIx, sFieldNames, start, cnt)
    let oj = 0
    while oj < ord.length {
      const ofj = ord[oj]
      const ovIx = objFieldVal(objIx, sFieldNames[start + ofj])
      if ovIx < 0 {
        return emitFail(
          "emitProgram: object literal is missing a union-variant field",
        )
      }
      if emitVariantFieldValue(vi, ofj, ovIx, fnIx) < 0 { return -1 }
      const oslot = objOrderStashSlot(
        variantFieldStorageKind(vi, ofj),
        variantFieldTypeAt(vi, ofj),
        uFieldStorageSlot(vi, ofj),
      )
      stash[ofj] = oslot
      fbLocalSet(oslot)
      oj = oj + 1
    }
  }
  let fj = 0
  while fj < cnt {
    const valIx = objFieldVal(objIx, sFieldNames[start + fj])
    if valIx < 0 && stash.length == 0 && variantFieldMayOmit(vi, fj) {
      // A field the literal leaves out holds null, as a plain struct's does, built exactly as
      // the literal `null` written there would be (D2223): the node the literal's check minted.
      const nullIx = omittedFieldNullNode(objIx, sFieldNames[start + fj])
      if nullIx < 0 { return -1 }
      if emitVariantFieldValue(vi, fj, nullIx, fnIx) < 0 { return -1 }
      fj = fj + 1
      continue
    }
    if valIx < 0 {
      return emitFail(
        "emitProgram: object literal is missing a union-variant field",
      )
    }
    if stash.length > 0 {
      fbLocalGet(stash[fj])
      fj = fj + 1
      continue
    }
    if emitVariantFieldValue(vi, fj, valIx, fnIx) < 0 { return -1 }
    fj = fj + 1
  }
  if !drops && objLitHasFieldOutside(objIx, start, cnt) {
    return emitFailAt(
      "emitProgram: object literal writes a field its union variant does not declare",
      objIx,
    )
  }
  return variantStructNewTail(vi)
}

// Whether the literal at `objIx` writes a field outside `armFieldNames[start..start+cnt)`. Such
// a literal is not this arm, whatever hint routed it to the variant builder (D2302).
function objLitHasFieldOutside(objIx: i32, start: i32, cnt: i32): boolean {
  const o = nodeAt(objIx)
  if !(o is ObjLit) { return false }
  let i = 0
  while i < o.objFields.length {
    const f = nodeAt(o.objFields[i])
    if f is FieldInit {
      let k = 0
      let found = false
      while k < cnt && !found {
        if sFieldNames[start + k] == f.fiName { found = true }
        k = k + 1
      }
      if !found { return true }
    }
    i = i + 1
  }
  return false
}

// The store-side value of variant `vi`'s field `fi`, shared by the three `emitAssign` member
// stores: a box-union field boxes the right-hand side, f64 / i64 / f32 fields re-encode it,
// and any other field emits it plainly.
function emitVariantFieldStoreVal(vi: i32, fi: i32, valIx: i32, fnIx: i32) {
  return match variantFieldStoreValueArmOf(vi, fi, valIx, fnIx) {
    "plain" => emitExpr(valIx, fnIx)
    "box" => emitVariantFieldBox(vi, fi, valIx, fnIx)
    "f64" => emitWidened(valIx, 4, fnIx)
    "i64" => emitWidened(valIx, 3, fnIx)
    "f32" => emitWidened(valIx, 5, fnIx)
    "strValue" => emitStrValue(valIx, fnIx)
    "unencodable" => fieldStorePlainMissed()
    "noKind" | "atomToStr" | "nulnone" | "armDelivery" => emitFail(
      "emitProgram: internal: a variant field store took a struct field's value arm",
    )
  }
}

// Variant `vi`'s box-union field `fi` gets `valIx`, boxed at the checker's record where it owes a
// box, else into the field's own union: a nullable niche record still stores a box there.
function emitVariantFieldBox(vi: i32, fi: i32, valIx: i32, fnIx: i32): i32 {
  return emitUnionBoxOwed(
    variantFieldElemName(vi, fi),
    variantFieldBoxTy(vi, fi),
    valIx,
    fnIx,
  )
}

// The union a box into struct row `si`'s field `fi` is planned at: the row's field type. Legacy's
// field writers and the IR's field deliver all box there.
export function structFieldBoxTy(si: i32, fi: i32): i32 {
  return sFieldRowTyAt(si, fi)
}

// The union a box into variant `vi`'s field `fi` is planned at: the field's own element union.
export function variantFieldBoxTy(vi: i32, fi: i32): i32 {
  return uFieldElemTyIxAt(vi, fi)
}

// `valIx` boxed at the checker's record where it owes a box (`boxOwedAt`), else into the site's
// union `siteNm` / `siteTy`: a nullable-niche or literal-set record still boxes there.
export function emitUnionBoxOwed(
  siteNm: string,
  siteTy: i32,
  valIx: i32,
  fnIx: i32,
): i32 {
  if boxOwedAt(valIx, fnIx) { return emitDelivered(valIx, fnIx) }
  if boxDstShadowArmed() { boxDstShadowAs(boxFloorWhy(valIx, fnIx)) }
  return emitUnionBoxArg(siteNm, siteTy, valIx, fnIx)
}

// Why a position the table serves boxes `valIx` at its own union, for the box shadow.
function boxFloorWhy(valIx: i32, fnIx: i32): string {
  if exprUnion(valIx, fnIx) { return "floor: already a box" }
  if callIsNever(unwrapParen(valIx)) { return "floor: never returns" }
  const r = boxRecordTyAt(valIx, fnIx)
  if r < 0 { return "floor: no record" }
  const k = repOfTy(r).rdKind
  if k != "union" { return "floor: rep " + (k ?? "none") }
  return "floor: no row"
}

// `valIx` stored into a field of kind `k` (null for no field): the wide scalars re-encode it,
// a string slot widens a literal-union atom to its member string, and the rest emit it plainly.
function emitScalarFieldStoreVal(valIx: i32, fnIx: i32, k: VKind | null) {
  if k == null { return emitExpr(valIx, fnIx) }
  match k {
    "f64" => {
      return emitWidened(valIx, 4, fnIx)
    }
    "i64" => {
      return emitWidened(valIx, 3, fnIx)
    }
    "f32" => {
      return emitWidened(valIx, 5, fnIx)
    }
    "str" | "nulstr" => {
      if exprIsLitAtom(valIx, fnIx) { return emitStrValue(valIx, fnIx) }
      return emitExpr(valIx, fnIx)
    }
    "i32" | "v128" | "struct" | "list" | "union" | "reflist" | "map" | "variant" | "nulvariant" | "nulstruct" | "closure" | "nulbool" | "nulclosure" | "nulmap" | "nulnone" | "u8list" | "i64list" | "f32list" | "v128list" | "f64list" | "strlist" | "nullist" | "nulu8list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulf64list" | "nulstrlist" | "nulreflist" => {
      return emitExpr(valIx, fnIx)
    }
  }
}

// Lower an object literal `{ f: v, … }` boxed into the declared union onto `body`:
// `struct.new $box (i32.const tagOf(variant)) (struct.new $variant <fields…>)`. The
// literal must match exactly one union variant's field-name set, else it fails loudly.
function emitUnionBox(objIx: i32, fnIx: i32) {
  const vi = objVariantRowCtx(objIx, fnIx)
  if vi < 0 {
    return emitFail("emitProgram: object literal matches no union variant")
  }
  return emitUnionBoxAs(objIx, vi, fnIx)
}

// The body of `emitUnionBox` with the variant already resolved — the union-context pick
// (`unionArmVariantForObj`) enters here with its own `vi`.
function emitUnionBoxAs(objIx: i32, vi: i32, fnIx: i32) {
  fbI32Rel(RS_TAG, uTags[vi])
  if emitVariantStruct(objIx, vi, fnIx) < 0 { return -1 }
  fbStructNew(uBoxIdx)
  return 0
}

// Box a struct-typed expression (an ident or call result already built as the plain
// struct `sHeapIdx[ssi]`) into union variant `vi`, whose variant struct is a layout twin
// of but a distinct heap type from it: a plain ref fails the box payload's cast, so
// rebuild the variant struct field by field from the source, then box.
function emitStructExprAsVariantBox(exprIx: i32, vi: i32, ssi: i32, fnIx: i32) {
  // The guard covers the two span tables; `uTags` and `variantHeap` are instead one row per
  // `uVariants` row, minted after the last pass that can push one. Each caller bounds `ssi`
  // its own way — `structIdxMatchesVariantIdx` here, `bssi < sHeapIdx.length` at the argument
  // boundary — so neither hands one on unchecked.
  if guardVariantFieldSpan(vi, "emitStructExprAsVariantBox") < 0 { return -1 }
  if vi < 0 { return -1 }
  const names: string[] = []
  const rows: i32[] = []
  variantRowFields(vi, names, rows)
  fbI32Rel(RS_TAG, uTags[vi])
  if (emitRecCopy(exprIx, ssi, variantHeap(vi), -1, names, rows, fnIx) < 0) {
    return -1
  }
  fbStructNew(uBoxIdx)
  return 0
}

// A fresh record at the heap `dHeap`, whose fields are `dNames` at the flat field rows `dFieldRows`, built from
// the record `exprIx` evaluates to at struct row `ssi`: field by field, each number converted
// (`i32` into `i64`). A source that cannot be re-read is evaluated once into `variantReboxSlot`.
// `dRow` is the destination's struct row, or -1 for a variant row.
function emitRecCopy(
  exprIx: i32,
  ssi: i32,
  dHeap: i32,
  dRow: i32,
  dNames: string[],
  dFieldRows: i32[],
  fnIx: i32,
): i32 {
  const held = coerceHeld
  coerceHeld = exprIx
  const r = emitRecCopyFields(exprIx, ssi, dRow, dNames, dFieldRows, fnIx)
  coerceHeld = held
  if r < 0 { return -1 }
  fbStructNew(dHeap)
  return 0
}

// What an element-by-element record copy reads through, opened per list copy and restored after.
type RcElem = {
  // The struct steps from the copied value to the record a nested copy level reads: each a heap
  // and a field index, applied after the value itself is read.
  pathHeap: i32[],
  pathField: i32[],
  // The record types the copy reads its fields at, or -1 outside one.
  src: i32,
  dst: i32,
  // The locals the copy reads its source element through (the source wrapper and the index) and
  // that list's row, or -1 outside one; and whether the element is boxed.
  sL: i32,
  iL: i32,
  wrap: i32,
  back: i32,
  boxed: boolean,
}

function rcElemNone(): RcElem {
  return {
    pathHeap: [],
    pathField: [],
    src: -1,
    dst: -1,
    sL: -1,
    iL: -1,
    wrap: -1,
    back: -1,
    boxed: false,
  }
}

let rcElem: RcElem = rcElemNone()

// The value `exprIx` a copy reads, re-read or from `variantReboxSlot`, then each step of the path.
function rcReadSource(exprIx: i32, sHeap: i32, reReadable: boolean, fnIx: i32) {
  if rcElem.sL >= 0 {
    // An element-by-element list copy reads its source element off the loop's own locals.
    fbLocalGet(rcElem.sL)
    fbStructGet(rcElem.wrap, 0)
    fbLocalGet(rcElem.iL)
    fbArrayGet(rcElem.back)
    // An element of a list of a union of records is its box's payload.
    if rcElem.boxed { fbStructGet(uBoxIdx, 1) }
    fbRefCast(sHeap)
  } else if reReadable {
    if emitExpr(exprIx, fnIx) < 0 { return -1 }
  } else {
    fbLocalGet(variantReboxSlot)
    fbRefCast(sHeap)
  }
  let k = 0
  while k < rcElem.pathHeap.length {
    fbStructGet(rcElem.pathHeap[k], rcElem.pathField[k])
    k = k + 1
  }
  return 0
}

// The destination row nested field `fj` of `dRow` is copied into, where its record is stored at
// another row than the source row `sRow`'s field `sfi`; -1 where the field is not copied apart. A
// variant destination (`dRow` -1) names the row by its checked field type `dFt`.
function rcNestedRow(
  sRow: i32,
  sfi: i32,
  dRow: i32,
  fj: i32,
  dr: i32,
  dFt: i32,
): i32 {
  if !fieldRowIsRecordRef(dr) || !sFieldIsRecordRef(sRow, sfi) { return -1 }
  const sIn = sFieldTgtStructIdx(sRow, sfi)
  const dIn = if dRow >= 0 { sFieldTgtStructIdx(dRow, fj) } else { rcRowOfTy(dFt) }
  if sIn < 0 || dIn < 0 || sIn >= sHeapIdx.length || dIn >= sHeapIdx.length {
    return -1
  }
  return if sHeapIdx[sIn] == sHeapIdx[dIn] { -1 } else { dIn }
}

// The member of the union of records the destination field `name` is, that source row `sRow`'s
// record field `sfi` is copied into (`recUnionRecMember`), or -1.
function rcUnionRecMember(
  exprIx: i32,
  pre: string,
  name: string,
  sRow: i32,
  sfi: i32,
  dr: i32,
): i32 {
  if (
    !fieldRowIsUnionBox(dr)
    || !sFieldIsRecordRef(sRow, sfi)
    || recCopyFromOf(exprIx) >= 0
  ) {
    return -1
  }
  const st = rcFieldTy(rcPathTy(rcSrcTyOf(exprIx), pre), name)
  const dt = rcFieldTy(rcPathTy(rcDstTyOf(exprIx), pre), name)
  if st < 0 || dt < 0 { return -1 }
  return recUnionRecMember(st, dt, REC_STORE_DEPTH)
}

// Copy source row `sRow`'s record field `sfi`, the field `name` along `pre`, into the union
// member `m`'s row, and box it under the member's tag.
function emitRecCopyIntoMember(
  exprIx: i32,
  sHeap: i32,
  reReadable: boolean,
  sRow: i32,
  sfi: i32,
  m: i32,
  pre: string,
  name: string,
  fnIx: i32,
): i32 {
  const vi = repVariantShapeRowOf(m)
  const vr = variantRowOf(vi)
  const sIn = sFieldTgtStructIdx(sRow, sfi)
  if (
    vi < 0
    || vi >= uTags.length
    || vr < 0
    || sIn < 0
    || sRow < 0
    || sRow >= sHeapIdx.length
  ) {
    return emitFailAt(
      "emitProgram: a record copied into a union of records has no member row",
      exprIx,
    )
  }
  const names: string[] = []
  const rows: i32[] = []
  variantRowFields(vi, names, rows)
  const st = rcFieldTy(rcPathTy(rcSrcTyOf(exprIx), pre), name)
  fbI32Rel(RS_TAG, uTags[vi])
  rcElem.pathHeap.push(sHeapIdx[sRow])
  rcElem.pathField.push(sfi)
  const ps = rcElem.src
  const pd = rcElem.dst
  rcElem.src = st
  rcElem.dst = m
  const r = emitRecCopyLevel(
    exprIx,
    sHeap,
    reReadable,
    sIn,
    vr,
    m,
    pre + name + "|",
    names,
    rows,
    fnIx,
  )
  rcElem.src = ps
  rcElem.dst = pd
  rcElem.pathHeap.pop()
  rcElem.pathField.pop()
  if r < 0 { return -1 }
  fbStructNew(variantHeap(vi))
  fbStructNew(uBoxIdx)
  return 0
}

// The struct row of the record `ty` or `ty | null`, or -1.
function rcRowOfTy(ty: i32): i32 {
  if ty < 0 { return -1 }
  const inner = nullableInnerOrNone(ty)
  const t = if inner >= 0 { inner } else { ty }
  const r = structIndexOfTy(t)
  return if r >= 0 { r } else { structRowOfAnnTy(t, t) }
}

// Whether any field of destination row `dRow` is copied at a nested row (`rcNestedRow`).
function rcHasNested(
  ssi: i32,
  dRow: i32,
  dTy: i32,
  dNames: string[],
  dFieldRows: i32[],
): boolean {
  let fj = 0
  while fj < dNames.length {
    const sfi = sFieldIndex(ssi, dNames[fj])
    const dFt = rcFieldTy(dTy, dNames[fj])
    if sfi >= 0 && rcNestedRow(ssi, sfi, dRow, fj, dFieldRows[fj], dFt) >= 0 {
      return true
    }
    fj = fj + 1
  }
  return false
}

// `emitRecCopy`'s field loop, with `exprIx` held so each read emits the record itself.
function emitRecCopyFields(
  exprIx: i32,
  ssi: i32,
  dRow: i32,
  dNames: string[],
  dFieldRows: i32[],
  fnIx: i32,
): i32 {
  if ssi < 0 || ssi >= sHeapIdx.length {
    return emitFailAt(
      "emitProgram: a record copied at its delivery has no row",
      exprIx,
    )
  }
  const sHeap = sHeapIdx[ssi]
  const dTy = recCopyTyOf(exprIx)
  const reReadable = exprReReadable(unwrapParen(exprIx))
    || (dNames.length == 1
    && !rcHasNested(ssi, dRow, dTy, dNames, dFieldRows))
  if !reReadable {
    if !fnUses.variantRebox {
      return emitFail(
        "emitProgram: a multi-field record from a call is copied with no scratch slot reserved",
      )
    }
    if emitExpr(exprIx, fnIx) < 0 { return -1 }
    fbLocalSet(variantReboxSlot)
  }
  rcElem.pathHeap = []
  rcElem.pathField = []
  return emitRecCopyLevel(
    exprIx,
    sHeap,
    reReadable,
    ssi,
    dRow,
    dTy,
    "",
    dNames,
    dFieldRows,
    fnIx,
  )
}

// One level of a copy: each field of destination `dNames`/`dFieldRows` read off source row `sRow` at
// the current path, a nested record copied by the level below it. `dTy` is this level's checked
// destination record and `pre` its field path (`j.`), which key the fields a copy unwraps.
function emitRecCopyLevel(
  exprIx: i32,
  sHeap: i32,
  reReadable: boolean,
  sRow: i32,
  dRow: i32,
  dTy: i32,
  pre: string,
  dNames: string[],
  dFieldRows: i32[],
  fnIx: i32,
): i32 {
  if sRow < 0 || sRow >= sHeapIdx.length {
    return emitFailAt(
      "emitProgram: a record copied at its delivery has no row",
      exprIx,
    )
  }
  const unwrap = recCopyUnwrapOf(exprIx)
  let fj = 0
  while fj < dNames.length {
    const sfi = sFieldIndex(sRow, dNames[fj])
    if sfi < 0 {
      return emitFailAt(
        "emitProgram: a copied record lacks a field of its destination",
        exprIx,
      )
    }
    // A `null` field holds the one value its type has; the source's field is not read (D14817).
    if fieldRowIsNulNone(dFieldRows[fj]) {
      fbRefNullNone()
      fj = fj + 1
      continue
    }
    // A `null` field copied into a `| null` the destination boxes is the union's null box.
    if (
      fieldRowIsNulNone(sFieldStart[sRow] + sfi)
      && fieldRowIsUnionBox(dFieldRows[fj])
    ) {
      fbI32Rel(RS_TAG, nullBoxTag())
      fbRefNullNone()
      fbStructNew(uBoxIdx)
      fj = fj + 1
      continue
    }
    const dFt = rcFieldTy(dTy, dNames[fj])
    const nest = rcNestedRow(sRow, sfi, dRow, fj, dFieldRows[fj], dFt)
    if nest >= 0 {
      rcElem.pathHeap.push(sHeapIdx[sRow])
      rcElem.pathField.push(sfi)
      const names: string[] = []
      const rows: i32[] = []
      let k = 0
      while k < sFieldCount[nest] {
        names.push(sFieldNames[sFieldStart[nest] + k])
        rows.push(sFieldStart[nest] + k)
        k = k + 1
      }
      const inner = nullableInnerOrNone(dFt)
      const nTy = if inner >= 0 { inner } else { dFt }
      const sIn = sFieldTgtStructIdx(sRow, sfi)
      const r = emitRecCopyLevel(
        exprIx,
        sHeap,
        reReadable,
        sIn,
        nest,
        nTy,
        pre + dNames[fj] + ".",
        names,
        rows,
        fnIx,
      )
      rcElem.pathHeap.pop()
      rcElem.pathField.pop()
      if r < 0 { return -1 }
      fbStructNew(sHeapIdx[nest])
      fj = fj + 1
      continue
    }
    // A record copied into a union of records is built at the member with its field names, then
    // boxed under that member's tag.
    const um = rcUnionRecMember(
      exprIx,
      pre,
      dNames[fj],
      sRow,
      sfi,
      dFieldRows[fj],
    )
    if um >= 0 {
      if (
        emitRecCopyIntoMember(
          exprIx,
          sHeap,
          reReadable,
          sRow,
          sfi,
          um,
          pre,
          dNames[fj],
          fnIx,
        )
        < 0
      ) {
        return -1
      }
      fj = fj + 1
      continue
    }
    // A scalar field copied into a `| null` field of the destination is boxed there (D15652).
    const wk = rcWrapKind(
      exprIx,
      pre,
      dNames[fj],
      sFieldStart[sRow] + sfi,
      dFieldRows[fj],
    )
    if wk >= 0 { fbI32Rel(RS_TAG, scalarTagOfKind(wk)) }
    if rcReadSource(exprIx, sHeap, reReadable, fnIx) < 0 { return -1 }
    fbStructGet(sHeapIdx[sRow], sfi)
    if wk >= 0 {
      const sk = fieldRowNumKind(sFieldStart[sRow] + sfi)
      const wi = rcWidenTo(sk, nullableInnerOrNone(dFt))
      if wi >= 0 && njConvert(sk, wi) < 0 { return -1 }
      if !atomIsRefKind(wk) {
        const vb = vbHeapIdxOfKind(wk)
        if vb < 0 {
          return emitFail("emitProgram: a copied field's atom has no value box")
        }
        fbStructNew(vb)
      }
      fbStructNew(uBoxIdx)
      fj = fj + 1
      continue
    }
    // A field the checker recorded as unwrapped holds its own type's value in the wide row's box
    // (`recCopyUnwrapOf`); its payload is that value (D15184).
    if strListHas(unwrap, pre + dNames[fj]) {
      const kind = if dFt >= 0 { boxTagOfTy(dFt) } else { -1 }
      if emitUnionUnboxTail(kind) < 0 { return -1 }
      fj = fj + 1
      continue
    }
    const sk = fieldRowNumKind(sFieldStart[sRow] + sfi)
    const vk = fieldRowNumKind(dFieldRows[fj])
    if sk >= 0 && vk >= 0 && sk != vk {
      if njConvert(sk, vk) < 0 { return -1 }
    }
    // A list whose elements are stored otherwise is converted element by element.
    if recCopyFromOf(exprIx) < 0 {
      const lst = nonNullTy(
        rcFieldTy(rcPathTy(rcSrcTyOf(exprIx), pre), dNames[fj]),
      )
      const ldt = nonNullTy(
        rcFieldTy(rcPathTy(rcDstTyOf(exprIx), pre), dNames[fj]),
      )
      if emitListConvTop(exprIx, lst, ldt, fnIx) < 0 { return -1 }
    }
    fj = fj + 1
  }
  return 0
}

// How many element-by-element copy loops enclose the code being emitted.
let rcLoopDepth = 0

// The source and destination records a copy of `exprIx` reads its field types off.
function rcSrcTyOf(exprIx: i32): i32 {
  return if rcElem.src >= 0 { rcElem.src } else { nodeTyIxOf(exprIx) }
}

function rcDstTyOf(exprIx: i32): i32 {
  return if rcElem.dst >= 0 { rcElem.dst } else { recCopyTyOf(exprIx) }
}

// The list of records just emitted for `exprIx`, copied element by element into the list `lct`'s
// row (`emitRecListCopyTop`); 1 where the pair is not two record lists stored apart.
function emitRecListCopy(exprIx: i32, lct: i32, fnIx: i32): i32 {
  const st = nonNullTy(nodeTyIxOf(exprIx))
  const dt = nonNullTy(instTyOrSelf(lct, fnIx))
  if !rcRecListsApart(st, dt) { return 1 }
  return emitRecListCopyTop(
    exprIx,
    st,
    dt,
    exprEmittedRefListSlot(exprIx, fnIx),
    fnIx,
  )
}

// The list `st` on the stack converted into the list `dt`, element by element where they store
// their elements apart: a list of numbers widened, a list of records copied, and a list of lists
// looped over, each element converted the same way. Nothing where they store alike.
function emitListConvTop(exprIx: i32, st: i32, dt: i32, fnIx: i32): i32 {
  const le = rcScalarListElem(st)
  const de = rcScalarListElem(dt)
  if le != null && de != null {
    if le != de { return emitScalarListWidenTop(le, de) }
    return 0
  }
  // A scalar list into a list of a `| null` or a union is boxed element by element.
  const bk = rcListBoxAtom(st, dt)
  // A string list is no scalar list, but boxes the same way under the string atom.
  let lk = le
  if le == null && bk == 2 { lk = "str" }
  // A destination with no union-box row (`(string | null)[]`) stores the source's elements as
  // they are.
  const bs = if bk >= 0 { repSlotOfKind("reflist", dt) } else { -1 }
  if lk != null && bs >= 0 {
    return emitScalarListBoxTop(lk, bk, bs, SPREAD_NUL_NONE, rcLoopDepth)
  }
  if rcRecListsApart(st, dt) {
    return emitRecListCopyTop(
      exprIx,
      st,
      dt,
      repSlotOfKind("reflist", st),
      fnIx,
    )
  }
  if st < 0 || dt < 0 || st >= T.tys.length || dt >= T.tys.length { return 0 }
  const sa = tyAt(st)
  const da = tyAt(dt)
  if !(sa is TyArray) || !(da is TyArray) { return 0 }
  const si = nonNullTy(tyElemOf(sa))
  const di = nonNullTy(tyElemOf(da))
  if si < 0 || di < 0 || !(tyAt(si) is TyArray) || !(tyAt(di) is TyArray) {
    return 0
  }
  const srcSlot = repSlotOfKind("reflist", st)
  const dstSlot = repSlotOfKind("reflist", dt)
  // One storage: nothing to convert.
  if srcSlot == dstSlot { return 0 }
  if (
    srcSlot < 0
    || dstSlot < 0
    || srcSlot >= rlWrapIdx.length
    || dstSlot >= rlWrapIdx.length
    || srcSlot >= rlBackIdx.length
    || dstSlot >= rlBackIdx.length
  ) {
    return emitFailAt(
      "emitProgram: a list of lists converted element by element has no row",
      exprIx,
    )
  }
  const srcWrap = rlWrapIdx[srcSlot]
  const srcBack = rlBackIdx[srcSlot]
  const dstWrap = rlWrapIdx[dstSlot]
  const dstBack = rlBackIdx[dstSlot]
  const sL = widenSrcWrapSlot(srcSlot)
  const dL = widenDstBackSlot(dstSlot)
  const iL = widenTmpSlot(2 * rcLoopDepth)
  const nL = widenTmpSlot(2 * rcLoopDepth + 1)
  emitCopyLoopOpen(sL, srcWrap, nL, dstBack, dL, iL)
  fbLocalGet(dL)
  fbLocalGet(iL)
  fbLocalGet(sL)
  fbStructGet(srcWrap, 0)
  fbLocalGet(iL)
  fbArrayGet(srcBack)
  fbRefAsNonNull()
  rcLoopDepth = rcLoopDepth + 1
  const r = emitListConvTop(exprIx, si, di, fnIx)
  rcLoopDepth = rcLoopDepth - 1
  if r < 0 { return -1 }
  fbArraySet(dstBack)
  emitCopyLoopClose(iL, dL, nL, dstWrap)
  return 0
}

// Whether `st` and `dt` are lists of records whose element rows differ.
function rcRecListsApart(st: i32, dt: i32): boolean {
  if st < 0 || dt < 0 || st >= T.tys.length || dt >= T.tys.length {
    return false
  }
  const sa = tyAt(st)
  const da = tyAt(dt)
  if !(sa is TyArray) || !(da is TyArray) { return false }
  const se0 = tyElemOf(sa)
  const de0 = tyElemOf(da)
  // A list of nullable records is copied as its records, each null kept (D16613).
  const nul = nullableInnerOrNone(se0) >= 0 && nullableInnerOrNone(de0) >= 0
  const se = if nul { nullableInnerOrNone(se0) } else { se0 }
  const de = if nul { nullableInnerOrNone(de0) } else { de0 }
  if se < 0 || de < 0 || !(tyAt(de) is TyObj) { return false }
  if nul && !(tyAt(se) is TyObj) { return false }
  // A list of a union of records is copied arm by arm (`emitRowUnionElemCopy`).
  if tyAt(se) is TyUnion {
    return rcRowOfTy(de) >= 0 && rcArmRows(se).length > 0
  }
  if !(tyAt(se) is TyObj) { return false }
  const ssi = rcRowOfTy(se)
  const dsi = rcRowOfTy(de)
  return ssi >= 0 && dsi >= 0 && sHeapIdx[ssi] != sHeapIdx[dsi]
}

// The variant rows of the union of records `u`, one per member in order, or empty where a member
// is not a record with a row.
function rcArmRows(u: i32): i32[] {
  const out: i32[] = []
  if u < 0 || u >= T.tys.length { return out }
  const ut = tyAt(u)
  if !(ut is TyUnion) { return out }
  for m in ut.uMembers {
    const vi = if m >= 0 && m < T.tys.length && tyAt(m) is TyObj { repVariantShapeRowOf(m) } else { -1 }
    if vi < 0 || vi >= uTags.length || variantRowOf(vi) < 0 { return [] }
    out.push(vi)
  }
  return out
}

// The list of records `st` on the stack, at ref-list slot `srcSlot`, copied into the list `dt`'s
// row: each element read off the loop's locals and copied by `emitRecCopyLevel` at the element
// types. A nested copy loop takes the next pair of temps (`rcLoopDepth`).
function emitRecListCopyTop(
  exprIx: i32,
  st: i32,
  dt: i32,
  srcSlot: i32,
  fnIx: i32,
): i32 {
  const sa = tyAt(st)
  const da = tyAt(dt)
  const se0 = if sa is TyArray { tyElemOf(sa) } else { -1 }
  const de0 = if da is TyArray { tyElemOf(da) } else { -1 }
  // A nullable element is copied as its record, a null stored as the destination's null.
  const nul = nullableInnerOrNone(se0) >= 0 && nullableInnerOrNone(de0) >= 0
  const se = if nul { nullableInnerOrNone(se0) } else { se0 }
  const de = if nul { nullableInnerOrNone(de0) } else { de0 }
  const arms = if se >= 0 && se < T.tys.length && tyAt(se) is TyUnion { rcArmRows(se) } else { [] }
  const ssi = if arms.length > 0 { variantRowOf(arms[0]) } else { rcRowOfTy(se) }
  const dsi = rcRowOfTy(de)
  const dstSlot = repSlotOfKind("reflist", dt)
  if (
    ssi < 0
    || dsi < 0
    || srcSlot < 0
    || dstSlot < 0
    || srcSlot >= rlWrapIdx.length
    || dstSlot >= rlWrapIdx.length
    || srcSlot >= rlBackIdx.length
    || dstSlot >= rlBackIdx.length
  ) {
    return emitFailAt(
      "emitProgram: a list of records copied element by element has no row",
      exprIx,
    )
  }
  const srcWrap = rlWrapIdx[srcSlot]
  const srcBack = rlBackIdx[srcSlot]
  const dstWrap = rlWrapIdx[dstSlot]
  const dstBack = rlBackIdx[dstSlot]
  const sL = widenSrcWrapSlot(srcSlot)
  const dL = widenDstBackSlot(dstSlot)
  const iL = widenTmpSlot(2 * rcLoopDepth)
  const nL = widenTmpSlot(2 * rcLoopDepth + 1)
  const names: string[] = []
  const rows: i32[] = []
  let fj = 0
  while fj < sFieldCount[dsi] {
    names.push(sFieldNames[sFieldStart[dsi] + fj])
    rows.push(sFieldStart[dsi] + fj)
    fj = fj + 1
  }
  emitCopyLoopOpen(sL, srcWrap, nL, dstBack, dL, iL)
  fbLocalGet(dL)
  fbLocalGet(iL)
  if nul {
    fbLocalGet(sL)
    fbStructGet(srcWrap, 0)
    fbLocalGet(iL)
    fbArrayGet(srcBack)
    fbRefIsNull()
    fbIfRefNul(sHeapIdx[dsi], true)
    fbRefNull(sHeapIdx[dsi])
    fbElse()
  }
  const was = rcElem
  rcElem = rcElemNone()
  rcElem.src = se
  rcElem.dst = de
  rcElem.sL = sL
  rcElem.iL = iL
  rcElem.wrap = srcWrap
  rcElem.back = srcBack
  rcElem.boxed = was.boxed
  rcLoopDepth = rcLoopDepth + 1
  const r = if arms.length > 0 { emitRowUnionElemCopy(exprIx, arms, se, dsi, de, names, rows, fnIx) } else { emitRecCopyLevel(
    exprIx,
    sHeapIdx[ssi],
    false,
    ssi,
    dsi,
    de,
    "",
    names,
    rows,
    fnIx,
  ) }
  rcLoopDepth = rcLoopDepth - 1
  rcElem = was
  if r < 0 { return -1 }
  if arms.length == 0 { fbStructNew(sHeapIdx[dsi]) }
  if nul { fbEnd() }
  fbArraySet(dstBack)
  emitCopyLoopClose(iL, dL, nL, dstWrap)
  return 0
}

// One element of a list of a union of records, read off the copy loop's locals, built at row
// `dsi`: the arm its box's tag names is copied at that arm's row, the last arm untested.
function emitRowUnionElemCopy(
  exprIx: i32,
  arms: i32[],
  se: i32,
  dsi: i32,
  de: i32,
  names: string[],
  rows: i32[],
  fnIx: i32,
): i32 {
  const ut = tyAt(se)
  if (
    !(ut is TyUnion)
    || ut.uMembers.length != arms.length
    || dsi < 0
    || dsi >= sHeapIdx.length
  ) {
    return emitFailAt(
      "emitProgram: a list of a union of records copied element by element has no arm rows",
      exprIx,
    )
  }
  const pb = rcElem.boxed
  rcElem.boxed = true
  let k = 0
  while k < arms.length {
    const last = k == arms.length - 1
    if !last {
      fbLocalGet(rcElem.sL)
      fbStructGet(rcElem.wrap, 0)
      fbLocalGet(rcElem.iL)
      fbArrayGet(rcElem.back)
      fbStructGet(uBoxIdx, 0)
      fbI32Rel(RS_TAG, uTags[arms[k]])
      fbI32Bin(70) // i32.eq
      fbIfRef(sHeapIdx[dsi])
    }
    const vr = variantRowOf(arms[k])
    rcElem.src = ut.uMembers[k]
    const r = emitRecCopyLevel(
      exprIx,
      variantHeap(arms[k]),
      false,
      vr,
      dsi,
      de,
      "",
      names,
      rows,
      fnIx,
    )
    if r < 0 {
      rcElem.boxed = pb
      return -1
    }
    fbStructNew(sHeapIdx[dsi])
    if !last { fbElse() }
    k = k + 1
  }
  k = 0
  while k < arms.length - 1 {
    fbEnd()
    k = k + 1
  }
  rcElem.src = se
  rcElem.boxed = pb
  return 0
}

// The element kind of the list of numbers `ty`, or null.
function rcScalarListElem(ty: i32): VKind | null {
  if ty < 0 { return null }
  const ld = repOfTy(ty)
  if ld.rdKind == null { return null }
  return scalarListElemOfListKind(ld.rdKind)
}

// The atom kind a top-level copy boxes field `name` under: the source row `sr` holds a scalar where
// the destination row `dr`'s union box holds it, or a number it widens to, or `null`; else -1.
function rcWrapKind(
  exprIx: i32,
  pre: string,
  name: string,
  sr: i32,
  dr: i32,
): i32 {
  if !fieldRowIsUnionBox(dr) || recCopyFromOf(exprIx) >= 0 { return -1 }
  if fieldRowNumKind(sr) < 0 && !fieldRowIsStr(sr, false) { return -1 }
  const st = rcFieldTy(rcPathTy(rcSrcTyOf(exprIx), pre), name)
  const dt = rcFieldTy(rcPathTy(rcDstTyOf(exprIx), pre), name)
  if st < 0 || dt < 0 { return -1 }
  const inner = nullableInnerOrNone(dt)
  if inner >= 0 && tySame(st, inner) { return boxTagOfTy(st) }
  // A number the nullable holds wider is converted there first (`rcWidenTo`).
  if inner >= 0 && rcWidenTo(fieldRowNumKind(sr), inner) >= 0 {
    return boxTagOfTy(inner)
  }
  // A union listing the scalar holds it in the same box.
  const d = tyAt(dt)
  if d is TyUnion {
    for m in d.uMembers {
      if tySame(m, st) { return boxTagOfTy(st) }
    }
  }
  return -1
}

// The numeric kind a source field of number kind `sk` is converted to for the nullable number
// `inner`, where that is an exact widening (`i32` into `i64` or `f64`, `i64` or `f32` into `f64`),
// else -1.
function rcWidenTo(sk: i32, inner: i32): i32 {
  const p = if inner >= 0 && inner < T.tys.length { tyAt(inner) } else { tyAt(TY_ERR) }
  if sk < 0 { return -1 }
  if p is TyPrim {
    const at = strListIndexOf(RC_WIDENS, i32ToStr(sk) + ">" + p.primName)
    if at >= 0 && at < RC_WIDEN_KINDS.length { return RC_WIDEN_KINDS[at] }
  }
  return -1
}

// The exact widenings `rcWidenTo` converts, keyed by source kind and destination name, and the
// kind each converts to.
const RC_WIDENS = ["0>i64", "0>f64", "3>f64", "5>f64"]
const RC_WIDEN_KINDS = [3, 4, 4, 4]

// The record at field path `pre` (`j.k.`) under the record `ty`, each step's `| null` peeled; -1
// where a step names no record field.
function rcPathTy(ty: i32, pre: string): i32 {
  let t = ty
  let from = 0
  // A path into a union member restarts at the member (`emitRecCopyIntoMember`).
  let i = 0
  while i < pre.length {
    if pre[i] == 124 { from = i + 1 }
    i = i + 1
  }
  i = from
  while i < pre.length {
    if pre[i] == 46 {
      const f = rcFieldTy(t, pre.slice(from, i))
      if f < 0 { return -1 }
      const inner = nullableInnerOrNone(f)
      t = if inner >= 0 { inner } else { f }
      from = i + 1
    }
    i = i + 1
  }
  return t
}

// The type of field `name` of the checked record `dTy`, or -1.
function rcFieldTy(dTy: i32, name: string): i32 {
  const d = if dTy >= 0 && dTy < T.tys.length { tyAt(dTy) } else { tyAt(TY_ERR) }
  if !(d is TyObj) { return -1 }
  return objFieldType(d, name)
}

// `emitExpr` for a value whose delivery copies it into the row `row` names (`recCopyRowAt`).
function emitRecCopyInto(exprIx: i32, row: i32, fnIx: i32): i32 {
  const names: string[] = []
  const rows: i32[] = []
  // A call copied back to its own record is read at the row its function builds it at.
  const from = recCopyFromOf(exprIx)
  let ssi = if from >= 0 { structIndexOfTy(from) } else { structIndexOfExpr(exprIx, fnIx) }
  if ssi < 0 && from < 0 { ssi = copyArmRowOf(exprIx) }
  if row <= -2 {
    const vi = -2 - row
    if guardVariantFieldSpan(vi, "emitRecCopyInto") < 0 { return -1 }
    variantRowFields(vi, names, rows)
    return emitRecCopy(exprIx, ssi, variantHeap(vi), -1, names, rows, fnIx)
  }
  if (
    row < 0
    || row >= sHeapIdx.length
    || row >= sFieldCount.length
    || row >= sFieldStart.length
  ) {
    return emitFailAt(
      "emitProgram: a record copied at its delivery has no row",
      exprIx,
    )
  }
  let fj = 0
  while fj < sFieldCount[row] {
    names.push(sFieldNames[sFieldStart[row] + fj])
    rows.push(sFieldStart[row] + fj)
    fj = fj + 1
  }
  return emitRecCopy(exprIx, ssi, sHeapIdx[row], row, names, rows, fnIx)
}

// Pushes variant row `vi`'s field names and flat field rows onto `names` and `rows`, in layout order.
function variantRowFields(vi: i32, names: string[], rows: i32[]) {
  let fj = 0
  while fj < uFieldCount[vi] {
    names.push(sFieldNames[uFieldStart[vi] + fj])
    rows.push(uFieldStart[vi] + fj)
    fj = fj + 1
  }
  return 0
}

// Whether print's argument `ax` is a union box that the scalar ladder would print as its tag:
// a call's result, or a name whose slot is the box and no narrowing unboxes.
function printArgIsUnclassifiedBox(ax: i32, fnIx: i32): boolean {
  if !exprUnion(ax, fnIx) { return false }
  const ax0 = unwrapParen(ax)
  if ax0 < 0 { return false }
  if nodeAt(ax0) is Call { return true }
  return printArgIsBoxName(ax0, fnIx)
}

// Whether `ix` names a slot holding a union box that no narrowing unboxes to one type: a partial
// narrowing (the `else` of `is string` over `i32 | R | string`) still leaves the box.
function printArgIsBoxName(ix: i32, fnIx: i32): boolean {
  const n = nodeAt(ix)
  if n is Ident {
    return narrowedArmTyOf(ix, fnIx) < 0 && identSlotIsUnionBox(fnIx, ix)
  }
  return false
}

// The one type the checker narrowed the read `ix` to, or -1 when it is not narrowed or is
// narrowed to a union or a nullable, which the box still holds.
function narrowedArmTyOf(ix: i32, fnIx: i32): i32 {
  const t = readNarrowedTyAt(ix, fnIx)
  if t < 0 || tyIsUnionShaped(t) || tyAt(t) is TyNullable { return -1 }
  return t
}

// `recv == <numeric literal>` onto `body`, leaving a 0/1 i32 — the scalar value test shared
// by the bare-literal `is` spelling and the numeric-litunion membership ladder. The compare's
// width is the receiver's own; a float receiver compares by value, the literal converted to its
// type (D3689), and a receiver of any other type, or an `i32` it does not fit, never holds it.
function emitNumLitEq(recvIx: i32, lv: string, fnIx: i32) {
  if emitExpr(recvIx, fnIx) < 0 { return -1 }
  const w = exprScalarWidth(recvIx, fnIx)
  if w == "i64" {
    const pr = parseI64Pair(lv)
    fbI64Const(pr[0], pr[1])
    fbI32Bin(81)
    return 0
  }
  if w == "i32" && numLexFitsI32(lv) {
    fbI32Const(parseI32(lv))
    fbI32Bin(70)
    return 0
  }
  if w == "f64" {
    fbF64Const(lv)
    fbI32Bin(97) // 0x61 f64.eq
    return 0
  }
  if w == "f32" {
    fbF32Const(lv)
    fbI32Bin(91) // 0x5b f32.eq
    return 0
  }
  fbDrop()
  fbI32Const(0)
  return 0
}

// A fresh lazy-frame slot holding a receiver of base `base`, an integer or a float.
function numLitOnceSlot(base: string): i32 {
  if base == "i64" { return listElemStashSlot("i64list", 0) }
  if base == "f64" { return listElemStashSlot("f64list", 0) }
  if base == "f32" { return listElemStashSlot("f32list", 0) }
  return strI32Slot()
}

// Compares the `base` value on the stack, an integer or a float, with the literal `lv`.
function emitNumLitConstEq(base: string, lv: string) {
  if base == "f64" {
    fbF64Const(lv)
    fbI32Bin(97) // 0x61 f64.eq
    return 0
  }
  if base == "f32" {
    fbF32Const(lv)
    fbI32Bin(91) // 0x5b f32.eq
    return 0
  }
  if base == "i64" {
    const pr = parseI64Pair(lv)
    fbI64Const(pr[0], pr[1])
    fbI32Bin(81) // 0x51 i64.eq
    return 0
  }
  fbI32Const(parseI32(lv))
  fbI32Bin(70) // 0x46 i32.eq
  return 0
}

// Lower a dead null test to its constant: the operand runs for its effects unless it is a
// bare name, and is never read as nullable (DECISIONS.md, the dead null test).
function emitDeadNullTest(opIx: i32, isNe: boolean, fnIx: i32) {
  if !(nodeAt(opIx) is Ident) {
    if emitExpr(opIx, fnIx) < 0 { return -1 }
    fbDrop()
  }
  if isNe { fbI32Const(1) } else { fbI32Const(0) }
  return 0
}

// After a `boolean | null`'s i32: its null is the sentinel 2. Returns 1, the ladder's "claimed".
export function nulTestBoolTail(invert: boolean): i32 {
  fbI32Const(2)
  if invert { fbI32Bin(71) } else { fbI32Bin(70) }
  return 1
}

// After a `K | null` value: its compare with the sentinel below every atom id, `i32.ne` for
// `invert`. Returns 1, the ladder's "claimed".
export function nulTestAtomTail(invert: boolean): i32 {
  fbI32Const(-1)
  if invert { fbI32Bin(71) } else { fbI32Bin(70) }
  return 1
}

// The null test for a nullable value — `x == null`/`x != null` and the `x is null`/`x is
// <member>` guard ask the same question of the same rep. Leaves a 0/1 i32 (1 = null unless
// `invert`); 0 means no arm claims the rep. `nicheOnly` restricts to single-non-null-member
// reps (a box or optional chain has several, so "not null" cannot identify one).
function emitNulIsNullTest(
  refIx: i32,
  fnIx: i32,
  invert: boolean,
  nicheOnly: boolean,
) {
  const arm = nulTestArmOf(refIx, fnIx, invert, nicheOnly)
  if arm == "nnfold" {
    if invert { fbI32Const(1) } else { fbI32Const(0) }
    return 1
  }
  if arm == "nulfold" {
    if invert { fbI32Const(0) } else { fbI32Const(1) }
    return 1
  }
  if arm == "nullty" {
    if emitDeadNullTest(refIx, !invert, fnIx) < 0 { return -1 }
    return 1
  }
  if arm == "bool" {
    if emitExpr(refIx, fnIx) < 0 { return -1 }
    return nulTestBoolTail(invert)
  }
  if arm == "atom" {
    if emitExpr(refIx, fnIx) < 0 { return -1 }
    return nulTestAtomTail(invert)
  }
  if arm == "optChain" {
    const ncSv = optRecvStageSave()
    optRecvStageMark(refIx)
    if emitOptChainIsNull(refIx, fnIx) < 0 { return -1 }
    optRecvStageRestore(ncSv)
    if invert { fbI32Eqz() }
    return 1
  }
  if arm == "mapHas" {
    const mnRef = nodeAt(unwrapParen(refIx))
    if mnRef is Index {
      if emitMapHas(mnRef.idxArr, mnRef.idxIndex, fnIx) < 0 { return -1 }
      if !invert { fbI32Eqz() }
      return 1
    }
    return emitFail(
      "emitProgram: internal: a map null test whose operand is no index read",
    )
  }
  if arm == "boxTag" {
    if emitExpr(refIx, fnIx) < 0 { return -1 }
    return nulTestBoxTagTail(invert)
  }
  if arm == "nullRef" || arm == "nulStr" {
    if emitExpr(refIx, fnIx) < 0 { return -1 }
    return nulTestRefTail(invert)
  }
  if arm == "instMap" { return emitInstMapReadIsNull(refIx, fnIx, invert) }
  // A niche-only test of no niche is no claim.
  if arm == "none" { return 0 }
  return emitFail("emitProgram: internal: a null test arm with no lowering")
}

// After a union box: its tag compared with `null`'s, `i32.ne` for `invert`. Returns 1.
export function nulTestBoxTagTail(invert: boolean): i32 {
  fbStructGet(uBoxIdx, 0)
  fbI32Rel(RS_TAG, nullBoxTag())
  if invert { fbI32Bin(71) } else { fbI32Bin(70) }
  return 1
}

// After a nullable ref's raw value: `ref.is_null`, then `i32.eqz` for `invert`. Returns 1, the
// ladder's "claimed".
export function nulTestRefTail(invert: boolean): i32 {
  fbRefIsNull()
  if invert { fbI32Eqz() }
  return 1
}

// The null test of a map read `m[k]` / `m.get(k)` whose instance pins the map's value to a
// scalar, which reads unboxed there: the probe's miss is the null. 0 when not this shape.
function emitInstMapReadIsNull(refIx: i32, fnIx: i32, invert: boolean) {
  const rk = instMapIsNullReadOf(refIx, fnIx)
  if rk.length != 2 { return 0 }
  if emitMapHas(rk[0], rk[1], fnIx) < 0 { return -1 }
  if !invert { fbI32Eqz() }
  return 1
}

// The receiver and key of `emitInstMapReadIsNull`'s map read `refIx`, or `[]` when it is not that
// shape: a scalar-pinned map, read by index or `.get`, whose value type bears no stored `null`.
function instMapIsNullReadOf(refIx: i32, fnIx: i32): i32[] {
  const r = nodeAt(unwrapParen(refIx))
  let recvIx = -1
  let keyIx = -1
  if r is Index {
    recvIx = r.idxArr
    keyIx = r.idxIndex
  } else if r is Call {
    if r.callFn < 0 || r.callArgs.length != 1 { return [] }
    const callee = nodeAt(r.callFn)
    if callee is Member {
      if callee.memProp == "get" {
        recvIx = callee.memObj
        keyIx = r.callArgs[0]
      }
    }
  }
  if recvIx < 0 || !exprMap(recvIx, fnIx) { return [] }
  if mapRecvScalarKindInst(recvIx, fnIx) < 0 { return [] }
  // A stored `null` is a hit the probe cannot tell from a value.
  if tyBearsNull(tyMapValOf(mapRecvTyIn(recvIx, fnIx))) { return [] }
  return [recvIx, keyIx]
}

// True when `recvIx`'s storage is the `string | null` niche and it is still nullable here:
// `nodeTyIsNullable` disagreeing with the declaration-scoped `exprNullableString` is the
// `!= null` narrowing signal. A read typed at a type parameter carries no such bank, so it
// takes the guarded compare (D3332).
function litMemberRecvIsNulString(recvIx: i32, fnIx: i32) {
  return exprNullableString(recvIx, fnIx)
    && (nodeTyIsNullable(recvIx) || nodeTyHasTyVar(unwrapParen(recvIx)))
}

// `<string | null> is "<m>"` over a null receiver answers false — not an impossibility to
// `ref.as_non_null` away. Read the receiver once as the raw nullable ref; `br_on_null`
// (which consumes it) decides between the string compare and a const 0, mirroring
// `emitPrintNulString`'s block shape rather than the coalesce's.
function emitNulStrLitEq(recvIx: i32, lex: string, fnIx: i32) {
  nulStrMemberOpen()
  if emitExpr(recvIx, fnIx) < 0 { return -1 }
  nulStrMemberGuard()
  if strMemberEqTail(lex, fnIx) < 0 { return -1 }
  return nulStrMemberClose()
}

// Before a `string | null` receiver compared with a member: the result block and the null's.
export function nulStrMemberOpen() {
  fbBlock(127)
  fbBlock(64)
}

// After the receiver: a null leaves for the null's block, else the string stays for the compare.
export function nulStrMemberGuard() { fbBrOnNull(0) }

// After the member compare: the compare's result, else the null's 0.
export function nulStrMemberClose() {
  fbBr(1)
  fbEnd()
  fbI32Const(0)
  fbEnd()
  return 0
}

// Compares the string on the stack with member literal `lex`, a quoted lexeme, leaving 0/1.
export function strMemberEqTail(lex: string, fnIx: i32) {
  const lit = mkStr(lex, -1)
  const f = strEqLitForm(lit)
  strEqLitHead(lit, f)
  if f == 0 || f == 3 {
    if emitStrLitAt(lit, fnIx) < 0 { return -1 }
  }
  return strEqLitTail(f)
}

// The shape `emitLitMemberEq` compares receiver `recvIx` with member `lex` in: a value-union box's
// tag-gated payload, a nullable string's guarded compare, a string's, or a number's.
export type LitMemberEqArm = "union" | "nulStr" | "str" | "num"

export function litMemberEqArmOf(
  recvIx: i32,
  lex: string,
  fnIx: i32,
): LitMemberEqArm {
  if exprUnion(recvIx, fnIx) { return "union" }
  if !nameIsQuotedLeaf(lex) { return "num" }
  return if litMemberRecvIsNulString(recvIx, fnIx) { "nulStr" } else { "str" }
}

// One member-literal test `recv == <lex>`, in whichever shape the receiver's rep demands:
// the tag-gated payload compare over a value-union box, the null-guarded string compare
// over a `string | null` niche, plain string equality over a string ref, else the numeric
// compare. One home because the bare-literal `is` and the litunion ladder must agree.
function emitLitMemberEq(recvIx: i32, lex: string, fnIx: i32) {
  return match litMemberEqArmOf(recvIx, lex, fnIx) {
    "union" => emitUnionLitIs(recvIx, lex, fnIx)
    "nulStr" => emitNulStrLitEq(recvIx, lex, fnIx)
    "str" => if emitExpr(recvIx, fnIx) < 0 { -1 } else { strMemberEqTail(lex, fnIx) }
    "num" => emitNumLitEq(recvIx, lex, fnIx)
  }
}

// shared refusal text: the membership ladder's own place bound and the box-tag compare's
// litunion guard are the same underlying refusal, so both callers say the same thing.
function emitFailNoMembershipRecv() {
  return emitFail(
    "emitProgram: `is` over a literal union needs a re-readable receiver (each member re-reads it; a call / optional-chain receiver has no membership lowering)",
  )
}

// `<recv>.<field fi of arm vi> == <lex>`, leaving an i32 — the one comparison D1023's
// membership chain is built from, reading the discriminant off the union box. The read is the
// narrow's own three steps, sound here for the reason the tag test that precedes it is: this
// runs only inside the `tag == …` conjunction, so the payload is the arm's struct.

// The compare is picked by the field's storage, not by the lexeme's looks. A string literal
// set has two reps — the interned i32 atom when the field's annotation is a registered alias,
// a `(ref $string)` when it is inline — and the lexeme is `"circle"` either way. The code
// column is what makes the answer independent of the arm's spelling.
function emitDiscrimFieldEq(
  recvIx: i32,
  vi: i32,
  fi: i32,
  lex: string,
  fnIx: i32,
) {
  if vi < 0 || vi >= uVarRow.length {
    return emitFail(
      "emitProgram: discriminant test on an arm with no heap type",
    )
  }
  if guardVariantFieldSpan(vi, "emitDiscrimFieldEq") < 0 { return -1 }
  // The FIELD index is the second half of the same read, and it arrives from a caller's
  // loop rather than from the table — bound it here so the row this reads is provably
  // inside the arm's own span, not merely inside the flat store.
  if fi < 0 || fi >= uFieldCount[vi] {
    return emitFail(
      "emitProgram: emitDiscrimFieldEq: field "
        + i32ToStr(fi)
        + " is outside union-variant "
        + i32ToStr(vi)
        + "'s "
        + i32ToStr(uFieldCount[vi])
        + " fields",
    )
  }
  if emitExpr(recvIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1)
  fbRefCast(variantHeap(vi))
  fbStructGet(variantHeap(vi), fi)
  return emitFieldLitEq(uFieldStart[vi] + fi, lex, fnIx)
}

// Compares the field value on the stack, stored at flat field row `r`, with the literal `lex`.
function emitFieldLitEq(r: i32, lex: string, fnIx: i32) {
  const nk = fieldRowNumKind(r)
  if fieldRowIsStr(r, false) || fieldRowIsStr(r, true) {
    return emitStrEqLit(mkStr(lex, -1), fnIx)
  }
  if nk == 0 {
    // The i32 slot serves both the interned string ATOM and a small numeric literal; the
    // quotes are what part them, exactly as they do in `emitLitMemberEq`.
    if nameIsQuotedLeaf(lex) {
      fbI32Rel(RS_ATOM, internAtom(lex))
    } else {
      fbI32Const(parseI32(lex))
    }
    fbI32Bin(70) // 0x46 i32.eq
    return 0
  }
  if nk == 4 {
    fbF64Const(lex)
    fbI32Bin(97) // 0x61 f64.eq
    return 0
  }
  if nk == 3 {
    const pr = parseI64Pair(lex)
    fbI64Const(pr[0], pr[1])
    fbI32Bin(81) // 0x51 i64.eq
    return 0
  }
  return emitFail(
    "emitProgram: a discriminant field of this storage has no membership compare",
  )
}

// `r is B` over a single record `r: A` or `A | null` where every `B` is an `A` but not the
// reverse: the value fits when it is not null and each field `B` narrows holds a member of its
// literal set, or an arm of its type (D3885, D4058, D16325). 0 when the test is not that shape.
function emitRecordFitIs(isIx: i32, fnIx: i32): i32 {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) { return 0 }
  const recv = nd.isObj
  const objTy = nodeTyAt(recv, fnIx)
  const names: string[] = []
  const sets: i32[] = []
  const shape = recFitNarrowedFields(objTy, isVarTyIxOf(isIx), names, sets)
  if shape < 0 { return 0 }
  if names.length == 0 {
    return emitFail(
      "emitProgram: `is` over a record reached its field test with no field narrowed",
    )
  }
  // A receiver that is not a re-readable place (a call) is evaluated once into the `?.` stash.
  const staged = !unionEqOperandOk(recv)
  if staged && !fnUses.optRecv {
    return emitFailAt("emitProgram: `is` receiver stash not reserved", recv)
  }
  const si = structIndexOfExpr(recv, fnIx)
  const vi = if si >= 0 { -1 } else { exprVariantIndex(recv, fnIx) }
  // The instance's type decides: a generic receiver handed `A | null` is nullable there.
  const nullable = nodeTyIsNullable(recv) || tyAdmitsNull(objTy)
  if nullable && !exprNullableRefNiche(recv, fnIx) {
    return emitFail(
      "emitProgram: `is` over a nullable record that is not a nullable reference",
    )
  }
  if staged {
    if emitExpr(recv, fnIx) < 0 { return -1 }
    fbLocalSet(optRecvSlot)
  }
  const src = if staged { optRecvSlot } else { -1 }
  return emitRecordFitCore(recv, src, si, vi, nullable, names, sets, fnIx)
}

// `emitRecordFitIs`'s field tests over the record `recv` reads (or local `src`, when not -1),
// laid out as struct `si` or variant `vi`; `names` and `sets` are its narrowed fields.
function emitRecordFitCore(
  recv: i32,
  src: i32,
  si: i32,
  vi: i32,
  nullable: boolean,
  names: string[],
  sets: i32[],
  fnIx: i32,
): i32 {
  const staged = src >= 0
  let heap = -1
  const rows: i32[] = []
  const fis: i32[] = []
  if si >= 0 && si < sHeapIdx.length {
    heap = sHeapIdx[si]
    for f in names {
      const fi = sFieldIndex(si, f)
      fis.push(fi)
      rows.push(if fi >= 0 { sFieldStart[si] + fi } else { -1 })
    }
  } else if vi >= 0 && vi < uVarRow.length {
    heap = variantHeap(vi)
    for f in names {
      const fi = variantFieldIndex(vi, f)
      fis.push(fi)
      rows.push(if fi >= 0 { uFieldStart[vi] + fi } else { -1 })
    }
  }
  let laidOut = heap >= 0
  for fi in fis {
    if fi < 0 { laidOut = false }
  }
  if !laidOut {
    return emitFail("emitProgram: `is` over a record whose layout is not known")
  }
  // A field narrowed to a type rather than a literal set is tested by its box's arm tags.
  const fieldTags: i32[][] = []
  // A field narrowed to a record type is tested field by field (`emitRecordValueFits`).
  const fieldNested: boolean[] = []
  let fk = 0
  while fk < names.length {
    const k = fk
    fk = fk + 1
    const ft: i32[] = []
    const nested = rows[k] >= 0
      && fieldRowIsRecordRef(rows[k])
      && tyAt(sets[k]) is TyObj
    fieldNested.push(nested)
    if !nested && tyLitSetMemberLexes(sets[k]).length == 0 {
      const vis: i32[] = []
      if (
        !fieldRowIsUnionBox(rows[k])
        || !unionArmTagsOfTy(sets[k], -1, ft, vis)
        || listNeedsDiscrim(vis)
      ) {
        return emitFail(
          "emitProgram: `is` over a record tests a field narrowed to a type its storage holds no tag for",
        )
      }
    }
    fieldTags.push(ft)
  }
  if nullable {
    if emitRecordFitRecv(recv, fnIx, src, -1) < 0 { return -1 }
    fbRefIsNull()
    fbIf(127)
    fbI32Const(0)
    fbElse()
  }
  let k = 0
  while k < names.length {
    if fieldNested[k] {
      const nsi = if si >= 0 { sFieldTgtStructIdx(si, fis[k]) } else { sFieldTgtStructIdx(variantRowOf(vi), fis[k]) }
      const nslot = objOrderStashSlot(
        "nulstruct",
        FC_STRUCT,
        if si >= 0 { sFieldStorageSlot(si, fis[k]) } else { uFieldStorageSlot(vi, fis[k]) },
      )
      if emitRecordFitRecv(recv, fnIx, src, heap) < 0 { return -1 }
      if nullable && !staged { fbRefAsNonNull() }
      fbStructGet(heap, fis[k])
      fbLocalSet(nslot)
      if emitRecordValueFits(nsi, nslot, sets[k], fnIx) < 0 { return -1 }
      if k > 0 {
        fbI32Bin(113) // i32.and
      }
      k = k + 1
      continue
    }
    if fieldTags[k].length > 0 {
      // The box ref itself may stand for `null`; a null held in the box is its own arm's tag.
      if emitRecordFitRecv(recv, fnIx, src, heap) < 0 { return -1 }
      if nullable && !staged { fbRefAsNonNull() }
      fbStructGet(heap, fis[k])
      fbRefIsNull()
      fbIf(127)
      fbI32Const(if tyAdmitsNull(sets[k]) { 1 } else { 0 })
      fbElse()
      let ti = 0
      while ti < fieldTags[k].length {
        if emitRecordFitRecv(recv, fnIx, src, heap) < 0 { return -1 }
        if nullable && !staged { fbRefAsNonNull() }
        fbStructGet(heap, fis[k])
        fbRefAsNonNull()
        fbStructGet(uBoxIdx, 0)
        fbI32Rel(RS_TAG, fieldTags[k][ti])
        fbI32Bin(70) // i32.eq
        if ti > 0 {
          fbI32Bin(114) // i32.or
        }
        ti = ti + 1
      }
      fbEnd()
      if k > 0 {
        fbI32Bin(113) // i32.and
      }
      k = k + 1
      continue
    }
    // A nullable string field answers its null apart, then compares only non-null strings.
    const nulStr = fieldRowIsStr(rows[k], true)
    const lexes = tyLitSetMemberLexes(
      if nulStr { nonNullTy(sets[k]) } else { sets[k] },
    )
    if nulStr {
      if emitRecordFitRecv(recv, fnIx, src, heap) < 0 { return -1 }
      if nullable && !staged { fbRefAsNonNull() }
      fbStructGet(heap, fis[k])
      fbRefIsNull()
      fbIf(127)
      fbI32Const(if nonNullTy(sets[k]) != sets[k] { 1 } else { 0 })
      fbElse()
      if lexes.length == 0 { fbI32Const(0) }
    }
    let li = 0
    while li < lexes.length {
      if emitRecordFitRecv(recv, fnIx, src, heap) < 0 { return -1 }
      if nullable && !staged { fbRefAsNonNull() }
      fbStructGet(heap, fis[k])
      if nulStr { fbRefAsNonNull() }
      if emitFieldLitEq(rows[k], lexes[li], fnIx) < 0 { return -1 }
      if li > 0 {
        fbI32Bin(114) // i32.or
      }
      li = li + 1
    }
    if nulStr { fbEnd() }
    if k > 0 {
      fbI32Bin(113) // i32.and
    }
    k = k + 1
  }
  if nullable { fbEnd() }
  return 1
}

// Whether any variant row of `vis` shares its tag with a twin that only a field value parts.
function listNeedsDiscrim(vis: i32[]): boolean {
  for vi in vis {
    if vi >= 0 && vi < uFieldCount.length {
      let fp = 0
      while fp < uFieldCount[vi] {
        if variantDiscrimFieldNeeded(vi, fp) { return true }
        fp = fp + 1
      }
    }
  }
  return false
}

// `xs is L[]` over a list whose elements are a wider type than the literal set `L`: true when
// every element, at every nesting depth, is a member of `L`, so an empty list fits (D4771,
// extending D3885). 0 when the test is not that shape, 1 when emitted, -1 when refused.
function emitListFitIs(isIx: i32, fnIx: i32): i32 {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) { return 0 }
  return emitListFitAt(nd.isObj, isVarTyIxOf(isIx), isIx, -1, fnIx)
}

// The fit test of list `recv` against `chk`, leaving 1 or 0, with `recv` read from scratch
// slot `stash` when it is one, else emitted. 0 when the test is not that shape, 1 when
// emitted, -1 when refused at `anchor`.
function emitListFitAt(
  recv: i32,
  chk: i32,
  anchor: i32,
  stash: i32,
  fnIx: i32,
): i32 {
  // A generic receiver tests its instance's type, or only its rep where the instance names no
  // type; a nullable one is false on null.
  const instTy = listIsRecvTyOf(recv, fnIx)
  const nullable = nodeTyIsNullable(recv)
  const recvTy = if nullable { nonNullTy(instTy) } else { instTy }
  const layers: i32[] = []
  const lit = listFitLitLeafOf(chk, recvTy, layers)
  if lit < 0 { return 0 }
  const rep = exprListRep(recv, fnIx)
  if (
    recvTy < 0
    && rep != "list"
    && rep != "i64list"
    && rep != "strlist"
    && rep != "reflist"
  ) {
    return 0
  }
  const depth = layers.length - 1
  const slots: i32[] = []
  const scalar = listFitScalarOf(recv, rep, layers, slots, anchor, fnIx)
  if scalar == "" { return -1 }
  const scalarKind: ListKind = if scalar == "str" { "strlist" } else if scalar == "i64" { "i64list" } else { "list" }
  const scalarV: VKind = if scalar == "str" { "str" } else if scalar == "i64" { "i64" } else { "i32" }
  // How an element compares with a member of `L`: at its integer base, `i64w` for an `i32`
  // widened to `i64`, as a string, or as an atom.
  const numBase = numLitUnionBaseName(lit)
  const wide = tyIntLitWideTexts(lit)
  const numLexes = if wide.length > 0 { wide } else { tyNumLitMemberTexts(lit) }
  const lexes = if numLexes.length > 0 { numLexes } else { tyLitMemberTexts(lit) }
  const leaf = layers[depth]
  const leafBase = if leaf < 0 { "" } else if numLitUnionBaseName(leaf) != "" { numLitUnionBaseName(leaf) } else { tyPrimNameOf(leaf) }
  let leafKind = ""
  if numLexes.length > 0 {
    if leaf >= 0 && leafBase != scalar {
      leafKind = ""
    } else if scalar == "i64" {
      leafKind = "i64"
    } else if scalar == "i32" {
      leafKind = if numBase == "i32" { "i32" } else { "i64w" }
    }
  } else if scalar == "str" {
    if leaf < 0 || leafBase == "string" { leafKind = "str" }
  } else if scalar == "i32" {
    if leaf < 0 || tyLitMemberTexts(leaf).length > 0 { leafKind = "atom" }
  }
  if leafKind == "" || lexes.length == 0 {
    return emitFailAt(
      "emitProgram: `is` over a list tests its elements against a literal set this element type has no compare for",
      anchor,
    )
  }
  if stash >= 0 { fbLocalGet(stash) }
  else if emitExpr(recv, fnIx) < 0 { return -1 }
  if (
    emitListFitLoop(
      slots,
      0,
      nullable,
      scalarKind,
      scalarV,
      leafKind,
      lexes,
      fnIx,
    )
    < 0
  ) {
    return -1
  }
  return 1
}

// The innermost list's element rep — `i32`, `i64` or `str` — of list `recv` (rep `rep`) nested
// as deep as `layers` says, pushing each enclosing ref list's slot onto `slots`, outermost
// first; "" after a refusal at `isIx` when the rep does not nest that way or disagrees with a
// known type in `layers`.
function listFitScalarOf(
  recv: i32,
  rep: VKind | null,
  layers: i32[],
  slots: i32[],
  isIx: i32,
  fnIx: i32,
): string {
  const depth = layers.length - 1
  if depth == 1 {
    if rep == "list" { return "i32" }
    if rep == "i64list" { return "i64" }
    if rep == "strlist" { return "str" }
    emitFailAt(LIST_FIT_REP_MSG, isIx)
    return ""
  }
  if rep != "reflist" { return listFitRepMiss(isIx) }
  let s = refListSlotOfExpr(recv, fnIx)
  let k = 1
  while k < depth {
    if s < 0 || s >= rlElemTyIx.length || s >= rlElemNullable.length {
      return listFitRepMiss(isIx)
    }
    if rlElemNullable[s] != 0 { return listFitRepMiss(isIx) }
    if layers[k] >= 0 && rlSlotOfTy(layers[k]) != s {
      return listFitRepMiss(isIx)
    }
    slots.push(s)
    const ek = rlElemKindAt(s)
    if k < depth - 1 {
      if ek != RLK_REF_LIST { return listFitRepMiss(isIx) }
      s = rlElemInnerSlot(s)
    } else {
      if ek == RLK_I32_LIST { return "i32" }
      if ek == RLK_I64_LIST { return "i64" }
      if ek == RLK_STR_LIST { return "str" }
      return listFitRepMiss(isIx)
    }
    k = k + 1
  }
  return listFitRepMiss(isIx)
}

const LIST_FIT_REP_MSG = "emitProgram: `is` over a list tests its elements, and this list's rep is not the one its type names"

// Refuses the fit test at `isIx` for a list rep it cannot walk, answering "".
function listFitRepMiss(isIx: i32): string {
  emitFailAt(LIST_FIT_REP_MSG, isIx)
  return ""
}

// `xs is K[]` where, at some list depth, the elements of `xs` and of `K[]` can never meet: true
// exactly when every list at that depth is empty (D4910, by the D4771 ruling). A region the
// test narrows reads an empty `K[]` in place of `xs` (D4911). 0, leaving the static fold, when
// not that shape; 1 when emitted, -1 when refused.
function emitListEmptyFitIs(isIx: i32, fnIx: i32): i32 {
  const p = emptyFitPlanOf(isIx, fnIx)
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) { return 0 }
  return match p.efArm {
    "decline" => 0
    "captured" => emitFailAt(LIST_FIT_SHADOW_MSG, isIx)
    "union" => emitListEmptyFitArms(isIx, fnIx, p.efRecvTy)
    "shadow" | "loop" => {
      let grow = -1
      if p.efArm == "shadow" {
        const sh = listFitShadowSet(isIx, p.efRecvTy, p.efDepth, fnIx)
        if sh < 1 { return sh }
        const rv = nodeAt(unwrapParen(nd.isObj))
        if sh == 2 && rv is Ident {
          grow = listFitGrowRow(unwrapParen(nd.isObj), isVarTyIxOf(isIx), fnIx)
        }
      }
      if p.efRepWhy != "" { return emitFailAt(p.efRepWhy, isIx) }
      // An arm that pushes tests only until its `K[]` is stored (`listFitGrowFill`).
      if grow >= 0 {
        fbLocalGet(fitGrowLocal[grow])
        fbRefIsNull()
        fbIf(127) // i32
      }
      if emitExpr(nd.isObj, fnIx) < 0 { return -1 }
      emitListEmptyLoop(p.efSlots, 0, p.efKind, p.efSlot)
      if grow >= 0 { return if listFitGrowFill(grow) < 0 { -1 } else { 1 } }
      1
    }
  }
}

// How `emitListEmptyFitIs` answers `is` test `isIx`: `decline` to the next rung, `captured` (an
// unbound instance's closure capture), `union` (a box or nullable receiver's arms), `shadow` (a
// narrowed region reads the arm's list), or `loop`, the walk over `efSlots` to an `efKind` list.
// `efRepWhy` refuses a rep the walk cannot take, after the shadow set as legacy writes it.
export type EmptyFitArm = "decline" | "captured" | "union" | "shadow" | "loop"
export type EmptyFitPlan = {
  efArm: EmptyFitArm,
  efRecvTy: i32,
  efDepth: i32,
  efSlots: i32[],
  efKind: ListKind,
  efSlot: i32,
  efRepWhy: string,
}

export function emptyFitPlanOf(isIx: i32, fnIx: i32): EmptyFitPlan {
  const no: EmptyFitPlan = {
    efArm: "decline",
    efRecvTy: -1,
    efDepth: 0,
    efSlots: [],
    efKind: "list",
    efSlot: 0,
    efRepWhy: "",
  }
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) || isTestsNull(isIx) { return no }
  const recvTy = listIsRecvTyOf(nd.isObj, fnIx)
  // An instance that left the receiver's type parameter unbound cannot hand a closure the arm's
  // list, since nothing says whether its elements meet `K`.
  const rv = nodeAt(unwrapParen(nd.isObj))
  const arm0: EmptyFitArm = if (recvTy < 0 || tyHasTyVar(recvTy))
    && rv is Ident
    && liftedFnCaptures(rv.identName, fnIx) { "captured" } else if exprUnion(nd.isObj, fnIx) || nodeTyIsNullable(nd.isObj) { "union" } else { "decline" }
  if arm0 != "decline" {
    const p0: EmptyFitPlan = {
      efArm: arm0,
      efRecvTy: recvTy,
      efDepth: 0,
      efSlots: [],
      efKind: "list",
      efSlot: 0,
      efRepWhy: "",
    }
    return p0
  }
  const depth = listDisjointDepth(recvTy, isVarTyIxOf(isIx))
  if depth < 1 { return no }
  const shadow = listNarrowReadDisjoint(fnIx, isIx, nd.isObj, recvTy)
  const slots: i32[] = []
  let kind: ListKind = "list"
  let slot = 0
  let why = ""
  if exprRefArray(nd.isObj, fnIx) {
    let s = refListSlotOfExpr(nd.isObj, fnIx)
    let k = 1
    kind = "reflist"
    while k < depth && why == "" {
      if s < 0 || s >= rlElemTyIx.length || rlElemNullable[s] != 0 {
        why = LIST_FIT_REP_MSG
      } else {
        slots.push(s)
        const ek = rlElemKindAt(s)
        if ek == RLK_REF_LIST { s = rlElemInnerSlot(s) }
        else if k == depth - 1 && ek == RLK_I32_LIST { kind = "list" }
        else if k == depth - 1 && ek == RLK_STR_LIST { kind = "strlist" }
        else if k == depth - 1 && ek == RLK_F64_LIST { kind = "f64list" }
        else if k == depth - 1 && ek == RLK_I64_LIST { kind = "i64list" }
        else if k == depth - 1 && ek == RLK_F32_LIST { kind = "f32list" }
        else if k == depth - 1 && ek == RLK_V128_LIST { kind = "v128list" }
        else if k == depth - 1 && ek == RLK_U8_LIST { kind = "u8list" }
        else { why = LIST_FIT_REP_MSG }
      }
      k = k + 1
    }
    if why == "" && kind == "reflist" {
      if s < 0 || s >= rlWrapIdx.length {
        why = LIST_FIT_REP_MSG
      } else {
        slot = s
      }
    }
  } else if depth > 1 {
    why = LIST_FIT_REP_MSG
  } else if exprStringArray(nd.isObj, fnIx) {
    kind = "strlist"
  } else {
    const lek = scalarListElemKind(nd.isObj, fnIx)
    if lek == null { why = LIST_FIT_REP_MSG } else { kind = listIdxKindOf(lek) }
  }
  const arm: EmptyFitArm = if shadow { "shadow" } else { "loop" }
  const p: EmptyFitPlan = {
    efArm: arm,
    efRecvTy: recvTy,
    efDepth: depth,
    efSlots: slots,
    efKind: kind,
    efSlot: slot,
    efRepWhy: why,
  }
  return p
}

// `is K[]` over a union or nullable receiver whose list arm `K[]` can never meet: true exactly
// when the receiver holds such an arm and that list is empty, so the arm's tag or non-null test
// guards the emptiness test (D4912). 0, leaving the static fold, when no arm is such a list.
function emitListEmptyFitArms(isIx: i32, fnIx: i32, recvTy: i32): i32 {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) { return 0 }
  const p = emptyFitArmsPlanOf(isIx, fnIx, recvTy)
  if p.eaWhy == "decline" { return 0 }
  if p.eaWhy == "noMembership" { return emitFailNoMembershipRecv() }
  if p.eaWhy != "" { return emitFailAt(p.eaWhy, isIx) }
  for r in p.eaRows {
    if r.erShadow {
      const sh = listFitShadowSet(isIx, r.erTy, r.erDepth, fnIx)
      if sh < 1 { return sh }
    }
  }
  if p.eaRepWhy != "" { return emitFailAt(p.eaRepWhy, isIx) }
  let i = 0
  while i < p.eaRows.length {
    if emitExpr(nd.isObj, fnIx) < 0 { return -1 }
    emptyFitArmHead(p, i)
    if emitExpr(nd.isObj, fnIx) < 0 { return -1 }
    emptyFitArmBody(p, i)
    i = i + 1
  }
  return 1
}

// One list arm of `emptyFitArmsPlanOf`: its type and disjoint depth, whether a narrowed region
// reads it (`listNarrowReadDisjoint`), the box tag a boxed receiver tests, the payload's heap,
// and the walk `emitListEmptyLoop` takes; `erBad` for a rep the walk cannot take.
export type EmptyFitArmRow = {
  erBad: boolean,
  erTy: i32,
  erDepth: i32,
  erShadow: boolean,
  erTag: i32,
  erHeap: i32,
  erSlots: i32[],
  erKind: ListKind,
  erSlot: i32,
}

// `emitListEmptyFitArms`'s decisions for `is` test `isIx`, in the order it writes them: `eaWhy`
// first (`decline`, `noMembership`, or a refusal), then each row's shadow set, then `eaRepWhy`.
export type EmptyFitArmsPlan = {
  eaWhy: string,
  eaBoxed: boolean,
  eaRows: EmptyFitArmRow[],
  eaRepWhy: string,
}

export function emptyFitArmsPlanOf(
  isIx: i32,
  fnIx: i32,
  recvTy: i32,
): EmptyFitArmsPlan {
  const nd = nodeAt(isIx)
  const boxed = nd is IsExpr && exprUnion(nd.isObj, fnIx)
  const rows: EmptyFitArmRow[] = []
  const no: EmptyFitArmsPlan = {
    eaWhy: "decline",
    eaBoxed: boxed,
    eaRows: rows,
    eaRepWhy: "",
  }
  if !(nd is IsExpr) { return no }
  const kTy = isVarTyIxOf(isIx)
  // A box's arms are the ones it registered, which the receiver's type need not spell.
  const armTys: i32[] = []
  if boxed {
    if (!unionTyMemberTys(unionBoxTyOfRead(nd.isObj, fnIx), armTys)) {
      return no
    }
  } else {
    if recvTy < 0 { return no }
    flattenVariantsInto(recvTy, armTys)
  }
  const fits: i32[] = []
  const depths: i32[] = []
  let meets = false
  for a in armTys {
    if a >= 0 && a < T.tys.length && tyAt(a) is TyArray {
      const d = listDisjointDepth(a, kTy)
      if d >= 1 {
        fits.push(a)
        depths.push(d)
      } else {
        meets = true
      }
    }
  }
  // An arm whose elements can be `K` at every depth keeps its tag test.
  if fits.length == 0 || meets { return no }
  let why = ""
  if !unionEqOperandOk(nd.isObj) { why = "noMembership" }
  else if !boxed && fits.length != 1 { why = LIST_FIT_REP_MSG }
  let rep = ""
  let i = 0
  while i < fits.length && why == "" {
    rows.push(emptyFitArmRowOf(fits[i], depths[i], boxed, isIx, fnIx))
    if rep == "" && rows[i].erBad { rep = LIST_FIT_REP_MSG }
    i = i + 1
  }
  const p: EmptyFitArmsPlan = {
    eaWhy: why,
    eaBoxed: boxed,
    eaRows: rows,
    eaRepWhy: rep,
  }
  return p
}

// The row of list arm `a`, disjoint from `K` at depth `d`.
function emptyFitArmRowOf(
  a: i32,
  d: i32,
  boxed: boolean,
  isIx: i32,
  fnIx: i32,
): EmptyFitArmRow {
  const nd = nodeAt(isIx)
  const shadow = nd is IsExpr && listNarrowReadDisjoint(fnIx, isIx, nd.isObj, a)
  const bad: EmptyFitArmRow = {
    erBad: true,
    erTy: a,
    erDepth: d,
    erShadow: shadow,
    erTag: -1,
    erHeap: -1,
    erSlots: [],
    erKind: "reflist",
    erSlot: -1,
  }
  const at = tyAt(a)
  if !(at is TyArray) { return bad }
  const heaps: i32[] = []
  const k0 = listFitElemKind(tyElemOf(at), heaps)
  let kind: ListKind = "reflist"
  // An arm disjoint below its first level is a list of lists: its rows down to that depth are
  // walked as `emitListEmptyFitIs` walks a bare receiver's, and the box holds the outer row.
  const slots: i32[] = []
  let slot = 0
  let heap = -1
  if d > 1 {
    let s = rlSlotOfTyOrTwin(tyRefArrElemOf(a))
    const outer = s
    let k = 1
    while k < d {
      if s < 0 || s >= rlElemTyIx.length || rlElemNullable[s] != 0 {
        return bad
      }
      slots.push(s)
      const ek = rlElemKindAt(s)
      if ek == RLK_REF_LIST { s = rlElemInnerSlot(s) }
      else if k == d - 1 && ek == RLK_I32_LIST { kind = "list" }
      else if k == d - 1 && ek == RLK_STR_LIST { kind = "strlist" }
      else if k == d - 1 && ek == RLK_F64_LIST { kind = "f64list" }
      else if k == d - 1 && ek == RLK_I64_LIST { kind = "i64list" }
      else if k == d - 1 && ek == RLK_F32_LIST { kind = "f32list" }
      else if k == d - 1 && ek == RLK_V128_LIST { kind = "v128list" }
      else if k == d - 1 && ek == RLK_U8_LIST { kind = "u8list" }
      else { return bad }
      k = k + 1
    }
    if kind == "reflist" {
      if s < 0 || s >= rlWrapIdx.length { return bad }
      slot = s
    }
    if outer < 0 || outer >= rlWrapIdx.length { return bad }
    heap = rlWrapIdx[outer]
  } else {
    if k0 == null { return bad }
    kind = k0
    slot = heaps[0]
    heap = heaps[2]
  }
  const tag = if boxed { isArmTagOfTy(a) } else { 0 }
  if tag < 0 { return bad }
  const r: EmptyFitArmRow = {
    erBad: false,
    erTy: a,
    erDepth: d,
    erShadow: shadow,
    erTag: tag,
    erHeap: heap,
    erSlots: slots,
    erKind: kind,
    erSlot: slot,
  }
  return r
}

// Whether plan `p` writes its rows with nothing before them: no refusal, no row a narrowed
// region reads (whose shadow set legacy writes first), and a boxed receiver.
export function emptyFitArmsPlain(p: EmptyFitArmsPlan): boolean {
  if p.eaWhy != "" || p.eaRepWhy != "" || !p.eaBoxed { return false }
  for r in p.eaRows {
    if r.erShadow { return false }
  }
  return true
}

// After row `i`'s first receiver read: its arm test (the box tag, or non-null), then the `if`.
export function emptyFitArmHead(p: EmptyFitArmsPlan, i: i32) {
  if p.eaBoxed {
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, p.eaRows[i].erTag)
    fbI32Bin(70) // 0x46 i32.eq
  } else {
    fbRefIsNull()
    fbI32Eqz()
  }
  // <arm test> if (result i32) { <the arm's list is empty> } else { 0 }
  fbIf(127)
  return 0
}

// After row `i`'s second receiver read: the arm's list, its emptiness walk, the `else 0`, and
// the `i32.or` onto the rows before it.
export function emptyFitArmBody(p: EmptyFitArmsPlan, i: i32) {
  const r = p.eaRows[i]
  if p.eaBoxed {
    fbStructGet(uBoxIdx, 1)
    fbRefCast(r.erHeap)
  } else {
    fbRefAsNonNull()
  }
  emitListEmptyLoop(r.erSlots, 0, r.erKind, r.erSlot)
  fbElse()
  fbI32Const(0)
  fbEnd()
  if i > 0 {
    fbI32Bin(114) // 0x72 i32.or
  }
  return 0
}

const LIST_FIT_PUSH_MSG = "emitProgram: this `is` arm pushes onto an empty list built with another element type, which cannot hold the pushed value"

const LIST_FIT_SHADOW_MSG = "emitProgram: this `is` arm reads an empty list at an element type it was not built with, and only a variable read directly in its own function can be handed one"

// Stores a fresh empty `K[]` for the `is K[]` at `isIx` in the local the arm reads in place of
// its receiver (`listFitShadowRead`), since the test fits only an empty list. 1 when stored, 2
// when a pushing arm's `listFitGrowRow` local is the test's to store, -1 when refused for a
// receiver no read can be redirected for.
function listFitShadowSet(isIx: i32, recvTy: i32, depth: i32, fnIx: i32): i32 {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) { return emitFailAt(LIST_FIT_SHADOW_MSG, isIx) }
  const r = nodeAt(unwrapParen(nd.isObj))
  if fnIx < 0 { return emitFailAt(LIST_FIT_SHADOW_MSG, isIx) }
  const fn = nodeAt(fnIx)
  if !(r is Ident) || !(fn is FuncDecl) || depth != 1 {
    return emitFailAt(LIST_FIT_SHADOW_MSG, isIx)
  }
  const kTy = isVarTyIxOf(isIx)
  if kTy < 0 || kTy >= T.tys.length {
    return emitFailAt(LIST_FIT_SHADOW_MSG, isIx)
  }
  const kt = tyAt(kTy)
  if !(kt is TyArray) { return emitFailAt(LIST_FIT_SHADOW_MSG, isIx) }
  const heaps: i32[] = []
  const kind = listFitElemKind(tyElemOf(kt), heaps)
  if kind == null { return emitFailAt(LIST_FIT_SHADOW_MSG, isIx) }
  // A closure's read stands in with its own empty `K[]` (`listFitCaptureStandIn`), except
  // between two record lists, which that read cannot tell apart.
  const rt = if recvTy >= 0 && recvTy < T.tys.length { tyAt(recvTy) } else { kt }
  const recvHeaps: i32[] = []
  const recvKind = if rt is TyArray { listFitElemKind(tyElemOf(rt), recvHeaps) } else { null }
  if (
    kind == "reflist"
    && (recvKind == null || recvKind == "reflist")
    && (nestedFnReadsDisjoint(fn.fnBody, r.identName, recvTy, false)
      || liftedFnReadsDisjoint(r.identName, recvTy, fnIx))
  ) {
    return emitFailAt(LIST_FIT_SHADOW_MSG, isIx)
  }
  const slot = heaps[0]
  const back = heaps[1]
  const wrap = heaps[2]
  const recvLoc = localIndexOf(fnIx, unwrapParen(nd.isObj))
  if recvLoc < 0 { return emitFailAt(LIST_FIT_SHADOW_MSG, isIx) }
  const grow = listFitGrowRow(unwrapParen(nd.isObj), kTy, fnIx)
  let loc = -1
  let i = 0
  while i < fitShName.length {
    if (
      fitShName[i] == r.identName
      && tySame(fitShTy[i], kTy)
      && fitShRecv[i] == recvLoc
    ) {
      loc = fitShLocal[i]
    }
    i = i + 1
  }
  if loc < 0 {
    loc = if grow >= 0 { fitGrowLocal[grow] } else { listFitSlot(kind, slot, 11) }
    fitShName.push(r.identName)
    fitShTy.push(kTy)
    fitShLocal.push(loc)
    fitShRecv.push(recvLoc)
    fitShSlot.push(if kind == "reflist" { slot } else { -1 })
  }
  if grow >= 0 { return 2 }
  fbBacking(back, 0)
  arrLitWrap(0, wrap)
  fbLocalSet(loc)
  return 1
}

// The local `listFitShadowSet` stored for a read of `name` at node `exprIx` typed as that
// local's list and resolving to the same binding, or -1 to read the binding itself.
function listFitShadowRead(name: string, exprIx: i32, fnIx: i32): i32 {
  const row = listFitShadowRow(name, exprIx, fnIx)
  if row < 0 { return -1 }
  return fitShLocal[row]
}

// Whether the list at `recv` reads an `is K[]` arm's empty `K[]` whose elements are refs, which no
// push in the arm grows.
function listFitShadowIsRef(recv: i32, fnIx: i32): boolean {
  const r = nodeAt(unwrapParen(recv))
  if !(r is Ident) { return false }
  const row = listFitShadowRow(r.identName, unwrapParen(recv), fnIx)
  return row >= 0 && fitShSlot[row] >= 0 && !listFitGrowHolds(fitShLocal[row])
}

// Whether `loc` is the local of a `fitGrow*` row, which a push may append to.
function listFitGrowHolds(loc: i32): boolean {
  for l in fitGrowLocal {
    if l == loc { return true }
  }
  return false
}

// With the test's answer on the stack inside the `if` `emitListEmptyFitIs` opened on a null
// `fitGrowLocal[row]`, stores a fresh `K[]` there when it fits; a set local answers 1 untested.
function listFitGrowFill(row: i32): i32 {
  const kt = tyAt(fitGrowTy[row])
  if !(kt is TyArray) { return emitFail(LIST_FIT_SHADOW_MSG) }
  const heaps: i32[] = []
  if listFitElemKind(tyElemOf(kt), heaps) == null {
    return emitFail(LIST_FIT_SHADOW_MSG)
  }
  fbIf(127) // i32
  fbBacking(heaps[1], 0)
  arrLitWrap(0, heaps[2])
  if row < 0 { return -1 }
  fbLocalSet(fitGrowLocal[row])
  fbI32Const(1)
  fbElse()
  fbI32Const(0)
  fbEnd()
  fbElse()
  fbI32Const(1)
  fbEnd()
  return 0
}

// `name.length` outside the arm of an `is K[]` that pushes onto `name`: the `K[]` once a test
// has fitted, the receiver's own list before. 0 when `m` is not such a read, 1 when emitted.
function emitListFitGrowLen(m: Member, memIx: i32, fnIx: i32): i32 {
  const o = nodeAt(m.memObj)
  if !(o is Ident) { return 0 }
  if listFitShadowRead(o.identName, m.memObj, fnIx) >= 0 { return 0 }
  const g = listFitGrowRow(m.memObj, -1, fnIx)
  if g < 0 { return 0 }
  const kt = tyAt(fitGrowTy[g])
  if !(kt is TyArray) { return 0 }
  const heaps: i32[] = []
  const kind = listFitElemKind(tyElemOf(kt), heaps)
  if kind == null { return 0 }
  fbLocalGet(fitGrowLocal[g])
  fbRefIsNull()
  fbIf(127) // i32
  if emitArrLen(memIx, fnIx) < 0 { return -1 }
  fbElse()
  fbLocalGet(fitGrowLocal[g])
  fbRefAsNonNull()
  emitListLenOnStack(kind, heaps[0])
  fbEnd()
  return 1
}

// The wrapper of the empty `K[]` (pushed onto `tyOut`) a closure's read of capture `name` stands
// in with, or -1 (D4935): only an `is K[]` fitting an empty list of other elements types it so. A
// read at a type parameter's list takes the region's `K[]` when `anyPos` or delivered whole. Two
// record lists are not told apart, since rows of one shape alias.
function listFitCaptureStandIn(
  name: string,
  exprIx: i32,
  fnIx: i32,
  anyPos: boolean,
  tyOut: i32[],
): i32 {
  if !listIsTestedIdent(unwrapParen(exprIx)) || !identIsEnvCapture(fnIx, name) {
    return -1
  }
  if narListReadsDecl(exprIx) { return -1 }
  const heaps: i32[] = []
  let st = nodeTyIxOf(exprIx)
  let kind = listFitStandInKind(st, heaps)
  if kind == null && (anyPos || listFitReadIsWhole(fnIx, exprIx)) {
    st = listFitRegionKTy(fnIx, name)
    kind = listFitStandInKind(st, heaps)
  }
  if kind == null { return -1 }
  tyOut.push(st)
  const ck = capturedKindOf(fnIx, name)
  if ck == null { return -1 }
  if ck == "reflist" { return if kind == "reflist" { -1 } else { heaps[2] } }
  if ck == "strlist" { return if isMkListTy(heaps[2]) { -1 } else { heaps[2] } }
  const se = scalarListElemOfListKind(ck)
  if se == null || scalarListWrap(se, heaps[0]) == heaps[2] { return -1 }
  return heaps[2]
}

// `listFitElemKind` of list type `t`'s elements, or null when `t` is not a list of a kind
// the stand-in builds, a type parameter's elements among them.
function listFitStandInKind(t: i32, heaps: i32[]): ListKind | null {
  if t < 0 || t >= T.tys.length { return null }
  const kt = tyAt(t)
  if !(kt is TyArray) { return null }
  return listFitElemKind(tyElemOf(kt), heaps)
}

// The `K[]` an `if <name> is K[]` of an enclosing function tests when the closure at `fnIx` is
// declared in that test's then-branch, or -1: a closure inside a generic body reads its capture at
// the type parameter's list, and only the region says which list the test fitted.
function listFitRegionKTy(fnIx: i32, name: string): i32 {
  let host = fnStmtsPosOf(fnIx)
  if host < 0 { return -1 }
  const self = fnStmts[host]
  while host >= 0 && host < fnParent.length {
    host = fnParent[host]
    if host < 0 || host >= fnStmts.length { return -1 }
    const h = nodeAt(fnStmts[host])
    if h is FuncDecl {
      const k = listFitRegionWalk(h.fnBody, name, self)
      if k >= 0 { return k }
    }
  }
  return -1
}

// `listFitRegionKTy`'s walk of one function body.
function listFitRegionWalk(ix: i32, name: string, self: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = nodeAt(ix)
  if n is IfStmt {
    const ci = unwrapParen(n.ifCond)
    const c = if ci < 0 { n } else { nodeAt(ci) }
    if c is IsExpr && nodeContains(n.ifThen, self) {
      const r = nodeAt(unwrapParen(c.isObj))
      if r is Ident && r.identName == name { return isVarTyIxOf(ci) }
    }
  }
  for k in nodeChildren(ix) {
    const t = listFitRegionWalk(k, name, self)
    if t >= 0 { return t }
  }
  return -1
}

// Whether the read at `exprIx` in function `fnIx` is delivered whole: not the object of a
// member, an index or a `for`, which read the list in place.
function listFitReadIsWhole(fnIx: i32, exprIx: i32): boolean {
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return false }
  const f = nodeAt(fnStmts[fe])
  if !(f is FuncDecl) { return false }
  let at = exprIx
  let par = nodeParentUnder(f.fnBody, at)
  while par >= 0 && nodeAt(par) is Paren {
    at = par
    par = nodeParentUnder(f.fnBody, at)
  }
  if par < 0 { return false }
  // Each of the four holds the list it reads in place as its first child.
  const p = nodeAt(par)
  const inPlace = p is Member || p is OptMember || p is Index || p is ForIn
  if !inPlace { return true }
  const kids = nodeChildren(par)
  return kids.length == 0 || kids[0] != at
}

// The node in the subtree at `ix` with `target` as a child, or -1.
function nodeParentUnder(ix: i32, target: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  for k in nodeChildren(ix) {
    if k == target { return ix }
    const r = nodeParentUnder(k, target)
    if r >= 0 { return r }
  }
  return -1
}

// Whether lifted slot `fe` captures `name` and is declared inside the function at `fnIx` (any
// lifted slot, where `fnIx` is not a function): a same-named capture elsewhere is another binding.
function liftedFnCapturesIn(fe: i32, name: string, fnIx: i32): boolean {
  if !strListHas(captureNamesOf(fe), name) { return false }
  if fnIx < 0 { return true }
  const host = nodeAt(fnIx)
  return !(host is FuncDecl) || nodeContains(host.fnBody, fnStmts[fe])
}

// Whether some lifted closure inside the function at `fnIx` captures `name`.
function liftedFnCaptures(name: string, fnIx: i32): boolean {
  let k = 0
  while k < cloLiftedFes.length {
    if liftedFnCapturesIn(cloLiftedFes[k], name, fnIx) { return true }
    k = k + 1
  }
  return false
}

// Whether a lifted closure inside the function at `fnIx` capturing `name` reads it at a type
// list-disjoint from `instTy`: the lifted body sits outside its frame's, so
// `nestedFnReadsDisjoint` cannot see it.
function liftedFnReadsDisjoint(name: string, instTy: i32, fnIx: i32): boolean {
  let k = 0
  while k < cloLiftedFes.length {
    const fe = cloLiftedFes[k]
    if liftedFnCapturesIn(fe, name, fnIx) {
      const f = nodeAt(fnStmts[fe])
      if f is FuncDecl && nestedFnReadsDisjoint(f.fnBody, name, instTy, true) {
        return true
      }
    }
    k = k + 1
  }
  return false
}

// Whether a function nested under `ix` reads `name` at a type list-disjoint from `instTy`; such
// a read is a capture, which the arm's local cannot reach.
function nestedFnReadsDisjoint(
  ix: i32,
  name: string,
  instTy: i32,
  inner: boolean,
): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if n is FuncDecl {
    return nestedFnReadsDisjoint(n.fnBody, name, instTy, true)
  }
  if inner && n is Ident && n.identName == name {
    const t = nodeTyIxOf(ix)
    if t >= 0 && listDisjointDepth(instTy, t) >= 1 { return true }
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if nestedFnReadsDisjoint(kids[i], name, instTy, inner) { return true }
    i = i + 1
  }
  return false
}

// Whether function `fnIx` may read the receiver `recv` of the `is` at `isIx` as the narrowed
// type, which the instance's value cannot carry, so the read needs an empty `K[]` in its place
// (D4911): a read typed disjoint from `instTy`, or any read in a region the `is` narrows. A field
// receiver counts every read of a field of the same name.
function listNarrowReadDisjoint(
  fnIx: i32,
  isIx: i32,
  recv: i32,
  instTy: i32,
): boolean {
  // The start function (`fnIx` -1) scans the whole program, its functions' bodies included.
  let body = emitRootIx
  if fnIx >= 0 {
    const fn = nodeAt(fnIx)
    if !(fn is FuncDecl) { return true }
    body = fn.fnBody
  }
  if body < 0 { return true }
  const r = nodeAt(unwrapParen(recv))
  if r is Member {
    return narrowReadsName(body, isIx, r.memProp, true, instTy, fnIx)
  }
  if r is Ident {
    return narrowReadsName(body, isIx, r.identName, false, instTy, fnIx)
  }
  // Flow narrows only an identifier or a field; any other receiver names nothing, so no read matches.
  return narrowReadsName(body, isIx, "", false, instTy, fnIx)
}

function narrowReadsName(
  body: i32,
  isIx: i32,
  name: string,
  field: boolean,
  instTy: i32,
  fnIx: i32,
): boolean {
  if name == "" { return false }
  return narrowReadDisjointUnder(body, name, field, instTy, fnIx)
    || narrowRegionReads(body, isIx, name, field) == 2
}

function narrowReadDisjointUnder(
  ix: i32,
  name: string,
  field: boolean,
  instTy: i32,
  fnIx: i32,
): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  const hit = if field { n is Member && n.memProp == name } else { n is Ident && n.identName == name }
  if hit {
    const t = nodeTyAt(ix, fnIx)
    if t >= 0 && listDisjointDepth(instTy, t) >= 1 { return true }
  }
  const kids = nodeChildren(ix)
  if n is Block && !field {
    let j = 0
    while j < kids.length {
      if kids[j] >= 0 {
        const s = nodeAt(kids[j])
        if s is LetDecl && s.letName == name { return false }
      }
      j = j + 1
    }
  }
  let i = 0
  while i < kids.length {
    if narrowReadDisjointUnder(kids[i], name, field, instTy, fnIx) {
      return true
    }
    i = i + 1
  }
  return false
}

// Whether every list at nesting `at` and below of the list on the stack is empty, leaving 1 or
// 0: `slots[at]`'s ref list is walked while `at` is inside `slots`, and the innermost list, of
// frame kind `kind` (ref-list row `slot` for a ref list), answers by its length.
export function emitListEmptyLoop(
  slots: i32[],
  at: i32,
  kind: ListKind,
  slot: i32,
) {
  if at >= slots.length {
    emitListLenOnStack(kind, slot)
    fbI32Eqz()
    return 0
  }
  const s = slots[at]
  const wL = listFitSlot("reflist", s, 11)
  const bL = listFitSlot("reflist", s, 3)
  const nL = listFitSlot("list", 0, 4)
  const iL = listFitSlot("list", 0, 4)
  fbLocalSet(wL)
  fbLocalGet(wL)
  fbStructGet(rlWrapIdx[s], 0)
  fbLocalSet(bL)
  fbLocalGet(wL)
  fbStructGet(rlWrapIdx[s], 1)
  fbLocalSet(nL)
  fbI32Const(0)
  fbLocalSet(iL)
  // block (result i32) { loop { 1 if i >= n; 0 unless list i is empty; i += 1 } }
  fbBlock(127)
  fbLoop(64)
  fbI32Const(1)
  fbLocalGet(iL)
  fbLocalGet(nL)
  fbI32Bin(78) // 0x4e i32.ge_s
  fbBrIf(1)
  fbDrop()
  fbI32Const(0)
  fbLocalGet(bL)
  fbLocalGet(iL)
  fbArrayGet(rlBackIdx[s])
  emitListEmptyLoop(slots, at + 1, kind, slot)
  fbI32Eqz()
  fbBrIf(1)
  fbDrop()
  fbLocalGet(iL)
  fbI32Const(1)
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(iL)
  fbBr(0)
  fbEnd()
  fbUnreachable()
  fbEnd()
  return 0
}

// Replace the list on the stack, of frame kind `kind` (ref-list row `slot` for a ref list), by
// its length, reading a view's length through its helper as `.length` does.
function emitListLenOnStack(kind: ListKind, slot: i32) {
  if kind == "reflist" {
    if rvMayView(slot) {
      const rwL = listFitSlot("reflist", slot, 11)
      fbLocalSet(rwL)
      rvTestView(rwL)
      fbIf(127) // i32
      fbLocalGet(rwL)
      fbCall(gHelpRvLen)
      fbElse()
      fbLocalGet(rwL)
      fbStructGet(rlWrapIdx[slot], 1)
      fbEnd()
      return 0
    }
    fbStructGet(rlWrapIdx[slot], 1)
    return 0
  }
  if kind == "strlist" {
    fbStructGet(mkListTy(), 1)
    return 0
  }
  if kind == "list" {
    fbStructGet(lTy(), 1)
    return 0
  }
  const lek: VKind = numListElemOf(kind) ?? "u8list"
  const sv = svDstOfKind(lek)
  if sv >= 0 {
    const lwL = listFitSlot(kind, slot, 11)
    fbLocalSet(lwL)
    svTestView(lwL, sv)
    fbIf(127) // i32
    fbLocalGet(lwL)
    fbCall(gHelpSvLen[sv])
    fbElse()
    fbLocalGet(lwL)
    fbStructGet(scalarListWrap(lek, slot), 1)
    fbEnd()
    return 0
  }
  fbStructGet(scalarListWrap(lek, slot), 1)
  return 0
}

// The fit loop over the list on the stack at nesting `at`: `slots[at]`'s ref list while `at`
// is inside `slots`, else the `scalarKind` list. Leaves 1 when every element fits, else 0.
// A `nullable` list leaves 0 when it is null.
function emitListFitLoop(
  slots: i32[],
  at: i32,
  nullable: boolean,
  scalarKind: ListKind,
  scalarV: VKind,
  leafKind: string,
  lexes: string[],
  fnIx: i32,
): i32 {
  const inner = at < slots.length
  const kind: ListKind = if inner { "reflist" } else { scalarKind }
  const slot = if inner { slots[at] } else { 0 }
  const wrapTy = if inner { rlWrapIdx[slot] } else { scalarListWrap(scalarV, 0) }
  const backTy = if inner { rlBackIdx[slot] } else { scalarListBack(scalarV, 0) }
  const wL = listFitSlot(kind, slot, 11)
  const bL = listFitSlot(kind, slot, 3)
  const nL = listFitSlot("list", 0, 4)
  const iL = listFitSlot("list", 0, 4)
  fbLocalSet(wL)
  if nullable {
    fbLocalGet(wL)
    fbRefIsNull()
    fbIf(127)
    fbI32Const(0)
    fbElse()
  }
  fbLocalGet(wL)
  fbStructGet(wrapTy, 0)
  fbLocalSet(bL)
  fbLocalGet(wL)
  fbStructGet(wrapTy, 1)
  fbLocalSet(nL)
  fbI32Const(0)
  fbLocalSet(iL)
  // block (result i32) { loop { 1 if i >= n; 0 unless element i fits; i += 1 } }
  fbBlock(127)
  fbLoop(64)
  fbI32Const(1)
  fbLocalGet(iL)
  fbLocalGet(nL)
  fbI32Bin(78) // 0x4e i32.ge_s
  fbBrIf(1)
  fbDrop()
  fbI32Const(0)
  fbLocalGet(bL)
  fbLocalGet(iL)
  fbArrayGet(backTy)
  if inner {
    if (
      emitListFitLoop(
        slots,
        at + 1,
        false,
        scalarKind,
        scalarV,
        leafKind,
        lexes,
        fnIx,
      )
      < 0
    ) {
      return -1
    }
  } else if emitListFitElem(scalarKind, leafKind, lexes, fnIx) < 0 {
    return -1
  }
  fbI32Eqz()
  fbBrIf(1)
  fbDrop()
  fbLocalGet(iL)
  fbI32Const(1)
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(iL)
  fbBr(0)
  fbEnd()
  fbUnreachable()
  fbEnd()
  if nullable { fbEnd() }
  return 0
}

// Whether the scalar element on the stack is a member of `lexes` (for `nonnull`, once per
// entry, whether it is not null), leaving 0/1.
function emitListFitElem(
  scalarKind: ListKind,
  leafKind: string,
  lexes: string[],
  fnIx: i32,
): i32 {
  const eL = listFitSlot(scalarKind, 0, 2)
  fbLocalSet(eL)
  let i = 0
  while i < lexes.length {
    fbLocalGet(eL)
    if leafKind == "nonnull" {
      fbRefIsNull()
      fbI32Eqz()
    } else if leafKind == "str" {
      fbRefAsNonNull()
      if emitStrEqLit(mkStr(quoteLex(lexes[i]), -1), fnIx) < 0 { return -1 }
    } else if leafKind == "atom" {
      fbI32Rel(RS_ATOM, internAtom(quoteLex(lexes[i])))
      fbI32Bin(70) // 0x46 i32.eq
    } else if leafKind == "i64w" {
      fbI64ExtendI32S()
      emitNumLitConstEq("i64", lexes[i])
    } else {
      emitNumLitConstEq(leafKind, lexes[i])
    }
    if i > 0 {
      fbI32Bin(114) // 0x72 i32.or
    }
    i = i + 1
  }
  return 0
}

// One read of the record-fit receiver: local `src` cast back to `heap` (left uncast when `heap`
// is -1, for the null test) when it is not -1, else the receiver expression itself.
function emitRecordFitRecv(recv: i32, fnIx: i32, src: i32, heap: i32): i32 {
  if src < 0 { return emitExpr(recv, fnIx) }
  fbLocalGet(src)
  if heap >= 0 { fbRefCast(heap) }
  return 0
}

// The outer union's tag for each arm of `tty`, in flatten order, with the arm's variant row
// beside it (-1 for a value atom). A union alias member is a SUBSET of the outer box's tags
// and never a nested box, so every membership test over one is this list `i32.or`ed together.
// False when an arm has no tag at all — the caller names its own refusal (D1774).
function unionArmTagsOfTy(
  tty: i32,
  recvU: i32,
  tags: i32[],
  vis: i32[],
): boolean {
  const armTys: i32[] = []
  flattenVariantsInto(tty, armTys)
  if armTys.length == 0 { return false }
  let at = 0
  while at < armTys.length {
    const aty = armTys[at]
    let t1 = isArmTagOfTy(aty)
    // a struct arm is a variant: its box tag is `uTags[vi]`, the rank assigned at
    // construction, not an `isArmTagOfTy` value-atom kind.
    let vi = -1
    if t1 < 0 {
      // The arm of the receiver's union row `recvU` (-1 for none) whose checked type `aty` is: a
      // tag is the member's within its union. Else the arm's row by its rep.
      vi = unionArmRowOfTy(recvU, aty)
      if vi < 0 { vi = repVariantShapeRowOf(aty) }
      if vi >= 0 { t1 = uTags[vi] }
    }
    if t1 < 0 { return false }
    tags.push(t1)
    vis.push(vi)
    at = at + 1
  }
  return true
}

// The membership half of `x is A` (D1023) — emitted after the arm's tag test and `i32.and`ed
// onto it, for each field the tag alone cannot settle. `A`'s tag names the shape; where two
// declared types share a shape, the ruling makes `is` a question about the value. It emits
// nothing when no field needs it (`variantDiscrimFieldNeeded`).

// The receiver is re-read once per member, so `unionEqOperandOk` is the place test and a
// non-place receiver keeps the loud refusal. The tag test is consumed into an `if` rather than
// `i32.and`ed, because `i32.and` evaluates both operands: the discriminant read casts to this
// arm and would run on every other arm's values too, trapping once a third arm differs.
function emitVariantDiscrimTest(recvIx: i32, vi: i32, fnIx: i32) {
  if vi < 0 || vi >= uFieldCount.length || !variantNeedsDiscrim(vi) { return 0 }
  const cnt = uFieldCount[vi]
  if !unionEqOperandOk(recvIx) { return emitFailNoMembershipRecv() }
  // <tag test> if (result i32) { <membership> } else { 0 }
  fbIf(127) // 0x04 if, i32 result
  let first = true
  let fi = 0
  while fi < cnt {
    if variantDiscrimFieldNeeded(vi, fi) {
      const lexes = variantFieldLitLexes(vi, fi)
      if lexes.length == 0 {
        return emitFail(
          "emitProgram: a discriminant field with no literal members",
        )
      }
      let li = 0
      while li < lexes.length {
        if emitDiscrimFieldEq(recvIx, vi, fi, lexes[li], fnIx) < 0 { return -1 }
        if li > 0 {
          fbI32Bin(114) // 0x72 i32.or — membership across the set
        }
        li = li + 1
      }
      // Every literal field of the tested type must hold: `is A` is membership in ALL of
      // `A`'s literal sets, not in one of them.
      if !first {
        fbI32Bin(113) // 0x71 i32.and
      }
      first = false
    }
    fi = fi + 1
  }
  fbElse()
  fbI32Const(0)
  fbEnd()
  return 0
}

// ANDs onto the shared-row fit of `recv is xTy` the literal sets of each nested record field
// another member stored at row `vi` declares as another record type (D16939); the tag and the
// top-level fields cannot tell those members apart.
function emitSharedNestedFits(
  recv: i32,
  vi: i32,
  xTy: i32,
  fnIx: i32,
  slot: i32,
): i32 {
  if vi < 0 || vi >= uFieldCount.length || vi >= uFieldStart.length { return 0 }
  if xTy < 0 || xTy >= T.tys.length { return 0 }
  const xt = tyAt(xTy)
  if !(xt is TyObj) { return 0 }
  const mems = armRowSharedMembers(recv, vi)
  let fi = 0
  while fi < uFieldCount[vi] {
    const name = sFieldNames[uFieldStart[vi] + fi]
    const fx = objFieldType(xt, name)
    let differs = false
    if (
      fx >= 0
      && tyAt(fx) is TyObj
      && fieldRowIsRecordRef(uFieldStart[vi] + fi)
    ) {
      for m in mems {
        const mo = tyAt(m)
        if mo is TyObj {
          const fm = objFieldType(mo, name)
          if fm >= 0 && !tyEq(fm, fx) { differs = true }
        }
      }
    }
    if differs {
      const nslot = objOrderStashSlot(
        "nulstruct",
        FC_STRUCT,
        uFieldStorageSlot(vi, fi),
      )
      if emitSharedFieldRecv(recv, fnIx, slot) < 0 { return -1 }
      fbStructGet(uBoxIdx, 1)
      fbRefCast(variantHeap(vi))
      fbStructGet(variantHeap(vi), fi)
      fbLocalSet(nslot)
      const nsi = sFieldTgtStructIdx(variantRowOf(vi), fi)
      if emitRecordValueFits(nsi, nslot, fx, fnIx) < 0 { return -1 }
      fbI32Bin(113) // i32.and
    }
    fi = fi + 1
  }
  return 0
}

// Leaves 1 when the record in local `rslot`, stored at struct row `si`, is a value of record type
// `xTy`: every literal set `xTy` declares holds a member, every box field holds a member whose tag
// is one of the field's, and every nested record fits the same way. Other fields are not read.
function emitRecordValueFits(si: i32, rslot: i32, xTy: i32, fnIx: i32): i32 {
  if si < 0 || si >= sHeapIdx.length || xTy < 0 || xTy >= T.tys.length {
    return emitFail(
      "emitProgram: `is` reaches a nested record with no struct row",
    )
  }
  const xt = tyAt(xTy)
  if !(xt is TyObj) {
    return emitFail(
      "emitProgram: `is` reaches a nested field that is no record",
    )
  }
  const heap = sHeapIdx[si]
  let terms = 0
  let i = 0
  while i < xt.objFieldNames.length {
    const fx = xt.objFieldTypes[i]
    const fi = sFieldIndex(si, xt.objFieldNames[i])
    const r = sFieldFlatRow(si, fi)
    const lexes = tyLitSetMemberLexes(fx)
    let wrote = true
    if r < 0 {
      wrote = false
    } else if fieldRowIsUnionBox(r) {
      if emitBoxFieldTagsIn(heap, rslot, fi, fx) < 0 { return -1 }
    } else if fieldRowIsRecordRef(r) && tyAt(fx) is TyObj {
      const nslot = objOrderStashSlot(
        "nulstruct",
        FC_STRUCT,
        sFieldStorageSlot(si, fi),
      )
      fbLocalGet(rslot)
      fbStructGet(heap, fi)
      fbLocalSet(nslot)
      if emitRecordValueFits(sFieldTgtStructIdx(si, fi), nslot, fx, fnIx) < 0 {
        return -1
      }
    } else if lexes.length > 0 && nonNullTy(fx) == fx {
      let li = 0
      while li < lexes.length {
        fbLocalGet(rslot)
        fbStructGet(heap, fi)
        if emitFieldLitEq(r, lexes[li], fnIx) < 0 { return -1 }
        if li > 0 {
          fbI32Bin(114) // i32.or
        }
        li = li + 1
      }
    } else if lexes.length > 0 {
      return emitFail(
        "emitProgram: `is` over a nested literal set stored beside `null`",
      )
    } else {
      wrote = false
    }
    if wrote {
      if terms > 0 {
        fbI32Bin(113) // i32.and
      }
      terms = terms + 1
    }
    i = i + 1
  }
  if terms == 0 { fbI32Const(1) }
  return 0
}

// Leaves 1 when box field `fi` of the record in local `rslot` (heap `heap`) holds a member of
// `fx`, by its tag: each member of `fx` has one tag.
function emitBoxFieldTagsIn(heap: i32, rslot: i32, fi: i32, fx: i32): i32 {
  const mems: i32[] = []
  flattenVariantsInto(fx, mems)
  const tags: i32[] = []
  for mm in mems {
    const one: i32[] = []
    const vis: i32[] = []
    if !unionArmTagsOfTy(mm, -1, one, vis) || one.length != 1 {
      return emitFail(
        "emitProgram: `is` over a nested box field whose tested member has no one tag",
      )
    }
    tags.push(one[0])
  }
  if tags.length == 0 { fbI32Const(0) }
  let j = 0
  while j < tags.length {
    fbLocalGet(rslot)
    fbStructGet(heap, fi)
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, tags[j])
    fbI32Bin(70)
    if j > 0 { fbI32Bin(114) }
    j = j + 1
  }
  return 0
}

// `mapSoftTwinClashOf`'s clash refused at `at`: -1 when refused, else 0.
function mapSoftTwinTagFail(recvIx: i32, patTy: i32, fnIx: i32, at: i32): i32 {
  const pm = mapSoftTwinClashOf(recvIx, patTy, fnIx)
  if pm < 0 { return 0 }
  return emitFailAt(
    "emitProgram: a test cannot tell "
      + tyToEmitName(pm)
      + " from the map its numeric literal union reads as yet — wrap each map in a record with a discriminant field",
    at,
  )
}

// Lower `is` test `isIx` at the rung `isPreArmOf` names: a decided constant, its operand
// evaluated for effects where it may have any, or `emitIsTest`'s rungs.
function emitIs(isIx: i32, fnIx: i32) {
  const nd0 = nodeAt(isIx)
  if !(nd0 is IsExpr) { return emitIsTest(isIx, fnIx) }
  const d = isDecidedPlanOf(isIx, fnIx)
  return match d.idArm {
    // A narrowed operand is tested at its storage, never trusted: a write the narrowing does
    // not see (an alias, an escaped closure) is answered (D2447).
    "storage" => {
      const sMark = storageReadEnter(nd0.isObj)
      const r = emitIsTest(isIx, fnIx)
      storageReadLeave(sMark)
      r
    }
    "tautology" | "covers" | "fits" | "prim" | "pin" => {
      isDecidedOperand(nd0.isObj, d.idEval, d.idBit, fnIx)
    }
    "test" => emitIsTest(isIx, fnIx)
  }
}

// A decided `is`: operand `opIx` evaluated and dropped when `evaluate`, then the constant `bit`.
function isDecidedOperand(opIx: i32, evaluate: boolean, bit: i32, fnIx: i32) {
  if evaluate {
    if emitExpr(opIx, fnIx) < 0 { return -1 }
    fbDrop()
  }
  fbI32Const(bit)
  return 0
}

// Whether every operand arm (`opTags`/`opVis`) holding tag `tag` is among the tested `isVis`.
function isTagWhollyTested(
  tag: i32,
  opTags: i32[],
  opVis: i32[],
  isVis: i32[],
): boolean {
  let i = 0
  while i < opTags.length && i < opVis.length {
    if opTags[i] == tag && !i32ListHas(isVis, opVis[i]) { return false }
    i = i + 1
  }
  return true
}

// `x is L` for a list type `L` over a box union with a list arm other than `L`: an arm fits when
// every element does (D4771), so a `string[]` arm tests its strings against `L`'s literals
// (D4779), an arm sharing `L`'s tag tests its atoms (D4938), and any other fits only when empty
// (D4915). 0 when the test is not that shape, 1 when emitted, -1 when refused.
function emitListIsAcrossReps(isIx: i32, fnIx: i32): i32 {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) { return 0 }
  const chk = isVarTyIxOf(isIx)
  const tags: i32[] = []
  const fits: i32[] = []
  const slotsAt: i32[][] = []
  if !listIsAcrossRepsPlan(nd.isObj, chk, fnIx, tags, fits, slotsAt) {
    return 0
  }
  const slot = sharedFieldRecvSlot()
  if emitExpr(nd.isObj, fnIx) < 0 { return -1 }
  fbLocalSet(slot)
  // A nullable operand is false on null; the box is a null reference then (D4953).
  const nullable = nodeTyIsNullable(nd.isObj)
  if nullable {
    fbLocalGet(slot)
    fbRefIsNull()
    fbIf(127)
    fbI32Const(0)
    fbElse()
  }
  if emitListIsAcrossRepsAt(slot, chk, tags, fits, slotsAt, fnIx) < 0 {
    return -1
  }
  if nullable { fbEnd() }
  return 1
}

// Whether every element of the `u8[]`, `i64[]`, `f32[]` or `f64[]` arm `a`, whose payload is on the
// stack, is a member of numeric literal set `leaf`, leaving 0/1 (D16970). An empty list fits.
function emitListWideArmFit(a: i32, leaf: i32, fnIx: i32): i32 {
  const e = tyArrayElemIx(a)
  if emitUnionPayloadUnbox(boxTagOfTy(a)) < 0 { return -1 }
  const nums = tyNumLitMemberTexts(leaf)
  if tyIsPrimNamed(e, "u8") {
    return emitListFitLoop([], 0, false, "u8list", "u8list", "i32", nums, fnIx)
  }
  if tyIsPrimNamed(e, "i64") {
    return emitListFitLoop([], 0, false, "i64list", "i64", "i64", nums, fnIx)
  }
  if tyIsPrimNamed(e, "f32") {
    return emitListFitLoop([], 0, false, "f32list", "f32", "f32", nums, fnIx)
  }
  if tyIsPrimNamed(e, "f64") {
    return emitListFitLoop([], 0, false, "f64list", "f64", "f64", nums, fnIx)
  }
  return emitFail(
    "emitProgram: a wide numeric list arm of `is` names no element kind the fit loop reads",
  )
}

// Whether every record of record-list arm `a`, stored in ref list `rs` and its payload on the
// stack, fits record list `chk` by its fields (`emitRecordFitCore`), leaving 0/1 (D16989). An
// empty list fits.
function emitListRecArmFit(rs: i32, a: i32, chk: i32, fnIx: i32): i32 {
  const ae = tyArrayElemIx(a)
  const si = structIndexOfTy(ae)
  if rs < 0 || rs >= rlWrapIdx.length || rs >= rlBackIdx.length {
    return emitFail(
      "emitProgram: `is` over a record-list arm with no ref-list row",
    )
  }
  if si < 0 || si >= sHeapIdx.length {
    return emitFail(
      "emitProgram: `is` over a record-list arm whose records have no struct row",
    )
  }
  const names: string[] = []
  const sets: i32[] = []
  recFitNarrowedFields(ae, tyArrayElemIx(chk), names, sets)
  const eL = objOrderStashSlot("nulstruct", FC_STRUCT, si)
  const wL = listFitSlot("reflist", rs, 11)
  const bL = listFitSlot("reflist", rs, 3)
  const nL = listFitSlot("list", 0, 4)
  const iL = listFitSlot("list", 0, 4)
  fbRefCast(rlWrapIdx[rs])
  fbLocalSet(wL)
  fbLocalGet(wL)
  fbStructGet(rlWrapIdx[rs], 0)
  fbLocalSet(bL)
  fbLocalGet(wL)
  fbStructGet(rlWrapIdx[rs], 1)
  fbLocalSet(nL)
  fbI32Const(0)
  fbLocalSet(iL)
  // block (result i32) { loop { 1 if i >= n; 0 unless record i fits; i += 1 } }
  fbBlock(127)
  fbLoop(64)
  fbI32Const(1)
  fbLocalGet(iL)
  fbLocalGet(nL)
  fbI32Bin(78) // 0x4e i32.ge_s
  fbBrIf(1)
  fbDrop()
  fbI32Const(0)
  fbLocalGet(bL)
  fbLocalGet(iL)
  fbArrayGet(rlBackIdx[rs])
  fbLocalSet(eL)
  if emitRecordFitCore(-1, eL, si, -1, false, names, sets, fnIx) < 0 {
    return -1
  }
  fbI32Eqz()
  fbBrIf(1)
  fbDrop()
  fbLocalGet(iL)
  fbI32Const(1)
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(iL)
  fbBr(0)
  fbEnd()
  fbUnreachable()
  fbEnd()
  return 0
}

// The planned test over the non-null box in local `slot`, leaving a 0/1 i32. 0, or -1 on failure.
function emitListIsAcrossRepsAt(
  slot: i32,
  chk: i32,
  tags: i32[],
  fits: i32[],
  slotsAt: i32[][],
  fnIx: i32,
): i32 {
  const chkLeaf = listLeafTyOf(chk)
  const lexes = tyLitMemberTexts(chkLeaf)
  fbI32Const(0)
  let i = 0
  while i < tags.length {
    fbLocalGet(slot)
    fbRefAsNonNull()
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, tags[i])
    fbI32Bin(70) // 0x46 i32.eq
    const k = fits[i]
    if k != LIST_ARM_OWN {
      fbIf(127)
      fbLocalGet(slot)
      fbRefAsNonNull()
      fbStructGet(uBoxIdx, 1)
      if k == LIST_ARM_NULLS {
        if emitUnionPayloadUnbox(7) < 0 { return -1 }
        const nulls = ["2"]
        if (
          emitListFitLoop([], 0, false, "list", "i32", "i32", nulls, fnIx)
          < 0
        ) {
          return -1
        }
      } else if k == LIST_ARM_NUMS {
        const nslots = slotsAt[i]
        if nslots.length > 0 { fbRefCast(rlWrapIdx[nslots[0]]) }
        else if emitUnionPayloadUnbox(7) < 0 { return -1 }
        const nums = tyNumLitMemberTexts(chkLeaf)
        if (
          emitListFitLoop(nslots, 0, false, "list", "i32", "i32", nums, fnIx)
          < 0
        ) {
          return -1
        }
      } else if k == LIST_ARM_WIDE {
        if emitListWideArmFit(slotsAt[i][0], chkLeaf, fnIx) < 0 { return -1 }
      } else if k == LIST_ARM_RECS {
        if emitListRecArmFit(slotsAt[i][0], slotsAt[i][1], chk, fnIx) < 0 {
          return -1
        }
      } else if k == LIST_ARM_NONNULL {
        if emitUnionPayloadUnbox(9) < 0 { return -1 }
        const one = [""]
        if (
          emitListFitLoop([], 0, false, "strlist", "str", "nonnull", one, fnIx)
          < 0
        ) {
          return -1
        }
      } else {
        const str = k == LIST_ARM_STRS
        const slots = slotsAt[i]
        if slots.length > 0 { fbRefCast(rlWrapIdx[slots[0]]) }
        else if emitUnionPayloadUnbox(if str { 9 } else { 7 }) < 0 { return -1 }
        const fit = emitListFitLoop(
          slots,
          0,
          false,
          if str { "strlist" } else { "list" },
          if str { "str" } else { "i32" },
          if str { "str" } else { "atom" },
          lexes,
          fnIx,
        )
        if fit < 0 { return -1 }
      }
      fbElse()
      fbI32Const(0)
      fbEnd()
    }
    fbI32Bin(114) // 0x72 i32.or
    i = i + 1
  }
  return 0
}

const LIST_ARM_STRS = 2
// The literal arm `arm` of `is` test `isIx`; 1 once written, -1 on failure.
function emitIsTestLitArms(isIx: i32, nd0: IsExpr, fnIx: i32, arm: LitIsArm) {
  const t = isVarTyIxOf(isIx)
  return match arm {
    "mapNull" | "mapHas" => {
      const rd = nodeAt(unwrapParen(nd0.isObj))
      if !(rd is Index) {
        return emitFail(
          "emitProgram: internal: a map read's `is` lost its index",
        )
      }
      if emitMapHas(rd.idxArr, rd.idxIndex, fnIx) < 0 { return -1 }
      if arm == "mapNull" { fbI32Eqz() }
      1
    }
    "nicheNever" => {
      fbI32Const(0)
      1
    }
    "nicheTest" => if emitNulIsNullTest(nd0.isObj, fnIx, !isTestsNull(isIx), true) < 0 { -1 } else { 1 }
    "nicheRaw" => {
      if emitExpr(nd0.isObj, fnIx) < 0 { return -1 }
      nicheRawIsTail(isIx)
    }
    "atomNotNul" => {
      if emitExpr(nd0.isObj, fnIx) < 0 { return -1 }
      atomNotNulIsTail()
    }
    "atomTrue" | "memberTrue" => {
      fbI32Const(1)
      1
    }
    "atomEq" => {
      const laTexts = tyLitMemberTexts(t)
      let laI = 0
      while laI < laTexts.length {
        if emitExpr(nd0.isObj, fnIx) < 0 { return -1 }
        atomEqIsTail(laTexts[laI], laI)
        laI = laI + 1
      }
      1
    }
    "boxLits" | "numBox" => {
      const bt = if arm == "boxLits" { tyLitMemberTexts(t) } else { tyNumLitMemberTexts(t) }
      let bI = 0
      while bI < bt.length {
        const lit = if arm == "boxLits" { quoteLex(bt[bI]) } else { bt[bI] }
        if emitUnionLitIs(nd0.isObj, lit, fnIx) < 0 { return -1 }
        if bI > 0 { fbI32Bin(114) }
        bI = bI + 1
      }
      1
    }
    "memberNoRecv" => emitFailNoMembershipRecv()
    "memberEq" => {
      const lsTexts = tyLitMemberTexts(t)
      let lsI = 0
      while lsI < lsTexts.length {
        if (emitLitMemberEq(nd0.isObj, quoteLex(lsTexts[lsI]), fnIx) < 0) {
          return -1
        }
        memberOrTail(lsI)
        lsI = lsI + 1
      }
      1
    }
    "none" => emitFail("emitProgram: internal: an `is` literal arm with no lowering")
  }
}

// After a ref niche's operand: its null test, negated unless `is` test `isIx` tests `null`.
export function nicheRawIsTail(isIx: i32): i32 {
  fbRefIsNull()
  if !isTestsNull(isIx) { fbI32Eqz() }
  return 1
}

// After a `K | null` atom's operand: whether it is not the null id.
export function atomNotNulIsTail(): i32 {
  fbI32Const(-1)
  fbI32Bin(71) // i32.ne
  return 1
}

// After the operand's `i`-th read: whether it is member `text`'s atom, or'd onto the reads before.
export function atomEqIsTail(text: string, i: i32) {
  fbI32Rel(RS_ATOM, internAtom(quoteLex(text)))
  fbI32Bin(70)
  memberOrTail(i)
}

// After member `i`'s compare in a membership test: or-ed into the earlier members' answer.
export function memberOrTail(i: i32) {
  if i > 0 { fbI32Bin(114) }
}

// After a box: its tag compared with `tag`.
export function boxTagIsTail(tag: i32) {
  fbStructGet(uBoxIdx, 0)
  fbI32Rel(RS_TAG, tag)
  fbI32Bin(70)
  return 1
}

// The tag box-tag `is` test `isIx` compares: its pattern's arm tag at the receiver, or -1.
export function isArmTagOf(isIx: i32, nd: IsExpr, fnIx: i32): i32 {
  return isArmTagOfTyAt(isArmPatTy(isIx, nd, fnIx), nd.isObj, fnIx)
}

// The box-tag arm `arm` of `is` test `isIx`; 1 once written, -1 on failure.
function emitIsTestArmTag(isIx: i32, ndv: IsExpr, fnIx: i32, arm: TagIsArm) {
  const patTy = isArmPatTy(isIx, ndv, fnIx)
  const armTag = isArmTagOf(isIx, ndv, fnIx)
  const r = unwrapParen(ndv.isObj)
  const vrecv = nodeAt(unwrapParen(ndv.isObj))
  return match arm {
    "boxLitSet" => {
      const smTexts = tyLitMemberTexts(isVarTyIxOf(isIx))
      let smI = 0
      while smI < smTexts.length {
        if emitUnionLitIs(ndv.isObj, quoteLex(smTexts[smI]), fnIx) < 0 {
          return -1
        }
        if smI > 0 { fbI32Bin(114) }
        smI = smI + 1
      }
      1
    }
    "softTwin" => mapSoftTwinTagFail(ndv.isObj, patTy, fnIx, isIx)
    "lacks" => {
      if emitExpr(ndv.isObj, fnIx) < 0 { return -1 }
      fbDrop()
      fbI32Const(0)
      1
    }
    "strTag" => emitFail(
      "emitProgram: `is` over a literal union reached the box's string-tag test, which cannot tell its members from other strings",
    )
    // No arm of this box carries the tag (a generic body's `is i32[]` at a pin whose union has
    // no list), so the test is false and a bare name needs no read (D2955).
    "tagAbsent" => {
      fbI32Const(0)
      1
    }
    // The raw box slot, even where an outer arm narrowed it to one atom: the narrowed read
    // would unbox instead of yielding the box.
    "identBox" => if emitUnionBoxPush(r, fnIx) < 0 { -1 } else { boxTagIsTail(armTag) }
    // Only a receiver narrowed to a variant of a box, as `emitMem` asks; a nullable record
    // narrowed by `!= null` is the record itself (D8000).
    "memNarrow" => if emitNarrowedMem(r, fnIx) < 0 { -1 } else { boxTagIsTail(armTag) }
    "memStruct" => {
      if !(vrecv is Member) {
        return emitFail("emitProgram: internal: a field's `is` lost its member")
      }
      const msi = structIndexOfExpr(vrecv.memObj, fnIx)
      if msi < 0 || msi >= sHeapIdx.length {
        return emitFail("emitProgram: internal: a field's `is` lost its record")
      }
      if emitExpr(vrecv.memObj, fnIx) < 0 { return -1 }
      if (
        exprNullableStruct(vrecv.memObj, fnIx)
        && !readOwesNonNullRecover(vrecv.memObj, fnIx)
      ) {
        fbRefAsNonNull()
      }
      fbStructGet(sHeapIdx[msi], sFieldIndex(msi, vrecv.memProp))
      boxTagIsTail(armTag)
    }
    "memVariant" => {
      if !(vrecv is Member) {
        return emitFail("emitProgram: internal: a field's `is` lost its member")
      }
      const vi = exprVariantIndex(vrecv.memObj, fnIx)
      if emitExpr(vrecv.memObj, fnIx) < 0 { return -1 }
      fbStructGet(variantHeap(vi), variantFieldIndex(vi, vrecv.memProp))
      boxTagIsTail(armTag)
    }
    "optField" => {
      if !(vrecv is OptMember) {
        return emitFail("emitProgram: internal: a field's `is` lost its chain")
      }
      const si = optChainStructIdxOf(vrecv.omObj, fnIx)
      if si < 0 || si >= sHeapIdx.length {
        return emitFail("emitProgram: internal: a field's `is` lost its record")
      }
      const sv = optRecvStageSave()
      optRecvStageMark(vrecv.omObj)
      if emitOptChainIsNull(vrecv.omObj, fnIx) < 0 { return -1 }
      fbIf(127)
      fbI32Const(0)
      fbElse()
      if emitOptChainValue(vrecv.omObj, fnIx) < 0 { return -1 }
      fbStructGet(sHeapIdx[si], sFieldIndex(si, vrecv.omProp))
      boxTagIsTail(armTag)
      fbEnd()
      optRecvStageRestore(sv)
      1
    }
    "box" => if emitExpr(ndv.isObj, fnIx) < 0 { -1 } else { boxTagIsTail(armTag) }
    "none" => emitFail("emitProgram: internal: an `is` tag arm with no lowering")
  }
}

// The numeric literal test plan `pl` names; 1 once written, -1 on failure.
function emitIsTestNumLit(nd0: IsExpr, fnIx: i32, pl: NumIsPlan) {
  if !pl.nlOnce {
    let nlI = 0
    while nlI < pl.nlTexts.length {
      if emitNumLitEq(nd0.isObj, pl.nlTexts[nlI], fnIx) < 0 { return -1 }
      if nlI > 0 { fbI32Bin(114) }
      nlI = nlI + 1
    }
    return 1
  }
  if emitExpr(nd0.isObj, fnIx) < 0 { return -1 }
  const nlSlot = numLitOnceSlot(pl.nlBase)
  fbLocalSet(nlSlot)
  let nsI = 0
  while nsI < pl.nlTexts.length {
    fbLocalGet(nlSlot)
    emitNumLitConstEq(pl.nlBase, pl.nlTexts[nsI])
    if nsI > 0 { fbI32Bin(114) }
    nsI = nsI + 1
  }
  return 1
}

// Whether no value of the closed record type `rcv` can be record arm `arm`: their field names
// differ, or some shared field shares no value (`recArmFitKind`), as the checker refuses it.
function recNeverFitsArm(arm: i32, rcv: i32): boolean {
  if arm < 0 || rcv < 0 || tyHasTyVar(rcv) { return false }
  if !(tyAt(arm) is TyObj) || !(tyAt(rcv) is TyObj) { return false }
  return recArmFitKind(arm, rcv) == 0
}

// After a box: whether its tag is variant `vi`'s.
export function variantTagTail(vi: i32) {
  fbStructGet(uBoxIdx, 0)
  fbI32Rel(RS_TAG, uTags[vi])
  fbI32Bin(70)
  return 0
}

// The variant rung of `emitIsTest`: `recv is V` for a union variant, alias arm or record,
// by a static row fold where the row is the answer, else the box tag and discriminant test.
// Returns 0 once the test is on the stack, -1 on failure.
function emitIsTestVariant(isIx: i32, nd: IsExpr, fnIx: i32) {
  const plain = isVariantTagPlain(isIx, fnIx)
  if plain >= 0 {
    if emitExpr(nd.isObj, fnIx) < 0 { return -1 }
    return variantTagTail(plain)
  }
  const vi = isTestedRowOf(isVarTyIxOf(isIx), nd.isObj)
  if vi < 0 {
    if recvIsTestedRecord(nd.isObj, isVarTyIxOf(isIx)) {
      if emitExpr(nd.isObj, fnIx) < 0 { return -1 }
      fbDrop()
      fbI32Const(1)
      return 0
    }
    // A union alias arm has no single variant row because it is a SUBSET of the outer
    // box's tags, so the test is the tag chain `as?` already emits for a sub-union target
    // (D1774). A layout-twin arm is excluded: its tag alone does not settle membership,
    // and the per-arm discriminant test has no home inside a chain.
    const isTags: i32[] = []
    const isVis: i32[] = []
    if unionArmTagsOfTy(isVarTyIxOf(isIx), -1, isTags, isVis) {
      let chainOk = isTags.length > 1
        && exprUnion(nd.isObj, fnIx)
        && unionEqOperandOk(nd.isObj)
      // A variant told apart by a field's value shares its tag; the tag alone answers where
      // every operand arm holding that tag is tested (`tyTestMeet`'s members, D16320).
      const opTags: i32[] = []
      const opVis: i32[] = []
      const opArms = unionArmTagsOfTy(
        nodeTyAt(nd.isObj, fnIx),
        -1,
        opTags,
        opVis,
      )
      let ci = 0
      while ci < isVis.length {
        if (
          variantHasDiscrimField(isVis[ci])
          && !(opArms && isTagWhollyTested(isTags[ci], opTags, opVis, isVis))
        ) {
          chainOk = false
        }
        ci = ci + 1
      }
      if chainOk {
        let ti = 0
        while ti < isTags.length {
          if emitExpr(nd.isObj, fnIx) < 0 { return -1 }
          fbStructGet(uBoxIdx, 0)
          fbI32Rel(RS_TAG, isTags[ti])
          fbI32Bin(70)
          if ti > 0 { fbI32Bin(114) }
          ti = ti + 1
        }
        return 0
      }
    }
    // A record no union of the program has as a variant is in no box, so a box's test of it
    // is false, as a pin whose join lacks it answers (D3344).
    // A `K | null` niche holds no record and no value of a primitive other than `string` (D3344).
    const nlPrim = isTestValuePrimName(isVarTyIxOf(isIx))
    const nlNo = exprNulLitUnion(nd.isObj, fnIx)
      && !exprUnion(nd.isObj, fnIx)
      && ((nlPrim != "" && nlPrim != "string")
      || tyIsRecord(isVarTyIxOf(isIx)))
    // A box of value arms only holds no record.
    const boxr: i32[] = []
    const boxNm = unionNameRowOfExpr(nd.isObj, fnIx, boxr)
    const boxNo = exprUnion(nd.isObj, fnIx)
      && tyIsRecord(isVarTyIxOf(isIx))
      && boxNm != ""
      && (isValueUnionOfSet(msSetOfRow(boxr[0]), boxr[1])
      || unionCarriesLitUnionArmOfSet(msSetOfRow(boxr[0]), boxr[1]))
    // Only a join the checker kept apart over declared parameters reaches here by design.
    if (
      (nlNo || boxNo)
      && fnInPinnedInstance(fnIx)
      && holeOperandTyOf(nd.isObj, fnIx) < 0
      && !criFnIsAnonLambda(fnStmtsPosOf(fnIx))
      && !readIsCallResult(nd.isObj, fnIx)
    ) {
      if emitExpr(nd.isObj, fnIx) < 0 { return -1 }
      fbDrop()
      fbI32Const(0)
      return 0
    }
    if tyIsUnionMemberOf(nodeTyIxOf(nd.isObj), isVarTyIxOf(isIx)) {
      return emitFail(
        "emitProgram: `is` names a declared union member with no interned arm representation (deferred value-union composition)",
      )
    }
    return emitFail(
      "emitProgram: `is` names a type that is not a union variant",
    )
  }

  // A row holding several members answers from the value's fields after its tag (D5157).
  const shared = armRowSharedAtRecv(nd.isObj, vi)
  const rvi = exprVariantIndex(nd.isObj, fnIx)
  if rvi >= 0 && !shared {
    // The static fold is only sound where the row is the answer (D1023).
    // `exprVariantIndex` resolves an object literal by its field-name set, so where two arms
    // share a shape it names whichever row it matched first — and folding `rvi == vi` would
    // answer `is` by the row a value happened to be built under, the nominal answer.

    // A non-box receiver still folds, because for it the row really is all there is: a slot
    // holding the raw variant ref has no tag and no payload to read, so there is no value to
    // ask. Only a boxed receiver whose shape carries a discriminant falls through to the
    // runtime chain.
    const foldOk = !exprUnion(nd.isObj, fnIx)
      || (!variantHasDiscrimField(rvi)
      && !variantHasDiscrimField(vi)
      && !isFitsAcrossTagRows(vi, isVarTyIxOf(isIx), nd.isObj, fnIx))
    if foldOk {
      if rvi == vi { fbI32Const(1) } else { fbI32Const(0) }
      return 0
    }
  }
  if !exprUnion(nd.isObj, fnIx) {
    // An instance's closed record receiver answers by value fit: a record whose fields can
    // never fit the tested arm's is not it (D12520).
    if (
      recNeverFitsArm(isVarTyIxOf(isIx), nodeTyAt(unwrapParen(nd.isObj), fnIx))
    ) {
      if emitExpr(nd.isObj, fnIx) < 0 { return -1 }
      fbDrop()
      fbI32Const(0)
      return 0
    }
    return emitFail("emitProgram: `is` receiver is not a union value")
  }
  // A receiver the cross-arm terms re-read is evaluated once when it is not a place.
  let ctSlot = -1
  if (
    (shared || isFitsAcrossTagRows(vi, isVarTyIxOf(isIx), nd.isObj, fnIx))
    && !unionEqOperandOk(nd.isObj)
  ) {
    ctSlot = sharedFieldRecvSlot()
    if emitExpr(nd.isObj, fnIx) < 0 { return -1 }
    fbLocalSet(ctSlot)
  }
  if emitSharedFieldRecv(nd.isObj, fnIx, ctSlot) < 0 { return -1 }
  variantTagTail(vi)
  if emitVariantDiscrimTest(nd.isObj, vi, fnIx) < 0 { return -1 }
  if shared {
    fbIf(127)
    const sf = emitArmFieldsFit(
      nd.isObj,
      vi,
      uVarTyIx[vi],
      isVarTyIxOf(isIx),
      fnIx,
      ctSlot,
    )
    if sf < 0 { return -1 }
    const nf = emitSharedNestedFits(
      nd.isObj,
      vi,
      isVarTyIxOf(isIx),
      fnIx,
      ctSlot,
    )
    if nf < 0 { return -1 }
    fbElse()
    fbI32Const(0)
    fbEnd()
  }
  const ctIs = emitCrossTagFits(nd.isObj, vi, isVarTyIxOf(isIx), fnIx, ctSlot)
  if ctIs < 0 { return -1 }
  return 0
}

// `recv is X` over an operand read at its storage rep. Fixed,
// load-bearing arm order: niche null tests, atom/literal-union membership, box-tag compares,
// mono-static folds, then the variant tag+discriminant compare. A niche `is` assumes the checker
// proved the tested shape is the sole non-null member, which monomorphization can break (D950).
function emitIsTest(isIx: i32, fnIx: i32) {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) { return emitIsTestRungs(isIx, fnIx) }
  // A map tested against a narrower map is the content check the checker minted (D2701).
  if nd.isFit >= 0 { return emitExpr(nd.isFit, fnIx) }
  const rep = isRecvStageRep(isIx, fnIx)
  if rep < 0 { return emitIsTestRungs(isIx, fnIx) }
  if emitExpr(nd.isObj, fnIx) < 0 { return -1 }
  const slot = isRecvStashSlot(rep)
  fbLocalSet(slot)
  const svIx = isRecvStagedIx
  const svSlot = isRecvStagedSlot
  const svNonNull = isRecvStagedNonNull
  isRecvStagedIx = unwrapParen(nd.isObj)
  isRecvStagedSlot = slot
  isRecvStagedNonNull = rep == 3
  const r = emitIsTestRungs(isIx, fnIx)
  isRecvStagedIx = svIx
  isRecvStagedSlot = svSlot
  isRecvStagedNonNull = svNonNull
  return r
}

export function isArmRank(a: IsArm): i32 {
  return match a {
    "optNull" => 0
    "nullInst" => 1
    "never" => 2
    "floatLits" => 3
    "recordFit" => 4
    "listFit" => 5
    "listAcross" => 6
    "pinNever" => 7
    "litArms" => 8
    "emptyFit" => 9
    "armTag" => 10
    "numLit" => 11
    "litMember" => 12
    "nulTest" => 13
    "noMembership" => 14
    "static" => 15
    "nulClosure" => 16
    "noUnion" => 17
    "variant" => 18
    "notIs" => 19
  }
}

// Evaluates a receiver that is not a re-readable place and drops it, then answers `v`.
function isConstAfterRecv(nd: IsExpr, v: i32, fnIx: i32): i32 {
  if !unionEqOperandOk(nd.isObj) {
    if emitExpr(nd.isObj, fnIx) < 0 { return -1 }
    fbDrop()
  }
  fbI32Const(v)
  return 1
}

// Rung `arm` of `is` test `isIx`: 1 once written, -1 on failure, 0 where a try rung declines.
function emitIsArm(isIx: i32, fnIx: i32, arm: IsArm): i32 {
  const nd = nodeAt(isIx)
  // Only `noUnion` and `notIs` reach a node that is no `is`.
  if !(nd is IsExpr) {
    if arm == "noUnion" {
      return emitFail("emitProgram: `is` test but no union type declared")
    }
    if isIx < 0 { return -1 }
    return emitFail("emitProgram: expected an `is` expression")
  }
  return match arm {
    "optNull" => {
      const sv = optRecvStageSave()
      optRecvStageMark(nd.isObj)
      const rc = emitOptChainIsNull(nd.isObj, fnIx)
      optRecvStageRestore(sv)
      if rc < 0 { -1 } else { 1 }
    }
    "nullInst" => {
      fbI32Const(nullInstanceIsResult(isIx, fnIx))
      1
    }
    "never" | "pinNever" => isConstAfterRecv(nd, 0, fnIx)
    "floatLits" => {
      const fx = tyNumLitMemberTexts(isVarTyIxOf(isIx))
      let fi = 0
      while fi < fx.length {
        if emitUnionLitIs(nd.isObj, fx[fi], fnIx) < 0 { return -1 }
        if fi > 0 { fbI32Bin(114) }
        fi = fi + 1
      }
      1
    }
    "recordFit" => emitRecordFitIs(isIx, fnIx)
    "listFit" => emitListFitIs(isIx, fnIx)
    "listAcross" => emitListIsAcrossReps(isIx, fnIx)
    "litArms" => emitIsTestLitArms(isIx, nd, fnIx, litIsArmOf(isIx, nd, fnIx))
    "emptyFit" => emitListEmptyFitIs(isIx, fnIx)
    "armTag" => emitIsTestArmTag(isIx, nd, fnIx, tagIsArmOf(isIx, nd, fnIx))
    "numLit" => emitIsTestNumLit(nd, fnIx, numIsPlanOf(isIx, nd, fnIx))
    "litMember" => {
      if (
        emitLitMemberEq(nd.isObj, isTestedLitLex(isVarTyIxOf(isIx)), fnIx)
        < 0
      ) {
        return -1
      }
      1
    }
    "nulTest" => {
      // An impossible test still evaluates a receiver that is not a re-readable place.
      if nulNicheIsTestImpossible(nd.isObj, isVarTyIxOf(isIx), fnIx) {
        return isConstAfterRecv(nd, 0, fnIx)
      }
      if emitNulIsNullTest(nd.isObj, fnIx, !isTestsNull(isIx), true) < 0 {
        return -1
      }
      1
    }
    "noMembership" => emitFailNoMembershipRecv()
    "static" => {
      const st = monoStaticIsResult(isIx, fnIx)
      if st == 0 {
        const ef = emitListEmptyFitIs(isIx, fnIx)
        if ef < 0 { return -1 }
        if ef > 0 { return 1 }
      }
      // A static answer still evaluates a receiver that is not a re-readable place (D12070).
      isConstAfterRecv(nd, st, fnIx)
    }
    "nulClosure" => {
      if emitExpr(nd.isObj, fnIx) < 0 { return -1 }
      fbRefIsNull()
      fbI32Eqz()
      1
    }
    "noUnion" => emitFail("emitProgram: `is` test but no union type declared")
    "variant" => if emitIsTestVariant(isIx, nd, fnIx) < 0 { -1 } else { 1 }
    "notIs" => emitFail("emitProgram: expected an `is` expression")
  }
}

// The rungs of `emitIsTest`, over a receiver staged or read in place.
function emitIsTestRungs(isIx: i32, fnIx: i32) {
  const nd = nodeAt(isIx)
  const staged = nd is IsExpr && isRecvStagedIx == unwrapParen(nd.isObj)
  let arm = isArmOf(isIx, fnIx, 0, staged)
  let r = emitIsArm(isIx, fnIx, arm)
  while r == 0 {
    arm = isArmOf(isIx, fnIx, isArmRank(arm) + 1, staged)
    r = emitIsArm(isIx, fnIx, arm)
  }
  return if r < 0 { -1 } else { 0 }
} // `recv is X` over a box whose other arms sit under their own tags yet may hold values that fit
// `X` (D4056): `i32.or`s onto the tag test one term per such arm `Y` — its tag alone when every
// `Y` fits, else its tag and then, inside an `if`, a test of each field that only some values fit.
function emitCrossTagFits(
  recv: i32,
  vi: i32,
  xTy: i32,
  fnIx: i32,
  slot: i32,
): i32 {
  const rows: i32[] = []
  const kinds: i32[] = []
  crossTagFitRows(vi, xTy, recv, rows, kinds, fnIx)
  let i = 0
  while i < rows.length {
    const yi = rows[i]
    if emitSharedFieldRecv(recv, fnIx, slot) < 0 { return -1 }
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, uTags[yi])
    fbI32Bin(70)
    if kinds[i] == 2 {
      fbIf(127)
      const ff = emitArmFieldsFit(recv, yi, uVarTyIx[yi], xTy, fnIx, slot)
      if ff < 0 { return -1 }
      fbElse()
      fbI32Const(0)
      fbEnd()
    }
    fbI32Bin(114) // i32.or
    i = i + 1
  }
  return 0
}

// Leaves 1 when the payload of arm `yi` (arena `yTy`) fits record `xTy` field by field, given that
// its tag already matched. A field only some values fit is either a scalar tested against the
// literal set `xTy` narrows it to, or a box whose every member fits or does not, answered by its
// tag. Anything finer is refused by name.
function emitArmFieldsFit(
  recv: i32,
  yi: i32,
  yTy: i32,
  xTy: i32,
  fnIx: i32,
  slot: i32,
): i32 {
  if yi < 0 || yi >= uVarRow.length {
    return emitFail(
      "emitProgram: `is` across record arms names an arm with no row",
    )
  }
  const names: string[] = []
  const fys: i32[] = []
  const fxs: i32[] = []
  recArmPartialFields(xTy, yTy, names, fys, fxs)
  let i = 0
  while i < names.length {
    const fi = variantFieldIndex(yi, names[i])
    // A field that never holds `null` is tested against the set's non-null members alone.
    let fxSet = fxs[i]
    if nonNullTy(fys[i]) == fys[i] { fxSet = nonNullTy(fxSet) }
    // A nullable string field answers its null apart, then tests only non-null strings: all
    // fit, none does, or they are compared against the set's string members.
    const nulStr = fi >= 0 && fieldRowIsStr(uFieldStart[yi] + fi, true)
    let nnKind = 2
    if nulStr { nnKind = tyFitKind(nonNullTy(fys[i]), fxSet) }
    const lexes = tyLitSetMemberLexes(
      if nulStr { nonNullTy(fxSet) } else { fxSet },
    )
    if (
      fi >= 0
      && !fieldRowIsUnionBox(uFieldStart[yi] + fi)
      && (lexes.length > 0 || nnKind != 2)
    ) {
      if nulStr {
        if emitSharedFieldRecv(recv, fnIx, slot) < 0 { return -1 }
        fbStructGet(uBoxIdx, 1)
        fbRefCast(variantHeap(yi))
        fbStructGet(variantHeap(yi), fi)
        fbRefIsNull()
        fbIf(127)
        fbI32Const(if nonNullTy(fxSet) != fxSet { 1 } else { 0 })
        fbElse()
        if nnKind != 2 { fbI32Const(nnKind) }
      }
      let li = 0
      if nnKind != 2 { li = lexes.length }
      while li < lexes.length {
        if emitSharedFieldRecv(recv, fnIx, slot) < 0 { return -1 }
        fbStructGet(uBoxIdx, 1)
        fbRefCast(variantHeap(yi))
        fbStructGet(variantHeap(yi), fi)
        if nulStr { fbRefAsNonNull() }
        if (emitFieldLitEq(uFieldStart[yi] + fi, lexes[li], fnIx) < 0) {
          return -1
        }
        if li > 0 {
          fbI32Bin(114) // i32.or
        }
        li = li + 1
      }
      if nulStr { fbEnd() }
      if i > 0 {
        fbI32Bin(113) // i32.and
      }
      i = i + 1
      continue
    }
    // A nested record only some of whose values fit is tested field by field, one level down.
    if (
      fi >= 0
      && fieldRowIsRecordRef(uFieldStart[yi] + fi)
      && tyAt(fys[i]) is TyObj
      && tyAt(fxs[i]) is TyObj
    ) {
      const nsi = sFieldTgtStructIdx(variantRowOf(yi), fi)
      const nslot = objOrderStashSlot(
        "nulstruct",
        FC_STRUCT,
        uFieldStorageSlot(yi, fi),
      )
      if emitSharedFieldRecv(recv, fnIx, slot) < 0 { return -1 }
      fbStructGet(uBoxIdx, 1)
      fbRefCast(variantHeap(yi))
      fbStructGet(variantHeap(yi), fi)
      fbLocalSet(nslot)
      if emitRecordValueFits(nsi, nslot, fxs[i], fnIx) < 0 { return -1 }
      if i > 0 {
        fbI32Bin(113) // i32.and
      }
      i = i + 1
      continue
    }
    if fi < 0 || !fieldRowIsUnionBox(uFieldStart[yi] + fi) {
      return emitFail(
        "emitProgram: `is` across record arms whose shared field holds a value only some of which fit, outside a union box",
      )
    }
    const yes: i32[] = []
    const no: i32[] = []
    // A scalar member only some of whose values fit: its tag and its atom kind.
    const partTags: i32[] = []
    const partKinds: i32[] = []
    const mems: i32[] = []
    flattenVariantsInto(fys[i], mems)
    for mm in mems {
      const fk = tyFitKind(mm, fxs[i])
      const tags: i32[] = []
      const vis: i32[] = []
      if !unionArmTagsOfTy(mm, -1, tags, vis) || tags.length != 1 {
        return emitFail(
          "emitProgram: `is` across record arms whose shared field's box holds a member with no one tag",
        )
      }
      if fk == 2 {
        const ak = scalarArmKindOfTy(mm)
        if boxFitLexes(ak, fxs[i]).length == 0 {
          return emitFail(
            "emitProgram: `is` across record arms whose shared field's box holds a member only some of whose values fit, and they are not a literal set",
          )
        }
        partTags.push(tags[0])
        partKinds.push(ak)
      } else if fk == 1 {
        yes.push(tags[0])
      } else {
        no.push(tags[0])
      }
    }
    for t in yes {
      if i32ListHas(no, t) || i32ListHas(partTags, t) {
        return emitFail(
          "emitProgram: `is` across record arms whose shared field's box tags a fitting and a non-fitting member alike",
        )
      }
    }
    for t in partTags {
      if i32ListHas(no, t) {
        return emitFail(
          "emitProgram: `is` across record arms whose shared field's box tags a fitting and a non-fitting member alike",
        )
      }
    }
    if yes.length == 0 && partTags.length == 0 { fbI32Const(0) }
    let j = 0
    while j < yes.length {
      if emitArmBoxField(recv, yi, fi, fnIx, slot) < 0 { return -1 }
      fbStructGet(uBoxIdx, 0)
      fbI32Rel(RS_TAG, yes[j])
      fbI32Bin(70)
      if j > 0 { fbI32Bin(114) }
      j = j + 1
    }
    let pj = 0
    while pj < partTags.length {
      // The member's tag, then inside it its payload against the fitting literals.
      if emitArmBoxField(recv, yi, fi, fnIx, slot) < 0 { return -1 }
      fbStructGet(uBoxIdx, 0)
      fbI32Rel(RS_TAG, partTags[pj])
      fbI32Bin(70)
      fbIf(127)
      const partLexes = boxFitLexes(partKinds[pj], fxs[i])
      let lj = 0
      while lj < partLexes.length {
        if emitArmBoxField(recv, yi, fi, fnIx, slot) < 0 { return -1 }
        if emitUnionUnboxTail(partKinds[pj]) < 0 { return -1 }
        if emitAtomLitEq(partKinds[pj], partLexes[lj], fnIx) < 0 { return -1 }
        if lj > 0 { fbI32Bin(114) }
        lj = lj + 1
      }
      fbElse()
      fbI32Const(0)
      fbEnd()
      if j + pj > 0 { fbI32Bin(114) }
      pj = pj + 1
    }
    if i > 0 {
      fbI32Bin(113) // i32.and
    }
    i = i + 1
  }
  if names.length == 0 { fbI32Const(1) }
  return 0
}

// The arm-`yi` payload's field `fi`, a union box, read off the receiver.
function emitArmBoxField(
  recv: i32,
  yi: i32,
  fi: i32,
  fnIx: i32,
  slot: i32,
): i32 {
  if emitSharedFieldRecv(recv, fnIx, slot) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1)
  fbRefCast(variantHeap(yi))
  fbStructGet(variantHeap(yi), fi)
  return 0
}

// The literal members of `fx` a box payload of atom kind `ak` can equal: the quoted ones for a
// string, the numeric ones for `i32`, `i64` or `f64`; none for any other kind.
function boxFitLexes(ak: i32, fx: i32): string[] {
  const out: string[] = []
  if ak != 0 && ak != 2 && ak != 3 && ak != 4 { return out }
  const ms: i32[] = []
  flattenVariantsInto(fx, ms)
  for m in ms {
    const mt = tyAt(m)
    if mt is TyLit {
      if ak == 2 && mt.litKind == "str" { out.push(quoteLex(mt.litText)) }
      if ak != 2 && mt.litKind == "int" { out.push(mt.litText) }
    }
  }
  return out
}

// Compares the unboxed payload of atom kind `ak` on the stack with literal `lex`, leaving an i32.
function emitAtomLitEq(ak: i32, lex: string, fnIx: i32): i32 {
  if ak == 2 { return emitStrEqLit(mkStr(lex, -1), fnIx) }
  if ak == 0 {
    fbI32Const(parseI32(lex))
    fbI32Bin(70) // 0x46 i32.eq
    return 0
  }
  if ak == 3 {
    const pr = parseI64Pair(lex)
    fbI64Const(pr[0], pr[1])
    fbI32Bin(81) // 0x51 i64.eq
    return 0
  }
  if ak == 4 {
    fbF64Const(lex)
    fbI32Bin(97) // 0x61 f64.eq
    return 0
  }
  return emitFail(
    "emitProgram: a box payload of this atom kind has no literal compare",
  )
}

// The `string | null` read rule for a field of code `code`, shared by every struct and variant
// field read and by the ident reads in `emitIdentNode`: a value read recovers the non-null ref.
// A read typed `string | null` keeps the raw ref (`nulStrReadRecovers`).
function emitNulStrFieldRecover(r: i32, readIx: i32, fnIx: i32) {
  if fieldRowIsStr(r, true) && nulStrReadRecovers(readIx, fnIx) {
    fbRefAsNonNull()
  }
  return 0
}

// After a box: its payload cast to variant `vi`'s struct.
export function narrowedVariantTail(vi: i32) {
  fbStructGet(uBoxIdx, 1)
  fbRefCast(variantHeap(vi))
  return 0
}

// After a box narrowed to variant `vi`: its payload as that variant, then field `idx`, recovered
// non-null where a narrowed `string | null` field reads present.
export function narrowedFieldTail(vi: i32, idx: i32, memIx: i32, fnIx: i32) {
  narrowedVariantTail(vi)
  return variantFieldTail(vi, idx, memIx, fnIx)
}

// After a variant `vi`'s struct: its field `idx`, recovered non-null where a narrowed
// `string | null` field reads present.
export function variantFieldTail(vi: i32, idx: i32, memIx: i32, fnIx: i32) {
  fbStructGet(variantHeap(vi), idx)
  return emitNulStrFieldRecover(uFieldStart[vi] + idx, memIx, fnIx)
}

// After struct `si`'s ref: its field `idx`, recovered non-null where a narrowed `string | null`
// field reads present.
export function structFieldTail(si: i32, idx: i32, memIx: i32, fnIx: i32) {
  fbStructGet(sHeapIdx[si], idx)
  return emitNulStrFieldRecover(sFieldStart[si] + idx, memIx, fnIx)
}

// After a narrowed box's receiver: variant `vi`'s field `idx` (`narrowedFieldTail`), then a
// union-box field's unbox (`unionFieldNarrowUnboxOf`). A value-union field read while the checker
// types it as one atom unboxes to that atom, through the home the bare-arm twin uses: an
// index-rooted path has no member key, so only that home's arm sees `xs[0].r` (D8145).
export function narrowedMemTail(vi: i32, idx: i32, memIx: i32, fnIx: i32) {
  narrowedFieldTail(vi, idx, memIx, fnIx)
  if fieldRowIsUnionBox(uFieldStart[vi] + idx) {
    return emitUnionFieldNarrowUnbox(memIx, fnIx)
  }
  return 0
}

// Lower a narrowed field read `recv.field` where `recv` is narrowed to `narrowVariant` by
// an enclosing `if recv is Variant`: evaluate the box, `struct.get $box 1`, `ref.cast (ref
// $variant)` (non-null: a box never is), then `struct.get` the field. Resolves the variant
// from the receiver's own active narrowing, so two simultaneously-narrowed locals agree.
function emitNarrowedMem(memIx: i32, fnIx: i32) {
  const m = nodeAt(memIx)
  if m is Member {
    const vi = memNarrowVariantIndex(memIx, fnIx)
    if vi < 0 {
      return emitFail("emitProgram: narrowed receiver names no union variant")
    }
    const idx = variantFieldIndex(vi, m.memProp)
    if idx < 0 {
      return emitFail(
        "emitProgram: unknown variant field in narrowed field access",
      )
    }
    if emitExpr(m.memObj, fnIx) < 0 { return -1 }
    return narrowedMemTail(vi, idx, memIx, fnIx)
  }
  return emitFail("emitProgram: expected a field access")
}

// Is the `?.` chain base at `exprIx` the one currently staged in `optRecvSlot`?
function optRecvStagedAt(exprIx: i32): boolean {
  if optRecvStagedIx < 0 { return false }
  return optRecvStagedIx == unwrapParen(exprIx)
}

// Mark the base of the `?.` chain at `exprIx` for staging, when it is not a re-readable
// place. Writes no bytes: the first `emitOptRecvBase` tees the value in, so an arm that
// never re-reads the receiver — the fused map and `.get` forms — pays nothing.
function optRecvStageMark(exprIx: i32) {
  if !optChainStagesRecv(exprIx) { return 0 }
  const base = optChainBaseOf(exprIx)
  if base < 0 { return 0 }
  // Re-marking a base already teed in KEEPS the tee: the value is in the slot, and clearing
  // the flag would evaluate the receiver a second time (D1826).
  if optRecvStagedIx == base && optRecvStagedSet { return 0 }
  optRecvStagedIx = base
  optRecvStagedSet = false
  return 0
}

// The `?.` stash marker as one saved value, for a lowering that nests another chain inside
// this one. Paired with `optRecvStageRestore`, which is where the tee survives.
function optRecvStageSave(): i32[] {
  const sv: i32[] = []
  sv.push(optRecvStagedIx)
  sv.push(if optRecvStagedSet { 1 } else { 0 })
  return sv
}

// Put back what `optRecvStageSave` took — except the tee, which SURVIVES when both scopes
// stage the same base: the inner lowering already left that value in the slot, and every
// later read of it is a `local.get` rather than a second evaluation of the receiver (D1826).
function optRecvStageRestore(sv: i32[]) {
  const wasSet = optRecvStagedSet && optRecvStagedIx == sv[0]
  optRecvStagedIx = sv[0]
  optRecvStagedSet = wasSet || sv[1] == 1
  return 0
}

// Push the `?.` chain base at `exprIx`: the stash when this chain stages it — teed in on the
// first read, which every arm emits unconditionally before the branch that reads it again —
// else the expression itself, byte for byte what an un-staged chain has always emitted.
// `asRef` casts the stash back to the base's own struct row; `ref.is_null` needs no cast.
function emitOptRecvBase(exprIx: i32, fnIx: i32, asRef: boolean) {
  if !optRecvStagedAt(exprIx) { return emitExpr(exprIx, fnIx) }
  if optRecvStagedSet {
    fbLocalGet(optRecvSlot)
  } else {
    if !fnUses.optRecv {
      return emitFailAt("emitProgram: `?.` receiver stash not reserved", exprIx)
    }
    if emitExpr(exprIx, fnIx) < 0 { return -1 }
    fbLocalTee(optRecvSlot)
    optRecvStagedSet = true
  }
  if !asRef { return 0 }
  const sri = structIndexOfExpr(exprIx, fnIx)
  if sri < 0 {
    return emitFailAt(
      "emitProgram: a staged `?.` receiver names no struct row",
      exprIx,
    )
  }
  fbRefCast(sHeapIdx[sri])
  return 0
}

// How struct `si`'s field `fi` encodes `null`, in `rdNul`'s vocabulary: 0 never null, 1 a null
// ref, 2 the boolean sentinel `2`, 3 the literal-union sentinel `-1`, 4 the box's null tag. A
// record field answers 1, its slot being a nullable ref; the `null` unit's slot answers 0.
function optChainLeafNulDisc(si: i32, fi: i32): i32 {
  const r = sFieldStart[si] + fi
  const k = fieldRowKind(r)
  if k == null { return 0 }
  match k {
    "nulstruct" | "nulvariant" | "nulstr" | "nulclosure" | "nullist" | "nulreflist" | "nulmap" | "nulu8list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulf64list" | "nulstrlist" => {
      return 1
    }
    "nulbool" => {
      return 2
    }
    "i32" => {
      return if fieldRowIsPlainI32(r) { 0 } else { 3 }
    }
    "union" => {
      return 4
    }
    "i64" | "f64" | "f32" | "v128" | "struct" | "list" | "str" | "reflist" | "map" | "variant" | "closure" | "nulnone" | "u8list" | "i64list" | "f32list" | "v128list" | "f64list" | "strlist" => {
      return 0
    }
  }
}

// Consume the value of struct `si`'s field `fi` and push 1 when it is that field's `null`.
// Only called for a field `optChainLeafNulDisc` answers non-zero for.
function emitOptChainLeafNulTest(si: i32, fi: i32) {
  const disc = optChainLeafNulDisc(si, fi)
  if disc == 1 { return fbRefIsNull() }
  if disc == 4 {
    fbStructGet(uBoxIdx, 0) // field 0: the tag
    fbI32Rel(RS_TAG, nullBoxTag())
    return fbI32Bin(70) // 0x46 i32.eq
  }
  if disc == 2 { fbI32Const(2) } else { fbI32Const(0 - 1) }
  return fbI32Bin(70) // 0x46 i32.eq
}

// Push 1 if the optional-chain value at `exprIx` is null — any null link folds `null`
// through — else 0. A leaf whose field can hold `null` tests that field's own encoding of
// it (`optChainLeafNulDisc`); any other leaf is never null once every link held.
function emitOptChainIsNull(exprIx: i32, fnIx: i32) {
  const e = nodeAt(unwrapParen(exprIx))
  if e is OptMember {
    const psi = optChainStructIdxOf(e.omObj, fnIx)
    if psi < 0 {
      return emitFail("emitProgram: `?.` receiver is not a struct chain")
    }
    const pfi = sFieldIndex(psi, e.omProp)
    if pfi < 0 {
      return emitFail("emitProgram: `?.` field is not on the struct")
    }
    if emitOptChainIsNull(e.omObj, fnIx) < 0 { return -1 }
    fbIf(127)
    fbI32Const(1)
    fbElse()
    if optChainLeafNulDisc(psi, pfi) == 0 {
      fbI32Const(0)
    } else {
      if emitOptChainValue(e.omObj, fnIx) < 0 { return -1 }
      fbStructGet(sHeapIdx[psi], pfi)
      emitOptChainLeafNulTest(psi, pfi)
    }
    fbEnd()
    return 0
  }
  if emitOptRecvBase(exprIx, fnIx, false) < 0 { return -1 }
  fbRefIsNull()
  return 0
}

// Push the non-null value of the optional-chain receiver at `exprIx`, assuming every link
// is already null-tested: each nullable link recovers `ref.as_non_null`. Sole-member
// niches only — a nullable box must not be recovered here, since this also feeds the `is`
// receiver and a `Shape | null` box is legitimately null at the moment its tag is tested.
function emitOptChainValue(exprIx: i32, fnIx: i32) {
  const e = nodeAt(unwrapParen(exprIx))
  if e is OptMember {
    const psi = optChainStructIdxOf(e.omObj, fnIx)
    if psi < 0 {
      return emitFail("emitProgram: `?.` receiver is not a struct chain")
    }
    const pfi = sFieldIndex(psi, e.omProp)
    if pfi < 0 {
      return emitFail("emitProgram: `?.` field is not on the struct")
    }
    if emitOptChainValue(e.omObj, fnIx) < 0 { return -1 }
    fbStructGet(sHeapIdx[psi], pfi)
    fbRefAsNonNull()
    return 0
  }
  // The cast off the stash already recovers a non-null ref; the in-place spelling recovers
  // its own niche.
  if optRecvStagedAt(exprIx) { return emitOptRecvBase(exprIx, fnIx, true) }
  if emitExpr(exprIx, fnIx) < 0 { return -1 }
  if (
    exprNullableRefNiche(exprIx, fnIx)
    && !readOwesNonNullRecover(exprIx, fnIx)
  ) {
    fbRefAsNonNull()
  }
  return 0
}

// The heap type a `?.` leaf at struct `si`'s field `fi` delivers as `F | null`: a list field's
// own storage heap, the one the type section writes, so the value this arm builds and the slot it
// reads cannot name different types. -1 for any other leaf; a scalar rides the box instead.
function optChainLeafRefHeap(si: i32, fi: i32): i32 {
  const k = fieldRowKind(sFieldStart[si] + fi)
  if k == null { return -1 }
  match k {
    "list" | "nullist" => {
      return lTy()
    }
    "strlist" | "nulstrlist" => {
      return mkListTy()
    }
    "f64list" | "nulf64list" => {
      return fl64Ty()
    }
    "i64list" | "nuli64list" => {
      return il64Ty()
    }
    "f32list" | "nulf32list" => {
      return fl32Ty()
    }
    "v128list" | "nulv128list" => {
      return fl128Ty()
    }
    "u8list" | "nulu8list" => {
      if si < 0 || si >= sFieldStart.length { return -1 }
      return pkWrapAt(fieldRowPackedRow(sFieldStart[si] + fi))
    }
    "reflist" | "nulreflist" => {
      const rs = sFieldRefSlot(si, fi)
      if rs < 0 || rs >= rlWrapIdx.length { return -1 }
      return rlWrapIdx[rs]
    }
    "i32" | "i64" | "f64" | "f32" | "v128" | "struct" | "str" | "union" | "map" | "variant" | "nulvariant" | "nulstruct" | "closure" | "nulstr" | "nulbool" | "nulclosure" | "nulmap" | "nulnone" => {
      return -1
    }
  }
}

// Whether a `?.` leaf of kind `k` has a rep the standalone arms build: an `i32` (a number, a
// boolean, an atom or its `K | null` niche), a string, `string | null`, `boolean | null` or the box.
function optChainLeafBoxable(k: VKind | null): boolean {
  return k == "i32"
    || k == "str"
    || k == "nulstr"
    || k == "nulbool"
    || k == "union"
}

// The four `.get` staging markers as one saved value, so a nested `.get` — one in a `?? d`
// default arm — restores the outer call's marker instead of losing it. Packed rather than
// four locals per site: the two indices are arena positions, the two flags are bits.
function listGetStageSave(): i32[] {
  const sv: i32[] = []
  sv.push(listGetIdxStagedIx)
  sv.push(if listGetIdxStagedSet { 1 } else { 0 })
  sv.push(listGetRecvStagedIx)
  sv.push(if listGetRecvStagedSet { 1 } else { 0 })
  return sv
}

// Put back what `listGetStageSave` took.
function listGetStageRestore(sv: i32[]) {
  listGetIdxStagedIx = sv[0]
  listGetIdxStagedSet = sv[1] == 1
  listGetRecvStagedIx = sv[2]
  listGetRecvStagedSet = sv[3] == 1
  return 0
}

// Mark a `.get(i)` call's index and receiver for staging, each when it is not a re-readable
// place. Writes no bytes: the first read tees the value in, and every arm emits its bounds
// compare before the element read, so the tee dominates (D1677).
function listGetStageMark(callIx: i32) {
  const c = nodeAt(unwrapParen(callIx))
  if c is Call {
    const callee = nodeAt(unwrapParen(c.callFn))
    if callee is Member {
      if !optRecvReReadable(callee.memObj) {
        listGetRecvStagedIx = unwrapParen(callee.memObj)
        listGetRecvStagedSet = false
      }
      if c.callArgs.length == 1 {
        if !listGetIdxReReadable(c.callArgs[0]) {
          listGetIdxStagedIx = unwrapParen(c.callArgs[0])
          listGetIdxStagedSet = false
        }
      }
    }
  }
  return 0
}

// Push a `.get` index: the i32 stash when this call staged it, teed in on the first read,
// else the expression itself — byte for byte what an un-staged index has always emitted.
function emitListGetIdx(idxIx: i32, fnIx: i32) {
  if listGetIdxStagedIx < 0 || listGetIdxStagedIx != unwrapParen(idxIx) {
    return emitExpr(idxIx, fnIx)
  }
  if listGetIdxStagedSet {
    fbLocalGet(listGetIdxSlot)
    return 0
  }
  if !fnUses.listGet {
    return emitFailAt("emitProgram: `.get` operand stash not reserved", idxIx)
  }
  if emitExpr(idxIx, fnIx) < 0 { return -1 }
  fbLocalTee(listGetIdxSlot)
  listGetIdxStagedSet = true
  return 0
}

// Push a `.get` receiver: the `(ref null struct)` stash cast back to the list's own wrapper
// heap when this call staged it, else the expression itself. `heap` is that wrapper.
function emitListGetRecv(objIx: i32, fnIx: i32, heap: i32) {
  if listGetRecvStagedIx < 0 || listGetRecvStagedIx != unwrapParen(objIx) {
    if emitExpr(objIx, fnIx) < 0 { return -1 }
    return svSyncRecv(objIx, fnIx)
  }
  if listGetRecvStagedSet {
    fbLocalGet(listGetRecvSlot)
  } else {
    if !fnUses.listGet {
      return emitFailAt("emitProgram: `.get` operand stash not reserved", objIx)
    }
    if emitExpr(objIx, fnIx) < 0 { return -1 }
    svSyncRecv(objIx, fnIx)
    fbLocalTee(listGetRecvSlot)
    listGetRecvStagedSet = true
  }
  fbRefCast(heap)
  return 0
}

// Lower a standalone optional chain `recv?.f` — in ordinary value position (a `const`/`let`
// initializer, an argument, a `??` left side) — as the value of its own recorded type
// `F | null`. The shape is the fused `?? d` two-arm select with the default replaced by the
// null of the result's own rep, so the arms below dispatch on rep (`repOfNode`), not field.
function emitOptMemberValue(exprIx: i32, fnIx: i32) {
  const omSv = optRecvStageSave()
  optRecvStageMark(exprIx)
  const omR = emitOptMemberValueGo(exprIx, fnIx)
  optRecvStageRestore(omSv)
  return omR
}

// After a `?.` ref leaf: a read typed without `null` here, its receiver present (an instance's
// hole handed a record), is held in a non-null cell, so the nullable ref is recovered (D16857). 0.
function optReadRecoverNonNull(exprIx: i32, fnIx: i32): i32 {
  const t = nodeTyAt(exprIx, fnIx)
  if t >= 0 && tyExcludesNull(t) { fbRefAsNonNull() }
  return 0
}

// The standalone `?.` arms themselves, with the chain's base already staged when it needed
// staging, so every arm below may read the receiver as often as its rep requires.
function emitOptMemberValueGo(exprIx: i32, fnIx: i32) {
  const e = nodeAt(unwrapParen(exprIx))
  if e is OptMember {
    // A read off the `null` unit is the `null` its destination seeded, after the receiver (D16841).
    if exprIsNulNone(exprIx, fnIx) {
      if emitNulNoneForEffect(e.omObj, fnIx) < 0 { return -1 }
      return emitNullAt(exprIx, fnIx)
    }
    const osi = optChainStructIdxOf(e.omObj, fnIx)
    if osi < 0 {
      return emitFailAt(
        "emitProgram: `?.` receiver is not a struct chain",
        exprIx,
      )
    }
    const ofi = sFieldIndex(osi, e.omProp)
    if ofi < 0 {
      return emitFailAt("emitProgram: `?.` field is not on the struct", exprIx)
    }
    const oRow = sFieldStart[osi] + ofi
    const oKind = fieldRowKind(oRow)
    const oRefHeap = optChainLeafRefHeap(osi, ofi)

    // The record leaf, the arm the `?.` producer needs (D1084). `o?.f` over
    // `o: T | null` with `T = {f: S}` has type `S | null`, and the rep for that is the nullable
    // struct ref the whole `nulstruct` family already speaks.

    // Shape-identical to the `nulstr` arm below it, with the field's own target struct as the
    // heap type instead of the string array: a null receiver chain yields `ref.null $S`, a live
    // one reads the field. The `else` arm leaves a `(ref $S)`, a subtype of the block's
    // `(ref null $S)`, so the arms join without a cast. `structIndexOfExpr` is the other half.
    if eqKindIsRecord(oKind) {
      const oti = sFieldTgtStructIdx(osi, ofi)
      if oti < 0 {
        return emitFailAt(
          "emitProgram: `?.` yields a nullable struct whose field names no struct row",
          exprIx,
        )
      }
      if emitOptChainIsNull(exprIx, fnIx) < 0 { return -1 }
      fbIfRefNul(sHeapIdx[oti], true)
      fbRefNull(sHeapIdx[oti])
      fbElse()
      if emitOptChainValue(e.omObj, fnIx) < 0 { return -1 }
      fbStructGet(sHeapIdx[osi], ofi)
      fbEnd()
      return optReadRecoverNonNull(exprIx, fnIx)
    }

    // A LIST leaf, the record arm one table over: `T[] | null` is the list wrapper's own
    // nullable ref, so a null link yields `ref.null $wrap` and a live one reads the field.
    // A nullable-list field is already `(ref null $wrap)`, which the same blocktype accepts.
    if oRefHeap >= 0 {
      if emitOptChainIsNull(exprIx, fnIx) < 0 { return -1 }
      fbIfRefNul(oRefHeap, true)
      fbRefNull(oRefHeap)
      fbElse()
      if emitOptChainValue(e.omObj, fnIx) < 0 { return -1 }
      fbStructGet(sHeapIdx[osi], ofi)
      fbEnd()
      return optReadRecoverNonNull(exprIx, fnIx)
    }
    // A MAP leaf: `{[K]: V} | null` is the field's map struct's own nullable ref, the list
    // arm's shape over the struct `sFieldMapShape` names.
    if oKind == "map" || oKind == "nulmap" {
      const msh = sFieldMapShape(osi, ofi)
      if msh == -3 {
        return emitFailAt(
          "emitProgram: a standalone `?.` map leaf's value type is still open",
          exprIx,
        )
      }
      const mHeap = mapTypeIdxOf(msh)
      if emitOptChainIsNull(exprIx, fnIx) < 0 { return -1 }
      fbIfRefNul(mHeap, true)
      fbRefNull(mHeap)
      fbElse()
      if emitOptChainValue(e.omObj, fnIx) < 0 { return -1 }
      fbStructGet(sHeapIdx[osi], ofi)
      fbEnd()
      return optReadRecoverNonNull(exprIx, fnIx)
    }
    // A function-value leaf: `F | null` is the closure fat pointer's own nullable ref.
    if oKind == "closure" || oKind == "nulclosure" {
      if emitOptChainIsNull(exprIx, fnIx) < 0 { return -1 }
      fbIfRefNul(cloStructIdx, true)
      fbRefNull(cloStructIdx)
      fbElse()
      if emitOptChainValue(e.omObj, fnIx) < 0 { return -1 }
      fbStructGet(sHeapIdx[osi], ofi)
      fbEnd()
      return optReadRecoverNonNull(exprIx, fnIx)
    }
    // The leaf reps this arm can build, in the order the arms below take them: a nullable
    // REF (a list, a map, a function value, a nested struct, a string), the scalar box
    // (i32/boolean/f64/i64/f32), and the value-union box. Any other leaf is named as such.
    if (
      !optChainLeafBoxable(oKind)
      && fieldRowNumKind(oRow) < 0
      && oRefHeap < 0
    ) {
      return emitFailAt(
        "emitProgram: a standalone `?.` has no rep for this leaf field — read it through a `!= null` guard",
        exprIx,
      )
    }
    const ord = repOfNode(exprIx, fnIx)

    // `boolean | null` shares one unconditional i32 blocktype: the sentinel 2 (`null`) and
    // the live 0/1 result are the same valtype, so the two arms below need no cast to join.
    // `K | null` is the same shape over the literal union's atom, `-1` its null.
    if (
      (ord.rdKind == "nulbool" && ord.rdNul == 2)
      || (ord.rdKind == "i32" && ord.rdNul == 3)
    ) {
      if emitOptChainIsNull(exprIx, fnIx) < 0 { return -1 }
      fbIf(127)
      if ord.rdNul == 2 { fbI32Const(2) } else { fbI32Const(0 - 1) }
      fbElse()
      if emitOptChainValue(e.omObj, fnIx) < 0 { return -1 }
      fbStructGet(sHeapIdx[osi], ofi)
      fbEnd()
      return 0
    }

    // `i32 | null` (and a boxed code-16 leaf) rides the `{tag, payload}` box, `null` as the
    // null tag over an unread payload; both heap types are usage-gated against an uncollected union.
    // A wide scalar leaf rides the same box: `f64 | null` and `i32 | null` are one rep with
    // a different tag, so the kind comes from the leaf's own code and never from `i32`.
    const oBoxKind = fieldRowNumKind(oRow)
    if (
      oKind == "union"
      || (ord.rdKind == "union" && ord.rdNul == 4)
      || (oBoxKind > 0 && ord.rdNul == 4)
    ) {
      let ovbKind = 0
      if oBoxKind > 0 { ovbKind = oBoxKind }
      const ovb = vbHeapIdxOfKind(ovbKind)
      if !uDeclared || (oKind != "union" && ovb < 0) {
        return emitFailAt(
          "emitProgram: `?.` yields a nullable scalar but its union box was not collected",
          exprIx,
        )
      }
      if emitOptChainIsNull(exprIx, fnIx) < 0 { return -1 }
      fbOpenIf()
      fbValtype("union", -1)
      fbI32Rel(RS_TAG, nullBoxTag())
      fbRefNullNone()
      fbStructNew(uBoxIdx)
      fbElse()
      if oKind == "union" {
        if emitOptChainValue(e.omObj, fnIx) < 0 { return -1 }
        fbStructGet(sHeapIdx[osi], ofi)
        fbEnd()
        return 0
      }
      fbI32Rel(RS_TAG, scalarTagOfKind(ovbKind))
      if emitOptChainValue(e.omObj, fnIx) < 0 { return -1 }
      fbStructGet(sHeapIdx[osi], ofi)
      fbStructNew(ovb)
      fbStructNew(uBoxIdx)
      fbEnd()
      return 0
    }

    // `string | null` is the nullable raw-array ref niche, so a null link is `ref.null
    // $sTypeIdx` and a present one the field's own string — no box needed.
    if oKind == "nulstr" || (ord.rdKind == "nulstr" && ord.rdNul == 1) {
      if emitOptChainIsNull(exprIx, fnIx) < 0 { return -1 }
      fbIfRefNul(sTy(), true)
      fbRefNull(sTy())
      fbElse()
      if emitOptChainValue(e.omObj, fnIx) < 0 { return -1 }
      fbStructGet(sHeapIdx[osi], ofi)
      fbEnd()
      return 0
    }
    // A chain the hole instance pins non-null is the plain field read, at the field's own rep (D3215).
    if tyProvesNonNull(nodeTyAt(exprIx, fnIx)) {
      if emitOptChainValue(e.omObj, fnIx) < 0 { return -1 }
      fbStructGet(sHeapIdx[osi], ofi)
      return 0
    }
    return emitFailAt(
      "emitProgram: a standalone `?.` has no rep for this result type — read it through `?? d` or a `!= null` guard",
      exprIx,
    )
  }
  return emitFailAt(
    "emitProgram: expected an optional-chain member access",
    exprIx,
  )
}

// Push the raw union box ref of the binding the `Ident` read at `ix` denotes (a local, param,
// capture or module global), bypassing
// the narrowed-unbox Ident path so a tag read works even while the binding is narrowed to a
// single atom — its slot still holds the box, narrowing being type-level only.
function emitUnionBoxPush(ix: i32, fnIx: i32) {
  const rn = nodeAt(ix)
  const name = if rn is Ident { rn.identName } else { "" }
  const idx = localIndexOf(fnIx, ix)
  if idx >= 0 {
    fbLocalGet(idx)
  } else {
    // A captured union box: read the field raw out of the env (`recover` false — the box is
    // the field's type, and the unbox every caller appends after this push is the recovery).
    if emitCapturedRead(name, fnIx, -1) == 1 { return 0 }
    const gIdx = globalIndexOf(name)
    if gIdx < 0 {
      // Neither a local, a capture of this frame, nor a global — nothing to read the box
      // out of. A clean reject, not invalid wasm.
      return emitFail(
        "emitProgram: narrowed union binding is not a local or global",
      )
    }
    if emitUserGlobalGet(gIdx) < 0 { return -1 }
    // A non-const global box rides in a NULLABLE cell (start-fn initialized);
    // recover the non-null box ref (same as the plain Ident global read).
    if globalNameIsNonConstSid(sidOfNode(ix)) { fbRefAsNonNull() }
  }
  return 0
}

// The list wrapper heap type a value-union list atom of kind `k` rides in the box's `anyref`
// payload — directly, with no scalar value box (the `is`-narrow casts to it, the coerce stores
// it) — or -1 when `k` is not a list kind.

// Is this union a value union — the box question, asked of the interned member set the caller
// already resolved, and of the spelling only where the pool declines. `msIsValueUnion` reads
// the member ABI codes off the bank, where the name path scans the whole rendering twice and
// materializes every atom for the same predicate.

// True if a value-union atom of kind `k` is a ref that rides the box's anyref `value` directly
// with no per-rep scalar value box: a string (kind 2 — `valueAtomKind` answers 2 for the
// spelling `string` and nothing else), any list type, or a closure (kind 11 — the fat-pointer
// struct is a `structref` subtype, so it stores into the box's anyref slot as-is).
function atomIsRefKind(k: i32) {
  if k == 2 { return true }
  if k == 11 { return true }
  return listWrapHeapOfKind(k) >= 0
}

// Lower the narrowed value-union ident read at `ix` (active narrowing = a single scalar member,
// arriving as its ABI kind `ak`): push the box, `struct.get $box 1` for the `anyref` payload,
// then recover the atom's rep — a `ref.cast (ref $sTypeIdx)` for a string payload, stored
// unboxed, or a `ref.cast (ref $vb)` plus `struct.get $vb 0` for a scalar in its value box.
function emitValueUnionUnboxRead(ix: i32, ak: i32, fnIx: i32) {
  if emitUnionBoxPush(ix, fnIx) < 0 { return -1 }
  return emitUnionUnboxTail(ak)
}

// Read the name, field or cell at `exprIx`, narrowed to `A | null` for `A` of atom kind `ak`
// (1 boolean, 2 string), as that niche: read once at its storage, which
// delivers the union box, park it, and turn its null tag into the niche's null and any other
// tag into the unboxed payload (D2590).
function emitNarrowedNicheRead(exprIx: i32, ak: i32, fnIx: i32) {
  const sMark = storageReadEnter(exprIx)
  const rc = emitExpr(exprIx, fnIx)
  storageReadLeave(sMark)
  if rc < 0 { return -1 }
  const st = nicheReadStashSlot()
  fbLocalSet(st)
  fbLocalGet(st)
  fbStructGet(uBoxIdx, 0) // field 0: the tag
  fbI32Rel(RS_TAG, nullBoxTag())
  fbI32Bin(70) // 0x46 i32.eq
  if ak == NICHE_NUL_LIT {
    const texts = nulLitMemberTexts(instanceReadTyOf(exprIx, fnIx))
    if texts.length == 0 {
      return emitFail(
        "emitProgram: nullable literal-union read with no members",
      )
    }
    fbIf(127) // 0x04 if, 0x7f i32 result blocktype
    fbI32Const(0 - 1) // the null sentinel
    fbElse()
    const rc3 = emitStashedStrToAtomChain(st, texts, 0, fnIx)
    if rc3 < 0 { return -1 }
    fbEnd()
    return 0
  }
  if ak == 1 {
    fbIf(127) // 0x04 if, 0x7f i32 result blocktype
    fbI32Const(2) // the null sentinel
  } else {
    fbIfRefNul(sTy(), true) // if (result (ref null $sTypeIdx))
    fbRefNull(sTy())
  }
  fbElse()
  fbLocalGet(st)
  if emitUnionUnboxTail(ak) < 0 { return -1 }
  fbEnd()
  return 0
}

// Whether `exprIx` is a value box whose every arm is a string, a literal union or `null`
// (`K | L | null`), which a `string | null` destination reads as its niche (D3382).
function boxIsNulStrUnion(exprIx: i32, fnIx: i32): boolean {
  if !exprUnion(exprIx, fnIx) { return false }
  // Inside an instance a parameter's recorded type is the type variable; ask its pin.
  const pinned = exactOperandTyOf(exprIx, fnIx)
  if pinned >= 0 { return tyIsNulStrBoxUnion(pinned) }
  const own = nodeTyIxOf(unwrapParen(exprIx))
  if tyIsNulStrBoxUnion(own) { return true }
  return tyIsNulStrBoxUnion(elabClosedTyAt(unwrapParen(exprIx), fnIx))
}

// The box on the stack as `string | null`: the null tag is `ref.null`, any other arm's payload
// is the string itself (D3382).
function emitBoxToNulStr() {
  const st = nicheReadStashSlot()
  fbLocalSet(st)
  fbLocalGet(st)
  fbStructGet(uBoxIdx, 0) // field 0: the tag
  fbI32Rel(RS_TAG, nullBoxTag())
  fbI32Bin(70) // 0x46 i32.eq
  fbIfRefNul(sTy(), true)
  fbRefNull(sTy())
  fbElse()
  fbLocalGet(st)
  emitUnionUnboxTail(2)
  fbEnd()
  return 0
}

// The unbox, from a box already on the stack. Extracted from `emitValueUnionUnboxRead` so the
// union `as` cast — whose operand is an expression, not a named binding, and so cannot use
// `emitUnionBoxPush` — recovers an arm the same way a narrowed read does. Two ladders would be
// two chances to disagree about a payload's rep, which in this area is invalid wasm.

// The atom's ABI code decides all four arms (the `string` compare, the closure test, the
// list-wrapper ladder, `vbHeapIdxOfKind`), so `ak` arrives as the code: `emitCoalesce` holds it
// out of the bank rather than rendering a set to be re-parsed here.
export function emitUnionUnboxTail(ak: i32) {
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  if ak == 2 {
    fbRefCast(sTy()) // the payload IS the string array ref
    return 0
  }
  // A CLOSURE atom's payload IS the closure fat-pointer struct — recover it from the box's
  // anyref slot so a narrowed `x is (() => i64)` read yields the callable fat pointer.
  if ak == 11 {
    fbRefCast(cloStructIdx)
    return 0
  }
  const lw = listWrapHeapOfKind(ak)
  if lw >= 0 { return listPayloadCastTail(lw, listCastForPush) }
  const vb = vbHeapIdxOfKind(ak)
  if vb < 0 {
    return emitFail("emitProgram: narrowed union atom has no value box")
  }
  fbRefCast(vb)      // 0xfb 0x16 <value box>
  fbStructGet(vb, 0) // the scalar payload
  return 0
}

// The container half of a place-narrowed union read, from a box already on the stack — the
// member/index place dual of `emitRefArrayUnionUnboxRead` and `emitMapUnionUnboxRead`, which
// both push the box themselves from a name. 1 = a recovery is emitted, 0 = the place carries no
// live container narrowing and the caller leaves the box alone, -1 = a recorded failure.

// The heap type comes from the classifier the consumer already asked, not from a second
// derivation off the narrow stack: `refListSlotOfExprStrict` and `mapShapeOfExpr` are the
// functions `forInElemKind`, `emitIndex` and `emitMapPrep` type themselves against, so a
// delivery casting to a different row than the consumer expects is not expressible here.
function emitPlaceNarrowContainerUnbox(exprIx: i32, fnIx: i32): i32 {
  const con = placeReadContainerAt(exprIx, fnIx)
  if con == RC_REF_LIST {
    const slot = refListSlotOfExprStrict(exprIx, fnIx)
    if slot < 0 || slot >= rlWrapIdx.length {
      return emitFail(
        "emitProgram: narrowed union place ref-array arm has no reflist slot",
      )
    }
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    listPayloadCastTail(rlWrapIdx[slot], listCastForPush)
    return 1
  }
  if con == RC_MAP {
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    // `mapShapeOfExpr` answers the mono sentinel -1 for an atom-valued map exactly as the
    // name resolver does, and `mapTypeIdxOf(-1)` is the shared `$mStructIdx` — so the miss
    // and the hit agree here for the same reason they do in `emitMapUnionUnboxRead`.
    fbRefCast(mapTypeIdxOf(mapShapeOfExpr(exprIx, fnIx)))
    return 1
  }
  return 0
}

// Recover the reflist wrapper ref a union binding read as a ref-element list holds (`x[i]` or
// `x.length` under `if x is S[]`): push the box, read its `anyref` value (field 1), `ref.cast`
// it to the wrapper of the row the read's consumer types itself against.
function emitRefArrayUnionUnboxRead(exprIx: i32, fnIx: i32) {
  if emitUnionBoxPush(exprIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  const slot = refListSlotOfExprStrict(exprIx, fnIx)
  if slot < 0 || slot >= rlWrapIdx.length {
    return emitFail("emitProgram: narrowed ref-array arm has no reflist slot")
  }
  return listPayloadCastTail(rlWrapIdx[slot], listCastForPush)
}

// Set while a `.push` receiver is emitted: an append into a stand-in empty list would be lost,
// so a push keeps the plain cast and traps loudly instead (D4949).
let listCastForPush = false

// Whether reading receiver `recvIx` unboxes a list arm, the read `listPayloadCastTail` casts and
// `listCastForPush` makes strict: a narrowed binding, field or element. Any other shape answers
// true, so a caller that cannot hold the flag misses rather than casting leniently.
export function recvReadsListPayload(recvIx: i32, fnIx: i32): boolean {
  const rx = unwrapParen(recvIx)
  if rx < 0 || rx >= P.nodes.length { return true }
  const e = nodeAt(rx)
  return match e {
    Ident => {
      const k = identReadAtomKindAt(rx, fnIx)
      k >= 0 && listWrapHeapOfKind(k) >= 0
        || identReadContainerAt(rx, fnIx) == RC_REF_LIST
    }
    Member => {
      const k = memNarrowAtomKind(rx, fnIx)
      placeReadContainerAt(rx, fnIx) == RC_REF_LIST
        || k >= 0 && listWrapHeapOfKind(k) >= 0
    }
    Index => {
      const k = if indexElemUnionName(rx, fnIx) != "" { idxNarrowAtomKind(rx, fnIx) } else { -1 }
      placeReadContainerAt(rx, fnIx) == RC_REF_LIST
        || k >= 0 && listWrapHeapOfKind(k) >= 0
    }
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => true
  }
}

// The box's `anyref` payload on the stack, as the list wrapper `wrap` a narrowed read expects.
// An `is L` fits an empty list of another list arm (D4771), and a capture, field or element
// cannot be re-boxed as `L`, so a payload of another wrapper reads as an empty `L` (D4939).
// A `strict` cast (a push receiver's) traps on another wrapper instead.
function listPayloadCastTail(wrap: i32, strict: boolean) {
  const back = listBackOfWrap(wrap)
  if back < 0 || strict {
    fbRefCast(wrap)
    return 0
  }
  const st = listPayloadStashSlot()
  fbLocalTee(st)
  fbRefTest(wrap)
  fbIfRef(wrap)
  fbLocalGet(st)
  fbRefCast(wrap)
  fbElse()
  fbBacking(back, 0)
  fbI32Const(0)
  fbI32Const(0)
  fbStructNew(wrap)
  fbEnd()
  return 0
}

// Recover the map struct ref a union binding narrowed to a map arm holds (`x[k]` or `x.has(k)`
// under an `is` guard naming the map arm): push the box, read its `anyref` value (field 1),
// `ref.cast` to the arm's per-value map struct heap (`mapTypeIdxOf`; its key's mono struct for
// an i32 or atom value). The result is the `(ref $mapStruct)` a bare map binding pushes.
function emitMapUnionUnboxRead(exprIx: i32, fnIx: i32) {
  if emitUnionBoxPush(exprIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  // The arm's map-value slot, the one `mapShapeOfExpr` types this read's consumer against.
  fbRefCast(mapTypeIdxOf(mapShapeOfExpr(exprIx, fnIx))) // the payload IS the map struct ref
  return 0
}

// An empty `[]` into a union with no `i32[]` arm, built and tagged as the list arm the checker
// adopted it as. The value-atom ladder classifies every empty literal `i32[]` and re-maps only
// onto the scalar-list arms, so a string or ref-list arm got the i32 backing (D2202).
// Returns 1 = handled, 0 = not applicable, -1 = error.
function emitEmptyArrUnionArm(
  unionName: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
) {
  if unionName == "" { return 0 }
  const bare = nodeAt(unwrapParen(exprIx))
  if bare is ArrayLit {
    if bare.arrElems.length != 0 { return 0 }
  } else {
    return 0
  }
  if unionHasAtomOfTy(unionTy, "i32", true) { return 0 }
  const k = emptyArrUnionArmKind(exprIx)
  let tag = -1
  if k == "strlist" {
    tag = scalarTagOfKind(9) // "string[]", the tag a `(string | null)[]` arm shares
  } else if k == "reflist" {
    const slot = emptyArrUnionArmSlot(exprIx)
    if !unionHasRefArrayArmSlot(unionTy, slot) { return 0 }
    tag = refArrBoxTagOf(exprIx, fnIx, slot, unionTy)
  }
  if tag < 0 { return 0 }
  fbI32Rel(RS_TAG, tag)
  const rc = emitExpr(exprIx, fnIx)
  if rc < 0 { return -1 }
  fbStructNew(uBoxIdx) // { tag, list-wrapper ref }
  return 1
}

// Route a list literal flowing into a union whose matching arm is a union-box-element
// ref-array (`(i32 | string)[] | {w: i32}`) through that arm's build: the literal builds at
// the arm's slot, boxing each element, and the wrapper is tagged with the arm's slot tag.

// Needed because the literal's own classification is a scalar list or a concrete struct list,
// neither of which interns the arm's slot, so `emitUnionCoerce`'s slot-match path misses. The
// union's own value-atom list arm still wins, guarded by `unionHasAtom`. Returns 1 = handled,
// 0 = not applicable, -1 = error.
function emitUnionListLitViaRefArm(
  unionName: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
) {
  if unionName == "" { return 0 }
  const armSlot = listLitRefArmSlotOf(unionTy, exprIx, fnIx)
  if armSlot < 0 { return 0 }
  const armTag = refArrBoxTagOf(exprIx, fnIx, armSlot, unionTy)
  if armTag < 0 { return emitFail("emitProgram: boolean list arm has no tag") }
  fbI32Rel(RS_TAG, armTag)
  const armBuild: ListBuild = { lbKind: LBK_UNION, lbSlot: armSlot }
  const rc = emitArrAt(unwrapParen(exprIx), fnIx, armBuild)
  if rc < 0 { return -1 }
  fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
  return 1
}

// Route an array-literal union carrier into the union's single nested-array arm
// (`string[][] | string`, `i64[][] | boolean | null` — `unionNestedArrayArmSlot`): tag with the
// arm's slot and build the literal at the arm's type, which the checker stamped on it.

// Each inner list then builds the arm's leaf: an `i64[][]` arm widens bare-int leaves at the
// store, and a `string[][]` arm builds string inner lists, which `exprRefArray` cannot see so
// the ref-array carrier path misses them. Returns 1 when routed, 0 when the union has no
// unambiguous nested-array arm and the caller keeps its loud reject, -1 on a failure.
function emitUnionNestedListLit(unionTy: i32, exprIx: i32, fnIx: i32) {
  const bare = nodeAt(unwrapParen(exprIx))
  if bare is ArrayLit {
    const armSlot = unionNestedArrayArmSlot(unRowOfTyKey(unionTy))
    if armSlot < 0 { return 0 }
    const nestTag = refArrBoxTagOf(exprIx, fnIx, armSlot, unionTy)
    if nestTag < 0 {
      return emitFail("emitProgram: boolean list arm has no tag")
    }
    fbI32Rel(RS_TAG, nestTag)
    const rc = emitExpr(exprIx, fnIx)
    if rc < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
    return 1
  }
  return 0
}

// The function type a closure carrier boxes under (`cloArmTagOfTy`): its own checked type, not the
// union's arm, since several function arms would otherwise all tag as the first (D6). -1 when the
// checker banked none, and the caller falls back to the union's first function arm.
function cloBoxOwnFnTy(exprIx: i32, fnIx: i32): i32 {
  const vt = nodeTyAt(exprIx, fnIx)
  if tyIxIsFunc(vt) { return vt }
  const bt = nodeTyAt(unwrapParen(exprIx), fnIx)
  if tyIxIsFunc(bt) { return bt }
  return -1
}

// `cloBoxOwnFnTy`, else the first function-typed member of union row `u`.
function cloBoxEqArmTy(exprIx: i32, u: i32, fnIx: i32): i32 {
  const own = cloBoxOwnFnTy(exprIx, fnIx)
  if own >= 0 { return own }
  return unionClosureArmTyOfRow(u)
}

// `emitUnionCoerce` lowers an expression coerced into the boxed union's representation (a
// binding init, an assignment, an argument, a return): pass-through when the value already is
// the box, a bare `null` as the null tag over a `ref.null` payload, a raw scalar or string as
// its atom's tag and payload, an object literal through `emitUnionBox`'s `uDeclared` path.

// The tag a map of shape `sh` is BOXED under. An integer-keyed mono map tags above the
// value-atom band only in a module whose collect pass saw it as a union arm, so a box built
// without that mark is refused here rather than tagged into the band below.
function mapBoxTag(sh: i32): i32 {
  const s = mapShapeFoldSet(sh)
  if (s == -4 || s == -6) && !mIntMonoArmUsed {
    return emitFail(
      "emitProgram: an integer-keyed map union arm was not collected",
    )
  }
  return mapSlotTag(s)
}

// The tag the map value `exprIx` of shape `sh` boxes under in `unionName`. Where two map types
// of the module's unions share that struct (D2493), each owns a tag, so the member is chosen by
// TYPE: the union's one arm of the shape, else the arm the value's static type is.
function mapBoxTagOf(sh: i32, unionTy: i32, exprIx: i32, fnIx: i32): i32 {
  const s = mapShapeFoldSet(sh)
  if !mapShapeTwinned(s) { return mapBoxTag(s) }
  const vt = mapValueTyOf(exprIx, fnIx)
  let arm = -1
  let only = -1
  let n = 0
  const mems: i32[] = []
  if unionTyMemberTys(unionTy, mems) {
    let i = 0
    while i < mems.length {
      const m = mems[i]
      if (
        unMemIsMap(m)
        && mapTwinOneStruct(mapShapeFoldSet(mapArmShapeOfTy(m)), s)
      ) {
        // Members the same type count once: `A | B` over two equal maps is one member.
        if only < 0 || !mapTwinSame(only, m) { n = n + 1 }
        only = m
        if vt >= 0 && mapTwinSame(m, vt) { arm = m }
      }
      i = i + 1
    }
  }
  if arm < 0 && n == 1 { arm = only }
  if arm < 0 && n == 0 { arm = vt }
  const tag = mapArmTagOfTy(arm, s)
  if tag < 0 {
    return emitFailAt(
      "emitProgram: a map value's union arm cannot be told from another map of its representation",
      exprIx,
    )
  }
  return tag
}

// D1029 — the map arm's re-box: the arm's tag, the map ref, one `struct.new`. Returns 1
// handled, 0 not a map arm, -1 on error. A value narrowed to the union's map arm reads unboxed
// in that scope, so delivering it to a destination typed at the union has to put the box back.
// One home, because a map-value store reaches only `emitUnionBoxArg`, not `emitUnionCoerce`.
function emitUnionMapArmBox(
  unionName: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
): i32 {
  if unionName == "" { return 0 }
  // A value `if` boxes arm by arm (`emitUnionCoerce`'s join): its two arms may be two members.
  if nodeAt(unwrapParen(exprIx)) is IfStmt { return 0 }
  let nullable = false
  if !exprMap(exprIx, fnIx) {
    if !exprNullableMap(exprIx, fnIx) { return 0 }
    nullable = true
  }
  const sh = mapShapeOfExpr(exprIx, fnIx)
  if !unionHasMapArmSlot(unionTy, sh) { return 0 }
  if !nullable { return mapArmBoxHead(unionTy, exprIx, fnIx) }
  const tag = mapBoxTagOf(sh, unionTy, exprIx, fnIx)
  if tag < 0 { return -1 }
  return emitNulMapArmBox(tag, exprIx, "", -1, -1, fnIx)
}

// The head of closure `exprIx` boxed into union `unionTy`: its closure arm's tag, by the closure's
// own function type where it names one. The closure and the `struct.new` follow.
function cloArmBoxHead(unionTy: i32, exprIx: i32, fnIx: i32): i32 {
  const own = cloBoxOwnFnTy(exprIx, fnIx)
  const arm = if own >= 0 { own } else { unionClosureArmTyOfTy(unionTy) }
  return fbI32Rel(RS_TAG, cloArmTagOfTy(arm))
}

// The head of map `exprIx` boxed into union `unionTy` under its map arm's tag: the tag, or -1
// where the arm names none. The value and the `struct.new` follow (`emitHoleBox`'s `map`).
function mapArmBoxHead(unionTy: i32, exprIx: i32, fnIx: i32): i32 {
  const tag = mapBoxTagOf(mapShapeOfExpr(exprIx, fnIx), unionTy, exprIx, fnIx)
  if tag < 0 { return -1 }
  return fbI32Rel(RS_TAG, tag)
}

// A `M | null` value into a box holding `M`: the map arm's box, or when the value is null the
// null-tagged box, or `defIx` boxed into `unionName` for a `??` (D2666). The tag rides under
// the value into `br_on_null`, so the value is read once and no scratch slot is needed.
function emitNulMapArmBox(
  tag: i32,
  exprIx: i32,
  unionName: string,
  unionTy: i32,
  defIx: i32,
  fnIx: i32,
): i32 {
  fbBlockRefNul(uBoxIdx, false) // (ref $uBox) blocktype
  fbBlock(127) // i32: the tag, carried out when the value is null
  fbI32Rel(RS_TAG, tag)
  if emitExpr(exprIx, fnIx) < 0 { return -1 }
  fbBrOnNull(0)
  fbStructNew(uBoxIdx) // { tag, map struct ref }
  fbBr(1)
  fbEnd()
  fbDrop()
  if defIx >= 0 {
    if emitUnionBoxOwed(unionName, unionTy, defIx, fnIx) < 0 { return -1 }
  } else {
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone()
    fbStructNew(uBoxIdx) // { null tag, unread }
  }
  fbEnd()
  return 1
}

// `l ?? d` of `coalMapJoinWhen`'s shape: the left's arm box, else `d` boxed. 1 handled, -1 failed.
function emitCoalesceMapJoin(e: BinExpr, exprIx: i32, fnIx: i32): i32 {
  const un = boxDstNameAt(e.binRight, fnIx)
  const unTy = nodeTyInOf(exprIx, fnIx)
  const sh = mapShapeOfExpr(e.binLeft, fnIx)
  const tag = mapBoxTagOf(sh, unTy, e.binLeft, fnIx)
  if tag < 0 { return -1 }
  return emitNulMapArmBox(
    tag,
    e.binLeft,
    un,
    nodeTyInOf(exprIx, fnIx),
    e.binRight,
    fnIx,
  )
}

// Whether `unionName`, typed `unionTy` (-1 when unknown), is a box-represented union (a non-null
// value atom beside another member) that has no registry row, so no arm of it can be tagged.
function unionBoxHasNoRow(unionName: string, unionTy: i32): boolean {
  if unionName == "" || unionRowKeyAB(84, unionTy) >= 0 { return false }
  if msMemberCount(msSetOfTyAny(unionTy)) < 2 { return false }
  emitFail(
    "emitProgram: a record delivered into a rowless union box has no typed member test",
  )
  return false
}

// `emitUnionBoxArg` into the union the checker records `valIx` delivered into, where a registry
// row answers it; a value already a box with no record, into its own union; else into the site's
// own union `siteNm` / `siteTy`.
function emitUnionBoxAtRecord(
  siteNm: string,
  siteTy: i32,
  valIx: i32,
  fnIx: i32,
) {
  if boxOwedAt(valIx, fnIx) { return emitDelivered(valIx, fnIx) }
  // A value already of its destination's union is no coercion, so the checker records none: it is
  // delivered as its own union, and `boxRetagArmsOfTys` decides any retag from that.
  if exprUnion(valIx, fnIx) {
    const own = boxTyName(nodeTyAt(valIx, fnIx))
    if own != "" {
      return emitUnionBoxArg(own, nodeTyAt(valIx, fnIx), valIx, fnIx)
    }
  }
  return emitUnionBoxArg(siteNm, siteTy, valIx, fnIx)
}

// The value's form for the box shadow: 1 already a box, 2 a call that never returns, else 0.
function boxDstFormOf(exprIx: i32, fnIx: i32): i32 {
  if exprUnion(exprIx, fnIx) { return 1 }
  if callIsNever(unwrapParen(exprIx)) { return 2 }
  return 0
}

// Coerces the value of `exprIx` into the box of union `unionNameIn`. The caller's context is
// restored on every exit.
function emitUnionCoerce(
  unionNameIn: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
) {
  if boxDstShadowArmed() {
    boxDstShadowNote(
      "coerce",
      unionNameIn,
      unionTy,
      exprIx,
      fnIx,
      boxDstFormOf(exprIx, fnIx),
    )
  }
  boxDstShadowEnter()
  let r = emitUnionWideRetag(unionTy, exprIx, fnIx)
  if r == 0 { r = emitUnionWideArmBox(unionTy, exprIx, fnIx) }
  if r == 1 {
    r = 0
  } else if r == 0 {
    r = emitUnionCoerceUnder(unionNameIn, unionTy, exprIx, fnIx)
  }
  boxDstShadowLeave()
  return r
}

// The one list arm slot of union `unionTy` whose wrapper is ref-list slot `slot`'s, or -1 when
// none or several are.
function refArrTwinArmSlot(unionTy: i32, slot: i32): i32 {
  if slot < 0 || slot >= rlWrapIdx.length { return -1 }
  const mems: i32[] = []
  if !unionTyMemberTys(unionTy, mems) { return -1 }
  let found = -1
  for m in mems {
    if m < 0 || !unMemIsRefElemArray(m) { continue }
    const s = unMemRefArrArmSlot(m)
    if s >= 0 && s < rlWrapIdx.length && rlWrapIdx[s] == rlWrapIdx[slot] {
      if found >= 0 && found != s { return -1 }
      found = s
    }
  }
  return found
}

// `emitUnionCoerceUnder`'s arm for a ref-element array carrier entering `unionName`: the
// wrapper rides the box under its arm's slot tag, or the literal rebuilds through a matching
// arm. Returns 0, or -1 once failed; with no arm to carry it the failure is loud.
function emitUnionCoerceRefArray(
  unionName: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
) {
  const raSlot = refListSlotOfExpr(exprIx, fnIx)
  if unionHasRefArrayArmSlot(unionTy, raSlot) {
    const raTag = refArrBoxTagOf(exprIx, fnIx, raSlot, unionTy)
    if raTag < 0 { return emitFail("emitProgram: boolean list arm has no tag") }
    fbI32Rel(RS_TAG, raTag)
    if emitExpr(exprIx, fnIx) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
    return 0
  }
  // A ref-array LITERAL whose own slot mismatches (`[{a:1}]` self-classifies as the
  // concrete `C[]` while the arm is `(C | D)[]`): route it through the union-box-element
  // arm's build if one admits its element.
  const viaArm = emitUnionListLitViaRefArm(unionName, unionTy, exprIx, fnIx)
  if viaArm < 0 { return -1 }
  if viaArm == 1 { return 0 }
  // A ref-array LITERAL whose interned slot matches no arm but whose union has ONE
  // nested-array arm (`[[50183]]` self-classified `i32[][]` into `i64[][] | boolean |
  // null`): rebuild it through the ARM's slot — the arm's inner-list build widens the
  // bare-int leaves at the store (`emitWidened`), so no in-place re-encode is needed.
  const viaNest = emitUnionNestedListLit(unionTy, exprIx, fnIx)
  if viaNest < 0 { return -1 }
  if viaNest == 1 { return 0 }
  // A row whose arm a twin spelling keyed (`K[][]` for `i32[][]`) holds the value under that
  // arm's tag when the two lists share one wrapper; `is` reads its elements (D16894).
  const twin = refArrTwinArmSlot(unionTy, raSlot)
  if twin >= 0 {
    fbI32Rel(RS_TAG, refArrSlotTag(twin))
    if emitExpr(exprIx, fnIx) < 0 { return -1 }
    fbStructNew(uBoxIdx)
    return 0
  }
  // A ref-element array carrier whose interned slot matches no ref-array arm of the union:
  // a non-literal carrier whose built leaves cannot re-encode in place, or an ambiguous or
  // absent arm. A ref array can only ride the box as a wrapper ref, so with no arm to carry
  // it there is no sound rep — fail loudly rather than mis-box it through the scalar ladder.
  return emitFail(
    "emitProgram: array value does not match any array member of the union (leaf-scalar widening across a nested array is unsupported)",
  )
}

// `emitUnionCoerceUnder`'s arm for a list literal `bare` whose first element is a map: built
// through the array-of-map arm, else the arm whose element union carries a map atom.
// Returns 0, or -1 once failed; with neither arm the failure is loud.
function emitUnionCoerceMapElemList(
  uTy: i32,
  bare: ArrayLit,
  exprIx: i32,
  fnIx: i32,
) {
  const mapArmSlot = unionRefArrayArmSlotForMapElem(
    unRowOfTyKey(uTy),
    mapShapeOfExpr(bare.arrElems[0], fnIx),
  )
  if mapArmSlot >= 0 {
    fbI32Rel(RS_TAG, refArrSlotTag(mapArmSlot))
    if emitExpr(exprIx, fnIx) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
    return 0
  }
  // D1016 — before refusing, try the arm whose element is a union carrying a map atom.
  // `unionRefArrayArmSlotForMapElem` above looks for an array-of-map arm, and `Json[]` is
  // not one: its element is the union `Json`, which merely has a map among its atoms. The
  // arm's build boxes each element into the union box.
  const nmSlot = unionRefArrayArmSlotForNestedElem(unRowOfTyKey(uTy), true)
  if nmSlot >= 0 {
    fbI32Rel(RS_TAG, refArrSlotTag(nmSlot))
    if emitExpr(exprIx, fnIx) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
    return 0
  }
  return emitFail(
    "emitProgram: a union arm that is an array-of-map is not yet supported — use a named element type",
  )
}

// Whether a coerce target of set id `uSet`, else of arena type `uTy`, holds a member that is
// value kind `k`'s own scalar (not a literal riding its tag). False when the caller holds neither.
function coerceSetHasPlainKind(uSet: i32, uTy: i32, k: i32): boolean {
  return msHasPlainValKind(if uSet >= 0 { uSet } else { msSetOfTyAny(uTy) }, k)
}

// `emitUnionCoerceUnder`'s value-atom path, past its gate: a scalar map read into a nullable
// union and an atom widened to its member string box here, every other value through
// `emitUnionCoerceAtomBox`. Returns 0, or -1 once failed.
function emitUnionCoerceValueAtom(
  unionName: string,
  uSet: i32,
  uTy: i32,
  exprIx: i32,
  bareIx: i32,
  fnIx: i32,
) {
  // A bare scalar-valued map read entering a nullable union — box it with a tag chosen by the
  // probe, rather than letting the ladder below tag a miss as present. Gated on the union
  // actually containing `null`: without a null member there is no absent to represent, so
  // `m[k]` keeps the ladder's plain boxing.

  // Above the ladder because the ladder cannot see the difference: it classifies the expression
  // (`m[k]` is an i32) and has no access to whether the key is present, so it emits an
  // unconditional value tag over the rep's empty value. For `i32` that empty value is `0`, a
  // real value. The niche-bearing value types are excluded: their empty value already means absent.
  const mrk = mapReadScalarBoxKind(exprIx, fnIx)
  if mrk >= 0 && coerceSetHasNull(uSet, unionName, uTy) {
    // Only when the map's own value atom is a MEMBER of the target union. A widening
    // consumption (`{[string]: i32}` read into `i64 | null`) has to go through the
    // ladder's promotion rules, which this arm does not replicate — declining leaves it
    // exactly as it is today rather than tagging it with the wrong width.
    if coerceSetHasPlainKind(uSet, uTy, mrk) {
      const mre = nodeAt(unwrapParen(exprIx))
      if mre is Index {
        return emitMapGetScalarBox(mre.idxArr, mre.idxIndex, mrk, fnIx)
      }
    }
  }
  // An atom-typed value entering the box, above the value-atom ladder because the ladder
  // cannot classify it at all: `valueAtomKind("K")` is -1, so a `K`-typed local, param or call
  // result falls past every branch to the numeric default and every mixed spelling boxes the
  // raw id under a wrong tag or pushes an i32 at the box's `anyref` payload.

  // The id widens to its member string (`emitAtomToStr`) under kind 2, `isArmTagOfTy`'s
  // litunion tag. `emitAtomToStr` stashes the id in the string-op scratch frame, so the
  // reservation predicates in `emit_fn_scans` must answer true wherever this gate does.
  if coerceTakesAtomAsStr(uSet, uTy) && exprIsLitAtom(exprIx, fnIx) {
    // A `K | null` value's `-1` boxes under the null tag, any other id as its member string
    // under the string tag; the id is read once (D3347).
    const nlTexts = nulAtomWidenTexts(exprIx, fnIx)
    if nlTexts.length > 0 {
      const nlWhy = atomNulStrWhy(unionName, uSet, uTy, exprIx, fnIx)
      if nlWhy != "" { return emitFail(nlWhy) }
      if emitExpr(exprIx, fnIx) < 0 { return -1 }
      return atomNulStrTail(nlTexts)
    }
    fbI32Rel(RS_TAG, scalarTagOfKind(2)) // the string tag — kind 2 rides the anyref directly
    if emitAtomToStr(exprIx, fnIx) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, member-string ref }
    return 0
  }
  return emitUnionCoerceAtomBox(uSet, uTy, exprIx, bareIx, fnIx)
}

// After a `K | null` atom's id: the null tag if the id is -1, else its member string among
// `nlTexts` under the string tag, boxed.
function atomNulStrTail(nlTexts: string[]): i32 {
  setStrScrI(0)
  fbI32Rel(RS_TAG, nullBoxTag())
  fbI32Rel(RS_TAG, scalarTagOfKind(2))
  pushStrScrI(0)
  fbI32Const(-1)
  fbI32Bin(70) // i32.eq
  fbSelect() // the null tag if the id is -1
  pushStrScrI(0)
  fbI32Const(-1)
  fbI32Bin(70)
  fbIfRefNul(sTy(), true)
  fbRefNull(sTy())
  fbElse()
  if emitAtomToStrChain(nlTexts, 0, strScratchBase + 3) < 0 { return -1 }
  fbEnd()
  fbStructNew(uBoxIdx)
  return 0
}

// The value-atom box `{ tag, payload }` for `exprIx` entering set `uSet`: the atom ladder
// settles one value-atom code, and the tag, the payload's widening and any list re-encode all
// follow from it. `bareIx` is the paren-stripped node. Returns 0, or -1 once failed.
function emitUnionCoerceAtomBox(
  uSet: i32,
  uTy: i32,
  exprIx: i32,
  bareIx: i32,
  fnIx: i32,
) {
  const cak = coerceListAtomOf(
    coerceValueAtomKind(uSet, uTy, exprIx, bareIx, fnIx),
    uTy,
    bareIx,
    fnIx,
  )
  // `cak` is final at this point: every arm of the ladder above assigns before the
  // tag is emitted, and the box TAG, the rides-the-anyref test and the scalar value
  // box below are all projections of it (`scalarTagOf` / `atomIsRefKind` /
  // `vbHeapIdxOfKind` each re-derived it from the spelling).
  if cak == 7 && vbAtomListUsed && exprIsAtomList(bareIx, fnIx) {
    fbI32Rel(RS_TAG, atomListArmTag())
  } else {
    fbI32Rel(RS_TAG, scalarTagOfKind(cak))
  }
  if emitCoerceAtomPayload(cak, exprIx, fnIx) < 0 { return -1 }
  return atomBoxTail(cak)
}

// After a value-atom box's tag and payload of kind `cak`: a scalar wraps in its value box (a
// string or list rides the anyref as itself), then the box.
function atomBoxTail(cak: i32): i32 {
  if !atomIsRefKind(cak) {
    const vb = vbHeapIdxOfKind(cak)
    if vb < 0 { return emitFail("emitProgram: union atom has no value box") }
    fbStructNew(vb)
  }
  fbStructNew(uBoxIdx) // { tag, payload }
  return 0
}

// The payload of a value-atom box: `exprIx` widened to the atom `cak`. Returns 0, or -1 once
// failed.
function emitCoerceAtomPayload(cak: i32, exprIx: i32, fnIx: i32) {
  if cak == 3 {
    if emitWidened(exprIx, 3, fnIx) < 0 { return -1 }
  } else if cak == 4 {
    if emitWidened(exprIx, 4, fnIx) < 0 { return -1 }
  } else if cak == 5 {
    if emitWidened(exprIx, 5, fnIx) < 0 { return -1 }
  } else {
    if emitExpr(exprIx, fnIx) < 0 { return -1 }
  }
  return 0
}

// `emitUnionCoerce`'s body: the arms that thread a list or f32 context apply it and leave it
// for the wrapper's exit to undo.
function emitUnionCoerceUnder(
  unionNameIn: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
) {
  // Resolve a union ALIAS (`type Tagged = {x:i32} | string`) to its pipe-joined member set
  // so the value-atom boxing below (`unionHasValueAtom`/`unionHasAtom`/the atom ladder) sees
  // the atoms — an alias name has no `|` to split. An INLINE union name (already a member
  // set) and a non-union name resolve to "" and pass through unchanged.
  let unionName = unionNameIn
  const ur = unRowOfTyKey(unionTy)
  const ums = unionMemberSetOfRow(ur, unionName)
  if ums != "" { unionName = ums }
  const clash = unionArmTagClash(unionTy)
  if clash != "" { return emitFailAt(clash, exprIx) }
  const bareIx = unwrapParen(exprIx)
  if bareIx < 0 { return -1 }
  const bare = nodeAt(bareIx)
  // A `never` call enters any box: its `unreachable` satisfies the destination (D14086).
  if callIsNever(bareIx) { return emitExpr(bareIx, fnIx) }
  // An if-expression join (`return if c { catVal } else { dogVal }`): each arm is a distinct
  // union member, so the join cannot ride a single numeric blocktype — emit a value-typed `if`
  // whose result is the union box, union-coercing each arm. Without this the join defaults to
  // an i32 blocktype over ref arms, which is invalid wasm.

  // D969 — ahead of the `exprUnion` raw-pass below, and the order is the whole point. An
  // if-expression that is already a union value hits the raw pass first and is emitted by
  // `emitExpr`, which picks the join's blocktype from the arms' scalar ladder. Only this arm
  // knows the blocktype has to be the box, so it must be asked first.
  if bare is IfStmt && !ifJoinAdaptsScalar(bareIx, fnIx) {
    // A `null`-typed one is the null-tagged box after its arms run for effect (D3355).
    if nodeTyIsNullType(bareIx) {
      fbI32Rel(RS_TAG, nullBoxTag())
      if emitNulNoneBoxPayload(bareIx, fnIx) < 0 { return -1 }
      fbStructNew(uBoxIdx)
      return 0
    }
    return emitUnionIfValue(unionName, unionTy, bareIx, fnIx)
  }
  if numUnionMinted {
    const nuRb = emitNumUnionRebox(exprIx, unionName, unionTy, fnIx)
    if nuRb != 0 { return nuRb }
  }
  if exprUnion(exprIx, fnIx) { return emitExpr(exprIx, fnIx) }
  if bare is NullLit {
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone() // the payload slot is unread under the null tag
    fbStructNew(uBoxIdx)
    return 0
  }
  // D1576 — a `null`-typed value at a box destination is the same null-tagged box, with the
  // value in the payload slot instead of a fresh `ref.null none`: `nullref` is an `anyref`, so
  // it rides the slot the null tag leaves unread and a call's side effects still happen. The
  // binding twin of `emitUnionBoxArg`'s arm, which is the argument boundary's.
  if exprIsNulNone(exprIx, fnIx) {
    fbI32Rel(RS_TAG, nullBoxTag())
    if emitNulNoneBoxPayload(exprIx, fnIx) < 0 { return -1 }
    fbStructNew(uBoxIdx)
    return 0
  }
  // A `V | null` niche delivered where the box is expected: the niche carries no tag of its
  // own, so its null must become the union's null. Ahead of the struct arms, which box a
  // nullable record under its arm's tag whatever it holds (D2260), and of the value-atom gate.
  const viaNulNiche = emitUnionBoxNulNiche(
    unionName,
    unionNameIn,
    unionTy,
    exprIx,
    fnIx,
  )
  if viaNulNiche < 0 { return -1 }
  if viaNulNiche == 1 { return 0 }
  return emitUnionCoerceRecord(
    unionName,
    msSetOfRow(ur),
    unionTy,
    exprIx,
    bareIx,
    fnIx,
  )
}

// `emitUnionCoerceUnder`'s record arms: an object literal, a struct value re-boxed against its
// variant arm, a bare variant value. Every other value goes on to `emitUnionCoerceMap`.
// Returns what `emitUnionCoerceUnder` returns.
function emitUnionCoerceRecord(
  unionName: string,
  uSet: i32,
  uTy: i32,
  exprIx: i32,
  bareIx: i32,
  fnIx: i32,
) {
  const bare = nodeAt(bareIx)
  // A STRUCT value (an object literal, or a struct-typed expr) auto-boxes through
  // `emitExpr`'s `uDeclared` variant path; only a SCALAR value is value-boxed below.
  // This is what lets a MIXED union (`A | i32`) coerce either kind of member: an object
  // arm boxes as a variant struct, a scalar arm as a value box.
  if bare is ObjLit {
    // The target union's own arms are tried first (`unionArmVariantForObj`): the global scan
    // below picks the first field-name-set match across all unions, which can land on another
    // union's arm sharing the names — two nested-struct arms differing only in the nested
    // layout collide onto the first arm's tag. A single-union program resolves either way.
    const ctxVi = unionArmVariantForObj(uTy, bareIx, fnIx)
    if ctxVi >= 0 { return emitUnionBoxAs(bareIx, ctxVi, fnIx) }
    // When the literal matches a union variant, box it as that variant directly rather than
    // routing through `emitExpr` — whose `structIndexOfObj` re-inference mis-resolves a
    // field-name collision with an enclosing struct to the outer struct, emitting invalid
    // wasm. `objVariantName` is `emitObjLitNode`'s own resolution, only reordered ahead.
    if objVariantNameCtx(bareIx, fnIx) != "" {
      return emitUnionBox(bareIx, fnIx)
    }
    return emitExpr(exprIx, fnIx)
  }
  // A struct-typed ident or call result that is a variant arm of `unionName` but is built as
  // the plain struct — a distinct heap type from the arm's variant struct — would pass raw
  // where the box wants the variant struct. Re-box it against the matched arm
  // (`emitStructExprAsVariantBox`). Gated on the heaps differing, so a deduped shape is raw.
  if unionName != "" && exprStruct(exprIx, fnIx) {
    const rbVi = unionArmVariantForStructExpr(uTy, exprIx, fnIx)
    if rbVi >= 0 {
      const rbSsi = structIndexOfExpr(exprIx, fnIx)
      if rbSsi >= 0 {
        if sHeapIdx[rbSsi] != variantHeap(rbVi) {
          return emitStructExprAsVariantBox(exprIx, rbVi, rbSsi, fnIx)
        }
        // The heaps agreeing is not a reason to pass raw (D281). The test above answers "must
        // the payload be rebuilt onto another heap type"; the fall-through below answers "is
        // this value already box-shaped". With the cross-table merge (`uVarSTwin`) the equal
        // branch is reachable, and raw-passing a `(ref $arm)` into a box cell is invalid wasm.
        fbI32Rel(RS_TAG, uTags[rbVi]) // 0x41 i32.const <variant tag> (program-global)
        if emitExpr(exprIx, fnIx) < 0 { return -1 }
        fbStructNew(uBoxIdx) // { tag, variant-ref }
        return 0
      }
    }
    // A record built at another row lands on the member the checker names, copied there.
    const lvVi = unionArmLandingForStructExpr(uTy, exprIx, fnIx)
    if lvVi >= 0 {
      const lvSsi = structIndexOfExpr(exprIx, fnIx)
      return emitStructExprAsVariantBox(exprIx, lvVi, lvSsi, fnIx)
    }
  }
  if exprStruct(exprIx, fnIx) {
    // With no row the record arm has no tag, and a raw record ref is no box (D3519).
    if unionBoxHasNoRow(unionName, uTy) {
      return emitFailAt(
        "emitProgram: a record value delivered into a union box this program never registered has no tag",
        exprIx,
      )
    }
    return emitExpr(exprIx, fnIx)
  }
  // A bare variant value (a kind-8 local, param or call, its binding classified concrete by
  // `letIsVariant`) passes through: the binding's slot is the raw variant ref. Without this a
  // union carrying a value atom drops the variant ref into the scalar atom ladder and widens
  // it. A box-typed position routes through `emitUnionBoxArg`, which boxes before deferring.
  if exprVariantIndex(exprIx, fnIx) >= 0 { return emitExpr(exprIx, fnIx) }
  return emitUnionCoerceMap(unionName, uSet, uTy, exprIx, bareIx, fnIx)
}

// `emitUnionCoerceUnder`'s map arms: a map carrier tagged by its value slot, the loud reject of
// a map the union does not box, and a narrowed map arm's re-box. Every other value goes on to
// `emitUnionCoerceList`. Returns what `emitUnionCoerceUnder` returns.
function emitUnionCoerceMap(
  unionName: string,
  uSet: i32,
  uTy: i32,
  exprIx: i32,
  bareIx: i32,
  fnIx: i32,
) {
  // A map carrier flowing into a union with a matching map arm: the map struct ref rides the
  // box anyref directly, like a reflist wrapper, tagged by its interned value slot
  // (`mapSlotTag`). Checked before the value-atom gate below — such a union may have no value
  // atom, so that gate would bail and emit the raw map ref where a `(ref $uBox)` is expected.
  if unionName != "" && exprMap(exprIx, fnIx) {
    let mSlot = mapShapeOfExpr(exprIx, fnIx)
    // A Set rides its key's mono map slot.
    if mSlot != -3 { mSlot = mapShapeFoldSet(mSlot) }
    if mSlot >= -1 || mSlot == -4 || mSlot == -6 {
      if unionHasMapArmSlot(uTy, mSlot) {
        const mTag = mapBoxTagOf(mSlot, uTy, exprIx, fnIx)
        if mTag < 0 { return -1 }
        fbI32Rel(RS_TAG, mTag)
        if emitExpr(exprIx, fnIx) < 0 { return -1 }
        fbStructNew(uBoxIdx) // { tag, map-struct ref }
        return 0
      }
    }
  }
  // A map carrier the union does not box (a checker-impossible slot mismatch, or an
  // unsupported map value type `mapShapeOfExpr` returns -3 for): fail loudly rather than
  // default the tag and let every later `is` silently miss.
  if exprMap(exprIx, fnIx) {
    return emitFail(
      "emitProgram: a map value is not a supported union member — use a struct member instead",
    )
  }
  // D1029 — the map arm's re-box, the rung the ref-array arm below already has. A value
  // narrowed to the union's map arm reads unboxed in that scope, so delivering it to a
  // destination typed at the union has to put the box back: the arm's tag, the map ref,
  // `struct.new`. Written as the exact mirror of the ref-array rung so the two stay one shape.
  const d29 = emitUnionMapArmBox(unionName, uTy, exprIx, fnIx)
  if d29 < 0 { return -1 }
  if d29 == 1 { return 0 }
  return emitUnionCoerceList(unionName, uSet, uTy, exprIx, bareIx, fnIx)
}

// `emitUnionCoerceUnder`'s list and closure arms, then the value-atom gate: an empty list, a
// ref-element array, a list literal routed through its arm's build, a bare closure, and every
// remaining value raw or value-boxed. Returns what `emitUnionCoerceUnder` returns.
function emitUnionCoerceList(
  unionName: string,
  uSet: i32,
  uTy: i32,
  exprIx: i32,
  bareIx: i32,
  fnIx: i32,
) {
  const bare = nodeAt(bareIx)
  const eau = emitEmptyArrUnionArm(unionName, uTy, exprIx, fnIx)
  if eau < 0 { return -1 }
  if eau == 1 { return 0 }
  // A ref-element array carrier (`S[]`, `(() => f64)[]`, `(C | D)[]`) flowing into a union with
  // a matching ref-array arm: the reflist wrapper ref rides the box anyref directly, tagged by
  // its interned slot (`refArrSlotTag`). Checked before the value-atom gate below — such a union
  // may have no value atom, so that gate would bail and emit the raw wrapper ref.
  if unionName != "" && exprRefArray(exprIx, fnIx) {
    return emitUnionCoerceRefArray(unionName, uTy, exprIx, fnIx)
  }
  // A list literal the checker typed as a ref-list arm builds there (`emitArr`), so it boxes
  // under that arm's tag even where its elements alone read as scalars (`[null]`).
  const atSlot = arrLitRefSlotAtTy(bareIx, fnIx)
  if unionName != "" && unionHasRefArrayArmSlot(uTy, atSlot) {
    const atTag = refArrBoxTagOf(exprIx, fnIx, atSlot, uTy)
    if atTag < 0 { return emitFail("emitProgram: boolean list arm has no tag") }
    fbI32Rel(RS_TAG, atTag)
    if emitExpr(exprIx, fnIx) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
    return 0
  }
  // An array literal whose element is a map (`[m]`) flowing into a union with an array-of-map
  // arm: the arm's reflist element is the map type, but a map-valued literal element is
  // invisible to `exprRefArray` and `arrLitElemName`, which resolve an inline-struct element and
  // not a map ident, so the ref-array arm path above is skipped.

  // Route it through the arm's build: the element's map shape (`mapShapeOfExpr`, mono -1 or a
  // typed mv slot) picks the arm whose element map has the same canonical value rep, the literal
  // builds with the arm's reflist slot threaded, and the wrapper takes the arm's slot tag. A
  // literal matching no arm keeps the loud reject; falling through would be invalid wasm.
  if unionName != "" && bare is ArrayLit {
    if bare.arrElems.length >= 1 && exprMap(bare.arrElems[0], fnIx) {
      return emitUnionCoerceMapElemList(uTy, bare, exprIx, fnIx)
    }
    // A nested array literal whose leaf does not self-classify as a ref array (`[["ab"]]` — a
    // string-leaf inner makes `arrLitIsRef` false, so the `exprRefArray` carrier path above
    // misses it) flowing into a union with one nested-array arm: route through the arm's
    // build, exactly like the self-classified mismatch case.
    if bare.arrElems.length >= 1 {
      const bareE0 = nodeAt(bare.arrElems[0])
      if bareE0 is ArrayLit {
        const viaNest2 = emitUnionNestedListLit(uTy, exprIx, fnIx)
        if viaNest2 < 0 { return -1 }
        if viaNest2 == 1 { return 0 }
      }
    }
  }
  // A bare closure carrier (a lambda literal or a closure-typed binding) flowing into a union
  // with a bare-closure arm: the closure fat-pointer struct, a `structref` subtype, rides the
  // box anyref directly, tagged by the closure arm's `scalarTagOf` (value-atom kind 11).
  // Checked before the ladder below, whose scalar branches would store the ref in a value box.
  if (
    unionName != ""
    && exprIsClosure(exprIx, fnIx)
    && unionClosureArmTyOfTy(uTy) >= 0
  ) {
    cloArmBoxHead(uTy, exprIx, fnIx)
    if emitExpr(exprIx, fnIx) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, closure fat-pointer ref }
    return 0
  }
  // A scalar-element list literal (`["a"]`, `[1]`, invisible to `exprRefArray`) whose union arm
  // is a union-box-element ref-array: route it through the arm's build and tag. Checked before
  // the value-atom gate and ladder below — the gate would emit the raw wrapper into the box
  // slot, and the ladder would tag the box with the scalar-list atom instead of the arm's tag.
  const viaListArm = emitUnionListLitViaRefArm(unionName, uTy, exprIx, fnIx)
  if viaListArm < 0 { return -1 }
  if viaListArm == 1 { return 0 }
  if unionName == "" || !unionTyHasValueAtom(uTy) {
    return emitExpr(exprIx, fnIx)
  }
  return emitUnionCoerceValueAtom(unionName, uSet, uTy, exprIx, bareIx, fnIx)
}

// Coerce an expression into a union-box position whose wasm rep is `(ref $uBox)` — a call
// argument to a union param, or a return typed as the union. A concrete variant-struct value is
// a raw `(ref $variant)`, since a struct that is a union member is allocated as a kind-8 variant
// local so it narrows in place, and that raw ref does not match the boxed rep.

// Box it into the shared `{tag, payload}` rep exactly as `emitUnionBox` boxes a struct literal —
// the variant ref is the payload type, so no field copy. Box-typed positions only; exported for
// `emit_sections.vl`'s module-global cells, which are box-typed too.

// D1567 — is the function at `fnStmts` position `pos` one whose every returned value is a bare
// `null`? The checker types such a return `TyPrim:null` and the emitter reps it as `nullref`.
// The one home for that question: the union box destination in `emitUnionBoxArg` and the two
// i32 niches in `emitDirectCall` read it here rather than each spelling the kind compare.
function fnPosRetIsNulNone(pos: i32): boolean {
  if pos < 0 || pos >= fRetKind.length { return false }
  return fRetKind[pos] == "nulnone"
}

// The payload of a null-tagged box holding a `null`-typed value: the value itself when
// evaluating it can have effects (a call), and a fresh `ref.null none` otherwise. The slot is
// unread under the null tag, so its only job is to be an `anyref` — which is why an ident read
// must not route through the seed table (D1576), a `boolean | null` seed putting an i32 there.
export function emitNulNoneBoxPayload(exprIx: i32, fnIx: i32) {
  const ix = unwrapParen(exprIx)
  if ix >= 0 && ix < P.nodes.length {
    if nodeAt(ix) is IfStmt {
      if emitIfForEffect(ix, fnIx) < 0 { return -1 }
      fbRefNullNone()
      return 0
    }
  }
  return emitNulNoneLeafPayload(exprIx, fnIx)
}

// `emitNulNoneBoxPayload` for every node but an if-expression: a call is the payload itself.
function emitNulNoneLeafPayload(exprIx: i32, fnIx: i32) {
  const n = nodeAt(unwrapParen(exprIx))
  if n is Call { return emitExpr(exprIx, fnIx) }
  // `a ?? b` of the `null` type runs `a` for effect and is `b` (D3355).
  const co = plainCoalesceAt(exprIx)
  if co != null {
    if emitNulNoneForEffect(co.binLeft, fnIx) < 0 { return -1 }
    return emitNulNoneBoxPayload(co.binRight, fnIx)
  }
  fbRefNullNone()
  return 0
}

// The `a ?? b` node at `exprIx`, parentheses peeled, or null for any other node or a `??=`.
function plainCoalesceAt(exprIx: i32): BinExpr | null {
  const n = nodeAt(unwrapParen(exprIx))
  if n is BinExpr {
    if n.binOp == "??" && n.binCompound.length == 0 { return n }
  }
  return null
}

// Evaluate a `null`-typed operand for its effects and drop it, where the answer is already
// decided. A call and an if-expression have effects; an ident read has none, and emitting one
// would be dead code. Shared by `??`, the folded null compare, and `print`.
function emitNulNoneForEffect(exprIx: i32, fnIx: i32) {
  const ix = unwrapParen(exprIx)
  if ix >= 0 && ix < P.nodes.length {
    if nodeAt(ix) is IfStmt { return emitIfForEffect(ix, fnIx) }
  }
  return emitNulNoneLeafForEffect(exprIx, fnIx)
}

// Whether a `null`-typed value `exprIx` runs nothing for its effect: a bare `null` or a name read.
export function nulNoneWritesNothing(exprIx: i32): boolean {
  const ix = unwrapParen(exprIx)
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  return n is NullLit || n is Ident
}

// `emitNulNoneForEffect` for every node but an if-expression: a bare `null` and a name read have
// no effect, and anything else is lowered and its value dropped, since a `??` or a call in it
// may run code (D3355).
function emitNulNoneLeafForEffect(exprIx: i32, fnIx: i32) {
  const n = nodeAt(unwrapParen(exprIx))
  if nulNoneWritesNothing(exprIx) { return 0 }
  // A `?.` read off the `null` unit reads nothing past its receiver.
  if n is OptMember { return emitNulNoneForEffect(n.omObj, fnIx) }
  // A `null`-typed `a ?? b` has a `null`-typed left, so both sides always run.
  const co = plainCoalesceAt(exprIx)
  if co != null {
    if emitNulNoneForEffect(co.binLeft, fnIx) < 0 { return -1 }
    return emitNulNoneForEffect(co.binRight, fnIx)
  }
  if emitExpr(exprIx, fnIx) < 0 { return -1 }
  fbDrop()
  return 0
}

// Run a `null`-typed if-expression for its effects alone: its conditions as a void `if` chain,
// each arm's prelude, and each arm's value through `emitNulNoneForEffect`, under the narrowing
// its condition gives (D2227).
function emitIfForEffect(ifIx: i32, fnIx: i32) {
  const s = nodeAt(ifIx)
  if s is IfStmt {
    if emitCondExpr(s.ifCond, fnIx) < 0 { return -1 }
    fbIf(64) // 0x40 void
    const rcT = emitArmForEffect(s.ifThen, fnIx)
    if rcT < 0 { return -1 }
    if s.ifElse >= 0 {
      fbElse()
      let rcE = 0
      if nodeAt(s.ifElse) is IfStmt {
        rcE = emitIfForEffect(s.ifElse, fnIx)
      } else {
        rcE = emitArmForEffect(s.ifElse, fnIx)
      }
      if rcE < 0 { return -1 }
    }
    fbEnd()
    return 0
  }
  return emitFail("emitProgram: expected an if expression")
}

// One arm of `emitIfForEffect`: its prelude, then its `null`-typed value for effect.
function emitArmForEffect(blockIx: i32, fnIx: i32) {
  if emitIfArmOpen(blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
  return emitIfArmClose(emitNulNoneForEffect(ifArmValueExpr(blockIx), fnIx))
}

// The box value `exprIx` takes into the union the checker records it delivered into, or -1.
export function holeBoxTyAt(exprIx: i32, fnIx: i32): i32 {
  return boxRecordUnionTyOf(boxRecordTyAt(exprIx, fnIx))
}

// What plan `p` writes ahead of its value; a `lit` plan writes its literal too.
export function holeBoxHead(p: HoleBox, exprIx: i32, fnIx: i32): i32 {
  return match p.hbArm {
    "null" => {
      fbI32Rel(RS_TAG, nullBoxTag())
      fbRefNullNone() // the payload slot is unread under the null tag
    }
    "atom" => fbI32Rel(RS_TAG, scalarTagOfKind(p.hbKind))
    "rec" | "obj" => fbI32Rel(RS_TAG, uTags[p.hbKind])
    "refList" => fbI32Rel(RS_TAG, p.hbKind)
    "map" => mapArmBoxHead(p.hbKind, exprIx, fnIx)
    "clo" => cloArmBoxHead(p.hbKind, exprIx, fnIx)
    "lit" => {
      fbI32Rel(RS_TAG, scalarTagOfKind(p.hbKind))
      widenLitAt(exprIx, p.hbKind, fnIx)
    }
    "pass" | "memberBox" | "atomStr" | "mapScalar" => 0
    "ladder" => emitFail("emitProgram: a box plan with no arm was written")
  }
}

// What plan `p` for `exprIx` writes after its value (an `atom` plan's widening already applied).
export function holeBoxTail(p: HoleBox, exprIx: i32, fnIx: i32): i32 {
  return match p.hbArm {
    "null" | "rec" | "obj" | "refList" | "map" | "clo" => fbStructNew(uBoxIdx)
    "atom" | "lit" => atomBoxTail(p.hbKind)
    "atomStr" => atomNulStrTail(nulAtomWidenTexts(exprIx, fnIx))
    "pass" | "memberBox" | "mapScalar" | "ladder" => 0
  }
}

// `emitUnionBoxArg` for a value plan `p` decides.
function emitHoleBox(p: HoleBox, exprIx: i32, fnIx: i32): i32 {
  if holeBoxHead(p, exprIx, fnIx) < 0 { return -1 }
  if p.hbArm == "atom" {
    if emitCoerceAtomPayload(p.hbKind, exprIx, fnIx) < 0 { return -1 }
  } else if p.hbArm == "mapScalar" {
    const mre = nodeAt(unwrapParen(exprIx))
    if !(mre is Index) {
      return emitFail("emitProgram: a map read's box plan names no read")
    }
    if emitMapGetScalarBox(mre.idxArr, mre.idxIndex, p.hbKind, fnIx) < 0 {
      return -1
    }
  } else if p.hbArm == "obj" {
    if emitVariantStruct(unwrapParen(exprIx), p.hbKind, fnIx) < 0 { return -1 }
  } else if p.hbArm == "memberBox" {
    // The read at its storage: the box its field holds, which its member's tag already names.
    const marks = memberBoxReadEnter(exprIx)
    const rc = emitExpr(exprIx, fnIx)
    memberBoxReadLeave(marks)
    if rc < 0 { return -1 }
  } else if (
    p.hbArm == "pass"
    || p.hbArm == "atomStr"
    || p.hbArm == "rec"
    || p.hbArm == "refList"
    || p.hbArm == "map"
    || p.hbArm == "clo"
  ) {
    if emitExpr(exprIx, fnIx) < 0 { return -1 }
  }
  return holeBoxTail(p, exprIx, fnIx)
}

// The value at `exprIx` boxed into the union `unionName`. A box of a member set holding a member
// `unionName` holds only widened is rebuilt there (`emitBoxAtomRetagMembers`), so a record built
// or written at a wider record's field reads back through every handle (D3006).
function emitUnionBoxArg(
  unionNameIn: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
) {
  const unionName = boxDstName(unionNameIn, unionTy)
  if boxDstShadowArmed() {
    boxDstShadowNote(
      "box",
      unionName,
      unionTy,
      exprIx,
      fnIx,
      boxDstFormOf(exprIx, fnIx),
    )
  }
  boxDstShadowEnter()
  const hp = holeBoxPlanOf(exprIx, unionTy, fnIx)
  if hp.hbArm != "ladder" {
    // The shadow notes the coerce the ladder's value rungs are reached through, as legacy did.
    const viaCoerce = !exprIsNulNone(exprIx, fnIx)
    if viaCoerce && boxDstShadowArmed() {
      boxDstShadowNote(
        "coerce",
        unionName,
        unionTy,
        exprIx,
        fnIx,
        boxDstFormOf(exprIx, fnIx),
      )
    }
    if viaCoerce { boxDstShadowEnter() }
    const hr = emitHoleBox(hp, exprIx, fnIx)
    if viaCoerce { boxDstShadowLeave() }
    boxDstShadowLeave()
    return hr
  }
  // Maps nothing can tell apart are their one map, so delivering into them boxes nothing.
  const go = if mapTwinUnionMember(unionTy) >= 0 { emitExpr(exprIx, fnIx) } else { emitUnionBoxArgGo(unionName, unionTy, exprIx, fnIx) }
  boxDstShadowLeave()
  if go < 0 { return -1 }
  if !exprUnion(exprIx, fnIx) || deliveryRetagHas(exprIx) { return 0 }
  const ft: i32[] = []
  const tt: i32[] = []
  if !boxRetagArmsOfTys(unionBoxTyIxOfExpr(exprIx, fnIx), unionTy, ft, tt) {
    return 0
  }
  return emitBoxAtomRetagMembers(ft, tt, exprIx)
}

function emitUnionBoxArgGo(
  unionName: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
) {
  // `holeBoxPlanOf` takes its values ahead of this ladder: a rung added above the value-atom rungs
  // must decline there too.

  // D1567 — a `null`-typed value at a box destination is the null-tagged box. `i32 | null` and
  // every other value union reps as `{tag, anyref}`, so a `nullref` result cannot ride the cell
  // raw and must not be boxed as its own arm either — the classifier below reads a Call's kind,
  // finds none, and boxes it as an i32. The payload is the value: `nullref` is an `anyref`.
  if exprIsNulNone(exprIx, fnIx) {
    fbI32Rel(RS_TAG, nullBoxTag())
    if emitNulNoneBoxPayload(exprIx, fnIx) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { null tag, a nullref — unread under this tag }
    return 0
  }
  // D1009 — a map read of a union-valued map delivers its miss as a tagged box. `v[k]` on a
  // `{[string]: J}` has type `J | null`, and where `J` itself carries `null` that is a `J`. At
  // the rep the two nulls differ: the sentinel is a bare `ref.null` in the vals slot, `J`'s own
  // null arm a null-tagged box. `emitMapGetUnionBox` is exactly that conversion.
  const bxIdx = nodeAt(unwrapParen(exprIx))
  if bxIdx is Index {
    if exprMap(bxIdx.idxArr, fnIx) {
      const bxSh = mapShapeOfExpr(bxIdx.idxArr, fnIx)
      if bxSh >= 0 && bxSh < mvValRep.length {
        if mvValKindAt(bxSh) == "union" {
          const mgFrom: i32[] = []
          const mgTo: i32[] = []
          wideRetagPairs(exprIx, fnIx, unionTy, mgFrom, mgTo)
          if emitMapGetUnionBox(bxIdx.idxArr, bxIdx.idxIndex, fnIx) < 0 {
            return -1
          }
          if mgFrom.length > 0 { emitWideRetagChain(mgFrom, mgTo) }
          return 0
        }
      }
    }
  }
  const bxMap = emitUnionMapArmBox(unionName, unionTy, exprIx, fnIx)
  if bxMap < 0 { return -1 }
  if bxMap == 1 { return 0 }
  const bxArm = emitUnionArmValueBox(unionTy, exprIx, fnIx)
  if bxArm < 0 { return -1 }
  if bxArm == 1 { return 0 }
  return emitUnionCoerce(unionName, unionTy, exprIx, fnIx)
}

// Box a record wider than one arm of the union under that arm's tag, the reference as it
// stands: its row declares the arm's row a supertype (`armSuperOf`). A value that is itself an
// arm of another union is such a record too. Returns 1 handled, 0 not such a record, -1 on error.
function emitUnionWideArmBox(unionTy: i32, exprIx: i32, fnIx: i32): i32 {
  // A literal is built at the arm it names, never at a wider row; one naming no arm is built at
  // its own row, which boxes as the arm it subtypes (D3566).
  if (
    nodeAt(unwrapParen(exprIx)) is ObjLit
    && exprVariantIndex(exprIx, fnIx) >= 0
  ) {
    return 0
  }
  const vty = nodeTyAt(unwrapParen(exprIx), fnIx)
  const atoms: i32[] = []
  unionArmRowsOfTy(unionTy, atoms)
  // A nullable record: its null is the union's, else it boxes as the record does.
  if tyBearsNull(vty) {
    if exprUnion(exprIx, fnIx) { return 0 }
    const nwvi = wideArmOfRow(structIndexOfExpr(exprIx, fnIx), atoms)
    if nwvi < 0 || nwvi >= uTags.length { return 0 }
    const nvSlot = nulNicheBoxSlot()
    if emitExpr(exprIx, fnIx) < 0 { return -1 }
    fbLocalTee(nvSlot)
    fbRefIsNull()
    fbIfRef(uBoxIdx)
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone()
    fbStructNew(uBoxIdx)
    fbElse()
    fbI32Rel(RS_TAG, uTags[nwvi])
    fbLocalGet(nvSlot)
    fbStructNew(uBoxIdx)
    fbEnd()
    return 1
  }
  // A box narrowed to one arm: its payload re-boxes under the arm it is wider than.
  if exprUnion(exprIx, fnIx) {
    const wvi = narrowBoxWideArmOf(unionTy, exprIx, fnIx)
    if wvi < 0 { return 0 }
    fbI32Rel(RS_TAG, uTags[wvi])
    if emitExpr(exprIx, fnIx) < 0 { return -1 }
    fbStructGet(uBoxIdx, 1)
    fbStructNew(uBoxIdx)
    return 1
  }
  const vi = wideArmPlainOf(unionTy, exprIx, fnIx)
  if vi < 0 { return 0 }
  fbI32Rel(RS_TAG, uTags[vi])
  if emitExpr(exprIx, fnIx) < 0 { return -1 }
  fbStructNew(uBoxIdx)
  return 1
}

// A box of another union with record arms wider than arms of `unionTy`: each such arm is
// re-boxed under the arm its row subtypes, and every other member keeps its tag (D15057).
// Returns 1 handled, 0 when no arm needs it, -1 on error.
function emitUnionWideRetag(unionTy: i32, exprIx: i32, fnIx: i32): i32 {
  if !exprUnion(exprIx, fnIx) { return 0 }
  const fromTags: i32[] = []
  const toTags: i32[] = []
  wideRetagPairs(exprIx, fnIx, unionTy, fromTags, toTags)
  if fromTags.length == 0 { return 0 }
  if emitExpr(exprIx, fnIx) < 0 { return -1 }
  emitWideRetagChain(fromTags, toTags)
  return 1
}

// The box on the stack, re-boxed under `toTags[i]` where its tag is `fromTags[i]`.
function emitWideRetagChain(fromTags: i32[], toTags: i32[]) {
  const slot = unionAsBoxSlot()
  fbLocalSet(slot)
  let i = 0
  while i < fromTags.length {
    fbLocalGet(slot)
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, fromTags[i])
    fbI32Bin(70) // i32.eq
    fbIfRefNul(uBoxIdx, false)
    fbI32Rel(RS_TAG, toTags[i])
    fbLocalGet(slot)
    fbStructGet(uBoxIdx, 1)
    fbStructNew(uBoxIdx)
    fbElse()
    i = i + 1
  }
  fbLocalGet(slot)
  fbRefAsNonNull()
  while i > 0 {
    fbEnd()
    i = i - 1
  }
  return 0
}

// Box a value that is already one arm of a value union — a concrete variant ref, or the
// `nulvariant` niche narrowed non-null — into the `{tag, anyref}` box. Returns 1 handled, 0
// not an arm value, -1 on error. Every box-typed destination delivers through it, since
// `emitUnionCoerce` alone passes an arm value raw, which fits only a variant cell (D1606).
function emitUnionArmValueBox(unionTy: i32, exprIx: i32, fnIx: i32): i32 {
  if exprUnion(exprIx, fnIx) { return 0 }
  const wide = emitUnionWideArmBox(unionTy, exprIx, fnIx)
  if wide != 0 { return wide }
  // A read that can still be null (a record-valued map's miss) is the niche below even where
  // `exprVariantIndex` names its arm: tagging it with the arm boxes the miss as a record (D10170).
  // Asked at the instance too: a type parameter's value is nullable where its pin is.
  const nyNul = nodeTyIsNullable(unwrapParen(exprIx))
    || tyBearsNull(nodeTyAt(unwrapParen(exprIx), fnIx))
  let nvi = -1
  if nyNul { nvi = nulVariantIdxOfExpr(exprIx, fnIx) }
  const svi = exprVariantIndex(exprIx, fnIx)
  if svi >= 0 && nvi < 0 {
    // A struct-typed value built as the plain struct (an anonymous union arm returned from a
    // `: {…}` function, or bound to a struct local) is a layout twin of but a distinct heap
    // type from the arm's variant struct: boxing the raw ref validates, and the narrow's
    // `ref.cast` traps at run time. Rebuild it with `emitStructExprAsVariantBox` instead.
    const bssi = structIndexOfExpr(exprIx, fnIx)
    // The bounds half of the twin test. `structIndexOfExpr` answers a struct table row, and
    // `sHeapIdx` is only as long as the rows that reached heap-type assignment, so a row that
    // never interned a shape indexes past it. Every sibling reader carries this bound, and an
    // out-of-bounds read in the compiler is a wasm trap with no diagnostic.

    // Neither same shapes nor the `is` test is required to reach it: `function f(x: A | i32)`
    // called as `f(mkA())` is enough. What is required is a call result in a union argument
    // position. A row with no heap index cannot be a layout twin of anything, so the compare
    // declines instead of indexing and the program continues to the loud reject.
    if (
      bssi >= 0
      && bssi < sHeapIdx.length
      && sHeapIdx[bssi] != variantHeap(svi)
    ) {
      if emitStructExprAsVariantBox(exprIx, svi, bssi, fnIx) < 0 { return -1 }
      return 1
    }
    fbI32Rel(RS_TAG, uTags[svi]) // 0x41 i32.const <variant tag> (program-global)
    if emitExpr(exprIx, fnIx) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, variant-ref }
    return 1
  }
  // The niche twin of the rung above (D24). A narrowed `Circle | null` is the `nulvariant`
  // niche — one non-null member, so a bare `(ref null $Circle)` and not a `{tag, value}` box —
  // and `exprVariantIndex` answers -1 for it by construction, its arms being the kind-8 param,
  // the declared local and the global, none of which is the nullable cell.

  // The narrow is what makes it sound: this position is only reachable with the value proved
  // non-null, and the box's payload field is `anyref`, so the niche rides it exactly as the
  // non-null variant ref does.
  if !nyNul { nvi = nulVariantIdxOfExpr(exprIx, fnIx) }
  if nvi >= 0 {
    if nvi < uTags.length {
      // Still nullable at this read (no narrow proved it): the null must become the union's
      // null, not a box tagged with the arm over a null payload (D2260).
      if nyNul {
        const nvSlot = nulNicheBoxSlot()
        if emitExpr(exprIx, fnIx) < 0 { return -1 }
        fbLocalTee(nvSlot)
        fbRefIsNull()
        fbIfRef(uBoxIdx) // 0x04 if, (ref $uBox) blocktype
        fbI32Rel(RS_TAG, nullBoxTag())
        fbRefNullNone()
        fbStructNew(uBoxIdx)
        fbElse()
        fbI32Rel(RS_TAG, uTags[nvi])
        fbLocalGet(nvSlot)
        fbStructNew(uBoxIdx)
        fbEnd()
        return 1
      }
      fbI32Rel(RS_TAG, uTags[nvi]) // 0x41 i32.const <variant tag>
      if emitExpr(exprIx, fnIx) < 0 { return -1 }
      fbStructNew(uBoxIdx) // { tag, niche-ref }
      return 1
    }
  }
  return 0
}

// Lower an if-expression whose value is a union as a value-typed `if` with the union box result
// type, each arm union-coerced. Mirrors `emitIfExprAs` in its narrowing save and restore and its
// `else if` recursion, but the blocktype is the `(ref $uBox)` valtype rather than a numeric byte,
// and the arms route through `emitUnionCoerce` so every arm boxes to the same rep.
function emitUnionIfValue(
  unionName: string,
  unionTy: i32,
  ifIx: i32,
  fnIx: i32,
) {
  // An `else if` chain is emitted along its spine, so its depth costs no stack (D1990): each
  // link leaves its frame open for the next, and the frames close innermost-first.
  const open: i32[] = []
  let cur = ifIx
  let rc = 1
  while rc == 1 {
    rc = emitUnionIfValueLink(unionName, unionTy, cur, fnIx, open)
    if rc == 1 {
      const link = nodeAt(unwrapParen(cur))
      if link is IfStmt { cur = link.ifElse }
    }
  }
  return closeIfChainFrames(open, rc, false)
}

// Whether the value `if` at `ifIx` is typed one number some tail is not: delivered as that
// number, every tail is built at it, a literal included, so a nested join means what its
// hoisted twin means (D3571; owner ruling, D3657).
export function ifJoinAdaptsScalar(ifIx: i32, fnIx: i32): boolean {
  const pn = tyPrimNameOf(nodeTyAt(ifIx, fnIx))
  if pn != "i64" && pn != "f64" && pn != "f32" { return false }
  let widens = false
  for lf in valueTailLeaves(ifIx) {
    if tyPrimNameOf(nodeTyAt(lf, fnIx)) != pn { widens = true }
  }
  return widens
}

// One link of `emitUnionIfValue`: 0 or -1 as that function returns, or 1 when the else is another `if`
// and this link's frame is left open (its else restore target pushed onto `open`).
function emitUnionIfValueLink(
  unionName: string,
  unionTy: i32,
  ifIx: i32,
  fnIx: i32,
  open: i32[],
) {
  const s = nodeAt(ifIx)
  if s is IfStmt {
    // An else-less `if` used as a value is `T | null` (`DECISIONS.md`), and in the box rep that
    // null is the null-tagged box — the same value `emitNulNullToLocal` writes for the binding
    // sink's rep 0, built here on the stack instead of into a slot.
    const noElse = s.ifElse < 0
    const condStart = wLen()
    if emitCondExpr(s.ifCond, fnIx) < 0 { return -1 }
    const sg = staticValueIfCond(s.ifCond, condStart)
    fbOpenIf()             // 0x04 if
    fbValtype("union", -1) // result blocktype: the union box `(ref $uBox)`
    let rcT = 0
    if sg == 0 {
      rcT = emitDeadValueArm(s.ifThen)
    } else {
      rcT = emitUnionIfArm(unionName, unionTy, s.ifThen, fnIx)
    }
    if rcT < 0 { return -1 }
    fbElse() // 0x05 else
    let rc = 0
    if noElse {
      fbI32Rel(RS_TAG, nullBoxTag())
      fbRefNullNone() // the payload slot is unread under the null tag
      fbStructNew(uBoxIdx)
    } else {
      const els = nodeAt(s.ifElse)
      if els is IfStmt && !ifJoinAdaptsScalar(s.ifElse, fnIx) {
        open.push(-1)
        return 1 // `else if`: the next link, which the caller emits into this open frame
      } else if els is IfStmt {
        rc = emitUnionBoxOwed(unionName, unionTy, s.ifElse, fnIx)
      } else if sg == 1 {
        rc = emitDeadValueArm(s.ifElse)
      } else {
        rc = emitUnionIfArm(unionName, unionTy, s.ifElse, fnIx)
      }
    }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    return 0
  }
  return emitFail("emitProgram: expected a union if-expression")
}

// One arm of a union if-expression: the arm's prelude, then its tail-value statement
// union-coerced to the box rep (`emitUnionCoerce` — a variant struct boxes, a passthrough
// union rides as-is, a scalar value-boxes).
function emitUnionIfArm(
  unionName: string,
  unionTy: i32,
  blockIx: i32,
  fnIx: i32,
) {
  const b = nodeAt(blockIx)
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if tailIsValueOrNever(tv, fnIx) {
        if emitIfArmOpen(blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        // The if-value's result is the union box (the blocktype), so a concrete-variant arm — a
        // kind-8 `(ref $variant)` local or value — must be boxed to match, exactly as a variant
        // return or argument is. `emitUnionBoxArg` boxes a variant ref and defers every other
        // shape to `emitUnionCoerce`; plain `emitUnionCoerce` would emit the raw variant ref.
        return emitIfArmClose(emitUnionBoxOwed(unionName, unionTy, tv, fnIx))
      }
      // An arm ending in an if-expression joins into the same box: its arms are lowered as
      // this join's own, so every leaf boxes once, whatever the inner `if` alone would type.
      if nodeAt(unwrapParen(tv)) is IfStmt {
        if emitIfArmOpen(blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        // An inner join typed one wider number is that number, boxed once (D3571).
        if ifJoinAdaptsScalar(unwrapParen(tv), fnIx) {
          return emitIfArmClose(emitUnionBoxOwed(unionName, unionTy, tv, fnIx))
        }
        return emitIfArmClose(
          emitUnionIfValue(unionName, unionTy, unwrapParen(tv), fnIx),
        )
      }
    }
    return ifArmNoValueFail("union if-expression arm", blockIx)
  }
  return emitFail("emitProgram: union if-expression arm is not a block")
}

// ── the narrowed-arm delivery unbox (D1031) ──────────────────────────────────

// An `is`-narrowed struct arm is still the `{tag, payload}` box at the wasm level. It is the one
// narrowed rep whose read does not unbox — `emitIdent` carries an unbox arm for the value-atom,
// ref-array and map arms and none for the struct one — so every destination typed at the arm has
// to recover the payload itself.

// Whether `exprIx` is a union of records each stored at heap `heapIdx` (`exprRecordArmsTy`).
function exprRecordArmsAt(exprIx: i32, fnIx: i32, heapIdx: i32): boolean {
  const ru = exprRecordArmsTy(exprIx, fnIx)
  if ru < 0 || heapIdx < 0 || heapIdx == uBoxIdx { return false }
  const ms: i32[] = []
  flattenVariantsInto(ru, ms)
  for m in ms {
    if armHeapOfTy(m) != heapIdx { return false }
  }
  return true
}

// The unbox itself: recover the box's `anyref` payload and cast it to `heapIdx`, nullably when
// `exprIx` is narrowed to `X | null`. Emitted after the value, so the box is already on the
// stack. A negative `heapIdx` emits nothing: a destination whose table slot never resolved has
// no cast target, and `ref.cast -1` would put a garbage heap index in the module.
function emitNarrowedArmUnboxTo(heapIdx: i32, exprIx: i32, fnIx: i32) {
  if !armUnboxCastOwed(heapIdx, exprIx, fnIx) { return 0 }
  armSrcShadowNote(heapIdx, exprIx, fnIx)
  return emitArmUnboxCast(heapIdx, armUnboxNullable(exprIx, fnIx))
}

// Whether a value `narrowedArmNeedsUnbox` owes is a box to cast to `heapIdx`. A union of records is
// one only where every arm is stored at that heap; one built at the slot's own record (D15719)
// is no box and casts nothing.
function armUnboxCastOwed(heapIdx: i32, exprIx: i32, fnIx: i32): boolean {
  return exprRecordArmsAt(exprIx, fnIx, heapIdx)
    || narrowedStructArmVi(exprIx, fnIx) >= 0
    || narrowedNulStructArm(exprIx, fnIx)
    || exprTyIsRecord(exprIx, false, fnIx)
    || exprTyIsRecord(exprIx, true, fnIx)
}

// Whether the unbox of `exprIx` casts nullably: it is narrowed to `X | null`.
function armUnboxNullable(exprIx: i32, fnIx: i32): boolean {
  return narrowedNulStructArm(exprIx, fnIx)
    || exprTyIsRecord(exprIx, true, fnIx)
}

// The node the table last unboxed, so the position that seated it casts nothing itself.
let armServed = -1

// The heap of the arm the checker recorded for the narrowed read `ix` at instance `fnIx`, or -1.
function armRecordHeapAt(ix: i32, fnIx: i32): i32 {
  const a = instTyOrSelf(narrowedArmTyAt(ix, fnIx), fnIx)
  if a < 0 { return -1 }
  return armHeapOfTy(a)
}

// Seat `ix` for the table before a position emits it, where the position owes an arm (`owed`, at
// its slot's heap `siteHeap`) and the read has an arm record. Returns the seat to restore.
function armOpen(owed: boolean, siteHeap: i32, ix: i32, fnIx: i32): i32 {
  const prev = armSeat
  if (
    owed
    && siteHeap >= 0
    && siteHeap != uBoxIdx
    && armRecordHeapAt(ix, fnIx) >= 0
  ) {
    armSeat = ix
  }
  return prev
}

// Close `armOpen`'s seat once the value is on the stack: the table cast it, or the position casts
// at its own heap (a floor the box shadow names). Returns 0.
function armClose(prev: i32, owed: boolean, siteHeap: i32, ix: i32, fnIx: i32) {
  armSeat = prev
  if armServed == ix && ix >= 0 {
    armServed = -1
    if boxDstShadowArmed() {
      boxDstShadowAs("table")
      armSrcShadowNote(armRecordHeapAt(ix, fnIx), ix, fnIx)
    }
    return 0
  }
  if !owed { return 0 }
  if boxDstShadowArmed() { boxDstShadowAs(armFloorWhy(siteHeap, ix, fnIx)) }
  return emitNarrowedArmUnboxTo(siteHeap, ix, fnIx)
}

// Why a position casts `ix` at its own heap, for the box shadow.
function armFloorWhy(siteHeap: i32, ix: i32, fnIx: i32): string {
  if siteHeap < 0 { return "floor: site has no heap" }
  if siteHeap == uBoxIdx { return "floor: site takes the box" }
  if armRecordHeapAt(ix, fnIx) < 0 { return "floor: no record" }
  return "floor: not seated"
}

// That unbox with its nullability given, for a destination that knows it is a niche. A
// destination whose heap is the box itself takes the box as it is.
function emitArmUnboxCast(heapIdx: i32, nullable: boolean) {
  if heapIdx < 0 || heapIdx == uBoxIdx { return 0 }
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  if nullable { fbRefCastNull(heapIdx) } else { fbRefCast(heapIdx) }
  return 0
}

// The pair, applied at a delivery boundary: emit `exprIx`, then unbox it when it arrives as a
// narrowed arm's box and `heapIdx` names the slot it has to land in. A value that is already
// the bare arm emits unchanged, so every site can call this in place of its `emitExpr`.
function emitArmDelivery(exprIx: i32, fnIx: i32, heapIdx: i32) {
  const owed = narrowedArmNeedsUnbox(exprIx, fnIx)
  const ao = armOpen(owed, heapIdx, exprIx, fnIx)
  if emitExpr(exprIx, fnIx) < 0 { return -1 }
  return armClose(ao, owed, heapIdx, exprIx, fnIx)
}

// The heap a code-15 struct field's slot names — `(ref null $sHeapIdx[target])`. -1 where the
// target row does not resolve, which leaves the delivery above emitting what it otherwise emits
// rather than reading `sHeapIdx[-1]` (the `fbValtype` bounds discipline).
function sFieldTgtHeapOf(si: i32, fi: i32): i32 {
  const t = sFieldTgtStructIdx(si, fi)
  if t < 0 || t >= sHeapIdx.length { return -1 }
  return sHeapIdx[t]
}

// The heap a destination names, from the (kind, slot) pair every boundary already holds — the
// same pair `fbValtype` writes the slot's valtype from, so the cast target and the slot cannot
// disagree. -1 for a kind that is not a struct or variant ref and for an index outside its
// table: the delivery then emits unchanged rather than reading `variantHeap(-1)`.

// The slot half of that pair for a module global's cell — read from the same two resolvers the
// assignment arm already reads, so the cast
// target and the declared cell cannot disagree. `globalCellStructIdx` answers the variant index
// for a `variant` or `nulvariant` cell and the struct row for a `struct` one.
function globalCellArmIdx(gLet: i32, kind: VKind): i32 {
  if kind == "nulstruct" { return nulRefStructIdxOfLet(gLet, -1) }
  return globalCellStructIdx(gLet)
}

// The arm unbox at a module global's start-fn initializer, the assignment arm's twin: a box
// delivered into a record cell recovers its payload. A `variant` cell's coerce owns its own.
export function emitGlobalInitArmUnbox(gLet: i32, kind: VKind, initIx: i32) {
  if !globalInitArmUnboxes(kind, initIx) { return 0 }
  return emitNarrowedArmUnboxTo(
    armDestHeapOf(kind, globalCellArmIdx(gLet, kind)),
    initIx,
    -1,
  )
}

// Whether a global's start-fn initializer `initIx`, into a cell of kind `kind`, takes the arm
// unbox `emitGlobalInitArmUnbox` writes.
export function globalInitArmUnboxes(kind: VKind, initIx: i32): boolean {
  return kind != "variant" && narrowedArmNeedsUnbox(initIx, -1)
}

// How the start function writes global `gst`'s initializer value into a cell of kind `gck`:
// a bundle holder's member, a numeric widening, a union-valued map read's box, a union box, a
// bare arm's struct, a generic alias's closure, a `null`-typed init's effects, a literal atom's
// string, or the expression itself. Both the legacy writer and the IR's start body read it.
export type StartInitArm = "holder"
  | "widen"
  | "mapBox"
  | "unionBox"
  | "variant"
  | "alias"
  | "nulnone"
  | "atom"
  | "plain"
export function startInitArmOf(gst: i32, gck: VKind): StartInitArm {
  const g = nodeAt(gst)
  if !(g is LetDecl) { return "plain" }
  if typedHolderMember(gst, -1) >= 0 { return "holder" }
  if gck == "f32" || gck == "f64" || gck == "i64" { return "widen" }
  if letNulMapReadUnionBox(gst, -1) { return "mapBox" }
  if gck == "union" { return "unionBox" }
  if gck == "variant" {
    const svi = globalCellStructIdx(gst)
    if svi >= 0 && svi < uVarRow.length { return "variant" }
  }
  if fnTagLeafId(g.letInit) < 0 && monoGenericAliasFe(gst) >= 0 {
    return "alias"
  }
  if gck == "nulnone" { return "nulnone" }
  if (gck == "str" || gck == "nulstr") && globalInitIsLitAtom(g.letInit) {
    return "atom"
  }
  return "plain"
}

function armDestHeapOf(kind: VKind, idx: i32): i32 {
  if idx < 0 { return -1 }
  // EXHAUSTIVE over `VKind` and `_`-less, like the four byte writers: the 27 kinds with
  // no arm DECLINE by name, so a 32nd member is a compile error here rather than a
  // silent -1 that reads as "this arm has no heap type".
  match kind {
    "variant" | "nulvariant" => {
      if idx < uVarRow.length { return variantHeap(idx) }
      return -1
    }
    "struct" | "nulstruct" => {
      if idx < sHeapIdx.length { return sHeapIdx[idx] }
      return -1
    }
    "i32" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "i64" | "f64" | "f64list" | "f32" | "v128" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "v128list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" => {
      // No heap type of its own at an arm destination: a scalar, a list wrapper, a map
      // or a closure reaches its rep through its own writer, never this table pair.
      return -1
    }
  }
}

// The refusal for delivering such a box where `vi`'s own struct is expected: the value would
// have to be copied into that layout, which would part it from the original.
function emitFailCrossTagDelivery(exprIx: i32, vi: i32): i32 {
  return emitFailAt(
    "emitProgram: a value that fits `"
      + uVariants[vi]
      + "` may be stored as another arm with that field-name set; delivering it as "
      + "that arm would copy it",
    exprIx,
  )
}

// Coerce the expression at `exprIx` to the concrete variant `vi`'s rep `(ref $variantHeap(vi))`.
// The collapse boundary, where a callback typed as one variant meets a mix of reps: an object
// literal builds the bare variant, a narrowed union value unboxes, an already-bare variant
// passes through, a value-`if` join recurses. The variant analogue of `emitUnionCoerce`.
export function emitVariantCoerce(vi: i32, exprIx: i32, fnIx: i32) {
  const bareIx = unwrapParen(exprIx)
  // A `never` call enters any variant, as it enters any union box (D14086).
  return match variantCoerceArmOf(vi, exprIx, fnIx) {
    "none" => -1
    "never" => emitExpr(bareIx, fnIx)
    "ifValue" => emitVariantIfValue(vi, bareIx, fnIx)
    "struct" => emitVariantStruct(bareIx, vi, fnIx)
    "bare" => emitVariantPassThrough(exprIx, fnIx)
    "crossTag" => emitFailCrossTagDelivery(exprIx, vi)
    "box" => emitVariantBoxUnbox(vi, exprIx, fnIx)
    "pass" => emitVariantPassThrough(exprIx, fnIx)
  }
}

// A union box (a narrowed receiver still boxed at the wasm level) unboxed to variant `vi`.
function emitVariantBoxUnbox(vi: i32, exprIx: i32, fnIx: i32) {
  if emitExpr(exprIx, fnIx) < 0 { return -1 }
  if vi < 0 { return -1 }
  return narrowedVariantTail(vi)
}

// A value already in the bare variant rep, delivered to a non-null variant destination. D1115 —
// the kind-9/10 recover this pass-through owes, and the one nullable-niche return
// `emitReturnValue`'s guard cannot reach: a `: Circle` result routes here instead. Every
// destination this serves is non-null, so a narrowed nullable operand would hand it a null ref.
function emitVariantPassThrough(exprIx: i32, fnIx: i32) {
  if emitExpr(exprIx, fnIx) < 0 { return -1 }
  if (
    exprNullableRefNiche(exprIx, fnIx)
    && !readOwesNonNullRecover(exprIx, fnIx)
  ) {
    fbRefAsNonNull()
  }
  return 0
}

// Lower an if-EXPRESSION whose VALUE collapses to the concrete variant `vi` as a value-
// typed `if` with the variant struct result blocktype, each arm variant-coerced. Mirrors
// `emitUnionIfValue` (narrowing save/restore, `else if` recursion).
function emitVariantIfValue(vi: i32, ifIx: i32, fnIx: i32) {
  // An `else if` chain is emitted along its spine, so its depth costs no stack (D1990): each
  // link leaves its frame open for the next, and the frames close innermost-first.
  const open: i32[] = []
  let cur = ifIx
  let rc = 1
  while rc == 1 {
    rc = emitVariantIfValueLink(vi, cur, fnIx, open)
    if rc == 1 {
      const link = nodeAt(unwrapParen(cur))
      if link is IfStmt { cur = link.ifElse }
    }
  }
  return closeIfChainFrames(open, rc, false)
}

// One link of `emitVariantIfValue`: 0 or -1 as that function returns, or 1 when the else is another `if`
// and this link's frame is left open (its else restore target pushed onto `open`).
function emitVariantIfValueLink(vi: i32, ifIx: i32, fnIx: i32, open: i32[]) {
  const s = nodeAt(ifIx)
  if s is IfStmt {
    // An else-less `if` used as a value is `T | null` (`DECISIONS.md`): the variant rep's null
    // is `ref.null $variantHeap(vi)`, so the blocktype goes nullable with it (`fbRefNullOfKind` is
    // `fbValtypeNullable`'s value twin).
    const noElse = s.ifElse < 0
    const condStart = wLen()
    if emitCondExpr(s.ifCond, fnIx) < 0 { return -1 }
    const sg = staticValueIfCond(s.ifCond, condStart)
    fbOpenIf() // 0x04 if
    if noElse {
      fbValtypeNullable("variant", vi) // `(ref null $(variantHeap(vi)))`
    } else {
      fbValtype("variant", vi) // result blocktype: the variant struct `(ref $(variantHeap(vi)))`
    }
    let rcT = 0
    if sg == 0 {
      rcT = emitDeadValueArm(s.ifThen)
    } else {
      rcT = emitVariantIfArm(vi, s.ifThen, fnIx)
    }
    if rcT < 0 { return -1 }
    fbElse() // 0x05 else
    let rc = 0
    if noElse {
      rc = fbRefNullOfKind("variant", vi)
    } else {
      const els = nodeAt(s.ifElse)
      if els is IfStmt {
        open.push(-1)
        return 1 // `else if`: the next link, which the caller emits into this open frame
      } else if sg == 1 {
        rc = emitDeadValueArm(s.ifElse)
      } else {
        rc = emitVariantIfArm(vi, s.ifElse, fnIx)
      }
    }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    return 0
  }
  return emitFail("emitProgram: expected a variant if-expression")
}

// One arm of a variant if-expression: the arm's prelude, then its tail-value statement
// coerced to the concrete variant rep.
function emitVariantIfArm(vi: i32, blockIx: i32, fnIx: i32) {
  const b = nodeAt(blockIx)
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if tailIsValueOrNever(tv, fnIx) {
        if emitIfArmOpen(blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        return emitIfArmClose(emitVariantCoerce(vi, tv, fnIx))
      }
      // An arm ending in an if-expression joins at the same variant, as the union twin does.
      if nodeAt(unwrapParen(tv)) is IfStmt {
        if emitIfArmOpen(blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        return emitIfArmClose(emitVariantIfValue(vi, unwrapParen(tv), fnIx))
      }
    }
    return ifArmNoValueFail("variant if-expression arm", blockIx)
  }
  return emitFail("emitProgram: variant if-expression arm is not a block")
}

// ── union `==` and `!=` ─────────────────────────────────────────────────────

// `==` and `!=` are structural by value, so a still-boxed value-union operand compares by "does
// the box's tag select the arm whose rep matches the other side, and does the unboxed payload
// value-equal it". The tag compare gates the payload compare — the payload `ref.cast` would
// trap on a wrong-rep arm — as a value-typed `if`, which is the short-circuit needed.

// This emitter re-evaluates the operand rather than hoisting each box into a fresh local, the
// established struct-`==` pattern, so a union operand is restricted to a simple binding read:
// re-reading an ident is effect-free and yields the same box. Anything effectful fails loudly.

// Unbox a union payload already pushed as `anyref` (`struct.get $box 1`) to the rep of the arm
// whose value-atom kind is `k`: a string payload (kind 2) is the string array, cast only; a
// scalar rides its per-rep value box, cast plus field 0. Mirrors `emitValueUnionUnboxRead`.

// Keyed on the atom's code and not its spelling: `atom == "string"` and `vbHeapIdxOfKind` are
// both projections of that one code, and every caller already holds it — the box tag it emits
// one instruction earlier is `scalarTagOfKind` of the same code. A member that is not a value
// atom reaches `vbHeapIdxOfKind(-1)` and the same loud reject.
function emitUnionPayloadUnbox(k: i32) {
  if k == 2 {
    fbRefCast(sTy()) // the payload IS the string array ref
    return 0
  }
  // A list arm rides the box's `value` field as its wrapper ref, exactly as a string does —
  // `emitUnionUnboxTail`'s ladder, which every other reader of a boxed list arm takes. Without
  // this rung a list arm reaches the scalar value-box lookup and refuses with "atom has no
  // value box" on a `vl check`-clean program.

  // D1098 — a closure arm's payload is the closure fat-pointer struct, exactly as
  // `emitUnionUnboxTail` recovers it for a narrowed read. Without this rung it reaches the
  // scalar value-box lookup and refuses the same way.
  if k == 11 {
    fbRefCast(cloStructIdx)
    return 0
  }
  const lw = listWrapHeapOfKind(k)
  if lw >= 0 {
    fbRefCast(lw)
    return 0
  }
  const vb = vbHeapIdxOfKind(k)
  if vb < 0 { return emitFail("emitProgram: union `==` atom has no value box") }
  fbRefCast(vb)      // 0xfb 0x16 <value box>
  fbStructGet(vb, 0) // the scalar payload
  return 0
}

// The per-arm payload compare of a union `==`, with both payloads already unboxed to the arm's
// rep and on the stack (left below right), leaving the 0/1 answer. One home for the three
// union-`==` lowerings — union against union over a value union, over a struct union, and union
// against concrete — so a rep that compares at one spelling cannot refuse at another.
function emitUnionAtomPayloadEq(k: i32, fnIx: i32) {
  if k == 2 { return emitStrEqCore() }
  // D1098 — two closures are equal by function IDENTITY (id + env), a separate core with its
  // own frame (`cloEqNoteBin`), and this ladder is where the arm reaches it.
  if k == 11 { return emitCloEqCore() }
  const lk = leqCoreKindOfAtomKind(k)
  if lk >= 0 { return emitListEqAnyRep(lk, atomEqSlotOfKind(k), fnIx) }
  // D-EQOPCODE: the scalar payload compare's opcode is another projection of the same code
  // that chose the tag and the unbox, not a fresh question about the arm's spelling.
  fbI32Bin(atomEqOpcodeOfKind(k))
  return 0
}

// Emit the concrete operand at `otherIx` in the rep of the arm whose value-atom kind is `k` — an
// i32 literal widens to the arm's i64, f64 or f32. Keyed on the code: the three spellings this
// would otherwise compare are the codes 3 / 4 / 5, which `valueAtomKind` assigns to `i64`, `f64`
// and `f32` and to no other spelling, so the caller's single derivation answers all three.
function emitUnionEqOther(otherIx: i32, k: i32, fnIx: i32) {
  if k == 3 { return emitWidened(otherIx, 3, fnIx) }
  if k == 4 { return emitWidened(otherIx, 4, fnIx) }
  // The STRING arm's widening twin of the three numeric ones: a literal-union ATOM operand
  // becomes its member string (`emitStrValue`), which is the rep the box's string payload is
  // compared against. `emitStrValue` is `emitExpr` for everything that is already a string.
  if k == 2 { return emitStrValue(otherIx, fnIx) }
  if k == 5 { return emitWidened(otherIx, 5, fnIx) }
  return emitExpr(otherIx, fnIx)
}

// Union against a concrete value, in either operand order: the box's tag must select the arm
// whose rep matches the other side, then the unboxed payload value-compares it. A rep with no
// arm is statically unequal, `==` 0 and `!=` 1, with both operands still evaluated for side
// effects, box side first. `isNe` negates the result for `!=`.
function emitUnionConcreteEq(
  boxIx: i32,
  otherIx: i32,
  isNe: boolean,
  fnIx: i32,
) {
  // D972 — a non-re-readable operand is stashed at its first read, not refused. This compare
  // reads the box up to three times — the no-arm fold, the tag, and the payload inside the
  // tag-matched arm — which is the whole content of `unionEqOperandOk` (Ident, NumLit, StrLit,
  // Member, Index). A call operand is not re-readable.

  // Teed at the first read rather than pre-emitted at the top: the operand must be evaluated
  // where the original code evaluated it, so any context the surrounding lowering seeds is still
  // in force. Pre-emitting it ahead of the gates traps.
  const eqStash = unionEqStashSlot()
  const eqOnce = !unionEqOperandOk(boxIx)
  const unr: i32[] = []
  const uname = unionNameRowOfExpr(boxIx, fnIx, unr)
  // D-VALUNION / D-SETONCE: the union's interned member set, resolved ONCE — the
  // value-union gate below reads its banked member codes instead of re-splitting the
  // rendering.
  const usid = msSetOfUnionBox(boxIx, fnIx)
  // D1071 — the other operand's rep code, with a real "not an atom" answer. `-1` here is out of
  // band; the two branches below are the only readers, and both consume the code rather than a
  // spelling. `valueAtomNameOfKind` re-derives the spelling for the membership test's decline
  // argument, a bijection over the seven scalar codes and "" above them.
  const eak = unionEqAtomKindOf(
    otherIx,
    usid,
    unionBoxTyOfRead(boxIx, fnIx),
    fnIx,
  )
  const atom = valueAtomNameOfKind(eak)
  if eak < 0 {
    // The operand has no atom rep — a struct, a map, a shape the arena named. The box can still
    // hold it as a variant arm, which is a tag test plus that arm's field compare.
    if emitUnionConcreteVariantEq(boxIx, otherIx, isNe, fnIx) == 0 { return 0 }
    return emitFail(
      "emitProgram: `==` over a struct union is not supported yet",
    )
  }
  // A mixed union is comparable to a scalar literal. The compare below is arm-agnostic: it reads
  // the box's tag, compares it to the tag of the atom the other operand names, and on a match
  // compares that one payload. The union's remaining arms are never touched — a container arm
  // simply has a tag that does not match, the right answer, needing no compare core.

  // So requiring the whole union to be a value union is stronger than the lowering needs, and
  // would refuse `v == "b"` over a `Json` carrying list and map arms. Widened only where the
  // other operand names an atom the union actually carries: `unionEqArmPresent` is the same
  // membership test the static-false fold below trusts.

  // A `string`-repped other operand has an arm whenever the box can carry it as a string ref — a
  // plain `string` arm or a literal-union arm, `msSetTakesAtomAsStr`'s question and
  // `emitUnionLitIs`'s second leg. The gate asks it too: an alias arm beside a record (`K | E`)
  // has no banked string kind, and the box carries it as one (D4340).
  let eqHasArm = unionEqArmPresent(usid, atom, eak)
  if !eqHasArm && eak == 2 && msSetTakesAtomAsStr(usid) { eqHasArm = true }
  if (
    uname == ""
    || (!isValueUnionOfSet(usid, unr[1])
      && !unionCarriesLitUnionArmOfSet(usid, unr[1])
      && !eqHasArm)
  ) {
    // The second door to the variant compare, for an operand the arena declined to type
    // (`valueRowKind` -2) and which therefore still carries the ladder's i32 default. The
    // expression itself can still name a concrete variant, and reading it is the only thing
    // that distinguishes "an i32" from "a row the arena has not recorded".
    if emitUnionConcreteVariantEq(boxIx, otherIx, isNe, fnIx) == 0 { return 0 }
    return emitFail(
      "emitProgram: `==` over a struct union is not supported yet",
    )
  }
  // Without the string leg above a `K | i32` box statically answers `u == k` false: the banked
  // member kinds carry only `i32`, so the arm that holds the value looks absent.
  if !eqHasArm {
    // A number arm the operand widens to or from compares by value (D15090).
    const cross = emitUnionConcreteNumCross(
      boxIx,
      otherIx,
      eak,
      isNe,
      unr[0],
      fnIx,
    )
    if cross != 0 { return if cross < 0 { -1 } else { 0 } }
    // No arm has the other operand's rep: the box can never hold such a value.
    if emitExpr(boxIx, fnIx) < 0 { return -1 }
    fbDrop() // 0x1a drop
    if emitUnionEqOther(otherIx, eak, fnIx) < 0 { return -1 }
    fbDrop() // 0x1a drop
    if isNe { fbI32Const(1) } else { fbI32Const(0) }
    return 0
  }
  // A `K | null` operand equals the box's null when it is `-1`, and is a member string
  // otherwise, where the widened operand is non-null (D3347).
  const nulOther = eak == 2
    && exprNulLitUnion(otherIx, fnIx)
    && unionEqOperandOk(otherIx)
    && !eqOnce
    && unionSetHasNullTy(uname, unionBoxTyOfRead(boxIx, fnIx))
  if nulOther {
    if emitExpr(otherIx, fnIx) < 0 { return -1 }
    fbI32Const(-1)
    fbI32Bin(70)
    fbIf(127)
    if emitExpr(boxIx, fnIx) < 0 { return -1 }
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, nullBoxTag())
    fbI32Bin(70)
    fbElse()
  }
  // A nullable string at the instance (`T` pinned to `string | null`) equals the box's null when
  // it is null, read raw for the test; present, it compares as the string below.
  const nulStrOther = eak == 2
    && !nulOther
    && tyBearsNull(nodeTyAt(unwrapParen(otherIx), fnIx))
    && unionEqOperandOk(otherIx)
    && !eqOnce
    && unionSetHasNullTy(uname, unionBoxTyOfRead(boxIx, fnIx))
  // The `boolean | null` niche's null is the value 2 (D2260).
  const nulBoolOther = eak == 1
    && tyBearsNull(nodeTyAt(unwrapParen(otherIx), fnIx))
    && unionEqOperandOk(otherIx)
    && !eqOnce
    && unionSetHasNullTy(uname, unionBoxTyOfRead(boxIx, fnIx))
  if nulBoolOther {
    if emitExpr(otherIx, fnIx) < 0 { return -1 }
    fbI32Const(2)
    fbI32Bin(70)
    fbIf(127)
    if emitExpr(boxIx, fnIx) < 0 { return -1 }
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, nullBoxTag())
    fbI32Bin(70)
    fbElse()
  }
  if nulStrOther {
    if emitExpr(otherIx, fnIx) < 0 { return -1 }
    fbRefIsNull()
    fbIf(127)
    if emitExpr(boxIx, fnIx) < 0 { return -1 }
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, nullBoxTag())
    fbI32Bin(70)
    fbElse()
  }
  // tag == tagOf(atom), gating the payload compare.
  if emitExpr(boxIx, fnIx) < 0 { return -1 }
  if eqOnce { fbLocalTee(eqStash) }
  fbStructGet(uBoxIdx, 0) // 0xfb 0x02 <box ht> field 0: tag
  // The CONCRETE operand's own arm type, through the very composition the BOX site uses
  // (`cloBoxOwnFnTy` → `cloArmTagOfTy`), so a closure arm is tested against the tag its box
  // actually writes.
  fbI32Rel(RS_TAG, unionEqTagOfArmTy(eak, cloBoxEqArmTy(otherIx, unr[0], fnIx)))
  fbI32Bin(70)            // 0x46 i32.eq
  fbIf(127)               // 0x04 if, 0x7f i32 result blocktype
  if eqOnce { fbLocalGet(eqStash) }
  else if emitExpr(boxIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  if emitUnionPayloadUnbox(eak) < 0 { return -1 }
  if emitUnionEqOther(otherIx, eak, fnIx) < 0 { return -1 }
  // The null took the other branch, so a nullable operand is the non-null ref here.
  if (
    nulOther
    || nulStrOther && tyBearsNull(nodeTyAt(unwrapParen(otherIx), fnIx))
  ) {
    fbRefAsNonNull()
  }
  // D-EQOPCODE: the payload compare is the last projection of `eak`, which already chose
  // the box tag, the payload unbox and the widened operand emit above it.
  if emitUnionAtomPayloadEq(eak, fnIx) < 0 { return -1 }
  fbElse() // 0x05 else: wrong-rep arm — structurally unequal
  fbI32Const(0)
  fbEnd()  // 0x0b end
  if nulOther || nulStrOther || nulBoolOther { fbEnd() }
  if isNe {
    fbI32Eqz() // 0x45 i32.eqz (`!=` negates value-equality)
  }
  return 0
}

// D1098 — the box tag of one arm of a union `==`, which is `scalarTagOfKind` for every atom
// except a bare closure. A closure arm's tag is keyed on its signature (`cloArmTagOfTy` through
// `cloSigSlotTag`): the first signature a module interns keeps the flat kind-11 offset and each
// further one claims the band above, so `scalarTagOfKind(11)` is right for only one of them.

// The tag has one home — `cloArmTagOfTy`, whose box side is `emitUnionCoerce` and whose test
// side is `isArmTagOfTy`. This routes the compare through it too, so all three derive an arm's
// tag from one render of one arena type; `cloBoxOwnFnTy` names the caller split.
function unionEqTagOfArmTy(k: i32, armTy: i32): i32 {
  if k == 11 { return cloArmTagOfTy(armTy) }
  return scalarTagOfKind(k)
}

// Does the union carry an arm at the other operand's rep? One question, two instruments, split
// on whether the code has a spelling: the seven scalar codes take the banked `unionHasAtomK`
// with its keyword fall-through, and a container code — which `valueAtomNameOfKind` cannot name,
// 7 being `i32[]` and `boolean[]` and `K[]` — takes the member walk. Both readers ask here.
function unionEqArmPresent(usid: i32, atom: string, eak: i32): boolean {
  if atom == "" { return unionHasAtomKindArm(usid, eak) }
  return unionHasAtomK(usid, atom, eak)
}

// D1180 — the variant row the concrete operand's value actually has, which is not always the row
// `exprVariantIndex` names. That resolver is rep-authoritative over bindings, so it carries a leg
// per storage class and none for a struct-field read, and an un-annotated object literal is
// declined once the struct table holds a row matching its field set.

// The bridge is heap identity, not shape matching: `sHeapIdx` and `variantHeap` are two index spaces
// over one wasm type space, and two rows that interned to the same wasm struct type hold
// interchangeable values. Where they interned separately this answers -1 and the caller keeps its
// loud refusal. Exactly one match, or none: two arms sharing a heap type do not fix the tag.
function eqConcreteVariantRow(exprIx: i32, fnIx: i32) {
  const vi = exprVariantIndex(exprIx, fnIx)
  if vi >= 0 { return vi }
  // The nullable-niche storage class. A code-15 field read whose target is a union arm binds
  // `nulvariant` (D1112), which `exprVariantIndex` declines because that resolver is the non-null
  // one, and which `structIndexOfExpr` declines because an arm has no `sNames` row — so a cell
  // between the two kinds falls through both rungs to the caller's loud refusal.

  // Asked ahead of the heap scan because it is the exact answer: the bridge below infers a row
  // from heap identity and must decline an ambiguous match, while this reads the arm the
  // checker's own type names. The value is the same nullable niche the `nulstruct` operand parks,
  // and the field `struct.get` traps on null exactly as it does for that one.
  const nvi = nulVariantIdxOfExpr(exprIx, fnIx)
  if nvi >= 0 { return nvi }
  const ssi = structIndexOfExpr(exprIx, fnIx)
  if ssi < 0 { return -1 }
  if ssi >= sHeapIdx.length { return -1 }
  const h = sHeapIdx[ssi]
  let found = -1
  let i = 0
  while i < uVarRow.length {
    if variantHeap(i) == h {
      if found >= 0 { return -1 }
      found = i
    }
    i = i + 1
  }
  return found
}

// D1071 — union `==` a concrete variant (`p == a` with `p: A | i32` and `a: A`). The box's tag
// selects the arm, and on a match that arm's payload is compared field-wise against the concrete
// operand — the union-against-union compare with one side's unbox deleted. -1 declines.

// The concrete operand already has the arm's heap type: when a union is declared the union path
// owns the struct types, so a `const a: A = {x: 1}` beside `type A` in an `A | i32` is a
// `(ref $variantHeap(vi))`. The box is evaluated first and once and both operands are parked, which
// is what lets a non-place operand work here without `emitUnionConcreteEq`'s gate.
function emitUnionConcreteVariantEq(
  boxIx: i32,
  otherIx: i32,
  isNe: boolean,
  fnIx: i32,
) {
  const vi = eqConcreteVariantRow(otherIx, fnIx)
  if vi < 0 { return -1 }
  // The same four parallel-table bounds `emitStructUnionEq` takes before it writes a byte,
  // for the same reason: a variant row the emitter's tables do not cover must DECLINE, never
  // read out of bounds (`emitFail does not halt`).
  if vi >= uVarRow.length { return -1 }
  if vi >= uTags.length { return -1 }
  if vi >= uFieldStart.length { return -1 }
  if vi >= uFieldCount.length { return -1 }
  if !variantFieldsComparable(vi) { return -1 }
  const sl = unionEqStashSlot()
  const ar = unionEqArmSlot(vi + 1024)
  // Both operands ride the wasm stack until both are computed, and only then are they parked.
  // The three scratch slots here are shared per function, not per site, so a union `==` nested
  // inside `otherIx` re-enters this function and re-uses the same slots. A stack value cannot be
  // reached that way, and after the second operand lands no user code runs before the compare.
  if emitExpr(boxIx, fnIx) < 0 { return -1 }
  // A nullable record at the instance is read raw, and its null equals the box's null arm.
  const otherNul = tyBearsNull(nodeTyAt(unwrapParen(otherIx), fnIx))
  if otherNul {
    if emitExpr(otherIx, fnIx) < 0 { return -1 }
  } else if emitExpr(otherIx, fnIx) < 0 {
    return -1
  }
  fbLocalSet(ar) // pops the concrete operand, leaving the box on top
  fbLocalSet(sl)
  if otherNul {
    fbLocalGet(ar)
    fbRefIsNull()
    fbIf(127) // 0x04 if, i32 result: null against the box's null tag
    fbLocalGet(sl)
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, nullBoxTag())
    fbI32Bin(70)
    fbElse()
  }
  fbLocalGet(sl)
  fbStructGet(uBoxIdx, 0)     // field 0: tag
  fbI32Rel(RS_TAG, uTags[vi]) // the arm's program-global tag
  fbI32Bin(70)                // 0x46 i32.eq
  fbIf(127)                   // 0x04 if, i32 result
  const al = unionEqArmSlot(vi)
  fbLocalGet(sl)
  fbStructGet(uBoxIdx, 1)     // field 1: payload (anyref)
  fbRefCast(variantHeap(vi))
  fbLocalSet(al)
  if emitVariantFieldsEq(al, ar, vi, fnIx) < 0 { return -1 }
  fbElse()                    // the box holds a different arm — structurally unequal
  fbI32Const(0)
  fbEnd()
  if otherNul { fbEnd() }
  if isNe { fbI32Eqz() }
  return 0
}

// D973 — `==` over a struct union (`A | B` of declared shapes), both operands the same set.
// Tags unequal means different arms and therefore unequal; tags equal selects one arm, and that
// arm's fields are compared through the variant table. -1 declines.

// Not `emitStructEqRec`, which is keyed on a struct-table row: that table is empty when a union
// is declared, the union path owning the struct types instead, so the arms' fields live in
// `armFieldNames` and `armFieldStoreTy` and the compare reads them there. A scalar arm beside the
// struct ones is served too; its tag is `scalarTagOfKind`, which no variant tag can collide with.
function emitStructUnionEq(
  lIx: i32,
  rIx: i32,
  isNe: boolean,
  uty: i32,
  fnIx: i32,
) {
  const arms: i32[] = []
  const vis: i32[] = []
  const aks: i32[] = []
  if !unionBoxEqColumns(uty, arms, vis, aks) { return -1 }
  // Both operands ride the wasm stack until both are computed, and only then are they parked.
  // These slots are shared per function, so a left operand parked before the right one is
  // evaluated is a value the right one's code can overwrite — a nested union `==` re-enters this
  // function and re-uses the two slots. The evaluation order is unchanged: left, then right.
  if emitExpr(lIx, fnIx) < 0 { return -1 }
  if emitExpr(rIx, fnIx) < 0 { return -1 }
  return emitUnionBoxEqStaged(arms, vis, aks, isNe, fnIx)
}

// The tag-then-arm compare over two boxes already on the stack (left below right), leaving the
// 0/1 answer. Split from the operand evaluation because a box-typed field reaches this same core
// through two chain reads rather than two expressions (D1290), and two callers must not carry two
// copies of the dispatch.
function emitUnionBoxEqStaged(
  armTys: i32[],
  vis: i32[],
  aks: i32[],
  isNe: boolean,
  fnIx: i32,
) {
  return emitUnionBoxEqStagedX(armTys, vis, aks, aks, isNe, fnIx)
}

// `emitUnionBoxEqStaged` where the right operand's union has number arms of kinds `rAks`, which
// a left number arm of another width compares against by value (D15090).
function emitUnionBoxEqStagedX(
  armTys: i32[],
  vis: i32[],
  aks: i32[],
  rAks: i32[],
  isNe: boolean,
  fnIx: i32,
) {
  const sl = unionEqStashSlot()
  const sr = unionEqStashSlot2()
  fbLocalSet(sr) // pops the right operand, leaving the left on top
  fbLocalSet(sl)
  // Tags first: two different arms are never equal, and the tag is the arm.
  fbLocalGet(sl)
  fbStructGet(uBoxIdx, 0)
  fbLocalGet(sr)
  fbStructGet(uBoxIdx, 0)
  fbI32Bin(70) // 0x46 i32.eq
  fbIf(127)    // 0x04 if, i32 result
  // Then one arm per tag; the last is the fall-through, so N arms need N-1 tests.
  let a = 0
  while a < vis.length - 1 {
    fbLocalGet(sl)
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, unionArmTagOf(vis[a], aks[a], armTys[a]))
    fbI32Bin(70)
    fbIf(127)
    if emitUnionArmEq(sl, sr, vis[a], aks[a], fnIx) < 0 { return -1 }
    fbElse()
    a = a + 1
  }
  // The chain's fall-through arm — the tag can only be this one by elimination, so it gets
  // no test of its own.
  const lastRc = emitUnionArmEq(
    sl,
    sr,
    vis[vis.length - 1],
    aks[aks.length - 1],
    fnIx,
  )
  if lastRc < 0 { return -1 }
  let e = 0
  while e < vis.length - 1 {
    fbEnd()
    e = e + 1
  }
  fbElse() // tags differ
  // Two number arms compare by value at the wider of the two (D15090).
  const numPairs = emitUnionNumCrossArms(sl, sr, aks, rAks)
  if numPairs < 0 { return -1 }
  if unionCloArmCount(aks) >= 2 {
    // A function value's identity is its declaration, whichever function-type arm holds it.
    emitUnionCloTagIn(sl, vis, aks, armTys)
    fbIf(127)
    emitUnionCloTagIn(sr, vis, aks, armTys)
    fbIf(127)
    if emitUnionArmEq(sl, sr, -1, 11, fnIx) < 0 { return -1 }
    fbElse()
    fbI32Const(0)
    fbEnd()
    fbElse()
    fbI32Const(0)
    fbEnd()
  } else {
    fbI32Const(0)
  }
  let np = 0
  while np < numPairs {
    fbEnd()
    np = np + 1
  }
  fbEnd()
  if isNe { fbI32Eqz() }
  return 0
}

const UNION_NUM_CROSS_NO_TYS_MSG = "emitProgram: a union compared with a number has no member types to read its arms from"

// `emitUnionConcreteEq` where the box's union (row `u`, else the box's type) has no arm of number kind
// `eak` but arms of a kind it widens to or from: box and operand are evaluated once and each such
// arm compares at the wider kind; any other arm is unequal. Returns 1 handled, 0 when no arm
// qualifies, -1 on error.
function emitUnionConcreteNumCross(
  boxIx: i32,
  otherIx: i32,
  eak: i32,
  isNe: boolean,
  u: i32,
  fnIx: i32,
): i32 {
  const kinds: i32[] = []
  const tys: i32[] = []
  if !(u >= 0 && unionMemberTysOfRow(u, tys)) {
    if !unionTyMemberTys(tyPeelNul(unionBoxTyOfRead(boxIx, fnIx)), tys) {
      return emitFail(UNION_NUM_CROSS_NO_TYS_MSG)
    }
  }
  for t in tys { kinds.push(boxAtomKindOfMemberTy(t)) }
  const kas: i32[] = []
  for ka in kinds {
    if ka != eak && numEqOpOfKind(wideKindOf(ka, eak)) >= 0 { kas.push(ka) }
  }
  if kas.length == 0 { return 0 }
  const bs = unionAsBoxSlot()
  const os = numCrossEqSlot(eak)
  if emitExpr(boxIx, fnIx) < 0 { return -1 }
  fbLocalSet(bs)
  if emitUnionEqOther(otherIx, eak, fnIx) < 0 { return -1 }
  fbLocalSet(os)
  for ka in kas {
    fbLocalGet(bs)
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, scalarTagOfKind(ka))
    fbI32Bin(70) // i32.eq
    fbIf(127)
    fbLocalGet(bs)
    if emitUnionUnboxTail(ka) < 0 { return -1 }
    const upL = widenConvOpOfKinds(ka, eak)
    if upL >= 0 { wU8(upL) }
    fbLocalGet(os)
    const upR = widenConvOpOfKinds(eak, ka)
    if upR >= 0 { wU8(upR) }
    wU8(numEqOpOfKind(wideKindOf(ka, eak)))
    fbElse()
  }
  fbI32Const(0)
  for _ka in kas { fbEnd() }
  if isNe { fbI32Eqz() }
  return 1
}

// The kind two number kinds compare at: the one the other widens to, or -1 when neither does.
function wideKindOf(a: i32, b: i32): i32 {
  if widenConvOpOfKinds(a, b) >= 0 { return b }
  if widenConvOpOfKinds(b, a) >= 0 { return a }
  return -1
}

// For each left number arm of `aks` and right one of `rAks` one widens to the other, an `if` on
// the boxes parked in `sl` and `sr` holding exactly that pair, comparing the two values at the
// wider type, each left open on its `else`. Returns how many it opened, or -1 on error.
function emitUnionNumCrossArms(sl: i32, sr: i32, aks: i32[], rAks: i32[]): i32 {
  let opened = 0
  for ka in aks {
    for kb in rAks {
      if ka != kb && emitUnionNumCrossArm(sl, sr, ka, kb) {
        opened = opened + 1
      }
    }
  }
  return opened
}

// One arm of `emitUnionNumCrossArms` for left kind `ka` against right kind `kb`; false, and
// nothing emitted, when neither widens to the other.
function emitUnionNumCrossArm(sl: i32, sr: i32, ka: i32, kb: i32): boolean {
  const upL = widenConvOpOfKinds(ka, kb)
  const upR = widenConvOpOfKinds(kb, ka)
  if upL < 0 && upR < 0 { return false }
  let wide = kb
  if upR >= 0 { wide = ka }
  const eqOp = numEqOpOfKind(wide)
  if eqOp < 0 { return false }
  fbLocalGet(sl)
  fbStructGet(uBoxIdx, 0)
  fbI32Rel(RS_TAG, scalarTagOfKind(ka))
  fbI32Bin(70) // i32.eq
  fbLocalGet(sr)
  fbStructGet(uBoxIdx, 0)
  fbI32Rel(RS_TAG, scalarTagOfKind(kb))
  fbI32Bin(70) // i32.eq
  fbI32And()
  fbIf(127)
  fbLocalGet(sl)
  if emitUnionUnboxTail(ka) < 0 { return false }
  if upL >= 0 { wU8(upL) }
  fbLocalGet(sr)
  if emitUnionUnboxTail(kb) < 0 { return false }
  if upR >= 0 { wU8(upR) }
  wU8(eqOp)
  fbElse()
  return true
}

// The `eq` opcode of number kind `k`, or -1.
function numEqOpOfKind(k: i32): i32 {
  const p = numPrimOfKind(k)
  if p == null { return -1 }
  return primOpcode("eq", p)
}

// The value-eq opcode of value atom kind `k`: a number kind's, i32's for a boolean, and -1 for
// every other kind (a string compares by its loop, a null by its tag alone).
function atomEqOpcodeOfKind(k: i32): i32 {
  if k == 1 { return primOpcode("eq", "bool") }
  return numEqOpOfKind(k)
}

// How many of a union's arms are function values (atom kind 11).
function unionCloArmCount(aks: i32[]): i32 {
  let n = 0
  for ak in aks {
    if ak == 11 { n = n + 1 }
  }
  return n
}

// Pushes whether the box parked in `slot` sits in one of the union's function-value arms.
function emitUnionCloTagIn(slot: i32, vis: i32[], aks: i32[], armTys: i32[]) {
  fbI32Const(0)
  let a = 0
  while a < aks.length {
    if aks[a] == 11 {
      fbLocalGet(slot)
      fbStructGet(uBoxIdx, 0)
      fbI32Rel(RS_TAG, unionArmTagOf(vis[a], aks[a], armTys[a]))
      fbI32Bin(70)  // 0x46 i32.eq
      fbI32Bin(114) // 0x72 i32.or
    }
    a = a + 1
  }
  return 0
}

// One home for "can this variant field be compared", mirrored arm for arm by
// `emitVariantFieldEqCore`: this one decides and that one emits, so a code admitted here with no
// core there is invalid wasm on a `vl check`-clean program.

// D1061 — the box tag of one arm of a mixed struct/scalar union, from whichever of the two
// per-arm columns holds it. The two tag spaces are disjoint by construction: a variant tag is an
// index into `uVariants` and `scalarTagOfKind(k)` is `uVariants.length + k`.
function unionArmTagOf(vi: i32, ak: i32, armTy: i32): i32 {
  if vi >= 0 { return uTags[vi] }
  return unionEqTagOfArmTy(ak, armTy)
}

// D1061 — one arm of a mixed struct/scalar union, dispatched on which column named it. The
// tag test that selects this arm has ALREADY proved both boxes carry it, so each half only
// has to compare the arm's own payload.
function emitUnionArmEq(sl: i32, sr: i32, vi: i32, ak: i32, fnIx: i32) {
  if vi >= 0 { return emitVariantArmEq(sl, sr, vi, fnIx) }
  // The NULL arm carries no payload at all: two boxes that agree on the null tag are equal,
  // and the enclosing tag test is that agreement.
  if ak == nullValKind() {
    fbI32Const(1)
    return 0
  }
  fbLocalGet(sl)
  fbStructGet(uBoxIdx, 1)
  if emitUnionPayloadUnbox(ak) < 0 { return -1 }
  fbLocalGet(sr)
  fbStructGet(uBoxIdx, 1)
  if emitUnionPayloadUnbox(ak) < 0 { return -1 }
  return emitUnionAtomPayloadEq(ak, fnIx)
}

// One arm: cast both payloads to the arm's variant heap, park them, and AND the fields.
function emitVariantArmEq(sl: i32, sr: i32, vi: i32, fnIx: i32) {
  const al = unionEqArmSlot(vi)
  const ar = unionEqArmSlot(vi + 1024)
  fbLocalGet(sl)
  fbStructGet(uBoxIdx, 1)
  fbRefCast(variantHeap(vi))
  fbLocalSet(al)
  fbLocalGet(sr)
  fbStructGet(uBoxIdx, 1)
  fbRefCast(variantHeap(vi))
  fbLocalSet(ar)
  return emitVariantFieldsEq(al, ar, vi, fnIx)
}

// AND the fields of variant `vi` over two already-cast variant refs parked in `al` and `ar`,
// leaving one i32. Split from `emitVariantArmEq` because the two operands do not always both
// arrive out of a box: a union compared against a concrete variant (D1071) unboxes only the left
// one and parks the right operand's own value directly. Only the unbox differs.
function emitVariantFieldsEq(al: i32, ar: i32, vi: i32, fnIx: i32) {
  // Only the hole is refused here because both callers already took the same four bounds —
  // `emitStructUnionEqConcrete` spells them out, and every `vis` entry the staged compare
  // passes came through `unionBoxEqColumns`, which declines a row the four tables miss.
  if vi < 0 { return -1 }
  const start = uFieldStart[vi]
  const cnt = uFieldCount[vi]
  fbI32Const(1)
  let j = 0
  while j < cnt {
    // D1180 — a ref-niche field, and a code-15 field whose slot is `(ref null $S)` at both
    // spellings, take the null guard: the payload may legitimately be `null`, and the core
    // underneath would `struct.get` it. Without the guard an `Inner | null` arm field is
    // `vl check` rc 0 and traps on `{d: null} == {d: null}`.
    const jc = fieldRowKind(start + j)
    const jn = nulFieldInnerKind(jc)
    if jn != null || eqKindIsRecord(jc) {
      let inner = jc
      if jn != null { inner = jn }
      if (emitVariantNulFieldEq(al, ar, vi, j, start + j, inner, fnIx) < 0) {
        return -1
      }
    } else {
      fbLocalGet(al)
      fbStructGet(variantHeap(vi), j)
      fbLocalGet(ar)
      fbStructGet(variantHeap(vi), j)
      if emitVariantFieldEqCore(vi, start + j, fnIx) < 0 { return -1 }
    }
    fbI32Bin(113) // 0x71 i32.and
    j = j + 1
  }
  return 0
}

// `al.f == ar.f` for a nullable-slotted arm field: the struct ladder's guard, spelled over the
// two parked variant refs instead of a chain path. Both re-reads are `local.get` + `struct.get`
// — free — so the guard needs no scratch.
function emitVariantNulFieldEq(
  al: i32,
  ar: i32,
  vi: i32,
  j: i32,
  ufi: i32,
  inner: VKind | null,
  fnIx: i32,
) {
  fbLocalGet(al)
  fbStructGet(variantHeap(vi), j)
  fbRefIsNull()
  fbIf(127)     // the left field was null
  fbLocalGet(ar)
  fbStructGet(variantHeap(vi), j)
  fbRefIsNull() // both null ⇒ equal
  fbElse()
  fbLocalGet(ar)
  fbStructGet(variantHeap(vi), j)
  fbRefIsNull()
  fbIf(127)
  fbI32Const(0) // exactly one side null
  fbElse()
  fbLocalGet(al)
  fbStructGet(variantHeap(vi), j)
  fbRefAsNonNull()
  fbLocalGet(ar)
  fbStructGet(variantHeap(vi), j)
  fbRefAsNonNull()
  if emitVariantFieldEqCoreAt(vi, ufi, fnIx, inner) < 0 { return -1 }
  fbEnd()
  fbEnd()
  return 0
}

function emitVariantFieldEqCore(vi: i32, ufi: i32, fnIx: i32) {
  return emitVariantFieldEqCoreAt(vi, ufi, fnIx, fieldRowKind(ufi))
}

// The same ladder keyed by an EXPLICIT code — what the null guard re-enters at the niche's
// non-null twin.
function emitVariantFieldEqCoreAt(
  vi: i32,
  ufi: i32,
  fnIx: i32,
  c: VKind | null,
) {
  if c == "nulnone" {
    // Both sides hold only `null`: drop the two reads, the field always agrees.
    fbDrop()
    fbDrop()
    fbI32Const(1)
    return 0
  }
  if c == "i32" || c == "nulbool" {
    fbI32Bin(70) // 0x46 i32.eq — and the two i32-sentinel niches, see the gate
    return 0
  }
  if c == "str" { return emitStrEqCore() }
  if eqKindIsRecord(c) { return emitNestedShapeEq(vi, ufi) }
  if c == "f64" {
    fbI32Bin(97) // 0x61 f64.eq
    return 0
  }
  if c == "i64" {
    fbI32Bin(81) // 0x51 i64.eq
    return 0
  }
  if c == "f32" {
    fbI32Bin(91) // 0x5b f32.eq
    return 0
  }
  // A function-valued field is compared by IDENTITY (id + env), the same core a standalone
  // struct's code-14 field takes.
  if c == "closure" { return emitCloEqCore() }
  if c == "reflist" {
    return emitListEqAnyRep(LBK_REF, variantRefListFieldSlot(ufi), fnIx)
  }
  if c == "union" {
    if ufi < 0 { return -1 }
    const vbArms: i32[] = []
    const vbVis: i32[] = []
    const vbAks: i32[] = []
    if !unionBoxEqColumns(sFieldElemTyIxOfRow(ufi), vbArms, vbVis, vbAks) {
      return -1
    }
    return emitUnionBoxEqStaged(vbArms, vbVis, vbAks, false, fnIx)
  }
  const lk = eqVariantListKind(c)
  if lk >= 0 {
    const vr = if lk == LBK_U8_LIST { variantFieldPackedRow(vi, ufi) } else { 0 }
    return emitListEqAnyRep(lk, vr, fnIx)
  }
  return emitFail("emitProgram: unsupported variant field type in equality")
}

// Compare two NESTED shape refs already on the stack, field-wise. Unlike the arms themselves,
// a nested shape HAS an interned struct row, so `emitStructEqRec` is available — it just needs
// its operands parked, which is what its `-2` / `-3` sentinels read.
function emitNestedShapeEq(vi: i32, ufi: i32) {
  const row = variantNestedRow(vi, ufi)
  if row < 0 { return -1 }
  const nl = structEqStashSlot(row)
  const nr = structEqStashSlot(row + 1024)
  fbLocalSet(nr)
  fbLocalSet(nl)
  const savedL = eqStashL
  const savedR = eqStashR
  eqStashL = nl
  eqStashR = nr
  const pathSi: i32[] = []
  const pathFi: i32[] = []
  const r = emitStructEqRec(-2, -3, row, pathSi, pathFi, fnIxOfNothing())
  eqStashL = savedL
  eqStashR = savedR
  return r
}

// `emitStructEqRec` takes a frame index only to resolve EXPRESSION operands; the stash-sentinel
// path never reaches that, so -1 is the honest argument rather than a borrowed frame.
function fnIxOfNothing(): i32 { return -1 }

const UNION_EQ_NAMELESS_MSG = "emitProgram: union `==`: an operand's type names no union it is boxed in"

// Union against union: equal iff the same arm (tag) holds and the unboxed payloads value-compare
// equal per that arm. Each operand is evaluated once into the staged core
// (`emitUnionBoxEqStagedX`), which compares over the left union's arms: tags are per atom, so a
// right-hand arm the left lacks fails the tag test.
function emitUnionUnionEq(lIx: i32, rIx: i32, isNe: boolean, fnIx: i32) {
  if unionEqNameless(lIx, fnIx) { emitFail(UNION_EQ_NAMELESS_MSG) }
  if unionEqNameless(rIx, fnIx) { emitFail(UNION_EQ_NAMELESS_MSG) }
  const nm = unionEqNamesOf(lIx, rIx, fnIx)
  if unionEqStructFirst(nm) {
    if emitStructUnionEq(lIx, rIx, isNe, nm.uenTy, fnIx) == 0 { return 0 }
  }
  if emitExpr(lIx, fnIx) < 0 { return -1 }
  if emitExpr(rIx, fnIx) < 0 { return -1 }
  return unionUnionEqTail(lIx, rIx, isNe, fnIx)
}

// After a union `==`'s two boxes, left below right: the staged compare (`emitUnionUnionEq`).
export function unionUnionEqTail(lIx: i32, rIx: i32, isNe: boolean, fnIx: i32) {
  const arms: i32[] = []
  const vis: i32[] = []
  const aks: i32[] = []
  const rKs: i32[] = []
  const why = unionEqStagedPlan(
    unionEqNamesOf(lIx, rIx, fnIx),
    rIx,
    fnIx,
    arms,
    vis,
    aks,
    rKs,
  )
  if why != "" { return emitFail(why) }
  return emitUnionBoxEqStagedX(arms, vis, aks, rKs, isNe, fnIx)
}

// Whether union set `usid`'s only number arm is `f64`.
function unionNumIsF64Only(usid: i32): boolean {
  return unionHasAtomK(usid, "f64", 4) && unionHasNoIntArm(usid)
}

// Whether union set `usid`'s only number arm is `f32`.
function unionNumIsF32Only(usid: i32): boolean {
  return unionHasAtomK(usid, "f32", 5)
    && !unionHasAtomK(usid, "f64", 4)
    && unionHasNoIntArm(usid)
}

function unionHasNoIntArm(usid: i32): boolean {
  return !unionHasAtomK(usid, "i32", 0) && !unionHasAtomK(usid, "i64", 3)
}

// `v is <literal>` over a still-boxed mixed-rep union (`"a" | "b" | 1` boxes as `string | i32`,
// same-rep literals sharing a tag): the tag selects the literal's rep arm, then the unboxed
// payload value-compares the literal. A literal whose rep has no arm is statically false,
// evaluating the receiver for effects. The same gated shape as `emitUnionConcreteEq`.
function emitUnionLitIs(objIx: i32, lit: string, fnIx: i32) {
  // D1060 — a non-re-readable receiver is stashed at its first read, not refused; the same move
  // `emitUnionConcreteEq` makes, with the same bound. The compare reads the box twice — the tag,
  // then the payload inside the tag-matched arm — which is the whole content of
  // `unionEqOperandOk`, so a call receiver or a path rooted at one would otherwise refuse.

  // Teed at the first read rather than pre-emitted at the top: the receiver must be evaluated
  // where the original code evaluated it, so any context the surrounding lowering seeded is still
  // in force, and so the static-false fold below still evaluates it exactly once.
  const isStash = unionLitIsStashSlot()
  const isOnce = !unionEqOperandOk(objIx)
  // D-VALUNION / D-SETONCE — see `emitUnionConcreteEq`.
  const usid = msSetOfUnionBox(objIx, fnIx)
  // D1047 — the empty-name reject stays ahead of the atom ladder. The ladder's i64-widening rung
  // and the mixed-union gate below both ask `unionHasAtomK`, whose fall-through fails loudly on
  // an unregistered row, and a receiver whose union has no name has no row at all. The message is
  // the condition's own; the branch is a floor, unreached by the tests and by the corpus.
  if usid < 0 {
    return emitFail(
      "emitProgram: literal `is` over a union with no recorded members",
    )
  }
  // The literal's rep atom: a quoted lexeme is a string, a float f64, an integer i32 — widening
  // to i64 when out of range or when the union's only integer arm is i64, the `emitUnionCoerce`
  // default. The ladder settles the ABI code alongside the spelling, and the map is a bijection
  // on its own image, so the code assigned is the code a parse of its output would return.
  let atom = "i32"
  let lak = 0
  // The quoted-leaf test at its home (`tyname.nameIsQuotedLeaf`). This site carries no bound of
  // its own: every caller passes a non-empty lexeme, a tested literal's or one set member's.
  if nameIsQuotedLeaf(lit) {
    atom = "string"
    lak = 2
  } else if !numLexIsFloat(lit) && unionNumIsF32Only(usid) {
    // A box whose only number is a float holds an integer by value there (D3689).
    atom = "f32"
    lak = 5
  } else if numLexIsFloat(lit) || unionNumIsF64Only(usid) {
    atom = "f64"
    lak = 4
  } else if !numLexFitsI32(lit) {
    atom = "i64"
    lak = 3
  } else if (!unionHasAtomK(usid, "i32", 0) && unionHasAtomK(usid, "i64", 3)) {
    atom = "i64"
    lak = 3
  }
  // A quoted literal has a rep arm whenever the box can carry it as a string ref — a plain
  // `string` arm or a literal-union arm, which is exactly `msSetTakesAtomAsStr`'s question.
  // Without its second leg a `K | f64` box statically answers `is "aa"` false: the member kinds
  // bank only `f64`, so the arm that holds the value looks absent. It is the gate's third disjunct.
  let litHasArm = unionHasAtomK(usid, atom, lak)
  if !litHasArm && lak == 2 && msSetTakesAtomAsStr(usid) { litHasArm = true }
  // A union carrying a literal-union alias arm (`K | string`, `K | f64`) is a box like any value
  // union — the arm rides it as its member string — but `isValueUnionName` declines it because
  // `valueAtomKind("K")` is -1. Same box, same tags, so the lowering below is unchanged; only the
  // gate has to know the second spelling.

  // D1047 — and the third disjunct, `litHasArm`, mirrors the `==` twin's `eqMixedOk`: a mixed
  // union is testable against a scalar literal over the same tag-then-payload shape. The compare
  // is arm-agnostic, so a struct or container arm simply has a tag that does not match. Widened
  // only where the literal's own rep has an arm, which the static-false fold below already trusts.
  if (
    msIsValueUnion(usid) != 1
    && msSetCarriesLitUnionArm(usid) != 1
    && !litHasArm
  ) {
    return emitFail(
      "emitProgram: literal `is` over a union with no arm of the literal's rep",
    )
  }
  if !litHasArm {
    if emitExpr(objIx, fnIx) < 0 { return -1 }
    fbDrop() // 0x1a drop
    fbI32Const(0)
    return 0
  }
  // `lak` decides the tag, the payload unbox and the three constant-emit arms below — one code,
  // five projections.
  if emitExpr(objIx, fnIx) < 0 { return -1 }
  if isOnce { fbLocalTee(isStash) }
  fbStructGet(uBoxIdx, 0) // 0xfb 0x02 <box ht> field 0: tag
  fbI32Rel(RS_TAG, scalarTagOfKind(lak))
  fbI32Bin(70)            // 0x46 i32.eq
  fbIf(127)               // 0x04 if, 0x7f i32 result blocktype
  if isOnce { fbLocalGet(isStash) }
  else if emitExpr(objIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
  if emitUnionPayloadUnbox(lak) < 0 { return -1 }
  if lak == 2 {
    // The literal lexeme rides a synthesized `StrLit` (same shape as `strText`).
    if emitStrEqLit(mkStr(lit, -1), fnIx) < 0 { return -1 }
  } else if lak == 4 {
    fbF64Const(lit)
    fbI32Bin(97) // 0x61 f64.eq
  } else if lak == 5 {
    fbF32Const(lit)
    fbI32Bin(91) // 0x5b f32.eq
  } else if lak == 3 {
    const pr = parseI64Pair(lit)
    fbI64Const(pr[0], pr[1])
    fbI32Bin(81) // 0x51 i64.eq
  } else {
    fbI32Const(parseI32(lit))
    fbI32Bin(70) // 0x46 i32.eq
  }
  fbElse() // wrong-rep arm — the literal can never match
  fbI32Const(0)
  fbEnd()  // 0x0b end
  return 0
}

// True if a variant field code has an `if (result …)` blocktype the shared-field dispatch can
// spell. The table's rationale is at the dispatch site in `emitMem`.
function sharedFieldCodeDispatchable(code: i32): boolean {
  if code == FC_I32 {
    return true // i32 / boolean — single valtype byte 0x7f
  }
  if code == FC_F64 {
    return true // f64 — 0x7c
  }
  if code == FC_I64 {
    return true // i64 — 0x7e
  }
  if code == FC_F32 {
    return true // f32 — 0x7d
  }
  if code == FC_STR {
    return true // string — the `(ref $sTypeIdx)` blocktype form
  }
  return false
}

// The kind a `?.` … `??` leaf carries through its `if`, from the field's numeric kind
// (`fieldRowNumKind`) and whether it is a non-null string: a plain `i32`, `i64`, `f64`, `f32` or
// `str`; null for a leaf with no `if` blocktype here. A string leaf is claimed earlier by
// `emitCoalesce`'s string-niche arm (D802), and a box leaf by `emitOptCoalesceBoxLeaf`.
function optLeafKindOf(numKind: i32, str: boolean): VKind | null {
  if numKind == 0 { return "i32" }
  if numKind == 3 { return "i64" }
  if numKind == 4 { return "f64" }
  if numKind == 5 { return "f32" }
  if str { return "str" }
  return null
}

// The `if` whose result is a `?.` … `??` leaf of kind `k` (an `optLeafKindOf` answer).
function fbIfForOptLeaf(k: VKind) {
  match k {
    "f64" => {
      return fbIf(124)
    }
    "i64" => {
      return fbIf(126)
    }
    "f32" => {
      return fbIf(125)
    }
    "str" => {
      return fbIfRef(sTy()) // string header ref
    }
    "i32" | "v128" | "struct" | "list" | "union" | "reflist" | "map" | "variant" | "nulvariant" | "nulstruct" | "closure" | "nulstr" | "nulbool" | "nulclosure" | "nulmap" | "nulnone" | "u8list" | "i64list" | "f32list" | "v128list" | "f64list" | "strlist" | "nullist" | "nulu8list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulf64list" | "nulstrlist" | "nulreflist" => {
      return fbIf(127) // i32 / boolean
    }
  }
}

// The default arm of a `?.` … `??` at a leaf of kind `k`: a wide numeric leaf widens the default
// to its own valtype, which the `if` blocktype names (`?? 1` against an `i64` leaf).
function emitOptLeafDefault(dIx: i32, k: VKind, fnIx: i32) {
  match k {
    "f64" => {
      return emitWidened(dIx, 4, fnIx)
    }
    "i64" => {
      return emitWidened(dIx, 3, fnIx)
    }
    "f32" => {
      return emitWidened(dIx, 5, fnIx)
    }
    "i32" | "v128" | "struct" | "list" | "str" | "union" | "reflist" | "map" | "variant" | "nulvariant" | "nulstruct" | "closure" | "nulstr" | "nulbool" | "nulclosure" | "nulmap" | "nulnone" | "u8list" | "i64list" | "f32list" | "v128list" | "f64list" | "strlist" | "nullist" | "nulu8list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulf64list" | "nulstrlist" | "nulreflist" => {
      return emitExpr(dIx, fnIx)
    }
  }
}

// Emit the `if` whose result is the shared field's rep. Only called for a code
// `sharedFieldCodeDispatchable` admitted, so it has no failure arm of its own.
function fbIfForSharedField(code: i32) {
  if code == FC_F64 {
    return fbIf(124) // f64
  }
  if code == FC_I64 {
    return fbIf(126) // i64
  }
  if code == FC_F32 {
    return fbIf(125) // f32
  }
  if code == FC_STR {
    return fbIfRef(sTy()) // string header ref
  }
  return fbIf(127) // i32 / boolean
}

// True when the shared-field dispatch can spell its `if` result for the plan `vis`/`fis`: a
// scalar or string code, or a reference field every member stores at ONE storage type — the
// same table `pushFieldStorage` writes into the type section, so the blocktype is that valtype.
// A value-union field must also box against one atom set, the box's tags being positional.
function sharedFieldPlanDispatchable(
  code: i32,
  vis: i32[],
  fis: i32[],
): boolean {
  if sharedFieldCodeDispatchable(code) { return true }
  // A `boolean | null` read is the niche's one `i32` (`sharedFieldNulBoolPlan`).
  if code == FC_NUL_BOOL { return true }
  // A `string | null` read is the nullable string ref (`sharedFieldNulStrPlan`).
  if code == FC_NUL_STR { return true }
  // A record-or-`null` read is the record's nullable ref (`sharedFieldNulStructPlan`).
  if code == FC_STRUCT && sharedFieldPlanHasNull(vis, fis) { return true }
  // An atom-set read with `null` is one `i32`, whether members store `null`, the set or the set
  // with `null` (`sharedFieldLitSetPlan`): atoms are interned program-wide, so every arm agrees.
  if code == FC_NUL_LIT_UNION { return true }
  if (
    code == FC_STR
    || code == FC_I32
    || code == FC_NUL_LIT_UNION
    || code == FC_NUL_BOOL
  ) {
    return false
  }
  if vis.length < 1 || fis.length != vis.length { return false }
  if sharedFieldAnyArmBoxes(code, vis, fis) {
    let b = 0
    while b < vis.length {
      if sharedFieldReadBoxes(code, vis[b], fis[b]) {
        const bk = sharedFieldArmAtomKind(vis[b], fis[b])
        if bk == 14 { return false }
        if atomKindNeedsValueBox(bk) && vbHeapIdxOfKind(bk) < 0 { return false }
      }
      b = b + 1
    }
    return true
  }
  const slot0 = uFieldStorageSlot(vis[0], fis[0])
  const elem0 = uFieldStart[vis[0]] + fis[0]
  let i = 1
  while i < vis.length {
    if uFieldStorageSlot(vis[i], fis[i]) != slot0 { return false }
    if (
      code == FC_UNION
      && !armFieldElemSame(elem0, uFieldStart[vis[i]] + fis[i])
      && !armFieldsBoxAlike(elem0, uFieldStart[vis[i]] + fis[i])
    ) {
      return false
    }
    i = i + 1
  }
  return true
}

// Whether arm-field slots `a` and `b` both store a value-union box. Box tags are global per atom
// kind and a literal rides its base scalar's tag, so either box is a box of the read's join.
function armFieldsBoxAlike(a: i32, b: i32): boolean {
  const tys = armFieldElemTyIx()
  if a < 0 || b < 0 || a >= tys.length || b >= tys.length { return false }
  const ta = fieldElemTyIn(tys, armFieldStoreTy(), a)
  const tb = fieldElemTyIn(tys, armFieldStoreTy(), b)
  return ta >= 0 && tb >= 0 && valueBoxOfTy(ta) && valueBoxOfTy(tb)
}

// Whether the plan `code` boxes member `vi0`'s field rather than reading it as stored: the
// members store the field at different value atoms (`sharedFieldArmsBoxable`), or this member
// stores a scalar where another stores the box (D4056).
function sharedFieldReadBoxes(code: i32, vi0: i32, fi0: i32): boolean {
  return code == FC_UNION && !fieldRowIsUnionBox(uFieldStart[vi0] + fi0)
}

// Whether any member of the plan boxes its field (`sharedFieldReadBoxes`), so the read
// delivers a box whose narrowed path, if any, unboxes.
function sharedFieldAnyArmBoxes(code: i32, vis: i32[], fis: i32[]): boolean {
  let i = 0
  while i < vis.length && i < fis.length {
    if sharedFieldReadBoxes(code, vis[i], fis[i]) { return true }
    i = i + 1
  }
  return false
}

// Whether value atom `k` is boxed in its own scalar value struct, rather than riding the box's
// `anyref` payload as the ref it already is.
function atomKindNeedsValueBox(k: i32): boolean {
  return k == 0 || k == 1 || k == 3 || k == 4 || k == 5
}

// The stash slot a nullable ref field `fi` of member `vi` is parked in while its null test picks
// the box tag, typed by the field's storage: a record, a string or a list.
function sharedFieldNulRefSlot(vi: i32, fi: i32): i32 {
  const row = uFieldStorageSlot(vi, fi)
  if variantFieldIsRecordRef(vi, fi) {
    return objOrderStashSlot("nulstruct", FC_STRUCT, row)
  }
  if variantFieldIsNulStr(vi, fi) {
    return objOrderStashSlot("nulstr", FC_NUL_STR, row)
  }
  return objOrderStashSlot(null, variantFieldTypeAt(vi, fi), row)
}

// One member's arm of the shared-field dispatch: the receiver box, cast to member `vi`, read at
// field `fi` — boxed under the field's atom tag when the plan boxes (`sharedFieldReadBoxes`).
function emitSharedFieldArm(
  code: i32,
  vi: i32,
  fi: i32,
  recvIx: i32,
  readIx: i32,
  fnIx: i32,
  slot: i32,
) {
  if vi < 0 || vi >= uVarRow.length {
    return emitFail("emitProgram: a shared field read names no member row")
  }
  // A `null` member of an atom-set read is the atom slot's `-1`.
  if code == FC_NUL_LIT_UNION && sharedFieldArmNull(vi, fi) {
    fbI32Const(0 - 1)
    return 0
  }
  // A `null` member of a `boolean | null` read is the niche's sentinel `2`.
  if code == FC_NUL_BOOL && sharedFieldArmNull(vi, fi) {
    fbI32Const(2)
    return 0
  }
  // A `null` member of a record-or-`null` read is the record's null ref.
  if code == FC_STRUCT && sharedFieldArmNull(vi, fi) {
    fbRefNullNone()
    return 0
  }
  // A read the checker narrowed past `null` never reaches a `null` member.
  if (code == FC_I32 || code == FC_STR) && sharedFieldArmNull(vi, fi) {
    fbUnreachable()
    return 0
  }
  const own = variantFieldTypeAt(vi, fi)
  if (
    (code == FC_NUL_STR && (own == FC_NUL_LIT_UNION || own == FC_I32))
    || (code == FC_STR && own == FC_NUL_LIT_UNION)
  ) {
    return emitSharedFieldSetToStr(code, own, vi, fi, recvIx, fnIx, slot)
  }
  const converts = sharedFieldArmConverts(code, vi, fi)
  let texts = sharedFieldArmLitTexts(vi, fi)
  if converts && code == FC_I32 {
    // A lone literal stored as its string reads as its one member's atom.
    if texts.length == 1 {
      fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[0])))
      return 0
    }
    // A member stored at the string whose row spells no literals narrows through the read's
    // own members.
    if texts.length == 0 { texts = tyLitMemberTexts(nodeTyIxOf(readIx)) }
    if texts.length == 0 {
      return emitFail(
        "emitProgram: literal-union atom narrowing with no members",
      )
    }
    if emitSharedFieldRecv(recvIx, fnIx, slot) < 0 { return -1 }
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    fbRefCast(variantHeap(vi))
    fbStructGet(variantHeap(vi), fi)
    const strSlot = objOrderStashSlot("str", FC_STR, uFieldStorageSlot(vi, fi))
    fbLocalSet(strSlot)
    const r = emitStagedStrToAtomChain(texts, 0, strSlot, fnIx)
    return r
  }
  const boxes = sharedFieldReadBoxes(code, vi, fi)
  if boxes && sharedFieldArmNull(vi, fi) {
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone()
    fbStructNew(uBoxIdx)
    return 0
  }
  const bk = sharedFieldArmAtomKind(vi, fi)
  if boxes && bk < 0 && sharedFieldArmNulSet(vi, fi) {
    return emitSharedFieldNulSetBox(vi, fi, recvIx, fnIx, slot)
  }
  // A string literal set stored at the atom boxes as the string it names (D14750).
  const setStr = boxes && bk < 0 && sharedFieldArmBoxesAtomSet(vi, fi)
  // A ref field rides the box as it is, under the tag the read's union gives its type.
  const rt = if readIx >= 0 { nodeTyAt(readIx, fnIx) } else { -1 }
  const refTag = if boxes && bk < 0 && !setStr { sharedFieldArmTag(vi, fi, rt) } else { -1 }
  const nulRef = refTag >= 0 && sharedFieldArmNullable(vi, fi)
  if refTag >= 0 && !nulRef {
    sharedArmBoxHead(vi, fi, readIx, fnIx)
  } else if nulRef {
    // The tag is chosen once the ref is read: a null ref boxes under the null tag (D16170).
  } else if setStr {
    fbI32Rel(RS_TAG, scalarTagOfKind(2))
  } else if boxes {
    sharedArmBoxHead(vi, fi, readIx, fnIx)
  }
  if emitSharedFieldRecv(recvIx, fnIx, slot) < 0 { return -1 }
  sharedArmPayloadRead(vi, fi)
  if setStr {
    if texts.length == 0 {
      return emitFail(
        "emitProgram: literal-union string boxing with no members",
      )
    }
    const setSlot = objOrderStashSlot("i32", FC_I32, uFieldStorageSlot(vi, fi))
    fbLocalSet(setSlot)
    if emitAtomToStrChain(texts, 0, setSlot) < 0 { return -1 }
    fbStructNew(uBoxIdx)
    return 0
  }
  if converts {
    // An atom set read at the string widens through its own members' tower.
    if texts.length == 0 {
      return emitFail(
        "emitProgram: literal-union string widening with no members",
      )
    }
    const idSlot = objOrderStashSlot("i32", FC_I32, uFieldStorageSlot(vi, fi))
    fbLocalSet(idSlot)
    return emitAtomToStrChain(texts, 0, idSlot)
  }
  if nulRef {
    const rSlot = sharedFieldNulRefSlot(vi, fi)
    fbLocalSet(rSlot)
    fbI32Rel(RS_TAG, nullBoxTag())
    fbI32Rel(RS_TAG, refTag)
    fbLocalGet(rSlot)
    fbRefIsNull()
    fbSelect()
    fbLocalGet(rSlot)
    fbStructNew(uBoxIdx)
    return 0
  }
  if boxes { sharedArmBoxTail(bk) }
  return sharedArmStrRecover(code, vi, fi)
}

// The tag a boxing arm (`sharedArmIsBox`) of member `vi`'s field `fi` boxes under: a ref field's
// own tag in read `readIx`'s union, else its scalar atom's.
function sharedArmBoxTagOf(vi: i32, fi: i32, readIx: i32, fnIx: i32): i32 {
  const bk = sharedFieldArmAtomKind(vi, fi)
  const rt = if readIx >= 0 { nodeTyAt(readIx, fnIx) } else { -1 }
  const refTag = if bk < 0 && !sharedFieldArmBoxesAtomSet(vi, fi) { sharedFieldArmTag(vi, fi, rt) } else { -1 }
  return if refTag >= 0 { refTag } else { scalarTagOfKind(bk) }
}

// Before the receiver: a boxing arm's tag.
export function sharedArmBoxHead(vi: i32, fi: i32, readIx: i32, fnIx: i32) {
  return fbI32Rel(RS_TAG, sharedArmBoxTagOf(vi, fi, readIx, fnIx))
}

// After the payload read: a boxing arm's value box, where its atom has one, and the union box.
export function sharedArmBoxTail(bk: i32) {
  if atomKindNeedsValueBox(bk) { fbStructNew(vbHeapIdxOfKind(bk)) }
  return fbStructNew(uBoxIdx)
}

// Whether `emitSharedFieldArm` writes member `vi`'s arm of plan `code` as a box over the plain
// read alone: a scalar atom or a non-null ref, no `null` member, no atom set, no conversion.
export function sharedArmIsBox(
  code: i32,
  vi: i32,
  fi: i32,
  readIx: i32,
  fnIx: i32,
): boolean {
  if vi < 0 || vi >= uVarRow.length || !sharedFieldReadBoxes(code, vi, fi) {
    return false
  }
  if sharedFieldArmNull(vi, fi) || sharedFieldArmConverts(code, vi, fi) {
    return false
  }
  const own = variantFieldTypeAt(vi, fi)
  if code == FC_NUL_STR && (own == FC_NUL_LIT_UNION || own == FC_I32) {
    return false
  }
  if code == FC_STR && own == FC_NUL_LIT_UNION { return false }
  const bk = sharedFieldArmAtomKind(vi, fi)
  if bk >= 0 { return true }
  if sharedFieldArmNulSet(vi, fi) || sharedFieldArmBoxesAtomSet(vi, fi) {
    return false
  }
  const rt = if readIx >= 0 { nodeTyAt(readIx, fnIx) } else { -1 }
  return sharedFieldArmTag(vi, fi, rt) >= 0 && !sharedFieldArmNullable(vi, fi)
}

// After the receiver box: its payload cast to member `vi`, read at field `fi`.
function sharedArmPayloadRead(vi: i32, fi: i32) {
  fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
  fbRefCast(variantHeap(vi))
  fbStructGet(variantHeap(vi), fi)
}

// A `string | null` member read where a narrowing excluded `null` holds a string.
function sharedArmStrRecover(code: i32, vi: i32, fi: i32): i32 {
  if code == FC_STR && fieldRowIsStr(uFieldStart[vi] + fi, true) {
    fbRefAsNonNull()
  }
  return 0
}

// Whether `emitSharedFieldArm` writes member `vi`'s arm of plan `code` as the plain read alone:
// no `null` member, no atom or string conversion, no box.
export function sharedArmIsPlain(code: i32, vi: i32, fi: i32): boolean {
  if vi < 0 || vi >= uVarRow.length || sharedFieldArmNull(vi, fi) {
    return false
  }
  const own = variantFieldTypeAt(vi, fi)
  if code == FC_NUL_STR && (own == FC_NUL_LIT_UNION || own == FC_I32) {
    return false
  }
  if code == FC_STR && own == FC_NUL_LIT_UNION { return false }
  return !sharedFieldArmConverts(code, vi, fi)
    && !sharedFieldReadBoxes(code, vi, fi)
}

// After the receiver box: a plain arm of plan `code` for member `vi`, field `fi`.
export function sharedArmPlainTail(code: i32, vi: i32, fi: i32): i32 {
  sharedArmPayloadRead(vi, fi)
  return sharedArmStrRecover(code, vi, fi)
}

// After the receiver box: arm `i`'s tag test of plan `code` over members `vis`, then the open of
// the `if` whose result is the field's rep.
export function sharedArmTestTail(code: i32, vis: i32[], fis: i32[], i: i32) {
  fbStructGet(uBoxIdx, 0) // field 0: tag
  fbI32Rel(RS_TAG, uTags[vis[i]])
  fbI32Bin(70) // 0x46 i32.eq
  const a = sharedFieldValueArm(vis, fis)
  return fbIfForSharedPlan(code, vis[a], fis[a])
}

// The plan `emitMemSharedRead` dispatches member read `memIx` on, its members into `vis` and their
// fields into `fis`, or -1 where it reads the plain struct instead.
export function sharedReadPlanOf(
  memIx: i32,
  fnIx: i32,
  vis: i32[],
  fis: i32[],
): i32 {
  const m = nodeAt(memIx)
  if !(m is Member) { return -1 }
  const code = sharedUnionFieldPlan(m.memObj, m.memProp, memIx, fnIx, vis, fis)
  return if code >= 0 && sharedFieldPlanDispatchable(code, vis, fis) { code } else { -1 }
}

// The tail after read `memIx`'s dispatch of plan `code`: the atom kind it unboxes to (a read the
// checker typed as one atom, of a plan that boxes or whose every arm stores the box), the narrow
// unbox (`SRT_NARROW`), the `string | null` recover (`SRT_NULSTR`), or nothing (`SRT_NONE`).
export function sharedReadTailOf(
  code: i32,
  vis: i32[],
  fis: i32[],
  memIx: i32,
  fnIx: i32,
): i32 {
  if code == FC_UNION {
    const k = pathReadAtomKind(memIx, fnIx)
    if k >= 0 { return k }
  }
  if sharedFieldAnyArmBoxes(code, vis, fis) {
    const ak = memReadCheckerAtomKind(memIx, fnIx)
    if ak >= 0 { return ak }
    return if unionFieldNarrowUnboxOf(memIx, fnIx) == "none" { SRT_NONE } else { SRT_NARROW }
  }
  if code == FC_NUL_STR && nulStrReadRecovers(memIx, fnIx) { return SRT_NULSTR }
  return SRT_NONE
}

export const SRT_NONE = -1
export const SRT_NULSTR = -2
export const SRT_NARROW = -3

// After the dispatch: the tail `sharedReadTailOf` names, leaf bytes of `memIx` alone.
export function sharedReadTail(
  code: i32,
  vis: i32[],
  fis: i32[],
  memIx: i32,
  fnIx: i32,
): i32 {
  const t = sharedReadTailOf(code, vis, fis, memIx, fnIx)
  if t >= 0 { return emitUnionUnboxTail(t) }
  if t == SRT_NARROW { return emitUnionFieldNarrowUnbox(memIx, fnIx) }
  if t == SRT_NULSTR { fbRefAsNonNull() }
  return 0
}

// After the receiver box: a boxing arm's payload read and its box.
export function sharedArmBoxBody(vi: i32, fi: i32) {
  sharedArmPayloadRead(vi, fi)
  return sharedArmBoxTail(sharedFieldArmAtomKind(vi, fi))
}

// Whether `emitMemSharedRead` evaluates read `memIx`'s receiver once into its stash slot: anything
// but an ident, whose `local.get` re-emits per arm for nothing.
export function sharedReadStashes(memIx: i32): boolean {
  const m = nodeAt(memIx)
  if !(m is Member) { return false }
  const r = unwrapParen(m.memObj)
  return !(r >= 0 && r < P.nodes.length && nodeAt(r) is Ident)
}

// Whether `emitMemSharedRead` writes read `memIx` as the dispatch the IR writes: every arm the plain
// read or its box, the receiver re-read per arm or stashed, then `sharedReadTail`.
export function sharedReadPlainOf(memIx: i32, fnIx: i32): boolean {
  if memReadArmOf(memIx, fnIx) != "shared" { return false }
  const vis: i32[] = []
  const fis: i32[] = []
  const code = sharedReadPlanOf(memIx, fnIx, vis, fis)
  if code < 0 || vis.length < 1 || fis.length != vis.length { return false }
  let i = 0
  while i < vis.length {
    if (
      !sharedArmIsPlain(code, vis[i], fis[i])
      && !sharedArmIsBox(code, vis[i], fis[i], memIx, fnIx)
    ) {
      return false
    }
    i = i + 1
  }
  return true
}

// A string literal set stored at the atom (`own`, `FC_I32` or its `-1` niche) read as the
// string or `string | null` the shared read is typed as (`code`): the atom widens through its
// members, the niche's `-1` is `null`, unreachable under a read narrowed past it.
function emitSharedFieldSetToStr(
  code: i32,
  own: i32,
  vi: i32,
  fi: i32,
  recvIx: i32,
  fnIx: i32,
  slot: i32,
) {
  const texts = sharedFieldArmSetTexts(vi, fi)
  if texts.length == 0 {
    return emitFail(
      "emitProgram: a shared field read widens a literal set with no members",
    )
  }
  if emitSharedFieldRecv(recvIx, fnIx, slot) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
  fbRefCast(variantHeap(vi))
  fbStructGet(variantHeap(vi), fi)
  const idSlot = objOrderStashSlot("i32", FC_I32, uFieldStorageSlot(vi, fi))
  fbLocalSet(idSlot)
  if own != FC_NUL_LIT_UNION { return emitAtomToStrChain(texts, 0, idSlot) }
  fbLocalGet(idSlot)
  fbI32Const(0 - 1)
  fbI32Bin(70) // 0x46 i32.eq — the niche's `null`
  fbIfRefNul(sTy(), code == FC_NUL_STR)
  if code == FC_NUL_STR { fbRefNullNone() } else { fbUnreachable() }
  fbElse()
  if emitAtomToStrChain(texts, 0, idSlot) < 0 { return -1 }
  fbEnd()
  return 0
}

// A string literal set beside `null` stored at the atom niche, boxed for a read whose join
// holds other atoms: the niche's `-1` is the null-tagged box, any other atom its string's box.
function emitSharedFieldNulSetBox(
  vi: i32,
  fi: i32,
  recvIx: i32,
  fnIx: i32,
  slot: i32,
) {
  const texts = sharedFieldArmSetTexts(vi, fi)
  if texts.length == 0 {
    return emitFail(
      "emitProgram: a shared field read boxes a literal set with no members",
    )
  }
  if emitSharedFieldRecv(recvIx, fnIx, slot) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
  fbRefCast(variantHeap(vi))
  fbStructGet(variantHeap(vi), fi)
  const idSlot = objOrderStashSlot("i32", FC_I32, uFieldStorageSlot(vi, fi))
  fbLocalSet(idSlot)
  fbLocalGet(idSlot)
  fbI32Const(0 - 1)
  fbI32Bin(70) // 0x46 i32.eq — the niche's `null`
  fbIfRefNul(uBoxIdx, false)
  fbI32Rel(RS_TAG, nullBoxTag())
  fbRefNullNone()
  fbStructNew(uBoxIdx)
  fbElse()
  fbI32Rel(RS_TAG, scalarTagOfKind(2))
  if emitAtomToStrChain(texts, 0, idSlot) < 0 { return -1 }
  fbStructNew(uBoxIdx)
  fbEnd()
  return 0
}

// How `emitSharedFieldAssign` writes a shared field with plan `code` over members `vis`/`fis`: 0
// not at all (no dispatchable plan, or members storing it at different types), 1 per arm (a
// boxed or literal-union arm stores at its own atoms, D5158), 2 through one slot.
function sharedFieldAssignPlanOf(code: i32, vis: i32[], fis: i32[]): i32 {
  if code < 0 || !sharedFieldPlanDispatchable(code, vis, fis) { return 0 }
  if (
    sharedFieldAnyArmBoxes(code, vis, fis)
    || sharedFieldAnyArmLitUnion(vis, fis)
  ) {
    return 1
  }
  return if sharedFieldTysIdentical(vis, fis) { 2 } else { 0 }
}

// Whether `emitSharedFieldAssign` writes the field target `memIx`.
function sharedFieldAssignTaken(memIx: i32, fnIx: i32): boolean {
  const m = nodeAt(memIx)
  if !(m is Member) { return false }
  const vis: i32[] = []
  const fis: i32[] = []
  const code = sharedUnionFieldPlan(m.memObj, m.memProp, memIx, fnIx, vis, fis)
  return sharedFieldAssignPlanOf(code, vis, fis) != 0
}

// A field write through an un-narrowed struct union (`(A | B).n = v`): the value is evaluated
// once into a slot of the field's storage type, then each member's arm stores it at that
// member's own index. 1 when lowered, 0 when the write is not such a read's twin (the members
// must store the field at one rep), -1 on failure.
function emitSharedFieldAssign(memIx: i32, valIx: i32, fnIx: i32) {
  const m = nodeAt(memIx)
  if m is Member {
    const vis: i32[] = []
    const fis: i32[] = []
    const code = sharedUnionFieldPlan(
      m.memObj,
      m.memProp,
      memIx,
      fnIx,
      vis,
      fis,
    )
    const plan = sharedFieldAssignPlanOf(code, vis, fis)
    if plan == 0 { return 0 }
    if plan == 1 {
      return emitSharedFieldAssignPerArm(m.memObj, valIx, fnIx, vis, fis)
    }
    let rslot = -1
    if !(nodeAt(unwrapParen(m.memObj)) is Ident) {
      rslot = sharedFieldRecvSlot()
      if emitExpr(m.memObj, fnIx) < 0 { return -1 }
      fbLocalSet(rslot)
    }
    const sfVal = emitScalarFieldStoreVal(
      valIx,
      fnIx,
      eqRowFieldKind(-1 - vis[0], fis[0]),
    )
    if sfVal < 0 { return -1 }
    const vslot = objOrderStashSlot(
      variantFieldStorageKind(vis[0], fis[0]),
      code,
      uFieldStorageSlot(vis[0], fis[0]),
    )
    fbLocalSet(vslot)
    let i = 0
    while i < vis.length {
      const last = i == vis.length - 1
      if !last {
        if emitSharedFieldRecv(m.memObj, fnIx, rslot) < 0 { return -1 }
        fbStructGet(uBoxIdx, 0) // field 0: tag
        fbI32Rel(RS_TAG, uTags[vis[i]])
        fbI32Bin(70)            // 0x46 i32.eq
        fbIf(64)                // 0x40 void
      }
      if emitSharedFieldRecv(m.memObj, fnIx, rslot) < 0 { return -1 }
      fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
      fbRefCast(variantHeap(vis[i]))
      fbLocalGet(vslot)
      fbStructSet(variantHeap(vis[i]), fis[i])
      if !last { fbElse() }
      i = i + 1
    }
    let e = 0
    while e < vis.length - 1 {
      fbEnd()
      e = e + 1
    }
    return 1
  }
  return 0
}

// `emitSharedFieldAssign` over members storing the field at different reps: the receiver is
// stashed once, then each tag's arm lowers the value at its own member's field type. Exactly
// one arm runs, so the value is still evaluated once, after the receiver. 1 lowered, -1 failed.
function emitSharedFieldAssignPerArm(
  recvIx: i32,
  valIx: i32,
  fnIx: i32,
  vis: i32[],
  fis: i32[],
) {
  const rslot = sharedFieldRecvSlot()
  if emitExpr(recvIx, fnIx) < 0 { return -1 }
  fbLocalSet(rslot)
  let i = 0
  while i < vis.length {
    const last = i == vis.length - 1
    if !last {
      if emitSharedFieldRecv(recvIx, fnIx, rslot) < 0 { return -1 }
      fbStructGet(uBoxIdx, 0) // field 0: tag
      fbI32Rel(RS_TAG, uTags[vis[i]])
      fbI32Bin(70)            // 0x46 i32.eq
      fbIf(64)                // 0x40 void
    }
    if emitSharedFieldRecv(recvIx, fnIx, rslot) < 0 { return -1 }
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    fbRefCast(variantHeap(vis[i]))
    if emitVariantFieldValue(vis[i], fis[i], valIx, fnIx) < 0 { return -1 }
    fbStructSet(variantHeap(vis[i]), fis[i])
    if !last { fbElse() }
    i = i + 1
  }
  let e = 0
  while e < vis.length - 1 {
    fbEnd()
    e = e + 1
  }
  return 1
}

// Whether some member stores the field as a literal union or a literal-union list.
function sharedFieldAnyArmLitUnion(vis: i32[], fis: i32[]): boolean {
  let i = 0
  while i < vis.length && i < fis.length {
    if variantFieldIsLitUnion(vis[i], fis[i]) { return true }
    if variantFieldIsLitUnionArray(vis[i], fis[i]) { return true }
    i = i + 1
  }
  return false
}

// Whether every member declares the field at one type, with no literal set among them — the
// only case a store through the union is the same store into each member.
function sharedFieldTysIdentical(vis: i32[], fis: i32[]): boolean {
  if vis.length < 1 || fis.length != vis.length { return false }
  const at0 = uFieldStart[vis[0]] + fis[0]
  let i = 0
  while i < vis.length {
    const at = uFieldStart[vis[i]] + fis[i]
    if at < 0 || at >= sFieldNames.length || at >= sFieldLitTyIx.length {
      return false
    }
    if at0 < 0 || at0 >= sFieldNames.length { return false }
    if (
      !variantRowFieldTysSame(at, at0)
      || fieldLitTyIn(sFieldLitTyIx, sFieldStoreTy, at, "wasmEmit:12695") >= 0
    ) {
      return false
    }
    if variantFieldIsLitUnion(vis[i], fis[i]) { return false }
    if variantFieldIsLitUnionArray(vis[i], fis[i]) { return false }
    i = i + 1
  }
  return true
}

// `fbIfForSharedField` for a plan `sharedFieldPlanDispatchable` admitted: a reference field's
// blocktype is its member's storage valtype, written by `pushFieldStorage`.
function fbIfForSharedPlan(code: i32, vi: i32, fi: i32) {
  // A value arm stored at the atom still delivers the nullable string ref the read is typed as.
  const own = variantFieldTypeAt(vi, fi)
  if code == FC_NUL_STR && (own == FC_NUL_LIT_UNION || own == FC_I32) {
    return fbIfRefNul(sTy(), true)
  }
  if (
    sharedFieldCodeDispatchable(code)
    || code == FC_NUL_LIT_UNION
    || code == FC_NUL_BOOL
  ) {
    return fbIfForSharedField(code)
  }
  fbOpenIf()
  return pushFieldStorage(code, uFieldStorageSlot(vi, fi))
}

// Push the shared-field dispatch's receiver box: the value stashed in `slot` when the receiver
// is evaluated once (`slot >= 0`), else a fresh emission of the place — an ident, effect-free.
// One function so the tag test and the payload read cannot pick different halves.
function emitSharedFieldRecv(recvIx: i32, fnIx: i32, slot: i32) {
  if slot >= 0 { return sharedRecvSlotGet(slot) }
  return emitExpr(recvIx, fnIx)
}

// The stashed receiver box out of `slot`. The lazy frame's ref slots are nullable (they must be
// defaultable) and `struct.get` takes a non-null ref; the value stored is the receiver's own box,
// and the checker refuses a shared read through a nullable receiver, so the recover cannot trap.
export function sharedRecvSlotGet(slot: i32) {
  fbLocalGet(slot)
  return fbRefAsNonNull() // 0xd4
}

// The one home for "a code-16 value-union-box field read whose member path is narrowed to a
// single scalar atom unboxes to that atom's rep". The receiver's own shape decides which
// `struct.get` produced the box — the plain struct table, the arm's `variantHeap` row, or the
// nullable form of the same — but the unbox after it is one sequence.

// What `emitUnionFieldNarrowUnbox` writes for read `memIx`: a container narrow's cast,
// the checker-typed atom's unbox (a litunion-alias narrow unboxes as the stored string ref), the
// unbox to the atom an un-narrowed read is typed as (D209), or nothing (the box unchanged).
export type NarrowUnboxArm = "container" | "atom" | "unbox" | "none"

export function unionFieldNarrowUnboxOf(memIx: i32, fnIx: i32): NarrowUnboxArm {
  const con = placeReadContainerAt(memIx, fnIx)
  if con == RC_REF_LIST || con == RC_MAP { return "container" }
  if memNarrowAtomKind(memIx, fnIx) >= 0 { return "atom" }
  return if memReadUnboxAtomKind(memIx, fnIx) >= 0 { "unbox" } else { "none" }
}

function emitUnionFieldNarrowUnbox(memIx: i32, fnIx: i32) {
  return match unionFieldNarrowUnboxOf(memIx, fnIx) {
    "container" => emitPlaceNarrowContainerUnbox(memIx, fnIx) - 1
    // The narrowed atom's ABI code decides both arms, as at the variant-field twin of this read
    // (`emitNarrowedMem`).
    "atom" => emitUnionUnboxTail(memNarrowAtomKind(memIx, fnIx))
    "unbox" => emitUnionFieldStoredUnbox(memIx, fnIx)
    "none" => 0
  }
}

// The un-narrowed read the checker typed as a bare atom, its payload cast to what the store put
// there and narrowed back (a declared `i64 | null` member widens `7` into `$vbI64`); a `??`-merged
// box holding two dispatches on its tag, only where every arm reaches the read's atom.
function emitUnionFieldStoredUnbox(memIx: i32, fnIx: i32) {
  const ck = memReadUnboxAtomKind(memIx, fnIx)
  const bk = memReadBoxedAtomKind(memIx, fnIx)
  const bks: i32[] = []
  if memReadBoxedAtomKinds(memIx, fnIx, bks) {
    if bks.length > 1 && atomKindsAllConvertible(bks, ck) {
      return emitUnionFieldTagDispatch(bks, ck)
    }
  }
  if emitUnionUnboxTail(bk) < 0 { return -1 }
  return emitNarrowStoredAtomKind(bk, ck)
}

// D927 — the tag-dispatched unbox: one arm per atom the box can hold, each converted to the
// checker's atom `ck`, in `splitUnionAtoms` order with the last arm as the unconditional
// fall-through. The box is on the stack when this is entered, so it is stashed once — each arm
// reads it twice, and re-emitting a receiver per arm is what `sharedFieldRecvSlot` exists for.
function emitUnionFieldTagDispatch(kinds: i32[], ck: i32) {
  const slot = sharedFieldRecvSlot()
  fbLocalSet(slot)
  let i = 0
  while i < kinds.length - 1 {
    fbLocalGet(slot)
    fbStructGet(uBoxIdx, 0) // field 0: tag
    fbI32Rel(RS_TAG, scalarTagOfKind(kinds[i]))
    fbI32Bin(70) // 0x46 i32.eq
    fbIfForAtomKind(ck)
    fbLocalGet(slot)
    if emitUnionUnboxTail(kinds[i]) < 0 { return -1 }
    if emitConvertAtomKind(kinds[i], ck) < 0 { return -1 }
    fbElse()
    i = i + 1
  }
  fbLocalGet(slot)
  if emitUnionUnboxTail(kinds[kinds.length - 1]) < 0 { return -1 }
  if emitConvertAtomKind(kinds[kinds.length - 1], ck) < 0 { return -1 }
  let e = 0
  while e < kinds.length - 1 {
    fbEnd()
    e = e + 1
  }
  return 0
}

// D927 — the `if` blocktype for a value-atom kind, the atom-side twin of `fbIfForSharedField`'s
// field-code one. Two spellers rather than one because the two callers hold two vocabularies — a
// field code there, a `valueAtomKind` here — and deriving one from the other is what lets a
// spelling compare stand in for a code.
function fbIfForAtomKind(k: i32) {
  if k == 2 {
    return fbIfRef(sTy()) // string header ref
  }
  if k == 3 {
    return fbIf(126) // i64
  }
  if k == 4 {
    return fbIf(124) // f64
  }
  if k == 5 {
    return fbIf(125) // f32
  }
  return fbIf(127) // i32 / boolean
}

// D927 — can a payload boxed at `from` be delivered at `to`? The predicate half of
// `emitConvertAtomKind`, asked before any byte is written so the dispatch can stand down whole
// rather than fail in the middle of an arm. `emitNarrowStoredAtomKind`'s four narrowings and
// their five widening inverses; a string or boolean arm converts to nothing but itself.
function atomKindConvertible(from: i32, to: i32): boolean {
  if from == to { return true }
  if from == 0 { return to == 3 || to == 4 || to == 5 }
  if from == 3 { return to == 0 || to == 4 }
  if from == 4 { return to == 0 }
  if from == 5 { return to == 0 || to == 4 }
  return false
}

// D927 — every arm of the box, or the dispatch does not run.
function atomKindsAllConvertible(kinds: i32[], to: i32): boolean {
  let i = 0
  while i < kinds.length {
    if !atomKindConvertible(kinds[i], to) { return false }
    i = i + 1
  }
  return true
}

// D927 — the conversion itself. The NARROWING half is `emitNarrowStoredAtomKind`'s, reached
// through it so the two cannot drift; the WIDENING half is the direction that function refuses
// by design, because until a box held two atoms nothing ever needed it.
function emitConvertAtomKind(from: i32, to: i32) {
  if from == to { return 0 }
  if from == 0 {
    if to == 3 {
      fbI64ExtendI32S()
      return 0
    }
    if to == 4 {
      fbF64ConvertI32S()
      return 0
    }
    if to == 5 {
      fbF32ConvertI32S()
      return 0
    }
  }
  if from == 3 && to == 4 {
    fbF64ConvertI64S()
    return 0
  }
  return emitNarrowStoredAtomKind(from, to)
}

// D291 — the inverse of the store's widening: a payload boxed at kind `from` because the union's
// arm is wider, delivered at the kind `to` the checker typed the read's consumers against, and
// nothing at all when the two agree. The four conversions are exactly the four promotions
// `unionStoreAtomKind` performs, each exact; any other pair is a loud reject rather than a guess.
function emitNarrowStoredAtomKind(from: i32, to: i32) {
  if from == to { return 0 }
  if to == 0 {
    if from == 3 {
      fbI32WrapI64()
      return 0
    }
    if from == 4 {
      fbI32TruncF64S()
      return 0
    }
    if from == 5 {
      fbI32TruncF32S()
      return 0
    }
  }
  if to == 4 && from == 5 {
    fbF64PromoteF32()
    return 0
  }
  return emitFail(
    "emitProgram: union field read stored at an atom the checker's atom cannot be recovered from",
  )
}

// The message for one of `emitMem`'s three field-access floors — `dflt` prefixed, except for a
// `.length` read, which gets its own. `.length` reaches a floor only through a type parameter:
// every rep that has a length is answered by a classifier above, and a declared struct with a
// `length` field by the struct read these floors guard.

// It is a message swap at the floor and not a guard above it, and the order is the point: the
// same arm at the head of the block takes `Buf.length` with it. Only the corpus `cmp` sees that
// difference — grid, grade columns and histogram are unmoved.
function memFloorMsg(memIx: i32, dflt: string): string {
  const m = nodeAt(memIx)
  if m is Member {
    if m.memProp == "length" {
      return "emitProgram: '.length' on a receiver the emitter cannot classify as a list, string, map or set"
    }
  }
  return "emitProgram: " + dflt
}

// A member read, by the arm `memReadArmOf` names: a narrowed box, a bare or nullable variant
// receiver, or the shared-field dispatch over the struct read.
function emitMem(memIx: i32, fnIx: i32) {
  return match memReadArmOf(memIx, fnIx) {
    "narrowed" => emitNarrowedMem(memIx, fnIx)
    "variant" => emitMemVariantRead(memIx, fnIx)
    "nulVariant" => emitMemNulVariantRead(memIx, fnIx)
    "shared" => emitMemSharedRead(memIx, fnIx)
  }
}

// `emitMem`'s read of a field off a bare VARIANT receiver, the unboxed variant ref itself: the
// receiver, then `struct.get` at the variant's field. Returns 0, or -1 failed.
function emitMemVariantRead(memIx: i32, fnIx: i32): i32 {
  const m0 = nodeAt(memIx)
  if !(m0 is Member) { return emitFail("emitProgram: expected a member read") }
  const pvi = exprVariantIndex(m0.memObj, fnIx)
  const pvfi = variantFieldIndex(pvi, m0.memProp)
  if pvfi < 0 {
    return emitFail("emitProgram: unknown variant field in field access")
  }
  if emitExpr(m0.memObj, fnIx) < 0 { return -1 }
  variantFieldTail(pvi, pvfi, memIx, fnIx)
  // A code-16 (value-union box) field of the arm, read while its member path is narrowed,
  // unboxes to the narrowed atom, the arm-for-arm twin of the plain struct read (D219).
  return variantUnionBoxTail(pvi, pvfi, memIx, fnIx)
}

// The nullable form of the same read (`c: Circle | null`, inside its `!= null` branch): one
// `ref.as_non_null` ahead of the `struct.get`, which cannot trap where the checker admits the
// read, as only a null test reaches it. Returns 0, or -1 failed.
function emitMemNulVariantRead(memIx: i32, fnIx: i32): i32 {
  const m0 = nodeAt(memIx)
  if !(m0 is Member) { return emitFail("emitProgram: expected a member read") }
  const nvi = nulVariantIdxOfExpr(m0.memObj, fnIx)
  if nvi < 0 || nvi >= uFieldStart.length {
    return emitFail("emitProgram: expected a nullable variant receiver")
  }
  const nvfi = variantFieldIndex(nvi, m0.memProp)
  if nvfi < 0 {
    return emitFail("emitProgram: unknown variant field in field access")
  }
  if emitExpr(m0.memObj, fnIx) < 0 { return -1 }
  fbRefAsNonNull() // 0xd4 — the enclosing null test narrowed it
  fbStructGet(variantHeap(nvi), nvfi)
  emitNulStrFieldRecover(uFieldStart[nvi] + nvfi, memIx, fnIx)
  if fieldRowIsUnionBox(uFieldStart[nvi] + nvfi) {
    if emitUnionFieldNarrowUnbox(memIx, fnIx) < 0 { return -1 }
  }
  return 0
}

// `emitMem`'s shared-field read over a struct union, dispatched on the box tag; a plan that
// is not dispatchable falls through to the plain struct read. Returns 0, or -1 failed.
function emitMemSharedRead(memIx: i32, fnIx: i32): i32 {
  // The shared-field dispatch's result rep. The dispatch below is a chain of `if (result …)`
  // blocks, one per box tag, so the field's rep has to be spellable as a blocktype. Pinned to i32
  // it would make `(A | B).tag` readable for an i32 or boolean field and a loud floor for an
  // `f64`, `i64`, `f32` or `string` one.

  // The three remaining scalars are their own single valtype byte. String needs the other form,
  // `fbIfRef`, since a `(ref $sTypeIdx)` result is not a valtype byte, and it is the code that
  // matters most: a discriminated union's tag is a string field. The predicate and the emitter are
  // two functions over one table because the validation loop must decline before any bytes.

  // Shared-field access over an un-narrowed struct union (`(A | B).tag`): the checker proved the
  // field present on every member, but members may store it at different indices, so dispatch on
  // the box tag and read the field at that member's own index. The arms are exhaustive, the last
  // member being the unconditional fall-through. A narrowed set dispatches over its survivors.
  const mS = nodeAt(memIx)
  if mS is Member {
    // The plan is shared. `sharedUnionFieldPlan` owns the receiver test, the narrowed-set member
    // resolution and the per-member field lookup — the same derivation both classifier twins
    // read, so what this lowers and what `print` dispatches cannot disagree. Dispatchability
    // stays here, being a question about spelling a blocktype rather than about typing a read.
    const shVis: i32[] = []
    const shFis: i32[] = []
    const shCode = sharedReadPlanOf(memIx, fnIx, shVis, shFis)
    if shCode >= 0 {
      // The receiver is evaluated once unless re-emitting it is free. The arms below read it
      // twice each — the tag test, then the payload cast — which is why an ident receiver, whose
      // `local.get` re-emits for nothing, needs no slot. A call does not: `g(true).v` would call
      // `g` 2N-1 times, and that restriction is why this family floors.

      // The stash slot is handed out here, during lowering (`sharedFieldRecvSlot`, the lazy list
      // frame), not reserved by a pre-pass: a pre-pass runs before any `is`-narrowing is active
      // and this question consults narrowing, so the two answers differ in both directions. An
      // ident receiver takes no slot and re-emits, so existing programs emit the same bytes.
      let shSlot = -1
      if sharedReadStashes(memIx) {
        shSlot = sharedFieldRecvSlot()
        if emitExpr(mS.memObj, fnIx) < 0 { return -1 }
        fbLocalSet(shSlot)
      }
      let si2 = 0
      while si2 < shVis.length - 1 {
        if emitSharedFieldRecv(mS.memObj, fnIx, shSlot) < 0 { return -1 }
        sharedArmTestTail(shCode, shVis, shFis, si2)
        const shArm = emitSharedFieldArm(
          shCode,
          shVis[si2],
          shFis[si2],
          mS.memObj,
          memIx,
          fnIx,
          shSlot,
        )
        if shArm < 0 { return -1 }
        fbElse()
        si2 = si2 + 1
      }
      const shLast = shVis.length - 1
      const shLastArm = emitSharedFieldArm(
        shCode,
        shVis[shLast],
        shFis[shLast],
        mS.memObj,
        memIx,
        fnIx,
        shSlot,
      )
      if shLastArm < 0 { return -1 }
      let se = 0
      while se < shVis.length - 1 {
        fbEnd()
        se = se + 1
      }
      return sharedReadTail(shCode, shVis, shFis, memIx, fnIx)
    }
  }
  return emitMemStructRead(memIx, fnIx)
}

// `emitMem`'s plain struct field read, with its null, string-niche and union-box recoveries,
// or the node-anchored floor naming why the receiver is not a struct. Returns 0, or -1 failed.
function emitMemStructRead(memIx: i32, fnIx: i32): i32 {
  // The three field-access floors are node-anchored (`emitFailAt`), not function-anchored. A
  // reader given "line 3, inside `g`" for a read on line 7 looks in the wrong place, and for a
  // top-level read that is what the function cursor says — the start function is lowered last, so
  // `emitCurFnIx` still names the file's final `function`.
  if !sDeclared {
    return emitFailAt(
      memFloorMsg(memIx, "field access but no struct type declared"),
      memIx,
    )
  }
  if memIx < 0 { return -1 }
  const m = nodeAt(memIx)
  if m is Member {
    // A read through a `never` an instance binds is unreachable (D3178).
    if nodeTyAt(m.memObj, fnIx) == TY_NEVER { return emitNullCalleeCall() }
    const si = structIndexOfExpr(m.memObj, fnIx)
    if si < 0 {
      return emitFailAt(
        memFloorMsg(memIx, "field access receiver is not a struct"),
        memIx,
      )
    }
    const idx = sFieldIndex(si, m.memProp)
    if idx < 0 {
      return emitFailAt(
        memFloorMsg(memIx, "unknown struct field in field access"),
        memIx,
      )
    }
    if emitExpr(m.memObj, fnIx) < 0 { return -1 }
    // A NULLABLE-struct receiver (`S | null`) recovers its non-null ref before the
    // field read — the checker proved every such access guarded, so the cast can
    // never trap on a checked program.
    if memRecvOwesNonNull(memIx, fnIx) { fbRefAsNonNull() }
    const narrowOp = memReadNarrowOp(memIx, fnIx)
    if narrowOp >= 0 {
      fbStructGet(sHeapIdx[si], idx)
      wU8(narrowOp)
      emitNulStrFieldRecover(sFieldStart[si] + idx, memIx, fnIx)
    } else {
      structFieldTail(si, idx, memIx, fnIx)
    }
    return structUnionBoxTail(si, idx, memIx, fnIx)
  }
  return emitFail("emitProgram: expected a field access")
}

// After struct `si`'s field `idx` is read at member read `memIx`: a union-typed field (code 16)
// read while its member path is narrowed unboxes to the read's own type, as a narrowed union ident
// read does; an un-narrowed read is the box. Returns 0, or -1.
export function structUnionBoxTail(
  si: i32,
  idx: i32,
  memIx: i32,
  fnIx: i32,
): i32 {
  if !sFieldIsUnionBox(si, idx) { return 0 }
  // A record read at its own type out of the union of records it is built into is that
  // member's record (`boxedArmOfMember`).
  const avi = boxedArmOfMember(memIx, fnIx)
  if avi >= 0 { return emitArmUnboxCast(variantHeap(avi), false) }
  if memReadBoxAmbiguous(memIx, fnIx) { return emitBoxAmbiguousFail(memIx) }
  const own = memReadBoxNarrowTy(memIx, fnIx)
  // A read at one scalar of a box holding one wider scalar unboxes and converts it, with no
  // box rebuilt at the scalar's own set.
  if own >= 0 {
    const sc = boxNarrowScalarKinds(sFieldElemTyIxAt(si, idx), own)
    if sc.length == 2 {
      if emitUnionUnboxTail(sc[0]) < 0 { return -1 }
      wU8(atomConvOp(sc[0], sc[1]))
      return 0
    }
    if emitBoxAtomRetagTys(sFieldElemTyIxAt(si, idx), own, memIx) < 0 {
      return -1
    }
  }
  return emitUnionFieldNarrowUnbox(memIx, fnIx)
}

// After variant `vi`'s field `idx` is read at member read `memIx`: a union-typed field read while
// its member path is narrowed unboxes to the narrowed atom. Returns 0, or -1.
export function variantUnionBoxTail(
  vi: i32,
  idx: i32,
  memIx: i32,
  fnIx: i32,
): i32 {
  if !fieldRowIsUnionBox(uFieldStart[vi] + idx) { return 0 }
  // A record read at its own type out of the union of records it is built into is that member's
  // record, as `structUnionBoxTail` writes it off a struct receiver (D17025).
  const avi = boxedArmOfMember(memIx, fnIx)
  if avi >= 0 { return emitArmUnboxCast(variantHeap(avi), false) }
  return emitUnionFieldNarrowUnbox(memIx, fnIx)
}

// ── string-literal decoding ─────────────────────────────────────────────────

// A `StrLit` carries the raw lexeme in `strText` — quotes kept, escapes unresolved — so the
// emitter decodes it here to the sequence of Unicode code points the string denotes, walking the
// lexeme by iteration under the same escape grammar the lexer applies (`scanQuoted`):
// `\n \t \r \\ \" \' \0 \b \f \v`, `\xXX`, `\uXXXX`, `\u{…}`. `cpsToUtf8` then encodes them.

// Lower a string literal onto `body`: decode `strText` to its code-point vector, UTF-8-encode it,
// push each byte as `i32.const`, then `array.new_fixed $sBackIdx <count>` for the packed
// `(array (mut i8))` backing and `struct.new $sTypeIdx` for the whole-backing header.

// A literal past the `array.new_fixed` operand cap builds the backing chunked and wraps once at
// the end. The cap is counted in bytes, because the operands are bytes, and `collectStrPool`
// applies the same budget: a literal the pool accepted but this rejected would be emitted twice
// under two different shapes.
export function emitStr(strIx: i32, _fnIx: i32) {
  if strIx < 0 { return -1 }
  const s = nodeAt(strIx)
  if s is StrLit {
    // A POOLED literal (every distinct literal within the `array.new_fixed` cap —
    // `collectStrPool`) reads its interned immutable global: one `global.get`
    // instead of an i32.const-per-codepoint allocation at every evaluation.
    const pi = gStrPoolIx[s.strText] ?? -1
    if pi >= 0 {
      // The pool follows the imported globals: indices nImp..nImp+pool-1.
      fbGlobalGet(externGlobalCount() + pi)
      return 0
    }
    // A literal past the cap reads its data segment: a few code bytes whatever its length.
    const di = if gStrDataLen.length > 0 { gStrDataIx[s.strText] ?? -1 } else { -1 }
    if di >= 0 {
      const dn = gStrDataLen[di]
      fbI32Const(0)  // segment offset
      fbI32Const(dn) // byte count
      fbArrayNewData(sBackTy(), di)
      fbI32Const(0)  // start
      fbI32Const(dn) // len
      fbStrNew()
      return 0
    }
    const cps = cpsToUtf8(decodeStr(strToCps(s.strText)))
    if cps.length > NEW_FIXED_MAX {
      // Past the engines' `array.new_fixed` operand cap — build chunked, since an unchunked
      // emit validates nowhere. The chunked build fills the backing; the header is wrapped
      // around it once the last chunk lands.
      const dst = arrLitChunkStart("list", 0, sBackTy(), cps.length, true)
      let ci = 0
      let coff = 0
      while ci < cps.length {
        fbI32Const(cps[ci])
        ci = ci + 1
        coff = arrLitChunkFlush(dst, sBackTy(), coff, ci, cps.length)
      }
      fbLocalGet(dst)
      fbRefAsNonNull()       // (the slot is declared nullable)
      fbI32Const(0)          // start
      fbI32Const(cps.length) // len
      fbStrNew()             // the view over the whole freshly built backing
      return 0
    }
    let i = 0
    while i < cps.length {
      fbI32Const(cps[i]) // 0x41 i32.const <code point>
      i = i + 1
    }
    fbArrayNewFixed(sBackTy(), cps.length) // 0xfb 0x08 <typeidx> <count>
    fbI32Const(0)                          // start
    fbI32Const(cps.length)                 // len
    fbStrNew()                             // 0xfb 0x00 <string header>
    return 0
  }
  return emitFail("emitProgram: expected a string literal")
}

// `[...a, 1, ...b]` — the runtime-length list literal, on `.slice`'s shape, since
// `array.new_fixed`'s length is a compile-time constant. Every item group — a spread's
// source, or a run of plain elements as its own literal — is evaluated in source order into
// its own frame slot; the destination is allocated once, and each group is one `array.copy`.
function emitArrSpread(arrIx: i32, fnIx: i32, lb: ListBuild) {
  const a = nodeAt(arrIx)
  if a is ArrayLit {
    const elems = a.arrElems
    const boxRow = spreadBoxDestRow(elems, fnIx, lb)
    if boxRow >= 0 { return emitArrSpreadBoxed(arrIx, boxRow, fnIx) }
    const boxSrc = spreadBoxingSource(arrIx, fnIx)
    if boxSrc >= 0 {
      // Nothing threaded a row, so the literal builds at its own typed union-box row.
      const own = spreadOwnBoxRow(arrIx, elems, fnIx)
      if own >= 0 { return emitArrSpreadBoxed(arrIx, own, fnIx) }
      return emitFailAt(
        "emitProgram: a spread whose elements must each be boxed into a union or nullable "
          + "element has no lowering yet; build the source list at the literal's element type",
        boxSrc,
      )
    }
    const p = spreadPlanOf(arrIx, fnIx, lb)
    if p.spWhy != "" { return emitFail(p.spWhy) }
    const wrap = spreadWrapIdx(p.spKind, p.spRow)
    const back = spreadBackIdx(p.spKind, p.spRow)
    if wrap < 0 || back < 0 {
      return emitFail("emitProgram: spread literal but list type not collected")
    }
    // The item groups in source order: a spread contributes its source, a run of plain
    // elements its own synthesized literal, which `emitArr` builds at this same rep.
    const groups: i32[] = []
    let run: i32[] = []
    let i = 0
    while i < elems.length {
      const src = spreadArgOf(elems[i])
      if src >= 0 {
        if run.length > 0 {
          groups.push(spreadRunLit(run, arrIx, arrIx, a.pos))
          run = []
        }
        groups.push(src)
      } else {
        run.push(elems[i])
      }
      i = i + 1
    }
    if run.length > 0 { groups.push(spreadRunLit(run, arrIx, arrIx, a.pos)) }
    const seq = liKinds.length
    const slots: i32[] = []
    const groupRows: i32[] = []
    let g = 0
    while g < groups.length {
      const gRow = p.spGroupRows[g]
      if emitSpreadGroup(groups[g], fnIx, p.spGroupKinds[g], gRow) < 0 {
        return -1
      }
      const gs = spreadGroupStash(p, arrIx, g, groups[g], fnIx, seq)
      if gs < 0 { return -1 }
      slots.push(gs)
      groupRows.push(gRow)
      g = g + 1
    }
    return spreadJoinGroups(
      arrIx,
      slots,
      groupRows,
      wrap,
      back,
      p.spKind,
      p.spRow,
      seq,
    )
  }
  return emitFail("emitProgram: expected an array literal")
}

// A slot key packs a ref-list row under 4096 with `4096 * ordinal`, so an ordinal must stay
// under the `i32` key's room for it.
const SPREAD_ORDINAL_CAP = 524000

// Spread literal `arrIx`'s frame slot for item group `g`: keyed by its recorded ordinal, else,
// for a literal no collect walk met, by the emission sequence `seq`.
function spreadGroupSlotAt(
  arrIx: i32,
  g: i32,
  kk: ListKind,
  row: i32,
  seq: i32,
): i32 {
  const gid = spreadGroupSlotIdOf(arrIx, g)
  if gid < 0 { return spreadGroupWrapSlot(kk, row, seq + g) }
  if gid >= SPREAD_ORDINAL_CAP {
    return emitFail(
      "emitProgram: a spread group's slot ordinal overflows its slot key",
    )
  }
  return spreadGroupIdSlot(kk, row, gid)
}

// A spread group's tail once its list `grp` is on the stack: refresh it if a view, convert it to
// the destination's element kind, and park it in the group's frame slot; the slot, or -1.
export function spreadGroupStash(
  p: SpreadPlan,
  arrIx: i32,
  g: i32,
  grp: i32,
  fnIx: i32,
  seq: i32,
): i32 {
  svSyncRecv(grp, fnIx)
  const gk = p.spSrcKinds[g]
  const kk = p.spKind
  if gk != kk && kk == "strlist" {
    if emitAtomListToStrTop(spreadSrcAtomTexts(grp, fnIx)) < 0 { return -1 }
  } else if gk != kk {
    if emitScalarListWidenTop(listKindElemKind(gk), listKindElemKind(kk)) < 0 {
      return -1
    }
  }
  const gs = spreadGroupSlotAt(arrIx, g, kk, p.spGroupRows[g], seq)
  if gs < 0 { return -1 }
  fbLocalSet(gs)
  return gs
}

// Join a spread literal's item groups, each a list in its own frame slot, of (`kk`, `row`) or,
// for a source whose element is a subtype of the row's, of that source's own row
// (`groupRows`): allocate the destination once, then one `array.copy` per group in source order.
export function spreadJoinGroups(
  arrIx: i32,
  slots: i32[],
  groupRows: i32[],
  wrap: i32,
  back: i32,
  kk: ListKind,
  row: i32,
  seq: i32,
) {
  const sid = spreadSlotIdOf(arrIx)
  if sid >= SPREAD_ORDINAL_CAP {
    return emitFail(
      "emitProgram: a spread literal's slot ordinal overflows its slot key",
    )
  }
  const totL = if sid >= 0 { spreadJoinTmpSlot(2 * sid) } else { widenTmpSlot(2000 + 2 * seq) }
  const offL = if sid >= 0 { spreadJoinTmpSlot(2 * sid + 1) } else { widenTmpSlot(2001 + 2 * seq) }
  const dstL = if sid >= 0 { spreadDstIdSlot(kk, row, sid) } else { spreadDstBackSlot(kk, row, seq) }
  fbI32Const(0)
  fbLocalSet(totL)
  let t = 0
  while t < slots.length {
    fbLocalGet(totL)
    fbLocalGet(slots[t])
    fbStructGet(spreadWrapIdx(kk, groupRows[t]), 1) // the group's logical length
    fbI32Bin(106)                                   // 0x6a i32.add
    fbLocalSet(totL)
    t = t + 1
  }
  fbLocalGet(totL)
  fbArrayNewDefault(back)
  fbLocalSet(dstL)
  // The result wrapper is built FIRST and left on the stack, so the `array.copy` runs below
  // consume their own operands and nothing has to re-read it — `emitArrSlice`'s discipline.
  // The backing rides a NULLABLE frame slot and the wrapper's field is not, so it recovers.
  fbLocalGet(dstL)
  fbRefAsNonNull()
  fbLocalGet(totL)
  fbLocalGet(totL)
  fbStructNew(wrap)
  fbI32Const(0)
  fbLocalSet(offL)
  let c = 0
  while c < slots.length {
    const gw = spreadWrapIdx(kk, groupRows[c])
    fbLocalGet(dstL)   // dest backing
    fbLocalGet(offL)   // dest offset
    fbLocalGet(slots[c])
    fbStructGet(gw, 0) // src backing
    fbI32Const(0)      // src offset
    fbLocalGet(slots[c])
    fbStructGet(gw, 1) // count
    fbArrayCopy(back, spreadBackIdx(kk, groupRows[c]))
    if c + 1 < slots.length {
      fbLocalGet(offL)
      fbLocalGet(slots[c])
      fbStructGet(gw, 1)
      fbI32Bin(106) // i32.add
      fbLocalSet(offL)
    }
    c = c + 1
  }
  return 0
}

// `emitArrSpread` for a destination list of union boxes: a same-row source copies as it is,
// a record list is boxed by the element-converting copy, a scalar list by its boxing sibling,
// and a plain run builds at the row; the groups then join as every spread's do.
function emitArrSpreadBoxed(arrIx: i32, row: i32, fnIx: i32) {
  const a = nodeAt(arrIx)
  if !(a is ArrayLit) {
    return emitFail("emitProgram: expected an array literal")
  }
  const kk: ListKind = "reflist"
  const wrap = spreadWrapIdx(kk, row)
  const back = spreadBackIdx(kk, row)
  if wrap < 0 || back < 0 {
    return emitFail("emitProgram: spread literal but list type not collected")
  }
  const groups: i32[] = []
  const isSrc: boolean[] = []
  let run: i32[] = []
  let i = 0
  while i < a.arrElems.length {
    const src = spreadArgOf(a.arrElems[i])
    if src >= 0 {
      if run.length > 0 {
        groups.push(spreadRunLit(run, arrIx, arrIx, a.pos))
        isSrc.push(false)
        run = []
      }
      groups.push(src)
      isSrc.push(true)
    } else {
      run.push(a.arrElems[i])
    }
    i = i + 1
  }
  if run.length > 0 {
    groups.push(spreadRunLit(run, arrIx, arrIx, a.pos))
    isSrc.push(false)
  }
  const seq = liKinds.length
  const slots: i32[] = []
  const groupRows: i32[] = []
  let g = 0
  while g < groups.length {
    if emitSpreadGroupBoxed(groups[g], isSrc[g], row, fnIx) < 0 { return -1 }
    const gs = spreadGroupSlotAt(arrIx, g, kk, row, seq)
    if gs < 0 { return -1 }
    slots.push(gs)
    groupRows.push(row)
    fbLocalSet(gs)
    g = g + 1
  }
  return spreadJoinGroups(arrIx, slots, groupRows, wrap, back, kk, row, seq)
}

// One group of `emitArrSpreadBoxed`, left on the stack as a list at union-box row `row`. A list
// literal source linked to the literal it is spread into is built there, as a run is (D16701).
function emitSpreadGroupBoxed(
  grp: i32,
  isSrc: boolean,
  row: i32,
  fnIx: i32,
): i32 {
  const lit = unwrapParen(grp)
  if (
    !isSrc
    || lit >= 0 && nodeAt(lit) is ArrayLit && elabSpreadRunHolderOf(lit) >= 0
  ) {
    return emitSpreadGroup(grp, fnIx, LBK_UNION, row)
  }
  const k = mfRecvKindOf(grp, fnIx)
  if k == "reflist" {
    const s = refListSlotOfExpr(grp, fnIx)
    if emitSpreadGroup(grp, fnIx, LBK_REF, s) < 0 { return -1 }
    if s == row || rlUnionRowCovers(s, row) { return 0 }
    if rlUnionRowRetags(s, row) { return emitUnionListRetagTop(s, row, grp) }
    if rlWidenTagOf(s, row) < 0 {
      return emitFailAt(
        "emitProgram: a boxing spread reached a source `spreadSrcBoxes` does not admit",
        grp,
      )
    }
    return emitRefListWidenTop(s, row)
  }
  const ak = spreadSrcBoxAtom(grp, row, fnIx)
  // Unreachable past `spreadSrcBoxes`, which admits only a scalar source whose element is a
  // member or widens to one.
  if k == null || k == "u8list" || ak < 0 {
    return emitFailAt(
      "emitProgram: a boxing spread reached a source `spreadSrcBoxes` does not admit",
      grp,
    )
  }
  if emitSpreadGroup(grp, fnIx, pendingKindOfList(k, 0), 0) < 0 { return -1 }
  return emitScalarListBoxTop(
    listKindElemKind(k),
    ak,
    row,
    spreadSrcNulMode(grp, fnIx),
    0,
  )
}

// One list operand `g` of a spread literal or a widening concat: a list literal is built at
// its stamp's pair, else at the pair (`kind`, `row`) the join copies it from; any other
// operand as it is. Returns 0 once the list is on the stack, -1 on failure.
function emitSpreadGroup(g: i32, fnIx: i32, kind: i32, row: i32): i32 {
  const lit = unwrapParen(g)
  if lit < 0 || !(nodeAt(lit) is ArrayLit) { return emitExpr(g, fnIx) }
  const tb = arrLitBuild(lit, arrLitTyAt(lit, fnIx), fnIx)
  if tb != null { return emitArrAt(lit, fnIx, tb) }
  const gb: ListBuild = { lbKind: kind, lbSlot: row }
  return emitArrAt(lit, fnIx, gb)
}

// The element kind list kind `k` holds, as the converting copies take it: `listIdxKindOf`'s
// inverse, with a string and a ref list naming their own kinds.
function listKindElemKind(k: ListKind): VKind {
  match k {
    "f64list" => {
      return "f64"
    }
    "i64list" => {
      return "i64"
    }
    "f32list" => {
      return "f32"
    }
    "v128list" => {
      return "v128"
    }
    "list" => {
      return "i32"
    }
    "u8list" => {
      return "u8list"
    }
    "strlist" => {
      return "str"
    }
    "reflist" => {
      return "reflist"
    }
  }
}

// A run of plain elements as its own `ArrayLit`, built at holder `h`'s type, or at its holder's
// when `h` is an untyped minted run (D16696). It reports at the spread literal's position: a
// synthesized node otherwise takes the parser's last cursor, at the end of the file.
export function spreadRunLit(run: i32[], arrIx: i32, h: i32, pos: i32): i32 {
  const ix = mkArrayLit(run, pos)
  adoptNodeTok(ix, arrIx)
  const up = elabSpreadRunHolderOf(h)
  elabSpreadRunNote(ix, if up >= 0 && nodeTyIxOf(h) < 0 { up } else { h })
  return ix
}

// Lower an array literal `[e, e, ...]` onto `body` as a growable list value: the elements in
// source order, `array.new_fixed` for the backing, then `count` twice for len and cap and
// `struct.new` for the wrapper; an empty `[]` shares its type's empty backing. Built at the
// checker's type for it unless it has none; context restored on exit.
function emitArr(arrIx: i32, fnIx: i32) {
  const from = wLen()
  // The scratch frame as legacy found it, for the probe to allocate from.
  const before = if irShadowOn { liFrameSave() } else { liFrameNone }
  const r = emitArrAt(arrIx, fnIx, arrLitListBuild(arrIx, fnIx))
  if r >= 0 && irShadowOn {
    irNodeInShadowHook(arrIx, fnIx, arrLitBuildTyOf(arrIx, fnIx), from, before)
  }
  return r
}

// The armed shadow's per-occurrence count of a legacy site (`irNodeInShadow`); a hook, since the
// IR's builder imports this module.
export let irNodeInShadowHook: (ix: i32, fnIx: i32, ty: i32, from: i32, before: LiFrame) => i32 = nodeInShadowNone
const liFrameNone: LiFrame = {
  lfKinds: [],
  lfSlots: [],
  lfBack: [],
  lfField: [],
}

function nodeInShadowNone(
  _ix: i32,
  _fnIx: i32,
  _ty: i32,
  _from: i32,
  _before: LiFrame,
): i32 {
  return 0
}

// `emitArr` at the build pair `lb`: the literal's own, or the one a spread literal builds each
// of its item groups at.
function emitArrAt(arrIx: i32, fnIx: i32, lb: ListBuild) {
  elabSpreadNote(arrIx)
  const r = emitArrUnder(arrIx, fnIx, lb)
  return r
}

// The packed `u8[]` arm of `emitArrUnder`: each element as a plain i32 truncated into the
// byte backing. Past `array.new_fixed`'s cap: one data segment when every element is a
// literal, else a chunked build. Returns 0 once the list is on the stack, -1 on failure.
function emitArrU8(elems: i32[], fnIx: i32, row: i32) {
  let dstU8 = -1
  let coffU8 = 0
  if elems.length > NEW_FIXED_MAX {
    const dForm = if row == PK_U16 || row == PK_I16 { ALD_U16 } else { ALD_U8 }
    const dU8 = arrLitDataBuild(elems, fnIx, dForm, pkBackAt(row))
    if dU8 < 0 { return -1 }
    if dU8 == 1 { return arrLitWrap(elems.length, pkWrapAt(row)) }
    dstU8 = arrLitChunkStart("u8list", row, pkBackAt(row), elems.length, false)
  }
  let iu8 = 0
  while iu8 < elems.length {
    if exprArray(elems[iu8], fnIx) || exprRefArray(elems[iu8], fnIx) {
      return emitFail("emitProgram: nested arrays are not supported")
    }
    if emitExpr(elems[iu8], fnIx) < 0 { return -1 }
    iu8 = iu8 + 1
    if dstU8 >= 0 {
      coffU8 = arrLitChunkFlush(dstU8, pkBackAt(row), coffU8, iu8, elems.length)
    }
  }
  if dstU8 >= 0 {
    fbLocalGet(dstU8)
    fbRefAsNonNull() // the chunk-built packed backing
    return arrLitLenCap(elems.length, pkWrapAt(row))
  }
  return arrLitPackedShortTail(row, elems.length)
}

// After a short packed list literal's `n` elements, each a plain i32, at packed row `row`: the
// byte backing, its length and capacity, and the row's wrapper.
export function arrLitPackedShortTail(row: i32, n: i32): i32 {
  fbBacking(pkBackAt(row), n)
  return arrLitLenCap(n, pkWrapAt(row))
}

// The v128-list arm of `emitArrUnder`: each element is a vector already, so it lowers as itself.
function emitArrV128(elems: i32[], fnIx: i32) {
  let dst = -1
  let coff = 0
  if elems.length > NEW_FIXED_MAX {
    dst = arrLitChunkStart("v128list", 0, fa128Ty(), elems.length, false)
  }
  let i = 0
  while i < elems.length {
    if emitExpr(elems[i], fnIx) < 0 { return -1 }
    i = i + 1
    if dst >= 0 {
      coff = arrLitChunkFlush(dst, fa128Ty(), coff, i, elems.length)
    }
  }
  if dst >= 0 {
    fbLocalGet(dst)
    fbRefAsNonNull()
  } else {
    fbBacking(fa128Ty(), elems.length)
  }
  fbI32Const(elems.length)
  fbI32Const(elems.length)
  fbStructNew(fl128Ty())
  return 0
}

// A scalar list arm whose elements widen to one width: f32, f64 or i64.
type WideArm = "f32" | "f64" | "i64"

// Arm `w`'s element form (`ALD_*`) and `emitWidened` kind.
type WidePlan = { wpForm: i32, wpWiden: i32 }

function widePlanOf(w: WideArm): WidePlan {
  return match w {
    "f32" => { wpForm: ALD_F32, wpWiden: 5 }
    "f64" => { wpForm: ALD_F64, wpWiden: 4 }
    "i64" => { wpForm: ALD_I64, wpWiden: 3 }
  }
}

// Arm `w`'s backing array heap type.
function wideBackTy(w: WideArm): i32 {
  return match w {
    "f32" => fa32Ty()
    "f64" => fa64Ty()
    "i64" => ia64Ty()
  }
}

// Arm `w`'s list wrapper heap type.
function wideWrapTy(w: WideArm): i32 {
  return match w {
    "f32" => fl32Ty()
    "f64" => fl64Ty()
    "i64" => il64Ty()
  }
}

// Opens arm `w`'s chunked build of `n` elements into backing `back`; its scratch slot.
function wideChunkStart(w: WideArm, back: i32, n: i32): i32 {
  return match w {
    "f32" => arrLitChunkStart("f32list", 0, back, n, false)
    "f64" => arrLitChunkStart("f64list", 0, back, n, false)
    "i64" => arrLitChunkStart("i64list", 0, back, n, false)
  }
}

// The f32, f64 and i64 arms of `emitArrUnder`: a hoisted `for` iterable's module list; past the
// chunk cap, one data segment or a chunked build; else each element widened to the arm's width
// (a literal re-encoded, an i32 operand converted) and the short tail. 0 on the stack, -1 failed.
function emitArrWide(arrIx: i32, elems: i32[], fnIx: i32, w: WideArm) {
  const h = arrLitHoistGlobal(arrIx, fnIx, w)
  if h == -2 { return -1 }
  if h >= 0 {
    fbGlobalGet(h)
    return 0
  }
  const pl = widePlanOf(w)
  const back = wideBackTy(w)
  const wrap = wideWrapTy(w)
  let dst = -1
  let coff = 0
  if elems.length > NEW_FIXED_MAX {
    const d = arrLitDataBuild(elems, fnIx, pl.wpForm, back)
    if d < 0 { return -1 }
    if d == 1 { return arrLitWrap(elems.length, wrap) }
    dst = wideChunkStart(w, back, elems.length)
  }
  let i = 0
  while i < elems.length {
    if exprArray(elems[i], fnIx) || exprRefArray(elems[i], fnIx) {
      return emitFail("emitProgram: nested arrays are not supported")
    }
    if emitWidened(elems[i], pl.wpWiden, fnIx) < 0 { return -1 }
    i = i + 1
    if dst >= 0 { coff = arrLitChunkFlush(dst, back, coff, i, elems.length) }
  }
  if dst >= 0 {
    fbLocalGet(dst)
    fbRefAsNonNull() // the chunk-built backing
    return arrLitLenCap(elems.length, wrap)
  }
  return arrLitShortTail(w, elems.length)
}

// The string-list arm of `emitArrUnder`. Returns 0 once the list is on the stack, -1 on
// failure.
function emitArrStr(arrIx: i32, elems: i32[], fnIx: i32) {
  const hStr = arrLitHoistGlobal(arrIx, fnIx, "str")
  if hStr == -2 { return -1 }
  if hStr >= 0 {
    fbGlobalGet(hStr)
    return 0
  }
  let dstStr = -1
  let coffStr = 0
  if elems.length > allocLitChunk() {
    dstStr = arrLitChunkStart("strlist", 0, mkArrTy(), elems.length, false)
  }
  let i = 0
  while i < elems.length {
    // A literal-union atom element widens to its member string. The backing is
    // `(ref null $aTypeIdx)` and the atom's rep is an i32 id, so without this the element
    // store is `expected (ref null $type), found i32` — check-clean invalid wasm.

    // Reached whenever the literal already builds a string list, and what decides that is the
    // recorded context type, not the element order: `arrLitIsStr` answers true outright for a
    // `(string | null)[]` and for a `string[]` literal however their elements are ordered, and
    // falls through to the first element's type only when no context rule fires.
    if emitStrValue(elems[i], fnIx) < 0 { return -1 }
    i = i + 1
    if dstStr >= 0 {
      coffStr = arrLitChunkFlushAt(
        dstStr,
        mkArrTy(),
        coffStr,
        i,
        elems.length,
        allocLitChunk(),
      )
    }
  }
  if dstStr >= 0 {
    fbLocalGet(dstStr)
    fbRefAsNonNull() // the chunk-built backing
    return arrLitLenCap(elems.length, mkListTy())
  }
  return arrLitShortTail("str", elems.length)
}

// The ref-list arm of `emitArrUnder`: the element slot comes from a threaded annotation, else
// element 0, and decides the backing, the wrapper and the context each element builds under.
// Returns 0 once the list is on the stack, -1 on failure.
function emitArrRef(arrIx: i32, elems: i32[], fnIx: i32, lb: ListBuild) {
  if !rlRowsMinted() {
    return emitFail(
      "emitProgram: ref array literal but ref list type not collected",
    )
  }
  // The element type decides which (backing, wrapper) pair this literal builds: a ref pair's
  // row, else element 0's.
  const rslot = arrRefSlotOf(arrIx, elems, fnIx, lb)
  if rslot < 0 { return -1 }
  // A literal whose elements each build as themselves takes the one decision the IR reads, and
  // its tail.
  if arrLitRefPlainSlot(arrIx, fnIx, lb) == rslot {
    for e in elems {
      if emitExpr(e, fnIx) < 0 { return -1 }
    }
    return arrLitRefShortTail(rslot, elems.length)
  }
  // …and one whose elements each box by their own record, the decision the IR reads too.
  if arrLitUnionBoxSlot(arrIx, fnIx, lb) == rslot {
    for e in elems {
      if emitDelivered(e, fnIx) < 0 { return -1 }
    }
    return arrLitRefShortTail(rslot, elems.length)
  }
  // …and one whose elements each enter a non-null variant's arm as they stand, read by the IR too.
  if arrLitVariantSlot(arrIx, fnIx, lb) == rslot {
    const vi = rlElemVariantRow(rslot)
    for e in elems {
      if emitVariantCoerce(vi, e, fnIx) < 0 { return -1 }
    }
    return arrLitRefShortTail(rslot, elems.length)
  }
  // A concrete-VARIANT element list (`Cat[]`) has no `sNames` entry: each element is coerced
  // into the arm read off the slot's element type, any `| null` peeled.
  let elemVariantIdx = -1
  if rlElemKindAt(rslot) == RLK_STRUCT {
    elemVariantIdx = rlElemVariantRow(rslot)
  }
  // A UNION-element list (kind 2) coerces each element into the box at the
  // write boundary (`emitUnionCoerce` — the host's per-element `coerceUnion`):
  // a bare scalar/string boxes under its atom's tag; an object literal /
  // already-union value passes through to its existing boxing.
  const elemUnionBox = rlElemKindAt(rslot) == RLK_UNION
  let elemUnionTy = -1
  if elemUnionBox {
    // The slot's element, or the literal's own where the slot is a generic body's hole.
    elemUnionTy = rlElemTyIxAt(rslot)
    const litEt = tyArrayElemIx(nodeTyInOf(arrIx, fnIx))
    if litEt >= 0 && !tyHasTyVar(litEt) && tyHasTyVar(elemUnionTy) {
      elemUnionTy = litEt
    }
  }
  // A nested LIST element kind (`i32[][]` 4 / `string[][]` 6 / `f64[][]` 7 / `i64[][]` 8):
  // the elements ARE arrays, each built at its own type.
  const elemNest = rlElemKindAt(rslot)
  let dstRef = -1
  let coffRef = 0
  if elems.length > allocLitChunk() {
    dstRef = arrLitChunkStart(
      "reflist",
      rslot,
      rlBackIdx[rslot],
      elems.length,
      false,
    )
  }
  let i = 0
  while i < elems.length {
    // A non-nested-list element list must not hold array elements. Kinds 4/6/7/8 (scalar
    // inner lists) and 9 (ref inner list) legitimately do — and so does a union-box element
    // whose union has a list arm (`(i32[] | f64)[]` with a `[1, 2]` element): the array boxes
    // through `emitUnionBoxArg` and `emitUnionCoerce`, whose own rejects bite.
    if (
      elemNest != RLK_I32_LIST
      && elemNest != RLK_STR_LIST
      && elemNest != RLK_F64_LIST
      && elemNest != RLK_I64_LIST
      && elemNest != RLK_REF_LIST
      && elemNest != RLK_F32_LIST
      && elemNest != RLK_V128_LIST
      && elemNest != RLK_U8_LIST
      && !elemUnionBox
    ) {
      if exprArray(elems[i], fnIx) || exprRefArray(elems[i], fnIx) {
        return emitFail("emitProgram: nested arrays are not supported")
      }
    }
    if elemUnionBox {
      // Box the element into the shared union box — a concrete variant element widens via
      // `emitUnionBoxArg`, like a call argument or return.
      if (emitUnionBoxOwed("", elemUnionTy, elems[i], fnIx) < 0) { return -1 }
    } else {
      if (emitArrRefElem(elems[i], fnIx, rslot, elemVariantIdx) < 0) {
        return -1
      }
    }
    i = i + 1
    if dstRef >= 0 {
      coffRef = arrLitChunkFlushAt(
        dstRef,
        rlBackIdx[rslot],
        coffRef,
        i,
        elems.length,
        allocLitChunk(),
      )
    }
  }
  if dstRef >= 0 {
    fbLocalGet(dstRef)
    fbRefAsNonNull() // the chunk-built ref backing
    return arrLitLenCap(elems.length, rlWrapIdx[rslot])
  }
  return arrLitRefShortTail(rslot, elems.length)
}

// After a short ref-list literal's `n` elements at slot `rslot`: the backing, its length and
// capacity, and the slot's wrapper.
export function arrLitRefShortTail(rslot: i32, n: i32): i32 {
  fbBacking(rlBackIdx[rslot], n)
  return arrLitLenCap(n, rlWrapIdx[rslot])
}

// `emitArrRef`'s ref-list slot: a ref build pair's row, else element 0's, else
// slot 0 when the literal names none. -1 when no element type is interned at all.
function arrRefSlotOf(arrIx: i32, elems: i32[], fnIx: i32, lb: ListBuild) {
  const rslot = arrRefSlotPlain(arrIx, elems, fnIx, lb)
  if rslot < 0 {
    if rlElemName.length < 1 {
      return emitFail(
        "emitProgram: ref array literal with no interned element type",
      )
    }
    // Slot 0 is some other list's row; a list of maps whose value type is still open keys none.
    const e0 = if elems.length >= 1 { nodeTyIxOf(unwrapParen(elems[0])) } else { -1 }
    if e0 >= 0 && e0 < T.tys.length && tyAt(nonNullTy(e0)) is TyMap {
      return emitFailAt(
        "emitProgram: a list literal of maps whose value type is still open names no list row",
        arrIx,
      )
    }
    return 0
  }
  return rslot
}

// One non-union element `e` of `emitArrRef`'s list at slot `rslot`, built as is or coerced
// into the arm `elemVariantIdx`. Returns 0 once the element is on the stack, -1 on failure.
function emitArrRefElem(e: i32, fnIx: i32, rslot: i32, elemVariantIdx: i32) {
  if elemVariantIdx >= 0 && rlElemNullable[rslot] != 1 {
    // A non-null ARM element takes every value through `emitVariantCoerce`, a join
    // included; the coerce owns the narrowed unbox (D4639).
    if emitVariantCoerce(elemVariantIdx, e, fnIx) < 0 { return -1 }
  } else {
    const twin = arrRefElemTwinRow(e, fnIx, rslot)
    if twin >= 0 { return emitObj(unwrapParen(e), fnIx, twin) }
    const elArmOwed = narrowedArmNeedsUnbox(e, fnIx)
    if emitExpr(e, fnIx) < 0 { return -1 }
    // The narrowed-arm unbox at a ref-list element (D1031) — `[s]` of a `Circle[]` under
    // `if s is Circle`. The slot's own element heap is the destination, the same one
    // `rlBackIdx` types the backing array with.
    if elArmOwed { emitNarrowedArmUnboxTo(rlElemArmHeapOf(rslot), e, fnIx) }
  }
  // Read-only covariance at a nested-list element (D791, D965) — `[lv1]` of a
  // `(readonly Shape[])[]`.
  return 0
}

// The default i32-list arm of `emitArrUnder`, including literal-union, nullable-boolean and
// `null` elements that share the i32 backing. Returns 0 once the list is on the stack, -1 on
// failure.
function emitArrI32(arrIx: i32, elems: i32[], fnIx: i32, lbKind: i32) {
  // Four element types share the i32 backing but do not lower like i32s, so each seeds the
  // element emits: `K[]` lowers member literals as interned atom ids, `(boolean|null)[]` and
  // `null[]` a `null` as the sentinel 2, and `(K|null)[]` both. The element type comes from the checker's
  // recorded type; the `lbKind` 8 and 9 legs catch an all-`null` `[null]`.
  const litArr = nodeArrayElemIsLitUnion(arrIx)
  // A `null[]` list's element of the `null` type, at an instance whose element type is `null`,
  // is the sentinel too, which a delivery with no destination around it does not name.
  const nulUnit = arrElemIsNullUnitAt(arrIx, fnIx)
  if (
    (nodeArrayElemIsNulLitUnion(arrIx) && lbKind != LBK_UNION)
    || lbKind == LBK_NUL_LIT_UNION_LIST
  ) {
  }
  const hI32 = arrLitHoistGlobal(arrIx, fnIx, "i32")
  if hI32 == -2 { return -1 }
  if hI32 >= 0 {
    fbGlobalGet(hI32)
    return 0
  }
  let dstI32 = -1
  let coffI32 = 0
  if elems.length > NEW_FIXED_MAX {
    const dI32 = arrLitDataBuild(elems, fnIx, ALD_I32, aTy())
    if dI32 != 0 {
      if dI32 < 0 { return -1 }
      return arrLitWrap(elems.length, lTy())
    }
    dstI32 = arrLitChunkStart("list", 0, aTy(), elems.length, false)
  }
  let i = 0
  while i < elems.length {
    if !litArr {
      if exprArray(elems[i], fnIx) || exprRefArray(elems[i], fnIx) {
        return emitFail("emitProgram: nested arrays are not supported")
      }
      if exprStruct(elems[i], fnIx) {
        return emitFail("emitProgram: struct array elements are not supported")
      }
      // A declared union arm reaching the i32-list fallback — the same shape as the struct arm
      // above and the map arm below. The two namespaces are exclusive, a name in `uVariants`
      // having no `sNames` row, so `exprStruct` declines for an arm by construction and the
      // element would reach `array.new_fixed $aTypeIdx` with a `(ref $variantHeap)` operand.

      // A ref list of arms has a sound rep and the annotated spellings reach it; what has no
      // rep is an arm element on the i32 backing, which the inferred spelling reaches. Two
      // channels, as at the map arm below: the emit-side classifier, and the checker's recorded
      // node type for an inline literal.
      if exprVariantIndex(elems[i], fnIx) >= 0 || nodeTyIsVariant(elems[i]) {
        return emitFail(
          "emitProgram: union-arm array elements are not supported in this position",
        )
      }
      // A map-typed element reaching the i32-list fallback, with no ref-list or map-array kind
      // threaded: the map struct ref would be stored as an i32 element. A map array can only
      // build through the ref-list path with a threaded map-element kind, so with none here
      // there is no sound rep — fail loudly.
      if exprMap(elems[i], fnIx) || nodeTyIsMap(elems[i]) {
        return emitFail(
          "emitProgram: map array elements are not supported in this position",
        )
      }
    }
    if nulUnit && isNullTy(nodeTyAt(elems[i], fnIx)) {
      if !(nodeAt(unwrapParen(elems[i])) is NullLit) {
        if emitExpr(elems[i], fnIx) < 0 { return -1 }
        fbDrop()
      }
      fbI32Const(2)
    } else if emitExpr(elems[i], fnIx) < 0 {
      return -1
    }
    i = i + 1
    if dstI32 >= 0 {
      coffI32 = arrLitChunkFlush(dstI32, aTy(), coffI32, i, elems.length)
    }
  }
  if dstI32 >= 0 {
    fbLocalGet(dstI32)
    fbRefAsNonNull() // the chunk-built backing
    return arrLitLenCap(elems.length, lTy())
  }
  return arrLitShortTail("i32", elems.length)
}

// `emitArr`'s body: it applies each arm's element context and leaves it for the wrapper's
// exit to undo.
function emitArrUnder(arrIx: i32, fnIx: i32, lb: ListBuild) {
  arrLitMint(arrIx)
  const a = nodeAt(arrIx)
  const arm = arrLitArmOf(arrIx, fnIx, lb)
  if !(a is ArrayLit) || arm == "notLit" {
    return emitFail("emitProgram: expected an array literal")
  }
  const elems = a.arrElems
  if arm == "spread" { return emitArrSpread(arrIx, fnIx, lb) }
  if arm == "clash" {
    return emitFailAt(
      "emitProgram: a list literal around a generic call whose `??` default is a list of "
        + "another element at this type argument has no lowering yet; give the default the "
        + "operand's own element type",
      arrIx,
    )
  }
  // An empty `[]` whose pair is the i32 default builds at the element type the checker
  // pinned on the literal itself — a join arm's sibling, a return's witness (D2209).
  if arm == "emptyHole" {
    const hb: ListBuild = {
      lbKind: emptyArrHoleBuildKind(arrIx, fnIx),
      lbSlot: emptyArrHoleBuildSlot(arrIx, fnIx),
    }
    return emitArrUnder(arrIx, fnIx, hb)
  }
  if arm == "v128" { return emitArrV128(elems, fnIx) }
  if arm == "u8" { return emitArrU8(elems, fnIx, lb.lbSlot) }
  if arm == "f32" { return emitArrWide(arrIx, elems, fnIx, "f32") }
  if arm == "f64" { return emitArrWide(arrIx, elems, fnIx, "f64") }
  if arm == "i64" { return emitArrWide(arrIx, elems, fnIx, "i64") }
  if arm == "str" { return emitArrStr(arrIx, elems, fnIx) }
  if arm == "ref" { return emitArrRef(arrIx, elems, fnIx, lb) }
  return emitArrI32(arrIx, elems, fnIx, lb.lbKind)
}

// After a short list literal's elements: its backing built by `array.new_fixed` at arm `arm`'s
// heap types, then the length and capacity, both `n`, and the wrapper.
export function arrLitShortTail(arm: ArrLitArm, n: i32): i32 {
  return match arm {
    "i32" => arrLitBackWrap(aTy(), lTy(), n)
    "f64" => arrLitBackWrap(fa64Ty(), fl64Ty(), n)
    "i64" => arrLitBackWrap(ia64Ty(), il64Ty(), n)
    "f32" => arrLitBackWrap(fa32Ty(), fl32Ty(), n)
    "str" => arrLitBackWrap(mkArrTy(), mkListTy(), n)
    "notLit" | "spread" | "clash" | "emptyHole" | "v128" | "u8" | "ref" => {
      emitFail(
        "emitProgram: internal: a short list literal tail for an arm with its own builder",
      )
    }
  }
}

// `n` elements' backing of heap type `back`, then the wrapper `wrap` around it.
function arrLitBackWrap(back: i32, wrap: i32, n: i32): i32 {
  fbBacking(back, n)
  return arrLitLenCap(n, wrap)
}

// After a list's backing: the length and capacity, both `n`, and `struct.new` of wrapper `wrap`.
function arrLitLenCap(n: i32, wrap: i32): i32 {
  fbI32Const(n) // len
  fbI32Const(n) // cap
  fbStructNew(wrap)
  return 0
}

// Before a list literal's elements, at build pair `lb`: its spread record noted and its types
// minted, as `emitArr` does first.
export function arrLitPrologue(arrIx: i32): i32 {
  elabSpreadNote(arrIx)
  arrLitMint(arrIx)
  return 0
}

// Why list literal `arrIx` of `n` elements does not build at arm `arm` with `array.new_fixed` and
// the short tail, or "": past the chunk cap (a string list's own), or a non-empty i32 list seeded
// with a `null` sentinel. A literal-union list's atoms are its elements' own, and a hoisted `for`
// iterable reads its module list instead (`arrLitHoistGlobal`).
export function arrLitShortWhy(
  arrIx: i32,
  fnIx: i32,
  arm: ArrLitArm,
  n: i32,
): string {
  const cap = if arm == "str" { allocLitChunk() } else { NEW_FIXED_MAX }
  if n > cap { return "long" }
  if arm == "i32" && n > 0 && arrElemIsNullUnitAt(arrIx, fnIx) {
    return "null sentinel"
  }
  return ""
}

// Whether list literal `arrIx` is a `for` walk's iterable, whose constants hoist into a module
// list. The arena is scanned on demand, so a node an instance adds later is still seen.
export function arrLitIsForIter(arrIx: i32): boolean {
  while forIterScanned < P.nodes.length {
    const n = nodeAt(forIterScanned)
    if n is ForIn {
      const it = unwrapParen(n.fiIter)
      if it >= 0 && it < P.nodes.length && nodeAt(it) is ArrayLit {
        forIterLits.set(it, true)
      }
    }
    forIterScanned = forIterScanned + 1
  }
  return forIterLits.has(arrIx)
}

// ── G8: string-keyed maps — the open-addressing hash map ─────────────────────

// A map is the struct the map-table section describes in full. Operations hash the key (FNV-1a)
// into `index` and linear-probe to a free-or-matching slot, never an O(n) scan. A function that
// touches a map reserves a 15-slot scratch frame at `mapScratchBase`.

// The frame: +0 mapRef, +1 keyRef, +2 curRef, +3 slot, +4 cap, +5 entry, +6 keysBk, +7 valsBk,
// +8 chr, +9 hcur, +10 idxBk, +11 rslot, +12 liveBk, +13 hashBk, +14 valSet. `hcur` is the op's
// key hash, live from `emitMapProbe` through an appending set's `hashes[]` store.

// The i32-keyed rep re-types four of those slots and keeps five of its own, each minted on first
// use (`mapI32KeyLocal`): the i32 key, the keys backing, the key-list builder's two backings and
// the map struct. The i64-keyed rep has the same five (`mapI64KeyLocal`). `cmKeyKind` picks.

// The current op's map struct heap type / vals wrapper / vals backing.
function cmMapTy() { return mapTypeIdxOf(cmSlot) }
function cmValsWrap() { return mvValsWrapOf(cmSlot) }
function cmValsBack() { return mvValsBackOf(cmSlot) }

// True when the current op runs on the i32-keyed rep. Two sources, because a map shape carries
// the key in two places depending on the value: the mono-value sentinels -4 (map) and -5 (Set),
// where a value on the shared i32 `vals` list interns no slot so the key has nowhere else to
// live; and an mv slot's own `mvKeyKind` column, the slot's identity being the (key, value) pair.

// Asked by every accessor below that picks between the two keys lists, the two probe helpers and
// the two key scratch slots. Everything else is key-blind by construction: it reads the value
// side, which the slot answers on its own.
function cmKeyKind() { return mapShapeKeyKind(cmSlot) }
// Whether the current op's index is the (tag, entry) pair layout: an i32 or an i64 key.
function cmKeyInt() { return cmKeyKind() != MAP_KEY_STR }
// Slot `k` of the current op's integer-key frame: the i32 frame or the i64 one.
function cmIntKeyLocal(k: i32) {
  if cmKeyKind() == MAP_KEY_I64 { return mapI64KeyLocal(k) }
  return mapI32KeyLocal(k)
}
// The current op's keys-list wrapper and backing heap types: the string-ref pair for the
// string-keyed rep, the i32 or i64 list pair for an integer-keyed one.
function cmKeysWrap() {
  const k = cmKeyKind()
  if k == MAP_KEY_I32 { return lTy() }
  if k == MAP_KEY_I64 { return il64Ty() }
  return mkListTy()
}
function cmKeysBack() {
  const k = cmKeyKind()
  if k == MAP_KEY_I32 { return aTy() }
  if k == MAP_KEY_I64 { return ia64Ty() }
  return mkArrTy()
}
// The current op's target-key scratch local: the string frame's slot 1, a `(ref $sTypeIdx)`
// string, or an integer frame's slot 0, the raw key.
function cmKeyLocal() {
  if msHelp { return 1 }
  if cmKeyInt() { return cmIntKeyLocal(0) }
  return mapScratchBase + 1
}
// The current op's grown or compacted keys-backing scratch local: the string frame's slot 6, or
// an integer frame's slot 1.
function cmKeysBkLocal() {
  if msHelp { return 6 }
  if cmKeyInt() { return cmIntKeyLocal(1) }
  return mapScratchBase + 6
}
// True while a `__map_set_<row>__` body emits: its map, key and value are params 0, 1 and 2, and
// every other slot is the string frame's own, rebased to local 0, whatever the shape.
let msHelp = false
// The current op's mapRef local. An mv slot always uses its own typed frame slot, asked first
// because that frame is already typed to the slot's map struct whichever key rep it carries. Only
// the two mono shapes have to choose between the shared `(ref $mStructIdx)` scratch slot 0 and
// the i32-keyed frame's own, the mono local being typed to the string-keyed struct.
function cmMapRefLocal() {
  if msHelp { return 0 }
  if cmSlot >= 0 { return fnMvMapRefLocal(cmSlot) }
  if cmKeyInt() { return cmIntKeyLocal(4) }
  return mapScratchBase
}
// The current op's vals-backing scratch local (grow/compact temporary).
function cmValsBkLocal() {
  if msHelp { return 7 }
  if cmSlot < 0 { return mapScratchBase + 7 }
  return fnMvValsBkLocal(cmSlot)
}

// Evaluate the map receiver `recvIx` once and leave its `(ref $mapStruct)` on the operand stack,
// ready for the mapRef store. One home for evaluating a map receiver: the probe path
// (`emitMapRecvKey`) and the tombstone-aware `for`-in walk both come through here, because the
// two properties this owns are the two a second hand-written copy loses.

// The receiver is emitted exactly once, so its side effects run once and every later read sees
// the same object — a re-emitted receiver is a fresh evaluation, and a factory returning a new
// map per call leaves the two reads on different maps. And a nullable receiver (kind `nulmap`) is
// recovered before the mapRef store; omitting that is check-clean invalid wasm, never a message.
function pushMapRecvRef(recvIx: i32, fnIx: i32) {
  if emitExpr(recvIx, fnIx) < 0 { return -1 }
  return mapRecvRefTail(recvIx, fnIx)
}

// After map receiver `recvIx`'s value: a nullable receiver recovered to its map.
export function mapRecvRefTail(recvIx: i32, fnIx: i32): i32 {
  if exprNullableMap(recvIx, fnIx) { fbRefAsNonNull() }
  return 0
}

// `local.get` / `local.set` of the current op's mapRef.
function pushMapRef() {
  fbLocalGet(cmMapRefLocal()) // 0x20 local.get
  return 0
}
function setMapRef() {
  fbLocalSet(cmMapRefLocal()) // 0x21 local.set
  return 0
}

// `local.get` of map scratch slot `n` (the shared mono frame — every slot except
// the mapRef/valsBk/valStash trio is map-shape-agnostic and stays shared).
function pushMapScr(n: i32) {
  fbLocalGet(mapScratchBase + n) // 0x20 local.get
  return 0
}

// `local.set` of map scratch slot `n`.
function setMapScr(n: i32) {
  fbLocalSet(mapScratchBase + n) // 0x21 local.set
  return 0
}

// `M.keys` (the keys list wrapper ref): `local.get mapRef ; struct.get <mapTy> 0`.
function pushMapKeys() {
  pushMapRef()
  fbStructGet(cmMapTy(), 0) // field 0: keys
  return 0
}

// `M.vals` (the vals list wrapper ref): `local.get mapRef ; struct.get <mapTy> 1`.
function pushMapVals() {
  pushMapRef()
  fbStructGet(cmMapTy(), 1) // field 1: vals
  return 0
}

// `M.live` (the i32 tombstone array, parallel to entries; all 1s in this slice):
// `local.get mapRef ; struct.get <mapTy> 2`.
function pushMapLive() {
  pushMapRef()
  fbStructGet(cmMapTy(), 2) // field 2: live
  return 0
}

// `M.index` (the i32 hash-slot array): `local.get mapRef ; struct.get <mapTy> 3`.
function pushMapIndex() {
  pushMapRef()
  fbStructGet(cmMapTy(), 3) // field 3: index
  return 0
}

// `M.count` (entries appended): `local.get mapRef ; struct.get <mapTy> 4`.
function pushMapCount() {
  pushMapRef()
  fbStructGet(cmMapTy(), 4) // field 4: count
  return 0
}

// `M.length` (live entry count): `local.get mapRef ; struct.get <mapTy> 5`.
function pushMapSize() {
  pushMapRef()
  fbStructGet(cmMapTy(), 5) // field 5: size
  return 0
}

// `M.hashes` (the i32 per-entry FNV cache, parallel to the entries):
// `local.get mapRef ; struct.get <mapTy> 6`.
function pushMapHashes() {
  pushMapRef()
  fbStructGet(cmMapTy(), 6) // field 6: hashes
  return 0
}

// `M.seqs` (the i64 per-entry insertion sequences, parallel to the entries), present only in a
// module that deletes (D2315): `local.get mapRef ; struct.get <mapTy> 7`.
function pushMapSeqs() {
  pushMapRef()
  fbStructGet(cmMapTy(), 7) // field 7: seqs
  return 0
}

// The hash of the current op's string key, leaving a non-negative i32 on the stack: the FNV-1a
// of the string in the key slot, a call into the shared `__str_hash__` helper. An i32 key is
// never hashed here: it is its own tag in the pair index.
function emitMapHashOf() {
  fbLocalGet(cmKeyLocal())
  fbCall(helpStrHashFn())
  return 0
}

// The index position of the current op's probe slot (scratch slot 3): the slot itself in a
// string-keyed index; in an integer-keyed one's pairs, `2 * slot + k`, the tag (`k` 0) or the
// entry (`k` 1).
function pushMapSlotPos(k: i32) {
  pushMapScr(3)
  if !cmKeyInt() { return 0 }
  fbI32Const(1)
  fbI32Bin(116) // 0x74 i32.shl
  if k != 0 {
    fbI32Const(k)
    fbI32Bin(114) // 0x72 i32.or
  }
  return 0
}

// Probe: with `mapRef` (slot 0) and `keyRef` (slot 1) set, linear-probe `M.index` to the slot of
// the key's entry or the free one ending its chain. Leaves `entry` (5), 0 for a miss, and `slot`
// (3) under `needSlotAsked` (always under `-O`), which only set and delete read. Occupancy, dead
// markers included, stays under 1/2, so a free slot is reached.

// A dead entry stays a probe marker, never a hit, so delete does not break the chain (D2370).
// The string key is hashed here, as `__map_probe__`'s first operand, on an empty operand stack so
// no backing `struct.get` stays live across `__str_hash__`; `keepHash` parks it in scratch +9.
function emitMapProbe(keepHash: boolean, needSlotAsked: boolean) {
  // `-O` keeps the slot probe and the index read at the site, the shape its map rows pin.
  const needSlot = needSlotAsked || gOptimized != 0
  // Push the probe's shape-agnostic components (the map struct type differs per value shape,
  // but `index`/`hashes`/`live`/`keys` are identically typed across shapes — only these
  // `struct.get`s stay at the call site) and call the shared helper, which returns the SLOT.
  const pk = cmKeyKind()
  if pk == MAP_KEY_I32 {
    pushMapIndex()
    fbLocalGet(cmKeyLocal()) // the raw i32 key, its own tag
    if !needSlot {
      fbCall(helpMapEntryI32Fn())
      setMapScr(5) // entry
      return 0
    }
    fbCall(helpMapProbeI32Fn())
  } else if pk == MAP_KEY_I64 {
    pushMapIndex()
    fbLocalGet(cmKeyLocal()) // the i64 key; the helper hashes it to its tag
    pushMapKeysBacking()
    fbCall(helpMapProbeI64Fn())
  } else {
    emitMapHashOf()
    if keepHash { fbLocalTee(mapScratchBase + 9) }
    pushMapIndex()
    pushMapHashes()
    pushMapLive()
    pushMapKeysBacking()
    fbLocalGet(cmKeyLocal()) // the target string key
    if !needSlot {
      fbCall(helpMapEntryFn())
      setMapScr(5) // entry
      return 0
    }
    fbCall(helpMapProbeFn())
  }
  setMapScr(3) // slot
  // entry = the slot's entry  (0 = miss; else entry-position + 1)
  pushMapIndex()
  pushMapSlotPos(1)
  fbArrayGet(aTy()) // array.get
  setMapScr(5) // entry
  return 0
}

// The one home of the `-3` map-value reject. Four op sites each spelled out this verdict, two of
// them enumerating a supported side that went stale. So the message names the remainder instead,
// which is small and stays small: `mvValKindOfTy` lowers every scalar, litunion atom, struct,
// list at any nesting, nested map, union and closure, plus each one's nullable niche.

// What is left: a struct that is a member of a declared union, living in the variant table where
// the mv slot has no variant half; a nullable list whose element rep the layer does not name; and
// a value name resolving to none of these. The tail clause is a second producer, for a lowerable
// value whose mv slot nothing interned.
function failMapValueType() {
  return emitFail(
    "emitProgram: unsupported map value type (no rep for a union-member struct or a nullable list over an unnamed element rep; any other value type here interned no mv slot)",
  )
}

// Whether `ix` is a `Map()` call with no arguments that no user function named `Map` serves.
function mapNewCallAt(ix: i32): boolean {
  const x = unwrapParen(ix)
  const n = if x >= 0 && x < P.nodes.length { nodeAt(x) } else { null }
  if (
    !(n is Call)
    || n.callArgs.length != 0
    || n.callFn < 0
    || n.callFn >= P.nodes.length
  ) {
    return false
  }
  const f = nodeAt(n.callFn)
  return f is Ident && f.identName == "Map" && fnIndexOfNode(n.callFn) < 0
}

// The map shape `Map()` call `exprIx` builds in `fnIx`: its stamp's shape (D14226), keyed as its
// receivers key it (D14229), or for a call whose type still holds a hole its binding's receivers'.
// -1/-4/-6 the mono map by key, an mv slot >= 0 that value type's map struct, -3 none.
function mapNewShapeOf(exprIx: i32, fnIx: i32): i32 {
  const mt = litRepTyAt(exprIx, fnIx)
  let slot = if mt >= 0 { mapCtorShapeOf(exprIx, mt) } else { mapShapeOfExpr(exprIx, fnIx) }
  if slot == -2 { slot = -1 }
  if slot == -5 { slot = -4 }
  if slot == -7 { slot = -6 }
  return slot
}

// Whether `e` is the `Map()` or `Set()` builtin, which builds an empty map. A user function named
// `Map`/`Set` owns its name (D975): a real constructor resolves to no function.
export function mapNewCall(e: Call): boolean {
  if e.callFn < 0 { return false }
  const f = nodeAt(e.callFn)
  if !(f is Ident) || (f.identName != "Map" && f.identName != "Set") {
    return false
  }
  return fnIndexOfNode(e.callFn) < 0
}

// Construct an EMPTY map `Map()` onto `body`: two empty lists (each `array.new_fixed`
// count 0, wrapped `{ backing, len=0, cap=0 }`), boxed into the map struct.
export function emitMapNew(exprIx: i32, fnIx: i32) {
  const slot = mapNewShapeOf(exprIx, fnIx)
  if slot == -3 { return failMapValueType() }
  // The keys/vals accessors below read the op context, so pin it to the shape being
  // constructed (a `Map()` is not reached through `emitMapRecvKey`).
  const savedCm = cmSlot
  cmSlot = slot
  // keys list: an empty backing → wrapper, in the KEY's own list rep (string-ref for
  // `{[string]: V}`, the i32 list for `{[i32]: V}`).
  fbBacking(cmKeysBack(), 0) // 0 elements
  fbI32Const(0)              // len = 0
  fbI32Const(0)              // cap = 0
  fbStructNew(cmKeysWrap())
  cmSlot = savedCm
  // vals list: empty backing → wrapper (the i32 list, or the slot's ref list).
  fbBacking(mvValsBackOf(slot), 0)
  fbI32Const(0)
  fbI32Const(0)
  fbStructNew(mvValsWrapOf(slot))
  // live: empty i32 array (cap 0), parallel to the empty keys/vals entry lists. In a module
  // that deletes it grows in lockstep with the keys backing (a fresh entry is live = 1).
  fbBacking(aTy(), 0)
  // index: `INITIAL_CAP * 2` (16) zero-filled slots, 0 meaning empty — an i32 array of 16, or of
  // 32 for an i32 key's pairs. Occupancy, dead markers included, stays under 1/2 by resizing at
  // `count*2 >= cap`, so every probe reaches a free slot under any mix of inserts and deletes (D2280).
  if mapShapeKeyInt(slot) { fbI32Const(32) } else { fbI32Const(16) }
  fbArrayNewDefault(aTy())
  // count = 0, size = 0.
  fbI32Const(0)
  fbI32Const(0)
  // hashes: empty i32 array (cap 0). A STRING-keyed map grows it in lockstep with the keys
  // (each key's hash, which gates the probe and re-places the entry); an i32 key is its own tag
  // in the pair index, so an i32-keyed map's stays empty.
  fbBacking(aTy(), 0)
  // seqs (empty) and the next sequence (0), in a module that deletes (D2315).
  if gMapDeletes {
    fbBacking(ia64Ty(), 0)
    fbI64Const(0, 0)
  }
  // map struct { keys, vals, live, index, count, size, hashes[, seqs, next] } — the mono
  // struct, or the mv slot's (identical shape, vals field referencing the slot's wrapper).
  fbStructNew(mapTypeIdxOf(slot))
  return 0
}

// Resolve the receiver's map shape and emit the receiver and key expressions, leaving both values
// on the operand stack ([mapRef, keyRef], keyRef on top) with `cmSlot` pinned to the shape. The
// caller pops key (slot 1) then mapRef.

// They stay off the scratch locals on purpose: an inner map op nested in the key expression — or,
// for a set, in the value expression evaluated between the key and the stores — runs its own probe
// through the same shared scratch frame, and a value parked in `mapRef` or `keyRef` would be
// silently clobbered. Values on the wasm operand stack are immune; nested ops touch only locals.
function emitMapRecvKey(recvIx: i32, keyIx: i32, fnIx: i32) {
  if !exprMap(recvIx, fnIx) {
    return emitFail("emitProgram: map op receiver is not a map")
  }
  // Resolve the receiver's map SHAPE into the op context. A Set (-2 / -5) runs on the
  // mono machinery of its own KEY rep; an unsupported value type (-3) fails loudly.
  const mshape0 = mapShapeOfExpr(recvIx, fnIx)
  if mshape0 == -3 { return failMapValueType() }
  const mshape = mapShapeFoldSet(mshape0)
  // The KEY expression must match the receiver's key rep. The checker proves the pair
  // agrees, so a mismatch here means the receiver's shape resolved wrong — reject
  // loudly rather than emit a string ref into an i32 keys array (invalid wasm).
  const arm = mapKeyArmOf(recvIx, keyIx, fnIx, mshape)
  if arm == "i64Str" {
    return emitFail("emitProgram: i64-keyed map indexed with a string key")
  }
  if arm == "i32Str" {
    return emitFail("emitProgram: i32-keyed map indexed with a string key")
  }
  if arm == "notStr" { return emitFail("emitProgram: map key is not a string") }
  // The receiver expr is emitted OUTSIDE the context (it is map-op-free by
  // construction — an Ident/global/constructor).
  if pushMapRecvRef(recvIx, fnIx) < 0 { return -1 }
  let kr = 0
  if arm == "atom" { kr = emitAtomToStr(keyIx, fnIx) }
  else if arm == "i64" { kr = emitScalarValue(keyIx, fnIx, "i64") }
  else { kr = emitExpr(keyIx, fnIx) }
  if kr < 0 { return -1 }
  return mapRecvKeyTail(mshape)
}

// How a map op writes key `keyIx` for receiver `recvIx` of folded shape `mshape`: `plain` as
// itself, `atom` widened to its member text, `i64` at its own width; the other arms are keys
// the receiver's key rep refuses.
export type MapKeyArm = "i64Str"
  | "i32Str"
  | "notStr"
  | "atom"
  | "i64"
  | "plain"
export function mapKeyArmOf(
  recvIx: i32,
  keyIx: i32,
  fnIx: i32,
  mshape: i32,
): MapKeyArm {
  const keyK = mapShapeKeyKind(mshape)
  if keyK == MAP_KEY_I64 {
    // An i64 key is emitted at its own width; the checker proved it is an i64.
    if exprString(keyIx, fnIx) { return "i64Str" }
    return "i64"
  }
  if keyK == MAP_KEY_I32 {
    // A literal-union-keyed map hashes as i32 because its keys rep as the interned atom, so a
    // member written as a string literal lowers as that id rather than as a ref (D1748).
    if (
      exprString(keyIx, fnIx)
      && !nodeTyMapKeyIsLitUnion(unwrapParen(recvIx))
      && !tyIsLitUnion(tyMapKeyOf(tyMapHeld(nodeTyAt(unwrapParen(recvIx), fnIx))))
    ) {
      return "i32Str"
    }
    return "plain"
  }
  if exprString(keyIx, fnIx) { return "plain" }
  // An atom-repped literal-union key is a string value whose rep is the interned id, so it is
  // widened to its member text at the boundary, through the home `print` shares (D1724).
  if exprIsLitAtom(keyIx, fnIx) { return "atom" }
  return "notStr"
}

// Map receiver `recvIx`'s shape with a set folded onto its key's mono machinery; -3 for a value
// type no map op writes.
export function mapRecvShapeOf(recvIx: i32, fnIx: i32): i32 {
  const sh = mapShapeOfExpr(recvIx, fnIx)
  if sh == -3 { return -3 }
  return mapShapeFoldSet(sh)
}

// After a map op's receiver and key: the op context pinned to the receiver's folded shape
// `mshape`, since an inner map op in the key expression clobbers it.
export function mapRecvKeyTail(mshape: i32): i32 {
  cmSlot = mshape
  return 0
}

// Load the map receiver and key into the scratch frame (slots 0 and 1) and run the probe, leaving
// `entry` (slot 5) = `index[slot]`, 0 for a miss and else the entry position plus 1. `recvIx` and
// `keyIx` are arena indices; `recvIx` must be a map-typed expression and `keyIx` a string.
function emitMapPrep(recvIx: i32, keyIx: i32, fnIx: i32) {
  return emitMapPrepFor(recvIx, keyIx, fnIx, false)
}

// `emitMapPrep`, also leaving `slot` (slot 3) = the probe slot under `needSlot`.
function emitMapPrepFor(recvIx: i32, keyIx: i32, fnIx: i32, needSlot: boolean) {
  if emitMapRecvKey(recvIx, keyIx, fnIx) < 0 { return -1 }
  // Pop the stacked pair into the frame only now — user code is done running.
  if !needSlot { return mapPrepProbeTail() }
  fbLocalSet(cmKeyLocal()) // the target key
  setMapRef()              // mapRef (the shared mono slot, or this mv/i32 frame's)
  return emitMapProbe(false, needSlot)
}

// Emit the `??` DEFAULT `d` for a REF-valued map slot (`cmSlot >= 0`) onto `body`, in the
// value's own rep (scalar / union box / struct-list / list-wrapper / struct / nullable
// niche). Factored out of `emitMapGetOr` so the value-null coalesce can emit it exactly
// once whether the read missed the key OR read a stored null.
function emitMapValDefault(
  mslot: i32,
  scalarVK: VKind | null,
  defIx: i32,
  fnIx: i32,
) {
  if scalarVK != null {
    return emitScalarValue(defIx, fnIx, scalarVK)
  } else if mslot >= 0 && mvValKindAt(mslot) == "union" {
    // A UNION-valued map's default is coerced into the shared box, like a stored value — a
    // concrete VARIANT default boxes (`emitUnionBoxArg`), as in a call arg / return.
    return emitUnionBoxOwed(mvValName[mslot], mvValTyIxAt(mslot), defIx, fnIx)
  }
  return emitExpr(defIx, fnIx)
}

// True when a `??` DEFAULT is itself nullable — a bare `null` literal or a nullable-typed
// expression. `m[k] ?? null` (over a nullable-value map) stays `V | null`, so the ref recover
// must be skipped; a non-null default makes the whole `??` non-null.
function defExprNullable(ix: i32) {
  const u = nodeAt(unwrapParen(ix))
  if u is NullLit { return true }
  return nodeTyIsNullable(ix)
}

// Lower a map get `m[k]` with a default (`m[k] ?? d`) onto `body`: probe, then if the
// key is found push `vals[entry-1]`, else push the default `d`. The self-host checker always
// reads a map through `?? -1`, so this is the primary get. `rk` is the `??`'s own atom kind
// (-1 none): a scalar value it is wider than is read and widened to it (D10091).
function emitMapGetOr(recvIx: i32, keyIx: i32, defIx: i32, fnIx: i32, rk: i32) {
  const arm = mapGetOrArmOf(recvIx, defIx, fnIx, rk)
  if arm == "helper" {
    const miss = mapGetOrHelperRoute(recvIx, defIx, fnIx, rk)
    return emitMapGetCall(recvIx, keyIx, fnIx, miss[0])
  }
  const wvk = mapRecvScalarKindInst(recvIx, fnIx)
  if emitMapPrep(recvIx, keyIx, fnIx) < 0 { return -1 }
  if arm == "widen" {
    pushMapScr(5)                // entry
    fbIf(valBlockTypeOfKind(rk)) // if (entry != 0 → found), the result's blocktype
    pushMapScalarHit()
    if coalWidenUnboxed(wvk, rk) < 0 { return -1 }
    fbElse()
    if emitExprAsKind(defIx, rk, fnIx) < 0 { return -1 }
    fbEnd()
    return 0
  }
  if arm == "mv" && mapGetOrMvPlain(recvIx, defIx, fnIx) {
    const pslot = cmSlot
    mapGetOrMvHead(pslot)
    if emitMapValDefault(pslot, mvScalarValKind(pslot), defIx, fnIx) < 0 {
      return -1
    }
    return mapGetOrMvTail(pslot)
  }
  if arm == "mv" {
    // Ref values route through the slot's nullable valStash local rather than a
    // value-typed `if` (needs no interned blocktype): the hit arm sets it from the
    // `(ref null)` slot read, the miss arm from the default, and `ref.as_non_null`
    // recovers non-null — sound because a live entry's val slot is never null.
    const mslot = cmSlot
    // A boxed value-union map value that includes null (`{[string]: i32 | null}`,
    // `{[string]: A | B | null}`) stores null as a null-tagged box; `??` coalesces on
    // that tag and peels the value non-null, the value-union sibling of the ref-niche
    // `ref.is_null` path below. A null-free union value has no tag and takes the plain path.
    if mvValKindAt(mslot) == "union" {
      if mvValUnionHasNull(mslot) {
        return emitMapGetOrUnionBox(mslot, defIx, fnIx, rk)
      }
    }
    // A SCALAR-valued map (f64/i64) stores the value directly; its default is emitted in
    // the value's rep and it needs no `ref.as_non_null`. A ref value (string/struct) does.
    const scalarVK = mvScalarValKind(mslot)
    if scalarVK != null && defExprNullable(defIx) {
      const sbk = mapRecvScalarBoxKindIn(recvIx, fnIx)
      if sbk >= 0 && (vbHeapIdxOfKind(sbk) >= 0 || nodeTyIsMap(recvIx)) {
        return emitMapGetOrScalarBox(sbk, defIx, fnIx)
      }
    }
    // A nullable-value ref niche (value reps as `(ref null <elem>)`) stores null
    // directly in its vals slot: a missing key and a stored null both read as null, and
    // `??` coalesces on that read being null — so read the raw nullable value first and
    // let one `ref.is_null` supply the default for both.
    const nullableRef = scalarVK == null && mvSlotNullable(mslot)
    const stashL = fnMvValStashLocal(mslot)
    pushMapScr(5)                // entry
    fbIf(64)                     // if (entry != 0 → found), void
    pushMapVals()
    fbStructGet(cmValsWrap(), 0) // vals backing
    pushMapScr(5)                // entry
    fbI32Const(1)
    fbI32Bin(107)                // i32.sub (entry - 1)
    fbArrayGet(cmValsBack())     // scalar (f64/i64) / (ref null <elem>) slot read
    fbLocalSet(stashL)
    fbElse()                     // else — a MISS
    if nullableRef {
      // A miss IS the read's null; the `ref.is_null` coalesce below supplies the default.
      fbRefNull(mvValElemHeapOf(mslot))
      fbLocalSet(stashL)
    } else {
      if emitMapValDefault(mslot, scalarVK, defIx, fnIx) < 0 { return -1 }
      cmSlot = mslot
      fbLocalSet(stashL)
    }
    fbEnd() // end (if)
    if nullableRef {
      // Coalesce on the read value being null — a missing key or a stored null both take `d`.
      fbLocalGet(stashL)
      fbRefIsNull()
      fbIf(64)
      if emitMapValDefault(mslot, scalarVK, defIx, fnIx) < 0 { return -1 }
      cmSlot = mslot
      fbLocalSet(stashL)
      fbEnd()
    }
    fbLocalGet(stashL)
    // A scalar f64/i64 result needs no null-recovery; a ref value does (`??` is non-null).
    // For a nullable niche the coalesce already replaced every null with `d`, so recover to
    // non-null EXCEPT when the default itself is nullable (`m[k] ?? null` stays `S | null`).
    if scalarVK == null {
      if !defExprNullable(defIx) { fbRefAsNonNull() }
    }
    return 0
  }
  // A nullable-atom value map (`{[string]: K | null}` / `{[string]: boolean | null}`)
  // stores null as an i32 sentinel in the mono vals slot (`-1` litunion atom, `2`
  // boolean): a missing key and the stored sentinel both read as null, and `??`
  // coalesces on that — read the raw i32 and default when it equals the sentinel.
  if arm == "scalarBox" {
    return emitMapGetOrScalarBox(
      mapRecvScalarBoxKindIn(recvIx, fnIx),
      defIx,
      fnIx,
    )
  }
  if arm == "i32" || arm == "atom" {
    mapGetOrI32Head()
    if emitMonoMapDefault(recvIx, defIx, fnIx) < 0 { return -1 }
    return mapGetOrI32Tail()
  }
  const nulSentinel = mapGetOrSentinel(mapRecvTyIn(recvIx, fnIx))
  // raw = (entry != 0) ? backing[entry-1] : sentinel  — a miss reads as null.
  pushMapScr(5)           // entry
  fbIf(127)               // if (entry != 0 → found), i32 blocktype
  pushMapVals()
  fbStructGet(lTy(), 0)
  pushMapScr(5)
  fbI32Const(1)
  fbI32Bin(107)
  fbArrayGet(aTy())
  fbElse()
  fbI32Const(nulSentinel) // miss = null sentinel
  fbEnd()
  // Coalesce: raw == sentinel ? d : raw. Slot +8 (probe hash cursor) is dead after the probe.
  setMapScr(8)
  pushMapScr(8)
  fbI32Const(nulSentinel)
  fbI32Bin(70) // 0x46 i32.eq → raw == sentinel (null, missing OR stored)
  fbIf(127)
  if emitMonoMapDefault(recvIx, defIx, fnIx) < 0 { return -1 }
  fbElse()
  pushMapScr(8)
  fbEnd()
  return 0
}

// How `recvIx[k] ?? defIx` (`rk` the `??`'s atom kind, -1 none) reads its map: through the
// `__map_get_<row>__` helper, widened to `rk`, at an mv slot's value, as a nullable value boxed or
// held at its null sentinel, or as the plain `i32` read with the default in its miss arm, an
// atom-valued map's (`atom`) written as a member literal.
export type MapGetOrArm = "helper"
  | "widen"
  | "mv"
  | "scalarBox"
  | "sentinel"
  | "atom"
  | "i32"
export function mapGetOrArmOf(
  recvIx: i32,
  defIx: i32,
  fnIx: i32,
  rk: i32,
): MapGetOrArm {
  if mapGetOrHelperRoute(recvIx, defIx, fnIx, rk).length == 1 {
    return "helper"
  }
  const wvk = mapRecvScalarKindInst(recvIx, fnIx)
  if wvk >= 0 && coalWidens(wvk, rk) && !defExprNullable(defIx) {
    return "widen"
  }
  if mapRecvShapeOf(recvIx, fnIx) >= 0 { return "mv" }
  if mapGetOrSentinel(mapRecvTyIn(recvIx, fnIx)) != 0 { return "sentinel" }
  if defExprNullable(defIx) {
    // A hole's read whose pin no node registered a value box for keeps the unboxed lowering.
    const mbk = mapRecvScalarBoxKindIn(recvIx, fnIx)
    if mbk >= 0 && (vbHeapIdxOfKind(mbk) >= 0 || nodeTyIsMap(recvIx)) {
      return "scalarBox"
    }
  }
  if mapTyValLitUnionTexts(mapRecvTyIn(recvIx, fnIx)).length > 0 {
    return "atom"
  }
  return "i32"
}

// Whether `recvIx[k] ?? defIx` at an mv slot takes its plain arm: a value that is neither a union
// nor a nullable niche, and a default that is not nullable, written in the value's own rep.
export function mapGetOrMvPlain(recvIx: i32, defIx: i32, fnIx: i32): boolean {
  const ms = mapRecvShapeOf(recvIx, fnIx)
  if ms < 0 || mvValKindAt(ms) == "union" || defExprNullable(defIx) {
    return false
  }
  return mvScalarValKind(ms) != null || !mvSlotNullable(ms)
}

// The mv plain arm's head after the probe: `if entry != 0 { stash = vals.backing[entry-1] } else`,
// a void `if`; the default follows, then `mapGetOrMvTail`.
export function mapGetOrMvHead(mslot: i32) {
  pushMapScr(5)                // entry
  fbIf(64)                     // if (entry != 0 → found), void
  pushMapVals()
  fbStructGet(cmValsWrap(), 0) // vals backing
  pushMapScr(5)                // entry
  fbI32Const(1)
  fbI32Bin(107)                // i32.sub (entry - 1)
  fbArrayGet(cmValsBack())     // scalar (f64/i64) / (ref null <elem>) slot read
  fbLocalSet(fnMvValStashLocal(mslot))
  fbElse()                     // else — a MISS
  return 0
}

// After the default: the stash set from it, the `if` closed, the stash read, and a ref value
// recovered to non-null (a live entry's slot is never null, nor is the default).
export function mapGetOrMvTail(mslot: i32) {
  cmSlot = mslot
  const stashL = fnMvValStashLocal(mslot)
  fbLocalSet(stashL)
  fbEnd()
  fbLocalGet(stashL)
  if mvScalarValKind(mslot) == null { fbRefAsNonNull() }
  return 0
}

// The i32 a mono map of type `mt` stores for a null value: `-1` for a nullable literal union, `2`
// for a nullable boolean or `null`; 0 for a map with no null sentinel.
function mapGetOrSentinel(mt: i32): i32 {
  if mapTyValIsNulLitUnion(mt) { return 0 - 1 }
  if mapTyValIsNulBool(mt) || mapTyValIsNullUnit(mt) { return 2 }
  return 0
}

// The plain `i32` read's head after the probe: `if entry != 0 { vals.backing[entry-1] } else`, a
// value-typed `if`; the default follows, then `mapGetOrI32Tail`.
export function mapGetOrI32Head() {
  pushMapScr(5)         // entry
  fbIf(127)             // if (entry != 0 → found; a nonzero condition is true), 0x7f i32 blocktype
  pushMapVals()
  fbStructGet(lTy(), 0) // struct.get (vals backing), field 0: backing
  pushMapScr(5)         // entry
  fbI32Const(1)
  fbI32Bin(107)         // 0x6b i32.sub  (entry - 1)
  fbArrayGet(aTy())     // array.get
  fbElse()              // else
  return 0
}

export function mapGetOrI32Tail() {
  fbEnd()
  return 0
}

// A map read's probe after its receiver and key: the key into the frame, then the map ref, then
// the probe, leaving `entry`; `emitMapPrep`'s tail.
export function mapPrepProbeTail() {
  fbLocalSet(cmKeyLocal())
  setMapRef()
  return emitMapProbe(false, false)
}

// Lower `m[k] ?? d` over a boxed value-union map value that includes null: read the box
// (miss → the null-tagged box), then coalesce on its null tag — `scalar | null` peels to the
// raw scalar, widened to `rk` (the `??`'s atom kind, -1 none) when that is wider, and a
// multi-member `… | null` peels to the non-null union box.
function emitMapGetOrUnionBox(mslot: i32, defIx: i32, fnIx: i32, rk: i32) {
  const uvn = mvValName[mslot]
  // The map value union's members come from its type's member set. One resolution of the
  // set feeds both this walk and the residual-kind code below, so the two cannot disagree.
  const uvsid = msSetOfTy(mvValTyIxAt(mslot))
  const mtys: i32[] = []
  if !msMemberTysOfSet(uvsid, mtys) {
    return emitFail(
      "emitProgram: a union-valued map's value type has no member set",
    )
  }
  const stashL = fnMvValStashLocal(mslot)
  // raw box: hit → stored (ref null $uBox); miss → the null-tagged box.
  pushMapScr(5)                // entry
  fbIf(64)                     // if (entry != 0 → found), void
  pushMapVals()
  fbStructGet(cmValsWrap(), 0) // vals backing
  pushMapScr(5)
  fbI32Const(1)
  fbI32Bin(107)                // i32.sub (entry - 1)
  fbArrayGet(cmValsBack())     // the stored (ref null $uBox) slot read
  fbLocalSet(stashL)
  fbElse()                     // miss = the read's null (a null-tagged box)
  fbI32Rel(RS_TAG, nullBoxTag())
  fbRefNullNone()
  fbStructNew(uBoxIdx)
  fbLocalSet(stashL)
  fbEnd()
  // A `scalar | null` value (exactly one non-null scalar member) peels to the RAW scalar — take
  // the default on the null tag, else unbox the scalar payload. A nullable default keeps the
  // result `scalar | null`, the box itself, so it takes the multi-member arm below (D2253).
  if mtys.length == 2 && !defExprNullable(defIx) {
    // `ak` is the residual member's banked ABI code; when unresolved (-2) it re-parses
    // the rendered atom instead. That fallback is unreached on the corpus and fuzz
    // corpora (`docs/internals/destringify-types-program.md` P-RCH/P-SITE) because an
    // alias-spelled nullable value union is rejected by the checker before emit.
    const ak = unionResidualSoloKindOfSet(uvsid)
    if ak == -2 {
      return emitFail(
        "emitProgram: scalar|null map value has no banked residual kind",
      )
    }
    const vb = vbHeapIdxOfKind(ak)
    if vb < 0 {
      return emitFail("emitProgram: scalar|null map value has no value box")
    }
    let urk = ak
    if coalWidens(ak, rk) { urk = rk }
    fbLocalGet(stashL)
    fbStructGet(uBoxIdx, 0)       // field 0: tag
    fbI32Rel(RS_TAG, nullBoxTag())
    fbI32Bin(70)                  // 0x46 i32.eq → null?
    fbIf(valBlockTypeOfKind(urk)) // value-typed if in the result's rep
    if emitExprAsKind(defIx, urk, fnIx) < 0 { return -1 }
    fbElse()
    fbLocalGet(stashL)
    fbStructGet(uBoxIdx, 1)       // field 1: value (anyref payload)
    fbRefCast(vb)
    fbStructGet(vb, 0)            // the scalar payload
    if coalWidenUnboxed(ak, urk) < 0 { return -1 }
    fbEnd()
    return 0
  }
  // A MULTI-member `… | null` value peels to the NON-null union box: on the null tag, box the
  // default like a stored value (`emitUnionBoxArg`); else keep the stored box. `ref.as_non_null`
  // recovers the non-null box the checker's non-null union result promises.
  fbLocalGet(stashL)
  fbStructGet(uBoxIdx, 0) // field 0: tag
  fbI32Rel(RS_TAG, nullBoxTag())
  fbI32Bin(70)            // 0x46 i32.eq → null?
  fbIf(64)
  if emitUnionBoxOwed(uvn, mvValTyIxAt(mslot), defIx, fnIx) < 0 { return -1 }
  fbLocalSet(stashL)
  fbEnd()
  fbLocalGet(stashL)
  fbRefAsNonNull()
  return 0
}

// Emit the `??` DEFAULT for a MONO-atom-valued map (`cmSlot < 0`) onto `body`: an i32 atom id
// for a litunion value (a MEMBER literal recorded atom-typed, or an atom-typed expr; a bare
// `null` → the `-1` sentinel), else the value's own rep (boolean / i32). A non-member / general
// string is the wrong rep for the fused i32 result — fail loudly.
function emitMonoMapDefault(recvIx: i32, defIx: i32, fnIx: i32) {
  const mdMt = mapRecvTyIn(recvIx, fnIx)
  const atomTexts = mapTyValLitUnionTexts(mdMt)
  let atomDef = false
  let nulAtomDef = false
  if atomTexts.length > 0 {
    const du = nodeAt(unwrapParen(defIx))
    if du is StrLit {
      if litLexIsMember(du.strText, atomTexts) { atomDef = true }
    } else if du is NullLit {
      // A NULLABLE-atom value (`{[string]: K | null}`) admits a bare `null` default — lowered as
      // the `-1` niche sentinel (the `??` result stays `K | null`).
      if mapTyValIsNulLitUnion(mdMt) {
        atomDef = true
        nulAtomDef = true
      }
    } else if exprIsLitAtom(defIx, fnIx) {
      atomDef = true
    }
    if !atomDef && !coalMapReadForeignDefault(recvIx, defIx, fnIx) {
      return emitFail(
        "emitProgram: `??` over an atom-valued map needs a member-literal (or atom) default",
      )
    }
  }
  if nulAtomDef {
    fbI32Const(0 - 1)
    return 0
  }
  const dfr = emitExpr(defIx, fnIx)
  if dfr < 0 { return -1 }
  return 0
}

// The narrowed-read tail of a bare map get `m[1]` the checker typed without its miss's `null`
// — the map twin of `emitIndex`'s ref-list rungs. Ref-recover runs first, since
// `emitMapGet` leaves a nullable element for every ref-valued map; a union value (kind
// 2) then unboxes to the tested atom, unless the narrow leaves two or more atoms.
export function emitNarrowedMapReadTail(idxIx: i32, fnIx: i32) {
  const mrs = mapReadNarrowableSlot(idxIx, fnIx)
  if mrs < 0 { return 0 }
  const rt = nodeTyAt(unwrapParen(idxIx), fnIx)
  if rt < 0 || tyAdmitsNull(rt) { return 0 }
  // A UNION value already left the NON-null box (`emitMapGetUnionBox` recovers it), so only
  // the unbox is owed; every other ref value is the raw `(ref null <elem>)` vals slot.
  if mvValKindAt(mrs) == "union" {
    const ak = mapReadNarrowedAtomKind(idxIx, fnIx)
    if ak >= 0 { return emitUnionUnboxTail(ak) }
    // The CONTAINER arms of the same narrowing (`if m[k] is {[string]: V}`, `… is K[]`),
    // which the atom question above answers -1 for. `mapReadNarrowedContainer` is the gate
    // rather than the unbox's own answer, so the classifiers that stop calling this read a
    // box and the lowering that opens it are deciding off one predicate (D1866).
    if mapReadNarrowedContainer(idxIx, fnIx) {
      const con = emitPlaceNarrowContainerUnbox(idxIx, fnIx)
      if con != 0 { return con - 1 }
    }
    return 0
  }
  fbRefAsNonNull() // 0xd4 (the `is` guard proved the key present)
  return 0
}

// How a bare map read `m[k]` at Index node `idxIx` reads its map: a union value through its
// null-tagged box, a mono-valued map through `__map_get_<row>__`, or the probe written inline.
export type MapGetArm = "unionBox" | "helper" | "inline"
export function mapGetArmOf(idxIx: i32, fnIx: i32): MapGetArm {
  const ubs = mapReadNarrowableSlot(idxIx, fnIx)
  if ubs >= 0 && mvValKindAt(ubs) == "union" { return "unionBox" }
  const nd = nodeAt(idxIx)
  if nd is Index && mapGetHelperShape(nd.idxArr, fnIx) != 0 { return "helper" }
  return "inline"
}

// Lower a bare map GET `m[k]` (no `??`) onto `body`: probe, return `vals[entry-1]` or
// `0` when absent. The checker never uses a bare map get (always `?? -1`); provided for
// completeness so `m[k]` in value position is total (0 default).
function emitMapGet(recvIx: i32, keyIx: i32, fnIx: i32) {
  if mapGetHelperShape(recvIx, fnIx) != 0 {
    return emitMapGetCall(recvIx, keyIx, fnIx, mapGetMissOf(recvIx, fnIx))
  }
  if emitMapPrep(recvIx, keyIx, fnIx) < 0 { return -1 }
  return emitMapGetTail(recvIx, fnIx)
}

// `recvIx[keyIx]` through `__map_get_<row>__`, `miss` on a miss; `mapGetHelperShape` is nonzero.
function emitMapGetCall(recvIx: i32, keyIx: i32, fnIx: i32, miss: i32) {
  const fi = mapGetHelperFnOf(recvIx, fnIx, miss)
  if emitMapRecvKey(recvIx, keyIx, fnIx) < 0 { return -1 }
  return fbCall(fi)
}

// The function `__map_get_<row>__` reads receiver `recvIx` through with `miss` on a miss, minted
// before the receiver and key are written, while the tail rows are still open.
export function mapGetHelperFnOf(recvIx: i32, fnIx: i32, miss: i32): i32 {
  const sh = mapGetHelperShape(recvIx, fnIx)
  const strKey = mapShapeKeyKind(sh) == MAP_KEY_STR
  if strKey {
    helpStrHashFn()
    helpStrEqFn()
  }
  return helpMapGetFn(sh, miss, strKey)
}

// `[d]` when `emitMapGetOr` reads `recvIx[k] ?? defIx` through `__map_get_<row>__` with `d` as its
// miss, else []. A scalar value the `??`'s own atom kind `rk` widens is read inline.
export function mapGetOrHelperRoute(
  recvIx: i32,
  defIx: i32,
  fnIx: i32,
  rk: i32,
): i32[] {
  const wvk = mapRecvScalarKindInst(recvIx, fnIx)
  if wvk >= 0 && coalWidens(wvk, rk) { return [] }
  return mapGetOrHelperMiss(recvIx, defIx, fnIx)
}

// `[d]` when `recvIx[k] ?? defIx` can read through `__map_get_<row>__` with `d` as its miss: a
// mono-valued map with no null sentinel, and a default that lowers to one `i32.const d`. Else [].
function mapGetOrHelperMiss(recvIx: i32, defIx: i32, fnIx: i32): i32[] {
  if mapGetHelperShape(recvIx, fnIx) == 0 { return [] }
  const mt = mapRecvTyIn(recvIx, fnIx)
  if (
    mapTyValIsNulLitUnion(mt)
    || mapTyValIsNulBool(mt)
    || mapTyValIsNullUnit(mt)
  ) {
    return []
  }
  if mapTyValLitUnionTexts(mt).length > 0 { return [] }
  return mapDefaultI32Of(defIx, fnIx)
}

// `[v]` when `??` default `defIx` is written as the one `i32.const v`: an integer literal at
// `i32` (`emitNumLitNode`), or one negated at `i32` (`emitSignedNumLitAt`); else [].
function mapDefaultI32Of(defIx: i32, fnIx: i32): i32[] {
  const ix = unwrapParen(defIx)
  if ix < 0 { return [] }
  const d = nodeAt(ix)
  if d is NumLit {
    if numLitWidth(ix, fnIx) != "i32" { return [] }
    const v = memOffsetLexValue(numLitLexAt(ix, d.numText, "i32"))
    return if v < 0 { [] } else { [v as% i32] }
  }
  if !(d is Unary) || d.unOp != "-" || numLitTyWidth(ix, fnIx) != "i32" {
    return []
  }
  const inner = unwrapParen(d.unArg)
  if inner < 0 { return [] }
  const n = nodeAt(inner)
  if !(n is NumLit) { return [] }
  const v = memOffsetLexValue(numLitLexAt(inner, n.numText, "i32"))
  return if v < 0 { [] } else { [0 - (v as% i32)] }
}

// The mono-valued map shape a plain build reads `recvIx[k]` through `__map_get_<row>__` with, or
// 0 to probe at the site: `-O` keeps the read inline for binaryen, an i64 key and a valued map
// (an mv slot, `>= 0`) keep their own reads.
function mapGetHelperShape(recvIx: i32, fnIx: i32): i32 {
  if gOptimized != 0 || !exprMap(recvIx, fnIx) { return 0 }
  const sh0 = mapShapeOfExpr(recvIx, fnIx)
  if sh0 == -3 { return 0 }
  const sh = mapShapeFoldSet(sh0)
  if sh >= 0 || mapShapeKeyKind(sh) == MAP_KEY_I64 { return 0 }
  return sh
}

// The value half of `emitMapGet`, after `emitMapPrep`: the stored value on a hit, the rep's
// empty value on a miss. Leaves the probe's `entry` scratch slot as the probe set it.
export function emitMapGetTail(recvIx: i32, fnIx: i32) {
  if cmSlot >= 0 {
    // REF values: yield the NULLABLE element — the (ref null <elem>) vals slot on
    // a hit, `ref.null <elem>` on a miss — via the slot's valStash (same
    // blocktype-avoidance as `emitMapGetOr`). The `m[k]` type is `V | null`.
    const mslot = cmSlot
    pushMapScr(5) // entry
    fbIf(64)      // if (entry != 0), void
    pushMapVals()
    fbStructGet(cmValsWrap(), 0)
    pushMapScr(5) // entry
    fbI32Const(1)
    fbI32Bin(107) // i32.sub (entry - 1)
    fbArrayGet(cmValsBack())
    fbLocalSet(fnMvValStashLocal(mslot))
    fbElse()      // else
    // A miss yields the rep's empty value: 0.0 for an f64 or f32 map, 0 for an i64 map,
    // else `ref.null` for a ref (string/struct) value.
    if mvValKindAt(mslot) == "f64" { fbF64Const("0") }
    else if mvValKindAt(mslot) == "i64" { fbI64Const(0, 0) }
    else if mvValKindAt(mslot) == "f32" { fbF32Const("0") }
    else if mvValKindAt(mslot) == "v128" { fbV128ConstZero() }
    else { fbRefNull(mvValElemHeapOf(mslot)) }
    fbLocalSet(fnMvValStashLocal(mslot))
    fbEnd() // end
    fbLocalGet(fnMvValStashLocal(mslot))
    return 0
  }
  pushMapScr(5) // entry
  fbIf(127)     // if (entry != 0), i32 blocktype
  pushMapVals()
  fbStructGet(lTy(), 0)
  pushMapScr(5) // entry
  fbI32Const(1)
  fbI32Bin(107) // i32.sub (entry - 1)
  fbArrayGet(aTy())
  fbElse()      // else — a miss reads as the rep's empty value (`mapGetMissOf`)
  fbI32Const(mapGetMissOf(recvIx, fnIx))
  fbEnd()       // end
  return 0
}

// The i32 a mono-valued map read `recvIx[k]` yields on a miss. A niche-bearing value map (`K`/`K |
// null` atoms, `boolean`/`boolean | null`) reads its sentinel (`-1` litunion, `2` boolean), since a
// plain `0` would collide with a real member (atom id 0, or `false`); any other value reads 0.
export function mapGetMissOf(recvIx: i32, fnIx: i32): i32 {
  let gtMt = mapRecvTyIn(recvIx, fnIx)
  // A type parameter's value takes its sentinel from the instance's binding of it (D10360).
  if gtMt >= 0 && tyHasTyVar(gtMt) {
    const inst = nodeTyInOf(unwrapParen(recvIx), fnIx)
    if inst >= 0 && inst < T.tys.length && tyAt(inst) is TyMap { gtMt = inst }
  }
  if mapTyValIsNulLitUnion(gtMt) || mapTyValIsLitUnion(gtMt) { return 0 - 1 }
  if (
    mapTyValIsNulBool(gtMt)
    || mapTyValIsBool(gtMt)
    || mapTyValIsNullUnit(gtMt)
  ) {
    return 2
  }
  return 0
}

// Lower a bare map GET `m[k]` of a union-valued map (mv kind 2) onto `body`: the hit arm
// loads the stored `(ref $uBoxIdx)` box, the miss arm synthesizes the null-tagged box
// (`nullBoxTag()`, matching `emitUnionCoerce`'s `NullLit` arm) and recovers it non-null.
// Exported for `emitStartFnCode`'s identical module-scope miss arm.
export function emitMapGetUnionBox(recvIx: i32, keyIx: i32, fnIx: i32) {
  if emitMapPrep(recvIx, keyIx, fnIx) < 0 { return -1 }
  if cmSlot < 0 {
    return emitFail(
      "emitProgram: union-valued map read but no mv slot resolved",
    )
  }
  const mslot = cmSlot
  pushMapScr(5)                // entry
  fbIf(64)                     // if (entry != 0 → found), void
  pushMapVals()
  fbStructGet(cmValsWrap(), 0) // vals backing
  pushMapScr(5)                // entry
  fbI32Const(1)
  fbI32Bin(107)                // i32.sub (entry - 1)
  fbArrayGet(cmValsBack())     // the stored (ref null $uBoxIdx) slot read
  fbLocalSet(fnMvValStashLocal(mslot))
  fbElse()                     // else — a miss IS the read's `null`: the null-tagged box
  fbI32Rel(RS_TAG, nullBoxTag())
  fbRefNullNone()              // the payload slot is unread under the null tag
  fbStructNew(uBoxIdx)
  fbLocalSet(fnMvValStashLocal(mslot))
  fbEnd()                      // end (if)
  fbLocalGet(fnMvValStashLocal(mslot))
  fbRefAsNonNull()
  return 0
}

// Lower a bare scalar-valued map read `m[k]` directly into the union box: the tag and
// the payload are each chosen by their own conditional (two allocation sites, so
// Heap2Local scalarizes each — `opt-profile-design.md` §3 item 0), allocation-neutral on
// a hit and cheaper on a miss. No valStash local — the blocktype carries the value.
function emitMapGetScalarBox(
  recvIx: i32,
  keyIx: i32,
  atomKind: i32,
  fnIx: i32,
) {
  if emitMapPrep(recvIx, keyIx, fnIx) < 0 { return -1 }
  return emitMapGetScalarBoxTail(atomKind)
}

// `emitMapGetScalarBox` after its probe: the box of value-atom kind `atomKind`'s read.
export function emitMapGetScalarBoxTail(atomKind: i32) {
  const vbIdx = vbHeapIdxOfKind(atomKind)
  if vbIdx < 0 {
    return emitFail("emitProgram: scalar map read has no value-box type")
  }
  // ── the TAG: the value's atom on a hit, `null`'s atom on a miss ──
  pushMapScr(5) // entry
  fbIf(127)     // i32 blocktype
  fbI32Rel(RS_TAG, scalarTagOfKind(atomKind))
  fbElse()
  fbI32Rel(RS_TAG, nullBoxTag())
  fbEnd()
  // ── the PAYLOAD: the boxed value on a hit, a null ref on a miss ──
  pushMapScr(5) // entry
  fbIf(110)     // 0x6e anyref blocktype
  pushMapScalarHit()
  fbStructNew(vbIdx)
  fbElse()
  fbRefNullNone()
  fbEnd()
  fbStructNew(uBoxIdx)
  return 0
}

// Push the raw scalar a probed scalar-valued map holds at its found entry — the hit arm of
// every scalar read. Valid only under an `entry != 0` test, after `emitMapPrep`.
function pushMapScalarHit() {
  if cmSlot >= 0 {
    pushMapVals()
    fbStructGet(cmValsWrap(), 0)
    pushMapScr(5)
    fbI32Const(1)
    fbI32Bin(107) // i32.sub (entry - 1)
    fbArrayGet(cmValsBack())
  } else {
    // The mono i32 map: the vals array is the shared `aTypeIdx` backing.
    pushMapVals()
    fbStructGet(lTy(), 0)
    pushMapScr(5)
    fbI32Const(1)
    fbI32Bin(107)
    fbArrayGet(aTy())
  }
}

// `m[k] ?? d` over a null-free scalar-valued map with a NULLABLE default: the result is still
// `S | null`, whose rep is the box, so a hit boxes the stored scalar and a miss delivers `d`
// as the box. After `emitMapPrep`; `ak` is the value's atom kind (D2254).
function emitMapGetOrScalarBox(ak: i32, defIx: i32, fnIx: i32) {
  const vb = vbHeapIdxOfKind(ak)
  if vb < 0 {
    return emitFail("emitProgram: scalar map read has no value-box type")
  }
  pushMapScr(5)          // entry
  fbOpenIf()             // 0x04 if
  fbValtype("union", -1) // result blocktype: the union box `(ref $uBox)`
  fbI32Rel(RS_TAG, scalarTagOfKind(ak))
  pushMapScalarHit()
  fbStructNew(vb)
  fbStructNew(uBoxIdx)
  fbElse()
  if (
    emitUnionBoxOwed(
      scalarAtomNameOfKind(ak) + " | null",
      mkNullableTyOf(primTyIxOfName(scalarAtomNameOfKind(ak))),
      defIx,
      fnIx,
    )
    < 0
  ) {
    return -1
  }
  fbEnd()
  return 0
}

// The key of the read `coalMapRecvOf` names a receiver of, else -1.
function coalMapKeyOf(e: BinExpr): i32 {
  const r = nodeAt(unwrapParen(e.binLeft))
  if r is Index { return r.idxIndex }
  return coalCallKeyOf(unwrapParen(e.binLeft))
}

// The argument of node `ix` read as a one-argument call, else -1.
function coalCallKeyOf(ix: i32): i32 {
  const r = nodeAt(ix)
  if r is Call && r.callArgs.length == 1 { return r.callArgs[0] }
  return -1
}

// `m[k] ?? d` over a map whose value boxes as scalar kind `ak`, where `d` is another arm of the
// result's union: a hit boxes the stored scalar under its own arm's tag, a miss boxes `d`.
// 1 handled, -1 failed (D4643).
function emitMapGetOrScalarJoin(
  e: BinExpr,
  ak: i32,
  exprIx: i32,
  fnIx: i32,
): i32 {
  const recvIx = coalMapRecvOf(e)
  const keyIx = coalMapKeyOf(e)
  // The union the join's result boxes into is the one its default is delivered into
  // (`boxDstNameAt`).
  const joinN = boxDstNameAt(e.binRight, fnIx)
  if joinN == "" {
    return emitFailAt(
      "emitProgram: `??` joins a nullable value into a union the checker recorded no row for",
      exprIx,
    )
  }
  const vb = vbHeapIdxOfKind(ak)
  if (
    vb < 0
    || scalarAtomNameOfKind(ak) == ""
    || !unionTyHasBoxKind(boxDstTyOf(e.binRight, fnIx), ak)
  ) {
    return emitFailAt(
      "emitProgram: `??` joins a nullable value into a union with no arm for the value's own type",
      exprIx,
    )
  }
  if emitMapPrep(recvIx, keyIx, fnIx) < 0 { return -1 }
  pushMapScr(5)    // entry
  fbIfRef(uBoxIdx) // 0x04 if, (ref $uBox) blocktype — the result's rep
  fbI32Rel(RS_TAG, scalarTagOfKind(ak))
  pushMapScalarHit()
  fbStructNew(vb)
  fbStructNew(uBoxIdx)
  fbElse()         // 0x05 else — a miss → the default, boxed
  if (emitUnionBoxAtRecord("", -1, e.binRight, fnIx) < 0) { return -1 }
  fbEnd()
  return 1
}

// Lower a map HAS `m.has(k)` / `k in m` onto `body`: probe, push 1 if found else 0.
function emitMapHas(recvIx: i32, keyIx: i32, fnIx: i32) {
  if emitMapRecvKey(recvIx, keyIx, fnIx) < 0 { return -1 }
  return mapHasTail()
}

// After a map has's receiver and key on the stack: the probe, then its hit flag.
export function mapHasTail(): i32 {
  fbLocalSet(cmKeyLocal()) // the target key
  setMapRef()
  if emitMapProbe(false, false) < 0 { return -1 }
  return pushMapHitFlag()
}

// Push the current probe's hit flag, `entry != 0`. Valid after `emitMapPrep`.
function pushMapHitFlag() {
  pushMapScr(5) // entry
  fbI32Const(0)
  fbI32Bin(71)  // 0x47 i32.ne
  return 0
}

// `print(m[k])` over a bare scalar-valued map read (D2466): the stored value through its own
// sink on a hit, the word `null` on a miss. The probe's hit flag is the read's null, so no box
// is built. `k` is `mapReadScalarBoxKind`'s atom kind.
function emitPrintScalarMapRead(argIx: i32, k: i32, fnIx: i32) {
  const e = nodeAt(unwrapParen(argIx))
  if e is Index {
    if emitMapPrep(e.idxArr, e.idxIndex, fnIx) < 0 { return -1 }
    pushMapScr(5) // entry
    fbIf(64)      // void
    pushMapScalarHit()
    if emitPrintScalarSink(k) < 0 { return -1 }
    fbElse()
    emitPrintNullWord()
    fbEnd()
    return 0
  }
  return emitFail(
    "emitProgram: scalar map-read print over an operand that is not an index read",
  )
}

// How `==`/`!=` node `e` compares a bare scalar-valued map read (D2466): both reads of one kind
// (`pair`), the read against a plain scalar (`read`) or against a value-union box holding `null`
// (`box`), or `none`. `smRead` is the read's side, `smKind` its kind. No operand is a `null` literal.
export type ScalarMapEqArm = "none" | "pair" | "read" | "box"

export type ScalarMapEqPlan = {
  smArm: ScalarMapEqArm,
  smKind: i32,
  smRead: i32,
  smOther: i32,
}

export function scalarMapEqPlanOf(e: BinExpr, fnIx: i32): ScalarMapEqPlan {
  const none: ScalarMapEqPlan = {
    smArm: "none",
    smKind: -1,
    smRead: -1,
    smOther: -1,
  }
  const kl = mapReadScalarBoxKind(e.binLeft, fnIx)
  const kr = mapReadScalarBoxKind(e.binRight, fnIx)
  if kl < 0 && kr < 0 { return none }
  if nodeAt(unwrapParen(e.binLeft)) is NullLit { return none }
  if nodeAt(unwrapParen(e.binRight)) is NullLit { return none }
  if kl >= 0 && kr >= 0 {
    if kl != kr { return none }
    const l = nodeAt(unwrapParen(e.binLeft))
    const r = nodeAt(unwrapParen(e.binRight))
    if !(l is Index) || !(r is Index) { return none }
    return { smArm: "pair", smKind: kl, smRead: e.binLeft, smOther: e.binRight }
  }
  const readIx = if kl >= 0 { e.binLeft } else { e.binRight }
  const otherIx = if kl >= 0 { e.binRight } else { e.binLeft }
  const k = if kl >= 0 { kl } else { kr }
  if !(nodeAt(unwrapParen(readIx)) is Index) { return none }
  const plan: ScalarMapEqPlan = {
    smArm: "read",
    smKind: k,
    smRead: readIx,
    smOther: otherIx,
  }
  if exprUnion(otherIx, fnIx) && !eqAtomOperandOk(otherIx, fnIx) {
    if !scalarMapBoxEqOk(otherIx, k, fnIx) { return none }
    return { smArm: "box", smKind: k, smRead: readIx, smOther: otherIx }
  }
  // A numeric literal widens to a wide read's own width (`emitUnionEqOther`); any other
  // operand must already have the read's atom kind.
  const atom = scalarAtomNameOfKind(k)
  const ok = unionEqAtomKindOf(
    otherIx,
    -1,
    mkNullableTyOf(primTyIxOfName(atom)),
    fnIx,
  )
    == k
  if ok || k >= 3 && nodeAt(unwrapParen(otherIx)) is NumLit { return plan }
  return none
}

// Whether value-union box `boxIx` meets a scalar map read of kind `k`: re-readable, no map read
// of its own (its probe would overwrite this one's entry), and holding `null` and the kind.
function scalarMapBoxEqOk(boxIx: i32, k: i32, fnIx: i32): boolean {
  if !unionEqOperandOk(boxIx) { return false }
  if nodeAt(unwrapParen(boxIx)) is Index { return false }
  const bxs = msSetOfTy(unionBoxTyOfRead(boxIx, fnIx))
  if !exprUnion(boxIx, fnIx) || bxs < 0 || !msHasNull(bxs) { return false }
  return scalarAtomNameOfKind(k) != "" && msSetHasPrimKind(bxs, k)
}

// `==`/`!=` node `e` by its scalar map read plan `p`: a miss is `null`, so it equals only a
// `null`; the payload compare is `and`ed with the probe's hit flag, and both operands evaluate
// once, left to right. 0, or -1 failed.
function emitScalarMapReadEq(e: BinExpr, p: ScalarMapEqPlan, fnIx: i32): i32 {
  const rd = nodeAt(unwrapParen(p.smRead))
  if !(rd is Index) {
    return emitFail(
      "emitProgram: internal: eqRouteOf and its writer disagree (map read is no index read)",
    )
  }
  const rc = match p.smArm {
    "pair" => emitScalarMapReadPairEq(rd, p.smOther, p.smKind, fnIx)
    "read" => emitScalarMapReadOtherEq(rd, p.smOther, p.smKind, p.smRead == e.binLeft, fnIx)
    "box" => emitScalarMapReadBoxEq(rd.idxArr, rd.idxIndex, p.smOther, p.smKind, fnIx)
    "none" => emitFail(
      "emitProgram: internal: eqRouteOf and its writer disagree (scalar map plan none)",
    )
  }
  if rc < 0 { return -1 }
  if e.binOp == "!=" { fbI32Eqz() }
  return 0
}

// Both operands are scalar map reads of kind `k`: equal when both miss, or both hit with equal
// values. The right read's probe is emitted once per arm of the left's hit test.
function emitScalarMapReadPairEq(l: Index, rIx: i32, k: i32, fnIx: i32): i32 {
  const r = nodeAt(unwrapParen(rIx))
  if !(r is Index) {
    return emitFail(
      "emitProgram: internal: eqRouteOf and its writer disagree (map pair right is no index read)",
    )
  }
  if emitMapPrep(l.idxArr, l.idxIndex, fnIx) < 0 { return -1 }
  pushMapScr(5) // left entry
  fbIf(127)     // i32 result
  pushMapScalarHit()
  if emitMapPrep(r.idxArr, r.idxIndex, fnIx) < 0 { return -1 }
  if emitMapGetTail(r.idxArr, fnIx) < 0 { return -1 }
  fbI32Bin(atomEqOpcodeOfKind(k))
  pushMapHitFlag()
  fbI32Bin(113) // 0x71 i32.and
  fbElse()
  if emitMapPrep(r.idxArr, r.idxIndex, fnIx) < 0 { return -1 }
  pushMapHitFlag()
  fbI32Eqz()
  fbEnd()
  return 0
}

// Map read `rd` of kind `k` against plain scalar `otherIx`, the read written first where
// `readLeft`.
function emitScalarMapReadOtherEq(
  rd: Index,
  otherIx: i32,
  k: i32,
  readLeft: boolean,
  fnIx: i32,
): i32 {
  if readLeft {
    if emitMapPrep(rd.idxArr, rd.idxIndex, fnIx) < 0 { return -1 }
    pushMapHitFlag()
    if emitMapGetTail(rd.idxArr, fnIx) < 0 { return -1 }
    if emitUnionEqOther(otherIx, k, fnIx) < 0 { return -1 }
    fbI32Bin(atomEqOpcodeOfKind(k))
    fbI32Bin(113) // 0x71 i32.and
    return 0
  }
  if emitUnionEqOther(otherIx, k, fnIx) < 0 { return -1 }
  if emitMapPrep(rd.idxArr, rd.idxIndex, fnIx) < 0 { return -1 }
  if emitMapGetTail(rd.idxArr, fnIx) < 0 { return -1 }
  fbI32Bin(atomEqOpcodeOfKind(k))
  pushMapHitFlag()
  fbI32Bin(113) // 0x71 i32.and
  return 0
}

// The read against a value-union box `u` (`scalarMapBoxEqOk`): a hit equals `u` holding the same
// scalar, a miss equals `u` holding `null`. `u` is re-read per arm.
function emitScalarMapReadBoxEq(
  recvIx: i32,
  keyIx: i32,
  boxIx: i32,
  k: i32,
  fnIx: i32,
): i32 {
  if emitMapPrep(recvIx, keyIx, fnIx) < 0 { return -1 }
  pushMapScr(5)           // entry
  fbIf(127)               // i32 result
  if emitExpr(boxIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 0) // tag
  fbI32Rel(RS_TAG, scalarTagOfKind(k))
  fbI32Bin(70)            // 0x46 i32.eq
  fbIf(127)
  pushMapScalarHit()
  if emitExpr(boxIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // payload
  if emitUnionPayloadUnbox(k) < 0 { return -1 }
  fbI32Bin(atomEqOpcodeOfKind(k))
  fbElse()
  fbI32Const(0)
  fbEnd()
  fbElse()
  if emitExpr(boxIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 0) // tag
  fbI32Rel(RS_TAG, nullBoxTag())
  fbI32Bin(70)            // 0x46 i32.eq
  fbEnd()
  return 0
}

// Push whether entry `iL` of the `live` array in `liveL` is live: `live[i] != 0` in a module
// that deletes, else the constant 1 — nothing else writes `live`, so it stays empty there.
function pushMapEntryLive(liveL: i32, iL: i32) {
  if !gMapDeletes {
    fbI32Const(1)
    return 0
  }
  fbLocalGet(liveL)
  fbLocalGet(iL)
  fbArrayGet(aTy())
  fbI32Const(0)
  fbI32Bin(71) // 0x47 i32.ne
  return 0
}

// Lower `m.keys()` onto `body`, leaving a fresh string list (`$mkListIdx`) of the map's
// live keys in insertion order — the ordered keys/live arrays carry tombstoned entries
// after a delete, so only `live[i] != 0` keys are copied. Uses the 6-slot `mapKeysBase`
// frame; the receiver, a simple binding, is re-emitted per field rather than cached.
function emitMapKeys(recvIx: i32, fnIx: i32) {
  if !exprMap(recvIx, fnIx) {
    return emitFail("emitProgram: .keys() receiver is not a map")
  }
  if !fnUses.mapKeys {
    return emitFail("emitProgram: .keys() scratch frame not reserved")
  }
  const shape0 = mapShapeOfExpr(recvIx, fnIx)
  if shape0 == -3 { return failMapValueType() }
  // A Set's keys() runs on the mono machinery of its own KEY rep.
  const shape = mapShapeFoldSet(shape0)
  // The KEY rep, from the mono sentinel OR the mv slot's own column — the same question
  // `cmKeyKind` asks. A `{[i32]: string}`'s `.keys()` is an `i32[]` even though its shape
  // is an mv slot, so this cannot key off the sentinel alone.
  const keyK = mapShapeKeyKind(shape)
  const mapTy = mapTypeIdxOf(shape)
  // The KEY rep's list wrapper / backing, and — since the builder's frame slots are
  // typed per rep — an integer frame's own out/src slots for an integer-keyed map.
  let keysWrap = -1
  let keysBack = -1
  let outBackL = mapKeysBase + 0
  let keysBackL = mapKeysBase + 1
  if keyK == MAP_KEY_I32 {
    keysWrap = lTy()
    keysBack = aTy()
    outBackL = mapI32KeyLocal(2)
    keysBackL = mapI32KeyLocal(3)
  } else if keyK == MAP_KEY_I64 {
    keysWrap = il64Ty()
    keysBack = ia64Ty()
    outBackL = mapI64KeyLocal(2)
    keysBackL = mapI64KeyLocal(3)
  } else {
    keysWrap = mkListTy()
    keysBack = mkArrTy()
  }
  const liveL = mapKeysBase + 2
  const iL = mapKeysBase + 3
  const jL = mapKeysBase + 4
  const countL = mapKeysBase + 5
  // keysBack = recv.keys.backing  (field 0 = keys wrapper, its field 0 = backing)
  if emitExpr(recvIx, fnIx) < 0 { return -1 }
  fbStructGet(mapTy, 0)
  fbStructGet(keysWrap, 0)
  fbLocalSet(keysBackL)
  // live = recv.live  (field 2)
  if emitExpr(recvIx, fnIx) < 0 { return -1 }
  fbStructGet(mapTy, 2)
  fbLocalSet(liveL)
  // count = recv.count  (field 4 — entries INCLUDING tombstones)
  if emitExpr(recvIx, fnIx) < 0 { return -1 }
  fbStructGet(mapTy, 4)
  fbLocalSet(countL)
  // out = array.new_default <keysBacking> count (sized at count; `len` set to live j)
  fbLocalGet(countL)
  fbArrayNewDefault(keysBack)
  fbLocalSet(outBackL)
  // j = 0 ; i = 0
  fbI32Const(0)
  fbLocalSet(jL)
  fbI32Const(0)
  fbLocalSet(iL)
  // loop { if i >= count {} else { if live[i] != 0 { out[j]=keys[i]; j++ } ; i++ ; br } }
  fbLoop(64)
  fbLocalGet(iL)
  fbLocalGet(countL)
  fbI32Bin(78) // 0x4e i32.ge_s (i >= count → done)
  fbIf(64)
  // then: done (empty)
  fbElse()
  // if live[i] != 0  (constant true in a module that never deletes, whose `live` stays empty)
  pushMapEntryLive(liveL, iL)
  fbIf(64)
  // out[j] = keys[i]
  fbLocalGet(outBackL)
  fbLocalGet(jL)
  fbLocalGet(keysBackL)
  fbLocalGet(iL)
  fbArrayGet(keysBack)
  fbArraySet(keysBack)
  // j = j + 1
  fbLocalGet(jL)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  fbLocalSet(jL)
  fbEnd() // end (live if)
  // i = i + 1
  fbLocalGet(iL)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  fbLocalSet(iL)
  fbBr(1) // → loop header (else=0, loop=1)
  fbEnd() // end (ge_s if/else)
  fbEnd() // end (loop)
  // wrapper = struct.new <keysWrapper> (out, len=j, cap=count)
  fbLocalGet(outBackL)
  fbLocalGet(jL)
  fbLocalGet(countL)
  fbStructNew(keysWrap)
  return 0
}

// Lower `m.values()` over a mono i32 map onto `body`, leaving a fresh i32 list
// (`$lTypeIdx`) of the map's live values in insertion order — the value analogue of
// `emitMapKeys`, reading the vals list instead of keys and skipping tombstoned entries.
// Other value types iterate via `for v in m.values()`; the bound-list form is i32-only.
function emitMapValues(recvIx: i32, fnIx: i32) {
  if !exprMap(recvIx, fnIx) {
    return emitFail("emitProgram: .values() receiver is not a map")
  }
  const shape = mapShapeOfExpr(recvIx, fnIx)
  // A SET's `.values()` yields its ELEMENTS (its keys), built by `emitMapKeys` — for
  // both key reps, which is why the Set sentinel is a PAIR.
  if shape == -2 || shape == -5 || shape == -7 {
    return emitMapKeys(recvIx, fnIx)
  }
  if shape == -3 { return failMapValueType() }
  if !fnUses.mapVals {
    return emitFail("emitProgram: .values() scratch frame not reserved")
  }
  const mapTy = mapTypeIdxOf(shape)
  const valsWrap = mvValsWrapOf(shape)
  const valsBack = mvValsBackOf(shape)
  // Frame: a MONO map's self-contained `mapValsBase` (all i32-backed), an mv map's per-slot
  // output backing + the mv frame's `valsBk` source + the key-list frame's live/i/j/count.
  let outBackL = mapValsBase + 0
  let valsBackL = mapValsBase + 1
  let liveL = mapValsBase + 2
  let iL = mapValsBase + 3
  let jL = mapValsBase + 4
  let countL = mapValsBase + 5
  if shape >= 0 {
    outBackL = fnMvValsOutLocal(shape)
    valsBackL = fnMvValsBkLocal(shape)
    liveL = mapKeysBase + 2
    iL = mapKeysBase + 3
    jL = mapKeysBase + 4
    countL = mapKeysBase + 5
  }
  // valsBack = recv.vals.backing  (field 1 = vals wrapper, its field 0 = backing)
  if emitExpr(recvIx, fnIx) < 0 { return -1 }
  fbStructGet(mapTy, 1)
  fbStructGet(valsWrap, 0)
  fbLocalSet(valsBackL)
  // live = recv.live  (field 2)
  if emitExpr(recvIx, fnIx) < 0 { return -1 }
  fbStructGet(mapTy, 2)
  fbLocalSet(liveL)
  // count = recv.count  (field 4 — entries INCLUDING tombstones)
  if emitExpr(recvIx, fnIx) < 0 { return -1 }
  fbStructGet(mapTy, 4)
  fbLocalSet(countL)
  // out = array.new_default <valsBack> count
  fbLocalGet(countL)
  fbArrayNewDefault(valsBack)
  fbLocalSet(outBackL)
  fbI32Const(0)
  fbLocalSet(jL)
  fbI32Const(0)
  fbLocalSet(iL)
  // loop { if i >= count {} else { if live[i] != 0 { out[j]=vals[i]; j++ } ; i++ ; br } }
  fbLoop(64)
  fbLocalGet(iL)
  fbLocalGet(countL)
  fbI32Bin(78) // i32.ge_s
  fbIf(64)
  fbElse()
  pushMapEntryLive(liveL, iL)
  fbIf(64)
  // out[j] = vals[i]
  fbLocalGet(outBackL)
  fbLocalGet(jL)
  fbLocalGet(valsBackL)
  fbLocalGet(iL)
  fbArrayGet(valsBack)
  fbArraySet(valsBack)
  fbLocalGet(jL)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(jL)
  fbEnd() // end (live if)
  fbLocalGet(iL)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(iL)
  fbBr(1)
  fbEnd() // end (ge_s if/else)
  fbEnd() // end (loop)
  // wrapper = struct.new <valsWrap> (out, len=j, cap=count)
  fbLocalGet(outBackL)
  fbLocalGet(jL)
  fbLocalGet(countL)
  fbStructNew(valsWrap)
  return 0
}

// Resize the `index` when its occupancy (count / cap) crosses 1/2: a `call` into the
// shared `__map_resize__` helper returns the doubled+rehashed backing (or the old one
// when the load factor is fine), stored back unconditionally — only the receiver
// `struct.get`s and the final `struct.set` are shape-typed; the entry lists are untouched.
function emitMapResize() {
  pushMapRef() // the struct.set receiver
  pushMapIndex()
  if cmKeyInt() {
    pushMapCount()
    fbCall(helpMapResizeI32Fn())
  } else {
    pushMapHashes()
    pushMapLive()
    pushMapCount()
    pushMapSize()
    fbCall(helpMapResizeFn())
  }
  fbStructSet(cmMapTy(), 3) // struct.set field 3: index
  return 0
}

// Lower `m.clear()` onto `body`: the map keeps its index, backings and capacity, so a refill
// up to the old size allocates nothing. The index is zeroed, the key and value refs dropped so
// they can be collected, and the entry counts reset. A never-written map's backings are the
// shared empty ones; every fill over them has length 0, so none is written.
function emitMapClear(recvIx: i32, fnIx: i32) {
  const mshape0 = mapShapeOfExpr(recvIx, fnIx)
  if mshape0 == -3 { return failMapValueType() }
  if pushMapRecvRef(recvIx, fnIx) < 0 { return -1 }
  cmSlot = mapShapeFoldSet(mshape0)
  const mslot = cmSlot
  setMapRef()
  pushMapIndex()
  fbI32Const(0)
  fbI32Const(0)
  pushMapIndex()
  fbArrayLen()
  fbArrayFill(aTy()) // index[0 .. len) = 0, every slot free
  if !cmKeyInt() {
    pushMapKeysBacking()
    fbI32Const(0)
    fbRefNull(sTy())
    pushMapKeysLen()
    fbArrayFill(cmKeysBack())
  }
  if mslot >= 0 && mvScalarValKind(mslot) == null {
    pushMapValsBacking()
    fbI32Const(0)
    fbRefNull(mvValElemHeapOf(mslot))
    pushMapValsLen()
    fbArrayFill(cmValsBack())
  }
  pushMapKeys()
  fbI32Const(0)
  fbStructSet(cmKeysWrap(), 1) // keys.len = 0
  pushMapVals()
  fbI32Const(0)
  fbStructSet(cmValsWrap(), 1) // vals.len = 0
  pushMapRef()
  fbI32Const(0)
  fbStructSet(cmMapTy(), 4) // count = 0
  pushMapRef()
  fbI32Const(0)
  fbStructSet(cmMapTy(), 5) // size = 0
  return 0
}

// Lower a map delete `m.delete(k): boolean` onto `body`: probe to the entry; a miss pushes 0, a
// hit tombstones it (`live[entry-1] = 0`, its slot and sequence kept), drops its key and value
// refs so the payload can be collected, decrements `size`, and pushes 1. A delete never moves an
// entry, so a walk over the same map stays in step; storage is reclaimed on insert (D2315).
function emitMapDelete(recvIx: i32, keyIx: i32, fnIx: i32) {
  if emitMapPrepFor(recvIx, keyIx, fnIx, true) < 0 { return -1 }
  const mslot = cmSlot
  // if entry == 0 { 0 } else { tombstone ; drop refs ; size-- ; 1 }
  pushMapScr(5) // entry
  fbIf(127)     // if (entry != 0), 0x7f i32 blocktype
  // an integer key's pair: entry = -1, a probe marker never hit again (a string key's slot keeps
  // its entry, whose `live` below is what the probe tests)
  if cmKeyInt() {
    pushMapIndex()
    pushMapSlotPos(1)
    fbI32Const(0 - 1)
    fbArraySet(aTy())
  }
  // live[entry-1] = 0  (tombstone; keeps the entry's insertion-order position)
  pushMapLive()
  pushMapScr(5)     // entry
  fbI32Const(1)
  fbI32Bin(107)     // i32.sub (entry - 1)
  fbI32Const(0)
  fbArraySet(aTy()) // array.set live[entry-1] = 0
  // keys.backing[entry-1] = null  (a string key; an integer key holds no payload)
  if !cmKeyInt() {
    pushMapKeysBacking()
    pushMapScr(5)
    fbI32Const(1)
    fbI32Bin(107)
    fbRefNull(sTy())
    fbArraySet(cmKeysBack())
  }
  // vals.backing[entry-1] = null  (a ref value; a scalar value holds no payload)
  if mslot >= 0 && mvScalarValKind(mslot) == null {
    pushMapValsBacking()
    pushMapScr(5)
    fbI32Const(1)
    fbI32Bin(107)
    fbRefNull(mvValElemHeapOf(mslot))
    fbArraySet(cmValsBack())
  }
  // size = size - 1
  pushMapRef()              // mapRef
  pushMapSize()
  fbI32Const(1)
  fbI32Bin(107)             // i32.sub
  fbStructSet(cmMapTy(), 5) // struct.set field 5: size
  // result = 1: a key is removed.
  fbI32Const(1)
  fbElse() // else
  // result = 0 (absent)
  fbI32Const(0)
  fbEnd() // end (entry if)
  return 0
}

// How a map set writes its value `valIx` into the vals of mv slot `mslot` (atom-valued `atomVal`,
// `boolean | null`-valued `nulBoolVal`): coerced to a scalar element, boxed into a union, coerced
// to a record arm, a `null` as its sentinel, an atom widened to its text, or `plain` as itself.
export type MapSetValArm = "scalar"
  | "union"
  | "variant"
  | "atomNull"
  | "boolNull"
  | "boolNulNone"
  | "atomStr"
  | "plain"
export function mapSetValArmOf(
  valIx: i32,
  fnIx: i32,
  mslot: i32,
  atomVal: boolean,
  nulBoolVal: boolean,
): MapSetValArm {
  if mvScalarValKind(mslot) != null { return "scalar" }
  if mslot >= 0 && mvValKindAt(mslot) == "union" { return "union" }
  // A non-null arm-valued map takes every value through `emitVariantCoerce`, a join included,
  // as an arm-typed local does; the coerce owns the narrowed unbox (D4639).
  if mslot >= 0 && mvValIsRecord(mslot) && !mvSlotNullable(mslot) {
    if mvValVariantOf(mslot) >= 0 { return "variant" }
  }
  const vn = nodeAt(unwrapParen(valIx))
  if atomVal && vn is NullLit { return "atomNull" }
  if nulBoolVal {
    if vn is NullLit { return "boolNull" }
    if exprIsNulNone(valIx, fnIx) { return "boolNulNone" }
  }
  // A literal-union atom into a string-valued map widens to its member string: the vals element
  // is a string ref while the atom's rep is an i32 id.
  if !atomVal && exprIsLitAtom(valIx, fnIx) { return "atomStr" }
  return "plain"
}

// The value of a map set at its vals element, by `mapSetValArmOf`, evaluated once and left on the
// stack: a `null` into an atom-valued map is the `-1` sentinel, into a `boolean | null` one the `2`.
// An inner map op clobbers `cmSlot`, so callers re-pin it.
function emitMapSetValExpr(
  valIx: i32,
  fnIx: i32,
  mslot: i32,
  atomVal: boolean,
  nulBoolVal: boolean,
) {
  return match mapSetValArmOf(valIx, fnIx, mslot, atomVal, nulBoolVal) {
    "scalar" => {
      const svk = mvScalarValKind(mslot)
      if svk == null {
        return emitFail("emitProgram: internal: scalar map value with no kind")
      }
      emitScalarValue(valIx, fnIx, svk)
    }
    "union" => {
      if mslot < 0 || mslot >= mvValName.length {
        return emitFail(
          "emitProgram: internal: union map value with no mv slot",
        )
      }
      emitUnionBoxOwed(mvValName[mslot], mvValTyIxAt(mslot), valIx, fnIx)
    }
    "variant" => emitVariantCoerce(mvValVariantOf(mslot), valIx, fnIx)
    "atomNull" => {
      fbI32Const(0 - 1)
      0
    }
    "boolNull" => {
      fbI32Const(2)
      0
    }
    "boolNulNone" => {
      if emitNulNoneForEffect(valIx, fnIx) < 0 { return -1 }
      fbI32Const(2)
      0
    }
    "atomStr" => emitStrValue(valIx, fnIx)
    "plain" => {
      const mvArmOwed = narrowedArmNeedsUnbox(valIx, fnIx)
      if emitExpr(valIx, fnIx) < 0 { return -1 }
      // The narrowed-arm unbox at the map-value boundary (D1031) targets the vals element's own
      // heap, the one a nullable slot's `ref.null` seed reads.
      if mvArmOwed && mslot >= 0 {
        emitNarrowedArmUnboxTo(mvValElemHeapOf(mslot), valIx, fnIx)
      }
      0
    }
  }
}

// `local.set` / `local.get` of the set-value stash: the mv slot's typed valStash, or the
// mono frame's dedicated slot 14. Slot 14 is reserved — no probe / push / grow / resize
// machinery touches it, so the value survives from its write through the overwrite or
// append store; slot 3 (the pushVal stash) is also the probe slot and cannot hold one.
function setMapSetValStash(mslot: i32) {
  if msHelp {
    fbLocalSet(2)
    return 0
  }
  if mslot >= 0 {
    fbLocalSet(fnMvValStashLocal(mslot))
    return 0
  }
  setMapScr(14)
  return 0
}
function pushMapSetValStash(mslot: i32) {
  if msHelp {
    fbLocalGet(2)
    return 0
  }
  if mslot >= 0 {
    fbLocalGet(fnMvValStashLocal(mslot))
    return 0
  }
  pushMapScr(14)
  return 0
}

// Lower a map set `m[k] = v` (also `m.set(k, v)`, and `s.add(k)` via `valConst1 = true`):
// probe; a hit overwrites, a miss appends and maybe resizes. Receiver, key and value are
// all evaluated before the probe and before landing in scratch locals, so `m[k] = (m[k]
// ?? 0) + 1` probes the untouched map and a nested map op cannot clobber the shared frame.
function emitMapSetV(
  recvIx: i32,
  keyIx: i32,
  valIx: i32,
  fnIx: i32,
  valConst1: boolean,
) {
  const atomVal = mapSetAtomVal(recvIx, fnIx)
  const nulBoolVal = mapSetNulBoolVal(recvIx, fnIx)
  if !valConst1 && mapSetRefIntoMono(recvIx, valIx, fnIx) {
    return emitFail("emitProgram: map values must be i32 / boolean")
  }
  const mset = mapRecvIsSet(recvIx, fnIx)
  // Receiver + key onto the operand stack; `cmSlot` pinned to the shape.
  if emitMapRecvKey(recvIx, keyIx, fnIx) < 0 { return -1 }
  const mslot = cmSlot
  // VALUE next — evaluated ONCE, while the map is still untouched and recv/key are
  // still stack-parked — then stashed. Only probe/store machinery runs after this.
  if valConst1 {
    fbI32Const(1) // Set value: constant boolean true
  } else {
    if (emitMapSetValExpr(valIx, fnIx, mslot, atomVal, nulBoolVal) < 0) {
      return -1
    }
  }
  // A set whose value the assignment yields keeps it in the value stash.
  return mapSetTail(mslot, mset, asgParkWanted && !valConst1 && !msHelp)
}

// After a map set's receiver, key and value: the op context re-pinned to folded shape `mslot`
// (an inner map op in the value clobbers it), then the store, through the shape's helper where
// its row reserved one. `mset` a Set's store; `park` keeps the value for the assignment.
export function mapSetTail(mslot: i32, mset: boolean, park: boolean): i32 {
  cmSlot = mslot
  // [mapRef, key, value] are the shape's store helper's params, in order; a Set has its own.
  const setFn = mapSetFnOf(if mset { mapShapeOfSet(mslot) } else { mslot })
  if setFn >= 0 {
    if park { fbLocalTee(mapSetValStashLocal(mslot)) }
    fbCall(setFn)
    if park { mapSetParked(mslot) }
    return 0
  }
  if setMapSetValStash(mslot) < 0 { return -1 }
  fbLocalSet(cmKeyLocal()) // the target key (popped off the stack)
  setMapRef()              // mapRef
  const stRc = emitMapSetStore(mslot, mset)
  if park { mapSetParked(mslot) }
  return stRc
}

// Whether map receiver `recvIx` holds atoms (`{[string]: K}`, `K` a literal union, or `K | null`),
// each value its interned id on the mono map.
export function mapSetAtomVal(recvIx: i32, fnIx: i32): boolean {
  const mt = mapRecvTyIn(recvIx, fnIx)
  return mapTyValIsLitUnion(mt) || mapTyValIsNulLitUnion(mt)
}

// Whether map receiver `recvIx` holds `boolean | null` or `null` on the mono i32 niche, whose
// `null` is the `2` sentinel (D4671).
export function mapSetNulBoolVal(recvIx: i32, fnIx: i32): boolean {
  const mt = mapRecvTyIn(recvIx, fnIx)
  return mapTyValIsNulBool(mt) || mapTyValIsNullUnit(mt)
}

// Whether a set of `valIx` into receiver `recvIx` would store a reference into a mono map's i32
// vals, which no wasm validates: such a set is refused, never written.
export function mapSetRefIntoMono(recvIx: i32, valIx: i32, fnIx: i32): boolean {
  if mapSetAtomVal(recvIx, fnIx) || mapShapeOfExpr(recvIx, fnIx) >= 0 {
    return false
  }
  return exprString(valIx, fnIx)
    || exprStruct(valIx, fnIx)
    || exprArray(valIx, fnIx)
    || exprRefArray(valIx, fnIx)
    || exprStringArray(valIx, fnIx)
}

// Whether map receiver `recvIx` is a Set, whose store leaves its never-read `vals` alone on
// helper rows of its own.
export function mapRecvIsSet(recvIx: i32, fnIx: i32): boolean {
  return mapShapeIsSet(mapShapeOfExpr(recvIx, fnIx))
}

// The local a set's value stash is, outside a store helper: an mv slot's own, else the map
// frame's slot 14.
function mapSetValStashLocal(mslot: i32): i32 {
  if mslot >= 0 { return fnMvValStashLocal(mslot) }
  return mapScratchBase + 14
}

// Records the set's value stash as the parked value of the assignment that asked for it; an mv
// slot's stash is a nullable reference unless its values are scalars.
function mapSetParked(mslot: i32) {
  asgParkedSlot = mapSetValStashLocal(mslot)
  asgParkedRef = mslot >= 0 && mvScalarValKind(mslot) == null
  mapSetDidPark = true
  return 0
}

// The function a set over map shape `sh` calls: its row's store helper, given the next functype
// ordinal and the next index after the helpers already called the first time a site asks; -1
// when the row reserved none.
function mapSetFnOf(sh: i32) {
  const row = mapShapeRow(sh)
  if row < 0 || row >= gMapSetTy.length || gMapSetTy[row] == -1 { return -1 }
  if gMapSetFn[row] < 0 {
    gMapSetTy[row] = gMapSetTyN
    gMapSetTyN = gMapSetTyN + 1
    gMapSetTyRows.push(row)
    gMapSetFn[row] = gMapSetFnBase + gTailFnRows.length
    gTailFnRows.push(row)
  }
  return gMapSetFn[row]
}

// The row of map shape `sh` in the per-shape helper tables: 0 the string-keyed mono map, 1 the
// i32-keyed one, `2 + s` mv slot `s`, then the i64-keyed one, then the string-, i32- and
// i64-keyed Set, whose helpers leave its `vals` alone.
function mapShapeRow(sh: i32) {
  if sh == -1 { return 0 }
  if sh == -4 { return 1 }
  if sh == -6 { return mvMapTypeIdx.length + 2 }
  if sh == -2 { return mvMapTypeIdx.length + 3 }
  if sh == -5 { return mvMapTypeIdx.length + 4 }
  if sh == -7 { return mvMapTypeIdx.length + 5 }
  if sh < 0 { return -1 }
  return sh + 2
}

// Whether map shape `sh` is a Set's, string-, i32- or i64-keyed.
function mapShapeIsSet(sh: i32): boolean {
  return sh == -2 || sh == -5 || sh == -7
}

// The Set shape over the same key as mono map shape `sh`; `sh` itself for any other shape.
function mapShapeOfSet(sh: i32) {
  if sh == -1 { return -2 }
  if sh == -4 { return -5 }
  if sh == -6 { return -7 }
  return sh
}

// `__map_set_<row>__(m, k, v)`'s functype for map shape `sh`: the map, its key rep and the value
// in the type a set site's value expression leaves.
export function mapSetFuncType(sh: i32) {
  const saved = cmSlot
  cmSlot = mapShapeFoldSet(sh)
  fbFuncTypeHead(3)
  fbRefValtype(cmMapTy())
  const k = cmKeyKind()
  if k == MAP_KEY_I32 { fbValtype("i32", -1) }
  else if k == MAP_KEY_I64 { fbValtype("i64", -1) }
  else { fbRefValtype(sTy()) }
  if sh < 0 {
    fbValtype("i32", -1) // the mono map's value
  } else if mvValKindAt(sh) == "f64" {
    fbValtype("f64", -1)
  } else if mvValKindAt(sh) == "i64" {
    fbValtype("i64", -1)
  } else if mvValKindAt(sh) == "f32" {
    fbValtype("f32", -1)
  } else if mvValKindAt(sh) == "v128" {
    fbValtype("v128", -1)
  } else {
    fbRefNullValtype(mvValElemHeapOf(sh)) // the vals element
  }
  wULEB(0)
  cmSlot = saved
  return 0
}

// The body of `__map_set_<row>__` for map shape `sh`: the store a set site would otherwise
// inline, over the params, with the string frame's slots 3 to 13 as its locals.
export function mapSetFnBody(sh: i32): u8[] {
  const body: u8[] = []
  const prev = wTarget(body)
  const savedSlot = cmSlot
  const savedBase = mapScratchBase
  cmSlot = mapShapeFoldSet(sh)
  wULEB(6)
  wULEB(3)
  fbValtype("i32", -1) // 3 slot, 4 cap, 5 entry
  wULEB(1)
  fbRefValtype(cmKeysBack()) // 6 keysBk
  wULEB(1)
  fbRefValtype(cmValsBack()) // 7 valsBk
  wULEB(1)
  if gMapDeletes {
    fbRefNullValtype(ia64Ty()) // 8 the grown seqs
  } else {
    fbValtype("i32", -1) // 8 unused without deletes
  }
  wULEB(3)
  fbValtype("i32", -1) // 9 hcur, 10 and 11 unused
  wULEB(2)
  fbRefValtype(aTy()) // 12 liveBk, 13 hashBk
  mapScratchBase = 0
  msHelp = true
  emitMapSetStore(cmSlot, mapShapeIsSet(sh))
  msHelp = false
  mapScratchBase = savedBase
  cmSlot = savedSlot
  fbEnd()
  wTarget(prev)
  return body
}

// A set's store, with the map, key and value in their locals: probe; a hit overwrites, a miss
// appends, compacting first when the dead entries call for it, and maybe resizes. A Set's
// (`isSet`) leaves its `vals` alone: a hit does nothing and a miss pushes only the key.
function emitMapSetStore(mslot: i32, isSet: boolean) {
  emitMapProbe(true, true)
  pushMapScr(5) // entry
  if isSet {
    // A Set's present key has nothing to overwrite: only a miss appends.
    fbI32Eqz()
    fbIf(64) // if (entry == 0 → append), void
  } else {
    fbIf(64) // if (entry != 0 → overwrite), void
    // OVERWRITE: vals.backing[entry-1] = stash
    pushMapVals()
    fbStructGet(cmValsWrap(), 0) // struct.get (vals backing), field 0: backing
    pushMapScr(5)                // entry
    fbI32Const(1)
    fbI32Bin(107)                // i32.sub (entry - 1)
    pushMapSetValStash(mslot)
    fbArraySet(cmValsBack())     // array.set
    fbElse()                     // else
  }
  // APPEND. Reclaim the dead entries first once they outnumber the live ones by
  // `INITIAL_CAP`: compaction rebuilds the index, so the free slot is probed again (D2315).
  const cmpFn = mapCompactFnOf(if isSet { mapShapeOfSet(mslot) } else { mslot })
  if cmpFn >= 0 {
    pushMapCount()
    pushMapSize()
    fbI32Bin(107) // i32.sub (count - size)
    pushMapSize()
    fbI32Const(8) // INITIAL_CAP
    fbI32Bin(106) // i32.add (size + INITIAL_CAP)
    fbI32Bin(75)  // 0x4b i32.gt_u ((count-size) > (size+INITIAL_CAP))
    fbIf(64)      // if, void
    pushMapRef()
    fbCall(cmpFn)
    emitMapProbe(true, true)
    fbEnd()       // end (compact if)
  }
  // the slot's entry = count + 1 (the new entry's position + 1), beside an integer key's tag in
  // its pair: an i32 key is its own tag, an i64 key's is its hash.
  if cmKeyInt() {
    pushMapIndex()
    pushMapSlotPos(0)
    if cmKeyKind() == MAP_KEY_I64 {
      fbMapTagOfI64(cmKeyLocal())
    } else {
      fbLocalGet(cmKeyLocal())
    }
    fbArraySet(aTy()) // array.set
  }
  pushMapIndex()
  pushMapSlotPos(1)
  pushMapCount()
  fbI32Const(1)
  fbI32Bin(106)     // i32.add (count + 1)
  fbArraySet(aTy()) // array.set
  // keys.push(keyRef) ; vals.push(stash)  (clobbers slots 3/4 — already linked above).
  if emitMapPushKey() < 0 { return -1 }
  if !isSet && emitMapPushVal() < 0 { return -1 }
  // count = count + 1
  pushMapRef()              // mapRef (struct.set receiver)
  pushMapCount()
  fbI32Const(1)
  fbI32Bin(106)             // i32.add
  fbStructSet(cmMapTy(), 4) // struct.set field 4: count
  // size = size + 1
  pushMapRef()              // mapRef
  pushMapSize()
  fbI32Const(1)
  fbI32Bin(106)             // i32.add
  fbStructSet(cmMapTy(), 5) // struct.set field 5: size
  if emitMapResize() < 0 { return -1 }
  fbEnd()                   // end (if)
  return 0
}

// Thin wrapper preserving the original arity: the non-constant-value map set. The
// `s.add(k)` Set form calls `emitMapSetV` with `valConst1 = true`.
function emitMapSet(recvIx: i32, keyIx: i32, valIx: i32, fnIx: i32) {
  return emitMapSetV(recvIx, keyIx, valIx, fnIx, false)
}

// Inline list-grow append of the scratch `keyRef` (slot 1) onto `M.keys`. The keys
// backing is `(array (mut (ref null $sTypeIdx)))`, so grow uses `array.new_default` /
// `array.copy` over `$mkArrIdx`, reusing the map scratch frame's spare i32 slots (4
// newCap, 3 free here) rather than a dedicated frame — the grow path mirrors `emitPush`.
function emitMapPushKey() {
  // if keys.len == keys.cap { grow }
  pushMapKeysLen()
  pushMapKeysCap()
  fbI32Bin(70) // i32.eq
  fbIf(64)     // if, void
  // newCap = cap == 0 ? 4 : cap*2   (slot 4)
  pushMapKeysCap()
  fbI32Eqz()    // i32.eqz
  fbIf(127)     // if, i32 blocktype
  fbI32Const(4)
  fbElse()      // else
  pushMapKeysCap()
  fbI32Const(2)
  fbI32Bin(108) // i32.mul
  fbEnd()       // end
  setMapScr(4)  // newCap
  // keys.backing = copy of old into a fresh array.new_default(newCap), keys.cap=newCap
  // newBacking on stack: array.new_default <keysBacking> newCap
  pushMapScr(4) // newCap
  fbArrayNewDefault(cmKeysBack())
  // newBacking needs a TYPED ref local (slot 6, `newKeysBacking`): the copy must run
  // BEFORE the swap (swapping first loses the old elements), and `array.copy` CONSUMES
  // its dest operand, so the stack alone cannot supply it twice. `curRef` cannot hold it
  // either — that slot is a `(ref $sTypeIdx)` string ref, the wrong type.
  setMapScrKB() // newKeysBacking (slot 6)
  // array.copy newBacking 0 oldBacking 0 len
  pushMapScrKB()                          // dest
  fbI32Const(0)
  pushMapKeysBacking()                    // src (old)
  fbI32Const(0)
  pushMapKeysLen()                        // count
  fbArrayCopy(cmKeysBack(), cmKeysBack()) // array.copy (dest type, src type)
  // keys.backing = newBacking
  pushMapKeys()
  pushMapScrKB()
  fbStructSet(cmKeysWrap(), 0) // struct.set field 0: backing
  // keys.cap = newCap
  pushMapKeys()
  pushMapScr(4)
  fbStructSet(cmKeysWrap(), 2) // struct.set field 2: cap
  // In a module that deletes, live grows in LOCKSTEP with the keys backing (entry-parallel):
  // allocate a fresh `(ref $aTypeIdx)` of newCap (slot 12), copy the live region
  // `[0, keys.len)` over, and store it back into M.live (field 2). `keys.len` is still the
  // pre-append count here. A module that never deletes has no dead entry to mark.
  if gMapDeletes {
    pushMapScr(4)             // newCap
    fbArrayNewDefault(aTy())
    setMapScrLB()             // newLiveBacking (slot 12)
    pushMapScrLB()            // dest
    fbI32Const(0)
    pushMapLive()             // src (old live)
    fbI32Const(0)
    pushMapKeysLen()          // count (entries copied)
    fbArrayCopy(aTy(), aTy()) // array.copy (dest type, src type)
    pushMapRef()              // mapRef
    pushMapScrLB()
    fbStructSet(cmMapTy(), 2) // struct.set field 2: live
  }
  // a string-keyed map's hashes grow in LOCKSTEP too: fresh `(ref $aTypeIdx)` of newCap
  // (slot 13), copy `[0, keys.len)` over, store back into M.hashes (field 6).
  if !cmKeyInt() {
    pushMapScr(4)             // newCap
    fbArrayNewDefault(aTy())
    setMapScrHB()             // newHashBacking (slot 13)
    pushMapScrHB()            // dest
    fbI32Const(0)
    pushMapHashes()           // src (old hashes)
    fbI32Const(0)
    pushMapKeysLen()          // count (entries copied)
    fbArrayCopy(aTy(), aTy()) // array.copy (dest type, src type)
    pushMapRef()              // mapRef
    pushMapScrHB()
    fbStructSet(cmMapTy(), 6) // struct.set field 6: hashes
  }
  // seqs (an i64 array) grows in lockstep too, in a module that deletes (D2315).
  if gMapDeletes {
    const nsL = mapSeqsBackSlot()
    pushMapScr(4)             // newCap
    fbArrayNewDefault(ia64Ty())
    fbLocalSet(nsL)
    fbLocalGet(nsL)           // dest
    fbI32Const(0)
    pushMapSeqs()             // src (old seqs)
    fbI32Const(0)
    pushMapKeysLen()          // count (entries copied)
    fbArrayCopy(ia64Ty(), ia64Ty())
    pushMapRef()
    fbLocalGet(nsL)
    fbRefAsNonNull()
    fbStructSet(cmMapTy(), 7) // struct.set field 7: seqs
  }
  fbEnd() // end (grow if)
  // live[keys.len] = 1  (the new entry is live), in a module that can kill one.
  if gMapDeletes {
    pushMapLive()
    pushMapKeysLen() // entry index (== count, pre-append)
    fbI32Const(1)
    fbArraySet(aTy()) // array.set
  }
  // seqs[keys.len] = next ; next = next + 1 — the entry's insertion sequence, an i64 that no
  // program lives long enough to wrap, which a walk resyncs by after a compaction (D2315).
  if gMapDeletes {
    pushMapSeqs()
    pushMapKeysLen()
    pushMapRef()
    fbStructGet(cmMapTy(), 8)
    fbArraySet(ia64Ty())
    pushMapRef()
    pushMapRef()
    fbStructGet(cmMapTy(), 8)
    fbI64Const(0, 1)
    fbI32Bin(124) // 0x7c i64.add
    fbStructSet(cmMapTy(), 8)
  }
  // hashes[keys.len] = hash(keyRef) for a string key — cached parallel to the entry, it gates
  // the probe's key compare and re-places the entry on resize; the probe's own, in slot +9.
  if !cmKeyInt() {
    pushMapHashes()
    pushMapKeysLen() // entry index (== count, pre-append)
    pushMapScr(9)
    fbArraySet(aTy()) // array.set
  }
  // keys.backing[keys.len] = key
  pushMapKeysBacking()
  pushMapKeysLen()
  fbLocalGet(cmKeyLocal())
  fbArraySet(cmKeysBack()) // array.set
  // keys.len = keys.len + 1
  pushMapKeys()
  pushMapKeysLen()
  fbI32Const(1)
  fbI32Bin(106)                // i32.add
  fbStructSet(cmKeysWrap(), 1) // struct.set field 1: len
  return 0
}

// Append the stashed set value onto `M.vals` (inline list-grow push). `emitMapSetV`
// evaluates and stashes the value before the probe, so this only grows the vals list
// and stores the stash — no user code runs inside the append.
function emitMapPushVal() {
  const mslot = cmSlot
  // if vals.len == vals.cap { grow }
  pushMapValsLen()
  pushMapValsCap()
  fbI32Bin(70) // i32.eq
  fbIf(64)     // if, void
  // newCap (slot 4)
  pushMapValsCap()
  fbI32Eqz()    // i32.eqz
  fbIf(127)     // if, i32 blocktype
  fbI32Const(4)
  fbElse()      // else
  pushMapValsCap()
  fbI32Const(2)
  fbI32Bin(108) // i32.mul
  fbEnd()       // end
  setMapScr(4)
  // newBacking = array.new_default <valsBack> newCap → the valsBk scratch
  pushMapScr(4)
  fbArrayNewDefault(cmValsBack())
  setMapScrVB() // newValsBacking
  // array.copy newBacking 0 oldBacking 0 len
  pushMapScrVB()
  fbI32Const(0)
  pushMapValsBacking()
  fbI32Const(0)
  pushMapValsLen()
  fbArrayCopy(cmValsBack(), cmValsBack()) // array.copy (dest type, src type)
  // vals.backing = newBacking
  pushMapVals()
  pushMapScrVB()
  fbStructSet(cmValsWrap(), 0) // struct.set field 0: backing
  // vals.cap = newCap
  pushMapVals()
  pushMapScr(4)
  fbStructSet(cmValsWrap(), 2) // struct.set field 2: cap
  fbEnd()                      // end (grow if)
  // vals.backing[vals.len] = the stashed value
  pushMapValsBacking()
  pushMapValsLen()
  pushMapSetValStash(mslot)
  fbArraySet(cmValsBack()) // array.set
  // vals.len = vals.len + 1
  pushMapVals()
  pushMapValsLen()
  fbI32Const(1)
  fbI32Bin(106)                // i32.add
  fbStructSet(cmValsWrap(), 1) // struct.set field 1: len
  return 0
}

// `M.keys.len` / `.cap` / `.backing` field reads (struct.get $mkListIdx 1/2/0).
function pushMapKeysLen() {
  pushMapKeys()
  fbStructGet(cmKeysWrap(), 1)
  return 0
}
function pushMapKeysCap() {
  pushMapKeys()
  fbStructGet(cmKeysWrap(), 2)
  return 0
}
function pushMapKeysBacking() {
  pushMapKeys()
  fbStructGet(cmKeysWrap(), 0)
  return 0
}
// `M.vals.len` / `.cap` / `.backing` field reads (struct.get <valsWrap> 1/2/0 —
// the i32 list wrapper for the mono map, this mv slot's ref-list wrapper else).
function pushMapValsLen() {
  pushMapVals()
  fbStructGet(cmValsWrap(), 1)
  return 0
}
function pushMapValsCap() {
  pushMapVals()
  fbStructGet(cmValsWrap(), 2)
  return 0
}
function pushMapValsBacking() {
  pushMapVals()
  fbStructGet(cmValsWrap(), 0)
  return 0
}

// The two ref scratch locals beyond the 6-slot core frame: a non-null keys backing
// ref (slot 6) and a non-null vals backing ref (slot 7), used by the two grows.
function setMapScrKB() {
  fbLocalSet(cmKeysBkLocal())
  return 0
}
function pushMapScrKB() {
  fbLocalGet(cmKeysBkLocal())
  return 0
}
function setMapScrVB() {
  fbLocalSet(cmValsBkLocal())
  return 0
}
function pushMapScrVB() {
  fbLocalGet(cmValsBkLocal())
  return 0
}
// The grown `live` backing ref (slot 12, a non-null `(ref $aTypeIdx)` i32 array),
// used by the keys grow to reallocate `live` in lockstep with the keys backing.
function setMapScrLB() {
  fbLocalSet(mapScratchBase + 12)
  return 0
}
function pushMapScrLB() {
  fbLocalGet(mapScratchBase + 12)
  return 0
}
// The grown `hashes` backing ref (slot 13, a non-null `(ref $aTypeIdx)` i32 array),
// used by the keys grow to reallocate `hashes` in lockstep with the keys backing, and
// by `compact` as the rebuilt hashes backing.
function setMapScrHB() {
  fbLocalSet(mapScratchBase + 13)
  return 0
}
function pushMapScrHB() {
  fbLocalGet(mapScratchBase + 13)
  return 0
}

// Begin a chunked long-literal build: allocate the full `n`-element backing into a fresh
// backing-typed slot of the lazy list frame (so a nested chunked literal cannot clobber
// this one), then open the first chunk and return the destination slot. `strBack` (not
// `kind`, which is "i32" for both) distinguishes a string destination from a list one.
function arrLitChunkStart(
  kind: ListKind,
  rslot: i32,
  backTy: i32,
  n: i32,
  strBack: boolean,
) {
  liKinds.push(kind)
  liSlots.push(rslot)
  if strBack { liBack.push(5) } else { liBack.push(1) }
  const dst = listIdxScratchBase + liKinds.length
  fbI32Const(n)
  fbArrayNewDefault(backTy) // 0xfb 0x07 <typeidx>
  fbLocalSet(dst)
  fbLocalGet(dst)           // the open chunk's copy destination …
  fbI32Const(0)             // … and destination offset
  return dst
}

// Chunk boundary check after element `i` of `n` is pushed (`coff` marks the open
// chunk's first element). At `NEW_FIXED_MAX` elements or the literal's end, close
// the chunk — `array.new_fixed` the pushed elements, `array.copy` them into the
// destination — and open the next one when elements remain. Returns the new start.
function arrLitChunkFlush(dst: i32, backTy: i32, coff: i32, i: i32, n: i32) {
  return arrLitChunkFlushAt(dst, backTy, coff, i, n, NEW_FIXED_MAX)
}

// `arrLitChunkFlush` closing a chunk at `max` elements rather than at the operand cap.
function arrLitChunkFlushAt(
  dst: i32,
  backTy: i32,
  coff: i32,
  i: i32,
  n: i32,
  max: i32,
) {
  if i - coff < max && i < n { return coff }
  fbArrayNewFixed(backTy, i - coff) // the chunk source array
  fbI32Const(0)                     // source offset
  fbI32Const(i - coff)              // element count
  fbArrayCopy(backTy, backTy)       // 0xfb 0x11 — consumes [dst, off, src, 0, k]
  if i < n {
    fbLocalGet(dst)
    fbI32Const(i)
  }
  return i
}

// The element forms of `arrLitDataBuild`: which emitter lowers an element, and so which one
// constant instruction it must produce. `ALD_U8` and `ALD_U16` are the i32 lowering stored one
// and two bytes wide, the packed rows' storage.
const ALD_I32 = 0
const ALD_I64 = 1
const ALD_F32 = 2
const ALD_F64 = 3
const ALD_U8 = 4
const ALD_U16 = 5

// Build the `backTy` backing of a literal past the `array.new_fixed` cap of number or boolean
// literals as one passive data segment read by `array.new_data`, so its code is a few bytes
// whatever its length (D3417). Returns 1 when the backing is on the stack, 0 when some element
// is not one constant instruction (nothing emitted), -1 when an element fails to lower.
function arrLitDataBuild(elems: i32[], fnIx: i32, form: i32, backTy: i32): i32 {
  const computed: i32[] = []
  let i = 0
  while i < elems.length {
    if !arrLitElemIsConst(elems[i]) {
      if !arrLitDataStores(elems[i], fnIx, form) { return 0 }
      computed.push(i)
    }
    i = i + 1
  }
  const parts: { b: u8[] }[] = [{ b: [] }]
  let n = 0
  i = 0
  let ci = 0
  while i < elems.length {
    if parts[parts.length - 1].b.length >= LIT_PART { parts.push({ b: [] }) }
    if ci < computed.length && computed[ci] == i {
      // A computed element's slot holds zero bytes until its store below.
      n = n + arrLitDataZero(form, parts[parts.length - 1].b)
      ci = ci + 1
    } else {
      const one: u8[] = []
      const prev = wTarget(one)
      const rc = arrLitDataElemEmit(elems[i], fnIx, form)
      wTarget(prev)
      if rc < 0 { return -1 }
      const w = arrLitDataPut(one, form, parts[parts.length - 1].b)
      if w < 0 { return 0 }
      n = n + w
    }
    i = i + 1
  }
  const seg = gStrDataLen.length
  gStrDataStart.push(gStrDataParts.length)
  gStrDataLen.push(n)
  let k = 0
  while k < parts.length {
    gStrDataParts.push(parts[k])
    k = k + 1
  }
  fbI32Const(0)            // segment offset
  fbI32Const(elems.length) // element count
  fbArrayNewData(backTy, seg)
  if computed.length == 0 { return 1 }
  // The computed elements are stored after the segment builds the backing, in source order,
  // so a literal of any length with some computed elements stays a few bytes per such element.
  liKinds.push(arrLitDataKind(form))
  liSlots.push(0)
  liBack.push(1)
  const dst = listIdxScratchBase + liKinds.length
  fbLocalSet(dst)
  for at in computed {
    fbLocalGet(dst)
    fbI32Const(at)
    if arrLitDataElemEmit(elems[at], fnIx, form) < 0 { return -1 }
    fbArraySet(backTy)
  }
  fbLocalGet(dst)
  fbRefAsNonNull()
  return 1
}

// Whether a non-constant element `ix` of a literal built in data form `form` may be stored into
// the segment-built backing: a scalar list form with a lazy-frame kind, and an element the
// literal's own loop would lower as one scalar of that form.
function arrLitDataStores(ix: i32, fnIx: i32, form: i32): boolean {
  if form == ALD_U8 || form == ALD_U16 { return false }
  if exprArray(ix, fnIx) || exprRefArray(ix, fnIx) || exprStruct(ix, fnIx) {
    return false
  }
  if exprVariantIndex(ix, fnIx) >= 0 || nodeTyIsVariant(ix) { return false }
  return !(exprMap(ix, fnIx) || nodeTyIsMap(ix))
}

// The lazy-frame list kind whose backing data form `form` builds; `arrLitDataStores` admits no
// other form.
function arrLitDataKind(form: i32): ListKind {
  if form == ALD_I64 { return "i64list" }
  if form == ALD_F32 { return "f32list" }
  if form == ALD_F64 { return "f64list" }
  return "list"
}

// Append the zero bytes of one element of data form `form` to `out`, returning their count.
function arrLitDataZero(form: i32, out: u8[]): i32 {
  const w = if form == ALD_I64 || form == ALD_F64 { 8 } else if form == ALD_U8 { 1 } else if form == ALD_U16 { 2 } else { 4 }
  let j = 0
  while j < w {
    out.push(0)
    j = j + 1
  }
  return w
}

// A fresh backing array of type `ty` from the `n` elements on the stack. An empty one reads the
// module's one zero-length array of that type instead: every list and map holding it has
// capacity 0, so its first store reallocates, and nothing compares backings by identity.
function fbBacking(ty: i32, n: i32) {
  if n == 0 {
    const g = synthGlobalIdx(SYNTH_EMPTY_BACKING, ty)
    if g >= 0 { return fbGlobalGet(g) }
  }
  return fbArrayNewFixed(ty, n)
}

// The list literals that are a `for` walk's own iterable (`unwrapParen(fiIter)`), scanned from the
// arena up to `forIterScanned`. Nothing but the loop can reach such a list, and it only reads it.
let forIterLits: {[i32]: boolean} = Map()
let forIterScanned = 0

// The module constant list `for` iterable literal `arrIx` of arm `arm` reads, minted on first ask:
// its global, -1 when it builds as usual (another arm, or an element not one constant), -2 failed.
// The f64, string and i32 arms hoist; legacy's arm and the IR's lowering both ask here.
export function arrLitHoistGlobal(arrIx: i32, fnIx: i32, arm: ArrLitArm): i32 {
  if arrIx < 0 || arrIx >= P.nodes.length { return -1 }
  const a = nodeAt(arrIx)
  if !(a is ArrayLit) { return -1 }
  return match arm {
    "f64" => forLitHoistPlan(arrIx, a.arrElems, fnIx, ALD_F64, fa64Ty(), fl64Ty())
    "str" => forLitHoistPlan(arrIx, a.arrElems, fnIx, ALD_STR, mkArrTy(), mkListTy())
    "i32" => forLitHoistPlan(arrIx, a.arrElems, fnIx, ALD_I32, aTy(), lTy())
    "notLit" | "spread" | "clash" | "emptyHole" | "v128" | "u8" | "f32" | "i64" | "ref" => -1
  }
}

// Lowers `for` iterable literal `arrIx` of constants as a read of one module constant list
// built by the same element lowering (`form`, an `ALD_*` or `ALD_STR`) into `backTy`/`wrapTy`.
// Its global, -1 when the literal must build as usual, -2 on failure; nothing is written.
function forLitHoistPlan(
  arrIx: i32,
  elems: i32[],
  fnIx: i32,
  form: i32,
  backTy: i32,
  wrapTy: i32,
): i32 {
  if (
    !arrLitIsForIter(arrIx)
    || elems.length == 0
    || elems.length > NEW_FIXED_MAX
  ) {
    return -1
  }
  let i = 0
  while i < elems.length {
    if !forLitElemIsConst(elems[i]) { return -1 }
    i = i + 1
  }
  const init: u8[] = []
  i = 0
  while i < elems.length {
    const one: u8[] = []
    const prev = wTarget(one)
    let rc = 0
    if form == ALD_STR {
      rc = emitStrValue(constStrInitOf(elems[i], fnIx), fnIx)
    } else {
      rc = arrLitDataElemEmit(elems[i], fnIx, form)
    }
    wTarget(prev)
    if rc < 0 { return -2 }
    if !isOneConstIns(one) { return -1 }
    relCopy(one, init, init.length)
    let k = 0
    while k < one.length {
      init.push(one[k])
      k = k + 1
    }
    i = i + 1
  }
  const prev = wTarget(init)
  fbArrayNewFixed(backTy, elems.length)
  arrLitWrap(elems.length, wrapTy)
  wTarget(prev)
  relHold(init)
  const g = synthConstListIdx(wrapTy, init)
  return if g < 0 { -1 } else { g }
}

// The element form `forLitHoist` lowers through `emitStrValue`.
const ALD_STR = 5

// Whether element `ix` may lower to one constant: a number or boolean literal, a string
// literal, or a name (whose lowering `isOneConstIns` then decides).
function forLitElemIsConst(ix: i32): boolean {
  if arrLitElemIsConst(ix) { return true }
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return false }
  const e = nodeAt(x)
  return e is StrLit || e is Ident
}

// The string literal a module `const` named by `ix` is initialized with, else `ix` itself.
function constStrInitOf(ix: i32, fnIx: i32): i32 {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length || !(nodeAt(x) is Ident) { return ix }
  const li = globalLetOfRead(fnIx, x)
  if li < 0 || li >= P.nodes.length { return ix }
  const d = nodeAt(li)
  if d is LetDecl {
    if d.letKw == "const" && d.letInit >= 0 {
      const ini = unwrapParen(d.letInit)
      if ini >= 0 && ini < P.nodes.length && nodeAt(ini) is StrLit {
        return ini
      }
    }
  }
  return ix
}

// Whether `ins` is exactly one instruction valid in a constant initializer that trails every
// other global: a numeric constant, or a read of a pooled string literal.
function isOneConstIns(ins: u8[]): boolean {
  if ins.length < 2 { return false }
  const op = ins[0] as i32
  if op == 0x44 {
    return ins.length == 9 // f64.const
  }
  if op == 0x43 {
    return ins.length == 5 // f32.const
  }
  // i32.const, i64.const, global.get: one LEB immediate
  if op != 0x41 && op != 0x42 && op != 0x23 { return false }
  let v = 0
  let sh = 0
  let k = 1
  while k < ins.length - 1 {
    if ((ins[k] as i32) & 0x80) == 0 { return false }
    v = v | (((ins[k] as i32) & 0x7f) << sh)
    sh = sh + 7
    k = k + 1
  }
  if ((ins[k] as i32) & 0x80) != 0 { return false }
  if op != 0x23 { return true }
  v = v | (((ins[k] as i32) & 0x7f) << sh)
  return v >= externGlobalCount()
    && v < externGlobalCount() + gStrPoolTexts.length
}

// Wrap the `n`-element backing on the stack as a full list of wrapper type `wrapTy`.
function arrLitWrap(n: i32, wrapTy: i32): i32 {
  fbI32Const(n) // len
  fbI32Const(n) // cap
  fbStructNew(wrapTy)
  return 0
}

// Whether element `ix` is a number literal, a negated one, or a boolean literal, in parens or not.
function arrLitElemIsConst(ix: i32): boolean {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return false }
  const e = nodeAt(x)
  if e is Unary {
    return e.unOp == "-" && arrLitLeafIsNum(unwrapParen(e.unArg))
  }
  return arrLitLeafIsNum(x) || arrLitLeafIsBool(x)
}

function arrLitLeafIsNum(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  return nodeAt(ix) is NumLit
}

function arrLitLeafIsBool(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  return nodeAt(ix) is BoolLit
}

// Lower element `ix` the way the literal's own element loop does for `form`.
function arrLitDataElemEmit(ix: i32, fnIx: i32, form: i32): i32 {
  if form == ALD_I64 { return emitWidened(ix, 3, fnIx) }
  if form == ALD_F32 { return emitWidened(ix, 5, fnIx) }
  if form == ALD_F64 { return emitWidened(ix, 4, fnIx) }
  return emitExpr(ix, fnIx)
}

// Append the little-endian element bytes the lone constant instruction `ins` denotes to `out`,
// returning their count, or -1 when `ins` is not exactly the one constant `form` expects.
function arrLitDataPut(ins: u8[], form: i32, out: u8[]): i32 {
  if ins.length < 2 { return -1 }
  const op = ins[0] as i32
  if form == ALD_F32 || form == ALD_F64 {
    const w = if form == ALD_F32 { 4 } else { 8 }
    if op != 0x43 + form - ALD_F32 || ins.length != w + 1 { return -1 }
    let j = 1
    while j <= w {
      out.push(ins[j])
      j = j + 1
    }
    return w
  }
  const want = if form == ALD_I64 { 0x42 } else { 0x41 }
  if op != want { return -1 }
  const w = if form == ALD_I64 { 8 } else if form == ALD_U8 { 1 } else if form == ALD_U16 { 2 } else { 4 }
  // The signed LEB128 immediate, re-packed eight bits at a time and sign-filled to `w` bytes.
  let bits = 0
  let nb = 0
  let put = 0
  let j = 1
  let last = 0
  while j < ins.length {
    last = ins[j] as i32
    if (last & 0x80) != 0 && j == ins.length - 1 { return -1 }
    if (last & 0x80) == 0 && j != ins.length - 1 { return -1 }
    bits = bits | ((last & 0x7f) << nb)
    nb = nb + 7
    while nb >= 8 && put < w {
      out.push(bits & 0xff)
      bits = bits >>> 8
      nb = nb - 8
      put = put + 1
    }
    j = j + 1
  }
  const fill = if (last & 0x40) != 0 { 0xff } else { 0 }
  if put < w {
    out.push((bits & ((1 << nb) - 1)) | ((fill << nb) & 0xff))
    put = put + 1
  }
  while put < w {
    out.push(fill)
    put = put + 1
  }
  return w
}

// Lower the `len`-bounds guard of a list `xs[i]` read/write: stack holds [wrapper,
// index] on entry, leaves [backing, i]. One unsigned compare covers negative and past-len, and
// a failing one traps (`emitListIdxTrap`) instead of reading the zero-init slack `.push` leaves
// past `len`. A list whose backing this module never typed keeps the older `select` to -1.
export function emitListIdxGuard(wrapSlot: i32, lTy: i32) {
  const back = listBackOfWrap(lTy)
  if back >= 0 {
    fbLocalSet(listIdxScratchBase)
    fbLocalSet(wrapSlot)
    fbLocalGet(listIdxScratchBase)
    fbLocalGet(wrapSlot)
    fbStructGet(lTy, 1) // field 1: len
    fbI32Bin(79) // 0x4f i32.ge_u
    fbIf(64)
    emitListIdxTrapOf(back, wrapSlot, lTy, -1)
    fbEnd()
    fbLocalGet(wrapSlot)
    fbStructGet(lTy, 0) // field 0: backing
    fbLocalGet(listIdxScratchBase)
    return 0
  }
  fbLocalSet(listIdxScratchBase) // 0x21 local.set — stash the index
  fbLocalSet(wrapSlot)           // 0x21 local.set — stash the wrapper ref
  fbLocalGet(wrapSlot)
  fbStructGet(lTy, 0)            // field 0: backing
  fbLocalGet(listIdxScratchBase)
  fbI32Const(-1)                 // the out-of-range replacement index
  fbLocalGet(listIdxScratchBase)
  fbLocalGet(wrapSlot)
  fbStructGet(lTy, 1)            // field 1: len
  fbI32Bin(73)                   // 0x49 i32.lt_u
  fbSelect()                     // → i if in-bounds else -1
  return 0
}

// The backing array type of list wrapper `w`, or -1 when no list this module built has it.
function listBackOfWrap(w: i32): i32 {
  let k = 0
  while k < rlWrapIdx.length && k < rlBackIdx.length {
    if rlWrapIdx[k] == w { return rlBackIdx[k] }
    k = k + 1
  }
  if pkRowOfWrap(w) >= 0 { return pkBackAt(pkRowOfWrap(w)) }
  if isFl64Ty(w) { return fa64TypeIdx }
  if isIl64Ty(w) { return ia64TypeIdx }
  if isFl32Ty(w) { return fa32TypeIdx }
  if isMkListTy(w) { return mkArrTy() }
  if isLTy(w) { return aTy() }
  return -1
}

// Whether `back` is a record list's backing, which `-O` may store flattened: its trap is a
// copy, which the flattening rewrites as it does a list's growth, where a read it would box.
function listBackIsRecord(back: i32): boolean {
  let k = 0
  while k < rlBackIdx.length {
    if rlBackIdx[k] == back { return true }
    k = k + 1
  }
  return false
}

// A guard's failing arm over backing `back` (local `backSlot`, else wrapper `wrapSlot`'s field 0).
// A plain build reads index 0 of the module's one empty array of the backing's type, the same
// bounds trap at the access without reloading the backing; `-O` keeps `emitListIdxTrap`, whose
// trap binaryen shares between checks of one index.
function emitListIdxTrapOf(back: i32, wrapSlot: i32, lTy: i32, backSlot: i32) {
  const g = if gOptimized == 0 { synthGlobalIdx(SYNTH_EMPTY_BACKING, back) } else { -1 }
  if g >= 0 {
    fbGlobalGet(g)
    fbI32Const(0)
    fbArrayGet(back)
    fbUnreachable()
    return 0
  }
  emitListIdxBackRef(wrapSlot, lTy, backSlot)
  if listBackIsRecord(back) {
    emitListIdxBackRef(wrapSlot, lTy, backSlot)
    fbArrayLen()
    emitListIdxBackRef(wrapSlot, lTy, backSlot)
  }
  emitListIdxTrap(back)
}

// The backing ref `emitListIdxTrapOf` names: local `backSlot`, or field 0 of the wrapper.
function emitListIdxBackRef(wrapSlot: i32, lTy: i32, backSlot: i32) {
  if backSlot >= 0 {
    fbLocalGet(backSlot)
    return 0
  }
  fbLocalGet(wrapSlot)
  fbStructGet(lTy, 0)
}

// Traps with the engine's own bounds trap from the guard's untaken branch: a read at -1 of the
// backing, or for a record list (`listBackIsRecord`) a one-element copy to index `len` from
// `[backing, len, backing]`. The closing `unreachable` lets `-O` drop a later check of the same
// index and share one trap block, where a trap that fell through kept every check (D4782).
function emitListIdxTrap(back: i32) {
  if listBackIsRecord(back) {
    fbI32Const(0)
    fbI32Const(1)
    fbArrayCopy(back, back)
  } else {
    fbI32Const(-1)
    fbArrayGet(back)
    fbDrop()
  }
  fbUnreachable()
  return 0
}

// The hoisted twin of `emitListIdxGuard`, for an access whose receiver is a binding
// with a live cached header: the backing ref and `len` are already in locals, so the
// receiver is never (re-)emitted and the stack holds only the index. Leaves the same
// [backing, safeIndex] pair; an index `idxIx` that `rangeProvenIndex` proves in bounds skips the select.
export function emitListIdxGuardHoisted(row: i32, idxIx: i32) {
  fbLocalSet(listIdxScratchBase) // 0x21 local.set — stash the index
  const back = listBackOfWrap(hoistWrapTyOfRow(row))
  if back >= 0 && !rangeProvenIndex(row, idxIx) {
    fbLocalGet(listIdxScratchBase)
    fbLocalGet(lhLen[row])
    fbI32Bin(79) // 0x4f i32.ge_u
    fbIf(64)
    emitListIdxTrapOf(back, -1, -1, lhBack[row])
    fbEnd()
    fbLocalGet(lhBack[row])
    fbLocalGet(listIdxScratchBase)
    return 0
  }
  fbLocalGet(lhBack[row]) // the cached backing (was `struct.get` field 0)
  if rangeProvenIndex(row, idxIx) {
    fbLocalGet(listIdxScratchBase)
    return 0
  }
  fbLocalGet(listIdxScratchBase)
  fbI32Const(-1)         // the out-of-range replacement index
  fbLocalGet(listIdxScratchBase)
  fbLocalGet(lhLen[row]) // the cached len (was `struct.get` field 1)
  fbI32Bin(73)           // 0x49 i32.lt_u
  fbSelect()             // → i if in-bounds else -1
  return 0
}

// The live hoist row for an index receiver, or -1: the receiver must be a bare
// identifier matching the row's binding, the row must be live, and its rep must match
// the arm asking. The rep check is the backstop that makes a classifier disagreement
// between the prologue and the access decline, rather than read a wrongly-typed local.
export function liveHoistRow(exprIx: i32, kind: ListKind, slot: i32) {
  const d = hoistPathDecl(exprIx)
  if d < 0 { return 0 - 1 }
  const p = hoistPathProp(exprIx)
  let k = 0
  while k < lhRoot.length {
    if (
      lhLive[k] > 0
      && lhRoot[k] == d
      && lhProp[k] == p
      && lhKind[k] == kind
      && lhSlot[k] == slot
    ) {
      return k
    }
    k = k + 1
  }
  return 0 - 1
}

// The declaration a hoist row caches the receiver at `ix` under, with `hoistPathProp`'s field:
// a bare identifier's, or the root identifier's of a field `b.xs`; -1 for any other receiver.
export function hoistPathDecl(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 - 1 }
  const e = nodeAt(ix)
  if e is Member { return hoistRootDecl(e.memObj) }
  return hoistRootDecl(ix)
}

// The field a hoist row caches at `ix`: `xs` for `b.xs`, "" for the binding itself.
export function hoistPathProp(ix: i32): string {
  if ix < 0 || ix >= P.nodes.length { return "" }
  const e = nodeAt(ix)
  if e is Member { return e.memProp }
  return ""
}

// The declaration of the bare identifier at `ix`, or -1 for any other node or an identifier
// that resolves to none: the only root a hoist row keys on.
function hoistRootDecl(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 - 1 }
  const e = nodeAt(ix)
  if e is Ident { return hoistDeclKey(identDeclOf(ix)) }
  return 0 - 1
}

// Declaration `d` as the one it is minted from, so an instance body's copy and its reads agree.
function hoistDeclKey(d: i32) {
  if d < 0 { return d }
  const o = declOrigOf(d)
  if o >= 0 { return o }
  return d
}

// Whether field receiver `memIx` (`b.xs`, `b` an identifier) lowers to one `struct.get` of a
// plain struct field, so the prologue may read it ahead of the loop: not a union, variant or
// nullable receiver, and not a narrowed read, each of which lowers through a dispatch or a guard.
function hoistFieldRecvOk(memIx: i32, fnIx: i32): boolean {
  const m = nodeAt(memIx)
  if m is Member {
    const o = m.memObj
    if (
      memNarrowVariantIndex(memIx, fnIx) >= 0
      || exprUnion(o, fnIx)
      || exprNullableStruct(o, fnIx)
    ) {
      return false
    }
    if exprVariantIndex(o, fnIx) >= 0 || nulVariantIdxOfExpr(o, fnIx) >= 0 {
      return false
    }
    const si = structIndexOfExpr(o, fnIx)
    return si >= 0 && sFieldIndex(si, m.memProp) >= 0
  }
  return false
}

// Does the code under `ix` assign a field named `prop`, of any receiver? A cached `b.xs` is stale
// after `c.xs = …` whenever `c` aliases `b`, and the name is all that can be compared here.
function stmtAssignsProp(ix: i32, prop: string): boolean {
  let cur = ix
  while cur >= 0 {
    if cur >= P.nodes.length { return false }
    const n = nodeAt(cur)
    if n is BinExpr {
      if n.binOp == "=" {
        const t = nodeAt(unwrapParen(n.binLeft))
        if t is Member {
          if t.memProp == prop { return true }
        }
      }
    }
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      if stmtAssignsProp(kids[i], prop) { return true }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  return false
}

// Find (or mint) the hoist row for receiver (`d`, `prop`) at list rep (`kind`, `slot`).
// Minting takes two slots of the lazy list frame — the backing ref (`liBack` 3, typed as
// this kind's backing array) and the i32 `len` (`liBack` 4).
function listHoistRow(d: i32, prop: string, kind: ListKind, slot: i32) {
  let k = 0
  while k < lhRoot.length {
    if (
      lhRoot[k] == d
      && lhProp[k] == prop
      && lhKind[k] == kind
      && lhSlot[k] == slot
    ) {
      return k
    }
    k = k + 1
  }
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(3)
  const bSlot = listIdxScratchBase + liKinds.length
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(4)
  const lSlot = listIdxScratchBase + liKinds.length
  lhRoot.push(d)
  lhProp.push(prop)
  lhKind.push(kind)
  lhSlot.push(slot)
  lhBack.push(bSlot)
  lhLen.push(lSlot)
  lhStart.push(0 - 1) // a list header has no `start`
  lhLive.push(0)
  return lhRoot.length - 1
}

// A raw-string row is keyed (kind "list", slot -1) — distinct from the i32-LIST rows, which
// are (kind "list", slot 0), so the two can never be confused by `liveHoistRow`'s rep check.
// `hoistRowIsStr` reads the same pair.
function hoistRowIsStr(row: i32) {
  return lhKind[row] == "list" && lhSlot[row] < 0
}

// Find (or mint) the hoist row for raw string receiver (`d`, `prop`), minting three slots of
// the lazy list frame (backing ref, `start`, `len`). Safe because the header is loop-invariant
// by construction — strings are immutable and there is no string element store — so only a
// rebinding of the declaration can invalidate the cache, which `blockRebindsDecl` refuses.
function strHoistRow(d: i32, prop: string) {
  let k = 0
  while k < lhRoot.length {
    if lhRoot[k] == d && lhProp[k] == prop && hoistRowIsStr(k) { return k }
    k = k + 1
  }
  liKinds.push("list")
  liSlots.push(0)
  liBack.push(5)
  const sbSlot = listIdxScratchBase + liKinds.length
  liKinds.push("list")
  liSlots.push(0)
  liBack.push(4)
  const stSlot = listIdxScratchBase + liKinds.length
  liKinds.push("list")
  liSlots.push(0)
  liBack.push(4)
  const slSlot = listIdxScratchBase + liKinds.length
  lhRoot.push(d)
  lhProp.push(prop)
  lhKind.push("list")
  lhSlot.push(0 - 1)
  lhBack.push(sbSlot)
  lhLen.push(slSlot)
  lhStart.push(stSlot)
  lhLive.push(0)
  return lhRoot.length - 1
}

// Mint a fresh lazy-list-frame slot typed as list kind `kind`'s backing array — the same
// `liBack` 1 typing a chunked literal's destination, without emitting anything. Fresh and
// never deduped: a caller holds its backing live across a whole loop, so two callers
// sharing one slot would clobber each other's backing.
function listBackStashSlot(kind: ListKind, slot: i32) {
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(1)
  return listIdxScratchBase + liKinds.length
}

// The string-header stash slot (`liBack == 6`, `(ref null $sTypeIdx)`), deduped per
// function since every `s[i]` / `s.charCodeAt(i)` shares it safely — the receiver
// stashes only after both it and the index are fully evaluated, so a nested string
// index has already passed through; it rides the lazy frame, so `emitStrCharCode` needs no `exprHasStrOp` arm.
function strHdrSlot() {
  let k = 0
  while k < liKinds.length {
    if liBack[k] == 6 { return listIdxScratchBase + 1 + k }
    k = k + 1
  }
  liKinds.push("list")
  liSlots.push(0)
  liBack.push(6)
  return listIdxScratchBase + liKinds.length
}

// Lower the bounds guard of a raw-string `s[i]` read: stack holds [string, index] on
// entry, leaves [backing, offset] where `offset` is `start + i` when `i u< len` and `-1`
// otherwise, so the read traps rather than silently returning a sibling view's character
// (the backing is longer than the view). The select is over the offset, not the raw index.
function emitStrIdxGuard() {
  const hs = strHdrSlot()
  fbLocalSet(listIdxScratchBase) // 0x21 local.set — stash the index
  fbLocalSet(hs)                 // 0x21 local.set — stash the string header
  fbLocalGet(hs)
  fbStrBack()                    // field 0: backing
  fbLocalGet(hs)
  fbStrStart()                   // field 1: start
  fbLocalGet(listIdxScratchBase)
  fbI32Bin(106)                  // 0x6a i32.add → start + i   [a]
  fbI32Const(-1)                 // the out-of-range replacement offset  [b]
  fbLocalGet(listIdxScratchBase)
  fbLocalGet(hs)
  fbStrLen()                     // field 2: len
  fbI32Bin(73)                   // 0x49 i32.lt_u (covers negative + past-len)
  fbSelect()                     // → start+i if in-bounds else -1
  return 0
}

// Mint a FRESH `(ref null $sBackIdx)` lazy-frame slot — the same `liBack` 5 typing a chunked
// string literal's destination gets, without emitting anything. Fresh and never deduped: the
// caller holds the backing live across a whole loop, so two nested `for cp in s` loops
// sharing one slot would clobber the outer one's backing with the inner one's.
function strBackSlot() {
  liKinds.push("list")
  liSlots.push(0)
  liBack.push(5)
  return listIdxScratchBase + liKinds.length
}

// Mint a FRESH `(ref null <mapTy>)` lazy-frame slot (`liBack` 22) holding a `for`-in walk's
// map across its body. Fresh for the reason `strBackSlot` is, and not the shared mapRef: every
// map op in the body rewrites that, and the walk re-reads `live` and `vals` each step (D2313).
function forInMapStashSlot(mapTy: i32) {
  liKinds.push("list")
  liSlots.push(mapTy)
  liBack.push(22)
  return listIdxScratchBase + liKinds.length
}

// Mint a FRESH i64 lazy-frame slot holding a map walk's saved entry sequence (D2315). Its
// `liSlots` tag is -7 so `listIdxValSlot`'s dedupe never hands it to an i64 store stash.
function mapSeqSaveSlot() {
  liKinds.push("i64list")
  liSlots.push(0 - 7)
  liBack.push(2)
  return listIdxScratchBase + liKinds.length
}

// The function's one `(ref null <i64 array>)` slot for a map-seqs grow, shared: no user code
// runs between its set and its last read (D2315).
function mapSeqsBackSlot() {
  if msHelp { return 8 }
  let k = 0
  while k < liKinds.length {
    if liKinds[k] == "i64list" && liSlots[k] == 0 - 7 && liBack[k] == 3 {
      return listIdxScratchBase + 1 + k
    }
    k = k + 1
  }
  liKinds.push("i64list")
  liSlots.push(0 - 7)
  liBack.push(3)
  return listIdxScratchBase + liKinds.length
}

// Mint a FRESH i32 lazy-frame slot (`liBack` 4, the same code a hoisted list `len` uses).
// Fresh for the same reason `strBackSlot` is.
function strI32Slot() {
  liKinds.push("list")
  liSlots.push(0)
  liBack.push(4)
  return listIdxScratchBase + liKinds.length
}

// The hoisted twin of `emitStrIdxGuard`, for a `s[i]` whose receiver is a binding with a
// live cached header: backing / start / len are already in locals, so the receiver is
// never emitted and the stack holds only the index. Leaves the same [backing, offset]
// pair; the bounds check is not weakened — same `len`, read once before the loop.
function emitStrIdxGuardHoisted(row: i32) {
  fbLocalSet(listIdxScratchBase) // 0x21 local.set — stash the index
  fbLocalGet(lhBack[row])        // the cached backing (was `struct.get` field 0)
  fbLocalGet(lhStart[row])       // the cached start   (was `struct.get` field 1)
  fbLocalGet(listIdxScratchBase)
  fbI32Bin(106)                  // 0x6a i32.add → start + i   [a]
  fbI32Const(-1)                 // the out-of-range replacement offset  [b]
  fbLocalGet(listIdxScratchBase)
  fbLocalGet(lhLen[row])         // the cached len     (was `struct.get` field 2)
  fbI32Bin(73)                   // 0x49 i32.lt_u
  fbSelect()
  return 0
}

// A fresh element-value slot of the lazy list frame — `(ref null $rlElemHeap[slot])` for
// the "ref" kind. The non-deduping twin of `listIdxValSlot` below: the struct-element
// compare needs two live slots of one type at once (the left element and the right one),
// so a shared slot would compare a value against itself.
function listElemStashSlot(kind: ListKind, slot: i32) {
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(2)
  return listIdxScratchBase + liKinds.length
}

// The indexed-store value stash slot for list kind `kind` (`slot` the ref-list table slot
// for kind "ref", else 0) — a `liBack == 2` entry typed as the element value. The value
// parks here across `emitListIdxGuard` so the backing and len resolve after its user code
// runs; no user code runs between the stash and the `array.set`, so sharing is clobber-safe.
function listIdxValSlot(kind: ListKind, slot: i32) {
  let k = 0
  while k < liKinds.length {
    if liKinds[k] == kind && liSlots[k] == slot && liBack[k] == 2 {
      return listIdxScratchBase + 1 + k
    }
    k = k + 1
  }
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(2)
  return listIdxScratchBase + liKinds.length
}

// True when the call at `callIx` lowers to linear-memory instructions and nothing else:
// a bare-identifier callee, unshadowed here, in the load/store/bulk/size families. No GC
// object is reachable from such a call — every operand is a number and the lowering is one
// instruction — so no list's `backing`/`len` can move across it. Every other call declines.
function hoistSafeMemCall(callIx: i32, fnIx: i32): boolean {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return false }
    const callee = nodeAt(c.callFn)
    if callee is Ident {
      const nm = callee.identName
      if identNameIsUserBound(c.callFn, fnIx) { return false }
      if nm == "__store_i32__" { return true }
      if nm == "__load_i32__" { return true }
      if nm == "__memory_size__" { return true }
      if nm == "__memory_grow__" { return true }
      if nameIsMemStoreIntrinsic(nm) { return true }
      if nameIsMemLoadIntrinsic(nm) { return true }
      if nameIsAtomicIntrinsic(nm) { return true }
      return nameIsMemBulkIntrinsic(nm)
    }
  }
  return false
}

// The soundness condition for list-header hoisting: across a loop body that cannot
// reallocate a list, its backing ref and `len` are loop-invariant, so hoisting reads them
// once before the loop instead of per access. Declines on a rebinding, a nullable receiver,
// and every call but `hoistSafeMemCall`'s — any other may reallocate through a param.
function hoistSafeExpr(ix: i32, fnIx: i32): boolean {
  if ix < 0 { return true }
  const e = nodeAt(ix)
  match e {
    NumLit => {
      return true
    }
    StrLit => {
      return true
    }
    CharLit => {
      return true
    }
    BoolLit => {
      return true
    }
    NullLit => {
      return true
    }
    Ident => {
      return true
    }
    Unary => {
      return hoistSafeExpr(e.unArg, fnIx)
    }
    Paren => {
      return hoistSafeExpr(e.parInner, fnIx)
    }
    IsExpr => {
      return hoistSafeExpr(isExprKid(e), fnIx)
    }
    AsExpr => {
      return hoistSafeExpr(e.asObj, fnIx)
    }
    Member => {
      return hoistSafeExpr(e.memObj, fnIx)
    }
    Index => {
      if !hoistSafeExpr(e.idxArr, fnIx) { return false }
      return hoistSafeExpr(e.idxIndex, fnIx)
    }
    BinExpr => {
      if !hoistSafeExpr(e.binLeft, fnIx) { return false }
      return hoistSafeExpr(e.binRight, fnIx)
    }
    Call => {
      // A counted push of an open build region moves only its own fresh list, which nothing
      // else holds and the region never indexes (D3623).
      if !hoistSafeMemCall(ix, fnIx) && listBuildRegionOf(ix) < 0 {
        return false
      }
      const args = e.callArgs
      let a = 0
      while a < args.length {
        if !hoistSafeExpr(args[a], fnIx) { return false }
        a = a + 1
      }
      return true
    }
    // Every other expression is outside the hoist whitelist.
    OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  return false
}

// The statement half of the whitelist. The fall-through hands an unrecognised
// statement to the EXPRESSION walk (a bare expression statement is how an
// assignment and a call both appear), which declines anything it does not know.
function hoistSafeStmt(ix: i32, fnIx: i32): boolean {
  if ix < 0 { return true }
  const s = nodeAt(ix)
  if s is LetDecl { return hoistSafeExpr(s.letInit, fnIx) }
  if s is RetStmt { return hoistSafeExpr(s.retArg, fnIx) }
  if s is BreakStmt { return true }
  if s is ContinueStmt { return true }
  if s is Block { return hoistSafeBlock(ix, fnIx) }
  if s is IfStmt {
    if !hoistSafeExpr(s.ifCond, fnIx) { return false }
    if !hoistSafeStmt(s.ifThen, fnIx) { return false }
    return hoistSafeStmt(s.ifElse, fnIx)
  }
  if s is WhileStmt {
    if !hoistSafeExpr(s.whileCond, fnIx) { return false }
    return hoistSafeStmt(s.whileBody, fnIx)
  }
  if s is ForRange {
    if !hoistSafeExpr(s.frFrom, fnIx) { return false }
    if !hoistSafeExpr(s.frTo, fnIx) { return false }
    if !hoistSafeExpr(s.frStep, fnIx) { return false }
    return hoistSafeStmt(s.frBody, fnIx)
  }
  if s is ForIn {
    if !hoistSafeExpr(s.fiIter, fnIx) { return false }
    return hoistSafeStmt(s.fiBody, fnIx)
  }
  return hoistSafeExpr(ix, fnIx)
}

// Every loop asks both walks of its whole body, so a loop nest would cost the square of its
// depth; the answers are kept per block for one function (D2190). `hmSafe` holds
// `hoistSafeBlock`'s, and `hmNoIdx` the blocks in which `hoistScanExpr` found no index at all.
let hmFn = -2
let hmSafe: {[i32]: boolean} = Map()
let hmNoIdx: {[i32]: boolean} = Map()
let hmIdxSeen = 0

// Start the memos over when the function changes; `emitFuncBody` forces it with `-2`.
function hoistMemoFor(fnIx: i32) {
  if hmFn != fnIx {
    hmFn = fnIx
    hmSafe = Map()
    hmNoIdx = Map()
  }
  return 0
}

function hoistSafeBlock(ix: i32, fnIx: i32): boolean {
  if ix < 0 { return false }
  const b = nodeAt(ix)
  if b is Block {
    hoistMemoFor(fnIx)
    const known = hmSafe[ix]
    if known != null { return known }
    const stmts = b.blkStmts
    let safe = true
    let i = 0
    while safe && i < stmts.length {
      if !hoistSafeStmt(stmts[i], fnIx) { safe = false }
      i = i + 1
    }
    hmSafe[ix] = safe
    return safe
  }
  return false
}

// True when declaration `d` is assigned anywhere in the expression at `ix` — only an `x = …`
// rebinds in an expression, and one whose target resolves to no declaration counts. Runs
// over an already whitelisted body, so the enumeration matches `hoistSafeExpr`'s exactly.
function exprRebindsDecl(ix: i32, d: i32): boolean {
  if ix < 0 { return false }
  const e = nodeAt(ix)
  match e {
    BinExpr => {
      if e.binOp == "=" {
        const lhs = nodeAt(e.binLeft)
        if lhs is Ident {
          const ld = identDeclOf(e.binLeft)
          if ld < 0 || hoistDeclKey(ld) == d { return true }
        }
      }
      if exprRebindsDecl(e.binLeft, d) { return true }
      return exprRebindsDecl(e.binRight, d)
    }
    Unary => {
      return exprRebindsDecl(e.unArg, d)
    }
    Paren => {
      return exprRebindsDecl(e.parInner, d)
    }
    IsExpr => {
      return exprRebindsDecl(isExprKid(e), d)
    }
    AsExpr => {
      return exprRebindsDecl(e.asObj, d)
    }
    Member => {
      return exprRebindsDecl(e.memObj, d)
    }
    Index => {
      if exprRebindsDecl(e.idxArr, d) { return true }
      return exprRebindsDecl(e.idxIndex, d)
    }
    Call => {
      if exprRebindsDecl(e.callFn, d) { return true }
      const args = e.callArgs
      let a = 0
      while a < args.length {
        if exprRebindsDecl(args[a], d) { return true }
        a = a + 1
      }
    }
    // No other expression the whitelist admits can rebind a name.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  return false
}

// True when declaration `d` is declared or assigned anywhere in the statement at `ix`: a
// `let`/`const` or a loop variable that is `d`, or an assignment to it. Either means the body's
// `d` is not the wrapper the prologue cached.
function stmtRebindsDecl(ix: i32, d: i32): boolean {
  if ix < 0 { return false }
  const s = nodeAt(ix)
  if s is LetDecl {
    if hoistDeclKey(ix) == d { return true }
    return exprRebindsDecl(s.letInit, d)
  }
  if s is RetStmt { return exprRebindsDecl(s.retArg, d) }
  if s is BreakStmt { return false }
  if s is ContinueStmt { return false }
  if s is Block { return blockRebindsDecl(ix, d) }
  if s is IfStmt {
    if exprRebindsDecl(s.ifCond, d) { return true }
    if stmtRebindsDecl(s.ifThen, d) { return true }
    return stmtRebindsDecl(s.ifElse, d)
  }
  if s is WhileStmt {
    if exprRebindsDecl(s.whileCond, d) { return true }
    return stmtRebindsDecl(s.whileBody, d)
  }
  if s is ForRange {
    if hoistDeclKey(ix) == d { return true }
    if exprRebindsDecl(s.frFrom, d) { return true }
    if exprRebindsDecl(s.frTo, d) { return true }
    if exprRebindsDecl(s.frStep, d) { return true }
    return stmtRebindsDecl(s.frBody, d)
  }
  if s is ForIn {
    if hoistDeclKey(s.fiDecl1) == d || hoistDeclKey(s.fiDecl2) == d {
      return true
    }
    if exprRebindsDecl(s.fiIter, d) { return true }
    return stmtRebindsDecl(s.fiBody, d)
  }
  return exprRebindsDecl(ix, d)
}

function blockRebindsDecl(ix: i32, d: i32): boolean {
  if ix < 0 { return false }
  const b = nodeAt(ix)
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      if stmtRebindsDecl(stmts[i], d) { return true }
      i = i + 1
    }
  }
  return false
}

// Record one index receiver (`d`, `prop`) and the `Index` node it is first seen on. The
// representative node is what the rep classifiers are asked about later, so the first
// sighting is kept — every later sighting of the same receiver reads the same binding.
function hoistScanAdd(d: i32, prop: string, idxIx: i32) {
  let i = 0
  while i < lhScanRoot.length {
    if lhScanRoot[i] == d && lhScanProp[i] == prop { return 0 }
    i = i + 1
  }
  lhScanRoot.push(d)
  lhScanProp.push(prop)
  lhScanRep.push(idxIx)
  return 0
}

function hoistScanExpr(ix: i32) {
  if ix < 0 { return 0 }
  const e = nodeAt(ix)
  match e {
    Index => {
      hmIdxSeen = hmIdxSeen + 1
      const pd = hoistPathDecl(e.idxArr)
      if pd >= 0 { hoistScanAdd(pd, hoistPathProp(e.idxArr), ix) }
      hoistScanExpr(e.idxArr)
      hoistScanExpr(e.idxIndex)
      return 0
    }
    Unary => {
      return hoistScanExpr(e.unArg)
    }
    Paren => {
      return hoistScanExpr(e.parInner)
    }
    IsExpr => {
      return hoistScanExpr(isExprKid(e))
    }
    AsExpr => {
      return hoistScanExpr(e.asObj)
    }
    Member => {
      return hoistScanExpr(e.memObj)
    }
    BinExpr => {
      hoistScanExpr(e.binLeft)
      return hoistScanExpr(e.binRight)
    }
    Call => {
      hoistScanExpr(e.callFn)
      const args = e.callArgs
      let a = 0
      while a < args.length {
        hoistScanExpr(args[a])
        a = a + 1
      }
    }
    // No other expression holds an index the guard can hoist.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  return 0
}

function hoistScanStmt(ix: i32) {
  if ix < 0 { return 0 }
  const s = nodeAt(ix)
  if s is LetDecl { return hoistScanExpr(s.letInit) }
  if s is RetStmt { return hoistScanExpr(s.retArg) }
  if s is Block { return hoistScanBlock(ix) }
  if s is IfStmt {
    hoistScanExpr(s.ifCond)
    hoistScanStmt(s.ifThen)
    return hoistScanStmt(s.ifElse)
  }
  if s is WhileStmt {
    hoistScanExpr(s.whileCond)
    return hoistScanStmt(s.whileBody)
  }
  if s is ForRange {
    hoistScanExpr(s.frFrom)
    hoistScanExpr(s.frTo)
    hoistScanExpr(s.frStep)
    return hoistScanStmt(s.frBody)
  }
  if s is ForIn {
    hoistScanExpr(s.fiIter)
    return hoistScanStmt(s.fiBody)
  }
  return hoistScanExpr(ix)
}

function hoistScanBlock(ix: i32) {
  if ix < 0 { return 0 }
  const b = nodeAt(ix)
  if b is Block {
    if hmNoIdx.has(ix) { return 0 }
    const seen = hmIdxSeen
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      hoistScanStmt(stmts[i])
      i = i + 1
    }
    if hmIdxSeen == seen { hmNoIdx[ix] = true }
  }
  return 0
}

// Resolve the list rep of an index receiver into a hoist row, or -1 when this receiver
// is not one of the reps the guard hoists. The cascade mirrors `emitIndex`'s own order,
// so a row is only minted for a rep whose access path the hoisted guard can actually
// serve; the nullable arms, checked first exactly as there, decline.
function hoistRowOfRecv(recvIx: i32, d: i32, prop: string, fnIx: i32) {
  // A cell that can hold null declines, however the read narrows: the prologue reads the
  // header above the null guard, and in a loop condition in front of `ref.is_null`.
  if readCellHoldsNullRef(recvIx, fnIx) { return 0 - 1 }
  if exprRefArray(recvIx, fnIx) {
    if !rlRowsMinted() { return 0 - 1 }
    return listHoistRow(d, prop, "reflist", refListSlotOfExpr(recvIx, fnIx))
  }
  if exprNulStrArray(recvIx, fnIx) || exprStringArray(recvIx, fnIx) {
    return listHoistRow(d, prop, "strlist", 0)
  }
  const ek = scalarListElemKind(recvIx, fnIx)
  if ek != null {
    if !scalarListUsed(ek) { return 0 - 1 }
    return listHoistRow(d, prop, listIdxKindOf(ek), exprPackedRow(recvIx, fnIx))
  }
  // A raw string receiver is checked last, after every list rep, so `exprString` never
  // gets a chance to answer for one. The `| null` niche declines too, for the same reason
  // `exprNullableList` does: the prologue would read the header above the null guard and
  // trap on a null receiver. `exprNullableString` is strictly wider than `exprString`.
  if exprString(recvIx, fnIx) {
    if exprNullableString(recvIx, fnIx) { return 0 - 1 }
    return strHoistRow(d, prop)
  }
  return 0 - 1
}

// The wrapper struct type index a row's header is read out of — the mirror of
// `hoistRowOfRecv`'s rep decision, and the type the prologue's two `struct.get`s
// carry.
function hoistWrapTyOfRow(row: i32) {
  const k = lhKind[row]
  if k == "reflist" { return rlWrapIdx[lhSlot[row]] }
  if k == "strlist" { return mkListTy() }
  const nek = numListElemOf(k)
  if nek != null { return scalarListWrap(nek, 0) }
  // The PACKED byte list's frame kind is `"u8list"` (`listIdxKindOf`), and its wrapper is
  // `$bl8TypeIdx` — the i32 fall-through below would name the 4-byte list's wrapper for a
  // row whose local is typed `(ref null $bl8TypeIdx)`.
  if k == "u8list" {
    if row < 0 || row >= lhSlot.length { return -1 }
    return scalarListWrap("u8list", lhSlot[row])
  }
  return scalarListWrap("i32", 0)
}

// A receiver a loop's prologue may hoist: list read `hcRecv`, held to root declaration `hcRoot`
// and field `hcProp` ("" for the root itself).
export type HoistCand = { hcRecv: i32, hcRoot: i32, hcProp: string }

// The receivers whose headers the prologue of the loop over `condIx` and `bodyIx` may hoist: no
// rebinding of the root (bar the loop's own `ownDecl`/`ownDecl2`), no write of the field, and a
// field receiver that reads as one plain `struct.get`. The condition re-runs every iteration, so
// it is held to the body's own hoist-safety standard.
export function loopHoistCands(
  condIx: i32,
  bodyIx: i32,
  fnIx: i32,
  ownDecl: i32,
  ownDecl2: i32,
): HoistCand[] {
  const out: HoistCand[] = []
  if !hoistSafeExpr(condIx, fnIx) { return out }
  if !hoistSafeBlock(bodyIx, fnIx) { return out }
  lhScanRoot = []
  lhScanProp = []
  lhScanRep = []
  hoistScanExpr(condIx)
  hoistScanBlock(bodyIx)
  const own = hoistDeclKey(ownDecl)
  const own2 = hoistDeclKey(ownDecl2)
  let i = 0
  while i < lhScanRoot.length {
    const root = lhScanRoot[i]
    const prop = lhScanProp[i]
    const scanned = nodeAt(lhScanRep[i])
    let ok = root != own && root != own2
    if ok && exprRebindsDecl(condIx, root) { ok = false }
    if ok && blockRebindsDecl(bodyIx, root) { ok = false }
    if ok && prop != "" {
      if stmtAssignsProp(condIx, prop) || stmtAssignsProp(bodyIx, prop) {
        ok = false
      }
      if ok && scanned is Index {
        if !hoistFieldRecvOk(scanned.idxArr, fnIx) { ok = false }
      }
    }
    if ok && scanned is Index {
      out.push({ hcRecv: scanned.idxArr, hcRoot: root, hcProp: prop })
    }
    i = i + 1
  }
  return out
}

// The header row the prologue opens for `c`, or -1: no row, a view a store in the loop would
// leave stale (D3028), or a row an enclosing loop already holds.
export function hoistCandRow(
  c: HoistCand,
  condIx: i32,
  bodyIx: i32,
  fnIx: i32,
): i32 {
  if svHoistBlocked(c.hcRecv, fnIx, condIx, bodyIx) { return -1 }
  const row = hoistRowOfRecv(c.hcRecv, c.hcRoot, c.hcProp, fnIx)
  if row < 0 || lhLive[row] != 0 { return -1 }
  return row
}

// After read `k` of row `row`'s receiver `recvIx`: that header field into its local. A raw
// string's header is `{backing, start, len}`, three reads; a list's `{backing, len}`, two.
export function hoistReadTail(row: i32, k: i32, recvIx: i32, fnIx: i32) {
  if hoistRowIsStr(row) {
    if k == 0 {
      fbStrBack()
      fbLocalSet(lhBack[row])
    } else if k == 1 {
      fbStrStart()
      fbLocalSet(lhStart[row])
    } else {
      fbStrLen()
      fbLocalSet(lhLen[row])
    }
    return 0
  }
  const wrapTy = hoistWrapTyOfRow(row)
  if k == 0 {
    svSyncRecv(recvIx, fnIx)
    fbStructGet(wrapTy, 0) // field 0: backing
    fbLocalSet(lhBack[row])
  } else {
    fbStructGet(wrapTy, 1) // field 1: len
    fbLocalSet(lhLen[row])
  }
  return 0
}

// How many times the prologue of header row `row` reads its receiver: a raw string's three
// fields, a list's two.
export function hoistRowReads(row: i32): i32 {
  return if hoistRowIsStr(row) { 3 } else { 2 }
}

// Marks header row `row` open, for this loop's `loopHoistClose`.
export function hoistRowMark(row: i32) {
  lhLive[row] = 1
  lhOpen.push(row)
  return 0
}

// Opens the header hoists of the loop over `condIx` and `bodyIx`, each receiver read by legacy.
// Returns how many rows it opened (the `loopHoistClose` argument), or -1.
export function loopHoistOpen(
  condIx: i32,
  bodyIx: i32,
  fnIx: i32,
  ownDecl: i32,
  ownDecl2: i32,
) {
  let opened = 0
  for c in loopHoistCands(condIx, bodyIx, fnIx, ownDecl, ownDecl2) {
    const row = hoistCandRow(c, condIx, bodyIx, fnIx)
    if row >= 0 {
      let k = 0
      while k < hoistRowReads(row) {
        if emitExpr(c.hcRecv, fnIx) < 0 { return -1 }
        hoistReadTail(row, k, c.hcRecv, fnIx)
        k = k + 1
      }
      hoistRowMark(row)
      opened = opened + 1
    }
  }
  return opened
}

// The live list (not raw-string) hoist row cached for receiver (`d`, `prop`), or -1.
function liveListRowOf(d: i32, prop: string) {
  let k = 0
  while k < lhRoot.length {
    if (
      lhLive[k] > 0
      && lhRoot[k] == d
      && lhProp[k] == prop
      && !hoistRowIsStr(k)
    ) {
      return k
    }
    k = k + 1
  }
  return 0 - 1
}

// Whether `ix` is a non-negative i32 integer literal.
function exprIsNonNegIntLit(ix: i32) {
  if ix < 0 { return false }
  const e = nodeAt(ix)
  if e is NumLit {
    return !numLexIsFloat(e.numText)
      && numLexFitsI32(e.numText)
      && parseI32(e.numText) >= 0
  }
  return false
}

// The receiver whose length bounds a range loop's top, or -1: `xs.length` under `until`,
// `xs.length - 1` under `to`. Either way every value the loop variable takes is `< len`.
function rangeTopLenOf(s: ForRange) {
  let top = s.frTo
  if !s.frExcl {
    if top < 0 { return 0 - 1 }
    const b = nodeAt(top)
    if b is BinExpr {
      if b.binOp != "-" { return 0 - 1 }
      const one = nodeAt(b.binRight)
      if one is NumLit {
        if one.numText != "1" { return 0 - 1 }
      } else {
        return 0 - 1
      }
      top = b.binLeft
    } else {
      return 0 - 1
    }
  }
  if top < 0 { return 0 - 1 }
  const m = nodeAt(top)
  if m is Member {
    if m.memProp != "length" { return 0 - 1 }
    return m.memObj
  }
  return 0 - 1
}

// Open a range proof for `for v in A until xs.length` (or `to xs.length - 1`) with a constant
// positive step, `A` a non-negative literal, `v` never rebound in the body, and `xs` served by
// a live hoist row — whose `len` cannot move while the row is live. `sIx` is the loop, the
// declaration of `v`. Returns the count pushed.
function rangeProofOpen(s: ForRange, sIx: i32, stepK: i32, dynStep: boolean) {
  if dynStep || stepK <= 0 { return 0 }
  if !exprIsNonNegIntLit(s.frFrom) { return 0 }
  const recv = rangeTopLenOf(s)
  const d = hoistPathDecl(recv)
  if d < 0 { return 0 }
  const row = liveListRowOf(d, hoistPathProp(recv))
  if row < 0 { return 0 }
  const v = hoistDeclKey(sIx)
  if blockRebindsDecl(s.frBody, v) { return 0 }
  rpDecl.push(v)
  rpRow.push(row)
  return 1
}

function rangeProofClose(n: i32) {
  let i = 0
  while i < n {
    rpDecl.pop()
    rpRow.pop()
    i = i + 1
  }
  return 0
}

// Whether index expression `idxIx` over hoist row `row` is a range-proven loop variable.
function rangeProvenIndex(row: i32, idxIx: i32) {
  if idxIx < 0 { return false }
  const e = nodeAt(idxIx)
  if e is Ident {
    const d = identDeclOf(idxIx)
    if d < 0 { return false }
    const v = hoistDeclKey(d)
    let k = rpDecl.length - 1
    while k >= 0 {
      if rpDecl[k] == v { return rpRow[k] == row }
      k = k - 1
    }
  }
  return false
}

// Close the `n` rows this loop opened, innermost first.
export function loopHoistClose(n: i32) {
  let i = 0
  while i < n {
    const row = lhOpen[lhOpen.length - 1]
    lhOpen.pop()
    lhLive[row] = 0
    i = i + 1
  }
  return 0
}

// A shared cell's read `c[0]` at `idxIx` whose binding's name is narrowed to `null` there.
export function idxCellReadIsNull(idxIx: i32, fnIx: i32): boolean {
  return cboxReadTy.has(idxIx) && isNullTy(readNarrowedTyAt(idxIx, fnIx))
}

// The arm `emitIndex` lowers read `nd` by, from its receiver's rep, in the order the reps must be
// asked: the nullable and string-element lists before the plain scalar list, which does not see
// through either. A shared cell's null read is asked before this.
export type IdxArm = "twolists"
  | "nulscalar"
  | "ref"
  | "nulstr"
  | "str"
  | "scalar"
  | "string"
  | "none"

export function idxArmOf(nd: Index, fnIx: i32): IdxArm {
  if twoListUseMsg(nd.idxArr, OP_INDEX_GET, fnIx) != "" { return "twolists" }
  if exprNulScalarListKind(nd.idxArr, fnIx) != null { return "nulscalar" }
  if exprRefArray(nd.idxArr, fnIx) { return "ref" }
  if exprNulStrArray(nd.idxArr, fnIx) { return "nulstr" }
  if exprStringArray(nd.idxArr, fnIx) { return "str" }
  if scalarListElemKind(nd.idxArr, fnIx) != null { return "scalar" }
  if exprString(nd.idxArr, fnIx) { return "string" }
  return "none"
}

function emitIndex(idxIx: i32, fnIx: i32) {
  const nd = nodeAt(idxIx)
  // An element read an arm overrides is that arm's unboxed payload.
  if luOvLocNodes.length > 0 {
    const ovl = luOvLocalOf(idxIx)
    if ovl >= 0 {
      fbLocalGet(ovl)
      return 0
    }
  }
  const lux = emitArmSite(idxIx, fnIx)
  if lux != 0 { return if lux < 0 { -1 } else { 0 } }
  if nd is Index {
    // A shared cell's read is its binding's name read respelled, so one narrowed to `null`
    // delivers that null as `emitIdentNode` does (D15951).
    if idxCellReadIsNull(idxIx, fnIx) {
      if emitNullReadAtDst(idxIx, fnIx) { return 0 }
    }
    return match idxArmOf(nd, fnIx) {
      "twolists" => emitFailAt(twoListUseMsg(nd.idxArr, OP_INDEX_GET, fnIx), idxIx)
      "nulscalar" => emitIndexNulScalarList(nd, fnIx)
      "ref" => emitIndexRefList(nd, idxIx, fnIx)
      // A `(string | null)[]` element stays nullable unless the checker types it non-null.
      "nulstr" => emitIndexStrList(nd, fnIx, strListReadsNonNull(idxIx, true))
      "str" => emitIndexStrList(nd, fnIx, strListReadsNonNull(idxIx, false))
      "scalar" => emitIndexScalarList(nd, fnIx)
      "string" => emitIndexRawString(nd, fnIx)
      "none" => emitFail("emitProgram: index receiver is not an array or string")
    }
  }
  return emitFail("emitProgram: expected an index access")
}

// A string list's element, recovered non-null when `nonNull`.
function emitIndexStrList(nd: Index, fnIx: i32, nonNull: boolean): i32 {
  const slHz = strListHoistOf(nd)
  if slHz < 0 {
    if emitExpr(nd.idxArr, fnIx) < 0 { return -1 }
  }
  if emitExpr(nd.idxIndex, fnIx) < 0 { return -1 }
  return strListGetTail(nd, slHz, nonNull)
}

// Whether string list read `idxIx` recovers its element non-null: always for a `string[]`, and for
// a `(string | null)[]` (`nulstr`) only where the checker types the read non-null.
export function strListReadsNonNull(idxIx: i32, nulstr: boolean): boolean {
  return !nulstr || nodeTyProvesNonNull(idxIx)
}

// The string list read in two halves around its operands, as the scalar read's are: the live
// loop hoist holding receiver `nd`, or -1; under one the receiver is not written.
export function strListHoistOf(nd: Index): i32 {
  return liveHoistRow(nd.idxArr, "strlist", 0)
}

// The half after the operands: the `i u< len` guard and the backing's `array.get`, then the
// element recovered non-null when `nonNull`.
export function strListGetTail(nd: Index, slHz: i32, nonNull: boolean): i32 {
  if slHz >= 0 {
    emitListIdxGuardHoisted(slHz, nd.idxIndex)
  } else {
    emitListIdxGuard(listIdxWrapSlot("strlist", 0), mkListTy())
  }
  fbArrayGet(mkArrTy()) // 0xfb 0x0b <string backing array type index>
  if nonNull { fbRefAsNonNull() }
  return 0
}

// A raw string `s[i]` — the receiver is a header, so the read is `backing[start + i]` behind the
// `i u< len` guard. A binding with a live loop-hoisted header skips the receiver entirely.
function emitIndexRawString(nd: Index, fnIx: i32): i32 {
  const shz = rawStrHoistOf(nd.idxArr)
  if shz < 0 {
    if emitExpr(nd.idxArr, fnIx) < 0 { return -1 }
  }
  if emitExpr(nd.idxIndex, fnIx) < 0 { return -1 }
  return rawStrGetTail(shz)
}

// The raw string read in two halves around its operands, as the list reads are: the live loop
// hoist holding the header of string receiver `recvIx`, or -1.
export function rawStrHoistOf(recvIx: i32): i32 {
  return liveHoistRow(recvIx, "list", 0 - 1)
}

// The half after the operands: the guard, over the hoisted header or the receiver's, then the
// backing's `array.get`.
export function rawStrGetTail(shz: i32): i32 {
  if shz >= 0 { emitStrIdxGuardHoisted(shz) } else { emitStrIdxGuard() }
  fbArrayGet(sBackTy()) // 0xfb 0x0b <string backing array type index>
  return 0
}

// A DISTINCT-backing nullable scalar list `t[i]`, narrowed inside `if t != null`: the slot is
// `(ref null $wrapper)`, so it recovers non-null (the guard proved it present) and reads as the
// leaf list. Returns 0, or -1 when an operand fails.
function emitIndexNulScalarList(nd: Index, fnIx: i32): i32 {
  const nsk = exprNulScalarListKind(nd.idxArr, fnIx)
  if emitExpr(nd.idxArr, fnIx) < 0 { return -1 }
  fbRefAsNonNull() // (the `!= null` guard makes this safe)
  if emitExpr(nd.idxIndex, fnIx) < 0 { return -1 }
  if nsk == "nulstrlist" {
    emitListIdxGuard(listIdxWrapSlot("strlist", 0), mkListTy())
    fbArrayGet(mkArrTy()) // 0xfb 0x0b string backing
    // A nullable-element inner list (`(string | null)[] | null`, narrowed): the
    // element legitimately holds null, so the read stays `(ref null $aTypeIdx)` — an
    // unconditional non-null recover here is correct only for `string[] | null` (whose
    // elements are never null), and traps otherwise. `exprNulStrArray` resolves this.
    if exprNulStrArray(nd.idxArr, fnIx) { return 0 }
    fbRefAsNonNull() // (non-null string element)
    return 0
  }
  // `nek` names the leaf element kind whose wrapper / backing / index-scratch pool this
  // read uses; `u8list` is the packed-byte leaf's spelling (the element is a plain i32,
  // so the kind names the list, not a scalar).
  const nek = if nsk == null { null } else { scalarListElemOfListKind(nulListBase(nsk) ?? "i32") }
  if nek == null {
    return emitFail(
      "emitProgram: a nullable scalar list read has no element kind",
    )
  }
  const nsv = svDstOfKind(nek)
  if nsv >= 0 { return emitSvIndexRead(nek, nsv) }
  const nrow = exprPackedRow(nd.idxArr, fnIx)
  emitListIdxGuard(
    listIdxWrapSlot(listIdxKindOf(nek), nrow),
    scalarListWrap(nek, nrow),
  )
  fbArrayGet(scalarListBack(nek, exprPackedRow(nd.idxArr, fnIx))) // yields the element in its rep
  return 0
}

// A REF list `xs[i]` at index node `idxIx`: unwrap to its `(ref null $elem)` backing,
// `array.get`, then `ref.as_non_null` (`0xd4`) to surface the non-null element (a struct ref /
// union box) — slots in `[0,len)` are always populated, so the cast never traps. Returns 0, or
// -1 on a refusal or a failed operand.
function emitIndexRefList(nd: Index, idxIx: i32, fnIx: i32): i32 {
  if !rlRowsMinted() {
    return emitFail(
      "emitProgram: ref index access but ref array type not collected",
    )
  }
  const rslot = refListSlotOfExpr(nd.idxArr, fnIx)
  if rslot < 0 { return refListRowRefused(nd.idxArr) }
  const rlHz = refListHoistOf(nd, rslot)
  if rlHz < 0 {
    if emitExpr(nd.idxArr, fnIx) < 0 { return -1 }
    // A NULLABLE ref-array receiver (`t: i32[][] | null`, kind 18, narrowed) reads `(ref null …)` —
    // recover non-null before `struct.get` (the `if t != null` guard makes this safe).
    if exprNullableRefArray(nd.idxArr, fnIx) { fbRefAsNonNull() }
  }
  if emitExpr(nd.idxIndex, fnIx) < 0 { return -1 }
  return refListGetTail(nd, idxIx, fnIx, rslot, rlHz)
}

// The ref list read both emitters write, in two halves around its operands, as the scalar
// read's are. This half: the live loop hoist holding receiver `nd` of ref-list row `rslot`, or
// -1; under one the receiver is not written.
export function refListHoistOf(nd: Index, rslot: i32): i32 {
  return liveHoistRow(nd.idxArr, "reflist", rslot)
}

// The half after the receiver and index: the guard and the backing's `array.get` (or a view's
// read through its source, D3041), then the element: kept nullable for a nullable niche, else
// recovered non-null, retagged and unboxed where its place narrows.
export function refListGetTail(
  nd: Index,
  idxIx: i32,
  fnIx: i32,
  rslot: i32,
  rlHz: i32,
): i32 {
  if rlHz >= 0 {
    emitListIdxGuardHoisted(rlHz, nd.idxIndex)
    fbArrayGet(rlBackIdx[rslot]) // 0xfb 0x0b <this slot's ref backing array>
  } else if rvMayView(rslot) {
    emitRvIndexRead(rslot)
  } else {
    emitListIdxGuard(listIdxWrapSlot("reflist", rslot), rlWrapIdx[rslot])
    fbArrayGet(rlBackIdx[rslot]) // 0xfb 0x0b <this slot's ref backing array>
  }
  // A nullable-niche element legitimately holds null, so the read stays `(ref null
  // $elem)` with no `ref.as_non_null` recover (the caller narrows with `e != null`).
  // `listElemStaysNullable` is the shared answer — `.map`/`.filter`'s element step asks
  // it too, and answering it differently in the two places is a recover that traps in one.
  if listElemStaysNullable(nd.idxArr, fnIx) {
    // …UNLESS the index PLACE itself is narrowed non-null (D451). The guard is what makes the
    // recovery safe, exactly as the kind-18 receiver recovery above is.
    if nodeTyProvesNonNull(idxIx) { fbRefAsNonNull() }
    return 0
  }
  fbRefAsNonNull() // (recover the non-null element)
  if emitStaleBoxRetag(rslot, idxIx) < 0 { return -1 }
  // A union-box cell whose index place is narrowed to one scalar atom unboxes here
  // (D451): without it `vl check` proves `xs[0]` non-null and every classifier calls it
  // an `i32`, but this arm still leaves the raw `(ref $uBox)` for an unboxed consumer —
  // invalid wasm. Routed through the shared `emitUnionUnboxTail`, not an open-coded unbox.
  const iCon = emitPlaceNarrowContainerUnbox(idxIx, fnIx)
  if iCon != 0 { return iCon - 1 }
  if indexElemUnionName(idxIx, fnIx) != "" {
    const iuk = idxNarrowAtomKind(idxIx, fnIx)
    if iuk >= 0 && iuk != nullValKind() { return emitUnionUnboxTail(iuk) }
  }
  return 0
}

// A SCALAR list `xs[i]`: unwrap to its backing and `array.get <back>`,
// yielding the element in its valtype rep. Returns 0, or -1 on a refusal or a failed operand.
function emitIndexScalarList(nd: Index, fnIx: i32): i32 {
  const ek = scalarListElemKind(nd.idxArr, fnIx)
  if ek == null || !scalarListUsed(ek) {
    return emitFail("emitProgram: index access but list type not collected")
  }
  const hz = scalarListHoistOf(nd, ek, fnIx)
  if hz < 0 {
    if emitExpr(nd.idxArr, fnIx) < 0 { return -1 }
  }
  if emitExpr(nd.idxIndex, fnIx) < 0 { return -1 }
  return scalarListGetTail(nd, ek, fnIx, hz)
}

// The scalar list read both emitters write, in two halves around its operands. This half: the
// live loop hoist holding the receiver, or -1; under one the receiver is not written.
export function scalarListHoistOf(nd: Index, ek: VKind, fnIx: i32): i32 {
  return liveHoistRow(
    nd.idxArr,
    listIdxKindOf(ek),
    exprPackedRow(nd.idxArr, fnIx),
  )
}

// The half after the receiver and index (`hz` from `scalarListHoistOf`): the guard, over the
// hoisted header or the wrapper, then the backing's `array.get`; a possible view reads through its
// source.
export function scalarListGetTail(
  nd: Index,
  ek: VKind,
  fnIx: i32,
  hz: i32,
): i32 {
  const row = exprPackedRow(nd.idxArr, fnIx)
  // A list that may be a view reads its element through the view's source (D3028).
  const ixSv = svDstOfKind(ek)
  if ixSv >= 0 && hz < 0 { return emitSvIndexRead(ek, ixSv) }
  if hz >= 0 {
    emitListIdxGuardHoisted(hz, nd.idxIndex)
  } else {
    emitListIdxGuard(
      listIdxWrapSlot(listIdxKindOf(ek), row),
      scalarListWrap(ek, row),
    )
  }
  fbArrayGet(scalarListBack(ek, row)) // yields the element in its rep
  return 0
}

// Lower a `.length` onto `body`: a list's length is its wrapper's `len` field (not the
// backing's physical length, which is `cap`) via `struct.get <wrap> 1`; a raw string's
// `.length` is its header's `len` field (`fbStrLen()`), not `array.len` — which would
// report the parent's length for a view. Each element kind is resolved in its own arm.
function emitArrLen(memIx: i32, fnIx: i32) {
  const m = nodeAt(memIx)
  if m is Member {
    const hz = arrLenHoistOf(m, fnIx)
    if hz >= 0 { return emitArrLenHeld(hz) }
    if emitExpr(m.memObj, fnIx) < 0 { return -1 }
    return arrLenTail(m, fnIx)
  }
  return emitFail("emitProgram: expected a length access")
}

// The `.length` both emitters write, in two halves around its receiver. This half: the live
// loop hoist whose cached `len` answers it, or -1. Only a list that may be a view keeps reading
// its header here, since a view's `len` is not its wrapper's.
export function arrLenHoistOf(m: Member, fnIx: i32): i32 {
  // Outside a hoisting loop no row is live, which most `.length`s are.
  if lhOpen.length == 0 { return -1 }
  if exprRefArray(m.memObj, fnIx) {
    const rslot = refListSlotOfExpr(m.memObj, fnIx)
    if rslot < 0 || rslot >= rlWrapIdx.length || !rvMayView(rslot) { return -1 }
    return liveHoistRow(m.memObj, "reflist", rslot)
  }
  if exprStringArray(m.memObj, fnIx) { return -1 }
  const lek = arrLenWideKind(m, fnIx)
  if lek == null || svDstOfKind(lek) < 0 { return -1 }
  return liveHoistRow(
    m.memObj,
    listIdxKindOf(lek),
    exprPackedRow(m.memObj, fnIx),
  )
}

// A held `.length`: the hoist row's cached `len`.
export function emitArrLenHeld(hz: i32) {
  fbLocalGet(lhLen[hz])
  return 0
}

// The element kind of a scalar list whose wrapper is not the i32 list's, or null.
function arrLenWideKind(m: Member, fnIx: i32): VKind | null {
  const lek = scalarListElemKind(m.memObj, fnIx)
  if (
    lek == "f64"
    || lek == "i64"
    || lek == "f32"
    || lek == "v128"
    || lek == "u8list"
  ) {
    return lek
  }
  return null
}

// The half after the receiver: its `len` field, through the view helper where it may be a view.
export function arrLenTail(m: Member, fnIx: i32): i32 {
  // A REF list's `.length` is its wrapper's `len` field (`struct.get $wrap 1`).
  if exprRefArray(m.memObj, fnIx) {
    const rslot = refListSlotOfExpr(m.memObj, fnIx)
    if rslot < 0 || rslot >= rlWrapIdx.length {
      return emitFailAt(
        "emitProgram: `.length` receiver's ref-list element does not resolve",
        m.memObj,
      )
    }
    if rvMayView(rslot) {
      const rwL = listIdxWrapSlot("reflist", rslot)
      fbLocalSet(rwL)
      rvTestView(rwL)
      fbIf(127) // i32
      fbLocalGet(rwL)
      fbCall(gHelpRvLen)
      fbElse()
      fbLocalGet(rwL)
      fbStructGet(rlWrapIdx[rslot], 1)
      fbEnd()
      return 0
    }
    fbStructGet(rlWrapIdx[rslot], 1) // 0xfb 0x02 <ref-list wrapper> field 1: len
    return 0
  }
  // A STRING list's `.length` is its wrapper's `len` field (`struct.get $mkListIdx 1`).
  if exprStringArray(m.memObj, fnIx) {
    fbStructGet(mkListTy(), 1) // 0xfb 0x02 <string-list wrapper> field 1: len
    return 0
  }
  // A SCALAR list's `.length` is its wrapper's `len` field — an i32, the same shape for every
  // element kind over that kind's wrapper.
  const lek = arrLenWideKind(m, fnIx)
  if lek != null {
    const lenSv = svDstOfKind(lek)
    if lenSv >= 0 {
      const lwL = listIdxWrapSlot(
        listIdxKindOf(lek),
        exprPackedRow(m.memObj, fnIx),
      )
      fbLocalSet(lwL)
      svTestView(lwL, lenSv)
      fbIf(127) // i32
      fbLocalGet(lwL)
      fbCall(gHelpSvLen[lenSv])
      fbElse()
      fbLocalGet(lwL)
      fbStructGet(scalarListWrap(lek, exprPackedRow(m.memObj, fnIx)), 1)
      fbEnd()
      return 0
    }
    fbStructGet(scalarListWrap(lek, exprPackedRow(m.memObj, fnIx)), 1) // field 1: len
    return 0
  }
  if exprArray(m.memObj, fnIx) {
    fbStructGet(lTy(), 1) // 0xfb 0x02 <list wrapper struct type index> field 1: len
    return 0
  }
  // A raw string's `.length` is the header's `len` field (`fbStrLen()`), not `array.len`. The
  // fallthrough fails loudly instead of defaulting, since a wrong one would be invalid wasm.
  if !exprString(m.memObj, fnIx) {
    return emitFail("emitProgram: .length receiver is not an array or string")
  }
  fbStrLen() // 0xfb 0x02 <string header> field 2: len
  return 0
}

// ── G6: string concatenation / value-equality / slice ────────────────────────
// A string is a `{backing, start, len}` view over a `(array (mut i32))` of code points;
// these lower via the same array machinery `.push` uses, with the header hoisted once
// into the shared string scratch frame — each routine evaluates both operands fully before any scratch `local.set`, which is what makes sharing one frame across nested ops safe.

// `local.get` of string scratch local `n` (0 = header A, 1 = header B, 2 = the Out BACKING —
// Stage 2b re-typed slot 2 from a finished string to the element array under construction).
function pushStrScrRef(n: i32) {
  fbLocalGet(strScratchBase + n) // 0x20 local.get
  return 0
}

// `local.get` of i32 scratch temp `n` (0..3 → frame slots +3..+6).
function pushStrScrI(n: i32) {
  fbLocalGet(strScratchBase + 3 + n) // 0x20 local.get
  return 0
}

// `local.set` of i32 scratch temp `n`.
function setStrScrI(n: i32) {
  fbLocalSet(strScratchBase + 3 + n) // 0x21 local.set
  return 0
}

// ── the string-op frame's hoist half ─────────────────────────────────────────
// A string is a header, so a loop reading `A[i]` per step would pay two `struct.get`s
// (backing, start) per trip; `hoistStrScr` reads them once into the frame's last four
// slots, safe because the header's fields are immutable and no string element store exists.

// Hoist operand `n` (0 = A, 1 = B) — its header must already be in `strScratchBase + n`.
function hoistStrScr(n: i32) {
  fbLocalGet(strScratchBase + n)
  fbStrBack()
  fbLocalSet(strScratchBase + 7 + n)
  fbLocalGet(strScratchBase + n)
  fbStrStart()
  fbLocalSet(strScratchBase + 9 + n)
  return 0
}

// Push `[backing_n, start_n]` for a hoisted operand — the caller adds its own index and
// closes with `array.get $sBackIdx`.
function pushStrScrBase(n: i32) {
  fbLocalGet(strScratchBase + 7 + n)
  fbLocalGet(strScratchBase + 9 + n)
  return 0
}

// `[.., i] -> [.., backing_n[start_n + i]]` is not expressible (the base has to go under the
// index), so this is the whole read for the common `operand[<i32 temp>]` shape: push the
// hoisted base, push temp `t`, add, read.
function pushStrScrElem(n: i32, t: i32) {
  pushStrScrBase(n)
  pushStrScrI(t)
  fbI32Bin(106) // 0x6a i32.add — start_n + t
  fbArrayGet(sBackTy())
  return 0
}

// Lower a string concatenation `a + b` onto `body`, leaving the new string ref on the
// stack: allocate a fresh `(array i32)` of `len(a) + len(b)`, `array.copy` a's code
// points into `[0, lenA)` and b's into `[lenA, lenA+lenB)`. Both operands are evaluated
// first, then stashed, so a nested string op fully completes before either write.
function emitStrConcat(binIx: i32, fnIx: i32) {
  if binIx < 0 { return -1 }
  const e = nodeAt(binIx)
  if e is BinExpr {
    // Three or more parts fuse: `a + b + c + d` is one `+` node per operand pair, so the
    // pairwise lowering would allocate and copy the accumulated prefix once per pair —
    // quadratic, and every string interpolation is such a chain. `strCatParts` flattens
    // the maximal chain and `emitStrCatN` buys it back with one sized allocation and copy.
    const parts: i32[] = []
    strCatParts(binIx, fnIx, parts)
    if binIx == ssArmRhs {
      ssArmRhs = -1
      return emitStrSiteCat(parts, ssArmMode, ssArmBin, fnIx)
    }
    // Every part reaches the stack first; a literal-union atom part widens to its member string.
    for x in parts {
      if emitStrValue(x, fnIx) < 0 { return -1 }
    }
    return strCatTail(parts.length)
  }
  return emitFail("emitProgram: expected a string concatenation")
}

// The parts of the maximal string `+` chain at `binIx`, left to right, in push order.
export function strCatPartsOf(binIx: i32, fnIx: i32): i32[] {
  const parts: i32[] = []
  strCatParts(binIx, fnIx, parts)
  return parts
}

// Joins the `n` string parts on the stack: two through the shared `__str_concat__` helper, more
// with one sized copy (`emitStrCatN`).
export function strCatTail(n: i32) {
  if n > 2 { return emitStrCatN(n) }
  fbCall(helpStrConcatFn())
  return 0
}

// Flatten the maximal string `+` chain rooted at `binIx` into its operand expressions,
// left to right, into `parts`. A node is chain-interior exactly when `exprIsStrConcat`
// claims it — the same predicate that routes `+` here — so the walk and the dispatch
// cannot disagree about where the chain ends. A `Paren` sub-chain keeps its own lowering.
function strCatParts(binIx: i32, fnIx: i32, parts: i32[]) {
  const e = nodeAt(binIx)
  if e is BinExpr {
    if exprIsStrConcat(e.binLeft, fnIx) {
      strCatParts(e.binLeft, fnIx, parts)
    } else {
      parts.push(e.binLeft)
    }
    if exprIsStrConcat(e.binRight, fnIx) {
      strCatParts(e.binRight, fnIx, parts)
    } else {
      parts.push(e.binRight)
    }
  }
  return 0
}

// Part slot `i` of the n-ary concat pool, minted on demand into the lazy list frame
// (`liBack` code 18) and cached for the rest of the function. One pool serves every
// nesting depth: `emitStrCatN` evaluates every part onto the stack before writing a
// single slot, so a nested chain has finished with the pool before the outer chain touches it.
function strCatSlot(i: i32) {
  while strCatSlotIx.length <= i {
    liKinds.push("list")
    liSlots.push(0)
    liBack.push(18)
    strCatSlotIx.push(listIdxScratchBase + liKinds.length)
  }
  return strCatSlotIx[i]
}

// Lower an n-part (n >= 3) string chain: evaluate the parts left to right (each exactly
// once, in source order), sum their lengths, allocate one exact-fit backing, `array.copy`
// each part in at a running offset, and wrap one header. All n values reach the stack
// first and are popped into slots deepest-last (§G6), so no scratch write straddles an operand evaluation.
function emitStrCatN(n: i32) {
  let j = n - 1
  while j >= 0 {
    fbLocalSet(strCatSlot(j))
    j = j - 1
  }
  fbLocalGet(strCatSlot(0))
  fbStrLen()
  let k = 1
  while k < n {
    fbLocalGet(strCatSlot(k))
    fbStrLen()
    fbI32Bin(106) // i32.add
    k = k + 1
  }
  fbLocalTee(strScratchBase + 3) // strScrI0 = the total length
  fbArrayNewDefault(sBackTy())
  fbLocalSet(strScratchBase + 2) // strScrOut = the one exact-fit backing
  fbI32Const(0)
  fbLocalSet(strScratchBase + 4) // strScrI1 = the running destination offset
  let m = 0
  while m < n {
    fbLocalGet(strScratchBase + 2)
    fbLocalGet(strScratchBase + 4)
    fbLocalGet(strCatSlot(m))
    fbStrBack()
    fbLocalGet(strCatSlot(m))
    fbStrStart()
    fbLocalGet(strCatSlot(m))
    fbStrLen()
    fbArrayCopy(sBackTy(), sBackTy())
    if m + 1 < n {
      fbLocalGet(strScratchBase + 4)
      fbLocalGet(strCatSlot(m))
      fbStrLen()
      fbI32Bin(106) // i32.add
      fbLocalSet(strScratchBase + 4)
    }
    m = m + 1
  }
  fbLocalGet(strScratchBase + 2)
  fbI32Const(0)
  fbLocalGet(strScratchBase + 3)
  fbStrNew()
  return 0
}

// ── the loop-local string accumulator ────────────────────────────────────────
// `let s = ""; s = s + piece` in a loop is O(n²); `strAccScan` proves a binding is an
// accumulator, and `emitStrAccAppend` then appends in place into slack its own grow
// path allocated — linear, with no builder in the source. Soundness: `s` only ever holds a literal, a fresh concat result, or a buffer it allocated (DECISIONS.md "String building is a lowering").

// A row is one declaration, keyed by `hoistDeclKey` so a clone meets its original. `saDecls`
// counts the `let`s noted against a row; a body holding two clones of one declaration is two.
let saKeys: i32[] = []

// Whether the accumulator rows are body `fnIx`'s (-1 the start), so a read of them during that
// body's emit, as `strInPlaceMode`'s, answers for it without a rescan.
export function strAccRowsAre(fnIx: i32): boolean { return saFnIx == fnIx }
let saRowOf: Map<i32, i32> = Map()
let saDecls: i32[] = []
let saApps: i32[] = []
let saBads: i32[] = []
let saFnIx = 0 - 2
// A mark may only reach a declaration the scan already knows. At MODULE scope the walk covers
// every function body, where minting a row per identifier would grow the table with every
// local in the program; the candidate declarations are all noted before the flag goes up.
let saKnownOnly = false

// The row for declaration key `k`, or -1.
function saFind(k: i32) { return saRowOf.get(k) ?? -1 }

// Find (or start) the row for declaration key `k`.
function saRow(k: i32) {
  const at = saFind(k)
  if at >= 0 { return at }
  saKeys.push(k)
  saDecls.push(0)
  saApps.push(0)
  saBads.push(0)
  saRowOf.set(k, saKeys.length - 1)
  return saKeys.length - 1
}

function saMarkBad(k: i32) {
  if k < 0 { return 0 }
  const at = saFind(k)
  if at >= 0 {
    saBads[at] = 1
    return 0
  }
  if saKnownOnly { return 0 }
  saBads[saRow(k)] = 1
  return 0
}

function saResetRows() {
  if saKeys.length > 0 { saRowOf = Map() }
  saKeys = []
  saDecls = []
  saApps = []
  saBads = []
  saSites = []
  saGlobal = Map()
  return 0
}

// A declaration qualifies only at the one spelling whose value is exact-fit by
// construction: a mutable `let` whose initialiser is a string literal, annotated
// `string` or not at all. Anything else disqualifies the name, because the binding
// could then be handed a buffer some other accumulator still owns.
function saDeclShapeOk(letIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letKw != "let" { return false }
    if d.letInit < 0 { return false }
    const init = nodeAt(d.letInit)
    if !(init is StrLit) { return false }
    if d.letType >= 0 {
      const ann = nodeAt(d.letType)
      if ann is TypeRef {
        return tyPrimNameOf(nodeTyIxOf(d.letType)) == "string"
      }
      return false
    }
    return true
  }
  return false
}

// Count the declaration at `letIx` against its own row, minting the row if needed.
function saNoteDecl(letIx: i32) {
  const r = saRow(hoistDeclKey(letIx))
  if r < 0 { return 0 }
  saDecls[r] = saDecls[r] + 1
  if !saDeclShapeOk(letIx) { saBads[r] = 1 }
  return 0
}

// True if any identifier in the subtree at `ix` resolves to declaration key `k`.
function exprMentionsDecl(ix: i32, k: i32) {
  if ix < 0 { return false }
  const n = nodeAt(ix)
  if n is Ident { return hoistDeclKey(identDeclOf(ix)) == k }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      if exprMentionsDecl(kids[i], k) { return true }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  return false
}

// True if `rhsIx` is `s + <parts>` for `s` the declaration keyed `k` — a maximal string
// chain whose FIRST part reads the accumulator and none of whose remaining parts mentions
// it. The second half is what keeps the lowering's evaluation order unobservable: the
// parts run before `s` is read, which is only sound while they cannot see or change it.
function saSelfAppendOk(rhsIx: i32, k: i32, fnIx: i32) {
  if k < 0 { return false }
  if !exprIsStrConcat(rhsIx, fnIx) { return false }
  const parts: i32[] = []
  strCatParts(rhsIx, fnIx, parts)
  if parts.length < 2 { return false }
  if !(nodeAt(parts[0]) is Ident) { return false }
  if hoistDeclKey(identDeclOf(parts[0])) != k { return false }
  let i = 1
  while i < parts.length {
    if exprMentionsDecl(parts[i], k) { return false }
    i = i + 1
  }
  return true
}

// The walk. `depth` counts enclosing LOOPS (an accumulator has to earn its buffer in
// one); `inLambda` is set inside a nested `FuncDecl`, where every mentioned name is
// disqualified — a captured local does not live in the slot this lowering writes.
function strAccWalk(ix: i32, fnIx: i32, depth: i32, inLambda: boolean) {
  if ix < 0 { return 0 }
  const n = nodeAt(ix)
  if n is Ident {
    if inLambda { saMarkBad(hoistDeclKey(identDeclOf(ix))) }
    return 0
  }
  if n is FuncDecl {
    strAccWalk(n.fnBody, fnIx, 0, true)
    return 0
  }
  if n is LetDecl {
    if inLambda || (saKnownOnly && !saDeclShapeOk(ix)) {
      saMarkBad(hoistDeclKey(ix))
    } else {
      saNoteDecl(ix)
    }
    strAccWalk(n.letInit, fnIx, depth, inLambda)
    return 0
  }
  if n is BinExpr {
    if n.binOp == "=" {
      const tIx = unwrapParen(n.binLeft)
      if tIx >= 0 && nodeAt(tIx) is Ident {
        const k = hoistDeclKey(identDeclOf(tIx))
        if inLambda {
          saMarkBad(k)
        } else if saSelfAppendOk(n.binRight, k, fnIx) {
          if depth > 0 && !(saKnownOnly && saFind(k) < 0) {
            const r = saRow(k)
            if r < 0 { return 0 }
            saApps[r] = saApps[r] + 1
          }
        } else {
          const rhs = nodeAt(n.binRight)
          if !(rhs is StrLit) { saMarkBad(k) }
        }
      }
    }
  }
  if n is WhileStmt {
    strAccWalk(n.whileCond, fnIx, depth, inLambda)
    strAccWalk(n.whileBody, fnIx, depth + 1, inLambda)
    return 0
  }
  if n is ForRange {
    strAccWalk(n.frFrom, fnIx, depth, inLambda)
    strAccWalk(n.frTo, fnIx, depth, inLambda)
    strAccWalk(n.frStep, fnIx, depth, inLambda)
    strAccWalk(n.frBody, fnIx, depth + 1, inLambda)
    return 0
  }
  if n is ForIn {
    strAccWalk(n.fiIter, fnIx, depth, inLambda)
    strAccWalk(n.fiBody, fnIx, depth + 1, inLambda)
    return 0
  }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      strAccWalk(kids[i], fnIx, depth, inLambda)
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  return 0
}

// Prove this function's accumulators. Skipped outright where the function performs no
// string op at all, which is most of them.
function strAccScan(blockIx: i32, fnIx: i32) {
  saResetRows()
  saFnIx = fnIx
  saKnownOnly = false
  if !fnUses.strOp { return 0 }
  strAccWalk(blockIx, fnIx, 0, false)
  ssWalk(blockIx, fnIx, 0)
  return 0
}

// ── the site-cached string append ─────────────────────────────────────────────
// `p = p + parts` or `p = parts + p` in a loop, for a place the proof above does not cover. A
// site's `SB` is the buffer it allocated last and `SE` that buffer's frontier; nothing else writes
// `SB`, so a view ending at `SE` extends in place and any other copies (DECISIONS.md "String building is a lowering").
let saSites: i32[] = []
// The sites among `saSites` outside any loop, whose buffer and frontier are module globals: a
// function called from a caller's loop starts each call with a fresh frame (D2669).
let saGlobal: {[i32]: boolean} = Map()

// True if `a` and `b` spell the same place: one node, or equal non-empty `strPlaceKey`s.
function strSamePlace(a: i32, b: i32): boolean {
  const x = unwrapParen(a)
  const y = unwrapParen(b)
  if x < 0 || y < 0 { return false }
  if x == y { return true }
  const k = strPlaceKey(x)
  return k != "" && k == strPlaceKey(y)
}

// A canonical spelling of the place at `ix` — a name, or a field or index chain over one
// keyed by names and literals — or "" when it is not such a place.
function strPlaceKey(ix: i32): string {
  const u = unwrapParen(ix)
  if u < 0 { return "" }
  const n = nodeAt(u)
  match n {
    Ident => {
      return "i" + n.identName
    }
    NumLit => {
      return "n" + n.numText
    }
    StrLit => {
      return "s" + i32ToStr(n.strText.length) + ":" + n.strText
    }
    Member => {
      const o = strPlaceKey(n.memObj)
      if o == "" { return "" }
      return o + "." + n.memProp
    }
    Index => {
      const o = strPlaceKey(n.idxArr)
      const k = strPlaceKey(n.idxIndex)
      if o == "" || k == "" { return "" }
      return o + "[" + k + "]"
    }
    CharLit | BoolLit | NullLit | Unary | BinExpr | Call | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {
      // Not an access chain: two spellings of a call or an operator need not read one place.
      return ""
    }
  }
}

// The place a chain part reads: the part itself, or the left side of a `??` over it.
function strPartPlace(ix: i32): i32 {
  const u = unwrapParen(ix)
  if u < 0 { return -1 }
  const n = nodeAt(u)
  if n is BinExpr {
    if n.binOp == "??" { return n.binLeft }
  }
  return u
}

// The site shape of the assignment at `binIx`: 1 an append (the chain's first part reads
// the target), 2 a prepend (its last part does), 0 neither.
function strSiteMode(binIx: i32, fnIx: i32): i32 {
  const a = nodeAt(binIx)
  if a is BinExpr {
    if a.binOp != "=" { return 0 }
    if !exprIsStrConcat(a.binRight, fnIx) { return 0 }
    const parts: i32[] = []
    strCatParts(a.binRight, fnIx, parts)
    if parts.length < 2 { return 0 }
    if strSamePlace(a.binLeft, strPartPlace(parts[0])) { return 1 }
    if strSamePlace(a.binLeft, strPartPlace(parts[parts.length - 1])) {
      return 2
    }
  }
  return 0
}

// Whether the place at `ix` outlives a call of `fnIx`: a name that is no local or parameter of
// it, or a field or element chain rooted at a parameter or such a name. A site outside a loop
// whose place dies with the frame (a fresh local) misses on every call, so it keeps no globals.
function strSiteOutlives(ix: i32, fnIx: i32): boolean {
  let u = unwrapParen(ix)
  let chained = false
  while u >= 0 {
    const n = nodeAt(u)
    if n is Member {
      u = unwrapParen(n.memObj)
      chained = true
    } else if n is Index {
      u = unwrapParen(n.idxArr)
      chained = true
    } else {
      if !(n is Ident) { return false }
      if chained && paramPosOfRead(fnIx, u) >= 0 { return true }
      return localIndexOf(fnIx, u) < 0
    }
  }
  return false
}

// Note every site inside a loop of this body, and every site outside one whose place outlives
// the call. A nested function is its own body.
function ssWalk(ix: i32, fnIx: i32, depth: i32) {
  if ix < 0 { return 0 }
  const n = nodeAt(ix)
  if n is FuncDecl { return 0 }
  if n is BinExpr {
    if n.binOp == "=" && strSiteMode(ix, fnIx) > 0 {
      if depth > 0 {
        saSites.push(ix)
      } else if strSiteOutlives(n.binLeft, fnIx) {
        saSites.push(ix)
        saGlobal[ix] = true
      }
    }
  }
  if n is WhileStmt {
    ssWalk(n.whileCond, fnIx, depth)
    ssWalk(n.whileBody, fnIx, depth + 1)
    return 0
  }
  if n is ForRange {
    ssWalk(n.frBody, fnIx, depth + 1)
    return 0
  }
  if n is ForIn {
    ssWalk(n.fiBody, fnIx, depth + 1)
    return 0
  }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      ssWalk(kids[i], fnIx, depth)
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  return 0
}

// The site mode of the assignment at `binIx` when the scan noted it for this body, else 0.
// Re-derived with the emit-time scope, like `strAccAppendOk`.
function strSiteModeAt(binIx: i32, fnIx: i32): i32 {
  if saFnIx != fnIx { return 0 }
  let i = 0
  while i < saSites.length {
    if saSites[i] == binIx { return strSiteMode(binIx, fnIx) }
    i = i + 1
  }
  return 0
}

// The chain root `emitStrConcat` lowers as a site, its mode, and the assignment it
// belongs to; -1 when none is armed.
let ssArmRhs = -1
let ssArmMode = 0
let ssArmBin = -1

// The site mode assignment `binIx` arms, or 0.
function strSiteArmsAt(binIx: i32, fnIx: i32): i32 {
  const mode = strSiteModeAt(binIx, fnIx)
  if mode == 0 || saGlobal.has(binIx) && synthSitePairIdx(binIx) < 0 {
    return 0
  }
  return mode
}

// How assignment `binIx` writes its string right side in place: -1 as the loop accumulator, the
// site mode its chain lowers under (`strSiteCatTail`), or 0 as a plain value.
// A function legacy does not lower is scanned here, as its body lowering would scan it.
export function strInPlaceMode(binIx: i32, fnIx: i32): i32 {
  saScanFor(fnIx)
  if strAccAppendOk(binIx, fnIx) { return -1 }
  return strSiteArmsAt(binIx, fnIx)
}

// Scans function `fnIx` unless the rows are already its own.
function saScanFor(fnIx: i32) {
  if saFnIx == fnIx { return 0 }
  // The start body (-1) is the whole top level, as legacy scans it before the start's code.
  if fnIx < 0 { return strAccScanStart() }
  const fn = nodeAt(fnIx)
  if fn is FuncDecl { strAccScan(fn.fnBody, fnIx) }
  return 0
}

// The armed site assignment whose right side is the chain at `rhsIx`, or -1.
export function strSiteOfRhs(rhsIx: i32, fnIx: i32): i32 {
  saScanFor(fnIx)
  let i = 0
  while i < saSites.length {
    const a = nodeAt(saSites[i])
    if (
      a is BinExpr
      && a.binRight == rhsIx
      && strSiteArmsAt(saSites[i], fnIx) > 0
    ) {
      return saSites[i]
    }
    i = i + 1
  }
  return -1
}

// Arm the site lowering for the assignment at `binIx`, or disarm it.
function strSiteArm(binIx: i32, fnIx: i32) {
  ssArmRhs = -1
  const mode = strSiteArmsAt(binIx, fnIx)
  if mode == 0 { return 0 }
  const a = nodeAt(binIx)
  if a is BinExpr {
    ssArmRhs = a.binRight
    ssArmMode = mode
    ssArmBin = binIx
  }
  return 0
}

// The site's `SB` local (`liBack` 24, keyed by the assignment node); `SE` is the next
// slot. Minted on first use and reused for the rest of the function.
function strSiteSlot(binIx: i32): i32 {
  let i = 0
  while i < liBack.length {
    if liBack[i] == 24 && liSlots[i] == binIx {
      return listIdxScratchBase + i + 1
    }
    i = i + 1
  }
  liKinds.push("list")
  liSlots.push(binIx)
  liBack.push(24)
  liKinds.push("list")
  liSlots.push(binIx)
  liBack.push(25)
  return listIdxScratchBase + liKinds.length - 1
}

// A site's buffer or frontier read and write: a local, or the module global of a site outside a loop.
function siteGet(i: i32, glob: boolean) {
  if glob { fbGlobalGet(i) } else { fbLocalGet(i) }
  return 0
}
function siteSet(i: i32, glob: boolean) {
  if glob { fbGlobalSet(i) } else { fbLocalSet(i) }
  return 0
}

// Lower an armed site's chain, parts evaluated in the copying lowering's order. `mode` 1
// extends what part 0 read, 2 what the last part read. A miss allocates exact-fit, so a one-off
// append keeps no slack; a full hit doubles, so a loop pays one extra copy and stays linear.
function emitStrSiteCat(parts: i32[], mode: i32, binIx: i32, fnIx: i32) {
  let i = 0
  while i < parts.length {
    if emitStrValue(parts[i], fnIx) < 0 { return -1 }
    i = i + 1
  }
  return strSiteCatTail(parts.length, mode, binIx)
}

// Joins the `n` string parts on the stack into site `binIx`'s buffer under `mode`.
export function strSiteCatTail(n: i32, mode: i32, binIx: i32) {
  let j = n - 1
  while j >= 0 {
    fbLocalSet(strCatSlot(j))
    j = j - 1
  }
  const glob = saGlobal.has(binIx)
  const sb = if glob { synthSitePairIdx(binIx) } else { strSiteSlot(binIx) }
  const se = sb + 1
  let acc = 0
  if mode == 2 { acc = n - 1 }
  // I0 = the added length: every part but the accumulator.
  fbI32Const(0)
  let k = 0
  while k < n {
    if k != acc {
      fbLocalGet(strCatSlot(k))
      fbStrLen()
      fbI32Bin(106) // i32.add
    }
    k = k + 1
  }
  fbLocalSet(strScratchBase + 3)
  fbLocalGet(strCatSlot(acc))
  fbStrLen()
  fbLocalSet(strScratchBase + 4) // I1 = the accumulator's length
  fbLocalGet(strCatSlot(acc))
  fbStrStart()
  fbLocalSet(strScratchBase + 6) // I3 = its start
  fbLocalGet(strCatSlot(acc))
  fbStrBack()
  fbLocalSet(strScratchBase + 2) // OUT = its backing
  // I2 = ours: this site's buffer, and a view whose edge is the frontier.
  fbLocalGet(strScratchBase + 2)
  siteGet(sb, glob)
  fbRefEq()
  fbLocalGet(strScratchBase + 6)
  if mode == 1 {
    fbLocalGet(strScratchBase + 4)
    fbI32Bin(106)
  }
  siteGet(se, glob)
  fbI32Bin(70)  // i32.eq
  fbI32Bin(113) // i32.and
  fbLocalSet(strScratchBase + 5)
  // Grow unless ours and the slack on the growing side holds the parts.
  fbLocalGet(strScratchBase + 5)
  if mode == 1 {
    fbLocalGet(strScratchBase + 6)
    fbLocalGet(strScratchBase + 4)
    fbI32Bin(106)
    fbLocalGet(strScratchBase + 3)
    fbI32Bin(106)
    fbLocalGet(strScratchBase + 2)
    fbArrayLen()
    fbI32Bin(76) // i32.le_s
  } else {
    fbLocalGet(strScratchBase + 6)
    fbLocalGet(strScratchBase + 3)
    fbI32Bin(78) // i32.ge_s
  }
  fbI32Bin(113)
  fbI32Eqz()
  fbIf(64) // void
  fbLocalGet(strScratchBase + 2)
  fbLocalSet(strScratchBase + 7) // ABK = the old backing
  fbLocalGet(strScratchBase + 4)
  fbLocalGet(strScratchBase + 3)
  fbI32Bin(106)
  fbI32Const(1)
  fbI32Bin(116)
  fbI32Const(16)
  fbI32Bin(106) // 2 * (len + added) + 16: a full hit doubles
  fbLocalGet(strScratchBase + 4)
  fbLocalGet(strScratchBase + 3)
  fbI32Bin(106) // len + added: a miss is exact-fit
  fbLocalGet(strScratchBase + 5)
  fbSelect()
  fbArrayNewDefault(sBackTy())
  fbLocalTee(strScratchBase + 2)
  siteSet(sb, glob)
  if mode == 2 {
    // A prepend buffer keeps its value at the END, its slack in front.
    fbLocalGet(strScratchBase + 2)
    fbArrayLen()
    fbLocalGet(strScratchBase + 4)
    fbI32Bin(107) // i32.sub
    fbLocalSet(strScratchBase + 5)
  } else {
    fbI32Const(0)
    fbLocalSet(strScratchBase + 5)
  }
  fbLocalGet(strScratchBase + 2)
  fbLocalGet(strScratchBase + 5)
  fbLocalGet(strScratchBase + 7)
  fbLocalGet(strScratchBase + 6)
  fbLocalGet(strScratchBase + 4)
  fbArrayCopy(sBackTy(), sBackTy())
  fbLocalGet(strScratchBase + 5)
  fbLocalSet(strScratchBase + 6)
  fbEnd()
  // I3 becomes the result's start and I2 the first write offset; SE the new frontier.
  if mode == 1 {
    fbLocalGet(strScratchBase + 6)
    fbLocalGet(strScratchBase + 4)
    fbI32Bin(106)
    fbLocalTee(strScratchBase + 5)
    fbLocalGet(strScratchBase + 3)
    fbI32Bin(106)
    siteSet(se, glob)
  } else {
    fbLocalGet(strScratchBase + 6)
    fbLocalGet(strScratchBase + 3)
    fbI32Bin(107)
    fbLocalTee(strScratchBase + 6)
    fbLocalTee(strScratchBase + 5)
    siteSet(se, glob)
  }
  let m = 0
  let left = n - 1
  while m < n {
    if m != acc {
      fbLocalGet(strScratchBase + 2)
      fbLocalGet(strScratchBase + 5)
      fbLocalGet(strCatSlot(m))
      fbStrBack()
      fbLocalGet(strCatSlot(m))
      fbStrStart()
      fbLocalGet(strCatSlot(m))
      fbStrLen()
      fbArrayCopy(sBackTy(), sBackTy())
      left = left - 1
      if left > 0 {
        fbLocalGet(strScratchBase + 5)
        fbLocalGet(strCatSlot(m))
        fbStrLen()
        fbI32Bin(106)
        fbLocalSet(strScratchBase + 5)
      }
    }
    m = m + 1
  }
  fbLocalGet(strScratchBase + 2)
  fbLocalGet(strScratchBase + 6)
  fbLocalGet(strScratchBase + 4)
  fbLocalGet(strScratchBase + 3)
  fbI32Bin(106)
  fbStrNew()
  return 0
}

// The same proof for the START function, whose accumulator is a module CELL rather than a
// slot. `collectFns` partitions the top level into exactly these three lists and lifts every
// nested function into `fnStmts`, so walking all three is the whole program: a mention inside
// any of them disqualifies the name, which is what makes the cell's one home safe to append into.
export function strAccScanStart() {
  saResetRows()
  saFnIx = -1
  saKnownOnly = false
  if !fnUses.strOp { return 0 }
  let si = 0
  while si < startStmts.length {
    ssWalk(startStmts[si], -1, 0)
    si = si + 1
  }
  // Declarations first: a function is HOISTED, so a body assigning to a global can be walked
  // before the global's own `let`, and a mark that arrived before the row would be lost. Only
  // a CANDIDATE mints a row.
  let i = 0
  while i < globalStmts.length {
    if saDeclShapeOk(globalStmts[i]) { saNoteDecl(globalStmts[i]) }
    i = i + 1
  }
  if saKeys.length == 0 { return 0 }
  saKnownOnly = true
  i = 0
  while i < globalStmts.length {
    const g = nodeAt(globalStmts[i])
    if g is LetDecl { strAccWalk(g.letInit, -1, 0, false) }
    i = i + 1
  }
  i = 0
  while i < startStmts.length {
    strAccWalk(startStmts[i], -1, 0, false)
    i = i + 1
  }
  // Every user function is foreign ground. Its CHILDREN are walked rather than the `FuncDecl`
  // itself, so a parameter default mentioning the name disqualifies it like a body would.
  i = 0
  while i < fnStmts.length {
    const kids = nodeChildren(fnStmts[i])
    let k = 0
    while k < kids.length {
      strAccWalk(kids[k], -1, 0, true)
      k = k + 1
    }
    i = i + 1
  }
  saKnownOnly = false
  return 0
}

// The declaration keyed `k` has one noted `let`, no disqualifying use, and a self-append
// inside a loop.
function saDeclQualifies(k: i32) {
  const r = saFind(k)
  if r < 0 { return false }
  return saBads[r] == 0 && saDecls[r] == 1 && saApps[r] > 0
}

// Where a proven accumulator lives when it is not a slot: the `globalStmts` position of the
// module cell declared at `k`, or -1. Only at module scope, where `emitStartFnCode` is the emitter.
function saAccGlobalIdx(k: i32) {
  if saFnIx != -1 { return -1 }
  return globalIndexOfSid(sidOfNode(k))
}

// Read the accumulator. A function local by slot; otherwise the module binding through
// `emitUserGlobalGet`, the storage-class chokepoint, which is also what makes a future
// promotion of this cell follow without a second decision here.
function saAccGet(slot: i32, gIx: i32) {
  if slot >= 0 {
    fbLocalGet(slot)
    return 0
  }
  return emitUserGlobalGet(gIx)
}

// The write half of the pair above.
function saAccSet(slot: i32, gIx: i32) {
  if slot >= 0 {
    fbLocalSet(slot)
    return 0
  }
  return emitUserGlobalSet(gIx)
}

// Does the assignment at `binIx` append to a proven accumulator? Re-asked per site, with
// the emit-time scope populated, so the scan's answer is a filter and never the whole
// test. `saFnIx` pins the set to the body it is computed for.
function strAccAppendOk(binIx: i32, fnIx: i32) {
  if saFnIx != fnIx { return false }
  if saKeys.length == 0 { return false }
  const a = nodeAt(binIx)
  if a is BinExpr {
    const tIx = unwrapParen(a.binLeft)
    if tIx >= 0 && nodeAt(tIx) is Ident {
      const k = hoistDeclKey(identDeclOf(tIx))
      if !saDeclQualifies(k) { return false }
      if localIndexOf(fnIx, tIx) < 0 {
        if saAccGlobalIdx(k) < 0 { return false }
      }
      return saSelfAppendOk(a.binRight, k, fnIx)
    }
  }
  return false
}

// `s = s + p1 + … + pk` appended in place: the parts are evaluated and stashed first
// (they cannot mention `s`, so reading the accumulator after them is unobservable), the
// backing grows only when the parts do not fit, then one `array.copy` per part at a
// running offset, then one new header. Borrows the string scratch frame's slots.
function emitStrAccAppend(binIx: i32, fnIx: i32) {
  const a = nodeAt(binIx)
  if !(a is BinExpr) {
    return emitFail("emitProgram: expected a string accumulator append")
  }
  const parts: i32[] = []
  strCatParts(a.binRight, fnIx, parts)
  let i = 1
  while i < parts.length {
    if emitStrValue(parts[i], fnIx) < 0 { return -1 }
    i = i + 1
  }
  return strAccAppendTail(binIx, fnIx)
}

// After the appended parts (every chain part but the first) are on the stack: accumulator
// append `binIx` grows the target's buffer if they do not fit, copies them and stores it.
export function strAccAppendTail(binIx: i32, fnIx: i32) {
  const a = nodeAt(binIx)
  if a is BinExpr {
    const tIx = unwrapParen(a.binLeft)
    if tIx >= 0 && nodeAt(tIx) is Ident {
      const slot = localIndexOf(fnIx, tIx)
      const gIx = saAccGlobalIdx(hoistDeclKey(identDeclOf(tIx)))
      const parts: i32[] = []
      strCatParts(a.binRight, fnIx, parts)
      const n = parts.length
      let j = n - 1
      while j >= 1 {
        fbLocalSet(strCatSlot(j - 1))
        j = j - 1
      }
      fbLocalGet(strCatSlot(0))
      fbStrLen()
      let k = 2
      while k < n {
        fbLocalGet(strCatSlot(k - 1))
        fbStrLen()
        fbI32Bin(106) // i32.add
        k = k + 1
      }
      fbLocalSet(strScratchBase + 3) // I0 = the added length
      saAccGet(slot, gIx)
      fbStrLen()
      fbLocalSet(strScratchBase + 4) // I1 = the current length
      saAccGet(slot, gIx)
      fbStrStart()
      fbLocalSet(strScratchBase + 6) // I3 = the current start
      saAccGet(slot, gIx)
      fbStrBack()
      fbLocalSet(strScratchBase + 2) // OUT = the current backing
      fbLocalGet(strScratchBase + 6)
      fbLocalGet(strScratchBase + 4)
      fbI32Bin(106)
      fbLocalGet(strScratchBase + 3)
      fbI32Bin(106)
      fbLocalGet(strScratchBase + 2)
      fbArrayLen()
      fbI32Bin(74)                   // i32.gt_s — start + len + added past the backing?
      fbIf(64)                       // void
      fbLocalGet(strScratchBase + 2)
      fbLocalSet(strScratchBase + 7) // ABK = the old buffer
      fbLocalGet(strScratchBase + 4)
      fbLocalGet(strScratchBase + 3)
      fbI32Bin(106)
      fbI32Const(1)
      fbI32Bin(116)                  // i32.shl — capacity DOUBLING is what makes the loop linear
      fbI32Const(16)
      fbI32Bin(106)
      fbArrayNewDefault(sBackTy())
      fbLocalSet(strScratchBase + 2)
      fbLocalGet(strScratchBase + 2)
      fbI32Const(0)
      fbLocalGet(strScratchBase + 7)
      fbLocalGet(strScratchBase + 6)
      fbLocalGet(strScratchBase + 4)
      fbArrayCopy(sBackTy(), sBackTy())
      fbI32Const(0)
      fbLocalSet(strScratchBase + 6) // the fresh buffer starts at 0
      fbEnd()
      fbLocalGet(strScratchBase + 6)
      fbLocalGet(strScratchBase + 4)
      fbI32Bin(106)
      fbLocalSet(strScratchBase + 5) // I2 = the running destination offset
      let m = 1
      while m < n {
        fbLocalGet(strScratchBase + 2)
        fbLocalGet(strScratchBase + 5)
        fbLocalGet(strCatSlot(m - 1))
        fbStrBack()
        fbLocalGet(strCatSlot(m - 1))
        fbStrStart()
        fbLocalGet(strCatSlot(m - 1))
        fbStrLen()
        fbArrayCopy(sBackTy(), sBackTy())
        if m + 1 < n {
          fbLocalGet(strScratchBase + 5)
          fbLocalGet(strCatSlot(m - 1))
          fbStrLen()
          fbI32Bin(106)
          fbLocalSet(strScratchBase + 5)
        }
        m = m + 1
      }
      fbLocalGet(strScratchBase + 2)
      fbLocalGet(strScratchBase + 6)
      fbLocalGet(strScratchBase + 4)
      fbLocalGet(strScratchBase + 3)
      fbI32Bin(106)
      fbStrNew()
      saAccSet(slot, gIx)
      return 0
    }
  }
  return emitFail("emitProgram: expected a string accumulator append")
}

// Lower a string value-equality `a == b` (or `a != b`) onto `body`, leaving a 0/1 i32:
// element-wise, not ref identity — false if the lengths differ, else loop comparing
// `a[i] == b[i]`, all-equal giving 1. `!=` negates with `i32.eqz`. Lowered as a
// value-typed `block`/`loop` so the compare can `br` out early on a mismatch.
function emitStrEq(binIx: i32, fnIx: i32) {
  if binIx < 0 { return -1 }
  const e = nodeAt(binIx)
  if e is BinExpr {
    // A literal-union atom operand widens to its member string first (`emitStrValue`), the
    // boundary `emitStrConcat` applies, so `s == k` (`s: string`, `k: K`) is a string compare
    // rather than the atom `i32.eq`.
    const lit = strEqLitOf(binIx, fnIx)
    const first = strEqFirstOf(e, lit)
    if emitStrValue(first, fnIx) < 0 { return -1 }
    if emitEqRecoverNarrowed(first, fnIx) < 0 { return -1 }
    if lit < 0 {
      if emitStrValue(e.binRight, fnIx) < 0 { return -1 }
      if emitEqRecoverNarrowed(e.binRight, fnIx) < 0 { return -1 }
    }
    return strEqTail(e, binIx, lit, fnIx)
  }
  return emitFail("emitProgram: expected a string equality")
}

// The quoted-literal operand string `==`/`!=` at `binIx` compares in place, or -1. Equality is
// symmetric, so the literal goes last whichever side it is on, and its length is a constant.
export function strEqLitOf(binIx: i32, fnIx: i32): i32 {
  const e = nodeAt(binIx)
  if !(e is BinExpr) || !strEqLitSideOk(binIx, fnIx) { return -1 }
  if strLitLenOf(e.binRight) >= 0 { return e.binRight }
  if strLitLenOf(e.binLeft) >= 0 { return e.binLeft }
  return -1
}

// The operand a string equality pushes first; the right operand follows it when `lit` is -1.
export function strEqFirstOf(e: BinExpr, lit: i32): i32 {
  if lit >= 0 && lit == e.binLeft { return e.binRight }
  return e.binLeft
}

// After a narrowed operand's recovery, string `==`/`!=` at `binIx` over its pushed operands.
export function strEqTail(e: BinExpr, binIx: i32, lit: i32, fnIx: i32) {
  if lit >= 0 {
    if emitStrEqLit(lit, fnIx) < 0 { return -1 }
  } else if emitEqNonNullCore(binIx, fnIx) < 0 {
    return -1
  }
  return strEqNegTail(e)
}

// `!=` negates value-equality: `i32.eqz` after the 0/1 a string `==` left.
export function strEqNegTail(e: BinExpr) {
  if e.binOp == "!=" { fbI32Eqz() }
  return 0
}

// Whether string `==` node `binIx` lowers through the plain string core, so a literal operand
// may take `emitStrEqLit` instead of `emitEqNonNullCore`.
function strEqLitSideOk(binIx: i32, fnIx: i32): boolean {
  return eqCoreKindOfBin(binIx, fnIx, listOpKindOfBin(binIx, fnIx)) == "str"
}

// Lower a string ordering comparison (`<`/`>`/`<=`/`>=`) onto a 0/1, built on one
// primitive, `emitStrLessCore` ("first operand lexicographically < second"): `A < B`
// is `less(A,B)`, `A > B` is `less(B,A)`, and the `<=`/`>=` forms negate. Each operand is
// pushed as a string value (a literal-union atom widens first) — unwidened, ordering compared interned atom ids instead of the strings, e.g. answering `"b" < "a"` true.
function emitStrOrder(binIx: i32, fnIx: i32) {
  if binIx < 0 { return -1 }
  const e = nodeAt(binIx)
  if e is BinExpr {
    // Push the core's first arg (lower on stack) then its second arg.
    const swap = strOrderSwaps(e)
    if emitStrValue(if swap { e.binRight } else { e.binLeft }, fnIx) < 0 {
      return -1
    }
    if emitStrValue(if swap { e.binLeft } else { e.binRight }, fnIx) < 0 {
      return -1
    }
    return strOrderTail(e)
  }
  return emitFail("emitProgram: expected a string ordering")
}

// Whether string ordering `e` pushes its right operand first: `A > B` is `less(B, A)`, and `<=`
// is the negation of that.
export function strOrderSwaps(e: BinExpr): boolean {
  return e.binOp == ">" || e.binOp == "<="
}

// String ordering `e` over its two pushed operands, in `strOrderSwaps`'s order.
export function strOrderTail(e: BinExpr) {
  const op = e.binOp
  if op != "<" && op != ">" && op != "<=" && op != ">=" {
    return emitFail("emitProgram: expected a string ordering operator")
  }
  if emitStrLessCore() < 0 { return -1 }
  if op == "<=" || op == ">=" {
    fbI32Eqz() // 0x45 i32.eqz — `<=`/`>=` negate the strict-less result
  }
  return 0
}

// The string strict-less core: expects the two string refs already on the stack (first
// below second), leaves 1 iff the first is lexicographically less than the second, else
// 0 — unsigned code-point compare up to the shorter length, first mismatch decides, and a
// prefix relationship makes the shorter string less. Mirrors `emitStrEqCore`'s frame shape.
function emitStrLessCore() {
  fbLocalSet(strScratchBase + 1) // B (stack top)
  fbLocalSet(strScratchBase + 0) // A
  // Hoist both headers' backing + start BEFORE the block — the element loop below reads
  // both operands once per trip.
  hoistStrScr(0)
  hoistStrScr(1)
  fbBlock(127) // 0x02 block, 0x7f i32 blocktype → the 0/1 result
  // lenA = len(A) ; lenB = len(B) — the HEADER's `len` (field 2), not `array.len`
  pushStrScrRef(0)
  fbStrLen()
  setStrScrI(0) // lenA
  pushStrScrRef(1)
  fbStrLen()
  setStrScrI(1) // lenB
  // n = min(lenA, lenB):  n = lenA ; if lenB < lenA { n = lenB }
  pushStrScrI(0)
  setStrScrI(2)
  pushStrScrI(1)
  pushStrScrI(0)
  fbI32Bin(73)  // 0x49 i32.lt_u (lenB < lenA)
  fbIf(64)      // 0x04 if, void
  pushStrScrI(1)
  setStrScrI(2) // n = lenB
  fbEnd()
  // i = 0
  fbI32Const(0)
  setStrScrI(3)
  // loop { if i >= n {} else { compare; i++; br } }
  fbLoop(64)     // 0x03 loop, void
  pushStrScrI(3) // i
  pushStrScrI(2) // n
  fbI32Bin(78)   // 0x4e i32.ge_s (i >= n → common prefix done)
  fbIf(64)       // then: fall through (empty)
  fbElse()
  // if A[i] != B[i] { push (A[i] <_u B[i]) ; br out of block }
  pushStrScrElem(0, 3) // A[i]
  pushStrScrElem(1, 3) // B[i]
  fbI32Bin(71)         // 0x47 i32.ne
  fbIf(64)
  pushStrScrElem(0, 3) // A[i]
  pushStrScrElem(1, 3) // B[i]
  fbI32Bin(73)         // 0x49 i32.lt_u (A[i] < B[i] → the answer at the first diff)
  fbBr(3)              // 0x0c br depth 3 → out of: if(0)·else(1)·loop(2)·block(3)
  fbEnd()              // end (mismatch if)
  // i = i + 1
  pushStrScrI(3)
  fbI32Const(1)
  fbI32Bin(106) // 0x6a i32.add
  setStrScrI(3)
  fbBr(1)       // 0x0c br depth 1 → loop header (else=0, loop=1)
  fbEnd()       // end (ge_s if/else)
  fbEnd()       // end (loop)
  // Common prefix equal → the shorter string is less:  lenA < lenB.
  pushStrScrI(0)
  pushStrScrI(1)
  fbI32Bin(73) // 0x49 i32.lt_u (lenA < lenB)
  fbEnd()      // end (block) — leaves the 0/1 result
  return 0
}

// The string value-equality core: expects the two string refs already on the stack
// (left below right), leaves the 0/1 result. Shared by `emitStrEq` and the
// struct-equality field compare (which pushes field chains as operands) — one `call`
// into the shared `__str_eq__` helper, emitted once per module.
function emitStrEqCore() {
  fbCall(helpStrEqFn())
  return 0
}

// The byte length of the quoted literal node `ix` spells, or -1 when `ix` is not one.
function strLitLenOf(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const s = nodeAt(ix)
  if s is StrLit {
    const di = if gStrDataLen.length > 0 { gStrDataIx[s.strText] ?? -1 } else { -1 }
    if di >= 0 { return gStrDataLen[di] }
    return cpsToUtf8(decodeStr(strToCps(s.strText))).length
  }
  return -1
}

// The longest literal `emitStrEqLit` compares byte by byte in place of calling `__str_eq__`.
const STR_EQ_INLINE_BYTES = 2

// Leave 1 when every byte of the string in the string-op frame's last slot, whose length is
// already known to be `bytes.length`, equals the matching byte of `bytes`, else 0.
function emitStrBytesEq(bytes: i32[]) {
  let k = 0
  while k < bytes.length {
    fbLocalGet(strScratchBase + 11)
    fbStrBack()
    fbLocalGet(strScratchBase + 11)
    fbStrStart()
    if k > 0 {
      fbI32Const(k)
      fbI32Bin(106) // 0x6a i32.add
    }
    fbArrayGet(sBackTy())
    fbI32Const(bytes[k])
    fbI32Bin(70) // 0x46 i32.eq
    if k > 0 {
      fbI32Bin(113) // 0x71 i32.and
    }
    k = k + 1
  }
  return 0
}

// The form a string compare with quoted literal `litIx` takes: 0 the core over the pushed
// literal; 1 an empty literal, a length test alone; 2 a short literal compared in place; 3 the
// `__str_eq__` call under the length test. Forms 0 and 3 write the literal, 1 and 2 never do.
// Forms 1 to 3 hold the other operand in the string-op frame's last slot.
export function strEqLitForm(litIx: i32): i32 {
  const n = strLitLenOf(litIx)
  if n < 0 || !fnUses.strOp { return 0 }
  if n == 0 { return 1 }
  if (
    n <= STR_EQ_INLINE_BYTES
    && litIx < P.nodes.length
    && nodeAt(litIx) is StrLit
  ) {
    return 2
  }
  return 3
}

// Writes form `f`'s code before its literal: forms 1 and 2 whole, form 3 the length test and the
// held operand's read. A length other than the literal's answers 0 without the literal.
export function strEqLitHead(litIx: i32, f: i32) {
  if f == 0 { return 0 }
  fbLocalTee(strScratchBase + 11)
  fbStrLen()
  if f == 1 { return fbI32Eqz() }
  fbI32Const(strLitLenOf(litIx))
  fbI32Bin(70) // 0x46 i32.eq
  fbIf(127)    // if (result i32)
  if f == 3 { return fbLocalGet(strScratchBase + 11) }
  const lit = nodeAt(litIx)
  if lit is StrLit {
    emitStrBytesEq(cpsToUtf8(decodeStr(strToCps(lit.strText))))
  }
  fbElse()
  fbI32Const(0)
  return fbEnd()
}

// Writes form `f`'s code after its literal.
export function strEqLitTail(f: i32) {
  if f == 0 { return emitStrEqCore() }
  if f != 3 { return 0 }
  fbCall(helpStrEqFn())
  fbElse()
  fbI32Const(0)
  return fbEnd()
}

// Compares the string on the stack with literal node `litIx`, leaving the 0/1 result.
function emitStrEqLit(litIx: i32, fnIx: i32) {
  const f = strEqLitForm(litIx)
  strEqLitHead(litIx, f)
  if f == 0 || f == 3 {
    if emitStrValue(litIx, fnIx) < 0 { return -1 }
  }
  return strEqLitTail(f)
}

// ── list value-equality + concat cores (collections-design §VL.4/§VL.6) ───────
// Each core expects its two list wrapper refs already on the stack (left below right)
// and leaves a 0/1 (equality) or the new wrapper (concat), mirroring `emitStrEqCore`'s
// block/loop/br structure — only the length source (`len`, not `array.len`) and the element compare differ per kind.

// i32-list `==`: length + element compare over the LEQI frame.
function emitListEqICore() {
  const bA = leqIScratchBase
  fbLocalSet(bA + 1)    // B
  fbLocalSet(bA + 0)    // A
  fbBlock(127)          // block i32
  fbLocalGet(bA + 0)
  fbStructGet(lTy(), 1) // lenA
  fbLocalSet(bA + 3)    // n = lenA
  fbLocalGet(bA + 3)
  fbLocalGet(bA + 1)
  fbStructGet(lTy(), 1) // lenB
  fbI32Bin(71)          // i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(1)
  fbEnd()
  fbI32Const(0)
  fbLocalSet(bA + 4)    // i = 0
  fbLoop(64)
  fbLocalGet(bA + 4)
  fbLocalGet(bA + 3)
  fbI32Bin(78)          // i >= n → done
  fbIf(64)
  fbElse()
  fbLocalGet(bA + 0)
  fbStructGet(lTy(), 0) // backing A
  fbLocalGet(bA + 4)
  fbArrayGet(aTy())
  fbLocalGet(bA + 1)
  fbStructGet(lTy(), 0) // backing B
  fbLocalGet(bA + 4)
  fbArrayGet(aTy())
  fbI32Bin(71)          // element i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(3)               // mismatch → 0, exit block
  fbEnd()
  fbLocalGet(bA + 4)
  fbI32Const(1)
  fbI32Bin(106)         // i + 1
  fbLocalSet(bA + 4)
  fbBr(1)               // back to loop
  fbEnd()               // end (ge_s if/else)
  fbEnd()               // end (loop)
  fbI32Const(1)
  fbEnd()               // end (block)
  return 0
}

// Pushes whether element `i` of the staged list A, then of B, in the LEQS frame at `bA`, is null.
function leqSElemNullTest(bA: i32) {
  fbLocalGet(bA + 0)
  fbStructGet(mkListTy(), 0)
  fbLocalGet(bA + 3)
  fbArrayGet(mkArrTy())
  fbRefIsNull()
  fbLocalGet(bA + 1)
  fbStructGet(mkListTy(), 0)
  fbLocalGet(bA + 3)
  fbArrayGet(mkArrTy())
  fbRefIsNull()
  return 0
}

// String-list `==`: outer loop over the LEQS frame; each element pair rides
// `emitStrEqCore` (the string-op frame — disjoint locals, safe to nest). Any element may be
// null, whatever the list's declared element: two nulls are equal, a null and a string are not.
function emitListEqSCore() {
  const bA = leqSScratchBase
  fbLocalSet(bA + 1)         // B
  fbLocalSet(bA + 0)         // A
  fbBlock(127)               // block i32
  fbLocalGet(bA + 0)
  fbStructGet(mkListTy(), 1) // lenA
  fbLocalSet(bA + 2)         // n
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 1)
  fbStructGet(mkListTy(), 1)
  fbI32Bin(71)               // i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(1)
  fbEnd()
  fbI32Const(0)
  fbLocalSet(bA + 3)         // i = 0
  fbLoop(64)
  fbLocalGet(bA + 3)
  fbLocalGet(bA + 2)
  fbI32Bin(78)
  fbIf(64)
  fbElse()
  leqSElemNullTest(bA)
  fbI32Bin(114)              // i32.or: either element null
  fbIf(127)
  leqSElemNullTest(bA)
  fbI32And()                 // equal only when both are
  fbElse()
  // push elem A, elem B (non-null string refs), compare via the string core
  fbLocalGet(bA + 0)
  fbStructGet(mkListTy(), 0)
  fbLocalGet(bA + 3)
  fbArrayGet(mkArrTy())
  fbRefAsNonNull()
  fbLocalGet(bA + 1)
  fbStructGet(mkListTy(), 0)
  fbLocalGet(bA + 3)
  fbArrayGet(mkArrTy())
  fbRefAsNonNull()
  if emitStrEqCore() < 0 { return -1 }
  fbEnd()
  fbI32Eqz() // 1 = mismatch
  fbIf(64)
  fbI32Const(0)
  fbBr(3)
  fbEnd()
  fbLocalGet(bA + 3)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(bA + 3)
  fbBr(1)
  fbEnd()
  fbEnd()
  fbI32Const(1)
  fbEnd()
  return 0
}

// `i32[][]` `==`: outer loop over the slot's LEQR frame; each element pair (two
// inner i32-list wrappers) recurses through `emitListEqICore` (disjoint frame).
function emitListEqRCore(slot: i32, base: i32) {
  fbLocalSet(base + 1) // B
  fbLocalSet(base + 0) // A
  fbBlock(127)         // block i32
  fbLocalGet(base + 0)
  fbStructGet(rlWrapIdx[slot], 1)
  fbLocalSet(base + 2) // n
  fbLocalGet(base + 2)
  fbLocalGet(base + 1)
  fbStructGet(rlWrapIdx[slot], 1)
  fbI32Bin(71)
  fbIf(64)
  fbI32Const(0)
  fbBr(1)
  fbEnd()
  fbI32Const(0)
  fbLocalSet(base + 3) // i = 0
  fbLoop(64)
  fbLocalGet(base + 3)
  fbLocalGet(base + 2)
  fbI32Bin(78)
  fbIf(64)
  fbElse()
  fbLocalGet(base + 0)
  fbStructGet(rlWrapIdx[slot], 0)
  fbLocalGet(base + 3)
  fbArrayGet(rlBackIdx[slot])
  fbRefAsNonNull()
  fbLocalGet(base + 1)
  fbStructGet(rlWrapIdx[slot], 0)
  fbLocalGet(base + 3)
  fbArrayGet(rlBackIdx[slot])
  fbRefAsNonNull()
  if emitListEqICore() < 0 { return -1 }
  fbI32Eqz()
  fbIf(64)
  fbI32Const(0)
  fbBr(3)
  fbEnd()
  fbLocalGet(base + 3)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(base + 3)
  fbBr(1)
  fbEnd()
  fbEnd()
  fbI32Const(1)
  fbEnd()
  return 0
}

// The reserved LEQR frame base for ref-list slot `slot`, or -1.
function leqRBaseOfSlot(slot: i32) {
  const i = i32ListIndexOf(fnListEqRSlots, slot)
  if i < 0 { return -1 }
  return leqRBases[i]
}

// The two locals a STRUCT-element compare parked its element pair in, or -1 outside one.
// Read by `emitChainRead` through the root sentinels -2 / -3; see its header for why the
// value rides here rather than as a parameter.
let eqStashL = -1
let eqStashR = -1

// D1180 — TRUE while a ref-NICHE field's compare runs UNDER its null guard, so every chain
// read of it recovers the non-null ref the leaf core wants. It rides here for the same reason
// the stash pair does: `emitChainRead` is called from a dozen arms and threading a parameter
// through all of them would put the flag at every call site instead of the one that sets it.
let eqChainRecover = false

// The `i32.ne`-class element opcode for a scalar-leaf list rep — the only byte that
// differs between the four wide backings' element compares. Kind 0 covers every rep
// that already is an i32 (boolean, an interned atom, an i32-based literal union) and
// kind 10 (packed u8), since `fbArrayGet` zero-extends the byte before comparing.
function eqgNeOpcode(kind: i32) {
  if kind == LBK_F64_LIST {
    return 98 // 0x62 f64.ne
  }
  if kind == LBK_I64_LIST {
    return 82 // 0x52 i64.ne
  }
  if kind == LBK_F32_LIST {
    return 92 // 0x5c f32.ne
  }
  return 71 // 0x47 i32.ne
}

// The one entry for a list `==` at rep (kind, slot), with both wrapper refs already on
// the stack (left below right); leaves the 0/1 answer, routing to whichever core owns
// the rep (the three pre-existing cores keep every shape they claim; everything else is
// `emitListEqGCore`). A function, not an inline arm, so a nested compare's recursion has one place to go.
function emitListEqAnyRep(kind: i32, slot: i32, fnIx: i32) {
  // A list core starts a fresh chain, so the niche guard's recover must not survive into
  // it (D1291): every read the core makes below is its own, and an `i32` leaf field with
  // a stray `ref.as_non_null` appended is check-clean invalid wasm. The flag names the
  // current chain, so it is cleared for the duration of any core that opens another one.
  const savedRec = eqChainRecover
  eqChainRecover = false
  const r = emitListEqAnyRepAt(kind, slot, fnIx)
  eqChainRecover = savedRec
  return r
}

function emitListEqAnyRepAt(kind: i32, slot: i32, fnIx: i32) {
  if kind == LBK_I32_LIST { return emitListEqICore() }
  if kind == LBK_STR_LIST { return emitListEqSCore() }
  if kind == LBK_REF {
    if slot >= 0 && slot < rlElemTyIx.length {
      if rlElemKindAt(slot) == RLK_I32_LIST {
        const rb = leqRBaseOfSlot(slot)
        if rb < 0 {
          return emitFail("emitProgram: ref-list compare frame not reserved")
        }
        return emitListEqRCore(slot, rb)
      }
    }
  }
  return emitListEqGCore(kind, slot, fnIx)
}

// One element read at index `i` of the staged wrapper in frame slot `bA + which`, left
// on the stack ready for compare: `backing[i]`, plus the non-null recovery a ref element
// needs. Split out because the two operands' reads must interleave with their recoveries
// — a single trailing recover would recover the right operand twice, leaving the left nullable.
function emitEqGElemRead(
  bA: i32,
  which: i32,
  wrap: i32,
  back: i32,
  isRef: boolean,
) {
  fbLocalGet(bA + which)
  fbStructGet(wrap, 0) // the backing
  fbLocalGet(bA + 3)   // i
  fbArrayGet(back)
  if isRef {
    fbRefAsNonNull() // 0xd4
  }
  return 0
}

// One element pair of a struct-element list, compared field-wise, leaving the 0/1
// equality: read `backing[i]` for each side into a fresh lazy-frame slot, then run the
// ordinary struct compare with those slots as its two roots. The stash globals are saved
// and restored rather than cleared, since a nested list of structs re-enters this from inside an outer `emitListEqGCore` whose own element rung may still be running.
function emitEqGStructElem(slot: i32, fnIx: i32) {
  if !eqgElemHasEqRow(slot) {
    return emitFail(
      "emitProgram: struct-element compare with no interned shape",
    )
  }
  const row = eqgElemEqRow(slot)
  const sa = listElemStashSlot("reflist", slot)
  const sb = listElemStashSlot("reflist", slot)
  const bA = leqgBaseOfRep(LBK_REF, slot)
  const wrap = catWrapIdxOf(LBK_REF, slot)
  const back = catBackIdxOf(LBK_REF, slot)
  // A[i] → sa, B[i] → sb. Not `emitEqGElemRead`: these want the RAW nullable element, and
  // the slot they land in is nullable too, so there is no recovery to make.
  fbLocalGet(bA + 0)
  fbStructGet(wrap, 0)
  fbLocalGet(bA + 3)
  fbArrayGet(back)
  fbLocalSet(sa)
  fbLocalGet(bA + 1)
  fbStructGet(wrap, 0)
  fbLocalGet(bA + 3)
  fbArrayGet(back)
  fbLocalSet(sb)
  // A nullable element: equal when both are null, unequal when one is, else field-wise.
  const nul = slot < rlElemNullable.length && rlElemNullable[slot] == 1
  if nul {
    fbLocalGet(sa)
    fbRefIsNull()
    fbLocalGet(sb)
    fbRefIsNull()
    fbI32Bin(114) // i32.or
    fbIf(127)
    fbLocalGet(sa)
    fbRefIsNull()
    fbLocalGet(sb)
    fbRefIsNull()
    fbI32And()
    fbElse()
  }
  const savedL = eqStashL
  const savedR = eqStashR
  eqStashL = sa
  eqStashR = sb
  const pathSi: i32[] = []
  const pathFi: i32[] = []
  const r = emitStructEqRec(-2, -3, row, pathSi, pathFi, fnIx)
  eqStashL = savedL
  eqStashR = savedR
  if nul { fbEnd() }
  return r
}

// List `==` over every other list rep: needs an element loop and `eqgElemClass`'s answer
// to "compare two of these" — a scalar leaf, a string leaf, or a nested list (recurse) —
// declining any rep it cannot classify rather than guessing a compare. Each recursion
// level has its own frame keyed on (kind, slot), and a list is never its own element, which is what makes the recursion safe.
function emitListEqGCore(kind: i32, slot: i32, fnIx: i32) {
  const bA = leqgBaseOfRep(kind, slot)
  if bA < 0 {
    // The scan and the emitter read ONE home (`eqgListKindOfBin` / `eqgElemClass`), so a
    // missing frame is a desync rather than a program property — loud, never a write into
    // a local the function never declared.
    return emitFail(
      "emitProgram: list compare frame was not reserved for this rep",
    )
  }
  const cls = eqgElemClass(kind, slot)
  if cls == "none" {
    return emitFail(
      "emitProgram: list compare over an element rep with no core",
    )
  }
  const wrap = catWrapIdxOf(kind, slot)
  const back = catBackIdxOf(kind, slot)
  const isRef = cls != "scalar"
  fbLocalSet(bA + 1)   // B
  fbLocalSet(bA + 0)   // A
  fbBlock(127)         // block i32
  fbLocalGet(bA + 0)
  fbStructGet(wrap, 1) // lenA
  fbLocalSet(bA + 2)   // n = lenA
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 1)
  fbStructGet(wrap, 1) // lenB
  fbI32Bin(71)         // 0x47 i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(1)
  fbEnd()
  fbI32Const(0)
  fbLocalSet(bA + 3)   // i = 0
  fbLoop(64)
  fbLocalGet(bA + 3)
  fbLocalGet(bA + 2)
  fbI32Bin(78)         // 0x4e i32.ge_s — i >= n → done
  fbIf(64)
  fbElse()
  if cls != "struct" {
    if emitEqGElemRead(bA, 0, wrap, back, isRef) < 0 { return -1 }
    if emitEqGElemRead(bA, 1, wrap, back, isRef) < 0 { return -1 }
  }
  match cls {
    "struct" => {
      // A struct element, compared field-wise off two stashed locals. The pair is parked
      // rather than left on the stack because `emitStructEqRec` re-reads each root once per
      // field, and a `(ref null <elem heap>)` slot would trap `struct.get` on null —
      // `eqgElemClass` claims only the non-nullable struct element kind, so it never does.
      if emitEqGStructElem(slot, fnIx) < 0 { return -1 }
      fbI32Eqz() // the compare leaves EQUALITY; the branch below tests MISMATCH
    }
    // A union-box element, tag first and then the arm, as a box-typed field compares; leaves
    // EQUALITY.
    "union" => {
      const un = if slot >= 0 && slot < rlElemName.length { rlElemUnionName(slot) } else { "" }
      const uArms: i32[] = []
      const uVis: i32[] = []
      const uAks: i32[] = []
      if (
        un == ""
        || !unionBoxEqColumns(rlElemTyIxAt(slot), uArms, uVis, uAks)
      ) {
        return emitFail(
          "emitProgram: list compare over a union element with no arm columns",
        )
      }
      if (emitUnionBoxEqStaged(uArms, uVis, uAks, false, fnIx) < 0) {
        return -1
      }
      fbI32Eqz() // 0x45
    }
    // A recursive record element, through its minted compare function, which leaves EQUALITY.
    "call" => {
      fbCall(gImports + eqgCoreFeOfSlot(slot))
      fbI32Eqz() // 0x45
    }
    "scalar" => {
      // Two scalar leaves: one opcode, and it leaves the MISMATCH the branch below tests.
      wU8(eqgNeOpcode(kind))
    }
    // A REF leaf — a string or an inner list — through its own core, which leaves
    // EQUALITY; the branch below tests mismatch, so negate once.
    "string" => {
      if emitStrEqCore() < 0 { return -1 }
      fbI32Eqz() // 0x45
    }
    "list" => {
      if (emitListEqAnyRep(eqgInnerKind(slot), eqgInnerSlot(slot), fnIx) < 0) {
        return -1
      }
      fbI32Eqz() // 0x45
    }
  }
  fbIf(64)
  fbI32Const(0)
  fbBr(3)       // mismatch → 0, exit the block
  fbEnd()
  fbLocalGet(bA + 3)
  fbI32Const(1)
  fbI32Bin(106) // i + 1
  fbLocalSet(bA + 3)
  fbBr(1)       // back to the loop header
  fbEnd()       // end (ge_s if/else)
  fbEnd()       // end (loop)
  fbI32Const(1)
  fbEnd()       // end (block)
  return 0
}

// `==` / `!=` over two lists stored apart (`xrepEmitPair`): both operands, then the
// cross-rep loop, negated for `!=`.
function emitListEqXBin(e: BinExpr, fnIx: i32) {
  const kA = eqgListKindOfExpr(e.binLeft, fnIx)
  const kB = eqgListKindOfExpr(e.binRight, fnIx)
  let sA = 0
  if kA == LBK_REF { sA = refListSlotOfExpr(e.binLeft, fnIx) }
  let sB = 0
  if kB == LBK_REF { sB = refListSlotOfExpr(e.binRight, fnIx) }
  if emitExpr(e.binLeft, fnIx) < 0 { return -1 }
  if emitEqRecoverNarrowed(e.binLeft, fnIx) < 0 { return -1 }
  svSyncRecv(e.binLeft, fnIx)
  if emitExpr(e.binRight, fnIx) < 0 { return -1 }
  if emitEqRecoverNarrowed(e.binRight, fnIx) < 0 { return -1 }
  svSyncRecv(e.binRight, fnIx)
  if emitListEqXCore(kA, sA, kB, sB, fnIx) < 0 { return -1 }
  if e.binOp == "!=" { fbI32Eqz() }
  return 0
}

// The number kind a list rep's elements hold (0 i32, 3 i64, 4 f64, 5 f32) for a plain number
// list, -2 for a list of union boxes, -3 for a list of records compared field-wise, -4 for a
// list of lists, or -1.
function xrepElemKind(kind: i32, slot: i32): i32 {
  if kind == LBK_I32_LIST { return 0 }
  if kind == LBK_I64_LIST { return 3 }
  if kind == LBK_F64_LIST { return 4 }
  if kind == LBK_F32_LIST { return 5 }
  if kind == LBK_REF && slot >= 0 && slot < rlElemTyIx.length {
    if rlElemKindAt(slot) == RLK_UNION { return -2 }
    if eqgInnerKind(slot) >= 0 { return -4 }
    if eqgElemHasEqRow(slot) { return -3 }
  }
  return -1
}

// The two-rep list compare: the wrappers parked in frame `fA`'s A slot and frame `fB`'s B
// slot, `fA`'s length and index, and each element pair compared by value at the wider number
// (D15055). Leaves the 0/1 equality.
function emitListEqXCore(kA: i32, sA: i32, kB: i32, sB: i32, fnIx: i32) {
  const fA = leqgBaseOfRep(kA, sA)
  const fB = leqgBaseOfRep(kB, sB)
  const eA = xrepElemKind(kA, sA)
  const eB = xrepElemKind(kB, sB)
  if fA < 0 || fB < 0 || eA == -1 || eB == -1 {
    return emitFail(
      "emitProgram: a list compare across two element storages has no frame or element rep",
    )
  }
  const wA = catWrapIdxOf(kA, sA)
  const bA = catBackIdxOf(kA, sA)
  const wB = catWrapIdxOf(kB, sB)
  const bB = catBackIdxOf(kB, sB)
  fbLocalSet(fB + 1) // B
  fbLocalSet(fA + 0) // A
  fbBlock(127)
  fbLocalGet(fA + 0)
  fbStructGet(wA, 1)
  fbLocalSet(fA + 2) // n = lenA
  fbLocalGet(fA + 2)
  fbLocalGet(fB + 1)
  fbStructGet(wB, 1)
  fbI32Bin(71)       // i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(1)
  fbEnd()
  fbI32Const(0)
  fbLocalSet(fA + 3) // i = 0
  fbLoop(64)
  fbLocalGet(fA + 3)
  fbLocalGet(fA + 2)
  fbI32Bin(78)       // i32.ge_s
  fbIf(64)
  fbElse()
  if xrepElemEq(fA, fB, wA, bA, wB, bB, eA, eB, sA, sB, fnIx) < 0 { return -1 }
  fbI32Eqz()
  fbIf(64)
  fbI32Const(0)
  fbBr(3)
  fbEnd()
  fbLocalGet(fA + 3)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(fA + 3)
  fbBr(1)
  fbEnd()
  fbEnd()
  fbI32Const(1)
  fbEnd()
  return 0
}

// Element `i` (frame `fA`'s index) of the wrapper in local `wl`.
function xrepElemRead(
  wl: i32,
  iLocal: i32,
  wrap: i32,
  back: i32,
  isRef: boolean,
) {
  fbLocalGet(wl)
  fbStructGet(wrap, 0)
  fbLocalGet(iLocal)
  fbArrayGet(back)
  if isRef { fbRefAsNonNull() }
  return 0
}

// One element pair of `emitListEqXCore`, leaving the 0/1 equality: two numbers at the wider
// kind, two boxes through the staged union compare, or a box against a number.
function xrepElemEq(
  fA: i32,
  fB: i32,
  wA: i32,
  bA: i32,
  wB: i32,
  bB: i32,
  eA: i32,
  eB: i32,
  sA: i32,
  sB: i32,
  fnIx: i32,
) {
  const i = fA + 3
  // Two inner lists stored apart: the same loop one level down, at the inner reps (D15092).
  if eA == -4 && eB == -4 {
    xrepElemRead(fA + 0, i, wA, bA, true)
    xrepElemRead(fB + 1, i, wB, bB, true)
    return emitListEqXCore(
      eqgInnerKind(sA),
      eqgInnerSlot(sA),
      eqgInnerKind(sB),
      eqgInnerSlot(sB),
      fnIx,
    )
  }
  if eA == -3 || eB == -3 { return emitEqGStructElemX(fA, fB, sA, sB, fnIx) }
  if eA >= 0 && eB >= 0 {
    const wide = xrepWideKind(eA, eB)
    xrepElemRead(fA + 0, i, wA, bA, false)
    const upA = widenConvOpOfKinds(eA, wide)
    if upA >= 0 { wU8(upA) }
    xrepElemRead(fB + 1, i, wB, bB, false)
    const upB = widenConvOpOfKinds(eB, wide)
    if upB >= 0 { wU8(upB) }
    wU8(numEqOpOfKind(wide))
    return 0
  }
  if eA == -2 && eB == -2 {
    if sA < 0 || sA >= rlElemName.length || sB < 0 || sB >= rlElemName.length {
      return emitFail(
        "emitProgram: list compare over a union element with no row",
      )
    }
    const armsA: i32[] = []
    const visA: i32[] = []
    const aksA: i32[] = []
    const armsB: i32[] = []
    const visB: i32[] = []
    const aksB: i32[] = []
    if (
      !unionBoxEqColumns(rlElemTyIxAt(sA), armsA, visA, aksA)
      || !unionBoxEqColumns(rlElemTyIxAt(sB), armsB, visB, aksB)
    ) {
      return emitFail(
        "emitProgram: list compare over a union element with no arm columns",
      )
    }
    xrepElemRead(fA + 0, i, wA, bA, true)
    xrepElemRead(fB + 1, i, wB, bB, true)
    return emitUnionBoxEqStagedX(armsA, visA, aksA, aksB, false, fnIx)
  }
  // A box against a number, the box read first whichever side holds it.
  let boxSlot = sA
  let numKind = eB
  if eA == -2 {
    xrepElemRead(fA + 0, i, wA, bA, true)
  } else {
    boxSlot = sB
    numKind = eA
    xrepElemRead(fB + 1, i, wB, bB, true)
  }
  const bs = unionAsBoxSlot()
  fbLocalSet(bs)
  if eA == -2 {
    xrepElemRead(fB + 1, i, wB, bB, false)
  } else {
    xrepElemRead(fA + 0, i, wA, bA, false)
  }
  const os = numCrossEqSlot(numKind)
  fbLocalSet(os)
  const arms: i32[] = []
  const vis: i32[] = []
  const aks: i32[] = []
  if (!unionBoxEqColumns(rlElemTyIxAt(boxSlot), arms, vis, aks)) {
    return emitFail(
      "emitProgram: list compare over a union element with no arm columns",
    )
  }
  let opened = 0
  for ka in aks {
    const wide = xrepWideKind(ka, numKind)
    if ka >= 0 && wide >= 0 && numEqOpOfKind(wide) >= 0 {
      fbLocalGet(bs)
      fbStructGet(uBoxIdx, 0)
      fbI32Rel(RS_TAG, scalarTagOfKind(ka))
      fbI32Bin(70)
      fbIf(127)
      fbLocalGet(bs)
      if emitUnionUnboxTail(ka) < 0 { return -1 }
      const up1 = widenConvOpOfKinds(ka, wide)
      if up1 >= 0 { wU8(up1) }
      fbLocalGet(os)
      const up2 = widenConvOpOfKinds(numKind, wide)
      if up2 >= 0 { wU8(up2) }
      wU8(numEqOpOfKind(wide))
      fbElse()
      opened = opened + 1
    }
  }
  fbI32Const(0)
  while opened > 0 {
    fbEnd()
    opened = opened - 1
  }
  return 0
}

// `emitEqGStructElem` across two list reps of one record, one of them nullable: element `i` of
// frame `fA`'s A wrapper and of frame `fB`'s B wrapper, both stashed at the nullable slot's
// element type, then compared field-wise under the null guard. Leaves the 0/1 equality.
function emitEqGStructElemX(fA: i32, fB: i32, sA: i32, sB: i32, fnIx: i32) {
  if (
    !eqgElemHasEqRow(sA)
    || !eqgElemHasEqRow(sB)
    || eqgElemEqRow(sA) != eqgElemEqRow(sB)
  ) {
    return emitFail(
      "emitProgram: a record-list compare across two storages has no one interned shape",
    )
  }
  const row = eqgElemEqRow(sA)
  let ns = sA
  if !(sA < rlElemNullable.length && rlElemNullable[sA] == 1) { ns = sB }
  const sa = listElemStashSlot("reflist", ns)
  const sb = listElemStashSlot("reflist", ns)
  fbLocalGet(fA + 0)
  fbStructGet(catWrapIdxOf(LBK_REF, sA), 0)
  fbLocalGet(fA + 3)
  fbArrayGet(catBackIdxOf(LBK_REF, sA))
  fbLocalSet(sa)
  fbLocalGet(fB + 1)
  fbStructGet(catWrapIdxOf(LBK_REF, sB), 0)
  fbLocalGet(fA + 3)
  fbArrayGet(catBackIdxOf(LBK_REF, sB))
  fbLocalSet(sb)
  fbLocalGet(sa)
  fbRefIsNull()
  fbLocalGet(sb)
  fbRefIsNull()
  fbI32Bin(114) // i32.or
  fbIf(127)
  fbLocalGet(sa)
  fbRefIsNull()
  fbLocalGet(sb)
  fbRefIsNull()
  fbI32And()
  fbElse()
  const savedL = eqStashL
  const savedR = eqStashR
  eqStashL = sa
  eqStashR = sb
  const pathSi: i32[] = []
  const pathFi: i32[] = []
  const r = emitStructEqRec(-2, -3, row, pathSi, pathFi, fnIx)
  eqStashL = savedL
  eqStashR = savedR
  fbEnd()
  return r
}

// The kind two number kinds compare at: the same kind, or the one the other widens to; -1 for
// a pair neither widens.
function xrepWideKind(a: i32, b: i32): i32 {
  if a == b { return a }
  return wideKindOf(a, b)
}

// The reserved LEQG frame base for compare rep `(kind, slot)`, or -1, over the pair the
// reservation scan pushed.
function leqgBaseOfRep(kind: i32, slot: i32) {
  const i = i32PairIndexOf(fnListEqGKinds, fnListEqGSlots, kind, slot)
  if i < 0 { return -1 }
  return leqgBases[i]
}

// How `+` node `e` at `ix` is a list concat: not one, one legacy refuses (its operands resolve to
// no one list rep, or an element kind with no concat), one whose operands are at the concat's
// rep, or one that widens an operand first (`catWidenSideOfBin`). Legacy and the IR ask it.
export type ListCatRoute = "none" | "refused" | "plain" | "widen"

export function listCatRouteOf(e: BinExpr, ix: i32, fnIx: i32): ListCatRoute {
  if e.binOp != "+" || exprIsStrConcat(ix, fnIx) { return "none" }
  if binConcatRepUnresolved(ix, fnIx) { return "refused" }
  if catListKindOfBin(ix, fnIx) > 0 {
    return if catWidenSideOfBin(ix, fnIx) == 0 { "plain" } else { "widen" }
  }
  return match listOpKindOfBin(ix, fnIx) {
    "none" => "none"
    "i32list" => "plain"
    "strlist" | "reflist" | "glist" | "str" | "closure" => "refused"
  }
}

// i32-list CONCAT `a + b`: a NEW list sized exactly lenA + lenB (one backing
// allocation, two bulk `array.copy`s) — the host's §VL.4 lowering. Both operands
// are evaluated onto the stack before either is stored into the shared LEQI frame, so
// a concat nested in the right operand cannot overwrite A (D2331).
function emitListConcatI(leftIx: i32, rightIx: i32, binIx: i32, fnIx: i32) {
  if emitExpr(leftIx, fnIx) < 0 { return -1 }
  listCatOperandTail(leftIx, binIx, fnIx)
  if emitExpr(rightIx, fnIx) < 0 { return -1 }
  listCatOperandTail(rightIx, binIx, fnIx)
  return listCatTail(binIx, fnIx)
}

// The recovery after list `+` operand `opIx` at concat `binIx` is on the stack: a NARROWED
// nullable operand's cell still holds a `(ref null …)` while the frame slot is non-null. Legacy
// and the IR share it.
export function listCatOperandTail(opIx: i32, binIx: i32, fnIx: i32) {
  if catListKindOfBin(binIx, fnIx) <= 0 {
    if exprNullableList(opIx, fnIx) { fbRefAsNonNull() }
    return 0
  }
  if emitEqRecoverNarrowed(opIx, fnIx) < 0 { return -1 }
  svSyncRecv(opIx, fnIx)
  return 0
}

// List `+` at `binIx` once both operands are on the stack: one backing allocation sized
// `lenA + lenB`, two `array.copy`s, one wrapper, through the i32 list's LEQI frame or the rep's
// own LCAT frame. Legacy and the IR share it.
export function listCatTail(binIx: i32, fnIx: i32): i32 {
  const kind = catListKindOfBin(binIx, fnIx)
  if kind <= 0 { return listCatWrite(leqIScratchBase, lTy(), aTy()) }
  const slot = catSlotOfBin(binIx, fnIx)
  const bA = lcatBaseOfRep(kind, slot)
  if bA < 0 {
    // The scan and the emitter read ONE home (`catListKindOfBin`), so a missing frame is
    // a desync rather than a program property — loud, never a write into a local the
    // function never declared.
    return emitFail(
      "emitProgram: list concat frame was not reserved for this rep",
    )
  }
  return listCatWrite(bA, catWrapIdxOf(kind, slot), catBackIdxOf(kind, slot))
}

// The concat over frame `bA` (A, B, out, n) of wrapper `wrap` and backing `back`.
function listCatWrite(bA: i32, wrap: i32, back: i32): i32 {
  fbLocalSet(bA + 1)   // B
  fbLocalSet(bA + 0)   // A
  fbLocalGet(bA + 0)
  fbStructGet(wrap, 1) // lenA
  fbLocalGet(bA + 1)
  fbStructGet(wrap, 1) // lenB
  fbI32Bin(106)        // i32.add
  fbLocalSet(bA + 3)   // n = lenA + lenB
  fbLocalGet(bA + 3)
  fbArrayNewDefault(back)
  fbLocalSet(bA + 2)   // out backing
  // array.copy out 0 backingA 0 lenA
  fbLocalGet(bA + 2)
  fbI32Const(0)
  fbLocalGet(bA + 0)
  fbStructGet(wrap, 0)
  fbI32Const(0)
  fbLocalGet(bA + 0)
  fbStructGet(wrap, 1)
  fbArrayCopy(back, back)
  // array.copy out lenA backingB 0 lenB
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 0)
  fbStructGet(wrap, 1)
  fbLocalGet(bA + 1)
  fbStructGet(wrap, 0)
  fbI32Const(0)
  fbLocalGet(bA + 1)
  fbStructGet(wrap, 1)
  fbArrayCopy(back, back)
  // the result wrapper { out, n, n }
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 3)
  fbLocalGet(bA + 3)
  fbStructNew(wrap)
  return 0
}

// List concat over every other list rep — the rep-parameterised twin of `emitListConcatI`: each
// operand at the concat's rep (`emitCatOperand`), then the shared tail over the rep's LCAT frame.
// Both operands reach the stack before the frame is written: the frame is shared per rep, so a
// concat nested in the right operand would otherwise overwrite A (D2331).
function emitListConcatG(
  leftIx: i32,
  rightIx: i32,
  binIx: i32,
  fnIx: i32,
  kind: i32,
  slot: i32,
  widen: i32,
) {
  if lcatBaseOfRep(kind, slot) < 0 { return listCatTail(binIx, fnIx) }
  if emitCatOperand(leftIx, binIx, fnIx, kind, slot, widen == 1) < 0 {
    return -1
  }
  if emitCatOperand(rightIx, binIx, fnIx, kind, slot, widen == 2) < 0 {
    return -1
  }
  return listCatTail(binIx, fnIx)
}

// One operand of `emitListConcatG`, left on the stack at concat rep `(kind, slot)`. A `widen`
// operand is of the narrower rep (`catWidenSideOfBin`) and is copied into the concat's: boxed
// into a union-box row as a spread group is, or converted element-wise for a scalar list.
function emitCatOperand(
  opIx: i32,
  binIx: i32,
  fnIx: i32,
  kind: i32,
  slot: i32,
  widen: boolean,
) {
  if widen && kind == LBK_REF {
    return emitSpreadGroupBoxed(opIx, true, slot, fnIx)
  }
  if widen {
    const sk = mfRecvKindOf(opIx, fnIx)
    let dk: VKind | null = null
    if kind == LBK_F64_LIST { dk = "f64" }
    if kind == LBK_I64_LIST { dk = "i64" }
    if sk == null || dk == null {
      return emitFailAt(
        "emitProgram: a list `+` widening reached an operand `catWidenSideOfBin` does not admit",
        opIx,
      )
    }
    if emitSpreadGroup(opIx, fnIx, pendingKindOfList(sk, 0), 0) < 0 {
      return -1
    }
    if emitEqRecoverNarrowed(opIx, fnIx) < 0 { return -1 }
    svSyncRecv(opIx, fnIx)
    return emitScalarListWidenTop(listKindElemKind(sk), dk)
  }
  if emitExpr(opIx, fnIx) < 0 { return -1 }
  return listCatOperandTail(opIx, binIx, fnIx)
}

// The reserved LCAT frame base for concat rep `(kind, slot)`, or -1, over the pair the
// reservation scan pushed.
function lcatBaseOfRep(kind: i32, slot: i32) {
  const i = i32PairIndexOf(fnListCatKinds, fnListCatSlots, kind, slot)
  if i < 0 { return -1 }
  return lcatBases[i]
}

// Re-evaluate the field access chain `root.f1.f2…` onto `body`: the root expression, then
// one `struct.get` per (row, field) pair — a pure re-read, since the equality compare
// re-walks chains per field. Root indices -2/-3 are sentinels naming the two locals
// `emitListEqGCore` stashed a list element pair in, letting a struct compare run inside a list loop without threading that pair through every call site as a parameter.
function emitChainRead(rootIx: i32, pathSi: i32[], pathFi: i32[], fnIx: i32) {
  if rootIx == -2 || rootIx == -3 {
    let stash = eqStashL
    if rootIx == -3 { stash = eqStashR }
    if stash < 0 {
      return emitFail(
        "emitProgram: struct-element compare with no stashed root",
      )
    }
    fbLocalGet(stash)
    let sk = 0
    while sk < pathSi.length {
      fbStructGet(eqRowHeapIdx(pathSi[sk]), pathFi[sk])
      sk = sk + 1
    }
    if eqChainRecover { fbRefAsNonNull() }
    return 0
  }
  if emitExpr(rootIx, fnIx) < 0 { return -1 }
  let k = 0
  while k < pathSi.length {
    fbStructGet(eqRowHeapIdx(pathSi[k]), pathFi[k]) // 0xfb 0x02 <ht> <field>
    k = k + 1
  }
  if eqChainRecover { fbRefAsNonNull() }
  return 0
}

// Compare two closure fat-pointers already on the stack (left below right), leaving a
// 0/1 i32 for function identity: the same source declaration (field 2) and the same
// captured env (`ref.eq` over field 0 — two null envs are equal, two separately created
// envs of the same function are not).
function emitCloEqCore() {
  fbLocalSet(cloEqScratchBase + 1) // B = right operand
  fbLocalSet(cloEqScratchBase + 0) // A = left operand
  fbLocalGet(cloEqScratchBase + 0)
  fbStructGet(cloStructIdx, 2)     // A.decl
  fbLocalGet(cloEqScratchBase + 1)
  fbStructGet(cloStructIdx, 2)     // B.decl
  fbI32Bin(70)                     // 0x46 i32.eq
  fbLocalGet(cloEqScratchBase + 0)
  fbStructGet(cloStructIdx, 0)     // A.env
  fbLocalGet(cloEqScratchBase + 1)
  fbStructGet(cloStructIdx, 0)     // B.env
  fbRefEq()                        // (null == null → 1)
  fbI32Bin(113)                    // 0x71 i32.and
  return 0
}

// The one core-selection ladder for a `==`/`!=` whose two operands are already on the
// stack as non-null refs. Leaves the 0/1 equality answer, never the negation — `!=`
// belongs to the caller. Shared by the plain compare paths and `emitNulNicheEq`, so a rep
// the plain compare handles is a rep the nullable form handles by construction — two ladders is how the two drift apart.
export function emitEqNonNullCore(binIx: i32, fnIx: i32) {
  const e = nodeAt(binIx)
  if e is BinExpr {
    // One ask, threaded into both users below — the `coreK == 7` arm's own generic-rep
    // question re-derives it otherwise, on the same node.
    const eqLop = listOpKindOfBin(binIx, fnIx)
    const coreK = eqCoreKindOfBin(binIx, fnIx, eqLop)
    match coreK {
      "i32list" => {
        return emitListEqICore()
      }
      "strlist" => {
        return emitListEqSCore()
      }
      "reflist" => {
        let lslot = refListSlotOfExpr(e.binLeft, fnIx)
        if lslot < 0 { lslot = refListSlotOfExpr(e.binRight, fnIx) }
        const lbase = leqRBaseOfSlot(lslot)
        if lbase < 0 {
          return emitFail("emitProgram: ref-list compare frame not reserved")
        }
        return emitListEqRCore(lslot, lbase)
      }
      "str" => {
        return emitStrEqCore()
      }
      "closure" => {
        return emitCloEqCore()
      }
      "glist" => {
        return emitListEqAnyRep(
          eqgListKindOfBin(binIx, fnIx, eqLop),
          listOpSlotOfBin(binIx, fnIx),
          fnIx,
        )
      }
      "none" => {
        return emitFail(
          "emitProgram: `"
            + e.binOp
            + "` over this operand rep has no compare core",
        )
      }
    }
  }
  return emitFail("emitProgram: expected a `==`/`!=` for the compare core")
}

// One raw read of a nullable-niche `==` operand — never `ref.as_non_null`, because the
// guard around it exists precisely to see the null this rep can hold (a `string | null`
// ident otherwise recovers itself and traps on the value the guard answers for). A
// literal-union atom operand still widens to its member string first, as `emitStrEq` does.
function emitEqOperandRaw(ix: i32, fnIx: i32) {
  if exprIsLitAtom(ix, fnIx) { return emitStrValue(ix, fnIx) }
  return emitExpr(ix, fnIx)
}

// A narrowed nullable-niche operand's cell still holds a `(ref null …)`, and every compare
// core's frame slot demands the non-null ref, so a plain (unguarded) compare recovers its
// operands exactly as `for`-in, `.slice` and the member ops do — safe because the checker
// proved the read guarded. A genuinely-nullable operand never arrives here: `binEqNulNiche` claims it off the checker's banked type and the guard reads it raw.
function emitEqRecoverNarrowed(exprIx: i32, fnIx: i32) {
  if eqOperandRecovers(exprIx, fnIx) { fbRefAsNonNull() }
  return 0
}

// "Is this `==` operand null" — the shared ladder's answer for a nullable operand, a constant 0
// for a non-nullable one (the MIXED pairing `S | null == S`). Never a hand-rolled
// `ref.is_null`: `emitNulIsNullTest` is the one home for the null test of every rep and its
// header carries why.
function emitEqIsNull(ix: i32, fnIx: i32) {
  const claimed = emitNulIsNullTest(ix, fnIx, false, false)
  if claimed < 0 { return -1 }
  if claimed > 0 { return 0 }
  fbI32Const(0)
  return 0
}

// A `==`/`!=` where at least one operand is a nullable ref niche, lowered as the rep's own
// compare under a null guard: `null == null` is true, `null == v` false, and the
// non-null half runs the rep's existing core unchanged. `br_on_null` consumes the ref it
// tests, so the right operand's code is emitted twice but exactly one path runs at runtime, evaluating each operand exactly once.
function emitNulNicheEq(binIx: i32, fnIx: i32, niche: EqCmpKind) {
  const e = nodeAt(binIx)
  if e is BinExpr {
    if niche == "nulstruct" { return emitNulStructEq(binIx, fnIx) }
    fbBlock(127) // block i32 — $out, the 0/1 answer
    fbBlock(64) // block void — $onenull
    fbBlock(64) // block void — $lnull
    if emitEqOperandRaw(e.binLeft, fnIx) < 0 { return -1 }
    fbBrOnNull(0) // → $lnull; on non-null leaves (ref $rep)
    if emitEqOperandRaw(e.binRight, fnIx) < 0 { return -1 }
    fbBrOnNull(1) // → $onenull (unwinding past the left ref, which needs no drop)
    if emitEqNonNullCore(binIx, fnIx) < 0 { return -1 }
    fbBr(2) // → $out
    fbEnd()
    if emitEqOperandRaw(e.binRight, fnIx) < 0 { return -1 }
    fbRefIsNull() // both null ⇒ equal
    fbBr(1) // → $out
    fbEnd()
    fbI32Const(0)
    fbEnd()
    return 0
  }
  return emitFail("emitProgram: expected a `==`/`!=` over a nullable niche")
}

// The `nulstruct` arm of `emitNulNicheEq`. The struct core re-reads each operand from its root,
// so the guard is spelled as two null TESTS over the roots `structEqStage` staged, instead of
// the `br_on_null` consume.
function emitNulStructEq(binIx: i32, fnIx: i32) {
  const e = nodeAt(binIx)
  if e is BinExpr {
    // Asks the same two namespaces as the non-null dispatch, in the same order (niche rung
    // first) — asking only the struct one is how the nullable half drifts out of the
    // non-null half's capability. `siFound` is load-bearing, not decoration: an eq row is
    // `>= 0` for a struct and `< 0` for a variant, so `-1` is variant row 0 and cannot double as "no answer".
    let si = -1
    let siFound = false
    const nvi = binEqNulVariantRow(binIx, fnIx)
    if nvi >= 0 {
      si = eqRowOfVariant(nvi)
      siFound = true
    }
    if !siFound {
      const nsSi = structIndexOfExpr(e.binLeft, fnIx)
      if nsSi >= 0 {
        si = nsSi
        siFound = true
      }
    }
    if !siFound {
      // One side nullable over a variant record, the other that record bare: one variant row.
      const lnv = nulVariantIdxOfExpr(e.binLeft, fnIx)
      const pv = if lnv >= 0 { lnv } else { nulVariantIdxOfExpr(e.binRight, fnIx) }
      const bare = if lnv >= 0 { e.binRight } else { e.binLeft }
      if pv >= 0 && eqConcreteVariantRow(bare, fnIx) == pv {
        si = eqRowOfVariant(pv)
        siFound = true
      }
    }
    if !siFound {
      return emitFail("emitProgram: struct equality over a non-struct operand")
    }
    const savedL = eqStashL
    const savedR = eqStashR
    const r = emitNulStructEqAt(e.binLeft, e.binRight, si, fnIx)
    eqStashL = savedL
    eqStashR = savedR
    return r
  }
  return emitFail("emitProgram: expected a nullable-struct equality")
}

// `emitNulStructEq`'s guard and compare at eq row `si`, over roots staged once (`structEqStage`).
function emitNulStructEqAt(lIx: i32, rIx: i32, si: i32, fnIx: i32) {
  const roots = structEqStage(lIx, rIx, si, fnIx)
  if roots[0] == -1 { return -1 }
  const lRoot = roots[0]
  const rRoot = roots[1]
  fbBlock(127) // block i32 — $out
  if emitEqRootIsNull(lRoot, lIx, fnIx) < 0 { return -1 }
  if emitEqRootIsNull(rRoot, rIx, fnIx) < 0 { return -1 }
  fbI32Bin(71) // 0x47 i32.ne — the two sides disagree on nullness
  fbIf(64)
  fbI32Const(0)
  fbBr(1) // → $out
  fbEnd()
  if emitEqRootIsNull(lRoot, lIx, fnIx) < 0 { return -1 }
  fbIf(64)
  fbI32Const(1) // both null ⇒ equal
  fbBr(1) // → $out
  fbEnd()
  const pathSi: i32[] = []
  const pathFi: i32[] = []
  if (emitStructEqRec(lRoot, rRoot, si, pathSi, pathFi, fnIx) < 0) { return -1 }
  fbEnd()
  return 0
}

// True for the `eqCmpKindOfTy` tokens that name a nullable ref niche — the ones whose
// compare needs `emitNulNicheEq`'s guard. The box- and sentinel-repped nullables answer ""
// from that function and are deliberately not here: they already compare tag-first correctly.
function eqKindIsNulNiche(k: EqCmpKind) {
  return k == "nulstr"
    || k == "nullist"
    || k == "nulstrlist"
    || k == "nulreflist"
    || k == "nulglist"
    || k == "nulstruct"
    || k == "nulclosure"
}

// The nullable-niche token for this `==`/`!=`, or "" when neither operand is one. Reads
// the checker's banked type, which makes a narrowed operand fall out for free (inside
// `if a != null { a == b }` the banked type is already non-null); a bare `null` operand is
// excluded (owned by `emitNulIsNullTest`). Inside a monomorphized instance the banked type is a shared type variable instead, so `exprNulNicheKind`'s `fnIx`-scoped resolution answers there (D42).
function binEqNulNiche(binIx: i32, fnIx: i32): EqCmpKind {
  const e = nodeAt(binIx)
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      if nodeAt(unwrapParen(e.binLeft)) is NullLit { return "" }
      if nodeAt(unwrapParen(e.binRight)) is NullLit { return "" }
      const lk = eqCmpKindOfOperand(e.binLeft, fnIx)
      if eqKindIsNulNiche(lk) { return lk }
      const rk = eqCmpKindOfOperand(e.binRight, fnIx)
      if eqKindIsNulNiche(rk) { return rk }
      // A nullable literal-union atom reads as a nullable string (`emitEqOperandRaw`), its null
      // niche the null ref, so it compares as `string | null` does (D16822).
      if (
        (lk == "str" || rk == "str")
        && (binOperandNulAtom(e.binLeft, fnIx)
          || binOperandNulAtom(e.binRight, fnIx))
      ) {
        return "nulstr"
      }
    }
  }
  return ""
}

// Whether `==` operand `ix` is a literal-union atom whose type admits `null`.
function binOperandNulAtom(ix: i32, fnIx: i32): boolean {
  const t = nodeTyAt(ix, fnIx)
  if t < 0 || t >= T.tys.length || !(tyAt(t) is TyNullable) { return false }
  return nulAtomWidenTexts(ix, fnIx).length > 0 && exprIsLitAtom(ix, fnIx)
}

// The emitter's half of the ONE comparability answer: true when a `==`/`!=` operand's rep has
// NO compare core. The checker rejects these (`unsupported-lowering`, off the same
// `eqCmpKindOfTy`), so this is the FLOOR — unreachable from accepted source, and the difference
// between a loud `emitProgram:` failure and the i32 tail emitting `i32.eq` over two refs.
function binEqHasNoLowering(binIx: i32) {
  const e = nodeAt(binIx)
  if e is BinExpr {
    if nodeAt(unwrapParen(e.binLeft)) is NullLit { return false }
    if nodeAt(unwrapParen(e.binRight)) is NullLit { return false }
    return nodeEqCmpKind(e.binLeft) == "none"
      || nodeEqCmpKind(e.binRight) == "none"
  }
  return false
}

// The generic list compare's floor: true when the checker accepted the program on the
// generic core (`eqCmpKindOfTy` answered `glist`/`nulglist`) but the emitter cannot name
// the rep — an unresolved ref-list slot, operands at different slots, or the rep tables
// disagreeing with the arena about the element. Same shape and reason as `binConcatRepUnresolved` (D721): without it the fall-through is a silent `i32.eq` over two refs.
function binEqGRepUnresolved(binIx: i32, fnIx: i32) {
  const e = nodeAt(binIx)
  if e is BinExpr {
    if e.binOp != "==" && e.binOp != "!=" { return false }
    if nodeAt(unwrapParen(e.binLeft)) is NullLit { return false }
    if nodeAt(unwrapParen(e.binRight)) is NullLit { return false }
    // True only on the conjunction: the types say "two lists" and the rep side cannot name
    // their pair. Reads the banked types, not `nodeEqCmpKind` (D42), because inside a
    // monomorphized instance the operand nodes share the generic template — the banked
    // type is `T[]` (still a `TyArray`) where the token question goes blind ("").
    if (
      !binPlusIsListByTy(nodeTyAt(e.binLeft, fnIx), nodeTyAt(e.binRight, fnIx))
    ) {
      const tl = eqCoreKindOfTyToken(nodeEqCmpKind(e.binLeft))
      const tr = eqCoreKindOfTyToken(nodeEqCmpKind(e.binRight))
      if tl != "glist" && tr != "glist" { return false }
    }
    // A core's claim on the pair is trusted only when the rep-home classifier
    // (`catListKindOfExpr`) agrees which rep this is: `listOpKindOf` picks among only the
    // three old cores, so it can silently misclassify an unhandled rep (an `i64[]` falling
    // through to the i32 core) — a claim it cannot corroborate is not a claim. Reads zero on today's tree (D755) but guards the next rep added to one ladder and not the other.
    const lop = listOpKindOfBin(binIx, fnIx)
    if lop != "none" {
      const ck = catListKindOfExpr(e.binLeft, fnIx)
      if ck >= 0 {
        // the i32 list, the string list, and a ref list of i32 lists.
        if lop == "i32list" && ck != LBK_I32_LIST { return true }
        if lop == "strlist" && ck != LBK_STR_LIST { return true }
        if lop == "reflist" && ck != LBK_REF { return true }
      }
      return false
    }
    if eqgListKindOfBin(binIx, fnIx, lop) >= 0 { return false }
    // A nullable niche runs the rep's own core under a guard, so a niche the guard claims
    // is a compare that already has one.
    if binEqNulNiche(binIx, fnIx) != "" { return false }
    return true
  }
  return false
}

// The `+` twin of `binEqHasNoLowering` (D721): true when the checker's banked types say
// this `+` is a list concat and the emitter cannot resolve the pair to one (wrapper,
// backing) rep — different ref-list slots, or no list rep at all. Reads the banked types
// too, since `catListKindOfBin` answering -1 alone is not evidence of a list; only the conjunction is a failure, since an unguarded numeric tail would otherwise emit `i32.add` over two refs.
function binConcatRepUnresolved(binIx: i32, fnIx: i32) {
  const e = nodeAt(binIx)
  if e is BinExpr {
    if e.binOp != "+" { return false }
    if (
      !binPlusIsListByTy(nodeTyAt(e.binLeft, fnIx), nodeTyAt(e.binRight, fnIx))
    ) {
      return false
    }
    return catListKindOfBin(binIx, fnIx) < 0
  }
  return false
}

// Lower a structural struct equality `a == b` (or `!=`) onto `body`, leaving a 0/1 i32:
// field-wise compare mirroring the host's `valueEq`. Every field compare re-reads its operand
// from the root, so an operand that is not a re-readable place is evaluated once into a stash
// first (`structEqStage`). Takes `row` rather than re-deriving it — the caller already asked both namespaces (struct and variant) and knows which answered; re-asking loses that (`structIndexOfExpr` alone answers -1 for a variant operand).
function emitStructEq(binIx: i32, fnIx: i32, row: i32) {
  const e = nodeAt(binIx)
  if e is BinExpr {
    const savedL = eqStashL
    const savedR = eqStashR
    const roots = structEqStage(e.binLeft, e.binRight, row, fnIx)
    const pathSi: i32[] = []
    const pathFi: i32[] = []
    const r = if roots[0] == -1 { -1 } else { emitStructEqRec(roots[0], roots[1], row, pathSi, pathFi, fnIx) }
    eqStashL = savedL
    eqStashR = savedR
    if r < 0 { return -1 }
    if e.binOp == "!=" {
      fbI32Eqz() // 0x45 i32.eqz — negate value-equality
    }
    return 0
  }
  return emitFail("emitProgram: expected a struct equality")
}

// The roots `emitStructEqRec` reads operands `lIx`/`rIx` of a compare at eq row `row` through:
// a re-readable place as itself, else the stash sentinel (-2 left, -3 right) over a slot
// `eqStashL`/`eqStashR` now names; `[-1, -1]` on failure. Both are evaluated in source order
// before either slot is set, and a left place is staged when the right may write it (D17023).
function structEqStage(lIx: i32, rIx: i32, row: i32, fnIx: i32): i32[] {
  const rStage = !unionEqOperandOk(rIx)
  const lStage = rStage || !unionEqOperandOk(lIx)
  if lStage && emitExpr(lIx, fnIx) < 0 { return [-1, -1] }
  if rStage && emitExpr(rIx, fnIx) < 0 { return [-1, -1] }
  let rRoot = rIx
  if rStage {
    eqStashR = structEqSlot(row, 1)
    fbLocalSet(eqStashR)
    rRoot = -3
  }
  let lRoot = lIx
  if lStage {
    eqStashL = structEqSlot(row, 0)
    fbLocalSet(eqStashL)
    lRoot = -2
  }
  return [lRoot, rRoot]
}

// The stash slot of operand `side` (0 left, 1 right) of a compare at eq row `row`, keyed above
// the band a nested-shape compare uses.
function structEqSlot(row: i32, side: i32): i32 {
  const key = 2048 + side * 1024
  return if row >= 0 { structEqStashSlot(row + key) } else { unionEqArmSlot(-1 - row + key) }
}

// `emitEqIsNull` over a compare root: a stashed operand is tested off its slot.
function emitEqRootIsNull(root: i32, ix: i32, fnIx: i32) {
  if root == -2 || root == -3 {
    fbLocalGet(if root == -2 { eqStashL } else { eqStashR })
    fbRefIsNull()
    return 0
  }
  return emitEqIsNull(ix, fnIx)
}

// One shape's field-wise compare at path (`pathSi`/`pathFi` from the roots), leaving 0/1:
// an and-chain of per-field compares lowered as nested value-typed `if`s, so a first
// mismatch short-circuits. `si` is an eq row (`eqRowOfVariant`), so one core serves a
// standalone struct and a union arm alike — the two differ only in which table holds the layout.
function emitStructEqRec(
  lRoot: i32,
  rRoot: i32,
  si: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
) {
  const cnt = eqRowFieldCount(si)
  if cnt == 0 {
    fbI32Const(1)
    return 0
  }
  let fi = 0
  while fi < cnt {
    if (emitStructEqField(lRoot, rRoot, si, fi, pathSi, pathFi, fnIx) < 0) {
      return -1
    }
    if fi < cnt - 1 {
      fbIf(127) // 0x04 if, 0x7f i32 blocktype — chain the next field
    }
    fi = fi + 1
  }
  // Close the chain: each opened `if` gets `else (i32.const 0) end`.
  let k = cnt - 1
  while k > 0 {
    fbElse() // 0x05 else
    fbI32Const(0)
    fbEnd()  // 0x0b end
    k = k - 1
  }
  return 0
}

// Compare ONE field at (si, fi) across the two chains, leaving 0/1. The path
// push/pop frames the inner compare so chains rewind for the next sibling field.
function emitStructEqField(
  lRoot: i32,
  rRoot: i32,
  si: i32,
  fi: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
) {
  pathSi.push(si)
  pathFi.push(fi)
  const r = emitStructEqFieldInner(lRoot, rRoot, si, fi, pathSi, pathFi, fnIx)
  pathSi.pop()
  pathFi.pop()
  return r
}

// `L.f == R.f` for a ref-niche field: `null == null` true, one side null false, else the
// non-null code's own core. Two null tests rather than `br_on_null`, since every inner arm
// re-reads its chain from the root. Opens the guard and leaves the both-non-null branch
// open for the caller to fill; paired with `emitNulFieldGuardClose`, split so leaf cores and the code-15 recursion can share one guard while differing on chain-read recovery.
function emitNulFieldGuardOpen(
  lRoot: i32,
  rRoot: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
) {
  if emitChainRead(lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
  fbRefIsNull()
  fbIf(127)     // 0x04 if, 0x7f i32 blocktype — the left field was null
  if emitChainRead(rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
  fbRefIsNull() // both null ⇒ equal
  fbElse()
  if emitChainRead(rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
  fbRefIsNull()
  fbIf(127)
  fbI32Const(0) // exactly one side null
  fbElse()
  return 0
}

function emitNulFieldGuardClose() {
  fbEnd()
  fbEnd()
  return 0
}

function emitNulFieldEq(
  lRoot: i32,
  rRoot: i32,
  si: i32,
  fi: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
  inner: VKind,
) {
  if emitNulFieldGuardOpen(lRoot, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
  // Both sides non-null: the leaf core wants `(ref $H)`, and only the guard knows that.
  const savedRec = eqChainRecover
  eqChainRecover = true
  const ir = emitStructEqFieldAt(
    lRoot,
    rRoot,
    si,
    fi,
    pathSi,
    pathFi,
    fnIx,
    inner,
  )
  eqChainRecover = savedRec
  if ir < 0 { return -1 }
  return emitNulFieldGuardClose()
}

function emitStructEqFieldInner(
  lRoot: i32,
  rRoot: i32,
  si: i32,
  fi: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
) {
  const code = eqRowFieldKind(si, fi)
  const nulInner = nulFieldInnerKind(code)
  if nulInner != null {
    return emitNulFieldEq(lRoot, rRoot, si, fi, pathSi, pathFi, fnIx, nulInner)
  }
  return emitStructEqFieldAt(lRoot, rRoot, si, fi, pathSi, pathFi, fnIx, code)
}

// The field-compare ladder, keyed by an EXPLICIT code so the null guard above can re-enter it
// at the non-null twin of a niche field.
function emitStructEqFieldAt(
  lRoot: i32,
  rRoot: i32,
  si: i32,
  fi: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
  code: VKind | null,
) {
  // Codes 21 (`boolean | null`) and 30 (`K | null`) share the scalar arm (D101): their null
  // rides in the value space rather than beside it, using the same `0x7f i32` storagetype
  // code 0 does, so plain `i32.eq` already answers `null == null` true and `null == "a"`
  // false with no guard needed.
  if code == "nulnone" {
    // A `null`-typed field holds only `null`, so the two sides always agree.
    fbI32Const(1)
    return 0
  }
  if code == "i32" || code == "nulbool" {
    // Scalar (i32 / boolean), or an i32-sentinel niche field: a native compare.
    if emitChainRead(lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    if emitChainRead(rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    fbI32Bin(70) // 0x46 i32.eq
    return 0
  }
  if code == "f64" || code == "i64" || code == "f32" {
    // A wide numeric scalar field: one native compare opcode, i32 0/1 result. The two
    // ladders (this one and `emitVariantFieldEqCore`) must not disagree about a field rep
    // — `{d: i64}` compared inside an `A | i32` union but refused outside it before this
    // arm covered i64/f32 too (D1181); one arm now serves all three widths.
    if emitChainRead(lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    if emitChainRead(rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    if code == "f64" {
      fbI32Bin(97) // 0x61 f64.eq
    } else if code == "i64" {
      fbI32Bin(81) // 0x51 i64.eq
    } else {
      fbI32Bin(91) // 0x5b f32.eq
    }
    return 0
  }
  if code == "str" {
    // String: the element-wise string-eq loop over the two field refs.
    if emitChainRead(lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    if emitChainRead(rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    return emitStrEqCore()
  }
  if eqKindIsRecord(code) {
    return emitStructEqNestedField(lRoot, rRoot, si, fi, pathSi, pathFi, fnIx)
  }
  if code == "list" {
    return emitStructEqI32ListField(lRoot, rRoot, pathSi, pathFi, fnIx)
  }
  if code == "closure" {
    // Function-valued field: identity compare (id + env) via the closure-eq frame.
    if emitChainRead(lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    if emitChainRead(rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    return emitCloEqCore()
  }
  if code == "union" {
    // A value-union / struct-union box field compares exactly as the box does at top
    // level: tag first, then the arm the tag selects, reading the two boxes off a field
    // path instead of off two operands. Columns are resolved first, so an arm set the
    // core cannot serve declines before any byte is written and reaches the loud refusal below (D1290).
    const bxTy = sFieldElemTyIxAt(si, fi)
    if bxTy >= 0 {
      const bxArms: i32[] = []
      const bxVis: i32[] = []
      const bxAks: i32[] = []
      if (unionBoxEqColumns(bxTy, bxArms, bxVis, bxAks)) {
        if emitChainRead(lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
        if emitChainRead(rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
        return emitUnionBoxEqStaged(bxArms, bxVis, bxAks, false, fnIx)
      }
    }
  }
  if code == "reflist" {
    // A ref-list field compares exactly as a ref list does at top level: push the two
    // lists and hand them to the shared core, whose struct-element class already routes
    // to the stash-based `emitStructEqRec(body, -2, -3, …)`. The only addition here is
    // reading the two lists off a field path instead of off two operands (D1017).
    if si >= 0 {
      if sFieldElemTyIxAt(si, fi) >= 0 {
        const d17s = sFieldRefSlot(si, fi)
        if d17s >= 0 {
          if emitChainRead(lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
          if emitChainRead(rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
          return emitListEqAnyRep(LBK_REF, d17s, fnIx)
        }
      }
    }
  }
  // A scalar-backed list field compares exactly as that list does at top level: read the
  // two lists off the field path and hand them to the generic core, whose frame
  // `leqNoteBin` reserved from the same map (`i32[]`, code 4, keeps its own arm above);
  // `f64[]`/`i64[]`/`string[]`/`f32[]`/`u8[]` fields get the same coverage here (D1020).
  const eqSk = eqScalarListKind(code)
  if eqSk >= 0 {
    if emitChainRead(lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    if emitChainRead(rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    const pr = if eqSk == LBK_U8_LIST { fieldRowPackedRow(sFieldStart[si] + fi) } else { 0 }
    return emitListEqAnyRep(eqSk, pr, fnIx)
  }
  return emitFail("emitProgram: unsupported struct field type in equality")
}

// `emitStructEqFieldAt`'s nested-struct field `fi` of row `si`: recurse one level deeper along
// the chain under an unconditional null guard (D1180) — `next: Node` and `next: Node | null`
// share code 15 over one `(ref null $S)` slot, so the guard always runs. Chain reads stay raw
// inside it; a deeper field has its own guard. Returns 0, or -1 on failure.
function emitStructEqNestedField(
  lRoot: i32,
  rRoot: i32,
  si: i32,
  fi: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
) {
  const nsi = eqRowTgtStructIdx(si, fi)
  if nsi < 0 {
    return emitFail(
      "emitProgram: nested struct field equality with no interned shape",
    )
  }
  const hf = eqHelpFnOf(nsi)
  if hf >= 0 {
    if emitChainRead(lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    if emitChainRead(rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    fbCall(hf)
    return 0
  }
  if emitNulFieldGuardOpen(lRoot, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
  if emitStructEqRec(lRoot, rRoot, nsi, pathSi, pathFi, fnIx) < 0 { return -1 }
  return emitNulFieldGuardClose()
}

// A struct row whose compare is written as a helper once its inline compare would read more
// than this many fields: the smallest a doubling record reaches at depth 5.
const EQ_HELP_PATHS = 32

// Per struct row, the leaf fields its inline compare reads, or -1 when a field has no compare;
// -2 marks a row being counted.
let eqHelpPaths: i32[] = []

// Reserve a compare helper functype for every struct row worth one: the program spells `==`
// somewhere, and the row's compare is helper-safe and reads more than `EQ_HELP_PATHS` fields.
export function eqHelpReserve() {
  gEqHelpTy = []
  gEqHelpFn = []
  gEqHelpTyN = 0
  eqHelpPaths = []
  let r = 0
  while r < sFieldCount.length {
    eqHelpPaths.push(-3)
    r = r + 1
  }
  r = 0
  while r < sFieldCount.length {
    if gSawEqOp && !sIsRefRow(r) && eqHelpPathsOf(r) > EQ_HELP_PATHS {
      gEqHelpTy.push(gEqHelpTyN)
      gEqHelpTyN = gEqHelpTyN + 1
    } else {
      gEqHelpTy.push(-1)
    }
    gEqHelpFn.push(-1)
    r = r + 1
  }
  return 0
}

// The leaf fields struct row `si`'s compare reads, saturating at 2^20, or -1 when one of them
// has no field compare or is a nested struct that is not itself helper-safe. A row reached
// again while it is counted recurses, so its inline compare never ends: it saturates, and the
// helper it then gets calls itself (D15636).
function eqHelpPathsOf(si: i32): i32 {
  if si < 0 || si >= eqHelpPaths.length { return -1 }
  const memo = eqHelpPaths[si]
  if memo == -2 { return 1048576 }
  if memo != -3 { return memo }
  eqHelpPaths[si] = -2
  let total = 0
  let fi = 0
  while fi < sFieldCount[si] && total >= 0 {
    const n = eqHelpFieldPaths(si, fi)
    if n < 0 { total = -1 } else { total = total + n }
    if total > 1048576 { total = 1048576 }
    fi = fi + 1
  }
  eqHelpPaths[si] = total
  return total
}

// The leaf fields field `fi` of struct row `si` contributes to its compare, or -1. A list,
// union box or function field counts as one: the helper's frame holds what it stages (D9962).
function eqHelpFieldPaths(si: i32, fi: i32): i32 {
  const code = eqRowFieldKind(si, fi)
  if eqKindIsRecord(code) { return eqHelpPathsOf(sFieldTgtStructIdx(si, fi)) }
  if code == "str" || code == "nulstr" { return 1 }
  if code == "nulnone" || code == "i32" || code == "nulbool" { return 1 }
  if code == "f64" || code == "i64" { return 1 }
  if code == "f32" || code == "union" || code == "closure" { return 1 }
  if code == "nulclosure" || code == "list" || code == "reflist" { return 1 }
  // Every other list code, nullable or not; a map field has no compare.
  const inner = nulFieldInnerKind(code)
  if inner == "list" || inner == "reflist" { return 1 }
  if eqScalarListKind(code) >= 0 || eqScalarListKind(inner) >= 0 { return 1 }
  return -1
}

// The function a nested compare of struct row `si` calls: its helper, given the next tail
// index the first time a compare asks, or -1 when the row has none and compares inline.
function eqHelpFnOf(si: i32): i32 {
  if si < 0 || si >= gEqHelpTy.length || gEqHelpTy[si] < 0 { return -1 }
  if gEqHelpFn[si] < 0 {
    gEqHelpFn[si] = gMapSetFnBase + gTailFnRows.length
    gTailFnRows.push(-1 - si)
  }
  return gEqHelpFn[si]
}

// `__eq_<row>__(a, b)`'s functype: two nullable refs of struct row `si`, an i32 0/1 result.
export function eqHelpFuncType(si: i32) {
  fbFuncTypeHead(2)
  fbRefNullValtype(sHeapIdx[si])
  fbRefNullValtype(sHeapIdx[si])
  wULEB(1)
  fbValtype("i32", -1)
  return 0
}

export function eqHelpFnName(si: i32): string {
  return "__eq_" + i32ToStr(si) + "__"
}

// The instructions of `__eq_<row>__`, after its locals vector: both null equal, one null
// unequal, else the field-wise compare a nested field would otherwise write inline, over the
// two params. Its frame is laid out by the caller before this runs.
export function eqHelpFnBody(si: i32): u8[] {
  const body: u8[] = []
  const prev = wTarget(body)
  const savedL = eqStashL
  const savedR = eqStashR
  const savedRec = eqChainRecover
  eqStashL = 0
  eqStashR = 1
  eqChainRecover = false
  const pathSi: i32[] = []
  const pathFi: i32[] = []
  if emitNulFieldGuardOpen(-2, -3, pathSi, pathFi, -1) >= 0 {
    if emitStructEqRec(-2, -3, si, pathSi, pathFi, -1) >= 0 {
      emitNulFieldGuardClose()
    }
  }
  eqStashL = savedL
  eqStashR = savedR
  eqChainRecover = savedRec
  fbEnd()
  wTarget(prev)
  return body
}

// `emitStructEqFieldAt`'s `i32[]` field: lengths equal and element-wise equal — `len` from the
// wrapper's field 1 (the backing may be longer), elements off backings stashed in two fresh
// `listBackStashSlot` slots. The i32 counters ride the string-op frame: plain i32 slots
// carrying no rep, safe to share. Returns 0, or -1 on failure.
function emitStructEqI32ListField(
  lRoot: i32,
  rRoot: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
) {
  // lenL != lenR → 0, else the element loop.
  if emitChainRead(lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
  fbStructGet(lTy(), 1) // wrapper field 1: len
  if emitChainRead(rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
  fbStructGet(lTy(), 1)
  fbI32Bin(71)          // 0x47 i32.ne
  fbIf(127)             // 0x04 if, 0x7f i32 blocktype
  fbI32Const(0)         // length mismatch → 0
  fbElse()              // 0x05 else — the element loop, like emitStrEqCore
  // A = backing(L.f); B = backing(R.f); I0 = len; I1 = 0
  const eqBkA = listBackStashSlot("list", 0)
  const eqBkB = listBackStashSlot("list", 0)
  if emitChainRead(lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
  fbStructGet(lTy(), 0) // backing
  fbLocalSet(eqBkA)
  if emitChainRead(rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
  fbStructGet(lTy(), 0)
  fbLocalSet(eqBkB)
  if emitChainRead(lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
  fbStructGet(lTy(), 1) // len
  setStrScrI(0)
  fbBlock(127)          // 0x02 block, 0x7f i32 — yields the 0/1 result
  fbI32Const(0)
  setStrScrI(1)         // I1 = 0
  fbLoop(64)            // 0x03 loop, void
  pushStrScrI(1)
  pushStrScrI(0)
  fbI32Bin(78)          // 0x4e i32.ge_s — done?
  fbIf(64)              // then: fall through (all matched)
  fbElse()
  fbLocalGet(eqBkA)
  pushStrScrI(1)
  fbArrayGet(aTy())
  fbLocalGet(eqBkB)
  pushStrScrI(1)
  fbArrayGet(aTy())
  fbI32Bin(71)          // 0x47 i32.ne
  fbIf(64)              // mismatch → 0, exit the result block
  fbI32Const(0)
  fbBr(3)               // depths: if(0)·else(1)·loop(2)·block(3)
  fbEnd()
  pushStrScrI(1)
  fbI32Const(1)
  fbI32Bin(106)         // i32.add
  setStrScrI(1)
  fbBr(1)               // continue the loop
  fbEnd()               // end (else's if)
  fbEnd()               // end (loop)
  fbI32Const(1)         // every element matched
  fbEnd()               // end (result block)
  fbEnd()               // end (length if/else)
  return 0
}

// Emit `clamp(idx, len)` where `idx` is in i32 temp `idxSlot` and `len` in temp
// `lenSlot`, leaving the clamped value on the stack — JS slice semantics: a negative
// index counts from the end (`len + idx`, floored at 0), a non-negative index is capped
// at `len` (`idx < 0 ? max(len+idx, 0) : min(idx, len)`), built from `select`.
function emitClampIdx(idxSlot: i32, lenSlot: i32) {
  // negCase = max(len+idx, 0) = select( len+idx, 0, (len+idx) > 0 )
  pushStrScrI(lenSlot)
  pushStrScrI(idxSlot)
  fbI32Bin(106) // i32.add → (len+idx)  [the `a` value]
  fbI32Const(0) // i32.const 0          [the `b` value]
  pushStrScrI(lenSlot)
  pushStrScrI(idxSlot)
  fbI32Bin(106) // i32.add → (len+idx)
  fbI32Const(0) // i32.const 0
  fbI32Bin(74)  // 0x4a i32.gt_s → (len+idx) > 0   [cond]
  fbSelect()    // → negCase on stack
  // nonNegCase = min(idx, len) = select( idx, len, idx < len )
  pushStrScrI(idxSlot) // a = idx
  pushStrScrI(lenSlot) // b = len
  pushStrScrI(idxSlot)
  pushStrScrI(lenSlot)
  fbI32Bin(72)         // 0x48 i32.lt_s → idx < len   [cond]
  fbSelect()           // → nonNegCase on stack
  // result = select( negCase, nonNegCase, idx < 0 )
  // Stack currently: [negCase, nonNegCase]; push cond then select.
  pushStrScrI(idxSlot)
  fbI32Const(0) // i32.const 0
  fbI32Bin(72)  // 0x48 i32.lt_s → idx < 0
  fbSelect()    // → clamped value
  return 0
}

// Lower a string `s.slice(start, end)`, leaving the new string ref: a header only, sharing
// the receiver's backing (`struct.new $str (s.backing, s.start + start, len)`), O(1) with
// zero element copies. Safe by construction — no string element store and no `ref.eq` on a
// string exist anywhere in the emitter, so a view and a copy are indistinguishable — but a view keeps its whole backing alive; `compact()` is the documented escape (§Header).
function emitStrSlice(callIx: i32, fnIx: i32) {
  if callIx < 0 { return -1 }
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length != 2 {
      return emitFail(
        "emitProgram: internal: string .slice reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      // Eval receiver + both args onto the stack first (nested string ops complete),
      // then stash: end on top → I1, then start → I0, then receiver → strScrA.
      if emitExpr(callee.memObj, fnIx) < 0 { return -1 }
      if emitExpr(c.callArgs[0], fnIx) < 0 { return -1 }
      if emitExpr(c.callArgs[1], fnIx) < 0 { return -1 }
      return strSliceTail()
    }
    return emitFail(
      "emitProgram: string .slice receiver is not a member access",
    )
  }
  return emitFail("emitProgram: expected a string slice call")
}

// `s.slice(start, end)` over its receiver, start and end on the stack: a view of the receiver's
// backing over the clamped range, with no copy.
export function strSliceTail() {
  setStrScrI(1)                  // raw end → I1
  setStrScrI(0)                  // raw start → I0
  fbLocalSet(strScratchBase + 0) // local.set strScrA (receiver)
  // I2 = len(s) — the HEADER's `len` (field 2). `array.len` here would be the BACKING's
  // physical length, so a slice of a slice would clamp against its parent's extent.
  pushStrScrRef(0)
  fbStrLen()
  setStrScrI(2)
  // I0 = clamp(rawStart, len)
  if emitClampIdx(0, 2) < 0 { return -1 }
  setStrScrI(0)
  // I1 = clamp(rawEnd, len)
  if emitClampIdx(1, 2) < 0 { return -1 }
  setStrScrI(1)
  // I3 = out length = max(end - start, 0) = select( end-start, 0, end > start )
  pushStrScrI(1)
  pushStrScrI(0)
  fbI32Bin(107) // 0x6b i32.sub → end - start   [a]
  fbI32Const(0) // i32.const 0                  [b]
  pushStrScrI(1)
  pushStrScrI(0)
  fbI32Bin(74)  // 0x4a i32.gt_s → end > start  [cond]
  fbSelect()
  setStrScrI(3)
  // The VIEW: same backing, start biased by the receiver's own start, len = I3. This is
  // the whole lowering now — no allocation of elements, no copy.
  pushStrScrRef(0)
  fbStrBack()    // field 0: the SHARED backing
  pushStrScrRef(0)
  fbStrStart()   // field 1: the receiver's own start …
  pushStrScrI(0)
  fbI32Bin(106)  // 0x6a i32.add — … plus the clamped slice start
  pushStrScrI(3) // field 2: len = max(end - start, 0)
  fbStrNew()     // 0xfb 0x00 <string header>
  return 0
}

// Lower `s.indexOf(sub)` (or `s.includes(sub)`): its two operands, then `strIndexOfTail`.
function emitStrIndexOf(callIx: i32, fnIx: i32) {
  if callIx < 0 { return -1 }
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length != 1 {
      return emitFail(
        "emitProgram: internal: string .indexOf reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      // Eval receiver + needle onto the stack first (nested string ops complete).
      if emitExpr(callee.memObj, fnIx) < 0 { return -1 }
      if emitExpr(c.callArgs[0], fnIx) < 0 { return -1 }
      return strIndexOfTail(callee.memProp == "includes")
    }
    return emitFail(
      "emitProgram: string .indexOf receiver is not a member access",
    )
  }
  return emitFail("emitProgram: expected a string indexOf call")
}

// `s.indexOf(sub)` over the receiver and needle on the stack, leaving an i32: the first index of
// `sub` in `s`, or -1 (empty `sub` yields 0); `includes` is `indexOf != -1`.
// An outer loop per verify attempt wraps a skip loop that hoists `B[0]` to advance to the
// next matching-first-character start in one load, then a verify loop over the rest — both the empty-needle short-circuit and the too-long-needle guard are load-bearing for that hoist.
export function strIndexOfTail(isIncludes: boolean): i32 {
  // Stash: needle on top → B, then receiver → A.
  fbLocalSet(strScratchBase + 1) // local.set strScrB (sub)
  fbLocalSet(strScratchBase + 0) // local.set strScrA (s)
  // Hoist both headers' backing + start before the search — every one of the three
  // loops below reads one or both operands per trip (§Header: hoist in codegen).
  hoistStrScr(0)
  hoistStrScr(1)
  // I3 = len(sub); I2 = len(s) - len(sub), the last start the needle fits at. Both are
  // the HEADER's `len` (field 2): `array.len` would be the shared backing's extent, so a
  // needle that is a VIEW would report its parent's length and the scan would run off it.
  pushStrScrRef(1)
  fbStrLen()
  setStrScrI(3)
  pushStrScrRef(0)
  fbStrLen()
  pushStrScrI(3)
  fbI32Bin(107) // 0x6b i32.sub
  setStrScrI(2)
  fbBlock(127)  // 0x02 block, 0x7f i32 blocktype — yields index / -1
  // Empty needle → 0. This is also what makes the hoisted B[0] below safe.
  pushStrScrI(3)
  fbI32Const(0)
  fbI32Bin(70) // 0x46 i32.eq
  fbIf(64)     // 0x04 if, 0x40 void blocktype
  fbI32Const(0)
  fbBr(1)      // → out of the i32 block
  fbEnd()
  // Needle longer than haystack → -1 (no start exists).
  pushStrScrI(2)
  fbI32Const(0)
  fbI32Bin(72)  // 0x48 i32.lt_s
  fbIf(64)
  fbI32Const(-1)
  fbBr(1)       // → out of the i32 block
  fbEnd()
  fbI32Const(0)
  setStrScrI(0) // I0 = 0
  fbLoop(64)    // 0x03 loop (outer) — one trip per verify attempt
  // I1 = B[0]: the character every candidate start has to carry.
  pushStrScrBase(1)     // needle backing + its start …
  fbArrayGet(sBackTy()) // … which IS the offset of B[0]
  setStrScrI(1)
  fbLoop(64)            // 0x03 loop (skip) — advance to the next candidate
  // Past the last possible start → no match.
  pushStrScrI(0)
  pushStrScrI(2)
  fbI32Bin(74) // 0x4a i32.gt_s
  fbIf(64)
  fbI32Const(-1)
  fbBr(3)      // depths: if(0)·skip(1)·outer(2)·block(3)
  fbEnd()
  // A[I0] != B[0] → not a candidate: advance and keep skipping. ONE load.
  pushStrScrElem(0, 0)
  pushStrScrI(1)
  fbI32Bin(71)  // 0x47 i32.ne
  fbIf(64)
  pushStrScrI(0)
  fbI32Const(1)
  fbI32Bin(106) // 0x6a i32.add
  setStrScrI(0)
  fbBr(1)       // → skip loop header
  fbEnd()
  fbEnd()       // 0x0b end (skip loop) — falls through with A[I0]==B[0]
  // I1 = 1: B[0] already matched, so verification starts at index 1.
  fbI32Const(1)
  setStrScrI(1)
  fbLoop(64) // 0x03 loop (verify)
  // I1 >= len(sub) → full match at I0: yield I0 out of the i32 block.
  pushStrScrI(1)
  pushStrScrI(3)
  fbI32Bin(78) // 0x4e i32.ge_s
  fbIf(64)
  pushStrScrI(0)
  fbBr(3)      // depths: if(0)·verify(1)·outer(2)·block(3)
  fbEnd()
  // A[I0+I1] != B[I1] → mismatch: advance I0 and re-enter the skip loop.
  pushStrScrBase(0)
  pushStrScrI(0)
  fbI32Bin(106)         // 0x6a i32.add — startA + I0
  pushStrScrI(1)
  fbI32Bin(106)         // 0x6a i32.add — … + I1
  fbArrayGet(sBackTy()) // 0xfb 0x0b array.get
  pushStrScrElem(1, 1)  // B[I1]
  fbI32Bin(71)          // 0x47 i32.ne
  fbIf(64)
  pushStrScrI(0)
  fbI32Const(1)
  fbI32Bin(106)         // i32.add
  setStrScrI(0)         // I0 = I0 + 1
  fbBr(2)               // 0x0c br depth 2 → outer loop header
  fbEnd()               // 0x0b end (mismatch if)
  // I1 = I1 + 1; br verify loop
  pushStrScrI(1)
  fbI32Const(1)
  fbI32Bin(106)  // i32.add
  setStrScrI(1)
  fbBr(0)        // 0x0c br depth 0 → verify loop header
  fbEnd()        // 0x0b end (verify loop)
  fbEnd()        // 0x0b end (outer loop)
  fbI32Const(-1) // block result; the skip loop owns the real exhaustion exit
  fbEnd()        // 0x0b end (block) — leaves the i32 result
  if isIncludes {
    fbI32Const(-1)
    fbI32Bin(71) // 0x47 i32.ne — `includes` ≡ `indexOf(sub) != -1`
  }
  return 0
}

// Lower `s.charCodeAt(i)` onto `body`, leaving the char code i32: a guarded
// `backing[start + i]` over the code-point backing, so an out-of-range index traps —
// matching the host's `s[i]` semantics (no JS NaN). The guard is what keeps the trap: the
// backing outlives the view, so `array.get`'s own bounds check is not the view's bound.
function emitStrCharCode(callIx: i32, fnIx: i32) {
  if callIx < 0 { return -1 }
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length != 1 {
      return emitFail(
        "emitProgram: internal: string .charCodeAt reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      // The SAME guarded `backing[start + i]` shape `s[i]` gets, INCLUDING the loop-hoist
      // arm — the two are one operation spelled twice (`emitIndex`'s string arm is the
      // sibling ladder), and Stage 2b keeps them reading through ONE pair of helpers so they
      // cannot drift into different bounds rules or different hoisting.
      const ccHz = rawStrHoistOf(callee.memObj)
      if ccHz < 0 {
        if emitExpr(callee.memObj, fnIx) < 0 { return -1 }
      }
      if emitExpr(c.callArgs[0], fnIx) < 0 { return -1 }
      return rawStrGetTail(ccHz)
    }
    return emitFail(
      "emitProgram: string .charCodeAt receiver is not a member access",
    )
  }
  return emitFail("emitProgram: expected a string charCodeAt call")
}

// ── the code-point trio: `cpAt` / `cpLen` / `isCharBoundary` ──────────────────
// All three read the UTF-8 storage directly, which is why they are core intrinsics rather
// than `std:str` functions — nothing writable in VL can see a byte as anything but a byte.
// They ride the same lazy stash `s[i]` uses, so they need no `exprHasStrOp` reservation arm.

// Stash [receiver, index] off the wasm stack into the shared header/index slots. On entry
// BOTH are fully evaluated (a nested string index inside either has already come and gone
// through these slots — the nested-op discipline `strHdrSlot`'s header states). Returns the
// header slot; the index is at `listIdxScratchBase`.
function stashStrRecvIdx() {
  const hs = strHdrSlot()
  fbLocalSet(listIdxScratchBase) // the index
  fbLocalSet(hs)                 // the header
  return hs
}

// Push the header's one-past-the-end BACKING offset, `start + len` — `__utf8_dec__`'s bound,
// and the reason a sequence that runs off the end of a VIEW decodes to U+FFFD instead of
// reading its sibling view's bytes.
function pushStrHdrEnd(hs: i32) {
  fbLocalGet(hs)
  fbStrStart()
  fbLocalGet(hs)
  fbStrLen()
  fbI32Bin(106) // 0x6a i32.add
  return 0
}

// Push the guarded BACKING offset of byte `i`: `start + i` when `i u< len`, else `-1`. The
// SAME select `emitStrIdxGuard` builds, so an out-of-range `cpAt` traps exactly where an
// out-of-range `s[i]` does rather than decoding a neighbour's bytes.
function pushStrGuardedOff(hs: i32) {
  fbLocalGet(hs)
  fbStrStart()
  fbLocalGet(listIdxScratchBase)
  fbI32Bin(106)  // i32.add → start + i
  fbI32Const(-1) // the out-of-range replacement offset
  fbLocalGet(listIdxScratchBase)
  fbLocalGet(hs)
  fbStrLen()
  fbI32Bin(73)   // 0x49 i32.lt_u — covers negative and past-len in one compare
  fbSelect()
  return 0
}

// Lower `s.cpAt(i)` — the code point whose UTF-8 sequence BEGINS at byte offset `i`, O(1).
// `__utf8_dec__` returns `(width << 24) | cp`; only the code point is wanted here, so the
// width is masked off. Offset `i` landing mid-sequence is not an error (§Validity): the byte
// there is a continuation byte, which begins nothing, so the answer is U+FFFD.
function emitStrCpAt(callIx: i32, fnIx: i32) {
  if callIx < 0 { return -1 }
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length != 1 {
      return emitFail(
        "emitProgram: internal: string .cpAt reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      if emitExpr(callee.memObj, fnIx) < 0 { return -1 }
      if emitExpr(c.callArgs[0], fnIx) < 0 { return -1 }
      const hs = stashStrRecvIdx()
      fbLocalGet(hs)
      fbStrBack()
      pushStrGuardedOff(hs)
      pushStrHdrEnd(hs)
      fbCall(helpUtf8DecFn())
      fbI32Const(16777215) // 0x00ffffff — drop the width, keep the code point
      fbI32Bin(113)        // 0x71 i32.and
      return 0
    }
    return emitFail("emitProgram: string .cpAt receiver is not a member access")
  }
  return emitFail("emitProgram: expected a string cpAt call")
}

// Lower `s.cpLen()` — the code-point count, one call into `__utf8_cplen__`. O(n), and the
// call site says so.
function emitStrCpLen(callIx: i32, fnIx: i32) {
  if callIx < 0 { return -1 }
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length != 0 {
      return emitFail(
        "emitProgram: internal: string .cpLen reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      if emitExpr(callee.memObj, fnIx) < 0 { return -1 }
      return strCpLenTail()
    }
    return emitFail(
      "emitProgram: string .cpLen receiver is not a member access",
    )
  }
  return emitFail("emitProgram: expected a string cpLen call")
}

// `s.cpLen()` over its receiver on the stack: the shared UTF-8 code point count helper.
export function strCpLenTail() {
  fbCall(helpUtf8CpLenFn())
  return 0
}

// Lower `s.isCharBoundary(i)` (Rust's primitive, O(1)): does byte `i` begin a UTF-8
// sequence? True at `len`, false past `len` or below 0, else the lead/continuation bit
// test. Deliberately does not special-case index 0 the way Rust does — a VL string is not
// guaranteed valid (§Validity), so a view like `"é→".slice(1, 4)` can start on a continuation byte, and answering `true` at 0 unconditionally would report a boundary that is not one.
function emitStrIsCharBoundary(callIx: i32, fnIx: i32) {
  if callIx < 0 { return -1 }
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length != 1 {
      return emitFail(
        "emitProgram: internal: string .isCharBoundary reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      if emitExpr(callee.memObj, fnIx) < 0 { return -1 }
      if emitExpr(c.callArgs[0], fnIx) < 0 { return -1 }
      const hs = stashStrRecvIdx()
      // i == len — the end of the VIEW, never of the backing.
      fbLocalGet(listIdxScratchBase)
      fbLocalGet(hs)
      fbStrLen()
      fbI32Bin(70) // 0x46 i32.eq
      fbIf(127)    // if (result i32)
      fbI32Const(1)
      fbElse()
      // In range? (one unsigned compare covers negative and past-len.)
      fbLocalGet(listIdxScratchBase)
      fbLocalGet(hs)
      fbStrLen()
      fbI32Bin(73)  // 0x49 i32.lt_u
      fbIf(127)
      fbLocalGet(hs)
      fbStrBack()
      fbLocalGet(hs)
      fbStrStart()
      fbLocalGet(listIdxScratchBase)
      fbI32Bin(106) // i32.add
      fbArrayGet(sBackTy())
      fbI32Const(192)
      fbI32Bin(113) // i32.and
      fbI32Const(128)
      fbI32Bin(71)  // 0x47 i32.ne
      fbElse()
      fbI32Const(0)
      fbEnd()
      fbEnd()
      return 0
    }
    return emitFail(
      "emitProgram: string .isCharBoundary receiver is not a member access",
    )
  }
  return emitFail("emitProgram: expected a string isCharBoundary call")
}

// Lower `s.bytes()` — one call into `__str_bytes__`, which `array.copy`s the view's byte
// range into a fresh `u8[]`. The helper's functype mints the packed pair.
function emitStrBytes(callIx: i32, fnIx: i32) {
  if callIx < 0 { return -1 }
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length != 0 {
      return emitFail(
        "emitProgram: internal: string .bytes reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      if emitExpr(callee.memObj, fnIx) < 0 { return -1 }
      fbCall(helpStrBytesFn())
      return 0
    }
    return emitFail(
      "emitProgram: string .bytes receiver is not a member access",
    )
  }
  return emitFail("emitProgram: expected a string bytes call")
}

// A union of maps `exprIx`, its box just emitted, delivered as the one map `dstTy` whose storage
// every member shares (D2692): the payload cast to that map's struct. A member of another struct
// is refused.
function emitMapUnionPayloadTail(exprIx: i32, dstTy: i32) {
  const sh = mapShapeFoldSet(mapArmShapeOfTy(dstTy))
  const mems: i32[] = []
  flattenVariantsInto(nodeTyIxOf(exprIx), mems)
  let i = 0
  while i < mems.length {
    const msh = mapShapeFoldSet(mapArmShapeOfTy(mems[i]))
    if !mapTwinOneStruct(msh, sh) {
      return emitFailAt(
        "emitProgram: a union of maps cannot be delivered as "
          + tyToEmitName(dstTy)
          + ": a member is stored differently",
        exprIx,
      )
    }
    i = i + 1
  }
  fbStructGet(uBoxIdx, 1)
  fbRefCast(mapTypeIdxOf(sh))
  return 0
}

// A union box `exprIx`, just emitted, delivered into a union lacking one of its map members
// (D2690): a box tagged with such a member takes the tag of the destination member it is
// assignable to, so `is`, `match` and `as` read the member it holds there. A scalar member the
// destination holds only widened is rebuilt with the widened payload.
function emitMapRetagTail(exprIx: i32) {
  const from: i32[] = []
  const to: i32[] = []
  mapRetagRowsOf(exprIx, from, to)
  const wFrom: i32[] = []
  const wTo: i32[] = []
  widenRetagRowsOf(exprIx, wFrom, wTo)
  const fromTags: i32[] = []
  const toTags: i32[] = []
  mapRetagTagPairs(from, to, fromTags, toTags)
  const arms = fromTags.length + wFrom.length
  if arms == 0 { return 0 }
  fbLocalSet(unionAsBoxSlot())
  let w = 0
  while w < wFrom.length {
    if emitWidenRetagArm(wFrom[w], wTo[w]) < 0 { return -1 }
    w = w + 1
  }
  let i = 0
  while i < fromTags.length {
    fbLocalGet(unionAsBoxSlot())
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, fromTags[i])
    fbI32Bin(70) // i32.eq
    fbIfRefNul(uBoxIdx, false)
    fbI32Rel(RS_TAG, toTags[i])
    fbLocalGet(unionAsBoxSlot())
    fbStructGet(uBoxIdx, 1)
    fbStructNew(uBoxIdx)
    fbElse()
    i = i + 1
  }
  fbLocalGet(unionAsBoxSlot())
  let e = 0
  while e < arms {
    fbEnd()
    e = e + 1
  }
  return 0
}

// The convert opcode from value atom `fk` to `tk` for the widenings `recordWidenRetag` records,
// or -1 for any other pair.
function widenConvOpOfKinds(fk: i32, tk: i32): i32 {
  if fk == 0 && tk == 3 { return scalarWidenConvOp("i32", "i64") }
  if fk == 0 && tk == 4 { return scalarWidenConvOp("i32", "f64") }
  if fk == 5 && tk == 4 { return scalarWidenConvOp("f32", "f64") }
  // Recorded only for a box whose `i64` members are literals the float holds (D3530).
  if fk == 3 && tk == 4 {
    return 185 // f64.convert_i64_s
  }
  if fk == 3 && tk == 5 {
    return 180 // f32.convert_i64_s
  }
  return -1
}

// The opcode converting value atom `fk` to `tk` exactly, either way a box retag crosses: a
// widening `widenConvOpOfKinds` names, or the narrowing back from one (`atomNarrowOp`).
function atomConvOp(fk: i32, tk: i32): i32 {
  const w = widenConvOpOfKinds(fk, tk)
  if w >= 0 { return w }
  return atomNarrowOp(fk, tk)
}

// The stored and own atom kinds of a field read whose box `phys` holds one non-null scalar the
// own type, one other scalar, narrows back to; empty for any other pair.
function boxNarrowScalarKinds(phys: i32, own: i32): i32[] {
  const pt: i32[] = []
  const ot: i32[] = []
  if !canonUnionMemberTysOf(phys, pt) || !canonUnionMemberTysOf(own, ot) {
    return []
  }
  const vals: i32[] = []
  for t in pt {
    if t >= 0 { vals.push(t) }
  }
  if vals.length != 1 || ot.length != 1 || tyEq(vals[0], ot[0]) { return [] }
  const fk = boxAtomKindOfMemberTy(vals[0])
  const tk = boxAtomKindOfMemberTy(ot[0])
  if fk < 0 || tk < 0 || atomConvOp(fk, tk) < 0 { return [] }
  return [fk, tk]
}

// The refusal of a field read at `memIx` whose wider record stores two of its own members as one.
function emitBoxAmbiguousFail(memIx: i32) {
  return emitFailAt(
    "emitProgram: this field is stored at a wider record whose member two of its own members "
      + "widen to, so a read at its own type cannot tell which one it held. Annotate the "
      + "binding with the wider record's type, or build a second literal",
    memIx,
  )
}

// One arm of `emitMapRetag`'s chain for a scalar member `fromTy` the destination holds widened
// as `toTy`: under `fromTy`'s tag, the box in `unionAsBoxSlot` is rebuilt under `toTy`'s with its
// payload converted; the arm is left open on its `else`.
function emitWidenRetagArm(fromTy: i32, toTy: i32) {
  const fk = boxTagOfTy(fromTy)
  const tk = boxTagOfTy(toTy)
  const conv = widenConvOpOfKinds(fk, tk)
  const vb = vbHeapIdxOfKind(tk)
  if conv < 0 || vb < 0 {
    return emitFail(
      "emitProgram: a union delivered widened has no box for its widened member",
    )
  }
  fbLocalGet(unionAsBoxSlot())
  fbStructGet(uBoxIdx, 0)
  fbI32Rel(RS_TAG, scalarTagOfKind(fk))
  fbI32Bin(70) // i32.eq
  fbIfRefNul(uBoxIdx, false)
  fbI32Rel(RS_TAG, scalarTagOfKind(tk))
  fbLocalGet(unionAsBoxSlot())
  if emitUnionUnboxTail(fk) < 0 { return -1 }
  wU8(conv)
  fbStructNew(vb)
  fbStructNew(uBoxIdx)
  fbElse()
  return 0
}

// `emitBoxAtomRetagMembers` from union type `fromTy` to `toTy`, over their canonical members, for
// a pair `memReadBoxPlan` accepted (so both have them).
function emitBoxAtomRetagTys(fromTy: i32, toTy: i32, at: i32) {
  const ft: i32[] = []
  canonUnionMemberTysOf(fromTy, ft)
  const tt: i32[] = []
  canonUnionMemberTysOf(toTy, tt)
  return emitBoxAtomRetagMembers(ft, tt, at)
}

// The union box on the stack, held at member types `ft`, rebuilt at `tt`: each scalar member `tt`
// lacks is re-boxed as the member it converts to exactly (`boxAtomRetagKind`). A field read narrows
// a wider record's box back (D3006).
function emitBoxAtomRetagMembers(ft: i32[], tt: i32[], at: i32) {
  const slot = sharedFieldRecvSlot()
  fbLocalSet(slot)
  let arms = 0
  let i = 0
  while i < ft.length {
    const pt = ft[i]
    const k = boxAtomRetagKind(pt, tt, ft)
    if k >= 0 {
      const fk = boxAtomKindOfMemberTy(pt)
      const vb = vbHeapIdxOfKind(k)
      if vb < 0 {
        return emitFailAt(
          "emitProgram: a union stored at a wider record's field has no box for its member",
          at,
        )
      }
      fbLocalGet(slot)
      fbStructGet(uBoxIdx, 0)
      fbI32Rel(RS_TAG, scalarTagOfKind(fk))
      fbI32Bin(70) // i32.eq
      fbIfRefNul(uBoxIdx, false)
      fbI32Rel(RS_TAG, scalarTagOfKind(k))
      fbLocalGet(slot)
      if emitUnionUnboxTail(fk) < 0 { return -1 }
      wU8(atomConvOp(fk, k))
      fbStructNew(vb)
      fbStructNew(uBoxIdx)
      fbElse()
      arms = arms + 1
    }
    i = i + 1
  }
  fbLocalGet(slot)
  fbRefAsNonNull()
  while arms > 0 {
    fbEnd()
    arms = arms - 1
  }
  return 0
}

// A read leaves its recorded rep on the stack: a nullable cell the checker narrowed to its
// non-null twin recovers here, once, rather than at each consumer.
export function emitReadRecover(exprIx: i32, fnIx: i32) {
  if readOwesNonNullRecover(exprIx, fnIx) { fbRefAsNonNull() }
  return 0
}

// Emits node `ix` as the value it produces, not converted for its destination: a literal-union
// place or literal read as the string it is stored as, as a compare against its members needs.
function emitExprRaw(ix: i32, fnIx: i32): i32 {
  const savedRaw = rawReadNode
  rawReadNode = unwrapParen(ix)
  const r = emitExpr(ix, fnIx)
  rawReadNode = savedRaw
  return r
}

// The node an `emitExprRaw` in progress reads as the string it is stored as, or -1: the
// string-to-atom conversion never re-enters it.
let rawReadNode = -1

// The arms `emitExpr`'s string-to-atom hook writes a node by: a `const` read bound to a literal
// (`wideLit`), a string-repped literal union narrowed (`strToAtom`) or a join whose arms disagree
// about their rep taking the destination per arm (`perArmJoin`), a join of member literals (`litJoin`).
export type AtomHookArm = "wideLit" | "strToAtom" | "perArmJoin" | "litJoin"

// The arm the hook takes node `ix` by, or null where it declines; `live` also asks whether a raw
// read of it is in progress (`rawReadNode`), emit state a build-time ask leaves out.
export function atomHookArmOf(
  ix: i32,
  fnIx: i32,
  live: boolean,
): AtomHookArm | null {
  const w = unwrapParen(ix)
  if w < 0 || w >= P.nodes.length { return null }
  if live && w == rawReadNode { return null }
  if !hookTakesAtomPure(ix, fnIx) { return null }
  if nodeHasWideStrLit(w) { return "wideLit" }
  if strReppedLitUnionAt(ix, fnIx) {
    return if ifJoinNarrowsPerArm(w) { "perArmJoin" } else { "strToAtom" }
  }
  if ifJoinArmsAllStrLit(w) { return "litJoin" }
  return null
}

// Whether `emitExpr`'s string-to-atom hook may take node `ix`, less the emit state it reads: its
// closed contextual type reps as the atom (`strLitTakesAtom`), and the hook converts such a node.
export function hookTakesAtomPure(ix: i32, fnIx: i32): boolean {
  if !hookMayConvert(unwrapParen(ix)) { return false }
  return strLitTakesAtom(ix, fnIx)
}

// Whether the hook has a conversion for node `u`: a read of a `const` bound to a literal, a
// node typed by a literal set before widening, or a join; no other node is a string to narrow.
function hookMayConvert(u: i32): boolean {
  if u < 0 { return false }
  if nodeHasWideStrLit(u) || tyIsLitUnionOrLit(nodeUnwidenedTyOf(u)) {
    return true
  }
  return nodeAt(u) is IfStmt
}

// Whether expression `ix` computes no value because a dead arm's `never` operand feeds it: a name
// read checked `never`, or an expression one feeds. A call that is itself `never` (a function that
// does not return) feeds nothing here, so its own effect is still emitted.
function exprReadsDeadNever(ix: i32, fnIx: i32): boolean {
  return deadNeverAt(ix, fnIx, 0)
}

function deadNeverAt(ix: i32, fnIx: i32, depth: i32): boolean {
  if depth > 16 { return false }
  const u = unwrapParen(ix)
  if u < 0 || u >= P.nodes.length { return false }
  const n = nodeAt(u)
  if n is Ident { return nodeTyAt(u, fnIx) == TY_NEVER }
  // A call checked `never` on its own is a function that does not return; one handed a dead
  // operand computes nothing. Every other kind is its operands' (`deadNeverKids`).
  if n is Call {
    for a in n.callArgs {
      if deadNeverAt(a, fnIx, depth + 1) { return true }
    }
    const f = nodeAt(unwrapParen(n.callFn))
    return f is Member && deadNeverAt(f.memObj, fnIx, depth + 1)
  }
  return deadNeverKids(u, fnIx, depth)
}

// Whether expression `u`, of any kind but a name or a call, is `never` and has an operand a dead
// read feeds.
function deadNeverKids(u: i32, fnIx: i32, depth: i32): boolean {
  if nodeTyAt(u, fnIx) != TY_NEVER { return false }
  for k in nodeSpineChildren(u) {
    if deadNeverAt(k, fnIx, depth + 1) { return true }
  }
  return false
}

// The generic path `emitExpr` takes for node `ix` before its kind arm, or "": the same predicates
// in the same order, less the ones keyed on emit state the IR never holds. The builder misses by
// this name, so a pre-path never runs under a covered node.
export function exprPrePathWhy(ix: i32, fnIx: i32): string {
  const w = unwrapParen(ix)
  if w < 0 || w >= P.nodes.length { return "pre-path no node" }
  if exprReadsDeadNever(ix, fnIx) { return "pre-path dead never" }
  if nodeAt(w) is Call && fnTagArmsAt(ix, emitTagSetAt(ix, fnIx)).length > 0 {
    return "pre-path tag dispatch"
  }
  // The table's coercions, a function tag and the atom hooks convert lists, functions, maps,
  // records, strings and literal unions, never a node the checker typed a numeric or boolean
  // primitive. The table's box seats are emit state, unset while the builder asks.
  const prim = nodeTyPrimName(w)
  if prim != "" && prim != "string" { return placePrePathWhy(w, fnIx) }
  const ck = coerceKindAt(ix, fnIx)
  // A list copy that owes nothing past the value is the value as built.
  if ck != "none" && !(ck == "listCopy" && listCopyOwesNothing(ix, fnIx)) {
    return "pre-path coercion"
  }
  return exprPrePathPastCoerce(ix, fnIx)
}

// `exprPrePathWhy` past its coercion, as `emitExpr` asks it of the node `coerceHeld` names: the
// value a coercion converts.
export function exprPrePathPastCoerce(ix: i32, fnIx: i32): string {
  const w = unwrapParen(ix)
  if w < 0 || w >= P.nodes.length { return "pre-path no node" }
  if fnTagLeafEmitted(ix, fnIx) >= 0 { return "pre-path tag leaf" }
  // The atom hook diverts only through one of its three arms; a string literal's own delivery is
  // the builder's `strLit`, over `strLitTakesAtom`.
  if !(nodeAt(w) is StrLit) && atomHookArmOf(ix, fnIx, false) != null {
    return "pre-path atom hook"
  }
  if deliveredAsNulAtom(ix, fnIx) && nulStrReppedNulLitPlace(ix, fnIx) {
    return "pre-path nul atom place"
  }
  const e = nodeAt(w)
  if (e is Ident || e is Member || e is Index) && ctxIsNulAtom(ix, fnIx) {
    if narrowedNulLitPinBoxKey(ix, fnIx) != "" {
      return "pre-path nul atom niche"
    }
  }
  return placePrePathWhy(ix, fnIx)
}

// The member id node `ix` is written as, a tagged function set's value, or -1. A maker twin's
// returned member is the closure its token names, not the id (D14825). Legacy and the IR share it.
export function fnTagLeafEmitted(ix: i32, fnIx: i32): i32 {
  const id = fnTagLeafId(ix)
  if id < 0 || monoTokenReturnedFe(ix, fnIx) >= 0 { return -1 }
  return id
}

// `emitExpr`'s null-unit and niche reads of a place or method call `ix`, or "".
function placePrePathWhy(ix: i32, fnIx: i32): string {
  const e = nodeAt(ix)
  const place = e is Member || e is Index
  if (
    (place || callIsMethodAt(ix))
    && readMayBeNulUnit(ix)
    && exprIsNulNone(ix, fnIx)
  ) {
    return "pre-path null unit read"
  }
  if place && placeNicheAtomKind(ix, fnIx) >= 0 { return "pre-path niche read" }
  return ""
}

export function emitExpr(exprIx: i32, fnIx: i32) {
  // Stop after a recorded failure: `emitFail` banks the first message and returns -1 but
  // does not halt the pass, so a caller that drops the -1 keeps emitting over invalidated
  // state until an unguarded parallel-table read traps and kills the compiler before the
  // diagnostic prints. Checking the flag at the two recursion roots makes a failure terminal wherever it happened, instead of relying on every caller in between to thread -1 outward.
  if emitFailed { return -1 }
  if exprIx < 0 { return emitFail("emitProgram: missing expression") }
  // A dead arm's operand reads as `never`, and so does what it feeds: no value reaches here (D16006).
  if exprReadsDeadNever(exprIx, fnIx) {
    fbUnreachable()
    return 0
  }
  if exprIx != coerceHeld {
    const ck = coerceKindAt(exprIx, fnIx)
    if ck != "none" { return emitCoerced(exprIx, fnIx, ck) }
  }
  if exprIx == isRecvStagedIx {
    fbLocalGet(isRecvStagedSlot)
    if isRecvStagedNonNull { fbRefAsNonNull() }
    return 0
  }
  // A tagged function set's value is its member's id, and a call through one dispatches on it.
  const tagLeaf = fnTagLeafEmitted(exprIx, fnIx)
  if tagLeaf >= 0 {
    fbI32Const(tagLeaf)
    return 0
  }
  const tagSet = emitTagSetAt(exprIx, fnIx)
  const tagArms = fnTagArmsAt(exprIx, tagSet)
  if tagArms.length > 0 {
    if emitFnTagDispatch(exprIx, tagSet, tagArms, fnIx) < 0 { return -1 }
    return 0
  }
  if exprIx == lmaValNode {
    const lmaArg = lmaValArg
    lmaValNode = -1
    return emitWidened(lmaArg, 3, lmaCallerFn)
  }
  // A string-repped literal union reaching an atom-typed destination narrows to its interned
  // id here, one hook rather than one per destination. Without it the store is a `local.set`
  // of a `(ref $array)` into an `i32` slot: invalid wasm at every such destination.
  const hookArm = atomHookArmOf(exprIx, fnIx, true)
  if hookArm != null {
    const wideIx = unwrapParen(exprIx)
    return match hookArm {
      // A read of a `const` bound to a literal is that literal, whose id needs no conversion.
      "wideLit" => emitStaticLitAtom(exprIx, quoteLex(nodeWideStrLitText(wideIx)), fnIx)
      // A join whose arms disagree about their rep takes the destination into each arm, under
      // the same context, rather than joining as a string to narrow back (D2199); so does a join
      // of member literals the checker typed `string`, as a generic body types it (D3423).
      "perArmJoin" | "litJoin" => emitIfExprAs(wideIx, fnIx, 127)
      "strToAtom" => emitStrToAtom(wideIx, fnIx)
    }
  }
  // …and its nullable twin: a `K | null` place held as a nullable string reaches the niche as
  // `-1` or the present string's id (D5431).
  if deliveredAsNulAtom(exprIx, fnIx) && nulStrReppedNulLitPlace(exprIx, fnIx) {
    return emitNulStrToNulAtom(unwrapParen(exprIx), fnIx)
  }
  // …and a `K | null` read out of a wider box, reaching the atom niche (D3118), a hole's or an
  // instance's read at the type its calls pin.
  if ctxIsNulAtom(exprIx, fnIx) && narrowedNulLitPinBoxKey(exprIx, fnIx) != "" {
    return emitNarrowedNicheRead(exprIx, NICHE_NUL_LIT, fnIx)
  }
  const e = nodeAt(exprIx)
  if e is Index && exprIx != idxSpanNode && idxRowsOn() {
    return emitIndexBanked(exprIx, fnIx)
  }
  if e is NumLit { return emitNumLitNode(e, exprIx, fnIx) }
  if e is BoolLit {
    // `boolean` rides in an i32: true=1, false=0 (already decoded into `boolVal`).
    fbI32Const(e.boolVal)
    return 0
  }
  if e is CharLit { return emitCharLitNode(e, exprIx, fnIx) }
  if e is Ident {
    if emitIdentNode(e, exprIx, fnIx) < 0 { return -1 }
    return emitReadRecover(exprIx, fnIx)
  }
  if e is Paren { return emitExpr(e.parInner, fnIx) }
  if (
    (e is Member || e is Index || callIsMethodAt(exprIx))
    && readMayBeNulUnit(exprIx)
    && exprIsNulNone(exprIx, fnIx)
  ) {
    return emitNulNoneRead(exprIx, fnIx)
  }
  if e is Member || e is Index {
    const pnk = placeNicheAtomKind(exprIx, fnIx)
    if pnk >= 0 { return emitNarrowedNicheRead(exprIx, pnk, fnIx) }
  }
  if e is Unary { return emitUnaryNode(e, exprIx, fnIx) }
  if e is AsExpr { return emitAsCast(e, exprIx, fnIx) }
  if e is Call { return emitCallNode(e, exprIx, fnIx) }
  if e is IsExpr { return emitIs(exprIx, fnIx) }
  if e is NullLit { return emitNullLitNode(e, exprIx, fnIx) }
  if e is ObjLit { return emitObjLitNode(e, exprIx, fnIx, -1) }
  if e is StrLit { return emitStrLitAt(exprIx, fnIx) }
  if e is ArrayLit { return emitArr(exprIx, fnIx) }
  if e is Index {
    // G8: a map GET `m[k]` (no `??`) — scan, value or 0. A `??` get is fused in the
    // BinExpr branch below (it carries the default).
    if exprMap(e.idxArr, fnIx) {
      // A union-valued map (mv kind 2) reads through the null-tagged box, the same lowering
      // the `const t = m[k]` binding arm takes: a bare `ref.null` miss would leave a
      // consumer's `struct.get $uBox 0` (the tag read) reading a null reference on `m[k] is
      // T`, `!= null`, `== null` and `print(m[k])` alike. The box is the read's own null.
      const rc = match mapGetArmOf(exprIx, fnIx) {
        "unionBox" => emitMapGetUnionBox(e.idxArr, e.idxIndex, fnIx)
        "helper" => emitMapGetCall(e.idxArr, e.idxIndex, fnIx, mapGetMissOf(e.idxArr, fnIx))
        "inline" => if emitMapPrep(e.idxArr, e.idxIndex, fnIx) < 0 { -1 } else { emitMapGetTail(e.idxArr, fnIx) }
      }
      if rc < 0 { return -1 }
      return emitNarrowedMapReadTail(exprIx, fnIx)
    }
    return emitIndex(exprIx, fnIx)
  }
  if e is Member {
    if emitMemberNode(e, exprIx, fnIx) < 0 { return -1 }
    return emitReadRecover(exprIx, fnIx)
  }
  // A STANDALONE `?.` (one no enclosing `?? d` / null-test pattern consumed) yields its
  // own `F | null` value — see `emitOptMemberValue`.
  if e is OptMember { return emitOptMemberValue(exprIx, fnIx) }
  if e is BinExpr {
    if arithRegionSeen && e.binRegion != 0 {
      return emitBinExprInRegion(e, exprIx, fnIx)
    }
    return emitBinExprNode(e, exprIx, fnIx)
  }
  if e is FuncDecl {
    // An anonymous `function(...)` literal in value position, lifted to a top-level
    // function by `collectFns` (keeping its name). Construct its closure value.
    const fe = fnStmtsPosOf(exprIx)
    if fe >= 0 { return emitClosureValue(fe, fnIx) }
    return emitFail("emitProgram: function literal not lifted")
  }
  if e is IfStmt {
    // An IF-EXPRESSION in value position (`if c { 7 } else { 9 }` — the parser wraps
    // each arm as a one-statement Block; an `else if` chain nests an IfStmt in the
    // else slot). Lowered as `if (result i32)` over the arm VALUES.
    return emitIfExpr(exprIx, fnIx)
  }
  // The catch-all must name the expression, not a position: a message written for one
  // caller (the return arm) but reached from anywhere reads as though every unhandled
  // expression happened there. `emitFailAt` puts the caret on the offending node instead,
  // the way every caller that has the node already does.
  return emitFailAt("emitProgram: unsupported expression", exprIx)
}

// A condition or a switch scrutinee: never a destination, so it is lowered outside any atom
// context its `if` value is emitted under, where a string literal in it would become an id.
function emitCondExpr(ix: i32, fnIx: i32) {
  const rc = emitExprRaw(ix, fnIx)
  return rc
}

// The call of an optional call's guard (`drwOptGuard`: `if r != null { call } else { null }`)
// whose receiver `r` this instance closes with no `null`: the guard is then the call,
// and its `null` arm has no rep (D16333). -1 for any other `if`.
function optGuardCallOf(ifIx: i32, fnIx: i32): i32 {
  const n = nodeAt(ifIx)
  if !(n is IfStmt) || n.ifElse < 0 || fnIx < 0 { return -1 }
  const ci = unwrapParen(n.ifCond)
  if ci < 0 || ci >= P.nodes.length { return -1 }
  const c = nodeAt(ci)
  // The guard's test may already be folded to `true` where the receiver's read cannot be null.
  const folded = c is BoolLit && c.boolVal == 1
  if !folded {
    if !(c is BinExpr) || c.binOp != "!=" || !(nodeAt(c.binRight) is NullLit) {
      return -1
    }
    // Only a read the template leaves open, which this instance closes with no `null`.
    if (
      !tyHasTyVar(nodeTyIxOf(c.binLeft))
      || !tyExcludesNull(nodeTyAt(c.binLeft, fnIx))
    ) {
      return -1
    }
  }
  const eb = nodeAt(n.ifElse)
  const tb = nodeAt(n.ifThen)
  if (
    !(eb is Block)
    || eb.blkStmts.length != 1
    || !(nodeAt(eb.blkStmts[0]) is NullLit)
  ) {
    return -1
  }
  if !(tb is Block) || tb.blkStmts.length != 1 { return -1 }
  return tb.blkStmts[0]
}

// Lower an if-expression (`if c then a else b` in value position) onto `body`: cond,
// `if (result <kind>)`, the then-arm value, else the else-arm value (an `else if` chain
// recurses). Both arms are coerced to the branch-join's scalar rep (a mixed `then 1 else
// 2.5` widens to f64); a ref-typed join (string/struct/array) routes to `emitIfExprRef` instead, for the multi-byte `(ref $ht)` blocktype a single numeric byte cannot spell.
function emitIfExpr(ifIx: i32, fnIx: i32) {
  const gv = optGuardCallOf(ifIx, fnIx)
  if gv >= 0 { return emitExpr(gv, fnIx) }
  // The join is classified from its arms' tail values, and a tail naming its own prelude's
  // local reads that local's slot, bound for the classification alone and popped before any
  // arm lowers: in a generic instance the checker's type of such a tail is the type parameter.
  const scoped = armPreludeScopeOpen(ifIx)
  const p = ifJoinPlanOf(ifIx, fnIx)
  if scoped { scopePop() }
  if ifJoinDropsNulAtom(ifIx, fnIx, p.ijArm) { return refuseJoinDropsNul(ifIx) }
  return match p.ijArm {
    "null" => emitAllNullIf(ifIx, fnIx)
    "atom" => emitIfExprAs(ifIx, fnIx, 127)
    "union" => emitUnionIfValue(p.ijUnion, nodeTyInOf(ifIx, fnIx), ifIx, fnIx)
    "ref" => emitIfExprRefJoin(ifIx, fnIx, p.ijRef)
    "scalar" => emitIfExprAs(ifIx, fnIx, p.ijVt)
  }
}

// A value `if` on `ifJoinPlanOf`'s `ref` rung, whose join always names a kind.
function emitIfExprRefJoin(ifIx: i32, fnIx: i32, rj: RefJoin) {
  const rk = rj.rjKind
  if rk == null {
    return emitFailAt(
      "emitProgram: internal: a reference join with no kind",
      ifIx,
    )
  }
  return emitIfExprRef(ifIx, fnIx, rk, rj.rjSlot)
}

// The result blocktype of a ref join's `if`, after its opcode: `(ref null $ht)` when the join
// can yield `null`, else `(ref $ht)`.
export function fbRefIfOpenType(kind: VKind, slot: i32, nul: boolean) {
  if nul { return fbValtypeNullable(kind, slot) }
  return fbValtype(kind, slot)
}

// The block valtype `emitIfExpr` writes the value `if` at `ifIx` at, `ifJoinPlanOf`'s, classified
// with its arms' prelude locals bound as `ifExprPlainWhy` binds them; every link takes it.
export function ifExprJoinVt(ifIx: i32, fnIx: i32): i32 {
  const scoped = armPreludeScopeOpen(ifIx)
  const p = ifJoinPlanOf(ifIx, fnIx)
  if scoped { scopePop() }
  return p.ijVt
}

// Why the value `if` at `ifIx` has no shape `emitIfExprAs` writes with one value per arm, or "": no
// `else`, an arm with no lone value, an unwalked prelude, a guard call, or an integer switch.
export function ifExprShapeWhy(ifIx: i32, fnIx: i32): string {
  if ifIx < 0 || ifIx >= P.nodes.length { return "node" }
  const n = nodeAt(ifIx)
  if !(n is IfStmt) || n.ifElse < 0 || n.ifCond < 0 { return "no else" }
  // An `else if` is the chain's next link, which `emitIfExprAsLink` writes into this one's frame.
  const elseLink = nodeAt(n.ifElse) is IfStmt
  if !ifArmHasValue(n.ifThen) || !elseLink && !ifArmHasValue(n.ifElse) {
    return "arm not lone"
  }
  // A prelude local the collect pass did not allocate is legacy's refusal (`emitIfArmOpen`).
  if (
    armPreludeUnwalkedDecl(n.ifThen) >= 0
    || !elseLink && armPreludeUnwalkedDecl(n.ifElse) >= 0
  ) {
    return "arm prelude unwalked"
  }
  if optGuardCallOf(ifIx, fnIx) >= 0 { return "optional guard" }
  if intMatchHeadAt(ifIx) { return "int match" }
  return ""
}

// Why the if-expression at `ifIx` is off `emitIfExpr`'s plain scalar path, or "": its shape
// (`ifExprShapeWhy`), then its join rung (an atom join is plain), a static `is` or literal-true
// condition, a prelude, or v128.
export function ifExprPlainWhy(ifIx: i32, fnIx: i32): string {
  const sw = ifExprShapeWhy(ifIx, fnIx)
  if sw != "" { return sw }
  // Classified as `emitIfExpr` classifies it, with the arms' prelude locals bound.
  const scoped = armPreludeScopeOpen(ifIx)
  const p = ifJoinPlanOf(ifIx, fnIx)
  if scoped { scopePop() }
  const rung = match p.ijArm {
    "null" => "null join"
    "atom" => ""
    "union" => "union"
    "ref" => ""
    "scalar" => ""
  }
  if rung != "" { return rung }
  // An atom join is `emitIfExprAs` at i32, each arm its value in the atom context.
  if p.ijArm == "atom" {
    return if ifJoinDropsNulAtom(ifIx, fnIx, "atom") { "string drops null atom" } else { "" }
  }
  // A union join with no render name takes a later rung in legacy; the IR lowers no union join.
  if exprUnion(ifIx, fnIx) { return "union" }
  const rk = p.ijRef.rjKind
  if rk != null { return "ref " + rk }
  if ifJoinDropsNulAtom(ifIx, fnIx, "scalar") {
    return "string drops null atom"
  }
  if p.ijVt == 123 { return "valtype" }
  return ""
}

// Whether `blockIx` is a block whose last statement is its value, after any prelude.
function ifArmHasValue(blockIx: i32): boolean {
  if blockIx < 0 || blockIx >= P.nodes.length { return false }
  return nodeAt(blockIx) is Block && ifArmValueExpr(blockIx) >= 0
}

// Whether any arm of the if-expression at `ifIx` binds a local its tail could name; when so,
// a scope frame holding each such local's slot is pushed (else arms first, so the then arm's
// binding of a shared name is the one a read finds). The caller pops it.
function armPreludeScopeOpen(ifIx: i32): boolean {
  const any = chainHasPrelude(ifIx)
  if !any { return false }
  scopePush()
  armPreludeBindChain(ifIx)
  return true
}

// An if-expression whose value is the `null` type, by its arms or by the checker's join: it runs
// for its effects alone, and the value is the one `null` the destination seeded — the same rep a
// bare `null` there takes, so no arm can pick a blocktype for it (D2227).
function emitAllNullIf(ifIx: i32, fnIx: i32) {
  if emitIfForEffect(unwrapParen(ifIx), fnIx) < 0 { return -1 }
  return emitNullAt(ifIx, fnIx)
}

// Whether node `ix` is a method call `recv.m(…)`.
function callIsMethodAt(ix: i32): boolean {
  const c = nodeAt(ix)
  if c is Call { return nodeAt(unwrapParen(c.callFn)) is Member }
  return false
}

// A field, element or map read, or a `null[]`'s `pop`/`get`, whose type is the `null` unit type:
// the read runs in its own stored rep with the destination's null seeds lifted, is dropped, and
// the value is the `null` the destination seeded, as an ident read of a `null` binding is (D4671).
function emitNulNoneRead(exprIx: i32, fnIx: i32) {
  let rc = 0
  const e = nodeAt(exprIx)
  if e is Member {
    rc = emitMemberNode(e, exprIx, fnIx)
  } else if e is Index {
    if exprMap(e.idxArr, fnIx) {
      rc = emitMapGet(e.idxArr, e.idxIndex, fnIx)
    } else {
      rc = emitIndex(exprIx, fnIx)
    }
  } else if e is Call {
    rc = emitCallNode(e, exprIx, fnIx)
  }
  if rc < 0 { return -1 }
  fbDrop()
  return emitNullAt(exprIx, fnIx)
}

// Lower a ref-typed if-expression join (string / struct / array) as a value-typed `if`
// with the multi-byte `(ref $ht)` blocktype (`fbValtype`), each arm emitted in that rep.
// Mirrors `emitIfExprAs` (narrowing save/restore, `else if` recursion), except the arm
// emitter re-seeds the per-arm construction context so an `ObjLit`/list-literal arm builds the right shape.
function emitIfExprRef(ifIx: i32, fnIx: i32, kind: VKind, slot: i32) {
  // An `else if` chain is emitted along its spine, so its depth costs no stack (D1990): each
  // link leaves its frame open for the next, and the frames close innermost-first.
  if kind == "str" && strJoinDropsNulAtom(ifIx, fnIx) {
    return refuseJoinDropsNul(ifIx)
  }
  const split = joinCloSigSplitField(ifIx, fnIx)
  if split >= 0 {
    return emitFailAt(
      "emitProgram: this record `if` stores functions of different signatures in one field, and a call through the joined record is lowered at one of them",
      split,
    )
  }
  const open: i32[] = []
  let cur = ifIx
  let rc = 1
  let nul = false
  while rc == 1 {
    nul = nul || ifLinkYieldsNull(cur, fnIx)
    rc = emitIfExprRefLink(cur, fnIx, kind, slot, open, nul)
    if rc == 1 {
      const link = nodeAt(unwrapParen(cur))
      if link is IfStmt { cur = link.ifElse }
    }
  }
  return closeIfChainFrames(open, rc, false)
}

// The field value at which record join `ifIx`'s arms first store closures of two signatures in
// one field, else -1: the joined record holds an untyped closure, which a call reads at one
// signature; a tagged field holds an id and dispatches by it (D15809).
function joinCloSigSplitField(ifIx: i32, fnIx: i32): i32 {
  const names: string[] = []
  const sigs: i32[] = []
  for l in valueTailLeaves(ifIx) {
    const o = nodeAt(l)
    if !(o is ObjLit) { continue }
    for fx in o.objFields {
      const f = nodeAt(fx)
      if !(f is FieldInit) { continue }
      if fnTagSetIsTagged(fnTagSetOfTy(nodeTyAt(f.fiValue, fnIx))) { continue }
      const fe = fieldValueFeOfIn(f.fiValue, fnIx)
      const sg = if fe >= 0 { fnSigIdxOfFn(fe) } else { -1 }
      if sg < 0 { continue }
      let j = 0
      while j < names.length && names[j] != f.fiName { j = j + 1 }
      if j == names.length {
        names.push(f.fiName)
        sigs.push(sg)
      } else if sigs[j] != sg {
        return f.fiValue
      }
    }
  }
  return -1
}

// Refuses the join at `ifIx` that `strJoinDropsNulAtom` names, anchored at its condition, which
// an instance shares with the source: a rebuilt `if` has no token of its own.
function refuseJoinDropsNul(ifIx: i32): i32 {
  let at = ifIx
  const sj = nodeAt(unwrapParen(ifIx))
  if sj is IfStmt { at = sj.ifCond }
  return emitFailAt(
    "emitProgram: a string join whose arm is a nullable literal union was typed non-null here",
    at,
  )
}

// One link of `emitIfExprRef`: 0 or -1 as that function returns, or 1 when the else is another `if`
// and this link's frame is left open (its else restore target pushed onto `open`).
function emitIfExprRefLink(
  ifIx: i32,
  fnIx: i32,
  kind: VKind,
  slot: i32,
  open: i32[],
  chainNul: boolean,
) {
  if ifIx < 0 || ifIx >= P.nodes.length {
    return emitFail("emitProgram: expected an if expression")
  }
  if !chainNul {
    const sw = emitIntSwitch(ifIx, fnIx, 3, 0, kind, slot)
    if sw < 0 { return -1 }
    if sw > 0 { return 0 }
  }
  const s = nodeAt(ifIx)
  if s is IfStmt {
    // An else-less `if` used as a value is `T | null` (DECISIONS.md "An else-less `if`
    // used as a value"): the false path yields `null`, so the join is nullable and the
    // missing arm is the rep's own null. The blocktype below and the else arm at the bottom are that one fact, twice.
    const noElse = s.ifElse < 0
    const condStart = wLen()
    if emitCondExpr(s.ifCond, fnIx) < 0 { return -1 }
    const sg = staticValueIfCond(s.ifCond, condStart)
    fbOpenIf() // 0x04 if
    // A join that can yield `null` (`ifLinkYieldsNull`, from this link or one enclosing it)
    // needs a nullable blocktype, else a `(ref null $ht)` arm mismatches the non-null result.
    // A non-nullable join, or a binding whose arms are both non-null, stays non-null and widens on store.
    const nulJoin = chainNul
    fbRefIfOpenType(kind, slot, nulJoin)
    let rcT = 0
    if sg == 0 {
      rcT = emitDeadValueArm(s.ifThen)
    } else {
      rcT = emitRefIfArm(s.ifThen, fnIx, kind, slot, nulJoin)
    }
    if rcT < 0 { return -1 }
    fbElse() // 0x05 else
    let rc = 0
    if noElse {
      // The synthesized false path: the rep's own null, matching the nullable blocktype
      // above. `fbRefNullOfKind` is `fbValtypeNullable`'s VALUE twin, so the declaration
      // and the value cannot name different heap types.
      rc = fbRefNullOfKind(kind, slot)
    } else {
      const els = nodeAt(s.ifElse)
      if els is IfStmt {
        open.push(-1)
        return 1 // `else if`: the next link, which the caller emits into this open frame
      } else if sg == 1 {
        rc = emitDeadValueArm(s.ifElse)
      } else {
        rc = emitRefIfArm(s.ifElse, fnIx, kind, slot, nulJoin)
      }
    }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    return 0
  }
  return emitFail("emitProgram: expected an if expression")
}

// ── if-expression arm prelude ─────────────────────────────────────────────────
// An if-expression arm is a block whose value is its last statement; every statement
// before it is the prelude, which is what lets a binding arm sit in value position (the
// desugared `match u { A{a} => a }` shape). `emitIfArmOpen` pushes the frame and lowers the prelude; the caller emits the value and closes with `emitIfArmClose`, split in two because each arm emitter lowers the value differently while the prelude and frame are shared.

// Push the arm's lexical frame and lower every statement before the arm's value. Returns
// 0, or -1 (the caller still owes `emitIfArmClose`). A prelude declaring a local lowers only
// where `collectLocalsIf` allocated it (`armPreludeBlocks`); any other arm is rejected rather
// than lowered against slots that belong to something else.
function emitIfArmOpen(blockIx: i32, fnIx: i32) {
  scopePush()
  const b = nodeAt(blockIx)
  if b is Block {
    const stmts = b.blkStmts
    if stmts.length > 1 {
      const decl = armPreludeUnwalkedDecl(blockIx)
      if decl >= 0 {
        return emitFailAt(
          "emitProgram: an if-expression arm declares a local the collect pass did not allocate",
          decl,
        )
      }
    }
    // The prelude delivers nothing to the arm's destination, so it runs outside the atom
    // context the arm's value may be emitted under (D2199).
    let i = 0
    while i + 1 < stmts.length {
      if emitStmtIn(stmts, i, fnIx) < 0 { return -1 }
      i = i + 1
    }
  }
  return 0
}

// The first node of the arm block at `blockIx` that binds a local no pass allocated, or -1: an
// arm the collect pass walked, or one whose prelude declares nothing, lowers.
export function armPreludeUnwalkedDecl(blockIx: i32): i32 {
  if blockIx < 0 { return -1 }
  if armPreludeBlocks[blockIx] ?? false { return -1 }
  return firstLocalDeclIn(blockIx)
}

// Pop the arm's lexical frame, passing `rc` through so an arm emitter can close and
// return in one expression.
function emitIfArmClose(rc: i32) {
  scopePop()
  return rc
}

// The `emitFail` reason for an if-expression arm with no value on the stack: an empty arm
// (no value expression at all), a void call (a well-formed expression yielding nothing), or
// a real statement, each get their own message — "not a single value" would be wrong for
// the void-call case, since such an arm IS a single expression. `what` names the arm flavour so union and variant joins keep their own rep in the text.
function ifArmNoValueFail(what: string, blockIx: i32) {
  const tv = ifArmValueExpr(blockIx)
  if tv < 0 {
    return emitFailAt(
      "emitProgram: " + what + " is empty, so it yields no value",
      blockIx,
    )
  }
  const s = nodeAt(unwrapParen(tv))
  if s is Call {
    return emitFailAt(
      "emitProgram: "
        + what
        + " ends in a void call, which yields no value",
      s.callFn,
    )
  }
  return emitFailAt(
    "emitProgram: " + what + " ends in a statement, which yields no value",
    tv,
  )
}

// How one arm of a ref-typed join at `kind`/`slot` delivers its value: `plain` is the value as
// itself, `recover` the same under `ref.as_non_null`, `unbox` a narrowed arm's box recovered at
// the join's heap, `nestedIf` an `if` value joined at this rep; `null`, `atomStr` and
// `recordCopy` (refused) are written by legacy alone; `noValue` refuses.
export type RefIfArm = "plain"
  | "recover"
  | "unbox"
  | "null"
  | "atomStr"
  | "recordCopy"
  | "nestedIf"
  | "noValue"

// `emitRefIfArm`'s ladder for arm `blockIx` (D1577, D1560, D2100).
export function refIfArmOf(
  blockIx: i32,
  fnIx: i32,
  kind: VKind,
  slot: i32,
  nulJoin: boolean,
): RefIfArm {
  const b = nodeAt(blockIx)
  if !(b is Block) { return "noValue" }
  const tv = ifArmValueExpr(blockIx)
  if tv < 0 { return "noValue" }
  if ifArmIsValue(tv, fnIx) {
    if nodeAt(unwrapParen(tv)) is NullLit { return "null" }
    if kind == "struct" && refIfArmNeedsRecordCopy(tv, slot, fnIx) {
      return "recordCopy"
    }
    if kind == "str" && exprIsLitAtom(tv, fnIx) { return "atomStr" }
    if !nulJoin && nulNicheRecoverOwed(kind, tv, fnIx) { return "recover" }
    // A narrowed read of a union still holds the box, which a record join's arm unboxes, as
    // `narrowedArmNeedsUnbox` leaves no destination to (`ifJoinsAtRecord`, D17026).
    if joinKindIsRecord(kind) && narrowedArmNeedsUnbox(tv, fnIx) {
      return "unbox"
    }
    return "plain"
  }
  const inner = unwrapParen(tv)
  if (
    inner >= 0
    && nodeAt(inner) is IfStmt
    && (nulJoin || !ifLinkYieldsNull(inner, fnIx))
  ) {
    return "nestedIf"
  }
  return "noValue"
}

// One arm of a ref-typed if-expression: its prelude, then its tail-value statement emitted
// in the join rep. `nulJoin` is threaded from the caller rather than re-derived, so the
// declaration and the arm's recover cannot disagree about nullness (D1577).
function emitRefIfArm(
  blockIx: i32,
  fnIx: i32,
  kind: VKind,
  slot: i32,
  nulJoin: boolean,
) {
  const b = nodeAt(blockIx)
  if !(b is Block) {
    return emitFail("emitProgram: if-expression arm is not a block")
  }
  const arm = refIfArmOf(blockIx, fnIx, kind, slot, nulJoin)
  const tv = ifArmValueExpr(blockIx)
  match arm {
    "noValue" => {
      return ifArmNoValueFail("if-expression arm", blockIx)
    }
    "nestedIf" => {
      if emitIfArmOpen(blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
      return emitIfArmClose(emitIfExprRef(unwrapParen(tv), fnIx, kind, slot))
    }
    "null" | "atomStr" | "recover" | "unbox" | "plain" | "recordCopy" => {}
  }
  if emitIfArmOpen(blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
  // A record joined into a wider record would need a converting copy (D2100).
  if arm == "recordCopy" {
    return emitIfArmClose(
      emitFailAt(
        "emitProgram: this branch hands over a record whose field types differ from the record the branches join to, and a record is shared rather than converted — write the branch as an object literal, or give the value the joined type where it is declared",
        tv,
      ),
    )
  }
  // A bare `null` arm is the join's own null (`fbRefNullOfKind`, `fbValtypeNullable`'s value twin).
  if arm == "null" { return emitIfArmClose(fbRefNullOfKind(kind, slot)) }
  // An atom arm in a `string` join widens to its member string.
  if arm == "atomStr" { return emitIfArmClose(emitAtomToStr(tv, fnIx)) }
  // The cast is the delivery's own: to the join's heap, or none for an arm already at it.
  if arm == "unbox" {
    const heap = armDestHeapOf(kind, slot)
    if heap < 0 || heap == uBoxIdx {
      return emitIfArmClose(
        emitFailAt(
          "emitProgram: a record join's narrowed arm names no record heap",
          tv,
        ),
      )
    }
    return emitIfArmClose(emitArmDelivery(tv, fnIx, heap))
  }
  const rcV = emitExpr(tv, fnIx)
  if rcV >= 0 && arm == "recover" { fbRefAsNonNull() }
  return emitIfArmClose(rcV)
}

// Lower the if-expression at `ifIx` with a known blocktype byte `kind`, threading it
// through the `else if` recursion so the whole chain shares one result rep.
function emitIfExprAs(ifIx: i32, fnIx: i32, kind: i32) {
  // An `else if` chain is emitted along its spine, so its depth costs no stack (D1990): each
  // link leaves its frame open for the next, and the frames close innermost-first.
  const open: i32[] = []
  let cur = ifIx
  let rc = 1
  while rc == 1 {
    rc = emitIfExprAsLink(cur, fnIx, kind, open)
    if rc == 1 {
      const link = nodeAt(unwrapParen(cur))
      if link is IfStmt { cur = link.ifElse }
    }
  }
  return closeIfChainFrames(open, rc, false)
}

// One link of `emitIfExprAs`: 0 or -1 as that function returns, or 1 when the else is another `if`
// and this link's frame is left open (its else restore target pushed onto `open`).
function emitIfExprAsLink(ifIx: i32, fnIx: i32, kind: i32, open: i32[]) {
  if !nodeTyIsNullable(ifIx) {
    const sw = emitIntSwitch(ifIx, fnIx, 2, kind, "i32", -1)
    if sw < 0 { return -1 }
    if sw > 0 { return 0 }
  }
  if ifIx < 0 { return -1 }
  const s = nodeAt(ifIx)
  if s is IfStmt {
    // An else-less `if` used as a value is `T | null` (DECISIONS.md "An else-less `if`
    // used as a value"). In the i32-blocktype family the false path is a niche sentinel —
    // 2 for `boolean | null`, -1 for a nullable literal union — the same values
    // `emitNullLitNode` writes for a bare `null` there; a bare numeric join has no such spare value, so it keeps the loud refusal rather than inventing a sentinel in an i32.
    const noElseNiche = s.ifElse < 0
    if noElseNiche {
      if !nodeTyIsNulBool(ifIx) && !nodeTyIsNulLitUnion(ifIx) {
        return emitFail("emitProgram: if-expression requires an else arm")
      }
    }
    const condStart = wLen()
    if emitCondExpr(s.ifCond, fnIx) < 0 { return -1 }
    const sg = staticValueIfCond(s.ifCond, condStart)
    fbIf(kind) // 0x04 if, <kind> result blocktype
    let rcT = 0
    if sg == 0 {
      rcT = emitDeadValueArm(s.ifThen)
    } else {
      rcT = emitBlockValueAs(s.ifThen, fnIx, kind)
    }
    if rcT < 0 { return -1 }
    fbElse() // 0x05 else
    let rc = 0
    if noElseNiche {
      if nodeTyIsNulBool(ifIx) { fbI32Const(2) } else { fbI32Const(0 - 1) }
    } else {
      const els = nodeAt(s.ifElse)
      if els is IfStmt {
        open.push(-1)
        return 1 // `else if`: the next link, which the caller emits into this open frame
      } else if sg == 1 {
        rc = emitDeadValueArm(s.ifElse)
      } else {
        rc = emitBlockValueAs(s.ifElse, fnIx, kind)
      }
    }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    return 0
  }
  return emitFail("emitProgram: expected an if expression")
}

// The VALUE of an if-expression arm: its prelude, then its tail-value statement emitted
// as an expression COERCED to the if-expression's result rep `kind` (so an i32-literal
// arm widens into an f64/f32/i64 join). The i32 default emits the value as-is.
function emitBlockValueAs(blockIx: i32, fnIx: i32, kind: i32) {
  // An arm's value may clear the atom context (a `??` does), and the next arm must still
  // see it, so each arm hands the context back as it found it (D2199).
  const rc = emitBlockValueAsGo(blockIx, fnIx, kind)
  return rc
}

function emitBlockValueAsGo(blockIx: i32, fnIx: i32, kind: i32) {
  const b = nodeAt(blockIx)
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if ifArmIsValue(tv, fnIx) {
        if emitIfArmOpen(blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        if kind == 124 { return emitIfArmClose(emitWidened(tv, 4, fnIx)) }
        if kind == 125 { return emitIfArmClose(emitWidened(tv, 5, fnIx)) }
        if kind == 126 { return emitIfArmClose(emitWidened(tv, 3, fnIx)) }
        return emitIfArmClose(emitExpr(tv, fnIx))
      }
    }
    return ifArmNoValueFail("if-expression arm", blockIx)
  }
  return emitFail("emitProgram: if-expression arm is not a block")
}

// ── nullable / value-union if-expression in binding-init position ─────────────
// `const x: i32 | null = if c then 5 else null` lowers as a void `if` whose every arm
// writes the binding's own local directly — no value-typed-if blocktype and no scratch
// slot needed, since the destination local is the stash. `rep` 0 is the value-union box, 1 a `string | null` ref; `boolean | null` is not a supported local rep here yet.

// Emit ONE arm value (`valIx`) in the binding's nullable rep, then `local.set idx`.
function emitNulArmToLocal(
  valIx: i32,
  idx: i32,
  rep: i32,
  unionName: string,
  unionTy: i32,
  fnIx: i32,
) {
  if valIx < 0 {
    return emitFail("emitProgram: if-expression arm is not a value")
  }
  if rep == 0 {
    // The binding's local is the union box `(ref $uBox)`, so a concrete-variant arm (a
    // kind-8 `(ref $variant)`) must be boxed to match, exactly as `emitUnionIfArm` and a
    // variant return do. `emitUnionBoxArg` boxes a variant ref and defers every other shape
    // to `emitUnionCoerce` — plain `emitUnionCoerce` alone would store the raw variant ref, invalid wasm.
    if emitUnionBoxOwed(unionName, unionTy, valIx, fnIx) < 0 { return -1 }
  } else if rep == 1 {
    // rep 1: a `string | null` arm — a non-null string passes through, a bare `null`
    // lowers as `ref.null $sTypeIdx`. A literal-union atom arm is the one non-null value
    // that does not pass through: its rep is an i32 id, so it widens to a string first —
    // this binding-init path is routed here by `emitLetDeclStmt` and never reaches the if-arm widen at the join.
    if exprIsLitAtom(valIx, fnIx) {
      if emitStrValue(valIx, fnIx) < 0 { return -1 }
    } else {
      if emitExpr(valIx, fnIx) < 0 { return -1 }
    }
  } else {
    // rep 2: a `boolean | null` arm — a non-null boolean rides its i32 0/1; a bare
    // `null` lowers as the niche sentinel 2.
    if emitExpr(valIx, fnIx) < 0 { return -1 }
  }
  fbLocalSet(idx)
  return 0
}

// Emit the rep's NULL (the else-less false path / a synthesized null arm), then
// `local.set idx`: the value-union null-tagged box (rep 0), or `ref.null $aTypeIdx`
// for a `string | null` (rep 1).
function emitNulNullToLocal(idx: i32, rep: i32) {
  if rep == 0 {
    emitNullOwn(NULL_OWN_BOX)
  } else if rep == 1 {
    fbRefNull(sTy())
  } else {
    // rep 2: a `boolean | null` else-less / explicit-null path — the niche sentinel 2.
    fbI32Const(2)
  }
  fbLocalSet(idx)
  return 0
}

// One arm of a nullable if-BINDING: its prelude (`emitIfArmOpen`), then its tail value
// written into the binding's local. The binding-init counterpart of `emitBlockValueAs` —
// the arm is a Block here too, so a `const` it declares is lowered the same way.
function emitNulArmBlockToLocal(
  blockIx: i32,
  idx: i32,
  rep: i32,
  unionName: string,
  unionTy: i32,
  fnIx: i32,
) {
  if emitIfArmOpen(blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
  return emitIfArmClose(
    emitNulArmToLocal(
      ifArmValueExpr(blockIx),
      idx,
      rep,
      unionName,
      unionTy,
      fnIx,
    ),
  )
}

// Lower a nullable/value-union if-EXPRESSION binding init at `ifIx` into local `idx`:
// a void `if` whose then-arm writes the binding (narrowed by the condition), and whose
// else writes the else-arm value, a nested `else if` (recurse), or — when there is no
// else — the rep's null.
function emitNullableIfBinding(
  ifIx: i32,
  idx: i32,
  rep: i32,
  unionName: string,
  unionTy: i32,
  fnIx: i32,
) {
  // An `else if` chain is emitted along its spine, so its depth costs no stack (D1990): each
  // link leaves its frame open for the next, and the frames close innermost-first.
  const open: i32[] = []
  let cur = ifIx
  let rc = 1
  while rc == 1 {
    rc = emitNullableIfBindingLink(
      cur,
      idx,
      rep,
      unionName,
      unionTy,
      fnIx,
      open,
    )
    if rc == 1 {
      const link = nodeAt(unwrapParen(cur))
      if link is IfStmt { cur = link.ifElse }
    }
  }
  return closeIfChainFrames(open, rc, false)
}

// One link of `emitNullableIfBinding`: 0 or -1 as that function returns, or 1 when the else is another `if`
// and this link's frame is left open (its else restore target pushed onto `open`).
function emitNullableIfBindingLink(
  ifIx: i32,
  idx: i32,
  rep: i32,
  unionName: string,
  unionTy: i32,
  fnIx: i32,
  open: i32[],
) {
  const s = nodeAt(unwrapParen(ifIx))
  if s is IfStmt {
    if emitCondExpr(s.ifCond, fnIx) < 0 { return -1 }
    fbIf(64) // 0x04 if, 0x40 void blocktype
    const rc = emitNulArmBlockToLocal(
      s.ifThen,
      idx,
      rep,
      unionName,
      unionTy,
      fnIx,
    )
    if rc < 0 { return -1 }
    fbElse() // 0x05 else
    let erc = 0
    if s.ifElse < 0 {
      erc = emitNulNullToLocal(idx, rep)
    } else {
      const els = nodeAt(s.ifElse)
      if els is IfStmt && !ifJoinAdaptsScalar(s.ifElse, fnIx) {
        open.push(-1)
        return 1 // `else if`: the next link, which the caller emits into this open frame
      } else if els is IfStmt {
        erc = emitNulArmToLocal(s.ifElse, idx, rep, unionName, unionTy, fnIx)
      } else {
        erc = emitNulArmBlockToLocal(
          s.ifElse,
          idx,
          rep,
          unionName,
          unionTy,
          fnIx,
        )
      }
    }
    if erc < 0 { return -1 }
    fbEnd() // 0x0b end
    return 0
  }
  return emitFail("emitProgram: expected an if expression")
}

// ── the union-box binding sink ────────────────────────────────────────────────
// `const u: A | B = if c { a } else { b }` needs the box built once after the merge, not
// once per arm plus a pre-seed (three allocation sites means Heap2Local can scalarize none
// of them, so the box survives as a real heap object). The sink writes each arm's tag and payload into a shared pair and does the single `struct.new` after the `if`; gated on `unionIfBindingAllBox` since an arm that already passes a box through would otherwise be unboxed and rebuilt for nothing.

// Whether a union binding's `if` initializer at `ifIx` is written through the binding sink (one
// `struct.new` after the `if`), rather than a seeded box each arm overwrites.
export function letIfInitSinks(ifIx: i32, fnIx: i32): boolean {
  return fnUses.unionLetSink && unionIfBindingAllBox(ifIx, fnIx)
}

// Does every terminal arm of the union-box if-binding at `ifIx` CONSTRUCT its box? An
// `else if` chain link recurses; an else-LESS chain contributes the rep's null box, which
// is a construction like any other.
function unionIfBindingAllBox(ifIx: i32, fnIx: i32) {
  const s = nodeAt(unwrapParen(ifIx))
  if s is IfStmt {
    if !unionIfArmBoxes(ifArmValueExpr(s.ifThen), fnIx) { return false }
    if s.ifElse < 0 { return true }
    const els = nodeAt(s.ifElse)
    if els is IfStmt && !ifJoinAdaptsScalar(s.ifElse, fnIx) {
      return unionIfBindingAllBox(s.ifElse, fnIx)
    }
    if els is IfStmt { return unionIfArmBoxes(s.ifElse, fnIx) }
    return unionIfArmBoxes(ifArmValueExpr(s.ifElse), fnIx)
  }
  return false
}

// The two arm shapes whose lowering does not end in `struct.new $uBox`: a value that is
// already a box (`emitUnionCoerce` passes it through untouched), and a nested if-expression
// (`emitUnionIfValue`'s value-typed `if`, whose last instruction is the frame's `end`).
// Every other shape bottoms out in the box's own construction.
function unionIfArmBoxes(valIx: i32, fnIx: i32) {
  if valIx < 0 { return false }
  if exprUnion(valIx, fnIx) { return false }
  const v = nodeAt(unwrapParen(valIx))
  if v is IfStmt { return ifJoinAdaptsScalar(unwrapParen(valIx), fnIx) }
  return true
}

// Emit ONE arm value into the sink pair: the arm's box, unwritten by the peephole down to
// its two operands. The BACKSTOP (an arm that did not end in a construction after all)
// stores the box it did produce into the binding's own slot and reads the pair back out of
// it — correct, and costing the rebuild after the `if` that the gate exists to avoid.
function emitUnionArmToPair(
  valIx: i32,
  idx: i32,
  unionName: string,
  unionTy: i32,
  fnIx: i32,
) {
  if valIx < 0 {
    return emitFail("emitProgram: if-expression arm is not a value")
  }
  if emitUnionBoxOwed(unionName, unionTy, valIx, fnIx) < 0 { return -1 }
  return unionBoxToPairTail(idx)
}

// After a binding sink arm's box: the construction just written popped into the sink pair, else
// the box parked in the binding's local `idx` and its tag and payload read into the pair.
export function unionBoxToPairTail(idx: i32) {
  if uBoxNewIsLast() {
    uBoxSinkToPair()
    return 0
  }
  fbLocalSet(idx)
  fbLocalGet(idx)
  fbStructGet(uBoxIdx, 0) // field 0: tag
  fbLocalSet(unionSinkBase)
  fbLocalGet(idx)
  fbStructGet(uBoxIdx, 1) // field 1: payload (anyref)
  fbLocalSet(unionSinkBase + 1)
  return 0
}

// The rep's NULL into the sink pair (the else-less false path): the null tag and the
// unread payload slot, written directly rather than through a box the merge would discard.
export function emitUnionNullToPair() {
  fbI32Rel(RS_TAG, nullBoxTag())
  fbLocalSet(unionSinkBase)
  fbRefNullNone() // the payload slot is unread under the null tag
  fbLocalSet(unionSinkBase + 1)
  return 0
}

// One arm of a union-box if-BINDING sink: its prelude (`emitIfArmOpen`), then its tail
// value written into the sink pair. The prelude precedes the arm's box construction, so
// the `uBoxNewIsLast` peephole still sees the construction as the last instruction.
function emitUnionArmBlockToPair(
  blockIx: i32,
  idx: i32,
  unionName: string,
  unionTy: i32,
  fnIx: i32,
) {
  if emitIfArmOpen(blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
  return emitIfArmClose(
    emitUnionArmToPair(
      ifArmValueExpr(blockIx),
      idx,
      unionName,
      unionTy,
      fnIx,
    ),
  )
}

// After a binding sink's `if`: the binding's one box built from the sink pair into local `idx`.
export function unionLetSinkClose(idx: i32) {
  fbLocalGet(unionSinkBase)
  fbLocalGet(unionSinkBase + 1)
  fbStructNew(uBoxIdx) // the binding's ONE box
  return fbLocalSet(idx)
}

// `emitNullableIfBinding`'s rep-0 shape with every arm writing the sink pair instead of
// the binding's slot. The caller performs the one `struct.new` after the `if`.
function emitUnionIfBindingSink(
  ifIx: i32,
  idx: i32,
  unionName: string,
  unionTy: i32,
  fnIx: i32,
) {
  // An `else if` chain is emitted along its spine, so its depth costs no stack (D1990): each
  // link leaves its frame open for the next, and the frames close innermost-first.
  const open: i32[] = []
  let cur = ifIx
  let rc = 1
  while rc == 1 {
    rc = emitUnionIfBindingSinkLink(cur, idx, unionName, unionTy, fnIx, open)
    if rc == 1 {
      const link = nodeAt(unwrapParen(cur))
      if link is IfStmt { cur = link.ifElse }
    }
  }
  return closeIfChainFrames(open, rc, false)
}

// One link of `emitUnionIfBindingSink`: 0 or -1 as that function returns, or 1 when the else is another `if`
// and this link's frame is left open (its else restore target pushed onto `open`).
function emitUnionIfBindingSinkLink(
  ifIx: i32,
  idx: i32,
  unionName: string,
  unionTy: i32,
  fnIx: i32,
  open: i32[],
) {
  const s = nodeAt(unwrapParen(ifIx))
  if s is IfStmt {
    if emitCondExpr(s.ifCond, fnIx) < 0 { return -1 }
    fbIf(64) // 0x04 if, 0x40 void blocktype
    const rc = emitUnionArmBlockToPair(s.ifThen, idx, unionName, unionTy, fnIx)
    if rc < 0 { return -1 }
    fbElse() // 0x05 else
    let erc = 0
    if s.ifElse < 0 {
      erc = emitUnionNullToPair()
    } else {
      const els = nodeAt(s.ifElse)
      if els is IfStmt && !ifJoinAdaptsScalar(s.ifElse, fnIx) {
        open.push(-1)
        return 1 // `else if`: the next link, which the caller emits into this open frame
      } else if els is IfStmt {
        erc = emitUnionArmToPair(s.ifElse, idx, unionName, unionTy, fnIx)
      } else {
        erc = emitUnionArmBlockToPair(s.ifElse, idx, unionName, unionTy, fnIx)
      }
    }
    if erc < 0 { return -1 }
    fbEnd() // 0x0b end
    return 0
  }
  return emitFail("emitProgram: expected an if expression")
}

// Builds the number literal at `exprIx` (parens and minuses peeled) as one `<w>.const`; -2 when
// `exprIx` is no literal. `w` is the checker's type of the position reading it, for a literal node
// read at several widths: a numeric-union member's operator, or a numeric operator's operand.
// Re-encoding keeps a hex literal past I32_MAX the value it spells.
function emitNumLitAs(exprIx: i32, w: string): i32 {
  if !numLitAsApplies(exprIx) { return -2 }
  return emitSignedNumLitAt(unwrapParen(exprIx), w)
}

// Whether `exprIx` is a number literal an operator builds at its own width (`emitNumLitAs`).
export function numLitAsApplies(exprIx: i32): boolean {
  return cexLitPeel(exprIx) >= 0
}

// The assignment at `exprIx` whose value is its right side's number literal (`asgLitWidth`):
// stored, then that literal built at `w`, the checker's width of the position reading it; -2
// for any other node.
function emitAsgLitAs(exprIx: i32, w: string, fnIx: i32): i32 {
  const ix = unwrapParen(exprIx)
  if ix < 0 || ix >= P.nodes.length || asgLitWidth(ix, fnIx) == "" { return -2 }
  const a = nodeAt(ix)
  if !(a is BinExpr) { return -2 }
  if emitAssign(ix, fnIx) < 0 { return -1 }
  return emitNumLitAs(a.binRight, w)
}

// The numeric pair (`numPairCode`) the checker recorded for `ix` at instance `fnIx`, at the node,
// its unparenthesised form or the node it stands in for; -1 for none.
function numRecordAt(ix: i32, fnIx: i32): i32 {
  let r = numPairAt(ix, fnIx)
  if r < 0 { r = numPairAt(unwrapParen(ix), fnIx) }
  if r < 0 { r = numPairAt(nodeSrc[ix] ?? -1, fnIx) }
  return r
}

// The source kind of numeric pair `r`, a `u8` read as the `i32` it is stored in.
function numPairSrc(r: i32): i32 {
  const s = r / 8
  return if s == 2 { 1 } else { s }
}

// Why the site widens `ix` from kind `src` to `dst` itself, or "" where the record serves: the
// node is not held by another conversion and its record names the same pair.
function numFloorWhy(src: i32, dst: i32, ix: i32, fnIx: i32): string {
  if ix == coerceHeld { return "floor: held" }
  let r = numRecordAt(ix, fnIx)
  if boxDstShadowArmed() { r = numDropRecord(r) }
  if r < 0 && callIsNever(unwrapParen(ix)) { return "floor: never returns" }
  if r < 0 { return "floor: no record" }
  if r % 8 != dst { return "floor: dst differs" }
  if numPairSrc(r) != src { return "floor: src differs" }
  return ""
}

// The one instruction that takes a value of kind `src` to kind `dst`: none for the same kind.
// Returns 0, or -1 for a pair no lowering widens.
function emitNumOpOf(src: i32, dst: i32): i32 {
  if src == dst { return 0 }
  if src == 1 && dst == 3 {
    fbI64ExtendI32S()
    return 0
  }
  if src == 1 && dst == 4 {
    fbF64ConvertI32S()
    return 0
  }
  if src == 3 && dst == 4 {
    fbF64ConvertI64S()
    return 0
  }
  if src == 5 && dst == 4 {
    fbF64PromoteF32()
    return 0
  }
  if src == 1 && dst == 5 {
    fbF32ConvertI32S()
    return 0
  }
  return emitFail(
    "emitProgram: a numeric delivery records a pair no widening converts",
  )
}

// A value of plain kind `src` the site derived, delivered at kind `dst`: the table widens it at the
// checker's numeric pair where that names the same pair, else the site widens it, a named floor.
// Returns 0, or -1 failed.
function emitNumPlain(src: i32, dst: i32, exprIx: i32, fnIx: i32): i32 {
  if boxDstShadowArmed() {
    const why = numFloorWhy(src, dst, exprIx, fnIx)
    boxDstShadowAs(if why == "" { "table" } else { why })
    numPairShadowNote(src, dst, exprIx, fnIx)
  }
  if emitExpr(exprIx, fnIx) < 0 { return -1 }
  return numWidenTail(src, dst, exprIx, fnIx)
}

// After value `exprIx` of kind `src`, built as itself: its widening to kind `dst`. Where the
// checker's record serves, a dead `never` operand has already written `unreachable` and needs none.
export function numWidenTail(src: i32, dst: i32, exprIx: i32, fnIx: i32): i32 {
  if (
    numFloorWhy(src, dst, exprIx, fnIx) == ""
    && exprReadsDeadNever(exprIx, fnIx)
  ) {
    return 0
  }
  return emitNumOpOf(src, dst)
}

// The numeric shadow's note for a site lowering `exprIx` from kind `src` to `dst` (-1: built at
// `dst`), where the shadow is armed.
function numNote(src: i32, dst: i32, exprIx: i32, fnIx: i32) {
  if boxDstShadowArmed() { numPairShadowNote(src, dst, exprIx, fnIx) }
  return 0
}

// `numNote` after a build that returned `r`, handing `r` back.
function numNoted(r: i32, src: i32, dst: i32, exprIx: i32, fnIx: i32): i32 {
  if r >= 0 { numNote(src, dst, exprIx, fnIx) }
  return r
}

// Builds `ix` at number kind `dst` (3 i64, 4 f64, 5 f32) by its plan (`widenPlanOf`).
export function emitWidened(ix: i32, dst: i32, fnIx: i32): i32 {
  const p = widenPlanOf(ix, dst, fnIx)
  const w = if dst == 3 { "i64" } else if dst == 4 { "f64" } else { "f32" }
  return match p.wpArm {
    "instLit" | "floatLit" => widenLitAt(ix, dst, fnIx)
    "asgLit" => numNoted(emitAsgLitAs(ix, w, fnIx), -1, dst, ix, fnIx)
    "radix" => {
      const at = if dst == 3 { unwrapParen(ix) } else { ix }
      numNoted(emitAsgRadixAs(at, p.wpWide, w, fnIx), -1, dst, ix, fnIx)
    }
    "convert" => numNoted(emitNumUnionConvert(ix, dst, fnIx), 6, dst, ix, fnIx)
    "plain" => emitNumPlain(p.wpSrc, dst, ix, fnIx)
  }
}

// The literal `ix` written at number kind `dst` (3 i64, 4 f64, 5 f32).
function widenLitAt(ix: i32, dst: i32, fnIx: i32): i32 {
  const w = if dst == 3 { "i64" } else if dst == 4 { "f64" } else { "f32" }
  return numNoted(emitSignedNumLitAt(unwrapParen(ix), w), -1, dst, ix, fnIx)
}

// Lower `exprIx` in the rep of a value atom of kind `k` — the emit half of
// `valBlockTypeOfKind`'s blocktype: i64/f64/f32 route through their widening helper,
// every other kind (i32, boolean, the ref atoms) through `emitExpr`. Kept beside that
// ladder so the two halves of "what rep does this arm produce" move together.
export function emitExprAsKind(exprIx: i32, k: i32, fnIx: i32) {
  if k == 3 || k == 4 || k == 5 { return emitWidened(exprIx, k, fnIx) }
  return emitExpr(exprIx, fnIx)
}

// `emitExprAsKind` at a list element kind: a scalar list's value widens to its element.
function emitExprAsElem(exprIx: i32, ek: VKind, fnIx: i32) {
  if ek == "i64" { return emitWidened(exprIx, 3, fnIx) }
  if ek == "f64" { return emitWidened(exprIx, 4, fnIx) }
  if ek == "f32" { return emitWidened(exprIx, 5, fnIx) }
  return emitExpr(exprIx, fnIx)
}

// ── the numeric exact-or-fail cast (D1041) ────────────────────────────────────
// A numeric `as` to an integer target succeeds iff the value is exactly representable
// there, else fails as the trio fails everywhere (`as?` null, `as!` traps, bare `as`
// propagates). The test is "integral and in range", not a round-trip compare — a round-trip is exact only for `f64 → i32`, not the other three float pairs, since the convert-back rounds and admits a value the target cannot hold; NaN fails integrality for free.

// `dom` is the exactness domain, not the rep target: `u8` names 0..255 inside the `i32` (D1587);
// both `u8` bounds convert exactly at f32 and f64, so its upper test is `<=` at both.
// `integral` drops the integrality compare for an operand integral by construction (SP-056);
// NaN then fails the range test instead.
function emitNumExactTest(src: string, dom: string, integral: boolean) {
  const u8Dom = dom == "u8"
  if src == "i64" {
    // `i64 -> i32` / `i64 -> u8`: a pure range test, and never a wrap. The bounds are exact
    // i64 literals. An i32 SOURCE arrives here too — `emitNumExactCast` widens it, exactly.
    fbLocalGet(numCastStashSlot(2))
    if u8Dom {
      fbI64Const(0, 0) // i64.const 0
    } else {
      fbI64Const(-1, -2147483648) // i64.const -2147483648
    }
    fbI64GeS()
    fbLocalGet(numCastStashSlot(2))
    if u8Dom {
      fbI64Const(0, 255) // i64.const 255
    } else {
      fbI64Const(0, 2147483647) // i64.const 2147483647
    }
    fbI64LeS()
    fbI32And()
    return 0
  }
  const isF32 = src == "f32"
  let slot = numCastStashSlot(0)
  if isF32 { slot = numCastStashSlot(1) }
  // INTEGRAL: `trunc(d) == d`. A fraction fails it, and so does NaN (no comparison involving
  // NaN is true), which is the ruling's verdict on a NaN cast arriving for free.
  if !integral {
    fbLocalGet(slot)
    if isF32 { fbF32Trunc() } else { fbF64Trunc() }
    fbLocalGet(slot)
    if isF32 { fbF32Eq() } else { fbF64Eq() }
  }
  // IN RANGE, lower: `d >= convert(<domain>::MIN)`. ±Inf fails one side or the other.
  fbLocalGet(slot)
  if u8Dom {
    fbI32Const(0)
    if isF32 { fbF32ConvertI32S() } else { fbF64ConvertI32S() }
  } else if dom == "i32" {
    fbI32Const(-2147483648)
    if isF32 { fbF32ConvertI32S() } else { fbF64ConvertI32S() }
  } else {
    fbI64Const(-2147483648, 0) // i64.const -9223372036854775808
    if isF32 { fbF32ConvertI64S() } else { fbF64ConvertI64S() }
  }
  if isF32 { fbF32Ge() } else { fbF64Ge() }
  if !integral { fbI32And() }
  // IN RANGE, upper — `<=` only where the converted maximum is exact (see the table above).
  fbLocalGet(slot)
  if u8Dom {
    fbI32Const(255)
    if isF32 { fbF32ConvertI32S() } else { fbF64ConvertI32S() }
  } else if dom == "i32" {
    fbI32Const(2147483647)
    if isF32 { fbF32ConvertI32S() } else { fbF64ConvertI32S() }
  } else {
    fbI64Const(2147483647, -1) // i64.const 9223372036854775807
    if isF32 { fbF32ConvertI64S() } else { fbF64ConvertI64S() }
  }
  if u8Dom {
    if isF32 { fbF32Le() } else { fbF64Le() }
  } else if isF32 {
    fbF32Lt()
  } else if dom == "i64" {
    fbF64Lt()
  } else {
    fbF64Le()
  }
  fbI32And()
  return 0
}

// The conversion itself, reached only where `emitNumExactTest` has already proved it
// cannot fail, so the trapping instructions are used rather than the saturating ones: an
// operand here is in range by construction, and if that is ever false a trap is the
// honest outcome, not a silent clamp.
function emitNumExactConvert(src: string, tgt: string) {
  if src == "i64" {
    fbLocalGet(numCastStashSlot(2))
    fbI32WrapI64()
    return 0
  }
  if src == "f32" {
    fbLocalGet(numCastStashSlot(1))
    if tgt == "i32" { fbI32TruncF32S() } else { fbI64TruncF32S() }
    return 0
  }
  fbLocalGet(numCastStashSlot(0))
  if tgt == "i32" { fbI32TruncF64S() } else { fbI64TruncF64S() }
  return 0
}

// The `as!` trap's reason, `as! <tgt> at <line>:<col>: not exact`, printed by the one
// `__as_fail__` body from the site's place and the domain's row, so a site costs one call
// (SP-056). Line 0 names no place. The caller emits the trap itself.
function emitNumCastTrapMsg(exprIx: i32, tgt: string) {
  if gHelpAsFail < 0 || gImports < 4 {
    return emitFail(
      "emitProgram: `as! " + tgt + "` with no `__as_fail__` reserved",
    )
  }
  let row = 0
  while row < AS_FAIL_DOMS.length && AS_FAIL_DOMS[row] != tgt { row = row + 1 }
  if row == AS_FAIL_DOMS.length {
    return emitFail(
      "emitProgram: `as! " + tgt + "` has no `__as_fail__` domain row",
    )
  }
  let line = 0
  let col = 0
  if exprIx >= 0 && exprIx < nodeToks.length {
    const at = nodeToks[exprIx]
    if at >= 0 && at < P.toks.length {
      line = P.toks[at].line
      col = P.toks[at].col + 1
    }
  }
  fbI32Const(line)
  fbI32Const((col << 3) | row)
  fbCall(gHelpAsFail)
  return 0
}

// The `null` node record literal `objIx`'s omitted field `name` holds: the one the literal's
// check minted and delivered (`omitFieldNull`), reached through a mono copy's source node;
// -1, through `emitFail`, where the check minted none.
function omittedFieldNullNode(objIx: i32, name: string): i32 {
  let at = objIx
  let depth = 0
  while at >= 0 && depth < 8 {
    const mn = omitFieldNull[omitFieldKey(at, name)] ?? -1
    if mn >= 0 { return mn }
    at = nodeSrc[at] ?? -1
    depth = depth + 1
  }
  return emitFail(
    "emitProgram: internal: an omitted record field reached emit with no `null` its check minted",
  )
}

// A cast's miss at an instance whose operand it can never hit: `as?` evaluates the operand and
// is its own `null`, `as!` traps after it, and a bare `as` returns the operand as the remainder.
function emitAsInstMiss(e: AsExpr, exprIx: i32, fnIx: i32) {
  if e.asMode != "null" && e.asMode != "trap" {
    if emitReturnValue(e.asObj, fnIx) < 0 { return -1 }
    fbReturn()
    return 0
  }
  if emitExpr(e.asObj, fnIx) < 0 { return -1 }
  fbDrop()
  if e.asMode == "trap" {
    fbUnreachable()
    return 0
  }
  const mt = nodeTyIxOf(exprIx)
  if repOfTy(mt).rdKind == "union" {
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone()
    fbStructNew(uBoxIdx)
    return 0
  }
  return emitNullOwn(nullOwnOfTy(mt))
}

// The cast node `exprIx` copies, through a mono copy's source nodes (`nodeSrc`).
function asCastRoot(exprIx: i32): i32 {
  let at = exprIx
  let depth = 0
  while depth < 8 {
    const up = nodeSrc[at] ?? -1
    if up < 0 { return at }
    at = up
    depth = depth + 1
  }
  return at
}

// The `null` node bare `as` cast `exprIx` hands `emitReturnValue` on a miss: the one its check
// minted and delivered (`asMissNullOf`), reached through a mono copy's source node (`nodeSrc`);
// -1, through `emitFail`, where the check minted none.
function numCastNullNode(exprIx: i32): i32 {
  let at = exprIx
  let depth = 0
  while at >= 0 && depth < 8 {
    const mn = asMissNullOf(at)
    if mn >= 0 { return mn }
    at = nodeSrc[at] ?? -1
    depth = depth + 1
  }
  return emitFail(
    "emitProgram: internal: a bare `as` reached emit with no miss `null` its check minted",
  )
}

// The three modes, over one shared test and conversion: `as?` is a value-producing `if`
// whose result is the `{tag, payload}` union box (the same rep `emitUnionCoerce`'s
// `NullLit` builds, so every delivery position already knows the null); `as!` is the
// reason, `unreachable`, then the conversion; a bare `as` returns the enclosing function's own null (built by the return path) then the conversion.
function emitNumExactCast(e: AsExpr, exprIx: i32, fnIx: i32) {
  return emitNumExactCastFrom(e, exprIx, asExprNumSrcName(exprIx), fnIx)
}

// The box tag of the numeric `as` target at `ix`, read off the node's type as
// `asExprNumTgtName` reads its spelling.
function asExprNumTgtKind(ix: i32): i32 {
  return boxTagOfPrim(primNameOf(tyPeelNul(nodeTyIxOf(ix))))
}

// `emitNumExactCast` from the source rep `srcIn`, which a type-parameter operand reads off
// its instance rather than its recorded type.
function emitNumExactCastFrom(
  e: AsExpr,
  exprIx: i32,
  srcIn: string,
  fnIx: i32,
) {
  if emitExprAsKind(e.asObj, numExactCastKind(srcIn), fnIx) < 0 { return -1 }
  return numExactCastTail(exprIx, srcIn, fnIx)
}

// The value kind `emitNumExactCastFrom` builds a `src` operand at: i64, f32, else f64. An i32
// source exists only at the `u8` domain and rides the i64 path rather than a fourth scratch
// slot: `i64.extend_i32_s` is exact, and `i32.wrap_i64` brings the proven 0..255 value back.
export function numExactCastKind(src: string): i32 {
  if src == "i32" || src == "i64" { return 3 }
  if src == "f32" { return 5 }
  if src == "f64" { return 4 }
  return numCastSrcFail(src)
}

// A numeric cast whose source is no number, which `numCastCanFail` and `numCastSrcRepOf` never
// hand the kinds above.
function numCastSrcFail(src: string): i32 {
  return emitFail(
    "emitProgram: a numeric cast's source `" + src + "` is not a number",
  )
}

// After `numExactCastKind`'s operand: staged once, since the test reads it up to three times,
// then the test, the mode's sad path and the conversion.
export function numExactCastTail(exprIx: i32, srcIn: string, fnIx: i32): i32 {
  const e = nodeAt(exprIx)
  if !(e is AsExpr) {
    return emitFail("emitProgram: a numeric cast's tail lost its cast")
  }
  // The domain decides the range test and the `as!` message, the target the conversion opcode
  // and the box row; they differ only at `u8` (D1587).
  const tgt = asExprNumTgtName(exprIx)
  const dom = asExprNumCastDomain(exprIx)
  const k = numExactCastKind(srcIn)
  const src = if srcIn == "i32" { "i64" } else { srcIn }
  fbLocalSet(numCastStashSlot(if k == 3 { 2 } else if k == 5 { 1 } else { 0 }))
  const integral = src != "i64" && exprIsIntegralFloat(e.asObj, fnIx)
  if emitNumExactTest(src, dom, integral) < 0 { return -1 }
  if e.asMode == "null" {
    const nck = asExprNumTgtKind(exprIx)
    const nvb = vbHeapIdxOfKind(nck)
    if nvb < 0 || !uDeclared {
      return emitFail(
        "emitProgram: `as? "
          + tgt
          + "` has no value box — the `"
          + tgt
          + " | null` row was never registered",
      )
    }
    fbIfRefNul(uBoxIdx, false) // if (result (ref $uBox))
    fbI32Rel(RS_TAG, scalarTagOfKind(nck))
    if emitNumExactConvert(src, tgt) < 0 { return -1 }
    fbStructNew(nvb) // wrap the scalar payload
    fbStructNew(uBoxIdx)
    fbElse()
    // The null-tagged box, not a null box ref — what `T | null` means for a boxed union.
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone() // the payload slot is unread under the null tag
    fbStructNew(uBoxIdx)
    fbEnd()
    return 0
  }
  fbI32Eqz()
  fbIf(64) // if (void) — the SAD path, the only place the two remaining modes differ
  if e.asMode == "trap" {
    // The DOMAIN is what the author wrote, so `x as! u8` says `as! u8`, not `as! i32`. An
    // integral float out of i32's or i64's range fails exactly where the conversion below
    // traps, so it traps there and the host names the range (SP-056).
    if emitNumCastTrapMsg(exprIx, dom) < 0 { return -1 }
    if !integral || dom != tgt { fbUnreachable() }
  } else {
    // A bare `as` PROPAGATES. The checker proved the enclosing function returns something
    // `null` fits, so the value to hand back is that function's own null — built through
    // `emitReturnValue`, which is where every nullable-return seed already lives.
    const missNull = numCastNullNode(exprIx)
    if missNull < 0 { return -1 }
    if emitReturnValue(missNull, fnIx) < 0 { return -1 }
    fbReturn()
  }
  fbEnd()
  return emitNumExactConvert(src, tgt)
}

// The sad path of `as!` or bare `as` over a type parameter pinned at no number: the value is
// never the target, so `as!` traps with its reason and `as` returns the function's own null.
function emitHoleNumCastMiss(e: AsExpr, exprIx: i32, fnIx: i32) {
  if emitExpr(e.asObj, fnIx) < 0 { return -1 }
  fbDrop()
  if e.asMode == "trap" {
    if emitNumCastTrapMsg(exprIx, asExprNumCastDomain(exprIx)) < 0 { return -1 }
    fbUnreachable()
    return 0
  }
  const missNull = numCastNullNode(exprIx)
  if missNull < 0 { return -1 }
  if emitReturnValue(missNull, fnIx) < 0 { return -1 }
  fbReturn()
  return 0
}

// `x as% T` — the wrap cast (`DECISIONS.md` §"`as%` is the wrap cast"). It cannot fail, so
// there is no test, no sad path and no staging slot: one conversion opcode, and the byte mask
// at the `u8` domain. A literal operand folds to the constant it denotes, which is what lets a
// consumer write a 32-bit bit pattern.
function emitNumWrapCast(e: AsExpr, exprIx: i32, fnIx: i32) {
  const obj = e.asObj
  return match asWrapArmOf(exprIx, fnIx) {
    "floatFloor" => emitFail(
      "emitProgram: `as% "
        + e.asTy
        + "` wraps between integer widths, and this cast names a float — use `as!` or `as?`",
    )
    "unionFloor" => emitFail(
      "emitProgram: `as% "
        + e.asTy
        + "` wraps a number, and this operand is a union — take the numeric arm first",
    )
    "narrowMask" => srEmitNarrowed(srWrappedMask(exprIx, fnIx), fnIx)
    "litFold" => emitNumWrapLit(obj, exprIx)
    "plain" => emitNumWrapPlain(obj, exprIx, fnIx)
    "notCast" => emitFail("emitProgram: a wrap cast's arm was asked of a node that is no cast")
  }
}

function emitNumWrapPlain(obj: i32, exprIx: i32, fnIx: i32) {
  if emitExprAsKind(obj, numWrapCastKind(exprIx, fnIx), fnIx) < 0 { return -1 }
  return numWrapCastTail(exprIx, fnIx)
}

// The arm `emitNumWrapCast` takes: a float or union operand, both refused at check, is a floor
// for an operand whose width only the emitted rep knows; `((y >>> k) & m) as% i32` narrows to
// i32 ops when the mask stays in the low word; an integer literal folds to its constant.
export type AsWrapArm = "floatFloor"
  | "unionFloor"
  | "narrowMask"
  | "litFold"
  | "plain"
  | "notCast"

export function asWrapArmOf(exprIx: i32, fnIx: i32): AsWrapArm {
  const e = nodeAt(exprIx)
  if !(e is AsExpr) { return "notCast" }
  const obj = e.asObj
  const tgt = wrapCastTgt(exprIx)
  if (
    exprIsF32(obj, fnIx)
    || exprIsF64(obj, fnIx)
    || tgt == "f32"
    || tgt == "f64"
  ) {
    return "floatFloor"
  }
  if asExprIsUnionCastIn(exprIx, fnIx) { return "unionFloor" }
  if tgt == "i64" { return "plain" }
  if srWrappedMask(exprIx, fnIx).length > 0 { return "narrowMask" }
  const lit = nodeAt(unwrapParen(obj))
  if lit is NumLit {
    if !numLexIsFloat(lit.numText) { return "litFold" }
  }
  return "plain"
}

// The wrap cast's target: the node's numeric target, else its spelling.
function wrapCastTgt(exprIx: i32): string {
  const tgt = asExprNumTgtName(exprIx)
  if tgt != "" { return tgt }
  const e = nodeAt(exprIx)
  return if e is AsExpr { e.asTy } else { "" }
}

// The wrap cast's integer literal operand as the 32-bit constant it denotes, masked at `u8`.
function emitNumWrapLit(obj: i32, exprIx: i32) {
  const lit = nodeAt(unwrapParen(obj))
  if lit is NumLit {
    const pr = parseI64Pair(lit.numText)
    fbI32Const(pr[1])
  }
  return numWrapDomainMask(exprIx)
}

// The value kind `asWrapArmOf`'s `plain` arm builds its operand at: i64 for an i64 target (the
// sign-extend is the whole cast) or an i64 operand, else the operand as itself.
export function numWrapCastKind(exprIx: i32, fnIx: i32): i32 {
  const e = nodeAt(exprIx)
  if wrapCastTgt(exprIx) == "i64" { return 3 }
  if e is AsExpr {
    if exprIsI64(e.asObj, fnIx) { return 3 }
  }
  return 0
}

// After `numWrapCastKind`'s operand: the i64 wrap to i32, then the byte mask at `u8`.
export function numWrapCastTail(exprIx: i32, fnIx: i32): i32 {
  if wrapCastTgt(exprIx) == "i64" { return 0 }
  if numWrapCastKind(exprIx, fnIx) == 3 { fbI32WrapI64() }
  return numWrapDomainMask(exprIx)
}

function numWrapDomainMask(exprIx: i32) {
  if asExprNumCastDomain(exprIx) == "u8" {
    fbI32Const(255)
    fbI32Bin(113) // 0x71 i32.and
  }
  return 0
}

// The `as` trio over a niche-repped `T | null` operand: `ref.null` is the whole encoding of
// the absent arm, so there is no tag to test and no payload to unbox. `as!`'s ruled trap IS
// `ref.as_non_null`, and `as?`'s result type is the operand's own rep (D1812).
function emitAsNulNiche(e: AsExpr, fnIx: i32) {
  const obj = e.asObj
  const payload = nulRefNichePayloadTy(nodeTyAt(obj, fnIx))
  if payload < 0 {
    // Names the operand's own shape: a `| null` niche only when the operand is nullable.
    const what = if nodeTyIsNullable(obj) { "this `| null` is a value niche whose null is a spare scalar" } else { "this union is stored unboxed" }
    return emitFailAt(
      "emitProgram: `as "
        + e.asTy
        + "` needs a BOXED union operand or a nullable-REF one; "
        + what
        + ", with neither a tag nor a ref to test",
      obj,
    )
  }
  if !nulNicheCastWiredTy(payload) {
    return emitFail(
      "emitProgram: `as "
        + e.asTy
        + "` over a `"
        + e.asTy
        + " | null` has no niche lowering for this payload: the trio is lowered over a nullable string, list, record, map, union variant and function value — narrow it with `if x != null { … }`",
    )
  }
  // `T | null` is exactly what the operand already is, so `as?` is the identity — the same
  // cell, at the same rep, and every consumer reads the cast node's own `T | null` type.
  if e.asMode == "null" { return emitExpr(obj, fnIx) }
  if e.asMode == "trap" {
    if emitExpr(obj, fnIx) < 0 { return -1 }
    // One opcode and no heap index: `ref.as_non_null` traps on the miss, which is the ruled
    // sad path, and hands the present value back at its own non-null heap type.
    fbRefAsNonNull()
    return 0
  }
  // The propagating `as`: a present value leaves the block at its own non-null heap type, and a
  // null returns the function's own null, as an explicit `if x == null { return null }` does.
  // Read once, into no scratch slot (D1812, D16066).
  const heap = nulNicheHeapOf(obj, payload, fnIx)
  if heap >= 0 && fnRetNullBearing(fnIx) {
    fbBlockRefNul(heap, false)
    if emitExpr(obj, fnIx) < 0 { return -1 }
    fbBrOnNonNull(0)
    if emitNullForRet(fnIx) < 0 { return -1 }
    emitUnionRetSink(fnIx)
    fbUnreachable()
    fbEnd()
    return 0
  }
  return emitFail(
    "emitProgram: `as "
      + e.asTy
      + "` over a `"
      + e.asTy
      + " | null` propagates the null to the caller, and only the trapping and coalescing forms are lowered for that operand — write `as!`, `as?`, or the explicit `if x == null { return null }`",
  )
}

// The heap type of the nullable-ref niche operand `obj` whose payload is `payload`, the cell
// `br_on_non_null` hands back non-null: a string, a list wrapper, a record, a union variant, a map
// or a closure. -1 for a payload with no such cell.
function nulNicheHeapOf(obj: i32, payload: i32, fnIx: i32): i32 {
  if tyPrimNameOf(payload) == "string" { return sTy() }
  const wrap = nulCollWrapHeap(obj, fnIx)
  if wrap >= 0 { return wrap }
  const vi = nulVariantIdxOfExpr(obj, fnIx)
  if vi >= 0 && vi < uVarRow.length { return variantHeap(vi) }
  if exprNullableStruct(obj, fnIx) {
    const si = structIndexOfExpr(obj, fnIx)
    if si >= 0 && si < sHeapIdx.length { return sHeapIdx[si] }
  }
  if exprNulClosure(obj, fnIx) { return cloStructIdx }
  if exprNullableMap(obj, fnIx) {
    let ms = mapShapeOfExpr(obj, fnIx)
    if ms == -3 { ms = mapShapeOfTyPeeled(nodeTyAt(obj, fnIx)) }
    if ms != -3 { return mapTypeIdxOf(ms) }
  }
  return -1
}

// `m[k] as! V` over a scalar-boxed map read `amRef`: the fused probe, trapping on a missing
// key and reading the stored value otherwise. Returns 0 or -1.
function emitAsMapProbeTrap(amRef: Index, fnIx: i32) {
  if emitMapPrep(amRef.idxArr, amRef.idxIndex, fnIx) < 0 { return -1 }
  pushMapScr(5) // entry
  fbI32Eqz()
  fbIf(64) // void
  fbUnreachable()
  fbEnd()
  if cmSlot >= 0 {
    pushMapVals()
    fbStructGet(cmValsWrap(), 0)
    pushMapScr(5)
    fbI32Const(1)
    fbI32Bin(107) // i32.sub
    fbArrayGet(cmValsBack())
  } else {
    pushMapVals()
    fbStructGet(lTy(), 0)
    pushMapScr(5)
    fbI32Const(1)
    fbI32Bin(107)
    fbArrayGet(aTy())
  }
  return 0
}

// The `as?` arm of a union-operand cast, after the tag test is on the stack: the target
// value on a hit and its `null` on a miss, at the rep the arm (`subUnion`, `armVi`, `ak`,
// `mapHeap`) names for `T | null`. Returns 0, or -1 for an arm with no such rep.
function emitAsUnionOpt(
  subUnion: boolean,
  armVi: i32,
  ak: i32,
  mapHeap: i32,
  tgt: string,
) {
  // the boxed targets — a sub-union and a numeric value-atom arm — share one lowering:
  // a box already tagged with the wanted arm is a value of the target type, so hand
  // back the operand's own box, or a null box ref on the miss. Boolean is excluded —
  // `boolean | null` is the sentinel niche (`i32.const 2`), not a box.
  if (
    subUnion
    || armVi < 0 && (ak == 0 || ak == 3 || ak == 4 || ak == 5 || ak == 14)
  ) {
    fbIfRefNul(uBoxIdx, false) // if (result (ref $uBoxIdx))
    fbLocalGet(unionAsBoxSlot())
    fbElse()
    // the null-tagged box, what `T | null` means for a boxed union — a non-null box
    // carrying `nullBoxTag()`, not a null box ref: the rep the null test and
    // `emitUnionCoerce`'s `NullLit` both use, so a `!= null` on the result agrees.
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone() // the payload slot is unread under the null tag
    fbStructNew(uBoxIdx)
    fbEnd()
    return 0
  }
  // a map or list target's `M | null` is the nullable ref: the payload on the hit, a null.
  if mapHeap >= 0 {
    fbIfRefNul(mapHeap, true)
    fbLocalGet(unionAsBoxSlot())
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    fbRefCast(mapHeap)
    fbElse()
    fbRefNull(mapHeap)
    fbEnd()
    return 0
  }
  // a struct-variant target (`as? Circle`) is the `nulvariant` niche, a
  // `(ref null $variantHeap(vi))`: unbox and cast on the hit, a typed null on the miss.
  if armVi >= 0 {
    if armVi >= uVarRow.length {
      return emitFail(
        "emitProgram: `as? "
          + tgt
          + "` names a variant with no interned shape",
      )
    }
    fbIfRefNul(variantHeap(armVi), true)
    fbLocalGet(unionAsBoxSlot())
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    fbRefCast(variantHeap(armVi))
    fbElse()
    fbRefNull(variantHeap(armVi))
    fbEnd()
    return 0
  }
  // what is left is a value-atom arm: string is the nullable ref below; a numeric arm
  // is refused — `i32 | null` is a value-niche sentinel, a different lowering entirely.
  // boolean needs its own arm: `boolean | null` is the sentinel niche (i32 `2` for
  // null), so the block's result is a scalar where every other target's is a ref.
  if ak == 1 {
    fbIf(127) // 0x04 if, 0x7f i32 result blocktype
    fbLocalGet(unionAsBoxSlot())
    if emitUnionUnboxTail(ak) < 0 { return -1 }
    fbElse()
    fbI32Const(2) // the null sentinel
    fbEnd()
    return 0
  }
  // A function arm's `F | null` is the nullable closure ref: the payload on the hit, a null.
  if ak == 11 {
    fbIfRefNul(cloStructIdx, true)
    fbLocalGet(unionAsBoxSlot())
    if emitUnionUnboxTail(ak) < 0 { return -1 }
    fbElse()
    fbRefNull(cloStructIdx)
    fbEnd()
    return 0
  }
  if ak != 2 {
    return emitFail(
      "emitProgram: `as? "
        + tgt
        + "` is supported for a value-atom arm, a struct-variant arm and a sub-union; this arm is none of those — write the explicit `if x is "
        + tgt
        + " { … }` ladder for it",
    )
  }
  fbIfRefNul(sTy(), true) // if (result (ref null $sTypeIdx))
  fbLocalGet(unionAsBoxSlot())
  fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
  fbRefCast(sTy())
  fbElse()
  fbRefNull(sTy())
  fbEnd()
  return 0
}

// The cast of a union box to literal-union target `tty` (node `exprIx`): a hit is the base's tag
// with a payload equal to a member. The result is the base scalar, the atom id or the member
// string, as the node reps; a miss traps, returns the box, or is `null`, by mode. Returns 0 or -1.
function emitAsBoxToLitUnion(e: AsExpr, exprIx: i32, tty: i32, fnIx: i32) {
  let texts = tyNumLitMemberTexts(tty)
  let k = 2
  if texts.length > 0 {
    k = boxTagOfTy(numLitUnionBaseTy(tty))
  } else {
    texts = tyLitMemberTexts(tty)
  }
  if texts.length == 0 || k < 0 {
    return emitFail(
      "emitProgram: `as "
        + e.asTy
        + "` names a literal union with no members",
    )
  }
  const st = unionAsBoxSlot()
  if emitExprRaw(e.asObj, fnIx) < 0 { return -1 }
  fbLocalSet(st)
  fbLocalGet(st)
  fbStructGet(uBoxIdx, 0) // field 0: the tag
  fbI32Rel(RS_TAG, scalarTagOfKind(k))
  fbI32Bin(70)            // 0x46 i32.eq
  fbIf(127)               // the payload is read only under its own tag
  let i = 0
  while i < texts.length {
    fbLocalGet(st)
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    if emitUnionPayloadUnbox(k) < 0 { return -1 }
    if k == 2 {
      if emitStrEqLit(mkStr(quoteLex(texts[i]), -1), fnIx) < 0 { return -1 }
    } else {
      if emitNumLitConstEq(valueAtomNameOfKind(k), texts[i]) < 0 { return -1 }
    }
    if i > 0 {
      fbI32Bin(114) // 0x72 i32.or
    }
    i = i + 1
  }
  fbElse()
  fbI32Const(0)
  fbEnd()
  const atom = k == 2 && exprIsLitAtom(exprIx, fnIx)
  if e.asMode == "null" {
    if k == 2 && exprNulLitUnion(exprIx, fnIx) {
      fbIf(127)
      if emitStashedStrToAtomChain(st, texts, 0, fnIx) < 0 { return -1 }
      fbElse()
      fbI32Const(-1) // the atom niche's null
      fbEnd()
      return 0
    }
    return emitAsUnionOpt(false, -1, k, -1, e.asTy)
  }
  fbI32Eqz() // 0x45
  fbIf(64)   // if, void
  if e.asMode == "trap" {
    fbUnreachable()
  } else {
    fbLocalGet(st)
    fbReturn()
  }
  fbEnd()
  if atom { return emitStashedStrToAtomChain(st, texts, 0, fnIx) }
  fbLocalGet(st)
  return emitUnionUnboxTail(k)
}

// The union-operand cast of `e` (node `_exprIx`): a niche operand's null test, else the tag
// test of the box against the target's arms, then `as?`'s value-producing arm or the
// propagating (`as`) or trapping (`as!`) miss and the unbox. Returns 0 or -1.
function emitAsUnionCast(e: AsExpr, _exprIx: i32, fnIx: i32) {
  const obj = e.asObj
  const tgt = e.asTy
  // A niche-repped operand carries no tag, so none of the tag machinery below applies to
  // it: the arm test is the null test, and the whole trio shares one lowering.
  if !exprUnion(obj, fnIx) {
    const ol = emitAsOneListCast(e, _exprIx, fnIx)
    if ol != 0 { return if ol < 0 { -1 } else { 0 } }
    return emitAsNulNiche(e, fnIx)
  }
  // the target arm's type is the cast node's own recorded type, the checker's proof; for
  // `as?` the node's type is `T | null`, so it is peeled to recover `T` — without the peel
  // the tag and heap derive from the wrong type.
  let tty = nodeTyIxOf(_exprIx)
  if e.asMode == "null" { tty = tyPeelNul(tty) }
  // the target's arms, flattened rather than tested as `TyUnion`: a sub-union target
  // only widens the membership test (a tag chain), with no unbox at all.
  if mapSoftTwinTagFail(obj, tty, fnIx, _exprIx) < 0 { return -1 }
  if asExprBoxToLitUnion(_exprIx, fnIx) {
    // Outside the atom context, so each member compares as its string and not as its id.
    const rl = emitAsBoxToLitUnion(e, _exprIx, tty, fnIx)
    return rl
  }
  const lxr = emitAsListAcrossReps(e, tty, fnIx)
  if lxr != 0 { return if lxr < 0 { -1 } else { 0 } }
  const p = asUnionTagPlanOf(e, tty, fnIx)
  if p == null { return -1 }
  if emitExpr(obj, fnIx) < 0 { return -1 }
  return emitAsUnionTagTail(e, p)
}

// The tag test `emitAsUnionCast` writes for the cast of `e` to target arm type `tty`: the arms'
// tags and how the tail unboxes, or null once a refusal is raised.
function asUnionTagPlanOf(e: AsExpr, tty: i32, fnIx: i32): AsUnionTag | null {
  const obj = e.asObj
  const tgt = e.asTy
  const wantTags: i32[] = []
  const wantVis: i32[] = []
  const recvUt = unionTyOfRecv(nodeTyInOf(unwrapParen(obj), fnIx))
  const recvU = if recvUt >= 0 { unRowOfTyKey(recvUt) } else { -1 }
  if !unionArmTagsOfTy(tty, recvU, wantTags, wantVis) {
    emitFail(
      "emitProgram: `as "
        + tgt
        + "` is supported for a value-union arm or a struct-variant arm; this arm is neither — write the explicit `if x is "
        + tgt
        + " { … }` ladder for it",
    )
    return null
  }
  const subUnion = wantTags.length > 1
  let armVi = -1
  let ak = 0
  // A map arm's payload is its map struct ref, recovered by the heap cast its shape names.
  let mapHeap = -1
  if !subUnion {
    ak = boxTagOfTy(tty)
    armVi = wantVis[0]
    if armVi < 0 && ak < 0 && unMemIsMap(tty) {
      mapHeap = mapTypeIdxOf(mapShapeFoldSet(mapArmShapeOfTy(tty)))
    }
    // A list arm's payload is its list wrapper ref, recovered like a map's by one heap cast.
    if armVi < 0 && ak >= 0 { mapHeap = listWrapHeapOfKind(ak) }
    if armVi < 0 && ak < 0 && mapHeap < 0 && unMemIsRefElemArray(tty) {
      const rs = unMemRefArrArmSlot(tty)
      if rs >= 0 && rs < rlWrapIdx.length { mapHeap = rlWrapIdx[rs] }
    }
  }
  // `unionArmTagsOfTy` owns the empty-arm case, so what is left is a single arm the tag
  // reached but neither the variant table nor the atom kinds can name.
  if !subUnion && armVi < 0 && ak < 0 && mapHeap < 0 {
    emitFail(
      "emitProgram: `as " + tgt + "` names no union arm this cast can test",
    )
    return null
  }
  const p: AsUnionTag = {
    atTags: wantTags,
    atSub: subUnion,
    atVi: armVi,
    atK: ak,
    atHeap: mapHeap,
  }
  return p
}

// The tag test plan `p` names and the cast's tail, its union box operand on the stack.
function emitAsUnionTagTail(e: AsExpr, p: AsUnionTag) {
  const wantTags = p.atTags
  fbLocalSet(unionAsBoxSlot())
  // `tag == w0 || tag == w1 || …` — one compare for a single arm, a chain for a sub-union.
  // The tag is re-read per arm rather than stashed in a second i32 slot: it is a
  // `struct.get` off a local, two instructions, and costs no frame.
  let wi = 0
  while wi < wantTags.length {
    fbLocalGet(unionAsBoxSlot())
    fbStructGet(uBoxIdx, 0) // field 0: the tag
    fbI32Rel(RS_TAG, wantTags[wi])
    fbI32Bin(70)            // 0x46 i32.eq
    if wi > 0 {
      fbI32Bin(114) // 0x72 i32.or
    }
    wi = wi + 1
  }
  return emitAsUnionTail(e, p.atSub, p.atVi, p.atK, p.atHeap)
}

// A union-operand cast's tag-test arm: the plan `asUnionTagPlanOf` makes for cast `exprIx` in
// `fnIx`, then its test and tail, with its box operand already on the stack.
export function emitAsUnionTagged(exprIx: i32, fnIx: i32) {
  const e = nodeAt(exprIx)
  if !(e is AsExpr) { return -1 }
  const p = asUnionTagPlanOf(e, asUnionArmTyOf(exprIx), fnIx)
  if p == null { return -1 }
  return emitAsUnionTagTail(e, p)
}

// Why the union-operand cast `exprIx` in `fnIx` takes a lowering other than the tag test, or "":
// a niche operand, a map twin a numeric literal union reads as, a literal-union target, or a list
// target tested by its elements across reps.
export function asUnionTagWhy(exprIx: i32, fnIx: i32): string {
  const e = nodeAt(exprIx)
  if !(e is AsExpr) { return "no cast" }
  if !exprUnion(e.asObj, fnIx) { return "niche" }
  const tty = asUnionArmTyOf(exprIx)
  if mapSoftTwinClashOf(e.asObj, tty, fnIx) >= 0 { return "map twin" }
  if asExprBoxToLitUnion(exprIx, fnIx) { return "literal union" }
  if asListAcrossRepsOf(e, tty, fnIx, [], [], []) >= 0 {
    return "list across reps"
  }
  return ""
}

// The target arm type of cast `exprIx`: the cast's own recorded type, the checker's proof, with
// `as?`'s `| null` peeled.
function asUnionArmTyOf(exprIx: i32): i32 {
  const e = nodeAt(exprIx)
  const t = nodeTyIxOf(exprIx)
  return if e is AsExpr && e.asMode == "null" { tyPeelNul(t) } else { t }
}

// The tag test of a union-operand cast: the target arms' tags, whether the target is a sub-union
// (the box itself), and the single arm's variant row, value kind or payload heap (-1 for none).
type AsUnionTag = {
  atTags: i32[],
  atSub: boolean,
  atVi: i32,
  atK: i32,
  atHeap: i32,
}

// The operand and target of the cast `e` (at `exprIx`) over a union of lists stored as its one
// list (`emitAsOneListCast`): its nullability, its non-null type, the target arm, the arm's list
// wrapper heap and the list's rep; null when the cast is not that shape.
function asOneListOf(e: AsExpr, exprIx: i32, fnIx: i32): AsOneList | null {
  const obj = e.asObj
  const nullable = nodeTyIsNullable(obj)
  const oty0 = nodeTyAt(unwrapParen(obj), fnIx)
  const oty = if nullable { nonNullTy(oty0) } else { oty0 }
  if oneListUnionRender(oty) == "" { return null }
  const tty = if e.asMode == "null" { tyPeelNul(nodeTyIxOf(exprIx)) } else { nodeTyIxOf(exprIx) }
  const heap = listArmHeapOf(tty)
  const rep = exprListRep(obj, fnIx)
  if (
    heap < 0
    || rep != "list" && rep != "i64list" && rep != "strlist" && rep != "reflist"
  ) {
    return null
  }
  const ol: AsOneList = {
    olNullable: nullable,
    olOty: oty,
    olTty: tty,
    olHeap: heap,
    olRep: rep,
  }
  return ol
}

type AsOneList = {
  olNullable: boolean,
  olOty: i32,
  olTty: i32,
  olHeap: i32,
  olRep: VKind | null,
}

// Why the cast `exprIx` over a niche operand in `fnIx` takes a lowering other than the operand
// itself (`as?`) or its `ref.as_non_null` (`as!`), or "": a union of lists stored as one list, or
// the propagating `as`, whose operand is written inside the block it leaves.
export function asNicheCastWhy(exprIx: i32, fnIx: i32): string {
  const e = nodeAt(exprIx)
  if !(e is AsExpr) { return "no cast" }
  if asOneListOf(e, exprIx, fnIx) != null { return "one list" }
  if e.asMode == "prop" { return "propagate" }
  return ""
}

// The cast of `e` over a union of lists stored as its one list (`oneListUnionRender`), which
// has no tag: the whole list always fits, and a narrower target fits when every element does,
// by `is`'s own element test. 0 when the cast is not that shape, 1 when emitted, -1 on failure.
function emitAsOneListCast(e: AsExpr, exprIx: i32, fnIx: i32): i32 {
  const obj = e.asObj
  const ol = asOneListOf(e, exprIx, fnIx)
  if ol == null { return 0 }
  const nullable = ol.olNullable
  const oty = ol.olOty
  const tty = ol.olTty
  const heap = ol.olHeap
  const rep = ol.olRep
  if emitExpr(obj, fnIx) < 0 { return -1 }
  if isWholeOfOneListUnion(oty, tty) && !nullable { return 1 }
  const key = if rep == "reflist" { refListSlotOfExpr(obj, fnIx) } else { 0 }
  const lk: ListKind = if rep == "list" { "list" } else if rep == "i64list" { "i64list" } else if rep == "strlist" { "strlist" } else { "reflist" }
  const st = scratchSlot(46, lk, key, SCRATCH_BY_BOTH)
  fbLocalSet(st)
  // The whole list fits whenever the operand is a list; a nullable one misses on null.
  let fit = 1
  if isWholeOfOneListUnion(oty, tty) {
    fbLocalGet(st)
    fbRefIsNull()
    fbI32Eqz()
  } else {
    fit = emitListFitAt(obj, tty, exprIx, st, fnIx)
  }
  if fit < 0 { return -1 }
  if fit == 0 {
    return emitFailAt(
      "emitProgram: `as "
        + e.asTy
        + "` over a union of lists stored as one list tests its elements, and this target has no element test",
      exprIx,
    )
  }
  if e.asMode == "null" {
    fbIfRefNul(heap, true)
    fbLocalGet(st)
    fbElse()
    fbRefNull(heap)
    fbEnd()
    return 1
  }
  fbI32Eqz()
  fbIf(64)
  if e.asMode == "trap" {
    fbUnreachable()
  } else {
    fbLocalGet(st)
    if !nullable { fbRefAsNonNull() }
    fbReturn()
  }
  fbEnd()
  fbLocalGet(st)
  fbRefAsNonNull()
  return 1
}

// Whether the cast of `e` to list type `tty` is `emitAsListAcrossReps`'s shape: the heap of `tty`'s
// wrapper, with the arms' tags, fits and slots filled in, or -1 when it is not.
function asListAcrossRepsOf(
  e: AsExpr,
  tty: i32,
  fnIx: i32,
  tags: i32[],
  fits: i32[],
  slotsAt: i32[][],
): i32 {
  if nodeTyIsNullable(e.asObj) { return -1 }
  if !listIsAcrossRepsPlan(e.asObj, tty, fnIx, tags, fits, slotsAt) {
    return -1
  }
  const heap = listArmHeapOf(tty)
  if heap < 0 { return -1 }
  const arms: i32[] = []
  if !unionTyMemberTys(unionBoxTyOfRead(e.asObj, fnIx), arms) { return -1 }
  for a in arms {
    if (
      tyArrayElemIx(a) >= 0
      && listIsArmTag(a) >= 0
      && listArmHeapOf(a) != heap
    ) {
      let i = 0
      while i < tags.length && tags[i] != listIsArmTag(a) { i = i + 1 }
      if i < tags.length { return -1 }
    }
  }
  return heap
}

// The cast of `e` to list type `tty` over a box whose list arms `emitListIsAcrossReps` tests by
// their elements: that test, then the unbox at `tty`'s wrapper, which every tested arm shares
// (D14042). 0 when the cast is not that shape, 1 when emitted, -1 on failure.
function emitAsListAcrossReps(e: AsExpr, tty: i32, fnIx: i32): i32 {
  const tags: i32[] = []
  const fits: i32[] = []
  const slotsAt: i32[][] = []
  const heap = asListAcrossRepsOf(e, tty, fnIx, tags, fits, slotsAt)
  if heap < 0 { return 0 }
  if emitExpr(e.asObj, fnIx) < 0 { return -1 }
  fbLocalSet(unionAsBoxSlot())
  const r = emitListIsAcrossRepsAt(
    unionAsBoxSlot(),
    tty,
    tags,
    fits,
    slotsAt,
    fnIx,
  )
  if r < 0 { return -1 }
  if emitAsUnionTail(e, false, -1, -1, heap) < 0 { return -1 }
  return 1
}

// The heap of list type `ty`'s wrapper in a union box, or -1 when it has none.
function listArmHeapOf(ty: i32): i32 {
  const k = boxTagOfTy(ty)
  if k >= 0 {
    const h = listWrapHeapOfKind(k)
    return if h > 0 { h } else { -1 }
  }
  if !unMemIsRefElemArray(ty) { return -1 }
  const rs = unMemRefArrArmSlot(ty)
  return if rs >= 0 && rs < rlWrapIdx.length { rlWrapIdx[rs] } else { -1 }
}

// A union-operand cast after its arm test is on the stack: `as?`'s value or `null`, or `as`'s
// propagated and `as!`'s trapping miss, then the unbox at the arm `subUnion`, `armVi`, `ak` and
// `mapHeap` name. Returns 0 or -1.
function emitAsUnionTail(
  e: AsExpr,
  subUnion: boolean,
  armVi: i32,
  ak: i32,
  mapHeap: i32,
) {
  const tgt = e.asTy
  // `as?` yields a value on both paths (a value-producing `if`, not the early exit `as`/
  // `as!` take): `T` when the tag matches, `null` when it does not. Supported only where
  // `T | null` already has a rep — `Circle | null` over a union arm has none yet
  // (`emitProgram: ref valtype with no interned shape`), refused here by naming the gap.
  if e.asMode == "null" {
    return emitAsUnionOpt(subUnion, armVi, ak, mapHeap, tgt)
  }
  fbI32Eqz() // 0x45
  fbIf(64)   // if, void
  // the sad path, and the only place `as` and `as!` differ: `as` hands the whole box to
  // the caller, `as!` traps and needs no value at all.
  if e.asMode == "trap" {
    fbUnreachable()
  } else {
    fbLocalGet(unionAsBoxSlot())
    fbReturn()
  }
  fbEnd()
  fbLocalGet(unionAsBoxSlot())
  // a sub-union result is the box itself, at a narrower type — nothing to unbox.
  if subUnion { return 0 }
  // a struct arm's payload is the variant struct — recover it with the variant heap
  // cast, exactly as the shared-field dispatch does; a value atom takes the shared tail.
  if armVi >= 0 {
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    fbRefCast(variantHeap(armVi))
    return 0
  }
  if mapHeap >= 0 {
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    fbRefCast(mapHeap)
    return 0
  }
  return emitUnionUnboxTail(ak)
}

// The `as` trio from a literal-union atom to a registered literal union: the id is staged once
// and compared against each target member's; a miss traps, is handed back by `return`, or is the
// `-1` null sentinel, by mode (D5286).
function emitAsLitAtom(e: AsExpr, exprIx: i32, fnIx: i32) {
  let tty = nodeTyIxOf(exprIx)
  if e.asMode == "null" { tty = tyPeelNul(tty) }
  const texts = tyLitMemberTexts(tty)
  // A propagated miss leaves as the id into a literal-union result, or as its member text
  // into a `string` one.
  const retAtom = e.asMode == "prop" && fnReturnsLitAtom(fnIx)
  const missTexts = tyLitMemberTexts(nodeTyIxOf(e.asObj))
  if e.asMode == "prop" && !retAtom {
    const fd = nodeAt(fnIx)
    let retStr = false
    if fd is FuncDecl { retStr = fd.fnRet >= 0 && nodeTyIsStringPrim(fd.fnRet) }
    if !retStr || missTexts.length == 0 {
      return emitFail(
        "emitProgram: `as "
          + e.asTy
          + "` over a literal-union atom propagates its miss, and this function returns neither a literal union nor a string — write `as!` or `as?`",
      )
    }
  }
  if emitExpr(e.asObj, fnIx) < 0 { return -1 }
  const s = litAtomCastSlot()
  fbLocalSet(s)
  // A lone literal target (`as! "a"`) yields that literal's string, not the id (D5289).
  const strOut = !asExprLitAtomYieldsAtom(exprIx, fnIx)
  if e.asMode == "null" && !strOut {
    fbLocalGet(s)
    fbI32Const(-1)
  }
  let i = 0
  while i < texts.length {
    fbLocalGet(s)
    fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
    fbI32Bin(70) // 0x46 i32.eq
    if i > 0 {
      fbI32Bin(114) // 0x72 i32.or
    }
    i = i + 1
  }
  if e.asMode == "null" && strOut {
    fbIfRefNul(sTy(), true)
    if emitStr(mkStr(quoteLex(texts[0]), -1), -1) < 0 { return -1 }
    fbElse()
    fbRefNull(sTy())
    fbEnd()
    return 0
  }
  if e.asMode == "null" {
    fbSelect() // the id on a hit, the sentinel on a miss
    return 0
  }
  fbI32Eqz()
  fbIf(64)
  if e.asMode == "trap" {
    fbUnreachable()
  } else if retAtom {
    fbLocalGet(s)
    fbReturn()
  } else {
    if emitAtomToStrChain(missTexts, 0, s) < 0 { return -1 }
    fbReturn()
  }
  fbEnd()
  if strOut { return emitStr(mkStr(quoteLex(texts[0]), -1), -1) }
  fbLocalGet(s)
  return 0
}

// The `as` trio from a numeric literal-union scalar to a numeric literal union of its base: the
// scalar is staged once and compared against each target member. A hit is the scalar, or for `as?`
// the base-tagged box; a miss traps, is handed back by `return`, or is the null box (D11221).
function emitAsNumLitScalar(e: AsExpr, exprIx: i32, fnIx: i32) {
  let tty = nodeTyIxOf(exprIx)
  if e.asMode == "null" { tty = tyPeelNul(tty) }
  const base = numLitUnionBaseTy(tty)
  const texts = tyNumLitMemberTexts(tty)
  const k = boxTagOfTy(base)
  if texts.length == 0 || (k != 0 && k != 3) {
    return emitFail(
      "emitProgram: `as "
        + e.asTy
        + "` names a literal union with no members",
    )
  }
  let sk: ListKind = "list"
  if k == 3 { sk = "i64list" }
  // A propagated miss leaves at the result's rep: the scalar itself, or boxed under its base's tag.
  let retBox = false
  if e.asMode == "prop" {
    let rk = ""
    if fnIx >= 0 && fnIx < P.nodes.length {
      const fd = nodeAt(fnIx)
      if fd is FuncDecl {
        if fd.fnRet >= 0 {
          rk = vtKindOfType(fd.fnRet)
        } else {
          const fp = fnStmtsPosOf(fnIx)
          if fp >= 0 && fp < fRetKind.length { rk = fRetKind[fp] }
        }
      }
    }
    retBox = rk == "union"
    if !retBox && rk != listKindElemKind(sk) {
      return emitFail(
        "emitProgram: `as "
          + e.asTy
          + "` over a numeric literal union propagates its miss, and this function returns neither that number type nor a union — write `as!` or `as?`",
      )
    }
  }
  if emitExpr(e.asObj, fnIx) < 0 { return -1 }
  const s = numLitCastSlot(sk)
  fbLocalSet(s)
  let i = 0
  while i < texts.length {
    fbLocalGet(s)
    if emitNumLitConstEq(valueAtomNameOfKind(k), texts[i]) < 0 { return -1 }
    if i > 0 {
      fbI32Bin(114) // 0x72 i32.or
    }
    i = i + 1
  }
  if e.asMode == "null" {
    const vb = vbHeapIdxOfKind(k)
    if vb < 0 {
      return emitFail("emitProgram: `as? " + e.asTy + "` has no value-box type")
    }
    fbOpenIf()             // 0x04 if
    fbValtype("union", -1) // result blocktype: the union box `(ref $uBox)`
    fbI32Rel(RS_TAG, scalarTagOfKind(k))
    fbLocalGet(s)
    fbStructNew(vb)
    fbStructNew(uBoxIdx)
    fbElse()
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone()        // the payload slot is unread under the null tag
    fbStructNew(uBoxIdx)
    fbEnd()
    return 0
  }
  fbI32Eqz()
  fbIf(64) // if, void
  if e.asMode == "trap" {
    fbUnreachable()
  } else if retBox {
    fbI32Rel(RS_TAG, scalarTagOfKind(k))
    fbLocalGet(s)
    fbStructNew(vbHeapIdxOfKind(k))
    fbStructNew(uBoxIdx)
    fbReturn()
  } else {
    fbLocalGet(s)
    fbReturn()
  }
  fbEnd()
  fbLocalGet(s)
  return 0
}

// The arm `emitAsCast` takes for the cast at `exprIx`, decided once for legacy and the IR (whose
// numeric arms are `plain`, `wrap` and `exact`).
export type AsCastArm = "zextLoad"
  | "v128"
  | "wrap"
  | "instMiss"
  | "litAtom"
  | "numLitScalar"
  | "numUnion"
  | "mapProbeTrap"
  | "mapOptBox"
  | "mapOptRead"
  | "holeMiss"
  | "holeExact"
  | "holeOpt"
  | "exact"
  | "union"
  | "plain"
  | "notCast"

// An unsigned narrow load widened to i64 is the zero-extending i64 load (`zextLoadOf`). A `new
// v128` brand cast re-brands the same 128 bits; a boxed `v128 | null` or union operand takes the
// union arm. A union operand's `as` propagates (`error-handling-design.md` §Trio), and a numeric
// exact-or-fail (D1041) is checked ahead of it and disjoint from it by operand.
export function asCastArmOf(exprIx: i32, fnIx: i32): AsCastArm {
  const e = nodeAt(exprIx)
  if !(e is AsExpr) { return "notCast" }
  const obj = e.asObj
  if e.asTy == "i64" && zextLoadOf(exprIx, fnIx) >= 0 { return "zextLoad" }
  if e.asTy == "v128" && !exprUnion(obj, fnIx) { return "v128" }
  if e.asMode == "wrap" { return "wrap" }
  // A cast this instance's operand can never hit misses, as the instance's re-check found.
  if asInstMisses(asCastRoot(exprIx), elabKeyAt(fnIx)) { return "instMiss" }
  if asExprLitAtomCast(exprIx, fnIx) { return "litAtom" }
  if asExprNumLitScalarCast(exprIx, fnIx) { return "numLitScalar" }
  // A numeric union converts at whichever member it holds when no member's conversion fails.
  if numUnionMinted && nodeIsNumUnion(obj, fnIx) {
    const nuTo = njKindOfTy(nodeTyIxOf(exprIx))
    if nuTo >= 0 && njAsConverts(njMembersOf(obj, fnIx), nuTo) {
      return "numUnion"
    }
  }
  // `m[k] as! V` fuses the map probe; `m[k] as? V` over a scalar map's `V | null` read is the
  // read itself, boxed as a consumed read is (D2467), and a niche-bearing read carries its null.
  const ref = nodeAt(unwrapParen(obj))
  if (
    e.asMode == "trap"
    && mapReadScalarBoxKindIn(obj, fnIx) >= 0
    && ref is Index
  ) {
    return "mapProbeTrap"
  }
  if (
    e.asMode == "null"
    && ref is Index
    && exprMap(ref.idxArr, fnIx)
    && tySame(nodeTyAt(exprIx, fnIx), nodeTyAt(obj, fnIx))
  ) {
    if mapReadScalarBoxKindIn(obj, fnIx) >= 0 { return "mapOptBox" }
    return "mapOptRead"
  }
  // A type-parameter operand fails as the direct spelling does at this instance's pin (D2791).
  if asExprHoleNumSad(exprIx) && !asExprIsUnionCastIn(exprIx, fnIx) {
    const hps = asExprHolePinSrc(exprIx, fnIx)
    if hps == "-" { return "holeMiss" }
    if hps != "" { return "holeExact" }
  }
  if asExprHoleNumOpt(exprIx) && !asExprIsUnionCastIn(exprIx, fnIx) {
    return "holeOpt"
  }
  if asExprNumFallible(exprIx) { return "exact" }
  if asExprIsUnionCastIn(exprIx, fnIx) { return "union" }
  return "plain"
}

function emitAsCast(e: AsExpr, exprIx: i32, fnIx: i32) {
  const obj = e.asObj
  const ref = nodeAt(unwrapParen(obj))
  return match asCastArmOf(exprIx, fnIx) {
    "zextLoad" => emitZextLoad(zextLoadOf(exprIx, fnIx), fnIx)
    "v128" => emitExpr(obj, fnIx)
    "wrap" => emitNumWrapCast(e, exprIx, fnIx)
    "instMiss" => emitAsInstMiss(e, exprIx, fnIx)
    "litAtom" => emitAsLitAtom(e, exprIx, fnIx)
    "numLitScalar" => emitAsNumLitScalar(e, exprIx, fnIx)
    "numUnion" => emitNumUnionConvert(obj, njKindOfTy(nodeTyIxOf(exprIx)), fnIx)
    "mapProbeTrap" => if ref is Index { emitAsMapProbeTrap(ref, fnIx) } else { -1 }
    "mapOptBox" => if ref is Index { emitMapGetScalarBox(
      ref.idxArr,
      ref.idxIndex,
      mapReadScalarBoxKindIn(obj, fnIx),
      fnIx,
    ) } else { -1 }
    "mapOptRead" => emitExpr(obj, fnIx)
    "holeMiss" => emitHoleNumCastMiss(e, exprIx, fnIx)
    "holeExact" => emitNumExactCastFrom(e, exprIx, asExprHolePinSrc(exprIx, fnIx), fnIx)
    "holeOpt" => emitHoleNumAsOpt(e, exprIx, fnIx)
    "exact" => emitNumExactCast(e, exprIx, fnIx)
    "union" => emitAsUnionCast(e, exprIx, fnIx)
    "plain" => emitNumPlainCast(obj, e.asTy, fnIx)
    "notCast" => emitFail("emitProgram: a cast's arm was asked of a node that is no cast")
  }
}

// The source rep of numeric operand `obj` as this instance emits it: f32 first, since
// `exprIsF64` over-claims an f32 literal.
export function numCastSrcRepOf(obj: i32, fnIx: i32): string {
  if exprIsF32(obj, fnIx) { return "f32" }
  if exprIsI64(obj, fnIx) { return "i64" }
  if exprIsF64(obj, fnIx) { return "f64" }
  return "i32"
}

// `u as? N` over a type-parameter operand pinned at a number or a `boolean`: `N | null` at every
// pin (D2754), so a cast that cannot fail at this pin still boxes its value, and one that can
// takes the exact-or-fail box.
function emitHoleNumAsOpt(e: AsExpr, exprIx: i32, fnIx: i32) {
  const tgt = asExprNumTgtName(exprIx)
  const nck = asExprNumTgtKind(exprIx)
  const nvb = vbHeapIdxOfKind(nck)
  if nvb < 0 || !uDeclared {
    return emitFail(
      "emitProgram: `as? "
        + tgt
        + "` has no value box — the `"
        + tgt
        + " | null` row was never registered",
    )
  }
  // The instance's exact pin decides: a number converts, any other type is never the target.
  // A hole's operand, a capture's included, reads the instance's elaboration (D3654).
  let ext = instanceOperandTyOf(e.asObj, fnIx)
  // A gradual union's operand the instance re-typed at a scalar carries that scalar itself.
  if ext < 0 && (monoGradualAsScalar.get(exprIx) ?? false) {
    ext = nodeTyIxOf(e.asObj)
  }
  if ext < 0 {
    return emitFail(
      "emitProgram: `as? "
        + tgt
        + "` over a type parameter needs the instance's exact pin",
    )
  }
  const src = primNameStr(primNameOf(ext))
  const srcNum = src == "i32" || src == "i64" || src == "f32" || src == "f64"
  if !srcNum && src != "boolean" {
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone()
    fbStructNew(uBoxIdx)
    return 0
  }
  if numCastCanFail(src, asExprNumCastDomain(exprIx)) {
    return emitNumExactCastFrom(e, exprIx, src, fnIx)
  }
  fbI32Rel(RS_TAG, scalarTagOfKind(nck))
  if emitNumPlainCast(e.asObj, tgt, fnIx) < 0 { return -1 }
  fbStructNew(nvb)
  fbStructNew(uBoxIdx)
  return 0
}

// The value kind the cast at `exprIx` builds its operand at, where its arm is an operand and a
// tail (`numCastTail`): the plain conversion, the wrap that is neither a literal fold nor a
// narrowed mask, and `as!`. -1 for every other arm, which writes its operand its own way.
export function numCastKindOf(exprIx: i32, fnIx: i32): i32 {
  const e = nodeAt(exprIx)
  if !(e is AsExpr) { return -1 }
  return match asCastArmOf(exprIx, fnIx) {
    "plain" => numPlainCastKind(numCastSrcRepOf(e.asObj, fnIx), e.asTy)
    "wrap" => if asWrapArmOf(exprIx, fnIx) == "plain" { numWrapCastKind(exprIx, fnIx) } else { -1 }
    "exact" => if e.asMode == "trap" { numExactCastKind(asExprNumSrcName(exprIx)) } else { -1 }
    "zextLoad" | "v128" | "instMiss" | "litAtom" | "numLitScalar" | "numUnion" => -1
    "mapProbeTrap" | "mapOptBox" | "mapOptRead" | "holeMiss" | "holeExact" | "holeOpt" => -1
    "union" | "notCast" => -1
  }
}

// The primitive type of value kind `k` (3 i64, 4 f64, 5 f32) that `numCastKindOf` builds an
// operand at, or -1 for any other kind (0 is the operand as itself).
export function numCastKindTy(k: i32): i32 {
  if k == 3 { return TY_I64 }
  if k == 4 { return TY_F64 }
  if k == 5 { return TY_F32 }
  return -1
}

// After `numCastKindOf`'s operand: the cast's tail, for an arm that kind answers.
export function numCastTail(exprIx: i32, fnIx: i32): i32 {
  const e = nodeAt(exprIx)
  if !(e is AsExpr) || numCastKindOf(exprIx, fnIx) < 0 {
    return numCastNoTail()
  }
  return match asCastArmOf(exprIx, fnIx) {
    "plain" => numPlainCastTail(numCastSrcRepOf(e.asObj, fnIx), e.asTy)
    "wrap" => numWrapCastTail(exprIx, fnIx)
    "exact" => numExactCastTail(exprIx, asExprNumSrcName(exprIx), fnIx)
    "zextLoad" | "v128" | "instMiss" | "litAtom" | "numLitScalar" | "numUnion" => numCastNoTail()
    "mapProbeTrap" | "mapOptBox" | "mapOptRead" | "holeMiss" | "holeExact" | "holeOpt" => numCastNoTail()
    "union" | "notCast" => numCastNoTail()
  }
}

function numCastNoTail() {
  return emitFail(
    "emitProgram: a numeric cast's tail has no operand-and-tail arm",
  )
}

// The numeric `x as T` lowering: the operand goes out at `numPlainCastKind` through the
// `emitExprAs*` helpers, then `numPlainCastTail`'s one conversion opcode for the pair (float to
// int traps rather than wraps). `src` is `numCastSrcRepOf`'s.
function emitNumPlainCast(obj: i32, tgt: string, fnIx: i32) {
  const src = numCastSrcRepOf(obj, fnIx)
  if emitExprAsKind(obj, numPlainCastKind(src, tgt), fnIx) < 0 { return -1 }
  return numPlainCastTail(src, tgt)
}

// The value kind `emitNumPlainCast` builds a `src` operand at for target `tgt` (0 as itself, 3
// i64, 4 f64, 5 f32): the target's own kind where the helper widens to it, else the source's.
export function numPlainCastKind(src: string, tgt: string): i32 {
  if tgt == "f64" { return 4 }
  const own = numPlainSrcKind(src)
  if tgt == "i64" { return if own == 0 { 3 } else { own } }
  if tgt == "f32" { return if own == 0 { 5 } else { own } }
  return own
}

// A plain cast's source at its own kind: 0 for an i32, built as itself.
function numPlainSrcKind(src: string): i32 {
  if src == "i32" { return 0 }
  if src == "i64" { return 3 }
  if src == "f32" { return 5 }
  if src == "f64" { return 4 }
  return numCastSrcFail(src)
}

// After `numPlainCastKind`'s operand: the conversion from it to `tgt`, any non-float, non-i64
// target being i32. Nothing where the widening helper already reached the target.
export function numPlainCastTail(src: string, tgt: string): i32 {
  if tgt == "f64" { return 0 }
  if tgt == "i64" {
    if src == "f32" { fbI64TruncF32S() }
    else if src == "f64" { fbI64TruncF64S() }
    return 0
  }
  if tgt == "f32" {
    if src == "i64" { fbF32ConvertI64S() }
    else if src == "f64" { fbF32DemoteF64() }
    return 0
  }
  if src == "i64" { fbI32WrapI64() }
  else if src == "f32" { fbI32TruncF32S() }
  else if src == "f64" { fbI32TruncF64S() }
  return 0
}

// ── linear-memory opcodes: the load-width matrix + memory.size/grow ──────────
// The instruction bytes for `buffer-design.md` §C2's load matrix, beside their dispatch.
const OP_I64_LOAD = 0x29
const OP_F32_LOAD = 0x2a
const OP_F64_LOAD = 0x2b
const OP_I32_LOAD8_S = 0x2c
const OP_I32_LOAD8_U = 0x2d
const OP_I32_LOAD16_S = 0x2e
const OP_I32_LOAD16_U = 0x2f
const OP_I64_LOAD8_U = 0x31
const OP_I64_LOAD16_U = 0x33
const OP_I64_LOAD32_U = 0x35
const OP_I64_STORE = 0x37
const OP_F32_STORE = 0x38
const OP_F64_STORE = 0x39
const OP_I32_STORE8 = 0x3a
const OP_I32_STORE16 = 0x3b
const OP_MEMORY_SIZE = 0x3f
const OP_MEMORY_GROW = 0x40

// The misc prefix (0xfc) and the two bulk-memory sub-opcodes behind it — every other
// prefixed instruction here uses 0xfb, the GC prefix, instead. The sub-opcode is a u32
// LEB immediate, not a byte; 10/11 happen to fit one byte today (below 128), which is
// why plain `wU8` still works here.
const OP_MISC_PREFIX = 0xfc
const MISC_MEMORY_COPY = 10
const MISC_MEMORY_FILL = 11

// The opcode byte for load width `name`, or -1 for a name that is not one. Paired with
// `memLoadAlignExp` below — the two are read together at the single call site.
function memLoadOpcode(name: string) {
  if name == "__load_i8__" { return OP_I32_LOAD8_S }
  if name == "__load_u8__" { return OP_I32_LOAD8_U }
  if name == "__load_i16__" { return OP_I32_LOAD16_S }
  if name == "__load_u16__" { return OP_I32_LOAD16_U }
  if name == "__load_i64__" { return OP_I64_LOAD }
  if name == "__load_f32__" { return OP_F32_LOAD }
  if name == "__load_f64__" { return OP_F64_LOAD }
  if name == "__load_u8_i64__" { return OP_I64_LOAD8_U }
  if name == "__load_u16_i64__" { return OP_I64_LOAD16_U }
  if name == "__load_u32_i64__" { return OP_I64_LOAD32_U }
  return -1
}

// The natural alignment exponent for load width `name`: log2 of the access width in
// bytes. It is a hint the wasm spec never enforces — a mismatched access still runs,
// just without the engine's fast path — and `__load_i32__`'s exponent 2 has always read
// correctly at odd addresses, a property these widths inherit; the corpus pins it per width.
function memLoadAlignExp(name: string) {
  if name == "__load_i8__" { return 0 }
  if name == "__load_u8__" { return 0 }
  if name == "__load_i16__" { return 1 }
  if name == "__load_u16__" { return 1 }
  if name == "__load_i64__" { return 3 }
  if name == "__load_f32__" { return 2 }
  if name == "__load_f64__" { return 3 }
  if name == "__load_u8_i64__" { return 0 }
  if name == "__load_u16_i64__" { return 1 }
  if name == "__load_u32_i64__" { return 2 }
  return -1
}

// One memarg-carrying memory instruction: `<opcode> <align-exp> <offset>`, the offset a u32
// LEB (`emitMemAddr` answers it, carried as its i32 bit pattern). Loads and stores share this
// encoding exactly; they differ only in their stack effect, which the caller has arranged.
function fbMemAccess(op: i32, alignExp: i32, off: i64) {
  wU8(op)
  wU8(alignExp)
  wULEB(off as% i32)
  return 0
}
const OP_I32_LOAD = 0x28
const OP_I32_STORE = 0x36

// The opcode byte for store width `name`, or -1 otherwise. The wide trio duals
// `memLoadOpcode`'s; the narrow pair collapses its four narrow loads — `i32.store8` is
// the one instruction both `i32.load8_s` and `i32.load8_u` read back, since a store has
// no signedness. All five share the memarg encoding a load uses.
function memStoreOpcode(name: string) {
  if name == "__store_i64__" { return OP_I64_STORE }
  if name == "__store_f32__" { return OP_F32_STORE }
  if name == "__store_f64__" { return OP_F64_STORE }
  if name == "__store_i8__" { return OP_I32_STORE8 }
  if name == "__store_i16__" { return OP_I32_STORE16 }
  return -1
}

// The NATURAL alignment exponent for store width `name` — log2 of the access width in bytes,
// the same hint-not-constraint immediate `memLoadAlignExp` documents. i64 and f64 write eight
// bytes (exponent 3); f32 writes four (2), matching `__store_i32__`'s long-standing 2; the
// narrow pair write one byte (0) and two (1), matching their load twins.
function memStoreAlignExp(name: string) {
  if name == "__store_i64__" { return 3 }
  if name == "__store_f32__" { return 2 }
  if name == "__store_f64__" { return 3 }
  if name == "__store_i8__" { return 0 }
  if name == "__store_i16__" { return 1 }
  return -1
}

// The two narrow store widths, whose value operand is an i32 rather than the declared
// wide scalar the other three take. Split out so the dispatch is a total two-way choice,
// not an `else` that silently means f64 for a name added to `nameIsMemStoreIntrinsic`
// and forgotten here — that shape builds an f64 operand under an i32 opcode.
function memStoreValueIsI32(name: string) {
  if name == "__store_i8__" { return true }
  if name == "__store_i16__" { return true }
  return false
}

// One bulk-memory instruction: the 0xfc prefix, the sub-opcode, then one memory index
// per memory it names (`memory.fill` one, `memory.copy` two: destination then source) —
// both 0, since VL emits a single memory. `n` is unsigned in both, so a negative VL
// length is ~4 GiB and traps in the engine, not the checker.
function fbMemBulk(sub: i32, memIndexCount: i32) {
  wU8(OP_MISC_PREFIX) // 0xfc misc prefix
  wU8(sub)            // the sub-opcode (a u32 LEB; 10 and 11 are one byte each)
  let mi = 0
  while mi < memIndexCount {
    wU8(0) // memory index 0
    mi = mi + 1
  }
  return 0
}

// `memory.size` → 0x3f 0x00 and `memory.grow` → 0x40 0x00. The trailing byte is the
// memory INDEX immediate, not a flags byte: there is one memory, so it is 0.
function fbMemorySize() {
  wU8(OP_MEMORY_SIZE)
  wU8(0) // memory index 0
  return 0
}
function fbMemoryGrow() {
  wU8(OP_MEMORY_GROW)
  wU8(0) // memory index 0
  return 0
}

// ── SIMD (0xFD prefix): the third prefixed family (simd-design.md §D6/A3) ────
// Unlike the 0xfc misc prefix, a SIMD sub-opcode is a REAL u32 LEB — `f32x4.add` is 228 and
// encodes as two bytes — so `wULEB` is required, never `wU8`. Verify each sub-opcode with a
// `wasm-dis --enable-simd` round-trip of the emitted bytes.
const OP_SIMD_PREFIX = 0xfd
const SIMD_I8X16_SHUFFLE = 0x0d

// One SIMD instruction with no trailing immediate (`f32x4.splat`, `f32x4.add`): the prefix,
// then the uLEB sub-opcode. The stack effect the caller has already arranged.
function fbSimdOp(sub: i32) {
  wU8(OP_SIMD_PREFIX)
  wULEB(sub)
  return 0
}
// A memarg-carrying SIMD load/store (`v128.load`/`v128.store`): `0xFD <sub> <align-exp>
// <offset>`. Align 0 — unaligned (O5), so a vector reads/writes at ANY `Buf` offset.
function fbSimdMem(sub: i32, off: i64) {
  wU8(OP_SIMD_PREFIX)
  wULEB(sub)
  wU8(0) // align exponent 0 (unaligned — a hint the spec never enforces)
  wULEB(off as% i32)
  return 0
}
// A lane-immediate SIMD instruction (`f32x4.extract_lane`): `0xFD <sub> <lane byte>`. The lane
// is a single immediate byte; the checker refused anything but a 0..3 literal (O3).
function fbSimdLane(sub: i32, lane: i32) {
  wU8(OP_SIMD_PREFIX)
  wULEB(sub)
  wU8(lane)
  return 0
}
// ── numeric-opcode intrinsics ────────────────────────────────────────────────
// The IEEE bitcasts. A bitcast moves no bits: the same 32/64-bit pattern is simply
// read at the other type. Each is exactly one wasm instruction, so there is no
// import, no runtime, and nothing for the linker.
const OP_I32_REINTERPRET_F32 = 0xbc
const OP_I64_REINTERPRET_F64 = 0xbd
const OP_F32_REINTERPRET_I32 = 0xbe
const OP_F64_REINTERPRET_I64 = 0xbf
// `emitBitcastIntr`'s "this name is not an intrinsic" answer, distinct from its
// success (0) and its failure (-1) — the caller falls through to its own error.
const NUM_INTR_NONE = -2

// How a numeric intrinsic call lowers (`numIntrPlanOf`): one instruction `niOp` over every
// argument at kind `niKind` (`bitcast`, `float`, `int`), or an integer `abs`/`min`/`max`
// through a select at that kind. `none` is no intrinsic; `bad` a call legacy cannot read.
export type NumIntrArm = "bad"
  | "none"
  | "bitcast"
  | "float"
  | "intAbs"
  | "intMinMax"
  | "int"
export type NumIntrPlan = { niArm: NumIntrArm, niKind: i32, niOp: i32 }

// The plan for a call of intrinsic `name` at `callIx` in `fnIx`. A float intrinsic's width is
// the binary operators': f32 when an operand is f32 and neither side is a genuine
// (non-literal) f64, so `min(x, 0.5)` over an f32 `x` computes in f32 as `x * 0.5` does. An
// integer intrinsic is i64 when an operand is i64, else i32.
export function numIntrPlanOf(
  callIx: i32,
  fnIx: i32,
  name: string,
): NumIntrPlan {
  const base = numIntrNamePlan(callIx, fnIx, name)
  return match base.niArm {
    "none" | "bad" | "intAbs" | "intMinMax" => base
    "bitcast" | "float" | "int" => numIntrCallPlan(callIx, fnIx, name, base)
  }
}

// `numIntrPlanOf` by the name alone, at the narrow width: a bitcast's operand at its own
// source width, an integer `abs`/`min`/`max` at the width `minMaxKind` names.
function numIntrNamePlan(callIx: i32, fnIx: i32, name: string): NumIntrPlan {
  let pl: NumIntrPlan = { niArm: "none", niKind: -1, niOp: -1 }
  if name == "f32bits" {
    pl = { niArm: "bitcast", niKind: 5, niOp: OP_I32_REINTERPRET_F32 }
  } else if name == "f64bits" {
    pl = { niArm: "bitcast", niKind: 4, niOp: OP_I64_REINTERPRET_F64 }
  } else if name == "f32fromBits" {
    pl = { niArm: "bitcast", niKind: 0, niOp: OP_F32_REINTERPRET_I32 }
  } else if name == "f64fromBits" {
    pl = { niArm: "bitcast", niKind: 3, niOp: OP_F64_REINTERPRET_I64 }
  } else if floatIntrOpF32(name) >= 0 {
    const mmk = minMaxKind(callIx, fnIx)
    const wk = if mmk == "i64" { 3 } else { 0 }
    if mmk == "i32" || mmk == "i64" {
      const ia: NumIntrArm = if name == "abs" { "intAbs" } else { "intMinMax" }
      pl = { niArm: ia, niKind: wk, niOp: -1 }
    } else {
      pl = { niArm: "float", niKind: 4, niOp: floatIntrOpF64(name) }
    }
  } else if intIntrOpI32(name) >= 0 {
    pl = { niArm: "int", niKind: 0, niOp: intIntrOpI32(name) }
  }
  return pl
}

// A one-instruction intrinsic's plan `base` read against call `callIx`: `bad` for no call
// index, `none` for a node that is no call, else widened by its operands.
function numIntrCallPlan(
  callIx: i32,
  fnIx: i32,
  name: string,
  base: NumIntrPlan,
): NumIntrPlan {
  if callIx < 0 {
    const bp: NumIntrPlan = { niArm: "bad", niKind: -1, niOp: -1 }
    return bp
  }
  const c = nodeAt(callIx)
  if !(c is Call) {
    const np: NumIntrPlan = { niArm: "none", niKind: -1, niOp: -1 }
    return np
  }
  const args = c.callArgs
  let kind = base.niKind
  let op = base.niOp
  if floatIntrOpF32(name) >= 0 && args.length > 0 {
    let anyF32 = false
    for a in args {
      if exprIsF32(a, fnIx) { anyF32 = true }
    }
    // A one-argument intrinsic passes its one operand as both sides.
    if anyF32 && !binMixHardF64(args[0], args[args.length - 1], fnIx) {
      kind = 5
      op = floatIntrOpF32(name)
    }
  }
  if intIntrOpI32(name) >= 0 {
    for a in args {
      if exprIsI64(a, fnIx) {
        kind = 3
        op = intIntrOpI64(name)
      }
    }
  }
  const pl: NumIntrPlan = { niArm: base.niArm, niKind: kind, niOp: op }
  return pl
}

// A numeric intrinsic call: its plan's lowering, or `NUM_INTR_NONE` when `name` is not one.
function emitNumIntr(callIx: i32, fnIx: i32, name: string) {
  const pl = numIntrPlanOf(callIx, fnIx, name)
  return match pl.niArm {
    "none" => NUM_INTR_NONE
    "bad" => -1
    "intAbs" => emitIntAbs(callIx, fnIx, pl.niKind == 3)
    "intMinMax" => emitIntMinMax(callIx, fnIx, name, pl.niKind == 3)
    "bitcast" | "float" | "int" => emitNumIntrOp(callIx, fnIx, name, pl)
  }
}

// A one-instruction numeric intrinsic: every argument at the plan's kind, then its instruction.
function emitNumIntrOp(callIx: i32, fnIx: i32, name: string, pl: NumIntrPlan) {
  if callIx < 0 { return -1 }
  const c = nodeAt(callIx)
  if !(c is Call) { return NUM_INTR_NONE }
  if pl.niArm == "bitcast" && c.callArgs.length != 1 {
    return emitFail(
      "emitProgram: internal: "
        + name
        + " reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  if pl.niArm == "float" && c.callArgs.length == 0 {
    return emitFail(
      "emitProgram: internal: "
        + name
        + " reached with no argument — the checker's arity rule refuses it",
    )
  }
  for a in c.callArgs {
    if emitExprAsKind(a, pl.niKind, fnIx) < 0 { return -1 }
  }
  return numIntrTail(pl.niOp)
}

// After a numeric intrinsic's operands: its one instruction.
export function numIntrTail(op: i32): i32 { return fbI32Bin(op) }

// The f32 instruction for the float intrinsic `name`, or -1 when it is not one.
//   abs 0x8b · ceil 0x8d · floor 0x8e · trunc 0x8f · nearest 0x90 · sqrt 0x91
//   min 0x96 · max 0x97 · copysign 0x98
function floatIntrOpF32(name: string) {
  if name == "abs" { return 0x8b }
  if name == "ceil" { return 0x8d }
  if name == "floor" { return 0x8e }
  if name == "trunc" { return 0x8f }
  if name == "nearest" { return 0x90 }
  if name == "sqrt" { return 0x91 }
  if name == "min" { return 0x96 }
  if name == "max" { return 0x97 }
  if name == "copysign" { return 0x98 }
  return -1
}

// The f64 instruction for the float intrinsic `name`, or -1 when it is not one — the
// f32 table shifted up by one block, exactly as the arithmetic opcodes are.
//   abs 0x99 · ceil 0x9b · floor 0x9c · trunc 0x9d · nearest 0x9e · sqrt 0x9f
//   min 0xa4 · max 0xa5 · copysign 0xa6
function floatIntrOpF64(name: string) {
  if name == "abs" { return 0x99 }
  if name == "ceil" { return 0x9b }
  if name == "floor" { return 0x9c }
  if name == "trunc" { return 0x9d }
  if name == "nearest" { return 0x9e }
  if name == "sqrt" { return 0x9f }
  if name == "min" { return 0xa4 }
  if name == "max" { return 0xa5 }
  if name == "copysign" { return 0xa6 }
  return -1
}

// The i32 instruction for the integer intrinsic `name`, or -1 when it is not one.
//   clz 0x67 · ctz 0x68 · popcnt 0x69 · div_u 0x6e · rem_u 0x70 · rotl 0x77 · rotr 0x78
//   lt_u 0x49 · gt_u 0x4b · le_u 0x4d · ge_u 0x4f
function intIntrOpI32(name: string) {
  if name == "clz" { return 0x67 }
  if name == "ctz" { return 0x68 }
  if name == "popcnt" { return 0x69 }
  if name == "divU" { return 0x6e }
  if name == "remU" { return 0x70 }
  if name == "rotl" { return 0x77 }
  if name == "rotr" { return 0x78 }
  if name == "ltU" { return 0x49 }
  if name == "gtU" { return 0x4b }
  if name == "leU" { return 0x4d }
  if name == "geU" { return 0x4f }
  return -1
}

// The i64 instruction for the integer intrinsic `name`, or -1 when it is not one.
//   clz 0x79 · ctz 0x7a · popcnt 0x7b · div_u 0x80 · rem_u 0x82 · rotl 0x89 · rotr 0x8a
//   lt_u 0x54 · gt_u 0x56 · le_u 0x58 · ge_u 0x5a
function intIntrOpI64(name: string) {
  if name == "clz" { return 0x79 }
  if name == "ctz" { return 0x7a }
  if name == "popcnt" { return 0x7b }
  if name == "divU" { return 0x80 }
  if name == "remU" { return 0x82 }
  if name == "rotl" { return 0x89 }
  if name == "rotr" { return 0x8a }
  if name == "ltU" { return 0x54 }
  if name == "gtU" { return 0x56 }
  if name == "leU" { return 0x58 }
  if name == "geU" { return 0x5a }
  return -1
}

// Lower an integer `min` / `max`, which has no wasm instruction: both operands are
// evaluated in order before either is staged (so a nested call cannot clobber the frame),
// then `select` over a signed compare. Staging slots: i32 at +0/+1, i64 at +2/+3.
function emitIntMinMax(callIx: i32, fnIx: i32, name: string, wide: boolean) {
  const c = nodeAt(callIx)
  if !(c is Call) {
    return emitFail("emitProgram: expected an integer min/max call")
  }
  let k = 0
  let w = 0
  // i32.lt_s 0x48 · i32.gt_s 0x4a · i64.lt_s 0x53 · i64.gt_s 0x55
  let cmp = 0x48
  if wide {
    k = 3
    w = 2
    cmp = 0x53
  }
  const s0 = intMinMaxStashSlot(w)
  const s1 = intMinMaxStashSlot(w + 1)
  if name == "max" { cmp = cmp + 2 }
  if emitExprAsKind(c.callArgs[0], k, fnIx) < 0 { return -1 }
  if emitExprAsKind(c.callArgs[1], k, fnIx) < 0 { return -1 }
  fbLocalSet(s1)
  fbLocalTee(s0)
  fbLocalGet(s1)
  fbLocalGet(s0)
  fbLocalGet(s1)
  fbI32Bin(cmp)
  fbSelect() // → the first operand when the compare holds
  return 0
}

// Lower an integer `abs`, which has no wasm instruction: `0 - x` when `x` is negative, else
// `x`, through `select`. Wraps as the subtraction does, so `abs(i32.MIN)` is `i32.MIN`.
// Stages the operand in the min/max frame's first slot of its width.
function emitIntAbs(callIx: i32, fnIx: i32, wide: boolean) {
  const c = nodeAt(callIx)
  if !(c is Call) {
    return emitFail("emitProgram: expected an integer abs call")
  }
  let k = 0
  let w = 0
  if wide {
    k = 3
    w = 2
  }
  const s0 = intMinMaxStashSlot(w)
  if emitExprAsKind(c.callArgs[0], k, fnIx) < 0 { return -1 }
  fbLocalSet(s0)
  if wide { fbI64Const(0, 0) } else { fbI32Const(0) }
  fbLocalGet(s0)
  // i32.sub 0x6b · i64.sub 0x7d
  if wide { fbI32Bin(0x7d) } else { fbI32Bin(0x6b) }
  fbLocalGet(s0)
  fbLocalGet(s0)
  if wide { fbI64Const(0, 0) } else { fbI32Const(0) }
  // i32.lt_s 0x48 · i64.lt_s 0x53
  if wide { fbI32Bin(0x53) } else { fbI32Bin(0x48) }
  fbSelect() // → the negation when the operand is negative
  return 0
}

// The value of an integer literal, of an unshadowed top-level `const` bound to one, or of an
// exact sum of those, at `ix` when it is at most `MEM_OFFSET_MAX`; else -1. The checker's
// `memOffsetCheckedValue` twin.
function memOffsetConstValue(ix: i32, fnIx: i32): i64 {
  const ox = unwrapParen(ix)
  if ox < 0 || ox >= P.nodes.length { return -1 }
  const e = nodeAt(ox)
  if e is NumLit { return memOffsetLexValue(e.numText) }
  if e is BinExpr { return memOffsetSumConst(e, fnIx) }
  return memOffsetNameConst(ox, fnIx)
}

// The exact sum of a `+` of two constant offsets, or -1 for another operator or a term that is
// not one.
function memOffsetSumConst(e: BinExpr, fnIx: i32): i64 {
  if e.binOp != "+" { return -1 }
  const l = memOffsetConstValue(e.binLeft, fnIx)
  const r = memOffsetConstValue(e.binRight, fnIx)
  if l < 0 || r < 0 || l + r > MEM_OFFSET_MAX { return -1 }
  return l + r
}

// The value of the top-level integer `const` the name at `ix` denotes from inside `fnIx`, when no
// binding of that frame shadows it; -1 for anything else, which is every node that is not one.
function memOffsetNameConst(ix: i32, fnIx: i32): i64 {
  const e = nodeAt(ix)
  if e is Ident {
    const li = globalLetOfRead(fnIx, ix)
    if li < 0 || li >= P.nodes.length { return -1 }
    const d = nodeAt(li)
    if d is LetDecl {
      if d.letKw != "const" || d.letInit < 0 { return -1 }
      const lit = nodeAt(unwrapParen(d.letInit))
      if lit is NumLit { return memOffsetLexValue(lit.numText) }
      const cf = constFoldOfLet(d)
      if cf.cfOk && cf.cfV >= 0 { return cf.cfV }
    }
  }
  return -1
}

// The call's operand at declared position `k` of a memory intrinsic with `base` operands:
// position 0 is the address, and at the offset form every later one sits one further right.
export function memCallArg(c: Call, base: i32, k: i32): i32 {
  if k >= 1 && c.callArgs.length == base + 1 { return c.callArgs[k + 1] }
  return c.callArgs[k]
}

// An i32 address operand's compile-time value when it is a constant `memOffsetConstValue`
// reads and at most 2^31-1, so every term and the exact sum equal their i32 values; else -1.
function memAddrConst(ix: i32, fnIx: i32): i64 {
  const v = memOffsetConstValue(ix, fnIx)
  if v > 0x7fffffff { return -1 }
  return v
}

// An upper bound on the i32 address operand at `ix` read as unsigned, or -1 when none is
// provable. Every rule is exact under i32 wrap: a masked, shifted-down or narrow-loaded value,
// and products, shifts and sums of bounded values that stay below 2^32.
function memAddrBound(ix: i32, fnIx: i32): i64 {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return -1 }
  const k = memAddrConst(x, fnIx)
  if k >= 0 { return k }
  const e = nodeAt(x)
  if e is BinExpr { return memAddrBinBound(e, fnIx) }
  return memAddrLoadBound(x, fnIx)
}

// `memAddrBound` of a binary operator: a mask is at most its smaller bounded side, a logical
// shift right by 1..31 is below 2^(32-k), and a product, left shift or sum of bounded operands
// is bounded while it stays below 2^32. Any other operator has no bound (-1).
function memAddrBinBound(e: BinExpr, fnIx: i32): i64 {
  const op = e.binOp
  if op == "&" {
    const l = memAddrBound(e.binLeft, fnIx)
    const r = memAddrBound(e.binRight, fnIx)
    if l < 0 { return r }
    if r < 0 || l < r { return l }
    return r
  }
  if op == ">>>" || op == "<<" {
    const sh = memAddrConst(e.binRight, fnIx)
    if sh < 0 || sh > 31 { return -1 }
    const l = memAddrBound(e.binLeft, fnIx)
    if op == ">>>" {
      if l >= 0 { return l >> sh }
      if sh == 0 { return -1 }
      return MEM_OFFSET_MAX >> sh
    }
    if l < 0 || (l << sh) > MEM_OFFSET_MAX { return -1 }
    return l << sh
  }
  if op == "*" || op == "+" {
    const l = memAddrBound(e.binLeft, fnIx)
    const r = memAddrBound(e.binRight, fnIx)
    if l < 0 || r < 0 { return -1 }
    if op == "*" {
      if l > 0 && r > MEM_OFFSET_MAX / l { return -1 }
      return l * r
    }
    if l + r > MEM_OFFSET_MAX { return -1 }
    return l + r
  }
  return -1
}

// `memAddrBound` of a narrow unsigned load, which zero-extends: 255 or 65535. Any other node,
// a call of a user function of the same name included, has no bound (-1).
function memAddrLoadBound(ix: i32, fnIx: i32): i64 {
  const e = nodeAt(ix)
  if e is Call {
    if e.callFn < 0 { return -1 }
    const f = nodeAt(e.callFn)
    if f is Ident {
      if e.callArgs.length >= 1 && !identNameIsUserBound(e.callFn, fnIx) {
        if f.identName == "__load_u8__" { return 255 }
        if f.identName == "__load_u16__" { return 65535 }
      }
    }
  }
  return -1
}

// The width in bits of the zero-extended value a load intrinsic `name` can stand for in an
// i64 fold: 8 or 16 for the unsigned narrow loads and their i64 twins, 32 for `__load_i32__`
// and `__load_u32_i64__`, 0 for any other name.
function zextLoadWidth(name: string): i32 {
  if name == "__load_u8__" || name == "__load_u8_i64__" { return 8 }
  if name == "__load_u16__" || name == "__load_u16_i64__" { return 16 }
  if name == "__load_i32__" || name == "__load_u32_i64__" { return 32 }
  return 0
}

// The node of the call at `ix` (parens peeled) when it calls a load intrinsic with a
// `zextLoadWidth` that no binding of `fnIx` shadows, else -1.
function zextLoadCallAt(ix: i32, fnIx: i32): i32 {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return -1 }
  const e = nodeAt(x)
  if e is Call {
    if e.callFn < 0 { return -1 }
    const f = nodeAt(e.callFn)
    if f is Ident {
      if zextLoadWidth(f.identName) == 0 { return -1 }
      if identNameIsUserBound(e.callFn, fnIx) { return -1 }
      return x
    }
  }
  return -1
}

// An i64 `&` mask operand's value when it is 0xff, 0xffff or 0xffffffff — an integer literal,
// or a top-level i64 `const` bound to one — else -1. An i32 const is refused: widening it
// sign-extends, so its 0xffffffff is an all-ones i64.
function zextMaskValue(ix: i32, fnIx: i32): i64 {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return -1 }
  const e = nodeAt(x)
  let v: i64 = -1
  if e is NumLit {
    v = memOffsetLexValue(e.numText)
  } else if e is Ident {
    if !exprIsI64(x, fnIx) { return -1 }
    v = memOffsetNameConst(x, fnIx)
  }
  if v == 0xff || v == 0xffff || v == MEM_OFFSET_MAX { return v }
  return -1
}

// The load call whose ZERO-extended i64 value the expression at `ix` provably is, or -1: a
// `__load_u*_i64__` call, or `__load_u8__`/`__load_u16__` cast `as`/`as%` to i64 (non-negative,
// so its sign-extension is its zero-extension). A masked form is `zextLoadMasked`'s.
export function zextLoadOf(ix: i32, fnIx: i32): i32 {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return -1 }
  const e = nodeAt(x)
  if e is Call {
    const c = zextLoadCallAt(x, fnIx)
    if c < 0 { return -1 }
    const cn = identCalleeAt(c)
    if cn == "__load_u8_i64__" || cn == "__load_u16_i64__" { return c }
    if cn == "__load_u32_i64__" { return c }
    return -1
  }
  if e is AsExpr {
    if e.asTy != "i64" { return -1 }
    if e.asMode != "prop" && e.asMode != "wrap" { return -1 }
    const ac = zextLoadCallAt(e.asObj, fnIx)
    if ac < 0 { return -1 }
    if identCalleeAt(ac) == "__load_i32__" { return -1 }
    return ac
  }
  return zextLoadMasked(x, fnIx)
}

// Whether the node at `ix` (parens peeled) is a call, a cast or an `&`: the only shapes a
// `zextLoadOf` match can have, tested before the other side's mask is read.
function zextLoadShape(ix: i32): boolean {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return false }
  const e = nodeAt(x)
  if e is BinExpr { return e.binOp == "&" }
  return e is Call || e is AsExpr
}

// `zextLoadOf` of an `&` whose one side is a `zextMaskValue` covering the other's load width:
// the other side is a `zextLoadOf` match, or `__load_i32__` cast to i64 under exactly
// 0xffffffff, the one mask that turns its sign-extension into a zero-extension. Else -1.
function zextLoadMasked(x: i32, fnIx: i32): i32 {
  const e = nodeAt(x)
  if e is BinExpr {
    if e.binOp != "&" { return -1 }
    let m: i64 = -1
    let other = -1
    if zextLoadShape(e.binLeft) {
      m = zextMaskValue(e.binRight, fnIx)
      other = e.binLeft
    }
    if m < 0 && zextLoadShape(e.binRight) {
      m = zextMaskValue(e.binLeft, fnIx)
      other = e.binRight
    }
    if m < 0 { return -1 }
    const inner = zextLoadOf(other, fnIx)
    if inner >= 0 {
      const w = zextLoadWidth(identCalleeAt(inner))
      if m == MEM_OFFSET_MAX || w == 8 || (w == 16 && m == 0xffff) {
        return inner
      }
      return -1
    }
    if m != MEM_OFFSET_MAX { return -1 }
    const o = nodeAt(unwrapParen(other))
    if o is AsExpr {
      if o.asTy != "i64" { return -1 }
      if o.asMode != "prop" && o.asMode != "wrap" { return -1 }
      const sc = zextLoadCallAt(o.asObj, fnIx)
      if sc >= 0 && identCalleeAt(sc) == "__load_i32__" { return sc }
    }
  }
  return -1
}

// Lowers the expression `zextLoadOf` matched to its one zero-extending i64 load of `callIx`'s
// width, the call's own address and memarg offset kept.
function emitZextLoad(callIx: i32, fnIx: i32) {
  const c = nodeAt(callIx)
  if c is Call {
    const w = zextLoadWidth(identCalleeAt(callIx))
    let nm = "__load_u32_i64__"
    if w == 8 { nm = "__load_u8_i64__" }
    if w == 16 { nm = "__load_u16_i64__" }
    const off = emitMemAddr(c, 1, fnIx, nm)
    if off < 0 { return -1 }
    fbMemAccess(memLoadOpcode(nm), memLoadAlignExp(nm), off)
    return 0
  }
  return emitFail(
    "emitProgram: a zero-extending load fold matched a node that is not a call",
  )
}

// The constant term of a `+` whose OTHER side `memAddrBound` can bound at all, or -1 for any
// other shape. Bounding K+bound against `MEM_OFFSET_MAX` (plus a caller's own offset) is the
// caller's job, since only the caller knows what else shares that budget. Shared by
// `emitMemAddr`'s own split and the declaration-time fold below.
function memConstFoldK(a: BinExpr, fnIx: i32): i64 {
  if a.binOp != "+" { return -1 }
  const lc = memAddrConst(a.binLeft, fnIx)
  if lc >= 0 && memAddrConst(a.binRight, fnIx) < 0 {
    if memAddrBound(a.binRight, fnIx) >= 0 { return lc }
    return -1
  }
  const rc = memAddrConst(a.binRight, fnIx)
  if rc >= 0 && memAddrConst(a.binLeft, fnIx) < 0 {
    if memAddrBound(a.binLeft, fnIx) >= 0 { return rc }
    return -1
  }
  return -1
}

// The non-constant side `memConstFoldK` paired its answer with, or -1 when it found none.
function memConstFoldRest(a: BinExpr, fnIx: i32): i32 {
  if a.binOp != "+" { return -1 }
  if memAddrConst(a.binLeft, fnIx) >= 0 && memAddrConst(a.binRight, fnIx) < 0 {
    return a.binRight
  }
  if memAddrConst(a.binRight, fnIx) >= 0 && memAddrConst(a.binLeft, fnIx) < 0 {
    return a.binLeft
  }
  return -1
}

// `memConstFoldK` of a LOCAL `const`'s own initializer, checked against `MEM_OFFSET_MAX` alone,
// or -1 when the whole initializer is already constant (nothing to preserve at runtime) or
// matches neither shape. `emitLetDeclStmt` and `maFoldCandidateCount` share this one answer,
// since a deviation between them is unsound.
function memConstFoldShapeK(initIx: i32, fnIx: i32): i64 {
  const ix = unwrapParen(initIx)
  if ix < 0 || ix >= P.nodes.length { return -1 }
  if memAddrConst(ix, fnIx) >= 0 { return -1 }
  const e = nodeAt(ix)
  if !(e is BinExpr) { return -1 }
  const kv = memConstFoldK(e, fnIx)
  if kv < 0 { return -1 }
  const rest = memConstFoldRest(e, fnIx)
  const m = memAddrBound(rest, fnIx)
  if m < 0 || m + kv > MEM_OFFSET_MAX { return -1 }
  return kv
}

// The bounded operand `memConstFoldShapeK` found, or -1 when it found none — a second, cheap
// re-derivation rather than a two-value return, since VL has no tuple type here.
function memConstFoldShapeRest(initIx: i32, fnIx: i32): i32 {
  const ix = unwrapParen(initIx)
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const e = nodeAt(ix)
  if e is BinExpr { return memConstFoldRest(e, fnIx) }
  return -1
}

// True when `initIx`'s top-level shape is a `+` at all — the one cheap, non-recursive check
// every caller of `memConstFoldShapeK` runs first, so the real (`memAddrConst`/`memAddrBound`)
// analysis is skipped for the vast majority of `const`s, which are never address sums.
function mfShapeIsSum(initIx: i32): boolean {
  const ix = unwrapParen(initIx)
  if ix < 0 || ix >= P.nodes.length { return false }
  const e = nodeAt(ix)
  if e is BinExpr { return e.binOp == "+" }
  return false
}

// How many of this function's already-collected locals qualify for the declaration-time
// address fold, sized before the body is walked (`fnDetectScratch`) so `fbBeginFunc` can
// reserve them. Reads `localDeclIx` — one entry per local slot `collectLocals` already
// allocated, however deeply nested — rather than re-walking the body a second time.
export function maFoldCandidateCount(fnIx: i32): i32 {
  let count = 0
  let i = 0
  while i < localDeclIx.length {
    // `localIsRef[i]` is the slot kind `collectLocals` already classified — "i32" is the one a
    // plain arithmetic sum ever takes, so this skips every i64/f32/f64/ref local (registers, in
    // plumb-shaped code) before touching its declaration node at all.
    if localIsRef[i] == "i32" {
      const declIx = localDeclIx[i]
      if declIx >= 0 && declIx < P.nodes.length {
        const d = nodeAt(declIx)
        if d is LetDecl {
          if d.letKw == "const" && d.letInit >= 0 && mfShapeIsSum(d.letInit) {
            if memConstFoldShapeK(d.letInit, fnIx) >= 0 { count = count + 1 }
          }
        }
      }
    }
    i = i + 1
  }
  return count
}

// The declaration-time fold's live table for the function currently emitting: parallel to
// each qualifying `const`'s own node index, the WASM index of its scratch local and the K it
// folded out. Cleared at the top of `emitFuncBody` — a node index is emitted at most once, so
// stale rows from a previous function can never be mistaken for this one's.
let maFoldDeclIx: i32[] = []
let maFoldWasmSlot: i32[] = []
let maFoldK: i64[] = []
// How many of this function's scratch slots (`maFoldScratchBase` + this) are already claimed —
// `maFoldCandidateCount`'s own visiting order, replayed by `emitLetDeclStmt` as it emits each
// qualifying declaration in turn, so the two never need to agree on anything but that order.
let maFoldCursor = 0

// The fold table's row for declaration `declIx`, or -1 — the slot BELONGS to the declaration,
// not to any one emission of it: an unrolled or partially-unrolled loop body (`emitRangeUnrolled`
// and #3129's 4x partial unroll) re-emits the same `LetDecl` node once per copy, and every copy
// must land on the ONE row `maFoldCandidateCount` reserved, not a fresh one each time.
function maFoldRowOfDecl(declIx: i32): i32 {
  let i = 0
  while i < maFoldDeclIx.length {
    if maFoldDeclIx[i] == declIx { return i }
    i = i + 1
  }
  return -1
}

// The fold table's row for the `Ident` read at `ix`, or -1 — through the slot the read's own
// declaration names, so a shadowed name in a nested block can never match an outer
// declaration's row.
function maFoldRowOf(ix: i32): i32 {
  const slot = declaredSlotOf(ix)
  if slot < 0 || slot >= localDeclIx.length { return -1 }
  const decl = localDeclIx[slot]
  if decl < 0 { return -1 }
  return maFoldRowOfDecl(decl)
}

// Emits a qualifying `const`'s initializer: push the bounded part, tee it into this
// declaration's own scratch local, then finish `K + bounded` as `emitExpr` would — the value
// is unchanged, so other reads of the name are unaffected. A re-emitted copy of the same
// `declIx` reuses the row `maFoldRowOfDecl` finds rather than claiming a fresh slot.
function emitMemConstFoldLet(initIx: i32, k: i64, fnIx: i32, declIx: i32): i32 {
  const rest = memConstFoldShapeRest(initIx, fnIx)
  if rest < 0 {
    return emitFail(
      "emitProgram: a declaration-time address fold lost its own split",
    )
  }
  if emitExpr(rest, fnIx) < 0 { return -1 }
  const existing = maFoldRowOfDecl(declIx)
  let wasmIdx = 0
  if existing >= 0 {
    wasmIdx = maFoldWasmSlot[existing]
  } else {
    wasmIdx = maFoldScratchBase + maFoldCursor
    maFoldCursor = maFoldCursor + 1
    maFoldDeclIx.push(declIx)
    maFoldWasmSlot.push(wasmIdx)
    maFoldK.push(k)
  }
  fbLocalTee(wasmIdx)
  fbI32Const(k as% i32)
  fbI32Bin(0x6a) // i32.add
  return 0
}

// Pushes the address of memory-intrinsic call `c` (`base` declared operands) and answers the
// memarg offset, or -1 after an emit failure, along `memAddrPlanOf`'s arm.
function emitMemAddr(c: Call, base: i32, fnIx: i32, name: string): i64 {
  const p = memAddrPlanOf(c, base, fnIx)
  match p.maArm {
    "bad" => {
      emitFail(
        "emitProgram: "
          + name
          + " has an argument count or offset the checker refuses (the offset is a compile-time integer in 0..4294967295)",
      )
      return -1
    }
    "lma" => {
      lmaAddrNode = -1
      if emitExprAsKind(p.maRest, 3, lmaCallerFn) < 0 { return -1 }
      fbI32WrapI64()
    }
    "const" => fbI32Const(0)
    "fold" => fbLocalGet(p.maRest)
    "wide" => {
      if emitExprAsKind(p.maRest, 3, fnIx) < 0 { return -1 }
      fbI32WrapI64()
    }
    "rest" => {
      if emitExpr(p.maRest, fnIx) < 0 { return -1 }
    }
  }
  return p.maOff
}

// How memory-intrinsic call `c` (`base` declared operands) writes its address: `bad` refused,
// `lma` an inlined accessor's i64 operand, `const` a constant (`i32.const 0`), `fold` folded local
// `maRest`, `wide` i64 node `maRest` wrapped, `rest` node `maRest`. A constant part moves into
// offset `maOff` only where both forms name the same effective address.
export type MemAddrArm = "bad" | "lma" | "const" | "fold" | "wide" | "rest"
export type MemAddrPlan = { maArm: MemAddrArm, maRest: i32, maOff: i64 }

function memAddrAt(arm: MemAddrArm, rest: i32, off: i64): MemAddrPlan {
  return { maArm: arm, maRest: rest, maOff: off }
}

export function memAddrPlanOf(c: Call, base: i32, fnIx: i32): MemAddrPlan {
  let off: i64 = 0
  if c.callArgs.length == base + 1 {
    off = memOffsetConstValue(c.callArgs[1], fnIx)
  } else if c.callArgs.length != base {
    off = -1
  }
  if off < 0 { return memAddrAt("bad", -1, -1) }
  const addr = unwrapParen(c.callArgs[0])
  if addr >= 0 && addr == lmaAddrNode {
    return memAddrAt("lma", lmaAddrRest, lmaAddrK + off)
  }
  if addr < 0 || addr >= P.nodes.length {
    return memAddrAt("rest", c.callArgs[0], off)
  }
  const whole = memAddrConst(addr, fnIx)
  if whole >= 0 && whole + off <= MEM_OFFSET_MAX {
    return memAddrAt("const", -1, whole + off)
  }
  const a = nodeAt(addr)
  if a is Ident {
    const mf = maFoldRowOf(addr)
    if mf >= 0 {
      const k = maFoldK[mf]
      if k + off <= MEM_OFFSET_MAX {
        return memAddrAt("fold", maFoldWasmSlot[mf], k + off)
      }
    }
  }
  if a is BinExpr {
    const kv = memConstFoldK(a, fnIx)
    if kv >= 0 {
      const rest = memConstFoldRest(a, fnIx)
      const m = memAddrBound(rest, fnIx)
      if m >= 0 && m + kv + off <= MEM_OFFSET_MAX {
        return memAddrAt("rest", rest, kv + off)
      }
    }
  }
  if gLowMemUnused > 0 {
    const lk = memLowFoldK(addr, fnIx)
    if lk > 0 && lk + off < gLowMemUnused {
      const wide = memLowWrapped(addr, fnIx)
      const rest = memLowFoldRest(addr, fnIx)
      if wide >= 0 { return memAddrAt("wide", rest, lk + off) }
      return memAddrAt("rest", rest, lk + off)
    }
  }
  return memAddrAt("rest", c.callArgs[0], off)
}

// The i64 operand of an address `x as% i32` when `x` is an i64, else -1. Under
// `gLowMemUnused` its constant terms fold as an i32 address's do: `wrap(x + K)` is
// `wrap(x) + K` modulo 2^32, the same wrap `memLowFoldK` argues about.
function memLowWrapped(addr: i32, fnIx: i32): i32 {
  const e = nodeAt(addr)
  if e is AsExpr {
    if e.asMode != "wrap" { return -1 }
    let tgt = asExprNumTgtName(addr)
    if tgt == "" { tgt = e.asTy }
    if tgt != "i32" || asExprNumCastDomain(addr) == "u8" { return -1 }
    if asExprIsUnionCastIn(addr, fnIx) || !exprIsI64(e.asObj, fnIx) {
      return -1
    }
    return e.asObj
  }
  return -1
}

// The non-constant side of a `+` at `ix` whose other side is a `memAddrConst`, or -1.
function memLowStep(ix: i32, fnIx: i32): i32 {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return -1 }
  const e = nodeAt(x)
  if e is BinExpr {
    if e.binOp != "+" { return -1 }
    const lc = memAddrConst(e.binLeft, fnIx)
    const rc = memAddrConst(e.binRight, fnIx)
    if rc >= 0 && lc < 0 { return e.binLeft }
    if lc >= 0 && rc < 0 { return e.binRight }
  }
  return -1
}

// The constant that `memLowStep` peeled from the `+` at `ix`; only called where it answered.
function memLowStepK(ix: i32, fnIx: i32): i64 {
  const e = nodeAt(unwrapParen(ix))
  if e is BinExpr {
    const rc = memAddrConst(e.binRight, fnIx)
    if rc >= 0 { return rc }
    return memAddrConst(e.binLeft, fnIx)
  }
  emitFail("emitProgram: a low-memory address fold lost its own `+`")
  return -1
}

// The address operand `emitMemAddr` pushes for `addr` (the i64 operand under a wrap).
function memLowBase(addr: i32, fnIx: i32): i32 {
  const w = memLowWrapped(addr, fnIx)
  if w >= 0 { return w }
  return addr
}

// The sum of the constant terms `a + K1 + K2 ...` adds to address `addr`, or -1 when it adds
// none or more than `MEM_OFFSET_MAX`. Moving them into the memarg changes the address only where
// the sum wraps past 2^32, where the add's own address is below that sum, and so below
// `gLowMemUnused` once the caller has checked it: an access the promise excludes.
function memLowFoldK(addr: i32, fnIx: i32): i64 {
  let x = memLowBase(addr, fnIx)
  let k: i64 = 0
  let next = memLowStep(x, fnIx)
  while next >= 0 {
    const sk = memLowStepK(x, fnIx)
    if sk < 0 { return -1 }
    k = k + sk
    if k > MEM_OFFSET_MAX { return -1 }
    x = next
    next = memLowStep(x, fnIx)
  }
  if k == 0 { return -1 }
  return k
}

// The frame of an accessor call `emitLowMemAccessorCall` inlines: the accessor's own address
// operand, and the caller's operand and constant that replace it; the accessor's value
// parameter read, and the caller's argument it stands for. Each node is -1 once consumed.
let lmaAddrNode = -1
let lmaAddrRest = -1
let lmaAddrK: i64 = 0
let lmaValNode = -1
let lmaValArg = -1
let lmaCallerFn = -1

// Whether a call of function `fi` may be inlined as a folded memory access under the
// low-memory promise; `emitLowMemAccessorCall` decides the call itself. Legacy and the IR share it.
export function lowMemFoldsCallee(fi: i32): boolean {
  return gLowMemUnused > 0 && lmaAccessBody(fi) >= 0
}

// Under `gLowMemUnused`, a call `f(x + K, v)` of a trivial memory accessor (`lmaAccessBody`)
// emits `f`'s body in place, its address as `wrap(x)` with K in the memarg, exactly as the
// direct spelling `__load_i64__(x as% i32, K)` folds. 1 when the call does not qualify.
function emitLowMemAccessorCall(callIx: i32, fnIx: i32, target: i32): i32 {
  const c = nodeAt(callIx)
  const fd = nodeAt(fnStmts[target])
  if c is Call {
    if fd is FuncDecl {
      const bx = lmaAccessBody(target)
      if bx < 0 || c.callArgs.length != fd.fnParams.length { return 1 }
      for nm in c.callArgNames {
        if nm != "" { return 1 }
      }
      const a0 = c.callArgs[0]
      if a0 < 0 || !exprIsI64(a0, fnIx) { return 1 }
      const k = memLowFoldK(a0, fnIx)
      const acc = lmaAccessCall(bx, target)
      if acc < 0 { return 1 }
      const ac = nodeAt(acc)
      if ac is Call {
        let own: i64 = 0
        if ac.callArgs.length == memOffsetBaseArityOf(ac) + 1 {
          own = memOffsetConstValue(ac.callArgs[1], target)
        }
        if (
          k <= 0
          || own < 0
          || k + own >= gLowMemUnused
          || k + own > MEM_OFFSET_MAX
        ) {
          return 1
        }
        let valNode = -1
        let valArg = -1
        if fd.fnParams.length == 2 {
          valArg = c.callArgs[1]
          if valArg < 0 || !exprIsI64(valArg, fnIx) { return 1 }
          valNode = lmaValueRead(memCallArg(ac, 2, 1))
        }
        const sAddr = lmaAddrNode
        const sRest = lmaAddrRest
        const sK = lmaAddrK
        const sVal = lmaValNode
        const sArg = lmaValArg
        const sFn = lmaCallerFn
        lmaAddrNode = unwrapParen(ac.callArgs[0])
        lmaAddrRest = memLowFoldRest(a0, fnIx)
        lmaAddrK = k
        lmaValNode = valNode
        lmaValArg = valArg
        lmaCallerFn = fnIx
        const rc = emitExpr(bx, target)
        const missed = lmaAddrNode >= 0 || lmaValNode >= 0
        lmaAddrNode = sAddr
        lmaAddrRest = sRest
        lmaAddrK = sK
        lmaValNode = sVal
        lmaValArg = sArg
        lmaCallerFn = sFn
        if rc < 0 { return -1 }
        if missed {
          return emitFail(
            "emitProgram: an inlined memory accessor left an operand unread",
          )
        }
        return 0
      }
    }
  }
  return 1
}

// The operand count of memory intrinsic call `c` without its optional offset.
function memOffsetBaseArityOf(c: Call): i32 {
  if c.callFn < 0 { return 1 }
  const f = nodeAt(c.callFn)
  if f is Ident {
    if f.identName == "__store_i32__" || nameIsMemStoreIntrinsic(f.identName) {
      return 2
    }
  }
  return 1
}

// The body expression of function `fi` when it is a trivial memory accessor, else -1: not
// generic, i64 parameters with no default, and one expression that is a load of `a as% i32`
// (under `as` casts and `&` with a constant, returning its own type) or a store of `v` or
// `v as T` there, where `a` and `v` are the parameters in order and each is read once.
function lmaAccessBody(fi: i32): i32 {
  if fi < 0 || fi >= fnStmts.length || captureCountOf(fi) > 0 { return -1 }
  const fd = nodeAt(fnStmts[fi])
  if fd is FuncDecl {
    if fd.fnTyParams.length > 0 || fd.fnBody < 0 { return -1 }
    const np = fd.fnParams.length
    if np < 1 || np > 2 { return -1 }
    for p in fd.fnParams {
      const pn = nodeAt(p)
      if pn is Param {
        if pn.parDefault >= 0 || pn.parOpt != 0 || pn.parRest != 0 { return -1 }
        if lmaTypeName(pn.parType) != "i64" { return -1 }
      } else {
        return -1
      }
    }
    const blk = nodeAt(fd.fnBody)
    if blk is Block {
      if blk.blkStmts.length != 1 { return -1 }
      // A block body's one statement returns the access: `{ return e }` is `e`.
      const s0 = blk.blkStmts[0]
      const sn = nodeAt(s0)
      const bx = if sn is RetStmt { sn.retArg } else { s0 }
      const acc = lmaAccessCall(bx, fi)
      if acc < 0 || !lmaIsIntrinsic(acc, fi) { return -1 }
      const ac = nodeAt(acc)
      if ac is Call {
        const arity = memOffsetBaseArityOf(ac)
        if ac.callArgs.length != arity && ac.callArgs.length != arity + 1 {
          return -1
        }
        if unwrapParen(ac.callArgs[0]) < 0 { return -1 }
        if (
          lmaParamRead(memLowWrapped(unwrapParen(ac.callArgs[0]), fi))
          != lmaParamName(fd, 0)
        ) {
          return -1
        }
        if arity == 2 {
          if np != 2 || fd.fnRet >= 0 || unwrapParen(bx) != acc { return -1 }
          const vr = lmaValueRead(memCallArg(ac, 2, 1))
          if lmaParamRead(vr) != lmaParamName(fd, 1) { return -1 }
          return bx
        }
        if np != 1 { return -1 }
        const rt = lmaTypeName(fd.fnRet)
        if rt == "" || rt != lmaPrimOf(bx, fi) { return -1 }
        return bx
      }
    }
  }
  return -1
}

// The intrinsic call at the core of accessor expression `ix`: the call itself, or the call
// under `as` casts and a `&` whose other side is a constant (`memOffsetConstValue`, so it has no
// effect and reads no parameter); -1 otherwise.
function lmaAccessCall(ix: i32, fi: i32): i32 {
  let x = unwrapParen(ix)
  let depth = 0
  while depth < 4 && x >= 0 {
    const n = nodeAt(x)
    if n is Call { return x }
    if n is AsExpr {
      x = unwrapParen(n.asObj)
    } else if n is BinExpr {
      if n.binOp != "&" { return -1 }
      if memOffsetConstValue(n.binRight, fi) >= 0 {
        x = unwrapParen(n.binLeft)
      } else if memOffsetConstValue(n.binLeft, fi) >= 0 {
        x = unwrapParen(n.binRight)
      } else {
        return -1
      }
    } else {
      return -1
    }
    depth = depth + 1
  }
  return -1
}

// Whether call `acc` in function `fi` is a scalar load or store intrinsic rather than a binding
// of that name.
function lmaIsIntrinsic(acc: i32, fi: i32): boolean {
  const ac = nodeAt(acc)
  if ac is Call {
    if ac.callFn < 0 { return false }
    const f = nodeAt(ac.callFn)
    if f is Ident {
      const nm = f.identName
      if (
        identNameIsUserBound(ac.callFn, fi)
        || fnIndexOfNode(ac.callFn) >= 0
      ) {
        return false
      }
      return (nm == "__load_i32__"
        || nm == "__store_i32__"
        || nameIsMemLoadIntrinsic(nm)
        || nameIsMemStoreIntrinsic(nm))
    }
  }
  return false
}

// The parameter read a store's value operand `ix` is: `v`, or `v as T`; else -1.
function lmaValueRead(ix: i32): i32 {
  const x = unwrapParen(ix)
  if x < 0 { return -1 }
  const n = nodeAt(x)
  if n is AsExpr { return unwrapParen(n.asObj) }
  return x
}

// The name an `Ident` node `ix` reads, or "" for any other node.
function lmaParamRead(ix: i32): string {
  if ix < 0 { return "" }
  const n = nodeAt(unwrapParen(ix))
  if n is Ident { return n.identName }
  return ""
}

// The name of parameter `k` of `fd`.
function lmaParamName(fd: FuncDecl, k: i32): string {
  const p = nodeAt(fd.fnParams[k])
  if p is Param { return p.parName }
  return ""
}

// The numeric primitive a type annotation node's recorded type is, or "" for none or any other.
function lmaTypeName(ix: i32): string {
  if ix < 0 { return "" }
  const pn = nodeTyPrimName(ix)
  if pn == "i32" || pn == "i64" || pn == "f32" || pn == "f64" { return pn }
  return ""
}

// The primitive expression `ix` of function `fi` yields, as `lmaTypeName` spells it.
function lmaPrimOf(ix: i32, fi: i32): string {
  if exprIsI64(ix, fi) { return "i64" }
  if exprIsF64(ix, fi) { return "f64" }
  if exprIsF32(ix, fi) { return "f32" }
  return "i32"
}

// The operand left once `memLowFoldK`'s constant terms are peeled from `addr`.
function memLowFoldRest(addr: i32, fnIx: i32): i32 {
  let x = memLowBase(addr, fnIx)
  let next = memLowStep(x, fnIx)
  while next >= 0 {
    x = next
    next = memLowStep(x, fnIx)
  }
  return x
}

// The compile-time lane index at a SIMD lane argument, or -1 when it is not a literal in
// `0..max`. The checker (`checkSimdLaneArg`) already refused a non-literal, so this only
// re-reads the value the immediate byte needs; -1 keeps a drift between the two loud, not silent.
function simdLaneImm(argIx: i32, max: i32): i32 {
  const ix = unwrapParen(argIx)
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const e = nodeAt(ix)
  if e is NumLit {
    if numLexIsFloat(e.numText) { return -1 }
    const v = u8LexValue(e.numText)
    if v <= max { return v }
  }
  return -1
}

// The SIMD lowering (`simd-design.md` §D6): push the row's operands in order, each at the width
// `simdOperandPrim` names, then `simdTail`'s one 0xFD-prefix instruction. A load or store takes
// its address through `emitMemAddr` instead.
function emitSimdIntrinsic(c: Call, name: string, fnIx: i32) {
  const row = simdRow(name)
  if row < 0 {
    return emitFail("emitProgram: '" + name + "' is not a known SIMD intrinsic")
  }
  const sig = simdRowSig(row)
  if sig == SIMD_SIG_LOAD || sig == SIMD_SIG_STORE {
    let base = 1
    if sig == SIMD_SIG_STORE { base = 2 }
    const off = emitMemAddr(c, base, fnIx, name)
    if off < 0 { return -1 }
    if sig == SIMD_SIG_STORE {
      if emitExpr(memCallArg(c, base, 1), fnIx) < 0 { return -1 }
    }
    fbSimdMem(simdRowOp(row), off)
    return 0
  }
  let i = 0
  while i < c.callArgs.length {
    const p = simdOperandPrim(row, i)
    let rc = 0
    if p == "i64" { rc = emitExprAsKind(c.callArgs[i], 3, fnIx) }
    else if p == "f32" { rc = emitWidened(c.callArgs[i], 5, fnIx) }
    else if p != "" { rc = emitExpr(c.callArgs[i], fnIx) }
    if rc < 0 { return -1 }
    i = i + 1
  }
  return simdTail(c, name, row)
}

// Whether call `c` is a SIMD intrinsic: the spelling, with no binding owning the name. Legacy's
// `emitCallCore` and the IR's builder route on it.
export function simdCallNamed(c: Call, fnIx: i32): boolean {
  if c.callFn < 0 { return false }
  const f = nodeAt(c.callFn)
  if !(f is Ident) || !nameIsSimdIntrinsic(f.identName) { return false }
  return !identNameIsUserBound(c.callFn, fnIx)
}

// The SIMD table row of call `c`'s callee, or -1 for a call of no SIMD intrinsic's name.
export function simdCallRow(c: Call): i32 {
  if c.callFn < 0 || c.callFn >= P.nodes.length { return -1 }
  const f = nodeAt(c.callFn)
  return if f is Ident { simdRow(f.identName) } else { -1 }
}

// Whether SIMD row `row` is a load or store, whose operands are its address plan's.
export function simdRowIsMem(row: i32): boolean {
  const sig = simdRowSig(row)
  return sig == SIMD_SIG_LOAD || sig == SIMD_SIG_STORE
}

// The prim operand `i` of SIMD row `row` is pushed at: `v128`, or a scalar a splat, shift or
// replace takes; "" for a lane or shuffle index, which is an immediate and no operand, and for
// a load or store.
export function simdOperandPrim(row: i32, i: i32): string {
  const sig = simdRowSig(row)
  if simdRowIsMem(row) { return "" }
  if sig == SIMD_SIG_I_V { return "i32" }
  if sig == SIMD_SIG_L_V { return "i64" }
  if sig == SIMD_SIG_F_V { return "f32" }
  if i == 0 { return "v128" }
  if sig == SIMD_SIG_VV_V || sig == SIMD_SIG_VVV_V { return "v128" }
  if sig == SIMD_SIG_SHUF4 || sig == SIMD_SIG_SHUF16 {
    return if i == 1 { "v128" } else { "" }
  }
  if sig == SIMD_SIG_VI_V { return "i32" }
  if i == 1 { return "" }
  if sig == SIMD_SIG_REPL_I { return "i32" }
  if sig == SIMD_SIG_REPL_L { return "i64" }
  if sig == SIMD_SIG_REPL_F { return "f32" }
  return ""
}

// The prim SIMD row `row` leaves: a lane read's scalar, a lane test's i32, else `v128`; "" for a
// store, which leaves nothing.
export function simdResultPrim(row: i32): string {
  const sig = simdRowSig(row)
  if sig == SIMD_SIG_STORE { return "" }
  if sig == SIMD_SIG_V_I || sig == SIMD_SIG_LANE_I { return "i32" }
  if sig == SIMD_SIG_LANE_L { return "i64" }
  if sig == SIMD_SIG_LANE_F { return "f32" }
  return "v128"
}

// After a non-memory SIMD row's operands: its instruction, with the lane or shuffle immediates
// the checker pinned. A drift between the two is a loud emit failure, never a wrong byte.
export function simdTail(c: Call, name: string, row: i32): i32 {
  const op = simdRowOp(row)
  const sig = simdRowSig(row)
  if sig == SIMD_SIG_SHUF4 || sig == SIMD_SIG_SHUF16 {
    return simdShuffleTail(c, name, sig, simdRowLaneMax(row))
  }
  if (
    sig == SIMD_SIG_V_V
    || sig == SIMD_SIG_V_I
    || sig == SIMD_SIG_VV_V
    || sig == SIMD_SIG_VVV_V
    || sig == SIMD_SIG_VI_V
    || sig == SIMD_SIG_I_V
    || sig == SIMD_SIG_L_V
    || sig == SIMD_SIG_F_V
  ) {
    return fbSimdOp(op)
  }
  if (
    sig != SIMD_SIG_REPL_I
    && sig != SIMD_SIG_REPL_L
    && sig != SIMD_SIG_REPL_F
    && sig != SIMD_SIG_LANE_I
    && sig != SIMD_SIG_LANE_L
    && sig != SIMD_SIG_LANE_F
  ) {
    return emitFail(
      "emitProgram: SIMD intrinsic '"
        + name
        + "' has an operand shape with no lowering",
    )
  }
  const max = simdRowLaneMax(row)
  const lane = if c.callArgs.length > 1 { simdLaneImm(c.callArgs[1], max) } else { -1 }
  if lane < 0 { return simdLaneFail(name, max) }
  fbSimdLane(op, lane)
  return 0
}

function simdLaneFail(name: string, max: i32): i32 {
  return emitFail(
    "emitProgram: "
      + name
      + " lane index is not a compile-time literal in 0.."
      + i32ToStr(max),
  )
}

// `i8x16.shuffle` after its two vectors: sixteen byte-lane immediates, each in 0..31. The 16-lane
// form writes its literals as given; the 4-lane form (`__shuffle_f32x4__`) picks 32-bit lanes
// in 0..7 and writes each one's four bytes.
function simdShuffleTail(c: Call, name: string, sig: i32, max: i32): i32 {
  const lanes: i32[] = []
  let si = 2
  while si < c.callArgs.length {
    const l = simdLaneImm(c.callArgs[si], max)
    if l < 0 { return simdLaneFail(name, max) }
    lanes.push(l)
    si = si + 1
  }
  wU8(OP_SIMD_PREFIX)
  wULEB(SIMD_I8X16_SHUFFLE)
  let i = 0
  while i < lanes.length {
    if sig == SIMD_SIG_SHUF4 {
      const b = lanes[i] * 4
      wU8(b)
      wU8(b + 1)
      wU8(b + 2)
      wU8(b + 3)
    } else {
      wU8(lanes[i])
    }
    i = i + 1
  }
  return 0
}

// Pushes the one float operand at the width the name gives it, then writes `0xFC <sub>`.
function emitTruncSatIntrinsic(c: Call, name: string, fnIx: i32) {
  const op = truncSatOp(name)
  if op < 0 || c.callArgs.length != 1 {
    return emitFail(
      "emitProgram: internal: '"
        + name
        + "' reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  let k = 5
  if truncSatFromF64(op) { k = 4 }
  if emitExprAsKind(c.callArgs[0], k, fnIx) < 0 { return -1 }
  wU8(OP_MISC_PREFIX)
  wULEB(op)
  return 0
}

// ── atomics (0xFE prefix): the threads proposal over linear memory ───────────
// Every memory form carries a memarg whose alignment MUST be the access's natural one (a
// smaller or larger exponent is invalid), and a misaligned address traps at run time.
const OP_ATOMIC_PREFIX = 0xfe

// Pushes the address, then each value operand at the width the row names (a wait's timeout
// and an i64 row's values as i64, the rest as i32), then writes `0xFE <sub> <align> 0`.
// `atomic.fence` has no memarg: its one immediate is a reserved zero byte.
function emitAtomicIntrinsic(c: Call, name: string, fnIx: i32) {
  const row = atomicRow(name)
  if row < 0 {
    return emitFail(
      "emitProgram: '" + name + "' is not a known atomic intrinsic",
    )
  }
  const op = atomicRowOp(row)
  const sig = atomicRowSig(row)
  const args = c.callArgs
  if sig == ATOMIC_SIG_FENCE {
    wU8(OP_ATOMIC_PREFIX)
    wULEB(op)
    wU8(0) // reserved flags byte
    return 0
  }
  let vals = 0
  if (
    sig == ATOMIC_SIG_STORE
    || sig == ATOMIC_SIG_RMW
    || sig == ATOMIC_SIG_NOTIFY
  ) {
    vals = 1
  } else if sig == ATOMIC_SIG_CMPXCHG || sig == ATOMIC_SIG_WAIT {
    vals = 2
  } else if sig != ATOMIC_SIG_LOAD {
    return emitFail(
      "emitProgram: atomic intrinsic '"
        + name
        + "' has an operand shape with no lowering",
    )
  }
  if args.length != vals + 1 && args.length != vals + 2 {
    return emitFail(
      "emitProgram: internal: atomic intrinsic "
        + name
        + " reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  const off = emitMemAddr(c, vals + 1, fnIx, name)
  if off < 0 { return -1 }
  let k = 1
  while k <= vals {
    // A NOTIFY count is i32; a WAIT's last operand is the i64 timeout.
    let wide = atomicRowIsI64(row) && sig != ATOMIC_SIG_NOTIFY
    if sig == ATOMIC_SIG_WAIT && k == 2 { wide = true }
    const ak = memCallArg(c, vals + 1, k)
    if wide {
      if emitExprAsKind(ak, 3, fnIx) < 0 { return -1 }
    } else {
      if emitExpr(ak, fnIx) < 0 { return -1 }
    }
    k = k + 1
  }
  wU8(OP_ATOMIC_PREFIX)
  wULEB(op)
  wU8(atomicRowAlign(row))
  wULEB(off as% i32)
  return 0
}

// A call, followed by `unreachable` when its type is `never`: the callee leaves nothing, and
// the stack-polymorphic `unreachable` is what lets that stand in any value position (D1972).
// `__trap__` lowers to its own `unreachable`, so it needs no second one.
// The refusal a test pins under `--test-emit-refusal`: no capability, so no fix moves it.
export const TEST_EMIT_REFUSAL_MSG = "emitProgram: test-only refusal (--test-emit-refusal)"

// Whether `name` is the test hook `hook`, bare or with a module build's `$m<id>` suffix.
export function testHookNamed(name: string, hook: string): boolean {
  return name == hook || name.slice(0, hook.length + 2) == hook + "$m"
}

function emitCall(callIx: i32, fnIx: i32) {
  if callIx < 0 || callIx >= P.nodes.length {
    return emitFail("emitProgram: expected a call expression")
  }
  // A map's `.has` / `.get` over a union-of-maps box a pin left unrewritten, read per arm.
  const arm = emitArmSite(callIx, fnIx)
  if arm != 0 { return if arm < 0 { -1 } else { 0 } }
  if gTestEmitRefusal != 0 {
    const tc = nodeAt(callIx)
    if tc is Call && tc.callFn >= 0 {
      const tf = nodeAt(tc.callFn)
      // Bare in one file; a module build suffixes every top-level name with `$m<id>` (modid).
      if (
        tf is Ident
        && testHookNamed(tf.identName, "__vl_test_emit_refusal__")
      ) {
        return emitFailAt(TEST_EMIT_REFUSAL_MSG, callIx)
      }
      // The declaration-anchored twin: refused unanchored, so the failure lands on the
      // enclosing function's name as a refusal with no node of its own does.
      if (
        tf is Ident
        && testHookNamed(tf.identName, "__vl_test_emit_refusal_decl__")
      ) {
        return emitFail(TEST_EMIT_REFUSAL_MSG)
      }
    }
  }
  // A hole function's closure read that its shared lifted body cannot carry (D2878).
  const cloRef = cloTailRefusal(callIx, fnIx)
  if cloRef != "" { return emitFail(cloRef) }
  const r = emitCallCore(callIx, fnIx)
  if r < 0 { return r }
  if callEndsNever(callIx) { fbUnreachable() }
  return r
}

// Whether call `callIx` is followed by `unreachable`: its type is `never` and it is no
// `__trap__`, which is its own `unreachable`.
export function callEndsNever(callIx: i32): boolean {
  return callIsNever(callIx) && !callIsTrapIntrinsic(callIx)
}

// The tagged set call `ix` goes through in function `fnIx`: the one its callee carries there,
// which an instance decides for itself, else the set noted at the call; -1 for none.
function emitTagSetAt(ix: i32, fnIx: i32): i32 {
  const c = nodeAt(ix)
  if c is Call && c.callFn >= 0 {
    const s = fnTagSetOfTy(nodeTyAt(c.callFn, fnIx))
    if fnTagSetIsTagged(s) { return s }
  }
  const noted = fnTagCallSetOf(ix)
  if noted >= 0 { return noted }
  // A call an instance makes through its parameter is noted only as that instance's fact.
  const ms = mintCallSoleSet(ix)
  if fnTagSetIsTagged(ms) && c is Call && emitTagParamHolds(c.callFn, ms) {
    return ms
  }
  return noted
}

// Whether the callee `f` reads a parameter whose recorded type in this function is tagged set
// `s`, or an element chain off one whose list holds `s`, so its value is a member's id.
function emitTagParamHolds(f: i32, s: i32): boolean {
  let r = parenPeelIx(f)
  let chain = false
  let hops = 0
  while r >= 0 && hops < 16 {
    const n = nodeAt(r)
    if n is Index { r = parenPeelIx(n.idxArr) } else { hops = 16 }
    if hops < 16 {
      chain = true
      hops = hops + 1
    }
  }
  const d = identDeclOf(r)
  if d < 0 || !(nodeAt(d) is Param) { return false }
  if !chain { return fnTagSetOfTy(nodeTyIxOf(d)) == s }
  let t = nodeTyIxOf(d)
  let depth = 0
  while t >= 0 && t < T.tys.length && depth < 16 {
    const a = tyAt(t)
    if !(a is TyArray) { return depth > 0 && fnTagSetOfTy(t) == s }
    t = tyElemOf(a)
    depth = depth + 1
  }
  return false
}

// The one result type every member call `arms` gives in function `fnIx`, or -1 when they differ.
function fnTagArmsOneTy(arms: i32[], fnIx: i32): i32 {
  let t = -1
  for a in arms {
    const at = nodeTyAt(a, fnIx)
    if at < 0 { return -1 }
    if t >= 0 && !tySame(at, t) { return -1 }
    t = at
  }
  return t
}

// A call through a tagged function set (`fnTagDecide`): the callee is the i32 id of the member
// it holds, tested against each member's id in turn to make that member's own direct call. The
// last member takes the remaining id. Members giving different results box them into the call's
// union.
function emitFnTagDispatch(callIx: i32, s: i32, arms: i32[], fnIx: i32) {
  const c = nodeAt(callIx)
  if !(c is Call) { return emitFail("emitProgram: expected a call") }
  const ds = fnTagMembers(s)
  if ds.length != arms.length {
    return emitFail("emitProgram: a dispatch lost a member")
  }
  if emitExpr(c.callFn, fnIx) < 0 { return -1 }
  tagStashTail()
  const ty = tagDispatchTy(callIx, arms, fnIx)
  // A call through a set of void members leaves no value, and answers 1; so does one where some
  // member returns nothing (`void | i32`), whose value no slot can take, each result dropped.
  const isVoid = isVoidTy(ty) || tyMentionsVoid(ty, 4)
  let kind: VKind | null = "i32"
  if !isVoid { kind = repSigKindOfTy(ty) }
  if kind == null {
    return emitFail(
      "emitProgram: a call through a function set has a result with no rep",
    )
  }
  const boxed = kind == "union"
  const un = if boxed { boxTyName(ty) } else { "" }
  let k = 0
  while k < arms.length {
    const last = k == arms.length - 1
    if !last {
      tagIsTail(ds[k])
      tagDispatchIfOf(ty)
    }
    let rc = 0
    const armFe = emitArmRowFe(arms[k], fnIx)
    const armCall = nodeAt(arms[k])
    if armFe >= 0 && armCall is Call { elabArmStagePush(armCall.callFn, armFe) }
    if boxed {
      rc = emitUnionBoxOwed(un, ty, arms[k], fnIx)
    } else if kind == "f64" {
      // A member's narrower numeric result widens to the call's joined one.
      rc = emitWidened(arms[k], 4, fnIx)
    } else if kind == "i64" {
      rc = emitWidened(arms[k], 3, fnIx)
    } else if kind == "f32" {
      rc = emitWidened(arms[k], 5, fnIx)
    } else {
      rc = emitExpr(arms[k], fnIx)
    }
    if armFe >= 0 { elabArmStagePop() }
    if rc < 0 { return -1 }
    if isVoid && !isVoidTy(nodeTyAt(arms[k], fnIx)) { fbDrop() }
    if !last { fbElse() }
    k = k + 1
  }
  k = 0
  while k < arms.length - 1 {
    fbEnd()
    k = k + 1
  }
  if dispatchDeclinesTail() { tailCallIdx = -1 }
  return if isVoid { 1 } else { 0 }
}

// Whether a return of a dispatch's value declines the tail form: the cursor its last arm's call
// armed is not the dispatch's own call, so legacy and the IR both keep `call; return`.
export function dispatchDeclinesTail(): boolean { return true }

// The arm `if` of a dispatch whose result type is `ty`, as legacy's writer opens it; -1 when
// `ty` has no rep a dispatch's value takes. Only a struct or ref-list result names a table row.
export function tagDispatchIfOf(ty: i32): i32 {
  const isVoid = isVoidTy(ty) || tyMentionsVoid(ty, 4)
  if isVoid { return fbIf(64) }
  const kind = repSigKindOfTy(ty)
  if kind == null { return -1 }
  let rslot = -1
  if kind == "struct" || kind == "nulstruct" { rslot = repSlotOfKind(kind, ty) }
  if kind == "reflist" || kind == "nulreflist" {
    rslot = rlSlotOfTy(tyRefArrElemOf(ty))
  }
  fbOpenIf()
  return fbValtype(kind, rslot)
}

// The result type of call `callIx` through a tagged set with arms `arms`: the call's own, or, where
// a list element the instance leaves untyped names no rep, its members' one result.
export function tagDispatchTy(callIx: i32, arms: i32[], fnIx: i32): i32 {
  const ty = nodeTyAt(callIx, fnIx)
  if !isVoidTy(ty) && repSigKindOfTy(ty) == null {
    const at = fnTagArmsOneTy(arms, fnIx)
    if at >= 0 { return at }
  }
  return ty
}

// The arm calls of call `callIx` through its tagged set, in member order, or none.
export function tagDispatchArms(callIx: i32, fnIx: i32): i32[] {
  return fnTagArmsAt(callIx, emitTagSetAt(callIx, fnIx))
}

// The member ids of call `callIx`'s tagged set, one per arm.
export function tagDispatchIds(callIx: i32, fnIx: i32): i32[] {
  return fnTagMembers(emitTagSetAt(callIx, fnIx))
}

// The lambda callee of dispatch arm `a`, the arms legacy stages at their instance
// (`emitArmRowFe`), or -1 for a named member's arm.
export function tagArmLambdaCallee(a: i32): i32 {
  const c = nodeAt(a)
  if !(c is Call) || c.callFn < 0 { return -1 }
  const cn = nodeAt(c.callFn)
  if !(cn is Ident) || cn.identName != "" { return -1 }
  const d = identDeclOf(c.callFn)
  return if d >= 0 && nodeAt(d) is FuncDecl { c.callFn } else { -1 }
}

// After a tagged call's set id: keep it in the dispatch slot, which each arm's test reads.
export function tagStashTail(): i32 {
  fbLocalSet(fnTagIdSlot())
  return 0
}

// One arm's test: the kept set id against member id `id`.
export function tagIsTail(id: i32): i32 {
  fbLocalGet(fnTagIdSlot())
  fbI32Const(id)
  fbI32Bin(70) // 0x46 i32.eq
  return 0
}

// The lambda instance the row records for dispatch arm call `a`'s callee in function `fnIx`; -1
// for an arm whose member is named or a lambda mono does not instance, which resolve by name.
function emitArmRowFe(a: i32, fnIx: i32): i32 {
  const f = tagArmLambdaCallee(a)
  if f < 0 { return -1 }
  const d = identDeclOf(f)
  const fe = monoBundleReadFe(f, fnIx, elabArmSigAt(a, fnIx))
  if fe < 0 && monoIsGenericDecl(d) {
    return emitFailAt(
      "emitProgram: a lambda's dispatch arm has no instance built for this call's signature",
      a,
    )
  }
  return fe
}

function callIsTrapIntrinsic(callIx: i32) {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return false }
    const callee = nodeAt(c.callFn)
    if callee is Ident { return callee.identName == "__trap__" }
  }
  return false
}

// The template hole of render call `c` when this instance pins it to a string or a literal
// atom, else -1. The renderer takes neither, and the checker leaves a pinned body's call in
// place (D2241).
export function tplStrHoleOf(c: Call, fnIx: i32) {
  if c.callArgs.length != 1 { return -1 }
  const h = c.callArgs[0]
  if !nodeIsTplHole(h) { return -1 }
  if exprString(h, fnIx) || exprIsLitAtom(h, fnIx) { return h }
  return -1
}

// The `__str_from_bytes__(src, at, count)` arm of `emitCallCore`. Returns 0 once the string
// is on the stack, -1 on failure.
function emitCallCoreStrFromBytes(c: Call, fnIx: i32) {
  if gHelpStrFromBytes < 0 {
    return emitFail(
      "emitProgram: __str_from_bytes__ but its helper was not reserved",
    )
  }
  if c.callArgs.length != 3 {
    return emitFail(
      "emitProgram: internal: __str_from_bytes__ reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  let sfbI = 0
  while sfbI < 3 {
    if emitExpr(c.callArgs[sfbI], fnIx) < 0 { return -1 }
    sfbI = sfbI + 1
  }
  return strFromBytesTail()
}

// After `__str_from_bytes__`'s three operands: the call into its helper, which bounds-checks the
// range against the source's length and copies it into an exact-fit string. Legacy and the IR
// both write it.
export function strFromBytesTail(): i32 {
  if gHelpStrFromBytes < 0 {
    return emitFail(
      "emitProgram: __str_from_bytes__ but its helper was not reserved",
    )
  }
  fbCall(gHelpStrFromBytes)
  return 0
}

// Whether `c` is the `__str_from_bytes__(src, at, count)` intrinsic: the spelling, with no binding
// owning the name in function `fnIx`.
export function strFromBytesCallNamed(c: Call, fnIx: i32): boolean {
  if c.callFn < 0 { return false }
  const f = nodeAt(c.callFn)
  if !(f is Ident) || f.identName != "__str_from_bytes__" { return false }
  return !identNameIsUserBound(c.callFn, fnIx)
}

// Whether call `c` is the `__array_new__` / `__array_new_default__` intrinsic: the spelling,
// with no binding owning the name. Legacy's `emitCallCore` and the IR's builder route on it.
export function arrNewCallNamed(c: Call, fnIx: i32): boolean {
  if c.callFn < 0 { return false }
  const f = nodeAt(c.callFn)
  if !(f is Ident) { return false }
  if f.identName != "__array_new__" && f.identName != "__array_new_default__" {
    return false
  }
  return !identNameIsUserBound(c.callFn, fnIx)
}

// The `fromCodePoints(xs)` arm of `emitCallCore`: the list read twice by name, or once through
// the spill slot. Returns 0 once the string is on the stack, -1 on failure.
function emitCallCoreFromCodePoints(callIx: i32, c: Call, fnIx: i32) {
  if c.callArgs.length != 1 {
    return emitFail(
      "emitProgram: internal: fromCodePoints reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  const fcpA0 = c.callArgs[0]
  // An unbound argument slot takes `emitExpr`'s own hole refusal: `unwrapParen` would
  // read `P.nodes[-1]` and trap the compiler before any diagnostic printed.
  if fcpA0 < 0 { return emitExpr(fcpA0, fnIx) }
  const fcpArg = unwrapParen(fcpA0)
  // __utf8_enc__(xs.backing, 0, xs.len) — two reads of one list. A bare name is
  // re-readable, so it is emitted twice and costs no local; every other spelling is
  // evaluated ONCE into the spill slot, since a second emission would re-run its
  // effects. `callSpillsFcpArg` is the same question the frame reserved on (D1640).
  if callSpillsFcpArg(callIx) {
    if emitExpr(fcpArg, fnIx) < 0 { return -1 }
    fbLocalTee(fcpSpillStashSlot())
    fcpBackingTail()
    fbLocalGet(fcpSpillStashSlot())
    return fcpLenTail()
  }
  if emitExpr(fcpArg, fnIx) < 0 { return -1 }
  fcpBackingTail()
  if emitExpr(fcpArg, fnIx) < 0 { return -1 }
  return fcpLenTail()
}

// After a code-point list: its backing, then the start index `__utf8_enc__` takes.
export function fcpBackingTail() {
  fbStructGet(lTy(), 0)
  fbI32Const(0)
  return 0
}

// After the code-point list's second read: its length, then the encoder call, which leaves
// the string.
export function fcpLenTail() {
  fbStructGet(lTy(), 1)
  fbCall(helpUtf8EncFn())
  return 0
}

// The `fromCodePoint(code)` arm of `emitCallCore`. Returns 0 once the string is on the stack,
// -1 on failure.
function emitCallCoreFromCodePoint(c: Call, fnIx: i32) {
  if c.callArgs.length != 1 {
    return emitFail(
      "emitProgram: internal: fromCodePoint reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  if emitExpr(c.callArgs[0], fnIx) < 0 { return -1 }
  return fromCpTail()
}

// After a code point: the one-element code-point array, encoded whole into its string.
export function fromCpTail() {
  fbArrayNewFixed(aTy(), 1)
  fbI32Const(0)
  fbI32Const(1)
  fbCall(helpUtf8EncFn())
  return 0
}

// The `print(x)` arm of `emitCallCore`: the argument's rep picks the null word, a niche, a box
// dispatch, an atom chain, a string stream or one scalar print import. Returns 0 once the
// call is emitted, -1 on failure.
function emitCallCorePrint(callIx: i32, c: Call, fnIx: i32) {
  if c.callArgs.length != 1 {
    return emitFail(
      "emitProgram: internal: print reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  const arg = c.callArgs[0]
  const arm = printArmOf(arg, fnIx)
  // The argument still evaluates, so a call's side effects happen.
  if arm == "nulNone" {
    if emitNulNoneForEffect(arg, fnIx) < 0 { return -1 }
    return emitPrintNullWord()
  }
  if arm == "nulRefNiche" {
    const prNull = readNarrowedBoxToNull(arg, fnIx)
    const prMark = if prNull { storageReadEnter(arg) } else { -2 }
    const prRc = emitPrintNulRefNiche(arg, fnIx)
    if prNull { storageReadLeave(prMark) }
    return prRc
  }
  if arm == "boxNull" {
    const pnMark = storageReadEnter(arg)
    const pnWas = printPlanPinNull(true)
    const pnRc = emitCallCore(callIx, fnIx)
    printPlanPinNull(pnWas)
    storageReadLeave(pnMark)
    return pnRc
  }
  if arm == "mapScalar" {
    return emitPrintScalarMapRead(arg, mapReadScalarBoxKind(arg, fnIx), fnIx)
  }
  if arm == "nulLitPin" {
    return emitPrintNulLitUnion(
      arg,
      nulLitMemberTexts(instanceReadTyOf(arg, fnIx)),
      fnIx,
    )
  }
  if arm == "nulAtom" {
    return emitPrintNulLitUnion(arg, printAtomTexts(arm, arg, fnIx), fnIx)
  }
  if arm == "atom" {
    if emitStashAtomId(arg, fnIx) < 0 { return -1 }
    return printAtomStashed(printAtomTexts(arm, arg, fnIx), false)
  }
  if arm == "nulStr" { return emitPrintNulString(arg, fnIx) }
  if arm == "nulBool" { return emitPrintNulBool(arg, fnIx) }
  if arm == "union" {
    const puKinds: i32[] = []
    printUnionPlan(arg, fnIx, puKinds)
    return emitPrintValueUnion(arg, puKinds, fnIx)
  }
  // A union-valued argument the plan declined must not fall through: the scalar import would
  // receive a `(ref $uBox)`, check-clean invalid wasm (D711).
  if arm == "unrenderable" {
    return emitFail(
      "emitProgram: print of a union value whose arms the tag dispatch cannot classify",
    )
  }
  if arm == "str" { return emitPrintStrExpr(arg, fnIx) }
  if emitExpr(arg, fnIx) < 0 { return -1 }
  return printScalarTail(arm)
}

// How `print` writes its argument: the word `null`, a niche, a box dispatch, an atom chain, a
// string stream, or one scalar print import (`f32` … `i32`).
export type PrintArm = "nulNone"
  | "nulRefNiche"
  | "boxNull"
  | "mapScalar"
  | "nulLitPin"
  | "nulAtom"
  | "atom"
  | "nulStr"
  | "nulBool"
  | "union"
  | "unrenderable"
  | "str"
  | "f32"
  | "f64"
  | "i64"
  | "bool"
  | "i32"

// The arm `print` takes for argument `argIx` in function `fnIx`, in `emitCallCorePrint`'s order.
export function printArmOf(argIx: i32, fnIx: i32): PrintArm {
  // The `null` type has no arm to select, and every classifier below reads a rep this value
  // lacks (D1576).
  if exprIsNulNone(argIx, fnIx) { return "nulNone" }
  // A nullable ref niche whose other arm has no printed form (a record, a list, a map, a
  // closure) can print only as `null`, whatever narrowed it there (D3498).
  const pnNiche = exprNulNicheKind(argIx, fnIx)
  if (pnNiche != "" && pnNiche != "nulstr") || exprNullableMap(argIx, fnIx) {
    return "nulRefNiche"
  }
  // A read the narrowing pins to `null` prints with the narrowing lifted, so the box's own tag
  // decides (D2801).
  if readNarrowedBoxToNull(argIx, fnIx) { return "boxNull" }
  if mapReadScalarBoxKind(argIx, fnIx) >= 0 { return "mapScalar" }
  // A read narrowed to `K | null` out of a wider box prints as that niche (D7965), a hole's or
  // an instance's read at the type its calls pin (D8122).
  if (
    narrowedNulLitPinBoxKey(argIx, fnIx) != ""
    && nulLitMemberTexts(instanceReadTyOf(argIx, fnIx)).length > 0
  ) {
    return "nulLitPin"
  }
  // Asked before `exprString`, which also answers true for an atom-repped global. An
  // un-narrowed `K | null` prints its member or `null`; only that arm writes the sentinel test.
  if exprIsLitAtom(argIx, fnIx) {
    if nulLitAtomTexts(argIx, fnIx).length > 0 { return "nulAtom" }
    return "atom"
  }
  // The two niches, asked before `exprString` and the bool import, which would stream a null
  // ref into `array.len` or print the sentinel 2 as true.
  const pnk = exprNulKind(argIx, fnIx)
  if pnk == "nulstr" { return "nulStr" }
  if pnk == "nulbool" { return "nulBool" }
  // A value-union box dispatches on its tag (D712); one the plan declines must not fall through.
  const puKinds: i32[] = []
  if printUnionPlan(argIx, fnIx, puKinds) { return "union" }
  if (
    printUnionArmsUnrenderable(argIx, fnIx)
    || printArgIsUnclassifiedBox(argIx, fnIx)
  ) {
    return "unrenderable"
  }
  if exprString(argIx, fnIx) { return "str" }
  return printScalarArmOf(argIx, fnIx)
}

// The print import a scalar argument takes: f32 before f64, so a mixed f32 and float-literal
// expression prints as f32, and either float before i64, bool and i32.
function printScalarArmOf(argIx: i32, fnIx: i32): PrintArm {
  if exprIsF32(argIx, fnIx) { return "f32" }
  if exprIsF64(argIx, fnIx) { return "f64" }
  if exprIsI64(argIx, fnIx) { return "i64" }
  if exprIsBool(argIx, fnIx) { return "bool" }
  return "i32"
}

// After a scalar `print` argument's value: the call of its host print import. Returns 0.
export function printScalarTail(arm: PrintArm): i32 {
  match arm {
    "f32" => fbCall(gF32PrintIdx)
    "f64" => fbCall(gF64PrintIdx)
    "i64" => fbCall(4) // __print_i64__
    "bool" => fbCall(1) // __print_bool__
    "i32" => fbCall(0) // __print_i32__
    "nulNone" | "nulRefNiche" | "boxNull" | "mapScalar" | "nulLitPin" | "nulAtom" | "atom" | "nulStr" | "nulBool" | "union" | "unrenderable" | "str" => {
      return emitFail(
        "emitProgram: internal: a print scalar tail for a non-scalar arm",
      )
    }
  }
  return 0
}

// The load and store intrinsics of `emitCallCore`: the address, a store's value at its declared
// width, then the access. Returns 0 once emitted, -1 on failure.
function emitCallCoreMemAccess(c: Call, name: string, fnIx: i32) {
  const p = memAccessPlanOf(name)
  // The name list and the opcode tables are separate lists over one set of names: a width added
  // to one and not the other would write -1 as an opcode byte. Unreachable while they agree.
  if p.mxOp < 0 || p.mxAlign < 0 {
    return emitFail(
      "emitProgram: '"
        + name
        + "' is a declared memory access width with no opcode — the intrinsic-name list and the opcode table have drifted",
    )
  }
  const off = emitMemAddr(c, p.mxBase, fnIx, name)
  if off < 0 { return -1 }
  if p.mxBase == 2 {
    const v = memCallArg(c, 2, 1)
    const rc = if p.mxWiden < 0 { emitExpr(v, fnIx) } else { emitWidened(v, p.mxWiden, fnIx) }
    if rc < 0 { return -1 }
  }
  return memAccessTail(p, off)
}

// The access a linear-memory intrinsic writes: its opcode and alignment exponent, its declared
// operands before an optional constant offset (`mxBase`, 1 for a load and 2 for a store, 0 for no
// such intrinsic), the kind a store's value widens to (`mxWiden`, -1 when it goes in as it
// stands), `mxI32` when the value stored or loaded is a plain i32, and that value's prim (`mxPrim`).
export type MemAccessPlan = {
  mxOp: i32,
  mxAlign: i32,
  mxBase: i32,
  mxWiden: i32,
  mxI32: boolean,
  mxPrim: string,
}

export function memAccessPlanOf(name: string): MemAccessPlan {
  if name == "__store_i32__" {
    return {
      mxOp: OP_I32_STORE,
      mxAlign: 2,
      mxBase: 2,
      mxWiden: -1,
      mxI32: true,
      mxPrim: "i32",
    }
  }
  if name == "__load_i32__" {
    return {
      mxOp: OP_I32_LOAD,
      mxAlign: 2,
      mxBase: 1,
      mxWiden: -1,
      mxI32: true,
      mxPrim: "i32",
    }
  }
  if nameIsMemStoreIntrinsic(name) {
    const plain = memStoreValueIsI32(name)
    const w = if plain { -1 } else if name == "__store_i64__" { 3 } else if name == "__store_f32__" { 5 } else { 4 }
    return {
      mxOp: memStoreOpcode(name),
      mxAlign: memStoreAlignExp(name),
      mxBase: 2,
      mxWiden: w,
      mxI32: plain,
      mxPrim: if w == 3 { "i64" } else if w == 5 { "f32" } else if w == 4 { "f64" } else { "i32" },
    }
  }
  if nameIsMemLoadIntrinsic(name) {
    return {
      mxOp: memLoadOpcode(name),
      mxAlign: memLoadAlignExp(name),
      mxBase: 1,
      mxWiden: -1,
      mxI32: name == "__load_i8__"
        || name == "__load_u8__"
        || name == "__load_i16__"
        || name == "__load_u16__",
      mxPrim: memLoadPrim(name),
    }
  }
  return {
    mxOp: -1,
    mxAlign: -1,
    mxBase: 0,
    mxWiden: -1,
    mxI32: false,
    mxPrim: "",
  }
}

// The prim load width `name` leaves: i64 for the i64 loads and their zero-extending forms, f32 or
// f64 for the float loads, else i32.
function memLoadPrim(name: string): string {
  const op = memLoadOpcode(name)
  if op == OP_F32_LOAD { return "f32" }
  if op == OP_F64_LOAD { return "f64" }
  if (
    op == OP_I64_LOAD
    || op == OP_I64_LOAD8_U
    || op == OP_I64_LOAD16_U
    || op == OP_I64_LOAD32_U
  ) {
    return "i64"
  }
  return "i32"
}

// Whether call `c` is a linear-memory load or store intrinsic: the spelling, with no binding
// owning the name. Legacy's `emitCallCore` and the IR's builder route on it.
export function memAccessCallNamed(c: Call, fnIx: i32): boolean {
  if c.callFn < 0 { return false }
  const f = nodeAt(c.callFn)
  if !(f is Ident) { return false }
  const nm = f.identName
  if nm != "__store_i32__" && nm != "__load_i32__" {
    if !nameIsMemStoreIntrinsic(nm) && !nameIsMemLoadIntrinsic(nm) {
      return false
    }
  }
  return !identNameIsUserBound(c.callFn, fnIx)
}

// After the address and a store's value: the access at memarg offset `off`. Returns 0.
export function memAccessTail(p: MemAccessPlan, off: i64): i32 {
  fbMemAccess(p.mxOp, p.mxAlign, off)
  return 0
}

// The `__memory_copy__` / `__memory_fill__` arm of `emitCallCore`. Returns 0 once emitted, -1
// on failure.
function emitCallCoreMemBulk(c: Call, callee: Ident, fnIx: i32) {
  if c.callArgs.length != 3 {
    return emitFail(
      "emitProgram: internal: "
        + callee.identName
        + " reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  if emitExpr(c.callArgs[0], fnIx) < 0 { return -1 }
  if emitExpr(c.callArgs[1], fnIx) < 0 { return -1 }
  if emitExpr(c.callArgs[2], fnIx) < 0 { return -1 }
  if callee.identName == "__memory_copy__" {
    // Two memory indices: destination first, then source.
    fbMemBulk(MISC_MEMORY_COPY, 2)
  } else {
    fbMemBulk(MISC_MEMORY_FILL, 1)
  }
  return 0
}

// The `__log__(ptr, len)` arm of `emitCallCore`. Returns 0 once emitted, -1 on failure.
function emitCallCoreLog(c: Call, fnIx: i32) {
  if c.callArgs.length != 2 {
    return emitFail(
      "emitProgram: internal: __log__ reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  if emitExpr(c.callArgs[0], fnIx) < 0 { return -1 }
  if emitExpr(c.callArgs[1], fnIx) < 0 { return -1 }
  fbCall(gMemLogIdx)
  return 0
}

// How a host call lowers (`hostCallPlanOf`): each argument at kind `hpKinds[i]` (0 as itself, 3
// i64, 4 f64, 5 f32), then one `call` of reserved import `hpImport`, which leaves nothing when
// `hpVoid`. A call legacy cannot write carries its emit failure in `hpFail`.
export type HostCallPlan = {
  hpImport: i32,
  hpKinds: i32[],
  hpVoid: boolean,
  hpFail: string,
}

// Whether call `c` is a host call: a `std:fs`-floor intrinsic, or a user `extern function` no
// binding of the name shadows. Legacy's `emitCallCore` and the IR's builder route on it.
export function hostCallNamed(c: Call, fnIx: i32): boolean {
  if c.callFn < 0 || c.callFn >= P.nodes.length { return false }
  const f = nodeAt(c.callFn)
  if !(f is Ident) { return false }
  if fsIntrinsicSlot(f.identName) >= 0 { return true }
  return externLinkOf(f.identName) >= 0 && !identNameIsUserBound(c.callFn, fnIx)
}

// The plan of host call `c` (`hostCallNamed`): a floor slot's u8-list and i32 arguments as
// themselves and its offsets at i64; an extern's arguments at their declared widths.
export function hostCallPlanOf(c: Call): HostCallPlan {
  const ok = c.callFn >= 0 && c.callFn < P.nodes.length
  const f = if ok { nodeAt(c.callFn) } else { null }
  const nm = if f is Ident { f.identName } else { "" }
  const kinds: i32[] = []
  const fsK = fsIntrinsicSlot(nm)
  if fsK >= 0 {
    const want = fsIntrinsicArity(fsK)
    let a = 0
    while a < c.callArgs.length {
      kinds.push(
        if fsArgIsI64(fsK, a) && !fsArgIsU8List(fsK, a) { 3 } else { 0 },
      )
      a = a + 1
    }
    let why = ""
    if want < 0 || c.callArgs.length != want {
      why = "emitProgram: internal: "
        + nm
        + " reached with "
        + i32ToStr(c.callArgs.length)
        + " argument(s) — the checker's arity rule refuses it"
    } else if fsIdxAt(fsK) < 0 {
      why = "emitProgram: '"
        + nm
        + "' is called but no import was reserved for it — the use scan and the call lowering have drifted"
    }
    const fp: HostCallPlan = {
      hpImport: fsIdxAt(fsK),
      hpKinds: kinds,
      hpVoid: fsRetIsVoid(fsK),
      hpFail: why,
    }
    return fp
  }
  const exK = externLinkOf(nm)
  const want = externArityAt(exK)
  let a = 0
  while a < c.callArgs.length {
    const pt = externParamAt(exK, a)
    kinds.push(
      if pt == "i64" { 3 } else if pt == "f64" { 4 } else if pt == "f32" { 5 } else { 0 },
    )
    a = a + 1
  }
  let why = ""
  if want < 0 || c.callArgs.length != want {
    why = "emitProgram: internal: extern "
      + nm
      + " reached with "
      + i32ToStr(c.callArgs.length)
      + " argument(s) — the checker's arity rule refuses it"
  } else if externIdxAt(exK) < 0 {
    why = "emitProgram: extern '"
      + nm
      + "' is called but no import was reserved for it — the manifest and the call lowering have drifted"
  }
  const ep: HostCallPlan = {
    hpImport: externIdxAt(exK),
    hpKinds: kinds,
    hpVoid: externRetIsVoid(exK),
    hpFail: why,
  }
  return ep
}

// The host-call arm of `emitCallCore`: each argument at its plan's kind, then the reserved
// import (`hostCallTail`). Returns 0 once emitted, -1 on failure.
function emitCallCoreHost(c: Call, fnIx: i32) {
  const pl = hostCallPlanOf(c)
  if pl.hpFail != "" { return emitFail(pl.hpFail) }
  let a = 0
  while a < c.callArgs.length {
    const k = pl.hpKinds[a]
    const rc = if k == 0 { emitExpr(c.callArgs[a], fnIx) } else { emitWidened(c.callArgs[a], k, fnIx) }
    if rc < 0 { return -1 }
    a = a + 1
  }
  return hostCallTail(pl.hpImport)
}

// After a host call's arguments: the `call` of its reserved import.
export function hostCallTail(imp: i32): i32 {
  fbCall(imp)
  return 0
}

// Whether call `c` names the `__trap__` intrinsic: the spelling, with no binding in scope owning
// the name (`identNameIsUserBound`), as every dunder arm of `emitCallCoreIdent` asks.
export function trapCallNamed(c: Call, fnIx: i32): boolean {
  if c.callFn < 0 { return false }
  const f = nodeAt(c.callFn)
  if !(f is Ident) || f.identName != "__trap__" { return false }
  return !identNameIsUserBound(c.callFn, fnIx)
}

// The `__trap__(msg?)` arm of `emitCallCore`. Returns 0 once emitted, -1 on failure.
function emitCallCoreTrap(c: Call, fnIx: i32) {
  if c.callArgs.length > 1 {
    return emitFail("emitProgram: __trap__ takes an optional string message")
  }
  // `__trap__("reason")`: stream the message to the host boundary FIRST
  // (the same `__print_char__`/`__print_str_flush__` path `print(<string>)`
  // uses), so an abort carries a human-readable reason, THEN `unreachable`.
  if c.callArgs.length == 1 {
    // An atom message is an interned id, not a string ref; it decodes as `print(atom)` does.
    const msg = c.callArgs[0]
    if exprIsLitAtom(msg, fnIx) {
      if emitStashAtomId(msg, fnIx) < 0 { return -1 }
      if printAtomStashed(printAtomTexts("atom", msg, fnIx), false) < 0 {
        return -1
      }
    } else if emitPrintStrExpr(msg, fnIx) < 0 {
      return -1
    }
  }
  fbUnreachable()
  return 0
}

// The direct call node a UFCS `self`-method call `o.f(args)` rewrites to, `f(o, args)` with
// named arguments shifted past the receiver, or -1 when `f` takes no leading `self`.
function emitCallCoreUfcsNode(callIx: i32, c: Call, um: Member) {
  // a UFCS member-call normally lowers to a direct `Ident` call before emission;
  // this fallback re-derives the same direct call should it reach emit unrewritten.
  // D1120 — at the site, the same node the merge walk keys on.
  let uName = ufcsAliasAtSite(callIx, um.memProp)
  const ud = memberDeclOf(callIx)
  if ud >= 0 {
    if memberMethodOf(callIx) != ud { return -1 }
    uName = binderNameAt(ud)
  }
  const uTarget = fnIndexOf(uName)
  if uTarget >= 0 {
    const uFn = nodeAt(fnStmts[uTarget])
    if uFn is FuncDecl {
      const uParams = uFn.fnParams
      if uParams.length == c.callArgs.length + 1 {
        const uP0 = nodeAt(uParams[0])
        if uP0 is Param {
          if uP0.parName == "self" {
            const uArgs: i32[] = []
            uArgs.push(um.memObj)
            let ua = 0
            while ua < c.callArgs.length {
              uArgs.push(c.callArgs[ua])
              ua = ua + 1
            }
            // The injected receiver is an UNNAMED slot-0 positional; any
            // named args shift right with it ("" rides slot 0) so the
            // rebuilt direct call reorders them around the receiver
            // exactly as the host does.
            const uNames: string[] = []
            if hasNamedArgs(c.callArgNames) {
              uNames.push("")
              let un = 0
              while un < c.callArgNames.length {
                uNames.push(c.callArgNames[un])
                un = un + 1
              }
            }
            return mkCallN(mkIdent(uName, -1), uArgs, uNames, -1)
          }
        }
      }
    }
  }
  return -1
}

// Whether a call of `callee`, a name no function in scope owns, is a closure-valued callee
// dispatched through the closure fat-pointer: not where it is a numeric intrinsic's name no
// binding covers here, which is the intrinsic even where a later local closure takes the name
// (D3607).
function unknownCallRoutesRef(c: Call, callee: Ident, fnIx: i32): boolean {
  const intrHere = isNumIntrinsicName(callee.identName)
    && !identNameIsBoundAt(callee.identName, fnIx, c.callFn)
    && globalIndexOf(callee.identName) < 0
  return !intrHere
    && (exprIsClosure(c.callFn, fnIx)
    || bundleParamOfRead(c.callFn, fnIx) >= 0)
}

// Whether call `c` of `callee` reaches the numeric intrinsics in `fnIx`, as
// `emitCallCoreUserFn` routes it: no function of the name in scope, no closure-valued callee,
// and no live frame binding (a captured loop variable), which is the shadowing rule the
// checker types against: a program that defines its own `min` calls its own (D2010).
export function numIntrCallReached(c: Call, callee: Ident, fnIx: i32): boolean {
  if c.callFn < 0 { return false }
  const sid = sidOfNode(c.callFn)
  if fnIndexOfInScopeChainAt(sid, callee.identName, fnIx, c.callFn) >= 0 {
    return false
  }
  if unknownCallRoutesRef(c, callee, fnIx) { return false }
  return !identNameIsLiveBound(callee.identName, fnIx)
}

// The name a call's callee resolves by: a dispatch arm the check built ahead of the lift that names
// its lambda member resolves by that member's declaration (D16999).
function armCalleeName(c: Call, callee: Ident): string {
  if callee.identName != "" { return callee.identName }
  const d = identDeclOf(c.callFn)
  const f = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  return if f is FuncDecl { f.fnName } else { "" }
}

// `emitCallCore`'s user-function tail for callee `callee`: the scope-resolved function's
// direct, captured or low-memory call, a closure binding's `call_ref`, or a numeric
// intrinsic when the name resolves to no function. Returns 0 or -1.
function emitCallCoreUserFn(callIx: i32, c: Call, callee: Ident, fnIx: i32) {
  // Scope-aware: `buildFnMap` keys lifted functions by name, first wins, so the flat map
  // would give every frame's `inner(…)` the module's first `inner`. The positioned lookup
  // takes the block-local function whose scope covers this call, else a top-level one.
  const target = fnIndexOfInScopeChainAt(
    sidOfNode(c.callFn),
    armCalleeName(c, callee),
    fnIx,
    c.callFn,
  )
  // A live closure binding of the name outranks that scan, which cannot see a param or a
  // local (D1602); a local declared later does not yet shadow the function (D3607). Asked
  // only on a hit, so a plain call pays nothing.
  if (
    target >= 0
    && identNameIsLiveBound(callee.identName, fnIx)
    && identIsBoundClosure(c.callFn, fnIx)
  ) {
    return emitCallRef(callIx, fnIx)
  }
  // So does a bundle parameter of the name, which is a record of closures, not one.
  if target >= 0 && bundleParamOfRead(c.callFn, fnIx) >= 0 {
    return emitCallRef(callIx, fnIx)
  }
  if target < 0 {
    if unknownCallRoutesRef(c, callee, fnIx) {
      return emitCallRef(callIx, fnIx)
    }
    if !identNameIsLiveBound(callee.identName, fnIx) {
      const niRc = emitNumIntr(callIx, fnIx, callee.identName)
      if niRc != NUM_INTR_NONE { return niRc }
    }
    if nodeTyAt(c.callFn, fnIx) == TY_NULL { return emitNullCalleeCall() }
    return emitFail("emitProgram: call to unknown function")
  }
  // A lambda-lifted function takes its captures as parameters (SP-037).
  if cloLifted(target) { return emitDirectCall(callIx, fnIx, target) }
  // a direct call to a capturing lifted function (`add(10)` where `add` captures `n`
  // from the enclosing frame): build its closure value and `call_ref` it — a plain
  // `call` would pass a null env and lose the captures. Gated on `fnNestUsed` so a
  // no-lambda module never enters this path.
  if fnNestUsed && captureCountOf(target) > 0 {
    return emitCapturedCall(callIx, fnIx, target)
  }
  if lowMemFoldsCallee(target) {
    const lmaRc = emitLowMemAccessorCall(callIx, fnIx, target)
    if lmaRc <= 0 { return lmaRc }
  }
  return emitDirectCall(callIx, fnIx, target)
}

// `emitCallCore`'s named-callee arm: the builtins and intrinsics matched by spelling where
// no user declaration or binding owns the name, then `emitCallCoreUserFn`. Returns 0 or -1.
function emitCallCoreIdent(callIx: i32, c: Call, callee: Ident, fnIx: i32) {
  // a user function of the same name must win: checked before any spelling-based
  // builtin match, since matching by spelling alone routes a same-named user
  // declaration into the builtin instead — a whole-set bug, not one name's (D975,
  // filed as a refutation pin: that collision surface must not come back).
  const userOwnsName = fnIndexOfNode(c.callFn) >= 0
  // A call through a holder of a returned record picks its member (D15144).
  const hcall = emitHolderCall(callIx, c, fnIx)
  if hcall != 1 { return hcall }
  // the scope's answer for the dunder intrinsics, whose arms below match the
  // spelling with no declaration lookup at all. See `identNameIsUserBound`.
  const userBindsName = identNameIsUserBound(c.callFn, fnIx)
  // `__str_from_bytes__(src, at, count)` (D4784): one call into the helper, which bounds-checks
  // the range against `src`'s length and copies it into an exact-fit string.
  if strFromBytesCallNamed(c, fnIx) { return emitCallCoreStrFromBytes(c, fnIx) }
  // `fromCodePoints(xs)` (H2): bulk string construction into the shared `__utf8_enc__`
  // helper, UTF-8-encoding the list's live code points into an exact-fit backing. Each
  // i32 is a code point, never a byte — filling the buffer by `buf.push(s[i])` instead
  // pushes bytes and double-encodes with no type error, so every `std/` builder uses `for cp`.
  if !userOwnsName && callee.identName == "fromCodePoints" {
    return emitCallCoreFromCodePoints(callIx, c, fnIx)
  }
  // `fromCodePoint(code)` is a compiler builtin (H2): construct a single-character VL
  // string from an i32 code point, riding the same `__utf8_enc__` helper `fromCodePoints`
  // does — a one-element i32 array wrapped around the argument. Sharing the encoder
  // avoids a second, inlined width-and-shift ladder disagreeing silently with it.
  if !userOwnsName && callee.identName == "fromCodePoint" {
    return emitCallCoreFromCodePoint(c, fnIx)
  }
  // `print(x)` is a compiler builtin lowered to the host's import family: a
  // boolean-classified arg calls `__print_bool__`, anything else i32-ish
  // `__print_i32__`. The call yields nothing (void import).
  if !userOwnsName && callee.identName == "print" {
    return emitCallCorePrint(callIx, c, fnIx)
  }
  // Every load and store width (`buffer-design.md` §C2), lowered inline: the address, a store's
  // value at its declared width, then the opcode at its natural alignment (`memAccessPlanOf`).
  if memAccessCallNamed(c, fnIx) {
    return emitCallCoreMemAccess(c, callee.identName, fnIx)
  }
  // the bulk pair (`buffer-design.md` §C3): three i32 operands
  // (no width dispatch, unlike the store arm), pushed in the instruction's own order,
  // which VL's argument order matches — a mismatched order would mean reordering
  // arbitrary expressions' side effects.
  if !userBindsName && nameIsMemBulkIntrinsic(callee.identName) {
    return emitCallCoreMemBulk(c, callee, fnIx)
  }
  // The SIMD intrinsics (`simd-design.md` §D6), each lowered inline to a 0xFD-prefix
  // instruction — the third prefixed family, beside the 0xfb GC and 0xfc misc ones.
  // Dispatched by name like the memory intrinsics above it.
  if simdCallNamed(c, fnIx) {
    return emitSimdIntrinsic(c, callee.identName, fnIx)
  }
  // The threads-proposal atomics (`simd-design.md` §G1), the 0xFE-prefix family.
  if !userBindsName && nameIsAtomicIntrinsic(callee.identName) {
    return emitAtomicIntrinsic(c, callee.identName, fnIx)
  }
  // The scalar saturating truncations, one `0xFC` instruction each.
  if !userBindsName && truncSatOp(callee.identName) >= 0 {
    return emitTruncSatIntrinsic(c, callee.identName, fnIx)
  }
  // `memory.size` / `memory.grow` — the two ops that lift the 64 KiB ceiling
  // (`buffer-design.md` §B2/§S4). Both take the memory index as an immediate (0x00,
  // the one memory), never a stack operand. `memory.grow`'s -1-on-failure is the wasm
  // spec's own signal, passed through unchanged: a caller checks it as the spec describes.
  if !userBindsName && callee.identName == "__memory_size__" {
    if c.callArgs.length != 0 {
      return emitFail(
        "emitProgram: internal: __memory_size__ reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    fbMemorySize()
    return 0
  }
  if !userBindsName && callee.identName == "__memory_grow__" {
    if c.callArgs.length != 1 {
      return emitFail(
        "emitProgram: internal: __memory_grow__ reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    if emitExpr(c.callArgs[0], fnIx) < 0 { return -1 }
    fbMemoryGrow()
    return 0
  }
  // The heap window: a read of the immutable global pair `emitGlobalSection` appends.
  if !userBindsName && callee.identName == "__heap_base__" {
    return emitHeapWindowRead(c.callArgs.length, 0, "__heap_base__")
  }
  if !userBindsName && callee.identName == "__heap_limit__" {
    return emitHeapWindowRead(c.callArgs.length, 1, "__heap_limit__")
  }
  // A build-time constant; as the whole condition of an else-less `if` it never
  // reaches here, because `foldMemShared` already decided that statement.
  if !userBindsName && callee.identName == "__memory_shared__" {
    if c.callArgs.length != 0 {
      return emitFail(
        "emitProgram: internal: __memory_shared__ reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    if gSharedMemPages > 0 { fbI32Const(1) } else { fbI32Const(0) }
    return 0
  }
  if !userBindsName && callee.identName == "__log__" {
    return emitCallCoreLog(c, fnIx)
  }
  // ── host calls: the `std:fs` floor and user `extern function`s ─────────────
  // Each lowers to a call of an import reserved only when used, so a miss fails loudly. An
  // extern is guarded like every spelling-matched arm: a parameter of its name must win.
  if hostCallNamed(c, fnIx) { return emitCallCoreHost(c, fnIx) }
  // The array-intrinsic floor (std-design D1 / collections-design §LS.2),
  // lowered INLINE to single WasmGC instructions (array.new /
  // array.new_default / array.copy / unreachable). `__trap__()` is the
  // deliberate abort primitive.
  if trapCallNamed(c, fnIx) { return emitCallCoreTrap(c, fnIx) }
  // `__array_new__(n, fill)` → `array.new` (every slot set to `fill`);
  // `__array_new_default__(n)` → `array.new_default` (slots zeroed). Both yield the
  // `{backing, len: n, cap: n}` list wrapper, staging the length in the 1-slot arrNew
  // scratch local. Native element coverage: i32 (i32/boolean) and, for `__array_new__`, f64.
  if arrNewCallNamed(c, fnIx) { return emitArrayNewIntr(callIx, fnIx) }
  // `__array_copy__(dst, dstAt, src, srcAt, count)` → `array.copy` over the two
  // lists' backings (memmove semantics; OOB spans trap via the instruction's own
  // check). Operand order matches the instruction's stack shape, so no scratch is needed.
  if arrCopyCallNamed(c, fnIx) { return emitArrayCopyIntr(callIx, fnIx) }
  return emitCallCoreUserFn(callIx, c, callee, fnIx)
}

// A call through a value this instance types `null` itself, which a guard leaves dead: the
// stack-polymorphic `unreachable` stands in for its result (D3197).
function emitNullCalleeCall(): i32 {
  fbUnreachable()
  return 0
}

// Node shapes read: Call { callFn: i32, callArgs: i32[] }, callee Ident { identName }.
function emitCallCore(callIx: i32, fnIx: i32) {
  const c = nodeAt(callIx)
  if c is Call {
    const tplStr = tplStrHoleOf(c, fnIx)
    if tplStr >= 0 { return emitStrValue(tplStr, fnIx) }
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Ident { return emitCallCoreIdent(callIx, c, callee, fnIx) }
    // A non-Ident callee yielding a function value (`o.go(10)`, `(expr)(args)`):
    // `call_ref` over the closure fat-pointer.
    if exprIsClosure(c.callFn, fnIx) { return emitCallRef(callIx, fnIx) }
    // A field's place holding a returned record whole calls the member at its signature (B2).
    if placeRecordSigs(callIx, fnIx).length > 0 {
      return emitCallRef(callIx, fnIx)
    }
    // A call of a returned record's member, picked where the inner call is emitted.
    if callResultMemberTy(unwrapParen(c.callFn), fnIx) >= 0 {
      return emitCallRef(callIx, fnIx)
    }
    // a UFCS `self`-method call: `o.f(args)` where `f` is a free function whose first
    // parameter is named `self` lowers to the direct call `f(o, args)`, by building the
    // direct-call node in the arena and re-lowering it so every coercion path is shared.
    const um = nodeAt(c.callFn)
    if um is Member {
      const uCall = emitCallCoreUfcsNode(callIx, c, um)
      if uCall >= 0 { return emitCall(uCall, fnIx) }
    }
    // `p?.f(…)` reaches here only when the guard's receiver cannot be read twice (a call, an
    // operator result): `drwOptGuard` declined rather than evaluate it once per arm. Naming
    // it beats "callee is not a function name", which describes the swap, not the reason.
    if um is OptMember {
      return emitFailAt(
        "emitProgram: an optional call needs a receiver the guard can read twice — bind it to a name first",
        callIx,
      )
    }
    if nodeTyAt(c.callFn, fnIx) == TY_NULL { return emitNullCalleeCall() }
    // An instance binding a type parameter to `never` reaches no call through it (D3178).
    if nodeTyAt(c.callFn, fnIx) == TY_NEVER { return emitNullCalleeCall() }
    if um is Member && nodeTyAt(um.memObj, fnIx) == TY_NEVER {
      return emitNullCalleeCall()
    }
    // A `?.` guard's arm over a receiver this instance types `null` is dead (D16841).
    if um is Member && nodeTyAt(um.memObj, fnIx) == TY_NULL {
      return emitNullCalleeCall()
    }
    return emitFail("emitProgram: callee is not a function name")
  }
  return emitFail("emitProgram: expected a call expression")
}

// The argument value nodes of the call at `callIx`, bound into parameter order for a direct
// call to the function at fnStmts position `target`. An all-positional call returns its
// source list untouched; a named call reorders by the callee's parameter names. A binding
// failure surfaces as a -1 slot/surplus entry, which `directArgsBad` detects.
function orderedDirectArgs(callIx: i32, target: i32) {
  const none: i32[] = []
  const c = nodeAt(callIx)
  if c is Call {
    if !hasNamedArgs(c.callArgNames) { return c.callArgs }
    const pNames: string[] = []
    const d = nodeAt(fnStmts[target])
    if d is FuncDecl {
      const ps = d.fnParams
      let i = 0
      while i < ps.length {
        const p = nodeAt(ps[i])
        if p is Param { pNames.push(p.parName) }
        i = i + 1
      }
    }
    return orderArgsByParamNames(pNames, c.callArgs, c.callArgNames)
  }
  return none
}

// Is the argument at `argIx` a plain struct whose emitted heap type is union-arm `vi`'s —
// a declared layout twin sharing one heap type in the emitted module? The predicate
// (`sHeapIdx[row] == variantHeap(vi)`) is the same test `emitUnionBoxArg` runs at the box
// boundary. False for a non-struct argument, an unresolvable row, or a slot outside the variant table.
function cloArgIsArmHeapTwin(argIx: i32, vi: i32, fnIx: i32): boolean {
  if vi < 0 { return false }
  if vi >= uVarRow.length { return false }
  if !exprStruct(argIx, fnIx) { return false }
  const si = structIndexOfExpr(argIx, fnIx)
  if si < 0 { return false }
  if si >= sHeapIdx.length { return false }
  return sHeapIdx[si] == variantHeap(vi)
}

// The lifted slot the callee `calleeIx` names when it reads a `const` bound to a
// lambda-lifted function in frame `fnIx`, else -1.
export function cloLiftCalleeOf(calleeIx: i32, fnIx: i32): i32 {
  if fnIx < 0 || calleeIx < 0 || calleeIx >= P.nodes.length { return -1 }
  const callee = nodeAt(calleeIx)
  if !(callee is Ident) { return -1 }
  const li = identLetOfRead(calleeIx, fnIx)
  if li < 0 { return -1 }
  return cloLiftLetFe(fnStmtsPosOf(fnIx), li)
}

// A narrowed `X | null` argument keeps its nullable rep, so a parameter of non-null kind `pk`
// whose slot is a bare `(ref $heap)` takes it through `ref.as_non_null`. The checker proved
// the call guarded, so the recover cannot trap. `null` or any other kind is a no-op.
function emitNonNullParamRecover(pk: VKind | null, argIx: i32, fnIx: i32) {
  match pk {
    "struct" | "variant" => {
      if exprNullableRecord(argIx, fnIx) { fbRefAsNonNull() }
    }
    "list" | "strlist" | "f64list" | "i64list" | "f32list" | "v128list" | "reflist" | "map" => {
      if (
        exprNullableList(argIx, fnIx)
        || exprNulScalarListKind(argIx, fnIx) != null
        || exprNullableRefArray(argIx, fnIx)
        || exprNullableMap(argIx, fnIx)
      ) {
        fbRefAsNonNull()
      }
    }
    "closure" => {
      if exprNulClosure(argIx, fnIx) { fbRefAsNonNull() }
    }
    "i32" | "str" | "union" | "nulvariant" | "nulstruct" | "i64" | "f64" | "f32" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" | "v128" | null => {
      // Scalars and atoms have no reference to recover, a nullable slot takes the value as
      // it is, and a union box or a `u8[]` is never narrowed into a bare heap slot.
    }
  }
  return 0
}

// The call of a function value. The caller's context is restored on every exit.
function emitCallRef(callIx: i32, fnIx: i32) {
  return emitCallRefUnder(callIx, fnIx)
}

// One argument of a function-value call: applies `argBase` with the seeds of parameter `i`
// of `ckey`, then lowers `args[i]` coerced to that parameter. Returns -1 on a failure, 1 when it
// took the general arm with nothing owed, else 0.
function emitCallRefArg(
  callIx: i32,
  fnIx: i32,
  ckey: string,
  args: i32[],
  i: i32,
) {
  // Whether the argument is one the IR writes as legacy does (`callRefPlainKey`'s plain path).
  const argPlainArm = callRefArgPlain(callIx, fnIx, ckey, args[i], i)
  // D940 — the struct row the functype declares, seeded exactly as the direct call
  // seeds it from `paramStructIdxOf`: an object-literal argument otherwise resolves
  // its own row by field set, the pre-merge row wherever the callee's parameter row
  // moved. The seed is the key's, so it agrees with the functype by construction.
  const pkk = sigParamKindAt(ckey, i)
  const arm = callRefArgArmOf(callIx, fnIx, ckey, args[i], i)
  match arm {
    "widenI64" => {
      if emitWidened(args[i], 3, fnIx) < 0 { return -1 }
    }
    "widenF64" => {
      if emitWidened(args[i], 4, fnIx) < 0 { return -1 }
    }
    "widenF32" => {
      if emitWidened(args[i], 5, fnIx) < 0 { return -1 }
    }
    "wideIntoI32" => {
      return emitFail(
        "emitProgram: a function value is called at two signatures, and the closure it holds was built for one: this call passes a wider number than its `i32` parameter",
      )
    }
    "heapIntoI32" => {
      return emitFail(
        "emitProgram: a function value is called at two signatures, and the closure it holds was built for one: this call passes a string or a heap value to its `i32` parameter",
      )
    }
    "boxUnrecorded" => {
      // The key says box and the checker records no union for the argument: a producer
      // disagreement. Refuse loudly rather than push the un-boxed operand.
      return emitFail(
        "emitProgram: value-call union parameter has no recorded union for its argument",
      )
    }
    "armNotBuilt" => {
      return emitFail(
        "emitProgram: value-call union-ARM parameter given a value that is not that arm — a value call does not yet build one (annotate the binding as the arm, or call it as a named function)",
      )
    }
    "armUnbox" => {
      const cvSlot = sigParamSlotAt(ckey, i)
      if emitExpr(args[i], fnIx) < 0 { return -1 }
      if exprUnion(args[i], fnIx) {
        if variantHasCrossTagFits(cvSlot, args[i], fnIx) {
          return emitFailCrossTagDelivery(args[i], cvSlot)
        }
        fbStructGet(uBoxIdx, 1)        // 0xfb 0x02 <box ht> field 1: value (anyref)
        fbRefCast(variantHeap(cvSlot)) // 0xfb 0x16 <variant struct> ref.cast (non-null)
      }
    }
    "nulArm" => {
      // The niche parameter (D3074), as the direct call's argument rung builds it: an object
      // literal builds the arm, and a value narrowed out of a box is unboxed to the arm.
      const cnvSlot = sigParamSlotAt(ckey, i)
      if cnvSlot < 0 || cnvSlot >= uVarRow.length {
        return emitFail(
          "emitProgram: value-call nullable union-arm parameter has no variant slot",
        )
      }
      const cnvOwed = narrowedArmNeedsUnbox(args[i], fnIx)
      const cnvHeap = armDestHeapOf("nulvariant", cnvSlot)
      const cnvSeat = armOpen(cnvOwed, cnvHeap, args[i], fnIx)
      if emitExpr(args[i], fnIx) < 0 { return -1 }
      armClose(cnvSeat, cnvOwed, cnvHeap, args[i], fnIx)
    }
    "box" => {
      if emitUnionBoxAtRecord("", -1, args[i], fnIx) < 0 { return -1 }
    }
    "atomToStr" => {
      // A literal-union atom into a `string` parameter widens to its member string, since the
      // functype declares a string ref there and the atom local holds an i32 id (D3189).
      if emitAtomToStr(args[i], fnIx) < 0 { return -1 }
    }
    "scalarList" | "atom" => {
      if emitExpr(args[i], fnIx) < 0 { return -1 }
    }
    "general" => {
      // The parameter's nullability is assigned from the key, as a direct call assigns it
      // from the declaration: an enclosing position's non-null expectation would otherwise
      // recover a `null` argument into a nullable parameter, a trap (D2552).
      // A narrowed struct argument is unboxed at the key's slot, as a direct call does (D1723).
      const pkOwed = pkk != null && narrowedArmNeedsUnbox(args[i], fnIx)
      const pkHeap = if pkk != null { armDestHeapOf(pkk, sigParamSlotAt(ckey, i)) } else { -1 }
      const pkSeat = armOpen(pkOwed, pkHeap, args[i], fnIx)
      if emitExpr(args[i], fnIx) < 0 { return -1 }
      armClose(pkSeat, pkOwed, pkHeap, args[i], fnIx)
    }
  }
  // The same boundary as a direct call's, keyed off the `$fnsig` param (D2537).
  emitNonNullParamRecover(pkk, args[i], fnIx)
  return if argPlainArm { 1 } else { 0 }
}

// Whether argument `a` is one the IR writes as `emitCallRefArg` does: a widening into a wider
// number, or the general arm with nothing owed at a scalar of the argument's own width, a string,
// a record neither unboxed from a narrowing nor nullable, or a non-null closure, list or map.
export function callRefArgPlain(
  callIx: i32,
  fnIx: i32,
  ckey: string,
  a: i32,
  i: i32,
): boolean {
  const arm = callRefArgArmOf(callIx, fnIx, ckey, a, i)
  if arm == "widenI64" || arm == "widenF64" || arm == "widenF32" { return true }
  if arm != "general" { return false }
  if tyIsLitUnion(nodeTyAt(a, fnIx)) { return false }
  const k = sigParamKindAt(ckey, i)
  if k == "str" { return true }
  if k == "struct" {
    return !narrowedArmNeedsUnbox(a, fnIx) && !exprNullableRecord(a, fnIx)
  }
  if k == "closure" { return !exprNulClosure(a, fnIx) }
  if (
    k == "list"
    || k == "strlist"
    || k == "f64list"
    || k == "i64list"
    || k == "f32list"
    || k == "reflist"
    || k == "map"
  ) {
    return !narrowedArmNeedsUnbox(a, fnIx)
      && !exprNullableList(a, fnIx)
      && exprNulScalarListKind(a, fnIx) == null
      && !exprNullableRefArray(a, fnIx)
      && !exprNullableMap(a, fnIx)
  }
  return (k == "i32" || k == "i64" || k == "f64" || k == "f32")
    && exprScalarWidth(a, fnIx) == k
}

// How a function-value call writes argument `a`, parameter `i` of key `ckey`, in
// `emitCallRefArg`'s order: a widening, a refusal, the union-arm or box arms, an atom's string,
// or the general arm. The IR asks it too, and builds only the general arm.
export type CallRefArgArm = "widenI64"
  | "widenF64"
  | "widenF32"
  | "wideIntoI32"
  | "heapIntoI32"
  | "boxUnrecorded"
  | "armNotBuilt"
  | "armUnbox"
  | "nulArm"
  | "box"
  | "atomToStr"
  | "scalarList"
  | "general"
  | "atom"

// The arm `emitCallRefArg` takes for argument `a` (parameter `i` of key `ckey`) of call `callIx`.
export function callRefArgArmOf(
  callIx: i32,
  fnIx: i32,
  ckey: string,
  a: i32,
  i: i32,
): CallRefArgArm {
  const pkk = sigParamKindAt(ckey, i)
  // An argument's raw-read seeds are its parameter's alone, as at a direct call (D3816).
  const pck = sigParamCoerceKind(ckey, i)
  if pck == "i64" { return "widenI64" }
  if pck == "f64" { return "widenF64" }
  if pck == "f32" { return "widenF32" }
  // A wide number has no conversion into an `i32` parameter: the value's set is one closure
  // whose calls disagree on a signature (D15062).
  const aw = if pkk == "i32" { exprScalarWidth(a, fnIx) } else { "" }
  if aw == "f64" || aw == "i64" || aw == "f32" { return "wideIntoI32" }
  // A member-literal argument into a literal-union parameter lowers as its interned atom id, and
  // `null` into a `K | null` one as the sentinel; an un-annotated parameter pinned at a literal
  // union has only the `i` token, so an atom argument makes it the atom (D3076).
  let clu = cloCallParamLitUnion(callIx, i, fnIx)
  if clu == 0 && (pkk == "i32" || pkk == null) {
    if tyIsLitUnion(nodeTyAt(a, fnIx)) { clu = 1 }
  }
  // Nor has a string or a heap value, outside a literal union's atom, where the call has an
  // interned signature; with none, the signature refusal names the gap (D15338, D15011).
  if (
    clu == 0
    && pkk == "i32"
    && cloSigTypeIdxAt(cloSigPosOfKey(ckey)) >= 0
    && (exprString(a, fnIx)
      || exprStruct(a, fnIx)
      || exprArray(a, fnIx)
      || exprMap(a, fnIx))
  ) {
    return "heapIntoI32"
  }
  // The value-union parameter takes the box, whose kind comes off the key (D712).
  const cuBox = pkk == "union"
  if cuBox && !boxOwedAtRecord(a, fnIx) { return "boxUnrecorded" }
  // An arm parameter demands one heap type, so a raw push is a floor except where it is
  // provably safe: a box narrowed to the arm, an object literal, or a layout twin (D269, D732).
  if pkk == "variant" {
    const cvSlot = sigParamSlotAt(ckey, i)
    const cvArg = nodeAt(unwrapParen(a))
    const cvBuildable = cvSlot >= 0
      && (exprUnion(a, fnIx)
      || cvArg is ObjLit
      || cloArgIsArmHeapTwin(a, cvSlot, fnIx))
    if exprVariantIndex(a, fnIx) < 0 {
      if !cvBuildable { return "armNotBuilt" }
      if cvSlot >= 0 { return "armUnbox" }
    }
  }
  if pkk == "nulvariant" { return "nulArm" }
  if cuBox { return "box" }
  if (pkk == "str" || pkk == "nulstr") && exprIsLitAtom(a, fnIx) {
    return "atomToStr"
  }
  if clu == 0 && (isScalarBackedListRep(pkk) || isNulScalarListKind(pkk)) {
    return "scalarList"
  }
  if clu == 0 { return "general" }
  return "atom"
}
// The first argument whose type at frame `fnIx` is a scalar or string other than the one
// parameter `i` of function `fe` takes, which no coercion bridges; -1 when every argument fits.
export function directCallInstanceArgMisfit(
  args: i32[],
  fe: i32,
  fnIx: i32,
): i32 {
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    let i = 0
    while i < args.length && i < fn.fnParams.length {
      if cloArgInstanceMisfits(args[i], vtKindOfParam(fn.fnParams[i]), fnIx) {
        return i
      }
      i = i + 1
    }
  }
  return -1
}

// Does argument `argIx`, typed by a type variable that instance `fnIx` binds to a scalar or
// string, meet a parameter of another such kind `pk`? A null `pk` never misfits.
function cloArgInstanceMisfits(
  argIx: i32,
  pk: VKind | null,
  fnIx: i32,
): boolean {
  if pk == null || !cloArgKindIsPlain(pk) { return false }
  const own = nodeTyIxOf(unwrapParen(argIx))
  if own < 0 || !tyHasTyVar(own) { return false }
  if exprString(argIx, fnIx) { return pk != "str" }
  if exprIsF64(argIx, fnIx) { return pk != "f64" }
  if exprIsI64(argIx, fnIx) { return pk != "i64" }
  // An i32 widens into a numeric parameter, so only a string parameter refuses it.
  const it = instanceTyOf(own, fnIx)
  if it < 0 || tyIsLitUnion(it) { return false }
  const d = repOfTy(it)
  return d.rdKind == "i32" && pk == "str"
}

// The `let`/`const` callee `ix` reads, also when the monomorphizer renamed it to an
// instance; -1 when it names a function.
function callFnBindingOf(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length || !(nodeAt(ix) is Ident) { return -1 }
  const d = identDeclOf(ix)
  if d >= 0 && d < P.nodes.length && nodeAt(d) is LetDecl { return d }
  return monoAliasDeclOf(ix)
}

function cloArgKindIsPlain(k: VKind): boolean {
  return k == "i32" || k == "i64" || k == "f64" || k == "f32" || k == "str"
}

// `emitCallRef`'s body: each argument applies its parameter's context and leaves it for the
// wrapper's exit to undo.
function emitCallRefUnder(callIx: i32, fnIx: i32) {
  const c = nodeAt(callIx)
  if c is Call {
    const liftFe = cloLiftCalleeOf(c.callFn, fnIx)
    if liftFe >= 0 { return emitDirectCall(callIx, fnIx, liftFe) }
    if hasNamedArgs(c.callArgNames) {
      return emitFail(
        "emitProgram: named arguments work only on declared functions, not on a function value",
      )
    }
    // A call through a bundle reads the closure for its own signature (D14841).
    const bun = emitBundleCall(callIx, c, fnIx)
    if bun != 1 { return bun }
    const hcall = emitHolderCall(callIx, c, fnIx)
    if hcall != 1 { return hcall }
    if irShadowOn { callRefLegacyPlain[callIx] = "" }
    // Evaluate the closure once into the call-ref scratch local (`callRefNestSlot`).
    if emitExpr(c.callFn, fnIx) < 0 { return -1 }
    // A NULLABLE function value (`fn | null`, kind 19) loads as `(ref null $cloStruct)`;
    // the scratch slot is non-null, and the checker proved it non-null here (the `if c !=
    // null` narrowing), so recover to non-null.
    if exprNulClosure(c.callFn, fnIx) { fbRefAsNonNull() }
    const crDepth = callRefDepth
    const crSlot = callRefStash()
    // the callee's interned `$fnsig` key — from a function-typed annotation, an inferred
    // binding's sig, a field closure's, or a closure-array element's. Its tokens drive
    // argument coercion below and resolve the functype `ref.cast`s to; "" falls back to
    // the all-i32 arity sig.
    const ckey = cloCallSigKey(callIx, fnIx)
    // A key taking fewer parameters than the call passes names a function the value no
    // longer holds (a pruned dead binding's signature); its `call_ref` would not validate (D7142).
    if (
      ckey != ""
      && c.callArgs.length > 0
      && sigParamKindAt(ckey, c.callArgs.length - 1) == null
    ) {
      return emitFail(
        "emitProgram: a function value's signature is not known at this call — the type it was given takes fewer parameters than the call passes",
      )
    }
    // soundness floor: a value-union closure result with a composite member (`(i32) => f32
    // | {w:i32}`) is not yet representable — the lambda infers its one concrete arm while
    // the checker types the call as the whole union, so the narrow that reads it mis-reads
    // the plain rep as the box. Reject rather than leak the unsound narrow to invalid wasm.
    if cloCallUnionResultUnrepresentable(callIx, fnIx) {
      return emitFail(
        "emitProgram: value-union closure RESULT is not yet representable",
      )
    }
    // A ref-list closure result whose PRODUCER lambda and cast annotation key distinct,
    // non-layout-twin element slots (a nullable-element list built from a non-null literal):
    // the wrapper structs are distinct heap types, so the call-ref `ref.cast` would TRAP.
    // Reject cleanly — the deferred nullable-element ref-list composition.
    if cloCallReflistElemTwin(callIx, fnIx) {
      return emitFail(
        "emitProgram: closure ref-list result element twin (deferred value-ABI composition)",
      )
    }
    if emitCallRefAt(callIx, c, fnIx, ckey, crDepth, crSlot) < 0 { return -1 }
    // A top-level lambda's returned record: the member its use takes, as for a direct call.
    const tfe = topLambdaRecordFe(unwrapParen(c.callFn))
    if tfe >= 0 { return emitBundleResultPick(callIx, tfe, fnIx) }
    if irShadowOn && callRefLastPlain && !exprNulClosure(c.callFn, fnIx) {
      callRefLegacyPlain[callIx] = ckey
    }
    return 0
  }
  return emitFail("emitProgram: expected a call expression")
}

// `emitCallRefUnder`'s call of the closure stored in `crSlot` at `$fnsig` key `ckey`: its env,
// the arguments coerced to the key's parameters, then the indirect call. 0, or -1.
function emitCallRefAt(
  callIx: i32,
  c: Call,
  fnIx: i32,
  ckey: string,
  crDepth: i32,
  crSlot: i32,
): i32 {
  callRefEnvOpen(crSlot, crDepth)
  let argsPlain = true
  // args, each COERCED to its parameter's scalar valtype (an i32 literal widened into an i64 / f64
  // / f32 param) — the `call_ref` functype demands the exact valtype, exactly as a direct call.
  const args = c.callArgs
  // each argument's valtype is decided by its parameter, so an enclosing wide-scalar
  // context must not leak into it — else a bare i32 literal argument under an outer f32/atom
  // context lowers at the wrong valtype for the `call_ref` functype: invalid wasm.
  let i = 0
  while i < args.length {
    const bty: i32[] = [0 - 1]
    const bsigs = bundleCallArgSigs(c.callFn, fnIx, i, bty)
    const kt = if bsigs.length > 0 { -1 } else { bundleKeyParamTy(ckey, i, args[i]) }
    if bsigs.length > 0 || kt >= 0 || emitBundleRecordRead(args[i], fnIx) {
      argsPlain = false
    }
    if bsigs.length > 0 {
      if emitBundleReadArg(args[i], bty[0], bsigs, fnIx) < 0 { return -1 }
    } else if kt >= 0 {
      if (
        emitBundleReadArg(args[i], kt, elabDeliveredBundleSigs(kt), fnIx)
        < 0
      ) {
        return -1
      }
    } else if (
      emitBundleRecordRead(args[i], fnIx)
      && !bundleSlotTakesRecord(ckey, i, args[i], fnIx)
    ) {
      if emitBundleMemberArg(args[i], fnIx) < 0 { return -1 }
    } else {
      const ra = emitCallRefArg(callIx, fnIx, ckey, args, i)
      if ra < 0 { return -1 }
      if ra == 0 { argsPlain = false }
    }
    i = i + 1
  }
  callRefDepth = crDepth
  // The judge let a call whose members return different types through for its set to be
  // tagged; left a closure set, the call would run each member at one signature (D15926).
  if fnTagCallSplits(callIx) && !fnTagSetIsTagged(fnTagCallSetOf(callIx)) {
    return emitFail(
      "emitProgram: this call runs functions that return different types, and one of them is also held where it cannot be stored as one of the functions this value may hold, so the call has no one signature",
    )
  }
  // A set of functions with different results, handed to an un-annotated parameter and left
  // closures, is typed in the instance at one member's signature: the call would run the others
  // at it (D16747).
  if closureCallSetSplits(nodeTyAt(c.callFn, fnIx), elabSrcDecl(fnIx)) {
    return emitFail(
      "emitProgram: this call runs a function value that may hold any of a set of functions returning different types, held where the instance keeps them at one signature; dispatching such a call per function is not built yet",
    )
  }
  // id = closure.id (field 1) — the callee's wasm function index, `call_indirect`'d at
  // the concrete `$fnsig` (the engine signature-checks the callee against it).
  let sig = -1
  if ckey != "" { sig = cloSigTypeIdxAt(cloSigPosOfKey(ckey)) }
  // The arity type takes `i32` in every slot, and an argument the key coerced wider has no
  // conversion into one: the closure is built at another of the value's signatures (D16531).
  let wi = 0
  while sig < 0 && wi < args.length {
    if sigParamCoerceKind(ckey, wi) != null {
      return emitFail(
        "emitProgram: a function value is called at two signatures, and the closure it holds was built for one: this call passes a wider number than its `i32` parameter",
      )
    }
    wi = wi + 1
  }
  if sig < 0 && !cloCallArityFallbackUnsound(callIx, fnIx) {
    sig = fnSigIdxForArity(args.length)
  }
  if sig < 0 {
    return emitFail(
      "emitProgram: a function-value call has no interned signature — "
        + cloCallSigRejectWhat(callIx, fnIx),
    )
  }
  // A wide result has no conversion into this call's `i32` result: the closure is built at
  // another of the value's signatures (D15338).
  const rk = sigKeyRetKind(ckey)
  if (
    (rk == "f64" || rk == "i64" || rk == "f32")
    && exprScalarWidth(callIx, fnIx) == "i32"
  ) {
    return emitFail(
      "emitProgram: a function value is called at two signatures, and the closure it holds was built for one: this call reads an `i32` result from a wider one",
    )
  }
  callRefCallTail(crSlot, sig, false)
  armTailCallIndirect(sig, sigKeyRetVoid(ckey))
  callRefLastPlain = argsPlain
  return 0
}

// A closure call's head and tail, which legacy and the IR both write: the closure on the stack
// into the stash of the current nesting depth, which `callRefStash` returns.
export function callRefStash(): i32 {
  const s = callRefNestSlot(callRefDepth)
  fbLocalSet(s)
  return s
}

// The stashed closure's env, the call's first operand; its arguments are written one nesting
// depth below `depth`.
export function callRefEnvOpen(crSlot: i32, depth: i32) {
  fbLocalGet(crSlot)
  fbStructGet(cloStructIdx, 0)
  callRefDepth = depth + 1
  return 0
}

// After the arguments: the stashed closure's function index, called at `$fnsig` type `sig`, in
// its tail form when `tail`.
export function callRefCallTail(crSlot: i32, sig: i32, tail: boolean) {
  fbLocalGet(crSlot)
  fbStructGet(cloStructIdx, 1)
  if tail {
    fbReturnCallIndirect(sig, gFnTableIdx)
  } else {
    fbCallIndirect(sig, gFnTableIdx)
  }
  return 0
}

// Under the IR shadow, by call, the `$fnsig` key legacy wrote a closure call at with no bundle,
// coercion or narrowing arm on the way; "" for any other. `callRefPlainKey` must agree.
let callRefLegacyPlain: {[i32]: string} = Map()
// Whether the closure call last written took only plain arms for its arguments.
let callRefLastPlain = false

// The key legacy wrote closure call `ix` at plainly, under the IR shadow; "" otherwise.
export function callRefLegacyPlainKey(ix: i32): string {
  return callRefLegacyPlain[ix] ?? ""
}

// The `$fnsig` key of call `callIx` in function `fnIx` where legacy writes it as a plain call through
// a closure binding: a name no builtin or function owns, no dispatch, lift, bundle or holder, each
// argument a scalar at its parameter's own valtype, and no refusal on the way; "" for any other.
export function callRefPlainKey(callIx: i32, fnIx: i32): string {
  const c = if callIx >= 0 && callIx < P.nodes.length { nodeAt(callIx) } else { null }
  if !(c is Call) || c.callFn < 0 || hasNamedArgs(c.callArgNames) { return "" }
  const callee = nodeAt(c.callFn)
  if callee is Member {
    if !fieldCallRefPlainHead(callIx, c, callee, fnIx) { return "" }
    return callRefPlainTail(callIx, c, fnIx)
  }
  if !(callee is Ident) {
    if !exprCallRefPlainHead(callIx, c, fnIx) { return "" }
    return callRefPlainTail(callIx, c, fnIx)
  }
  const nm = callee.identName
  const d = identDeclOf(c.callFn)
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  if (
    !(dn is LetDecl || dn is Param)
    || nm.length < 1
    || nm.length >= 2 && nm.slice(0, 2) == "__"
  ) {
    return ""
  }
  if nm == "print" || nm == "fromCodePoint" || nm == "fromCodePoints" {
    return ""
  }
  if fsIntrinsicSlot(nm) >= 0 || externLinkOf(nm) >= 0 { return "" }
  if cloTailRefusal(callIx, fnIx) != "" || callEndsNever(callIx) { return "" }
  if fnTagArmsAt(callIx, emitTagSetAt(callIx, fnIx)).length > 0 { return "" }
  if holderRecordSigs(d, fnIx).length > 0 { return "" }
  // A function of the name in scope makes legacy ask its live scope which one the name means.
  if fnIndexOfInScopeChainAt(sidOfNode(c.callFn), nm, fnIx, c.callFn) >= 0 {
    return ""
  }
  if (
    !unknownCallRoutesRef(c, callee, fnIx)
    || bundleParamOfRead(c.callFn, fnIx) >= 0
  ) {
    return ""
  }
  return callRefPlainTail(callIx, c, fnIx)
}

// `callRefPlainKey`'s head for a function-valued field of a record, `o.f(…)`, which legacy's
// `emitCallCore` sends to `emitCallRef` with no name dispatch: no bundle and no held record.
function fieldCallRefPlainHead(
  callIx: i32,
  c: Call,
  m: Member,
  fnIx: i32,
): boolean {
  return exprIsClosure(c.callFn, fnIx)
    && exprStruct(m.memObj, fnIx)
    && bundleParamOfRead(c.callFn, fnIx) < 0
    && placeRecordSigs(callIx, fnIx).length == 0
}

// `callRefPlainKey`'s head for any other callee expression (`f()(x)`, `fs[0](x)`), which
// `emitCallCore` sends to `emitCallRef` when it is a closure: no bundle and no held record.
function exprCallRefPlainHead(callIx: i32, c: Call, fnIx: i32): boolean {
  return exprIsClosure(c.callFn, fnIx)
    && bundleParamOfRead(c.callFn, fnIx) < 0
    && placeRecordSigs(callIx, fnIx).length == 0
}

// The part of `callRefPlainKey` every callee shares: no lift, nullable value or top-level
// lambda's record, an interned key, no refusal, and each argument a scalar at its parameter's
// own valtype.
function callRefPlainTail(callIx: i32, c: Call, fnIx: i32): string {
  if cloLiftCalleeOf(c.callFn, fnIx) >= 0 || exprNulClosure(c.callFn, fnIx) {
    return ""
  }
  if topLambdaRecordFe(c.callFn) >= 0 { return "" }
  const ckey = cloCallSigKey(callIx, fnIx)
  if ckey == "" { return "" }
  if (
    cloCallUnionResultUnrepresentable(callIx, fnIx)
    || cloCallReflistElemTwin(callIx, fnIx)
  ) {
    return ""
  }
  return callRefPlainArgsTail(callIx, c, fnIx, ckey)
}

// The part of the plain closure call `emitCallRefAt` writes at key `ckey`, which a bundle call
// shares: an interned signature, no split set, each argument plain, and no wider result read
// narrower; `ckey` when it holds, else "".
function callRefPlainArgsTail(
  callIx: i32,
  c: Call,
  fnIx: i32,
  ckey: string,
): string {
  if cloSigTypeIdxAt(cloSigPosOfKey(ckey)) < 0 { return "" }
  const n = c.callArgs.length
  if n > 0 && sigParamKindAt(ckey, n - 1) == null { return "" }
  if (
    fnTagCallSplits(callIx) && !fnTagSetIsTagged(fnTagCallSetOf(callIx))
    || closureCallSetSplits(nodeTyAt(c.callFn, fnIx), elabSrcDecl(fnIx))
  ) {
    return ""
  }
  let i = 0
  while i < n {
    const a = c.callArgs[i]
    const bty: i32[] = [0 - 1]
    if (
      bundleCallArgSigs(c.callFn, fnIx, i, bty).length > 0
      || bundleKeyParamTy(ckey, i, a) >= 0
      || emitBundleRecordRead(a, fnIx)
      || !callRefArgPlain(callIx, fnIx, ckey, a, i)
    ) {
      return ""
    }
    i = i + 1
  }
  const rk = sigKeyRetKind(ckey)
  if (
    (rk == "f64" || rk == "i64" || rk == "f32")
    && exprScalarWidth(callIx, fnIx) == "i32"
  ) {
    return ""
  }
  return ckey
}

// Whether a statement calling function-valued field `m` (call `ix`) leaves nothing to drop: the
// call's key returns nothing, or, unless the call's type is closed, the field's function is void.
function fieldCallStmtVoid(ix: i32, m: Member, fnIx: i32): boolean {
  if sigKeyRetIsVoid(cloCallSigKey(ix, fnIx)) { return true }
  if callTyClosedIn(ix, fnIx) { return false }
  const fe = fieldClosureFeOfRecv(m.memObj, m.memProp, fnIx)
  return fe >= 0 && fRetVoid[fe] == 1
}

// Whether a statement of plain closure call `ix` (`callRefPlainKey`) leaves nothing to drop: its
// key or its callee's read returns nothing, as `emitCallStmtIdent` asks.
export function callRefPlainVoid(ix: i32, fnIx: i32): boolean {
  const c = nodeAt(ix)
  if !(c is Call) { return false }
  const f = if c.callFn >= 0 { nodeAt(c.callFn) } else { null }
  if f is Member { return fieldCallStmtVoid(ix, f, fnIx) }
  return sigKeyRetVoid(cloCallSigKey(ix, fnIx))
    || calleeReturnsVoidOfRead(unwrapParen(c.callFn), fnIx)
}

// Whether parameter `par` takes the lambda literal `arg` as a bundle.
function emitBundleParamTakes(par: i32, arg: i32): boolean {
  return nodeAt(unwrapParen(arg)) is FuncDecl
    && bundleSigsOfParam(par).length > 0
}

// Whether `arg` reads a bundle parameter of function `fnIx`, the record itself.
function emitBundleRecordRead(arg: i32, fnIx: i32): boolean {
  const a = unwrapParen(arg)
  return a >= 0 && nodeAt(a) is Ident && bundleParamOfRead(a, fnIx) >= 0
}

// The bundle read `arg` handed to a parameter that takes one closure: the record's member the
// elaboration chose for that parameter's type. 0, or -1.
function emitBundleMemberArg(arg: i32, fnIx: i32): i32 {
  return emitBundleMemberPick(arg, bundleHandMemberOf(arg), fnIx)
}

// An annotated binding `letIx` initialised with a bundle holder's read: the member its type
// names, picked off the holder's record. 0, -1, or 1 where the binding is no such one.
export function emitTypedHolderInit(letIx: i32, fnIx: i32): i32 {
  const tm = typedHolderMember(letIx, fnIx)
  const ln = nodeAt(letIx)
  if tm < 0 || !(ln is LetDecl) { return 1 }
  return emitBundleMemberPick(ln.letInit, tm, fnIx)
}

// The bundle member binding `letIx` in function `fnIx` picks off its holder's read, or -1.
export function typedHolderMember(letIx: i32, fnIx: i32): i32 {
  if !elabHasTypedReads() { return -1 }
  return elabTypedReadMemberAt(nodeSrc[letIx] ?? letIx, elabKeyOfFn(fnIx))
}

// The bundle read `arg`'s member `m`, -1 where the record holds none at the destination's type.
// 0, or -1.
function emitBundleMemberPick(arg: i32, m: i32, fnIx: i32): i32 {
  const rp = bundleParamOfRead(unwrapParen(arg), fnIx)
  const ua = unwrapParen(arg)
  const si = if rp >= 0 { paramStructIdxOf(rp) } else if ua >= 0 && nodeAt(ua) is Ident { holderRecordRow(identDeclOf(ua), fnIx) } else { -1 }
  const fi = if m >= 0 { sFieldIndex(si, "c" + i32ToStr(m)) } else { -1 }
  if fi < 0 || si < 0 || si >= sHeapIdx.length {
    return emitFailAt(
      "emitProgram: a bundle of closures is handed to a parameter whose closure type its record was not built with",
      arg,
    )
  }
  if emitExpr(arg, fnIx) < 0 { return -1 }
  fbStructGet(sHeapIdx[si], fi)
  return 0
}

// Whether parameter `par` takes the function read `arg` in function `fnIx` as a bundle; a read of
// a bundle parameter is the record itself, handed on as it is.
function emitBundleParamReads(par: i32, arg: i32, fnIx: i32): boolean {
  const a = unwrapParen(arg)
  if a < 0 || !(nodeAt(a) is Ident) || bundleSigsOfParam(par).length == 0 {
    return false
  }
  return bundleParamOfRead(a, fnIx) < 0
}

// The function read `arg` delivered to bundle parameter `par`: its closure at each signature, in
// one record. 0, or -1.
function emitBundleParamRead(arg: i32, par: i32, fnIx: i32): i32 {
  const p = nodeAt(par)
  if !(p is Param) || p.parType < 0 {
    return emitFailAt(
      "emitProgram: a function handed as a bundle has no bundle parameter",
      arg,
    )
  }
  return emitBundleReadArg(
    arg,
    nodeTyIxOf(p.parType),
    bundleSigsOfParam(par),
    fnIx,
  )
}

// The lambda literal `arg` delivered to bundle parameter `par`: the closure built at each
// signature, in the record row's field order, in one record. 0, or -1.
function emitBundleArg(arg: i32, par: i32, fnIx: i32): i32 {
  const sigs = bundleSigsOfParam(par)
  const si = paramStructIdxOf(par)
  if (
    si < 0
    || si >= sFieldCount.length
    || si >= sFieldStart.length
    || si >= sHeapIdx.length
  ) {
    return emitFailAt(
      "emitProgram: a lambda called at two signatures has no record row for its closures",
      arg,
    )
  }
  let fi = 0
  while fi < sFieldCount[si] {
    const nm = sFieldNames[sFieldStart[si] + fi]
    let k = 0
    while k < sigs.length && nm != "c" + i32ToStr(k) { k = k + 1 }
    const fe = monoBundleFe(arg, fnIx, sigs, k)
    if fe < 0 {
      return emitFailAt(
        "emitProgram: a lambda called at two signatures has no closure built for one of them",
        arg,
      )
    }
    if emitClosureValueCore(fe, fnIx) < 0 { return -1 }
    fi = fi + 1
  }
  fbStructNew(sHeapIdx[si])
  return 0
}

// Whether parameter `i` of `$fnsig` key `ckey` takes the record the bundle read `arg` holds.
function bundleSlotTakesRecord(
  ckey: string,
  i: i32,
  arg: i32,
  fnIx: i32,
): boolean {
  const rp = bundleParamOfRead(unwrapParen(arg), fnIx)
  const si = paramStructIdxOf(rp)
  return ckey != "" && si >= 0 && sigParamSlotAt(ckey, i) == si
}

// The bundle record type parameter `i` of `$fnsig` key `ckey` takes, where the argument `arg`
// reads a function; -1 for any other parameter or argument.
function bundleKeyParamTy(ckey: string, i: i32, arg: i32): i32 {
  const x = unwrapParen(arg)
  if ckey == "" || x < 0 || !(nodeAt(x) is Ident) { return -1 }
  const d = identDeclOf(x)
  if d < 0 || !(nodeAt(d) is FuncDecl) { return -1 }
  const slot = sigParamSlotAt(ckey, i)
  if slot < 0 { return -1 }
  for t in elabDeliveredBundles() {
    if repRowOfTyStruct(t, repScanLim()) == slot { return t }
  }
  return -1
}

// The signatures of a closure's argument `i` the call through the parameter read `callFn` in
// function `fnIx` takes as a bundle the elaboration delivers, with its record type in `tyOut[0]`;
// none for any other.
function bundleCallArgSigs(
  callFn: i32,
  fnIx: i32,
  i: i32,
  tyOut: i32[],
): i32[] {
  const none: i32[] = []
  if elabDeliveredBundles().length == 0 { return none }
  const cfx = unwrapParen(callFn)
  if cfx < 0 || fnIx < 0 { return none }
  const r = nodeAt(cfx)
  const d = identDeclOf(cfx)
  const fn = nodeAt(fnIx)
  if !(r is Ident) || d < 0 || !(nodeAt(d) is Param) || !(fn is FuncDecl) {
    return none
  }
  for par in fn.fnParams {
    const p = nodeAt(par)
    if p is Param {
      if p.parName == r.identName && p.parType >= 0 {
        const f = tyAt(nodeTyIxOf(p.parType))
        if !(f is TyFunc) || i >= f.fnParamTypes.length { return none }
        const at = f.fnParamTypes[i]
        const sigs = elabDeliveredBundleSigs(at)
        if sigs.length > 0 { tyOut[0] = at }
        return sigs
      }
    }
  }
  return none
}

// The function read `arg` delivered to a closure's parameter of bundle type `bt` holding `sigs`:
// its closure at each signature, in the record row's field order, in one record. 0, or -1.
function emitBundleReadArg(arg: i32, bt: i32, sigs: i32[], fnIx: i32): i32 {
  const si = repRowOfTyStruct(bt, repScanLim())
  if si < 0 || si >= sFieldCount.length || si >= sHeapIdx.length {
    return emitFailAt(
      "emitProgram: a function handed as a bundle has no record row for its closures",
      arg,
    )
  }
  let fi = 0
  while fi < sFieldCount[si] {
    const nm = sFieldNames[sFieldStart[si] + fi]
    let k = 0
    while k < sigs.length && nm != "c" + i32ToStr(k) { k = k + 1 }
    const fe = if k < sigs.length { monoBundleReadFe(arg, fnIx, sigs[k]) } else { -1 }
    if fe < 0 {
      return emitFailAt(
        "emitProgram: a function handed as a bundle has no closure built for one of its signatures",
        arg,
      )
    }
    if emitClosureValueCore(fe, fnIx) < 0 { return -1 }
    fi = fi + 1
  }
  fbStructNew(sHeapIdx[si])
  return 0
}

// The choice `arg` of function reads delivered to a bundle parameter of record type `bt`: the
// record of the arm the condition takes (D15450). 0, or -1.
function emitBundleChoiceArg(arg: i32, bt: i32, sigs: i32[], fnIx: i32): i32 {
  const x = unwrapParen(arg)
  if x < 0 || x >= P.nodes.length {
    return emitFailAt(
      "emitProgram: a choice handed as a bundle has no arm",
      arg,
    )
  }
  const n = nodeAt(x)
  if n is Ident { return emitBundleReadArg(x, bt, sigs, fnIx) }
  if n is Block && n.blkStmts.length == 1 {
    return emitBundleChoiceArg(n.blkStmts[0], bt, sigs, fnIx)
  }
  const si = repRowOfTyStruct(bt, repScanLim())
  if !(n is IfStmt) || n.ifElse < 0 || si < 0 || si >= sHeapIdx.length {
    return emitFailAt(
      "emitProgram: a choice handed as a bundle has an arm that reads no function",
      x,
    )
  }
  if emitCondExpr(n.ifCond, fnIx) < 0 { return -1 }
  fbIfRef(sHeapIdx[si])
  if emitBundleChoiceArg(n.ifThen, bt, sigs, fnIx) < 0 { return -1 }
  fbElse()
  if emitBundleChoiceArg(n.ifElse, bt, sigs, fnIx) < 0 { return -1 }
  fbEnd()
  return 0
}

// Call `c` through a parameter holding a bundle: the closure for the call's own signature, read
// from its field and called at that signature. 1 where the callee holds no bundle.
function emitBundleCall(callIx: i32, c: Call, fnIx: i32): i32 {
  if bundleParamOfRead(c.callFn, fnIx) < 0 { return 1 }
  const pk = bundlePickOf(callIx, fnIx)
  if pk.bpField < 0 {
    return emitFailAt(
      "emitProgram: a call through a lambda called at two signatures matches none of them",
      callIx,
    )
  }
  if emitExpr(c.callFn, fnIx) < 0 { return -1 }
  fbStructGet(pk.bpHeap, pk.bpField)
  const crDepth = callRefDepth
  const crSlot = callRefStash()
  if irShadowOn { callRefLegacyPlain[callIx] = "" }
  const rc = emitCallRefAt(callIx, c, fnIx, pk.bpKey, crDepth, crSlot)
  if rc >= 0 && irShadowOn && callRefLastPlain {
    callRefLegacyPlain[callIx] = pk.bpKey
  }
  return rc
}

// The member a call `callIx` through a bundle parameter (D14841) reads in frame `fnIx`: the
// record's heap, field `c<k>`, that closure's type and its `$fnsig` key; `bpField` -1 for none.
export type BundlePick = { bpHeap: i32, bpField: i32, bpTy: i32, bpKey: string }

export function bundlePickOf(callIx: i32, fnIx: i32): BundlePick {
  const none: BundlePick = { bpHeap: -1, bpField: -1, bpTy: -1, bpKey: "" }
  const c = if callIx >= 0 && callIx < P.nodes.length { nodeAt(callIx) } else { null }
  if !(c is Call) { return none }
  const par = bundleParamOfRead(c.callFn, fnIx)
  if par < 0 { return none }
  const sigs = bundleSigsOfParam(par)
  const si = paramStructIdxOf(par)
  const k = bundleFieldOfCall(par, c.callArgs, fnIx)
  const fi = sFieldIndex(si, "c" + i32ToStr(k))
  if k < 0 || k >= sigs.length || fi < 0 || si < 0 || si >= sHeapIdx.length {
    return none
  }
  const pk: BundlePick = {
    bpHeap: sHeapIdx[si],
    bpField: fi,
    bpTy: sigs[k],
    bpKey: sigKeyOfTy(sigs[k]),
  }
  return pk
}

// `callRefPlainKey` for a call through a bundle parameter, at its member's key; "" for any other.
export function bundleCallRefPlainKey(callIx: i32, fnIx: i32): string {
  const c = if callIx >= 0 && callIx < P.nodes.length { nodeAt(callIx) } else { null }
  if !(c is Call) || c.callFn < 0 || hasNamedArgs(c.callArgNames) { return "" }
  const pk = bundlePickOf(callIx, fnIx)
  if pk.bpField < 0 || pk.bpKey == "" { return "" }
  return callRefPlainArgsTail(callIx, c, fnIx, pk.bpKey)
}

// Whether `arg` reads a `const` holding a returned record whole in function `fnIx`.
function emitHolderRead(arg: i32, fnIx: i32): boolean {
  const a = unwrapParen(arg)
  return a >= 0
    && nodeAt(a) is Ident
    && holderRecordSigs(identDeclOf(a), fnIx).length > 0
}

// A call through a `const` holding a returned record whole: the member the elaboration noted
// for this call, called at its signature (D15144). 1 where the callee is no such holder.
function emitHolderCall(callIx: i32, c: Call, fnIx: i32): i32 {
  const cfx = unwrapParen(c.callFn)
  if cfx < 0 { return 1 }
  // A call through a field's place holding the record whole is the same call (B2).
  const place = nodeAt(cfx) is Member || nodeAt(cfx) is Index
  if !place && !(nodeAt(cfx) is Ident) { return 1 }
  const d = if place { -1 } else { identDeclOf(cfx) }
  const sigs = if place { placeRecordSigs(callIx, fnIx) } else { holderRecordSigs(d, fnIx) }
  if sigs.length == 0 { return 1 }
  const m = holderCallMember(callIx, fnIx)
  const si = if place { bundleRecordRowOfSigs(sigs) } else { holderRecordRow(d, fnIx) }
  const fi = if m >= 0 { sFieldIndex(si, "c" + i32ToStr(m)) } else { -1 }
  if m >= sigs.length || fi < 0 || si < 0 || si >= sHeapIdx.length {
    return emitFailAt(
      "emitProgram: a call through a held record matches none of its signatures",
      callIx,
    )
  }
  if emitExpr(c.callFn, fnIx) < 0 { return -1 }
  fbStructGet(sHeapIdx[si], fi)
  const crDepth = callRefDepth
  const crSlot = callRefNestSlot(callRefDepth)
  fbLocalSet(crSlot)
  return emitCallRefAt(callIx, c, fnIx, sigKeyOfTy(sigs[m]), crDepth, crSlot)
}

// ── statement-sequence lowering ──────────────────────────────────────────────
// A function body is a sequence of statements, lowered onto `body` in order. Control
// flow relies on explicit `return`s rather than block result types: an `if` is a void
// structured block whose branches `return` on their own, so it never yields a value.

// The value of the binding write being emitted, in place or moved to a local by the capture-cell
// rewrite. A generic function written to a binding is instanced or refused by the
// written-binding passes (D3939), so its stub is never called.
let stubWriteRhs = 0 - 1
// Cleared per program by `emitProgram`: a node id is only meaningful in the arena that minted it.
export function stubWriteRhsReset() { return stubWriteRhs = 0 - 1 }

// Lower an assignment `target = value` onto `body`: the value emits at the type the
// checker recorded for it, then the store.
// The variant row of the declared local `lhsIx` names when its cell holds a bare union arm
// (`variant`), else -1. Every value assigned to such a cell is delivered as that arm.
function assignArmCellVariantIdx(lhsIx: i32, fnIx: i32): i32 {
  if identCellVKind(lhsIx, fnIx) != "variant" { return -1 }
  const slot = identCellSlot(lhsIx)
  if slot < 0 || slot >= localIsRef.length || slot >= localStructIdx.length {
    return -1
  }
  if localIsRef[slot] != "variant" { return -1 }
  const vi = localStructIdx[slot]
  if vi < 0 || vi >= uVarRow.length { return -1 }
  return vi
}

function emitAssign(binIx: i32, fnIx: i32) {
  return emitAssignUnder(binIx, fnIx)
}

// `emitAssignUnder`'s module-global arm: the target names no local, so it stores through
// `global.set`, or refuses a name that is no global either. Returns 0 lowered, -1 failed.
function emitAssignGlobal(a: BinExpr, lhsIx: i32, fnIx: i32) {
  // Not a local — a module global? Store with `global.set` (0x24 <globalidx>).
  const gIdx = globalIndexOfSid(sidOfNode(lhsIx))
  if gIdx >= 0 {
    const gLet = globalStmts[gIdx]
    const gaKind = globalCellKind(gLet)
    const gaArmIdx = globalCellArmIdx(gLet, gaKind)
    const gaCellIsArm = gaKind == "variant" || gaKind == "nulvariant"
    // a union-typed global (kind 4) coerces a raw assigned value into the box; three
    // shapes are not that: a literal-union global's cell is a plain `(mut i32)` atom,
    // a concrete-variant RHS must be boxed unconditionally since a union global's
    // cell is always the box, and an arm cell is not the box either.
    const gUNm = letUnionNameOf(gLet, -1)
    // The local arm's rule: a `variant` cell takes the bare arm whatever builds it, and
    // the coerce owns that value's unbox and recover.
    const gaCoerced = gaKind == "variant"
      && gaArmIdx >= 0
      && gaArmIdx < uVarRow.length
    // The narrowed-arm unbox at the same boundary (D1031): `gv = s` under `if s is Circle`.
    const gaArmOwed = !gaCoerced && narrowedArmNeedsUnbox(a.binRight, fnIx)
    const gaArmHeap = if gaArmOwed { armDestHeapOf(gaKind, gaArmIdx) } else { -1 }
    const gaSeat = armOpen(gaArmOwed, gaArmHeap, a.binRight, fnIx)
    if (
      gUNm != ""
      && !tyIsLitUnion(nodeTyIxOf(lhsIx))
      && !bindingTyIsNoBox(letUnionTyIxOf(gLet, -1))
      && !gaCellIsArm
    ) {
      if (emitUnionBoxAtRecord(gUNm, nodeTyIxOf(lhsIx), a.binRight, fnIx) < 0) {
        return -1
      }
    } else if gaCoerced {
      if emitVariantCoerce(gaArmIdx, a.binRight, fnIx) < 0 { return -1 }
    } else if exprIsI64(lhsIx, fnIx) {
      // an i64 global target widens an i32 RHS to i64: the bare `i32.const` otherwise
      // clashes with the i64 slot (the checker accepts the assignment, so it is a
      // soundness hole). An already-i64 RHS makes `emitWidened` a no-op.
      if emitWidened(a.binRight, 3, fnIx) < 0 { return -1 }
    } else if exprIsF64(lhsIx, fnIx) {
      // the f64 twin: an integer-literal RHS needs widening into `(mut f64)`; an
      // f64-literal RHS needs none.
      if emitWidened(a.binRight, 4, fnIx) < 0 { return -1 }
    } else if exprIsF32(lhsIx, fnIx) {
      // the f32 cell: a float RHS must re-encode at single precision, since a bare
      // `.` literal lowers at f64 by default. `emitWidened` re-encodes the literal
      // and delegates everything else. Ordered after the f64 arm: the two classifiers
      // are mutually exclusive over an Ident target, so neither steals the other's cell.
      if emitWidened(a.binRight, 5, fnIx) < 0 { return -1 }
    } else if (
      (gaKind == "str" || gaKind == "nulstr")
      && exprString(lhsIx, fnIx)
      && exprIsLitAtom(a.binRight, fnIx)
    ) {
      // A literal-union atom assigned to a `string` global widens to its member string.
      // A cell laid out as the atom itself takes the atom as it is (D3198).
      if emitAtomToStr(a.binRight, fnIx) < 0 { return -1 }
    } else if gaKind == "nulnone" {
      // D1576 — the module-global twin of the local arm's `nulnone` store: a
      // `null`-typed cell takes `ref.null none` and nothing else.
      if emitNulNoneForEffect(a.binRight, fnIx) < 0 { return -1 }
      fbRefNullNone()
    } else {
      // A literal-union global (`v = "b"` over `let v: K`) takes its member RHS as the
      // interned i32 id, which the value hook decides from the recorded destination type.
      if emitExpr(a.binRight, fnIx) < 0 { return -1 }
    }
    armClose(gaSeat, gaArmOwed, gaArmHeap, a.binRight, fnIx)
    // the nullable-niche recover at the same boundary (D1115) — `g = y` under
    // `if y != null`, into a global whose cell is a non-null ref.
    if !gaCoerced && nulNicheRecoverOwed(gaKind, a.binRight, fnIx) {
      fbRefAsNonNull()
    }
    return emitUserGlobalSet(gIdx) // 0x24 global.set, or a promoted `local.set`
  }
  return emitFail(
    "emitProgram: assignment target is not a parameter, local, or global",
  )
}

// Whether a binding of type `ty` is stored as no union box: a homogeneous literal union, held as
// its atom or base scalar, or a type that is no union at all (a literal union whose binding
// carries its base, `i32`). False with no type, and for `null`: a null hole a later write fills
// holds the box.
function bindingTyIsNoBox(ty: i32): boolean {
  const p = unMemPeelAliasWrapper(ty)
  if p < 0 || p >= T.tys.length { return false }
  if homogLitUnionBase(p) >= 0 { return true }
  const t = tyAt(p)
  if t is TyPrim { return t.primName != "null" }
  return !(t is TyUnion || t is TyNullable)
}

// `emitAssignIdent`'s plain arm: the RHS of `x = v` into a local or parameter cell, seeded with
// the null, struct, list, map, variant and literal-union reps the cell carries. Returns 0 lowered,
// -1 failed.
function emitAssignLocalSeeded(a: BinExpr, fnIx: i32) {
  // The cell's kind decides the RHS rep, not the read's: a narrowed name holds its declared
  // cell, and a literal-union local (`k = "b"`) takes its member RHS as the interned i32 id.
  if emitExpr(a.binRight, fnIx) < 0 { return -1 }
  return 0
}

// `emitAssignUnder`'s arm over a name target `x = v`: the string accumulator, a module
// global, then a local or parameter cell, for the `Ident` target at `lhsIx`. Returns 0 lowered,
// -1 failed.
function emitAssignIdent(binIx: i32, fnIx: i32, a: BinExpr, lhsIx: i32) {
  stubWriteRhs = unwrapParen(a.binRight)
  // the loop-local accumulator: a binding proven by `strAccScan` to append in place
  // into its own buffer's slack instead of allocating a fresh exact-fit string per
  // step — O(n) where the pairwise lowering is O(n^2). An unproven binding never reaches it.
  if strAccAppendOk(binIx, fnIx) { return emitStrAccAppend(binIx, fnIx) }
  const idx = localIndexOf(fnIx, lhsIx)
  if idx < 0 { return emitAssignGlobal(a, lhsIx, fnIx) }
  // a union-typed local (kind 4) coerces a raw assigned value into the box (`u = 3.5`
  // over `let u: i32 | f64` boxes the f64); a union-valued RHS passes through unchanged.
  const aUNm = unionNameOfRead(lhsIx, fnIx)
  // A cell holding the atom is no box, whatever union its template joined (D3268).
  const aAtomCell = aUNm != ""
    && declaredKind(lhsIx) != "union"
    && exprIsLitAtom(lhsIx, fnIx)
  const aArmVi = assignArmCellVariantIdx(lhsIx, fnIx)
  if aArmVi >= 0 {
    // An arm cell takes the bare variant struct whatever builds it: an object literal, an
    // `if` or `match` joining literals, a narrowed box (D4613, D4639).
    if emitVariantCoerce(aArmVi, a.binRight, fnIx) < 0 { return -1 }
  } else if (
    aUNm != ""
    && !bindingTyIsNoBox(unionTyIxOfIdentAt(sidOfNode(lhsIx), fnIx, lhsIx))
    && !aAtomCell
  ) {
    // A union-box local boxes a variant value as an argument does; a variant-init local keeps
    // the raw variant, so it takes the plain coerce. A literal-union target is an atom and falls
    // through below. The union is the checker's recorded one where a registry row answers it,
    // else the target's own.
    const recTy = boxRecordUnionTyOf(boxRecordTyAt(a.binRight, fnIx))
    const recOwn = boxTyName(recTy) != ""
    if declaredKind(lhsIx) == "union" {
      const bTy = if recOwn { recTy } else { nodeTyAt(lhsIx, fnIx) }
      if emitUnionBoxOwed(aUNm, bTy, a.binRight, fnIx) < 0 { return -1 }
    } else {
      const cTy = if recOwn { recTy } else { nodeTyIxOf(lhsIx) }
      if emitUnionBoxOwed(aUNm, cTy, a.binRight, fnIx) < 0 { return -1 }
    }
  } else if exprNulLitUnion(lhsIx, fnIx) {
    // a `K | null` niche target: the i32 cell holds an atom id or sentinel `-1`. Seeded
    // before the `string` branch, which would otherwise widen the member RHS to a heap string.
    if emitExpr(a.binRight, fnIx) < 0 { return -1 }
  } else if exprIsI64(lhsIx, fnIx) {
    // An i64 target (`x = 0` over `let x: i64`) widens an i32 RHS to i64 — without this the
    // bare `i32.const` clashes with the i64 slot (the checker accepts the assignment, so it
    // is a soundness hole). `emitWidened` is a no-op for an already-i64 RHS.
    if emitWidened(a.binRight, 3, fnIx) < 0 { return -1 }
  } else if exprIsF64(lhsIx, fnIx) {
    // An f64 target (`y = 3` over `let y: f64`) widens an i32 RHS to f64, same rationale.
    if emitWidened(a.binRight, 4, fnIx) < 0 { return -1 }
  } else if exprIsF32(lhsIx, fnIx) {
    // An f32 target (`g = 2.5` over `let g: f32`) re-encodes a float RHS at SINGLE
    // precision — the twin of the global arm's f32 cell above, missing here for the
    // same reason and with the same witness (`emitExpr` defaults a bare `.` literal to
    // f64, so the `(mut f32)` slot took an `f64.const`). Params take this arm too.
    if emitWidened(a.binRight, 5, fnIx) < 0 { return -1 }
  } else if exprString(lhsIx, fnIx) && exprIsLitAtom(a.binRight, fnIx) {
    // A literal-union atom assigned to a `string` local widens to its member string.
    if emitAtomToStr(a.binRight, fnIx) < 0 { return -1 }
  } else if identCellVKind(lhsIx, fnIx) == "nulnone" {
    // D1576 — the only value a `null`-typed cell can take is `null`, so this needs no
    // rep decision from either side: `ref.null none`, the RHS still evaluated for effects.
    if emitNulNoneForEffect(a.binRight, fnIx) < 0 { return -1 }
    fbRefNullNone()
  } else {
    if emitAssignLocalSeeded(a, fnIx) < 0 { return -1 }
  }
  // the scalar dual (D965) — `b = e` over a `let b: f64[]`. The destination is an
  // EXPRESSION here, not an annotation or a cell column, so its element kind comes
  // from classifying the LHS — the same classifier the source side uses.
  const asgDE = scalarListElemKind(lhsIx, fnIx)
  if asgDE != null {}
  // the nullable-niche recover at the ASSIGNMENT boundary (D1115) — `z = y` under
  // `if y != null`, into a local or parameter whose slot is a non-null ref. The
  // destination is a NAME here, so its own cell kind is the destination kind.
  // An arm cell's coerce above owns both of the next two steps.
  if (
    aArmVi < 0
    && nulNicheRecoverOwed(identCellVKind(lhsIx, fnIx), a.binRight, fnIx)
  ) {
    fbRefAsNonNull()
  }
  // the narrowed-arm unbox at the ASSIGNMENT boundary, the binding boundary's twin: the
  // destination cell's own `(kind, slot)` columns are the destination, read through the
  // slot rather than the expression's type — the cell is a `variant` for an inferred
  // union's arm and `structIndexOfExpr` answers -1 for it (D1685).
  if aArmVi < 0 && narrowedArmNeedsUnbox(a.binRight, fnIx) {
    const asgSlot = identCellSlot(lhsIx)
    if (
      asgSlot >= 0
      && asgSlot < localIsRef.length
      && asgSlot < localStructIdx.length
    ) {
      emitNarrowedArmUnboxTo(
        armDestHeapOf(localIsRef[asgSlot], localStructIdx[asgSlot]),
        a.binRight,
        fnIx,
      )
    }
  }
  fbLocalSet(idx) // 0x21 local.set
  return 0
}

// `emitAssignIndex`'s stored value `a.binRight` into list `arrIx`, emitted under the target's
// element seeds and re-encoded at its element rep. Returns 0, or -1 failed.
function emitIdxStoreValue(
  fnIx: i32,
  a: BinExpr,
  arrIx: i32,
  st: IdxStore,
): i32 {
  if st.unionNm != "" {
    if (emitUnionBoxAtRecord(st.unionNm, st.unionTy, a.binRight, fnIx) < 0) {
      return -1
    }
  } else if st.nestSlot >= 0 {
    // A nested-list row store: the RHS builds as the INNER list (inert for a
    // non-literal RHS — an ident/call emits unchanged).
    if emitExpr(a.binRight, fnIx) < 0 { return -1 }
  } else if st.sk != null {
    // The stored value re-encodes at the element valtype (a bare-int / int-literal value
    // widens into the f64 slot, exactly as a binding / push does).
    if emitExprAsElem(a.binRight, st.sk, fnIx) < 0 { return -1 }
  } else if arrElemLitUnionTy(arrIx, fnIx) >= 0 {
    // `xs[i] = "a"` over a literal-union array: the member RHS lowers as its atom id —
    // the store half of the boundary `exprIsLitAtom`'s Index arm reads. Without it a
    // monomorphized instance's target classifies off the generic's shared node and
    // falls through to the string-widen arm, storing a ref into an i32 backing.
    if emitExpr(a.binRight, fnIx) < 0 { return -1 }
  } else if (
    arrElemIsNulBoolAt(arrIx, fnIx)
    || arrElemIsNullUnitAt(arrIx, fnIx)
  ) {
    // `p[i] = null` over a `(boolean | null)[]`: the i32 cell holds 0/1 or the
    // sentinel 2, which a `null` RHS emits from its delivery's stamp. The list analogue of the
    // scalar niche assignment above.
    if emitExpr(a.binRight, fnIx) < 0 { return -1 }
  } else if nodeArrayElemIsNulLitUnion(arrIx) {
    // `p[i] = "a"` / `p[i] = null` over a `(K | null)[]`: a member RHS lowers as its atom id, a
    // `null` as the `-1` sentinel.
    if emitExpr(a.binRight, fnIx) < 0 { return -1 }
  } else if exprIsLitAtom(a.binRight, fnIx) {
    // a literal-union atom stored into a string-backed list element widens to its
    // member string — reached only once the atom-element arms above decline, so the
    // list is genuinely string-backed and the atom's i32 id cannot go in raw.
    if emitStrValue(a.binRight, fnIx) < 0 { return -1 }
  } else if nodeArrayElemIsNulStr(arrIx) {
    // `p[i] = null` over a `(string | null)[]`: the null is the string backing's own
    // `ref.null`, as in the list literal (D2393).
    if emitExpr(a.binRight, fnIx) < 0 { return -1 }
  } else {
    if emitExpr(a.binRight, fnIx) < 0 { return -1 }
  }
  return 0
}

// The local the last element or field store parked its value in, the stored cell's own rep, or
// -1 for a store that parked none. A field store parks only while `asgParkWanted` is set; an
// element store always parks.
let asgParkedSlot = -1
// Whether that local holds a reference, which a local declares nullable.
let asgParkedRef = false
let asgParkWanted = false
// The target node of the assignment whose store parked into `asgParkedSlot`: a nested write runs
// its own store inside the right-hand side, so a read checks the park is its own.
let asgParkedOwner = -1
// Whether the last map set parked its value, so the index store that ran it owns the park.
let mapSetDidPark = false

// `emitAssignUnder`'s arm over an index target `xs[i] = v`: a map store or a list element
// store. Returns 0 lowered, -1 failed.
function emitAssignIndex(fnIx: i32, a: BinExpr, target: Index) {
  asgParkedSlot = -1
  asgParkedRef = false
  // Inside `is K[]` a store through a box of list arms writes the arm the box holds (D17002).
  const armW = emitArmIndexWrite(fnIx, a, target)
  if armW != 0 { return if armW < 0 { -1 } else { 0 } }
  // G8: a map store `m[k] = v` — scan for `k`; overwrite `vals[hit]` on a hit, else
  // append `keys.push(k); vals.push(v)`. Checked BEFORE the list path (a map index
  // is not an array index).
  if exprMap(target.idxArr, fnIx) {
    mapSetDidPark = false
    const msRc = emitMapSet(target.idxArr, target.idxIndex, a.binRight, fnIx)
    if mapSetDidPark { asgParkedOwner = a.binLeft }
    mapSetDidPark = false
    return msRc
  }
  const st = idxStorePlanOf(target, fnIx)
  if st == null { return -1 }
  // source order — receiver, index, value — with the wrapper + index parked on the
  // stack while the value's user code runs. The backing and len resolve only after
  // the value, since an RHS that pushes onto the target list reallocates it; a live
  // hoist row skips the receiver and guards the cached header, safe in a call-free loop.
  const stHz = idxStoreHoistOf(target, st)
  if stHz < 0 {
    if emitExpr(target.idxArr, fnIx) < 0 { return -1 }
  }
  if emitExpr(target.idxIndex, fnIx) < 0 { return -1 }
  // the narrowed-arm unbox at the ELEMENT-assignment boundary, the binding boundary's
  // twin one container over: the element's own variant or struct row is where the arm
  // lands, and those two seeds are what the value emits under (D1685).
  const iaOwed = narrowedArmNeedsUnbox(a.binRight, fnIx)
  let iaHeap = -1
  if st.variantIdx >= 0 { iaHeap = armDestHeapOf("variant", st.variantIdx) }
  else if st.structIdx >= 0 { iaHeap = armDestHeapOf("struct", st.structIdx) }
  const iaSeat = armOpen(iaOwed, iaHeap, a.binRight, fnIx)
  if emitIdxStoreValue(fnIx, a, target.idxArr, st) < 0 { return -1 }
  // the read-only covariant copy at the indexed-store boundary (D2163)
  if st.mfKind == "reflist" {}
  armClose(iaSeat, iaOwed, iaHeap, a.binRight, fnIx)
  // The guard and backing resolve after the value ran.
  asgParkedSlot = idxStoreTail(target, st, stHz)
  asgParkedRef = st.isRef || st.isStr
  asgParkedOwner = a.binLeft
  return 0
}

// Why element store plan `st` (value `rhs`) is not the plain store the IR writes, or "": a scalar,
// string, atom, niche or plain reference list's value built as itself or widened, a union list's
// that the record boxes or is already a named union, or a nested list's that is no literal (an atom
// into a string list decodes); with no arm unbox at a record row.
export function idxStorePlainWhy(st: IdxStore, rhs: i32, fnIx: i32): string {
  if (
    st.unionNm != ""
    && !boxOwedAt(rhs, fnIx)
    && !(exprUnion(rhs, fnIx) && boxTyName(nodeTyAt(rhs, fnIx)) != "")
  ) {
    return "store element"
  }
  if st.nestSlot >= 0 && nodeAt(unwrapParen(rhs)) is ArrayLit {
    return "store element"
  }
  // The arm unbox casts at the element's own row; a store with none writes no cast.
  if (
    narrowedArmNeedsUnbox(rhs, fnIx)
    && (st.variantIdx >= 0 || st.structIdx >= 0)
  ) {
    return "store arm"
  }
  return ""
}

// The live loop hoist holding element store `target`'s receiver, or -1; under one the receiver
// is not written.
export function idxStoreHoistOf(target: Index, st: IdxStore): i32 {
  return liveHoistRow(target.idxArr, st.mfKind, st.slot)
}

// After a store's receiver, index and value: the value parked, the guard over the hoisted
// header or the wrapper, then the backing's `array.set`. Returns the park slot.
export function idxStoreTail(target: Index, st: IdxStore, stHz: i32): i32 {
  const storeValSlot = listIdxValSlot(st.mfKind, st.slot)
  fbLocalSet(storeValSlot) // 0x21 — park the value under the guard operands
  if stHz >= 0 {
    emitListIdxGuardHoisted(stHz, target.idxIndex)
  } else {
    emitListIdxGuard(listIdxWrapSlot(st.mfKind, st.slot), st.lTy)
  }
  fbLocalGet(storeValSlot) // 0x20 — the parked value
  fbArraySet(st.aTy)       // 0xfb 0x0e <backing array type index>
  return storeValSlot
}

// A variant field write's tail once its receiver struct ref is on the stack: seeds an ARRAY
// field's element kind, widens a scalar f64/i64/f32 field's RHS `rhs` at the store boundary,
// then `struct.set`s field `fi` of variant `vi`. Returns 0, or -1 failed.
function emitVariantFieldWrite(vi: i32, fi: i32, rhs: i32, fnIx: i32): i32 {
  if emitVariantFieldStoreVal(vi, fi, rhs, fnIx) < 0 { return -1 }
  return fieldStoreVariantTail(vi, fi)
}

// `emitAssignMember`'s value for field `fieldIdx` of struct row `si`, its target context already
// applied, through the arm `fieldStoreValueArmOf` names. Returns 0, or -1 failed.
function emitStructFieldStoreValue(
  si: i32,
  fieldIdx: i32,
  rhs: i32,
  fnIx: i32,
): i32 {
  const rc = match fieldStoreValueArmOf(si, fieldIdx, rhs, fnIx) {
    "noKind" => emitFail("emitProgram: struct field has no storage kind")
    "plain" => emitExpr(rhs, fnIx)
    // A box-union field cell is `(ref $uBox)`, so the RHS goes through `emitUnionBoxOwed`.
    "box" => emitUnionBoxOwed("", structFieldBoxTy(si, fieldIdx), rhs, fnIx)
    // A literal-union atom assigned to a `string` field widens to its member string.
    "atomToStr" => emitAtomToStr(rhs, fnIx)
    // A `string | null` slot takes the same widen; a widened member string is non-null.
    "strValue" => emitStrValue(rhs, fnIx)
    // A wide scalar field widens its RHS at the store boundary, as the construct does.
    "f64" => emitWidened(rhs, 4, fnIx)
    "i64" => emitWidened(rhs, 3, fnIx)
    "f32" => emitWidened(rhs, 5, fnIx)
    // The `null` unit type's slot, the construct arm's twin (D4671).
    "nulnone" => {
      if emitNulNoneForEffect(rhs, fnIx) < 0 { return -1 }
      fbRefNullNone()
    }
    // The assign half of the construct's narrowed-arm delivery (`p.g = s` after
    // `if s is Circle`); `emitObj` and `emitAssign` must agree on every field.
    "armDelivery" => emitArmDelivery(rhs, fnIx, sFieldTgtHeapOf(si, fieldIdx))
    "unencodable" => fieldStorePlainMissed()
  }
  return if rc < 0 { -1 } else { 0 }
}

// A kind `fieldStoreValuePlain` always answers plain, reaching the non-plain arms.
function fieldStorePlainMissed() {
  return emitFail(
    "emitProgram: a plain field value reached the field store's re-encode ladder",
  )
}

// How a field store writes its value, decided once for legacy and the IR: the bare value, a box,
// an atom widened to its string, a scalar widened to the field's width, the `null` unit's seed, or
// a narrowed record arm's delivery; `unencodable` is a kind the plain check always answers plain,
// reached only if the two disagree, and refused.
export type FieldStoreValArm = "noKind"
  | "plain"
  | "box"
  | "atomToStr"
  | "strValue"
  | "f64"
  | "i64"
  | "f32"
  | "nulnone"
  | "armDelivery"
  | "unencodable"

// The arm `emitStructFieldStoreValue` writes `rhs` into field `fi` of struct row `si` at.
export function fieldStoreValueArmOf(
  si: i32,
  fi: i32,
  rhs: i32,
  fnIx: i32,
): FieldStoreValArm {
  if si < 0 || si >= sFieldStart.length { return "noKind" }
  const k = fieldRowKind(sFieldStart[si] + fi)
  if k == null { return "noKind" }
  if fieldStoreValuePlain(si, fi, rhs, fnIx) { return "plain" }
  return match k {
    "union" => "box"
    "str" => "atomToStr"
    "nulstr" => "strValue"
    "f64" => "f64"
    "i64" => "i64"
    "f32" => "f32"
    "nulnone" => "nulnone"
    "nulstruct" | "nulvariant" => "armDelivery"
    // `fieldStoreValuePlain` answers plain for every other kind.
    "i32" | "v128" | "struct" | "list" | "reflist" | "map" | "variant" | "closure" | "nulbool" | "nulclosure" | "nulmap" | "u8list" | "i64list" | "f32list" | "v128list" | "f64list" | "strlist" | "nullist" | "nulu8list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulf64list" | "nulstrlist" | "nulreflist" => "unencodable"
  }
}

// The arm `emitVariantFieldStoreVal` writes `rhs` into variant `vi`'s field `fi` at: the bare
// value, a box, a scalar widened to the field's width, or a literal-union atom as its string.
export function variantFieldStoreValueArmOf(
  vi: i32,
  fi: i32,
  rhs: i32,
  fnIx: i32,
): FieldStoreValArm {
  if fieldStoreVariantValuePlain(vi, fi, rhs, fnIx) { return "plain" }
  const k = eqRowFieldKind(-1 - vi, fi)
  if k == null { return "unencodable" }
  return match k {
    "union" => "box"
    "f64" => "f64"
    "i64" => "i64"
    "f32" => "f32"
    "str" | "nulstr" => "strValue"
    // `fieldStoreVariantValuePlain` answers plain for every other kind.
    "i32" | "v128" | "struct" | "list" | "reflist" | "map" | "variant" | "nulvariant" | "nulstruct" | "closure" | "nulbool" | "nulclosure" | "nulmap" | "nulnone" | "u8list" | "i64list" | "f32list" | "v128list" | "f64list" | "strlist" | "nullist" | "nulu8list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulf64list" | "nulstrlist" | "nulreflist" => "unencodable"
  }
}

// `emitAssignUnder`'s arm over a field target `o.f = v`: through a narrowed union box, into
// a variant receiver, or straight into the record. `target` is `P.nodes[lhsIx]`. Returns 0
// lowered, -1 failed.
function emitAssignMember(fnIx: i32, a: BinExpr, lhsIx: i32, target: Member) {
  return match fieldStoreArmOf(lhsIx, fnIx) {
    "narrowVariant" => emitFieldStoreNarrowed(fnIx, a, lhsIx)
    "variantParam" => emitFieldStoreVariant(fnIx, a, lhsIx, target)
    "nulVariant" => emitFieldStoreNulVariant(fnIx, a, target)
    "shared" => if emitSharedFieldAssign(lhsIx, a.binRight, fnIx) < 0 { -1 } else { 0 }
    "struct" => emitFieldStoreStruct(fnIx, a, lhsIx, target)
  }
}

// The arm `emitAssignMember` takes for field target `lhsIx`, decided once for legacy and the IR
// (which covers `struct`): through a narrowed union box, into a variant receiver or a nullable
// variant's, through an un-narrowed struct union's shared field, or straight into the record.
export type FieldStoreArm = "narrowVariant"
  | "variantParam"
  | "nulVariant"
  | "shared"
  | "struct"

export function fieldStoreArmOf(lhsIx: i32, fnIx: i32): FieldStoreArm {
  const t = nodeAt(lhsIx)
  if memNarrowVariantIndex(lhsIx, fnIx) >= 0 { return "narrowVariant" }
  if t is Member {
    if exprVariantIndex(t.memObj, fnIx) >= 0 { return "variantParam" }
    if nulVariantIdxOfExpr(t.memObj, fnIx) >= 0 { return "nulVariant" }
  }
  if sharedFieldAssignTaken(lhsIx, fnIx) { return "shared" }
  return "struct"
}

function emitFieldStoreNarrowed(fnIx: i32, a: BinExpr, lhsIx: i32) {
  if lhsIx < 0 { return -1 }
  const nm = nodeAt(lhsIx)
  if nm is Member {
    const nf = fieldStoreNarrowedAt(lhsIx, fnIx)
    if nf.length != 2 {
      return emitFail(
        "emitProgram: unknown variant field in narrowed field assignment",
      )
    }
    const nvi = nf[0]
    const nfi = nf[1]
    if emitExpr(nm.memObj, fnIx) < 0 { return -1 }
    // A receiver read as its member's record (`boxedArmOfMember`) arrives already cast. Both it and
    // `fieldStoreNarrowedAt` name the member of the read's narrowed type, so the heaps agree.
    const ravi = boxedArmOfMember(nm.memObj, fnIx)
    if ravi >= 0 && variantHeap(ravi) != variantHeap(nvi) {
      return emitFail(
        "emitProgram: internal: a narrowed field store's receiver is cast to another member's record",
      )
    }
    if ravi < 0 {
      fbStructGet(uBoxIdx, 1)     // box field 1: value (anyref)
      fbRefCast(variantHeap(nvi)) // ref.cast to the variant struct
    }
    // The field's context is taken AFTER the receiver's own emit, which may leave seeds
    // of its own behind.
    return emitVariantFieldWrite(nvi, nfi, a.binRight, fnIx)
  }
  return -1
}

function emitFieldStoreVariant(
  fnIx: i32,
  a: BinExpr,
  lhsIx: i32,
  target: Member,
) {
  // A field WRITE on a variant-typed param (`o: TyObj`) writes the variant struct
  // directly (the param IS the unboxed variant ref — no box unwrap).
  const vf = fieldStoreVariantAt(lhsIx, fnIx)
  if vf.length != 2 {
    return emitFail("emitProgram: unknown variant field in field assignment")
  }
  if emitExpr(target.memObj, fnIx) < 0 { return -1 }
  return emitVariantFieldWrite(vf[0], vf[1], a.binRight, fnIx)
}

function emitFieldStoreNulVariant(fnIx: i32, a: BinExpr, target: Member) {
  // the nullable-variant receiver: a `T | null` binding whose `T` is a union arm holds
  // `(ref null $variantHeap(vi))`, so this differs from the variant-param write above only
  // by one `ref.as_non_null`, safe since the checker admits the write only inside a null test.
  const nwvi = nulVariantIdxOfExpr(target.memObj, fnIx)
  const nwfi = variantFieldIndex(nwvi, target.memProp)
  if nwfi < 0 {
    return emitFail("emitProgram: unknown variant field in field assignment")
  }
  if emitExpr(target.memObj, fnIx) < 0 { return -1 }
  fbRefAsNonNull() // 0xd4 — the enclosing null test narrowed it
  return emitVariantFieldWrite(nwvi, nwfi, a.binRight, fnIx)
}

function emitFieldStoreStruct(
  fnIx: i32,
  a: BinExpr,
  lhsIx: i32,
  target: Member,
) {
  // field write `recv.field = v` → `struct.set $0 <fieldidx>`; the single declared
  // struct lives at WasmGC type index 0. Operand order is load-bearing: struct ref
  // first, then the value.
  const sf = fieldStoreStructAt(lhsIx, fnIx)
  if sf.length != 2 {
    if !sDeclared {
      return emitFail(
        "emitProgram: field assignment but no struct type declared",
      )
    }
    if structIndexOfExpr(target.memObj, fnIx) < 0 {
      return emitFail("emitProgram: field-assignment receiver is not a struct")
    }
    return emitFail("emitProgram: unknown struct field in field assignment")
  }
  if emitExpr(target.memObj, fnIx) < 0 {
    return -1 // struct ref first
  }
  if (emitStructFieldStoreValue(sf[0], sf[1], a.binRight, fnIx) < 0) {
    return -1
  }
  return fieldStoreTail(sf[0], sf[1], a.binLeft, a.binRight, fnIx)
}

// The struct row and field index `emitFieldStoreStruct` stores field target `lhsIx` at, or [] when
// it is no struct field.
export function fieldStoreStructAt(lhsIx: i32, fnIx: i32): i32[] {
  const t = nodeAt(lhsIx)
  if !(t is Member) || !sDeclared { return [] }
  const si = structIndexOfExpr(t.memObj, fnIx)
  if si < 0 { return [] }
  const fi = sFieldIndex(si, t.memProp)
  if fi < 0 { return [] }
  return [si, fi]
}

// Whether `emitStructFieldStoreValue` writes `rhs` into field `fieldIdx` of row `si` as the bare
// value (`emitExpr`), with no box, atom widen, scalar re-encode or niche seed around it.
function fieldStoreValuePlain(
  si: i32,
  fieldIdx: i32,
  rhs: i32,
  fnIx: i32,
): boolean {
  const k = fieldRowKind(sFieldStart[si] + fieldIdx)
  if k == null { return false }
  const atoms = sFieldIsLitUnion(si, fieldIdx)
    || sFieldIsLitUnionArray(si, fieldIdx)
  return match k {
    "union" => false
    "str" | "nulstr" => !exprIsLitAtom(rhs, fnIx)
    "f64" | "i64" | "f32" | "nulnone" | "nulstruct" | "nulvariant" => atoms
    "i32" | "v128" | "struct" | "list" | "reflist" | "map" | "variant" | "closure" => true
    "nulbool" | "nulclosure" | "nulmap" | "u8list" | "i64list" | "f32list" | "v128list" => true
    "f64list" | "strlist" | "nullist" | "nulu8list" | "nuli64list" | "nulf32list" => true
    "nulv128list" | "nulf64list" | "nulstrlist" | "nulreflist" => true
  }
}

// The variant and field `emitFieldStoreNarrowed` stores field target `lhsIx` at, through the box
// its receiver is narrowed from, or [].
export function fieldStoreNarrowedAt(lhsIx: i32, fnIx: i32): i32[] {
  const t = nodeAt(lhsIx)
  if !(t is Member) { return [] }
  const vi = memNarrowVariantIndex(lhsIx, fnIx)
  if vi < 0 { return [] }
  const fi = variantFieldIndex(vi, t.memProp)
  if fi < 0 { return [] }
  return [vi, fi]
}

// The variant and field `emitFieldStoreVariant` stores field target `lhsIx` at, or [].
export function fieldStoreVariantAt(lhsIx: i32, fnIx: i32): i32[] {
  const t = nodeAt(lhsIx)
  if !(t is Member) { return [] }
  const vi = exprVariantIndex(t.memObj, fnIx)
  if vi < 0 { return [] }
  const fi = variantFieldIndex(vi, t.memProp)
  if fi < 0 { return [] }
  return [vi, fi]
}

// Whether `emitVariantFieldStoreVal` writes `rhs` into variant `vi`'s field `fi` as the bare value
// (`emitExpr`), with no box, scalar re-encode or atom widen around it.
function fieldStoreVariantValuePlain(
  vi: i32,
  fi: i32,
  rhs: i32,
  fnIx: i32,
): boolean {
  const k = eqRowFieldKind(-1 - vi, fi)
  if k == null { return true }
  return match k {
    "union" | "f64" | "i64" | "f32" => false
    "str" | "nulstr" => !exprIsLitAtom(rhs, fnIx)
    "i32" | "v128" | "struct" | "list" | "reflist" | "map" | "variant" | "nulvariant" => true
    "nulstruct" | "closure" | "nulbool" | "nulclosure" | "nulmap" | "nulnone" | "u8list" => true
    "i64list" | "f32list" | "v128list" | "f64list" | "strlist" | "nullist" | "nulu8list" => true
    "nuli64list" | "nulf32list" | "nulv128list" | "nulf64list" | "nulstrlist" | "nulreflist" => true
  }
}

// After a variant field store's receiver and value: `struct.set` on the variant's heap.
export function fieldStoreVariantTail(vi: i32, fi: i32): i32 {
  if vi < 0 { return -1 }
  fbStructSet(variantHeap(vi), fi)
  return 0
}

// After a struct field store's record and value: the construct-side recover's STORE half (D1222),
// the scalar covariant copy at the field-store boundary (D2163), then `struct.set`.
export function fieldStoreTail(
  si: i32,
  fieldIdx: i32,
  lhs: i32,
  rhs: i32,
  fnIx: i32,
): i32 {
  if nulNicheRecoverOwed(sFieldStoreKind(si, fieldIdx), rhs, fnIx) {
    fbRefAsNonNull()
  }
  if asgParkWanted { asgParkField(sFieldStoreKind(si, fieldIdx), lhs) }
  fbStructSet(sHeapIdx[si], fieldIdx) // 0xfb 0x05 <struct ht> <field index>
  return 0
}

// A field of a kind no scratch local of `asgParkField`'s holds (a record, list, map, union or
// nullable cell) parks nothing, so the assignment's value rung refuses it.
function asgParkNone() { return 0 }

// Tees the field value on the stack into a scratch local of its own rep for the assignment's
// value (`asgParkedSlot`); a field of any other kind parks nothing.
function asgParkField(k: VKind | null, owner: i32) {
  if k == null { return asgParkNone() }
  let lk: ListKind = "list"
  match k {
    "i32" => {}
    "f64" => {
      lk = "f64list"
    }
    "i64" => {
      lk = "i64list"
    }
    "f32" => {
      lk = "f32list"
    }
    "v128" => {
      lk = "v128list"
    }
    "str" => {
      lk = "strlist"
    }
    "struct" | "list" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "f64list" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "v128list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" => {
      return asgParkNone()
    }
  }
  const slot = listIdxValSlot(lk, 0)
  fbLocalTee(slot)
  // A tee yields the local's nullable type; the string it holds is non-null.
  if k == "str" { fbRefAsNonNull() }
  asgParkedSlot = slot
  asgParkedRef = k == "str"
  asgParkedOwner = owner
  return 0
}

// `emitAssign`'s body: an arm applies its target's context and leaves it for the exit to undo.
function emitAssignUnder(binIx: i32, fnIx: i32) {
  const a = nodeAt(binIx)
  if a is BinExpr {
    // the target is read through `unwrapParen`, exactly as the RHS already is (D1089):
    // `(x) = 5` is check-clean, so a `Paren` LHS matching none of the Ident/Index/Member
    // arms reached the floor with the wrong message. Peeling here is one change for all
    // six delivery positions; `sidOfNode(lhsIx)` is load-bearing since a `Paren` node interns its own sid.
    const lhsIx = unwrapParen(a.binLeft)
    if lhsIx < 0 { return -1 }
    const target = nodeAt(lhsIx)
    strSiteArm(binIx, fnIx)
    if target is Ident { return emitAssignIdent(binIx, fnIx, a, lhsIx) }
    if target is Index { return emitAssignIndex(fnIx, a, target) }
    if target is Member { return emitAssignMember(fnIx, a, lhsIx, target) }
    return emitFail("emitProgram: assignment target is not a simple name")
  }
  return emitFail("emitProgram: expected an assignment expression")
}

// Stage a list-op receiver that is not a bare local — a global, a struct field, an index —
// into the op frame's `recvRef` scratch slot: the one home the evaluate-once rule every
// list op needs. A nullable list cell needs the recover `emitExpr` withholds (so `g != null`
// can test the raw cell); this slot is a non-null wrapper ref instead, safe by narrowing.
function stageListRecv(objIx: i32, fnIx: i32, base: i32) {
  if emitExpr(objIx, fnIx) < 0 { return -1 }
  return stageListRecvTail(objIx, fnIx, base)
}

// After a staged list-op receiver's read: its recover where owed, then the frame's `recvRef`.
export function stageListRecvTail(objIx: i32, fnIx: i32, base: i32) {
  const r = nodeAt(unwrapParen(objIx))
  if r is Ident {
    if globalNulListCellRead(fnIx, unwrapParen(objIx)) {
      fbRefAsNonNull() // 0xd4
    } else if capturedNulListCellRead(fnIx, r.identName) {
      fbRefAsNonNull() // 0xd4
    }
  } else if nulRecvNeedsRecover(objIx, fnIx) {
    // A narrowed nullable field/index/call receiver reads `(ref null $wrap)` (D2235).
    fbRefAsNonNull() // 0xd4
  }
  fbLocalSet(base + 3) // local.set recvRef
  return 0
}

// True when an ident read of `name` unboxes a narrowed union arm rather than yielding the
// frame slot raw — the gate `emitIdentNode`'s narrowed value-atom and ref-array arms
// share, asked in the same order: a union binding in this frame, a capture (bound in
// another frame), and the typed-IR net behind both. Excludes the narrowed-map arm: a map is not a list receiver.
function identReadIsUnionUnbox(exprIx: i32, name: string, fnIx: i32) {
  if unionNameOfRead(exprIx, fnIx) != "" { return true }
  if capturedIsUnionBox(fnIx, name) { return true }
  return identChainTyBoxedUnion(exprIx, fnIx, 4)
}

// True when the list-op receiver at `objIx` is an identifier narrowed to a list arm of a
// union box: such a name resolves like any local, but the local holds `(ref $uBox)`, so
// it must be staged through `emitExpr` (which runs the unbox) like a global/field/index
// receiver — else `.push`/`.clear` `struct.get`s the raw box, invalid wasm.
function listOpRecvNarrowedUnion(objIx: i32, name: string, fnIx: i32) {
  if (
    identReadAtomKindAt(objIx, fnIx) < 0
    && identReadContainerAt(objIx, fnIx) != RC_REF_LIST
  ) {
    return false
  }
  // the slot test is load-bearing: `callPopBits` reserves the scratch frame off
  // `identSlotIsUnionBox` alone, so staging on a wider condition here would stage into a
  // frame never laid out. The two passes ask the one question.
  if !identSlotIsUnionBox(fnIx, objIx) { return false }
  return identReadIsUnionUnbox(objIx, name, fnIx)
}

// The scratch base a receiver that stages will use: `base` is the family default already
// resolved; `refSlot >= 0` defers the ref family's per-element-type frame to here, the one
// point that knows staging is happening. A `.pop`/`.clear` stages only a receiver it cannot
// read in place; a `.push` reads `base`..`base+2` regardless, so the ref frame is reserved for the first group only.
export function listOpStageBase(base: i32, refSlot: i32): i32 {
  if refSlot < 0 { return base }
  return refPushScratchBaseFor(refSlot)
}

// The one home for list-op receiver resolution: resolve `objIx` to the wasm local holding
// the list-wrapper ref, or -1 (loud, already recorded) for a receiver it cannot resolve. A
// bare identifier is such a local unless it is a narrowed union arm; every other receiver is
// staged once into the `recvRef` scratch slot, which `listOpRecvStages` reserves for it.
function listOpRecvLocal(
  objIx: i32,
  fnIx: i32,
  base: i32,
  refSlot: i32,
  op: string,
): i32 {
  const held = listOpRecvHeld(objIx, fnIx, op)
  if held != -1 { return if held == -2 { -1 } else { held } }
  // A field, an index, a call, or a parenthesised, `??` or `if` value (SP-044): any
  // expression yielding the wrapper ref, evaluated once so the op's reads share it.
  const sb = listOpStageBase(base, refSlot)
  if stageListRecv(objIx, fnIx, sb) < 0 { return -1 }
  return sb + 3
}

// The local list-op receiver `objIx` already is, -1 when it is staged, -3 when a push would land
// in a fitted or captured stand-in list and be lost, and -4 when it is no list local, captured
// list or global. It writes nothing and records no failure.
export function listOpRecvHeldPlan(objIx: i32, fnIx: i32, op: string): i32 {
  const recv = nodeAt(objIx)
  if recv is Ident {
    if !listOpRecvNarrowedUnion(objIx, recv.identName, fnIx) {
      // An `is K[]` arm's empty list of another element (D4911): an op that only reads it
      // reads the arm's own, and a push lands there when the arm keeps it (D4934).
      const fitSh = listFitShadowRead(recv.identName, objIx, fnIx)
      if fitSh >= 0 && op == ".push" && !listFitGrowHolds(fitSh) { return -3 }
      if fitSh >= 0 { return fitSh }
      // A closure's stand-in for such a list is its own, and a push into it would be lost.
      if (
        op == ".push"
        && listFitCaptureStandIn(recv.identName, objIx, fnIx, true, []) >= 0
      ) {
        return -3
      }
      const lIdx = localIndexOf(fnIx, objIx)
      if lIdx >= 0 { return lIdx }
      // A captured list ident (D1965) or a module global: the env field or global holds
      // the wrapper ref, so staging it through `emitExpr` mutates that same list in place.
      if (
        !identIsEnvCapture(fnIx, recv.identName)
        && globalIndexOfSid(sidOfNode(objIx)) < 0
      ) {
        return -4
      }
    }
  }
  return -1
}

// The local list-op receiver `objIx` already is, -1 when it is staged, or -2 after a refusal.
export function listOpRecvHeld(objIx: i32, fnIx: i32, op: string): i32 {
  const h = listOpRecvHeldPlan(objIx, fnIx, op)
  if h == -3 {
    emitFailAt(LIST_FIT_PUSH_MSG, objIx)
    return -2
  }
  if h == -4 {
    emitFail("emitProgram: " + op + " receiver is not a list local")
    return -2
  }
  return h
}

// Lower a `recv.push(x)` member-call statement — the growable-list append, inlined rather
// than a helper call. `recv` must be a bare `Ident` naming a list local/param, taking
// exactly one i32 argument. Grows by doubling (floor of four) when `len == cap`, copying
// live elements into a fresh backing; G7-ref runs the identical sequence for a ref list.

// receiver resolution for `.push` — `listOpRecvLocal`, the one home the four list ops
// share. Called from two points because a push whose value stages a receiver must resolve
// its own after that value (D1280); one function so the two cannot pass different arguments.
function pushRecvLocal(objIx: i32, fnIx: i32, base: i32) {
  listCastForPush = true
  const r = listOpRecvLocal(objIx, fnIx, base, -1, ".push")
  listCastForPush = false
  return r
}

// The list build of the run a variadic `.push` appends: the receiver's own, since the run is
// a synthesized literal no checker stamp reaches.
function pushRunListBuild(
  recvIx: i32,
  fnIx: i32,
  kk: ListKind,
  row: i32,
): ListBuild {
  let k = pendingKindOfList(kk, row)
  if arrElemIsNulBoolAt(recvIx, fnIx) || arrElemIsNullUnitAt(recvIx, fnIx) {
    k = LBK_NUL_BOOL_LIST
  }
  if nodeArrayElemIsNulLitUnion(recvIx) { k = LBK_NUL_LIT_UNION_LIST }
  const lb: ListBuild = { lbKind: k, lbSlot: row }
  return lb
}

// `xs.push(a, b)` / `xs.push(...ys)` — the variadic appends. The arguments build as one list
// at the receiver's own rep, so a spread argument is `emitArrSpread`'s business; the receiver
// then grows once and the new elements arrive as a single `array.copy`. The one-argument
// push keeps its own element-wise lowering, which is what makes this path free of it.
function emitPushMany(callIx: i32, fnIx: i32, wantValue: boolean) {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      const kk = mfRecvKindOf(callee.memObj, fnIx)
      if kk == null {
        return emitFail("emitProgram: .push receiver is not a list")
      }
      let row = 0
      if kk == "reflist" { row = refListSlotOfExpr(callee.memObj, fnIx) }
      if kk == "u8list" { row = exprPackedRow(callee.memObj, fnIx) }
      const wrap = spreadWrapIdx(kk, row)
      const back = spreadBackIdx(kk, row)
      if wrap < 0 || back < 0 {
        return emitFail("emitProgram: .push but list type not collected")
      }
      const seq = liKinds.length
      const recvS = spreadGroupWrapSlot(kk, row, seq)
      const srcS = spreadGroupWrapSlot(kk, row, seq + 1)
      const backS = spreadDstBackSlot(kk, row, seq)
      const totL = widenTmpSlot(3000 + seq)
      // The receiver, evaluated ONCE — an argument that is itself a list op would otherwise
      // restage it, which is how a hoisted receiver gets clobbered.
      listCastForPush = true
      const recvRc = emitExpr(callee.memObj, fnIx)
      listCastForPush = false
      if recvRc < 0 { return -1 }
      if nulRecvNeedsRecover(callee.memObj, fnIx) { fbRefAsNonNull() }
      fbLocalSet(recvS)
      const lst = spreadRunLit(c.callArgs, callIx, callee.memObj, c.pos)
      const lstRc = emitArrAt(
        lst,
        fnIx,
        pushRunListBuild(callee.memObj, fnIx, kk, row),
      )
      if lstRc < 0 { return -1 }
      fbLocalSet(srcS)
      // tot = recv.len + new.len
      fbLocalGet(recvS)
      fbStructGet(wrap, 1)
      fbLocalGet(srcS)
      fbStructGet(wrap, 1)
      fbI32Bin(106) // 0x6a i32.add
      fbLocalSet(totL)
      // if recv.cap < tot, grow the backing to EXACTLY tot — a bulk append knows the length
      // it needs, so the doubling a one-at-a-time push amortizes over has nothing to buy.
      fbLocalGet(recvS)
      fbStructGet(wrap, 2)
      fbLocalGet(totL)
      fbI32Bin(72) // 0x48 i32.lt_s
      fbIf(64)     // 0x04 if, 0x40 void blocktype
      fbLocalGet(totL)
      fbArrayNewDefault(back)
      fbLocalSet(backS)
      fbLocalGet(backS)
      fbI32Const(0)
      fbLocalGet(recvS)
      fbStructGet(wrap, 0)
      fbI32Const(0)
      fbLocalGet(recvS)
      fbStructGet(wrap, 1)
      fbArrayCopy(back, back)
      fbLocalGet(recvS)
      fbLocalGet(backS)
      fbRefAsNonNull()
      fbStructSet(wrap, 0)
      fbLocalGet(recvS)
      fbLocalGet(totL)
      fbStructSet(wrap, 2)
      fbEnd()      // 0x0b end (if)
      // recv.backing[recv.len ..] = new
      fbLocalGet(recvS)
      fbStructGet(wrap, 0)
      fbLocalGet(recvS)
      fbStructGet(wrap, 1)
      fbLocalGet(srcS)
      fbStructGet(wrap, 0)
      fbI32Const(0)
      fbLocalGet(srcS)
      fbStructGet(wrap, 1)
      fbArrayCopy(back, back)
      fbLocalGet(recvS)
      fbLocalGet(totL)
      fbStructSet(wrap, 1)
      // D1592 — the value a `.push` yields is the new length, read back from the field this
      // same sequence just wrote, so the two cannot disagree.
      if wantValue { fbLocalGet(totL) }
      return 0
    }
    return emitFail("emitProgram: .push receiver is not a member access")
  }
  return emitFail("emitProgram: expected a push call")
}

// D1592 — `wantValue` is the value-position flag: the checker types `.push` `i32` (the new
// length), so a bound/returned/argument push owes that value while a bare statement owes
// an empty stack. One lowering serves both, reading the value back from the `len` field
// this same sequence writes, so the two cannot disagree.
function emitPush(callIx: i32, fnIx: i32, wantValue: boolean) {
  const c = nodeAt(callIx)
  if c is Call {
    // One plain argument is the element-wise lowering below; anything else — several
    // arguments, or a spread — appends in bulk.
    if c.callArgs.length != 1 || hasSpreadItem(c.callArgs) {
      return emitPushMany(callIx, fnIx, wantValue)
    }
    const pp = pushPlanOf(callIx, fnIx)
    if pp == null { return -1 }
    return emitPushOne(
      callIx,
      pp.ppRecv,
      pp.ppArg,
      fnIx,
      pp.ppSlot,
      pp.ppVal,
      wantValue,
    )
  }
  return emitFail("emitProgram: expected a .push call")
}

// Why push plan `pp` is not the plain append the IR writes, or "": a value the IR delivers at the
// element rep (as itself, widened, boxed, unboxed from a narrowed arm or an atom decoded to its
// string), with no late receiver.
export function pushPlainWhy(pp: PushPlan, fnIx: i32): string {
  const pv = pp.ppVal
  if pv.pushNestSlot >= 0 { return "push nested list element" }
  // A literal's narrow to the receiver's atom is the one element arm the IR does not deliver.
  if (
    pv.sk == null
    && !boxOwedAtRecord(pp.ppArg, fnIx)
    && pv.isLitArr
    && litPushNeedsDestNarrow(pp.ppArg, fnIx)
  ) {
    return "push element narrow"
  }
  if (exprPopBits(pp.ppArg, fnIx) & 512) != 0 { return "push late receiver" }
  return ""
}

// After a plain push's value is on the stack: its recover where owed, then its stage.
export function pushValueTail(pp: PushPlan, fnIx: i32) {
  if nulNicheRecoverOwed(pp.ppSlot.destKind, pp.ppArg, fnIx) {
    fbRefAsNonNull()
  }
  fbLocalSet(pp.ppSlot.base)
  return 0
}

// The append of a plain push whose receiver is in local `lIdx` and value staged.
export function pushAppendTail(
  callIx: i32,
  pp: PushPlan,
  lIdx: i32,
  wantValue: boolean,
) {
  const ps = pp.ppSlot
  emitPushAppend(callIx, lIdx, ps.lTy, ps.aTy, ps.base, wantValue)
  return 0
}

// The one-argument `.push` of `argIx` (call `callIx`) onto receiver `recvIx`: stage the receiver, build
// the value at the element rep `pv` names into the slot `ps` names, and append it. Returns 0,
// or -1 when the receiver or the value fails.
function emitPushOne(
  callIx: i32,
  recvIx: i32,
  argIx: i32,
  fnIx: i32,
  ps: PushSlot,
  pv: PushValKinds,
  wantValue: boolean,
): i32 {
  const base = ps.base
  // the receiver is staged after the value when the value itself stages one (D1280):
  // `listOpRecvLocal` parks a non-local receiver in the frame's one `recvRef` slot, so
  // a nested list op inside the pushed value would overwrite it and the append would
  // land on the inner list. Emitting the value first keeps the slot free for this push's own receiver.
  const lateStage = (exprPopBits(argIx, fnIx) & 512) != 0
  let lIdx = -1
  if !lateStage {
    lIdx = pushRecvLocal(recvIx, fnIx, base)
    if lIdx < 0 { return -1 }
  }
  const valIdx = base
  // the narrowed-arm unbox at the `.push` boundary (D1031) — `xs.push(s)` into a
  // `Circle[]` under `if s is Circle`. The element-literal twin is in `emitArr`; both
  // read the same slot heap, so the two spellings of one store cannot disagree.
  const pushArmOwed = narrowedArmNeedsUnbox(argIx, fnIx)
  const pushSeat = armOpen(pushArmOwed, ps.armHeap, argIx, fnIx)
  // V = x  (an f64-list push coerces/encodes the value as f64)
  if emitPushValue(recvIx, argIx, fnIx, pv) < 0 { return -1 }
  armClose(pushSeat, pushArmOwed, ps.armHeap, argIx, fnIx)
  // the read-only covariant copy at the `.push` boundary (D2163)
  // D1197 — the non-null recover `.push` OWED. Eight sibling deliveries of the same
  // narrowed value ask `nulNicheRecoverOwed`; this one asked nothing, so `out.push(e)`
  // under `if e != null` handed a `(ref null $H)` to the non-null value slot.
  if nulNicheRecoverOwed(ps.destKind, argIx, fnIx) { fbRefAsNonNull() }
  fbLocalSet(valIdx) // local.set
  if lateStage {
    lIdx = pushRecvLocal(recvIx, fnIx, base)
    if lIdx < 0 { return -1 }
  }
  emitPushAppend(callIx, lIdx, ps.lTy, ps.aTy, base, wantValue)
  return 0
}

// The value `argIx` a `.push` onto receiver `recvIx` appends, built and coerced at the
// element rep `pv` names. Returns -1 on a failure, else 0.
function emitPushValue(recvIx: i32, argIx: i32, fnIx: i32, pv: PushValKinds) {
  const pushNestSlot = pv.pushNestSlot
  const isLitArr = pv.isLitArr
  const isNbArr = pv.isNbArr
  const isNlluArr = pv.isNlluArr
  const isNsArr = pv.isNsArr
  const isStr = pv.isStr
  if pv.sk != null {
    // a scalar-list push coerces/encodes the value at its element (a float literal re-encodes).
    if emitExprAsElem(argIx, pv.sk, fnIx) < 0 { return -1 }
  } else if boxOwedAtRecord(argIx, fnIx) {
    // The checker's record decides the union box, as at every delivery that reads it.
    if emitUnionBoxAtRecord("", -1, argIx, fnIx) < 0 { return -1 }
  } else if pushNestSlot >= 0 {
    // A nested-list element push: the value builds as the INNER list (an inert
    // context for a non-literal value — an ident/call emits unchanged).
    if emitExpr(argIx, fnIx) < 0 { return -1 }
  } else if isLitArr {
    if litPushNeedsDestNarrow(argIx, fnIx) {
      const dTy = arrElemLitUnionTy(recvIx, fnIx)
      if emitDestStrToAtom(argIx, fnIx, dTy) < 0 { return -1 }
    } else {
      if emitExpr(argIx, fnIx) < 0 { return -1 }
    }
  } else if isNbArr {
    if emitExpr(argIx, fnIx) < 0 { return -1 }
  } else if isNlluArr {
    if emitExpr(argIx, fnIx) < 0 { return -1 }
  } else if isNsArr && exprIsLitAtom(argIx, fnIx) {
    // A literal-union ATOM pushed into a `(string | null)[]`. The niche's backing IS a
    // plain string list, so the atom widens exactly as it does for a `string[]` — and a
    // widened member string is non-null, so it needs no null seed. A `null` value is not
    // a lit atom and takes the arm below.
    if emitStrValue(argIx, fnIx) < 0 { return -1 }
  } else if isNsArr {
    if emitExpr(argIx, fnIx) < 0 { return -1 }
  } else if isStr && exprIsLitAtom(argIx, fnIx) {
    // a literal-union atom pushed into a `string[]` widens to its member string: the
    // backing slot is `(ref null $aTypeIdx)` and the atom's rep is an i32 id — the
    // same boundary a `string` field store applies (`scode == 3` + `exprIsLitAtom`).
    if emitStrValue(argIx, fnIx) < 0 { return -1 }
  } else {
    if emitExpr(argIx, fnIx) < 0 { return -1 }
  }
  return 0
}

// Appends the value staged in local `base` to the list in local `lIdx` (wrapper `lTy`,
// backing `aTy`), growing the backing when full; a counted push of an open build region
// appends through its locals. With `wantValue`, leaves the new length.
function emitPushAppend(
  callIx: i32,
  lIdx: i32,
  lTy: i32,
  aTy: i32,
  base: i32,
  wantValue: boolean,
) {
  const valIdx = base
  // A counted push of an open build region appends through its locals while under the
  // reserve, and otherwise syncs `len` and takes the growing append below (D3623).
  const reg = listBuildRegionOf(callIx)
  let fast = false
  if reg >= 0 {
    fast = !wantValue
      && lbList[reg] == lIdx
      && lbWrap[reg] == lTy
      && lbBackTy[reg] == aTy
    if fast {
      fbLocalGet(lbCnt[reg])
      fbI32Const(lbCap[reg])
      fbI32Bin(73) // 0x49 i32.lt_u
      fbIf(64)
      fbLocalGet(lbBack[reg])
      fbLocalGet(lbCnt[reg])
      fbLocalGet(valIdx)
      fbArraySet(aTy)
      fbElse()
    }
    fbLocalGet(lbList[reg])
    fbLocalGet(lbCnt[reg])
    fbStructSet(lbWrap[reg], 1) // len
  }
  // if len(L) == cap(L)
  pushListLen(lIdx, lTy)
  pushListCap(lIdx, lTy)
  fbI32Bin(70) // 0x46 i32.eq
  fbIf(64)     // 0x04 if, 0x40 void blocktype
  // The grow is the shape's one shared helper, except in an optimised build, which grows inline
  // where binaryen can see the list does not escape and melt or drop the grow (as map sets do).
  if gOptimized == 0 {
    fbLocalGet(lIdx)
    fbCall(helpListGrowFn(lTy, aTy))
  } else {
    pushGrowInline(lIdx, lTy, aTy, base + 1, base + 2)
  }
  fbEnd() // 0x0b end (if)
  // backing(L)[len(L)] = V
  pushListBacking(lIdx, lTy)
  pushListLen(lIdx, lTy)
  fbLocalGet(valIdx) // local.get V
  fbArraySet(aTy)    // 0xfb 0x0e <aTy>
  // L.len = len(L) + 1
  fbLocalGet(lIdx)    // local.get L
  pushListLen(lIdx, lTy)
  fbI32Const(1)       // i32.const 1
  fbI32Bin(106)       // 0x6a i32.add
  fbStructSet(lTy, 1) // 0xfb 0x05 <lTy> field 1: len
  if reg >= 0 {
    if fast { fbEnd() }
    fbLocalGet(lbCnt[reg])
    fbI32Const(1)
    fbI32Bin(106) // 0x6a i32.add
    fbLocalSet(lbCnt[reg])
  }
  // D1592 — the new length, read back from the field the line above wrote. Emitted
  // only in value position; a bare `.push` statement leaves the stack empty, and
  // `memberCallYieldsValue` is the one predicate both sides consult.
  if wantValue { pushListLen(lIdx, lTy) }
}

// Whether `t` is `F | null` for a function type `F` of a tagged set, whose value is a member id.
function popNulTagId(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const n = tyAt(t)
  if !(n is TyNullable) || n.nInner < 0 { return false }
  return fnTagSetIsTagged(fnTagSetOfTy(n.nInner))
}

// A checked list read (`xs.pop()`/`xs.get(i)`) at a numeric-scalar element rep, delivered
// as the `T | null` the checker gives it: the `{tag, anyref}` value-union box, absent →
// the null tag. `vk` is the non-null member's kind. Mirrors the boolean arm one rep out —
// i32/i64/f64/f32 have no spare bit pattern for absence, so both branches build the box (D1174).
function emitPopNulBox(
  lIdx: i32,
  lTy: i32,
  aTy: i32,
  vk: i32,
  idxIx: i32,
  fnIx: i32,
) {
  const vb = vbHeapIdxOfKind(vk)
  if vb < 0 {
    return emitFail(
      "emitProgram: this list read yields a nullable scalar but its value box was not collected",
    )
  }
  if pushTakeCond(lIdx, lTy, idxIx, fnIx) < 0 { return -1 }
  fbOpenIf()                            // 0x04 if
  fbValtype("union", -1)                // result blocktype: the union box `(ref $uBox)`
  fbI32Rel(RS_TAG, scalarTagOfKind(vk)) // the present arm's atom tag
  if pushTakeElem(lIdx, lTy, aTy, idxIx, fnIx) < 0 { return -1 }
  fbStructNew(vb)                       // the per-rep value box
  fbStructNew(uBoxIdx)                  // { tag, value }
  fbElse()                              // 0x05 else — absent → the null-tagged box
  fbI32Rel(RS_TAG, nullBoxTag())
  fbRefNullNone()                       // the payload slot is unread under the null tag
  fbStructNew(uBoxIdx)
  fbEnd()                               // 0x0b end
  return 0
}

// the checked-read condition, one home for `.pop()` and `.get(i)`: `idxIx < 0` is `.pop`
// and asks `len != 0`; `idxIx >= 0` is `.get` and asks `i u< len`, covering the negative
// and past-len cases together. Both faces deliver the same `T | null` at the same four reps (D1281).
function pushTakeCond(lIdx: i32, lTy: i32, idxIx: i32, fnIx: i32): i32 {
  if idxIx < 0 { return pushListLen(lIdx, lTy) }
  if emitListGetIdx(idxIx, fnIx) < 0 { return -1 }
  pushListLen(lIdx, lTy)
  fbI32Bin(73) // 0x49 i32.lt_u
  return 0
}

// the element read under that condition. `.pop` DECREMENTS the length first, so the new
// `len` IS the removed element's index; `.get` reads at `idxIx` and never mutates. The
// index expression is emitted a SECOND time here (the condition emitted it once), which
// is what makes the caller's literal-or-name purity gate load-bearing.
function pushTakeElem(
  lIdx: i32,
  lTy: i32,
  aTy: i32,
  idxIx: i32,
  fnIx: i32,
): i32 {
  if idxIx < 0 { return pushPopElem(lIdx, lTy, aTy) }
  pushListBacking(lIdx, lTy)
  if emitListGetIdx(idxIx, fnIx) < 0 { return -1 }
  fbArrayGet(aTy) // backing[i] — the read element
  return 0
}

// `.pop`'s element read over the list in local `lIdx`: the length decremented first, so the new
// length is the removed element's index. Reads no expression. Returns 0.
function pushPopElem(lIdx: i32, lTy: i32, aTy: i32) {
  fbLocalGet(lIdx)    // L.len = len - 1
  pushListLen(lIdx, lTy)
  fbI32Const(1)
  fbI32Bin(107)       // 0x6b i32.sub
  fbStructSet(lTy, 1) // field 1: len
  pushListBacking(lIdx, lTy)
  pushListLen(lIdx, lTy)
  fbArrayGet(aTy)     // backing[len], the popped element
  return 0
}

// A numeric `.pop()` statement whose receiver is in local `lIdx`: under the length test, the
// element taken and dropped, so an empty list is left as it is (D8360). Reads no expression.
// Returns 1 (nothing left on the stack).
export function popDropTail(lIdx: i32, wrapTy: i32, popBack: i32) {
  pushListLen(lIdx, wrapTy)
  fbIf(64) // 0x40 void
  pushPopElem(lIdx, wrapTy, popBack)
  fbDrop() // 0x1a drop
  fbEnd()  // 0x0b end
  return 1
}

// `xs.pop()` and `xs.get(i)` — the two checked list reads, typed identically (`T | null`),
// differing only in the condition, index and length decrement (`pushTakeCond`/`pushTakeElem`);
// one body keeps `.get` at every rep `.pop` reaches (D1281). `getIdx` is the `.get` index or
// -1. Returns 0 with the value on the stack, 1 when a statement pop left none, or -1.
function emitPop(callIx: i32, fnIx: i32, nulBox: boolean, getIdx: i32) {
  const pgSv = listGetStageSave()
  const pgR = emitPopGo(callIx, fnIx, nulBox, getIdx)
  listGetStageRestore(pgSv)
  return pgR
}

// The `.pop` / `.get` arms themselves, with the call's operands already marked for staging.
function emitPopGo(callIx: i32, fnIx: i32, nulBox: boolean, getIdx: i32) {
  const opNm = if getIdx < 0 { ".pop" } else { ".get" }
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      if getIdx < 0 {
        if c.callArgs.length != 0 {
          return emitFail(
            "emitProgram: internal: .pop reached with the wrong argument count — the checker's arity rule refuses it",
          )
        }
      } else {
        listGetStageMark(callIx)
      }
      const isRef = exprRefArray(callee.memObj, fnIx)
      // D977 — the scalar-list family had no arm here: `exprArray` claims only an
      // i32-element list, so `i64[]`/`f64[]`/`f32[]`/`u8[]` fell to a refusal that
      // `emitFail`'s non-halting let reach check-clean invalid wasm instead. The wrapper
      // and backing come from `scalarListWrap`/`scalarListBack`, each kind with its own push scratch base.
      let popEk = scalarListElemKind(callee.memObj, fnIx)
      if popEk == "i32" { popEk = null }
      if !popRecvIsList(callee.memObj, fnIx) {
        return emitFail("emitProgram: " + opNm + " receiver is not a list")
      }
      // The wrapper, backing, scratch base and ref row `popAnyPlanOf` lays out; a ref row's
      // staging frame is resolved only where staging happens (`listOpStageBase`). No plan is a
      // ref or scalar list type not collected.
      const pq = popAnyPlanOf(callIx, fnIx)
      if pq == null {
        if isRef && !rlRowsMinted() {
          return emitFail(
            "emitProgram: ref " + opNm + " but ref list type not collected",
          )
        }
        if isRef { return refListRowRefused(callee.memObj) }
        return emitFail("emitProgram: " + opNm + " but list type not collected")
      }
      const wrapTy = pq.pqWrap
      const popBack = pq.pqBack
      const base = pq.pqBase
      const popRefSlot = pq.pqRefSlot
      const elemIsRef = pq.pqElemRef
      // Receiver resolution — `listOpRecvLocal`, shared with `.push`/`.clear`/`.pop() ?? d`.
      const lIdx = listOpRecvLocal(callee.memObj, fnIx, base, popRefSlot, opNm)
      if lIdx < 0 { return -1 }
      if getIdx >= 0 { emitListGetViewSync(lIdx, popEk, callee.memObj, fnIx) }
      if !elemIsRef {
        return popScalarTail(
          callIx,
          callee.memObj,
          lIdx,
          wrapTy,
          popBack,
          getIdx,
          nulBox,
          fnIx,
        )
      }
      return popRefTail(callIx, lIdx, wrapTy, popBack, getIdx, popRefSlot, fnIx)
    }
  }
  return emitFail("emitProgram: expected a .pop or .get call")
}

// The plan of `.pop()` call `callIx` over a ref or string list, as `emitPopGo` lays it out; null for
// any other list or an uncollected ref row. A staged receiver takes `listOpStageBase`'s frame.
export function popRefPlanOf(callIx: i32, fnIx: i32): PopPlan | null {
  const c = nodeAt(callIx)
  if !(c is Call) || c.callFn < 0 { return null }
  const callee = nodeAt(c.callFn)
  if !(callee is Member) { return null }
  const o = callee.memObj
  if !popRecvIsList(o, fnIx) { return null }
  if exprRefArray(o, fnIx) {
    if !rlRowsMinted() { return null }
    const rslot = refListSlotOfExpr(o, fnIx)
    if rslot < 0 { return null }
    const p: PopPlan = {
      pqRecv: o,
      pqEk: null,
      pqWrap: rlWrapIdx[rslot],
      pqBack: rlBackIdx[rslot],
      pqBase: pushScratchBase,
      pqRefSlot: rslot,
      pqElemRef: true,
    }
    return p
  }
  const ek = scalarListElemKind(o, fnIx)
  if !exprStringArray(o, fnIx) || !(ek == null || ek == "i32") { return null }
  const sp: PopPlan = {
    pqRecv: o,
    pqEk: null,
    pqWrap: mkListTy(),
    pqBack: mkArrTy(),
    pqBase: strPushScratchBase,
    pqRefSlot: -1,
    pqElemRef: true,
  }
  return sp
}

// The plan of `.pop()` call `callIx` over any list `emitPopGo` pops: a scalar plan, else a ref one.
export function popAnyPlanOf(callIx: i32, fnIx: i32): PopPlan | null {
  const pq = popPlanOf(callIx, fnIx)
  if pq != null { return pq }
  return popRefPlanOf(callIx, fnIx)
}

// After a ref or string list's receiver is in local `lIdx`: `.pop()` or `.get` call `callIx`
// leaves its element, non-null when the checker typed it so, else its checked nullable read.
// `refSlot` is the ref list's row, -1 for a string list.
export function popRefTail(
  callIx: i32,
  lIdx: i32,
  wrapTy: i32,
  popBack: i32,
  getIdx: i32,
  refSlot: i32,
  fnIx: i32,
) {
  const opNm = if getIdx < 0 { ".pop" } else { ".get" }
  // A pop the checker typed as the element itself, under a `.length` test of its receiver
  // (D3558): the list is non-empty, so the element is read unchecked in its own rep.
  if getIdx < 0 && nodeTyExcludesNull(callIx) {
    if pushTakeElem(lIdx, wrapTy, popBack, getIdx, fnIx) < 0 { return -1 }
    fbRefAsNonNull()
    if popUnionBoxElem(refSlot) {
      if emitStaleBoxRetag(refSlot, callIx) < 0 { return -1 }
    }
    return 0
  }
  return emitPopRefChecked(
    callIx,
    lIdx,
    wrapTy,
    popBack,
    getIdx,
    fnIx,
    refSlot,
    opNm,
  )
}

// After an i32 or scalar list's receiver is in local `lIdx`: `.pop()` or `.get` call `callIx`
// (`getIdx` the index, or -1). Returns 0 with the element, its niche or its null box (`nulBox`, a
// value position) on the stack; 1 when a statement pop left none; or -1.
export function popScalarTail(
  callIx: i32,
  recvIx: i32,
  lIdx: i32,
  wrapTy: i32,
  popBack: i32,
  getIdx: i32,
  nulBox: boolean,
  fnIx: i32,
) {
  // A pop the checker typed as the element itself, under a `.length` test of its receiver
  // (D3558): the list is non-empty, so the element is read unchecked in its own rep.
  if getIdx < 0 && nodeTyExcludesNull(callIx) {
    if pushTakeElem(lIdx, wrapTy, popBack, getIdx, fnIx) < 0 { return -1 }
    return 0
  }
  // A boolean list pops checked on its i32 niche (null is 2), so an empty pop yields the
  // sentinel instead of trapping.
  if listElemIsBool(recvIx, fnIx) {
    return emitPopNicheChecked(lIdx, wrapTy, popBack, getIdx, fnIx, 2)
  }
  // i32/i64/f64/f32 have no spare bit pattern for absence, so at a value position their
  // `T | null` is the shared value box; a statement keeps the raw form. A tagged set's member id
  // is an `i32`, boxed as one.
  if nulBox {
    const pnk = if popNulTagId(nodeTyIxOf(callIx)) { 0 } else { tyNulNumScalarValKind(nodeTyIxOf(callIx)) }
    if pnk >= 0 {
      return emitPopNulBox(lIdx, wrapTy, popBack, pnk, getIdx, fnIx)
    }
  }
  // An atom list reads checked on the -1 sentinel below every interned id, at a statement too,
  // since the read itself traps (D1281).
  if tyNulLitUnionInner(nodeTyIxOf(callIx)) {
    return emitPopNicheChecked(lIdx, wrapTy, popBack, getIdx, fnIx, 0 - 1)
  }
  // A number statement pop has no null cell to answer with: it pops under the length test and
  // drops the element itself, leaving an empty list as it is (D8360).
  if !nulBox && getIdx < 0 { return popDropTail(lIdx, wrapTy, popBack) }
  if pushTakeElem(lIdx, wrapTy, popBack, getIdx, fnIx) < 0 { return -1 }
  return 0
}

// A `.get` of a view reads its refreshed snapshot (D3028, D3041): sync the scalar view of
// kind `popEk` or the ref view behind receiver `recvIx` whose wrapper is in local `lIdx`.
function emitListGetViewSync(
  lIdx: i32,
  popEk: VKind | null,
  recvIx: i32,
  fnIx: i32,
) {
  if popEk != null {
    const gsv = svDstOfKind(popEk)
    if gsv >= 0 {
      fbLocalGet(lIdx)
      fbCall(gHelpSvSync[gsv])
      fbDrop()
    }
  }
  if rvRecvMayView(recvIx, fnIx) {
    fbLocalGet(lIdx)
    fbCall(gHelpRvSync)
    fbDrop()
  }
}

// A checked `.pop`/`.get` over an i32-niche list: the element when the list has one, else the
// niche's `absent` sentinel (2 for `boolean | null`, -1 for a `K[]` atom list). Returns 0, or
// -1 when the condition or the read fails.
function emitPopNicheChecked(
  lIdx: i32,
  lTy: i32,
  aTy: i32,
  getIdx: i32,
  fnIx: i32,
  absent: i32,
): i32 {
  if pushTakeCond(lIdx, lTy, getIdx, fnIx) < 0 { return -1 }
  fbIf(127) // 0x04 if, 0x7f i32 result blocktype
  if pushTakeElem(lIdx, lTy, aTy, getIdx, fnIx) < 0 { return -1 }
  fbElse()  // 0x05 else — absent → the niche's null sentinel
  fbI32Const(absent)
  fbEnd()   // 0x0b end
  return 0
}

// A checked `.pop`/`.get` over a ref or string list (`popRefSlot` -1 for a string list): an
// empty list answers `null`, it does not trap (D1212), and the result is the backing's own
// `(ref null $elem)`, or the null-tagged box for a value-union element. Returns 0, or -1.
function emitPopRefChecked(
  callIx: i32,
  lIdx: i32,
  lTy: i32,
  aTy: i32,
  getIdx: i32,
  fnIx: i32,
  popRefSlot: i32,
  opNm: string,
): i32 {
  let popElemHeap = -1
  if popRefSlot >= 0 {
    if popRefSlot >= rlElemHeap.length {
      return emitFail("emitProgram: ref " + opNm + " element heap not interned")
    }
    popElemHeap = rlElemHeap[popRefSlot]
  }
  // A value-union element has no nullable niche: its `T | null` is the box itself
  // with `null` riding as the null TAG, which is the rep every consumer of a
  // union cell already reads. `emitMapGetUnionBox` answers the same question the
  // same way for a union-valued map read (D1825).
  if popUnionBoxElem(popRefSlot) {
    if pushTakeCond(lIdx, lTy, getIdx, fnIx) < 0 { return -1 }
    fbIfRef(uBoxIdx)
    if pushTakeElem(lIdx, lTy, aTy, getIdx, fnIx) < 0 { return -1 }
    fbRefAsNonNull()
    if emitStaleBoxRetag(popRefSlot, callIx) < 0 { return -1 }
    fbElse() // 0x05 else — absent → the null-tagged box
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone()
    fbStructNew(uBoxIdx)
    fbEnd() // 0x0b end
    return 0
  }
  if popElemHeap < 0 { popElemHeap = sTy() }
  if pushTakeCond(lIdx, lTy, getIdx, fnIx) < 0 { return -1 }
  fbIfRefNul(popElemHeap, true)
  if pushTakeElem(lIdx, lTy, aTy, getIdx, fnIx) < 0 { return -1 }
  fbElse() // 0x05 else — absent → the typed null
  fbRefNull(popElemHeap)
  fbEnd()  // 0x0b end
  return 0
}

// Whether `.clear()` on `recvIx` is a list's (legacy's statement ladder; a map clears otherwise).
export function clearRecvIsList(recvIx: i32, fnIx: i32): boolean {
  return exprArray(recvIx, fnIx)
    || exprRefArray(recvIx, fnIx)
    || exprStringArray(recvIx, fnIx)
    || scalarListElemKind(recvIx, fnIx) != null
}

// The plan a list `.clear()` call is lowered by: its receiver, the wrapper whose length it zeroes,
// and the push scratch base and ref-list slot its receiver stages at. `clFail` is the refusal to
// raise, or "row" where the receiver's ref-list row does not resolve.
export type ClearPlan = {
  clFail: string,
  clRecv: i32,
  clWrap: i32,
  clBase: i32,
  clRefSlot: i32,
}

function clRefused(why: string): ClearPlan {
  const p: ClearPlan = {
    clFail: why,
    clRecv: -1,
    clWrap: -1,
    clBase: -1,
    clRefSlot: -1,
  }
  return p
}

// The plan of list `.clear()` call `callIx`, asked where legacy's arm asks it; it mints nothing.
export function clearPlanOf(callIx: i32, fnIx: i32): ClearPlan {
  if callIx < 0 || callIx >= P.nodes.length {
    return clRefused("emitProgram: expected a .clear call")
  }
  const c = nodeAt(callIx)
  if !(c is Call) || c.callFn < 0 {
    return clRefused("emitProgram: expected a .clear call")
  }
  const callee = nodeAt(c.callFn)
  if !(callee is Member) {
    return clRefused("emitProgram: expected a .clear call")
  }
  if c.callArgs.length != 0 {
    return clRefused(
      "emitProgram: internal: .clear reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  const isRef = exprRefArray(callee.memObj, fnIx)
  const isStr = exprStringArray(callee.memObj, fnIx)
  // the scalar-list family, the arm `emitPop` grew at D977 and this one did not:
  // `exprArray` claims only an i32-element list, so `i64[]`/`f64[]`/`f32[]`/`u8[]`
  // either failed the receiver test or reset the length through the wrong wrapper
  // type wherever an i32 list happened to be collected too — invalid wasm.
  let clearEk = scalarListElemKind(callee.memObj, fnIx)
  if clearEk == "i32" { clearEk = null }
  if !isRef && !isStr && clearEk == null && !exprArray(callee.memObj, fnIx) {
    return clRefused("emitProgram: .clear receiver is not a list")
  }
  const p = clRefused("")
  p.clRecv = callee.memObj
  p.clBase = pushScratchBase
  if isRef {
    if !rlRowsMinted() {
      return clRefused(
        "emitProgram: ref .clear but ref list type not collected",
      )
    }
    // See `emitPop`'s `popRefSlot`.
    const rslot = refListSlotOfExpr(callee.memObj, fnIx)
    if rslot < 0 {
      p.clFail = "row"
      return p
    }
    p.clWrap = rlWrapIdx[rslot]
    p.clRefSlot = rslot
  } else if clearEk != null {
    // The scalar sibling of the i32 default below, and `emitPop`'s arm minus the
    // backing (a `.clear` writes only the length field, so no `aTy`).
    if !scalarListUsedOf(clearEk) {
      return clRefused("emitProgram: .clear but list type not collected")
    }
    p.clWrap = scalarListWrap(clearEk, exprPackedRow(callee.memObj, fnIx))
    p.clBase = scalarPushScratchBaseOf(
      clearEk,
      exprPackedRow(callee.memObj, fnIx),
    )
  } else if isStr {
    p.clWrap = mkListTy()
    p.clBase = strPushScratchBase
  } else {
    p.clWrap = lTy()
  }
  return p
}

// Lower a `.clear()` statement onto `body`: reset the list's logical length to 0,
// retaining the backing. Generic over the list kind, with `emitPop`'s receiver
// resolution (bare local, module global, or struct field via the `recvRef` scratch).
function emitClear(callIx: i32, fnIx: i32) {
  const p = clearPlanOf(callIx, fnIx)
  if p.clFail == "row" { return refListRowRefused(p.clRecv) }
  if p.clFail != "" { return emitFail(p.clFail) }
  const lIdx = listOpRecvLocal(p.clRecv, fnIx, p.clBase, p.clRefSlot, ".clear")
  if lIdx < 0 { return -1 }
  return clearLenTail(p, lIdx)
}

// A list `.clear()` over its receiver held in local `lIdx`: `L.len = 0`, the backing kept.
export function clearLenTail(p: ClearPlan, lIdx: i32): i32 {
  fbLocalGet(lIdx)
  fbI32Const(0)
  fbStructSet(p.clWrap, 1) // 0xfb 0x05 <wrapTy> field 1: len
  return 0
}

// Lower a fused `xs.get(i) ?? d` over a scalar-element list (i32/boolean/f64) onto
// `body`: one unsigned bounds compare selects the element read or the default, so the
// `T | null` intermediate never materializes. Receiver a bare name, index a literal/name.
function emitListGetOr(getIx: i32, defIx: i32, fnIx: i32) {
  const lgSv = listGetStageSave()
  const lgR = emitListGetOrGo(getIx, defIx, fnIx)
  listGetStageRestore(lgSv)
  return lgR
}

// The fused `xs.get(i) ?? d` arm itself, with the call's operands already marked.
function emitListGetOrGo(getIx: i32, defIx: i32, fnIx: i32) {
  const c = nodeAt(getIx)
  if c is Call {
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      if c.callArgs.length != 1 {
        return emitFail(
          "emitProgram: internal: .get reached with the wrong argument count — the checker's arity rule refuses it",
        )
      }
      // The scalar element kind (i32 / f64) selects the list types + read rep. The caller
      // gates on `exprF64Array || exprArray`, so a string list, whose element may be null,
      // takes the generic nullable read instead (D2276).
      const ek = scalarListElemKind(callee.memObj, fnIx)
      if ek == null {
        return emitFail("emitProgram: .get receiver is not a scalar list")
      }
      if !scalarListUsed(ek) {
        return emitFail("emitProgram: .get but list type not collected")
      }
      const lTy = scalarListWrap(ek, exprPackedRow(callee.memObj, fnIx))
      const aTy = scalarListBack(ek, exprPackedRow(callee.memObj, fnIx))
      // The index and the receiver are each emitted twice below, so a non-place operand is
      // staged once in the `.get` stash rather than refused (D1677).
      listGetStageMark(getIx)
      // cond: len u> idx  (one unsigned compare covers negative + past-len). The receiver
      // is evaluated before the index, as every other `.get` spelling does (D3756).
      if emitListGetRecv(callee.memObj, fnIx, lTy) < 0 { return -1 }
      fbStructGet(lTy, 1)       // field 1: len
      if emitListGetIdx(c.callArgs[0], fnIx) < 0 { return -1 }
      fbI32Bin(75)              // 0x4b i32.gt_u
      fbIfForScalarListElem(ek) // 0x04 if, the element's own result rep
      if emitListGetRecv(callee.memObj, fnIx, lTy) < 0 { return -1 }
      fbStructGet(lTy, 0)       // field 0: backing
      if emitListGetIdx(c.callArgs[0], fnIx) < 0 { return -1 }
      fbArrayGet(aTy)           // 0xfb 0x0b array.get — the element
      fbElse()                  // 0x05 else
      if emitScalarValue(defIx, fnIx, ek) < 0 { return -1 }
      fbEnd()                   // 0x0b end
      return 0
    }
  }
  return emitFail("emitProgram: expected a list .get call")
}

// The list a fused `xs.pop() ?? d` reads: its element kind, wrapper and backing heap types, and
// the scratch base a staged receiver parks in. Null when `popIx` is no zero-argument `.pop` on a
// collected i32, f64, i64 or f32 list, which `emitPopOr` refuses by name.
export type PopOrPlan = {
  poEk: VKind,
  poWrap: i32,
  poBack: i32,
  poBase: i32,
  poRecv: i32,
}

export function popOrPlanOf(popIx: i32, fnIx: i32): PopOrPlan | null {
  const c = nodeAt(popIx)
  if !(c is Call) || c.callFn < 0 || c.callArgs.length != 0 { return null }
  const callee = nodeAt(c.callFn)
  if !(callee is Member) { return null }
  const ek0 = scalarListElemKind(callee.memObj, fnIx)
  if ek0 == null || ek0 == "u8list" || !scalarListUsed(ek0) { return null }
  const row = exprPackedRow(callee.memObj, fnIx)
  const p: PopOrPlan = {
    poEk: ek0,
    poWrap: scalarListWrap(ek0, row),
    poBack: scalarListBack(ek0, row),
    poBase: scalarPushScratchBaseOf(ek0, row),
    poRecv: callee.memObj,
  }
  return p
}

// The head of a fused `pop ?? d` once its receiver is in local `lIdx`: `len != 0` opens an `if`
// at the element's own rep whose arm decrements `len` and reads the popped element, then the
// `else` the default fills.
export function popOrOpen(p: PopOrPlan, lIdx: i32) {
  pushListLen(lIdx, p.poWrap)
  fbIfForScalarListElem(p.poEk) // 0x04 if, the element's own result rep
  fbLocalGet(lIdx)
  pushListLen(lIdx, p.poWrap)
  fbI32Const(1)
  fbI32Bin(107)                 // 0x6b i32.sub
  fbStructSet(p.poWrap, 1)      // field 1: len
  pushListBacking(lIdx, p.poWrap)
  pushListLen(lIdx, p.poWrap)
  fbArrayGet(p.poBack)          // the popped element
  fbElse()                      // 0x05 else — empty list → the default
  return 0
}

// Lower a FUSED `xs.pop() ?? d` over a SCALAR-element list (i32 / boolean, and f64 / i64 / f32):
// `len != 0` selects the decrement-and-read (the popped element) or the default. The receiver
// resolves like `emitPop` (bare local, module global, or struct field — the latter two staged
// into the push frame's `recvRef` scratch).
function emitPopOr(popIx: i32, defIx: i32, fnIx: i32) {
  const c = nodeAt(popIx)
  if c is Call {
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      if c.callArgs.length != 0 {
        return emitFail(
          "emitProgram: internal: .pop reached with the wrong argument count — the checker's arity rule refuses it",
        )
      }
      const ek0 = scalarListElemKind(callee.memObj, fnIx)
      if ek0 == null || ek0 == "u8list" {
        return emitFail(
          "emitProgram: fused .pop ?? d receiver is not an i32/f64/i64/f32 list",
        )
      }
      if !scalarListUsed(ek0) {
        return emitFail("emitProgram: .pop but list type not collected")
      }
      const p = popOrPlanOf(popIx, fnIx)
      if p == null { return emitFail("emitProgram: expected a list .pop call") }
      // the fused `pop ?? d` is scalar-only; no ref frame to defer
      const lIdx = listOpRecvLocal(callee.memObj, fnIx, p.poBase, -1, ".pop")
      if lIdx < 0 { return -1 }
      popOrOpen(p, lIdx)
      if emitScalarValue(defIx, fnIx, p.poEk) < 0 { return -1 }
      fbEnd() // 0x0b end
      return 0
    }
  }
  return emitFail("emitProgram: expected a list .pop call")
}

// Writes into `src` the source list types for receiver kind `recvK` at `recvIx`; `src` arrives
// holding the i32 list's. `srcElemRef` is whether an element needs `ref.as_non_null` after
// `array.get`, which a nullable-niche element does not. Returns -1 on a failure, else 0.
function mfSrcTysOf(recvK: ListKind, recvIx: i32, fnIx: i32, src: MfSrcTys) {
  const srcElemNul = listElemStaysNullable(recvIx, fnIx)
  const sek = numListElemOf(recvK)
  if sek != null {
    src.srcWrap = scalarListWrap(sek, 0)
    src.srcBack = scalarListBack(sek, 0)
  } else if recvK == "reflist" {
    if !rlRowsMinted() {
      return emitFail(
        "emitProgram: .map/.filter over a ref list but ref list type not collected",
      )
    }
    const srcSlot = refListSlotOfExpr(recvIx, fnIx)
    if srcSlot < 0 { return refListRowRefused(recvIx) }
    src.srcSlot = srcSlot
    src.srcWrap = rlWrapIdx[srcSlot]
    src.srcBack = rlBackIdx[srcSlot]
    src.srcElemRef = !srcElemNul
  } else if recvK == "strlist" {
    // A STRING list: wrapper `$mkListIdx`, backing `$mkArrIdx` (the array of string
    // refs). The element is itself a ref (an `array i32` of code points), so it needs
    // `ref.as_non_null` after `array.get`, exactly like a ref-list element — unless the
    // element is the `(string | null)[]` niche, which keeps the nullable read.
    src.srcWrap = mkListTy()
    src.srcBack = mkArrTy()
    src.srcElemRef = !srcElemNul
  } else if recvK == "u8list" {
    // the packed byte source, from `mfRecvKindOf`'s `"u8list"` rung (D1141). No
    // `u8[].map`/`.filter` reaches here yet — a `u8` callback parameter is refused one
    // stage earlier — so this arm buys no cell today, but avoids silently minting the
    // 4-byte backing the moment the parameter gap closes.
    const sr = exprPackedRow(recvIx, fnIx)
    src.srcSlot = sr
    src.srcWrap = pkWrapAt(sr)
    src.srcBack = pkBackAt(sr)
  } else {
    src.srcWrap = lTy()
    src.srcBack = aTy()
  }
  return 0
}

// The wrapper and backing heap types of a `.map`/`.filter` source list, its ref-list row
// (-1 for a non-ref list), and whether its element is read as a non-null ref.
type MfSrcTys = {
  srcWrap: i32,
  srcBack: i32,
  srcElemRef: boolean,
  srcSlot: i32,
}

// The interned signature of `.map`/`.filter` callback `argIx`: the lifted function `cbFe`'s, or
// for a closure value (a function-typed parameter or binding) its own `$fnsig` key's. -1 when
// none is interned.
function mfCallbackSigOf(argIx: i32, cbFe: i32, fnIx: i32): i32 {
  let sig = -1
  if cbFe >= 0 {
    sig = fnSigIdxOfFn(cbFe)
  } else {
    // A closure-value callback (`xs.map(f)` where `f: (i32) => i32`) has no lifted fe to
    // inline; the loop `call_ref`s the closure value exactly as for a named-function callback.
    let ck = mfCallbackCloKey(argIx, fnIx)
    // A set's id coerced to its member's closure at a closed type is a closure of that type.
    const ct = fnCloCoerceAtNode(unwrapParen(argIx))
    if ct >= 0 {
      const k = sigKeyOfTy(ct)
      if k != "" && cloSigPosOfKey(k) >= 0 { ck = k }
    }
    if ck != "" { sig = cloSigTypeIdxAt(cloSigPosOfKey(ck)) }
  }
  return sig
}

// The closure value of `.map`/`.filter` callback `argIx`: an inline literal or named function
// builds it from `cbFe`, a let-bound value reads its binding. Returns 0, or -1 once failed.
function emitMfCallbackValue(argIx: i32, cbFe: i32, fnIx: i32) {
  const cbNode = nodeAt(unwrapParen(argIx))
  if cbNode is FuncDecl {
    if emitClosureValue(cbFe, fnIx) < 0 { return -1 }
  } else if cbNode is Ident {
    if cbIdentNamesFn(argIx, fnIx) {
      if emitClosureValue(cbFe, fnIx) < 0 { return -1 }
    } else if emitExpr(argIx, fnIx) < 0 {
      return -1
    }
  } else if fnValuePlain(argIx, 0) {
    // Any other plain function-valued expression builds its closure value as a binding does.
    if emitExpr(argIx, fnIx) < 0 { return -1 }
  } else {
    return emitFail("emitProgram: unsupported .map/.filter callback")
  }
  return 0
}

// The plan `.map`/`.filter` call `callIx` is lowered by: what legacy's arm computed before it wrote
// the receiver. `mfFail` is the refusal to raise, or "-" where a type lookup already raised one.
export type MfPlan = {
  mfFail: string,
  mfIsMap: boolean,
  mfRecv: i32,
  mfCb: i32,
  mfCbFe: i32,
  mfSig: i32,
  mfResK: ListKind,
  mfDstSlot: i32,
  mfSrc: MfSrcTys,
  mfDst: MfDstTys,
  mfSrcL: i32,
  mfDstL: i32,
}

function mfRefused(why: string): MfPlan {
  const src: MfSrcTys = {
    srcWrap: -1,
    srcBack: -1,
    srcElemRef: false,
    srcSlot: -1,
  }
  const dst: MfDstTys = { dstWrap: -1, dstBack: -1 }
  const p: MfPlan = {
    mfFail: why,
    mfIsMap: false,
    mfRecv: -1,
    mfCb: -1,
    mfCbFe: -1,
    mfSig: -1,
    mfResK: "list",
    mfDstSlot: -1,
    mfSrc: src,
    mfDst: dst,
    mfSrcL: -1,
    mfDstL: -1,
  }
  return p
}

// Why the IR does not lower `.map`/`.filter` call `callIx`, or "": its receiver and result are
// lists legacy's arm takes, and its callback a capture-free function or a function-typed binding.
// It mints nothing, so the builder may ask it ahead of the lowering.
export function mapFilterWhy(callIx: i32, fnIx: i32): string {
  const c = nodeAt(callIx)
  if !(c is Call) || c.callFn < 0 || c.callArgs.length != 1 {
    return "map call"
  }
  const callee = nodeAt(c.callFn)
  if !(callee is Member) { return "map call" }
  if mfRecvKindOf(callee.memObj, fnIx) == null { return "map receiver kind" }
  if mfResultKindOf(callIx, fnIx) == null { return "map result kind" }
  const cb = unwrapParen(c.callArgs[0])
  if cb < 0 { return "map callback" }
  const cbn = nodeAt(cb)
  const fe = mfCallbackFe(c.callArgs[0], fnIx)
  if cbn is FuncDecl || cbn is Ident && cbIdentNamesFn(c.callArgs[0], fnIx) {
    if fe < 0 || fnEnvIdxOf(fe) >= 0 { return "map callback env" }
    return ""
  }
  if cbn is Ident { return "" }
  return "map callback expression"
}

// The plan of `.map`/`.filter` call `callIx`, asked where legacy's arm asks it.
export function mapFilterPlanOf(callIx: i32, fnIx: i32): MfPlan {
  const c = nodeAt(callIx)
  if !(c is Call) || c.callFn < 0 {
    return mfRefused("emitProgram: expected a .map/.filter call")
  }
  const callee = nodeAt(c.callFn)
  if !(callee is Member) {
    return mfRefused("emitProgram: expected a .map/.filter call")
  }
  if c.callArgs.length != 1 {
    return mfRefused(
      "emitProgram: internal: .map/.filter reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  const recvK = mfRecvKindOf(callee.memObj, fnIx)
  if recvK == null {
    return mfRefused(
      "emitProgram: .map/.filter receiver is not a supported list",
    )
  }
  const resK = mfResultKindOf(callIx, fnIx)
  if resK == null {
    return mfRefused("emitProgram: unsupported .map/.filter element type")
  }
  // The ref-list slot for a kind-2 result (`.filter` over a struct array) — picks the
  // result backing/wrapper + the matching dst scratch local. -1 for a non-ref result.
  const dstSlot = mfResultSlotOf(callIx, fnIx)
  const cbFe = mfCallbackFe(c.callArgs[0], fnIx)
  const sig = mfCallbackSigOf(c.callArgs[0], cbFe, fnIx)
  if sig < 0 {
    return mfRefused(
      "emitProgram: .map/.filter callback signature is not interned",
    )
  }
  const p = mfRefused("")
  if mfSrcTysOf(recvK, callee.memObj, fnIx, p.mfSrc) < 0 {
    return mfRefused("-")
  }
  // The RESULT wrapper/backing heap types.
  if mfDstTysOf(resK, dstSlot, callIx, p.mfDst) < 0 { return mfRefused("-") }
  p.mfSrcL = mfSrcLocalFor(recvK, p.mfSrc.srcSlot)
  p.mfDstL = mfDstLocalFor(resK, dstSlot)
  if !fnUses.mapFilter || p.mfSrcL < 0 || p.mfDstL < 0 {
    return mfRefused("emitProgram: .map/.filter scratch frame not reserved")
  }
  p.mfIsMap = callee.memProp == "map"
  p.mfRecv = callee.memObj
  p.mfCb = c.callArgs[0]
  p.mfCbFe = cbFe
  p.mfSig = sig
  p.mfResK = resK
  p.mfDstSlot = dstSlot
  return p
}

function emitMapFilter(callIx: i32, fnIx: i32) {
  const p = mapFilterPlanOf(callIx, fnIx)
  if p.mfFail == "-" { return -1 }
  if p.mfFail != "" { return emitFail(p.mfFail) }
  const cL = mfCallbackLocal()
  // src = <receiver>, evaluated ONCE. (Any nested `.map`/`.filter` in the
  // receiver chain completes — including its result wrapper — before this store,
  // so the shared frame slots are free to reuse.)
  if emitExpr(p.mfRecv, fnIx) < 0 { return -1 }
  mfRecvTail(p, fnIx)
  // clo = the callback's closure value, built ONCE before the loop. An inline
  // literal / named function constructs it directly; a let-bound value reads its
  // binding (an `Ident` read — it cannot itself contain a HOF site, so the frame
  // slots written above stay live).
  if emitMfCallbackValue(p.mfCb, p.mfCbFe, fnIx) < 0 { return -1 }
  return mfLoopTail(p, cL)
}

// After a `.map`/`.filter` receiver: its recovery and store, and the element seats the loop reads.
export function mfRecvTail(p: MfPlan, fnIx: i32) {
  // A NARROWED nullable-list receiver keeps its nullable slot at EVERY element kind;
  // the src scratch slot is declared non-null (`fbRefRun` writes `0x64`), so recover
  // first (checker-guarded, never traps). See `nulRecvNeedsRecover`.
  if nulRecvNeedsRecover(p.mfRecv, fnIx) { fbRefAsNonNull() }
  svSyncRecv(p.mfRecv, fnIx)
  fbLocalSet(p.mfSrcL)
  mfSrcSlot = -1
  if p.mfSrc.srcElemRef { mfSrcSlot = p.mfSrc.srcSlot }
  mfSvDst = svDstOfKind(scalarListElemKind(p.mfRecv, fnIx))
  mfRv = rvRecvMayView(p.mfRecv, fnIx)
  return 0
}

// After a `.map`/`.filter` callback's closure value: its store in `cL`, the loop and the result.
export function mfLoopTail(p: MfPlan, cL: i32) {
  const srcWrap = p.mfSrc.srcWrap
  const srcBack = p.mfSrc.srcBack
  const srcElemRef = p.mfSrc.srcElemRef
  const dstWrap = p.mfDst.dstWrap
  const dstBack = p.mfDst.dstBack
  const srcL = p.mfSrcL
  const dstL = p.mfDstL
  const isMap = p.mfIsMap
  const resK = p.mfResK
  const dstSlot = p.mfDstSlot
  const sig = p.mfSig
  const iL = mfScratchBase
  const nL = mfScratchBase + 1
  const jL = mfScratchBase + 2
  fbLocalSet(cL)
  // n = src.len
  fbLocalGet(srcL)
  fbStructGet(srcWrap, 1) // field 1: len
  fbLocalSet(nL)
  // back = array.new_default <dstBack> n
  fbLocalGet(nL)
  fbArrayNewDefault(dstBack)
  fbLocalSet(dstL)
  // i = 0 (and j = 0 for filter)
  fbI32Const(0)
  fbLocalSet(iL)
  if !isMap {
    fbI32Const(0)
    fbLocalSet(jL)
  }
  // block { loop { if i >= n br 1; <element step>; i++; br 0 } }
  fbBlock(64)  // 0x02 block (void)
  fbLoop(64)   // 0x03 loop (void)
  fbLocalGet(iL)
  fbLocalGet(nL)
  fbI32Bin(78) // 0x4e i32.ge_s — i >= n?
  fbBrIf(1)    // exit the block
  // The length is fixed at entry; an index the callback has since cut off ends a map with
  // the trap an `xs[i]` read raises, and is skipped by a filter (D3068).
  fbLocalGet(iL)
  fbLocalGet(srcL)
  fbStructGet(srcWrap, 1)
  fbI32Bin(78) // 0x4e i32.ge_s — i >= the current length?
  if isMap {
    fbIf(64)
    emitListIdxTrapOf(srcBack, srcL, srcWrap, -1)
    fbEnd()
  } else {
    fbI32Eqz()
    fbIf(64) // the filter's step, closed after it
  }
  if isMap {
    // back[i] = call_ref(clo, [elem(i)])
    fbLocalGet(dstL)
    fbLocalGet(iL)
    if (emitMfInvoke(cL, srcL, iL, srcWrap, srcBack, srcElemRef, sig) < 0) {
      return -1
    }
    fbArraySet(dstBack) // 0xfb 0x0e <dstBack>
  } else {
    // e = elem(i); if call_ref(clo, [e]): back[j] = e; j++. The element is read once, so
    // the kept value is the one the callback tested, whatever it writes (D3060).
    let eSlot = 0
    if resK == "reflist" { eSlot = dstSlot }
    const eL = listIdxValSlot(resK, eSlot)
    if emitMfElem(srcL, iL, srcWrap, srcBack, srcElemRef) < 0 { return -1 }
    fbLocalSet(eL)
    fbLocalGet(cL)
    fbStructGet(cloStructIdx, 0) // env
    fbLocalGet(eL)
    if srcElemRef { fbRefAsNonNull() }
    fbLocalGet(cL)
    fbStructGet(cloStructIdx, 1) // the callee's wasm function index
    fbCallIndirect(sig, gFnTableIdx)
    fbIf(64)                     // 0x04 if (void)
    fbLocalGet(dstL)
    fbLocalGet(jL)
    fbLocalGet(eL)
    fbArraySet(dstBack)
    fbLocalGet(jL)
    fbI32Const(1)
    fbI32Bin(106)                // 0x6a i32.add
    fbLocalSet(jL)
    fbEnd()
    fbEnd()                      // the current-length test
  }
  fbLocalGet(iL)
  fbI32Const(1)
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(iL)
  fbBr(0)       // continue the loop
  fbEnd()       // end loop
  fbEnd()       // end block
  mfSrcSlot = -1
  mfSvDst = -1
  mfRv = false
  // result = wrapper{ back, len, cap }: len = n (map) / j (filter), cap = n.
  fbLocalGet(dstL)
  if isMap { fbLocalGet(nL) } else { fbLocalGet(jL) }
  fbLocalGet(nL)
  fbStructNew(dstWrap)
  return 0
}

// The wrapper and backing heap types of a `.map`/`.filter` result list.
type MfDstTys = {
  dstWrap: i32,
  dstBack: i32,
}

// Writes into `dst` the result list types for result kind `resK`; `dst` arrives holding the
// i32 list's, and `dstSlot` is a ref-list result's row. Returns -1 on a failure, else 0.
function mfDstTysOf(resK: ListKind, dstSlot: i32, callIx: i32, dst: MfDstTys) {
  const dek = numListElemOf(resK)
  if dek != null {
    dst.dstWrap = scalarListWrap(dek, 0)
    dst.dstBack = scalarListBack(dek, 0)
  } else if resK == "strlist" {
    // A STRING-list result: a `.filter` over a string list, or a `.map` whose callback
    // returns a string. The backing `$mkArrIdx` holds string refs; `array.set` stores
    // the callback's (non-null) string result directly.
    dst.dstWrap = mkListTy()
    dst.dstBack = mkArrTy()
  } else if resK == "reflist" {
    // A REF-list result (a `.filter` over a struct/union array preserves the element type):
    // the result is the SAME ref list as the source, so its wrapper/backing come from the
    // result slot (== the source slot for `.filter`).
    if !rlRowsMinted() {
      return emitFail(
        "emitProgram: .filter result is a ref list but ref list type not collected",
      )
    }
    if dstSlot < 0 { return refListRowRefused(callIx) }
    dst.dstWrap = rlWrapIdx[dstSlot]
    dst.dstBack = rlBackIdx[dstSlot]
  } else if resK == "u8list" {
    // A `.filter` over a `u8[]` keeps the packed rep (`mfResultKindOf` forwards the
    // receiver's kind) — the destination twin of the source arm above, and unreachable
    // for the same reason until the `u8` callback parameter has a lowering.
    dst.dstWrap = pkWrapAt(dstSlot)
    dst.dstBack = pkBackAt(dstSlot)
  } else {
    dst.dstWrap = lTy()
    dst.dstBack = aTy()
  }
  return 0
}

// The frame every element-converting list copy shares: the source list on the stack is held in
// `sL`, a destination backing of its length made in `dL`, and a loop over `i` entered with the
// store's array and index pushed when the element step writes; the step then leaves the element.
function emitCopyLoopOpen(
  sL: i32,
  srcWrap: i32,
  nL: i32,
  dstBack: i32,
  dL: i32,
  iL: i32,
) {
  fbLocalSet(sL)
  fbLocalGet(sL)
  fbStructGet(srcWrap, 1)
  fbLocalSet(nL)
  fbLocalGet(nL)
  fbArrayNewDefault(dstBack)
  fbLocalSet(dL)
  fbI32Const(0)
  fbLocalSet(iL)
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(iL)
  fbLocalGet(nL)
  fbI32Bin(78) // i32.ge_s
  fbBrIf(1)
  return 0
}

// Close `emitCopyLoopOpen`'s loop after the element's store and leave the destination list, whose
// backing field is non-null and whose capacity is its length.
function emitCopyLoopClose(iL: i32, dL: i32, nL: i32, dstWrap: i32) {
  fbLocalGet(iL)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  fbLocalSet(iL)
  fbBr(0)
  fbEnd()
  fbEnd()
  fbLocalGet(dL)
  fbRefAsNonNull()
  fbLocalGet(nL)
  fbLocalGet(nL)
  fbStructNew(dstWrap)
  return 0
}

// ── the element-converting copy (read-only covariance, D791) ──────────────────
// Consume a `(ref $rlWrapIdx[srcSlot])` on the stack and leave a `(ref $rlWrapIdx[dstSlot])`
// holding the same elements boxed into the shared union box — the only lowering the pair
// has, since a mutable WasmGC array is invariant. Callers must ask `rlWidenAllowed` first.
function emitRefListWidenTop(srcSlot: i32, dstSlot: i32) {
  const tag = rlWidenTagOf(srcSlot, dstSlot)
  if tag < 0 {
    return emitFail(
      "emitProgram: ref-list widening asked for an element pair with no union arm",
    )
  }
  // The `fbValtype` discipline: never index a parallel `rl*` table on a slot that only
  // one of them covers. `rlWidenVariantOf` bounded the slot table; these are the two
  // columns the loop's heap-type immediates come from.
  if srcSlot >= rlWrapIdx.length || dstSlot >= rlWrapIdx.length {
    return emitFail(
      "emitProgram: ref-list widening slot has no interned wrapper",
    )
  }
  if srcSlot >= rlBackIdx.length || dstSlot >= rlBackIdx.length {
    return emitFail(
      "emitProgram: ref-list widening slot has no interned backing",
    )
  }
  const srcWrap = rlWrapIdx[srcSlot]
  const srcBack = rlBackIdx[srcSlot]
  const dstWrap = rlWrapIdx[dstSlot]
  const dstBack = rlBackIdx[dstSlot]
  const sL = widenSrcWrapSlot(srcSlot)
  const dL = widenDstBackSlot(dstSlot)
  const iL = widenTmpSlot(0)
  const nL = widenTmpSlot(1)
  // Does the SOURCE row's element carry the `| null` niche (D811)? This is the one bit
  // that picks the loop body below, and it is read from the same column
  // `rlWidenVariantOf` bounded.
  const srcNul = srcSlot < rlElemNullable.length && rlElemNullable[srcSlot] == 1
  // src = <stack>, evaluated ONCE by the caller.
  emitCopyLoopOpen(sL, srcWrap, nL, dstBack, dL, iL)
  // block { loop { if i >= n br 1; back[i] = {tag, src.back[i]}; i++; br 0 } }
  fbLocalGet(dL)
  fbLocalGet(iL)
  if srcNul {
    // the niche source's two-tag loop body (D811): the source element is `(ref null
    // $elem)` whose null is a legal value, and the destination box has a rep for that — a
    // box carrying `nullBoxTag()`. Boxing under the arm's tag instead is D792's trap: the
    // narrow's `ref.cast` would fail on the null payload, so the tag is picked per element.
    fbLocalGet(sL)
    fbStructGet(srcWrap, 0)
    fbLocalGet(iL)
    fbArrayGet(srcBack)
    fbRefIsNull()
    fbIfRefNul(uBoxIdx, false) // if (result (ref $uBox))
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone() // the payload slot is unread under the null tag
    fbStructNew(uBoxIdx)
    fbElse()
    fbI32Rel(RS_TAG, tag) // the arm's program-global tag
    fbLocalGet(sL)
    fbStructGet(srcWrap, 0)
    fbLocalGet(iL)
    fbArrayGet(srcBack)
    fbStructNew(uBoxIdx)
    fbEnd()
  } else {
    fbI32Rel(RS_TAG, tag) // the arm's program-global tag
    fbLocalGet(sL)
    fbStructGet(srcWrap, 0) // the source backing, `(ref $srcBack)`
    fbLocalGet(iL)
    fbArrayGet(srcBack) // `(ref null $elem)` — the box payload is `anyref`, so no recover
    fbStructNew(uBoxIdx)
  }
  fbArraySet(dstBack)
  emitCopyLoopClose(iL, dL, nL, dstWrap)
  return 0
}

// Consume a list at union-box row `srcSlot` on the stack and leave a fresh list at union-box row
// `dstSlot` holding each box rebuilt under `dstSlot`'s members, a member it lacks widened
// (`rlUnionRowRetags` admitted the pair, D16880).
function emitUnionListRetagTop(srcSlot: i32, dstSlot: i32, at: i32) {
  if (
    srcSlot >= rlWrapIdx.length
    || dstSlot >= rlWrapIdx.length
    || srcSlot >= rlBackIdx.length
    || dstSlot >= rlBackIdx.length
  ) {
    return emitFailAt(
      "emitProgram: a union list retag has no interned list type",
      at,
    )
  }
  const ft: i32[] = []
  const tt: i32[] = []
  if (
    !canonUnionMemberTysOf(rlElemTyIx[srcSlot], ft)
    || !canonUnionMemberTysOf(rlElemTyIx[dstSlot], tt)
  ) {
    return emitFailAt("emitProgram: a union list retag has no member set", at)
  }
  const srcWrap = rlWrapIdx[srcSlot]
  const srcBack = rlBackIdx[srcSlot]
  const dstWrap = rlWrapIdx[dstSlot]
  const dstBack = rlBackIdx[dstSlot]
  const sL = widenSrcWrapSlot(srcSlot)
  const dL = widenDstBackSlot(dstSlot)
  const iL = widenTmpSlot(0)
  const nL = widenTmpSlot(1)
  emitCopyLoopOpen(sL, srcWrap, nL, dstBack, dL, iL)
  fbLocalGet(dL)
  fbLocalGet(iL)
  fbLocalGet(sL)
  fbStructGet(srcWrap, 0)
  fbLocalGet(iL)
  fbArrayGet(srcBack)
  // Below `len` every element is a box: a `null` member is boxed under its own tag.
  fbRefAsNonNull()
  if emitBoxAtomRetagMembers(ft, tt, at) < 0 { return -1 }
  fbArraySet(dstBack)
  emitCopyLoopClose(iL, dL, nL, dstWrap)
  return 0
}

// the scalar sibling of `emitRefListWidenTop` (D965): same loop, a numeric convert where
// the ref version boxes. Exactly the three lossless widenings VL's scalar assignability
// admits (i32→i64, i32→f64, f32→f64) over the full source/destination grid — every other
// pair is a design rejection, outside clause 2. Returns the opcode, or -1 for a decline (never an error).
function scalarWidenConvOp(srcKind: VKind, dstKind: VKind): i32 {
  match srcKind {
    "i32" => {
      match dstKind {
        "i64" => {
          return 172
        }
        "f64" => {
          return 183
        }
        // No other destination is a lossless widening of i32.
        "i32" | "struct" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "f64list" | "f32" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "v128list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" | "v128" => {}
      }
      return -1
    }
    "f32" => {
      match dstKind {
        "f64" => {
          return 187
        }
        // No other destination is a lossless widening of f32.
        "i32" | "struct" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "i64" | "f64list" | "f32" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "v128list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" | "v128" => {}
      }
    }
    // No other source kind widens.
    "struct" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "i64" | "f64" | "f64list" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "v128list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" | "v128" => {}
  }
  return -1
}

function emitScalarListWidenTop(srcKind: VKind, dstKind: VKind) {
  const op = scalarWidenConvOp(srcKind, dstKind)
  if op < 0 {
    return emitFail(
      "emitProgram: scalar-list widening asked for an element pair with no convert",
    )
  }
  const srcWrap = scalarListWrap(srcKind, 0)
  const srcBack = scalarListBack(srcKind, 0)
  const dstWrap = scalarListWrap(dstKind, 0)
  const dstBack = scalarListBack(dstKind, 0)
  const sL = widenScalarWrapSlot(listIdxKindOf(srcKind))
  const dL = widenScalarBackSlot(listIdxKindOf(dstKind))
  // Inside an element-by-element copy, the next pair of temps (`rcLoopDepth`).
  const iL = widenTmpSlot(2 * rcLoopDepth)
  const nL = widenTmpSlot(2 * rcLoopDepth + 1)
  // src = <stack>, evaluated ONCE by the caller.
  emitCopyLoopOpen(sL, srcWrap, nL, dstBack, dL, iL)
  // block { loop { if i >= n br 1; back[i] = conv(src.back[i]); i++; br 0 } }
  fbLocalGet(dL)
  fbLocalGet(iL)
  fbLocalGet(sL)
  fbStructGet(srcWrap, 0) // the source backing
  fbLocalGet(iL)
  fbArrayGet(srcBack) // yields the element in the SOURCE's rep
  wU8(op) // ...and this is the one byte that makes it the destination's
  fbArraySet(dstBack)
  emitCopyLoopClose(iL, dL, nL, dstWrap)
  return 0
}

// Consume a list of literal-union atoms (`i32` ids) on the stack and leave a `string[]` whose
// elements are each atom's member string, `texts` giving the members (D2868). The string-list
// sibling of `emitScalarListWidenTop`; the per-element tower is `emitAtomToStr`'s.
function emitAtomListToStrTop(texts: string[]) {
  if texts.length == 0 {
    return emitFail(
      "emitProgram: a spread widening literal-union atoms to strings has no members",
    )
  }
  const srcWrap = scalarListWrap("i32", 0)
  const srcBack = scalarListBack("i32", 0)
  const dstWrap = scalarListWrap("str", 0)
  const dstBack = scalarListBack("str", 0)
  const sL = widenScalarWrapSlot("list")
  const dL = widenScalarBackSlot("strlist")
  const iL = widenTmpSlot(0)
  const nL = widenTmpSlot(1)
  const aL = widenTmpSlot(2)
  emitCopyLoopOpen(sL, srcWrap, nL, dstBack, dL, iL)
  // block { loop { if i >= n br 1; a = src.back[i]; back[i] = str(a); i++; br 0 } }
  fbLocalGet(sL)
  fbStructGet(srcWrap, 0)
  fbLocalGet(iL)
  fbArrayGet(srcBack)
  fbLocalSet(aL)
  fbLocalGet(dL)
  fbLocalGet(iL)
  if emitAtomLocalToStrChain(texts, 0, aL) < 0 { return -1 }
  fbArraySet(dstBack)
  emitCopyLoopClose(iL, dL, nL, dstWrap)
  return 0
}

// `emitAtomToStrChain` over an atom id held in local `aL` rather than the string-op frame,
// which a function reserves only when it has a string operation of its own.
function emitAtomLocalToStrChain(texts: string[], i: i32, aL: i32) {
  if i >= texts.length - 1 { return emitStr(mkStr(quoteLex(texts[i]), -1), -1) }
  if emitStr(mkStr(quoteLex(texts[i]), -1), -1) < 0 { return -1 }
  if emitAtomLocalToStrChain(texts, i + 1, aL) < 0 { return -1 }
  fbLocalGet(aL)
  fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
  fbI32Bin(70) // i32.eq
  fbSelectRef(sTy())
  return 0
}

// The convert opcode an element of `srcKind` takes before it is boxed under value atom
// `atomK`: -1 when the atom is the element's own, -2 when no lossless widening reaches it.
function scalarBoxWidenOp(srcKind: VKind, atomK: i32): i32 {
  if atomK == 3 {
    if srcKind == "i64" { return -1 }
    const o = scalarWidenConvOp(srcKind, "i64")
    if o < 0 { return -2 }
    return o
  }
  if atomK == 4 {
    if srcKind == "f64" { return -1 }
    const o = scalarWidenConvOp(srcKind, "f64")
    if o < 0 { return -2 }
    return o
  }
  return -1
}

// The value atom a scalar list `st`'s elements are boxed under in the list `dt` whose element is a
// `| null` holding them (or a number they widen to) or a union listing them, else -1.
function rcListBoxAtom(st: i32, dt: i32): i32 {
  if st < 0 || dt < 0 || st >= T.tys.length || dt >= T.tys.length { return -1 }
  const sa = tyAt(st)
  const da = tyAt(dt)
  if !(sa is TyArray) || !(da is TyArray) { return -1 }
  const se = tyElemOf(sa)
  const de = tyElemOf(da)
  if se < 0 || de < 0 || se >= T.tys.length || de >= T.tys.length { return -1 }
  if !(tyAt(se) is TyPrim) { return -1 }
  const d = tyAt(de)
  if d is TyNullable {
    if tySame(d.nInner, se) { return boxTagOfTy(se) }
    if rcWidenTo(boxTagOfTy(se), d.nInner) >= 0 { return boxTagOfTy(d.nInner) }
    return -1
  }
  if d is TyUnion {
    for m in d.uMembers {
      if tySame(m, se) { return boxTagOfTy(se) }
    }
    return -1
  }
  return rcListElemUnboxed(de)
}

// A list element that is neither a `| null` nor a union stores a scalar unboxed: no atom.
function rcListElemUnboxed(_de: i32): i32 { return -1 }

// Consume a scalar list of `srcKind` on the stack and leave a `(ref $rlWrapIdx[dstSlot])` whose
// union-box elements each hold one source element under value atom `atomK`'s tag: the boxing
// sibling of `emitScalarListWidenTop`, for a spread into a list of a union element (D2869).
// `nul` (`SPREAD_NUL_*`) says how a source element is null; it lands as the union's null box.
function emitScalarListBoxTop(
  srcKind: VKind,
  atomK: i32,
  dstSlot: i32,
  nul: i32,
  depth: i32,
) {
  const conv = scalarBoxWidenOp(srcKind, atomK)
  if conv == -2 {
    return emitFail(
      "emitProgram: a spread boxing a scalar list has no convert into its element's atom",
    )
  }
  let vb = -1
  if atomK != 2 {
    vb = vbHeapIdxOfKind(atomK)
    if vb < 0 {
      return emitFail(
        "emitProgram: a spread boxing a scalar list has no value box for its element",
      )
    }
  }
  if dstSlot < 0 || dstSlot >= rlWrapIdx.length || dstSlot >= rlBackIdx.length {
    return emitFail(
      "emitProgram: a spread boxing a scalar list has no destination row",
    )
  }
  const srcWrap = scalarListWrap(srcKind, 0)
  const srcBack = scalarListBack(srcKind, 0)
  const dstWrap = rlWrapIdx[dstSlot]
  const dstBack = rlBackIdx[dstSlot]
  let sk = listIdxKindOf(srcKind)
  if srcKind == "str" { sk = "strlist" }
  const sL = widenScalarWrapSlot(sk)
  const dL = widenDstBackSlot(dstSlot)
  // Inside an element-by-element copy, the next pair of temps.
  const iL = widenTmpSlot(2 * depth)
  const nL = widenTmpSlot(2 * depth + 1)
  emitCopyLoopOpen(sL, srcWrap, nL, dstBack, dL, iL)
  // block { loop { if i >= n br 1; back[i] = {tag, box(src.back[i])}; i++; br 0 } }
  fbLocalGet(dL)
  fbLocalGet(iL)
  if nul != SPREAD_NUL_NONE {
    fbLocalGet(sL)
    fbStructGet(srcWrap, 0)
    fbLocalGet(iL)
    fbArrayGet(srcBack)
    if nul == SPREAD_NUL_REF {
      fbRefIsNull()
    } else {
      fbRefNullOfKind("nulbool", -1)
      fbI32Bin(70) // i32.eq
    }
    fbIfRef(uBoxIdx)
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone()
    fbStructNew(uBoxIdx)
    fbElse()
  }
  fbI32Rel(RS_TAG, scalarTagOfKind(atomK))
  fbLocalGet(sL)
  fbStructGet(srcWrap, 0)
  fbLocalGet(iL)
  fbArrayGet(srcBack)
  if nul == SPREAD_NUL_REF { fbRefAsNonNull() }
  if conv >= 0 { wU8(conv) }
  if vb >= 0 { fbStructNew(vb) }
  fbStructNew(uBoxIdx)
  if nul != SPREAD_NUL_NONE { fbEnd() }
  fbArraySet(dstBack)
  emitCopyLoopClose(iL, dL, nL, dstWrap)
  return 0
}

// A ref-list slot's element type name for a message, or `"?"` where the slot has no row —
// the parallel `rl*` columns are sized independently, so this is the one bounded read.
function rlWidenElemName(slot: i32): string {
  if slot < 0 { return "?" }
  if slot >= rlElemName.length { return "?" }
  return rlElemName[slot]
}

// A widenable pair whose converting copy the licence declined. The copy is a snapshot, so an
// unknown write state may not be guessed at, and no second lowering exists — the delivery
// would otherwise leave the source's rep in a destination-repped slot. Refused here rather
// than in the checker, whose half of the licence omits the rep-scoped write scan (D1656).
function emitRefListWidenDeclined(
  srcIx: i32,
  srcSlot: i32,
  dstSlot: i32,
): boolean {
  const dn = rlWidenElemName(dstSlot)
  emitFailAt(
    "emitProgram: covariant list delivery: a "
      + rlWidenElemName(srcSlot)
      + "[] cannot be delivered into a "
      + dn
      + "[] here. The two element storages differ, so the destination would have to hold an "
      + "element-converting COPY, and that copy is a snapshot — legal only where nothing "
      + "writes either list. This program writes through one of them, and the covariant-write "
      + "analysis cannot reach every handle on this value: a container whose call result is "
      + "delivered under no name, an intermediate container given a name of its own, and a "
      + "callee whose parameter list this program does not spell (a function-typed parameter, "
      + "a re-pointed function binding, a lambda held in a field) each end its walk, so it "
      + "cannot tell whether that write reaches this list. Declare the receiving parameter "
      + "`readonly "
      + dn
      + "[]` — a read-only view needs no such proof, since nothing may write through it — or "
      + "give every container the value passes through a name, call only functions and "
      + "lambdas bound once by name, or declare the source as "
      + dn
      + "[]",
    srcIx,
  )
  return false
}

// Whether `srcIx` names a binding whose record-literal list the checker built at a union list.
function identBuiltAtUnionList(srcIx: i32): boolean {
  if !(nodeAt(unwrapParen(srcIx)) is Ident) { return false }
  const k = cwKeyOfRoot(srcIx)
  return k >= 0
    && nodeAt(k) is LetDecl
    && letInitUnionListTy(k, cwKeyFrame(k)) >= 0
}

// The node `emitCoerced` is emitting before its conversion, or -1.
let coerceHeld = -1

// The value of `ix` delivered at its position: the table converts it by its records, a box
// included (`boxOwedAt`). Returns 0, or -1 failed.
function emitDelivered(ix: i32, fnIx: i32): i32 {
  const seat = boxSeat
  boxSeat = ix
  const r = emitExpr(ix, fnIx)
  boxSeat = seat
  return r
}

// `emitExpr` for a value whose delivery the checker recorded a coercion of kind `ck` at: the
// value as built, then the one conversion for its kind. Every delivery position lowers it
// here. Returns 0, or -1 failed.
function emitCoerced(exprIx: i32, fnIx: i32, ck: CoerceKind): i32 {
  if ck == "box" {
    // The seat is spent, so the value inside the box, and any conversion recorded beside it, runs.
    const bt = boxRecordTyAt(exprIx, fnIx)
    const seat = boxSeat
    boxSeat = -1
    if boxDstShadowArmed() { boxDstShadowAs("table") }
    const rb = emitUnionBoxArg("", boxRecordUnionTyOf(bt), exprIx, fnIx)
    boxSeat = seat
    return rb
  }
  if ck == "atomstr" { return emitAtomStrAtRecord(exprIx, fnIx) }
  if ck == "unbox" {
    // The seat is spent, so any other record at the node converts the value before the cast.
    armSeat = -1
    if emitExpr(exprIx, fnIx) < 0 { return -1 }
    armServed = exprIx
    return emitArmUnboxCast(
      armRecordHeapAt(exprIx, fnIx),
      armUnboxNullable(exprIx, fnIx),
    )
  }
  let fe = -1
  if ck == "fnClo" {
    fe = monoCloCoerceFe.get(exprIx) ?? -1
    if fe < 0 { fe = monoCloCoerceFe.get(nodeSrc[exprIx] ?? -1) ?? -1 }
    if fe < 0 {
      return emitFailAt(
        "emitProgram: a function delivered to a declared function type has no instance there",
        exprIx,
      )
    }
  }
  const held = coerceHeld
  coerceHeld = exprIx
  if ck == "recCopy" {
    // A copy reads each field off the value, so the node stays held for the whole copy.
    const rc = emitRecCopyInto(exprIx, recCopyRowAt(exprIx, fnIx), fnIx)
    coerceHeld = held
    return rc
  }
  const boxed = (ck == "mapUnbox" || ck == "mapRetag")
    && exprUnion(exprIx, fnIx)
  const r = emitExpr(exprIx, fnIx)
  coerceHeld = held
  if r < 0 { return -1 }
  if ck == "listCopy" || ck == "mapRetag" { return coerceTail(exprIx, fnIx) }
  match ck {
    "listCopy" => {
      return emitListCopyTail(exprIx, listCopyAtNode(exprIx), fnIx)
    }
    "fnClo" => {
      // The value's id names the member; its closure at the destination's instance replaces it (D14884).
      let fes = monoCloCoerceSetFes.get(exprIx) ?? []
      if fes.length == 0 {
        fes = monoCloCoerceSetFes.get(nodeSrc[exprIx] ?? -1) ?? []
      }
      if fes.length == 0 {
        fbDrop()
        return emitClosureValueCore(fe, fnIx)
      }
      return emitFnCloDispatch(exprIx, fes, fnIx)
    }
    "mapUnbox" => {
      if !boxed { return 0 }
      return emitMapUnionPayloadTail(exprIx, mapUnboxTyOf(exprIx))
    }
    "mapRetag" => {
      if !boxed { return 0 }
      return emitMapRetagTail(exprIx)
    }
    "none" => {}
  }
  return 0
}

// What a node-keyed coercion at `exprIx` writes after its value: a list copy's convert, or a
// retagged union box's retag (a value that is no box is delivered as built). Legacy and the IR
// share it.
export function coerceTail(exprIx: i32, fnIx: i32): i32 {
  const ck: CoerceKind = coerceKindAt(exprIx, fnIx)
  // The seated kinds write their conversion around the value, at their own seat.
  return match ck {
    "listCopy" => emitListCopyTail(exprIx, listCopyAtNode(exprIx), fnIx)
    "mapRetag" => if exprUnion(exprIx, fnIx) { emitMapRetagTail(exprIx) } else { 0 }
    "none" | "fnClo" | "mapUnbox" | "recCopy" | "box" | "unbox" | "atomstr" => 0
  }
}

// The id of a tagged set just emitted for `exprIx`, replaced by the closure of the member it names:
// member `k` of the set's members is `fes[k]`, the last taking the remaining id. Returns 0, or -1.
function emitFnCloDispatch(exprIx: i32, fes: i32[], fnIx: i32): i32 {
  let cs = fnTagSetOfTy(nodeTyIxOf(exprIx))
  if cs < 0 { cs = fnCloCoerceSetAt.get(exprIx) ?? -1 }
  const ds = fnTagMembers(cs)
  if ds.length != fes.length {
    return emitFailAt("emitProgram: a dispatch lost a member", exprIx)
  }
  const slot = fnTagIdSlot()
  fbLocalSet(slot)
  let k = 0
  while k < fes.length {
    const last = k == fes.length - 1
    if !last {
      fbLocalGet(slot)
      fbI32Const(ds[k])
      fbI32Bin(70) // 0x46 i32.eq
      fbOpenIf()
      fbValtype("closure", -1)
    }
    if emitClosureValueCore(fes[k], fnIx) < 0 { return -1 }
    if !last { fbElse() }
    k = k + 1
  }
  k = 0
  while k < fes.length - 1 {
    fbEnd()
    k = k + 1
  }
  return 0
}

// Whether a `listCopy` delivery of `exprIx` owes nothing past the value as built, so the tail
// writes no byte: no record copy, numeric convert or stand-in widen, no list-of-lists convert,
// and a ref-list pair with no retag rows whose slots need no widen.
export function listCopyOwesNothing(exprIx: i32, fnIx: i32): boolean {
  const lct = listCopyAtNode(exprIx)
  if lct < 0 { return false }
  const st = nonNullTy(nodeTyIxOf(exprIx))
  const dt = nonNullTy(instTyOrSelf(lct, fnIx))
  if listRecCopies > 0 && rcRecListsApart(st, dt) { return false }
  const ld = repOfTy(instTyOrSelf(lct, fnIx))
  const de = if ld.rdKind != null { scalarListElemOfListKind(ld.rdKind) } else { null }
  if de != null {
    if listCopyStandsIn(exprIx, fnIx) { return false }
    const sk = scalarListElemKind(exprIx, fnIx)
    return sk == null || scalarWidenConvOp(sk, de) < 0
  }
  const lst = nonNullTy(instTyOrSelf(nodeTyIxOf(exprIx), fnIx))
  if listOfListsPair(lst, dt) { return false }
  const rtFrom: i32[] = []
  const rtTo: i32[] = []
  listWidenRetagRowsOf(exprIx, rtFrom, rtTo)
  if rtFrom.length > 0 { return false }
  const src = exprEmittedRefListSlot(exprIx, fnIx)
  let dst = repSlotOfKind("reflist", instTyOrSelf(lct, fnIx))
  if dst < 0 { dst = src }
  if rlBoxIntoRowList(src, dst) && identBuiltAtUnionList(exprIx) {
    return false
  }
  return rlWidenTagOf(src, dst) < 0
}

// Whether the read `exprIx` is a closure's capture stand-in (`listFitCaptureStandIn`), whose
// list the scalar copy widens from the stand-in's type.
function listCopyStandsIn(exprIx: i32, fnIx: i32): boolean {
  const e = nodeAt(unwrapParen(exprIx))
  if !(e is Ident) { return false }
  const ty: i32[] = []
  return listFitCaptureStandIn(
    e.identName,
    unwrapParen(exprIx),
    fnIx,
    false,
    ty,
  )
    >= 0
}

// The conversion of a list value just emitted at its own row into the row of `lct`, the list
// its delivery copies into, where the two storages differ. Returns 0, or -1 failed.
function emitListCopyTail(exprIx: i32, lct: i32, fnIx: i32): i32 {
  if listCopyOwesNothing(exprIx, fnIx) { return 0 }
  // A fresh call's list of records is copied element by element (`recFreshCallCopy`).
  if listRecCopies > 0 {
    const rc = emitRecListCopy(exprIx, lct, fnIx)
    if rc != 1 { return rc }
  }
  // A scalar list converts each number; a pair no convert serves is delivered as built.
  const ld = repOfTy(instTyOrSelf(lct, fnIx))
  if ld.rdKind != null {
    const de = scalarListElemOfListKind(ld.rdKind)
    if de != null {
      emitScalarListCopy(exprIx, fnIx, de)
      if emitFailed { return -1 }
      return 0
    }
  }
  // A list of lists converts each inner list the same way (D2196).
  const lst = nonNullTy(instTyOrSelf(nodeTyIxOf(exprIx), fnIx))
  const ldt = nonNullTy(instTyOrSelf(lct, fnIx))
  if listOfListsPair(lst, ldt) {
    return emitListConvTop(exprIx, lst, ldt, fnIx)
  }
  const src = exprEmittedRefListSlot(exprIx, fnIx)
  let dst = repSlotOfKind("reflist", instTyOrSelf(lct, fnIx))
  if dst < 0 { dst = src }
  emitRefListCopy(exprIx, src, dst)
  if emitFailed { return -1 }
  return 0
}

// Whether `st` and `dt` are lists of scalar lists whose numbers convert (`i32[][]` into
// `f64[][]`), the pair `emitListConvTop` copies list by list.
function listOfListsPair(st: i32, dt: i32): boolean {
  if st < 0 || dt < 0 || st >= T.tys.length || dt >= T.tys.length {
    return false
  }
  const sa = tyAt(st)
  const da = tyAt(dt)
  if !(sa is TyArray) || !(da is TyArray) { return false }
  const le = rcScalarListElem(nonNullTy(tyElemOf(sa)))
  const de = rcScalarListElem(nonNullTy(tyElemOf(da)))
  return le != null && de != null && le != de && scalarWidenConvOp(le, de) >= 0
}

// A list just emitted at ref-list slot `srcSlot`, delivered into a `dstSlot` destination: widened
// when the pair is widenable and the whole-program write scan licenses it; a widenable pair the
// scan declines is a loud refusal, since no other lowering exists. True when it converted.
function emitRefListCopy(srcIx: i32, srcSlot: i32, dstSlot: i32): boolean {
  const rtFrom: i32[] = []
  const rtTo: i32[] = []
  listWidenRetagRowsOf(srcIx, rtFrom, rtTo)
  if rtFrom.length > 0 {
    return emitRefListRetagSite(srcIx, srcSlot, dstSlot, rtFrom, rtTo)
  }
  // A list two unions alias is built at union boxes (D853), which no record list can hold.
  if rlBoxIntoRowList(srcSlot, dstSlot) && identBuiltAtUnionList(srcIx) {
    emitFailAt(
      "emitProgram: list delivery: this list is built as a list of union boxes, because it "
        + "is also delivered as two different unions, so it cannot also be delivered as a "
        + rlWidenElemName(dstSlot)
        + "[]. Copy it for this use",
      srcIx,
    )
    return false
  }
  // Not a widenable pair: the same slot, or two element reps with no conversion between
  // them. The common case at every delivery, and nothing is owed.
  if rlWidenTagOf(srcSlot, dstSlot) < 0 { return false }
  if (!rlWidenAllowed(cwKeyOfRoot(srcIx), srcSlot, dstSlot)) {
    // A `readonly` destination needs no write proof: a view reads the source as it is (D3041).
    if refViewReadonlyAt(srcIx) && rvMayView(dstSlot) {
      if rvEmitView(srcSlot) { return true }
    }
    return emitRefListWidenDeclined(srcIx, srcSlot, dstSlot)
  }
  // A source other handles may write is delivered as a view that reads through it (D3041).
  if !copySafeRead(srcIx) && rvMayView(dstSlot) {
    if rvEmitView(srcSlot) { return true }
  }
  if emitRefListWidenTop(srcSlot, dstSlot) < 0 { return false }
  return true
}

// The checker's `copySafe` for the list `ix` a delivery copies or views; a delivery the checker
// recorded nothing for is a missed judgement, refused rather than decided here.
function copySafeRead(ix: i32): boolean {
  const u = unwrapParen(ix)
  // A node an emit rewrite minted answers with the checked node it stands for.
  let r = copySafeOf(u)
  if r < 0 { r = copySafeOf(nodeSrc[u] ?? -1) }
  if r < 0 {
    emitFailAt(
      "emitProgram: list delivery: the checker recorded no copy decision here",
      ix,
    )
  }
  return r == 1
}

// A list of union boxes delivered as a `readonly` list whose element holds member `from[k]` only
// as `to[k]` (D2999): copied, each box rebuilt under the widened member, where nothing writes the
// source and every handle on it is known. Otherwise it stays shared, which only a read of such a
// member misreads (D3026): a trap, where a stale snapshot would print a wrong value.
function emitRefListRetagSite(
  srcIx: i32,
  srcSlot: i32,
  dstSlot: i32,
  from: i32[],
  to: i32[],
): boolean {
  if covarValueWriteState(cwKeyOfRoot(srcIx)) != 0 { return false }
  if !copySafeRead(srcIx) { return false }
  if (
    srcSlot < 0
    || dstSlot < 0
    || srcSlot >= rlWrapIdx.length
    || dstSlot >= rlWrapIdx.length
    || srcSlot >= rlBackIdx.length
    || dstSlot >= rlBackIdx.length
  ) {
    emitFailAt(
      "emitProgram: a union list delivered widened has no interned list type",
      srcIx,
    )
    return false
  }
  const srcWrap = rlWrapIdx[srcSlot]
  const srcBack = rlBackIdx[srcSlot]
  const dstWrap = rlWrapIdx[dstSlot]
  const dstBack = rlBackIdx[dstSlot]
  const sL = widenSrcWrapSlot(srcSlot)
  const dL = widenDstBackSlot(dstSlot)
  const iL = widenTmpSlot(0)
  const nL = widenTmpSlot(1)
  emitCopyLoopOpen(sL, srcWrap, nL, dstBack, dL, iL)
  // block { loop { if i >= n br 1; back[i] = retag(src.back[i]); i++; br 0 } }
  fbLocalGet(dL)
  fbLocalGet(iL)
  fbLocalGet(sL)
  fbStructGet(srcWrap, 0)
  fbLocalGet(iL)
  fbArrayGet(srcBack)
  // Below `len` every element is a box: a `null` member is boxed under its own tag.
  fbRefAsNonNull()
  fbLocalSet(unionAsBoxSlot())
  let w = 0
  while w < from.length {
    if emitWidenRetagArm(from[w], to[w]) < 0 { return false }
    w = w + 1
  }
  fbLocalGet(unionAsBoxSlot())
  let e = 0
  while e < from.length {
    fbEnd()
    e = e + 1
  }
  fbArraySet(dstBack)
  emitCopyLoopClose(iL, dL, nL, dstWrap)
  return true
}

// A scalar list just emitted, delivered at element kind `de`: copied through the convert its pair
// names, or a view where other handles may write the source (D965). A pair with no convert,
// or an unknown write state, is delivered as built. True when it converted.
function emitScalarListCopy(srcIx: i32, fnIx: i32, de: VKind): boolean {
  if listFitStoodIn >= 0 && listFitStoodIn == unwrapParen(srcIx) {
    listFitStoodIn = -1
    const sd = repOfTy(listFitStoodTy)
    const stood = if sd.rdKind != null { scalarListElemOfListKind(sd.rdKind) } else { null }
    if stood == null || stood == de || scalarWidenConvOp(stood, de) < 0 {
      return false
    }
    return emitScalarListWidenTop(stood, de) >= 0
  }
  const sk = scalarListElemKind(srcIx, fnIx)
  if sk == null { return false }
  if scalarWidenConvOp(sk, de) < 0 { return false }
  // A `.map` / `.filter` / `.slice` result is a list nothing else holds, so its copy is the value.
  const fresh = unwrapParen(srcIx)
  if callIsMapFilter(fresh, fnIx) || callIsArrSlice(fresh, fnIx) {
    return emitScalarListWidenTop(sk, de) >= 0
  }
  // A named source other handles may write is delivered as a view that reads through it
  // (D3028). A literal has no root, and is built at the destination's element already.
  const wroot = covarRootName(srcIx)
  const wst = covarValueWriteState(cwKeyOfRoot(srcIx))
  if wroot != "" && (wst != 0 || !copySafeRead(srcIx)) {
    const p = svPairOfKinds(sk, de)
    if p >= 0 {
      fbCall(gHelpSvMk[p])
      return true
    }
  }
  if wst != 0 { return false }
  if emitScalarListWidenTop(sk, de) < 0 { return false }
  return true
}

// The view pair (`svPairOn`) serving a `src` list read as a `dst` one, or -1 where none is built.
// The three pairs are exactly the three converts `scalarWidenConvOp` names, in its order.
function svPairOfKinds(src: VKind, dst: VKind): i32 {
  const op = scalarWidenConvOp(src, dst)
  const ops = [172, 183, 187]
  let p = 0
  while p < ops.length {
    if ops[p] == op && svPairOn(p) { return p }
    p = p + 1
  }
  return -1
}

// The view destination a scalar list of element `k` reads as (0 `i64`, 1 `f64`), or -1 where
// no view of that element is built: `k` is a destination exactly when an `i32` widens to it.
export function svDstOfKind(k: VKind | null): i32 {
  if svPairs == 0 || k == null { return -1 }
  const d = svPairOfKinds("i32", k)
  if d == 0 { return 0 }
  if svDstOn(1) && scalarWidenConvOp("i32", k) == 183 { return 1 }
  return -1
}

// Refresh the list just emitted for `recvIx` when it may be a view, before an operation reads
// its backing whole: the view's snapshot then holds its source as it is now (D3028).
function svSyncRecv(recvIx: i32, fnIx: i32) {
  if rvRecvMayView(recvIx, fnIx) {
    fbCall(gHelpRvSync)
    return 0
  }
  if svPairs == 0 { return 0 }
  const d = svDstOfKind(scalarListElemKind(recvIx, fnIx))
  if d >= 0 { fbCall(gHelpSvSync[d]) }
  return 0
}

// Push whether the list in local `wL` is a view read as destination `d`: one `ref.test` per view
// type of that destination, so a plain list pays a failed test and takes its own read.
function svTestView(wL: i32, d: i32) {
  let n = 0
  let p = 0
  while p < svViewTy.length {
    if svPairOn(p) && (p == 0) == (d == 0) {
      fbLocalGet(wL)
      fbRefTest(svViewTy[p])
      if n > 0 {
        fbI32Bin(114) // 0x72 i32.or
      }
      n = n + 1
    }
    p = p + 1
  }
  if n == 0 { fbI32Const(0) }
  return 0
}

// The element read of a list of element `ek` that may be a view read as `d`, with the list and
// the index on the stack: a view reads through its source, any other list reads its backing.
function emitSvIndexRead(ek: VKind, d: i32) {
  const wL = listIdxWrapSlot(listIdxKindOf(ek), 0)
  fbLocalSet(listIdxScratchBase)
  fbLocalSet(wL)
  svTestView(wL, d)
  fbIf(scalarListBlocktype(ek))
  fbLocalGet(wL)
  fbLocalGet(listIdxScratchBase)
  fbCall(gHelpSvGet[d])
  fbElse()
  fbLocalGet(wL)
  fbLocalGet(listIdxScratchBase)
  emitListIdxGuard(wL, scalarListWrap(ek, 0))
  fbArrayGet(scalarListBack(ek, 0))
  fbEnd()
  return 0
}

// Whether the statement or expression at `ix` stores through an index anywhere, over the node
// kinds `hoistSafeStmt` admits: such a store reaches a view's source without passing its snapshot.
function storesIndex(ix: i32, fnIx: i32): boolean {
  if ix < 0 { return false }
  const e = nodeAt(ix)
  if e is Block {
    let i = 0
    while i < e.blkStmts.length {
      if storesIndex(e.blkStmts[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  if e is LetDecl { return storesIndex(e.letInit, fnIx) }
  if e is BreakStmt || e is ContinueStmt { return false }
  if e is RetStmt { return storesIndex(e.retArg, fnIx) }
  if e is IfStmt {
    return storesIndex(e.ifCond, fnIx)
      || storesIndex(e.ifThen, fnIx)
      || storesIndex(e.ifElse, fnIx)
  }
  if e is WhileStmt {
    return storesIndex(e.whileCond, fnIx) || storesIndex(e.whileBody, fnIx)
  }
  if e is ForRange {
    return storesIndex(e.frFrom, fnIx)
      || storesIndex(e.frTo, fnIx)
      || storesIndex(e.frStep, fnIx)
      || storesIndex(e.frBody, fnIx)
  }
  if e is ForIn {
    return storesIndex(e.fiIter, fnIx) || storesIndex(e.fiBody, fnIx)
  }
  if e is Unary { return storesIndex(e.unArg, fnIx) }
  if e is Paren { return storesIndex(e.parInner, fnIx) }
  if e is IsExpr { return storesIndex(e.isObj, fnIx) }
  if e is AsExpr { return storesIndex(e.asObj, fnIx) }
  if e is Member { return storesIndex(e.memObj, fnIx) }
  if e is Index {
    return storesIndex(e.idxArr, fnIx) || storesIndex(e.idxIndex, fnIx)
  }
  if e is BinExpr {
    if e.binOp == "=" && nodeAt(e.binLeft) is Index { return true }
    return storesIndex(e.binLeft, fnIx) || storesIndex(e.binRight, fnIx)
  }
  if e is Call {
    let a = 0
    while a < e.callArgs.length {
      if storesIndex(e.callArgs[a], fnIx) { return true }
      a = a + 1
    }
    return storesIndex(e.callFn, fnIx)
  }
  // A literal or a name stores nothing; any other kind is one the hoist whitelist refuses.
  return !hoistSafeExpr(ix, fnIx)
}

// Whether a loop over `condIx` and `bodyIx` may not cache the header of the list at `recvIx`:
// it may be a view, and the loop stores through an index, which its snapshot would not see.
function svHoistBlocked(
  recvIx: i32,
  fnIx: i32,
  condIx: i32,
  bodyIx: i32,
): boolean {
  if rvRecvMayView(recvIx, fnIx) {
    return storesIndex(condIx, fnIx) || storesIndex(bodyIx, fnIx)
  }
  if svPairs == 0 { return false }
  if svDstOfKind(scalarListElemKind(recvIx, fnIx)) < 0 { return false }
  return storesIndex(condIx, fnIx) || storesIndex(bodyIx, fnIx)
}

// Whether the list `recvIx` reads may be a record-list view (D3041): a union-box list in a module
// that builds one.
function rvRecvMayView(recvIx: i32, fnIx: i32): boolean {
  if rvSrcSlot.length == 0 || !exprRefArray(recvIx, fnIx) { return false }
  return rvMayView(refListSlotOfExpr(recvIx, fnIx))
}

// Push whether the list in local `wL` is a record-list view: one `ref.test` per view type.
function rvTestView(wL: i32) {
  let p = 0
  while p < rvViewTy.length {
    fbLocalGet(wL)
    fbRefTest(rvViewTy[p])
    if p > 0 {
      fbI32Bin(114) // 0x72 i32.or
    }
    p = p + 1
  }
  if rvViewTy.length == 0 { fbI32Const(0) }
  return 0
}

// The element read of a union-box list at ref-list row `rslot` that may be a view, with the list
// and the index on the stack: a view boxes the element out of its source, any other list reads its
// backing. Leaves the backing's own `(ref null $uBox)`.
function emitRvIndexRead(rslot: i32) {
  const wL = listIdxWrapSlot("reflist", rslot)
  fbLocalSet(listIdxScratchBase)
  fbLocalSet(wL)
  rvTestView(wL)
  fbIfRefNul(uBoxIdx, true)
  fbLocalGet(wL)
  fbLocalGet(listIdxScratchBase)
  fbCall(gHelpRvGet)
  fbElse()
  fbLocalGet(wL)
  fbLocalGet(listIdxScratchBase)
  emitListIdxGuard(wL, rlWrapIdx[rslot])
  fbArrayGet(rlBackIdx[rslot])
  fbEnd()
  return 0
}

// Build a view of the record list on the stack, at source row `srcSlot` (D3041): a snapshot the
// sync helper fills, beside the list itself. False where the row has no view type.
function rvEmitView(srcSlot: i32): boolean {
  if srcSlot < 0 || srcSlot >= rlTwin.length || rvUnionSlot < 0 { return false }
  const p = rvPairOf(rlTwin[srcSlot], rlWidenTagOf(srcSlot, rvUnionSlot))
  if p < 0 || rvUnionSlot >= rlBackIdx.length { return false }
  const sL = widenSrcWrapSlot(srcSlot)
  fbLocalSet(sL)
  fbI32Const(0)
  fbArrayNewDefault(rlBackIdx[rvUnionSlot])
  fbI32Const(0)
  fbI32Const(0)
  fbLocalGet(sL)
  fbRefAsNonNull()
  fbStructNew(rvViewTy[p])
  fbCall(gHelpRvSync)
  return true
}

// `emitClampIdx`'s dual over plain wasm i32 LOCALS (not the string-op frame): emit
// `clamp(idx, len)` reading `idx` from local `idxL`, `len` from `lenL`, leaving the
// clamped value on the stack. Same JS slice semantics (`idx < 0 ? max(len+idx, 0) :
// min(idx, len)`) built from `select`.
function emitClampLocal(idxL: i32, lenL: i32) {
  // negCase = max(len+idx, 0) = select( len+idx, 0, (len+idx) > 0 )
  fbLocalGet(lenL)
  fbLocalGet(idxL)
  fbI32Bin(106) // i32.add → (len+idx)  [a]
  fbI32Const(0) // [b]
  fbLocalGet(lenL)
  fbLocalGet(idxL)
  fbI32Bin(106)
  fbI32Const(0)
  fbI32Bin(74)  // 0x4a i32.gt_s → (len+idx) > 0  [cond]
  fbSelect()    // → negCase
  // nonNegCase = min(idx, len) = select( idx, len, idx < len )
  fbLocalGet(idxL)
  fbLocalGet(lenL)
  fbLocalGet(idxL)
  fbLocalGet(lenL)
  fbI32Bin(72) // 0x48 i32.lt_s → idx < len  [cond]
  fbSelect() // → nonNegCase
  // result = select( negCase, nonNegCase, idx < 0 )
  fbLocalGet(idxL)
  fbI32Const(0)
  fbI32Bin(72) // 0x48 i32.lt_s → idx < 0
  fbSelect() // → clamped
  return 0
}

// True when an element read out of list `exprIx` yields a rep that legitimately holds
// null, so the read must stay `(ref null $elem)` rather than take a trapping
// `ref.as_non_null`. Asked by the indexed read and the `.map`/`.filter` element step, so a
// callback's declared param valtype and the value handed to it agree.
export function listElemStaysNullable(exprIx: i32, fnIx: i32) {
  if exprNulStrArray(exprIx, fnIx) { return true }
  if exprRefArray(exprIx, fnIx) {
    const s = refListSlotOfExpr(exprIx, fnIx)
    if s >= 0 && s < rlElemNullable.length { return rlElemNullable[s] == 1 }
  }
  return false
}

// The plan list `.slice` call `callIx` is lowered by: its receiver and bound nodes, the receiver's
// wrapper and backing heap types, and the `.map`/`.filter` frame's source and result locals.
// `slFail` is the refusal to raise, or "row" where the receiver's ref-list row does not resolve.
export type SlicePlan = {
  slFail: string,
  slRecv: i32,
  slWrap: i32,
  slBack: i32,
  slSrcL: i32,
  slDstL: i32,
  slArgs: i32[],
  slTwo: boolean,
}

function slRefused(why: string): SlicePlan {
  const p: SlicePlan = {
    slFail: why,
    slRecv: -1,
    slWrap: -1,
    slBack: -1,
    slSrcL: -1,
    slDstL: -1,
    slArgs: [],
    slTwo: false,
  }
  return p
}

// The plan of list `.slice` call `callIx`, asked where legacy's arm asks it; it mints nothing.
export function arrSlicePlanOf(callIx: i32, fnIx: i32): SlicePlan {
  const c = nodeAt(callIx)
  if !(c is Call) || c.callFn < 0 {
    return slRefused("emitProgram: expected an array slice call")
  }
  const callee = nodeAt(c.callFn)
  if !(callee is Member) {
    return slRefused("emitProgram: .slice receiver is not a member access")
  }
  const recvK = mfRecvKindOf(callee.memObj, fnIx)
  if recvK == null {
    return slRefused("emitProgram: .slice receiver is not a supported list")
  }
  let srcSlot = -1
  if recvK == "reflist" { srcSlot = refListSlotOfExpr(callee.memObj, fnIx) }
  // A packed receiver's slot is its row, which keys its scratch frames.
  if recvK == "u8list" { srcSlot = exprPackedRow(callee.memObj, fnIx) }
  const p = slRefused("")
  // The element kind's wrapper + backing heap types.
  const rek = numListElemOf(recvK)
  if rek != null {
    p.slWrap = scalarListWrap(rek, 0)
    p.slBack = scalarListBack(rek, 0)
  } else if recvK == "reflist" {
    if !rlRowsMinted() {
      return slRefused(
        "emitProgram: .slice over a ref list but ref list type not collected",
      )
    }
    if srcSlot < 0 { return slRefused("row") }
    p.slWrap = rlWrapIdx[srcSlot]
    p.slBack = rlBackIdx[srcSlot]
  } else if recvK == "strlist" {
    p.slWrap = mkListTy()
    p.slBack = mkArrTy()
  } else if recvK == "u8list" {
    // the packed byte list (D1141): a `(array (mut i8))` backing under the `$bl8`
    // wrapper, the arm this ladder needs since `mfRecvKindOf` would otherwise answer
    // `"list"` for a `u8[]` receiver and mint the new list over the wrong 4-byte
    // backing. `array.copy` below is i8-to-i8, so the elements survive the copy.
    p.slWrap = pkWrapAt(srcSlot)
    p.slBack = pkBackAt(srcSlot)
  } else {
    p.slWrap = lTy()
    p.slBack = aTy()
  }
  p.slSrcL = mfSrcLocalFor(recvK, srcSlot)
  p.slDstL = mfDstLocalFor(recvK, srcSlot)
  if !fnUses.mapFilter || p.slSrcL < 0 || p.slDstL < 0 {
    return slRefused("emitProgram: .slice scratch frame not reserved")
  }
  p.slRecv = callee.memObj
  p.slArgs = c.callArgs
  p.slTwo = c.callArgs.length == 2
  return p
}

// Lower an array `xs.slice(start, end?)` onto `body`, leaving a new list wrapper of the
// same element kind over the half-open clamped range `[start, end)` (JS semantics). Rides
// the `.map`/`.filter` scratch frame (`srcL`/`dstL` plus four i32 temps), evaluating the
// receiver once into `srcL`; works across i32/boolean, f64, ref and string lists.
function emitArrSlice(callIx: i32, fnIx: i32) {
  const p = arrSlicePlanOf(callIx, fnIx)
  if p.slFail == "row" { return refListRowRefused(p.slRecv) }
  if p.slFail != "" { return emitFail(p.slFail) }
  // The receiver and both bounds reach the stack before the frame is written: the frame
  // is shared, so a slice, `.map` or `.filter` in an argument would overwrite it (D2332).
  if emitExpr(p.slRecv, fnIx) < 0 { return -1 }
  sliceRecvTail(p, fnIx)
  for a in p.slArgs {
    if emitExpr(a, fnIx) < 0 { return -1 }
  }
  return arrSliceTail(p)
}

// After a list `.slice` receiver: its recovery, non-null at every element kind (`srcL` is declared
// non-null; `nulRecvNeedsRecover`), and the scalar-view sync.
export function sliceRecvTail(p: SlicePlan, fnIx: i32) {
  if nulRecvNeedsRecover(p.slRecv, fnIx) { fbRefAsNonNull() }
  svSyncRecv(p.slRecv, fnIx)
  return 0
}

// A list `.slice` over its receiver and bounds on the stack: the clamped range copied into a new
// list of the receiver's kind, left on the stack.
export function arrSliceTail(p: SlicePlan): i32 {
  const wrap = p.slWrap
  const back = p.slBack
  const srcL = p.slSrcL
  const dstL = p.slDstL
  // The `.map`/`.filter` frame's first 3 slots are i32 (i, n, j); slot +3 is a
  // closure ref. So slice has THREE i32 temps: `startL`, `endL`, and `auxL` which
  // holds the length during clamping then is reused for the out length.
  const startL = mfScratchBase + 0
  const endL = mfScratchBase + 1
  const auxL = mfScratchBase + 2
  if p.slTwo { fbLocalSet(endL) }
  fbLocalSet(startL)
  fbLocalSet(srcL)
  // auxL = src.len (the wrapper's logical length, field 1)
  fbLocalGet(srcL)
  fbStructGet(wrap, 1)
  fbLocalSet(auxL)
  // start = clamp(rawStart, len)
  emitClampLocal(startL, auxL)
  fbLocalSet(startL)
  // end = clamp(rawEnd, len), or len when omitted (the 1-arg form slices to the end)
  if p.slTwo {
    emitClampLocal(endL, auxL)
    fbLocalSet(endL)
  } else {
    fbLocalGet(auxL)
    fbLocalSet(endL)
  }
  // auxL (len now dead) = outLen = max(end - start, 0) = select(end-start, 0, end>start)
  fbLocalGet(endL)
  fbLocalGet(startL)
  fbI32Bin(107) // i32.sub → end - start  [a]
  fbI32Const(0) // [b]
  fbLocalGet(endL)
  fbLocalGet(startL)
  fbI32Bin(74)  // 0x4a i32.gt_s → end > start  [cond]
  fbSelect()
  fbLocalSet(auxL)
  // dst backing = array.new_default <back> outLen
  fbLocalGet(auxL)
  fbArrayNewDefault(back)
  fbLocalSet(dstL)
  // result wrapper = struct.new <wrap> (dstBacking, outLen, outLen) — pushed FIRST so
  // it remains on the stack after the trailing `array.copy` consumes its own operands.
  fbLocalGet(dstL)
  fbLocalGet(auxL)
  fbLocalGet(auxL)
  fbStructNew(wrap)
  // array.copy dst 0 src.backing start outLen
  fbLocalGet(dstL)        // dest backing
  fbI32Const(0)           // dest offset
  fbLocalGet(srcL)
  fbStructGet(wrap, 0)    // src backing
  fbLocalGet(startL)      // src offset
  fbLocalGet(auxL)        // count
  fbArrayCopy(back, back) // array.copy (dest type, src type)
  // The result wrapper from `struct.new` above is the value left on the stack.
  return 0
}

// Push `elem(i)` — `src.backing[i]` — onto the stack (`ref.as_non_null` for a ref
// element, surfacing the non-null struct/union box).
function emitMfElem(
  srcL: i32,
  iL: i32,
  srcWrap: i32,
  srcBack: i32,
  srcElemRef: boolean,
) {
  if mfSvDst >= 0 && !srcElemRef {
    fbLocalGet(srcL)
    fbLocalGet(iL)
    fbCall(gHelpSvGet[mfSvDst])
    return 0
  }
  if mfRv && srcElemRef {
    fbLocalGet(srcL)
    fbLocalGet(iL)
    fbCall(gHelpRvGet)
    if mfSrcSlot >= 0 { return emitStaleBoxRetag(mfSrcSlot, -1) }
    return 0
  }
  fbLocalGet(srcL)
  fbStructGet(srcWrap, 0) // field 0: backing
  fbLocalGet(iL)
  fbArrayGet(srcBack)     // 0xfb 0x0b <srcBack>
  if srcElemRef {
    fbRefAsNonNull()
    if mfSrcSlot >= 0 { return emitStaleBoxRetag(mfSrcSlot, -1) }
  }
  return 0
}

// The ref-list slot `emitMfElem` reads from, for a read-side retag of its union boxes; -1 outside
// a `.map`/`.filter` loop or where the source is not a ref list.
let mfSrcSlot = -1
// The view destination `emitMfElem` reads each element through, as a callback's write to the
// source must be seen by the next read (D3028); -1 where the source cannot be a view.
let mfSvDst = -1
// Whether `emitMfElem`'s source may be a record-list view, read element by element (D3041).
let mfRv = false

// Appends to `fromTys` the members a union box read out of ref-list slot `slot` may hold beyond its
// own: each narrower scalar the slot's union holds only widened, which a list shared across a
// widening delivery still carries (D3026). Appends none where there is none, or no such delivery.
function staleBoxFrom(slot: i32, fromTys: i32[]) {
  if !listWidenRetagAny() { return 0 }
  if slot < 0 || slot >= rlElemName.length || slot >= rlElemTyIx.length {
    return 0
  }
  if rlElemKindAt(slot) != RLK_UNION { return 0 }
  const ut: i32[] = []
  if !msMemberTysOfSet(msSetOfTyAny(rlElemTyIx[slot]), ut) {
    return emitFail("emitProgram: a ref-list union slot has no member set")
  }
  // Which of the value box kinds 0..5 the union's members hold.
  const has = [false, false, false, false, false, false]
  for t in ut {
    const ak = boxAtomKindOfMemberTy(t)
    if ak >= 0 && ak < has.length { has[ak] = true }
  }
  const hasI32 = has[0]
  const hasI64 = has[3]
  const hasF64 = has[4]
  const hasF32 = has[5]
  // A member no box of this module is built for cannot be carried.
  if !hasI32 && (hasI64 || hasF64) && vbHeapIdxOfKind(0) >= 0 {
    fromTys.push(TY_I32)
  }
  if !hasF32 && hasF64 && vbHeapIdxOfKind(5) >= 0 { fromTys.push(TY_F32) }
  return 0
}

// Rebuild the union box on the stack, read out of ref-list slot `slot`, under the member of its
// own union that a narrower member it still carries widens to (`staleBoxFrom`).
function emitStaleBoxRetag(slot: i32, at: i32) {
  if slot < 0 || slot >= rlElemName.length { return 0 }
  const fromTys: i32[] = []
  if staleBoxFrom(slot, fromTys) < 0 { return -1 }
  if fromTys.length == 0 { return 0 }
  const toTys: i32[] = []
  if !msMemberTysOfSet(msSetOfTyAny(rlElemTyIx[slot]), toTys) { return 0 }
  return emitBoxAtomRetagMembers(fromTys, toTys, at)
}

// Invoke the callback closure (stashed in local `cL`) on `elem(i)`: push its env
// (field 0), the element, its function index (field 1), then `call_indirect $fnsig`
// — leaving the callback's result on the stack. This runs once per element, which is
// why the id is an i32 load and not a funcref field's host libcall.
function emitMfInvoke(
  cL: i32,
  srcL: i32,
  iL: i32,
  srcWrap: i32,
  srcBack: i32,
  srcElemRef: boolean,
  sig: i32,
) {
  fbLocalGet(cL)
  fbStructGet(cloStructIdx, 0)     // env
  emitMfElem(srcL, iL, srcWrap, srcBack, srcElemRef)
  fbLocalGet(cL)
  fbStructGet(cloStructIdx, 1)     // the callee's wasm function index
  fbCallIndirect(sig, gFnTableIdx) // 0x11 <fnsig> <table>
  return 0
}

// The grow arm of a push into list local `lIdx`, inline: the new capacity (4 when empty, else
// twice) into `capIdx`, a fresh backing into `backIdx`, the live prefix copied over, both
// stored back. `__grow_<row>__` is the same block over its parameter.
function pushGrowInline(
  lIdx: i32,
  lTy: i32,
  aTy: i32,
  capIdx: i32,
  backIdx: i32,
) {
  pushListCap(lIdx, lTy)
  fbI32Eqz()
  fbIf(127)
  fbI32Const(4)
  fbElse()
  pushListCap(lIdx, lTy)
  fbI32Const(2)
  fbI32Bin(108) // 0x6c i32.mul
  fbEnd()
  fbLocalSet(capIdx)
  fbLocalGet(capIdx)
  fbArrayNewDefault(aTy)
  fbLocalSet(backIdx)
  fbLocalGet(backIdx)
  fbI32Const(0)
  pushListBacking(lIdx, lTy)
  fbI32Const(0)
  pushListLen(lIdx, lTy)
  fbArrayCopy(aTy, aTy)
  fbLocalGet(lIdx)
  fbLocalGet(backIdx)
  fbStructSet(lTy, 0)
  fbLocalGet(lIdx)
  fbLocalGet(capIdx)
  fbStructSet(lTy, 2)
  return 0
}

// `local.get L ; struct.get $lTy 1` — push the list's `len` field onto `body`.
function pushListLen(lIdx: i32, lTy: i32) {
  fbLocalGet(lIdx)    // local.get
  fbStructGet(lTy, 1) // 0xfb 0x02 <lTy> field 1: len
  return 0
}

// `local.get L ; struct.get $lTy 2` — push the list's `cap` field onto `body`.
function pushListCap(lIdx: i32, lTy: i32) {
  fbLocalGet(lIdx)    // local.get
  fbStructGet(lTy, 2) // 0xfb 0x02 <lTy> field 2: cap
  return 0
}

// `local.get L ; struct.get $lTy 0` — push the list's `backing` ref onto `body`.
function pushListBacking(lIdx: i32, lTy: i32) {
  fbLocalGet(lIdx)    // local.get
  fbStructGet(lTy, 0) // 0xfb 0x02 <lTy> field 0: backing
  return 0
}

// Push the list ref a `for v in <iter>` iterates. A map iterable (`m.keys()`, `m.values()`,
// or the bare `for k in m`) reads the ordered list field off the map ref the caller already
// stashed (`mapRecv >= 0`): field 1 for a vals walk, field 0 for a keys walk — not
// re-emitted, so the walked list, tombstone `live[]` and loop bound stay on one object.
function emitForInList(iterIx: i32, fnIx: i32, mapRecv: i32, mwShape: i32) {
  if mapRecv >= 0 { return forInMapList(iterIx, fnIx, mwShape) }
  if emitExpr(iterIx, fnIx) < 0 { return -1 }
  return svSyncRecv(iterIx, fnIx)
}

// A map walk's list off the stashed map `mapRef` of shape `mwShape`: its values list for a
// `.values()` walk, else its keys list.
export function forInMapList(iterIx: i32, fnIx: i32, mwShape: i32) {
  cmSlot = mwShape
  if forInWalksMapValues(iterIx, fnIx) { return pushMapVals() }
  return pushMapKeys()
}

// Whether function `fnIx` (at `fnStmts` position `fnPos` when inferred) declares a ref-list result.
function retResultIsRefList(fnIx: i32, fnPos: i32): boolean {
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    if fn.fnRet >= 0 { return vtKindOfType(fn.fnRet) == "reflist" }
  }
  return fnPos >= 0 && fnPos < fRetKind.length && fRetKind[fnPos] == "reflist"
}

// Whether `retArg` is a `.map` call whose result list at function `fnIx` is not a ref list.
function retMapBuildsOtherList(retArg: i32, fnIx: i32): boolean {
  const rx = unwrapParen(retArg)
  if rx < 0 { return false }
  const c = nodeAt(rx)
  if !(c is Call) { return false }
  if c.callFn < 0 { return false }
  const m = nodeAt(c.callFn)
  if !(m is Member) { return false }
  if m.memProp != "map" { return false }
  const rk = mfResultKindOf(rx, fnIx)
  return rk != null && rk != "reflist"
}

// Whether `retArg` is a `null` value and function `fn`'s result is a non-null record or
// variant ref, which no `null` can ride (`fnPos` as `emitReturnValue` derives it).
function retNullIntoNonNullRef(retArg: i32, fnIx: i32, fnPos: i32): boolean {
  if (
    !(nodeAt(unwrapParen(retArg)) is NullLit)
    && !exprIsNulNone(retArg, fnIx)
  ) {
    return false
  }
  let rk: VKind | null = null
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    if fn.fnRet >= 0 { rk = vtKindOfType(fn.fnRet) }
    else if fnPos >= 0 && fnPos < fRetKind.length { rk = fRetKind[fnPos] }
  }
  return rk == "struct" || rk == "variant"
}

// The variant row an un-annotated return of function `fnPos` builds: the collapse arm's, else
// the classified `variant` pair the functype's result is emitted from; -1 for any other return.
function inferredRetVariantIdx(fnPos: i32): i32 {
  const rvi = cbRetVariantIdx(fnPos)
  if rvi >= 0 { return rvi }
  if fnPos < 0 || fnPos >= fRetKind.length || fnPos >= fRetStructIdx.length {
    return -1
  }
  if fRetKind[fnPos] == "variant" { return fRetStructIdx[fnPos] }
  return -1
}

// The rep kind of annotated function `fn`'s declared result (node `fnIx`), as its `buildFnMap`
// row banked it off the declared type: a return reads it with no descriptor built. "i32" for an
// un-annotated one, whose result is not this question's.
function fnAnnRetKind(fn: FuncDecl, fnIx: i32): VKind {
  if fn.fnRet < 0 { return "i32" }
  const fp = fnStmtsPosOf(fnIx)
  if fp >= 0 && fp < fRetKind.length { return fRetKind[fp] }
  return vtKindOfType(fn.fnRet)
}

// The narrowed-arm unbox's destination heap for a return of function `fn` (at `fnStmts`
// position `fnPos`, -1 when annotated), annotated or inferred; -1 when the result owes none.
function returnArmHeapOf(fn: FuncDecl, fnIx: i32, fnPos: i32): i32 {
  let retArmHeap = -1
  // A `: Circle | null` result's niche heap.
  if fnAnnRetKind(fn, fnIx) == "nulvariant" {
    const rnvi = nulVariantIndexOf(fn.fnRet)
    retArmHeap = armDestHeapOf("nulvariant", rnvi)
  }
  // The kind-9 twin: a `Dot | null` result over a DECLARED struct that is the arm's layout
  // twin. Same slot shape, same unbox owed, a struct row instead of a variant one.
  if fnAnnRetKind(fn, fnIx) == "nulstruct" {
    retArmHeap = armDestHeapOf(
      "nulstruct",
      annSlotOfKind("nulstruct", fn.fnRet),
    )
  }
  // The plain-struct twin of the two annotated seeds: `function g(): A` returning a narrowed
  // arm of an inferred union, whose arm no seed above can find. The annotation's own rep and
  // slot are the destination, as the parameter's are at the call boundary (D1723).
  if retArmHeap < 0 && fn.fnRet >= 0 {
    retArmHeap = armDestHeapOf(
      fnAnnRetKind(fn, fnIx),
      annValtypeSlotOf(fn.fnRet),
    )
  }
  // Its un-annotated twin: the destination is then the classified return pair,
  // the same `(kind, slot)` the functype's result valtype is emitted from.
  if retArmHeap < 0 && fn.fnRet < 0 {
    if fnPos >= 0 && fnPos < fRetKind.length && fnPos < fRetStructIdx.length {
      retArmHeap = armDestHeapOf(fRetKind[fnPos], fRetStructIdx[fnPos])
    }
  }
  return retArmHeap
}

// Whether the return value `retArg` of `fn` is a literal-union atom widened to its member
// string: a `string`, `string | null` or inline literal-union result, annotated or inferred.
function retStrWidenOf(
  fn: FuncDecl,
  retArg: i32,
  fnIx: i32,
  fnPos: i32,
): boolean {
  let retStrWiden = false
  // reads the annotation spelling, and canon softens a literal union to `string`, so a
  // `: K` return would answer true here too — `retLitUnion` above already claims it, so
  // this narrowing is inert for that case and only fires for a genuine `string` return.
  if nodeTyIsStringPrim(fn.fnRet) {
    if exprIsLitAtom(retArg, fnIx) { retStrWiden = true }
  }
  // the `string | null` niche return takes the same widen: its slot is the same string
  // ref with null permitted, and a widened member string is non-null, so it subtypes the
  // slot. Asked of the declared type's rep rather than the spelling test above, since the nullable form does not spell `"string"`.
  if fnAnnRetKind(fn, fnIx) == "nulstr" {
    if exprIsLitAtom(retArg, fnIx) { retStrWiden = true }
  }
  // an inline literal-union return (`: "circle" | "rect"`) takes the same widen: the
  // inline and named forms rep differently, so this needs its own arm. A named litunion
  // return (`: K`) reps as the interned atom and is claimed by `retLitUnion` above; an
  // un-named one reps as a string ref, so it must widen.
  if retLitUnionInline(fn.fnRet, fnIx) {
    if exprIsLitAtom(retArg, fnIx) { retStrWiden = true }
  }
  // A lone string literal result (`: "circle"`) is a string value, so an atom widens (D7445).
  if fn.fnRet >= 0 && tyIsBareStrLit(nodeTyAt(fn.fnRet, fnIx)) {
    if exprIsLitAtom(retArg, fnIx) { retStrWiden = true }
  }
  // the inferred-string dual: an un-annotated function whose checked return is `string`
  // widens an atom return value too; without it the raw i32 id flowed into the
  // string-ref functype result (invalid wasm).
  if fn.fnRet < 0 && cloRetIsString(fnPos) {
    if exprIsLitAtom(retArg, fnIx) { retStrWiden = true }
  }
  return retStrWiden
}

// `emitReturnValue`'s plain arm: `retArg` emitted under a context carrying the result's
// nullable, map, list and literal-union seeds, then the nullable-string unbox and non-null
// recover the result owes. Returns 0, or -1 once failed.
function emitReturnPlainValue(
  retArg: i32,
  fnIx: i32,
  fnPos: i32,
  retNulString: boolean,
  retLitUnion: boolean,
  retNulLitUnion: boolean,
): i32 {
  const retBoxToNulStr = retNulString && boxIsNulStrUnion(retArg, fnIx)
  if retLitUnion || retNulLitUnion {
    const noMem = retStrLitNoMember(retArg, retNulLitTexts(fnIx), fnIx)
    if noMem >= 0 {
      return emitFailAt(
        "emitProgram: a returned string cannot be shown to be a member of the literal union this instantiation's result is",
        noMem,
      )
    }
  }
  if (
    retNulLitUnion
    && !retNulString
    && nodeTyIsNulString(unwrapParen(retArg))
  ) {
    if (emitNulStrJoinAsAtom(retArg, retNulLitTexts(fnIx), fnIx) < 0) {
      return -1
    }
  } else {
    if emitExpr(retArg, fnIx) < 0 { return -1 }
  }
  if retBoxToNulStr { emitBoxToNulStr() }
  // a return is a kind-9 use site that never grew the recover: a nullable-struct/variant
  // read deliberately stays the raw `(ref null $S)` (`emitCapturedReadRecover`'s rule),
  // so returning it into a non-null struct result needs its own `ref.as_non_null` or the
  // functype promises `(ref $S)` over `(ref null $S)`. A no-op on an already-recovered value.
  if retNeedsNonNullRecover(retArg, fnIx, fnPos) { fbRefAsNonNull() }
  return 0
}

// Lower `retArg` as the `null` of a result holding only `null` (`nulnone`, or a `: null`
// annotation): a `null` literal, or a write yielding one, is the bottom `ref.null none`, not
// the null of the place written (D14798). 0 or -1, or -2 when `retArg` is neither.
function emitRetNulNoneValue(retArg: i32, fnIx: i32, fnPos: i32): i32 {
  if !fnPosRetIsNulNone(fnPos) && !fnAnnRetIsNull(fnIx) { return -2 }
  const u = unwrapParen(retArg)
  if u < 0 || u >= P.nodes.length { return -2 }
  if nodeAt(u) is NullLit {
    fbRefNullNone()
    return 0
  }
  if !asgYieldsNullLit(u) { return -2 }
  if emitAssign(u, fnIx) < 0 { return -1 }
  fbRefNullNone()
  return 0
}

// Whether function `fnIx` is annotated (or pinned) with the `null` unit type as its result.
function fnAnnRetIsNull(fnIx: i32): boolean {
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) || fn.fnRet < 0 { return false }
  return tyPrimNameOf(nodeTyIxOf(fn.fnRet)) == "null"
}

// The coerced arms of a return value, in priority order: an f32, f64 or i64 widen, a
// concrete variant (`retVi`), a union box (`retUNm`), or a literal-union atom widened to its
// string. The caller takes the plain arm when none applies. Returns 0 or -1.
function emitReturnCoercedValue(
  retArg: i32,
  fnIx: i32,
  retF32: boolean,
  retF64: boolean,
  retI64: boolean,
  retVi: i32,
  retUNm: string,
  retUTy: i32,
  retStrWiden: boolean,
  retNulString: boolean,
  retInferred: boolean,
): i32 {
  if retF32 {
    if emitWidened(retArg, 5, fnIx) < 0 { return -1 }
  } else if retF64 {
    if emitWidened(retArg, 4, fnIx) < 0 { return -1 }
  } else if retI64 {
    if emitWidened(retArg, 3, fnIx) < 0 { return -1 }
  } else if retVi >= 0 {
    if emitVariantCoerce(retVi, retArg, fnIx) < 0 { return -1 }
  } else if retUNm != "" {
    // `retUNm` is the union-BOX return (kind 4); a concrete variant `return s` (where `s: S`
    // and the return type is `C | S`) is boxed into the shared `{tag, payload}` rep here.
    if emitUnionBoxOwed(retUNm, retUTy, retArg, fnIx) < 0 { return -1 }
  } else if retStrWiden {
    // A literal-union atom returned from a `string`-typed function widens to its member string.
    // A `K | null` value needs a result that holds `null`, which an inferred one does not
    // declare here (D3198).
    if (
      !retNulString
      && retInferred
      && nulAtomWidenTexts(retArg, fnIx).length > 0
    ) {
      return emitFailAt(
        "emitProgram: an inferred return of a nullable literal union has no string result to widen into",
        retArg,
      )
    }
    if emitAtomToStr(retArg, fnIx) < 0 { return -1 }
  }
  return 0
}

// What a function's result asks of its `return` values: the numeric widens, the variant and
// union-box targets, the niche and map seeds, and the literal-union atom forms.
type RetFlags = {
  retF32: boolean,
  retF64: boolean,
  retI64: boolean,
  retNulString: boolean,
  retLitUnion: boolean,
  retNulLitUnion: boolean,
  // A literal-union atom returned as `string` widens to its member text.
  retStrWiden: boolean,
  retUNm: string,
  retUTy: i32,
  retVi: i32,
  retInferred: boolean,
}

// Seed `rf`'s variant index, numeric widens and union-box name from `fn`'s result, annotated
// or inferred. Returns -1 after refusing an inferred `f32[]` return, else 0.
// The recorded value-union result of un-annotated function `fn` at position `fnPos`, else -1.
function fnRecordedUnionRet(fn: FuncDecl, fnPos: i32): i32 {
  if (
    fn.fnRet >= 0
    || fnPos < 0
    || fnPos >= fRecRetTy.length
    || fnPos >= fRetKind.length
  ) {
    return -1
  }
  if fRetKind[fnPos] != "union" { return -1 }
  return fRecRetTy[fnPos]
}

function retFlagsSeedResult(
  fn: FuncDecl,
  retArg: i32,
  fnIx: i32,
  fnPos: i32,
  rf: RetFlags,
): i32 {
  rf.retInferred = fn.fnRet < 0
  // A concrete-variant return (annotated `: Cat`, or a collapsed inferred lambda).
  if fnAnnRetKind(fn, fnIx) == "variant" {
    rf.retVi = annVariantRowOf(fn.fnRet)
  }
  // Every value an inferred arm return delivers, a join included, goes through
  // `emitVariantCoerce`, not only the literal the seed above reaches (D4639).
  if fn.fnRet < 0 {
    const rvi2 = inferredRetVariantIdx(fnPos)
    if rvi2 >= 0 { rf.retVi = rvi2 }
  }
  if retF32Flag(fn.fnRet) == 1 { rf.retF32 = true }
  if retF64Flag(fn.fnRet) == 1 { rf.retF64 = true }
  if retI64Flag(fn.fnRet) == 1 { rf.retI64 = true }
  // An UN-annotated return INFERRED as i64/f64 (the stored kind the A20 pass fills) widens
  // its value too — without this a `return 0` (an i32 literal) in a function whose other
  // branch returns a big i64 / an f64 expression stays `i32.const`, clashing with the i64/f64
  // functype result the inferred-return path declares (a soundness hole the checker accepts).
  if fn.fnRet < 0 {
    const rfe = fnPos
    if rfe >= 0 {
      if fRetKind[rfe] == "i64" { rf.retI64 = true }
      if fRetKind[rfe] == "f64" { rf.retF64 = true }
      // the f32 dual: an inferred f32 return whose body carries a float literal emits f64
      // unless forced, clashing with the f32 functype result (#614); a bare f32 `return x` needs no coercion.
      if fRetKind[rfe] == "f32" { rf.retF32 = true }
      // an inferred `f32[]` return has no producer, so the functype result stays at the
      // `"i32"` default while the emitted `return` pushes the f32 list's `(ref $array)` —
      // check-clean invalid wasm. Neither channel that fills the slot classifies this
      // shape; refuse loudly until it does. The annotated spelling already lowers.
      if fRetKind[rfe] == "i32" && exprF32Array(retArg, fnIx) {
        return emitFail(
          "emitProgram: an f32[] return must be annotated (`: f32[]`) — the inferred form has no result type",
        )
      }
    }
  }
  // a literal-union return reads as a union name but is an i32 atom — excluded from the
  // value-union box return, since `emitUnionBoxArg` would `struct.new` the member. A
  // nullable-closure return is the closure niche, not a value box, and takes the plain
  // arm; a nullable literal union is excluded on the same grounds.
  if fnAnnRetKind(fn, fnIx) == "union" {
    if (
      !nodeTyIsLitUnionAlias(fn.fnRet)
      && !nodeTyIsNulLitUnion(fn.fnRet)
      && nulCloFlag(fn.fnRet) != 1
    ) {
      rf.retUTy = nodeTyIxOf(fn.fnRet)
      rf.retUNm = boxTyName(rf.retUTy)
    }
  }
  if fn.fnRet < 0 {
    const im = inferRetNameOf(inferRetFnKey(fnIx, fn.fnName))
    const imTy = inferRetTyIxOf(inferRetFnKey(fnIx, fn.fnName))
    const imLit = im != "" && imTy >= 0 && tyIsLitUnion(imTy)
    // a value union or registered struct-union inferred return is a union-box return
    // (kind 4): box each concrete-variant/value-atom `return` via `retUNm`. A litunion
    // alias name is excluded on the same grounds as the annotated arm above — it
    // registers as a union name but its value is the interned i32 atom, so boxing it would be wrong.
    if (valueBoxOfTy(imTy) || (isUNameAB(26, imTy) && !imLit)) {
      rf.retUNm = boxTyName(imTy)
      rf.retUTy = imTy
    }
    // The inferred twins of the `nodeTyIsLitUnionAlias` / `nodeTyIsNulLitUnion` seeds
    // below: an un-annotated litunion return encodes a member literal as its atom id,
    // and its `| null` niche encodes a bare `null` as the `-1` sentinel.
    if imLit { rf.retLitUnion = true }
    if tyIsNullableLitUnion(imTy) { rf.retNulLitUnion = true }
  }
  // An un-annotated value-union result the checker's inferred name does not name (an
  // instance's `() => null` for `T | null`) boxes each value at its recorded type.
  const recU = nulTagIdRepTy(fnRecordedUnionRet(fn, fnPos))
  if rf.retUNm == "" && !rf.retLitUnion && !rf.retNulLitUnion && recU >= 0 {
    rf.retUNm = boxTyName(recU)
    rf.retUTy = recU
  }
  // A maker whose delivery builds its union of records as one record returns that record.
  if rf.retUNm != "" && fn.fnRet < 0 && recKeptFnDstOf(fnIx, rf.retUTy) >= 0 {
    rf.retUNm = ""
    rf.retUTy = -1
  }
  return 0
}

// Seed `rf`'s niche, map, literal-union and string-widen flags from `fn`'s result.
function retFlagsSeedNiches(
  fn: FuncDecl,
  retArg: i32,
  fnIx: i32,
  fnPos: i32,
  rf: RetFlags,
) {
  if fnAnnRetKind(fn, fnIx) == "nulstr" { rf.retNulString = true }
  if nodeTyIsLitUnionAlias(fn.fnRet) { rf.retLitUnion = true }
  // A synthesized `: K` (a lambda pinned at its alias) is typed at the alias's copy, which
  // the index test above misses and the provenance-reading one does not (D3120).
  if fn.fnRet >= 0 && tyIsLitUnion(nodeTyAt(fn.fnRet, fnIx)) {
    rf.retLitUnion = true
  }
  // A `K | null` NICHE return: a `return null` lowers as the i32 sentinel `-1`, a `return "a"`
  // as its atom id.
  if nodeTyIsNulLitUnion(fn.fnRet) { rf.retNulLitUnion = true }
  rf.retStrWiden = retStrWidenOf(fn, retArg, fnIx, fnPos)
  // An atom result keeps an atom value: a synthesized `: K` also reads as `string` to the
  // spelling tests above, which would widen the value the result holds as its id (D3160).
  if rf.retLitUnion && !retKindIsStr(fnPos) { rf.retStrWiden = false }
  // an inferred return whose value is an atom is left as an atom, and the call site
  // widens it (`fRetLitAtom`, from `fnRetColsFromRecorded`) — one flag, read by both passes.
  // Inferred niche nullable: seed from the A20 name so a `return null`/`return
  // <bool|string>` lowers as the sentinel/`ref.null` rep.
  if fn.fnRet < 0 {
    const nn = inferNicheNullByName(inferRetFnKey(fnIx, fn.fnName))
    if nn == "string|null" { rf.retNulString = true }
  }
  // The inferred `string | null` twin of the `cloRetIsString` widen: an atom arm of a join
  // the checker typed `string | null` widens to its member text, `null` for the niche (D3336).
  if fn.fnRet < 0 && rf.retNulString && !rf.retLitUnion && !rf.retNulLitUnion {
    if exprIsLitAtom(retArg, fnIx) { rf.retStrWiden = true }
  }
}

// `emitReturnValue` past its seeds: classify the result of `fn` into the return's widen and
// niche flags, emit `retArg` under `ctx` through the arm they pick, then the narrowed-arm unbox
// to `retArmHeap`. Restores the caller's context; returns 0 or -1.
function emitReturnValueTail(
  retArg: i32,
  fnIx: i32,
  fnPos: i32,
  retArmHeap: i32,
): i32 {
  const fn = nodeAt(fnIx)
  const nulNone = emitRetNulNoneValue(retArg, fnIx, fnPos)
  if nulNone != -2 { return nulNone }
  const rf: RetFlags = {
    retF32: false,
    retF64: false,
    retI64: false,
    retNulString: false,
    retLitUnion: false,
    retNulLitUnion: false,
    retStrWiden: false,
    retUNm: "",
    retUTy: -1,
    retVi: -1,
    retInferred: false,
  }
  if fn is FuncDecl {
    const seeded = retFlagsSeedResult(fn, retArg, fnIx, fnPos, rf)
    if seeded < 0 { return seeded }
    retFlagsSeedNiches(fn, retArg, fnIx, fnPos, rf)
  }
  // the narrowed-arm unbox at the return boundary (D1031): the bare `: Circle` result is
  // already served through `emitVariantCoerce`; the niche results (`Circle | null`, `Dot |
  // null`) are the ones that took the box into a `(ref null $H)` slot.
  const retArmOwed = retArmHeap >= 0
    && rf.retVi < 0
    && narrowedArmNeedsUnbox(retArg, fnIx)
  const retSeat = armOpen(retArmOwed, retArmHeap, retArg, fnIx)
  if (
    rf.retF32
    || rf.retF64
    || rf.retI64
    || rf.retVi >= 0
    || rf.retUNm != ""
    || rf.retStrWiden
  ) {
    if (
      emitReturnCoercedValue(
        retArg,
        fnIx,
        rf.retF32,
        rf.retF64,
        rf.retI64,
        rf.retVi,
        rf.retUNm,
        rf.retUTy,
        rf.retStrWiden,
        rf.retNulString,
        rf.retInferred,
      )
      < 0
    ) {
      return -1
    }
  } else {
    if (
      emitReturnPlainValue(
        retArg,
        fnIx,
        fnPos,
        rf.retNulString,
        rf.retLitUnion,
        rf.retNulLitUnion,
      )
      < 0
    ) {
      return -1
    }
  }
  armClose(retSeat, retArmOwed, retArmHeap, retArg, fnIx)
  // The caller's context comes back whole: a seed a `return { … }` or `return Map()` leaves
  // unconsumed would otherwise type the next function's `null` (D2564).
  return 0
}

// Lower a return-value expression `retArg` for function `fnIx`: emit it through the
// helper the function's return type selects. Does not emit `return` itself — the caller appends `fbReturn` or
// leaves the value on the stack. Unifies explicit `return e` with implicit tail returns.
function emitReturnValue(retArg: i32, fnIx: i32) {
  const fn = nodeAt(fnIx)
  // the heap a niche struct/variant result names (`Circle | null`, `Dot | null`) — the
  // narrowed-arm unbox's destination at this boundary (D1031). A bare `: Circle` result
  // needs none: `retVi` routes it through `emitVariantCoerce`.
  let retArmHeap = -1
  // one read, four uses: the inferred-return arms below want `fnStmtsPosOf`'s answer four
  // separate times, and taking it once is a hoist safe because nothing between the reads
  // writes `fnStmts`/`monoOrigNode` — both are written only by the collect/mono passes,
  // which finish before `emitCodeSection` begins. Stays behind `fn.fnRet < 0`, so an annotated return pays nothing.
  let fnPos = -1
  if fn is FuncDecl {
    if fn.fnRet < 0 { fnPos = fnStmtsPosOf(fnIx) }
  }
  const refused = retRefusedWhy(retArg, fnIx)
  if refused != "" { return emitFailAt(refused, retArg) }
  if fn is FuncDecl { retArmHeap = returnArmHeapOf(fn, fnIx, fnPos) }
  // A `null` the row stores in a union box, returned where the result is the `null` unit, is
  // that null: the box is read for effect and dropped.
  if (
    fnPos >= 0
    && fnPos < fRetKind.length
    && fRetKind[fnPos] == "nulnone"
    && nodeTyAt(retArg, fnIx) == TY_NULL
    && exprUnion(retArg, fnIx)
  ) {
    if emitExpr(retArg, fnIx) < 0 { return -1 }
    fbDrop()
    fbRefNullNone()
    return 0
  }
  return emitReturnValueTail(retArg, fnIx, fnPos, retArmHeap)
}

// Why returning `retArg` from `fnIx` is refused rather than mistyped, or "": the one decision
// legacy's return and the IR's builder read. A `null` into a non-null record result, a `.map`
// building another list than a union-list result names, or a container of functions built at
// another storage than the result.
export function retRefusedWhy(retArg: i32, fnIx: i32): string {
  const fn = nodeAt(fnIx)
  let fnPos = -1
  if fn is FuncDecl {
    if fn.fnRet < 0 { fnPos = fnStmtsPosOf(fnIx) }
  }
  if retNullIntoNonNullRef(retArg, fnIx, fnPos) {
    return "emitProgram: a `null` is returned where this instantiation's result is a non-null record"
  }
  if retResultIsRefList(fnIx, fnPos) && retMapBuildsOtherList(retArg, fnIx) {
    return "emitProgram: a returned `.map` builds a list the function's result does not name at this instantiation"
  }
  if retStorageMismatch(retArg, fnIx) {
    return "emitProgram: a returned container of functions is built at another storage than this function's result"
  }
  return ""
}

// Whether `retArg`, returned by function `fnIx` whose result is inferred, is a map or ref list
// that holds a function and is built at another slot than the function's result.
function retStorageMismatch(retArg: i32, fnIx: i32): boolean {
  // A written result type converts what is returned into it.
  const fd = nodeAt(fnIx)
  if !(fd is FuncDecl) || fd.fnRet >= 0 { return false }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return false }
  const rt = nodeTyIxOf(unwrapParen(retArg))
  // Only a value whose type still holds a hole, built at its bindings' own storage, can miss the
  // result's; a closed one is built at the result's type.
  if rt < 0 || rt >= T.tys.length || !tyMayHoldFn(rt) || !tyHasTyVar(rt) {
    return false
  }
  const rd = repOfFnSlot(fe)
  if tyAt(rt) is TyMap {
    return mapShapeOfExpr(retArg, fnIx) != cloRetValSlot(fe)
  }
  // A list is built at its own kind; a ref list at another kind than the result's misses it, and
  // one at the result's kind misses it where its row differs.
  const lk = exprListRep(retArg, fnIx)
  if lk == null || !vkIsNonNullRef(lk) { return false }
  if lk != rd.rdKind { return true }
  const s = refListSlotOfExpr(retArg, fnIx)
  return s >= 0 && rd.rdSlot >= 0 && s != rd.rdSlot
}

// The member texts of the `K | null` result of function `fnIx`: its annotation's (a
// synthesized one in an instance), else its inferred return's; empty when neither has any.
function retNulLitTexts(fnIx: i32): string[] {
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    if fn.fnRet >= 0 { return nulLitMemberTexts(nodeTyIxOf(fn.fnRet)) }
    return nulLitMemberTexts(inferRetTyIxOf(inferRetFnKey(fnIx, fn.fnName)))
  }
  const none: string[] = []
  return none
}

// A value join typed `string | null` delivered to a `K | null` atom result: each arm lowers in
// the atom context, so the result stays the i32 niche. A leaf the niche cannot hold — a string
// that is no member of `texts`, or a string value that is not an atom — refuses (D4173).
function emitNulStrJoinAsAtom(ix: i32, texts: string[], fnIx: i32) {
  const u = unwrapParen(ix)
  if !ifJoinNarrowsPerArm(u) || texts.length == 0 {
    return emitFailAt(
      "emitProgram: a `string | null` value is returned where this instantiation's result is a nullable literal union",
      ix,
    )
  }
  const bad = nulAtomJoinMisfit(u, texts, fnIx, true)
  if bad >= 0 {
    return emitFailAt(
      "emitProgram: a returned string cannot be shown to be a member of the literal union this instantiation's result is",
      bad,
    )
  }
  const r = emitIfExprAs(u, fnIx, 127)
  return r
}

// The string literal `ix` returns, itself or as a leaf of its join, that names none of the
// non-empty member list `texts`; -1 when there is none.
function retStrLitNoMember(ix: i32, texts: string[], fnIx: i32): i32 {
  if texts.length == 0 { return -1 }
  return nulAtomJoinMisfit(ix, texts, fnIx, false)
}

// The first leaf value of the value join at `ix` that a literal-union atom with member texts
// `texts` cannot hold, or -1: a string literal naming no member, and when `strict`, any leaf
// that is neither `null`, a member literal nor an atom.
function nulAtomJoinMisfit(
  ix: i32,
  texts: string[],
  fnIx: i32,
  strict: boolean,
): i32 {
  const u = unwrapParen(ix)
  if u < 0 { return ix }
  const n = nodeAt(u)
  if n is IfStmt {
    if n.ifElse < 0 { return u }
    const t = nulAtomJoinMisfit(ifArmValueExpr(n.ifThen), texts, fnIx, strict)
    if t >= 0 { return t }
    if nodeAt(n.ifElse) is IfStmt {
      return nulAtomJoinMisfit(n.ifElse, texts, fnIx, strict)
    }
    return nulAtomJoinMisfit(ifArmValueExpr(n.ifElse), texts, fnIx, strict)
  }
  if n is MatchExpr {
    for b in n.matchBodies {
      let v = b
      if b >= 0 && nodeAt(b) is Block { v = ifArmValueExpr(b) }
      const m = nulAtomJoinMisfit(v, texts, fnIx, strict)
      if m >= 0 { return m }
    }
    return -1
  }
  if n is StrLit {
    let i = 0
    while i < texts.length {
      if strLexSameValue(quoteLex(texts[i]), n.strText) { return -1 }
      i = i + 1
    }
    return u
  }
  return nulAtomLeafMisfit(u, fnIx, strict)
}

// `u` when the non-string leaf `u` misfits a literal-union atom under `strict` (neither `null`
// nor an atom), else -1.
function nulAtomLeafMisfit(u: i32, fnIx: i32, strict: boolean): i32 {
  if !strict || exprIsNullLike(u) || exprIsLitAtom(u, fnIx) { return -1 }
  return u
}

// The exact bytes `fbStructNew(uBoxIdx)` writes, produced BY that encoder into a scratch
// buffer rather than re-derived — so the peephole's pattern cannot drift from the
// instruction it matches if the encoding (or `uBoxIdx`'s ULEB width) ever changes.
function unionBoxNewBytes() {
  const probe: u8[] = []
  const prev = wTarget(probe)
  fbStructNew(uBoxIdx)
  wTarget(prev)
  return probe
}

// The exact bytes the armed tail-call cursor's call wrote, produced BY its encoder into a
// scratch buffer — the `unionBoxNewBytes` discipline, so the tail-call peephole's pattern
// cannot drift from the instruction it matches if an index's ULEB width changes.
function tailCallBytes() {
  const probe: u8[] = []
  const prev = wTarget(probe)
  if tailCallTable < 0 {
    fbCall(tailCallIdx)
  } else {
    fbCallIndirect(tailCallIdx, tailCallTable)
  }
  wTarget(prev)
  return probe
}

// Whether the armed call's bytes end `back` bytes before the write cursor.
function tailCallEndsAt(back: i32) {
  const pat = tailCallBytes()
  const np = pat.length
  let i = 0
  while i < np {
    if wPeekBack(back + i) != pat[np - 1 - i] { return false }
    i = i + 1
  }
  return true
}

// Unwrite the armed call, `back` bytes before the cursor, together with those bytes, and write
// its tail form in their place; disarms the cursor.
function tailCallRewrite(back: i32) {
  wDropBack(back + tailCallBytes().length)
  if tailCallTable < 0 {
    fbReturnCall(tailCallIdx) // 0x12 return_call
  } else {
    fbReturnCallIndirect(tailCallIdx, tailCallTable) // 0x13 return_call_indirect
  }
  tailCallEnd = -1
  tailCallIdx = -1
  return 0
}

// Rewrite a trailing call into its tail form, reporting whether it fired. A call whose bytes
// are still the last thing written when `return` terminates is in tail position by
// construction. Validity needs no result-type check, since a tail call imposes the same
// subtyping `return` already does; the one break is arity, so a void caller is declined here.
function emitTailCallRet(fnIx: i32) {
  if fbRetExtra.length > 0 { return emitLiftSelfTailRet(fnIx) }
  if tailCallIdx < 0 || tailCallEnd != wLen() { return false }
  if !tailCallEndsAt(0) { return false }
  const fnPos = fnStmtsPosOf(fnIx)
  if fnPos < 0 { return false }
  if fRetVoid[fnPos] == 1 { return false }
  tailCallRewrite(0)
  return true
}

// The tail-call rewrite at a void function's exit: the explicit `return f()` and the trailing
// call statement, and the end of a tail-position `if` arm. Only a call to a void callee that
// hands nothing back qualifies, since `return` tolerates a leftover result and a tail call
// does not (D4654, D4655, D4680).
export function emitVoidTailCall(fnIx: i32) {
  if fbRetExtra.length > 0 { return false }
  if tailCallIdx < 0 || tailCallEnd != wLen() { return false }
  const fnPos = fnStmtsPosOf(fnIx)
  if fnPos < 0 || fnPos >= fRetVoid.length || fRetVoid[fnPos] != 1 {
    return false
  }
  if tailCallTable >= 0 {
    if !tailCallVoid || !tailCallEndsAt(0) { return false }
    tailCallRewrite(0)
    return true
  }
  if !voidTailCallee(tailCallIdx - gImports) { return false }
  if !tailCallEndsAt(0) { return false }
  tailCallRewrite(0)
  return true
}

// Whether a void function's tail call to callee `pos` may take its tail form: the callee returns
// nothing and hands no captures back. The IR lowering asks the same.
export function voidTailCallee(pos: i32): boolean {
  return pos >= 0
    && pos < fRetVoid.length
    && fRetVoid[pos] == 1
    && cloLiftWriteCount(pos) == 0
}

// The tail-call rewrite in a lifted function that hands captures back: only a call to itself
// returns what the function itself would, so its write-back is dropped with it (D3664).
function emitLiftSelfTailRet(fnIx: i32) {
  if fnUses.unionSink || tailCallIdx < 0 || tailCallEnd < 0 { return false }
  if tailCallTable >= 0 || liftWbEnd != wLen() { return false }
  const fnPos = fnStmtsPosOf(fnIx)
  if fnPos < 0 || tailCallIdx != gImports + fnPos { return false }
  const wb = wLen() - tailCallEnd
  if !tailCallEndsAt(wb) { return false }
  tailCallRewrite(wb)
  liftWbEnd = -1
  return true
}

// Terminate a return in function-result position: the ordinary `return`, the tail-call
// rewrite when the result is a direct call, or — for a union-box-returning function
// taking the sink — the two `local.set`s and branch to the exit block. A peephole: when
// the last instruction written is `struct.new $uBox`, popping its operands into the exit locals is observably identical.
export function emitUnionRetSink(fnIx: i32) {
  if fnUses.unionSink {
    if uBoxNewIsLast() {
      uBoxSinkToPair()
      fbBr(ctrlDepth) // 0x0c br to the function's single exit block
      uSinkFired = uSinkFired + 1
      return 0
    }
  }
  if emitTailCallRet(fnIx) { return 0 }
  fbReturn() // 0x0f return
  return 0
}

// the union-box peephole's match, shared by both sink positions: is the last instruction
// written the box's own `struct.new $uBox`, with its two operands still on the wasm stack
// in field order? Both conditions are load-bearing: the cursor alone admits nothing-written-
// since, the byte pattern alone admits a false match (an operand can spell any opcode).
export function uBoxNewIsLast() {
  if uBoxNewEnd != wLen() { return false }
  const pat = unionBoxNewBytes()
  const np = pat.length
  let ok = true
  let i = 0
  while i < np {
    if wPeekBack(i) != pat[np - 1 - i] { ok = false }
    i = i + 1
  }
  return ok
}

// Unwrite the matched `struct.new $uBox` and pop its two operands into the sink pair,
// restoring the wasm stack to before the box's operands pushed. Valid only immediately
// after `uBoxNewIsLast()` answers true.
export function uBoxSinkToPair() {
  wDropBack(unionBoxNewBytes().length)
  fbLocalSet(unionSinkBase + 1) // the anyref payload — top of stack
  fbLocalSet(unionSinkBase) // the i32 tag — beneath it
  return 0
}

// `emitReturnExit` for a body's tail value statement, read at its arm-prelude locals as
// `emitStmt` reads a statement (D5331).
function emitTailReturnExit(stmtIx: i32, fnIx: i32) {
  const kept = stmtArmScopeOpen(stmtIx)
  const rc = emitReturnExit(stmtIx, fnIx)
  if kept >= 0 { stmtArmScopeClose(kept) }
  return rc
}

// Terminate a return: lower the value at `retArg` as function `fnIx`'s result and end the
// exit. Every exit in the emitter goes through here, so the value lowering and its
// terminator can never be paired differently. The one exception is a returned
// if-expression in a sinking function, split into per-arm exits below.
function emitReturnExit(retArg: i32, fnIx: i32) {
  if fnUses.unionSink {
    const bare = nodeAt(unwrapParen(retArg))
    // A join typed one wider number is that number, boxed once, as at every other delivery (D3656).
    if bare is IfStmt && !retIfIsOneNumber(unwrapParen(retArg), fnIx) {
      return emitUnionRetIfSink(unwrapParen(retArg), fnIx)
    }
  }
  if emitReturnValue(retArg, fnIx) < 0 { return -1 }
  emitUnionRetSink(fnIx)
  return 0
}

// Whether the `if` at `ifIx`, returned from a function taking the union sink, is one wider
// number its arms do not each box: it adapts (`ifJoinAdaptsScalar`) and has a literal tail,
// which is built at that number as its hoisted twin builds it (D3571; owner ruling, D3657).
// Runtime tails alone keep their members (D3656).
function retIfIsOneNumber(ifIx: i32, fnIx: i32): boolean {
  if !fnUses.unionSink || ifIx < 0 || ifIx >= P.nodes.length { return false }
  if !ifJoinAdaptsScalar(ifIx, fnIx) { return false }
  for lf in valueTailLeaves(ifIx) {
    if cexLitPeel(lf) >= 0 { return true }
  }
  return false
}

// `return if c { a } else { b }` in a union-box-returning function taking the sink.
// `emitUnionCoerce`'s value-typed `if` builds a box in each arm, so lowering it as a void
// statement-`if` whose arms each return is the identical program, meeting the sink's
// peephole per arm. The trailing `unreachable` restores the polymorphism a diverging `end` still needs.
function emitUnionRetIfSink(ifIx: i32, fnIx: i32) {
  // An `else if` chain is emitted along its spine, so its depth costs no stack (D1990): each
  // link leaves its frame open for the next, and the frames close innermost-first.
  const open: i32[] = []
  let cur = ifIx
  let rc = 1
  while rc == 1 {
    rc = emitUnionRetIfSinkLink(cur, fnIx, open)
    if rc == 1 {
      const link = nodeAt(unwrapParen(cur))
      if link is IfStmt { cur = link.ifElse }
    }
  }
  return closeIfChainFrames(open, rc, true)
}

// One link of `emitUnionRetIfSink`: 0 or -1 as that function returns, or 1 when the else is another `if`
// and this link's frame is left open (its else restore target pushed onto `open`).
function emitUnionRetIfSinkLink(ifIx: i32, fnIx: i32, open: i32[]) {
  const s = nodeAt(ifIx)
  if s is IfStmt {
    if emitCondExpr(s.ifCond, fnIx) < 0 { return -1 }
    fbIf(64) // 0x04 if, 0x40 void blocktype
    const rcT = emitUnionRetIfArm(s.ifThen, fnIx)
    if rcT < 0 { return -1 }
    fbElse() // 0x05 else
    // A VALUE union narrows to the COMPLEMENT set in the else-arm (see `emitStmt`).
    let rc = 0
    if s.ifElse < 0 {
      // An else-less `if` yields `null` on its missing path (D2040): that path returns the
      // function's own null, exiting like every other arm.
      rc = emitNullForRet(fnIx)
      if rc >= 0 { rc = emitUnionRetSink(fnIx) }
    } else if (
      nodeAt(s.ifElse) is IfStmt
      && !retIfIsOneNumber(s.ifElse, fnIx)
    ) {
      open.push(-1)
      return 1 // `else if`: the next link, which the caller emits into this open frame
    } else if nodeAt(s.ifElse) is IfStmt {
      rc = emitReturnExit(s.ifElse, fnIx)
    } else {
      rc = emitUnionRetIfArm(s.ifElse, fnIx)
    }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    fbUnreachable() // 0x00 — every arm exited; see the header
    return 0
  }
  return emitFail("emitProgram: expected a union if-expression")
}

// One arm of a sunk returned if-expression: the arm's prelude, then its tail-value
// statement lowered as the function's return value and terminated like any other exit
// (`emitReturnExit`, which recurses when that value is itself an if-expression).
function emitUnionRetIfArm(blockIx: i32, fnIx: i32) {
  const b = nodeAt(blockIx)
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if tailIsValueOrNever(tv, fnIx) {
        if emitIfArmOpen(blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        return emitIfArmClose(emitReturnExit(tv, fnIx))
      }
      const inner = nodeAt(unwrapParen(tv))
      if inner is IfStmt {
        if emitIfArmOpen(blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        return emitIfArmClose(emitReturnExit(tv, fnIx))
      }
    }
    return ifArmNoValueFail("union if-expression arm", blockIx)
  }
  return emitFail("emitProgram: union if-expression arm is not a block")
}

// The padding a valued body `fnBody` of `fnIx` needs at its end: "" when it ends in a `return` or
// tail value, "null" when the return bears null (a live fall-through), else "unreachable", since
// the checker proved the fall-through dead. Legacy and the IR's lowering both ask it.
export function fallThroughPadOf(fnBody: i32, fnIx: i32): string {
  if bodyEndsInReturn(fnBody, fnIx) { return "" }
  if fnRetNullBearing(fnIx) { return "null" }
  return "unreachable"
}

// `fallThroughPadOf` for function declaration `fnIx`'s own body; "" for any other node.
export function fnFallThroughPadOf(fnIx: i32): string {
  if fnIx < 0 || fnIx >= P.nodes.length { return "" }
  const fd = nodeAt(fnIx)
  return if fd is FuncDecl { fallThroughPadOf(fd.fnBody, fnIx) } else { "" }
}

// Emit the `null` value of function `fnIx`'s nullable return rep, leaving it on the stack as the
// function's result (the fall-through path's implicit `return null`).
export function emitNullForRet(fnIx: i32) {
  return emitNullRetTail(nullRetPlanOf(fnIx))
}

// Writes the null `p` names; a missing plan fails.
export function emitNullRetTail(p: NullRet | null) {
  if p == null {
    return emitFail("emitNullForRet: unsupported nullable return rep")
  }
  if p.nrBox {
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone() // payload slot unread under the null tag
    fbStructNew(uBoxIdx)
    return 0
  }
  if p.nrHeap >= 0 {
    fbRefNull(p.nrHeap)
    return 0
  }
  emitNullOwn(p.nrOwn)
  return 0
}

// Lower a single statement at `stmtIx` onto `body`, resolving identifiers/params
// against function `fnIx`. Returns 0, or -1 (via `emitFail`) on an unsupported shape.
export function emitStmt(stmtIx: i32, fnIx: i32) {
  if !exprArmLocalsAny { return emitStmtGo(stmtIx, fnIx) }
  const kept = stmtArmScopeOpen(stmtIx)
  const rc = emitStmtGo(stmtIx, fnIx)
  if kept >= 0 { stmtArmScopeClose(kept) }
  return rc
}

function emitStmtGo(stmtIx: i32, fnIx: i32) {
  // stop after a recorded failure: `emitFail` banks the first message and returns -1, but
  // does not halt the pass, so a caller that drops the -1 keeps emitting over invalidated
  // state — the next unguarded parallel-table read then traps the compiler before the
  // diagnostic prints. Checking the flag at the two recursion roots makes it terminal.
  if emitFailed { return -1 }
  if stmtIx < 0 { return emitFail("emitProgram: missing statement") }
  const s = nodeAt(stmtIx)
  if s is FuncDecl {
    // a nested function declaration statement (`function add(x) x + n`) is lifted to a
    // top-level wasm function by `collectFns`, so it emits no inline code here — just a
    // no-op in its enclosing body. Its name resolves as a closure value when referenced; a
    // cached env is dropped here, so each execution of the declaration is a new function value.
    return emitEnvCacheDrop(fnStmtsPosOf(stmtIx))
  }
  // D1045 — a body-scoped `type` declaration, one statement over: the parser hoisted the
  // node into `progStmts`, so every registry needing it comes from the top-level walk, and
  // the declaration emits no inline code here. Not a value, so `stmtIsTailValue` never claims it either.
  if s is TypeDecl { return 0 }
  if s is UnionDecl { return 0 }
  if s is LetDecl { return emitLetDeclStmt(s, stmtIx, fnIx) }
  if s is BinExpr {
    // A bare `BinExpr` statement is an assignment (`x = <expr>`); any OTHER operator
    // in statement position is a DISCARDED value (`1 + 1` as a tail statement of a
    // void function) — evaluate it for effect, then `drop` the value it leaves.
    if s.binOp == "=" { return emitAssign(stmtIx, fnIx) }
    if emitExpr(stmtIx, fnIx) < 0 { return -1 }
    fbDrop() // 0x1a drop
    return 0
  }
  if s is Unary {
    // postfix `x++`/`x--` in statement position: the old-value result is discarded, so
    // emit just the inner increment assignment — the same bytes a plain assignment
    // statement writes. A prefix unary leaves a value instead, falling through below.
    if s.unOp == "p+" || s.unOp == "p-" { return emitAssign(s.unArg, fnIx) }
  }
  if s is Call { return emitCallStmt(s, stmtIx, fnIx) }
  // A parenthesised call statement is that call statement: a void one leaves no value for the
  // discard below to drop (D2637).
  if s is Paren {
    if nodeAt(unwrapParen(stmtIx)) is Call {
      return emitStmt(unwrapParen(stmtIx), fnIx)
    }
  }
  if s is RetStmt {
    if s.retArg < 0 {
      // a bare `return` is the ordinary early exit of a void function. `fRetVoid` is read
      // position-keyed through `fnStmtsPosOf`, the channel `emitFuncCode`'s void fall-through reads.
      const rPos = fnStmtsPosOf(fnIx)
      if rPos >= 0 {
        if fRetVoid[rPos] == 1 {
          // The checker splits `return f()` here into `f()` and this bare `return`.
          if emitVoidTailCall(fnIx) { return 0 }
          fbReturn() // 0x0f return
          return 0
        }
      }
      // The floor, and no check-clean program reaches it: the checker pins a body holding a
      // bare `return` to void, at the annotated spelling and the inferred one alike, so a
      // non-void function carrying one is refused before emit (D1600).
      return emitFail(
        "emitProgram: a bare `return` in a function the emitter classified non-void — the checker owed this diagnosis",
      )
    }
    // void-context discard, the explicit-return leg: a `return <expr>` inside a void
    // function evaluates the expression for effect and returns nothing. Reached only by a
    // `synthVoidTwins` twin lowering a checker-valid non-void body under a void functype.
    // Routed through `emitStmt` so the statement ladder decides per shape what is on the stack.
    const rvPos = fnStmtsPosOf(fnIx)
    if rvPos >= 0 && rvPos < fRetVoid.length {
      if fRetVoid[rvPos] == 1 {
        if emitStmt(s.retArg, fnIx) < 0 { return -1 }
        if emitVoidTailCall(fnIx) { return 0 }
        fbReturn() // 0x0f return (void: nothing pushed)
        return 0
      }
    }
    // A returned value `if` is the tail `if`: each arm's value is its own exit. Whatever falls
    // through, an else-less chain or an arm's own else-less `if`, takes the result's `null` as the
    // tail's pad gives it; a result that admits no `null` has nothing falling through.
    const rIf = unwrapParen(s.retArg)
    if lastStmtIsValueIf(rIf, fnIx) || elseLessNullableTail(rIf, fnIx) {
      if emitIfTail(rIf, fnIx) < 0 { return -1 }
      if !fnRetNullBearing(fnIx) {
        fbUnreachable() // 0x00
        return 0
      }
      if emitNullForRet(fnIx) < 0 { return -1 }
      return emitUnionRetSink(fnIx)
    }
    // Seed the return context + emit the value (struct / list / union / nullable /
    // widening) and terminate the exit, via the shared helper.
    return emitReturnExit(s.retArg, fnIx)
  }
  if s is IfStmt { return emitIfStmtStmt(stmtIx, fnIx) }
  if s is WhileStmt { return emitWhileStmtStmt(s, stmtIx, fnIx) }
  if s is ForRange { return emitForRangeStmt(s, stmtIx, fnIx) }
  if s is ForIn { return emitForInStmt(s, stmtIx, fnIx) }
  if s is BreakStmt { return emitBreakStmtStmt(s, stmtIx) }
  if s is ContinueStmt { return emitContinueStmtStmt(s, stmtIx, fnIx) }
  // a bare value expression in non-tail statement position is a discarded value: evaluate
  // it for effect, then drop what it leaves — the same rule the `BinExpr` arm above applies
  // to `1 + 1`, reached through `stmtIsTailValue`. The tail statement of a body never
  // arrives here: `emitFuncBody`/`emitStmtTail` route a tail value to `emitReturnExit` first.
  if stmtWritesNothing(stmtIx) { return 0 }
  if stmtIsTailValue(stmtIx, fnIx) {
    if emitExpr(stmtIx, fnIx) < 0 { return -1 }
    fbDrop() // 0x1a drop
    return 0
  }
  return emitFail("emitProgram: unsupported statement in body")
}

// Whether discarded statement `stmtIx` builds nothing observable and so is not written: a bare
// function name or an inert literal. The IR's builder asks the same.
export function stmtWritesNothing(stmtIx: i32): boolean {
  return stmtIsBareFnName(stmtIx) || stmtIsInertLit(stmtIx)
}

// Whether discarded statement `stmtIx` is a list or record literal built only of constants and
// function names `stmtIsBareFnName` admits, through parentheses: building it has no effect, so it
// emits nothing and needs no row.
function stmtIsInertLit(stmtIx: i32): boolean {
  const x = unwrapParen(stmtIx)
  if x < 0 { return false }
  const e = nodeAt(x)
  if !(e is ArrayLit) && !(e is ObjLit) { return false }
  return inertLitPart(x)
}

// Whether expression `ix` builds nothing observable: a constant, an inert function name, or a list
// or record literal of such parts. A spread, a call or any other read is not.
function inertLitPart(ix: i32): boolean {
  const x = unwrapParen(ix)
  if x < 0 { return false }
  const e = nodeAt(x)
  match e {
    NumLit | StrLit | CharLit | BoolLit | NullLit => {
      return true
    }
    Ident => {
      return stmtIsBareFnName(x)
    }
    ArrayLit => {
      for el in e.arrElems {
        if !inertLitPart(el) { return false }
      }
      return true
    }
    ObjLit => {
      for f in e.objFields {
        const fi = nodeAt(f)
        if !(fi is FieldInit) { return false }
        if !inertLitPart(fi.fiValue) { return false }
      }
      return true
    }
    // Anything that computes, reads or binds may have an effect, so it is built and dropped.
    Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {
      return false
    }
  }
}

// Whether discarded statement `stmtIx` is a function's bare name, through parentheses: its
// closure has no effect, so it emits nothing and needs no closure type (D6980). A hole
// function's name counts only once the prune noted it inert, so a refused one still refuses (D6960).
export function stmtIsBareFnName(stmtIx: i32): boolean {
  const x = unwrapParen(stmtIx)
  if x < 0 || !(nodeAt(x) is Ident) { return false }
  if vrValueInert(x) || elabValueSlotUncalled(x) { return true }
  const d = identDeclOf(x)
  if d < 0 || d >= P.nodes.length { return false }
  const f = nodeAt(d)
  if !(f is FuncDecl) { return false }
  for p in f.fnParams {
    const q = nodeAt(p)
    if q is Param && q.parType < 0 { return false }
  }
  return true
}

function emitLetDeclStmt(s: LetDecl, stmtIx: i32, fnIx: i32) {
  // `let x = <expr>` / `const x = <expr>`: emit the init, then store it into the local's
  // slot. This `LetDecl`'s slot is the next cursor position, not name-resolved (a name
  // lookup would hit an outer same-named binding still in scope here).
  if cboxIsWriteLet(stmtIx) { stubWriteRhs = unwrapParen(s.letInit) }
  const slot = declSlotTake(stmtIx, 1)
  if slot < 0 || slot >= localIsRef.length {
    return emitFailAt(
      "emitProgram: a local declaration has no collected slot",
      stmtIx,
    )
  }
  let paramN = 0
  // The START function (`fnIx == -1`, top-level statements) has no params — and no
  // arena node to read, so the lookup must be guarded.
  if fnIx >= 0 {
    const fn = nodeAt(fnIx)
    if fn is FuncDecl { paramN = fn.fnParams.length + envSlotShift(fnIx) }
  }
  const idx = paramN + slot
  // A `const` bound to a lambda-lifted function holds no value: every use calls it directly.
  if (
    fnIx >= 0
    && s.letInit >= 0
    && cloLiftLetFe(fnStmtsPosOf(fnIx), stmtIx) >= 0
  ) {
    scopeBind(s.letName, slot)
    return 0
  }
  // A `const` every read copied the tree of is never read, and computing it would trap where
  // the copies do not (D15001).
  if keptDeclStoresNothing(s, stmtIx) {
    scopeBind(s.letName, slot)
    return 0
  }
  if s.letInit < 0 {
    // UNINITIALIZED scalar local (validated by `checkLocalI32`): nothing to store
    // — the wasm local's implicit zero-init covers the declaration; bind the name
    // so later reads/writes resolve to this slot.
    scopeBind(s.letName, slot)
    return 0
  }
  // A `const g = f` of a generic named function used only as a direct callee stores the closure:
  // `monomorphize` rewrote each `g(args)` to its pinned instance (`monoInstantiatedAny`). A
  // member of a tagged set is held as its id instead, its slot's rep (D15927).
  if fnIx >= 0 && fnTagLeafId(s.letInit) < 0 {
    const aliasFe = fieldValueFeOf(s.letInit)
    if fnHasUnannotatedParam(aliasFe) {
      if !criFnIsAnonLambda(aliasFe) {
        if monoInstantiatedAny(aliasFe) {
          const encl = nodeAt(fnIx)
          if encl is FuncDecl {
            if !nameUsedAsValueIn(s.letName, encl.fnBody) {
              if emitClosureValueCore(aliasFe, fnIx) < 0 { return -1 }
              fbLocalSet(idx) // 0x21 local.set
              scopeBind(s.letName, slot)
              return 0
            }
          }
        }
      }
    }
  }
  // A never-filled null hole (`let x = null`) is the plain `null` type, whose value is
  // `ref.null none`, not a zero i32; a filled one is a `T | null` box and takes the
  // union-coerce path below. The initializer still runs, for its effects and exits (D3355).
  if letIsNulNone(stmtIx, fnIx) {
    if emitNulNoneBoxPayload(s.letInit, fnIx) < 0 { return -1 }
    fbLocalSet(idx) // 0x21 local.set
    scopeBind(s.letName, slot)
    return 0
  }
  // Asked before the init emits, about the value the binding receives. Consumed beside
  // the two widen sites at the very bottom (D1031). The second disjunct is the cell's
  // own question, so a cell typed at the arm cannot be reached without its unbox.
  // An `if` joined at a record unboxes in each arm (`refIfArmOf`'s `unbox`), not here.
  const letArmOwed = !ifJoinsAtRecord(s.letInit, fnIx)
    && (narrowedArmNeedsUnbox(s.letInit, fnIx)
    || letInitTyIsNarrowedArm(stmtIx, fnIx)
    || letInitTyIsNarrowedNulArm(stmtIx, fnIx))
  // A bare-arm cell's init is delivered by `emitVariantCoerce`, which owns the unbox and the
  // niche recover both, so neither bottom step runs for it.
  const letArmCell = localIsRef[slot] == "variant"
  // numeric widening at the binding boundary: an `: f64`/`: f32`/`: i64` slot coerces a
  // narrower init value; an i32-only binding keeps the bytes it had. A union-annotated
  // binding (kind 4) coerces a raw init into the box; an already-union init passes
  // through `emitUnionCoerce` unchanged.
  let letUNm = ""
  let letAnnNm = ""
  if s.letType >= 0 { letAnnNm = boxTyName(nodeTyIxOf(s.letType)) }
  // A filled null hole (`let x = null` + later `x = e`, A-infer-null) is its
  // inferred `T|null` value union — coerce the bare `null` init into the box.
  if (
    isUNameAnnAB(27, s.letType)
    && !nodeTyIsLitUnionAlias(s.letType)
    && !nodeTyIsNulLitUnion(s.letType)
  ) {
    // a literal union reads as a union name but is an i32 atom, not a value-union box, so
    // it must not take `emitUnionCoerce` (which would `struct.new` the member) — excluded
    // via the arena's `nodeTyIsLitUnionAlias`, which also catches the nullable form the
    // name test (`nameIsLitUnionType`) cannot see for a member set carrying `null`.
    letUNm = letAnnNm
  } else if !isUNameAnnAB(28, s.letType) {
    letUNm = nliNameOf(stmtIx)
  }
  // A nullable function value's box names no type: a function-value-set row has no element
  // type, so it is keyed by its set, spelled by the scalar rep that carries the set's id.
  if letUNm == "" && localIsRef[slot] == "union" {
    letUNm = letNulScalarBoxName(stmtIx, fnIx)
  }
  // a nullable/value-union if-expression init lowers by writing the binding's own local
  // in each arm of a void `if` — no value-typed-if blocktype needed, since the binding
  // local is the destination. The slot kind `collectLocals` chose is the authoritative
  // rep: kind 4 the value-union box, kind 16 a `string | null` ref, kind 17 a `boolean | null` niche i32.
  if exprIsIfStmt(s.letInit) {
    const lif = emitLetIfInit(s, slot, idx, fnIx)
    if lif <= 0 { return lif }
  }
  if (
    emitLetInitValue(
      s,
      stmtIx,
      slot,
      localIsRef[slot],
      localStructIdx[slot],
      fnIx,
      letUNm,
      letArmCell,
    )
    < 0
  ) {
    return -1
  }
  emitLetDelivery(
    s,
    slot,
    fnIx,
    letArmOwed,
    letArmCell || nulArmIfCell(s, slot),
  )
  fbLocalSet(idx) // 0x21 local.set
  // Bind `name → slot` in the current emit-time frame AFTER emitting the init (so the
  // init resolved any same-named OUTER binding), making this binding live for the rest
  // of the block — mirrors the collect pass so resolution matches slot allocation.
  scopeBind(s.letName, slot)
  emitListReserve(s, stmtIx, idx, slot, fnIx)
  return 0
}

// Whether `s` binds a nullable arm cell (`nulvariant`, local `slot`) to an `if`, which joins at
// the cell's variant and so owes no unbox at the binding boundary (D17026).
export function nulArmIfCell(s: LetDecl, slot: i32): boolean {
  if slot < 0 || slot >= localIsRef.length || slot >= localStructIdx.length {
    return false
  }
  const vi = localStructIdx[slot]
  return localIsRef[slot] == "nulvariant"
    && exprIsIfStmt(s.letInit)
    && vi >= 0
    && vi < uVarRow.length
}

// `emitLetDeclStmt`'s init step: emits `s`'s initializer for local `slot` (kind `slotKind`,
// struct `slotStruct`) by the cell's rep — a niche, a union box (`letUNm`), an arm cell, a wide
// scalar, a widened atom or the plain path. The caller applied the init context and restores it.
// Returns -1 on a failure, else 0.
function emitLetInitValue(
  s: LetDecl,
  stmtIx: i32,
  slot: i32,
  slotKind: VKind,
  slotStruct: i32,
  fnIx: i32,
  letUNm: string,
  letArmCell: boolean,
) {
  const th = emitTypedHolderInit(stmtIx, fnIx)
  if th != 1 { return th }
  if slotKind == "nulclosure" || isNulScalarListKind(slotKind) {
    // A nullable function value or distinct-backing scalar list: a niche nullable ref, not a
    // box, so it takes priority over the union-coerce path. A bare `null` is `ref.null none`
    // and a value is the leaf ref, each of which subtypes the slot.
    if emitExpr(s.letInit, fnIx) < 0 { return -1 }
  } else if (slotKind == "union" && letNulMapReadUnionBox(stmtIx, fnIx)) {
    // A bare `const t = m[k]` read of a UNION-valued map (kind 2): the binding is the
    // established `A | B | null` box local — hit loads the stored box, miss synthesizes
    // the null-tagged box (`emitMapGetUnionBox`). The init is the Index the classifier
    // resolved; read its receiver/key here.
    const umr = nodeAt(unwrapParen(s.letInit))
    if umr is Index {
      if emitMapGetUnionBox(umr.idxArr, umr.idxIndex, fnIx) < 0 { return -1 }
    } else {
      return emitFail(
        "emitProgram: union-valued map read binding's init is not an index read",
      )
    }
  } else if nulArmIfCell(s, slot) {
    // A nullable arm cell's `if` joins at the cell's variant, so every arm reaches its row and a
    // `null` arm is the variant's own null (D17026).
    if emitIfExprRef(unwrapParen(s.letInit), fnIx, "variant", slotStruct) < 0 {
      return -1
    }
  } else if letArmCell {
    // An arm cell takes the bare variant struct whatever builds it, as at assignment (D4639).
    if emitVariantCoerce(slotStruct, s.letInit, fnIx) < 0 { return -1 }
  } else if letUNm != "" {
    // The binding boundary is a box-typed destination, so an init that is one ARM of the union
    // boxes here exactly as an argument does (D1606) — `emitUnionCoerce` alone passes an arm
    // value raw, which fits only a variant cell, and a union annotation never types one.
    // An inferred null-hole union (`nliNameOf`) is recorded by name alone, so it has no type.
    let letUTy = letBindingUnionTy(stmtIx, fnIx)
    if letUTy < 0 { letUTy = letBindTy(stmtIx, fnIx) }
    let letArmBoxed = 0
    if slotKind == "union" {
      letArmBoxed = emitUnionArmValueBox(letUTy, s.letInit, fnIx)
      if letArmBoxed < 0 { return -1 }
    }
    if letArmBoxed == 0 {
      if emitUnionBoxOwed(letUNm, letUTy, s.letInit, fnIx) < 0 { return -1 }
    }
  } else if letIsF32(stmtIx) || letInfersF32(stmtIx, fnIx) {
    // `letIsF32` is annotation-only; `collectLocals` types the slot with `letIsF32 ||
    // letInfersF32`, so an un-annotated `const g = fv * 1.0` needs the same pair here —
    // else this ladder falls to the f64 arm, whose fallback over-claims a mixed
    // f32/float-literal init and stores an f64 into the f32 slot, invalid wasm.
    if emitWidened(s.letInit, 5, fnIx) < 0 { return -1 }
  } else if letIsF64(stmtIx, fnIx) {
    if emitWidened(s.letInit, 4, fnIx) < 0 { return -1 }
  } else if letIsI64(stmtIx, fnIx) {
    if emitWidened(s.letInit, 3, fnIx) < 0 { return -1 }
  } else if (
    slot >= 0
    && slot < localIsRef.length
    && (localIsRef[slot] == "f64" || localIsRef[slot] == "i64")
  ) {
    // A slot laid out wider than its init emits (a direct call a value-flow rewrite resolved
    // out of a list whose calls join a wider result) takes the init widened to it (D16872).
    const wk = if localIsRef[slot] == "f64" { 4 } else { 3 }
    if emitWidened(s.letInit, wk, fnIx) < 0 { return -1 }
  } else if (
    (nodeTyPrimName(s.letType) == "string"
      || tyIsBareStrLit(nodeTyIxOf(s.letType))
      || s.letType < 0 && letCellKind(stmtIx, fnIx) == "str")
    && exprIsLitAtom(s.letInit, fnIx)
    && !letBindIsAtom(stmtIx, fnIx)
  ) {
    // A literal-union atom initializing a `string` local widens to its member string. Not
    // where the binding's cell is the atom (D1752). An un-annotated `let` copying a `const`'s
    // literal set is that string cell (D14757).
    if emitAtomToStr(s.letInit, fnIx) < 0 { return -1 }
  } else if letIsNulString(stmtIx, fnIx) && exprIsLitAtom(s.letInit, fnIx) {
    // a literal-union atom initializing a `string | null` binding widens to its member
    // string: the slot is the nullable string reference and the atom's rep is an i32 id.
    // The non-nullable form needs no arm: `collectLocals` classifies a non-nullable atom
    // init as an atom slot, so nothing widens at the init and each read widens instead.
    if emitStrValue(s.letInit, fnIx) < 0 { return -1 }
  } else {
    if emitLetPlainInit(s, stmtIx, slot, fnIx) < 0 { return -1 }
  }
  return 0
}

// The rep `emitLetIfInit` writes a binding's `if` initializer at, in each arm: 0 the union box
// of `nulTy` (D969: an un-annotated binding boxes too), 1 `string | null`, 2 `boolean | null`; -1
// when the binding takes the plain path. `slotKind` is the binding's local's kind.
export function letIfInitRep(slotKind: VKind, nulTy: i32): i32 {
  return match slotKind {
    "union" => if boxTyName(nulTy) != "" { 0 } else { -1 }
    "nulstr" => 1
    "nulbool" => 2
    "i32" | "struct" | "list" | "str" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "i64" | "f64" | "f64list" | "f32" | "closure" | "nullist" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "v128list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" | "v128" => -1
  }
}

// The type `emitLetIfInit` names a binding's union by: its annotation, else its joined `if`.
function letIfInitTy(s: LetDecl, fnIx: i32): i32 {
  if s.letType >= 0 { return nodeTyIxOf(s.letType) }
  return nodeTyAt(s.letInit, fnIx)
}

// `letIfInitRep` for the declaration at `declIx`: the rep legacy writes its `if` initializer at in
// each arm (`emitLetIfInit`), or -1 when its init is not an `if` or takes the plain path.
export function letIfInitPerArmRep(declIx: i32, fnIx: i32): i32 {
  const s = nodeAt(declIx)
  if !(s is LetDecl) || !exprIsIfStmt(s.letInit) { return -1 }
  const slot = declaredSlotOfDecl(declIx)
  if slot < 0 || slot >= localIsRef.length { return -1 }
  return letIfInitRep(localIsRef[slot], letIfInitTy(s, fnIx))
}

// A `let` whose init is an `if` over a nullable or value-union cell, written into local
// `idx` by each arm. Returns 0 once bound, 1 when the cell's rep takes no such lowering, and
// -1 on a failure.
function emitLetIfInit(s: LetDecl, slot: i32, idx: i32, fnIx: i32) {
  const nulTy = letIfInitTy(s, fnIx)
  const nulRep = letIfInitRep(localIsRef[slot], nulTy)
  const nulNm = if nulRep == 0 { boxTyName(nulTy) } else { "" }
  if nulRep >= 0 {
    // the binding sink: with every arm writing the shared pair and ONE `struct.new`
    // after the `if`, the arms' construction sites collapse to that one — and the
    // pre-seed below goes with them, because the single store dominates every read.
    if nulRep == 0 {
      if letIfInitSinks(s.letInit, fnIx) {
        if (emitUnionIfBindingSink(s.letInit, idx, nulNm, nulTy, fnIx) < 0) {
          return -1
        }
        unionLetSinkClose(idx)
        scopeBind(s.letName, slot)
        return 0
      }
    }
    // the value-union box local (kind 4) is a non-null `(ref $uBoxIdx)` — non-
    // defaultable, so the validator needs it definitely assigned before a void-`if`
    // merge; pre-seed the rep's null first. `string | null` is defaultable and needs none.
    if nulRep == 0 {
      if emitNulNullToLocal(idx, 0) < 0 { return -1 }
    }
    if (emitNullableIfBinding(s.letInit, idx, nulRep, nulNm, nulTy, fnIx) < 0) {
      return -1
    }
    scopeBind(s.letName, slot)
    return 0
  }
  return 1
}

// A `let`'s init on the plain path, under its niche and atom seeds; a
// `const` used as a memory address takes the address fold. Returns -1 on a failure, else 0.
function emitLetPlainInit(s: LetDecl, stmtIx: i32, slot: i32, fnIx: i32) {
  // The declaration-time address fold: a `const p = K + bounded` later used as a memory
  // address needs its bounded part kept in its own scratch local — `const`-only, since a
  // `let` can be reassigned. The checks are `maFoldCandidateCount`'s own, in the same
  // order, so the two can never disagree about which declarations qualify.
  let mfK: i64 = -1
  if (
    fnIx >= 0
    && localIsRef[slot] == "i32"
    && s.letKw == "const"
    && mfShapeIsSum(s.letInit)
  ) {
    mfK = memConstFoldShapeK(s.letInit, fnIx)
  }
  if mfK >= 0 {
    if emitMemConstFoldLet(s.letInit, mfK, fnIx, stmtIx) < 0 { return -1 }
  } else if emitExpr(s.letInit, fnIx) < 0 {
    return -1
  }
  return 0
}

// What a `let`'s init value owes its cell in local `slot` before the store: the narrowed-arm
// unbox and the nullable-niche recover.
function emitLetDelivery(
  s: LetDecl,
  slot: i32,
  fnIx: i32,
  letArmOwed: boolean,
  letArmCell: boolean,
) {
  // the narrowed-arm unbox at the binding boundary (D1031): the cell's own (kind, slot) pair is
  // the destination.
  if letArmOwed && !letArmCell {
    const letArmHeap = armDestHeapOf(localIsRef[slot], localStructIdx[slot])
    // An arm the init's own type owes passes the global initializer's guard; one owed by the
    // binding's narrowed type alone (`letInitTyIsNarrowedArm`) is a box by construction.
    const owedByInit = narrowedArmNeedsUnbox(s.letInit, fnIx)
    if (
      letArmHeap >= 0
      && (!owedByInit || armUnboxCastOwed(letArmHeap, s.letInit, fnIx))
    ) {
      emitArmUnboxCast(
        letArmHeap,
        narrowedNulStructArm(s.letInit, fnIx) || localIsRef[slot] == "nulvariant",
      )
    }
  }
  // the nullable-niche recover at the BINDING boundary (D1115) — `const z: i32[] = y` under
  // `if y != null`. The cell's own kind is the destination, exactly as the two widen sites
  // above read it.
  if !letArmCell && nulNicheRecoverOwed(localIsRef[slot], s.letInit, fnIx) {
    fbRefAsNonNull()
  }
}

// The statement list and position of the statement `emitStmt` is about to lower, so a `let`
// can read the statements after it; `letSibPos` is -1 outside such a call (D3623).
let letSibStmts: i32[] = []
let letSibPos = -1

// `emitStmt` on `stmts[i]`, with the list and position published for `emitListReserve`.
function emitStmtIn(stmts: i32[], i: i32, fnIx: i32): i32 {
  letSibStmts = stmts
  letSibPos = i
  const rc = emitStmt(stmts[i], fnIx)
  letSibPos = -1
  if rc >= 0 && lbEnd.length > 0 { listBuildClose(stmts[i]) }
  return rc
}

// A fresh `[]` binding whose next uses are unconditional `push`es inside constant-trip range
// loops gets its backing at the final size, and those pushes append through locals while the
// count is under it (D3623). Each still tests the count, so a wrong one costs a growth, never
// a wrong answer.
function emitListReserve(
  s: LetDecl,
  stmtIx: i32,
  idx: i32,
  slot: i32,
  fnIx: i32,
) {
  const pos = letSibPos
  letSibPos = -1
  if pos < 0 || pos >= letSibStmts.length || letSibStmts[pos] != stmtIx {
    return 0
  }
  return listReserveOpen(s, letSibStmts, pos, idx, slot, fnIx)
}

// After `let` `s` (statement `pos` of `stmts`) stored its `[]` in local `idx` (declared slot
// `slot`): size its backing for the pushes `listReserveScan` counts, and open the build region
// they append through, which `listBuildClose` ends after its last statement.
export function listReserveOpen(
  s: LetDecl,
  stmts: i32[],
  pos: i32,
  idx: i32,
  slot: i32,
  fnIx: i32,
) {
  const want = reserveListKindOfSlot(localIsRef[slot])
  if want == null { return 0 }
  const r = listReserveScan(s, stmts, pos, fnIx)
  if r == null { return 0 }
  const recv = listPushRecv(r.lrPushes[0])
  if mfRecvKindOf(recv, fnIx) != want { return 0 }
  let row = 0
  if want == "reflist" { row = refListSlotOfExpr(recv, fnIx) }
  if want == "u8list" { row = exprPackedRow(recv, fnIx) }
  if row < 0 { return 0 }
  const wrap = spreadWrapIdx(want, row)
  const back = spreadBackIdx(want, row)
  if wrap < 0 || back < 0 { return 0 }
  fbLocalGet(idx)
  fbI32Const(r.lrCount)
  fbArrayNewDefault(back)
  fbStructSet(wrap, 0) // backing
  fbLocalGet(idx)
  fbI32Const(r.lrCount)
  fbStructSet(wrap, 2) // cap
  // The length is written back after the region's last statement, so one must follow it.
  if r.lrLast >= stmts.length - 1 { return 0 }
  liKinds.push(want)
  liSlots.push(row)
  liBack.push(3)
  const bSlot = listIdxScratchBase + liKinds.length
  const cSlot = strI32Slot()
  fbLocalGet(idx)
  fbStructGet(wrap, 0)
  fbLocalSet(bSlot)
  fbI32Const(0)
  fbLocalSet(cSlot)
  const reg = lbList.length
  lbList.push(idx)
  lbEnd.push(stmts[r.lrLast])
  lbBack.push(bSlot)
  lbCnt.push(cSlot)
  lbCap.push(r.lrCount)
  lbWrap.push(wrap)
  lbBackTy.push(back)
  let k = 0
  while k < r.lrPushes.length {
    lbPush.push(r.lrPushes[k])
    lbPushOf.push(reg)
    k = k + 1
  }
  return 0
}

// The receiver node of the `push` call at `callIx`.
function listPushRecv(callIx: i32): i32 {
  const n = nodeAt(callIx)
  if n is Call {
    const cf = nodeAt(unwrapParen(n.callFn))
    if cf is Member { return unwrapParen(cf.memObj) }
  }
  return -1
}

// The open build region whose counted pushes include `callIx`, or -1.
function listBuildRegionOf(callIx: i32): i32 {
  let k = lbPush.length - 1
  while k >= 0 {
    if lbPush[k] == callIx {
      const reg = lbPushOf[k]
      if lbEnd[reg] >= 0 { return reg }
      return -1
    }
    k = k - 1
  }
  return -1
}

// After statement `ix`: write back the length of every open build region it ends.
export function listBuildClose(ix: i32) {
  let reg = 0
  while reg < lbEnd.length {
    if lbEnd[reg] == ix {
      fbLocalGet(lbList[reg])
      fbLocalGet(lbCnt[reg])
      fbStructSet(lbWrap[reg], 1) // len
      lbEnd[reg] = -1
    }
    reg = reg + 1
  }
  return 0
}

// The list kind a `push` onto a local of slot kind `k` lowers at, or null for a slot that is
// not a non-null list local. The scalar lists are `scalarListElemOfListKind`'s to name.
function reserveListKindOfSlot(k: VKind): ListKind | null {
  if k == "strlist" { return "strlist" }
  if k == "reflist" { return "reflist" }
  const sk = scalarListElemOfListKind(k)
  if sk == null { return null }
  return listIdxKindOf(sk)
}

// `emitCallStmt`'s arm over a named callee `f(…)`: the call, then a `drop` unless the callee is
// void (`print`, a void intrinsic or host import, a void function or closure). Returns 0, or -1
// once failed.
function emitCallStmtIdent(s: Call, callee: Ident, stmtIx: i32, fnIx: i32) {
  // A bare call whose RESULT is discarded (a helper invoked for its side
  // effects): emit the call, then `drop` the value it leaves — EXCEPT `print`
  // (a void import) and a VOID function (`()->()` leaves nothing).
  if emitCall(stmtIx, fnIx) < 0 { return -1 }
  let dropIt = callee.identName != "print"
  // The void memory intrinsics leave nothing on the stack.
  if callee.identName == "__store_i32__" { dropIt = false }
  if nameIsMemStoreIntrinsic(callee.identName) { dropIt = false }
  if nameIsMemBulkIntrinsic(callee.identName) { dropIt = false }
  // `__store_v128__` is void (the other SIMD intrinsics leave a value the drop below wants).
  if callee.identName == "__store_v128__" { dropIt = false }
  if atomicIntrinsicIsVoid(callee.identName) { dropIt = false }
  if callee.identName == "__log__" { dropIt = false }
  // The void array intrinsics: `__array_copy__` leaves nothing; `__trap__`
  // is `unreachable` (no value reaches the drop).
  if callee.identName == "__array_copy__" { dropIt = false }
  if callee.identName == "__trap__" { dropIt = false }
  // A void HOST import leaves nothing either. Asked through the slot table rather than
  // by spelling, so a diverging slot added there cannot be missed here — every other
  // entry in this ladder is a name, and a name is what a new slot would not carry.
  if fsRetIsVoid(fsIntrinsicSlot(callee.identName)) { dropIt = false }
  if calleeIsVoidExtern(s.callFn, fnIx) { dropIt = false }
  if dropIt {
    // A name a closure binding covers denotes that binding, so the void question is the
    // closure's — the module function of the name lowered no instruction here (D1602).
    let vt = fnIndexOfNode(s.callFn)
    if vt >= 0 && identIsBoundClosure(s.callFn, fnIx) { vt = -1 }
    if vt >= 0 {
      if fRetVoid[vt] == 1 { dropIt = false }
    } else {
      // A closure-VALUE callee (a param / binding, invisible to `fnIndexOf`) whose
      // `$fnsig` is void leaves nothing — no `drop`. POSITIONED, or two sibling module
      // blocks binding one closure name resolve to no key at all (D1862).
      const cvAt = unwrapParen(s.callFn)
      if calleeReturnsVoidOfRead(cvAt, fnIx) { dropIt = false }
      // The key that lowered the call decides too, as for a member callee: a module
      // binding copying a list element of hole functions is keyed only by it (D7485).
      if dropIt && sigKeyRetIsVoid(cloCallSigKey(stmtIx, fnIx)) {
        dropIt = false
      }
    }
  }
  if dropIt {
    fbDrop() // 0x1a drop
  }
  return 0
}

function emitCallStmt(s: Call, stmtIx: i32, fnIx: i32) {
  // The only call STATEMENT this slice lowers is a list append `recv.push(x)` (a
  // `Call` whose `callFn` is a `Member`). A bare top-level call statement (a function
  // call whose value is discarded) is out of scope.
  if s.callFn < 0 { return -1 }
  const tagSet = emitTagSetAt(stmtIx, fnIx)
  const tagArms = fnTagArmsAt(stmtIx, tagSet)
  if tagArms.length > 0 {
    const dr = emitFnTagDispatch(stmtIx, tagSet, tagArms, fnIx)
    if dr < 0 { return -1 }
    if dr == 0 { fbDrop() }
    return 0
  }
  const callee = nodeAt(s.callFn)
  if callee is Member {
    // A `.push` STATEMENT discards the new length — emit the append with no value (D1592),
    // rather than emitting one and dropping it.
    if callee.memProp == "push" { return emitPush(stmtIx, fnIx, false) }
    // A `.pop()` STATEMENT discards the popped element — emit the pop, then `drop`
    // the value it leaves on the stack, unless `emitPop` answered 1 (it dropped it already).
    if callee.memProp == "pop" {
      if popRecvIsList(callee.memObj, fnIx) {
        const popR = emitPop(stmtIx, fnIx, false, -1)
        if popR < 0 { return -1 }
        if popR == 0 {
          fbDrop() // 0x1a drop
        }
        return 0
      }
    }
    // a `.clear()` statement resets the list's length to 0 (backing retained). The gate
    // carries the scalar reps alongside the i32/ref/string ones, so a `u8[]`/`i64[]`/
    // `f64[]`/`f32[]` receiver reaches `emitClear` too, matching `.pop`'s coverage via `emitPop`.
    if callee.memProp == "clear" {
      if clearRecvIsList(callee.memObj, fnIx) { return emitClear(stmtIx, fnIx) }
      if exprMap(callee.memObj, fnIx) {
        if s.callArgs.length != 0 {
          return emitFail(
            "emitProgram: internal: map clear reached with the wrong argument count — the checker's arity rule refuses it",
          )
        }
        return emitMapClear(callee.memObj, fnIx)
      }
    }
    // G8: a map `m.set(k, v)` STATEMENT is the method form of `m[k] = v` — the
    // same scan/overwrite-or-append lowering.
    if callee.memProp == "set" {
      if exprMap(callee.memObj, fnIx) {
        if s.callArgs.length != 2 {
          return emitFail(
            "emitProgram: internal: map set reached with the wrong argument count — the checker's arity rule refuses it",
          )
        }
        return emitMapSet(callee.memObj, s.callArgs[0], s.callArgs[1], fnIx)
      }
    }
    // A Set `s.add(k)` STATEMENT is the membership-insert form of `s[k] = true` — the
    // SAME scan/overwrite-or-append lowering as `emitMapSet`, but storing the constant
    // boolean `1` (true) as the value (the Set vals-list carries true for live keys).
    // It takes EXACTLY one arg; the result (if any) is discarded.
    if callee.memProp == "add" {
      if exprMap(callee.memObj, fnIx) {
        if s.callArgs.length != 1 {
          return emitFail(
            "emitProgram: internal: set add reached with the wrong argument count — the checker's arity rule refuses it",
          )
        }
        return emitMapSetV(callee.memObj, s.callArgs[0], -1, fnIx, true)
      }
    }
    // G8: a bare `m.delete(k)` STATEMENT discards the boolean result — emit the
    // delete, then `drop` the 0/1 it leaves on the stack.
    if callee.memProp == "delete" {
      if exprMap(callee.memObj, fnIx) {
        if s.callArgs.length != 1 {
          return emitFail(
            "emitProgram: internal: map delete reached with the wrong argument count — the checker's arity rule refuses it",
          )
        }
        if emitMapDelete(callee.memObj, s.callArgs[0], fnIx) < 0 { return -1 }
        fbDrop() // 0x1a drop (discard the boolean result)
        return 0
      }
    }
    // A closure-field member call STATEMENT (`(o."[]=")(k, v)` — the rewritten
    // index WRITE trap, or any function-valued field invoked for effect):
    // `call_ref` it; drop the result unless the field's function is void.
    if exprIsClosure(s.callFn, fnIx) {
      if emitCallRef(stmtIx, fnIx) < 0 { return -1 }
      // the drop decision follows the sig the call resolved (`cloCallSigKey`): a `>v`
      // key leaves nothing on the stack, so dropping is invalid wasm regardless of the
      // field's rep function. Asked first, since the rep-function fallback is wrong
      // exactly when the two disagree.
      if !fieldCallStmtVoid(stmtIx, callee, fnIx) {
        fbDrop() // 0x1a drop (discard the unused result)
      }
      return 0
    }
    // D1240 — a member call no mutator arm claimed is a discarded value, the same rule
    // the `Ident` arm below applies to `f(…)`. General rather than a per-method gate:
    // `xs.slice(0, 2)` has an expression form but the statement ladder had no route to it.
    if emitExpr(stmtIx, fnIx) < 0 { return -1 }
    if memberCallYieldsValue(stmtIx) {
      fbDrop() // 0x1a drop
    }
    return 0
  }
  if callee is Ident { return emitCallStmtIdent(s, callee, stmtIx, fnIx) }
  // A closure-VALUE callee neither a member nor a name, in genuine statement position:
  // `call_ref` it and drop what its own `$fnsig` leaves — nothing for a `>v` key. A resolved
  // valued key is one `stmtIsTailValue` would have claimed as a tail, so reaching here means a
  // discarded result; only an unresolved key refuses (D2111).
  if exprIsClosure(s.callFn, fnIx) {
    const csKey = cloCallSigKey(stmtIx, fnIx)
    if sigKeyRetIsVoid(csKey) { return emitCallRef(stmtIx, fnIx) }
    if csKey != "" {
      if emitCallRef(stmtIx, fnIx) < 0 { return -1 }
      fbDrop() // 0x1a drop (discard the unused result)
      return 0
    }
    return emitFail(
      "emitProgram: a function-value call statement yields a value the tail-value ladder did not claim",
    )
  }
  return emitFail(
    "emitProgram: a call statement's callee is neither a name, a member, nor a function value",
  )
}

// The compile-time value of an `if` condition that is a monomorphized-instance guard testing a
// record, named or spelled (1/0), or -1 otherwise: the receiver must be a bare ident and the
// pattern's own type a record (D15257), and a nullable-struct receiver is a runtime test.
function monoStaticIsGuardOf(condIx: i32, fnIx: i32) {
  const c = nodeAt(condIx)
  if c is IsExpr {
    const recv = nodeAt(unwrapParen(c.isObj))
    if !(recv is Ident) { return -1 }
    const pt = isPatTyIxOf(condIx)
    if pt < 0 || !(tyAt(pt) is TyObj) { return -1 }
    if exprNullableStruct(c.isObj, fnIx) { return -1 }
    return monoStaticIsResult(condIx, fnIx)
  }
  return -1
}

// The first of the `n` consecutive slots the declaration at `declIx` owns: the slot the collect
// walk pinned to its node when it sits in an expression-position if-expression, else the next
// `n` cursor positions, stepping over every position such a declaration owns (D2785).
function declSlotTake(declIx: i32, n: i32): i32 {
  const pinned = declSlotPinned(declIx)
  if pinned >= 0 { return pinned }
  if localByNode.length > 0 { cursorSkipByNode() }
  const first = emitLetCursor
  emitLetCursor = emitLetCursor + n
  return first
}

// Step `emitLetCursor` past the positions a by-node declaration owns (`localByNode`).
function cursorSkipByNode() {
  while emitLetCursor < localByNode.length && localByNode[emitLetCursor] == 1 {
    emitLetCursor = emitLetCursor + 1
  }
  return 0
}

// Advance `emitLetCursor` over `n` cursor-owned positions, as a skipped subtree's declarations
// would have taken them one by one.
function cursorAdvance(n: i32) {
  let k = 0
  while k < n {
    cursorSkipByNode()
    emitLetCursor = emitLetCursor + 1
    k = k + 1
  }
  return 0
}

// D932 — the `emitLetCursor` positions that emitting the subtree at `ix` would consume. A
// dead-arm skip is a control-flow change the locals layout never hears about, since
// `collectLocals` allocates slots in pre-order over the whole body; every skip below must
// advance the cursor by this count. A `FuncDecl` subtree contributes nothing — its own body owns its own frame.
function cursorSlotsUnder(ix: i32): i32 {
  if ix < 0 { return 0 }
  const n = nodeAt(ix)
  if n is FuncDecl { return 0 }
  let cnt = 0
  if n is LetDecl { cnt = 1 }
  if n is ForRange { cnt = 2 }
  if n is ForIn { cnt = 3 }
  // A declaration found by node took no cursor position.
  if declSlotPinned(ix) >= 0 { cnt = 0 }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      cnt = cnt + cursorSlotsUnder(kids[i])
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  return cnt
}

// D932 — did the condition emitted since `condStart` fold to a constant? 1/0, or -1
// for any runtime test. Read off the bytes the module actually carries, not a parallel
// predicate — a second derivation of "did it fold" is exactly the drift that let
// `monoStaticIsResult`'s direct answer disagree with the emitted condition.
function emittedCondConst(condStart: i32): i32 {
  if wLen() != condStart + 2 { return -1 }
  if wPeekBack(1) != 65 {
    return -1 // 0x41 i32.const
  }
  const cb = wPeekBack(0)
  if cb == 0 { return 0 }
  if cb == 1 { return 1 }
  return -1
}

// Whether statement condition `condIx` is a box `is` test `tagIsArmOf` answers `tagAbsent`, a
// decided `false` that reads nothing: asked in storage mode when its receiver is narrowed, past
// the checks `emitIs` makes first. The IR's builder asks the same.
export function isDecidedFalse(condIx: i32, fnIx: i32): boolean {
  const ix = unwrapParen(condIx)
  const n = if ix >= 0 { nodeAt(ix) } else { null }
  if !(n is IsExpr) || n.isFit >= 0 { return false }
  const stored = isTestsStorage(n.isObj, fnIx)
  if !stored && !isBoxGuardPlain(ix, fnIx) { return false }
  const mark = if stored { storageReadEnter(n.isObj) } else { -1 }
  const r = isRecvStageRep(ix, fnIx) < 0
    && isArmOf(ix, fnIx, 0, false) == "armTag"
    && tagIsArmOf(ix, n, fnIx) == "tagAbsent"
  if stored { storageReadLeave(mark) }
  return r
}

// A statement `if`'s condition `condIx` written, and its decided constant (`staticIsGuard`), or
// -2 once failed. A decided `false` (`isDecidedFalse`) is written as itself, `i32.const 0`.
function emitGuardCond(condIx: i32, fnIx: i32): i32 {
  if isDecidedFalse(condIx, fnIx) {
    fbI32Const(0)
    return 0
  }
  const condStart = wLen()
  if emitCondExpr(condIx, fnIx) < 0 { return -2 }
  return staticIsGuard(condIx, condStart)
}

// `emittedCondConst` of an `is` test `condIx`, or its `!`, emitted since `condStart`, or -1 for
// any other condition: an instance decides its own `is` tests, so one arm can be dead there.
function staticIsGuard(condIx: i32, condStart: i32): i32 {
  if condIx < 0 { return -1 }
  const c = nodeAt(unwrapParen(condIx))
  if c is Unary {
    if c.unOp != "!" { return -1 }
    if !(nodeAt(unwrapParen(c.unArg)) is IsExpr) { return -1 }
    return emittedCondConst(condStart)
  }
  if !(c is IsExpr) { return -1 }
  return emittedCondConst(condStart)
}

// `staticIsGuard` for a value `if`, which a literal `true` also decides: its else arm is dead, so
// a rewrite's `if true { <spills> v } else { <placeholder> }` never lowers the placeholder.
function staticValueIfCond(condIx: i32, condStart: i32): i32 {
  if valueIfLitTrue(condIx) { return 1 }
  return staticIsGuard(condIx, condStart)
}

// Whether a value `if`'s condition is the literal `true`, which decides its block `else` dead.
export function valueIfLitTrue(condIx: i32): boolean {
  const c = if condIx >= 0 { nodeAt(unwrapParen(condIx)) } else { null }
  return c is BoolLit && c.boolVal == 1
}

// A value arm this instance's `is` test proved dead: `unreachable` meets any blocktype, and
// its lets keep their slots (D932). Lowered, it would read its value at the arm's own type.
function emitDeadValueArm(blockIx: i32): i32 {
  cursorAdvance(cursorSlotsUnder(blockIx))
  fbUnreachable()
  return 0
}

// The dual of `emitIfStmtStmt`'s dead-arm skip: a statement `if` whose mono-instance
// `is` guard is statically true and whose then-branch always exits ends the block for
// this instance, since everything after it is typed against other instances' bindings
// and generally unable to lower. The caller pads with `unreachable` to stay stack-polymorphic.
function monoStaticGuardEndsBlock(stmtIx: i32, fnIx: i32) {
  const s = nodeAt(stmtIx)
  if !(s is IfStmt) { return false }
  const k = if negGuardDecidedTrue(s.ifCond, fnIx) { 1 } else { -1 }
  return guardEndsBlockWith(stmtIx, k, fnIx)
}

// Whether statement `if` `ifIx`, its condition written as constant `k` (-1 for none), ends its
// block: a `!is` decided true, or a record guard the instance decides true, over an always-exiting
// then arm. The rest of the block is then cut behind an `unreachable` (D932).
export function guardEndsBlockWith(ifIx: i32, k: i32, fnIx: i32): boolean {
  const s = nodeAt(ifIx)
  if !(s is IfStmt) { return false }
  const c = nodeAt(unwrapParen(s.ifCond))
  const negTrue = k == 1 && c is Unary && c.unOp == "!"
  if !negTrue && monoStaticIsGuardOf(s.ifCond, fnIx) != 1 { return false }
  return stmtAlwaysExits(s.ifThen)
}

// The function, condition node and emitted constant (`staticIsGuard`) of the most recently
// lowered statement `if`: the enclosing block asks whether that guard is decided.
let negGuardFn = -1
let negGuardCond = -1
let negGuardVal = -1

// Whether `condIx` is a `!is` the statement `if` just lowered decided true: the instance's pin
// cannot hold the tested type, so a tail after an exiting arm reads it at that type (D2957).
function negGuardDecidedTrue(condIx: i32, fnIx: i32): boolean {
  if condIx < 0 || condIx != negGuardCond || negGuardVal != 1 { return false }
  if fnIx != negGuardFn { return false }
  const c = nodeAt(unwrapParen(condIx))
  if c is Unary { return c.unOp == "!" }
  return false
}

// ── a dense integer `match` as a `br_table` (PL-001) ─────────────────────────
// The chain an integer `match` desugared to (`intMatchHeadAt`) lowers to one `br_table` over
// nested blocks when its literal set is dense: at least 3 distinct values spanning fewer than
// `2 * values + 8`; the rule is match-design.md §"A dense integer match is a `br_table`".

// The value of integer pattern `patIx` (a `NumLit`, `-` over one, or a `const` arm read of
// either) as a 64-bit pair pushed onto `out` as hi then lo; false for any other node.
function switchLitPair(patIx: i32, out: i32[]) {
  const lit = matchConstPatLitAt(patIx)
  if lit >= 0 { return switchLitPair(lit, out) }
  let numIx = patIx
  let neg = false
  const p = nodeAt(patIx)
  if p is Unary {
    if p.unOp != "-" { return false }
    numIx = p.unArg
    neg = true
  }
  if numIx < 0 { return false }
  const n = nodeAt(numIx)
  if n is NumLit {
    if numLexIsFloat(n.numText) { return false }
    const pr = parseI64Pair(n.numText)
    let hi = pr[0]
    let lo = pr[1]
    if neg {
      let carry = 0
      if lo == 0 { carry = 1 }
      lo = 0 - lo
      hi = (hi ^ -1) + carry
    }
    out.push(hi)
    out.push(lo)
    return true
  }
  return false
}

// Collects arm `arm`'s case values from its condition — `scrut == lit`, or an `||` tree of
// them over the SAME scrutinee node — into `vals`/`arms`; false on any other shape. A value
// that is not a sign-extended `i32` declines, so every table key fits in an `i32`.
function switchCondCollect(
  condIx: i32,
  scrutIx: i32,
  arm: i32,
  vals: i32[],
  arms: i32[],
) {
  const c = nodeAt(condIx)
  if c is BinExpr {
    if c.binOp == "||" {
      if !switchCondCollect(c.binLeft, scrutIx, arm, vals, arms) {
        return false
      }
      return switchCondCollect(c.binRight, scrutIx, arm, vals, arms)
    }
    if c.binOp == "==" && c.binLeft == scrutIx {
      const pr: i32[] = []
      if !switchLitPair(c.binRight, pr) { return false }
      if pr[0] != (pr[1] >> 31) { return false }
      vals.push(pr[1])
      arms.push(arm)
      return true
    }
  }
  return false
}

// The scrutinee node of the chain condition `condIx` — the left operand of its leftmost
// `==` — or -1 when the condition is not an `==`/`||` tree.
function switchScrutOf(condIx: i32) {
  let at = condIx
  while at >= 0 {
    const c = nodeAt(at)
    if c is BinExpr {
      if c.binOp == "==" { return c.binLeft }
      if c.binOp != "||" { return -1 }
      at = c.binLeft
    } else {
      return -1
    }
  }
  return -1
}

// The scrutinee's width for a `br_table`: 1 for a plain `i32` place, 2 for a plain `i64` one,
// 0 when the chain stays — not an `Ident`, a union box, an atom, a float, or no recorded type.
function switchScrutWidth(scrutIx: i32, fnIx: i32) {
  if scrutIx < 0 { return 0 }
  if !(nodeAt(scrutIx) is Ident) { return 0 }
  const w = nodeTyIntWidth(scrutIx)
  if w == 0 { return 0 }
  if exprUnion(scrutIx, fnIx) || exprIsLitAtom(scrutIx, fnIx) { return 0 }
  if exprIsF64(scrutIx, fnIx) || exprIsF32(scrutIx, fnIx) { return 0 }
  if (w == 2) != exprIsI64(scrutIx, fnIx) { return 0 }
  return w
}

// One arm body of a switch in `mode`: 0 statement, 1 function tail, 2 scalar value of
// blocktype `kind`, 3 ref value of `rk`/`slot`.
function emitSwitchArm(
  blk: i32,
  fnIx: i32,
  mode: i32,
  kind: i32,
  rk: VKind,
  slot: i32,
) {
  if mode == 2 { return emitBlockValueAs(blk, fnIx, kind) }
  if mode == 3 { return emitRefIfArm(blk, fnIx, rk, slot, false) }
  if blk < 0 || blk >= P.nodes.length {
    return emitFail("emitProgram: a match arm has no body")
  }
  const b = nodeAt(blk)
  if b is Block {
    if mode == 1 { return emitStmtsTail(blk, fnIx) }
    return emitStmts(blk, fnIx)
  }
  if mode == 1 { return emitStmtTail(blk, fnIx) }
  return emitStmt(blk, fnIx)
}

// Whether `emitIntSwitch` may lower the chain at `ix` as a `br_table`: it may still decline, so
// a builder that writes chains leaves every such link to legacy.
export function intSwitchMayLower(ix: i32): boolean {
  return intMatchHeadAt(ix)
}

// Lowers the integer-`match` chain headed at `headIx` as a `br_table` in `mode` (see
// `emitSwitchArm`): 1 when lowered, 0 when it declined having written nothing, -1 on an emit
// failure. Arms are emitted in chain order — the collect pass's — so the let cursor stays in step.
function emitIntSwitch(
  headIx: i32,
  fnIx: i32,
  mode: i32,
  kind: i32,
  rk: VKind,
  slot: i32,
) {
  if !intMatchHeadAt(headIx) { return 0 }
  const vals: i32[] = []
  const arms: i32[] = []
  const thens: i32[] = []
  let scrutIx = -1
  let cur = headIx
  let elseBlk = -1
  let walking = true
  while walking {
    const s = nodeAt(cur)
    if s is IfStmt {
      if scrutIx < 0 { scrutIx = switchScrutOf(s.ifCond) }
      if scrutIx < 0 { return 0 }
      if !switchCondCollect(s.ifCond, scrutIx, thens.length, vals, arms) {
        return 0
      }
      thens.push(s.ifThen)
      const next = s.ifElse
      let more = false
      if next >= 0 {
        if nodeAt(next) is IfStmt { more = !intMatchHeadAt(next) }
      }
      if more {
        cur = next
      } else {
        elseBlk = next
        walking = false
      }
    } else {
      return 0
    }
  }
  const w = switchScrutWidth(scrutIx, fnIx)
  if w == 0 { return 0 }
  if elseBlk < 0 && mode >= 2 { return 0 }
  const m = thens.length
  let lo = vals[0]
  let hi = vals[0]
  let i = 1
  while i < vals.length {
    if vals[i] < lo { lo = vals[i] }
    if vals[i] > hi { hi = vals[i] }
    i = i + 1
  }
  // `hi - lo` wraps negative exactly when the true span passes 2^31, which is never dense.
  const span = hi - lo
  if span < 0 || span >= 2 * vals.length + 8 { return 0 }
  // A repeated value keeps its FIRST arm, as the chain's first passing test does.
  const table: i32[] = []
  let t = 0
  while t <= span {
    table.push(m)
    t = t + 1
  }
  let distinct = 0
  i = 0
  while i < vals.length {
    const at = vals[i] - lo
    if table[at] == m {
      table[at] = arms[i]
      distinct = distinct + 1
    }
    i = i + 1
  }
  if distinct < 3 || span >= 2 * distinct + 8 { return 0 }
  // The outer frame carries the value in the value modes; every inner frame is void.
  fbOpenBlock() // 0x02 block
  if mode == 3 { fbValtype(rk, slot) }
  else if mode == 2 { wU8(kind) }
  else { wU8(64) }
  const endDepth = ctrlDepth
  fbBlock(64) // the else arm's frame, the `br_table` default
  let k = 0
  while k < m {
    fbBlock(64)
    k = k + 1
  }
  if emitCondExpr(scrutIx, fnIx) < 0 { return -1 }
  if w == 2 {
    // An i64 index `d = s - lo` is in range iff `d <u span + 1`; out of range selects the
    // default slot `span + 1`, so no 64-bit value can wrap onto a case.
    fbI64Const(lo >> 31, lo)
    fbI32Bin(125) // 0x7d i64.sub
    fbI32WrapI64()
    fbI32Const(span + 1)
    if emitCondExpr(scrutIx, fnIx) < 0 { return -1 }
    fbI64Const(lo >> 31, lo)
    fbI32Bin(125) // 0x7d i64.sub
    fbI64Const(0, span + 1)
    fbI32Bin(84) // 0x54 i64.lt_u
    fbSelect()
  } else if lo != 0 {
    // i32 subtraction wraps mod 2^32 and `br_table` reads its index unsigned, so `s - lo`
    // lands in `[0, span]` exactly when `s` is in `[lo, hi]`.
    fbI32Const(lo)
    fbI32Bin(107) // 0x6b i32.sub
  }
  wU8(14) // 0x0e br_table
  wULEB(span + 1)
  t = 0
  while t <= span {
    wULEB(table[t])
    t = t + 1
  }
  wULEB(m) // default: the else arm's frame
  k = 0
  while k < m {
    fbEnd()
    if emitSwitchArm(thens[k], fnIx, mode, kind, rk, slot) < 0 { return -1 }
    fbBr(ctrlDepth - endDepth)
    k = k + 1
  }
  fbEnd()
  if elseBlk >= 0 {
    if emitSwitchArm(elseBlk, fnIx, mode, kind, rk, slot) < 0 { return -1 }
  }
  fbEnd()
  return 1
}

// Closes the frames an `else if` chain's links left open, innermost-first, as the recursive
// emitters' unwinding did, one per `open` entry: only when `rc` is not a failure, each writes
// its `end` and marks the join unreachable when every arm exited. Returns `rc`.
function closeIfChainFrames(open: i32[], rc: i32, unreachable: boolean) {
  let k = open.length
  while k > 0 {
    k = k - 1
    if rc >= 0 {
      fbEnd() // 0x0b end
      if unreachable { fbUnreachable() }
    }
  }
  return rc
}

function emitIfStmtStmt(stmtIx: i32, fnIx: i32) {
  // An `else if` chain is lowered along its spine, so its depth costs no stack (D1990): a link
  // whose else is the next link leaves its `if` frame open, and the open frames close
  // innermost-first once the chain's last arm is emitted. Each entry is one open frame.
  const open: i32[] = []
  // A chain ending a void body is in tail position in every arm (D4681).
  const tail = stmtIx >= 0 && stmtIx == voidTailAt
  let cur = stmtIx
  while cur >= 0 {
    const at = cur
    cur = -1
    // `emitStmt`'s entry guard, for every link after the first.
    if at != stmtIx && emitFailed { return -1 }
    const s = nodeAt(at)
    if s is IfStmt {
      const sw = emitIntSwitch(at, fnIx, 0, 64, "i32", -1)
      if sw < 0 { return -1 }
      if sw == 0 {
        const rc = emitIfLinkStmt(s, fnIx, open, tail)
        if rc < 0 { return -1 }
        if rc == 1 { cur = s.ifElse }
      }
    }
  }
  return closeIfChainFrames(open, 0, false)
}

// One link of `emitIfStmtStmt`'s chain. Returns 0 with its frame closed, -1 on failure, or 1
// when its else is another `if`: the frame is left open and its else narrowing's restore
// target (-1 when the else did not narrow) is pushed onto `open`.
function emitIfLinkStmt(s: IfStmt, fnIx: i32, open: i32[], tail: boolean) {
  // A-exhaust: the LAST arm of a chain the checker PROVED exhaustive is reached only when its
  // test holds, so it lowers as the bare `else` — no comparison, no `if` frame. The narrowing
  // still runs, since the arm reads its own member's fields (`condProvenTrue`).
  if s.ifElse < 0 && condProvenTrue(s.ifCond) {
    const pgRc = emitTailArm(s.ifThen, fnIx, tail)
    return pgRc
  }
  // A bare `{ … }` (lowered to `if true`) and a written `if true` run their arm
  // unconditionally, so they lower inline with no frame: binaryen's code-pushing re-walks the
  // rest of a block for every `if`, and a translated unit holds thousands of these. D2335.
  if s.ifElse < 0 && condLitTrue(s.ifCond) {
    return emitTailArm(s.ifThen, fnIx, tail)
  }
  // structured void `if`: push the i32 condition, then `if`/`else`/`end`. A
  // monomorphized-instance `is` guard is decided at compile time, so one arm can be
  // provably unreachable in this instance and is emitted empty instead (D932).
  const staticGuard = emitGuardCond(s.ifCond, fnIx)
  if staticGuard == -2 { return -1 }
  negGuardFn = fnIx
  negGuardCond = s.ifCond
  negGuardVal = staticGuard
  fbIf(64) // 0x04 if, 0x40 void blocktype
  // If the condition is `n is Variant` over a bare union identifier, narrow `n` to
  // that variant for the THEN-branch only (so `n.field` downcasts). Save/restore the
  // outer narrowing around the branch so nesting and the else-branch are unaffected.
  if ifThenIsDead(s) {
    // A covering test's dead arm is not collected, so it owns no slots (D16006).
    fbUnreachable()
  } else if staticGuard != 0 {
    if emitTailArm(s.ifThen, fnIx, tail) < 0 { return -1 }
  } else {
    // D932 — the skipped arm's `let`s still own their collect-allocated slots.
    cursorAdvance(cursorSlotsUnder(s.ifThen))
  }
  if s.ifElse >= 0 && !ifWritesElse(s) {
    // The dead `else` arm: uncollected, so neither emitted nor counted (D16006).
  } else if s.ifElse >= 0 && staticGuard != 1 {
    fbElse() // 0x05 else
    // The then narrowing does not hold in the else-branch, where the guard is false: a value
    // union narrows to the complement set instead (`is T` removes `T`).
    const els = nodeAt(s.ifElse)
    if els is IfStmt {
      open.push(-1)
      return 1
    }
    if els is Block {
      if emitTailArm(s.ifElse, fnIx, tail) < 0 { return -1 }
    } else {
      if emitStmt(s.ifElse, fnIx) < 0 { return -1 }
    }
  } else if s.ifElse >= 0 {
    // D932 — the statically-dead else arm, same slot accounting as the then skip.
    cursorAdvance(cursorSlotsUnder(s.ifElse))
  }
  fbEnd() // 0x0b end
  return 0
}

// The statement ending the void function being emitted, or -1: nothing runs after it, so an
// `if` there is in tail position in every arm, as is the last statement of each arm.
let voidTailAt = -1

// `emitStmts` on an `if` arm; when the `if` is in tail position, the arm's last statement is
// too, and a call the arm ends with becomes a tail call (D4681).
function emitTailArm(blockIx: i32, fnIx: i32, tail: boolean) {
  if !tail || blockIx < 0 || blockIx >= P.nodes.length {
    return emitStmts(blockIx, fnIx)
  }
  const b = nodeAt(blockIx)
  let last = -1
  if b is Block {
    if b.blkStmts.length > 0 { last = b.blkStmts[b.blkStmts.length - 1] }
  }
  voidTailAt = last
  const rc = emitStmts(blockIx, fnIx)
  voidTailAt = -1
  if rc < 0 { return -1 }
  emitVoidTailCall(fnIx)
  return 0
}

function emitWhileStmtStmt(s: WhileStmt, stmtIx: i32, fnIx: i32) {
  if s.whileBlk == 1 { return emitLabelBlock(s, stmtIx, fnIx) }
  return emitWhileLoop(s, stmtIx, fnIx)
}

// A labelled block: one `block` frame a `break` leaves. It takes no `continue`, so a bare one
// inside it still finds the loop around it. A non-null value types the frame (`lvFrameOpen`):
// a tail assigned to the result binding falls out with it, and any other end is unreachable.
function emitLabelBlock(s: WhileStmt, _stmtIx: i32, fnIx: i32) {
  const lv = lvFrameOpen(s, fnIx)
  if lv < 0 { return -1 }
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.whileLabel)
  const rc = emitStmts(s.whileBody, fnIx)
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  if rc < 0 { return -1 }
  if lv == 1 {
    if lvTailAssigns(s) {
      fbLocalGet(lvFrameLocal[lvFrameLocal.length - 1])
    } else {
      fbUnreachable()
    }
  }
  return lvFrameClose(lv)
}

// Opens the break frame of the `while` or labelled block `s`: typed by its result binding's
// valtype when a non-null value leaves by `br` (1), else void (0); -1 on failure.
function lvFrameOpen(s: WhileStmt, fnIx: i32): i32 {
  if s.whileLv < 0 {
    fbBlock(64) // 0x02 block, 0x40 void blocktype
    return 0
  }
  const slot = declaredSlotOfDecl(s.whileLv)
  if slot < 0 || slot >= localIsRef.length {
    emitFail("emitProgram: a loop value's result binding has no local")
    return -1
  }
  fbOpenBlock()
  fbValtype(localIsRef[slot], localStructIdx[slot])
  lvFrameDepth.push(ctrlDepth)
  lvFrameLocal.push(declaredIndexAt(fnIx, slot))
  return 1
}

// Closes the frame `lvFrameOpen` returned `lv` for; a typed one stores the value it carries
// out into the result binding, which initializes that binding at the enclosing level.
function lvFrameClose(lv: i32) {
  fbEnd()
  if lv == 1 {
    lvFrameDepth.pop()
    fbLocalSet(lvFrameLocal[lvFrameLocal.length - 1])
    lvFrameLocal.pop()
  }
  return 0
}

// Whether the labelled block `s` ends by assigning its tail to its result binding.
function lvTailAssigns(s: WhileStmt): boolean {
  const b = nodeAt(s.whileBody)
  if b is Block {
    const n = b.blkStmts.length
    if n == 0 { return false }
    const a = nodeAt(b.blkStmts[n - 1])
    if a is BinExpr {
      if a.binOp != "=" { return false }
      const t = nodeAt(a.binLeft)
      if t is Ident {
        const slot = declaredSlotOfDecl(s.whileLv)
        return slot >= 0 && declaredSlotOf(a.binLeft) == slot
      }
    }
  }
  return false
}

function emitWhileLoop(s: WhileStmt, _stmtIx: i32, fnIx: i32) {
  // structured while loop: block (void) wrapping a loop (void). The condition is
  // checked at the top; if false, exit the block; otherwise run the body then continue
  // the loop. Track the two control frames so break/continue compute their relative br
  // depth. The list-header hoists open before the block, since a loop that never iterates leaves them unread.
  const whHoist = loopHoistOpen(s.whileCond, s.whileBody, fnIx, -1, -1)
  if whHoist < 0 { return -1 }
  const whLv = lvFrameOpen(s, fnIx)
  if whLv < 0 { return -1 }
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.whileLabel)
  fbLoop(64) // 0x03 loop, 0x40 void blocktype
  loopContDepth.push(ctrlDepth)
  loopContLabel.push(s.whileLabel)
  // condition + eqz: if condition is false (zero), exit block. A literal `true` never exits,
  // so it writes no test at all.
  if !condLitTrue(s.whileCond) {
    if emitExpr(s.whileCond, fnIx) < 0 { return -1 }
    fbI32Eqz() // 0x45 i32.eqz (invert: exit if condition was false)
    fbBrIf(1)  // 0x0d br_if, depth 1 = break out of block
  }
  // body statements
  if emitStmts(s.whileBody, fnIx) < 0 { return -1 }
  fbBr(0) // 0x0c br, depth 0 = continue loop
  fbEnd() // 0x0b end (loop)
  loopContDepth.pop()
  loopContLabel.pop()
  // A typed frame is left only by a `break v`, so falling out of the loop cannot happen.
  if whLv == 1 { fbUnreachable() }
  lvFrameClose(whLv) // 0x0b end (block)
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  loopHoistClose(whHoist)
  return 0
}

function emitForRangeStmt(s: ForRange, stmtIx: i32, fnIx: i32) {
  // `for v in A to B [step K] { body }` — a numeric range, lowered to the same block/loop
  // shape as `while`: the loop var and a bound temp take the next two cursor slots, a
  // non-constant step a third (evaluated once). The step's sign picks the exit test (dynamic
  // via `select`); `frExcl` (`until`) makes it strict — `v < B` not `v <= B`, so `0 until 0` is empty.
  const dynStep = !forRangeStepIsConst(s.frStep)
  let nSlots = 2
  if dynStep { nSlots = 3 }
  const vSlot = declSlotTake(stmtIx, nSlots)
  const bSlot = vSlot + 1
  let sSlot = -1
  if dynStep { sSlot = vSlot + 2 }
  let paramN = 0
  if fnIx >= 0 {
    const fn = nodeAt(fnIx)
    if fn is FuncDecl { paramN = fn.fnParams.length + envSlotShift(fnIx) }
  }
  const vIdx = paramN + vSlot
  const bIdx = paramN + bSlot
  const sIdx = paramN + sSlot
  // A static step is absent (+1), an integer literal or a negated one (`forRangeStepIsConst`).
  // The lexeme must fit i32 before the `parseI32` fold, a negated 2^31 included; the checker
  // refuses an out-of-range step, so the refusals here are backstops.
  let stepK = 1
  if s.frStep >= 0 && !dynStep {
    const litIx = cexLitPeel(s.frStep)
    const neg = intLitIsNegated(s.frStep)
    let folded = false
    if litIx >= 0 {
      const lit = nodeAt(litIx)
      if lit is NumLit {
        const t = lit.numText
        const fits = numLexFitsI32(t) || (neg && numLexIs2Pow31(t))
        if numLexIsFloat(t) || !fits {
          return emitFail(
            "emitProgram: for-range step must be an i32 integer literal",
          )
        }
        stepK = parseI32(t)
        if neg { stepK = 0 - stepK }
        folded = true
      }
    }
    if !folded {
      return emitFail("emitProgram: for-range step must be a constant integer")
    }
  }
  if !dynStep && stepK == 0 {
    return emitFail("emitProgram: for-range step must not be zero")
  }
  // v = A; bound = B (each evaluated once, in source order). A constant bound is compared as
  // the constant itself, so no local carries it and every test reads an immediate.
  const bConst = rangeConstIs(s.frTo, fnIx)
  let bVal = 0
  if bConst { bVal = rangeConstVal(s.frTo, fnIx) }
  if emitExpr(s.frFrom, fnIx) < 0 { return -1 }
  fbLocalSet(vIdx)
  if !bConst {
    if emitExpr(s.frTo, fnIx) < 0 { return -1 }
    fbLocalSet(bIdx)
  }
  if dynStep {
    if emitExpr(s.frStep, fnIx) < 0 { return -1 }
    fbLocalSet(sIdx)
  }
  // The hoist prologue runs AFTER the range bounds (whose expressions may do
  // anything) and BEFORE the loop variable is bound, so its receiver reads
  // resolve in the enclosing scope. `frVar` itself is never a candidate — the
  // body sees it as a fresh i32 binding.
  const frHoist = loopHoistOpen(-1, s.frBody, fnIx, stmtIx, -1)
  if frHoist < 0 { return -1 }
  const frProof = rangeProofOpen(s, stmtIx, stepK, dynStep)
  // Bind the loop var for the body (mirrors the collect pass's scopeBind).
  scopeBind(s.frVar, vSlot)
  // The arm is the one decision the IR reads too (`forRangeArm`).
  const arm = forRangeArm(s, stmtIx, fnIx)
  let rc = 0
  if arm == "unrolled" {
    const plan = forRangeUnrollPlan(s, stmtIx, fnIx)
    rc = emitRangeUnrolled(s, fnIx, vIdx, plan[0], plan[1], plan[2])
  } else {
    const rt: RangeTest = {
      vIdx: vIdx,
      bIdx: bIdx,
      bConst: bConst,
      bVal: bVal,
      sIdx: sIdx,
      dynStep: dynStep,
      stepK: stepK,
      excl: s.frExcl,
    }
    const wraps = rangeMayWrap(s, rt)
    if arm == "partial" {
      rc = emitRangePartial(s, fnIx, rt, wraps)
    } else {
      rc = emitRangeRolled(s, fnIx, rt, wraps)
    }
  }
  loopHoistClose(frHoist)
  rangeProofClose(frProof)
  // The loop variable's scope is the loop (see `scopeUnbind`).
  scopeUnbind()
  return rc
}

// The arm `emitForRangeStmt` writes range loop `s` (statement `stmtIx` of `fnIx`) in, the one
// decision legacy and the IR both read: "unrolled" for its copies (`forRangeUnrollPlan`, a
// getter's constant range included), "partial" for the 4x main loop, else "rolled".
export function forRangeArm(s: ForRange, stmtIx: i32, fnIx: i32): string {
  if forRangeUnrollPlan(s, stmtIx, fnIx).length == 3 { return "unrolled" }
  const dyn = !forRangeStepIsConst(s.frStep)
  const k = if dyn { 1 } else { forRangeStaticStep(s) }
  if rangePartialUnrollOk(s, k, dyn, fnIx) { return "partial" }
  return "rolled"
}

// Legacy's full unroll of range loop `s` (statement `stmtIx` of `fnIx`): its first value, its
// step and its trip count; none for a loop it does not unroll. A getter's constant range is
// always unrolled, so its lowering holds no loop (§D3a).
export function forRangeUnrollPlan(s: ForRange, stmtIx: i32, fnIx: i32): i32[] {
  const none: i32[] = []
  const g = getterRangeTrips(stmtIx, fnIx)
  if g >= 0 {
    const parts = constRangeParts(stmtIx)
    return [parts[0], parts[2], g]
  }
  if !forRangeStepIsConst(s.frStep) { return none }
  const k = forRangeStaticStep(s)
  if k == 0 || !rangeConstIs(s.frFrom, fnIx) || !rangeConstIs(s.frTo, fnIx) {
    return none
  }
  const a = rangeConstVal(s.frFrom, fnIx)
  const t = rangeUnrollTrips(s, a, rangeConstVal(s.frTo, fnIx), k, fnIx)
  return if t > 0 { [a, k, t] } else { none }
}

// What keeps a range loop of arm "rolled" from the IR: a dynamic step, a wrap exit
// (`rangeMayWrap`), or a hoist or range proof legacy may open. Those two read only the tree, not
// the live rows `loopHoistOpen` and `rangeProofOpen` consult at emit time, since a claim is decided
// before legacy writes the function; each answers yes wherever legacy might. "" for none.
export function forRangeRolledBlock(
  s: ForRange,
  stmtIx: i32,
  fnIx: i32,
): string {
  if !forRangeStepIsConst(s.frStep) { return "dynamic step" }
  const k = forRangeStaticStep(s)
  if k == 0 { return "step" }
  if loopHoistCands(-1, s.frBody, fnIx, stmtIx, -1).length > 0 {
    return "hoisted"
  }
  if (
    k > 0
    && exprIsNonNegIntLit(s.frFrom)
    && hoistPathDecl(rangeTopLenOf(s)) >= 0
  ) {
    return "proven"
  }
  const bConst = rangeConstIs(s.frTo, fnIx)
  const rt: RangeTest = {
    vIdx: -1,
    bIdx: -1,
    bConst: bConst,
    bVal: if bConst { rangeConstVal(s.frTo, fnIx) } else { 0 },
    sIdx: -1,
    dynStep: false,
    stepK: k,
    excl: s.frExcl,
  }
  if rangeMayWrap(s, rt) { return "wrap exit" }
  return ""
}

// The static step of range loop `s`: 1 when it has none, else its folded integer literal; 0 when
// none folds into an `i32`, a step the checker refuses.
export function forRangeStaticStep(s: ForRange): i32 {
  if s.frStep < 0 { return 1 }
  const litIx = cexLitPeel(s.frStep)
  if litIx < 0 { return 0 }
  const lit = nodeAt(litIx)
  if !(lit is NumLit) { return 0 }
  const t = lit.numText
  const neg = intLitIsNegated(s.frStep)
  if numLexIsFloat(t) || !(numLexFitsI32(t) || neg && numLexIs2Pow31(t)) {
    return 0
  }
  const k = parseI32(t)
  return if neg { 0 - k } else { k }
}

// A range loop's continue test, its operands resolved: the loop var's local, the bound's local
// or constant, and the step's local or constant. `excl` is the half-open `until`.
type RangeTest = {
  vIdx: i32,
  bIdx: i32,
  bConst: boolean,
  bVal: i32,
  sIdx: i32,
  dynStep: boolean,
  stepK: i32,
  excl: boolean,
}

// Pushes the i32 "`v` is still in range". A dynamic step picks the direction with a `select`,
// and a zero step makes the loop empty, the answer a backwards constant range already gives.
function emitRangeTest(rt: RangeTest) {
  let ascCmp = 76 // 0x4c i32.le_s
  let descCmp = 78 // 0x4e i32.ge_s
  if rt.excl {
    ascCmp = 72  // 0x48 i32.lt_s — half-open ascending
    descCmp = 74 // 0x4a i32.gt_s — half-open descending
  }
  if rt.dynStep {
    fbLocalGet(rt.vIdx)
    emitRangeBound(rt)
    fbI32Bin(ascCmp)  // the ascending test
    fbLocalGet(rt.vIdx)
    emitRangeBound(rt)
    fbI32Bin(descCmp) // the descending test
    fbLocalGet(rt.sIdx)
    fbI32Const(0)
    fbI32Bin(74)      // 0x4a i32.gt_s — is the step positive?
    fbSelect()        // the ascending test iff the step is positive
    fbLocalGet(rt.sIdx)
    fbI32Eqz()
    fbI32Eqz()        // step != 0
    fbI32Bin(113)     // 0x71 i32.and
    return 0
  }
  fbLocalGet(rt.vIdx)
  emitRangeBound(rt)
  if rt.stepK > 0 { fbI32Bin(ascCmp) } else { fbI32Bin(descCmp) }
  return 0
}

function emitRangeBound(rt: RangeTest) {
  if rt.bConst { fbI32Const(rt.bVal) } else { fbLocalGet(rt.bIdx) }
  return 0
}

// The range test evaluated at compile time for `v`, for a constant bound and a static step.
function rangeTestHolds(rt: RangeTest, v: i32): boolean {
  const b = rt.bVal
  if rt.stepK > 0 {
    if rt.excl { return v < b }
    return v <= b
  }
  if rt.excl { return v > b }
  return v >= b
}

// Whether advancing range `s`'s loop var by its step can leave the i32 range before the test
// ends it: a dynamic step, a body that writes the var, an inclusive or wider-stepped range to a
// bound the step can pass the edge from, or a constant bound within one step of the edge.
function rangeMayWrap(s: ForRange, rt: RangeTest): boolean {
  if rt.dynStep || stmtAssignsName(s.frBody, s.frVar) { return true }
  const intMax = 2147483647
  const intMin = -2147483647 - 1
  const k = rt.stepK
  if !rt.bConst { return !(rt.excl && (k == 1 || k == -1)) }
  // The last value the test admits, then whether one more step leaves the range.
  let last = rt.bVal
  if rt.excl {
    if k > 0 && last == intMin { return false }
    if k < 0 && last == intMax { return false }
    last = if k > 0 { last - 1 } else { last + 1 }
  }
  return if k > 0 { last > intMax - k } else { last < intMin - k }
}

// Exits range loop `rt` when its next step would leave the i32 range: `v > INT_MAX - K` for a
// positive step, `v < INT_MIN - K` for a negative one, chosen by the step's sign when dynamic.
function emitRangeWrapExit(rt: RangeTest) {
  const intMax = 2147483647
  const intMin = -2147483647 - 1
  if rt.dynStep {
    fbLocalGet(rt.vIdx)
    fbI32Const(intMax)
    fbLocalGet(rt.sIdx)
    fbI32Bin(107) // 0x6b i32.sub
    fbI32Bin(74)  // 0x4a i32.gt_s — past the top for a positive step
    fbLocalGet(rt.vIdx)
    fbI32Const(intMin)
    fbLocalGet(rt.sIdx)
    fbI32Bin(107) // 0x6b i32.sub
    fbI32Bin(72)  // 0x48 i32.lt_s — past the bottom for a negative step
    fbLocalGet(rt.sIdx)
    fbI32Const(0)
    fbI32Bin(74)  // 0x4a i32.gt_s — is the step positive?
    fbSelect()
  } else if rt.stepK > 0 {
    fbLocalGet(rt.vIdx)
    fbI32Const(intMax - rt.stepK)
    fbI32Bin(74) // 0x4a i32.gt_s
  } else {
    fbLocalGet(rt.vIdx)
    fbI32Const(intMin - rt.stepK)
    fbI32Bin(72) // 0x48 i32.lt_s
  }
  fbBrIf(1) // 0x0d br_if -> out of the range loop's block
  return 0
}

// The range loop, top-tested: `block { loop { br_if block (!test); body; v += K; br loop } }`.
// A bottom-tested `br_if` back-edge is not used: wasmtime runs it up to 2.4x slower
// (DECISIONS.md, "Loops stay top-tested"). A `continue` lands at the end of an inner block, so it
// still steps.
function emitRangeRolled(
  s: ForRange,
  fnIx: i32,
  rt: RangeTest,
  wraps: boolean,
) {
  fbBlock(64) // 0x02 block, void
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.frLabel)
  fbLoop(64)  // 0x03 loop, void
  loopContDepth.push(ctrlDepth)
  loopContLabel.push(s.frLabel)
  emitRangeTest(rt)
  fbI32Eqz()  // 0x45 invert: exit when out of range
  fbBrIf(1)   // 0x0d br_if -> break out of block
  // a body with a `continue` binding to this loop needs an inner block as the continue
  // target: branching to its end falls into the increment (a branch to the loop header
  // would skip it — an infinite loop). The inner block carries the loop's label too.
  const frHasCont = blockHasContinueFor(s.frBody, s.frLabel, false)
  if frHasCont {
    fbBlock(64) // continue block
    loopContDepth.push(ctrlDepth)
    loopContLabel.push(s.frLabel)
  }
  if emitStmts(s.frBody, fnIx) < 0 { return -1 }
  if frHasCont {
    fbEnd() // end continue block — `continue` lands here
    loopContDepth.pop()
    loopContLabel.pop()
  }
  // A step that would leave the i32 range is past every bound, so it ends the loop (D12181).
  if wraps { emitRangeWrapExit(rt) }
  // v = v + K
  fbLocalGet(rt.vIdx)
  if rt.dynStep { fbLocalGet(rt.sIdx) } else { fbI32Const(rt.stepK) }
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(rt.vIdx)
  fbBr(0)       // continue loop
  fbEnd()       // end loop
  loopContDepth.pop()
  loopContLabel.pop()
  fbEnd()       // end block
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  return 0
}

// The copies per trip of a partially unrolled range loop, and the most nodes its body may hold;
// both are chosen in DECISIONS.md, "Small variable-trip range loops are unrolled 4x".
const PARTIAL_UNROLL_COPIES = 4
const PARTIAL_UNROLL_MAX_NODES = 40

// Whether a range loop that is not fully unrolled runs its body `PARTIAL_UNROLL_COPIES` times per
// trip: a static step of 1, a body that holds no loop, never writes the loop var, and passes
// `unrollCost` (no function, no call but an inline memory intrinsic) within the node cap.
function rangePartialUnrollOk(
  s: ForRange,
  stepK: i32,
  dynStep: boolean,
  fnIx: i32,
): boolean {
  if dynStep || stepK != 1 { return false }
  if stmtAssignsName(s.frBody, s.frVar) { return false }
  return partialUnrollCost(s.frBody, fnIx) >= 0
}

// The node count under `ix`, or -1 past `PARTIAL_UNROLL_MAX_NODES` or on a kind outside the
// cheap set: literals and `null`, scalar operators, `is`, locals, field reads, `if`, a `let`,
// `break`/`continue`/`return`, an index into a list or string, an inline memory intrinsic. Any
// other call, a loop, a function, a map index or an allocating literal lowers to far more.
function partialUnrollCost(ix: i32, fnIx: i32): i32 {
  let cnt = 0
  let cur = ix
  while cur >= 0 {
    if cur >= P.nodes.length { return -1 }
    const n = nodeAt(cur)
    let ok = n is NumLit
      || n is CharLit
      || n is BoolLit
      || n is NullLit
      || n is Ident
    ok = ok
      || n is Unary
      || n is BinExpr
      || n is Member
      || n is Paren
      || n is AsExpr
    ok = ok || n is IsExpr || n is TypeRef
    ok = ok || n is IfStmt || n is Block || n is LetDecl || n is BreakStmt
    ok = ok || n is ContinueStmt || n is RetStmt
    if n is Index {
      const r = n.idxArr
      ok = scalarListElemKind(r, fnIx) != null || exprRefArray(r, fnIx)
      ok = ok || exprStringArray(r, fnIx) || exprString(r, fnIx)
    }
    if n is Call { ok = hoistSafeMemCall(cur, fnIx) }
    if !ok { return -1 }
    cnt = cnt + 1
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      if kids[i] >= 0 {
        const c = partialUnrollCost(kids[i], fnIx)
        if c < 0 { return -1 }
        cnt = cnt + c
        if cnt > PARTIAL_UNROLL_MAX_NODES { return -1 }
      }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  return cnt
}

// The range loop run as `PARTIAL_UNROLL_COPIES` body copies per trip while that many trips
// remain (`v < bound - D`; a bound too low to subtract runs none), then rolled. Copy `k` stores
// and reads the loop var as `u + k`, `u` the trip's first value, so two reads stay one expression
// and the copies chain no increments. `break` leaves both loops; `continue` ends its own copy.
function emitRangePartial(
  s: ForRange,
  fnIx: i32,
  rt: RangeTest,
  wraps: boolean,
) {
  fbBlock(64) // 0x02 block, void — the `break` target of both loops
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.frLabel)
  // A trip whose last step could reach past the i32 range stops one step short, leaving the
  // rest to the guarded rolled loop (D12181).
  let d = PARTIAL_UNROLL_COPIES - 1
  if !rt.excl && !wraps { d = d - 1 }
  const intMin = -2147483647 - 1
  // A constant bound too low to subtract from runs no main trip at all.
  const mainRuns = !rt.bConst || rt.bVal >= intMin + d
  if mainRuns {
    let limSlot = -1
    if !rt.bConst {
      // lim = bound >= INT_MIN + d ? bound - d : INT_MIN
      limSlot = strI32Slot()
      fbLocalGet(rt.bIdx)
      fbI32Const(d)
      fbI32Bin(107) // 0x6b i32.sub
      fbI32Const(intMin)
      fbLocalGet(rt.bIdx)
      fbI32Const(intMin + d)
      fbI32Bin(78)  // 0x4e i32.ge_s
      fbSelect()
      fbLocalSet(limSlot)
    }
    const uSlot = strI32Slot()
    fbBlock(64)  // 0x02 block, void — the main loop's exit
    fbLoop(64)   // 0x03 loop, void
    fbLocalGet(rt.vIdx)
    if rt.bConst { fbI32Const(rt.bVal - d) } else { fbLocalGet(limSlot) }
    fbI32Bin(72) // 0x48 i32.lt_s
    fbI32Eqz()
    fbBrIf(1)    // leave the main loop
    fbLocalGet(rt.vIdx)
    fbLocalSet(uSlot)
    const hasCont = blockHasContinueFor(s.frBody, s.frLabel, false)
    const cursor0 = emitLetCursor
    let k = 0
    while k < PARTIAL_UNROLL_COPIES {
      emitLetCursor = cursor0
      if k > 0 {
        fbLocalGet(uSlot)
        fbI32Const(k)
        fbI32Bin(106) // 0x6a i32.add
        fbLocalSet(rt.vIdx)
      }
      urSlot.push(rt.vIdx)
      urVal.push(k)
      urBase.push(uSlot)
      if hasCont {
        fbBlock(64) // this copy's continue block
        loopContDepth.push(ctrlDepth)
        loopContLabel.push(s.frLabel)
      }
      const rc = emitStmts(s.frBody, fnIx)
      if hasCont {
        fbEnd()
        loopContDepth.pop()
        loopContLabel.pop()
      }
      urSlot.pop()
      urVal.pop()
      urBase.pop()
      if rc < 0 { return -1 }
      k = k + 1
    }
    emitLetCursor = cursor0
    fbLocalGet(uSlot)
    fbI32Const(PARTIAL_UNROLL_COPIES)
    fbI32Bin(106) // 0x6a i32.add
    fbLocalSet(rt.vIdx)
    fbBr(0)       // next main trip
    fbEnd()       // end loop
    fbEnd()       // end block
  }
  if emitRangeRolled(s, fnIx, rt, wraps) < 0 { return -1 }
  fbEnd() // end block
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  return 0
}

// The most trips, and the most body nodes summed over every copy, a range loop is fully unrolled
// at; the two limits are chosen in DECISIONS.md, "Small constant range loops are unrolled".
const UNROLL_MAX_TRIPS = 16
const UNROLL_MAX_NODES = 640
const UNROLL_PUSH_NODES = 16

// The range loop fully unrolled: `trips` copies of the body in one block, copy `k` reading the
// loop var as the constant `A + k*K`. `break` leaves the block and `continue` ends its copy.
// Every copy mints the body's `let`s into the same slots.
function emitRangeUnrolled(
  s: ForRange,
  fnIx: i32,
  vIdx: i32,
  aVal: i32,
  stepK: i32,
  trips: i32,
) {
  fbBlock(64) // 0x02 block, void — the `break` target
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.frLabel)
  const hasCont = blockHasContinueFor(s.frBody, s.frLabel, false)
  const cursor0 = emitLetCursor
  let k = 0
  let v = aVal
  while k < trips {
    emitLetCursor = cursor0
    fbI32Const(v)
    fbLocalSet(vIdx)
    urSlot.push(vIdx)
    urVal.push(v)
    urBase.push(-1)
    if hasCont {
      fbBlock(64) // this copy's continue block
      loopContDepth.push(ctrlDepth)
      loopContLabel.push(s.frLabel)
    }
    const rc = emitStmts(s.frBody, fnIx)
    if hasCont {
      fbEnd()
      loopContDepth.pop()
      loopContLabel.pop()
    }
    urSlot.pop()
    urVal.pop()
    urBase.pop()
    if rc < 0 { return -1 }
    v = v + stepK
    k = k + 1
  }
  fbEnd() // end block
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  return 0
}

// The trips of the range loop at `stmtIx` when it is a constant range in a getter, or in a
// function a getter reaches by direct calls (`esGetterReach`); the step budget holds those
// within `UNROLL_MAX_TRIPS`. -1 for any other loop.
function getterRangeTrips(stmtIx: i32, fnIx: i32): i32 {
  if fnIx < 0 || fnIx >= P.nodes.length { return -1 }
  const f = nodeAt(fnIx)
  if !(f is FuncDecl) { return -1 }
  if getDeclPropOf(f.fnName) == "" && !(esGetterReach[fnIx] ?? false) {
    return -1
  }
  const t = constRangeTrips(stmtIx, UNROLL_MAX_TRIPS + 1)
  if t > UNROLL_MAX_TRIPS { return -1 }
  return t
}

// The innermost unrolled copy whose loop var is local `idx`, or -1.
function unrolledSlotAt(idx: i32) {
  let j = urSlot.length - 1
  while j >= 0 {
    if urSlot[j] == idx { return j }
    j = j - 1
  }
  return -1
}

// The trip count of a constant range loop worth unrolling, or -1. The rolled loop is simulated
// with its own i32 steps, and declined when a step would wrap (the rolled loop then never ends),
// when the body writes the loop var, or when `unrollCost` declines it or its copies exceed
// `UNROLL_MAX_NODES`.
function rangeUnrollTrips(
  s: ForRange,
  aVal: i32,
  bVal: i32,
  stepK: i32,
  fnIx: i32,
) {
  const rt: RangeTest = {
    vIdx: -1,
    bIdx: -1,
    bConst: true,
    bVal: bVal,
    sIdx: -1,
    dynStep: false,
    stepK: stepK,
    excl: s.frExcl,
  }
  let v = aVal
  let t = 0
  while rangeTestHolds(rt, v) {
    t = t + 1
    if t > UNROLL_MAX_TRIPS { return -1 }
    const next = v + stepK
    if stepK > 0 && next < v { return -1 }
    if stepK < 0 && next > v { return -1 }
    v = next
  }
  if t == 0 { return -1 }
  if stmtAssignsName(s.frBody, s.frVar) { return -1 }
  const cost = unrollCost(s.frBody, fnIx, UNROLL_MAX_NODES)
  if cost < 0 || cost * t > UNROLL_MAX_NODES { return -1 }
  return t
}

// The node count of the code under `ix`, a nested constant range loop's body counted once per
// trip, or -1 when it holds a function, a call that is not an inline memory intrinsic, or exceeds
// `cap`. A call outweighs the test and step unrolling saves, and the host reads a call inside a
// loop as hot. A build region's push is inline, weighing `UNROLL_PUSH_NODES` more (D3623).
function unrollCost(ix: i32, fnIx: i32, cap: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is FuncDecl { return -1 }
  let cnt = 1
  if n is Call {
    if listBuildRegionOf(ix) >= 0 { cnt = cnt + UNROLL_PUSH_NODES }
    else if !hoistSafeMemCall(ix, fnIx) { return -1 }
  }
  if n is ForRange {
    const inner = rangeStaticTrips(n, fnIx)
    if inner > 0 {
      const b = unrollCost(n.frBody, fnIx, cap)
      if b < 0 { return -1 }
      const tot = 3 + b * inner
      if tot > cap { return -1 }
      return tot
    }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      const c = unrollCost(kids[i], fnIx, cap)
      if c < 0 { return -1 }
      cnt = cnt + c
      if cnt > cap { return -1 }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  return cnt
}

// The trip count of a range loop with constant ends and a literal step when it is at most
// `UNROLL_MAX_TRIPS`; 0 for any other.
function rangeStaticTrips(n: ForRange, fnIx: i32) {
  if !forRangeStepIsConst(n.frStep) { return 0 }
  if !rangeConstIs(n.frFrom, fnIx) || !rangeConstIs(n.frTo, fnIx) { return 0 }
  let k = 1
  if n.frStep >= 0 {
    if !rangeConstIs(n.frStep, fnIx) { return 0 }
    k = rangeConstVal(n.frStep, fnIx)
  }
  if k == 0 { return 0 }
  const rt: RangeTest = {
    vIdx: -1,
    bIdx: -1,
    bConst: true,
    bVal: rangeConstVal(n.frTo, fnIx),
    sIdx: -1,
    dynStep: false,
    stepK: k,
    excl: n.frExcl,
  }
  let v = rangeConstVal(n.frFrom, fnIx)
  let t = 0
  while rangeTestHolds(rt, v) && t <= UNROLL_MAX_TRIPS {
    t = t + 1
    v = v + k
  }
  if t > UNROLL_MAX_TRIPS { return 0 }
  return t
}

// A map walk's step after its body: when an insert in the body compacted the map, the entry at
// the cursor lacks the sequence `seqL` saved, and `__map_resync__` moves the cursor to just
// before the first entry with a later sequence, where JS `Map` iteration would go next (D2315).
function emitForInMapResync(mapL: i32, curL: i32, seqL: i32, shape: i32) {
  cmSlot = shape
  // if M.seqs[cursor] != seq { cursor = __map_resync__(M.seqs, M.count, seq) }
  fbLocalGet(mapL)
  fbStructGet(cmMapTy(), 7)
  fbLocalGet(curL)
  fbArrayGet(ia64Ty())
  fbLocalGet(seqL)
  fbI32Bin(82)              // 0x52 i64.ne
  fbIf(64)                  // if, void
  fbLocalGet(mapL)
  fbStructGet(cmMapTy(), 7)
  fbLocalGet(mapL)
  fbStructGet(cmMapTy(), 4) // M.count
  fbLocalGet(seqL)
  fbCall(helpMapResyncFn())
  fbLocalSet(curL)
  fbEnd()                   // end (if)
  return 0
}

// The compaction helper for map shape `sh` (a Set folds onto its key rep's mono map), or -1
// when the module reserved none: nothing deletes, so no entry is ever dead (D2315).
function mapCompactFnOf(sh: i32) { return helpMapCompactFn(mapShapeRow(sh)) }

// Does the code under `ix` assign the bare name `nm`, outside any nested function?
function stmtAssignsName(ix: i32, nm: string): boolean {
  let cur = ix
  while cur >= 0 {
    const n = nodeAt(cur)
    if n is FuncDecl { return false }
    if n is BinExpr {
      if n.binOp == "=" {
        const t = nodeAt(unwrapParen(n.binLeft))
        if t is Ident {
          if t.identName == nm { return true }
        }
      }
    }
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      if stmtAssignsName(kids[i], nm) { return true }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  return false
}

// After a walk's list value: a narrowed nullable list recovered, then stored in the list temp.
export function forInListStore(iterIx: i32, fnIx: i32, lp: ForInLoop): i32 {
  // A NARROWED nullable-list iterable keeps its nullable slot at EVERY element kind — the
  // i32-list niche, a distinct-backing scalar list and a ref array alike; the `#l` temp is
  // non-null, so recover first (checker-guarded). See `nulRecvNeedsRecover`.
  if nulRecvNeedsRecover(iterIx, fnIx) { fbRefAsNonNull() }
  fbLocalSet(lp.lIdx)
  return 0
}

// After a list value pushed by a walk's iterable expression, the view sync its source owes.
export function forInListSync(iterIx: i32, fnIx: i32): i32 {
  return svSyncRecv(iterIx, fnIx)
}

// The element kinds the IR's walk binds as legacy's does: an `i32`, a string, a value union's
// box, a record, or an `i32`, string or byte list, each read whole into the loop variable.
function forInElemPlain(ek: VKind): boolean {
  return match ek {
    "i32" | "str" | "union" | "struct" | "list" | "strlist" | "u8list" | "nulstr" | "variant" | "nulstruct" | "i64" | "f64" => true
    "reflist" | "map" | "nulvariant" | "f64list" | "f32" | "closure" | "nullist" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "v128list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulu8list" | "nulmap" | "nulnone" | "v128" => false
  }
}

// Why `for` statement `s` at `stmtIx` is not the plain walk, or "": a list of a `forInElemPlain`
// kind, a string's code points or a map's keys or values, read once; no second name or
// node-pinned slot; a body that may reallocate a list, so the header is re-read each step and
// nothing is hoisted or unrolled ("hoisted" where it is). A literal iterable is a list literal.
export function forInPlainWhy(s: ForIn, stmtIx: i32, fnIx: i32): string {
  if luForUnionIter(s.fiIter, fnIx) { return "list union" }
  const ek = forInElemKind(s.fiIter, fnIx)
  if ek == null { return "iterable" }
  if !forInElemPlain(ek) { return "element " + ek }
  if s.fiVar2 != "" { return "pair" }
  if listFitShadowIsRef(s.fiIter, fnIx) { return "shadow" }
  if declSlotPinned(stmtIx) >= 0 { return "pinned slot" }
  if hoistSafeBlock(s.fiBody, fnIx) { return "hoisted" }
  return ""
}

function emitForInStmt(s: ForIn, stmtIx: i32, fnIx: i32) {
  const luf = emitListUnionFor(s, stmtIx, fnIx)
  if luf != 0 { return if luf < 0 { -1 } else { 0 } }
  const lmf = emitMapUnionFor(s, stmtIx, fnIx)
  if lmf != 0 { return if lmf < 0 { -1 } else { 0 } }
  // `for v[, w] in <list> { body }` — iterate an i32 list, a string list, a struct ref list,
  // or a map's ordered keys/values list. Cursor slots in collect pre-order: the element var
  // `v`, a hidden cursor `v#i`, a hidden list temp `v#l` (the iterable evaluates once), and
  // the second name last. Shape mirrors `while`: block/loop, exit on `cursor >= len`, cursor++.
  const ek = forInElemKind(s.fiIter, fnIx)
  if ek == null {
    return emitFailAt("emitProgram: unsupported for-in iterable", s.fiIter)
  }
  // A STRING iterable (`for ch in s`): the `#l` temp IS the raw `(ref $sTypeIdx)` array (no
  // list wrapper), so the length is `array.len` and each element `array.get $aTypeIdx` —
  // skipping the `struct.get wrapTy` the i32-list path uses. The loop var is an i32 code unit.
  const strSrc = forInStringSrc(s.fiIter, fnIx)
  // a packed byte-list iterable (`for b in bs`, `bs: u8[]`): the `#l` temp is the `$bl8`
  // wrapper over the one-byte backing, so length is `struct.get $bl8 1` and each element
  // `array.get_u $ba8` — `fbArrayGet` picks the unsigned opcode off the backing heap index itself.
  const u8Src = forInU8Src(s.fiIter, fnIx)
  // The SECOND name's slot, minted last in the same pre-order the collect pass mints it.
  const pairName = s.fiVar2
  const hasPair = pairName != ""
  let nSlots = 3
  if hasPair { nSlots = 4 }
  const vSlot = declSlotTake(stmtIx, nSlots)
  // An `is K[]` arm's empty list of ref elements never iterates, and its loop slots are
  // typed at the receiver's own element, so the loop is not emitted (D4962).
  if listFitShadowIsRef(s.fiIter, fnIx) { return 0 }
  const lp = forInLoopAt(s, fnIx, vSlot, ek, strSrc, u8Src)
  if lp == null { return -1 }
  const mapRecv = lp.mapRecv
  const pairIsVal = lp.pairIsVal
  const pIdx = lp.pIdx
  const pSlot = vSlot + 3
  if mapRecv >= 0 {
    if emitForInMapStash(fnIx, lp) < 0 { return -1 }
  }
  // list = <iter> (evaluated once); cursor = 0
  if emitForInList(s.fiIter, fnIx, mapRecv, lp.mwShape) < 0 { return -1 }
  forInListStore(s.fiIter, fnIx, lp)
  forInHeaderHoist(s, fnIx, lp)
  emitForInCursorInit(lp)
  // A body that writes the index gets a hidden counter, and the index is a fresh copy of it
  // each iteration, so the write never moves the walk (D2342).
  if hasPair && !pairIsVal && stmtAssignsName(s.fiBody, pairName) {
    lp.pCtr = strI32Slot()
  }
  if hasPair && !pairIsVal {
    // A dense counter of body executions: the cursor is a backing offset for a string and
    // skips tombstones for a set, so it is not the index at two of the three sequences.
    fbI32Const(0)
    if lp.pCtr >= 0 { fbLocalSet(lp.pCtr) } else { fbLocalSet(pIdx) }
  }
  // The body's own index receivers, as `while` and a range loop hoist theirs.
  const fiHoist = loopHoistOpen(-1, s.fiBody, fnIx, s.fiDecl1, s.fiDecl2)
  if fiHoist < 0 { return -1 }
  scopeBind(s.fiVar, vSlot)
  if hasPair { scopeBind(pairName, pSlot) }
  if emitForInLoop(s, fnIx, lp) < 0 { return -1 }
  loopHoistClose(fiHoist)
  // The loop variables' scope is the loop (see `scopeUnbind`) — one release per name.
  if hasPair { scopeUnbind() }
  scopeUnbind()
  return 0
}

// A map walk's receiver `lp.mapRecv`, evaluated once into the walk's own stash: the walked
// list, the loop bound, the skip's `M.live[cursor]` and the pair's value all read one object.
// The stash is per loop, never the shared mapRef, which any map op in the body rewrites
// (D2313). Writes `lp.mwShape` and `lp.fiMap`; returns -1 when the receiver fails, else 0.
function emitForInMapStash(fnIx: i32, lp: ForInLoop): i32 {
  if pushMapRecvRef(lp.mapRecv, fnIx) < 0 { return -1 }
  return forInMapStash(fnIx, lp)
}

// After a map walk's receiver `(ref $map)`: the walk's stash, through the op's mapRef.
export function forInMapStash(fnIx: i32, lp: ForInLoop): i32 {
  lp.mwShape = mapShapeFoldSet(mapShapeOfExpr(lp.mapRecv, fnIx))
  cmSlot = lp.mwShape
  setMapRef() // mapRef — read by `emitForInList`, before any body op rewrites it
  lp.fiMap = forInMapStashSlot(cmMapTy())
  pushMapRef()
  fbLocalSet(lp.fiMap)
  return 0
}

// A walk's header after its list is stored. A body that cannot reallocate a list (no call, so no
// push or pop through any alias) sees one backing and one `len`, read once here; any other body
// re-reads the header per step, and a view is then read through its source each step (D3028).
export function forInHeaderHoist(s: ForIn, fnIx: i32, lp: ForInLoop) {
  if (
    lp.fiHOk
    && !lp.strSrc
    && lp.mapRecv < 0
    && forInPairValsSlot(s.fiIter, fnIx) < 0
    && hoistSafeBlock(s.fiBody, fnIx)
    && !svHoistBlocked(s.fiIter, fnIx, -1, s.fiBody)
  ) {
    emitForInHoistHeader(lp)
  }
  if lp.fiHLen < 0 && (lp.ek == "f64" || lp.ek == "i64") {
    lp.fiSv = svDstOfKind(lp.ek)
  }
  lp.fiRv = lp.fiHLen < 0 && lp.hKind == "reflist" && rvMayView(lp.hSlot)
  return 0
}

// The header hoist of a walk whose body cannot reallocate the list: the backing and `len`
// read once from the `#l` temp into `lp.fiHBack` and `lp.fiHLen`.
function emitForInHoistHeader(lp: ForInLoop) {
  lp.fiHBack = listBackStashSlot(lp.hKind, lp.hSlot)
  lp.fiHLen = strI32Slot()
  fbLocalGet(lp.lIdx)
  fbStructGet(lp.wrapTy, 0)
  fbLocalSet(lp.fiHBack)
  fbLocalGet(lp.lIdx)
  fbStructGet(lp.wrapTy, 1)
  fbLocalSet(lp.fiHLen)
}

// The walk's cursor start into `lp.iIdx`: 0, or for a string source its start in backing
// coordinates, with the backing, the exit bound and the decoder's packed width in slots of
// their own (`lp.fiSBack`, `lp.fiSEnd`, `lp.fiSPk`), so the loop runs no `struct.get`.
export function emitForInCursorInit(lp: ForInLoop) {
  if lp.strSrc {
    lp.fiSBack = strBackSlot()
    lp.fiSEnd = strI32Slot()
    // the packed `(width << 24) | cp` `__utf8_dec__` returns: the loop variable is still a
    // code point, but the stride is now data-dependent, so the width must survive the body
    // to reach the increment. Its own slot per loop, so a nested `for cp in t` cannot clobber it.
    lp.fiSPk = strI32Slot()
    fbLocalGet(lp.lIdx)
    fbStrBack()
    fbLocalSet(lp.fiSBack)
    fbLocalGet(lp.lIdx)
    fbStrStart()
    fbLocalGet(lp.lIdx)
    fbStrLen()
    fbI32Bin(106) // 0x6a i32.add — the one-past-the-end backing offset
    fbLocalSet(lp.fiSEnd)
    fbLocalGet(lp.lIdx)
    fbStrStart()
  } else {
    fbI32Const(0)
  }
  fbLocalSet(lp.iIdx)
}

// `emitForInLoop`'s exit test: `br_if 1` out of the break block when cursor >= len (the list
// wrapper's field 1; a STRING compares its backing-coordinate cursor against the pre-computed
// `start + len` bound).
function emitForInExitTest(lp: ForInLoop) {
  fbLocalGet(lp.iIdx)
  if lp.strSrc {
    fbLocalGet(lp.fiSEnd)
  } else if lp.fiHLen >= 0 {
    fbLocalGet(lp.fiHLen)
  } else if lp.fiSv >= 0 {
    fbLocalGet(lp.lIdx)
    fbCall(gHelpSvLen[lp.fiSv])
  } else if lp.fiRv {
    fbLocalGet(lp.lIdx)
    fbCall(gHelpRvLen)
  } else {
    fbLocalGet(lp.lIdx)
    fbStructGet(lp.wrapTy, 1)
  }
  fbI32Bin(78) // 0x4e i32.ge_s
  fbBrIf(1)    // 0x0d br_if -> break out of block
}

// `emitForInLoop`'s tombstone skip over a map walk in a module that deletes: when
// M.live[cursor] == 0, advance the cursor and `br 1` to the loop header without binding `v` or
// running the body. Returns the local holding the entry's sequence for the post-body resync
// (D2315), or -1 when there is none.
function emitForInTombstoneSkip(lp: ForInLoop): i32 {
  let fiSeq = -1
  if lp.mapRecv >= 0 && gMapDeletes {
    cmSlot = lp.mwShape
    // M.live, off the walk's own stash
    fbLocalGet(lp.fiMap)
    fbStructGet(cmMapTy(), 2)
    fbLocalGet(lp.iIdx)
    fbArrayGet(aTy()) // M.live[cursor]
    fbI32Eqz()        // live[cursor] == 0 ?
    fbIf(64)          // 0x04 if, void
    fbLocalGet(lp.iIdx)
    fbI32Const(1)
    fbI32Bin(106)     // cursor + 1
    fbLocalSet(lp.iIdx)
    fbBr(1)           // 0x0c br -> loop header (re-check exit)
    fbEnd()           // 0x0b end (if)
    if gMapDeletes {
      fiSeq = mapSeqSaveSlot()
      fbLocalGet(lp.fiMap)
      fbStructGet(cmMapTy(), 7)
      fbLocalGet(lp.iIdx)
      fbArrayGet(ia64Ty())
      fbLocalSet(fiSeq)
    }
  }
  return fiSeq
}

// `emitForInLoop`'s binds: `v = backing[cursor]` (a STRING source decodes the code point at its
// hoisted backing's offset), recovered non-null when `elemRecover`, then a map walk's value or
// the pair counter into the pair local. Returns 0, or -1 failed.
function emitForInBind(s: ForIn, lp: ForInLoop, elemRecover: boolean): i32 {
  const ek = lp.ek
  const iIdx = lp.iIdx
  if ek == "nulnone" {
    // A `null[]` element is never read: its loop var is the `null` cell, null from its default.
  } else if lp.strSrc {
    // pk = __utf8_dec__(backing, cursor, end) ; v = pk & 0x00ffffff
    fbLocalGet(lp.fiSBack)
    fbRefAsNonNull() // the hoist slot is nullable so it stays defaultable;
    // `array.get` tolerated that, a CALL does not.
    fbLocalGet(iIdx)
    fbLocalGet(lp.fiSEnd)
    fbCall(helpUtf8DecFn())
    fbLocalTee(lp.fiSPk)
    fbI32Const(16777215) // 0x00ffffff — strip the width, keep the code point
    fbI32Bin(113)        // 0x71 i32.and
  } else if lp.fiHBack >= 0 {
    fbLocalGet(lp.fiHBack)
    fbLocalGet(iIdx)
    fbArrayGet(lp.backTy)
  } else if lp.fiSv >= 0 {
    fbLocalGet(lp.lIdx)
    fbLocalGet(iIdx)
    fbCall(gHelpSvGet[lp.fiSv])
  } else if lp.fiRv {
    fbLocalGet(lp.lIdx)
    fbLocalGet(iIdx)
    fbCall(gHelpRvGet)
  } else {
    fbLocalGet(lp.lIdx)
    fbStructGet(lp.wrapTy, 0)
    fbLocalGet(iIdx)
    fbArrayGet(lp.backTy)
  }
  if elemRecover {
    // string/struct/union-box/closure element, or a nested inner-list/ref-list wrapper: all
    // are a non-null ref recovered from the `(ref null <elem>)` slot. Every niche element
    // kind is absent on purpose, since its loop var legitimately holds null — this set and
    // `forInElemKind`'s niche arms are one decision, or a loud reject turns into invalid wasm.
    fbRefAsNonNull()
    if lp.hKind == "reflist" && lp.hSlot >= 0 {
      if emitStaleBoxRetag(lp.hSlot, s.fiIter) < 0 { return -1 }
    }
  }
  if ek != "nulnone" { fbLocalSet(lp.vIdx) }
  if lp.pairIsVal && lp.pairEk != "nulnone" {
    // `v = M.vals.backing[cursor]` — the value beside the key just bound, off the walk's
    // stash the tombstone skip already reads, so the receiver is evaluated once. A union-of-maps
    // arm's walk boxes it into the value union at that arm's row.
    const pb = forInPairBox
    if pb != null { armRowBoxOpen(pb) }
    cmSlot = lp.mwShape
    fbLocalGet(lp.fiMap)
    fbStructGet(cmMapTy(), 1) // M.vals
    fbStructGet(lp.pairWrapTy, 0)
    fbLocalGet(iIdx)
    fbArrayGet(lp.pairBackTy)
    if lp.pairRecover {
      fbRefAsNonNull() // a non-null value kind off a nullable element slot
    }
    if pb != null { armRowBoxClose(pb) }
    fbLocalSet(lp.pIdx)
  }
  if lp.pCtr >= 0 {
    fbLocalGet(lp.pCtr)
    fbLocalSet(lp.pIdx)
  }
  return 0
}

// `emitForInLoop`'s step: cursor += <stride>, one element for every source but a string, which
// strides by the UTF-8 width of the sequence just decoded, parked in the high byte of `fiSPk`
// (never 0). A key walk's pair index advances too, on the path the BODY ran, so a deleted
// entry does not consume one.
function emitForInStep(lp: ForInLoop) {
  const iIdx = lp.iIdx
  fbLocalGet(iIdx)
  if lp.strSrc {
    fbLocalGet(lp.fiSPk)
    fbI32Const(24)
    fbI32Bin(118) // 0x76 i32.shr_u
  } else {
    fbI32Const(1)
  }
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(iIdx)
  if lp.hasPair && !lp.pairIsVal {
    let pStep = lp.pIdx
    if lp.pCtr >= 0 { pStep = lp.pCtr }
    fbLocalGet(pStep)
    fbI32Const(1)
    fbI32Bin(106) // 0x6a i32.add
    fbLocalSet(pStep)
  }
}

// A `for`-in walk's break block and loop: the exit test, the map's tombstone skip, the
// element and pair binds, the body and the cursor step. Returns -1 on a failure, else 0.
function emitForInLoop(s: ForIn, fnIx: i32, lp: ForInLoop) {
  const fiSeq = forInLoopOpen(s, fnIx, lp)
  if fiSeq == -2 { return -1 }
  if emitStmts(s.fiBody, fnIx) < 0 { return -1 }
  return forInLoopClose(s, lp, fiSeq)
}

// A walk's loop up to its body: the break block (and, ahead of a hoisted walk's rolled loop,
// its unrolled copies), the loop, the exit test, the map's tombstone skip, the element's bind,
// and the continue block when the body continues. Returns the skip's sequence local, -1 for
// none, -2 on failure.
export function forInLoopOpen(s: ForIn, fnIx: i32, lp: ForInLoop): i32 {
  forInBreakOpen(s)
  const c = forInCopiesOf(s, fnIx, lp)
  if c != null && emitForInCopies(s, fnIx, c) < 0 { return -2 }
  return forInRolledOpen(s, lp)
}

// A walk's break block, which every `break` out of it targets.
export function forInBreakOpen(s: ForIn) {
  fbBlock(64) // 0x02 block, void
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.fiLabel)
  return 0
}

// A walk's rolled loop up to its body, after any unrolled copies (`forInLoopOpen`).
export function forInRolledOpen(s: ForIn, lp: ForInLoop): i32 {
  const elemRecover = forInElemRecovers(lp.ek)
  fbLoop(64) // 0x03 loop, void
  loopContDepth.push(ctrlDepth)
  loopContLabel.push(s.fiLabel)
  emitForInExitTest(lp)
  const fiSeq = emitForInTombstoneSkip(lp)
  if emitForInBind(s, lp, elemRecover) < 0 { return -2 }
  // Same INNER continue block as for-range: `continue` must still increment.
  if blockHasContinueFor(s.fiBody, s.fiLabel, false) {
    fbBlock(64) // continue block
    loopContDepth.push(ctrlDepth)
    loopContLabel.push(s.fiLabel)
  }
  return fiSeq
}

// A walk's loop after its body: the continue block's end, the map's resync, the step, the
// back-branch, and the loop's and break block's ends.
export function forInLoopClose(s: ForIn, lp: ForInLoop, fiSeq: i32): i32 {
  if blockHasContinueFor(s.fiBody, s.fiLabel, false) {
    fbEnd() // end continue block — `continue` lands here
    loopContDepth.pop()
    loopContLabel.pop()
  }
  if fiSeq >= 0 { emitForInMapResync(lp.fiMap, lp.iIdx, fiSeq, lp.mwShape) }
  emitForInStep(lp)
  fbBr(0) // continue loop
  fbEnd() // end loop
  loopContDepth.pop()
  loopContLabel.pop()
  fbEnd() // end block
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  return 0
}

// `for v[, i] in recv` over a union-of-lists box a pin left unrewritten (D16897): the box is
// held in the loop's `#l` slot, one tag test picks the arm, and that arm's walk boxes each
// element into the element union `v` holds. 0 when `s` is no such loop.
function emitListUnionFor(s: ForIn, stmtIx: i32, fnIx: i32): i32 {
  if !luForUnionIter(s.fiIter, fnIx) { return 0 }
  const arms = luMembersAt(nodeTyAt(s.fiIter, fnIx))
  const u = luElemTy(arms)
  // The element union's rep: a box, or the string a literal union joined with `string` is.
  // Inside `is K[]` each element converts to `K`'s rep (D17002).
  const kt = luForKTy(s, fnIx)
  const k: VKind = (if kt >= 0 { repSigKindOfTy(kt) } else { luForElemKind(s.fiIter, fnIx) })
    ?? "union"
  if k != "union" {
    return emitListUnionForFlat(s, stmtIx, fnIx, arms, k, kt >= 0)
  }
  const tags: i32[] = []
  const heaps: i32[] = []
  const eTags: i32[] = []
  const eBoxes: i32[] = []
  const eNul: boolean[] = []
  for m in arms {
    const t = listIsArmTag(m)
    const h = listArmHeapOf(m)
    const row = armElemRowOf(tyArrayElemIx(m))
    if t < 0 || h < 0 || listBackOfWrap(h) < 0 || row.et == -1 {
      return emitFail(
        "emitProgram: a union-of-lists `for` arm has no tag, wrapper or element box",
      )
    }
    if unMemIsRefElemArray(m) && rvMayView(unMemRefArrArmSlot(m)) {
      return emitFail(
        "emitProgram: a union-of-lists arm may hold a list view, which its read does not unwrap",
      )
    }
    tags.push(t)
    heaps.push(h)
    eTags.push(row.et)
    eBoxes.push(row.ebox)
    eNul.push(row.nul)
  }
  if u < 0 {
    return emitFail("emitProgram: a union-of-lists `for` has no element union")
  }
  const plan: LuForPlan = {
    tags: tags,
    heaps: heaps,
    eTags: eTags,
    eBoxes: eBoxes,
    eNul: eNul,
    eTexts: [],
    eFrom: [],
    destKind: k,
  }
  return emitListUnionForLoop(s, stmtIx, fnIx, plan)
}

// How an arm's element (or map value) `e` enters the element union: its box tag (`et`, -2 for an
// element that is itself a value box, -1 for none), the value box a scalar is wrapped in
// (`ebox`, -1 for none), and whether a `null` rides beside it (`nul`).
type ArmElemRow = { et: i32, ebox: i32, nul: boolean }
function armElemRowOf(e: i32): ArmElemRow {
  // A numeric literal-union element is boxed at its base scalar's tag (D4770).
  const en0 = if e >= 0 { nonNullTy(e) } else { -1 }
  const nb = if en0 >= 0 { numLitUnionBaseTy(en0) } else { -1 }
  const en = if nb >= 0 { nb } else { en0 }
  const ek = if en >= 0 { boxTagOfTy(en) } else { -1 }
  const scalar = ek >= 0 && !atomIsRefKind(ek)
  // An element that is itself a value box is stored as one and read as it is.
  const boxed = e >= 0 && valueBoxOfTy(e)
  const nul = !boxed && en0 != e
  let et = -2
  if !boxed { et = if en >= 0 { isArmTagOfTy(en) } else { -1 } }
  if !boxed && scalar && nul { et = -1 }
  return {
    et: et,
    ebox: if scalar && !boxed { vbHeapIdxOfKind(ek) } else { -1 },
    nul: nul,
  }
}

// The two halves of boxing a value read between them at `row`: the tag below the value, then its
// scalar value box and the union box over both; a stored box is only recovered non-null.
function armRowBoxOpen(row: ArmElemRow) {
  if row.et >= 0 { fbI32Rel(RS_TAG, row.et) }
  return 0
}

function armRowBoxClose(row: ArmElemRow) {
  if row.et == -2 {
    fbRefAsNonNull()
    return 0
  }
  if row.ebox >= 0 { fbStructNew(row.ebox) }
  fbStructNew(uBoxIdx)
  return 0
}

// `for k, v in recv` over a union-of-maps box a pin left unrewritten: one tag test picks the
// arm, and the map walk re-lowers under that arm, its value boxed into the value union `v`
// holds (`forInPairBox`). 0 when `s` is no such loop.
function emitMapUnionFor(s: ForIn, stmtIx: i32, fnIx: i32): i32 {
  const arms = lmForUnionArms(s.fiIter, fnIx)
  if arms.length == 0 { return 0 }
  // Inside an enclosing walk of the same binding the arm is known: its walk alone is emitted.
  const ka = knownArmOf(s.fiIter)
  const from = if ka >= 0 { ka } else { 0 }
  return emitMapUnionForArm(s, stmtIx, fnIx, arms, emitLetCursor, from, ka >= 0)
}

// Arm `i` onward of `emitMapUnionFor`'s tag chain.
function emitMapUnionForArm(
  s: ForIn,
  stmtIx: i32,
  fnIx: i32,
  arms: i32[],
  cur0: i32,
  i: i32,
  only: boolean,
): i32 {
  if i >= arms.length {
    fbUnreachable()
    return 1
  }
  const m = arms[i]
  const t = listIsArmTag(m)
  const heap = armHeapOf(m)
  const loc = armWrapLocal(m)
  // The pair's value enters the value union at this arm's row, unless the union is no box.
  const mt = tyAt(m)
  const isMap = mt is TyMap && mt.mSet == 0
  const boxV = s.fiVar2 != "" && isMap && boxTyName(luElemTy(arms)) != ""
  const row = armElemRowOf(tyMapValOf(m))
  if t < 0 || heap < 0 || loc < 0 || boxV && (row.et == -1 || row.nul) {
    return emitFail(
      "emitProgram: a union-of-maps `for` arm has no tag, map or value box",
    )
  }
  if !only {
    if emitExpr(s.fiIter, fnIx) < 0 { return -1 }
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, t)
    fbI32Bin(70) // 0x46 i32.eq
    fbIf(64)
  }
  if emitExpr(s.fiIter, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1)
  fbRefCast(heap)
  fbLocalSet(loc)
  // The arms exclude each other, so each walk takes the same slots as the first's.
  emitLetCursor = cur0
  const mark = luOvEnter(s.fiIter, m)
  const lmark = luOvLocalEnter(s.fiIter, loc)
  const known = knownArmEnter(s.fiIter, i)
  forInPairBox = if boxV { row } else { null }
  const r = emitForInStmt(s, stmtIx, fnIx)
  forInPairBox = null
  knownArmLeave(known)
  luOvLocalLeave(lmark)
  luOvLeave(mark)
  if r < 0 { return -1 }
  if only { return 1 }
  fbElse()
  if emitMapUnionForArm(s, stmtIx, fnIx, arms, cur0, i + 1, false) < 0 {
    return -1
  }
  fbEnd()
  return 1
}

// The bindings a per-arm walk knows the arm of, innermost last: inside arm `knownArmIdx[k]`'s
// walk of binding `knownArmDecl[k]`, a walk of the same binding takes that arm alone.
let knownArmDecl: i32[] = []
let knownArmIdx: i32[] = []

// Records, for the walk of `iter` at arm `i`, that its binding holds that arm throughout, when
// nothing can rebind it: no assignment anywhere writes that binding, a closure's included.
// Returns the mark `knownArmLeave` restores.
function knownArmEnter(iter: i32, i: i32): i32 {
  const mark = knownArmDecl.length
  if iter < 0 || iter >= P.nodes.length { return mark }
  const n = nodeAt(iter)
  if !(n is Ident) { return mark }
  const d = identDeclOf(iter)
  if d < 0 || elabLetAssigned(d) { return mark }
  knownArmDecl.push(d)
  knownArmIdx.push(i)
  return mark
}

function knownArmLeave(mark: i32) {
  while knownArmDecl.length > mark {
    knownArmDecl.pop()
    knownArmIdx.pop()
  }
  return 0
}

// The arm an enclosing walk knows `iter`'s binding holds, or -1.
function knownArmOf(iter: i32): i32 {
  if knownArmDecl.length == 0 || iter < 0 || iter >= P.nodes.length {
    return -1
  }
  if !(nodeAt(iter) is Ident) { return -1 }
  const d = identDeclOf(iter)
  let k = knownArmDecl.length - 1
  while k >= 0 {
    if knownArmDecl[k] == d { return knownArmIdx[k] }
    k = k - 1
  }
  return -1
}

// The row a union-of-maps walk's arm boxes the pair's value at, read by `emitForInBind`; null
// outside such a walk.
let forInPairBox: ArmElemRow | null = null

// A per-arm `for` walk's arms: each list arm's tag and wrapper heap, then how its element enters
// the element union (`eTags`: a box tag, -2 a stored box, -3 an atom widened by `eTexts`, -4 as
// read), at the element union's rep `destKind`.
type LuForPlan = {
  tags: i32[],
  heaps: i32[],
  eTags: i32[],
  eBoxes: i32[],
  eNul: boolean[],
  eTexts: string[][],
  eFrom: VKind[],
  destKind: VKind,
}

// `emitListUnionFor` over an element union that is no box (rep `k`): a string-element arm reads
// as stored, a literal-union arm widens its atom to the member string.
function emitListUnionForFlat(
  s: ForIn,
  stmtIx: i32,
  fnIx: i32,
  arms: i32[],
  k: VKind,
  toK: boolean,
): i32 {
  const plan: LuForPlan = {
    tags: [],
    heaps: [],
    eTags: [],
    eBoxes: [],
    eNul: [],
    eTexts: [],
    eFrom: [],
    destKind: k,
  }
  for m in arms {
    const t = listIsArmTag(m)
    const h = listArmHeapOf(m)
    const e = tyArrayElemIx(m)
    if (
      t < 0
      || h < 0
      || e < 0
      || listBackOfWrap(h) < 0
      || (k != "str" && k != "i32" && !toK)
    ) {
      return emitFail(
        "emitProgram: a union-of-lists `for` arm has no tag or wrapper, or its element union no rep the walk delivers",
      )
    }
    const atom = tyIsLitUnionOrLit(e)
    plan.tags.push(t)
    plan.heaps.push(h)
    plan.eTags.push(if toK { -5 } else if atom && k == "str" { -3 } else { -4 })
    plan.eFrom.push(repSigKindOfTy(e) ?? k)
    plan.eBoxes.push(-1)
    plan.eNul.push(false)
    plan.eTexts.push(if atom { tyLitMemberTexts(e) } else { [] })
  }
  return emitListUnionForLoop(s, stmtIx, fnIx, plan)
}

// The loop of `emitListUnionFor`: the box held in `#l`, one tag test, then per arm its own walk
// (`emitListUnionForArm`), the body emitted under each.
function emitListUnionForLoop(
  s: ForIn,
  stmtIx: i32,
  fnIx: i32,
  plan: LuForPlan,
): i32 {
  const hasPair = s.fiVar2 != ""
  const vSlot = declSlotTake(stmtIx, if hasPair { 4 } else { 3 })
  let paramN = 0
  if fnIx >= 0 {
    const fn = nodeAt(fnIx)
    if fn is FuncDecl { paramN = fn.fnParams.length + envSlotShift(fnIx) }
  }
  const vIdx = paramN + vSlot
  if emitExpr(s.fiIter, fnIx) < 0 { return -1 }
  fbLocalSet(vIdx + 2)
  // Inside an enclosing walk of the same binding the arm is known: its loop alone is emitted.
  const ka = knownArmOf(s.fiIter)
  const from = if ka >= 0 { ka } else { 0 }
  if (
    emitListUnionForArm(
      s,
      fnIx,
      plan,
      vSlot,
      vIdx,
      emitLetCursor,
      from,
      ka >= 0,
    )
    < 0
  ) {
    return -1
  }
  return 1
}

// Arm `i` onward of the loop's tag chain over the box in `#l`: under arm `i`'s tag, a walk of
// that arm's list, each element entering the element union at a known arm; past the last arm the
// box holds no list the union names, which a checked walk never reaches.
function emitListUnionForArm(
  s: ForIn,
  fnIx: i32,
  plan: LuForPlan,
  vSlot: i32,
  vIdx: i32,
  cur0: i32,
  i: i32,
  only: boolean,
): i32 {
  if i >= plan.tags.length {
    fbUnreachable()
    return 0
  }
  const iIdx = vIdx + 1
  const lIdx = vIdx + 2
  const hasPair = s.fiVar2 != ""
  if !only {
    fbLocalGet(lIdx)
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, plan.tags[i])
    fbI32Bin(70) // 0x46 i32.eq
    fbIf(64)
  }
  fbI32Const(0)
  fbLocalSet(iIdx)
  // The arms exclude each other, so each walk's body takes the same slots as the first's.
  emitLetCursor = cur0
  const known = knownArmEnter(s.fiIter, i)
  const hoist = loopHoistOpen(-1, s.fiBody, fnIx, s.fiDecl1, s.fiDecl2)
  if hoist < 0 { return -1 }
  fbBlock(64)
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.fiLabel)
  fbLoop(64)
  loopContDepth.push(ctrlDepth)
  loopContLabel.push(s.fiLabel)
  fbLocalGet(iIdx)
  fbLocalGet(lIdx)
  fbStructGet(uBoxIdx, 1)
  fbRefCast(plan.heaps[i])
  fbStructGet(plan.heaps[i], 1) // field 1: len
  fbI32Bin(78) // 0x4e i32.ge_s
  fbBrIf(1)
  if emitListUnionForElem(lIdx, iIdx, plan, i) < 0 { return -1 }
  fbLocalSet(vIdx)
  if hasPair {
    fbLocalGet(iIdx)
    fbLocalSet(vIdx + 3)
  }
  fbLocalGet(iIdx)
  fbI32Const(1)
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(iIdx)
  scopeBind(s.fiVar, vSlot)
  if hasPair { scopeBind(s.fiVar2, vSlot + 3) }
  if emitStmts(s.fiBody, fnIx) < 0 { return -1 }
  if hasPair { scopeUnbind() }
  scopeUnbind()
  fbBr(0)
  fbEnd()
  loopContDepth.pop()
  loopContLabel.pop()
  fbEnd()
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  loopHoistClose(hoist)
  knownArmLeave(known)
  if only { return 0 }
  fbElse()
  if emitListUnionForArm(s, fnIx, plan, vSlot, vIdx, cur0, i + 1, false) < 0 {
    return -1
  }
  fbEnd()
  return 0
}

// Arm `i`'s element read over the box in local `box` at cursor `cur`, at the element union's
// rep: a boxed element as stored, a scalar wrapped in its value box, a `null` off a nullable
// element under the null tag, an atom widened to its string.
function emitListUnionForElem(
  box: i32,
  cur: i32,
  plan: LuForPlan,
  i: i32,
): i32 {
  const heap = plan.heaps[i]
  const et = plan.eTags[i]
  if plan.eNul[i] {
    emitListUnionForRead(box, cur, heap)
    fbRefIsNull()
    fbIfRef(uBoxIdx)
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone()
    fbStructNew(uBoxIdx)
    fbElse()
  }
  if et == -4 && plan.destKind == "str" {
    emitListUnionForRead(box, cur, heap)
    fbRefAsNonNull()
  } else if et == -4 {
    emitListUnionForRead(box, cur, heap)
  } else if et == -5 {
    // A numeric literal set's member, read off an arm stored wider or apart (D17002).
    emitListUnionForRead(box, cur, heap)
    if emitNumRepNarrow(plan.eFrom[i], plan.destKind) < 0 { return -1 }
  } else if et == -3 {
    emitListUnionForRead(box, cur, heap)
    setStrScrI(0)
    if emitAtomToStrChain(plan.eTexts[i], 0, strScratchBase + 3) < 0 {
      return -1
    }
  } else {
    const row: ArmElemRow = { et: et, ebox: plan.eBoxes[i], nul: false }
    armRowBoxOpen(row)
    emitListUnionForRead(box, cur, heap)
    armRowBoxClose(row)
  }
  if plan.eNul[i] { fbEnd() }
  return 0
}

// The element at cursor `cur` of the list arm wrapped by heap `heap` in the box in local `box`.
function emitListUnionForRead(box: i32, cur: i32, heap: i32) {
  fbLocalGet(box)
  fbStructGet(uBoxIdx, 1)
  fbRefCast(heap)
  fbStructGet(heap, 0) // field 0: the backing
  fbLocalGet(cur)
  fbArrayGet(listBackOfWrap(heap))
  return 0
}

// The locals and types a `for`-in walk's unrolled copies read: the hoisted backing and `len`,
// the cursor, the loop var, the backing's array type, whether an element is recovered non-null
// (`ref.as_non_null`) as the rolled walk recovers it, whether a copy has a continue block, and
// the `let` cursor each copy starts from (set by `forInCopiesHead`).
export type ForInCopies = {
  back: i32,
  len: i32,
  cursor: i32,
  v: i32,
  backTy: i32,
  recover: boolean,
  hasCont: boolean,
  cur0: i32,
}

// The unrolled copies ahead of a hoisted list walk's rolled loop, or null for none.
export function forInCopiesOf(
  s: ForIn,
  fnIx: i32,
  lp: ForInLoop,
): ForInCopies | null {
  if (
    lp.fiHBack < 0
    || lp.hasPair
    || lp.ek == "nulnone"
    || partialUnrollCost(s.fiBody, fnIx) < 0
  ) {
    return null
  }
  const c: ForInCopies = {
    back: lp.fiHBack,
    len: lp.fiHLen,
    cursor: lp.iIdx,
    v: lp.vIdx,
    backTy: lp.backTy,
    recover: forInElemRecovers(lp.ek),
    hasCont: blockHasContinueFor(s.fiBody, s.fiLabel, false),
    cur0: 0,
  }
  return c
}

// Ahead of a hoisted list walk's rolled loop, the walk with its body copied
// `PARTIAL_UNROLL_COPIES` times per trip while that many elements remain; copy `k` binds the
// element at `cursor + k`. The rolled loop then walks the rest from the cursor this leaves.
// Emitted inside the walk's `break` block; `continue` ends its own copy.
function emitForInCopies(s: ForIn, fnIx: i32, c: ForInCopies) {
  forInCopiesHead(c)
  let k = 0
  while k < PARTIAL_UNROLL_COPIES {
    forInCopyOpen(s, c, k)
    const rc = emitStmts(s.fiBody, fnIx)
    forInCopyClose(c)
    if rc < 0 { return -1 }
    k = k + 1
  }
  return forInCopiesTail(c)
}

// The number of body copies per unrolled trip.
export function forInCopyCount(): i32 { return PARTIAL_UNROLL_COPIES }

// The unrolled trips' loop up to the first copy: its exit while fewer than a trip's elements remain.
export function forInCopiesHead(c: ForInCopies) {
  const limSlot = strI32Slot()
  fbLocalGet(c.len)
  fbI32Const(PARTIAL_UNROLL_COPIES - 1)
  fbI32Bin(107) // 0x6b i32.sub — `len` is never negative, so this cannot wrap
  fbLocalSet(limSlot)
  fbBlock(64)   // 0x02 block, void — the main loop's exit
  fbLoop(64)    // 0x03 loop, void
  fbLocalGet(c.cursor)
  fbLocalGet(limSlot)
  fbI32Bin(78)  // 0x4e i32.ge_s
  fbBrIf(1)     // leave the main loop
  c.cur0 = emitLetCursor
  return 0
}

// Copy `k` up to its body: the element at `cursor + k` bound, then its continue block if any.
export function forInCopyOpen(s: ForIn, c: ForInCopies, k: i32) {
  emitLetCursor = c.cur0
  fbLocalGet(c.back)
  fbLocalGet(c.cursor)
  if k > 0 {
    fbI32Const(k)
    fbI32Bin(106) // 0x6a i32.add
  }
  fbArrayGet(c.backTy)
  if c.recover { fbRefAsNonNull() }
  fbLocalSet(c.v)
  if c.hasCont {
    fbBlock(64) // this copy's continue block
    loopContDepth.push(ctrlDepth)
    loopContLabel.push(s.fiLabel)
  }
  return 0
}

// A copy after its body: its continue block's end.
export function forInCopyClose(c: ForInCopies) {
  if c.hasCont {
    fbEnd()
    loopContDepth.pop()
    loopContLabel.pop()
  }
  return 0
}

// The unrolled trips' loop after the last copy: the cursor stepped a trip, the back-branch, ends.
export function forInCopiesTail(c: ForInCopies) {
  emitLetCursor = c.cur0
  fbLocalGet(c.cursor)
  fbI32Const(PARTIAL_UNROLL_COPIES)
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(c.cursor)
  fbBr(0)       // next main trip
  fbEnd()       // end loop
  fbEnd()       // end block
  return 0
}

function emitBreakStmtStmt(s: BreakStmt, _stmtIx: i32) {
  // `break [label]`: branch out of a loop's wrapping block, so control resumes after the
  // whole loop. Unlabelled targets the innermost; `break @outer` scans the parallel label
  // stack from the top. A `break` outside any loop or to an unknown label fails loudly, not with a bad `br`.
  if loopBrkDepth.length == 0 {
    return emitFail("emitProgram: `break` outside a loop")
  }
  const brkAt = loopStackFind(loopBrkLabel, s.brkLabel)
  if brkAt < 0 {
    return emitFail(
      "emitProgram: `break` label does not name an enclosing loop",
    )
  }
  const blkDepth = loopBrkDepth[brkAt]
  // A value leaving a typed frame rides the `br`: the statement before this one stored it.
  if s.brkHasVal == 1 {
    let k = lvFrameDepth.length - 1
    while k >= 0 {
      if lvFrameDepth[k] == blkDepth {
        fbLocalGet(lvFrameLocal[k])
        k = 0
      }
      k = k - 1
    }
  }
  fbBr(ctrlDepth - blkDepth) // 0x0c br to the loop's wrapping block
  return 0
}

function emitContinueStmtStmt(s: ContinueStmt, _stmtIx: i32, _fnIx: i32) {
  // `continue [label]`: branch to a loop's continue target — the loop header for a
  // `while`, the inner continue block for a `for` (fall into the increment). Unlabelled
  // targets the innermost; `continue @outer` scans the label stack from the top.
  if loopContDepth.length == 0 {
    return emitFail("emitProgram: `continue` outside a loop")
  }
  const contAt = loopStackFind(loopContLabel, s.contLabel)
  if contAt < 0 {
    return emitFail(
      "emitProgram: `continue` label does not name an enclosing loop",
    )
  }
  const loopDepth = loopContDepth[contAt]
  fbBr(ctrlDepth - loopDepth) // 0x0c br to the loop's continue target
  return 0
}

// Lower a function's top-level body block at `blockIx`: every statement but the last is
// lowered normally; if the last statement is a bare value expression, it is lowered as
// the function's return value (VL's implicit-return idiom). A last statement that is
// itself a real statement is lowered unchanged. An empty body is left to existing validation.
export function emitFuncBody(blockIx: i32, fnIx: i32) {
  const b = nodeAt(blockIx)
  if b is Block {
    // Which of this function's string bindings are loop accumulators. Runs here rather
    // than in `emitFuncCode` because nothing before the body needs the answer, and the
    // set is stamped with `fnIx` so a body that never scanned cannot read a stale one.
    strAccScan(blockIx, fnIx)
    // The declaration-time address fold's table: a node index is a row at most once, but the
    // scratch slots it names are per-function, so both are cleared here.
    maFoldDeclIx = []
    maFoldWasmSlot = []
    maFoldK = []
    maFoldCursor = 0
    hmFn = -2
    // Enter the function's top-level lexical scope (mirrors `collectLocals` on the body
    // block). The emit-time scope stack drives same-named-local resolution.
    scopePush()
    const stmts = b.blkStmts
    const n = stmts.length
    // void-context discard: in a void function, a value-bearing tail is not the
    // function's result — it lowers through the ordinary statement path (`emitStmt`),
    // which evaluates it for effect and drops what it leaves. Keyed on the function's void
    // classification (`fRetVoid`), never on the tail's shape.
    let bodyIsVoid = false
    const vfPos = fnStmtsPosOf(fnIx)
    if vfPos >= 0 && vfPos < fRetVoid.length {
      if fRetVoid[vfPos] == 1 { bodyIsVoid = true }
    }
    let i = 0
    while i < n {
      // Only an expression body's statement, or a last `return`, ends the body as its tail does.
      const isLast = i == n - 1
        && !bodyIsVoid
        && (!isBlockBody(blockIx) || nodeAt(stmts[i]) is RetStmt)
      // Banked after whichever arm lowers it: an implicit return leaves through
      // `emitReturnExit`, so hooking the plain arm alone missed the tail statement.
      const tlAt = curBuf.length
      if isLast && blockTailIsDead(stmts) {
        if emitDeadTail(stmts, fnIx) < 0 {
          scopePop()
          return -1
        }
      } else if isLast && stmtIsTailValue(stmts[i], fnIx) {
        // Implicit return: seed the return context + push the value (so a trailing
        // `null` / nullable value boxes or sentinels exactly like `return e`), then
        // terminate the exit.
        if emitTailReturnExit(stmts[i], fnIx) < 0 {
          scopePop()
          return -1
        }
      } else if isLast && lastStmtIsValueIf(stmts[i], fnIx) {
        // The body ends in an `if`/`else` whose arms each yield a value (implicit
        // return) rather than `return`ing — lower it tail-aware so each arm's trailing
        // value expression becomes the function's return.
        if emitIfTail(stmts[i], fnIx) < 0 {
          scopePop()
          return -1
        }
      } else if isLast && memberCallYieldsValue(stmts[i]) {
        // D1240 — the tail member call of a non-void function is its result (`isLast` is
        // already gated on `!bodyIsVoid`), so it takes the same exit as any other tail
        // value — else the discard arm in `emitCallStmt` drops it under a functype that
        // promises a result, a trap where a refusal belongs.
        if emitReturnExit(stmts[i], fnIx) < 0 {
          scopePop()
          return -1
        }
      } else if isLast && elseLessNullableTail(stmts[i], fnIx) {
        // the body ends in an else-less `if` whose then-arm yields a value and whose
        // return type is nullable: lower it tail-aware (the then-arm returns its value);
        // the false fall-through is lowered as `null` by the function-end padding. Gated
        // on the final `fRetVoid`/nullable classification, unlike the fixpoint-feeding predicates.
        if emitIfTail(stmts[i], fnIx) < 0 {
          scopePop()
          return -1
        }
      } else {
        voidTailAt = -1
        if bodyIsVoid && i == n - 1 { voidTailAt = stmts[i] }
        const rcIn = emitStmtIn(stmts, i, fnIx)
        voidTailAt = -1
        if rcIn < 0 {
          scopePop()
          return -1
        }
      }
      bankBodyStmtSpan(stmts[i], fnIx, tlAt, curBuf.length)
      // A statically-TRUE `is` guard that always returns ends this instance's body.
      if monoStaticGuardEndsBlock(stmts[i], fnIx) {
        fbUnreachable() // 0x00 (dead padding — the cut path never runs)
        // D932 — the truncated statements' `let`s still own their collect-allocated
        // slots; a sibling emitted after this BLOCK (not after the function) would
        // otherwise bind one slot early. See `cursorSlotsUnder`.
        let cutAt = i + 1
        while cutAt < n {
          cursorAdvance(cursorSlotsUnder(stmts[cutAt]))
          cutAt = cutAt + 1
        }
        i = n
      } else {
        i = i + 1
      }
    }
    scopePop()
    return 0
  }
  return emitFail("emitProgram: function has no block body")
}

// The `Index` node `emitExpr` is lowering under `emitIndexBanked`, so the re-entry lowers it.
let idxSpanNode = -1

// Whether element reads bank their own `vl-src` row: only when the section is written at all.
// Whether element reads bank their own rows: names and the source map are emitted.
export function idxSpanOn(): boolean {
  return gEmitNames != 0 && gEmitSrcMap != 0
}

// Whether element reads note their rows: for the `vl-src` section, or for the armed IR shadow.
export function idxRowsOn(): boolean { return idxSpanOn() || irShadowOn }

// Lowers element read `exprIx` and banks its byte range as an element-read span row, so a
// trap in it resolves to the read's own column rather than its statement's. Adds no code:
// the row lands only in the `vl-src` section, and only when `body` is the buffer written.
function emitIndexBanked(exprIx: i32, fnIx: i32): i32 {
  const outer = idxSpanNode
  const from = curBuf.length
  const direct = curBuf.length == from
  idxSpanNode = exprIx
  const r = emitExpr(exprIx, fnIx)
  idxSpanNode = outer
  const to = curBuf.length
  if r < 0 || !direct || to <= from { return r }
  let pos = -1
  if fnIx >= 0 { pos = fnStmtsPosOf(fnIx) }
  if !idxSpanOn() {
    shIdxNode.push(exprIx)
    shIdxFrom.push(from)
    shIdxTo.push(to)
    return r
  }
  bankSpanRow(exprIx, pos, from, to, 6, "")
  return r
}

// Banks a statement's byte range, so a trap frame resolves to the line the instruction came
// from rather than the declaration. Kind 5 inside a function, kind 1 at module scope — the row
// `emitStartFnCode` already banks there. A statement that emitted no bytes gets no row.
function bankBodyStmtSpan(stmtIx: i32, fnIx: i32, from: i32, to: i32) {
  if to <= from { return 0 }
  if fnIx < 0 { return bankSpanRow(stmtIx, -1, from, to, 1, "") }
  return bankSpanRow(stmtIx, fnStmtsPosOf(fnIx), from, to, 5, "")
}

// Lower every statement of the block at `blockIx` onto `body`, in order. Returns 0,
// or -1 (via `emitFail`) on a non-block node or an unsupported statement within.
function emitStmts(blockIx: i32, fnIx: i32) {
  const b = nodeAt(blockIx)
  if b is Block {
    // A nested block (if-then / if-else / while-body) is its own lexical scope (mirrors
    // `collectLocals` recursing into it): push a frame so its `let`s shadow correctly and
    // are dropped on exit.
    scopePush()
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      // The statement's own byte range, so a trap frame names the line the instruction came
      // from rather than the declaration (ROADMAP row 22). Offsets are relative to `body`;
      // `emitFuncCode` rebases them onto the module with the rest of this frame's rows.
      const stmtAt = curBuf.length
      if emitStmtIn(stmts, i, fnIx) < 0 {
        scopePop()
        return -1
      }
      bankBodyStmtSpan(stmts[i], fnIx, stmtAt, curBuf.length)
      if monoStaticGuardEndsBlock(stmts[i], fnIx) {
        fbUnreachable() // 0x00 — see `monoStaticGuardEndsBlock`
        // D932 — slot accounting over the truncated tail; see `cursorSlotsUnder`.
        let cutAt = i + 1
        while cutAt < stmts.length {
          cursorAdvance(cursorSlotsUnder(stmts[cutAt]))
          cutAt = cutAt + 1
        }
        i = stmts.length
      } else {
        i = i + 1
      }
    }
    scopePop()
    return 0
  }
  return emitFail("emitProgram: function has no block body")
}

// Lower a block at `blockIx` that sits in tail position (its value is the enclosing
// function's return value). Every statement but the last is lowered normally; the last
// is lowered tail-aware via `emitStmtTail`. The structured-block analogue of
// `emitFuncBody`'s top-level implicit-return handling.
function emitStmtsTail(blockIx: i32, fnIx: i32) {
  const b = nodeAt(blockIx)
  if b is Block {
    const stmts = b.blkStmts
    const n = stmts.length
    if n == 0 { return emitFail("emitProgram: empty block in tail position") }
    // A tail-position nested block is its own lexical scope too (mirrors `collectLocals`).
    scopePush()
    let i = 0
    let cut = false
    while i < n - 1 {
      if emitStmtIn(stmts, i, fnIx) < 0 {
        scopePop()
        return -1
      }
      if monoStaticGuardEndsBlock(stmts[i], fnIx) {
        fbUnreachable() // 0x00 — see `monoStaticGuardEndsBlock`
        // D932 — slot accounting over the truncated tail (the un-emitted tail
        // statement included); see `cursorSlotsUnder`.
        let cutAt = i + 1
        while cutAt < n {
          cursorAdvance(cursorSlotsUnder(stmts[cutAt]))
          cutAt = cutAt + 1
        }
        cut = true
        i = n - 1
      } else {
        i = i + 1
      }
    }
    let rc = 0
    if !cut && blockTailIsDead(stmts) { rc = emitDeadTail(stmts, fnIx) }
    else if !cut { rc = emitStmtTail(stmts[n - 1], fnIx) }
    scopePop()
    return rc
  }
  return emitFail("emitProgram: function has no block body")
}

// Lowers a dead tail as `unreachable`, keeping the slots its locals own; a nested function
// declaration still takes the statement path. Returns 0, or -1.
function emitDeadTail(stmts: i32[], fnIx: i32): i32 {
  const t = stmts[stmts.length - 1]
  if nodeAt(t) is FuncDecl {
    if emitStmtIn(stmts, stmts.length - 1, fnIx) < 0 { return -1 }
  } else {
    cursorAdvance(cursorSlotsUnder(t))
  }
  fbUnreachable() // 0x00 — the predecessor exited
  return 0
}

// Lower the single statement at `stmtIx` in TAIL position. A bare tail value becomes
// `emitExpr` + `return`; a nested `if`/`else` recurses tail-aware into its arms; any
// other statement (an explicit `return`, a `while`, etc.) is lowered unchanged by
// `emitStmt` (it already exits or falls through on its own). Returns 0, or -1.
function emitStmtTail(stmtIx: i32, fnIx: i32) {
  const s = nodeAt(stmtIx)
  if s is IfStmt { return emitIfTail(stmtIx, fnIx) }
  if stmtIsTailValue(stmtIx, fnIx) {
    // An if-tail arm's implicit return — seed the return context (so a `null` arm
    // boxes / sentinels per the function's return type) exactly like `emitFuncBody`.
    return emitTailReturnExit(stmtIx, fnIx)
  }
  // D1240 — an if-ARM tail member call is a value for the same reason a body tail is: this
  // path is reached only from `emitIfTail`, i.e. only where the arms ARE the result.
  if memberCallYieldsValue(stmtIx) { return emitReturnExit(stmtIx, fnIx) }
  return emitStmt(stmtIx, fnIx)
}

// Why `emitIfTail` writes link `ix` other than as a void `if` whose arms each return, or "": an
// integer `match` chain, or one wider number returned boxed once (`retIfIsOneNumber`). An
// else-less link writes no `else`, its caller padding what falls through. Its condition is
// `emitGuardCond`'s, a decided `false` (`isDecidedFalse`) writing no then arm.
export function tailIfPlainWhy(ix: i32, fnIx: i32): string {
  if ix < 0 || ix >= P.nodes.length { return "tail if node" }
  const n = nodeAt(ix)
  if !(n is IfStmt) || n.ifCond < 0 { return "tail if node" }
  if intMatchHeadAt(ix) { return "tail if switch" }
  if retIfIsOneNumber(ix, fnIx) { return "tail if one number" }
  return ""
}

// Lower an `if`/`else` at `stmtIx` whose value is the function's return value (tail
// position): each arm is lowered with its last statement tail-aware (`emitStmtsTail`).
// Mirrors `emitStmt`'s void-if shape, but routes the arm bodies through the tail path.
function emitIfTail(stmtIx: i32, fnIx: i32) {
  // A join typed one wider number returns as that number, boxed once (D3656).
  if retIfIsOneNumber(stmtIx, fnIx) { return emitTailReturnExit(stmtIx, fnIx) }
  // An `else if` chain is lowered along its spine, as `emitIfStmtStmt` lowers one (D1990).
  const open: i32[] = []
  let cur = stmtIx
  while cur >= 0 {
    const at = cur
    cur = -1
    if at < 0 || at >= P.nodes.length {
      return emitFail("emitProgram: emitIfTail: not an if statement")
    }
    const sw = emitIntSwitch(at, fnIx, 1, 64, "i32", -1)
    if sw < 0 { return -1 }
    if sw == 0 {
      const s = nodeAt(at)
      if s is IfStmt {
        const rc = emitIfLinkTail(s, fnIx, open)
        if rc < 0 { return -1 }
        if rc == 1 { cur = s.ifElse }
      } else {
        return emitFail("emitProgram: emitIfTail: not an if statement")
      }
    }
  }
  return closeIfChainFrames(open, 0, false)
}

// One link of `emitIfTail`'s chain, with `emitIfLinkStmt`'s contract: 0 closed, -1 failed, 1
// left open for the next link with its else restore target pushed onto `open`.
function emitIfLinkTail(s: IfStmt, fnIx: i32, open: i32[]) {
  // D932 — the tail-position twin of `emitIfStmtStmt`'s dead-arm skip, same byte-read
  // gate (`emittedCondConst`), same slot accounting (`cursorSlotsUnder`). The tail form
  // is the same defect one position over: `function f(v) { if v is string { "\"" + v }
  // else { "o" } }` emitted the statically-false arm's narrowed use in the i32 instance.
  const staticGuard = emitGuardCond(s.ifCond, fnIx)
  if staticGuard == -2 { return -1 }
  fbIf(64) // 0x04 if, 0x40 void blocktype
  if staticGuard != 0 {
    if emitStmtsTail(s.ifThen, fnIx) < 0 { return -1 }
  } else {
    cursorAdvance(cursorSlotsUnder(s.ifThen))
  }
  if s.ifElse >= 0 && staticGuard != 1 {
    fbElse() // 0x05 else
    // A VALUE union narrows to the COMPLEMENT set in the else-arm (see emitStmt).
    const els = nodeAt(s.ifElse)
    if (els is IfStmt && !retIfIsOneNumber(s.ifElse, fnIx)) {
      // `else if`: the next link, still in tail position.
      open.push(-1)
      return 1
    }
    if els is IfStmt {
      if emitTailReturnExit(s.ifElse, fnIx) < 0 { return -1 }
    } else if els is Block {
      if emitStmtsTail(s.ifElse, fnIx) < 0 { return -1 }
    } else {
      if emitStmtTail(s.ifElse, fnIx) < 0 { return -1 }
    }
  } else if s.ifElse >= 0 {
    cursorAdvance(cursorSlotsUnder(s.ifElse))
  }
  fbEnd() // 0x0b end
  return 0
}

// `global.get` of heap-window global `which` (0 base, 1 limit). A miss is the scan and the
// section disagreeing about whether the pair exists, which no program can spell.
function emitHeapWindowRead(nArgs: i32, which: i32, name: string) {
  if nArgs != 0 {
    return emitFail(
      "emitProgram: internal: "
        + name
        + " reached with arguments — the checker's arity rule refuses it",
    )
  }
  if gHeapGlobalIdx < 0 {
    return emitFail(
      "emitProgram: "
        + name
        + " read, but the heap-window globals were not emitted",
    )
  }
  fbGlobalGet(gHeapGlobalIdx + which)
  return 0
}

// The wasm global index of the user global at `globalStmts` position `gi`. Imported globals
// (`extern let`) occupy 0..nImp-1 and answer their link row; the string-literal pool follows,
// then the defined cells. A promoted (G2c) or imported binding emits no cell, so survivors
// are re-densified by `gCellIdx`.
export function userGlobalIdx(gi: i32) {
  const nImp = externGlobalCount()
  if gi < 0 || gi >= gCellIdx.length { return nImp + gStrPoolTexts.length + gi }
  if nImp > 0 {
    const link = externGlobalLinkOfNode(globalStmts[gi])
    if link >= 0 { return link }
  }
  return nImp + gStrPoolTexts.length + gCellIdx[gi]
}

// How a read of module global `gi` is stored: its folded immediate, its promoted local, a
// `global.get` behind an init guard, or a plain `global.get`. `emitUserGlobalGet` and the IR
// lowering both match on it, so the storage class stays one decision.
export type GlobalReadClass = "fold" | "promo" | "guard" | "plain"
export function userGlobalReadClass(gi: i32, c: GlobalCtx): GlobalReadClass {
  if gi >= 0 && gi < gFoldOk.length && gFoldOk[gi] == 1 { return "fold" }
  if gi >= 0 && gi < gPromoOk.length && gPromoOk[gi] == 1 { return "promo" }
  if initGuardNeeded(gi, false, c) { return "guard" }
  return "plain"
}

// Where a global access is emitted: in the start function's top-level statements, else in the
// body at `fnStmts` slot `gcFnPos`; `gcGuardOff` while an assignment re-reads what it stored.
export type GlobalCtx = {
  gcInStart: boolean,
  gcFnPos: i32,
  gcGuardOff: boolean,
}

// The context of the access legacy's emitter is writing now.
export function globalCtxNow(): GlobalCtx {
  const c: GlobalCtx = {
    gcInStart: gPromoInStart,
    gcFnPos: emitCurFnPos,
    gcGuardOff: initGuardOff,
  }
  return c
}

// Sets the held coercion mark to `ix`, returning the one it replaces: the shadow's firing control.
export function coerceHeldSwap(ix: i32): i32 {
  const was = coerceHeld
  coerceHeld = ix
  return was
}

// The legacy context an expression fragment rooted at `root` would read, or "": ir-design §10.2.1.
// A held coercion or storage read reaches it only on its root, a staged operand only inside it, an
// open list-build region only through a counted push inside it. The seats are spent or inert, the
// lexical frames hold no `for`, and the shared tails read `listCastForPush` live as legacy does.
export function legacyContextLiveWhy(root: i32): string {
  if coerceHeld >= 0 && coerceHeld == root { return "coerceHeld on the root" }
  if isStorageRead(root) { return "storage read of the root" }
  if isRecvStagedIx >= 0 && nodeContains(root, isRecvStagedIx) {
    return "staged is receiver"
  }
  if listGetIdxStagedIx >= 0 && nodeContains(root, listGetIdxStagedIx) {
    return "staged list get"
  }
  if listGetRecvStagedIx >= 0 && nodeContains(root, listGetRecvStagedIx) {
    return "staged list get"
  }
  // A root reading a capture stand-in would owe `listFitStoodIn` as the door's output.
  if root >= 0 && root < P.nodes.length && nodeAt(root) is Ident {
    return "identifier root"
  }
  let k = 0
  while k < lbPush.length {
    const r = lbPushOf[k]
    if (
      r >= 0
      && r < lbEnd.length
      && lbEnd[r] >= 0
      && nodeContains(root, lbPush[k])
    ) {
      return "counted push"
    }
    k = k + 1
  }
  return ""
}

// How a write of module global `gi` is stored: its promoted local, a refused store to an
// immutable cell, a `global.set` behind an init guard, or a plain one; any of the last two is
// followed by its init bit when `initBitOf(gi)` has one.
export type GlobalWriteClass = "promo" | "immutable" | "guard" | "plain"
export function userGlobalWriteClass(gi: i32, c: GlobalCtx): GlobalWriteClass {
  if gi >= 0 && gi < gPromoOk.length && gPromoOk[gi] == 1 { return "promo" }
  if globalCellIsImmutable(gi) { return "immutable" }
  // A write a function can make before the initializer ran would be overwritten by it (D2654);
  // the start function's own writes are its initializers and the checker orders the rest.
  if !c.gcInStart && initGuardNeeded(gi, true, c) { return "guard" }
  return "plain"
}

// The start-function local promoted global `gi` lives in, in context `c`; -1 outside the start
// function, whose frame alone holds it, or for a global with no promoted slot.
export function promoSlotIn(gi: i32, c: GlobalCtx): i32 {
  if !c.gcInStart || gi < 0 || gi >= gPromoSlot.length { return -1 }
  return gPromoSlot[gi]
}

// the storage-class chokepoint for a user top-level binding: every user cell's `0x23`/`0x24`
// goes through this pair, so cell, local or immediate is one decision no emit site can bypass.
// A promoted binding read outside the start function's frame is rejected loudly; a folded
// const is its immediate, never uninitialised, so it takes no guard.
export function emitUserGlobalGet(gi: i32) {
  const c = globalCtxNow()
  match userGlobalReadClass(gi, c) {
    "fold" => {
      return emitFoldedConstRead(gi)
    }
    "promo" => {
      const ps = promoSlotIn(gi, c)
      if ps < 0 {
        return emitFail(
          "emitProgram: promoted top-level binding read outside the top-level statement list",
        )
      }
      fbLocalGet(ps)
      return 0
    }
    "guard" => {
      if emitInitGuard(gi, "read") < 0 { return -1 }
    }
    "plain" => {}
  }
  fbGlobalGet(userGlobalIdx(gi))
  return 0
}

// Writes the immediate `captureFoldedConsts` banked for folded const `gi`. A read before the
// capture ran has no cell to fall back on, so it fails loudly.
export function emitFoldedConstRead(gi: i32) {
  if gi >= gFoldAt.length || gi >= gFoldLen.length || gFoldAt[gi] < 0 {
    return emitFail(
      "emitProgram: a folded module const read before its value was captured",
    )
  }
  const at = gFoldAt[gi]
  const end = at + gFoldLen[gi]
  if end > gFoldPool.length {
    return emitFail(
      "emitProgram: a folded module const read past its banked bytes",
    )
  }
  relFoldNote(gi)
  let k = at
  while k < end {
    wU8(gFoldPool[k])
    k = k + 1
  }
  return 0
}

// Set while an assignment's value re-reads the global it just stored (`emitBinExprNode`).
let initGuardOff = false

// The earliest top-level position at which `fnStmts[p]` can run: its own, else its enclosing
// frame's or its instance origin's, `INIT_REACH_NEVER` when no top-level code names any of them.
function initFnReachOf(p: i32): i32 {
  let best = INIT_REACH_NEVER
  let cur = p
  let steps = 0
  while cur >= 0 && cur < gInitFnReach.length && steps <= gInitFnReach.length {
    if gInitFnReach[cur] < best { best = gInitFnReach[cur] }
    let up = -1
    if cur < fnParent.length { up = fnParent[cur] }
    if up < 0 && cur < fnInstOrigin.length { up = fnInstOrigin[cur] }
    cur = up
    steps = steps + 1
  }
  return best
}

// Whether a read (a write, when `write`) of guarded global `gi` in context `c` can run before it
// holds its value: in the start function, at or before its declaration (the checker orders the
// rest); in a function body, when top-level code at or before `gInitAt[gi]` can call it, or when
// no top-level code names it at all.
function initGuardNeeded(gi: i32, write: boolean, c: GlobalCtx): boolean {
  if !gInitAny || c.gcGuardOff { return false }
  if gi < 0 || gi >= gInitGuard.length || gi >= globalStmtOrd.length {
    return false
  }
  if gInitGuard[gi] != 1 && !(write && gInitGuard[gi] == 2) { return false }
  // No initializer runs later to overwrite an early write.
  const d = nodeAt(globalStmts[gi])
  if d is LetDecl {
    if write && d.letInit < 0 { return false }
  }
  if c.gcInStart {
    return gInitStartOrd >= 0 && gInitStartOrd <= globalStmtOrd[gi]
  }
  if c.gcFnPos < 0 || gi >= gInitAt.length { return false }
  const r = initFnReachOf(c.gcFnPos)
  return r == INIT_REACH_NEVER || r <= gInitAt[gi]
}

// The value the progress cell holds once global `gi` has its value: one past its rank.
export function initGuardValue(gi: i32): i32 {
  if gi < 0 || gi >= gInitRank.length { return gi + 1 }
  return gInitRank[gi] + 1
}

// The source name of the function being lowered, for the guard's `via` clause: its declared
// name, else its instance origin's, else the binding a lambda is bound to, else "".
function initGuardFnName(p: i32): string {
  let cur = p
  let steps = 0
  while cur >= 0 && cur < fnStmts.length && steps <= fnStmts.length {
    const tk = declNameTokOf(fnStmts[cur])
    if tk >= 0 && tk < P.toks.length { return P.toks[tk].text }
    if cur < fnDispNames.length && fnDispNames[cur] != "" {
      return fnDispNames[cur]
    }
    // A monomorphized instance keeps its origin's name before the `$` its pin appends.
    const fd = nodeAt(fnStmts[cur])
    if fd is FuncDecl {
      let cut = 0
      while cut < fd.fnName.length && fd.fnName[cut] != '$' { cut = cut + 1 }
      const base = fd.fnName.slice(0, cut)
      if base != "" && base.slice(0, 8) != "__lambda" { return base }
    }
    let up = -1
    if cur < fnInstOrigin.length { up = fnInstOrigin[cur] }
    cur = up
    steps = steps + 1
  }
  return ""
}

// The `gInitGNames`/`gInitGLocs` row of global `gi`, interned on first use: its source
// name, and where it is declared.
function initGuardGlobalRow(gi: i32): i32 {
  let k = 0
  while k < gInitGIdx.length {
    if gInitGIdx[k] == gi { return k }
    k = k + 1
  }
  const text = initGuardGlobalText(gi)
  gInitGIdx.push(gi)
  gInitGNames.push(text[0])
  gInitGLocs.push(text[1])
  return gInitGIdx.length - 1
}

// Global `gi`'s guard texts: its quoted source name, and where it is declared.
export function initGuardGlobalText(gi: i32): string[] {
  const d = nodeAt(globalStmts[gi])
  let name = ""
  if d is LetDecl { name = d.letName }
  let tk = declNameTokOf(globalStmts[gi])
  if tk >= 0 && tk < P.toks.length { name = P.toks[tk].text }
  if tk < 0 && globalStmts[gi] < nodeToks.length {
    tk = nodeToks[globalStmts[gi]]
  }
  let where = ""
  if tk >= 0 && tk < P.toks.length {
    const file = srcmapFileOfTok(tk)
    if file == "" {
      where = " (line " + i32ToStr(P.toks[tk].line) + ")"
    } else {
      where = " (" + file + ":" + i32ToStr(P.toks[tk].line) + ")"
    }
  }
  return ["`" + name + "` ", where]
}

// The `gInitReaders` row naming the function being lowered (empty in the start function),
// interned on first use.
function initGuardReaderRow(): i32 {
  let via = ""
  if !gPromoInStart {
    const fname = initGuardFnName(emitCurFnPos)
    if fname == "" { via = ", via a closure" } else { via = ", via " + fname }
  }
  let k = 0
  while k < gInitReaders.length {
    if gInitReaders[k] == via { return k }
    k = k + 1
  }
  gInitReaders.push(via)
  return gInitReaders.length - 1
}

// Calls `__init_fail__` when the progress cell has not yet passed global `gi` (D2652);
// `verb` is "read" or "written".
function emitInitGuard(gi: i32, verb: string) {
  if gInitProgIdx < 0 || gHelpInitFail < 0 || gImports < 4 {
    return emitFail("emitProgram: read-before-init guard with no progress cell")
  }
  // A binding with no initializer holds its value from its first write, wherever that ran.
  const bit = initBitOf(gi)
  if bit >= 0 {
    fbGlobalGet(bit)
    fbI32Eqz()
  } else {
    fbGlobalGet(gInitProgIdx)
    fbI32RelOf(RS_GUARD, gi, initGuardValue(gi) + relSkew(RS_GUARD))
    fbI32Bin(72) // 0x48 i32.lt_s
  }
  fbIf(64)              // 0x40 void
  fbI32RelOf(RS_GNAME, gi, initGuardGlobalRow(gi) + relSkew(RS_GNAME))
  if verb == "written" { fbI32Const(1) } else { fbI32Const(0) }
  const rr = initGuardReaderRow()
  fbI32RelOf(RS_GREAD, rr, rr + relSkew(RS_GREAD))
  fbCall(gHelpInitFail) // never returns
  fbEnd()
  return 0
}

// The write half of the chokepoint above — `local.set` into the start function's frame
// for a promoted binding, else `global.set` of its cell.
export function emitUserGlobalSet(gi: i32) {
  const c = globalCtxNow()
  match userGlobalWriteClass(gi, c) {
    "promo" => {
      const ps = promoSlotIn(gi, c)
      if ps < 0 {
        return emitFail(
          "emitProgram: promoted top-level binding written outside the top-level statement list",
        )
      }
      fbLocalSet(ps)
      return 0
    }
    // An immutable cell is written only by its constexpr; a store here would be invalid wasm.
    "immutable" => {
      return emitFail("emitProgram: a store to an immutable module const")
    }
    "guard" => {
      if emitInitGuard(gi, "written") < 0 { return -1 }
    }
    "plain" => {}
  }
  fbGlobalSet(userGlobalIdx(gi))
  const bit = initBitOf(gi)
  if bit >= 0 {
    fbI32Const(1)
    fbGlobalSet(bit)
  }
  return 0
}

// The assigned bit of global `gi`, or -1 when it has none.
export function initBitOf(gi: i32): i32 {
  if gi < 0 || gi >= gInitBitIdx.length || gInitBitBase < 0 { return -1 }
  const o = gInitBitIdx[gi]
  if o < 0 { return -1 }
  return gInitBitBase + o
}

// Puts this module's per-compile stashes, depths and memo cursors back to their declared
// values: an earlier compile that stopped on a failure path may have left one set.
export function wasmEmitStateReset() {
  callRefLegacyPlain = Map()
  callRefLastPlain = false
  luOvLocNodes = []
  knownArmDecl = []
  knownArmIdx = []
  forInPairBox = null
  luOvLocSlots = []
  coerceHeld = -1
  asgParkedSlot = -1
  asgParkedRef = false
  asgParkWanted = false
  asgParkedOwner = -1
  mapSetDidPark = false
  rcElem = rcElemNone()
  rcLoopDepth = 0
  boxSeat = -1
  armSeat = -1
  armServed = -1
  atomSeat = -1
  arrNewFillDepth = 0
  eqStashL = -1
  eqStashR = -1
  forIterLits = Map()
  forIterScanned = 0
  hmFn = -2
  hmIdxSeen = 0
  idxSpanNode = -1
  initGuardOff = false
  letSibPos = -1
  letSibStmts = []
  lmaAddrK = 0
  lmaAddrNode = -1
  lmaAddrRest = -1
  lmaCallerFn = -1
  lmaValArg = -1
  lmaValNode = -1
  coerceHeld = -1
  rawReadNode = -1
  mfSrcSlot = -1
  mfSvDst = -1
  negGuardCond = -1
  negGuardFn = -1
  negGuardVal = -1
  njBin = -1
  njDepth = 0
  njLIx = -1
  njLLit = false
  njLSlot = -1
  njLTys = []
  njLUnion = false
  njOp = ""
  njRIx = -1
  njRLit = false
  njRSlot = -1
  njRTys = []
  njRUnion = false
  njResBox = false
  nulAtomTyMemoReset()
  saFnIx = 0 - 2
  ssArmBin = -1
  ssArmMode = 0
  ssArmRhs = -1
  voidTailAt = -1
  return 0
}

// Emit `print(<string expr>)`: stream each code point through `__print_char__`, then one
// `__print_str_flush__`. Factored from the print handler so the literal-union widening can reuse it.
function emitPrintStrExpr(strExpr: i32, fnIx: i32) {
  if emitExpr(strExpr, fnIx) < 0 { return -1 }
  return printStrTail()
}

// After a string `print` argument's value: its code points streamed through `__print_char__`,
// then one `__print_str_flush__`.
export function printStrTail(): i32 {
  fbLocalSet(strScratchBase + 0)
  return emitPrintStrFromScratch()
}

// The literal text `null`, streamed through the same `__print_char__`/`__print_str_flush__`
// pair `print(<string>)` uses, through no scratch frame — a constant text needs neither a
// string-ref slot nor loop counters. The null branch of the two nullable-niche prints below.
function emitPrintNullWord() {
  fbI32Const(110) // 'n'
  fbCall(2)       // __print_char__
  fbI32Const(117) // 'u'
  fbCall(2)
  fbI32Const(108) // 'l'
  fbCall(2)
  fbI32Const(108) // 'l'
  fbCall(2)
  fbCall(3)       // __print_str_flush__
  return 0
}

// `print(<string | null>)`. The niche rep is a `(ref null $sTypeIdx)`; the plain string arm
// below streams it unconditionally and would trap on a genuine null, so this arm exists to
// handle it. One `br_on_null` covers the argument in a single evaluation — there is no
// nullable string local to stash it in, and re-evaluating would call a `string | null`-returning function twice.
function emitPrintNulString(argIx: i32, fnIx: i32) {
  printNulStrOpen()
  // The RAW nullable ref: the argument is typed `string | null`, so its read stays raw
  // (`nulStrReadRecovers`) and `br_on_null` sees the null a recovery would trap on.
  if emitExpr(argIx, fnIx) < 0 { return -1 }
  return printNulStrTail()
}

// Before a `print` of a `string | null`: the `$out` block, then the `$null` block.
export function printNulStrOpen(): i32 {
  fbBlock(64) // $out
  fbBlock(64) // $null
  return 0
}

// After a `print` argument's raw `string | null`: a null branches to the word `null`, a string
// streams its code points, and both leave through `$out`.
export function printNulStrTail(): i32 {
  fbBrOnNull(0) // → $null (the enclosing block)
  fbLocalSet(strScratchBase + 0)
  if emitPrintStrFromScratch() < 0 { return -1 }
  fbBr(1) // → $out
  fbEnd()
  emitPrintNullWord()
  fbEnd()
  return 0
}

// `print(v)` over a nullable ref niche whose other arm has no printed form (D3498): the word
// `null` after a run-time test, and a trap when the value is not null, which a checked program
// never reaches, since no text would be right for it.
function emitPrintNulRefNiche(argIx: i32, fnIx: i32) {
  if emitExpr(argIx, fnIx) < 0 { return -1 }
  fbRefIsNull()
  fbIf(64)
  emitPrintNullWord()
  fbElse()
  fbUnreachable()
  fbEnd()
  return 0
}

// `print(<boolean | null>)`. The niche rep is an i32 with sentinel 2 for null; the fallback
// ladder would route it to `__print_bool__`, which renders any non-zero as true, so a null
// silently printed true without this arm. A `br_table` on the niche value itself is already
// the arm index (0 false, 1 true, 2 null), evaluating the argument once with no scratch needed.
function emitPrintNulBool(argIx: i32, fnIx: i32) {
  fbBlock(64) // $out
  fbBlock(64) // $null
  fbBlock(64) // $true
  fbBlock(64) // $false
  if emitExpr(argIx, fnIx) < 0 { return -1 }
  wU8(14)     // 0x0e br_table
  wULEB(3)    // three indexed targets, then the default
  wULEB(0)    // 0 → $false (depth 0 from here)
  wULEB(1)    // 1 → $true
  wULEB(2)    // 2 → $null
  wULEB(2)    // default → $null (unreachable: the niche is 0/1/2)
  fbEnd()
  fbI32Const(0)
  fbCall(1)   // __print_bool__ → "false"
  fbBr(2)     // → $out
  fbEnd()
  fbI32Const(1)
  fbCall(1)   // __print_bool__ → "true"
  fbBr(1)     // → $out
  fbEnd()
  emitPrintNullWord()
  fbEnd()
  return 0
}

// The members a `print` of the atom `argIx` (arm `atom` or `nulAtom`) decodes at, which legacy's
// print and the IR's both spend. `litAtomWidenTexts` is `emitAtomToStr`'s ladder; its declaration
// rung is what a monomorphized instance needs, its leaves recording the generic's parameter.
export function printAtomTexts(arm: PrintArm, argIx: i32, fnIx: i32): string[] {
  if arm == "nulAtom" { return nulLitAtomTexts(argIx, fnIx) }
  return litAtomWidenTexts(argIx, fnIx)
}

// The print of the atom id stashed in str-op scratch i32 slot 0: its decode at `texts` through the
// shared tower, which reads the id once where a per-member chain would re-run `print(f())`'s call,
// then the stream; behind the `-1` null word where `nul`. Returns 0, or -1 failed.
function printAtomStashed(texts: string[], nul: boolean): i32 {
  if !nul {
    // No texts means the rep and the recorded type disagree: the chain would match nothing.
    if texts.length == 0 {
      return emitFail(
        "emitProgram: print of a literal-union atom whose type carries no member texts",
      )
    }
    return emitPrintAtomFromStash(texts)
  }
  pushStrScrI(0)
  fbI32Const(-1)
  fbI32Bin(70) // 0x46 i32.eq
  fbIf(64)     // if (void)
  emitPrintNullWord()
  fbEnd()
  pushStrScrI(0)
  fbI32Const(-1)
  fbI32Bin(71) // 0x47 i32.ne
  fbIf(64)     // if (void)
  if emitPrintAtomFromStash(texts) < 0 { return -1 }
  fbEnd()
  return 0
}

// A `print` of an atom or its `K | null` after its operand, the id on the stack: the IR's tail.
export function printAtomTail(arm: PrintArm, argIx: i32, fnIx: i32): i32 {
  setStrScrI(0)
  return printAtomStashed(printAtomTexts(arm, argIx, fnIx), arm == "nulAtom")
}

// The stashed-id half of the atom print: the shared widen tower over str-op scratch i32 slot 0,
// then the streaming print of the string it yields. Split out so the `K | null` niche below
// reaches it from INSIDE its sentinel guard without re-evaluating the receiver.
function emitPrintAtomFromStash(texts: string[]) {
  if emitAtomToStrChain(texts, 0, strScratchBase + 3) < 0 { return -1 }
  fbLocalSet(strScratchBase + 0)
  return emitPrintStrFromScratch()
}

// `print(<K | null>)` — the atom niche: an i32 member id with `-1` for null, the same
// sentinel `emitNulIsNullTest`'s litunion arm compares against. Both arms read the stash,
// not the receiver, so one evaluation covers the sentinel test and the widen. The sentinel
// test runs first since the member arm's streaming loop reuses slot 0 as its cursor.
function emitPrintNulLitUnion(argIx: i32, texts: string[], fnIx: i32) {
  // A `K | null` read out of a wider box converts to the niche first (D7965).
  const nlk = narrowedNulLitPinBoxKey(argIx, fnIx)
  if nlk != "" {
    if emitNarrowedNicheRead(argIx, NICHE_NUL_LIT, fnIx) < 0 { return -1 }
    setStrScrI(0)
  } else if emitStashAtomId(argIx, fnIx) < 0 {
    return -1
  }
  return printAtomStashed(texts, true)
}

// one arm of the value-union print: the box is already stashed in `slot`, so recover this
// arm's payload and hand it to that rep's own `__print_*__` sink — the same sink the
// narrowed spelling `if v is i32 { print(v) }` reaches (D712), through the shared
// `emitUnionUnboxTail` recovery. The `null` arm has no payload and prints the word.
function emitPrintUnionArm(slot: i32, k: i32) {
  if k == nullValKind() { return emitPrintNullWord() }
  // A vector has no print; the checker admits the print only where it narrowed the vector
  // arm away, so the tag cannot select it.
  if k == 14 {
    fbUnreachable()
    return 0
  }
  fbLocalGet(slot)
  if emitUnionUnboxTail(k) < 0 { return -1 }
  if k == 2 {
    // The string arm streams out of the str-op scratch frame — reserved because
    // `exprHasStrOp`'s print arm asked `printUnionHasStrArm`, the SAME plan this dispatch
    // walked. A guard rather than an assumption: without the frame `strScratchBase + 0` is
    // some other local and the module fails to parse.
    if !fnUses.strOp {
      return emitFail(
        "emitProgram: print of a union with a string arm but no string scratch frame",
      )
    }
    fbLocalSet(strScratchBase + 0)
    return emitPrintStrFromScratch()
  }
  return emitPrintScalarSink(k)
}

// Print the scalar of value-atom kind `k` already on the stack through its own `__print_*__`
// import: i32, boolean, i64, f64 and f32. Any other kind has no scalar sink and fails loud.
function emitPrintScalarSink(k: i32) {
  if k == 0 {
    fbCall(0) // __print_i32__ (import 0)
    return 0
  }
  if k == 1 {
    fbCall(1) // __print_bool__ (import 1)
    return 0
  }
  // the three wide scalars route to imports whose presence is decided by the module-level
  // annotation scan: a `f64 | i32` union spells its f64 and the import is there — checked
  // anyway, since a missed flag names a nonexistent import index, invalid wasm rather than a message.
  if k == 3 {
    if !gNeedsI64Print {
      return emitFail(
        "emitProgram: print of a union with an i64 arm but no __print_i64__ import",
      )
    }
    fbCall(4) // __print_i64__ (import index 4)
    return 0
  }
  if k == 4 {
    if !gNeedsF64Print {
      return emitFail(
        "emitProgram: print of a union with an f64 arm but no __print_f64__ import",
      )
    }
    fbCall(gF64PrintIdx)
    return 0
  }
  if k == 5 {
    if !gNeedsF32Print {
      return emitFail(
        "emitProgram: print of a union with an f32 arm but no __print_f32__ import",
      )
    }
    fbCall(gF32PrintIdx)
    return 0
  }
  return emitFail("emitProgram: print of a union arm with no scalar sink")
}

// `print(<value-union box>)` — read the box tag and print the arm the value actually
// holds (D712): every arm is already inside `printDomainStr()`, so the runtime tag
// dispatch is the only piece needed, the same dispatch the emitter performs for `is`.
// One evaluation: each arm reads the box twice, so it is stashed once in the lazy frame.
function emitPrintValueUnion(argIx: i32, kinds: i32[], fnIx: i32) {
  const slot = sharedFieldRecvSlot()
  // D969 — an if-expression argument must be coerced, not plain-emitted: `emitExpr` picks
  // an if's blocktype from the arms' scalar ladder, so a desugared `??` pushes an i32
  // blocktype over two ref arms into this box slot. `emitUnionCoerce` routes it through `emitUnionIfValue` instead.
  const puIf = nodeAt(unwrapParen(argIx))
  let puDone = false
  if puIf is IfStmt {
    const puNm = boxTyName(nodeTyIxOf(argIx))
    if puNm != "" {
      if emitUnionBoxOwed(puNm, nodeTyIxOf(argIx), argIx, fnIx) < 0 {
        return -1
      }
      puDone = true
    }
  }
  if !puDone {
    if emitExpr(argIx, fnIx) < 0 { return -1 }
  }
  return printUnionTail(slot, kinds)
}

// After a value-union box is on the stack: stash it once in `slot` (`sharedFieldRecvSlot`, taken
// before the box is written) and print the arm its tag names, over `printUnionPlan`'s kinds.
export function printUnionTail(slot: i32, kinds: i32[]) {
  fbLocalSet(slot)
  let i = 0
  while i < kinds.length - 1 {
    fbLocalGet(slot)
    fbStructGet(uBoxIdx, 0) // field 0: tag
    fbI32Rel(RS_TAG, scalarTagOfKind(kinds[i]))
    fbI32Bin(70)            // 0x46 i32.eq
    fbIf(64)                // if (void)
    if emitPrintUnionArm(slot, kinds[i]) < 0 { return -1 }
    fbElse()
    i = i + 1
  }
  if emitPrintUnionArm(slot, kinds[kinds.length - 1]) < 0 { return -1 }
  let e = 0
  while e < kinds.length - 1 {
    fbEnd()
    e = e + 1
  }
  return 0
}

// The streaming loop over the string already stashed in `strScrA` — `emitPrintStrExpr`'s
// tail, split out so the nullable arm above can reach it with the ref it recovered from
// `br_on_null` instead of re-evaluating the expression.
function emitPrintStrFromScratch() {
  hoistStrScr(0) // the streaming loop reads the backing once per code point
  fbI32Const(0)
  setStrScrI(0)
  pushStrScrRef(0)
  fbStrLen() // field 2: the VIEW's length, not the backing's
  setStrScrI(1)
  fbBlock(64)
  fbLoop(64)
  pushStrScrI(0)
  pushStrScrI(1)
  fbI32Bin(78) // i32.ge_s
  fbBrIf(1)
  pushStrScrElem(0, 0)
  fbCall(2) // __print_char__
  pushStrScrI(0)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  setStrScrI(0)
  fbBr(0)
  fbEnd()
  fbEnd()
  fbCall(3) // __print_str_flush__
  return 0
}

// Widen a literal-union atom (an i32 id) to a string value — a `select` tower mapping each
// member's id to its string constant, membership checker-guaranteed so the last member is
// the unconditional default. The id evaluates once into str-op scratch slot 0, re-read per
// member. The string-subtype analogue of the numeric i32→f64 widening.
export function emitAtomToStr(atomIx: i32, fnIx: i32) {
  const p = atomStrPlanOf(atomIx, fnIx, atomIx == coerceHeld)
  if boxDstShadowArmed() {
    boxDstShadowAs(if p.apWhy == "" { "table" } else { p.apWhy })
  }
  atomSrcShadowNote(p.apSite, p.apSiteNul, atomIx, fnIx)
  if p.apWhy == "" {
    const seat = atomSeat
    atomSeat = atomIx
    const rt = emitExpr(atomIx, fnIx)
    atomSeat = seat
    return rt
  }
  if p.apNul { return emitNulAtomToStr(atomIx, p.apTexts, fnIx) }
  return emitAtomToStrTower(atomIx, p.apTexts, fnIx)
}

// How `atomIx` decodes to a string: the members and whether `-1` is `null`; `apWhy` "" where the
// checker's record serves (the table decodes it, seated), else the floor that keeps the site's
// own members (`apSite`, `apSiteNul`). `held` is whether the conversion is already being written.
export type AtomStrPlan = {
  apTexts: string[],
  apNul: boolean,
  apWhy: string,
  apSite: string[],
  apSiteNul: boolean,
}

// The plan for `atomIx` at instance `fnIx`, which legacy's widening and the IR's `RAtomStr` both
// spend. `litAtomWidenTexts` is the site's ladder, shared with `print`'s atom arm.
export function atomStrPlanOf(
  atomIx: i32,
  fnIx: i32,
  held: boolean,
): AtomStrPlan {
  const nulTexts = nulAtomWidenTexts(atomIx, fnIx)
  const siteNul = nulTexts.length > 0
  const site = if siteNul { nulTexts } else { litAtomWidenTexts(atomIx, fnIx) }
  const why = atomFloorWhy(site, siteNul, atomIx, fnIx, held)
  if why == "" {
    const rec = atomRecordTexts(atomIx, fnIx)
    return {
      apTexts: rec.apTexts,
      apNul: rec.apNul,
      apWhy: "",
      apSite: site,
      apSiteNul: siteNul,
    }
  }
  // Where the node's own type names no member, the set its delivery recorded does (D4028).
  const texts = if !siteNul && site.length == 0 { tyLitMemberTexts(atomRecordAt(atomIx, fnIx)) } else { site }
  return {
    apTexts: texts,
    apNul: siteNul,
    apWhy: why,
    apSite: site,
    apSiteNul: siteNul,
  }
}

// The members the checker's record for `ix` holds, `apNul` where it holds `null`.
function atomRecordTexts(ix: i32, fnIx: i32): AtomStrPlan {
  const r = atomRecordAt(ix, fnIx)
  const rn = tyNulLitUnionMemberTexts(r)
  const nul = rn.length > 0
  const texts = if nul { rn } else { tyLitMemberTexts(r) }
  return {
    apTexts: texts,
    apNul: nul,
    apWhy: "",
    apSite: texts,
    apSiteNul: nul,
  }
}

// The literal set the checker recorded for the atom `ix` at instance `fnIx`, at the node, its
// unparenthesised form or the node it stands in for; -1 for none.
function atomRecordAt(ix: i32, fnIx: i32): i32 {
  let r = atomSrcTyAt(ix, fnIx)
  if r < 0 { r = atomSrcTyAt(unwrapParen(ix), fnIx) }
  if r < 0 { r = atomSrcTyAt(nodeSrc[ix] ?? -1, fnIx) }
  return instTyOrSelf(r, fnIx)
}

// Why the site decodes `ix` at its own members `texts` (`nul` mapping `-1` to null), or "" where
// the record serves: it holds members, agrees on null, and names none outside the site's set.
function atomFloorWhy(
  texts: string[],
  nul: boolean,
  ix: i32,
  fnIx: i32,
  held: boolean,
): string {
  if held { return "floor: held" }
  const r = atomRecordAt(ix, fnIx)
  if r < 0 { return "floor: no record" }
  const rn = tyNulLitUnionMemberTexts(r)
  const rt = if rn.length > 0 { rn } else { tyLitMemberTexts(r) }
  if rt.length == 0 { return "floor: record holds no member" }
  if (rn.length > 0) != nul { return "floor: null differs" }
  for x in rt {
    if texts.length > 0 && !textsHave(texts, x) { return "floor: record wider" }
  }
  return ""
}

// Whether `xs` holds `x`.
function textsHave(xs: string[], x: string): boolean {
  for y in xs {
    if y == x { return true }
  }
  return false
}

// The table's decode of a seated atom: the tower over its recorded set, `-1` to null where the
// set holds `null`. Returns 0, or -1 failed.
function emitAtomStrAtRecord(ix: i32, fnIx: i32): i32 {
  atomSeat = -1
  const rec = atomRecordTexts(ix, fnIx)
  if rec.apNul { return emitNulAtomToStr(ix, rec.apTexts, fnIx) }
  return emitAtomToStrTower(ix, rec.apTexts, fnIx)
}

// The `select` tower over `texts` for the atom `atomIx`, its id evaluated once.
function emitAtomToStrTower(atomIx: i32, texts: string[], fnIx: i32): i32 {
  if texts.length == 0 {
    return emitFail(
      "emitProgram: literal-union string widening with no members",
    )
  }
  if emitStashAtomId(atomIx, fnIx) < 0 { return -1 }
  return atomStrDecode(texts, false)
}

// Widen a `K | null` atom to a `string | null`: `-1` is `ref.null`, any other id takes the
// member tower. The id is evaluated once (D3198).
function emitNulAtomToStr(atomIx: i32, texts: string[], fnIx: i32) {
  if emitStashAtomId(atomIx, fnIx) < 0 { return -1 }
  return atomStrDecode(texts, true)
}

// The decode of the atom id stashed in str-op scratch slot 0: the member tower over `texts`,
// behind a `-1` → `ref.null` test where `nul`. Returns 0, or -1 failed.
function atomStrDecode(texts: string[], nul: boolean): i32 {
  if !nul { return emitAtomToStrChain(texts, 0, strScratchBase + 3) }
  pushStrScrI(0)
  fbI32Const(-1)
  fbI32Bin(70) // 0x46 i32.eq → null?
  fbIfRefNul(sTy(), true)
  fbRefNull(sTy())
  fbElse()
  if emitAtomToStrChain(texts, 0, strScratchBase + 3) < 0 { return -1 }
  fbEnd()
  return 0
}

// `emitAtomToStr` after its operand, the atom's id already on the stack: plan `p`'s decode, the
// bytes its seated and floor paths write after the value. Returns 0, or -1 failed.
export function atomStrTail(p: AtomStrPlan): i32 {
  if !p.apNul && p.apTexts.length == 0 {
    return emitFail(
      "emitProgram: literal-union string widening with no members",
    )
  }
  setStrScrI(0)
  return atomStrDecode(p.apTexts, p.apNul)
}

// Evaluate an atom-repped literal-union value once and stash its interned i32 id in the
// string-op scratch i32 slot 0 — the slot every widen tower re-reads once per member. A
// tower that re-read the receiver per member instead would re-run a call receiver once per
// member, a silent wrong evaluation count rather than a wrong value.
function emitStashAtomId(atomIx: i32, fnIx: i32) {
  if emitExpr(atomIx, fnIx) < 0 { return -1 }
  setStrScrI(0)
  return 0
}

// Whether the function at `fnStmts` position `fnPos` has a collected `string` result.
function retKindIsStr(fnPos: i32): boolean {
  return fnPos >= 0 && fnPos < fRetKind.length && fRetKind[fnPos] == "str"
}

// The `select` tower for `emitAtomToStr`: member `i`'s string if its interned id matches
// the atom stashed in local `idSlot`, else the chain for `i+1`. The last member is the default arm.
function emitAtomToStrChain(texts: string[], i: i32, idSlot: i32) {
  if i >= texts.length - 1 {
    const rd = emitStr(mkStr(quoteLex(texts[i]), -1), -1)
    return rd
  }
  // val1 = this member's string constant
  if emitStr(mkStr(quoteLex(texts[i]), -1), -1) < 0 { return -1 }
  // val2 = the remaining chain
  if emitAtomToStrChain(texts, i + 1, idSlot) < 0 { return -1 }
  // cond = (stashed id == this member's id)
  fbLocalGet(idSlot)
  fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
  fbI32Bin(70) // i32.eq
  // select_t typed for a non-null string ref (0x64 $sTypeIdx): val1 if cond else val2
  fbSelectRef(sTy())
  return 0
}

// Emit `ix` as a string value: a literal-union atom widens to its member string; anything
// else lowers normally (it is already a string). Used at every `string`-typed boundary that
// can receive an atom — concat operands, a `string` arg position, a `string` return.
function emitStrValue(ix: i32, fnIx: i32) {
  if exprIsLitAtom(ix, fnIx) {
    const rw = emitAtomToStr(ix, fnIx)
    return rw
  }
  const re = emitExpr(ix, fnIx)
  return re
}

// Narrow a string-repped literal-union value to its interned i32 atom id — `emitAtomToStr`'s
// inverse. A litunion has two reps and `nodeTyIsLitUnionAlias` decides which: a registered
// alias is an interned atom, an un-named one stays a `(ref $array)` string. The tower is
// `emitAtomToStr`'s, mirrored, re-reading the value per member (bounded by `unionEqOperandOk`).
function emitStrToAtom(ix: i32, fnIx: i32) {
  // `tyLitMemberTexts` over the node's recorded type, NOT `nodeLitUnionMemberTexts`: that
  // node query declines a bare `TyLit` on purpose (its callers read an empty list as "not a
  // widenable atom"), and a bare `TyLit` is exactly the one-member set this narrowing serves.
  const texts = tyLitMemberTexts(nodeUnwidenedTyOf(ix))
  if texts.length == 0 {
    return emitFail("emitProgram: literal-union atom narrowing with no members")
  }
  if !unionEqOperandOk(ix) {
    // a non-place value — a call, a `+`, a ternary — is staged rather than refused:
    // evaluated once into `atomStageSlot`, then re-read per member (`emitAtomToStr`'s id
    // stash mirrored). Reached through `emitExpr`'s single atom hook, so every
    // atom-typed destination is served by one arm (D13).
    if !fnUses.atomStage {
      // the reservation scan claims a strict superset of what this arm stages, so reaching
      // here means the two have drifted. Keep the loud refusal rather than `local.set` an
      // index the locals vector never declared.
      return emitFail(
        "emitProgram: literal-union atom narrowing needs a re-readable receiver",
      )
    }
    // the atom context is cleared across the stash and the chain: the value must reach the
    // slot as the `(ref $array)` it is, and each member constant must lower as a string —
    // at an atom-typed destination a member literal folds to its interned id instead, so the
    // tower called `strEq` with an i32 operand. Restored on both exits.
    let rv = emitExprRaw(ix, fnIx)
    if rv >= 0 {
      fbLocalSet(atomStageSlot)
      rv = emitStagedStrToAtomChain(texts, 0, atomStageSlot, fnIx)
    }
    return rv
  }
  // The inner emits run OUTSIDE the atom context: the value re-reads must lower as the
  // string they are (re-entering this arm would not terminate), and the per-member literal
  // must lower as a string CONSTANT, not as its own interned id.
  const r = emitStrToAtomChain(ix, texts, 0, fnIx)
  return r
}

// The `select` tower over a box parked in `st` whose payload is the member's string: member
// `i`'s interned id if the payload string-equals member `i`, the last member the default.
function emitStashedStrToAtomChain(
  st: i32,
  texts: string[],
  i: i32,
  fnIx: i32,
) {
  if i >= texts.length - 1 {
    fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
    return 0
  }
  fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
  if emitStashedStrToAtomChain(st, texts, i + 1, fnIx) < 0 { return -1 }
  fbLocalGet(st)
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  fbRefCast(sTy())
  if emitStrEqLit(mkStr(quoteLex(texts[i]), -1), fnIx) < 0 { return -1 }
  fbSelect() // 0x1b select — val1 if cond else val2 (both i32)
  return 0
}

// The `select` tower for `emitStrToAtom`: member `i`'s interned id if the value string-equals
// member `i`, else the chain for `i+1`. The last member is the unconditional default arm.
function emitStrToAtomChain(ix: i32, texts: string[], i: i32, fnIx: i32) {
  if i >= texts.length - 1 {
    fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
    return 0
  }
  // val1 = this member's interned id
  fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
  // val2 = the remaining chain
  if emitStrToAtomChain(ix, texts, i + 1, fnIx) < 0 { return -1 }
  // cond = (the value string-equals this member)
  if emitExprRaw(ix, fnIx) < 0 { return -1 }
  if emitStrEqLit(mkStr(quoteLex(texts[i]), -1), fnIx) < 0 { return -1 }
  fbSelect() // 0x1b select — val1 if cond else val2 (both i32)
  return 0
}

// The `K | null` niche of nullable-string place `ix`: `-1` when it is null, else the id of the
// member it string-equals, the last member the default.
function emitNulStrToNulAtom(ix: i32, fnIx: i32) {
  const texts = nulLitMemberTexts(nodeUnwidenedTyOf(ix))
  if texts.length == 0 {
    return emitFail("emitProgram: literal-union atom narrowing with no members")
  }
  let rc = emitExpr(ix, fnIx)
  if rc >= 0 {
    fbRefIsNull()
    fbIf(127) // if (result i32)
    fbI32Const(-1)
    fbElse()
    rc = emitNulStrToAtomChain(ix, texts, 0, fnIx)
    fbEnd()
  }
  return rc
}

// `emitStrToAtomChain` over a nullable-string place already tested non-null.
function emitNulStrToAtomChain(ix: i32, texts: string[], i: i32, fnIx: i32) {
  fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
  if i >= texts.length - 1 { return 0 }
  if emitNulStrToAtomChain(ix, texts, i + 1, fnIx) < 0 { return -1 }
  if emitExpr(ix, fnIx) < 0 { return -1 }
  fbRefAsNonNull()
  if emitStrEqLit(mkStr(quoteLex(texts[i]), -1), fnIx) < 0 { return -1 }
  fbSelect() // 0x1b select — val1 if cond else val2 (both i32)
  return 0
}

// ── the destination-driven narrow, for a value whose own type cannot answer ───────────────
// `emitStrToAtom` refuses a value it cannot re-read — wrong at a `.push` into a
// literal-union array inside a monomorphized instance, where the value is a call and the
// leaf's recorded type is still the generic's type variable. The destination knows the member set instead.
function emitDestStrToAtom(valIx: i32, fnIx: i32, luTy: i32) {
  const texts = tyLitMemberTexts(luTy)
  if texts.length == 0 {
    return emitFail("emitProgram: literal-union atom narrowing with no members")
  }
  const ix = unwrapParen(valIx)
  if unionEqOperandOk(ix) {
    // A PLACE: re-read it per member, no slot.
    const rr = emitStrToAtomChain(ix, texts, 0, fnIx)
    return rr
  }
  if !fnUses.atomStage {
    // The reservation scan claims a strict SUPERSET of what this arm stages, so reaching here
    // means the two have drifted. Fail loudly rather than `local.set` an index the locals
    // vector never declared — that is invalid wasm with `vl check` rc 0.
    return emitFail(
      "emitProgram: literal-union atom narrowing needs a staging slot that was not reserved",
    )
  }
  const rv = emitExprRaw(ix, fnIx)
  if rv < 0 { return -1 }
  fbLocalSet(atomStageSlot)
  return emitStagedStrToAtomChain(texts, 0, atomStageSlot, fnIx)
}

// `emitStrToAtomChain` over the value staged in string slot `slot`: member `i`'s interned id if
// the slot string-equals member `i`, else the chain for `i+1`, last member the default.
function emitStagedStrToAtomChain(
  texts: string[],
  i: i32,
  slot: i32,
  fnIx: i32,
) {
  if i >= texts.length - 1 {
    fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
    return 0
  }
  fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
  if emitStagedStrToAtomChain(texts, i + 1, slot, fnIx) < 0 { return -1 }
  fbLocalGet(slot)
  if emitStrEqLit(mkStr(quoteLex(texts[i]), -1), fnIx) < 0 { return -1 }
  fbSelect() // 0x1b select — val1 if cond else val2 (both i32)
  return 0
}

// Does a `.push` value into a literal-union array need the destination-driven narrow? Only
// when the recorded type has no answer: an atom-repped value or a member string literal
// both lower as atoms already.
function litPushNeedsDestNarrow(valIx: i32, fnIx: i32) {
  if exprIsLitAtom(valIx, fnIx) { return false }
  const v = nodeAt(unwrapParen(valIx))
  if v is StrLit { return false }
  if strReppedLitUnionAt(valIx, fnIx) {
    if unionEqOperandOk(valIx) { return false }
  }
  return true
}

// Pushes the interned atom id of statically-known operand `ix` (lexeme `lex`): a literal is its
// id outright, anything else is evaluated for its effects and dropped first.
export function emitStaticLitAtom(ix: i32, lex: string, fnIx: i32) {
  if !(nodeAt(unwrapParen(ix)) is StrLit) {
    const rc = emitExprRaw(ix, fnIx)
    if rc < 0 { return -1 }
    fbDrop()
  }
  return staticAtomId(lex)
}

// Pushes the interned atom id of lexeme `lex`, the half of a static operand after its effects.
export function staticAtomId(lex: string) {
  fbI32Rel(RS_ATOM, internAtom(lex))
  return 0
}

// Lowers the lexeme `text` as one `<w>.const`. A float lexeme is never an integer constant; an
// integer one at `i32` wraps, so the `2147483648` under an `i32` negation is I32_MIN.
function emitNumLexAt(text: string, w: string) {
  if numLexIsFloat(text) {
    if w == "f32" { fbF32Const(text) } else { fbF64Const(text) }
    return 0
  }
  if w == "f32" {
    fbF32Const(text)
    return 0
  }
  if w == "f64" {
    fbF64Const(text)
    return 0
  }
  if w == "i64" {
    const pr = parseI64Pair(text)
    fbI64Const(pr[0], pr[1])
    return 0
  }
  fbI32Const(parseI32(text))
  return 0
}

// Lowers a literal, or `-` over one (parens peeled), as one `<w>.const` at the width `w` the
// caller names: re-encoding the lexeme keeps a hex bit pattern past I32_MAX the value it spells.
function emitSignedNumLitAt(ix: i32, w: string): i32 {
  const n = nodeAt(ix)
  if n is NumLit { return emitNumLexAt(numLitLexAt(ix, n.numText, w), w) }
  if n is Unary {
    const mark = wLen()
    if emitSignedNumLitAt(unwrapParen(n.unArg), w) < 0 { return -1 }
    if wNegateConstFrom(mark) { return 0 }
  }
  return emitFail("emitProgram: a signed literal did not fold to one constant")
}

function emitNumLitNode(e: NumLit, exprIx: i32, fnIx: i32) {
  const w = numLitWidth(exprIx, fnIx)
  return emitNumLexAt(numLitLexAt(exprIx, e.numText, w), w)
}

// Whether `const` declaration `s` at `stmtIx` builds no store: every read copied its kept tree, and
// computing it would trap where the copies do not (D15001). Legacy and the IR share it.
export function keptDeclStoresNothing(s: LetDecl, stmtIx: i32): boolean {
  return s.letInit >= 0 && lbiKeptDeclUnread(stmtIx)
}

// Whether `if` statement `s` writes an `else`: it has one and the checker did not find it dead.
// Legacy and the IR share it.
export function ifWritesElse(s: IfStmt): boolean {
  return s.ifElse >= 0 && !isDeadArm(s.ifElse)
}

// Whether statement `if` `s`'s `then` arm is one a covering test left dead (D16006): written as
// `unreachable`.
export function ifThenIsDead(s: IfStmt): boolean { return isDeadArm(s.ifThen) }

// The lexeme a numeric literal `ix` is written at width `w`: an f32 constant tree folds to its own
// f32 lexeme (`cexF32LexOf`), every other literal is its source text. Legacy and the IR share it.
export function numLitLexAt(ix: i32, text: string, w: string): string {
  if w != "f32" { return text }
  const l32 = cexF32LexOf(unwrapParen(ix))
  return if l32 != "" { l32 } else { text }
}

function emitCharLitNode(e: CharLit, _exprIx: i32, _fnIx: i32) {
  // A char literal is its single Unicode code point as an i32.
  const cp = charLitCp(e)
  if cp < 0 {
    return emitFail(
      "emitProgram: char literal must denote exactly one code point",
    )
  }
  fbI32Const(cp)
  return 0
}

// Whether a read of module global `isid` at `readIx` in `fnIx` is followed by `ref.as_non_null`,
// for an identifier read and a substituted parameter default alike. A kind-16 `string | null`
// cell recovers when the read's type bears no null; a non-const ref cell is start-initialised,
// so nullable in wasm, and recovers unless its kind legitimately holds null.
export function globalReadRecovers(isid: i32, readIx: i32, fnIx: i32): boolean {
  const gck0 = globalCellKind(globalLetOfSid(isid))
  if gck0 == "nulstr" { return nulStrReadRecovers(readIx, fnIx) }
  return globalNameIsNonConstSid(isid) && vkIsNonNullRef(gck0)
}

// Which list override takes identifier read `exprIx` in place of its binding: a union-of-lists
// arm's unboxed list (`luOv`), an `is K[]` arm's empty-list shadow (`fitShadow`), or none. Both
// queries are pure reads of emit state, which lets `emitIdentNode` ask ahead of its null arms.
export type IdentListOverride = "luOv" | "fitShadow" | "none"
export function identListOverrideOf(
  e: Ident,
  exprIx: i32,
  fnIx: i32,
): IdentListOverride {
  if luOvLocNodes.length > 0 && luOvLocalOf(exprIx) >= 0 { return "luOv" }
  if listFitShadowRead(e.identName, exprIx, fnIx) >= 0 { return "fitShadow" }
  return "none"
}

// the densest single-identifier site in the compiler: one identifier read resolves
// through seven name-keyed lookups here, each otherwise a hash plus a string probe. The
// arena index `_exprIx`, already threaded in and unused, turns the id lookup and the
// other six into array reads.
function emitIdentNode(e: Ident, exprIx: i32, fnIx: i32) {
  let arm = identReadArmOf(e, exprIx, fnIx, false)
  const ovr = identListOverrideOf(e, exprIx, fnIx)
  // A read a union-of-lists arm overrides is that arm's unboxed list (D16897).
  match ovr {
    "luOv" => {
      if identListArmCheck(arm, exprIx, fnIx) < 0 { return -1 }
      fbLocalGet(luOvLocalOf(exprIx))
      return 0
    }
    "fitShadow" | "none" => {}
  }
  // D1576 — a read of a never-filled `let x = null` is the value `null`, so it takes the
  // destination's null rep from the same table a bare `null` literal does.
  if arm == "nulnone" { return emitNullAt(exprIx, fnIx) }
  // A read whose most recent write is a `null` (a `let x = null` read before the write that
  // fills it) holds its storage's null, delivered at a destination of another rep as its null.
  if arm == "nullread" {
    if emitNullReadAtDst(exprIx, fnIx) { return 0 }
    arm = identReadArmOf(e, exprIx, fnIx, true)
  }
  // An `is K[]` arm's read of an empty list of another element (D4911), ahead of the narrowed
  // unboxes, which would cast the receiver's own list to `K[]`.
  match ovr {
    "fitShadow" => {
      if identListArmCheck(arm, exprIx, fnIx) < 0 { return -1 }
      fbLocalGet(listFitShadowRead(e.identName, exprIx, fnIx))
      fbRefAsNonNull()
      return 0
    }
    "luOv" | "none" => {}
  }
  // …and a closure's read of its capture there, which reads an empty `K[]` of its own (D4935).
  listFitStoodIn = -1
  const capTy: i32[] = []
  const capSh = listFitCaptureStandIn(e.identName, exprIx, fnIx, false, capTy)
  if capSh >= 0 {
    if identListArmCheck(arm, exprIx, fnIx) < 0 { return -1 }
    fbBacking(listBackOfWrap(capSh), 0)
    arrLitWrap(0, capSh)
    listFitStoodIn = exprIx
    listFitStoodTy = capTy[0]
    return 0
  }
  const isid = sidOfNode(exprIx)
  match arm {
    "nulnone" | "nullread" => {
      return emitFail(
        "emitProgram: internal: an identifier read's null arm survived its own test",
      )
    }
    // A module-`const` parameter default reads its global, not a caller-local of the same name:
    // the node is the declaration's own expression, whichever frame omitted the argument.
    "defglobal" => {
      if emitUserGlobalGet(globalIndexOfSid(isid)) < 0 { return -1 }
      // the same recovery the argument spelling of this read gets (D3510)
      if globalReadRecovers(isid, exprIx, fnIx) { fbRefAsNonNull() }
      return 0
    }
    // A union-box cell the checker typed this read as one atom of reads unboxed, through
    // `emitUnionBoxPush`: `if u is i32 { print(u) }` yields the raw i32.
    "unbox" => {
      const vak = identUnboxAtomOf(exprIx, fnIx)
      if vak < 0 {
        fbUnreachable()
        return 0
      }
      return emitValueUnionUnboxRead(exprIx, vak, fnIx)
    }
    // A union binding narrowed to a niche-repped `A | null` reads as that niche (D2590).
    "niche" => {
      return emitNarrowedNicheRead(exprIx, nicheReadKindAt(exprIx, fnIx), fnIx)
    }
    // A union binding narrowed to a ref-element list or a map arm reads unboxed to it.
    "reflist" => {
      return emitRefArrayUnionUnboxRead(exprIx, fnIx)
    }
    "map" => {
      return emitMapUnionUnboxRead(exprIx, fnIx)
    }
    // A free variable of a capturing lifted function reads from its env, shadowing nothing.
    "capture" => {
      emitCapturedRead(e.identName, fnIx, exprIx)
      return 0
    }
    "nonlocal" => {
      return emitIdentNonLocalRead(e, isid, exprIx, fnIx)
    }
    "local" => {
      return emitIdentLocalRead(exprIx, localIndexOf(fnIx, exprIx), fnIx)
    }
  }
}

// The list overrides read the body lowering's state, so the decision leaves them out; a read they
// take is list-typed. One taking a `local` read of no list would contradict what the IR writes.
function identListArmCheck(arm: IdentReadArm, exprIx: i32, fnIx: i32) {
  if arm == "local" && !identReadIsList(exprIx, fnIx) {
    return emitFail(
      "emitProgram: internal: a list override took an identifier read identReadArmOf names a plain local read of no list",
    )
  }
  return 0
}

// The function a bare name `e` read at `exprIx` in frame `fnIx` builds as a value, or -1 for a
// module global: a maker instance's token, else the instance's nested copy found by its
// declaration (the read node is shared by every clone), else the scope's own function (D12213).
export function fnValueFeOf(e: Ident, isid: i32, exprIx: i32, fnIx: i32): i32 {
  const tk = monoTokenFe(exprIx, fnIx)
  if tk >= 0 { return tk }
  const nc = elabNestedCopyOnChain(elabSrcDecl(identDeclOf(exprIx)), fnIx)
  if nc >= 0 { return nc }
  return fnIndexOfInScopeAt(isid, e.identName, fnIx, exprIx)
}

// How function value `fe` at `exprIx` is written: its void twin's closure where the checker
// coerced it to return `void`, a refusal for a generic one no call fixes (unless `exprIx` is the
// stubbed write's right side `stubRhs`, -1 for none), the unchecked core for one nothing calls or
// only an alias calls (a hole function may be one, D6660), else checked.
export type FnValueArm = "twin" | "unfixed" | "inert" | "aliasCore" | "checked"
export function fnValueArmOf(fe: i32, exprIx: i32, stubRhs: i32): FnValueArm {
  if voidTwinForNode(exprIx, fe) >= 0 { return "twin" }
  if (
    exprIx != stubRhs
    && !vrValueInert(exprIx)
    && !elabValueSlotUncalled(exprIx)
    && !monoStubValueOk(fe, exprIx)
  ) {
    return "unfixed"
  }
  if i32ListHas(monoInertCalled, exprIx) { return "inert" }
  if (
    (vrValueInert(exprIx) || elabValueSlotUncalled(exprIx))
    && monoInstantiatedAny(fe)
  ) {
    return "aliasCore"
  }
  return "checked"
}

// A read of `e` that is no param or local of this frame: a function value, else a module
// global. Returns 0, or -1 once failed.
function emitIdentNonLocalRead(e: Ident, isid: i32, exprIx: i32, fnIx: i32) {
  const fe = fnValueFeOf(e, isid, exprIx, fnIx)
  if fe >= 0 {
    return match fnValueArmOf(fe, exprIx, stubWriteRhs) {
      "twin" => emitClosureValue(voidTwinForNode(exprIx, fe), fnIx)
      "unfixed" => emitFailAt(
        "emitProgram: a generic function taken as a value reaches no call that fixes its type "
          + "— annotate the destination's function type",
        exprIx,
      )
      "inert" | "aliasCore" => emitClosureValueCore(fe, fnIx)
      "checked" => emitClosureValue(fe, fnIx)
    }
  }
  // Not a local — a module global? Read it with `global.get` (0x23 <globalidx>).
  const gIdx = globalIndexOfSid(isid)
  if gIdx >= 0 {
    if emitUserGlobalGet(gIdx) < 0 { return -1 }
    if globalReadRecovers(isid, exprIx, fnIx) { fbRefAsNonNull() }
    return 0
  }
  return emitFail(
    "emitProgram: identifier is not a parameter, local, or global",
  )
}

// The read at `exprIx` from its local `idx`, or an unrolled range variable's constant.
// Returns 0.
function emitIdentLocalRead(exprIx: i32, idx: i32, fnIx: i32) {
  // A fully unrolled range loop's variable reads as its copy's constant.
  const urAt = unrolledSlotAt(idx)
  if urAt >= 0 {
    if urBase[urAt] < 0 {
      fbI32Const(urVal[urAt])
      return 0
    }
    fbLocalGet(urBase[urAt])
    if urVal[urAt] != 0 {
      fbI32Const(urVal[urAt])
      fbI32Bin(106) // 0x6a i32.add
    }
    return 0
  }
  fbLocalGet(idx)
  if localNulStrRecovers(exprIx, fnIx) { fbRefAsNonNull() }
  return 0
}

function emitUnaryNode(e: Unary, exprIx: i32, fnIx: i32) {
  // Logical not `!a`: a boolean rides in an i32 (0/1), so `i32.eqz` (0x45) maps
  // 0→1 and any non-zero→0 — exactly `a == 0`. Push the operand, then eqz.
  if e.unOp == "!" {
    const ngStart = wLen()
    if emitExpr(e.unArg, fnIx) < 0 { return -1 }
    // An instance's decided `is` stays one constant under `!`, so `staticIsGuard` reads the
    // negated test as decided too and the dead arm is not lowered (D2957).
    const ngK = staticIsGuard(e.unArg, ngStart)
    if ngK >= 0 {
      wDropBack(2)
      fbI32Const(1 - ngK)
      return 0
    }
    fbI32Eqz() // 0x45 i32.eqz
    return 0
  }
  // postfix `x++`/`x--` in expression position yields the old value. `unArg` is the
  // increment assignment `x = x ± 1`, which as an expression yields the new value
  // (store-then-re-read); undo the step to recover the pre-increment value.
  if e.unOp == "p+" || e.unOp == "p-" {
    if emitExpr(e.unArg, fnIx) < 0 { return -1 }
    const up = e.unOp == "p+"
    // The step is undone at the place's own numeric width (D16216).
    if exprIsF64(e.unArg, fnIx) {
      fbF64Const("1")
      fbI32Bin(if up { 161 } else { 160 }) // 0xa1 f64.sub / 0xa0 f64.add
    } else if exprIsF32(e.unArg, fnIx) {
      fbF32Const("1")
      fbI32Bin(if up { 147 } else { 146 }) // 0x93 f32.sub / 0x92 f32.add
    } else if exprIsI64(e.unArg, fnIx) {
      fbI64Const(0, 1)
      fbI32Bin(if up { 125 } else { 124 }) // 0x7d i64.sub / 0x7c i64.add
    } else {
      fbI32Const(1)
      fbI32Bin(if up { 107 } else { 106 }) // 0x6b i32.sub / 0x6a i32.add
    }
    return 0
  }
  // Bitwise NOT `~x` == `x ^ -1` (flip every bit). The all-ones mask is an i64
  // `-1` when the operand is i64, an i32 `-1` otherwise; the XOR opcode follows
  // suit. (Slice 2 — the i64 path; the i32 path is the same shape over i32 ops.)
  if e.unOp == "~" {
    if exprIsI64(e.unArg, fnIx) {
      if emitExpr(e.unArg, fnIx) < 0 { return -1 }
      fbI64Const(-1, -1) // i64 -1 (all ones)
      fbI32Bin(133)      // 0x85 i64.xor
      return 0
    }
    if emitExpr(e.unArg, fnIx) < 0 { return -1 }
    fbI32Const(-1) // i32 -1 (all ones)
    fbI32Bin(115)  // 0x73 i32.xor
    return 0
  }
  // A two-base literal set negates at `i64`, the width its arithmetic computes at (D3512).
  if (
    e.unOp == "-"
    && !tyIsPrimIx(nodeTyAt(e.unArg, fnIx))
    && njIsLitSide(e.unArg, fnIx)
  ) {
    fbI64Const(0, 0)
    if emitNumUnionConvert(e.unArg, 3, fnIx) < 0 { return -1 }
    fbI32Bin(125) // 0x7d i64.sub
    return 0
  }
  if numUnionMinted && e.unOp == "-" && nodeIsNumUnion(e.unArg, fnIx) {
    return emitNumUnionNeg(e.unArg, fnIx)
  }
  // Integer negation: `-x` == `0 - x`, so push 0, the operand, then sub. For an
  // i64 operand the zero and the subtract are i64 (Slice 2).
  if e.unOp != "-" {
    return emitFail("emitProgram: unsupported unary operator")
  }
  // A negated numeric literal folds to one constant (`wNegateConstFrom`), which keeps a
  // module const initialized with it a constant expression. The operator below is
  // the fallback, and it computes the same value.
  const negInner = unwrapParen(e.unArg)
  if negInner < 0 { return -1 }
  const negNode = nodeAt(negInner)
  const negLit = negNode is NumLit
  const negMark = wLen()
  // A negated literal is one constant at the negation's own type, which may be narrower than its
  // operand's: `-2147483648` is `i32` over an `i64` magnitude.
  const negW = numLitTyWidth(exprIx, fnIx)
  if negLit && negW != "" { return emitSignedNumLitAt(exprIx, negW) }
  // f32 negation uses the dedicated `f32.neg` (0x8c) — flips the sign bit. Checked
  // before f64 (an f32 expr is never `exprIsF64`, but this keeps the float cases
  // grouped and explicit). (Slice 5.)
  if exprIsF32(e.unArg, fnIx) {
    if emitExpr(e.unArg, fnIx) < 0 { return -1 }
    if negLit && wNegateConstFrom(negMark) { return 0 }
    fbF32Neg()
    return 0
  }
  // f64 negation uses the dedicated `f64.neg` (0x9a) — flips the sign bit (Slice 3).
  if exprIsF64(e.unArg, fnIx) {
    if emitExpr(e.unArg, fnIx) < 0 { return -1 }
    if negLit && wNegateConstFrom(negMark) { return 0 }
    fbF64Neg()
    return 0
  }
  // A literal operand multiplies by -1 when it does not fold, since the zero `0 - x` needs
  // would already have to be on the stack; the two agree under wrapping.
  if exprIsI64(e.unArg, fnIx) {
    if negLit {
      if emitExpr(e.unArg, fnIx) < 0 { return -1 }
      if wNegateConstFrom(negMark) { return 0 }
      fbI64Const(-1, -1)
      fbI32Bin(126) // 0x7e i64.mul
      return 0
    }
    fbI64Const(0, 0) // i64 0
    if emitExpr(e.unArg, fnIx) < 0 { return -1 }
    fbI32Bin(125)    // 0x7d i64.sub
    return 0
  }
  if negLit {
    if emitExpr(e.unArg, fnIx) < 0 { return -1 }
    if wNegateConstFrom(negMark) { return 0 }
    fbI32Const(-1)
    fbI32Bin(108) // 0x6c i32.mul
    return 0
  }
  fbI32Const(0)
  if emitExpr(e.unArg, fnIx) < 0 { return -1 }
  fbI32Bin(107) // 0x6b i32.sub
  return 0
}

function emitCallNode(e: Call, exprIx: i32, fnIx: i32) {
  // G6: `s.slice(start, end)` over a string receiver is an intrinsic — a new
  // `(array i32)` over the clamped half-open range. Other member-calls in value
  // position are out of scope (the only member-call STATEMENT is `.push`).
  if exprIsStrMethod(exprIx, fnIx, "slice") {
    return emitStrSlice(exprIx, fnIx)
  }
  // An array `xs.slice(start, end?)` over a LIST receiver — a same-element-kind
  // sublist (`emitArrSlice`). Checked before the string slice's siblings so it does
  // not fall into a struct member-call path.
  if callIsArrSlice(exprIx, fnIx) { return emitArrSlice(exprIx, fnIx) }
  // `s.indexOf(sub)` / `s.includes(sub)` / `s.charCodeAt(i)` over a string
  // receiver are intrinsics too (A7), each yielding an i32.
  if exprIsStrIndexOf(exprIx, fnIx) { return emitStrIndexOf(exprIx, fnIx) }
  if exprIsStrMethod(exprIx, fnIx, "charCodeAt") {
    return emitStrCharCode(exprIx, fnIx)
  }
  // The Stage 2c codec trio. Dispatched from the SAME ladder rung as `charCodeAt` because
  // they are the same shape — a member call on a string receiver yielding a scalar — and a
  // rung further down would sit past the `Map`/`Set`/`has`/`delete` arms that key on a bare
  // property NAME.
  if exprIsStrMethod(exprIx, fnIx, "cpAt") { return emitStrCpAt(exprIx, fnIx) }
  if exprIsStrMethod(exprIx, fnIx, "cpLen") {
    return emitStrCpLen(exprIx, fnIx)
  }
  if exprIsStrMethod(exprIx, fnIx, "isCharBoundary") {
    return emitStrIsCharBoundary(exprIx, fnIx)
  }
  if exprIsStrMethod(exprIx, fnIx, "bytes") {
    return emitStrBytes(exprIx, fnIx)
  }
  // G8: the `Map()` builtin constructs an empty string-keyed map. `Set()` is a
  // boolean-valued string map over the SAME 7-field struct, so it emits the
  // IDENTICAL empty-map construction.
  if e.callFn < 0 { return -1 }
  const callee = nodeAt(e.callFn)
  if mapNewCall(e) { return emitMapNew(exprIx, fnIx) }
  // G8: a map `m.has(k)` member-call yields a 0/1 i32 (linear scan).
  if callee is Member {
    if callee.memProp == "has" {
      if exprMap(callee.memObj, fnIx) {
        if e.callArgs.length != 1 {
          return emitFail(
            "emitProgram: internal: .has reached with the wrong argument count — the checker's arity rule refuses it",
          )
        }
        return emitMapHas(callee.memObj, e.callArgs[0], fnIx)
      }
    }
    // G8: a map `m.delete(k)` member-call in value position yields a 0/1 boolean (did a
    // key exist and get removed). The same lowering serves the bare-statement form.
    if callee.memProp == "delete" {
      if exprMap(callee.memObj, fnIx) {
        if e.callArgs.length != 1 {
          return emitFail(
            "emitProgram: internal: .delete reached with the wrong argument count — the checker's arity rule refuses it",
          )
        }
        return emitMapDelete(callee.memObj, e.callArgs[0], fnIx)
      }
    }
    // `m.keys()` over a map yields a fresh string list of its LIVE keys.
    if callee.memProp == "keys" {
      if exprMap(callee.memObj, fnIx) {
        if e.callArgs.length != 0 {
          return emitFail(
            "emitProgram: internal: .keys() reached with the wrong argument count — the checker's arity rule refuses it",
          )
        }
        return emitMapKeys(callee.memObj, fnIx)
      }
    }
    // `m.values()` over a mono i32 map yields a fresh i32 list of its LIVE values.
    if callee.memProp == "values" {
      if exprMap(callee.memObj, fnIx) {
        if e.callArgs.length != 0 {
          return emitFail(
            "emitProgram: internal: .values() reached with the wrong argument count — the checker's arity rule refuses it",
          )
        }
        return emitMapValues(callee.memObj, fnIx)
      }
    }
    // `xs.pop()` removes + returns the last list element (any list kind). The receiver
    // guard is the one the `map` / `filter` / `keys` / `values` / `get` neighbours all
    // carry: a non-list receiver falls through, so a function-valued struct FIELD named
    // `pop` is a `call_ref` member call like any other (D1087).
    if callee.memProp == "pop" {
      if popRecvIsList(callee.memObj, fnIx) {
        return emitPop(exprIx, fnIx, true, -1)
      }
    }
    // `xs.push(v)` in value position yields the new length — the `i32` the checker has
    // always given it (D1592). It rides the same receiver test as `.pop`, so a receiver
    // one lowers and the other refuses cannot exist.
    if callee.memProp == "push" {
      if popRecvIsList(callee.memObj, fnIx) {
        return emitPush(exprIx, fnIx, true)
      }
    }
    // `xs.get(i)` — the checked nullable list read, at every list rep. It is `.pop()`
    // with a bounds condition and no decrement, so it shares that body (D1281). A
    // non-list receiver still falls through — a map `.get(k)` and a function-valued
    // struct field named `get` are `emitCall`'s.
    if callee.memProp == "get" {
      if e.callArgs.length == 1 {
        if popRecvIsList(callee.memObj, fnIx) {
          return emitPop(exprIx, fnIx, true, e.callArgs[0])
        }
      }
    }
    // `xs.map(f)` / `xs.filter(p)` over a LIST receiver lower to the inline
    // closure-calling loop (Slices 3–4). A non-list receiver falls through (a
    // function-valued struct FIELD named `map` is a `call_ref` member call).
    if callee.memProp == "map" || callee.memProp == "filter" {
      if mfRecvKindOf(callee.memObj, fnIx) != null {
        return emitMapFilter(exprIx, fnIx)
      }
    }
  }
  return emitCall(exprIx, fnIx)
}

// A bare `null` literal, built at the rep of the type the checker stamped it with where it is
// delivered: the `boolean | null` or literal-union sentinel, a `string | null`'s typed null, else
// the bottom ref. A `null`-unit cell (`null[]`'s element) is an i32 holding 2 (D4671).
function emitNullLitNode(_e: NullLit, exprIx: i32, fnIx: i32) {
  return emitNullAt(exprIx, fnIx)
}

// Push the null the destination of the `null`-typed read `exprIx` holds, when it names a rep
// other than the read's storage; false, pushing nothing, where the storage read is that null.
function emitNullReadAtDst(exprIx: i32, fnIx: i32): boolean {
  const at = parenPeelIx(exprIx)
  let dst = ctxTyAt(at, fnIx)
  // A respelled read (a shared cell's `c[0]`) takes the destination of the name it respells.
  if dst < 0 { dst = ctxTyAt(nodeSrc[at] ?? -1, fnIx) }
  const st = readNarrowedStoreAt(exprIx, fnIx)
  if dst < 0 || st < 0 { return false }
  const dk = repOfTy(dst).rdKind
  if dk == repOfTy(st).rdKind { return false }
  // An open `_ | null` destination (an un-annotated binding of the read) is built at the read's
  // storage, so the storage read is its null.
  const dt = tyAt(dst)
  if dt is TyNullable {
    if dt.nInner < 0 { return false }
  }
  if dk == "union" {
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone()
    fbStructNew(uBoxIdx)
    return true
  }
  emitNullOwn(nullOwnOfTy(dst))
  return true
}

// The `null` value node `exprIx` evaluates to, built at the rep of the type the checker stamped
// it with where it is delivered: the `boolean | null` or literal-union sentinel, a
// `string | null`'s typed null, else the bottom ref.
export function emitNullAt(exprIx: i32, fnIx: i32) {
  return emitNullOwn(nullOwnAt(exprIx, fnIx))
}

// String literal `ix`: delivered to a destination whose type reps as the atom, its interned id;
// else the string.
export function emitStrLitAt(ix: i32, fnIx: i32) {
  const e = nodeAt(ix)
  if e is StrLit && strLitTakesAtom(ix, fnIx) {
    fbI32Rel(RS_ATOM, internAtom(e.strText))
    return 0
  }
  return emitStr(ix, fnIx)
}

// Whether string literal `ix` lowers as its atom: the row its field value is built at, else its
// contextual type at this instance reps as one (D3423); a literal delivered nowhere is a string.
// An open program record still decides by the delivery context.
export function strLitTakesAtom(ix: i32, fnIx: i32): boolean {
  const fr = fieldRowStoresAtom(ix, fnIx)
  if fr >= 0 { return fr == 1 }
  // A list element goes where its list literal's element reps: a list of `"x"` holds atoms
  // though a `"x"` binding holds the string (D15083).
  const lo = ctxElemOwnerOf(ix)
  if lo >= 0 && listLitElemIsAtom(lo, fnIx) { return true }
  if fr == -1 { return tyRepsAsAtom(ctxTyAt(ix, fnIx)) }
  const pr = nodeCtxTyIxOf(ix)
  if pr < 0 { return false }
  return tyRepsAsAtom(ctxTyAt(ix, fnIx))
}

// Whether the row node `ix` is a field value of stores that field as the atom: 1 the atom,
// 0 a string, -1 when no row answers, -2 when `ix` is no field value. The row is the owning
// object literal's built arm or the member target's record (D14745, D14752).
function fieldRowStoresAtom(ix: i32, fnIx: i32): i32 {
  const o = ctxFieldOwnerOf(ix)
  if o < 0 { return -2 }
  return fieldOwnerStoresAtom(o, fnIx, ctxFieldNameOf(ix))
}

// Whether the row field `name` of owner `ownerIx` is built at stores it as the literal-union
// atom: an object literal's own row (the variant it is constructed at, else its struct), a field
// write's receiver row. 1 the atom, 0 a string, -1 none.
function fieldOwnerStoresAtom(ownerIx: i32, fnIx: i32, name: string): i32 {
  const o = unwrapParen(ownerIx)
  if o < 0 { return -1 }
  const n = nodeAt(o)
  match n {
    ObjLit => {
      const vi = objLitBuildVariantRow(o, fnIx)
      if vi >= 0 { return variantRowFieldStoresAtom(vi, name) }
      return structRowFieldStoresAtom(structIndexOfObjCtx(o, fnIx), name)
    }
    Member => {
      const rv = exprVariantIndex(n.memObj, fnIx)
      if rv >= 0 { return variantRowFieldStoresAtom(rv, name) }
      return structRowFieldStoresAtom(structIndexOfExpr(n.memObj, fnIx), name)
    }
    // No other node owns a field value.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Call | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar | Unary | BinExpr | IfStmt | Index => {}
  }
  return -1
}

// Whether list literal `ix` is built with atom elements: at its delivery (`arrLitTakesAtom`),
// else at its own type.
function listLitElemIsAtom(ix: i32, fnIx: i32): boolean {
  if arrLitTakesAtom(ix, fnIx) { return true }
  if nodeCtxTyIxOf(ix) >= 0 { return false }
  return tyElemRepsAsAtom(nodeTyAt(ix, fnIx))
}

// Whether node `ix` is delivered to a destination whose type reps as the `K | null` atom niche:
// its contextual type, not its own narrowed one.
function ctxIsNulAtom(ix: i32, fnIx: i32): boolean {
  const ct = ctxTyAt(ix, fnIx)
  if ct < 0 { return false }
  return tyRepsAsNulAtom(ct)
}

// Emits the null `own` names (`nullOwnAt`): the shared tail of every `null` value.
export function emitNullOwn(own: i32) {
  if own == NULL_OWN_BOX {
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone() // the payload slot is unread under the null tag
    return fbStructNew(uBoxIdx)
  }
  if own == NULL_OWN_BOOL { return fbI32Const(2) }
  if own == NULL_OWN_ATOM { return fbI32Const(-1) }
  if own == NULL_OWN_STR { return fbRefNull(sTy()) }
  return fbRefNullNone()
}

// How object literal `exprIx` is built: its variant row's bare struct, a standalone struct its
// field set matches (even beside a union), else in a union program a box `{tag, value}`.
export type ObjLitArm = "variant" | "struct" | "unionBox"
export function objLitArmOf(exprIx: i32, fnIx: i32): ObjLitArm {
  if objLitBuildVariantRow(exprIx, fnIx) >= 0 { return "variant" }
  if structIndexOfObjCtx(exprIx, fnIx) >= 0 || !uDeclared { return "struct" }
  return "unionBox"
}

function emitObjLitNode(_e: ObjLit, exprIx: i32, fnIx: i32, row: i32) {
  return match objLitArmOf(exprIx, fnIx) {
    "variant" => emitVariantStruct(exprIx, objLitBuildVariantRow(exprIx, fnIx), fnIx)
    "struct" => emitObj(exprIx, fnIx, row)
    "unionBox" => emitUnionBox(exprIx, fnIx)
  }
}

// The struct row object literal `objIx` is built at by `emitObj`'s layout loop alone: every
// field present, none dropped and none needing the source-order stash; -1 otherwise.
export function objLitLayoutRowOf(objIx: i32, fnIx: i32): i32 {
  if !sDeclared { return -1 }
  return objLitLayoutRowAt(objIx, structIndexOfObjCtx(objIx, fnIx))
}

// `objLitLayoutRowOf` at struct row `si`, the row a destination builds the literal at: `si`, or -1.
export function objLitLayoutRowAt(objIx: i32, si: i32): i32 {
  if !sDeclared || si < 0 || si >= sFieldCount.length { return -1 }
  const cnt = sFieldCount[si]
  if objLitStashes(objIx, si) { return -1 }
  let fi = 0
  while fi < cnt {
    if objFieldVal(objIx, sFieldNames[sFieldStart[si] + fi]) < 0 { return -1 }
    fi = fi + 1
  }
  return si
}

// The struct row object literal `objIx` is built at by `emitObj`'s order stash with nothing
// dropped: every field present, its source order observable; -1 otherwise.
export function objLitStashRowOf(objIx: i32, fnIx: i32): i32 {
  if !sDeclared { return -1 }
  return objLitStashRowAt(objIx, structIndexOfObjCtx(objIx, fnIx))
}

// `objLitStashRowOf` at struct row `si`, the row a destination builds the literal at: `si`, or -1.
export function objLitStashRowAt(objIx: i32, si: i32): i32 {
  if !sDeclared || si < 0 || si >= sFieldCount.length { return -1 }
  const start = sFieldStart[si]
  const cnt = sFieldCount[si]
  if objLitDropsField(objIx, sFieldNames, start, cnt) { return -1 }
  if !objLitNeedsOrderStash(objIx, sFieldNames, start, cnt) { return -1 }
  let fi = 0
  while fi < cnt {
    if objFieldVal(objIx, sFieldNames[start + fi]) < 0 { return -1 }
    fi = fi + 1
  }
  return si
}

// Whether `emitObj` evaluates literal `objIx` at row `si` in source order into a stash: a field
// the layout drops runs for its effect (D1696), and an observable permutation keeps order (D1510).
export function objLitStashes(objIx: i32, si: i32): boolean {
  const cnt = sFieldCount[si]
  return objLitDropsField(objIx, sFieldNames, sFieldStart[si], cnt)
    || objLitNeedsOrderStash(objIx, sFieldNames, sFieldStart[si], cnt)
}

// After a struct literal's fields in layout order: `struct.new` of row `si`.
export function objStructNewTail(si: i32): i32 {
  fbStructNew(sHeapIdx[si])
  return 0
}

// After map receiver `recvIx`'s value: its live entry count, field 5 (`size`) of its map struct.
export function mapSizeTail(recvIx: i32, fnIx: i32): i32 {
  fbStructGet(mapTypeIdxOf(mapShapeFoldSet(mapShapeOfExpr(recvIx, fnIx))), 5)
  return 0
}

// Whether `m.length` at `memIx` reaches `emitMemberNode`'s map arm: a map receiver that no earlier
// `length` arm takes (a record's own field, a list-fit grow row, an arm site, a list or string).
export function mapLengthPlain(m: Member, memIx: i32, fnIx: i32): boolean {
  if m.memProp != "length" || !exprMap(m.memObj, fnIx) { return false }
  if twoListUseMsg(m.memObj, m.memProp, fnIx) != "" { return false }
  if lengthIsField(m, memIx, fnIx) || armSiteReads(memIx, fnIx) { return false }
  if (
    listFitGrowRow(m.memObj, -1, fnIx) >= 0
    || memberLenWidensAtom(m.memObj, fnIx)
  ) {
    return false
  }
  return !(exprArray(m.memObj, fnIx)
    || exprString(m.memObj, fnIx)
    || exprRefArray(m.memObj, fnIx)
    || exprStringArray(m.memObj, fnIx)
    || numListElemOf(exprListRep(m.memObj, fnIx)) != null
    || exprU8Array(m.memObj, fnIx))
}

function emitMemberNode(e: Member, exprIx: i32, fnIx: i32) {
  const tlm = twoListUseMsg(e.memObj, e.memProp, fnIx)
  if tlm != "" { return emitFailAt(tlm, exprIx) }
  // `a.length` on an array or string receiver is a `struct.get` of the receiver's own
  // length field — the list wrapper's `len` (field 1) or the string header's `len`
  // (field 2), a code-point count. `length` over any other receiver falls through to the struct path.
  if e.memProp == "length" {
    // A record's own `length` field is any field; the IR's plain read takes the same decision.
    if lengthIsField(e, exprIx, fnIx) { return emitMem(exprIx, fnIx) }
    const growLen = emitListFitGrowLen(e, exprIx, fnIx)
    if growLen != 0 { return if growLen < 0 { -1 } else { 0 } }
    const armLen = emitArmSite(exprIx, fnIx)
    if armLen != 0 { return if armLen < 0 { -1 } else { 0 } }
    // A string-literal union atom widens to its member's string, whose header holds the length.
    if memberLenWidensAtom(e.memObj, fnIx) {
      if emitAtomToStr(e.memObj, fnIx) < 0 { return -1 }
      fbStrLen()
      return 0
    }
    if (
      exprArray(e.memObj, fnIx)
      || exprString(e.memObj, fnIx)
      || exprRefArray(e.memObj, fnIx)
      || exprStringArray(e.memObj, fnIx)
      || numListElemOf(exprListRep(e.memObj, fnIx)) != null
      || exprU8Array(e.memObj, fnIx)
    ) {
      return emitArrLen(exprIx, fnIx)
    }
    // G8: `m.length` on a MAP is the LIVE entry count — struct field 5 (`size`),
    // maintained by set/delete (NOT `count`, which includes tombstones).
    if exprMap(e.memObj, fnIx) {
      if emitExpr(e.memObj, fnIx) < 0 { return -1 }
      return mapSizeTail(e.memObj, fnIx)
    }
  }
  return emitMem(exprIx, fnIx)
}

// A read at `idxIx` of a union-of-containers box a pin left unrewritten (D16897), an index,
// `.length` or a map's `.has` / `.get` (`armSiteRecv`): per arm, the read lowers with its
// receiver overridden to that arm, delivered into the read's type. 0 when `idxIx` is not such
// a read, 1 when emitted, -1 on failure.
function emitArmSite(idxIx: i32, fnIx: i32): i32 {
  if idxIx < 0 || idxIx >= P.nodes.length || !armSiteReads(idxIx, fnIx) {
    return 0
  }
  const recv = armSiteRecv(idxIx)
  if recv < 0 || recv >= P.nodes.length { return 0 }
  const arms = ctnArmsAt(nodeTyAt(recv, fnIx))
  const u = nodeTyAt(idxIx, fnIx)
  // A receiver that is no name is read once, into the box stash the arms test.
  let slot = -1
  if !(nodeAt(recv) is Ident) {
    slot = sharedFieldRecvSlot()
    if emitExpr(recv, fnIx) < 0 { return -1 }
    fbLocalSet(slot)
  }
  // A read at a numeric literal set is at the set's scalar rep, never boxed (D17001).
  const uName = if numLitUnionBaseName(u) != "" { "" } else { boxTyName(u) }
  // An element union that is no box is a string (a literal union joined with `string`) or an
  // atom (two literal unions); each arm's element is delivered at that rep.
  const k = if uName == "" { repSigKindOfTy(u) } else { "union" }
  // A map arm's read of a nullable string is that string ref at every arm.
  const nulStr = k == "nulstr" && tyAt(arms[0]) is TyMap
  if k != "union" && k != "str" && k != "i32" && !nulStr {
    return emitFail(
      "emitProgram: a union-of-lists element read has no element union box",
    )
  }
  return emitArmSiteAt(idxIx, recv, slot, arms, 0, u, uName, fnIx)
}

// The reads `emitArmSiteAt` overrides to an arm's unboxed payload, and the local each
// reads; innermost last. Empty outside a union-of-lists arm.
let luOvLocNodes: i32[] = []
let luOvLocSlots: i32[] = []

// Overrides read `ix` to local `slot`; returns the mark `luOvLocalLeave` restores to.
function luOvLocalEnter(ix: i32, slot: i32): i32 {
  const mark = luOvLocNodes.length
  luOvLocNodes.push(ix)
  luOvLocSlots.push(slot)
  return mark
}

// Drops every local override pushed since `mark`.
function luOvLocalLeave(mark: i32) {
  while luOvLocNodes.length > mark {
    luOvLocNodes.pop()
    luOvLocSlots.pop()
  }
  return 0
}

// The local an override reads `ix` from, or -1.
function luOvLocalOf(ix: i32): i32 {
  let k = luOvLocNodes.length - 1
  while k >= 0 {
    if luOvLocNodes[k] == ix { return luOvLocSlots[k] }
    k = k - 1
  }
  return -1
}

// Pushes `emitArmSite`'s receiver box: its stash `slot`, or the name re-read when -1.
function armRecvPush(recv: i32, slot: i32, fnIx: i32): i32 {
  if slot < 0 { return emitExpr(recv, fnIx) }
  fbLocalGet(slot)
  return 0
}

// What a read at `site` yields at arm `m`: a list's element, a map's value or null for an
// index or `.get`, else the read's own type; -1 when the arm has none.
function armSiteTyOf(site: i32, m: i32, fnIx: i32): i32 {
  const n = nodeAt(site)
  const t = tyAt(m)
  if t is TyArray && n is Index { return tyArrayElemIx(m) }
  if t is TyMap && (n is Index || n is Call && armSiteIsGet(n)) {
    return mkNullableTyOf(tyMapValOf(m))
  }
  return nodeTyAt(site, fnIx)
}

function armSiteIsGet(n: Call): boolean {
  if n.callFn < 0 || n.callFn >= P.nodes.length { return false }
  const f = nodeAt(n.callFn)
  return f is Member && f.memProp == "get"
}

// The heap an arm `m`'s payload casts to: a list's wrapper or a map's struct; -1 for none.
function armHeapOf(m: i32): i32 {
  if unMemIsMap(m) { return mapTypeIdxOf(mapShapeFoldSet(mapArmShapeOfTy(m))) }
  return listArmHeapOf(m)
}

// The scratch local an arm `m`'s payload is held in, typed at `armHeapOf`; -1 for none.
function armWrapLocal(m: i32): i32 {
  if unMemIsMap(m) {
    const h = armHeapOf(m)
    return if h >= 0 { scratchSlot(47, "list", h, SCRATCH_BY_BOTH) } else { -1 }
  }
  return luArmWrapLocal(m)
}

// The scratch local an arm `m`'s unboxed list is held in, typed at its wrapper, or -1 for a
// list kind with none.
function luArmWrapLocal(m: i32): i32 {
  // The box tag first: a numeric literal-union list rides the `i32[]` wrapper (D4770).
  const k = boxTagOfTy(m)
  // A boolean list rides the i32 list's wrapper.
  if k == 7 || k == 17 || k == 18 {
    return scratchSlot(46, "list", 0, SCRATCH_BY_BOTH)
  }
  if k == 8 { return scratchSlot(46, "f64list", 0, SCRATCH_BY_BOTH) }
  if k == 9 { return scratchSlot(46, "strlist", 0, SCRATCH_BY_BOTH) }
  if k == 10 { return scratchSlot(46, "i64list", 0, SCRATCH_BY_BOTH) }
  if k == 12 { return scratchSlot(46, "f32list", 0, SCRATCH_BY_BOTH) }
  if k == V128_LIST_KIND {
    return scratchSlot(46, "v128list", 0, SCRATCH_BY_BOTH)
  }
  // A packed byte list rides its own row's wrapper (`listWrapHeapOfKind`).
  const pr = if k == 13 { PK_U8 } else { pkRowOfKind(k) }
  if pr >= 0 { return scratchSlot(46, "u8list", pr, SCRATCH_BY_BOTH) }
  if unMemIsRefElemArray(m) {
    const rs = unMemRefArrArmSlot(m)
    if rs < 0 { return -1 }
    return scratchSlot(46, "reflist", rs, SCRATCH_BY_BOTH)
  }
  return -1
}

// Converts the scalar on the stack from rep `from` to rep `to`, a member of a numeric literal set
// read out of a list arm stored wider or apart, so the conversion is exact.
function emitNumRepNarrow(from: VKind, to: VKind): i32 {
  if from == to { return 0 }
  if to == "i32" && from == "i64" {
    fbI32WrapI64()
    return 0
  }
  if to == "i32" && from == "f64" {
    fbI32TruncF64S()
    return 0
  }
  if to == "i32" && from == "f32" {
    fbI32TruncF32S()
    return 0
  }
  if to == "i64" && from == "f64" {
    fbI64TruncF64S()
    return 0
  }
  if to == "i64" && from == "f32" {
    fbI64TruncF32S()
    return 0
  }
  if to == "f64" && from == "i32" {
    fbF64ConvertI32S()
    return 0
  }
  if to == "f64" && from == "i64" {
    fbF64ConvertI64S()
    return 0
  }
  return emitFail(
    "emitProgram: a list arm's element has no conversion to the literal set read",
  )
}

// `recv[i] = v` through a union-of-lists box a pin or an `is K[]` arm left unrewritten: per list
// arm, the store lowers with `recv` overridden to that arm, its value converted to the arm's
// element as any store converts it. 0 when `target` is no such store, 1 when emitted.
function emitArmIndexWrite(fnIx: i32, a: BinExpr, target: Index): i32 {
  const recv = unwrapParen(target.idxArr)
  if recv < 0 || recv >= P.nodes.length || !(nodeAt(recv) is Ident) { return 0 }
  if luOvLocalOf(recv) >= 0 || !exprUnion(recv, fnIx) { return 0 }
  const arms = luMembersAt(nodeTyAt(recv, fnIx))
  if arms.length == 0 { return 0 }
  if emitArmIndexWriteAt(fnIx, a, target, recv, arms, 0) < 0 { return -1 }
  asgParkedSlot = -1
  return 1
}

function emitArmIndexWriteAt(
  fnIx: i32,
  a: BinExpr,
  target: Index,
  recv: i32,
  arms: i32[],
  i: i32,
): i32 {
  if i >= arms.length {
    fbUnreachable()
    return 0
  }
  const m = arms[i]
  const t = listIsArmTag(m)
  const heap = armHeapOf(m)
  const loc = armWrapLocal(m)
  if t < 0 || heap < 0 || loc < 0 {
    return emitFail(
      "emitProgram: a union-of-lists arm has no wrapper to store through",
    )
  }
  if emitExpr(recv, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 0)
  fbI32Rel(RS_TAG, t)
  fbI32Bin(70) // 0x46 i32.eq
  fbIf(64)
  if emitExpr(recv, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1)
  fbRefCast(heap)
  fbLocalSet(loc)
  const mark = luOvEnter(recv, m)
  const lmark = luOvLocalEnter(recv, loc)
  const r = emitAssignIndex(fnIx, a, target)
  // The arm's own store parks nothing a caller reads: the assignment is a statement here.
  if asgParkedSlot >= 0 {
    fbLocalGet(asgParkedSlot)
    fbDrop()
  }
  luOvLocalLeave(lmark)
  luOvLeave(mark)
  if r < 0 { return -1 }
  fbElse()
  if emitArmIndexWriteAt(fnIx, a, target, recv, arms, i + 1) < 0 { return -1 }
  fbEnd()
  return 0
}

// Arm `i` onward of `emitArmSite`'s tag chain.
function emitArmSiteAt(
  idxIx: i32,
  recv: i32,
  slot: i32,
  arms: i32[],
  i: i32,
  u: i32,
  uName: string,
  fnIx: i32,
): i32 {
  if i >= arms.length {
    fbUnreachable()
    return 1
  }
  const m = arms[i]
  const t = listIsArmTag(m)
  const e = armSiteTyOf(idxIx, m, fnIx)
  if t < 0 || e < 0 {
    return emitFail(
      "emitProgram: a union-of-lists arm has no box tag or element to read",
    )
  }
  const loc = armWrapLocal(m)
  const heap = armHeapOf(m)
  if loc < 0 || heap < 0 {
    return emitFail(
      "emitProgram: a union-of-lists arm has no wrapper to read through",
    )
  }
  if armRecvPush(recv, slot, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 0)
  fbI32Rel(RS_TAG, t)
  fbI32Bin(70) // 0x46 i32.eq
  const k: VKind = if uName == "" { repSigKindOfTy(u) ?? "i32" } else { "union" }
  if uName != "" {
    fbIfRef(uBoxIdx)
  } else {
    fbOpenIf()
    fbValtype(k, -1)
  }
  if armRecvPush(recv, slot, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1)
  fbRefCast(heap)
  fbLocalSet(loc)
  const mark = luOvEnter(recv, m)
  luOvEnter(idxIx, e)
  const lmark = luOvLocalEnter(recv, loc)
  let r = 0
  if uName != "" {
    r = emitUnionCoerce(uName, u, idxIx, fnIx)
  } else if k == "str" && tyIsLitUnionOrLit(e) {
    // A literal-union element widens to its member string, as an `if` join's arm does.
    r = emitExpr(idxIx, fnIx)
    if r >= 0 {
      setStrScrI(0)
      r = emitAtomToStrChain(tyLitMemberTexts(e), 0, strScratchBase + 3)
    }
  } else {
    r = emitExpr(idxIx, fnIx)
    // A read at a numeric literal set takes each arm's member at the set's own rep (D17001).
    if r >= 0 && numLitUnionBaseName(u) != "" {
      r = emitNumRepNarrow(repSigKindOfTy(e) ?? k, k)
    }
  }
  luOvLocalLeave(lmark)
  luOvLeave(mark)
  if r < 0 { return -1 }
  fbElse()
  if emitArmSiteAt(idxIx, recv, slot, arms, i + 1, u, uName, fnIx) < 0 {
    return -1
  }
  fbEnd()
  return 1
}

// ── numeric-union dispatch ─────────────────────────────────────────────────────
// An operator over a union of numeric primitives computes at each member's own type: each
// operand is evaluated once into a lazy-frame stash, a tag test picks the member, and every
// member pair takes the scalar rule (`numPairOpTy`). A union result re-boxes each pair's value.

// How deeply the operands being stashed are nested, so an inner dispatch stashes apart.
let njDepth = 0
// The dispatch being lowered: its operator node, its two operands' member types (a scalar
// operand is its one type), their stash slots (-2 for a literal emitted per arm), and the
// result's shape. Set once per dispatch; the arms read them and run no user code.
let njBin = -1
let njOp = ""
let njLTys: i32[] = []
let njRTys: i32[] = []
let njLUnion = false
let njRUnion = false
let njLSlot = -1
let njRSlot = -1
let njLIx = -1
let njRIx = -1
let njResBox = false
let njBlockKind: VKind = "i32"
// Whether each side is a two-base integer-literal union, whose pairs compute at `i64` (D3512).
let njLLit = false
let njRLit = false

// Whether the value at `ix` is a two-base integer-literal union rather than a numeric union: its
// members are constants, so an operator over it computes at the common width `i64` (D3512).
function njIsLitSide(ix: i32, fnIx: i32): boolean {
  return numUnionMembersOf(njSideTyOf(ix, fnIx)).length == 0
    && njLitBasesOf(ix, fnIx).length > 0
}

// The type member `m` of the current dispatch's `left` or right side computes at.
function njPairSideTy(left: boolean, m: i32): i32 {
  if (left && njLLit) || (!left && njRLit) { return numPrimTyOfKind(3) }
  return m
}

// A lazy-frame slot for dispatch depth and side `key`: code 26 a `(ref null $uBox)`, code 27 a
// scalar of `kind`. Deduped on all three, so siblings at one depth share it.
function njSlot(code: i32, kind: ListKind, key: i32): i32 {
  let k = 0
  while k < liKinds.length {
    if liBack[k] == code && liSlots[k] == key && liKinds[k] == kind {
      return listIdxScratchBase + 1 + k
    }
    k = k + 1
  }
  liKinds.push(kind)
  liSlots.push(key)
  liBack.push(code)
  return listIdxScratchBase + liKinds.length
}

// Converts the numeric value on the stack from kind `from` to kind `to`: the exact widenings a
// pair performs and the conversions an infallible `as` names.
function njConvert(from: i32, to: i32) {
  if from == to { return 0 }
  if to == 4 {
    if from == 0 { return fbF64ConvertI32S() }
    if from == 3 { return fbF64ConvertI64S() }
    if from == 5 { return fbF64PromoteF32() }
  }
  if to == 5 {
    if from == 0 { return fbF32ConvertI32S() }
    if from == 3 { return fbF32ConvertI64S() }
    if from == 4 { return fbF32DemoteF64() }
  }
  if to == 3 && from == 0 { return fbI64ExtendI32S() }
  return emitFail(
    "emitProgram: a numeric union member has no conversion to this type",
  )
}

// Evaluates operand `ix` once: a numeric union's box into slot code 26, a scalar into code 27.
// A bare numeric literal is left to each arm, at the pair's type (-2). -1 on failure.
function njStash(ix: i32, isUnion: boolean, key: i32, fnIx: i32): i32 {
  if isUnion {
    // A join whose arms are scalars is built as the box here, as a union destination builds it.
    let sr = 0
    if exprUnion(ix, fnIx) {
      sr = emitExpr(ix, fnIx)
    } else {
      sr = emitUnionBoxOwed(
        valueUnionKeyTextOfTy(nodeTyIxOf(ix)),
        nodeTyIxOf(ix),
        ix,
        fnIx,
      )
    }
    if sr < 0 { return -1 }
    const bs = njSlot(26, "list", key)
    fbLocalSet(bs)
    return bs
  }
  if cexLitPeel(ix) >= 0 { return -2 }
  const k = njKindOfExpr(ix)
  if k < 0 { return -1 }
  if emitExprAsKind(ix, k, fnIx) < 0 { return -1 }
  const ss = njSlot(
    27,
    listIdxKindOf(repOfTy(numPrimTyOfKind(k)).rdKind ?? "i32"),
    key,
  )
  fbLocalSet(ss)
  return ss
}

// The kind of scalar operand `ix`, its recorded type's: the checker types every scalar operand
// of a numeric-union operator as a number.
function njKindOfExpr(ix: i32): i32 {
  const k = njKindOfTy(nodeTyIxOf(ix))
  if k >= 0 { return k }
  return emitFail(
    "emitProgram: a numeric union operator's scalar operand has no numeric recorded type",
  )
}

// Pushes one side of the current dispatch at kind `p`, the side holding member type `m`; a
// literal side is built at `p`, the dispatch member's width.
function njPushSide(left: boolean, m: i32, p: i32) {
  let slot = njRSlot
  let isU = njRUnion
  let ix = njRIx
  if left {
    slot = njLSlot
    isU = njLUnion
    ix = njLIx
  }
  if slot == -2 {
    return emitNumLitAs(ix, primNameStr(tyPrimNameOf(numPrimTyOfKind(p))))
  }
  fbLocalGet(slot)
  const mk = njKindOfTy(m)
  if isU {
    if emitUnionUnboxTail(mk) < 0 { return -1 }
  }
  return njConvert(mk, p)
}

// The tag test `box.tag == tag(kind k)` over the box in `slot`.
function njTagTest(slot: i32, k: i32) {
  fbLocalGet(slot)
  fbStructGet(uBoxIdx, 0)
  fbI32Rel(RS_TAG, scalarTagOfKind(k))
  fbI32Bin(70) // 0x46 i32.eq
}

// One member pair of the current binary dispatch: both sides at the pair's type, the operator,
// and the pair's value boxed when the result is a union.
function njPair(a: i32, b: i32) {
  const n = nodeAt(njBin)
  if !(n is BinExpr) {
    return emitFail("emitProgram: numeric union dispatch lost its operator")
  }
  const pty = numPairOpTy(n, njPairSideTy(true, a), njPairSideTy(false, b))
  const p = njKindOfTy(pty)
  if pty < 0 || p < 0 {
    return emitFail(
      "emitProgram: a numeric union member pair has no operator type",
    )
  }
  if njResBox { fbI32Rel(RS_TAG, scalarTagOfKind(p)) }
  const fRem = njOp == "%" && (p == 4 || p == 5)
  if njPushSide(true, a, p) < 0 { return -1 }
  if fRem { f64RemOperandTail(p == 5) }
  if njPushSide(false, b, p) < 0 { return -1 }
  if fRem {
    f64RemOperandTail(p == 5)
    if f64RemCallTail(p == 5) < 0 { return -1 }
  } else {
    const opc = lexOpcode(njOp, numPrimOfKind(p) ?? "i32")
    if opc < 0 {
      return emitFail(
        "emitProgram: operator '"
          + njOp
          + "' has no form at a numeric union member",
      )
    }
    fbI32Bin(opc)
  }
  if njResBox {
    fbStructNew(vbHeapIdxOfKind(p))
    fbStructNew(uBoxIdx)
  }
  return 0
}

// The right side's dispatch under left member `a`, from right member `j` on.
function njArmR(a: i32, j: i32) {
  if !njRUnion || j == njRTys.length - 1 { return njPair(a, njRTys[j]) }
  njTagTest(njRSlot, njKindOfTy(njRTys[j]))
  fbOpenIf()
  fbValtype(njBlockKind, -1)
  if njPair(a, njRTys[j]) < 0 { return -1 }
  fbElse()
  if njArmR(a, j + 1) < 0 { return -1 }
  fbEnd()
  return 0
}

// The left side's dispatch from left member `i` on; the last member is the bare `else`.
function njArmL(i: i32) {
  if !njLUnion || i == njLTys.length - 1 { return njArmR(njLTys[i], 0) }
  njTagTest(njLSlot, njKindOfTy(njLTys[i]))
  fbOpenIf()
  fbValtype(njBlockKind, -1)
  if njArmR(njLTys[i], 0) < 0 { return -1 }
  fbElse()
  if njArmL(i + 1) < 0 { return -1 }
  fbEnd()
  return 0
}

// The numeric type scalar operand `ix` is dispatched at, its recorded type; -1 after a failure.
function njScalarTy(ix: i32): i32 {
  if njKindOfExpr(ix) < 0 { return -1 }
  return nodeTyIxOf(ix)
}

// `a op b` where an operand is a numeric union.
function emitNumUnionBin(e: BinExpr, exprIx: i32, fnIx: i32) {
  const lMs = njMembersOf(e.binLeft, fnIx)
  const rMs = njMembersOf(e.binRight, fnIx)
  const key = njDepth * 2
  njDepth = njDepth + 1
  const ls = njStash(e.binLeft, lMs.length > 0, key, fnIx)
  let rs = -1
  if ls != -1 { rs = njStash(e.binRight, rMs.length > 0, key + 1, fnIx) }
  njDepth = njDepth - 1
  if ls == -1 || rs == -1 { return -1 }
  njBin = exprIx
  njOp = e.binOp
  njLUnion = lMs.length > 0
  njRUnion = rMs.length > 0
  njLLit = njLUnion && njIsLitSide(e.binLeft, fnIx)
  njRLit = njRUnion && njIsLitSide(e.binRight, fnIx)
  njLTys = lMs
  if !njLUnion { njLTys = [njScalarTy(e.binLeft)] }
  njRTys = rMs
  if !njRUnion { njRTys = [njScalarTy(e.binRight)] }
  njLSlot = ls
  njRSlot = rs
  njLIx = e.binLeft
  njRIx = e.binRight
  // The result's shape from the pairs themselves, as the checker's `numUnionResultTy` builds it.
  const rks = njResultKinds(e)
  if rks.length == 0 {
    return emitFail(
      "emitProgram: a numeric union member pair has no operator type",
    )
  }
  njResBox = rks.length > 1 && !numCmpOp(e.binOp)
  njBlockKind = "i32"
  if njResBox {
    njBlockKind = "union"
  } else if !numCmpOp(e.binOp) {
    njBlockKind = repOfTy(numPrimTyOfKind(rks[0])).rdKind ?? "i32"
  }
  // The node's consumers read its recorded type, so a result shape it does not name is refused
  // loudly rather than handed on in a rep they do not expect (D3453).
  if !numCmpOp(e.binOp) {
    const recTy = njSideTyOf(exprIx, fnIx)
    const recBox = tyIsNumUnion(recTy)
    if recBox != njResBox || (!njResBox && njKindOfTy(recTy) != rks[0]) {
      return emitFail(
        "emitProgram: an operator over a numeric union has no recorded result type at this instance",
      )
    }
  }
  return njArmL(0)
}

// The distinct kinds the member pairs of the current dispatch compute at, in first-seen order;
// empty when a pair has none.
function njResultKinds(e: BinExpr): i32[] {
  const out: i32[] = []
  const none: i32[] = []
  for a in njLTys {
    for b in njRTys {
      const k = njKindOfTy(
        numPairOpTy(e, njPairSideTy(true, a), njPairSideTy(false, b)),
      )
      if k < 0 { return none }
      let seen = false
      for q in out {
        if q == k { seen = true }
      }
      if !seen { out.push(k) }
    }
  }
  return out
}

// Whether `as` to kind `to` over the members `ms` can fail at none of them (`numUnionAsConverts`).
function njAsConverts(ms: i32[], to: i32): boolean {
  const tn = primNameStr(tyPrimNameOf(numPrimTyOfKind(to)))
  for m in ms {
    if numCastCanFail(primNameStr(tyPrimNameOf(m)), tn) { return false }
  }
  return true
}

// Converts the numeric union at `ix` to kind `to` at whichever member it holds: an infallible
// `as`, and a delivery into a numeric primitive every member widens to exactly.
function emitNumUnionConvert(ix: i32, to: i32, fnIx: i32) {
  const ms = njMembersOf(ix, fnIx)
  const key = njDepth * 2
  njDepth = njDepth + 1
  const bs = njStash(ix, true, key, fnIx)
  njDepth = njDepth - 1
  if bs < 0 { return -1 }
  return njConvertArm(ms, 0, bs, to)
}

// The conversion dispatch from member `i` on; the last member is the bare `else`.
function njConvertArm(ms: i32[], i: i32, bs: i32, to: i32) {
  const mk = njKindOfTy(ms[i])
  if i == ms.length - 1 {
    fbLocalGet(bs)
    if emitUnionUnboxTail(mk) < 0 { return -1 }
    return njConvert(mk, to)
  }
  njTagTest(bs, mk)
  fbOpenIf()
  fbValtype(repOfTy(numPrimTyOfKind(to)).rdKind ?? "i32", -1)
  fbLocalGet(bs)
  if emitUnionUnboxTail(mk) < 0 { return -1 }
  if njConvert(mk, to) < 0 { return -1 }
  fbElse()
  if njConvertArm(ms, i + 1, bs, to) < 0 { return -1 }
  fbEnd()
  return 0
}

// A numeric union at `ix` delivered to the union `unionName` that lacks one of its members but
// holds a member it widens to: re-boxed member by member. 1 done, 0 not this shape, -1 failure.
function emitNumUnionRebox(
  ix: i32,
  unionName: string,
  unionTy: i32,
  fnIx: i32,
): i32 {
  if unionName == "" || !numUnionReboxes(ix, unionTy, fnIx) { return 0 }
  const ms = njMembersOf(ix, fnIx)
  const dk: i32[] = []
  msMemberValKindsOf(msSetOfTyAny(unionTy), dk)
  const key = njDepth * 2
  njDepth = njDepth + 1
  const bs = njStash(ix, true, key, fnIx)
  njDepth = njDepth - 1
  if bs < 0 { return -1 }
  if njReboxArm(ms, 0, bs, dk) < 0 { return -1 }
  return 1
}

// The re-box dispatch from member `i` on; the last member is the bare `else`.
function njReboxArm(ms: i32[], i: i32, bs: i32, dk: i32[]) {
  const mk = njKindOfTy(ms[i])
  const sk = njStoreKind(mk, dk)
  const last = i == ms.length - 1
  if !last {
    njTagTest(bs, mk)
    fbOpenIf()
    fbValtype("union", -1)
  }
  if sk == mk {
    fbLocalGet(bs)
    fbRefAsNonNull()
  } else {
    fbI32Rel(RS_TAG, scalarTagOfKind(sk))
    fbLocalGet(bs)
    if emitUnionUnboxTail(mk) < 0 { return -1 }
    if njConvert(mk, sk) < 0 { return -1 }
    fbStructNew(vbHeapIdxOfKind(sk))
    fbStructNew(uBoxIdx)
  }
  if !last {
    fbElse()
    if njReboxArm(ms, i + 1, bs, dk) < 0 { return -1 }
    fbEnd()
  }
  return 0
}

// `-x` over the numeric union at `ix`: each member negates at its own type, re-boxed.
function emitNumUnionNeg(ix: i32, fnIx: i32) {
  const ms = njMembersOf(ix, fnIx)
  const key = njDepth * 2
  njDepth = njDepth + 1
  const bs = njStash(ix, true, key, fnIx)
  njDepth = njDepth - 1
  if bs < 0 { return -1 }
  return njNegArm(ms, 0, bs)
}

// The negation dispatch from member `i` on; the last member is the bare `else`.
function njNegArm(ms: i32[], i: i32, bs: i32) {
  const mk = njKindOfTy(ms[i])
  if i < ms.length - 1 {
    njTagTest(bs, mk)
    fbOpenIf()
    fbValtype("union", -1)
  }
  fbI32Rel(RS_TAG, scalarTagOfKind(mk))
  if mk == 0 { fbI32Const(0) }
  if mk == 3 { fbI64Const(0, 0) }
  fbLocalGet(bs)
  if emitUnionUnboxTail(mk) < 0 { return -1 }
  if mk == 0 {
    fbI32Bin(107) // 0x6b i32.sub
  }
  if mk == 3 {
    fbI32Bin(125) // 0x7d i64.sub
  }
  if mk == 4 { fbF64Neg() }
  if mk == 5 { fbF32Neg() }
  fbStructNew(vbHeapIdxOfKind(mk))
  fbStructNew(uBoxIdx)
  if i < ms.length - 1 {
    fbElse()
    if njNegArm(ms, i + 1, bs) < 0 { return -1 }
    fbEnd()
  }
  return 0
}

// The `%` lowering over two float operands: each at f64, then a call into the shared
// `__f64_rem__` helper (D1586). `atF32` writes each operand at f32 first, so a literal like `0.1`
// uses f32's value, then promotes it, and demotes the exact result.
function emitF64RemCall(lIx: i32, rIx: i32, fnIx: i32, atF32: boolean) {
  const k = if atF32 { 5 } else { 4 }
  if emitWidened(lIx, k, fnIx) < 0 { return -1 }
  f64RemOperandTail(atF32)
  if emitWidened(rIx, k, fnIx) < 0 { return -1 }
  f64RemOperandTail(atF32)
  return f64RemCallTail(atF32)
}

// Float `%`'s writer halves, which legacy's two writers and the IR's lowering call around their
// operands: an operand written at f32 is promoted, then the helper is called and demoted back.
export function f64RemOperandTail(atF32: boolean) {
  if atF32 { fbF64PromoteF32() }
  return 0
}

// An unreserved helper would be a `call` to index -1, so a miss fails loudly here.
export function f64RemCallTail(atF32: boolean) {
  if gHelpF64Rem < 0 {
    return emitFail(
      "emitProgram: a float '%' reached the emitter with no __f64_rem__ helper reserved",
    )
  }
  fbCall(gHelpF64Rem)
  if atF32 { fbF32DemoteF64() }
  return 0
}

// ── Shift/mask strength reduction (plumb PL-037 item 2) ──────────────────────────────────
// `((x >>> k) & m) << j` is `(x >>> (k-j)) & (m << j)` (or `(x << (j-k)) & (m << j)` when j > k):
// bit i of both is m[i-j] & x[i-j+k] for i >= j and 0 below, since a logical shift fills zeros.
// Binaryen 130 folds neither this nor the i64 narrowing below at any level, so the emitter does.

// Whether node `ix` is typed exactly `i64` (`wide`) or `i32` (a paren is its inner node).
function srTyIs(ix: i32, wide: boolean, fnIx: i32): boolean {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return false }
  const p = tyPrimNameOf(nodeTyAt(x, fnIx))
  if wide { return p == "i64" }
  return p == "i32"
}

// A shift count at `ix`: a compile-time integer in 0..w-1, else -1.
function srShiftConst(ix: i32, w: i32, fnIx: i32): i64 {
  const v = memOffsetConstValue(ix, fnIx)
  if v < 0 || v >= w { return -1 }
  return v
}

// A mask at `ix`: a compile-time integer that is non-negative at width `w` (at most 2^31-1 for
// i32, 2^32-1 for i64 — `memOffsetConstValue`'s own ceiling), else -1.
function srMaskConst(ix: i32, w: i32, fnIx: i32): i64 {
  if w == 32 { return memAddrConst(ix, fnIx) }
  return memOffsetConstValue(ix, fnIx)
}

// The exponent j of a power-of-two multiplier at `ix`, 0..w-1, else -1: `y * 2^j` is `y << j`
// at every width, both being multiplication modulo 2^w.
function srPow2Exp(ix: i32, w: i32, fnIx: i32): i64 {
  const v = srMaskConst(ix, w, fnIx)
  if v <= 0 || (v & (v - 1)) != 0 { return -1 }
  let j: i64 = 0
  while ((1 as i64) << j) < v { j = j + 1 }
  if j >= w { return -1 }
  return j
}

// Whether `m < 2^bits` for a non-negative mask `m` (every such mask is below 2^33).
function srMaskBelow(m: i64, bits: i64): boolean {
  if bits >= 33 { return true }
  return m < ((1 as i64) << bits)
}

// The shifted source under mask `m` at width `w`, as [x, k, narrow]; [] when `ix` is not one.
// `x >>> k`, or `x >> k` when m < 2^(w-k) (the sign fill never reaches a mask bit), gives
// [x, k, 0]. At w = 32, `(y >>> k) as% i32` or `(y >> k) as% i32` with y an i64 gives [y, k, 1]
// when k <= 31 and m < 2^(32-k): the mask reads bits k..31 of y only, which `wrap(y)` keeps.
function srShiftSource(ix: i32, m: i64, w: i32, fnIx: i32): i64[] {
  const none: i64[] = []
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return none }
  const e = nodeAt(x)
  if e is BinExpr { return srShiftBin(e, x, m, w, false, fnIx) }
  return srNarrowSource(x, m, w, fnIx)
}

// `srShiftSource` of a node that is not a shift: an `as% i32` wrap of an i64 shift at w = 32,
// else [].
function srNarrowSource(x: i32, m: i64, w: i32, fnIx: i32): i64[] {
  const none: i64[] = []
  const e = nodeAt(x)
  if e is AsExpr {
    if w != 32 || e.asMode != "wrap" { return none }
    if asExprNumCastDomain(x) != "i32" || !srTyIs(x, false, fnIx) {
      return none
    }
    const z = unwrapParen(e.asObj)
    if z < 0 || z >= P.nodes.length { return none }
    const ze = nodeAt(z)
    if ze is BinExpr { return srShiftBin(ze, z, m, 64, true, fnIx) }
  }
  return none
}

// `srShiftSource` of the shift node `e` (at `x`, width `w`). A narrowing source must also keep
// every mask bit inside the low word: k <= 31 and m < 2^(32-k).
function srShiftBin(
  e: BinExpr,
  x: i32,
  m: i64,
  w: i32,
  narrow: boolean,
  fnIx: i32,
): i64[] {
  const none: i64[] = []
  if e.binOp != ">>>" && e.binOp != ">>" { return none }
  if !srTyIs(x, w == 64, fnIx) || !srTyIs(e.binLeft, w == 64, fnIx) {
    return none
  }
  const k = srShiftConst(e.binRight, w, fnIx)
  if k < 0 { return none }
  if e.binOp == ">>" && !srMaskBelow(m, w - k) { return none }
  if narrow {
    if k > 31 || !srMaskBelow(m, 32 - k) { return none }
    return [e.binLeft as% i64, k, 1]
  }
  return [e.binLeft as% i64, k, 0]
}

// The mask `&` at `ix` of width `w`, as [m, other]; [] when `ix` is not one.
function srMaskOperands(ix: i32, w: i32, fnIx: i32): i64[] {
  const none: i64[] = []
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return none }
  const e = nodeAt(x)
  if e is BinExpr {
    if e.binOp != "&" || !srTyIs(x, w == 64, fnIx) { return none }
    const mr = srMaskConst(e.binRight, w, fnIx)
    if mr >= 0 { return [mr, e.binLeft as% i64] }
    const ml = srMaskConst(e.binLeft, w, fnIx)
    if ml >= 0 { return [ml, e.binRight as% i64] }
  }
  return none
}

// A masked shift at `ix` of width `w`, as [x, k, narrow, m]; [] when `ix` is not one. Either
// `(<shift source>) & m`, or at w = 32 `((y >>> k) & m) as% i32` with y an i64, k <= 31 and
// m < 2^(32-k): the wrap keeps the low word of `(y >>> k) & m`, and so does the narrow form.
function srMaskedSource(ix: i32, w: i32, fnIx: i32): i64[] {
  const mo = srMaskOperands(ix, w, fnIx)
  if mo.length > 0 {
    const src = srShiftSource(mo[1] as% i32, mo[0], w, fnIx)
    if src.length == 0 { return src }
    return [src[0], src[1], src[2], mo[0]]
  }
  if w != 32 { return mo }
  return srWrappedMask(unwrapParen(ix), fnIx)
}

// `srMaskedSource` of an `as% i32` wrap over an i64 masked shift, else [].
function srWrappedMask(x: i32, fnIx: i32): i64[] {
  const none: i64[] = []
  if x < 0 || x >= P.nodes.length { return none }
  const e = nodeAt(x)
  if e is AsExpr {
    if e.asMode != "wrap" { return none }
    if asExprNumCastDomain(x) != "i32" || !srTyIs(x, false, fnIx) {
      return none
    }
    const mo = srMaskOperands(e.asObj, 64, fnIx)
    if mo.length == 0 { return none }
    const src = srShiftSource(mo[1] as% i32, mo[0], 64, fnIx)
    if src.length == 0 { return none }
    if src[1] > 31 || !srMaskBelow(mo[0], 32 - src[1]) { return none }
    return [src[0], src[1], 1, mo[0]]
  }
  return none
}

// Pushes a constant at width `w` (an i32 takes the low 32 bits).
function srConst(v: i64, w: i32) {
  if w == 64 {
    fbI64Const((v >>> 32) as% i32, v as% i32)
  } else {
    fbI32Const(v as% i32)
  }
  return 0
}

// The opcode of `op` at width `w`.
function srOpcode(op: string, w: i32): i32 {
  return lexOpcode(op, if w == 64 { "i64" } else { "i32" })
}

// Pushes source `src` ([x, k, narrow]) exactly as the unreduced chain would have evaluated x: at
// its own width, then `i32.wrap_i64` for a narrowing source.
function srPushSource(src: i64[], w: i32, fnIx: i32): i32 {
  const x = src[0] as% i32
  if src[2] == 1 {
    if emitExprAsKind(x, 3, fnIx) < 0 { return -1 }
    fbI32WrapI64()
    return 0
  }
  if w == 64 { return emitWidened(x, 3, fnIx) }
  return emitExpr(x, fnIx)
}

// Emits narrowing source `src` ([y, k, 1, m]) as `(wrap(y) >>> k) & m`, all at i32.
function srEmitNarrowed(src: i64[], fnIx: i32): i32 {
  if srPushSource(src, 32, fnIx) < 0 { return -1 }
  if src[1] > 0 {
    srConst(src[1], 32)
    fbI32Bin(srOpcode(">>>", 32))
  }
  srConst(src[3], 32)
  fbI32Bin(srOpcode("&", 32))
  return 0
}

// The strength-reduced form of `e` (at `exprIx`, width `w`) as [x, k, narrow, m, j], or [] when it
// is none of the shapes above: `((x >>> k) & m) << j`, the same with `* 2^j`, or a narrowing
// `(y >>> k) as% i32 & m`, whose j is -1. Legacy writes it; the IR builder misses it by name.
export function shiftMaskFoldOf(
  e: BinExpr,
  exprIx: i32,
  w: i32,
  fnIx: i32,
): i64[] {
  const none: i64[] = []
  if !srTyIs(exprIx, w == 64, fnIx) { return none }
  if e.binOp == "&" {
    if w != 32 { return none }
    const nsrc = srMaskedSource(exprIx, w, fnIx)
    if nsrc.length == 0 || nsrc[2] != 1 { return none }
    return [nsrc[0], nsrc[1], nsrc[2], nsrc[3], -1]
  }
  let j: i64 = -1
  let inner = -1
  if e.binOp == "<<" {
    j = srShiftConst(e.binRight, w, fnIx)
    inner = e.binLeft
  } else if e.binOp == "*" {
    j = srPow2Exp(e.binRight, w, fnIx)
    inner = e.binLeft
    if j < 0 {
      j = srPow2Exp(e.binLeft, w, fnIx)
      inner = e.binRight
    }
  }
  if j < 0 { return none }
  const src = srMaskedSource(inner, w, fnIx)
  if src.length == 0 { return none }
  return [src[0], src[1], src[2], src[3], j]
}

// Emits `e` strength-reduced when `shiftMaskFoldOf` names a form: 0 when emitted, -1 on an emit
// failure, 1 when it names none (nothing pushed). Every operand but x is a constant, so
// evaluation order and traps are unchanged.
function emitShiftMaskFold(e: BinExpr, exprIx: i32, w: i32, fnIx: i32): i32 {
  const f = shiftMaskFoldOf(e, exprIx, w, fnIx)
  if f.length == 0 { return 1 }
  if f[4] < 0 { return srEmitNarrowed(f, fnIx) }
  if srPushSource(f, w, fnIx) < 0 { return -1 }
  const k = f[1]
  const j = f[4]
  if k > j {
    srConst(k - j, w)
    fbI32Bin(srOpcode(">>>", w))
  } else if j > k {
    srConst(j - k, w)
    fbI32Bin(srOpcode("<<", w))
  }
  srConst(f[3] << j, w)
  fbI32Bin(srOpcode("&", w))
  return 0
}

// `emitBinExprNode` holding its arithmetic region's classifier answers for the whole walk (D2445).
function emitBinExprInRegion(e: BinExpr, exprIx: i32, fnIx: i32) {
  const opened = bcSpineEnter(exprIx, fnIx)
  const rc = emitBinExprNode(e, exprIx, fnIx)
  bcSpineLeave(opened)
  return rc
}

// How assignment `asgIx` yields its value, in the order legacy tries them: its literal built at its
// width, the `null` it writes, a re-read of its target, the cell or box its store parks, a
// non-null cell re-read or parked, a record its wider row extends, or "none".
export type AsgValueArm = "lit"
  | "nullLit"
  | "reRead"
  | "parked"
  | "nonNullRead"
  | "nonNullPark"
  | "boxedArm"
  | "widerRow"
  | "none"

export function asgValueArmOf(asgIx: i32, fnIx: i32): AsgValueArm {
  if asgLitWidth(unwrapParen(asgIx), fnIx) != "" { return "lit" }
  if asgYieldsNullLit(asgIx) { return "nullLit" }
  // A byte-list cell holds the low byte, so its re-read is not the value; its store parks it.
  if !asgIsByteElem(asgIx, fnIx) && assignTargetReReads(asgIx, fnIx) {
    return "reRead"
  }
  if asgYieldsParkedCell(asgIx, fnIx) { return "parked" }
  const nnc = asgNonNullCell(asgIx, fnIx)
  if nnc == 1 { return "nonNullRead" }
  if nnc == 2 { return "nonNullPark" }
  if asgYieldsBoxedArm(asgIx, fnIx) { return "boxedArm" }
  if asgNameWiderRow(asgIx, fnIx) >= 0 { return "widerRow" }
  return "none"
}

// Store the assignment at `asgIx` and re-read its target cell, then apply `unwidenOp` (an
// opcode, or -1 for none) to take the cell's rep back to the value's (D2512).
function emitAsgValue(asgIx: i32, fnIx: i32, unwidenOp: i32): i32 {
  const a = nodeAt(asgIx)
  if !(a is BinExpr) { return emitFail("emitProgram: expected an assignment") }
  if emitAssign(asgIx, fnIx) < 0 { return -1 }
  // The re-read yields the value just stored, so it is never a read before init (D2652).
  const savedGuardOff = initGuardOff
  initGuardOff = true
  const asgMark = asgReReadEnter(asgIx)
  const asgRc = emitExpr(a.binLeft, fnIx)
  asgReReadLeave(asgMark)
  initGuardOff = savedGuardOff
  if asgRc >= 0 && unwidenOp >= 0 { wU8(unwidenOp) }
  return asgRc
}

// Assignment `exprIx` as a value, on its arm (`asgValueArmOf`).
function emitAsgValueOf(e: BinExpr, exprIx: i32, fnIx: i32): i32 {
  return match asgValueArmOf(exprIx, fnIx) {
    "lit" => emitAsgLitAs(exprIx, asgLitWidth(exprIx, fnIx), fnIx)
    "nullLit" => {
      if emitAssign(exprIx, fnIx) < 0 { return -1 }
      emitExpr(e.binRight, fnIx)
    }
    "reRead" => emitAsgValue(exprIx, fnIx, asgReadUnwidenOp(exprIx, fnIx))
    "parked" => {
      const savedWant = asgParkWanted
      asgParkWanted = true
      const pRc = emitAssign(exprIx, fnIx)
      asgParkWanted = savedWant
      if pRc < 0 { return -1 }
      if asgParkedSlot < 0 || asgParkedOwner != e.binLeft {
        return emitFail(
          "emitProgram: an assignment used as a value stores a cell no local can hold its value from",
        )
      }
      fbLocalGet(asgParkedSlot)
      if asgParkedRef && !tyBearsNull(nodeTyAt(exprIx, fnIx)) {
        fbRefAsNonNull()
      }
      const pOp = asgReadUnwidenOp(exprIx, fnIx)
      if pOp >= 0 { wU8(pOp) }
      0
    }
    "nonNullRead" => {
      if emitAsgValue(exprIx, fnIx, -1) < 0 { return -1 }
      fbRefAsNonNull()
      0
    }
    "nonNullPark" => {
      const nnWant = asgParkWanted
      asgParkWanted = true
      const nnRc = emitAssign(exprIx, fnIx)
      asgParkWanted = nnWant
      if nnRc < 0 { return -1 }
      if asgParkedSlot < 0 || asgParkedOwner != e.binLeft {
        return emitFail(
          "emitProgram: an assignment used as a value stores a cell no local can hold its value from",
        )
      }
      fbLocalGet(asgParkedSlot)
      fbRefAsNonNull()
      0
    }
    "boxedArm" => {
      const savedWant = asgParkWanted
      asgParkWanted = true
      const bRc = emitAssign(exprIx, fnIx)
      asgParkWanted = savedWant
      if bRc < 0 { return -1 }
      if asgParkedSlot < 0 || asgParkedOwner != e.binLeft || !asgParkedRef {
        return emitFail(
          "emitProgram: an assignment used as a value stores a box no local can hold its value from",
        )
      }
      fbLocalGet(asgParkedSlot)
      fbRefAsNonNull()
      emitUnionUnboxTail(boxTagOfTy(nodeTyAt(exprIx, fnIx)))
    }
    // A name whose record the right side's wider record extends by its row's `sub` chain stores
    // that record itself, so the re-read cast back to its row is the value (D16105).
    "widerRow" => {
      if emitAsgValue(exprIx, fnIx, -1) < 0 { return -1 }
      fbRefCast(sHeapIdx[asgNameWiderRow(exprIx, fnIx)])
      0
    }
    "none" => emitFail(
      "emitProgram: an assignment used as a value whose type is not its target's has no value lowering",
    )
  }
}

// Emit the assignment at `exprIx`, whose right side is built at the wide primitive `wp`
// (`asgRadixWidePrim`), as a value of primitive `want`: the stored cell where the widths
// agree, else the 32-bit pattern the checker typed it at, converted as an `i32` is (D3733).
function emitAsgRadixAs(exprIx: i32, wp: string, want: string, fnIx: i32): i32 {
  const ix = unwrapParen(exprIx)
  if wp == want { return emitAsgValue(ix, fnIx, -1) }
  if want == "f64" && wp == "i64" {
    if emitAsgValue(ix, fnIx, -1) < 0 { return -1 }
    fbF64ConvertI64S()
    return 0
  }
  if emitAsgValue(ix, fnIx, asgReadUnwidenOp(ix, fnIx)) < 0 { return -1 }
  if want == "i64" {
    fbI64ExtendI32S()
  } else if want == "f64" {
    fbF64ConvertI32S()
  } else if want == "f32" {
    fbF32ConvertI32S()
  } else {
    return emitFail(
      "emitProgram: a radix assignment value has no "
        + want
        + " conversion",
    )
  }
  return 0
}

// Whether identity compare `e` lowers to `ref.eq`: not when an operand is `null` or holds a
// function, whose `==` lowering is already identity (declaration and environment).
function emitIdentityIsRefEq(e: BinExpr, fnIx: i32): boolean {
  if exprIsNullLit(e.binLeft) || exprIsNullLit(e.binRight) { return false }
  return !identityOperandIsFn(e.binLeft, fnIx)
    && !identityOperandIsFn(e.binRight, fnIx)
}

// `a === b` / `a !== b` over references, `ref.eq`, a union box by its payload, never the box.
function emitIdentityBin(e: BinExpr, _exprIx: i32, fnIx: i32) {
  if emitIdentityOperand(e.binLeft, fnIx) < 0 { return -1 }
  if emitIdentityOperand(e.binRight, fnIx) < 0 { return -1 }
  fbRefEq()
  if e.binOp == "!=" { fbI32Eqz() }
  return 0
}

// Whether `ty`, a nullable peeled, is a union, whose values are boxes.
function identityTyIsUnion(ty: i32): boolean {
  const t = nonNullTy(ty)
  return t >= 0 && tyAt(t) is TyUnion
}

// Emit identity operand `ix` as an `eqref`: the reference itself, or a union box's payload, cast
// down from `anyref` (a `null` arm's payload is null, which `ref.eq` holds equal to null).
function emitIdentityOperand(ix: i32, fnIx: i32): i32 {
  if emitExpr(ix, fnIx) < 0 { return -1 }
  // A read narrowed out of a union's storage still pushes the box (`unionBoxStoreTyOf`).
  if (
    identityTyIsUnion(nodeTyInOf(unwrapParen(ix), fnIx))
    || identityTyIsUnion(unionBoxStoreTyOf(ix, fnIx))
  ) {
    fbStructGet(uBoxIdx, 1)
    fbRefCastNull(-19) // the abstract `eq` heap type
  }
  return 0
}

// Identity over a union of record and function arms (A15): each operand's payload is staged
// as an `eqref`; two closures compare by declaration and environment, anything else by
// `ref.eq`, which already holds a record against a function, or either against `null`, apart.
function emitIdentityMixed(e: BinExpr, fnIx: i32) {
  const a = identityArmSlot(0)
  const b = identityArmSlot(1)
  if emitIdentityOperand(e.binLeft, fnIx) < 0 { return -1 }
  fbLocalSet(a)
  if emitIdentityOperand(e.binRight, fnIx) < 0 { return -1 }
  fbLocalSet(b)
  fbLocalGet(a)
  fbRefTest(cloStructIdx)
  fbLocalGet(b)
  fbRefTest(cloStructIdx)
  fbI32Bin(113) // 0x71 i32.and
  fbIf(127) // (result i32)
  fbLocalGet(a)
  fbRefCast(cloStructIdx)
  fbLocalGet(b)
  fbRefCast(cloStructIdx)
  if emitCloEqCore() < 0 { return -1 }
  fbElse()
  fbLocalGet(a)
  fbLocalGet(b)
  fbRefEq()
  fbEnd()
  if e.binOp == "!=" { fbI32Eqz() }
  return 0
}

function emitBinExprNode(e: BinExpr, exprIx: i32, fnIx: i32) {
  if e.binOp == "==" || e.binOp == "!=" { return emitEqRoute(e, exprIx, fnIx) }
  // A mask that only zero-extends a load is the zero-extending load itself (`zextLoadOf`).
  if e.binOp == "&" {
    const zlAnd = zextLoadOf(exprIx, fnIx)
    if zlAnd >= 0 { return emitZextLoad(zlAnd, fnIx) }
  }
  // Assignment (`=`) is a STATEMENT, not a value expression in this slice: it has
  // no result on the stack (it `local.set`s). It is lowered by `emitAssign` from
  // `emitStmt`, so seeing it as an operand here is an unsupported nested-assignment.
  if e.binOp == "=" {
    // Assignment is an expression yielding its right-hand side (DECISIONS:
    // assignment-as-expression), lowered as store-then-re-read — `emitAssign` stores, then
    // the target re-reads through the Ident path (a local or module global). The functype
    // reads the checker's type of the assignment; D29 is the `string | null` half.
    return emitAsgValueOf(e, exprIx, fnIx)
  }
  // G8: nullish-coalescing `m[k] ?? d` — a FUSED map get-with-default: scan `m` for
  // `k`, push `vals[hit]` on a hit else the default `d`. The self-host checker reads
  // every scope map through `?? -1`. The LHS must be a map index in this slice.
  if e.binOp == "??" { return emitCoalesce(e, exprIx, fnIx) }
  // Short-circuit `&&`/`||` lower to a value-typed `if` (blocktype 0x7f): `a && b` is `if (a)
  // { b } else { 0 }`, `a || b` is `if (a) { 1 } else { b }`.
  if e.binOp == "&&" || e.binOp == "||" {
    const scStart = wLen()
    if emitExpr(e.binLeft, fnIx) < 0 {
      return -1 // condition `a`
    }
    // An `is` this instance decides can leave `b` dead, and `b` reads its operand at the
    // narrowed type, which the value is not here: `b` lowers as a dead arm (D16713).
    const scK = staticIsGuard(e.binLeft, scStart)
    fbIf(127) // 0x04 if, 0x7f i32 result-type blocktype (yields an i32)
    if e.binOp == "&&" {
      // then = b, else = 0
      if scK == 0 { emitDeadValueArm(e.binRight) }
      else if emitExpr(e.binRight, fnIx) < 0 { return -1 }
      fbElse() // 0x05 else
      fbI32Const(0)
    } else {
      // then = 1, else = b
      fbI32Const(1)
      fbElse() // 0x05 else
      if scK == 1 { emitDeadValueArm(e.binRight) }
      else if emitExpr(e.binRight, fnIx) < 0 { return -1 }
    }
    fbEnd() // 0x0b end
    return 0
  }
  return emitBinRefOps(e, exprIx, fnIx)
}

// The arm legacy writes a `==`/`!=` by, in its dispatch order: identity, the numeric union, a dead
// or static `null` test, the scalar map read, the union, atom and nul-none compares, the floors
// with no lowering, the two-rep and niche compares, string, list, `null` test, struct and closure
// compares, and the numeric tail. Every reader of the dispatch asks this one decision.
export type EqRoute = "identMixed"
  | "identRef"
  | "numUnion"
  | "deadNull"
  | "nullNull"
  | "scalarMap"
  | "unionUnion"
  | "unionLeft"
  | "unionRight"
  | "atomFold"
  | "atomStatic"
  | "atomIds"
  | "nulNone"
  | "noLowering"
  | "gRepUnresolved"
  | "xrep"
  | "nulNiche"
  | "str"
  | "list"
  | "nulTest"
  | "variantEq"
  | "structEq"
  | "recordRefused"
  | "closure"
  | "numeric"

// The arm `==`/`!=` node `e` at `exprIx` takes (`EqRoute`), each by the predicate its writer reads.
export function eqRouteOf(e: BinExpr, exprIx: i32, fnIx: i32): EqRoute {
  const l = e.binLeft
  const r = e.binRight
  if e.binIdent != 0 && identityBinIsMixed(e, fnIx) { return "identMixed" }
  if e.binIdent != 0 && emitIdentityIsRefEq(e, fnIx) { return "identRef" }
  if numUnionMinted && njDispatches(e, fnIx) { return "numUnion" }
  if deadNullTestOperand(e, fnIx) >= 0 { return "deadNull" }
  const lNull = nodeAt(unwrapParen(l)) is NullLit
  const rNull = nodeAt(unwrapParen(r)) is NullLit
  if lNull && rNull { return "nullNull" }
  if scalarMapEqPlanOf(e, fnIx).smArm != "none" { return "scalarMap" }
  // A literal-union operand is no union box here: `exprUnion` also claims a `K`-annotated binding.
  if !lNull && !rNull {
    const uqL = exprUnion(l, fnIx) && !eqAtomOperandOk(l, fnIx)
    const uqR = exprUnion(r, fnIx) && !eqAtomOperandOk(r, fnIx)
    if uqL && uqR { return "unionUnion" }
    if uqL { return "unionLeft" }
    if uqR { return "unionRight" }
  }
  const aq = atomEqRouteOf(atomEqPlanOf(e, fnIx).aqArm)
  if aq != null { return aq }
  if nulNoneEqSides(l, r, fnIx) { return "nulNone" }
  if binEqHasNoLowering(exprIx) { return "noLowering" }
  const xrep = xrepEmitPair(e, fnIx)
  if !xrep && binEqGRepUnresolved(exprIx, fnIx) { return "gRepUnresolved" }
  if xrep { return "xrep" }
  if binEqNulNiche(exprIx, fnIx) != "" { return "nulNiche" }
  if exprIsStrEq(exprIx, fnIx) { return "str" }
  if listEqArmOf(e, exprIx, fnIx, listOpKindOfBin(exprIx, fnIx)) != "" {
    return "list"
  }
  if nulTestClaims(e, fnIx) { return "nulTest" }
  if binEqVariantRow(exprIx, fnIx) >= 0 { return "variantEq" }
  if binEqStructRow(exprIx, fnIx) >= 0 { return "structEq" }
  if structIndexOfExpr(l, fnIx) >= 0 || structIndexOfExpr(r, fnIx) >= 0 {
    return "recordRefused"
  }
  if exprVariantIndex(l, fnIx) >= 0 || exprVariantIndex(r, fnIx) >= 0 {
    return "recordRefused"
  }
  if exprIsClosure(l, fnIx) || exprIsClosure(r, fnIx) { return "closure" }
  return "numeric"
}

// The route an atom compare plan's arm takes, or null for `none`: the compare is a later arm's.
function atomEqRouteOf(arm: AtomEqArm): EqRoute | null {
  return match arm {
    "fold" => "atomFold"
    "static" => "atomStatic"
    "ids" => "atomIds"
    "none" => null
  }
}

// Whether `x == null` / `x != null` node `e` takes its rep's own null test (`emitNulIsNullTest`
// claims it).
function nulTestClaims(e: BinExpr, fnIx: i32): boolean {
  const bt = binNulTestOf(e)
  if bt == null { return false }
  return match nulTestArmOf(bt.bnRef, fnIx, bt.bnInvert, false) {
    "none" => false
    "instMap" => instMapIsNullReadOf(bt.bnRef, fnIx).length == 2
    "nnfold" | "nulfold" | "nullty" | "bool" | "atom" | "optChain" | "mapHas" | "boxTag" | "nullRef" | "nulStr" => true
  }
}

// `==`/`!=` node `e` at `exprIx` by its route (`eqRouteOf`). 0, or -1 failed.
function emitEqRoute(e: BinExpr, exprIx: i32, fnIx: i32): i32 {
  const l = e.binLeft
  const r = e.binRight
  const ne = e.binOp == "!="
  return match eqRouteOf(e, exprIx, fnIx) {
    "identMixed" => emitIdentityMixed(e, fnIx)
    "identRef" => emitIdentityBin(e, exprIx, fnIx)
    "numUnion" => emitNumUnionBin(e, exprIx, fnIx)
    "deadNull" => emitDeadNullTest(deadNullTestOperand(e, fnIx), ne, fnIx)
    // Both sides bare `null` is static — true by the type alone, no rep needed (D1018).
    "nullNull" => if ne { fbI32Const(0) } else { fbI32Const(1) }
    "scalarMap" => emitScalarMapReadEq(e, scalarMapEqPlanOf(e, fnIx), fnIx)
    "unionUnion" => emitUnionUnionEq(l, r, ne, fnIx)
    "unionLeft" => emitUnionConcreteEq(l, r, ne, fnIx)
    "unionRight" => emitUnionConcreteEq(r, l, ne, fnIx)
    "atomFold" | "atomStatic" | "atomIds" => emitAtomEqByPlan(e, fnIx)
    "nulNone" => emitNulNoneEq(e, fnIx)
    "noLowering" => emitFail("emitProgram: `" + e.binOp + "` over this operand rep has no lowering")
    "gRepUnresolved" => emitFail(
      "emitProgram: the two operands of this list `"
        + e.binOp
        + "` do not resolve to one comparable list rep",
    )
    // Two number lists stored apart compare across their reps (D15055).
    "xrep" => emitListEqXBin(e, fnIx)
    "nulNiche" => emitNulNicheEqBin(e, exprIx, fnIx)
    "str" => emitStrEq(exprIx, fnIx)
    "list" => emitListEqBin(e, exprIx, fnIx)
    "nulTest" => emitNulTestBin(e, fnIx)
    "variantEq" => emitStructEq(exprIx, fnIx, eqRowOfVariant(binEqVariantRow(exprIx, fnIx)))
    "structEq" => emitStructEq(exprIx, fnIx, binEqStructRow(exprIx, fnIx))
    // Either side naming a layout without the two agreeing is a compare this emitter refuses
    // rather than guesses at (D57).
    "recordRefused" => emitFail("emitProgram: struct equality is not supported yet")
    "closure" => emitClosureEq(e, exprIx, fnIx)
    "numeric" => emitBinNumeric(e, exprIx, fnIx)
  }
}

// An atom compare by its plan (`atomEqPlanOf`): two string-literal types fold, a literal beside
// an atom is its interned id, two atoms compare their ids. Both operands evaluate (D2156).
function emitAtomEqByPlan(e: BinExpr, fnIx: i32): i32 {
  const aq = atomEqPlanOf(e, fnIx)
  if aq.aqArm == "fold" {
    if emitStaticLitAtom(e.binLeft, aq.aqLex, fnIx) < 0 { return -1 }
    fbDrop()
    if emitStaticLitAtom(e.binRight, aq.aqLexR, fnIx) < 0 { return -1 }
    fbDrop()
    if strLexSameValue(aq.aqLex, aq.aqLexR) == (e.binOp == "==") {
      fbI32Const(1)
    } else {
      fbI32Const(0)
    }
    return 0
  }
  if aq.aqArm == "static" {
    if aq.aqStaticLeft {
      if emitStaticLitAtom(e.binLeft, aq.aqLex, fnIx) < 0 { return -1 }
      if emitExpr(e.binRight, fnIx) < 0 { return -1 }
    } else {
      if emitExpr(e.binLeft, fnIx) < 0 { return -1 }
      if emitStaticLitAtom(e.binRight, aq.aqLex, fnIx) < 0 { return -1 }
    }
    return atomEqTail(e.binOp == "!=")
  }
  if emitExpr(e.binLeft, fnIx) < 0 { return -1 }
  if emitExpr(e.binRight, fnIx) < 0 { return -1 }
  return atomEqTail(e.binOp == "!=")
}

// D1576 — `x == null` where `x` is the `null` type is statically true (`!=` false): the
// non-literal side evaluates for its effect (`nulNoneEqSides`).
function emitNulNoneEq(e: BinExpr, fnIx: i32): i32 {
  if emitNulNoneForEffect(e.binLeft, fnIx) < 0 { return -1 }
  if emitNulNoneForEffect(e.binRight, fnIx) < 0 { return -1 }
  if e.binOp == "==" { fbI32Const(1) } else { fbI32Const(0) }
  return 0
}

// A `==`/`!=` over a nullable ref niche (`binEqNulNiche`), the wrapper's `==` answer negated for
// `!=`.
function emitNulNicheEqBin(e: BinExpr, exprIx: i32, fnIx: i32): i32 {
  if emitNulNicheEq(exprIx, fnIx, binEqNulNiche(exprIx, fnIx)) < 0 { return -1 }
  if e.binOp == "!=" { fbI32Eqz() }
  return 0
}

// A list `==`/`!=`: length and element value-compare, each operand recovered and synced.
function emitListEqBin(e: BinExpr, exprIx: i32, fnIx: i32): i32 {
  if emitExpr(e.binLeft, fnIx) < 0 { return -1 }
  if listEqOperandTail(e.binLeft, fnIx) < 0 { return -1 }
  if emitExpr(e.binRight, fnIx) < 0 { return -1 }
  if listEqOperandTail(e.binRight, fnIx) < 0 { return -1 }
  return listEqTail(e, exprIx, fnIx)
}

// `x == null` / `x != null` by the rep's own null test, the ladder the `is null` guard shares;
// `!=` is the inverted direction the ladder writes itself.
function emitNulTestBin(e: BinExpr, fnIx: i32): i32 {
  const bt = binNulTestOf(e)
  if bt == null {
    return emitFail(
      "emitProgram: internal: eqRouteOf and its writer disagree (null test with no operand)",
    )
  }
  const bnt = emitNulIsNullTest(bt.bnRef, fnIx, bt.bnInvert, false)
  if bnt < 0 { return -1 }
  if bnt == 0 {
    return emitFail(
      "emitProgram: internal: eqRouteOf and its writer disagree (null test ladder declined)",
    )
  }
  return 0
}

// Function-value `==`/`!=`: identity, the same lifted function and the same captured env.
function emitClosureEq(e: BinExpr, exprIx: i32, fnIx: i32): i32 {
  if emitExpr(e.binLeft, fnIx) < 0 { return -1 }
  if emitEqRecoverNarrowed(e.binLeft, fnIx) < 0 { return -1 }
  if emitExpr(e.binRight, fnIx) < 0 { return -1 }
  if emitEqRecoverNarrowed(e.binRight, fnIx) < 0 { return -1 }
  if emitEqNonNullCore(exprIx, fnIx) < 0 { return -1 }
  if e.binOp == "!=" { fbI32Eqz() }
  return 0
}

// The compare after an atom `==`/`!=`'s two ids: `i32.eq`, and `i32.eqz` for `!=` (never
// `i32.ne`, so every writer of the compare emits one byte form). 0.
export function atomEqTail(ne: boolean): i32 {
  fbI32Bin(70) // 0x46 i32.eq
  if ne { fbI32Eqz() }
  return 0
}

// Which list compare `emitBinRefOps` runs for `e` (its `listOpKindOfBin` is `lopK`): "any" for
// a rep's generic core, "nonnull" for the non-null core, "" for none. Any operator but `+`
// with a list operand takes the non-null core.
function listEqArmOf(e: BinExpr, exprIx: i32, fnIx: i32, lopK: EqCore): string {
  if (
    (e.binOp == "==" || e.binOp == "!=")
    && eqgListKindOfBin(exprIx, fnIx, lopK) >= 0
  ) {
    return "any"
  }
  return if lopK != "none" && e.binOp != "+" { "nonnull" } else { "" }
}

// After one list compare operand: its narrowed read recovered and a view synced.
export function listEqOperandTail(ix: i32, fnIx: i32): i32 {
  if emitEqRecoverNarrowed(ix, fnIx) < 0 { return -1 }
  svSyncRecv(ix, fnIx)
  return 0
}

// After both list compare operands: the compare `listEqArmOf` picks, negated for `!=`.
export function listEqTail(e: BinExpr, exprIx: i32, fnIx: i32): i32 {
  const lopK = listOpKindOfBin(exprIx, fnIx)
  if listEqArmOf(e, exprIx, fnIx, lopK) == "any" {
    const gK = eqgListKindOfBin(exprIx, fnIx, lopK)
    if emitListEqAnyRep(gK, listOpSlotOfBin(exprIx, fnIx), fnIx) < 0 {
      return -1
    }
  } else if emitEqNonNullCore(exprIx, fnIx) < 0 {
    return -1
  }
  if e.binOp == "!=" { fbI32Eqz() }
  return 0
}

// Whether `==`/`!=` node `e` (at `exprIx`) takes the list compare (`eqRouteOf`'s `list`).
export function listEqRouteOf(e: BinExpr, exprIx: i32, fnIx: i32): boolean {
  if e.binOp != "==" && e.binOp != "!=" { return false }
  return eqRouteOf(e, exprIx, fnIx) == "list"
}

// `emitBinExprNode` over reference operands: the list `+` floor, the string, list, struct
// and function-value compares, and a `null` test of any nullable value.
function emitBinRefOps(e: BinExpr, exprIx: i32, fnIx: i32) {
  // The `+` half of the same floor: a list concat whose element rep has no core. Above the
  // string/list dispatch below for the reason its `==` twin is — every classifier there reads
  // an operand by a rep it may not have — and above the numeric tail, which a list none of the
  // classifiers claim would otherwise reach.
  if binConcatRepUnresolved(exprIx, fnIx) {
    return emitFail(
      "emitProgram: the two operands of this list `+` do not resolve to one list rep",
    )
  }
  // G6 string operators (a string is a `(array i32)` of code points): `+` is a new
  // concatenated array; `==`/`!=` are element-wise value-equality, not ref identity — so they
  // take their own inline lowering before the i32 `lexOpcode` path, which would emit `i32.eq`
  // (ref identity) for strings. Only string-typed operands route here.
  if exprIsStrConcat(exprIx, fnIx) { return emitStrConcat(exprIx, fnIx) }
  if exprIsStrEq(exprIx, fnIx) { return emitStrEq(exprIx, fnIx) }
  if exprIsStrOrder(exprIx, fnIx) { return emitStrOrder(exprIx, fnIx) }
  // List `==`/`!=` (length + element value-compare, recursive through nested lists/string
  // elements) and list `+` (concat) — collections-design §VL.4/§VL.6, inlined rather than
  // helper calls. List `+` over a rep other than the i32 list is checked above the compare
  // dispatch, because `listOpKindOfBin` claims a string list it has no concat for.
  const cat = listCatRouteOf(e, exprIx, fnIx)
  if cat == "refused" {
    return emitFail(
      "emitProgram: list concat over this element kind is not supported",
    )
  }
  if cat != "none" {
    const catK = catListKindOfBin(exprIx, fnIx)
    if catK <= 0 { return emitListConcatI(e.binLeft, e.binRight, exprIx, fnIx) }
    return emitListConcatG(
      e.binLeft,
      e.binRight,
      exprIx,
      fnIx,
      catK,
      catSlotOfBin(exprIx, fnIx),
      catWidenSideOfBin(exprIx, fnIx),
    )
  }
  // Asked once and threaded into the compare arms below, one node's answer.
  const lopK = listOpKindOfBin(exprIx, fnIx)
  if listEqArmOf(e, exprIx, fnIx, lopK) != "" {
    if emitExpr(e.binLeft, fnIx) < 0 { return -1 }
    if listEqOperandTail(e.binLeft, fnIx) < 0 { return -1 }
    if emitExpr(e.binRight, fnIx) < 0 { return -1 }
    if listEqOperandTail(e.binRight, fnIx) < 0 { return -1 }
    return listEqTail(e, exprIx, fnIx)
  }
  return emitBinNumeric(e, exprIx, fnIx)
}

// An operand of a numeric operator at the operator's width `w`: a literal is built there, so a
// literal node read at two widths (a const's initializer under a desugared match arm) is right at
// each; anything else widens to `w`.
function emitBinOperandAs(ix: i32, w: string, fnIx: i32) {
  const lit = emitNumLitAs(ix, w)
  if lit != -2 { return lit }
  if w == "f32" { return emitWidened(ix, 5, fnIx) }
  if w == "f64" { return emitWidened(ix, 4, fnIx) }
  return emitWidened(ix, 3, fnIx)
}

// The scalar type an operand of a numeric operator has to the checker: its recorded type, a
// literal or literal union peeled to its base.
function binOperandScalarTy(ix: i32, fnIx: i32): i32 {
  const t = exprValueTyAt(ix, fnIx)
  const p = tyScalarBasePrim(t)
  const scalars: i32[] = [TY_I32, TY_I64, TY_F32, TY_F64]
  let k = 0
  while k < scalars.length {
    if p != null && tyPrimNameOf(scalars[k]) == p { return scalars[k] }
    k = k + 1
  }
  return t
}

// The width a scalar numeric operator works at: the checker's pair rule over its operands
// (`numPairOpTy`), or `i32` when an operand has no scalar type.
export function binNumWidth(e: BinExpr, fnIx: i32): string {
  const t = numPairOpTy(
    e,
    binOperandScalarTy(e.binLeft, fnIx),
    binOperandScalarTy(e.binRight, fnIx),
  )
  if t < 0 { return "i32" }
  return tyScalarBasePrim(t) ?? "i32"
}

// `emitBinExprNode`'s numeric tail: a numeric union per member, else the operator at the
// checker's width (`binNumWidth`), each operand built or widened there.
function emitBinNumeric(e: BinExpr, exprIx: i32, fnIx: i32) {
  // Every other operator over a numeric union dispatches per member.
  if numUnionMinted && njDispatches(e, fnIx) {
    return emitNumUnionBin(e, exprIx, fnIx)
  }
  const w = binNumWidth(e, fnIx)
  const p: RpPrim = if w == "f32" { "f32" } else if w == "f64" { "f64" } else if w == "i64" { "i64" } else { "i32" }
  const flt = p == "f32" || p == "f64"
  if flt && e.binOp == "%" {
    return emitF64RemCall(e.binLeft, e.binRight, fnIx, p == "f32")
  }
  if !flt {
    const sr = emitShiftMaskFold(
      e,
      exprIx,
      if p == "i64" { 64 } else { 32 },
      fnIx,
    )
    if sr <= 0 { return sr }
  }
  // An operator with no form at its width is refused rather than written over the operands of
  // another; the checker keeps every accepted program off this arm.
  const opc = lexOpcode(e.binOp, p)
  if opc < 0 {
    return emitFail(
      "emitProgram: operator '" + e.binOp + "' has no " + p + " form",
    )
  }
  if p != "i32" {
    if emitBinOperandAs(e.binLeft, p, fnIx) < 0 { return -1 }
    if emitBinOperandAs(e.binRight, p, fnIx) < 0 { return -1 }
  } else {
    // An `i64` shift count wraps to the `i32` operand's width, which masks it as wasm does.
    if emitExpr(e.binLeft, fnIx) < 0 { return -1 }
    if emitExpr(e.binRight, fnIx) < 0 { return -1 }
    if binOperandScalarTy(e.binRight, fnIx) == TY_I64 { fbI32WrapI64() }
  }
  fbI32Bin(opc)
  return 0
}

// The direct call to function index `target`: arguments in parameter order, each emitted
// under its parameter's context with the full coercion suite, then `call`. The caller's
// context is restored before the `call`, and on every failure exit.
function emitDirectCall(callIx: i32, fnIx: i32, target: i32) {
  // A binding's one callee, called in an instance that binds an argument to another type, is
  // refused: one body cannot serve both instances (D6320).
  const dc = nodeAt(callIx)
  if dc is Call {
    const bd = callFnBindingOf(dc.callFn)
    if (
      bd >= 0
      && !hasNamedArgs(dc.callArgNames)
      && directCallInstanceArgMisfit(dc.callArgs, target, fnIx) >= 0
    ) {
      let bn = ""
      const bdn = nodeAt(bd)
      if bdn is LetDecl { bn = bdn.letName }
      // An instance body's nodes carry the instantiating call's position, so the binding anchors.
      return emitFailAt(
        "emitProgram: the function binding `"
          + bn
          + "` is called in a body instanced at two types, and one binding names one function",
        bd,
      )
    }
  }
  if (emitDirectCallArgsUnder(callIx, fnIx, target) < 0) { return -1 }
  emitDirectCallTail(target, callIx, fnIx)
  return emitBundleResultPick(callIx, target, fnIx)
}

// After a direct call to an instance returning its bundle parameter's record: the member the
// elaboration noted the call's value is used as, nothing for a value dropped. 0, or -1.
function emitBundleResultPick(callIx: i32, target: i32, fnIx: i32): i32 {
  const cFn = nodeAt(fnStmts[target])
  const rp = bundleRetParamOf(fnStmts[target])
  const own = rp >= 0 && cFn is FuncDecl && rp < cFn.fnParams.length
  // A function returning another's record as a call's value returns it as that record.
  const rec = if own { [] } else { calleeReturnsRecord(fnStmts[target]) }
  if !own && rec.length < 2 { return 0 }
  // A holder keeps the record whole and picks at each call through it (D15144).
  if elabCallKeepsRecordAt(nodeSrc[callIx] ?? callIx, elabKeyOfFn(fnIx)) {
    return 0
  }
  const m = callResultMember(callIx, fnIx)
  if m == -1 { return 0 }
  const si = if own && cFn is FuncDecl { paramStructIdxOf(cFn.fnParams[rp]) } else { bundleRecordRowOfSigs(rec) }
  const fi = if m >= 0 { sFieldIndex(si, "c" + i32ToStr(m)) } else { -1 }
  if fi < 0 || si < 0 || si >= sHeapIdx.length {
    return emitFailAt(
      "emitProgram: a function returning a parameter called at two signatures is called where its result is not used at one of them",
      callIx,
    )
  }
  fbStructGet(sHeapIdx[si], fi)
  return 0
}

// Does a direct call with `nArgs` operands pass more than callee `target` declares? False when
// the callee has a rest parameter, which takes any number.
function directArgsOverflow(nArgs: i32, target: i32): boolean {
  const cFn = nodeAt(fnStmts[target])
  if cFn is FuncDecl {
    let i = 0
    while i < cFn.fnParams.length {
      const p = nodeAt(cFn.fnParams[i])
      if p is Param {
        if p.parRest == 1 { return false }
      }
      i = i + 1
    }
    return nArgs > cFn.fnParams.length
  }
  return false
}

// `emitDirectCall`'s operands: each argument applies its parameter's context and leaves it
// for the caller's exit to undo.
function emitDirectCallArgsUnder(callIx: i32, fnIx: i32, target: i32) {
  // The callee's FuncDecl lives at `fnStmts[target]` (the function index is the fnStmts
  // position). Its parameter list lets a struct-literal argument construct as the callee's
  // declared param struct type rather than a field-name guess, fixing a struct argument
  // passed into a forward-referenced/mutually-recursive callee whose param struct shares field names with another struct.
  const cFn = nodeAt(fnStmts[target])
  // Arguments in parameter order (host parity: `orderArgumentsByParameters` plus operands
  // built per-parameter). A call with no named args keeps its source list untouched; a named
  // call (`f(b: 1, a: 2)`) reorders here so each emitted operand lands on, and is typed by,
  // its declared parameter — including evaluation order, which follows parameter order too.
  const args = orderedDirectArgs(callIx, target)
  if directArgsBad(args, callIx) {
    return emitFail("emitProgram: named argument does not match a parameter")
  }
  // A call with more operands than the callee takes would leave the extras under the result.
  if directArgsOverflow(args.length, target) {
    return emitFail(
      "emitProgram: a call passes more arguments than the function it calls takes",
    )
  }
  // A callee carrying the env param (`fnHasEnvParam`) takes a null one from a direct call,
  // pushed before the args to match its env-leading signature.
  if fnHasEnvParam(target) { fbRefNullStruct() }
  // A lambda-lifted callee takes its captures next, read in this frame (SP-037).
  if cloLifted(target) {
    const lcaps = captureNamesOf(target)
    let lci = 0
    while lci < lcaps.length {
      if emitCaptureRead(lcaps[lci], fnIx) < 0 { return -1 }
      lci = lci + 1
    }
  }
  // Every argument starts from the caller's context with the litunion, map and null-heap
  // seeds cleared: each is its parameter's, never the enclosing position's, or a bare `Map()` builds an outer shape
  // (D1223), or a `null` read takes a map value's heap. The parameter's seeds follow below.
  let i = 0
  while i < args.length {
    const sd = directArgSeedsOf(target, i)
    // An f64 / f32 param position lowers the argument coerced to that float type
    // (a float literal re-encodes; an i32/i64/f32 source converts via the lattice
    // helper). (Slice 3 f64; Slice 5 f32.)
    let cParamF64 = false
    let cParamF32 = false
    // An i64 param position widens a narrower (i32) argument at the call
    // boundary via `i64.extend_i32_s` — `emitWidened` (a literal lowers as
    // `i64.const`; an i32 VARIABLE sign-extends). The value-preserving edge
    // the checker permits, mirroring the let / return widenings.
    let cParamI64 = false
    if cFn is FuncDecl {
      const cParams2 = cFn.fnParams
      if i < cParams2.length {
        if vtKindOfParam(cParams2[i]) == "f64" { cParamF64 = true }
        if vtKindOfParam(cParams2[i]) == "f32" { cParamF32 = true }
        if vtKindOfParam(cParams2[i]) == "i64" { cParamI64 = true }
      }
    }
    // A lambda the callee calls at two signatures is delivered as its bundle (D14841).
    const bpar = if cFn is FuncDecl && i < cFn.fnParams.length { cFn.fnParams[i] } else { -1 }
    if bpar >= 0 && emitBundleParamTakes(bpar, args[i]) {
      if emitBundleArg(args[i], bpar, fnIx) < 0 { return -1 }
      i = i + 1
    } else if (
      (emitBundleRecordRead(args[i], fnIx) || emitHolderRead(args[i], fnIx))
      && (bpar < 0 || bundleSigsOfParam(bpar).length == 0)
    ) {
      // A callee with no instance is handed the member the elaboration chose for its annotation.
      if bundleHandMemberOf(args[i]) == -2 {
        const ehm = elabCallHandMemberAt(
          nodeSrc[callIx] ?? callIx,
          i,
          elabKeyOfFn(fnIx),
        )
        if ehm >= -1 { bundleHandMemberNote(args[i], ehm) }
      }
      if emitBundleMemberArg(args[i], fnIx) < 0 { return -1 }
      i = i + 1
    } else if (
      bpar >= 0
      && bundleSigsOfParam(bpar).length > 0
      && emitHolderRead(args[i], fnIx)
    ) {
      // A holder's record goes to a bundle parameter as it is (D15144).
      if emitExpr(args[i], fnIx) < 0 { return -1 }
      i = i + 1
    } else if bpar >= 0 && emitBundleParamReads(bpar, args[i], fnIx) {
      if emitBundleParamRead(args[i], bpar, fnIx) < 0 { return -1 }
      i = i + 1
    } else if (
      bpar >= 0
      && bundleSigsOfParam(bpar).length > 0
      && nodeAt(unwrapParen(args[i])) is IfStmt
    ) {
      const bp = nodeAt(bpar)
      const bt = if bp is Param && bp.parType >= 0 { nodeTyIxOf(bp.parType) } else { -1 }
      if (emitBundleChoiceArg(args[i], bt, bundleSigsOfParam(bpar), fnIx) < 0) {
        return -1
      }
      i = i + 1
    } else if cParamF32 {
      if emitWidened(args[i], 5, fnIx) < 0 { return -1 }
      i = i + 1
    } else if cParamF64 {
      if emitWidened(args[i], 4, fnIx) < 0 { return -1 }
      i = i + 1
    } else if cParamI64 {
      if emitWidened(args[i], 3, fnIx) < 0 { return -1 }
      i = i + 1
    } else {
      const daOwed = directArgArmOwed(args[i], fnIx, sd)
      const daHeap = directArgArmHeap(sd)
      const daSeat = armOpen(daOwed, daHeap, args[i], fnIx)
      if emitDirectArgValue(args[i], fnIx, sd) < 0 { return -1 }
      armClose(daSeat, daOwed, daHeap, args[i], fnIx)
      const ub = emitDirectArgUnbox(args[i], fnIx, sd)
      if ub != 0 { return ub }
      i = i + 1
    }
  }
  return 0
}

// `emitDirectCallArgsUnder`'s value for argument `arg` at a parameter that is not a scalar
// f64/f32/i64, emitted under the seeds `sd` its parameter gives: an atom widening, a box, or
// the expression under its niche and list seeds, then widened and recovered. Returns 0, or -1.
function emitDirectArgValue(arg: i32, fnIx: i32, sd: DirectArgSeeds): i32 {
  const cRecoverKind = sd.cRecoverKind
  const cUNm = sd.cUNm
  const cParamNulString = sd.cParamNulString
  const cParamStr = sd.cParamStr
  if (cParamStr || cParamNulString) && exprIsLitAtom(arg, fnIx) {
    // A literal-union atom flowing into a `string` param widens to its member string — and
    // into a `string | null` param for the same reason, the slot being that same reference
    // with a null permitted and a widened member string non-null. A `null` argument is not a
    // lit atom and lowers below at its delivery's type.
    if emitAtomToStr(arg, fnIx) < 0 { return -1 }
  } else if cUNm != "" && !boxOwedAt(arg, fnIx) {
    // `cUNm` is set only for a kind-4 union-BOX param (see above). The floor: an argument with
    // no usable record (one still naming an open type parameter) boxes at the parameter's union.
    if emitUnionBoxOwed(cUNm, sd.cUTy, arg, fnIx) < 0 { return -1 }
  } else if cUNm != "" {
    if emitDelivered(arg, fnIx) < 0 { return -1 }
  } else {
    const argBoxToNulStr = cParamNulString && boxIsNulStrUnion(arg, fnIx)
    if emitExpr(arg, fnIx) < 0 { return -1 }
    if argBoxToNulStr { emitBoxToNulStr() }
    emitNonNullParamRecover(cRecoverKind, arg, fnIx)
  }
  return 0
}

// `emitDirectCallArgsUnder`'s unbox of a narrowed argument `arg` into a bare variant parameter,
// once its value is on the stack; the other arms are `directArgArmHeap`'s. Returns 0, or a refusal.
function emitDirectArgUnbox(arg: i32, fnIx: i32, sd: DirectArgSeeds): i32 {
  const cVi = sd.cVi
  if cVi >= 0 {
    if exprUnion(arg, fnIx) {
      if variantHasCrossTagFits(cVi, arg, fnIx) {
        return emitFailCrossTagDelivery(arg, cVi)
      }
      fbStructGet(uBoxIdx, 1)     // 0xfb 0x02 <box ht> field 1: value (anyref)
      fbRefCast(variantHeap(cVi)) // 0xfb 0x16 <variant struct> ref.cast (non-null)
    }
  }
  return 0
}

// Whether a narrowed argument `arg` owes the arm unbox `directArgArmHeap` names: its parameter
// is no bare variant (`cVi`, whose unbox `emitDirectArgUnbox` owns), its slot names a heap (one
// that names none takes the value as `emitDirectArgValue` delivers it), and the value arrives boxed.
function directArgArmOwed(arg: i32, fnIx: i32, sd: DirectArgSeeds): boolean {
  return sd.cVi < 0
    && directArgArmHeap(sd) >= 0
    && narrowedArmNeedsUnbox(arg, fnIx)
}

// The heap a direct call's parameter declares for a narrowed argument's arm: the niche
// variant's (D1031), else the parameter's own (kind, slot) for an annotated plain struct
// (D1723); -1 for a bare variant parameter or none.
function directArgArmHeap(sd: DirectArgSeeds): i32 {
  if sd.cVi >= 0 { return -1 }
  if sd.cParamNulVariantIdx >= 0 {
    return armDestHeapOf("nulvariant", sd.cParamNulVariantIdx)
  }
  return armDestHeapOf(sd.cArgParamKind, sd.cArgParamRow)
}

// What argument `i` of a direct call to `target` takes from its parameter: the null rep a
// niche parameter seeds, the variant, union and list rows, and the rep a narrowed argument
// recovers to. A field keeps its default when the callee has no parameter `i`.
type DirectArgSeeds = {
  cVi: i32,
  cArgParamKind: VKind,
  cArgParamRow: i32,
  cRecoverKind: VKind | null,
  cUNm: string,
  cUTy: i32,
  cParamNulString: boolean,
  cParamNulVariantIdx: i32,
  cParamStr: boolean,
  cParamSLKind: VKind | null,
}

// The seeds of argument `i` of a direct call to `target`, read off its parameter.
function directArgSeedsOf(target: i32, i: i32): DirectArgSeeds {
  const cFn = nodeAt(fnStmts[target])
  // A variant-typed param position (kind 8): the callee wants the concrete variant struct
  // ref, but a union-valued argument (a narrowed local/param, a union-returning call) is the
  // box `{tag, value}`. Unbox to the param's variant struct — `struct.get $box 1 ; ref.cast
  // (ref $var)` — a statically safe cast since control reached this call only when narrowed to it.
  let cVi = -1
  // The parameter's own rep and table slot, carried to the narrowed-arm unbox below: the
  // inner block that reads `cParams` closes before it.
  let cArgParamKind: VKind = "i32"
  let cArgParamRow = -1
  // The parameter's rep, for the narrowed-argument recover `emitNonNullParamRecover` makes.
  let cRecoverKind: VKind | null = null
  // A UNION-typed param position (kind 4): the callee wants the box, so a raw
  // scalar/string/null argument is COERCED into the union representation
  // (`emitUnionCoerce` — the host's call-boundary `coerceUnion`). The param's
  // union NAME carries the atom set for the tag choice.
  let cUNm = ""
  let cUTy = -1
  // The `boolean | null` and `string | null` param positions, whose `null` is not a ref
  // null: each seeds the null rep its kind names and leaves a non-null argument untouched.
  let cParamNulString = false
  // A `Circle | null` param position's variant row, the narrowed-arm unbox's destination
  // (D1031); -1 for none.
  let cParamNulVariantIdx = -1
  // A `string` param position (kind 3): a literal-union atom ARGUMENT widens to its member
  // string at the boundary (the atom-as-string-subtype edge).
  let cParamStr = false
  // A scalar-list param position's own list kind (D965), so an
  // argument whose element STORAGE differs (`i32[]` into an `f64[]` param) can take the
  // converting copy at this boundary. `""` for every non-scalar-list param, which is
  // what makes the delivery below cost nothing in the ordinary case.
  let cParamSLKind: VKind | null = null
  if cFn is FuncDecl {
    const cParams = cFn.fnParams
    if i < cParams.length {
      const cpK = vtKindOfParam(cParams[i])
      const cpRow = paramStructIdxOf(cParams[i])
      cArgParamKind = cpK
      cArgParamRow = cpRow
      if cpK == "str" { cParamStr = true }
      cRecoverKind = cpK
      if cpK == "variant" { cVi = cpRow }
      if cpK == "union" {
        const cp4 = nodeAt(cParams[i])
        if cp4 is Param {
          cUNm = boxTyName(nodeTyIxOf(cp4.parType))
          cUTy = nodeTyAt(cParams[i], fnStmts[target])
        }
      }
      // A list param position (`take(xs: f64[])`): its list kind.
      if nodeAt(cParams[i]) is Param { cParamSLKind = cpK }
      cParamNulString = cpK == "nulstr"
      const cpNvi = annNulVariantRowOf(parTyNode(cParams[i]))
      if cpNvi >= 0 && cpNvi < uVarRow.length { cParamNulVariantIdx = cpNvi }
    }
  }
  const seeds: DirectArgSeeds = {
    cVi: cVi,
    cArgParamKind: cArgParamKind,
    cArgParamRow: cArgParamRow,
    cRecoverKind: cRecoverKind,
    cUNm: cUNm,
    cUTy: cUTy,
    cParamNulString: cParamNulString,
    cParamNulVariantIdx: cParamNulVariantIdx,
    cParamStr: cParamStr,
    cParamSLKind: cParamSLKind,
  }
  return seeds
}

// The `call` and what follows it, under the caller's restored context: the tail-call
// cursor, a lifted callee's capture write-back, and the `nulnone` result's niche re-rep.
function emitDirectCallTail(target: i32, callIx: i32, fnIx: i32) {
  fbCall(gImports + target) // 0x10 call (imports occupy indices 0..gImports-1)
  // Arm the tail-call cursor: if this call is still the last thing written when the
  // enclosing `return` terminates, it is in tail position and `emitUnionRetSink`
  // rewrites the pair into `return_call`.
  tailCallIdx = gImports + target
  tailCallTable = -1
  tailCallEnd = wLen()
  // A lifted callee hands back the captures it assigned after its result: each goes back
  // where this frame keeps it, the last result first (D3664).
  const nWb = cloLiftWriteCount(target)
  if nWb > 0 {
    const wbCaps = captureNamesOf(target)
    let wbi = nWb - 1
    while wbi >= 0 {
      const wbIdx = captureHomeOf(fnIx, wbCaps[cloLiftWriteCapAt(target, wbi)])
      if wbIdx < 0 {
        return emitFail(
          "emitProgram: a lifted call's assigned capture has no home here",
        )
      }
      fbLocalSet(wbIdx)
      wbi = wbi - 1
    }
    liftWbEnd = wLen()
  }
  // D1567 — a `nulnone` result is the bottom ref, which every nullable ref destination takes
  // unchanged; at a sentinel destination (`boolean | null`, `K | null`) the call's value is that
  // destination's null, the one a bare `null` delivered there is.
  if fnPosRetIsNulNone(target) {
    const own = nullOwnAt(callIx, fnIx)
    if own == NULL_OWN_BOOL || own == NULL_OWN_ATOM {
      fbDrop()
      emitNullOwn(own)
      tailCallIdx = -1
    }
  }

  return 0
}

// The parameters of the function at `fnStmts` slot `target`, or none.
function capturedCallParams(target: i32): i32[] {
  const cfn = nodeAt(fnStmts[target])
  return if cfn is FuncDecl { cfn.fnParams } else { [] }
}

// How `emitCapturedCall` writes argument `arg`, the `i`th of a call of `target` from frame `fnIx`:
// a union parameter's box by the table or the floor, a widening, a literal union, an atom's
// string, a narrowed arm's unbox, or the plain expression.
export type CapturedArgArm = "boxTable"
  | "boxFloor"
  | "widenI64"
  | "widenF64"
  | "widenF32"
  | "lit"
  | "atomStr"
  | "unbox"
  | "plain"

export function capturedArgArmOf(
  arg: i32,
  i: i32,
  target: i32,
  fnIx: i32,
): CapturedArgArm {
  const cps = capturedCallParams(target)
  let cuNm = ""
  let cpKind: VKind = "i32"
  let cpLit = false
  if i < cps.length {
    cpKind = vtKindOfParam(cps[i])
    const cpn = nodeAt(cps[i])
    if cpn is Param {
      if cpKind == "union" { cuNm = boxTyName(nodeTyIxOf(cpn.parType)) }
      // Alias-INDEX, so a NARROWED copy is recognized.
      if tyIsLitUnion(nodeTyAt(cps[i], fnStmts[target])) { cpLit = true }
      if nodeTyIsNulLitUnion(parTyNode(cps[i])) { cpLit = true }
    }
  }
  if cuNm != "" {
    return if boxOwedAt(arg, fnIx) { "boxTable" } else { "boxFloor" }
  }
  if cpKind == "i64" { return "widenI64" }
  if cpKind == "f64" { return "widenF64" }
  if cpKind == "f32" { return "widenF32" }
  if cpLit { return "lit" }
  if cpKind == "str" && exprIsLitAtom(arg, fnIx) { return "atomStr" }
  if i < cps.length && narrowedArmNeedsUnbox(arg, fnIx) { return "unbox" }
  return "plain"
}

// The captured-call lowering for an `Ident` callee resolved to a CAPTURING lifted
// function at index `target`: build its closure value live (reading captures) and
// `call_ref` it (a plain `call` would pass a null env and lose the captures).
function emitCapturedCall(callIx: i32, fnIx: i32, target: i32) {
  if cloLifted(target) { return emitDirectCall(callIx, fnIx, target) }
  // Stash the freshly-built closure, then call_ref it (same shape as emitCallRef
  // but the callee is a value we synthesize here, not an existing binding). `Core`, not
  // `emitClosureValue`: the generic-value floor guards a closure that escapes its pin, and
  // this one is consumed by the call that pinned it, so an un-annotated parameter is fine.
  if emitClosureValueCore(target, fnIx) < 0 { return -1 }
  const crDepth = callRefDepth
  const crSlot = callRefNestSlot(callRefDepth)
  fbLocalSet(crSlot)
  fbLocalGet(crSlot)
  fbStructGet(cloStructIdx, 0) // env
  callRefDepth = crDepth + 1
  // Parameter-order args (named-call reorder; see the direct path below).
  const cargs = orderedDirectArgs(callIx, target)
  if directArgsBad(cargs, callIx) {
    return emitFail("emitProgram: named argument does not match a parameter")
  }
  // Per-parameter argument coercion for the fourth `call_ref` reach (a nested capturing
  // function called by name): the spine pushed every argument raw against the callee's own
  // declared functype. Three kinds are check-clean invalid wasm without this — a union box, an
  // i64/f64/f32 mismatch, and a litunion — each coerced the way the direct twin coerces, safe by construction since each arm fires only where the raw push is already wrong.
  if target < 0 { return -1 }
  const cps = capturedCallParams(target)
  let cai = 0
  while cai < cargs.length {
    match capturedArgArmOf(cargs[cai], cai, target, fnIx) {
      "boxTable" => {
        // The table boxes an argument whose union the checker records; the floor, below, boxes
        // one with no usable record at the parameter's union.
        if emitDelivered(cargs[cai], fnIx) < 0 { return -1 }
      }
      "boxFloor" => {
        const cpn = nodeAt(cps[cai])
        const cuNm = if cpn is Param { boxTyName(nodeTyIxOf(cpn.parType)) } else { "" }
        const cuTy = nodeTyAt(cps[cai], fnStmts[target])
        if emitUnionBoxOwed(cuNm, cuTy, cargs[cai], fnIx) < 0 { return -1 }
      }
      "widenI64" => {
        if emitWidened(cargs[cai], 3, fnIx) < 0 { return -1 }
      }
      "widenF64" => {
        if emitWidened(cargs[cai], 4, fnIx) < 0 { return -1 }
      }
      "widenF32" => {
        if emitWidened(cargs[cai], 5, fnIx) < 0 { return -1 }
      }
      "lit" | "plain" => {
        if emitExpr(cargs[cai], fnIx) < 0 { return -1 }
      }
      "atomStr" => {
        // The MIRROR of `lit`: a literal-union ATOM argument into a `string` parameter
        // widens to its member string, the edge the direct twin takes as `cParamStr`.
        if emitAtomToStr(cargs[cai], fnIx) < 0 { return -1 }
      }
      "unbox" => {
        // A value narrowed out of a box into an arm or nullable-arm parameter is unboxed, as
        // the direct call's argument rung unboxes it.
        if emitExpr(cargs[cai], fnIx) < 0 { return -1 }
        emitNarrowedArmUnboxTo(
          armDestHeapOf(vtKindOfParam(cps[cai]), paramStructIdxOf(cps[cai])),
          cargs[cai],
          fnIx,
        )
      }
    }
    cai = cai + 1
  }
  callRefDepth = crDepth
  // The target's own interned `$fnsig` — the functype it is actually declared with — so the
  // `call_indirect` below passes the engine's signature check and returns the target's real
  // result type. Must be resolved from the target, never from arity alone: `fnSigIdxForArity`
  // only keys `(structref, i32 * ar) -> i32`, which misclassifies any non-i32 param or result. `fnSigIdxOfFn` is the same seam `.map`/`.filter` resolve a named-function callback through.
  const csig = fnSigIdxOfFn(target)
  if csig < 0 {
    return emitFail(
      "emitProgram: captured call target has no interned signature",
    )
  }
  fbLocalGet(crSlot)
  fbStructGet(cloStructIdx, 1)      // the callee's wasm function index
  fbCallIndirect(csig, gFnTableIdx) // 0x11 <fnsig> <table>
  armTailCallIndirect(csig, sigKeyRetVoid(cloSigKeyExt(target)))
  return 0
}

// Arm the tail-call cursor on the function-value call just written, so a `return` that
// follows it directly becomes `return_call_indirect` (D4657); `isVoid` says the signature has
// no result, which a void caller's exit also needs (D4680).
function armTailCallIndirect(sig: i32, isVoid: boolean) {
  tailCallIdx = sig
  tailCallTable = gFnTableIdx
  tailCallVoid = isVoid
  tailCallEnd = wLen()
  return 0
}

// Whether the `$fnsig` key `key` has the void result suffix `>v`.
function sigKeyRetVoid(key: string): boolean {
  const n = key.length
  return n >= 2 && key[n - 2] == '>' && key[n - 1] == 'v'
}

// The `__array_new__(n, fill)` / `__array_new_default__(n)` intrinsic lowering.
function emitArrayNewIntr(callIx: i32, fnIx: i32) {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Ident {
      const anIsNew = callee.identName == "__array_new__"
      let anWant = 1
      if anIsNew { anWant = 2 }
      if c.callArgs.length != anWant {
        return emitFail(
          "emitProgram: internal: "
            + callee.identName
            + " reached with the wrong argument count — the checker's arity rule refuses it",
        )
      }
      const fill = if anIsNew { c.callArgs[1] } else { -1 }
      const pl = arrNewPlanOf(callIx, fill, fnIx)
      if pl.anWhy != "" { return emitFail(pl.anWhy) }
      if emitExpr(c.callArgs[0], fnIx) < 0 { return -1 }
      const anLenL = arrNewLenStash()
      if !anIsNew { return arrNewDefaultTail(pl, anLenL) }
      if emitArrNewFillAt(callIx, fill, fnIx) < 0 { return -1 }
      return arrNewTail(pl, anLenL)
    }
  }
  return emitFail(
    "emitProgram: emitArrayNewIntr expected an __array_new__ call",
  )
}

// The list an `__array_new__` site (fill `fill`) or `__array_new_default__` site (`fill` -1) at
// `callIx` builds: its backing and wrapper heap types, or the refusal `anWhy` legacy records.
export type ArrNewPlan = { anBack: i32, anWrap: i32, anWhy: string }

function arrNewRefused(why: string): ArrNewPlan {
  return { anBack: -1, anWrap: -1, anWhy: why }
}

export function arrNewPlanOf(callIx: i32, fill: i32, fnIx: i32): ArrNewPlan {
  let anBack = -1
  let anWrap = -1
  const ank = arrNewIntrKind(callIx, fnIx)
  match ank {
    "f64list" => {
      anBack = fa64Ty()
      anWrap = fl64Ty()
    }
    "i64list" => {
      // D963 — I64 fill → the i64 list pair.
      anBack = ia64Ty()
      anWrap = il64Ty()
    }
    "u8list" => {
      // D1470 — the PACKED byte list. Reachable only from `__array_new_default__`
      // (`arrNewDefaultKind`): `array.new_default` zeroes an `i8` slot exactly as it
      // zeroes an `i32` one, so the destination's own pair is all this needs.
      anBack = pkBackAt(exprPackedRow(callIx, fnIx))
      anWrap = pkWrapAt(exprPackedRow(callIx, fnIx))
    }
    "f32list" => {
      // D1470 — the f32 list, from `__array_new_default__`'s destination or, since D1673,
      // from an f32 FILL. A float literal fill is not one: it types f64, and the checker
      // refuses it against an `f32[]` destination before the emitter sees it.
      anBack = fa32Ty()
      anWrap = fl32Ty()
    }
    "v128list" => {
      anBack = fa128Ty()
      anWrap = fl128Ty()
    }
    "strlist" => {
      // STRING fill → the string list (`array.new` of the shared string-ref
      // backing; a non-null string ref stores into the nullable slot directly).
      anBack = mkArrTy()
      anWrap = mkListTy()
    }
    "reflist" => {
      // STRUCT fill → the ref list of the element struct (its interned slot).
      if !rlRowsMinted() {
        return arrNewRefused(
          "emitProgram: __array_new__ struct fill but ref list types not collected",
        )
      }
      // The STRICT slot: this arm picks the list's backing and wrapper heap types, so an
      // unresolved element must refuse, not clamp. Slot 0 is a real row, and clamping to
      // it built the module at whichever element interned first (D1605).
      const anSlot = refListSlotOfExprStrict(callIx, fnIx)
      const anBad = anSlot >= rlWrapIdx.length || anSlot >= rlBackIdx.length
      if anSlot < 0 || anBad {
        return arrNewRefused(
          "emitProgram: __array_new__ fill type not yet supported natively",
        )
      }
      anBack = rlBackIdx[anSlot]
      anWrap = rlWrapIdx[anSlot]
    }
    "list" | "none" => {
      anWrap = lTy()
      anBack = aTy()
      if fill >= 0 {
        const why = arrNewI32FillWhy(callIx, fill, nodeAt(fill) is ObjLit, fnIx)
        if why != "" { return arrNewRefused(why) }
      }
    }
  }
  return { anBack: anBack, anWrap: anWrap, anWhy: "" }
}

// After an array-intrinsic site's length: the length stashed in the site's scratch slot, which a
// site inside another site's fill takes one of its own depth for (D2333). Returns the slot.
export function arrNewLenStash(): i32 {
  let slot = arrNewScratchBase
  if arrNewFillDepth > 0 { slot = widenTmpSlot(0 - 1000 - arrNewFillDepth) }
  fbLocalSet(slot)
  return slot
}

// After an `__array_new__` site's fill: the backing filled at the stashed length, then the
// `{backing, len, cap}` wrapper. Returns 0.
export function arrNewTail(pl: ArrNewPlan, slot: i32): i32 {
  fbLocalGet(slot)
  fbArrayNew(pl.anBack)
  return arrNewWrap(pl, slot)
}

// After an `__array_new_default__` site's stash: the zeroed backing, then the wrapper. Returns 0.
export function arrNewDefaultTail(pl: ArrNewPlan, slot: i32): i32 {
  fbLocalGet(slot)
  fbArrayNewDefault(pl.anBack)
  return arrNewWrap(pl, slot)
}

function arrNewWrap(pl: ArrNewPlan, slot: i32): i32 {
  fbLocalGet(slot)
  fbLocalGet(slot)
  fbStructNew(pl.anWrap)
  return 0
}

// How many `__array_new__` fills enclose the site being lowered (D2333).
let arrNewFillDepth = 0

// The i32 list's fill guard for call `callIx` with fill `fill` (`fillIsObj` when it is an object
// literal): the refusal when nothing named the element rep or the fill is a ref value, else "".
function arrNewI32FillWhy(
  callIx: i32,
  fill: i32,
  fillIsObj: boolean,
  fnIx: i32,
): string {
  // The i32 list is also `arrNewIntrKind`'s fall-through: where nothing named the kind, the
  // list is a guess, and a guess about the fill's rep is invalid wasm (D1630).
  if !arrNewKindNamed(callIx, fnIx) {
    return "emitProgram: __array_new__ fill names no element rep, and its destination names none either"
  }
  let anFillRef = false
  if fillIsObj { anFillRef = true }
  if exprIsClosure(fill, fnIx) { anFillRef = true }
  if exprArray(fill, fnIx) { anFillRef = true }
  if exprRefArray(fill, fnIx) { anFillRef = true }
  if exprStringArray(fill, fnIx) { anFillRef = true }
  if exprMap(fill, fnIx) { anFillRef = true }
  if anFillRef {
    return "emitProgram: __array_new__ fill type not yet supported natively"
  }
  return ""
}

// Enters (`d` 1) or leaves (`d` -1) an `__array_new__` site's fill: a site inside another site's
// fill takes a length slot of its own.
export function arrNewFillStep(d: i32) { arrNewFillDepth = arrNewFillDepth + d }

// The fill `fill` of an `__array_new__` site, at one fill depth deeper.
function emitArrNewFill(fill: i32, fnIx: i32): i32 {
  arrNewFillStep(1)
  const anFillRc = emitExpr(fill, fnIx)
  arrNewFillStep(-1)
  if anFillRc < 0 { return -1 }
  return 0
}

// The union element of its destination that `__array_new__` call `callIx` boxes its fill `fill`
// into (D16887), or -1 where the fill goes in as it stands.
export function arrNewFillBoxTy(callIx: i32, fill: i32, fnIx: i32): i32 {
  const lt = nodeTyAt(callIx, fnIx)
  const lty = if lt >= 0 && lt < T.tys.length { tyAt(lt) } else { null }
  const et = if lty is TyArray { tyElemOf(lty) } else { -1 }
  const nm = if et >= 0 { boxTyName(et) } else { "" }
  if nm == "" || exprUnion(fill, fnIx) || repOfTy(et).rdKind != "union" {
    return -1
  }
  return et
}

// `emitArrNewFill` for the `__array_new__` call `callIx`, boxing the fill where
// `arrNewFillBoxTy` names an element.
function emitArrNewFillAt(callIx: i32, fill: i32, fnIx: i32): i32 {
  const et = arrNewFillBoxTy(callIx, fill, fnIx)
  if et < 0 { return emitArrNewFill(fill, fnIx) }
  arrNewFillStep(1)
  const rc = emitUnionBoxArg(boxTyName(et), et, fill, fnIx)
  arrNewFillStep(-1)
  return if rc < 0 { -1 } else { 0 }
}

// The `__array_copy__(dst, dstAt, src, srcAt, count)` intrinsic lowering.
function emitArrayCopyIntr(callIx: i32, fnIx: i32) {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length != 5 {
      return emitFail(
        "emitProgram: internal: __array_copy__ reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    const pl = arrCopyPlanOf(callIx, fnIx)
    if pl.acWhy != "" { return emitFail(pl.acWhy) }
    if emitExpr(c.callArgs[0], fnIx) < 0 { return -1 }
    arrCopyBacking(pl)
    if emitExpr(c.callArgs[1], fnIx) < 0 { return -1 }
    if emitExpr(c.callArgs[2], fnIx) < 0 { return -1 }
    arrCopyBacking(pl)
    if emitExpr(c.callArgs[3], fnIx) < 0 { return -1 }
    if emitExpr(c.callArgs[4], fnIx) < 0 { return -1 }
    arrCopyTail(pl)
    return 0
  }
  return emitFail(
    "emitProgram: emitArrayCopyIntr expected an __array_copy__ call",
  )
}

// Whether call `c` is the `__array_copy__` intrinsic: the spelling, with no binding owning the
// name. Legacy's `emitCallCore` and the IR's builder route on it.
export function arrCopyCallNamed(c: Call, fnIx: i32): boolean {
  if c.callFn < 0 { return false }
  const f = nodeAt(c.callFn)
  if !(f is Ident) || f.identName != "__array_copy__" { return false }
  return !identNameIsUserBound(c.callFn, fnIx)
}

// The wrapper and backing heap types `__array_copy__` call `callIx` copies between, or the
// refusal `acWhy` legacy records: both lists share one kind and row (D3549).
export type ArrCopyPlan = { acWrap: i32, acBack: i32, acWhy: string }

function arrCopyRefused(why: string): ArrCopyPlan {
  return { acWrap: -1, acBack: -1, acWhy: why }
}

export function arrCopyPlanOf(callIx: i32, fnIx: i32): ArrCopyPlan {
  const c = nodeAt(callIx)
  if !(c is Call) || c.callArgs.length != 5 {
    return arrCopyRefused(
      "emitProgram: emitArrayCopyIntr expected an __array_copy__ call",
    )
  }
  const acKind = mfRecvKindOf(c.callArgs[0], fnIx)
  const acSrcKind = mfRecvKindOf(c.callArgs[2], fnIx)
  if acKind == null || acSrcKind == null {
    return arrCopyRefused(
      "emitProgram: __array_copy__ expects list (T[]) operands",
    )
  }
  let acRow = 0
  let acSrcRow = 0
  if acKind == "reflist" {
    acRow = refListSlotOfExpr(c.callArgs[0], fnIx)
    acSrcRow = refListSlotOfExpr(c.callArgs[2], fnIx)
  } else if acKind == "u8list" {
    acRow = exprPackedRow(c.callArgs[0], fnIx)
    acSrcRow = exprPackedRow(c.callArgs[2], fnIx)
  }
  if acKind != acSrcKind || acRow != acSrcRow {
    return arrCopyRefused(
      "emitProgram: __array_copy__ dst and src must share one element type",
    )
  }
  const acWrap = spreadWrapIdx(acKind, acRow)
  const acBack = spreadBackIdx(acKind, acRow)
  if acWrap < 0 || acBack < 0 {
    return arrCopyRefused("emitProgram: __array_copy__ list type not collected")
  }
  return { acWrap: acWrap, acBack: acBack, acWhy: "" }
}

// After a list operand of `__array_copy__`: its backing, read off the wrapper.
export function arrCopyBacking(pl: ArrCopyPlan) { fbStructGet(pl.acWrap, 0) }

// After the five operands: the copy between the two backings.
export function arrCopyTail(pl: ArrCopyPlan) {
  fbArrayCopy(pl.acBack, pl.acBack)
}

// The fused map/list/struct nullish-coalescing lowering (`emitBinExprNode`'s `??` arm).
// Whether the `string | null` `??` node at `exprIx` lowers with a nullable result — i.e.
// whether its value `if` declares `(ref null $aTypeIdx)` rather than `(ref $aTypeIdx)`.

// The value-atom code a nullable-scalar-list `VKind` carries once it is non-null — the atom
// twin of `nulScalarListWrapHeap`'s wrapper table, one code per backing.
function nulScalarListAtomKind(kind: VKind): i32 {
  match kind {
    "nulstrlist" => {
      return 9
    }
    "nulf64list" => {
      return 8
    }
    "nuli64list" => {
      return 10
    }
    "nulf32list" => {
      return 12
    }
    "nulu8list" => {
      return 13
    }
    // Not a nullable scalar-backed list with a union atom, so no atom code.
    "nulv128list" | "i32" | "struct" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "i64" | "f64" | "f64list" | "f32" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "v128list" | "nulmap" | "nulnone" | "u8list" | "v128" => {}
  }
  return -1
}

// The value-atom code the nullable-ref niche at `lhsIx` carries once it is non-null, or -1 for
// a niche whose atom is not a scalar-backed one (a struct, a variant, a ref-element array).
// Read off the NICHE, since the value is still nullable and classifies as no atom at all.
function coalNicheAtomKind(lhsIx: i32, fnIx: i32): i32 {
  if exprNullableString(lhsIx, fnIx) { return 2 }
  if exprNullableList(lhsIx, fnIx) {
    // A boolean list tags apart from the `i32` list it shares storage with.
    if boolLeafListDepthOfTy(tyPeelNul(nodeTyIxOf(unwrapParen(lhsIx)))) == 0 {
      return 17
    }
    return 7
  }
  const nsk = exprNulScalarListKind(lhsIx, fnIx)
  if nsk == "nulu8list" {
    // One kind of list holds every packed width; the operand's row picks the arm.
    return pkKindOfRow(tyPackedRow(nodeTyIxOf(unwrapParen(lhsIx))))
  }
  if nsk != null { return nulScalarListAtomKind(nsk) }
  return -1
}

// The element spelling of ref value-atom kind `k`, over exactly the kinds a nullable-ref niche
// can carry, or "" for any other kind. The kind is an array atom unless it is 2 (`string`).
function refAtomElemName(k: i32): string {
  if k == 2 { return "string" }
  if k == 7 { return "i32" }
  if k == 17 { return "boolean" }
  if k == 8 { return "f64" }
  if k == 9 { return "string" }
  if k == 10 { return "i64" }
  if k == 12 { return "f32" }
  if k == V128_LIST_KIND { return "v128" }
  const pr = pkRowOfKind(k)
  if pr >= 0 { return pkElemNameOfRow(pr) }
  return ""
}

// The result union's box tag for the OPERAND's own non-null rep, or -1 when no arm of that
// union carries it. A miss is a loud refusal at the caller and never a fall-through: a box
// tagged with an atom the union does not have is valid wasm whose `is` test is silently false.
function coalNicheBoxTag(joinTy: i32, lhsIx: i32, heapIx: i32, fnIx: i32): i32 {
  if exprNullableRefArray(lhsIx, fnIx) {
    const rs = refListSlotOfExpr(lhsIx, fnIx)
    if rs < 0 { return -1 }
    if !unionHasRefArrayArmSlot(joinTy, rs) { return -1 }
    return refArrSlotTag(rs)
  }
  const ak = coalNicheAtomKind(lhsIx, fnIx)
  if ak >= 0 {
    if refAtomElemName(ak) == "" || !unionTyHasBoxKind(joinTy, ak) { return -1 }
    return scalarTagOfKind(ak)
  }
  const vi = unionArmVariantWithHeap(joinTy, heapIx)
  if vi >= 0 && vi < uTags.length { return uTags[vi] }
  return -1
}

// The heap type a nullable-ref niche carries, or -1: a nullable union arm's variant heap, else a
// nullable record's struct heap. The box stash and the `br_on_non_null` block both read it, so they
// cannot disagree about the value's rep. -1 for every other niche, whose tag `coalNicheBoxTag`
// resolves from its atom code instead of from a heap.
function nulNicheValueHeap(exprIx: i32, fnIx: i32): i32 {
  const nvi = nulVariantIdxOfExpr(exprIx, fnIx)
  if nvi >= 0 && nvi < uVarRow.length { return variantHeap(nvi) }
  if exprNullableStruct(exprIx, fnIx) {
    const nsi = structIndexOfExpr(exprIx, fnIx)
    if nsi >= 0 && nsi < sHeapIdx.length { return sHeapIdx[nsi] }
  }
  return -1
}

// Box a `V | null` niche into union `unionName` (its member set; `unionKey` the name the caller
// resolved it from, asked about `null` by key): 1 when it lowered, 0 when the value is not that
// shape or the union has no arm for it, -1 on a refusal. One evaluation is parked in the niche
// stash, and the null test picks the tag; the payload rides the box's `anyref` slot (D1721).
function emitUnionBoxNulNiche(
  unionName: string,
  unionKey: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
): i32 {
  if unionName == "" { return 0 }
  const nnIx = unwrapParen(exprIx)
  // The value's shape is asked before the union's `null`, so only a niche reads the set.
  const nnBool = exprNulBool(nnIx, fnIx)
  if !nnBool && !coalesceNulRefNicheOperand(nnIx, fnIx) { return 0 }
  if !unionSetHasNullTy(unionKey, unionTy) { return 0 }
  // A `boolean | null` is the i32 niche whose null is the value 2, so the null test is on the
  // value, not the ref (D2260).
  if nnBool {
    const bvb = vbHeapIdxOfKind(1)
    if bvb < 0 { return 0 }
    const bSlot = widenTmpSlot(4000)
    if emitExpr(exprIx, fnIx) < 0 { return -1 }
    fbLocalTee(bSlot)
    fbI32Const(2)
    fbI32Bin(70)     // 0x46 i32.eq → null?
    fbIfRef(uBoxIdx) // 0x04 if, (ref $uBox) blocktype
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone()
    fbStructNew(uBoxIdx)
    fbElse()
    fbI32Rel(RS_TAG, scalarTagOfKind(1))
    fbLocalGet(bSlot)
    fbStructNew(bvb)
    fbStructNew(uBoxIdx)
    fbEnd()
    return 1
  }
  const nnTag = coalNicheBoxTag(
    unionTy,
    nnIx,
    nulNicheValueHeap(nnIx, fnIx),
    fnIx,
  )
  if nnTag < 0 { return 0 }
  const nnSlot = nulNicheBoxSlot()
  // Read raw: a nullable-string ident is otherwise recovered non-null, which traps on the very
  // null this rung exists to box (D2260).
  if emitExpr(exprIx, fnIx) < 0 { return -1 }
  fbLocalTee(nnSlot)
  fbRefIsNull()
  fbIfRef(uBoxIdx) // 0x04 if, (ref $uBox) blocktype — the box is the result either way
  fbI32Rel(RS_TAG, nullBoxTag())
  fbRefNullNone()  // the payload slot is unread under the null tag
  fbStructNew(uBoxIdx)
  fbElse()         // 0x05 else — present → the niche's own ref, under its arm's tag
  fbI32Rel(RS_TAG, nnTag)
  fbLocalGet(nnSlot)
  fbStructNew(uBoxIdx)
  fbEnd()          // 0x0b end
  return 1
}

// Will the DEFAULT reach the box rep? A struct-typed value that is neither an object literal
// nor a resolvable arm of `joinSet` passes RAW through the box coercion, and a bare
// `(ref $struct)` under a box blocktype is invalid wasm. Only that shape can, so only it is
// asked; every other default either boxes or takes its own loud reject (D1720).
function coalJoinDefaultBoxes(joinTy: i32, defIx: i32, fnIx: i32): boolean {
  const d = nodeAt(unwrapParen(defIx))
  if d is ObjLit { return true }
  // A default that is itself a box (a nested join) is already the box rep.
  if exprUnion(defIx, fnIx) { return true }
  if !exprStruct(defIx, fnIx) { return true }
  if unionArmVariantForStructExpr(joinTy, defIx, fnIx) >= 0 { return true }
  return exprVariantIndex(defIx, fnIx) >= 0
}

// The boxed twin of the core below, for a default that JOINS rather than fits: the checker
// typed this `??` as a union, so the result is the value box and the operand's raw ref cannot
// leave a `br_on_non_null` block as itself. Stage it once in the `?.` receiver slot — the
// branch that boxes it has to read it back, which `br_on_non_null` cannot do (D1714).
function emitCoalesceNulRefJoin(
  e: BinExpr,
  exprIx: i32,
  heapIx: i32,
  fnIx: i32,
) {
  const why = coalNulRefJoinWhy(e, heapIx, fnIx)
  if why != "" { return emitFailAt(why, exprIx) }
  if emitExpr(e.binLeft, fnIx) < 0 {
    return -1 // the nullable ref, evaluated ONCE
  }
  coalNulRefJoinOpen()
  // Through `emitUnionBoxArg`, not `emitUnionCoerce`: a struct default that is already a
  // kind-8 VARIANT local is a raw `(ref $variant)`, which the coerce hands back unboxed, and
  // the box blocktype then holds a bare struct. The box-typed destinations share this entry.
  if (emitUnionBoxAtRecord("", -1, e.binRight, fnIx) < 0) { return -1 }
  coalNulRefJoinPresent(coalNulRefJoinTag(e, heapIx, fnIx))
  fbEnd() // 0x0b end
  return 0
}

// Why the joining `l ?? d` over a nullable reference of heap `heapIx` is refused, or "": its union
// has no row, no arm for the value's own type, or no arm for the default, or the function reserves
// no stash for the operand.
export function coalNulRefJoinWhy(e: BinExpr, heapIx: i32, fnIx: i32): string {
  // The union the join's result boxes into is the one its default is delivered into
  // (`boxDstNameAt`).
  if boxDstNameAt(e.binRight, fnIx) == "" {
    return "emitProgram: `??` joins a nullable value into a union the checker recorded no row for"
  }
  if coalNulRefJoinTag(e, heapIx, fnIx) < 0 {
    return "emitProgram: `??` joins a nullable value into a union with no arm for the value's own type"
  }
  if !coalJoinDefaultBoxes(boxDstTyOf(e.binRight, fnIx), e.binRight, fnIx) {
    return "emitProgram: `??` default names no arm of the union its result is"
  }
  if !fnUses.optRecv { return "emitProgram: `??` operand stash not reserved" }
  return ""
}

// The tag the present arm of a joining `l ?? d` boxes the operand of heap `heapIx` under.
export function coalNulRefJoinTag(e: BinExpr, heapIx: i32, fnIx: i32): i32 {
  return coalNicheBoxTag(
    boxDstTyOf(e.binRight, fnIx),
    unwrapParen(e.binLeft),
    heapIx,
    fnIx,
  )
}

// The head of a joining `l ?? d` once the operand is on the stack: staged in the `?.` receiver
// slot, which the box arm reads back (D1714), its null test, and the `if` at the box.
export function coalNulRefJoinOpen() {
  fbLocalTee(optRecvSlot)
  fbRefIsNull()
  fbIfRef(uBoxIdx) // 0x04 if, (ref $uBox) blocktype — the result's rep
}

// The present arm of a joining `l ?? d`: the staged reference boxed under tag `tag`.
export function coalNulRefJoinPresent(tag: i32) {
  fbElse() // 0x05 else — present → the staged ref, boxed under its own arm's tag
  fbI32Rel(RS_TAG, tag)
  fbLocalGet(optRecvSlot)
  fbStructNew(uBoxIdx) // { tag, the niche's own ref }
}

// The boxed `??` over the `boolean | null` i32 niche, for a default that joins rather than
// fits: the operand is evaluated once into a scratch slot, its null (the value 2) takes the
// boxed default, and a present 0/1 is boxed under the union's boolean arm (D2383).
function emitCoalesceNulBoolJoin(e: BinExpr, exprIx: i32, fnIx: i32) {
  // The union the join's result boxes into is the one its default is delivered into
  // (`boxDstNameAt`).
  const joinN = boxDstNameAt(e.binRight, fnIx)
  if joinN == "" {
    return emitFailAt(
      "emitProgram: `??` joins a nullable value into a union the checker recorded no row for",
      exprIx,
    )
  }
  const joinTy = boxDstTyOf(e.binRight, fnIx)
  const bvb = vbHeapIdxOfKind(1)
  if bvb < 0 || !unionTyHasBoxKind(joinTy, 1) {
    return emitFailAt(
      "emitProgram: `??` joins a nullable value into a union with no arm for the value's own type",
      exprIx,
    )
  }
  if !coalJoinDefaultBoxes(joinTy, e.binRight, fnIx) {
    return emitFailAt(
      "emitProgram: `??` default names no arm of the union its result is",
      exprIx,
    )
  }
  const bSlot = widenTmpSlot(4000)
  if emitExpr(e.binLeft, fnIx) < 0 { return -1 }
  fbLocalTee(bSlot)
  fbI32Const(2)
  fbI32Bin(70)     // 0x46 i32.eq → null?
  fbIfRef(uBoxIdx) // 0x04 if, (ref $uBox) blocktype — the result's rep
  if (emitUnionBoxAtRecord("", -1, e.binRight, fnIx) < 0) { return -1 }
  fbElse()         // 0x05 else — present → the 0/1 under the boolean arm's tag
  fbI32Rel(RS_TAG, scalarTagOfKind(1))
  fbLocalGet(bSlot)
  fbStructNew(bvb)
  fbStructNew(uBoxIdx)
  fbEnd()          // 0x0b end
  return 0
}

// `k ?? d` at a `string` result over the `K | null` atom niche: `-1` takes the default as a
// string, any other id widens through the member tower `emitAtomToStr` uses.
function emitCoalesceNulAtomStr(e: BinExpr, fnIx: i32) {
  if nulLitAtomTexts(e.binLeft, fnIx).length == 0 {
    return emitFail(
      "emitProgram: `??` over a nullable literal union has no member strings",
    )
  }
  coalAtomStrReserve()
  if emitExpr(e.binLeft, fnIx) < 0 { return -1 }
  coalAtomStrOpen(e)
  if exprIsLitAtom(e.binRight, fnIx) {
    if emitAtomToStr(e.binRight, fnIx) < 0 { return -1 }
  } else {
    if emitExpr(e.binRight, fnIx) < 0 { return -1 }
  }
  return coalAtomStrClose(e, fnIx)
}

// Takes the slot `coalAtomStrOpen` keeps the id in, before `l` is written, as its first use
// numbers it.
export function coalAtomStrReserve(): i32 { return widenTmpSlot(4001) }

// `l ?? d` over a `K | null`, after `l`'s id: keep it, and open the `null` branch the default
// fills, typed by whether the default may be null.
export function coalAtomStrOpen(e: BinExpr): i32 {
  fbLocalTee(widenTmpSlot(4001))
  fbI32Const(-1)
  fbI32Bin(70) // 0x46 i32.eq → null?
  fbIfRefNul(sTy(), defExprNullable(e.binRight))
  return 0
}

// After the default: the present branch, the kept id's member string at `l`'s members.
export function coalAtomStrClose(e: BinExpr, fnIx: i32): i32 {
  fbElse()
  fbLocalGet(widenTmpSlot(4001))
  setStrScrI(0)
  if (
    emitAtomToStrChain(nulLitAtomTexts(e.binLeft, fnIx), 0, strScratchBase + 3)
    < 0
  ) {
    return -1
  }
  fbEnd()
  return 0
}

// The `br_on_non_null` core every nullable-ref-niche `??` shares, with both contexts and the
// block's null-ness spelled out by the caller. `heapIx` is the cell's own heap type,
// `nulBlock` whether the result may still be null, `lhsCtx` the context the one lhs evaluation
// runs under and `defCtx` the context the default arm emits under.

// One evaluation, no stash, no re-read, and it short-circuits: `br_on_non_null` consumes the
// nullable ref and either branches out carrying `(ref $heapIx)` or falls through to the
// default, covering every lhs source with one arm — the narrow is the branch, so there is no
// separate narrow step to miss (the list-index lhs is where the replaced re-read shape broke).
function emitCoalesceNulRefCtx(
  e: BinExpr,
  exprIx: i32,
  heapIx: i32,
  nulBlock: boolean,
  fnIx: i32,
) {
  // A default of another type makes the result the union box, which this block type cannot be:
  // `br_on_non_null` branches with the raw ref it tested, so the boxed shape is its own arm.
  const arm = coalNulRefArmOf(e, exprIx, fnIx)
  if arm == "join" { return emitCoalesceNulRefJoin(e, exprIx, heapIx, fnIx) }
  if arm == "noBox" {
    return emitFailAt(
      "emitProgram: this `??` joins records into a union that has no box yet, as a union of two instances of one generic record does not",
      exprIx,
    )
  }
  if arm == "listClash" {
    return emitFailAt(
      "emitProgram: `??` over a list whose default is a list of another storage builds no single list at this type argument — give the default the operand's own element type",
      exprIx,
    )
  }
  coalNulRefOpen(heapIx, nulBlock)
  if emitExpr(e.binLeft, fnIx) < 0 {
    return -1 // the nullable ref, evaluated ONCE
  }
  coalNulRefBranch()
  if arm == "litAtom" && isSTy(heapIx) {
    if emitCoalesceAtomStrDefault(e.binRight, nulBlock, fnIx) < 0 { return -1 }
  } else {
    if emitExpr(e.binRight, fnIx) < 0 { return -1 }
  }
  fbEnd() // 0x0b end
  return 0
}

// Before a nullable ref `??`'s operand: the block whose type is `(ref null $heapIx)` for
// `nulBlock`, which keeps the result nullable, else `(ref $heapIx)`.
export function coalNulRefOpen(heapIx: i32, nulBlock: boolean): i32 {
  fbBlockRefNul(heapIx, nulBlock)
  return 0
}

// After a nullable ref `??`'s operand: a non-null ref branches to the block's end, so the default
// that follows runs only on `null`.
export function coalNulRefBranch(): i32 {
  fbBrOnNonNull(0)
  return 0
}

// The default of a `string | null` `??` when it is a literal-union atom (`K` or `K | null`):
// widened to its member string, `-1` to `ref.null`, and recovered non-null when the block is.
function emitCoalesceAtomStrDefault(defIx: i32, nulBlock: boolean, fnIx: i32) {
  if emitAtomToStr(defIx, fnIx) < 0 { return -1 }
  if !nulBlock && nulAtomWidenTexts(defIx, fnIx).length > 0 {
    fbRefAsNonNull() // 0xd4 the block is non-null: the default's null is narrowed away
  }
  return 0
}

// The heap the `br_on_non_null` core of `l ?? d` carries, -1 when `l` reaches none: a nullable
// collection's wrapper or the closure struct at their niche arms, else, past every boxed and fused
// arm, the nullable reference's own heap (`nulNicheValueHeap`).
export function coalNulRefHeapOf(
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
): i32 {
  return match coalNicheArmOf(e, lhsIx, exprIx, fnIx) {
    "coll" => nulCollWrapHeap(e.binLeft, fnIx)
    "clo" => cloStructIdx
    "identBox" => nulNicheValueHeap(e.binLeft, fnIx)
    // Their own lowerings: the `boolean | null` and atom niches, and the string core at `sTy()`.
    "nulBoolJoin" | "nulBool" | "litUnion" | "nulAtomStr" | "str" => -1
  }
}

// Whether `l ?? d` past `coalBoxArmOf`'s boxed arms reaches the nullable-reference rungs with no
// arm between: a name, or a call that is no `boolean | null` or `string | null` niche
// (`emitCoalesceCallNiche`), neither a field read nor a `?.` chain.
export function coalNulRefRungReached(
  e: BinExpr,
  lhsIx: i32,
  fnIx: i32,
): boolean {
  const l = nodeAt(lhsIx)
  if l is Ident { return true }
  return l is Call
    && !exprNulBool(e.binLeft, fnIx)
    && !exprNullableString(e.binLeft, fnIx)
}

// The `br_on_non_null` core of `l ?? d` along `coalNulRefHeapOf`'s heap `nrHeap`, its block shape
// `nrArm`, and, for a default that joins into a union, the tag `nrTag` the present arm boxes under.
export type CoalNulRefPlan = { nrHeap: i32, nrArm: CoalNulRefArm, nrTag: i32 }

// The nullable-reference plan of `l ?? d`, or null when `l` reaches no such core.
export function coalNulRefPlanOf(
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
): CoalNulRefPlan | null {
  const h = coalNulRefHeapOf(e, lhsIx, exprIx, fnIx)
  if h < 0 { return null }
  const a = coalNulRefArmOf(e, exprIx, fnIx)
  const tag = match a {
    "join" => coalNulRefJoinTag(e, h, fnIx)
    "noBox" | "listClash" | "litAtom" | "plain" => -1
  }
  const p: CoalNulRefPlan = { nrHeap: h, nrArm: a, nrTag: tag }
  return p
}

// The core above for the nullable struct (`S | null`) and nullable collections (`i32[] |
// null`, `string[] | null`, …): the lhs takes the ambient seeds (these reps have no
// self-recovering read) and the block type is the default's null-ness
// (`coalesceDefaultNullable`) — a non-null default collapses to `(ref $heapIx)`, a nullable one leaves it nullable, since `br_on_non_null` branches with `(ref $heapIx)`, a subtype of both.
function emitCoalesceNulRef(e: BinExpr, exprIx: i32, heapIx: i32, fnIx: i32) {
  return emitCoalesceNulRefCtx(
    e,
    exprIx,
    heapIx,
    coalesceDefaultNullable(e.binRight, fnIx),
    fnIx,
  )
}

// Widen a `??`'s unboxed operand from its own atom kind to the RESULT's, for the case where a
// wider default widened the whole expression (`i32 | null ?? 1.5` is an f64). Equal kinds emit
// nothing; a pair with no conversion refuses loudly, the block type already being the
// result's (D1699).
function coalWidenUnboxed(from: i32, to: i32) {
  if from == to { return 0 }
  if from == 0 {
    if to == 4 {
      fbF64ConvertI32S() // i32 -> f64
      return 0
    }
    if to == 5 {
      fbF32ConvertI32S() // i32 -> f32
      return 0
    }
    if to == 3 {
      fbI64ExtendI32S() // i32 -> i64
      return 0
    }
  }
  if from == 5 {
    if to == 4 {
      fbF64PromoteF32() // f32 -> f64
      return 0
    }
  }
  if from == 3 {
    if to == 4 {
      fbF64ConvertI64S() // i64 -> f64
      return 0
    }
  }
  return emitFail(
    "emitProgram: `??` widens its operand to a result kind with no conversion",
  )
}

// True when `coalWidenUnboxed` converts atom kind `from` to a different kind `to`.
function coalWidens(from: i32, to: i32): boolean {
  if from == 0 { return to == 3 || to == 4 || to == 5 }
  if from == 3 || from == 5 { return to == 4 }
  return false
}

// `l ?? d`, with a `?.` chain on the left staged for the whole lowering when its base is not
// a re-readable place — the fused arms read the receiver two and three times, and the stash
// is what lets them do that to a call. One save/restore, since a default may hold a chain.
function emitCoalesce(e: BinExpr, exprIx: i32, fnIx: i32) {
  const coRecvSv = optRecvStageSave()
  const coGetSv = listGetStageSave()
  optRecvStageMark(e.binLeft)
  const coR = emitCoalesceGo(e, exprIx, fnIx)
  optRecvStageRestore(coRecvSv)
  listGetStageRestore(coGetSv)
  return coR
}

// `x ?? d` over a nullable value box read with its narrowing lifted: the box's tag decides, the
// present arm unboxed at the coalesce's rep (a numeric scalar, or the value box itself).
function emitCoalesceBoxRuntime(e: BinExpr, exprIx: i32, fnIx: i32) {
  const bk = boxTagOfTy(nodeTyIxOf(exprIx))
  const bVt = nulBoxScalarValtype(bk)
  const bVb = vbHeapIdxOfKind(bk)
  let bNm = ""
  if exprUnion(exprIx, fnIx) { bNm = boxTyName(nodeTyIxOf(exprIx)) }
  if (bVt < 0 || bVb < 0) && bNm == "" {
    return emitFail(
      "emitProgram: `??` over a null-narrowed value box has no rep for its result",
    )
  }
  const bSlot = sharedFieldRecvSlot()
  if emitExpr(e.binLeft, fnIx) < 0 { return -1 }
  fbLocalSet(bSlot)
  fbLocalGet(bSlot)
  fbStructGet(uBoxIdx, 0) // field 0: tag
  fbI32Rel(RS_TAG, nullBoxTag())
  fbI32Bin(71) // 0x47 i32.ne — present?
  if bVt >= 0 && bVb >= 0 {
    fbIf(bVt)
    fbLocalGet(bSlot)
    fbStructGet(uBoxIdx, 1) // field 1: the payload anyref
    fbRefCast(bVb)
    fbStructGet(bVb, 0)
    fbElse()
    if emitExprAsKind(e.binRight, bk, fnIx) < 0 { return -1 }
    fbEnd()
    return 0
  }
  fbIfRefNul(uBoxIdx, false) // if (result (ref $uBox))
  fbLocalGet(bSlot)
  fbRefAsNonNull()
  fbElse()
  if emitUnionBoxOwed(bNm, nodeTyIxOf(exprIx), e.binRight, fnIx) < 0 {
    return -1
  }
  fbEnd()
  return 0
}

// `r?.f ?? d` over a value-box field, which can itself hold `null`: one test covers a null
// link and a null field, and the present arm reads the box at the `??`'s own rep — the
// unboxed scalar, or the box of a union result (D3457).
function emitOptCoalesceBoxLeaf(
  e: BinExpr,
  lhs: OptMember,
  heap: i32,
  fi: i32,
  exprIx: i32,
  fnIx: i32,
) {
  const lhsIx = unwrapParen(e.binLeft)
  let bNm = ""
  if exprUnion(exprIx, fnIx) { bNm = boxTyName(nodeTyIxOf(exprIx)) }
  // A link `emitCoalesceGo` re-associated out of a chain carries no type of its own; its
  // result is then the leaf's `T | null` with the null removed.
  let rTy = nodeTyIxOf(exprIx)
  if rTy < 0 { rTy = tyPeelNul(nodeTyIxOf(lhsIx)) }
  const bk = boxTagOfTy(rTy)
  const bVt = nulBoxScalarValtype(bk)
  if bNm == "" && bVt < 0 {
    return emitFail(
      "emitProgram: `?.` … `??` over a nullable value-box field has no rep for its result",
    )
  }
  // The box holds the FIELD's scalar; a default that widens the result (`?? 2.5` over an
  // `i32 | null` field) converts it after the unbox.
  const fk = boxTagOfTy(tyPeelNul(nodeTyIxOf(lhsIx)))
  const fVb = vbHeapIdxOfKind(fk)
  if bNm == "" && (fVb < 0 || !scalarKindWidens(fk, bk)) {
    return emitFail(
      "emitProgram: `?.` … `??` over a nullable value-box field has no conversion to its result",
    )
  }
  if emitOptChainIsNull(lhsIx, fnIx) < 0 { return -1 }
  if bNm == "" {
    fbIf(bVt)
    if emitExprAsKind(e.binRight, bk, fnIx) < 0 { return -1 }
  } else {
    fbIfRef(uBoxIdx)
    if (emitUnionBoxOwed(bNm, nodeTyIxOf(exprIx), e.binRight, fnIx) < 0) {
      return -1
    }
  }
  fbElse()
  if emitOptChainValue(lhs.omObj, fnIx) < 0 { return -1 }
  fbStructGet(heap, fi)
  if bNm == "" {
    fbStructGet(uBoxIdx, 1) // field 1: the payload anyref
    fbRefCast(fVb)
    fbStructGet(fVb, 0)
    emitScalarWiden(fk, bk)
  }
  fbEnd()
  return 0
}

// The widening `scalarKindWidens` admits, applied to the scalar on the stack.
function emitScalarWiden(from: i32, to: i32) {
  if from == to { return 0 }
  if to == 3 { return fbI64ExtendI32S() }
  if from == 5 { return fbF64PromoteF32() }
  return fbF64ConvertI32S()
}

// The receiver of a `??` field read: `cast` is the arm heap a one-arm-narrowed union box is
// cast to, -2 a null-tested nullable arm asserted non-null, -1 the receiver read as it is.
function emitCoalArmRecv(recvIx: i32, cast: i32, fnIx: i32) {
  if emitExpr(recvIx, fnIx) < 0 { return -1 }
  if cast >= 0 {
    fbStructGet(uBoxIdx, 1)
    fbRefCast(cast)
  }
  if cast == -2 { fbRefAsNonNull() }
  return 0
}

// The `if lhs != null { lhs } else { d }` node for a hole's map read `lhs ?? d` whose value type
// `coalHoleMapReadValTy` gave as `vt`. The node carries the `??`'s type.
function coalHoleMapReadNullTest(
  e: BinExpr,
  vt: i32,
  exprIx: i32,
  fnIx: i32,
): i32 {
  // A nullable number's box is the join's own rep, so its read is the `then` arm as is.
  // Typed at that box, since a re-associated chain's inner link carries no type of its own.
  if coalHoleNulNumRead(e, fnIx) {
    const nnIf = coalNullTestIf(e, exprIx, fnIx)
    nodeTyRecord(nnIf, vt)
    return nnIf
  }
  const ifIx = coalNullTestIf(e, exprIx, fnIx)
  // Typed at the instance's join, which the shared `??` records only as its hole.
  const rt = coalResultTyOf(exprIx, fnIx)
  if rt >= 0 && rt < T.tys.length && !(tyAt(rt) is TyVar) {
    nodeTyRecord(ifIx, rt)
  }
  return ifIx
}

// `if l != null { l } else { d }` for `l ?? d`, carrying the `??`'s type. A declared atom niche's
// arm re-reads `l` at its non-null set, the narrowing the checker would have recorded.
function coalNullTestIf(e: BinExpr, exprIx: i32, fnIx: i32): i32 {
  const thenS: i32[] = []
  thenS.push(coalNarrowedReRead(unwrapParen(e.binLeft), fnIx))
  const elseS: i32[] = []
  elseS.push(e.binRight)
  const pos = e.pos
  const ifIx = mkIf(
    mkNullTestNe(e.binLeft, pos),
    mkBlock(thenS, pos),
    mkBlock(elseS, pos),
    pos,
  )
  nodeTyCarry(ifIx, exprIx)
  return ifIx
}

// `if true { l } else { d }` typed at join `pt`, so the dead default still shapes the join the
// arms deliver into.
function coalRetypedDeadJoinIf(e: BinExpr, pt: i32): i32 {
  const thenS: i32[] = []
  thenS.push(e.binLeft)
  const elseS: i32[] = []
  elseS.push(e.binRight)
  const pos = e.pos
  const ifIx = mkIf(
    mkBool(1, pos),
    mkBlock(thenS, pos),
    mkBlock(elseS, pos),
    pos,
  )
  nodeTyRecord(ifIx, pt)
  return ifIx
}

// A copy of the name, field or map read `ix` typed without `null` (a literal union, or one atom
// for a field or element read), or `ix` itself when its type, an instance's own for a hole, is
// neither.
function coalNarrowedReRead(ix: i32, fnIx: i32): i32 {
  let lt = nodeTyAt(ix, fnIx)
  if lt >= 0 && lt < T.tys.length && tyAt(lt) is TyVar {
    lt = holeOperandTyOf(ix, fnIx)
  }
  if lt < 0 || lt >= T.tys.length || tyAt(lt) is TyVar { return ix }
  const nn = tyPeelNul(lt)
  if nn == lt { return ix }
  const l = nodeAt(ix)
  // A field or element read the test narrows to one atom reads at it, as the checker types it.
  if !tyIsLitUnion(nn) {
    const nk = boxTagOfTy(nn)
    if l is Ident || nk < 0 || nk == 6 { return ix }
  }
  let cp = -1
  if l is Member { cp = mkMember(l.memObj, l.memProp, l.pos) }
  if l is Index { cp = mkIndex(l.idxArr, l.idxIndex, l.pos) }
  if l is Ident {
    cp = mkIdent(l.identName, l.pos)
    identFrom(cp, ix)
  }
  if cp < 0 { return ix }
  nodeTyRecord(cp, nn)
  tyCarrySrcNote(cp, ix)
  return cp
}

// A re-associated `??` link minted in emitted function `fnIx` stands for `src` there: it is typed
// at `src`'s type in that instance, which a link minted per emission can hold as its own.
function coalLinkTyAt(link: i32, src: i32, fnIx: i32) {
  tyCarrySrcNote(link, src)
  nodeTyRecord(link, nodeTyAt(src, fnIx))
}

// Whether a `closed` `??` (`coalArmOf`) widens its atom left operand to the `??`'s own rep, which
// is no atom: the member string, or the box of a join with another type (D16530).
export function coalClosedWidensAtom(
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
): boolean {
  return exprIsLitAtom(lhsIx, fnIx) && !exprIsLitAtom(exprIx, fnIx)
}

function emitCoalesceGo(e: BinExpr, exprIx: i32, fnIx: i32) {
  const arm = coalArmOf(e, exprIx, fnIx)
  const lhsIx = unwrapParen(e.binLeft)
  if arm == "bad" || lhsIx < 0 { return -1 }
  const lhs = nodeAt(lhsIx)
  if arm == "closed" {
    if coalClosedWidensAtom(lhsIx, exprIx, fnIx) {
      const coTy = nodeTyAt(exprIx, fnIx)
      if primNameOf(coTy) == "string" { return emitAtomToStr(e.binLeft, fnIx) }
      if exprUnion(exprIx, fnIx) {
        return emitUnionBoxArg("", coTy, e.binLeft, fnIx)
      }
    }
    return emitExpr(e.binLeft, fnIx)
  }
  // `a ?? b ?? d` parses LEFT-associative (`(a ?? b) ?? d`); `??` is
  // associative, so RE-ASSOCIATE to `a ?? (b ?? d)` — the inner coalesce
  // becomes the outer's default and each LHS is again a plain place the
  // single-step lowerings below handle (host: same chained-coalesce value).
  if arm == "chain" && lhs is BinExpr {
    const reInner = mkBinary("??", lhs.binRight, e.binRight, -1)
    // The inner link is delivered at `d`'s destination, so it reads `d`'s box record.
    tyCarrySrcNote(reInner, e.binRight)
    const reOuter = mkBinary("??", lhs.binLeft, reInner, -1)
    coalLinkChains[reInner] = reOuter
    // A chain joining structs is one box: both links take the chain's union, a supertype of
    // the inner link's own join with the same null-ness, so its arm tags agree (D2373).
    const chTy = nodeTyInOf(exprIx, fnIx)
    // A chain joining numbers of different types apart is one box the same way.
    if (
      tyIsStructBearingUnion(chTy)
      || (numUnionMinted && tyHoldsNumbersApart(chTy))
    ) {
      nodeTyRecord(reInner, chTy)
      nodeTyRecord(reOuter, chTy)
    } else {
      // Otherwise the outer link is the chain. The inner one lies between `d` and the chain,
      // so it is the chain's type exactly when `d` already is.
      coalLinkTyAt(reOuter, exprIx, fnIx)
      if tySame(nodeTyAt(exprIx, fnIx), nodeTyAt(e.binRight, fnIx)) {
        coalLinkTyAt(reInner, exprIx, fnIx)
      }
    }
    // The inner link is the outer's default, delivered at the outer's type.
    numDeliverStamp(reInner, nodeTyIxOf(reInner), nodeTyIxOf(reOuter))
    return emitExpr(reOuter, fnIx)
  }
  // The operand is still evaluated and dropped for effect.
  if arm == "nulnone" {
    if emitNulNoneForEffect(lhsIx, fnIx) < 0 { return -1 }
    return emitExpr(e.binRight, fnIx)
  }
  if arm == "armIf" { return emitExpr(coalNullArmIf(e, exprIx), fnIx) }
  if (
    arm == "pinNonNull"
    || arm == "retypedDead"
    || arm == "fieldFlat"
    || arm == "popElem"
  ) {
    return emitExpr(lhsIx, fnIx)
  }
  if arm == "deadJoin" {
    return emitExpr(
      coalRetypedDeadJoinIf(e, coalRetypedDeadJoinTy(lhsIx, exprIx, fnIx)),
      fnIx,
    )
  }
  if arm == "atomToStr" { return emitAtomToStr(lhsIx, fnIx) }
  if arm == "boxRuntime" {
    const cnMark = storageReadEnter(lhsIx)
    const cnRc = emitCoalesceBoxRuntime(e, exprIx, fnIx)
    storageReadLeave(cnMark)
    return cnRc
  }
  if arm == "holeMap" {
    const hvt = coalHoleMapReadValTy(e, lhsIx, fnIx)
    return emitExpr(coalHoleMapReadNullTest(e, hvt, exprIx, fnIx), fnIx)
  }
  if arm == "mapScalarJoin" {
    const sjk = mapRecvScalarBoxKindIn(coalMapRecvOf(e), fnIx)
    if emitMapGetOrScalarJoin(e, sjk, exprIx, fnIx) < 0 { return -1 }
    return 0
  }
  if arm == "mapJoinIf" {
    return emitExpr(coalNullTestIf(e, exprIx, fnIx), fnIx)
  }
  if arm == "mapIndexGetOr" && lhs is Index {
    return emitMapGetOr(
      lhs.idxArr,
      lhs.idxIndex,
      e.binRight,
      fnIx,
      coalResultKindOf(exprIx, fnIx),
    )
  }
  if arm == "mapJoin" {
    if emitCoalesceMapJoin(e, exprIx, fnIx) < 0 { return -1 }
    return 0
  }
  if arm == "mapGetOr" || arm == "listGetOr" || arm == "popOr" {
    return emitCoalesceCallArm(arm, e, lhsIx, exprIx, fnIx)
  }
  return emitCoalesceNiche(e, lhsIx, exprIx, fnIx)
}

// The fused `??` arms over a method call operand `recv.get(k)` or `recv.pop()`.
function emitCoalesceCallArm(
  arm: CoalArm,
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
) {
  const lhs = nodeAt(lhsIx)
  if !(lhs is Call) || lhs.callFn < 0 { return -1 }
  const lcallee = nodeAt(lhs.callFn)
  if !(lcallee is Member) { return -1 }
  if arm == "mapGetOr" {
    if lhs.callArgs.length != 1 {
      return emitFail(
        "emitProgram: internal: map .get reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    return emitMapGetOr(
      lcallee.memObj,
      lhs.callArgs[0],
      e.binRight,
      fnIx,
      coalResultKindOf(exprIx, fnIx),
    )
  }
  if arm == "listGetOr" { return emitListGetOr(lhsIx, e.binRight, fnIx) }
  return emitPopOr(lhsIx, e.binRight, fnIx)
}

// `l ?? d` over an i32 niche cell whose null is `sent`: the operand once, the default on the null
// path, and the present arm re-reading the operand when `reEval`, else the stash.
function emitCoalesceNicheCell(
  e: BinExpr,
  sent: i32,
  reEval: boolean,
  fnIx: i32,
): i32 {
  if emitExpr(e.binLeft, fnIx) < 0 { return -1 }
  coalNicheOpen(sent, reEval)
  if emitExpr(e.binRight, fnIx) < 0 { return -1 }
  coalNicheElse(reEval)
  if reEval {
    if emitExpr(e.binLeft, fnIx) < 0 { return -1 }
  }
  fbEnd()
  return 0
}

// After a niche cell's operand: keep it in the stash slot unless `reEval`, then open the `if` the
// default fills when the cell is `sent`.
export function coalNicheOpen(sent: i32, reEval: boolean) {
  if !reEval {
    fbLocalSet(coalesceCallBoolSlot)
    fbLocalGet(coalesceCallBoolSlot)
  }
  fbI32Const(sent)
  fbI32Bin(70) // i32.eq
  fbIf(127)
}

// A niche cell's present arm: the stashed operand unless `reEval`, whose caller re-reads it.
export function coalNicheElse(reEval: boolean) {
  fbElse()
  if !reEval { fbLocalGet(coalesceCallBoolSlot) }
}

// The niche-cell arms of `emitCoalesceGo`, from the `boolean | null` select through the
// nullable `string`; `lhs` is `P.nodes[lhsIx]`, the unwrapped operand. Returns what
// `emitCoalesceGo` returns: 0 lowered, -1 failed.
function emitCoalesceNiche(e: BinExpr, lhsIx: i32, exprIx: i32, fnIx: i32) {
  const arm = coalNicheArmOf(e, lhsIx, exprIx, fnIx)
  // The `boolean | null` and `K | null` arms re-read an effect-free operand in the present arm;
  // one that is not (`coalLhsStashes`: a call, an `if`, a field of a call) is written once into
  // the stash slot `coalChainHasCallLhs` reserved (D1250, D17036).
  const lhsReEval = !coalLhsStashes(lhsIx)
  // A `boolean | null` cell holds 0/1 or the sentinel 2, a `K | null` cell an atom id or -1: a
  // branching `if` on the sentinel, never a `select`, so the default runs only on the null path.
  // `coalesceLitUnionFits` decides whether the rep survives the default (`k ?? "zz"` declines).
  if arm == "nulBoolJoin" { return emitCoalesceNulBoolJoin(e, exprIx, fnIx) }
  if arm == "nulBool" { return emitCoalesceNicheCell(e, 2, lhsReEval, fnIx) }
  // The operand reads at the niche its classifier names, so a prelude join builds the atom.
  if arm == "litUnion" { return emitCoalesceNicheCell(e, -1, lhsReEval, fnIx) }
  // `<e> ?? d` over a `K | null` niche whose default is not a member: the result is a
  // `string`, so the atom is evaluated once and the present arm widens it (D3198).
  if arm == "nulAtomStr" { return emitCoalesceNulAtomStr(e, fnIx) }
  // `<e> ?? d` over a nullable collection niche (`i32[] | null`, `string[] | null` /
  // `f64[] | null` / `i64[] | null` / `f32[] | null`, `i32[][] | null` / `S[] | null`): the
  // cell is a `(ref null $wrapper)`, so it takes the same `br_on_non_null` lowering as the
  // nullable struct below — placed before the sentinel-free ref paths as `emitNulIsNullTest` orders its niches, since the wrapper heap type is what distinguishes the families.
  if arm == "coll" {
    return emitCoalesceNulRef(
      e,
      exprIx,
      coalNulRefHeapOf(e, lhsIx, exprIx, fnIx),
      fnIx,
    )
  }
  // A nullable function value is the closure's own `(ref null $clo)`, the same core (D3373).
  if arm == "clo" {
    return emitCoalesceNulRef(
      e,
      exprIx,
      coalNulRefHeapOf(e, lhsIx, exprIx, fnIx),
      fnIx,
    )
  }
  // `<e> ?? d` over a `string | null` niche (an ident binding, a `string | null` struct field,
  // or a `(string | null)[]` element read): the cell is a `(ref null $sTypeIdx)`, so it takes
  // the same `br_on_non_null` core as the nullable struct/collections — one evaluation of the
  // place, and the narrow is the branch.

  // The lhs is typed `string | null`, so its read stays raw and an `array.get` stays nullable,
  // and the default follows the block type (`coalesceNulStrArmCtx`). Ungated on
  // re-readability: the core evaluates the operand ONCE, so a CALL takes this arm too —
  // gated, it fell past every niche to a lowering with the wrong heap (D1763).
  if arm == "str" {
    const coNul = coalesceNulStrStaysNullable(exprIx, fnIx)
    return emitCoalesceNulRefCtx(e, exprIx, sTy(), coNul, fnIx)
  }
  return emitCoalesceIdentBox(e, lhsIx, exprIx, fnIx)
}

// The `emitCoalesceGo` arms over a boxed operand, by `coalBoxArmOf`. Returns what
// `emitCoalesceGo` returns.
function emitCoalesceIdentBox(e: BinExpr, lhsIx: i32, exprIx: i32, fnIx: i32) {
  const arm = coalBoxArmOf(e, lhsIx, exprIx, fnIx)
  return match arm {
    "boolPop" => emitCoalesceBoolPop(e, fnIx)
    "valBox" | "valScalar" | "elem" | "callBox" | "callScalar" => {
      emitCoalesceBoxArm(arm, e, lhsIx, exprIx, fnIx)
    }
    "valNoKind" => emitFail(
      "emitProgram: `??` over a nullable value union has no banked residual kind",
    )
    "callNoKind" => emitFail("emitProgram: `??` over a call result has no banked residual kind")
    "next" => {
      if coalNulRefRungReached(e, lhsIx, fnIx) {
        emitCoalesceNullableRefs(e, exprIx, fnIx)
      } else {
        emitCoalesceCallNiche(e, lhsIx, exprIx, fnIx)
      }
    }
  }
}

// `x ?? d` over a binding seeded by a BOOLEAN-list `.pop()`: the i32 cell holds 0/1 or the
// niche sentinel 2 (`null`) — the same branching `if` the `boolean | null` arm uses, so the
// default runs only on the null path here too. Returns 0, or -1 when an operand fails.
function emitCoalesceBoolPop(e: BinExpr, fnIx: i32): i32 {
  if emitExpr(e.binLeft, fnIx) < 0 {
    return -1 // the niche i32
  }
  fbI32Const(2)
  fbI32Bin(70) // 0x46 i32.eq → x == 2 (null)
  fbIf(127)    // 0x04 if, 0x7f i32 blocktype
  if emitExpr(e.binRight, fnIx) < 0 {
    return -1 // d, reached only on the null path
  }
  fbElse() // 0x05 else — present → the 0/1 cell, re-read
  if emitExpr(e.binLeft, fnIx) < 0 { return -1 }
  fbEnd()  // 0x0b end
  return 0
}

// `x ?? d` over a boxed operand along arm `arm` of `coalBoxArmOf`: the operand's box, the shared
// open, the default, then the shared else and end, between which a binding arm re-reads its box.
// Returns 0, or -1 when an operand fails.
function emitCoalesceBoxArm(
  arm: CoalBoxArm,
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
): i32 {
  const slot = coalBoxSlot(arm)
  if coalBoxStashes(arm) && !(arm == "elem") {
    // D1250 — an if-expression operand arrives through `emitUnionCoerce`, not `emitExpr`, whose
    // `IfStmt` arm (`emitUnionIfValue`) makes the blocktype the box, a missing else null-tagged.
    const cTy = coalStashTy(lhsIx)
    if (emitUnionBoxOwed(boxTyName(cTy), cTy, e.binLeft, fnIx) < 0) {
      return -1 // the box, evaluated ONCE
    }
  } else if emitExpr(e.binLeft, fnIx) < 0 {
    return -1 // the box
  }
  if coalBoxOpen(arm, slot, e, lhsIx, exprIx, fnIx) < 0 { return -1 }
  if emitCoalesceBoxDefault(arm, e, lhsIx, exprIx, fnIx) < 0 { return -1 }
  if coalBoxElse(arm, slot, e, lhsIx, exprIx, fnIx) < 0 { return -1 }
  if arm == "valBox" {
    if emitExpr(e.binLeft, fnIx) < 0 {
      return -1 // the LHS box, re-read
    }
  } else if arm == "valScalar" {
    if emitUnionBoxPush(lhsIx, fnIx) < 0 { return -1 }
  }
  return coalBoxEnd(arm, e, lhsIx, exprIx, fnIx)
}

// Legacy's default of boxed `??` arm `arm`: a box arm coerces it into the RESULT union, not the
// operand's, which has no tag for it, since tags are global atom codes (D1699); a scalar arm reads
// it at `coalBoxValueKind`. Through `emitUnionCoerce` (D801), so a bare `null` default is the
// null-tagged box at every spelling.
function emitCoalesceBoxDefault(
  arm: CoalBoxArm,
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
): i32 {
  if arm == "valBox" || arm == "callBox" {
    let cN = coalResultBoxName(exprIx, fnIx)
    let cTy = coalResultTyOf(exprIx, fnIx)
    if cN == "" && arm == "valBox" {
      cN = unionNameOfRead(lhsIx, fnIx)
      cTy = nodeTyIxOf(unwrapParen(e.binLeft))
    } else if cN == "" {
      cTy = coalStashTy(lhsIx)
      cN = boxTyName(cTy)
    }
    return emitUnionBoxOwed(cN, cTy, e.binRight, fnIx)
  }
  const k = coalBoxValueKind(arm, e, lhsIx, exprIx, fnIx)
  if k < 0 { return -1 }
  return emitExprAsKind(e.binRight, k, fnIx)
}

// The local boxed `??` arm `arm` stashes its operand's box in, taken before the box is written,
// as legacy takes it: the shared field-receiver slot for a list element, the coalesce-call slot
// for an operand that cannot be re-read, and -1 for a binding, re-read in place.
export function coalBoxSlot(arm: CoalBoxArm): i32 {
  if arm == "elem" { return sharedFieldRecvSlot() }
  if arm == "callBox" || arm == "callScalar" { return coalesceCallSlot }
  if arm == "valBox" || arm == "valScalar" { return -1 }
  // `boolPop`, `valNoKind`, `callNoKind` and `next` are no boxed arm.
  return emitFail("coalBoxSlot: `??` arm " + arm + " reads no box")
}

// Whether boxed `??` arm `arm` reads its operand once into `coalBoxSlot`.
export function coalBoxStashes(arm: CoalBoxArm): boolean {
  return arm == "elem" || arm == "callBox" || arm == "callScalar"
}

// The atom kind boxed `??` arm `arm` reads its default and its unboxed result at: the checker's
// result kind, or the operand's residual atom where the result names no other. -1 for a box arm,
// whose default is the result union's box.
export function coalBoxValueKind(
  arm: CoalBoxArm,
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
): i32 {
  if arm == "elem" { return boxTagOfTy(coalResultTyOf(exprIx, fnIx)) }
  const ak = coalBoxAtomKind(arm, e, lhsIx, fnIx)
  if !(arm == "valScalar" || arm == "callScalar") { return -1 }
  let rk = ak
  const rn = boxTagOfTy(coalResultTyOf(exprIx, fnIx))
  if rn >= 0 && rn != nullValKind() { rk = rn }
  return rk
}

// The atom kind the box of boxed `??` arm `arm` holds: the element's own, or the operand's one
// residual member. -1 for an arm that does not unbox.
function coalBoxAtomKind(
  arm: CoalBoxArm,
  e: BinExpr,
  lhsIx: i32,
  fnIx: i32,
): i32 {
  return match arm {
    "elem" => boxTagOfTy(nonNullTy(nodeTyIxOf(e.binLeft)))
    "valScalar" => coalValUnionResidualKind(lhsIx, fnIx)
    "callScalar" => coalStashResidualKind(lhsIx)
    "valBox" | "callBox" | "boolPop" | "valNoKind" | "callNoKind" | "next" => -1
  }
}

// The null test on the box on the stack: its tag is the null tag.
function coalTagIsNull() {
  fbStructGet(uBoxIdx, 0) // field 0: tag
  fbI32Rel(RS_TAG, nullBoxTag())
  fbI32Bin(70) // 0x46 i32.eq → null?
}

// The open of boxed `??` arm `arm` once its operand's box is on the stack: the stash into `slot`,
// the tag test and the `if` at the result's block type. A list element tests presence and writes
// its unboxed present arm first, then the `else`. Returns 0, or -1.
export function coalBoxOpen(
  arm: CoalBoxArm,
  slot: i32,
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
): i32 {
  if arm == "elem" { return coalElemOpen(slot, e, lhsIx, exprIx, fnIx) }
  if coalBoxStashes(arm) {
    fbLocalSet(slot)
    fbLocalGet(slot)
  }
  coalTagIsNull()
  if arm == "valBox" || arm == "callBox" {
    fbIfRef(uBoxIdx) // 0x04 if, (ref $uBoxIdx) blocktype
    return 0
  }
  const k = coalBoxValueKind(arm, e, lhsIx, exprIx, fnIx)
  if k < 0 {
    return emitFail("coalBoxOpen: `??` arm " + arm + " has no result kind")
  }
  fbIf(valBlockTypeOfKind(k)) // 0x04 if, value blocktype
  return 0
}

// A list element's open: stash the box, then present is a box there whose tag is not the null
// tag. A `.get` miss yields no box at all, so its test short-circuits on `ref.is_null`; a
// subscript traps out of range and keeps the one test. The present arm unboxes the element's
// own atom and widens it to the result's, which a wider default makes wider (D3795).
function coalElemOpen(
  slot: i32,
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
): i32 {
  fbLocalSet(slot)
  if isListGetCall(e.binLeft, fnIx) {
    fbLocalGet(slot)
    fbRefIsNull()
    fbIf(127)
    fbI32Const(0)
    fbElse()
    fbLocalGet(slot)
    fbStructGet(uBoxIdx, 0) // field 0: tag
    fbI32Rel(RS_TAG, nullBoxTag())
    fbI32Bin(71) // 0x47 i32.ne
    fbEnd()
  } else {
    fbLocalGet(slot)
    fbStructGet(uBoxIdx, 0) // field 0: tag
    fbI32Rel(RS_TAG, nullBoxTag())
    fbI32Bin(71) // 0x47 i32.ne — present?
  }
  // The result is read at the instance's pin, since a generic body records its `??` at the hole
  // (D3744).
  const k = coalBoxValueKind("elem", e, lhsIx, exprIx, fnIx)
  const ak = coalBoxAtomKind("elem", e, lhsIx, fnIx)
  const vb = vbHeapIdxOfKind(ak)
  fbIf(nulBoxScalarValtype(k))
  fbLocalGet(slot)
  fbStructGet(uBoxIdx, 1) // field 1: the payload anyref
  fbRefCast(vb)
  fbStructGet(vb, 0)
  emitScalarWiden(ak, k)
  fbElse()
  return 0
}

// The `else` of boxed `??` arm `arm` after its default: the stashed box, or for a scalar result
// the stash unboxed and widened. A binding re-reads its box after this; a list element's present
// arm came first. Returns 0, or -1.
export function coalBoxElse(
  arm: CoalBoxArm,
  slot: i32,
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
): i32 {
  if arm == "elem" { return 0 }
  fbElse() // 0x05 else — present
  if arm == "callBox" {
    fbLocalGet(slot)
    return 0
  }
  if arm != "callScalar" { return 0 }
  fbLocalGet(slot)
  fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
  const ak = coalBoxAtomKind(arm, e, lhsIx, fnIx)
  const kvb = vbHeapIdxOfKind(ak)
  if kvb < 0 {
    return emitFail("emitProgram: union call atom has no value box")
  }
  fbRefCast(kvb)
  fbStructGet(kvb, 0) // the scalar payload
  return coalWidenUnboxed(ak, coalBoxValueKind(arm, e, lhsIx, exprIx, fnIx))
}

// The end of boxed `??` arm `arm`: a binding's re-read box unboxed at its residual atom and
// widened to the result's kind when the result is a scalar, then the `if`'s end. Returns 0, or -1.
export function coalBoxEnd(
  arm: CoalBoxArm,
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
): i32 {
  if arm == "valScalar" {
    const ak = coalBoxAtomKind(arm, e, lhsIx, fnIx)
    if emitUnionUnboxTail(ak) < 0 { return -1 }
    if coalWidenUnboxed(ak, coalBoxValueKind(arm, e, lhsIx, exprIx, fnIx)) < 0 {
      return -1
    }
  }
  fbEnd() // 0x0b end
  return 0
}

// The `emitCoalesceGo` arms over a call, `as?` or if-expression operand yielding a
// `boolean | null` or `string | null` niche, stashed once, then the rest of the ladder. Returns
// what `emitCoalesceGo` returns.
function emitCoalesceCallNiche(e: BinExpr, lhsIx: i32, exprIx: i32, fnIx: i32) {
  const lhs = nodeAt(lhsIx)
  const cTy = coalStashTy(lhsIx)
  if (
    lhs is Call
    || ((lhs is AsExpr || lhs is IfStmt)
      && (tyIsNulValueUnionBox(cTy) || nodeTyIsNulScalarBox(lhsIx)))
  ) {
    // `f() ?? d` over a CALL returning `boolean | null` (the i32 niche): a call cannot be
    // re-read, so STASH the single evaluation in the bool slot, then branch on the sentinel
    // 2 — the call analogue of the `boolean | null` ident path, and the default runs only on
    // the null path for the same reason.
    if exprNulBool(e.binLeft, fnIx) {
      if emitExpr(e.binLeft, fnIx) < 0 {
        return -1 // the niche i32, evaluated ONCE
      }
      fbLocalSet(coalesceCallBoolSlot)
      fbLocalGet(coalesceCallBoolSlot)
      fbI32Const(2)
      fbI32Bin(70) // 0x46 i32.eq → x == 2 (null)
      fbIf(127)    // 0x04 if, 0x7f i32 blocktype
      if emitExpr(e.binRight, fnIx) < 0 {
        return -1 // d, reached only on the null path
      }
      fbElse() // 0x05 else — present → the stashed 0/1 cell
      fbLocalGet(coalesceCallBoolSlot)
      fbEnd()  // 0x0b end
      return 0
    }
    // `f() ?? d` over a CALL returning `string | null` (kind 16): STASH the nullable
    // ref once (raw, by its type), then a value-typed `if` on
    // `ref.is_null` selects `d` or the recovered non-null string — the call analogue
    // of the `string | null` ident path.
    if exprNullableString(e.binLeft, fnIx) {
      // the raw nullable ref, ONCE
      if emitExpr(e.binLeft, fnIx) < 0 { return -1 }
      fbLocalSet(coalesceCallStrSlot)
      fbLocalGet(coalesceCallStrSlot)
      fbRefIsNull() // → 1 if null
      // The SAME result-nullability question the re-evaluating arm asks — see
      // `coalesceNulStrStaysNullable`. A nullable default keeps the result nullable here too.
      const coNulC = coalesceNulStrStaysNullable(exprIx, fnIx)
      fbIfRefNul(sTy(), coNulC)
      // Each arm reads UNDER the block type just declared (the re-evaluating arm's
      // discipline): the default is raw only when the result is nullable, and the stashed
      // LHS is non-null on every path that reaches the else (`ref.is_null` said no).
      if (emitExpr(e.binRight, fnIx) < 0) {
        return -1 // d (a string, nullable only when the block is)
      }
      fbElse()         // 0x05 else
      fbLocalGet(coalesceCallStrSlot)
      fbRefAsNonNull() // 0xd4 recover the non-null string the slot holds
      fbEnd()          // 0x0b end
      return 0
    }
  }
  return emitCoalesceUnionField(e, lhsIx, exprIx, fnIx)
}

// The variant row the receiver of the field read `memIx` is narrowed to when that receiver is
// a union box, or -1: the pairing `emitMem` reads through `emitNarrowedMem`.
function coalNarrowedBoxArm(memIx: i32, fnIx: i32): i32 {
  const m = nodeAt(memIx)
  if !(m is Member) { return -1 }
  const vi = memNarrowVariantIndex(memIx, fnIx)
  if vi < 0 || !exprUnion(m.memObj, fnIx) { return -1 }
  return vi
}

// The `emitCoalesceGo` arm over a value-union record field `o.v ?? d`, then the rest of the
// ladder. Returns what `emitCoalesceGo` returns.
function emitCoalesceUnionField(
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
) {
  const lhs = nodeAt(lhsIx)
  // `o.v ?? d` over a value-union struct field (`v: i32 | null`, code 16): the field-read dual
  // of the boxed-union name path above — read the box off the field, test its tag for `null`,
  // and select the default or the unboxed single remaining scalar atom. The receiver re-reads
  // in the non-null arm (a name/field chain, like the nullable-struct `?.` path).
  if lhs is Member {
    // The receiver is a struct row or a union arm; an arm's field reads off its own heap
    // type exactly as a row's does (D4667).
    let mHeap = -1
    let mfi = -1
    let mphys = ""
    let mphysTy = -1
    let mCast = -1
    // A box receiver narrowed to one arm is unwrapped to that arm, asked ahead of the row as
    // `emitMem` asks it: an index place is typed at the arm, so `structIndexOfExpr` answers
    // for a ref it does not hold (D8145). A null-tested nullable arm is asserted non-null.
    let mvi = coalNarrowedBoxArm(lhsIx, fnIx)
    if mvi >= 0 { mCast = variantHeap(mvi) }
    const msi = if mvi >= 0 { -1 } else { structIndexOfExpr(lhs.memObj, fnIx) }
    if msi >= 0 {
      mfi = sFieldIndex(msi, lhs.memProp)
      if mfi >= 0 && sFieldIsUnionBox(msi, mfi) {
        mHeap = sHeapIdx[msi]
        mphys = sFieldElemNameAt(msi, mfi)
        mphysTy = sFieldElemTyIxAt(msi, mfi)
      }
    } else {
      if mvi < 0 { mvi = exprVariantIndex(lhs.memObj, fnIx) }
      if mvi < 0 {
        mvi = nulVariantIdxOfExpr(lhs.memObj, fnIx)
        if mvi >= 0 { mCast = -2 }
      }
      if mvi >= 0 {
        mfi = variantFieldIndex(mvi, lhs.memProp)
        if mfi >= 0 && fieldRowIsUnionBox(uFieldStart[mvi] + mfi) {
          mHeap = variantHeap(mvi)
          mphys = variantFieldElemName(mvi, mfi)
          mphysTy = uFieldElemTyIxAt(mvi, mfi)
        }
      }
    }
    if mHeap >= 0 {
      // A wider record's box is read at the receiver's own member set (D3006).
      if memReadBoxAmbiguous(lhsIx, fnIx) { return emitBoxAmbiguousFail(lhsIx) }
      // A box rebuilt at a narrower union has no `??` lowering; the field's own box is read.
      if memReadBoxNarrowTy(lhsIx, fnIx) >= 0 {
        return emitFail(
          "emitProgram: `??` over a narrowed union-box field read",
        )
      }
      const munm = mphys
      const munTy = mphysTy
      // D-VALUNION + D-SETONCE — see the call arm above.
      const msid = msSetOfTy(munTy)
      if (isValueUnionOfSet(msid, munTy) && setHasNullAtom(msid)) {
        // D-union-atom-kind — see `unionResidualSoloKindOfSet`.
        const mak = unionResidualSoloKindOfSet(msid)
        if mak == -2 {
          return emitFail(
            "emitProgram: `??` over a union field has no banked residual kind",
          )
        }
        if mak >= 0 && mak != nullValKind() {
          // A union result or a NULLABLE default keeps the result boxed — the SAME decision
          // the ident and call arms make; the else arm re-reads the field's own box rather
          // than unboxing it, and the default is coerced into the result's union.
          const mResN = coalResultBoxName(exprIx, fnIx)
          if mResN != "" || coalesceDefaultNullable(e.binRight, fnIx) {
            let mCoerceN = mResN
            let mCoerceTy = coalResultTyOf(exprIx, fnIx)
            if mCoerceN == "" {
              mCoerceN = munm
              mCoerceTy = nodeTyIxOf(lhsIx)
            }
            if emitCoalArmRecv(lhs.memObj, mCast, fnIx) < 0 { return -1 }
            fbStructGet(mHeap, mfi) // the union box
            fbStructGet(uBoxIdx, 0) // field 0: tag
            fbI32Rel(RS_TAG, nullBoxTag())
            fbI32Bin(70)            // 0x46 i32.eq → null?
            fbIfRef(uBoxIdx)        // 0x04 if, (ref $uBoxIdx) blocktype
            // THROUGH `emitUnionCoerce` — the D801 seed, the third of the three
            // boxed-union `??` spellings that share this lowering.
            if (emitUnionBoxOwed(mCoerceN, mCoerceTy, e.binRight, fnIx) < 0) {
              return -1 // d, its own box
            }
            fbElse() // 0x05 else — present → re-read the field
            if emitCoalArmRecv(lhs.memObj, mCast, fnIx) < 0 { return -1 }
            fbStructGet(mHeap, mfi)
            fbEnd() // 0x0b end
            return 0
          }
          // The result kind is the checker's, as at the ident and call arms: a wider default
          // widens the whole `??` (D1699, D10060).
          let mRk = mak
          const mRkN = boxTagOfTy(coalResultTyOf(exprIx, fnIx))
          if mRkN >= 0 && mRkN != nullValKind() { mRk = mRkN }
          if emitCoalArmRecv(lhs.memObj, mCast, fnIx) < 0 { return -1 }
          fbStructGet(mHeap, mfi)       // the union box
          fbStructGet(uBoxIdx, 0)       // field 0: tag
          fbI32Rel(RS_TAG, nullBoxTag())
          fbI32Bin(70)                  // 0x46 i32.eq → null?
          fbIf(valBlockTypeOfKind(mRk)) // 0x04 if, value blocktype
          if emitExprAsKind(e.binRight, mRk, fnIx) < 0 { return -1 }
          fbElse()                      // 0x05 else — present → unbox
          if emitCoalArmRecv(lhs.memObj, mCast, fnIx) < 0 { return -1 }
          fbStructGet(mHeap, mfi)
          fbStructGet(uBoxIdx, 1)       // field 1: value (anyref)
          const mvb = vbHeapIdxOfKind(mak)
          if mvb < 0 {
            return emitFail("emitProgram: union field atom has no value box")
          }
          fbRefCast(mvb)
          fbStructGet(mvb, 0) // the scalar payload
          if coalWidenUnboxed(mak, mRk) < 0 { return -1 }
          fbEnd()             // 0x0b end
          return 0
        }
      }
    }
  }
  return emitCoalesceOptMember(e, lhsIx, exprIx, fnIx)
}

// `xs.get(i)?.f ?? d` over a ref list whose element row is `gSi` (heap `gHeap`): one bounds
// compare, then the field off the in-range element or the default. Returns -1 on a failure,
// else 0.
function emitCoalesceOptListGet(
  e: BinExpr,
  lhs: OptMember,
  omGet: Call,
  gCallee: Member,
  gSi: i32,
  gHeap: i32,
  fnIx: i32,
) {
  if omGet.callArgs.length != 1 {
    return emitFail(
      "emitProgram: internal: .get reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  const gFi = sFieldIndex(gSi, lhs.omProp)
  if gFi < 0 {
    return emitFail(
      "emitProgram: `?.` field is not on the list's element struct",
    )
  }
  if !sFieldIsPlainI32(gSi, gFi) {
    return emitFail(
      "emitProgram: `?.` over a list .get supports only i32/boolean fields",
    )
  }
  const gSlot = refListSlotOfExpr(gCallee.memObj, fnIx)
  if gSlot < 0 { return refListRowRefused(gCallee.memObj) }
  // The same two operands, emitted twice each below — staged, not refused (D1677).
  listGetStageMark(unwrapParen(lhs.omObj))
  // cond: idx u< len
  if emitListGetIdx(omGet.callArgs[0], fnIx) < 0 { return -1 }
  const gWrap = rlWrapIdx[gSlot]
  if emitListGetRecv(gCallee.memObj, fnIx, gWrap) < 0 { return -1 }
  fbStructGet(rlWrapIdx[gSlot], 1) // field 1: len
  fbI32Bin(73)                     // 0x49 i32.lt_u
  fbIf(127)                        // 0x04 if, 0x7f i32 result blocktype
  if emitListGetRecv(gCallee.memObj, fnIx, gWrap) < 0 { return -1 }
  fbStructGet(gWrap, 0)            // field 0: backing
  if emitListGetIdx(omGet.callArgs[0], fnIx) < 0 { return -1 }
  fbArrayGet(rlBackIdx[gSlot])     // → (ref null $elem)
  fbRefAsNonNull()                 // a live in-range element is non-null
  fbStructGet(gHeap, gFi)          // .f
  fbElse()                         // 0x05 else
  if emitExpr(e.binRight, fnIx) < 0 { return -1 }
  fbEnd()                          // 0x0b end
  return 0
}

// `p?.f ?? d` over a nullable receiver whose record row is `nsi` (heap `nHeap`): null selects
// the default, else the field. Returns what `emitCoalesceGo` returns.
function emitCoalesceOptNulRecord(
  e: BinExpr,
  lhs: OptMember,
  nsi: i32,
  nHeap: i32,
  exprIx: i32,
  fnIx: i32,
) {
  const nfi = sFieldIndex(nsi, lhs.omProp)
  if nfi < 0 { return emitFail("emitProgram: `?.` field is not on the struct") }
  // Both arms of this `if` yield the field's rep, so its blocktype spells that rep
  // (`fbIfForOptLeaf`), not a fixed `i32`.
  const nfRow = sFieldFlatRow(nsi, nfi)
  const nfKind = fieldRowKind(nfRow)
  // A record field spells its `if` result from the field's own target row. Two null tests,
  // not one: a record slot is `(ref null $S)` at both declarations (D1180), and `o?.f ??
  // d` must yield `d` when the field is null too — receiver-null or field-null, short-circuited through one i32 `if` so `struct.get` never runs on a null receiver.
  if eqKindIsRecord(nfKind) {
    const ntg = sFieldTgtStructIdx(nsi, nfi)
    if ntg < 0 {
      return emitFail(
        "emitProgram: `?.` over a nested-struct field names no struct row",
      )
    }
    const nDefNul = coalesceDefaultNullable(e.binRight, fnIx)
    if emitOptRecvBase(lhs.omObj, fnIx, false) < 0 { return -1 }
    fbRefIsNull() // the receiver
    fbIf(127)
    fbI32Const(1)
    fbElse()
    if emitOptRecvBase(lhs.omObj, fnIx, true) < 0 { return -1 }
    fbStructGet(nHeap, nfi)
    fbRefIsNull() // the field slot
    fbEnd()
    fbIfRefNul(sHeapIdx[ntg], nDefNul)
    if emitExpr(e.binRight, fnIx) < 0 { return -1 }
    fbElse()
    if emitOptRecvBase(lhs.omObj, fnIx, true) < 0 { return -1 }
    fbStructGet(nHeap, nfi)
    if !nDefNul { fbRefAsNonNull() }
    fbEnd()
    return 0
  }
  if nfKind == "union" {
    return emitOptCoalesceBoxLeaf(e, lhs, nHeap, nfi, exprIx, fnIx)
  }
  // A function-value leaf is the standalone `?.`'s nullable closure ref, so that core takes it.
  if nfKind == "closure" || nfKind == "nulclosure" {
    return emitCoalesceNulRef(e, exprIx, cloStructIdx, fnIx)
  }
  // A map leaf is the standalone `?.`'s nullable map ref, so the nullable-map core takes it.
  if nfKind == "map" || nfKind == "nulmap" {
    const nms = sFieldMapShape(nsi, nfi)
    if nms == -3 {
      return emitFail("emitProgram: `?.` map leaf's value type is still open")
    }
    return emitCoalesceNulRef(e, exprIx, mapTypeIdxOf(nms), fnIx)
  }
  const nfLeaf = optLeafKindOf(
    fieldRowNumKind(nfRow),
    fieldRowIsStr(nfRow, false),
  )
  if nfLeaf == null {
    return emitFailAt(
      "emitProgram: `?.` over a nullable struct has no `if` blocktype for this field's rep",
      exprIx,
    )
  }
  if emitOptRecvBase(lhs.omObj, fnIx, false) < 0 { return -1 }
  fbRefIsNull()
  fbIfForOptLeaf(nfLeaf) // if (result <the field's own rep>)
  if emitOptLeafDefault(e.binRight, nfLeaf, fnIx) < 0 { return -1 }
  fbElse()               // 0x05 else — present → the field
  if emitOptRecvBase(lhs.omObj, fnIx, true) < 0 { return -1 }
  fbStructGet(nHeap, nfi)
  fbEnd()                // 0x0b end
  return 0
}

// `p?.f ?? d` over a receiver typed `Arm | null`, laid out at variant row `nvi` rather than a
// struct row: a hole instance's pin reaches it, where the rewrite that guards a concrete one
// reads the shared node (D3215). A field whose rep has an `if` blocktype only.
function emitCoalesceOptNulVariant(
  e: BinExpr,
  lhs: OptMember,
  nvi: i32,
  fnIx: i32,
) {
  if nvi < 0 || nvi >= uVarRow.length {
    return emitFail("emitProgram: `?.` receiver has no union arm row")
  }
  const vfi = variantFieldIndex(nvi, lhs.omProp)
  if vfi < 0 {
    return emitFail("emitProgram: `?.` field is not on the union arm")
  }
  const vLeaf = optLeafKindOf(
    variantFieldNumKind(nvi, vfi),
    variantFieldIsStr(nvi, vfi, false),
  )
  if vLeaf == null {
    return emitFail(
      "emitProgram: `?.` over a nullable union arm has no `if` blocktype for this field's rep",
    )
  }
  if emitOptRecvBase(lhs.omObj, fnIx, false) < 0 { return -1 }
  fbRefIsNull()
  fbIfForOptLeaf(vLeaf)
  if emitOptLeafDefault(e.binRight, vLeaf, fnIx) < 0 { return -1 }
  fbElse()
  if emitOptRecvBase(lhs.omObj, fnIx, false) < 0 { return -1 }
  fbRefCast(variantHeap(nvi))
  fbStructGet(variantHeap(nvi), vfi)
  fbEnd()
  return 0
}

// `m[k]?.f ?? d` over a map whose value row is `omSl`: probe, then the field off the hit's
// value or the default. Returns -1 on a failure, else 0.
function emitCoalesceOptMapField(
  e: BinExpr,
  lhs: OptMember,
  omInner: Index,
  omSl: i32,
  fnIx: i32,
) {
  if !mvValIsRecord(omSl) {
    return emitFail("emitProgram: `?.` needs a struct-valued map")
  }
  // The variant half of the value row, the same either/or the store seed and the `??`
  // default seed have carried since D34. `mvValStructIdx` is -1 for an arm-valued map
  // (`collectS` skips a union member), so this site needs `variantFieldIndex` /
  // `variantFieldTypeAt` / `variantHeap` — arm-for-arm twins of the struct accessor beside it, since a missing branch answered -1 and blamed the wrong field.
  let omHeap = -1
  let omFi = -1
  let omNum = -1
  // …through the layout identity (D123), the same read the store and `??`
  // default seeds take: the field lookup must run against the row whose heap the
  // vals element holds.
  const omVi = mvValVariantOf(omSl)
  if omVi >= 0 {
    omFi = variantFieldIndex(omVi, lhs.omProp)
    if omFi >= 0 {
      omHeap = variantHeap(omVi)
      omNum = variantFieldNumKind(omVi, omFi)
    }
  } else {
    const omSi = mvValStructIdxOf(omSl)
    // `sFieldIndex` bounds its own index (a row of -1 answers -1), so the heap read
    // below is reached only for a row that named the field.
    omFi = sFieldIndex(omSi, lhs.omProp)
    if omFi >= 0 {
      if omSi < 0 { return -1 }
      omHeap = sHeapIdx[omSi]
      omNum = fieldRowNumKind(sFieldStart[omSi] + omFi)
    }
  }
  if omFi < 0 {
    return emitFail("emitProgram: `?.` field is not on the map's value struct")
  }
  const omLeaf = optLeafKindOf(omNum, false)
  if omLeaf == null {
    return emitFail(
      "emitProgram: `?.` over a map read has no `if` blocktype for this field's rep",
    )
  }
  if emitMapPrep(omInner.idxArr, omInner.idxIndex, fnIx) < 0 { return -1 }
  pushMapScr(5)                // entry
  fbIfForOptLeaf(omLeaf)       // if (entry != 0 → hit), at the field's blocktype
  pushMapVals()
  fbStructGet(cmValsWrap(), 0) // vals backing
  pushMapScr(5)                // entry
  fbI32Const(1)
  fbI32Bin(107)                // i32.sub (entry - 1)
  fbArrayGet(cmValsBack())     // (ref null <value struct>)
  fbRefAsNonNull()             // a live entry's value is non-null
  fbStructGet(omHeap, omFi)    // .f — the arm's `variantHeap` row or the struct's
  fbElse()                     // else
  if emitOptLeafDefault(e.binRight, omLeaf, fnIx) < 0 { return -1 }
  fbEnd()                      // end (if)
  return 0
}

// The `emitCoalesceGo` arms over an optional-chain operand `?.f ?? d`: a map read, a
// nullable record, a nested chain and a list `.get`. Returns what `emitCoalesceGo` returns.
function emitCoalesceOptMember(e: BinExpr, lhsIx: i32, exprIx: i32, fnIx: i32) {
  const lhs = nodeAt(lhsIx)
  // The null-safe field read `m[k]?.f ?? d` over a struct-valued map is the fused form: probe;
  // on a hit read the field off the (non-null) value struct, else push the default. A live
  // entry's value slot is never null, so the `?.` null test coincides with the probe's hit
  // test. A field whose rep has an `if` blocktype only (`optLeafKindOf`).
  if lhs is OptMember {
    const omInner = nodeAt(lhs.omObj)
    if omInner is Index {
      if exprMap(omInner.idxArr, fnIx) {
        const omSl = mapShapeOfExpr(omInner.idxArr, fnIx)
        if omSl >= 0 {
          return emitCoalesceOptMapField(e, lhs, omInner, omSl, fnIx)
        }
      }
    }
    // `p?.f ?? d` over a nullable-struct receiver (`p: S | null`, or a nullable-struct field
    // read `n.next`): null selects the default, else the field read off the (non-null) struct.
    // The receiver is read two or three times here, from `optRecvSlot` when it is a call and
    // in place when it is a name. Scalar fields only (the value-typed `if` blocktype).
    if exprNullableStruct(lhs.omObj, fnIx) {
      const nsi = structIndexOfExpr(lhs.omObj, fnIx)
      if nsi >= 0 {
        return emitCoalesceOptNulRecord(
          e,
          lhs,
          nsi,
          sHeapIdx[nsi],
          exprIx,
          fnIx,
        )
      }
    }
    const nvi = nulVariantIdxOfExpr(lhs.omObj, fnIx)
    if nvi >= 0 { return emitCoalesceOptNulVariant(e, lhs, nvi, fnIx) }
    // A nested optional chain `o?.inner?.v ?? d` (niche nullable links): any null link selects
    // the default; otherwise the chain reads through non-null refs (each `S | null` link
    // recovers `ref.as_non_null`). The links are effect-free places, re-evaluated in the value
    // arm. Scalar (i32/boolean) leaf fields only (the value-typed `if` blocktype).
    const omDeep = nodeAt(unwrapParen(lhs.omObj))
    if omDeep is OptMember {
      const dsi = optChainStructIdxOf(lhs.omObj, fnIx)
      if dsi >= 0 {
        const dfi = sFieldIndex(dsi, lhs.omProp)
        if dfi >= 0 {
          if !sFieldIsPlainI32(dsi, dfi) {
            return emitFail(
              "emitProgram: `?.` chain supports only i32/boolean leaf fields",
            )
          }
          if emitOptChainIsNull(lhs.omObj, fnIx) < 0 { return -1 }
          fbIf(127) // 0x04 if, i32 result — a null link → default
          if emitExpr(e.binRight, fnIx) < 0 { return -1 }
          fbElse()  // 0x05 else — every link present → the leaf
          if emitOptChainValue(lhs.omObj, fnIx) < 0 { return -1 }
          fbStructGet(sHeapIdx[dsi], dfi)
          fbEnd()   // 0x0b end
          return 0
        }
      }
    }
    // `xs.get(i)?.f ?? d` over a struct-element ref list is the fused form: one bounds
    // compare; in range read the field off the (non-null) element, else the default. A live
    // in-range element is never null, so the `?.` null test coincides with the bounds test —
    // mirroring the map `m[k]?.f ?? d` path above. Scalar fields only.
    const omGet = nodeAt(unwrapParen(lhs.omObj))
    if omGet is Call {
      if omGet.callFn < 0 { return -1 }
      const gCallee = nodeAt(omGet.callFn)
      if gCallee is Member {
        if gCallee.memProp == "get" {
          const gSi = structListPopGetElem(unwrapParen(lhs.omObj), fnIx)
          if gSi >= 0 && rlRowsMinted() {
            return emitCoalesceOptListGet(
              e,
              lhs,
              omGet,
              gCallee,
              gSi,
              sHeapIdx[gSi],
              fnIx,
            )
          }
        }
      }
    }
  }
  return emitCoalesceNullableRefs(e, exprIx, fnIx)
}

// The last `emitCoalesceGo` arms, the nullable-ref cores (a union arm, a record, a value-union
// box, a map), and the refusal for any other nullable operand. Returns what
// `emitCoalesceGo` returns.
function emitCoalesceNullableRefs(e: BinExpr, exprIx: i32, fnIx: i32) {
  // The variant sibling of the arm below, its own arm rather than a widening of it: a `T |
  // null` whose `T` is a union arm stores `(ref null $variantHeap(vi))`, and
  // `structIndexOfExpr` has no row to answer with (`collectS` skips a union member). Same
  // niche, same `br_on_non_null` lowering, one table over.
  const crHeap = coalNulRefHeapOf(e, unwrapParen(e.binLeft), exprIx, fnIx)
  if crHeap >= 0 { return emitCoalesceNulRef(e, exprIx, crHeap, fnIx) }
  // D960 — `??` over a nullable value-union box whose operand cannot be re-read. The
  // re-readable spelling never arrives here: `emit_rewrite` desugars it to an `if`, which is
  // right because a rewrite leaves no `??` node for the consumer classifiers to disagree
  // about. A call operand cannot take that route, so it needs a real emit arm: stash the box once, branch on its tag, and give the `if` the box as its result type so both arms agree.

  // The two earlier emit arms fought each other: one emitted a correct `(if (result (ref
  // $box)) …)`, and the return path wrapped it in a second `struct.new $box` — the pair D969
  // untangled, since the consumer double-boxes precisely because `exprUnion` answers false for
  // this node. Teaching `unionNameOfExpr` to answer for a value-union `??` is the other half; neither half works alone.
  if tyIsNulValueUnionBox(nodeTyAt(e.binLeft, fnIx)) {
    const coNm = boxTyName(nodeTyIxOf(exprIx))
    if coNm != "" {
      const coSlot = sharedFieldRecvSlot()
      if emitExpr(e.binLeft, fnIx) < 0 { return -1 }
      fbLocalSet(coSlot)
      fbLocalGet(coSlot)
      fbStructGet(uBoxIdx, 0) // field 0: tag
      fbI32Rel(RS_TAG, nullBoxTag())
      fbI32Bin(71) // 0x47 i32.ne  -> present?
      fbIfRefNul(uBoxIdx, false) // if (result (ref $uBox))
      fbLocalGet(coSlot)
      fbRefAsNonNull() // the stash cell is nullable, the block type is not
      fbElse()
      if (emitUnionBoxOwed(coNm, nodeTyIxOf(exprIx), e.binRight, fnIx) < 0) {
        return -1
      }
      fbEnd()
      return 0
    }
    // An instance's re-readable list cell, typed at the box only at its pin, is the null test
    // the rewrite makes of the concrete spelling (D8820).
    const coLhs = unwrapParen(e.binLeft)
    if coLhs >= 0 && fnInPinnedInstance(fnIx) && exprReReadable(coLhs) {
      const coCell = nodeAt(coLhs)
      if coCell is Index && !exprMap(coCell.idxArr, fnIx) {
        return emitExpr(coalNullTestIf(e, exprIx, fnIx), fnIx)
      }
    }
  }
  // `<e> ?? d` over a nullable map: the cell is a `(ref null $map)` of the operand's shape, so it
  // takes the same `br_on_non_null` core, and a `Map()` default builds that shape (D3257).
  if exprNullableMap(e.binLeft, fnIx) {
    let cms = mapShapeOfExpr(e.binLeft, fnIx)
    if cms == -3 { cms = mapShapeOfTyPeeled(nodeTyIxOf(e.binLeft)) }
    if cms != -3 {
      return emitCoalesceNulRef(e, exprIx, mapTypeIdxOf(cms), fnIx)
    }
  }
  // What reaches here is a nullable left operand whose rep has no `??` lowering — not "this is
  // not a map index get", which is what this said while the overwhelming majority of its
  // firings are a non-nullable operand. Those fold to the left operand in `emit_rewrite.vl`
  // and never reach the emitter as a `??` at all, so the message can finally name the actual residue.

  // A re-readable atom niche joining into a box is the null test it spells.
  const lhsIx = unwrapParen(e.binLeft)
  if (
    lhsIx >= 0
    && exprReReadable(lhsIx)
    && exprNulLitUnion(lhsIx, fnIx)
    && coalesceResultIsBox(exprIx, fnIx)
  ) {
    return emitExpr(coalNullTestIf(e, exprIx, fnIx), fnIx)
  }
  // A re-readable cell joining numbers of different types apart is the null test it spells,
  // typed at the instance's join when the shared `??` records only its hole (D9701).
  if lhsIx >= 0 && exprReReadable(lhsIx) {
    const nrt = coalResultTyOf(exprIx, fnIx)
    if numUnionMinted && tyHoldsNumbersApart(nrt) {
      const nIf = coalNullTestIf(e, exprIx, fnIx)
      nodeTyRecord(nIf, nrt)
      return emitExpr(nIf, fnIx)
    }
  }
  const armIf = coalNullArmIf(e, exprIx)
  if armIf >= 0 { return emitExpr(armIf, fnIx) }
  // A record union's shared `scalar | null` field reads as its box (D13280).
  const fk = coalBoxFieldScalarKind(lhsIx, fnIx)
  if fk >= 0 { return emitCoalesceBoxFieldScalar(e, exprIx, fk, fnIx) }
  // A re-readable list cell is the null test it spells, as an instance's is (D16483).
  const cell = if lhsIx >= 0 { nodeAt(lhsIx) } else { null }
  if cell is Index && exprReReadable(lhsIx) && !exprMap(cell.idxArr, fnIx) {
    return emitExpr(coalNullTestIf(e, exprIx, fnIx), fnIx)
  }
  return emitFail(
    "emitProgram: `??` over this nullable value is not supported yet — narrow it first, e.g. `if v != null { … }`",
  )
}

// The scalar atom kind of the `scalar | null` box the field read `lhsIx` yields, read off the
// box's own member set so a hole instance answers too; -1 for any other operand.
function coalBoxFieldScalarKind(lhsIx: i32, fnIx: i32): i32 {
  if lhsIx < 0 || !(nodeAt(lhsIx) is Member) || !exprUnion(lhsIx, fnIx) {
    return -1
  }
  const un = memberUnionFieldNameRead(lhsIx, fnIx)
  if un == "" && !sharedReadDeliversBox(lhsIx, fnIx) { return -1 }
  const sid = msSetOfTy(nodeTyAt(lhsIx, fnIx))
  if !setHasNullAtom(sid) { return -1 }
  const k = unionResidualSoloKindOfSet(sid)
  if nulBoxScalarValtype(k) < 0 || vbHeapIdxOfKind(k) < 0 { return -1 }
  return k
}

// Whether member read `memIx` is a shared-field dispatch whose arms each deliver their stored
// value-union box, so the read is a box although no one field row names its union.
function sharedReadDeliversBox(memIx: i32, fnIx: i32): boolean {
  const m = nodeAt(memIx)
  if !(m is Member) { return false }
  const vis: i32[] = []
  const fis: i32[] = []
  const code = sharedUnionFieldPlan(m.memObj, m.memProp, memIx, fnIx, vis, fis)
  return code == FC_UNION
    && !sharedFieldAnyArmBoxes(code, vis, fis)
    && sharedFieldPlanDispatchable(code, vis, fis)
}

// `f ?? d` over a field read `f` yielding a `scalar | null` box of atom kind `fk`: the box is
// read once, its tag decides, and the present arm unboxes and widens to the `??`'s own scalar.
function emitCoalesceBoxFieldScalar(
  e: BinExpr,
  exprIx: i32,
  fk: i32,
  fnIx: i32,
) {
  let rk = coalResultKindOf(exprIx, fnIx)
  if rk < 0 { rk = fk }
  if rk != fk && !coalWidens(fk, rk) {
    return emitFail(
      "emitProgram: `??` over a nullable value-box field has no conversion to its result",
    )
  }
  const slot = sharedFieldRecvSlot()
  if emitExpr(e.binLeft, fnIx) < 0 { return -1 }
  fbLocalSet(slot)
  fbLocalGet(slot)
  fbStructGet(uBoxIdx, 0) // field 0: tag
  fbI32Rel(RS_TAG, nullBoxTag())
  fbI32Bin(71) // 0x47 i32.ne — present?
  fbIf(nulBoxScalarValtype(rk))
  fbLocalGet(slot)
  fbStructGet(uBoxIdx, 1) // field 1: the payload anyref
  const vb = vbHeapIdxOfKind(fk)
  fbRefCast(vb)
  fbStructGet(vb, 0)
  if coalWidenUnboxed(fk, rk) < 0 { return -1 }
  fbElse()
  if emitExprAsKind(e.binRight, rk, fnIx) < 0 { return -1 }
  fbEnd()
  return 0
}

// `if c { d } else { a ?? d }` for `(if c { null } else { a }) ?? d`, and its mirror, which is
// what `?? d` means for an `if` with a `null` arm: the `??` moves onto the other arm, whose own
// rep an instance types, where the `if` keeps its generic `V | null` (D10130). Only a desugared
// `if` reaches here: a written one is already bound to a local. -1 otherwise.
function coalNullArmIf(e: BinExpr, exprIx: i32): i32 {
  if !coalNullArmShaped(e) { return -1 }
  const n = nodeAt(unwrapParen(e.binLeft))
  if !(n is IfStmt) { return -1 }
  const tv = coalSoleStmt(n.ifThen)
  const ev = coalSoleStmt(n.ifElse)
  if tv < 0 || ev < 0 { return -1 }
  const tNull = nodeAt(tv) is NullLit
  const pos = e.pos
  let live = tv
  if tNull { live = ev }
  const inner = mkBinary("??", live, e.binRight, pos)
  nodeTyCarry(inner, exprIx)
  const liveS: i32[] = []
  liveS.push(inner)
  const deadS: i32[] = []
  deadS.push(e.binRight)
  let thenB = mkBlock(liveS, pos)
  let elseB = mkBlock(deadS, pos)
  if tNull {
    thenB = mkBlock(deadS, pos)
    elseB = mkBlock(liveS, pos)
  }
  const ifIx = mkIf(n.ifCond, thenB, elseB, pos)
  nodeTyCarry(ifIx, exprIx)
  return ifIx
}

// How the write at `asgIx` of a record into an `R` or `R | null` place yields its value, where `R`
// is the record the value is built at: 1 by a re-read of the place (a field of a name), 2 by the
// cell its store parks (a list element), each short only of the null the cell admits; 0 neither.
function asgNonNullCell(asgIx: i32, fnIx: i32): i32 {
  const a = nodeAt(asgIx)
  if !(a is BinExpr) || a.binOp != "=" { return 0 }
  const tt = nodeTyAt(a.binLeft, fnIx)
  const vt = nodeTyAt(asgIx, fnIx)
  if tt < 0 || vt < 0 || !tyIsRecord(vt) { return 0 }
  // The place may read back narrowed past its `null`; the stored cell is the record either way.
  const inner = if tyBearsNull(tt) { nonNullTy(tt) } else { tt }
  if inner < 0 || !tyIsRecord(inner) { return 0 }
  const row = structRowOfRecordTy(inner)
  // A value with a row of its own is that record only when the row is the place's.
  const vRow = structRowOfRecordTy(vt)
  if row < 0 || (vRow >= 0 && vRow != row) { return 0 }
  const t = nodeAt(unwrapParen(a.binLeft))
  return match t {
    Member => if nodeAt(t.memObj) is Ident && !exprMap(t.memObj, fnIx) { 1 } else { 0 }
    Index => if !exprMap(t.idxArr, fnIx) && exprRefArray(t.idxArr, fnIx) { 2 } else { 0 }
    // A name's re-read is the re-read rung's; no other node is a place.
    Ident | NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => 0
  }
}

// Whether the write at `asgIx` stores a member of a boxed union into a list element or map entry of
// that union: its store parks the box, and the member's own value is the box's payload.
function asgYieldsBoxedArm(asgIx: i32, fnIx: i32): boolean {
  const a = nodeAt(asgIx)
  if !(a is BinExpr) || a.binOp != "=" { return false }
  const t = nodeAt(unwrapParen(a.binLeft))
  if !(t is Index) { return false }
  let tt = nodeTyAt(a.binLeft, fnIx)
  if exprMap(t.idxArr, fnIx) { tt = tyMapValOf(mapRecvTyIn(t.idxArr, fnIx)) }
  const vt = nodeTyAt(asgIx, fnIx)
  return tt >= 0 && vt >= 0 && isValueUnionBox(tt) && boxTagOfTy(vt) >= 0
}

// Whether the write at `asgIx` stores into a byte list, which keeps only the value's low byte.
function asgIsByteElem(asgIx: i32, fnIx: i32): boolean {
  const a = nodeAt(asgIx)
  if !(a is BinExpr) { return false }
  const t = nodeAt(unwrapParen(a.binLeft))
  return t is Index && exprU8Array(t.idxArr, fnIx)
}

// Whether the write at `asgIx` yields the cell it parks before its store: a list (not a map)
// element or a field whose type is the assignment's, so the stored cell is the value.
function asgYieldsParkedCell(asgIx: i32, fnIx: i32): boolean {
  const a = nodeAt(asgIx)
  if !(a is BinExpr) || a.binOp != "=" { return false }
  const t = nodeAt(unwrapParen(a.binLeft))
  if !(t is Index) && !(t is Member) { return false }
  // A map entry is stored at the map's value type; a read of it is that or null.
  let tt = nodeTyAt(a.binLeft, fnIx)
  if t is Index {
    if exprMap(t.idxArr, fnIx) { tt = tyMapValOf(mapRecvTyIn(t.idxArr, fnIx)) }
  }
  return tt >= 0 && tySame(tt, nodeTyAt(asgIx, fnIx))
}
