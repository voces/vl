// THE TYPE-NAME GRAMMAR'S LEAF — and this is the edge that never existed. `tyname.vl`'s
// own header has recorded since phase 1 that its nine importers are the import SET and not
// the set that NEEDS the grammar, naming this file as the tenth consumer: `emitIs` and
// `emitUnionLitIs` each hand-write the quoted-leaf test on an `IsExpr.isVariant` type name.
// A zero-import leaf is reachable from everywhere, so the edge cannot cycle — the missing
// consumer was a decision no one had taken, not a layering problem. Taken here (W3).
//
// `splitUnionAtoms` joins it: D-TYNAMEHOME phase 2 moved that body down to the leaf but
// this file was HELD, so its entry kept naming `./typecheck` and reached the leaf through
// that file's republishing line. The line is gone and the entry names the home. This file's
// three `splitUnionAtoms` call sites did not change and could not tell the difference.
import { nameIsQuotedLeaf, splitUnionAtoms } from "./tyname"
//
// Output representation: a VL `i32[]` of byte values 0..255. WasmGC has no `u8`,
// so `i32[]` is used (see docs/selfhost-gaps.md). Bytes are masked to the low
// 8 bits on emit (`& 0xff`).

// Fill the capture cache (emit_state `capStartTbl`/`capCountTbl`/`capNamesFlat`)
// with every lifted function's capture list — ONE walk per function, ever, where
// the on-demand recompute cost O(body) per QUERY (an identifier read in a
// capturing closure, a classifier probe of a captured name). Call exactly once
// per program, after the last AST-mutating pass (`emitProgram` clears the cache
// up front, so earlier phases use the direct walk).
export function capCacheBuild() {
  capStartTbl = []
  capCountTbl = []
  capNamesFlat = []
  let fe = 0
  while fe < fnStmts.length {
    const caps = capComputeNamesOf(fe)
    capStartTbl.push(capNamesFlat.length)
    capCountTbl.push(caps.length)
    let ci = 0
    while ci < caps.length {
      capNamesFlat.push(caps[ci])
      ci = ci + 1
    }
    fe = fe + 1
  }
  capCacheOn = true
  0
}

export function mvValsWrapOf(slot: i32) {
  if slot < 0 { return lTypeIdx }
  if mvValKind[slot] == 3 { return mkListIdx }
  if mvValKind[slot] == 11 {
    return fl64TypeIdx // f64-valued map: f64-list wrapper
  }
  if mvValKind[slot] == 13 {
    return fl32TypeIdx // f32-valued map: f32-list wrapper
  }
  if mvValKind[slot] == 10 {
    return il64TypeIdx // i64-valued map: i64-list wrapper
  }
  if mvRlSlot[slot] < 0 || mvRlSlot[slot] >= rlWrapIdx.length {
    emitFail("emitProgram: map value slot has no resolved vals wrapper")
    return 0
  }
  rlWrapIdx[mvRlSlot[slot]]
}

// The SCALAR element kind (11 f64 / 10 i64 — the `emitScalarValue`/`scalarListBlocktype`
// codes) of an mv map-value slot whose value is a non-i32 scalar, else -1 (a ref value —
// string/struct — which rides the nullable valStash + `ref.as_non_null`). The chokepoint
// the map get/set/push consult to branch scalar-store vs ref-store.
function mvScalarValKind(slot: i32): VKind | null {
  if slot < 0 { return null }
  if mvValKind[slot] == 11 { return "f64" }
  if mvValKind[slot] == 10 { return "i64" }
  if mvValKind[slot] == 13 { return "f32" }
  return null
}

// The WRAPPER struct heap type for a scalar element kind.
function scalarListWrap(elemKind: VKind) {
  if elemKind == "f64" { return fl64TypeIdx }
  if elemKind == "i64" { return il64TypeIdx }
  if elemKind == "f32" { return fl32TypeIdx }
  lTypeIdx
}

// The BACKING `(array (mut <elem>))` heap type for a scalar element kind.
function scalarListBack(elemKind: VKind) {
  if elemKind == "f64" { return fa64TypeIdx }
  if elemKind == "i64" { return ia64TypeIdx }
  if elemKind == "f32" { return fa32TypeIdx }
  aTypeIdx
}

// The `array.get` RESULT blocktype byte for a scalar element kind (i32 `0x7f`, f64 `0x7c`,
// i64 `0x7e`) — the value-typed-`if` rep a fused `?? d` read joins on.
function scalarListBlocktype(elemKind: VKind) {
  if elemKind == "f64" { return 124 }
  if elemKind == "i64" { return 126 }
  if elemKind == "f32" { return 125 }
  127
}

// Whether the module-global list types for a scalar element kind were collected (the
// loud-fail guard every list op shares).
function scalarListUsed(elemKind: VKind) {
  if elemKind == "f64" { return fa64Used }
  if elemKind == "i64" { return ia64Used }
  if elemKind == "f32" { return fa32Used }
  lUsed
}

// Emit `exprIx` COERCED to a scalar element kind's value rep — the f64/i64 widen of a
// narrower literal/`i32` so a list element / `?? d` default matches the backing element
// type. The i32 kind passes through unchanged (byte-identical to a bare `emitExpr`).
function emitScalarValue(body: i32[], exprIx: i32, fnIx: i32, elemKind: VKind) {
  if elemKind == "f64" { return emitExprAsF64(body, exprIx, fnIx) }
  if elemKind == "i64" { return emitExprAsI64(body, exprIx, fnIx) }
  if elemKind == "f32" { return emitExprAsF32(body, exprIx, fnIx) }
  emitExpr(body, exprIx, fnIx)
}

// The ref-list table SLOT of struct `si`'s ref-list field `fi`, or -1 if not a ref list.
export function sFieldRefSlot(si: i32, fi: i32) {
  // D5: the ARENA leg — the field's recorded element TYPE resolves the slot through
  // `repElemKey`, the key `rlInternName` interned the slot on. The recorded NAME stays
  // the fall-through: a row the sidecar does not cover (an unresolvable `#anonN`
  // element spelling), and `rlSlotByName`'s struct-twin rung, which has no arena input.
  const a = rlSlotOfTy(sFieldElemTyIxAt(si, fi))
  if a >= 0 { return a }
  // D-TWINROW: the recorded element type also feeds `rlSlotByName`'s struct-twin
  // rung, which until now had no arena input at all — it resolved a struct ROW from
  // a rendered element spelling on both sides. Rungs 1 and 2 of `rlSlotByName` still
  // run first; the hint only reaches rung 3.
  rlSlotByNameTy(sFieldElemNameAt(si, fi), sFieldElemTyIxAt(si, fi))
}

// THE FIELD-MAP CHOKEPOINT MOVED (B6b). `sFieldMapValSlot` / `uFieldMapValSlot` lived
// here and answered a mv SLOT off the field's VALUE column alone; the shape a map op
// actually threads is the (KEY, VALUE) pair, and the type SECTION (`emit_sections`) and
// the receiver classifier (`emit_classify.mapShapeOfExpr`) ask the same question from
// files this one cannot be imported into. The home is now
// `emit_classify.sFieldMapShape` / `uFieldMapShape`, which every one of the four sites
// calls — including the three below.

// Push the STORAGETYPE bytes (NOT the trailing mutability flag) for a struct / variant
// field whose wasm-type `code` is one of `0` i32, `3` string, `4` i32-list, `5` ref-list.
// Each array-typed field stores a non-null REF to the corresponding list wrapper struct
// (`0x64 <heap-type-index>`): `lTypeIdx` for `i32[]`, `rlTypeIdx` for a `T[]`/`N[]` ref
// list — exactly the wrappers the map's `keys`/`vals` fields already reference. The
// referenced wrapper types are interned in the SAME rec group (forced present by
// `collectA`), so the forward index resolves. Used by the type-section struct emission.
// For a ref-list field (code 5) `refSlot` is the field's per-element-type table slot
// (its wrapper is `rlWrapIdx[refSlot]`); ignored for other codes. Streams to the
// current target (`curBuf`) — the caller binds it at the type-section payload.
export function pushFieldStorage(code: i32, refSlot: i32) {
  if code == 3 {
    wU8(100) // 0x64 (ref ht) — non-null string ref
    wSLEB(aTypeIdx)
  } else if code == 4 {
    wU8(100) // 0x64 (ref ht) — non-null i32-list wrapper ref
    wSLEB(lTypeIdx)
  } else if code == 5 {
    // A missing element slot was previously CLAMPED to 0 — an out-of-bounds CRASH on an
    // empty ref-list table, a silently WRONG wrapper otherwise. Fail loudly instead (the
    // code-28 pattern): the element must have been interned before type-index assignment.
    if refSlot < 0 || refSlot >= rlWrapIdx.length {
      wU8(127)
      return emitFail(
        "emitProgram: ref-list field element type is not interned",
      )
    }
    wU8(100)                  // 0x64 (ref ht) — non-null ref-list wrapper ref
    wSLEB(rlWrapIdx[refSlot]) // THIS field's distinct ref-list wrapper (s33 heap type)
  } else if code == 6 {
    wU8(100) // 0x64 (ref ht) — non-null string-list wrapper ref
    wSLEB(mkListIdx)
  } else if code == 14 {
    wU8(100)            // 0x64 (ref ht) — non-null closure fat-pointer ref
    wSLEB(cloStructIdx) // the closure struct heap type (#306)
  } else if code == 15 {
    // A NESTED-STRUCT field: a NULLABLE ref to the target struct (`refSlot` is its
    // struct TABLE index here). Nullable storage serves both the plain (`inner: S`,
    // always written non-null) and the `S|null` field — and lets a recursive shape
    // (`next: Node|null`) terminate. Forward indices resolve in the shared rec group.
    // A slot that never resolved (an element name `structIndexByName` could not find)
    // fails loudly instead of trapping on an out-of-bounds `sHeapIdx` read (the code-5
    // discipline).
    if refSlot < 0 || refSlot >= sHeapIdx.length {
      wU8(127)
      return emitFail(
        "emitProgram: nested-struct field element type is not interned",
      )
    }
    wU8(99) // 0x63 (ref null ht)
    wSLEB(sHeapIdx[refSlot])
  } else if code == 16 {
    // A VALUE-UNION field (`y: string | i32`): a non-null ref to the shared
    // union box — a `null` MEMBER rides the box's tag, never a null field ref.
    // The box's heap index is a forward reference inside the shared rec group.
    wU8(100) // 0x64 (ref ht)
    wSLEB(uBoxIdx)
  } else if code == 17 {
    wU8(124) // 0x7c f64 storagetype
  } else if code == 23 {
    wU8(126) // 0x7e i64 storagetype
  } else if code == 24 {
    wU8(125) // 0x7d f32 storagetype
  } else if code == 25 {
    // An `f64[]` list field: a non-null ref to the f64-list WRAPPER (`$fl64TypeIdx`) — the scalar
    // analogue of code 4's `i32[]`→`$lTypeIdx`. The value builds it via the generic `emitExpr` path
    // (an f64 array literal lowers to this wrapper), the read indexes it via the checker's f64-list type.
    wU8(100) // 0x64 (ref ht)
    wSLEB(fl64TypeIdx)
  } else if code == 26 {
    // An `i64[]` list field: a non-null ref to the i64-list wrapper (`$il64TypeIdx`).
    wU8(100) // 0x64 (ref ht)
    wSLEB(il64TypeIdx)
  } else if code == 27 {
    // An `f32[]` list field: a non-null ref to the f32-list wrapper (`$fl32TypeIdx`).
    wU8(100) // 0x64 (ref ht)
    wSLEB(fl32TypeIdx)
  } else if code == 18 {
    // A NULLABLE i32-list field (`rest: i32[] | null`): the same wrapper as
    // code 4, with NULLABLE storage — the field genuinely carries null.
    wU8(99) // 0x63 (ref null ht)
    wSLEB(lTypeIdx)
  } else if isNulScalarListFieldCode(code) {
    // A NULLABLE DISTINCT-BACKING scalar-list field (`string[] | null` 31, `f64[] | null`
    // 32, `i64[] | null` 33, `f32[] | null` 34): the SAME leaf wrapper the non-null field
    // codes 6/25/26/27 reference, with NULLABLE storage — the distinct-backing dual of
    // code 18. The wrapper is a global SINGLETON per leaf (no per-field slot to resolve),
    // and the field pass forces its backing pair (`forceScalarListField` + the code-31
    // string-list arm), so the index always resolves.
    wU8(99) // 0x63 (ref null ht)
    wSLEB(nulScalarListFieldWrapHeap(code))
  } else if code == 28 {
    // A NULLABLE REF-LIST field (`S[] | null` / `(i32|null)[] | null`): a NULLABLE ref to the element's
    // ref-list wrapper — the ref-list analogue of code 18. `refSlot` is the element ref-list slot.
    if refSlot < 0 || refSlot >= rlWrapIdx.length {
      wU8(127)
      return emitFail(
        "emitProgram: nullable ref-list field element type is not interned",
      )
    }
    wU8(99) // 0x63 (ref null ht)
    wSLEB(rlWrapIdx[refSlot])
  } else if code == 19 {
    // A MAP-typed field (`children: {[string]: Tree}`): a non-null ref to the
    // value type's map struct (`refSlot` is the mv SLOT here; -1 = the mono
    // map). A recursive value (Tree → map → Tree) ties in the shared rec group.
    wU8(100) // 0x64 (ref ht)
    wSLEB(mapTypeIdxOf(refSlot))
  } else if code == 29 {
    // A NULLABLE map field (`links: {[string]: V} | null`): the same map struct as
    // code 19 with NULLABLE storage — the field genuinely carries null (the map
    // twin of the code-28 nullable ref-list field).
    wU8(99) // 0x63 (ref null ht)
    wSLEB(mapTypeIdxOf(refSlot))
  } else if code == 20 {
    // A `string | null` niche field: a NULLABLE ref to the raw string array (the
    // same backing as code 3, the nullability in the field's storage type).
    wU8(99) // 0x63 (ref null ht)
    wSLEB(aTypeIdx)
  } else if code == 22 {
    // A NULLABLE-closure field (`op: ((i32) => i32) | null`): a NULLABLE ref to the
    // closure fat-pointer struct (the same backing as code 14, nullable storage) —
    // `null` rides as `ref.null $cloStruct`, the field analogue of a kind-19 local.
    wU8(99) // 0x63 (ref null ht)
    wSLEB(cloStructIdx)
  } else {
    // code 21 (`boolean | null`, sentinel 2) and code 30 (`K | null`, sentinel -1)
    // share this default i32 storage.
    wU8(127) // 0x7f i32 storagetype
  }
  0
}

// Emit the NULL value of an OMITTED nullable field (`si`/`fi`, field code `scode`) in a
// struct literal — the completion coercion's per-rep null: a `string | null` field (20) is
// `ref.null $aTypeIdx`, a `boolean | null` field (21) the i32 sentinel 2, a nullable
// struct (15) `ref.null $S`, a nullable i32-list (18) `ref.null $lTypeIdx`, and a value/box
// union field (16) WITH a `null` member the null-tagged box. Returns 0, or -1 when the
// field is NOT nullable (the caller turns that into the missing-field error).
function emitOmittedFieldNull(_body: i32[], si: i32, fi: i32, scode: i32) {
  if scode == 20 {
    fbRefNull(aTypeIdx) // ref.null $aTypeIdx
    return 0
  }
  if scode == 21 {
    fbI32Const(2) // the boolean|null sentinel
    return 0
  }
  if scode == 30 {
    fbI32Const(0 - 1) // the K|null niche sentinel (member ids are >= 0)
    return 0
  }
  if scode == 15 {
    const tgt = sFieldTgtStructIdx(si, fi)
    if tgt < 0 { return -1 }
    fbRefNull(sHeapIdx[tgt]) // ref.null $S
    return 0
  }
  if scode == 18 {
    fbRefNull(lTypeIdx) // ref.null $lTypeIdx (i32[] | null)
    return 0
  }
  if isNulScalarListFieldCode(scode) {
    // A NULLABLE DISTINCT-BACKING scalar-list field omitted -> `ref.null $leafWrapper`
    // (codes 31/32/33/34 — the distinct-backing dual of code 18's `$lTypeIdx`).
    fbRefNull(nulScalarListFieldWrapHeap(scode))
    return 0
  }
  if scode == 28 {
    // A NULLABLE ref-list field omitted -> `ref.null $wrapper` (the element's ref-list wrapper).
    const rs28 = sFieldRefSlot(si, fi)
    if rs28 >= 0 && rs28 < rlWrapIdx.length {
      fbRefNull(rlWrapIdx[rs28])
      return 0
    }
    return -1
  }
  if scode == 22 {
    fbRefNull(cloStructIdx) // ref.null $cloStruct (a nullable-closure field, kind 19)
    return 0
  }
  if scode == 29 {
    // A NULLABLE map field omitted -> `ref.null $mapStruct` (the value type's map struct).
    fbRefNull(mapTypeIdxOf(sFieldMapShape(si, fi)))
    return 0
  }
  if scode == 16 {
    // A value/box-union field defaults to null ONLY when `null` is a member.
    // D-VALKIND: the member set resolved ONCE, then a KIND test over its banked
    // codes (`nullValKind()` — the box ABI's null code, not the lexeme).
    const fnm = sFieldElemNameAt(si, fi)
    if unionHasAtomK(msSetOfText(fnm), fnm, "null", nullValKind()) {
      fbI32Const(nullBoxTag())
      fbRefNullNone() // payload slot unread under the null tag
      fbStructNew(uBoxIdx)
      return 0
    }
    return -1
  }
  -1
}

// Lower an object literal `{ f: v, ... }` onto `body`: resolve WHICH struct the
// literal's field-name set names, push each field's value IN THAT STRUCT'S DECLARED
// FIELD ORDER, then `struct.new $<heapIdx>` (`0xfb 0x00 <heapIdx>`). The literal must
// match exactly one struct's fields, EXCEPT a nullable field may be omitted (the
// completion coercion — it is materialized as `null` via `emitOmittedFieldNull`).
function emitObj(body: i32[], objIx: i32, fnIx: i32) {
  if !sDeclared {
    return emitFail("emitProgram: object literal but no struct type declared")
  }
  const o = P.nodes[objIx]
  if o is ObjLit {
    // An EXPECTED struct index from the binding/argument site (`pendingStructIdx`) wins
    // over the field-name match: a struct-typed call argument must be the callee
    // parameter's type even when another struct shares its field names. Consume the hint
    // (reset to -1) so a nested literal value falls back to inference.
    let si = pendingStructIdx
    pendingStructIdx = -1
    if si < 0 { si = structIndexOfObjCtx(objIx, fnIx) }
    if si < 0 {
      return emitFail(
        "emitProgram: object literal field count does not match struct",
      )
    }
    const cnt = sFieldCount[si]
    let fi = 0
    while fi < cnt {
      const valIx = objFieldVal(objIx, sFieldNames[sFieldStart[si] + fi])
      const scode = sFieldTypeAt(si, fi)
      if valIx < 0 {
        // COMPLETION COERCION: a NULLABLE field omitted from the literal is materialized
        // as `null` (the checker `assignableExpr` already permitted the omission). A
        // non-nullable omitted field is still an error.
        if emitOmittedFieldNull(body, si, fi, scode) < 0 {
          return emitFail(
            "emitProgram: object literal is missing a struct field",
          )
        }
        fi = fi + 1
        continue
      }
      // A nested struct VALUE is allowed for a nested-struct field (code 15) and for a
      // BOX-union field (code 16) — the latter boxes the struct as a variant via
      // `emitUnionCoerce` (`{ v: { a: 7 } }` against `{ v: A | B }`). Any OTHER field type
      // receiving a struct value is unsupported.
      if scode != 15 && scode != 16 {
        if exprStruct(valIx, fnIx) {
          return emitFail("emitProgram: nested struct fields are not supported")
        }
      }
      // A CLOSURE field (code 14) receiving a LIST literal (`{f: [() => (265)]}` — a
      // closure-ARRAY field whose literal-side shape intern mis-coded the field as a
      // bare closure): the built list WRAPPER cannot store into the `(ref $cloStruct)`
      // slot — reject loudly (the binding-position spelling of the same lambda shape
      // already rejects "ref valtype with no interned shape"; fuzz-nightly seed
      // 614405057 d6, `{f: (i32) => {f: (() => i32)[]}}`).
      if scode == 14 {
        const cav = P.nodes[unwrapParen(valIx)]
        if cav is ArrayLit {
          return emitFail(
            "emitProgram: a closure-array struct-field literal is not supported",
          )
        }
      }
      // The INVERSE mis-resolution: a LAMBDA field value flowing into a NON-closure
      // field slot (`{f: () => ({f: 9})}` resolved to a same-field-name-set sibling
      // shape whose `f` codes i32/i64 — the nested-lambda literal's own `{f: 9}`
      // interns a colliding `{f}` shape): the closure ref cannot store there —
      // reject loudly (fuzz-nightly seed 4797042 d5; the named-fn and plain-binding
      // spellings of the same shape lower fully).
      if scode != 14 && scode != 22 && scode != 16 {
        // (Code 16 excluded: a lambda into a closure-ARM union-box field is
        // legitimate — `emitUnionCoerce` boxes it with the arm's tag.)
        const cfv = P.nodes[unwrapParen(valIx)]
        if cfv is FuncDecl {
          return emitFail(
            "emitProgram: a lambda field value resolved to a non-closure field slot",
          )
        }
      }
      // A ref-list field (`code 5`: `T[]`/`N[]`) whose value is an EMPTY `[]` literal
      // needs the element kind to build a REF-list (not an i32-list) wrapper — the same
      // way a `let xs: T[] = []` annotation threads `pendingListKind`. The element kind
      // is global (union box `2` when a union is declared, else a struct `1`).
      pendingListKind = 0
      pendingListSlot = 0
      pendingNulRefHeap = -1
      if scode == 5 {
        let fslot = sFieldRefSlot(si, fi)
        if fslot < 0 { fslot = 0 }
        // A ref-list field whose ELEMENT type never interned a slot (its slot resolves
        // out of the parallel `rl*` tables) — an UNSUPPORTED element (e.g. a struct
        // carrying a nullable-LIST field: `{a: {z: f64[] | null}[]}`, whose element
        // struct is rejected as an array element in every other position too). The type
        // section already recorded the loud "ref-list field element type is not interned"
        // (`pushFieldStorage`), but `emitFail` does not halt, so codegen reached here and
        // read `rlElemKindTbl` OUT OF BOUNDS — a COMPILER CRASH (`out of bounds array
        // access`) instead of a clean reject. Guard the parallel-table read (the
        // `pushFieldStorage` / `mapTypeIdxOf` "fbValtype" discipline: never trap the
        // compiler on an un-interned slot). fuzz sweep zq0NPY multiobs, seed 24438928.
        if fslot >= rlElemKindTbl.length {
          return emitFail(
            "emitProgram: ref-list field element type is not interned",
          )
        }
        pendingListSlot = fslot
        if rlElemKindTbl[fslot] == 2 {
          pendingListKind = 2
        } else if rlElemKindTbl[fslot] == 1 {
          pendingListKind = 1
        } else {
          // A NESTED-element ref-list field (element kind 9 a nested ref array, or a scalar-2D inner): the
          // value is a ref list built THROUGH this slot, like a `<ref-array>[]` local binding
          // (`pendingListKind` 5). `pendingListKind` 1 (struct) mis-built array elements as structs →
          // invalid wasm (the construct-side hole for `{f: (i32|null)[][]}` / `{f: {g:i32}[][]}`).
          pendingListKind = 5
        }
      } else if scode == 6 {
        pendingListKind = 3
      } else if scode == 25 {
        pendingListKind = 4 // f64[] field — coerce the value's elements to f64 (`emitArr`)
      } else if scode == 26 {
        pendingListKind = 6 // i64[] field — widen bare-int elements to i64
      } else if scode == 27 {
        pendingListKind = 7 // f32[] field — re-encode float elements at f32
      } else if scode == 18 {
        // A NULLABLE i32-list field value is an i32 list (subtypes the nullable slot) OR a
        // bare `null` -> `ref.null $lTypeIdx` (the `pendingNulRefHeap` seed; a list ignores it).
        pendingNulRefHeap = lTypeIdx
      } else if isNulScalarListFieldCode(scode) {
        // A NULLABLE DISTINCT-BACKING scalar-list field (codes 31/32/33/34): a list-literal
        // value builds the LEAF list (`pendingListKind` 3/4/6/7 — the same element coercion
        // the non-null codes 6/25/26/27 seed, so `{f: [1, 2]}` of `{f: i64[] | null}` widens
        // its bare ints to i64), and its non-null wrapper ref subtypes the nullable slot.
        pendingListKind = nulScalarListBuildKind(nulScalarListCodeKind(scode))
        // The #964 SEED-LEAK gate — stated in full at the code-28 arm just below. Witness
        // here: `{f: [null]}`, whose element would type as `ref.null $wrapper`.
        const nslV = P.nodes[unwrapParen(valIx)]
        if nslV is NullLit {
          pendingNulRefHeap = nulScalarListFieldWrapHeap(scode)
        }
      } else if scode == 28 {
        // A NULLABLE ref-list field value is a list (build it THROUGH the element slot, like code 5) OR a
        // bare `null` -> `ref.null $wrapper` (the `pendingNulRefHeap` seed; a list value ignores it).
        let fslot28 = sFieldRefSlot(si, fi)
        if fslot28 < 0 { fslot28 = 0 }
        pendingListSlot = fslot28
        if rlElemKindTbl[fslot28] == 2 { pendingListKind = 2 }
        else if rlElemKindTbl[fslot28] == 1 { pendingListKind = 1 }
        else { pendingListKind = 5 }
        // THE #964 SEED-LEAK DISCIPLINE — every nullable-ref-array boundary in this file
        // (field here, binding, return, argument, and the array-ELEMENT seeds in `emitArr`)
        // repeats this gate, and each one was a separate INVALID-WASM bug before it did.
        // A WHOLE-VALUE wrapper-heap seed must be GATED on the value being a bare `null`.
        // Un-gated it survives into the array literal's ELEMENT context, where the null
        // elements CONSUME it and store `ref.null $wrapper` into an element backing that
        // holds `ref.null $elem` — invalid wasm. A `{f: null}` whole-field null is the
        // wrapper; a `{f: [null]}` list literal's nulls take the per-element seed
        // (`pendingStructIdx` / the nullable-element arm in `emitArr`) instead.
        // Witness here: `{f: [null]}` of `{f: (S | null)[] | null}` (#964, #1020).
        if fslot28 < rlWrapIdx.length {
          const nraF = P.nodes[unwrapParen(valIx)]
          if nraF is NullLit { pendingNulRefHeap = rlWrapIdx[fslot28] }
        }
      } else if scode == 29 {
        // A NULLABLE map field value is a map ref (subtypes the nullable slot), a `Map()`
        // constructor (build THIS field's value-typed map struct — the `pendingMapSlot`
        // seed, as code 19), or a bare `null` -> `ref.null $mapStruct` (`pendingNulRefHeap`).
        const mslot29 = sFieldMapShape(si, fi)
        pendingMapSlot = mslot29
        pendingNulRefHeap = mapTypeIdxOf(mslot29)
      }
      // A NESTED-STRUCT field (code 15) seeds the TARGET struct so its literal
      // builds that struct (not a field-shape guess) and a bare `null` value
      // lowers as `ref.null $S`. Saved/restored around the field's own emit.
      const savedPSI = pendingStructIdx
      if scode == 15 { pendingStructIdx = sFieldTgtStructIdx(si, fi) }
      // A MAP-typed field (code 19) seeds `pendingMapSlot` so a `Map()` field
      // value constructs THIS field's value-typed map struct (not the mono map).
      if scode == 19 { pendingMapSlot = sFieldMapShape(si, fi) }
      // A VALUE-UNION field (code 16) coerces a raw scalar/string/null value into
      // the box (`{ y: 5 }` against `{ y: string | i32 }` boxes the 5 with its
      // atom tag); a union-valued field expression passes through unchanged.
      if scode == 16 {
        if emitUnionCoerce(body, sFieldElemNameAt(si, fi), valIx, fnIx) < 0 {
          return -1
        }
      } else if scode == 17 {
        // An f64 field widens its value at the construction boundary (an int
        // literal into `x: f64` re-encodes; an f64 expression passes through).
        if emitExprAsF64(body, valIx, fnIx) < 0 { return -1 }
      } else if scode == 23 {
        // An i64 field widens a bare-int literal to i64 at the construction boundary.
        if emitExprAsI64(body, valIx, fnIx) < 0 { return -1 }
      } else if scode == 24 {
        // An f32 field re-encodes its float value at the construction boundary.
        if emitExprAsF32(body, valIx, fnIx) < 0 { return -1 }
      } else if scode == 20 && exprIsLitAtom(valIx, fnIx) {
        // A literal-union ATOM stored into a `string | null` field widens to its member string,
        // exactly as the code-3 plain-`string` field below does. "Pass a non-null value through
        // untouched" (the arm just after) holds for a value that is ALREADY a string reference;
        // an atom's rep is an i32 id, so it is the one non-null value that needs converting.
        if emitStrValue(body, valIx, fnIx) < 0 { return -1 }
      } else if scode == 20 {
        // The NICHE `X | null` fields (20 string, 21 boolean, 30 `K`, 22 closure) seed the
        // null rep their kind demands — the table at `emitNullLitNode` — and pass a non-null
        // value through untouched.
        const svNS = pendingNulString
        pendingNulString = true
        const rcNS = emitExpr(body, valIx, fnIx)
        pendingNulString = svNS
        if rcNS < 0 { return -1 }
      } else if scode == 21 {
        const svNB = pendingNulBool
        pendingNulBool = true
        const rcNB = emitExpr(body, valIx, fnIx)
        pendingNulBool = svNB
        if rcNB < 0 { return -1 }
      } else if scode == 30 {
        // Code 30 is DUAL-natured: a member literal lowers as its interned atom id (the
        // atom context) and only a `null` takes the sentinel — so it seeds BOTH.
        const nluCtx = expCtxHere()
        nluCtx.litUnion = 1
        nluCtx.nulLitUnion = true
        if emitExprExpect(body, valIx, fnIx, nluCtx) < 0 { return -1 }
      } else if scode == 22 {
        // A function value passes through as the non-null fat pointer (widened to the
        // nullable storage on `struct.new`).
        const svNC = pendingNulClosure
        pendingNulClosure = true
        const rcNC = emitExpr(body, valIx, fnIx)
        pendingNulClosure = svNC
        if rcNC < 0 { return -1 }
      } else if scode == 3 && exprIsLitAtom(valIx, fnIx) {
        // A literal-union atom in a `string` field (code 3) widens to its member string.
        if emitAtomToStr(body, valIx, fnIx) < 0 { return -1 }
      } else if sFieldIsLitUnion(si, fi) {
        // A literal-union atom FIELD (`{ kind: "b" }`): the member literal lowers as its atom id.
        const fluCtx = expCtxHere()
        fluCtx.litUnion = 1
        if emitExprExpect(body, valIx, fnIx, fluCtx) < 0 { return -1 }
      } else if sFieldIsLitUnionArray(si, fi) {
        // An ATOM-ARRAY field (`f: K[]`, code 4): the value is the i32 LIST of atom ids —
        // the atom context routes the literal to the i32-list build (its member elements
        // are string exprs syntactically, which would else build a string list whose
        // wrapper ref mismatches the field's `$lTypeIdx`) and lowers each as its id.
        const flaCtx = expCtxHere()
        flaCtx.litUnion = 1
        if emitExprExpect(body, valIx, fnIx, flaCtx) < 0 { return -1 }
      } else {
        if emitExpr(body, valIx, fnIx) < 0 { return -1 }
      }
      if scode == 15 { pendingStructIdx = savedPSI }
      if scode == 19 {
        pendingMapSlot = -1 // a non-`Map()` value never consumed it
      }
      pendingListKind = 0
      fi = fi + 1
    }
    fbStructNew(sHeapIdx[si]) // 0xfb 0x00 <heap-type index>
    return 0
  }
  emitFail("emitProgram: expected an object literal")
}

// Does `name` appear as a VALUE — any position OTHER than the callee of a direct `name(...)`
// call — anywhere in the subtree at `ix`? A generic function value bound to `name` (`const g
// = f`) is sound to emit only when every use is a direct call: `monomorphize` rewrites each
// `g(args)` to its per-call instance, so the stored closure is called only at the type
// its slot was pinned to. A value-USE (an argument, a return, an array element) escapes to a
// a call whose type the binding cannot guarantee. Mirrors `monoWalk`'s node coverage.
function nameUsedAsValueIn(name: string, ix: i32) {
  if ix < 0 { return false }
  const n = P.nodes[ix]
  if n is Ident { return n.identName == name }
  if n is Call {
    const callee = P.nodes[n.callFn]
    let direct = false
    if callee is Ident {
      if callee.identName == name { direct = true }
    }
    if !direct {
      if nameUsedAsValueIn(name, n.callFn) { return true }
    }
    const args = n.callArgs
    let i = 0
    while i < args.length {
      if nameUsedAsValueIn(name, args[i]) { return true }
      i = i + 1
    }
    return false
  }
  if n is Block {
    const bs = n.blkStmts
    let i2 = 0
    while i2 < bs.length {
      if nameUsedAsValueIn(name, bs[i2]) { return true }
      i2 = i2 + 1
    }
    return false
  }
  if n is LetDecl { return nameUsedAsValueIn(name, n.letInit) }
  if n is IfStmt {
    if nameUsedAsValueIn(name, n.ifCond) { return true }
    if nameUsedAsValueIn(name, n.ifThen) { return true }
    return nameUsedAsValueIn(name, n.ifElse)
  }
  if n is WhileStmt {
    if nameUsedAsValueIn(name, n.whileCond) { return true }
    return nameUsedAsValueIn(name, n.whileBody)
  }
  if n is ForRange {
    if nameUsedAsValueIn(name, n.frFrom) { return true }
    if nameUsedAsValueIn(name, n.frTo) { return true }
    if nameUsedAsValueIn(name, n.frStep) { return true }
    return nameUsedAsValueIn(name, n.frBody)
  }
  if n is ForIn {
    if nameUsedAsValueIn(name, n.fiIter) { return true }
    return nameUsedAsValueIn(name, n.fiBody)
  }
  if n is RetStmt { return nameUsedAsValueIn(name, n.retArg) }
  if n is BinExpr {
    if nameUsedAsValueIn(name, n.binLeft) { return true }
    return nameUsedAsValueIn(name, n.binRight)
  }
  if n is Unary { return nameUsedAsValueIn(name, n.unArg) }
  if n is Paren { return nameUsedAsValueIn(name, n.parInner) }
  if n is Member { return nameUsedAsValueIn(name, n.memObj) }
  if n is OptMember { return nameUsedAsValueIn(name, n.omObj) }
  if n is Index {
    if nameUsedAsValueIn(name, n.idxArr) { return true }
    return nameUsedAsValueIn(name, n.idxIndex)
  }
  if n is IsExpr { return nameUsedAsValueIn(name, n.isObj) }
  if n is AsExpr { return nameUsedAsValueIn(name, n.asObj) }
  if n is ArrayLit {
    const es = n.arrElems
    let i3 = 0
    while i3 < es.length {
      if nameUsedAsValueIn(name, es[i3]) { return true }
      i3 = i3 + 1
    }
    return false
  }
  if n is ObjLit {
    const fs = n.objFields
    let i4 = 0
    while i4 < fs.length {
      const f = P.nodes[fs[i4]]
      if f is FieldInit {
        if nameUsedAsValueIn(name, f.fiValue) { return true }
      }
      i4 = i4 + 1
    }
    return false
  }
  false
}

// ── function-value construction (lambdas) ─────────────────────────────────────
// Emit a function VALUE for the lifted function at `fnStmts` position `fe`: the closure
// fat-pointer `struct.new $cloStruct [ env, id ]`. The env is
// `ref.null struct` for a non-capturing function, else a `struct.new $envStruct` of the
// captured values, each READ in the enclosing frame `fnIx` (so a capture of `n` emits a
// `local.get` of `n` in the maker's frame). The id is the lifted function's wasm index
// (`gImports + fe`) — the `==` identity token. Mirrors the host's `closureValue`.
function emitClosureValue(body: i32[], fe: i32, fnIx: i32) {
  // SOUNDNESS FLOOR: a GENERIC function (un-annotated parameters) taken as a VALUE emits its
  // params at the i32 DEFAULT (`vtKindOfParam(-1)` → 0), so the value is only callable at i32 —
  // `g(2.5, …)` / `g("x", …)` then `call_indirect`s at the wrong functype (a signature-check
  // trap), and even the i32 case only "works" by coincidence. A function VALUE must be
  // monomorphic.
  // A `const g = f` used ONLY as a direct-call callee IS sound (each `g(args)` is monomorphized
  // per call site, so the closure is called only at the type its slot was pinned to) and
  // routes through `emitClosureValueCore` directly (the LetDecl emit), skipping this floor.
  // Every OTHER value-use (argument, return, array element) escapes to a call whose type
  // the binding cannot guarantee, and lands here: reject (annotate the parameters, or call it
  // directly by name). NAMED source functions only — a lifted LAMBDA with un-annotated params is
  // either checker-rejected (a bare uninferable binding) or cloned/contextually-pinned per use
  // (a `.map`/`.filter` callback), so its i32 default is sound; `criFnIsAnonLambda` excludes it.
  if fnHasUnannotatedParam(fe) {
    if !criFnIsAnonLambda(fe) { return emitFail(genericFnValueRejectMsg(fe)) }
  }
  // A `<T>` TEMPLATE reaches here already resolved or not at all, so it needs no arm of its own:
  // an un-instantiated one is replaced by the monomorphizer's PRUNE (a no-arg void stub) before
  // emit, and an exported one is rejected earlier still by the export-signature floor. What that
  // leaves — a `<T>` whose boundary bindings CONTRADICT each other, which then reaches a call
  // through the stub — is a hole in the CHECKER (`genericFnAssignable` accepts `pairT<T>(a: T,
  // b: T)` at `(i32, string) => i32`), not one this floor can see.
  return emitClosureValueCore(body, fe, fnIx)
}

// The value-floor reject text for the generic function at lifted position `fe`. It NAMES the three
// things the user needs and the bare "annotate them" did not carry: which function, which of its
// parameters are the holes, and — from `monoPinnedSigsOf` — the concrete signatures the program's
// OWN call sites already pin it at. That last part is the annotation to write, read out of the
// instances monomorphization built rather than left for the reader to reconstruct; with no call
// site there is no inferred signature to offer and the message says so instead of implying one.
function genericFnValueRejectMsg(fe: i32) {
  let nm = "<anonymous>"
  let holes = ""
  let nHoles = 0
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if fn.fnName != "" { nm = fn.fnName }
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param {
        if p.parType < 0 {
          if holes != "" { holes = holes + ", " }
          holes = holes + "`" + p.parName + "`"
          nHoles = nHoles + 1
        }
      }
      i = i + 1
    }
  }
  let head = "emitProgram: cannot take the generic function `" +
    nm +
    "` as a value — a function value carries ONE signature, and "
  if nHoles == 1 {
    head = head +
      "parameter " +
      holes +
      " is un-annotated (it would default to i32). "
  } else {
    head = head +
      "parameters " +
      holes +
      " are un-annotated (they would default to i32). "
  }
  const sigs = monoPinnedSigsOf(fe)
  if sigs == "" {
    return head +
      "No call site pins `" +
      nm +
      "`, so there is no inferred signature to adopt — annotate the parameter" +
      pluralS(nHoles) +
      ", or call `" +
      nm +
      "` directly by name"
  }
  head +
    "Call sites pin `" +
    nm +
    "` at " +
    sigs +
    " — annotate the parameter" +
    pluralS(nHoles) +
    " with the signature this value needs, or call `" +
    nm +
    "` directly by name"
}

// `"s"` for a plural count, `""` for exactly one — the diagnostic's own agreement, kept out of the
// message builder so the two branches cannot disagree about it.
function pluralS(n: i32) {
  if n == 1 { return "" }
  "s"
}

// The closure-value emission WITHOUT the un-annotated-param floor — the `cloSigKeyExt`
// representability floor still applies (even a sound direct-call-only binding is called through
// its `$fnsig`, so that env-leading signature must be representable). Reached either through `emitClosureValue`
// (after its floor) or directly from the binding emit for a monomorphized direct-call-only alias —
// the local one here (`emitLetDeclStmt`) and the module-level one in `emit_sections.vl`, which
// gates on `monoGenericAliasFe` instead.
export function emitClosureValueCore(body: i32[], fe: i32, fnIx: i32) {
  if fe < 0 || fe >= fnStmts.length {
    return emitFail("emitProgram: function value with no lifted function")
  }
  // SOUNDNESS FLOOR: a function whose env-leading signature is not representable as a
  // closure `$fnsig` (`cloSigKeyExt` returns "" — a nullable-ref or map PARAMETER/result;
  // i64/f32 are now in the ABI) cannot be soundly called as a value: the call site would
  // fall back to the all-i32 arity functype and `call_indirect` at the WRONG type,
  // trapping the engine's signature check. Reject at the value site with a clear, source-located
  // message instead of emitting invalid wasm (mirrors the inferred-union-return floor).
  if cloSigKeyExt(fe) == "" {
    return emitFail(
      "emitProgram: a function value's signature is not yet supported — a function " +
        "value may not take a nullable or map parameter (or return one); annotate and " +
        "call it as a named function instead",
    )
  }
  // field 0: the env. Non-capturing → null; capturing → a fresh env struct.
  const envIdx = fnEnvIdxOf(fe)
  if envIdx < 0 {
    fbRefNullStruct()
  } else {
    const caps = captureNamesOf(fe)
    let ci = 0
    while ci < caps.length {
      // Read each captured variable in the ENCLOSING frame. The capture's value is its
      // current local/param/global value at the point the closure is created.
      if emitCaptureRead(body, caps[ci], fnIx) < 0 { return -1 }
      ci = ci + 1
    }
    fbStructNew(envIdx)
  }
  // field 1: the lifted function's wasm index — the `==` identity token and the
  // `call_indirect` operand (imports occupy 0..gImports-1).
  fbI32Const(gImports + fe)
  fbStructNew(cloStructIdx)
  0
}

// The rep recovery an env-field READ owes after its `struct.get` — the capture twin of the
// param/local and module-global read rules, and decided by `captureValKind`, THE function that
// chose the field's type, so the recovery cannot disagree with the field it recovers from.
//
// A `string | null` (kind 16) field is a `(ref null $array)` cell whose read must recover the
// non-null value type the rest of codegen expects — exactly what `paramNulString` /
// `declaredNulString` buy a local and `globalCellKind == "nulstr"` buys a global. Without it a
// `!= null`-narrowed capture returned `(ref null $array)` where the closure's own `(ref
// $array)` result was declared: invalid wasm with `vl check` rc 0. The
// `pendingRawNullRead` / `pendingNulString` gates are those two sites' verbatim, so the
// `!= null` test itself and a genuinely-nullable read still see the raw cell.
//
// The other nullable cells deliberately recover NOTHING here, because they recover nothing on
// the local and global paths either: a nullable LIST (kind 15/18) and a nullable STRUCT (kind
// 9) keep nullable reads and the USE site (`emitMem`, the index path) recovers.
function emitCapturedReadRecover(fe: i32, name: string) {
  if captureValKind(fe, name) == "nulstr" {
    if !nulStrReadStaysRaw() {
      fbRefAsNonNull() // 0xd4 ref.as_non_null
    }
  }
  0
}

// If `name` is a CAPTURED variable of the capturing lifted function currently being
// emitted (`fnIx`), emit a read of it from the env struct and return 1; else return 0
// (the caller falls through to the normal param/local/global path). The env rides as
// the leading `structref` param at local 0; recover the concrete env struct with
// `ref.cast`, then `struct.get` the field at the capture's index. Mirrors the host's
// captured-Name lowering.
//
// `recover` asks for the field's REP RECOVERY (`emitCapturedReadRecover`) — true for a value
// READ, false for the env-to-env COPY that builds a nested closure's frame. That copy's
// destination field is the SAME cell, so recovering there would `ref.as_non_null` a
// legitimately-null capture on its way into the next env and TRAP; `emitCaptureRead`'s local
// and global legs are raw for exactly that reason.
function emitCapturedRead(
  _body: i32[],
  name: string,
  fnIx: i32,
  recover: boolean,
) {
  if fnIx < 0 { return 0 }
  if !fnValUsed { return 0 }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return 0 }
  const envIdx = fnEnvIdxOf(fe)
  if envIdx < 0 { return 0 }
  // This runs per IDENTIFIER READ in a capturing closure — scan the capture
  // cache's flat slice in place (no per-read array build).
  if capCacheOn && fe < capCountTbl.length {
    const start = capStartTbl[fe]
    const cnt = capCountTbl[fe]
    let fi = 0
    while fi < cnt {
      if capNamesFlat[start + fi] == name {
        // (ref.cast (ref $env) (local.get 0)) then struct.get $env fi.
        fbLocalGet(0)     // the leading env param (structref)
        fbRefCast(envIdx) // 0xfb 0x16 <env heap> ref.cast — narrow to this env
        fbStructGet(envIdx, fi)
        if recover { emitCapturedReadRecover(fe, name) }
        return 1
      }
      fi = fi + 1
    }
    return 0
  }
  const caps = captureNamesOf(fe)
  let ci = 0
  while ci < caps.length {
    if caps[ci] == name {
      // (ref.cast (ref $env) (local.get 0)) then struct.get $env ci.
      fbLocalGet(0)     // the leading env param (structref)
      fbRefCast(envIdx) // 0xfb 0x16 <env heap> ref.cast — narrow to this env
      fbStructGet(envIdx, ci)
      if recover { emitCapturedReadRecover(fe, name) }
      return 1
    }
    ci = ci + 1
  }
  0
}

// Read a captured variable `name` in the enclosing frame `fnIx` for the env struct
// build. A param/local is a `local.get`; a module global a `global.get`; a TRANSITIVE
// capture — the enclosing frame is itself a lifted closure that re-captures `name`
// from ITS parent — reads the enclosing frame's own env (`emitCapturedRead`), so the
// value flows env-to-env down any nesting depth. (Captures of globals/top-level
// functions are excluded by capture analysis, so this only sees params/locals of the
// maker or the maker's own captures.)
function emitCaptureRead(_body: i32[], name: string, fnIx: i32) {
  const idx = localIndexOf(fnIx, name)
  if idx >= 0 {
    fbLocalGet(idx)
    return 0
  }
  const gIdx = globalIndexOf(name)
  if gIdx >= 0 { return emitUserGlobalGet(gIdx) }
  if emitCapturedRead(_body, name, fnIx, false) == 1 { return 0 }
  // A NUMERIC-OPCODE INTRINSIC name reaching capture resolution: capture analysis records
  // every free identifier that is not bound locally, a module global or a collected
  // function, and an intrinsic is none of those — so its NAME rides the capture list and
  // there is nothing to read it from. The same is true of `__load_i32__` and the rest of
  // the declared-but-not-collected family. Name the real problem rather than a variable the
  // author never wrote. (Reached only on the already-failing path: a local / global /
  // transitive capture of the same name resolved above.)
  if isNumIntrinsicName(name) {
    return emitFail(
      "emitProgram: the numeric intrinsic '" +
        name +
        "' is mistaken for a captured variable here — it is not yet callable from a lambda, nor from a named function in a module that uses function values",
    )
  }
  emitFail("emitProgram: captured variable not found in enclosing frame")
}

// ── union value construction + discrimination + narrowing (G1) ────────────────

// Lower the VARIANT-PAYLOAD struct for an object literal `{ f: v, … }` matching union
// variant `vi`: push each field value in the variant's DECLARATION field order, then
// `struct.new $<uVarHeap[vi]>`. (No box yet — `emitUnionBox` wraps this.)
function emitVariantStruct(body: i32[], objIx: i32, vi: i32, fnIx: i32) {
  const start = uFieldStart[vi]
  const cnt = uFieldCount[vi]
  let fj = 0
  while fj < cnt {
    const valIx = objFieldVal(objIx, uFieldNames[start + fj])
    if valIx < 0 {
      return emitFail(
        "emitProgram: object literal is missing a union-variant field",
      )
    }
    // An empty `[]` literal for a ref-list (code 5) / string-list (code 6) variant field
    // needs its element kind threaded (the same `pendingListKind` an annotated `let`
    // uses): a struct/union ref list (1/2), a string list (3), or a scalar-element list
    // (4/6/7 — its elements coerce to f64 / widen to i64 / re-encode at f32 in `emitArr`).
    pendingListKind = 0
    pendingListSlot = 0
    pendingNulRefHeap = -1
    const vcode = variantFieldTypeAt(vi, fj)
    // The `emitObj` closure-field floor (a LAMBDA value into a NON-closure field slot),
    // MIRRORED for the variant-box path: a lambda-result struct whose fieldset collides
    // with a value-union's STRUCT arm (`() => {f: () => {f: string} | string}` — the outer
    // `{f: <closure>}` shares the fieldset `{f}` with the `{f: string}` arm and, un-interned
    // as its own struct, routes here as that arm) would store the closure ref into a
    // string/scalar variant field — invalid wasm. Reject loudly; the deferred same-fieldset
    // twin-matcher composition (the named-fn spelling lowers fully). Codes 14/22 are the
    // closure / closure-array field slots, 16 the closure-ARM union-box field.
    const vcfv = P.nodes[unwrapParen(valIx)]
    if vcfv is FuncDecl {
      if vcode != 14 && vcode != 22 && vcode != 16 {
        return emitFail(
          "emitProgram: a lambda field value resolved to a non-closure variant field slot",
        )
      }
    }
    if vcode == 5 {
      let vslot = variantFieldRefSlot(vi, fj)
      if vslot < 0 { vslot = 0 }
      pendingListSlot = vslot
      if rlElemKindTbl[vslot] == 2 {
        pendingListKind = 2
      } else {
        pendingListKind = 1
      }
    } else if vcode == 18 {
      // A NULLABLE i32-list variant field: a bare `null` -> `ref.null $lTypeIdx`
      // (the `pendingNulRefHeap` seed; a list value ignores it) — the emitObj discipline.
      pendingNulRefHeap = lTypeIdx
    } else if vcode == 28 {
      // A NULLABLE ref-list variant field: a list value builds THROUGH the element slot
      // (like code 5), a bare `null` -> `ref.null $wrapper` — the emitObj code-28 discipline.
      let vslot28 = variantFieldRefSlot(vi, fj)
      if vslot28 < 0 { vslot28 = 0 }
      pendingListSlot = vslot28
      if rlElemKindTbl[vslot28] == 2 { pendingListKind = 2 }
      else if rlElemKindTbl[vslot28] == 1 { pendingListKind = 1 }
      else { pendingListKind = 5 }
      if vslot28 < rlWrapIdx.length { pendingNulRefHeap = rlWrapIdx[vslot28] }
    } else if vcode == 6 {
      pendingListKind = 3
    } else if vcode == 25 {
      // Scalar-list variant fields thread their element kind like an annotated `let`:
      // f64[] (4) for an empty `[]`; i64[] (6) / f32[] (7) also RE-ENCODE a non-empty
      // literal's elements (`{f: [5]}` under `f: i64[]` widens each element to i64 —
      // without the seed the literal built an i32 list into the i64-list slot).
      pendingListKind = 4
    } else if vcode == 26 {
      pendingListKind = 6
    } else if vcode == 27 {
      pendingListKind = 7
    }
    // A NESTED-STRUCT variant field (code 15) seeds the TARGET struct so its literal
    // builds that struct (not a field-shape guess) — the `emitObj` code-15 discipline.
    // A MAP-typed variant field (code 19) seeds `pendingMapSlot` the same way, so a
    // `Map()` field value constructs THIS field's value-typed map struct.
    const savedVPSI = pendingStructIdx
    if vcode == 15 { pendingStructIdx = uFieldTgtStructIdx(vi, fj) }
    if vcode == 19 { pendingMapSlot = uFieldMapShape(vi, fj) }
    // A SCALAR f64/i64/f32 variant field widens its value at the construction boundary,
    // exactly as the plain struct-literal path does (`{f: i64} | i32` built from
    // `{f: 567}` must store an i64 — without the widen the box's variant struct got an
    // `i32.const`, invalid wasm at `struct.new`).
    if vcode == 17 {
      if emitExprAsF64(body, valIx, fnIx) < 0 { return -1 }
    } else if vcode == 23 {
      if emitExprAsI64(body, valIx, fnIx) < 0 { return -1 }
    } else if vcode == 24 {
      if emitExprAsF32(body, valIx, fnIx) < 0 { return -1 }
    } else if vcode == 20 {
      // The NICHE `X | null` variant fields (20/21/30/22) seed exactly as the plain
      // struct-literal path does — the `emitObj` discipline, same codes, same reps (the
      // table at `emitNullLitNode`). Without the seeds a `{f: null}` variant hit the
      // bare-null error.
      const svNS = pendingNulString
      pendingNulString = true
      const rcNS = emitExpr(body, valIx, fnIx)
      pendingNulString = svNS
      if rcNS < 0 { return -1 }
    } else if vcode == 21 {
      const svNB = pendingNulBool
      pendingNulBool = true
      const rcNB = emitExpr(body, valIx, fnIx)
      pendingNulBool = svNB
      if rcNB < 0 { return -1 }
    } else if vcode == 30 {
      const vnluCtx = expCtxHere()
      vnluCtx.litUnion = 1
      vnluCtx.nulLitUnion = true
      if emitExprExpect(body, valIx, fnIx, vnluCtx) < 0 { return -1 }
    } else if vcode == 22 {
      const svNC = pendingNulClosure
      pendingNulClosure = true
      const rcNC = emitExpr(body, valIx, fnIx)
      pendingNulClosure = svNC
      if rcNC < 0 { return -1 }
    } else if variantFieldIsLitUnionArray(vi, fj) {
      // An ATOM-ARRAY variant field (`{f: K0[]}` as an arm of `{f: K0[]} | string`) — the
      // `sFieldIsLitUnionArray` discipline (see `emitObj`) at the variant payload boundary.
      const vlaCtx = expCtxHere()
      vlaCtx.litUnion = 1
      if emitExprExpect(body, valIx, fnIx, vlaCtx) < 0 { return -1 }
    } else if vcode == 16 {
      // A VALUE-UNION variant field (`{f: boolean | i64}` as an arm of `{f:…} | i64`):
      // the field stores the shared union BOX, so coerce a raw scalar/string/null value
      // into that box with its atom tag — the exact treatment the plain struct-literal
      // path (`emitObj`) gives a code-16 field. Without it the raw value was `struct.new`'d
      // straight into the box slot (an i32 where a `(ref $box)` is required — invalid wasm,
      // the nested struct-field-union construction hole).
      if emitUnionCoerce(body, variantFieldElemName(vi, fj), valIx, fnIx) < 0 {
        return -1
      }
    } else if vcode == 0 && variantFieldIsLitUnion(vi, fj) {
      // A literal-union atom variant field (`{f: K0} | i64` built from `{f: "aa"}`):
      // the member literal lowers as its interned atom id — the variant twin of the
      // plain struct-literal path's `sFieldIsLitUnion` arm. Without the atom context
      // the member's raw string ref hit the i32 field slot (invalid wasm).
      const fluCtx = expCtxHere()
      fluCtx.litUnion = 1
      if emitExprExpect(body, valIx, fnIx, fluCtx) < 0 { return -1 }
    } else if vcode == 4 && variantFieldIsLitUnionArray(vi, fj) {
      // An ATOM-ARRAY variant field (`{f: K0[]} | string`): the value is the i32 LIST
      // of atom ids — the variant twin of `sFieldIsLitUnionArray`'s construct arm.
      const flaCtx = expCtxHere()
      flaCtx.litUnion = 1
      if emitExprExpect(body, valIx, fnIx, flaCtx) < 0 { return -1 }
    } else {
      if emitExpr(body, valIx, fnIx) < 0 { return -1 }
    }
    if vcode == 15 { pendingStructIdx = savedVPSI }
    if vcode == 19 {
      pendingMapSlot = -1 // a non-`Map()` value never consumed it
    }
    pendingListKind = 0
    fj = fj + 1
  }
  fbStructNew(uVarHeap[vi]) // 0xfb 0x00 <variant struct heap-type index>
  0
}

// Emit a field-STORE's RHS value with the scalar widening its field code demands —
// f64 (17) / i64 (23) / f32 (24) re-encode at the boundary (pass-through for an
// already-matching value), any other code emits plainly. The store-side twin of the
// construct paths' widening (`emitObj` / `emitVariantStruct`); shared by all three
// member-assignment branches (narrowed union, variant param, plain struct).
function emitScalarFieldStoreVal(
  body: i32[],
  valIx: i32,
  fnIx: i32,
  code: i32,
) {
  if code == 17 { return emitExprAsF64(body, valIx, fnIx) }
  if code == 23 { return emitExprAsI64(body, valIx, fnIx) }
  if code == 24 { return emitExprAsF32(body, valIx, fnIx) }
  emitExpr(body, valIx, fnIx)
}

// Lower an object literal `{ f: v, … }` BOXED into the declared union onto `body`:
//   struct.new $box (i32.const tagOf(variant)) (struct.new $variant <fields…>)
// i.e. push the variant's global tag, build the variant payload struct, then
// `struct.new $uBoxIdx` to wrap `{ tag, value }`. The literal must match exactly one
// union variant's field-name set, else fails loudly.
function emitUnionBox(body: i32[], objIx: i32, fnIx: i32) {
  const vname = objVariantName(objIx)
  if vname == "" {
    return emitFail("emitProgram: object literal matches no union variant")
  }
  emitUnionBoxAs(body, objIx, variantIndexOf(vname), fnIx)
}

// The body of `emitUnionBox` with the variant ALREADY RESOLVED — the union-context
// pick (`unionArmVariantForObj`) enters here with its own `vi`.
function emitUnionBoxAs(body: i32[], objIx: i32, vi: i32, fnIx: i32) {
  // tag first (struct field 0 of the box), then the boxed payload (field 1).
  fbI32Const(uTags[vi]) // 0x41 i32.const <tag>
  if emitVariantStruct(body, objIx, vi, fnIx) < 0 { return -1 }
  fbStructNew(uBoxIdx)  // 0xfb 0x00 <union box heap-type index>
  0
}

// Box a struct-typed EXPRESSION (an ident / call result already BUILT as the plain struct
// `sHeapIdx[ssi]`) into union variant `vi`, whose variant struct `uVarHeap[vi]` is a LAYOUT
// TWIN of but a DISTINCT heap type from it. The raw plain ref cannot be boxed directly: the
// narrow (`is {…}`) casts the box payload to `uVarHeap[vi]`, which a `(ref sHeapIdx[ssi])`
// payload fails — invalid wasm for an ident source, a runtime cast TRAP for a call source
// that boxed the plain ref. Rebuild the variant struct field by field from the source (the
// two share a layout, so every read is store-compatible with the variant field), then box.
//
// A RE-READABLE source (ident / paren / member / index — side-effect-free) or a SINGLE-FIELD
// variant re-emits the source once per field. A NON-re-readable MULTI-FIELD source (a CALL)
// is evaluated ONCE into the `variantReboxSlot` stash (a `(ref null struct)` local reserved
// by `fnUsesVariantRebox`) and each field re-reads it via `ref.cast (ref $plainStruct)`. If
// the scan somehow left the slot unreserved, floor loudly rather than emit invalid wasm.
function emitStructExprAsVariantBox(
  body: i32[],
  exprIx: i32,
  vi: i32,
  ssi: i32,
  fnIx: i32,
) {
  const cnt = uFieldCount[vi]
  const reReadable = cnt == 1 || exprReReadable(unwrapParen(exprIx))
  if !reReadable {
    if !fnUsesVariantRebox {
      return emitFail(
        "emitProgram: a multi-field struct value from a call cannot be boxed into a variant-box union (rebox scratch slot unreserved)",
      )
    }
    if emitExpr(body, exprIx, fnIx) < 0 {
      return -1 // evaluate the source struct ref ONCE
    }
    fbLocalSet(variantReboxSlot) // stash `(ref $plainStruct)` as `(ref null struct)`
  }
  fbI32Const(uTags[vi]) // 0x41 i32.const <tag>
  const start = uFieldStart[vi]
  let fj = 0
  while fj < cnt {
    const sfi = sFieldIndex(ssi, uFieldNames[start + fj])
    if sfi < 0 {
      return emitFail(
        "emitProgram: struct value is missing a union-variant field",
      )
    }
    if reReadable {
      if emitExpr(body, exprIx, fnIx) < 0 {
        return -1 // re-read the source struct ref
      }
    } else {
      fbLocalGet(variantReboxSlot)
      fbRefCast(sHeapIdx[ssi]) // `(ref null struct)` → `(ref $plainStruct)`
    }
    fbStructGet(sHeapIdx[ssi], sfi) // read this field (source & variant reps agree)
    fj = fj + 1
  }
  fbStructNew(uVarHeap[vi]) // build the ARM's variant struct
  fbStructNew(uBoxIdx)      // { tag, variant-struct ref }
  0
}

// The COMPILE-TIME value of a monomorphized-instance `is` guard: 1 (always true), 0 (always
// false), or -1 (not statically decidable — `emitIs`'s runtime paths handle it). Each mono
// instance pins an un-annotated param to ONE concrete type, so `v is T` is decided per
// instance (host parity: instances never cross-contaminate). Split out of `emitIs` so the
// STATEMENT emitter can also drop the provably-dead arm: in the `v is {foo: string}`
// instance where `v` is bound to `i32`, the then-branch's `v.foo` has no struct receiver and
// fails to emit ("field access but no struct type declared") even though it can never run.
function monoStaticIsResult(isIx: i32, fnIx: i32) {
  const nd = P.nodes[isIx]
  if nd is IsExpr {
    if variantIndexOf(nd.isVariant) >= 0 { return -1 }
    // THE THIRD GATE ON THE `is` SPELLING (#1310), AND IT IS SCOPED BY THE RECEIVER.
    // #1309 found two readers of the RAW tested spelling that both have to resolve it
    // against the rows the emitter actually has (`emitIs`'s own ladder and
    // `pushNarrowIs`); this exclusion — "a declared VARIANT name keeps the loud
    // union-only failure below" — is the third. Asking the RAW string alone made it
    // depend on which SPELLING happened to be registered: with the inferred union's
    // duplicate structural row gone, an inline-shape test (`a is {meow: i32}`) stopped
    // naming a row, this arm claimed it as a non-union static guard and CONST-FOLDED IT
    // TO FALSE — silently, where master rejected.
    //
    // THE SCOPE IS NOT DECORATION AND A 60-CELL GRID SET IT. Resolving the spelling
    // UNCONDITIONALLY over-excludes: `isVariantSpelling` answers about the tested TYPE,
    // not about the receiver, so `v is {meow: i32}` in a `g<T>` instance where `T` is
    // `i32` also stopped folding — 12 monomorphized cells that master decided correctly
    // turned into ``is` receiver is not a union value`. The receiver decides: a value the
    // CHECKER typed as a union (`nodeTyIsUnion` — deliberately not `exprUnion`, which is
    // the emitter's REP classification and is exactly what has the gap here) is a union
    // test whatever the rep layer managed, and belongs to the ladder below.
    if nodeTyIsUnion(nd.isObj) {
      const rsp = isVariantSpelling(nd.isVariant, isVarTyIxOf(isIx))
      if variantIndexOf(rsp) >= 0 { return -1 }
    }
    if exprUnion(nd.isObj, fnIx) { return -1 }
    // A NULLABLE receiver is NEVER statically decided here, because the only name this fold
    // has for it is its NON-NULL base: `monoArgTyName`'s cascade classifies a
    // `string | null` / `boolean | null` / `i32[] | null` / `K | null` value by the member
    // it reps as (`string`, `boolean`, `i32[]`, `i32`), so `v is null` would compare two
    // names that can never be equal and decide FALSE — a guard that never fires. Those reps
    // are RUNTIME tests (`emitNulIsNullTest`). The gate lives HERE rather than at the `is`
    // emitter because the STATEMENT emitter's dead-arm skip (`monoStaticIsGuardOf`) reads
    // this same answer: split them and the skip could drop an arm whose guard the emitted
    // condition still evaluates at runtime.
    if nodeTyIsNullable(nd.isObj) { return -1 }
    const sk = monoArgTyName(nd.isObj, fnIx)
    if sk == "" { return -1 }
    if sk == nd.isVariant { return 1 }
    // THE SAME COMPARE, WITH THE TESTED SPELLING RESOLVED. `sk` is a CANONICAL emit name
    // (`monoArgTyName` reads post-canon annotations) while `nd.isVariant` is the RAW source
    // spelling, so a TRANSPARENT ALIAS compared unequal to the very type it denotes and the
    // guard const-folded FALSE: `x is A` over an `A`-typed receiver answered `no`, with no
    // union anywhere in the program (`type A = i32; function p(x: A) { if x is A … }`), and
    // so did every same-base twin union `A | B`, which the arena collapses to one member.
    // VL is STRUCTURALLY typed — `types/struct-union-same-shape.vl` states the rule and the
    // struct and literal-union spellings already answer TRUE through their own rows — so an
    // alias IS its base and the answer is TRUE. Resolving here is what makes the base and
    // alias spellings of ONE program agree; `tyToEmitName` reads the type the checker already
    // banked at this node (`isVarTyIxOf`, the same bank `isArmTagOfTy` and the narrow push
    // read), so no spelling is re-parsed. A NAMED struct renders as its own name, leaving the
    // struct-row compare below untouched.
    // A tested type carrying a LITERAL is declined (`tyRenderSoftensLits`): its render
    // softens to the base, so `("pp" | "qq")` and `string` render alike while only one of
    // them holds `"zz"` — pinned by `literal-unions/mixed-union-litunion-arm-is-membership
    // .vl`, whose non-member cell folds TRUE without the decline. Those shapes are the
    // membership arms' business, and every one of them runs above this fold.
    const cmpTy = isVarTyIxOf(isIx)
    if cmpTy >= 0 && !tyRenderSoftensLits(cmpTy) {
      if sk == tyToEmitName(cmpTy) { return 1 }
    }
    // The names differ — but an ANONYMOUS SHAPE argument binds `sk` to its interned
    // ROW name (`#anon0`) while the test carries the source spelling, so the string
    // compare alone reports a false NO. Resolve both to a struct row and compare
    // structurally; -1 there means neither side names a row, so the string answer
    // (NO) stands.
    // ARENA ROUTE (destringify D-MONOISTY): the tested type is the one the checker
    // resolved at THIS node and banked (`isVarTyIxOf`) — the same bank `isArmTagOfTy`
    // and the narrow push read three functions below. `monoIsRowMatch` re-derived it
    // from `nd.isVariant`, the raw source spelling, through `repRowOfName`'s
    // `renderFaithful` + `resolveAnnot` RE-PARSE. Same question, one fewer parse.
    const rm = repIsRowMatchTy(sk, isVarTyIxOf(isIx), repScanLim())
    if rm >= 0 { return rm }
    return 0
  }
  -1
}

// ── the `is`-test type, from the CHECKER's bank (destringify D-ISTY) ──────────
// The union-BOX tag the type `ity` claims as a value-union ARM, or -1 when it claims
// none (a struct variant, a literal, an un-interned shape — the paths below `emitIs`'s
// tag compare decide those). `ity` is the arena type `checkIsExprNode` already resolved
// for the `is` node (`nameToTy(n.isVariant)`, banked as `isVarTyIxOf`), so the four
// spelling tests this replaces — `valueAtomKind`, `nameIsLitUnionType`, `nameIsMap`
// (+`mapTagOf`) and `nameIsRefArray` (+`refArrTagOf`) — are all projections of ONE
// value, exactly the shape #1110 found in the atom algebra.
//
// Arm by arm, and why each is the same question the spelling asked:
//   · a value ATOM tags by its KIND — `unMemAtomKind` is `valueAtomKind`'s arena dual
//     (same code space, same order of tests) and `scalarTagOfKind` is the tag;
//   · a LITUNION (`x is K0` over `type K0 = "a" | "b"`, or an inline all-quoted set)
//     boxes as the STRING ref its members are, so it claims kind 2's tag — the
//     structural form of the `isAtom = "string"` rewrite this site used to do;
//   · a MAP arm tags on its VALUE's interned mv slot, `mapTagOf`'s own composition
//     with the value name sliced out of the arena instead of out of the spelling;
//   · a REF-ELEMENT array arm tags on its element's reflist slot — `refArrTagOf`'s
//     composition, with `nameIsRefArray`'s reflist-nameability folded into the slot
//     lookup, which is what that predicate actually adds over a shape test (#1116).
// A slot the reflist layer does not claim answers -1 exactly as `refArrTagOf` does.
function isArmTagOfTy(ity: i32): i32 {
  if ity < 0 { return -1 }
  let ak = unMemAtomKind(ity)
  // A BARE FUNCTION-TYPE arm tags on its interned SIGNATURE slot, not on the flat
  // value-atom kind: a union may carry any number of function-typed arms and kind 11 is
  // ONE tag, so `x is F` answered TRUE for a value built through any of them. The box
  // side derives the same tag from the same render (`cloArmTagOfTy`).
  if ak == 11 { return cloArmTagOfTy(ity) }
  if ak < 0 {
    if tyIsLitUnion(ity) { ak = 2 }
  }
  if ak >= 0 { return scalarTagOfKind(ak) }
  // The arm's map slot is the (KEY, VALUE) pair off ONE `TyMap` hop — a union arm is a
  // composition position the i32-keyed rep does not enter yet, but the pair is what the
  // slot is keyed on, so it is threaded here rather than assumed string-keyed.
  if unMemIsMap(ity) {
    return mapSlotTag(mvSlotOfTyK(tyMapValOf(ity), tyMapKeyIsI32(ity)))
  }
  if unMemIsRefElemArray(ity) {
    const sl = rlSlotOfTy(tyRefArrElemOf(ity))
    if sl >= 0 { return refArrSlotTag(sl) }
  }
  -1
}

// The arena TYPE the active narrowing of `name` binds, or -1 when `name` is not
// narrowed / the narrowing carries no single type. The narrowing stack banks it at the
// push (`pushNarrowRep(name, variant, isVarTyIxOf(condIx), setId)`), so a consumer of a
// narrowed arm can read the STRUCTURE instead of re-classifying the rendered variant
// the same push stored beside it. A complement push (`x != null`) carries a member SET
// rather than a type, and its sole surviving member IS the bound type (`msSoleMemberTy`).
//
// THE LOOKUP IS `narrowSlotOf`'S, not a second walk over the same tables. This was a
// hand-copied twin of it, and the copy is what made the divergence possible: `narrowSlotOf`
// skips a RETIRED entry (a write the narrowing does not admit ended it — see
// `narrowRetired`) and a twin that only matched on the name would keep answering with the
// dead arm's type for every read after the write.
function narrowedArmTyOf(name: string): i32 {
  const i = narrowSlotOf(name)
  if i < 0 { return -1 }
  narrowSlotTyOf(i)
}

// `recv == <numeric literal>` onto `body` — the scalar VALUE test shared by the
// bare-literal `is` spelling (`v is 1`) and the numeric-litunion MEMBERSHIP ladder
// (`v is K`, one call per member). Leaves a 0/1 i32.
//
// THE COMPARE'S WIDTH FOLLOWS THE LEXEME AND THE RECEIVER, NOT A SEPARATELY DERIVED BASE
// NAME, and that is the invariant this one home exists to keep: a float lexeme is
// `f64.eq`, an i64 receiver or a lexeme too wide for i32 is `i64.eq`, everything else
// `i32.eq`. A membership ladder that re-derived the width per member from the TESTED
// type's base could disagree with the receiver's own valtype on exactly the mixed
// receivers the ladder is for; sharing the decision makes that disagreement
// unrepresentable.
function emitNumLitEq(body: i32[], recvIx: i32, lv: string, fnIx: i32) {
  if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
  if numTextIsFloat(lv) {
    fbF64Const(lv)
    fbI32Bin(97) // 0x61 f64.eq
    return 0
  }
  if exprIsI64(recvIx, fnIx) || !numLexFitsI32(lv) {
    const pr = parseI64Pair(lv)
    fbI64Const(pr[0], pr[1])
    fbI32Bin(81) // 0x51 i64.eq
    return 0
  }
  fbI32Const(parseI32(lv))
  fbI32Bin(70) // 0x46 i32.eq
  return 0
}

// The base numeric scalar an `is` RECEIVER reps as IN THIS INSTANCE — `"i32"` / `"i64"` /
// `"f64"`, or "" for anything else. THE ONE HOME for the receiver half of the
// numeric-litunion membership test, because that half is what keeps a receiver off a member
// set of a rep it does not share.
//
// TWO CHANNELS, BECAUSE ONE ORDINARY RECEIVER HAS NO BANKED TYPE AT ALL.
// `nodeNumScalarBaseName` reads the type the CHECKER banked at the node, which answers for
// every ANNOTATED receiver including the mixed `K | i32` / `K | f64` spellings that collapse
// to one scalar. An UN-ANNOTATED parameter is pinned by `monoArgTyName`'s `"i32"` catch-all,
// the one arm of the pin that deliberately mints NO annotation node — so the bank has
// nothing to answer from, this predicate's first channel said "", the whole membership arm
// declined, and the guard fell to `monoStaticIsResult`, which CONST-FOLDS a literal tested
// type to FALSE. `function g(u) { if u is Z { … } }` took the wrong branch with `vl check`
// rc 0 while the `u: i32` twin of the same program was correct one line away.
//
// The second channel is `monoArgTyName` — the emitter's own `fnIx`-SCOPED name for the
// receiver, and the SAME function the fold reads. Sharing it is what makes this arm claim
// exactly the receivers the fold would otherwise decide, per INSTANCE: one `v is Z` node in
// a `g<T>(v: T)` body is emitted once per instance, and an instance pinned to `string` / a
// struct / a list is named by its own rep and declines here. Gating on the node's banked
// type alone cannot see an instance at all — the whole point of #1409/#1419's discipline.
//
// A NULLABLE receiver is refused on the same line and for the same reason
// `monoStaticIsResult` refuses one: `monoArgTyName` names a nullable value by its NON-NULL
// base, so a `K | null` numeric litunion would present as the plain `i32` its sentinel
// encoding is not. Those keep the loud floor rather than a membership ladder emitted over a
// sentinel this arm has no lowering for.
function isNumRecvBaseName(recvIx: i32, fnIx: i32) {
  const nb = nodeNumScalarBaseName(recvIx)
  if nb != "" { return nb }
  if nodeTyIsNullable(recvIx) { return "" }
  const mn = monoArgTyName(recvIx, fnIx)
  if mn == "i32" || mn == "i64" || mn == "f64" { return mn }
  ""
}

// The value-union NAME of an `is` RECEIVER, for the box-tag soundness floor in `emitIs`.
// `unionNameOfExpr` covers every receiver form the tag compare has an arm for EXCEPT the
// optional chain — `x?.y is i32` reads its field through `optChainStructIdxOf` rather than
// through the expression classifier, so the chain's own leaf field is resolved here. ""
// when the receiver is not a union (the floor then does not apply).
function isStrTagUnionNameOf(exprIx: i32, fnIx: i32) {
  const nm = unionNameOfExpr(exprIx, fnIx)
  if nm != "" { return nm }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is OptMember {
    const si = optChainStructIdxOf(e.omObj, fnIx)
    if si >= 0 {
      const fi = sFieldIndex(si, e.omProp)
      if fi >= 0 {
        if sFieldTypeAt(si, fi) == 16 { return sFieldElemNameAt(si, fi) }
      }
    }
  }
  ""
}

// THE null test for a nullable value, and the ONE home for it: `x == null` / `x != null`
// and the `x is null` / `x is <member>` guard ask the identical question of the identical
// rep. Leaves a 0/1 i32 — 1 = NULL when `invert` is false, 1 = PRESENT when it is true.
// Returns 1 when the ladder CLAIMS the receiver's rep (bytes emitted), 0 when no arm
// matches (nothing emitted — the caller keeps its own paths), -1 on an emit failure.
//
// A REP ANSWERED IN ONLY ONE OF THE TWO CALLERS IS A GUARD THAT NEVER FIRES, and the
// failure is SILENT: an `is` receiver no arm here claims falls through to
// `monoStaticIsResult`, whose `monoArgTyName` names a nullable value by its NON-NULL base
// (`string`, `boolean`, `i32[]`, `K`) — so the fold compares two names that can never be
// equal and decides FALSE. `vl check` clean, the wrong branch taken in statement position
// and a `ref.as_non_null` trap wherever the narrowed arm is the value. Adding a rep to one
// caller's ladder without the other re-opens exactly that.
//
// `nicheOnly` restricts the ladder to the SINGLE-non-null-member reps. A value-union BOX
// and an optional chain can carry several non-null members, so "not null" does not identify
// one of them — those two arms answer only the `== null` question and are skipped for `is`.
function emitNulIsNullTest(
  body: i32[],
  refIx: i32,
  fnIx: i32,
  invert: boolean,
  nicheOnly: boolean,
) {
  // A NARROWING THAT EXCLUDES NULL DECIDES THIS STATICALLY, and it is claimed FIRST because
  // every arm below reads the receiver at the DECLARED nullable rep while `emitIdentNode`
  // reads a narrowed binding at the ARM's rep. `let x: i32 | null = null` / `x = 5` / `if x
  // != null` reached no arm at all (the receiver no longer classifies as a union) and fell
  // out to the i32 compare, which emitted a bare `null` with nothing to type it: `bare null
  // needs a struct-typed context`, `vl check` rc 0. The assignment kind is the reachable
  // spelling — a redundant null test inside a live GUARD is a dead test the checker rejects,
  // while the assignment kind's test is deliberately kept meaningful (it asks the DECLARED
  // type), so the emitter is where the two views have to be reconciled.
  //
  // ONLY THE NULL QUESTION, AND THE MEASUREMENT IS WHY. `nicheOnly` callers are the `is`
  // arms, which read a `true` from this ladder as "the value IS the tested variant" — a
  // reading "not null" only supports when the tested variant IS the narrowed arm, and it
  // need not be. `function tag(a: Cat | Dog) { if a is Cat { return a.meow }   if a is Dog
  // { … } }` post-guard-narrows `a` to `Dog`, and folding its `is Dog` to `true` happens to
  // be right while the same fold of an `is Cat` there would be a silently wrong branch.
  // (13 of 1952 corpus modules took that fold, all of them correctly and none of them
  // because the rule held.) So the PRESENT direction is claimed for the `==`/`!=` callers
  // only, which ask this ladder's own question; `is null` is claimed either way, because a
  // value proved non-null is not null under any caller's reading.
  if !nicheOnly || !invert {
    const nnRef = P.nodes[unwrapParen(refIx)]
    if nnRef is Ident {
      if narrowExcludesNull(nnRef.identName) {
        if invert {
          fbI32Const(1) // present, provably
        } else {
          fbI32Const(0) // not null, provably
        }
        return 1
      }
    }
  }
  // The two SENTINEL niches: a `boolean | null` rides the i32 value 2 and a `K | null` the
  // value -1 (member ids are >= 0). The i32 never holds a ref, so both compare against the
  // sentinel rather than `ref.is_null` — checked before the ref niches below.
  if exprNulBool(refIx, fnIx) {
    if emitExpr(body, refIx, fnIx) < 0 { return -1 }
    fbI32Const(2)
    if invert {
      fbI32Bin(71) // 0x47 i32.ne
    } else {
      fbI32Bin(70) // 0x46 i32.eq
    }
    return 1
  }
  if exprNulLitUnion(refIx, fnIx) {
    if emitExpr(body, refIx, fnIx) < 0 { return -1 }
    fbI32Const(-1)
    if invert {
      fbI32Bin(71) // 0x47 i32.ne
    } else {
      fbI32Bin(70) // 0x46 i32.eq
    }
    return 1
  }
  if !nicheOnly {
    // Any null LINK makes an optional chain's value null (the host's OptionalAccess folds
    // null through), so the chain's own null test IS the answer.
    const ncN = P.nodes[unwrapParen(refIx)]
    if ncN is OptMember {
      if emitOptChainIsNull(body, refIx, fnIx) < 0 { return -1 }
      if invert {
        fbI32Eqz() // 0x45 invert: the chain value is present
      }
      return 1
    }
    // A value-union BOX (`i32 | null`, `A | B | null`) is never itself null — the null
    // variant rides the TAG — so compare the box tag against the global null tag (the
    // host's `variantTag(info, null)` path), never `ref.is_null`.
    //
    // THE SECOND CHANNEL IS THE CHECKER'S BANKED TYPE, and it is here because a NULLABLE
    // NUMERIC litunion (`1 | 2 | null`) is a box whose registered union NAME the receiver's
    // storage class does not always carry — `exprUnion` resolves through `unionNameOfIdent`,
    // which asks `isUName` of the annotation's rendered name, and a param spelling reaches it
    // canon'd. The rep is settled structurally by `nodeTyIsNulNumLitUnion` (`vtKindOfType`'s
    // own arm reads the same predicate), so both spellings of the null test emit this one tag
    // compare instead of the `!= null` half falling to the i32 tail with an unseeded bare
    // `null` (`bare null needs a struct-typed context`) while `is null` was already correct.
    if exprUnion(refIx, fnIx) || nodeTyIsNulNumLitUnion(refIx) {
      if emitExpr(body, refIx, fnIx) < 0 { return -1 }
      fbStructGet(uBoxIdx, 0) // box field 0: tag
      fbI32Const(nullBoxTag())
      if invert {
        fbI32Bin(71) // 0x47 i32.ne
      } else {
        fbI32Bin(70) // 0x46 i32.eq
      }
      return 1
    }
  }
  // Every remaining nullable rep is a `(ref null …)` NICHE and tests `ref.is_null`: the
  // struct ref, the map struct, the closure struct, the i32-list backing, a
  // distinct-backing scalar list's wrapper (`string[]|null`, `f64[]|null`, `i64[]|null`,
  // `f32[]|null`) and a ref array's inner wrapper.
  if (
    exprNullableStruct(refIx, fnIx) ||
    exprNullableMap(refIx, fnIx) ||
    exprNulClosure(refIx, fnIx) ||
    exprNullableList(refIx, fnIx) ||
    exprNulScalarListKind(refIx, fnIx) != null ||
    exprNullableRefArray(refIx, fnIx)
  ) {
    if emitExpr(body, refIx, fnIx) < 0 { return -1 }
    wU8(209) // 0xd1 ref.is_null
    if invert {
      fbI32Eqz() // 0x45 invert: non-null
    }
    return 1
  }
  // The `string | null` niche is the nullable raw array ref, and it is the one arm that
  // must read the receiver RAW (`rawNullRead`): a kind-16 ident is otherwise RECOVERED to
  // non-null, which makes `ref.is_null` a const 0.
  if exprNullableString(refIx, fnIx) {
    const nsCtx = expCtxHere()
    nsCtx.rawNullRead = true
    if emitExprExpect(body, refIx, fnIx, nsCtx) < 0 { return -1 }
    wU8(209) // 0xd1 ref.is_null
    if invert {
      fbI32Eqz() // 0x45 invert: non-null
    }
    return 1
  }
  0
}

// True when `recvIx` is a receiver whose STORAGE is the `string | null` niche — a real
// `(ref null $array)` the per-member string compare must null-test before comparing.
//
// BOTH HALVES ARE REQUIRED AND THEY MEAN DIFFERENT THINGS. `exprNullableString` is the
// emitter's DECLARATION-scoped rep classifier (this slot holds a nullable string ref);
// `nodeTyIsNullable` is the CHECKER's banked type for this very read. A receiver NARROWED to
// non-null (`if s != null { s is "x" }`) keeps the first and loses the second, and its read
// is already recovered — so the two DISAGREEING is exactly the narrowing signal, and the
// guarded lowering must not claim it or it would null-test a value that cannot be null.
function litMemberRecvIsNulString(recvIx: i32, fnIx: i32) {
  exprNullableString(recvIx, fnIx) && nodeTyIsNullable(recvIx)
}

// `<string | null> is "<m>"` — the member compare with A NULL RECEIVER ANSWERING FALSE.
// `null is "x"` is a well-formed question whose answer is no, so this is not a checked-program
// impossibility to `ref.as_non_null` away: the receiver is read ONCE as the raw nullable ref
// and `br_on_null` decides between the string compare and a const 0.
//
// READ ONCE, NOT TESTED-THEN-RE-READ. The `??` arms can spell their null test as
// `ref.is_null` + a value `if` because both arms of a coalesce re-read a PLACE; this compare
// also serves a receiver that is not a place (a call result, a map read — the map read is the
// common shape, `m["k"]` typing `string | null`), where a second read would re-run it.
// `br_on_null` consumes the one ref it was given, which is why the block shape here mirrors
// `emitPrintNulString`'s rather than the coalesce's.
function emitNulStrLitEq(body: i32[], recvIx: i32, lex: string, fnIx: i32) {
  fbBlock(127) // block i32 — $out, the 0/1 answer
  ctrlEnter()
  fbBlock(64) // block void — $null
  ctrlEnter()
  // The RAW nullable ref: a kind-16 param/local/field/global read otherwise recovers itself
  // with `ref.as_non_null` (0xd4), which TRAPS on the very value this arm answers FALSE for.
  // A list-element / map / call receiver already yields the raw ref, so the flag is inert
  // there — one read shape covers every origin.
  const rawCtx = expCtxHere()
  rawCtx.rawNullRead = true
  if emitExprExpect(body, recvIx, fnIx, rawCtx) < 0 { return -1 }
  wU8(213) // 0xd5 br_on_null — pops it; on non-null leaves (ref $array)
  wULEB(0) // → $null
  if emitExpr(body, mkStr(lex, -1), fnIx) < 0 { return -1 }
  if emitStrEqCore(body) < 0 { return -1 }
  fbBr(1) // → $out
  fbEnd()
  ctrlLeave()
  fbI32Const(0) // a null receiver is no member
  fbEnd()
  ctrlLeave()
  0
}

// ONE member-literal test `recv == <lex>`, in whichever shape the RECEIVER's rep demands:
// the tag-gated payload compare over a value-union BOX, the null-guarded string compare over
// a `string | null` niche, plain string value-equality over a string ref, the numeric compare
// otherwise. `lex` is a RAW lexeme (quotes kept, escapes unresolved — a `StrLit.strText`),
// which is what both callers hold.
//
// ONE HOME, BECAUSE THE TWO SPELLINGS MUST EMIT THE SAME BYTES. The bare-literal `is "m0"`
// spelling and the litunion MEMBERSHIP ladder (`is K` → `m0 || m1 || …`) ask the same
// question of the same value; splitting the per-member lowering is how a rep the membership
// ladder cannot reach — but the bare literal can — becomes a wrong answer instead of a
// shared one. Every rep the bare-literal spelling handles, membership handles for free.
//
// THE NULL GUARD LIVES HERE FOR THAT REASON. `(string | null) is "x"` and
// `(string | null) is K` are one question; a guard added at either caller would leave the
// other spelling trapping (or invalid) on the same value. This is the single source of truth
// for "a null receiver answers FALSE".
function emitLitMemberEq(body: i32[], recvIx: i32, lex: string, fnIx: i32) {
  if exprUnion(recvIx, fnIx) { return emitUnionLitIs(body, recvIx, lex, fnIx) }
  // The QUOTED-LEAF test at its home (`tyname.nameIsQuotedLeaf`, W3). A synthesized
  // `StrLit` node lowers the lexeme, then the value-eq core.
  if nameIsQuotedLeaf(lex) {
    if !aUsed {
      return emitFail(
        "emitProgram: string `is` test but array type not collected",
      )
    }
    if litMemberRecvIsNulString(recvIx, fnIx) {
      return emitNulStrLitEq(body, recvIx, lex, fnIx)
    }
    if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
    if emitExpr(body, mkStr(lex, -1), fnIx) < 0 { return -1 }
    return emitStrEqCore(body)
  }
  emitNumLitEq(body, recvIx, lex, fnIx)
}

// The ONE text for "this `is` is a literal-union MEMBERSHIP test and the receiver cannot be
// re-read". Both floors that can reach it — the membership ladder's own place bound and the
// box-tag compare's litunion guard — are the same refusal, so they say the same thing.
function emitFailNoMembershipRecv() {
  emitFail(
    "emitProgram: `is` over a literal union needs a re-readable receiver (each member re-reads it; a call / optional-chain receiver has no membership lowering)",
  )
}

// True when the union named `nm` carries a literal-union ARM beside another value arm — the
// BOX shape whose litunion arm rides the box as its member STRING, so `x is K` over it is a
// MEMBERSHIP question over the payload and can never be a tag compare.
//
// AN ALIAS NAME IS RESOLVED TO ITS MEMBER SET FIRST, AND THAT IS THE WHOLE REASON THIS
// FUNCTION EXISTS. `nameIsLitUnionArmValueUnion` decides on the SPELLING it is handed by
// splitting it at top-level `|`, so a declared `type W = K | i32` splits to the single atom
// `"W"` and answers FALSE while the INLINE `K | i32` spelling of the identical box answers
// TRUE. `unionNameOfExpr` hands out whichever spelling the annotation carried, so the two
// spellings of one program took different lowerings: the alias fell past the membership arm
// into the box-tag compare, whose `tag == 2` answers `w is KS` TRUE for EVERY string the box
// holds — members and non-members alike, `vl check` rc 0 and `vl build` clean, while the
// inline twin one line away was correct. `unionMemberSetOf` is the registered expansion
// (`type W = K | i32` → `"K|i32"`), which is what makes the two spellings ask one question.
//
// The unresolved name is asked FIRST and the expansion only on its miss: an already-joined
// member set is the common case and resolves to itself, and `unionMemberSetOf` is a linear
// scan of every registered union row.
function unionCarriesLitUnionArm(nm: string) {
  if nm == "" { return false }
  if nameIsLitUnionArmValueUnion(nm) { return true }
  const setNm = unionMemberSetOf(nm)
  if setNm == nm { return false }
  nameIsLitUnionArmValueUnion(setNm)
}

// `unionStrArmCount` over a union name that may be a declared ALIAS. The count is what
// decides whether kind 2's box tag discriminates an arm at all (1 arm: exactly; 2+: not at
// all), and it is read off the TOP-LEVEL arms — so an alias has to be expanded for the same
// reason `unionCarriesLitUnionArm` expands one, and the soundness FLOOR that reads this count
// has to see the same arms the membership arm above it does or the two disagree about which
// shapes have a correct lowering.
function unionStrArmCountOf(nm: string) {
  unionStrArmCount(unionMemberSetOf(nm))
}

// True when `recvIx` is a receiver `emitLitMemberEq` can be applied to REPEATEDLY — i.e.
// one whose rep that compare reaches. The reps a string literal union can meet: a
// value-union BOX (payload compare), a string-repped litunion, a plain `string`, and the
// `string | null` niche (the null-guarded compare, which answers FALSE for null).
//
// THE NULLABLE STRING IS CLAIMED, AND ONLY BECAUSE THE GUARD IS IN THE SHARED COMPARE.
// `(string | null) is K` and `(string | null) is "m0"` are one question; the membership
// ladder is nothing but the bare-literal compare repeated, so this bound may only admit a
// rep `emitLitMemberEq` answers correctly. It admits this one because that helper
// null-tests the receiver itself (`emitNulStrLitEq`) — claiming the rep while the shared
// compare still `ref.as_non_null`ed would have spread a TRAP across the whole member set.
// A receiver NARROWED to non-null (`if s != null { s is K }`) is a different value and
// reaches the plain compare: `exprNullableString` is declaration-scoped and still calls it
// nullable, but the CHECKER's banked node type does not, and the read `emitExpr` yields is
// already recovered — so the two classifiers DISAGREEING is exactly the narrowing signal
// (`litMemberRecvIsNulString`, which is the same conjunction the guard keys on).
//
// A MONOMORPHIZED receiver is why this asks the emitter's REP classifiers (`exprUnion` /
// `exprString`, both `fnIx`-scoped) and not the node's banked TYPE: one `v is K` node in a
// `g<T>(v: T)` body is emitted once per instance, and the instance pinned to `i32` must not
// take a string compare — invalid wasm traded for a wrong answer.
function litMembershipRecvOk(recvIx: i32, fnIx: i32) {
  // A BOX reaches the per-member compare through `emitUnionLitIs`, and BOTH of that
  // helper's own union-shape rejects are PRE-CHECKED here rather than let fire from inside.
  // A union it declines — one carrying a STRUCT arm — still has an EXACT box-tag compare
  // below it (`K | { w: i32 }` reaches kind 2 only through `K`, so the tag decides the
  // question), and letting the helper fail from in here would convert that working shape
  // into a hard emit failure carrying a message about a lowering it never needed.
  if exprUnion(recvIx, fnIx) {
    const bxNm = unionNameOfExpr(recvIx, fnIx)
    if bxNm == "" { return false }
    if isValueUnionOfSet(msSetOfText(bxNm), bxNm) { return true }
    return unionCarriesLitUnionArm(bxNm)
  }
  if nodeTyIsLitUnion(recvIx) { return true }
  if exprString(recvIx, fnIx) { return true }
  // The `string | null` niche, in BOTH of its states and by the same line. Still nullable at
  // the read (`nodeTyIsNullable` agrees) — the guarded compare; NARROWED by an active
  // `!= null` (only the declaration-scoped classifier still says nullable) — the plain
  // compare over the already-recovered read. `emitLitMemberEq` picks between them.
  exprNullableString(recvIx, fnIx)
}

// Lower a type guard `recv is Variant` onto `body` as the box-tag compare (mirroring
// `toWasm.ts`): evaluate the receiver (a union box), `struct.get $box 0` (the tag), then
// `i32.const tagOf(Variant)` and `i32.eq` — leaving a 0/1 i32 (an `if` condition).
function emitIs(body: i32[], isIx: i32, fnIx: i32) {
  // `p is null` over a NULLABLE struct ref — `ref.is_null` (no union needed), and
  // `p is { x: i32 }` / `p is S` its inverse: over a NICHE nullable struct (`S | null` — one
  // struct member, a nullable REF not a box) the checker already proved the tested shape
  // matches the struct member, so the only runtime distinction is null vs non-null
  // (`!ref.is_null`, the host's nullable non-null narrowing test). This is the ONE niche
  // that must be claimed before the ladders below rather than beside them — see the general
  // niche arm further down, which the box / atom / membership paths deliberately precede.
  const nd0 = P.nodes[isIx]
  if nd0 is IsExpr {
    if exprNullableStruct(nd0.isObj, fnIx) {
      const nst = emitNulIsNullTest(
        body,
        nd0.isObj,
        fnIx,
        nd0.isVariant != "null",
        true,
      )
      if nst < 0 { return -1 }
      if nst > 0 { return 0 }
    }
  }
  // `k is K` / `k is "x"` over a LITERAL-UNION receiver — an interned i32 ATOM id, NOT a
  // union BOX. Every path below reads the box's tag field (`struct.get 0 0`) off the
  // receiver, and on an i32 atom that is invalid wasm: `unionNameOfIdent` claims the
  // binding because `K` is a registered union NAME, while the value's REP is a bare id.
  // Master emitted an unparseable module for every `z: K` binding form (global / local /
  // param) and for `z is "x"` / `z is <sub-alias>`, and silently const-folded FALSE for
  // every `z: K | null` form — a guard that never fires.
  //
  // The atom's own test is MEMBERSHIP: the id equals one of the TESTED type's interned
  // member ids. The `K | null` null sentinel is `-1`, which is no member's id, so the
  // membership chain IS the non-null test for a nullable receiver — one lowering covers
  // both. Destringify: the receiver's atom-ness is the emitter's own REP question and the
  // tested member set comes from the type the CHECKER banked for this `is` node
  // (`isVarTyIxOf`, total for every emitting program — see `isArmTagOfTy`); the fold's
  // receiver side reads `nodeTyIxOf`. Neither side re-parses a spelling.
  if nd0 is IsExpr {
    if exprIsLitAtom(nd0.isObj, fnIx) {
      const laTexts = tyLitMemberTexts(isVarTyIxOf(isIx))
      if laTexts.length > 0 {
        // The receiver's OWN members are all in the tested set: true by construction, and
        // folded without evaluating the receiver — the same shape as the concrete-variant
        // receiver fold at the end of this function. A nullable receiver never folds here
        // (`nodeLitMembersWithin` declines it), so its `-1` still meets a real test.
        if nodeLitMembersWithin(nd0.isObj, laTexts) {
          fbI32Const(1)
          return 0
        }
        // Otherwise: `id == m0 || id == m1 || …`. A ONE-member tested type is ONE compare,
        // so the receiver is evaluated exactly once and ANY receiver expression is safe (a
        // map read, an element read, a call). Two or more members re-read it, so those
        // need a re-readable PLACE (`unionEqOperandOk` — the same bound the boxed arms
        // below carry); any other receiver keeps the paths below rather than having its
        // call silently duplicated.
        let laOk = laTexts.length == 1
        if unionEqOperandOk(nd0.isObj) { laOk = true }
        if laOk {
          let laI = 0
          while laI < laTexts.length {
            if emitExpr(body, nd0.isObj, fnIx) < 0 { return -1 }
            fbI32Const(internAtom(quoteLex(laTexts[laI])))
            fbI32Bin(70) // 0x46 i32.eq
            if laI > 0 {
              fbI32Bin(114) // 0x72 i32.or
            }
            laI = laI + 1
          }
          return 0
        }
      }
    }
  }
  // `x is K` over a BOXED union carrying `K` as an ARM (`K | string`, `K | f64`) — a
  // MEMBERSHIP test over the payload, NOT a box-tag compare. The litunion arm rides the box
  // as its member STRING (`unionTakesAtomAsStr`), so it shares kind 2's tag with a `string`
  // arm and the tag alone answers `x is K` TRUE for every string in a `K | string` box,
  // members and non-members alike — a `vl check`-clean, `vl build`-clean silent wrong answer.
  //
  // Giving the arm its own tag cannot fix that, and this is measured rather than reasoned
  // (docs/internals/litunion-compact-rep-design.md §7.1.1): `K ⊆ string`, so the two arms
  // OVERLAP, and a value belonging to both must answer TRUE to `is K` AND to `is string`
  // — which ONE tag field cannot do. A 14th value-atom kind moves the wrong answer from
  // `is K` to `is string`; it does not remove it (2 grid cells UP, 3 DOWN, all three losses
  // the same silent class).
  //
  // The answer that holds for both is the VALUE test `x is "aa" || x is "bb"` — the same
  // membership the atom ladder above emits over interned ids, lowered here through the
  // per-literal tag-gated payload compare (`emitUnionLitIs`), and the same semantics #1306
  // gave the flattened `K | K2`. `unionEqOperandOk` bounds the receiver to a re-readable
  // binding: each member re-reads it (twice — tag, then payload).
  if nd0 is IsExpr {
    const luNm = unionNameOfExpr(nd0.isObj, fnIx)
    if unionCarriesLitUnionArm(luNm) {
      const luTexts = tyLitMemberTexts(isVarTyIxOf(isIx))
      if luTexts.length > 0 && unionEqOperandOk(nd0.isObj) {
        let luI = 0
        while luI < luTexts.length {
          const luLit = quoteLex(luTexts[luI])
          if emitUnionLitIs(body, nd0.isObj, luLit, fnIx) < 0 { return -1 }
          if luI > 0 {
            fbI32Bin(114) // 0x72 i32.or
          }
          luI = luI + 1
        }
        return 0
      }
    }
  }
  // `x is K` over a BOXED union carrying a NUMERIC literal union as an arm
  // (`K | string`, `type K = 1 | 2`) — the numeric twin of the arm above, and membership
  // for the same reason: `K ⊆ i32`, so the arm shares kind 0's tag with any i32 arm and a
  // tag compare cannot separate a member from a non-member. Here it could not even try —
  // `isArmTagOfTy` derives its tag through `tyIsLitUnion`, which is string-only, so a
  // numeric arm claims no tag at all and the guard fell past every path to the loud
  // ``is` names a type that is not a union variant`.
  //
  // The per-member compare is `emitUnionLitIs`, the tag-gated payload test the bare
  // `x is 1` spelling already lowers to over this same box.
  //
  // BOTH OF THAT HELPER'S OWN REJECT CONDITIONS ARE PRE-CHECKED HERE, and that is what
  // makes this arm a candidate test rather than a commitment: `unionEqOperandOk` (each
  // member re-reads the receiver) and the value-union NAME gate. Letting either fire from
  // inside would convert every shape this arm merely fails to claim into a hard emit
  // failure with THIS arm's message, hiding whichever diagnostic the paths below would
  // have given it — and one such shape is live, the `K | i32` PARAM slot, whose rep
  // classifier calls it a box while `RC_ROOT` gives the identical type a plain scalar.
  //
  // The tested type is asked FIRST and the union NAME only after it answers: resolving a
  // name costs `msSetOfText`'s two map probes plus, on a first miss, a linear scan of every
  // registered row (see `isValueUnionOfSet`), and `numLitUnionBaseName` is an arena walk
  // that rejects every non-numeric-literal test — which is nearly all of them — before a
  // probe is charged.
  if nd0 is IsExpr {
    if numLitUnionBaseName(isVarTyIxOf(isIx)) != "" {
      const nbTexts = tyNumLitMemberTexts(isVarTyIxOf(isIx))
      if (
        nbTexts.length > 0 &&
        exprUnion(nd0.isObj, fnIx) &&
        unionEqOperandOk(nd0.isObj)
      ) {
        const nbNm = unionNameOfExpr(nd0.isObj, fnIx)
        if (
          nbNm != "" &&
          (isValueUnionOfSet(msSetOfText(nbNm), nbNm) ||
            unionCarriesLitUnionArm(nbNm))
        ) {
          let nbI = 0
          while nbI < nbTexts.length {
            if emitUnionLitIs(body, nd0.isObj, nbTexts[nbI], fnIx) < 0 {
              return -1
            }
            if nbI > 0 {
              fbI32Bin(114) // 0x72 i32.or
            }
            nbI = nbI + 1
          }
          return 0
        }
      }
    }
  }
  // `x is K` over a STRING literal union `K`, for every receiver rep the per-member compare
  // reaches (`litMembershipRecvOk`): the MEMBERSHIP test `x == m0 || x == m1 || …`, which is
  // what `K` MEANS — its members are a runtime-observable subset of `string`, so the
  // predicate exists as a value test and nothing about the receiver's rep can change the
  // answer, only how each compare is spelled.
  //
  // AHEAD OF THE BOX-TAG COMPARE BELOW, AND THAT ORDER IS THE CORRECTNESS ARGUMENT. A
  // litunion tested type claims kind 2's tag (`isArmTagOfTy`), the SAME tag a plain `string`
  // arm claims, so the tag compare answers `x is K` TRUE for every string a `string | i32`
  // box holds — members and non-members alike, `vl check` clean. The floor below only
  // catches a box with TWO string-repped arms; a box whose single string arm is not `K`
  // itself walked straight into the tag compare.
  //
  // A `string` RECEIVER is the same defect one rep over: `if s is K` on a plain `(ref
  // $array)` matched no box, no atom and no litunion rep, fell to `monoStaticIsResult` —
  // which sees a non-union rep and a tested name that is no variant row — and CONST-FOLDED
  // TO FALSE. `if s is "m0"` on the identical value answered correctly one line away, which
  // is the oracle: the two spellings now share `emitLitMemberEq` and cannot disagree.
  //
  // Two or more members RE-READ the receiver, so those need a re-readable place
  // (`unionEqOperandOk`); a one-member tested type evaluates it exactly once and accepts any
  // receiver expression. A receiver the bound declines has NO membership lowering and no
  // spill slot reserved for one, so it takes the loud floor rather than falling through to
  // the tag compare / static fold below, both of which are known wrong for this question.
  if nd0 is IsExpr {
    if !exprIsLitAtom(nd0.isObj, fnIx) {
      const lsTexts = tyLitMemberTexts(isVarTyIxOf(isIx))
      if lsTexts.length > 0 && litMembershipRecvOk(nd0.isObj, fnIx) {
        // The receiver's OWN members are all in the tested set: true by construction, and
        // folded without evaluating the receiver — the atom ladder's twin fold.
        //
        // THE FOLD NEEDS A PURE LITERAL-UNION RECEIVER, NOT JUST ONE CARRYING LITERALS.
        // `nodeLitMembersWithin` reads the STRING literal members and is blind to every
        // other member, so over a MIXED `"b" | 1` — what an else-if chain narrows
        // `"a" | "b" | 1` to — it reports "all mine are yours" for the tested `"b"` and
        // folds a guard the value `1` must answer FALSE to. A plain `string` receiver has
        // no members and never folds here either way.
        if nodeTyIsLitUnion(nd0.isObj) {
          if nodeLitMembersWithin(nd0.isObj, lsTexts) {
            fbI32Const(1)
            return 0
          }
        }
        let lsOk = lsTexts.length == 1
        if unionEqOperandOk(nd0.isObj) { lsOk = true }
        if !lsOk { return emitFailNoMembershipRecv() }
        let lsI = 0
        while lsI < lsTexts.length {
          if (
            emitLitMemberEq(body, nd0.isObj, quoteLex(lsTexts[lsI]), fnIx) <
            0
          ) {
            return -1
          }
          if lsI > 0 {
            fbI32Bin(114) // 0x72 i32.or
          }
          lsI = lsI + 1
        }
        return 0
      }
    }
  }
  // `x is i32` / `x is string` / … over a BOXED value union: the same box-tag
  // compare as a struct variant, against the atom's globally-stable scalar tag.
  const ndv = P.nodes[isIx]
  if ndv is IsExpr {
    // The box tag the tested type claims: a value atom's globally-stable
    // `scalarTagOfKind`, a MAP arm's `mapSlotTag`, or a REF-ELEMENT array arm's
    // `refArrSlotTag` (`x is S[]`, `x is (() => f64)[]`). All three discriminate by the
    // SAME box field-0 tag compare, so the receiver forms below (ident / union field /
    // optional chain / any union expr) are shared. `armTag < 0` (not a value atom, not a
    // map, not an interned ref-array arm) falls through to the struct-variant / literal
    // paths. Destringify D-ISTY: derived from the type the CHECKER resolved for this
    // `is` node, not from re-classifying the tested SPELLING — see `isArmTagOfTy`.
    const armTag = isArmTagOfTy(isVarTyIxOf(isIx))
    // THE TAG COMPARE BELOW IS UNSOUND FOR A LITERAL-UNION TESTED TYPE OVER A BOX WITH
    // TWO STRING-REPPED ARMS, and floors here rather than emitting a silent wrong answer.
    // A litunion arm rides the box as its member STRING, so it shares kind 2's tag with a
    // plain `string` arm (or with a second litunion arm) — `tag == 2` then answers `x is K`
    // TRUE for every string the box holds, non-members included. The answer is the
    // MEMBERSHIP arm above, which claims every re-readable PLACE receiver
    // (`unionEqOperandOk`, which is what a per-member re-read needs). A receiver it cannot
    // claim — a call result, an optional chain — has NO correct lowering here, so it gets
    // the loud floor. One string-repped arm keeps the tag compare: `K | i32` reaches kind 2
    // only through `K`, so the tag decides it exactly.
    if armTag == 2 && tyIsLitUnion(isVarTyIxOf(isIx)) {
      const amNm = isStrTagUnionNameOf(ndv.isObj, fnIx)
      if amNm != "" && unionStrArmCountOf(amNm) > 1 {
        return emitFailNoMembershipRecv()
      }
    }
    if armTag >= 0 {
      // A union-typed IDENT receiver pushes its RAW box slot directly — even
      // when an outer arm has already narrowed it to a single atom (the last
      // `else if x is boolean` of an exhaustive chain), where the narrowed
      // Ident read would unbox instead of yielding the box.
      const vrecv = P.nodes[unwrapParen(ndv.isObj)]
      if vrecv is Ident {
        if unionNameOfIdentSid(sidOfNode(unwrapParen(ndv.isObj)), fnIx) != "" {
          if emitUnionBoxPush(body, vrecv.identName, fnIx) < 0 { return -1 }
          fbStructGet(uBoxIdx, 0) // 0xfb 0x02 <box ht> field 0: tag
          fbI32Const(armTag)
          fbI32Bin(70)            // 0x46 i32.eq
          return 0
        }
      }
      // `o.y is i32` over a UNION-typed struct FIELD (code 16): read the field's
      // box (recovering a nullable receiver first) and compare its tag — the
      // member-path narrowing's runtime test.
      if vrecv is Member {
        if memberUnionFieldName(unwrapParen(ndv.isObj), fnIx) != "" {
          // The receiver is itself a NARROWED union arm (`v.f`, `v` narrowed to a
          // variant carrying the value-union field): the field box rides the variant
          // tables, so read it through the narrowed-member path (which yields the box —
          // `v.f` is not yet narrowed inside its own guard) then compare the box tag.
          if memIsNarrowed(unwrapParen(ndv.isObj)) {
            if emitNarrowedMem(body, unwrapParen(ndv.isObj), fnIx) < 0 {
              return -1
            }
            fbStructGet(uBoxIdx, 0) // field 0: tag
            fbI32Const(armTag)
            fbI32Bin(70)            // 0x46 i32.eq
            return 0
          }
          const msi = structIndexOfExpr(vrecv.memObj, fnIx)
          const mfi = sFieldIndex(msi, vrecv.memProp)
          if emitExpr(body, vrecv.memObj, fnIx) < 0 { return -1 }
          if exprNullableStruct(vrecv.memObj, fnIx) {
            wU8(212) // 0xd4 ref.as_non_null
          }
          fbStructGet(sHeapIdx[msi], mfi) // the field's box
          fbStructGet(uBoxIdx, 0)         // field 0: tag
          fbI32Const(armTag)
          fbI32Bin(70)                    // 0x46 i32.eq
          return 0
        }
      }
      // `x?.y is i32` — an OPTIONAL-CHAIN receiver folds its null test into the
      // result: any null link → false (the host's chain yields `null`, and
      // `null is i32` is false), else the union FIELD's box-tag compare.
      if vrecv is OptMember {
        const oisSi = optChainStructIdxOf(vrecv.omObj, fnIx)
        if oisSi >= 0 {
          const oisFi = sFieldIndex(oisSi, vrecv.omProp)
          if oisFi >= 0 {
            if sFieldTypeAt(oisSi, oisFi) == 16 {
              if emitOptChainIsNull(body, vrecv.omObj, fnIx) < 0 { return -1 }
              fbIf(127)                           // a null link → false
              ctrlEnter()
              fbI32Const(0)
              fbElse()
              if emitOptChainValue(body, vrecv.omObj, fnIx) < 0 { return -1 }
              fbStructGet(sHeapIdx[oisSi], oisFi) // the field's box
              fbStructGet(uBoxIdx, 0)             // field 0: tag
              fbI32Const(armTag)
              fbI32Bin(70)                        // 0x46 i32.eq
              fbEnd()
              ctrlLeave()
              return 0
            }
          }
        }
      }
      if exprUnion(ndv.isObj, fnIx) {
        if emitExpr(body, ndv.isObj, fnIx) < 0 { return -1 }
        fbStructGet(uBoxIdx, 0) // 0xfb 0x02 <box ht> field 0: tag
        fbI32Const(armTag)
        fbI32Bin(70)            // 0x46 i32.eq
        return 0
      }
    }
  }
  // `x is K` over a NUMERIC literal union (`type K = 1 | 2`, `type K = 1.5 | 2.5`) —
  // the FOURTH rep, and the one no litunion machinery could see. `tyIsLitUnion` requires
  // every member `litKind == "str"` and `tyLitMemberTexts` collects only `"str"` members,
  // so a numeric literal union is not a "litunion" anywhere above: no gate DECLINED it, it
  // was never a candidate. Every arm fell through and the guard reached
  // `monoStaticIsResult`, which CONST-FOLDED IT TO FALSE — `vl check --codegen` clean, and
  // FALSE even for `k: K` tested against its own alias.
  //
  // The rep is the plain BASE SCALAR, read off the disassembly and not off the
  // classification: `const x: K | i32 = k` gives the binding an `i32` local and `K | f64`
  // an `f64` local — no box, no tag, because every member of either union softens to the
  // one scalar (`numeric-litunion-alias.vl` is that contract's pin). So this is NOT the
  // string sibling's lowering with the comparator swapped for a numeric one — that arm
  // tests a `(ref $array)` receiver through `__str_eq__`, and there is no ref here at all.
  //
  // The test is MEMBERSHIP over the value, `recv == m0 || recv == m1 || …`, which is
  // exactly what makes a numeric litunion different from a newtype brand (#1344): its
  // members are a runtime-observable SUBSET of the base, so the predicate EXISTS. The
  // per-member compare is the bare-literal spelling's own (`emitNumLitEq`), so `x is K`
  // and `x is 1 || x is 2` emit the same bytes.
  //
  // BOTH BASES ARE CHECKED AND THEY MUST AGREE. The tested type's base is
  // `numLitUnionBaseName` (all-`TyLit`, homogeneous); the RECEIVER's is
  // `isNumRecvBaseName`, whose header carries why the receiver half needs two channels and
  // what each one claims. Without the receiver half a monomorphized `g<T>(v: T)`
  // instance pinned to `string` would take this arm and compare a string ref with
  // `i32.eq` — invalid wasm traded for a wrong answer, the trap the string sibling's
  // filing walked into by asserting a rep instead of reading it. It is also what keeps an
  // i64 receiver off an i32-based member set and an f64 receiver off an integer one.
  //
  // AHEAD OF THE BARE-LITERAL ARM BELOW, AND THAT ORDER IS LOAD-BEARING FOR THE INLINE
  // SPELLING. `isLitVariantName` decides on the tested spelling's FIRST CHARACTER, so the
  // un-aliased `x is 1 | 2` is a "literal" to it and lowered as the single compare
  // `x == 1` — every non-first member silently dropped. This arm reads the member set off
  // the arena instead, so the alias and the inline spelling answer identically; a tested
  // type that really is ONE literal still reaches `emitNumLitEq` here and emits the same
  // bytes that arm would, which is why taking it first costs that arm nothing.
  if nd0 is IsExpr {
    if !exprUnion(nd0.isObj, fnIx) {
      const nlBase = numLitUnionBaseName(isVarTyIxOf(isIx))
      if nlBase != "" && isNumRecvBaseName(nd0.isObj, fnIx) == nlBase {
        const nlTexts = tyNumLitMemberTexts(isVarTyIxOf(isIx))
        // Two or more members RE-READ the receiver, so those need a re-readable place
        // (`unionEqOperandOk`); a one-member tested type evaluates it exactly once and
        // accepts any receiver expression. Both bounds mirror the atom ladder above.
        let nlOk = nlTexts.length == 1
        if unionEqOperandOk(nd0.isObj) { nlOk = true }
        if nlTexts.length > 0 && nlOk {
          let nlI = 0
          while nlI < nlTexts.length {
            if emitNumLitEq(body, nd0.isObj, nlTexts[nlI], fnIx) < 0 {
              return -1
            }
            if nlI > 0 {
              fbI32Bin(114) // 0x72 i32.or
            }
            nlI = nlI + 1
          }
          return 0
        }
      }
    }
  }
  // `v is <literal>` over a SOFTENED scalar: a same-base literal union rides
  // its base scalar after `canonEmitTypeNames` (`"a" | "b"` a string, `0 | 1`
  // an i32, `1.5 | 2.5` an f64), so the `is` is a runtime VALUE test — the
  // same lowering as `v == <literal>` (string value-equality / numeric eq).
  // A literal `is` over a still-BOXED mixed-rep union (`"a" | "b" | 1`) is the
  // tag-gated payload compare (`emitUnionLitIs`) — same-rep literals share a
  // tag, so the tag alone cannot discriminate them.
  //
  // The STRING literals of this arm are already claimed by the membership ladder above (a
  // one-member set, through the same `emitLitMemberEq`); what reaches here is the NUMERIC
  // literal spelling and any string one whose receiver the ladder's place bound declined.
  if nd0 is IsExpr {
    const lv = nd0.isVariant
    if isLitVariantName(lv) {
      return emitLitMemberEq(body, nd0.isObj, lv, fnIx)
    }
  }
  // `x is null` / `x is <member>` over a NULLABLE value whose rep is a
  // single-non-null-member NICHE (`string | null`, `boolean | null`, `K | null`, a list /
  // ref-array / map / closure niche): the only runtime distinction IS null vs present, so
  // the guard is the niche's own null test, shared with the `== null` compare
  // (`emitNulIsNullTest` — its header carries why one home is required). `x is <member>`
  // inverts it: the checker already proved the tested shape is the sole non-null member.
  //
  // THE POSITION IS THE WHOLE CORRECTNESS ARGUMENT AND IT IS MEASURED, NOT REASONED. This
  // arm belongs immediately in front of `monoStaticIsResult` and behind every box / atom /
  // membership path above, because the set it claims is exactly the set that otherwise
  // reaches that fold — which names a nullable receiver by its NON-NULL base and so decides
  // a guard that has to run.
  //
  // Ahead of the box paths it MISCLAIMS: a union BOX narrowed by an outer arm to a single
  // nullable member (`else if x is boolean` at the end of an `A | B | i32 | … | null`
  // chain) reads `exprNulBool` TRUE on a value whose STORAGE is still a `(ref $uBox)`, and
  // the sentinel compare `i32.ne` over a box ref is invalid wasm
  // (`functions/heterogeneous-union.vl` is the live pin). Narrowing is a TYPE fact; the box
  // is the STORAGE, and only the paths above read the storage.
  //
  // The litunion niche takes only the `is null` DIRECTION. `v is K2` over a `K | null` where
  // `K2` is a SUB-alias is a MEMBERSHIP question — one "not null" cannot express — and the
  // atom ladder above answers it exactly.
  if nd0 is IsExpr {
    let nulOk = true
    if nd0.isVariant != "null" {
      if exprNulLitUnion(nd0.isObj, fnIx) { nulOk = false }
      if tyIsLitUnion(isVarTyIxOf(isIx)) { nulOk = false }
    }
    if nulOk {
      const nt = emitNulIsNullTest(
        body,
        nd0.isObj,
        fnIx,
        nd0.isVariant != "null",
        true,
      )
      if nt < 0 { return -1 }
      if nt > 0 { return 0 }
    }
  }
  // STATIC `is` over a NON-union operand against a base TYPE NAME (`x is i32`,
  // `x is string`) — the monomorphized-generic-param guard. Each instance pins
  // the param to one concrete type, so the test is decided AT COMPILE TIME per
  // instance and lowers to a constant (host parity: `is T` on a generic param
  // is resolved statically per monomorphized call site, so calls don't
  // cross-contaminate). Union-typed operands took the tag-compare paths above;
  // a declared VARIANT name keeps the loud union-only failure below.
  if nd0 is IsExpr {
    const st = monoStaticIsResult(isIx, fnIx)
    if st >= 0 {
      fbI32Const(st)
      return 0
    }
  }
  // `f is (A) => B` over a NULLABLE-closure operand (`f: ((i32) => i32) | null`) is a NON-NULL
  // test — the closure-typed `is` form of `f != null`. Calling `f(x)` in the then-branch
  // already ref-casts the nullable value to non-null, so no narrowing key is needed.
  //
  // Destringify D-ISTY (the hand-off #1125 filed and declined for want of a pin): the gate
  // asks "is the tested type a FUNCTION type", which master answered by scanning the tested
  // SPELLING for `=>` — blind through a declared alias (`type F = (i32) => i32` then `h is F`
  // carries no arrow), so an aliased test fell past this arm into the variant ladder and hit
  // `emitProgram: `is` names a type that is not a union variant`, a loud reject for a program
  // the checker accepts. The checker's banked type for THIS node (`isVarTyIxOf`, total for
  // every emitting program — see `isArmTagOfTy`) resolves the alias structurally. The opposite
  // direction is #1125's ARROW probe: 111 measured divergences (struct shapes carrying a
  // closure FIELD), every one inert here because `exprNulClosure` is false at all 111.
  if nd0 is IsExpr {
    if tyDenotesFunc(isVarTyIxOf(isIx)) {
      if exprNulClosure(nd0.isObj, fnIx) {
        if emitExpr(body, nd0.isObj, fnIx) < 0 { return -1 }
        wU8(209)   // 0xd1 ref.is_null
        fbI32Eqz() // invert: non-null
        return 0
      }
    }
  }
  if !uDeclared {
    return emitFail("emitProgram: `is` test but no union type declared")
  }
  const nd = P.nodes[isIx]
  if nd is IsExpr {
    // The tested spelling resolved against the variant rows the emitter actually has
    // (`isVariantSpelling` — the author's spelling when it names one, else the declared
    // name of the struct it equals). The narrowing PUSH is the other gate reading the
    // same rule, so the test and every narrowed receiver downstream of it agree.
    const vi = variantIndexOf(
      isVariantSpelling(nd.isVariant, isVarTyIxOf(isIx)),
    )
    if vi < 0 {
      return emitFail(
        "emitProgram: `is` names a type that is not a union variant",
      )
    }
    // A CONCRETE-variant receiver (`f0 is Dog` where `f0: Dog`, e.g. a collapsed `.map`
    // element): the value IS exactly one variant, so the test folds to a compile-time
    // constant (no box to tag-compare). Checked before the union-receiver requirement.
    const rvi = exprVariantIndex(nd.isObj, fnIx)
    if rvi >= 0 {
      if rvi == vi { fbI32Const(1) } else { fbI32Const(0) }
      return 0
    }
    if !exprUnion(nd.isObj, fnIx) {
      return emitFail("emitProgram: `is` receiver is not a union value")
    }
    if emitExpr(body, nd.isObj, fnIx) < 0 { return -1 }
    fbStructGet(uBoxIdx, 0) // 0xfb 0x02 <box ht> field 0: tag
    fbI32Const(uTags[vi])   // 0x41 i32.const <tag>
    fbI32Bin(70)            // 0x46 i32.eq
    return 0
  }
  emitFail("emitProgram: expected an `is` expression")
}

// Lower a narrowed field read `recv.field` where `recv` is a union value narrowed (by
// an enclosing `if recv is Variant`) to `narrowVariant`. The downcast mirrors
// `toWasm.ts`: evaluate the box, `struct.get $box 1` (the `anyref` value), `ref.cast
// (ref $variant)` to recover the payload, then `struct.get $variant <fieldIdx>`.
//   ref.cast is `0xfb 0x16 <heaptype>` (non-null target — the box value is never null).
function emitNarrowedMem(body: i32[], memIx: i32, fnIx: i32) {
  const m = P.nodes[memIx]
  if m is Member {
    // Resolve the variant from the RECEIVER's own active narrowing (not a global slot) —
    // so two simultaneously-narrowed locals each downcast to THEIR variant.
    let recvVar = ""
    const recvN = P.nodes[m.memObj]
    if recvN is Ident { recvVar = narrowVariantFor(recvN.identName) }
    // A nested union-FIELD receiver (`t.v.a`): resolve the variant from its path key.
    if recvN is Member {
      const pk = memberPathKeyOf(m.memObj)
      if pk != "" { recvVar = narrowVariantFor(pk) }
    }
    const vi = variantIndexOf(recvVar)
    if vi < 0 {
      return emitFail("emitProgram: narrowed receiver names no union variant")
    }
    const idx = variantFieldIndex(vi, m.memProp)
    if idx < 0 {
      return emitFail(
        "emitProgram: unknown variant field in narrowed field access",
      )
    }
    if emitExpr(body, m.memObj, fnIx) < 0 { return -1 }
    fbStructGet(uBoxIdx, 1)        // 0xfb 0x02 <box ht> field 1: value (anyref)
    fbRefCast(uVarHeap[vi])        // 0xfb 0x16 <variant struct> ref.cast (non-null)
    fbStructGet(uVarHeap[vi], idx) // 0xfb 0x02 <variant struct ht> <field index>
    // A VALUE-UNION variant field (code 16) whose OWN member path is narrowed to one
    // scalar atom (`if v.f is i64 { … v.f … }`, v itself narrowed to this variant): the
    // `struct.get` above yields the field's inner union BOX, so unbox it to the narrowed
    // atom's rep — the same recovery the plain struct-field union read applies. Without it
    // the raw box flowed where the atom (an i64/…) was expected (invalid wasm — the nested
    // struct-field-union READ hole). An un-narrowed read yields the box unchanged.
    if variantFieldTypeAt(vi, idx) == 16 {
      const mAtom = narrowVariantFor(memberPathKeyOf(memIx))
      const mk = valueAtomKind(mAtom)
      if mk >= 0 && mk != nullValKind() {
        fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
        // D-UNION-ATOM-KIND: `mk` IS `valueAtomKind(mAtom)`, bound one line above, so
        // the string arm asks the CODE (`valueAtomKind` answers 2 for the spelling
        // `string` and for nothing else) exactly as the struct-field twin of this read
        // does eleven hundred lines down. #1128 migrated that twin and left this line
        // for the next slice rather than ship it unmeasured.
        if mk == 2 {
          if !aUsed {
            return emitFail(
              "emitProgram: narrowed string union field read but array type not collected",
            )
          }
          fbRefCast(aTypeIdx) // the payload IS the string array ref
        } else {
          // D-UNION-ATOM-KIND: `mk` IS `valueAtomKind(mAtom)`, bound above, and the
          // value box is a projection of it — no second derivation from the spelling.
          const mvb = vbHeapIdxOfKind(mk)
          if mvb < 0 {
            return emitFail(
              "emitProgram: narrowed union field atom has no value box",
            )
          }
          fbRefCast(mvb)
          fbStructGet(mvb, 0) // the scalar payload
        }
      }
    }
    return 0
  }
  emitFail("emitProgram: expected a field access")
}

// ── optional chains over niche nullable structs (`o?.inner?.v`) ───────────────
// Every link is an effect-free place (an Ident root + field reads), so the chain
// is re-evaluated instead of spilling to a scratch local — mirroring the host's
// temp-local OptionalAccess only in VALUE, not in shape.

// (`optChainStructIdxOf` — imported from `emit_classify.vl`, undocumented there: the struct
// TABLE index of an optional-chain RECEIVER's value; an `a?.b` link resolves its field's
// TARGET struct, a code-15 nested-struct field; any other receiver goes through the normal
// classifier; -1 when unresolvable.)
// True if `exprIx` is a re-readable PLACE — a bare name, or a member chain bottoming out in a
// name (`n`, `n.next`, `a.b.c`). Such a receiver is an effect-free `local.get`/`struct.get`, so
// `recv?.f ?? d` may read it twice (the null test + the field) without double side effects.
function optRecvReReadable(exprIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Ident { return true }
  if e is Member { return optRecvReReadable(e.memObj) }
  false
}

// Push 1 if the optional-chain VALUE at `exprIx` is null — any null link folds
// `null` through (the host's OptionalAccess) — else 0. A code-15 leaf field tests
// its own ref; a code-16 (value-union box) leaf compares the box tag against the
// global null tag (the box ref itself is never null); any other leaf is never
// null once every link held.
function emitOptChainIsNull(body: i32[], exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is OptMember {
    const psi = optChainStructIdxOf(e.omObj, fnIx)
    if psi < 0 {
      return emitFail("emitProgram: `?.` receiver is not a struct chain")
    }
    const pfi = sFieldIndex(psi, e.omProp)
    if pfi < 0 {
      return emitFail("emitProgram: `?.` field is not on the struct")
    }
    if emitOptChainIsNull(body, e.omObj, fnIx) < 0 { return -1 }
    fbIf(127) // 0x04 if, i32 result — receiver null → 1
    ctrlEnter()
    fbI32Const(1)
    fbElse()
    const pfc = sFieldTypeAt(psi, pfi)
    if pfc == 15 {
      if emitOptChainValue(body, e.omObj, fnIx) < 0 { return -1 }
      fbStructGet(sHeapIdx[psi], pfi) // the (ref null $S) field
      wU8(209)                        // 0xd1 ref.is_null
    } else if pfc == 16 {
      if emitOptChainValue(body, e.omObj, fnIx) < 0 { return -1 }
      fbStructGet(sHeapIdx[psi], pfi) // the field's union box (non-null ref)
      fbStructGet(uBoxIdx, 0)         // box field 0: tag
      fbI32Const(nullBoxTag())
      fbI32Bin(70)                    // 0x46 i32.eq
    } else {
      fbI32Const(0) // a non-nullable field is never null past its links
    }
    fbEnd()
    ctrlLeave()
    return 0
  }
  if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
  wU8(209) // 0xd1 ref.is_null
  0
}

// Push the NON-NULL value of the optional-chain receiver at `exprIx` (assumes
// every link was already null-tested): each nullable link recovers
// `ref.as_non_null` so the next `struct.get` sees a non-null ref.
function emitOptChainValue(body: i32[], exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is OptMember {
    const psi = optChainStructIdxOf(e.omObj, fnIx)
    if psi < 0 {
      return emitFail("emitProgram: `?.` receiver is not a struct chain")
    }
    const pfi = sFieldIndex(psi, e.omProp)
    if pfi < 0 {
      return emitFail("emitProgram: `?.` field is not on the struct")
    }
    if emitOptChainValue(body, e.omObj, fnIx) < 0 { return -1 }
    fbStructGet(sHeapIdx[psi], pfi)
    fbRefAsNonNull() // 0xd4 — the link was null-tested
    return 0
  }
  if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
  if exprNullableStruct(exprIx, fnIx) {
    fbRefAsNonNull() // 0xd4
  }
  0
}

// Push the RAW union box ref of the binding `name` (a local/param or a module
// global) — bypassing the narrowed-unbox Ident path, so a tag read works even
// while the binding is narrowed to a single atom (its slot still holds the box;
// narrowing is type-level only).
function emitUnionBoxPush(_body: i32[], name: string, fnIx: i32) {
  const idx = localIndexOf(fnIx, name)
  if idx >= 0 {
    fbLocalGet(idx)
  } else {
    // A CAPTURED union box: read the field RAW out of the env (`recover` false — the box IS
    // the field's type, and the unbox every caller appends after this push is the recovery).
    // The narrowing that makes such a read an unbox at all is the closure's
    // DECLARATION-SITE narrowing, replayed onto the narrowing stack by `capNarrowSeed`;
    // without that replay the arms that call this never fire inside a lifted body.
    if emitCapturedRead(_body, name, fnIx, false) == 1 { return 0 }
    const gIdx = globalIndexOf(name)
    if gIdx < 0 {
      // Neither a local, a capture of this frame, nor a global — nothing to read the box
      // out of. A clean reject, not invalid wasm.
      return emitFail(
        "emitProgram: narrowed union binding is not a local or global",
      )
    }
    if emitUserGlobalGet(gIdx) < 0 { return -1 }
    // A non-const global box rides in a NULLABLE cell (start-fn initialized);
    // recover the non-null box ref (same as the plain Ident global read).
    if globalNameIsNonConst(name) {
      wU8(212) // 0xd4 ref.as_non_null
    }
  }
  0
}

// The list WRAPPER heap type a value-union LIST atom of kind `k` rides in the box's
// `anyref` payload — directly, with no scalar value box (the `is`-narrow casts to it, the
// coerce stores it) — or -1 when `k` is not a list kind.
// D-UNION-ATOM-KIND: keyed on the atom's KIND, not on its rendered spelling. The seven
// spelling questions this replaces — `i32[]`/`boolean[]`, a litunion array
// (`litUnionArrayElemOf`), `f64[]`, `string[]`, `i64[]`, `f32[]`, then `valueAtomKind` for
// the niche-nullable element forms — are each a partition of ONE `valueAtomKind` code:
// kind 7 is exactly the i32-list backings (`i32[]`, `boolean[]`, a litunion `K[]`, the
// `(boolean | null)[]` / `(K | null)[]` niches), kind 9 exactly the string-list backings
// (`string[]`, `(string | null)[]`), and kinds 8 / 10 / 12 arise ONLY from the exact
// spellings `f64[]` / `i64[]` / `f32[]`. Total and byte-faithful in both directions, and
// the caller — which already needs the kind for its tag and its value box — computes it once.
function listWrapHeapOfKind(k: i32) {
  if k == 7 { return lTypeIdx }
  if k == 8 { return fl64TypeIdx }
  if k == 9 { return mkListIdx }
  if k == 10 { return il64TypeIdx }
  if k == 12 { return fl32TypeIdx }
  -1
}

// The BANKED value-atom kind of the single member left when `null` is removed from the
// member set `s` — the structural form of `valueAtomKind(removeAtomFromSet(set,
// "null"))`, which four `… | null` peeling sites ask (`x ?? d` over an ident / a call /
// a union field, and a `scalar | null` map value read with a default).
//
// `msSubNull` already clears the null members' bits structurally; what the set ADT handed
// back was a RENDERED residual the callers re-parsed for the ABI code. Here the residual
// set keeps its identity: a singleton yields the member's kind straight out of the bank
// `recordUnMemTys` filled, a non-singleton -1 — the same answer `valueAtomKind` gives the
// rendered `""` / `"a|b"`. -2 = the pool does not cover the set (a narrowed subset spelling
// it never interned) and the caller keeps its rendered-atom path, exactly as
// `removeAtomFromSet` itself falls through to the string surgery there.
//
// D-SETONCE: takes a set ID, never a text — every caller already resolves the same set a
// line earlier for the value-union gate.
function unionResidualSoloKindOfSet(s: i32) {
  if s < 0 { return -2 }
  msSoloValKind(msSubNull(s))
}

// IS this union a VALUE union — the box question, asked of the interned member set the
// caller already resolved, and of the SPELLING only where the pool declines.
//
// D-VALUNION. The nine `isValueUnionName(nm)` sites here scanned the whole rendering twice
// (`unionMemberCount`, then `splitUnionAtoms`) and classified every atom materialized
// (`valueAtomKind`) — for a predicate over nothing but the member ABI codes the emitter
// banked at registration, which `msIsValueUnion` reads. The ONE surviving take-apart of the
// rendering, reached only where the pool never interned the set.
//
// **The set id is not resolved here, on purpose.** `msSetOfText` costs two map probes and,
// on a first miss, a linear scan of every registered row — charging it inside would bill
// every caller, including the two below that must NOT pay. Callers thread an id they
// already hold or resolve one they reuse; it is never re-derived.
//
// **The two sites that keep the spelling path, and why** — measured over 1,337 corpus
// files and 16,800 fuzz programs, not reasoned:
//   · `emitReturnValue` / the inferred-return `retUNm` pin classify
//     `inferRetNameOf(fn.fnName)`, a checker RENDER of an inferred return: 79,912 reaches,
//     of which the pool covers **47** (0.06%). A bank-first ladder would put that
//     resolution ahead of a path whose own first act (`unionMemberCount < 2`) already
//     cheap-rejects — a work REGRESSION, so it is left alone.
//   · `emit_rewrite`'s `synthRetAnnots` asks the same of the same producer
//     (`inferRetNameByNode`); the pool covers **0** of its 643 reaches.
// One producer — the inferred-return render — retired by the `inferRetTyByNode` hand-off,
// not by a consumer-side ladder.
// THE NAME FALLBACK RESOLVES A DECLARED ALIAS FIRST. `isValueUnionName` decides by splitting
// the name at top-level `|` and asking `valueAtomKind` of each atom, so an alias splits to ONE
// atom whose kind is -1 and the answer is a flat NO for every union the bank does not cover —
// while the INLINE spelling of the identical box answers YES. `type WN = N | string` over a
// numeric litunion `N` is the live instance: the inline `N | string` receiver took the `is`
// membership arm and the alias fell past every arm to the loud ``is` names a type that is not
// a union variant`. `unionMemberSetOf` returns a non-alias name unchanged, so this only ever
// hands the fallback the arms the working spelling already gave it.
function isValueUnionOfSet(s: i32, nm: string): boolean {
  const v = msIsValueUnion(s)
  if v >= 0 { return v == 1 }
  isValueUnionName(unionMemberSetOf(nm))
}

// True if a value-union atom of KIND `k` is a REF that rides the box's anyref `value`
// directly with no per-rep scalar value box: a string (kind 2 — `valueAtomKind` answers
// 2 for the spelling `string` and nothing else), any list type, or a CLOSURE (kind 11 —
// the fat-pointer struct is a `structref` subtype, so it stores into the box's anyref
// slot as-is).
function atomIsRefKind(k: i32) {
  if k == 2 { return true }
  if k == 11 { return true }
  return listWrapHeapOfKind(k) >= 0
}

// Lower a narrowed VALUE-union ident read `name` (active narrowing = a single scalar
// member, arriving as its ABI kind `ak`): push the box (a local/param or a module global),
// `struct.get $box 1` (the `anyref` payload), then recover the atom's rep — a
// `ref.cast (ref $aTypeIdx)` for a string payload (stored unboxed), or a
// `ref.cast (ref $vb)` + `struct.get $vb 0` for a scalar in its value box.
function emitValueUnionUnboxRead(
  body: i32[],
  name: string,
  ak: i32,
  fnIx: i32,
) {
  if emitUnionBoxPush(body, name, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  // D-UNION-ATOM-KIND: the atom's ABI code decides all four arms below (the `string`
  // compare, the closure test, the list-wrapper ladder, `vbHeapIdxOfAtom`), so `ak`
  // ARRIVES as the code — `emitCoalesce` already holds it out of the bank
  // (`unionResidualSoloKindOfSet`) and no longer renders a set just to be re-parsed here.
  if ak == 2 {
    fbRefCast(aTypeIdx) // the payload IS the string array ref
    return 0
  }
  // A CLOSURE atom's payload IS the closure fat-pointer struct — recover it from the box's
  // anyref slot so a narrowed `x is (() => i64)` read yields the callable fat pointer.
  if ak == 11 {
    fbRefCast(cloStructIdx)
    return 0
  }
  const lw = listWrapHeapOfKind(ak)
  if lw >= 0 {
    fbRefCast(lw) // the payload IS the list WRAPPER ref
    return 0
  }
  const vb = vbHeapIdxOfKind(ak)
  if vb < 0 {
    return emitFail("emitProgram: narrowed union atom has no value box")
  }
  fbRefCast(vb)      // 0xfb 0x16 <value box>
  fbStructGet(vb, 0) // the scalar payload
  0
}

// Recover the reflist WRAPPER ref a union binding narrowed to a REF-ELEMENT array arm holds
// (`if x is S[]` then `x[i]` / `x.length`): push the box, read its `anyref` value (field 1),
// `ref.cast` it to the arm's reflist wrapper heap. The ref-array analogue of
// `emitValueUnionUnboxRead`'s list-wrapper cast — the result is a `(ref $rlWrap)` the normal
// indexing / `.length` machinery consumes (it stored there in `emitUnionCoerce`'s ref-array box).
function emitRefArrayUnionUnboxRead(body: i32[], name: string, fnIx: i32) {
  if emitUnionBoxPush(body, name, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  // Destringify D-ISTY: the arm's reflist slot comes from the TYPE the narrowing
  // banked (`is S[]` recorded `S[]`'s arena index), not from slicing the element
  // spelling back out of the rendered arm name and re-resolving it.
  const slot = rlSlotOfTy(tyRefArrElemOf(narrowedArmTyOf(name)))
  if slot < 0 {
    return emitFail("emitProgram: narrowed ref-array arm has no reflist slot")
  }
  fbRefCast(rlWrapIdx[slot]) // 0xfb 0x16 <reflist wrapper> — the payload IS the wrapper ref
  0
}

// Recover the MAP STRUCT ref a union binding narrowed to a MAP arm holds (`if x is {[string]: V}`
// then `x[k]` / `x[k] ?? d` / `x.has(k)`): push the box, read its `anyref` value (field 1),
// `ref.cast` it to the arm's per-value map struct heap (`mapTypeIdxOf`, the mono `$mStructIdx` for
// an i32/atom value). The map analogue of `emitRefArrayUnionUnboxRead` — the result is the same
// `(ref $mapStruct)` a bare map binding pushes, which `emitMapPrep` stores into `mapRef`.
function emitMapUnionUnboxRead(body: i32[], name: string, fnIx: i32) {
  if emitUnionBoxPush(body, name, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  // Destringify D-ISTY: the arm's map-value slot comes from the TYPE the narrowing
  // banked, not from slicing `{[K]: V}`'s value text out of the rendered arm name.
  // SENTINEL: `mvSlotOfTy` answers -1 for an un-interned value exactly as the name
  // resolver does for a MONO/atom-valued map, and `mapTypeIdxOf(-1)` is that shared
  // `$mStructIdx` — so the two legs agree on the miss as well as on the hit.
  const armTy = narrowedArmTyOf(name)
  const slot = mvSlotOfTyK(tyMapValOf(armTy), tyMapKeyIsI32(armTy))
  fbRefCast(mapTypeIdxOf(slot)) // the payload IS the map struct ref
  0
}

// Route a list LITERAL flowing into a union whose matching arm is a UNION-BOX-ELEMENT
// ref-array (`(i32 | string)[] | {w: i32}`, `N[] | {w: i32}` over `type N = i32 | string`,
// `(C | D)[] | {w: i32}`) through that ARM's build: thread `pendingListKind = 2` + the arm's
// reflist slot so `emitArr` boxes each element into the union box (the same threading an
// annotated `let x: (i32|string)[] = [...]` binding does), then tag the wrapper with the
// arm's slot tag. Needed because the literal's OWN classification is a SCALAR list
// (`["a"]` → `string[]`) or a concrete struct list (`[{a:1}]` → `C[]`) — neither interns
// the arm's slot, so `emitUnionCoerce`'s slot-match path misses and the literal either
// mis-boxed through the value-atom ladder (tag `string[]`, every `is` against the arm
// silently FALSE — a live miscompile) or emitted a RAW wrapper into the box-typed slot
// (invalid wasm). The union's OWN value-atom list arm still wins (`i32[] | (i32|string)[]`
// boxes `[1]` as the exact `i32[]` atom — the ladder's job), guarded by `unionHasAtom`.
// Returns 1 = handled (boxed + tagged), 0 = not applicable (caller continues), -1 = error.
function emitUnionListLitViaRefArm(
  body: i32[],
  unionName: string,
  exprIx: i32,
  fnIx: i32,
) {
  if unionName == "" { return 0 }
  const bare = P.nodes[unwrapParen(exprIx)]
  if bare is ArrayLit {
    // Classify the FIRST element's member ATOM (the arm-choice key; each element still
    // coerces independently inside the build). An element this static probe cannot name
    // (a nested list / map) bails to the caller's existing paths.
    let elemAtom = ""
    if bare.arrElems.length >= 1 {
      const e0 = bare.arrElems[0]
      if exprArray(e0, fnIx) || exprRefArray(e0, fnIx) || exprMap(e0, fnIx) {
        return 0
      }
      if exprString(e0, fnIx) {
        elemAtom = "string"
      } else if exprIsBool(e0, fnIx) {
        elemAtom = "boolean"
      } else if exprIsF64(e0, fnIx) {
        elemAtom = "f64"
      } else if exprIsI64(e0, fnIx) {
        elemAtom = "i64"
      } else {
        const e0b = P.nodes[unwrapParen(e0)]
        if e0b is ObjLit {
          elemAtom = objVariantName(unwrapParen(e0))
          if elemAtom == "" { return 0 }
        } else {
          elemAtom = "i32" // the ladder's own integer default
        }
      }
      // The union's own value-atom LIST arm is the exact match — let the ladder box it.
      if unionHasAtomTy(unionName, elemAtom, true) { return 0 }
    } else {
      // An EMPTY `[]`: only route when NO value-atom list arm could claim it.
      if (
        unionHasAtomTy(unionName, "i32", true) ||
        unionHasAtomTy(unionName, "boolean", true) ||
        unionHasAtomTy(unionName, "string", true) ||
        unionHasAtomTy(unionName, "f64", true) ||
        unionHasAtomTy(unionName, "i64", true) ||
        unionHasAtomTy(unionName, "f32", true)
      ) {
        return 0
      }
    }
    const armSlot = unionRefArrayArmSlotForElem(unionName, elemAtom)
    if armSlot < 0 { return 0 }
    fbI32Const(refArrSlotTag(armSlot))
    const savedK = pendingListKind
    const savedS = pendingListSlot
    pendingListKind = 2
    pendingListSlot = armSlot
    const rc = emitExpr(body, exprIx, fnIx)
    pendingListKind = savedK
    pendingListSlot = savedS
    if rc < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
    return 1
  }
  0
}

// Route an ARRAY-LITERAL union carrier into the union's single NESTED-ARRAY arm
// (`string[][] | string`, `i64[][] | boolean | null` — `unionNestedArrayArmSlot`): tag with
// the arm's slot and build the literal with the arm's ref-list slot THREADED
// (`pendingListKind = 1` + slot, the authoritative threading an annotated `T[][]` binding
// uses), so each inner list builds the ARM's leaf. An `i64[][]` arm then widens bare-int
// leaves at the store (`[[50183]]` — the old "leaf-scalar widening across a nested array is
// unsupported" reject); a `string[][]` arm builds string inner lists (`[["ab"]]` — invisible
// to `exprRefArray`, so the ref-array carrier path missed it and the literal fell toward the
// scalar value-atom ladder's nested-array reject). Returns 1 when routed, 0 when the union
// has no unambiguous nested-array arm (the caller keeps its loud reject), -1 on a failure.
function emitUnionNestedListLit(
  body: i32[],
  unionName: string,
  exprIx: i32,
  fnIx: i32,
) {
  const bare = P.nodes[unwrapParen(exprIx)]
  if bare is ArrayLit {
    const armSlot = unionNestedArrayArmSlot(unionName)
    if armSlot < 0 { return 0 }
    fbI32Const(refArrSlotTag(armSlot))
    const savedK = pendingListKind
    const savedS = pendingListSlot
    pendingListKind = 1
    pendingListSlot = armSlot
    const rc = emitExpr(body, exprIx, fnIx)
    pendingListKind = savedK
    pendingListSlot = savedS
    if rc < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
    return 1
  }
  0
}

// The FUNCTION TYPE a closure carrier boxed into `unionName` tags as — the box side of
// `cloArmTagOfTy`, whose test side is `isArmTagOfTy`.
//
// THE VALUE'S OWN CHECKED TYPE IS THE ANSWER, NOT THE UNION'S ARM. A union may carry
// several function-typed arms; taking the arm made every one of them box under the first
// arm's tag, which is the whole of D6 — `x is F` answered TRUE for a value built through
// `G`. The checker banks the carrier's resolved type at the node (`nodeTyIxOf`), and for
// a lambda literal, a named-function reference and a closure-typed binding alike that is
// the `TyFunc` the value actually has.
//
// The union's own arm is the FALLBACK, for a carrier the checker banked no function type
// for; a union with ONE function arm then tags exactly as it did before, since the sole
// arm is the only type the value can have.
function cloBoxArmTy(exprIx: i32, unionName: string): i32 {
  const vt = nodeTyIxOf(exprIx)
  if unMemIsFunc(vt) { return vt }
  const bt = nodeTyIxOf(unwrapParen(exprIx))
  if unMemIsFunc(bt) { return bt }
  unionClosureArmTy(unionName)
}

// Lower the expression at `exprIx` COERCED into the boxed union `unionName`'s
// representation (the host's `coerceToUnion` at a flow boundary — a binding init, an
// assignment, an argument, a return). Pass-through when the value already IS the box (a
// union-typed ident / call, including a sub-union narrowing); a bare `null` boxes as the
// null tag with a `ref.null` payload (any boxed union — a value union OR a struct union
// with a `null` member); a raw scalar/string boxes as its atom's tag + payload. A struct
// union's object literal falls through to the normal lowering (`emitUnionBox` boxes it via
// the `uDeclared` path).
export function emitUnionCoerce(
  body: i32[],
  unionNameIn: string,
  exprIx: i32,
  fnIx: i32,
) {
  // Resolve a union ALIAS (`type Tagged = {x:i32} | string`) to its pipe-joined member set
  // so the value-atom boxing below (`unionHasValueAtom`/`unionHasAtom`/the atom ladder) sees
  // the atoms — an alias name has no `|` to split. An INLINE union name (already a member
  // set) and a non-union name resolve to "" and pass through unchanged.
  let unionName = unionNameIn
  const ums = unionMemberSetOf(unionName)
  if ums != "" { unionName = ums }
  if exprUnion(exprIx, fnIx) { return emitExpr(body, exprIx, fnIx) }
  const bareIx = unwrapParen(exprIx)
  const bare = P.nodes[bareIx]
  // An if-EXPRESSION join (`return if c { catVal } else { dogVal }`): each arm is a distinct
  // union member (a variant struct, a passed-through union, a scalar), so the join can't ride
  // a single numeric blocktype — emit a value-typed `if` whose result IS the union box,
  // union-coercing each arm. Without this the join defaults to an i32 blocktype over ref arms
  // (invalid wasm — a pre-existing gap that hits named functions too).
  if bare is IfStmt { return emitUnionIfValue(body, unionName, bareIx, fnIx) }
  if bare is NullLit {
    fbI32Const(nullBoxTag())
    fbRefNullNone() // the payload slot is unread under the null tag
    fbStructNew(uBoxIdx)
    return 0
  }
  // A STRUCT value (an object literal, or a struct-typed expr) auto-boxes through
  // `emitExpr`'s `uDeclared` variant path; only a SCALAR value is value-boxed below.
  // This is what lets a MIXED union (`A | i32`) coerce either kind of member: an object
  // arm boxes as a variant struct, a scalar arm as a value box.
  if bare is ObjLit {
    // The TARGET union's OWN arms are tried FIRST (`unionArmVariantForObj`): the global
    // scan below picks the first field-name-set match across ALL unions, which can land
    // on another union's arm sharing the names (two unions' nested-struct arms differing
    // only in the nested layout collided onto the first arm's tag — a silent wrong-arm
    // construct). A single-union program resolves the identical variant either way.
    const ctxVi = unionArmVariantForObj(unionName, bareIx)
    if ctxVi >= 0 { return emitUnionBoxAs(body, bareIx, ctxVi, fnIx) }
    // When the literal matches a union VARIANT, box it as that variant DIRECTLY rather than
    // routing through `emitExpr` — whose `structIndexOfObj` re-inference a field-name
    // COLLISION with an enclosing struct (an inner `{f:string}` arm boxed into a field of an
    // outer `{f: …}` struct) mis-resolves to the outer struct, emitting invalid wasm (the
    // nested struct-of-struct-union field hole). `objVariantName` is the SAME resolution
    // `emitObjLitNode`'s own union-box fallback uses, so this only reorders it ahead of the
    // struct-index guess; a literal matching no variant keeps `emitExpr`.
    if objVariantName(bareIx) != "" { return emitUnionBox(body, bareIx, fnIx) }
    return emitExpr(body, exprIx, fnIx)
  }
  // A struct-typed IDENT / call result that IS a variant arm of `unionName` but was built
  // as the plain struct (a DISTINCT heap type from the arm's variant struct — the twin the
  // `sHeapIdx`/`uVarHeap` tables never cross-dedup): the raw passthrough below emits the
  // plain ref where the box wants the variant struct (invalid wasm for an ident; a runtime
  // cast trap once boxed). Re-box it against the matched arm (`emitStructExprAsVariantBox`,
  // which stashes a non-re-readable multi-field CALL source in the reserved scratch slot).
  // Gated on the heaps DIFFERING so an already-deduped shape keeps the byte-identical raw pass.
  if unionName != "" && exprStruct(exprIx, fnIx) {
    const rbVi = unionArmVariantForStructExpr(unionName, exprIx, fnIx)
    if rbVi >= 0 {
      const rbSsi = structIndexOfExpr(exprIx, fnIx)
      if rbSsi >= 0 && sHeapIdx[rbSsi] != uVarHeap[rbVi] {
        return emitStructExprAsVariantBox(body, exprIx, rbVi, rbSsi, fnIx)
      }
    }
  }
  if exprStruct(exprIx, fnIx) { return emitExpr(body, exprIx, fnIx) }
  // A bare VARIANT value (a kind-8 local/param/call — its binding classified concrete via
  // `letIsVariant`, which runs BEFORE the union case): a variant-init binding's own slot IS
  // the raw variant ref, so pass it through — the same contract the `!unionHasValueAtom`
  // fall-through below gives a struct-only union. Without this arm a union carrying a VALUE
  // atom (`{f: K0} | i64`) dropped the variant ref into the scalar atom ladder and widened
  // the ref (invalid wasm). A box-typed position (arg / return / element / map default)
  // routes through `emitUnionBoxArg`, which boxes the variant ref BEFORE deferring here.
  if exprVariantIndex(exprIx, fnIx) >= 0 { return emitExpr(body, exprIx, fnIx) }
  // A MAP carrier (`{[string]: string}`, `{[string]: i32}`) flowing into a union with a matching
  // map arm: the map STRUCT ref rides the box anyref directly (like a reflist wrapper), tagged by
  // its interned value-slot (`mapSlotTag`). Checked BEFORE the value-atom gate below — such a union
  // may have NO value atom (`{[string]:string} | {w:i32}`), so that gate would bail and emit the RAW
  // map ref where a `(ref $uBox)` is expected. The slot match guards a map whose value is not an arm.
  if unionName != "" && exprMap(exprIx, fnIx) {
    let mSlot = mapShapeOfExpr(exprIx, fnIx)
    if mSlot == -2 {
      mSlot = -1 // a Set rides the mono map slot
    }
    if mSlot >= -1 && unionHasMapArmSlot(unionName, mSlot) {
      fbI32Const(mapSlotTag(mSlot))
      if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
      fbStructNew(uBoxIdx) // { tag, map-struct ref }
      return 0
    }
    // A MONO litunion-valued map (`{[string]: K0}` — `mapShapeOfExpr` folds the atom values to
    // the mono i32 map, slot -1) whose union arm registered through a RENDERED spelling
    // (`{[string]: string}` — the checker render widens a litunion map VALUE to `string`, so a
    // lambda's pinned result union or an inline expanded-litunion annotation interned the
    // STRING-map slot): the slot match above misses, but the collapsed arm IS this value's arm.
    // Box the mono map ref under the MONO tag — the same `mapSlotTag(-1)` an `is {[string]: K0}`
    // test derives from its own (litunion → mono) spelling — so store and narrow resolve one tag.
    if (
      mSlot == -1 &&
      nodeTyMapValIsLitUnion(bareIx) &&
      unionHasCollapsedStringMapArm(unionName)
    ) {
      fbI32Const(mapSlotTag(-1))
      if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
      fbStructNew(uBoxIdx) // { tag, mono map-struct ref }
      return 0
    }
  }
  // A MAP carrier the union does NOT box (a checker-impossible slot mismatch, or an unsupported map
  // VALUE type `mapShapeOfExpr` returns -3 for): fail loudly rather than default the tag and let
  // every later `is` silently miss — a SILENT wrong result. The pre-fix behaviour for ALL map arms.
  if exprMap(exprIx, fnIx) {
    return emitFail(
      "emitProgram: a map value is not a supported union member — use a struct member instead",
    )
  }
  // A REF-ELEMENT array carrier (`S[]`, `(() => f64)[]`, `(C | D)[]`) flowing into a union with a
  // matching ref-array arm: the reflist WRAPPER ref rides the box anyref directly (like a scalar-
  // list wrapper), tagged by its interned slot (`refArrSlotTag`). Checked BEFORE the value-atom
  // gate below — such a union may have NO value atom (`S[] | {w:i32}`), so that gate would bail and
  // emit the RAW wrapper ref where a `(ref $uBox)` is expected (the pre-fix invalid-wasm). The slot
  // match guards against a ref-array whose element is not actually an arm (a checker-impossible case).
  if unionName != "" && exprRefArray(exprIx, fnIx) {
    const raSlot = refListSlotOfExpr(exprIx, fnIx)
    if unionHasRefArrayArmSlot(unionName, raSlot) {
      fbI32Const(refArrSlotTag(raSlot))
      if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
      fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
      return 0
    }
    // A ref-array LITERAL whose own slot mismatches (`[{a:1}]` self-classifies as the
    // concrete `C[]` while the arm is `(C | D)[]`): route it through the union-box-element
    // arm's build if one admits its element.
    const viaArm = emitUnionListLitViaRefArm(body, unionName, exprIx, fnIx)
    if viaArm < 0 { return -1 }
    if viaArm == 1 { return 0 }
    // A ref-array LITERAL whose interned slot matches no arm but whose union has ONE
    // nested-array arm (`[[50183]]` self-classified `i32[][]` into `i64[][] | boolean |
    // null`): rebuild it through the ARM's slot — the arm's inner-list build widens the
    // bare-int leaves at the store (`emitExprAsI64`), so no in-place re-encode is needed.
    const viaNest = emitUnionNestedListLit(body, unionName, exprIx, fnIx)
    if viaNest < 0 { return -1 }
    if viaNest == 1 { return 0 }
    // A ref-element array carrier whose interned slot matches NO ref-array arm of the union —
    // a nested-literal case lands on the nested-arm route above; what remains is a non-literal
    // carrier (a `i32[][]` BINDING into an `i64[][] | …` arm — its built leaves cannot re-encode
    // in place) or an ambiguous/absent arm. Falling through would mis-box the wrapper ref through
    // the scalar value-atom ladder below (`struct.new` a scalar box on a ref → "expected i32, found
    // (ref $type)", invalid wasm). A ref array can only ride the box as a wrapper ref, so with no arm to
    // carry it there is no sound rep — fail loudly rather than emit the bad box.
    return emitFail(
      "emitProgram: array value does not match any array member of the union (leaf-scalar widening across a nested array is unsupported)",
    )
  }
  // An ARRAY LITERAL whose ELEMENT is a MAP (`[m]`, `m: {[string]: V}`) flowing into a union with an
  // array-of-map arm (`{[string]: V}[] | scalar`): the arm's reflist element is the map TYPE, but a
  // map-valued literal element is invisible to `exprRefArray` / `arrLitElemName` (they resolve an
  // inline-STRUCT element — wired via `internShapeDeep`'s union-arm descent — but not a map Ident),
  // so the ref-array arm path above is skipped. Route it through the ARM's build: the element's map
  // SHAPE (`mapShapeOfExpr` — mono -1 or a typed mv slot) picks the arm whose element map has the
  // SAME canonical value rep (`unionRefArrayArmSlotForMapElem`), then the literal builds with the
  // arm's reflist slot threaded (the same `pendingListKind = 1` an annotated `{[string]: V}[]`
  // binding uses) and the wrapper is tagged with the arm's slot tag. A literal whose element shape
  // matches NO arm keeps the loud reject — falling through would store the reflist WRAPPER ref into
  // a scalar value box (invalid wasm).
  if unionName != "" && bare is ArrayLit {
    if bare.arrElems.length >= 1 && exprMap(bare.arrElems[0], fnIx) {
      const mapArmSlot = unionRefArrayArmSlotForMapElem(
        unionName,
        mapShapeOfExpr(bare.arrElems[0], fnIx),
      )
      if mapArmSlot >= 0 {
        fbI32Const(refArrSlotTag(mapArmSlot))
        const savedMK = pendingListKind
        const savedMS = pendingListSlot
        pendingListKind = 1
        pendingListSlot = mapArmSlot
        const mrc = emitExpr(body, exprIx, fnIx)
        pendingListKind = savedMK
        pendingListSlot = savedMS
        if mrc < 0 { return -1 }
        fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
        return 0
      }
      return emitFail(
        "emitProgram: a union arm that is an array-of-map is not yet supported — use a named element type",
      )
    }
    // A NESTED array literal whose leaf does NOT self-classify as a ref array
    // (`[["ab"]]` — a string-leaf inner makes `arrLitIsRef` false, so the
    // `exprRefArray` carrier path above missed it entirely) flowing into a union
    // with one nested-array arm (`string[][] | string`): route through the arm's
    // build, exactly like the self-classified mismatch case.
    if bare.arrElems.length >= 1 {
      const bareE0 = P.nodes[bare.arrElems[0]]
      if bareE0 is ArrayLit {
        const viaNest2 = emitUnionNestedListLit(body, unionName, exprIx, fnIx)
        if viaNest2 < 0 { return -1 }
        if viaNest2 == 1 { return 0 }
      }
    }
  }
  // A bare CLOSURE carrier (`() => i64`, a lambda literal or a closure-typed binding) flowing into
  // a union with a bare-closure arm (`(() => i64) | {w:i32}`, `(() => i64) | i32`): the closure
  // fat-pointer struct (`$cloStructIdx`, a `structref` subtype) rides the box anyref directly — like
  // a scalar-list wrapper — tagged by the closure arm's `scalarTagOf` (value-atom KIND 11). Checked
  // BEFORE the value-atom classification ladder below, whose scalar branches would default the
  // closure to `i32`/`i64` and store the ref into a scalar value box (the pre-fix invalid-wasm:
  // "expected i32, found (ref $type)"). The arm-name match guards a closure with no matching arm.
  if unionName != "" && exprIsClosure(exprIx, fnIx) {
    const clArm = unionClosureArmName(unionName)
    if clArm != "" {
      fbI32Const(cloArmTagOfTy(cloBoxArmTy(exprIx, unionName)))
      if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
      fbStructNew(uBoxIdx) // { tag, closure fat-pointer ref }
      return 0
    }
  }
  // A SCALAR-element list literal (`["a"]`, `[1]` — invisible to `exprRefArray`) whose union
  // arm is a union-box-element ref-array (`(i32 | string)[] | {w: i32}`): route it through the
  // arm's build + tag. Checked BEFORE the value-atom gate/ladder below — the gate would emit
  // the RAW wrapper into the box slot (invalid wasm) and the ladder would tag the box with the
  // scalar-list atom (`string[]`) instead of the arm's slot tag, so every `is` against the arm
  // was silently FALSE (the live-miscompile half of this family).
  const viaListArm = emitUnionListLitViaRefArm(body, unionName, exprIx, fnIx)
  if viaListArm < 0 { return -1 }
  if viaListArm == 1 { return 0 }
  if unionName == "" || !unionHasValueAtom(unionName) {
    return emitExpr(body, exprIx, fnIx)
  }
  // D-ATOMSTORE — an ATOM-typed VALUE entering the box (slice A of
  // `docs/internals/litunion-compact-rep-design.md`, family F1). ABOVE the value-atom
  // ladder, because the ladder cannot classify this value at all: `valueAtomKind("K")` is
  // -1, so a `K`-typed local/param/call result falls past every branch to the numeric
  // default and then to the union's own promotion rules. Measured on master at `b7566067`,
  // 184 cells (8 mixed spellings x 3 carriers x 8 positions), ZERO of them correct:
  //   · `K | f64` — `cak` promotes to 4 and the body is `f64.convert_i32_s` applied to the
  //     ATOM ID under the f64 tag. `is K` compares tag 2 and is false: SILENT wrong answer.
  //   · `K | i32` / `K | i64` / `K | boolean` / `K | {w:i32}` — the raw id boxes under the
  //     wrong tag, same silent miss.
  //   · `K | string` / `K | i32[]` — the id is pushed at the box's `anyref` payload:
  //     "type mismatch: expected anyref, found i32". INVALID WASM, `vl check` rc 0.
  // The value's rep IS the interned i32 id and the box's payload is a REF, so the store has
  // to WIDEN — `emitAtomToStr`'s `select` tower over the member constants — and tag the box
  // kind 2, which is the tag `isArmTagOfTy` already hands a litunion arm by hand
  // (`if tyIsLitUnion(ity) { ak = 2 }`). Store and `is` then resolve one tag.
  //
  // THE HAZARD IS THE RESERVATION SCAN, NOT THIS EMIT. `emitAtomToStr` stashes the id in
  // the string-op scratch frame (`setStrScrI`), reserved by `emit_classify`'s scan — whose
  // atom-widening predicates all keyed on the target being spelled `string`. A union target
  // carrying a litunion arm is their missing SIXTH member; `unionTakesAtomAsStr` is the
  // shared question, asked here and at all six scan sites. Adding this leg without the
  // reservation is invalid wasm (measured: 96 cells, and the frame is per-FUNCTION so the
  // miss lands on whichever local the layout put at `strScratchBase + 3`).
  if unionTakesAtomAsStr(unionName) && exprIsLitAtom(exprIx, fnIx) {
    fbI32Const(scalarTagOfKind(2)) // the string tag — kind 2 rides the anyref directly
    if emitAtomToStr(body, exprIx, fnIx) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, member-string ref }
    return 0
  }
  // Classify the value's atom. Order mirrors the print-import ladder (f32 before
  // f64 — a float literal classifies f64 too; string/bool/i64 are disjoint). The
  // default is i32 unless the union has no `i32` member but does have `i64` (an
  // integer flowing into `i64 | …`), or the literal exceeds the i32 range.
  //
  // D-COERCEKIND (#1110 / #1128): the ladder settles the value-atom CODE, not a SPELLING.
  // Every consumer below — the box TAG, the rides-the-anyref test, the scalar value box,
  // the six `atom == …` compares picking the widened emit, the two list re-encodes — is a
  // projection of that one code. FAITHFUL because the map IS `valueAtomKind`'s own
  // first-match ladder, a bijection over exactly these eleven lexemes: nothing below its
  // literal compares can produce 0–5, and codes 7 / 8 / 9 / 10 / 12 name one list backing
  // each. Each arm's comment names the atom it stands for.
  let cak = 0 // "i32"
  if exprString(exprIx, fnIx) {
    cak = 2 // "string"
  } else if exprStringArray(exprIx, fnIx) {
    cak = 9 // "string[]" — a list member rides as a wrapper ref (like a string)
  } else if exprF32Array(exprIx, fnIx) {
    // Checked BEFORE the f64 arm: an f32-typed list value (an `f32[]` local/param/
    // narrowed read) must not be mis-claimed as `f64[]`. A bare float LITERAL still
    // classifies f64 (`exprF32Array` never claims it) — the `f64[]` → `f32[]`
    // re-encode below retargets it when only the f32 arm exists.
    cak = 12 // "f32[]"
  } else if exprF64Array(exprIx, fnIx) {
    cak = 8 // "f64[]"
  } else if exprI64Array(exprIx, fnIx) {
    cak = 10 // "i64[]"
  } else if exprArray(exprIx, fnIx) {
    cak = 7 // "i32[]"
  } else if exprIsF32(exprIx, fnIx) {
    cak = 5 // "f32"
  } else if exprIsF64(exprIx, fnIx) {
    cak = 4 // "f64"
  } else if exprIsI64(exprIx, fnIx) {
    cak = 3 // "i64"
  } else if exprIsBool(exprIx, fnIx) {
    cak = 1 // "boolean"
  } else {
    // D-VALKIND: ONE set resolution for both arm tests, each answered from the
    // banked kind column. Resolved HERE rather than beside the alias peel above, so
    // a coercion that never reaches this arm pays nothing.
    const usid = msSetOfText(unionName)
    if (
      !unionHasAtomK(usid, unionName, "i32", 0) &&
      unionHasAtomK(usid, unionName, "i64", 3)
    ) {
      cak = 3 // "i64"
    }
    if bare is NumLit {
      if !numLexFitsI32(bare.numText) {
        cak = 3 // "i64"
      }
    }
    // THE MISSING HALF OF THIS LADDER'S OWN LIST TWIN. The i32 default above promotes to
    // `i64` when the union has no i32 atom — but the LIST arm below (`cak == 7`) promotes
    // an i32-element list to i64[] / f64[] / f32[], THREE targets, on exactly the same
    // reasoning. The scalar arm was taught only the first, so an integer flowing into a
    // union whose only numeric atom is a FLOAT stayed `cak = 0` and boxed an i32 into the
    // f64/f32 value box: `const x: f64 | null = 1` is `vl check`-clean INVALID WASM on
    // master ("expected anyref, found i32") in the global, local AND argument positions,
    // while `const x: i64 | null = 1` (the taught half) and `const x: f64 | null = 1.0`
    // (a float literal, which classifies `cak = 4` up the ladder) both run. Verified
    // against master before the fix. Ordered f64-before-f32 to match the list arm.
    if cak == 0 && !unionHasAtomK(usid, unionName, "i32", 0) {
      if unionHasAtomK(usid, unionName, "f64", 4) {
        cak = 4 // "f64"
      } else if unionHasAtomK(usid, unionName, "f32", 5) {
        cak = 5 // "f32"
      }
    }
  }
  // A float literal types f64 by default, but if the union's float atom is f32 (`f32 | string`,
  // no f64) the literal re-encodes at f32 — pick the f32 atom so it boxes into the f32 value box.
  // D-VALKIND: the `cak == 4` gate is hoisted out of the `&&` chain so the set
  // resolution below is paid only by a float-classified value, not by every coercion.
  if cak == 4 {
    const fsid = msSetOfText(unionName)
    if (
      !unionHasAtomK(fsid, unionName, "f64", 4) &&
      unionHasAtomK(fsid, unionName, "f32", 5)
    ) {
      cak = 5 // "f32"
    }
  }
  // An INT-element list whose union has no `i32[]` member but an `i64[]`/`f64[]` one
  // (`i64[] | boolean = [670563]` — the elements are small int literals, so the list
  // classifies `i32[]`): the union demands the wider list — adopt its atom and thread the
  // element kind, so the backing builds `(array (mut i64/f64))` with each element widening
  // at the store (as an annotated `let` does). Without this the box TAGGED `i32[]` while
  // the checker typed the member `i64[]` — `is i64[]` was silently FALSE.
  let coerceListKind = 0
  if cak == 7 && !unionHasAtomTy(unionName, "i32", true) {
    if unionHasAtomTy(unionName, "i64", true) {
      cak = 10 // "i64[]"
      coerceListKind = 6
    } else if unionHasAtomTy(unionName, "f64", true) {
      cak = 8 // "f64[]"
      coerceListKind = 4
    } else if unionHasAtomTy(unionName, "f32", true) {
      cak = 12 // "f32[]"
      coerceListKind = 7
    }
  }
  // The LIST twin of the f64 → f32 scalar re-encode above: a float-element literal
  // classifies `f64[]`, but if the union's only float-list atom is `f32[]` the checker
  // adopted that arm — build the f32 backing (kind 7 threads `pendingListKind`, so each
  // element re-encodes at f32 at the store) and tag the box with the f32-list atom.
  if (
    cak == 8 &&
    !unionHasAtomTy(unionName, "f64", true) &&
    unionHasAtomTy(unionName, "f32", true)
  ) {
    cak = 12 // "f32[]"
    coerceListKind = 7
  }
  // `cak` is final at this point: every arm of the ladder above assigns before the
  // tag is emitted, and the box TAG, the rides-the-anyref test and the scalar value
  // box below are all projections of it (`scalarTagOf` / `atomIsRefKind` /
  // `vbHeapIdxOfAtom` each re-derived it from the spelling).
  fbI32Const(scalarTagOfKind(cak))
  if cak == 3 {
    if emitExprAsI64(body, exprIx, fnIx) < 0 { return -1 }
  } else if cak == 4 {
    if emitExprAsF64(body, exprIx, fnIx) < 0 { return -1 }
  } else if cak == 5 {
    const savedF32 = pendingF32
    pendingF32 = true
    if emitExprAsF32(body, exprIx, fnIx) < 0 { return -1 }
    pendingF32 = savedF32
  } else if coerceListKind != 0 {
    const savedCLK = pendingListKind
    pendingListKind = coerceListKind
    const rcCLK = emitExpr(body, exprIx, fnIx)
    pendingListKind = savedCLK
    if rcCLK < 0 { return -1 }
  } else {
    if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
  }
  // A `string` / list member is a REF and rides the box's anyref `value` directly; only a
  // SCALAR atom wraps in its per-rep value box.
  if !atomIsRefKind(cak) {
    const vb = vbHeapIdxOfKind(cak)
    if vb < 0 { return emitFail("emitProgram: union atom has no value box") }
    fbStructNew(vb) // wrap the scalar payload
  }
  fbStructNew(uBoxIdx) // { tag, payload }
  0
}

// Coerce an expression into a union-BOX position whose wasm rep is `(ref $uBox)` — a call
// ARGUMENT to a union param, or a RETURN typed as the union. A concrete VARIANT-struct
// VALUE (`s: S` passed to a `C | S` param, or returned from a `: C | S` function) is a raw
// `(ref $variant)`: a struct that is a union member is allocated as a kind-8 variant local
// so it narrows in place, but that raw ref does NOT match the boxed param/return rep —
// passing / returning it was invalid wasm ("expected (ref $type), found (ref $type)"). Box
// it into the shared `{tag, payload}` rep exactly as `emitUnionBox` boxes a struct LITERAL
// (the variant ref IS the payload type the box wants — no field copy). Every other shape —
// a struct literal, a passed-through union value, a scalar atom — defers to
// `emitUnionCoerce`. Box-typed positions ONLY; a let-init to a union-annotated-but-
// variant-init local stays a raw kind-8 variant and calls `emitUnionCoerce` directly.
function emitUnionBoxArg(
  body: i32[],
  unionName: string,
  exprIx: i32,
  fnIx: i32,
) {
  if !exprUnion(exprIx, fnIx) {
    const svi = exprVariantIndex(exprIx, fnIx)
    if svi >= 0 {
      // A struct-typed value BUILT as the plain struct (an anonymous union arm returned
      // from a `: {…}` function / bound to a struct local) is a layout TWIN of — but a
      // DISTINCT heap type from — the arm's variant struct. Boxing the raw plain ref
      // validates but the narrow's `ref.cast (ref uVarHeap[svi])` TRAPS at runtime.
      // Rebuild it against the arm instead (`emitStructExprAsVariantBox` re-emits a re-
      // readable/single-field source per field, or stashes a non-re-readable multi-field
      // CALL in the reserved scratch slot; a genuine kind-8 variant local resolves `ssi < 0`
      // and boxes raw as before).
      const bssi = structIndexOfExpr(exprIx, fnIx)
      if bssi >= 0 && sHeapIdx[bssi] != uVarHeap[svi] {
        return emitStructExprAsVariantBox(body, exprIx, svi, bssi, fnIx)
      }
      fbI32Const(uTags[svi]) // 0x41 i32.const <variant tag> (program-global)
      if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
      fbStructNew(uBoxIdx) // { tag, variant-ref }
      return 0
    }
  }
  emitUnionCoerce(body, unionName, exprIx, fnIx)
}

// Lower an if-EXPRESSION whose VALUE is a union (`if c { A } else { B }` in a union return /
// coerce position) as a value-typed `if` with the union BOX result type, each arm
// union-coerced (`emitUnionCoerce`). Mirrors `emitIfExprAs` (narrowing save/restore, `else
// if` recursion) but the blocktype is the `(ref $uBox)` valtype, not a numeric byte, and arms
// route through `emitUnionCoerce` so a variant-struct / passthrough / scalar arm each boxes to
// the same union rep.
function emitUnionIfValue(
  body: i32[],
  unionName: string,
  ifIx: i32,
  fnIx: i32,
) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    if s.ifElse < 0 {
      return emitFail("emitProgram: union if-expression requires an else arm")
    }
    if emitExpr(body, s.ifCond, fnIx) < 0 { return -1 }
    wU8(4)                 // 0x04 if
    fbValtype("union", -1) // result blocktype: the union box `(ref $uBox)`
    // Count the frame: a `br` emitted anywhere inside an arm takes its operand from
    // `ctrlDepth`, and the union return sink's branch to the function exit block is one.
    // Nothing branch-bearing reaches an arm today (each is a single value expression),
    // so this is currently byte-neutral — and the failure mode if it were dropped is an
    // off-by-one `br` operand, i.e. invalid wasm rather than a wrong answer.
    ctrlEnter()
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const rcT = emitUnionIfArm(body, unionName, s.ifThen, fnIx)
    if narrowed { restoreNarrow(savedTop) }
    if rcT < 0 { return -1 }
    fbElse() // 0x05 else
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    const els = P.nodes[s.ifElse]
    let rc = 0
    if els is IfStmt {
      rc = emitUnionIfValue(body, unionName, s.ifElse, fnIx)
    } else {
      rc = emitUnionIfArm(body, unionName, s.ifElse, fnIx)
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    ctrlLeave()
    return 0
  }
  emitFail("emitProgram: expected a union if-expression")
}

// One arm of a union if-expression: the arm's prelude, then its tail-value statement
// union-coerced to the box rep (`emitUnionCoerce` — a variant struct boxes, a passthrough
// union rides as-is, a scalar value-boxes).
function emitUnionIfArm(
  body: i32[],
  unionName: string,
  blockIx: i32,
  fnIx: i32,
) {
  const b = P.nodes[blockIx]
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if stmtIsTailValue(tv, fnIx) {
        if emitIfArmOpen(body, blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        // The if-value's result IS the union BOX `(ref $uBox)` (the blocktype), so a CONCRETE-
        // VARIANT arm (`cat`, a kind-8 `(ref $variant)` local/value — `if c then cat else dog`)
        // must be BOXED to match, exactly as a variant return/argument is: `emitUnionBoxArg`
        // boxes a variant ref and defers every other shape (object literal, passthrough union,
        // scalar) to `emitUnionCoerce`. Plain `emitUnionCoerce` emitted the raw variant ref —
        // invalid wasm ("expected (ref $uBox), found (ref $variant)").
        return emitIfArmClose(emitUnionBoxArg(body, unionName, tv, fnIx))
      }
    }
    return ifArmNoValueFail("union if-expression arm", blockIx)
  }
  emitFail("emitProgram: union if-expression arm is not a block")
}

// Coerce the expression at `exprIx` to the CONCRETE variant `vi`'s rep `(ref
// $(uVarHeap[vi]))`. The collapse boundary: a `.map` callback typed as one variant whose arms are a
// MIX of reps — an object LITERAL (build the bare variant), a NARROWED union value (`a`
// after `a is Cat`, still a box at the wasm level → unbox: `struct.get $box 1` + `ref.cast`
// to the variant), an already-bare variant (pass through), or a value-`if` join (recurse).
// The variant analogue of `emitUnionCoerce`.
function emitVariantCoerce(body: i32[], vi: i32, exprIx: i32, fnIx: i32) {
  const bareIx = unwrapParen(exprIx)
  const bare = P.nodes[bareIx]
  if bare is IfStmt { return emitVariantIfValue(body, vi, bareIx, fnIx) }
  if bare is ObjLit { return emitVariantStruct(body, bareIx, vi, fnIx) }
  // Already the bare variant struct (a variant param/local/call/index): pass through.
  if exprVariantIndex(exprIx, fnIx) >= 0 { return emitExpr(body, exprIx, fnIx) }
  // A union BOX (a narrowed receiver still boxed at the wasm level): unbox to the variant.
  if exprUnion(exprIx, fnIx) {
    if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    fbRefCast(uVarHeap[vi]) // 0xfb 0x16 <variant struct> ref.cast (non-null)
    return 0
  }
  emitExpr(body, exprIx, fnIx)
}

// Lower an if-EXPRESSION whose VALUE collapses to the concrete variant `vi` as a value-
// typed `if` with the variant struct result blocktype, each arm variant-coerced. Mirrors
// `emitUnionIfValue` (narrowing save/restore, `else if` recursion).
function emitVariantIfValue(body: i32[], vi: i32, ifIx: i32, fnIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    if s.ifElse < 0 {
      return emitFail("emitProgram: variant if-expression requires an else arm")
    }
    if emitExpr(body, s.ifCond, fnIx) < 0 { return -1 }
    wU8(4)                   // 0x04 if
    fbValtype("variant", vi) // result blocktype: the variant struct `(ref $(uVarHeap[vi]))`
    ctrlEnter()              // count the frame — see `emitUnionIfValue`
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const rcT = emitVariantIfArm(body, vi, s.ifThen, fnIx)
    if narrowed { restoreNarrow(savedTop) }
    if rcT < 0 { return -1 }
    fbElse()                 // 0x05 else
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    const els = P.nodes[s.ifElse]
    let rc = 0
    if els is IfStmt {
      rc = emitVariantIfValue(body, vi, s.ifElse, fnIx)
    } else {
      rc = emitVariantIfArm(body, vi, s.ifElse, fnIx)
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    ctrlLeave()
    return 0
  }
  emitFail("emitProgram: expected a variant if-expression")
}

// One arm of a variant if-expression: the arm's prelude, then its tail-value statement
// coerced to the concrete variant rep.
function emitVariantIfArm(body: i32[], vi: i32, blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if stmtIsTailValue(tv, fnIx) {
        if emitIfArmOpen(body, blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        return emitIfArmClose(emitVariantCoerce(body, vi, tv, fnIx))
      }
    }
    return ifArmNoValueFail("variant if-expression arm", blockIx)
  }
  emitFail("emitProgram: variant if-expression arm is not a block")
}

// ── union `==`/`!=` (the host's structural-equality union branch) ─────────────
// `==`/`!=` are structural by value, so a still-BOXED value-union operand
// compares by "does the box's tag select the arm whose rep matches the other
// side, AND does the unboxed payload value-equal it". The tag compare GATES the
// payload compare (the payload `ref.cast` would trap on a wrong-rep arm), as a
// value-typed `if` (blocktype 0x7f) — the same short-circuit `toWasm.ts` folds.
// REPRESENTATION NOTE: the host hoists each box into a fresh local so the tag
// read and the payload read share one evaluation; this emitter RE-EVALUATES the
// operand instead (the established struct-`==` re-evaluation pattern), so a
// union operand is restricted to a simple BINDING read — re-reading an ident is
// effect-free and yields the same box. Anything effectful fails loudly.

// Unbox a union payload already pushed as `anyref` (`struct.get $box 1`) to the rep
// of the arm whose value-atom KIND is `k`: a string payload (kind 2) IS the string
// array (cast only); a scalar rides its per-rep value box (cast + field 0). Mirrors
// `emitValueUnionUnboxRead`.
//
// D-UNION-ATOM-KIND: the two questions this asked of the atom's SPELLING —
// `atom == "string"` and `vbHeapIdxOfAtom(atom)` — are both projections of that one
// code, and every caller already holds it (the box TAG it emits one instruction
// earlier IS `scalarTagOfKind` of the same code, and `emitUnionUnionEq`'s arms carry
// it out of the BANK). `valueAtomKind` answers 2 for the spelling `string` and for
// nothing else, so the kind test is the same partition, not a widening; a member that
// is not a value atom at all (a litunion alias `K0`, code -1) reaches
// `vbHeapIdxOfKind(-1)` = -1 and the same loud reject the spelling path gave.
function emitUnionPayloadUnbox(_body: i32[], k: i32) {
  if k == 2 {
    fbRefCast(aTypeIdx) // the payload IS the string array ref
    return 0
  }
  const vb = vbHeapIdxOfKind(k)
  if vb < 0 { return emitFail("emitProgram: union `==` atom has no value box") }
  fbRefCast(vb)      // 0xfb 0x16 <value box>
  fbStructGet(vb, 0) // the scalar payload
  0
}

// Emit the concrete operand at `otherIx` in the rep of the arm whose value-atom KIND
// is `k` (the host's `withDesiredType(member, …)` — an i32 literal widens to the arm's
// i64/f64/f32). D-UNION-ATOM-KIND: the three spelling compares this ran are the codes
// 3 / 4 / 5, which `valueAtomKind` assigns to `i64` / `f64` / `f32` and to no other
// spelling — the caller's single derivation answers all three.
function emitUnionEqOther(body: i32[], otherIx: i32, k: i32, fnIx: i32) {
  if k == 3 { return emitExprAsI64(body, otherIx, fnIx) }
  if k == 4 { return emitExprAsF64(body, otherIx, fnIx) }
  // The STRING arm's widening twin of the three numeric ones: a literal-union ATOM operand
  // becomes its member string (`emitStrValue`), which is the rep the box's string payload is
  // compared against. `emitStrValue` is `emitExpr` for everything that is already a string.
  if k == 2 { return emitStrValue(body, otherIx, fnIx) }
  if k == 5 {
    const savedF32 = pendingF32
    pendingF32 = true
    if emitExprAsF32(body, otherIx, fnIx) < 0 { return -1 }
    pendingF32 = savedF32
    return 0
  }
  emitExpr(body, otherIx, fnIx)
}

// The union-box ATOM test, asked of the BANKED member kinds first and of the
// name-keyed arena row only where the bank declines — D-VALKIND, the ladder every
// scalar-keyword `unionHasAtomTy(nm, kw, false)` in this file now takes.
//
// `s` is the interned member SET the caller already resolved (the whole point: the callee
// otherwise re-resolves the union from its NAME per call — `unionRowOf`, a linear scan of
// `unNames` then of `unMemberSet`, both whole-string compares). `k` is the atom's ABI KIND,
// which at five of these sites the caller ALREADY HOLDS (`eak` / `lak` / the coerce
// ladder's own codes) and handed over as a spelling for the callee to re-derive. `nm`/`kw`
// survive ONLY as the fall-through's arguments: `msHasValKind` declines for a kind outside
// the seven scalar keywords (a list atom, a closure, an unclassified spelling) and for a
// set the pool or the kind bank does not cover, and the legacy path answers those
// unchanged — including its LOUD `emitFail` on an unregistered row, which the bank can
// never mask (a covered set is a registered row by construction).
function unionHasAtomK(s: i32, nm: string, kw: string, k: i32): boolean {
  const b = msHasValKind(s, k)
  if b >= 0 { return b == 1 }
  unionHasAtomTy(nm, kw, false)
}

// union == concrete (either operand order — equality is symmetric): the box's
// tag must select the arm whose rep matches the other side, then the unboxed
// payload value-compares it. A rep with no arm is statically unequal (`==` 0 /
// `!=` 1) — both operands still evaluate for side effects, box side first
// (the host's drop-block). `isNe` negates the result for `!=`.
function emitUnionConcreteEq(
  body: i32[],
  boxIx: i32,
  otherIx: i32,
  isNe: boolean,
  fnIx: i32,
) {
  if !unionEqOperandOk(boxIx) {
    return emitFail(
      "emitProgram: union `==` over a non-binding union value is not supported yet",
    )
  }
  const uname = unionNameOfExpr(boxIx, fnIx)
  // D-VALUNION / D-SETONCE: the union's interned member set, resolved ONCE — the
  // value-union gate below reads its banked member codes instead of re-splitting the
  // rendering.
  const usid = msSetOfText(uname)
  // The arm SPELLINGS with a declared ALIAS resolved, and the litunion-ARM shape admitted
  // beside the plain value union — the same two lines `emitUnionLitIs` carries, for the same
  // reason: a `K | i32` box is a value-union box with the litunion arm riding it as its
  // member STRING, and both the gate (`isValueUnionName`, whose `valueAtomKind("K")` is -1)
  // and the arm-membership test read a name, so an alias or a litunion arm made them report
  // a box that cannot hold what it holds.
  const unmArms = unionMemberSetOf(uname)
  if (
    uname == "" ||
    (!isValueUnionOfSet(usid, uname) && !unionCarriesLitUnionArm(uname))
  ) {
    return emitFail(
      "emitProgram: `==` over a struct union is not supported yet",
    )
  }
  const atom = unionEqAtomOf(otherIx, unmArms, fnIx)
  // D-UNION-ATOM-KIND / D-EQOPCODE / D-VALKIND: the other operand's rep CODE, derived
  // ONCE. The box tag, the `string` special-cases, the payload unbox, the widened operand
  // emit, the payload-compare opcode and the membership test below are all projections of
  // it. The SPELLING survives only as the membership test's DECLINE argument — a kind
  // outside the seven scalar keywords (a LIST / closure atom) keeps the exact
  // `TyPrim.primName` path, which is what those need.
  const eak = valueAtomKind(atom)
  // A `string`-repped other operand has an arm whenever the box can carry it as a string ref
  // — a plain `string` arm OR a literal-union arm, `unionTakesAtomAsStr`'s question and
  // `emitUnionLitIs`'s same second leg. Without it a `K | i32` box statically answers
  // `u == k` FALSE: the banked member kinds carry only `i32` (`valueAtomKind("K")` is -1), so
  // the arm that actually holds the value looks absent.
  let eqHasArm = unionHasAtomK(usid, unmArms, atom, eak)
  if !eqHasArm && eak == 2 && unionTakesAtomAsStr(unmArms) { eqHasArm = true }
  if !eqHasArm {
    // No arm has the other operand's rep: the box can never hold such a value.
    if emitExpr(body, boxIx, fnIx) < 0 { return -1 }
    fbDrop() // 0x1a drop
    if emitUnionEqOther(body, otherIx, eak, fnIx) < 0 { return -1 }
    fbDrop() // 0x1a drop
    if isNe { fbI32Const(1) } else { fbI32Const(0) }
    return 0
  }
  if eak == 2 && !aUsed {
    return emitFail(
      "emitProgram: union string `==` but array type not collected",
    )
  }
  // tag == tagOf(atom), gating the payload compare.
  if emitExpr(body, boxIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 0) // 0xfb 0x02 <box ht> field 0: tag
  fbI32Const(scalarTagOfKind(eak))
  fbI32Bin(70)            // 0x46 i32.eq
  fbIf(127)               // 0x04 if, 0x7f i32 result blocktype
  if emitExpr(body, boxIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  if emitUnionPayloadUnbox(body, eak) < 0 { return -1 }
  if emitUnionEqOther(body, otherIx, eak, fnIx) < 0 { return -1 }
  if eak == 2 {
    if emitStrEqCore(body) < 0 { return -1 }
  } else {
    // D-EQOPCODE: the payload compare's opcode is the LAST projection of `eak` this
    // site re-derived from the spelling — `atomEqOpcode` ran `valueAtomKind(atom)`
    // and then a four-arm kind table, with the code already in hand two lines up.
    fbI32Bin(atomEqOpcodeOfKind(eak))
  }
  fbElse() // 0x05 else: wrong-rep arm — structurally unequal
  fbI32Const(0)
  fbEnd()  // 0x0b end
  if isNe {
    fbI32Eqz() // 0x45 i32.eqz (`!=` negates value-equality)
  }
  0
}

// union == union: equal iff the SAME arm (tag) holds AND the unboxed payloads
// value-compare equal per that arm. Folded as a nested value-typed `if` chain
// over the SHARED non-null arms, bottoming out at bare tag equality (covers the
// `null` arm and any non-shared arm: distinct tags ⇒ unequal, equal null tags
// ⇒ equal). The right payload's unbox short-circuits on ITS tag too.
function emitUnionUnionEq(
  body: i32[],
  lIx: i32,
  rIx: i32,
  isNe: boolean,
  fnIx: i32,
) {
  if !unionEqOperandOk(lIx) || !unionEqOperandOk(rIx) {
    return emitFail(
      "emitProgram: union `==` over a non-binding union value is not supported yet",
    )
  }
  const lname = unionNameOfExpr(lIx, fnIx)
  const rname = unionNameOfExpr(rIx, fnIx)
  // D-SETONCE: BOTH operands' member sets are resolved ONCE, here, and every later
  // reader takes the id. Master resolved `lname` twice (this gate re-split the
  // rendering, then `msSetOfText` below) and `rname` twice (the gate, then
  // `msMemberAtomsOf`'s internal resolution).
  const lsid = msSetOfText(lname)
  const rsid = msSetOfText(rname)
  if !isValueUnionOfSet(lsid, lname) || !isValueUnionOfSet(rsid, rname) {
    return emitFail(
      "emitProgram: `==` over a struct union is not supported yet",
    )
  }
  // The shared non-null arms (matched by atom — atoms tag globally).
  // D-UNION set ADT: BOTH operands' member lists come from the RECORDED member columns when
  // the pool covers them — `msMemberAtomsOf` hands back exactly the atoms `splitUnionAtoms`
  // would, in the row's recorded (box-tag ABI) order — so the intersection walks two
  // recorded lists instead of one split plus a re-split of `rname` per left atom
  // (`unionHasAtom` splits on every call). The membership compare stays the VERBATIM
  // spelling compare `unionHasAtom` performs, not `unMemHasAtom`'s keyword-primitive test:
  // an arm spelled `(() => i64)` or a litunion alias `K0` is a member here and answers NO
  // there. Each side declines independently — a NARROWED subset the pool never interned
  // re-splits, exactly as before.
  //
  // D-UNION-ATOM-KIND: alongside the spellings, the left row's BANKED value-atom
  // codes travel with the arms that survive the intersection (the WRITE half of the
  // pair whose READ half is the tag emitted per arm below). The kind column is
  // index-parallel to the atom column, so an arm's code is the one recorded for the
  // very member whose spelling was pushed; a row the kind bank does not cover marks
  // its arms -2 and the tag falls back to the per-atom derivation, arm by arm.
  //
  // D-SETID / D-SETONCE: the member SPELLINGS and the member KINDS are two columns of
  // the same (row, mask), so ONE set id serves both readers. `lsid` / `rsid` are resolved
  // at the value-union gate, which needs them anyway. (A SET id, not a row id —
  // `msMemberValKindsOf` derives the row from the set itself.)
  const lAtoms: string[] = []
  if !msMemberAtomsOfSet(lsid, lAtoms) { splitUnionAtoms(lname, lAtoms) }
  const lKinds: i32[] = []
  let lKindsOk = msMemberValKindsOf(lsid, lKinds)
  if lKinds.length != lAtoms.length { lKindsOk = false }
  const rAtoms: string[] = []
  const rOk = msMemberAtomsOfSet(rsid, rAtoms)
  const arms: string[] = []
  const armKinds: i32[] = []
  let ai = 0
  while ai < lAtoms.length {
    let inR = false
    if rOk {
      let rj = 0
      while rj < rAtoms.length {
        if rAtoms[rj] == lAtoms[ai] { inR = true }
        rj = rj + 1
      }
    } else {
      inR = unionHasAtom(rname, lAtoms[ai])
    }
    if lAtoms[ai] != "null" && inR {
      arms.push(lAtoms[ai])
      if lKindsOk { armKinds.push(lKinds[ai]) } else { armKinds.push(-2) }
    }
    ai = ai + 1
  }
  if (
    unionHasAtomK(lsid, lname, "string", 2) &&
    unionHasAtomK(rsid, rname, "string", 2) &&
    !aUsed
  ) {
    return emitFail(
      "emitProgram: union string `==` but array type not collected",
    )
  }
  // Outermost `if` is the LAST arm (the host wraps its chain in arm order).
  let k = arms.length - 1
  while k >= 0 {
    // The READ half of the banked-kind pair: the arm's recorded code, or a per-atom
    // derivation where the bank did not cover the row.
    let armK = armKinds[k]
    if armK == -2 { armK = valueAtomKind(arms[k]) }
    if emitExpr(body, lIx, fnIx) < 0 { return -1 }
    fbStructGet(uBoxIdx, 0) // left tag
    fbI32Const(scalarTagOfKind(armK))
    fbI32Bin(70)            // 0x46 i32.eq
    fbIf(127)               // left holds this arm
    if emitExpr(body, rIx, fnIx) < 0 { return -1 }
    fbStructGet(uBoxIdx, 0) // right tag
    fbI32Const(scalarTagOfKind(armK))
    fbI32Bin(70)            // 0x46 i32.eq
    fbIf(127)               // right holds it too → payload value-compare
    if emitExpr(body, lIx, fnIx) < 0 { return -1 }
    fbStructGet(uBoxIdx, 1) // left payload (anyref)
    if emitUnionPayloadUnbox(body, armK) < 0 { return -1 }
    if emitExpr(body, rIx, fnIx) < 0 { return -1 }
    fbStructGet(uBoxIdx, 1) // right payload (anyref)
    if emitUnionPayloadUnbox(body, armK) < 0 { return -1 }
    if armK == 2 {
      if emitStrEqCore(body) < 0 { return -1 }
    } else {
      // D-EQOPCODE: `armK` came out of the banked `unMemValKind` column (or the
      // per-atom derivation where the row is uncovered) and already decided the two
      // tag compares and both payload unboxes above — the opcode is the same code's
      // fifth projection, not a fresh question about `arms[k]`'s spelling.
      fbI32Bin(atomEqOpcodeOfKind(armK))
    }
    fbElse() // right holds a different arm → unequal
    fbI32Const(0)
    fbEnd()
    fbElse() // left holds an earlier arm → recurse down the chain
    k = k - 1
  }
  // Chain bottom: bare tag equality (null arm / non-shared arms).
  if emitExpr(body, lIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 0)
  if emitExpr(body, rIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 0)
  fbI32Bin(70) // 0x46 i32.eq
  // Close every arm's outer `if` frame.
  let c = 0
  while c < arms.length {
    fbEnd()
    c = c + 1
  }
  if isNe {
    fbI32Eqz() // 0x45 i32.eqz
  }
  0
}

// `v is <literal>` over a STILL-BOXED mixed-rep union (`"a" | "b" | 1` boxes as
// `string|i32` — same-rep literals SHARE a tag): the tag selects the literal's
// rep arm, then the unboxed payload value-compares the literal. A literal whose
// rep has no arm is statically false (literal-is-always-false), evaluating the
// receiver for effects. The same gated shape as `emitUnionConcreteEq`.
function emitUnionLitIs(body: i32[], objIx: i32, lit: string, fnIx: i32) {
  if !unionEqOperandOk(objIx) {
    return emitFail(
      "emitProgram: literal `is` over a non-binding union value is not supported yet",
    )
  }
  const uname = unionNameOfExpr(objIx, fnIx)
  // D-VALUNION / D-SETONCE — see `emitUnionConcreteEq`.
  const usid = msSetOfText(uname)
  // THE ARM SPELLINGS, WITH A DECLARED ALIAS RESOLVED — every predicate below that reads a
  // NAME reads this one, while the interned SET stays keyed on the name the receiver carries.
  // `unionHasAtomTy` / `unionTakesAtomAsStr` answer by splitting the spelling at top-level
  // `|`, so `type W = K | i32` split to the single atom `"W"`: no arm could hold a quoted
  // literal, `litHasArm` was false and the whole compare CONST-FOLDED TO 0 — while the
  // INLINE `K | i32` spelling of the identical box, whose arms those same predicates can
  // see, was correct. `unionMemberSetOf` returns a non-alias name unchanged, so this is the
  // string the working spelling already passed.
  const unmArms = unionMemberSetOf(uname)
  // A union carrying a literal-union ALIAS arm (`K | string`, `K | f64`) is a BOX like any
  // value union — the arm rides it as its member string — but `isValueUnionName` declines it
  // because `valueAtomKind("K")` is -1. It is the same box with the same tags, so the
  // lowering below is unchanged; only the gate had to learn the second spelling.
  if (
    uname == "" ||
    (!isValueUnionOfSet(usid, uname) && !unionCarriesLitUnionArm(uname))
  ) {
    return emitFail(
      "emitProgram: literal `is` over a struct union is not supported",
    )
  }
  // The literal's rep atom (a quoted lexeme is a string; a float f64; an
  // integer i32, widening to i64 when out of range or when the union's only
  // integer arm is i64 — the `emitUnionCoerce` default).
  //
  // D-LITISKIND: the ladder settles the ABI CODE alongside the spelling. FAITHFUL
  // because the map is a bijection ON THIS LADDER'S IMAGE — `valueAtomKind` answers 0 for
  // `i32` and nothing else, 2 for `string`, 4 for `f64`, 3 for `i64` — so the code the
  // ladder assigns IS the code a parse of its own output would return, arm for arm.
  // D-VALKIND then took the membership test (`msHasValKind` over the banked kind column),
  // leaving the spelling as that test's DECLINE argument only.
  let atom = "i32"
  let lak = 0
  // The QUOTED-LEAF test at its home (`tyname.nameIsQuotedLeaf`, W3). This site carries no
  // bound of its own and never did: every caller reaches it through `isLitVariantName`,
  // whose `length == 0` reject is the bound.
  if nameIsQuotedLeaf(lit) {
    atom = "string"
    lak = 2
  } else if numTextIsFloat(lit) {
    atom = "f64"
    lak = 4
  } else if !numLexFitsI32(lit) {
    atom = "i64"
    lak = 3
  } else if (
    !unionHasAtomK(usid, unmArms, "i32", 0) &&
    unionHasAtomK(usid, unmArms, "i64", 3)
  ) {
    atom = "i64"
    lak = 3
  }
  // A QUOTED literal has a rep arm whenever the box can carry it as a string ref — a plain
  // `string` arm OR a literal-union arm, which is exactly `unionTakesAtomAsStr`'s question.
  // Without its second leg a `K | f64` box statically answers `is "aa"` FALSE: the member
  // kinds bank only `f64` (`valueAtomKind("K")` is -1), so the arm that actually holds the
  // value looks absent.
  let litHasArm = unionHasAtomK(usid, unmArms, atom, lak)
  if !litHasArm && lak == 2 && unionTakesAtomAsStr(unmArms) { litHasArm = true }
  if !litHasArm {
    if emitExpr(body, objIx, fnIx) < 0 { return -1 }
    fbDrop() // 0x1a drop
    fbI32Const(0)
    return 0
  }
  // D-UNION-ATOM-KIND: `lak` decides the tag, the payload unbox and the three
  // constant-emit arms below — one code, five projections.
  if lak == 2 && !aUsed {
    return emitFail(
      "emitProgram: string `is` test but array type not collected",
    )
  }
  if emitExpr(body, objIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 0) // 0xfb 0x02 <box ht> field 0: tag
  fbI32Const(scalarTagOfKind(lak))
  fbI32Bin(70)            // 0x46 i32.eq
  fbIf(127)               // 0x04 if, 0x7f i32 result blocktype
  if emitExpr(body, objIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
  if emitUnionPayloadUnbox(body, lak) < 0 { return -1 }
  if lak == 2 {
    // The literal lexeme rides a synthesized `StrLit` (same shape as `strText`).
    if emitExpr(body, mkStr(lit, -1), fnIx) < 0 { return -1 }
    if emitStrEqCore(body) < 0 { return -1 }
  } else if lak == 4 {
    fbF64Const(lit)
    fbI32Bin(97) // 0x61 f64.eq
  } else if lak == 3 {
    const pr = parseI64Pair(lit)
    fbI64Const(pr[0], pr[1])
    fbI32Bin(81) // 0x51 i64.eq
  } else {
    fbI32Const(parseI32(lit))
    fbI32Bin(70) // 0x46 i32.eq
  }
  fbElse() // wrong-rep arm — the literal can never match
  fbI32Const(0)
  fbEnd()  // 0x0b end
  0
}

function emitMem(body: i32[], memIx: i32, fnIx: i32) {
  // A field read on a NARROWED union identifier downcasts through the box (G1).
  if memIsNarrowed(memIx) { return emitNarrowedMem(body, memIx, fnIx) }
  // A field read on a VARIANT-typed param `o.field` (`o: TyObj`) reads the variant
  // struct directly — the param already IS the unboxed variant ref, so there is NO box
  // unwrap / cast (gap #2). Evaluate the receiver (`local.get o`), then `struct.get
  // $<uVarHeap[vi]> <fieldIdx>`.
  const m0 = P.nodes[memIx]
  if m0 is Member {
    const pvi = exprVariantIndex(m0.memObj, fnIx)
    if pvi >= 0 {
      const pvfi = variantFieldIndex(pvi, m0.memProp)
      if pvfi < 0 {
        return emitFail("emitProgram: unknown variant field in field access")
      }
      if emitExpr(body, m0.memObj, fnIx) < 0 { return -1 }
      fbStructGet(uVarHeap[pvi], pvfi) // 0xfb 0x02 <variant struct ht> <field index>
      return 0
    }
  }
  // Shared-field access over an UN-narrowed struct union (`(A | B).tag` — the
  // host's `sharedUnionFieldRead`): the checker proved the field present on EVERY
  // member, but members may store it at DIFFERENT indices, so dispatch on the box
  // tag and read the field at THAT member's own index. The arms are exhaustive
  // (the LAST member is the unconditional fall-through, host parity). Ported
  // SUBSET: an IDENT receiver (an effect-free place — it is re-evaluated per arm
  // instead of spilling to a scratch local) and an i32-rep field (a single-byte
  // `if (result i32)` blocktype); anything else falls through to the loud
  // failures below. A multi-variant NARROWED set ("N2|N3") dispatches over just
  // its remaining members.
  const mS = P.nodes[memIx]
  if mS is Member {
    if exprUnion(mS.memObj, fnIx) {
      const shRecv = P.nodes[unwrapParen(mS.memObj)]
      if shRecv is Ident {
        const shSet = currentStructNarrowSetOf(shRecv.identName, fnIx)
        if shSet != "" {
          // D-UNION set ADT — the narrowed set's members from the recorded member
          // columns (the row's recorded order IS the box-tag order this dispatch
          // walks); a narrowed subset the pool has not interned re-splits.
          //
          // D-SETID: the set id comes from the narrowing table's banked (row, mask)
          // pair (`currentStructNarrowSetIdOf`, the set-ADT reading of the
          // `currentStructNarrowSetOf` above — same un-narrowed alias EXPANSION),
          // not from resolving the rendering this site still needs for the split
          // fall-through.
          const shAtoms: string[] = []
          if (
            !msMemberAtomsOfSet(
              currentStructNarrowSetIdOf(shRecv.identName, fnIx),
              shAtoms,
            )
          ) {
            splitUnionAtoms(shSet, shAtoms)
          }
          // Validate: every member a struct VARIANT carrying the field as i32.
          const shVis: i32[] = []
          const shFis: i32[] = []
          let shOk = shAtoms.length >= 2
          let sa = 0
          while sa < shAtoms.length {
            const svi = variantIndexOf(shAtoms[sa])
            if svi < 0 {
              shOk = false
            } else {
              const sfi = variantFieldIndex(svi, mS.memProp)
              if sfi < 0 || variantFieldTypeAt(svi, sfi) != 0 {
                shOk = false
              } else {
                shVis.push(svi)
                shFis.push(sfi)
              }
            }
            sa = sa + 1
          }
          if shOk {
            let si2 = 0
            while si2 < shAtoms.length - 1 {
              if emitExpr(body, mS.memObj, fnIx) < 0 { return -1 }
              fbStructGet(uBoxIdx, 0) // field 0: tag
              fbI32Const(uTags[shVis[si2]])
              fbI32Bin(70)            // 0x46 i32.eq
              fbIf(127)               // if (result i32)
              if emitExpr(body, mS.memObj, fnIx) < 0 { return -1 }
              fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
              fbRefCast(uVarHeap[shVis[si2]])
              fbStructGet(uVarHeap[shVis[si2]], shFis[si2])
              fbElse()
              si2 = si2 + 1
            }
            const shLast = shAtoms.length - 1
            if emitExpr(body, mS.memObj, fnIx) < 0 { return -1 }
            fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
            fbRefCast(uVarHeap[shVis[shLast]])
            fbStructGet(uVarHeap[shVis[shLast]], shFis[shLast])
            let se = 0
            while se < shAtoms.length - 1 {
              fbEnd()
              se = se + 1
            }
            return 0
          }
        }
      }
    }
  }
  if !sDeclared {
    return emitFail("emitProgram: field access but no struct type declared")
  }
  const m = P.nodes[memIx]
  if m is Member {
    const si = structIndexOfExpr(m.memObj, fnIx)
    if si < 0 {
      return emitFail("emitProgram: field access receiver is not a struct")
    }
    const idx = sFieldIndex(si, m.memProp)
    if idx < 0 {
      return emitFail("emitProgram: unknown struct field in field access")
    }
    if emitExpr(body, m.memObj, fnIx) < 0 { return -1 }
    // A NULLABLE-struct receiver (`S | null`) recovers its non-null ref before the
    // field read — the checker proved every such access guarded, so the cast can
    // never trap on a checked program.
    if exprNullableStruct(m.memObj, fnIx) {
      wU8(212) // 0xd4 ref.as_non_null
    }
    fbStructGet(sHeapIdx[si], idx) // 0xfb 0x02 <struct ht> <field index>
    // THE `string | null` READ RULE (field code 20 / slot kind 16) — shared verbatim by
    // this field read and the global / param / local ident reads in `emitIdentNode`. A
    // VALUE read recovers the non-null string ref (`ref.as_non_null`; the checker narrowed
    // it non-null at every value read). Exactly two contexts suppress the recovery and keep
    // the RAW nullable ref: `pendingRawNullRead` (a `!= null` / `??` null test, which needs
    // `ref.is_null`) and `pendingNulString` (a nullable-string TARGET — `const g = r.f`
    // binding a `string | null`, a nullable arg/return), where recovering would
    // `ref.as_non_null` a legitimately-null value and TRAP. A `boolean | null` field (code
    // 21) needs no recovery at all: its i32 sentinel reads as-is.
    if sFieldTypeAt(si, idx) == 20 {
      if !nulStrReadStaysRaw() {
        wU8(212) // 0xd4 ref.as_non_null
      }
    }
    // A UNION-typed field (code 16) read while the member PATH is narrowed to one
    // scalar atom (`if o.y is i32 { … o.y … }`) unboxes the payload — the same
    // recovery as a narrowed union IDENT read. An un-narrowed read is the box.
    // `narrowedValueAtomOf` (not the raw `narrowVariantFor`/`valueAtomKind`) so a
    // litunion-alias narrow (`o.f is K0`, `type K0 = "a"|"b"`) unboxes as the STRING
    // ref the box stores its member as — mirroring the ident READ discipline (else the
    // raw box flowed where the string array was expected: invalid wasm).
    if sFieldTypeAt(si, idx) == 16 {
      const mAtom = narrowedValueAtomOf(memberPathKeyOf(memIx))
      if mAtom != "" {
        // D-UNION-ATOM-KIND: the narrowed atom's ABI code decides both arms, exactly
        // as it already does at the VARIANT-field twin of this read (`emitNarrowedMem`
        // — same three instructions, same two arms); `vbHeapIdxOfAtom` re-derived it a
        // second time here, and `mAtom == "string"` was code 2 asked in spelling form.
        const mfk = valueAtomKind(mAtom)
        fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
        if mfk == 2 {
          if !aUsed {
            return emitFail(
              "emitProgram: narrowed string union field read but array type not collected",
            )
          }
          fbRefCast(aTypeIdx) // the payload IS the string array ref
        } else {
          const mvb = vbHeapIdxOfKind(mfk)
          if mvb < 0 {
            return emitFail(
              "emitProgram: narrowed union field atom has no value box",
            )
          }
          fbRefCast(mvb)
          fbStructGet(mvb, 0) // the scalar payload
        }
      }
    }
    return 0
  }
  emitFail("emitProgram: expected a field access")
}

// ── string-literal decoding ───────────────────────────────────────────────────
// A `StrLit` carries the RAW lexeme in `strText` (surrounding quotes kept, escapes
// UNRESOLVED — see `parser.vl`'s `mkStr` of the STRING token's raw text), so the emitter decodes it
// here to the sequence of Unicode CODE POINTS the string denotes. Because a VL string
// is itself a code-point `array i32` (this very representation), `strText[i]` already
// yields the i32 code point of the i-th source char, so decoding is a direct walk over
// those code points with the same escape grammar the lexer applies (`scanQuoted`):
// `\n \t \r \\ \" \' \0 \b \f \v`, `\xXX`, `\uXXXX`, `\u{…}`. The result is the
// emittable code-point vector that `emitStr` lowers to `array.new_fixed`.

// Lower a string literal `"abc"` onto `body`: decode `strText` to its code-point
// vector, push each code point as `i32.const`, then `array.new_fixed $aTypeIdx <count>`
// — i.e. the IDENTICAL shape an `i32[]` literal of those code points uses (a string is
// CURRENTLY an `array i32` of code points; `docs/strings-design.md`). A literal past
// the `array.new_fixed` operand cap builds CHUNKED (`arrLitChunkStart`/`arrLitChunkFlush`)
// — same value, engine-valid module. The UTF-8 `array i8` storage migration is the
// deliberate B7 follow-up and is NOT built here.
function emitStr(_body: i32[], strIx: i32, _fnIx: i32) {
  if !aUsed {
    return emitFail("emitProgram: string literal but array type not collected")
  }
  const s = P.nodes[strIx]
  if s is StrLit {
    // A POOLED literal (every distinct literal within the `array.new_fixed` cap —
    // `collectStrPool`) reads its interned immutable global: one `global.get`
    // instead of an i32.const-per-codepoint allocation at every evaluation.
    const pi = gStrPoolIx[s.strText] ?? -1
    if pi >= 0 {
      fbGlobalGet(pi) // the pool occupies global indices 0..pool-1
      return 0
    }
    const cps = decodeStr(strToCps(s.strText))
    if cps.length > NEW_FIXED_MAX {
      // Past the engines' `array.new_fixed` operand cap — build chunked (an
      // unchunked emit validates nowhere). A string IS the raw i32 code-point
      // array, so the finished backing is the value itself.
      const dst = arrLitChunkStart("i32", 0, aTypeIdx, cps.length)
      let ci = 0
      let coff = 0
      while ci < cps.length {
        fbI32Const(cps[ci])
        ci = ci + 1
        coff = arrLitChunkFlush(dst, aTypeIdx, coff, ci, cps.length)
      }
      fbLocalGet(dst)
      wU8(212) // 0xd4 ref.as_non_null (the slot is declared nullable)
      return 0
    }
    let i = 0
    while i < cps.length {
      fbI32Const(cps[i]) // 0x41 i32.const <code point>
      i = i + 1
    }
    fbArrayNewFixed(aTypeIdx, cps.length) // 0xfb 0x08 <typeidx> <count>; type shared with i32[]
    return 0
  }
  emitFail("emitProgram: expected a string literal")
}

// Lower an array literal `[e, e, ...]` onto `body` as a GROWABLE list value (mirroring
// `toWasm.ts`'s `ArrayLiteral` case): push each element value in source order (all i32),
// then `array.new_fixed $aTypeIdx <count>` to build the raw backing (`0xfb 0x08 <typeidx>
// <count>`), then push `count` (len) and `count` (cap), then `struct.new $lTypeIdx`
// (`0xfb 0x00 <lTypeIdx>`) to wrap them into `{ backing, len, cap }`. An empty `[]` is
// `array.new_fixed` of count 0 wrapped with len 0 / cap 0. An element that is itself an
// array (nested) is out of scope — fails loudly.
function emitArr(body: i32[], arrIx: i32, fnIx: i32) {
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    const elems = a.arrElems
    // WHICH (backing, wrapper) PAIR the literal builds. Two signals answer it: the
    // literal's OWN elements (`arrLitIs*`) and a THREADED annotation from the binding /
    // field / param that seeded `pendingListKind`:
    //   1/2 ref    `(ref null $elem)` backing — each element via `emitExpr` (an objlit →
    //              struct.new, a union box)
    //   3   string `(ref null $aTypeIdx)` refs in the `$mkListIdx` wrapper. Checked before
    //              the i32/ref paths: a string element is neither
    //   4   f64    `(array (mut f64))`  (Slice 4)
    //   6   i64    `(array (mut i64))`  — bare-integer elements widen at the store
    //   7   f32    `(array (mut f32))`  — only ever reached through an annotation; a bare
    //              float literal stays f64, and `[1.5]` elements re-encode at f32
    //   else i32   the default `$lTypeIdx` list
    // A THREADED kind is AUTHORITATIVE and clears the kinds it displaces (the overrides
    // below), because a literal does not always self-identify: `const xs: f64[] = [2]` has
    // only int elements, so `arrLitIsF64` said no and it built the i32 backing against the
    // f64-list slot — invalid wasm. Each element then coerces at the store
    // (`emitExprAsF64` → `f64.convert_i32_s` for an i32 operand, and so on per kind).
    let isRefLit = arrLitIsRef(arrIx)
    let isStrLit = arrLitIsStr(arrIx, fnIx)
    let isF64Lit = arrLitIsF64(arrIx, fnIx)
    let isI64Lit = arrLitIsI64(arrIx, fnIx)
    // A literal whose elements are ALL f32-typed VALUES self-identifies, exactly as the
    // f64 and i64 forms above do. A bare float literal still stays f64 — `arrLitIsF32`
    // claims only `exprIsF32` elements, and a `.` literal is deliberately not one — so
    // the annotation remains the only route to `[1.5]` as an f32 list, and the only new
    // population is `[fv]` over f32-typed values, which had no route at all: it fell to
    // the i32 default and built an i32 backing under f32 elements.
    let isF32Lit = arrLitIsF32(arrIx, fnIx)
    if pendingListKind == 6 {
      isI64Lit = true
      isF64Lit = false
      isStrLit = false
      isF32Lit = false
    }
    if pendingListKind == 4 {
      isF64Lit = true
      isI64Lit = false
      isStrLit = false
      isF32Lit = false
    }
    if pendingListKind == 7 {
      isF32Lit = true
      isF64Lit = false
      isI64Lit = false
      isStrLit = false
    }
    if elems.length == 0 {
      if pendingListKind == 3 {
        isStrLit = true
      } else if pendingListKind == 4 {
        isF64Lit = true
      } else if pendingListKind == 6 {
        isI64Lit = true
      } else if pendingListKind == 7 {
        isF32Lit = true
      } else if pendingListKind == 8 {
        // A `(boolean | null)[]` empty literal — a plain i32-list wrapper (the boolean
        // sentinel niche shares the i32 backing); nothing to force here.
      } else {
        if pendingListKind != 0 { isRefLit = true }
      }
    }
    // A NON-EMPTY literal under a threaded UNION-list annotation (kind 2) is a
    // ref literal even when its elements are bare scalars/strings — a
    // `(string|i32)[]` literal's elements COERCE into the union box at the
    // write boundary (the host's `coerceUnion` per element), they don't type
    // the list. Without the annotation a scalar literal stays the i32 list.
    if pendingListKind == 2 {
      isRefLit = true
      isStrLit = false
      isF64Lit = false
      // An `(i64 | null)[]` literal's i64-typed first element must not claim the scalar
      // i64-list path — the elements box (kind 2), like the f64/string forms above.
      isI64Lit = false
      // An `(f32 | null)[]` literal's f32 elements box the same way.
      isF32Lit = false
    }
    // A CLOSURE-element list (kind 5, `((i32) => i32)[]`): a literal of function values
    // (`[inc, dbl]`) reads as bare idents, so `arrLitIsRef` (which keys off an objlit /
    // nested-array first element) misses it — the threaded annotation is authoritative.
    // `isI64Lit` clears too: a kind-5-threaded REF-list value whose literal has an
    // i64-magnitude first element (`m[k] = [13131313131]` into a `{[string]:
    // (i64|null)[]}` — a kind-2 union-box element slot threaded through the map store's
    // generic ref-list seed) would else build the scalar i64-list wrapper into the
    // box-element slot (invalid wasm), exactly as the kind-2 override clears it.
    if pendingListKind == 5 {
      isRefLit = true
      isStrLit = false
      isF64Lit = false
      isI64Lit = false
      isF32Lit = false
    }
    // A STRUCT ref-list (kind 1) under a threaded annotation: authoritative, like kind 2/5.
    // Matters for a NULLABLE-struct array (`(P | null)[]`) whose FIRST element is `null` —
    // `arrLitIsRef` keys off the first element (a `null` is neither objlit nor nested array)
    // and would otherwise mis-route the literal to the i32-list path.
    if pendingListKind == 1 {
      isRefLit = true
      isStrLit = false
      isF64Lit = false
      isI64Lit = false
      isF32Lit = false
    }
    // An ATOM-element literal under a threaded atom context (`pendingLitUnion` — a `K[]`
    // field / binding): the member elements are STRING exprs syntactically (`arrLitIsStr`
    // would claim the string-list build), but each lowers as its interned i32 atom id —
    // the i32-list path is authoritative, like the kind overrides above.
    if pendingLitUnion == 1 {
      isRefLit = false
      isStrLit = false
      isF64Lit = false
      isI64Lit = false
      isF32Lit = false
    }
    // A `(K | null)[]` literal (`pendingListKind == 9`, or a probe-detected element type): its
    // member-literal elements lower as interned i32 ATOM ids and a `null` as the `-1` sentinel — the
    // i32-list path is authoritative even when the FIRST element is a string literal (`["a", null]`),
    // which `arrLitIsStr` would otherwise claim for the string-list build. The `pendingNulLitUnion` /
    // `pendingLitUnion` seeds for the element emits are set further below (the niche analogue of the
    // `pendingLitUnion == 1` override above, which fires for the NON-null `K[]` array).
    if pendingListKind == 9 || nodeArrayElemIsNulLitUnion(arrIx) {
      isRefLit = false
      isStrLit = false
      isF64Lit = false
      isI64Lit = false
      isF32Lit = false
    }
    if isF32Lit {
      if !fa32Used {
        return emitFail(
          "emitProgram: f32 array literal but f32 list type not collected",
        )
      }
      let dstF32 = -1
      let coffF32 = 0
      if elems.length > NEW_FIXED_MAX {
        dstF32 = arrLitChunkStart("f32", 0, fa32TypeIdx, elems.length)
      }
      let i32f = 0
      while i32f < elems.length {
        if exprArray(elems[i32f], fnIx) || exprRefArray(elems[i32f], fnIx) {
          return emitFail("emitProgram: nested arrays are not supported")
        }
        // Each element lowered as f32 (a float literal re-encoded; an i32 operand converted
        // via `f32.convert_i32_s`) so the backing's element type matches.
        if emitExprAsF32(body, elems[i32f], fnIx) < 0 { return -1 }
        i32f = i32f + 1
        if dstF32 >= 0 {
          coffF32 = arrLitChunkFlush(
            dstF32,
            fa32TypeIdx,
            coffF32,
            i32f,
            elems.length,
          )
        }
      }
      if dstF32 >= 0 {
        fbLocalGet(dstF32)
        wU8(212) // 0xd4 ref.as_non_null — the chunk-built f32 backing
      } else {
        fbArrayNewFixed(fa32TypeIdx, elems.length) // builds the f32 backing
      }
      fbI32Const(elems.length) // len
      fbI32Const(elems.length) // cap
      fbStructNew(fl32TypeIdx) // the f32-list wrapper
      return 0
    }
    if isF64Lit {
      if !fa64Used {
        return emitFail(
          "emitProgram: f64 array literal but f64 list type not collected",
        )
      }
      let dstF64 = -1
      let coffF64 = 0
      if elems.length > NEW_FIXED_MAX {
        dstF64 = arrLitChunkStart("f64", 0, fa64TypeIdx, elems.length)
      }
      let i = 0
      while i < elems.length {
        if exprArray(elems[i], fnIx) || exprRefArray(elems[i], fnIx) {
          return emitFail("emitProgram: nested arrays are not supported")
        }
        // Each element is lowered as an f64 (a float literal → `f64.const`; an i32
        // operand widened via `f64.convert_i32_s`) so the backing's element type matches.
        if emitExprAsF64(body, elems[i], fnIx) < 0 { return -1 }
        i = i + 1
        if dstF64 >= 0 {
          coffF64 = arrLitChunkFlush(
            dstF64,
            fa64TypeIdx,
            coffF64,
            i,
            elems.length,
          )
        }
      }
      if dstF64 >= 0 {
        fbLocalGet(dstF64)
        wU8(212) // 0xd4 ref.as_non_null — the chunk-built f64 backing
      } else {
        fbArrayNewFixed(fa64TypeIdx, elems.length) // 0xfb 0x08; builds the f64 backing
      }
      fbI32Const(elems.length) // 0x41 i32.const (len)
      fbI32Const(elems.length) // 0x41 i32.const (cap)
      fbStructNew(fl64TypeIdx) // 0xfb 0x00 <f64-list wrapper struct type index>
      return 0
    }
    if isI64Lit {
      if !ia64Used {
        return emitFail(
          "emitProgram: i64 array literal but i64 list type not collected",
        )
      }
      let dstI64 = -1
      let coffI64 = 0
      if elems.length > NEW_FIXED_MAX {
        dstI64 = arrLitChunkStart("i64", 0, ia64TypeIdx, elems.length)
      }
      let i = 0
      while i < elems.length {
        if exprArray(elems[i], fnIx) || exprRefArray(elems[i], fnIx) {
          return emitFail("emitProgram: nested arrays are not supported")
        }
        // Each element lowered as i64 (an i64 literal directly; an i32 operand sign-
        // extended via `i64.extend_i32_s`) so the backing's element type matches.
        if emitExprAsI64(body, elems[i], fnIx) < 0 { return -1 }
        i = i + 1
        if dstI64 >= 0 {
          coffI64 = arrLitChunkFlush(
            dstI64,
            ia64TypeIdx,
            coffI64,
            i,
            elems.length,
          )
        }
      }
      if dstI64 >= 0 {
        fbLocalGet(dstI64)
        wU8(212) // 0xd4 ref.as_non_null — the chunk-built i64 backing
      } else {
        fbArrayNewFixed(ia64TypeIdx, elems.length) // builds the i64 backing
      }
      fbI32Const(elems.length) // len
      fbI32Const(elems.length) // cap
      fbStructNew(il64TypeIdx) // the i64-list wrapper
      return 0
    }
    if isStrLit {
      if !slUsed {
        return emitFail(
          "emitProgram: string array literal but string list type not collected",
        )
      }
      let dstStr = -1
      let coffStr = 0
      if elems.length > NEW_FIXED_MAX {
        dstStr = arrLitChunkStart("str", 0, mkArrIdx, elems.length)
      }
      // A `(string | null)[]` literal shares the string backing, but a `null` element lowers as
      // `ref.null $aTypeIdx` (a real string element rides its `array.new_fixed` string untouched) —
      // seed `pendingNulString` for the element emits (the string niche analogue of `pendingNulBool`).
      const savedArrNS = pendingNulString
      if nodeArrayElemIsNulStr(arrIx) { pendingNulString = true }
      let i = 0
      while i < elems.length {
        // A literal-union ATOM element WIDENS to its member string. The backing is
        // `(ref null $aTypeIdx)` and the atom's rep is an i32 id, so without this the element
        // store was `expected (ref null $type), found i32` — check-clean invalid wasm.
        //
        // Reached only when the literal already BUILDS a string list, which for a mixed literal
        // means a string-typed FIRST element decided it (`["plain", v]`). An atom-first literal
        // (`[v]`, `[v, "plain"]`) is a different defect entirely: `arrLitIsStr` declines because
        // the checker adopted a `K[]` context onto the literal, so an ATOM list is built and the
        // `string[]` annotation is ignored — see
        // `tests/cases/soundness/xfail-miscompile-atom-first-arraylit-ignores-annotation.vl`.
        if emitStrValue(body, elems[i], fnIx) < 0 { return -1 }
        i = i + 1
        if dstStr >= 0 {
          coffStr = arrLitChunkFlush(dstStr, mkArrIdx, coffStr, i, elems.length)
        }
      }
      pendingNulString = savedArrNS
      if dstStr >= 0 {
        fbLocalGet(dstStr)
        wU8(212) // 0xd4 ref.as_non_null — the chunk-built string-ref backing
      } else {
        fbArrayNewFixed(mkArrIdx, elems.length) // 0xfb 0x08; builds the string-ref backing
      }
      fbI32Const(elems.length) // 0x41 i32.const (len)
      fbI32Const(elems.length) // 0x41 i32.const (cap)
      fbStructNew(mkListIdx)   // 0xfb 0x00 <string-list wrapper struct type index>
      return 0
    }
    if isRefLit {
      if !rlUsed {
        return emitFail(
          "emitProgram: ref array literal but ref list type not collected",
        )
      }
      // The element type determines WHICH (backing, wrapper) pair this literal builds.
      // A binding/field site that threaded a ref-list annotation (`pendingListKind` 1/2,
      // `pendingListSlot` the element slot) is AUTHORITATIVE — its declared element type
      // wins over the first-element field-shape guess so a `B[] = [{…}]` literal of a
      // struct sharing field names with another struct still builds B's list. Only a
      // literal WITHOUT a threaded annotation types itself from its first element. An
      // EMPTY `[]` (no elements) always takes the threaded slot.
      const annKind = pendingListKind
      const annSlot = pendingListSlot
      let rslot = 0
      if annKind == 1 || annKind == 2 || annKind == 5 { rslot = annSlot }
      else if elems.length >= 1 { rslot = rlSlotByName(arrLitElemName(arrIx)) }
      else { rslot = annSlot }
      if rslot < 0 {
        if rlElemName.length < 1 {
          return emitFail(
            "emitProgram: ref array literal with no interned element type",
          )
        }
        rslot = 0
      }
      // A STRUCT-element list (kind 1, NOT a union box) types each element literal as the
      // list's declared element struct — seed `pendingStructIdx` (consumed by `emitObj`)
      // so a same-field-name sibling struct does not win the field-shape match. A union
      // list (kind 2) boxes by variant name and needs no struct hint.
      let elemStructIdx = -1
      let elemVariantIdx = -1
      if rlElemKindTbl[rslot] == 1 {
        // A NULLABLE-struct element list (`(P | null)[]`, slot key "P | null"): the
        // `| null` peels to the bare struct so an object element builds `P` and a `null`
        // element gets `ref.null $P` (the seeded `pendingStructIdx`). The struct ROW comes
        // off the arena (`rlElemLitStructRow`); the peeled NAME below is still what the
        // concrete-VARIANT fall-back looks up (the variant table has no arena sidecar yet).
        let rlen = rlElemName[rslot]
        const rnn = nullablePartOf(rlen)
        if rnn != "" { rlen = rnn }
        elemStructIdx = rlElemLitStructRow(rslot)
        // A concrete-VARIANT element list (`Cat[]`): no `sNames` entry, so seed the VARIANT
        // index instead so each element literal builds the bare variant struct (kind 8).
        if elemStructIdx < 0 { elemVariantIdx = variantIndexOf(rlen) }
      }
      // A UNION-element list (kind 2) coerces each element into the box at the
      // write boundary (`emitUnionCoerce` — the host's per-element `coerceUnion`):
      // a bare scalar/string boxes under its atom's tag; an object literal /
      // already-union value passes through to its existing boxing.
      let elemUnionNm = ""
      if rlElemKindTbl[rslot] == 2 { elemUnionNm = rlElemName[rslot] }
      // A nested LIST element kind (`i32[][]` 4 / `string[][]` 6 / `f64[][]` 7 / `i64[][]` 8):
      // the elements ARE arrays. Kind 4 builds the default i32-list; 6/7/8 seed the inner list
      // kind (`pendingListKind` 3 string / 4 f64 / 6 i64) so a bare `["a"]` / `[1.0]` / `[1,2]`
      // element builds the right list, not the default i32-list.
      const elemNest = rlElemKindTbl[rslot]
      let dstRef = -1
      let coffRef = 0
      if elems.length > NEW_FIXED_MAX {
        dstRef = arrLitChunkStart("ref", rslot, rlBackIdx[rslot], elems.length)
      }
      let i = 0
      // A kind-9 element is itself a REF list (`Cell[]` of `Cell[][]`, any ref leaf, any depth):
      // its inner ref-list slot, seeded so each element builds as that inner list (recursively).
      let nestInnerSlot = -1
      if elemNest == 9 { nestInnerSlot = rlElemInnerSlot(rslot) }
      while i < elems.length {
        // A NON-nested-list element list must not hold array elements. Kinds 4/6/7/8 (scalar inner
        // lists) and 9 (ref inner list) legitimately do — and so does a UNION-BOX element whose
        // union has a LIST arm (`(i32[] | f64)[]` with a `[1, 2]` element): the array value boxes
        // through `emitUnionBoxArg` → `emitUnionCoerce` below, which carries its own loud rejects
        // for a list the union cannot box.
        //
        // CLOSED — this guard drew a FALSE message until #1234, and the paragraph that
        // filed it (#1233) is replaced by its re-derivation. The filed case was
        // `type Box<T> = { v: T[][] }` applied at `Box<i32>`: it landed here and was told
        // "nested arrays are not supported" while the concrete twin
        // `type Box = { v: i32[][] }` and the bare `const v: i32[][]` both lowered fine.
        //
        // The lie was never in this guard — it was upstream, in the field's recorded
        // element type. An instrumented build dumped the ref-list rows and the field
        // coding at the reject:
        //
        //     ROWS: [0] i32[] /kind 4    [1] T[] /kind 1
        //     FLD  si=0 fi=0 elemName=T[] elemTyIx=-1 arenaLeg=-1 nameLeg=1
        //
        // Row 0 is the row the literal needs and it was ALREADY interned; nothing pointed
        // at it, because the substituted shape recorded its ref-list element as the
        // UN-substituted `T[]` — a STRUCT element, kind 1 — and this guard then correctly
        // refused an array element in a struct-element list. `gaeApplyFieldTy`
        // (`emit_base.vl`) substituted a type PARAMETER at exactly two depths, `T` and
        // `T[]`, a hand-written ladder, so `T[][]` matched neither and came back unchanged.
        //
        // #1234 replaced that ladder with the ARRAY-NAME grammar's leaf peel
        // (`arrLeafNameOf`) plus a re-attachment of the same `[]` run, and gave it the
        // SHADOW guard (`gaeParamShadowed`) the filing's own remedy was missing — the
        // second defect that paragraph recorded, where a declaration shadows a builtin
        // (`type Box<i32> = { v: i32 }` + `const b: Box<string> = { v: 1 }`) and the
        // checker resolved the parameter to the BUILTIN while the substitution rewrote the
        // field to the ARGUMENT, emitting a module that did not even parse.
        //
        // Re-derived at `63a73d7` over the filing's own cells, one minimal program each:
        // `T[][]` at i32 and string leaves, `T[][][]`, the array-typed argument
        // `Box<i32[]>`, the concrete twin, and all five shadow spellings (i32 / string /
        // f64 / boolean / nested, plus applying at the shadow name itself) — **11 of 11
        // run**, against 3 emit errors + 3 unparseable modules on `e16e658`, the commit
        // before #1234. BOTH defects the filing recorded are gone. Pinned by
        // `tests/cases/generics/type-param-nested-list-field.vl` and its control
        // `type-param-list-field-nested-arg.vl`.
        //
        // What survives here is the guard, and its message is now true of what reaches it.
        if (
          elemNest != 4 &&
          elemNest != 6 &&
          elemNest != 7 &&
          elemNest != 8 &&
          elemNest != 9 &&
          elemNest != 10 &&
          elemUnionNm == ""
        ) {
          if exprArray(elems[i], fnIx) || exprRefArray(elems[i], fnIx) {
            return emitFail("emitProgram: nested arrays are not supported")
          }
        }
        pendingStructIdx = elemStructIdx
        pendingVariantIdx = elemVariantIdx
        if elemUnionNm != "" {
          // Box the element into the shared union box — a concrete VARIANT element
          // (`[s]` where `s: S`) widens via `emitUnionBoxArg`, like a call arg / return.
          // The OUTER literal's list threading (`pendingListKind == 2` + this slot) is
          // cleared around the box: a LIST-arm element (`[1, 2]` of a `(i32[] | f64)[]`)
          // re-enters `emitArr` inside the coerce, and the stale outer kind would force
          // it back onto THIS slot's ref build instead of its own value-atom list build.
          const savedElemK = pendingListKind
          const savedElemS = pendingListSlot
          pendingListKind = 0
          pendingListSlot = 0
          const ubRc = emitUnionBoxArg(body, elemUnionNm, elems[i], fnIx)
          pendingListKind = savedElemK
          pendingListSlot = savedElemS
          if ubRc < 0 { return -1 }
        } else {
          // Reset the `listKind`/`listSlot` context to the INNER list's kind so the element
          // builds the right list, NOT the outer ref-list kind it would inherit. Scalar inner
          // lists seed kind 0/3/4/6; a ref inner list (kind 9) seeds kind 5 + the inner slot, so
          // the element builds as that ref list — which may itself be kind 9 (nesting falls out).
          const elCtx = expCtxHere()
          if elemNest == 4 {
            elCtx.listKind = 0
          } else if elemNest == 6 {
            elCtx.listKind = 3
          } else if elemNest == 7 {
            elCtx.listKind = 4
          } else if elemNest == 8 {
            elCtx.listKind = 6
          } else if elemNest == 10 {
            elCtx.listKind = 7 // f32-inner list -> build each element as an f32[] (kind 7)
          } else if elemNest == 9 {
            elCtx.listKind = 5
            elCtx.listSlot = nestInnerSlot
          }
          // A MAP element (kind 3): a `Map()` element builds THIS element's map struct.
          // The literal twin of the `.push` / indexed-assign seed in `refElemValueCtx` —
          // and the site the whole list-of-maps family ran through, because a list of maps
          // is nearly always SPELLED as a literal (`const xs: {[string]: V}[] = [Map()]`).
          // Unseeded, the element `Map()` built the MONO map struct into a backing typed to
          // the element's own struct: invalid wasm for every value type with a per-value
          // struct, `vl check` rc 0. Inert for a non-`Map()` element (an ident, a call).
          if elemNest == 3 { elCtx.mapSlot = rlElemMapShape(rslot) }
          // A `(i32[] | null)[]` element (kind 4 nullable niche) may be a bare `null` → `ref.null
          // $lTypeIdx`; a `(<ref-array> | null)[]` element (kind 9 nullable niche) → `ref.null
          // $innerWrapper`; a distinct-backing `(f64[] | null)[]` / `(string[] | null)[]` element
          // (kinds 6/7/8/10 nullable niches) → `ref.null` of the leaf-list wrapper SINGLETON.
          // These are WHOLE-VALUE null seeds, so the #964 SEED-LEAK gate applies (stated in
          // full at `emitObj`'s code-28 arm) — here one level down: a nested LIST literal
          // element (`[[null]]` of `((S|null)[]|null)[]`) rebuilds its own inner list, whose
          // OWN nulls would consume the leaked heap (seed 205425905).
          const elIsBareNull = P.nodes[unwrapParen(elems[i])] is NullLit
          if elIsBareNull {
            if elemNest == 4 && rlElemNullable[rslot] == 1 {
              elCtx.nulList = true
            }
            if (
              elemNest == 9 &&
              rlElemNullable[rslot] == 1 &&
              nestInnerSlot >= 0
            ) {
              elCtx.nulRefHeap = rlWrapIdx[nestInnerSlot]
            }
            if rlElemNullable[rslot] == 1 {
              if elemNest == 6 { elCtx.nulRefHeap = mkListIdx }
              if elemNest == 7 { elCtx.nulRefHeap = fl64TypeIdx }
              if elemNest == 8 { elCtx.nulRefHeap = il64TypeIdx }
              if elemNest == 10 { elCtx.nulRefHeap = fl32TypeIdx }
              // A `({[string]: V} | null)[]` element (kind 3 nullable niche) → `ref.null` of
              // the element's map struct (the slot heap, resolved by the kind-3 passes).
              if elemNest == 3 { elCtx.nulRefHeap = rlElemHeap[rslot] }
              // A `((...) => ...) | null` element (kind 5 nullable niche) → `ref.null` of the
              // shared closure fat-pointer (the slot heap, `cloStructIdx`).
              if elemNest == 5 { elCtx.nulRefHeap = rlElemHeap[rslot] }
            }
          }
          if emitExprExpect(body, elems[i], fnIx, elCtx) < 0 { return -1 }
        }
        pendingVariantIdx = -1
        i = i + 1
        if dstRef >= 0 {
          coffRef = arrLitChunkFlush(
            dstRef,
            rlBackIdx[rslot],
            coffRef,
            i,
            elems.length,
          )
        }
      }
      pendingStructIdx = -1
      if dstRef >= 0 {
        fbLocalGet(dstRef)
        wU8(212) // 0xd4 ref.as_non_null — the chunk-built ref backing
      } else {
        fbArrayNewFixed(rlBackIdx[rslot], elems.length) // 0xfb 0x08; builds the ref backing
      }
      fbI32Const(elems.length)      // 0x41 i32.const (len)
      fbI32Const(elems.length)      // 0x41 i32.const (cap)
      fbStructNew(rlWrapIdx[rslot]) // 0xfb 0x00 <this slot's ref-list wrapper>
      return 0
    }
    if !lUsed {
      return emitFail("emitProgram: array literal but list type not collected")
    }
    // THREE element types share the i32 backing but do NOT lower like i32s, so each seeds
    // the element emits (reps per the table at `emitNullLitNode`):
    //   `K[]`             member literals → interned ATOM ids, not strings
    //   `(boolean|null)[]` a `null` → the sentinel 2 (true/false already emit 0/1)
    //   `(K|null)[]`      DUAL-natured — a member literal → its atom id AND a `null` → the
    //                     `-1` sentinel, so both are seeded and `["a", null]` lowers
    // The element type comes from the checker's recorded type (robust to inference); the
    // `pendingListKind == 8` / `== 9` legs catch an all-`null` `[null]`, which self-infers
    // as `null[]` and so is invisible to the node-type probe.
    const litArr = nodeArrayElemIsLitUnion(arrIx)
    const savedArrLU = pendingLitUnion
    if litArr { pendingLitUnion = 1 }
    const nbArr = nodeArrayElemIsNulBool(arrIx) || pendingListKind == 8
    const savedArrNB = pendingNulBool
    if nbArr { pendingNulBool = true }
    const nlluArr = nodeArrayElemIsNulLitUnion(arrIx) || pendingListKind == 9
    const savedArrNLLU = pendingNulLitUnion
    if nlluArr {
      pendingNulLitUnion = true
      pendingLitUnion = 1
    }
    let dstI32 = -1
    let coffI32 = 0
    if elems.length > NEW_FIXED_MAX {
      dstI32 = arrLitChunkStart("i32", 0, aTypeIdx, elems.length)
    }
    let i = 0
    while i < elems.length {
      if !litArr {
        if exprArray(elems[i], fnIx) || exprRefArray(elems[i], fnIx) {
          return emitFail("emitProgram: nested arrays are not supported")
        }
        if exprStruct(elems[i], fnIx) {
          return emitFail(
            "emitProgram: struct array elements are not supported",
          )
        }
        // A MAP-typed element reaching the i32-list fallback (no ref-list/map-array kind was
        // threaded — e.g. `(q) => ([h0])`, a closure body returning `{[string]:f32}[]` whose
        // inferred result rep collapsed to the i32 list): the map STRUCT ref would be stored as
        // an i32 element (`array.new_fixed $aTypeIdx` with a ref operand → "expected i32, found
        // (ref $type)", invalid wasm). A map array can only build through the ref-list path with a
        // threaded map-element kind; with none here there is no sound rep — fail loudly.
        if exprMap(elems[i], fnIx) || nodeTyIsMap(elems[i]) {
          return emitFail(
            "emitProgram: map array elements are not supported in this position",
          )
        }
      }
      if emitExpr(body, elems[i], fnIx) < 0 { return -1 }
      i = i + 1
      if dstI32 >= 0 {
        coffI32 = arrLitChunkFlush(dstI32, aTypeIdx, coffI32, i, elems.length)
      }
    }
    pendingLitUnion = savedArrLU
    pendingNulBool = savedArrNB
    pendingNulLitUnion = savedArrNLLU
    if dstI32 >= 0 {
      fbLocalGet(dstI32)
      wU8(212) // 0xd4 ref.as_non_null — the chunk-built raw backing
    } else {
      fbArrayNewFixed(aTypeIdx, elems.length) // 0xfb 0x08; builds the raw backing
    }
    // Wrap { backing, len = count, cap = count } via struct.new.
    fbI32Const(elems.length) // 0x41 i32.const (len)
    fbI32Const(elems.length) // 0x41 i32.const (cap)
    fbStructNew(lTypeIdx)    // 0xfb 0x00 <list wrapper struct type index>
    return 0
  }
  emitFail("emitProgram: expected an array literal")
}

// ── G8: string-keyed maps (`{[string]: i32}`) — open-addressing hash map ───────
// A map is the 5-field `MAP = { keys, vals, index, count, size }` (see the map-table
// section above for the full representation). Operations HASH the key (FNV-1a) into
// `index` and LINEAR-PROBE to a free-or-matching slot — NO O(n) scan. A function that
// touches a map reserves a 15-slot scratch frame (`mapScratchBase` + 0..14):
//   +0  mapRef : (ref $mStructIdx)  — the map value (string-keyed rep)
//   +1  keyRef : (ref $aTypeIdx)    — the target key string (string-keyed rep)
//   +2  curRef : (ref $aTypeIdx)    — spare (the probed-key compare lives in the
//                                     shared `__map_probe__` helper's own locals)
//   +3  slot   : i32                — probe slot offset into `index`
//   +4  cap    : i32                — index length / newCap (resize)
//   +5  entry  : i32                — index[slot] (entry+1; 0 = miss)
//   +6  keysBk : (ref $mkArrIdx)    — grown keys backing (compact: new keys backing)
//   +7  valsBk : (ref $aTypeIdx)    — grown vals backing (compact: new vals backing)
//   +8  chr    : i32                — inner char cursor (key compare / hash); compact `i`
//   +9  hcur   : i32                — the current op's key HASH, live from `emitMapProbe`
//                                     through an appending set's `hashes[]` store (and
//                                     the i32 mix's accumulator); compact write cursor `j`
//   +10 idxBk  : (ref $aTypeIdx)    — fresh `index` backing (resize); compact new live
//   +11 rslot  : i32                — inner probe slot (resize); compact target cap
//   +12 liveBk : (ref $aTypeIdx)    — grown `live` backing (keys-grow lockstep)
//   +13 hashBk : (ref $aTypeIdx)    — grown `hashes` backing (keys-grow lockstep);
//                                     compact new hashes backing
//   +14 valSet : i32                — a mono SET's stashed value (evaluated BEFORE
//                                     the probe; RESERVED — nothing else writes it)
// The i32-KEYED rep re-types four of those slots and appends them as its own frame
// (`mapI32Base`, reserved only when the module has one, so no offset above
// moves): +0 the i32 KEY (slot 1's twin), +1 the keys backing (slot 6's twin), +2/+3 the
// key-list builder's out/src backings, +4 the mapRef (slot 0's twin). Which of the two a
// site reads is decided by ONE predicate, `cmKeyI32`, through the `cm*` accessors.
// `emitMapProbe` leaves `slot` = the probe slot and `entry` = index[slot]; reused by
// set / get / `??` / `.has` / `delete`. `emitMapResize` rehashes at load factor 1/2;
// `emitMapDelete` tombstones + amortized-`emitMapCompact`s.

// The current op's map struct heap type / vals wrapper / vals backing.
function cmMapTy() { mapTypeIdxOf(cmSlot) }
function cmValsWrap() { mvValsWrapOf(cmSlot) }
function cmValsBack() { mvValsBackOf(cmSlot) }

// True when the current op runs on the i32-KEYED rep. TWO sources, because a map shape
// carries the key in two different places depending on the VALUE:
//   · the MONO-value sentinels `-4` (map) / `-5` (Set) — a value on the shared i32
//     `vals` list interns no slot, so the key has nowhere else to live;
//   · an mv SLOT's own `mvKeyI32` column — a REF or WIDE value interns a slot, and the
//     slot's identity is the (key, value) PAIR, so the slot answers both halves.
// Asked by every accessor below that has to pick between the two keys lists, the two
// probe helpers and the two key scratch slots. Everything NOT below is key-blind by
// construction — it reads the VALUE side, which the slot answers on its own.
function cmKeyI32() { mapShapeKeyI32(cmSlot) }
// The current op's keys-list WRAPPER / BACKING heap types: the string-ref pair for the
// string-keyed rep, the i32 list pair for the i32-keyed one.
function cmKeysWrap() {
  if cmKeyI32() { return lTypeIdx }
  mkListIdx
}
function cmKeysBack() {
  if cmKeyI32() { return aTypeIdx }
  mkArrIdx
}
// The current op's TARGET-KEY scratch local: the string frame's slot 1 (a `(ref
// $aTypeIdx)` string), or the i32 frame's slot 0 (a raw i32).
function cmKeyLocal() {
  if cmKeyI32() { return mapI32Base }
  mapScratchBase + 1
}
// The current op's grown/compacted KEYS-BACKING scratch local: the string frame's slot
// 6, or the i32 frame's slot 1.
function cmKeysBkLocal() {
  if cmKeyI32() { return mapI32Base + 1 }
  mapScratchBase + 6
}
// The current op's mapRef local. An mv SLOT always uses its OWN typed frame slot —
// asked FIRST, because that frame is already typed to the slot's map struct whichever
// key rep the slot carries. Only the two MONO shapes have to choose between the shared
// `(ref $mStructIdx)` scratch slot 0 and the i32-keyed frame's own (the mono local is
// typed to the string-keyed struct and cannot hold the i32-keyed one).
function cmMapRefLocal() {
  if cmSlot >= 0 { return fnMvMapRefLocal(cmSlot) }
  if cmKeyI32() { return mapI32Base + 4 }
  mapScratchBase
}
// The current op's vals-backing scratch local (grow/compact temporary).
function cmValsBkLocal() {
  if cmSlot < 0 { return mapScratchBase + 7 }
  fnMvValsBkLocal(cmSlot)
}

// Evaluate the map receiver `recvIx` ONCE and leave its `(ref $mapStruct)` on the
// operand stack, ready for the mapRef store.
//
// ONE HOME FOR EVALUATING A MAP RECEIVER. Every consumer that parks a map in the
// mapRef local — the indexed-read/set/`??`/`.has`/`delete` probe path
// (`emitMapRecvKey`) and the tombstone-aware `for`-in walk (`emitForInStmt`) — goes
// through here, because the two properties this owns are exactly the two that a
// second hand-written copy loses:
//   · the receiver expression is emitted EXACTLY ONCE, so its side effects run once
//     and every later read (the walked list, `live[]`, the probe) sees the SAME
//     object. A receiver re-emitted for a second read is a fresh evaluation, so a
//     factory returning a new map per call leaves the two reads on DIFFERENT maps.
//   · a NULLABLE map receiver (`{[string]: V} | null`, kind `nulmap`) is a
//     `(ref null $mapStruct)`, so it is recovered before the `(ref $mapStruct)`
//     mapRef store. The checker proved every narrowed map op guarded, so the cast
//     never traps. Omitting it is `vl check`-clean INVALID WASM (`type mismatch:
//     expected (ref $type), found (ref null $type)`), never a diagnostic — the map
//     twin of the nulstruct field-read `ref.as_non_null` (`emitMemberNode`).
function pushMapRecvRef(body: i32[], recvIx: i32, fnIx: i32) {
  if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
  if exprNullableMap(recvIx, fnIx) {
    wU8(212) // 0xd4 ref.as_non_null
  }
  0
}

// `local.get` / `local.set` of the current op's mapRef.
function pushMapRef(_body: i32[]) {
  fbLocalGet(cmMapRefLocal()) // 0x20 local.get
  0
}
function setMapRef(_body: i32[]) {
  fbLocalSet(cmMapRefLocal()) // 0x21 local.set
  0
}

// `local.get` of map scratch slot `n` (the shared mono frame — every slot except
// the mapRef/valsBk/valStash trio is map-shape-agnostic and stays shared).
function pushMapScr(_body: i32[], n: i32) {
  fbLocalGet(mapScratchBase + n) // 0x20 local.get
  0
}

// `local.set` of map scratch slot `n`.
function setMapScr(_body: i32[], n: i32) {
  fbLocalSet(mapScratchBase + n) // 0x21 local.set
  0
}

// `M.keys` (the keys list wrapper ref): `local.get mapRef ; struct.get <mapTy> 0`.
function pushMapKeys(body: i32[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 0) // field 0: keys
  0
}

// `M.vals` (the vals list wrapper ref): `local.get mapRef ; struct.get <mapTy> 1`.
function pushMapVals(body: i32[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 1) // field 1: vals
  0
}

// `M.live` (the i32 tombstone array, parallel to entries; all 1s in this slice):
// `local.get mapRef ; struct.get <mapTy> 2`.
function pushMapLive(body: i32[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 2) // field 2: live
  0
}

// `M.index` (the i32 hash-slot array): `local.get mapRef ; struct.get <mapTy> 3`.
function pushMapIndex(body: i32[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 3) // field 3: index
  0
}

// `M.count` (entries appended): `local.get mapRef ; struct.get <mapTy> 4`.
function pushMapCount(body: i32[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 4) // field 4: count
  0
}

// `M.size` (live entry count): `local.get mapRef ; struct.get <mapTy> 5`.
function pushMapSize(body: i32[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 5) // field 5: size
  0
}

// `M.hashes` (the i32 per-entry FNV cache, parallel to the entries):
// `local.get mapRef ; struct.get <mapTy> 6`.
function pushMapHashes(body: i32[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 6) // field 6: hashes
  0
}

// The hash of the CURRENT op's target key, leaving a NON-NEGATIVE i32 on the stack:
// the FNV-1a of the string in the key scratch slot (a `call` into the shared
// `__str_hash__` helper, whose loop lives once per module — `emitStrHashFnCode`), or
// the integer mix of the i32 key (`fbI32HashMix`, the same generator the i32-keyed
// probe helper's body uses, so the append side and the probe side cannot disagree).
// Both leave the same masked non-negative range, which is what lets the two reps share
// the stored `hashes` array and `__map_resize__`.
function emitMapHashOf(_body: i32[]) {
  if cmKeyI32() {
    // Scratch slot +9 (`hcur`) is the mix's own accumulator — dead across it.
    fbI32HashMix(cmKeyLocal(), mapScratchBase + 9)
    return 0
  }
  fbLocalGet(cmKeyLocal())
  fbCall(gHelpStrHash)
  0
}

// The hash of the current op's key at a site that runs AFTER `emitMapProbe` — the
// `hashes[]` store on an appending `m[k] = v`. A STRING key's hash is the one the probe
// was handed, still in slot +9, so the key is walked once per insert instead of twice;
// an i32 key's is re-mixed, because `__map_probe_i32__` computes its own internally (see
// that helper's header for why the two differ here).
function pushMapProbedHash(body: i32[]) {
  if cmKeyI32() { return emitMapHashOf(body) }
  pushMapScr(body, 9)
}

// PROBE: with `mapRef` (slot 0) and the target `keyRef` (slot 1) set, hash the key
// into `M.index` and linear-probe (wrapping) to the slot holding either the matching
// key's entry or a free (0) slot. Leaves `slot` (slot 3) = that probe slot and `entry`
// (slot 5) = `index[slot]` (0 = miss; else entry-position + 1). Shared by get / has /
// set / delete. The index load factor is kept < 1/2, so a free slot is always reached.
//
// TOMBSTONE-AWARE (mirrors the host's `mapSlotFn`): a slot whose entry is tombstoned
// (`live[entry-1] == 0`) is NOT a hit — it acts as a probe MARKER (kept so delete doesn't
// break the chain), so the probe skips past it. The stored per-entry hash (`hashes[entry-1]`)
// GATES the (string) key comparison: run `keyEq` only when the hash matches AND the entry is
// live. With `live` all-1s (delete-free programs) that is behavior-preserving — the live
// check is always true and the hash always matches for the matching key (same FNV, same key).
//
// A STRING key is hashed HERE and the hash handed to the helper, rather than walked
// inside it, which is what lets an appending set reuse it (`pushMapProbedHash`) instead
// of walking the same key a second time. Two placement rules make that free for every op
// that does NOT append:
//   · the hash is `__map_probe__`'s FIRST operand, so it is emitted on an empty operand
//     stack. Hashing in last position would leave the four backing `struct.get` results
//     live across the `__str_hash__` call, which the engine spills and reloads per probe
//     — measured at ~5% of `collections/word-freq`, whose upsert probes twice per token.
//   · `keepHash` (an appending set, the only reader) is what parks it in scratch slot +9,
//     and it does so with a `local.tee` — ONE instruction, not a set/get pair. Nothing
//     between here and that read writes +9; the only other writer is `emitMapCompact`'s
//     `j` cursor, which belongs to delete.
function emitMapProbe(body: i32[], keepHash: boolean) {
  if !cmKeyI32() {
    emitMapHashOf(body)
    if keepHash { fbLocalTee(mapScratchBase + 9) }
  }
  // Push the probe's shape-agnostic components (the map struct type differs per
  // value shape, but `index`/`hashes`/`live`/`keys` are identically typed across
  // shapes — only these `struct.get`s stay at the call site) and call the shared
  // `__map_probe__` helper (`emitMapProbeFnCode`), which returns the probe SLOT.
  pushMapIndex(body)
  pushMapHashes(body)
  pushMapLive(body)
  pushMapKeysBacking(body)
  fbLocalGet(cmKeyLocal()) // the target key (a string ref, or a raw i32)
  if cmKeyI32() { fbCall(gHelpMapProbeI32) } else { fbCall(gHelpMapProbe) }
  setMapScr(body, 3) // slot
  // entry = index[slot]  (0 = miss; else entry-position + 1)
  pushMapIndex(body)
  pushMapScr(body, 3)
  fbArrayGet(aTypeIdx) // array.get
  setMapScr(body, 5)   // entry
  0
}

// THE ONE HOME of the `-3` map-value reject. Four op sites (`Map()` construction, the
// key ops, `.keys()`, `.values()`) each spelled out this verdict, three with one value
// list and the fourth with a longer one — two stale enumerations of the SUPPORTED side,
// both of which named `string` while a string-valued map lowers fine.
//
// So the message names the REMAINDER instead, which is small and stays small. What the
// mv layer DOES lower (`mvValKindOfName`) is i32 / boolean / f32 / f64 / i64 / string /
// a literal-union atom / a struct / a list at any nesting / a nested map / a union / a
// closure, plus each one's nullable niche. What is left:
//   · a struct that is a MEMBER of a declared union — it lives in the variant table, and
//     the mv slot's `mvValStructIdx` column has no variant half
//     (`tests/cases/maps/error-map-value-struct-in-union.vl`);
//   · a NULLABLE list value, and a nullable closure with a literal-union result — no
//     niche rep is minted (`tests/cases/maps/error-nullable-list-value.vl`);
//   · a value NAME that resolves to none of the above (an un-monomorphized generic
//     application).
//
// The tail clause is the SECOND producer of this same `-3`: `mvSlotOfMapValNameOrMonoKTy`
// returns it for a value type that IS lowerable but whose mv slot nothing interned — a
// map reached through a seam the collect pass misses. That is a compiler gap, not a
// language limit, and the message must not claim the value type is at fault.
function failMapValueType() {
  emitFail(
    "emitProgram: unsupported map value type (no rep for a union-member struct, a nullable list, or a nullable litunion-result closure; any other value type here interned no mv slot)",
  )
}

// Construct an EMPTY map `Map()` onto `body`: two empty lists (each `array.new_fixed`
// count 0, wrapped `{ backing, len=0, cap=0 }`), boxed into the map struct.
function emitMapNew(_body: i32[]) {
  if !mUsed { return emitFail("emitProgram: Map() but map type not collected") }
  // The binding-seeded map SHAPE (consumed here): -1/-2 build the mono map; an mv
  // slot >= 0 builds THIS value type's map struct over its ref vals list.
  let slot = pendingMapSlot
  pendingMapSlot = -1
  if slot == -3 { return failMapValueType() }
  if slot == -2 { slot = -1 }
  if slot == -5 { slot = -4 }
  // The keys/vals accessors below read the op context, so pin it to the shape being
  // constructed (a `Map()` is not reached through `emitMapRecvKey`).
  const savedCm = cmSlot
  cmSlot = slot
  // keys list: an empty backing → wrapper, in the KEY's own list rep (string-ref for
  // `{[string]: V}`, the i32 list for `{[i32]: V}`).
  fbArrayNewFixed(cmKeysBack(), 0) // 0 elements
  fbI32Const(0)                    // len = 0
  fbI32Const(0)                    // cap = 0
  fbStructNew(cmKeysWrap())
  cmSlot = savedCm
  // vals list: empty backing → wrapper (the i32 list, or the slot's ref list).
  fbArrayNewFixed(mvValsBackOf(slot), 0)
  fbI32Const(0)
  fbI32Const(0)
  fbStructNew(mvValsWrapOf(slot))
  // live: empty i32 array (cap 0), parallel to the empty keys/vals entry lists. It
  // grows in lockstep with the keys backing on append (a fresh entry is live = 1).
  fbArrayNewFixed(aTypeIdx, 0)
  // index: i32 hash-slot array of INITIAL_CAP*2 (16) zero-filled slots (0 = empty) —
  // matches the host's `mapNewFn` (4th `struct.new` operand `INITIAL_CAP * 2`). The
  // load factor is kept < 1/2 (resize at `size*2 >= cap`); starting at 2×INITIAL_CAP
  // (not INITIAL_CAP) means a tombstone-churn workload reaches the amortized-compaction
  // threshold (`(count - size) > size + INITIAL_CAP`) BEFORE the index fills with dead
  // probe markers — without it, same-key add/delete churn would fill all 8 slots with
  // dead markers and the next probe would spin forever (no free slot).
  fbI32Const(16) // i32.const 16 (INITIAL_CAP * 2)
  fbArrayNewDefault(aTypeIdx)
  // count = 0, size = 0.
  fbI32Const(0)
  fbI32Const(0)
  // hashes: empty i32 array (cap 0), parallel to the entries; grows in lockstep with
  // the keys backing on append (the stored FNV hash of each key). Mirrors the host's
  // 7th `struct.new` operand (`mapNewFn`); native sizes it like `live` (cap 0, grown
  // on demand) rather than INITIAL_CAP so the entry-parallel arrays stay length-locked.
  fbArrayNewFixed(aTypeIdx, 0)
  // map struct { keys, vals, live, index, count, size, hashes } — the mono struct,
  // or the mv slot's (identical shape, vals field referencing the slot's wrapper).
  fbStructNew(mapTypeIdxOf(slot))
  0
}

// Resolve the receiver's map SHAPE and emit the RECEIVER + KEY exprs, leaving
// BOTH values on the OPERAND STACK ([mapRef, keyRef], keyRef on top) with
// `cmSlot` pinned to the shape. They stay OFF the scratch locals on purpose: an
// inner map op nested in the KEY expr (`b[a["x"] ?? "d"]` with `a` and `b`
// same-shaped) — or, for a SET, in the VALUE expr evaluated between the key and
// the stores — runs its own probe through the SAME shared scratch frame, and a
// value parked in `mapRef`/`keyRef` would be silently clobbered (wrong-map
// probes / lost writes). Values on the wasm operand stack are immune: nested
// ops only touch locals. The caller pops key (slot 1) then mapRef.
function emitMapRecvKey(body: i32[], recvIx: i32, keyIx: i32, fnIx: i32) {
  if !mUsed {
    return emitFail("emitProgram: map op but map type not collected")
  }
  if !exprMap(recvIx, fnIx) {
    return emitFail("emitProgram: map op receiver is not a map")
  }
  // Resolve the receiver's map SHAPE into the op context. A Set (-2 / -5) runs on the
  // mono machinery of its own KEY rep; an unsupported value type (-3) fails loudly.
  const mshape0 = mapShapeOfExpr(recvIx, fnIx)
  if mshape0 == -3 { return failMapValueType() }
  const mshape = mapShapeFoldSet(mshape0)
  // The KEY expression must match the receiver's key rep. The checker proves the pair
  // agrees, so a mismatch here means the receiver's shape resolved wrong — reject
  // loudly rather than emit a string ref into an i32 keys array (invalid wasm).
  if mapShapeKeyI32(mshape) {
    if exprString(keyIx, fnIx) {
      return emitFail("emitProgram: i32-keyed map indexed with a string key")
    }
  } else if !exprString(keyIx, fnIx) {
    return emitFail("emitProgram: map key is not a string")
  }
  // The receiver expr is emitted OUTSIDE the context (it is map-op-free by
  // construction — an Ident/global/constructor).
  if pushMapRecvRef(body, recvIx, fnIx) < 0 { return -1 }
  // A STRING-keyed map's KEY is a string ref — shield it from an ambient atom context
  // (an atom-typed binding init `const x: K = m["k"] ?? "a"` seeds `pendingLitUnion`
  // around the whole init, which would lower the key literal as an i32 atom id). An
  // i32 key is a plain i32 expression and wants no shielding, but zeroing the seed is
  // harmless there too (an i32 key is never an atom). An inner map op in the key expr
  // also clobbers `cmSlot` — pin it AFTER.
  const savedKeyLU = pendingLitUnion
  pendingLitUnion = 0
  const kr = emitExpr(body, keyIx, fnIx)
  pendingLitUnion = savedKeyLU
  if kr < 0 { return -1 }
  cmSlot = mshape
  0
}

// Load the map receiver + key into the scratch frame (slots 0/1) and run the PROBE,
// leaving `slot` (slot 3) = the probe slot and `entry` (slot 5) = `index[slot]`
// (0 = miss; else entry-position + 1). `recvIx`/`keyIx` are arena indices; `recvIx`
// must be a map-typed expression and `keyIx` a string.
function emitMapPrep(body: i32[], recvIx: i32, keyIx: i32, fnIx: i32) {
  if emitMapRecvKey(body, recvIx, keyIx, fnIx) < 0 { return -1 }
  // Pop the stacked pair into the frame only now — user code is done running.
  fbLocalSet(cmKeyLocal()) // the target key
  setMapRef(body)          // mapRef (the shared mono slot, or this mv/i32 frame's)
  emitMapProbe(body, false)
}

// Emit the `??` DEFAULT `d` for a REF-valued map slot (`cmSlot >= 0`) onto `body`, in the
// value's own rep (scalar / union box / struct-list / list-wrapper / struct / nullable
// niche). Factored out of `emitMapGetOr` so the value-null coalesce can emit it exactly
// once whether the read missed the key OR read a stored null.
function emitMapValDefault(
  body: i32[],
  mslot: i32,
  scalarVK: VKind | null,
  defIx: i32,
  fnIx: i32,
) {
  if scalarVK != null {
    return emitScalarValue(body, defIx, fnIx, scalarVK)
  } else if mslot >= 0 && mvValKind[mslot] == 2 {
    // A UNION-valued map's default is coerced into the shared box, like a stored value — a
    // concrete VARIANT default boxes (`emitUnionBoxArg`), as in a call arg / return.
    return emitUnionBoxArg(body, mvValName[mslot], defIx, fnIx)
  } else if mslot >= 0 && mvListValKind(mslot) == "reflist" {
    // A STRUCT-LIST value: hint an empty `[]` default to an empty ref list of the inner
    // struct (`listKind` 1 = struct-element, `listSlot` the inner slot).
    const slCtx = expCtxHere()
    slCtx.listKind = 1
    slCtx.listSlot = mvValInnerRlSlot(mslot)
    return emitExprExpect(body, defIx, fnIx, slCtx)
  }
  // For a non-i32 LIST-valued map, hint an empty `[]` default to the value's list
  // wrapper (`listKind` 3 string / 4 f64 / 6 i64) — an unhinted `[]` defaults to
  // the i32-list wrapper, which the `(ref null <wrapper>)` valStash would reject.
  const dfCtx = expCtxHere()
  const lvk = mvListValKind(mslot)
  if lvk == "strlist" {
    dfCtx.listKind = 3
  } else if lvk == "f64list" {
    dfCtx.listKind = 4
  } else if lvk == "i64list" {
    dfCtx.listKind = 6
  } else if lvk == "f32list" {
    dfCtx.listKind = 7
  } else if mslot >= 0 && mvValKind[mslot] == 1 {
    // A STRUCT-valued map's `?? {f:…}` default builds the map's declared value struct — force
    // its index so a field-name-set twin (`{f:f32}` vs `{f:{[string]:i64}}`) does not resolve
    // the literal to the wrong layout (the store path's twin, see `emitMapSetV`).
    dfCtx.structIdx = mvValStructIdx[mslot]
  }
  // A NULLABLE-value slot admits a bare `null` default (`m[k] ?? null` typing `S | null`) —
  // seed the element heap so the NullLit lowers as `ref.null <elem>`.
  if mvSlotNullable(mslot) { dfCtx.nulRefHeap = mvValElemHeapOf(mslot) }
  emitExprExpect(body, defIx, fnIx, dfCtx)
}

// True when a `??` DEFAULT is itself nullable — a bare `null` literal or a nullable-typed
// expression. `m[k] ?? null` (over a nullable-value map) stays `V | null`, so the ref recover
// must be skipped; a non-null default makes the whole `??` non-null.
function defExprNullable(ix: i32) {
  const u = P.nodes[unwrapParen(ix)]
  if u is NullLit { return true }
  nodeTyIsNullable(ix)
}

// Lower a map GET `m[k]` with a DEFAULT (`m[k] ?? d`) onto `body`: probe, then if the
// key was found push `vals[entry-1]`, else push the default `d`. The self-host checker
// ALWAYS reads a map through `?? -1` (a total fallback), so this is the primary get.
function emitMapGetOr(
  body: i32[],
  recvIx: i32,
  keyIx: i32,
  defIx: i32,
  fnIx: i32,
) {
  if emitMapPrep(body, recvIx, keyIx, fnIx) < 0 { return -1 }
  if cmSlot >= 0 {
    // REF values: a value-typed `if` would need an interned blocktype functype, so
    // route through the slot's NULLABLE valStash local instead — both arms set it
    // (the hit arm with the (ref null) slot read, the miss arm with the default's
    // non-null value), then `ref.as_non_null` recovers the non-null result the
    // `??` expression's type promises. A live entry's val slot is never null.
    const mslot = cmSlot
    // A BOXED value-union map value that INCLUDES null (`{[string]: i32 | null}`,
    // `{[string]: A | B | null}`) stores null as a null-TAGGED box. `??` peels the value NON-null
    // (the checker types the result the raw scalar / non-null union), so the coalesce defaults on
    // the box's null TAG — the value-union sibling of the ref-niche `ref.is_null` path below.
    // A null-FREE union value (`{[string]: A | B}`) has no null tag and takes the plain path.
    if mvValKind[mslot] == 2 {
      if mvValUnionHasNull(mslot) {
        return emitMapGetOrUnionBox(body, mslot, defIx, fnIx)
      }
    }
    // A SCALAR-valued map (f64/i64) stores the value directly; its default is emitted in
    // the value's rep and it needs no `ref.as_non_null`. A ref value (string/struct) does.
    const scalarVK = mvScalarValKind(mslot)
    // A NULLABLE-value REF niche (`{[string]: S | null}` / `{[string]: V | null}` where the
    // value reps as `(ref null <elem>)`) stores null DIRECTLY in its vals slot, so the fused
    // read is null on a MISSING key AND on a STORED null. `??` coalesces on the read VALUE
    // being null (USER SEMANTICS RULING 2026-07-23), so read the raw nullable value first,
    // then a single `ref.is_null` supplies the default — not only the missing-key branch.
    const nullableRef = scalarVK == null && mvSlotNullable(mslot)
    const stashL = fnMvValStashLocal(mslot)
    pushMapScr(body, 5)          // entry
    fbIf(64)                     // if (entry != 0 → found), void
    pushMapVals(body)
    fbStructGet(cmValsWrap(), 0) // vals backing
    pushMapScr(body, 5)          // entry
    fbI32Const(1)
    fbI32Bin(107)                // i32.sub (entry - 1)
    fbArrayGet(cmValsBack())     // scalar (f64/i64) / (ref null <elem>) slot read
    fbLocalSet(stashL)
    fbElse()                     // else — a MISS
    if nullableRef {
      // A miss IS the read's null; the `ref.is_null` coalesce below supplies the default.
      fbRefNull(mvValElemHeapOf(mslot))
      fbLocalSet(stashL)
    } else {
      if emitMapValDefault(body, mslot, scalarVK, defIx, fnIx) < 0 { return -1 }
      cmSlot = mslot
      fbLocalSet(stashL)
    }
    fbEnd() // end (if)
    if nullableRef {
      // Coalesce on the READ VALUE being null — a MISSING key OR a STORED null both take `d`.
      fbLocalGet(stashL)
      wU8(209) // 0xd1 ref.is_null
      fbIf(64)
      if emitMapValDefault(body, mslot, scalarVK, defIx, fnIx) < 0 { return -1 }
      cmSlot = mslot
      fbLocalSet(stashL)
      fbEnd()
    }
    fbLocalGet(stashL)
    // A scalar f64/i64 result needs no null-recovery; a ref value does (`??` is non-null).
    // For a nullable niche the coalesce already replaced every null with `d`, so recover to
    // non-null EXCEPT when the default itself is nullable (`m[k] ?? null` stays `S | null`).
    if scalarVK == null {
      if nullableRef {
        if !defExprNullable(defIx) { fbRefAsNonNull() }
      } else {
        fbRefAsNonNull()
      }
    }
    return 0
  }
  // A nullable-ATOM value map (`{[string]: K | null}` / `{[string]: boolean | null}`) stores
  // null as an i32 SENTINEL directly in the mono vals slot (`-1` for a litunion atom, `2` for a
  // boolean), so the fused read is null on a MISSING key AND when the stored value IS the
  // sentinel. `??` coalesces on the read VALUE being null (USER SEMANTICS RULING 2026-07-23):
  // read the raw i32, then default when it equals the sentinel — not only on a miss. A
  // non-nullable atom / plain-i32 map has no sentinel and keeps the direct value-typed `if`.
  let nulSentinel = 0
  let hasSentinel = false
  if nodeTyMapValIsNulLitUnion(recvIx) {
    nulSentinel = 0 - 1
    hasSentinel = true
  } else if nodeTyMapValIsNulBool(recvIx) {
    nulSentinel = 2
    hasSentinel = true
  }
  if !hasSentinel {
    // if entry != 0 { vals.backing[entry-1] } else { d }  — a value-typed if yielding i32.
    pushMapScr(body, 5)      // entry
    fbIf(127)                // if (entry != 0 → found; a nonzero condition is true), 0x7f i32 blocktype
    pushMapVals(body)
    fbStructGet(lTypeIdx, 0) // struct.get (vals backing), field 0: backing
    pushMapScr(body, 5)      // entry
    fbI32Const(1)
    fbI32Bin(107)            // 0x6b i32.sub  (entry - 1)
    fbArrayGet(aTypeIdx)     // array.get
    fbElse()                 // else
    if emitMonoMapDefault(body, recvIx, defIx, fnIx) < 0 { return -1 }
    fbEnd()                  // end (if)
    return 0
  }
  // raw = (entry != 0) ? backing[entry-1] : sentinel  — a miss reads as null.
  pushMapScr(body, 5)     // entry
  fbIf(127)               // if (entry != 0 → found), i32 blocktype
  pushMapVals(body)
  fbStructGet(lTypeIdx, 0)
  pushMapScr(body, 5)
  fbI32Const(1)
  fbI32Bin(107)
  fbArrayGet(aTypeIdx)
  fbElse()
  fbI32Const(nulSentinel) // miss = null sentinel
  fbEnd()
  // Coalesce: raw == sentinel ? d : raw. Slot +8 (probe hash cursor) is dead after the probe.
  setMapScr(body, 8)
  pushMapScr(body, 8)
  fbI32Const(nulSentinel)
  fbI32Bin(70) // 0x46 i32.eq → raw == sentinel (null, missing OR stored)
  fbIf(127)
  if emitMonoMapDefault(body, recvIx, defIx, fnIx) < 0 { return -1 }
  fbElse()
  pushMapScr(body, 8)
  fbEnd()
  0
}

// Lower `m[k] ?? d` over a BOXED value-union map value that includes null (`{[string]: i32 | null}`,
// `{[string]: A | B | null}`, mv kind 2 with a `null` atom). Reads the box (hit → the stored box;
// miss → the null-tagged box), then COALESCES on the box's null TAG (`??` fires on the value being
// null — a MISSING key AND a STORED null): a `scalar | null` value peels to the RAW unboxed scalar
// (the checker's non-null result type), a multi-member `… | null` to the NON-null union box.
function emitMapGetOrUnionBox(body: i32[], mslot: i32, defIx: i32, fnIx: i32) {
  const uvn = mvValName[mslot]
  // D-UNION set ADT — the map value union's members from the recorded member
  // columns; an un-interned value spelling re-splits (the ladder fall-through).
  // D-SETONCE: one resolution of the map value's member set feeds BOTH the member
  // walk and the residual code below (master resolved it twice — once inside
  // `msMemberAtomsOf`, once inside the residual-kind resolution).
  const uvsid = msSetOfText(uvn)
  const atoms: string[] = []
  if !msMemberAtomsOfSet(uvsid, atoms) { splitUnionAtoms(uvn, atoms) }
  const stashL = fnMvValStashLocal(mslot)
  // raw box: hit → stored (ref null $uBox); miss → the null-tagged box.
  pushMapScr(body, 5)          // entry
  fbIf(64)                     // if (entry != 0 → found), void
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 0) // vals backing
  pushMapScr(body, 5)
  fbI32Const(1)
  fbI32Bin(107)                // i32.sub (entry - 1)
  fbArrayGet(cmValsBack())     // the stored (ref null $uBox) slot read
  fbLocalSet(stashL)
  fbElse()                     // miss = the read's null (a null-tagged box)
  fbI32Const(nullBoxTag())
  fbRefNullNone()
  fbStructNew(uBoxIdx)
  fbLocalSet(stashL)
  fbEnd()
  // A `scalar | null` value (exactly one non-null scalar member) peels to the RAW scalar — take
  // the default on the null tag, else unbox the scalar payload.
  if atoms.length == 2 {
    // D-UNION-ATOM-KIND: the residual member's banked ABI code; the rendered atom is
    // re-parsed only where the set pool declines. The value box follows from the code.
    // D-RESIDUE: the SUBTRACTION that produces that rendering now lives inside the decline
    // branch too. Master resolved the set, cleared the null bits and rendered the survivor
    // on EVERY call, then used the rendering only where the bank had already declined —
    // and across the four sites that decline is reached 0 times on the whole corpus and 0
    // times over 50,400 fuzz programs, with 19 corpus files reaching the sites themselves
    // (the P-RCH / P-SITE measurement in the destringify doc). Kept because the population
    // it serves — an ALIAS-spelled nullable value union — is rejected by the CHECKER before
    // emit, not because it cannot exist.
    let ak = unionResidualSoloKindOfSet(uvsid)
    if ak == -2 { ak = valueAtomKind(removeAtomFromSet(uvn, "null")) }
    const vb = vbHeapIdxOfKind(ak)
    if vb < 0 {
      return emitFail("emitProgram: scalar|null map value has no value box")
    }
    fbLocalGet(stashL)
    fbStructGet(uBoxIdx, 0)      // field 0: tag
    fbI32Const(nullBoxTag())
    fbI32Bin(70)                 // 0x46 i32.eq → null?
    fbIf(valBlockTypeOfKind(ak)) // value-typed if in the scalar's rep
    ctrlEnter()
    if emitExprAsKind(body, defIx, ak, fnIx) < 0 { return -1 }
    fbElse()
    fbLocalGet(stashL)
    fbStructGet(uBoxIdx, 1)      // field 1: value (anyref payload)
    fbRefCast(vb)
    fbStructGet(vb, 0)           // the scalar payload
    fbEnd()
    ctrlLeave()
    return 0
  }
  // A MULTI-member `… | null` value peels to the NON-null union box: on the null tag, box the
  // default like a stored value (`emitUnionBoxArg`); else keep the stored box. `ref.as_non_null`
  // recovers the non-null box the checker's non-null union result promises.
  fbLocalGet(stashL)
  fbStructGet(uBoxIdx, 0) // field 0: tag
  fbI32Const(nullBoxTag())
  fbI32Bin(70)            // 0x46 i32.eq → null?
  fbIf(64)
  if emitUnionBoxArg(body, uvn, defIx, fnIx) < 0 { return -1 }
  fbLocalSet(stashL)
  fbEnd()
  fbLocalGet(stashL)
  fbRefAsNonNull()
  0
}

// Emit the `??` DEFAULT for a MONO-atom-valued map (`cmSlot < 0`) onto `body`: an i32 atom id
// for a litunion value (a MEMBER literal under `pendingLitUnion`, or an atom-typed expr; a bare
// `null` → the `-1` sentinel), else the value's own rep (boolean / i32). A non-member / general
// string is the wrong rep for the fused i32 result — fail loudly.
function emitMonoMapDefault(body: i32[], recvIx: i32, defIx: i32, fnIx: i32) {
  const atomTexts = nodeTyMapValLitUnionTexts(recvIx)
  let atomDef = false
  let nulAtomDef = false
  if atomTexts.length > 0 {
    const du = P.nodes[unwrapParen(defIx)]
    if du is StrLit {
      if litLexIsMember(du.strText, atomTexts) { atomDef = true }
    } else if du is NullLit {
      // A NULLABLE-atom value (`{[string]: K | null}`) admits a bare `null` default — lowered as
      // the `-1` niche sentinel (the `??` result stays `K | null`).
      if nodeTyMapValIsNulLitUnion(recvIx) {
        atomDef = true
        nulAtomDef = true
      }
    } else if exprIsLitAtom(defIx, fnIx) {
      atomDef = true
    }
    if !atomDef {
      return emitFail(
        "emitProgram: `??` over an atom-valued map needs a member-literal (or atom) default",
      )
    }
  }
  if nulAtomDef {
    fbI32Const(0 - 1)
    return 0
  }
  if atomDef { pendingLitUnion = 1 }
  const dfr = emitExpr(body, defIx, fnIx)
  if atomDef { pendingLitUnion = 0 }
  if dfr < 0 { return -1 }
  0
}

// Lower a bare map GET `m[k]` (no `??`) onto `body`: probe, return `vals[entry-1]` or
// `0` when absent. The checker never uses a bare map get (always `?? -1`); provided for
// completeness so `m[k]` in value position is total (0 default).
function emitMapGet(body: i32[], recvIx: i32, keyIx: i32, fnIx: i32) {
  if emitMapPrep(body, recvIx, keyIx, fnIx) < 0 { return -1 }
  if cmSlot >= 0 {
    // REF values: yield the NULLABLE element — the (ref null <elem>) vals slot on
    // a hit, `ref.null <elem>` on a miss — via the slot's valStash (same
    // blocktype-avoidance as `emitMapGetOr`). The `m[k]` type is `V | null`.
    const mslot = cmSlot
    pushMapScr(body, 5) // entry
    fbIf(64)            // if (entry != 0), void
    pushMapVals(body)
    fbStructGet(cmValsWrap(), 0)
    pushMapScr(body, 5) // entry
    fbI32Const(1)
    fbI32Bin(107)       // i32.sub (entry - 1)
    fbArrayGet(cmValsBack())
    fbLocalSet(fnMvValStashLocal(mslot))
    fbElse()            // else
    // A miss yields the rep's empty value: 0.0 for an f64 map, 0 for an i64 map, else
    // `ref.null` for a ref (string/struct) value.
    if mvValKind[mslot] == 11 { fbF64Const("0") }
    else if mvValKind[mslot] == 10 { fbI64Const(0, 0) }
    else { fbRefNull(mvValElemHeapOf(mslot)) }
    fbLocalSet(fnMvValStashLocal(mslot))
    fbEnd() // end
    fbLocalGet(fnMvValStashLocal(mslot))
    return 0
  }
  pushMapScr(body, 5) // entry
  fbIf(127)           // if (entry != 0), i32 blocktype
  pushMapVals(body)
  fbStructGet(lTypeIdx, 0)
  pushMapScr(body, 5) // entry
  fbI32Const(1)
  fbI32Bin(107)       // i32.sub (entry - 1)
  fbArrayGet(aTypeIdx)
  fbElse()            // else — a miss reads as the rep's empty value. For a NICHE-BEARING
  // value map (`K` / `K | null` atoms, `boolean` / `boolean | null`) that empty value IS null
  // (the `-1` / `2` sentinel), so a bare-read `!= null` narrow sees a missing key as null —
  // matching the ref-niche path's `ref.null` miss and `emitMapGetOr`'s sentinel coalesce.
  //
  // THE NON-NULLABLE VALUE SPELLING GETS THE SENTINEL TOO. `{[K]: V}` and `{[K]: V | null}`
  // differ only in whether a null can be STORED; a BARE read is `V | null` in BOTH (a missing
  // key is null), so the read's rep is the niche either way. Yielding `0` for the non-nullable
  // half was a SILENT WRONG ANSWER, not a missing feature: `0` is a real value — atom id 0 is
  // the FIRST-interned member, and boolean 0 is `false` — so `m[missing] == <that member>` and
  // `m[missing] == false` both read TRUE, and `const g = m[k]; if g != null` narrowed a miss
  // NON-null. A plain-i32 map is the one that genuinely has no spare value; it keeps `0` and
  // its `!= null` narrow stays the loud `bare null needs a struct-typed context` reject.
  if nodeTyMapValIsNulLitUnion(recvIx) || nodeTyMapValIsLitUnion(recvIx) {
    fbI32Const(0 - 1)
  } else if nodeTyMapValIsNulBool(recvIx) || nodeTyMapValIsBool(recvIx) {
    fbI32Const(2)
  } else {
    fbI32Const(0) // i32.const 0
  }
  fbEnd() // end
  0
}

// Lower a bare map GET `m[k]` of a UNION-valued map (mv kind 2) onto `body`, leaving the
// NON-null `(ref $uBoxIdx)` box a kind-4 `"union"` binding stores: the hit arm loads the
// stored box from the vals slot, the miss arm synthesizes the NULL-TAGGED box (the same
// `nullBoxTag()` rep `emitUnionCoerce`'s NullLit arm stores for an `A | B | null`
// binding), and `ref.as_non_null` recovers the box the nullable valStash routing loses
// (a live entry's val slot is never null; the miss arm's box is non-null by construction).
// The `t != null` / `is` narrows then read the tag exactly as an annotated `V | null`
// binding's do.
function emitMapGetUnionBox(body: i32[], recvIx: i32, keyIx: i32, fnIx: i32) {
  if emitMapPrep(body, recvIx, keyIx, fnIx) < 0 { return -1 }
  if cmSlot < 0 {
    return emitFail(
      "emitProgram: union-valued map read but no mv slot resolved",
    )
  }
  const mslot = cmSlot
  pushMapScr(body, 5)          // entry
  fbIf(64)                     // if (entry != 0 → found), void
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 0) // vals backing
  pushMapScr(body, 5)          // entry
  fbI32Const(1)
  fbI32Bin(107)                // i32.sub (entry - 1)
  fbArrayGet(cmValsBack())     // the stored (ref null $uBoxIdx) slot read
  fbLocalSet(fnMvValStashLocal(mslot))
  fbElse()                     // else — a miss IS the read's `null`: the null-tagged box
  fbI32Const(nullBoxTag())
  fbRefNullNone()              // the payload slot is unread under the null tag
  fbStructNew(uBoxIdx)
  fbLocalSet(fnMvValStashLocal(mslot))
  fbEnd()                      // end (if)
  fbLocalGet(fnMvValStashLocal(mslot))
  fbRefAsNonNull()
  0
}

// Lower a map HAS `m.has(k)` / `k in m` onto `body`: probe, push 1 if found else 0.
function emitMapHas(body: i32[], recvIx: i32, keyIx: i32, fnIx: i32) {
  if emitMapPrep(body, recvIx, keyIx, fnIx) < 0 { return -1 }
  pushMapScr(body, 5) // entry
  fbI32Const(0)
  fbI32Bin(71)        // 0x47 i32.ne (entry != 0 → 1, else 0)
  0
}

// Lower `m.keys()` onto `body`, leaving a fresh STRING list (`$mkListIdx`) of the map's
// LIVE keys in insertion order. The ordered keys/live arrays carry tombstoned entries
// after a delete (`live[i] == 0`), so it copies only live keys: `out[j++] = keys[i]` for
// every `i` in `[0, count)` with `live[i] != 0`, then wraps `out` with `len = j`. Uses
// the 6-slot key-list builder frame (`mapKeysBase`). The receiver is re-emitted to read
// each of its three fields (a map op receiver is a simple binding — re-reading is
// effect-free), avoiding a per-shape map-ref local.
function emitMapKeys(body: i32[], recvIx: i32, fnIx: i32) {
  if !exprMap(recvIx, fnIx) {
    return emitFail("emitProgram: .keys() receiver is not a map")
  }
  if !fnUsesMapKeys {
    return emitFail("emitProgram: .keys() scratch frame not reserved")
  }
  const shape0 = mapShapeOfExpr(recvIx, fnIx)
  if shape0 == -3 { return failMapValueType() }
  // A Set's keys() runs on the mono machinery of its own KEY rep.
  const shape = mapShapeFoldSet(shape0)
  // The KEY rep, from the mono sentinel OR the mv slot's own column — the same question
  // `cmKeyI32` asks. A `{[i32]: string}`'s `.keys()` is an `i32[]` even though its shape
  // is an mv slot, so this cannot key off the sentinel alone.
  const keyI32 = mapShapeKeyI32(shape)
  if !keyI32 && !slUsed {
    return emitFail("emitProgram: .keys() but string list type not collected")
  }
  const mapTy = mapTypeIdxOf(shape)
  // The KEY rep's list wrapper / backing, and — since the builder's frame slots are
  // typed per rep — the i32 frame's own out/src slots for an i32-keyed map.
  let keysWrap = mkListIdx
  let keysBack = mkArrIdx
  if keyI32 {
    keysWrap = lTypeIdx
    keysBack = aTypeIdx
  }
  let outBackL = mapKeysBase + 0
  let keysBackL = mapKeysBase + 1
  if keyI32 {
    outBackL = mapI32Base + 2
    keysBackL = mapI32Base + 3
  }
  const liveL = mapKeysBase + 2
  const iL = mapKeysBase + 3
  const jL = mapKeysBase + 4
  const countL = mapKeysBase + 5
  // keysBack = recv.keys.backing  (field 0 = keys wrapper, its field 0 = backing)
  if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
  fbStructGet(mapTy, 0)
  fbStructGet(keysWrap, 0)
  fbLocalSet(keysBackL)
  // live = recv.live  (field 2)
  if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
  fbStructGet(mapTy, 2)
  fbLocalSet(liveL)
  // count = recv.count  (field 4 — entries INCLUDING tombstones)
  if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
  fbStructGet(mapTy, 4)
  fbLocalSet(countL)
  // out = array.new_default <keysBacking> count (sized at count; `len` set to live j)
  fbLocalGet(countL)
  fbArrayNewDefault(keysBack)
  fbLocalSet(outBackL)
  // j = 0 ; i = 0
  fbI32Const(0)
  fbLocalSet(jL)
  fbI32Const(0)
  fbLocalSet(iL)
  // loop { if i >= count {} else { if live[i] != 0 { out[j]=keys[i]; j++ } ; i++ ; br } }
  fbLoop(64)
  fbLocalGet(iL)
  fbLocalGet(countL)
  fbI32Bin(78) // 0x4e i32.ge_s (i >= count → done)
  fbIf(64)
  // then: done (empty)
  fbElse()
  // if live[i] != 0
  fbLocalGet(liveL)
  fbLocalGet(iL)
  fbArrayGet(aTypeIdx)
  fbI32Const(0)
  fbI32Bin(71) // 0x47 i32.ne
  fbIf(64)
  // out[j] = keys[i]
  fbLocalGet(outBackL)
  fbLocalGet(jL)
  fbLocalGet(keysBackL)
  fbLocalGet(iL)
  fbArrayGet(keysBack)
  fbArraySet(keysBack)
  // j = j + 1
  fbLocalGet(jL)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  fbLocalSet(jL)
  fbEnd() // end (live if)
  // i = i + 1
  fbLocalGet(iL)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  fbLocalSet(iL)
  fbBr(1) // → loop header (else=0, loop=1)
  fbEnd() // end (ge_s if/else)
  fbEnd() // end (loop)
  // wrapper = struct.new <keysWrapper> (out, len=j, cap=count)
  fbLocalGet(outBackL)
  fbLocalGet(jL)
  fbLocalGet(countL)
  fbStructNew(keysWrap)
  0
}

// Lower `m.values()` over a MONO i32 map onto `body`, leaving a fresh i32 list (`$lTypeIdx`)
// of the map's LIVE values in insertion order — the value analogue of `emitMapKeys`, reading
// the ordered VALS list (field 1) instead of keys and skipping tombstoned entries
// (`live[i] == 0`). Other value types (string / struct / f64 / i64 / ref) iterate fine via
// `for v in m.values()` but the BOUND list form here is i32-only for now (the output backing
// type would otherwise vary per value kind). Uses the 6-slot `mapValsBase` frame.
function emitMapValues(body: i32[], recvIx: i32, fnIx: i32) {
  if !exprMap(recvIx, fnIx) {
    return emitFail("emitProgram: .values() receiver is not a map")
  }
  const shape = mapShapeOfExpr(recvIx, fnIx)
  // A SET's `.values()` yields its ELEMENTS (its keys), built by `emitMapKeys` — for
  // both key reps, which is why the Set sentinel is a PAIR.
  if shape == -2 || shape == -5 { return emitMapKeys(body, recvIx, fnIx) }
  if shape == -3 { return failMapValueType() }
  if !fnUsesMapVals {
    return emitFail("emitProgram: .values() scratch frame not reserved")
  }
  const mapTy = mapTypeIdxOf(shape)
  const valsWrap = mvValsWrapOf(shape)
  const valsBack = mvValsBackOf(shape)
  // Frame: a MONO map's self-contained `mapValsBase` (all i32-backed), an mv map's per-slot
  // output backing + the mv frame's `valsBk` source + the key-list frame's live/i/j/count.
  let outBackL = mapValsBase + 0
  let valsBackL = mapValsBase + 1
  let liveL = mapValsBase + 2
  let iL = mapValsBase + 3
  let jL = mapValsBase + 4
  let countL = mapValsBase + 5
  if shape >= 0 {
    outBackL = fnMvValsOutLocal(shape)
    valsBackL = fnMvValsBkLocal(shape)
    liveL = mapKeysBase + 2
    iL = mapKeysBase + 3
    jL = mapKeysBase + 4
    countL = mapKeysBase + 5
  }
  // valsBack = recv.vals.backing  (field 1 = vals wrapper, its field 0 = backing)
  if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
  fbStructGet(mapTy, 1)
  fbStructGet(valsWrap, 0)
  fbLocalSet(valsBackL)
  // live = recv.live  (field 2)
  if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
  fbStructGet(mapTy, 2)
  fbLocalSet(liveL)
  // count = recv.count  (field 4 — entries INCLUDING tombstones)
  if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
  fbStructGet(mapTy, 4)
  fbLocalSet(countL)
  // out = array.new_default <valsBack> count
  fbLocalGet(countL)
  fbArrayNewDefault(valsBack)
  fbLocalSet(outBackL)
  fbI32Const(0)
  fbLocalSet(jL)
  fbI32Const(0)
  fbLocalSet(iL)
  // loop { if i >= count {} else { if live[i] != 0 { out[j]=vals[i]; j++ } ; i++ ; br } }
  fbLoop(64)
  fbLocalGet(iL)
  fbLocalGet(countL)
  fbI32Bin(78) // i32.ge_s
  fbIf(64)
  fbElse()
  fbLocalGet(liveL)
  fbLocalGet(iL)
  fbArrayGet(aTypeIdx)
  fbI32Const(0)
  fbI32Bin(71) // i32.ne
  fbIf(64)
  // out[j] = vals[i]
  fbLocalGet(outBackL)
  fbLocalGet(jL)
  fbLocalGet(valsBackL)
  fbLocalGet(iL)
  fbArrayGet(valsBack)
  fbArraySet(valsBack)
  fbLocalGet(jL)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(jL)
  fbEnd() // end (live if)
  fbLocalGet(iL)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(iL)
  fbBr(1)
  fbEnd() // end (ge_s if/else)
  fbEnd() // end (loop)
  // wrapper = struct.new <valsWrap> (out, len=j, cap=count)
  fbLocalGet(outBackL)
  fbLocalGet(jL)
  fbLocalGet(countL)
  fbStructNew(valsWrap)
  0
}

// REHASH primitive: with `mapRef` in slot 0 and the target capacity in slot 4
// (`newCap`), allocate a fresh `index` of `newCap` slots and REBUILD it from the LIVE
// entries — for each entry `i` in `[0, count)` with `live[i] != 0`, RE-PLACE from the
// STORED `hashes[i]` (no key re-hashing — mirrors the host's `mapRehashFn`) and
// linear-probe to a free slot, writing `i+1`. The ordered keys/vals/live/hashes are
// UNTOUCHED (insertion order preserved); only `index` is rebuilt. Scratch use (all
// free after the probe/append): 4 newCap, 3 entry cursor `i`, 10 new index backing, 11
// inner probe slot. Used by `emitMapResize` (load-factor grow, newCap = 2×cap) and
// `emitMapCompact` (shrink to a live-count-based cap).
function emitMapRehashTo(body: i32[]) {
  // idxBk = array.new_default $aTypeIdx newCap  (zero-filled)
  pushMapScr(body, 4) // newCap (slot 4, set by the caller)
  fbArrayNewDefault(aTypeIdx)
  setMapScr(body, 10) // idxBk (slot 10)
  // i = 0
  fbI32Const(0)
  setMapScr(body, 3) // i (slot 3)
  // loop { if i >= count {} else { rebuild entry i ; i++ ; br } }
  fbLoop(64)          // loop, void
  pushMapScr(body, 3) // i
  pushMapCount(body)
  fbI32Bin(78)        // i32.ge_s (i >= count → done)
  fbIf(64)            // if, void
  // then: done (empty)
  fbElse() // else
  // Skip tombstoned entries — only LIVE entries get re-placed in the new index (mirror
  // the host's `mapRehashFn` `if live[i] != 0`). `live` is all-1s in a delete-free
  // program, so this `if` is always taken (behavior-preserving).
  pushMapLive(body)
  pushMapScr(body, 3)  // i
  fbArrayGet(aTypeIdx) // array.get live[i]
  fbI32Const(0)
  fbI32Bin(71)         // 0x47 i32.ne (live[i] != 0)
  fbIf(64)             // if, void
  // rslot = hashes[i] % newCap  — RE-PLACE FROM THE STORED HASH (no key re-hashing).
  pushMapHashes(body)
  pushMapScr(body, 3)  // i
  fbArrayGet(aTypeIdx) // array.get hashes[i]
  pushMapScr(body, 4)  // newCap
  fbI32Bin(112)        // i32.rem_u
  setMapScr(body, 11)  // rslot
  // while idxBk[rslot] != 0 { rslot = (rslot + 1) % newCap }
  fbBlock(64) // block (inner probe break), void
  fbLoop(64)  // loop, void
  // if idxBk[rslot] == 0 { br 1 → out of inner block }
  pushMapScr(body, 10) // idxBk
  pushMapScr(body, 11) // rslot
  fbArrayGet(aTypeIdx) // array.get
  fbI32Eqz()           // i32.eqz
  fbBrIf(1)            // br_if depth 1 → out of inner block
  // rslot = (rslot + 1) % newCap
  pushMapScr(body, 11)
  fbI32Const(1)
  fbI32Bin(106)       // i32.add
  pushMapScr(body, 4) // newCap
  fbI32Bin(112)       // i32.rem_u
  setMapScr(body, 11)
  fbBr(0)             // br → inner loop header
  fbEnd()             // end (inner loop)
  fbEnd()             // end (inner block)
  // idxBk[rslot] = i + 1
  pushMapScr(body, 10) // idxBk
  pushMapScr(body, 11) // rslot
  pushMapScr(body, 3)  // i
  fbI32Const(1)
  fbI32Bin(106)        // i32.add (i + 1)
  fbArraySet(aTypeIdx) // array.set
  fbEnd()              // end (live[i] != 0 if)
  // i = i + 1
  pushMapScr(body, 3)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  setMapScr(body, 3)
  fbBr(1)       // br → outer loop header
  fbEnd()       // end (ge_s if)
  fbEnd()       // end (outer loop)
  // M.index = idxBk
  pushMapRef(body)          // mapRef
  pushMapScr(body, 10)      // idxBk
  fbStructSet(cmMapTy(), 3) // struct.set field 3: index
  0
}

// Resize the `index` when the load factor (size / cap) crosses 1/2 — a `call`
// into the shared `__map_resize__` helper (`emitMapResizeFnCode`), which returns
// the doubled+rehashed backing (or the old one when the load factor is fine);
// the result is stored back unconditionally. Only the receiver `struct.get`s and
// the final `struct.set` are shape-typed, so they stay at the call site. The
// ordered entry lists are untouched.
function emitMapResize(body: i32[]) {
  pushMapRef(body) // the struct.set receiver
  pushMapIndex(body)
  pushMapHashes(body)
  pushMapLive(body)
  pushMapCount(body)
  pushMapSize(body)
  fbCall(gHelpMapResize)
  fbStructSet(cmMapTy(), 3) // struct.set field 3: index
  0
}

// `emitMapCompact` (mirror of the host's `mapCompactFn`): reclaim tombstones. Rebuild
// keys/vals/live/hashes from the LIVE entries only (dropping deleted ones, preserving
// insertion order), set `count = size`, then rebuild the index at a live-count-based
// capacity (next pow2 ≥ 2×size, floored at INITIAL_CAP*2 = 16). This bounds `count`
// and the entry+index arrays under add/delete churn. `mapRef` in slot 0. Scratch:
//   6 nk (ref $mkArrIdx), 7 nv (ref $aTypeIdx), 10 nl (ref $aTypeIdx),
//   13 nh (ref $aTypeIdx) — the rebuilt entry arrays; 8 = i (read cursor),
//   9 = j (write cursor), 11 = target cap; 4 = newCap for `emitMapRehashTo`.
function emitMapCompact(body: i32[]) {
  // Fresh entry arrays sized to the OLD entry capacity (keeps spare room; lengths are
  // irrelevant to iteration — count/size bound it). Mirrors the host's `array.new_default
  // (len(oldArr))`.
  // nk = new keys backing (slot 6)
  pushMapKeysBacking(body)
  fbArrayLen()
  fbArrayNewDefault(cmKeysBack())
  setMapScrKB(body) // nk (the keys-backing scratch of this KEY rep)
  // nv = new vals backing (the valsBk scratch — slot 7 mono, the mv frame else)
  pushMapValsBacking(body)
  fbArrayLen()
  fbArrayNewDefault(cmValsBack())
  setMapScrVB(body) // nv
  // nl = new live backing (slot 10)
  pushMapLive(body)
  fbArrayLen()
  fbArrayNewDefault(aTypeIdx)
  setMapScr(body, 10) // nl (slot 10)
  // nh = new hashes backing (slot 13)
  pushMapHashes(body)
  fbArrayLen()
  fbArrayNewDefault(aTypeIdx)
  setMapScrHB(body) // nh (slot 13)
  // i = 0 ; j = 0
  fbI32Const(0)
  setMapScr(body, 8) // i (read cursor)
  fbI32Const(0)
  setMapScr(body, 9) // j (write cursor)
  // Copy the live entries down, compacting out tombstones (order kept).
  // loop { if i >= count {} else { if live[i] != 0 { copy i->j ; j++ } ; i++ ; br } }
  fbLoop(64)          // loop, void
  pushMapScr(body, 8) // i
  pushMapCount(body)
  fbI32Bin(78)        // i32.ge_s (i >= count → done)
  fbIf(64)            // if, void
  // then: done (empty)
  fbElse()             // else
  pushMapLive(body)
  pushMapScr(body, 8)  // i
  fbArrayGet(aTypeIdx) // live[i]
  fbI32Const(0)
  fbI32Bin(71)         // i32.ne (live[i] != 0)
  fbIf(64)             // if, void
  // nk[j] = keys.backing[i]
  pushMapScrKB(body)       // nk
  pushMapScr(body, 9)      // j
  pushMapKeysBacking(body)
  pushMapScr(body, 8)      // i
  fbArrayGet(cmKeysBack()) // keys.backing[i] (a string ref / a raw i32)
  fbArraySet(cmKeysBack())
  // nv[j] = vals.backing[i]
  pushMapScrVB(body)       // nv
  pushMapScr(body, 9)      // j
  pushMapValsBacking(body)
  pushMapScr(body, 8)      // i
  fbArrayGet(cmValsBack()) // vals.backing[i]
  fbArraySet(cmValsBack())
  // nl[j] = 1
  pushMapScr(body, 10) // nl
  pushMapScr(body, 9)  // j
  fbI32Const(1)
  fbArraySet(aTypeIdx)
  // nh[j] = hashes[i]
  pushMapScrHB(body)   // nh
  pushMapScr(body, 9)  // j
  pushMapHashes(body)
  pushMapScr(body, 8)  // i
  fbArrayGet(aTypeIdx) // hashes[i]
  fbArraySet(aTypeIdx)
  // j = j + 1
  pushMapScr(body, 9)
  fbI32Const(1)
  fbI32Bin(106)
  setMapScr(body, 9)
  fbEnd() // end (live[i] != 0 if)
  // i = i + 1
  pushMapScr(body, 8)
  fbI32Const(1)
  fbI32Bin(106)
  setMapScr(body, 8)
  fbBr(1) // br → loop header
  fbEnd() // end (ge_s if)
  fbEnd() // end (loop)
  // Swap the rebuilt entry arrays into the keys/vals list wrappers + the struct.
  // keys.backing = nk ; keys.len = size ; keys.cap = len(nk)
  pushMapKeys(body)
  pushMapScrKB(body)
  fbStructSet(cmKeysWrap(), 0) // keys.backing = nk
  pushMapKeys(body)
  pushMapSize(body)
  fbStructSet(cmKeysWrap(), 1) // keys.len = size
  pushMapKeys(body)
  pushMapScrKB(body)
  fbArrayLen()
  fbStructSet(cmKeysWrap(), 2) // keys.cap = len(nk)
  // vals.backing = nv ; vals.len = size ; vals.cap = len(nv)
  pushMapVals(body)
  pushMapScrVB(body)
  fbStructSet(cmValsWrap(), 0) // vals.backing = nv
  pushMapVals(body)
  pushMapSize(body)
  fbStructSet(cmValsWrap(), 1) // vals.len = size
  pushMapVals(body)
  pushMapScrVB(body)
  fbArrayLen()
  fbStructSet(cmValsWrap(), 2) // vals.cap = len(nv)
  // M.live = nl ; M.hashes = nh
  pushMapRef(body)
  pushMapScr(body, 10)      // nl
  fbStructSet(cmMapTy(), 2) // live = nl
  pushMapRef(body)
  pushMapScrHB(body)        // nh
  fbStructSet(cmMapTy(), 6) // hashes = nh
  // count = size (no tombstones remain)
  pushMapRef(body)
  pushMapSize(body)
  fbStructSet(cmMapTy(), 4) // count = size
  // Target index cap: next pow2 ≥ 2×size, floored at INITIAL_CAP*2 = 16. cap in slot 11.
  fbI32Const(16)
  setMapScr(body, 11) // cap
  // while cap < 2*size { cap = cap * 2 }
  fbLoop(64)           // loop, void
  pushMapScr(body, 11) // cap
  pushMapSize(body)
  fbI32Const(2)
  fbI32Bin(108)        // size * 2
  fbI32Bin(79)         // 0x4f i32.ge_u (cap >= 2*size → done)
  fbIf(64)             // if, void
  // then: done (empty)
  fbElse()      // else
  pushMapScr(body, 11)
  fbI32Const(2)
  fbI32Bin(108) // cap * 2
  setMapScr(body, 11)
  fbBr(1)       // br → loop header
  fbEnd()       // end (ge_u if)
  fbEnd()       // end (loop)
  // Rebuild the index at the chosen cap.
  pushMapScr(body, 11) // cap
  setMapScr(body, 4)   // newCap (for emitMapRehashTo)
  if emitMapRehashTo(body) < 0 { return -1 }
  0
}

// Lower a map DELETE `m.delete(k): boolean` onto `body` (mirror of the host's
// `mapDeleteFn`): probe to the entry; if `index[slot] == 0` push 0 (absent), else
// tombstone `live[entry-1] = 0`, `size -= 1`, amortized-`compact` when dead entries
// (`count - size`) exceed `size + INITIAL_CAP`, and push 1. Leaves a 0/1 i32 on the
// stack (consumed as a boolean expression, or dropped as a bare statement).
function emitMapDelete(body: i32[], recvIx: i32, keyIx: i32, fnIx: i32) {
  if emitMapPrep(body, recvIx, keyIx, fnIx) < 0 { return -1 }
  // if entry == 0 { 0 } else { tombstone ; size-- ; maybe-compact ; 1 }
  pushMapScr(body, 5) // entry
  fbIf(127)           // if (entry != 0), 0x7f i32 blocktype
  // live[entry-1] = 0  (tombstone; keeps the entry's insertion-order position)
  pushMapLive(body)
  pushMapScr(body, 5)  // entry
  fbI32Const(1)
  fbI32Bin(107)        // i32.sub (entry - 1)
  fbI32Const(0)
  fbArraySet(aTypeIdx) // array.set live[entry-1] = 0
  // size = size - 1
  pushMapRef(body)          // mapRef
  pushMapSize(body)
  fbI32Const(1)
  fbI32Bin(107)             // i32.sub
  fbStructSet(cmMapTy(), 5) // struct.set field 5: size
  // Amortized compaction: if (count - size) > (size + INITIAL_CAP) { compact }.
  pushMapCount(body)
  pushMapSize(body)
  fbI32Bin(107) // i32.sub (count - size)
  pushMapSize(body)
  fbI32Const(8) // INITIAL_CAP
  fbI32Bin(106) // i32.add (size + INITIAL_CAP)
  fbI32Bin(75)  // 0x4b i32.gt_u ((count-size) > (size+INITIAL_CAP))
  fbIf(64)      // if, void
  if emitMapCompact(body) < 0 { return -1 }
  fbEnd()       // end (compact if)
  // result = 1 (a key was removed)
  fbI32Const(1)
  fbElse() // else
  // result = 0 (absent)
  fbI32Const(0)
  fbEnd() // end (entry if)
  0
}

// Emit a map SET's VALUE expr in the map's value REP — the scalar (f64/i64/f32)
// coercion, union boxing, list-kind / ref-list-slot / struct-index hints, and the
// atom-id context an overwrite or append needs. ONE evaluation, shared by both
// arms of `emitMapSetV` (which stashes the result before the probe). Leaves the
// value on the stack; `cmSlot` may be clobbered by inner map ops — callers re-pin.
function emitMapSetValExpr(
  body: i32[],
  valIx: i32,
  fnIx: i32,
  mslot: i32,
  atomVal: boolean,
  nulBoolVal: boolean,
) {
  const svk = mvScalarValKind(mslot)
  if svk != null {
    // A SCALAR-valued map (f64/i64): emit the value coerced to the element rep.
    return emitScalarValue(body, valIx, fnIx, svk)
  }
  if mslot >= 0 && mvValKind[mslot] == 2 {
    // A UNION-valued map: box the stored value into the shared union box (a concrete
    // VARIANT value boxes via `emitUnionBoxArg`, like a call arg / return).
    return emitUnionBoxArg(body, mvValName[mslot], valIx, fnIx)
  }
  // Seed a non-i32 scalar-LIST value's inner list kind (as the `?? default` read
  // does) so a stored `m[k] = [1,2,3]` builds the i64/f64/string list wrapper, not
  // the default i32-list that would mismatch the typed element slot.
  const svCtx = expCtxHere()
  const lvk = mvListValKind(mslot)
  if lvk == "strlist" {
    svCtx.listKind = 3
  } else if lvk == "f64list" {
    svCtx.listKind = 4
  } else if lvk == "i64list" {
    svCtx.listKind = 6
  } else if lvk == "f32list" {
    svCtx.listKind = 7
  } else if mslot >= 0 {
    // A REF-list value (`S[]` / `(C|D)[]` / a nested `S[][]` / a closure list): seed the value's
    // ref-list slot so the value literal builds as that list — its inner elements recurse
    // through the literal build. Mirrors the array-binding ref-list seed.
    // Destringify D-ISTY: the GUARD is the slot the body already resolves, not a second
    // `nameIsRefArray` reading of the stored value name — the reflist NAMEABILITY that
    // predicate adds over a shape test IS this slot's existence (#1116), so the pair was
    // always one question, and resolving it ONCE is strictly less work than the name
    // guard plus the body's own lookup. A value type that is not an array at all
    // declines inside `mvValInnerRlSlot` without parsing anything.
    const rlv = mvValInnerRlSlot(mslot)
    if rlv >= 0 {
      svCtx.listKind = 5
      svCtx.listSlot = rlv
    }
  }
  // An atom-valued mono map's member-literal value lowers as its interned atom id; a
  // NULLABLE-atom value (`{[string]: K | null}`) stores a bare `null` as the `-1` sentinel.
  if atomVal {
    const vnul = P.nodes[unwrapParen(valIx)]
    if vnul is NullLit {
      fbI32Const(0 - 1)
      return 0
    }
    svCtx.litUnion = 1
  }
  // A `boolean | null`-valued MONO map (i32 niche) stores a bare `null` as the `2` sentinel —
  // the store-side dual of the read's `nodeTyMapValIsNulBool` coalesce (sentinel 2). A non-null
  // boolean value (true/false) falls through and emits as a plain i32.
  if nulBoolVal {
    const vnb = P.nodes[unwrapParen(valIx)]
    if vnb is NullLit {
      fbI32Const(2)
      return 0
    }
  }
  // A NULLABLE-value slot (`{[string]: S | null}` / `{[string]: map | null}`) stores a bare
  // `null` as `ref.null <elem>` — the vals element carries it directly and the fused read
  // preserves it. A non-null value ignores the seed.
  if mvSlotNullable(mslot) { svCtx.nulRefHeap = mvValElemHeapOf(mslot) }
  // A STRUCT-valued map (`{[string]: {f:…}}`): force the value struct's OWN index so the
  // literal `{f:…}` builds the map's declared value struct, not a field-name-set twin.
  // Without this a program with two same-field-name-set inline struct map values (`{f:f32}`
  // and `{f:{[string]:i64}}`) resolves the store literal via `structIndexOfObj` to whichever
  // struct interned FIRST — a wrong-layout `struct.new` (invalid wasm). `emitObj` consumes it.
  if mslot >= 0 && mvValKind[mslot] == 1 {
    svCtx.structIdx = mvValStructIdx[mslot]
  }
  // A NESTED-MAP value (`{[K]: {[K2]: V}}`): seed the shape the inner `Map()` builds, so
  // it `struct.new`s the map struct THIS slot's vals element is typed to. Unseeded it
  // built the ambient mono string-keyed struct, which was silently right only while the
  // inner map was itself string-keyed AND mono — the store half of the same defect the
  // let / return / global boundaries were each taught separately. The seed goes into the
  // CONTEXT, not the global: `emitExprExpect` writes the whole context over the pending
  // seeds, so a global written after `expCtxHere()` is overwritten by the snapshot.
  if mvValIsMap(mslot) { svCtx.mapSlot = mvInnerMapShape(mslot) }
  emitExprExpect(body, valIx, fnIx, svCtx)
}

// `local.set` / `local.get` of the SET value stash: the mv slot's typed valStash,
// or the mono frame's dedicated `valSet` slot 14. Slot 14 is RESERVED for this —
// no probe / push / grow / resize machinery touches it, so the stashed value
// survives everything between its write (right after the value expr) and the
// overwrite/append store. (Slot 3 — the pushVal stash — is also the probe slot,
// so it cannot hold a value ACROSS the probe.)
function setMapSetValStash(body: i32[], mslot: i32) {
  if mslot >= 0 {
    fbLocalSet(fnMvValStashLocal(mslot))
    return 0
  }
  setMapScr(body, 14)
  0
}
function pushMapSetValStash(body: i32[], mslot: i32) {
  if mslot >= 0 {
    fbLocalGet(fnMvValStashLocal(mslot))
    return 0
  }
  pushMapScr(body, 14)
  0
}

// Lower a map SET `m[k] = v` onto `body`: probe; on a HIT (`entry != 0`) overwrite
// `vals.backing[entry-1] = v`, else APPEND a new entry — link the index slot, push the
// key + value onto the ordered entry lists, bump `count`/`size`, and resize the index
// if the load factor crossed 1/2. The append reuses the inline list-grow push over the
// keys (string-ref) and vals (i32) lists. Run from `emitAssign` (a statement).
//
// EVALUATION ORDER (B-bug-maprmw): receiver, key, VALUE — all BEFORE the probe and before
// ANY of them lands in a scratch local (recv + key ride the operand stack via
// `emitMapRecvKey`; the value is stashed in a slot no map machinery reuses). That is what
// makes the fused read-modify-write `m[k] = (m[k] ?? 0) + 1` sound on a MISSING key: the
// RHS's probe of the same key runs against the UNTOUCHED map. Evaluating the value inside
// the append arm AFTER `index[slot] = count+1` + the key push instead made the RHS's probe
// HIT a half-inserted entry and read `vals.backing[count]` — out of bounds, or a silent
// default-0 once the backing had grown. Stack/stash-riding also fixes the CLOBBER family: a
// same-shaped map op nested in the key or value expr probes through the SAME shared scratch
// frame, so a receiver/key parked in `mapRef`/`keyRef` across user code came back wrong
// (`b[a["x"] ?? "d"]` probed `a`; `m[k] = (n[x] ?? 0) + 1` appended into `n`). A value-expr
// call that mutates the map now completes before the probe, so the write lands post-mutation.
//
// Ordering matters: `index[slot] = count+1` is written BEFORE the two pushes, because
// `emitMapPushKey`/`emitMapPushVal` clobber the probe slot (slot 3) and cap (slot 4).
// `m[k] = v` / `m.set(k, v)`. The Set form `s.add(k)` reuses this exact lowering with
// `valConst1 = true`: the stored value is the constant boolean `1` (true) instead of an
// evaluated value expression (and `valIx` is ignored).
function emitMapSetV(
  body: i32[],
  recvIx: i32,
  keyIx: i32,
  valIx: i32,
  fnIx: i32,
  valConst1: boolean,
) {
  // An ATOM-valued map (`{[string]: K}`, `K` a literal union) rides the MONO map: each
  // value is the interned atom id (a plain i32). Its member-literal value is a StrLit
  // syntactically — it must BYPASS the mono string guard below and emit in atom context
  // (`pendingLitUnion`), so resolve the receiver's value type up front.
  let atomVal = nodeTyMapValIsLitUnion(recvIx)
  if nodeTyMapValIsNulLitUnion(recvIx) { atomVal = true }
  // A `boolean | null`-valued map is the MONO i32 niche too — a bare `null` store lowers as the
  // `2` sentinel (the store-side dual of the read's `nodeTyMapValIsNulBool` coalesce).
  const nulBoolVal = nodeTyMapValIsNulBool(recvIx)
  // A MONO (i32/boolean-valued) map cannot store a REF value (a string / struct /
  // list ref into an i32 array is invalid wasm) — fail loudly. A ref-valued map
  // (mv slot) stores string/struct values through its own typed vals list. (A
  // constant-true Set value is always a valid i32 boolean.) The shape is resolved
  // here only for the GATE; `emitMapRecvKey` re-resolves it into the op context.
  if valConst1 == false && !atomVal {
    if mapShapeOfExpr(recvIx, fnIx) < 0 {
      if (
        exprString(valIx, fnIx) ||
        exprStruct(valIx, fnIx) ||
        exprArray(valIx, fnIx) ||
        exprRefArray(valIx, fnIx) ||
        exprStringArray(valIx, fnIx)
      ) {
        return emitFail("emitProgram: map values must be i32 / boolean")
      }
    }
  }
  // Receiver + key onto the operand stack; `cmSlot` pinned to the shape.
  if emitMapRecvKey(body, recvIx, keyIx, fnIx) < 0 { return -1 }
  const mslot = cmSlot
  // VALUE next — evaluated ONCE, while the map is still untouched and recv/key are
  // still stack-parked — then stashed. Only probe/store machinery runs after this.
  if valConst1 {
    fbI32Const(1) // Set value: constant boolean true
  } else {
    if emitMapSetValExpr(body, valIx, fnIx, mslot, atomVal, nulBoolVal) < 0 {
      return -1
    }
  }
  if setMapSetValStash(body, mslot) < 0 { return -1 }
  cmSlot = mslot           // re-pin: inner map ops in the value expr clobber it
  fbLocalSet(cmKeyLocal()) // the target key (popped off the stack)
  setMapRef(body)          // mapRef
  emitMapProbe(body, true)
  pushMapScr(body, 5)      // entry
  fbIf(64)                 // if (entry != 0 → overwrite), void
  // OVERWRITE: vals.backing[entry-1] = stash
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 0) // struct.get (vals backing), field 0: backing
  pushMapScr(body, 5)          // entry
  fbI32Const(1)
  fbI32Bin(107)                // i32.sub (entry - 1)
  pushMapSetValStash(body, mslot)
  fbArraySet(cmValsBack())     // array.set
  fbElse()                     // else
  // APPEND. index[slot] = count + 1  (the new entry's position + 1).
  pushMapIndex(body)
  pushMapScr(body, 3)  // slot
  pushMapCount(body)
  fbI32Const(1)
  fbI32Bin(106)        // i32.add (count + 1)
  fbArraySet(aTypeIdx) // array.set
  // keys.push(keyRef) ; vals.push(stash)  (clobbers slots 3/4 — already linked above).
  if emitMapPushKey(body) < 0 { return -1 }
  if emitMapPushVal(body) < 0 { return -1 }
  // count = count + 1
  pushMapRef(body)          // mapRef (struct.set receiver)
  pushMapCount(body)
  fbI32Const(1)
  fbI32Bin(106)             // i32.add
  fbStructSet(cmMapTy(), 4) // struct.set field 4: count
  // size = size + 1
  pushMapRef(body)          // mapRef
  pushMapSize(body)
  fbI32Const(1)
  fbI32Bin(106)             // i32.add
  fbStructSet(cmMapTy(), 5) // struct.set field 5: size
  if emitMapResize(body) < 0 { return -1 }
  fbEnd()                   // end (if)
  0
}

// Thin wrapper preserving the original arity: the non-constant-value map set. The
// `s.add(k)` Set form calls `emitMapSetV` with `valConst1 = true`.
function emitMapSet(
  body: i32[],
  recvIx: i32,
  keyIx: i32,
  valIx: i32,
  fnIx: i32,
) {
  emitMapSetV(body, recvIx, keyIx, valIx, fnIx, false)
}

// Inline list-grow append of the scratch `keyRef` (slot 1) onto `M.keys` (the
// string-ref list). The keys list backing is `(array (mut (ref null $aTypeIdx)))`,
// so grow uses `array.new_default`/`array.copy` over `$mkArrIdx`, and the value
// written is the (non-null) key string ref — reusing the map scratch frame's spare
// i32 slots (4 = newCap, 3 = char cursor is free here) and a fresh backing local.
// To keep it self-contained, the new backing is built/stored via `M.keys.backing`
// directly (no extra ref local): grow path mirrors `emitPush`.
function emitMapPushKey(body: i32[]) {
  // if keys.len == keys.cap { grow }
  pushMapKeysLen(body)
  pushMapKeysCap(body)
  fbI32Bin(70) // i32.eq
  fbIf(64)     // if, void
  // newCap = cap == 0 ? 4 : cap*2   (slot 4)
  pushMapKeysCap(body)
  fbI32Eqz()         // i32.eqz
  fbIf(127)          // if, i32 blocktype
  fbI32Const(4)
  fbElse()           // else
  pushMapKeysCap(body)
  fbI32Const(2)
  fbI32Bin(108)      // i32.mul
  fbEnd()            // end
  setMapScr(body, 4) // newCap
  // keys.backing = copy of old into a fresh array.new_default(newCap), keys.cap=newCap
  // newBacking on stack: array.new_default <keysBacking> newCap
  pushMapScr(body, 4) // newCap
  fbArrayNewDefault(cmKeysBack())
  // newBacking needs a TYPED ref local (slot 6, `newKeysBacking`): the copy must run
  // BEFORE the swap (swapping first loses the old elements), and `array.copy` CONSUMES
  // its dest operand, so the stack alone cannot supply it twice. `curRef` cannot hold it
  // either — that slot is a `(ref $aTypeIdx)` string ref, the wrong type.
  setMapScrKB(body) // newKeysBacking (slot 6)
  // array.copy newBacking 0 oldBacking 0 len
  pushMapScrKB(body)                      // dest
  fbI32Const(0)
  pushMapKeysBacking(body)                // src (old)
  fbI32Const(0)
  pushMapKeysLen(body)                    // count
  fbArrayCopy(cmKeysBack(), cmKeysBack()) // array.copy (dest type, src type)
  // keys.backing = newBacking
  pushMapKeys(body)
  pushMapScrKB(body)
  fbStructSet(cmKeysWrap(), 0) // struct.set field 0: backing
  // keys.cap = newCap
  pushMapKeys(body)
  pushMapScr(body, 4)
  fbStructSet(cmKeysWrap(), 2) // struct.set field 2: cap
  // live grows in LOCKSTEP with the keys backing (entry-parallel): allocate a fresh
  // `(ref $aTypeIdx)` of newCap (slot 12), copy the live region `[0, keys.len)` over,
  // and store it back into M.live (field 2). `keys.len` is still the pre-append count
  // here. Mirrors the host's grow of its entry-parallel arrays.
  pushMapScr(body, 4)             // newCap
  fbArrayNewDefault(aTypeIdx)
  setMapScrLB(body)               // newLiveBacking (slot 12)
  pushMapScrLB(body)              // dest
  fbI32Const(0)
  pushMapLive(body)               // src (old live)
  fbI32Const(0)
  pushMapKeysLen(body)            // count (entries copied)
  fbArrayCopy(aTypeIdx, aTypeIdx) // array.copy (dest type, src type)
  pushMapRef(body)                // mapRef
  pushMapScrLB(body)
  fbStructSet(cmMapTy(), 2)       // struct.set field 2: live
  // hashes grows in LOCKSTEP too (entry-parallel): fresh `(ref $aTypeIdx)` of newCap
  // (slot 13), copy `[0, keys.len)` over, store back into M.hashes (field 6). Mirrors
  // the host's grow of its entry-parallel `hashes` array.
  pushMapScr(body, 4)             // newCap
  fbArrayNewDefault(aTypeIdx)
  setMapScrHB(body)               // newHashBacking (slot 13)
  pushMapScrHB(body)              // dest
  fbI32Const(0)
  pushMapHashes(body)             // src (old hashes)
  fbI32Const(0)
  pushMapKeysLen(body)            // count (entries copied)
  fbArrayCopy(aTypeIdx, aTypeIdx) // array.copy (dest type, src type)
  pushMapRef(body)                // mapRef
  pushMapScrHB(body)
  fbStructSet(cmMapTy(), 6)       // struct.set field 6: hashes
  fbEnd()                         // end (grow if)
  // live[keys.len] = 1  (the new entry is live).
  pushMapLive(body)
  pushMapKeysLen(body) // entry index (== count, pre-append)
  fbI32Const(1)
  fbArraySet(aTypeIdx) // array.set
  // hashes[keys.len] = hash(keyRef)  — cache the key's FNV hash parallel to the entry
  // so resize/compact re-place it without re-hashing (mirrors the host's `mapSetFn`
  // append, which stores `m.call(hash, [key()])`). `pushMapProbedHash` leaves the masked
  // hash on the stack, reusing the probe's own for a string key.
  pushMapHashes(body)
  pushMapKeysLen(body) // entry index (== count, pre-append)
  pushMapProbedHash(body)
  fbArraySet(aTypeIdx) // array.set
  // keys.backing[keys.len] = key
  pushMapKeysBacking(body)
  pushMapKeysLen(body)
  fbLocalGet(cmKeyLocal())
  fbArraySet(cmKeysBack()) // array.set
  // keys.len = keys.len + 1
  pushMapKeys(body)
  pushMapKeysLen(body)
  fbI32Const(1)
  fbI32Bin(106)                // i32.add
  fbStructSet(cmKeysWrap(), 1) // struct.set field 1: len
  0
}

// Append the STASHED set value onto `M.vals` (inline list-grow push). The value was
// evaluated + stashed by `emitMapSetV` BEFORE the probe (see there) — this only
// grows the vals list and stores the stash, so no user code runs inside the append.
function emitMapPushVal(body: i32[]) {
  const mslot = cmSlot
  // if vals.len == vals.cap { grow }
  pushMapValsLen(body)
  pushMapValsCap(body)
  fbI32Bin(70) // i32.eq
  fbIf(64)     // if, void
  // newCap (slot 4)
  pushMapValsCap(body)
  fbI32Eqz()    // i32.eqz
  fbIf(127)     // if, i32 blocktype
  fbI32Const(4)
  fbElse()      // else
  pushMapValsCap(body)
  fbI32Const(2)
  fbI32Bin(108) // i32.mul
  fbEnd()       // end
  setMapScr(body, 4)
  // newBacking = array.new_default <valsBack> newCap → the valsBk scratch
  pushMapScr(body, 4)
  fbArrayNewDefault(cmValsBack())
  setMapScrVB(body) // newValsBacking
  // array.copy newBacking 0 oldBacking 0 len
  pushMapScrVB(body)
  fbI32Const(0)
  pushMapValsBacking(body)
  fbI32Const(0)
  pushMapValsLen(body)
  fbArrayCopy(cmValsBack(), cmValsBack()) // array.copy (dest type, src type)
  // vals.backing = newBacking
  pushMapVals(body)
  pushMapScrVB(body)
  fbStructSet(cmValsWrap(), 0) // struct.set field 0: backing
  // vals.cap = newCap
  pushMapVals(body)
  pushMapScr(body, 4)
  fbStructSet(cmValsWrap(), 2) // struct.set field 2: cap
  fbEnd()                      // end (grow if)
  // vals.backing[vals.len] = the stashed value
  pushMapValsBacking(body)
  pushMapValsLen(body)
  pushMapSetValStash(body, mslot)
  fbArraySet(cmValsBack()) // array.set
  // vals.len = vals.len + 1
  pushMapVals(body)
  pushMapValsLen(body)
  fbI32Const(1)
  fbI32Bin(106)                // i32.add
  fbStructSet(cmValsWrap(), 1) // struct.set field 1: len
  0
}

// `M.keys.len` / `.cap` / `.backing` field reads (struct.get $mkListIdx 1/2/0).
function pushMapKeysLen(body: i32[]) {
  pushMapKeys(body)
  fbStructGet(cmKeysWrap(), 1)
  0
}
function pushMapKeysCap(body: i32[]) {
  pushMapKeys(body)
  fbStructGet(cmKeysWrap(), 2)
  0
}
function pushMapKeysBacking(body: i32[]) {
  pushMapKeys(body)
  fbStructGet(cmKeysWrap(), 0)
  0
}
// `M.vals.len` / `.cap` / `.backing` field reads (struct.get <valsWrap> 1/2/0 —
// the i32 list wrapper for the mono map, this mv slot's ref-list wrapper else).
function pushMapValsLen(body: i32[]) {
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 1)
  0
}
function pushMapValsCap(body: i32[]) {
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 2)
  0
}
function pushMapValsBacking(body: i32[]) {
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 0)
  0
}

// The two ref scratch locals beyond the 6-slot core frame: a non-null keys backing
// ref (slot 6) and a non-null vals backing ref (slot 7), used by the two grows.
function setMapScrKB(_body: i32[]) {
  fbLocalSet(cmKeysBkLocal())
  0
}
function pushMapScrKB(_body: i32[]) {
  fbLocalGet(cmKeysBkLocal())
  0
}
function setMapScrVB(_body: i32[]) {
  fbLocalSet(cmValsBkLocal())
  0
}
function pushMapScrVB(_body: i32[]) {
  fbLocalGet(cmValsBkLocal())
  0
}
// The grown `live` backing ref (slot 12, a non-null `(ref $aTypeIdx)` i32 array),
// used by the keys grow to reallocate `live` in lockstep with the keys backing.
function setMapScrLB(_body: i32[]) {
  fbLocalSet(mapScratchBase + 12)
  0
}
function pushMapScrLB(_body: i32[]) {
  fbLocalGet(mapScratchBase + 12)
  0
}
// The grown `hashes` backing ref (slot 13, a non-null `(ref $aTypeIdx)` i32 array),
// used by the keys grow to reallocate `hashes` in lockstep with the keys backing, and
// by `compact` as the rebuilt hashes backing.
function setMapScrHB(_body: i32[]) {
  fbLocalSet(mapScratchBase + 13)
  0
}
function pushMapScrHB(_body: i32[]) {
  fbLocalGet(mapScratchBase + 13)
  0
}

// Begin a CHUNKED long-literal build: allocate the full `n`-element backing
// (`array.new_default $backTy`) into a FRESH backing-typed slot of the lazy
// list frame (fresh per literal, so a nested chunked literal inside an element
// expression cannot clobber this one), then open the first chunk by staging
// the copy destination + offset under the coming element values. Returns the
// destination slot.
function arrLitChunkStart(kind: MfKind, rslot: i32, backTy: i32, n: i32) {
  liKinds.push(kind)
  liSlots.push(rslot)
  liBack.push(1)
  const dst = listIdxScratchBase + liKinds.length
  fbI32Const(n)
  fbArrayNewDefault(backTy) // 0xfb 0x07 <typeidx>
  fbLocalSet(dst)
  fbLocalGet(dst)           // the open chunk's copy destination …
  fbI32Const(0)             // … and destination offset
  dst
}

// Chunk boundary check after element `i` of `n` was pushed (`coff` = the open
// chunk's first element). At `NEW_FIXED_MAX` elements or the literal's end,
// close the chunk — `array.new_fixed` the pushed elements, `array.copy` them
// into the destination — and open the next one (destination + offset) when
// elements remain. Returns the new open-chunk start.
function arrLitChunkFlush(dst: i32, backTy: i32, coff: i32, i: i32, n: i32) {
  if i - coff < NEW_FIXED_MAX && i < n { return coff }
  fbArrayNewFixed(backTy, i - coff) // the chunk source array
  fbI32Const(0)                     // source offset
  fbI32Const(i - coff)              // element count
  fbArrayCopy(backTy, backTy)       // 0xfb 0x11 — consumes [dst, off, src, 0, k]
  if i < n {
    fbLocalGet(dst)
    fbI32Const(i)
  }
  i
}

// Lower the `len`-bounds guard of a list `xs[i]` read/write. On entry the stack
// holds [wrapper, index] — both FULLY evaluated (a nested index op inside either
// expression has already come and gone through this same frame). Stages both,
// then leaves [backing, safeIndex] where safeIndex is `i` when `i u< len` (one
// unsigned compare covers negative + past-len) and `-1` otherwise — an index the
// backing can never satisfy, so the following `array.get`/`array.set` traps AT
// ITS OWN instruction, exactly like a beyond-`cap` access always has. Without
// the guard, reads in the `len <= i < cap` slack (`.push` grows `cap` past
// `len`) return the backing's zero-init silently.
function emitListIdxGuard(wrapSlot: i32, lTy: i32) {
  fbLocalSet(listIdxScratchBase) // 0x21 local.set — stash the index
  fbLocalSet(wrapSlot)           // 0x21 local.set — stash the wrapper ref
  fbLocalGet(wrapSlot)
  fbStructGet(lTy, 0)            // field 0: backing
  fbLocalGet(listIdxScratchBase)
  fbI32Const(-1)                 // the out-of-range replacement index
  fbLocalGet(listIdxScratchBase)
  fbLocalGet(wrapSlot)
  fbStructGet(lTy, 1)            // field 1: len
  fbI32Bin(73)                   // 0x49 i32.lt_u
  wU8(27)                        // 0x1b select → i if in-bounds else -1
  0
}

// The HOISTED twin of `emitListIdxGuard`, for an access whose receiver is a
// binding with a live cached header. On entry the stack holds ONLY the index —
// the receiver was never emitted, because the backing ref and `len` are already
// in locals — and it leaves the same [backing, safeIndex] pair, with the same
// `-1`-on-out-of-range meaning, that the general form leaves. The bounds check
// is NOT weakened: it compares against the same `len` field, read once before
// the loop instead of once per access.
function emitListIdxGuardHoisted(row: i32) {
  fbLocalSet(listIdxScratchBase) // 0x21 local.set — stash the index
  fbLocalGet(lhBack[row])        // the cached backing (was `struct.get` field 0)
  fbLocalGet(listIdxScratchBase)
  fbI32Const(-1)                 // the out-of-range replacement index
  fbLocalGet(listIdxScratchBase)
  fbLocalGet(lhLen[row])         // the cached len (was `struct.get` field 1)
  fbI32Bin(73)                   // 0x49 i32.lt_u
  wU8(27)                        // 0x1b select → i if in-bounds else -1
  0
}

// The live hoist row for an index receiver, or -1. THREE conditions, all
// required: the receiver is a bare identifier (the prologue re-read exactly
// that binding — a `Member`/`Call` receiver names no binding to cache), the row
// is live (an enclosing loop opened it and has not closed it), and the row's
// rep matches the arm asking. The rep check is the backstop that makes a
// classifier disagreement between the prologue and the access DECLINE rather
// than read a wrongly-typed local: the prologue cached whatever rep it resolved,
// and an arm that resolved a different one falls through to the general guard.
function liveHoistRow(exprIx: i32, kind: MfKind, slot: i32) {
  if exprIx < 0 { return 0 - 1 }
  const e = P.nodes[exprIx]
  if e is Ident {
    let k = 0
    while k < lhName.length {
      if (
        lhLive[k] > 0 &&
        lhName[k] == e.identName &&
        lhKind[k] == kind &&
        lhSlot[k] == slot
      ) {
        return k
      }
      k = k + 1
    }
  }
  0 - 1
}

// Find (or mint) the hoist row for `name` at list rep (`kind`, `slot`). Minting
// takes two slots of the lazy list frame — the backing ref (`liBack` 3, typed as
// this kind's backing array) and the i32 `len` (`liBack` 4).
function listHoistRow(name: string, kind: MfKind, slot: i32) {
  let k = 0
  while k < lhName.length {
    if lhName[k] == name && lhKind[k] == kind && lhSlot[k] == slot { return k }
    k = k + 1
  }
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(3)
  const bSlot = listIdxScratchBase + liKinds.length
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(4)
  const lSlot = listIdxScratchBase + liKinds.length
  lhName.push(name)
  lhKind.push(kind)
  lhSlot.push(slot)
  lhBack.push(bSlot)
  lhLen.push(lSlot)
  lhLive.push(0)
  lhName.length - 1
}

// The indexed-STORE value stash slot for list kind `kind` (`slot` = the
// ref-list table slot for kind "ref", else 0) — a `liBack == 2` entry of the
// same lazy list frame `listIdxWrapSlot` grows, typed as the element VALUE
// (i32 / i64 / f64 / f32, the nullable string ref, or the slot's nullable
// element ref). The stored value parks here across `emitListIdxGuard` so the
// backing + len resolve AFTER the value's user code ran; no user code runs
// between the stash write and the `array.set`, so sharing the slot per
// (kind, slot) is clobber-safe.
function listIdxValSlot(kind: MfKind, slot: i32) {
  let k = 0
  while k < liKinds.length {
    if liKinds[k] == kind && liSlots[k] == slot && liBack[k] == 2 {
      return listIdxScratchBase + 1 + k
    }
    k = k + 1
  }
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(2)
  listIdxScratchBase + liKinds.length
}

// LIST-HEADER HOISTING — the soundness condition, and the whole of it.
//
// Across a loop body that cannot REALLOCATE a list, that list's backing-array
// ref and `len` are loop-invariant, so they are read once into locals before the
// loop and every access inside reads the locals instead of re-walking the
// wrapper with two `struct.get`s. wasmtime re-loads both on every element access
// and cannot hoist them itself — the ref SSA value differs each iteration, and
// no optimiser will move a `struct.get` past an `array.set` it cannot prove
// non-aliasing.
//
// ACCEPTED, in a body built only from literals, identifiers, parentheses, unary
// and binary operators (assignment included), `o.f` reads, `x[i]` reads and
// stores, `is`/`as`, and `if`/`while`/`for`/`return`/`break`/`continue`/`let`
// over the same: `xs[i]` reads and `xs[i] = v` stores at any nesting depth, on a
// binding declared OUTSIDE the loop, at any of the four scalar list reps, a ref
// list, or a string list. An indexed STORE is accepted because `array.set`
// changes neither the backing's identity nor `len`.
//
// DECLINED, each for a reason that would otherwise be a miscompile:
//   - ANY call. `xs.push(v)` reallocates the backing and leaves a cached ref
//     pointing at the ABANDONED array — a silently lost write — and any call at
//     all can reach the list through a parameter, a capture or a global and push
//     it there. Banning every call is what turns "cannot reallocate" into a
//     local, syntactic question instead of an interprocedural one. This is also
//     what declines `spectralnorm`'s inner loop, whose only offence is a call to
//     a pure leaf function; recovering that case needs a callee summary and is
//     deliberately not attempted here.
//   - A `let`/`const` or loop variable REBINDING the spelling inside the body,
//     or an assignment `xs = …`: either makes the body's `xs` a different
//     wrapper than the one the prologue read.
//   - A nullable receiver (`xs: i32[] | null`, narrowed). The prologue would
//     have to recover non-null BEFORE the loop, moving a trap to a point the
//     source does not guard.
//   - Every shape not enumerated — lambdas, `match`, `o?.f`, list and object
//     literals, nested declarations. This walk is a WHITELIST whose fall-through
//     is DECLINE, so a construct added to the language later cannot silently
//     license a stale header.
function hoistSafeExpr(ix: i32): boolean {
  if ix < 0 { return true }
  const e = P.nodes[ix]
  if e is NumLit { return true }
  if e is StrLit { return true }
  if e is CharLit { return true }
  if e is BoolLit { return true }
  if e is NullLit { return true }
  if e is Ident { return true }
  if e is Unary { return hoistSafeExpr(e.unArg) }
  if e is Paren { return hoistSafeExpr(e.parInner) }
  if e is IsExpr { return hoistSafeExpr(e.isObj) }
  if e is AsExpr { return hoistSafeExpr(e.asObj) }
  if e is Member { return hoistSafeExpr(e.memObj) }
  if e is Index {
    if !hoistSafeExpr(e.idxArr) { return false }
    return hoistSafeExpr(e.idxIndex)
  }
  if e is BinExpr {
    if !hoistSafeExpr(e.binLeft) { return false }
    return hoistSafeExpr(e.binRight)
  }
  false
}

// The statement half of the whitelist. The fall-through hands an unrecognised
// statement to the EXPRESSION walk (a bare expression statement is how an
// assignment and a call both appear), which declines anything it does not know.
function hoistSafeStmt(ix: i32): boolean {
  if ix < 0 { return true }
  const s = P.nodes[ix]
  if s is LetDecl { return hoistSafeExpr(s.letInit) }
  if s is RetStmt { return hoistSafeExpr(s.retArg) }
  if s is BreakStmt { return true }
  if s is ContinueStmt { return true }
  if s is Block { return hoistSafeBlock(ix) }
  if s is IfStmt {
    if !hoistSafeExpr(s.ifCond) { return false }
    if !hoistSafeStmt(s.ifThen) { return false }
    return hoistSafeStmt(s.ifElse)
  }
  if s is WhileStmt {
    if !hoistSafeExpr(s.whileCond) { return false }
    return hoistSafeStmt(s.whileBody)
  }
  if s is ForRange {
    if !hoistSafeExpr(s.frFrom) { return false }
    if !hoistSafeExpr(s.frTo) { return false }
    if !hoistSafeExpr(s.frStep) { return false }
    return hoistSafeStmt(s.frBody)
  }
  if s is ForIn {
    if !hoistSafeExpr(s.fiIter) { return false }
    return hoistSafeStmt(s.fiBody)
  }
  hoistSafeExpr(ix)
}

function hoistSafeBlock(ix: i32): boolean {
  if ix < 0 { return false }
  const b = P.nodes[ix]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      if !hoistSafeStmt(stmts[i]) { return false }
      i = i + 1
    }
    return true
  }
  false
}

// True when `name` is REBOUND anywhere in the expression at `ix` — only an
// `name = …` assignment can do that in an expression. Runs over an already
// whitelisted body, so the enumeration matches `hoistSafeExpr`'s exactly.
function exprReboundsName(ix: i32, name: string): boolean {
  if ix < 0 { return false }
  const e = P.nodes[ix]
  if e is BinExpr {
    if e.binOp == "=" {
      const lhs = P.nodes[e.binLeft]
      if lhs is Ident {
        if lhs.identName == name { return true }
      }
    }
    if exprReboundsName(e.binLeft, name) { return true }
    return exprReboundsName(e.binRight, name)
  }
  if e is Unary { return exprReboundsName(e.unArg, name) }
  if e is Paren { return exprReboundsName(e.parInner, name) }
  if e is IsExpr { return exprReboundsName(e.isObj, name) }
  if e is AsExpr { return exprReboundsName(e.asObj, name) }
  if e is Member { return exprReboundsName(e.memObj, name) }
  if e is Index {
    if exprReboundsName(e.idxArr, name) { return true }
    return exprReboundsName(e.idxIndex, name)
  }
  false
}

// True when `name` is REBOUND anywhere in the statement at `ix`: a `let`/`const`
// that shadows it, a loop variable that takes the spelling, or an assignment to
// it. Any of the three means the body's `name` is not the wrapper the prologue
// cached.
function stmtReboundsName(ix: i32, name: string): boolean {
  if ix < 0 { return false }
  const s = P.nodes[ix]
  if s is LetDecl {
    if s.letName == name { return true }
    return exprReboundsName(s.letInit, name)
  }
  if s is RetStmt { return exprReboundsName(s.retArg, name) }
  if s is BreakStmt { return false }
  if s is ContinueStmt { return false }
  if s is Block { return blockReboundsName(ix, name) }
  if s is IfStmt {
    if exprReboundsName(s.ifCond, name) { return true }
    if stmtReboundsName(s.ifThen, name) { return true }
    return stmtReboundsName(s.ifElse, name)
  }
  if s is WhileStmt {
    if exprReboundsName(s.whileCond, name) { return true }
    return stmtReboundsName(s.whileBody, name)
  }
  if s is ForRange {
    if s.frVar == name { return true }
    if exprReboundsName(s.frFrom, name) { return true }
    if exprReboundsName(s.frTo, name) { return true }
    if exprReboundsName(s.frStep, name) { return true }
    return stmtReboundsName(s.frBody, name)
  }
  if s is ForIn {
    if s.fiVar == name { return true }
    if exprReboundsName(s.fiIter, name) { return true }
    return stmtReboundsName(s.fiBody, name)
  }
  exprReboundsName(ix, name)
}

function blockReboundsName(ix: i32, name: string): boolean {
  if ix < 0 { return false }
  const b = P.nodes[ix]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      if stmtReboundsName(stmts[i], name) { return true }
      i = i + 1
    }
  }
  false
}

// Record one index RECEIVER identifier and the `Index` node it was seen on. The
// representative node is what the rep classifiers are asked about later, so the
// first sighting is kept — every later sighting of the same spelling in this
// body names the same binding (the caller has already established the body does
// not rebind it).
function hoistScanAdd(name: string, idxIx: i32) {
  let i = 0
  while i < lhScanName.length {
    if lhScanName[i] == name { return 0 }
    i = i + 1
  }
  lhScanName.push(name)
  lhScanRep.push(idxIx)
  0
}

function hoistScanExpr(ix: i32) {
  if ix < 0 { return 0 }
  const e = P.nodes[ix]
  if e is Index {
    const recv = P.nodes[e.idxArr]
    if recv is Ident { hoistScanAdd(recv.identName, ix) }
    hoistScanExpr(e.idxArr)
    hoistScanExpr(e.idxIndex)
    return 0
  }
  if e is Unary { return hoistScanExpr(e.unArg) }
  if e is Paren { return hoistScanExpr(e.parInner) }
  if e is IsExpr { return hoistScanExpr(e.isObj) }
  if e is AsExpr { return hoistScanExpr(e.asObj) }
  if e is Member { return hoistScanExpr(e.memObj) }
  if e is BinExpr {
    hoistScanExpr(e.binLeft)
    return hoistScanExpr(e.binRight)
  }
  0
}

function hoistScanStmt(ix: i32) {
  if ix < 0 { return 0 }
  const s = P.nodes[ix]
  if s is LetDecl { return hoistScanExpr(s.letInit) }
  if s is RetStmt { return hoistScanExpr(s.retArg) }
  if s is Block { return hoistScanBlock(ix) }
  if s is IfStmt {
    hoistScanExpr(s.ifCond)
    hoistScanStmt(s.ifThen)
    return hoistScanStmt(s.ifElse)
  }
  if s is WhileStmt {
    hoistScanExpr(s.whileCond)
    return hoistScanStmt(s.whileBody)
  }
  if s is ForRange {
    hoistScanExpr(s.frFrom)
    hoistScanExpr(s.frTo)
    hoistScanExpr(s.frStep)
    return hoistScanStmt(s.frBody)
  }
  if s is ForIn {
    hoistScanExpr(s.fiIter)
    return hoistScanStmt(s.fiBody)
  }
  hoistScanExpr(ix)
}

function hoistScanBlock(ix: i32) {
  if ix < 0 { return 0 }
  const b = P.nodes[ix]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      hoistScanStmt(stmts[i])
      i = i + 1
    }
  }
  0
}

// Resolve the list rep of an index receiver into a hoist row, or -1 when this
// receiver is not one of the reps the guard hoists. The cascade is `emitIndex`'s
// own, in `emitIndex`'s order, so a row is only ever minted for a rep whose
// access path the hoisted guard can actually serve — and the nullable arms,
// checked FIRST exactly as they are there, decline.
function hoistRowOfRecv(recvIx: i32, name: string, fnIx: i32) {
  if exprNulScalarListKind(recvIx, fnIx) != null { return 0 - 1 }
  // The SHARED-backing nullable lists (`i32[] | null`, `boolean[] | null`) decline
  // here too. `exprNulScalarListKind` above only names the four leaves that own a
  // wrapper heap type, so these reached `scalarListElemKind` below as if they were
  // plain `i32[]` — and the prologue then read the header ABOVE the guard that
  // proves the wrapper present. In a loop CONDITION that is also a short-circuit
  // violation: `while e != null && e[0] >= 0` hoisted `struct.get $lTypeIdx 0/1`
  // out of the loop and in front of the `ref.is_null`, trapping on a null `e`.
  if exprNullableList(recvIx, fnIx) { return 0 - 1 }
  if exprRefArray(recvIx, fnIx) {
    if exprNullableRefArray(recvIx, fnIx) { return 0 - 1 }
    if !raUsed { return 0 - 1 }
    return listHoistRow(name, "ref", refListSlotOfExpr(recvIx, fnIx))
  }
  if exprNulStrArray(recvIx, fnIx) || exprStringArray(recvIx, fnIx) {
    if !slUsed { return 0 - 1 }
    return listHoistRow(name, "str", 0)
  }
  const ek = scalarListElemKind(recvIx, fnIx)
  if ek != null {
    if !scalarListUsed(ek) { return 0 - 1 }
    return listHoistRow(name, listIdxKindOf(ek), 0)
  }
  0 - 1
}

// The wrapper struct type index a row's header is read out of — the mirror of
// `hoistRowOfRecv`'s rep decision, and the type the prologue's two `struct.get`s
// carry.
function hoistWrapTyOfRow(row: i32) {
  const k = lhKind[row]
  if k == "ref" { return rlWrapIdx[lhSlot[row]] }
  if k == "str" { return mkListIdx }
  if k == "f64" { return scalarListWrap("f64") }
  if k == "i64" { return scalarListWrap("i64") }
  if k == "f32" { return scalarListWrap("f32") }
  scalarListWrap("i32")
}

// Open the hoists for one loop: scan its body, and for every index receiver that
// survives the soundness conditions read its header into the row's two locals.
// Returns the number of rows this loop activated (its own `loopHoistClose`
// argument), or -1 if the prologue failed to lower.
//
// A row already live from an ENCLOSING loop is skipped rather than re-read: the
// outer body being hoist-safe makes every nested statement hoist-safe too, so
// the outer cache is still valid and re-reading it inside would cost exactly
// what the inner hoist saves.
// `condIx` is the loop's per-iteration CONDITION (-1 when the loop form has
// none). It is held to the same standard as the body and scanned with it: a
// `while f() { … }` re-runs `f` on every iteration, so a condition that can
// reallocate defeats the hoist exactly as a body that can would.
//
// `ownVar` is the loop's own variable, which the body sees as a fresh binding —
// never a candidate.
function loopHoistOpen(
  body: i32[],
  condIx: i32,
  bodyIx: i32,
  fnIx: i32,
  ownVar: string,
) {
  if !hoistSafeExpr(condIx) { return 0 }
  if !hoistSafeBlock(bodyIx) { return 0 }
  lhScanName = []
  lhScanRep = []
  hoistScanExpr(condIx)
  hoistScanBlock(bodyIx)
  let opened = 0
  let i = 0
  while i < lhScanName.length {
    const nm = lhScanName[i]
    let ok = nm != ownVar
    if ok && exprReboundsName(condIx, nm) { ok = false }
    if ok && blockReboundsName(bodyIx, nm) { ok = false }
    if ok {
      const rep = P.nodes[lhScanRep[i]]
      if rep is Index {
        const row = hoistRowOfRecv(rep.idxArr, nm, fnIx)
        if row >= 0 && lhLive[row] == 0 {
          const wrapTy = hoistWrapTyOfRow(row)
          const savedHF32 = pendingF32
          pendingF32 = false
          if emitExpr(body, rep.idxArr, fnIx) < 0 { return 0 - 1 }
          fbStructGet(wrapTy, 0) // field 0: backing
          fbLocalSet(lhBack[row])
          if emitExpr(body, rep.idxArr, fnIx) < 0 { return 0 - 1 }
          fbStructGet(wrapTy, 1) // field 1: len
          fbLocalSet(lhLen[row])
          pendingF32 = savedHF32
          lhLive[row] = 1
          lhOpen.push(row)
          opened = opened + 1
        }
      }
    }
    i = i + 1
  }
  opened
}

// Close the `n` rows this loop opened, innermost first.
function loopHoistClose(n: i32) {
  let i = 0
  while i < n {
    const row = lhOpen[lhOpen.length - 1]
    lhOpen.pop()
    lhLive[row] = 0
    i = i + 1
  }
  0
}

function emitIndex(body: i32[], idxIx: i32, fnIx: i32) {
  const nd = P.nodes[idxIx]
  if nd is Index {
    // A DISTINCT-backing nullable scalar list `t[i]` (narrowed inside `if t != null`): the slot is
    // `(ref null $wrapper)`, so recover non-null (the guard proved it present) then read as the leaf
    // list. Checked FIRST — the plain classifiers below do not see through the `| null`.
    const nsk = exprNulScalarListKind(nd.idxArr, fnIx)
    if nsk != null {
      if emitExpr(body, nd.idxArr, fnIx) < 0 { return -1 }
      wU8(212) // 0xd4 ref.as_non_null (the `!= null` guard makes this safe)
      const savedNslF32 = pendingF32
      pendingF32 = false
      if emitExpr(body, nd.idxIndex, fnIx) < 0 { return -1 }
      pendingF32 = savedNslF32
      if nsk == "nulstrlist" {
        emitListIdxGuard(listIdxWrapSlot("str", 0), mkListIdx)
        fbArrayGet(mkArrIdx) // 0xfb 0x0b string backing
        // A NULLABLE-element inner list (`(string | null)[] | null`, narrowed): the
        // element legitimately holds null — the read STAYS `(ref null $aTypeIdx)` (a
        // `nulstr` the caller narrows with `!= null`). The unconditional recover was
        // written for `string[] | null` (elements never null) and TRAPPED on a null
        // element (fuzz-nightly plain leg, seed 154928295 d6). `exprNulStrArray`
        // resolves the element discipline from the annotation (param / binding /
        // rebind chain, outer `| null` peeled).
        if exprNulStrArray(nd.idxArr, fnIx) { return 0 }
        wU8(212) // 0xd4 ref.as_non_null (non-null string element)
        return 0
      }
      let nek: VKind = "f64"
      if nsk == "nuli64list" { nek = "i64" }
      if nsk == "nulf32list" { nek = "f32" }
      emitListIdxGuard(
        listIdxWrapSlot(listIdxKindOf(nek), 0),
        scalarListWrap(nek),
      )
      fbArrayGet(scalarListBack(nek)) // yields the element in its rep
      return 0
    }
    // A REF list `xs[i]` → unwrap to its `(ref null $elem)` backing, `array.get`, then
    // `ref.as_non_null` (`0xd4`) to surface the non-null element (a struct ref / union
    // box) — slots in `[0,len)` are always populated, so the cast never traps. (Checked
    // BEFORE the `aUsed` guard: a pure ref-list program uses no i32 array.)
    if exprRefArray(nd.idxArr, fnIx) {
      if !raUsed {
        return emitFail(
          "emitProgram: ref index access but ref array type not collected",
        )
      }
      const rslot = refListSlotOfExpr(nd.idxArr, fnIx)
      // A live hoist row serves this access's header from locals, so the
      // RECEIVER is not emitted at all — the prologue before the loop read it
      // once. Only the index goes on the stack.
      const rlHz = liveHoistRow(nd.idxArr, "ref", rslot)
      if rlHz < 0 {
        if emitExpr(body, nd.idxArr, fnIx) < 0 { return -1 }
        // A NULLABLE ref-array receiver (`t: i32[][] | null`, kind 18, narrowed) reads `(ref null …)` —
        // recover non-null before `struct.get` (the `if t != null` guard makes this safe).
        if exprNullableRefArray(nd.idxArr, fnIx) {
          wU8(212) // 0xd4 ref.as_non_null
        }
      }
      // THE INDEX IS ALWAYS i32 — every index arm here clears `pendingF32` around it, else
      // a bare index literal emits as `f32.const`. It bites on an INNER read `g[i][j]` over
      // an `f32[][]`: the outer f32 read leaves `pendingF32` set while it emits this
      // receiver, so the inner `[j]` inherits a context that was never its own.
      const savedRlIxF32 = pendingF32
      pendingF32 = false
      if emitExpr(body, nd.idxIndex, fnIx) < 0 { return -1 }
      pendingF32 = savedRlIxF32
      // Guard `i u< len`, unwrap to the backing (`struct.get` field 0), read.
      if rlHz >= 0 {
        emitListIdxGuardHoisted(rlHz)
      } else {
        emitListIdxGuard(listIdxWrapSlot("ref", rslot), rlWrapIdx[rslot])
      }
      fbArrayGet(rlBackIdx[rslot]) // 0xfb 0x0b <this slot's ref backing array>
      // A NULLABLE-NICHE element legitimately holds null, so the read STAYS `(ref null $elem)` — no
      // `ref.as_non_null` recover (the bound `e` is the niche the caller narrows with `e != null`).
      // `listElemStaysNullable` is the shared answer: the `.map`/`.filter` element step asks it too,
      // and a rep answered in only one of the two is a recover that traps in the other.
      if listElemStaysNullable(nd.idxArr, fnIx) { return 0 }
      wU8(212) // 0xd4 ref.as_non_null (recover the non-null element)
      return 0
    }
    // A `(string | null)[]` `xs[i]` → the SAME string backing, but the element legitimately holds
    // `null` (it is a `(ref null $aTypeIdx)`), so the read STAYS nullable — NO `ref.as_non_null`. The
    // bound value is a `nulstr` the caller narrows with `!= null` (`nodeTyIsNulString` classifies it).
    // Checked BEFORE `exprStringArray` (whose non-null recovery would trap on a null element).
    if exprNulStrArray(nd.idxArr, fnIx) {
      if !slUsed {
        return emitFail(
          "emitProgram: string index access but string list type not collected",
        )
      }
      const nsHz = liveHoistRow(nd.idxArr, "str", 0)
      if nsHz < 0 {
        if emitExpr(body, nd.idxArr, fnIx) < 0 { return -1 }
      }
      if emitExpr(body, nd.idxIndex, fnIx) < 0 { return -1 }
      if nsHz >= 0 {
        emitListIdxGuardHoisted(nsHz)
      } else {
        emitListIdxGuard(listIdxWrapSlot("str", 0), mkListIdx)
      }
      fbArrayGet(mkArrIdx) // 0xfb 0x0b <string backing> — kept `(ref null $aTypeIdx)` (nullable)
      return 0
    }
    // A STRING list `xs[i]` → unwrap to its `(ref null $aTypeIdx)` string backing,
    // `array.get $mkArrIdx`, then `ref.as_non_null` to surface the non-null string ref.
    // (Checked before the i32 path: a string element is not an i32.)
    if exprStringArray(nd.idxArr, fnIx) {
      if !slUsed {
        return emitFail(
          "emitProgram: string index access but string list type not collected",
        )
      }
      const slHz = liveHoistRow(nd.idxArr, "str", 0)
      if slHz < 0 {
        if emitExpr(body, nd.idxArr, fnIx) < 0 { return -1 }
      }
      if emitExpr(body, nd.idxIndex, fnIx) < 0 { return -1 }
      // Guard `i u< len`, unwrap to the backing (`struct.get` field 0), read.
      if slHz >= 0 {
        emitListIdxGuardHoisted(slHz)
      } else {
        emitListIdxGuard(listIdxWrapSlot("str", 0), mkListIdx)
      }
      fbArrayGet(mkArrIdx) // 0xfb 0x0b <string backing array type index>
      wU8(212)             // 0xd4 ref.as_non_null (recover the non-null string)
      return 0
    }
    // A SCALAR list `xs[i]` → unwrap to its backing, `array.get <back>` — yielding the
    // element in its valtype rep (i32 / f64 / i64). One descriptor path over all scalar
    // element kinds (f64/i64 checked before i32 since their elements are not i32).
    const ek = scalarListElemKind(nd.idxArr, fnIx)
    if ek != null {
      if !scalarListUsed(ek) {
        return emitFail("emitProgram: index access but list type not collected")
      }
      const skHz = liveHoistRow(nd.idxArr, listIdxKindOf(ek), 0)
      if skHz < 0 {
        if emitExpr(body, nd.idxArr, fnIx) < 0 { return -1 }
      }
      // The index is always i32 (see the ref-array arm above).
      const savedIxF32 = pendingF32
      pendingF32 = false
      if emitExpr(body, nd.idxIndex, fnIx) < 0 { return -1 }
      pendingF32 = savedIxF32
      // Guard `i u< len`, unwrap to the backing (`struct.get` field 0), read.
      if skHz >= 0 {
        emitListIdxGuardHoisted(skHz)
      } else {
        emitListIdxGuard(
          listIdxWrapSlot(listIdxKindOf(ek), 0),
          scalarListWrap(ek),
        )
      }
      fbArrayGet(scalarListBack(ek)) // yields the element in its rep
      return 0
    }
    if !aUsed {
      return emitFail("emitProgram: index access but array type not collected")
    }
    if !exprString(nd.idxArr, fnIx) {
      return emitFail("emitProgram: index receiver is not an array or string")
    }
    // A raw string `s[i]` — the `(array i32)` of code points, indexed directly (no unwrap).
    if emitExpr(body, nd.idxArr, fnIx) < 0 { return -1 }
    if emitExpr(body, nd.idxIndex, fnIx) < 0 { return -1 }
    fbArrayGet(aTypeIdx) // 0xfb 0x0b <raw array type index>
    return 0
  }
  emitFail("emitProgram: expected an index access")
}

// Lower a `.length` onto `body`. A list's length is its wrapper's `len` field (NOT the
// backing's physical length, which is `cap`); a string's length is the raw array's
// physical length:
//   list `a.length`   → eval `a`, `struct.get $lTypeIdx 1` (the `len` field) — i32.
//   string `s.length` → eval `s`, `array.len` (`0xfb 0x0f`, NO type-index operand,
//                        unlike `array.get`/`array.set`) — the code-point count.
function emitArrLen(body: i32[], memIx: i32, fnIx: i32) {
  const m = P.nodes[memIx]
  if m is Member {
    // A REF list's `.length` is its wrapper's `len` field (`struct.get $wrap 1`).
    if exprRefArray(m.memObj, fnIx) {
      const rslot = refListSlotOfExpr(m.memObj, fnIx)
      if emitExpr(body, m.memObj, fnIx) < 0 { return -1 }
      fbStructGet(rlWrapIdx[rslot], 1) // 0xfb 0x02 <ref-list wrapper> field 1: len
      return 0
    }
    // A STRING list's `.length` is its wrapper's `len` field (`struct.get $mkListIdx 1`).
    if exprStringArray(m.memObj, fnIx) {
      if emitExpr(body, m.memObj, fnIx) < 0 { return -1 }
      fbStructGet(mkListIdx, 1) // 0xfb 0x02 <string-list wrapper> field 1: len
      return 0
    }
    // A SCALAR list's `.length` is its wrapper's `len` field (`struct.get <wrap> 1`) — an
    // i32, the same shape for every element kind over that kind's wrapper. (f64/i64 before
    // i32 since their elements are not i32.)
    const lek = scalarListElemKind(m.memObj, fnIx)
    if lek != null && (lek == "f64" || lek == "i64" || lek == "f32") {
      if emitExpr(body, m.memObj, fnIx) < 0 { return -1 }
      fbStructGet(scalarListWrap(lek), 1) // field 1: len
      return 0
    }
    const isList = exprArray(m.memObj, fnIx)
    if emitExpr(body, m.memObj, fnIx) < 0 { return -1 }
    if isList {
      fbStructGet(lTypeIdx, 1) // 0xfb 0x02 <list wrapper struct type index> field 1: len
      return 0
    }
    fbArrayLen() // 0xfb 0x0f array.len (no type-index operand)
    return 0
  }
  emitFail("emitProgram: expected a length access")
}

// ── G6: string concatenation / value-equality / slice ────────────────────────
// Strings are WasmGC `(array (mut i32))` of code points, so all three lower to the
// same array machinery the list `.push` uses (`array.new_default`/`array.copy`/
// `array.get`/`array.len`), INLINE — no helper functions. Each routine evaluates
// BOTH operands onto the stack FIRST, then stashes them into the shared string
// scratch frame (`strScratchBase`+0/+1/+2 = string refs A/B/Out; +3/+4/+5/+6 = i32
// temps) — so a NESTED string op (an operand that is itself a `+`/`==`/`.slice`)
// fully completes and leaves its result on the stack BEFORE any scratch `local.set`,
// and the single frame is safe to share. Mirrors `toWasm.ts`'s string `+`/`==`/
// `__string_slice__` shapes, just without the named helper functions.

// `local.get` of string scratch local `n` (0=A, 1=B, 2=Out).
function pushStrScrRef(_body: i32[], n: i32) {
  fbLocalGet(strScratchBase + n) // 0x20 local.get
  0
}

// `local.get` of i32 scratch temp `n` (0..3 → frame slots +3..+6).
function pushStrScrI(_body: i32[], n: i32) {
  fbLocalGet(strScratchBase + 3 + n) // 0x20 local.get
  0
}

// `local.set` of i32 scratch temp `n`.
function setStrScrI(_body: i32[], n: i32) {
  fbLocalSet(strScratchBase + 3 + n) // 0x21 local.set
  0
}

// Lower `toString(x)` onto `body`, leaving a fresh string ref on the stack. An i32
// renders its decimal digits (a negative value gets a leading '-'); a BOOLEAN-
// classified argument renders the literal text "true" / "false". Uses the string-op
// scratch frame (Out = the built string; I0 = remaining value, I1 = sign flag,
// I2 = digit count, I3 = count copy, then the write cursor) — `exprHasStrOp`
// reserves the frame for any `toString(..)` call. The argument is evaluated FULLY
// before the first scratch write (nested-op-safe, like every string op).
function emitToString(body: i32[], callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    if c.callArgs.length != 1 {
      return emitFail("emitProgram: toString takes exactly one argument")
    }
    if !aUsed {
      return emitFail("emitProgram: toString but array type not collected")
    }
    const argIx = c.callArgs[0]
    if exprIsBool(argIx, fnIx) {
      // Typed `select`: build BOTH literal strings, then pick by the condition.
      // (An if/else that `local.set`s a NON-defaultable ref local does not count
      // as initialization past the `end`, so the branchless select is the valid
      // shape — and both allocations are tiny constants.)
      fbI32Const(116) // 't'
      fbI32Const(114) // 'r'
      fbI32Const(117) // 'u'
      fbI32Const(101) // 'e'
      fbArrayNewFixed(aTypeIdx, 4)
      fbI32Const(102) // 'f'
      fbI32Const(97)  // 'a'
      fbI32Const(108) // 'l'
      fbI32Const(115) // 's'
      fbI32Const(101) // 'e'
      fbArrayNewFixed(aTypeIdx, 5)
      if emitExpr(body, argIx, fnIx) < 0 { return -1 }
      wU8(28)         // 0x1c select_t
      wU8(1)          // one valtype
      wU8(100)        // 0x64 (ref ht) — non-null string ref
      wSLEB(aTypeIdx)
      return 0
    }
    // The value rides in NEGATIVE space (a positive x negates to -x) so i32 MIN
    // needs no overflowing flip; digits come from the negative remainder.
    // I0 = x; I1 = (x < 0)
    if emitExpr(body, argIx, fnIx) < 0 { return -1 }
    setStrScrI(body, 0)
    pushStrScrI(body, 0)
    fbI32Const(0)
    fbI32Bin(72) // 0x48 i32.lt_s
    setStrScrI(body, 1)
    // if I0 > 0 { I0 = 0 - I0 }  — now I0 <= 0
    pushStrScrI(body, 0)
    fbI32Const(0)
    fbI32Bin(74)  // 0x4a i32.gt_s
    fbIf(64)
    fbI32Const(0)
    pushStrScrI(body, 0)
    fbI32Bin(107) // 0x6b i32.sub
    setStrScrI(body, 0)
    fbEnd()
    // digit count: I3 = I0; I2 = 1; while I3 <= -10 { I3 = I3 / 10; I2 = I2 + 1 }
    pushStrScrI(body, 0)
    setStrScrI(body, 3)
    fbI32Const(1)
    setStrScrI(body, 2)
    fbBlock(64)   // 0x02 block, void
    fbLoop(64)    // 0x03 loop, void
    pushStrScrI(body, 3)
    fbI32Const(-10)
    fbI32Bin(74)  // i32.gt_s — exit when I3 > -10
    fbBrIf(1)
    pushStrScrI(body, 3)
    fbI32Const(10)
    fbI32Bin(109) // 0x6d i32.div_s (truncates toward zero)
    setStrScrI(body, 3)
    pushStrScrI(body, 2)
    fbI32Const(1)
    fbI32Bin(106) // 0x6a i32.add
    setStrScrI(body, 2)
    fbBr(0)
    fbEnd()       // end loop
    fbEnd()       // end block
    // Out = array.new_default (len = I2 + I1)
    pushStrScrI(body, 2)
    pushStrScrI(body, 1)
    fbI32Bin(106) // i32.add
    fbArrayNewDefault(aTypeIdx)
    fbLocalSet(strScratchBase + 2)
    // if I1 { Out[0] = '-' }
    pushStrScrI(body, 1)
    fbIf(64)
    pushStrScrRef(body, 2)
    fbI32Const(0)
    fbI32Const(45) // '-'
    fbArraySet(aTypeIdx)
    fbEnd()
    // write cursor I3 = I1 + I2 - 1 (the last index)
    pushStrScrI(body, 1)
    pushStrScrI(body, 2)
    fbI32Bin(106) // i32.add
    fbI32Const(1)
    fbI32Bin(107) // i32.sub
    setStrScrI(body, 3)
    // do { Out[I3] = 48 - (I0 % 10); I0 = I0 / 10; I3 = I3 - 1 } while I0 != 0
    // (a do-while so the value 0 still writes its single '0' digit; the remainder
    // of the negative-space value is <= 0, so SUBTRACTING it yields the digit)
    fbBlock(64)
    fbLoop(64)
    pushStrScrRef(body, 2)
    pushStrScrI(body, 3)
    fbI32Const(48)         // '0'
    pushStrScrI(body, 0)
    fbI32Const(10)
    fbI32Bin(111)          // 0x6f i32.rem_s (negative for a negative I0)
    fbI32Bin(107)          // 0x6b i32.sub — 48 - (-d) = 48 + d
    fbArraySet(aTypeIdx)
    pushStrScrI(body, 0)
    fbI32Const(10)
    fbI32Bin(109)          // i32.div_s
    setStrScrI(body, 0)
    pushStrScrI(body, 3)
    fbI32Const(1)
    fbI32Bin(107)          // i32.sub
    setStrScrI(body, 3)
    pushStrScrI(body, 0)
    fbI32Eqz()             // 0x45 — exit when I0 == 0
    fbBrIf(1)
    fbBr(0)
    fbEnd()                // end loop
    fbEnd()                // end block
    pushStrScrRef(body, 2) // the built string
    return 0
  }
  emitFail("emitProgram: expected a toString call")
}

// Lower a string concatenation `a + b` onto `body`, leaving the new string ref on
// the stack. Allocate a fresh `(array i32)` of `len(a)+len(b)` (`array.new_default`,
// which zero-inits — every slot is then overwritten), `array.copy` a's code points
// into `[0,lenA)` and b's into `[lenA, lenA+lenB)`. Both operands are evaluated
// first, then stashed (nested-op-safe). `array.copy` is `0xfb 0x11 <dest> <src>`.
function emitStrConcat(body: i32[], binIx: i32, fnIx: i32) {
  if !aUsed {
    return emitFail("emitProgram: string concat but array type not collected")
  }
  const e = P.nodes[binIx]
  if e is BinExpr {
    // Eval BOTH operands onto the stack (nested string ops complete here) and call
    // the shared `__str_concat__` helper — the allocate+copy core lives once per
    // module (`emitStrConcatFnCode`). A literal-union atom operand widens to its
    // member string (`emitStrValue`) before the call.
    if emitStrValue(body, e.binLeft, fnIx) < 0 { return -1 }
    if emitStrValue(body, e.binRight, fnIx) < 0 { return -1 }
    fbCall(gHelpStrConcat)
    return 0
  }
  emitFail("emitProgram: expected a string concatenation")
}

// Lower a string VALUE-equality `a == b` (or `a != b`) onto `body`, leaving a 0/1
// i32 on the stack. This is ELEMENT-WISE, NOT ref identity: `false` if the lengths
// differ, else loop `i in [0,len)` comparing `a[i] == b[i]`; all-equal → 1. `!=`
// negates the result with `i32.eqz`. Lowered as a value-typed `block`/`loop`:
//   block i32 {                 ; yields the 0/1 result
//     A=..; B=..                 ; stash operands (nested-op-safe)
//     I0 = len(A)
//     if I0 != len(B) { (i32.const 0) br 0 }   ; length mismatch → 0
//     I1 = 0                                     ; loop index
//     loop {                                     ; void loop
//       if I1 >= I0 { }            ; fall through past loop when done
//       else {
//         if A[I1] != B[I1] { (i32.const 0) br 1 }   ; mismatch → 0, exit block
//         I1 = I1 + 1
//         br <loop>
//       }
//     }
//     (i32.const 1)               ; every element matched
//   }
function emitStrEq(body: i32[], binIx: i32, fnIx: i32) {
  if !aUsed {
    return emitFail("emitProgram: string equality but array type not collected")
  }
  const e = P.nodes[binIx]
  if e is BinExpr {
    const isNe = e.binOp == "!="
    // Eval both operands, then stash (B on top → set B first). A literal-union ATOM operand
    // widens to its member string first (`emitStrValue`) — the same boundary handling
    // `emitStrConcat` one function up already applies, and the reason `s == k` with `s:
    // string` and `k: K` is a string compare rather than the atom `i32.eq` (see
    // `eqAtomOperandOk`). The widen stages the id in the string-op scratch frame, which this
    // compare's own `exprIsStrEq` already reserves through `exprHasStrOp`.
    if emitStrValue(body, e.binLeft, fnIx) < 0 { return -1 }
    if emitEqRecoverNarrowed(e.binLeft, fnIx) < 0 { return -1 }
    if emitStrValue(body, e.binRight, fnIx) < 0 { return -1 }
    if emitEqRecoverNarrowed(e.binRight, fnIx) < 0 { return -1 }
    if emitEqNonNullCore(body, binIx, fnIx) < 0 { return -1 }
    if isNe {
      fbI32Eqz() // 0x45 i32.eqz  (`!=` negates value-equality)
    }
    return 0
  }
  emitFail("emitProgram: expected a string equality")
}

// Lower a string ORDERING comparison (`<`/`>`/`<=`/`>=`) onto `body`, leaving a 0/1.
// Built on ONE primitive — `emitStrLessCore`, "first operand lexicographically < second":
//   A <  B  ≡  less(A, B)
//   A >  B  ≡  less(B, A)             (swap)
//   A <= B  ≡  !less(B, A)            (swap + negate)
//   A >= B  ≡  !less(A, B)            (negate)
// The core sets B (stack top) then A (below), so the lower operand is its first arg.
function emitStrOrder(body: i32[], binIx: i32, fnIx: i32) {
  if !aUsed {
    return emitFail("emitProgram: string ordering but array type not collected")
  }
  const e = P.nodes[binIx]
  if e is BinExpr {
    const op = e.binOp
    let swap = false
    let neg = false
    if op == ">" {
      swap = true
    } else if op == "<=" {
      swap = true
      neg = true
    } else if op == ">=" {
      neg = true
    } else if op != "<" {
      return emitFail("emitProgram: expected a string ordering operator")
    }
    // Push the core's first arg (lower on stack) then its second arg.
    if swap {
      if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
      if emitExpr(body, e.binLeft, fnIx) < 0 { return -1 }
    } else {
      if emitExpr(body, e.binLeft, fnIx) < 0 { return -1 }
      if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
    }
    if emitStrLessCore(body) < 0 { return -1 }
    if neg {
      fbI32Eqz() // 0x45 i32.eqz — `<=`/`>=` negate the strict-less result
    }
    return 0
  }
  emitFail("emitProgram: expected a string ordering")
}

// The string strict-LESS core: expects the two string refs already ON THE STACK (first
// below second), leaves 1 iff the first is lexicographically less than the second, else
// 0. Compares code points (unsigned) up to the shorter length; on the first mismatch the
// result is `a[i] < b[i]`; if one is a prefix of the other the shorter is less. Mirrors
// `emitStrEqCore`'s frame/block/loop/br structure. Frame: refs A(0)/B(1); i32 temps
// lenA(0)/lenB(1)/n(2)/i(3).
function emitStrLessCore(body: i32[]) {
  fbLocalSet(strScratchBase + 1) // B (stack top)
  fbLocalSet(strScratchBase + 0) // A
  fbBlock(127)                   // 0x02 block, 0x7f i32 blocktype → the 0/1 result
  // lenA = len(A) ; lenB = len(B)
  pushStrScrRef(body, 0)
  fbArrayLen()
  setStrScrI(body, 0) // lenA
  pushStrScrRef(body, 1)
  fbArrayLen()
  setStrScrI(body, 1) // lenB
  // n = min(lenA, lenB):  n = lenA ; if lenB < lenA { n = lenB }
  pushStrScrI(body, 0)
  setStrScrI(body, 2)
  pushStrScrI(body, 1)
  pushStrScrI(body, 0)
  fbI32Bin(73)        // 0x49 i32.lt_u (lenB < lenA)
  fbIf(64)            // 0x04 if, void
  pushStrScrI(body, 1)
  setStrScrI(body, 2) // n = lenB
  fbEnd()
  // i = 0
  fbI32Const(0)
  setStrScrI(body, 3)
  // loop { if i >= n {} else { compare; i++; br } }
  fbLoop(64)           // 0x03 loop, void
  pushStrScrI(body, 3) // i
  pushStrScrI(body, 2) // n
  fbI32Bin(78)         // 0x4e i32.ge_s (i >= n → common prefix done)
  fbIf(64)             // then: fall through (empty)
  fbElse()
  // if A[i] != B[i] { push (A[i] <_u B[i]) ; br out of block }
  pushStrScrRef(body, 0)
  pushStrScrI(body, 3)
  fbArrayGet(aTypeIdx) // A[i]
  pushStrScrRef(body, 1)
  pushStrScrI(body, 3)
  fbArrayGet(aTypeIdx) // B[i]
  fbI32Bin(71)         // 0x47 i32.ne
  fbIf(64)
  pushStrScrRef(body, 0)
  pushStrScrI(body, 3)
  fbArrayGet(aTypeIdx) // A[i]
  pushStrScrRef(body, 1)
  pushStrScrI(body, 3)
  fbArrayGet(aTypeIdx) // B[i]
  fbI32Bin(73)         // 0x49 i32.lt_u (A[i] < B[i] → the answer at the first diff)
  fbBr(3)              // 0x0c br depth 3 → out of: if(0)·else(1)·loop(2)·block(3)
  fbEnd()              // end (mismatch if)
  // i = i + 1
  pushStrScrI(body, 3)
  fbI32Const(1)
  fbI32Bin(106) // 0x6a i32.add
  setStrScrI(body, 3)
  fbBr(1)       // 0x0c br depth 1 → loop header (else=0, loop=1)
  fbEnd()       // end (ge_s if/else)
  fbEnd()       // end (loop)
  // Common prefix equal → the shorter string is less:  lenA < lenB.
  pushStrScrI(body, 0)
  pushStrScrI(body, 1)
  fbI32Bin(73) // 0x49 i32.lt_u (lenA < lenB)
  fbEnd()      // end (block) — leaves the 0/1 result
  0
}

// The string value-equality CORE: expects the two string refs already ON THE
// STACK (left below right), leaves the 0/1 result. Shared by `emitStrEq` and the
// struct-equality field compare (which pushes field chains as operands). A single
// `call` — the element loop lives in the shared `__str_eq__` helper, emitted once
// per module (`emitStrEqFnCode`).
function emitStrEqCore(_body: i32[]) {
  fbCall(gHelpStrEq)
  0
}

// ── list value-equality + concat cores (collections-design §VL.4/§VL.6) ───────
// Each core expects its two list WRAPPER refs already ON THE STACK (left below
// right) and leaves a 0/1 (equality) or the new wrapper (concat). The loop
// structure mirrors `emitStrEqCore` exactly (same block/loop/br depths); only
// the length source (the wrapper's `len` field, NOT `array.len` — the backing
// has spare capacity) and the element compare differ per kind.

// i32-list `==`: length + element compare over the LEQI frame.
function emitListEqICore(_body: i32[]) {
  const bA = leqIScratchBase
  fbLocalSet(bA + 1)       // B
  fbLocalSet(bA + 0)       // A
  fbBlock(127)             // block i32
  fbLocalGet(bA + 0)
  fbStructGet(lTypeIdx, 1) // lenA
  fbLocalSet(bA + 3)       // n = lenA
  fbLocalGet(bA + 3)
  fbLocalGet(bA + 1)
  fbStructGet(lTypeIdx, 1) // lenB
  fbI32Bin(71)             // i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(1)
  fbEnd()
  fbI32Const(0)
  fbLocalSet(bA + 4)       // i = 0
  fbLoop(64)
  fbLocalGet(bA + 4)
  fbLocalGet(bA + 3)
  fbI32Bin(78)             // i >= n → done
  fbIf(64)
  fbElse()
  fbLocalGet(bA + 0)
  fbStructGet(lTypeIdx, 0) // backing A
  fbLocalGet(bA + 4)
  fbArrayGet(aTypeIdx)
  fbLocalGet(bA + 1)
  fbStructGet(lTypeIdx, 0) // backing B
  fbLocalGet(bA + 4)
  fbArrayGet(aTypeIdx)
  fbI32Bin(71)             // element i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(3)                  // mismatch → 0, exit block
  fbEnd()
  fbLocalGet(bA + 4)
  fbI32Const(1)
  fbI32Bin(106)            // i + 1
  fbLocalSet(bA + 4)
  fbBr(1)                  // back to loop
  fbEnd()                  // end (ge_s if/else)
  fbEnd()                  // end (loop)
  fbI32Const(1)
  fbEnd()                  // end (block)
  0
}

// String-list `==`: outer loop over the LEQS frame; each element pair rides
// `emitStrEqCore` (the string-op frame — disjoint locals, safe to nest).
function emitListEqSCore(body: i32[]) {
  const bA = leqSScratchBase
  fbLocalSet(bA + 1)        // B
  fbLocalSet(bA + 0)        // A
  fbBlock(127)              // block i32
  fbLocalGet(bA + 0)
  fbStructGet(mkListIdx, 1) // lenA
  fbLocalSet(bA + 2)        // n
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 1)
  fbStructGet(mkListIdx, 1)
  fbI32Bin(71)              // i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(1)
  fbEnd()
  fbI32Const(0)
  fbLocalSet(bA + 3)        // i = 0
  fbLoop(64)
  fbLocalGet(bA + 3)
  fbLocalGet(bA + 2)
  fbI32Bin(78)
  fbIf(64)
  fbElse()
  // push elem A, elem B (non-null string refs), compare via the string core
  fbLocalGet(bA + 0)
  fbStructGet(mkListIdx, 0)
  fbLocalGet(bA + 3)
  fbArrayGet(mkArrIdx)
  fbRefAsNonNull()
  fbLocalGet(bA + 1)
  fbStructGet(mkListIdx, 0)
  fbLocalGet(bA + 3)
  fbArrayGet(mkArrIdx)
  fbRefAsNonNull()
  if emitStrEqCore(body) < 0 { return -1 }
  fbI32Eqz() // 1 = mismatch
  fbIf(64)
  fbI32Const(0)
  fbBr(3)
  fbEnd()
  fbLocalGet(bA + 3)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(bA + 3)
  fbBr(1)
  fbEnd()
  fbEnd()
  fbI32Const(1)
  fbEnd()
  0
}

// `i32[][]` `==`: outer loop over the slot's LEQR frame; each element pair (two
// inner i32-list wrappers) recurses through `emitListEqICore` (disjoint frame).
function emitListEqRCore(body: i32[], slot: i32, base: i32) {
  fbLocalSet(base + 1) // B
  fbLocalSet(base + 0) // A
  fbBlock(127)         // block i32
  fbLocalGet(base + 0)
  fbStructGet(rlWrapIdx[slot], 1)
  fbLocalSet(base + 2) // n
  fbLocalGet(base + 2)
  fbLocalGet(base + 1)
  fbStructGet(rlWrapIdx[slot], 1)
  fbI32Bin(71)
  fbIf(64)
  fbI32Const(0)
  fbBr(1)
  fbEnd()
  fbI32Const(0)
  fbLocalSet(base + 3) // i = 0
  fbLoop(64)
  fbLocalGet(base + 3)
  fbLocalGet(base + 2)
  fbI32Bin(78)
  fbIf(64)
  fbElse()
  fbLocalGet(base + 0)
  fbStructGet(rlWrapIdx[slot], 0)
  fbLocalGet(base + 3)
  fbArrayGet(rlBackIdx[slot])
  fbRefAsNonNull()
  fbLocalGet(base + 1)
  fbStructGet(rlWrapIdx[slot], 0)
  fbLocalGet(base + 3)
  fbArrayGet(rlBackIdx[slot])
  fbRefAsNonNull()
  if emitListEqICore(body) < 0 { return -1 }
  fbI32Eqz()
  fbIf(64)
  fbI32Const(0)
  fbBr(3)
  fbEnd()
  fbLocalGet(base + 3)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(base + 3)
  fbBr(1)
  fbEnd()
  fbEnd()
  fbI32Const(1)
  fbEnd()
  0
}

// The reserved LEQR frame base for ref-list slot `slot`, or -1.
function leqRBaseOfSlot(slot: i32) {
  let i = 0
  while i < fnListEqRSlots.length {
    if fnListEqRSlots[i] == slot { return leqRBases[i] }
    i = i + 1
  }
  -1
}

// i32-list CONCAT `a + b`: a NEW list sized exactly lenA + lenB (one backing
// allocation, two bulk `array.copy`s) — the host's §VL.4 lowering. The operands
// are evaluated once into the LEQI frame; the result wrapper is left on the stack.
function emitListConcatI(body: i32[], leftIx: i32, rightIx: i32, fnIx: i32) {
  const bA = leqIScratchBase
  if emitExpr(body, leftIx, fnIx) < 0 { return -1 }
  // A NARROWED nullable-list operand (`i32[] | null`, kind 15) keeps its nullable
  // slot; the LEQI scratch slot is non-null, so recover before the store (the
  // checker proved the operand guarded — the cast can never trap).
  if exprNullableList(leftIx, fnIx) {
    wU8(212) // 0xd4 ref.as_non_null
  }
  fbLocalSet(bA + 0) // A
  if emitExpr(body, rightIx, fnIx) < 0 { return -1 }
  if exprNullableList(rightIx, fnIx) {
    wU8(212) // 0xd4 ref.as_non_null
  }
  fbLocalSet(bA + 1)       // B
  fbLocalGet(bA + 0)
  fbStructGet(lTypeIdx, 1) // lenA
  fbLocalGet(bA + 1)
  fbStructGet(lTypeIdx, 1) // lenB
  fbI32Bin(106)            // i32.add
  fbLocalSet(bA + 3)       // n = lenA + lenB
  fbLocalGet(bA + 3)
  fbArrayNewDefault(aTypeIdx)
  fbLocalSet(bA + 2)       // out backing
  // array.copy out 0 backingA 0 lenA
  fbLocalGet(bA + 2)
  fbI32Const(0)
  fbLocalGet(bA + 0)
  fbStructGet(lTypeIdx, 0)
  fbI32Const(0)
  fbLocalGet(bA + 0)
  fbStructGet(lTypeIdx, 1)
  fbArrayCopy(aTypeIdx, aTypeIdx)
  // array.copy out lenA backingB 0 lenB
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 0)
  fbStructGet(lTypeIdx, 1)
  fbLocalGet(bA + 1)
  fbStructGet(lTypeIdx, 0)
  fbI32Const(0)
  fbLocalGet(bA + 1)
  fbStructGet(lTypeIdx, 1)
  fbArrayCopy(aTypeIdx, aTypeIdx)
  // the result wrapper { out, n, n }
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 3)
  fbLocalGet(bA + 3)
  fbStructNew(lTypeIdx)
  0
}

// Re-evaluate the field ACCESS CHAIN `root.f1.f2…` onto `body`: the root
// expression, then one `struct.get` per (struct, field) pair in the path arrays.
// Every step is a pure re-read (the equality compare re-walks chains per field).
function emitChainRead(
  body: i32[],
  rootIx: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
) {
  if emitExpr(body, rootIx, fnIx) < 0 { return -1 }
  let k = 0
  while k < pathSi.length {
    fbStructGet(sHeapIdx[pathSi[k]], pathFi[k]) // 0xfb 0x02 <struct ht> <field>
    k = k + 1
  }
  0
}

// Compare two closure fat-pointers already on the stack (left below right), leaving
// a 0/1 i32 — function IDENTITY: the same lifted function (id, field 1) AND the same
// captured env (`ref.eq` over field 0; two null envs are equal, two separately
// CREATED envs of the same function are not). Stages both operands in the 2-slot
// closure-eq frame (`cloEqScratchBase`, reserved by `cloEqNoteBin`'s scan). Mirrors
// the host's function-identity `==` (same table index AND same env).
function emitCloEqCore(_body: i32[]) {
  fbLocalSet(cloEqScratchBase + 1) // B = right operand
  fbLocalSet(cloEqScratchBase + 0) // A = left operand
  fbLocalGet(cloEqScratchBase + 0)
  fbStructGet(cloStructIdx, 1)     // A.id
  fbLocalGet(cloEqScratchBase + 1)
  fbStructGet(cloStructIdx, 1)     // B.id
  fbI32Bin(70)                     // 0x46 i32.eq
  fbLocalGet(cloEqScratchBase + 0)
  fbStructGet(cloStructIdx, 0)     // A.env
  fbLocalGet(cloEqScratchBase + 1)
  fbStructGet(cloStructIdx, 0)     // B.env
  wU8(211)                         // 0xd3 ref.eq (null == null → 1)
  fbI32Bin(113)                    // 0x71 i32.and
  0
}

// THE ONE CORE-SELECTION LADDER for a `==`/`!=` whose two operands are ALREADY ON THE STACK as
// NON-NULL refs. Leaves the 0/1 EQUALITY answer — never the negation; `!=` belongs to the
// caller, which is what lets the null-guarded wrapper negate exactly once.
//
// Read by the plain compare paths AND by `emitNulNicheEq`, so a rep the plain compare can
// handle is a rep the nullable form can handle BY CONSTRUCTION. Two ladders is how the nullable
// half of a rep drifts out of the non-null half's capability, which is the shape of the defect
// this closes.
function emitEqNonNullCore(body: i32[], binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    const coreK = eqCoreKindOfBin(binIx, fnIx)
    if coreK == 0 { return emitListEqICore(body) }
    if coreK == 3 { return emitListEqSCore(body) }
    if coreK == 4 {
      let lslot = refListSlotOfExpr(e.binLeft, fnIx)
      if lslot < 0 { lslot = refListSlotOfExpr(e.binRight, fnIx) }
      const lbase = leqRBaseOfSlot(lslot)
      if lbase < 0 {
        return emitFail("emitProgram: ref-list compare frame not reserved")
      }
      return emitListEqRCore(body, lslot, lbase)
    }
    if coreK == 5 { return emitStrEqCore(body) }
    if coreK == 6 { return emitCloEqCore(body) }
    return emitFail(
      "emitProgram: `" +
        e.binOp +
        "` over this operand rep has no compare core",
    )
  }
  emitFail("emitProgram: expected a `==`/`!=` for the compare core")
}

// One RAW read of a nullable-niche `==` operand — never `ref.as_non_null`, because the guard
// around it exists precisely to SEE the null this rep can hold (a kind-16 `string | null` ident
// otherwise recovers itself and traps on the very value the guard answers for). A literal-union
// ATOM operand still widens to its member string first (`emitStrValue`), the same boundary
// `emitStrEq` applies for `s == k`.
function emitEqOperandRaw(body: i32[], ix: i32, fnIx: i32) {
  if exprIsLitAtom(ix, fnIx) { return emitStrValue(body, ix, fnIx) }
  const rawCtx = expCtxHere()
  rawCtx.rawNullRead = true
  emitExprExpect(body, ix, fnIx, rawCtx)
}

// A NARROWED nullable-niche operand's CELL still holds a `(ref null …)`, and every compare
// core's frame slot demands the non-null ref — so a PLAIN (unguarded) compare recovers its
// operands exactly as `for`-in, `.slice` and the member ops do. The checker proved the read
// guarded (that is what narrowed it), so the cast can never trap.
//
// The collection family answers through its own one home (`nulRecvNeedsRecover`, the READ dual
// of `emitNulIsNullTest`'s niche disjunction); a nullable CLOSURE keeps its cell the same way.
// A `string | null` read RECOVERS ITSELF — suppressing that is exactly what `rawNullRead` is
// for — and a nullable STRUCT reaches its fields through `emitChainRead`, which recovers too.
//
// GENUINELY-nullable operands never arrive here: `binEqNulNiche` claims them off the checker's
// banked type and the guard reads them raw. Only the narrowed spelling reaches this.
function emitEqRecoverNarrowed(exprIx: i32, fnIx: i32) {
  if nulRecvNeedsRecover(exprIx, fnIx) || exprNulClosure(exprIx, fnIx) {
    fbRefAsNonNull() // 0xd4 ref.as_non_null
  }
  0
}

// "Is this `==` operand null" — the shared ladder's answer for a nullable operand, a constant 0
// for a non-nullable one (the MIXED pairing `S | null == S`). Never a hand-rolled
// `ref.is_null`: `emitNulIsNullTest` is the one home for the null test of every rep and its
// header carries why.
function emitEqIsNull(body: i32[], ix: i32, fnIx: i32) {
  const claimed = emitNulIsNullTest(body, ix, fnIx, false, false)
  if claimed < 0 { return -1 }
  if claimed > 0 { return 0 }
  fbI32Const(0)
  0
}

// A `==`/`!=` where at least one operand is a nullable REF NICHE, lowered as the rep's OWN
// compare under a NULL GUARD. Leaves the 0/1 EQUALITY answer (the caller negates for `!=`).
//
// SEMANTICS — `null == null` is TRUE, `null == v` is FALSE. That is not a free choice: every
// nullable rep in the language that already compares correctly answers exactly this. The
// value-union box (`i32 | null`, `f64 | null`), the `boolean | null` i32 sentinel and the
// `K | null` atom sentinel all compare the null tag/sentinel first, and `emitCloEqCore`'s
// `ref.eq` over two null envs is 1 for the same reason. The non-null half is the rep's existing
// core, UNCHANGED — so `[1,2] == [1,2]` over two separately built lists stays TRUE (list `==`
// is deep/structural, not `ref.eq`) and two function values stay compared by identity.
//
// ONE EVALUATION PER OPERAND, AND THAT IS WHAT DECIDES THE BLOCK SHAPE. `br_on_null` consumes
// the ref it tested, so a test-then-re-read guard would double-CALL a call-result operand — and
// a call result is squarely in this class (`f() == g()` over an `i32[] | null` return). The
// right operand's read is EMITTED twice, once per left-nullness path, and exactly one of the two
// ever executes.
//
//     block $out (result i32)
//       block $onenull                  ;; void
//         block $lnull                  ;; void
//           <L raw>  br_on_null $lnull
//           <R raw>  br_on_null $onenull   ;; discards L on the way out — see below
//           <the rep's non-null core>  br $out
//         end                           ;; L was null
//         <R raw>  ref.is_null  br $out ;; both null ⇒ equal
//       end                             ;; exactly one side null
//       i32.const 0
//     end
//
// BOTH REFS LIVE IN THE SAME CONTROL FRAME ($lnull), and that is not stylistic: an instruction
// may not consume an operand pushed BELOW its own frame's entry height, so a core nested one
// block deeper than the left operand's push cannot reach it ("expected (ref $type) but nothing
// on stack"). Testing the right operand against the OUTER $onenull label is what keeps them
// together — a branch unwinds the stack to the target label's height, so the left ref is
// discarded by the branch itself and needs no `drop`.
function emitNulNicheEq(body: i32[], binIx: i32, fnIx: i32, niche: string) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if niche == "nulstruct" { return emitNulStructEq(body, binIx, fnIx) }
    fbBlock(127) // block i32 — $out, the 0/1 answer
    ctrlEnter()
    fbBlock(64) // block void — $onenull
    ctrlEnter()
    fbBlock(64) // block void — $lnull
    ctrlEnter()
    if emitEqOperandRaw(body, e.binLeft, fnIx) < 0 { return -1 }
    wU8(213) // 0xd5 br_on_null — pops it; on non-null leaves (ref $rep)
    wULEB(0) // → $lnull
    if emitEqOperandRaw(body, e.binRight, fnIx) < 0 { return -1 }
    wU8(213) // 0xd5 br_on_null
    wULEB(1) // → $onenull (unwinding past the left ref, which needs no drop)
    if emitEqNonNullCore(body, binIx, fnIx) < 0 { return -1 }
    fbBr(2) // → $out
    fbEnd()
    ctrlLeave() // end $lnull — the left operand was null
    if emitEqOperandRaw(body, e.binRight, fnIx) < 0 { return -1 }
    wU8(209) // 0xd1 ref.is_null — both null ⇒ equal
    fbBr(1) // → $out
    fbEnd()
    ctrlLeave() // end $onenull — exactly one side was null
    fbI32Const(0)
    fbEnd()
    ctrlLeave() // end $out
    return 0
  }
  emitFail("emitProgram: expected a `==`/`!=` over a nullable niche")
}

// The `nulstruct` arm of `emitNulNicheEq`. The struct core is RE-READ based by contract
// (`emitStructEq`: both operands must be pure re-reads, because every field compare
// re-evaluates the full chain from its root), so there is no single-evaluation form to preserve
// and the guard is spelled as two null TESTS instead of the `br_on_null` consume.
function emitNulStructEq(body: i32[], binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    const si = structIndexOfExpr(e.binLeft, fnIx)
    if si < 0 {
      return emitFail("emitProgram: struct equality over a non-struct operand")
    }
    fbBlock(127) // block i32 — $out
    ctrlEnter()
    if emitEqIsNull(body, e.binLeft, fnIx) < 0 { return -1 }
    if emitEqIsNull(body, e.binRight, fnIx) < 0 { return -1 }
    fbI32Bin(71) // 0x47 i32.ne — the two sides disagree on nullness
    fbIf(64)
    ctrlEnter()
    fbI32Const(0)
    fbBr(1) // → $out
    fbEnd()
    ctrlLeave()
    if emitEqIsNull(body, e.binLeft, fnIx) < 0 { return -1 }
    fbIf(64)
    ctrlEnter()
    fbI32Const(1) // both null ⇒ equal
    fbBr(1) // → $out
    fbEnd()
    ctrlLeave()
    const pathSi: i32[] = []
    const pathFi: i32[] = []
    if (
      emitStructEqRec(body, e.binLeft, e.binRight, si, pathSi, pathFi, fnIx) <
      0
    ) {
      return -1
    }
    fbEnd()
    ctrlLeave() // end $out
    return 0
  }
  emitFail("emitProgram: expected a nullable-struct equality")
}

// True for the six `eqCmpKindOfTy` tokens that name a nullable REF NICHE — the ones whose
// compare needs `emitNulNicheEq`'s guard. The BOX- and SENTINEL-repped nullables answer "" from
// that function and are deliberately not here: they already compare tag-first and correctly.
function eqKindIsNulNiche(k: string) {
  k == "nulstr" ||
    k == "nullist" ||
    k == "nulstrlist" ||
    k == "nulreflist" ||
    k == "nulstruct" ||
    k == "nulclosure"
}

// The nullable-niche token for this `==`/`!=`, or "" when neither operand is one (the existing
// dispatch keeps it). Reads the ONE comparability home through the CHECKER'S BANKED TYPE, and
// that is what makes a NARROWED operand fall out for free: inside `if a != null { a == b }` the
// banked type is the non-null one, so the plain path keeps the compare and its bytes do not
// move.
//
// A bare `null` operand is excluded — `x == null` is the null TEST, not a value compare, and
// `emitNulIsNullTest` owns it further down this same dispatch.
function binEqNulNiche(binIx: i32): string {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      if P.nodes[unwrapParen(e.binLeft)] is NullLit { return "" }
      if P.nodes[unwrapParen(e.binRight)] is NullLit { return "" }
      const lk = nodeEqCmpKind(e.binLeft)
      if eqKindIsNulNiche(lk) { return lk }
      const rk = nodeEqCmpKind(e.binRight)
      if eqKindIsNulNiche(rk) { return rk }
    }
  }
  ""
}

// The emitter's half of the ONE comparability answer: true when a `==`/`!=` operand's rep has
// NO compare core. The checker rejects these (`unsupported-lowering`, off the same
// `eqCmpKindOfTy`), so this is the FLOOR — unreachable from accepted source, and the difference
// between a loud `emitProgram:` failure and the i32 tail emitting `i32.eq` over two refs.
function binEqHasNoLowering(binIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if P.nodes[unwrapParen(e.binLeft)] is NullLit { return false }
    if P.nodes[unwrapParen(e.binRight)] is NullLit { return false }
    return nodeEqCmpKind(e.binLeft) == "none" ||
      nodeEqCmpKind(e.binRight) == "none"
  }
  false
}

// Lower a STRUCTURAL struct equality `a == b` (or `!=`) onto `body`, leaving a 0/1
// i32 — field-wise compare mirroring the host's `valueEq`: native compares for
// scalars, the string-eq loop for string fields, a length+element loop for `i32[]`
// fields, and recursion through NESTED struct fields (code 15). Both operands must
// be PURE re-reads (names / field chains): every field compare re-evaluates the
// full chain from its root. The two shapes match (same struct table index) — the
// checker proved the operands comparable.
function emitStructEq(body: i32[], binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    const si = structIndexOfExpr(e.binLeft, fnIx)
    if si < 0 {
      return emitFail("emitProgram: struct equality over a non-struct operand")
    }
    const pathSi: i32[] = []
    const pathFi: i32[] = []
    if (
      emitStructEqRec(body, e.binLeft, e.binRight, si, pathSi, pathFi, fnIx) <
      0
    ) {
      return -1
    }
    if e.binOp == "!=" {
      fbI32Eqz() // 0x45 i32.eqz — negate value-equality
    }
    return 0
  }
  emitFail("emitProgram: expected a struct equality")
}

// One struct SHAPE's field-wise compare at path (`pathSi`/`pathFi` from the roots),
// leaving 0/1: an and-chain of per-field compares lowered as nested value-typed
// `if`s (compare; if → next field … ; else → 0), so a first mismatch short-circuits.
function emitStructEqRec(
  body: i32[],
  lRoot: i32,
  rRoot: i32,
  si: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
) {
  const cnt = sFieldCount[si]
  if cnt == 0 {
    fbI32Const(1)
    return 0
  }
  let fi = 0
  while fi < cnt {
    if emitStructEqField(body, lRoot, rRoot, si, fi, pathSi, pathFi, fnIx) < 0 {
      return -1
    }
    if fi < cnt - 1 {
      fbIf(127) // 0x04 if, 0x7f i32 blocktype — chain the next field
      ctrlEnter()
    }
    fi = fi + 1
  }
  // Close the chain: each opened `if` gets `else (i32.const 0) end`.
  let k = cnt - 1
  while k > 0 {
    fbElse() // 0x05 else
    fbI32Const(0)
    fbEnd()  // 0x0b end
    ctrlLeave()
    k = k - 1
  }
  0
}

// Compare ONE field at (si, fi) across the two chains, leaving 0/1. The path
// push/pop frames the inner compare so chains rewind for the next sibling field.
function emitStructEqField(
  body: i32[],
  lRoot: i32,
  rRoot: i32,
  si: i32,
  fi: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
) {
  pathSi.push(si)
  pathFi.push(fi)
  const r = emitStructEqFieldInner(
    body,
    lRoot,
    rRoot,
    si,
    fi,
    pathSi,
    pathFi,
    fnIx,
  )
  pathSi.pop()
  pathFi.pop()
  r
}

function emitStructEqFieldInner(
  body: i32[],
  lRoot: i32,
  rRoot: i32,
  si: i32,
  fi: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
) {
  const code = sFieldTypeAt(si, fi)
  if code == 0 {
    // Scalar (i32 / boolean): a native compare.
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    fbI32Bin(70) // 0x46 i32.eq
    return 0
  }
  if code == 17 {
    // f64 scalar field: a native f64 compare (i32 0/1 result).
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    fbI32Bin(97) // 0x61 f64.eq
    return 0
  }
  if code == 3 {
    // String: the element-wise string-eq loop over the two field refs.
    if !aUsed {
      return emitFail(
        "emitProgram: string field equality but array type not collected",
      )
    }
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    return emitStrEqCore(body)
  }
  if code == 15 {
    // Nested struct: recurse one level deeper along the chain.
    const nsi = sFieldTgtStructIdx(si, fi)
    if nsi < 0 {
      return emitFail(
        "emitProgram: nested struct field equality with no interned shape",
      )
    }
    return emitStructEqRec(body, lRoot, rRoot, nsi, pathSi, pathFi, fnIx)
  }
  if code == 4 {
    // `i32[]` list: lengths equal AND element-wise equal — `len` from the WRAPPER
    // (field 1, the logical size; the backing may be longer), elements off the
    // backings (stashed in the string-op frame refs, the same `(array i32)` type).
    if !lUsed {
      return emitFail(
        "emitProgram: i32[] field equality but list type not collected",
      )
    }
    // lenL != lenR → 0, else the element loop.
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    fbStructGet(lTypeIdx, 1) // wrapper field 1: len
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    fbStructGet(lTypeIdx, 1)
    fbI32Bin(71)             // 0x47 i32.ne
    fbIf(127)                // 0x04 if, 0x7f i32 blocktype
    ctrlEnter()
    fbI32Const(0)            // length mismatch → 0
    fbElse()                 // 0x05 else — the element loop, like emitStrEqCore
    // A = backing(L.f); B = backing(R.f); I0 = len; I1 = 0
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    fbStructGet(lTypeIdx, 0) // backing
    fbLocalSet(strScratchBase + 0)
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    fbStructGet(lTypeIdx, 0)
    fbLocalSet(strScratchBase + 1)
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    fbStructGet(lTypeIdx, 1) // len
    setStrScrI(body, 0)
    fbBlock(127)             // 0x02 block, 0x7f i32 — yields the 0/1 result
    fbI32Const(0)
    setStrScrI(body, 1)      // I1 = 0
    fbLoop(64)               // 0x03 loop, void
    pushStrScrI(body, 1)
    pushStrScrI(body, 0)
    fbI32Bin(78)             // 0x4e i32.ge_s — done?
    fbIf(64)                 // then: fall through (all matched)
    fbElse()
    pushStrScrRef(body, 0)
    pushStrScrI(body, 1)
    fbArrayGet(aTypeIdx)
    pushStrScrRef(body, 1)
    pushStrScrI(body, 1)
    fbArrayGet(aTypeIdx)
    fbI32Bin(71)             // 0x47 i32.ne
    fbIf(64)                 // mismatch → 0, exit the result block
    fbI32Const(0)
    fbBr(3)                  // depths: if(0)·else(1)·loop(2)·block(3)
    fbEnd()
    pushStrScrI(body, 1)
    fbI32Const(1)
    fbI32Bin(106)            // i32.add
    setStrScrI(body, 1)
    fbBr(1)                  // continue the loop
    fbEnd()                  // end (else's if)
    fbEnd()                  // end (loop)
    fbI32Const(1)            // every element matched
    fbEnd()                  // end (result block)
    fbEnd()                  // end (length if/else)
    ctrlLeave()
    return 0
  }
  if code == 14 {
    // Function-valued field: identity compare (id + env) via the closure-eq frame.
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    return emitCloEqCore(body)
  }
  emitFail("emitProgram: unsupported struct field type in equality")
}

// Emit `clamp(idx, len)` where `idx` is in i32 temp `idxSlot` and `len` in temp
// `lenSlot`, leaving the clamped value on the stack. JS slice semantics: a negative
// index counts from the end (`len + idx`, floored at 0), a non-negative index is
// capped at `len` — `idx < 0 ? max(len+idx, 0) : min(idx, len)`. Built from `select`
// (`0x1b`: `[a, b, cond] -> a if cond else b`).
function emitClampIdx(body: i32[], idxSlot: i32, lenSlot: i32) {
  // negCase = max(len+idx, 0) = select( len+idx, 0, (len+idx) > 0 )
  pushStrScrI(body, lenSlot)
  pushStrScrI(body, idxSlot)
  fbI32Bin(106) // i32.add → (len+idx)  [the `a` value]
  fbI32Const(0) // i32.const 0          [the `b` value]
  pushStrScrI(body, lenSlot)
  pushStrScrI(body, idxSlot)
  fbI32Bin(106) // i32.add → (len+idx)
  fbI32Const(0) // i32.const 0
  fbI32Bin(74)  // 0x4a i32.gt_s → (len+idx) > 0   [cond]
  wU8(27)       // 0x1b select → negCase on stack
  // nonNegCase = min(idx, len) = select( idx, len, idx < len )
  pushStrScrI(body, idxSlot) // a = idx
  pushStrScrI(body, lenSlot) // b = len
  pushStrScrI(body, idxSlot)
  pushStrScrI(body, lenSlot)
  fbI32Bin(72)               // 0x48 i32.lt_s → idx < len   [cond]
  wU8(27)                    // select → nonNegCase on stack
  // result = select( negCase, nonNegCase, idx < 0 )
  // Stack currently: [negCase, nonNegCase]; push cond then select.
  pushStrScrI(body, idxSlot)
  fbI32Const(0) // i32.const 0
  fbI32Bin(72)  // 0x48 i32.lt_s → idx < 0
  wU8(27)       // select → clamped value
  0
}

// Lower a string `s.slice(start, end)` onto `body`, leaving the new string ref on
// the stack — a fresh `(array i32)` over the half-open clamped range `[start, end)`.
// JS semantics (mirroring `__string_slice__`): each bound clamps via `emitClampIdx`,
// the out length is `max(end - start, 0)`, then one `array.copy` from `s[start]`.
// i32 temps: I0 = clamped start, I1 = clamped end, I2 = len(s), I3 = out length.
function emitStrSlice(body: i32[], callIx: i32, fnIx: i32) {
  if !aUsed {
    return emitFail("emitProgram: string slice but array type not collected")
  }
  const c = P.nodes[callIx]
  if c is Call {
    if c.callArgs.length != 2 {
      return emitFail(
        "emitProgram: string .slice takes exactly two arguments (start, end)",
      )
    }
    const callee = P.nodes[c.callFn]
    if callee is Member {
      // Eval receiver + both args onto the stack first (nested string ops complete),
      // then stash: end on top → I1, then start → I0, then receiver → strScrA.
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      if emitExpr(body, c.callArgs[1], fnIx) < 0 { return -1 }
      setStrScrI(body, 1)            // raw end → I1
      setStrScrI(body, 0)            // raw start → I0
      fbLocalSet(strScratchBase + 0) // local.set strScrA (receiver)
      // I2 = len(s)
      pushStrScrRef(body, 0)
      fbArrayLen() // array.len
      setStrScrI(body, 2)
      // I0 = clamp(rawStart, len)
      if emitClampIdx(body, 0, 2) < 0 { return -1 }
      setStrScrI(body, 0)
      // I1 = clamp(rawEnd, len)
      if emitClampIdx(body, 1, 2) < 0 { return -1 }
      setStrScrI(body, 1)
      // I3 = out length = max(end - start, 0) = select( end-start, 0, end > start )
      pushStrScrI(body, 1)
      pushStrScrI(body, 0)
      fbI32Bin(107) // 0x6b i32.sub → end - start   [a]
      fbI32Const(0) // i32.const 0                  [b]
      pushStrScrI(body, 1)
      pushStrScrI(body, 0)
      fbI32Bin(74)  // 0x4a i32.gt_s → end > start  [cond]
      wU8(27)       // 0x1b select
      setStrScrI(body, 3)
      // Out = array.new_default $aTypeIdx I3
      pushStrScrI(body, 3)
      fbArrayNewDefault(aTypeIdx)    // 0xfb 0x07 array.new_default <typeidx>
      fbLocalSet(strScratchBase + 2) // local.set strScrOut
      // array.copy Out 0 s start n
      pushStrScrRef(body, 2)          // dest
      fbI32Const(0)                   // i32.const 0 (dest offset)
      pushStrScrRef(body, 0)          // src s
      pushStrScrI(body, 0)            // src offset = clamped start
      pushStrScrI(body, 3)            // count = n
      fbArrayCopy(aTypeIdx, aTypeIdx) // array.copy (dest type, src type)
      // Result: the new string ref.
      pushStrScrRef(body, 2)
      return 0
    }
    return emitFail(
      "emitProgram: string .slice receiver is not a member access",
    )
  }
  emitFail("emitProgram: expected a string slice call")
}

// Lower `s.indexOf(sub)` (or `s.includes(sub)`) onto `body`, leaving an i32: the
// first index of `sub` in `s`, or -1 (an empty `sub` yields 0, the JS convention);
// `includes` is `indexOf != -1`.
// Scratch: refs A = s, B = sub; i32 temps I0 = i (candidate start), I1 = the
// hoisted first needle character during the skip and the match index during the
// verify, I2 = len(s) - len(sub) (the last start at which the needle still fits),
// I3 = len(sub).
//   block i32 {
//     I2 = len(A) - len(B) ; I3 = len(B)
//     if I3 == 0 { (0)  br <block> }          ; empty needle → 0
//     if I2 <  0 { (-1) br <block> }          ; needle longer than haystack → -1
//     I0 = 0
//     loop {                                  ; outer: one trip per verify attempt
//       I1 = B[0]                             ; the character every start must have
//       loop {                                ; skip: advance to the next candidate
//         if I0 > I2 { (-1) br <block> }      ; past the last start → no match
//         if A[I0] != I1 { I0 = I0 + 1; br <skip> }
//       }
//       I1 = 1                                ; B[0] already matched
//       loop {                                ; verify: the rest of the needle
//         if I1 >= I3 { (I0) br <block> }     ; full match → yield I0
//         if A[I0+I1] != B[I1] { I0 = I0 + 1; br <outer> }
//         I1 = I1 + 1
//         br <verify>
//       }
//     }
//     (i32.const -1)                          ; block result; the skip loop owns
//   }                                         ; the real exhaustion exit
//
// THE SKIP LOOP IS THE POINT. The overwhelmingly common answer at a candidate
// start is "the first character already differs", and a naive scan pays TWO
// bounds-checked `array.get`s to reach it — `A[I0+I1]` and `B[I1]` — plus the
// index add. Hoisting `B[0]` into a local makes that answer cost ONE load and a
// compare against a register.
//
// The hoist is reloaded once per OUTER trip rather than held across the whole
// search, which is what lets it share `I1` with the verify counter and keeps the
// string scratch frame at its existing width. The reload is paid only when a
// candidate actually matched its first character, so its frequency is the
// first-character hit rate, not the position count — on the repeated-character
// worst case (`aaaa…` searched for `aaab`), where every position is a hit, it
// costs exactly the `B[0]` load the naive scan was already doing at `I1 == 0`.
//
// Both guards are load-bearing, not defensive: hoisting `B[0]` would TRAP on an
// empty needle, and a needle longer than the haystack makes `I2` negative, which
// the skip loop's `I0 > I2` test answers immediately.
function emitStrIndexOf(body: i32[], callIx: i32, fnIx: i32) {
  if !aUsed {
    return emitFail("emitProgram: string indexOf but array type not collected")
  }
  const c = P.nodes[callIx]
  if c is Call {
    if c.callArgs.length != 1 {
      return emitFail("emitProgram: string .indexOf takes exactly one argument")
    }
    const callee = P.nodes[c.callFn]
    if callee is Member {
      const isIncludes = callee.memProp == "includes"
      // Eval receiver + needle onto the stack first (nested string ops complete),
      // then stash: needle on top → B, then receiver → A.
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      fbLocalSet(strScratchBase + 1) // local.set strScrB (sub)
      fbLocalSet(strScratchBase + 0) // local.set strScrA (s)
      // I3 = len(sub); I2 = len(s) - len(sub), the last start the needle fits at.
      pushStrScrRef(body, 1)
      fbArrayLen()  // array.len
      setStrScrI(body, 3)
      pushStrScrRef(body, 0)
      fbArrayLen()  // array.len
      pushStrScrI(body, 3)
      fbI32Bin(107) // 0x6b i32.sub
      setStrScrI(body, 2)
      fbBlock(127)  // 0x02 block, 0x7f i32 blocktype — yields index / -1
      // Empty needle → 0. This is also what makes the hoisted B[0] below safe.
      pushStrScrI(body, 3)
      fbI32Const(0)
      fbI32Bin(70) // 0x46 i32.eq
      fbIf(64)     // 0x04 if, 0x40 void blocktype
      fbI32Const(0)
      fbBr(1)      // → out of the i32 block
      fbEnd()
      // Needle longer than haystack → -1 (no start exists).
      pushStrScrI(body, 2)
      fbI32Const(0)
      fbI32Bin(72)        // 0x48 i32.lt_s
      fbIf(64)
      fbI32Const(-1)
      fbBr(1)             // → out of the i32 block
      fbEnd()
      fbI32Const(0)
      setStrScrI(body, 0) // I0 = 0
      fbLoop(64)          // 0x03 loop (outer) — one trip per verify attempt
      // I1 = B[0]: the character every candidate start has to carry.
      pushStrScrRef(body, 1)
      fbI32Const(0)
      fbArrayGet(aTypeIdx) // 0xfb 0x0b array.get
      setStrScrI(body, 1)
      fbLoop(64)           // 0x03 loop (skip) — advance to the next candidate
      // Past the last possible start → no match.
      pushStrScrI(body, 0)
      pushStrScrI(body, 2)
      fbI32Bin(74) // 0x4a i32.gt_s
      fbIf(64)
      fbI32Const(-1)
      fbBr(3)      // depths: if(0)·skip(1)·outer(2)·block(3)
      fbEnd()
      // A[I0] != B[0] → not a candidate: advance and keep skipping. ONE load.
      pushStrScrRef(body, 0)
      pushStrScrI(body, 0)
      fbArrayGet(aTypeIdx)
      pushStrScrI(body, 1)
      fbI32Bin(71)  // 0x47 i32.ne
      fbIf(64)
      pushStrScrI(body, 0)
      fbI32Const(1)
      fbI32Bin(106) // 0x6a i32.add
      setStrScrI(body, 0)
      fbBr(1)       // → skip loop header
      fbEnd()
      fbEnd()       // 0x0b end (skip loop) — falls through with A[I0]==B[0]
      // I1 = 1: B[0] already matched, so verification starts at index 1.
      fbI32Const(1)
      setStrScrI(body, 1)
      fbLoop(64) // 0x03 loop (verify)
      // I1 >= len(sub) → full match at I0: yield I0 out of the i32 block.
      pushStrScrI(body, 1)
      pushStrScrI(body, 3)
      fbI32Bin(78) // 0x4e i32.ge_s
      fbIf(64)
      pushStrScrI(body, 0)
      fbBr(3)      // depths: if(0)·verify(1)·outer(2)·block(3)
      fbEnd()
      // A[I0+I1] != B[I1] → mismatch: advance I0 and re-enter the skip loop.
      pushStrScrRef(body, 0)
      pushStrScrI(body, 0)
      pushStrScrI(body, 1)
      fbI32Bin(106)        // 0x6a i32.add
      fbArrayGet(aTypeIdx) // 0xfb 0x0b array.get
      pushStrScrRef(body, 1)
      pushStrScrI(body, 1)
      fbArrayGet(aTypeIdx) // array.get
      fbI32Bin(71)         // 0x47 i32.ne
      fbIf(64)
      pushStrScrI(body, 0)
      fbI32Const(1)
      fbI32Bin(106)        // i32.add
      setStrScrI(body, 0)  // I0 = I0 + 1
      fbBr(2)              // 0x0c br depth 2 → outer loop header
      fbEnd()              // 0x0b end (mismatch if)
      // I1 = I1 + 1; br verify loop
      pushStrScrI(body, 1)
      fbI32Const(1)
      fbI32Bin(106)  // i32.add
      setStrScrI(body, 1)
      fbBr(0)        // 0x0c br depth 0 → verify loop header
      fbEnd()        // 0x0b end (verify loop)
      fbEnd()        // 0x0b end (outer loop)
      fbI32Const(-1) // block result; the skip loop owns the real exhaustion exit
      fbEnd()        // 0x0b end (block) — leaves the i32 result
      if isIncludes {
        fbI32Const(-1)
        fbI32Bin(71) // 0x47 i32.ne — `includes` ≡ `indexOf(sub) != -1`
      }
      return 0
    }
    return emitFail(
      "emitProgram: string .indexOf receiver is not a member access",
    )
  }
  emitFail("emitProgram: expected a string indexOf call")
}

// Lower `s.charCodeAt(i)` onto `body`, leaving the char code i32. A direct
// `array.get` over the code-point array — an out-of-range index TRAPS, matching
// the host (`s[i]` semantics, no JS NaN; compiler/builtins/strings.ts).
function emitStrCharCode(body: i32[], callIx: i32, fnIx: i32) {
  if !aUsed {
    return emitFail(
      "emitProgram: string charCodeAt but array type not collected",
    )
  }
  const c = P.nodes[callIx]
  if c is Call {
    if c.callArgs.length != 1 {
      return emitFail(
        "emitProgram: string .charCodeAt takes exactly one argument",
      )
    }
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      fbArrayGet(aTypeIdx) // 0xfb 0x0b array.get
      return 0
    }
    return emitFail(
      "emitProgram: string .charCodeAt receiver is not a member access",
    )
  }
  emitFail("emitProgram: expected a string charCodeAt call")
}

export function emitExpr(body: i32[], exprIx: i32, fnIx: i32) {
  if exprIx < 0 { return emitFail("emitProgram: missing expression") }
  // A STRING-repped literal union reaching an ATOM-typed destination narrows to its interned
  // id here — ONE hook rather than one per destination, because `pendingLitUnion` is already
  // the context every atom-typed slot seeds (an annotated local, a `K` parameter, a `K`
  // field, a `K[]` element, a `K` return, a `K`-valued map store). Without it the store was
  // a `local.set` of a `(ref $array)` into an `i32` slot: invalid wasm with `vl check
  // --codegen` rc 0, at every one of those destinations.
  if pendingLitUnion == 1 {
    if strReppedLitUnionAt(exprIx, fnIx) {
      return emitStrToAtom(body, unwrapParen(exprIx), fnIx)
    }
  }
  const e = P.nodes[exprIx]
  if e is NumLit { return emitNumLitNode(body, e, exprIx, fnIx) }
  if e is BoolLit {
    // `boolean` rides in an i32: true=1, false=0 (already decoded into `boolVal`).
    fbI32Const(e.boolVal)
    return 0
  }
  if e is CharLit { return emitCharLitNode(body, e, exprIx, fnIx) }
  if e is Ident { return emitIdentNode(body, e, exprIx, fnIx) }
  if e is Paren { return emitExpr(body, e.parInner, fnIx) }
  if e is Unary { return emitUnaryNode(body, e, exprIx, fnIx) }
  if e is AsExpr { return emitAsCast(body, e, exprIx, fnIx) }
  if e is Call { return emitCallNode(body, e, exprIx, fnIx) }
  if e is IsExpr { return emitIs(body, exprIx, fnIx) }
  if e is NullLit { return emitNullLitNode(body, e, exprIx, fnIx) }
  if e is ObjLit { return emitObjLitNode(body, e, exprIx, fnIx) }
  if e is StrLit {
    // A literal-union MEMBER in atom context (`pendingLitUnion`) lowers as its interned i32 id.
    if pendingLitUnion == 1 {
      fbI32Const(internAtom(e.strText))
      return 0
    }
    return emitStr(body, exprIx, fnIx)
  }
  if e is ArrayLit { return emitArr(body, exprIx, fnIx) }
  if e is Index {
    // G8: a map GET `m[k]` (no `??`) — scan, value or 0. A `??` get is fused in the
    // BinExpr branch below (it carries the default).
    if exprMap(e.idxArr, fnIx) {
      return emitMapGet(body, e.idxArr, e.idxIndex, fnIx)
    }
    return emitIndex(body, exprIx, fnIx)
  }
  if e is Member { return emitMemberNode(body, e, exprIx, fnIx) }
  if e is BinExpr { return emitBinExprNode(body, e, exprIx, fnIx) }
  if e is FuncDecl {
    // An anonymous `function(...)` literal in value position (it was lifted to a
    // top-level function by `collectFns`, keeping its name). Construct its closure value.
    const fe = fnStmtsPosOf(exprIx)
    if fe >= 0 { return emitClosureValue(body, fe, fnIx) }
    return emitFail("emitProgram: function literal not lifted")
  }
  if e is IfStmt {
    // An IF-EXPRESSION in value position (`if c then 7 else 9` — the parser wraps
    // each arm as a one-statement Block; an `else if` chain nests an IfStmt in the
    // else slot). Lowered as `if (result i32)` over the arm VALUES.
    return emitIfExpr(body, exprIx, fnIx)
  }
  emitFail("emitProgram: unsupported expression in return")
}

// Lower an if-EXPRESSION (`if c then a else b` in value position) onto `body`:
// cond, `if (result <kind>)`, the then-arm VALUE, `else`, the else-arm VALUE (an
// `else if` chain recurses), `end`. Each arm applies the same condition narrowing
// the statement form does. The blocktype is the SCALAR rep the branch-join produced —
// i32 (127, the default), i64 (126), f32 (125), or f64 (124) — all single-byte
// valtypes; both arms are emitted COERCED to that rep so a mixed `then 1 else 2.5`
// widens its i32 arm to f64. A REF-typed join (string / struct / array — NOT a value
// union or concrete variant, which `emitUnionIfValue`/`emitVariantIfValue` already
// handle at their coerce sites) routes to `emitIfExprRef`, which writes the multi-byte
// `(ref $ht)` blocktype via `fbValtype`. A missing else / non-value arm fails loudly —
// the checker already proved both arms exist and agree.
function emitIfExpr(body: i32[], ifIx: i32, fnIx: i32) {
  const rk = ifExprRefKind(ifIx, fnIx)
  if rk != null {
    return emitIfExprRef(body, ifIx, fnIx, rk, ifExprRefSlot(ifIx, fnIx, rk))
  }
  emitIfExprAs(body, ifIx, fnIx, ifExprValtype(ifIx, fnIx))
}

// Lower a REF-typed if-expression join (string / struct / array) as a value-typed `if`
// with the multi-byte `(ref $ht)` blocktype (`fbValtype`), each arm emitted in that rep.
// Mirrors `emitIfExprAs` (narrowing save/restore, `else if` recursion) but the blocktype
// is an interned reftype rather than a single numeric byte. The arm emitter re-seeds the
// per-arm construction context so an `ObjLit` / list-literal arm builds the right shape.
function emitIfExprRef(
  body: i32[],
  ifIx: i32,
  fnIx: i32,
  kind: VKind,
  slot: i32,
) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    if s.ifElse < 0 {
      return emitFail("emitProgram: if-expression requires an else arm")
    }
    if emitExpr(body, s.ifCond, fnIx) < 0 { return -1 }
    wU8(4) // 0x04 if
    // A struct join the checker typed `S | null` (one arm is `null` → `(ref null $S)`, the other a
    // `(ref $S)`) needs a NULLABLE blocktype, else the null arm's `(ref null $S)` mismatches the
    // non-null `(ref $S)` result. `nodeTyIsNullableStruct` reads the checker's recorded join type — the
    // generic signal — rather than re-deriving from the arms. (A non-nullable struct join, or a binding
    // annotated `S | null` whose arms are both non-null, stays non-null: the value widens on store.)
    if kind == "struct" && nodeTyIsNullableStruct(ifIx) {
      fbValtypeNullable(kind, slot) // `(ref null $S)` result blocktype
    } else {
      fbValtype(kind, slot) // ref result blocktype `(ref $ht)`
    }
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const rcT = emitRefIfArm(body, s.ifThen, fnIx, kind, slot)
    if narrowed { restoreNarrow(savedTop) }
    if rcT < 0 { return -1 }
    fbElse() // 0x05 else
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    const els = P.nodes[s.ifElse]
    let rc = 0
    if els is IfStmt {
      rc = emitIfExprRef(body, s.ifElse, fnIx, kind, slot)
    } else {
      rc = emitRefIfArm(body, s.ifElse, fnIx, kind, slot)
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    return 0
  }
  emitFail("emitProgram: expected an if expression")
}

// ── if-EXPRESSION arm prelude ─────────────────────────────────────────────────
// An if-expression arm is a Block whose VALUE is its LAST statement (`ifArmValueExpr`);
// every statement before it is the arm's PRELUDE. The parser writes a one-statement arm
// for `if c { v }`, but a `const` declared in the arm makes it two — and that is exactly
// what a `match` payload-binding arm desugars to (`match u { A{a} => a }` becomes
// `if u is A { const a = u.a; a }`), so the prelude is what lets a BINDING arm sit in
// value position. Wasm-wise the prelude is stack-neutral: it runs inside the arm's
// `if`/`else` frame and leaves only the value the blocktype promises.
//
// `emitIfArmOpen` pushes the arm's lexical frame and lowers the prelude; the caller then
// emits the value in ITS join rep and closes with `emitIfArmClose`, which pops the frame
// so the arm's bindings do not leak into the sibling arm or past the `if`. The two are
// separate calls because each arm emitter lowers the VALUE differently (coerced numeric,
// ref, union box, variant struct, return exit) while the prelude and the frame are shared.

// Push the arm's lexical frame and lower every statement before the arm's value.
// Returns 0, or -1 (the caller still owes `emitIfArmClose`).
//
// A non-empty prelude is lowered ONLY when `collectLocalsIf` walked this arm
// (`armPreludeBlocks`) — that walk is what allocated the arm's locals, in the pre-order
// `emitLetDeclStmt`'s cursor replays. An if-expression collect does not descend into
// (one buried inside another expression, or a top-level global's initializer) is rejected
// here rather than lowered against slots that belong to something else.
function emitIfArmOpen(body: i32[], blockIx: i32, fnIx: i32) {
  scopePush()
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    if stmts.length > 1 {
      if !armPreludeWalked(blockIx) {
        return emitFail(
          "emitProgram: an if-expression arm that declares a local is supported only as a binding initializer inside a function",
        )
      }
    }
    let i = 0
    while i + 1 < stmts.length {
      if emitStmt(body, stmts[i], fnIx) < 0 { return -1 }
      i = i + 1
    }
  }
  0
}

// True if the collect pass allocated the prelude locals of the arm block at `blockIx`.
function armPreludeWalked(blockIx: i32) {
  let i = 0
  while i < armPreludeBlocks.length {
    if armPreludeBlocks[i] == blockIx { return true }
    i = i + 1
  }
  false
}

// Pop the arm's lexical frame, passing `rc` through so an arm emitter can close and
// return in one expression.
function emitIfArmClose(rc: i32) {
  scopePop()
  rc
}

// The `emitFail` reason for an if-expression arm that leaves no value on the stack.
// Every arm emitter reaches this through the same two-part gate — `ifArmValueExpr`
// finding the arm's last statement, then that statement classifying as a value — and
// the two halves fail for DIFFERENT reasons, so the message names which one fired:
//
//   • an EMPTY arm block has no value expression at all (`ifArmValueExpr` → -1);
//   • an arm ending in a VOID call (`print(..)` / `recv.push(x)` / a void function /
//     a store intrinsic) is a single, well-formed expression that yields nothing;
//   • an arm ending in a real STATEMENT (`let` / `while` / an index-target assignment /
//     a void `if`) likewise yields nothing.
//
// The middle case is why "not a single value" is the wrong thing to say: such an arm IS
// a single expression, and the author's fix is to give the call a result or restructure
// the `if` as a statement — not to collapse the arm. `what` names the arm flavour
// ("if-expression arm" / "union if-expression arm" / "variant if-expression arm") so
// the union and variant joins keep their own rep in the text.
function ifArmNoValueFail(what: string, blockIx: i32) {
  const tv = ifArmValueExpr(blockIx)
  if tv < 0 {
    return emitFail("emitProgram: " + what + " is empty, so it yields no value")
  }
  const s = P.nodes[unwrapParen(tv)]
  if s is Call {
    return emitFail(
      "emitProgram: " +
        what +
        " ends in a void call, which yields no value",
    )
  }
  emitFail(
    "emitProgram: " + what + " ends in a statement, which yields no value",
  )
}

// One arm of a REF-typed if-expression: its prelude, then its tail-value statement
// emitted in the join rep. Re-seeds `pendingStructIdx` (struct arms) /
// `pendingListKind`+`pendingListSlot` (ref-list arms) after the prelude — the previous
// arm's emit consumed the pending seed, and so can a prelude statement.
function emitRefIfArm(
  body: i32[],
  blockIx: i32,
  fnIx: i32,
  kind: VKind,
  slot: i32,
) {
  const b = P.nodes[blockIx]
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if ifArmIsValue(tv, fnIx) {
        if emitIfArmOpen(body, blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        if kind == "struct" { pendingStructIdx = slot }
        if kind == "reflist" {
          pendingListKind = 5
          pendingListSlot = slot
        }
        // An ATOM arm in a `string` join widens to its member string (the atom is a
        // bare i32 id; the join blocktype is the string ref) — the if-expression seam
        // of the atom-as-string-subtype widen (`retStrWiden` at returns).
        if kind == "str" && exprIsLitAtom(tv, fnIx) {
          return emitIfArmClose(emitAtomToStr(body, tv, fnIx))
        }
        return emitIfArmClose(emitExpr(body, tv, fnIx))
      }
    }
    return ifArmNoValueFail("if-expression arm", blockIx)
  }
  emitFail("emitProgram: if-expression arm is not a block")
}

// Lower the if-expression at `ifIx` with a known blocktype byte `kind`, threading it
// through the `else if` recursion so the whole chain shares one result rep.
function emitIfExprAs(body: i32[], ifIx: i32, fnIx: i32, kind: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    if s.ifElse < 0 {
      return emitFail("emitProgram: if-expression requires an else arm")
    }
    if emitExpr(body, s.ifCond, fnIx) < 0 { return -1 }
    fbIf(kind) // 0x04 if, <kind> result blocktype
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const rcT = emitBlockValueAs(body, s.ifThen, fnIx, kind)
    if narrowed { restoreNarrow(savedTop) }
    if rcT < 0 { return -1 }
    fbElse()   // 0x05 else
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    const els = P.nodes[s.ifElse]
    let rc = 0
    if els is IfStmt {
      rc = emitIfExprAs(body, s.ifElse, fnIx, kind)
    } else {
      rc = emitBlockValueAs(body, s.ifElse, fnIx, kind)
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    return 0
  }
  emitFail("emitProgram: expected an if expression")
}

// The VALUE of an if-expression arm: its prelude, then its tail-value statement emitted
// as an expression COERCED to the if-expression's result rep `kind` (so an i32-literal
// arm widens into an f64/f32/i64 join). The i32 default emits the value as-is.
function emitBlockValueAs(body: i32[], blockIx: i32, fnIx: i32, kind: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if ifArmIsValue(tv, fnIx) {
        if emitIfArmOpen(body, blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        if kind == 124 { return emitIfArmClose(emitExprAsF64(body, tv, fnIx)) }
        if kind == 125 { return emitIfArmClose(emitExprAsF32(body, tv, fnIx)) }
        if kind == 126 { return emitIfArmClose(emitExprAsI64(body, tv, fnIx)) }
        return emitIfArmClose(emitExpr(body, tv, fnIx))
      }
    }
    return ifArmNoValueFail("if-expression arm", blockIx)
  }
  emitFail("emitProgram: if-expression arm is not a block")
}

// ── nullable / value-union if-EXPRESSION in BINDING-INIT position ──────────────
// `const x: i32 | null = if c then 5 else null` (and `else if` chains) lowers as a
// VOID `if` whose every arm writes the binding's OWN local — so no value-typed-if
// blocktype (an interned functype) and no scratch slot are needed: the destination
// local IS the stash. Each arm emits its value in the binding's nullable rep (`rep`:
// 0 the value-union box, 1 a `string | null` ref) then `local.set`s it; a bare `null`
// arm / an else-less false path writes the rep's null. This is the binding-position
// counterpart of the return-tail `emitIfTail`/`emitNullForRet` lowering (#484/#489).
// A `boolean | null` local is not yet a supported rep at all (a separate pre-existing
// gap), so it is not handled here.

// Emit ONE arm value (`valIx`) in the binding's nullable rep, then `local.set idx`.
function emitNulArmToLocal(
  body: i32[],
  valIx: i32,
  idx: i32,
  rep: i32,
  unionName: string,
  fnIx: i32,
) {
  if valIx < 0 {
    return emitFail("emitProgram: if-expression arm is not a value")
  }
  if rep == 0 {
    // The binding's local is the union BOX `(ref $uBox)`, so a CONCRETE-VARIANT arm (`x`, a
    // kind-8 `(ref $variant)` — `let a: Animal = if c then x else y`) must be BOXED to match,
    // exactly as in `emitUnionIfArm` / a variant return. `emitUnionBoxArg` boxes a variant ref
    // and defers every other shape (object literal, passthrough union, scalar) to
    // `emitUnionCoerce` — plain `emitUnionCoerce` stored the raw variant ref (invalid wasm).
    if emitUnionBoxArg(body, unionName, valIx, fnIx) < 0 { return -1 }
  } else if rep == 1 {
    // rep 1: a `string | null` arm — a non-null string passes through, a bare `null`
    // lowers as `ref.null $aTypeIdx` (`nulString`).
    //
    // A literal-union ATOM arm is the one non-null value that does NOT pass through: its rep is
    // an i32 id and the local is a nullable string reference, so it widens first. This is the
    // BINDING-INIT path (`const s: string | null = if b { r.f } else { "z" }`), which
    // `emitLetDeclStmt` routes here early — it never reaches the if-ARM widen at the join, which
    // is why adding a `nulstr` kind there measured inert.
    if exprIsLitAtom(valIx, fnIx) {
      if emitStrValue(body, valIx, fnIx) < 0 { return -1 }
    } else {
      const nsArmCtx = expCtxHere()
      nsArmCtx.nulString = true
      if emitExprExpect(body, valIx, fnIx, nsArmCtx) < 0 { return -1 }
    }
  } else {
    // rep 2: a `boolean | null` arm — a non-null boolean rides its i32 0/1; a bare
    // `null` lowers as the niche sentinel 2 (`nulBool`).
    const nbArmCtx = expCtxHere()
    nbArmCtx.nulBool = true
    if emitExprExpect(body, valIx, fnIx, nbArmCtx) < 0 { return -1 }
  }
  fbLocalSet(idx)
  0
}

// Emit the rep's NULL (the else-less false path / a synthesized null arm), then
// `local.set idx`: the value-union null-tagged box (rep 0), or `ref.null $aTypeIdx`
// for a `string | null` (rep 1).
function emitNulNullToLocal(_body: i32[], idx: i32, rep: i32) {
  if rep == 0 {
    fbI32Const(nullBoxTag())
    fbRefNullNone() // the payload slot is unread under the null tag
    fbStructNew(uBoxIdx)
  } else if rep == 1 {
    wU8(208) // 0xd0 ref.null
    wSLEB(aTypeIdx)
  } else {
    // rep 2: a `boolean | null` else-less / explicit-null path — the niche sentinel 2.
    fbI32Const(2)
  }
  fbLocalSet(idx)
  0
}

// One arm of a nullable if-BINDING: its prelude (`emitIfArmOpen`), then its tail value
// written into the binding's local. The binding-init counterpart of `emitBlockValueAs` —
// the arm is a Block here too, so a `const` it declares is lowered the same way.
function emitNulArmBlockToLocal(
  body: i32[],
  blockIx: i32,
  idx: i32,
  rep: i32,
  unionName: string,
  fnIx: i32,
) {
  if emitIfArmOpen(body, blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
  emitIfArmClose(
    emitNulArmToLocal(body, ifArmValueExpr(blockIx), idx, rep, unionName, fnIx),
  )
}

// Lower a nullable/value-union if-EXPRESSION binding init at `ifIx` into local `idx`:
// a void `if` whose then-arm writes the binding (narrowed by the condition), and whose
// else writes the else-arm value, a nested `else if` (recurse), or — when there is no
// else — the rep's null.
function emitNullableIfBinding(
  body: i32[],
  ifIx: i32,
  idx: i32,
  rep: i32,
  unionName: string,
  fnIx: i32,
) {
  const s = P.nodes[unwrapParen(ifIx)]
  if s is IfStmt {
    if emitExpr(body, s.ifCond, fnIx) < 0 { return -1 }
    fbIf(64) // 0x04 if, 0x40 void blocktype
    ctrlEnter() // count the frame — see `emitUnionIfValue`
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const rc = emitNulArmBlockToLocal(body, s.ifThen, idx, rep, unionName, fnIx)
    if narrowed { restoreNarrow(savedTop) }
    if rc < 0 { return -1 }
    fbElse() // 0x05 else
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    let erc = 0
    if s.ifElse < 0 {
      erc = emitNulNullToLocal(body, idx, rep)
    } else {
      const els = P.nodes[s.ifElse]
      if els is IfStmt {
        erc = emitNullableIfBinding(body, s.ifElse, idx, rep, unionName, fnIx)
      } else {
        erc = emitNulArmBlockToLocal(body, s.ifElse, idx, rep, unionName, fnIx)
      }
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if erc < 0 { return -1 }
    fbEnd() // 0x0b end
    ctrlLeave()
    return 0
  }
  emitFail("emitProgram: expected an if expression")
}

// ── the union-box BINDING SINK ────────────────────────────────────────────────
// `const u: A | B = if c { a } else { b }` in the value-union box rep, with the box built
// ONCE past the merge instead of once per arm.
//
// `emitNullableIfBinding`'s rep-0 lowering builds a box in every arm and stores it into
// the binding's slot, and pays a THIRD construction before the `if` — the slot is a
// non-null `(ref $uBox)`, which is not defaultable, and a void-`if` merge does not satisfy
// the definite-assignment check, so the rep's null box is pre-seeded and immediately
// overwritten on every path. Heap2Local scalarizes per allocation SITE, so none of the
// three can own the slot and the box survives the whole release profile.
//
// The sink writes each arm's tag and payload into the shared sink pair and performs the
// single `struct.new` after the `if`, storing it into the slot. That one `local.set`
// dominates every read of the binding, so the pre-seed is not merely redundant — it is
// unnecessary, and the shape drops from `arms + 1` sites to exactly one.
//
// Gated on `unionIfBindingAllBox`: an arm that PASSES a box through builds nothing, and
// routing it through the pair would unbox and rebuild it — trading no site for a new
// allocation on that path. `emitUnionArmToPair`'s backstop keeps such an arm correct if
// the gate is ever wrong about one, at exactly that price.

// Does every terminal arm of the union-box if-binding at `ifIx` CONSTRUCT its box? An
// `else if` chain link recurses; an else-LESS chain contributes the rep's null box, which
// is a construction like any other.
function unionIfBindingAllBox(ifIx: i32, fnIx: i32) {
  const s = P.nodes[unwrapParen(ifIx)]
  if s is IfStmt {
    if !unionIfArmBoxes(ifArmValueExpr(s.ifThen), fnIx) { return false }
    if s.ifElse < 0 { return true }
    const els = P.nodes[s.ifElse]
    if els is IfStmt { return unionIfBindingAllBox(s.ifElse, fnIx) }
    return unionIfArmBoxes(ifArmValueExpr(s.ifElse), fnIx)
  }
  false
}

// The two arm shapes whose lowering does NOT end in `struct.new $uBox`: a value that is
// ALREADY a box (`emitUnionCoerce` passes it through untouched) and a NESTED if-expression
// (`emitUnionIfValue`'s value-typed `if`, whose last instruction is the frame's `end`).
// Every other shape — a scalar atom, a `null`, an object literal, a bare variant ref, a
// map carrier — bottoms out in the box's own construction.
function unionIfArmBoxes(valIx: i32, fnIx: i32) {
  if valIx < 0 { return false }
  if exprUnion(valIx, fnIx) { return false }
  const v = P.nodes[unwrapParen(valIx)]
  if v is IfStmt { return false }
  true
}

// Emit ONE arm value into the sink pair: the arm's box, unwritten by the peephole down to
// its two operands. The BACKSTOP (an arm that did not end in a construction after all)
// stores the box it did produce into the binding's own slot and reads the pair back out of
// it — correct, and costing the rebuild after the `if` that the gate exists to avoid.
function emitUnionArmToPair(
  body: i32[],
  valIx: i32,
  idx: i32,
  unionName: string,
  fnIx: i32,
) {
  if valIx < 0 {
    return emitFail("emitProgram: if-expression arm is not a value")
  }
  if emitUnionBoxArg(body, unionName, valIx, fnIx) < 0 { return -1 }
  if uBoxNewIsLast() {
    uBoxSinkToPair()
    return 0
  }
  fbLocalSet(idx)
  fbLocalGet(idx)
  fbStructGet(uBoxIdx, 0) // field 0: tag
  fbLocalSet(unionSinkBase)
  fbLocalGet(idx)
  fbStructGet(uBoxIdx, 1) // field 1: payload (anyref)
  fbLocalSet(unionSinkBase + 1)
  0
}

// The rep's NULL into the sink pair (the else-less false path): the null tag and the
// unread payload slot, written directly rather than through a box the merge would discard.
function emitUnionNullToPair() {
  fbI32Const(nullBoxTag())
  fbLocalSet(unionSinkBase)
  fbRefNullNone() // the payload slot is unread under the null tag
  fbLocalSet(unionSinkBase + 1)
  0
}

// One arm of a union-box if-BINDING sink: its prelude (`emitIfArmOpen`), then its tail
// value written into the sink pair. The prelude precedes the arm's box construction, so
// the `uBoxNewIsLast` peephole still sees the construction as the last instruction.
function emitUnionArmBlockToPair(
  body: i32[],
  blockIx: i32,
  idx: i32,
  unionName: string,
  fnIx: i32,
) {
  if emitIfArmOpen(body, blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
  emitIfArmClose(
    emitUnionArmToPair(body, ifArmValueExpr(blockIx), idx, unionName, fnIx),
  )
}

// `emitNullableIfBinding`'s rep-0 shape with every arm writing the sink pair instead of
// the binding's slot. The caller performs the one `struct.new` after the `if`.
function emitUnionIfBindingSink(
  body: i32[],
  ifIx: i32,
  idx: i32,
  unionName: string,
  fnIx: i32,
) {
  const s = P.nodes[unwrapParen(ifIx)]
  if s is IfStmt {
    if emitExpr(body, s.ifCond, fnIx) < 0 { return -1 }
    fbIf(64) // 0x04 if, 0x40 void blocktype
    ctrlEnter() // count the frame — see `emitUnionIfValue`
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const rc = emitUnionArmBlockToPair(body, s.ifThen, idx, unionName, fnIx)
    if narrowed { restoreNarrow(savedTop) }
    if rc < 0 { return -1 }
    fbElse() // 0x05 else
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    let erc = 0
    if s.ifElse < 0 {
      erc = emitUnionNullToPair()
    } else {
      const els = P.nodes[s.ifElse]
      if els is IfStmt {
        erc = emitUnionIfBindingSink(body, s.ifElse, idx, unionName, fnIx)
      } else {
        erc = emitUnionArmBlockToPair(body, s.ifElse, idx, unionName, fnIx)
      }
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if erc < 0 { return -1 }
    fbEnd() // 0x0b end
    ctrlLeave()
    return 0
  }
  emitFail("emitProgram: expected an if expression")
}

// The expression whose REP the `emitExprAs*` widenings must classify. ASSIGNMENT is a
// value expression yielding a RE-READ of its TARGET — `emitBinExprNode`'s `=` arm stores
// through `emitAssign` and then emits the target through the normal Ident path — so
// `g = 7` leaves the CELL's rep on the stack, never the right-hand side's. Every other
// expression classifies as itself.
//
// Only the CLASSIFICATION moves: the assignment is still emitted by the caller exactly
// as before, so its right-hand side is evaluated exactly ONCE (a side-effecting `g =
// bump()` bumps once). Without this peel a widening cell in ANY value position — a tail
// `function f(): i64 { g = 7 }`, `take(g = 7)`, `let x: i64 = (g = 7)` — pushed the i64
// cell and then widened it AGAIN (`i64.extend_i32_s` over an i64), invalid wasm from two
// ordinary lines with `vl check` clean. An already-wide right-hand side (`g = h`) escaped
// because the checker types THAT assignment node i64, which the typed-IR fast path reads.
function widenClassifyExpr(exprIx: i32) {
  const wce = P.nodes[unwrapParen(exprIx)]
  if wce is BinExpr {
    if wce.binOp == "=" {
      // Only an IDENT target is a value expression here (`emitBinExprNode` rejects the
      // rest), and its rep is the target's own.
      const wct = P.nodes[wce.binLeft]
      if wct is Ident { return wce.binLeft }
    }
  }
  exprIx
}

// Emit `ix` with the three WIDE-SCALAR literal hints cleared, restoring them after —
// the one home for "this emit's width is decided HERE, not by the position above it".
//
// `pendingI64` / `pendingF32` / `pendingF64` say what a bare integer LITERAL standing in
// an i64 / f32 / f64 slot lowers as. They are a property of that ONE literal position, not
// of the expression tree around it, so any emit that produces its own width must run with
// them off. Left on, EVERY integer literal anywhere in the subtree takes the wide form
// while its own slot is still i32 — an ARRAY INDEX, an i32-keyed map KEY, a `.slice`
// bound, the i32 operand of the arithmetic that produces the wide value, the operand of a
// unary minus. `vl check` stays rc 0 and the module does not validate
// (`type mismatch: expected i32, found i64`).
//
// `emitNumIntrArg` and `emitMemIntrinArg` state the same rule for their own operands; this
// is that rule at the WIDENING boundary, which is where the seeds are set.
function emitExprWideCleared(body: i32[], ix: i32, fnIx: i32) {
  const savedI64 = pendingI64
  const savedF32 = pendingF32
  const savedF64 = pendingF64
  pendingI64 = false
  pendingF32 = false
  pendingF64 = false
  const r = emitExpr(body, ix, fnIx)
  pendingI64 = savedI64
  pendingF32 = savedF32
  pendingF64 = savedF64
  r
}

// Emit the expression at `exprIx` as an i64 value (Slice 2). A bare integer LITERAL is
// lowered directly as `i64.const` (set `pendingI64` so the NumLit path takes the 64-bit
// form). An expression that already yields i64 (`exprIsI64`) is emitted as-is; any other
// i32 source is emitted then sign-extended with `i64.extend_i32_s` (0xac). This is the
// i32→i64 widening for mixed-width operands.
//
// The LITERAL peel is checked FIRST so the other two arms can own their own width
// (`emitExprWideCleared`): a bare literal is the only shape an ambient `pendingI64` is
// about, and the check is width-identical either way — `emitNumLitNode` reaches the same
// `parseI64Pair` + `fbI64Const` pair through its own `exprIsI64` / out-of-i32-range arms.
export function emitExprAsI64(body: i32[], exprIx: i32, fnIx: i32) {
  // Peel parens to find a bare literal we can emit directly as i64.const.
  const inner = unwrapParen(exprIx)
  const innerNode = P.nodes[inner]
  if innerNode is NumLit {
    const saved = pendingI64
    pendingI64 = true
    const r = emitExpr(body, inner, fnIx)
    pendingI64 = saved
    return r
  }
  if exprIsI64(widenClassifyExpr(exprIx), fnIx) {
    return emitExprWideCleared(body, exprIx, fnIx)
  }
  // Non-literal i32: evaluate, then sign-extend to i64.
  if emitExprWideCleared(body, exprIx, fnIx) < 0 { return -1 }
  fbI64ExtendI32S()
  0
}

// Emit the expression at `exprIx` as an f64 value. If it already yields f64
// (`exprIsF64`) it is emitted as-is. Otherwise a narrower numeric source widens to f64
// at the boundary (binding / argument / return / mixed-operand):
//   f32 → f64.promote_f32 (0xbb)   i64 → f64.convert_i64_s (0xb9)
//   i32 → f64.convert_i32_s (0xb7) [also covers an integer literal]
// i32→f64 and f32→f64 are the LOSSLESS variable widenings the checker permits.
// i64→f64 (lossy above 2^53) is no longer a permitted variable widening — the
// checker rejects it — so the i64 path here only handles an i64 LITERAL coercing
// into an f64 slot (re-encoded by value). (Slice 3 + Slice 5 widening.)
export function emitExprAsF64(body: i32[], exprIx: i32, fnIx: i32) {
  // An f32 source promotes losslessly to f64. Checked BEFORE the f64 fast-path: an arithmetic
  // expression with an f32 operand (`x + 1.0`, `x: f32`) EMITS as f32 — `emitExpr`'s f32 slice fires
  // because a float literal re-encodes to the f32 operand — yet `exprIsF64` ALSO claims it via that
  // literal. Without this the f64 fast-path emits f32 into an f64 slot and traps. (A pure-f64
  // expression is not `exprIsF32`, so it still takes the byte-identical fast-path below.)
  // An ASSIGNMENT in value position classifies by its TARGET cell, not its right-hand
  // side (`widenClassifyExpr`) — the same peel all three widenings share.
  const f64Cls = widenClassifyExpr(exprIx)
  if exprIsF32(f64Cls, fnIx) {
    if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
    fbF64PromoteF32()
    return 0
  }
  if exprIsF64(f64Cls, fnIx) { return emitExpr(body, exprIx, fnIx) }
  // A bare INT literal (optionally negated) re-encodes directly as `f64.const` — exact
  // (f64.convert would produce the identical value), and it keeps a CONST-GLOBAL init a
  // valid constexpr (`const xs: f64[] = [2]` — a convert op is not constant). Checked
  // BEFORE the i64 branch so a big literal stays one `f64.const` too. Mirrors the
  // `pendingF64` NumLit lowering and `emitExprAsF32`'s literal path.
  const f64Inner = unwrapParen(exprIx)
  const f64Node = P.nodes[f64Inner]
  if f64Node is NumLit {
    if numLexIsDecimal(f64Node.numText) {
      fbF64Const(f64Node.numText)
      return 0
    }
  }
  if f64Node is Unary {
    if f64Node.unOp == "-" {
      const negInner = P.nodes[unwrapParen(f64Node.unArg)]
      if negInner is NumLit {
        if numLexIsDecimal(negInner.numText) {
          fbF64Const("-" + negInner.numText)
          return 0
        }
      }
    }
  }
  // An i64 source converts (signed) to f64.
  if exprIsI64(f64Cls, fnIx) {
    if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
    fbF64ConvertI64S()
    return 0
  }
  // Otherwise an i32 expression (or integer literal): convert (signed) to f64.
  if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
  fbF64ConvertI32S()
  0
}

// The DECIMAL TEXT of a (possibly signed) numeric literal at `exprIx`, with the sign FOLDED
// into the text — `""` when the expression is not a literal. Peels grouping parens and ANY
// NUMBER of unary minuses, which is exactly what the checker's `isFloatLitExpr` /
// `isExactF32IntLitExpr` peel when they grant a literal the f32 flow.
//
// The recursion matters. Those predicates recurse; the emitter used to handle exactly ONE
// minus, so the checker admitted a literal the emitter then failed to recognize as one and
// lowered through the f64 path instead: `const x: f32 = -(-1.5)` was `vl check`-clean
// INVALID WASM on master, and `-(-(-1.5))` with it, while the f64 twin ran. A checker that
// grants more shapes than the emitter can lower is the shape of that whole defect family,
// so the two peels are now the same peel. `f32Bytes` parses a leading `-`, so the folded
// sign costs no `f32.neg` and no lossy f64 round-trip.
//
// The iteration bound is a guard, not a semantic limit — 64 nested signs is far past any
// real source and keeps a malformed arena from spinning.
function signedNumLitText(exprIx: i32) {
  let ix = unwrapParen(exprIx)
  let neg = false
  let guard = 0
  while guard < 64 {
    const nd = P.nodes[ix]
    if nd is Unary {
      if nd.unOp != "-" { return "" }
      neg = !neg
      ix = unwrapParen(nd.unArg)
    } else if nd is NumLit {
      if neg { return "-" + nd.numText }
      return nd.numText
    } else {
      return ""
    }
    guard = guard + 1
  }
  ""
}

// Emit the expression at `exprIx` as an f32 value (Slice 5). If it already yields f32
// (`exprIsF32`) it is emitted as-is. A bare (possibly signed) numeric LITERAL — float or
// integer — is lowered directly as `f32.const`, re-encoded at single precision and never
// demoted from f64. Otherwise it is an i32 expression flowing into an f32 op: evaluate as
// i32, then convert with `f32.convert_i32_s` (0xb2). An i32 *variable* never reaches here —
// the checker rejects i32→f32 as lossy (above 2^24 the i32 would round to the nearest f32),
// so only a literal (exactness-gated by the checker) takes the direct path.
export function emitExprAsF32(body: i32[], exprIx: i32, fnIx: i32) {
  // Peel parens to find a bare (possibly negated) numeric literal — a literal lowers
  // DIRECTLY as `f32.const`, checked BEFORE the `exprIsF32` delegation. `emitExpr` lowers
  // a bare `.` literal at f64 (its default), even one the checker typed f32: a
  // context-ADOPTED f32 field literal (`objRetWidenAdopt` records f32 on the value node,
  // so `exprIsF32` is now true for it) would else delegate to `emitExpr` and emit an
  // `f64.const` into an f32 field — invalid wasm at `struct.new`.
  // A (possibly signed) numeric literal — float OR integer — lowers DIRECTLY as `f32.const`,
  // its sign folded into the text by `signedNumLitText`. Both literal kinds take the same
  // re-encode; an integer one is what `emitNumLitNode`'s `pendingF32` arm already did for
  // this class. Direct `f32.const` beats the `i32.const` + `f32.convert_i32_s` pair the
  // integer case used to emit on three counts:
  //   - it is a CONSTEXPR, so an integer literal reaches an f32 field / element of a
  //     `const` global (`const s: S = {v: 1}`, `const xs: f32[] = [1]`) — the convert
  //     pair made those "constant expression required: non-constant";
  //   - it survives past the i32 range, where `parseI32` silently WRAPPED;
  //   - it is two bytes shorter.
  // The VALUE is identical wherever the old path was correct: `f32Bytes` rounds the decimal
  // to nearest-even, which is exactly what `f32.convert_i32_s` computes.
  const litText = signedNumLitText(exprIx)
  if litText != "" {
    fbF32Const(litText)
    return 0
  }
  // An already-f32-valued expression (a variable, an f32 arithmetic / call result) emits
  // directly; only a bare numeric literal needed the direct-`f32.const` handling above.
  // An ASSIGNMENT classifies by its TARGET cell (`widenClassifyExpr`), as the i64/f64
  // widenings do. Both arms own their own width (`emitExprWideCleared`) — the literal is
  // already handled above, so an f32 seed reaching here belongs to the position that set
  // it and not to the i32 sub-positions inside this subtree.
  if exprIsF32(widenClassifyExpr(exprIx), fnIx) {
    return emitExprWideCleared(body, exprIx, fnIx)
  }
  // Non-literal i32: evaluate, then convert to f32.
  if emitExprWideCleared(body, exprIx, fnIx) < 0 { return -1 }
  fbF32ConvertI32S()
  0
}

// Lower `exprIx` in the REP of a value atom of kind `k` — the emit half of
// `valBlockTypeOfKind`'s blocktype: i64 / f64 / f32 route through their widening
// helper, every other kind (i32, boolean, and the ref atoms) through `emitExpr`.
//
// D-BLOCKTY: the four `??` / map-get residual sites each spelled this dispatch out
// beside their own copy of the blocktype ladder, on the same code, so the two halves
// of "what rep does this arm produce" now move together.
function emitExprAsKind(body: i32[], exprIx: i32, k: i32, fnIx: i32) {
  if k == 3 { return emitExprAsI64(body, exprIx, fnIx) }
  if k == 4 { return emitExprAsF64(body, exprIx, fnIx) }
  if k == 5 { return emitExprAsF32(body, exprIx, fnIx) }
  emitExpr(body, exprIx, fnIx)
}

// Emit an explicit `x as T` numeric cast (B2): lower the operand in its OWN source rep —
// through the `emitExprAs*` widening helpers, which handle the as-is fast path and literal
// re-encoding — then append the single wasm conversion opcode for the (source → target)
// pair. WIDENINGS and the same-rep no-op are exactly what those helpers already emit, so
// those directions delegate wholesale; the directions the implicit-widening path never needs
// (i64→i32 wrap, f64→f32 demote, i64→f32, and the float→int truncations) append the new
// opcodes. The float→int forms are the TRAPPING `trunc` family: a NaN or an out-of-range
// operand aborts at runtime — deliberate (VL's "traps are for bugs"). Source rep is
// classified f32-BEFORE-f64 because `exprIsF64` over-claims an f32 literal (see
// `emitExprAsF64`). By construction of `checkCastNode` `asTy` is one of i32/i64/f32/f64, so
// the four target arms below are exhaustive.
//
// The operand takes its own SOURCE width with the enclosing wide-scalar context CLEARED
// (`emitNumIntrArg`, the same discipline the numeric-intrinsic operand spine uses). A cast
// operand's width is the cast's, never the position the CAST sits in: under an `: f32`
// binding / global / return / element / store, `pendingF32` reached the operand and lowered
// `1.5` as `f32.const` — and then this function appended `f32.demote_f64` to it. `const g:
// f32 = (1.5 as f32)` was `vl check` clean INVALID WASM in 12 of 16 measured positions, and
// only the two spellings whose context happens NOT to seed `pendingF32` escaped.
function emitAsCast(body: i32[], e: AsExpr, _exprIx: i32, fnIx: i32) {
  const obj = e.asObj
  const tgt = e.asTy
  // Target f64: every source (i32/f32/i64/f64, incl. literals) is a widening or a
  // no-op the f64 helper already lowers correctly.
  if tgt == "f64" { return emitNumIntrArg(body, obj, 4, fnIx) }
  // Classify the source rep (f32 first — see the comment above).
  let src = "i32"
  if exprIsF32(obj, fnIx) { src = "f32" }
  else if exprIsI64(obj, fnIx) { src = "i64" }
  else if exprIsF64(obj, fnIx) { src = "f64" }
  if tgt == "i64" {
    // i32→i64 widening (and i64→i64 no-op) via the existing helper.
    if src == "i32" || src == "i64" {
      return emitNumIntrArg(body, obj, 3, fnIx)
    }
    // float→i64: TRAPPING truncation toward zero.
    if src == "f32" {
      if emitNumIntrArg(body, obj, 5, fnIx) < 0 { return -1 }
      fbI64TruncF32S()
      return 0
    }
    if emitNumIntrArg(body, obj, 4, fnIx) < 0 {
      return -1 // f64 → i64
    }
    fbI64TruncF64S()
    return 0
  }
  if tgt == "f32" {
    // i32→f32 (and f32→f32 no-op) via the existing helper (handles literals).
    if src == "i32" || src == "f32" {
      return emitNumIntrArg(body, obj, 5, fnIx)
    }
    if src == "i64" {
      if emitNumIntrArg(body, obj, 3, fnIx) < 0 { return -1 }
      fbF32ConvertI64S()
      return 0
    }
    if emitNumIntrArg(body, obj, 4, fnIx) < 0 {
      return -1 // f64 → f32 demote
    }
    fbF32DemoteF64()
    return 0
  }
  // tgt == "i32".
  if src == "i32" {
    return emitNumIntrArg(body, obj, 0, fnIx) // no-op (plain `emitExpr` at kind 0)
  }
  if src == "i64" {
    if emitNumIntrArg(body, obj, 3, fnIx) < 0 { return -1 }
    fbI32WrapI64()
    return 0
  }
  if src == "f32" {
    if emitNumIntrArg(body, obj, 5, fnIx) < 0 { return -1 }
    fbI32TruncF32S()
    return 0
  }
  if emitNumIntrArg(body, obj, 4, fnIx) < 0 {
    return -1 // f64 → i32 trunc
  }
  fbI32TruncF64S()
  0
}

// ── linear-memory opcodes: the load-width matrix + memory.size/grow ──────────
// The instruction bytes for `buffer-design.md` §C2's load matrix. `i32.load` (0x28)
// itself lives with the other Phase-A encoders in `emit_bytes.vl` (`fbI32Load`); the
// seven widths added here sit beside their dispatch, the same way the numeric-opcode
// family's `fbNumOp` does below.
const OP_I64_LOAD = 0x29
const OP_F32_LOAD = 0x2a
const OP_F64_LOAD = 0x2b
const OP_I32_LOAD8_S = 0x2c
const OP_I32_LOAD8_U = 0x2d
const OP_I32_LOAD16_S = 0x2e
const OP_I32_LOAD16_U = 0x2f
const OP_I64_STORE = 0x37
const OP_F32_STORE = 0x38
const OP_F64_STORE = 0x39
const OP_I32_STORE8 = 0x3a
const OP_I32_STORE16 = 0x3b
const OP_MEMORY_SIZE = 0x3f
const OP_MEMORY_GROW = 0x40

// The MISC prefix (0xfc) and the two bulk-memory sub-opcodes behind it. This is the
// emitter's FIRST 0xfc — every prefixed instruction it wrote until now was 0xfb, the
// GC prefix (`emit_bytes.GC_PREFIX`). The two prefixes are unrelated opcode spaces
// that happen to be adjacent bytes, so they get separate constants rather than one
// shared "prefix" notion.
//
// The sub-opcode is a u32 LEB immediate, not a byte — 10 and 11 both encode as a
// single byte (`0x0a` / `0x0b`) because they are below 128, which is why `wU8` is
// enough here and why that is worth saying out loud before someone adds sub-opcode
// 128 (`i32.trunc_sat_f32_s` is 0, `memory.init` 8; the space is small today).
const OP_MISC_PREFIX = 0xfc
const MISC_MEMORY_COPY = 10
const MISC_MEMORY_FILL = 11

// The opcode byte for load width `name`, or -1 for a name that is not one. Paired with
// `memLoadAlignExp` below — the two are read together at the single call site.
function memLoadOpcode(name: string) {
  if name == "__load_i8__" { return OP_I32_LOAD8_S }
  if name == "__load_u8__" { return OP_I32_LOAD8_U }
  if name == "__load_i16__" { return OP_I32_LOAD16_S }
  if name == "__load_u16__" { return OP_I32_LOAD16_U }
  if name == "__load_i64__" { return OP_I64_LOAD }
  if name == "__load_f32__" { return OP_F32_LOAD }
  if name == "__load_f64__" { return OP_F64_LOAD }
  -1
}

// The NATURAL alignment exponent for load width `name`: log2 of the access width in
// bytes (0 for 8-bit, 1 for 16-bit, 2 for 32-bit, 3 for 64-bit).
//
// This immediate is a HINT, not a constraint — the wasm spec permits an access at any
// address regardless of what the alignment says, and an engine treats a mismatch as a
// missed optimization, never a fault. `__load_i32__` has always written exponent 2 and
// reads correctly at odd addresses (measured); these widths inherit that property, and
// the corpus pins an unaligned read at every width so the claim is not just asserted.
function memLoadAlignExp(name: string) {
  if name == "__load_i8__" { return 0 }
  if name == "__load_u8__" { return 0 }
  if name == "__load_i16__" { return 1 }
  if name == "__load_u16__" { return 1 }
  if name == "__load_i64__" { return 3 }
  if name == "__load_f32__" { return 2 }
  if name == "__load_f64__" { return 3 }
  -1
}

// One memarg-carrying memory instruction: `<opcode> <align-exp> <offset>`. Offset 0
// always — VL spells the address as an ordinary expression, so the static offset
// immediate has nothing to carry. Loads and stores share this encoding exactly; they
// differ only in their stack effect, which the caller has already arranged.
function fbMemAccess(op: i32, alignExp: i32) {
  wU8(op)
  wU8(alignExp)
  wU8(0) // static offset 0 (the address is the stack operand)
  0
}

// The opcode byte for store width `name`, or -1 for a name that is not one. The wide
// trio are the exact duals of `memLoadOpcode`'s, and the narrow pair are the duals of
// its four narrow loads COLLAPSED — `i32.store8` is the single instruction that both
// `i32.load8_s` and `i32.load8_u` read back, because a store has no signedness. All
// five share the memarg encoding a load uses; a store differs only in taking a second
// (VALUE) stack operand and leaving nothing.
function memStoreOpcode(name: string) {
  if name == "__store_i64__" { return OP_I64_STORE }
  if name == "__store_f32__" { return OP_F32_STORE }
  if name == "__store_f64__" { return OP_F64_STORE }
  if name == "__store_i8__" { return OP_I32_STORE8 }
  if name == "__store_i16__" { return OP_I32_STORE16 }
  -1
}

// The NATURAL alignment exponent for store width `name` — log2 of the access width in
// bytes, the same hint-not-constraint immediate `memLoadAlignExp` documents. i64 and
// f64 write 8 bytes (3); f32 writes 4 (2), matching `__store_i32__`'s long-standing 2;
// the narrow pair write 1 byte (0) and 2 bytes (1), matching their load twins.
function memStoreAlignExp(name: string) {
  if name == "__store_i64__" { return 3 }
  if name == "__store_f32__" { return 2 }
  if name == "__store_f64__" { return 3 }
  if name == "__store_i8__" { return 0 }
  if name == "__store_i16__" { return 1 }
  -1
}

// The two NARROW store widths, whose VALUE operand is an i32 rather than the declared
// wide scalar the other three take. Split out so the arm's value-emit dispatch reads as
// a two-way choice over a total predicate instead of an `else` that silently means f64
// — the shape that would turn a name added to `nameIsMemStoreIntrinsic` and forgotten
// here into an f64 operand under an i32 opcode, i.e. an invalid module.
function memStoreValueIsI32(name: string) {
  if name == "__store_i8__" { return true }
  if name == "__store_i16__" { return true }
  false
}

// One bulk-memory instruction: the 0xfc prefix, the sub-opcode, then ONE memory index
// immediate per memory the instruction names — `memory.fill` names one (its
// destination), `memory.copy` names two (destination FIRST, then source). Both are 0:
// VL emits a single memory and multi-memory is not proposed (§C3).
//
// The operand order the caller must already have arranged on the stack is the
// instruction's, and it is NOT the same shape as the memarg ops above:
//   memory.copy  d s n   — destination address, source address, byte count
//   memory.fill  d val n — destination address, fill byte, byte count
// `n` is unsigned in both, so a negative VL length is ~4 GiB and traps in the engine.
function fbMemBulk(sub: i32, memIndexCount: i32) {
  wU8(OP_MISC_PREFIX) // 0xfc misc prefix
  wU8(sub)            // the sub-opcode (a u32 LEB; 10 and 11 are one byte each)
  let mi = 0
  while mi < memIndexCount {
    wU8(0) // memory index 0
    mi = mi + 1
  }
  0
}

// `memory.size` → 0x3f 0x00 and `memory.grow` → 0x40 0x00. The trailing byte is the
// memory INDEX immediate, not a flags byte: there is one memory, so it is 0.
function fbMemorySize() {
  wU8(OP_MEMORY_SIZE)
  wU8(0) // memory index 0
  0
}
function fbMemoryGrow() {
  wU8(OP_MEMORY_GROW)
  wU8(0) // memory index 0
  0
}

// ── numeric-opcode intrinsics ────────────────────────────────────────────────
// The IEEE bitcasts. A bitcast moves no bits: the same 32/64-bit pattern is simply
// read at the other type, which is what makes float state hashable, a NaN payload
// canonicalizable, and bit-level range reduction expressible. Each is exactly one
// wasm instruction, so there is no import, no runtime, and nothing for the linker.
const OP_I32_REINTERPRET_F32 = 0xbc
const OP_I64_REINTERPRET_F64 = 0xbd
const OP_F32_REINTERPRET_I32 = 0xbe
const OP_F64_REINTERPRET_I64 = 0xbf
// `emitBitcastIntr`'s "this name is not an intrinsic" answer, distinct from its
// success (0) and its failure (-1) — the caller falls through to its own error.
const NUM_INTR_NONE = -2

// One single-BYTE numeric instruction: the whole encoding IS the opcode byte (no
// immediates), so writing the byte writes the instruction.
function fbNumOp(op: i32) {
  wU8(op)
  0
}

// One operand of a NUMERIC-OPCODE intrinsic, emitted at the width the OPERATION
// declares (`k`: the `emitExprAsKind` codes — 0 i32, 3 i64, 4 f64, 5 f32) with the
// ENCLOSING wide-scalar context cleared. The i32-by-declaration twin of
// `emitMemIntrinArg`, generalized to all four widths because these operands are not
// all i32: an operand's width comes from the intrinsic's own signature (`f32fromBits`
// takes an i32, `f64fromBits` an i64, `sqrt` its operands' float width), never from
// the position the CALL sits in — the same rule a call ARGUMENT already obeys
// (`f32-context-call-argument.vl`) and for the same reason.
//
// Measured on the parent commit over a 19-context x 22-expression matrix: 197 of 418
// cells emitted `type mismatch: expected i32/f64, found f32` with `vl check` clean.
// Every f32-seeding context (`: f32` binding/global/return/tail/param, `f32[]` push /
// element assign, `__store_f32__`, a union f32 atom, an inferred f32 local, a nested
// block) crossed with every intrinsic whose operand is NOT the enclosing f32: the
// bitcast pair `f32fromBits(1065353216)`, the integer ops under an `as f32`
// (`clz`/`popcnt`/`rotl`/`divU`), and the float ops at f64 width (`nearest(2.5)`).
// `pendingF32` is read FIRST in `emitNumLitNode`, so it beat both the i64 and the f64
// literal forms and every literal in reach lowered as `f32.const`.
//
// The flags are CLEARED, not re-seeded per width: `emitExprAsF32`/`AsF64`/`AsI64`
// already lower a top-level literal at their own width, and the f32 arm's `pendingF32
// = true` seed that the `__store_f32__` / f32-param boundaries carry buys nothing
// here (a literal nested deeper than the operand root is `exprIsF32`-invisible either
// way, so those cells stay exactly as they were).
function emitNumIntrArg(body: i32[], ix: i32, k: i32, fnIx: i32) {
  const savedF32 = pendingF32
  const savedF64 = pendingF64
  const savedI64 = pendingI64
  pendingF32 = false
  pendingF64 = false
  pendingI64 = false
  const r = emitExprAsKind(body, ix, k, fnIx)
  pendingF32 = savedF32
  pendingF64 = savedF64
  pendingI64 = savedI64
  r
}

// Lower `f32bits` / `f64bits` / `f32fromBits` / `f64fromBits`: push the argument at
// the source type, then the one reinterpret instruction. Returns `NUM_INTR_NONE` when
// `name` is not one of them. The argument rides the coercing emitters, so an i32 in
// f64 position converts exactly as it would at any other f64 boundary — the CAST is
// ordinary, only the reinterpretation is not. The width is the BITCAST's own, so the
// operand takes `emitNumIntrArg` (the enclosing wide-scalar context cleared): a
// `f32fromBits(1065353216)` under any f32 context otherwise lowered its i32 argument
// as `f32.const` and handed `f32.reinterpret_i32` an f32.
function emitBitcastIntr(body: i32[], callIx: i32, fnIx: i32, name: string) {
  if (
    name != "f32bits" &&
    name != "f64bits" &&
    name != "f32fromBits" &&
    name != "f64fromBits"
  ) {
    return NUM_INTR_NONE
  }
  const c = P.nodes[callIx]
  if c is Call {
    if c.callArgs.length != 1 {
      return emitFail("emitProgram: " + name + " takes exactly one argument")
    }
    const arg = c.callArgs[0]
    if name == "f32bits" {
      if emitNumIntrArg(body, arg, 5, fnIx) < 0 { return -1 }
      return fbNumOp(OP_I32_REINTERPRET_F32) // 0xbc i32.reinterpret_f32
    }
    if name == "f64bits" {
      if emitNumIntrArg(body, arg, 4, fnIx) < 0 { return -1 }
      return fbNumOp(OP_I64_REINTERPRET_F64) // 0xbd i64.reinterpret_f64
    }
    if name == "f32fromBits" {
      if emitNumIntrArg(body, arg, 0, fnIx) < 0 { return -1 }
      return fbNumOp(OP_F32_REINTERPRET_I32) // 0xbe f32.reinterpret_i32
    }
    if emitNumIntrArg(body, arg, 3, fnIx) < 0 { return -1 }
    return fbNumOp(OP_F64_REINTERPRET_I64) // 0xbf f64.reinterpret_i64
  }
  NUM_INTR_NONE
}

// The f32 instruction for the float intrinsic `name`, or -1 when it is not one.
//   abs 0x8b · ceil 0x8d · floor 0x8e · trunc 0x8f · nearest 0x90 · sqrt 0x91
//   min 0x96 · max 0x97 · copysign 0x98
function floatIntrOpF32(name: string) {
  if name == "abs" { return 0x8b }
  if name == "ceil" { return 0x8d }
  if name == "floor" { return 0x8e }
  if name == "trunc" { return 0x8f }
  if name == "nearest" { return 0x90 }
  if name == "sqrt" { return 0x91 }
  if name == "min" { return 0x96 }
  if name == "max" { return 0x97 }
  if name == "copysign" { return 0x98 }
  -1
}

// The f64 instruction for the float intrinsic `name`, or -1 when it is not one — the
// f32 table shifted up by one block, exactly as the arithmetic opcodes are.
//   abs 0x99 · ceil 0x9b · floor 0x9c · trunc 0x9d · nearest 0x9e · sqrt 0x9f
//   min 0xa4 · max 0xa5 · copysign 0xa6
function floatIntrOpF64(name: string) {
  if name == "abs" { return 0x99 }
  if name == "ceil" { return 0x9b }
  if name == "floor" { return 0x9c }
  if name == "trunc" { return 0x9d }
  if name == "nearest" { return 0x9e }
  if name == "sqrt" { return 0x9f }
  if name == "min" { return 0xa4 }
  if name == "max" { return 0xa5 }
  if name == "copysign" { return 0xa6 }
  -1
}

// The i32 instruction for the integer intrinsic `name`, or -1 when it is not one.
//   clz 0x67 · ctz 0x68 · popcnt 0x69 · div_u 0x6e · rem_u 0x70 · rotl 0x77 · rotr 0x78
//   lt_u 0x49 · gt_u 0x4b · le_u 0x4d · ge_u 0x4f
function intIntrOpI32(name: string) {
  if name == "clz" { return 0x67 }
  if name == "ctz" { return 0x68 }
  if name == "popcnt" { return 0x69 }
  if name == "divU" { return 0x6e }
  if name == "remU" { return 0x70 }
  if name == "rotl" { return 0x77 }
  if name == "rotr" { return 0x78 }
  if name == "ltU" { return 0x49 }
  if name == "gtU" { return 0x4b }
  if name == "leU" { return 0x4d }
  if name == "geU" { return 0x4f }
  -1
}

// The i64 instruction for the integer intrinsic `name`, or -1 when it is not one.
//   clz 0x79 · ctz 0x7a · popcnt 0x7b · div_u 0x80 · rem_u 0x82 · rotl 0x89 · rotr 0x8a
//   lt_u 0x54 · gt_u 0x56 · le_u 0x58 · ge_u 0x5a
function intIntrOpI64(name: string) {
  if name == "clz" { return 0x79 }
  if name == "ctz" { return 0x7a }
  if name == "popcnt" { return 0x7b }
  if name == "divU" { return 0x80 }
  if name == "remU" { return 0x82 }
  if name == "rotl" { return 0x89 }
  if name == "rotr" { return 0x8a }
  if name == "ltU" { return 0x54 }
  if name == "gtU" { return 0x56 }
  if name == "leU" { return 0x58 }
  if name == "geU" { return 0x5a }
  -1
}

// Lower a FLOAT intrinsic (`sqrt`, `min`, `copysign`, …): push every argument at the
// operation's width, then the one instruction. The width rule is the binary operators'
// — f32 when an operand is f32 and neither side is a genuine (non-literal) f64 — so
// `min(x, 0.5)` over an f32 `x` computes in f32 exactly as `x * 0.5` does.
function emitFloatIntr(body: i32[], callIx: i32, fnIx: i32, name: string) {
  const opF32 = floatIntrOpF32(name)
  if opF32 < 0 { return NUM_INTR_NONE }
  const c = P.nodes[callIx]
  if c is Call {
    const args = c.callArgs
    if args.length == 0 {
      return emitFail("emitProgram: " + name + " takes at least one argument")
    }
    let anyF32 = false
    let i = 0
    while i < args.length {
      if exprIsF32(args[i], fnIx) { anyF32 = true }
      i = i + 1
    }
    // `binMixHardF64` over the first and last argument IS the operators' rule: true when
    // either side is a genuine (non-literal) f64. A one-argument intrinsic passes its one
    // operand as both sides, which asks the same question of it.
    const hardF64 = binMixHardF64(args[0], args[args.length - 1], fnIx)
    const useF32 = anyF32 && !hardF64
    // The chosen width is the OPERATION's, so each operand takes it with the enclosing
    // wide-scalar context cleared (`emitNumIntrArg`). The f64 arm is the one that
    // needed it: `nearest(2.5)` under an f32 context lowered `2.5` as `f32.const` and
    // handed `f64.nearest` an f32.
    let fiK = 4
    if useF32 { fiK = 5 }
    let j = 0
    while j < args.length {
      if emitNumIntrArg(body, args[j], fiK, fnIx) < 0 { return -1 }
      j = j + 1
    }
    if useF32 { return fbNumOp(opF32) }
    return fbNumOp(floatIntrOpF64(name))
  }
  NUM_INTR_NONE
}

// Lower an INTEGER intrinsic (`clz`, `rotl`, `divU`, `ltU`, …): push every argument at
// the operation's width, then the one instruction. i64 when an operand is i64 (the i32
// side sign-extends), else i32 — the selection the i64 binary operators use.
function emitIntIntr(body: i32[], callIx: i32, fnIx: i32, name: string) {
  const opI32 = intIntrOpI32(name)
  if opI32 < 0 { return NUM_INTR_NONE }
  const c = P.nodes[callIx]
  if c is Call {
    const args = c.callArgs
    let useI64 = false
    let i = 0
    while i < args.length {
      if exprIsI64(args[i], fnIx) { useI64 = true }
      i = i + 1
    }
    // The chosen width is the OPERATION's — an i32 op's operand is an i32 whatever the
    // enclosing position wants — so each one takes `emitNumIntrArg`. Without it
    // `clz(1) as f32` lowered the `1` as `f32.const` into `i32.clz`.
    let iiK = 0
    if useI64 { iiK = 3 }
    let j = 0
    while j < args.length {
      if emitNumIntrArg(body, args[j], iiK, fnIx) < 0 { return -1 }
      j = j + 1
    }
    if useI64 { return fbNumOp(intIntrOpI64(name)) }
    return fbNumOp(opI32)
  }
  NUM_INTR_NONE
}

// One operand of a LINEAR-MEMORY intrinsic, emitted with every WIDE-SCALAR context
// flag CLEARED — the same discipline (and the same reason) as the function-value argument
// spine in `emitCallRef` and the index-receiver arms in the `Index` lowering.
//
// Every operand ROUTED HERE is an i32 BY DECLARATION (`typecheck.vl`'s default scope:
// `__store_i32__(i32,i32)`, `__load_*__(i32)`, `__memory_grow__(i32)`, `__log__(i32,i32)`)
// — a byte address, a stored i32 word, a page count, a fill byte, a bulk length — so no
// wide scalar an ENCLOSING position wants may reach it. The three WIDE stores' second
// operand is the ONLY memory-intrinsic operand that is not an i32; it takes its declared
// width through `emitExprAsI64`/`emitExprAsF32`/`emitExprAsF64`, and only its ADDRESS
// comes here. The two NARROW stores are back on this side of the line: `i32.store8`
// truncates an ordinary i32, so its value is routed here like every other operand.
// `emitLetDeclStmt`'s `letIsF32` arm and `emitReturnValue`'s f32 arm seed `pendingF32`
// across the WHOLE init/result subtree, so an address literal lowered as `f32.const` —
// `f32.const 0` then `f32.load`, an UNPARSEABLE MODULE with `vl check` clean.
//
// Measured on the parent commit over a position matrix: 9 of 11 f32 positions
// (`const q: f32 = __load_f32__(0)` annotated and inferred, module and function scope, an
// `f32` return, an `f32` argument, and anything nested in them) and 1 of 4 i64 positions (an
// `i64` ARGUMENT) emit `type mismatch: expected i32, found f32/i64`. f64 escaped only by
// accident of routing: its `letIsF64`/return arms call `emitExprAsF64` and never seed a flag.
//
// The array intrinsics are deliberately NOT routed here — `__array_new__(n, fill)`'s
// FILL operand takes the element's own valtype, so clearing the context there would
// break an f64/i64 fill. Their address-free operands have their own coercion.
function emitMemIntrinArg(body: i32[], ix: i32, fnIx: i32) {
  emitExprWideCleared(body, ix, fnIx)
}

// Node shapes read: Call { callFn: i32, callArgs: i32[] }, callee Ident { identName }.
function emitCall(body: i32[], callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Ident {
      // `toString(x)` is a compiler builtin: an i32 renders its decimal digits, a
      // BOOLEAN-classified argument the literal text "true"/"false" — both as a fresh
      // string (array of code points). This and the builtin arms below are matched
      // BEFORE the `fnIndexOf` lookup, which would fail ("unknown function").
      if callee.identName == "toString" {
        return emitToString(body, callIx, fnIx)
      }
      // `fromCodePoints(xs)` (H2): bulk string construction — ONE array.copy of
      // the list's live elements into an exact-length string array, instead of
      // per-char concat (quadratic churn). Uses the string-op scratch frame
      // (I0 = len, Out = the result) — `exprHasStrOp` reserves it. The list is
      // re-read per use, so the argument must be a NAME (param/local/global);
      // an arbitrary expression would need a list-typed temp slot.
      if callee.identName == "fromCodePoints" {
        if !aUsed || !lUsed {
          return emitFail(
            "emitProgram: fromCodePoints but array/list types not collected",
          )
        }
        if c.callArgs.length != 1 {
          return emitFail(
            "emitProgram: fromCodePoints takes exactly one argument",
          )
        }
        let fcpArg = c.callArgs[0]
        const fcpN0 = P.nodes[fcpArg]
        if fcpN0 is Paren { fcpArg = fcpN0.parInner }
        const fcpNode = P.nodes[fcpArg]
        if fcpNode is Ident {
          // I0 = xs.len
          if emitExpr(body, fcpArg, fnIx) < 0 { return -1 }
          fbStructGet(lTypeIdx, 1)
          setStrScrI(body, 0)
          // Out = array.new_default(I0)
          pushStrScrI(body, 0)
          fbArrayNewDefault(aTypeIdx)
          fbLocalSet(strScratchBase + 2)
          // array.copy Out 0 xs.backing 0 I0
          pushStrScrRef(body, 2)
          fbI32Const(0)
          if emitExpr(body, fcpArg, fnIx) < 0 { return -1 }
          fbStructGet(lTypeIdx, 0)
          fbI32Const(0)
          pushStrScrI(body, 0)
          fbArrayCopy(aTypeIdx, aTypeIdx)
          pushStrScrRef(body, 2)
          return 0
        }
        return emitFail(
          "emitProgram: fromCodePoints argument must be a named i32[] binding",
        )
      }
      // `fromCodePoint(code)` is a compiler builtin (H2): construct a single-character VL
      // string from an i32 code point. A VL string IS the shared `(array i32)` of code
      // points (`aTypeIdx`), so this is a length-1 array — push the one i32 arg, then
      // `array.new_fixed $aTypeIdx 1`. Mirrors toWasm's `fromCodePoint` lowering.
      if callee.identName == "fromCodePoint" {
        if !aUsed {
          return emitFail(
            "emitProgram: fromCodePoint but array type not collected",
          )
        }
        if c.callArgs.length != 1 {
          return emitFail(
            "emitProgram: fromCodePoint takes exactly one argument",
          )
        }
        if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
        fbArrayNewFixed(aTypeIdx, 1) // 0xfb 0x08 <typeidx> 1; type shared with i32[]
        return 0
      }
      // `print(x)` is a compiler builtin lowered to the host's import family:
      // a BOOLEAN-classified arg calls `__print_bool__` (import 1, renders
      // true/false), anything else i32-ish calls `__print_i32__` (import 0).
      // Strings are a later slice. The call yields NOTHING (void import) — the
      // statement path knows not to drop.
      if callee.identName == "print" {
        if c.callArgs.length != 1 {
          return emitFail("emitProgram: print takes exactly one argument")
        }
        // print(literal-union ATOM): WIDEN it to its member STRING — a per-member `if id == <id> { print
        // "<name>" }` chain (exactly one matches, so at most one prints). The atom→string widening in
        // statement form; the value form (concat / string arg / return) is a follow-up.
        //
        // Asked BEFORE `exprString`, and that ORDER is the fix for a live miscompile: for an
        // atom-repped GLOBAL (`const e: K | null`, or a narrowed `"a" | "b" | null`) `exprString`
        // also answers true — it reads the SOFTENED render, which says `string` about a cell the
        // emitter laid out as `(mut i32)` — so the string printer was handed a raw atom id and the
        // module failed to parse as WebAssembly. The two classifiers disagree only where the value
        // IS an atom, and there the atom answer is the REP; `exprString` is a rendering.
        if exprIsLitAtom(c.callArgs[0], fnIx) {
          // An UN-NARROWED `K | null` niche is the SAME i32 with `-1` for null, so it prints its
          // member OR the word `null` — exactly what the two niches beside it do
          // (`emitPrintNulString`, `emitPrintNulBool`). Asked FIRST: the expanded spelling
          // (`type K = "a" | "b" | null`) satisfies the member-only query below as well, and only
          // this one emits the sentinel arm.
          const lpNul = nodeNulLitUnionMemberTexts(c.callArgs[0])
          if lpNul.length > 0 {
            return emitPrintNulLitUnion(body, c.callArgs[0], lpNul, fnIx)
          }
          const lpTexts = nodeLitUnionMemberTexts(c.callArgs[0])
          // `exprIsLitAtom` claims a value whose REP is the atom; the member texts come from the
          // recorded TYPE. A claim with no texts on either query means the two disagree, and the
          // chain would match nothing: rc=0 and NO OUTPUT, the quietest possible wrong answer.
          if lpTexts.length == 0 {
            return emitFail(
              "emitProgram: print of a literal-union atom whose type carries no member texts",
            )
          }
          const lpRc = emitPrintAtomStr(body, c.callArgs[0], lpTexts, fnIx)
          return lpRc
        }
        // A NULLABLE-string value (`string | null` — a niche binding, a `(string|null)[]`
        // element, a fused read over a `{[string]: string | null}` map, which PRESERVES a
        // stored null) may genuinely hold null, and it prints `null` when it does.
        //
        // Asked BEFORE `exprString`, on the ordering argument the literal-atom arm above
        // states in full: `exprString` ALSO claims this value (the softened render says
        // `string` about a cell whose rep is `(ref null $a)`), so master streamed a
        // possibly-null ref straight into `array.len` — a runtime `wasm trap: null
        // reference` with `vl check` clean.
        //
        // FILED, NOT FIXED (found 2026-07-27 by sweeping the map axis, verified on
        // `63a73d7`). `exprString` claiming this value is exactly what RESERVES the
        // scratch frame the arm below writes into — and where it does NOT claim it, the
        // frame is absent and this arm emits INVALID WASM with `vl check` rc 0:
        //
        //     const m: {[string]: string} = Map()
        //     m["k"] = "a"
        //     print(m["k"])          // "type mismatch: expected (ref $type), found (ref $type)"
        //
        // The reservation scan is `exprHasStrOp`'s `print` arm (`emit_classify.vl`), which
        // asks `exprString(arg)` and `exprIsLitAtom(arg)`. This handler asks
        // `exprNullableString` FIRST and that predicate is strictly WIDER — a fused map
        // read over a `{[string]: string}` (or `{[string]: string | null}`) map is claimed
        // here and not there. `emitPrintNulString` then `local.set`s the recovered ref into
        // `strScratchBase + 0`, which without the reservation is not the string scratch at
        // all: disassembled, the failing module writes a `(ref $strArray)` into local 0,
        // declared `(ref $mapStruct)`.
        //
        // THE PROBE IS DECISIVE, not circumstantial: adding ONE unrelated string op to the
        // same function (`print("x" + "y")` before it) reserves the frame and the identical
        // print then runs — `a` for a hit, `null` for a miss, at module scope and inside a
        // function. Nothing about the lowering here is wrong; only the frame was missing.
        // Binding first (`const v: string | null = m["k"]; print(v)`) also runs, because a
        // niche BINDING is claimed by `exprString` and does reserve.
        //
        // The one-line fix is `exprHasStrOp`'s print arm gaining `exprNullableString`
        // beside its `exprString` — the two ends of one decision, currently spelled with
        // two different predicates — in `emit_classify.vl`, outside this partition. The
        // i32/f64-valued map twins are CLEAN CHECKER REJECTS ("print of a union value
        // (i32?) is type-valid but not yet supported by codegen"), so the string leaf is
        // the only one that reaches emit at all, which is why this hid.
        if exprNullableString(c.callArgs[0], fnIx) {
          return emitPrintNulString(body, c.callArgs[0], fnIx)
        }
        // The other NICHE: `boolean | null`, an i32 with the null SENTINEL 2. The fallback
        // ladder ends in `__print_bool__`, which renders any non-zero as `true` — so a null
        // printed **true**, silently.
        if exprNulBool(c.callArgs[0], fnIx) {
          return emitPrintNulBool(body, c.callArgs[0], fnIx)
        }
        if exprString(c.callArgs[0], fnIx) {
          return emitPrintStrExpr(body, c.callArgs[0], fnIx)
        }
        // An i64-typed argument lowers to `i64.const`/`local.get` of an i64 slot, so it
        // must route to `__print_i64__` (import 4) — its functype is `(i64)->()`, so the
        // i32/bool imports would fail to typecheck the call. Checked before bool/i32.
        // An f64 argument routes to `__print_f64__` (import `gF64PrintIdx`, a `(f64)->()`
        // functype) — checked first since a float literal/operand is never i64/bool/i32.
        // An f32 argument routes to `__print_f32__` (import `gF32PrintIdx`, a `(f32)->()`
        // functype) — checked BEFORE f64 since an f32 expression (`x`, `x + 4.0`) is
        // `exprIsF32`, and a mixed f32/float-literal expression must print as f32.
        const argF32 = exprIsF32(c.callArgs[0], fnIx)
        const argI64 = exprIsI64(c.callArgs[0], fnIx)
        const argF64 = exprIsF64(c.callArgs[0], fnIx)
        if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
        if argF32 {
          fbCall(gF32PrintIdx) // 0x10 call __print_f32__
        } else if argF64 {
          fbCall(gF64PrintIdx) // 0x10 call __print_f64__
        } else if argI64 {
          fbCall(4) // 0x10 call __print_i64__ (import index 4)
        } else if exprIsBool(c.callArgs[0], fnIx) {
          fbCall(1) // 0x10 call __print_bool__ (import index 1)
        } else {
          fbCall(0) // 0x10 call __print_i32__ (import index 0)
        }
        return 0
      }
      // The linear-memory intrinsics, lowered INLINE (the host defines `__store_i32__`/
      // `__load_i32__` as one-instruction wasm functions — same instruction, no call):
      // store → `i32.store`, load → `i32.load`, `__log__` → call the synthetic
      // in-module decoder at `gMemLogIdx` (the host imports `__log__` instead; the
      // native runner provides no such import — see `emitMemLogFnCode`).
      if callee.identName == "__store_i32__" {
        if c.callArgs.length != 2 {
          return emitFail(
            "emitProgram: __store_i32__ takes exactly two arguments",
          )
        }
        if emitMemIntrinArg(body, c.callArgs[0], fnIx) < 0 { return -1 }
        if emitMemIntrinArg(body, c.callArgs[1], fnIx) < 0 { return -1 }
        fbI32Store()
        return 0
      }
      if callee.identName == "__load_i32__" {
        if c.callArgs.length != 1 {
          return emitFail(
            "emitProgram: __load_i32__ takes exactly one argument",
          )
        }
        if emitMemIntrinArg(body, c.callArgs[0], fnIx) < 0 { return -1 }
        fbI32Load()
        return 0
      }
      // The five other store widths (`buffer-design.md` §C2, §H9 item 3) — the three
      // WIDE ones, duals of the three wide loads, and the two NARROW ones that complete
      // the matrix. One arm, because the shape is identical for all five: push the
      // ADDRESS (an i32 in all fourteen ops, so it takes the same context-clearing spine
      // as every other memory-intrinsic operand), push the VALUE at the width the
      // DECLARATION names, then the opcode with its natural alignment.
      //
      // The value is the one memory-intrinsic operand that is not an i32, so it must NOT go
      // through `emitMemIntrinArg`: `__store_f64__(0, 1.5)` needs `f64.const 1.5`, and an
      // i32-context emit would write `i32.const 1` (or reject). The `emitExprAs*` helpers
      // are the ones the binding / argument / return boundaries use, so an integer literal
      // re-encodes at i64, a float literal at f32/f64, and a narrower VARIABLE widens exactly
      // where the checker permits it. The f32 arm additionally seeds `pendingF32` across the
      // value subtree, as every other f32 coercion boundary does (see `emitMemIntrinArg`):
      // without it a float literal nested in the value expression lowers at f64 and the
      // store's operand is the wrong width.
      if nameIsMemStoreIntrinsic(callee.identName) {
        if c.callArgs.length != 2 {
          return emitFail(
            "emitProgram: " +
              callee.identName +
              " takes exactly two arguments (the byte address and the value)",
          )
        }
        if emitMemIntrinArg(body, c.callArgs[0], fnIx) < 0 { return -1 }
        if memStoreValueIsI32(callee.identName) {
          // `i32.store8` / `i32.store16` take an ordinary i32 and TRUNCATE it, so the
          // value goes through the same spine as the address and as `__store_i32__`'s
          // own value — no widening helper, and no `pendingF32` seed to save.
          if emitMemIntrinArg(body, c.callArgs[1], fnIx) < 0 { return -1 }
        } else if callee.identName == "__store_i64__" {
          if emitExprAsI64(body, c.callArgs[1], fnIx) < 0 { return -1 }
        } else if callee.identName == "__store_f32__" {
          const savedStF32 = pendingF32
          pendingF32 = true
          const stRc = emitExprAsF32(body, c.callArgs[1], fnIx)
          pendingF32 = savedStF32
          if stRc < 0 { return -1 }
        } else {
          if emitExprAsF64(body, c.callArgs[1], fnIx) < 0 { return -1 }
        }
        // The same drift guard the load arm carries, for the same reason: the name list
        // and the two tables are THREE lists over the same names in two files, and a
        // width added to one and not the others would reach here with -1 and write it as
        // an opcode byte — a silently invalid module. Unreachable while they agree.
        const msOp = memStoreOpcode(callee.identName)
        const msAlign = memStoreAlignExp(callee.identName)
        if msOp < 0 || msAlign < 0 {
          return emitFail(
            "emitProgram: '" +
              callee.identName +
              "' is a declared store width with no opcode — the intrinsic-name list and the opcode table have drifted",
          )
        }
        fbMemAccess(msOp, msAlign)
        return 0
      }
      // THE BULK PAIR (`buffer-design.md` §C3). One arm for both, because the shape is
      // identical: three i32 operands pushed in the instruction's own order, then the
      // prefixed opcode. Every operand is an i32 BY DECLARATION, so all three take the
      // same context-clearing `emitMemIntrinArg` spine the addresses take — there is no
      // width dispatch here at all, which is the whole difference from the store arm.
      //
      // The operand ORDER is the instruction's, and VL's argument order was chosen to
      // match it exactly so this arm is a straight walk: `__memory_copy__(dst, src, len)`
      // is `memory.copy d s n`, and `__memory_fill__(dst, byte, len)` is
      // `memory.fill d val n`. Had the VL spelling put `len` first, this arm would have
      // to reorder the operand emissions, which for arbitrary expressions means
      // reordering their SIDE EFFECTS — so the order is a signature decision, not a
      // formatting one.
      if nameIsMemBulkIntrinsic(callee.identName) {
        if c.callArgs.length != 3 {
          return emitFail(
            "emitProgram: " +
              callee.identName +
              " takes exactly three arguments (the byte count is the last)",
          )
        }
        if emitMemIntrinArg(body, c.callArgs[0], fnIx) < 0 { return -1 }
        if emitMemIntrinArg(body, c.callArgs[1], fnIx) < 0 { return -1 }
        if emitMemIntrinArg(body, c.callArgs[2], fnIx) < 0 { return -1 }
        if callee.identName == "__memory_copy__" {
          // Two memory indices: destination first, then source.
          fbMemBulk(MISC_MEMORY_COPY, 2)
        } else {
          fbMemBulk(MISC_MEMORY_FILL, 1)
        }
        return 0
      }
      // The seven OTHER load widths (`buffer-design.md` §C2). One arm, because the
      // shape is identical for all of them — push the address, write the opcode with
      // its natural alignment — and the per-width difference is exactly two bytes,
      // which `memLoadOpcode`/`memLoadAlignExp` hold. `__load_i32__` keeps its own arm
      // above so its bytes stay provably untouched by this change.
      if nameIsMemLoadIntrinsic(callee.identName) {
        if c.callArgs.length != 1 {
          return emitFail(
            "emitProgram: " +
              callee.identName +
              " takes exactly one argument (the byte address)",
          )
        }
        if emitMemIntrinArg(body, c.callArgs[0], fnIx) < 0 { return -1 }
        // The guard above and the two tables below are THREE lists keyed by the same
        // names, in two files. They agree today; a fourth width added to one and not
        // the others would reach here with -1 and write it as an opcode byte — a
        // silently invalid module, which is the worst failure this codebase
        // recognizes. Fail loudly instead, the same discipline `fbValtype`'s callers
        // follow. Unreachable while the lists agree, and free when they do.
        const mlOp = memLoadOpcode(callee.identName)
        const mlAlign = memLoadAlignExp(callee.identName)
        if mlOp < 0 || mlAlign < 0 {
          return emitFail(
            "emitProgram: '" +
              callee.identName +
              "' is a declared load width with no opcode — the intrinsic-name list and the opcode table have drifted",
          )
        }
        fbMemAccess(mlOp, mlAlign)
        return 0
      }
      // `memory.size` / `memory.grow` — the two ops that lift the 64 KiB ceiling
      // (`buffer-design.md` §B2/§S4). Both take the memory index as an IMMEDIATE
      // (0x00, the one memory), not as a stack operand:
      //   memory.size          → 0x3f 0x00   ()      -> i32   pages currently mapped
      //   memory.grow <pages>  → 0x40 0x00   (i32)   -> i32   the PREVIOUS page count,
      //                                                       or -1 if the grow failed
      // The -1 is the wasm spec's failure signal and is passed through unchanged: VL
      // does not translate it, so a caller checks it exactly as the spec describes.
      if callee.identName == "__memory_size__" {
        if c.callArgs.length != 0 {
          return emitFail("emitProgram: __memory_size__ takes no arguments")
        }
        fbMemorySize()
        return 0
      }
      if callee.identName == "__memory_grow__" {
        if c.callArgs.length != 1 {
          return emitFail(
            "emitProgram: __memory_grow__ takes exactly one argument (the page count to add)",
          )
        }
        if emitMemIntrinArg(body, c.callArgs[0], fnIx) < 0 { return -1 }
        fbMemoryGrow()
        return 0
      }
      if callee.identName == "__log__" {
        if c.callArgs.length != 2 {
          return emitFail("emitProgram: __log__ takes exactly two arguments")
        }
        if emitMemIntrinArg(body, c.callArgs[0], fnIx) < 0 { return -1 }
        if emitMemIntrinArg(body, c.callArgs[1], fnIx) < 0 { return -1 }
        fbCall(gMemLogIdx)
        return 0
      }
      // The array-intrinsic floor (std-design D1 / collections-design §LS.2),
      // lowered INLINE — host parity: toWasm.ts lowers the same names to single
      // WasmGC instructions (array.new / array.new_default / array.copy /
      // unreachable). `__trap__()` is the deliberate abort primitive.
      if callee.identName == "__trap__" {
        if c.callArgs.length > 1 {
          return emitFail(
            "emitProgram: __trap__ takes an optional string message",
          )
        }
        // `__trap__("reason")`: stream the message to the host boundary FIRST
        // (the same `__print_char__`/`__print_str_flush__` path `print(<string>)`
        // uses), so an abort carries a human-readable reason, THEN `unreachable`.
        if c.callArgs.length == 1 {
          if emitPrintStrExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
        }
        fbUnreachable()
        return 0
      }
      // `__array_new__(n, fill)` → `array.new` (every slot set to `fill`);
      // `__array_new_default__(n)` → `array.new_default` (slots zeroed). Both
      // yield the `{backing, len: n, cap: n}` list wrapper — the runtime-length
      // sibling of the array literal. The length is staged in the 1-slot arrNew
      // scratch local (it feeds the allocation size and both wrapper fields).
      // Native element coverage: the i32 list (i32/boolean) and, for
      // `__array_new__`, the f64 list via an f64 fill; ref/string elements are
      // emitter long tail — fail loudly, never emit wrong bytes.
      if (
        callee.identName == "__array_new__" ||
        callee.identName == "__array_new_default__"
      ) {
        return emitArrayNewIntr(body, callIx, fnIx)
      }
      // `__array_copy__(dst, dstAt, src, srcAt, count)` → `array.copy` over the
      // two lists' backings: bulk-move `count` elements from `src[srcAt..]` into
      // `dst[dstAt..]` (memmove semantics; OOB spans trap — the instruction's
      // own check). Operand order matches the instruction's stack shape, so no
      // scratch is needed.
      if callee.identName == "__array_copy__" {
        return emitArrayCopyIntr(body, callIx, fnIx)
      }
      // SCOPE-AWARE, like the function-VALUE path at `emitIdentNode` — but through the
      // whole lexical CHAIN. `buildFnMap` keys lifted functions by NAME with
      // FIRST-OCCURRENCE-WINS, so the flat `fnIndexOf` resolves EVERY frame's `inner(…)`
      // to the module's first `inner` — a SILENT WRONG ANSWER whenever the colliding
      // bodies agree in shape, and invalid wasm when they do not.
      // `fnIndexOfInScopeChain` walks out from this frame and takes the innermost
      // declaration, which is the language's own scoping rule; it is gated on
      // `nestedNameSet`, so a callee that names no nested function anywhere costs exactly
      // the `fnIndexOf` map lookup it cost before.
      const target = fnIndexOfInScopeChain(callee.identName, fnIx)
      if target < 0 {
        // Not a known function name — a CLOSURE-VALUED callee (a let/param/global holding
        // a function value, or a higher-order call result). Dispatch through the closure
        // fat-pointer: push env, push args, push the id, `call_indirect $fnsig`.
        if exprIsClosure(c.callFn, fnIx) {
          return emitCallRef(body, callIx, fnIx)
        }
        // The NUMERIC-OPCODE intrinsics: one wasm instruction over the arguments, no
        // import and no runtime. Reached only where the name resolved to no function and
        // no closure value, which IS the shadowing rule the checker types against — a
        // program that defines its own `min` calls its own.
        const bcRc = emitBitcastIntr(body, callIx, fnIx, callee.identName)
        if bcRc != NUM_INTR_NONE { return bcRc }
        const fiRc = emitFloatIntr(body, callIx, fnIx, callee.identName)
        if fiRc != NUM_INTR_NONE { return fiRc }
        const iiRc = emitIntIntr(body, callIx, fnIx, callee.identName)
        if iiRc != NUM_INTR_NONE { return iiRc }
        return emitFail("emitProgram: call to unknown function")
      }
      // A direct call to a CAPTURING lifted function (`add(10)` where `add` captures `n`
      // from the enclosing frame): build its closure value (reading the captures live)
      // and `call_ref` it — a plain `call` would pass a null env and lose the captures.
      // Gated on `fnValUsed` so a no-lambda module never enters this path (and capture
      // analysis, which can false-positive on a forward reference, is never consulted).
      if fnValUsed && captureCountOf(target) > 0 {
        return emitCapturedCall(body, callIx, fnIx, target)
      }
      return emitDirectCall(body, callIx, fnIx, target)
    }
    // A non-Ident callee yielding a function value (`o.go(10)`, `(expr)(args)`):
    // `call_ref` over the closure fat-pointer.
    if exprIsClosure(c.callFn, fnIx) { return emitCallRef(body, callIx, fnIx) }
    // A UFCS `self`-method call (the host parser's rule, parser.ts case 2):
    // `o.f(args)` where `f` is a free function whose FIRST parameter is named
    // `self` (and arity matches) lowers to the direct call `f(o, args)`. The
    // callable-FIELD case won above (`exprIsClosure` → `call_ref`), mirroring the
    // host's precedence. Lowered by building the direct-call node in the arena and
    // re-lowering it, so every direct-call coercion path (struct hints, union
    // boxing, nullable bridging, widening) is shared rather than duplicated.
    const um = P.nodes[c.callFn]
    if um is Member {
      // A UFCS member-call normally lowers to a direct `Ident` call in
      // `dispatchRewrite`/`drwWalk` before emission; this fallback re-derives the
      // same direct call should it reach emit unrewritten. The merge mangles the
      // free `self`-function but leaves the property plain, so resolve through the
      // alias (identity single-file).
      const uName = ufcsAliasOf(um.memProp)
      const uTarget = fnIndexOf(uName)
      if uTarget >= 0 {
        const uFn = P.nodes[fnStmts[uTarget]]
        if uFn is FuncDecl {
          const uParams = uFn.fnParams
          if uParams.length == c.callArgs.length + 1 {
            const uP0 = P.nodes[uParams[0]]
            if uP0 is Param {
              if uP0.parName == "self" {
                const uArgs: i32[] = []
                uArgs.push(um.memObj)
                let ua = 0
                while ua < c.callArgs.length {
                  uArgs.push(c.callArgs[ua])
                  ua = ua + 1
                }
                // The injected receiver is an UNNAMED slot-0 positional; any
                // named args shift right with it ("" rides slot 0) so the
                // rebuilt direct call reorders them around the receiver
                // exactly as the host does.
                const uNames: string[] = []
                if hasNamedArgs(c.callArgNames) {
                  uNames.push("")
                  let un = 0
                  while un < c.callArgNames.length {
                    uNames.push(c.callArgNames[un])
                    un = un + 1
                  }
                }
                return emitCall(
                  body,
                  mkCallN(mkIdent(uName, -1), uArgs, uNames, -1),
                  fnIx,
                )
              }
            }
          }
        }
      }
    }
    return emitFail("emitProgram: callee is not a function name")
  }
  emitFail("emitProgram: expected a call expression")
}

// The argument VALUE nodes of the call at `callIx`, bound into PARAMETER order
// for a direct call to the function at fnStmts position `target` — the host's
// `orderArgumentsByParameters` applied at the emission boundary. An
// all-positional call returns its source list untouched (byte-identical to the
// pre-named-args emitter); a named call reorders by the callee FuncDecl's
// parameter names. A binding failure surfaces as a -1 slot / surplus entry,
// which `directArgsBad` detects (the checker already diagnosed it; the emitter
// just refuses to emit a mis-mapped call).
function orderedDirectArgs(callIx: i32, target: i32) {
  const none: i32[] = []
  const c = P.nodes[callIx]
  if c is Call {
    if !hasNamedArgs(c.callArgNames) { return c.callArgs }
    const pNames: string[] = []
    const d = P.nodes[fnStmts[target]]
    if d is FuncDecl {
      const ps = d.fnParams
      let i = 0
      while i < ps.length {
        const p = P.nodes[ps[i]]
        if p is Param { pNames.push(p.parName) }
        i = i + 1
      }
    }
    return orderArgsByParamNames(pNames, c.callArgs, c.callArgNames)
  }
  none
}

function emitCallRef(body: i32[], callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    if hasNamedArgs(c.callArgNames) {
      return emitFail(
        "emitProgram: named arguments require a declared function",
      )
    }
    // Evaluate the closure once into the call-ref scratch local (`callRefSlot`).
    if emitExpr(body, c.callFn, fnIx) < 0 { return -1 }
    // A NULLABLE function value (`fn | null`, kind 19) loads as `(ref null $cloStruct)`;
    // the scratch slot is non-null, and the checker proved it non-null here (the `if c !=
    // null` narrowing), so recover to non-null.
    if exprNulClosure(c.callFn, fnIx) {
      wU8(212) // 0xd4 ref.as_non_null
    }
    fbLocalSet(callRefSlot)
    // The callee's interned `$fnsig` KEY — a function-typed param/local/global annotation, an
    // inferred binding's underlying sig, a field closure's, or an indexed closure-array element's.
    // Its param tokens drive ARGUMENT coercion below, and it resolves the functype to `ref.cast` to
    // (a non-all-i32 shape like `(f64,f64)->f64` casts to the right functype; "" falls back to the
    // all-i32 arity sig).
    const ckey = cloCallSigKey(callIx, fnIx)
    // SOUNDNESS FLOOR: a value-union closure RESULT with a COMPOSITE member (`(i32) => f32 |
    // {w:i32}`) is not yet representable through a closure result — the lambda self-infers its
    // single concrete arm while the checker types the call as the whole union, so the narrow
    // that reads it (`t0 is f32`) mis-reads the plain rep as the box. Reject cleanly (never
    // leak the unsound narrow to invalid wasm); deferred to the value-union COMPOSITION rep.
    if cloCallUnionResultUnrepresentable(callIx, fnIx) {
      return emitFail(
        "emitProgram: value-union closure RESULT is not yet representable",
      )
    }
    // A ref-list closure result whose PRODUCER lambda and cast annotation key distinct,
    // non-layout-twin element slots (a nullable-element list built from a non-null literal):
    // the wrapper structs are distinct heap types, so the call-ref `ref.cast` would TRAP.
    // Reject cleanly — the deferred nullable-element ref-list composition.
    if cloCallReflistElemTwin(callIx, fnIx) {
      return emitFail(
        "emitProgram: closure ref-list result element twin (deferred value-ABI composition)",
      )
    }
    // env = closure.env (field 0).
    fbLocalGet(callRefSlot)
    fbStructGet(cloStructIdx, 0)
    // args, each COERCED to its parameter's scalar valtype (an i32 literal widened into an i64 / f64
    // / f32 param) — the `call_ref` functype demands the exact valtype, exactly as a direct call.
    const args = c.callArgs
    // Each argument's valtype is decided by its PARAMETER (the `pck` coercion below), so any
    // wide-scalar context an ENCLOSING position set must NOT leak into it — an `f32`-context
    // call (`return v[0](1)` inside an `: f32` function) would else lower a bare i32 argument
    // literal as `f32.const` (invalid: the functype's i32 param). Clear the pending flags for
    // the arg spine and restore after, mirroring the index-receiver discipline.
    //
    // The LITERAL-UNION seeds obey the same rule and pick a whole different valtype rather
    // than a widening; `clu` below restores them from the CALLEE's own parameter for the two
    // positions that want an atom. Without the clear, an atom-typed destination holding the
    // call (`const r: K = f(a)`, a `K` element, `"s" + f(a)`) pushed its context into `f`'s
    // arguments and a member-literal argument lowered as an i32 id into a `(ref $array)` slot.
    const savedArgF32 = pendingF32
    const savedArgF64 = pendingF64
    const savedArgI64 = pendingI64
    const savedArgLU = pendingLitUnion
    const savedArgNulLU = pendingNulLitUnion
    pendingF32 = false
    pendingF64 = false
    pendingLitUnion = 0
    pendingNulLitUnion = false
    pendingI64 = false
    let i = 0
    while i < args.length {
      const pck = sigParamCoerceKind(ckey, i)
      if pck == "i64" {
        if emitExprAsI64(body, args[i], fnIx) < 0 { return -1 }
      } else if pck == "f64" {
        if emitExprAsF64(body, args[i], fnIx) < 0 { return -1 }
      } else if pck == "f32" {
        if emitExprAsF32(body, args[i], fnIx) < 0 { return -1 }
      } else {
        // The LITERAL-UNION param positions, the two seeds this arm has never had while its
        // direct-call twin `emitCall` has carried both (`cParamLitUnion` /
        // `cParamNulLitUnion`): a member-literal argument lowers as its interned i32 ATOM id,
        // and a `null` argument into a `K | null` param as the i32 sentinel `-1`. Without
        // them `const f: (K) => i32 = pick` + `f("a")` pushed a string REF into the i32 param
        // the `call_ref` functype declares — invalid wasm with `vl check` clean, from two
        // ordinary lines, in EVERY function-value shape (annotated binding, lambda, HOF param,
        // struct field, closure array, local binding). The VARIABLE-argument spelling `f(k)`
        // escaped because the atom local already holds the i32 id; only a LITERAL had to be
        // told which rep to take. The `$fnsig` key cannot supply this (a litunion param's
        // token is `i`, identical to a plain i32's — measured), so it comes from the callee's
        // checker type: `cloCallParamLitUnion`.
        const clu = cloCallParamLitUnion(callIx, i)
        // The value-UNION param position — the box (`u`), and the third seed this arm never
        // had while `emitCall` has carried it (`cUNm` → `emitUnionBoxArg`). The KIND is read
        // off the resolved `$fnsig` KEY (`sigParamKindAt`), which is the byte the `ref.cast`
        // functype actually declares for this parameter, so the coercion cannot disagree with
        // the bytes; the union's IDENTITY — slot-free in the ABI on purpose, since all boxes
        // share one valtype — comes from the checker type (`cloCallParamUnionName`). Without
        // it `const f: (string | i64) => i32 = mk` + `f("a")` pushed a raw string ref into a
        // `(ref $uBox)` param: `vl check` rc 0, INVALID WASM, in every function-value shape
        // and for every value-union spelling INCLUDING the `i32 | null` niche (which reps as
        // the box). A union-VALUE argument was already fine — it IS the box — which is why
        // only the raw-member spellings failed, and why `emitUnionBoxArg` (whose first act is
        // an `exprUnion` passthrough) keeps them byte-identical.
        let cuNm = ""
        if sigParamKindAt(ckey, i) == "union" {
          cuNm = cloCallParamUnionName(callIx, i)
          if cuNm == "" {
            // The key says box and no registered name resolves: a producer DISAGREEMENT, not
            // a shape the rep declines. Refuse LOUDLY rather than push the un-boxed operand —
            // invalid wasm is the one outcome this arm must never reach.
            //
            // MEASURED INERT: zero firings over 1,595 corpus files, 1,800 fuzz cases and the
            // 116-cell param grid. It is kept rather than degraded to the historical raw
            // `emitExpr` because it EARNED its keep during development — its one firing was
            // `closures/closure-param-union-arena-walk.vl`, and it was right: the resolver was
            // asking `tyToEmitName` (structural) for a union the registry holds under its
            // NOMINAL spelling. A silent fallback would have shipped that gap.
            return emitFail(
              "emitProgram: value-call union parameter has no resolvable union name",
            )
          }
        }
        if cuNm != "" {
          if emitUnionBoxArg(body, cuNm, args[i], fnIx) < 0 { return -1 }
        } else if (
          sigParamKindAt(ckey, i) == "str" &&
          exprIsLitAtom(args[i], fnIx)
        ) {
          // The MIRROR of `clu`: a literal-union ATOM argument flowing into a `string`
          // parameter widens to its member string, because the functype declares
          // `(ref $array)` there and the atom local holds an i32 id. Same edge the direct
          // twin takes (`cParamStr`), and the same `$fnsig` byte decides it as for the box
          // above — a `string` token is a ref, so unlike the litunion token it is not
          // confusable with i32.
          if emitAtomToStr(body, args[i], fnIx) < 0 { return -1 }
        } else if clu == 0 {
          if emitExpr(body, args[i], fnIx) < 0 { return -1 }
        } else {
          const cluCtx = expCtxHere()
          cluCtx.litUnion = 1
          if clu == 2 { cluCtx.nulLitUnion = true }
          if emitExprExpect(body, args[i], fnIx, cluCtx) < 0 { return -1 }
        }
      }
      i = i + 1
    }
    pendingF32 = savedArgF32
    pendingF64 = savedArgF64
    pendingI64 = savedArgI64
    pendingLitUnion = savedArgLU
    pendingNulLitUnion = savedArgNulLU
    // id = closure.id (field 1) — the callee's wasm function index, `call_indirect`'d at
    // the concrete `$fnsig` (the engine signature-checks the callee against it).
    let sig = -1
    if ckey != "" {
      const cp = cloSigPosOfKey(ckey)
      if cp >= 0 { sig = cloSigBase + cp }
    }
    if sig < 0 { sig = fnSigIdxForArity(args.length) }
    if sig < 0 {
      return emitFail(
        "emitProgram: function-value call arity has no interned signature",
      )
    }
    fbLocalGet(callRefSlot)
    fbStructGet(cloStructIdx, 1)     // the callee's wasm function index
    fbCallIndirect(sig, gFnTableIdx) // 0x11 <fnsig> <table>
    return 0
  }
  emitFail("emitProgram: expected a call expression")
}

// ── statement-sequence lowering ──────────────────────────────────────────────
// A function body is a SEQUENCE of statements, lowered onto `body` in order. Only
// `return` and `if` are handled; `else if` chains fall out naturally because an
// `IfStmt`'s `ifElse` may itself be an `IfStmt` (lowered recursively). Control flow
// is kept simple by relying on explicit `return`s rather than block result types:
// a `return` leaves its value and emits the `return` instruction (0x0f), and an
// `if` is a VOID structured block (blocktype 0x40) whose branches `return` on their
// own — so the `if` never has to yield a value, and no block result type is needed.

// Lower an assignment `target = value` (a `BinExpr` whose `binOp` is `"="`) onto
// `body`: emit the value expression, then `local.set <index>` for the target local.
// The target must be a bare `Ident` naming a param or declared local (no member /
// indexed assignment in this slice). `local.set` consumes the value and leaves no
// result, so an assignment statement contributes nothing to the stack. Returns 0,
// or -1 (via `emitFail`) on a non-local / unsupported target.
//
// Node shapes read: BinExpr { binOp, binLeft, binRight }, target Ident { identName }.
function emitAssign(body: i32[], binIx: i32, fnIx: i32) {
  const a = P.nodes[binIx]
  if a is BinExpr {
    const target = P.nodes[a.binLeft]
    if target is Ident {
      const idx = localIndexOf(fnIx, target.identName)
      if idx < 0 {
        // Not a local — a module global? Store with `global.set` (0x24 <globalidx>).
        const gIdx = globalIndexOfSid(sidOfNode(a.binLeft))
        if gIdx >= 0 {
          // Seed the assigned global's declared type context so the RHS literal builds the
          // SAME wasm type the cell expects (e.g. `globalNames = []` builds a STRING-list
          // wrapper, not the default i32-list; a struct global gets its annotated struct) —
          // mirroring the global-INIT seeding in the global section.
          const gLet = globalStmts[gIdx]
          const gaKind = globalCellKind(gLet)
          if gaKind == "struct" { pendingStructIdx = globalCellStructIdx(gLet) }
          // A NULLABLE-struct global (`g = null` / `g = { … }` over `let g: S | null`):
          // the cell is `(ref null $S)`, so a bare `null` RHS needs the SAME struct seed
          // the kind-1 line above gives a non-null cell — `globalCellStructIdx` reads the
          // annotation, which for `S | null` names no `sNames` entry, so the base comes
          // from `nulRefStructIdxOfLet` (the `| null` peel). Without it the `null` reached
          // `emitNullLitNode` with no context at all and the whole module was rejected.
          if gaKind == "nulstruct" {
            pendingStructIdx = nulRefStructIdxOfLet(gLet, -1)
          }
          pendingListKind = letAnnRefListKind(gLet)
          pendingListSlot = letAnnRefListSlot(gLet)
          // FIXED (was FILED here) — the GLOBAL cell these two seeds do not rescue was never
          // an assignment gap at all: an empty-`[]`-initialized `S[] | null` global was
          // MIS-READ, in `exprArray` / `exprRefArray`, as the mono i32 list. The filing's
          // diagnosis (the global CELL kind, `globalCellKind` / `emitGlobalSection`) is
          // REFUTED by the emitted bytes: the cell and this arm's seeds were both already
          // correct — `(mut (ref null $rlWrap))` holding a `struct.new $rlWrap` — and it was
          // `xs.length` that addressed the WRONG wrapper. Two of the filing's four
          // neighbours were wrong too: the same global assigned the EMPTY literal was
          // invalid wasm (not "runs"), and the non-empty INITIALIZER is a checker error only
          // without an assignment (`.length` on an un-narrowed nullable) — with one, it ran.
          // The fix is `exprRefArray`'s third storage class in `emit_classify.vl`; see
          // `tests/cases/globals/nullable-refarray-global-empty-init.vl`.
          // A MAP-typed global seeds the map SHAPE, so a bare `Map()` RHS constructs THIS
          // binding's map struct instead of the shared mono (i32-valued) one. The let /
          // return / struct-field / global-INIT boundaries all seed it already; ASSIGNMENT
          // did not, and a re-initializing `m = Map()` over a `{[string]: string}` (or
          // i64/f64/f32-valued) binding therefore `struct.new`'d the wrong map type —
          // `type mismatch: expected (ref null $type), found (ref $type)`, `vl check` clean.
          // Only i32- and boolean-valued maps escaped, because their vals list IS the mono
          // one. `Set()` escaped for the same reason.
          if exprMap(a.binLeft, fnIx) {
            pendingMapSlot = mapShapeOfExpr(a.binLeft, fnIx)
          }
          // A UNION-typed global (kind 4) coerces a raw assigned value into the
          // box (`w = 5` over `let w: string | i32` boxes the 5).
          //
          // A LITERAL-union global is NOT a value-union box — its cell is a plain
          // `(mut i32)` interned ATOM — so it must NOT reach `emitUnionCoerce`, which
          // `struct.new`s the `{tag, payload}` box into that i32 cell (`type mismatch:
          // expected i32, found (ref $type)`, `vl check` clean, EVERY member RHS and
          // every arity). The LOCAL arm below has carried this exclusion since it was
          // written; the global arm never did, so `type K = "a" | "b"` + `let v: K = "a"`
          // + `v = "b"` emitted an invalid module while the same three lines inside a
          // function ran. Falls through to the seed block below, where `litUnion` lowers
          // the member RHS as its interned id — exactly the local arm's shape.
          const gUNm = letUnionNameOf(gLet, -1)
          if gUNm != "" && !nameIsLitUnionType(gUNm) {
            if emitUnionCoerce(body, gUNm, a.binRight, fnIx) < 0 { return -1 }
          } else if exprIsI64(a.binLeft, fnIx) {
            // An i64 GLOBAL target (`a = 7` over `let a: i64`) widens an i32 RHS to i64 — the
            // LOCAL arm's own words: "without this the bare `i32.const` clashes with the i64
            // slot (the checker accepts the assignment, so it is a soundness hole)". The global
            // arm never had it, so `let a: i64 = 0` + `a = 7` emitted `i32.const 7` into a
            // `(mut i64)` cell — invalid wasm from two ordinary lines, `vl check` clean, at TOP
            // LEVEL as much as inside a function. An already-i64 RHS (`a = b`, `a = a + 1`)
            // makes `emitExprAsI64` a no-op, which is why those two spellings escaped.
            if emitExprAsI64(body, a.binRight, fnIx) < 0 { return -1 }
          } else if exprIsF64(a.binLeft, fnIx) {
            // The f64 twin, same rationale and the same LOCAL-arm mirror: `let a: f64 = 0.0` +
            // `a = 7` pushed an i32 into the `(mut f64)` cell. An f64-literal RHS (`a = 1.5`)
            // needs no widening, which is why only the INTEGER-literal spelling was broken.
            if emitExprAsF64(body, a.binRight, fnIx) < 0 { return -1 }
          } else if exprIsF32(a.binLeft, fnIx) {
            // The f32 cell, which NEITHER arm ever had: a float RHS must re-encode at SINGLE
            // precision. `emitExpr` lowers a bare `.` literal at f64 (its default), so
            // `let g: f32 = 1.0` + `g = 2.5` pushed an `f64.const` into the `(mut f32)` cell —
            // invalid wasm from two ordinary lines, `vl check` clean, global / local / param
            // alike. An f32 VARIABLE or f32-returning CALL RHS was already correct, which is
            // why only the literal spelling was broken. `emitExprAsF32` re-encodes the literal
            // and delegates everything else, so those two spellings stay byte-identical.
            // Ordered after the f64 arm: for the IDENT target this branch handles, the two
            // classifiers are mutually exclusive (`declaredF32`/`globalIsF32` against their
            // f64 twins), so neither can steal the other's cell.
            if emitExprAsF32(body, a.binRight, fnIx) < 0 { return -1 }
          } else if (
            exprString(a.binLeft, fnIx) &&
            exprIsLitAtom(a.binRight, fnIx)
          ) {
            // A literal-union atom assigned to a `string` global widens to its member string.
            if emitAtomToStr(body, a.binRight, fnIx) < 0 { return -1 }
          } else {
            // A NICHE `X | null` global seeds its null rep for a bare `null` RHS (the table
            // at `emitNullLitNode`); a non-null RHS ignores the seed.
            const gsCtx = expCtxHere()
            if exprNulBool(a.binLeft, fnIx) { gsCtx.nulBool = true }
            if exprNullableString(a.binLeft, fnIx) { gsCtx.nulString = true }
            if exprNulClosure(a.binLeft, fnIx) { gsCtx.nulClosure = true }
            // The REMAINING niches, which this arm never seeded — every one of them
            // reached `emitNullLitNode` with an empty context and rejected the module on a
            // plain `g = null`. Each mirrors the seed the global's own INITIALIZER already
            // gets, so re-assigning a global now lowers `null` exactly as initializing it
            // to `null` does.
            if exprNullableList(a.binLeft, fnIx) { gsCtx.nulList = true }
            if exprNulLitUnion(a.binLeft, fnIx) {
              gsCtx.nulLitUnion = true
              gsCtx.litUnion = 1
            }
            const gaNSK = exprNulScalarListKind(a.binLeft, fnIx)
            if gaNSK != null {
              gsCtx.listKind = nulScalarListBuildKind(gaNSK)
              gsCtx.nulRefHeap = nulScalarListWrapHeap(gaNSK)
            }
            if exprNullableMap(a.binLeft, fnIx) {
              gsCtx.nulRefHeap = mapTypeIdxOf(mapShapeOfExpr(a.binLeft, fnIx))
            }
            // The sixth niche, missed when the five above landed: a kind-18 nullable REF
            // array global (`g: i32[][] | null`, `g: S[] | null`). Its null is THIS
            // global's element wrapper — `pendingListSlot` above already holds the slot
            // (`letAnnRefListSlot`), the same one `emitGlobalSection` gives the cell its
            // valtype from and the start fn seeds the INITIALIZER with, so `g = null`
            // now lowers exactly as `= null` in the declaration does. Under the #964
            // SEED-LEAK gate the binding and call-argument boundaries also spell: armed
            // only for a bare `null` RHS, else a list-literal RHS whose ELEMENT is null
            // (`g = [null]`) would take the wrapper heap type instead of the element's.
            if gaKind == "nulreflist" {
              if pendingListSlot >= 0 && pendingListSlot < rlWrapIdx.length {
                const gnraRhs = P.nodes[unwrapParen(a.binRight)]
                if gnraRhs is NullLit {
                  gsCtx.nulRefHeap = rlWrapIdx[pendingListSlot]
                }
              }
            }
            // A LITERAL-union global (`v = "b"` over `let v: K`): the member RHS lowers
            // as its interned i32 id, not as a heap string. The twin of the local arm's
            // `exprIsLitAtom(a.binLeft, …)` seed, and the other half of the litunion
            // exclusion above — without it the union-coerce reject becomes a `(ref
            // $array)` string stored into the `(mut i32)` atom cell.
            if exprIsLitAtom(a.binLeft, fnIx) { gsCtx.litUnion = 1 }
            if emitExprExpect(body, a.binRight, fnIx, gsCtx) < 0 { return -1 }
          }
          pendingListKind = 0
          pendingListSlot = 0
          pendingMapSlot = -1
          return emitUserGlobalSet(gIdx) // 0x24 global.set, or a promoted `local.set`
        }
        return emitFail(
          "emitProgram: assignment target is not a parameter, local, or global",
        )
      }
      // A MAP-typed LOCAL seeds the map SHAPE for a bare `Map()` RHS, exactly as the
      // global arm above does and for the same defect.
      if exprMap(a.binLeft, fnIx) {
        pendingMapSlot = mapShapeOfExpr(a.binLeft, fnIx)
      }
      // The LIST seeds this arm lacked, filed at this exact site by #1215 and graded on its
      // own here. The global arm above sets `pendingListKind`/`pendingListSlot` from the
      // cell's annotation before emitting the RHS, and `emitLetDeclStmt` does the same for
      // the DECLARATION; the local arm set NEITHER, so a list-LITERAL right-hand side built
      // the DEFAULT i32 list into a non-i32 slot. `xs = []` over a `string[]` / `f64[]` /
      // `i64[]` / `f32[]` / `S[]` / `i32[][]` / `(S|null)[]` / `S[]|null` LOCAL or PARAM was
      // invalid wasm with `vl check` clean — clearing a list, the most ordinary thing there
      // is — while the `i32[]` local escaped (the default IS its slot) and every GLOBAL twin
      // ran. Two spellings were broken with a NON-empty literal too (`xs = [1, 2]` over
      // `i64[]`, `xs = [1.5]` over `f32[]`): neither literal self-identifies as its backing,
      // so both need the seed exactly as the annotated declaration does.
      //
      // Keyed off the TARGET EXPRESSION (`exprListCellBuildKind`), because a declared local
      // has no `LetDecl` left to read — `buildLocals` compiles its annotation into the slot
      // tables — and a param never had one. Saved and restored around the whole arm: these
      // are the ambient `pending*` transport, and this arm's tail (`fbLocalSet`) is not a
      // reset point.
      const savedAsLK = pendingListKind
      const savedAsLS = pendingListSlot
      pendingListKind = exprListCellBuildKind(a.binLeft, fnIx)
      pendingListSlot = exprListCellBuildSlot(a.binLeft, fnIx)
      // A UNION-typed local (kind 4) coerces a raw assigned value into the box
      // (`u = 3.5` over `let u: i32 | f64` boxes the f64); a union-valued RHS
      // passes through unchanged. Value first, then store it into the slot.
      const aUNm = unionNameOfIdentSid(sidOfNode(a.binLeft), fnIx)
      if aUNm != "" && !nameIsLitUnionType(aUNm) {
        // (a literal-union target is an i32 ATOM, not a value-union box — it falls through to the seed
        // block below, where the member RHS lowers as its interned id.)
        // A kind-4 union-BOX local boxes a concrete variant RHS (`u = s` where `u: C | S`,
        // `s: S`), exactly like a call arg / return — `emitUnionBoxArg` boxes a variant and
        // defers every other shape to `emitUnionCoerce`. A kind-8 variant-init local (`let u:
        // C | S = someVariant`) keeps the RAW variant rep, so it must NOT box — use the plain
        // coerce there.
        if declaredKind(target.identName) == "union" {
          if emitUnionBoxArg(body, aUNm, a.binRight, fnIx) < 0 { return -1 }
        } else {
          if emitUnionCoerce(body, aUNm, a.binRight, fnIx) < 0 { return -1 }
        }
      } else if exprNulLitUnion(a.binLeft, fnIx) {
        // A `K | null` NICHE target (`v = null` / `v = "b"`): the i32 cell holds an atom id or the
        // sentinel `-1`. Seed `pendingNulLitUnion` (a `null` RHS → `-1`) and `pendingLitUnion` (a
        // member RHS → its interned id). BEFORE the `string` branch — a litunion target reads as a
        // string subtype, which would otherwise widen the member RHS to a heap string.
        const nluCtx = expCtxHere()
        nluCtx.nulLitUnion = true
        nluCtx.litUnion = 1
        if emitExprExpect(body, a.binRight, fnIx, nluCtx) < 0 { return -1 }
      } else if exprIsI64(a.binLeft, fnIx) {
        // An i64 target (`x = 0` over `let x: i64`) widens an i32 RHS to i64 — without this the
        // bare `i32.const` clashes with the i64 slot (the checker accepts the assignment, so it
        // is a soundness hole). `emitExprAsI64` is a no-op for an already-i64 RHS.
        if emitExprAsI64(body, a.binRight, fnIx) < 0 { return -1 }
      } else if exprIsF64(a.binLeft, fnIx) {
        // An f64 target (`y = 3` over `let y: f64`) widens an i32 RHS to f64, same rationale.
        if emitExprAsF64(body, a.binRight, fnIx) < 0 { return -1 }
      } else if exprIsF32(a.binLeft, fnIx) {
        // An f32 target (`g = 2.5` over `let g: f32`) re-encodes a float RHS at SINGLE
        // precision — the twin of the global arm's f32 cell above, missing here for the
        // same reason and with the same witness (`emitExpr` defaults a bare `.` literal to
        // f64, so the `(mut f32)` slot took an `f64.const`). Params take this arm too.
        if emitExprAsF32(body, a.binRight, fnIx) < 0 { return -1 }
      } else if exprString(a.binLeft, fnIx) && exprIsLitAtom(a.binRight, fnIx) {
        // A literal-union atom assigned to a `string` local widens to its member string.
        if emitAtomToStr(body, a.binRight, fnIx) < 0 { return -1 }
      } else {
        // A NICHE `X | null` local seeds its null rep for a bare `null` RHS, as the global
        // arm above does. A non-null RHS ignores the seed (a boolean is a `BoolLit`, a
        // function RHS builds the non-null closure value).
        const asCtx = expCtxHere()
        if exprNulBool(a.binLeft, fnIx) { asCtx.nulBool = true }
        if exprNullableString(a.binLeft, fnIx) { asCtx.nulString = true }
        if exprNulClosure(a.binLeft, fnIx) { asCtx.nulClosure = true }
        if exprNullableList(a.binLeft, fnIx) { asCtx.nulList = true }
        // The three niches this arm never seeded — a nullable STRUCT, a
        // DISTINCT-backing nullable scalar list (`string[]`/`f64[]`/`i64[]`/`f32[]`,
        // which `exprNullableList` deliberately excludes: it is the i32-backed
        // `i32[] | null` only) and a nullable MAP. Each one reached
        // `emitNullLitNode` with no context and rejected the module on a plain
        // `a = null`, while the same binding INITIALIZED to `null` lowered fine.
        // Mirrors the `let` seeds at `emitLetDeclStmt`'s kind ladder exactly.
        if exprNullableStruct(a.binLeft, fnIx) {
          const asSi = structIndexOfExpr(a.binLeft, fnIx)
          if asSi >= 0 { asCtx.structIdx = asSi }
        }
        const asNSK = exprNulScalarListKind(a.binLeft, fnIx)
        if asNSK != null {
          asCtx.listKind = nulScalarListBuildKind(asNSK)
          asCtx.nulRefHeap = nulScalarListWrapHeap(asNSK)
        }
        if exprNullableMap(a.binLeft, fnIx) {
          asCtx.nulRefHeap = mapTypeIdxOf(mapShapeOfExpr(a.binLeft, fnIx))
        }
        // The niche the block above does not reach, and the last one this arm lacks: a
        // kind-18 nullable REF-ARRAY local or param (`g: i32[][] | null`). Its null is
        // THIS binding's inner element wrapper — the same wrapper the DECLARATION's
        // `= null` seeds (`emitLetDeclStmt`'s `localIsRef[slot] == "nulreflist"` arm) and
        // the same one the global arm above resolves — so `g = null` now lowers exactly
        // as `= null` in the declaration does. `refListSlotOfExpr` round-trips a kind-18
        // ident back to that inner slot. Every REF element was broken (`i32[]`, `S`,
        // `S[]`, `string[]`, a niche-nullable element); only the SCALAR-element lists
        // escaped, because they are `exprNulScalarListKind`/`exprNullableList` above.
        // Under the #964 SEED-LEAK gate the binding boundary also spells: armed only for
        // a bare `null` RHS, else a list-literal RHS whose ELEMENT is null (`g = [null]`)
        // would take the wrapper heap type instead of the element's.
        if exprNullableRefArray(a.binLeft, fnIx) {
          const asRls = refListSlotOfExpr(a.binLeft, fnIx)
          if asRls >= 0 && asRls < rlWrapIdx.length {
            const asNraRhs = P.nodes[unwrapParen(a.binRight)]
            if asNraRhs is NullLit { asCtx.nulRefHeap = rlWrapIdx[asRls] }
          }
        }
        // A literal-union local (`k = "b"`): the member RHS lowers as its interned i32 id.
        if exprIsLitAtom(a.binLeft, fnIx) { asCtx.litUnion = 1 }
        if emitExprExpect(body, a.binRight, fnIx, asCtx) < 0 { return -1 }
      }
      pendingMapSlot = -1
      pendingListKind = savedAsLK
      pendingListSlot = savedAsLS
      fbLocalSet(idx) // 0x21 local.set
      return 0
    }
    if target is Index {
      // G8: a map store `m[k] = v` — scan for `k`; overwrite `vals[hit]` on a hit, else
      // append `keys.push(k); vals.push(v)`. Checked BEFORE the list path (a map index
      // is not an array index).
      if exprMap(target.idxArr, fnIx) {
        return emitMapSet(
          body,
          target.idxArr,
          target.idxIndex,
          a.binRight,
          fnIx,
        )
      }
      // Indexed store `a[i] = v`: evaluate the wrapper + index, guard `i u< len`
      // and unwrap to the backing (`emitListIdxGuard`), then the value, then
      // `array.set $aTy` (`0xfb 0x0e <typeidx>`). A REF list (G7-ref) stores a
      // struct ref / union box (a subtype of the `(ref null $elem)` slot) over
      // the ref list/backing indices; an i32 list stores an i32.
      const isRef = exprRefArray(target.idxArr, fnIx)
      const isStr = exprStringArray(target.idxArr, fnIx)
      // The scalar non-i32 lists (`f64[]`/`i64[]`/`f32[]`): the SAME unwrap+`array.set` spine over
      // their own wrapper/backing, with the value coerced to the element valtype.
      const isF64 = exprF64Array(target.idxArr, fnIx)
      const isI64 = exprI64Array(target.idxArr, fnIx)
      const isF32 = exprF32Array(target.idxArr, fnIx)
      let lTy = lTypeIdx
      let aTy = aTypeIdx
      // The bounds-check frame kind (+ ref-list table slot) for this target list —
      // the write guards `i u< len` exactly like the read path.
      let idxKind: MfKind = "i32"
      let idxSlot = 0
      // The ELEMENT-VALUE seeds, exactly as `emitArr` seeds a literal's elements (see
      // there): kind 1 hints the list's declared element STRUCT so `xs[i] = { … }` beats a
      // first-field-name match; kind 2 boxes the value into the shared `{tag, payload}`
      // rep; a NESTED-list element (kinds 4/6/7/8/9/10) emits under the INNER list's
      // context (`refElemValueCtx`), so `b[i] = [7, 8]` over `i64[][]` builds an i64 list.
      let storeStructIdx = -1
      let storeUnionNm = ""
      let storeNestSlot = -1
      if isRef {
        if !rlUsed {
          return emitFail(
            "emitProgram: ref indexed assignment but ref list type not collected",
          )
        }
        const rslot = refListSlotOfExpr(target.idxArr, fnIx)
        lTy = rlWrapIdx[rslot]
        aTy = rlBackIdx[rslot]
        idxKind = "ref"
        idxSlot = rslot
        if rlElemKindTbl[rslot] == 1 { storeStructIdx = rlElemStructRow(rslot) }
        if rlElemKindTbl[rslot] == 2 { storeUnionNm = rlElemName[rslot] }
        // Every element kind whose value emit needs the slot's context — a nested list,
        // the nullable-CLOSURE niche, a MAP element — through ONE predicate.
        if rlElemNeedsValueCtx(rslot) { storeNestSlot = rslot }
      } else if isStr {
        // A STRING list `xs[i] = s`: unwrap to its `(ref null $aTypeIdx)` string backing
        // (`mkListIdx`/`mkArrIdx`) and store the string ref — mirroring `emitIndex`'s
        // string path. Without this branch a string-list target (e.g. the `string[]`
        // global `narrowNames[i] = name`) falls into the i32-list case below and
        // `struct.get`s the WRONG wrapper type (`lTypeIdx` instead of `mkListIdx`).
        if !slUsed {
          return emitFail(
            "emitProgram: string indexed assignment but string list type not collected",
          )
        }
        lTy = mkListIdx
        aTy = mkArrIdx
        idxKind = "str"
      } else if isF64 {
        if !fa64Used {
          return emitFail(
            "emitProgram: f64 indexed assignment but f64 list type not collected",
          )
        }
        lTy = fl64TypeIdx
        aTy = fa64TypeIdx
        idxKind = "f64"
      } else if isI64 {
        if !ia64Used {
          return emitFail(
            "emitProgram: i64 indexed assignment but i64 list type not collected",
          )
        }
        lTy = il64TypeIdx
        aTy = ia64TypeIdx
        idxKind = "i64"
      } else if isF32 {
        if !fa32Used {
          return emitFail(
            "emitProgram: f32 indexed assignment but f32 list type not collected",
          )
        }
        lTy = fl32TypeIdx
        aTy = fa32TypeIdx
        idxKind = "f32"
      } else {
        if !lUsed {
          return emitFail(
            "emitProgram: indexed assignment but list type not collected",
          )
        }
        if !exprArray(target.idxArr, fnIx) {
          return emitFail(
            "emitProgram: indexed-assignment target is not an array",
          )
        }
      }
      // Source order — receiver, index, VALUE — with the wrapper + index parked
      // ON THE OPERAND STACK while the value's user code runs (nested ops only
      // touch locals, so they cannot clobber them; the #918 map-SET pattern).
      // The guard stages the wrapper and resolves the BACKING + len only AFTER
      // the value: an RHS that pushes onto the target list reallocates the
      // backing, and the old resolve-early lowering stored into the STALE
      // pre-reallocation array (a silent lost write) and guarded against the
      // stale len (a grow-into-bounds store trapped). The value parks in a
      // typed `liBack == 2` stash across the guard — no user code runs between
      // its write and the `array.set`, so the shared slot is clobber-safe.
      //
      // A live hoist row skips the receiver entirely and guards against the
      // CACHED header. Resolving late buys nothing there and costs nothing:
      // hoisting is licensed only for a loop with no calls at all, so no RHS
      // under it can reallocate the target.
      const stHz = liveHoistRow(target.idxArr, idxKind, idxSlot)
      if stHz < 0 {
        if emitExpr(body, target.idxArr, fnIx) < 0 { return -1 }
      }
      if emitExpr(body, target.idxIndex, fnIx) < 0 { return -1 }
      pendingStructIdx = storeStructIdx
      if storeUnionNm != "" {
        if emitUnionBoxArg(body, storeUnionNm, a.binRight, fnIx) < 0 {
          return -1
        }
      } else if storeNestSlot >= 0 {
        // A nested-list row store: the RHS builds as the INNER list (inert for a
        // non-literal RHS — an ident/call emits unchanged).
        const snCtx = refElemValueCtx(storeNestSlot)
        if emitExprExpect(body, a.binRight, fnIx, snCtx) < 0 { return -1 }
      } else if isF64 {
        // The stored value re-encodes at the element valtype (a bare-int / int-literal value
        // widens into the f64 slot, exactly as a binding / push does).
        if emitExprAsF64(body, a.binRight, fnIx) < 0 { return -1 }
      } else if isI64 {
        if emitExprAsI64(body, a.binRight, fnIx) < 0 { return -1 }
      } else if isF32 {
        const savedPF32 = pendingF32
        pendingF32 = true
        if emitExprAsF32(body, a.binRight, fnIx) < 0 { return -1 }
        pendingF32 = savedPF32
      } else if nodeArrayElemIsLitUnion(target.idxArr) {
        // `xs[i] = "a"` over a literal-union array: the member RHS lowers as its atom id.
        const xluCtx = expCtxHere()
        xluCtx.litUnion = 1
        if emitExprExpect(body, a.binRight, fnIx, xluCtx) < 0 { return -1 }
      } else if nodeArrayElemIsNulBool(target.idxArr) {
        // `p[i] = null` over a `(boolean | null)[]`: the i32 cell holds 0/1 or the
        // sentinel 2 — seed `pendingNulBool` (via the ctx) so a `null` RHS emits 2 (a
        // boolean RHS is a `BoolLit`, untouched). The list analogue of the scalar niche
        // assignment above.
        const nbCtx = expCtxHere()
        nbCtx.nulBool = true
        if emitExprExpect(body, a.binRight, fnIx, nbCtx) < 0 { return -1 }
      } else if nodeArrayElemIsNulLitUnion(target.idxArr) {
        // `p[i] = "a"` / `p[i] = null` over a `(K | null)[]`: a member RHS lowers as its atom id, a
        // `null` as the `-1` sentinel — seed BOTH `litUnion` and `nulLitUnion` via the ctx.
        const nluCtx = expCtxHere()
        nluCtx.litUnion = 1
        nluCtx.nulLitUnion = true
        if emitExprExpect(body, a.binRight, fnIx, nluCtx) < 0 { return -1 }
      } else {
        if emitExpr(body, a.binRight, fnIx) < 0 { return -1 }
      }
      pendingStructIdx = -1
      const storeValSlot = listIdxValSlot(idxKind, idxSlot)
      fbLocalSet(storeValSlot) // 0x21 — park the value under the guard operands
      // Guard `i u< len`, unwrap to the backing (`struct.get` field 0) — leaves
      // [backing, safeIndex] resolved AFTER the value ran.
      if stHz >= 0 {
        emitListIdxGuardHoisted(stHz)
      } else {
        emitListIdxGuard(listIdxWrapSlot(idxKind, idxSlot), lTy)
      }
      fbLocalGet(storeValSlot) // 0x20 — the parked value
      fbArraySet(aTy)          // 0xfb 0x0e <backing array type index>
      return 0
    }
    if target is Member {
      // A field WRITE on a NARROWED union identifier (`if v is M { v.field = x }`)
      // downcasts through the box like the READ path (`emitNarrowedMem`): push the
      // box ref, unbox to the variant struct (`ref.cast`), push the value, then
      // `struct.set` the variant field. The mutation hits the SHARED arena object
      // (the in-place hole-filling `typecheck.vl` relies on).
      if memIsNarrowed(a.binLeft) {
        const nvi = memNarrowVariantIndex(a.binLeft)
        if nvi < 0 {
          return emitFail(
            "emitProgram: narrowed field-assignment receiver names no variant",
          )
        }
        const nm = P.nodes[a.binLeft]
        if nm is Member {
          const nfi = variantFieldIndex(nvi, nm.memProp)
          if nfi < 0 {
            return emitFail(
              "emitProgram: unknown variant field in narrowed field assignment",
            )
          }
          if emitExpr(body, nm.memObj, fnIx) < 0 { return -1 }
          fbStructGet(uBoxIdx, 1)  // box field 1: value (anyref)
          fbRefCast(uVarHeap[nvi]) // ref.cast to the variant struct
          // A SCALAR f64/i64/f32 variant field widens its RHS at the store boundary,
          // exactly as the construct does (`v.f = 9` into an i64 field emitted a raw
          // `i32.const` — invalid wasm at `struct.set`).
          if (
            emitScalarFieldStoreVal(
              body,
              a.binRight,
              fnIx,
              variantFieldTypeAt(nvi, nfi),
            ) <
            0
          ) {
            return -1
          }
          fbStructSet(uVarHeap[nvi], nfi)
          return 0
        }
      }
      // A field WRITE on a VARIANT-TYPED PARAM (`o: TyObj`) writes the variant struct
      // directly (the param IS the unboxed variant ref — no box unwrap).
      const pwvi = exprVariantIndex(target.memObj, fnIx)
      if pwvi >= 0 {
        const m1 = P.nodes[a.binLeft]
        if m1 is Member {
          const pwfi = variantFieldIndex(pwvi, m1.memProp)
          if pwfi < 0 {
            return emitFail(
              "emitProgram: unknown variant field in field assignment",
            )
          }
          if emitExpr(body, m1.memObj, fnIx) < 0 { return -1 }
          // Scalar-field RHS widening, as the narrowed branch above.
          if (
            emitScalarFieldStoreVal(
              body,
              a.binRight,
              fnIx,
              variantFieldTypeAt(pwvi, pwfi),
            ) <
            0
          ) {
            return -1
          }
          fbStructSet(uVarHeap[pwvi], pwfi)
          return 0
        }
      }
      // Field WRITE `recv.field = v` → `struct.set $0 <fieldidx>` (`0xfb 0x05`). The
      // single declared struct lives at WasmGC type index 0 (matching `emitMem`'s read
      // path). Operand order is load-bearing: push the struct REF first, then the value,
      // then the `fb 05` opcode pops `[ref, value]` (same shape `emitPush` uses for the
      // list `backing`/`len`/`cap` field stores).
      if !sDeclared {
        return emitFail(
          "emitProgram: field assignment but no struct type declared",
        )
      }
      const si = structIndexOfExpr(target.memObj, fnIx)
      if si < 0 {
        return emitFail(
          "emitProgram: field-assignment receiver is not a struct",
        )
      }
      const fieldIdx = sFieldIndex(si, target.memProp)
      if fieldIdx < 0 {
        return emitFail("emitProgram: unknown struct field in field assignment")
      }
      if emitExpr(body, target.memObj, fnIx) < 0 {
        return -1 // struct ref first
      }
      // An empty `[]` for an array-typed field needs its element kind threaded so the
      // wrapper matches the field's declared type — the same `pendingListKind` an
      // annotated `let xs: T[] = []` or an object-literal array field uses (else the
      // empty literal defaults to the i32-list wrapper and the `struct.set` rejects it).
      pendingListKind = 0
      pendingListSlot = 0
      const fscode = sFieldTypeAt(si, fieldIdx)
      if fscode == 5 {
        let faslot = sFieldRefSlot(si, fieldIdx)
        if faslot < 0 { faslot = 0 }
        pendingListSlot = faslot
        if rlElemKindTbl[faslot] == 2 {
          pendingListKind = 2
        } else {
          pendingListKind = 1
        }
      } else if fscode == 6 {
        pendingListKind = 3
      }
      // A MAP-typed field (code 19) seeds the map SHAPE — the write twin of `emitObj`'s
      // construct-side seed, carrying the same defect the ident arms above describe.
      pendingMapSlot = -1
      if fscode == 19 { pendingMapSlot = sFieldMapShape(si, fieldIdx) }
      // A BOX-union field (code 16) coerces a raw scalar/struct/null RHS into the box; the
      // NICHE fields seed their null rep for a bare `null` RHS (the table at
      // `emitNullLitNode`). A non-null value passes through.
      if fscode == 16 {
        if (
          emitUnionCoerce(
            body,
            sFieldElemNameAt(si, fieldIdx),
            a.binRight,
            fnIx,
          ) <
          0
        ) {
          return -1
        }
      } else if fscode == 3 && exprIsLitAtom(a.binRight, fnIx) {
        // A literal-union atom assigned to a `string` field (code 3) widens to its member string.
        if emitAtomToStr(body, a.binRight, fnIx) < 0 { return -1 }
      } else if sFieldIsLitUnion(si, fieldIdx) {
        // A literal-union atom field assign (`b.kind = "a"`): the member RHS lowers as its atom id.
        const wluCtx = expCtxHere()
        wluCtx.litUnion = 1
        if emitExprExpect(body, a.binRight, fnIx, wluCtx) < 0 { return -1 }
      } else if sFieldIsLitUnionArray(si, fieldIdx) {
        // An ATOM-ARRAY field assign (`g.f = ["bb"]`): the RHS builds the i32 list of atom
        // ids (the atom context routes the literal off the string-list build — construct
        // parity with `emitObj`'s code-4 atom arm).
        const wlaCtx = expCtxHere()
        wlaCtx.litUnion = 1
        if emitExprExpect(body, a.binRight, fnIx, wlaCtx) < 0 { return -1 }
      } else if fscode == 17 || fscode == 23 || fscode == 24 {
        // A SCALAR f64/i64/f32 field widens its RHS at the store boundary, the exact
        // treatment `emitObj` gives the construct (`p.g = 9` into an i64 field emitted
        // a raw `i32.const` — invalid wasm at `struct.set`; pre-existing, flat AND
        // nested spellings).
        if emitScalarFieldStoreVal(body, a.binRight, fnIx, fscode) < 0 {
          return -1
        }
      } else {
        const fwCtx = expCtxHere()
        if fscode == 20 { fwCtx.nulString = true }
        if fscode == 21 { fwCtx.nulBool = true }
        // A `K | null` niche field assign: member RHS -> atom id, `null` -> -1.
        if fscode == 30 {
          fwCtx.litUnion = 1
          fwCtx.nulLitUnion = true
        }
        // then the value
        if emitExprExpect(body, a.binRight, fnIx, fwCtx) < 0 { return -1 }
      }
      pendingListKind = 0
      pendingMapSlot = -1
      fbStructSet(sHeapIdx[si], fieldIdx) // 0xfb 0x05 <struct ht> <field index>
      return 0
    }
    return emitFail("emitProgram: assignment target is not a simple name")
  }
  emitFail("emitProgram: expected an assignment expression")
}

// The expected-type context for ONE ELEMENT VALUE of the ref-list slot `rslot` — the
// `.push`/indexed-assign twin of `emitArr`'s per-element `elCtx` seeds. A NESTED-list
// element (kinds 4/6/7/8/9/10) resets the list context to the INNER list's kind so a
// bare literal value builds the RIGHT inner list: `b.push([300])` over `i64[][]` must
// build an i64 inner list (the plain-`emitExpr` default built the i32 list — a wrapper
// heap mismatch, INVALID WASM); same for `d.push([2.5])` over `f32[][]` (the literal
// self-classified f64) and the row-assign `b[i] = [7, 8]`. A kind-9 element seeds the
// inner ref-list slot (recursively, so any depth composes); a NULLABLE element (the
// `(i32[] | null)[]` / `(<ref-array> | null)[]` niches) seeds the null-element ref,
// exactly as the literal path does. A non-literal value (an ident, a call) reads none
// of these seeds, so the context is inert for it — literal-only semantics preserved.
function refElemValueCtx(rslot: i32): ExpCtx {
  const c = expCtxHere()
  const k = rlElemKindTbl[rslot]
  if k == 4 {
    c.listKind = 0
  } else if k == 6 {
    c.listKind = 3
  } else if k == 7 {
    c.listKind = 4
  } else if k == 8 {
    c.listKind = 6
  } else if k == 10 {
    c.listKind = 7
  } else if k == 9 {
    c.listKind = 5
    c.listSlot = rlElemInnerSlot(rslot)
  }
  if rlElemNullable[rslot] == 1 {
    if k == 4 { c.nulList = true }
    if k == 6 { c.nulRefHeap = mkListIdx }
    if k == 7 { c.nulRefHeap = fl64TypeIdx }
    if k == 8 { c.nulRefHeap = il64TypeIdx }
    if k == 10 { c.nulRefHeap = fl32TypeIdx }
    if k == 9 && c.listSlot >= 0 { c.nulRefHeap = rlWrapIdx[c.listSlot] }
    // A nullable-CLOSURE element (kind 5): a `null` value stores as `ref.null` of the
    // shared closure fat-pointer (the slot heap, `cloStructIdx`).
    if k == 5 { c.nulRefHeap = rlElemHeap[rslot] }
    // A nullable-MAP element (kind 3): `ref.null` of the element's own map struct.
    if k == 3 { c.nulRefHeap = rlElemHeap[rslot] }
  }
  // A MAP element (kind 3): a `Map()` value builds the ELEMENT's map struct, not the
  // ambient one. Without this seed `xs.push(Map())` / `xs[i] = Map()` over a
  // `{[string]: V}[]` `struct.new`s the MONO map into a backing typed to the element's
  // own struct — invalid wasm, `vl check` rc 0 — for every value type that interns a
  // per-value map struct. The shape is `rlElemMapShape`, the ref-list twin of the
  // map-VALUE boundary's `mvInnerMapShape`. Inert for a non-`Map()` value: only
  // `emitMapNew` reads the seed, and it clears it.
  if k == 3 { c.mapSlot = rlElemMapShape(rslot) }
  c
}

// True if the ref-list slot `rslot` holds NESTED-LIST elements (an inner list wrapper —
// scalar kinds 4/6/7/8/10 or a ref inner list, kind 9): the element-value emit must run
// under `refElemValueCtx` so a literal value builds the inner list, not the default.
function rlElemIsNestedList(rslot: i32) {
  const k = rlElemKindTbl[rslot]
  k == 4 || k == 6 || k == 7 || k == 8 || k == 9 || k == 10
}

// Whether a ref-list slot's element-VALUE emit needs `refElemValueCtx` at all — the ONE
// predicate the `.push` and indexed-assign boundaries share.
//
// It exists because the set it names had already been taught in halves. Each boundary
// spelled `if rlElemIsNestedList(rslot) { … }` and then bolted the nullable-CLOSURE niche
// on beside it as a second `if`, hand-copied at both sites; the MAP element was a third
// member nobody added at either. A slot whose element context is inert reads exactly the
// ambient seeds (`expCtxHere`), so widening this predicate cannot move a cell whose kind
// `refElemValueCtx` does not touch.
function rlElemNeedsValueCtx(rslot: i32) {
  const k = rlElemKindTbl[rslot]
  if rlElemIsNestedList(rslot) { return true }
  if k == 3 { return true }
  k == 5 && rlElemNullable[rslot] == 1
}

// Stage a list-op RECEIVER that is not a bare local — a module GLOBAL, a struct FIELD, an
// INDEX — into the op frame's `recvRef` scratch slot (`base + 3`). The ONE home for the
// evaluate-once rule `.push` / `.pop` / `.clear` / `.pop() ?? d` each spelled inline.
//
// `emitExpr` runs the receiver read (for a global: `global.get`, plus the non-const cell's
// own `ref.as_non_null`). A NULLABLE LIST cell needs the recover that read deliberately
// WITHHOLDS: kinds 15 / 18 and the four distinct-backing scalar niches stay raw so a
// `g != null` compare can test the cell, while this scratch slot is a NON-null wrapper
// ref. Without it a `let g: i32[] | null = []` / `let g: S[] | null = []` global rejected
// the module at the stash — `type mismatch: expected (ref $type), found (ref null $type)`,
// `vl check` clean — while the same lines over a LOCAL ran (a local receiver IS the frame
// slot and is never staged). The receiver of a list op is non-null by the checker's own
// narrowing (an un-narrowed `g.push(x)` over `g: T[] | null` is a type error), so the
// recover never traps.
function stageListRecv(body: i32[], objIx: i32, fnIx: i32, base: i32) {
  if emitExpr(body, objIx, fnIx) < 0 { return -1 }
  const r = P.nodes[unwrapParen(objIx)]
  if r is Ident {
    if globalNulListCellRead(r.identName) {
      fbRefAsNonNull() // 0xd4
    }
  }
  fbLocalSet(base + 3) // local.set recvRef
  0
}

// Lower a `recv.push(x)` member-call statement onto `body` — the growable-list append
// (mirroring `toWasm.ts`'s `__list_grow__`/`__list_push__`, but INLINED). `recv` must be
// a bare `Ident` naming a LIST local/param (so its `local.get` is side-effect-free and
// can be re-read), and the call takes exactly one i32 argument.
//
// The sequence, with `L` = the list local index and scratch locals `pushVal` (V),
// `pushNewCap` (NC), `pushNewBacking` (NB):
//   V = x                                              ; stash the value
//   if len(L) == cap(L) {                              ; grow when full
//     NC = (cap(L) == 0) ? 4 : cap(L) * 2              ; 2× growth, floor 4 (§VL.2)
//     NB = array.new_default $aTypeIdx NC              ; zero-init spare slots
//     array.copy NB 0 backing(L) 0 len(L)              ; copy the live elements
//     L.backing = NB ; L.cap = NC                      ; swap in the larger backing
//   }
//   backing(L)[len(L)] = V                             ; write at the end
//   L.len = len(L) + 1                                 ; bump the length
// `len`/`cap`/`backing` are `struct.get $lTy` of fields 1/2/0; the field setters are
// `struct.set $lTy`. `array.copy` is `0xfb 0x11 <dest> <src>` (both the backing array).
//
// G7-ref: a REF-list `.push` runs the IDENTICAL sequence over the ref list/backing type
// indices + ref scratch triple (`lTy = rlTypeIdx`, `aTy = raTypeIdx`, scratch base
// `refPushScratchBase`). The value is a struct ref / union box (emitted by the SAME
// `emitExpr`); `array.new_default` over the `(ref null $elem)` backing zero-inits spare
// slots to null, and `array.set` writes the non-null value (a subtype of the slot).
function emitPush(body: i32[], callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      const recv = P.nodes[callee.memObj]
      // The receiver must PRODUCE a list — either a bare list local/param (`xs.push`) or
      // a struct-FIELD array read (`P.nodes.push`, gap #3). Both `exprArray`/`exprRefArray`
      // already classify a `Member` array-field read, so the only extra work for a field
      // receiver is to materialize its wrapper ref into the `recvRef` scratch slot.
      const isRef = exprRefArray(callee.memObj, fnIx)
      const isStr = exprStringArray(callee.memObj, fnIx)
      const isF64 = exprF64Array(callee.memObj, fnIx)
      const isI64 = exprI64Array(callee.memObj, fnIx)
      const isF32 = exprF32Array(callee.memObj, fnIx)
      // A LITERAL-UNION array push (`xs.push("a")` over `xs: K[]`) rides the i32-list spine, but the
      // pushed member literal must lower as its atom id — seed `pendingLitUnion` for the value emit.
      const isLitArr = nodeArrayElemIsLitUnion(callee.memObj)
      // A `(boolean | null)[]` push (`p.push(null)`) also rides the i32-list spine, but a `null`
      // value must lower as the sentinel 2 — seed `pendingNulBool` for the value emit.
      const isNbArr = nodeArrayElemIsNulBool(callee.memObj)
      // A `(K | null)[]` push (`p.push("a")` / `p.push(null)`) rides the same i32-list spine: a member
      // literal lowers as its atom id, a `null` as the `-1` sentinel — seed BOTH for the value emit.
      const isNlluArr = nodeArrayElemIsNulLitUnion(callee.memObj)
      // A `(string | null)[]` push (`p.push(null)`) rides the STRING-list spine (the niche's
      // backing is a plain string list), but a `null` value must lower as `ref.null $aTypeIdx`
      // — seed `pendingNulString`, the same seed `emitArr` gives that list's element LITERALS.
      // Without it `p.push(null)` reached `emitNullLitNode` with no context and the whole
      // module was rejected (`bare null needs a struct-typed context`), `vl check` rc 0.
      const isNsArr = nodeArrayElemIsNulStr(callee.memObj)
      if (
        !isRef &&
        !isStr &&
        !isF64 &&
        !isI64 &&
        !isF32 &&
        !exprArray(callee.memObj, fnIx)
      ) {
        return emitFail("emitProgram: .push receiver is not a list")
      }
      // Pick the list/backing type indices + scratch base for this push kind. A string
      // list (`string[]`) runs the IDENTICAL grow/append sequence over its wrapper/backing
      // (`mkListIdx`/`mkArrIdx`) + the string-push quad: `array.new_default` over the
      // `(ref null $aTypeIdx)` backing zero-inits spare slots to null, and `array.set`
      // writes the non-null string ref (a subtype of the slot).
      let lTy = lTypeIdx
      let aTy = aTypeIdx
      let base = pushScratchBase
      // The ELEMENT-VALUE seeds — the indexed-store block's exact set (see `emitArr` for
      // the statement of the rule): kind 1 the declared element STRUCT, kind 2 the union
      // box ("" for a non-union element), kinds 4/6/7/8/9/10 the INNER list's context, so
      // `xs.push({ … })` / `i64[][].push([300])` build what the slot declares.
      let pushStructIdx = -1
      let pushUnionNm = ""
      let pushNestSlot = -1
      if isRef {
        if !rlUsed {
          return emitFail(
            "emitProgram: ref .push but ref list type not collected",
          )
        }
        const rslot = refListSlotOfExpr(callee.memObj, fnIx)
        lTy = rlWrapIdx[rslot]
        aTy = rlBackIdx[rslot]
        base = refPushScratchBaseFor(rslot)
        if rlElemKindTbl[rslot] == 1 { pushStructIdx = rlElemStructRow(rslot) }
        if rlElemKindTbl[rslot] == 2 { pushUnionNm = rlElemName[rslot] }
        // The same ONE predicate the indexed-assign boundary uses (see there).
        if rlElemNeedsValueCtx(rslot) { pushNestSlot = rslot }
      } else if isStr {
        if !slUsed {
          return emitFail(
            "emitProgram: string .push but string list type not collected",
          )
        }
        lTy = mkListIdx
        aTy = mkArrIdx
        base = strPushScratchBase
      } else if isF64 {
        // The three non-i32 SCALAR kinds run the IDENTICAL grow/append sequence over their
        // own wrapper/backing, staged in their own typed push quad (`pushF64Val` is an f64
        // local, and so on) — only the three type indices below differ.
        if !fa64Used {
          return emitFail(
            "emitProgram: f64 .push but f64 list type not collected",
          )
        }
        lTy = fl64TypeIdx
        aTy = fa64TypeIdx
        base = f64PushScratchBase
      } else if isI64 {
        if !ia64Used {
          return emitFail(
            "emitProgram: i64 .push but i64 list type not collected",
          )
        }
        lTy = il64TypeIdx
        aTy = ia64TypeIdx
        base = i64PushScratchBase
      } else if isF32 {
        if !fa32Used {
          return emitFail(
            "emitProgram: f32 .push but f32 list type not collected",
          )
        }
        lTy = fl32TypeIdx
        aTy = fa32TypeIdx
        base = f32PushScratchBase
      } else if !lUsed {
        return emitFail("emitProgram: .push but list type not collected")
      }
      // RECEIVER RESOLUTION (the shared rule — `emitPop`/`emitClear`/`emitPopOr` mirror it).
      // Resolve the receiver to a wasm local index holding the list-wrapper ref. A bare
      // identifier IS such a local. Every OTHER form — a struct FIELD (`P.nodes`), a module
      // GLOBAL, an INDEX (`g[0].push(x)`) — is evaluated ONCE through `emitExpr` into the
      // `recvRef` scratch slot (`base + 3`) and pushed through that. NO WRITE-BACK is needed
      // in any of them: the wrapper is mutated IN PLACE by reference, and a growth swaps the
      // backing on that same shared wrapper, so the mutation is visible through the field /
      // global / outer array / map.
      let lIdx = -1
      if recv is Ident {
        lIdx = localIndexOf(fnIx, recv.identName)
        if lIdx < 0 {
          // A module-GLOBAL list ident: `emitExpr` runs the existing Ident→global read
          // (`global.get` + `ref.as_non_null` for a non-const ref cell).
          if globalIndexOfSid(sidOfNode(callee.memObj)) < 0 {
            return emitFail("emitProgram: .push receiver is not a list local")
          }
          if stageListRecv(body, callee.memObj, fnIx, base) < 0 { return -1 }
          lIdx = base + 3
        }
      } else if recv is Member {
        if stageListRecv(body, callee.memObj, fnIx, base) < 0 { return -1 }
        lIdx = base + 3
      } else if recv is Index {
        // An INDEXED receiver (`g[0].push(x)` — push onto an INNER list of a nested array, or
        // onto a list read from a list-valued map). The classifiers above already recognize a
        // nested `g[i]` read as its inner list, so `lTy`/`aTy`/`base` are the inner list's.
        if stageListRecv(body, callee.memObj, fnIx, base) < 0 { return -1 }
        lIdx = base + 3
      } else {
        return emitFail(
          "emitProgram: .push receiver must be a local, struct field, or index",
        )
      }
      if true {
        if c.callArgs.length != 1 {
          return emitFail("emitProgram: .push takes exactly one argument")
        }
        const valIdx = base
        const capIdx = base + 1
        const backIdx = base + 2
        // V = x  (an f64-list push coerces/encodes the value as f64)
        pendingStructIdx = pushStructIdx
        if isF64 {
          if emitExprAsF64(body, c.callArgs[0], fnIx) < 0 { return -1 }
        } else if isI64 {
          if emitExprAsI64(body, c.callArgs[0], fnIx) < 0 { return -1 }
        } else if isF32 {
          // an f32-list push coerces/encodes the value as f32 (a float literal re-encodes).
          const savedPF32 = pendingF32
          pendingF32 = true
          if emitExprAsF32(body, c.callArgs[0], fnIx) < 0 { return -1 }
          pendingF32 = savedPF32
        } else if pushUnionNm != "" {
          if emitUnionBoxArg(body, pushUnionNm, c.callArgs[0], fnIx) < 0 {
            return -1
          }
        } else if pushNestSlot >= 0 {
          // A nested-list element push: the value builds as the INNER list (an inert
          // context for a non-literal value — an ident/call emits unchanged).
          const pnCtx = refElemValueCtx(pushNestSlot)
          if emitExprExpect(body, c.callArgs[0], fnIx, pnCtx) < 0 { return -1 }
        } else if isLitArr {
          const pluCtx = expCtxHere()
          pluCtx.litUnion = 1
          if emitExprExpect(body, c.callArgs[0], fnIx, pluCtx) < 0 { return -1 }
        } else if isNbArr {
          const pnbCtx = expCtxHere()
          pnbCtx.nulBool = true
          if emitExprExpect(body, c.callArgs[0], fnIx, pnbCtx) < 0 { return -1 }
        } else if isNlluArr {
          const pnluCtx = expCtxHere()
          pnluCtx.litUnion = 1
          pnluCtx.nulLitUnion = true
          if emitExprExpect(body, c.callArgs[0], fnIx, pnluCtx) < 0 {
            return -1
          }
        } else if isNsArr && exprIsLitAtom(c.callArgs[0], fnIx) {
          // A literal-union ATOM pushed into a `(string | null)[]`. The niche's backing IS a
          // plain string list, so the atom widens exactly as it does for a `string[]` — and a
          // widened member string is non-null, so it needs no null seed. A `null` value is not
          // a lit atom and still takes the `nulString` arm below.
          if emitStrValue(body, c.callArgs[0], fnIx) < 0 { return -1 }
        } else if isNsArr {
          const pnsCtx = expCtxHere()
          pnsCtx.nulString = true
          if emitExprExpect(body, c.callArgs[0], fnIx, pnsCtx) < 0 { return -1 }
        } else if isStr && exprIsLitAtom(c.callArgs[0], fnIx) {
          // A literal-union ATOM pushed into a `string[]` WIDENS to its member string. The
          // list's backing slot is a `(ref null $aTypeIdx)` and the atom's rep is an i32 id,
          // so without this the store was `expected (ref $type), found i32` — check-clean
          // invalid wasm. This is the same boundary a `string` FIELD store already applies
          // (`scode == 3` + `exprIsLitAtom` → `emitAtomToStr`); the seeds above are all keyed
          // on the RECEIVER's element type, and none of them asks whether the VALUE is an atom.
          if emitStrValue(body, c.callArgs[0], fnIx) < 0 { return -1 }
        } else {
          if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
        }
        pendingStructIdx = -1
        fbLocalSet(valIdx) // local.set
        // if len(L) == cap(L)
        pushListLen(body, lIdx, lTy)
        pushListCap(body, lIdx, lTy)
        fbI32Bin(70) // 0x46 i32.eq
        fbIf(64)     // 0x04 if, 0x40 void blocktype
        // NC = (cap(L) == 0) ? 4 : cap(L) * 2   — via if/else yielding i32
        pushListCap(body, lIdx, lTy)
        fbI32Eqz()         // 0x45 i32.eqz  (cap == 0)
        fbIf(127)          // 0x04 if, 0x7f i32 blocktype (yields an i32)
        fbI32Const(4)      // i32.const 4
        fbElse()           // 0x05 else
        pushListCap(body, lIdx, lTy)
        fbI32Const(2)      // i32.const 2
        fbI32Bin(108)      // 0x6c i32.mul
        fbEnd()            // 0x0b end (if/else)
        fbLocalSet(capIdx) // local.set NC
        // NB = array.new_default $aTy NC
        fbLocalGet(capIdx)     // local.get NC
        fbArrayNewDefault(aTy) // 0xfb 0x07 <aTy>
        fbLocalSet(backIdx)    // local.set NB
        // array.copy NB 0 backing(L) 0 len(L)
        fbLocalGet(backIdx)              // local.get NB (dest)
        fbI32Const(0)                    // i32.const 0 (dest offset)
        pushListBacking(body, lIdx, lTy) // src
        fbI32Const(0)                    // i32.const 0 (src offset)
        pushListLen(body, lIdx, lTy)     // count
        fbArrayCopy(aTy, aTy)            // 0xfb 0x11 <dest type> <src type>
        // L.backing = NB
        fbLocalGet(lIdx)    // local.get L
        fbLocalGet(backIdx) // local.get NB
        fbStructSet(lTy, 0) // 0xfb 0x05 <lTy> field 0: backing
        // L.cap = NC
        fbLocalGet(lIdx)    // local.get L
        fbLocalGet(capIdx)  // local.get NC
        fbStructSet(lTy, 2) // 0xfb 0x05 <lTy> field 2: cap
        fbEnd()             // 0x0b end (if)
        // backing(L)[len(L)] = V
        pushListBacking(body, lIdx, lTy)
        pushListLen(body, lIdx, lTy)
        fbLocalGet(valIdx) // local.get V
        fbArraySet(aTy)    // 0xfb 0x0e <aTy>
        // L.len = len(L) + 1
        fbLocalGet(lIdx)    // local.get L
        pushListLen(body, lIdx, lTy)
        fbI32Const(1)       // i32.const 1
        fbI32Bin(106)       // 0x6a i32.add
        fbStructSet(lTy, 1) // 0xfb 0x05 <lTy> field 1: len
        return 0
      }
    }
  }
  emitFail("emitProgram: expected a .push call")
}

// Lower a `.pop()` value-position call onto `body`: remove + return the list's last
// element. Generic over the list kind — picks the wrapper/backing type indices the same
// way `.push` does (i32 list, REF list `T[]`/`N[]`/`{[string]:i32}[]`, or string list).
// Sequence (no scratch — the receiver is a bare local, referenced repeatedly):
//   L.len = len - 1            (decrement first, so the new len IS the popped index)
//   push backing[L.len]        (the removed element; `ref.as_non_null` for a ref/string
//                               element so a non-null struct/union/map/string surfaces)
// The receiver must be a bare list local. An empty-list pop is the caller's contract
// (reading `backing[-1]` would trap) — matched to the host semantics of `.pop()`.
function emitPop(body: i32[], callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      const recv = P.nodes[callee.memObj]
      if c.callArgs.length != 0 {
        return emitFail("emitProgram: .pop takes no arguments")
      }
      const isRef = exprRefArray(callee.memObj, fnIx)
      const isStr = exprStringArray(callee.memObj, fnIx)
      if !isRef && !isStr && !exprArray(callee.memObj, fnIx) {
        return emitFail("emitProgram: .pop receiver is not a list")
      }
      // The popped element is a REF (struct / union box / map struct / string) for a
      // ref or string list — surface it non-null; an i32 list yields a raw i32. `base` is
      // the scratch frame whose `+3` `recvRef` slot holds a struct-FIELD receiver's wrapper
      // ref (same frame `.push` uses) — used only for a Member receiver.
      let lTy = lTypeIdx
      let aTy = aTypeIdx
      let base = pushScratchBase
      let elemIsRef = false
      if isRef {
        if !rlUsed {
          return emitFail(
            "emitProgram: ref .pop but ref list type not collected",
          )
        }
        const rslot = refListSlotOfExpr(callee.memObj, fnIx)
        lTy = rlWrapIdx[rslot]
        aTy = rlBackIdx[rslot]
        base = refPushScratchBaseFor(rslot)
        elemIsRef = true
      } else if isStr {
        if !slUsed {
          return emitFail(
            "emitProgram: string .pop but string list type not collected",
          )
        }
        lTy = mkListIdx
        aTy = mkArrIdx
        base = strPushScratchBase
        elemIsRef = true
      } else if !lUsed {
        return emitFail("emitProgram: .pop but list type not collected")
      }
      // Receiver resolution — `emitPush`'s rule (see there): a bare local IS the local, a
      // struct FIELD (`T.scopes`) or a global stages into `recvRef` (`base + 3`), no write-back.
      let lIdx = -1
      if recv is Ident {
        lIdx = localIndexOf(fnIx, recv.identName)
        if lIdx < 0 {
          if globalIndexOfSid(sidOfNode(callee.memObj)) < 0 {
            return emitFail("emitProgram: .pop receiver is not a list local")
          }
          if stageListRecv(body, callee.memObj, fnIx, base) < 0 { return -1 }
          lIdx = base + 3
        }
      } else if recv is Member {
        if stageListRecv(body, callee.memObj, fnIx, base) < 0 { return -1 }
        lIdx = base + 3
      } else {
        return emitFail(
          "emitProgram: .pop receiver must be a local or struct field",
        )
      }
      if true {
        // A BOOLEAN-element list pops CHECKED: `boolean | null` rides the i32
        // niche (true=1 / false=0 / null=2), so an empty pop yields the sentinel
        // 2 instead of trapping — mirroring the host's nullable `.pop()` (B6).
        if !elemIsRef {
          if listElemIsBool(callee.memObj, fnIx) {
            pushListLen(body, lIdx, lTy) // cond: len != 0
            fbIf(127)                    // 0x04 if, 0x7f i32 result blocktype
            ctrlEnter()
            fbLocalGet(lIdx)             // L.len = len - 1
            pushListLen(body, lIdx, lTy)
            fbI32Const(1)
            fbI32Bin(107)                // 0x6b i32.sub
            fbStructSet(lTy, 1)          // field 1: len
            pushListBacking(body, lIdx, lTy)
            pushListLen(body, lIdx, lTy)
            fbArrayGet(aTy)              // the popped element (0/1)
            fbElse()                     // 0x05 else — empty → the null sentinel
            fbI32Const(2)
            fbEnd()                      // 0x0b end
            ctrlLeave()
            return 0
          }
        }
        // L.len = len - 1
        fbLocalGet(lIdx)    // local.get L
        pushListLen(body, lIdx, lTy)
        fbI32Const(1)       // i32.const 1
        fbI32Bin(107)       // 0x6b i32.sub
        fbStructSet(lTy, 1) // 0xfb 0x05 <lTy> field 1: len
        // backing[L.len]  (the just-decremented len is the popped element's index)
        pushListBacking(body, lIdx, lTy)
        pushListLen(body, lIdx, lTy)
        fbArrayGet(aTy) // 0xfb 0x0b <aTy>
        if elemIsRef {
          wU8(212) // 0xd4 ref.as_non_null
        }
        return 0
      }
    }
  }
  emitFail("emitProgram: expected a .pop call")
}

// Lower a `.clear()` STATEMENT onto `body`: reset the list's logical length to 0,
// RETAINING the backing (a refill reuses it; cap is untouched) — mirroring the
// host's `.clear()` (B6). Generic over the list kind, with `emitPop`'s receiver
// resolution (bare local, module global, or struct field via the `recvRef` scratch).
function emitClear(body: i32[], callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if c.callArgs.length != 0 {
        return emitFail("emitProgram: .clear takes no arguments")
      }
      const recv = P.nodes[callee.memObj]
      const isRef = exprRefArray(callee.memObj, fnIx)
      const isStr = exprStringArray(callee.memObj, fnIx)
      if !isRef && !isStr && !exprArray(callee.memObj, fnIx) {
        return emitFail("emitProgram: .clear receiver is not a list")
      }
      let lTy = lTypeIdx
      let base = pushScratchBase
      if isRef {
        if !rlUsed {
          return emitFail(
            "emitProgram: ref .clear but ref list type not collected",
          )
        }
        const rslot = refListSlotOfExpr(callee.memObj, fnIx)
        lTy = rlWrapIdx[rslot]
        base = refPushScratchBaseFor(rslot)
      } else if isStr {
        if !slUsed {
          return emitFail(
            "emitProgram: string .clear but string list type not collected",
          )
        }
        lTy = mkListIdx
        base = strPushScratchBase
      } else if !lUsed {
        return emitFail("emitProgram: .clear but list type not collected")
      }
      let lIdx = -1
      if recv is Ident {
        lIdx = localIndexOf(fnIx, recv.identName)
        if lIdx < 0 {
          if globalIndexOfSid(sidOfNode(callee.memObj)) < 0 {
            return emitFail("emitProgram: .clear receiver is not a list local")
          }
          if stageListRecv(body, callee.memObj, fnIx, base) < 0 { return -1 }
          lIdx = base + 3
        }
      } else if recv is Member {
        if stageListRecv(body, callee.memObj, fnIx, base) < 0 { return -1 }
        lIdx = base + 3
      } else {
        return emitFail(
          "emitProgram: .clear receiver must be a local or struct field",
        )
      }
      // L.len = 0
      fbLocalGet(lIdx)
      fbI32Const(0)
      fbStructSet(lTy, 1) // 0xfb 0x05 <lTy> field 1: len
      return 0
    }
  }
  emitFail("emitProgram: expected a .clear call")
}

// Lower a checked `.get(i)` over a STRUCT-element ref list onto `body`, leaving a
// `(ref null $S)` on the stack: in-bounds yields the backing slot as-is (already
// nullable-widened), out-of-bounds `ref.null $S` — `xs.get(9)` is `null`, mirroring
// the host's checked list read. ONE unsigned compare (`idx u< len`) covers both the
// negative and the past-len cases. The receiver and index are each emitted twice
// (the bounds check + the read), so both must be PURE re-reads: a bare name receiver
// and a literal/name index — anything else fails loudly.
function emitListGet(body: i32[], callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if c.callArgs.length != 1 {
        return emitFail("emitProgram: .get takes exactly one argument")
      }
      if structListPopGetElem(callIx, fnIx) < 0 || !rlUsed {
        return emitFail("emitProgram: .get receiver is not a struct list")
      }
      const rslot = refListSlotOfExpr(callee.memObj, fnIx)
      const elemHeap = rlElemHeap[rslot]
      const recvN = P.nodes[unwrapParen(callee.memObj)]
      let okRecv = false
      if recvN is Ident { okRecv = true }
      if !okRecv {
        return emitFail(
          "emitProgram: .get receiver must be a named list binding",
        )
      }
      const idxN = P.nodes[unwrapParen(c.callArgs[0])]
      let okIdx = false
      if idxN is NumLit { okIdx = true }
      if idxN is Ident { okIdx = true }
      if !okIdx {
        return emitFail("emitProgram: .get index must be a literal or a name")
      }
      // cond: idx u< len
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      fbStructGet(rlWrapIdx[rslot], 1) // field 1: len
      fbI32Bin(73)                     // 0x49 i32.lt_u
      // if (result (ref null $elem))
      wU8(4)                           // 0x04 if
      wU8(99)                          // 0x63 (ref null ht) result blocktype
      wSLEB(elemHeap)
      ctrlEnter()
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      fbStructGet(rlWrapIdx[rslot], 0) // field 0: backing
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      fbArrayGet(rlBackIdx[rslot])     // -> (ref null $elem)
      fbElse()                         // 0x05 else
      wU8(208)                         // 0xd0 ref.null
      wSLEB(elemHeap)
      fbEnd()                          // 0x0b end
      ctrlLeave()
      return 0
    }
  }
  emitFail("emitProgram: expected a .get call")
}

// Lower a FUSED `xs.get(i) ?? d` over a SCALAR-element list (i32 / boolean / f64)
// onto `body`: ONE unsigned bounds compare (`i u< len`) selects the element read or
// the default — the `T | null` intermediate never materializes (the host's checked
// `.get` composed with `??` reduces to the same branch). The receiver must be a
// bare name and the index a literal/name — both are re-read (bounds check + read).
function emitListGetOr(body: i32[], getIx: i32, defIx: i32, fnIx: i32) {
  const c = P.nodes[getIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if c.callArgs.length != 1 {
        return emitFail("emitProgram: .get takes exactly one argument")
      }
      // The scalar element kind (i32 / f64 / i64) selects the list types + read rep — one
      // descriptor lookup instead of an `isF64 ? … : …` fork (so i64 is a descriptor arm).
      const ek = scalarListElemKind(callee.memObj, fnIx)
      if ek == null {
        return emitFail("emitProgram: .get receiver is not a scalar list")
      }
      if !scalarListUsed(ek) {
        return emitFail("emitProgram: .get but list type not collected")
      }
      const lTy = scalarListWrap(ek)
      const aTy = scalarListBack(ek)
      const recvN = P.nodes[unwrapParen(callee.memObj)]
      let okRecv = false
      if recvN is Ident { okRecv = true }
      if !okRecv {
        return emitFail(
          "emitProgram: .get receiver must be a named list binding",
        )
      }
      const idxN = P.nodes[unwrapParen(c.callArgs[0])]
      let okIdx = false
      if idxN is NumLit { okIdx = true }
      if idxN is Ident { okIdx = true }
      if idxN is Unary {
        // A NEGATIVE literal index (`xs.get(-1)`) is pure too — the unsigned
        // bounds compare maps it past `len`, so it takes the default branch.
        if idxN.unOp == "-" {
          const idxArgN = P.nodes[unwrapParen(idxN.unArg)]
          if idxArgN is NumLit { okIdx = true }
        }
      }
      if !okIdx {
        return emitFail("emitProgram: .get index must be a literal or a name")
      }
      // cond: idx u< len  (one unsigned compare covers negative + past-len)
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      fbStructGet(lTy, 1)           // field 1: len
      fbI32Bin(73)                  // 0x49 i32.lt_u
      fbIf(scalarListBlocktype(ek)) // 0x04 if, the element's result blocktype
      ctrlEnter()
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      fbStructGet(lTy, 0)           // field 0: backing
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      fbArrayGet(aTy)               // 0xfb 0x0b array.get — the element
      fbElse()                      // 0x05 else
      if emitScalarValue(body, defIx, fnIx, ek) < 0 { return -1 }
      fbEnd()                       // 0x0b end
      ctrlLeave()
      return 0
    }
  }
  emitFail("emitProgram: expected a list .get call")
}

// Lower a FUSED `xs.pop() ?? d` over a SCALAR-element (i32 / boolean) list onto
// `body`: `len != 0` selects the decrement-and-read (the popped element) or the
// default. The receiver resolves like `emitPop` (bare local, module global, or
// struct field — the latter two staged into the push frame's `recvRef` scratch).
function emitPopOr(body: i32[], popIx: i32, defIx: i32, fnIx: i32) {
  const c = P.nodes[popIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if c.callArgs.length != 0 {
        return emitFail("emitProgram: .pop takes no arguments")
      }
      if !lUsed {
        return emitFail("emitProgram: .pop but list type not collected")
      }
      const recv = P.nodes[callee.memObj]
      const lTy = lTypeIdx
      const aTy = aTypeIdx
      const base = pushScratchBase
      let lIdx = -1
      if recv is Ident {
        lIdx = localIndexOf(fnIx, recv.identName)
        if lIdx < 0 {
          if globalIndexOfSid(sidOfNode(callee.memObj)) < 0 {
            return emitFail("emitProgram: .pop receiver is not a list local")
          }
          if stageListRecv(body, callee.memObj, fnIx, base) < 0 { return -1 }
          lIdx = base + 3
        }
      } else if recv is Member {
        if stageListRecv(body, callee.memObj, fnIx, base) < 0 { return -1 }
        lIdx = base + 3
      } else {
        return emitFail(
          "emitProgram: .pop receiver must be a local or struct field",
        )
      }
      // cond: len != 0 (len is never negative)
      pushListLen(body, lIdx, lTy)
      fbIf(127) // 0x04 if, 0x7f i32 result blocktype
      ctrlEnter()
      // L.len = len - 1; backing[L.len]
      fbLocalGet(lIdx)
      pushListLen(body, lIdx, lTy)
      fbI32Const(1)
      fbI32Bin(107)       // 0x6b i32.sub
      fbStructSet(lTy, 1) // field 1: len
      pushListBacking(body, lIdx, lTy)
      pushListLen(body, lIdx, lTy)
      fbArrayGet(aTy)     // the popped element
      fbElse()            // 0x05 else — empty list → the default
      if emitExpr(body, defIx, fnIx) < 0 { return -1 }
      fbEnd()             // 0x0b end
      ctrlLeave()
      return 0
    }
  }
  emitFail("emitProgram: expected a list .pop call")
}

function emitMapFilter(body: i32[], callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      const isMap = callee.memProp == "map"
      if c.callArgs.length != 1 {
        return emitFail(
          "emitProgram: .map/.filter takes exactly one callback argument",
        )
      }
      const recvK = mfRecvKindOf(callee.memObj, fnIx)
      if recvK == null {
        return emitFail(
          "emitProgram: .map/.filter receiver is not a supported list",
        )
      }
      const resK = mfResultKindOf(callIx, fnIx)
      if resK == null {
        return emitFail("emitProgram: unsupported .map/.filter element type")
      }
      // The ref-list slot for a kind-2 result (`.filter` over a struct array) — picks the
      // result backing/wrapper + the matching dst scratch local. -1 for a non-ref result.
      const dstSlot = mfResultSlotOf(callIx, fnIx)
      const cbFe = mfCallbackFe(c.callArgs[0], fnIx)
      let sig = -1
      if cbFe >= 0 {
        sig = fnSigIdxOfFn(cbFe)
      } else {
        // A CLOSURE-VALUE callback (a function-typed param/binding — `xs.map(f)` where
        // `f: (i32) => i32`): no lifted fe to inline, so resolve the interned sig from the closure's
        // own `$fnsig` key. The loop `call_ref`s the closure value (emitted into `cL` below via the
        // Ident path) exactly as for a named-function callback — enabling callback-passing HOFs.
        const ck = mfCallbackCloKey(c.callArgs[0], fnIx)
        if ck != "" {
          const cp = cloSigPosOfKey(ck)
          if cp >= 0 { sig = cloSigBase + cp }
        }
      }
      if sig < 0 {
        return emitFail(
          "emitProgram: .map/.filter callback signature is not interned",
        )
      }
      // The SOURCE wrapper/backing heap types (+ whether the element is a ref that
      // needs `ref.as_non_null` after `array.get` — a nullable-NICHE element does NOT:
      // see `listElemStaysNullable`, which the indexed read asks for the same reason).
      const srcElemNul = listElemStaysNullable(callee.memObj, fnIx)
      let srcWrap = lTypeIdx
      let srcBack = aTypeIdx
      let srcElemRef = false
      let srcSlot = -1
      if recvK == "f64" {
        if !fa64Used {
          return emitFail(
            "emitProgram: .map/.filter over f64[] but f64 list type not collected",
          )
        }
        srcWrap = fl64TypeIdx
        srcBack = fa64TypeIdx
      } else if recvK == "i64" {
        if !ia64Used {
          return emitFail(
            "emitProgram: .map/.filter over i64[] but i64 list type not collected",
          )
        }
        srcWrap = il64TypeIdx
        srcBack = ia64TypeIdx
      } else if recvK == "f32" {
        if !fa32Used {
          return emitFail(
            "emitProgram: .map/.filter over f32[] but f32 list type not collected",
          )
        }
        srcWrap = fl32TypeIdx
        srcBack = fa32TypeIdx
      } else if recvK == "ref" {
        if !rlUsed {
          return emitFail(
            "emitProgram: .map/.filter over a ref list but ref list type not collected",
          )
        }
        srcSlot = refListSlotOfExpr(callee.memObj, fnIx)
        srcWrap = rlWrapIdx[srcSlot]
        srcBack = rlBackIdx[srcSlot]
        srcElemRef = !srcElemNul
      } else if recvK == "str" {
        // A STRING list: wrapper `$mkListIdx`, backing `$mkArrIdx` (the array of string
        // refs). The element is itself a ref (an `array i32` of code points), so it needs
        // `ref.as_non_null` after `array.get`, exactly like a ref-list element — unless the
        // element is the `(string | null)[]` niche, which keeps the nullable read.
        if !slUsed {
          return emitFail(
            "emitProgram: .map/.filter over string[] but string list type not collected",
          )
        }
        srcWrap = mkListIdx
        srcBack = mkArrIdx
        srcElemRef = !srcElemNul
      } else if !lUsed || !aUsed {
        return emitFail("emitProgram: .map/.filter but list type not collected")
      }
      // The RESULT wrapper/backing heap types.
      let dstWrap = lTypeIdx
      let dstBack = aTypeIdx
      if resK == "f64" {
        if !fa64Used {
          return emitFail(
            "emitProgram: .map result is f64[] but f64 list type not collected",
          )
        }
        dstWrap = fl64TypeIdx
        dstBack = fa64TypeIdx
      } else if resK == "i64" {
        if !ia64Used {
          return emitFail(
            "emitProgram: .map result is i64[] but i64 list type not collected",
          )
        }
        dstWrap = il64TypeIdx
        dstBack = ia64TypeIdx
      } else if resK == "f32" {
        if !fa32Used {
          return emitFail(
            "emitProgram: .map result is f32[] but f32 list type not collected",
          )
        }
        dstWrap = fl32TypeIdx
        dstBack = fa32TypeIdx
      } else if resK == "str" {
        // A STRING-list result: a `.filter` over a string list, or a `.map` whose callback
        // returns a string. The backing `$mkArrIdx` holds string refs; `array.set` stores
        // the callback's (non-null) string result directly.
        if !slUsed {
          return emitFail(
            "emitProgram: .map/.filter result is string[] but string list type not collected",
          )
        }
        dstWrap = mkListIdx
        dstBack = mkArrIdx
      } else if resK == "ref" {
        // A REF-list result (a `.filter` over a struct/union array preserves the element type):
        // the result is the SAME ref list as the source, so its wrapper/backing come from the
        // result slot (== the source slot for `.filter`).
        if !rlUsed {
          return emitFail(
            "emitProgram: .filter result is a ref list but ref list type not collected",
          )
        }
        dstWrap = rlWrapIdx[dstSlot]
        dstBack = rlBackIdx[dstSlot]
      } else if !lUsed || !aUsed {
        return emitFail(
          "emitProgram: .map/.filter result but list type not collected",
        )
      }
      const srcL = mfSrcLocalFor(recvK, srcSlot)
      const dstL = mfDstLocalFor(resK, dstSlot)
      if !fnUsesMapFilter || srcL < 0 || dstL < 0 {
        return emitFail("emitProgram: .map/.filter scratch frame not reserved")
      }
      const iL = mfScratchBase
      const nL = mfScratchBase + 1
      const jL = mfScratchBase + 2
      const cL = mfScratchBase + 3
      // src = <receiver>, evaluated ONCE. (Any nested `.map`/`.filter` in the
      // receiver chain completes — including its result wrapper — before this store,
      // so the shared frame slots are free to reuse.)
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      // A NARROWED nullable-list receiver keeps its nullable slot at EVERY element kind;
      // the src scratch slot is declared non-null (`fbRefRun` writes `0x64`), so recover
      // first (checker-guarded, never traps). See `nulRecvNeedsRecover`.
      if nulRecvNeedsRecover(callee.memObj, fnIx) {
        wU8(212) // 0xd4 ref.as_non_null
      }
      fbLocalSet(srcL)
      // clo = the callback's closure value, built ONCE before the loop. An inline
      // literal / named function constructs it directly; a let-bound value reads its
      // binding (an `Ident` read — it cannot itself contain a HOF site, so the frame
      // slots written above stay live).
      const cbNode = P.nodes[unwrapParen(c.callArgs[0])]
      if cbNode is FuncDecl {
        if emitClosureValue(body, cbFe, fnIx) < 0 { return -1 }
      } else if cbNode is Ident {
        if fnIndexOfSid(sidOfNode(unwrapParen(c.callArgs[0]))) >= 0 {
          if emitClosureValue(body, cbFe, fnIx) < 0 { return -1 }
        } else if emitExpr(body, c.callArgs[0], fnIx) < 0 {
          return -1
        }
      } else {
        return emitFail("emitProgram: unsupported .map/.filter callback")
      }
      fbLocalSet(cL)
      // n = src.len
      fbLocalGet(srcL)
      fbStructGet(srcWrap, 1) // field 1: len
      fbLocalSet(nL)
      // back = array.new_default <dstBack> n
      fbLocalGet(nL)
      fbArrayNewDefault(dstBack)
      fbLocalSet(dstL)
      // i = 0 (and j = 0 for filter)
      fbI32Const(0)
      fbLocalSet(iL)
      if !isMap {
        fbI32Const(0)
        fbLocalSet(jL)
      }
      // block { loop { if i >= n br 1; <element step>; i++; br 0 } }
      fbBlock(64)  // 0x02 block (void)
      ctrlEnter()
      fbLoop(64)   // 0x03 loop (void)
      ctrlEnter()
      fbLocalGet(iL)
      fbLocalGet(nL)
      fbI32Bin(78) // 0x4e i32.ge_s — i >= n?
      fbBrIf(1)    // exit the block
      if isMap {
        // back[i] = call_ref(clo, [elem(i)])
        fbLocalGet(dstL)
        fbLocalGet(iL)
        if (
          emitMfInvoke(body, cL, srcL, iL, srcWrap, srcBack, srcElemRef, sig) <
          0
        ) {
          return -1
        }
        fbArraySet(dstBack) // 0xfb 0x0e <dstBack>
      } else {
        // if call_ref(clo, [elem(i)]): back[j] = elem(i); j++
        if (
          emitMfInvoke(body, cL, srcL, iL, srcWrap, srcBack, srcElemRef, sig) <
          0
        ) {
          return -1
        }
        fbIf(64)      // 0x04 if (void)
        ctrlEnter()
        fbLocalGet(dstL)
        fbLocalGet(jL)
        emitMfElem(body, srcL, iL, srcWrap, srcBack, srcElemRef)
        fbArraySet(dstBack)
        fbLocalGet(jL)
        fbI32Const(1)
        fbI32Bin(106) // 0x6a i32.add
        fbLocalSet(jL)
        fbEnd()
        ctrlLeave()
      }
      fbLocalGet(iL)
      fbI32Const(1)
      fbI32Bin(106) // 0x6a i32.add
      fbLocalSet(iL)
      fbBr(0)       // continue the loop
      fbEnd()       // end loop
      ctrlLeave()
      fbEnd()       // end block
      ctrlLeave()
      // result = wrapper{ back, len, cap }: len = n (map) / j (filter), cap = n.
      fbLocalGet(dstL)
      if isMap { fbLocalGet(nL) } else { fbLocalGet(jL) }
      fbLocalGet(nL)
      fbStructNew(dstWrap)
      return 0
    }
  }
  emitFail("emitProgram: expected a .map/.filter call")
}

// `emitClampIdx`'s dual over plain wasm i32 LOCALS (not the string-op frame): emit
// `clamp(idx, len)` reading `idx` from local `idxL`, `len` from `lenL`, leaving the
// clamped value on the stack. Same JS slice semantics (`idx < 0 ? max(len+idx, 0) :
// min(idx, len)`) built from `select`.
function emitClampLocal(_body: i32[], idxL: i32, lenL: i32) {
  // negCase = max(len+idx, 0) = select( len+idx, 0, (len+idx) > 0 )
  fbLocalGet(lenL)
  fbLocalGet(idxL)
  fbI32Bin(106) // i32.add → (len+idx)  [a]
  fbI32Const(0) // [b]
  fbLocalGet(lenL)
  fbLocalGet(idxL)
  fbI32Bin(106)
  fbI32Const(0)
  fbI32Bin(74)  // 0x4a i32.gt_s → (len+idx) > 0  [cond]
  wU8(27)       // 0x1b select → negCase
  // nonNegCase = min(idx, len) = select( idx, len, idx < len )
  fbLocalGet(idxL)
  fbLocalGet(lenL)
  fbLocalGet(idxL)
  fbLocalGet(lenL)
  fbI32Bin(72) // 0x48 i32.lt_s → idx < len  [cond]
  wU8(27)      // select → nonNegCase
  // result = select( negCase, nonNegCase, idx < 0 )
  fbLocalGet(idxL)
  fbI32Const(0)
  fbI32Bin(72) // 0x48 i32.lt_s → idx < 0
  wU8(27)      // select → clamped
  0
}

// The WRAPPER heap-type index the nullable-COLLECTION cell at `exprIx` holds:
//
//   >= 0  the wrapper's heap type — `$lTypeIdx` for the i32-backed `i32[] | null`, the
//         leaf list's own wrapper for a DISTINCT-backing scalar list (`string[] | null`,
//         `f64[] | null`, `i64[] | null`, `f32[] | null`), this ref-list slot's wrapper for
//         a nullable ref array (`i32[][] | null`, `S[] | null`).
//   -2    a nullable collection whose wrapper this emit cannot NAME — a nullable ref array
//         whose element slot never resolved. Still a nullable collection (so the recover
//         below claims it); a lowering that needs the index itself must decline.
//   -1    not a nullable collection.
//
// ONE HOME FOR THE FAMILY, because a consumer that knows the rep is nullable and a consumer
// that knows its wrapper must never disagree: `nulRecvNeedsRecover` is exactly "this answered
// something", and `??` declares its block type off the index. Spelling the three-family
// disjunction twice is how a rep gets a null TEST and no recover.
function nulCollWrapHeap(exprIx: i32, fnIx: i32) {
  if exprNullableList(exprIx, fnIx) { return lTypeIdx }
  const nsk = exprNulScalarListKind(exprIx, fnIx)
  if nsk != null { return nulScalarListWrapHeap(nsk) }
  if exprNullableRefArray(exprIx, fnIx) {
    const s = refListSlotOfExpr(exprIx, fnIx)
    if s >= 0 && s < rlWrapIdx.length { return rlWrapIdx[s] }
    return -2
  }
  -1
}

// TRUE when `exprIx` names a NARROWED nullable COLLECTION whose cell still holds a
// `(ref null $wrap)` — every rep a list/map OPERATION must `ref.as_non_null` before the
// wrapper `struct.get`, because the wrapper field demands `(ref $wrap)`.
//
// This is the READ dual of `emitNulIsNullTest`'s niche disjunction, and the two must name
// the same reps for the same reason its header gives: a rep the null TEST claims but an
// operation's recover does not is `vl check`-clean INVALID WASM (`type mismatch: expected
// (ref $type), found (ref null $type)`), never a diagnostic. The i32-list niche
// (`exprNullableList`) is only ONE of the four list families — the distinct-backing scalar
// lists carry their own wrappers (`exprNulScalarListKind`) and a ref array its slot's
// (`exprNullableRefArray`) — so asking `exprNullableList` alone answers "already non-null"
// for the other three. `nulCollWrapHeap` IS that disjunction, so a new nullable collection
// rep is added once and every consumer of the family follows.
function nulRecvNeedsRecover(exprIx: i32, fnIx: i32) {
  nulCollWrapHeap(exprIx, fnIx) != -1
}

// TRUE when an ELEMENT read out of the list `exprIx` yields a rep that legitimately holds
// `null`, so the read must STAY `(ref null $elem)`. Every ref/string backing is declared
// `(array (mut (ref null $elem)))` (spare slots default to null), so a non-null element
// needs `ref.as_non_null` after `array.get` — and that recover TRAPS on the one value a
// nullable-NICHE element exists to carry. The two answers are one rule: this predicate is
// asked by the indexed read (`emitIndex`) and by the `.map`/`.filter` element step
// (`emitMfElem`, via `emitMapFilter`'s `srcElemRef`), which is what keeps a callback's
// declared param valtype and the value handed to it in agreement.
//
// A ref list answers from the interned per-slot bit (kind-discriminated, so a nullable
// niche is not confused with a value-union box, whose `null` is a member tag INSIDE a
// non-null box); a `(string | null)[]` answers from the annotation (`exprNulStrArray`),
// since every string list shares one backing slot.
function listElemStaysNullable(exprIx: i32, fnIx: i32) {
  if exprNulStrArray(exprIx, fnIx) { return true }
  if exprRefArray(exprIx, fnIx) {
    const s = refListSlotOfExpr(exprIx, fnIx)
    if s >= 0 && s < rlElemNullable.length { return rlElemNullable[s] == 1 }
  }
  false
}

// Lower an array `xs.slice(start, end?)` onto `body`, leaving a NEW list wrapper of the
// SAME element kind over the half-open clamped range `[start, end)` (JS semantics: a
// missing `end` defaults to the length, negatives count from the end, the out length is
// `max(end - start, 0)`). Rides the `.map`/`.filter` scratch frame — `srcL` (the source
// wrapper, reserved by `mfScan`'s slice branch), `dstL` (the fresh backing), and the four
// i32 temps `mfScratchBase + 0..3` as start/end/len/outLen — then one `array.copy`. The
// receiver is evaluated ONCE into `srcL`; works for i32/boolean (kind 0), f64 (1), ref
// (2), and string (3) lists.
function emitArrSlice(body: i32[], callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      const recvK = mfRecvKindOf(callee.memObj, fnIx)
      if recvK == null {
        return emitFail("emitProgram: .slice receiver is not a supported list")
      }
      let srcSlot = -1
      if recvK == "ref" { srcSlot = refListSlotOfExpr(callee.memObj, fnIx) }
      // The element kind's wrapper + backing heap types.
      let wrap = lTypeIdx
      let back = aTypeIdx
      if recvK == "f64" {
        if !fa64Used {
          return emitFail(
            "emitProgram: .slice over f64[] but f64 list type not collected",
          )
        }
        wrap = fl64TypeIdx
        back = fa64TypeIdx
      } else if recvK == "i64" {
        if !ia64Used {
          return emitFail(
            "emitProgram: .slice over i64[] but i64 list type not collected",
          )
        }
        wrap = il64TypeIdx
        back = ia64TypeIdx
      } else if recvK == "f32" {
        if !fa32Used {
          return emitFail(
            "emitProgram: .slice over f32[] but f32 list type not collected",
          )
        }
        wrap = fl32TypeIdx
        back = fa32TypeIdx
      } else if recvK == "ref" {
        if !rlUsed {
          return emitFail(
            "emitProgram: .slice over a ref list but ref list type not collected",
          )
        }
        wrap = rlWrapIdx[srcSlot]
        back = rlBackIdx[srcSlot]
      } else if recvK == "str" {
        if !slUsed {
          return emitFail(
            "emitProgram: .slice over string[] but string list type not collected",
          )
        }
        wrap = mkListIdx
        back = mkArrIdx
      } else if !lUsed || !aUsed {
        return emitFail("emitProgram: .slice but list type not collected")
      }
      const srcL = mfSrcLocalFor(recvK, srcSlot)
      const dstL = mfDstLocalFor(recvK, srcSlot)
      if !fnUsesMapFilter || srcL < 0 || dstL < 0 {
        return emitFail("emitProgram: .slice scratch frame not reserved")
      }
      // The `.map`/`.filter` frame's first 3 slots are i32 (i, n, j); slot +3 is a
      // closure ref. So slice has THREE i32 temps: `startL`, `endL`, and `auxL` which
      // holds the length during clamping then is reused for the out length.
      const startL = mfScratchBase + 0
      const endL = mfScratchBase + 1
      const auxL = mfScratchBase + 2
      // src = <receiver>, evaluated ONCE. A NARROWED nullable list recovers non-null at
      // EVERY element kind (`srcL` is declared non-null and `struct.get wrap` demands it),
      // not just the i32 one — see `nulRecvNeedsRecover`.
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      if nulRecvNeedsRecover(callee.memObj, fnIx) {
        wU8(212) // 0xd4 ref.as_non_null
      }
      fbLocalSet(srcL)
      // auxL = src.len (the wrapper's logical length, field 1)
      fbLocalGet(srcL)
      fbStructGet(wrap, 1)
      fbLocalSet(auxL)
      // start = clamp(rawStart, len)
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      fbLocalSet(startL)
      emitClampLocal(body, startL, auxL)
      fbLocalSet(startL)
      // end = clamp(rawEnd, len), or len when omitted (the 1-arg form slices to the end)
      if c.callArgs.length == 2 {
        if emitExpr(body, c.callArgs[1], fnIx) < 0 { return -1 }
        fbLocalSet(endL)
        emitClampLocal(body, endL, auxL)
        fbLocalSet(endL)
      } else {
        fbLocalGet(auxL)
        fbLocalSet(endL)
      }
      // auxL (len now dead) = outLen = max(end - start, 0) = select(end-start, 0, end>start)
      fbLocalGet(endL)
      fbLocalGet(startL)
      fbI32Bin(107) // i32.sub → end - start  [a]
      fbI32Const(0) // [b]
      fbLocalGet(endL)
      fbLocalGet(startL)
      fbI32Bin(74)  // 0x4a i32.gt_s → end > start  [cond]
      wU8(27)       // 0x1b select
      fbLocalSet(auxL)
      // dst backing = array.new_default <back> outLen
      fbLocalGet(auxL)
      fbArrayNewDefault(back)
      fbLocalSet(dstL)
      // result wrapper = struct.new <wrap> (dstBacking, outLen, outLen) — pushed FIRST so
      // it remains on the stack after the trailing `array.copy` consumes its own operands.
      fbLocalGet(dstL)
      fbLocalGet(auxL)
      fbLocalGet(auxL)
      fbStructNew(wrap)
      // array.copy dst 0 src.backing start outLen
      fbLocalGet(dstL)        // dest backing
      fbI32Const(0)           // dest offset
      fbLocalGet(srcL)
      fbStructGet(wrap, 0)    // src backing
      fbLocalGet(startL)      // src offset
      fbLocalGet(auxL)        // count
      fbArrayCopy(back, back) // array.copy (dest type, src type)
      // The result wrapper from `struct.new` above is the value left on the stack.
      return 0
    }
    return emitFail("emitProgram: .slice receiver is not a member access")
  }
  emitFail("emitProgram: expected an array slice call")
}

// Push `elem(i)` — `src.backing[i]` — onto the stack (`ref.as_non_null` for a ref
// element, surfacing the non-null struct/union box).
function emitMfElem(
  _body: i32[],
  srcL: i32,
  iL: i32,
  srcWrap: i32,
  srcBack: i32,
  srcElemRef: boolean,
) {
  fbLocalGet(srcL)
  fbStructGet(srcWrap, 0) // field 0: backing
  fbLocalGet(iL)
  fbArrayGet(srcBack)     // 0xfb 0x0b <srcBack>
  if srcElemRef {
    wU8(212) // 0xd4 ref.as_non_null
  }
  0
}

// Invoke the callback closure (stashed in local `cL`) on `elem(i)`: push its env
// (field 0), the element, its function index (field 1), then `call_indirect $fnsig`
// — leaving the callback's result on the stack. This runs ONCE PER ELEMENT, which is
// why the id is an i32 load and not a funcref field's host libcall.
function emitMfInvoke(
  body: i32[],
  cL: i32,
  srcL: i32,
  iL: i32,
  srcWrap: i32,
  srcBack: i32,
  srcElemRef: boolean,
  sig: i32,
) {
  fbLocalGet(cL)
  fbStructGet(cloStructIdx, 0)     // env
  emitMfElem(body, srcL, iL, srcWrap, srcBack, srcElemRef)
  fbLocalGet(cL)
  fbStructGet(cloStructIdx, 1)     // the callee's wasm function index
  fbCallIndirect(sig, gFnTableIdx) // 0x11 <fnsig> <table>
  0
}

// `local.get L ; struct.get $lTy 1` — push the list's `len` field onto `body`.
function pushListLen(_body: i32[], lIdx: i32, lTy: i32) {
  fbLocalGet(lIdx)    // local.get
  fbStructGet(lTy, 1) // 0xfb 0x02 <lTy> field 1: len
  0
}

// `local.get L ; struct.get $lTy 2` — push the list's `cap` field onto `body`.
function pushListCap(_body: i32[], lIdx: i32, lTy: i32) {
  fbLocalGet(lIdx)    // local.get
  fbStructGet(lTy, 2) // 0xfb 0x02 <lTy> field 2: cap
  0
}

// `local.get L ; struct.get $lTy 0` — push the list's `backing` ref onto `body`.
function pushListBacking(_body: i32[], lIdx: i32, lTy: i32) {
  fbLocalGet(lIdx)    // local.get
  fbStructGet(lTy, 0) // 0xfb 0x02 <lTy> field 0: backing
  0
}

// Push the LIST ref a `for v in <iter>` iterates.
//
// A MAP iterable — `m.keys()`, `m.values()` and the bare `for k in m` alike — reads the
// ordered list field off the map ref the CALLER already stashed (`mapRecv >= 0`,
// `mwShape` its pinned shape): field 1 for a vals walk, field 0 for a keys walk. Any
// other supported iterable is the list value itself, emitted here.
//
// THE RECEIVER IS NOT RE-EMITTED. Its ONE evaluation is the caller's stash
// (`pushMapRecvRef`), and reading the stash is what keeps the walked list, the
// tombstone `live[]` and the loop bound on ONE object: a second emission of the
// receiver expression is a second evaluation, so a factory receiver would hand the
// walk a different map than the skip consults — and re-run the receiver's side
// effects. `forInMapRecv` and `forInMapWalksVals` are the paired classifiers that
// decide "is this a map walk" and "which field", and the caller's stash is gated on
// the same `forInMapRecv`, so the two can never disagree about whether a stash exists.
//
// DELETE-AWARE ITERATION: the keys/vals LIST WRAPPER is decoupled from the map struct
// (its `len` counts appended entries == `count`), so a straight len-walk would VISIT
// tombstoned entries. The for-in loop therefore consults `M.live[i]` per entry off the
// stashed map ref and SKIPS a tombstone — a map-struct-aware walk over `[0, count)`
// matching the host's iteration semantics (order + skipping). For a delete-free map
// `live` is all-1s, so the skip never fires.
function emitForInList(
  body: i32[],
  iterIx: i32,
  fnIx: i32,
  mapRecv: i32,
  mwShape: i32,
) {
  if mapRecv >= 0 {
    cmSlot = mwShape
    if forInMapWalksVals(iterIx, fnIx) { return pushMapVals(body) }
    return pushMapKeys(body)
  }
  emitExpr(body, iterIx, fnIx)
}

// Lower a RETURN-VALUE expression `retArg` for function `fnIx`: seed the return context
// from the function's return type (struct / ref-list / union / nullable-niche / numeric
// widening), emit through the matching helper, then reset the pending seeds. Does NOT emit
// the `return` instruction — the caller appends `fbReturn` (an explicit `RetStmt`) or
// leaves the value on the stack (an if-tail arm's result). That unifies explicit `return e`
// with IMPLICIT (tail-position) returns: a trailing `null` or a nullable `if/else`-tail arm
// gets the SAME box/sentinel/`ref.null` seeding as `return null`, without which the tail
// paths emitted a bare `null` and failed codegen. The numeric (f32/f64/i64) literal
// WIDENING covers both forms too — `1.5` → f32, `5` → i64 through `emitExprAs*`, a
// pass-through on a value ALREADY of the right type (`exprIsF64`/`exprIsF32`/`exprIsI64`
// recognize a closure `call_ref` result, a variable, so a correct tail is never
// mis-widened). Without it a bare-expression body returning a narrower literal
// (`function f(): i64 5`, `(): f32 => 1.5`) emitted it at its default type and trapped
// wasm validation.
function emitReturnValue(body: i32[], retArg: i32, fnIx: i32) {
  const fn = P.nodes[fnIx]
  // ONE READ, FOUR USES. The INFERRED-return arms below want the same `fnStmts` position four
  // separate times — the variant seed, the variant index, the `fRetKind` widen and the
  // atom-to-string widen — and taking it once is a HOIST, not a memo: nothing between the four
  // reads writes `fnStmts` or `monoOrigNode`, both of which are written only by
  // `emit_collect`'s collect passes and `emit_mono`'s replacement writers, all of which have
  // run to completion before `emitCodeSection` begins. (That is a strictly weaker claim than a
  // cross-call memo would need, which would have to hold across the whole emit; this one holds
  // inside one call frame.) The read stays behind `fn.fnRet < 0` so an ANNOTATED return pays
  // nothing.
  //
  // This function was `fnStmtsPosOf`'s largest single caller by a wide margin at every
  // measurement, which is why the hoist is worth stating rather than assuming.
  let fnPos = -1
  if fn is FuncDecl {
    if fn.fnRet < 0 { fnPos = fnStmtsPosOf(fnIx) }
  }
  if fn is FuncDecl {
    const rsi = retStructIndex(fn.fnRet)
    if rsi >= 0 {
      if retTRFlag(fn.fnRet) == 1 { pendingStructIdx = rsi }
      if retNulRefFlag(fn.fnRet) == 1 { pendingStructIdx = rsi }
    }
    // A `: Cat` variant return: seed the variant index so a `return { … }` object literal
    // builds the bare variant struct (kind 8) instead of boxing into the union.
    if retVariantFlag(fn.fnRet) == 1 {
      pendingVariantIdx = variantIndexOf(tyNameOf(fn.fnRet))
    }
    // An INFERRED variant return (a `.map` lambda collapsing to one variant): seed it from
    // the checker's recorded return shape so the else-arm's `{ … }` literal builds the bare
    // variant too, matching the then-arm's narrowed variant rep.
    if fn.fnRet < 0 {
      const rvi = cbRetVariantIdx(fnPos)
      if rvi >= 0 { pendingVariantIdx = rvi }
    }
    pendingListKind = tyAnnRefListKind(fn.fnRet)
    pendingListSlot = tyAnnRefListSlot(fn.fnRet)
  }
  let retF32 = false
  let retF64 = false
  let retI64 = false
  let retNulBool = false
  let retNulString = false
  let retNulClosure = false
  let retNulList = false
  let retNulRefArr = false
  let retNulRefArrHeap = -1
  // A NULLABLE map return (`{[string]: V} | null`, kind `nulmap`): a `return m` passes the map ref
  // (which subtypes the nullable result), a `return null` is `ref.null $mapStruct`. `retNulMapShape`
  // is the map SHAPE (for the null heap + a `return Map()`).
  let retNulMap = false
  let retNulMapShape = -1
  // A NON-NULL map return (`{[string]: V}`, kind 6): a `return Map()` must `struct.new` THIS
  // value type's `$mapStruct`, not the shared mono one — `retMapShape` carries the annotation's
  // map SHAPE for the constructor, the bare-map twin of `retNulMapShape`. (`return m` passes an
  // already-built map ref and needs no seed, which is why only the DIRECT constructor is at risk.)
  let retMap = false
  let retMapShape = -1
  let retNulSLKind: VKind | null = null
  let retLitUnion = false
  let retNulLitUnion = false
  // A `string`-returning function whose `return` value is a literal-union atom: widen the
  // atom to its member string at the return boundary (the atom-as-string-subtype edge).
  let retStrWiden = false
  let retUNm = ""
  let retVi = -1
  if fn is FuncDecl {
    // A concrete-variant return (annotated `: Cat`, or a collapsed inferred lambda).
    if retVariantFlag(fn.fnRet) == 1 {
      retVi = variantIndexOf(tyNameOf(fn.fnRet))
    }
    if fn.fnRet < 0 {
      const rvi2 = cbRetVariantIdx(fnPos)
      if rvi2 >= 0 { retVi = rvi2 }
    }
    if retF32Flag(fn.fnRet) == 1 { retF32 = true }
    if retF64Flag(fn.fnRet) == 1 { retF64 = true }
    if retI64Flag(fn.fnRet) == 1 { retI64 = true }
    // An UN-annotated return INFERRED as i64/f64 (the stored kind the A20 pass fills) widens
    // its value too — without this a `return 0` (an i32 literal) in a function whose other
    // branch returns a big i64 / an f64 expression stays `i32.const`, clashing with the i64/f64
    // functype result the inferred-return path declares (a soundness hole the checker accepts).
    if fn.fnRet < 0 {
      const rfe = fnPos
      if rfe >= 0 {
        if fRetKind[rfe] == "i64" { retI64 = true }
        if fRetKind[rfe] == "f64" { retF64 = true }
        // The f32 dual: an inferred f32 return whose body carries a float LITERAL (`(v: f32) =>
        // v * 2.0`) emits f64 unless forced — the functype result is f32 (#614), so without this
        // the body clashes with it ("return expected f32, got f64"). `return x` (a bare f32) was
        // already f32; only a literal-bearing f32 expression needed the coercion.
        if fRetKind[rfe] == "f32" { retF32 = true }
        // AN INFERRED `f32[]` RETURN HAS NO PRODUCER, and until this guard the function
        // emitted INVALID WASM with `vl check` rc 0 — the worst class in the ordering, on a
        // callee that need not even be CALLED (`function mk() { const xs: f32[] = [1.5];
        // return xs }` beside a bare `print(1)` is enough). The functype result stays at the
        // `"i32"` default (`retAnnKindChain`'s seed, read by `emitTypeSection`'s
        // un-annotated arm through `inferredRetKindCore`) while the emitted `return` pushes
        // the f32 list's `(ref $array)`.
        //
        // BOTH channels that fill the slot decline this shape, and each says so at its own
        // site: the checker's A20 record admits only `i32[]`/`string[]` among arrays
        // (`isClassifiableRetName`, `typecheck.vl`) so `emit_collect`'s `nameIsF32Array` arm
        // never sees this function, and `criClassify`'s `exprF32Array` arm
        // (`emit_classify.vl`) cannot classify a returned LOCAL during a pass that runs
        // before any local table exists — the same gap `retIsMapLocal` was added to
        // close for a returned map local. HERE the local table DOES exist, which is why the
        // disagreement is detectable at this site and repairable at neither.
        //
        // The reject is a CLASS improvement, not the fix: invalid wasm becomes a loud error
        // that names the remedy, because the ANNOTATED spelling lowers correctly today
        // (#1223 gave it `fnRetAnnF32Array`; `tests/cases/arrays/f32-array-return.vl` pins
        // it). Measured at `63a73d7` over 18 cells: the 6 that were invalid wasm — an
        // annotated/`let`/local binding, a call ARGUMENT, an UNREAD binding, and the
        // never-called callee — all become this error; the 3 that already rejected at the
        // caller (`mk()[0]`, `mk().length`, a bare binding) now reject here instead, one
        // function earlier and with the actionable message; the `f64`/`i64`/`i32`/`string`
        // twins of the same three lines and the f32 SCALAR are untouched and still run.
        // `function mk(a: f32[]) { return a }` also still runs: a returned PARAM is exactly
        // what `criClassify`'s arm CAN see, so its slot holds `"f32list"` and this guard —
        // keyed on the `"i32"` default, not on the expression alone — never fires for it.
        if fRetKind[rfe] == "i32" && exprF32Array(retArg, fnIx) {
          return emitFail(
            "emitProgram: an f32[] return must be annotated (`: f32[]`) — the inferred form has no result type",
          )
        }
      }
    }
    // A literal-union return reads as a union NAME but is an i32 ATOM — exclude it from the value-union
    // box return (`emitUnionBoxArg` would `struct.new` the member). A nullable-closure return
    // (`((i32) => i32) | null`) also reads as a two-member union NAME, but it is the closure NICHE
    // (`ref.null $cloStruct`), not a value box — route it through `retNulClosure` (below), not here.
    // D-NULLITHOME: the NULLABLE literal union is the same i32 ATOM (the `-1` sentinel niche) and
    // must be excluded on the same grounds as the bare litunion alias beside it — `retNulLitUnion`
    // below already seeds the niche lowering, but `retUNm` claimed the value first and
    // `emitUnionBoxArg` `struct.new`'d a box into an i32 result. The ARENA answers for both the
    // aliased (`type K = "ab" | "zz" | null`) and the inline spelling; the NAME cannot, because
    // `retUnionFlag` is true for either and a bare alias name carries no members to scan.
    // A NULLABLE NUMERIC litunion return (`1 | 2 | null`) is NOT claimed here, and the
    // omission is measured rather than an oversight. Its cell IS the box — `vtKindOfType`'s
    // own arm says so, which is what makes its PARAM and its null TEST correct — and adding
    // `nodeTyIsNulNumLitUnion` to this gate does box the `return null`. But the CALL-RESULT
    // classifier is a third home (`computeRetInference` / `criClassify`, whose call-result
    // union test is name-keyed exactly as `retUnionFlag` is), so the receiving `const r = f(b)`
    // local stayed an i32 while the functype and the body both moved to the box: 8 of 520 grid
    // cells went from a LOUD reject to `vl check`-clean INVALID WASM. Until that third home
    // moves in the same change, `return null` over this rep keeps the loud floor.
    if retUnionFlag(fn.fnRet) == 1 {
      if (
        !nodeTyIsLitUnionAlias(fn.fnRet) &&
        !nodeTyIsNulLitUnion(fn.fnRet) &&
        nulCloFlag(fn.fnRet) != 1
      ) {
        retUNm = tyNameOf(fn.fnRet)
      }
    }
    if fn.fnRet < 0 {
      const im = inferRetNameOf(fn.fnName)
      // A VALUE union (`i32 | string`) OR a registered STRUCT-union (`Cat | Dog`) inferred
      // return is a union-BOX return (kind 4): box each concrete-variant / value-atom `return`
      // into the shared `{tag, payload}` rep via `retUNm`. Without the struct-union case an
      // un-annotated `Cat | Dog` return emitted the raw variant ref (invalid wasm) — the
      // annotated `: Cat | Dog` path already boxes (`retUnionFlag` above).
      //
      // A LITUNION alias name is excluded on exactly the grounds the annotated arm above
      // excludes `nodeTyIsLitUnionAlias`: every litunion registers as a union NAME
      // (`isUName`) while its value is the interned i32 ATOM, so claiming it here would
      // `struct.new` a box into an i32 result. The annotated side asks the ARENA, the
      // inferred side has only the recorded name — `nameIsLitUnionType` is that same
      // question of the name.
      if isValueUnionName(im) || (isUName(im) && !nameIsLitUnionType(im)) {
        retUNm = im
      }
      // The inferred twins of the `nodeTyIsLitUnionAlias` / `nodeTyIsNulLitUnion` seeds
      // below: an un-annotated litunion return encodes a member literal as its atom id,
      // and its `| null` niche encodes a bare `null` as the `-1` sentinel.
      if nameIsLitUnionType(im) { retLitUnion = true }
      if nameIsNulLitUnion(im) { retNulLitUnion = true }
    }
    // A CONCRETE-variant return (`: Cat`, or a collapsed-to-one-variant inferred lambda):
    // route the value through `emitVariantCoerce` so a mixed-rep value-`if` (a narrowed
    // union arm + a literal arm) lands in ONE variant rep. Overrides the `pendingVariantIdx`
    // literal seeding above — `emitVariantCoerce` builds the literal itself.
    if retVi >= 0 { pendingVariantIdx = -1 }
    if tyIsNulBool(fn.fnRet) { retNulBool = true }
    if retNulStringFlag(fn.fnRet) == 1 { retNulString = true }
    // A nullable-closure return (`((i32) => i32) | null`, kind 19): a `return null` lowers
    // as `ref.null $cloStruct` (the niche), a function value passes through as the fat
    // pointer widened to the nullable storage — the return analogue of the kind-22 field.
    if nulCloFlag(fn.fnRet) == 1 { retNulClosure = true }
    if retNulListFlag(fn.fnRet) == 1 { retNulList = true }
    // A nullable ref-array return (`<ref-array> | null`, kind 18): a `return [x]` builds the ref
    // list (which subtypes the nullable wrapper), a `return null` is `ref.null $wrapper` — seed the
    // inner wrapper heap so the bare-`null` return path types it.
    if retNulRefArrFlag(fn.fnRet) == 1 {
      retNulRefArr = true
      const rlsRet = tyAnnRefListSlot(fn.fnRet)
      if rlsRet >= 0 && rlsRet < rlWrapIdx.length {
        retNulRefArrHeap = rlWrapIdx[rlsRet]
      }
    }
    if retNulMapFlag(fn.fnRet) == 1 {
      retNulMap = true
      retNulMapShape = mapAnnShape(fn.fnRet)
    }
    if retMapFlag(fn.fnRet) == 1 {
      retMap = true
      retMapShape = mapAnnShape(fn.fnRet)
    }
    // The INFERRED dual of the arm above. An un-annotated map return (`function mk() { return
    // Map() }`, or a returned local whose value type only the first write pinned) has no
    // annotation for `retMapFlag` to read, so a bare `Map()` built the MONO struct while the
    // functype RESULT declared the value-typed one — invalid wasm inside the returning function
    // itself. The shape comes from the SAME chokepoint the result valtype does
    // (`emitFunctionSection`'s inferred-map arm: `mapRetExprShape` over `fnRetExprOf`), which is
    // what makes the constructor and the declared result one answer rather than two that agree.
    if fn.fnRet < 0 && fnPos >= 0 {
      if fRetKind[fnPos] == "map" {
        const imrx = fnRetExprOf(fnIx)
        if imrx >= 0 {
          retMap = true
          retMapShape = mapRetExprShape(imrx, fnPos)
        }
      }
    }
    retNulSLKind = nulScalarListKindOfNode(fn.fnRet)
    if nodeTyIsLitUnionAlias(fn.fnRet) { retLitUnion = true }
    // A `K | null` NICHE return: a `return null` lowers as the i32 sentinel `-1`, a `return "a"`
    // as its atom id — so seed BOTH the niche flag and `pendingLitUnion`.
    if nodeTyIsNulLitUnion(fn.fnRet) { retNulLitUnion = true }
    if tyNameOf(fn.fnRet) == "string" {
      if exprIsLitAtom(retArg, fnIx) { retStrWiden = true }
    }
    // The `string | null` NICHE return takes the SAME widen. Its slot is the same string
    // reference with a null permitted, and a widened member string is non-null, so it is a
    // subtype of the slot — a `return null` is not a lit atom and still takes the `nulString`
    // context below. Without this the raw i32 atom id flowed into a `(ref null $type)` result:
    // `expected (ref null $type), found i32`, with `vl check --codegen` rc 0.
    //
    // Asked of the ARENA (`retNulStringFlag` -> `nodeTyIsNulString`) rather than by growing the
    // spelling test above a second case, which is what missed this in the first place: the
    // nullable form does not spell `"string"`.
    if retNulStringFlag(fn.fnRet) == 1 {
      if exprIsLitAtom(retArg, fnIx) { retStrWiden = true }
    }
    // The INFERRED-string dual: an UN-annotated function whose A20 return is `string`
    // (one path returns a member literal, another the atom — the checker joins to
    // `string`) widens an atom return value too; without it the raw i32 id flowed into
    // the string-ref functype result (invalid wasm).
    if fn.fnRet < 0 && cloRetIsString(fnPos) {
      if exprIsLitAtom(retArg, fnIx) { retStrWiden = true }
    }
    // Inferred niche nullable (un-annotated): seed the niche from the A20 name so a
    // `return null` / `return <bool|string>` lowers as the sentinel / `ref.null` rep.
    if fn.fnRet < 0 {
      const nn = inferNicheNullByName(fn.fnName)
      if nn == "boolean|null" { retNulBool = true }
      if nn == "string|null" { retNulString = true }
    }
  }
  if retF32 {
    const savedF32 = pendingF32
    pendingF32 = true
    if emitExprAsF32(body, retArg, fnIx) < 0 { return -1 }
    pendingF32 = savedF32
  } else if retF64 {
    if emitExprAsF64(body, retArg, fnIx) < 0 { return -1 }
  } else if retI64 {
    if emitExprAsI64(body, retArg, fnIx) < 0 { return -1 }
  } else if retVi >= 0 {
    if emitVariantCoerce(body, retVi, retArg, fnIx) < 0 { return -1 }
  } else if retUNm != "" {
    // `retUNm` is the union-BOX return (kind 4); a concrete variant `return s` (where `s: S`
    // and the return type is `C | S`) is boxed into the shared `{tag, payload}` rep here.
    if emitUnionBoxArg(body, retUNm, retArg, fnIx) < 0 { return -1 }
  } else if retStrWiden {
    // A literal-union atom returned from a `string`-typed function widens to its member string.
    if emitAtomToStr(body, retArg, fnIx) < 0 { return -1 }
  } else {
    const retCtx = expCtxHere()
    if retNulBool { retCtx.nulBool = true }
    if retNulString { retCtx.nulString = true }
    if retNulClosure { retCtx.nulClosure = true }
    if retNulList { retCtx.nulList = true }
    // The #964 SEED-LEAK gate (stated in full at `emitObj`'s code-28 arm), at the RETURN
    // boundary. Witness: `return [null]` of `({f: boolean | null} | null)[] | null`.
    if retNulRefArr && retNulRefArrHeap >= 0 {
      if P.nodes[unwrapParen(retArg)] is NullLit {
        retCtx.nulRefHeap = retNulRefArrHeap
      }
    }
    // A nulmap return: a `return null` is `ref.null $mapStruct` (`nulRefHeap`), a `return Map()`
    // builds THIS map's struct (`mapSlot`). A `return m` (a map variable) self-identifies and
    // subtypes the nullable result.
    if retNulMap {
      retCtx.nulRefHeap = mapTypeIdxOf(retNulMapShape)
      retCtx.mapSlot = retNulMapShape
    }
    // A bare MAP return: a `return Map()` builds THIS map's `$mapStruct` (`mapSlot`), the
    // same seed the `let`/global/field constructor sites thread. Without it the constructor
    // read the ambient `pendingMapSlot` (-1 — the mono i32 map) while the functype result is
    // the value-typed map struct: INVALID-WASM inside the returning function itself, for
    // EVERY non-mono value type (`string`, `f64`, a struct, a union, a list, a nested map).
    if retMap { retCtx.mapSlot = retMapShape }
    // A DISTINCT-backing nullable scalar list return: a `return [x]` builds the leaf list
    // (`listKind`, which subtypes the nullable result), a `return null` is `ref.null $wrapper`.
    if retNulSLKind != null {
      retCtx.listKind = nulScalarListBuildKind(retNulSLKind)
      retCtx.nulRefHeap = nulScalarListWrapHeap(retNulSLKind)
    }
    if retLitUnion { retCtx.litUnion = 1 }
    if retNulLitUnion {
      retCtx.nulLitUnion = true
      retCtx.litUnion = 1
    }
    if emitExprExpect(body, retArg, fnIx, retCtx) < 0 { return -1 }
  }
  pendingStructIdx = -1
  pendingVariantIdx = -1
  pendingListKind = 0
  pendingListSlot = 0
  0
}

// The exact bytes `fbStructNew(uBoxIdx)` writes, produced BY that encoder into a scratch
// buffer rather than re-derived — so the peephole's pattern cannot drift from the
// instruction it matches if the encoding (or `uBoxIdx`'s ULEB width) ever changes.
function unionBoxNewBytes() {
  const probe: i32[] = []
  const prev = wTarget(probe)
  fbStructNew(uBoxIdx)
  wTarget(prev)
  probe
}

// The exact bytes `fbCall(fnIdx)` writes, produced BY that encoder into a scratch buffer
// — the `unionBoxNewBytes` discipline, so the tail-call peephole's pattern cannot drift
// from the instruction it matches if the funcidx's ULEB width changes.
function callBytes(fnIdx: i32) {
  const probe: i32[] = []
  const prev = wTarget(probe)
  fbCall(fnIdx)
  wTarget(prev)
  probe
}

// Rewrite a trailing direct `call` into `return_call`, reporting whether it fired.
//
// A call whose bytes are still the last thing written when the enclosing `return` is
// being terminated IS in tail position: the terminator is only reached in
// function-RESULT position, so the call's result is the function's result and no work
// can follow it. That is the whole tail-position derivation — it is a property of the
// write cursor, not a syntactic search, so it cannot disagree with what was emitted.
//
// Validity needs no result-type comparison: `return_call` imposes the SAME subtyping
// condition on the callee's results that the `return` being replaced already imposes
// (see `fbReturnCall`). The one place that equivalence breaks is arity — `return`
// tolerates leftover operands beneath the result, `return_call` does not — so a VOID
// enclosing function is declined rather than reasoned about. The `fnStmtsPosOf` that
// backs `fRetVoid`'s index is asked only HERE, behind both write-cursor tests, so it is
// paid once per tail call rather than once per return.
//
// A union-box SINK function is declined outright: its exits are branches to a single
// exit block whose emission is gated on `uSinkFired`, and a tail call is neither a
// branch nor a box construction, so the two rewrites are kept disjoint instead of
// ordered.
function emitTailCallRet(fnIx: i32) {
  if fnUsesUnionSink { return false }
  if tailCallIdx < 0 { return false }
  if tailCallEnd != wLen() { return false }
  const pat = callBytes(tailCallIdx)
  const np = pat.length
  let ok = true
  let i = 0
  while i < np {
    if wPeekBack(i) != pat[np - 1 - i] { ok = false }
    i = i + 1
  }
  if !ok { return false }
  const fnPos = fnStmtsPosOf(fnIx)
  if fnPos < 0 { return false }
  if fRetVoid[fnPos] == 1 { return false }
  wDropBack(np)
  fbReturnCall(tailCallIdx) // 0x12 return_call
  tailCallEnd = -1
  tailCallIdx = -1
  true
}

// Terminate a RETURN in function-result position: either the ordinary `return`, the
// TAIL-CALL rewrite when the result is a direct call standing alone, or — for a
// union-box-returning function taking the SINK — the two `local.set`s and the branch to
// the function's single exit block.
//
// This is a PEEPHOLE, and its justification is entirely local: when the last instruction
// written is `struct.new $uBox`, that box's two operands are sitting on the wasm stack in
// field order, so popping them into the exit locals and branching to the one site that
// re-runs the same `struct.new` leaves observably identical behavior. Nothing about WHICH
// emitter path produced the box enters the argument, which is why the sink needs no flag
// threaded through the eighteen construction sites and cannot be fooled by one of them
// growing a new caller.
//
// Two independent conditions must both hold before the rewrite (see `uBoxNewEnd`): the
// cursor says nothing has been written since the box was built, and the trailing bytes
// still spell it. Either alone admits a false match; neither can be defeated by an
// operand that happens to look like an opcode.
//
// The branch target is `ctrlDepth` — the exit block is opened FIRST, so it is exactly
// that many frames out from any point in the body. When the sink does not apply, the
// plain `return` is emitted and the exit block simply has one fewer predecessor: the
// transform is per-exit and never has to be total.
export function emitUnionRetSink(fnIx: i32) {
  if fnUsesUnionSink {
    if uBoxNewIsLast() {
      uBoxSinkToPair()
      fbBr(ctrlDepth) // 0x0c br to the function's single exit block
      uSinkFired = uSinkFired + 1
      return 0
    }
  }
  if emitTailCallRet(fnIx) { return 0 }
  fbReturn() // 0x0f return
  0
}

// THE UNION-BOX PEEPHOLE'S MATCH, shared by both sink positions: is the last instruction
// written the box's own `struct.new $uBox`, with its two operands still sitting on the
// wasm stack in field order?
//
// Both conditions are load-bearing and neither implies the other. The cursor says nothing
// has been written since the box was built; the trailing bytes say they still spell it. A
// byte pattern alone admits a false match, because an operand can spell any opcode.
function uBoxNewIsLast() {
  if uBoxNewEnd != wLen() { return false }
  const pat = unionBoxNewBytes()
  const np = pat.length
  let ok = true
  let i = 0
  while i < np {
    if wPeekBack(i) != pat[np - 1 - i] { ok = false }
    i = i + 1
  }
  ok
}

// Unwrite the matched `struct.new $uBox` and pop its two operands into the sink pair,
// leaving the wasm stack as it was before the box's operands were pushed. Valid only
// immediately after `uBoxNewIsLast()` answered true.
function uBoxSinkToPair() {
  wDropBack(unionBoxNewBytes().length)
  fbLocalSet(unionSinkBase + 1) // the anyref payload — top of stack
  fbLocalSet(unionSinkBase) // the i32 tag — beneath it
  0
}

// TERMINATE A RETURN: lower the value at `retArg` as function `fnIx`'s result and end the
// exit. Every exit in the emitter goes through here — `emitStmt`'s `RetStmt`, the
// implicit tail value of `emitFuncBody`, and an if-tail arm's `emitStmtTail` — so the
// value lowering and its terminator can never be paired differently at one of them.
//
// The one shape that is not "value then terminator" is a returned if-EXPRESSION in a
// SINKING function, which is split into per-arm exits below.
function emitReturnExit(body: i32[], retArg: i32, fnIx: i32) {
  if fnUsesUnionSink {
    const bare = P.nodes[unwrapParen(retArg)]
    if bare is IfStmt {
      return emitUnionRetIfSink(body, unwrapParen(retArg), fnIx)
    }
  }
  if emitReturnValue(body, retArg, fnIx) < 0 { return -1 }
  emitUnionRetSink(fnIx)
  0
}

// `return if c { a } else { b }` in a union-box-returning function taking the SINK.
//
// `emitUnionCoerce`'s value-typed `if` (`emitUnionIfValue`) builds a box in EACH ARM to
// satisfy a `(ref $uBox)` blocktype, so one `return` carries one construction site per
// arm and the merge point at the `if`'s `end` is exactly what stops Heap2Local owning
// any of them. Lowering the same source as a VOID statement-`if` whose arms each
// terminate as their own return is the identical program — it is what
// `if c { return a } else { return b }` already emits — and each arm's box then meets
// `emitUnionRetSink`'s peephole and becomes two `local.set`s plus a `br`. The function's
// sites collapse to the exit block's ONE.
//
// The trailing `unreachable` is load-bearing and NOT dead padding for the sunk case. A
// wasm `if` whose arms both diverge is still REACHABLE at its `end` as far as the
// validator is concerned, and the enclosing `return` used to make everything after it
// stack-polymorphic. Without the `unreachable`, a function whose arms all DECLINED the
// sink (both arms pass a union through, so no box is built and each arm emits a plain
// `return`) would fall out of the `if` with an empty stack into a non-void function
// `end`: invalid wasm. It restores the post-`return` polymorphism the split gave away.
function emitUnionRetIfSink(body: i32[], ifIx: i32, fnIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    if s.ifElse < 0 {
      return emitFail("emitProgram: union if-expression requires an else arm")
    }
    if emitExpr(body, s.ifCond, fnIx) < 0 { return -1 }
    fbIf(64) // 0x04 if, 0x40 void blocktype
    // The arms hold sunk RETURNS whose `br` operand is the frame distance to the
    // function's exit block, so this frame has to be counted. The `else` reuses it (one
    // frame per `if`/`else` pair), matching `emitIfTail`/`emitIfStmtStmt`.
    ctrlEnter()
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const rcT = emitUnionRetIfArm(body, s.ifThen, fnIx)
    if narrowed { restoreNarrow(savedTop) }
    if rcT < 0 { return -1 }
    fbElse() // 0x05 else
    // A VALUE union narrows to the COMPLEMENT set in the else-arm (see `emitStmt`).
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    const els = P.nodes[s.ifElse]
    let rc = 0
    if els is IfStmt {
      rc = emitUnionRetIfSink(body, s.ifElse, fnIx) // `else if`: another chain link
    } else {
      rc = emitUnionRetIfArm(body, s.ifElse, fnIx)
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    ctrlLeave()
    fbUnreachable() // 0x00 — every arm exited; see the header
    return 0
  }
  emitFail("emitProgram: expected a union if-expression")
}

// One arm of a sunk returned if-expression: the arm's prelude, then its tail-value
// statement lowered as the function's return value and terminated like any other exit
// (`emitReturnExit`, which recurses when that value is itself an if-expression).
function emitUnionRetIfArm(body: i32[], blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if stmtIsTailValue(tv, fnIx) {
        if emitIfArmOpen(body, blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        return emitIfArmClose(emitReturnExit(body, tv, fnIx))
      }
      const inner = P.nodes[unwrapParen(tv)]
      if inner is IfStmt {
        if emitIfArmOpen(body, blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        return emitIfArmClose(emitReturnExit(body, tv, fnIx))
      }
    }
    return ifArmNoValueFail("union if-expression arm", blockIx)
  }
  emitFail("emitProgram: union if-expression arm is not a block")
}

// Emit the `null` value of function `fnIx`'s nullable return rep, leaving it on the
// stack as the function's result (the fall-through path's implicit `return null`).
// Each arm mirrors the `NullLit` lowering for that rep: the `boolean|null` i32 sentinel
// `2`, the `string|null` typed `ref.null $array`, a nullable struct `ref.null $S`, a
// nullable i32-list `ref.null $lTypeIdx`, and the value-union null-tagged box. Guarded
// by `fnRetNullBearing`; an unsupported rep fails loudly.
export function emitNullForRet(_body: i32[], fnIx: i32) {
  const fn = P.nodes[fnIx]
  if !(fn is FuncDecl) { return emitFail("emitNullForRet: not a function") }
  const r = fn.fnRet
  if tyIsNulBool(r) {
    fbI32Const(2)
    return 0
  }
  if retNulStringFlag(r) == 1 {
    wU8(208) // 0xd0 ref.null
    wSLEB(aTypeIdx)
    return 0
  }
  if retNulRefFlag(r) == 1 {
    const rsi = retNulRefIndex(r)
    if rsi >= 0 && rsi < sHeapIdx.length {
      wU8(208) // 0xd0 ref.null
      wSLEB(sHeapIdx[rsi])
      return 0
    }
  }
  if retNulMapFlag(r) == 1 {
    wU8(208) // 0xd0 ref.null — the nullable map struct
    wSLEB(mapTypeIdxOf(mapAnnShape(r)))
    return 0
  }
  if retNulListFlag(r) == 1 {
    wU8(208) // 0xd0 ref.null
    wSLEB(lTypeIdx)
    return 0
  }
  // A nullable ref-array return (`<ref-array> | null`, kind 18): the niche `ref.null $wrapper` over
  // the inner ref-list element wrapper (`tyAnnRefListSlot` strips the `| null` to resolve the slot).
  if retNulRefArrFlag(r) == 1 {
    const rls = tyAnnRefListSlot(r)
    if rls >= 0 && rls < rlWrapIdx.length {
      wU8(208) // 0xd0 ref.null
      wSLEB(rlWrapIdx[rls])
      return 0
    }
  }
  // A nullable-closure return (`((i32) => i32) | null`): the niche `ref.null $cloStruct`.
  if nulCloFlag(r) == 1 {
    wU8(208) // 0xd0 ref.null
    wSLEB(cloStructIdx)
    return 0
  }
  // Value-union box (annotated `i32 | null`, or an inferred return widened to it): the
  // null-tagged box `{ tag: null, payload: ref.null }` — identical to `emitUnionCoerce`'s
  // bare-`null` path.
  let isU = false
  if retUnionFlag(r) == 1 { isU = true }
  if r < 0 {
    const inm = inferRetNameOf(fn.fnName)
    if isValueUnionOfSet(msSetOfText(inm), inm) { isU = true }
  }
  if isU {
    fbI32Const(nullBoxTag())
    fbRefNullNone() // payload slot unread under the null tag
    fbStructNew(uBoxIdx)
    return 0
  }
  // Inferred NICHE nullable (un-annotated `boolean | null` / `string | null`): same null
  // rep as the annotated niche, recognized by name (no `fn.fnRet` node to read).
  if r < 0 {
    const nn = inferNicheNullByName(fn.fnName)
    if nn == "boolean|null" {
      fbI32Const(2)
      return 0
    }
    if nn == "string|null" {
      wU8(208) // 0xd0 ref.null
      wSLEB(aTypeIdx)
      return 0
    }
  }
  emitFail("emitNullForRet: unsupported nullable return rep")
}

// Lower a single statement at `stmtIx` onto `body`, resolving identifiers/params
// against function `fnIx`. Returns 0, or -1 (via `emitFail`) on an unsupported shape.
//
// Node shapes read (all from `compiler/ast.vl`):
//   LetDecl { letName, letType, letInit }         — `let`/`const` local declaration.
//   RetStmt { retArg: i32 }                       — `retArg` -1 means a bare return.
//   IfStmt  { ifCond: i32, ifThen: i32, ifElse: i32 }
//   BinExpr { binOp, binLeft, binRight }          — an assignment expression statement.
//   Call    { callFn, callArgs }                  — a `recv.push(x)` member-call.
//   Block   { blkStmts: i32[] }
export function emitStmt(body: i32[], stmtIx: i32, fnIx: i32) {
  if stmtIx < 0 { return emitFail("emitProgram: missing statement") }
  const s = P.nodes[stmtIx]
  if s is FuncDecl {
    // A NESTED function declaration statement (`function add(x) x + n`): it was lifted to
    // a top-level wasm function by `collectFns`, so it emits no inline code here — just a
    // no-op in its enclosing body. Its name resolves as a closure value when referenced.
    return 0
  }
  if s is LetDecl { return emitLetDeclStmt(body, s, stmtIx, fnIx) }
  if s is BinExpr {
    // A bare `BinExpr` statement is an assignment (`x = <expr>`); any OTHER operator
    // in statement position is a DISCARDED value (`1 + 1` as a tail statement of a
    // void function) — evaluate it for effect, then `drop` the value it leaves.
    if s.binOp == "=" { return emitAssign(body, stmtIx, fnIx) }
    if emitExpr(body, stmtIx, fnIx) < 0 { return -1 }
    fbDrop() // 0x1a drop
    return 0
  }
  if s is Unary {
    // Postfix `x++` / `x--` in STATEMENT position: the OLD-value result is discarded,
    // so emit just the inner increment assignment (`x = x ± 1`) — byte-identical to a
    // plain assignment statement, with no value left on the stack.
    // A PREFIX unary (`-q` / `!q`) leaves a value instead, so it falls through to the
    // shared discard below.
    if s.unOp == "p+" || s.unOp == "p-" {
      return emitAssign(body, s.unArg, fnIx)
    }
  }
  if s is Call { return emitCallStmt(body, s, stmtIx, fnIx) }
  if s is RetStmt {
    if s.retArg < 0 {
      // A BARE `return` — the ordinary early exit from a void function, which had no
      // lowering at all: `vl check` reported the file clean and the emitter refused it, so
      // `if c { return }` as a guard clause could not be written in VL.
      //
      // The population is the functions with an EMPTY result type, and the checker is the
      // gate on the ANNOTATED half: a bare return in a function whose result type is
      // written is refused there with "return needs a value of type T", naming the type.
      //
      // IT IS NOT THE GATE ON THE INFERRED HALF, and this comment used to say it was
      // ("so reaching here means the result is void"). `checkRetStmtNode` errors only when
      // the wanted type is known; under a PENDING return (`want == -2`) a bare return is
      // accepted, so `function f(c: boolean) { if c { return }  return 5 }` checks clean
      // with 0 errors and arrives here with `fRetVoid == 0`. The code was always right —
      // it tests the flag and falls to the loud reject — but the invariant the comment
      // asserted does not hold, and a reader who believed it would delete the test.
      //
      // The lowering is the `return` opcode with nothing pushed. `fRetVoid` is read
      // position-keyed via `fnStmtsPosOf`, the same channel `emitFuncCode`'s void
      // fall-through reads (`emit_sections.vl`, where the position is a parameter rather
      // than a lookup), not re-derived from the annotation.
      //
      // Anything the position channel cannot answer for keeps the old loud reject rather
      // than guessing an arity — a `return` that leaves the stack wrong is invalid wasm,
      // which is strictly worse than the message it replaces.
      const rPos = fnStmtsPosOf(fnIx)
      if rPos >= 0 {
        if fRetVoid[rPos] == 1 {
          fbReturn() // 0x0f return
          return 0
        }
      }
      return emitFail("emitProgram: bare return is not supported")
    }
    // Seed the return context + emit the value (struct / list / union / nullable /
    // widening) and terminate the exit, via the shared helper.
    return emitReturnExit(body, s.retArg, fnIx)
  }
  if s is IfStmt { return emitIfStmtStmt(body, s, stmtIx, fnIx) }
  if s is WhileStmt { return emitWhileStmtStmt(body, s, stmtIx, fnIx) }
  if s is ForRange { return emitForRangeStmt(body, s, stmtIx, fnIx) }
  if s is ForIn { return emitForInStmt(body, s, stmtIx, fnIx) }
  if s is BreakStmt { return emitBreakStmtStmt(body, s, stmtIx, fnIx) }
  if s is ContinueStmt { return emitContinueStmtStmt(body, s, stmtIx, fnIx) }
  // A bare VALUE expression in NON-TAIL statement position is a DISCARDED value:
  // evaluate it for effect, then `drop` what it leaves. This is the same rule the
  // `BinExpr` arm above applies to `1 + 1` and `emitCallStmt` applies to a non-void
  // call (pinned by `tests/cases/statements/discarded-call-return.vl`), reached here
  // through the one shared classifier — `stmtIsTailValue`, which is exactly "this
  // statement IS a value" — so every value-shaped node discards by the same rule
  // instead of a hand-listed few.
  //
  // The TAIL statement of a body never arrives here: `emitFuncBody` and `emitStmtTail`
  // both test `stmtIsTailValue` FIRST and route a tail value to `emitReturnExit`, so
  // this cannot swallow an implicit return. The callers that do reach it are the
  // non-tail loops (`emitStmts`, the `emitFuncBody` prefix) — including a VOID `if`'s
  // arm blocks, which is how a value-producing `if`/`match` in statement position
  // discards each arm's value (a `match` is desugared to an if-chain by
  // `desugarMatchAt`, so the emitter sees only the chain).
  if stmtIsTailValue(stmtIx, fnIx) {
    if emitExpr(body, stmtIx, fnIx) < 0 { return -1 }
    fbDrop() // 0x1a drop
    return 0
  }
  emitFail("emitProgram: unsupported statement in body")
}

function emitLetDeclStmt(body: i32[], s: LetDecl, stmtIx: i32, fnIx: i32) {
  // `let x = <expr>` / `const x = <expr>`: emit the init, then store it into the
  // local's slot. This `LetDecl`'s slot is the next cursor position (collect allocated
  // slots in this SAME pre-order), so it owns declared-local slot `emitLetCursor` —
  // do NOT name-resolve it (a name lookup would hit an outer same-named binding still
  // in scope here). `paramN + slot` is its wasm local index.
  const slot = emitLetCursor
  emitLetCursor = emitLetCursor + 1
  let paramN = 0
  // The START function (`fnIx == -1`, top-level statements) has no params — and no
  // arena node to read, so the lookup must be guarded.
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl { paramN = fn.fnParams.length + envSlotShift(fnIx) }
  }
  const idx = paramN + slot
  if s.letInit < 0 {
    // UNINITIALIZED scalar local (validated by `checkLocalI32`): nothing to store
    // — the wasm local's implicit zero-init covers the declaration; bind the name
    // so later reads/writes resolve to this slot.
    scopeBind(s.letName, slot)
    return 0
  }
  // VALUE-FLOW MONOMORPHIZATION: a `const g = f` binding to a GENERIC (un-annotated-param)
  // NAMED function, where `g` is used ONLY as a direct-call callee (`g(args)`), is sound.
  // `monomorphize` rewrote each `g(args)` to its per-call instance (the first/i32 shape stays
  // on `f`'s own slot, keeping its un-annotated params for byte-identity), so the closure
  // stored here is `call_ref`'d only at the type its slot was pinned to. The value floor in
  // `emitClosureValue` would reject it on those un-annotated params, so emit through the
  // floor-LESS core. A value-USE of `g` (passed, returned, stored) escapes — `nameUsedAsValueIn`
  // catches it — and falls through to the normal path, where the floor rejects it.
  //
  // `monoInstantiatedAny` is the second half of that soundness argument and it is NOT optional:
  // "the closure is called only at the shape its slot was pinned to" presupposes a call site
  // pinned it. With NO call site the template stays un-pinned and its body emits at the i32
  // default, which for a non-numeric body is INVALID WASM at `vl check` rc 0 — witness
  // `function exclaim(s) { return s + "!" }` with `const f = exclaim` and no call, which reached
  // the engine as `type mismatch: expected (ref $type), found i32`. A never-called alias now
  // takes the floor's loud reject instead; the module-level twin gates the same way
  // (`monoGenericAliasFe`).
  if fnIx >= 0 {
    const aliasFe = fieldValueFeOf(s.letInit)
    if fnHasUnannotatedParam(aliasFe) {
      if !criFnIsAnonLambda(aliasFe) {
        if monoInstantiatedAny(aliasFe) {
          const encl = P.nodes[fnIx]
          if encl is FuncDecl {
            if !nameUsedAsValueIn(s.letName, encl.fnBody) {
              if emitClosureValueCore(body, aliasFe, fnIx) < 0 { return -1 }
              fbLocalSet(idx) // 0x21 local.set
              scopeBind(s.letName, slot)
              return 0
            }
          }
        }
      }
    }
  }
  // A degenerate UN-ANNOTATED `let x = null` (A-infer-null): when NO later
  // assignment fills the hole (`nliNameOf` recorded nothing), the binding's
  // type is the plain `null` type — it is never read as a non-null value, so
  // its i32 cell just zero-inits. A FILLED hole (`x = 5` later) is a `T|null`
  // value-union binding (kind 4) and takes the union-coerce path below.
  if s.letType < 0 {
    const bareN = P.nodes[unwrapParen(s.letInit)]
    if bareN is NullLit {
      if nliNameOf(stmtIx) == "" {
        fbI32Const(0)
        fbLocalSet(idx) // 0x21 local.set
        scopeBind(s.letName, slot)
        return 0
      }
    }
  }
  // An empty `[]` initializer over a ref-array annotation (`let xs: T[] = []`) needs
  // the element kind to pick the ref-list construction — record it for `emitArr`.
  pendingListKind = letAnnRefListKind(stmtIx)
  pendingListSlot = letAnnRefListSlot(stmtIx)
  // A kind-18 nullable ref-array binding: the list seeds above build the NON-null list,
  // this seeds the null arm. The #964 SEED-LEAK gate (stated in full at `emitObj`'s code-28
  // arm) at the BINDING boundary — witness `const g: (S | null)[] | null = [null]`
  // (fuzz-nightly bm leg, seed 160804094 d5).
  if localIsRef[slot] == "nulreflist" {
    if pendingListSlot >= 0 && pendingListSlot < rlWrapIdx.length {
      const nraInit = P.nodes[unwrapParen(s.letInit)]
      if nraInit is NullLit { pendingNulRefHeap = rlWrapIdx[pendingListSlot] }
    }
  }
  // A kind-15 nullable i32-list binding (`i32[] | null = null`): a bare `null` init lowers as
  // `ref.null $lTypeIdx` (the `pendingNulList` arm), the scalar-list analogue of the kind-18 seed above.
  // Without this a literal `= null` init fell through to the bare-null error (the type/narrowing worked,
  // but an actual null value never lowered).
  const letNulList15 = localIsRef[slot] == "nullist"
  // An UN-annotated empty `[]` whose USAGE pins a string element (`const out = [];
  // out.push(self[i])`): seed the string-list kind so `emitArr` builds the string-list
  // wrapper, MATCHING the slot `collectLocals` typed (kind 7, via the same
  // `letInfStrListByUseV`). Without this the inferred `[]` defaults to the i32 list and
  // the slot store mismatches. Unblocks a generic build-loop (`slice`/`reverse`) over
  // `string[]`.
  if pendingListKind == 0 && letInfStrListByUseV(stmtIx, fnIx) {
    pendingListKind = 3
  }
  // A `let b: B = { … }` struct LITERAL must build the annotation's struct, not a
  // first-field-name match — seed `pendingStructIdx` (consumed by `emitObj`) from the
  // annotation when it names a standalone struct, so a same-field-name sibling struct
  // does not win. Mirrors the call-arg / element / return / global seeding. A union
  // annotation names no `sNames` entry (`letAnnStructIdx` is -1) so a variant literal
  // still boxes; a non-struct-literal init ignores the hint.
  pendingStructIdx = letAnnStructIdx(stmtIx)
  // A NULLABLE-struct binding (`let b: P | null = …`, slot kind 9) seeds the SAME struct
  // context from the slot's recorded struct index — a bare `null` init lowers as
  // `ref.null $P` (the union annotation names no `sNames` entry, so `letAnnStructIdx`
  // gave -1), a struct literal builds that struct. Mirrors the global kind-9 cell seeding.
  if pendingStructIdx < 0 {
    if localIsRef[slot] == "nulstruct" {
      pendingStructIdx = localStructIdx[slot]
    }
  }
  // A `const c: Cat = { … }` variant-typed binding seeds the VARIANT index so the object
  // literal builds the bare variant struct (kind 8) instead of boxing into the union.
  pendingVariantIdx = letAnnVariantIdx(stmtIx)
  // A map-typed binding seeds the map SHAPE so a `Map()` initializer constructs
  // THIS binding's map struct (mono, or the annotation's ref-valued mv slot).
  if letIsMap(stmtIx, fnIx) { pendingMapSlot = letMapShapeOf(stmtIx, fnIx) }
  // A NULLABLE map binding (`let m: {[string]: V} | null = …`, slot kind `nulmap`): a `Map()` init
  // builds THIS map's struct (`pendingMapSlot` = the shape), and a bare `null` init lowers as
  // `ref.null $mapStruct` (`pendingNulRefHeap` = the map heap type, the generic ref-null seed). The
  // map twin of the kind-9 nulstruct seed above.
  if localIsRef[slot] == "nulmap" {
    const nmShape = nulMapShapeOf(stmtIx, fnIx)
    pendingMapSlot = nmShape
    pendingNulRefHeap = mapTypeIdxOf(nmShape)
  }
  // Numeric WIDENING at the binding boundary: an `: f64` / `: f32` / `: i64` slot
  // coerces a narrower init value (the lattice convert is inserted by the `emitExprAs*`
  // helpers — i32/i64/f32→f64, i32→f32, i32→i64). A float/integer literal re-encodes in
  // place via `pendingF32`/`pendingI64`. An i32-only binding stays byte-identical.
  // A UNION-annotated binding (kind 4) coerces a raw init value into the box
  // (`let u: boolean | i32 = 5` boxes the 5 with its atom tag); an already-union
  // init (a union-returning call) and a struct-union object literal pass through
  // `emitUnionCoerce` unchanged.
  let letUNm = ""
  let letAnnNm = ""
  if s.letType >= 0 { letAnnNm = tyNameOf(s.letType) }
  // A filled null hole (`let x = null` + later `x = e`, A-infer-null) is its
  // inferred `T|null` value union — coerce the bare `null` init into the box.
  if (
    isUName(letAnnNm) &&
    !nodeTyIsLitUnionAlias(s.letType) &&
    !nodeTyIsNulLitUnion(s.letType)
  ) {
    // A literal union (`type K = "a" | "b"`) reads as a union NAME but is an i32 ATOM, not a value-union
    // box — so it must NOT take the `emitUnionCoerce` path (which would `struct.new` the member).
    // The litunion exclusion is the ARENA's `nodeTyIsLitUnionAlias`, which is what the RETURN
    // boundary (`emitReturnValue`'s `retUNm`) has always asked — master asked `nameIsLitUnionType`
    // of the RENDER here and the arena there, two spellings of one question at the two ends of the
    // same value. The name leg reached this arm only for a name `isUName` already accepted, i.e. a
    // registered alias, which is exactly what the arena leg answers about.
    // D-NULLITHOME: the NULLABLE literal union is the same i32 ATOM (the `-1` sentinel niche), and the
    // NAME test above cannot see it — `nameIsLitUnionType` is false for a member set carrying `null`,
    // and a declared alias (`type K = "ab" | "zz" | null`) renders as the bare name `K`, which carries
    // no members to scan at all. Ask the ARENA, where the alias and the inline spelling are one type;
    // without this the `else` arm below already seeded `pendingLitUnion`/`pendingNulLitUnion` for the
    // atom lowering, but `emitUnionCoerce` claimed the init first and `struct.new`'d a box into an i32
    // niche cell — INVALID WASM.
    letUNm = letAnnNm
  } else if !isUName(letAnnNm) {
    letUNm = nliNameOf(stmtIx)
  }
  // A nullable / value-union if-EXPRESSION init (`const x: i32 | null = if c then 5
  // else null`, `else if` chains) lowers by writing the binding's own local in each
  // arm of a void `if` — no value-typed-if blocktype or scratch slot needed (the
  // binding local IS the destination). The slot kind `collectLocals` already chose is
  // the authoritative rep: kind 4 the value-union box (rep 0, needs the union NAME to
  // box each arm's atom — taken from the annotation / `letUNm`), kind 16 a `string |
  // null` ref (rep 1), kind 17 a `boolean | null` niche i32 (rep 2, sentinel 2 = null).
  if exprIsIfStmt(s.letInit) {
    const slotKind = localIsRef[slot]
    let nulRep = -1
    let nulNm = ""
    if slotKind == "union" {
      if letUNm != "" { nulNm = letUNm }
      else if s.letType >= 0 { nulNm = tyNameOf(s.letType) }
      if nulNm != "" { nulRep = 0 }
    } else if slotKind == "nulstr" {
      nulRep = 1
    } else if slotKind == "nulbool" {
      nulRep = 2
    }
    if nulRep >= 0 {
      // THE BINDING SINK: with every arm writing the shared pair and ONE `struct.new`
      // after the `if`, the arms' construction sites collapse to that one — and the
      // pre-seed below goes with them, because the single store dominates every read.
      if nulRep == 0 && fnUsesUnionLetSink {
        if unionIfBindingAllBox(s.letInit, fnIx) {
          if emitUnionIfBindingSink(body, s.letInit, idx, nulNm, fnIx) < 0 {
            return -1
          }
          fbLocalGet(unionSinkBase)
          fbLocalGet(unionSinkBase + 1)
          fbStructNew(uBoxIdx) // the binding's ONE box
          fbLocalSet(idx)
          scopeBind(s.letName, slot)
          return 0
        }
      }
      // The value-union box local (kind 4) is a NON-null `(ref $uBoxIdx)` — non-
      // defaultable, so the validator needs it definitely assigned. Both arms below
      // set it, but a void-`if` merge does not satisfy V8's local-init check; pre-seed
      // the rep's null first (overwritten by every arm). The `string | null` (nullable
      // ref) rep is defaultable and needs no pre-seed.
      if nulRep == 0 {
        if emitNulNullToLocal(body, idx, 0) < 0 { return -1 }
      }
      if (
        emitNullableIfBinding(body, s.letInit, idx, nulRep, nulNm, fnIx) <
        0
      ) {
        return -1
      }
      scopeBind(s.letName, slot)
      return 0
    }
  }
  if localIsRef[slot] == "nulclosure" {
    // A NULLABLE function-value binding (`let c: ((i32) => i32) | null = …`): the slot is
    // `(ref null $cloStruct)`. A bare `null` init lowers as `ref.null $cloStruct`
    // (`pendingNulClosure`); a function init stores its closure ref directly. Takes
    // priority over the union-coerce path (the `fn | null` annotation reads as a union
    // NAME, but this is a niche nullable ref, not a box).
    const ncCtx = expCtxHere()
    ncCtx.nulClosure = true
    if emitExprExpect(body, s.letInit, fnIx, ncCtx) < 0 { return -1 }
  } else if isNulScalarListKind(localIsRef[slot]) {
    // A DISTINCT-backing nullable scalar list binding (`string[]|null`, `f64[]|null`,
    // `i64[]|null`, `f32[]|null`): a bare `null` init lowers as `ref.null $wrapper`
    // (`nulRefHeap`), a list value builds the leaf list (`listKind`) which subtypes the
    // nullable slot. Priority over the union-coerce path (the niche is not a box).
    const nslCtx = expCtxHere()
    nslCtx.nulRefHeap = nulScalarListWrapHeap(localIsRef[slot])
    nslCtx.listKind = nulScalarListBuildKind(localIsRef[slot])
    if emitExprExpect(body, s.letInit, fnIx, nslCtx) < 0 { return -1 }
  } else if (
    localIsRef[slot] == "union" &&
    letNulMapReadUnionBox(stmtIx, fnIx)
  ) {
    // A bare `const t = m[k]` read of a UNION-valued map (kind 2): the binding is the
    // established `A | B | null` box local — hit loads the stored box, miss synthesizes
    // the null-tagged box (`emitMapGetUnionBox`). The init is the Index the classifier
    // resolved; read its receiver/key here.
    const umr = P.nodes[unwrapParen(s.letInit)]
    if umr is Index {
      if emitMapGetUnionBox(body, umr.idxArr, umr.idxIndex, fnIx) < 0 {
        return -1
      }
    } else {
      return emitFail(
        "emitProgram: union-valued map read binding's init is not an index read",
      )
    }
  } else if letUNm != "" {
    if emitUnionCoerce(body, letUNm, s.letInit, fnIx) < 0 { return -1 }
  } else if letIsF32(stmtIx) || letInfersF32(stmtIx, fnIx) {
    // `letIsF32` is ANNOTATION-only; `collectLocals` types the SLOT with
    // `letIsF32 || letInfersF32` (`emit_collect.vl`, the f32 arm), so an un-annotated
    // `const g = fv * 1.0` got a kind-13 f32 slot here while this ladder fell through to
    // the `letIsF64` arm below — whose own un-annotated fallback `exprIsF64` over-claims a
    // mixed f32/float-literal init. `emitExprAsF64` then promoted the f32 value and stored
    // an f64 into the f32 slot: `vl check` clean, INVALID WASM. The predicate is now the
    // SAME PAIR the slot ladder uses, so the init and the slot cannot disagree.
    const savedF32 = pendingF32
    pendingF32 = true
    if emitExprAsF32(body, s.letInit, fnIx) < 0 { return -1 }
    pendingF32 = savedF32
  } else if letIsF64(stmtIx, fnIx) {
    if emitExprAsF64(body, s.letInit, fnIx) < 0 { return -1 }
  } else if letIsI64(stmtIx, fnIx) {
    if emitExprAsI64(body, s.letInit, fnIx) < 0 { return -1 }
  } else if letAnnNm == "string" && exprIsLitAtom(s.letInit, fnIx) {
    // A literal-union atom initializing a `string` local widens to its member string.
    if emitAtomToStr(body, s.letInit, fnIx) < 0 { return -1 }
  } else if letIsNulString(stmtIx, fnIx) && exprIsLitAtom(s.letInit, fnIx) {
    // A literal-union ATOM initializing a `string | null` binding WIDENS to its member string.
    // The slot is the nullable string reference and the atom's rep is an i32 id, so without
    // this the store was `expected (ref null $type), found i32` — check-clean invalid wasm.
    //
    // The NON-nullable form needs no arm and takes none: `collectLocals` classifies
    // `const s: string = <atom>` as an ATOM SLOT (`letInitIsLitAtom` fires ahead of
    // `letIsString`), so nothing widens at the init and the widen happens at each READ. Only
    // the nullable annotation reaches a reference slot here, which is why this arm is keyed on
    // `letIsNulString` and not on "the annotation is stringy".
    if emitStrValue(body, s.letInit, fnIx) < 0 { return -1 }
  } else {
    // A NICHE `X | null` binding seeds its null rep for a bare `null` init (the table at
    // `emitNullLitNode`). Keyed on `letNulBool`/`letIsNulString` rather than the annotation
    // alone, so an INFERRED niche binding (`const r = f()` where `f` returns `boolean |
    // null`) seeds it too.
    pendingNulBool = letNulBool(stmtIx, fnIx)
    pendingNulString = letIsNulString(stmtIx, fnIx)
    if s.letType >= 0 {
      if nodeTyIsLitUnionAlias(s.letType) { pendingLitUnion = 1 }
      // `K | null` is dual-natured — a member init is an atom id, only a `null` is the
      // sentinel — so seed BOTH, as the param-arg / return boundaries do.
      if nodeTyIsNulLitUnion(s.letType) {
        pendingLitUnion = 1
        pendingNulLitUnion = true
      }
    }
    const savedNulList = pendingNulList
    if letNulList15 { pendingNulList = true }
    if emitExpr(body, s.letInit, fnIx) < 0 { return -1 }
    pendingNulBool = false
    pendingNulString = false
    pendingNulList = savedNulList
    pendingLitUnion = 0
    pendingNulLitUnion = false
  }
  pendingI64 = false
  pendingStructIdx = -1
  pendingVariantIdx = -1
  pendingListKind = 0
  pendingListSlot = 0
  pendingMapSlot = -1
  pendingNulRefHeap = -1
  fbLocalSet(idx) // 0x21 local.set
  // Bind `name → slot` in the current emit-time frame AFTER emitting the init (so the
  // init resolved any same-named OUTER binding), making this binding live for the rest
  // of the block — mirrors the collect pass so resolution matches slot allocation.
  scopeBind(s.letName, slot)
  return 0
}

function emitCallStmt(body: i32[], s: Call, stmtIx: i32, fnIx: i32) {
  // The only call STATEMENT this slice lowers is a list append `recv.push(x)` (a
  // `Call` whose `callFn` is a `Member`). A bare top-level call statement (a function
  // call whose value is discarded) is out of scope.
  const callee = P.nodes[s.callFn]
  if callee is Member {
    if callee.memProp == "push" { return emitPush(body, stmtIx, fnIx) }
    // A `.pop()` STATEMENT discards the popped element — emit the pop, then `drop`
    // the value it leaves on the stack.
    if callee.memProp == "pop" {
      if emitPop(body, stmtIx, fnIx) < 0 { return -1 }
      fbDrop() // 0x1a drop
      return 0
    }
    // A `.clear()` STATEMENT resets the list's length to 0 (backing retained).
    if callee.memProp == "clear" {
      if (
        exprArray(callee.memObj, fnIx) ||
        exprRefArray(callee.memObj, fnIx) ||
        exprStringArray(callee.memObj, fnIx)
      ) {
        return emitClear(body, stmtIx, fnIx)
      }
    }
    // G8: a map `m.set(k, v)` STATEMENT is the method form of `m[k] = v` — the
    // same scan/overwrite-or-append lowering.
    if callee.memProp == "set" {
      if exprMap(callee.memObj, fnIx) {
        if s.callArgs.length != 2 {
          return emitFail("emitProgram: map set takes exactly two arguments")
        }
        return emitMapSet(
          body,
          callee.memObj,
          s.callArgs[0],
          s.callArgs[1],
          fnIx,
        )
      }
    }
    // A Set `s.add(k)` STATEMENT is the membership-insert form of `s[k] = true` — the
    // SAME scan/overwrite-or-append lowering as `emitMapSet`, but storing the constant
    // boolean `1` (true) as the value (the Set vals-list carries true for live keys).
    // It takes EXACTLY one arg; the result (if any) is discarded.
    if callee.memProp == "add" {
      if exprMap(callee.memObj, fnIx) {
        if s.callArgs.length != 1 {
          return emitFail("emitProgram: set add takes exactly one argument")
        }
        return emitMapSetV(body, callee.memObj, s.callArgs[0], -1, fnIx, true)
      }
    }
    // G8: a bare `m.delete(k)` STATEMENT discards the boolean result — emit the
    // delete, then `drop` the 0/1 it leaves on the stack.
    if callee.memProp == "delete" {
      if exprMap(callee.memObj, fnIx) {
        if s.callArgs.length != 1 {
          return emitFail("emitProgram: map delete takes exactly one argument")
        }
        if emitMapDelete(body, callee.memObj, s.callArgs[0], fnIx) < 0 {
          return -1
        }
        fbDrop() // 0x1a drop (discard the boolean result)
        return 0
      }
    }
    // A CLOSURE-FIELD member call STATEMENT (`(o."[]=")(k, v)` — the rewritten
    // index WRITE trap, or any function-valued field invoked for effect):
    // `call_ref` it; drop the result unless the field's function is void.
    if exprIsClosure(s.callFn, fnIx) {
      if emitCallRef(body, stmtIx, fnIx) < 0 { return -1 }
      const mcFe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
      let mcVoid = false
      if mcFe >= 0 {
        if fRetVoid[mcFe] == 1 { mcVoid = true }
      }
      if !mcVoid {
        fbDrop() // 0x1a drop (discard the unused result)
      }
      return 0
    }
    return emitFail("emitProgram: unsupported member-call statement")
  }
  if callee is Ident {
    // A bare call whose RESULT is discarded (a helper invoked for its side
    // effects): emit the call, then `drop` the value it leaves — EXCEPT `print`
    // (a void import) and a VOID function (`()->()` leaves nothing).
    if emitCall(body, stmtIx, fnIx) < 0 { return -1 }
    let dropIt = callee.identName != "print"
    // The void memory intrinsics leave nothing on the stack.
    if callee.identName == "__store_i32__" { dropIt = false }
    if nameIsMemStoreIntrinsic(callee.identName) { dropIt = false }
    if nameIsMemBulkIntrinsic(callee.identName) { dropIt = false }
    if callee.identName == "__log__" { dropIt = false }
    // The void array intrinsics: `__array_copy__` leaves nothing; `__trap__`
    // is `unreachable` (no value reaches the drop).
    if callee.identName == "__array_copy__" { dropIt = false }
    if callee.identName == "__trap__" { dropIt = false }
    if dropIt {
      const vt = fnIndexOfSid(sidOfNode(s.callFn))
      if vt >= 0 {
        if fRetVoid[vt] == 1 { dropIt = false }
      } else if calleeReturnsVoid(callee.identName, fnIx) {
        // A closure-VALUE callee (a param / binding, invisible to `fnIndexOf`) whose
        // `$fnsig` is void leaves nothing — no `drop`.
        dropIt = false
      }
    }
    if dropIt {
      fbDrop() // 0x1a drop
    }
    return 0
  }
  return emitFail("emitProgram: bare call statement is not supported")
}

// The compile-time value of an `if` CONDITION that is a monomorphized-instance guard
// testing an INLINE STRUCT SHAPE (1 / 0), or -1 for anything else. Dropping an arm is
// a control-flow change, so this is deliberately narrower than `emitIs`'s static path:
//   - the condition must be a bare `IsExpr` (no compound / parenthesized forms);
//   - the receiver must be a bare IDENT — the monomorphized param. `emitIs`'s
//     union-FIELD, optional-chain and box-tag receiver forms are RUNTIME tests;
//   - a LITERAL variant name is a runtime VALUE test (a softened `0 | 1` union rides
//     its base scalar, so `monoArgTyName` reports `i32` and the name compare would
//     "decide" a test that must run — `soundness/literal-is-runtime-value.vl`);
//   - a nullable-struct receiver is the `!ref.is_null` narrowing test;
//   - and the tested name must be a whole-span `{…}` SHAPE, which scopes this to the
//     anonymous-shape family that motivated it and leaves every scalar / closure /
//     array / declared-name guard emitting both arms exactly as before.
function monoStaticIsGuardOf(condIx: i32, fnIx: i32) {
  const c = P.nodes[condIx]
  if c is IsExpr {
    const recv = P.nodes[unwrapParen(c.isObj)]
    if !(recv is Ident) { return -1 }
    if isLitVariantName(c.isVariant) { return -1 }
    if !nameIsWholeSpanShape(c.isVariant) { return -1 }
    if exprNullableStruct(c.isObj, fnIx) { return -1 }
    return monoStaticIsResult(condIx, fnIx)
  }
  -1
}

// The DUAL of `emitIfStmtStmt`'s dead-arm skip: a statement `if` whose mono-instance
// `is` guard is statically TRUE and whose then-branch ALWAYS RETURNS ends the block
// for this instance — everything after it is the guard's COMPLEMENT path, typed
// against the other instances' bindings (`return v.bar` where THIS instance's `v` is
// `{foo: string}`), and generally cannot lower at all. Truncating there is host
// parity: those statements can never run in this instance. The caller emits an
// `unreachable` at the cut so the block stays stack-polymorphic (the same padding
// `emitProgram` writes for a proven-dead fall-through).
function monoStaticGuardEndsBlock(stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  if s is IfStmt {
    if monoStaticIsGuardOf(s.ifCond, fnIx) != 1 { return false }
    return blockAlwaysReturns(s.ifThen)
  }
  false
}

function emitIfStmtStmt(body: i32[], s: IfStmt, _stmtIx: i32, fnIx: i32) {
  // Structured void `if`: push the i32 condition, then `if 0x04` with void blocktype `0x40`.
  // The then-branch's statements run when the condition is non-zero; an optional `else 0x05`
  // branch runs otherwise; `end 0x0b` closes it. Both branches `return` on their own, so the
  // `if` yields no value. A monomorphized-instance `is` guard is decided at COMPILE TIME
  // (see `monoStaticIsResult`), so one arm can be provably UNREACHABLE in this instance.
  // Emit that arm as EMPTY: its statements are typed against the OTHER instance's binding and
  // generally cannot lower at all (`v.foo` where this instance's `v` is an i32 — "field
  // access but no struct type declared"). Skipping is host parity — the branch can never run
  // here. -1 = not static, both arms emit as before.
  const staticGuard = monoStaticIsGuardOf(s.ifCond, fnIx)
  if emitExpr(body, s.ifCond, fnIx) < 0 { return -1 }
  fbIf(64) // 0x04 if, 0x40 void blocktype
  // The `if` opens ONE control frame (the `else` reuses it, `end` closes it), so a
  // `break`/`continue` nested in either arm sees the right relative `br` depth.
  ctrlEnter()
  // If the condition is `n is Variant` over a bare union identifier, narrow `n` to
  // that variant for the THEN-branch only (so `n.field` downcasts). Save/restore the
  // outer narrowing around the branch so nesting and the else-branch are unaffected.
  const savedTop = narrowTop
  const narrowed = setNarrowFromCond(s.ifCond, fnIx)
  if staticGuard != 0 {
    if emitStmts(body, s.ifThen, fnIx) < 0 { return -1 }
  }
  if narrowed { restoreNarrow(savedTop) }
  if s.ifElse >= 0 && staticGuard != 1 {
    fbElse() // 0x05 else
    // The else may be a Block or a nested IfStmt (`else if`); both go through
    // `emitStmt` (a lone statement) — a Block re-enters `emitStmts`. The then
    // narrowing does NOT hold in the else-branch (the guard was false there);
    // a VALUE union narrows to the COMPLEMENT set instead (`is T` removes `T`).
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    const els = P.nodes[s.ifElse]
    if els is Block {
      if emitStmts(body, s.ifElse, fnIx) < 0 { return -1 }
    } else {
      if emitStmt(body, s.ifElse, fnIx) < 0 { return -1 }
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
  }
  fbEnd() // 0x0b end
  ctrlLeave()
  return 0
}

function emitWhileStmtStmt(body: i32[], s: WhileStmt, _stmtIx: i32, fnIx: i32) {
  // Structured while loop: block (void) wrapping a loop (void).
  // The condition is checked at the top; if false (eqz), br_if 1 exits the block;
  // body runs, then br 0 continues the loop. Two `end` bytes close loop then block.
  // Track the two control frames so `break`/`continue` in the body compute their
  // relative `br` depth: the BLOCK is the `break` target (resume after the loop),
  // the LOOP is the `continue` target (re-check the condition). Push the ABSOLUTE
  // `ctrlDepth` of each frame; a branch site at depth D uses `D - <that depth>`.
  //
  // The list-header hoists open BEFORE the block: their prologue runs once, and
  // a loop that never iterates simply leaves them unread (reading a non-null
  // wrapper's fields cannot trap, so moving them out of the loop cannot move a
  // trap into one).
  const whHoist = loopHoistOpen(body, s.whileCond, s.whileBody, fnIx, "")
  if whHoist < 0 { return -1 }
  fbBlock(64) // 0x02 block, 0x40 void blocktype
  ctrlEnter()
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.whileLabel)
  fbLoop(64)  // 0x03 loop, 0x40 void blocktype
  ctrlEnter()
  loopContDepth.push(ctrlDepth)
  loopContLabel.push(s.whileLabel)
  // condition + eqz: if condition is false (zero), exit block
  if emitExpr(body, s.whileCond, fnIx) < 0 { return -1 }
  fbI32Eqz() // 0x45 i32.eqz (invert: exit if condition was false)
  fbBrIf(1)  // 0x0d br_if, depth 1 = break out of block
  // THE BODY IS A NARROWING SCOPE (the checker's `checkWhileStmtNode` narrows it): the
  // condition is re-tested at the top of every iteration, so a `while e != null { … }`
  // body reads `e` unboxed exactly as an `if` arm does. Pushed AFTER the condition —
  // the condition itself re-reads the raw union each iteration — and rewound after the
  // body so the fall-through and any enclosing scope are unaffected.
  //
  // Pushed after `loopHoistOpen` too, and that ORDER is load-bearing: the hoist
  // prologue runs ONCE, before the loop's first condition test, so a receiver it
  // classified under the narrowing would have its header read while the guard has not
  // yet held — a trap on the null input. Leaving the hoist to see the un-narrowed
  // nullable type is what keeps it off a guarded receiver.
  //
  // Only the NULL-STRIP facts are taken (`narrowStripNullOnly`, held across the push and
  // cleared before the body so a nested `if` inside it narrows normally): the narrowed
  // type is also what the binding ACCEPTS in the scope, and an `is T` narrowing would
  // therefore reject the variant flip a loop uses to terminate.
  const whSavedTop = narrowTop
  const whSavedStrip = narrowStripNullOnly
  narrowStripNullOnly = true
  const whNarrowed = setNarrowFromCond(s.whileCond, fnIx)
  narrowStripNullOnly = whSavedStrip
  // body statements
  if emitStmts(body, s.whileBody, fnIx) < 0 { return -1 }
  if whNarrowed { restoreNarrow(whSavedTop) }
  fbBr(0) // 0x0c br, depth 0 = continue loop
  fbEnd() // 0x0b end (loop)
  ctrlLeave()
  loopContDepth.pop()
  loopContLabel.pop()
  fbEnd() // 0x0b end (block)
  ctrlLeave()
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  loopHoistClose(whHoist)
  return 0
}

function emitForRangeStmt(body: i32[], s: ForRange, _stmtIx: i32, fnIx: i32) {
  // `for v in A to B [step K] { body }` — an INCLUSIVE numeric range, lowered to
  // the same block/loop shape as `while`. The loop var `v` and a synthetic bound
  // temp own the next TWO cursor slots (collectLocals allocated them in this same
  // pre-order). The step must be a CONSTANT integer literal (optionally negated);
  // its SIGN picks the exit comparison: ascending exits when v > bound (i32.le_s
  // + eqz), descending when v < bound (i32.ge_s + eqz). The bound is evaluated
  // ONCE into the temp.
  const vSlot = emitLetCursor
  emitLetCursor = emitLetCursor + 1
  const bSlot = emitLetCursor
  emitLetCursor = emitLetCursor + 1
  let paramN = 0
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl { paramN = fn.fnParams.length + envSlotShift(fnIx) }
  }
  const vIdx = paramN + vSlot
  const bIdx = paramN + bSlot
  // Static step: default +1; `step <int>` / `step -<int>`. The lexeme must be an
  // integer that FITS i32 (`numLexFitsI32`, `emitNumLitNode`'s guard) before the
  // `parseI32` fold — an out-of-range step (`step 4294967297`) would otherwise
  // silently truncate (the checker rejects it upstream; this is the emitter's own
  // never-silently-wrong-bytes backstop).
  let stepK = 1
  if s.frStep >= 0 {
    const st = P.nodes[s.frStep]
    if st is NumLit {
      if numTextIsFloat(st.numText) || !numLexFitsI32(st.numText) {
        return emitFail(
          "emitProgram: for-range step must be an i32 integer literal",
        )
      }
      stepK = parseI32(st.numText)
    } else if st is Unary {
      if st.unOp == "-" {
        const inner = P.nodes[st.unArg]
        if inner is NumLit {
          if numTextIsFloat(inner.numText) || !numLexFitsI32(inner.numText) {
            return emitFail(
              "emitProgram: for-range step must be an i32 integer literal",
            )
          }
          stepK = 0 - parseI32(inner.numText)
        } else {
          return emitFail(
            "emitProgram: for-range step must be a constant integer",
          )
        }
      } else {
        return emitFail(
          "emitProgram: for-range step must be a constant integer",
        )
      }
    } else {
      return emitFail("emitProgram: for-range step must be a constant integer")
    }
  }
  if stepK == 0 {
    return emitFail("emitProgram: for-range step must not be zero")
  }
  // v = A; bound = B (each evaluated once, in source order)
  if emitExpr(body, s.frFrom, fnIx) < 0 { return -1 }
  fbLocalSet(vIdx)
  if emitExpr(body, s.frTo, fnIx) < 0 { return -1 }
  fbLocalSet(bIdx)
  // The hoist prologue runs AFTER the range bounds (whose expressions may do
  // anything) and BEFORE the loop variable is bound, so its receiver reads
  // resolve in the enclosing scope. `frVar` itself is never a candidate — the
  // body sees it as a fresh i32 binding.
  const frHoist = loopHoistOpen(body, -1, s.frBody, fnIx, s.frVar)
  if frHoist < 0 { return -1 }
  // Bind the loop var for the body (mirrors the collect pass's scopeBind).
  scopeBind(s.frVar, vSlot)
  fbBlock(64) // 0x02 block, void
  ctrlEnter()
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.frLabel)
  fbLoop(64)  // 0x03 loop, void
  ctrlEnter()
  loopContDepth.push(ctrlDepth)
  loopContLabel.push(s.frLabel)
  // continue-condition: le_s (ascending) / ge_s (descending), inverted to exit
  fbLocalGet(vIdx)
  fbLocalGet(bIdx)
  if stepK > 0 {
    fbI32Bin(76) // 0x4c i32.le_s
  } else {
    fbI32Bin(78) // 0x4e i32.ge_s
  }
  fbI32Eqz() // 0x45 invert: exit when out of range
  fbBrIf(1)  // 0x0d br_if -> break out of block
  // A body with a `continue` binding to THIS loop (direct, or `continue
  // <label>` from a nested loop) needs an INNER block as the continue
  // target: branching to its END falls into the increment (a branch to the
  // loop header would SKIP the increment — an infinite loop). A body without
  // one keeps the original two-frame shape (goldens pinned on it). The inner
  // block carries the loop's LABEL too, shadowing the header entry, so a
  // binding `continue` lands on the increment.
  const frHasCont = blockHasContinueFor(s.frBody, s.frLabel, false)
  if frHasCont {
    fbBlock(64) // continue block
    ctrlEnter()
    loopContDepth.push(ctrlDepth)
    loopContLabel.push(s.frLabel)
  }
  if emitStmts(body, s.frBody, fnIx) < 0 { return -1 }
  if frHasCont {
    fbEnd() // end continue block — `continue` lands here
    ctrlLeave()
    loopContDepth.pop()
    loopContLabel.pop()
  }
  // v = v + K
  fbLocalGet(vIdx)
  fbI32Const(stepK)
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(vIdx)
  fbBr(0)       // continue loop
  fbEnd()       // end loop
  ctrlLeave()
  loopContDepth.pop()
  loopContLabel.pop()
  fbEnd()       // end block
  ctrlLeave()
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  loopHoistClose(frHoist)
  // The loop variable's scope is the loop (see `scopeUnbind`).
  scopeUnbind()
  return 0
}

function emitForInStmt(body: i32[], s: ForIn, _stmtIx: i32, fnIx: i32) {
  // `for v in <list> { body }` — iterate an i32 list, a string list, a struct
  // `S[]` ref list, or a map's ordered `.keys()`/`.values()` list. THREE cursor
  // slots in collect pre-order: the element var `v` (i32, a string ref, or a struct
  // ref), a hidden i32 cursor `v#i`, and a hidden list temp `v#l` (the iterable
  // evaluates ONCE). Shape mirrors `while`: block/loop, exit on `cursor >= len`,
  // element read per iteration, cursor++.
  const ek = forInElemKind(s.fiIter, fnIx)
  if ek == null { return emitFail("emitProgram: unsupported for-in iterable") }
  // A STRING iterable (`for ch in s`): the `#l` temp IS the raw `(ref $aTypeIdx)` array (no
  // list wrapper), so the length is `array.len` and each element `array.get $aTypeIdx` —
  // skipping the `struct.get wrapTy` the i32-list path uses. The loop var is an i32 code unit.
  const strSrc = forInStringSrc(s.fiIter, fnIx)
  const vSlot = emitLetCursor
  emitLetCursor = emitLetCursor + 1
  const iSlot = emitLetCursor
  emitLetCursor = emitLetCursor + 1
  const lSlot = emitLetCursor
  emitLetCursor = emitLetCursor + 1
  let paramN = 0
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl { paramN = fn.fnParams.length + envSlotShift(fnIx) }
  }
  const vIdx = paramN + vSlot
  const iIdx = paramN + iSlot
  const lIdx = paramN + lSlot
  let wrapTy = lTypeIdx
  let backTy = aTypeIdx
  if ek == "str" || ek == "nulstr" {
    // `string[]` and `(string | null)[]` share one backing (`$mkList` / `$mkArr`, whose
    // element slot is nullable either way) and differ ONLY in the loop var: `str` recovers
    // each element non-null below, `nulstr` keeps the raw `(ref null $aTypeIdx)` so a null
    // element is a value the body can test rather than a trap.
    wrapTy = mkListIdx
    backTy = mkArrIdx
  } else if (
    ek == "struct" ||
    ek == "union" ||
    ek == "nulstruct" ||
    ek == "list" ||
    ek == "nullist" ||
    ek == "strlist" ||
    ek == "f64list" ||
    ek == "i64list" ||
    ek == "f32list" ||
    ek == "closure" ||
    ek == "reflist"
  ) {
    // A struct ref list (`S[]`, ek 1), a UNION-box element list (`(C|S)[]`, ek 4), a
    // NULLABLE-struct element list (`(P|null)[]`, ek 9), a CLOSURE element list
    // (`((i32)=>i32)[]`, ek 14), a NESTED-ARRAY scalar inner list (ek 2/7/12/20 — nullable
    // for a `(i32[]|null)[]` niche), or a NESTED REF array whose loop var is the inner REF
    // LIST (`S[][]`, ek 5): the wrapper/backing are THIS ref-list slot's. All recover each
    // element non-null EXCEPT the two nullable NICHES (ek 9, and the nullable inner list). A
    // STRUCT-VALUED map walk reads its mv slot's vals list instead.
    const fimv = forInMapValsSlot(s.fiIter, fnIx)
    if fimv >= 0 {
      wrapTy = mvValsWrapOf(fimv)
      backTy = mvValsBackOf(fimv)
    } else {
      const rslot = refListSlotOfExpr(s.fiIter, fnIx)
      wrapTy = rlWrapIdx[rslot]
      backTy = rlBackIdx[rslot]
    }
  } else if ek == "f64" || ek == "i64" || ek == "f32" {
    // A scalar f64/i64/f32 element list: the wrapper/backing come from the descriptor, and
    // `array.get <back>` yields the scalar directly (no `ref.as_non_null`).
    wrapTy = scalarListWrap(ek)
    backTy = scalarListBack(ek)
  }
  // For a map iteration (`m.keys()`, `m.values()`, or the bare `for k in m` —
  // `mapRecv >= 0` iff so), evaluate the receiver ONCE and stash the MAP ref (mono
  // scratch slot 0, the i32-keyed frame's twin, or the mv frame's typed mapRef). THE
  // STASH IS THE RECEIVER'S ONLY EVALUATION: the walked list below, the loop bound and
  // the skip's `M.live[cursor]` all read it, so all three see one object and the
  // receiver's side effects run once. The pinned `cmSlot` drives the stash local, the
  // list field and the skip's `pushMapLive` struct.get type alike.
  const mapRecv = forInMapRecv(s.fiIter, fnIx)
  let mwShape = -1
  if mapRecv >= 0 {
    mwShape = mapShapeOfExpr(mapRecv, fnIx)
    mwShape = mapShapeFoldSet(mwShape)
    if pushMapRecvRef(body, mapRecv, fnIx) < 0 { return -1 }
    cmSlot = mwShape
    setMapRef(body) // mapRef
  }
  // list = <iter> (evaluated once); cursor = 0
  if emitForInList(body, s.fiIter, fnIx, mapRecv, mwShape) < 0 { return -1 }
  // A NARROWED nullable-list iterable keeps its nullable slot at EVERY element kind — the
  // i32-list niche, a distinct-backing scalar list and a ref array alike; the `#l` temp is
  // non-null, so recover first (checker-guarded). See `nulRecvNeedsRecover`.
  if nulRecvNeedsRecover(s.fiIter, fnIx) {
    wU8(212) // 0xd4 ref.as_non_null
  }
  fbLocalSet(lIdx)
  fbI32Const(0)
  fbLocalSet(iIdx)
  scopeBind(s.fiVar, vSlot)
  fbBlock(64) // 0x02 block, void
  ctrlEnter()
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.fiLabel)
  fbLoop(64)  // 0x03 loop, void
  ctrlEnter()
  loopContDepth.push(ctrlDepth)
  loopContLabel.push(s.fiLabel)
  // exit when cursor >= len (the list wrapper's field 1; a STRING is the raw array → array.len)
  fbLocalGet(iIdx)
  fbLocalGet(lIdx)
  if strSrc { fbArrayLen() } else { fbStructGet(wrapTy, 1) }
  fbI32Bin(78) // 0x4e i32.ge_s
  fbBrIf(1)    // 0x0d br_if -> break out of block
  // TOMBSTONE SKIP: if M.live[cursor] == 0, advance the cursor and re-loop WITHOUT
  // binding `v` / running the body — the deleted entry is invisible to iteration
  // (insertion order of the survivors preserved). `br 1` targets the loop header
  // (if-frame is 0, loop is 1). A delete-free map has live all-1s, so never taken.
  if mapRecv >= 0 {
    cmSlot = mwShape
    pushMapLive(body)    // M.live (off the pinned mapRef)
    fbLocalGet(iIdx)
    fbArrayGet(aTypeIdx) // M.live[cursor]
    fbI32Eqz()           // live[cursor] == 0 ?
    fbIf(64)             // 0x04 if, void
    fbLocalGet(iIdx)
    fbI32Const(1)
    fbI32Bin(106)        // cursor + 1
    fbLocalSet(iIdx)
    fbBr(1)              // 0x0c br -> loop header (re-check exit)
    fbEnd()              // 0x0b end (if)
  }
  // v = backing[cursor] (a string element recovers its non-null ref). A STRING source IS the
  // raw array, so index it directly (no list-wrapper `struct.get`); the code unit is an i32.
  fbLocalGet(lIdx)
  if !strSrc { fbStructGet(wrapTy, 0) }
  fbLocalGet(iIdx)
  if strSrc { fbArrayGet(aTypeIdx) } else { fbArrayGet(backTy) }
  if (
    ek == "str" ||
    ek == "struct" ||
    ek == "union" ||
    ek == "list" ||
    ek == "strlist" ||
    ek == "f64list" ||
    ek == "i64list" ||
    ek == "f32list" ||
    ek == "closure" ||
    ek == "reflist"
  ) {
    // string / struct / union-box / CLOSURE element, a NESTED-ARRAY inner-list wrapper, or a
    // nested-ref-array inner REF LIST (ek 5) — all are a non-null ref recovered from the
    // `(ref null <elem>)` backing slot.
    //
    // THE THREE NICHE ELEMENT KINDS ARE ABSENT ON PURPOSE: `nulstruct` (`(P | null)[]`),
    // `nulstr` (`(string | null)[]`) and `nullist` (`(i32[] | null)[]`) bind a loop var that
    // legitimately holds null, so recovering here would trap on exactly the element the body
    // is about to test.
    wU8(212) // 0xd4 ref.as_non_null
  }
  fbLocalSet(vIdx)
  // Same INNER continue block as for-range: `continue` must still increment.
  const fiHasCont = blockHasContinueFor(s.fiBody, s.fiLabel, false)
  if fiHasCont {
    fbBlock(64) // continue block
    ctrlEnter()
    loopContDepth.push(ctrlDepth)
    loopContLabel.push(s.fiLabel)
  }
  if emitStmts(body, s.fiBody, fnIx) < 0 { return -1 }
  if fiHasCont {
    fbEnd() // end continue block — `continue` lands here
    ctrlLeave()
    loopContDepth.pop()
    loopContLabel.pop()
  }
  // cursor = cursor + 1
  fbLocalGet(iIdx)
  fbI32Const(1)
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(iIdx)
  fbBr(0)       // continue loop
  fbEnd()       // end loop
  ctrlLeave()
  loopContDepth.pop()
  loopContLabel.pop()
  fbEnd()       // end block
  ctrlLeave()
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  // The loop variable's scope is the loop (see `scopeUnbind`).
  scopeUnbind()
  return 0
}

function emitBreakStmtStmt(
  _body: i32[],
  s: BreakStmt,
  _stmtIx: i32,
  _fnIx: i32,
) {
  // `break [label]`: branch out of a loop's wrapping BLOCK, so control resumes
  // after the whole loop. Unlabelled targets the innermost (`loopBrkDepth` top);
  // `break outer` scans the parallel label stack from the top for `outer` —
  // the host's `brkLabel(node.label ?? loopLabels[last])` target selection.
  // The relative `br` operand is the frame distance `ctrlDepth - <block depth>`.
  // A `break` outside any loop / to an unknown label fails loudly, not with a
  // bad `br`.
  if loopBrkDepth.length == 0 {
    return emitFail("emitProgram: `break` outside a loop")
  }
  const brkAt = loopStackFind(loopBrkLabel, s.brkLabel)
  if brkAt < 0 {
    return emitFail(
      "emitProgram: `break` label does not name an enclosing loop",
    )
  }
  const blkDepth = loopBrkDepth[brkAt]
  fbBr(ctrlDepth - blkDepth) // 0x0c br to the loop's wrapping block
  return 0
}

function emitContinueStmtStmt(
  _body: i32[],
  s: ContinueStmt,
  _stmtIx: i32,
  _fnIx: i32,
) {
  // `continue [label]`: branch to a loop's continue target — the loop header
  // for a `while` (re-check the condition), the inner continue block for a
  // `for` (fall into the increment). Unlabelled targets the innermost;
  // `continue outer` scans the label stack from the top (the labelled for's
  // INNER block shadows its header entry — both carry the label — so a
  // binding `continue` never skips the increment).
  if loopContDepth.length == 0 {
    return emitFail("emitProgram: `continue` outside a loop")
  }
  const contAt = loopStackFind(loopContLabel, s.contLabel)
  if contAt < 0 {
    return emitFail(
      "emitProgram: `continue` label does not name an enclosing loop",
    )
  }
  const loopDepth = loopContDepth[contAt]
  fbBr(ctrlDepth - loopDepth) // 0x0c br to the loop's continue target
  return 0
}

// Lower a function's TOP-LEVEL body block at `blockIx`: every statement but the last
// is lowered normally; if the LAST statement is a bare value expression (no `return`
// keyword), it is lowered as the function's return value (`emitExpr` + `return`) —
// VL's implicit-return idiom. A last statement that is itself a real statement (a
// `return`, `if`, `while`, assignment, `.push`, or `let`) is lowered unchanged. An
// empty body is left to the existing validation. Returns 0, or -1 (via `emitFail`).
export function emitFuncBody(body: i32[], blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    // Enter the function's top-level lexical scope (mirrors `collectLocals` on the body
    // block). The emit-time scope stack drives same-named-local resolution.
    scopePush()
    const stmts = b.blkStmts
    const n = stmts.length
    // A guard `if` (no else, then-branch always returns) narrows the REST of the
    // body to the guard's complement (the host's post-early-return flow narrowing).
    const savedGuardTop = narrowTop
    let i = 0
    while i < n {
      const isLast = i == n - 1
      if isLast && stmtIsTailValue(stmts[i], fnIx) {
        // Implicit return: seed the return context + push the value (so a trailing
        // `null` / nullable value boxes or sentinels exactly like `return e`), then
        // terminate the exit.
        if emitReturnExit(body, stmts[i], fnIx) < 0 {
          scopePop()
          return -1
        }
      } else if isLast && lastStmtIsValueIf(stmts[i], fnIx) {
        // The body ends in an `if`/`else` whose arms each yield a value (implicit
        // return) rather than `return`ing — lower it tail-aware so each arm's trailing
        // value expression becomes the function's return.
        if emitIfTail(body, stmts[i], fnIx) < 0 {
          scopePop()
          return -1
        }
      } else if isLast && elseLessNullableTail(stmts[i], fnIx) {
        // The body ends in an else-less `if` whose then-arm yields a VALUE and whose
        // return type is NULLABLE (`function f(c) { if c then 5 }` → `i32 | null`): lower
        // it tail-aware (the then-arm returns its value); the false fall-through is lowered
        // as `null` by the function-end padding (`emitNullForRet`). Gated on the FINAL
        // `fRetVoid`/nullable classification — unlike `lastStmtIsValueIf`/`ifTailIsValue`,
        // which feed the `fRetVoid` fixpoint in `buildFnMap` and so must NOT treat an
        // else-less recursive tail as a value (a void procedure's `if n>0 { rec(n-1) }`).
        if emitIfTail(body, stmts[i], fnIx) < 0 {
          scopePop()
          return -1
        }
      } else {
        if emitStmt(body, stmts[i], fnIx) < 0 {
          scopePop()
          return -1
        }
      }
      // A statically-TRUE `is` guard that always returns ends this instance's body.
      if monoStaticGuardEndsBlock(stmts[i], fnIx) {
        fbUnreachable() // 0x00 (dead padding — the cut path never runs)
        i = n
      } else {
        pushPostGuardNarrow(stmts[i], fnIx)
        i = i + 1
      }
    }
    restoreNarrow(savedGuardTop)
    scopePop()
    return 0
  }
  emitFail("emitProgram: function has no block body")
}

// Lower every statement of the block at `blockIx` onto `body`, in order. Returns 0,
// or -1 (via `emitFail`) on a non-block node or an unsupported statement within.
function emitStmts(body: i32[], blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    // A nested block (if-then / if-else / while-body) is its own lexical scope (mirrors
    // `collectLocals` recursing into it): push a frame so its `let`s shadow correctly and
    // are dropped on exit.
    scopePush()
    const stmts = b.blkStmts
    // Post-guard complement narrowing (see `emitFuncBody`/`pushPostGuardNarrow`).
    const savedGuardTop = narrowTop
    let i = 0
    while i < stmts.length {
      if emitStmt(body, stmts[i], fnIx) < 0 {
        scopePop()
        return -1
      }
      if monoStaticGuardEndsBlock(stmts[i], fnIx) {
        fbUnreachable() // 0x00 — see `monoStaticGuardEndsBlock`
        i = stmts.length
      } else {
        pushPostGuardNarrow(stmts[i], fnIx)
        i = i + 1
      }
    }
    restoreNarrow(savedGuardTop)
    scopePop()
    return 0
  }
  emitFail("emitProgram: function has no block body")
}

// Lower a block at `blockIx` that sits in TAIL position (its value is the enclosing
// function's return value). Every statement but the last is lowered normally; the
// LAST is lowered tail-aware via `emitStmtTail`, so a bare value expression there
// becomes an implicit return and a nested `if`/`else` recurses with each arm in tail
// position. This is the structured-block analogue of `emitFuncBody`'s top-level
// implicit-return handling, letting a function body like `if c { a } else { b }`
// (each arm an implicit-return expression) lower correctly. Returns 0, or -1.
function emitStmtsTail(body: i32[], blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    const n = stmts.length
    if n == 0 { return emitFail("emitProgram: empty block in tail position") }
    // A tail-position nested block is its own lexical scope too (mirrors `collectLocals`).
    scopePush()
    // Post-guard complement narrowing (see `emitFuncBody`/`pushPostGuardNarrow`) —
    // pushed in the loop, active for the TAIL statement, restored on exit.
    const savedGuardTop = narrowTop
    let i = 0
    let cut = false
    while i < n - 1 {
      if emitStmt(body, stmts[i], fnIx) < 0 {
        scopePop()
        return -1
      }
      if monoStaticGuardEndsBlock(stmts[i], fnIx) {
        fbUnreachable() // 0x00 — see `monoStaticGuardEndsBlock`
        cut = true
        i = n - 1
      } else {
        pushPostGuardNarrow(stmts[i], fnIx)
        i = i + 1
      }
    }
    let rc = 0
    if !cut { rc = emitStmtTail(body, stmts[n - 1], fnIx) }
    restoreNarrow(savedGuardTop)
    scopePop()
    return rc
  }
  emitFail("emitProgram: function has no block body")
}

// Lower the single statement at `stmtIx` in TAIL position. A bare tail value becomes
// `emitExpr` + `return`; a nested `if`/`else` recurses tail-aware into its arms; any
// other statement (an explicit `return`, a `while`, etc.) is lowered unchanged by
// `emitStmt` (it already exits or falls through on its own). Returns 0, or -1.
function emitStmtTail(body: i32[], stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  if s is IfStmt { return emitIfTail(body, stmtIx, fnIx) }
  if stmtIsTailValue(stmtIx, fnIx) {
    // An if-tail arm's implicit return — seed the return context (so a `null` arm
    // boxes / sentinels per the function's return type) exactly like `emitFuncBody`.
    return emitReturnExit(body, stmtIx, fnIx)
  }
  emitStmt(body, stmtIx, fnIx)
}

// Lower an `if`/`else` at `stmtIx` whose VALUE is the function's return value (tail
// position): each arm is lowered with its last statement tail-aware (`emitStmtsTail`),
// so an arm ending in a bare value expression returns it. Mirrors `emitStmt`'s void-if
// shape (same `if 0x04`/`else 0x05`/`end 0x0b`, same union narrowing) but routes the
// arm bodies through the tail path. Returns 0, or -1.
function emitIfTail(body: i32[], stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  if s is IfStmt {
    if emitExpr(body, s.ifCond, fnIx) < 0 { return -1 }
    fbIf(64) // 0x04 if, 0x40 void blocktype
    // The arms hold RETURNS, and a union-box return SINKS to a `br` whose operand is the
    // frame distance to the function's exit block — so this frame has to be counted. The
    // `else` reuses it (one frame per `if`/`else` pair), matching `emitIfStmtStmt`.
    ctrlEnter()
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    if emitStmtsTail(body, s.ifThen, fnIx) < 0 { return -1 }
    if narrowed { restoreNarrow(savedTop) }
    if s.ifElse >= 0 {
      fbElse() // 0x05 else
      // A VALUE union narrows to the COMPLEMENT set in the else-arm (see emitStmt).
      const savedElseTop = narrowTop
      const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
      const els = P.nodes[s.ifElse]
      if els is Block {
        if emitStmtsTail(body, s.ifElse, fnIx) < 0 { return -1 }
      } else {
        // `else if`: a lone nested IfStmt, still in tail position.
        if emitStmtTail(body, s.ifElse, fnIx) < 0 { return -1 }
      }
      if narrowedElse { restoreNarrow(savedElseTop) }
    }
    fbEnd() // 0x0b end
    ctrlLeave()
    return 0
  }
  emitFail("emitProgram: emitIfTail: not an if statement")
}

// The wasm GLOBAL INDEX of the user global at `globalStmts` position `gi`: the
// string-literal pool occupies indices 0..pool-1, so user cells follow it. The
// declaration position is NOT the cell index — a binding PROMOTED to a start-function
// local (G2c) emits no cell at all, so the survivors are re-densified by `gCellIdx`
// and every index below a promoted binding's is unchanged while every index above it
// drops by one. `gCellIdx[gi]` is -1 for a promoted binding and this function must
// never be reached for one; `emitUserGlobalGet`/`emitUserGlobalSet` are the gate that
// guarantees it, and they reject loudly rather than let a -1 through.
export function userGlobalIdx(gi: i32) {
  if gi < 0 || gi >= gCellIdx.length { return gStrPoolTexts.length + gi }
  gStrPoolTexts.length + gCellIdx[gi]
}

// THE STORAGE-CLASS CHOKEPOINT for a user top-level binding. `fbGlobalGet`/`fbGlobalSet`
// are the module's only `0x23`/`0x24` writers, and the string-literal pool is their only
// other caller, so routing every USER cell through this pair makes cell-vs-local ONE
// decision that no emit site can bypass. Read: `local.get` from the start function's
// frame when the binding was promoted (G2c), else `global.get` of its cell.
//
// A promoted binding is addressable ONLY from the start function's own frame. Reached
// from anywhere else — a named function body, a lifted lambda, a closure env build, a
// const cell's constexpr initializer — the promotion predicate was wrong about it, and
// this reject is what says so, instead of emitting a `local.get` into a frame that has
// no such slot or a `global.get` of a cell that no longer exists. Every hole in
// `promoMark`'s shape ladder lands HERE, as a build-time diagnostic.
export function emitUserGlobalGet(gi: i32) {
  if gi >= 0 && gi < gPromoOk.length && gPromoOk[gi] == 1 {
    if !gPromoInStart || gPromoSlot[gi] < 0 {
      return emitFail(
        "emitProgram: promoted top-level binding read outside the top-level statement list",
      )
    }
    fbLocalGet(gPromoSlot[gi])
    return 0
  }
  fbGlobalGet(userGlobalIdx(gi))
  0
}

// The write half of the chokepoint above — `local.set` into the start function's frame
// for a promoted binding, else `global.set` of its cell.
export function emitUserGlobalSet(gi: i32) {
  if gi >= 0 && gi < gPromoOk.length && gPromoOk[gi] == 1 {
    if !gPromoInStart || gPromoSlot[gi] < 0 {
      return emitFail(
        "emitProgram: promoted top-level binding written outside the top-level statement list",
      )
    }
    fbLocalSet(gPromoSlot[gi])
    return 0
  }
  fbGlobalSet(userGlobalIdx(gi))
  0
}

// ── explicit expected-type context (N20) ──────────────────────────────────────
// The `pending*` globals above (and in `emit_state.vl`) are implicit parameters: a site
// seeds what the immediately-following `emitExpr` should build, and a hand-rolled
// save/…/restore at every site is the only thing keeping a seed from leaking into a DISTANT
// emit (a missed restore is a silent miscompile). `ExpCtx` makes that context an explicit
// VALUE: a site snapshots the ambient seeds (`expCtxHere`), overrides the fields it knows,
// and hands the context to `emitExprExpect`, which applies it around the ONE emit and always
// restores — so a missed restore cannot happen. The globals remain the transport the deep
// consumers (the literal / null / ident lowerings) read; migrating those consumers to take
// the context as a parameter is the remainder of N20.
type ExpCtx = {
  listKind: i32,        // pendingListKind — what an empty `[]` builds
  listSlot: i32,        // pendingListSlot — WHICH ref-list element type
  structIdx: i32,       // pendingStructIdx — the struct an ObjLit must build
  variantIdx: i32,      // pendingVariantIdx — bare variant an ObjLit must build
  mapSlot: i32,         // pendingMapSlot — the map shape a `Map()` builds
  wantI64: boolean,     // pendingI64 — a NumLit lowers as i64.const
  wantF32: boolean,     // pendingF32 — a NumLit lowers as f32.const
  wantF64: boolean,     // pendingF64 — an integer NumLit lowers as f64.const
  nulBool: boolean,     // pendingNulBool — a bare `null` is the sentinel 2
  nulLitUnion: boolean, // pendingNulLitUnion — a bare `null` is the sentinel -1
  nulString: boolean,   // pendingNulString — a bare `null` is `ref.null $aTypeIdx`
  nulClosure: boolean,  // pendingNulClosure — a bare `null` is `ref.null $cloStruct`
  nulList: boolean,     // pendingNulList — a bare `null` is `ref.null $lTypeIdx`
  nulRefHeap: i32,      // pendingNulRefHeap — heap index a bare `null` refs, -1 none
  rawNullRead: boolean, // pendingRawNullRead — a nullable read stays the RAW ref
  litUnion: i32,        // pendingLitUnion — a member StrLit lowers as its atom id
}

// The current pending seeds as an explicit context — the BASE every site starts
// from (exact ambient semantics), overriding only the fields it knows.
function expCtxHere(): ExpCtx {
  const c: ExpCtx = {
    listKind: pendingListKind,
    listSlot: pendingListSlot,
    structIdx: pendingStructIdx,
    variantIdx: pendingVariantIdx,
    mapSlot: pendingMapSlot,
    wantI64: pendingI64,
    wantF32: pendingF32,
    wantF64: pendingF64,
    nulBool: pendingNulBool,
    nulLitUnion: pendingNulLitUnion,
    nulString: pendingNulString,
    nulClosure: pendingNulClosure,
    nulList: pendingNulList,
    nulRefHeap: pendingNulRefHeap,
    rawNullRead: pendingRawNullRead,
    litUnion: pendingLitUnion,
  }
  return c
}

// Write a context into the pending seeds (the transport the consumers read).
function expCtxApply(c: ExpCtx) {
  pendingListKind = c.listKind
  pendingListSlot = c.listSlot
  pendingStructIdx = c.structIdx
  pendingVariantIdx = c.variantIdx
  pendingMapSlot = c.mapSlot
  pendingI64 = c.wantI64
  pendingF32 = c.wantF32
  pendingF64 = c.wantF64
  pendingNulBool = c.nulBool
  pendingNulLitUnion = c.nulLitUnion
  pendingNulString = c.nulString
  pendingNulClosure = c.nulClosure
  pendingNulList = c.nulList
  pendingNulRefHeap = c.nulRefHeap
  pendingRawNullRead = c.rawNullRead
  pendingLitUnion = c.litUnion
  0
}

// Emit `exprIx` under the explicit expected-type context `ctx`: the ambient
// seeds are saved, `ctx` applied, the expression emitted, and EVERY seed
// restored — scoping the whole context to this one emit.
function emitExprExpect(body: i32[], exprIx: i32, fnIx: i32, ctx: ExpCtx) {
  const saved = expCtxHere()
  expCtxApply(ctx)
  const r = emitExpr(body, exprIx, fnIx)
  expCtxApply(saved)
  r
}

// Emit `print(<string expr>)`: stream each code point through `__print_char__`, then one
// `__print_str_flush__`. Factored from the print handler so the literal-union widening can reuse it.
function emitPrintStrExpr(body: i32[], strExpr: i32, fnIx: i32) {
  if emitExpr(body, strExpr, fnIx) < 0 { return -1 }
  fbLocalSet(strScratchBase + 0)
  emitPrintStrFromScratch(body)
}

// The literal text `null`, streamed through the SAME `__print_char__` (import 2) /
// `__print_str_flush__` (import 3) pair `print(<string>)` uses — and through no scratch
// frame at all: a CONSTANT text needs neither a string-ref slot nor loop counters, so
// this arm is available in a function that reserved nothing. The null branch of the two
// nullable-NICHE prints below.
function emitPrintNullWord() {
  fbI32Const(110) // 'n'
  fbCall(2)       // __print_char__
  fbI32Const(117) // 'u'
  fbCall(2)
  fbI32Const(108) // 'l'
  fbCall(2)
  fbI32Const(108) // 'l'
  fbCall(2)
  fbCall(3)       // __print_str_flush__
  0
}

// `print(<string | null>)`. The NICHE rep is a `(ref null $aTypeIdx)`, and the plain string
// arm below streams it unconditionally — `array.len` on a null ref, a runtime
// `wasm trap: null reference` with `vl check` clean, for every program whose value actually
// WAS null. (`types/print-scalar-boundary-controls.vl` filed it as "a MISSING ARM, not a
// gate question" and pinned the value-holding cell around it.)
//
// Structure — one `br_on_null` (0xd5, the same function-references proposal this emitter
// already uses for `ref.as_non_null` / `call_ref`), which is what makes ONE evaluation of
// the argument enough. There is no nullable string LOCAL to stash it in (`strScrA` is
// declared non-null `(ref $aTypeIdx)`), and re-evaluating would call a
// `string | null`-returning function twice:
//
//   block $out
//     block $null
//       <arg>            ;; (ref null $a)
//       br_on_null $null ;; pops it; on non-null leaves (ref $a)
//       local.set strScrA
//       <stream>
//       br $out
//     end
//     <print "null">
//   end
function emitPrintNulString(body: i32[], argIx: i32, fnIx: i32) {
  fbBlock(64) // $out
  ctrlEnter()
  fbBlock(64) // $null
  ctrlEnter()
  // The RAW nullable ref. Without `rawNullRead` a kind-16 read recovers itself with
  // `ref.as_non_null` (0xd4) — which TRAPS on the very value this arm exists to handle,
  // before `br_on_null` can see it. Same context flag the `??` arms over a nullable
  // string set for their own `ref.is_null`.
  const rawCtx = expCtxHere()
  rawCtx.rawNullRead = true
  if emitExprExpect(body, argIx, fnIx, rawCtx) < 0 { return -1 }
  wU8(213) // 0xd5 br_on_null
  wULEB(0) // → $null (the enclosing block)
  fbLocalSet(strScratchBase + 0)
  if emitPrintStrFromScratch(body) < 0 { return -1 }
  fbBr(1) // → $out
  fbEnd()
  ctrlLeave()
  emitPrintNullWord()
  fbEnd()
  ctrlLeave()
  0
}

// `print(<boolean | null>)`. The NICHE rep is an i32 whose null value is the SENTINEL 2
// (`boolean` being 0/1), and the fallback ladder below routes it to `__print_bool__` —
// which renders any non-zero as `true`. So a `boolean | null` holding NULL printed
// **true**, silently, with `vl check` clean. That is the worse half of the same missing
// arm: the string niche at least trapped.
//
// Structure — a `br_table` on the niche value itself, which is already exactly the arm
// index (0 = false, 1 = true, 2 = null). Like the string arm this evaluates the argument
// ONCE and needs no local: `br_table` consumes the value AS the selector and each arm knows
// its own constant. No scratch frame is reserved for a bare boolean print; this needs none.
//
//   block $out          block $null          block $true          block $false
//     <arg> ; br_table 0 1 2 (default 2)
//   end $false → i32.const 0 ; __print_bool__ ; br $out
//   end $true  → i32.const 1 ; __print_bool__ ; br $out
//   end $null  → <print "null">
function emitPrintNulBool(body: i32[], argIx: i32, fnIx: i32) {
  fbBlock(64) // $out
  ctrlEnter()
  fbBlock(64) // $null
  ctrlEnter()
  fbBlock(64) // $true
  ctrlEnter()
  fbBlock(64) // $false
  ctrlEnter()
  if emitExpr(body, argIx, fnIx) < 0 { return -1 }
  wU8(14)     // 0x0e br_table
  wULEB(3)    // three indexed targets, then the default
  wULEB(0)    // 0 → $false (depth 0 from here)
  wULEB(1)    // 1 → $true
  wULEB(2)    // 2 → $null
  wULEB(2)    // default → $null (unreachable: the niche is 0/1/2)
  fbEnd()
  ctrlLeave()
  fbI32Const(0)
  fbCall(1)   // __print_bool__ → "false"
  fbBr(2)     // → $out
  fbEnd()
  ctrlLeave()
  fbI32Const(1)
  fbCall(1)   // __print_bool__ → "true"
  fbBr(1)     // → $out
  fbEnd()
  ctrlLeave()
  emitPrintNullWord()
  fbEnd()
  ctrlLeave()
  0
}

// `print(<literal-union atom>)` — widen the atom to its member STRING through the SAME tower
// every other atom consumer uses (`emitAtomToStrChain`), then stream it.
//
// ONE EVALUATION, AND THAT IS WHY THE TOWER IS SHARED RATHER THAN RE-SPELLED HERE. A per-member
// `if id == <that member's id> { print "<member>" }` chain has to re-read the receiver once per
// member; for a re-readable PLACE that is free, but for a CALL each re-read is another call, so
// `print(f())` ran `f` once per member — twice for a 2-member alias, three times for a
// 3-member one, and members+1 through the niche below, with `vl check` clean and the module
// valid. Every other consumer of an atom (`+` concat, a `string` argument position, a `string`
// return) already reached `emitAtomToStr` and was correct; the print chain was the second copy
// of the tower, and the copy is what got the count wrong.
//
// The str-op scratch frame this rides is already reserved for exactly this shape — the
// reservation scan's `print` arm asks `exprIsLitAtom`, the same question the print handler's
// first arm asks — so sharing the tower needs no new reservation work.
function emitPrintAtomStr(body: i32[], argIx: i32, texts: string[], fnIx: i32) {
  if emitStashAtomId(body, argIx, fnIx) < 0 { return -1 }
  emitPrintAtomFromStash(body, texts)
}

// The stashed-id half of the atom print: the shared widen tower over str-op scratch i32 slot 0,
// then the streaming print of the string it yields. Split out so the `K | null` niche below
// reaches it from INSIDE its sentinel guard without re-evaluating the receiver.
function emitPrintAtomFromStash(body: i32[], texts: string[]) {
  if emitAtomToStrChain(body, texts, 0) < 0 { return -1 }
  fbLocalSet(strScratchBase + 0)
  emitPrintStrFromScratch(body)
}

// `print(<K | null>)` — the atom NICHE: an i32 member id with `-1` for null, the same sentinel
// `emitNulIsNullTest`'s litunion arm compares against. The sentinel arm prints the word `null`
// and the member arm widens through the shared tower, so the niche renders like the two nullable
// scalars beside it (`emitPrintNulString`, `emitPrintNulBool`) — `p` / `null` / `q` for
// `["p", null, "q"]`.
//
// A `null` element is ORDINARY, so this must not be a reject: the members and the sentinel
// partition the i32, and the value carries its own discriminator.
//
// BOTH ARMS READ THE STASH, NOT THE RECEIVER — one evaluation covers the sentinel test and the
// widen, where a re-read spelling cost this niche members+1 evaluations of a call receiver. The
// sentinel test is emitted FIRST because the member arm's streaming loop reuses slot 0 as its
// cursor, so the sentinel has to have been decided by then; two `if`s rather than an `if/else`
// because a second read of the stash is free.
function emitPrintNulLitUnion(
  body: i32[],
  argIx: i32,
  texts: string[],
  fnIx: i32,
) {
  if emitStashAtomId(body, argIx, fnIx) < 0 { return -1 }
  pushStrScrI(body, 0)
  fbI32Const(-1)
  fbI32Bin(70) // 0x46 i32.eq
  fbIf(64)     // if (void)
  ctrlEnter()
  emitPrintNullWord()
  fbEnd()
  ctrlLeave()
  pushStrScrI(body, 0)
  fbI32Const(-1)
  fbI32Bin(71) // 0x47 i32.ne
  fbIf(64)     // if (void)
  ctrlEnter()
  if emitPrintAtomFromStash(body, texts) < 0 { return -1 }
  fbEnd()
  ctrlLeave()
  0
}

// The streaming loop over the string already stashed in `strScrA` — `emitPrintStrExpr`'s
// tail, split out so the nullable arm above can reach it with the ref it recovered from
// `br_on_null` instead of re-evaluating the expression.
function emitPrintStrFromScratch(body: i32[]) {
  fbI32Const(0)
  setStrScrI(body, 0)
  pushStrScrRef(body, 0)
  fbArrayLen()
  setStrScrI(body, 1)
  fbBlock(64)
  ctrlEnter()
  fbLoop(64)
  ctrlEnter()
  pushStrScrI(body, 0)
  pushStrScrI(body, 1)
  fbI32Bin(78) // i32.ge_s
  fbBrIf(1)
  pushStrScrRef(body, 0)
  pushStrScrI(body, 0)
  fbArrayGet(aTypeIdx)
  fbCall(2) // __print_char__
  pushStrScrI(body, 0)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  setStrScrI(body, 0)
  fbBr(0)
  fbEnd()
  ctrlLeave()
  fbEnd()
  ctrlLeave()
  fbCall(3) // __print_str_flush__
  0
}

// Widen a literal-union ATOM (an i32 id) to a STRING VALUE — a `select` tower mapping each
// member's id to its string constant. Membership is checker-guaranteed, so the LAST member is
// the unconditional default arm. The id is evaluated once into the string-op scratch i32 slot 0
// (`setStrScrI`) and re-read per member; each arm builds a tiny constant string, leaving a
// NON-NULL string ref (the `string` rep, kind 3). The string-subtype analogue of the numeric
// i32->f64 widening — its callers (`emitStrConcat`, the `string` arg / return boundaries)
// reserve the str-op frame via `callWidensAtomToStr` / `retWidensAtomToStr` / `exprIsStrConcat`.
export function emitAtomToStr(body: i32[], atomIx: i32, fnIx: i32) {
  const texts = nodeLitUnionMemberTexts(atomIx)
  if texts.length == 0 {
    return emitFail(
      "emitProgram: literal-union string widening with no members",
    )
  }
  if !aUsed {
    return emitFail(
      "emitProgram: literal-union string widening but array type not collected",
    )
  }
  // THE DESIGN'S "CHEAPER 2-MEMBER VARIANT" WAS BUILT AND MEASURED, AND IS NOT SHIPPED
  // (§8.1: "for a 2-MEMBER litunion the tower is one `select_t` and the id is consumed exactly
  // once, so no stash — and no frame — is needed. If most real litunions are small, the
  // reservation problem shrinks to the 3+-member case."). The MECHANISM is confirmed: with a
  // stash-free two-member tower and ZERO reservation work, every 2-member cell of the isolated
  // grid runs (175/184, the same score the shipped fix gets) and only 3-and-4-member sets are
  // invalid wasm (139 cells each). The SCOPE REDUCTION is refuted:
  //   · 23 of the 64 corpus litunion aliases that sit beside a NON-null arm — the population
  //     that reaches this boundary at all — have 3+ members (36%), so the reservation work is
  //     still needed in full; the variant partitions the problem, it does not shrink it.
  //   · It is therefore ADDITIVE, not cheaper: it can only be built on top of the scan work.
  //   · Measured, it buys -44 bytes over 4 of 167 litunion corpus files while costing +263
  //     bytes of compiler.
  //   · And it would make the SCAN have to agree with this handler on MEMBER COUNT — a second
  //     axis for the scan-vs-handler mismatch that is this repo's richest invalid-wasm vein,
  //     added to the target-shape axis the scan already has to get right.
  if emitStashAtomId(body, atomIx, fnIx) < 0 { return -1 }
  const r = emitAtomToStrChain(body, texts, 0)
  r
}

// Evaluate an atom-repped literal-union value ONCE and stash its interned i32 id in the
// string-op scratch i32 slot 0 — the slot every widen tower (`emitAtomToStrChain`) re-reads
// once per member.
//
// THE STASH IS THE WHOLE REASON THE EVALUATION COUNT IS RIGHT, so it is the one home for
// "read the atom". A tower that re-read the RECEIVER per member instead would be correct only
// for a re-readable PLACE and would re-run a CALL receiver once per member — a silent wrong
// number of evaluations, not a wrong value. `pendingLitUnion` is raised for the read because
// the id, not the member string, is what the tower compares.
function emitStashAtomId(body: i32[], atomIx: i32, fnIx: i32) {
  const savedLU = pendingLitUnion
  pendingLitUnion = 1
  if emitExpr(body, atomIx, fnIx) < 0 { return -1 }
  pendingLitUnion = savedLU
  setStrScrI(body, 0)
  0
}

// The `select` tower for `emitAtomToStr`: member `i`'s string if its interned id matches the
// stashed atom, else the chain for `i+1`. The last member is the unconditional default arm
// (membership is total, so no compare is needed there).
function emitAtomToStrChain(body: i32[], texts: string[], i: i32) {
  if i >= texts.length - 1 {
    const rd = emitStr(body, mkStr(quoteLex(texts[i]), -1), -1)
    return rd
  }
  // val1 = this member's string constant
  if emitStr(body, mkStr(quoteLex(texts[i]), -1), -1) < 0 { return -1 }
  // val2 = the remaining chain
  if emitAtomToStrChain(body, texts, i + 1) < 0 { return -1 }
  // cond = (stashed id == this member's id)
  pushStrScrI(body, 0)
  fbI32Const(internAtom(quoteLex(texts[i])))
  fbI32Bin(70) // i32.eq
  // select_t typed for a non-null string ref (0x64 $aTypeIdx): val1 if cond else val2
  wU8(28)  // 0x1c select_t
  wU8(1)   // one result valtype
  wU8(100) // 0x64 (ref ht) — non-null
  wSLEB(aTypeIdx)
  0
}

// Emit `ix` as a STRING VALUE: a literal-union atom widens to its member string; anything
// else lowers normally (it is already a string). Used at every `string`-typed boundary that
// can receive an atom — concat operands, a `string` arg position, a `string` return.
function emitStrValue(body: i32[], ix: i32, fnIx: i32) {
  if exprIsLitAtom(ix, fnIx) {
    const rw = emitAtomToStr(body, ix, fnIx)
    return rw
  }
  const re = emitExpr(body, ix, fnIx)
  re
}

// Narrow a STRING-repped literal-union value to its interned i32 ATOM id — `emitAtomToStr`'s
// inverse, and the arm that was missing at every atom-typed slot.
//
// A litunion has two reps and `nodeTyIsLitUnionAlias` decides which: a registered alias NAME
// is an interned atom, while an un-named one — the FLATTENED `A | B`, and the inline spelling
// — stays a `(ref $array)` string at `RC_ROOT` / `RC_FN_PARAM` (`ctxKeepsLitUnion`). Narrowing
// crosses between them: `if u is A { const r: A = u }` rebinds a string-repped `u` to `A`,
// whose slot is an ATOM. Without a conversion the store is `local.set` of a `(ref $array)`
// into an `i32` local — invalid wasm, `vl check --codegen` clean, at every atom-typed
// destination (an annotated local, a `K` parameter, a `K` field, a `K[]` element, a `K`
// return).
//
// The tower is `emitAtomToStr`'s, mirrored: member `i`'s id if the value equals member `i`'s
// string, else the chain for `i+1`, with the LAST member the unconditional default (membership
// is checker-guaranteed). It uses NO scratch frame, and that is deliberate rather than
// incidental — `emitAtomToStr` stashes its id in the str-op frame and therefore has to be
// agreed with by a reservation SCAN, which is this emitter's richest invalid-wasm vein. Here
// the value is RE-READ per member instead, which costs the receiver bound
// (`unionEqOperandOk`) and buys the whole scan out of the change.
function emitStrToAtom(body: i32[], ix: i32, fnIx: i32) {
  const texts = nodeLitUnionMemberTexts(ix)
  if texts.length == 0 {
    return emitFail("emitProgram: literal-union atom narrowing with no members")
  }
  if !aUsed {
    return emitFail(
      "emitProgram: literal-union atom narrowing but array type not collected",
    )
  }
  if !unionEqOperandOk(ix) {
    return emitFail(
      "emitProgram: literal-union atom narrowing needs a re-readable receiver",
    )
  }
  // The inner emits run OUTSIDE the atom context: the value re-reads must lower as the
  // string they are (re-entering this arm would not terminate), and the per-member literal
  // must lower as a string CONSTANT, not as its own interned id.
  const savedLU = pendingLitUnion
  pendingLitUnion = 0
  const r = emitStrToAtomChain(body, ix, texts, 0, fnIx)
  pendingLitUnion = savedLU
  r
}

// The `select` tower for `emitStrToAtom`: member `i`'s interned id if the value string-equals
// member `i`, else the chain for `i+1`. The last member is the unconditional default arm.
function emitStrToAtomChain(
  body: i32[],
  ix: i32,
  texts: string[],
  i: i32,
  fnIx: i32,
) {
  if i >= texts.length - 1 {
    fbI32Const(internAtom(quoteLex(texts[i])))
    return 0
  }
  // val1 = this member's interned id
  fbI32Const(internAtom(quoteLex(texts[i])))
  // val2 = the remaining chain
  if emitStrToAtomChain(body, ix, texts, i + 1, fnIx) < 0 { return -1 }
  // cond = (the value string-equals this member)
  if emitExpr(body, ix, fnIx) < 0 { return -1 }
  if emitExpr(body, mkStr(quoteLex(texts[i]), -1), fnIx) < 0 { return -1 }
  if emitStrEqCore(body) < 0 { return -1 }
  fbSelect() // 0x1b select — val1 if cond else val2 (both i32)
  0
}

// True when `ix` is a literal-union value whose REP is its member STRING rather than the
// interned i32 atom — the un-named FLATTENED (`A | B`) and inline spellings, which
// `ctxKeepsLitUnion` leaves as a `(ref $array)` at `RC_ROOT` / `RC_FN_PARAM`. The two
// declines are the two things that are already atoms in atom context: an atom-repped
// expression (`exprIsLitAtom`, the classifier the valtype ladders agree with), and a member
// STRING LITERAL, whose id `emitExpr`'s `StrLit` arm folds at compile time.
function strReppedLitUnionAt(ix: i32, fnIx: i32) {
  if exprIsLitAtom(ix, fnIx) { return false }
  const av = unwrapParen(ix)
  const e = P.nodes[av]
  if e is StrLit { return false }
  nodeTyIsLitUnion(av)
}

// True when `ix` can be lowered in ATOM context — as the interned i32 id the litunion atom
// `==` needs on BOTH of its sides. The three atom-lowerable shapes are exactly the three
// `emitExprExpect`'s `litUnion` context has an answer for: an atom-repped expression
// (`exprIsLitAtom`), a member string LITERAL (whose id the `StrLit` arm folds at compile
// time), and a string-repped litunion (`strReppedLitUnionAt` → `emitStrToAtom`).
//
// A PLAIN `string` IS NOT ONE OF THEM, AND THE MISSING DIRECTION IS UNSOUND RATHER THAN
// UNIMPLEMENTED. `emitStrToAtom`'s tower makes the LAST member the unconditional default
// because membership is checker-guaranteed for a litunion value — which is precisely what a
// plain `string` does not carry. Narrowing `u: string` holding `"z"` would hand back the last
// member's id and answer `u == kk` TRUE against that member: a silent wrong answer traded for
// invalid wasm. So the mixed pair is refused here and lowered the other way round, by widening
// the ATOM to its member string (`emitStrValue`), which is total in the direction it runs.
// A union BOX is refused on the `exprUnion` line, and that line is the emitter's REP
// classifier standing in front of a banked-TYPE test on purpose. The checker banks a PURE
// litunion type at a `K | i32` operand of this very compare, so `nodeTyIsLitUnion` below
// answers TRUE for a value whose STORAGE is a `{tag, anyref}` box — `i32.eq` over a box ref,
// `vl check` rc 0. The box's own lowering is the tag-gated payload compare
// (`emitUnionConcreteEq`), which the arm above this one claims through the same predicate.
// The order matters: an atom-repped or member-literal operand is claimed BEFORE the box test,
// because `unionNameOfIdent` claims a `K`-annotated binding too (`K` is a registered union
// NAME while the value is a bare id).
function eqAtomOperandOk(ix: i32, fnIx: i32) {
  if exprIsLitAtom(ix, fnIx) { return true }
  const av = unwrapParen(ix)
  const e = P.nodes[av]
  if e is StrLit { return true }
  if exprUnion(ix, fnIx) { return false }
  nodeTyIsLitUnion(av)
}

function emitNumLitNode(_body: i32[], e: NumLit, exprIx: i32, fnIx: i32) {
  // A FLOAT literal (lexeme carries a `.`) in f32 CONTEXT (`pendingF32` — an `: f32`
  // binding/param/return) lowers as `f32.const`. Checked before the default f64 path
  // so a float literal re-encodes at single precision in an f32 slot (never demoted
  // from f64). Outside f32 context a `.` literal stays f64, byte-identical. (Slice 5.)
  if numTextIsFloat(e.numText) {
    if pendingF32 {
      fbF32Const(e.numText)
      return 0
    }
    fbF64Const(e.numText)
    return 0
  }
  // An integer literal in f32 CONTEXT lowers DIRECTLY as `f32.const` (re-encoded at
  // single precision — `f32Bytes` parses an integer lexeme as `mant/10^0`), so it is a
  // valid constexpr in a const-global init (a convert op is not). (Slice 5.)
  if pendingF32 {
    fbF32Const(e.numText)
    return 0
  }
  // An integer literal in f64 CONTEXT (const-global init) lowers directly as
  // `f64.const`, keeping the global init a constexpr (`const b: f64 = 5`). (Slice 5.)
  if pendingF64 {
    fbF64Const(e.numText)
    return 0
  }
  // An integer literal in i64 CONTEXT (`pendingI64`) lowers as `i64.const` over the
  // 64-bit (hi, lo) pair parsed from its lexeme — so a value past the i32 range
  // (`9000000000`, `0xFFFFFFFFFF`) survives. Otherwise the default i32 path is
  // byte-identical to before (bare integer literals stay i32 — Slice 1 invariant).
  if pendingI64 {
    const pr = parseI64Pair(e.numText)
    fbI64Const(pr[0], pr[1])
    return 0
  }
  // An integer literal past the i32 range is TYPED i64 by the checker (the host's
  // `defaultIntegerType` magnitude rule), so it lowers as `i64.const` even with no
  // i64 context — the old default `i32.const` silently wrapped (0xDEAD_BEEF).
  if !numLexFitsI32(e.numText) {
    const pr = parseI64Pair(e.numText)
    fbI64Const(pr[0], pr[1])
    return 0
  }
  // A SMALL int literal whose context ADOPTED a wider slot — the checker recorded
  // i64/f64 on the node (`objRetWidenAdopt`, a lambda returning `{f: 5}` against
  // `() => {f: i64}`): honor the recorded rep, so the typed-IR fast paths
  // (`exprIsI64`/`exprIsF64` — which already claim the node, short-circuiting the
  // `emitExprAs*` converts) and the emitted value agree. The checker records a wider
  // numeric on a literal only when it proved it re-encodable, so an ordinary bare
  // integer literal stays the byte-identical i32 path.
  if exprIsI64(exprIx, fnIx) {
    const wpr = parseI64Pair(e.numText)
    fbI64Const(wpr[0], wpr[1])
    return 0
  }
  if exprIsF64(exprIx, fnIx) {
    fbF64Const(e.numText)
    return 0
  }
  fbI32Const(parseI32(e.numText))
  return 0
}

function emitCharLitNode(_body: i32[], e: CharLit, _exprIx: i32, _fnIx: i32) {
  // A char literal IS its single Unicode code point as an i32. `charText` is the RAW
  // lexeme (quotes kept, escapes unresolved), so decode it the SAME way string
  // literals decode (`decodeStr` strips the quotes + resolves escapes); a well-formed
  // char yields exactly one code point.
  const cps = decodeStr(strToCps(e.charText))
  if cps.length != 1 {
    return emitFail(
      "emitProgram: char literal must denote exactly one code point",
    )
  }
  fbI32Const(cps[0])
  return 0
}

// THE DENSEST SINGLE-IDENTIFIER SITE IN THE COMPILER, and the one that made the
// arena-node carrier the design's load-bearing ruling: one identifier read resolves
// through SEVEN name-keyed lookups here (`unionNameOfIdent` ×3, `fnIndexOfInScope`,
// `globalIndexOf`, `globalLetOf`, `globalNameIsNonConst`), each of which was a
// `__str_hash__` plus a probe over the same string. The arena index was already
// threaded in and UNUSED (`_exprIx`) — so the id is one array read and the other
// six lookups become array reads too.
function emitIdentNode(body: i32[], e: Ident, exprIx: i32, fnIx: i32) {
  const isid = sidOfNode(exprIx)
  // THE NARROWED-ARM UNBOXES COME FIRST, and a CAPTURE is read through them like any other
  // storage class. Each of the three arms below sources its box through
  // `emitUnionBoxPush`, whose own capture leg reads the env field raw — so a capture that
  // is narrowed at the closure's declaration site (replayed by `capNarrowSeed`) unboxes
  // exactly as a param/local/global does, and one that is NOT narrowed falls through to
  // the plain env read below. Ordering these after the env read is what made a narrowed
  // captured union push the raw box where the arm's rep was expected: `vl check`-clean
  // invalid wasm, with `emitUnionBoxPush`'s own reject for it unreachable.
  //
  // A VALUE-union binding narrowed to ONE scalar atom reads UNBOXED: push the
  // box, recover the `anyref` payload, cast it, and (for a scalar atom) read
  // the value-box field — `if u is i32 { print(u) }` yields the raw i32.
  const vAtom = narrowedValueAtomOf(e.identName)
  if vAtom != "" {
    // D-UNION-ATOM-KIND: the narrowed atom's ABI code, derived ONCE for both reads
    // below (master derived it inside the callee, i.e. once per read).
    const vak = valueAtomKind(vAtom)
    if unionNameOfIdentSid(isid, fnIx) != "" {
      return emitValueUnionUnboxRead(body, e.identName, vak, fnIx)
    }
    // THE CAPTURE STORAGE CLASS's gate. The name question above resolves a binding in THIS
    // frame; a capture's binding is in another one, so it answers "" while the read is
    // narrowed. `capturedIsUnionBox` asks the rep instead — see its own comment.
    if capturedIsUnionBox(fnIx, e.identName) {
      return emitValueUnionUnboxRead(body, e.identName, vak, fnIx)
    }
    // THE TYPED-IR NET behind the syntactic miss — all three narrowed-arm reads in this
    // function carry it. Some bindings hold the BOX without producing a `unionNameOfIdent`
    // render (a binding off a call whose callee is an INDEX or a narrowed nullable-closure
    // value), so the syntactic gate above misses and the unbox is SKIPPED — pushing the box
    // ref where the arm's rep was expected: INVALID WASM, every time. The checker did type
    // the chain's ORIGIN as the boxed union, so the net asks the typed IR instead.
    // This arm: `const t0 = v[0](1)` over `((…) => {f: {[string]: V}} | boolean)[]` — the
    // box reached a raw narrowed atom (fuzz sweep2 multiobs seed 655720167 case_00209).
    if identChainTyBoxedUnion(e.identName, fnIx, 4) {
      return emitValueUnionUnboxRead(body, e.identName, vak, fnIx)
    }
  }
  // A union binding narrowed to a REF-ELEMENT array arm reads UNBOXED to the reflist WRAPPER
  // (`if x is S[] { x[i] }`): push the box, recover the anyref payload, `ref.cast` to the arm's
  // wrapper — the ref-array analogue of the scalar unbox above, so indexing / `.length` see the list.
  const raNm = narrowedRefArrayOf(e.identName)
  if raNm != "" {
    if unionNameOfIdentSid(isid, fnIx) != "" {
      return emitRefArrayUnionUnboxRead(body, e.identName, fnIx)
    }
    // The capture storage class's gate (see the value-atom arm above).
    if capturedIsUnionBox(fnIx, e.identName) {
      return emitRefArrayUnionUnboxRead(body, e.identName, fnIx)
    }
    // The typed-IR net (see the value-atom arm above). This arm: `const t1 = t0(1,1,1)`
    // off a narrowed nullable-closure param — the box reached the list wrapper
    // (fuzz sweep4 declared leg, seed 462516905 case_00383).
    if identChainTyBoxedUnion(e.identName, fnIx, 4) {
      return emitRefArrayUnionUnboxRead(body, e.identName, fnIx)
    }
  }
  // A union binding narrowed to a MAP arm reads UNBOXED to the map struct ref (`if x is {[string]:
  // V} { x[k] }`): push the box, recover the anyref payload, `ref.cast` to the arm's map struct —
  // the map analogue of the ref-array unbox above, so `emitMapPrep` sees the map ref directly.
  const mNm = narrowedMapOf(e.identName)
  if mNm != "" {
    if unionNameOfIdentSid(isid, fnIx) != "" {
      return emitMapUnionUnboxRead(body, e.identName, fnIx)
    }
    // The capture storage class's gate (see the value-atom arm above).
    if capturedIsUnionBox(fnIx, e.identName) {
      return emitMapUnionUnboxRead(body, e.identName, fnIx)
    }
    // The typed-IR net (see the value-atom arm above), over the MAP-arm chain. This arm:
    // the rebind `const t1 = t0(); const t2 = t1` off a narrowed nullable-closure VALUE
    // call — the box reached the map-struct frame (fuzz-nightly plain leg, seed
    // 258048495 d6, `(() => {[string]: boolean} | {w: i32} | null) | null`).
    if identChainTyMapArmUnion(e.identName, fnIx, 4) {
      return emitMapUnionUnboxRead(body, e.identName, fnIx)
    }
  }
  // A CAPTURED variable (a free var of a capturing lifted function): read it from the
  // env struct threaded as the leading param (local 0) —
  // `struct.get $env <fieldIdx> (ref.cast (local.get 0) (ref $env))`. Checked before the
  // param/local/global paths so a capture shadows nothing (it is neither a param/local of
  // this function nor a global). Only fires inside a capturing lifted function.
  if emitCapturedRead(body, e.identName, fnIx, true) == 1 { return 0 }
  // A name resolves to a param (locals 0..p-1) or a declared local (locals p..).
  const idx = localIndexOf(fnIx, e.identName)
  if idx < 0 {
    // A bare top-level/lifted function NAME in value position constructs a function
    // value (closure fat-pointer). `fnIndexOf` IS the `fnStmts` position (the function
    // index), exactly what `emitClosureValue` expects — passed directly (a top-level
    // function never captures, so its env is null; a captured lifted function reads its
    // captures live in the enclosing frame `fnIx`). Scope-aware so a nested function
    // sharing a name with another maker's nested function resolves to THIS frame's.
    const fe = fnIndexOfInScopeSid(isid, e.identName, fnIx)
    if fe >= 0 { return emitClosureValue(body, fe, fnIx) }
    // Not a local — a module global? Read it with `global.get` (0x23 <globalidx>).
    const gIdx = globalIndexOfSid(isid)
    if gIdx >= 0 {
      if emitUserGlobalGet(gIdx) < 0 { return -1 }
      const gck0 = globalCellKind(globalLetOfSid(isid))
      // The `string | null` READ RULE (stated at `emitMem`'s field read) applies here
      // INDEPENDENTLY of const-ness: a kind-16 cell is ALWAYS a nullable ref, because a
      // const can still be initialized to `null`. Without this a top-level `string | null`
      // value read (`x ?? d`, `!= null`) left a `(ref null $array)` where a `(ref $array)`
      // is expected (a function-scope local already recovers via the local path below).
      if gck0 == "nulstr" {
        if !nulStrReadStaysRaw() {
          wU8(212) // 0xd4 ref.as_non_null
        }
        return 0
      }
      // A NON-const ref global rides in a NULLABLE cell (zero-initialized with
      // `ref.null`, set by the start function before any code runs). Recover the
      // non-null value type the rest of codegen expects with `ref.as_non_null`
      // (0xd4); the cell is always initialized first, so the cast never traps. A
      // const global keeps its non-null cell, so no cast (goldens unchanged). A
      // scalar (i32/boolean) global needs no cast either.
      if globalNameIsNonConstSid(isid) {
        // A NULLABLE-struct cell (kind 9) legitimately holds null — its reads
        // stay nullable (the member-access path recovers non-null at use); a
        // nullable-LIST cell (kind 15) and a nullable-CLOSURE cell (kind 19)
        // likewise (the `!= null` check reads raw, the narrowed call recovers
        // non-null at the call site). A SCALAR numeric cell (i32 0 / i64 10 /
        // f64 11 / f32 13 / boolean) is not a ref, so it takes no
        // `ref.as_non_null` either. (Slice 5 adds f32/i64/f64 scalars.)
        if (
          gck0 != "i32" &&
          gck0 != "nulstruct" &&
          gck0 != "i64" &&
          gck0 != "f64" &&
          gck0 != "f32" &&
          gck0 != "nullist" &&
          gck0 != "nulreflist" &&
          gck0 != "nulclosure" &&
          gck0 != "nulmap" &&
          !isNulScalarListKind(gck0)
        ) {
          // A NULLABLE-map cell (kind `nulmap`) legitimately holds null — its reads stay nullable
          // (the `!= null` check reads raw; the narrowed map op recovers non-null at the receiver,
          // `emitMapPrep`). Excluded from the eager recover, like the nulstruct/nullist cells.
          // The kind-18 nullable REF-ARRAY cell (`i32[][] | null`, `S[] | null`) is the ninth
          // and last member of that set, and was the one omission: every other nullable cell
          // kind is listed here, so a null-valued kind-18 global was eagerly recovered and
          // TRAPPED (`wasm trap: null reference`) the moment it was read. It was unreachable
          // only because no path could put a null INTO such a cell — the start-fn seed this
          // PR adds is what makes it reachable, so the two ship together.
          wU8(212) // 0xd4 ref.as_non_null
        }
      }
      return 0
    }
    return emitFail(
      "emitProgram: identifier is not a parameter, local, or global",
    )
  }
  fbLocalGet(idx)
  // The `string | null` (kind 16) READ RULE for a param/local — stated at `emitMem`'s
  // field read. Mirrors the kind-15 list read, which never eagerly recovers.
  if !nulStrReadStaysRaw() {
    if paramNulString(fnIx, e.identName) || declaredNulString(e.identName) {
      fbRefAsNonNull() // 0xd4
    }
  }
  return 0
}

function emitUnaryNode(body: i32[], e: Unary, _exprIx: i32, fnIx: i32) {
  // Logical not `!a`: a boolean rides in an i32 (0/1), so `i32.eqz` (0x45) maps
  // 0→1 and any non-zero→0 — exactly `a == 0`. Push the operand, then eqz.
  if e.unOp == "!" {
    if emitExpr(body, e.unArg, fnIx) < 0 { return -1 }
    fbI32Eqz() // 0x45 i32.eqz
    return 0
  }
  // Postfix `x++` / `x--` in EXPRESSION position yields the OLD value. `unArg` is
  // the increment assignment `x = x ± 1`, which as an expression yields the NEW
  // value (store-then-re-read); undo the step (new ∓ 1) to recover the pre-
  // increment value. (In STATEMENT position `emitStmt` unwraps to the bare
  // assignment, so this adjustment is only paid when the value is actually used.)
  if e.unOp == "p+" || e.unOp == "p-" {
    if emitExpr(body, e.unArg, fnIx) < 0 { return -1 }
    fbI32Const(1)
    if e.unOp == "p+" {
      fbI32Bin(107) // 0x6b i32.sub: (x+1) - 1
    } else {
      fbI32Bin(106) // 0x6a i32.add: (x-1) + 1
    }
    return 0
  }
  // Bitwise NOT `~x` == `x ^ -1` (flip every bit). The all-ones mask is an i64
  // `-1` when the operand is i64, an i32 `-1` otherwise; the XOR opcode follows
  // suit. (Slice 2 — the i64 path; the i32 path is the same shape over i32 ops.)
  if e.unOp == "~" {
    if exprIsI64(e.unArg, fnIx) {
      if emitExpr(body, e.unArg, fnIx) < 0 { return -1 }
      fbI64Const(-1, -1) // i64 -1 (all ones)
      fbI32Bin(133)      // 0x85 i64.xor
      return 0
    }
    if emitExpr(body, e.unArg, fnIx) < 0 { return -1 }
    fbI32Const(-1) // i32 -1 (all ones)
    fbI32Bin(115)  // 0x73 i32.xor
    return 0
  }
  // Integer negation: `-x` == `0 - x`, so push 0, the operand, then sub. For an
  // i64 operand the zero and the subtract are i64 (Slice 2).
  if e.unOp != "-" {
    return emitFail("emitProgram: unsupported unary operator")
  }
  // f32 negation uses the dedicated `f32.neg` (0x8c) — flips the sign bit. Checked
  // before f64 (an f32 expr is never `exprIsF64`, but this keeps the float cases
  // grouped and explicit). (Slice 5.)
  if exprIsF32(e.unArg, fnIx) {
    if emitExpr(body, e.unArg, fnIx) < 0 { return -1 }
    wU8(140) // 0x8c f32.neg
    return 0
  }
  // f64 negation uses the dedicated `f64.neg` (0x9a) — flips the sign bit (Slice 3).
  if exprIsF64(e.unArg, fnIx) {
    if emitExpr(body, e.unArg, fnIx) < 0 { return -1 }
    wU8(154) // 0x9a f64.neg
    return 0
  }
  // A negated magnitude-2^31 INTEGER literal (`-2147483648`) is i32 (the host
  // folds the sign in before defaulting), but the bare operand lexeme is one
  // past I32_MAX, so the `exprIsI64(e.unArg)` branch below would lower it as
  // an i64 negation. Lower it directly as a WRAPPING i32 negation instead:
  // `parseI32` folds 0x80000000 to I32_MIN, and `0 - I32_MIN` wraps back to
  // I32_MIN — the right value. Checked BEFORE the operand i64 classification.
  const negInner = unwrapParen(e.unArg)
  const negNode = P.nodes[negInner]
  if negNode is NumLit {
    if !numTextIsFloat(negNode.numText) {
      if numLexIs2Pow31(negNode.numText) {
        fbI32Const(0)
        fbI32Const(parseI32(negNode.numText))
        fbI32Bin(107) // 0x6b i32.sub
        return 0
      }
    }
  }
  if exprIsI64(e.unArg, fnIx) {
    fbI64Const(0, 0) // i64 0
    if emitExpr(body, e.unArg, fnIx) < 0 { return -1 }
    fbI32Bin(125)    // 0x7d i64.sub
    return 0
  }
  fbI32Const(0)
  if emitExpr(body, e.unArg, fnIx) < 0 { return -1 }
  fbI32Bin(107) // 0x6b i32.sub
  return 0
}

function emitCallNode(body: i32[], e: Call, exprIx: i32, fnIx: i32) {
  // G6: `s.slice(start, end)` over a string receiver is an intrinsic — a new
  // `(array i32)` over the clamped half-open range. Other member-calls in value
  // position are out of scope (the only member-call STATEMENT is `.push`).
  if exprIsStrSlice(exprIx, fnIx) { return emitStrSlice(body, exprIx, fnIx) }
  // An array `xs.slice(start, end?)` over a LIST receiver — a same-element-kind
  // sublist (`emitArrSlice`). Checked before the string slice's siblings so it does
  // not fall into a struct member-call path.
  if callIsArrSlice(exprIx, fnIx) { return emitArrSlice(body, exprIx, fnIx) }
  // `s.indexOf(sub)` / `s.includes(sub)` / `s.charCodeAt(i)` over a string
  // receiver are intrinsics too (A7), each yielding an i32.
  if exprIsStrIndexOf(exprIx, fnIx) {
    return emitStrIndexOf(body, exprIx, fnIx)
  }
  if exprIsStrCharCode(exprIx, fnIx) {
    return emitStrCharCode(body, exprIx, fnIx)
  }
  // G8: the `Map()` builtin constructs an empty string-keyed map. `Set()` is a
  // boolean-valued string map over the SAME 7-field struct, so it emits the
  // IDENTICAL empty-map construction.
  const callee = P.nodes[e.callFn]
  if callee is Ident {
    if callee.identName == "Map" || callee.identName == "Set" {
      return emitMapNew(body)
    }
  }
  // G8: a map `m.has(k)` member-call yields a 0/1 i32 (linear scan).
  if callee is Member {
    if callee.memProp == "has" {
      if exprMap(callee.memObj, fnIx) {
        if e.callArgs.length != 1 {
          return emitFail("emitProgram: .has takes exactly one argument")
        }
        return emitMapHas(body, callee.memObj, e.callArgs[0], fnIx)
      }
    }
    // G8: a map `m.delete(k)` member-call in VALUE position yields a 0/1 boolean
    // (whether a key was removed). The same lowering serves the bare-statement form.
    if callee.memProp == "delete" {
      if exprMap(callee.memObj, fnIx) {
        if e.callArgs.length != 1 {
          return emitFail("emitProgram: .delete takes exactly one argument")
        }
        return emitMapDelete(body, callee.memObj, e.callArgs[0], fnIx)
      }
    }
    // `m.keys()` over a map yields a fresh string list of its LIVE keys.
    if callee.memProp == "keys" {
      if exprMap(callee.memObj, fnIx) {
        if e.callArgs.length != 0 {
          return emitFail("emitProgram: .keys() takes no arguments")
        }
        return emitMapKeys(body, callee.memObj, fnIx)
      }
    }
    // `m.values()` over a mono i32 map yields a fresh i32 list of its LIVE values.
    if callee.memProp == "values" {
      if exprMap(callee.memObj, fnIx) {
        if e.callArgs.length != 0 {
          return emitFail("emitProgram: .values() takes no arguments")
        }
        return emitMapValues(body, callee.memObj, fnIx)
      }
    }
    // `xs.pop()` removes + returns the last list element (any list kind).
    if callee.memProp == "pop" { return emitPop(body, exprIx, fnIx) }
    // `xs.get(i)` over a STRUCT-element ref list: the checked nullable read —
    // in-bounds yields the (still nullable) element slot, out-of-bounds `ref.null $S`.
    if callee.memProp == "get" {
      if structListPopGetElem(exprIx, fnIx) >= 0 {
        return emitListGet(body, exprIx, fnIx)
      }
    }
    // `xs.map(f)` / `xs.filter(p)` over a LIST receiver lower to the inline
    // closure-calling loop (Slices 3–4). A non-list receiver falls through (a
    // function-valued struct FIELD named `map` is a `call_ref` member call).
    if callee.memProp == "map" || callee.memProp == "filter" {
      if mfRecvKindOf(callee.memObj, fnIx) != null {
        return emitMapFilter(body, exprIx, fnIx)
      }
    }
  }
  return emitCall(body, exprIx, fnIx)
}

// THE NULL-REP TABLE. A bare `null` has no rep of its own — it takes the one the
// enclosing position seeded. Every `X | null` boundary in this file (field / variant-field
// / array element / param / return / let / assign / `??`) seeds one of these flags and
// then names only what is site-specific; the rep itself is decided here, once:
//   pendingNulBool      `boolean | null`   → the i32 sentinel 2      (0/1 are the booleans)
//   pendingNulLitUnion  `K | null`         → the i32 sentinel -1     (atom ids are >= 0)
//   pendingNulString    `string | null`    → `ref.null $aTypeIdx`    (the raw string array)
//   pendingNulClosure   `fn | null`        → `ref.null $cloStruct`   (the fat pointer)
//   pendingNulList      `(i32[] | null)[]` → `ref.null $lTypeIdx`
//   pendingNulRefHeap   any other nullable ref → `ref.null <seeded heap>`
//   pendingStructIdx    `S | null`         → `ref.null $S`
// ORDER is load-bearing: the four NICHE arms come first because a niche `null` is an i32
// or a non-struct ref, and the struct seed at the bottom would type it `ref.null $S`.
function emitNullLitNode(_body: i32[], _e: NullLit, _exprIx: i32, _fnIx: i32) {
  if pendingNulBool {
    fbI32Const(2)
    return 0
  }
  if pendingNulLitUnion {
    fbI32Const(-1)
    return 0
  }
  if pendingNulString {
    wU8(208) // 0xd0 ref.null
    wSLEB(aTypeIdx)
    return 0
  }
  if pendingNulClosure {
    wU8(208) // 0xd0 ref.null
    wSLEB(cloStructIdx)
    return 0
  }
  if pendingNulList {
    wU8(208) // 0xd0 ref.null
    wSLEB(lTypeIdx)
    return 0
  }
  // Reset the seed after CONSUMING it, so it never persists past this `null` (a stray
  // non-(-1) value would mis-type a later bare `null`).
  if pendingNulRefHeap >= 0 {
    const nrh = pendingNulRefHeap
    pendingNulRefHeap = -1
    wU8(208) // 0xd0 ref.null
    wSLEB(nrh)
    return 0
  }
  // A bare `null` VALUE: its target struct comes from the binding/argument/
  // return seed (`pendingStructIdx`) — `ref.null $S`. With no seed it cannot
  // be typed here; fail loudly.
  if pendingStructIdx >= 0 {
    if pendingStructIdx < sHeapIdx.length {
      wU8(208) // 0xd0 ref.null
      wSLEB(sHeapIdx[pendingStructIdx])
      return 0
    }
  }
  return emitFail("emitProgram: bare null needs a struct-typed context")
}

function emitObjLitNode(body: i32[], _e: ObjLit, exprIx: i32, fnIx: i32) {
  // A CONTEXT that expects a CONCRETE variant (`const c: Cat = { … }`, a `Cat[]`
  // element) constructs the BARE variant struct `(ref $(uVarHeap[vi]))` — NOT a union
  // box. `pendingVariantIdx` is the variant; consume it so a nested literal doesn't
  // inherit the hint.
  if pendingVariantIdx >= 0 {
    const pvi = pendingVariantIdx
    pendingVariantIdx = -1
    return emitVariantStruct(body, exprIx, pvi, fnIx)
  }
  // A literal whose field-set matches a STANDALONE struct constructs that struct
  // directly (even alongside a union — `ast.vl`'s `Tok`/`Diag` coexist with `Node`).
  // Otherwise, in a union program, it is a union variant: box it `{tag, value}`.
  if structIndexOfObj(exprIx) >= 0 { return emitObj(body, exprIx, fnIx) }
  if uDeclared { return emitUnionBox(body, exprIx, fnIx) }
  return emitObj(body, exprIx, fnIx)
}

function emitMemberNode(body: i32[], e: Member, exprIx: i32, fnIx: i32) {
  // `a.length` on an array OR string receiver is `array.len` (a string is the SAME
  // `array i32` of code points, so `.length` is the code-point count); every other
  // member access is a struct field read. `length` over a non-array/non-string
  // receiver falls through to the struct path (which fails loudly if no such field),
  // matching the slice's scope.
  if e.memProp == "length" {
    if (
      exprArray(e.memObj, fnIx) ||
      exprString(e.memObj, fnIx) ||
      exprRefArray(e.memObj, fnIx) ||
      exprStringArray(e.memObj, fnIx) ||
      exprF64Array(e.memObj, fnIx) ||
      exprI64Array(e.memObj, fnIx) ||
      exprF32Array(e.memObj, fnIx)
    ) {
      return emitArrLen(body, exprIx, fnIx)
    }
    // G8: `m.length` on a MAP is the LIVE entry count — struct field 5 (`size`),
    // maintained by set/delete (NOT `count`, which includes tombstones).
    if exprMap(e.memObj, fnIx) {
      if emitExpr(body, e.memObj, fnIx) < 0 { return -1 }
      let lsl = mapShapeOfExpr(e.memObj, fnIx)
      lsl = mapShapeFoldSet(lsl)
      fbStructGet(mapTypeIdxOf(lsl), 5) // 0xfb 0x02: field 5 `size`
      return 0
    }
  }
  // `m.size` on a MAP / Set is the same live-entry count as `m.length` (field 5) — the
  // JS Map/Set name. (`.size` is not valid on arrays/strings; they fall through.)
  if e.memProp == "size" {
    if exprMap(e.memObj, fnIx) {
      if emitExpr(body, e.memObj, fnIx) < 0 { return -1 }
      let ssl = mapShapeOfExpr(e.memObj, fnIx)
      ssl = mapShapeFoldSet(ssl)
      fbStructGet(mapTypeIdxOf(ssl), 5) // 0xfb 0x02: field 5 `size`
      return 0
    }
  }
  return emitMem(body, exprIx, fnIx)
}

function emitBinExprNode(body: i32[], e: BinExpr, exprIx: i32, fnIx: i32) {
  // Assignment (`=`) is a STATEMENT, not a value expression in this slice: it has
  // no result on the stack (it `local.set`s). It is lowered by `emitAssign` from
  // `emitStmt`, so seeing it as an operand here is an unsupported nested-assignment.
  if e.binOp == "=" {
    // Assignment is an EXPRESSION yielding its right-hand side (DECISIONS:
    // assignment-as-expression): `b = (a = 5)`, `while (a = a - 1) > 0`, and a
    // trailing `count = count + 1` returning the new value. Lowered as
    // STORE-then-RE-READ — `emitAssign` stores, then the target re-reads through
    // the normal Ident path (which carries the non-const-ref re-cast logic).
    // Ident targets only (a local or module global); an Index/Member assignment
    // in VALUE position is out of this slice.
    //
    // FILED by #1229's hand-off, widened by #1235 (the GLOBAL half) and CLOSED for the
    // LOCAL/PARAM half here — this paragraph is that filing rewritten to its measured
    // residue. The re-read below is the value a function's TAIL assignment returns, and
    // the FUNCTYPE that promises that value is decided somewhere else, from the OTHER
    // operand: `criClassify` (`emit_classify.vl`) used to open with
    //
    //     if rxe.binOp == "=" { rx = rxe.binRight }
    //
    // so `fRetKind` — read by `emitTypeSection`'s un-annotated-return arm, and by
    // `cloRetValKind` for the `$fnsig` bytes — described the RIGHT-HAND SIDE while this
    // line pushes the TARGET. The two agree exactly when storing the RHS needs no coercion
    // AND the RHS's own classifier answer is as strong as the cell's. `criClassify` now
    // asks the TARGET CELL at all three storage classes (`fnAssignRetKind`, dispatched
    // over a body `let` → `letCellKind`, a parameter → `vtKindOfParam`, a module global →
    // `globalCellKind`), so the functype and this line are minted from one fact.
    //
    // MEASURED at `4411fbf3` over a 652-cell grid — storage class (global / local / param /
    // local-in-a-lambda / local-in-a-nested-fn / captured local / tail-of-an-if-arm) ×
    // 41 cell-type-and-RHS rows × position (tail / non-tail control) × form (`f()`, which
    // isolates the functype-vs-body disagreement / `print(f())`, which adds the checker's
    // assignment-expression typing). 108 cells FORWARD, 0 backward, 0 output changed;
    // INVALID-WASM cells 147 -> 43. LOCAL, PARAM and NESTED each went 24 invalid -> 1, and
    // that 1 is `string | null` (below). The non-tail control is green on every row, at
    // every storage class — the defect is POSITIONAL, and that is what puts the assignment
    // in front of the functype.
    //
    // WHAT IS STILL OPEN, from that same grid (all 43):
    //
    //   IF-ARM (29)   The tail statement is an `if` whose ARMS end in the assignment
    //                 (`if c { v = 3 } else { v = 4 }`). NOT this family's global/local
    //                 split — a GLOBAL if-arm target is invalid too, measured — because
    //                 `fnAssignRetTargetName` only reads the body's last statement, so no
    //                 storage class gets the cell. Filed by neither #1235 nor #1254.
    //   `string|null` A `string | null` cell assigned `null`, at global / local / param /
    //   (5)           nested / lambda-local alike. DECLINED ON PURPOSE in
    //                 `fnAssignKindGuard`: `emitIdentNode`'s kind-16 arm recovers non-null
    //                 UNCONDITIONALLY, so naming the cell turns the loud reject into a
    //                 runtime TRAP. The root is that recover (~12740), not the classifier.
    //                 (#1235's residue table called this class a TRAP at all three storage
    //                 classes; measured on the un-consumed `f()` spelling it is INVALID
    //                 WASM, and only the value-CONSUMING spelling traps.)
    //   CHECKER (6)   `print(f())` over an `i64[]` or literal-union cell, at global as well
    //                 as local and param — the checker types `x = e` as `e`'s own type
    //                 UN-coerced. `typecheck.vl`'s assignment-expression typing, filed at
    //                 `fnAssignRetTargetName`.
    //   CAPTURE (2)   A literal-union CAPTURED local. Invalid in the NON-TAIL control too,
    //                 so it is not this family at all.
    //   LAMBDA (1)    An `f32[]` local in a lambda: the `$fnsig` result wrapper and the
    //                 local's wrapper are two `(ref $type)`s. Byte-identical A/B — this
    //                 change does not reach it.
    //
    // THE IMPORT DIRECTION IS STILL WHAT IT WAS, and it is not what blocked this. A local
    // target's SLOT kind is decided by `collectLocals` (`emit_collect.vl`); `wasmEmit.vl`
    // imports both `emit_collect` and `emit_classify`, but `criClassify` runs inside
    // `computeRetInference` in `emit_classify.vl`, which cannot call into this file
    // (`emit_classify` -> `wasmEmit` is the cycle the loader rejects). The resolver
    // therefore lives in `emit_classify`'s own storage class, as #1235 filed — it is
    // `letCellKind`, whose annotated arm is `vtKindOfType` (the same ladder
    // `collectLocals`' annotation arms ride) and whose un-annotated arm is
    // `letInitCellKind` (the ladder `captureValKind` already carried, now one home for
    // both). The agreeing set is pinned by
    // `tests/cases/functions/tail-assign-inferred-return.vl` and
    // `tail-assign-local-param-agreeing.vl`; the coercing LOCAL/PARAM set by
    // `tests/cases/statements/tail-assign-coercing-local.vl`.
    //
    // TWO MEASUREMENTS FROM THE ORIGINAL FILING, both re-checked here. (1) The axis is the
    // assignment being the body's LAST statement. Adding one statement after it runs, and
    // ANNOTATING the return runs — still true, on all 41 rows × 7 storage classes.
    // (2) The one-line repair — reading `binLeft` instead of `binRight` in `criClassify` —
    // is REFUTED, and its STATED REASON WAS WRONG. It fails because `binLeft` is an
    // EXPRESSION fed to the same expression classifiers, which answer the RHS's question
    // about it ("what does reading this ident produce"), not the cell's ("what valtype is
    // this slot"); and because `string | null` then classifies "str" and turns invalid wasm
    // into a trap. It does NOT fail because "a local's declaration is not visible during
    // that pass" — that parenthetical is FALSE and was the stated reason this repair was
    // abandoned. `retIsMapLocal` and `criRetLocalLet`, both in `criClassify`'s own
    // file and both reached from `computeRetInference`, resolve a local declaration with
    // `parentLetOf` on exactly this pass, and `fnAssignRetKind` now does the same.
    const tgt = P.nodes[e.binLeft]
    if tgt is Ident {
      if emitAssign(body, exprIx, fnIx) < 0 { return -1 }
      return emitExpr(body, e.binLeft, fnIx)
    }
    return emitFail(
      "emitProgram: only an identifier assignment is a value expression",
    )
  }
  // G8: nullish-coalescing `m[k] ?? d` — a FUSED map get-with-default: scan `m` for
  // `k`, push `vals[hit]` on a hit else the default `d`. The self-host checker reads
  // every scope map through `?? -1`. The LHS must be a map index in this slice.
  if e.binOp == "??" { return emitCoalesce(body, e, exprIx, fnIx) }
  // Short-circuit logical operators lower to a VALUE-TYPED `if` (blocktype 0x7f),
  // an `if` expression that leaves one i32 on the stack — both arms push an i32:
  //   `a && b`  ≡  if (a) { b } else { 0 }   (skip b when a is false → 0)
  //   `a || b`  ≡  if (a) { 1 } else { b }   (skip b when a is true  → 1)
  // The condition `a` is evaluated first, then `if 0x04` with i32 result-type
  // blocktype `0x7f`; the then-branch, `else 0x05`, the else-branch, then `end 0x0b`.
  //
  // THE RIGHT OPERAND IS A NARROWING SCOPE, exactly like an `if` ARM. `a` decides
  // whether `b` runs at all, so `b` is emitted under whatever `a` proved — the same
  // fact the checker types `b` against. `&&` gives `b` the THEN-sense of `a`
  // (`setNarrowFromCond`, which recurses through a nested `a && b` and through `!`),
  // `||` the ELSE-sense (`setNarrowFromCondElse` — `b` runs only when `a` was false).
  // Without the push, `e != null && e >= 0` over a value-union BOX (`i32 | null` is
  // `(struct (field i32) (field anyref))`) pushed the BOX ref under `i32.ge_s`:
  // `vl check` rc 0, invalid wasm. The statement spelling of the identical operation
  // (`if e != null { return e >= 0 }`) always worked because THAT arm pushes here, and
  // the two now emit byte-identical unbox sequences. `==` survived un-narrowed only
  // because a boxed operand has its own structural lowering (`emitUnionConcreteEq` /
  // `emitUnionUnionEq`) that reads the tag and payload itself.
  if e.binOp == "&&" || e.binOp == "||" {
    if emitExpr(body, e.binLeft, fnIx) < 0 {
      return -1 // condition `a`
    }
    fbIf(127) // 0x04 if, 0x7f i32 result-type blocktype (yields an i32)
    const scTop = narrowTop
    if e.binOp == "&&" {
      // then = b, else = 0
      const scNarrowed = setNarrowFromCond(e.binLeft, fnIx)
      if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
      if scNarrowed { restoreNarrow(scTop) }
      fbElse() // 0x05 else
      fbI32Const(0)
    } else {
      // then = 1, else = b
      fbI32Const(1)
      fbElse() // 0x05 else
      const scNarrowedElse = setNarrowFromCondElse(e.binLeft, fnIx)
      if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
      if scNarrowedElse { restoreNarrow(scTop) }
    }
    fbEnd() // 0x0b end
    return 0
  }
  // Structural `==`/`!=` with a still-BOXED value-union operand (either side,
  // or both — equality is symmetric). Checked BEFORE the string-eq routing (a
  // union box compared against a string would otherwise misclassify as a bare
  // string compare) and SKIPS `null` literals — the box-tag null compare below
  // owns `v == null` (the host's `variantTag(info, null)` path).
  if e.binOp == "==" || e.binOp == "!=" {
    const uql = P.nodes[unwrapParen(e.binLeft)]
    const uqr = P.nodes[unwrapParen(e.binRight)]
    let uqNull = false
    if uql is NullLit { uqNull = true }
    if uqr is NullLit { uqNull = true }
    // THE LITUNION EXCLUSION IS PER-OPERAND, NOT PER-COMPARE. `exprUnion` claims a
    // `K`-annotated binding too — `K` is a registered union NAME while the value is a bare
    // interned id — so this arm has to disqualify the litunion OPERAND rather than the whole
    // compare. Disqualifying the compare made `boxU == k` skip the union path entirely
    // because ONE side was an atom, and the atom compare below then pushed the BOX ref under
    // an `i32.eq`: `vl check` rc 0, invalid wasm. `eqAtomOperandOk` is the same bound that
    // arm keys on, so exactly one of the two claims any given pair.
    if !uqNull {
      const uqL = exprUnion(e.binLeft, fnIx) &&
        !eqAtomOperandOk(e.binLeft, fnIx)
      const uqR = exprUnion(e.binRight, fnIx) &&
        !eqAtomOperandOk(e.binRight, fnIx)
      if uqL && uqR {
        return emitUnionUnionEq(
          body,
          e.binLeft,
          e.binRight,
          e.binOp == "!=",
          fnIx,
        )
      }
      if uqL {
        return emitUnionConcreteEq(
          body,
          e.binLeft,
          e.binRight,
          e.binOp == "!=",
          fnIx,
        )
      }
      if uqR {
        return emitUnionConcreteEq(
          body,
          e.binRight,
          e.binLeft,
          e.binOp == "!=",
          fnIx,
        )
      }
    }
  }
  // A literal-union ATOM compare (`k == "a"`, `k1 == k2`): both operands are i32 ids. Emit them as atoms
  // (a member StrLit -> its id; a litunion var -> its i32 value) and i32-compare. BEFORE the string-eq
  // path, which would otherwise treat the member literal as a string.
  //
  // ONE ATOM OPERAND IS NOT ENOUGH — BOTH SIDES HAVE TO BE ATOM-LOWERABLE
  // (`eqAtomOperandOk`, whose header carries which shapes are and why the missing one cannot
  // be narrowed into the set). `u == kk` with `u: string` and `kk: K` is an ordinary program
  // the checker accepts, and forcing the atom context on it pushed a `(ref $array)` under
  // this `i32.eq`. A mixed pair falls through to the string-eq path below, which widens the
  // ATOM to its member string (`emitStrValue`) — the direction the `is` spelling of the same
  // question already takes.
  if e.binOp == "==" || e.binOp == "!=" {
    // SKIP a `null` operand: `r == null` over a `K | null` niche is the `-1` sentinel compare (the
    // nullable-struct block below owns it). A litunion atom never equals the `null` literal here, and
    // lowering `null` with `pendingLitUnion` would mis-route it to a bare-null struct context.
    let atomNull = false
    if P.nodes[unwrapParen(e.binLeft)] is NullLit { atomNull = true }
    if P.nodes[unwrapParen(e.binRight)] is NullLit { atomNull = true }
    if !atomNull {
      if exprIsLitAtom(e.binLeft, fnIx) || exprIsLitAtom(e.binRight, fnIx) {
        if (
          eqAtomOperandOk(e.binLeft, fnIx) &&
          eqAtomOperandOk(e.binRight, fnIx)
        ) {
          const luCtx = expCtxHere()
          luCtx.litUnion = 1
          if emitExprExpect(body, e.binLeft, fnIx, luCtx) < 0 { return -1 }
          if emitExprExpect(body, e.binRight, fnIx, luCtx) < 0 { return -1 }
          fbI32Bin(70) // 0x46 i32.eq
          if e.binOp == "!=" {
            fbI32Eqz() // 0x45 i32.eqz -> `!=`
          }
          return 0
        }
      }
    }
  }
  // A `==`/`!=` OVER A NULLABLE REF NICHE, plus the emitter-capability FLOOR for a rep with no
  // compare core — both off the ONE comparability home (`nodeEqCmpKind`), the same function the
  // checker's acceptance reads. This has to come BEFORE the string / list / struct / closure
  // compares below, because every one of them classifies its operands by their NON-NULL rep and
  // would lower the niche as though the null could not be there.
  if e.binOp == "==" || e.binOp == "!=" {
    if binEqHasNoLowering(exprIx) {
      return emitFail(
        "emitProgram: `" +
          e.binOp +
          "` over this operand rep has no lowering",
      )
    }
    const nulNiche = binEqNulNiche(exprIx)
    if nulNiche != "" {
      if emitNulNicheEq(body, exprIx, fnIx, nulNiche) < 0 { return -1 }
      if e.binOp == "!=" {
        fbI32Eqz() // 0x45 i32.eqz — the wrapper always leaves the `==` answer
      }
      return 0
    }
  }
  // G6 string operators (a string is a `(array i32)` of code points): `+` is a NEW
  // concatenated array; `==`/`!=` are ELEMENT-WISE value-equality, NOT ref identity
  // — so they take their own inline lowering BEFORE the i32 `binOpcode` path (which
  // would emit `i32.eq` = ref identity, the WRONG answer for strings). Only string-
  // typed operands route here; i32/other-type `+`/`==`/`!=` are unchanged.
  if exprIsStrConcat(exprIx, fnIx) { return emitStrConcat(body, exprIx, fnIx) }
  if exprIsStrEq(exprIx, fnIx) { return emitStrEq(body, exprIx, fnIx) }
  if exprIsStrOrder(exprIx, fnIx) { return emitStrOrder(body, exprIx, fnIx) }
  // List `==`/`!=` (length + element value-compare, recursive through nested
  // lists / string elements) and list `+` (concat) — collections-design
  // §VL.4/§VL.6, the host's `listEqFn`/concat lowerings, inlined.
  const lopK = listOpKindOfBin(exprIx, fnIx)
  if lopK >= 0 {
    if e.binOp == "+" {
      if lopK != 0 {
        return emitFail(
          "emitProgram: list concat over this element kind is not supported",
        )
      }
      return emitListConcatI(body, e.binLeft, e.binRight, fnIx)
    }
    if emitExpr(body, e.binLeft, fnIx) < 0 { return -1 }
    if emitEqRecoverNarrowed(e.binLeft, fnIx) < 0 { return -1 }
    if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
    if emitEqRecoverNarrowed(e.binRight, fnIx) < 0 { return -1 }
    if emitEqNonNullCore(body, exprIx, fnIx) < 0 { return -1 }
    if e.binOp == "!=" {
      fbI32Eqz() // 0x45 i32.eqz (`!=` negates value-equality)
    }
    return 0
  }
  // `x == null` / `x != null` over any NULLABLE value — the rep's own null test, never the
  // i32 compare. Checked before the structural string / struct / closure equality below,
  // each of which would compare a value against the `null` literal.
  if e.binOp == "==" || e.binOp == "!=" {
    const nlhs = P.nodes[e.binLeft]
    const nrhs = P.nodes[e.binRight]
    let nref = -1
    if nrhs is NullLit { nref = e.binLeft }
    if nlhs is NullLit { nref = e.binRight }
    if nref >= 0 {
      // The ladder is shared with the `is null` guard — the two spellings ask the same
      // question of the same rep, and `emitNulIsNullTest`'s header carries why they must
      // not be answered in only one place. `!=` is the INVERTED direction, which the ladder
      // emits directly (`i32.ne`) rather than leaving a caller to negate an `i32.eq`.
      const bnt = emitNulIsNullTest(body, nref, fnIx, e.binOp == "!=", false)
      if bnt < 0 { return -1 }
      if bnt > 0 { return 0 }
    }
    // STRUCTURAL struct equality: same-shape operands compare field-wise
    // (`emitStructEq` — scalars native, strings via the eq loop, `i32[]` via a
    // length+element loop, nested structs recursively, function-valued fields
    // by identity via `emitCloEqCore`).
    const eqLsi = structIndexOfExpr(e.binLeft, fnIx)
    const eqRsi = structIndexOfExpr(e.binRight, fnIx)
    if eqLsi >= 0 || eqRsi >= 0 {
      if eqLsi >= 0 && eqLsi == eqRsi {
        return emitStructEq(body, exprIx, fnIx)
      }
      return emitFail("emitProgram: struct equality is not supported yet")
    }
    // Function-value `==`/`!=`: IDENTITY — the same lifted function (the id
    // field) AND the same captured env (`ref.eq`). Mirrors the host (same
    // table index AND same env; null == null envs are equal).
    if exprIsClosure(e.binLeft, fnIx) || exprIsClosure(e.binRight, fnIx) {
      if emitExpr(body, e.binLeft, fnIx) < 0 { return -1 }
      if emitEqRecoverNarrowed(e.binLeft, fnIx) < 0 { return -1 }
      if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
      if emitEqRecoverNarrowed(e.binRight, fnIx) < 0 { return -1 }
      if emitEqNonNullCore(body, exprIx, fnIx) < 0 { return -1 }
      if e.binOp == "!=" {
        fbI32Eqz() // 0x45 i32.eqz — negate identity-equality
      }
      return 0
    }
  }
  // THE WIDE-SCALAR SLICES (f32, then f64, then i64 — one shape, three widths). If
  // EITHER operand is of the width, emit that width's instruction variant and coerce the
  // other operand to it first (`emitExprAsF32`/`AsF64`/`AsI64`); this covers arithmetic
  // (a wide result) AND comparisons (an i32 bool result, but the COMPARE consumes two
  // wide operands). Each is keyed on OPERAND KIND, so an i32-only program never enters
  // any of them and the i32 path at the bottom stays byte-identical.
  //
  // The ORDER is the only thing that differs, and it is load-bearing: f32 first because a
  // float literal is `exprIsF64` too, so `x + 4.0` with `x: f32` must route to f32; then
  // f64 (a float operand is never i64); then i64.
  //
  // Slice 5 — f32.
  const lF32 = exprIsF32(e.binLeft, fnIx)
  const rF32 = exprIsF32(e.binRight, fnIx)
  // A GENUINE (non-literal) f64 operand makes the op f64 — the f32 side widens (`f32 + f64var`),
  // so route to the f64 slice below instead of demoting the f64 here (which trapped). A float
  // literal still adapts DOWN to the f32 operand, so `f32 + 1.0` stays on the f32 slice.
  if (lF32 || rF32) && !binMixHardF64(e.binLeft, e.binRight, fnIx) {
    const opcF32 = binOpcodeF32(e.binOp)
    // NO f32 FORM ⇒ FAIL, never fall through. The ops with no float form (`%`, bitwise,
    // shift) are integer-only in the checker, so this is unreachable from accepted source;
    // it exists because FALLING THROUGH reaches the i32 tail at the bottom of this
    // function, which emits an i32 opcode over an operand already on the stack as a float
    // and produces INVALID WASM that only the engine catches (`%` did exactly this).
    // A backstop that fails loudly keeps that outcome impossible however this is reached.
    if opcF32 < 0 {
      return emitFail("emitProgram: operator '" + e.binOp + "' has no f32 form")
    }
    if emitExprAsF32(body, e.binLeft, fnIx) < 0 { return -1 }
    if emitExprAsF32(body, e.binRight, fnIx) < 0 { return -1 }
    fbI32Bin(opcF32)
    return 0
  }
  // Slice 3 — f64.
  const lF64 = exprIsF64(e.binLeft, fnIx)
  const rF64 = exprIsF64(e.binRight, fnIx)
  if lF64 || rF64 {
    const opcF = binOpcodeF64(e.binOp)
    // NO f64 FORM ⇒ FAIL, never fall through — the f32 slice's reasoning, one width up.
    if opcF < 0 {
      return emitFail("emitProgram: operator '" + e.binOp + "' has no f64 form")
    }
    if emitExprAsF64(body, e.binLeft, fnIx) < 0 { return -1 }
    if emitExprAsF64(body, e.binRight, fnIx) < 0 { return -1 }
    fbI32Bin(opcF)
    return 0
  }
  // Slice 2 — i64 (also bitwise / shift).
  const lI64 = exprIsI64(e.binLeft, fnIx)
  const rI64 = exprIsI64(e.binRight, fnIx)
  if lI64 || rI64 {
    const opc64 = binOpcodeI64(e.binOp)
    if opc64 >= 0 {
      if emitExprAsI64(body, e.binLeft, fnIx) < 0 { return -1 }
      if emitExprAsI64(body, e.binRight, fnIx) < 0 { return -1 }
      fbI32Bin(opc64)
      return 0
    }
  }
  const opcode = binOpcode(e.binOp)
  if opcode < 0 { return emitFail("emitProgram: unsupported binary operator") }
  // Operands first (left then right), then the operator — wasm's stack order.
  if emitExpr(body, e.binLeft, fnIx) < 0 { return -1 }
  if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
  fbI32Bin(opcode)
  return 0
}

// The direct-call lowering for an `Ident` callee resolved to function index
// `target` (env-leading when `fnValUsed`): arguments reordered into parameter
// order and emitted per-parameter with the full coercion suite (struct/variant
// hints, union boxing, nullable bridging, float/i64 widening), then `call`.
function emitDirectCall(body: i32[], callIx: i32, fnIx: i32, target: i32) {
  // The callee's FuncDecl lives at `fnStmts[target]` (the function index IS the
  // fnStmts position). Its parameter list lets a struct-literal argument construct as
  // the callee's DECLARED param struct type rather than a field-name guess — the fix
  // for passing a struct value into a forward-referenced / mutually-recursive callee
  // whose param struct shares field names with another struct.
  const cFn = P.nodes[fnStmts[target]]
  // Arguments in PARAMETER order (host parity: `orderArgumentsByParameters`
  // + operands built per-parameter). A call with no named args keeps its
  // source list untouched; a named call (`f(b: 1, a: 2)`) reorders here so
  // each emitted operand lands on (and is typed by) its declared parameter
  // — including EVALUATION order, which follows parameter order as the
  // host's per-parameter operand build does.
  const args = orderedDirectArgs(callIx, target)
  if directArgsBad(args, callIx) {
    return emitFail("emitProgram: named argument does not match a parameter")
  }
  // When a function value exists module-wide, EVERY callee carries a hidden leading
  // `structref env` param. A direct call to a top-level function (never capturing)
  // passes a null env. Pushed BEFORE the args, matching the env-leading signature.
  if fnValUsed { fbRefNullStruct() }
  // Each argument's valtype is decided by its PARAMETER (the `cParamF32`/`cParamF64`/
  // `cParamI64` coercions below), so any WIDE-SCALAR context an ENCLOSING position set must
  // NOT leak into the arg spine — the discipline `emitCallRef`'s argument spine and
  // `emitMemIntrinArg` already apply. The DIRECT spine cleared only `pendingI64` (per
  // iteration), so `pendingF32` survived from every position that seeds it — `const r: f32 =
  // g(1)`, an `f32` return/tail, an `f32` list push, an `f32[]` element assignment, an `f32`
  // param of an OUTER direct call, an f32 union atom — and a bare integer-literal argument
  // then lowered as `f32.const` into an i32 (or i64) parameter: `f32.const 1 ; call $g` where
  // `$g` is `(param i32)`. An UNPARSEABLE MODULE with `vl check` clean, at every one of them.
  //
  // `pendingF64` is cleared for the same reason; it has no seeding site today (the f64
  // let/return arms call `emitExprAsF64` without setting it), which is exactly why f64
  // escaped the defect, and the clear keeps that true if one is ever added.
  //
  // THE LITERAL-UNION SEEDS ARE THE SAME RULE, and the rep they pick is not a widening but
  // a whole different valtype (an interned i32 ATOM vs a `(ref $array)` member string). The
  // arg spine reads them through `expCtxHere()`, which SNAPSHOTS the ambient — so every
  // atom-typed destination holding a call (`const r: K = f(a)`, a `K` field/element/map
  // value, a `K` param of an outer call, `"s" + f(a)` through `emitAtomToStr`) pushed its
  // own atom context down into `f`'s ARGUMENTS, where it belongs to `f`'s parameters alone:
  // a member-literal argument lowered as an i32 id and a string-repped litunion argument
  // took `emitStrToAtom`, both into `(ref $array)` param slots. Invalid wasm, `vl check`
  // clean. The two positions that legitimately want an atom argument set it back below
  // from the CALLEE's own parameter (`cParamLitUnion` / `cParamNulLitUnion`).
  const savedArgF32 = pendingF32
  const savedArgF64 = pendingF64
  const savedArgLU = pendingLitUnion
  const savedArgNulLU = pendingNulLitUnion
  pendingF32 = false
  pendingF64 = false
  pendingLitUnion = 0
  pendingNulLitUnion = false
  let i = 0
  while i < args.length {
    // If this argument position is a struct-typed parameter, hint `emitObj` with the
    // callee's struct index (consumed by the immediately-following object-literal
    // lowering; a non-literal argument simply ignores it). Default -1 = infer.
    pendingStructIdx = -1
    pendingListKind = 0
    pendingListSlot = 0
    pendingI64 = false
    // A VARIANT-typed param position (kind 8): the callee wants the CONCRETE variant
    // struct ref, but a union-valued argument (a narrowed local/param, a union-
    // returning call) is the BOX `{tag, value}`. Bridge the boundary by unboxing the
    // arg to the param's variant struct — `struct.get $box 1 ; ref.cast (ref $var)`
    // (gap #2). The cast is statically safe: control reached this call only with the
    // arg narrowed to this variant.
    let cVi = -1
    // A NON-NULL struct param position (kind 1, `(ref $S)`): a nullable-REP
    // argument needs `ref.as_non_null` at the boundary (see below).
    let cParamStruct = false
    // The NON-NULL list / map param positions — every kind whose slot is a
    // `(ref $wrapper)` that a `(ref null $wrapper)` argument does not satisfy.
    // Same boundary recover as `cParamStruct`, over the reps owning a wrapper.
    let cParamNonNullList = false
    // A UNION-typed param position (kind 4): the callee wants the box, so a raw
    // scalar/string/null argument is COERCED into the union representation
    // (`emitUnionCoerce` — the host's call-boundary `coerceUnion`). The param's
    // union NAME carries the atom set for the tag choice.
    let cUNm = ""
    // The NICHE `X | null` param positions. Each seeds the null rep its kind demands (the
    // table lives at `emitNullLitNode`) and leaves a NON-null argument untouched; the two
    // list niches additionally let a list-value/literal argument build the wrapper it
    // subtypes. Kinds: 21 boolean, 16 string, 19 fn, 15 `i32[]`, 18 ref-array, and the
    // distinct-backing scalar lists (`i64[] | null` etc.).
    let cParamNulBool = false
    let cParamNulString = false
    let cParamNulClosure = false
    let cParamNulList = false
    let cParamNulRefArr = false
    let cParamNulRefArrHeap = -1
    let cParamNulSLKind: VKind | null = null
    // A literal-union param position: a member-literal argument lowers as its interned i32 id.
    let cParamLitUnion = false
    let cParamNulLitUnion = false
    // A `string` param position (kind 3): a literal-union atom ARGUMENT widens to its member
    // string at the boundary (the atom-as-string-subtype edge).
    let cParamStr = false
    if cFn is FuncDecl {
      const cParams = cFn.fnParams
      if i < cParams.length {
        const cpnb = P.nodes[cParams[i]]
        if cpnb is Param {
          if tyIsNulBool(cpnb.parType) { cParamNulBool = true }
          if retNulStringFlag(cpnb.parType) == 1 { cParamNulString = true }
          if nulCloFlag(cpnb.parType) == 1 { cParamNulClosure = true }
          if retNulListFlag(cpnb.parType) == 1 { cParamNulList = true }
          cParamNulSLKind = nulScalarListKindOfNode(cpnb.parType)
          if retNulRefArrFlag(cpnb.parType) == 1 {
            cParamNulRefArr = true
            const cpRls = tyAnnRefListSlot(cpnb.parType)
            if cpRls >= 0 && cpRls < rlWrapIdx.length {
              cParamNulRefArrHeap = rlWrapIdx[cpRls]
            }
          }
          // THE CALLER'S HALF of the same question the callee's body asks through
          // `exprIsLitAtom`. Both must use the alias-INDEX test or a narrowed-alias param is
          // declared `i32` while the member-literal argument is lowered as a string ref.
          if tyLitUnionAliasIx(nodeTyIxOf(cpnb.parType)) >= 0 {
            cParamLitUnion = true
          }
          // A `K | null` NICHE param: a member-literal arg (`f("a")`) lowers as its atom id
          // (`pendingLitUnion`), a `null` arg as the i32 sentinel `-1` (`pendingNulLitUnion`).
          if nodeTyIsNulLitUnion(cpnb.parType) { cParamNulLitUnion = true }
        }
        if vtKindOfParam(cParams[i]) == "str" { cParamStr = true }
        if (
          vtKindOfParam(cParams[i]) == "struct" ||
          vtKindOfParam(cParams[i]) == "nulstruct"
        ) {
          pendingStructIdx = paramStructIdxOf(cParams[i])
        }
        // A NULLABLE map param position (`{[string]: V} | null`, kind `nulmap`): a `null` argument
        // lowers as `ref.null $mapStruct` (the generic ref-null seed over THIS map's heap type). A
        // map-value argument is a variable that self-identifies its shape (`exprMap`), so it ignores
        // the seed. Mirrors the nulstruct `pendingStructIdx` seed above.
        if vtKindOfParam(cParams[i]) == "nulmap" {
          pendingNulRefHeap = mapTypeIdxOf(paramStructIdxOf(cParams[i]))
        }
        if vtKindOfParam(cParams[i]) == "struct" { cParamStruct = true }
        const cpvk = vtKindOfParam(cParams[i])
        if (
          cpvk == "list" ||
          cpvk == "strlist" ||
          cpvk == "f64list" ||
          cpvk == "i64list" ||
          cpvk == "f32list" ||
          cpvk == "reflist" ||
          cpvk == "map"
        ) {
          cParamNonNullList = true
        }
        if vtKindOfParam(cParams[i]) == "variant" {
          cVi = paramStructIdxOf(cParams[i])
        }
        if vtKindOfParam(cParams[i]) == "union" {
          const cp4 = P.nodes[cParams[i]]
          if cp4 is Param { cUNm = tyNameOf(cp4.parType) }
        }
        // A ref-array param position (`take(xs: B[])`): seed the list context from the
        // param's annotation so a non-empty `B[]` LITERAL argument builds the param's
        // declared element type, not the first-element field-shape guess. Mirrors the
        // let / return / global seeding (consumed by `emitArr`).
        const cp = P.nodes[cParams[i]]
        if cp is Param {
          pendingListKind = tyAnnRefListKind(cp.parType)
          pendingListSlot = tyAnnRefListSlot(cp.parType)
        }
        // An i64 param position lowers an integer-literal argument as `i64.const`.
        if vtKindOfParam(cParams[i]) == "i64" { pendingI64 = true }
      }
    }
    // An f64 / f32 param position lowers the argument coerced to that float type
    // (a float literal re-encodes; an i32/i64/f32 source converts via the lattice
    // helper). (Slice 3 f64; Slice 5 f32.)
    let cParamF64 = false
    let cParamF32 = false
    // An i64 param position widens a narrower (i32) argument at the call
    // boundary via `i64.extend_i32_s` — `emitExprAsI64` (a literal lowers as
    // `i64.const`; an i32 VARIABLE sign-extends). The value-preserving edge
    // the checker permits, mirroring the let / return widenings.
    let cParamI64 = false
    if cFn is FuncDecl {
      const cParams2 = cFn.fnParams
      if i < cParams2.length {
        if vtKindOfParam(cParams2[i]) == "f64" { cParamF64 = true }
        if vtKindOfParam(cParams2[i]) == "f32" { cParamF32 = true }
        if vtKindOfParam(cParams2[i]) == "i64" { cParamI64 = true }
      }
    }
    if cParamF32 {
      const savedF32 = pendingF32
      pendingF32 = true
      if emitExprAsF32(body, args[i], fnIx) < 0 { return -1 }
      pendingF32 = savedF32
      pendingStructIdx = -1
      pendingListKind = 0
      pendingListSlot = 0
      pendingI64 = false
      i = i + 1
    } else if cParamF64 {
      if emitExprAsF64(body, args[i], fnIx) < 0 { return -1 }
      pendingStructIdx = -1
      pendingListKind = 0
      pendingListSlot = 0
      pendingI64 = false
      i = i + 1
    } else if cParamI64 {
      if emitExprAsI64(body, args[i], fnIx) < 0 { return -1 }
      pendingStructIdx = -1
      pendingListKind = 0
      pendingListSlot = 0
      pendingI64 = false
      i = i + 1
    } else {
      if (cParamStr || cParamNulString) && exprIsLitAtom(args[i], fnIx) {
        // A literal-union atom flowing into a `string` param widens to its member string — and
        // into a `string | null` param for the same reason, the slot being that same reference
        // with a null permitted and a widened member string being non-null. A `null` argument is
        // not a lit atom and still takes the `nulString`-seeded context below.
        // (Shared tail below resets the `pending*` hints and advances `i`.)
        if emitAtomToStr(body, args[i], fnIx) < 0 { return -1 }
      } else if cUNm != "" {
        // `cUNm` is set only for a kind-4 union-BOX param (see above), so a concrete
        // variant ARGUMENT (`area(s)` where `s: S`, param `C | S`) is boxed here.
        if emitUnionBoxArg(body, cUNm, args[i], fnIx) < 0 { return -1 }
      } else {
        const argCtx = expCtxHere()
        if cParamNulBool { argCtx.nulBool = true }
        if cParamNulString { argCtx.nulString = true }
        if cParamNulClosure { argCtx.nulClosure = true }
        if cParamNulList { argCtx.nulList = true }
        if cParamNulRefArr && cParamNulRefArrHeap >= 0 {
          // The #964 SEED-LEAK gate (stated in full at `emitObj`'s code-28 arm) at the
          // ARGUMENT boundary. Witness: `useIt([null])` on a `(S | null)[] | null` param
          // (fuzz seed 160804094 d5).
          const nraArg = P.nodes[unwrapParen(args[i])]
          if nraArg is NullLit { argCtx.nulRefHeap = cParamNulRefArrHeap }
        }
        const argNulSLK = cParamNulSLKind
        if argNulSLK != null {
          // A list-literal argument builds the leaf wrapper; a `null` argument
          // is `ref.null $wrapper`. Mirrors the return-position seeding.
          argCtx.listKind = nulScalarListBuildKind(argNulSLK)
          argCtx.nulRefHeap = nulScalarListWrapHeap(argNulSLK)
        }
        if cParamLitUnion { argCtx.litUnion = 1 }
        if cParamNulLitUnion {
          argCtx.litUnion = 1
          argCtx.nulLitUnion = true
        }
        // A variant-PARAM position (`loud(c: Cat)`): seed the variant index so an object
        // LITERAL argument builds the bare variant struct (kind 8). A variant/union VALUE
        // argument ignores the hint (the union-unbox cast below handles a boxed value).
        if cVi >= 0 { argCtx.variantIdx = cVi }
        if emitExprExpect(body, args[i], fnIx, argCtx) < 0 { return -1 }
        pendingVariantIdx = -1
        // A nullable-REP value (a null-narrowed `S | null` param/local, or a
        // recursive `S | null` field read whose wasm slot stays `(ref null $S)`)
        // flowing into a NON-NULL `(ref $S)` param: recover the non-null ref at
        // the call boundary. The checker proved the value non-null on this path
        // (the call sits under its null guard), so the cast never traps —
        // narrowing is type-level only and the stack value keeps the nullable
        // rep, which a `(ref $S)` param does not accept.
        if cParamStruct {
          if exprNullableStruct(args[i], fnIx) {
            fbRefAsNonNull() // 0xd4
          }
        }
        // The LIST / MAP dual of the recover above, over every nullable wrapper
        // rep: `nullist` (`i32[] | null`, `boolean[] | null`), the four
        // distinct-backing scalar lists, `nulreflist` (`S[] | null`) and
        // `nulmap`. A `!= null`-narrowed value keeps its `(ref null $wrapper)`
        // slot — narrowing is type-level — so `takes(e)` against a
        // `takes(x: i32[])` pushed `(ref null $type)` under a `(ref $type)`
        // param: `vl check` rc 0, invalid wasm, in the `if`-statement spelling
        // as much as in a short-circuit operand. The checker proved the call
        // guarded, so the recover cannot trap. These four predicates are the
        // ones the READ sites already use, and the param-kind gate keeps them
        // off the nullable param positions above, which want the slot nullable.
        if cParamNonNullList {
          if (
            exprNullableList(args[i], fnIx) ||
            exprNulScalarListKind(args[i], fnIx) != null ||
            exprNullableRefArray(args[i], fnIx) ||
            exprNullableMap(args[i], fnIx)
          ) {
            fbRefAsNonNull() // 0xd4
          }
        }
      }
      if cVi >= 0 {
        if exprUnion(args[i], fnIx) {
          fbStructGet(uBoxIdx, 1)  // 0xfb 0x02 <box ht> field 1: value (anyref)
          fbRefCast(uVarHeap[cVi]) // 0xfb 0x16 <variant struct> ref.cast (non-null)
        }
      }
      pendingStructIdx = -1
      pendingListKind = 0
      pendingListSlot = 0
      pendingI64 = false
      i = i + 1
    }
  }
  pendingF32 = savedArgF32
  pendingF64 = savedArgF64
  pendingLitUnion = savedArgLU
  pendingNulLitUnion = savedArgNulLU
  fbCall(gImports + target) // 0x10 call (imports occupy indices 0..gImports-1)
  // Arm the tail-call cursor: if this call is still the last thing written when the
  // enclosing `return` terminates, it is in tail position and `emitUnionRetSink`
  // rewrites the pair into `return_call`.
  tailCallIdx = gImports + target
  tailCallEnd = wLen()
  return 0
}

// The captured-call lowering for an `Ident` callee resolved to a CAPTURING lifted
// function at index `target`: build its closure value live (reading captures) and
// `call_ref` it (a plain `call` would pass a null env and lose the captures).
function emitCapturedCall(body: i32[], callIx: i32, fnIx: i32, target: i32) {
  // Stash the freshly-built closure, then call_ref it (same shape as emitCallRef
  // but the callee is a value we synthesize here, not an existing binding).
  if emitClosureValue(body, target, fnIx) < 0 { return -1 }
  fbLocalSet(callRefSlot)
  fbLocalGet(callRefSlot)
  fbStructGet(cloStructIdx, 0) // env
  // Parameter-order args (named-call reorder; see the direct path below).
  const cargs = orderedDirectArgs(callIx, target)
  if directArgsBad(cargs, callIx) {
    return emitFail("emitProgram: named argument does not match a parameter")
  }
  // PER-PARAMETER ARGUMENT COERCION — the spine pushed every argument RAW, and the
  // callee's own declared functype is what receives it. This is the FOURTH `call_ref`
  // reach (a nested CAPTURING function called by NAME), and unlike `emitCallRef` it needs
  // no `$fnsig`/arena pair to decide anything: it resolved `target` to build the closure,
  // so it holds the callee's `Param` nodes and can read `vtKindOfParam` exactly as the
  // DIRECT twin `emitCall` does. Four kinds, each `vl check`-clean INVALID WASM before:
  //
  //   union box   `function inner(k: string | i64)` + `inner("a")` — the raw member ref
  //               pushed into the `(ref $uBox)` the functype declares.
  //   i64/f64/f32 `function inner(k: i64)` + `inner(7)` — "expected i64, found i32". NOT a
  //               union shape at all: the plainest possible captured call, and the cell
  //               that shows this spine's gap was never about unions.
  //   litunion    `function inner(k: K)` + `inner("a")` — a string ref into the interned
  //               i32 ATOM param (the captured-call twin of #1170's value-call half).
  //
  // BYTE-SAFE BY CONSTRUCTION on everything that worked before: each arm fires only where
  // the raw push was already the wrong valtype. A union argument that already HOLDS the
  // box passes through (`emitUnionCoerce`'s first act), an i64-typed variable through
  // `emitExprAsI64` is the same load, and a litunion ATOM variable already holds its id.
  //
  // The LITERAL-UNION seeds are cleared for the arg spine for the reason the direct twin
  // states in full: an argument's rep belongs to the callee's PARAMETER, and an atom-typed
  // destination holding the call would otherwise push its own atom context down into the
  // arguments (`cpLit` below restores it where the parameter really is an atom).
  const cfn = P.nodes[fnStmts[target]]
  let cps: i32[] = []
  if cfn is FuncDecl { cps = cfn.fnParams }
  const savedCapLU = pendingLitUnion
  const savedCapNulLU = pendingNulLitUnion
  pendingLitUnion = 0
  pendingNulLitUnion = false
  let cai = 0
  while cai < cargs.length {
    let cuNm = ""
    let cpKind: VKind = "i32"
    let cpLit = false
    if cai < cps.length {
      cpKind = vtKindOfParam(cps[cai])
      const cpn = P.nodes[cps[cai]]
      if cpn is Param {
        if cpKind == "union" { cuNm = tyNameOf(cpn.parType) }
        // Alias-INDEX, so a NARROWED copy is recognized — the captured-call twin of the
        // direct call's `cParamLitUnion`.
        if tyLitUnionAliasIx(nodeTyIxOf(cpn.parType)) >= 0 { cpLit = true }
        if nodeTyIsNulLitUnion(cpn.parType) { cpLit = true }
      }
    }
    if cuNm != "" {
      if emitUnionBoxArg(body, cuNm, cargs[cai], fnIx) < 0 { return -1 }
    } else if cpKind == "i64" {
      if emitExprAsI64(body, cargs[cai], fnIx) < 0 { return -1 }
    } else if cpKind == "f64" {
      if emitExprAsF64(body, cargs[cai], fnIx) < 0 { return -1 }
    } else if cpKind == "f32" {
      if emitExprAsF32(body, cargs[cai], fnIx) < 0 { return -1 }
    } else if cpLit {
      const cluCtx = expCtxHere()
      cluCtx.litUnion = 1
      if emitExprExpect(body, cargs[cai], fnIx, cluCtx) < 0 { return -1 }
    } else if cpKind == "str" && exprIsLitAtom(cargs[cai], fnIx) {
      // The MIRROR of `cpLit`: a literal-union ATOM argument into a `string` parameter
      // widens to its member string, the edge the direct twin takes as `cParamStr`.
      if emitAtomToStr(body, cargs[cai], fnIx) < 0 { return -1 }
    } else {
      if emitExpr(body, cargs[cai], fnIx) < 0 { return -1 }
    }
    cai = cai + 1
  }
  pendingLitUnion = savedCapLU
  pendingNulLitUnion = savedCapNulLU
  // The TARGET's OWN interned `$fnsig` — the functype the target is actually declared
  // with (`emitFunctionSection` declares a sig-eligible function WITH that `$fnsig`), so
  // the `call_indirect` below passes the engine's signature check and its result is the
  // target's real result type. It must be resolved from the TARGET
  // and never from the arity alone: the all-i32 `fnSigIdxForArity` shape keys only
  // `(structref, i32 * ar) -> i32`, which is the right functype only when every
  // param AND the result are i32/boolean. Over a 48-cell param-kind × result-kind
  // census of a nested capturing function, keying by arity puts 8 cells (an f64 /
  // string / i32[] / struct param cast to an i32 param) into INVALID WASM and
  // rejects the 32 non-i32-RESULT cells, which lower fine; keying by the target
  // lands all 48. An all-i32 target's own key IS `i * ar > i`, so the two coincide
  // wherever the arity key was already correct — the target's key is never the
  // weaker answer. `fnSigIdxOfFn` is the same seam `.map`/`.filter` resolve a
  // named-function callback through.
  const csig = fnSigIdxOfFn(target)
  if csig < 0 {
    return emitFail(
      "emitProgram: captured call target has no interned signature",
    )
  }
  fbLocalGet(callRefSlot)
  fbStructGet(cloStructIdx, 1)      // the callee's wasm function index
  fbCallIndirect(csig, gFnTableIdx) // 0x11 <fnsig> <table>
  return 0
}

// The `__array_new__(n, fill)` / `__array_new_default__(n)` intrinsic lowering.
function emitArrayNewIntr(body: i32[], callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Ident {
      const anIsNew = callee.identName == "__array_new__"
      let anWant = 1
      if anIsNew { anWant = 2 }
      if c.callArgs.length != anWant {
        return emitFail(
          "emitProgram: " +
            callee.identName +
            " takes exactly " +
            i32ToStr(anWant) +
            " argument(s)",
        )
      }
      let anBack = aTypeIdx
      let anWrap = lTypeIdx
      // The element struct for a kind-3 (ref) fill — seeds `pendingStructIdx`
      // so the `{…}` fill emits as the list's declared element struct.
      let anElemStructIdx = -1
      const ank = arrNewIntrKind(callIx, fnIx)
      if ank == 1 {
        if !fa64Used {
          return emitFail(
            "emitProgram: __array_new__ f64 fill but f64 list types not collected",
          )
        }
        anBack = fa64TypeIdx
        anWrap = fl64TypeIdx
      } else if ank == 2 {
        // STRING fill → the string list (`array.new` of the shared string-ref
        // backing; a non-null string ref stores into the nullable slot directly).
        if !slUsed {
          return emitFail(
            "emitProgram: __array_new__ string fill but string list types not collected",
          )
        }
        anBack = mkArrIdx
        anWrap = mkListIdx
      } else if ank == 3 {
        // STRUCT fill → the ref list of the element struct (its interned slot).
        if !rlUsed {
          return emitFail(
            "emitProgram: __array_new__ struct fill but ref list types not collected",
          )
        }
        const anSlot = refListSlotOfExpr(callIx, fnIx)
        anBack = rlBackIdx[anSlot]
        anWrap = rlWrapIdx[anSlot]
        anElemStructIdx = rlElemStructRow(anSlot)
      } else {
        if !aUsed || !lUsed {
          return emitFail(
            "emitProgram: array intrinsic but list types not collected",
          )
        }
        if anIsNew {
          const anFill = c.callArgs[1]
          const anFillNode = P.nodes[anFill]
          // No i64[] / f32[] backing exists yet (only i32/f64/string/ref lists),
          // so an i64 / f32 fill would otherwise store into the i32 backing and
          // emit INVALID wasm — fail loudly instead (never wrong bytes).
          if exprIsI64(anFill, fnIx) {
            return emitFail(
              "emitProgram: __array_new__ i64 fill — i64-element arrays are not supported yet",
            )
          }
          if exprIsF32(anFill, fnIx) {
            return emitFail(
              "emitProgram: __array_new__ f32 fill — f32-element arrays are not supported yet",
            )
          }
          let anFillRef = false
          if anFillNode is ObjLit { anFillRef = true }
          if exprIsClosure(anFill, fnIx) { anFillRef = true }
          if exprArray(anFill, fnIx) { anFillRef = true }
          if exprRefArray(anFill, fnIx) { anFillRef = true }
          if exprStringArray(anFill, fnIx) { anFillRef = true }
          if exprMap(anFill, fnIx) { anFillRef = true }
          if anFillRef {
            // Remaining ref-fill long tail: closures / nested arrays / maps.
            return emitFail(
              "emitProgram: __array_new__ fill type not yet supported natively",
            )
          }
        }
      }
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      fbLocalSet(arrNewScratchBase)
      if anIsNew {
        pendingStructIdx = anElemStructIdx
        if emitExpr(body, c.callArgs[1], fnIx) < 0 { return -1 }
        pendingStructIdx = -1
        fbLocalGet(arrNewScratchBase)
        fbArrayNew(anBack)
      } else {
        fbLocalGet(arrNewScratchBase)
        fbArrayNewDefault(anBack)
      }
      fbLocalGet(arrNewScratchBase)
      fbLocalGet(arrNewScratchBase)
      fbStructNew(anWrap)
      return 0
    }
  }
  emitFail("emitProgram: emitArrayNewIntr expected an __array_new__ call")
}

// The `__array_copy__(dst, dstAt, src, srcAt, count)` intrinsic lowering.
function emitArrayCopyIntr(body: i32[], callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Ident {
      if c.callArgs.length != 5 {
        return emitFail(
          "emitProgram: __array_copy__ takes exactly five arguments",
        )
      }
      const acDstF64 = exprF64Array(c.callArgs[0], fnIx)
      const acSrcF64 = exprF64Array(c.callArgs[2], fnIx)
      if acDstF64 != acSrcF64 {
        return emitFail(
          "emitProgram: __array_copy__ dst and src must share one element type",
        )
      }
      let acBack = aTypeIdx
      let acWrap = lTypeIdx
      if acDstF64 {
        if !fa64Used {
          return emitFail(
            "emitProgram: __array_copy__ f64 lists but f64 list types not collected",
          )
        }
        acBack = fa64TypeIdx
        acWrap = fl64TypeIdx
      } else {
        if (
          exprRefArray(c.callArgs[0], fnIx) ||
          exprStringArray(c.callArgs[0], fnIx) ||
          exprRefArray(c.callArgs[2], fnIx) ||
          exprStringArray(c.callArgs[2], fnIx)
        ) {
          return emitFail(
            "emitProgram: __array_copy__ supports i32/boolean/f64 lists natively",
          )
        }
        if (
          !exprArray(c.callArgs[0], fnIx) ||
          !exprArray(c.callArgs[2], fnIx)
        ) {
          return emitFail(
            "emitProgram: __array_copy__ expects list (T[]) operands",
          )
        }
        if !aUsed || !lUsed {
          return emitFail(
            "emitProgram: array intrinsic but list types not collected",
          )
        }
      }
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      fbStructGet(acWrap, 0)
      if emitExpr(body, c.callArgs[1], fnIx) < 0 { return -1 }
      if emitExpr(body, c.callArgs[2], fnIx) < 0 { return -1 }
      fbStructGet(acWrap, 0)
      if emitExpr(body, c.callArgs[3], fnIx) < 0 { return -1 }
      if emitExpr(body, c.callArgs[4], fnIx) < 0 { return -1 }
      fbArrayCopy(acBack, acBack)
      return 0
    }
  }
  emitFail("emitProgram: emitArrayCopyIntr expected an __array_copy__ call")
}

// The fused map/list/struct nullish-coalescing lowering (`emitBinExprNode`'s `??` arm).
// Whether the `string | null` `??` node at `exprIx` lowers with a NULLABLE result — i.e.
// whether its value `if` declares `(ref null $aTypeIdx)` rather than `(ref $aTypeIdx)`.
//
// THE RESULT TYPE IS THE DEFAULT'S NULL-NESS, NOT A CONSTANT. A NON-null default collapses
// the whole read to `string` (the 2026-07-23 user-semantics ruling `coalesceStaysNullable`
// states for the map-value dual), so `(ref $aTypeIdx)`; a NULLABLE default leaves the result
// `string | null` and the block must say so, or the then-arm's legitimately-null value meets
// a non-null block type.
//
// IT ASKS `exprNullableString` OF THE `??` NODE ITSELF, which is the ONE place that already
// answers "does this expression yield a `string | null`" — and whose own `??` arm is exactly
// `nullable lhs && nullable default`. Reading the CHECKER's banked node type instead answers
// the same question for a source-spelled `??` and answers it WRONG for a synthesized one: a
// chained `p ?? q ?? r` re-associates to `p ?? (q ?? r)` through `mkBinary(…, -1)`, and that
// inner node has no banked type, so the chain declared a non-null block around a nullable
// default. The classifier is structural, so it covers both spellings by construction.
//
// The CONSUMER half matters too, and it is the whole read gate, not half of it: a consumer
// that takes the raw nullable ref (`nulStrReadStaysRaw` — a `!= null` test, OR a
// `string | null` BINDING / arg / return target) can be handed a nullable result; any other
// consumer gets the non-null block and the recovering arms, which is the shape every
// non-null-default program already had. Asking only `pendingRawNullRead` left the BINDING
// consumer (`const nv = p ?? q`) declaring a non-null block around a default arm that stayed
// raw — invalid wasm with `vl check` rc 0.
//
// ONE HOME FOR BOTH SPELLINGS. The re-evaluating (ident / struct-field lhs) arm and the
// stash-based CALL arm are the same lowering over the same rep, so they must declare the same
// block type; the call arm hard-coded the non-null one, which is how `f() ?? g()` stayed
// invalid after the ident arm was taught.
function coalesceNulStrStaysNullable(exprIx: i32, fnIx: i32) {
  nulStrReadStaysRaw() && exprNullableString(exprIx, fnIx)
}

// The context ONE ARM of a `string | null` `??` emits under: `raw` iff the arm's value may be
// left as `(ref null $aTypeIdx)`, which is exactly the block type the lowering just declared.
//
// BOTH HALVES OF THE READ GATE ARE OVERRIDDEN, not just `rawNullRead`. The arms otherwise
// inherit the ambient `pendingNulString` from the CONSUMER, and a nullable-string BINDING
// consumer with a NON-null default (`const nv: string | null = p ?? "d"`) then read its arms
// raw inside a `(ref $aTypeIdx)` block. `nulStrReadStaysRaw` is the disjunction, so an arm
// that means "recover" has to clear both flags and one that means "stay raw" has to set both.
function coalesceNulStrArmCtx(raw: boolean): ExpCtx {
  const c = expCtxHere()
  c.rawNullRead = raw
  c.nulString = raw
  return c
}

// The context the DEFAULT arm of a `K | null` `??` emits under: a member `StrLit` / `NumLit`
// default lowers as its interned ATOM ID (`litUnion`) and a bare `null` default as the spare
// sentinel `-1` (`nulLitUnion`) — the same pair the `v = "b"` / `v = null` assignment
// boundary seeds for the identical cell, because both are "produce this niche's i32".
function coalesceNulLitUnionArmCtx(): ExpCtx {
  const c = expCtxHere()
  c.nulLitUnion = true
  c.litUnion = 1
  return c
}

// The context the DEFAULT arm of a nullable-COLLECTION `??` emits under: a list LITERAL
// default builds THIS cell's backing (`listKind` / `listSlot`) and a bare `null` default the
// matching `ref.null` — every seed keyed off the LHS place, which IS the cell whose rep the
// block type declares. The seeds come from the same two homes the assignment boundary reads
// (`exprListCellBuildKind` / `exprListCellBuildSlot`), so a default literal can never build a
// backing the block type disagrees with.
//
// `nulList` is the i32-backed family's flag and `nulRefHeap` every other family's wrapper, so
// `nulCollWrapHeap` supplies the latter directly rather than re-deriving the family.
function coalesceNulCollArmCtx(lhsIx: i32, wrapIx: i32, fnIx: i32): ExpCtx {
  const c = expCtxHere()
  c.listKind = exprListCellBuildKind(lhsIx, fnIx)
  c.listSlot = exprListCellBuildSlot(lhsIx, fnIx)
  if exprNullableList(lhsIx, fnIx) {
    c.nulList = true
  } else {
    c.nulRefHeap = wrapIx
  }
  return c
}

// The `br_on_non_null` lowering EVERY nullable-REF-niche `??` shares — the nullable STRUCT
// (`S | null`) and the nullable COLLECTIONS (`i32[] | null`, `string[] | null`,
// `i32[][] | null`, …). `heapIx` is the cell's own heap type and `defCtx` the context the
// default arm emits under.
//
// ONE EVALUATION, NO STASH, AND IT SHORT-CIRCUITS. `br_on_non_null` consumes the one
// nullable ref and either branches out of the block carrying `(ref $heapIx)` or falls through
// to the default — so this shape needs NEITHER the re-eval the `boolean | null` / `K | null`
// sentinel arms use (their niche is an i32, which has no `br_on_null`) NOR the per-rep stash
// slot the `string | null` call arm reserves, and it covers every LHS source (ident, param,
// field, index, CALL) with one arm. The default is reached only when the LHS was null.
//
// THE RESULT TYPE IS THE DEFAULT'S NULL-NESS (`coalesceDefaultNullable`), not a constant: a
// NON-null default collapses the read to `(ref $heapIx)`, a NULLABLE one leaves it nullable
// and the block must say so, else the default arm's legitimately-null ref meets a non-null
// block type. `br_on_non_null` works under either — it branches with `(ref $heapIx)`, a
// subtype of both.
function emitCoalesceNulRef(
  body: i32[],
  e: BinExpr,
  heapIx: i32,
  defCtx: ExpCtx,
  fnIx: i32,
) {
  wU8(2) // 0x02 block
  if coalesceDefaultNullable(e.binRight, fnIx) {
    wU8(99) // blocktype: (ref null $heapIx) — the result stays nullable
  } else {
    wU8(100) // blocktype: (ref $heapIx) — the non-null result
  }
  wSLEB(heapIx)
  ctrlEnter()
  if emitExpr(body, e.binLeft, fnIx) < 0 {
    return -1 // the nullable ref, evaluated ONCE
  }
  wU8(214) // 0xd6 br_on_non_null
  wULEB(0) //   non-null → branch to the block end with the (ref $heapIx)
  if emitExprExpect(body, e.binRight, fnIx, defCtx) < 0 { return -1 }
  wU8(11) // 0x0b end
  ctrlLeave()
  0
}

function emitCoalesce(body: i32[], e: BinExpr, exprIx: i32, fnIx: i32) {
  // Unwrap a parenthesized LHS so `(m[k]) ?? d` / `(m.get(k)) ?? d` take the same fused
  // map-get path as the bare forms — parens must not change `??` semantics. `lhsIx` is the
  // unwrapped place every structural branch below dispatches on and emits; the generic niche
  // paths re-evaluate `e.binLeft` directly (and `emitExpr` / `exprNullableString` already peel
  // parens), so they are unaffected.
  const lhsIx = unwrapParen(e.binLeft)
  const lhs = P.nodes[lhsIx]
  // `a ?? b ?? d` parses LEFT-associative (`(a ?? b) ?? d`); `??` is
  // associative, so RE-ASSOCIATE to `a ?? (b ?? d)` — the inner coalesce
  // becomes the outer's default and each LHS is again a plain place the
  // single-step lowerings below handle (host: same chained-coalesce value).
  if lhs is BinExpr {
    if lhs.binOp == "??" {
      return emitExpr(
        body,
        mkBinary(
          "??",
          lhs.binLeft,
          mkBinary("??", lhs.binRight, e.binRight, -1),
          -1,
        ),
        fnIx,
      )
    }
  }
  // A NARROWING THAT EXCLUDES NULL MAKES THE DEFAULT DEAD: `x ?? d` IS `x` there, and the
  // read is the only lowering whose rep can be right. Every niche arm below evaluates its LHS
  // at the DECLARED nullable rep — the box for a value union, the sentinel i32 for
  // `boolean | null` / `K | null`, the nullable ref for the rest — while `emitIdentNode` reads
  // a narrowed binding at the ARM's rep, so the operand and the arm disagreed:
  // `if x != null { print(x ?? 0) }`, `if x is i32 { print(x ?? 0) }` and
  // `x = 5   print(x ?? 0)` were all `vl check`-clean modules the engine rejects with
  // `expected (ref null $type), found i32`.
  //
  // THE DEFAULT IS NOT EVALUATED, which is what `??` means — the rule EVERY arm below holds,
  // over every rep and every LHS source.
  if lhs is Ident {
    if narrowExcludesNull(lhs.identName) { return emitExpr(body, lhsIx, fnIx) }
  }
  if lhs is Index {
    if exprMap(lhs.idxArr, fnIx) {
      return emitMapGetOr(body, lhs.idxArr, lhs.idxIndex, e.binRight, fnIx)
    }
  }
  // The METHOD form `recv.get(k) ?? d` over a map receiver is the SAME fused
  // get-with-default as `recv[k] ?? d` — lower it identically. (The LIST `.get`
  // at ~6890 is a distinct struct-element get and is NOT a map; `exprMap` gates
  // this to map receivers only.)
  if lhs is Call {
    const lcallee = P.nodes[lhs.callFn]
    if lcallee is Member {
      if lcallee.memProp == "get" {
        if exprMap(lcallee.memObj, fnIx) {
          if lhs.callArgs.length != 1 {
            return emitFail("emitProgram: map .get takes exactly one argument")
          }
          return emitMapGetOr(
            body,
            lcallee.memObj,
            lhs.callArgs[0],
            e.binRight,
            fnIx,
          )
        }
        // `xs.get(i) ?? d` over a SCALAR-element list (i32 / boolean / f64) is
        // the FUSED checked read-with-default (B6) — one bounds compare.
        if (
          exprF64Array(lcallee.memObj, fnIx) ||
          exprArray(lcallee.memObj, fnIx)
        ) {
          return emitListGetOr(body, lhsIx, e.binRight, fnIx)
        }
      }
      // `xs.pop() ?? d` over a SCALAR-element list is the FUSED checked
      // pop-with-default: `len != 0` selects decrement-and-read or `d`.
      if lcallee.memProp == "pop" {
        if exprArray(lcallee.memObj, fnIx) {
          if (
            !exprRefArray(lcallee.memObj, fnIx) &&
            !exprStringArray(lcallee.memObj, fnIx) &&
            !exprF64Array(lcallee.memObj, fnIx)
          ) {
            return emitPopOr(body, lhsIx, e.binRight, fnIx)
          }
        }
      }
    }
  }
  // These generic niche `??` paths RE-EVALUATE `e.binLeft` (twice for the bool select,
  // and in the else arm for the string), so they apply only to an effect-free place —
  // an ident binding or a struct FIELD. A CALL lhs (`f() ?? d`) cannot be re-evaluated
  // and is handled by the stash-based call path in the `lhs is Call` block below.
  let lhsReEval = true
  if lhs is Call { lhsReEval = false }
  // `<e> ?? d` over a `boolean | null` NICHE (an ident binding, a `boolean | null` struct
  // FIELD (code 21), or a `(boolean | null)[]` element read) — the i32 cell holds 0/1 or the
  // sentinel 2 (`null`); take the default on 2. Generic in `e.binLeft`, so one arm covers
  // every re-readable place.
  //
  // A BRANCHING `if` OVER THE `0x7f` BLOCKTYPE, which is what `??` MEANS: the default is
  // evaluated ONLY when the LHS is null. `select` is one opcode but evaluates both of its
  // value operands unconditionally, so a side-effecting default ran on the PRESENT path —
  // the same lowering the `K | null` niche below, the `string | null` niche, the boxed
  // `i32 | null` union and every nullable-ref rep already use.
  if lhsReEval && exprNulBool(e.binLeft, fnIx) {
    if emitExpr(body, e.binLeft, fnIx) < 0 {
      return -1 // the niche i32
    }
    fbI32Const(2)
    fbI32Bin(70) // 0x46 i32.eq → x == 2 (null)
    fbIf(127)    // 0x04 if, 0x7f i32 blocktype
    ctrlEnter()
    if emitExpr(body, e.binRight, fnIx) < 0 {
      return -1 // d, reached only on the null path
    }
    fbElse() // 0x05 else — present → the 0/1 cell, re-read
    if emitExpr(body, e.binLeft, fnIx) < 0 { return -1 }
    fbEnd()  // 0x0b end
    ctrlLeave()
    return 0
  }
  // `<e> ?? d` over a `K | null` NICHE — an ident / param / global binding, a `K | null`
  // struct FIELD (code 30), a `(K | null)[]` element read, or a `K | null`-returning CALL.
  // The i32 cell holds an interned atom id (always >= 0) or the spare sentinel `-1` for
  // `null`, so the null test is the `-1` compare (`emitNulIsNullTest`'s litunion arm) and the
  // result is the same i32 either way: nullable and non-null share one valtype, so this rep
  // has NO NULLABILITY consumer half in the emit — the block type is unconditional `0x7f`. What
  // the CONSUMER does need is the ATOM IDENTITY of the result, and `coalesceLitUnionFits` is the
  // ONE claim this arm and both consumer classifiers (`exprIsLitAtom` / `exprNulLitUnion`) make:
  // it also decides whether the rep SURVIVES the default at all, so `k ?? "zz"` — whose join is
  // `string` — declines here and keeps its loud reject instead of putting a heap string in an i32
  // blocktype.
  //
  // A BRANCHING `if`, NOT A `select` — the same framing its `boolean | null` twin above uses,
  // and for the same reason. `select` is one opcode but evaluates BOTH value operands
  // unconditionally, so a side-effecting default would run on the PRESENT path; the
  // `if`/`else`/`end` framing over the `0x7f` blocktype costs THREE BYTES MORE PER SITE
  // (measured: 1351 vs 1342 over three `??` sites) and evaluates the default ONLY when the LHS
  // is null — the semantics `??` states, which no sentinel rep is exempt from.
  //
  // A CALL LHS cannot be re-read, so it is STASHED once in the i32 coalesce-call slot — the
  // same slot the `boolean | null` call arm uses, and reserved by the same
  // over-approximating scan (`exprHasCoalesceCall` reserves all three slots for ANY call-LHS
  // `??`), so no layout moves. Sound across nesting for the reason that arm gives: each `??`
  // sets-tests-uses within its own evaluation.
  if coalesceLitUnionFits(exprIx, fnIx) {
    if emitExpr(body, e.binLeft, fnIx) < 0 {
      return -1 // the niche i32, evaluated ONCE
    }
    if !lhsReEval {
      fbLocalSet(coalesceCallBoolSlot)
      fbLocalGet(coalesceCallBoolSlot)
    }
    fbI32Const(-1)
    fbI32Bin(70) // 0x46 i32.eq → x == -1 (null)
    fbIf(127)    // 0x04 if, 0x7f i32 blocktype
    ctrlEnter()
    if emitExprExpect(body, e.binRight, fnIx, coalesceNulLitUnionArmCtx()) < 0 {
      return -1 // d, as this niche's i32
    }
    fbElse() // 0x05 else — present → the atom id
    if lhsReEval {
      if emitExpr(body, e.binLeft, fnIx) < 0 { return -1 }
    } else {
      fbLocalGet(coalesceCallBoolSlot)
    }
    fbEnd() // 0x0b end
    ctrlLeave()
    return 0
  }
  // `<e> ?? d` over a nullable COLLECTION niche (`i32[] | null`, `string[] | null` /
  // `f64[] | null` / `i64[] | null` / `f32[] | null`, `i32[][] | null` / `S[] | null`): the
  // cell is a `(ref null $wrapper)`, so it takes the SAME `br_on_non_null` lowering as the
  // nullable STRUCT below — one evaluation, no stash, and the default only on the null path.
  // Placed before the sentinel-free ref paths for the same reason `emitNulIsNullTest` orders
  // its niches: the wrapper heap type is what distinguishes the families.
  const cnclw = nulCollWrapHeap(e.binLeft, fnIx)
  if cnclw >= 0 {
    return emitCoalesceNulRef(
      body,
      e,
      cnclw,
      coalesceNulCollArmCtx(e.binLeft, cnclw, fnIx),
      fnIx,
    )
  }
  // `<e> ?? d` over a `string | null` NICHE (an ident binding OR a `string | null`
  // struct FIELD, code 20): the nullable raw-array ref — a VALUE-typed `if` on
  // `ref.is_null` (the else arm reads `e` as a non-null value). `pendingRawNullRead`
  // keeps the test read raw. Generic in `e.binLeft`, so it covers a member field too.
  if lhsReEval && exprNullableString(e.binLeft, fnIx) {
    const rawCtx = expCtxHere()
    rawCtx.rawNullRead = true
    // the raw nullable ref
    if emitExprExpect(body, e.binLeft, fnIx, rawCtx) < 0 { return -1 }
    wU8(209) // 0xd1 ref.is_null → 1 if null
    wU8(4)   // 0x04 if
    const coNul = coalesceNulStrStaysNullable(exprIx, fnIx)
    if coNul {
      wU8(99) // blocktype: (ref null $aTypeIdx) — the result stays nullable
    } else {
      wU8(100) // blocktype: (ref $aTypeIdx) — non-null string result
    }
    wSLEB(aTypeIdx)
    ctrlEnter()
    // EACH ARM READS UNDER THE BLOCK TYPE THIS LOWERING JUST DECLARED, EXPLICITLY
    // (`coalesceNulStrArmCtx`). The arm reads otherwise run under whatever the CONSUMER
    // seeded, so a raw consumer over a NON-null default left a `(ref null $array)` in a
    // `(ref $array)` block — the declared result type and the arm bytes disagreeing, which is
    // invalid wasm rather than a wrong answer. The DEFAULT arm follows the block (raw only
    // when the result is nullable); the LHS arm is non-null on every path, since it is
    // reached only when `ref.is_null` said no, and a `(ref $a)` fits a nullable block too.
    if emitExprExpect(body, e.binRight, fnIx, coalesceNulStrArmCtx(coNul)) < 0 {
      return -1 // d (a string, nullable only when the block is)
    }
    fbElse() // 0x05 else
    if emitExprExpect(body, e.binLeft, fnIx, coalesceNulStrArmCtx(false)) < 0 {
      return -1 // e recovered non-null
    }
    fbEnd() // 0x0b end
    ctrlLeave()
    return 0
  }
  // `x ?? d` over a binding seeded by a BOOLEAN-list `.pop()`: the i32 cell holds 0/1 or the
  // niche sentinel 2 (`null`) — the same branching `if` the `boolean | null` arm above uses,
  // so the default runs only on the null path here too.
  if lhs is Ident {
    if identNullableBoolPop(lhs.identName, fnIx) {
      if emitExpr(body, e.binLeft, fnIx) < 0 {
        return -1 // the niche i32
      }
      fbI32Const(2)
      fbI32Bin(70) // 0x46 i32.eq → x == 2 (null)
      fbIf(127)    // 0x04 if, 0x7f i32 blocktype
      ctrlEnter()
      if emitExpr(body, e.binRight, fnIx) < 0 {
        return -1 // d, reached only on the null path
      }
      fbElse() // 0x05 else — present → the 0/1 cell, re-read
      if emitExpr(body, e.binLeft, fnIx) < 0 { return -1 }
      fbEnd()  // 0x0b end
      ctrlLeave()
      return 0
    }
    // `x ?? d` over a BOXED value union containing `null` (`i32 | null`):
    // the value-level dual of the null guard — read the box tag; the null
    // tag selects the default, anything else unboxes the SINGLE remaining
    // scalar atom (the host's `??` result is the non-null base type). The
    // receiver is a pure name, re-read in the non-null arm. Scalar atoms
    // only (the value-typed `if` blocktype carries the unboxed rep).
    const cunm = unionNameOfIdentSid(sidOfNode(lhsIx), fnIx)
    if cunm != "" {
      // D-VALUNION: the DECLARED union's set. (The narrowing table's id below answers
      // a different question — the set SURVIVING the narrow — so both are resolved.)
      // D-VALKIND + D-SETONCE: master resolved this set TWICE — once for the
      // value-union gate and once inside `unionHasAtomTy`'s name-keyed row lookup.
      // One resolution now feeds both, and the null test is a KIND test over the
      // banked codes.
      const csid = msSetOfText(cunm)
      if (
        isValueUnionOfSet(csid, cunm) &&
        unionHasAtomK(csid, cunm, "null", nullValKind())
      ) {
        // D-UNION-ATOM-KIND: the residual member's banked ABI code (see
        // `unionResidualSoloKindOfSet`); the rendered residual is re-parsed only where the
        // set pool declines — a narrowed subset spelling it never interned.
        //
        // D-SETID: the set arrives as the narrowing table's BANKED (row, mask) id
        // (`currentNarrowSetIdOf`, the set-ADT reading of the `currentNarrowSetOf` above), so
        // the whole path from narrowing table to ABI code never renders a set and never
        // resolves a rendering back. Its un-narrowed leg IS `msSetOfText(unionNameOfIdent(…))`
        // — exactly what this site resolved before; its narrowed leg reads the id the
        // complement push banked instead of re-interning the survivor spelling.
        let cak = unionResidualSoloKindOfSet(
          currentNarrowSetIdOf(lhs.identName, fnIx),
        )
        if cak == -2 {
          // D-RESIDUE: the rendered residual is built ONLY here, where the bank
          // declined — master resolved the narrowing set, subtracted `null` and
          // rendered the survivor on every `??`, then used the rendering nowhere else.
          cak = valueAtomKind(
            removeAtomFromSet(
              currentNarrowSetOf(lhs.identName, fnIx),
              "null",
            ),
          )
        }
        if cak >= 0 && cak != nullValKind() {
          if cak == 2 {
            return emitFail(
              "emitProgram: `??` over a string|null union is not supported yet",
            )
          }
          // A NULLABLE default keeps the result boxed — see `coalesceDefaultNullable`.
          // Both arms are already `(ref $uBoxIdx)`: the default is a box, and the LHS
          // re-read is the same box with a non-null tag, so neither arm unboxes and the
          // block type is the box itself. (The lowering shape is otherwise identical, so
          // the tag test above is shared.)
          if coalesceDefaultNullable(e.binRight, fnIx) {
            if emitExpr(body, e.binLeft, fnIx) < 0 {
              return -1 // the box
            }
            fbStructGet(uBoxIdx, 0) // field 0: tag
            fbI32Const(nullBoxTag())
            fbI32Bin(70)            // 0x46 i32.eq → null?
            fbIfRef(uBoxIdx)        // 0x04 if, (ref $uBoxIdx) blocktype
            ctrlEnter()
            if emitExpr(body, e.binRight, fnIx) < 0 {
              return -1 // d, its own box
            }
            fbElse() // 0x05 else — present → the LHS box, re-read
            if emitExpr(body, e.binLeft, fnIx) < 0 { return -1 }
            fbEnd()  // 0x0b end
            ctrlLeave()
            return 0
          }
          if emitExpr(body, e.binLeft, fnIx) < 0 {
            return -1 // the box
          }
          fbStructGet(uBoxIdx, 0)       // field 0: tag
          fbI32Const(nullBoxTag())
          fbI32Bin(70)                  // 0x46 i32.eq → null?
          fbIf(valBlockTypeOfKind(cak)) // 0x04 if, value blocktype
          ctrlEnter()
          if emitExprAsKind(body, e.binRight, cak, fnIx) < 0 { return -1 }
          fbElse()                      // 0x05 else — present → unbox
          // The banked code `cak` travels INTO the unbox: pre-#1128 this site rendered
          // the residual set for the parameter and the callee parsed the rendering
          // back into `cak`.
          if emitValueUnionUnboxRead(body, lhs.identName, cak, fnIx) < 0 {
            return -1
          }
          fbEnd() // 0x0b end
          ctrlLeave()
          return 0
        }
      }
    }
  }
  // `f(x) ?? d` over a CALL returning a value union with `null` (`i32 | null`,
  // …): a call CANNOT be re-evaluated (effects + cost) the way the ident/field
  // paths above re-read their place, so STASH the box once in the coalesce-call
  // slot, then test the tag and unbox off that single evaluation. Scalar atoms
  // only (the value-typed `if` blocktype); a `string | null` call result is
  // deferred like the ident/field forms. One slot is sound across nesting: each
  // `??` sets-tests-uses within its own evaluation, and the null arm never reads
  // the box again (so a nested call-LHS `??` in the default may reuse the slot).
  if lhs is Call {
    const kunm = unionNameOfExpr(e.binLeft, fnIx)
    if kunm != "" {
      // D-VALUNION + D-SETONCE: one resolution feeds the value-union gate AND the
      // residual code below, which master resolved a second time inside
      // `unionResidualSoloKindOfSet`.
      const ksid = msSetOfText(kunm)
      if (
        isValueUnionOfSet(ksid, kunm) &&
        unionHasAtomK(ksid, kunm, "null", nullValKind())
      ) {
        // D-UNION-ATOM-KIND — see `unionResidualSoloKindOfSet`.
        let kak = unionResidualSoloKindOfSet(ksid)
        if kak == -2 {
          kak = valueAtomKind(removeAtomFromSet(kunm, "null")) // D-RESIDUE
        }
        if kak >= 0 && kak != nullValKind() {
          if kak == 2 {
            return emitFail(
              "emitProgram: `??` over a string|null call result is not supported yet",
            )
          }
          if emitExpr(body, e.binLeft, fnIx) < 0 {
            return -1 // the box, evaluated ONCE
          }
          fbLocalSet(coalesceCallSlot)
          // A NULLABLE default keeps the result boxed — the SAME decision the
          // re-evaluating ident arm makes (`coalesceDefaultNullable`), taken here too
          // because both arms are one lowering over one rep and must declare the same
          // block type. Neither arm unboxes: the default is a box, and the stash already
          // holds the LHS box.
          if coalesceDefaultNullable(e.binRight, fnIx) {
            fbLocalGet(coalesceCallSlot)
            fbStructGet(uBoxIdx, 0) // field 0: tag
            fbI32Const(nullBoxTag())
            fbI32Bin(70)            // 0x46 i32.eq → null?
            fbIfRef(uBoxIdx)        // 0x04 if, (ref $uBoxIdx) blocktype
            ctrlEnter()
            if emitExpr(body, e.binRight, fnIx) < 0 {
              return -1 // d, its own box
            }
            fbElse() // 0x05 else — present → the stashed box
            fbLocalGet(coalesceCallSlot)
            fbEnd()  // 0x0b end
            ctrlLeave()
            return 0
          }
          fbLocalGet(coalesceCallSlot)
          fbStructGet(uBoxIdx, 0)       // field 0: tag
          fbI32Const(nullBoxTag())
          fbI32Bin(70)                  // 0x46 i32.eq → null?
          fbIf(valBlockTypeOfKind(kak)) // 0x04 if, value blocktype
          ctrlEnter()
          if emitExprAsKind(body, e.binRight, kak, fnIx) < 0 { return -1 }
          fbElse()                      // 0x05 else — present → unbox the stash
          fbLocalGet(coalesceCallSlot)
          fbStructGet(uBoxIdx, 1)       // field 1: value (anyref)
          const kvb = vbHeapIdxOfKind(kak)
          if kvb < 0 {
            return emitFail("emitProgram: union call atom has no value box")
          }
          fbRefCast(kvb)
          fbStructGet(kvb, 0) // the scalar payload
          fbEnd()             // 0x0b end
          ctrlLeave()
          return 0
        }
      }
    }
    // `f() ?? d` over a CALL returning `boolean | null` (the i32 niche): a call cannot be
    // re-read, so STASH the single evaluation in the bool slot, then branch on the sentinel
    // 2 — the call analogue of the `boolean | null` ident path, and the default runs only on
    // the null path for the same reason.
    if exprNulBool(e.binLeft, fnIx) {
      if emitExpr(body, e.binLeft, fnIx) < 0 {
        return -1 // the niche i32, evaluated ONCE
      }
      fbLocalSet(coalesceCallBoolSlot)
      fbLocalGet(coalesceCallBoolSlot)
      fbI32Const(2)
      fbI32Bin(70) // 0x46 i32.eq → x == 2 (null)
      fbIf(127)    // 0x04 if, 0x7f i32 blocktype
      ctrlEnter()
      if emitExpr(body, e.binRight, fnIx) < 0 {
        return -1 // d, reached only on the null path
      }
      fbElse() // 0x05 else — present → the stashed 0/1 cell
      fbLocalGet(coalesceCallBoolSlot)
      fbEnd()  // 0x0b end
      ctrlLeave()
      return 0
    }
    // `f() ?? d` over a CALL returning `string | null` (kind 16): STASH the nullable
    // ref once (raw, via `pendingRawNullRead`), then a value-typed `if` on
    // `ref.is_null` selects `d` or the recovered non-null string — the call analogue
    // of the `string | null` ident path.
    if exprNullableString(e.binLeft, fnIx) {
      const rawCCtx = expCtxHere()
      rawCCtx.rawNullRead = true
      // the raw nullable ref, ONCE
      if emitExprExpect(body, e.binLeft, fnIx, rawCCtx) < 0 { return -1 }
      fbLocalSet(coalesceCallStrSlot)
      fbLocalGet(coalesceCallStrSlot)
      wU8(209) // 0xd1 ref.is_null → 1 if null
      wU8(4)   // 0x04 if
      // The SAME result-nullability question the re-evaluating arm asks — see
      // `coalesceNulStrStaysNullable`. A nullable default keeps the result nullable here too.
      const coNulC = coalesceNulStrStaysNullable(exprIx, fnIx)
      if coNulC {
        wU8(99) // blocktype: (ref null $aTypeIdx) — the result stays nullable
      } else {
        wU8(100) // blocktype: (ref $aTypeIdx) — non-null string result
      }
      wSLEB(aTypeIdx)
      ctrlEnter()
      // Each arm reads UNDER the block type just declared (the re-evaluating arm's
      // discipline): the default is raw only when the result is nullable, and the stashed
      // LHS is non-null on every path that reaches the else (`ref.is_null` said no).
      if (
        emitExprExpect(body, e.binRight, fnIx, coalesceNulStrArmCtx(coNulC)) <
        0
      ) {
        return -1 // d (a string, nullable only when the block is)
      }
      fbElse()         // 0x05 else
      fbLocalGet(coalesceCallStrSlot)
      fbRefAsNonNull() // 0xd4 recover the non-null string the slot holds
      fbEnd()          // 0x0b end
      ctrlLeave()
      return 0
    }
  }
  // `o.v ?? d` over a VALUE-UNION struct field (`v: i32 | null`, code 16):
  // the field-read dual of the boxed-union name path above — read the box
  // off the field, test its tag for `null`, and select the default or the
  // unboxed single remaining scalar atom. The receiver re-reads in the
  // non-null arm (a name/field chain, like the nullable-struct `?.` path).
  if lhs is Member {
    const msi = structIndexOfExpr(lhs.memObj, fnIx)
    if msi >= 0 {
      const mfi = sFieldIndex(msi, lhs.memProp)
      if mfi >= 0 {
        if sFieldTypeAt(msi, mfi) == 16 {
          const munm = sFieldElemNameAt(msi, mfi)
          // D-VALUNION + D-SETONCE — see the call arm above.
          const msid = msSetOfText(munm)
          if (
            isValueUnionOfSet(msid, munm) &&
            unionHasAtomK(msid, munm, "null", nullValKind())
          ) {
            // D-UNION-ATOM-KIND — see `unionResidualSoloKindOfSet`.
            let mak = unionResidualSoloKindOfSet(msid)
            if mak == -2 {
              mak = valueAtomKind(removeAtomFromSet(munm, "null")) // D-RESIDUE
            }
            if mak >= 0 && mak != nullValKind() {
              if mak == 2 {
                return emitFail(
                  "emitProgram: `??` over a string|null union field is not supported yet",
                )
              }
              // A NULLABLE default keeps the result boxed — the SAME decision the ident
              // and call arms make (`coalesceDefaultNullable`); the else arm re-reads the
              // field's own box rather than unboxing it.
              if coalesceDefaultNullable(e.binRight, fnIx) {
                if emitExpr(body, lhs.memObj, fnIx) < 0 { return -1 }
                fbStructGet(sHeapIdx[msi], mfi) // the union box
                fbStructGet(uBoxIdx, 0)         // field 0: tag
                fbI32Const(nullBoxTag())
                fbI32Bin(70)                    // 0x46 i32.eq → null?
                fbIfRef(uBoxIdx)                // 0x04 if, (ref $uBoxIdx) blocktype
                ctrlEnter()
                if emitExpr(body, e.binRight, fnIx) < 0 {
                  return -1 // d, its own box
                }
                fbElse() // 0x05 else — present → re-read the field
                if emitExpr(body, lhs.memObj, fnIx) < 0 { return -1 }
                fbStructGet(sHeapIdx[msi], mfi)
                fbEnd()  // 0x0b end
                ctrlLeave()
                return 0
              }
              if emitExpr(body, lhs.memObj, fnIx) < 0 { return -1 }
              fbStructGet(sHeapIdx[msi], mfi) // the union box
              fbStructGet(uBoxIdx, 0)         // field 0: tag
              fbI32Const(nullBoxTag())
              fbI32Bin(70)                    // 0x46 i32.eq → null?
              fbIf(valBlockTypeOfKind(mak))   // 0x04 if, value blocktype
              ctrlEnter()
              if emitExprAsKind(body, e.binRight, mak, fnIx) < 0 { return -1 }
              fbElse()                        // 0x05 else — present → unbox
              if emitExpr(body, lhs.memObj, fnIx) < 0 { return -1 }
              fbStructGet(sHeapIdx[msi], mfi)
              fbStructGet(uBoxIdx, 1)         // field 1: value (anyref)
              const mvb = vbHeapIdxOfKind(mak)
              if mvb < 0 {
                return emitFail(
                  "emitProgram: union field atom has no value box",
                )
              }
              fbRefCast(mvb)
              fbStructGet(mvb, 0) // the scalar payload
              fbEnd()             // 0x0b end
              ctrlLeave()
              return 0
            }
          }
        }
      }
    }
  }
  // The null-safe field read `m[k]?.f ?? d` over a STRUCT-VALUED map is the
  // FUSED form: probe; on a hit read the field off the (non-null) value
  // struct, else push the default. A live entry's value slot is never null,
  // so the `?.` null test coincides with the probe's hit test — no
  // intermediate nullable materializes. Scalar (i32/boolean) fields only (a
  // value-typed `if` blocktype carries them; ref fields would need an
  // interned blocktype functype).
  if lhs is OptMember {
    const omInner = P.nodes[lhs.omObj]
    if omInner is Index {
      if exprMap(omInner.idxArr, fnIx) {
        const omSl = mapShapeOfExpr(omInner.idxArr, fnIx)
        if omSl >= 0 {
          if mvValKind[omSl] != 1 {
            return emitFail("emitProgram: `?.` needs a struct-valued map")
          }
          const omSi = mvValStructIdx[omSl]
          const omFi = sFieldIndex(omSi, lhs.omProp)
          if omFi < 0 {
            return emitFail(
              "emitProgram: `?.` field is not on the map's value struct",
            )
          }
          if sFieldTypeAt(omSi, omFi) != 0 {
            return emitFail(
              "emitProgram: `?.` over a map read supports only i32/boolean fields",
            )
          }
          if emitMapPrep(body, omInner.idxArr, omInner.idxIndex, fnIx) < 0 {
            return -1
          }
          pushMapScr(body, 5)               // entry
          fbIf(127)                         // if (entry != 0 → hit), i32 blocktype
          pushMapVals(body)
          fbStructGet(cmValsWrap(), 0)      // vals backing
          pushMapScr(body, 5)               // entry
          fbI32Const(1)
          fbI32Bin(107)                     // i32.sub (entry - 1)
          fbArrayGet(cmValsBack())          // (ref null <value struct>)
          fbRefAsNonNull()                  // a live entry's value is non-null
          fbStructGet(sHeapIdx[omSi], omFi) // .f
          fbElse()                          // else
          if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
          fbEnd()                           // end (if)
          return 0
        }
      }
    }
    // `p?.f ?? d` over a NULLABLE-STRUCT receiver (`p: S | null`, OR a nullable-struct
    // FIELD read `n.next`): null → the default, else the field read off the (non-null)
    // struct. The receiver is a re-readable PLACE (a name, or a member chain of names —
    // an effect-free `struct.get`), re-read in the non-null branch. Scalar fields only
    // (the value-typed `if` blocktype carries them).
    if optRecvReReadable(lhs.omObj) {
      if exprNullableStruct(lhs.omObj, fnIx) {
        const nsi = structIndexOfExpr(lhs.omObj, fnIx)
        if nsi >= 0 {
          const nfi = sFieldIndex(nsi, lhs.omProp)
          if nfi < 0 {
            return emitFail("emitProgram: `?.` field is not on the struct")
          }
          if sFieldTypeAt(nsi, nfi) != 0 {
            return emitFail(
              "emitProgram: `?.` over a nullable struct supports only i32/boolean fields",
            )
          }
          if emitExpr(body, lhs.omObj, fnIx) < 0 { return -1 }
          wU8(209)  // 0xd1 ref.is_null
          fbIf(127) // 0x04 if, 0x7f i32 blocktype — null → default
          ctrlEnter()
          if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
          fbElse()  // 0x05 else — present → the field
          if emitExpr(body, lhs.omObj, fnIx) < 0 { return -1 }
          fbStructGet(sHeapIdx[nsi], nfi)
          fbEnd()   // 0x0b end
          ctrlLeave()
          return 0
        }
      }
    }
    // A NESTED optional chain `o?.inner?.v ?? d` (niche nullable links): any
    // null link selects the default; otherwise the chain reads through
    // non-null refs (each `S|null` link recovers `ref.as_non_null`). The
    // links are effect-free places, re-evaluated in the value arm. Scalar
    // (i32/boolean) leaf fields only (the value-typed `if` blocktype).
    const omDeep = P.nodes[unwrapParen(lhs.omObj)]
    if omDeep is OptMember {
      const dsi = optChainStructIdxOf(lhs.omObj, fnIx)
      if dsi >= 0 {
        const dfi = sFieldIndex(dsi, lhs.omProp)
        if dfi >= 0 {
          if sFieldTypeAt(dsi, dfi) != 0 {
            return emitFail(
              "emitProgram: `?.` chain supports only i32/boolean leaf fields",
            )
          }
          if emitOptChainIsNull(body, lhs.omObj, fnIx) < 0 { return -1 }
          fbIf(127) // 0x04 if, i32 result — a null link → default
          ctrlEnter()
          if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
          fbElse()  // 0x05 else — every link present → the leaf
          if emitOptChainValue(body, lhs.omObj, fnIx) < 0 { return -1 }
          fbStructGet(sHeapIdx[dsi], dfi)
          fbEnd()   // 0x0b end
          ctrlLeave()
          return 0
        }
      }
    }
    // `xs.get(i)?.f ?? d` over a STRUCT-element ref list is the FUSED form:
    // one bounds compare; in range read the field off the (non-null) element,
    // else the default. A live in-range element is never null (pushes store
    // non-null), so the `?.` null test coincides with the bounds test —
    // mirroring the map `m[k]?.f ?? d` path above. Scalar fields only.
    const omGet = P.nodes[unwrapParen(lhs.omObj)]
    if omGet is Call {
      const gCallee = P.nodes[omGet.callFn]
      if gCallee is Member {
        if gCallee.memProp == "get" {
          const gSi = structListPopGetElem(unwrapParen(lhs.omObj), fnIx)
          if gSi >= 0 && rlUsed {
            if omGet.callArgs.length != 1 {
              return emitFail("emitProgram: .get takes exactly one argument")
            }
            const gFi = sFieldIndex(gSi, lhs.omProp)
            if gFi < 0 {
              return emitFail(
                "emitProgram: `?.` field is not on the list's element struct",
              )
            }
            if sFieldTypeAt(gSi, gFi) != 0 {
              return emitFail(
                "emitProgram: `?.` over a list .get supports only i32/boolean fields",
              )
            }
            const gRecvN = P.nodes[unwrapParen(gCallee.memObj)]
            let gOkRecv = false
            if gRecvN is Ident { gOkRecv = true }
            if !gOkRecv {
              return emitFail(
                "emitProgram: .get receiver must be a named list binding",
              )
            }
            const gIdxN = P.nodes[unwrapParen(omGet.callArgs[0])]
            let gOkIdx = false
            if gIdxN is NumLit { gOkIdx = true }
            if gIdxN is Ident { gOkIdx = true }
            if !gOkIdx {
              return emitFail(
                "emitProgram: .get index must be a literal or a name",
              )
            }
            const gSlot = refListSlotOfExpr(gCallee.memObj, fnIx)
            // cond: idx u< len
            if emitExpr(body, omGet.callArgs[0], fnIx) < 0 { return -1 }
            if emitExpr(body, gCallee.memObj, fnIx) < 0 { return -1 }
            fbStructGet(rlWrapIdx[gSlot], 1) // field 1: len
            fbI32Bin(73)                     // 0x49 i32.lt_u
            fbIf(127)                        // 0x04 if, 0x7f i32 result blocktype
            ctrlEnter()
            if emitExpr(body, gCallee.memObj, fnIx) < 0 { return -1 }
            fbStructGet(rlWrapIdx[gSlot], 0) // field 0: backing
            if emitExpr(body, omGet.callArgs[0], fnIx) < 0 { return -1 }
            fbArrayGet(rlBackIdx[gSlot])     // → (ref null $elem)
            fbRefAsNonNull()                 // a live in-range element is non-null
            fbStructGet(sHeapIdx[gSi], gFi)  // .f
            fbElse()                         // 0x05 else
            if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
            fbEnd()                          // 0x0b end
            ctrlLeave()
            return 0
          }
        }
      }
    }
  }
  // GENERIC nullable-STRUCT `??`: a `S | null` value — an ident / param binding, a struct FIELD,
  // OR a closure / factory CALL (`arr[i](x) ?? d`) — coalesced with a struct default. Evaluated
  // ONCE: `br_on_non_null` keeps the non-null struct or falls through to the default, so it needs
  // NEITHER a re-eval (the ident / field forms) NOR a per-struct stash slot (the call form) — one
  // path for every source, unlike the `string | null` paths split into re-eval + stash. The
  // closing piece of nullable-struct closures (#655/#656): `structIndexOfExpr` resolves the inner
  // struct (incl. an indexed closure-array / factory call via the checker-type fallback) for the
  // block's result type. (A `string | null` LHS is handled by its own paths above.)
  if exprNullableStruct(e.binLeft, fnIx) {
    const csi = structIndexOfExpr(e.binLeft, fnIx)
    if csi >= 0 && csi < sHeapIdx.length {
      // The default arm seeds an ObjLit default to THIS struct; the block type and the
      // one-evaluation shape are the nullable-ref-niche lowering the collections share.
      const defCtx = expCtxHere()
      defCtx.structIdx = csi
      return emitCoalesceNulRef(body, e, sHeapIdx[csi], defCtx, fnIx)
    }
  }
  return emitFail("emitProgram: `??` is only supported on a map index get")
}
