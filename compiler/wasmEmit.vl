// Fill the capture cache (`capStartTbl` / `capCountTbl` / `capNamesFlat` in `emit_state`)
// with every lifted function's capture list — one walk per function instead of an
// O(body) recompute per query. Call exactly once per program, after the last
// arena-mutating pass; `emitProgram` clears the cache up front so earlier phases walk directly.
export function capCacheBuild() {
  capStartTbl = []
  capCountTbl = []
  capNamesFlat = []
  let fe = 0
  while fe < fnStmts.length {
    const caps = capComputeNamesOf(fe)
    capStartTbl.push(capNamesFlat.length)
    capCountTbl.push(caps.length)
    let ci = 0
    while ci < caps.length {
      capNamesFlat.push(caps[ci])
      ci = ci + 1
    }
    fe = fe + 1
  }
  capCacheOn = true
  0
}

// The value-column wrapper struct for map slot `slot`: a scalar mv kind (f64/i64/f32)
// resolves to that scalar's distinct-backing list wrapper, a negative slot to the base
// i32 wrapper, and anything else to its interned ref-list wrapper (`rlWrapIdx`).
export function mvValsWrapOf(slot: i32) {
  if slot < 0 { return lTypeIdx }
  if mvValKind[slot] == 3 { return mkListIdx }
  if mvValKind[slot] == 11 { return fl64TypeIdx }
  if mvValKind[slot] == 13 { return fl32TypeIdx }
  if mvValKind[slot] == 10 { return il64TypeIdx }
  if mvRlSlot[slot] < 0 || mvRlSlot[slot] >= rlWrapIdx.length {
    emitFail("emitProgram: map value slot has no resolved vals wrapper")
    return 0
  }
  rlWrapIdx[mvRlSlot[slot]]
}

// The scalar element kind (`"f64"`/`"i64"`/`"f32"`) of an mv map-value slot whose value
// is a non-i32 scalar, else null (a ref value rides the nullable valStash instead). The
// chokepoint the map get/set/push consult to branch scalar-store vs ref-store.
function mvScalarValKind(slot: i32): VKind | null {
  if slot < 0 { return null }
  if mvValKind[slot] == 11 { return "f64" }
  if mvValKind[slot] == 10 { return "i64" }
  if mvValKind[slot] == 13 { return "f32" }
  return null
}

// The wrapper struct heap type for a scalar element kind.
function scalarListWrap(elemKind: VKind) {
  if elemKind == "u8list" { return bl8TypeIdx }
  if elemKind == "f64" { return fl64TypeIdx }
  if elemKind == "i64" { return il64TypeIdx }
  if elemKind == "f32" { return fl32TypeIdx }
  lTypeIdx
}

// The backing `(array (mut <elem>))` heap type for a scalar element kind.
function scalarListBack(elemKind: VKind) {
  if elemKind == "u8list" { return ba8TypeIdx }
  if elemKind == "f64" { return fa64TypeIdx }
  if elemKind == "i64" { return ia64TypeIdx }
  if elemKind == "f32" { return fa32TypeIdx }
  aTypeIdx
}

// The `array.get` result blocktype byte for a scalar element kind (i32 `0x7f`, f64
// `0x7c`, i64 `0x7e`) — the value-typed-`if` rep a fused `?? d` read joins on. A `u8[]`
// element reads as i32 (`array.get_u` widens), so it shares the plain i32 blocktype.
function scalarListBlocktype(elemKind: VKind) {
  if elemKind == "u8list" { return 127 }
  if elemKind == "f64" { return 124 }
  if elemKind == "i64" { return 126 }
  if elemKind == "f32" { return 125 }
  127
}

// Whether the module-global list types for a scalar element kind are collected — the
// loud-fail guard every list op shares.
function scalarListUsed(elemKind: VKind) {
  if elemKind == "u8list" { return ba8Used }
  if elemKind == "f64" { return fa64Used }
  if elemKind == "i64" { return ia64Used }
  if elemKind == "f32" { return fa32Used }
  lUsed
}

// Emit `exprIx` coerced to a scalar element kind's value rep — the f64/i64 widen of a
// narrower literal/`i32` so a list element / `?? d` default matches the backing type.
// A `u8[]` value is an ordinary i32 (WasmGC has no `u8`; the truncation to one byte is
// `array.set`'s masked write, not this call's), so it passes through like plain i32.
function emitScalarValue(body: i32[], exprIx: i32, fnIx: i32, elemKind: VKind) {
  if elemKind == "f64" { return emitExprAsF64(body, exprIx, fnIx) }
  if elemKind == "i64" { return emitExprAsI64(body, exprIx, fnIx) }
  if elemKind == "f32" { return emitExprAsF32(body, exprIx, fnIx) }
  emitExpr(body, exprIx, fnIx)
}

// The `pushFieldStorage` slot argument for struct `si`'s field `fi` — the one place the three
// tables a field code can name are chosen between (nested-struct row, map shape, ref-list
// row). `emitTypeSection`, the supertype prefix test and the object-literal order stash
// (D1510) all read it, so the declared slot and the stash local cannot disagree.
export function sFieldStorageSlot(si: i32, fi: i32): i32 {
  const code = sFieldTypeAt(si, fi)
  if code == 15 { return sFieldTgtStructIdx(si, fi) }
  if code == 19 || code == 29 { return sFieldMapShape(si, fi) }
  sFieldRefSlot(si, fi)
}

// The null value of an omitted nullable field (`si`/`fi`, field code `scode`) in a
// struct literal: `ref.null` of the field's own backing for the ref codes, the i32
// sentinel for `boolean | null` (2) or `K | null` (-1, since member ids are >= 0), or
// the null-tagged box for a union field with a `null` member. -1 when not nullable.
function emitOmittedFieldNull(_body: i32[], si: i32, fi: i32, scode: i32) {
  if scode == 20 {
    fbRefNull(sTypeIdx)
    return 0
  }
  if scode == 21 {
    fbI32Const(2)
    return 0
  }
  if scode == 30 {
    fbI32Const(0 - 1)
    return 0
  }
  if scode == 15 {
    const tgt = sFieldTgtStructIdx(si, fi)
    if tgt < 0 { return -1 }
    fbRefNull(sHeapIdx[tgt])
    return 0
  }
  if scode == 18 {
    fbRefNull(lTypeIdx)
    return 0
  }
  if isNulScalarListFieldCode(scode) {
    fbRefNull(nulScalarListFieldWrapHeap(scode))
    return 0
  }
  if scode == 28 {
    const rs28 = sFieldRefSlot(si, fi)
    if rs28 >= 0 && rs28 < rlWrapIdx.length {
      fbRefNull(rlWrapIdx[rs28])
      return 0
    }
    return -1
  }
  if scode == 22 {
    fbRefNull(cloStructIdx)
    return 0
  }
  if scode == 29 {
    fbRefNull(mapTypeIdxOf(sFieldMapShape(si, fi)))
    return 0
  }
  if scode == 16 {
    // a value-union field defaults to null only when `null` is a member — resolve the
    // member set once, then test its banked null code (`nullValKind()`), not the lexeme.
    const fnm = sFieldElemNameAt(si, fi)
    if unionHasAtomK(msSetOfText(fnm), fnm, "null", nullValKind()) {
      fbI32Const(nullBoxTag())
      fbRefNullNone()
      fbStructNew(uBoxIdx)
      return 0
    }
    return -1
  }
  -1
}

// One struct field's value, from the pending-context seed through the emission arm its code
// selects to the two widen sites. Carved out of `emitObj`'s layout loop so the source-order
// stash pass (D1510) can run exactly the same lowering, once per field, before the layout
// loop reads the slots back. The caller has resolved `valIx` and consumed `pendingStructIdx`.
function emitStructFieldValue(
  body: i32[],
  si: i32,
  fi: i32,
  valIx: i32,
  fnIx: i32,
) {
  const scode = sFieldTypeAt(si, fi)
  // a struct value is allowed only into a nested-struct field (code 15) or a box-union
  // field (code 16, boxed via `emitUnionCoerce`); any other field code has no rep for it.
  if scode != 15 && scode != 16 {
    if exprStruct(valIx, fnIx) {
      return emitFail("emitProgram: nested struct fields are not supported")
    }
  }

  if scode == 14 {
    const cav = P.nodes[unwrapParen(valIx)]
    if cav is ArrayLit {
      // a same-field-name literal-shape collision can mis-code a closure-array field as a
      // bare closure; the built list wrapper cannot store into the `(ref $cloStruct)` slot.
      return emitFail(
        "emitProgram: a closure-array struct-field literal is not supported",
      )
    }
  }

  if scode != 14 && scode != 22 && scode != 16 {
    const cfv = P.nodes[unwrapParen(valIx)]
    if cfv is FuncDecl {
      // the inverse mis-resolution: a lambda value's own field-shape interning collided
      // with a non-closure sibling shape, whose slot cannot store the closure ref either.
      return emitFail(
        "emitProgram: a lambda field value resolved to a non-closure field slot",
      )
    }
  }

  pendingListKind = 0
  pendingListSlot = 0
  pendingNulRefHeap = -1
  if scode == 5 {
    // an empty `[]` needs the element kind threaded (union box 2 / struct 1) to build a
    // ref-list not an i32-list; a nested ref-array element (kind 9) also builds through this slot.
    let fslot = sFieldRefSlot(si, fi)
    if fslot < 0 { fslot = 0 }

    if fslot >= rlElemKindTbl.length {
      return emitFail(
        "emitProgram: ref-list field element type is not interned",
      )
    }
    pendingListSlot = fslot
    if rlElemKindTbl[fslot] == 2 { pendingListKind = 2 }
    else if rlElemKindTbl[fslot] == 1 { pendingListKind = 1 }
    else { pendingListKind = 5 }
  } else if scode == 6 {
    pendingListKind = 3
  } else if scode == 35 {
    pendingListKind = 10
  } else if scode == 25 {
    pendingListKind = 4
  } else if scode == 26 {
    pendingListKind = 6
  } else if scode == 27 {
    pendingListKind = 7
  } else if scode == 18 {
    // a bare `null` here becomes `ref.null $lTypeIdx`; a list value ignores this seed.
    pendingNulRefHeap = lTypeIdx
  } else if isNulScalarListFieldCode(scode) {
    // gated the same way code 28 is: an empty-list element must not consume this seed
    // (it would store `ref.null $wrapper` into a backing holding `ref.null $elem`).
    pendingListKind = nulScalarListBuildKind(nulScalarListCodeKind(scode))

    const nslV = P.nodes[unwrapParen(valIx)]
    if nslV is NullLit { pendingNulRefHeap = nulScalarListFieldWrapHeap(scode) }
  } else if scode == 28 {
    // built through the element slot like code 5. The null-heap seed just below is gated
    // on a bare `null` value — ungated, a `[null]` element would consume it: invalid wasm.
    let fslot28 = sFieldRefSlot(si, fi)
    if fslot28 < 0 { fslot28 = 0 }
    pendingListSlot = fslot28
    if rlElemKindTbl[fslot28] == 2 { pendingListKind = 2 }
    else if rlElemKindTbl[fslot28] == 1 { pendingListKind = 1 }
    else { pendingListKind = 5 }

    if fslot28 < rlWrapIdx.length {
      const nraF = P.nodes[unwrapParen(valIx)]
      if nraF is NullLit { pendingNulRefHeap = rlWrapIdx[fslot28] }
    }
  } else if scode == 29 {
    // a `Map()` value builds this field's own value-typed map struct (the `pendingMapSlot`
    // seed, as code 19); a bare `null` seeds `pendingNulRefHeap` to the same map struct.
    const mslot29 = sFieldMapShape(si, fi)
    pendingMapSlot = mslot29
    pendingNulRefHeap = mapTypeIdxOf(mslot29)
  }

  const savedPSI = pendingStructIdx
  // a code-15 field seeds the target struct so its own literal builds that struct rather
  // than guessing by field-name shape; a bare `null` lowers as `ref.null $S`. Restored below.
  if scode == 15 { pendingStructIdx = sFieldTgtStructIdx(si, fi) }

  // a code-19 field seeds `pendingMapSlot` so a `Map()` value constructs this field's own
  // value-typed map struct, not the mono string-keyed map.
  if scode == 19 { pendingMapSlot = sFieldMapShape(si, fi) }

  if scode == 16 {
    // coerces a raw scalar/string/null into the box with its atom tag via `emitUnionBoxArg`,
    // not `emitUnionCoerce` — a concrete-variant/`nulvariant` value must still be boxed here.
    if emitUnionBoxArg(body, sFieldElemNameAt(si, fi), valIx, fnIx) < 0 {
      return -1
    }
  } else if scode == 17 {
    if emitExprAsF64(body, valIx, fnIx) < 0 { return -1 }
  } else if scode == 23 {
    if emitExprAsI64(body, valIx, fnIx) < 0 { return -1 }
  } else if scode == 24 {
    if emitExprAsF32(body, valIx, fnIx) < 0 { return -1 }
  } else if scode == 20 && exprIsLitAtom(valIx, fnIx) {
    // a literal-union atom (an i32 id) widens to its member string here — the one
    // non-null value that needs converting; niche codes 21/30/22 seed their own null rep.
    if emitStrValue(body, valIx, fnIx) < 0 { return -1 }
  } else if scode == 20 {
    const svNS = pendingNulString
    pendingNulString = true
    const rcNS = emitExpr(body, valIx, fnIx)
    pendingNulString = svNS
    if rcNS < 0 { return -1 }
  } else if scode == 21 {
    const svNB = pendingNulBool
    pendingNulBool = true
    const rcNB = emitExpr(body, valIx, fnIx)
    pendingNulBool = svNB
    if rcNB < 0 { return -1 }
  } else if scode == 30 {
    const nluCtx = expCtxHere()
    nluCtx.litUnion = 1
    nluCtx.nulLitUnion = true
    if emitExprExpect(body, valIx, fnIx, nluCtx) < 0 { return -1 }
  } else if scode == 22 {
    const svNC = pendingNulClosure
    pendingNulClosure = true
    const rcNC = emitExpr(body, valIx, fnIx)
    pendingNulClosure = svNC
    if rcNC < 0 { return -1 }
  } else if scode == 3 && exprIsLitAtom(valIx, fnIx) {
    // a literal-union atom widens to its member string here.
    if emitAtomToStr(body, valIx, fnIx) < 0 { return -1 }
  } else if sFieldIsLitUnion(si, fi) {
    // the member literal lowers as its interned atom id, not a string.
    const fluCtx = expCtxHere()
    fluCtx.litUnion = 1
    if emitExprExpect(body, valIx, fnIx, fluCtx) < 0 { return -1 }
  } else if sFieldIsLitUnionArray(si, fi) {
    // an atom-array field: without the litunion context each string-lexeme element would
    // build a string list, whose wrapper mismatches the field's `$lTypeIdx` of atom ids.
    const flaCtx = expCtxHere()
    flaCtx.litUnion = 1
    if emitExprExpect(body, valIx, fnIx, flaCtx) < 0 { return -1 }
  } else if scode == 15 {
    // A narrowed arm into a nested-struct field (`{ g: s }` after `if s is Circle`) — see
    // `emitArmDelivery`. Inert for every other code-15 value.
    if emitArmDelivery(body, valIx, fnIx, sFieldTgtHeapOf(si, fi)) < 0 {
      return -1
    }
  } else {
    if emitExpr(body, valIx, fnIx) < 0 { return -1 }
  }

  // D1222 — the construct half of the field layer's `ref.as_non_null`. A narrowed nullable
  // ref keeps its `(ref null $H)` and the use site recovers, so a `{f: y}` under a non-null
  // guard would put one under a `(ref $H)` field. Asked through the same `nulNicheRecoverOwed`
  // the return, binding and assign deliveries ask; before the widen sites, which consume it.
  if nulNicheRecoverOwed(fieldCodeVKind(scode), valIx, fnIx) {
    fbRefAsNonNull()
  }
  if scode == 5 {
    // read-only covariance at the field boundary (D791): `pendingListSlot` still holds
    // this field's own row, resolved by the code-5 arm above.
    emitRefListWidenSite(
      body,
      valIx,
      exprEmittedRefListSlot(valIx, fnIx),
      pendingListSlot,
    )
  }

  // the scalar dual of the ref-list widen above (D965): the field's own wasm-type code,
  // not a separately derived name, picks the destination kind, so it cannot disagree.
  if (scode == 4 || scode == 25 || scode == 26 || scode == 27 || scode == 35) {
    let sfk: VKind = "list"
    if scode == 35 { sfk = "u8list" }
    if scode == 25 { sfk = "f64list" }
    if scode == 26 { sfk = "i64list" }
    if scode == 27 { sfk = "f32list" }
    emitScalarListWidenSite(body, valIx, fnIx, sfk)
  }
  if scode == 15 { pendingStructIdx = savedPSI }
  if scode == 19 { pendingMapSlot = -1 }
  pendingListKind = 0
  0
}

// Lower an object literal `{ f: v, … }` onto `body`: resolve which struct the field-name
// set names (an `si` hint from the binding/argument site wins over the match, then reset
// so a nested literal falls back to inference), push each field in declared order, then
// `struct.new`. A nullable field may be omitted (`emitOmittedFieldNull`); any other must match.
function emitObj(body: i32[], objIx: i32, fnIx: i32) {
  if !sDeclared {
    return emitFail("emitProgram: object literal but no struct type declared")
  }
  const o = P.nodes[objIx]
  if o is ObjLit {
    let si = pendingStructIdx
    pendingStructIdx = -1
    if si < 0 { si = structIndexOfObjCtx(objIx, fnIx) }
    if si < 0 {
      return emitFail(
        "emitProgram: object literal field count does not match struct",
      )
    }
    const cnt = sFieldCount[si]
    // D1510 — source-order evaluation. `struct.new` takes its operands in layout order,
    // sorted by field name, so evaluating each initialiser as it is pushed runs a literal
    // written in another order permuted. When the permutation is observable, evaluate in
    // source order into one scratch local per field; `stash` is empty otherwise.
    const stash: i32[] = []
    if objLitNeedsOrderStash(objIx, sFieldNames, sFieldStart[si], cnt) {
      let pi = 0
      while pi < cnt {
        stash.push(0 - 1)
        pi = pi + 1
      }
      const ord = objFieldSrcOrder(objIx, sFieldNames, sFieldStart[si], cnt)
      let oi = 0
      while oi < ord.length {
        const ofi = ord[oi]
        const ovIx = objFieldVal(objIx, sFieldNames[sFieldStart[si] + ofi])
        if emitStructFieldValue(body, si, ofi, ovIx, fnIx) < 0 { return -1 }
        const oslot = objOrderStashSlot(
          sFieldTypeAt(si, ofi),
          sFieldStorageSlot(si, ofi),
        )
        stash[ofi] = oslot
        fbLocalSet(oslot)
        oi = oi + 1
      }
    }
    let fi = 0
    while fi < cnt {
      const valIx = objFieldVal(objIx, sFieldNames[sFieldStart[si] + fi])
      const scode = sFieldTypeAt(si, fi)
      if valIx < 0 {
        // An omitted field pushes a constant, so it has no source position to keep and
        // stays in the layout loop even under the stash.
        if emitOmittedFieldNull(body, si, fi, scode) < 0 {
          return emitFail(
            "emitProgram: object literal is missing a struct field",
          )
        }
        fi = fi + 1
        continue
      }
      if stash.length > 0 {
        fbLocalGet(stash[fi])
        fi = fi + 1
        continue
      }
      if emitStructFieldValue(body, si, fi, valIx, fnIx) < 0 { return -1 }
      fi = fi + 1
    }
    fbStructNew(sHeapIdx[si])
    return 0
  }
  emitFail("emitProgram: expected an object literal")
}

// Does `name` appear as a value — any position other than the callee of a direct
// `name(...)` call — in the subtree at `ix`? A generic function bound to `name` is sound
// only when every use is a direct call, since `monomorphize` rewrites each call to its
// instance and a value use escapes to a call the binding cannot type. Mirrors `monoWalk`.
function nameUsedAsValueIn(name: string, ix: i32) {
  if ix < 0 { return false }
  const n = P.nodes[ix]
  if n is Ident { return n.identName == name }
  if n is Call {
    const callee = P.nodes[n.callFn]
    let direct = false
    if callee is Ident {
      if callee.identName == name { direct = true }
    }
    if !direct {
      if nameUsedAsValueIn(name, n.callFn) { return true }
    }
    const args = n.callArgs
    let i = 0
    while i < args.length {
      if nameUsedAsValueIn(name, args[i]) { return true }
      i = i + 1
    }
    return false
  }
  if n is Block {
    const bs = n.blkStmts
    let i2 = 0
    while i2 < bs.length {
      if nameUsedAsValueIn(name, bs[i2]) { return true }
      i2 = i2 + 1
    }
    return false
  }
  if n is LetDecl { return nameUsedAsValueIn(name, n.letInit) }
  if n is IfStmt {
    if nameUsedAsValueIn(name, n.ifCond) { return true }
    if nameUsedAsValueIn(name, n.ifThen) { return true }
    return nameUsedAsValueIn(name, n.ifElse)
  }
  if n is WhileStmt {
    if nameUsedAsValueIn(name, n.whileCond) { return true }
    return nameUsedAsValueIn(name, n.whileBody)
  }
  if n is ForRange {
    if nameUsedAsValueIn(name, n.frFrom) { return true }
    if nameUsedAsValueIn(name, n.frTo) { return true }
    if nameUsedAsValueIn(name, n.frStep) { return true }
    return nameUsedAsValueIn(name, n.frBody)
  }
  if n is ForIn {
    if nameUsedAsValueIn(name, n.fiIter) { return true }
    return nameUsedAsValueIn(name, n.fiBody)
  }
  if n is RetStmt { return nameUsedAsValueIn(name, n.retArg) }
  if n is BinExpr {
    if nameUsedAsValueIn(name, n.binLeft) { return true }
    return nameUsedAsValueIn(name, n.binRight)
  }
  if n is Unary { return nameUsedAsValueIn(name, n.unArg) }
  if n is Paren { return nameUsedAsValueIn(name, n.parInner) }
  if n is Member { return nameUsedAsValueIn(name, n.memObj) }
  if n is OptMember { return nameUsedAsValueIn(name, n.omObj) }
  if n is Index {
    if nameUsedAsValueIn(name, n.idxArr) { return true }
    return nameUsedAsValueIn(name, n.idxIndex)
  }
  if n is IsExpr { return nameUsedAsValueIn(name, n.isObj) }
  if n is AsExpr { return nameUsedAsValueIn(name, n.asObj) }
  if n is ArrayLit {
    const es = n.arrElems
    let i3 = 0
    while i3 < es.length {
      if nameUsedAsValueIn(name, es[i3]) { return true }
      i3 = i3 + 1
    }
    return false
  }
  if n is ObjLit {
    const fs = n.objFields
    let i4 = 0
    while i4 < fs.length {
      const f = P.nodes[fs[i4]]
      if f is FieldInit {
        if nameUsedAsValueIn(name, f.fiValue) { return true }
      }
      i4 = i4 + 1
    }
    return false
  }
  false
}

// A generic function (un-annotated parameters) taken as a value would emit its params at
// the i32 default, so a `call_indirect` traps the signature check at any other type.
// Reject it as a value unless it is an anonymous lambda used only as a direct-call callee
// (`criFnIsAnonLambda`), which is sound and routes straight to `emitClosureValueCore`.
function emitClosureValue(body: i32[], fe: i32, fnIx: i32) {
  if fnHasUnannotatedParam(fe) {
    if !criFnIsAnonLambda(fe) { return emitFail(genericFnValueRejectMsg(fe)) }
  }

  return emitClosureValueCore(body, fe, fnIx)
}

// The value-floor reject text for the generic function at lifted position `fe`: names the
// function and its un-annotated parameters, and — from `monoPinnedSigsOf` — the concrete
// signatures the program's own call sites already pin it at, the annotation to write.
function genericFnValueRejectMsg(fe: i32) {
  let nm = "<anonymous>"
  let holes = ""
  let nHoles = 0
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if fn.fnName != "" { nm = fn.fnName }
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param {
        if p.parType < 0 {
          if holes != "" { holes = holes + ", " }
          holes = holes + "`" + p.parName + "`"
          nHoles = nHoles + 1
        }
      }
      i = i + 1
    }
  }
  let head = "emitProgram: cannot take the generic function `" +
    nm +
    "` as a value — a function value carries ONE signature, and "
  if nHoles == 1 {
    head = head +
      "parameter " +
      holes +
      " is un-annotated (it would default to i32). "
  } else {
    head = head +
      "parameters " +
      holes +
      " are un-annotated (they would default to i32). "
  }
  const sigs = monoPinnedSigsOf(fe)
  if sigs == "" {
    return head +
      "No call site pins `" +
      nm +
      "`, so there is no inferred signature to adopt — annotate the parameter" +
      pluralS(nHoles) +
      ", or call `" +
      nm +
      "` directly by name"
  }
  head +
    "Call sites pin `" +
    nm +
    "` at " +
    sigs +
    " — annotate the parameter" +
    pluralS(nHoles) +
    " with the signature this value needs, or call `" +
    nm +
    "` directly by name"
}

// `"s"` for a plural count, `""` for exactly one — kept out of the message builder so the
// two branches cannot disagree about the diagnostic's own agreement.
function pluralS(n: i32) {
  if n == 1 { return "" }
  "s"
}

// The closure-value fat pointer for lifted function `fe`: `struct.new $cloStruct [ env, id ]`.
// The env is `ref.null struct` for a non-capturing function, else a `struct.new $envStruct`
// of the enclosing frame's captured values; `id` is the lifted wasm index (imports occupy
// 0..gImports-1), the `==` identity token and the `call_indirect` operand.
export function emitClosureValueCore(body: i32[], fe: i32, fnIx: i32) {
  if fe < 0 || fe >= fnStmts.length {
    return emitFail("emitProgram: function value with no lifted function")
  }

  // a signature not representable as a closure `$fnsig` cannot be soundly called as a
  // value even for a direct-call-only binding: the call site would fall back to the
  // all-i32 arity functype and `call_indirect` at the wrong type, trapping the engine.
  if cloSigKeyExt(fe) == "" {
    return emitFail(
      "emitProgram: a function value's signature is not yet supported — " +
        cloSigRejectWhat(fe) +
        " has no representation in the function-value ABI; annotate and call it as a " +
        "named function instead",
    )
  }

  const envIdx = fnEnvIdxOf(fe)
  if envIdx < 0 {
    fbRefNullStruct()
  } else {
    const caps = captureNamesOf(fe)
    let ci = 0
    while ci < caps.length {
      if emitCaptureRead(body, caps[ci], fnIx) < 0 { return -1 }
      ci = ci + 1
    }
    fbStructNew(envIdx)
  }

  // The one place a wasm function index becomes a closure id, so the one place the
  // address-taken set is recorded: the element section lists exactly these entries, and an
  // id no expression here produces cannot reach a `call_indirect`.
  markFnAddrTaken(fe)
  fbI32Const(gImports + fe)
  fbStructNew(cloStructIdx)
  0
}

// The rep recovery an env-field read owes after its `struct.get`, decided by
// `captureValKind` so the recovery cannot disagree with the field's own type. A
// `nulstr` capture must recover to non-null here; every other nullable cell
// recovers at its own use site instead.
function emitCapturedReadRecover(fe: i32, name: string) {
  if captureValKind(fe, name) == "nulstr" {
    if !nulStrReadStaysRaw() { fbRefAsNonNull() }
  }
  0
}

// If `name` is a captured variable of the capturing function `fnIx`, read it from the env
// struct (`ref.cast` local 0 to the env, then `struct.get` the field index) and return 1;
// else return 0 for the caller's param/local/global path. `recover` is false for the
// env-to-env copy building a nested closure's frame — recovering there traps a null capture.
function emitCapturedRead(
  _body: i32[],
  name: string,
  fnIx: i32,
  recover: boolean,
) {
  if fnIx < 0 { return 0 }
  if !fnValUsed { return 0 }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return 0 }
  const envIdx = fnEnvIdxOf(fe)
  if envIdx < 0 { return 0 }

  if capCacheOn && fe < capCountTbl.length {
    const start = capStartTbl[fe]
    const cnt = capCountTbl[fe]
    let fi = 0
    while fi < cnt {
      if capNamesFlat[start + fi] == name {
        fbLocalGet(0)
        fbRefCast(envIdx)
        fbStructGet(envIdx, fi)
        if recover { emitCapturedReadRecover(fe, name) }
        return 1
      }
      fi = fi + 1
    }
    return 0
  }
  const caps = captureNamesOf(fe)
  let ci = 0
  while ci < caps.length {
    if caps[ci] == name {
      fbLocalGet(0)
      fbRefCast(envIdx)
      fbStructGet(envIdx, ci)
      if recover { emitCapturedReadRecover(fe, name) }
      return 1
    }
    ci = ci + 1
  }
  0
}

// Read captured variable `name` in the enclosing frame `fnIx` for an env-struct build: a
// param/local is `local.get`, a module global `global.get`, and a transitive capture (the
// enclosing frame is itself a lifted closure re-capturing `name`) reads that frame's own
// env, so the value flows env-to-env down any nesting depth.
function emitCaptureRead(_body: i32[], name: string, fnIx: i32) {
  const idx = localIndexOf(fnIx, name)
  if idx >= 0 {
    fbLocalGet(idx)
    return 0
  }
  const gIdx = globalIndexOf(name)
  if gIdx >= 0 { return emitUserGlobalGet(gIdx) }
  if emitCapturedRead(_body, name, fnIx, false) == 1 { return 0 }

  // capture analysis records every free identifier not bound locally, as a global or as a
  // collected function; an intrinsic is none of those, so name it rather than a variable.
  if isNumIntrinsicName(name) {
    return emitFail(
      "emitProgram: the numeric intrinsic '" +
        name +
        "' is mistaken for a captured variable here — it is not yet callable from a lambda, nor from a named function in a module that uses function values",
    )
  }
  emitFail("emitProgram: captured variable not found in enclosing frame")
}

// ── the variant field-span invariant, enforced rather than assumed ───────────

// `uFieldStart` / `uFieldCount` are parallel to `uVariants` and slice the flat `uFieldNames`
// and `uFieldTypes` stores, and nothing keeps the lengths in step: a registration helper that
// pushes a variant row and then refuses one of its fields leaves a start with no count.
// `emitFail` keeps emitting, so an unguarded span read traps the compiler instead (D1152).
function guardVariantFieldSpan(vi: i32, where: string) {
  if vi >= 0 && vi < uFieldStart.length && vi < uFieldCount.length {
    const end = uFieldStart[vi] + uFieldCount[vi]
    if (
      uFieldStart[vi] >= 0 &&
      uFieldCount[vi] >= 0 &&
      end <= uFieldNames.length &&
      end <= uFieldTypes.length
    ) {
      return 0
    }
  }
  emitFail(
    "emitProgram: " +
      where +
      ": union-variant " +
      i32ToStr(vi) +
      " is outside the parallel field-span tables — " +
      i32ToStr(uVariants.length) +
      " variants but " +
      i32ToStr(uFieldStart.length) +
      " field starts / " +
      i32ToStr(uFieldCount.length) +
      " field counts / " +
      i32ToStr(uFieldNames.length) +
      " field names / " +
      i32ToStr(uFieldTypes.length) +
      " field types",
  )
}

// One union-variant field's value — `emitStructFieldValue`'s twin, one table over, carved out
// for the same reason: the source-order stash pass (D1510) runs exactly this lowering once per
// field before the layout loop reads the slots back.
function emitVariantFieldValue(
  body: i32[],
  vi: i32,
  fj: i32,
  valIx: i32,
  fnIx: i32,
) {
  pendingListKind = 0
  pendingListSlot = 0
  pendingNulRefHeap = -1
  const vcode = variantFieldTypeAt(vi, fj)

  const vcfv = P.nodes[unwrapParen(valIx)]
  if vcfv is FuncDecl {
    if vcode != 14 && vcode != 22 && vcode != 16 {
      return emitFail(
        "emitProgram: a lambda field value resolved to a non-closure variant field slot",
      )
    }
  }
  if vcode == 5 {
    let vslot = variantFieldRefSlot(vi, fj)
    if vslot < 0 { vslot = 0 }
    pendingListSlot = vslot
    if rlElemKindTbl[vslot] == 2 {
      pendingListKind = 2
    } else {
      pendingListKind = 1
    }
  } else if vcode == 18 {
    pendingNulRefHeap = lTypeIdx
  } else if vcode == 28 {
    let vslot28 = variantFieldRefSlot(vi, fj)
    if vslot28 < 0 { vslot28 = 0 }
    pendingListSlot = vslot28
    if rlElemKindTbl[vslot28] == 2 { pendingListKind = 2 }
    else if rlElemKindTbl[vslot28] == 1 { pendingListKind = 1 }
    else { pendingListKind = 5 }
    if vslot28 < rlWrapIdx.length { pendingNulRefHeap = rlWrapIdx[vslot28] }
  } else if isNulScalarListFieldCode(vcode) {
    // A nullable scalar-backed list arm field — the struct literal's arm this ladder does not
    // otherwise grow: a bare `null` written here reaches `emitNullLitNode` with every seed at
    // its default and takes the loud `bare null needs a struct-typed context` reject (D1294).
    pendingListKind = nulScalarListBuildKind(nulScalarListCodeKind(vcode))
    const vnslV = P.nodes[unwrapParen(valIx)]
    if vnslV is NullLit {
      pendingNulRefHeap = nulScalarListFieldWrapHeap(vcode)
    }
  } else if vcode == 29 {
    const vmslot29 = uFieldMapShape(vi, fj)
    pendingMapSlot = vmslot29
    pendingNulRefHeap = mapTypeIdxOf(vmslot29)
  } else if vcode == 6 {
    pendingListKind = 3
  } else if vcode == 35 {
    pendingListKind = 10
  } else if vcode == 25 {
    pendingListKind = 4
  } else if vcode == 26 {
    pendingListKind = 6
  } else if vcode == 27 {
    pendingListKind = 7
  }

  const savedVPSI = pendingStructIdx
  if vcode == 15 { pendingStructIdx = uFieldTgtStructIdx(vi, fj) }
  if vcode == 19 { pendingMapSlot = uFieldMapShape(vi, fj) }

  if vcode == 17 {
    if emitExprAsF64(body, valIx, fnIx) < 0 { return -1 }
  } else if vcode == 23 {
    if emitExprAsI64(body, valIx, fnIx) < 0 { return -1 }
  } else if vcode == 24 {
    if emitExprAsF32(body, valIx, fnIx) < 0 { return -1 }
  } else if vcode == 20 {
    const svNS = pendingNulString
    pendingNulString = true
    const rcNS = emitExpr(body, valIx, fnIx)
    pendingNulString = svNS
    if rcNS < 0 { return -1 }
  } else if vcode == 21 {
    const svNB = pendingNulBool
    pendingNulBool = true
    const rcNB = emitExpr(body, valIx, fnIx)
    pendingNulBool = svNB
    if rcNB < 0 { return -1 }
  } else if vcode == 30 {
    const vnluCtx = expCtxHere()
    vnluCtx.litUnion = 1
    vnluCtx.nulLitUnion = true
    if emitExprExpect(body, valIx, fnIx, vnluCtx) < 0 { return -1 }
  } else if vcode == 22 {
    const svNC = pendingNulClosure
    pendingNulClosure = true
    const rcNC = emitExpr(body, valIx, fnIx)
    pendingNulClosure = svNC
    if rcNC < 0 { return -1 }
  } else if variantFieldIsLitUnionArray(vi, fj) {
    const vlaCtx = expCtxHere()
    vlaCtx.litUnion = 1
    if emitExprExpect(body, valIx, fnIx, vlaCtx) < 0 { return -1 }
  } else if vcode == 16 {
    if emitUnionBoxArg(body, variantFieldElemName(vi, fj), valIx, fnIx) < 0 {
      return -1
    }
  } else if vcode == 0 && variantFieldIsLitUnion(vi, fj) {
    const fluCtx = expCtxHere()
    fluCtx.litUnion = 1
    if emitExprExpect(body, valIx, fnIx, fluCtx) < 0 { return -1 }
  } else if vcode == 4 && variantFieldIsLitUnionArray(vi, fj) {
    const flaCtx = expCtxHere()
    flaCtx.litUnion = 1
    if emitExprExpect(body, valIx, fnIx, flaCtx) < 0 { return -1 }
  } else if (vcode == 3 || vcode == 20) && exprIsLitAtom(valIx, fnIx) {
    if emitStrValue(body, valIx, fnIx) < 0 { return -1 }
  } else {
    if emitExpr(body, valIx, fnIx) < 0 { return -1 }
  }
  if vcode == 15 { pendingStructIdx = savedVPSI }
  if vcode == 19 || vcode == 29 { pendingMapSlot = -1 }
  pendingListKind = 0
  0
}

function emitVariantStruct(body: i32[], objIx: i32, vi: i32, fnIx: i32) {
  if guardVariantFieldSpan(vi, "emitVariantStruct") < 0 { return -1 }
  const start = uFieldStart[vi]
  const cnt = uFieldCount[vi]
  // D1510 — source-order evaluation, `emitObj`'s rule for the union-arm literal. A variant
  // row's fields are laid out sorted by name too, so `{ kind: "rect", w: f(), h: g() }` is
  // pushed `h, kind, w` and would run its initialisers permuted without this.
  const stash: i32[] = []
  if objLitNeedsOrderStash(objIx, uFieldNames, start, cnt) {
    let pj = 0
    while pj < cnt {
      stash.push(0 - 1)
      pj = pj + 1
    }
    const ord = objFieldSrcOrder(objIx, uFieldNames, start, cnt)
    let oj = 0
    while oj < ord.length {
      const ofj = ord[oj]
      const ovIx = objFieldVal(objIx, uFieldNames[start + ofj])
      if ovIx < 0 {
        return emitFail(
          "emitProgram: object literal is missing a union-variant field",
        )
      }
      if emitVariantFieldValue(body, vi, ofj, ovIx, fnIx) < 0 { return -1 }
      const oslot = objOrderStashSlot(
        variantFieldTypeAt(vi, ofj),
        uFieldStorageSlot(vi, ofj),
      )
      stash[ofj] = oslot
      fbLocalSet(oslot)
      oj = oj + 1
    }
  }
  let fj = 0
  while fj < cnt {
    const valIx = objFieldVal(objIx, uFieldNames[start + fj])
    if valIx < 0 {
      return emitFail(
        "emitProgram: object literal is missing a union-variant field",
      )
    }
    if stash.length > 0 {
      fbLocalGet(stash[fj])
      fj = fj + 1
      continue
    }
    if emitVariantFieldValue(body, vi, fj, valIx, fnIx) < 0 { return -1 }
    fj = fj + 1
  }
  fbStructNew(uVarHeap[vi])
  0
}

function seedFieldListBuild(code: i32, refSlot: i32) {
  pendingListKind = 0
  pendingListSlot = 0
  if code == 5 || code == 28 {
    let slot = refSlot
    if slot < 0 { slot = 0 }
    if slot >= rlElemKindTbl.length {
      return emitFail(
        "emitProgram: ref-list field element type is not interned",
      )
    }
    pendingListSlot = slot
    if rlElemKindTbl[slot] == 2 { pendingListKind = 2 }
    else if code == 28 && rlElemKindTbl[slot] != 1 { pendingListKind = 5 }
    else { pendingListKind = 1 }
    return 0
  }
  if code == 6 { pendingListKind = 3 }

  if code == 35 { pendingListKind = 10 }
  if code == 25 { pendingListKind = 4 }
  if code == 26 { pendingListKind = 6 }
  if code == 27 { pendingListKind = 7 }

  if isNulScalarListFieldCode(code) {
    pendingListKind = nulScalarListBuildKind(nulScalarListCodeKind(code))
  }
  0
}

// A field store's right-hand value with the scalar widening its field code demands — f64
// (17), i64 (23), f32 (24) re-encode at the boundary, any other code emits plainly. The
// store-side twin of the construct paths' widening, shared by all three `emitAssign`
// member-assignment branches (narrowed union, variant param, plain struct).
function emitScalarFieldStoreVal(
  body: i32[],
  valIx: i32,
  fnIx: i32,
  code: i32,
) {
  if code == 17 { return emitExprAsF64(body, valIx, fnIx) }
  if code == 23 { return emitExprAsI64(body, valIx, fnIx) }
  if code == 24 { return emitExprAsF32(body, valIx, fnIx) }

  if code == 3 || code == 20 {
    if exprIsLitAtom(valIx, fnIx) { return emitStrValue(body, valIx, fnIx) }
  }
  emitExpr(body, valIx, fnIx)
}

// Lower an object literal `{ f: v, … }` boxed into the declared union onto `body`:
// `struct.new $box (i32.const tagOf(variant)) (struct.new $variant <fields…>)`. The
// literal must match exactly one union variant's field-name set, else it fails loudly.
function emitUnionBox(body: i32[], objIx: i32, fnIx: i32) {
  const vname = objVariantName(objIx)
  if vname == "" {
    return emitFail("emitProgram: object literal matches no union variant")
  }
  emitUnionBoxAs(body, objIx, variantIndexOf(vname), fnIx)
}

// The body of `emitUnionBox` with the variant already resolved — the union-context pick
// (`unionArmVariantForObj`) enters here with its own `vi`.
function emitUnionBoxAs(body: i32[], objIx: i32, vi: i32, fnIx: i32) {
  fbI32Const(uTags[vi])
  if emitVariantStruct(body, objIx, vi, fnIx) < 0 { return -1 }
  fbStructNew(uBoxIdx)
  0
}

// Box a struct-typed expression (an ident or call result already built as the plain
// struct `sHeapIdx[ssi]`) into union variant `vi`, whose variant struct is a layout twin
// of but a distinct heap type from it: a plain ref fails the box payload's cast, so
// rebuild the variant struct field by field from the source, then box.
function emitStructExprAsVariantBox(
  body: i32[],
  exprIx: i32,
  vi: i32,
  ssi: i32,
  fnIx: i32,
) {
  // The guard covers the two span tables; `uTags` and `uVarHeap` are instead one row per
  // `uVariants` row, minted after the last pass that can push one. Each caller bounds `ssi`
  // its own way — `structIdxMatchesVariantIdx` here, `bssi < sHeapIdx.length` at the argument
  // boundary — so neither hands one on unchecked.
  if guardVariantFieldSpan(vi, "emitStructExprAsVariantBox") < 0 { return -1 }
  const cnt = uFieldCount[vi]
  // a re-readable source (or a single-field variant) re-emits the source once per field; a
  // non-re-readable multi-field source (a call) must instead stash into `variantReboxSlot`.
  const reReadable = cnt == 1 || exprReReadable(unwrapParen(exprIx))
  if !reReadable {
    if !fnUsesVariantRebox {
      return emitFail(
        "emitProgram: a multi-field struct value from a call cannot be boxed into a variant-box union (rebox scratch slot unreserved)",
      )
    }
    if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
    fbLocalSet(variantReboxSlot)
  }
  fbI32Const(uTags[vi])
  const start = uFieldStart[vi]
  let fj = 0
  while fj < cnt {
    const sfi = sFieldIndex(ssi, uFieldNames[start + fj])
    if sfi < 0 {
      return emitFail(
        "emitProgram: struct value is missing a union-variant field",
      )
    }
    if reReadable {
      if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
    } else {
      fbLocalGet(variantReboxSlot)
      fbRefCast(sHeapIdx[ssi])
    }
    fbStructGet(sHeapIdx[ssi], sfi)
    fj = fj + 1
  }
  fbStructNew(uVarHeap[vi])
  fbStructNew(uBoxIdx)
  0
}

// The compile-time value of a monomorphized-instance `is` guard: 1 (always true), 0
// (always false), or -1 (not statically decidable, so `emitIs`'s runtime paths handle
// it). Each instance pins an un-annotated param to one concrete type.
function monoStaticIsResult(isIx: i32, fnIx: i32) {
  const nd = P.nodes[isIx]
  if nd is IsExpr {
    if variantIndexOf(nd.isVariant) >= 0 { return -1 }

    if nodeTyIsUnion(nd.isObj) {
      const rsp = isVariantSpelling(nd.isVariant, isVarTyIxOf(isIx))
      if variantIndexOf(rsp) >= 0 { return -1 }
    }
    if exprUnion(nd.isObj, fnIx) { return -1 }

    if nodeTyIsNullable(nd.isObj) { return -1 }
    const sk = monoArgTyName(nd.isObj, fnIx)
    if sk == "" { return -1 }

    if sigKeyPinPayload(sk) != "" {
      const fvTy = monoArgPinTyIx(nd.isObj, fnIx)
      const fvTest = isVarTyIxOf(isIx)
      if fvTy >= 0 && fvTest >= 0 && tySame(fvTy, fvTest) { return 1 }
      // D951 — the one instantiation the spelling substitution cannot bank a row for. At
      // `T := (i32) => i32` the monomorphizer binds `T` to the `$fnsig` key (`=>i>i`), a name
      // that exists only as a string and that `nameToTy` cannot parse back, so `isVarTyIxOf`
      // is -1 for the substituted node and the arena compare above cannot fire.

      // The spelling is the sound answer here and nowhere else: `sk` is itself a sigkey, and a
      // sigkey is a pure encoding of a function type carrying no identity of its own, so two
      // equal keys are the same function type. Placed inside this arm so it can only add a
      // true the arena compare had no rows to reach.
      if sk == nd.isVariant { return 1 }
      return 0
    }
    if sk == nd.isVariant { return 1 }

    const cmpTy = isVarTyIxOf(isIx)
    if cmpTy >= 0 && !tyRenderSoftensLits(cmpTy) {
      if sk == tyToEmitName(cmpTy) { return 1 }
    }

    const rm = repIsRowMatchTy(sk, isVarTyIxOf(isIx), repScanLim())
    if rm >= 0 { return rm }
    return 0
  }
  -1
}

// The union-box tag the type `ity` claims as a value-union arm, or -1 when it claims none
// (a struct variant, a literal, an un-interned shape). A bare function-type arm tags on
// its interned signature slot rather than the flat kind-11 value-atom tag — kind 11 alone
// would make `x is F` true for a value built through any function-typed arm.
function isArmTagOfTy(ity: i32): i32 {
  if ity < 0 { return -1 }
  let ak = unMemAtomKind(ity)

  if ak == 11 { return cloArmTagOfTy(ity) }
  if ak < 0 {
    if tyIsLitUnion(ity) { ak = 2 }
  }
  if ak >= 0 { return scalarTagOfKind(ak) }

  if unMemIsMap(ity) {
    return mapSlotTag(mvSlotOfValTyK(tyMapValOf(ity), tyMapKeyIsI32(ity)))
  }
  if unMemIsRefElemArray(ity) {
    const sl = rlSlotOfTy(tyRefArrElemOf(ity))
    if sl >= 0 { return refArrSlotTag(sl) }
  }
  -1
}

// The arena type the active narrowing of `name` binds, or -1 when `name` is not narrowed
// or the narrowing carries no single type. A complement push (`x != null`) carries a
// member set instead, whose sole surviving member is the bound type.
function narrowedArmTyOf(name: string): i32 {
  const i = narrowSlotOf(name)
  if i < 0 { return -1 }
  narrowSlotTyOf(i)
}

// `recv == <numeric literal>` onto `body`, leaving a 0/1 i32 — the scalar value test shared
// by the bare-literal `is` spelling and the numeric-litunion membership ladder. The
// compare's width follows the lexeme and receiver directly, so a membership ladder cannot
// disagree with the receiver's own valtype.
function emitNumLitEq(body: i32[], recvIx: i32, lv: string, fnIx: i32) {
  if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
  if numLexIsFloat(lv) {
    fbF64Const(lv)
    fbI32Bin(97)
    return 0
  }
  if exprIsI64(recvIx, fnIx) || !numLexFitsI32(lv) {
    const pr = parseI64Pair(lv)
    fbI64Const(pr[0], pr[1])
    fbI32Bin(81)
    return 0
  }
  fbI32Const(parseI32(lv))
  fbI32Bin(70)
  return 0
}

// The base numeric scalar an `is` receiver reps as in this instance — `"i32"`/`"i64"`/
// `"f64"`, or `""` otherwise. `nodeNumScalarBaseName` reads the checker's bank; an
// un-annotated parameter has none, so `monoArgTyName` answers per instance. A nullable
// receiver is refused, since its name would drop the `null`.
function isNumRecvBaseName(recvIx: i32, fnIx: i32) {
  const nb = nodeNumScalarBaseName(recvIx)
  if nb != "" { return nb }
  if nodeTyIsNullable(recvIx) { return "" }
  const mn = monoArgTyName(recvIx, fnIx)
  if mn == "i32" || mn == "i64" || mn == "f64" { return mn }
  ""
}

// The value-union name of an `is` receiver, for the box-tag soundness floor in `emitIs`.
// `unionNameOfExpr` covers every receiver form except the optional chain, whose leaf field
// is resolved here instead. `""` when the receiver is not a union.
function isStrTagUnionNameOf(exprIx: i32, fnIx: i32) {
  const nm = unionNameOfExpr(exprIx, fnIx)
  if nm != "" { return nm }
  const e = P.nodes[unwrapParen(exprIx)]
  if e is OptMember {
    const si = optChainStructIdxOf(e.omObj, fnIx)
    if si >= 0 {
      const fi = sFieldIndex(si, e.omProp)
      if fi >= 0 {
        if sFieldTypeAt(si, fi) == 16 { return sFieldElemNameAt(si, fi) }
      }
    }
  }
  ""
}

// The null test for a nullable value — `x == null`/`x != null` and the `x is null`/`x is
// <member>` guard ask the same question of the same rep. Leaves a 0/1 i32 (1 = null unless
// `invert`); 0 means no arm claims the rep. `nicheOnly` restricts to single-non-null-member
// reps (a box or optional chain has several, so "not null" cannot identify one).
function emitNulIsNullTest(
  body: i32[],
  refIx: i32,
  fnIx: i32,
  invert: boolean,
  nicheOnly: boolean,
) {
  if !nicheOnly || !invert {
    // claimed first: every arm below reads the declared nullable rep while a narrowed
    // binding is read at its arm's rep, so without this the assignment spelling gets no arm.
    const nnRef = P.nodes[unwrapParen(refIx)]
    if nnRef is Ident {
      if narrowExcludesNull(nnRef.identName) {
        if invert { fbI32Const(1) } else { fbI32Const(0) }
        return 1
      }
    }
  }

  if exprNulBool(refIx, fnIx) {
    if emitExpr(body, refIx, fnIx) < 0 { return -1 }
    fbI32Const(2)
    if invert { fbI32Bin(71) } else { fbI32Bin(70) }
    return 1
  }
  if exprNulLitUnion(refIx, fnIx) {
    if emitExpr(body, refIx, fnIx) < 0 { return -1 }
    fbI32Const(-1)
    if invert { fbI32Bin(71) } else { fbI32Bin(70) }
    return 1
  }
  if !nicheOnly {
    const ncN = P.nodes[unwrapParen(refIx)]
    if ncN is OptMember {
      if emitOptChainIsNull(body, refIx, fnIx) < 0 { return -1 }
      if invert { fbI32Eqz() }
      return 1
    }

    if mapReadScalarBoxKindTy(refIx) >= 0 {
      const mnRef = P.nodes[unwrapParen(refIx)]
      if mnRef is Index {
        if emitMapHas(body, mnRef.idxArr, mnRef.idxIndex, fnIx) < 0 {
          return -1
        }
        if !invert { fbI32Eqz() }
        return 1
      }
    }
    if exprUnion(refIx, fnIx) || nodeTyIsNulNumLitUnion(refIx) {
      if emitExpr(body, refIx, fnIx) < 0 { return -1 }
      fbStructGet(uBoxIdx, 0)
      fbI32Const(nullBoxTag())
      if invert { fbI32Bin(71) } else { fbI32Bin(70) }
      return 1
    }
  }

  if (
    exprNullableRefNiche(refIx, fnIx) ||
    exprNullableMap(refIx, fnIx) ||
    exprNulClosure(refIx, fnIx) ||
    exprNullableList(refIx, fnIx) ||
    exprNulScalarListKind(refIx, fnIx) != null ||
    exprNullableRefArray(refIx, fnIx)
  ) {
    if emitExpr(body, refIx, fnIx) < 0 { return -1 }
    wU8(209)
    if invert { fbI32Eqz() }
    return 1
  }

  if exprNullableString(refIx, fnIx) {
    // the one arm that must read the receiver raw: a kind-16 ident is otherwise recovered
    // to non-null, which would make `ref.is_null` a const 0.
    const nsCtx = expCtxHere()
    nsCtx.rawNullRead = true
    if emitExprExpect(body, refIx, fnIx, nsCtx) < 0 { return -1 }
    wU8(209)
    if invert { fbI32Eqz() }
    return 1
  }
  0
}

// True when `recvIx`'s storage is the `string | null` niche and it is still nullable at
// this read. Both halves are required: `exprNullableString` is declaration-scoped while
// `nodeTyIsNullable` is the checker's bank for this read — their disagreement is exactly
// the narrowing signal (a `!= null`-narrowed receiver reaches the plain compare instead).
function litMemberRecvIsNulString(recvIx: i32, fnIx: i32) {
  exprNullableString(recvIx, fnIx) && nodeTyIsNullable(recvIx)
}

// `<string | null> is "<m>"` over a null receiver answers false — not an impossibility to
// `ref.as_non_null` away. Read the receiver once as the raw nullable ref; `br_on_null`
// (which consumes it) decides between the string compare and a const 0, mirroring
// `emitPrintNulString`'s block shape rather than the coalesce's.
function emitNulStrLitEq(body: i32[], recvIx: i32, lex: string, fnIx: i32) {
  fbBlock(127)
  ctrlEnter()
  fbBlock(64)
  ctrlEnter()

  const rawCtx = expCtxHere()
  rawCtx.rawNullRead = true
  if emitExprExpect(body, recvIx, fnIx, rawCtx) < 0 { return -1 }
  wU8(213)
  wULEB(0)
  if emitExpr(body, mkStr(lex, -1), fnIx) < 0 { return -1 }
  if emitStrEqCore(body) < 0 { return -1 }
  fbBr(1)
  fbEnd()
  ctrlLeave()
  fbI32Const(0)
  fbEnd()
  ctrlLeave()
  0
}

// One member-literal test `recv == <lex>`, in whichever shape the receiver's rep demands:
// the tag-gated payload compare over a value-union box, the null-guarded string compare
// over a `string | null` niche, plain string equality over a string ref, else the numeric
// compare. One home because the bare-literal `is` and the litunion ladder must agree.
function emitLitMemberEq(body: i32[], recvIx: i32, lex: string, fnIx: i32) {
  if exprUnion(recvIx, fnIx) { return emitUnionLitIs(body, recvIx, lex, fnIx) }

  if nameIsQuotedLeaf(lex) {
    if !aUsed {
      return emitFail(
        "emitProgram: string `is` test but array type not collected",
      )
    }
    if litMemberRecvIsNulString(recvIx, fnIx) {
      return emitNulStrLitEq(body, recvIx, lex, fnIx)
    }
    if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
    if emitExpr(body, mkStr(lex, -1), fnIx) < 0 { return -1 }
    return emitStrEqCore(body)
  }
  emitNumLitEq(body, recvIx, lex, fnIx)
}

// shared refusal text: the membership ladder's own place bound and the box-tag compare's
// litunion guard are the same underlying refusal, so both callers say the same thing.
function emitFailNoMembershipRecv() {
  emitFail(
    "emitProgram: `is` over a literal union needs a re-readable receiver (each member re-reads it; a call / optional-chain receiver has no membership lowering)",
  )
}

// True when union `nm` carries a literal-union arm beside another value arm — the box
// shape where `x is K` is membership over the payload, never a tag compare (the litunion
// arm shares kind 2's tag with a plain `string` arm). Resolves an alias to its member set
// first: an un-resolved alias would wrongly fall into the tag compare.
function unionCarriesLitUnionArm(nm: string) {
  if nm == "" { return false }
  if nameIsLitUnionArmValueUnion(nm) { return true }
  const setNm = unionMemberSetOf(nm)
  if setNm == nm { return false }
  nameIsLitUnionArmValueUnion(setNm)
}

// `unionStrArmCount` over a name that may be a declared alias, expanded first: the count
// decides whether kind 2's tag discriminates an arm at all (one: exactly; two+: never),
// and reading it off an un-expanded alias would disagree with the membership arm.
function unionStrArmCountOf(nm: string) {
  unionStrArmCount(unionMemberSetOf(nm))
}

// True when `recvIx` is a receiver `emitLitMemberEq` can be applied to repeatedly: a
// value-union box, a string-repped litunion, a plain `string`, or the `string | null`
// niche (whose compare answers false for null).
function litMembershipRecvOk(recvIx: i32, fnIx: i32) {
  if exprUnion(recvIx, fnIx) {
    const bxNm = unionNameOfExpr(recvIx, fnIx)
    if bxNm == "" { return false }
    if isValueUnionOfSet(msSetOfText(bxNm), bxNm) { return true }
    return unionCarriesLitUnionArm(bxNm)
  }
  if nodeTyIsLitUnion(recvIx) { return true }
  if exprString(recvIx, fnIx) { return true }

  exprNullableString(recvIx, fnIx)
}

// The primitive the tested type `ity` denotes, when it is one of the six value
// primitives; `""` for every shape a niche member cannot be confused with (struct, list,
// map, closure, literal, union). `ity` is the checker's own banked type, never re-parsed.
function isTestValuePrimName(ity: i32) {
  if ity < 0 { return "" }
  if tyPrimNameOf(ity) == "i32" { return "i32" }
  if tyPrimNameOf(ity) == "i64" { return "i64" }
  if tyPrimNameOf(ity) == "f32" { return "f32" }
  if tyPrimNameOf(ity) == "f64" { return "f64" }
  if tyPrimNameOf(ity) == "boolean" { return "boolean" }
  if tyPrimNameOf(ity) == "string" { return "string" }
  ""
}

// The rep class of the sole non-null member of nullable niche `recvIx`: `"boolean"` /
// `"string"` for the two primitive niches, `"#ref"` for every reference shape, `""` for a
// receiver the `is`-niche ladder does not claim.
function nulNicheBaseClass(recvIx: i32, fnIx: i32) {
  if exprNulBool(recvIx, fnIx) { return "boolean" }
  if exprNullableString(recvIx, fnIx) { return "string" }
  if (
    exprNullableRefNiche(recvIx, fnIx) ||
    exprNullableMap(recvIx, fnIx) ||
    exprNulClosure(recvIx, fnIx) ||
    exprNullableList(recvIx, fnIx) ||
    exprNulScalarListKind(recvIx, fnIx) != null ||
    exprNullableRefArray(recvIx, fnIx)
  ) {
    return "#ref"
  }
  ""
}

// True when `ity` provably cannot be the sole non-null member of nullable niche `recvIx`,
// so `recv is <ity>` is statically false — else the niche's own null test would wrongly
// answer true for every present value too. One-sided: both halves must be positively known.
function nulNicheIsTestImpossible(recvIx: i32, ity: i32, fnIx: i32) {
  const pTest = isTestValuePrimName(ity)
  if pTest == "" { return false }
  const base = nulNicheBaseClass(recvIx, fnIx)
  if base == "" { return false }
  base != pTest
}

// `<recv>.<field fi of arm vi> == <lex>`, leaving an i32 — the one comparison D1023's
// membership chain is built from, reading the discriminant off the union box. The read is the
// narrow's own three steps, sound here for the reason the tag test that precedes it is: this
// runs only inside the `tag == …` conjunction, so the payload is the arm's struct.

// The compare is picked by the field's storage, not by the lexeme's looks. A string literal
// set has two reps — the interned i32 atom when the field's annotation is a registered alias,
// a `(ref $string)` when it is inline — and the lexeme is `"circle"` either way. The code
// column is what makes the answer independent of the arm's spelling.
function emitDiscrimFieldEq(
  body: i32[],
  recvIx: i32,
  vi: i32,
  fi: i32,
  lex: string,
  fnIx: i32,
) {
  if vi < 0 || vi >= uVarHeap.length {
    return emitFail(
      "emitProgram: discriminant test on an arm with no heap type",
    )
  }
  if guardVariantFieldSpan(vi, "emitDiscrimFieldEq") < 0 { return -1 }
  // The FIELD index is the second half of the same read, and it arrives from a caller's
  // loop rather than from the table — bound it here so the row this reads is provably
  // inside the arm's own span, not merely inside the flat store.
  if fi < 0 || fi >= uFieldCount[vi] {
    return emitFail(
      "emitProgram: emitDiscrimFieldEq: field " +
        i32ToStr(fi) +
        " is outside union-variant " +
        i32ToStr(vi) +
        "'s " +
        i32ToStr(uFieldCount[vi]) +
        " fields",
    )
  }
  const code = uFieldTypes[uFieldStart[vi] + fi]
  if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1)
  fbRefCast(uVarHeap[vi])
  fbStructGet(uVarHeap[vi], fi)
  if code == 3 || code == 20 {
    if !aUsed {
      return emitFail(
        "emitProgram: discriminant string test but array type not collected",
      )
    }
    if emitStr(body, mkStr(lex, -1), fnIx) < 0 { return -1 }
    return emitStrEqCore(body)
  }
  if code == 0 {
    // The i32 slot serves both the interned string ATOM and a small numeric literal; the
    // quotes are what part them, exactly as they do in `emitLitMemberEq`.
    if nameIsQuotedLeaf(lex) {
      fbI32Const(internAtom(lex))
    } else {
      fbI32Const(parseI32(lex))
    }
    fbI32Bin(70) // 0x46 i32.eq
    return 0
  }
  if code == 17 {
    fbF64Const(lex)
    fbI32Bin(97) // 0x61 f64.eq
    return 0
  }
  if code == 23 {
    const pr = parseI64Pair(lex)
    fbI64Const(pr[0], pr[1])
    fbI32Bin(81) // 0x51 i64.eq
    return 0
  }
  emitFail(
    "emitProgram: a discriminant field of this storage has no membership compare",
  )
}

// The membership half of `x is A` (D1023) — emitted after the arm's tag test and `i32.and`ed
// onto it, for each field the tag alone cannot settle. `A`'s tag names the shape; where two
// declared types share a shape, the ruling makes `is` a question about the value. It emits
// nothing when no field needs it (`variantDiscrimFieldNeeded`).

// The receiver is re-read once per member, so `unionEqOperandOk` is the place test and a
// non-place receiver keeps the loud refusal. The tag test is consumed into an `if` rather than
// `i32.and`ed, because `i32.and` evaluates both operands: the discriminant read casts to this
// arm and would run on every other arm's values too, trapping once a third arm differs.
function emitVariantDiscrimTest(body: i32[], recvIx: i32, vi: i32, fnIx: i32) {
  if vi < 0 || vi >= uFieldCount.length { return 0 }
  const cnt = uFieldCount[vi]
  let need = false
  let fp = 0
  while fp < cnt {
    if variantDiscrimFieldNeeded(vi, fp) { need = true }
    fp = fp + 1
  }
  if !need { return 0 }
  if !unionEqOperandOk(recvIx) { return emitFailNoMembershipRecv() }
  // <tag test> if (result i32) { <membership> } else { 0 }
  fbIf(127) // 0x04 if, i32 result
  ctrlEnter()
  let first = true
  let fi = 0
  while fi < cnt {
    if variantDiscrimFieldNeeded(vi, fi) {
      const lexes = variantFieldLitLexes(vi, fi)
      if lexes.length == 0 {
        return emitFail(
          "emitProgram: a discriminant field with no literal members",
        )
      }
      let li = 0
      while li < lexes.length {
        if emitDiscrimFieldEq(body, recvIx, vi, fi, lexes[li], fnIx) < 0 {
          return -1
        }
        if li > 0 {
          fbI32Bin(114) // 0x72 i32.or — membership across the set
        }
        li = li + 1
      }
      // Every literal field of the tested type must hold: `is A` is membership in ALL of
      // `A`'s literal sets, not in one of them.
      if !first {
        fbI32Bin(113) // 0x71 i32.and
      }
      first = false
    }
    fi = fi + 1
  }
  fbElse()
  fbI32Const(0)
  fbEnd()
  ctrlLeave()
  0
}

// Lower a type guard `recv is X`. Fixed, load-bearing arm order: nullable-niche null
// tests, atom/literal-union membership, box-tag compares, monomorphized-static folds,
// then the union-variant tag+discriminant compare. A niche `is` assumes the checker
// proved the tested shape is the sole non-null member, which monomorphization can break (D950).
function emitIs(body: i32[], isIx: i32, fnIx: i32) {
  const nd0 = P.nodes[isIx]
  if nd0 is IsExpr {
    if exprNullableRefNiche(nd0.isObj, fnIx) {
      if nulNicheIsTestImpossible(nd0.isObj, isVarTyIxOf(isIx), fnIx) {
        fbI32Const(0)
        return 0
      }
      const nst = emitNulIsNullTest(
        body,
        nd0.isObj,
        fnIx,
        nd0.isVariant != "null",
        true,
      )
      if nst < 0 { return -1 }
      if nst > 0 { return 0 }
    }
  }

  if nd0 is IsExpr {
    if exprIsLitAtom(nd0.isObj, fnIx) {
      const laTexts = tyLitMemberTexts(isVarTyIxOf(isIx))
      if laTexts.length > 0 {
        if nodeLitMembersWithin(nd0.isObj, laTexts) {
          fbI32Const(1)
          return 0
        }

        let laOk = laTexts.length == 1
        if unionEqOperandOk(nd0.isObj) { laOk = true }
        if laOk {
          let laI = 0
          while laI < laTexts.length {
            if emitExpr(body, nd0.isObj, fnIx) < 0 { return -1 }
            fbI32Const(internAtom(quoteLex(laTexts[laI])))
            fbI32Bin(70)
            if laI > 0 { fbI32Bin(114) }
            laI = laI + 1
          }
          return 0
        }
      }
    }
  }

  if nd0 is IsExpr {
    const luNm = unionNameOfExpr(nd0.isObj, fnIx)
    if unionCarriesLitUnionArm(luNm) {
      const luTexts = tyLitMemberTexts(isVarTyIxOf(isIx))
      if luTexts.length > 0 && unionEqOperandOk(nd0.isObj) {
        let luI = 0
        while luI < luTexts.length {
          const luLit = quoteLex(luTexts[luI])
          if emitUnionLitIs(body, nd0.isObj, luLit, fnIx) < 0 { return -1 }
          if luI > 0 { fbI32Bin(114) }
          luI = luI + 1
        }
        return 0
      }
    }
  }

  if nd0 is IsExpr {
    if numLitUnionHasBase(isVarTyIxOf(isIx)) {
      const nbTexts = tyNumLitMemberTexts(isVarTyIxOf(isIx))
      if (
        nbTexts.length > 0 &&
        exprUnion(nd0.isObj, fnIx) &&
        unionEqOperandOk(nd0.isObj)
      ) {
        const nbNm = unionNameOfExpr(nd0.isObj, fnIx)
        if (
          nbNm != "" &&
          (isValueUnionOfSet(msSetOfText(nbNm), nbNm) ||
            unionCarriesLitUnionArm(nbNm))
        ) {
          let nbI = 0
          while nbI < nbTexts.length {
            if emitUnionLitIs(body, nd0.isObj, nbTexts[nbI], fnIx) < 0 {
              return -1
            }
            if nbI > 0 { fbI32Bin(114) }
            nbI = nbI + 1
          }
          return 0
        }
      }
    }
  }

  if nd0 is IsExpr {
    if !exprIsLitAtom(nd0.isObj, fnIx) {
      const lsTexts = tyLitMemberTexts(isVarTyIxOf(isIx))
      if lsTexts.length > 0 && litMembershipRecvOk(nd0.isObj, fnIx) {
        if nodeTyIsLitUnion(nd0.isObj) {
          if nodeLitMembersWithin(nd0.isObj, lsTexts) {
            fbI32Const(1)
            return 0
          }
        }
        let lsOk = lsTexts.length == 1
        if unionEqOperandOk(nd0.isObj) { lsOk = true }
        if !lsOk { return emitFailNoMembershipRecv() }
        let lsI = 0
        while lsI < lsTexts.length {
          if (
            emitLitMemberEq(body, nd0.isObj, quoteLex(lsTexts[lsI]), fnIx) <
            0
          ) {
            return -1
          }
          if lsI > 0 { fbI32Bin(114) }
          lsI = lsI + 1
        }
        return 0
      }
    }
  }

  const ndv = P.nodes[isIx]
  if ndv is IsExpr {
    const armTag = isArmTagOfTy(isVarTyIxOf(isIx))

    // the tag compare below is unsound for a litunion tested type over a box with two
    // string-repped arms: the litunion arm shares kind 2's tag with a plain `string` arm,
    // so `tag == 2` would answer true for every string the box holds, members or not.
    if armTag == 2 && tyIsLitUnion(isVarTyIxOf(isIx)) {
      const amNm = isStrTagUnionNameOf(ndv.isObj, fnIx)
      if amNm != "" && unionStrArmCountOf(amNm) > 1 {
        return emitFailNoMembershipRecv()
      }
    }
    if armTag >= 0 {
      const vrecv = P.nodes[unwrapParen(ndv.isObj)]
      if vrecv is Ident {
        // pushes the raw box slot directly, even when an outer arm already narrowed it to
        // a single atom — the narrowed Ident read would unbox instead of yielding the box.
        if (
          unionNameOfIdentSid(sidOfNode(unwrapParen(ndv.isObj)), fnIx) != "" &&
          identSlotIsUnionBox(fnIx, vrecv.identName)
        ) {
          if emitUnionBoxPush(body, vrecv.identName, fnIx) < 0 { return -1 }
          fbStructGet(uBoxIdx, 0)
          fbI32Const(armTag)
          fbI32Bin(70)
          return 0
        }
      }

      if vrecv is Member {
        if memberUnionFieldNameRead(unwrapParen(ndv.isObj), fnIx) != "" {
          if memIsNarrowed(unwrapParen(ndv.isObj)) {
            if emitNarrowedMem(body, unwrapParen(ndv.isObj), fnIx) < 0 {
              return -1
            }
            fbStructGet(uBoxIdx, 0)
            fbI32Const(armTag)
            fbI32Bin(70)
            return 0
          }

          const msi = structIndexOfExpr(vrecv.memObj, fnIx)
          if msi >= 0 {
            const mfi = sFieldIndex(msi, vrecv.memProp)
            if mfi >= 0 {
              if emitExpr(body, vrecv.memObj, fnIx) < 0 { return -1 }
              if exprNullableStruct(vrecv.memObj, fnIx) { wU8(212) }
              fbStructGet(sHeapIdx[msi], mfi)
              fbStructGet(uBoxIdx, 0)
              fbI32Const(armTag)
              fbI32Bin(70)
              return 0
            }
          }

          const aivi = exprVariantIndex(vrecv.memObj, fnIx)
          if aivi >= 0 {
            const aifi = variantFieldIndex(aivi, vrecv.memProp)
            if aifi >= 0 {
              if emitExpr(body, vrecv.memObj, fnIx) < 0 { return -1 }
              fbStructGet(uVarHeap[aivi], aifi)
              fbStructGet(uBoxIdx, 0)
              fbI32Const(armTag)
              fbI32Bin(70)
              return 0
            }
          }
        }
      }

      if vrecv is OptMember {
        const oisSi = optChainStructIdxOf(vrecv.omObj, fnIx)
        if oisSi >= 0 {
          const oisFi = sFieldIndex(oisSi, vrecv.omProp)
          if oisFi >= 0 {
            if sFieldTypeAt(oisSi, oisFi) == 16 {
              if emitOptChainIsNull(body, vrecv.omObj, fnIx) < 0 { return -1 }
              fbIf(127)
              ctrlEnter()
              fbI32Const(0)
              fbElse()
              if emitOptChainValue(body, vrecv.omObj, fnIx) < 0 { return -1 }
              fbStructGet(sHeapIdx[oisSi], oisFi)
              fbStructGet(uBoxIdx, 0)
              fbI32Const(armTag)
              fbI32Bin(70)
              fbEnd()
              ctrlLeave()
              return 0
            }
          }
        }
      }
      if exprUnion(ndv.isObj, fnIx) {
        if emitExpr(body, ndv.isObj, fnIx) < 0 { return -1 }
        fbStructGet(uBoxIdx, 0)
        fbI32Const(armTag)
        fbI32Bin(70)
        return 0
      }
    }
  }

  if nd0 is IsExpr {
    if !exprUnion(nd0.isObj, fnIx) {
      const nlBase = numLitUnionBaseName(isVarTyIxOf(isIx))
      if nlBase != "" && isNumRecvBaseName(nd0.isObj, fnIx) == nlBase {
        const nlTexts = tyNumLitMemberTexts(isVarTyIxOf(isIx))

        let nlOk = nlTexts.length == 1
        if unionEqOperandOk(nd0.isObj) { nlOk = true }
        if nlTexts.length > 0 && nlOk {
          let nlI = 0
          while nlI < nlTexts.length {
            if emitNumLitEq(body, nd0.isObj, nlTexts[nlI], fnIx) < 0 {
              return -1
            }
            if nlI > 0 { fbI32Bin(114) }
            nlI = nlI + 1
          }
          return 0
        }
      }
    }
  }

  if nd0 is IsExpr {
    const lv = nd0.isVariant
    if isLitVariantName(lv) {
      return emitLitMemberEq(body, nd0.isObj, lv, fnIx)
    }
  }

  if nd0 is IsExpr {
    // this arm's position is the correctness argument: it claims exactly the receivers
    // that would otherwise reach `monoStaticIsResult`'s unsound name-based fold below.
    let nulOk = true
    if nd0.isVariant != "null" {
      if exprNulLitUnion(nd0.isObj, fnIx) { nulOk = false }
      if tyIsLitUnion(isVarTyIxOf(isIx)) { nulOk = false }
    }
    if nulOk {
      if nulNicheIsTestImpossible(nd0.isObj, isVarTyIxOf(isIx), fnIx) {
        fbI32Const(0)
        return 0
      }
      const nt = emitNulIsNullTest(
        body,
        nd0.isObj,
        fnIx,
        nd0.isVariant != "null",
        true,
      )
      if nt < 0 { return -1 }
      if nt > 0 { return 0 }
    }
  }

  if nd0 is IsExpr {
    const st = monoStaticIsResult(isIx, fnIx)
    if st >= 0 {
      fbI32Const(st)
      return 0
    }
  }

  if nd0 is IsExpr {
    if tyDenotesFunc(isVarTyIxOf(isIx)) {
      if exprNulClosure(nd0.isObj, fnIx) {
        if emitExpr(body, nd0.isObj, fnIx) < 0 { return -1 }
        wU8(209)
        fbI32Eqz()
        return 0
      }
    }
  }

  if nd0 is IsExpr {
    if !uDeclared {
      const isOpTy = nodeTyIxOf(nd0.isObj)
      const isTsTy = isVarTyIxOf(isIx)
      if isOpTy >= 0 {
        if isTsTy >= 0 {
          if !isUnionOfTy(isOpTy) {
            if tySame(isOpTy, isTsTy) {
              if emitExpr(body, nd0.isObj, fnIx) < 0 { return -1 }
              fbDrop()
              fbI32Const(1)
              return 0
            }
          }
        }
      }
    }
  }
  if !uDeclared {
    return emitFail("emitProgram: `is` test but no union type declared")
  }
  const nd = P.nodes[isIx]
  if nd is IsExpr {
    const vi = variantIndexOf(
      isVariantSpelling(nd.isVariant, isVarTyIxOf(isIx)),
    )
    if vi < 0 {
      if tyIsUnionMemberOf(nodeTyIxOf(nd.isObj), isVarTyIxOf(isIx)) {
        return emitFail(
          "emitProgram: `is` names a declared union member with no interned arm representation (deferred value-union composition)",
        )
      }
      return emitFail(
        "emitProgram: `is` names a type that is not a union variant",
      )
    }

    const rvi = exprVariantIndex(nd.isObj, fnIx)
    if rvi >= 0 {
      // The static fold is only sound where the row is the answer (D1023).
      // `exprVariantIndex` resolves an object literal by its field-name set, so where two arms
      // share a shape it names whichever row it matched first — and folding `rvi == vi` would
      // answer `is` by the row a value happened to be built under, the nominal answer.

      // A non-box receiver still folds, because for it the row really is all there is: a slot
      // holding the raw variant ref has no tag and no payload to read, so there is no value to
      // ask. Only a boxed receiver whose shape carries a discriminant falls through to the
      // runtime chain.
      const foldOk = !exprUnion(nd.isObj, fnIx) ||
        (!variantHasDiscrimField(rvi) &&
        !variantHasDiscrimField(vi))
      if foldOk {
        if rvi == vi { fbI32Const(1) } else { fbI32Const(0) }
        return 0
      }
    }
    if !exprUnion(nd.isObj, fnIx) {
      return emitFail("emitProgram: `is` receiver is not a union value")
    }
    if emitExpr(body, nd.isObj, fnIx) < 0 { return -1 }
    fbStructGet(uBoxIdx, 0)
    fbI32Const(uTags[vi])
    fbI32Bin(70)
    if emitVariantDiscrimTest(body, nd.isObj, vi, fnIx) < 0 { return -1 }
    return 0
  }
  emitFail("emitProgram: expected an `is` expression")
}

// Lower a narrowed field read `recv.field` where `recv` is narrowed to `narrowVariant` by
// an enclosing `if recv is Variant`: evaluate the box, `struct.get $box 1`, `ref.cast (ref
// $variant)` (non-null: a box never is), then `struct.get` the field. Resolves the variant
// from the receiver's own active narrowing, so two simultaneously-narrowed locals agree.
function emitNarrowedMem(body: i32[], memIx: i32, fnIx: i32) {
  const m = P.nodes[memIx]
  if m is Member {
    let recvVar = ""

    const recvN = P.nodes[unwrapParen(m.memObj)]
    if recvN is Ident { recvVar = narrowVariantFor(recvN.identName) }

    if recvN is Member {
      const pk = memberPathKeyOf(m.memObj)
      if pk != "" { recvVar = narrowVariantFor(pk) }
    }
    const vi = variantIndexOf(recvVar)
    if vi < 0 {
      return emitFail("emitProgram: narrowed receiver names no union variant")
    }
    const idx = variantFieldIndex(vi, m.memProp)
    if idx < 0 {
      return emitFail(
        "emitProgram: unknown variant field in narrowed field access",
      )
    }
    if emitExpr(body, m.memObj, fnIx) < 0 { return -1 }
    fbStructGet(uBoxIdx, 1)
    fbRefCast(uVarHeap[vi])
    fbStructGet(uVarHeap[vi], idx)

    if variantFieldTypeAt(vi, idx) == 16 {
      // a value-union field whose own member path is narrowed to one scalar atom: the
      // `struct.get` above yields the field's inner box, so unbox it to the atom's rep too.
      const mAtom = narrowVariantFor(memberPathKeyOf(memIx))
      const mk = valueAtomKind(mAtom)
      if mk >= 0 && mk != nullValKind() {
        fbStructGet(uBoxIdx, 1)

        if mk == 2 {
          if !aUsed {
            return emitFail(
              "emitProgram: narrowed string union field read but array type not collected",
            )
          }
          fbRefCast(sTypeIdx)
        } else {
          const mvb = vbHeapIdxOfKind(mk)
          if mvb < 0 {
            return emitFail(
              "emitProgram: narrowed union field atom has no value box",
            )
          }
          fbRefCast(mvb)
          fbStructGet(mvb, 0)
        }
      }
    }
    return 0
  }
  emitFail("emitProgram: expected a field access")
}

// True if `exprIx` is a re-readable place — a bare name, or a `.`/`?.` chain bottoming out
// in a name. Such a receiver is an effect-free `local.get`/`struct.get` sequence, so
// `recv?.f ?? d` may read it twice without duplicating side effects.
function optRecvReReadable(exprIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is Ident { return true }
  if e is Member { return optRecvReReadable(e.memObj) }

  if e is OptMember { return optRecvReReadable(e.omObj) }
  false
}

// Push 1 if the optional-chain value at `exprIx` is null — any null link folds `null`
// through — else 0. A code-15 leaf tests its own ref; a code-16 value-union box leaf
// compares the box tag against the global null tag (the box ref itself is never null);
// any other leaf is never null once every link held.
function emitOptChainIsNull(body: i32[], exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is OptMember {
    const psi = optChainStructIdxOf(e.omObj, fnIx)
    if psi < 0 {
      return emitFail("emitProgram: `?.` receiver is not a struct chain")
    }
    const pfi = sFieldIndex(psi, e.omProp)
    if pfi < 0 {
      return emitFail("emitProgram: `?.` field is not on the struct")
    }
    if emitOptChainIsNull(body, e.omObj, fnIx) < 0 { return -1 }
    fbIf(127)
    ctrlEnter()
    fbI32Const(1)
    fbElse()
    const pfc = sFieldTypeAt(psi, pfi)
    if pfc == 15 {
      if emitOptChainValue(body, e.omObj, fnIx) < 0 { return -1 }
      fbStructGet(sHeapIdx[psi], pfi)
      wU8(209)
    } else if pfc == 16 {
      if emitOptChainValue(body, e.omObj, fnIx) < 0 { return -1 }
      fbStructGet(sHeapIdx[psi], pfi)
      fbStructGet(uBoxIdx, 0)
      fbI32Const(nullBoxTag())
      fbI32Bin(70)
    } else {
      fbI32Const(0)
    }
    fbEnd()
    ctrlLeave()
    return 0
  }
  if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
  wU8(209)
  0
}

// Push the non-null value of the optional-chain receiver at `exprIx`, assuming every link
// is already null-tested: each nullable link recovers `ref.as_non_null`. Sole-member
// niches only — a nullable box must not be recovered here, since this also feeds the `is`
// receiver and a `Shape | null` box is legitimately null at the moment its tag is tested.
function emitOptChainValue(body: i32[], exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is OptMember {
    const psi = optChainStructIdxOf(e.omObj, fnIx)
    if psi < 0 {
      return emitFail("emitProgram: `?.` receiver is not a struct chain")
    }
    const pfi = sFieldIndex(psi, e.omProp)
    if pfi < 0 {
      return emitFail("emitProgram: `?.` field is not on the struct")
    }
    if emitOptChainValue(body, e.omObj, fnIx) < 0 { return -1 }
    fbStructGet(sHeapIdx[psi], pfi)
    fbRefAsNonNull()
    return 0
  }
  if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
  if exprNullableRefNiche(exprIx, fnIx) { fbRefAsNonNull() }
  0
}

// Lower a standalone optional chain `recv?.f` — in ordinary value position (a `const`/`let`
// initializer, an argument, a `??` left side) — as the value of its own recorded type
// `F | null`. The shape is the fused `?? d` two-arm select with the default replaced by the
// null of the result's own rep, so the arms below dispatch on rep (`repOfNode`), not field.
function emitOptMemberValue(body: i32[], exprIx: i32, fnIx: i32) {
  const e = P.nodes[unwrapParen(exprIx)]
  if e is OptMember {
    if !optRecvReReadable(e.omObj) {
      return emitFailAt(
        "emitProgram: `?.` needs a re-readable receiver (a name, or a field chain of names)",
        exprIx,
      )
    }
    const osi = optChainStructIdxOf(e.omObj, fnIx)
    if osi < 0 {
      return emitFailAt(
        "emitProgram: `?.` receiver is not a struct chain",
        exprIx,
      )
    }
    const ofi = sFieldIndex(osi, e.omProp)
    if ofi < 0 {
      return emitFailAt("emitProgram: `?.` field is not on the struct", exprIx)
    }
    const oCode = sFieldTypeAt(osi, ofi)

    // The nested-struct leaf (code 15), the arm the `?.` producer needs (D1084). `o?.f` over
    // `o: T | null` with `T = {f: S}` has type `S | null`, and the rep for that is the nullable
    // struct ref the whole `nulstruct` family already speaks.

    // Shape-identical to the `nulstr` arm below it, with the field's own target struct as the
    // heap type instead of the string array: a null receiver chain yields `ref.null $S`, a live
    // one reads the field. The `else` arm leaves a `(ref $S)`, a subtype of the block's
    // `(ref null $S)`, so the arms join without a cast. `structIndexOfExpr` is the other half.
    if oCode == 15 {
      const oti = sFieldTgtStructIdx(osi, ofi)
      if oti < 0 {
        return emitFailAt(
          "emitProgram: `?.` yields a nullable struct whose field names no struct row",
          exprIx,
        )
      }
      if emitOptChainIsNull(body, exprIx, fnIx) < 0 { return -1 }
      fbIfRefNul(sHeapIdx[oti], true)
      ctrlEnter()
      fbRefNull(sHeapIdx[oti])
      fbElse()
      if emitOptChainValue(body, e.omObj, fnIx) < 0 { return -1 }
      fbStructGet(sHeapIdx[osi], ofi)
      fbEnd()
      ctrlLeave()
      return 0
    }
    if oCode != 0 && oCode != 3 && oCode != 20 && oCode != 16 {
      return emitFailAt(
        "emitProgram: a standalone `?.` supports only i32/boolean and string leaf fields — read it through `?? d` or a `!= null` guard",
        exprIx,
      )
    }
    const ord = repOfNode(exprIx)

    // `boolean | null` shares one unconditional i32 blocktype: the sentinel 2 (`null`) and
    // the live 0/1 result are the same valtype, so the two arms below need no cast to join.
    if ord.rdKind == "i32" && ord.rdNul == 2 {
      if emitOptChainIsNull(body, exprIx, fnIx) < 0 { return -1 }
      fbIf(127)
      ctrlEnter()
      fbI32Const(2)
      fbElse()
      if emitOptChainValue(body, e.omObj, fnIx) < 0 { return -1 }
      fbStructGet(sHeapIdx[osi], ofi)
      fbEnd()
      ctrlLeave()
      return 0
    }

    // `i32 | null` (and a boxed code-16 leaf) rides the `{tag, payload}` box, `null` as the
    // null tag over an unread payload; both heap types are usage-gated against an uncollected union.
    if oCode == 16 || (ord.rdKind == "union" && ord.rdNul == 4) {
      const ovb = vbHeapIdxOfKind(0)
      if !uDeclared || (oCode != 16 && ovb < 0) {
        return emitFailAt(
          "emitProgram: `?.` yields a nullable scalar but its union box was not collected",
          exprIx,
        )
      }
      if emitOptChainIsNull(body, exprIx, fnIx) < 0 { return -1 }
      wU8(4)
      fbValtype("union", -1)
      ctrlEnter()
      fbI32Const(nullBoxTag())
      fbRefNullNone()
      fbStructNew(uBoxIdx)
      fbElse()
      if oCode == 16 {
        if emitOptChainValue(body, e.omObj, fnIx) < 0 { return -1 }
        fbStructGet(sHeapIdx[osi], ofi)
        fbEnd()
        ctrlLeave()
        return 0
      }
      fbI32Const(scalarTagOfKind(0))
      if emitOptChainValue(body, e.omObj, fnIx) < 0 { return -1 }
      fbStructGet(sHeapIdx[osi], ofi)
      fbStructNew(ovb)
      fbStructNew(uBoxIdx)
      fbEnd()
      ctrlLeave()
      return 0
    }

    // `string | null` is the nullable raw-array ref niche, so a null link is `ref.null
    // $sTypeIdx` and a present one the field's own string — no box needed.
    if oCode == 20 || (ord.rdKind == "nulstr" && ord.rdNul == 1) {
      if !aUsed {
        return emitFailAt(
          "emitProgram: `?.` yields a nullable string but the string array type was not collected",
          exprIx,
        )
      }
      if emitOptChainIsNull(body, exprIx, fnIx) < 0 { return -1 }
      fbIfRefNul(sTypeIdx, true)
      ctrlEnter()
      fbRefNull(sTypeIdx)
      fbElse()
      if emitOptChainValue(body, e.omObj, fnIx) < 0 { return -1 }
      fbStructGet(sHeapIdx[osi], ofi)
      fbEnd()
      ctrlLeave()
      return 0
    }
    return emitFailAt(
      "emitProgram: a standalone `?.` has no rep for this result type — read it through `?? d` or a `!= null` guard",
      exprIx,
    )
  }
  emitFailAt("emitProgram: expected an optional-chain member access", exprIx)
}

// Does the function being emitted declare type parameters? The dead-atom elision is
// bounded to these: only a generic instance can carry an `is` arm the instantiation makes
// constant-false, and only there is the name-keyed union lookup single-valued.
function fnHasTyParams(fnIx: i32): boolean {
  const fp = fnStmtsPosOf(fnIx)
  if fp < 0 { return false }
  if fp >= fnStmts.length { return false }
  const f = P.nodes[fnStmts[fp]]
  if f is FuncDecl {
    if f.fnTyParams.length > 0 { return true }
  }
  // A monomorphized instance has no type params of its own — `mkFunc(instName, noTyParams, …)`
  // strips them — so the instance must be recognised through its template. Without this the
  // bound never fires for the very shape it exists to admit.
  if fp < monoOrigNode.length {
    const o = monoOrigNode[fp]
    if o >= 0 {
      const of = P.nodes[o]
      if of is FuncDecl { return of.fnTyParams.length > 0 }
    }
  }
  false
}

// Push the raw union box ref of binding `name` (a local, param or module global), bypassing
// the narrowed-unbox Ident path so a tag read works even while the binding is narrowed to a
// single atom — its slot still holds the box, narrowing being type-level only.
function emitUnionBoxPush(_body: i32[], name: string, fnIx: i32) {
  const idx = localIndexOf(fnIx, name)
  if idx >= 0 {
    fbLocalGet(idx)
  } else {
    // A captured union box: read the field raw out of the env (`recover` false — the box is
    // the field's type, and the unbox every caller appends after this push is the recovery).
    // The narrowing that makes such a read an unbox is the closure's declaration-site
    // narrowing, replayed onto the narrowing stack by `capNarrowSeed`.
    if emitCapturedRead(_body, name, fnIx, false) == 1 { return 0 }
    const gIdx = globalIndexOf(name)
    if gIdx < 0 {
      // Neither a local, a capture of this frame, nor a global — nothing to read the box
      // out of. A clean reject, not invalid wasm.
      return emitFail(
        "emitProgram: narrowed union binding is not a local or global",
      )
    }
    if emitUserGlobalGet(gIdx) < 0 { return -1 }
    // A non-const global box rides in a NULLABLE cell (start-fn initialized);
    // recover the non-null box ref (same as the plain Ident global read).
    if globalNameIsNonConst(name) {
      wU8(212) // 0xd4 ref.as_non_null
    }
  }
  0
}

// The list wrapper heap type a value-union list atom of kind `k` rides in the box's `anyref`
// payload — directly, with no scalar value box (the `is`-narrow casts to it, the coerce stores
// it) — or -1 when `k` is not a list kind.

// Keyed on the atom's kind, not on its rendered spelling: kind 7 is exactly the i32-list
// backings (`i32[]`, `boolean[]`, a litunion `K[]`, the `(boolean | null)[]` and `(K | null)[]`
// niches), kind 9 exactly the string-list backings, and kinds 8 / 10 / 12 arise only from the
// spellings `f64[]` / `i64[]` / `f32[]`. The caller already needs the kind for its tag.
function listWrapHeapOfKind(k: i32) {
  if k == 7 { return lTypeIdx }
  if k == 8 { return fl64TypeIdx }
  if k == 9 { return mkListIdx }
  if k == 10 { return il64TypeIdx }
  if k == 12 { return fl32TypeIdx }
  // The packed byte list rides the box's anyref as its own `{backing, len, cap}` wrapper like
  // the five above; only its backing's element is the packed `i8` storage type. `ba8Used` is
  // the guard, not a convenience: `uAtomBandTop` lifts the slot bands off it, so a kind-13 tag
  // without it collides with `refArrSlotTag(0)` and names a heap type the module never interned.
  if k == 13 {
    if !ba8Used { return -1 }
    return bl8TypeIdx
  }
  -1
}

// The banked value-atom kind of the single member left when `null` is removed from the member
// set `s` — the structural form of `valueAtomKind(removeAtomFromSet(set, "null"))`, which four
// `… | null` peeling sites ask. `msSubNull` clears the null members' bits structurally, so the
// residual set keeps its identity rather than being rendered and re-parsed for the ABI code.

// A singleton yields the member's kind straight out of the bank `recordUnMemTys` filled, a
// non-singleton -1, and -2 means the pool does not cover the set — a narrowed subset spelling
// it never interned — so the caller keeps its rendered-atom path. Takes a set id, never a text.
function unionResidualSoloKindOfSet(s: i32) {
  if s < 0 { return -2 }
  msSoloValKind(msSubNull(s))
}

// Is this union a value union — the box question, asked of the interned member set the caller
// already resolved, and of the spelling only where the pool declines. `msIsValueUnion` reads
// the member ABI codes off the bank, where the name path scans the whole rendering twice and
// materializes every atom for the same predicate.

// The set id is not resolved here, on purpose: `msSetOfText` costs two map probes and, on a
// first miss, a linear scan of every registered row. The name fallback resolves a declared
// alias first — `isValueUnionName` splits at top-level `|`, so `type WN = N | string` is one
// atom of kind -1 and answers no where the inline spelling answers yes.
function isValueUnionOfSet(s: i32, nm: string): boolean {
  const v = msIsValueUnion(s)
  if v >= 0 { return v == 1 }
  isValueUnionName(unionMemberSetOf(nm))
}

// True if a value-union atom of kind `k` is a ref that rides the box's anyref `value` directly
// with no per-rep scalar value box: a string (kind 2 — `valueAtomKind` answers 2 for the
// spelling `string` and nothing else), any list type, or a closure (kind 11 — the fat-pointer
// struct is a `structref` subtype, so it stores into the box's anyref slot as-is).
function atomIsRefKind(k: i32) {
  if k == 2 { return true }
  if k == 11 { return true }
  return listWrapHeapOfKind(k) >= 0
}

// Lower a narrowed value-union ident read `name` (active narrowing = a single scalar member,
// arriving as its ABI kind `ak`): push the box, `struct.get $box 1` for the `anyref` payload,
// then recover the atom's rep — a `ref.cast (ref $sTypeIdx)` for a string payload, stored
// unboxed, or a `ref.cast (ref $vb)` plus `struct.get $vb 0` for a scalar in its value box.
function emitValueUnionUnboxRead(
  body: i32[],
  name: string,
  ak: i32,
  fnIx: i32,
) {
  if emitUnionBoxPush(body, name, fnIx) < 0 { return -1 }
  emitUnionUnboxTail(ak)
}

// The unbox, from a box already on the stack. Extracted from `emitValueUnionUnboxRead` so the
// union `as` cast — whose operand is an expression, not a named binding, and so cannot use
// `emitUnionBoxPush` — recovers an arm the same way a narrowed read does. Two ladders would be
// two chances to disagree about a payload's rep, which in this area is invalid wasm.

// The atom's ABI code decides all four arms (the `string` compare, the closure test, the
// list-wrapper ladder, `vbHeapIdxOfAtom`), so `ak` arrives as the code: `emitCoalesce` holds it
// out of the bank rather than rendering a set to be re-parsed here.
function emitUnionUnboxTail(ak: i32) {
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  if ak == 2 {
    fbRefCast(sTypeIdx) // the payload IS the string array ref
    return 0
  }
  // A CLOSURE atom's payload IS the closure fat-pointer struct — recover it from the box's
  // anyref slot so a narrowed `x is (() => i64)` read yields the callable fat pointer.
  if ak == 11 {
    fbRefCast(cloStructIdx)
    return 0
  }
  const lw = listWrapHeapOfKind(ak)
  if lw >= 0 {
    fbRefCast(lw) // the payload IS the list WRAPPER ref
    return 0
  }
  const vb = vbHeapIdxOfKind(ak)
  if vb < 0 {
    return emitFail("emitProgram: narrowed union atom has no value box")
  }
  fbRefCast(vb)      // 0xfb 0x16 <value box>
  fbStructGet(vb, 0) // the scalar payload
  0
}

// The container half of a place-narrowed union read, from a box already on the stack — the
// member/index place dual of `emitRefArrayUnionUnboxRead` and `emitMapUnionUnboxRead`, which
// both push the box themselves from a name. 1 = a recovery is emitted, 0 = the place carries no
// live container narrowing and the caller leaves the box alone, -1 = a recorded failure.

// The heap type comes from the classifier the consumer already asked, not from a second
// derivation off the narrow stack: `refListSlotOfExprStrict` and `mapShapeOfExpr` are the
// functions `forInElemKind`, `emitIndex` and `emitMapPrep` type themselves against, so a
// delivery casting to a different row than the consumer expects is not expressible here.
function emitPlaceNarrowContainerUnbox(exprIx: i32, fnIx: i32): i32 {
  if narrowedRefArrayOfPlace(exprIx) != "" {
    const slot = refListSlotOfExprStrict(exprIx, fnIx)
    if slot < 0 || slot >= rlWrapIdx.length {
      return emitFail(
        "emitProgram: narrowed union place ref-array arm has no reflist slot",
      )
    }
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    fbRefCast(rlWrapIdx[slot]) // the payload IS the arm's list wrapper
    return 1
  }
  if narrowedMapOfPlace(exprIx) != "" {
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    // `mapShapeOfExpr` answers the mono sentinel -1 for an atom-valued map exactly as the
    // name resolver does, and `mapTypeIdxOf(-1)` is the shared `$mStructIdx` — so the miss
    // and the hit agree here for the same reason they do in `emitMapUnionUnboxRead`.
    fbRefCast(mapTypeIdxOf(mapShapeOfExpr(exprIx, fnIx)))
    return 1
  }
  0
}

// Recover the reflist wrapper ref a union binding narrowed to a ref-element array arm holds
// (`x[i]` or `x.length` under `if x is S[]`): push the box, read its `anyref` value (field 1),
// `ref.cast` it to the arm's reflist wrapper heap. The result is the `(ref $rlWrap)` the normal
// indexing and `.length` machinery consumes, where `emitUnionCoerce` stored it.
function emitRefArrayUnionUnboxRead(body: i32[], name: string, fnIx: i32) {
  if emitUnionBoxPush(body, name, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  // Destringify D-ISTY: the arm's reflist slot comes from the TYPE the narrowing
  // banked (`is S[]` recorded `S[]`'s arena index), not from slicing the element
  // spelling back out of the rendered arm name and re-resolving it.
  const slot = rlSlotOfTy(tyRefArrElemOf(narrowedArmTyOf(name)))
  if slot < 0 {
    return emitFail("emitProgram: narrowed ref-array arm has no reflist slot")
  }
  fbRefCast(rlWrapIdx[slot]) // 0xfb 0x16 <reflist wrapper> — the payload IS the wrapper ref
  0
}

// Recover the map struct ref a union binding narrowed to a map arm holds (`x[k]` or `x.has(k)`
// under an `is` guard naming the map arm): push the box, read its `anyref` value (field 1),
// `ref.cast` to the arm's per-value map struct heap (`mapTypeIdxOf`; the mono `$mStructIdx` for
// an i32 or atom value). The result is the `(ref $mapStruct)` a bare map binding pushes.
function emitMapUnionUnboxRead(body: i32[], name: string, fnIx: i32) {
  if emitUnionBoxPush(body, name, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  // The arm's map-value slot comes from the type the narrowing banked, not from slicing
  // `{[K]: V}`'s value text out of the rendered arm name. `mvSlotOfTy` answers -1 for an
  // un-interned value exactly as the name resolver does for a mono or atom-valued map, and
  // `mapTypeIdxOf(-1)` is that shared `$mStructIdx`, so the two legs agree on the miss too.
  const armTy = narrowedArmTyOf(name)
  const slot = mvSlotOfValTyK(tyMapValOf(armTy), tyMapKeyIsI32(armTy))
  fbRefCast(mapTypeIdxOf(slot)) // the payload IS the map struct ref
  0
}

// Route a list literal flowing into a union whose matching arm is a union-box-element
// ref-array (`(i32 | string)[] | {w: i32}`) through that arm's build: thread
// `pendingListKind = 2` and the arm's reflist slot so `emitArr` boxes each element into the
// union box, then tag the wrapper with the arm's slot tag.

// Needed because the literal's own classification is a scalar list or a concrete struct list,
// neither of which interns the arm's slot, so `emitUnionCoerce`'s slot-match path misses. The
// union's own value-atom list arm still wins, guarded by `unionHasAtom`. Returns 1 = handled,
// 0 = not applicable, -1 = error.
function emitUnionListLitViaRefArm(
  body: i32[],
  unionName: string,
  exprIx: i32,
  fnIx: i32,
) {
  if unionName == "" { return 0 }
  const bare = P.nodes[unwrapParen(exprIx)]
  if bare is ArrayLit {
    // Classify the FIRST element's member ATOM (the arm-choice key; each element still
    // coerces independently inside the build). An element this static probe cannot name
    // (a nested list / map) bails to the caller's existing paths.
    let elemAtom = ""
    // Hoisted: the empty-`[]` branch below shares the arm-slot resolution at the bottom.
    let selfArm = false
    let selfSlot = 0 - 1
    if bare.arrElems.length >= 1 {
      const e0 = bare.arrElems[0]
      // D1016 — a nested list or map element is unnameable by the probe above, and a
      // self-referential union has exactly the arm that admits it: `Json[]`'s element type is
      // `Json` itself, so every element is a legal member and `pendingListKind = 2` boxes it
      // as one — the same recursive step the annotated binding performs. No such arm: bail.
      if exprArray(e0, fnIx) || exprRefArray(e0, fnIx) || exprMap(e0, fnIx) {
        selfSlot = unionRefArrayArmSlotForNestedElem(
          unionName,
          exprMap(e0, fnIx),
        )
        if selfSlot < 0 { return 0 }
        selfArm = true
      }
      if selfArm {
        // the arm is already chosen — the value-atom ladder below must not reclaim it
      } else if exprString(e0, fnIx) {
        elemAtom = "string"
      } else if exprIsBool(e0, fnIx) {
        elemAtom = "boolean"
      } else if exprIsF64(e0, fnIx) {
        elemAtom = "f64"
      } else if exprIsI64(e0, fnIx) {
        elemAtom = "i64"
      } else {
        const e0b = P.nodes[unwrapParen(e0)]
        if e0b is ObjLit {
          elemAtom = objVariantName(unwrapParen(e0))
          if elemAtom == "" { return 0 }
        } else {
          elemAtom = "i32" // the ladder's own integer default
        }
      }
      // The union's own value-atom LIST arm is the exact match — let the ladder box it.
      // Not for the self-referential arm: `Json` names the union, and asking whether it has
      // a `Json[]` value atom is asking about the arm we just picked.
      if !selfArm {
        if unionHasAtomTy(unionName, elemAtom, true) { return 0 }
      }
    } else {
      // An EMPTY `[]`: only route when NO value-atom list arm could claim it.
      if (
        unionHasAtomTy(unionName, "i32", true) ||
        unionHasAtomTy(unionName, "boolean", true) ||
        unionHasAtomTy(unionName, "string", true) ||
        unionHasAtomTy(unionName, "f64", true) ||
        unionHasAtomTy(unionName, "i64", true) ||
        unionHasAtomTy(unionName, "f32", true)
      ) {
        return 0
      }
    }
    let armSlot = unionRefArrayArmSlotForElem(unionName, elemAtom)
    if selfArm { armSlot = selfSlot }
    if armSlot < 0 { return 0 }
    fbI32Const(refArrSlotTag(armSlot))
    const savedK = pendingListKind
    const savedS = pendingListSlot
    pendingListKind = 2
    pendingListSlot = armSlot
    const rc = emitExpr(body, exprIx, fnIx)
    pendingListKind = savedK
    pendingListSlot = savedS
    if rc < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
    return 1
  }
  0
}

// Route an array-literal union carrier into the union's single nested-array arm
// (`string[][] | string`, `i64[][] | boolean | null` — `unionNestedArrayArmSlot`): tag with the
// arm's slot and build the literal with the arm's ref-list slot threaded (`pendingListKind = 1`
// plus the slot, the threading an annotated `T[][]` binding uses).

// Each inner list then builds the arm's leaf: an `i64[][]` arm widens bare-int leaves at the
// store, and a `string[][]` arm builds string inner lists, which `exprRefArray` cannot see so
// the ref-array carrier path misses them. Returns 1 when routed, 0 when the union has no
// unambiguous nested-array arm and the caller keeps its loud reject, -1 on a failure.
function emitUnionNestedListLit(
  body: i32[],
  unionName: string,
  exprIx: i32,
  fnIx: i32,
) {
  const bare = P.nodes[unwrapParen(exprIx)]
  if bare is ArrayLit {
    const armSlot = unionNestedArrayArmSlot(unionName)
    if armSlot < 0 { return 0 }
    fbI32Const(refArrSlotTag(armSlot))
    const savedK = pendingListKind
    const savedS = pendingListSlot
    pendingListKind = 1
    pendingListSlot = armSlot
    const rc = emitExpr(body, exprIx, fnIx)
    pendingListKind = savedK
    pendingListSlot = savedS
    if rc < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
    return 1
  }
  0
}

// The function type a closure carrier boxed into `unionName` tags as — the box side of
// `cloArmTagOfTy`, whose test side is `isArmTagOfTy`.

// The value's own checked type is the answer, not the union's arm: a union may carry several
// function-typed arms, and taking the arm makes every one of them box under the first arm's tag
// (D6). The union's own arm is the fallback, for a carrier the checker banked no function type
// for; a union with one function arm tags the same either way.
function cloBoxArmTy(exprIx: i32, unionName: string): i32 {
  const vt = nodeTyIxOf(exprIx)
  if unMemIsFunc(vt) { return vt }
  const bt = nodeTyIxOf(unwrapParen(exprIx))
  if unMemIsFunc(bt) { return bt }
  unionClosureArmTy(unionName)
}

// `emitUnionCoerce` lowers an expression coerced into the boxed union's representation (a
// binding init, an assignment, an argument, a return): pass-through when the value already is
// the box, a bare `null` as the null tag over a `ref.null` payload, a raw scalar or string as
// its atom's tag and payload, an object literal through `emitUnionBox`'s `uDeclared` path.

// D1029 — the map arm's re-box: the arm's tag, the map ref, one `struct.new`. Returns 1
// handled, 0 not a map arm, -1 on error. A value narrowed to the union's map arm reads unboxed
// in that scope, so delivering it to a destination typed at the union has to put the box back.
// One home, because a map-value store reaches only `emitUnionBoxArg`, not `emitUnionCoerce`.
function emitUnionMapArmBox(
  body: i32[],
  unionName: string,
  exprIx: i32,
  fnIx: i32,
): i32 {
  if unionName == "" { return 0 }
  if !exprMap(exprIx, fnIx) { return 0 }
  const sh = mapShapeOfExpr(exprIx, fnIx)
  const tag = mapSlotTag(sh)
  if tag < 0 { return 0 }
  if !unionHasMapArmSlot(unionName, sh) { return 0 }
  fbI32Const(tag)
  if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
  fbStructNew(uBoxIdx) // { tag, map struct ref }
  1
}

export function emitUnionCoerce(
  body: i32[],
  unionNameIn: string,
  exprIx: i32,
  fnIx: i32,
) {
  // Resolve a union ALIAS (`type Tagged = {x:i32} | string`) to its pipe-joined member set
  // so the value-atom boxing below (`unionHasValueAtom`/`unionHasAtom`/the atom ladder) sees
  // the atoms — an alias name has no `|` to split. An INLINE union name (already a member
  // set) and a non-union name resolve to "" and pass through unchanged.
  let unionName = unionNameIn
  const ums = unionMemberSetOf(unionName)
  if ums != "" { unionName = ums }
  const bareIx = unwrapParen(exprIx)
  const bare = P.nodes[bareIx]
  // An if-expression join (`return if c { catVal } else { dogVal }`): each arm is a distinct
  // union member, so the join cannot ride a single numeric blocktype — emit a value-typed `if`
  // whose result is the union box, union-coercing each arm. Without this the join defaults to
  // an i32 blocktype over ref arms, which is invalid wasm.

  // D969 — ahead of the `exprUnion` raw-pass below, and the order is the whole point. An
  // if-expression that is already a union value hits the raw pass first and is emitted by
  // `emitExpr`, which picks the join's blocktype from the arms' scalar ladder. Only this arm
  // knows the blocktype has to be the box, so it must be asked first.
  if bare is IfStmt { return emitUnionIfValue(body, unionName, bareIx, fnIx) }
  if exprUnion(exprIx, fnIx) { return emitExpr(body, exprIx, fnIx) }
  if bare is NullLit {
    fbI32Const(nullBoxTag())
    fbRefNullNone() // the payload slot is unread under the null tag
    fbStructNew(uBoxIdx)
    return 0
  }
  // D1576 — a `null`-typed value at a box destination is the same null-tagged box, with the
  // value in the payload slot instead of a fresh `ref.null none`: `nullref` is an `anyref`, so
  // it rides the slot the null tag leaves unread and a call's side effects still happen. The
  // binding twin of `emitUnionBoxArg`'s arm, which is the argument boundary's.
  if exprIsNulNone(exprIx, fnIx) {
    fbI32Const(nullBoxTag())
    if emitNulNoneBoxPayload(body, exprIx, fnIx) < 0 { return -1 }
    fbStructNew(uBoxIdx)
    return 0
  }
  // A STRUCT value (an object literal, or a struct-typed expr) auto-boxes through
  // `emitExpr`'s `uDeclared` variant path; only a SCALAR value is value-boxed below.
  // This is what lets a MIXED union (`A | i32`) coerce either kind of member: an object
  // arm boxes as a variant struct, a scalar arm as a value box.
  if bare is ObjLit {
    // The target union's own arms are tried first (`unionArmVariantForObj`): the global scan
    // below picks the first field-name-set match across all unions, which can land on another
    // union's arm sharing the names — two nested-struct arms differing only in the nested
    // layout collide onto the first arm's tag. A single-union program resolves either way.
    const ctxVi = unionArmVariantForObj(unionName, bareIx)
    if ctxVi >= 0 { return emitUnionBoxAs(body, bareIx, ctxVi, fnIx) }
    // When the literal matches a union variant, box it as that variant directly rather than
    // routing through `emitExpr` — whose `structIndexOfObj` re-inference mis-resolves a
    // field-name collision with an enclosing struct to the outer struct, emitting invalid
    // wasm. `objVariantName` is `emitObjLitNode`'s own resolution, only reordered ahead.
    if objVariantName(bareIx) != "" { return emitUnionBox(body, bareIx, fnIx) }
    return emitExpr(body, exprIx, fnIx)
  }
  // A struct-typed ident or call result that is a variant arm of `unionName` but is built as
  // the plain struct — a distinct heap type from the arm's variant struct — would pass raw
  // where the box wants the variant struct. Re-box it against the matched arm
  // (`emitStructExprAsVariantBox`). Gated on the heaps differing, so a deduped shape is raw.
  if unionName != "" && exprStruct(exprIx, fnIx) {
    const rbVi = unionArmVariantForStructExpr(unionName, exprIx, fnIx)
    if rbVi >= 0 {
      const rbSsi = structIndexOfExpr(exprIx, fnIx)
      if rbSsi >= 0 {
        if sHeapIdx[rbSsi] != uVarHeap[rbVi] {
          return emitStructExprAsVariantBox(body, exprIx, rbVi, rbSsi, fnIx)
        }
        // The heaps agreeing is not a reason to pass raw (D281). The test above answers "must
        // the payload be rebuilt onto another heap type"; the fall-through below answers "is
        // this value already box-shaped". With the cross-table merge (`uVarSTwin`) the equal
        // branch is reachable, and raw-passing a `(ref $arm)` into a box cell is invalid wasm.
        fbI32Const(uTags[rbVi]) // 0x41 i32.const <variant tag> (program-global)
        if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
        fbStructNew(uBoxIdx) // { tag, variant-ref }
        return 0
      }
    }
  }
  if exprStruct(exprIx, fnIx) { return emitExpr(body, exprIx, fnIx) }
  // A bare variant value (a kind-8 local, param or call, its binding classified concrete by
  // `letIsVariant`) passes through: the binding's slot is the raw variant ref. Without this a
  // union carrying a value atom drops the variant ref into the scalar atom ladder and widens
  // it. A box-typed position routes through `emitUnionBoxArg`, which boxes before deferring.
  if exprVariantIndex(exprIx, fnIx) >= 0 { return emitExpr(body, exprIx, fnIx) }
  // A map carrier flowing into a union with a matching map arm: the map struct ref rides the
  // box anyref directly, like a reflist wrapper, tagged by its interned value slot
  // (`mapSlotTag`). Checked before the value-atom gate below — such a union may have no value
  // atom, so that gate would bail and emit the raw map ref where a `(ref $uBox)` is expected.
  if unionName != "" && exprMap(exprIx, fnIx) {
    let mSlot = mapShapeOfExpr(exprIx, fnIx)
    if mSlot == -2 {
      mSlot = -1 // a Set rides the mono map slot
    }
    if mSlot >= -1 && unionHasMapArmSlot(unionName, mSlot) {
      fbI32Const(mapSlotTag(mSlot))
      if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
      fbStructNew(uBoxIdx) // { tag, map-struct ref }
      return 0
    }
    // A mono litunion-valued map whose union arm registered through a rendered spelling: the
    // checker render widens a litunion map value to `string`, so the arm interned the
    // string-map slot and the slot match above misses, though the collapsed arm is this
    // value's arm. Box the mono map ref under the mono tag, so store and narrow read one tag.
    if (
      mSlot == -1 &&
      nodeTyMapValIsLitUnion(bareIx) &&
      unionHasCollapsedStringMapArm(unionName)
    ) {
      fbI32Const(mapSlotTag(-1))
      if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
      fbStructNew(uBoxIdx) // { tag, mono map-struct ref }
      return 0
    }
  }
  // A map carrier the union does not box (a checker-impossible slot mismatch, or an
  // unsupported map value type `mapShapeOfExpr` returns -3 for): fail loudly rather than
  // default the tag and let every later `is` silently miss.
  if exprMap(exprIx, fnIx) {
    return emitFail(
      "emitProgram: a map value is not a supported union member — use a struct member instead",
    )
  }
  // D1029 — the map arm's re-box, the rung the ref-array arm below already has. A value
  // narrowed to the union's map arm reads unboxed in that scope, so delivering it to a
  // destination typed at the union has to put the box back: the arm's tag, the map ref,
  // `struct.new`. Written as the exact mirror of the ref-array rung so the two stay one shape.
  const d29 = emitUnionMapArmBox(body, unionName, exprIx, fnIx)
  if d29 < 0 { return -1 }
  if d29 == 1 { return 0 }
  // A ref-element array carrier (`S[]`, `(() => f64)[]`, `(C | D)[]`) flowing into a union with
  // a matching ref-array arm: the reflist wrapper ref rides the box anyref directly, tagged by
  // its interned slot (`refArrSlotTag`). Checked before the value-atom gate below — such a union
  // may have no value atom, so that gate would bail and emit the raw wrapper ref.
  if unionName != "" && exprRefArray(exprIx, fnIx) {
    const raSlot = refListSlotOfExpr(exprIx, fnIx)
    if unionHasRefArrayArmSlot(unionName, raSlot) {
      fbI32Const(refArrSlotTag(raSlot))
      if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
      fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
      return 0
    }
    // A ref-array LITERAL whose own slot mismatches (`[{a:1}]` self-classifies as the
    // concrete `C[]` while the arm is `(C | D)[]`): route it through the union-box-element
    // arm's build if one admits its element.
    const viaArm = emitUnionListLitViaRefArm(body, unionName, exprIx, fnIx)
    if viaArm < 0 { return -1 }
    if viaArm == 1 { return 0 }
    // A ref-array LITERAL whose interned slot matches no arm but whose union has ONE
    // nested-array arm (`[[50183]]` self-classified `i32[][]` into `i64[][] | boolean |
    // null`): rebuild it through the ARM's slot — the arm's inner-list build widens the
    // bare-int leaves at the store (`emitExprAsI64`), so no in-place re-encode is needed.
    const viaNest = emitUnionNestedListLit(body, unionName, exprIx, fnIx)
    if viaNest < 0 { return -1 }
    if viaNest == 1 { return 0 }
    // A ref-element array carrier whose interned slot matches no ref-array arm of the union:
    // a non-literal carrier whose built leaves cannot re-encode in place, or an ambiguous or
    // absent arm. A ref array can only ride the box as a wrapper ref, so with no arm to carry
    // it there is no sound rep — fail loudly rather than mis-box it through the scalar ladder.
    return emitFail(
      "emitProgram: array value does not match any array member of the union (leaf-scalar widening across a nested array is unsupported)",
    )
  }
  // An array literal whose element is a map (`[m]`) flowing into a union with an array-of-map
  // arm: the arm's reflist element is the map type, but a map-valued literal element is
  // invisible to `exprRefArray` and `arrLitElemName`, which resolve an inline-struct element and
  // not a map ident, so the ref-array arm path above is skipped.

  // Route it through the arm's build: the element's map shape (`mapShapeOfExpr`, mono -1 or a
  // typed mv slot) picks the arm whose element map has the same canonical value rep, the literal
  // builds with the arm's reflist slot threaded, and the wrapper takes the arm's slot tag. A
  // literal matching no arm keeps the loud reject; falling through would be invalid wasm.
  if unionName != "" && bare is ArrayLit {
    if bare.arrElems.length >= 1 && exprMap(bare.arrElems[0], fnIx) {
      const mapArmSlot = unionRefArrayArmSlotForMapElem(
        unionName,
        mapShapeOfExpr(bare.arrElems[0], fnIx),
      )
      if mapArmSlot >= 0 {
        fbI32Const(refArrSlotTag(mapArmSlot))
        const savedMK = pendingListKind
        const savedMS = pendingListSlot
        pendingListKind = 1
        pendingListSlot = mapArmSlot
        const mrc = emitExpr(body, exprIx, fnIx)
        pendingListKind = savedMK
        pendingListSlot = savedMS
        if mrc < 0 { return -1 }
        fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
        return 0
      }
      // D1016 — before refusing, try the arm whose element is a union carrying a map atom.
      // `unionRefArrayArmSlotForMapElem` above looks for an array-of-map arm, and `Json[]` is
      // not one: its element is the union `Json`, which merely has a map among its atoms. The
      // arm's build boxes each element into the union box (`pendingListKind = 2`).
      const nmSlot = unionRefArrayArmSlotForNestedElem(unionName, true)
      if nmSlot >= 0 {
        fbI32Const(refArrSlotTag(nmSlot))
        const savedNK = pendingListKind
        const savedNS = pendingListSlot
        pendingListKind = 2
        pendingListSlot = nmSlot
        const nrc = emitExpr(body, exprIx, fnIx)
        pendingListKind = savedNK
        pendingListSlot = savedNS
        if nrc < 0 { return -1 }
        fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
        return 0
      }
      return emitFail(
        "emitProgram: a union arm that is an array-of-map is not yet supported — use a named element type",
      )
    }
    // A nested array literal whose leaf does not self-classify as a ref array (`[["ab"]]` — a
    // string-leaf inner makes `arrLitIsRef` false, so the `exprRefArray` carrier path above
    // misses it) flowing into a union with one nested-array arm: route through the arm's
    // build, exactly like the self-classified mismatch case.
    if bare.arrElems.length >= 1 {
      const bareE0 = P.nodes[bare.arrElems[0]]
      if bareE0 is ArrayLit {
        const viaNest2 = emitUnionNestedListLit(body, unionName, exprIx, fnIx)
        if viaNest2 < 0 { return -1 }
        if viaNest2 == 1 { return 0 }
      }
    }
  }
  // A bare closure carrier (a lambda literal or a closure-typed binding) flowing into a union
  // with a bare-closure arm: the closure fat-pointer struct, a `structref` subtype, rides the
  // box anyref directly, tagged by the closure arm's `scalarTagOf` (value-atom kind 11).
  // Checked before the ladder below, whose scalar branches would store the ref in a value box.
  if unionName != "" && exprIsClosure(exprIx, fnIx) {
    const clArm = unionClosureArmName(unionName)
    if clArm != "" {
      fbI32Const(cloArmTagOfTy(cloBoxArmTy(exprIx, unionName)))
      if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
      fbStructNew(uBoxIdx) // { tag, closure fat-pointer ref }
      return 0
    }
  }
  // A scalar-element list literal (`["a"]`, `[1]`, invisible to `exprRefArray`) whose union arm
  // is a union-box-element ref-array: route it through the arm's build and tag. Checked before
  // the value-atom gate and ladder below — the gate would emit the raw wrapper into the box
  // slot, and the ladder would tag the box with the scalar-list atom instead of the arm's tag.
  const viaListArm = emitUnionListLitViaRefArm(body, unionName, exprIx, fnIx)
  if viaListArm < 0 { return -1 }
  if viaListArm == 1 { return 0 }
  if unionName == "" || !unionHasValueAtom(unionName) {
    return emitExpr(body, exprIx, fnIx)
  }
  // A bare scalar-valued map read entering a nullable union — box it with a tag chosen by the
  // probe, rather than letting the ladder below tag a miss as present. Gated on the union
  // actually containing `null`: without a null member there is no absent to represent, so
  // `m[k]` keeps the ladder's plain boxing.

  // Above the ladder because the ladder cannot see the difference: it classifies the expression
  // (`m[k]` is an i32) and has no access to whether the key is present, so it emits an
  // unconditional value tag over the rep's empty value. For `i32` that empty value is `0`, a
  // real value. The niche-bearing value types are excluded: their empty value already means absent.
  const mrk = mapReadScalarBoxKind(exprIx, fnIx)
  if mrk >= 0 && unionSetHasNull(unionName) {
    // Only when the map's own value atom is a MEMBER of the target union. A widening
    // consumption (`{[string]: i32}` read into `i64 | null`) has to go through the
    // ladder's promotion rules, which this arm does not replicate — declining leaves it
    // exactly as it is today rather than tagging it with the wrong width.
    if unionHasAtom(unionName, scalarAtomNameOfKind(mrk)) {
      const mre = P.nodes[unwrapParen(exprIx)]
      if mre is Index {
        return emitMapGetScalarBox(body, mre.idxArr, mre.idxIndex, mrk, fnIx)
      }
    }
  }
  // An atom-typed value entering the box, above the value-atom ladder because the ladder
  // cannot classify it at all: `valueAtomKind("K")` is -1, so a `K`-typed local, param or call
  // result falls past every branch to the numeric default and every mixed spelling boxes the
  // raw id under a wrong tag or pushes an i32 at the box's `anyref` payload.

  // The value's rep is the interned i32 id and the payload is a ref, so the store widens
  // (`emitAtomToStr`) and tags kind 2, the tag `isArmTagOfTy` hands a litunion arm. The hazard
  // is the reservation scan, not this emit: `emitAtomToStr` stashes the id in the per-function
  // string-op scratch frame, whose reservation predicates key on `unionTakesAtomAsStr`.
  if unionTakesAtomAsStr(unionName) && exprIsLitAtom(exprIx, fnIx) {
    fbI32Const(scalarTagOfKind(2)) // the string tag — kind 2 rides the anyref directly
    if emitAtomToStr(body, exprIx, fnIx) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, member-string ref }
    return 0
  }
  // Classify the value's atom. Order mirrors the print-import ladder (f32 before f64 — a float
  // literal classifies f64 too; string, bool and i64 are disjoint). The default is i32 unless
  // the union has no `i32` member but does have `i64`, or the literal exceeds the i32 range.

  // The ladder settles the value-atom code, not a spelling: the box tag, the rides-the-anyref
  // test, the scalar value box, the six `atom == …` compares picking the widened emit and the
  // two list re-encodes are all projections of that one code. Faithful because the map is
  // `valueAtomKind`'s own first-match ladder over exactly these eleven lexemes.
  let cak = 0 // "i32"
  // D209 — the third end of the same channel. When the read site delivers the atom rather than
  // the box (`memReadUnboxAtomKind`, the predicate `exprUnion` also asks), the value's atom is
  // that predicate's answer and not this ladder's: every arm below reads the read as a code-16
  // box and declines, so a `string | i32` field read boxes a string ref as an i32.

  // And the atom is taken only where this destination stores it as itself. Where the read's own
  // field widened the payload on the way in, taking the delivered atom raw tags the box `i32`
  // over a slot whose only numeric arm is `i64` — valid wasm, `is i64` silently false.
  // `unionStoreAtomKind` makes the two sides of the round trip inverses.
  const d209k = memReadUnboxAtomKind(bareIx, fnIx)
  if d209k >= 0 && unionStoreAtomKind(unionName, d209k) == d209k {
    cak = d209k
  } else if exprString(exprIx, fnIx) {
    cak = 2 // "string"
  } else if exprStringArray(exprIx, fnIx) {
    cak = 9 // "string[]" — a list member rides as a wrapper ref (like a string)
  } else if exprF32Array(exprIx, fnIx) {
    // Checked BEFORE the f64 arm: an f32-typed list value (an `f32[]` local/param/
    // narrowed read) must not be mis-claimed as `f64[]`. A bare float LITERAL still
    // classifies f64 (`exprF32Array` never claims it) — the `f64[]` → `f32[]`
    // re-encode below retargets it when only the f32 arm exists.
    cak = 12 // "f32[]"
  } else if exprF64Array(exprIx, fnIx) {
    cak = 8 // "f64[]"
  } else if exprI64Array(exprIx, fnIx) {
    cak = 10 // "i64[]"
  } else if exprU8Array(exprIx, fnIx) {
    // Checked before the i32-list arm for the same reason the f32 arm precedes the f64 one: a
    // `u8[]` element reads as an i32 everywhere (`array.get_u` widens it), so the generic array
    // arm below would claim it and tag the box `i32[]` over a one-byte backing. Without this
    // arm a `u8[]` carrier falls past the whole ladder and boxes its wrapper ref as an i32.
    cak = 13 // "u8[]"
  } else if exprArray(exprIx, fnIx) {
    cak = 7 // "i32[]"
  } else if exprIsF32(exprIx, fnIx) {
    // D978 — ask the union which arm stores an f32, do not assume the f32 one. A union with
    // only an `f64` arm stores it there, losslessly, and assuming kind 5 asks for an f32 box
    // the module never minted.
    cak = 5 // "f32"
    // Only when the union genuinely offers an `f64` ARM and no `f32` one. Asking
    // `unionStoreAtomKind` in general moved a case it should not have
    // (`d901_fold_f32_dest`, a `{q: f32} | null` whose f32 is a FIELD and not an arm), so
    // the test is spelled out here instead of widening that shared mapper.
    const f32Set = msSetOfText(unionName)
    if !unionHasAtomK(f32Set, unionName, "f32", 5) {
      if unionHasAtomK(f32Set, unionName, "f64", 4) { cak = 4 }
    }
  } else if exprIsF64(exprIx, fnIx) {
    cak = 4 // "f64"
  } else if exprIsI64(exprIx, fnIx) {
    cak = 3 // "i64"
  } else if exprIsBool(exprIx, fnIx) {
    cak = 1 // "boolean"
  } else {
    // The union's own promotion of an i32-classified value: no `i32` arm but a wider numeric
    // one, so the value is stored as that arm. `unionStoreAtomKind` is that ladder's one home —
    // the same function the un-narrowed read asks to learn which value box holds the payload
    // it is looking at (D291).

    // Promoting to `i64` alone is not enough: an integer flowing into a union whose only numeric
    // atom is a float would stay `cak = 0` and box an i32 into the f64 or f32 value box, which
    // is check-clean invalid wasm in the global, local and argument positions. f64 before f32,
    // matching the list arm.
    const usw = unionStoreAtomKind(unionName, 0)
    if usw >= 0 { cak = usw }
    if bare is NumLit {
      if !numLexFitsI32(bare.numText) {
        cak = 3 // "i64"
      }
    }
  }
  // A float literal types f64 by default, but if the union's float atom is f32 (`f32 | string`,
  // no f64) the literal re-encodes at f32 — pick the f32 atom so it boxes into the f32 value
  // box. The same promotion ladder, entered at f64 instead of i32. The `cak == 4` gate is
  // hoisted out of the call below so the set resolution is paid only by a float value.
  if cak == 4 {
    const fsw = unionStoreAtomKind(unionName, 4)
    if fsw >= 0 { cak = fsw }
  }
  // An int-element list whose union has no `i32[]` member but an `i64[]` or `f64[]` one: the
  // elements are small int literals, so the list classifies `i32[]` while the union demands the
  // wider list. Adopt its atom and thread the element kind, so the backing builds
  // `(array (mut i64/f64))` with each element widening at the store, as an annotated `let` does.
  let coerceListKind = 0
  // A `u8[]`-classified carrier that is a list literal has to build the packed backing. The
  // checker records `u8[]` on the literal node, so the ladder answers 13 and the box is tagged
  // 13 — but `emitArr` reads the elements to pick a backing and a bare `[1, 2, 255]` reads as
  // i32, so without the build kind the narrowed read's `ref.cast $bl8` traps at run time.
  if cak == 13 { coerceListKind = 10 }
  if cak == 7 && !unionHasAtomTy(unionName, "i32", true) {
    if unionHasAtomTy(unionName, "i64", true) {
      cak = 10 // "i64[]"
      coerceListKind = 6
    } else if unionHasAtomTy(unionName, "f64", true) {
      cak = 8 // "f64[]"
      coerceListKind = 4
    } else if unionHasAtomTy(unionName, "f32", true) {
      cak = 12 // "f32[]"
      coerceListKind = 7
    }
  }
  // The LIST twin of the f64 → f32 scalar re-encode above: a float-element literal
  // classifies `f64[]`, but if the union's only float-list atom is `f32[]` the checker
  // adopted that arm — build the f32 backing (kind 7 threads `pendingListKind`, so each
  // element re-encodes at f32 at the store) and tag the box with the f32-list atom.
  if (
    cak == 8 &&
    !unionHasAtomTy(unionName, "f64", true) &&
    unionHasAtomTy(unionName, "f32", true)
  ) {
    cak = 12 // "f32[]"
    coerceListKind = 7
  }
  // `cak` is final at this point: every arm of the ladder above assigns before the
  // tag is emitted, and the box TAG, the rides-the-anyref test and the scalar value
  // box below are all projections of it (`scalarTagOf` / `atomIsRefKind` /
  // `vbHeapIdxOfAtom` each re-derived it from the spelling).
  fbI32Const(scalarTagOfKind(cak))
  if cak == 3 {
    if emitExprAsI64(body, exprIx, fnIx) < 0 { return -1 }
  } else if cak == 4 {
    if emitExprAsF64(body, exprIx, fnIx) < 0 { return -1 }
  } else if cak == 5 {
    const savedF32 = pendingF32
    pendingF32 = true
    if emitExprAsF32(body, exprIx, fnIx) < 0 { return -1 }
    pendingF32 = savedF32
  } else if coerceListKind != 0 {
    const savedCLK = pendingListKind
    pendingListKind = coerceListKind
    const rcCLK = emitExpr(body, exprIx, fnIx)
    pendingListKind = savedCLK
    if rcCLK < 0 { return -1 }
  } else {
    if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
  }
  // A `string` / list member is a REF and rides the box's anyref `value` directly; only a
  // SCALAR atom wraps in its per-rep value box.
  if !atomIsRefKind(cak) {
    const vb = vbHeapIdxOfKind(cak)
    if vb < 0 { return emitFail("emitProgram: union atom has no value box") }
    fbStructNew(vb) // wrap the scalar payload
  }
  fbStructNew(uBoxIdx) // { tag, payload }
  0
}

// Coerce an expression into a union-box position whose wasm rep is `(ref $uBox)` — a call
// argument to a union param, or a return typed as the union. A concrete variant-struct value is
// a raw `(ref $variant)`, since a struct that is a union member is allocated as a kind-8 variant
// local so it narrows in place, and that raw ref does not match the boxed rep.

// Box it into the shared `{tag, payload}` rep exactly as `emitUnionBox` boxes a struct literal —
// the variant ref is the payload type, so no field copy. Box-typed positions only; exported for
// `emit_sections.vl`'s module-global cells, which are box-typed too.

// D1567 — is the function at `fnStmts` position `pos` one whose every returned value is a bare
// `null`? The checker types such a return `TyPrim:null` and the emitter reps it as `nullref`.
// The one home for that question: the union box destination in `emitUnionBoxArg` and the two
// i32 niches in `emitDirectCall` read it here rather than each spelling the kind compare.
function fnPosRetIsNulNone(pos: i32): boolean {
  if pos < 0 || pos >= fRetKind.length { return false }
  fRetKind[pos] == "nulnone"
}

// The payload of a null-tagged box holding a `null`-typed value: the value itself when
// evaluating it can have effects (a call), and a fresh `ref.null none` otherwise. The slot is
// unread under the null tag, so its only job is to be an `anyref` — which is why an ident read
// must not route through the seed table (D1576), a `boolean | null` seed putting an i32 there.
function emitNulNoneBoxPayload(body: i32[], exprIx: i32, fnIx: i32) {
  const n = P.nodes[unwrapParen(exprIx)]
  if n is Call { return emitExpr(body, exprIx, fnIx) }
  fbRefNullNone()
  0
}

// D1576 — does this `==` or `!=` compare the `null` type against a `null`? True when at least
// one operand is a `null`-typed value (`exprIsNulNone`) and both sides are either that or a bare
// `null` literal, so both denote the one value `null` and the compare folds to a constant. A
// genuinely nullable operand is excluded: there the answer is that operand's null-ness.
function nulNoneEqSides(leftIx: i32, rightIx: i32, fnIx: i32): boolean {
  if !exprIsNulNone(leftIx, fnIx) && !exprIsNulNone(rightIx, fnIx) {
    return false
  }
  nulNoneEqSide(leftIx, fnIx) && nulNoneEqSide(rightIx, fnIx)
}

// One side of `nulNoneEqSides`: a `null`-typed value, or a bare `null` literal.
function nulNoneEqSide(exprIx: i32, fnIx: i32): boolean {
  if exprIsNulNone(exprIx, fnIx) { return true }
  const n = P.nodes[unwrapParen(exprIx)]
  if n is NullLit { return true }
  false
}

// Evaluate a `null`-typed operand for its effects and drop it, where the answer is already
// decided. Only a call has any: an ident read has none, and emitting one would consume the
// destination seed (`emitNullBySeed`'s one-shot `pendingNulRefHeap`) the surviving value still
// needs. Shared by `??`, the folded null compare, and `print`.
function emitNulNoneForEffect(body: i32[], exprIx: i32, fnIx: i32) {
  const n = P.nodes[unwrapParen(exprIx)]
  if n is Call {
    if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
    fbDrop()
  }
  0
}

export function emitUnionBoxArg(
  body: i32[],
  unionName: string,
  exprIx: i32,
  fnIx: i32,
) {
  // D1567 — a `null`-typed value at a box destination is the null-tagged box. `i32 | null` and
  // every other value union reps as `{tag, anyref}`, so a `nullref` result cannot ride the cell
  // raw and must not be boxed as its own arm either — the classifier below reads a Call's kind,
  // finds none, and boxes it as an i32. The payload is the value: `nullref` is an `anyref`.
  if exprIsNulNone(exprIx, fnIx) {
    fbI32Const(nullBoxTag())
    if emitNulNoneBoxPayload(body, exprIx, fnIx) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { null tag, a nullref — unread under this tag }
    return 0
  }
  // D1009 — a map read of a union-valued map delivers its miss as a tagged box. `v[k]` on a
  // `{[string]: J}` has type `J | null`, and where `J` itself carries `null` that is a `J`. At
  // the rep the two nulls differ: the sentinel is a bare `ref.null` in the vals slot, `J`'s own
  // null arm a null-tagged box. `emitMapGetUnionBox` is exactly that conversion.
  const bxIdx = P.nodes[unwrapParen(exprIx)]
  if bxIdx is Index {
    if exprMap(bxIdx.idxArr, fnIx) {
      const bxSh = mapShapeOfExpr(bxIdx.idxArr, fnIx)
      if bxSh >= 0 && bxSh < mvValKind.length {
        if mvValKind[bxSh] == 2 {
          return emitMapGetUnionBox(body, bxIdx.idxArr, bxIdx.idxIndex, fnIx)
        }
      }
    }
  }
  const bxMap = emitUnionMapArmBox(body, unionName, exprIx, fnIx)
  if bxMap < 0 { return -1 }
  if bxMap == 1 { return 0 }
  const bxArm = emitUnionArmValueBox(body, exprIx, fnIx)
  if bxArm < 0 { return -1 }
  if bxArm == 1 { return 0 }
  emitUnionCoerce(body, unionName, exprIx, fnIx)
}

// Box a value that is already one arm of a value union — a concrete variant ref, or the
// `nulvariant` niche narrowed non-null — into the `{tag, anyref}` box. Returns 1 handled, 0
// not an arm value, -1 on error. Every box-typed destination delivers through it, since
// `emitUnionCoerce` alone passes an arm value raw, which fits only a variant cell (D1606).
function emitUnionArmValueBox(body: i32[], exprIx: i32, fnIx: i32): i32 {
  if exprUnion(exprIx, fnIx) { return 0 }
  const svi = exprVariantIndex(exprIx, fnIx)
  if svi >= 0 {
    // A struct-typed value built as the plain struct (an anonymous union arm returned from a
    // `: {…}` function, or bound to a struct local) is a layout twin of but a distinct heap
    // type from the arm's variant struct: boxing the raw ref validates, and the narrow's
    // `ref.cast` traps at run time. Rebuild it with `emitStructExprAsVariantBox` instead.
    const bssi = structIndexOfExpr(exprIx, fnIx)
    // The bounds half of the twin test. `structIndexOfExpr` answers a struct table row, and
    // `sHeapIdx` is only as long as the rows that reached heap-type assignment, so a row that
    // never interned a shape indexes past it. Every sibling reader carries this bound, and an
    // out-of-bounds read in the compiler is a wasm trap with no diagnostic.

    // Neither same shapes nor the `is` test is required to reach it: `function f(x: A | i32)`
    // called as `f(mkA())` is enough. What is required is a call result in a union argument
    // position. A row with no heap index cannot be a layout twin of anything, so the compare
    // declines instead of indexing and the program continues to the loud reject.
    if (
      bssi >= 0 &&
      bssi < sHeapIdx.length &&
      sHeapIdx[bssi] != uVarHeap[svi]
    ) {
      if emitStructExprAsVariantBox(body, exprIx, svi, bssi, fnIx) < 0 {
        return -1
      }
      return 1
    }
    fbI32Const(uTags[svi]) // 0x41 i32.const <variant tag> (program-global)
    if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, variant-ref }
    return 1
  }
  // The niche twin of the rung above (D24). A narrowed `Circle | null` is the `nulvariant`
  // niche — one non-null member, so a bare `(ref null $Circle)` and not a `{tag, value}` box —
  // and `exprVariantIndex` answers -1 for it by construction, its arms being the kind-8 param,
  // the declared local and the global, none of which is the nullable cell.

  // The narrow is what makes it sound: this position is only reachable with the value proved
  // non-null, and the box's payload field is `anyref`, so the niche rides it exactly as the
  // non-null variant ref does. Gated on the boolean twin and not the index alone —
  // `exprNullableVariant` and `nulVariantIdxOfExpr` are a kind/slot pair.
  if exprNullableVariant(exprIx, fnIx) {
    const nvi = nulVariantIdxOfExpr(exprIx, fnIx)
    if nvi >= 0 && nvi < uTags.length {
      fbI32Const(uTags[nvi]) // 0x41 i32.const <variant tag>
      if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
      fbStructNew(uBoxIdx) // { tag, niche-ref }
      return 1
    }
  }
  0
}

// Lower an if-expression whose value is a union as a value-typed `if` with the union box result
// type, each arm union-coerced. Mirrors `emitIfExprAs` in its narrowing save and restore and its
// `else if` recursion, but the blocktype is the `(ref $uBox)` valtype rather than a numeric byte,
// and the arms route through `emitUnionCoerce` so every arm boxes to the same rep.
function emitUnionIfValue(
  body: i32[],
  unionName: string,
  ifIx: i32,
  fnIx: i32,
) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    // An else-less `if` used as a value is `T | null` (`DECISIONS.md`), and in the box rep that
    // null is the null-tagged box — the same value `emitNulNullToLocal` writes for the binding
    // sink's rep 0, built here on the stack instead of into a slot.
    const noElse = s.ifElse < 0
    if emitExpr(body, s.ifCond, fnIx) < 0 { return -1 }
    wU8(4)                 // 0x04 if
    fbValtype("union", -1) // result blocktype: the union box `(ref $uBox)`
    // Count the frame: a `br` emitted anywhere inside an arm takes its operand from `ctrlDepth`,
    // and the union return sink's branch to the function exit block is one. Nothing
    // branch-bearing reaches an arm today, so this is byte-neutral; dropping it would give an
    // off-by-one `br` operand, invalid wasm rather than a wrong answer.
    ctrlEnter()
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const rcT = emitUnionIfArm(body, unionName, s.ifThen, fnIx)
    if narrowed { restoreNarrow(savedTop) }
    if rcT < 0 { return -1 }
    fbElse() // 0x05 else
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    let rc = 0
    if noElse {
      fbI32Const(nullBoxTag())
      fbRefNullNone() // the payload slot is unread under the null tag
      fbStructNew(uBoxIdx)
    } else {
      const els = P.nodes[s.ifElse]
      if els is IfStmt {
        rc = emitUnionIfValue(body, unionName, s.ifElse, fnIx)
      } else {
        rc = emitUnionIfArm(body, unionName, s.ifElse, fnIx)
      }
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    ctrlLeave()
    return 0
  }
  emitFail("emitProgram: expected a union if-expression")
}

// One arm of a union if-expression: the arm's prelude, then its tail-value statement
// union-coerced to the box rep (`emitUnionCoerce` — a variant struct boxes, a passthrough
// union rides as-is, a scalar value-boxes).
function emitUnionIfArm(
  body: i32[],
  unionName: string,
  blockIx: i32,
  fnIx: i32,
) {
  const b = P.nodes[blockIx]
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if stmtIsTailValue(tv, fnIx) {
        if emitIfArmOpen(body, blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        // The if-value's result is the union box (the blocktype), so a concrete-variant arm — a
        // kind-8 `(ref $variant)` local or value — must be boxed to match, exactly as a variant
        // return or argument is. `emitUnionBoxArg` boxes a variant ref and defers every other
        // shape to `emitUnionCoerce`; plain `emitUnionCoerce` would emit the raw variant ref.
        return emitIfArmClose(emitUnionBoxArg(body, unionName, tv, fnIx))
      }
    }
    return ifArmNoValueFail("union if-expression arm", blockIx)
  }
  emitFail("emitProgram: union if-expression arm is not a block")
}

// ── the narrowed-arm delivery unbox (D1031) ──────────────────────────────────

// An `is`-narrowed struct arm is still the `{tag, payload}` box at the wasm level. It is the one
// narrowed rep whose read does not unbox — `emitIdent` carries an unbox arm for the value-atom,
// ref-array and map arms and none for the struct one — so every destination typed at the arm has
// to recover the payload itself.

// The cast target is the destination's heap and not `uVarHeap[vi]`: the slot is what the store
// must satisfy, and where the arm is merged with a declared twin the indices are the same
// anyway. Not a change to `exprUnion`, which would move every narrowed struct receiver.
function narrowedArmNeedsUnbox(exprIx: i32, fnIx: i32): boolean {
  if narrowedStructArmVi(exprIx) < 0 { return false }
  exprUnion(exprIx, fnIx)
}

// The unbox itself: recover the box's `anyref` payload and cast it to `heapIdx`. Emitted after
// the value, so the box is already on the stack. A negative `heapIdx` emits nothing — the bounds
// discipline `fbValtype` states: a destination whose table slot never resolved has no cast
// target, and `ref.cast -1` would put a garbage heap index in the module.
function emitNarrowedArmUnboxTo(heapIdx: i32) {
  if heapIdx < 0 { return 0 }
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  fbRefCast(heapIdx)      // 0xfb 0x16 <dest struct/variant heap> ref.cast (non-null)
  0
}

// The pair, applied at a delivery boundary: emit `exprIx`, then unbox it when it arrives as a
// narrowed arm's box and `heapIdx` names the slot it has to land in. A value that is already
// the bare arm emits unchanged, so every site can call this in place of its `emitExpr`.
function emitArmDelivery(body: i32[], exprIx: i32, fnIx: i32, heapIdx: i32) {
  const owed = narrowedArmNeedsUnbox(exprIx, fnIx)
  if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
  if owed && heapIdx >= 0 { emitNarrowedArmUnboxTo(heapIdx) }
  0
}

// The heap a code-15 struct field's slot names — `(ref null $sHeapIdx[target])`. -1 where the
// target row does not resolve, which leaves the delivery above emitting what it otherwise emits
// rather than reading `sHeapIdx[-1]` (the `fbValtype` bounds discipline).
function sFieldTgtHeapOf(si: i32, fi: i32): i32 {
  const t = sFieldTgtStructIdx(si, fi)
  if t < 0 || t >= sHeapIdx.length { return -1 }
  sHeapIdx[t]
}

// The heap a destination names, from the (kind, slot) pair every boundary already holds — the
// same pair `fbValtype` writes the slot's valtype from, so the cast target and the slot cannot
// disagree. -1 for a kind that is not a struct or variant ref and for an index outside its
// table: the delivery then emits unchanged rather than reading `uVarHeap[-1]`.

// The heap a ref-list slot's element names, when that element is a struct or variant ref
// (`rlElemKindTbl` 1) — the destination for a narrowed arm delivered into a `Circle[]`. -1 for
// a union-box element (kind 2), which wants the box and is already right, and for every
// composite element kind, whose value is a list, map or closure and never an arm.
function rlElemArmHeapOf(rslot: i32): i32 {
  if rslot < 0 || rslot >= rlElemKindTbl.length { return -1 }
  if rlElemKindTbl[rslot] != 1 { return -1 }
  if rslot >= rlElemHeap.length { return -1 }
  rlElemHeap[rslot]
}

// The slot half of that pair for a module global's cell — read from the same two resolvers the
// assignment arm already seeds `pendingStructIdx` and `pendingVariantIdx` from, so the cast
// target and the declared cell cannot disagree. `globalCellStructIdx` answers the variant index
// for a `variant` or `nulvariant` cell and the struct row for a `struct` one.
function globalCellArmIdx(gLet: i32, kind: VKind): i32 {
  if kind == "nulstruct" { return nulRefStructIdxOfLet(gLet, -1) }
  globalCellStructIdx(gLet)
}

function armDestHeapOf(kind: VKind, idx: i32): i32 {
  if idx < 0 { return -1 }
  if kind == "variant" || kind == "nulvariant" {
    if idx < uVarHeap.length { return uVarHeap[idx] }
    return -1
  }
  if kind == "struct" || kind == "nulstruct" {
    if idx < sHeapIdx.length { return sHeapIdx[idx] }
  }
  -1
}

// Coerce the expression at `exprIx` to the concrete variant `vi`'s rep `(ref $uVarHeap[vi])`.
// The collapse boundary, where a callback typed as one variant meets a mix of reps: an object
// literal builds the bare variant, a narrowed union value unboxes, an already-bare variant
// passes through, a value-`if` join recurses. The variant analogue of `emitUnionCoerce`.
function emitVariantCoerce(body: i32[], vi: i32, exprIx: i32, fnIx: i32) {
  const bareIx = unwrapParen(exprIx)
  const bare = P.nodes[bareIx]
  if bare is IfStmt { return emitVariantIfValue(body, vi, bareIx, fnIx) }
  if bare is ObjLit { return emitVariantStruct(body, bareIx, vi, fnIx) }
  // Already the bare variant struct (a variant param/local/call/index): pass through.
  if exprVariantIndex(exprIx, fnIx) >= 0 {
    return emitVariantPassThrough(body, exprIx, fnIx)
  }
  // A union BOX (a narrowed receiver still boxed at the wasm level): unbox to the variant.
  if exprUnion(exprIx, fnIx) {
    if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    fbRefCast(uVarHeap[vi]) // 0xfb 0x16 <variant struct> ref.cast (non-null)
    return 0
  }
  emitVariantPassThrough(body, exprIx, fnIx)
}

// A value already in the bare variant rep, delivered to a non-null variant destination. D1115 —
// the kind-9/10 recover this pass-through owes, and the one nullable-niche return
// `emitReturnValue`'s guard cannot reach: a `: Circle` result routes here instead. Every
// destination this serves is non-null, so a narrowed nullable operand would hand it a null ref.
function emitVariantPassThrough(body: i32[], exprIx: i32, fnIx: i32) {
  if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
  if exprNullableRefNiche(exprIx, fnIx) { fbRefAsNonNull() }
  0
}

// Lower an if-EXPRESSION whose VALUE collapses to the concrete variant `vi` as a value-
// typed `if` with the variant struct result blocktype, each arm variant-coerced. Mirrors
// `emitUnionIfValue` (narrowing save/restore, `else if` recursion).
function emitVariantIfValue(body: i32[], vi: i32, ifIx: i32, fnIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    // An else-less `if` used as a value is `T | null` (`DECISIONS.md`): the variant rep's null
    // is `ref.null $uVarHeap[vi]`, so the blocktype goes nullable with it (`fbRefNullOfKind` is
    // `fbValtypeNullable`'s value twin).
    const noElse = s.ifElse < 0
    if emitExpr(body, s.ifCond, fnIx) < 0 { return -1 }
    wU8(4) // 0x04 if
    if noElse {
      fbValtypeNullable("variant", vi) // `(ref null $(uVarHeap[vi]))`
    } else {
      fbValtype("variant", vi) // result blocktype: the variant struct `(ref $(uVarHeap[vi]))`
    }
    ctrlEnter() // count the frame — see `emitUnionIfValue`
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const rcT = emitVariantIfArm(body, vi, s.ifThen, fnIx)
    if narrowed { restoreNarrow(savedTop) }
    if rcT < 0 { return -1 }
    fbElse()    // 0x05 else
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    let rc = 0
    if noElse {
      rc = fbRefNullOfKind("variant", vi)
    } else {
      const els = P.nodes[s.ifElse]
      if els is IfStmt {
        rc = emitVariantIfValue(body, vi, s.ifElse, fnIx)
      } else {
        rc = emitVariantIfArm(body, vi, s.ifElse, fnIx)
      }
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    ctrlLeave()
    return 0
  }
  emitFail("emitProgram: expected a variant if-expression")
}

// One arm of a variant if-expression: the arm's prelude, then its tail-value statement
// coerced to the concrete variant rep.
function emitVariantIfArm(body: i32[], vi: i32, blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if stmtIsTailValue(tv, fnIx) {
        if emitIfArmOpen(body, blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        return emitIfArmClose(emitVariantCoerce(body, vi, tv, fnIx))
      }
    }
    return ifArmNoValueFail("variant if-expression arm", blockIx)
  }
  emitFail("emitProgram: variant if-expression arm is not a block")
}

// ── union `==` and `!=` ─────────────────────────────────────────────────────

// `==` and `!=` are structural by value, so a still-boxed value-union operand compares by "does
// the box's tag select the arm whose rep matches the other side, and does the unboxed payload
// value-equal it". The tag compare gates the payload compare — the payload `ref.cast` would
// trap on a wrong-rep arm — as a value-typed `if`, which is the short-circuit needed.

// This emitter re-evaluates the operand rather than hoisting each box into a fresh local, the
// established struct-`==` pattern, so a union operand is restricted to a simple binding read:
// re-reading an ident is effect-free and yields the same box. Anything effectful fails loudly.

// Unbox a union payload already pushed as `anyref` (`struct.get $box 1`) to the rep of the arm
// whose value-atom kind is `k`: a string payload (kind 2) is the string array, cast only; a
// scalar rides its per-rep value box, cast plus field 0. Mirrors `emitValueUnionUnboxRead`.

// Keyed on the atom's code and not its spelling: `atom == "string"` and `vbHeapIdxOfAtom` are
// both projections of that one code, and every caller already holds it — the box tag it emits
// one instruction earlier is `scalarTagOfKind` of the same code. A member that is not a value
// atom reaches `vbHeapIdxOfKind(-1)` and the same loud reject.
function emitUnionPayloadUnbox(_body: i32[], k: i32) {
  if k == 2 {
    fbRefCast(sTypeIdx) // the payload IS the string array ref
    return 0
  }
  // A list arm rides the box's `value` field as its wrapper ref, exactly as a string does —
  // `emitUnionUnboxTail`'s ladder, which every other reader of a boxed list arm takes. Without
  // this rung a list arm reaches the scalar value-box lookup and refuses with "atom has no
  // value box" on a `vl check`-clean program.

  // D1098 — a closure arm's payload is the closure fat-pointer struct, exactly as
  // `emitUnionUnboxTail` recovers it for a narrowed read. Without this rung it reaches the
  // scalar value-box lookup and refuses the same way.
  if k == 11 {
    fbRefCast(cloStructIdx)
    return 0
  }
  const lw = listWrapHeapOfKind(k)
  if lw >= 0 {
    fbRefCast(lw)
    return 0
  }
  const vb = vbHeapIdxOfKind(k)
  if vb < 0 { return emitFail("emitProgram: union `==` atom has no value box") }
  fbRefCast(vb)      // 0xfb 0x16 <value box>
  fbStructGet(vb, 0) // the scalar payload
  0
}

// The per-arm payload compare of a union `==`, with both payloads already unboxed to the arm's
// rep and on the stack (left below right), leaving the 0/1 answer. One home for the three
// union-`==` lowerings — union against union over a value union, over a struct union, and union
// against concrete — so a rep that compares at one spelling cannot refuse at another.
function emitUnionAtomPayloadEq(body: i32[], k: i32, fnIx: i32) {
  if k == 2 { return emitStrEqCore(body) }
  // D1098 — two closures are equal by function IDENTITY (id + env), a separate core with its
  // own frame (`cloEqNoteBin`), and this ladder is where the arm reaches it.
  if k == 11 { return emitCloEqCore(body) }
  const lk = leqCoreKindOfAtomKind(k)
  if lk >= 0 { return emitListEqAnyRep(body, lk, 0, fnIx) }
  // D-EQOPCODE: the scalar payload compare's opcode is another projection of the same code
  // that chose the tag and the unbox, not a fresh question about the arm's spelling.
  fbI32Bin(atomEqOpcodeOfKind(k))
  0
}

// Emit the concrete operand at `otherIx` in the rep of the arm whose value-atom kind is `k` — an
// i32 literal widens to the arm's i64, f64 or f32. Keyed on the code: the three spellings this
// would otherwise compare are the codes 3 / 4 / 5, which `valueAtomKind` assigns to `i64`, `f64`
// and `f32` and to no other spelling, so the caller's single derivation answers all three.
function emitUnionEqOther(body: i32[], otherIx: i32, k: i32, fnIx: i32) {
  if k == 3 { return emitExprAsI64(body, otherIx, fnIx) }
  if k == 4 { return emitExprAsF64(body, otherIx, fnIx) }
  // The STRING arm's widening twin of the three numeric ones: a literal-union ATOM operand
  // becomes its member string (`emitStrValue`), which is the rep the box's string payload is
  // compared against. `emitStrValue` is `emitExpr` for everything that is already a string.
  if k == 2 { return emitStrValue(body, otherIx, fnIx) }
  if k == 5 {
    const savedF32 = pendingF32
    pendingF32 = true
    if emitExprAsF32(body, otherIx, fnIx) < 0 { return -1 }
    pendingF32 = savedF32
    return 0
  }
  emitExpr(body, otherIx, fnIx)
}

// Union against a concrete value, in either operand order: the box's tag must select the arm
// whose rep matches the other side, then the unboxed payload value-compares it. A rep with no
// arm is statically unequal, `==` 0 and `!=` 1, with both operands still evaluated for side
// effects, box side first. `isNe` negates the result for `!=`.
function emitUnionConcreteEq(
  body: i32[],
  boxIx: i32,
  otherIx: i32,
  isNe: boolean,
  fnIx: i32,
) {
  // D972 — a non-re-readable operand is stashed at its first read, not refused. This compare
  // reads the box up to three times — the no-arm fold, the tag, and the payload inside the
  // tag-matched arm — which is the whole content of `unionEqOperandOk` (Ident, NumLit, StrLit,
  // Member, Index). A call operand is not re-readable.

  // Teed at the first read rather than pre-emitted at the top: the operand must be evaluated
  // where the original code evaluated it, so any context the surrounding lowering seeds is still
  // in force. Pre-emitting it ahead of the gates traps.
  const eqStash = unionEqStashSlot()
  const eqOnce = !unionEqOperandOk(boxIx)
  const uname = unionNameOfExpr(boxIx, fnIx)
  // D-VALUNION / D-SETONCE: the union's interned member set, resolved ONCE — the
  // value-union gate below reads its banked member codes instead of re-splitting the
  // rendering.
  const usid = msSetOfText(uname)
  // The arm spellings with a declared alias resolved, and the litunion-arm shape admitted beside
  // the plain value union — the same two lines `emitUnionLitIs` carries, for the same reason: a
  // `K | i32` box is a value-union box with the litunion arm riding it as its member string, and
  // both the gate and the arm-membership test read a name.
  const unmArms = unionMemberSetOf(uname)
  // D1071 — the other operand's rep code, with a real "not an atom" answer. `-1` here is out of
  // band; the two branches below are the only readers, and both consume the code rather than a
  // spelling. `valueAtomNameOfKind` re-derives the spelling for the membership test's decline
  // argument, a bijection over the seven scalar codes and "" above them.
  const eak = unionEqAtomKindOf(otherIx, unmArms, fnIx)
  const atom = valueAtomNameOfKind(eak)
  if eak < 0 {
    // The operand has no atom rep — a struct, a map, a shape the arena named. The box can still
    // hold it as a variant arm, which is a tag test plus that arm's field compare.
    if emitUnionConcreteVariantEq(body, boxIx, otherIx, isNe, fnIx) == 0 {
      return 0
    }
    return emitFail(
      "emitProgram: `==` over a struct union is not supported yet",
    )
  }
  // A mixed union is comparable to a scalar literal. The compare below is arm-agnostic: it reads
  // the box's tag, compares it to the tag of the atom the other operand names, and on a match
  // compares that one payload. The union's remaining arms are never touched — a container arm
  // simply has a tag that does not match, the right answer, needing no compare core.

  // So requiring the whole union to be a value union is stronger than the lowering needs, and
  // would refuse `v == "b"` over a `Json` carrying list and map arms. Widened only where the
  // other operand names an atom the union actually carries: `unionEqArmPresent` is the same
  // membership test the static-false fold below trusts.
  const eqMixedOk = unionEqArmPresent(usid, unmArms, atom, eak)
  if (
    uname == "" ||
    (!isValueUnionOfSet(usid, uname) &&
      !unionCarriesLitUnionArm(uname) &&
      !eqMixedOk)
  ) {
    // The second door to the variant compare, for an operand the arena declined to type
    // (`valueRowKind` -2) and which therefore still carries the ladder's i32 default. The
    // expression itself can still name a concrete variant, and reading it is the only thing
    // that distinguishes "an i32" from "a row the arena has not recorded".
    if emitUnionConcreteVariantEq(body, boxIx, otherIx, isNe, fnIx) == 0 {
      return 0
    }
    return emitFail(
      "emitProgram: `==` over a struct union is not supported yet",
    )
  }
  // A `string`-repped other operand has an arm whenever the box can carry it as a string ref — a
  // plain `string` arm or a literal-union arm, `unionTakesAtomAsStr`'s question and
  // `emitUnionLitIs`'s second leg. Without it a `K | i32` box statically answers `u == k` false:
  // the banked member kinds carry only `i32`, so the arm that holds the value looks absent.
  let eqHasArm = unionEqArmPresent(usid, unmArms, atom, eak)
  if !eqHasArm && eak == 2 && unionTakesAtomAsStr(unmArms) { eqHasArm = true }
  if !eqHasArm {
    // No arm has the other operand's rep: the box can never hold such a value.
    if emitExpr(body, boxIx, fnIx) < 0 { return -1 }
    fbDrop() // 0x1a drop
    if emitUnionEqOther(body, otherIx, eak, fnIx) < 0 { return -1 }
    fbDrop() // 0x1a drop
    if isNe { fbI32Const(1) } else { fbI32Const(0) }
    return 0
  }
  if eak == 2 && !aUsed {
    return emitFail(
      "emitProgram: union string `==` but array type not collected",
    )
  }
  // tag == tagOf(atom), gating the payload compare.
  if emitExpr(body, boxIx, fnIx) < 0 { return -1 }
  if eqOnce { fbLocalTee(eqStash) }
  fbStructGet(uBoxIdx, 0) // 0xfb 0x02 <box ht> field 0: tag
  // The CONCRETE operand's own arm type, through the very composition the BOX site uses
  // (`cloBoxArmTy` → `cloArmTagOfTy`), so a closure arm is tested against the tag its box
  // actually writes.
  fbI32Const(unionEqTagOfArmTy(eak, cloBoxArmTy(otherIx, uname)))
  fbI32Bin(70)            // 0x46 i32.eq
  fbIf(127)               // 0x04 if, 0x7f i32 result blocktype
  if eqOnce { fbLocalGet(eqStash) }
  else if emitExpr(body, boxIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  if emitUnionPayloadUnbox(body, eak) < 0 { return -1 }
  if emitUnionEqOther(body, otherIx, eak, fnIx) < 0 { return -1 }
  // D-EQOPCODE: the payload compare is the last projection of `eak`, which already chose
  // the box tag, the payload unbox and the widened operand emit above it.
  if emitUnionAtomPayloadEq(body, eak, fnIx) < 0 { return -1 }
  fbElse() // 0x05 else: wrong-rep arm — structurally unequal
  fbI32Const(0)
  fbEnd()  // 0x0b end
  if isNe {
    fbI32Eqz() // 0x45 i32.eqz (`!=` negates value-equality)
  }
  0
}

// D1098 — the box tag of one arm of a union `==`, which is `scalarTagOfKind` for every atom
// except a bare closure. A closure arm's tag is keyed on its signature (`cloArmTagOfTy` through
// `cloSigSlotTag`): the first signature a module interns keeps the flat kind-11 offset and each
// further one claims the band above, so `scalarTagOfKind(11)` is right for only one of them.

// The tag has one home — `cloArmTagOfTy`, whose box side is `emitUnionCoerce` and whose test
// side is `isArmTagOfTy`. This routes the compare through it too, so all three derive an arm's
// tag from one render of one arena type; `cloBoxArmTy` names the caller split.
function unionEqTagOfArmTy(k: i32, armTy: i32): i32 {
  if k == 11 { return cloArmTagOfTy(armTy) }
  scalarTagOfKind(k)
}

// Does the union carry an arm at the other operand's rep? One question, two instruments, split
// on whether the code has a spelling: the seven scalar codes take the banked `unionHasAtomK`
// with its keyword fall-through, and a container code — which `valueAtomNameOfKind` cannot name,
// 7 being `i32[]` and `boolean[]` and `K[]` — takes the member walk. Both readers ask here.
function unionEqArmPresent(
  usid: i32,
  unmArms: string,
  atom: string,
  eak: i32,
): boolean {
  if atom == "" { return unionHasAtomKindArm(unmArms, eak) }
  unionHasAtomK(usid, unmArms, atom, eak)
}

// D1180 — the variant row the concrete operand's value actually has, which is not always the row
// `exprVariantIndex` names. That resolver is rep-authoritative over bindings, so it carries a leg
// per storage class and none for a struct-field read, and an un-annotated object literal is
// declined once the struct table holds a row matching its field set.

// The bridge is heap identity, not shape matching: `sHeapIdx` and `uVarHeap` are two index spaces
// over one wasm type space, and two rows that interned to the same wasm struct type hold
// interchangeable values. Where they interned separately this answers -1 and the caller keeps its
// loud refusal. Exactly one match, or none: two arms sharing a heap type do not fix the tag.
function eqConcreteVariantRow(exprIx: i32, fnIx: i32) {
  const vi = exprVariantIndex(exprIx, fnIx)
  if vi >= 0 { return vi }
  // The nullable-niche storage class. A code-15 field read whose target is a union arm binds
  // `nulvariant` (D1112), which `exprVariantIndex` declines because that resolver is the non-null
  // one, and which `structIndexOfExpr` declines because an arm has no `sNames` row — so a cell
  // between the two kinds falls through both rungs to the caller's loud refusal.

  // Asked ahead of the heap scan because it is the exact answer: the bridge below infers a row
  // from heap identity and must decline an ambiguous match, while this reads the arm the
  // checker's own type names. The value is the same nullable niche the `nulstruct` operand parks,
  // and the field `struct.get` traps on null exactly as it does for that one.
  if exprNullableVariant(exprIx, fnIx) {
    const nvi = nulVariantIdxOfExpr(exprIx, fnIx)
    if nvi >= 0 { return nvi }
  }
  const ssi = structIndexOfExpr(exprIx, fnIx)
  if ssi < 0 { return -1 }
  if ssi >= sHeapIdx.length { return -1 }
  const h = sHeapIdx[ssi]
  let found = -1
  let i = 0
  while i < uVarHeap.length {
    if uVarHeap[i] == h {
      if found >= 0 { return -1 }
      found = i
    }
    i = i + 1
  }
  found
}

// D1071 — union `==` a concrete variant (`p == a` with `p: A | i32` and `a: A`). The box's tag
// selects the arm, and on a match that arm's payload is compared field-wise against the concrete
// operand — the union-against-union compare with one side's unbox deleted. -1 declines.

// The concrete operand already has the arm's heap type: when a union is declared the union path
// owns the struct types, so a `const a: A = {x: 1}` beside `type A` in an `A | i32` is a
// `(ref $uVarHeap[vi])`. The box is evaluated first and once and both operands are parked, which
// is what lets a non-place operand work here without `emitUnionConcreteEq`'s gate.
function emitUnionConcreteVariantEq(
  body: i32[],
  boxIx: i32,
  otherIx: i32,
  isNe: boolean,
  fnIx: i32,
) {
  const vi = eqConcreteVariantRow(otherIx, fnIx)
  if vi < 0 { return -1 }
  // The same four parallel-table bounds `emitStructUnionEq` takes before it writes a byte,
  // for the same reason: a variant row the emitter's tables do not cover must DECLINE, never
  // read out of bounds (`emitFail does not halt`).
  if vi >= uVarHeap.length { return -1 }
  if vi >= uTags.length { return -1 }
  if vi >= uFieldStart.length { return -1 }
  if vi >= uFieldCount.length { return -1 }
  if !variantFieldsComparable(vi) { return -1 }
  const sl = unionEqStashSlot()
  const ar = unionEqArmSlot(vi + 1024)
  // Both operands ride the wasm stack until both are computed, and only then are they parked.
  // The three scratch slots here are shared per function, not per site, so a union `==` nested
  // inside `otherIx` re-enters this function and re-uses the same slots. A stack value cannot be
  // reached that way, and after the second operand lands no user code runs before the compare.
  if emitExpr(body, boxIx, fnIx) < 0 { return -1 }
  if emitExpr(body, otherIx, fnIx) < 0 { return -1 }
  fbLocalSet(ar)          // pops the concrete operand, leaving the box on top
  fbLocalSet(sl)
  fbLocalGet(sl)
  fbStructGet(uBoxIdx, 0) // field 0: tag
  fbI32Const(uTags[vi])   // the arm's program-global tag
  fbI32Bin(70)            // 0x46 i32.eq
  fbIf(127)               // 0x04 if, i32 result
  ctrlEnter()
  const al = unionEqArmSlot(vi)
  fbLocalGet(sl)
  fbStructGet(uBoxIdx, 1) // field 1: payload (anyref)
  fbRefCast(uVarHeap[vi])
  fbLocalSet(al)
  if emitVariantFieldsEq(body, al, ar, vi, fnIx) < 0 { return -1 }
  fbElse()                // the box holds a different arm — structurally unequal
  fbI32Const(0)
  fbEnd()
  ctrlLeave()
  if isNe { fbI32Eqz() }
  0
}

// D973 — `==` over a struct union (`A | B` of declared shapes), both operands the same set.
// Tags unequal means different arms and therefore unequal; tags equal selects one arm, and that
// arm's fields are compared through the variant table. -1 declines.

// Not `emitStructEqRec`, which is keyed on a struct-table row: that table is empty when a union
// is declared, the union path owning the struct types instead, so the arms' fields live in
// `uFieldNames` and `uFieldTypes` and the compare reads them there. A scalar arm beside the
// struct ones is served too; its tag is `scalarTagOfKind`, which no variant tag can collide with.
function emitStructUnionEq(
  body: i32[],
  lIx: i32,
  rIx: i32,
  isNe: boolean,
  uname: string,
  fnIx: i32,
) {
  const arms: string[] = []
  const vis: i32[] = []
  const aks: i32[] = []
  if !unionBoxEqColumns(uname, arms, vis, aks) { return -1 }
  // Both operands ride the wasm stack until both are computed, and only then are they parked.
  // These slots are shared per function, so a left operand parked before the right one is
  // evaluated is a value the right one's code can overwrite — a nested union `==` re-enters this
  // function and re-uses the two slots. The evaluation order is unchanged: left, then right.
  if emitExpr(body, lIx, fnIx) < 0 { return -1 }
  if emitExpr(body, rIx, fnIx) < 0 { return -1 }
  emitUnionBoxEqStaged(body, arms, vis, aks, isNe, uname, fnIx)
}

// The arm columns of a box `==` over union `uname`, index-parallel to `arms` and mutually
// exclusive: a struct arm carries its variant row in `vis` and -1 in `aks`, a scalar arm the
// reverse. False declines, so an arm set the lowering cannot serve keeps its caller's loud
// refusal — asked before any byte is written, which is why it is its own function.
function unionBoxEqColumns(
  uname: string,
  arms: string[],
  vis: i32[],
  aks: i32[],
): boolean {
  splitUnionAtoms(unionMemberSetOf(uname), arms)
  if arms.length < 2 { return false }
  let i = 0
  while i < arms.length {
    const vi = variantIndexOf(arms[i])
    if vi < 0 {
      // NOT A VARIANT: the arm is servable exactly when it is a value ATOM whose payload
      // this lowering can unbox and compare — the same bound `emitUnionPayloadUnbox` and
      // `atomEqOpcodeOfKind` enforce, asked BEFORE any byte is written so an unservable arm
      // still DECLINES (keeping the caller's loud message) instead of failing loudly here.
      const ak = valueAtomKind(arms[i])
      if ak < 0 { return false }
      if ak == 2 {
        if !aUsed { return false }
      } else if ak != nullValKind() && ak != 11 {
        // A list arm is servable too: its payload is the wrapper ref, so the unbox is a
        // `ref.cast` and the compare is the generic list core. A closure arm (11) rides the same
        // shape and compares by identity (D1098). Everything left still needs a scalar value box
        // and declines without one.
        if listWrapHeapOfKind(ak) < 0 {
          if vbHeapIdxOfKind(ak) < 0 { return false }
        }
      }
      vis.push(-1)
      aks.push(ak)
      i = i + 1
      continue
    }
    if vi >= uVarHeap.length { return false }
    if vi >= uTags.length { return false }
    if vi >= uFieldStart.length { return false }
    if vi >= uFieldCount.length { return false }
    if !variantFieldsComparable(vi) { return false }
    vis.push(vi)
    aks.push(-1)
    i = i + 1
  }
  true
}

// The tag-then-arm compare over two boxes already on the stack (left below right), leaving the
// 0/1 answer. Split from the operand evaluation because a box-typed field reaches this same core
// through two chain reads rather than two expressions (D1290), and two callers must not carry two
// copies of the dispatch.
function emitUnionBoxEqStaged(
  body: i32[],
  arms: string[],
  vis: i32[],
  aks: i32[],
  isNe: boolean,
  uname: string,
  fnIx: i32,
) {
  const sl = unionEqStashSlot()
  const sr = unionEqStashSlot2()
  fbLocalSet(sr) // pops the right operand, leaving the left on top
  fbLocalSet(sl)
  // Tags first: two different arms are never equal, and the tag is the arm.
  fbLocalGet(sl)
  fbStructGet(uBoxIdx, 0)
  fbLocalGet(sr)
  fbStructGet(uBoxIdx, 0)
  fbI32Bin(70) // 0x46 i32.eq
  fbIf(127)    // 0x04 if, i32 result
  ctrlEnter()
  // Then one arm per tag; the last is the fall-through, so N arms need N-1 tests.
  let a = 0
  while a < vis.length - 1 {
    fbLocalGet(sl)
    fbStructGet(uBoxIdx, 0)
    fbI32Const(unionArmTagOf(vis[a], aks[a], uname, arms[a]))
    fbI32Bin(70)
    fbIf(127)
    ctrlEnter()
    if emitUnionArmEq(body, sl, sr, vis[a], aks[a], fnIx) < 0 { return -1 }
    fbElse()
    a = a + 1
  }
  // The chain's fall-through arm — the tag can only be this one by elimination, so it gets
  // no test of its own.
  const lastRc = emitUnionArmEq(
    body,
    sl,
    sr,
    vis[vis.length - 1],
    aks[aks.length - 1],
    fnIx,
  )
  if lastRc < 0 { return -1 }
  let e = 0
  while e < vis.length - 1 {
    fbEnd()
    ctrlLeave()
    e = e + 1
  }
  fbElse() // tags differ
  fbI32Const(0)
  fbEnd()
  ctrlLeave()
  if isNe { fbI32Eqz() }
  0
}

// Can every field of variant `vi` be compared by this lowering? Codes 0 (i32 / boolean) and
// 3 (string) only — a ref, list or map field would need the recursive machinery the struct
// table carries, and declining keeps the caller's loud refusal for those.
function variantFieldsComparable(vi: i32): boolean {
  const start = uFieldStart[vi]
  const cnt = uFieldCount[vi]
  let j = 0
  while j < cnt {
    if start + j >= uFieldTypes.length { return false }
    if !variantFieldComparable(start + j) { return false }
    j = j + 1
  }
  true
}

// One home for "can this variant field be compared", mirrored arm for arm by
// `emitVariantFieldEqCore`: this one decides and that one emits, so a code admitted here with no
// core there is invalid wasm on a `vl check`-clean program.

// D1096 — the admission is the field's rep, not the three codes the ladder happens to have arms
// for: one unservable field declines the whole compare, so a `{ d: f64 }` arm would refuse
// `p == a` while the identical field compares fine at its direct spelling. Most of those cores
// exist already; `i64` and `f32` are the two the struct ladder does not serve either.
function variantFieldComparable(ufi: i32): boolean {
  const c = uFieldTypes[ufi]
  if c == 0 || c == 21 || c == 30 {
    // i32 and boolean, and the two i32-sentinel niches that share the slot (D1180) — the struct
    // ladder's own rung. Their null rides in the value space, so `i32.eq` answers `null == null`
    // true with no guard.
    return true
  }
  if c == 3 {
    return true // string
  }
  if c == 17 {
    return true // f64
  }
  if c == 23 {
    return true // i64
  }
  if c == 24 {
    return true // f32
  }
  if c == 14 {
    return true // a function-valued field: identity (id + env)
  }
  // D974 — a nested shape field (code 15) is comparable when its shape has an interned struct
  // row, which `collectU` mints for exactly these (`internInlineShapeTy`). No row, no compare —
  // the same decline discipline every other code gets.
  if c == 15 { return variantNestedRow(ufi) >= 0 }
  // A ref-list field needs the ref-list slot its element name resolves to, both to reserve the
  // frame and to pick the element core; without one there is no compare to emit.
  if c == 5 { return variantRefListFieldSlot(ufi) >= 0 }
  // A BOX field is comparable when the shared box core can serve every arm (D1290).
  if c == 16 { return variantBoxFieldComparable(ufi) }
  // D1180 — a ref-niche field (`string | null`, `T[] | null`) is its non-null twin's core under
  // a null guard, so it is comparable exactly when that twin is. Same table, same guard and the
  // same admission rule as the struct ladder's: one home, two ladders.
  const cn = nulFieldInnerCode(c)
  if cn >= 0 { return variantFieldCodeComparable(ufi, cn) }
  eqVariantListFieldKind(c) >= 0
}

// Can the shared box core serve every arm of a code-16 variant field's union? The field's
// recorded elem name is the atom-set name the box is built against.
function variantBoxFieldComparable(ufi: i32): boolean {
  const bn = uFieldElemName[ufi]
  if bn == "" { return false }
  const bArms: string[] = []
  const bVis: i32[] = []
  const bAks: i32[] = []
  unionBoxEqColumns(bn, bArms, bVis, bAks)
}

// The admission question keyed by an EXPLICIT code, so the niche rung above can ask it of the
// non-null twin without re-entering the niche arm.
function variantFieldCodeComparable(ufi: i32, c: i32): boolean {
  if c == 0 || c == 21 || c == 30 { return true }
  if c == 3 { return true }
  if c == 17 { return true }
  if c == 23 { return true }
  if c == 24 { return true }
  if c == 14 { return true }
  if c == 15 { return variantNestedRow(ufi) >= 0 }
  if c == 5 { return variantRefListFieldSlot(ufi) >= 0 }
  eqVariantListFieldKind(c) >= 0
}

// The ref-list slot a code-5 variant field's element name resolves to, or -1 — the variant
// table's spelling of the `sFieldElemNameAt` + `rlSlotByNameKeyTy` pair the struct ladder's
// own code-5 arm reads.
function variantRefListFieldSlot(ufi: i32): i32 {
  const en = uFieldElemName[ufi]
  if en == "" { return 0 - 1 }
  rlSlotByNameKeyTy(en, 0 - 1)
}

// D1061 — the box tag of one arm of a mixed struct/scalar union, from whichever of the two
// per-arm columns holds it. The two tag spaces are disjoint by construction: a variant tag is an
// index into `uVariants` and `scalarTagOfKind(k)` is `uVariants.length + k`.
function unionArmTagOf(vi: i32, ak: i32, uname: string, atom: string): i32 {
  if vi >= 0 { return uTags[vi] }
  unionEqTagOfArmTy(ak, unionArmTyOfAtom(uname, atom))
}

// D1061 — one arm of a mixed struct/scalar union, dispatched on which column named it. The
// tag test that selects this arm has ALREADY proved both boxes carry it, so each half only
// has to compare the arm's own payload.
function emitUnionArmEq(
  body: i32[],
  sl: i32,
  sr: i32,
  vi: i32,
  ak: i32,
  fnIx: i32,
) {
  if vi >= 0 { return emitVariantArmEq(body, sl, sr, vi, fnIx) }
  // The NULL arm carries no payload at all: two boxes that agree on the null tag are equal,
  // and the enclosing tag test is that agreement.
  if ak == nullValKind() {
    fbI32Const(1)
    return 0
  }
  fbLocalGet(sl)
  fbStructGet(uBoxIdx, 1)
  if emitUnionPayloadUnbox(body, ak) < 0 { return -1 }
  fbLocalGet(sr)
  fbStructGet(uBoxIdx, 1)
  if emitUnionPayloadUnbox(body, ak) < 0 { return -1 }
  emitUnionAtomPayloadEq(body, ak, fnIx)
}

// One arm: cast both payloads to the arm's variant heap, park them, and AND the fields.
function emitVariantArmEq(body: i32[], sl: i32, sr: i32, vi: i32, fnIx: i32) {
  const al = unionEqArmSlot(vi)
  const ar = unionEqArmSlot(vi + 1024)
  fbLocalGet(sl)
  fbStructGet(uBoxIdx, 1)
  fbRefCast(uVarHeap[vi])
  fbLocalSet(al)
  fbLocalGet(sr)
  fbStructGet(uBoxIdx, 1)
  fbRefCast(uVarHeap[vi])
  fbLocalSet(ar)
  emitVariantFieldsEq(body, al, ar, vi, fnIx)
}

// AND the fields of variant `vi` over two already-cast variant refs parked in `al` and `ar`,
// leaving one i32. Split from `emitVariantArmEq` because the two operands do not always both
// arrive out of a box: a union compared against a concrete variant (D1071) unboxes only the left
// one and parks the right operand's own value directly. Only the unbox differs.
function emitVariantFieldsEq(
  body: i32[],
  al: i32,
  ar: i32,
  vi: i32,
  fnIx: i32,
) {
  // No bound here because both callers already took the same four — `emitStructUnionEqConcrete`
  // spells them out, and every `vis` entry the staged compare passes came through
  // `unionBoxEqColumns`, which declines a row any of the four tables does not cover.
  const start = uFieldStart[vi]
  const cnt = uFieldCount[vi]
  fbI32Const(1)
  let j = 0
  while j < cnt {
    // D1180 — a ref-niche field, and a code-15 field whose slot is `(ref null $S)` at both
    // spellings, take the null guard: the payload may legitimately be `null`, and the core
    // underneath would `struct.get` it. Without the guard an `Inner | null` arm field is
    // `vl check` rc 0 and traps on `{d: null} == {d: null}`.
    const jc = uFieldTypes[start + j]
    const jn = nulFieldInnerCode(jc)
    if jn >= 0 || jc == 15 {
      let inner = jc
      if jn >= 0 { inner = jn }
      if (
        emitVariantNulFieldEq(body, al, ar, vi, j, start + j, inner, fnIx) <
        0
      ) {
        return -1
      }
    } else {
      fbLocalGet(al)
      fbStructGet(uVarHeap[vi], j)
      fbLocalGet(ar)
      fbStructGet(uVarHeap[vi], j)
      if emitVariantFieldEqCore(body, start + j, fnIx) < 0 { return -1 }
    }
    fbI32Bin(113) // 0x71 i32.and
    j = j + 1
  }
  0
}

// `al.f == ar.f` for a nullable-slotted arm field: the struct ladder's guard, spelled over the
// two parked variant refs instead of a chain path. Both re-reads are `local.get` + `struct.get`
// — free — so the guard needs no scratch.
function emitVariantNulFieldEq(
  body: i32[],
  al: i32,
  ar: i32,
  vi: i32,
  j: i32,
  ufi: i32,
  inner: i32,
  fnIx: i32,
) {
  fbLocalGet(al)
  fbStructGet(uVarHeap[vi], j)
  wU8(209)      // 0xd1 ref.is_null
  fbIf(127)     // the left field was null
  ctrlEnter()
  fbLocalGet(ar)
  fbStructGet(uVarHeap[vi], j)
  wU8(209)      // both null ⇒ equal
  fbElse()
  fbLocalGet(ar)
  fbStructGet(uVarHeap[vi], j)
  wU8(209)
  fbIf(127)
  ctrlEnter()
  fbI32Const(0) // exactly one side null
  fbElse()
  fbLocalGet(al)
  fbStructGet(uVarHeap[vi], j)
  fbRefAsNonNull()
  fbLocalGet(ar)
  fbStructGet(uVarHeap[vi], j)
  fbRefAsNonNull()
  if emitVariantFieldEqCoreAt(body, ufi, fnIx, inner) < 0 { return -1 }
  fbEnd()
  ctrlLeave()
  fbEnd()
  ctrlLeave()
  0
}

// ONE field's compare, with both values already on the stack (left below right), leaving the
// 0/1 answer. `variantFieldComparable` is this function's admission gate and the two are
// mirrored arm for arm; the floor below is unreachable through that gate and is a floor, not
// a capability refusal.
function emitVariantFieldEqCore(body: i32[], ufi: i32, fnIx: i32) {
  emitVariantFieldEqCoreAt(body, ufi, fnIx, uFieldTypes[ufi])
}

// The same ladder keyed by an EXPLICIT code — what the null guard re-enters at the niche's
// non-null twin.
function emitVariantFieldEqCoreAt(body: i32[], ufi: i32, fnIx: i32, c: i32) {
  if c == 0 || c == 21 || c == 30 {
    fbI32Bin(70) // 0x46 i32.eq — and the two i32-sentinel niches, see the gate
    return 0
  }
  if c == 3 { return emitStrEqCore(body) }
  if c == 15 { return emitNestedShapeEq(body, ufi) }
  if c == 17 {
    fbI32Bin(97) // 0x61 f64.eq
    return 0
  }
  if c == 23 {
    fbI32Bin(81) // 0x51 i64.eq
    return 0
  }
  if c == 24 {
    fbI32Bin(91) // 0x5b f32.eq
    return 0
  }
  // A function-valued field is compared by IDENTITY (id + env), the same core a standalone
  // struct's code-14 field takes.
  if c == 14 { return emitCloEqCore(body) }
  if c == 5 {
    return emitListEqAnyRep(body, 1, variantRefListFieldSlot(ufi), fnIx)
  }
  if c == 16 {
    const vbN = uFieldElemName[ufi]
    const vbArms: string[] = []
    const vbVis: i32[] = []
    const vbAks: i32[] = []
    if !unionBoxEqColumns(vbN, vbArms, vbVis, vbAks) { return -1 }
    return emitUnionBoxEqStaged(body, vbArms, vbVis, vbAks, false, vbN, fnIx)
  }
  const lk = eqVariantListFieldKind(c)
  if lk >= 0 { return emitListEqAnyRep(body, lk, 0, fnIx) }
  emitFail("emitProgram: unsupported variant field type in equality")
}

// D974 — the interned struct row of a variant field's NESTED shape, or -1.
function variantNestedRow(ufi: i32): i32 {
  const nm = uFieldElemName[ufi]
  if nm == "" { return -1 }
  // A NAMED nested type (`type C = {r: i32}` as an arm's field) has a struct row under its
  // NAME; only an INLINE shape needs interning. Asking the name first is what makes the
  // common spelling resolve — `internInlineShapeTy("C", …)` answers -1 for it.
  const named = structIdxOfElemName(nm)
  if named >= 0 && named < sHeapIdx.length { return named }
  const row = internInlineShapeTy(nm, uFieldElemTyIxRow(ufi))
  if row < 0 { return -1 }
  if row >= sHeapIdx.length { return -1 }
  row
}

// Compare two NESTED shape refs already on the stack, field-wise. Unlike the arms themselves,
// a nested shape HAS an interned struct row, so `emitStructEqRec` is available — it just needs
// its operands parked, which is what its `-2` / `-3` sentinels read.
function emitNestedShapeEq(body: i32[], ufi: i32) {
  const row = variantNestedRow(ufi)
  if row < 0 { return -1 }
  const nl = structEqStashSlot(row)
  const nr = structEqStashSlot(row + 1024)
  fbLocalSet(nr)
  fbLocalSet(nl)
  const savedL = eqStashL
  const savedR = eqStashR
  eqStashL = nl
  eqStashR = nr
  const pathSi: i32[] = []
  const pathFi: i32[] = []
  const r = emitStructEqRec(body, -2, -3, row, pathSi, pathFi, fnIxOfNothing())
  eqStashL = savedL
  eqStashR = savedR
  r
}

// `emitStructEqRec` takes a frame index only to resolve EXPRESSION operands; the stash-sentinel
// path never reaches that, so -1 is the honest argument rather than a borrowed frame.
function fnIxOfNothing(): i32 { -1 }

// Union against union: equal iff the same arm (tag) holds and the unboxed payloads value-compare
// equal per that arm. Folded as a nested value-typed `if` chain over the shared non-null arms,
// bottoming out at bare tag equality — which covers the `null` arm and any non-shared arm. The
// right payload's unbox short-circuits on its tag too.
function emitUnionUnionEq(
  body: i32[],
  lIx: i32,
  rIx: i32,
  isNe: boolean,
  fnIx: i32,
) {
  const lname = unionNameOfExpr(lIx, fnIx)
  const rname = unionNameOfExpr(rIx, fnIx)
  // D973 — the struct-union path is tried before the re-readability gate, because it does not
  // need it: it evaluates each operand once into its own slot and reads the slots. The gate
  // exists for the value-union lowering below, which re-reads both sides per arm.
  if lname != "" && lname == rname {
    if !isValueUnionOfSet(msSetOfText(lname), lname) {
      if emitStructUnionEq(body, lIx, rIx, isNe, lname, fnIx) == 0 { return 0 }
    }
  }
  if !unionEqOperandOk(lIx) || !unionEqOperandOk(rIx) {
    return emitFail(
      "emitProgram: union `==` over a non-binding union value is not supported yet",
    )
  }
  // Both operands' member sets are resolved once, here, and every later reader takes the id —
  // rather than the gate re-splitting the rendering and each consumer resolving it again.
  const lsid = msSetOfText(lname)
  const rsid = msSetOfText(rname)
  if !isValueUnionOfSet(lsid, lname) || !isValueUnionOfSet(rsid, rname) {
    // A struct union compares by tag, then by the arm's fields (D973), riding the same
    // `{tag, payload}` box a value union does. Reaching here means `emitStructUnionEq` declined
    // the arm set, so the refusal names what it could not serve.
    return emitFail(
      "emitProgram: `==` over a struct union is not supported yet",
    )
  }
  // The shared non-null arms, matched by atom, since atoms tag globally. Both operands' member
  // lists come from the recorded member columns when the pool covers them — `msMemberAtomsOf`
  // hands back exactly the atoms `splitUnionAtoms` would, in the row's recorded box-tag order —
  // so the intersection walks two recorded lists. Each side declines independently.

  // The membership compare stays the verbatim spelling compare `unionHasAtom` performs, not
  // `unMemHasAtom`'s keyword-primitive test: an arm spelled `(() => i64)` or a litunion alias is
  // a member here and answers no there. The left row's banked value-atom codes travel with the
  // surviving arms, index-parallel to the atom column; an uncovered row marks its arms -2.
  const lAtoms: string[] = []
  if !msMemberAtomsOfSet(lsid, lAtoms) {
    const lMems: i32[] = []
    if !unionSetArmTys(lname, lAtoms, lMems) { splitUnionAtoms(lname, lAtoms) }
  }
  const lKinds: i32[] = []
  let lKindsOk = msMemberValKindsOf(lsid, lKinds)
  if lKinds.length != lAtoms.length { lKindsOk = false }
  const rAtoms: string[] = []
  let rOk = msMemberAtomsOfSet(rsid, rAtoms)
  if !rOk {
    // The right list needs the same alias expansion as the left. Without it the intersection
    // below falls to `unionHasAtom(rname, …)`, which answers false for a declared union's own
    // atoms, every arm is filtered out, and the loop emits nothing — so control reaches the
    // tag-only fallback and `==` compares just the two tags (D989).
    const rMems: i32[] = []
    if unionSetArmTys(rname, rAtoms, rMems) { rOk = true }
  }
  const arms: string[] = []
  const armKinds: i32[] = []
  let ai = 0
  while ai < lAtoms.length {
    let inR = false
    if rOk {
      let rj = 0
      while rj < rAtoms.length {
        if rAtoms[rj] == lAtoms[ai] { inR = true }
        rj = rj + 1
      }
    } else {
      inR = unionHasAtomAB(25, rname, nodeTyIxOf(unwrapParen(rIx)), lAtoms[ai])
    }
    if lAtoms[ai] != "null" && inR {
      arms.push(lAtoms[ai])
      if lKindsOk { armKinds.push(lKinds[ai]) } else { armKinds.push(-2) }
    }
    ai = ai + 1
  }
  if (
    unionHasAtomK(lsid, lname, "string", 2) &&
    unionHasAtomK(rsid, rname, "string", 2) &&
    !aUsed
  ) {
    return emitFail(
      "emitProgram: union string `==` but array type not collected",
    )
  }
  // Outermost `if` is the LAST arm (the host wraps its chain in arm order).
  let k = arms.length - 1
  while k >= 0 {
    // The READ half of the banked-kind pair: the arm's recorded code, or a per-atom
    // derivation where the bank did not cover the row.
    let armK = armKinds[k]
    if armK == -2 { armK = valueAtomKind(arms[k]) }
    if emitExpr(body, lIx, fnIx) < 0 { return -1 }
    // The arm's TAG, not `scalarTagOfKind(armK)`: a closure arm tags by SIGNATURE. Both
    // sides read the LEFT union's arm type — the intersection above matched the two arms by
    // verbatim SPELLING, so they render the same signature and claim the same slot.
    const armTag = unionEqTagOfArmTy(armK, unionArmTyOfAtom(lname, arms[k]))
    fbStructGet(uBoxIdx, 0) // left tag
    fbI32Const(armTag)
    fbI32Bin(70)            // 0x46 i32.eq
    fbIf(127)               // left holds this arm
    if emitExpr(body, rIx, fnIx) < 0 { return -1 }
    fbStructGet(uBoxIdx, 0) // right tag
    fbI32Const(armTag)
    fbI32Bin(70)            // 0x46 i32.eq
    fbIf(127)               // right holds it too → payload value-compare
    if emitExpr(body, lIx, fnIx) < 0 { return -1 }
    fbStructGet(uBoxIdx, 1) // left payload (anyref)
    if emitUnionPayloadUnbox(body, armK) < 0 { return -1 }
    if emitExpr(body, rIx, fnIx) < 0 { return -1 }
    fbStructGet(uBoxIdx, 1) // right payload (anyref)
    if emitUnionPayloadUnbox(body, armK) < 0 { return -1 }
    // D-EQOPCODE: `armK` came out of the banked `unMemValKind` column (or the per-atom
    // derivation where the row is uncovered) and already decided the two tag compares and
    // both payload unboxes above — the compare is the same code's fifth projection, not a
    // fresh question about `arms[k]`'s spelling.
    if emitUnionAtomPayloadEq(body, armK, fnIx) < 0 { return -1 }
    fbElse() // right holds a different arm → unequal
    fbI32Const(0)
    fbEnd()
    fbElse() // left holds an earlier arm → recurse down the chain
    k = k - 1
  }
  // Chain bottom: bare tag equality (null arm / non-shared arms).
  if emitExpr(body, lIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 0)
  if emitExpr(body, rIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 0)
  fbI32Bin(70) // 0x46 i32.eq
  // Close every arm's outer `if` frame.
  let c = 0
  while c < arms.length {
    fbEnd()
    c = c + 1
  }
  if isNe {
    fbI32Eqz() // 0x45 i32.eqz
  }
  0
}

// `v is <literal>` over a still-boxed mixed-rep union (`"a" | "b" | 1` boxes as `string | i32`,
// same-rep literals sharing a tag): the tag selects the literal's rep arm, then the unboxed
// payload value-compares the literal. A literal whose rep has no arm is statically false,
// evaluating the receiver for effects. The same gated shape as `emitUnionConcreteEq`.
function emitUnionLitIs(body: i32[], objIx: i32, lit: string, fnIx: i32) {
  // D1060 — a non-re-readable receiver is stashed at its first read, not refused; the same move
  // `emitUnionConcreteEq` makes, with the same bound. The compare reads the box twice — the tag,
  // then the payload inside the tag-matched arm — which is the whole content of
  // `unionEqOperandOk`, so a call receiver or a path rooted at one would otherwise refuse.

  // Teed at the first read rather than pre-emitted at the top: the receiver must be evaluated
  // where the original code evaluated it, so any context the surrounding lowering seeded is still
  // in force, and so the static-false fold below still evaluates it exactly once.
  const isStash = unionLitIsStashSlot()
  const isOnce = !unionEqOperandOk(objIx)
  const uname = unionNameOfExpr(objIx, fnIx)
  // D-VALUNION / D-SETONCE — see `emitUnionConcreteEq`.
  const usid = msSetOfText(uname)
  // The arm spellings with a declared alias resolved — every predicate below that reads a name
  // reads this one, while the interned set stays keyed on the name the receiver carries.
  // `unionHasAtomTy` and `unionTakesAtomAsStr` answer by splitting the spelling at top-level `|`,
  // so a `type W = K | i32` alias splits to the single atom `"W"` and no arm holds a literal.
  const unmArms = unionMemberSetOf(uname)
  // D1047 — the empty-name reject stays ahead of the atom ladder. The ladder's i64-widening rung
  // and the mixed-union gate below both ask `unionHasAtomK`, whose fall-through fails loudly on
  // an unregistered row, and a receiver whose union has no name has no row at all. The message is
  // the condition's own; the branch is a floor, unreached by the tests and by the corpus.
  if uname == "" {
    return emitFail(
      "emitProgram: literal `is` over a union with no recorded members",
    )
  }
  // The literal's rep atom: a quoted lexeme is a string, a float f64, an integer i32 — widening
  // to i64 when out of range or when the union's only integer arm is i64, the `emitUnionCoerce`
  // default. The ladder settles the ABI code alongside the spelling, and the map is a bijection
  // on its own image, so the code assigned is the code a parse of its output would return.
  let atom = "i32"
  let lak = 0
  // The quoted-leaf test at its home (`tyname.nameIsQuotedLeaf`). This site carries no bound of
  // its own: every caller reaches it through `isLitVariantName`, whose `length == 0` reject is
  // the bound.
  if nameIsQuotedLeaf(lit) {
    atom = "string"
    lak = 2
  } else if numLexIsFloat(lit) {
    atom = "f64"
    lak = 4
  } else if !numLexFitsI32(lit) {
    atom = "i64"
    lak = 3
  } else if (
    !unionHasAtomK(usid, unmArms, "i32", 0) &&
    unionHasAtomK(usid, unmArms, "i64", 3)
  ) {
    atom = "i64"
    lak = 3
  }
  // A quoted literal has a rep arm whenever the box can carry it as a string ref — a plain
  // `string` arm or a literal-union arm, which is exactly `unionTakesAtomAsStr`'s question.
  // Without its second leg a `K | f64` box statically answers `is "aa"` false: the member kinds
  // bank only `f64`, so the arm that holds the value looks absent. It is the gate's third disjunct.
  let litHasArm = unionHasAtomK(usid, unmArms, atom, lak)
  if !litHasArm && lak == 2 && unionTakesAtomAsStr(unmArms) { litHasArm = true }
  // A union carrying a literal-union alias arm (`K | string`, `K | f64`) is a box like any value
  // union — the arm rides it as its member string — but `isValueUnionName` declines it because
  // `valueAtomKind("K")` is -1. Same box, same tags, so the lowering below is unchanged; only the
  // gate has to know the second spelling.

  // D1047 — and the third disjunct, `litHasArm`, mirrors the `==` twin's `eqMixedOk`: a mixed
  // union is testable against a scalar literal over the same tag-then-payload shape. The compare
  // is arm-agnostic, so a struct or container arm simply has a tag that does not match. Widened
  // only where the literal's own rep has an arm, which the static-false fold below already trusts.
  if (
    !isValueUnionOfSet(usid, uname) &&
    !unionCarriesLitUnionArm(uname) &&
    !litHasArm
  ) {
    return emitFail(
      "emitProgram: literal `is` over a union with no arm of the literal's rep",
    )
  }
  if !litHasArm {
    if emitExpr(body, objIx, fnIx) < 0 { return -1 }
    fbDrop() // 0x1a drop
    fbI32Const(0)
    return 0
  }
  // `lak` decides the tag, the payload unbox and the three constant-emit arms below — one code,
  // five projections.
  if lak == 2 && !aUsed {
    return emitFail(
      "emitProgram: string `is` test but array type not collected",
    )
  }
  if emitExpr(body, objIx, fnIx) < 0 { return -1 }
  if isOnce { fbLocalTee(isStash) }
  fbStructGet(uBoxIdx, 0) // 0xfb 0x02 <box ht> field 0: tag
  fbI32Const(scalarTagOfKind(lak))
  fbI32Bin(70)            // 0x46 i32.eq
  fbIf(127)               // 0x04 if, 0x7f i32 result blocktype
  if isOnce { fbLocalGet(isStash) }
  else if emitExpr(body, objIx, fnIx) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
  if emitUnionPayloadUnbox(body, lak) < 0 { return -1 }
  if lak == 2 {
    // The literal lexeme rides a synthesized `StrLit` (same shape as `strText`).
    if emitExpr(body, mkStr(lit, -1), fnIx) < 0 { return -1 }
    if emitStrEqCore(body) < 0 { return -1 }
  } else if lak == 4 {
    fbF64Const(lit)
    fbI32Bin(97) // 0x61 f64.eq
  } else if lak == 3 {
    const pr = parseI64Pair(lit)
    fbI64Const(pr[0], pr[1])
    fbI32Bin(81) // 0x51 i64.eq
  } else {
    fbI32Const(parseI32(lit))
    fbI32Bin(70) // 0x46 i32.eq
  }
  fbElse() // wrong-rep arm — the literal can never match
  fbI32Const(0)
  fbEnd()  // 0x0b end
  0
}

// True if a variant field code has an `if (result …)` blocktype the shared-field dispatch can
// spell. The table's rationale is at the dispatch site in `emitMem`.
function sharedFieldCodeDispatchable(code: i32): boolean {
  if code == 0 {
    return true // i32 / boolean — single valtype byte 0x7f
  }
  if code == 17 {
    return true // f64 — 0x7c
  }
  if code == 23 {
    return true // i64 — 0x7e
  }
  if code == 24 {
    return true // f32 — 0x7d
  }
  if code == 3 {
    return aUsed // string — the `(ref $sTypeIdx)` blocktype form
  }
  false
}

// The field-rep codes a `?.` … `??` may carry — `sharedFieldCodeDispatchable` minus the string
// one. Both arms of the `if` have to leave the field's rep on the stack; a wide numeric default
// coerces (`emitOptChainDefault`), but a string default in this value position builds a module the
// engine refuses, its scratch reservation decided by a scan with no arm for this site.
function optChainFieldCodeOk(code: i32): boolean {
  // A string leaf (code 3 or 20) does not reach here: `exprNullableString` calls a `?.` over a
  // string field `string | null`, so `emitCoalesce`'s string-niche arm claims the spelling first
  // (D802). A value-union field (code 16) is admitted — `exprUnion` and `unionNameOfExpr` both
  // answer for a code-16 chain leaf, so the blocktype and the binding's cell agree.
  if code == 16 { return true }
  sharedFieldCodeDispatchable(code)
}

// The DEFAULT arm of a `?.` … `??`, at the field's rep. A wide numeric field needs the
// default WIDENED to it — `?? 1` against an `i64` field is an `i32.const` unless somebody
// says otherwise, and the `if`'s blocktype is `i64`: invalid wasm. Same three coercions
// `emitUnionCoerce`'s ladder performs for the same reason, and for the same three codes.
function emitOptChainDefault(
  body: i32[],
  dIx: i32,
  code: i32,
  unionName: string,
  fnIx: i32,
) {
  // A value-union field: the block type is the BOX, so the default has to arrive as one —
  // `emitUnionCoerce` is the same ladder every other `??`-into-a-box arm uses, and it passes
  // a value that already IS the box through unchanged. D803.
  if code == 16 { return emitUnionCoerce(body, unionName, dIx, fnIx) }
  if code == 17 { return emitExprAsF64(body, dIx, fnIx) }
  if code == 23 { return emitExprAsI64(body, dIx, fnIx) }
  if code == 24 {
    const savedF32 = pendingF32
    pendingF32 = true
    const rc = emitExprAsF32(body, dIx, fnIx)
    pendingF32 = savedF32
    return rc
  }
  emitExpr(body, dIx, fnIx)
}

// Emit the `if` whose result is the shared field's rep. Only called for a code
// `sharedFieldCodeDispatchable` admitted, so it has no failure arm of its own.
function fbIfForSharedField(code: i32) {
  // The value-union BOX. `sharedFieldCodeDispatchable` still declines code 16, so the
  // shared-union-field dispatch never asks for this spelling; the `?.` … `??` arm does
  // (`optChainFieldCodeOk` admits it), and putting the blocktype here rather than at that
  // site keeps ONE speller for "the `if` result is this field's rep".
  if code == 16 {
    return fbIfRef(uBoxIdx) // (ref $uBox)
  }
  if code == 17 {
    return fbIf(124) // f64
  }
  if code == 23 {
    return fbIf(126) // i64
  }
  if code == 24 {
    return fbIf(125) // f32
  }
  if code == 3 {
    return fbIfRef(sTypeIdx) // string header ref
  }
  fbIf(127) // i32 / boolean
}

// Push the shared-field dispatch's receiver box: the value stashed in `slot` when the receiver
// is evaluated once (`slot >= 0`), else a fresh emission of the place — an ident, effect-free.
// One function so the tag test and the payload read cannot pick different halves.
function emitSharedFieldRecv(body: i32[], recvIx: i32, fnIx: i32, slot: i32) {
  if slot >= 0 {
    fbLocalGet(slot)
    // The lazy frame's ref slots are NULLABLE (they must be defaultable), and `struct.get`
    // takes a non-null ref. The value stored is the receiver's own box, so this recovers a
    // nullness the store never had; it cannot trap on a checked program (the checker
    // refuses a shared read through a nullable receiver outright).
    return fbRefAsNonNull() // 0xd4
  }
  emitExpr(body, recvIx, fnIx)
}

// The one home for "a code-16 value-union-box field read whose member path is narrowed to a
// single scalar atom unboxes to that atom's rep". The receiver's own shape decides which
// `struct.get` produced the box — the plain struct table, the arm's `uVarHeap` row, or the
// nullable form of the same — but the unbox after it is one sequence.

// `narrowedValueAtomOf`, not the raw `narrowVariantFor` and `valueAtomKind` pair: a litunion-alias
// narrow must unbox as the string ref the box stores its member as, which is the ident read
// discipline. An un-narrowed read yields the box unchanged, so a "" atom emits nothing.
function emitUnionFieldNarrowUnbox(memIx: i32, fnIx: i32) {
  // The CONTAINER arms of the same narrowing (`if n.v is K[]`, `if n.v is {[string]: K}`) —
  // disjoint from the value atom below, which answers "" for both (D1014).
  const mCon = emitPlaceNarrowContainerUnbox(memIx, fnIx)
  if mCon != 0 { return mCon - 1 }
  const mAtom = narrowedValueAtomOf(memberPathKeyOf(memIx))
  if mAtom == "" {
    // D209 — the un-narrowed read the checker typed as a bare atom. The box is the adoption's
    // rep, not the program's: `structIndexOfObjCtx` takes a declared row for an un-annotated
    // literal, so the field is code 16 while the checker never widened the value. Deliver the
    // atom the checker's consumers are typed against; `exprUnion` asks this same predicate.

    // The payload is not always at that atom: a declared `i64 | null` member makes the store
    // widen `7` into `$vbI64` while the checker still types the read `i32`, so cast to what the
    // store put there and narrow back. A `??`-merged box genuinely holds two, so no single cast
    // is right — dispatch on the tag the box carries, only where every arm reaches it.
    const ck = memReadUnboxAtomKind(memIx, fnIx)
    if ck < 0 { return 0 }
    const bk = memReadBoxedAtomKind(memIx, fnIx)
    const bks: i32[] = []
    if memReadBoxedAtomKinds(memIx, fnIx, bks) {
      if bks.length > 1 && atomKindsAllConvertible(bks, ck) {
        return emitUnionFieldTagDispatch(bks, ck)
      }
    }
    if emitUnboxToAtomKind(bk) < 0 { return -1 }
    return emitNarrowStoredAtomKind(bk, ck)
  }
  // The narrowed atom's ABI code decides both arms, exactly as it does at the variant-field twin
  // of this read (`emitNarrowedMem`, the same three instructions and the same two arms) — one
  // derivation, not a spelling compare beside a second `vbHeapIdxOfAtom`.
  emitUnboxToAtomKind(valueAtomKind(mAtom))
}

// D927 — the tag-dispatched unbox: one arm per atom the box can hold, each converted to the
// checker's atom `ck`, in `splitUnionAtoms` order with the last arm as the unconditional
// fall-through. The box is on the stack when this is entered, so it is stashed once — each arm
// reads it twice, and re-emitting a receiver per arm is what `sharedFieldRecvSlot` exists for.
function emitUnionFieldTagDispatch(kinds: i32[], ck: i32) {
  const slot = sharedFieldRecvSlot()
  fbLocalSet(slot)
  let i = 0
  while i < kinds.length - 1 {
    fbLocalGet(slot)
    fbStructGet(uBoxIdx, 0) // field 0: tag
    fbI32Const(scalarTagOfKind(kinds[i]))
    fbI32Bin(70) // 0x46 i32.eq
    fbIfForAtomKind(ck)
    ctrlEnter()
    fbLocalGet(slot)
    if emitUnboxToAtomKind(kinds[i]) < 0 { return -1 }
    if emitConvertAtomKind(kinds[i], ck) < 0 { return -1 }
    fbElse()
    i = i + 1
  }
  fbLocalGet(slot)
  if emitUnboxToAtomKind(kinds[kinds.length - 1]) < 0 { return -1 }
  if emitConvertAtomKind(kinds[kinds.length - 1], ck) < 0 { return -1 }
  let e = 0
  while e < kinds.length - 1 {
    fbEnd()
    ctrlLeave()
    e = e + 1
  }
  0
}

// D927 — the `if` blocktype for a value-atom kind, the atom-side twin of `fbIfForSharedField`'s
// field-code one. Two spellers rather than one because the two callers hold two vocabularies — a
// field code there, a `valueAtomKind` here — and deriving one from the other is what lets a
// spelling compare stand in for a code.
function fbIfForAtomKind(k: i32) {
  if k == 2 {
    return fbIfRef(sTypeIdx) // string header ref
  }
  if k == 3 {
    return fbIf(126) // i64
  }
  if k == 4 {
    return fbIf(124) // f64
  }
  if k == 5 {
    return fbIf(125) // f32
  }
  fbIf(127) // i32 / boolean
}

// D927 — can a payload boxed at `from` be delivered at `to`? The predicate half of
// `emitConvertAtomKind`, asked before any byte is written so the dispatch can stand down whole
// rather than fail in the middle of an arm. `emitNarrowStoredAtomKind`'s four narrowings and
// their five widening inverses; a string or boolean arm converts to nothing but itself.
function atomKindConvertible(from: i32, to: i32): boolean {
  if from == to { return true }
  if from == 0 { return to == 3 || to == 4 || to == 5 }
  if from == 3 { return to == 0 || to == 4 }
  if from == 4 { return to == 0 }
  if from == 5 { return to == 0 || to == 4 }
  false
}

// D927 — every arm of the box, or the dispatch does not run.
function atomKindsAllConvertible(kinds: i32[], to: i32): boolean {
  let i = 0
  while i < kinds.length {
    if !atomKindConvertible(kinds[i], to) { return false }
    i = i + 1
  }
  true
}

// D927 — the conversion itself. The NARROWING half is `emitNarrowStoredAtomKind`'s, reached
// through it so the two cannot drift; the WIDENING half is the direction that function refuses
// by design, because until a box held two atoms nothing ever needed it.
function emitConvertAtomKind(from: i32, to: i32) {
  if from == to { return 0 }
  if from == 0 {
    if to == 3 {
      fbI64ExtendI32S()
      return 0
    }
    if to == 4 {
      fbF64ConvertI32S()
      return 0
    }
    if to == 5 {
      fbF32ConvertI32S()
      return 0
    }
  }
  if from == 3 && to == 4 {
    fbF64ConvertI64S()
    return 0
  }
  emitNarrowStoredAtomKind(from, to)
}

// D291 — the inverse of the store's widening: a payload boxed at kind `from` because the union's
// arm is wider, delivered at the kind `to` the checker typed the read's consumers against, and
// nothing at all when the two agree. The four conversions are exactly the four promotions
// `unionStoreAtomKind` performs, each exact; any other pair is a loud reject rather than a guess.
function emitNarrowStoredAtomKind(from: i32, to: i32) {
  if from == to { return 0 }
  if to == 0 {
    if from == 3 {
      fbI32WrapI64()
      return 0
    }
    if from == 4 {
      fbI32TruncF64S()
      return 0
    }
    if from == 5 {
      fbI32TruncF32S()
      return 0
    }
  }
  if to == 4 && from == 5 {
    fbF64PromoteF32()
    return 0
  }
  emitFail(
    "emitProgram: union field read stored at an atom the checker's atom cannot be recovered from",
  )
}

// The unbox sequence for a value-union box payload at atom kind `mfk`: `struct.get $uBox 1` and
// then the atom's own recovery. One home, so the narrowed read and the un-narrowed one cannot
// emit different instructions for the same atom.

// The recovery itself is `emitUnionUnboxTail`'s, not a second copy of it (D1014): a second ladder
// drifts, refusing a list or closure arm the ident read recovers. What is genuinely this site's
// own is the `aUsed` guard, which turns an unminted `sTypeIdx` into a message.
function emitUnboxToAtomKind(mfk: i32) {
  if mfk == 2 {
    if !aUsed {
      return emitFail(
        "emitProgram: narrowed string union field read but array type not collected",
      )
    }
  }
  emitUnionUnboxTail(mfk)
}

// The message for one of `emitMem`'s three field-access floors — `dflt` prefixed, except for a
// `.length` read, which gets its own. `.length` reaches a floor only through a type parameter:
// every rep that has a length is answered by a classifier above, and a declared struct with a
// `length` field by the struct read these floors guard.

// It is a message swap at the floor and not a guard above it, and the order is the point: the
// same arm at the head of the block takes `Buf.length` with it. Only the corpus `cmp` sees that
// difference — grid, grade columns and histogram are unmoved.
function memFloorMsg(memIx: i32, dflt: string): string {
  const m = P.nodes[memIx]
  if m is Member {
    if m.memProp == "length" {
      return "emitProgram: '.length' on a receiver the emitter cannot classify as a list, string, map or set"
    }
  }
  "emitProgram: " + dflt
}

function emitMem(body: i32[], memIx: i32, fnIx: i32) {
  // A field read on a narrowed union identifier downcasts through the box, only where the narrow
  // names one variant — the whole of what this route can lower.

  // D1083 — a null-complement narrowing (`type U = A | B | null` under `if u != null`) banks the
  // surviving set as the string `"A | B"`, which `memIsNarrowed` answers true for, so an exact
  // compare against a table holding `A` and `B` separately refuses a check-clean program. Asking
  // `memNarrowVariantIndex` lets a multi-variant survivor set reach the dispatch below instead.
  if memIsNarrowed(memIx) {
    if memNarrowVariantIndex(memIx) >= 0 {
      return emitNarrowedMem(body, memIx, fnIx)
    }
  }
  // A field read on a VARIANT-typed param `o.field` (`o: TyObj`) reads the variant
  // struct directly — the param already IS the unboxed variant ref, so there is NO box
  // unwrap / cast (gap #2). Evaluate the receiver (`local.get o`), then `struct.get
  // $<uVarHeap[vi]> <fieldIdx>`.
  const m0 = P.nodes[memIx]
  if m0 is Member {
    const pvi = exprVariantIndex(m0.memObj, fnIx)
    if pvi >= 0 {
      const pvfi = variantFieldIndex(pvi, m0.memProp)
      if pvfi < 0 {
        return emitFail("emitProgram: unknown variant field in field access")
      }
      if emitExpr(body, m0.memObj, fnIx) < 0 { return -1 }
      fbStructGet(uVarHeap[pvi], pvfi) // 0xfb 0x02 <variant struct ht> <field index>
      // A code-16 (value-union box) field of the arm, read while its member PATH is
      // narrowed, unboxes to the narrowed atom — the arm-for-arm twin of the plain
      // struct read below and of `emitNarrowedMem`'s. Without it the box flowed into an
      // i32 consumer: check-clean INVALID WASM (silent-class-inventory D219).
      if variantFieldTypeAt(pvi, pvfi) == 16 {
        if emitUnionFieldNarrowUnbox(memIx, fnIx) < 0 { return -1 }
      }
      return 0
    }
    // The nullable form of the same read (`c: Circle | null`, inside its `!= null` branch).
    // Identical `struct.get`, one `ref.as_non_null` ahead of it: the cell is a
    // `(ref null $uVarHeap[vi])` and `struct.get` takes a non-null ref. The assertion cannot trap
    // where the checker admits the read — such an access is only reachable through a null test.
    const nvi = nulVariantIdxOfExpr(m0.memObj, fnIx)
    if nvi >= 0 {
      if exprNullableVariant(m0.memObj, fnIx) {
        const nvfi = variantFieldIndex(nvi, m0.memProp)
        if nvfi < 0 {
          return emitFail("emitProgram: unknown variant field in field access")
        }
        if emitExpr(body, m0.memObj, fnIx) < 0 { return -1 }
        fbRefAsNonNull() // 0xd4 — the enclosing null test narrowed it
        fbStructGet(uVarHeap[nvi], nvfi)
        if variantFieldTypeAt(nvi, nvfi) == 16 {
          if emitUnionFieldNarrowUnbox(memIx, fnIx) < 0 { return -1 }
        }
        return 0
      }
    }
  }
  // The shared-field dispatch's result rep. The dispatch below is a chain of `if (result …)`
  // blocks, one per box tag, so the field's rep has to be spellable as a blocktype. Pinned to i32
  // it would make `(A | B).tag` readable for an i32 or boolean field and a loud floor for an
  // `f64`, `i64`, `f32` or `string` one.

  // The three remaining scalars are their own single valtype byte. String needs the other form,
  // `fbIfRef`, since a `(ref $sTypeIdx)` result is not a valtype byte, and it is the code that
  // matters most: a discriminated union's tag is a string field. The predicate and the emitter are
  // two functions over one table because the validation loop must decline before any bytes.

  // Shared-field access over an un-narrowed struct union (`(A | B).tag`): the checker proved the
  // field present on every member, but members may store it at different indices, so dispatch on
  // the box tag and read the field at that member's own index. The arms are exhaustive, the last
  // member being the unconditional fall-through. A narrowed set dispatches over its survivors.
  const mS = P.nodes[memIx]
  if mS is Member {
    // The plan is shared. `sharedUnionFieldPlan` owns the receiver test, the narrowed-set member
    // resolution and the per-member field lookup — the same derivation both classifier twins
    // read, so what this lowers and what `print` dispatches cannot disagree. Dispatchability
    // stays here, being a question about spelling a blocktype rather than about typing a read.
    const shVis: i32[] = []
    const shFis: i32[] = []
    const shCode = sharedUnionFieldPlan(
      mS.memObj,
      mS.memProp,
      fnIx,
      shVis,
      shFis,
    )
    if shCode >= 0 && sharedFieldCodeDispatchable(shCode) {
      // The receiver is evaluated once unless re-emitting it is free. The arms below read it
      // twice each — the tag test, then the payload cast — which is why an ident receiver, whose
      // `local.get` re-emits for nothing, needs no slot. A call does not: `g(true).v` would call
      // `g` 2N-1 times, and that restriction is why this family floors.

      // The stash slot is handed out here, during lowering (`sharedFieldRecvSlot`, the lazy list
      // frame), not reserved by a pre-pass: a pre-pass runs before any `is`-narrowing is active
      // and this question consults narrowing, so the two answers differ in both directions. An
      // ident receiver takes no slot and re-emits, so existing programs emit the same bytes.
      const shRecv = P.nodes[unwrapParen(mS.memObj)]
      let shSlot = -1
      if !(shRecv is Ident) {
        shSlot = sharedFieldRecvSlot()
        if emitExpr(body, mS.memObj, fnIx) < 0 { return -1 }
        fbLocalSet(shSlot)
      }
      let si2 = 0
      while si2 < shVis.length - 1 {
        if emitSharedFieldRecv(body, mS.memObj, fnIx, shSlot) < 0 { return -1 }
        fbStructGet(uBoxIdx, 0)    // field 0: tag
        fbI32Const(uTags[shVis[si2]])
        fbI32Bin(70)               // 0x46 i32.eq
        fbIfForSharedField(shCode) // if (result <the field's own rep>)
        if emitSharedFieldRecv(body, mS.memObj, fnIx, shSlot) < 0 { return -1 }
        fbStructGet(uBoxIdx, 1)    // field 1: value (anyref)
        fbRefCast(uVarHeap[shVis[si2]])
        fbStructGet(uVarHeap[shVis[si2]], shFis[si2])
        fbElse()
        si2 = si2 + 1
      }
      const shLast = shVis.length - 1
      if emitSharedFieldRecv(body, mS.memObj, fnIx, shSlot) < 0 { return -1 }
      fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
      fbRefCast(uVarHeap[shVis[shLast]])
      fbStructGet(uVarHeap[shVis[shLast]], shFis[shLast])
      let se = 0
      while se < shVis.length - 1 {
        fbEnd()
        se = se + 1
      }
      return 0
    }
  }
  // The three field-access floors are node-anchored (`emitFailAt`), not function-anchored. A
  // reader given "line 3, inside `g`" for a read on line 7 looks in the wrong place, and for a
  // top-level read that is what the function cursor says — the start function is lowered last, so
  // `emitCurFnIx` still names the file's final `function`.
  if !sDeclared {
    return emitFailAt(
      memFloorMsg(memIx, "field access but no struct type declared"),
      memIx,
    )
  }
  const m = P.nodes[memIx]
  if m is Member {
    const si = structIndexOfExpr(m.memObj, fnIx)
    if si < 0 {
      return emitFailAt(
        memFloorMsg(memIx, "field access receiver is not a struct"),
        memIx,
      )
    }
    const idx = sFieldIndex(si, m.memProp)
    if idx < 0 {
      return emitFailAt(
        memFloorMsg(memIx, "unknown struct field in field access"),
        memIx,
      )
    }
    if emitExpr(body, m.memObj, fnIx) < 0 { return -1 }
    // A NULLABLE-struct receiver (`S | null`) recovers its non-null ref before the
    // field read — the checker proved every such access guarded, so the cast can
    // never trap on a checked program.
    if exprNullableStruct(m.memObj, fnIx) {
      wU8(212) // 0xd4 ref.as_non_null
    }
    fbStructGet(sHeapIdx[si], idx) // 0xfb 0x02 <struct ht> <field index>
    // The `string | null` read rule (field code 20, slot kind 16), shared verbatim by this field
    // read and the global, param and local ident reads in `emitIdentNode`. A value read recovers
    // the non-null string ref, the checker having narrowed it non-null at every value read.

    // Exactly two contexts suppress the recovery and keep the raw nullable ref: a null test, which
    // needs `ref.is_null`, and a nullable-string target, where recovering would `ref.as_non_null`
    // a legitimately-null value and trap. A `boolean | null` field needs no recovery at all.
    if sFieldTypeAt(si, idx) == 20 {
      if !nulStrReadStaysRaw() {
        wU8(212) // 0xd4 ref.as_non_null
      }
    }
    // A union-typed field (code 16) read while the member path is narrowed to one scalar atom
    // (`if o.y is i32 { … o.y … }`) unboxes the payload — the same recovery as a narrowed union
    // ident read; an un-narrowed read is the box. `narrowedValueAtomOf` rather than the raw pair,
    // so a litunion-alias narrow unboxes as the string ref the box stores its member as.
    if sFieldTypeAt(si, idx) == 16 {
      if emitUnionFieldNarrowUnbox(memIx, fnIx) < 0 { return -1 }
    }
    return 0
  }
  emitFail("emitProgram: expected a field access")
}

// ── string-literal decoding ─────────────────────────────────────────────────

// A `StrLit` carries the raw lexeme in `strText` — quotes kept, escapes unresolved — so the
// emitter decodes it here to the sequence of Unicode code points the string denotes, walking the
// lexeme by iteration under the same escape grammar the lexer applies (`scanQuoted`):
// `\n \t \r \\ \" \' \0 \b \f \v`, `\xXX`, `\uXXXX`, `\u{…}`. `cpsToUtf8` then encodes them.

// Lower a string literal onto `body`: decode `strText` to its code-point vector, UTF-8-encode it,
// push each byte as `i32.const`, then `array.new_fixed $sBackIdx <count>` for the packed
// `(array (mut i8))` backing and `struct.new $sTypeIdx` for the whole-backing header.

// A literal past the `array.new_fixed` operand cap builds the backing chunked and wraps once at
// the end. The cap is counted in bytes, because the operands are bytes, and `collectStrPool`
// applies the same budget: a literal the pool accepted but this rejected would be emitted twice
// under two different shapes.
function emitStr(_body: i32[], strIx: i32, _fnIx: i32) {
  if !aUsed {
    return emitFail("emitProgram: string literal but array type not collected")
  }
  const s = P.nodes[strIx]
  if s is StrLit {
    // A POOLED literal (every distinct literal within the `array.new_fixed` cap —
    // `collectStrPool`) reads its interned immutable global: one `global.get`
    // instead of an i32.const-per-codepoint allocation at every evaluation.
    const pi = gStrPoolIx[s.strText] ?? -1
    if pi >= 0 {
      fbGlobalGet(pi) // the pool occupies global indices 0..pool-1
      return 0
    }
    const cps = cpsToUtf8(decodeStr(strToCps(s.strText)))
    if cps.length > NEW_FIXED_MAX {
      // Past the engines' `array.new_fixed` operand cap — build chunked, since an unchunked
      // emit validates nowhere. The chunked build fills the backing; the header is wrapped
      // around it once the last chunk lands.
      const dst = arrLitChunkStart("i32", 0, sBackIdx, cps.length, true)
      let ci = 0
      let coff = 0
      while ci < cps.length {
        fbI32Const(cps[ci])
        ci = ci + 1
        coff = arrLitChunkFlush(dst, sBackIdx, coff, ci, cps.length)
      }
      fbLocalGet(dst)
      wU8(212)               // 0xd4 ref.as_non_null (the slot is declared nullable)
      fbI32Const(0)          // start
      fbI32Const(cps.length) // len
      fbStrNew()             // the view over the whole freshly built backing
      return 0
    }
    let i = 0
    while i < cps.length {
      fbI32Const(cps[i]) // 0x41 i32.const <code point>
      i = i + 1
    }
    fbArrayNewFixed(sBackIdx, cps.length) // 0xfb 0x08 <typeidx> <count>
    fbI32Const(0)                         // start
    fbI32Const(cps.length)                // len
    fbStrNew()                            // 0xfb 0x00 <string header>
    return 0
  }
  emitFail("emitProgram: expected a string literal")
}

// Lower an array literal `[e, e, ...]` onto `body` as a growable list value: push each element
// value in source order, `array.new_fixed $aTypeIdx <count>` for the raw backing, then `count`
// twice for len and cap and `struct.new $lTypeIdx` to wrap them into `{ backing, len, cap }`. An
// empty `[]` is `array.new_fixed` of count 0 with len and cap 0.
function emitArr(body: i32[], arrIx: i32, fnIx: i32) {
  const a = P.nodes[arrIx]
  if a is ArrayLit {
    const elems = a.arrElems
    // Which (backing, wrapper) pair the literal builds — `pendingListKind` 1/2 a ref backing, 3 a
    // string one, 4 f64, 6 i64, 7 f32, anything else the default `$lTypeIdx` i32 list. Two signals
    // answer it: the literal's own elements (`arrLitIs*`) and a threaded annotation from the
    // binding, field or param. A threaded kind is authoritative and clears what it displaces.
    let isRefLit = arrLitIsRef(arrIx)
    let isStrLit = arrLitIsStr(arrIx, fnIx)
    let isF64Lit = arrLitIsF64(arrIx, fnIx)
    let isI64Lit = arrLitIsI64(arrIx, fnIx)
    // A literal whose elements are all f32-typed values self-identifies, exactly as the f64 and
    // i64 forms above do. A bare float literal stays f64 — `arrLitIsF32` claims only `exprIsF32`
    // elements, and a `.` literal is deliberately not one — so an annotation remains the only
    // route to `[1.5]` as an f32 list.
    let isF32Lit = arrLitIsF32(arrIx, fnIx)
    if pendingListKind == 6 {
      isI64Lit = true
      isF64Lit = false
      isStrLit = false
      isF32Lit = false
    }
    if pendingListKind == 4 {
      isF64Lit = true
      isI64Lit = false
      isStrLit = false
      isF32Lit = false
    }
    if pendingListKind == 7 {
      isF32Lit = true
      isF64Lit = false
      isI64Lit = false
      isStrLit = false
    }
    if elems.length == 0 {
      if pendingListKind == 3 {
        isStrLit = true
      } else if pendingListKind == 4 {
        isF64Lit = true
      } else if pendingListKind == 6 {
        isI64Lit = true
      } else if pendingListKind == 7 {
        isF32Lit = true
      } else if pendingListKind == 8 {
        // A `(boolean | null)[]` empty literal — a plain i32-list wrapper (the boolean
        // sentinel niche shares the i32 backing); nothing to force here.
      } else {
        if pendingListKind != 0 { isRefLit = true }
      }
    }
    // A non-empty literal under a threaded union-list annotation (kind 2) is a ref literal even
    // when its elements are bare scalars or strings: a `(string|i32)[]` literal's elements coerce
    // into the union box at the write boundary, they do not type the list. Without the annotation
    // a scalar literal stays the i32 list.
    if pendingListKind == 2 {
      isRefLit = true
      isStrLit = false
      isF64Lit = false
      // An `(i64 | null)[]` literal's i64-typed first element must not claim the scalar
      // i64-list path — the elements box (kind 2), like the f64/string forms above.
      isI64Lit = false
      // An `(f32 | null)[]` literal's f32 elements box the same way.
      isF32Lit = false
    }
    // A closure-element list (kind 5, `((i32) => i32)[]`): a literal of function values reads as
    // bare idents, so `arrLitIsRef` — which keys off an objlit or nested-array first element —
    // misses it, and the threaded annotation is authoritative. `isI64Lit` clears too, or a
    // ref-list value with an i64-magnitude first element would build the scalar i64 wrapper.
    if pendingListKind == 5 {
      isRefLit = true
      isStrLit = false
      isF64Lit = false
      isI64Lit = false
      isF32Lit = false
    }
    // A STRUCT ref-list (kind 1) under a threaded annotation: authoritative, like kind 2/5.
    // Matters for a NULLABLE-struct array (`(P | null)[]`) whose FIRST element is `null` —
    // `arrLitIsRef` keys off the first element (a `null` is neither objlit nor nested array)
    // and would otherwise mis-route the literal to the i32-list path.
    if pendingListKind == 1 {
      isRefLit = true
      isStrLit = false
      isF64Lit = false
      isI64Lit = false
      isF32Lit = false
    }
    // An ATOM-element literal under a threaded atom context (`pendingLitUnion` — a `K[]`
    // field / binding): the member elements are STRING exprs syntactically (`arrLitIsStr`
    // would claim the string-list build), but each lowers as its interned i32 atom id —
    // the i32-list path is authoritative, like the kind overrides above.
    if pendingLitUnion == 1 {
      isRefLit = false
      isStrLit = false
      isF64Lit = false
      isI64Lit = false
      isF32Lit = false
    }
    // A `(K | null)[]` literal (`pendingListKind == 9`, or a probe-detected element type): its
    // member-literal elements lower as interned i32 atom ids and a `null` as the -1 sentinel, so
    // the i32-list path is authoritative even when the first element is a string literal, which
    // `arrLitIsStr` would otherwise claim. The element seeds are set further below.
    if pendingListKind == 9 || nodeArrayElemIsNulLitUnion(arrIx) {
      isRefLit = false
      isStrLit = false
      isF64Lit = false
      isI64Lit = false
      isF32Lit = false
    }
    // A `u8[]` literal (`pendingListKind == 10`) — the packed byte list. Checked ahead of every
    // scalar arm below and returning directly, because the elements are ordinary i32 expressions:
    // nothing about the literal itself says `u8`, only the threaded annotation does. Each element
    // is emitted as a plain i32 and `array.new_fixed` truncates it into the packed byte.

    // 13 is `nulu8list`, a `u8[] | null` destination: the same packed path with a nullable cell.
    // Its three siblings each get an arm above (4 f64, 6 i64, 7 f32) that flips the literal's
    // element flag; without one, the literal falls to the default i32 backing while the cell is
    // typed as the packed wrapper — two heap types for one value (D983). `coerceListKind` maps it.
    if pendingListKind == 10 || pendingListKind == 13 {
      if !ba8Used {
        return emitFail(
          "emitProgram: u8 array literal but u8 list type not collected",
        )
      }
      if elems.length > NEW_FIXED_MAX {
        return emitFail(
          "emitProgram: u8 array literal is too long for one array.new_fixed",
        )
      }
      let iu8 = 0
      while iu8 < elems.length {
        if exprArray(elems[iu8], fnIx) || exprRefArray(elems[iu8], fnIx) {
          return emitFail("emitProgram: nested arrays are not supported")
        }
        if emitExpr(body, elems[iu8], fnIx) < 0 { return -1 }
        iu8 = iu8 + 1
      }
      fbArrayNewFixed(ba8TypeIdx, elems.length) // builds the packed byte backing
      fbI32Const(elems.length)                  // len
      fbI32Const(elems.length)                  // cap
      fbStructNew(bl8TypeIdx)                   // the `u8[]` wrapper
      return 0
    }
    if isF32Lit {
      if !fa32Used {
        return emitFail(
          "emitProgram: f32 array literal but f32 list type not collected",
        )
      }
      let dstF32 = -1
      let coffF32 = 0
      if elems.length > NEW_FIXED_MAX {
        dstF32 = arrLitChunkStart("f32", 0, fa32TypeIdx, elems.length, false)
      }
      let i32f = 0
      while i32f < elems.length {
        if exprArray(elems[i32f], fnIx) || exprRefArray(elems[i32f], fnIx) {
          return emitFail("emitProgram: nested arrays are not supported")
        }
        // Each element lowered as f32 (a float literal re-encoded; an i32 operand converted
        // via `f32.convert_i32_s`) so the backing's element type matches.
        if emitExprAsF32(body, elems[i32f], fnIx) < 0 { return -1 }
        i32f = i32f + 1
        if dstF32 >= 0 {
          coffF32 = arrLitChunkFlush(
            dstF32,
            fa32TypeIdx,
            coffF32,
            i32f,
            elems.length,
          )
        }
      }
      if dstF32 >= 0 {
        fbLocalGet(dstF32)
        wU8(212) // 0xd4 ref.as_non_null — the chunk-built f32 backing
      } else {
        fbArrayNewFixed(fa32TypeIdx, elems.length) // builds the f32 backing
      }
      fbI32Const(elems.length) // len
      fbI32Const(elems.length) // cap
      fbStructNew(fl32TypeIdx) // the f32-list wrapper
      return 0
    }
    if isF64Lit {
      if !fa64Used {
        return emitFail(
          "emitProgram: f64 array literal but f64 list type not collected",
        )
      }
      let dstF64 = -1
      let coffF64 = 0
      if elems.length > NEW_FIXED_MAX {
        dstF64 = arrLitChunkStart("f64", 0, fa64TypeIdx, elems.length, false)
      }
      let i = 0
      while i < elems.length {
        if exprArray(elems[i], fnIx) || exprRefArray(elems[i], fnIx) {
          return emitFail("emitProgram: nested arrays are not supported")
        }
        // Each element is lowered as an f64 (a float literal → `f64.const`; an i32
        // operand widened via `f64.convert_i32_s`) so the backing's element type matches.
        if emitExprAsF64(body, elems[i], fnIx) < 0 { return -1 }
        i = i + 1
        if dstF64 >= 0 {
          coffF64 = arrLitChunkFlush(
            dstF64,
            fa64TypeIdx,
            coffF64,
            i,
            elems.length,
          )
        }
      }
      if dstF64 >= 0 {
        fbLocalGet(dstF64)
        wU8(212) // 0xd4 ref.as_non_null — the chunk-built f64 backing
      } else {
        fbArrayNewFixed(fa64TypeIdx, elems.length) // 0xfb 0x08; builds the f64 backing
      }
      fbI32Const(elems.length) // 0x41 i32.const (len)
      fbI32Const(elems.length) // 0x41 i32.const (cap)
      fbStructNew(fl64TypeIdx) // 0xfb 0x00 <f64-list wrapper struct type index>
      return 0
    }
    if isI64Lit {
      if !ia64Used {
        return emitFail(
          "emitProgram: i64 array literal but i64 list type not collected",
        )
      }
      let dstI64 = -1
      let coffI64 = 0
      if elems.length > NEW_FIXED_MAX {
        dstI64 = arrLitChunkStart("i64", 0, ia64TypeIdx, elems.length, false)
      }
      let i = 0
      while i < elems.length {
        if exprArray(elems[i], fnIx) || exprRefArray(elems[i], fnIx) {
          return emitFail("emitProgram: nested arrays are not supported")
        }
        // Each element lowered as i64 (an i64 literal directly; an i32 operand sign-
        // extended via `i64.extend_i32_s`) so the backing's element type matches.
        if emitExprAsI64(body, elems[i], fnIx) < 0 { return -1 }
        i = i + 1
        if dstI64 >= 0 {
          coffI64 = arrLitChunkFlush(
            dstI64,
            ia64TypeIdx,
            coffI64,
            i,
            elems.length,
          )
        }
      }
      if dstI64 >= 0 {
        fbLocalGet(dstI64)
        wU8(212) // 0xd4 ref.as_non_null — the chunk-built i64 backing
      } else {
        fbArrayNewFixed(ia64TypeIdx, elems.length) // builds the i64 backing
      }
      fbI32Const(elems.length) // len
      fbI32Const(elems.length) // cap
      fbStructNew(il64TypeIdx) // the i64-list wrapper
      return 0
    }
    if isStrLit {
      if !slUsed {
        return emitFail(
          "emitProgram: string array literal but string list type not collected",
        )
      }
      let dstStr = -1
      let coffStr = 0
      if elems.length > NEW_FIXED_MAX {
        dstStr = arrLitChunkStart("str", 0, mkArrIdx, elems.length, false)
      }
      // A `(string | null)[]` literal shares the string backing, but a `null` element lowers as
      // `ref.null $sTypeIdx` (a real string element rides its `array.new_fixed` string untouched) —
      // seed `pendingNulString` for the element emits (the string niche analogue of `pendingNulBool`).
      const savedArrNS = pendingNulString
      if nodeArrayElemIsNulStr(arrIx) { pendingNulString = true }
      let i = 0
      while i < elems.length {
        // A literal-union atom element widens to its member string. The backing is
        // `(ref null $aTypeIdx)` and the atom's rep is an i32 id, so without this the element
        // store is `expected (ref null $type), found i32` — check-clean invalid wasm.

        // Reached whenever the literal already builds a string list, and what decides that is the
        // recorded context type, not the element order: `arrLitIsStr` answers true outright for a
        // `(string | null)[]` and for a `string[]` literal however their elements are ordered, and
        // falls through to the first element's type only when no context rule fires.
        if emitStrValue(body, elems[i], fnIx) < 0 { return -1 }
        i = i + 1
        if dstStr >= 0 {
          coffStr = arrLitChunkFlush(dstStr, mkArrIdx, coffStr, i, elems.length)
        }
      }
      pendingNulString = savedArrNS
      if dstStr >= 0 {
        fbLocalGet(dstStr)
        wU8(212) // 0xd4 ref.as_non_null — the chunk-built string-ref backing
      } else {
        fbArrayNewFixed(mkArrIdx, elems.length) // 0xfb 0x08; builds the string-ref backing
      }
      fbI32Const(elems.length) // 0x41 i32.const (len)
      fbI32Const(elems.length) // 0x41 i32.const (cap)
      fbStructNew(mkListIdx)   // 0xfb 0x00 <string-list wrapper struct type index>
      return 0
    }
    if isRefLit {
      if !rlUsed {
        return emitFail(
          "emitProgram: ref array literal but ref list type not collected",
        )
      }
      // The element type decides which (backing, wrapper) pair this literal builds. A binding or
      // field site that threaded a ref-list annotation (`pendingListKind` 1 or 2, and
      // `pendingListSlot` the element slot) is authoritative: its declared element type wins over
      // the first-element field-shape guess. An un-annotated literal types itself from element 0.
      const annKind = pendingListKind
      const annSlot = pendingListSlot
      let rslot = 0
      if annKind == 1 || annKind == 2 || annKind == 5 { rslot = annSlot }
      else if elems.length >= 1 { rslot = rlSlotByName(arrLitElemName(arrIx)) }
      else { rslot = annSlot }
      if rslot < 0 {
        if rlElemName.length < 1 {
          return emitFail(
            "emitProgram: ref array literal with no interned element type",
          )
        }
        rslot = 0
      }
      // A STRUCT-element list (kind 1, NOT a union box) types each element literal as the
      // list's declared element struct — seed `pendingStructIdx` (consumed by `emitObj`)
      // so a same-field-name sibling struct does not win the field-shape match. A union
      // list (kind 2) boxes by variant name and needs no struct hint.
      let elemStructIdx = -1
      let elemVariantIdx = -1
      if rlElemKindTbl[rslot] == 1 {
        // A nullable-struct element list (`(P | null)[]`, slot key "P | null"): the `| null` peels
        // to the bare struct so an object element builds `P` and a `null` element gets
        // `ref.null $P` from the seeded `pendingStructIdx`. The struct row comes off the arena;
        // the peeled name is still what the concrete-variant fall-back looks up.
        let rlen = rlElemName[rslot]
        const rnn = nullablePartOf(rlen)
        if rnn != "" { rlen = rnn }
        elemStructIdx = rlElemLitStructRow(rslot)
        // A concrete-VARIANT element list (`Cat[]`): no `sNames` entry, so seed the VARIANT
        // index instead so each element literal builds the bare variant struct (kind 8).
        if elemStructIdx < 0 { elemVariantIdx = variantIndexOf(rlen) }
      }
      // A UNION-element list (kind 2) coerces each element into the box at the
      // write boundary (`emitUnionCoerce` — the host's per-element `coerceUnion`):
      // a bare scalar/string boxes under its atom's tag; an object literal /
      // already-union value passes through to its existing boxing.
      let elemUnionNm = ""
      if rlElemKindTbl[rslot] == 2 { elemUnionNm = rlElemName[rslot] }
      // A nested LIST element kind (`i32[][]` 4 / `string[][]` 6 / `f64[][]` 7 / `i64[][]` 8):
      // the elements ARE arrays. Kind 4 builds the default i32-list; 6/7/8 seed the inner list
      // kind (`pendingListKind` 3 string / 4 f64 / 6 i64) so a bare `["a"]` / `[1.0]` / `[1,2]`
      // element builds the right list, not the default i32-list.
      const elemNest = rlElemKindTbl[rslot]
      let dstRef = -1
      let coffRef = 0
      if elems.length > NEW_FIXED_MAX {
        dstRef = arrLitChunkStart(
          "ref",
          rslot,
          rlBackIdx[rslot],
          elems.length,
          false,
        )
      }
      let i = 0
      // A kind-9 element is itself a REF list (`Cell[]` of `Cell[][]`, any ref leaf, any depth):
      // its inner ref-list slot, seeded so each element builds as that inner list (recursively).
      let nestInnerSlot = -1
      if elemNest == 9 { nestInnerSlot = rlElemInnerSlot(rslot) }
      while i < elems.length {
        // A non-nested-list element list must not hold array elements. Kinds 4/6/7/8 (scalar
        // inner lists) and 9 (ref inner list) legitimately do — and so does a union-box element
        // whose union has a list arm (`(i32[] | f64)[]` with a `[1, 2]` element): the array boxes
        // through `emitUnionBoxArg` and `emitUnionCoerce`, whose own rejects bite.
        if (
          elemNest != 4 &&
          elemNest != 6 &&
          elemNest != 7 &&
          elemNest != 8 &&
          elemNest != 9 &&
          elemNest != 10 &&
          elemNest != 11 &&
          elemUnionNm == ""
        ) {
          if exprArray(elems[i], fnIx) || exprRefArray(elems[i], fnIx) {
            return emitFail("emitProgram: nested arrays are not supported")
          }
        }
        pendingStructIdx = elemStructIdx
        pendingVariantIdx = elemVariantIdx
        if elemUnionNm != "" {
          // Box the element into the shared union box — a concrete variant element widens via
          // `emitUnionBoxArg`, like a call argument or return. The outer literal's list threading
          // is cleared around the box: a list-arm element re-enters `emitArr` inside the coerce,
          // and the stale outer kind would force it back onto this slot's ref build.
          const savedElemK = pendingListKind
          const savedElemS = pendingListSlot
          pendingListKind = 0
          pendingListSlot = 0
          const ubRc = emitUnionBoxArg(body, elemUnionNm, elems[i], fnIx)
          pendingListKind = savedElemK
          pendingListSlot = savedElemS
          if ubRc < 0 { return -1 }
        } else {
          // Reset the `listKind`/`listSlot` context to the INNER list's kind so the element
          // builds the right list, NOT the outer ref-list kind it would inherit. Scalar inner
          // lists seed kind 0/3/4/6; a ref inner list (kind 9) seeds kind 5 + the inner slot, so
          // the element builds as that ref list — which may itself be kind 9 (nesting falls out).
          const elCtx = expCtxHere()
          if elemNest == 4 {
            elCtx.listKind = 0
          } else if elemNest == 6 {
            elCtx.listKind = 3
          } else if elemNest == 7 {
            elCtx.listKind = 4
          } else if elemNest == 8 {
            elCtx.listKind = 6
          } else if elemNest == 10 {
            elCtx.listKind = 7 // f32-inner list -> build each element as an f32[] (kind 7)
          } else if elemNest == 11 {
            elCtx.listKind = 10 // u8-inner list -> build each element as a packed u8[]
          } else if elemNest == 9 {
            elCtx.listKind = 5
            elCtx.listSlot = nestInnerSlot
          }
          // A map element (kind 3): a `Map()` element builds this element's map struct — the
          // literal twin of the `.push` and indexed-assign seed in `refElemValueCtx`, and the
          // site the whole list-of-maps family runs through. Unseeded, the element `Map()` builds
          // the mono map struct into a backing typed to the element's own struct.
          if elemNest == 3 { elCtx.mapSlot = rlElemMapShape(rslot) }
          // A nullable-niche element may be a bare `null`: kind 4 gives `ref.null $lTypeIdx`,
          // kind 9 the inner wrapper, and the distinct-backing kinds 6/7/8/10 the leaf-list
          // wrapper singleton. These are whole-value null seeds, so the seed-leak gate applies
          // one level down: a nested list element's own nulls would consume the leaked heap.
          const elIsBareNull = P.nodes[unwrapParen(elems[i])] is NullLit
          if elIsBareNull {
            if elemNest == 4 && rlElemNullable[rslot] == 1 {
              elCtx.nulList = true
            }
            if (
              elemNest == 9 &&
              rlElemNullable[rslot] == 1 &&
              nestInnerSlot >= 0
            ) {
              elCtx.nulRefHeap = rlWrapIdx[nestInnerSlot]
            }
            if rlElemNullable[rslot] == 1 {
              if elemNest == 6 { elCtx.nulRefHeap = mkListIdx }
              if elemNest == 7 { elCtx.nulRefHeap = fl64TypeIdx }
              if elemNest == 8 { elCtx.nulRefHeap = il64TypeIdx }
              if elemNest == 10 { elCtx.nulRefHeap = fl32TypeIdx }
              if elemNest == 11 { elCtx.nulRefHeap = bl8TypeIdx }
              // A `({[string]: V} | null)[]` element (kind 3 nullable niche) → `ref.null` of
              // the element's map struct (the slot heap, resolved by the kind-3 passes).
              if elemNest == 3 { elCtx.nulRefHeap = rlElemHeap[rslot] }
              // A `((...) => ...) | null` element (kind 5 nullable niche) → `ref.null` of the
              // shared closure fat-pointer (the slot heap, `cloStructIdx`).
              if elemNest == 5 { elCtx.nulRefHeap = rlElemHeap[rslot] }
            }
          }
          const elArmOwed = narrowedArmNeedsUnbox(elems[i], fnIx)
          if emitExprExpect(body, elems[i], fnIx, elCtx) < 0 { return -1 }
          // The narrowed-arm unbox at a ref-list element (D1031) — `[s]` of a `Circle[]` under
          // `if s is Circle`. The slot's own element heap is the destination, the same one
          // `rlBackIdx` types the backing array with.
          if elArmOwed { emitNarrowedArmUnboxTo(rlElemArmHeapOf(rslot)) }
          // Read-only covariance at a nested-list element (D791) — `[lv1]` of a `Shape[][]`,
          // where the element's own row is the inner ref list.
          if elemNest == 9 && nestInnerSlot >= 0 {
            emitRefListWidenSite(
              body,
              elems[i],
              exprEmittedRefListSlot(elems[i], fnIx),
              nestInnerSlot,
            )
          }
          // The scalar dual (D965) — `[e]` of an `f64[][]` over an `i32[]` element. The element's
          // own nest code is the destination kind: 4 `i32[]`, 7 `f64[]`, 8 `i64[]`, 10 `f32[]` —
          // the same ladder the `elCtx.listKind` seeding above reads, one column over.
          if elemNest == 4 || elemNest == 7 || elemNest == 8 || elemNest == 10 {
            let nse: VKind = "i32"
            if elemNest == 7 { nse = "f64" }
            if elemNest == 8 { nse = "i64" }
            if elemNest == 10 { nse = "f32" }
            emitScalarListWidenSiteElem(body, elems[i], fnIx, nse)
          }
        }
        pendingVariantIdx = -1
        i = i + 1
        if dstRef >= 0 {
          coffRef = arrLitChunkFlush(
            dstRef,
            rlBackIdx[rslot],
            coffRef,
            i,
            elems.length,
          )
        }
      }
      pendingStructIdx = -1
      if dstRef >= 0 {
        fbLocalGet(dstRef)
        wU8(212) // 0xd4 ref.as_non_null — the chunk-built ref backing
      } else {
        fbArrayNewFixed(rlBackIdx[rslot], elems.length) // 0xfb 0x08; builds the ref backing
      }
      fbI32Const(elems.length)      // 0x41 i32.const (len)
      fbI32Const(elems.length)      // 0x41 i32.const (cap)
      fbStructNew(rlWrapIdx[rslot]) // 0xfb 0x00 <this slot's ref-list wrapper>
      return 0
    }
    if !lUsed {
      return emitFail("emitProgram: array literal but list type not collected")
    }
    // Three element types share the i32 backing but do not lower like i32s, so each seeds the
    // element emits: `K[]` lowers member literals as interned atom ids, `(boolean|null)[]` a
    // `null` as the sentinel 2, and `(K|null)[]` both. The element type comes from the checker's
    // recorded type; the `pendingListKind == 8` and `== 9` legs catch an all-`null` `[null]`.
    const litArr = nodeArrayElemIsLitUnion(arrIx)
    const savedArrLU = pendingLitUnion
    if litArr { pendingLitUnion = 1 }
    const nbArr = nodeArrayElemIsNulBool(arrIx) || pendingListKind == 8
    const savedArrNB = pendingNulBool
    if nbArr { pendingNulBool = true }
    const nlluArr = nodeArrayElemIsNulLitUnion(arrIx) || pendingListKind == 9
    const savedArrNLLU = pendingNulLitUnion
    if nlluArr {
      pendingNulLitUnion = true
      pendingLitUnion = 1
    }
    let dstI32 = -1
    let coffI32 = 0
    if elems.length > NEW_FIXED_MAX {
      dstI32 = arrLitChunkStart("i32", 0, aTypeIdx, elems.length, false)
    }
    let i = 0
    while i < elems.length {
      if !litArr {
        if exprArray(elems[i], fnIx) || exprRefArray(elems[i], fnIx) {
          return emitFail("emitProgram: nested arrays are not supported")
        }
        if exprStruct(elems[i], fnIx) {
          return emitFail(
            "emitProgram: struct array elements are not supported",
          )
        }
        // A declared union arm reaching the i32-list fallback — the same shape as the struct arm
        // above and the map arm below. The two namespaces are exclusive, a name in `uVariants`
        // having no `sNames` row, so `exprStruct` declines for an arm by construction and the
        // element would reach `array.new_fixed $aTypeIdx` with a `(ref $uVarHeap)` operand.

        // A ref list of arms has a sound rep and the annotated spellings reach it; what has no
        // rep is an arm element on the i32 backing, which the inferred spelling reaches. Two
        // channels, as at the map arm below: the emit-side classifier, and the checker's recorded
        // node type for an inline literal.
        if exprVariantIndex(elems[i], fnIx) >= 0 || nodeTyIsVariant(elems[i]) {
          return emitFail(
            "emitProgram: union-arm array elements are not supported in this position",
          )
        }
        // A map-typed element reaching the i32-list fallback, with no ref-list or map-array kind
        // threaded: the map struct ref would be stored as an i32 element. A map array can only
        // build through the ref-list path with a threaded map-element kind, so with none here
        // there is no sound rep — fail loudly.
        if exprMap(elems[i], fnIx) || nodeTyIsMap(elems[i]) {
          return emitFail(
            "emitProgram: map array elements are not supported in this position",
          )
        }
      }
      if emitExpr(body, elems[i], fnIx) < 0 { return -1 }
      i = i + 1
      if dstI32 >= 0 {
        coffI32 = arrLitChunkFlush(dstI32, aTypeIdx, coffI32, i, elems.length)
      }
    }
    pendingLitUnion = savedArrLU
    pendingNulBool = savedArrNB
    pendingNulLitUnion = savedArrNLLU
    if dstI32 >= 0 {
      fbLocalGet(dstI32)
      wU8(212) // 0xd4 ref.as_non_null — the chunk-built raw backing
    } else {
      fbArrayNewFixed(aTypeIdx, elems.length) // 0xfb 0x08; builds the raw backing
    }
    // Wrap { backing, len = count, cap = count } via struct.new.
    fbI32Const(elems.length) // 0x41 i32.const (len)
    fbI32Const(elems.length) // 0x41 i32.const (cap)
    fbStructNew(lTypeIdx)    // 0xfb 0x00 <list wrapper struct type index>
    return 0
  }
  emitFail("emitProgram: expected an array literal")
}

// ── G8: string-keyed maps — the open-addressing hash map ─────────────────────

// A map is the struct the map-table section describes in full. Operations hash the key (FNV-1a)
// into `index` and linear-probe to a free-or-matching slot, never an O(n) scan. A function that
// touches a map reserves a 15-slot scratch frame at `mapScratchBase`.

// The frame: +0 mapRef, +1 keyRef, +2 curRef, +3 slot, +4 cap, +5 entry, +6 keysBk, +7 valsBk,
// +8 chr, +9 hcur, +10 idxBk, +11 rslot, +12 liveBk, +13 hashBk, +14 valSet. `hcur` is the op's
// key hash, live from `emitMapProbe` through an appending set's `hashes[]` store.

// The i32-keyed rep re-types four of those slots and appends its own frame (`mapI32Base`, minted
// only when the module has one, so no offset above moves): +0 the i32 key, +1 keys backing, +2
// and +3 the key-list builder's backings, +4 mapRef. `cmKeyI32` picks, through the `cm*` helpers.

// The current op's map struct heap type / vals wrapper / vals backing.
function cmMapTy() { mapTypeIdxOf(cmSlot) }
function cmValsWrap() { mvValsWrapOf(cmSlot) }
function cmValsBack() { mvValsBackOf(cmSlot) }

// True when the current op runs on the i32-keyed rep. Two sources, because a map shape carries
// the key in two places depending on the value: the mono-value sentinels -4 (map) and -5 (Set),
// where a value on the shared i32 `vals` list interns no slot so the key has nowhere else to
// live; and an mv slot's own `mvKeyI32` column, the slot's identity being the (key, value) pair.

// Asked by every accessor below that picks between the two keys lists, the two probe helpers and
// the two key scratch slots. Everything else is key-blind by construction: it reads the value
// side, which the slot answers on its own.
function cmKeyI32() { mapShapeKeyI32(cmSlot) }
// The current op's keys-list wrapper and backing heap types: the string-ref pair for the
// string-keyed rep, the i32 list pair for the i32-keyed one.
function cmKeysWrap() {
  if cmKeyI32() { return lTypeIdx }
  mkListIdx
}
function cmKeysBack() {
  if cmKeyI32() { return aTypeIdx }
  mkArrIdx
}
// The current op's target-key scratch local: the string frame's slot 1, a `(ref $sTypeIdx)`
// string, or the i32 frame's slot 0, a raw i32.
function cmKeyLocal() {
  if cmKeyI32() { return mapI32Base }
  mapScratchBase + 1
}
// The current op's grown or compacted keys-backing scratch local: the string frame's slot 6, or
// the i32 frame's slot 1.
function cmKeysBkLocal() {
  if cmKeyI32() { return mapI32Base + 1 }
  mapScratchBase + 6
}
// The current op's mapRef local. An mv slot always uses its own typed frame slot, asked first
// because that frame is already typed to the slot's map struct whichever key rep it carries. Only
// the two mono shapes have to choose between the shared `(ref $mStructIdx)` scratch slot 0 and
// the i32-keyed frame's own, the mono local being typed to the string-keyed struct.
function cmMapRefLocal() {
  if cmSlot >= 0 { return fnMvMapRefLocal(cmSlot) }
  if cmKeyI32() { return mapI32Base + 4 }
  mapScratchBase
}
// The current op's vals-backing scratch local (grow/compact temporary).
function cmValsBkLocal() {
  if cmSlot < 0 { return mapScratchBase + 7 }
  fnMvValsBkLocal(cmSlot)
}

// Evaluate the map receiver `recvIx` once and leave its `(ref $mapStruct)` on the operand stack,
// ready for the mapRef store. One home for evaluating a map receiver: the probe path
// (`emitMapRecvKey`) and the tombstone-aware `for`-in walk both come through here, because the
// two properties this owns are the two a second hand-written copy loses.

// The receiver is emitted exactly once, so its side effects run once and every later read sees
// the same object — a re-emitted receiver is a fresh evaluation, and a factory returning a new
// map per call leaves the two reads on different maps. And a nullable receiver (kind `nulmap`) is
// recovered before the mapRef store; omitting that is check-clean invalid wasm, never a message.
function pushMapRecvRef(body: i32[], recvIx: i32, fnIx: i32) {
  if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
  if exprNullableMap(recvIx, fnIx) {
    wU8(212) // 0xd4 ref.as_non_null
  }
  0
}

// `local.get` / `local.set` of the current op's mapRef.
function pushMapRef(_body: i32[]) {
  fbLocalGet(cmMapRefLocal()) // 0x20 local.get
  0
}
function setMapRef(_body: i32[]) {
  fbLocalSet(cmMapRefLocal()) // 0x21 local.set
  0
}

// `local.get` of map scratch slot `n` (the shared mono frame — every slot except
// the mapRef/valsBk/valStash trio is map-shape-agnostic and stays shared).
function pushMapScr(_body: i32[], n: i32) {
  fbLocalGet(mapScratchBase + n) // 0x20 local.get
  0
}

// `local.set` of map scratch slot `n`.
function setMapScr(_body: i32[], n: i32) {
  fbLocalSet(mapScratchBase + n) // 0x21 local.set
  0
}

// `M.keys` (the keys list wrapper ref): `local.get mapRef ; struct.get <mapTy> 0`.
function pushMapKeys(body: i32[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 0) // field 0: keys
  0
}

// `M.vals` (the vals list wrapper ref): `local.get mapRef ; struct.get <mapTy> 1`.
function pushMapVals(body: i32[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 1) // field 1: vals
  0
}

// `M.live` (the i32 tombstone array, parallel to entries; all 1s in this slice):
// `local.get mapRef ; struct.get <mapTy> 2`.
function pushMapLive(body: i32[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 2) // field 2: live
  0
}

// `M.index` (the i32 hash-slot array): `local.get mapRef ; struct.get <mapTy> 3`.
function pushMapIndex(body: i32[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 3) // field 3: index
  0
}

// `M.count` (entries appended): `local.get mapRef ; struct.get <mapTy> 4`.
function pushMapCount(body: i32[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 4) // field 4: count
  0
}

// `M.size` (live entry count): `local.get mapRef ; struct.get <mapTy> 5`.
function pushMapSize(body: i32[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 5) // field 5: size
  0
}

// `M.hashes` (the i32 per-entry FNV cache, parallel to the entries):
// `local.get mapRef ; struct.get <mapTy> 6`.
function pushMapHashes(body: i32[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 6) // field 6: hashes
  0
}

// The hash of the current op's target key, leaving a non-negative i32 on the stack: the FNV-1a of
// the string in the key scratch slot (a call into the shared `__str_hash__` helper), or the
// integer mix of the i32 key (`fbI32HashMix`, the same generator the i32-keyed probe helper's
// body uses). Both leave the same masked range, which is what lets the two reps share `hashes`.
function emitMapHashOf(_body: i32[]) {
  if cmKeyI32() {
    // Scratch slot +9 (`hcur`) is the mix's own accumulator — dead across it.
    fbI32HashMix(cmKeyLocal(), mapScratchBase + 9)
    return 0
  }
  fbLocalGet(cmKeyLocal())
  fbCall(gHelpStrHash)
  0
}

// The hash of the current op's key at a site that runs after `emitMapProbe` — the `hashes[]`
// store on an appending `m[k] = v`. A string key's hash is the one handed to the probe, still in
// slot +9, so the key is walked once per insert instead of twice; an i32 key's is re-mixed,
// because `__map_probe_i32__` computes its own internally.
function pushMapProbedHash(body: i32[]) {
  if cmKeyI32() { return emitMapHashOf(body) }
  pushMapScr(body, 9)
}

// Probe: with `mapRef` (slot 0) and the target `keyRef` (slot 1) set, hash the key into `M.index`
// and linear-probe, wrapping, to the slot holding either the matching key's entry or a free (0)
// slot. Leaves `slot` (3) = that probe slot and `entry` (5) = `index[slot]`, 0 for a miss. Shared
// by get, has, set and delete; the index load factor stays under 1/2, so a free slot is reached.

// Tombstone-aware: a tombstoned entry (`live[entry-1] == 0`) is not a hit but a probe marker,
// kept so delete does not break the chain, and the stored per-entry hash gates the key compare.
// The string key is hashed here, as `__map_probe__`'s first operand, on an empty operand stack so
// no backing `struct.get` stays live across `__str_hash__`; `keepHash` parks it in scratch +9.
function emitMapProbe(body: i32[], keepHash: boolean) {
  if !cmKeyI32() {
    emitMapHashOf(body)
    if keepHash { fbLocalTee(mapScratchBase + 9) }
  }
  // Push the probe's shape-agnostic components (the map struct type differs per
  // value shape, but `index`/`hashes`/`live`/`keys` are identically typed across
  // shapes — only these `struct.get`s stay at the call site) and call the shared
  // `__map_probe__` helper (`emitMapProbeFnCode`), which returns the probe SLOT.
  pushMapIndex(body)
  pushMapHashes(body)
  pushMapLive(body)
  pushMapKeysBacking(body)
  fbLocalGet(cmKeyLocal()) // the target key (a string ref, or a raw i32)
  if cmKeyI32() { fbCall(gHelpMapProbeI32) } else { fbCall(gHelpMapProbe) }
  setMapScr(body, 3) // slot
  // entry = index[slot]  (0 = miss; else entry-position + 1)
  pushMapIndex(body)
  pushMapScr(body, 3)
  fbArrayGet(aTypeIdx) // array.get
  setMapScr(body, 5)   // entry
  0
}

// The one home of the `-3` map-value reject. Four op sites each spelled out this verdict, two of
// them enumerating a supported side that went stale. So the message names the remainder instead,
// which is small and stays small: `mvValKindOfName` lowers every scalar, litunion atom, struct,
// list at any nesting, nested map, union and closure, plus each one's nullable niche.

// What is left: a struct that is a member of a declared union, living in the variant table where
// the mv slot has no variant half; a nullable closure with a literal-union result; a nullable list
// whose element rep the layer does not name; and a value name resolving to none of these. The
// tail clause is a second producer, for a lowerable value whose mv slot nothing interned.
function failMapValueType() {
  emitFail(
    "emitProgram: unsupported map value type (no rep for a union-member struct, a nullable list over an unnamed element rep, or a nullable litunion-result closure; any other value type here interned no mv slot)",
  )
}

// Construct an EMPTY map `Map()` onto `body`: two empty lists (each `array.new_fixed`
// count 0, wrapped `{ backing, len=0, cap=0 }`), boxed into the map struct.
function emitMapNew(_body: i32[]) {
  if !mUsed { return emitFail("emitProgram: Map() but map type not collected") }
  // The binding-seeded map SHAPE (consumed here): -1/-2 build the mono map; an mv
  // slot >= 0 builds THIS value type's map struct over its ref vals list.
  let slot = pendingMapSlot
  pendingMapSlot = -1
  if slot == -3 { return failMapValueType() }
  if slot == -2 { slot = -1 }
  if slot == -5 { slot = -4 }
  // The keys/vals accessors below read the op context, so pin it to the shape being
  // constructed (a `Map()` is not reached through `emitMapRecvKey`).
  const savedCm = cmSlot
  cmSlot = slot
  // keys list: an empty backing → wrapper, in the KEY's own list rep (string-ref for
  // `{[string]: V}`, the i32 list for `{[i32]: V}`).
  fbArrayNewFixed(cmKeysBack(), 0) // 0 elements
  fbI32Const(0)                    // len = 0
  fbI32Const(0)                    // cap = 0
  fbStructNew(cmKeysWrap())
  cmSlot = savedCm
  // vals list: empty backing → wrapper (the i32 list, or the slot's ref list).
  fbArrayNewFixed(mvValsBackOf(slot), 0)
  fbI32Const(0)
  fbI32Const(0)
  fbStructNew(mvValsWrapOf(slot))
  // live: empty i32 array (cap 0), parallel to the empty keys/vals entry lists. It
  // grows in lockstep with the keys backing on append (a fresh entry is live = 1).
  fbArrayNewFixed(aTypeIdx, 0)
  // index: an i32 hash-slot array of `INITIAL_CAP * 2` (16) zero-filled slots, 0 meaning empty.
  // The load factor is kept under 1/2 (resize at `size*2 >= cap`), and starting at twice
  // `INITIAL_CAP` means a tombstone-churn workload reaches the amortized-compaction threshold
  // before the index fills with dead probe markers and the next probe spins forever.
  fbI32Const(16) // i32.const 16 (INITIAL_CAP * 2)
  fbArrayNewDefault(aTypeIdx)
  // count = 0, size = 0.
  fbI32Const(0)
  fbI32Const(0)
  // hashes: empty i32 array (cap 0), parallel to the entries; grows in lockstep with
  // the keys backing on append (the stored FNV hash of each key). Mirrors the host's
  // 7th `struct.new` operand (`mapNewFn`); native sizes it like `live` (cap 0, grown
  // on demand) rather than INITIAL_CAP so the entry-parallel arrays stay length-locked.
  fbArrayNewFixed(aTypeIdx, 0)
  // map struct { keys, vals, live, index, count, size, hashes } — the mono struct,
  // or the mv slot's (identical shape, vals field referencing the slot's wrapper).
  fbStructNew(mapTypeIdxOf(slot))
  0
}

// Resolve the receiver's map shape and emit the receiver and key expressions, leaving both values
// on the operand stack ([mapRef, keyRef], keyRef on top) with `cmSlot` pinned to the shape. The
// caller pops key (slot 1) then mapRef.

// They stay off the scratch locals on purpose: an inner map op nested in the key expression — or,
// for a set, in the value expression evaluated between the key and the stores — runs its own probe
// through the same shared scratch frame, and a value parked in `mapRef` or `keyRef` would be
// silently clobbered. Values on the wasm operand stack are immune; nested ops touch only locals.
function emitMapRecvKey(body: i32[], recvIx: i32, keyIx: i32, fnIx: i32) {
  if !mUsed {
    return emitFail("emitProgram: map op but map type not collected")
  }
  if !exprMap(recvIx, fnIx) {
    return emitFail("emitProgram: map op receiver is not a map")
  }
  // Resolve the receiver's map SHAPE into the op context. A Set (-2 / -5) runs on the
  // mono machinery of its own KEY rep; an unsupported value type (-3) fails loudly.
  const mshape0 = mapShapeOfExpr(recvIx, fnIx)
  if mshape0 == -3 { return failMapValueType() }
  const mshape = mapShapeFoldSet(mshape0)
  // The KEY expression must match the receiver's key rep. The checker proves the pair
  // agrees, so a mismatch here means the receiver's shape resolved wrong — reject
  // loudly rather than emit a string ref into an i32 keys array (invalid wasm).
  if mapShapeKeyI32(mshape) {
    if exprString(keyIx, fnIx) {
      return emitFail("emitProgram: i32-keyed map indexed with a string key")
    }
  } else if !exprString(keyIx, fnIx) {
    return emitFail("emitProgram: map key is not a string")
  }
  // The receiver expr is emitted OUTSIDE the context (it is map-op-free by
  // construction — an Ident/global/constructor).
  if pushMapRecvRef(body, recvIx, fnIx) < 0 { return -1 }
  // A string-keyed map's key is a string ref — shield it from an ambient atom context, since an
  // atom-typed binding init seeds `pendingLitUnion` around the whole init and would lower the key
  // literal as an i32 atom id. An i32 key wants no shielding but is unharmed by it. An inner map
  // op in the key expression also clobbers `cmSlot`, so pin it afterwards.
  const savedKeyLU = pendingLitUnion
  pendingLitUnion = 0
  const kr = emitExpr(body, keyIx, fnIx)
  pendingLitUnion = savedKeyLU
  if kr < 0 { return -1 }
  cmSlot = mshape
  0
}

// Load the map receiver and key into the scratch frame (slots 0 and 1) and run the probe, leaving
// `slot` (slot 3) = the probe slot and `entry` (slot 5) = `index[slot]`, 0 for a miss and else the
// entry position plus 1. `recvIx` and `keyIx` are arena indices; `recvIx` must be a map-typed
// expression and `keyIx` a string.
function emitMapPrep(body: i32[], recvIx: i32, keyIx: i32, fnIx: i32) {
  if emitMapRecvKey(body, recvIx, keyIx, fnIx) < 0 { return -1 }
  // Pop the stacked pair into the frame only now — user code is done running.
  fbLocalSet(cmKeyLocal()) // the target key
  setMapRef(body)          // mapRef (the shared mono slot, or this mv/i32 frame's)
  emitMapProbe(body, false)
}

// Emit the `??` DEFAULT `d` for a REF-valued map slot (`cmSlot >= 0`) onto `body`, in the
// value's own rep (scalar / union box / struct-list / list-wrapper / struct / nullable
// niche). Factored out of `emitMapGetOr` so the value-null coalesce can emit it exactly
// once whether the read missed the key OR read a stored null.
function emitMapValDefault(
  body: i32[],
  mslot: i32,
  scalarVK: VKind | null,
  defIx: i32,
  fnIx: i32,
) {
  if scalarVK != null {
    return emitScalarValue(body, defIx, fnIx, scalarVK)
  } else if mslot >= 0 && mvValKind[mslot] == 2 {
    // A UNION-valued map's default is coerced into the shared box, like a stored value — a
    // concrete VARIANT default boxes (`emitUnionBoxArg`), as in a call arg / return.
    return emitUnionBoxArg(body, mvValName[mslot], defIx, fnIx)
  } else if mslot >= 0 && mvListValKind(mslot) == "reflist" {
    // A struct-list value hints an empty `[]` default to an empty ref list of the inner
    // struct (`listKind` 1 struct-element, `listSlot` the inner slot).
    const slCtx = expCtxHere()
    slCtx.listKind = 1
    slCtx.listSlot = mvValInnerRlSlot(mslot)
    return emitExprExpect(body, defIx, fnIx, slCtx)
  }
  // For a non-i32 LIST-valued map, hint an empty `[]` default to the value's list
  // wrapper (`listKind` 3 string / 4 f64 / 6 i64) — an unhinted `[]` defaults to
  // the i32-list wrapper, which the `(ref null <wrapper>)` valStash would reject.
  const dfCtx = expCtxHere()
  const lvk = mvListValKind(mslot)
  if lvk == "strlist" {
    dfCtx.listKind = 3
  } else if lvk == "f64list" {
    dfCtx.listKind = 4
  } else if lvk == "i64list" {
    dfCtx.listKind = 6
  } else if lvk == "f32list" {
    dfCtx.listKind = 7
  } else if mslot >= 0 && mvValKind[mslot] == 1 {
    // A struct-valued map's `?? {f: …}` default forces the map's declared value-struct
    // index, from the slot's canonical layout rather than this slot's own — two
    // spellings of one map value can intern two mv rows over one vals element heap
    // (D123). `emitMapSetV`'s store path takes the same either/or.
    const dfVi = mvValVariantOf(mslot)
    if dfVi >= 0 {
      dfCtx.variantIdx = dfVi
    } else {
      dfCtx.structIdx = mvValStructIdxOf(mslot)
    }
  }
  // A nested-map value (`{[K]: {[K2]: V}}`) seeds `dfCtx.mapSlot` via `mvInnerMapShape`,
  // matching `emitMapSetV`'s store boundary — store and default write into the same vals
  // cell, so an unseeded `Map()` default would build the ambient mono map struct into a
  // slot typed for the inner map: invalid wasm.
  if mvValIsMap(mslot) { dfCtx.mapSlot = mvInnerMapShape(mslot) }
  // A NULLABLE-value slot admits a bare `null` default (`m[k] ?? null` typing `S | null`) —
  // seed the element heap so the NullLit lowers as `ref.null <elem>`.
  if mvSlotNullable(mslot) { dfCtx.nulRefHeap = mvValElemHeapOf(mslot) }
  emitExprExpect(body, defIx, fnIx, dfCtx)
}

// True when a `??` DEFAULT is itself nullable — a bare `null` literal or a nullable-typed
// expression. `m[k] ?? null` (over a nullable-value map) stays `V | null`, so the ref recover
// must be skipped; a non-null default makes the whole `??` non-null.
function defExprNullable(ix: i32) {
  const u = P.nodes[unwrapParen(ix)]
  if u is NullLit { return true }
  nodeTyIsNullable(ix)
}

// Lower a map get `m[k]` with a default (`m[k] ?? d`) onto `body`: probe, then if the
// key is found push `vals[entry-1]`, else push the default `d`. The self-host checker
// always reads a map through `?? -1` (a total fallback), so this is the primary get.
function emitMapGetOr(
  body: i32[],
  recvIx: i32,
  keyIx: i32,
  defIx: i32,
  fnIx: i32,
) {
  if emitMapPrep(body, recvIx, keyIx, fnIx) < 0 { return -1 }
  if cmSlot >= 0 {
    // Ref values route through the slot's nullable valStash local rather than a
    // value-typed `if` (needs no interned blocktype): the hit arm sets it from the
    // `(ref null)` slot read, the miss arm from the default, and `ref.as_non_null`
    // recovers non-null — sound because a live entry's val slot is never null.
    const mslot = cmSlot
    // A boxed value-union map value that includes null (`{[string]: i32 | null}`,
    // `{[string]: A | B | null}`) stores null as a null-tagged box; `??` coalesces on
    // that tag and peels the value non-null, the value-union sibling of the ref-niche
    // `ref.is_null` path below. A null-free union value has no tag and takes the plain path.
    if mvValKind[mslot] == 2 {
      if mvValUnionHasNull(mslot) {
        return emitMapGetOrUnionBox(body, mslot, defIx, fnIx)
      }
    }
    // A SCALAR-valued map (f64/i64) stores the value directly; its default is emitted in
    // the value's rep and it needs no `ref.as_non_null`. A ref value (string/struct) does.
    const scalarVK = mvScalarValKind(mslot)
    // A nullable-value ref niche (value reps as `(ref null <elem>)`) stores null
    // directly in its vals slot: a missing key and a stored null both read as null, and
    // `??` coalesces on that read being null — so read the raw nullable value first and
    // let one `ref.is_null` supply the default for both.
    const nullableRef = scalarVK == null && mvSlotNullable(mslot)
    const stashL = fnMvValStashLocal(mslot)
    pushMapScr(body, 5)          // entry
    fbIf(64)                     // if (entry != 0 → found), void
    pushMapVals(body)
    fbStructGet(cmValsWrap(), 0) // vals backing
    pushMapScr(body, 5)          // entry
    fbI32Const(1)
    fbI32Bin(107)                // i32.sub (entry - 1)
    fbArrayGet(cmValsBack())     // scalar (f64/i64) / (ref null <elem>) slot read
    fbLocalSet(stashL)
    fbElse()                     // else — a MISS
    if nullableRef {
      // A miss IS the read's null; the `ref.is_null` coalesce below supplies the default.
      fbRefNull(mvValElemHeapOf(mslot))
      fbLocalSet(stashL)
    } else {
      if emitMapValDefault(body, mslot, scalarVK, defIx, fnIx) < 0 { return -1 }
      cmSlot = mslot
      fbLocalSet(stashL)
    }
    fbEnd() // end (if)
    if nullableRef {
      // Coalesce on the read value being null — a missing key or a stored null both take `d`.
      fbLocalGet(stashL)
      wU8(209) // 0xd1 ref.is_null
      fbIf(64)
      if emitMapValDefault(body, mslot, scalarVK, defIx, fnIx) < 0 { return -1 }
      cmSlot = mslot
      fbLocalSet(stashL)
      fbEnd()
    }
    fbLocalGet(stashL)
    // A scalar f64/i64 result needs no null-recovery; a ref value does (`??` is non-null).
    // For a nullable niche the coalesce already replaced every null with `d`, so recover to
    // non-null EXCEPT when the default itself is nullable (`m[k] ?? null` stays `S | null`).
    if scalarVK == null {
      if nullableRef {
        if !defExprNullable(defIx) { fbRefAsNonNull() }
      } else {
        fbRefAsNonNull()
      }
    }
    return 0
  }
  // A nullable-atom value map (`{[string]: K | null}` / `{[string]: boolean | null}`)
  // stores null as an i32 sentinel in the mono vals slot (`-1` litunion atom, `2`
  // boolean): a missing key and the stored sentinel both read as null, and `??`
  // coalesces on that — read the raw i32 and default when it equals the sentinel.
  let nulSentinel = 0
  let hasSentinel = false
  if nodeTyMapValIsNulLitUnion(recvIx) {
    nulSentinel = 0 - 1
    hasSentinel = true
  } else if nodeTyMapValIsNulBool(recvIx) {
    nulSentinel = 2
    hasSentinel = true
  }
  if !hasSentinel {
    // if entry != 0 { vals.backing[entry-1] } else { d }  — a value-typed if yielding i32.
    pushMapScr(body, 5)      // entry
    fbIf(127)                // if (entry != 0 → found; a nonzero condition is true), 0x7f i32 blocktype
    pushMapVals(body)
    fbStructGet(lTypeIdx, 0) // struct.get (vals backing), field 0: backing
    pushMapScr(body, 5)      // entry
    fbI32Const(1)
    fbI32Bin(107)            // 0x6b i32.sub  (entry - 1)
    fbArrayGet(aTypeIdx)     // array.get
    fbElse()                 // else
    if emitMonoMapDefault(body, recvIx, defIx, fnIx) < 0 { return -1 }
    fbEnd()                  // end (if)
    return 0
  }
  // raw = (entry != 0) ? backing[entry-1] : sentinel  — a miss reads as null.
  pushMapScr(body, 5)     // entry
  fbIf(127)               // if (entry != 0 → found), i32 blocktype
  pushMapVals(body)
  fbStructGet(lTypeIdx, 0)
  pushMapScr(body, 5)
  fbI32Const(1)
  fbI32Bin(107)
  fbArrayGet(aTypeIdx)
  fbElse()
  fbI32Const(nulSentinel) // miss = null sentinel
  fbEnd()
  // Coalesce: raw == sentinel ? d : raw. Slot +8 (probe hash cursor) is dead after the probe.
  setMapScr(body, 8)
  pushMapScr(body, 8)
  fbI32Const(nulSentinel)
  fbI32Bin(70) // 0x46 i32.eq → raw == sentinel (null, missing OR stored)
  fbIf(127)
  if emitMonoMapDefault(body, recvIx, defIx, fnIx) < 0 { return -1 }
  fbElse()
  pushMapScr(body, 8)
  fbEnd()
  0
}

// Lower `m[k] ?? d` over a boxed value-union map value that includes null (mv kind 2
// with a `null` atom): read the box (hit → stored, miss → the null-tagged box), then
// coalesce on the box's null tag — a `scalar | null` value peels to the raw unboxed
// scalar, a multi-member `… | null` value peels to the non-null union box.
function emitMapGetOrUnionBox(body: i32[], mslot: i32, defIx: i32, fnIx: i32) {
  const uvn = mvValName[mslot]
  // The map value union's members come from the recorded member columns; an
  // un-interned value spelling re-splits (the ladder fall-through). One resolution
  // of the member set feeds both this walk and the residual-kind code below, so the
  // two do not each re-derive it and risk disagreeing.
  const uvsid = msSetOfText(uvn)
  const atoms: string[] = []
  if !msMemberAtomsOfSet(uvsid, atoms) { splitUnionAtoms(uvn, atoms) }
  const stashL = fnMvValStashLocal(mslot)
  // raw box: hit → stored (ref null $uBox); miss → the null-tagged box.
  pushMapScr(body, 5)          // entry
  fbIf(64)                     // if (entry != 0 → found), void
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 0) // vals backing
  pushMapScr(body, 5)
  fbI32Const(1)
  fbI32Bin(107)                // i32.sub (entry - 1)
  fbArrayGet(cmValsBack())     // the stored (ref null $uBox) slot read
  fbLocalSet(stashL)
  fbElse()                     // miss = the read's null (a null-tagged box)
  fbI32Const(nullBoxTag())
  fbRefNullNone()
  fbStructNew(uBoxIdx)
  fbLocalSet(stashL)
  fbEnd()
  // A `scalar | null` value (exactly one non-null scalar member) peels to the RAW scalar — take
  // the default on the null tag, else unbox the scalar payload.
  if atoms.length == 2 {
    // `ak` is the residual member's banked ABI code; when unresolved (-2) it re-parses
    // the rendered atom instead. That fallback is unreached on the corpus and fuzz
    // corpora (`docs/internals/destringify-types-program.md` P-RCH/P-SITE) because an
    // alias-spelled nullable value union is rejected by the checker before emit.
    let ak = unionResidualSoloKindOfSet(uvsid)
    if ak == -2 { ak = valueAtomKind(removeAtomFromSet(uvn, "null")) }
    const vb = vbHeapIdxOfKind(ak)
    if vb < 0 {
      return emitFail("emitProgram: scalar|null map value has no value box")
    }
    fbLocalGet(stashL)
    fbStructGet(uBoxIdx, 0)      // field 0: tag
    fbI32Const(nullBoxTag())
    fbI32Bin(70)                 // 0x46 i32.eq → null?
    fbIf(valBlockTypeOfKind(ak)) // value-typed if in the scalar's rep
    ctrlEnter()
    if emitExprAsKind(body, defIx, ak, fnIx) < 0 { return -1 }
    fbElse()
    fbLocalGet(stashL)
    fbStructGet(uBoxIdx, 1)      // field 1: value (anyref payload)
    fbRefCast(vb)
    fbStructGet(vb, 0)           // the scalar payload
    fbEnd()
    ctrlLeave()
    return 0
  }
  // A MULTI-member `… | null` value peels to the NON-null union box: on the null tag, box the
  // default like a stored value (`emitUnionBoxArg`); else keep the stored box. `ref.as_non_null`
  // recovers the non-null box the checker's non-null union result promises.
  fbLocalGet(stashL)
  fbStructGet(uBoxIdx, 0) // field 0: tag
  fbI32Const(nullBoxTag())
  fbI32Bin(70)            // 0x46 i32.eq → null?
  fbIf(64)
  if emitUnionBoxArg(body, uvn, defIx, fnIx) < 0 { return -1 }
  fbLocalSet(stashL)
  fbEnd()
  fbLocalGet(stashL)
  fbRefAsNonNull()
  0
}

// Emit the `??` DEFAULT for a MONO-atom-valued map (`cmSlot < 0`) onto `body`: an i32 atom id
// for a litunion value (a MEMBER literal under `pendingLitUnion`, or an atom-typed expr; a bare
// `null` → the `-1` sentinel), else the value's own rep (boolean / i32). A non-member / general
// string is the wrong rep for the fused i32 result — fail loudly.
function emitMonoMapDefault(body: i32[], recvIx: i32, defIx: i32, fnIx: i32) {
  const atomTexts = nodeTyMapValLitUnionTexts(recvIx)
  let atomDef = false
  let nulAtomDef = false
  if atomTexts.length > 0 {
    const du = P.nodes[unwrapParen(defIx)]
    if du is StrLit {
      if litLexIsMember(du.strText, atomTexts) { atomDef = true }
    } else if du is NullLit {
      // A NULLABLE-atom value (`{[string]: K | null}`) admits a bare `null` default — lowered as
      // the `-1` niche sentinel (the `??` result stays `K | null`).
      if nodeTyMapValIsNulLitUnion(recvIx) {
        atomDef = true
        nulAtomDef = true
      }
    } else if exprIsLitAtom(defIx, fnIx) {
      atomDef = true
    }
    if !atomDef {
      return emitFail(
        "emitProgram: `??` over an atom-valued map needs a member-literal (or atom) default",
      )
    }
  }
  if nulAtomDef {
    fbI32Const(0 - 1)
    return 0
  }
  if atomDef { pendingLitUnion = 1 }
  const dfr = emitExpr(body, defIx, fnIx)
  if atomDef { pendingLitUnion = 0 }
  if dfr < 0 { return -1 }
  0
}

// The narrowed-read tail of a bare map get `m[1]` whose index carries a live narrowing
// — the map twin of `emitIndex`'s ref-list rungs. Ref-recover runs first, since
// `emitMapGet` leaves a nullable element for every ref-valued map; a union value (kind
// 2) then unboxes to the tested atom, unless the narrow leaves two or more atoms.
function emitNarrowedMapReadTail(idxIx: i32, fnIx: i32) {
  const mrs = mapReadNarrowableSlot(idxIx, fnIx)
  if mrs < 0 { return 0 }
  const key = indexPathKeyOf(idxIx)
  const v = narrowVariantFor(key)
  if v == "" || v == "null" { return 0 }
  // A UNION value already left the NON-null box (`emitMapGetUnionBox` recovers it), so only
  // the unbox is owed; every other ref value is the raw `(ref null <elem>)` vals slot.
  if mvValKind[mrs] == 2 {
    const ak = mapReadNarrowedAtomKind(idxIx, fnIx)
    if ak >= 0 { return emitUnionUnboxTail(ak) }
    return 0
  }
  fbRefAsNonNull() // 0xd4 (the `is` guard proved the key present)
  0
}

// Lower a bare map GET `m[k]` (no `??`) onto `body`: probe, return `vals[entry-1]` or
// `0` when absent. The checker never uses a bare map get (always `?? -1`); provided for
// completeness so `m[k]` in value position is total (0 default).
function emitMapGet(body: i32[], recvIx: i32, keyIx: i32, fnIx: i32) {
  if emitMapPrep(body, recvIx, keyIx, fnIx) < 0 { return -1 }
  if cmSlot >= 0 {
    // REF values: yield the NULLABLE element — the (ref null <elem>) vals slot on
    // a hit, `ref.null <elem>` on a miss — via the slot's valStash (same
    // blocktype-avoidance as `emitMapGetOr`). The `m[k]` type is `V | null`.
    const mslot = cmSlot
    pushMapScr(body, 5) // entry
    fbIf(64)            // if (entry != 0), void
    pushMapVals(body)
    fbStructGet(cmValsWrap(), 0)
    pushMapScr(body, 5) // entry
    fbI32Const(1)
    fbI32Bin(107)       // i32.sub (entry - 1)
    fbArrayGet(cmValsBack())
    fbLocalSet(fnMvValStashLocal(mslot))
    fbElse()            // else
    // A miss yields the rep's empty value: 0.0 for an f64 map, 0 for an i64 map, else
    // `ref.null` for a ref (string/struct) value.
    if mvValKind[mslot] == 11 { fbF64Const("0") }
    else if mvValKind[mslot] == 10 { fbI64Const(0, 0) }
    else { fbRefNull(mvValElemHeapOf(mslot)) }
    fbLocalSet(fnMvValStashLocal(mslot))
    fbEnd() // end
    fbLocalGet(fnMvValStashLocal(mslot))
    return 0
  }
  pushMapScr(body, 5) // entry
  fbIf(127)           // if (entry != 0), i32 blocktype
  pushMapVals(body)
  fbStructGet(lTypeIdx, 0)
  pushMapScr(body, 5) // entry
  fbI32Const(1)
  fbI32Bin(107)       // i32.sub (entry - 1)
  fbArrayGet(aTypeIdx)
  fbElse()            // else — a miss reads as the rep's empty value. For a NICHE-BEARING
  // A niche-bearing value map (`K`/`K | null` atoms, `boolean`/`boolean | null`) reads
  // a miss as its sentinel (`-1` litunion, `2` boolean) at both the nullable and the
  // non-nullable spelling — yielding plain `0` there would collide with a real member
  // (atom id 0, or `false`) and make `m[missing] == <that value>` silently true.
  if nodeTyMapValIsNulLitUnion(recvIx) || nodeTyMapValIsLitUnion(recvIx) {
    fbI32Const(0 - 1)
  } else if nodeTyMapValIsNulBool(recvIx) || nodeTyMapValIsBool(recvIx) {
    fbI32Const(2)
  } else {
    fbI32Const(0) // i32.const 0
  }
  fbEnd() // end
  0
}

// Lower a bare map GET `m[k]` of a union-valued map (mv kind 2) onto `body`: the hit arm
// loads the stored `(ref $uBoxIdx)` box, the miss arm synthesizes the null-tagged box
// (`nullBoxTag()`, matching `emitUnionCoerce`'s `NullLit` arm) and recovers it non-null.
// Exported for `emitStartFnCode`'s identical module-scope miss arm.
export function emitMapGetUnionBox(
  body: i32[],
  recvIx: i32,
  keyIx: i32,
  fnIx: i32,
) {
  if emitMapPrep(body, recvIx, keyIx, fnIx) < 0 { return -1 }
  if cmSlot < 0 {
    return emitFail(
      "emitProgram: union-valued map read but no mv slot resolved",
    )
  }
  const mslot = cmSlot
  pushMapScr(body, 5)          // entry
  fbIf(64)                     // if (entry != 0 → found), void
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 0) // vals backing
  pushMapScr(body, 5)          // entry
  fbI32Const(1)
  fbI32Bin(107)                // i32.sub (entry - 1)
  fbArrayGet(cmValsBack())     // the stored (ref null $uBoxIdx) slot read
  fbLocalSet(fnMvValStashLocal(mslot))
  fbElse()                     // else — a miss IS the read's `null`: the null-tagged box
  fbI32Const(nullBoxTag())
  fbRefNullNone()              // the payload slot is unread under the null tag
  fbStructNew(uBoxIdx)
  fbLocalSet(fnMvValStashLocal(mslot))
  fbEnd()                      // end (if)
  fbLocalGet(fnMvValStashLocal(mslot))
  fbRefAsNonNull()
  0
}

// The SPELLING of a scalar value-atom kind — the inverse of `valueAtomKind` over exactly
// the four widths `mapReadScalarBoxKind` can answer with. Only those four: this is a
// membership query against a union's rendered atoms, and every other code either has a
// niche of its own (so it never reaches here) or is not a scalar at all.
function scalarAtomNameOfKind(k: i32): string {
  if k == 0 { return "i32" }
  if k == 3 { return "i64" }
  if k == 4 { return "f64" }
  if k == 5 { return "f32" }
  ""
}

// Lower a bare scalar-valued map read `m[k]` directly into the union box: the tag and
// the payload are each chosen by their own conditional (two allocation sites, so
// Heap2Local scalarizes each — `opt-profile-design.md` §3 item 0), allocation-neutral on
// a hit and cheaper on a miss. No valStash local — the blocktype carries the value.
function emitMapGetScalarBox(
  body: i32[],
  recvIx: i32,
  keyIx: i32,
  atomKind: i32,
  fnIx: i32,
) {
  if emitMapPrep(body, recvIx, keyIx, fnIx) < 0 { return -1 }
  const vbIdx = vbHeapIdxOfKind(atomKind)
  if vbIdx < 0 {
    return emitFail("emitProgram: scalar map read has no value-box type")
  }
  // ── the TAG: the value's atom on a hit, `null`'s atom on a miss ──
  pushMapScr(body, 5) // entry
  fbIf(127)           // i32 blocktype
  fbI32Const(scalarTagOfKind(atomKind))
  fbElse()
  fbI32Const(nullBoxTag())
  fbEnd()
  // ── the PAYLOAD: the boxed value on a hit, a null ref on a miss ──
  pushMapScr(body, 5) // entry
  fbIf(110)           // 0x6e anyref blocktype
  if cmSlot >= 0 {
    pushMapVals(body)
    fbStructGet(cmValsWrap(), 0)
    pushMapScr(body, 5)
    fbI32Const(1)
    fbI32Bin(107) // i32.sub (entry - 1)
    fbArrayGet(cmValsBack())
  } else {
    // The mono i32 map: the vals array is the shared `aTypeIdx` backing.
    pushMapVals(body)
    fbStructGet(lTypeIdx, 0)
    pushMapScr(body, 5)
    fbI32Const(1)
    fbI32Bin(107)
    fbArrayGet(aTypeIdx)
  }
  fbStructNew(vbIdx)
  fbElse()
  fbRefNullNone()
  fbEnd()
  fbStructNew(uBoxIdx)
  0
}

// Lower a map HAS `m.has(k)` / `k in m` onto `body`: probe, push 1 if found else 0.
function emitMapHas(body: i32[], recvIx: i32, keyIx: i32, fnIx: i32) {
  if emitMapPrep(body, recvIx, keyIx, fnIx) < 0 { return -1 }
  pushMapScr(body, 5) // entry
  fbI32Const(0)
  fbI32Bin(71)        // 0x47 i32.ne (entry != 0 → 1, else 0)
  0
}

// Lower `m.keys()` onto `body`, leaving a fresh string list (`$mkListIdx`) of the map's
// live keys in insertion order — the ordered keys/live arrays carry tombstoned entries
// after a delete, so only `live[i] != 0` keys are copied. Uses the 6-slot `mapKeysBase`
// frame; the receiver, a simple binding, is re-emitted per field rather than cached.
function emitMapKeys(body: i32[], recvIx: i32, fnIx: i32) {
  if !exprMap(recvIx, fnIx) {
    return emitFail("emitProgram: .keys() receiver is not a map")
  }
  if !fnUsesMapKeys {
    return emitFail("emitProgram: .keys() scratch frame not reserved")
  }
  const shape0 = mapShapeOfExpr(recvIx, fnIx)
  if shape0 == -3 { return failMapValueType() }
  // A Set's keys() runs on the mono machinery of its own KEY rep.
  const shape = mapShapeFoldSet(shape0)
  // The KEY rep, from the mono sentinel OR the mv slot's own column — the same question
  // `cmKeyI32` asks. A `{[i32]: string}`'s `.keys()` is an `i32[]` even though its shape
  // is an mv slot, so this cannot key off the sentinel alone.
  const keyI32 = mapShapeKeyI32(shape)
  if !keyI32 && !slUsed {
    return emitFail("emitProgram: .keys() but string list type not collected")
  }
  const mapTy = mapTypeIdxOf(shape)
  // The KEY rep's list wrapper / backing, and — since the builder's frame slots are
  // typed per rep — the i32 frame's own out/src slots for an i32-keyed map.
  let keysWrap = mkListIdx
  let keysBack = mkArrIdx
  if keyI32 {
    keysWrap = lTypeIdx
    keysBack = aTypeIdx
  }
  let outBackL = mapKeysBase + 0
  let keysBackL = mapKeysBase + 1
  if keyI32 {
    outBackL = mapI32Base + 2
    keysBackL = mapI32Base + 3
  }
  const liveL = mapKeysBase + 2
  const iL = mapKeysBase + 3
  const jL = mapKeysBase + 4
  const countL = mapKeysBase + 5
  // keysBack = recv.keys.backing  (field 0 = keys wrapper, its field 0 = backing)
  if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
  fbStructGet(mapTy, 0)
  fbStructGet(keysWrap, 0)
  fbLocalSet(keysBackL)
  // live = recv.live  (field 2)
  if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
  fbStructGet(mapTy, 2)
  fbLocalSet(liveL)
  // count = recv.count  (field 4 — entries INCLUDING tombstones)
  if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
  fbStructGet(mapTy, 4)
  fbLocalSet(countL)
  // out = array.new_default <keysBacking> count (sized at count; `len` set to live j)
  fbLocalGet(countL)
  fbArrayNewDefault(keysBack)
  fbLocalSet(outBackL)
  // j = 0 ; i = 0
  fbI32Const(0)
  fbLocalSet(jL)
  fbI32Const(0)
  fbLocalSet(iL)
  // loop { if i >= count {} else { if live[i] != 0 { out[j]=keys[i]; j++ } ; i++ ; br } }
  fbLoop(64)
  fbLocalGet(iL)
  fbLocalGet(countL)
  fbI32Bin(78) // 0x4e i32.ge_s (i >= count → done)
  fbIf(64)
  // then: done (empty)
  fbElse()
  // if live[i] != 0
  fbLocalGet(liveL)
  fbLocalGet(iL)
  fbArrayGet(aTypeIdx)
  fbI32Const(0)
  fbI32Bin(71) // 0x47 i32.ne
  fbIf(64)
  // out[j] = keys[i]
  fbLocalGet(outBackL)
  fbLocalGet(jL)
  fbLocalGet(keysBackL)
  fbLocalGet(iL)
  fbArrayGet(keysBack)
  fbArraySet(keysBack)
  // j = j + 1
  fbLocalGet(jL)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  fbLocalSet(jL)
  fbEnd() // end (live if)
  // i = i + 1
  fbLocalGet(iL)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  fbLocalSet(iL)
  fbBr(1) // → loop header (else=0, loop=1)
  fbEnd() // end (ge_s if/else)
  fbEnd() // end (loop)
  // wrapper = struct.new <keysWrapper> (out, len=j, cap=count)
  fbLocalGet(outBackL)
  fbLocalGet(jL)
  fbLocalGet(countL)
  fbStructNew(keysWrap)
  0
}

// Lower `m.values()` over a mono i32 map onto `body`, leaving a fresh i32 list
// (`$lTypeIdx`) of the map's live values in insertion order — the value analogue of
// `emitMapKeys`, reading the vals list instead of keys and skipping tombstoned entries.
// Other value types iterate via `for v in m.values()`; the bound-list form is i32-only.
function emitMapValues(body: i32[], recvIx: i32, fnIx: i32) {
  if !exprMap(recvIx, fnIx) {
    return emitFail("emitProgram: .values() receiver is not a map")
  }
  const shape = mapShapeOfExpr(recvIx, fnIx)
  // A SET's `.values()` yields its ELEMENTS (its keys), built by `emitMapKeys` — for
  // both key reps, which is why the Set sentinel is a PAIR.
  if shape == -2 || shape == -5 { return emitMapKeys(body, recvIx, fnIx) }
  if shape == -3 { return failMapValueType() }
  if !fnUsesMapVals {
    return emitFail("emitProgram: .values() scratch frame not reserved")
  }
  const mapTy = mapTypeIdxOf(shape)
  const valsWrap = mvValsWrapOf(shape)
  const valsBack = mvValsBackOf(shape)
  // Frame: a MONO map's self-contained `mapValsBase` (all i32-backed), an mv map's per-slot
  // output backing + the mv frame's `valsBk` source + the key-list frame's live/i/j/count.
  let outBackL = mapValsBase + 0
  let valsBackL = mapValsBase + 1
  let liveL = mapValsBase + 2
  let iL = mapValsBase + 3
  let jL = mapValsBase + 4
  let countL = mapValsBase + 5
  if shape >= 0 {
    outBackL = fnMvValsOutLocal(shape)
    valsBackL = fnMvValsBkLocal(shape)
    liveL = mapKeysBase + 2
    iL = mapKeysBase + 3
    jL = mapKeysBase + 4
    countL = mapKeysBase + 5
  }
  // valsBack = recv.vals.backing  (field 1 = vals wrapper, its field 0 = backing)
  if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
  fbStructGet(mapTy, 1)
  fbStructGet(valsWrap, 0)
  fbLocalSet(valsBackL)
  // live = recv.live  (field 2)
  if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
  fbStructGet(mapTy, 2)
  fbLocalSet(liveL)
  // count = recv.count  (field 4 — entries INCLUDING tombstones)
  if emitExpr(body, recvIx, fnIx) < 0 { return -1 }
  fbStructGet(mapTy, 4)
  fbLocalSet(countL)
  // out = array.new_default <valsBack> count
  fbLocalGet(countL)
  fbArrayNewDefault(valsBack)
  fbLocalSet(outBackL)
  fbI32Const(0)
  fbLocalSet(jL)
  fbI32Const(0)
  fbLocalSet(iL)
  // loop { if i >= count {} else { if live[i] != 0 { out[j]=vals[i]; j++ } ; i++ ; br } }
  fbLoop(64)
  fbLocalGet(iL)
  fbLocalGet(countL)
  fbI32Bin(78) // i32.ge_s
  fbIf(64)
  fbElse()
  fbLocalGet(liveL)
  fbLocalGet(iL)
  fbArrayGet(aTypeIdx)
  fbI32Const(0)
  fbI32Bin(71) // i32.ne
  fbIf(64)
  // out[j] = vals[i]
  fbLocalGet(outBackL)
  fbLocalGet(jL)
  fbLocalGet(valsBackL)
  fbLocalGet(iL)
  fbArrayGet(valsBack)
  fbArraySet(valsBack)
  fbLocalGet(jL)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(jL)
  fbEnd() // end (live if)
  fbLocalGet(iL)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(iL)
  fbBr(1)
  fbEnd() // end (ge_s if/else)
  fbEnd() // end (loop)
  // wrapper = struct.new <valsWrap> (out, len=j, cap=count)
  fbLocalGet(outBackL)
  fbLocalGet(jL)
  fbLocalGet(countL)
  fbStructNew(valsWrap)
  0
}

// Rehash primitive: with `mapRef` in slot 0 and the target capacity in slot 4 (`newCap`),
// rebuild a fresh `index` from the live entries by re-placing each from its stored
// `hashes[i]` (no key re-hashing, mirroring the host's `mapRehashFn`). The ordered
// keys/vals/live/hashes stay untouched; used by `emitMapResize` and `emitMapCompact`.
function emitMapRehashTo(body: i32[]) {
  // idxBk = array.new_default $aTypeIdx newCap  (zero-filled)
  pushMapScr(body, 4) // newCap (slot 4, set by the caller)
  fbArrayNewDefault(aTypeIdx)
  setMapScr(body, 10) // idxBk (slot 10)
  // i = 0
  fbI32Const(0)
  setMapScr(body, 3) // i (slot 3)
  // loop { if i >= count {} else { rebuild entry i ; i++ ; br } }
  fbLoop(64)          // loop, void
  pushMapScr(body, 3) // i
  pushMapCount(body)
  fbI32Bin(78)        // i32.ge_s (i >= count → done)
  fbIf(64)            // if, void
  // then: done (empty)
  fbElse() // else
  // Skip tombstoned entries — only LIVE entries get re-placed in the new index (mirror
  // the host's `mapRehashFn` `if live[i] != 0`). `live` is all-1s in a delete-free
  // program, so this `if` is always taken (behavior-preserving).
  pushMapLive(body)
  pushMapScr(body, 3)  // i
  fbArrayGet(aTypeIdx) // array.get live[i]
  fbI32Const(0)
  fbI32Bin(71)         // 0x47 i32.ne (live[i] != 0)
  fbIf(64)             // if, void
  // rslot = hashes[i] % newCap — re-place from the stored hash (no key re-hashing).
  pushMapHashes(body)
  pushMapScr(body, 3)  // i
  fbArrayGet(aTypeIdx) // array.get hashes[i]
  pushMapScr(body, 4)  // newCap
  fbI32Bin(112)        // i32.rem_u
  setMapScr(body, 11)  // rslot
  // while idxBk[rslot] != 0 { rslot = (rslot + 1) % newCap }
  fbBlock(64) // block (inner probe break), void
  fbLoop(64)  // loop, void
  // if idxBk[rslot] == 0 { br 1 → out of inner block }
  pushMapScr(body, 10) // idxBk
  pushMapScr(body, 11) // rslot
  fbArrayGet(aTypeIdx) // array.get
  fbI32Eqz()           // i32.eqz
  fbBrIf(1)            // br_if depth 1 → out of inner block
  // rslot = (rslot + 1) % newCap
  pushMapScr(body, 11)
  fbI32Const(1)
  fbI32Bin(106)       // i32.add
  pushMapScr(body, 4) // newCap
  fbI32Bin(112)       // i32.rem_u
  setMapScr(body, 11)
  fbBr(0)             // br → inner loop header
  fbEnd()             // end (inner loop)
  fbEnd()             // end (inner block)
  // idxBk[rslot] = i + 1
  pushMapScr(body, 10) // idxBk
  pushMapScr(body, 11) // rslot
  pushMapScr(body, 3)  // i
  fbI32Const(1)
  fbI32Bin(106)        // i32.add (i + 1)
  fbArraySet(aTypeIdx) // array.set
  fbEnd()              // end (live[i] != 0 if)
  // i = i + 1
  pushMapScr(body, 3)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  setMapScr(body, 3)
  fbBr(1)       // br → outer loop header
  fbEnd()       // end (ge_s if)
  fbEnd()       // end (outer loop)
  // M.index = idxBk
  pushMapRef(body)          // mapRef
  pushMapScr(body, 10)      // idxBk
  fbStructSet(cmMapTy(), 3) // struct.set field 3: index
  0
}

// Resize the `index` when the load factor (size / cap) crosses 1/2: a `call` into the
// shared `__map_resize__` helper returns the doubled+rehashed backing (or the old one
// when the load factor is fine), stored back unconditionally — only the receiver
// `struct.get`s and the final `struct.set` are shape-typed; the entry lists are untouched.
function emitMapResize(body: i32[]) {
  pushMapRef(body) // the struct.set receiver
  pushMapIndex(body)
  pushMapHashes(body)
  pushMapLive(body)
  pushMapCount(body)
  pushMapSize(body)
  fbCall(gHelpMapResize)
  fbStructSet(cmMapTy(), 3) // struct.set field 3: index
  0
}

// `emitMapCompact` (mirror of the host's `mapCompactFn`): reclaim tombstones by
// rebuilding keys/vals/live/hashes from the live entries only, preserving insertion
// order, then rebuilding the index at a live-count-based capacity (next pow2 ≥ 2×size,
// floored at `INITIAL_CAP`×2 = 16) — bounds both under add/delete churn.
function emitMapCompact(body: i32[]) {
  // Fresh entry arrays sized to the OLD entry capacity (keeps spare room; lengths are
  // irrelevant to iteration — count/size bound it). Mirrors the host's `array.new_default
  // (len(oldArr))`.
  // nk = new keys backing (slot 6)
  pushMapKeysBacking(body)
  fbArrayLen()
  fbArrayNewDefault(cmKeysBack())
  setMapScrKB(body) // nk (the keys-backing scratch of this KEY rep)
  // nv = new vals backing (the valsBk scratch — slot 7 mono, the mv frame else)
  pushMapValsBacking(body)
  fbArrayLen()
  fbArrayNewDefault(cmValsBack())
  setMapScrVB(body) // nv
  // nl = new live backing (slot 10)
  pushMapLive(body)
  fbArrayLen()
  fbArrayNewDefault(aTypeIdx)
  setMapScr(body, 10) // nl (slot 10)
  // nh = new hashes backing (slot 13)
  pushMapHashes(body)
  fbArrayLen()
  fbArrayNewDefault(aTypeIdx)
  setMapScrHB(body) // nh (slot 13)
  // i = 0 ; j = 0
  fbI32Const(0)
  setMapScr(body, 8) // i (read cursor)
  fbI32Const(0)
  setMapScr(body, 9) // j (write cursor)
  // Copy the live entries down, compacting out tombstones (order kept).
  // loop { if i >= count {} else { if live[i] != 0 { copy i->j ; j++ } ; i++ ; br } }
  fbLoop(64)          // loop, void
  pushMapScr(body, 8) // i
  pushMapCount(body)
  fbI32Bin(78)        // i32.ge_s (i >= count → done)
  fbIf(64)            // if, void
  // then: done (empty)
  fbElse()             // else
  pushMapLive(body)
  pushMapScr(body, 8)  // i
  fbArrayGet(aTypeIdx) // live[i]
  fbI32Const(0)
  fbI32Bin(71)         // i32.ne (live[i] != 0)
  fbIf(64)             // if, void
  // nk[j] = keys.backing[i]
  pushMapScrKB(body)       // nk
  pushMapScr(body, 9)      // j
  pushMapKeysBacking(body)
  pushMapScr(body, 8)      // i
  fbArrayGet(cmKeysBack()) // keys.backing[i] (a string ref / a raw i32)
  fbArraySet(cmKeysBack())
  // nv[j] = vals.backing[i]
  pushMapScrVB(body)       // nv
  pushMapScr(body, 9)      // j
  pushMapValsBacking(body)
  pushMapScr(body, 8)      // i
  fbArrayGet(cmValsBack()) // vals.backing[i]
  fbArraySet(cmValsBack())
  // nl[j] = 1
  pushMapScr(body, 10) // nl
  pushMapScr(body, 9)  // j
  fbI32Const(1)
  fbArraySet(aTypeIdx)
  // nh[j] = hashes[i]
  pushMapScrHB(body)   // nh
  pushMapScr(body, 9)  // j
  pushMapHashes(body)
  pushMapScr(body, 8)  // i
  fbArrayGet(aTypeIdx) // hashes[i]
  fbArraySet(aTypeIdx)
  // j = j + 1
  pushMapScr(body, 9)
  fbI32Const(1)
  fbI32Bin(106)
  setMapScr(body, 9)
  fbEnd() // end (live[i] != 0 if)
  // i = i + 1
  pushMapScr(body, 8)
  fbI32Const(1)
  fbI32Bin(106)
  setMapScr(body, 8)
  fbBr(1) // br → loop header
  fbEnd() // end (ge_s if)
  fbEnd() // end (loop)
  // Swap the rebuilt entry arrays into the keys/vals list wrappers + the struct.
  // keys.backing = nk ; keys.len = size ; keys.cap = len(nk)
  pushMapKeys(body)
  pushMapScrKB(body)
  fbStructSet(cmKeysWrap(), 0) // keys.backing = nk
  pushMapKeys(body)
  pushMapSize(body)
  fbStructSet(cmKeysWrap(), 1) // keys.len = size
  pushMapKeys(body)
  pushMapScrKB(body)
  fbArrayLen()
  fbStructSet(cmKeysWrap(), 2) // keys.cap = len(nk)
  // vals.backing = nv ; vals.len = size ; vals.cap = len(nv)
  pushMapVals(body)
  pushMapScrVB(body)
  fbStructSet(cmValsWrap(), 0) // vals.backing = nv
  pushMapVals(body)
  pushMapSize(body)
  fbStructSet(cmValsWrap(), 1) // vals.len = size
  pushMapVals(body)
  pushMapScrVB(body)
  fbArrayLen()
  fbStructSet(cmValsWrap(), 2) // vals.cap = len(nv)
  // M.live = nl ; M.hashes = nh
  pushMapRef(body)
  pushMapScr(body, 10)      // nl
  fbStructSet(cmMapTy(), 2) // live = nl
  pushMapRef(body)
  pushMapScrHB(body)        // nh
  fbStructSet(cmMapTy(), 6) // hashes = nh
  // count = size (no tombstones remain)
  pushMapRef(body)
  pushMapSize(body)
  fbStructSet(cmMapTy(), 4) // count = size
  // Target index cap: next pow2 ≥ 2×size, floored at `INITIAL_CAP`×2 = 16; cap in slot 11.
  fbI32Const(16)
  setMapScr(body, 11) // cap
  // while cap < 2*size { cap = cap * 2 }
  fbLoop(64)           // loop, void
  pushMapScr(body, 11) // cap
  pushMapSize(body)
  fbI32Const(2)
  fbI32Bin(108)        // size * 2
  fbI32Bin(79)         // 0x4f i32.ge_u (cap >= 2*size → done)
  fbIf(64)             // if, void
  // then: done (empty)
  fbElse()      // else
  pushMapScr(body, 11)
  fbI32Const(2)
  fbI32Bin(108) // cap * 2
  setMapScr(body, 11)
  fbBr(1)       // br → loop header
  fbEnd()       // end (ge_u if)
  fbEnd()       // end (loop)
  // Rebuild the index at the chosen cap.
  pushMapScr(body, 11) // cap
  setMapScr(body, 4)   // newCap (for emitMapRehashTo)
  if emitMapRehashTo(body) < 0 { return -1 }
  0
}

// Lower a map delete `m.delete(k): boolean` onto `body` (mirror of the host's
// `mapDeleteFn`): probe to the entry; a miss pushes 0, a hit tombstones
// `live[entry-1] = 0`, decrements `size`, amortized-compacts when dead entries
// (`count - size`) exceed `size + INITIAL_CAP`, and pushes 1.
function emitMapDelete(body: i32[], recvIx: i32, keyIx: i32, fnIx: i32) {
  if emitMapPrep(body, recvIx, keyIx, fnIx) < 0 { return -1 }
  // if entry == 0 { 0 } else { tombstone ; size-- ; maybe-compact ; 1 }
  pushMapScr(body, 5) // entry
  fbIf(127)           // if (entry != 0), 0x7f i32 blocktype
  // live[entry-1] = 0  (tombstone; keeps the entry's insertion-order position)
  pushMapLive(body)
  pushMapScr(body, 5)  // entry
  fbI32Const(1)
  fbI32Bin(107)        // i32.sub (entry - 1)
  fbI32Const(0)
  fbArraySet(aTypeIdx) // array.set live[entry-1] = 0
  // size = size - 1
  pushMapRef(body)          // mapRef
  pushMapSize(body)
  fbI32Const(1)
  fbI32Bin(107)             // i32.sub
  fbStructSet(cmMapTy(), 5) // struct.set field 5: size
  // Amortized compaction: if `(count - size) > (size + INITIAL_CAP)` compact.
  pushMapCount(body)
  pushMapSize(body)
  fbI32Bin(107) // i32.sub (count - size)
  pushMapSize(body)
  fbI32Const(8) // INITIAL_CAP
  fbI32Bin(106) // i32.add (size + INITIAL_CAP)
  fbI32Bin(75)  // 0x4b i32.gt_u ((count-size) > (size+INITIAL_CAP))
  fbIf(64)      // if, void
  if emitMapCompact(body) < 0 { return -1 }
  fbEnd()       // end (compact if)
  // result = 1: a key is removed.
  fbI32Const(1)
  fbElse() // else
  // result = 0 (absent)
  fbI32Const(0)
  fbEnd() // end (entry if)
  0
}

// Emit a map set's value expr in the map's value rep — scalar coercion, union boxing,
// list-kind / ref-list-slot / struct-index hints, and the atom-id context an overwrite
// or append needs. One evaluation, shared by both arms of `emitMapSetV`. Leaves the
// value on the stack; `cmSlot` may be clobbered by inner map ops, so callers re-pin.
function emitMapSetValExpr(
  body: i32[],
  valIx: i32,
  fnIx: i32,
  mslot: i32,
  atomVal: boolean,
  nulBoolVal: boolean,
) {
  const svk = mvScalarValKind(mslot)
  if svk != null {
    // A SCALAR-valued map (f64/i64): emit the value coerced to the element rep.
    return emitScalarValue(body, valIx, fnIx, svk)
  }
  if mslot >= 0 && mvValKind[mslot] == 2 {
    // A UNION-valued map: box the stored value into the shared union box (a concrete
    // VARIANT value boxes via `emitUnionBoxArg`, like a call arg / return).
    return emitUnionBoxArg(body, mvValName[mslot], valIx, fnIx)
  }
  // Seed a non-i32 scalar-LIST value's inner list kind (as the `?? default` read
  // does) so a stored `m[k] = [1,2,3]` builds the i64/f64/string list wrapper, not
  // the default i32-list that would mismatch the typed element slot.
  const svCtx = expCtxHere()
  const lvk = mvListValKind(mslot)
  if lvk == "strlist" {
    svCtx.listKind = 3
  } else if lvk == "f64list" {
    svCtx.listKind = 4
  } else if lvk == "i64list" {
    svCtx.listKind = 6
  } else if lvk == "f32list" {
    svCtx.listKind = 7
  } else if mslot >= 0 {
    // A ref-list value (`S[]`, `(C|D)[]`, a nested `S[][]`, or a closure list) seeds the
    // value's ref-list slot so the literal builds as that list, recursing through its inner
    // elements. The slot's existence already answers "is this a ref array", so no second
    // `nameIsRefArray` guard is needed; a non-array value declines without parsing.
    const rlv = mvValInnerRlSlot(mslot)
    if rlv >= 0 {
      svCtx.listKind = 5
      svCtx.listSlot = rlv
    }
  }
  // An atom-valued mono map's member-literal value lowers as its interned atom id; a
  // NULLABLE-atom value (`{[string]: K | null}`) stores a bare `null` as the `-1` sentinel.
  if atomVal {
    const vnul = P.nodes[unwrapParen(valIx)]
    if vnul is NullLit {
      fbI32Const(0 - 1)
      return 0
    }
    svCtx.litUnion = 1
  }
  // A `boolean | null`-valued MONO map (i32 niche) stores a bare `null` as the `2` sentinel —
  // the store-side dual of the read's `nodeTyMapValIsNulBool` coalesce (sentinel 2). A non-null
  // boolean value (true/false) falls through and emits as a plain i32.
  if nulBoolVal {
    const vnb = P.nodes[unwrapParen(valIx)]
    if vnb is NullLit {
      fbI32Const(2)
      return 0
    }
  }
  // A NULLABLE-value slot (`{[string]: S | null}` / `{[string]: map | null}`) stores a bare
  // `null` as `ref.null <elem>` — the vals element carries it directly and the fused read
  // preserves it. A non-null value ignores the seed.
  if mvSlotNullable(mslot) { svCtx.nulRefHeap = mvValElemHeapOf(mslot) }
  // A struct-valued map forces the value struct's own index so `{f: …}` builds the map's
  // declared value struct, not a field-name-set twin — without it, two same-field-name-set
  // struct map values resolve via `structIndexOfObj` to whichever interned first, a
  // wrong-layout `struct.new` (invalid wasm). `emitObj` consumes the seed.
  if mslot >= 0 && mvValKind[mslot] == 1 {
    // The value may also be a declared variant arm: seed `variantIdx` too, since
    // `uVariants` and `sNames` are mutually exclusive columns (a name in one has no row
    // in the other) — this is an either/or, not a widening. The seed names the row whose
    // heap the vals element actually holds, the canonical twin's row (D123).
    const svVi = mvValVariantOf(mslot)
    if svVi >= 0 {
      svCtx.variantIdx = svVi
    } else {
      svCtx.structIdx = mvValStructIdxOf(mslot)
    }
  }
  // A nested-map value seeds `svCtx.mapSlot` (mirroring `emitMapValDefault`'s read-side
  // seed) so a `Map()` value `struct.new`s the map struct this slot's vals element is
  // typed to, not the ambient mono one. The seed must land in the context, not a global:
  // `emitExprExpect` overwrites the whole context from its own snapshot.
  if mvValIsMap(mslot) { svCtx.mapSlot = mvInnerMapShape(mslot) }
  // A literal-union atom stored into a string-valued map widens to its member string: the
  // vals element is `(ref null $aTypeIdx)` while the atom's rep is an i32 id, so without
  // this the store is a type mismatch — invalid wasm. Gated on `!atomVal`, since an
  // atom-valued map wants the raw id instead (`svCtx.litUnion`, set above).
  if !atomVal {
    if exprIsLitAtom(valIx, fnIx) { return emitStrValue(body, valIx, fnIx) }
  }
  const mvArmOwed = narrowedArmNeedsUnbox(valIx, fnIx)
  if emitExprExpect(body, valIx, fnIx, svCtx) < 0 { return -1 }
  // The narrowed-arm unbox at the map-value boundary (D1031) — `m[k] = s` under `if s is
  // Circle` over a `{[string]: Circle}` — targets the vals element's own heap, the same
  // one `mvSlotNullable`'s `ref.null` seed above reads.
  if mvArmOwed && mslot >= 0 { emitNarrowedArmUnboxTo(mvValElemHeapOf(mslot)) }
  // Read-only covariance at the map-value boundary (D791) — `mU["k"] = lv1` over a
  // `{[string]: Shape[]}` — targets the same `mvValInnerRlSlot` row the build seed above
  // reads; it declines for every non-ref-list value type without parsing.
  if mslot >= 0 {
    const mvWiden = mvValInnerRlSlot(mslot)
    if mvWiden >= 0 {
      emitRefListWidenSite(
        body,
        valIx,
        exprEmittedRefListSlot(valIx, fnIx),
        mvWiden,
      )
    }
  }
  0
}

// `local.set` / `local.get` of the set-value stash: the mv slot's typed valStash, or the
// mono frame's dedicated slot 14. Slot 14 is reserved — no probe / push / grow / resize
// machinery touches it, so the value survives from its write through the overwrite or
// append store; slot 3 (the pushVal stash) is also the probe slot and cannot hold one.
function setMapSetValStash(body: i32[], mslot: i32) {
  if mslot >= 0 {
    fbLocalSet(fnMvValStashLocal(mslot))
    return 0
  }
  setMapScr(body, 14)
  0
}
function pushMapSetValStash(body: i32[], mslot: i32) {
  if mslot >= 0 {
    fbLocalGet(fnMvValStashLocal(mslot))
    return 0
  }
  pushMapScr(body, 14)
  0
}

// Lower a map set `m[k] = v` (also `m.set(k, v)`, and `s.add(k)` via `valConst1 = true`):
// probe; a hit overwrites, a miss appends and maybe resizes. Receiver, key and value are
// all evaluated before the probe and before landing in scratch locals, so `m[k] = (m[k]
// ?? 0) + 1` probes the untouched map and a nested map op cannot clobber the shared frame.
function emitMapSetV(
  body: i32[],
  recvIx: i32,
  keyIx: i32,
  valIx: i32,
  fnIx: i32,
  valConst1: boolean,
) {
  // An ATOM-valued map (`{[string]: K}`, `K` a literal union) rides the MONO map: each
  // value is the interned atom id (a plain i32). Its member-literal value is a StrLit
  // syntactically — it must BYPASS the mono string guard below and emit in atom context
  // (`pendingLitUnion`), so resolve the receiver's value type up front.
  let atomVal = nodeTyMapValIsLitUnion(recvIx)
  if nodeTyMapValIsNulLitUnion(recvIx) { atomVal = true }
  // A `boolean | null`-valued map is the MONO i32 niche too — a bare `null` store lowers as the
  // `2` sentinel (the store-side dual of the read's `nodeTyMapValIsNulBool` coalesce).
  const nulBoolVal = nodeTyMapValIsNulBool(recvIx)
  // A mono (i32/boolean-valued) map cannot store a ref value — a string / struct / list
  // ref into an i32 array is invalid wasm — so fail loudly; an mv-slot map stores such
  // values through its own typed vals list, and a constant-true Set value is always a
  // valid i32 boolean. Resolved here only for the gate; `emitMapRecvKey` re-resolves it.
  if valConst1 == false && !atomVal {
    if mapShapeOfExpr(recvIx, fnIx) < 0 {
      if (
        exprString(valIx, fnIx) ||
        exprStruct(valIx, fnIx) ||
        exprArray(valIx, fnIx) ||
        exprRefArray(valIx, fnIx) ||
        exprStringArray(valIx, fnIx)
      ) {
        return emitFail("emitProgram: map values must be i32 / boolean")
      }
    }
  }
  // Receiver + key onto the operand stack; `cmSlot` pinned to the shape.
  if emitMapRecvKey(body, recvIx, keyIx, fnIx) < 0 { return -1 }
  const mslot = cmSlot
  // VALUE next — evaluated ONCE, while the map is still untouched and recv/key are
  // still stack-parked — then stashed. Only probe/store machinery runs after this.
  if valConst1 {
    fbI32Const(1) // Set value: constant boolean true
  } else {
    if emitMapSetValExpr(body, valIx, fnIx, mslot, atomVal, nulBoolVal) < 0 {
      return -1
    }
  }
  if setMapSetValStash(body, mslot) < 0 { return -1 }
  cmSlot = mslot           // re-pin: inner map ops in the value expr clobber it
  fbLocalSet(cmKeyLocal()) // the target key (popped off the stack)
  setMapRef(body)          // mapRef
  emitMapProbe(body, true)
  pushMapScr(body, 5)      // entry
  fbIf(64)                 // if (entry != 0 → overwrite), void
  // OVERWRITE: vals.backing[entry-1] = stash
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 0) // struct.get (vals backing), field 0: backing
  pushMapScr(body, 5)          // entry
  fbI32Const(1)
  fbI32Bin(107)                // i32.sub (entry - 1)
  pushMapSetValStash(body, mslot)
  fbArraySet(cmValsBack())     // array.set
  fbElse()                     // else
  // APPEND. index[slot] = count + 1  (the new entry's position + 1).
  pushMapIndex(body)
  pushMapScr(body, 3)  // slot
  pushMapCount(body)
  fbI32Const(1)
  fbI32Bin(106)        // i32.add (count + 1)
  fbArraySet(aTypeIdx) // array.set
  // keys.push(keyRef) ; vals.push(stash)  (clobbers slots 3/4 — already linked above).
  if emitMapPushKey(body) < 0 { return -1 }
  if emitMapPushVal(body) < 0 { return -1 }
  // count = count + 1
  pushMapRef(body)          // mapRef (struct.set receiver)
  pushMapCount(body)
  fbI32Const(1)
  fbI32Bin(106)             // i32.add
  fbStructSet(cmMapTy(), 4) // struct.set field 4: count
  // size = size + 1
  pushMapRef(body)          // mapRef
  pushMapSize(body)
  fbI32Const(1)
  fbI32Bin(106)             // i32.add
  fbStructSet(cmMapTy(), 5) // struct.set field 5: size
  if emitMapResize(body) < 0 { return -1 }
  fbEnd()                   // end (if)
  0
}

// Thin wrapper preserving the original arity: the non-constant-value map set. The
// `s.add(k)` Set form calls `emitMapSetV` with `valConst1 = true`.
function emitMapSet(
  body: i32[],
  recvIx: i32,
  keyIx: i32,
  valIx: i32,
  fnIx: i32,
) {
  emitMapSetV(body, recvIx, keyIx, valIx, fnIx, false)
}

// Inline list-grow append of the scratch `keyRef` (slot 1) onto `M.keys`. The keys
// backing is `(array (mut (ref null $sTypeIdx)))`, so grow uses `array.new_default` /
// `array.copy` over `$mkArrIdx`, reusing the map scratch frame's spare i32 slots (4
// newCap, 3 free here) rather than a dedicated frame — the grow path mirrors `emitPush`.
function emitMapPushKey(body: i32[]) {
  // if keys.len == keys.cap { grow }
  pushMapKeysLen(body)
  pushMapKeysCap(body)
  fbI32Bin(70) // i32.eq
  fbIf(64)     // if, void
  // newCap = cap == 0 ? 4 : cap*2   (slot 4)
  pushMapKeysCap(body)
  fbI32Eqz()         // i32.eqz
  fbIf(127)          // if, i32 blocktype
  fbI32Const(4)
  fbElse()           // else
  pushMapKeysCap(body)
  fbI32Const(2)
  fbI32Bin(108)      // i32.mul
  fbEnd()            // end
  setMapScr(body, 4) // newCap
  // keys.backing = copy of old into a fresh array.new_default(newCap), keys.cap=newCap
  // newBacking on stack: array.new_default <keysBacking> newCap
  pushMapScr(body, 4) // newCap
  fbArrayNewDefault(cmKeysBack())
  // newBacking needs a TYPED ref local (slot 6, `newKeysBacking`): the copy must run
  // BEFORE the swap (swapping first loses the old elements), and `array.copy` CONSUMES
  // its dest operand, so the stack alone cannot supply it twice. `curRef` cannot hold it
  // either — that slot is a `(ref $sTypeIdx)` string ref, the wrong type.
  setMapScrKB(body) // newKeysBacking (slot 6)
  // array.copy newBacking 0 oldBacking 0 len
  pushMapScrKB(body)                      // dest
  fbI32Const(0)
  pushMapKeysBacking(body)                // src (old)
  fbI32Const(0)
  pushMapKeysLen(body)                    // count
  fbArrayCopy(cmKeysBack(), cmKeysBack()) // array.copy (dest type, src type)
  // keys.backing = newBacking
  pushMapKeys(body)
  pushMapScrKB(body)
  fbStructSet(cmKeysWrap(), 0) // struct.set field 0: backing
  // keys.cap = newCap
  pushMapKeys(body)
  pushMapScr(body, 4)
  fbStructSet(cmKeysWrap(), 2) // struct.set field 2: cap
  // live grows in LOCKSTEP with the keys backing (entry-parallel): allocate a fresh
  // `(ref $aTypeIdx)` of newCap (slot 12), copy the live region `[0, keys.len)` over,
  // and store it back into M.live (field 2). `keys.len` is still the pre-append count
  // here. Mirrors the host's grow of its entry-parallel arrays.
  pushMapScr(body, 4)             // newCap
  fbArrayNewDefault(aTypeIdx)
  setMapScrLB(body)               // newLiveBacking (slot 12)
  pushMapScrLB(body)              // dest
  fbI32Const(0)
  pushMapLive(body)               // src (old live)
  fbI32Const(0)
  pushMapKeysLen(body)            // count (entries copied)
  fbArrayCopy(aTypeIdx, aTypeIdx) // array.copy (dest type, src type)
  pushMapRef(body)                // mapRef
  pushMapScrLB(body)
  fbStructSet(cmMapTy(), 2)       // struct.set field 2: live
  // hashes grows in LOCKSTEP too (entry-parallel): fresh `(ref $aTypeIdx)` of newCap
  // (slot 13), copy `[0, keys.len)` over, store back into M.hashes (field 6). Mirrors
  // the host's grow of its entry-parallel `hashes` array.
  pushMapScr(body, 4)             // newCap
  fbArrayNewDefault(aTypeIdx)
  setMapScrHB(body)               // newHashBacking (slot 13)
  pushMapScrHB(body)              // dest
  fbI32Const(0)
  pushMapHashes(body)             // src (old hashes)
  fbI32Const(0)
  pushMapKeysLen(body)            // count (entries copied)
  fbArrayCopy(aTypeIdx, aTypeIdx) // array.copy (dest type, src type)
  pushMapRef(body)                // mapRef
  pushMapScrHB(body)
  fbStructSet(cmMapTy(), 6)       // struct.set field 6: hashes
  fbEnd()                         // end (grow if)
  // live[keys.len] = 1  (the new entry is live).
  pushMapLive(body)
  pushMapKeysLen(body) // entry index (== count, pre-append)
  fbI32Const(1)
  fbArraySet(aTypeIdx) // array.set
  // hashes[keys.len] = hash(keyRef)  — cache the key's FNV hash parallel to the entry
  // so resize/compact re-place it without re-hashing (mirrors the host's `mapSetFn`
  // append, which stores `m.call(hash, [key()])`). `pushMapProbedHash` leaves the masked
  // hash on the stack, reusing the probe's own for a string key.
  pushMapHashes(body)
  pushMapKeysLen(body) // entry index (== count, pre-append)
  pushMapProbedHash(body)
  fbArraySet(aTypeIdx) // array.set
  // keys.backing[keys.len] = key
  pushMapKeysBacking(body)
  pushMapKeysLen(body)
  fbLocalGet(cmKeyLocal())
  fbArraySet(cmKeysBack()) // array.set
  // keys.len = keys.len + 1
  pushMapKeys(body)
  pushMapKeysLen(body)
  fbI32Const(1)
  fbI32Bin(106)                // i32.add
  fbStructSet(cmKeysWrap(), 1) // struct.set field 1: len
  0
}

// Append the stashed set value onto `M.vals` (inline list-grow push). `emitMapSetV`
// evaluates and stashes the value before the probe, so this only grows the vals list
// and stores the stash — no user code runs inside the append.
function emitMapPushVal(body: i32[]) {
  const mslot = cmSlot
  // if vals.len == vals.cap { grow }
  pushMapValsLen(body)
  pushMapValsCap(body)
  fbI32Bin(70) // i32.eq
  fbIf(64)     // if, void
  // newCap (slot 4)
  pushMapValsCap(body)
  fbI32Eqz()    // i32.eqz
  fbIf(127)     // if, i32 blocktype
  fbI32Const(4)
  fbElse()      // else
  pushMapValsCap(body)
  fbI32Const(2)
  fbI32Bin(108) // i32.mul
  fbEnd()       // end
  setMapScr(body, 4)
  // newBacking = array.new_default <valsBack> newCap → the valsBk scratch
  pushMapScr(body, 4)
  fbArrayNewDefault(cmValsBack())
  setMapScrVB(body) // newValsBacking
  // array.copy newBacking 0 oldBacking 0 len
  pushMapScrVB(body)
  fbI32Const(0)
  pushMapValsBacking(body)
  fbI32Const(0)
  pushMapValsLen(body)
  fbArrayCopy(cmValsBack(), cmValsBack()) // array.copy (dest type, src type)
  // vals.backing = newBacking
  pushMapVals(body)
  pushMapScrVB(body)
  fbStructSet(cmValsWrap(), 0) // struct.set field 0: backing
  // vals.cap = newCap
  pushMapVals(body)
  pushMapScr(body, 4)
  fbStructSet(cmValsWrap(), 2) // struct.set field 2: cap
  fbEnd()                      // end (grow if)
  // vals.backing[vals.len] = the stashed value
  pushMapValsBacking(body)
  pushMapValsLen(body)
  pushMapSetValStash(body, mslot)
  fbArraySet(cmValsBack()) // array.set
  // vals.len = vals.len + 1
  pushMapVals(body)
  pushMapValsLen(body)
  fbI32Const(1)
  fbI32Bin(106)                // i32.add
  fbStructSet(cmValsWrap(), 1) // struct.set field 1: len
  0
}

// `M.keys.len` / `.cap` / `.backing` field reads (struct.get $mkListIdx 1/2/0).
function pushMapKeysLen(body: i32[]) {
  pushMapKeys(body)
  fbStructGet(cmKeysWrap(), 1)
  0
}
function pushMapKeysCap(body: i32[]) {
  pushMapKeys(body)
  fbStructGet(cmKeysWrap(), 2)
  0
}
function pushMapKeysBacking(body: i32[]) {
  pushMapKeys(body)
  fbStructGet(cmKeysWrap(), 0)
  0
}
// `M.vals.len` / `.cap` / `.backing` field reads (struct.get <valsWrap> 1/2/0 —
// the i32 list wrapper for the mono map, this mv slot's ref-list wrapper else).
function pushMapValsLen(body: i32[]) {
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 1)
  0
}
function pushMapValsCap(body: i32[]) {
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 2)
  0
}
function pushMapValsBacking(body: i32[]) {
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 0)
  0
}

// The two ref scratch locals beyond the 6-slot core frame: a non-null keys backing
// ref (slot 6) and a non-null vals backing ref (slot 7), used by the two grows.
function setMapScrKB(_body: i32[]) {
  fbLocalSet(cmKeysBkLocal())
  0
}
function pushMapScrKB(_body: i32[]) {
  fbLocalGet(cmKeysBkLocal())
  0
}
function setMapScrVB(_body: i32[]) {
  fbLocalSet(cmValsBkLocal())
  0
}
function pushMapScrVB(_body: i32[]) {
  fbLocalGet(cmValsBkLocal())
  0
}
// The grown `live` backing ref (slot 12, a non-null `(ref $aTypeIdx)` i32 array),
// used by the keys grow to reallocate `live` in lockstep with the keys backing.
function setMapScrLB(_body: i32[]) {
  fbLocalSet(mapScratchBase + 12)
  0
}
function pushMapScrLB(_body: i32[]) {
  fbLocalGet(mapScratchBase + 12)
  0
}
// The grown `hashes` backing ref (slot 13, a non-null `(ref $aTypeIdx)` i32 array),
// used by the keys grow to reallocate `hashes` in lockstep with the keys backing, and
// by `compact` as the rebuilt hashes backing.
function setMapScrHB(_body: i32[]) {
  fbLocalSet(mapScratchBase + 13)
  0
}
function pushMapScrHB(_body: i32[]) {
  fbLocalGet(mapScratchBase + 13)
  0
}

// Begin a chunked long-literal build: allocate the full `n`-element backing into a fresh
// backing-typed slot of the lazy list frame (so a nested chunked literal cannot clobber
// this one), then open the first chunk and return the destination slot. `strBack` (not
// `kind`, which is "i32" for both) distinguishes a string destination from a list one.
function arrLitChunkStart(
  kind: MfKind,
  rslot: i32,
  backTy: i32,
  n: i32,
  strBack: boolean,
) {
  liKinds.push(kind)
  liSlots.push(rslot)
  if strBack { liBack.push(5) } else { liBack.push(1) }
  const dst = listIdxScratchBase + liKinds.length
  fbI32Const(n)
  fbArrayNewDefault(backTy) // 0xfb 0x07 <typeidx>
  fbLocalSet(dst)
  fbLocalGet(dst)           // the open chunk's copy destination …
  fbI32Const(0)             // … and destination offset
  dst
}

// Chunk boundary check after element `i` of `n` is pushed (`coff` marks the open
// chunk's first element). At `NEW_FIXED_MAX` elements or the literal's end, close
// the chunk — `array.new_fixed` the pushed elements, `array.copy` them into the
// destination — and open the next one when elements remain. Returns the new start.
function arrLitChunkFlush(dst: i32, backTy: i32, coff: i32, i: i32, n: i32) {
  if i - coff < NEW_FIXED_MAX && i < n { return coff }
  fbArrayNewFixed(backTy, i - coff) // the chunk source array
  fbI32Const(0)                     // source offset
  fbI32Const(i - coff)              // element count
  fbArrayCopy(backTy, backTy)       // 0xfb 0x11 — consumes [dst, off, src, 0, k]
  if i < n {
    fbLocalGet(dst)
    fbI32Const(i)
  }
  i
}

// Lower the `len`-bounds guard of a list `xs[i]` read/write: stack holds [wrapper,
// index] on entry, leaves [backing, safeIndex] where safeIndex is `i` when `i u< len`
// (one unsigned compare covers negative and past-len) and `-1` otherwise, so the access
// traps instead of silently reading the zero-init slack `.push` leaves past `len`.
function emitListIdxGuard(wrapSlot: i32, lTy: i32) {
  fbLocalSet(listIdxScratchBase) // 0x21 local.set — stash the index
  fbLocalSet(wrapSlot)           // 0x21 local.set — stash the wrapper ref
  fbLocalGet(wrapSlot)
  fbStructGet(lTy, 0)            // field 0: backing
  fbLocalGet(listIdxScratchBase)
  fbI32Const(-1)                 // the out-of-range replacement index
  fbLocalGet(listIdxScratchBase)
  fbLocalGet(wrapSlot)
  fbStructGet(lTy, 1)            // field 1: len
  fbI32Bin(73)                   // 0x49 i32.lt_u
  wU8(27)                        // 0x1b select → i if in-bounds else -1
  0
}

// The hoisted twin of `emitListIdxGuard`, for an access whose receiver is a binding
// with a live cached header: the backing ref and `len` are already in locals, so the
// receiver is never (re-)emitted and the stack holds only the index. Leaves the same
// [backing, safeIndex] pair; the bounds check is not weakened — same `len`, read once.
function emitListIdxGuardHoisted(row: i32) {
  fbLocalSet(listIdxScratchBase) // 0x21 local.set — stash the index
  fbLocalGet(lhBack[row])        // the cached backing (was `struct.get` field 0)
  fbLocalGet(listIdxScratchBase)
  fbI32Const(-1)                 // the out-of-range replacement index
  fbLocalGet(listIdxScratchBase)
  fbLocalGet(lhLen[row])         // the cached len (was `struct.get` field 1)
  fbI32Bin(73)                   // 0x49 i32.lt_u
  wU8(27)                        // 0x1b select → i if in-bounds else -1
  0
}

// The live hoist row for an index receiver, or -1: the receiver must be a bare
// identifier matching the row's binding, the row must be live, and its rep must match
// the arm asking. The rep check is the backstop that makes a classifier disagreement
// between the prologue and the access decline, rather than read a wrongly-typed local.
function liveHoistRow(exprIx: i32, kind: MfKind, slot: i32) {
  if exprIx < 0 { return 0 - 1 }
  const e = P.nodes[exprIx]
  if e is Ident {
    let k = 0
    while k < lhName.length {
      if (
        lhLive[k] > 0 &&
        lhName[k] == e.identName &&
        lhKind[k] == kind &&
        lhSlot[k] == slot
      ) {
        return k
      }
      k = k + 1
    }
  }
  0 - 1
}

// Find (or mint) the hoist row for `name` at list rep (`kind`, `slot`). Minting
// takes two slots of the lazy list frame — the backing ref (`liBack` 3, typed as
// this kind's backing array) and the i32 `len` (`liBack` 4).
function listHoistRow(name: string, kind: MfKind, slot: i32) {
  let k = 0
  while k < lhName.length {
    if lhName[k] == name && lhKind[k] == kind && lhSlot[k] == slot { return k }
    k = k + 1
  }
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(3)
  const bSlot = listIdxScratchBase + liKinds.length
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(4)
  const lSlot = listIdxScratchBase + liKinds.length
  lhName.push(name)
  lhKind.push(kind)
  lhSlot.push(slot)
  lhBack.push(bSlot)
  lhLen.push(lSlot)
  lhStart.push(0 - 1) // a list header has no `start`
  lhLive.push(0)
  lhName.length - 1
}

// A raw-string row is keyed (kind "i32", slot -1) — distinct from the i32-LIST rows, which
// are (kind "i32", slot 0), so the two can never be confused by `liveHoistRow`'s rep check.
// `hoistRowIsStr` reads the same pair.
function hoistRowIsStr(row: i32) { lhKind[row] == "i32" && lhSlot[row] < 0 }

// Find (or mint) the hoist row for raw string binding `name`, minting three slots of the
// lazy list frame (backing ref, `start`, `len`). Safe because the header is loop-invariant
// by construction — strings are immutable and there is no string element store — so only a
// rebinding of the name can invalidate the cache, which `blockReboundsName` already refuses.
function strHoistRow(name: string) {
  let k = 0
  while k < lhName.length {
    if lhName[k] == name && hoistRowIsStr(k) { return k }
    k = k + 1
  }
  liKinds.push("i32")
  liSlots.push(0)
  liBack.push(5)
  const sbSlot = listIdxScratchBase + liKinds.length
  liKinds.push("i32")
  liSlots.push(0)
  liBack.push(4)
  const stSlot = listIdxScratchBase + liKinds.length
  liKinds.push("i32")
  liSlots.push(0)
  liBack.push(4)
  const slSlot = listIdxScratchBase + liKinds.length
  lhName.push(name)
  lhKind.push("i32")
  lhSlot.push(0 - 1)
  lhBack.push(sbSlot)
  lhLen.push(slSlot)
  lhStart.push(stSlot)
  lhLive.push(0)
  lhName.length - 1
}

// Mint a fresh lazy-list-frame slot typed as list kind `kind`'s backing array — the same
// `liBack` 1 typing a chunked literal's destination, without emitting anything. Fresh and
// never deduped: a caller holds its backing live across a whole loop, so two callers
// sharing one slot would clobber each other's backing.
function listBackStashSlot(kind: MfKind, slot: i32) {
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(1)
  listIdxScratchBase + liKinds.length
}

// The string-header stash slot (`liBack == 6`, `(ref null $sTypeIdx)`), deduped per
// function since every `s[i]` / `s.charCodeAt(i)` shares it safely — the receiver
// stashes only after both it and the index are fully evaluated, so a nested string
// index has already passed through; it rides the lazy frame, so `emitStrCharCode` needs no `exprHasStrOp` arm.
function strHdrSlot() {
  let k = 0
  while k < liKinds.length {
    if liBack[k] == 6 { return listIdxScratchBase + 1 + k }
    k = k + 1
  }
  liKinds.push("i32")
  liSlots.push(0)
  liBack.push(6)
  listIdxScratchBase + liKinds.length
}

// Lower the bounds guard of a raw-string `s[i]` read: stack holds [string, index] on
// entry, leaves [backing, offset] where `offset` is `start + i` when `i u< len` and `-1`
// otherwise, so the read traps rather than silently returning a sibling view's character
// (the backing is longer than the view). The select is over the offset, not the raw index.
function emitStrIdxGuard() {
  const hs = strHdrSlot()
  fbLocalSet(listIdxScratchBase) // 0x21 local.set — stash the index
  fbLocalSet(hs)                 // 0x21 local.set — stash the string header
  fbLocalGet(hs)
  fbStrBack()                    // field 0: backing
  fbLocalGet(hs)
  fbStrStart()                   // field 1: start
  fbLocalGet(listIdxScratchBase)
  fbI32Bin(106)                  // 0x6a i32.add → start + i   [a]
  fbI32Const(-1)                 // the out-of-range replacement offset  [b]
  fbLocalGet(listIdxScratchBase)
  fbLocalGet(hs)
  fbStrLen()                     // field 2: len
  fbI32Bin(73)                   // 0x49 i32.lt_u (covers negative + past-len)
  wU8(27)                        // 0x1b select → start+i if in-bounds else -1
  0
}

// Mint a FRESH `(ref null $sBackIdx)` lazy-frame slot — the same `liBack` 5 typing a chunked
// string literal's destination gets, without emitting anything. Fresh and never deduped: the
// caller holds the backing live across a whole loop, so two nested `for cp in s` loops
// sharing one slot would clobber the outer one's backing with the inner one's.
function strBackSlot() {
  liKinds.push("i32")
  liSlots.push(0)
  liBack.push(5)
  listIdxScratchBase + liKinds.length
}

// Mint a FRESH i32 lazy-frame slot (`liBack` 4, the same code a hoisted list `len` uses).
// Fresh for the same reason `strBackSlot` is.
function strI32Slot() {
  liKinds.push("i32")
  liSlots.push(0)
  liBack.push(4)
  listIdxScratchBase + liKinds.length
}

// The hoisted twin of `emitStrIdxGuard`, for a `s[i]` whose receiver is a binding with a
// live cached header: backing / start / len are already in locals, so the receiver is
// never emitted and the stack holds only the index. Leaves the same [backing, offset]
// pair; the bounds check is not weakened — same `len`, read once before the loop.
function emitStrIdxGuardHoisted(row: i32) {
  fbLocalSet(listIdxScratchBase) // 0x21 local.set — stash the index
  fbLocalGet(lhBack[row])        // the cached backing (was `struct.get` field 0)
  fbLocalGet(lhStart[row])       // the cached start   (was `struct.get` field 1)
  fbLocalGet(listIdxScratchBase)
  fbI32Bin(106)                  // 0x6a i32.add → start + i   [a]
  fbI32Const(-1)                 // the out-of-range replacement offset  [b]
  fbLocalGet(listIdxScratchBase)
  fbLocalGet(lhLen[row])         // the cached len     (was `struct.get` field 2)
  fbI32Bin(73)                   // 0x49 i32.lt_u
  wU8(27)                        // 0x1b select
  0
}

// A fresh element-value slot of the lazy list frame — `(ref null $rlElemHeap[slot])` for
// the "ref" kind. The non-deduping twin of `listIdxValSlot` below: the struct-element
// compare needs two live slots of one type at once (the left element and the right one),
// so a shared slot would compare a value against itself.
function listElemStashSlot(kind: MfKind, slot: i32) {
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(2)
  listIdxScratchBase + liKinds.length
}

// The indexed-store value stash slot for list kind `kind` (`slot` the ref-list table slot
// for kind "ref", else 0) — a `liBack == 2` entry typed as the element value. The value
// parks here across `emitListIdxGuard` so the backing and len resolve after its user code
// runs; no user code runs between the stash and the `array.set`, so sharing is clobber-safe.
function listIdxValSlot(kind: MfKind, slot: i32) {
  let k = 0
  while k < liKinds.length {
    if liKinds[k] == kind && liSlots[k] == slot && liBack[k] == 2 {
      return listIdxScratchBase + 1 + k
    }
    k = k + 1
  }
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(2)
  listIdxScratchBase + liKinds.length
}

// True when the call at `callIx` lowers to linear-memory instructions and nothing else:
// a bare-identifier callee, unshadowed here, in the load/store/bulk/size families. No GC
// object is reachable from such a call — every operand is a number and the lowering is one
// instruction — so no list's `backing`/`len` can move across it. Every other call declines.
function hoistSafeMemCall(callIx: i32, fnIx: i32): boolean {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Ident {
      const nm = callee.identName
      if identNameIsUserBound(nm, fnIx) { return false }
      if nm == "__store_i32__" { return true }
      if nm == "__load_i32__" { return true }
      if nm == "__memory_size__" { return true }
      if nm == "__memory_grow__" { return true }
      if nameIsMemStoreIntrinsic(nm) { return true }
      if nameIsMemLoadIntrinsic(nm) { return true }
      return nameIsMemBulkIntrinsic(nm)
    }
  }
  false
}

// The soundness condition for list-header hoisting: across a loop body that cannot
// reallocate a list, its backing ref and `len` are loop-invariant, so hoisting reads them
// once before the loop instead of per access. Declines on a rebinding, a nullable receiver,
// and every call but `hoistSafeMemCall`'s — any other may reallocate through a param.
function hoistSafeExpr(ix: i32, fnIx: i32): boolean {
  if ix < 0 { return true }
  const e = P.nodes[ix]
  if e is NumLit { return true }
  if e is StrLit { return true }
  if e is CharLit { return true }
  if e is BoolLit { return true }
  if e is NullLit { return true }
  if e is Ident { return true }
  if e is Unary { return hoistSafeExpr(e.unArg, fnIx) }
  if e is Paren { return hoistSafeExpr(e.parInner, fnIx) }
  if e is IsExpr { return hoistSafeExpr(e.isObj, fnIx) }
  if e is AsExpr { return hoistSafeExpr(e.asObj, fnIx) }
  if e is Member { return hoistSafeExpr(e.memObj, fnIx) }
  if e is Index {
    if !hoistSafeExpr(e.idxArr, fnIx) { return false }
    return hoistSafeExpr(e.idxIndex, fnIx)
  }
  if e is BinExpr {
    if !hoistSafeExpr(e.binLeft, fnIx) { return false }
    return hoistSafeExpr(e.binRight, fnIx)
  }
  if e is Call {
    if !hoistSafeMemCall(ix, fnIx) { return false }
    const args = e.callArgs
    let a = 0
    while a < args.length {
      if !hoistSafeExpr(args[a], fnIx) { return false }
      a = a + 1
    }
    return true
  }
  false
}

// The statement half of the whitelist. The fall-through hands an unrecognised
// statement to the EXPRESSION walk (a bare expression statement is how an
// assignment and a call both appear), which declines anything it does not know.
function hoistSafeStmt(ix: i32, fnIx: i32): boolean {
  if ix < 0 { return true }
  const s = P.nodes[ix]
  if s is LetDecl { return hoistSafeExpr(s.letInit, fnIx) }
  if s is RetStmt { return hoistSafeExpr(s.retArg, fnIx) }
  if s is BreakStmt { return true }
  if s is ContinueStmt { return true }
  if s is Block { return hoistSafeBlock(ix, fnIx) }
  if s is IfStmt {
    if !hoistSafeExpr(s.ifCond, fnIx) { return false }
    if !hoistSafeStmt(s.ifThen, fnIx) { return false }
    return hoistSafeStmt(s.ifElse, fnIx)
  }
  if s is WhileStmt {
    if !hoistSafeExpr(s.whileCond, fnIx) { return false }
    return hoistSafeStmt(s.whileBody, fnIx)
  }
  if s is ForRange {
    if !hoistSafeExpr(s.frFrom, fnIx) { return false }
    if !hoistSafeExpr(s.frTo, fnIx) { return false }
    if !hoistSafeExpr(s.frStep, fnIx) { return false }
    return hoistSafeStmt(s.frBody, fnIx)
  }
  if s is ForIn {
    if !hoistSafeExpr(s.fiIter, fnIx) { return false }
    return hoistSafeStmt(s.fiBody, fnIx)
  }
  hoistSafeExpr(ix, fnIx)
}

function hoistSafeBlock(ix: i32, fnIx: i32): boolean {
  if ix < 0 { return false }
  const b = P.nodes[ix]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      if !hoistSafeStmt(stmts[i], fnIx) { return false }
      i = i + 1
    }
    return true
  }
  false
}

// True when `name` is REBOUND anywhere in the expression at `ix` — only an
// `name = …` assignment can do that in an expression. Runs over an already
// whitelisted body, so the enumeration matches `hoistSafeExpr`'s exactly.
function exprReboundsName(ix: i32, name: string): boolean {
  if ix < 0 { return false }
  const e = P.nodes[ix]
  if e is BinExpr {
    if e.binOp == "=" {
      const lhs = P.nodes[e.binLeft]
      if lhs is Ident {
        if lhs.identName == name { return true }
      }
    }
    if exprReboundsName(e.binLeft, name) { return true }
    return exprReboundsName(e.binRight, name)
  }
  if e is Unary { return exprReboundsName(e.unArg, name) }
  if e is Paren { return exprReboundsName(e.parInner, name) }
  if e is IsExpr { return exprReboundsName(e.isObj, name) }
  if e is AsExpr { return exprReboundsName(e.asObj, name) }
  if e is Member { return exprReboundsName(e.memObj, name) }
  if e is Index {
    if exprReboundsName(e.idxArr, name) { return true }
    return exprReboundsName(e.idxIndex, name)
  }
  if e is Call {
    if exprReboundsName(e.callFn, name) { return true }
    const args = e.callArgs
    let a = 0
    while a < args.length {
      if exprReboundsName(args[a], name) { return true }
      a = a + 1
    }
  }
  false
}

// True when `name` is REBOUND anywhere in the statement at `ix`: a `let`/`const`
// that shadows it, a loop variable that takes the spelling, or an assignment to
// it. Any of the three means the body's `name` is not the wrapper the prologue
// cached.
function stmtReboundsName(ix: i32, name: string): boolean {
  if ix < 0 { return false }
  const s = P.nodes[ix]
  if s is LetDecl {
    if s.letName == name { return true }
    return exprReboundsName(s.letInit, name)
  }
  if s is RetStmt { return exprReboundsName(s.retArg, name) }
  if s is BreakStmt { return false }
  if s is ContinueStmt { return false }
  if s is Block { return blockReboundsName(ix, name) }
  if s is IfStmt {
    if exprReboundsName(s.ifCond, name) { return true }
    if stmtReboundsName(s.ifThen, name) { return true }
    return stmtReboundsName(s.ifElse, name)
  }
  if s is WhileStmt {
    if exprReboundsName(s.whileCond, name) { return true }
    return stmtReboundsName(s.whileBody, name)
  }
  if s is ForRange {
    if s.frVar == name { return true }
    if exprReboundsName(s.frFrom, name) { return true }
    if exprReboundsName(s.frTo, name) { return true }
    if exprReboundsName(s.frStep, name) { return true }
    return stmtReboundsName(s.frBody, name)
  }
  if s is ForIn {
    if s.fiVar == name { return true }
    if exprReboundsName(s.fiIter, name) { return true }
    return stmtReboundsName(s.fiBody, name)
  }
  exprReboundsName(ix, name)
}

function blockReboundsName(ix: i32, name: string): boolean {
  if ix < 0 { return false }
  const b = P.nodes[ix]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      if stmtReboundsName(stmts[i], name) { return true }
      i = i + 1
    }
  }
  false
}

// Record one index receiver identifier and the `Index` node it is first seen on. The
// representative node is what the rep classifiers are asked about later, so the first
// sighting is kept — every later sighting of the same spelling in this body names the
// same binding (the caller has already established the body does not rebind it).
function hoistScanAdd(name: string, idxIx: i32) {
  let i = 0
  while i < lhScanName.length {
    if lhScanName[i] == name { return 0 }
    i = i + 1
  }
  lhScanName.push(name)
  lhScanRep.push(idxIx)
  0
}

function hoistScanExpr(ix: i32) {
  if ix < 0 { return 0 }
  const e = P.nodes[ix]
  if e is Index {
    const recv = P.nodes[e.idxArr]
    if recv is Ident { hoistScanAdd(recv.identName, ix) }
    hoistScanExpr(e.idxArr)
    hoistScanExpr(e.idxIndex)
    return 0
  }
  if e is Unary { return hoistScanExpr(e.unArg) }
  if e is Paren { return hoistScanExpr(e.parInner) }
  if e is IsExpr { return hoistScanExpr(e.isObj) }
  if e is AsExpr { return hoistScanExpr(e.asObj) }
  if e is Member { return hoistScanExpr(e.memObj) }
  if e is BinExpr {
    hoistScanExpr(e.binLeft)
    return hoistScanExpr(e.binRight)
  }
  if e is Call {
    hoistScanExpr(e.callFn)
    const args = e.callArgs
    let a = 0
    while a < args.length {
      hoistScanExpr(args[a])
      a = a + 1
    }
  }
  0
}

function hoistScanStmt(ix: i32) {
  if ix < 0 { return 0 }
  const s = P.nodes[ix]
  if s is LetDecl { return hoistScanExpr(s.letInit) }
  if s is RetStmt { return hoistScanExpr(s.retArg) }
  if s is Block { return hoistScanBlock(ix) }
  if s is IfStmt {
    hoistScanExpr(s.ifCond)
    hoistScanStmt(s.ifThen)
    return hoistScanStmt(s.ifElse)
  }
  if s is WhileStmt {
    hoistScanExpr(s.whileCond)
    return hoistScanStmt(s.whileBody)
  }
  if s is ForRange {
    hoistScanExpr(s.frFrom)
    hoistScanExpr(s.frTo)
    hoistScanExpr(s.frStep)
    return hoistScanStmt(s.frBody)
  }
  if s is ForIn {
    hoistScanExpr(s.fiIter)
    return hoistScanStmt(s.fiBody)
  }
  hoistScanExpr(ix)
}

function hoistScanBlock(ix: i32) {
  if ix < 0 { return 0 }
  const b = P.nodes[ix]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      hoistScanStmt(stmts[i])
      i = i + 1
    }
  }
  0
}

// Resolve the list rep of an index receiver into a hoist row, or -1 when this receiver
// is not one of the reps the guard hoists. The cascade mirrors `emitIndex`'s own order,
// so a row is only minted for a rep whose access path the hoisted guard can actually
// serve; the nullable arms, checked first exactly as there, decline.
function hoistRowOfRecv(recvIx: i32, name: string, fnIx: i32) {
  if exprNulScalarListKind(recvIx, fnIx) != null { return 0 - 1 }
  // The shared-backing nullable lists (`i32[] | null`, `boolean[] | null`) must also
  // decline here — `exprNulScalarListKind` above only names the four leaves with a
  // wrapper heap type, so these would otherwise read the header above the null guard,
  // and in a loop condition hoist `struct.get` in front of `ref.is_null`: trapping on a null.
  if exprNullableList(recvIx, fnIx) { return 0 - 1 }
  if exprRefArray(recvIx, fnIx) {
    if exprNullableRefArray(recvIx, fnIx) { return 0 - 1 }
    if !raUsed { return 0 - 1 }
    return listHoistRow(name, "ref", refListSlotOfExpr(recvIx, fnIx))
  }
  if exprNulStrArray(recvIx, fnIx) || exprStringArray(recvIx, fnIx) {
    if !slUsed { return 0 - 1 }
    return listHoistRow(name, "str", 0)
  }
  const ek = scalarListElemKind(recvIx, fnIx)
  if ek != null {
    if !scalarListUsed(ek) { return 0 - 1 }
    return listHoistRow(name, listIdxKindOf(ek), 0)
  }
  // A raw string receiver is checked last, after every list rep, so `exprString` never
  // gets a chance to answer for one. The `| null` niche declines too, for the same reason
  // `exprNullableList` does: the prologue would read the header above the null guard and
  // trap on a null receiver. `exprNullableString` is strictly wider than `exprString`.
  if exprString(recvIx, fnIx) {
    if !aUsed { return 0 - 1 }
    if exprNullableString(recvIx, fnIx) { return 0 - 1 }
    return strHoistRow(name)
  }
  0 - 1
}

// The wrapper struct type index a row's header is read out of — the mirror of
// `hoistRowOfRecv`'s rep decision, and the type the prologue's two `struct.get`s
// carry.
function hoistWrapTyOfRow(row: i32) {
  const k = lhKind[row]
  if k == "ref" { return rlWrapIdx[lhSlot[row]] }
  if k == "str" { return mkListIdx }
  if k == "f64" { return scalarListWrap("f64") }
  if k == "i64" { return scalarListWrap("i64") }
  if k == "f32" { return scalarListWrap("f32") }
  // The PACKED byte list's frame kind is `"u8"` (`listIdxKindOf`), and its wrapper is
  // `$bl8TypeIdx` — the i32 fall-through below would name the 4-byte list's wrapper for a
  // row whose local is typed `(ref null $bl8TypeIdx)`.
  if k == "u8" { return scalarListWrap("u8list") }
  scalarListWrap("i32")
}

// Open the hoists for one loop: scan its body, and for every index receiver that survives
// the soundness conditions, read its header into the row's two locals. Returns the count
// of rows opened (the `loopHoistClose` argument), or -1 on prologue failure. `condIx`, the
// loop's per-iteration condition, is held to the body's own hoist-safety standard — a `while f()` re-runs `f` every iteration.
function loopHoistOpen(
  body: i32[],
  condIx: i32,
  bodyIx: i32,
  fnIx: i32,
  ownVar: string,
) {
  if !hoistSafeExpr(condIx, fnIx) { return 0 }
  if !hoistSafeBlock(bodyIx, fnIx) { return 0 }
  lhScanName = []
  lhScanRep = []
  hoistScanExpr(condIx)
  hoistScanBlock(bodyIx)
  let opened = 0
  let i = 0
  while i < lhScanName.length {
    const nm = lhScanName[i]
    let ok = nm != ownVar
    if ok && exprReboundsName(condIx, nm) { ok = false }
    if ok && blockReboundsName(bodyIx, nm) { ok = false }
    if ok {
      const rep = P.nodes[lhScanRep[i]]
      if rep is Index {
        const row = hoistRowOfRecv(rep.idxArr, nm, fnIx)
        if row >= 0 && lhLive[row] == 0 {
          const savedHF32 = pendingF32
          pendingF32 = false
          if hoistRowIsStr(row) {
            // A raw string's header is `{backing, start, len}` — three reads, because a
            // view's element offset is `start + i` and its bound is `len`, neither
            // recoverable from the other. The list arm below reads two; keeping both
            // spellings in one `if` (rather than a second `loopHoistOpen`) stops them drifting.
            if emitExpr(body, rep.idxArr, fnIx) < 0 { return 0 - 1 }
            fbStrBack()
            fbLocalSet(lhBack[row])
            if emitExpr(body, rep.idxArr, fnIx) < 0 { return 0 - 1 }
            fbStrStart()
            fbLocalSet(lhStart[row])
            if emitExpr(body, rep.idxArr, fnIx) < 0 { return 0 - 1 }
            fbStrLen()
            fbLocalSet(lhLen[row])
          } else {
            const wrapTy = hoistWrapTyOfRow(row)
            if emitExpr(body, rep.idxArr, fnIx) < 0 { return 0 - 1 }
            fbStructGet(wrapTy, 0) // field 0: backing
            fbLocalSet(lhBack[row])
            if emitExpr(body, rep.idxArr, fnIx) < 0 { return 0 - 1 }
            fbStructGet(wrapTy, 1) // field 1: len
            fbLocalSet(lhLen[row])
          }
          pendingF32 = savedHF32
          lhLive[row] = 1
          lhOpen.push(row)
          opened = opened + 1
        }
      }
    }
    i = i + 1
  }
  opened
}

// Close the `n` rows this loop opened, innermost first.
function loopHoistClose(n: i32) {
  let i = 0
  while i < n {
    const row = lhOpen[lhOpen.length - 1]
    lhOpen.pop()
    lhLive[row] = 0
    i = i + 1
  }
  0
}

function emitIndex(body: i32[], idxIx: i32, fnIx: i32) {
  const nd = P.nodes[idxIx]
  if nd is Index {
    // A DISTINCT-backing nullable scalar list `t[i]` (narrowed inside `if t != null`): the slot is
    // `(ref null $wrapper)`, so recover non-null (the guard proved it present) then read as the leaf
    // list. Checked FIRST — the plain classifiers below do not see through the `| null`.
    const nsk = exprNulScalarListKind(nd.idxArr, fnIx)
    if nsk != null {
      if emitExpr(body, nd.idxArr, fnIx) < 0 { return -1 }
      wU8(212) // 0xd4 ref.as_non_null (the `!= null` guard makes this safe)
      const savedNslF32 = pendingF32
      pendingF32 = false
      if emitExpr(body, nd.idxIndex, fnIx) < 0 { return -1 }
      pendingF32 = savedNslF32
      if nsk == "nulstrlist" {
        emitListIdxGuard(listIdxWrapSlot("str", 0), mkListIdx)
        fbArrayGet(mkArrIdx) // 0xfb 0x0b string backing
        // A nullable-element inner list (`(string | null)[] | null`, narrowed): the
        // element legitimately holds null, so the read stays `(ref null $aTypeIdx)` — an
        // unconditional non-null recover here is correct only for `string[] | null` (whose
        // elements are never null), and traps otherwise. `exprNulStrArray` resolves this.
        if exprNulStrArray(nd.idxArr, fnIx) { return 0 }
        wU8(212) // 0xd4 ref.as_non_null (non-null string element)
        return 0
      }
      // `nek` names the leaf element kind whose wrapper / backing / index-scratch pool this
      // read uses; `u8list` is the packed-byte leaf's spelling (the element is a plain i32,
      // so the kind names the list, not a scalar). Without this arm a `u8[] | null` read fell
      // to the `f64` default and read whatever heap index the offset formula left there — check-clean invalid wasm.
      let nek: VKind = "f64"
      if nsk == "nuli64list" { nek = "i64" }
      if nsk == "nulf32list" { nek = "f32" }
      if nsk == "nulu8list" { nek = "u8list" }
      emitListIdxGuard(
        listIdxWrapSlot(listIdxKindOf(nek), 0),
        scalarListWrap(nek),
      )
      fbArrayGet(scalarListBack(nek)) // yields the element in its rep
      return 0
    }
    // A REF list `xs[i]` → unwrap to its `(ref null $elem)` backing, `array.get`, then
    // `ref.as_non_null` (`0xd4`) to surface the non-null element (a struct ref / union
    // box) — slots in `[0,len)` are always populated, so the cast never traps. (Checked
    // BEFORE the `aUsed` guard: a pure ref-list program uses no i32 array.)
    if exprRefArray(nd.idxArr, fnIx) {
      if !raUsed {
        return emitFail(
          "emitProgram: ref index access but ref array type not collected",
        )
      }
      const rslot = refListSlotOfExpr(nd.idxArr, fnIx)
      // A live hoist row serves this access's header from locals, so the
      // RECEIVER is not emitted at all — the prologue before the loop read it
      // once. Only the index goes on the stack.
      const rlHz = liveHoistRow(nd.idxArr, "ref", rslot)
      if rlHz < 0 {
        if emitExpr(body, nd.idxArr, fnIx) < 0 { return -1 }
        // A NULLABLE ref-array receiver (`t: i32[][] | null`, kind 18, narrowed) reads `(ref null …)` —
        // recover non-null before `struct.get` (the `if t != null` guard makes this safe).
        if exprNullableRefArray(nd.idxArr, fnIx) {
          wU8(212) // 0xd4 ref.as_non_null
        }
      }
      // The index is always i32 — every index arm here clears `pendingF32` around it, else
      // a bare index literal emits as `f32.const`. This matters for an inner read `g[i][j]`
      // over an `f32[][]`: the outer f32 read leaves `pendingF32` set while emitting this
      // receiver, so the inner `[j]` would otherwise inherit a context that is not its own.
      const savedRlIxF32 = pendingF32
      pendingF32 = false
      if emitExpr(body, nd.idxIndex, fnIx) < 0 { return -1 }
      pendingF32 = savedRlIxF32
      // Guard `i u< len`, unwrap to the backing (`struct.get` field 0), read.
      if rlHz >= 0 {
        emitListIdxGuardHoisted(rlHz)
      } else {
        emitListIdxGuard(listIdxWrapSlot("ref", rslot), rlWrapIdx[rslot])
      }
      fbArrayGet(rlBackIdx[rslot]) // 0xfb 0x0b <this slot's ref backing array>
      // A nullable-niche element legitimately holds null, so the read stays `(ref null
      // $elem)` with no `ref.as_non_null` recover (the caller narrows with `e != null`).
      // `listElemStaysNullable` is the shared answer — `.map`/`.filter`'s element step asks
      // it too, and answering it differently in the two places is a recover that traps in one.
      if listElemStaysNullable(nd.idxArr, fnIx) {
        // …UNLESS the index PLACE itself is narrowed non-null (D451). The niche half of the
        // channel: nothing to unbox, but the value must stop being `(ref null …)` or it
        // reaches a `(ref …)` consumer as one. The guard is what makes the recovery safe,
        // exactly as the kind-18 receiver recovery twenty lines above is.
        if indexPlaceNonNull(idxIx) {
          wU8(212) // 0xd4 ref.as_non_null
        }
        return 0
      }
      wU8(212) // 0xd4 ref.as_non_null (recover the non-null element)
      // A union-box cell whose index place is narrowed to one scalar atom unboxes here
      // (D451): without it `vl check` proves `xs[0]` non-null and every classifier calls it
      // an `i32`, but this arm still leaves the raw `(ref $uBox)` for an unboxed consumer —
      // invalid wasm. Routed through the shared `emitUnionUnboxTail`, not an open-coded unbox.
      const iCon = emitPlaceNarrowContainerUnbox(idxIx, fnIx)
      if iCon != 0 { return iCon - 1 }
      const iuAtom = narrowedValueAtomOf(indexPathKeyOf(idxIx))
      if iuAtom != "" {
        if indexElemUnionName(idxIx, fnIx) != "" {
          const iuk = valueAtomKind(iuAtom)
          if iuk >= 0 && iuk != nullValKind() { return emitUnionUnboxTail(iuk) }
        }
      }
      return 0
    }
    // A `(string | null)[]` `xs[i]` → the SAME string backing, but the element legitimately holds
    // `null` (it is a `(ref null $aTypeIdx)`), so the read STAYS nullable — NO `ref.as_non_null`. The
    // bound value is a `nulstr` the caller narrows with `!= null` (`nodeTyIsNulString` classifies it).
    // Checked BEFORE `exprStringArray` (whose non-null recovery would trap on a null element).
    if exprNulStrArray(nd.idxArr, fnIx) {
      if !slUsed {
        return emitFail(
          "emitProgram: string index access but string list type not collected",
        )
      }
      const nsHz = liveHoistRow(nd.idxArr, "str", 0)
      if nsHz < 0 {
        if emitExpr(body, nd.idxArr, fnIx) < 0 { return -1 }
      }
      if emitExpr(body, nd.idxIndex, fnIx) < 0 { return -1 }
      if nsHz >= 0 {
        emitListIdxGuardHoisted(nsHz)
      } else {
        emitListIdxGuard(listIdxWrapSlot("str", 0), mkListIdx)
      }
      fbArrayGet(mkArrIdx) // 0xfb 0x0b <string backing> — kept `(ref null $sTypeIdx)` (nullable)
      // A narrowed index PLACE recovers non-null here for the same reason the ref-list arm
      // above does — this is the `(new string | null)[]` rep, eight of D451's 56 cells, and
      // the one the row's "box rather than a niche" mechanism mis-classified.
      if indexPlaceNonNull(idxIx) {
        wU8(212) // 0xd4 ref.as_non_null
      }
      return 0
    }
    // A STRING list `xs[i]` → unwrap to its `(ref null $sTypeIdx)` string backing,
    // `array.get $mkArrIdx`, then `ref.as_non_null` to surface the non-null string ref.
    // (Checked before the i32 path: a string element is not an i32.)
    if exprStringArray(nd.idxArr, fnIx) {
      if !slUsed {
        return emitFail(
          "emitProgram: string index access but string list type not collected",
        )
      }
      const slHz = liveHoistRow(nd.idxArr, "str", 0)
      if slHz < 0 {
        if emitExpr(body, nd.idxArr, fnIx) < 0 { return -1 }
      }
      if emitExpr(body, nd.idxIndex, fnIx) < 0 { return -1 }
      // Guard `i u< len`, unwrap to the backing (`struct.get` field 0), read.
      if slHz >= 0 {
        emitListIdxGuardHoisted(slHz)
      } else {
        emitListIdxGuard(listIdxWrapSlot("str", 0), mkListIdx)
      }
      fbArrayGet(mkArrIdx) // 0xfb 0x0b <string backing array type index>
      wU8(212)             // 0xd4 ref.as_non_null (recover the non-null string)
      return 0
    }
    // A SCALAR list `xs[i]` → unwrap to its backing, `array.get <back>` — yielding the
    // element in its valtype rep (i32 / f64 / i64). One descriptor path over all scalar
    // element kinds (f64/i64 checked before i32 since their elements are not i32).
    const ek = scalarListElemKind(nd.idxArr, fnIx)
    if ek != null {
      if !scalarListUsed(ek) {
        return emitFail("emitProgram: index access but list type not collected")
      }
      const skHz = liveHoistRow(nd.idxArr, listIdxKindOf(ek), 0)
      if skHz < 0 {
        if emitExpr(body, nd.idxArr, fnIx) < 0 { return -1 }
      }
      // The index is always i32 (see the ref-array arm above).
      const savedIxF32 = pendingF32
      pendingF32 = false
      if emitExpr(body, nd.idxIndex, fnIx) < 0 { return -1 }
      pendingF32 = savedIxF32
      // Guard `i u< len`, unwrap to the backing (`struct.get` field 0), read.
      if skHz >= 0 {
        emitListIdxGuardHoisted(skHz)
      } else {
        emitListIdxGuard(
          listIdxWrapSlot(listIdxKindOf(ek), 0),
          scalarListWrap(ek),
        )
      }
      fbArrayGet(scalarListBack(ek)) // yields the element in its rep
      return 0
    }
    if !aUsed {
      return emitFail("emitProgram: index access but array type not collected")
    }
    if !exprString(nd.idxArr, fnIx) {
      return emitFail("emitProgram: index receiver is not an array or string")
    }
    // A raw string `s[i]` — the receiver is a header, so the read is `backing[start + i]`
    // behind the `i u< len` guard that keeps an out-of-range index trapping instead of
    // reading past the view into the rest of the backing. A binding with a live
    // loop-hoisted header skips the receiver entirely and reads three locals.
    const shz = liveHoistRow(nd.idxArr, "i32", 0 - 1)
    if shz < 0 {
      if emitExpr(body, nd.idxArr, fnIx) < 0 { return -1 }
    }
    if emitExpr(body, nd.idxIndex, fnIx) < 0 { return -1 }
    if shz >= 0 { emitStrIdxGuardHoisted(shz) } else { emitStrIdxGuard() }
    fbArrayGet(sBackIdx) // 0xfb 0x0b <string backing array type index>
    return 0
  }
  emitFail("emitProgram: expected an index access")
}

// Lower a `.length` onto `body`: a list's length is its wrapper's `len` field (not the
// backing's physical length, which is `cap`) via `struct.get <wrap> 1`; a raw string's
// `.length` is its header's `len` field (`fbStrLen()`), not `array.len` — which would
// report the parent's length for a view. Each element kind is resolved below in its own arm.
function emitArrLen(body: i32[], memIx: i32, fnIx: i32) {
  const m = P.nodes[memIx]
  if m is Member {
    // A REF list's `.length` is its wrapper's `len` field (`struct.get $wrap 1`).
    if exprRefArray(m.memObj, fnIx) {
      const rslot = refListSlotOfExpr(m.memObj, fnIx)
      if emitExpr(body, m.memObj, fnIx) < 0 { return -1 }
      fbStructGet(rlWrapIdx[rslot], 1) // 0xfb 0x02 <ref-list wrapper> field 1: len
      return 0
    }
    // A STRING list's `.length` is its wrapper's `len` field (`struct.get $mkListIdx 1`).
    if exprStringArray(m.memObj, fnIx) {
      if emitExpr(body, m.memObj, fnIx) < 0 { return -1 }
      fbStructGet(mkListIdx, 1) // 0xfb 0x02 <string-list wrapper> field 1: len
      return 0
    }
    // A SCALAR list's `.length` is its wrapper's `len` field (`struct.get <wrap> 1`) — an
    // i32, the same shape for every element kind over that kind's wrapper. (f64/i64 before
    // i32 since their elements are not i32.)
    const lek = scalarListElemKind(m.memObj, fnIx)
    if (
      lek != null &&
      (lek == "f64" || lek == "i64" || lek == "f32" || lek == "u8list")
    ) {
      if emitExpr(body, m.memObj, fnIx) < 0 { return -1 }
      fbStructGet(scalarListWrap(lek), 1) // field 1: len
      return 0
    }
    if exprArray(m.memObj, fnIx) {
      if emitExpr(body, m.memObj, fnIx) < 0 { return -1 }
      fbStructGet(lTypeIdx, 1) // 0xfb 0x02 <list wrapper struct type index> field 1: len
      return 0
    }
    // A raw string's `.length` is the header's `len` field (`fbStrLen()`), not `array.len`
    // (the backing's physical length, which would report a parent string's length for a
    // view of it). The arm is spelled out and the fallthrough fails loudly instead of
    // defaulting, since a wrong fallthrough would be invalid wasm or a wrong integer.
    if !exprString(m.memObj, fnIx) {
      return emitFail("emitProgram: .length receiver is not an array or string")
    }
    if emitExpr(body, m.memObj, fnIx) < 0 { return -1 }
    fbStrLen() // 0xfb 0x02 <string header> field 2: len
    return 0
  }
  emitFail("emitProgram: expected a length access")
}

// ── G6: string concatenation / value-equality / slice ────────────────────────
// A string is a `{backing, start, len}` view over a `(array (mut i32))` of code points;
// these lower via the same array machinery `.push` uses, with the header hoisted once
// into the shared string scratch frame — each routine evaluates both operands fully before any scratch `local.set`, which is what makes sharing one frame across nested ops safe.

// `local.get` of string scratch local `n` (0 = header A, 1 = header B, 2 = the Out BACKING —
// Stage 2b re-typed slot 2 from a finished string to the element array under construction).
function pushStrScrRef(_body: i32[], n: i32) {
  fbLocalGet(strScratchBase + n) // 0x20 local.get
  0
}

// `local.get` of i32 scratch temp `n` (0..3 → frame slots +3..+6).
function pushStrScrI(_body: i32[], n: i32) {
  fbLocalGet(strScratchBase + 3 + n) // 0x20 local.get
  0
}

// `local.set` of i32 scratch temp `n`.
function setStrScrI(_body: i32[], n: i32) {
  fbLocalSet(strScratchBase + 3 + n) // 0x21 local.set
  0
}

// ── the string-op frame's hoist half ─────────────────────────────────────────
// A string is a header, so a loop reading `A[i]` per step would pay two `struct.get`s
// (backing, start) per trip; `hoistStrScr` reads them once into the frame's last four
// slots, safe because the header's fields are immutable and no string element store exists.

// Hoist operand `n` (0 = A, 1 = B) — its header must already be in `strScratchBase + n`.
function hoistStrScr(_body: i32[], n: i32) {
  fbLocalGet(strScratchBase + n)
  fbStrBack()
  fbLocalSet(strScratchBase + 7 + n)
  fbLocalGet(strScratchBase + n)
  fbStrStart()
  fbLocalSet(strScratchBase + 9 + n)
  0
}

// Push `[backing_n, start_n]` for a hoisted operand — the caller adds its own index and
// closes with `array.get $sBackIdx`.
function pushStrScrBase(_body: i32[], n: i32) {
  fbLocalGet(strScratchBase + 7 + n)
  fbLocalGet(strScratchBase + 9 + n)
  0
}

// `[.., i] -> [.., backing_n[start_n + i]]` is not expressible (the base has to go under the
// index), so this is the whole read for the common `operand[<i32 temp>]` shape: push the
// hoisted base, push temp `t`, add, read.
function pushStrScrElem(body: i32[], n: i32, t: i32) {
  pushStrScrBase(body, n)
  pushStrScrI(body, t)
  fbI32Bin(106) // 0x6a i32.add — start_n + t
  fbArrayGet(sBackIdx)
  0
}

// Lower a string concatenation `a + b` onto `body`, leaving the new string ref on the
// stack: allocate a fresh `(array i32)` of `len(a) + len(b)`, `array.copy` a's code
// points into `[0, lenA)` and b's into `[lenA, lenA+lenB)`. Both operands are evaluated
// first, then stashed, so a nested string op fully completes before either write.
function emitStrConcat(body: i32[], binIx: i32, fnIx: i32) {
  if !aUsed {
    return emitFail("emitProgram: string concat but array type not collected")
  }
  const e = P.nodes[binIx]
  if e is BinExpr {
    // Three or more parts fuse: `a + b + c + d` is one `+` node per operand pair, so the
    // pairwise lowering would allocate and copy the accumulated prefix once per pair —
    // quadratic, and every string interpolation is such a chain. `strCatParts` flattens
    // the maximal chain and `emitStrCatN` buys it back with one sized allocation and copy.
    const parts: i32[] = []
    strCatParts(binIx, fnIx, parts)
    if parts.length > 2 { return emitStrCatN(body, parts, fnIx) }
    // Eval BOTH operands onto the stack (nested string ops complete here) and call
    // the shared `__str_concat__` helper — the allocate+copy core lives once per
    // module (`emitStrConcatFnCode`). A literal-union atom operand widens to its
    // member string (`emitStrValue`) before the call.
    if emitStrValue(body, e.binLeft, fnIx) < 0 { return -1 }
    if emitStrValue(body, e.binRight, fnIx) < 0 { return -1 }
    fbCall(gHelpStrConcat)
    return 0
  }
  emitFail("emitProgram: expected a string concatenation")
}

// Flatten the maximal string `+` chain rooted at `binIx` into its operand expressions,
// left to right, into `parts`. A node is chain-interior exactly when `exprIsStrConcat`
// claims it — the same predicate that routes `+` here — so the walk and the dispatch
// cannot disagree about where the chain ends. A `Paren` sub-chain keeps its own lowering.
function strCatParts(binIx: i32, fnIx: i32, parts: i32[]) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if exprIsStrConcat(e.binLeft, fnIx) {
      strCatParts(e.binLeft, fnIx, parts)
    } else {
      parts.push(e.binLeft)
    }
    if exprIsStrConcat(e.binRight, fnIx) {
      strCatParts(e.binRight, fnIx, parts)
    } else {
      parts.push(e.binRight)
    }
  }
  0
}

// Part slot `i` of the n-ary concat pool, minted on demand into the lazy list frame
// (`liBack` code 18) and cached for the rest of the function. One pool serves every
// nesting depth: `emitStrCatN` evaluates every part onto the stack before writing a
// single slot, so a nested chain has finished with the pool before the outer chain touches it.
function strCatSlot(i: i32) {
  while strCatSlotIx.length <= i {
    liKinds.push("i32")
    liSlots.push(0)
    liBack.push(18)
    strCatSlotIx.push(listIdxScratchBase + liKinds.length)
  }
  strCatSlotIx[i]
}

// Lower an n-part (n >= 3) string chain: evaluate the parts left to right (each exactly
// once, in source order), sum their lengths, allocate one exact-fit backing, `array.copy`
// each part in at a running offset, and wrap one header. All n values reach the stack
// first and are popped into slots deepest-last (§G6), so no scratch write straddles an operand evaluation.
function emitStrCatN(body: i32[], parts: i32[], fnIx: i32) {
  const n = parts.length
  let i = 0
  while i < n {
    if emitStrValue(body, parts[i], fnIx) < 0 { return -1 }
    i = i + 1
  }
  let j = n - 1
  while j >= 0 {
    fbLocalSet(strCatSlot(j))
    j = j - 1
  }
  fbLocalGet(strCatSlot(0))
  fbStrLen()
  let k = 1
  while k < n {
    fbLocalGet(strCatSlot(k))
    fbStrLen()
    fbI32Bin(106) // i32.add
    k = k + 1
  }
  fbLocalTee(strScratchBase + 3) // strScrI0 = the total length
  fbArrayNewDefault(sBackIdx)
  fbLocalSet(strScratchBase + 2) // strScrOut = the one exact-fit backing
  fbI32Const(0)
  fbLocalSet(strScratchBase + 4) // strScrI1 = the running destination offset
  let m = 0
  while m < n {
    fbLocalGet(strScratchBase + 2)
    fbLocalGet(strScratchBase + 4)
    fbLocalGet(strCatSlot(m))
    fbStrBack()
    fbLocalGet(strCatSlot(m))
    fbStrStart()
    fbLocalGet(strCatSlot(m))
    fbStrLen()
    fbArrayCopy(sBackIdx, sBackIdx)
    if m + 1 < n {
      fbLocalGet(strScratchBase + 4)
      fbLocalGet(strCatSlot(m))
      fbStrLen()
      fbI32Bin(106) // i32.add
      fbLocalSet(strScratchBase + 4)
    }
    m = m + 1
  }
  fbLocalGet(strScratchBase + 2)
  fbI32Const(0)
  fbLocalGet(strScratchBase + 3)
  fbStrNew()
  0
}

// ── the loop-local string accumulator ────────────────────────────────────────
// `let s = ""; s = s + piece` in a loop is O(n²); `strAccScan` proves a binding is an
// accumulator, and `emitStrAccAppend` then appends in place into slack its own grow
// path allocated — linear, with no builder in the source. Soundness: `s` only ever holds a literal, a fresh concat result, or a buffer it allocated (DECISIONS.md "String building is a lowering").
let saNames: string[] = []
let saDecls: i32[] = []
let saApps: i32[] = []
let saBads: i32[] = []
let saFnIx = 0 - 2

// Find (or start) the row for `name`.
function saRow(name: string) {
  let i = 0
  while i < saNames.length {
    if saNames[i] == name { return i }
    i = i + 1
  }
  saNames.push(name)
  saDecls.push(0)
  saApps.push(0)
  saBads.push(0)
  saNames.length - 1
}

function saMarkBad(name: string) {
  saBads[saRow(name)] = 1
  0
}

// A declaration qualifies only at the one spelling whose value is exact-fit by
// construction: a mutable `let` whose initialiser is a string literal, annotated
// `string` or not at all. Anything else disqualifies the name, because the binding
// could then be handed a buffer some other accumulator still owns.
function saNoteDecl(letIx: i32) {
  const d = P.nodes[letIx]
  if d is LetDecl {
    const r = saRow(d.letName)
    saDecls[r] = saDecls[r] + 1
    let ok = d.letKw == "let" && d.letInit >= 0
    if ok {
      const init = P.nodes[d.letInit]
      if !(init is StrLit) { ok = false }
    }
    if ok && d.letType >= 0 {
      const ann = P.nodes[d.letType]
      if ann is TypeRef {
        if ann.tyName != "string" { ok = false }
      } else {
        ok = false
      }
    }
    if !ok { saBads[r] = 1 }
  }
  0
}

// True if any identifier in the subtree at `ix` spells `name`.
function exprMentionsName(ix: i32, name: string) {
  if ix < 0 { return false }
  const n = P.nodes[ix]
  if n is Ident { return n.identName == name }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if exprMentionsName(kids[i], name) { return true }
    i = i + 1
  }
  false
}

// True if `rhsIx` is `name + <parts>` — a maximal string chain whose FIRST part is the
// accumulator itself and none of whose remaining parts mentions it. The second half is
// what keeps the lowering's evaluation order unobservable: the parts run before `name`
// is read, which is only sound while they cannot see or change it.
function saSelfAppendOk(rhsIx: i32, name: string, fnIx: i32) {
  if !exprIsStrConcat(rhsIx, fnIx) { return false }
  const parts: i32[] = []
  strCatParts(rhsIx, fnIx, parts)
  if parts.length < 2 { return false }
  const p0 = P.nodes[parts[0]]
  if p0 is Ident {
    if p0.identName != name { return false }
  } else {
    return false
  }
  let i = 1
  while i < parts.length {
    if exprMentionsName(parts[i], name) { return false }
    i = i + 1
  }
  true
}

// The walk. `depth` counts enclosing LOOPS (an accumulator has to earn its buffer in
// one); `inLambda` is set inside a nested `FuncDecl`, where every mentioned name is
// disqualified — a captured local does not live in the slot this lowering writes.
function strAccWalk(ix: i32, fnIx: i32, depth: i32, inLambda: boolean) {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is Ident {
    if inLambda { saMarkBad(n.identName) }
    return 0
  }
  if n is FuncDecl {
    strAccWalk(n.fnBody, fnIx, 0, true)
    return 0
  }
  if n is LetDecl {
    if inLambda { saMarkBad(n.letName) } else { saNoteDecl(ix) }
    strAccWalk(n.letInit, fnIx, depth, inLambda)
    return 0
  }
  if n is BinExpr {
    if n.binOp == "=" {
      const t = P.nodes[unwrapParen(n.binLeft)]
      if t is Ident {
        if inLambda {
          saMarkBad(t.identName)
        } else if saSelfAppendOk(n.binRight, t.identName, fnIx) {
          if depth > 0 {
            saApps[saRow(t.identName)] = saApps[saRow(t.identName)] + 1
          }
        } else {
          const rhs = P.nodes[n.binRight]
          if !(rhs is StrLit) { saMarkBad(t.identName) }
        }
      }
    }
  }
  if n is WhileStmt {
    strAccWalk(n.whileCond, fnIx, depth, inLambda)
    strAccWalk(n.whileBody, fnIx, depth + 1, inLambda)
    return 0
  }
  if n is ForRange {
    strAccWalk(n.frFrom, fnIx, depth, inLambda)
    strAccWalk(n.frTo, fnIx, depth, inLambda)
    strAccWalk(n.frStep, fnIx, depth, inLambda)
    strAccWalk(n.frBody, fnIx, depth + 1, inLambda)
    return 0
  }
  if n is ForIn {
    strAccWalk(n.fiIter, fnIx, depth, inLambda)
    strAccWalk(n.fiBody, fnIx, depth + 1, inLambda)
    return 0
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    strAccWalk(kids[i], fnIx, depth, inLambda)
    i = i + 1
  }
  0
}

// Prove this function's accumulators. Skipped outright where the function performs no
// string op at all, which is most of them.
function strAccScan(blockIx: i32, fnIx: i32) {
  saNames = []
  saDecls = []
  saApps = []
  saBads = []
  saFnIx = fnIx
  if !fnUsesStrOp { return 0 }
  strAccWalk(blockIx, fnIx, 0, false)
  0
}

// Exactly one declaration, no disqualifying use, and at least one self-append inside a
// loop. The one-declaration rule is what makes the name-keyed answer safe: two bindings
// of one name in a function would share this row.
function saNameQualifies(name: string) {
  let i = 0
  while i < saNames.length {
    if saNames[i] == name {
      return saBads[i] == 0 && saDecls[i] == 1 && saApps[i] > 0
    }
    i = i + 1
  }
  false
}

// Does the assignment at `binIx` append to a proven accumulator? Re-asked per site, with
// the emit-time scope populated, so the scan's answer is a filter and never the whole
// test. `saFnIx` pins the set to the body it is computed for.
function strAccAppendOk(binIx: i32, fnIx: i32) {
  if saFnIx != fnIx { return false }
  if saNames.length == 0 { return false }
  const a = P.nodes[binIx]
  if a is BinExpr {
    const t = P.nodes[unwrapParen(a.binLeft)]
    if t is Ident {
      if !saNameQualifies(t.identName) { return false }
      if localIndexOf(fnIx, t.identName) < 0 { return false }
      return saSelfAppendOk(a.binRight, t.identName, fnIx)
    }
  }
  false
}

// `s = s + p1 + … + pk` appended in place: the parts are evaluated and stashed first
// (they cannot mention `s`, so reading the accumulator after them is unobservable), the
// backing grows only when the parts do not fit, then one `array.copy` per part at a
// running offset, then one new header. Borrows the string scratch frame's slots.
function emitStrAccAppend(body: i32[], binIx: i32, fnIx: i32) {
  const a = P.nodes[binIx]
  if a is BinExpr {
    const t = P.nodes[unwrapParen(a.binLeft)]
    if t is Ident {
      const slot = localIndexOf(fnIx, t.identName)
      const parts: i32[] = []
      strCatParts(a.binRight, fnIx, parts)
      const n = parts.length
      let i = 1
      while i < n {
        if emitStrValue(body, parts[i], fnIx) < 0 { return -1 }
        i = i + 1
      }
      let j = n - 1
      while j >= 1 {
        fbLocalSet(strCatSlot(j - 1))
        j = j - 1
      }
      fbLocalGet(strCatSlot(0))
      fbStrLen()
      let k = 2
      while k < n {
        fbLocalGet(strCatSlot(k - 1))
        fbStrLen()
        fbI32Bin(106) // i32.add
        k = k + 1
      }
      fbLocalSet(strScratchBase + 3) // I0 = the added length
      fbLocalGet(slot)
      fbStrLen()
      fbLocalSet(strScratchBase + 4) // I1 = the current length
      fbLocalGet(slot)
      fbStrStart()
      fbLocalSet(strScratchBase + 6) // I3 = the current start
      fbLocalGet(slot)
      fbStrBack()
      fbLocalSet(strScratchBase + 2) // OUT = the current backing
      fbLocalGet(strScratchBase + 6)
      fbLocalGet(strScratchBase + 4)
      fbI32Bin(106)
      fbLocalGet(strScratchBase + 3)
      fbI32Bin(106)
      fbLocalGet(strScratchBase + 2)
      fbArrayLen()
      fbI32Bin(74)                   // i32.gt_s — start + len + added past the backing?
      fbIf(64)                       // void
      fbLocalGet(strScratchBase + 2)
      fbLocalSet(strScratchBase + 7) // ABK = the old buffer
      fbLocalGet(strScratchBase + 4)
      fbLocalGet(strScratchBase + 3)
      fbI32Bin(106)
      fbI32Const(1)
      fbI32Bin(116)                  // i32.shl — capacity DOUBLING is what makes the loop linear
      fbI32Const(16)
      fbI32Bin(106)
      fbArrayNewDefault(sBackIdx)
      fbLocalSet(strScratchBase + 2)
      fbLocalGet(strScratchBase + 2)
      fbI32Const(0)
      fbLocalGet(strScratchBase + 7)
      fbLocalGet(strScratchBase + 6)
      fbLocalGet(strScratchBase + 4)
      fbArrayCopy(sBackIdx, sBackIdx)
      fbI32Const(0)
      fbLocalSet(strScratchBase + 6) // the fresh buffer starts at 0
      fbEnd()
      fbLocalGet(strScratchBase + 6)
      fbLocalGet(strScratchBase + 4)
      fbI32Bin(106)
      fbLocalSet(strScratchBase + 5) // I2 = the running destination offset
      let m = 1
      while m < n {
        fbLocalGet(strScratchBase + 2)
        fbLocalGet(strScratchBase + 5)
        fbLocalGet(strCatSlot(m - 1))
        fbStrBack()
        fbLocalGet(strCatSlot(m - 1))
        fbStrStart()
        fbLocalGet(strCatSlot(m - 1))
        fbStrLen()
        fbArrayCopy(sBackIdx, sBackIdx)
        if m + 1 < n {
          fbLocalGet(strScratchBase + 5)
          fbLocalGet(strCatSlot(m - 1))
          fbStrLen()
          fbI32Bin(106)
          fbLocalSet(strScratchBase + 5)
        }
        m = m + 1
      }
      fbLocalGet(strScratchBase + 2)
      fbLocalGet(strScratchBase + 6)
      fbLocalGet(strScratchBase + 4)
      fbLocalGet(strScratchBase + 3)
      fbI32Bin(106)
      fbStrNew()
      fbLocalSet(slot)
      return 0
    }
  }
  emitFail("emitProgram: expected a string accumulator append")
}

// Lower a string value-equality `a == b` (or `a != b`) onto `body`, leaving a 0/1 i32:
// element-wise, not ref identity — false if the lengths differ, else loop comparing
// `a[i] == b[i]`, all-equal giving 1. `!=` negates with `i32.eqz`. Lowered as a
// value-typed `block`/`loop` so the compare can `br` out early on a mismatch.
function emitStrEq(body: i32[], binIx: i32, fnIx: i32) {
  if !aUsed {
    return emitFail("emitProgram: string equality but array type not collected")
  }
  const e = P.nodes[binIx]
  if e is BinExpr {
    const isNe = e.binOp == "!="
    // Eval both operands, then stash (B on top, so set B first). A literal-union atom
    // operand widens to its member string first (`emitStrValue`), the same boundary
    // `emitStrConcat` applies — the reason `s == k` (`s: string`, `k: K`) is a string
    // compare rather than the atom `i32.eq` (`eqAtomOperandOk`).
    if emitStrValue(body, e.binLeft, fnIx) < 0 { return -1 }
    if emitEqRecoverNarrowed(e.binLeft, fnIx) < 0 { return -1 }
    if emitStrValue(body, e.binRight, fnIx) < 0 { return -1 }
    if emitEqRecoverNarrowed(e.binRight, fnIx) < 0 { return -1 }
    if emitEqNonNullCore(body, binIx, fnIx) < 0 { return -1 }
    if isNe {
      fbI32Eqz() // 0x45 i32.eqz  (`!=` negates value-equality)
    }
    return 0
  }
  emitFail("emitProgram: expected a string equality")
}

// Lower a string ordering comparison (`<`/`>`/`<=`/`>=`) onto a 0/1, built on one
// primitive, `emitStrLessCore` ("first operand lexicographically < second"): `A < B`
// is `less(A,B)`, `A > B` is `less(B,A)`, and the `<=`/`>=` forms negate. Each operand is
// pushed as a string value (a literal-union atom widens first) — unwidened, ordering compared interned atom ids instead of the strings, e.g. answering `"b" < "a"` true.
function emitStrOrder(body: i32[], binIx: i32, fnIx: i32) {
  if !aUsed {
    return emitFail("emitProgram: string ordering but array type not collected")
  }
  const e = P.nodes[binIx]
  if e is BinExpr {
    const op = e.binOp
    let swap = false
    let neg = false
    if op == ">" {
      swap = true
    } else if op == "<=" {
      swap = true
      neg = true
    } else if op == ">=" {
      neg = true
    } else if op != "<" {
      return emitFail("emitProgram: expected a string ordering operator")
    }
    // Push the core's first arg (lower on stack) then its second arg.
    if swap {
      if emitStrValue(body, e.binRight, fnIx) < 0 { return -1 }
      if emitStrValue(body, e.binLeft, fnIx) < 0 { return -1 }
    } else {
      if emitStrValue(body, e.binLeft, fnIx) < 0 { return -1 }
      if emitStrValue(body, e.binRight, fnIx) < 0 { return -1 }
    }
    if emitStrLessCore(body) < 0 { return -1 }
    if neg {
      fbI32Eqz() // 0x45 i32.eqz — `<=`/`>=` negate the strict-less result
    }
    return 0
  }
  emitFail("emitProgram: expected a string ordering")
}

// The string strict-less core: expects the two string refs already on the stack (first
// below second), leaves 1 iff the first is lexicographically less than the second, else
// 0 — unsigned code-point compare up to the shorter length, first mismatch decides, and a
// prefix relationship makes the shorter string less. Mirrors `emitStrEqCore`'s frame shape.
function emitStrLessCore(body: i32[]) {
  fbLocalSet(strScratchBase + 1) // B (stack top)
  fbLocalSet(strScratchBase + 0) // A
  // Hoist both headers' backing + start BEFORE the block — the element loop below reads
  // both operands once per trip.
  hoistStrScr(body, 0)
  hoistStrScr(body, 1)
  fbBlock(127) // 0x02 block, 0x7f i32 blocktype → the 0/1 result
  // lenA = len(A) ; lenB = len(B) — the HEADER's `len` (field 2), not `array.len`
  pushStrScrRef(body, 0)
  fbStrLen()
  setStrScrI(body, 0) // lenA
  pushStrScrRef(body, 1)
  fbStrLen()
  setStrScrI(body, 1) // lenB
  // n = min(lenA, lenB):  n = lenA ; if lenB < lenA { n = lenB }
  pushStrScrI(body, 0)
  setStrScrI(body, 2)
  pushStrScrI(body, 1)
  pushStrScrI(body, 0)
  fbI32Bin(73)        // 0x49 i32.lt_u (lenB < lenA)
  fbIf(64)            // 0x04 if, void
  pushStrScrI(body, 1)
  setStrScrI(body, 2) // n = lenB
  fbEnd()
  // i = 0
  fbI32Const(0)
  setStrScrI(body, 3)
  // loop { if i >= n {} else { compare; i++; br } }
  fbLoop(64)           // 0x03 loop, void
  pushStrScrI(body, 3) // i
  pushStrScrI(body, 2) // n
  fbI32Bin(78)         // 0x4e i32.ge_s (i >= n → common prefix done)
  fbIf(64)             // then: fall through (empty)
  fbElse()
  // if A[i] != B[i] { push (A[i] <_u B[i]) ; br out of block }
  pushStrScrElem(body, 0, 3) // A[i]
  pushStrScrElem(body, 1, 3) // B[i]
  fbI32Bin(71)               // 0x47 i32.ne
  fbIf(64)
  pushStrScrElem(body, 0, 3) // A[i]
  pushStrScrElem(body, 1, 3) // B[i]
  fbI32Bin(73)               // 0x49 i32.lt_u (A[i] < B[i] → the answer at the first diff)
  fbBr(3)                    // 0x0c br depth 3 → out of: if(0)·else(1)·loop(2)·block(3)
  fbEnd()                    // end (mismatch if)
  // i = i + 1
  pushStrScrI(body, 3)
  fbI32Const(1)
  fbI32Bin(106) // 0x6a i32.add
  setStrScrI(body, 3)
  fbBr(1)       // 0x0c br depth 1 → loop header (else=0, loop=1)
  fbEnd()       // end (ge_s if/else)
  fbEnd()       // end (loop)
  // Common prefix equal → the shorter string is less:  lenA < lenB.
  pushStrScrI(body, 0)
  pushStrScrI(body, 1)
  fbI32Bin(73) // 0x49 i32.lt_u (lenA < lenB)
  fbEnd()      // end (block) — leaves the 0/1 result
  0
}

// The string value-equality core: expects the two string refs already on the stack
// (left below right), leaves the 0/1 result. Shared by `emitStrEq` and the
// struct-equality field compare (which pushes field chains as operands) — one `call`
// into the shared `__str_eq__` helper, emitted once per module.
function emitStrEqCore(_body: i32[]) {
  fbCall(gHelpStrEq)
  0
}

// ── list value-equality + concat cores (collections-design §VL.4/§VL.6) ───────
// Each core expects its two list wrapper refs already on the stack (left below right)
// and leaves a 0/1 (equality) or the new wrapper (concat), mirroring `emitStrEqCore`'s
// block/loop/br structure — only the length source (`len`, not `array.len`) and the element compare differ per kind.

// i32-list `==`: length + element compare over the LEQI frame.
function emitListEqICore(_body: i32[]) {
  const bA = leqIScratchBase
  fbLocalSet(bA + 1)       // B
  fbLocalSet(bA + 0)       // A
  fbBlock(127)             // block i32
  fbLocalGet(bA + 0)
  fbStructGet(lTypeIdx, 1) // lenA
  fbLocalSet(bA + 3)       // n = lenA
  fbLocalGet(bA + 3)
  fbLocalGet(bA + 1)
  fbStructGet(lTypeIdx, 1) // lenB
  fbI32Bin(71)             // i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(1)
  fbEnd()
  fbI32Const(0)
  fbLocalSet(bA + 4)       // i = 0
  fbLoop(64)
  fbLocalGet(bA + 4)
  fbLocalGet(bA + 3)
  fbI32Bin(78)             // i >= n → done
  fbIf(64)
  fbElse()
  fbLocalGet(bA + 0)
  fbStructGet(lTypeIdx, 0) // backing A
  fbLocalGet(bA + 4)
  fbArrayGet(aTypeIdx)
  fbLocalGet(bA + 1)
  fbStructGet(lTypeIdx, 0) // backing B
  fbLocalGet(bA + 4)
  fbArrayGet(aTypeIdx)
  fbI32Bin(71)             // element i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(3)                  // mismatch → 0, exit block
  fbEnd()
  fbLocalGet(bA + 4)
  fbI32Const(1)
  fbI32Bin(106)            // i + 1
  fbLocalSet(bA + 4)
  fbBr(1)                  // back to loop
  fbEnd()                  // end (ge_s if/else)
  fbEnd()                  // end (loop)
  fbI32Const(1)
  fbEnd()                  // end (block)
  0
}

// String-list `==`: outer loop over the LEQS frame; each element pair rides
// `emitStrEqCore` (the string-op frame — disjoint locals, safe to nest).
function emitListEqSCore(body: i32[]) {
  const bA = leqSScratchBase
  fbLocalSet(bA + 1)        // B
  fbLocalSet(bA + 0)        // A
  fbBlock(127)              // block i32
  fbLocalGet(bA + 0)
  fbStructGet(mkListIdx, 1) // lenA
  fbLocalSet(bA + 2)        // n
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 1)
  fbStructGet(mkListIdx, 1)
  fbI32Bin(71)              // i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(1)
  fbEnd()
  fbI32Const(0)
  fbLocalSet(bA + 3)        // i = 0
  fbLoop(64)
  fbLocalGet(bA + 3)
  fbLocalGet(bA + 2)
  fbI32Bin(78)
  fbIf(64)
  fbElse()
  // push elem A, elem B (non-null string refs), compare via the string core
  fbLocalGet(bA + 0)
  fbStructGet(mkListIdx, 0)
  fbLocalGet(bA + 3)
  fbArrayGet(mkArrIdx)
  fbRefAsNonNull()
  fbLocalGet(bA + 1)
  fbStructGet(mkListIdx, 0)
  fbLocalGet(bA + 3)
  fbArrayGet(mkArrIdx)
  fbRefAsNonNull()
  if emitStrEqCore(body) < 0 { return -1 }
  fbI32Eqz() // 1 = mismatch
  fbIf(64)
  fbI32Const(0)
  fbBr(3)
  fbEnd()
  fbLocalGet(bA + 3)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(bA + 3)
  fbBr(1)
  fbEnd()
  fbEnd()
  fbI32Const(1)
  fbEnd()
  0
}

// `i32[][]` `==`: outer loop over the slot's LEQR frame; each element pair (two
// inner i32-list wrappers) recurses through `emitListEqICore` (disjoint frame).
function emitListEqRCore(body: i32[], slot: i32, base: i32) {
  fbLocalSet(base + 1) // B
  fbLocalSet(base + 0) // A
  fbBlock(127)         // block i32
  fbLocalGet(base + 0)
  fbStructGet(rlWrapIdx[slot], 1)
  fbLocalSet(base + 2) // n
  fbLocalGet(base + 2)
  fbLocalGet(base + 1)
  fbStructGet(rlWrapIdx[slot], 1)
  fbI32Bin(71)
  fbIf(64)
  fbI32Const(0)
  fbBr(1)
  fbEnd()
  fbI32Const(0)
  fbLocalSet(base + 3) // i = 0
  fbLoop(64)
  fbLocalGet(base + 3)
  fbLocalGet(base + 2)
  fbI32Bin(78)
  fbIf(64)
  fbElse()
  fbLocalGet(base + 0)
  fbStructGet(rlWrapIdx[slot], 0)
  fbLocalGet(base + 3)
  fbArrayGet(rlBackIdx[slot])
  fbRefAsNonNull()
  fbLocalGet(base + 1)
  fbStructGet(rlWrapIdx[slot], 0)
  fbLocalGet(base + 3)
  fbArrayGet(rlBackIdx[slot])
  fbRefAsNonNull()
  if emitListEqICore(body) < 0 { return -1 }
  fbI32Eqz()
  fbIf(64)
  fbI32Const(0)
  fbBr(3)
  fbEnd()
  fbLocalGet(base + 3)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(base + 3)
  fbBr(1)
  fbEnd()
  fbEnd()
  fbI32Const(1)
  fbEnd()
  0
}

// The reserved LEQR frame base for ref-list slot `slot`, or -1.
function leqRBaseOfSlot(slot: i32) {
  let i = 0
  while i < fnListEqRSlots.length {
    if fnListEqRSlots[i] == slot { return leqRBases[i] }
    i = i + 1
  }
  -1
}

// The two locals a STRUCT-element compare parked its element pair in, or -1 outside one.
// Read by `emitChainRead` through the root sentinels -2 / -3; see its header for why the
// value rides here rather than as a parameter.
let eqStashL = -1
let eqStashR = -1

// D1180 — TRUE while a ref-NICHE field's compare runs UNDER its null guard, so every chain
// read of it recovers the non-null ref the leaf core wants. It rides here for the same reason
// the stash pair does: `emitChainRead` is called from a dozen arms and threading a parameter
// through all of them would put the flag at every call site instead of the one that sets it.
let eqChainRecover = false

// The `i32.ne`-class element opcode for a scalar-leaf list rep — the only byte that
// differs between the four wide backings' element compares. Kind 0 covers every rep
// that already is an i32 (boolean, an interned atom, an i32-based literal union) and
// kind 10 (packed u8), since `fbArrayGet` zero-extends the byte before comparing.
function eqgNeOpcode(kind: i32) {
  if kind == 4 {
    return 98 // 0x62 f64.ne
  }
  if kind == 6 {
    return 82 // 0x52 i64.ne
  }
  if kind == 7 {
    return 92 // 0x5c f32.ne
  }
  71 // 0x47 i32.ne
}

// The one entry for a list `==` at rep (kind, slot), with both wrapper refs already on
// the stack (left below right); leaves the 0/1 answer, routing to whichever core owns
// the rep (the three pre-existing cores keep every shape they claim; everything else is
// `emitListEqGCore`). A function, not an inline arm, so a nested compare's recursion has one place to go.
function emitListEqAnyRep(body: i32[], kind: i32, slot: i32, fnIx: i32) {
  // A list core starts a fresh chain, so the niche guard's recover must not survive into
  // it (D1291): every read the core makes below is its own, and an `i32` leaf field with
  // a stray `ref.as_non_null` appended is check-clean invalid wasm. The flag names the
  // current chain, so it is cleared for the duration of any core that opens another one.
  const savedRec = eqChainRecover
  eqChainRecover = false
  const r = emitListEqAnyRepAt(body, kind, slot, fnIx)
  eqChainRecover = savedRec
  r
}

function emitListEqAnyRepAt(body: i32[], kind: i32, slot: i32, fnIx: i32) {
  if kind == 0 { return emitListEqICore(body) }
  if kind == 3 { return emitListEqSCore(body) }
  if kind == 1 {
    if slot >= 0 && slot < rlElemKindTbl.length {
      if rlElemKindTbl[slot] == 4 {
        const rb = leqRBaseOfSlot(slot)
        if rb < 0 {
          return emitFail("emitProgram: ref-list compare frame not reserved")
        }
        return emitListEqRCore(body, slot, rb)
      }
    }
  }
  emitListEqGCore(body, kind, slot, fnIx)
}

// One element read at index `i` of the staged wrapper in frame slot `bA + which`, left
// on the stack ready for compare: `backing[i]`, plus the non-null recovery a ref element
// needs. Split out because the two operands' reads must interleave with their recoveries
// — a single trailing recover would recover the right operand twice, leaving the left nullable.
function emitEqGElemRead(
  bA: i32,
  which: i32,
  wrap: i32,
  back: i32,
  isRef: boolean,
) {
  fbLocalGet(bA + which)
  fbStructGet(wrap, 0) // the backing
  fbLocalGet(bA + 3)   // i
  fbArrayGet(back)
  if isRef {
    fbRefAsNonNull() // 0xd4
  }
  0
}

// One element pair of a struct-element list, compared field-wise, leaving the 0/1
// equality: read `backing[i]` for each side into a fresh lazy-frame slot, then run the
// ordinary struct compare with those slots as its two roots. The stash globals are saved
// and restored rather than cleared, since a nested list of structs re-enters this from inside an outer `emitListEqGCore` whose own element rung may still be running.
function emitEqGStructElem(body: i32[], slot: i32, fnIx: i32) {
  if !eqgElemHasEqRow(slot) {
    return emitFail(
      "emitProgram: struct-element compare with no interned shape",
    )
  }
  const row = eqgElemEqRow(slot)
  const sa = listElemStashSlot("ref", slot)
  const sb = listElemStashSlot("ref", slot)
  const bA = leqgBaseOfRep(1, slot)
  const wrap = catWrapIdxOf(1, slot)
  const back = catBackIdxOf(1, slot)
  // A[i] → sa, B[i] → sb. Not `emitEqGElemRead`: these want the RAW nullable element, and
  // the slot they land in is nullable too, so there is no recovery to make.
  fbLocalGet(bA + 0)
  fbStructGet(wrap, 0)
  fbLocalGet(bA + 3)
  fbArrayGet(back)
  fbLocalSet(sa)
  fbLocalGet(bA + 1)
  fbStructGet(wrap, 0)
  fbLocalGet(bA + 3)
  fbArrayGet(back)
  fbLocalSet(sb)
  const savedL = eqStashL
  const savedR = eqStashR
  eqStashL = sa
  eqStashR = sb
  const pathSi: i32[] = []
  const pathFi: i32[] = []
  const r = emitStructEqRec(body, -2, -3, row, pathSi, pathFi, fnIx)
  eqStashL = savedL
  eqStashR = savedR
  r
}

// List `==` over every other list rep: needs an element loop and `eqgElemClass`'s answer
// to "compare two of these" — a scalar leaf, a string leaf, or a nested list (recurse) —
// declining any rep it cannot classify rather than guessing a compare. Each recursion
// level has its own frame keyed on (kind, slot), and a list is never its own element, which is what makes the recursion safe.
function emitListEqGCore(body: i32[], kind: i32, slot: i32, fnIx: i32) {
  const bA = leqgBaseOfRep(kind, slot)
  if bA < 0 {
    // The scan and the emitter read ONE home (`eqgListKindOfBin` / `eqgElemClass`), so a
    // missing frame is a desync rather than a program property — loud, never a write into
    // a local the function never declared.
    return emitFail(
      "emitProgram: list compare frame was not reserved for this rep",
    )
  }
  const cls = eqgElemClass(kind, slot)
  if cls == 0 {
    return emitFail(
      "emitProgram: list compare over an element rep with no core",
    )
  }
  const wrap = catWrapIdxOf(kind, slot)
  const back = catBackIdxOf(kind, slot)
  const isRef = cls != 1
  fbLocalSet(bA + 1)   // B
  fbLocalSet(bA + 0)   // A
  fbBlock(127)         // block i32
  fbLocalGet(bA + 0)
  fbStructGet(wrap, 1) // lenA
  fbLocalSet(bA + 2)   // n = lenA
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 1)
  fbStructGet(wrap, 1) // lenB
  fbI32Bin(71)         // 0x47 i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(1)
  fbEnd()
  fbI32Const(0)
  fbLocalSet(bA + 3)   // i = 0
  fbLoop(64)
  fbLocalGet(bA + 3)
  fbLocalGet(bA + 2)
  fbI32Bin(78)         // 0x4e i32.ge_s — i >= n → done
  fbIf(64)
  fbElse()
  if cls != 4 {
    if emitEqGElemRead(bA, 0, wrap, back, isRef) < 0 { return -1 }
    if emitEqGElemRead(bA, 1, wrap, back, isRef) < 0 { return -1 }
  }
  if cls == 4 {
    // A struct element, compared field-wise off two stashed locals. The pair is parked
    // rather than left on the stack because `emitStructEqRec` re-reads each root once per
    // field, and a `(ref null <elem heap>)` slot would trap `struct.get` on null —
    // `eqgElemClass` claims only the non-nullable struct element kind, so it never does.
    if emitEqGStructElem(body, slot, fnIx) < 0 { return -1 }
    fbI32Eqz() // the compare leaves EQUALITY; the branch below tests MISMATCH
  } else if cls == 1 {
    // Two scalar leaves: one opcode, and it leaves the MISMATCH the branch below tests.
    wU8(eqgNeOpcode(kind))
  } else {
    // A REF leaf — a string or an inner list — through its own core, which leaves
    // EQUALITY; the branch below tests mismatch, so negate once.
    if cls == 2 {
      if emitStrEqCore(body) < 0 { return -1 }
    } else {
      if (
        emitListEqAnyRep(body, eqgInnerKind(slot), eqgInnerSlot(slot), fnIx) <
        0
      ) {
        return -1
      }
    }
    fbI32Eqz() // 0x45
  }
  fbIf(64)
  fbI32Const(0)
  fbBr(3)       // mismatch → 0, exit the block
  fbEnd()
  fbLocalGet(bA + 3)
  fbI32Const(1)
  fbI32Bin(106) // i + 1
  fbLocalSet(bA + 3)
  fbBr(1)       // back to the loop header
  fbEnd()       // end (ge_s if/else)
  fbEnd()       // end (loop)
  fbI32Const(1)
  fbEnd()       // end (block)
  0
}

// The reserved LEQG frame base for compare rep `(kind, slot)`, or -1. The lookup twin of
// `lcatBaseOfRep`, over the pair the reservation scan pushed.
function leqgBaseOfRep(kind: i32, slot: i32) {
  let i = 0
  while i < fnListEqGKinds.length {
    if fnListEqGKinds[i] == kind && fnListEqGSlots[i] == slot {
      return leqgBases[i]
    }
    i = i + 1
  }
  -1
}

// i32-list CONCAT `a + b`: a NEW list sized exactly lenA + lenB (one backing
// allocation, two bulk `array.copy`s) — the host's §VL.4 lowering. The operands
// are evaluated once into the LEQI frame; the result wrapper is left on the stack.
function emitListConcatI(body: i32[], leftIx: i32, rightIx: i32, fnIx: i32) {
  const bA = leqIScratchBase
  if emitExpr(body, leftIx, fnIx) < 0 { return -1 }
  // A NARROWED nullable-list operand (`i32[] | null`, kind 15) keeps its nullable
  // slot; the LEQI scratch slot is non-null, so recover before the store (the
  // checker proved the operand guarded — the cast can never trap).
  if exprNullableList(leftIx, fnIx) {
    wU8(212) // 0xd4 ref.as_non_null
  }
  fbLocalSet(bA + 0) // A
  if emitExpr(body, rightIx, fnIx) < 0 { return -1 }
  if exprNullableList(rightIx, fnIx) {
    wU8(212) // 0xd4 ref.as_non_null
  }
  fbLocalSet(bA + 1)       // B
  fbLocalGet(bA + 0)
  fbStructGet(lTypeIdx, 1) // lenA
  fbLocalGet(bA + 1)
  fbStructGet(lTypeIdx, 1) // lenB
  fbI32Bin(106)            // i32.add
  fbLocalSet(bA + 3)       // n = lenA + lenB
  fbLocalGet(bA + 3)
  fbArrayNewDefault(aTypeIdx)
  fbLocalSet(bA + 2)       // out backing
  // array.copy out 0 backingA 0 lenA
  fbLocalGet(bA + 2)
  fbI32Const(0)
  fbLocalGet(bA + 0)
  fbStructGet(lTypeIdx, 0)
  fbI32Const(0)
  fbLocalGet(bA + 0)
  fbStructGet(lTypeIdx, 1)
  fbArrayCopy(aTypeIdx, aTypeIdx)
  // array.copy out lenA backingB 0 lenB
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 0)
  fbStructGet(lTypeIdx, 1)
  fbLocalGet(bA + 1)
  fbStructGet(lTypeIdx, 0)
  fbI32Const(0)
  fbLocalGet(bA + 1)
  fbStructGet(lTypeIdx, 1)
  fbArrayCopy(aTypeIdx, aTypeIdx)
  // the result wrapper { out, n, n }
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 3)
  fbLocalGet(bA + 3)
  fbStructNew(lTypeIdx)
  0
}

// List concat over every other list rep — the rep-parameterised twin of `emitListConcatI`,
// instruction for instruction: one backing allocation sized `lenA + lenB`, two
// `array.copy`s, one wrapper. A second function rather than a parameter on the first
// because the i32 list stages operands in the LEQI frame and every other rep in its own LCAT frame — different slot types, not just a different base.
function emitListConcatG(
  body: i32[],
  leftIx: i32,
  rightIx: i32,
  fnIx: i32,
  kind: i32,
  slot: i32,
) {
  const bA = lcatBaseOfRep(kind, slot)
  if bA < 0 {
    // The scan and the emitter read ONE home (`catListKindOfBin`), so a missing frame is
    // a desync rather than a program property — loud, never a write into a local the
    // function never declared.
    return emitFail(
      "emitProgram: list concat frame was not reserved for this rep",
    )
  }
  const wrap = catWrapIdxOf(kind, slot)
  const back = catBackIdxOf(kind, slot)
  if emitExpr(body, leftIx, fnIx) < 0 { return -1 }
  // A NARROWED nullable operand's cell still holds a `(ref null …)` while the frame slot
  // is non-null — the same recovery the compare cores make, off the same one home.
  if emitEqRecoverNarrowed(leftIx, fnIx) < 0 { return -1 }
  fbLocalSet(bA + 0)   // A
  if emitExpr(body, rightIx, fnIx) < 0 { return -1 }
  if emitEqRecoverNarrowed(rightIx, fnIx) < 0 { return -1 }
  fbLocalSet(bA + 1)   // B
  fbLocalGet(bA + 0)
  fbStructGet(wrap, 1) // lenA
  fbLocalGet(bA + 1)
  fbStructGet(wrap, 1) // lenB
  fbI32Bin(106)        // i32.add
  fbLocalSet(bA + 3)   // n = lenA + lenB
  fbLocalGet(bA + 3)
  fbArrayNewDefault(back)
  fbLocalSet(bA + 2)   // out backing
  // array.copy out 0 backingA 0 lenA
  fbLocalGet(bA + 2)
  fbI32Const(0)
  fbLocalGet(bA + 0)
  fbStructGet(wrap, 0)
  fbI32Const(0)
  fbLocalGet(bA + 0)
  fbStructGet(wrap, 1)
  fbArrayCopy(back, back)
  // array.copy out lenA backingB 0 lenB
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 0)
  fbStructGet(wrap, 1)
  fbLocalGet(bA + 1)
  fbStructGet(wrap, 0)
  fbI32Const(0)
  fbLocalGet(bA + 1)
  fbStructGet(wrap, 1)
  fbArrayCopy(back, back)
  // the result wrapper { out, n, n }
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 3)
  fbLocalGet(bA + 3)
  fbStructNew(wrap)
  0
}

// The reserved LCAT frame base for concat rep `(kind, slot)`, or -1. The lookup twin of
// `leqRBaseOfSlot`, over the pair the reservation scan pushed.
function lcatBaseOfRep(kind: i32, slot: i32) {
  let i = 0
  while i < fnListCatKinds.length {
    if fnListCatKinds[i] == kind && fnListCatSlots[i] == slot {
      return lcatBases[i]
    }
    i = i + 1
  }
  -1
}

// Re-evaluate the field access chain `root.f1.f2…` onto `body`: the root expression, then
// one `struct.get` per (row, field) pair — a pure re-read, since the equality compare
// re-walks chains per field. Root indices -2/-3 are sentinels naming the two locals
// `emitListEqGCore` stashed a list element pair in, letting a struct compare run inside a list loop without threading that pair through every call site as a parameter.
function emitChainRead(
  body: i32[],
  rootIx: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
) {
  if rootIx == -2 || rootIx == -3 {
    let stash = eqStashL
    if rootIx == -3 { stash = eqStashR }
    if stash < 0 {
      return emitFail(
        "emitProgram: struct-element compare with no stashed root",
      )
    }
    fbLocalGet(stash)
    let sk = 0
    while sk < pathSi.length {
      fbStructGet(eqRowHeapIdx(pathSi[sk]), pathFi[sk])
      sk = sk + 1
    }
    if eqChainRecover { fbRefAsNonNull() }
    return 0
  }
  if emitExpr(body, rootIx, fnIx) < 0 { return -1 }
  let k = 0
  while k < pathSi.length {
    fbStructGet(eqRowHeapIdx(pathSi[k]), pathFi[k]) // 0xfb 0x02 <ht> <field>
    k = k + 1
  }
  if eqChainRecover { fbRefAsNonNull() }
  0
}

// Compare two closure fat-pointers already on the stack (left below right), leaving a
// 0/1 i32 for function identity: the same lifted function (field 1) and the same
// captured env (`ref.eq` over field 0 — two null envs are equal, two separately created
// envs of the same function are not). Mirrors the host's function-identity `==`.
function emitCloEqCore(_body: i32[]) {
  fbLocalSet(cloEqScratchBase + 1) // B = right operand
  fbLocalSet(cloEqScratchBase + 0) // A = left operand
  fbLocalGet(cloEqScratchBase + 0)
  fbStructGet(cloStructIdx, 1)     // A.id
  fbLocalGet(cloEqScratchBase + 1)
  fbStructGet(cloStructIdx, 1)     // B.id
  fbI32Bin(70)                     // 0x46 i32.eq
  fbLocalGet(cloEqScratchBase + 0)
  fbStructGet(cloStructIdx, 0)     // A.env
  fbLocalGet(cloEqScratchBase + 1)
  fbStructGet(cloStructIdx, 0)     // B.env
  wU8(211)                         // 0xd3 ref.eq (null == null → 1)
  fbI32Bin(113)                    // 0x71 i32.and
  0
}

// The one core-selection ladder for a `==`/`!=` whose two operands are already on the
// stack as non-null refs. Leaves the 0/1 equality answer, never the negation — `!=`
// belongs to the caller. Shared by the plain compare paths and `emitNulNicheEq`, so a rep
// the plain compare handles is a rep the nullable form handles by construction — two ladders is how the two drift apart.
function emitEqNonNullCore(body: i32[], binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    const coreK = eqCoreKindOfBin(binIx, fnIx)
    if coreK == 0 { return emitListEqICore(body) }
    if coreK == 3 { return emitListEqSCore(body) }
    if coreK == 4 {
      let lslot = refListSlotOfExpr(e.binLeft, fnIx)
      if lslot < 0 { lslot = refListSlotOfExpr(e.binRight, fnIx) }
      const lbase = leqRBaseOfSlot(lslot)
      if lbase < 0 {
        return emitFail("emitProgram: ref-list compare frame not reserved")
      }
      return emitListEqRCore(body, lslot, lbase)
    }
    if coreK == 5 { return emitStrEqCore(body) }
    if coreK == 6 { return emitCloEqCore(body) }
    if coreK == 7 {
      return emitListEqAnyRep(
        body,
        eqgListKindOfBin(binIx, fnIx),
        eqgListSlotOfBin(binIx, fnIx),
        fnIx,
      )
    }
    return emitFail(
      "emitProgram: `" +
        e.binOp +
        "` over this operand rep has no compare core",
    )
  }
  emitFail("emitProgram: expected a `==`/`!=` for the compare core")
}

// One raw read of a nullable-niche `==` operand — never `ref.as_non_null`, because the
// guard around it exists precisely to see the null this rep can hold (a `string | null`
// ident otherwise recovers itself and traps on the value the guard answers for). A
// literal-union atom operand still widens to its member string first, as `emitStrEq` does.
function emitEqOperandRaw(body: i32[], ix: i32, fnIx: i32) {
  if exprIsLitAtom(ix, fnIx) { return emitStrValue(body, ix, fnIx) }
  const rawCtx = expCtxHere()
  rawCtx.rawNullRead = true
  emitExprExpect(body, ix, fnIx, rawCtx)
}

// A narrowed nullable-niche operand's cell still holds a `(ref null …)`, and every compare
// core's frame slot demands the non-null ref, so a plain (unguarded) compare recovers its
// operands exactly as `for`-in, `.slice` and the member ops do — safe because the checker
// proved the read guarded. A genuinely-nullable operand never arrives here: `binEqNulNiche` claims it off the checker's banked type and the guard reads it raw.
function emitEqRecoverNarrowed(exprIx: i32, fnIx: i32) {
  if nulRecvNeedsRecover(exprIx, fnIx) || exprNulClosure(exprIx, fnIx) {
    fbRefAsNonNull() // 0xd4 ref.as_non_null
  }
  0
}

// "Is this `==` operand null" — the shared ladder's answer for a nullable operand, a constant 0
// for a non-nullable one (the MIXED pairing `S | null == S`). Never a hand-rolled
// `ref.is_null`: `emitNulIsNullTest` is the one home for the null test of every rep and its
// header carries why.
function emitEqIsNull(body: i32[], ix: i32, fnIx: i32) {
  const claimed = emitNulIsNullTest(body, ix, fnIx, false, false)
  if claimed < 0 { return -1 }
  if claimed > 0 { return 0 }
  fbI32Const(0)
  0
}

// A `==`/`!=` where at least one operand is a nullable ref niche, lowered as the rep's own
// compare under a null guard: `null == null` is true, `null == v` false, and the
// non-null half runs the rep's existing core unchanged. `br_on_null` consumes the ref it
// tests, so the right operand's code is emitted twice but exactly one path runs at runtime, evaluating each operand exactly once.
function emitNulNicheEq(body: i32[], binIx: i32, fnIx: i32, niche: EqCmpKind) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if niche == "nulstruct" { return emitNulStructEq(body, binIx, fnIx) }
    fbBlock(127) // block i32 — $out, the 0/1 answer
    ctrlEnter()
    fbBlock(64) // block void — $onenull
    ctrlEnter()
    fbBlock(64) // block void — $lnull
    ctrlEnter()
    if emitEqOperandRaw(body, e.binLeft, fnIx) < 0 { return -1 }
    wU8(213) // 0xd5 br_on_null — pops it; on non-null leaves (ref $rep)
    wULEB(0) // → $lnull
    if emitEqOperandRaw(body, e.binRight, fnIx) < 0 { return -1 }
    wU8(213) // 0xd5 br_on_null
    wULEB(1) // → $onenull (unwinding past the left ref, which needs no drop)
    if emitEqNonNullCore(body, binIx, fnIx) < 0 { return -1 }
    fbBr(2) // → $out
    fbEnd()
    ctrlLeave() // end $lnull — the left operand was null
    if emitEqOperandRaw(body, e.binRight, fnIx) < 0 { return -1 }
    wU8(209) // 0xd1 ref.is_null — both null ⇒ equal
    fbBr(1) // → $out
    fbEnd()
    ctrlLeave() // end $onenull — exactly one side was null
    fbI32Const(0)
    fbEnd()
    ctrlLeave() // end $out
    return 0
  }
  emitFail("emitProgram: expected a `==`/`!=` over a nullable niche")
}

// The `nulstruct` arm of `emitNulNicheEq`. The struct core is RE-READ based by contract
// (`emitStructEq`: both operands must be pure re-reads, because every field compare
// re-evaluates the full chain from its root), so there is no single-evaluation form to preserve
// and the guard is spelled as two null TESTS instead of the `br_on_null` consume.
function emitNulStructEq(body: i32[], binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    // Asks the same two namespaces as the non-null dispatch, in the same order (niche rung
    // first) — asking only the struct one is how the nullable half drifts out of the
    // non-null half's capability. `siFound` is load-bearing, not decoration: an eq row is
    // `>= 0` for a struct and `< 0` for a variant, so `-1` is variant row 0 and cannot double as "no answer".
    let si = -1
    let siFound = false
    const nvi = binEqNulVariantRow(binIx, fnIx)
    if nvi >= 0 {
      si = eqRowOfVariant(nvi)
      siFound = true
    }
    if !siFound {
      const nsSi = structIndexOfExpr(e.binLeft, fnIx)
      if nsSi >= 0 {
        si = nsSi
        siFound = true
      }
    }
    if !siFound {
      return emitFail("emitProgram: struct equality over a non-struct operand")
    }
    fbBlock(127) // block i32 — $out
    ctrlEnter()
    if emitEqIsNull(body, e.binLeft, fnIx) < 0 { return -1 }
    if emitEqIsNull(body, e.binRight, fnIx) < 0 { return -1 }
    fbI32Bin(71) // 0x47 i32.ne — the two sides disagree on nullness
    fbIf(64)
    ctrlEnter()
    fbI32Const(0)
    fbBr(1) // → $out
    fbEnd()
    ctrlLeave()
    if emitEqIsNull(body, e.binLeft, fnIx) < 0 { return -1 }
    fbIf(64)
    ctrlEnter()
    fbI32Const(1) // both null ⇒ equal
    fbBr(1) // → $out
    fbEnd()
    ctrlLeave()
    const pathSi: i32[] = []
    const pathFi: i32[] = []
    if (
      emitStructEqRec(body, e.binLeft, e.binRight, si, pathSi, pathFi, fnIx) <
      0
    ) {
      return -1
    }
    fbEnd()
    ctrlLeave() // end $out
    return 0
  }
  emitFail("emitProgram: expected a nullable-struct equality")
}

// True for the `eqCmpKindOfTy` tokens that name a nullable ref niche — the ones whose
// compare needs `emitNulNicheEq`'s guard. The box- and sentinel-repped nullables answer ""
// from that function and are deliberately not here: they already compare tag-first correctly.
function eqKindIsNulNiche(k: EqCmpKind) {
  k == "nulstr" ||
    k == "nullist" ||
    k == "nulstrlist" ||
    k == "nulreflist" ||
    k == "nulglist" ||
    k == "nulstruct" ||
    k == "nulclosure"
}

// The nullable-niche token for this `==`/`!=`, or "" when neither operand is one. Reads
// the checker's banked type, which makes a narrowed operand fall out for free (inside
// `if a != null { a == b }` the banked type is already non-null); a bare `null` operand is
// excluded (owned by `emitNulIsNullTest`). Inside a monomorphized instance the banked type is a shared type variable instead, so `exprNulNicheKind`'s `fnIx`-scoped resolution answers there (D42).
function binEqNulNiche(binIx: i32, fnIx: i32): EqCmpKind {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      if P.nodes[unwrapParen(e.binLeft)] is NullLit { return "" }
      if P.nodes[unwrapParen(e.binRight)] is NullLit { return "" }
      const lk = eqCmpKindOfOperand(e.binLeft, fnIx)
      if eqKindIsNulNiche(lk) { return lk }
      const rk = eqCmpKindOfOperand(e.binRight, fnIx)
      if eqKindIsNulNiche(rk) { return rk }
    }
  }
  ""
}

// The emitter's half of the ONE comparability answer: true when a `==`/`!=` operand's rep has
// NO compare core. The checker rejects these (`unsupported-lowering`, off the same
// `eqCmpKindOfTy`), so this is the FLOOR — unreachable from accepted source, and the difference
// between a loud `emitProgram:` failure and the i32 tail emitting `i32.eq` over two refs.
function binEqHasNoLowering(binIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if P.nodes[unwrapParen(e.binLeft)] is NullLit { return false }
    if P.nodes[unwrapParen(e.binRight)] is NullLit { return false }
    return nodeEqCmpKind(e.binLeft) == "none" ||
      nodeEqCmpKind(e.binRight) == "none"
  }
  false
}

// The generic list compare's floor: true when the checker accepted the program on the
// generic core (`eqCmpKindOfTy` answered `glist`/`nulglist`) but the emitter cannot name
// the rep — an unresolved ref-list slot, operands at different slots, or the rep tables
// disagreeing with the arena about the element. Same shape and reason as `binConcatRepUnresolved` (D721): without it the fall-through is a silent `i32.eq` over two refs.
function binEqGRepUnresolved(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp != "==" && e.binOp != "!=" { return false }
    if P.nodes[unwrapParen(e.binLeft)] is NullLit { return false }
    if P.nodes[unwrapParen(e.binRight)] is NullLit { return false }
    // True only on the conjunction: the types say "two lists" and the rep side cannot name
    // their pair. Reads the banked types, not `nodeEqCmpKind` (D42), because inside a
    // monomorphized instance the operand nodes share the generic template — the banked
    // type is `T[]` (still a `TyArray`) where the token question goes blind ("").
    if !binPlusIsListByTy(nodeTyIxOf(e.binLeft), nodeTyIxOf(e.binRight)) {
      const tl = eqCoreKindOfTyToken(nodeEqCmpKind(e.binLeft))
      const tr = eqCoreKindOfTyToken(nodeEqCmpKind(e.binRight))
      if tl != 7 && tr != 7 { return false }
    }
    // A core's claim on the pair is trusted only when the rep-home classifier
    // (`catListKindOfExpr`) agrees which rep this is: `listOpKindOf` picks among only the
    // three old cores, so it can silently misclassify an unhandled rep (an `i64[]` falling
    // through to the i32 core) — a claim it cannot corroborate is not a claim. Reads zero on today's tree (D755) but guards the next rep added to one ladder and not the other.
    const lop = listOpKindOfBin(binIx, fnIx)
    if lop >= 0 {
      const ck = catListKindOfExpr(e.binLeft, fnIx)
      if ck >= 0 {
        // core 0 is the i32 list, core 3 the string list, core 4 a ref list of i32 lists.
        if lop == 0 && ck != 0 { return true }
        if lop == 3 && ck != 3 { return true }
        if lop == 4 && ck != 1 { return true }
      }
      return false
    }
    if eqgListKindOfBin(binIx, fnIx) >= 0 { return false }
    // A nullable niche runs the rep's own core under a guard, so a niche the guard claims
    // is a compare that already has one.
    if binEqNulNiche(binIx, fnIx) != "" { return false }
    return true
  }
  false
}

// The `+` twin of `binEqHasNoLowering` (D721): true when the checker's banked types say
// this `+` is a list concat and the emitter cannot resolve the pair to one (wrapper,
// backing) rep — different ref-list slots, or no list rep at all. Reads the banked types
// too, since `catListKindOfBin` answering -1 alone is not evidence of a list; only the conjunction is a failure, since an unguarded numeric tail would otherwise emit `i32.add` over two refs.
function binConcatRepUnresolved(binIx: i32, fnIx: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    if e.binOp != "+" { return false }
    if !binPlusIsListByTy(nodeTyIxOf(e.binLeft), nodeTyIxOf(e.binRight)) {
      return false
    }
    return catListKindOfBin(binIx, fnIx) < 0
  }
  false
}

// Lower a structural struct equality `a == b` (or `!=`) onto `body`, leaving a 0/1 i32:
// field-wise compare mirroring the host's `valueEq`. Both operands must be pure re-reads
// (names / field chains), since every field compare re-evaluates the full chain from its
// root. Takes `row` rather than re-deriving it — the caller already asked both namespaces (struct and variant) and knows which answered; re-asking loses that (`structIndexOfExpr` alone answers -1 for a variant operand).
function emitStructEq(body: i32[], binIx: i32, fnIx: i32, row: i32) {
  const e = P.nodes[binIx]
  if e is BinExpr {
    const pathSi: i32[] = []
    const pathFi: i32[] = []
    if (
      emitStructEqRec(body, e.binLeft, e.binRight, row, pathSi, pathFi, fnIx) <
      0
    ) {
      return -1
    }
    if e.binOp == "!=" {
      fbI32Eqz() // 0x45 i32.eqz — negate value-equality
    }
    return 0
  }
  emitFail("emitProgram: expected a struct equality")
}

// One shape's field-wise compare at path (`pathSi`/`pathFi` from the roots), leaving 0/1:
// an and-chain of per-field compares lowered as nested value-typed `if`s, so a first
// mismatch short-circuits. `si` is an eq row (`eqRowOfVariant`), so one core serves a
// standalone struct and a union arm alike — the two differ only in which table holds the layout.
function emitStructEqRec(
  body: i32[],
  lRoot: i32,
  rRoot: i32,
  si: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
) {
  const cnt = eqRowFieldCount(si)
  if cnt == 0 {
    fbI32Const(1)
    return 0
  }
  let fi = 0
  while fi < cnt {
    if emitStructEqField(body, lRoot, rRoot, si, fi, pathSi, pathFi, fnIx) < 0 {
      return -1
    }
    if fi < cnt - 1 {
      fbIf(127) // 0x04 if, 0x7f i32 blocktype — chain the next field
      ctrlEnter()
    }
    fi = fi + 1
  }
  // Close the chain: each opened `if` gets `else (i32.const 0) end`.
  let k = cnt - 1
  while k > 0 {
    fbElse() // 0x05 else
    fbI32Const(0)
    fbEnd()  // 0x0b end
    ctrlLeave()
    k = k - 1
  }
  0
}

// Compare ONE field at (si, fi) across the two chains, leaving 0/1. The path
// push/pop frames the inner compare so chains rewind for the next sibling field.
function emitStructEqField(
  body: i32[],
  lRoot: i32,
  rRoot: i32,
  si: i32,
  fi: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
) {
  pathSi.push(si)
  pathFi.push(fi)
  const r = emitStructEqFieldInner(
    body,
    lRoot,
    rRoot,
    si,
    fi,
    pathSi,
    pathFi,
    fnIx,
  )
  pathSi.pop()
  pathFi.pop()
  r
}

// `L.f == R.f` for a ref-niche field: `null == null` true, one side null false, else the
// non-null code's own core. Two null tests rather than `br_on_null`, since every inner arm
// re-reads its chain from the root. Opens the guard and leaves the both-non-null branch
// open for the caller to fill; paired with `emitNulFieldGuardClose`, split so leaf cores and the code-15 recursion can share one guard while differing on chain-read recovery.
function emitNulFieldGuardOpen(
  body: i32[],
  lRoot: i32,
  rRoot: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
) {
  if emitChainRead(body, lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
  wU8(209)      // 0xd1 ref.is_null
  fbIf(127)     // 0x04 if, 0x7f i32 blocktype — the left field was null
  ctrlEnter()
  if emitChainRead(body, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
  wU8(209)      // both null ⇒ equal
  fbElse()
  if emitChainRead(body, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
  wU8(209)
  fbIf(127)
  ctrlEnter()
  fbI32Const(0) // exactly one side null
  fbElse()
  0
}

function emitNulFieldGuardClose() {
  fbEnd()
  ctrlLeave()
  fbEnd()
  ctrlLeave()
  0
}

function emitNulFieldEq(
  body: i32[],
  lRoot: i32,
  rRoot: i32,
  si: i32,
  fi: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
  inner: i32,
) {
  if emitNulFieldGuardOpen(body, lRoot, rRoot, pathSi, pathFi, fnIx) < 0 {
    return -1
  }
  // Both sides non-null: the leaf core wants `(ref $H)`, and only the guard knows that.
  const savedRec = eqChainRecover
  eqChainRecover = true
  const ir = emitStructEqFieldAt(
    body,
    lRoot,
    rRoot,
    si,
    fi,
    pathSi,
    pathFi,
    fnIx,
    inner,
  )
  eqChainRecover = savedRec
  if ir < 0 { return -1 }
  emitNulFieldGuardClose()
}

function emitStructEqFieldInner(
  body: i32[],
  lRoot: i32,
  rRoot: i32,
  si: i32,
  fi: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
) {
  const code = eqRowFieldTypeAt(si, fi)
  const nulInner = nulFieldInnerCode(code)
  if nulInner >= 0 {
    return emitNulFieldEq(
      body,
      lRoot,
      rRoot,
      si,
      fi,
      pathSi,
      pathFi,
      fnIx,
      nulInner,
    )
  }
  emitStructEqFieldAt(body, lRoot, rRoot, si, fi, pathSi, pathFi, fnIx, code)
}

// The field-compare ladder, keyed by an EXPLICIT code so the null guard above can re-enter it
// at the non-null twin of a niche field.
function emitStructEqFieldAt(
  body: i32[],
  lRoot: i32,
  rRoot: i32,
  si: i32,
  fi: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
  code: i32,
) {
  // Codes 21 (`boolean | null`) and 30 (`K | null`) share the scalar arm (D101): their null
  // rides in the value space rather than beside it, using the same `0x7f i32` storagetype
  // code 0 does, so plain `i32.eq` already answers `null == null` true and `null == "a"`
  // false with no guard needed.
  if code == 0 || code == 21 || code == 30 {
    // Scalar (i32 / boolean), or an i32-sentinel niche field: a native compare.
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    fbI32Bin(70) // 0x46 i32.eq
    return 0
  }
  if code == 17 || code == 23 || code == 24 {
    // A wide numeric scalar field: one native compare opcode, i32 0/1 result. The two
    // ladders (this one and `emitVariantFieldEqCore`) must not disagree about a field rep
    // — `{d: i64}` compared inside an `A | i32` union but refused outside it before this
    // arm covered i64/f32 too (D1181); one arm now serves all three widths.
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    if code == 17 {
      fbI32Bin(97) // 0x61 f64.eq
    } else if code == 23 {
      fbI32Bin(81) // 0x51 i64.eq
    } else {
      fbI32Bin(91) // 0x5b f32.eq
    }
    return 0
  }
  if code == 3 {
    // String: the element-wise string-eq loop over the two field refs.
    if !aUsed {
      return emitFail(
        "emitProgram: string field equality but array type not collected",
      )
    }
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    return emitStrEqCore(body)
  }
  if code == 15 {
    // Nested struct: recurse one level deeper along the chain, under an unconditional null
    // guard (D1180) — `next: Node` and `next: Node | null` are both code 15 over the same
    // `(ref null $S)` slot, indistinguishable, so the guard must always run (a constant-false
    // `ref.is_null` on a never-null field). Chain reads stay raw inside it; a deeper field has its own guard.
    const nsi = eqRowTgtStructIdx(si, fi)
    if nsi < 0 {
      return emitFail(
        "emitProgram: nested struct field equality with no interned shape",
      )
    }
    if emitNulFieldGuardOpen(body, lRoot, rRoot, pathSi, pathFi, fnIx) < 0 {
      return -1
    }
    if emitStructEqRec(body, lRoot, rRoot, nsi, pathSi, pathFi, fnIx) < 0 {
      return -1
    }
    return emitNulFieldGuardClose()
  }
  if code == 4 {
    // `i32[]` list: lengths equal and element-wise equal — `len` from the wrapper (field
    // 1, the logical size; the backing may be longer), elements read off backings stashed
    // in two fresh `(ref null $aTypeIdx)` lazy-frame slots (`listBackStashSlot`, typed for
    // this rep). The i32 counters below still ride the string-op frame: plain i32 slots carrying no rep, safe to share.
    if !lUsed {
      return emitFail(
        "emitProgram: i32[] field equality but list type not collected",
      )
    }
    // lenL != lenR → 0, else the element loop.
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    fbStructGet(lTypeIdx, 1) // wrapper field 1: len
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    fbStructGet(lTypeIdx, 1)
    fbI32Bin(71)             // 0x47 i32.ne
    fbIf(127)                // 0x04 if, 0x7f i32 blocktype
    ctrlEnter()
    fbI32Const(0)            // length mismatch → 0
    fbElse()                 // 0x05 else — the element loop, like emitStrEqCore
    // A = backing(L.f); B = backing(R.f); I0 = len; I1 = 0
    const eqBkA = listBackStashSlot("i32", 0)
    const eqBkB = listBackStashSlot("i32", 0)
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    fbStructGet(lTypeIdx, 0) // backing
    fbLocalSet(eqBkA)
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    fbStructGet(lTypeIdx, 0)
    fbLocalSet(eqBkB)
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    fbStructGet(lTypeIdx, 1) // len
    setStrScrI(body, 0)
    fbBlock(127)             // 0x02 block, 0x7f i32 — yields the 0/1 result
    fbI32Const(0)
    setStrScrI(body, 1)      // I1 = 0
    fbLoop(64)               // 0x03 loop, void
    pushStrScrI(body, 1)
    pushStrScrI(body, 0)
    fbI32Bin(78)             // 0x4e i32.ge_s — done?
    fbIf(64)                 // then: fall through (all matched)
    fbElse()
    fbLocalGet(eqBkA)
    pushStrScrI(body, 1)
    fbArrayGet(aTypeIdx)
    fbLocalGet(eqBkB)
    pushStrScrI(body, 1)
    fbArrayGet(aTypeIdx)
    fbI32Bin(71)             // 0x47 i32.ne
    fbIf(64)                 // mismatch → 0, exit the result block
    fbI32Const(0)
    fbBr(3)                  // depths: if(0)·else(1)·loop(2)·block(3)
    fbEnd()
    pushStrScrI(body, 1)
    fbI32Const(1)
    fbI32Bin(106)            // i32.add
    setStrScrI(body, 1)
    fbBr(1)                  // continue the loop
    fbEnd()                  // end (else's if)
    fbEnd()                  // end (loop)
    fbI32Const(1)            // every element matched
    fbEnd()                  // end (result block)
    fbEnd()                  // end (length if/else)
    ctrlLeave()
    return 0
  }
  if code == 14 {
    // Function-valued field: identity compare (id + env) via the closure-eq frame.
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    return emitCloEqCore(body)
  }
  if code == 16 {
    // A value-union / struct-union box field compares exactly as the box does at top
    // level: tag first, then the arm the tag selects, reading the two boxes off a field
    // path instead of off two operands. Columns are resolved first, so an arm set the
    // core cannot serve declines before any byte is written and reaches the loud refusal below (D1290).
    const bxN = sFieldElemNameAt(si, fi)
    if bxN != "" {
      const bxArms: string[] = []
      const bxVis: i32[] = []
      const bxAks: i32[] = []
      if unionBoxEqColumns(bxN, bxArms, bxVis, bxAks) {
        if emitChainRead(body, lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
        if emitChainRead(body, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
        return emitUnionBoxEqStaged(
          body,
          bxArms,
          bxVis,
          bxAks,
          false,
          bxN,
          fnIx,
        )
      }
    }
  }
  if code == 5 {
    // A ref-list field compares exactly as a ref list does at top level: push the two
    // lists and hand them to the shared core, whose struct-element class already routes
    // to the stash-based `emitStructEqRec(body, -2, -3, …)`. The only addition here is
    // reading the two lists off a field path instead of off two operands (D1017).
    if si >= 0 {
      const d17n = sFieldElemNameAt(si, fi)
      if d17n != "" {
        const d17s = rlSlotByNameKeyTy(d17n, -1)
        if d17s >= 0 {
          if emitChainRead(body, lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
          if emitChainRead(body, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
          return emitListEqAnyRep(body, 1, d17s, fnIx)
        }
      }
    }
  }
  // A scalar-backed list field compares exactly as that list does at top level: read the
  // two lists off the field path and hand them to the generic core, whose frame
  // `leqNoteBin` reserved from the same map (`i32[]`, code 4, keeps its own arm above);
  // `f64[]`/`i64[]`/`string[]`/`f32[]`/`u8[]` fields get the same coverage here (D1020).
  const eqSk = eqScalarListFieldKind(code)
  if eqSk >= 0 {
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx) < 0 { return -1 }
    return emitListEqAnyRep(body, eqSk, 0, fnIx)
  }
  emitFail("emitProgram: unsupported struct field type in equality")
}

// Emit `clamp(idx, len)` where `idx` is in i32 temp `idxSlot` and `len` in temp
// `lenSlot`, leaving the clamped value on the stack — JS slice semantics: a negative
// index counts from the end (`len + idx`, floored at 0), a non-negative index is capped
// at `len` (`idx < 0 ? max(len+idx, 0) : min(idx, len)`), built from `select`.
function emitClampIdx(body: i32[], idxSlot: i32, lenSlot: i32) {
  // negCase = max(len+idx, 0) = select( len+idx, 0, (len+idx) > 0 )
  pushStrScrI(body, lenSlot)
  pushStrScrI(body, idxSlot)
  fbI32Bin(106) // i32.add → (len+idx)  [the `a` value]
  fbI32Const(0) // i32.const 0          [the `b` value]
  pushStrScrI(body, lenSlot)
  pushStrScrI(body, idxSlot)
  fbI32Bin(106) // i32.add → (len+idx)
  fbI32Const(0) // i32.const 0
  fbI32Bin(74)  // 0x4a i32.gt_s → (len+idx) > 0   [cond]
  wU8(27)       // 0x1b select → negCase on stack
  // nonNegCase = min(idx, len) = select( idx, len, idx < len )
  pushStrScrI(body, idxSlot) // a = idx
  pushStrScrI(body, lenSlot) // b = len
  pushStrScrI(body, idxSlot)
  pushStrScrI(body, lenSlot)
  fbI32Bin(72)               // 0x48 i32.lt_s → idx < len   [cond]
  wU8(27)                    // select → nonNegCase on stack
  // result = select( negCase, nonNegCase, idx < 0 )
  // Stack currently: [negCase, nonNegCase]; push cond then select.
  pushStrScrI(body, idxSlot)
  fbI32Const(0) // i32.const 0
  fbI32Bin(72)  // 0x48 i32.lt_s → idx < 0
  wU8(27)       // select → clamped value
  0
}

// Lower a string `s.slice(start, end)`, leaving the new string ref: a header only, sharing
// the receiver's backing (`struct.new $str (s.backing, s.start + start, len)`), O(1) with
// zero element copies. Safe by construction — no string element store and no `ref.eq` on a
// string exist anywhere in the emitter, so a view and a copy are indistinguishable — but a view keeps its whole backing alive; `compact()` is the documented escape (§Header).
function emitStrSlice(body: i32[], callIx: i32, fnIx: i32) {
  if !aUsed {
    return emitFail("emitProgram: string slice but array type not collected")
  }
  const c = P.nodes[callIx]
  if c is Call {
    if c.callArgs.length != 2 {
      return emitFail(
        "emitProgram: string .slice takes exactly two arguments (start, end)",
      )
    }
    const callee = P.nodes[c.callFn]
    if callee is Member {
      // Eval receiver + both args onto the stack first (nested string ops complete),
      // then stash: end on top → I1, then start → I0, then receiver → strScrA.
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      if emitExpr(body, c.callArgs[1], fnIx) < 0 { return -1 }
      setStrScrI(body, 1)            // raw end → I1
      setStrScrI(body, 0)            // raw start → I0
      fbLocalSet(strScratchBase + 0) // local.set strScrA (receiver)
      // I2 = len(s) — the HEADER's `len` (field 2). `array.len` here would be the BACKING's
      // physical length, so a slice of a slice would clamp against its parent's extent.
      pushStrScrRef(body, 0)
      fbStrLen()
      setStrScrI(body, 2)
      // I0 = clamp(rawStart, len)
      if emitClampIdx(body, 0, 2) < 0 { return -1 }
      setStrScrI(body, 0)
      // I1 = clamp(rawEnd, len)
      if emitClampIdx(body, 1, 2) < 0 { return -1 }
      setStrScrI(body, 1)
      // I3 = out length = max(end - start, 0) = select( end-start, 0, end > start )
      pushStrScrI(body, 1)
      pushStrScrI(body, 0)
      fbI32Bin(107) // 0x6b i32.sub → end - start   [a]
      fbI32Const(0) // i32.const 0                  [b]
      pushStrScrI(body, 1)
      pushStrScrI(body, 0)
      fbI32Bin(74)  // 0x4a i32.gt_s → end > start  [cond]
      wU8(27)       // 0x1b select
      setStrScrI(body, 3)
      // The VIEW: same backing, start biased by the receiver's own start, len = I3. This is
      // the whole lowering now — no allocation of elements, no copy.
      pushStrScrRef(body, 0)
      fbStrBack()          // field 0: the SHARED backing
      pushStrScrRef(body, 0)
      fbStrStart()         // field 1: the receiver's own start …
      pushStrScrI(body, 0)
      fbI32Bin(106)        // 0x6a i32.add — … plus the clamped slice start
      pushStrScrI(body, 3) // field 2: len = max(end - start, 0)
      fbStrNew()           // 0xfb 0x00 <string header>
      return 0
    }
    return emitFail(
      "emitProgram: string .slice receiver is not a member access",
    )
  }
  emitFail("emitProgram: expected a string slice call")
}

// Lower `s.indexOf(sub)` (or `s.includes(sub)`), leaving an i32: the first index of `sub`
// in `s`, or -1 (empty `sub` yields 0, the JS convention); `includes` is `indexOf != -1`.
// An outer loop per verify attempt wraps a skip loop that hoists `B[0]` to advance to the
// next matching-first-character start in one load, then a verify loop over the rest — both the empty-needle short-circuit and the too-long-needle guard are load-bearing for that hoist.
function emitStrIndexOf(body: i32[], callIx: i32, fnIx: i32) {
  if !aUsed {
    return emitFail("emitProgram: string indexOf but array type not collected")
  }
  const c = P.nodes[callIx]
  if c is Call {
    if c.callArgs.length != 1 {
      return emitFail("emitProgram: string .indexOf takes exactly one argument")
    }
    const callee = P.nodes[c.callFn]
    if callee is Member {
      const isIncludes = callee.memProp == "includes"
      // Eval receiver + needle onto the stack first (nested string ops complete),
      // then stash: needle on top → B, then receiver → A.
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      fbLocalSet(strScratchBase + 1) // local.set strScrB (sub)
      fbLocalSet(strScratchBase + 0) // local.set strScrA (s)
      // Hoist both headers' backing + start before the search — every one of the three
      // loops below reads one or both operands per trip (§Header: hoist in codegen).
      hoistStrScr(body, 0)
      hoistStrScr(body, 1)
      // I3 = len(sub); I2 = len(s) - len(sub), the last start the needle fits at. Both are
      // the HEADER's `len` (field 2): `array.len` would be the shared backing's extent, so a
      // needle that is a VIEW would report its parent's length and the scan would run off it.
      pushStrScrRef(body, 1)
      fbStrLen()
      setStrScrI(body, 3)
      pushStrScrRef(body, 0)
      fbStrLen()
      pushStrScrI(body, 3)
      fbI32Bin(107) // 0x6b i32.sub
      setStrScrI(body, 2)
      fbBlock(127)  // 0x02 block, 0x7f i32 blocktype — yields index / -1
      // Empty needle → 0. This is also what makes the hoisted B[0] below safe.
      pushStrScrI(body, 3)
      fbI32Const(0)
      fbI32Bin(70) // 0x46 i32.eq
      fbIf(64)     // 0x04 if, 0x40 void blocktype
      fbI32Const(0)
      fbBr(1)      // → out of the i32 block
      fbEnd()
      // Needle longer than haystack → -1 (no start exists).
      pushStrScrI(body, 2)
      fbI32Const(0)
      fbI32Bin(72)        // 0x48 i32.lt_s
      fbIf(64)
      fbI32Const(-1)
      fbBr(1)             // → out of the i32 block
      fbEnd()
      fbI32Const(0)
      setStrScrI(body, 0) // I0 = 0
      fbLoop(64)          // 0x03 loop (outer) — one trip per verify attempt
      // I1 = B[0]: the character every candidate start has to carry.
      pushStrScrBase(body, 1) // needle backing + its start …
      fbArrayGet(sBackIdx)    // … which IS the offset of B[0]
      setStrScrI(body, 1)
      fbLoop(64)              // 0x03 loop (skip) — advance to the next candidate
      // Past the last possible start → no match.
      pushStrScrI(body, 0)
      pushStrScrI(body, 2)
      fbI32Bin(74) // 0x4a i32.gt_s
      fbIf(64)
      fbI32Const(-1)
      fbBr(3)      // depths: if(0)·skip(1)·outer(2)·block(3)
      fbEnd()
      // A[I0] != B[0] → not a candidate: advance and keep skipping. ONE load.
      pushStrScrElem(body, 0, 0)
      pushStrScrI(body, 1)
      fbI32Bin(71)  // 0x47 i32.ne
      fbIf(64)
      pushStrScrI(body, 0)
      fbI32Const(1)
      fbI32Bin(106) // 0x6a i32.add
      setStrScrI(body, 0)
      fbBr(1)       // → skip loop header
      fbEnd()
      fbEnd()       // 0x0b end (skip loop) — falls through with A[I0]==B[0]
      // I1 = 1: B[0] already matched, so verification starts at index 1.
      fbI32Const(1)
      setStrScrI(body, 1)
      fbLoop(64) // 0x03 loop (verify)
      // I1 >= len(sub) → full match at I0: yield I0 out of the i32 block.
      pushStrScrI(body, 1)
      pushStrScrI(body, 3)
      fbI32Bin(78) // 0x4e i32.ge_s
      fbIf(64)
      pushStrScrI(body, 0)
      fbBr(3)      // depths: if(0)·verify(1)·outer(2)·block(3)
      fbEnd()
      // A[I0+I1] != B[I1] → mismatch: advance I0 and re-enter the skip loop.
      pushStrScrBase(body, 0)
      pushStrScrI(body, 0)
      fbI32Bin(106)              // 0x6a i32.add — startA + I0
      pushStrScrI(body, 1)
      fbI32Bin(106)              // 0x6a i32.add — … + I1
      fbArrayGet(sBackIdx)       // 0xfb 0x0b array.get
      pushStrScrElem(body, 1, 1) // B[I1]
      fbI32Bin(71)               // 0x47 i32.ne
      fbIf(64)
      pushStrScrI(body, 0)
      fbI32Const(1)
      fbI32Bin(106)              // i32.add
      setStrScrI(body, 0)        // I0 = I0 + 1
      fbBr(2)                    // 0x0c br depth 2 → outer loop header
      fbEnd()                    // 0x0b end (mismatch if)
      // I1 = I1 + 1; br verify loop
      pushStrScrI(body, 1)
      fbI32Const(1)
      fbI32Bin(106)  // i32.add
      setStrScrI(body, 1)
      fbBr(0)        // 0x0c br depth 0 → verify loop header
      fbEnd()        // 0x0b end (verify loop)
      fbEnd()        // 0x0b end (outer loop)
      fbI32Const(-1) // block result; the skip loop owns the real exhaustion exit
      fbEnd()        // 0x0b end (block) — leaves the i32 result
      if isIncludes {
        fbI32Const(-1)
        fbI32Bin(71) // 0x47 i32.ne — `includes` ≡ `indexOf(sub) != -1`
      }
      return 0
    }
    return emitFail(
      "emitProgram: string .indexOf receiver is not a member access",
    )
  }
  emitFail("emitProgram: expected a string indexOf call")
}

// Lower `s.charCodeAt(i)` onto `body`, leaving the char code i32: a guarded
// `backing[start + i]` over the code-point backing, so an out-of-range index traps —
// matching the host's `s[i]` semantics (no JS NaN). The guard is what keeps the trap: the
// backing outlives the view, so `array.get`'s own bounds check is not the view's bound.
function emitStrCharCode(body: i32[], callIx: i32, fnIx: i32) {
  if !aUsed {
    return emitFail(
      "emitProgram: string charCodeAt but array type not collected",
    )
  }
  const c = P.nodes[callIx]
  if c is Call {
    if c.callArgs.length != 1 {
      return emitFail(
        "emitProgram: string .charCodeAt takes exactly one argument",
      )
    }
    const callee = P.nodes[c.callFn]
    if callee is Member {
      // The SAME guarded `backing[start + i]` shape `s[i]` gets, INCLUDING the loop-hoist
      // arm — the two are one operation spelled twice (`emitIndex`'s string arm is the
      // sibling ladder), and Stage 2b keeps them reading through ONE pair of helpers so they
      // cannot drift into different bounds rules or different hoisting.
      const ccHz = liveHoistRow(callee.memObj, "i32", 0 - 1)
      if ccHz < 0 {
        if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      }
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      if ccHz >= 0 { emitStrIdxGuardHoisted(ccHz) } else { emitStrIdxGuard() }
      fbArrayGet(sBackIdx) // 0xfb 0x0b array.get
      return 0
    }
    return emitFail(
      "emitProgram: string .charCodeAt receiver is not a member access",
    )
  }
  emitFail("emitProgram: expected a string charCodeAt call")
}

// ── the code-point trio: `cpAt` / `cpLen` / `isCharBoundary` ──────────────────
// All three read the UTF-8 storage directly, which is why they are core intrinsics rather
// than `std:str` functions — nothing writable in VL can see a byte as anything but a byte.
// They ride the same lazy stash `s[i]` uses, so they need no `exprHasStrOp` reservation arm.

// Stash [receiver, index] off the wasm stack into the shared header/index slots. On entry
// BOTH are fully evaluated (a nested string index inside either has already come and gone
// through these slots — the nested-op discipline `strHdrSlot`'s header states). Returns the
// header slot; the index is at `listIdxScratchBase`.
function stashStrRecvIdx(_body: i32[]) {
  const hs = strHdrSlot()
  fbLocalSet(listIdxScratchBase) // the index
  fbLocalSet(hs)                 // the header
  hs
}

// Push the header's one-past-the-end BACKING offset, `start + len` — `__utf8_dec__`'s bound,
// and the reason a sequence that runs off the end of a VIEW decodes to U+FFFD instead of
// reading its sibling view's bytes.
function pushStrHdrEnd(_body: i32[], hs: i32) {
  fbLocalGet(hs)
  fbStrStart()
  fbLocalGet(hs)
  fbStrLen()
  fbI32Bin(106) // 0x6a i32.add
  0
}

// Push the guarded BACKING offset of byte `i`: `start + i` when `i u< len`, else `-1`. The
// SAME select `emitStrIdxGuard` builds, so an out-of-range `cpAt` traps exactly where an
// out-of-range `s[i]` does rather than decoding a neighbour's bytes.
function pushStrGuardedOff(_body: i32[], hs: i32) {
  fbLocalGet(hs)
  fbStrStart()
  fbLocalGet(listIdxScratchBase)
  fbI32Bin(106)  // i32.add → start + i
  fbI32Const(-1) // the out-of-range replacement offset
  fbLocalGet(listIdxScratchBase)
  fbLocalGet(hs)
  fbStrLen()
  fbI32Bin(73)   // 0x49 i32.lt_u — covers negative and past-len in one compare
  wU8(27)        // 0x1b select
  0
}

// Lower `s.cpAt(i)` — the code point whose UTF-8 sequence BEGINS at byte offset `i`, O(1).
// `__utf8_dec__` returns `(width << 24) | cp`; only the code point is wanted here, so the
// width is masked off. Offset `i` landing mid-sequence is not an error (§Validity): the byte
// there is a continuation byte, which begins nothing, so the answer is U+FFFD.
function emitStrCpAt(body: i32[], callIx: i32, fnIx: i32) {
  if !aUsed {
    return emitFail("emitProgram: string cpAt but array type not collected")
  }
  const c = P.nodes[callIx]
  if c is Call {
    if c.callArgs.length != 1 {
      return emitFail("emitProgram: string .cpAt takes exactly one argument")
    }
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      const hs = stashStrRecvIdx(body)
      fbLocalGet(hs)
      fbStrBack()
      pushStrGuardedOff(body, hs)
      pushStrHdrEnd(body, hs)
      fbCall(gHelpUtf8Dec)
      fbI32Const(16777215) // 0x00ffffff — drop the width, keep the code point
      fbI32Bin(113)        // 0x71 i32.and
      return 0
    }
    return emitFail("emitProgram: string .cpAt receiver is not a member access")
  }
  emitFail("emitProgram: expected a string cpAt call")
}

// Lower `s.cpLen()` — the code-point count, one call into `__utf8_cplen__`. O(n), and the
// call site says so.
function emitStrCpLen(body: i32[], callIx: i32, fnIx: i32) {
  if !aUsed {
    return emitFail("emitProgram: string cpLen but array type not collected")
  }
  const c = P.nodes[callIx]
  if c is Call {
    if c.callArgs.length != 0 {
      return emitFail("emitProgram: string .cpLen takes no arguments")
    }
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      fbCall(gHelpUtf8CpLen)
      return 0
    }
    return emitFail(
      "emitProgram: string .cpLen receiver is not a member access",
    )
  }
  emitFail("emitProgram: expected a string cpLen call")
}

// Lower `s.isCharBoundary(i)` (Rust's primitive, O(1)): does byte `i` begin a UTF-8
// sequence? True at `len`, false past `len` or below 0, else the lead/continuation bit
// test. Deliberately does not special-case index 0 the way Rust does — a VL string is not
// guaranteed valid (§Validity), so a view like `"é→".slice(1, 4)` can start on a continuation byte, and answering `true` at 0 unconditionally would report a boundary that is not one.
function emitStrIsCharBoundary(body: i32[], callIx: i32, fnIx: i32) {
  if !aUsed {
    return emitFail(
      "emitProgram: string isCharBoundary but array type not collected",
    )
  }
  const c = P.nodes[callIx]
  if c is Call {
    if c.callArgs.length != 1 {
      return emitFail(
        "emitProgram: string .isCharBoundary takes exactly one argument",
      )
    }
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      const hs = stashStrRecvIdx(body)
      // i == len — the end of the VIEW, never of the backing.
      fbLocalGet(listIdxScratchBase)
      fbLocalGet(hs)
      fbStrLen()
      fbI32Bin(70) // 0x46 i32.eq
      fbIf(127)    // if (result i32)
      fbI32Const(1)
      fbElse()
      // In range? (one unsigned compare covers negative and past-len.)
      fbLocalGet(listIdxScratchBase)
      fbLocalGet(hs)
      fbStrLen()
      fbI32Bin(73)  // 0x49 i32.lt_u
      fbIf(127)
      fbLocalGet(hs)
      fbStrBack()
      fbLocalGet(hs)
      fbStrStart()
      fbLocalGet(listIdxScratchBase)
      fbI32Bin(106) // i32.add
      fbArrayGet(sBackIdx)
      fbI32Const(192)
      fbI32Bin(113) // i32.and
      fbI32Const(128)
      fbI32Bin(71)  // 0x47 i32.ne
      fbElse()
      fbI32Const(0)
      fbEnd()
      fbEnd()
      return 0
    }
    return emitFail(
      "emitProgram: string .isCharBoundary receiver is not a member access",
    )
  }
  emitFail("emitProgram: expected a string isCharBoundary call")
}

// Lower `s.bytes()` — one call into `__str_bytes__`, which `array.copy`s the view's byte
// range into a fresh `u8[]`. `ba8Used` is forced by `scanPrintUse`'s `.bytes()` arm, the
// only thing that makes the packed pair exist for a program that spells no `u8[]`.
function emitStrBytes(body: i32[], callIx: i32, fnIx: i32) {
  if !aUsed || !ba8Used || gHelpStrBytes < 0 {
    return emitFail(
      "emitProgram: string bytes() but the packed byte-list types were not collected",
    )
  }
  const c = P.nodes[callIx]
  if c is Call {
    if c.callArgs.length != 0 {
      return emitFail("emitProgram: string .bytes takes no arguments")
    }
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      fbCall(gHelpStrBytes)
      return 0
    }
    return emitFail(
      "emitProgram: string .bytes receiver is not a member access",
    )
  }
  emitFail("emitProgram: expected a string bytes call")
}

export function emitExpr(body: i32[], exprIx: i32, fnIx: i32) {
  // Stop after a recorded failure: `emitFail` banks the first message and returns -1 but
  // does not halt the pass, so a caller that drops the -1 keeps emitting over invalidated
  // state until an unguarded parallel-table read traps and kills the compiler before the
  // diagnostic prints. Checking the flag at the two recursion roots makes a failure terminal wherever it happened, instead of relying on every caller in between to thread -1 outward.
  if emitFailed { return -1 }
  if exprIx < 0 { return emitFail("emitProgram: missing expression") }
  // A string-repped literal union reaching an atom-typed destination narrows to its
  // interned id here — one hook rather than one per destination, since `pendingLitUnion`
  // is already the context every atom-typed slot seeds. Without it the store is a
  // `local.set` of a `(ref $array)` into an `i32` slot: invalid wasm at every such destination.
  if pendingLitUnion == 1 {
    if strReppedLitUnionAt(exprIx, fnIx) {
      return emitStrToAtom(body, unwrapParen(exprIx), fnIx)
    }
  }
  const e = P.nodes[exprIx]
  if e is NumLit { return emitNumLitNode(body, e, exprIx, fnIx) }
  if e is BoolLit {
    // `boolean` rides in an i32: true=1, false=0 (already decoded into `boolVal`).
    fbI32Const(e.boolVal)
    return 0
  }
  if e is CharLit { return emitCharLitNode(body, e, exprIx, fnIx) }
  if e is Ident { return emitIdentNode(body, e, exprIx, fnIx) }
  if e is Paren { return emitExpr(body, e.parInner, fnIx) }
  if e is Unary { return emitUnaryNode(body, e, exprIx, fnIx) }
  if e is AsExpr { return emitAsCast(body, e, exprIx, fnIx) }
  if e is Call { return emitCallNode(body, e, exprIx, fnIx) }
  if e is IsExpr { return emitIs(body, exprIx, fnIx) }
  if e is NullLit { return emitNullLitNode(body, e, exprIx, fnIx) }
  if e is ObjLit { return emitObjLitNode(body, e, exprIx, fnIx) }
  if e is StrLit {
    // A literal-union MEMBER in atom context (`pendingLitUnion`) lowers as its interned i32 id.
    if pendingLitUnion == 1 {
      fbI32Const(internAtom(e.strText))
      return 0
    }
    return emitStr(body, exprIx, fnIx)
  }
  if e is ArrayLit { return emitArr(body, exprIx, fnIx) }
  if e is Index {
    // G8: a map GET `m[k]` (no `??`) — scan, value or 0. A `??` get is fused in the
    // BinExpr branch below (it carries the default).
    if exprMap(e.idxArr, fnIx) {
      // A union-valued map (mv kind 2) reads through the null-tagged box, the same lowering
      // the `const t = m[k]` binding arm takes: a bare `ref.null` miss would leave a
      // consumer's `struct.get $uBox 0` (the tag read) reading a null reference on `m[k] is
      // T`, `!= null`, `== null` and `print(m[k])` alike. The box is the read's own null.
      const ubs = mapReadNarrowableSlot(exprIx, fnIx)
      if ubs >= 0 && mvValKind[ubs] == 2 {
        if emitMapGetUnionBox(body, e.idxArr, e.idxIndex, fnIx) < 0 {
          return -1
        }
        return emitNarrowedMapReadTail(exprIx, fnIx)
      }
      if emitMapGet(body, e.idxArr, e.idxIndex, fnIx) < 0 { return -1 }
      return emitNarrowedMapReadTail(exprIx, fnIx)
    }
    return emitIndex(body, exprIx, fnIx)
  }
  if e is Member { return emitMemberNode(body, e, exprIx, fnIx) }
  // A STANDALONE `?.` (one no enclosing `?? d` / null-test pattern consumed) yields its
  // own `F | null` value — see `emitOptMemberValue`.
  if e is OptMember { return emitOptMemberValue(body, exprIx, fnIx) }
  if e is BinExpr { return emitBinExprNode(body, e, exprIx, fnIx) }
  if e is FuncDecl {
    // An anonymous `function(...)` literal in value position, lifted to a top-level
    // function by `collectFns` (keeping its name). Construct its closure value.
    const fe = fnStmtsPosOf(exprIx)
    if fe >= 0 { return emitClosureValue(body, fe, fnIx) }
    return emitFail("emitProgram: function literal not lifted")
  }
  if e is IfStmt {
    // An IF-EXPRESSION in value position (`if c { 7 } else { 9 }` — the parser wraps
    // each arm as a one-statement Block; an `else if` chain nests an IfStmt in the
    // else slot). Lowered as `if (result i32)` over the arm VALUES.
    return emitIfExpr(body, exprIx, fnIx)
  }
  // The catch-all must name the expression, not a position: a message written for one
  // caller (the return arm) but reached from anywhere reads as though every unhandled
  // expression happened there. `emitFailAt` puts the caret on the offending node instead,
  // the way every caller that has the node already does.
  emitFailAt("emitProgram: unsupported expression", exprIx)
}

// Lower an if-expression (`if c then a else b` in value position) onto `body`: cond,
// `if (result <kind>)`, the then-arm value, else the else-arm value (an `else if` chain
// recurses). Both arms are coerced to the branch-join's scalar rep (a mixed `then 1 else
// 2.5` widens to f64); a ref-typed join (string/struct/array) routes to `emitIfExprRef` instead, for the multi-byte `(ref $ht)` blocktype a single numeric byte cannot spell.
function emitIfExpr(body: i32[], ifIx: i32, fnIx: i32) {
  const rk = ifExprRefKind(ifIx, fnIx)
  if rk != null {
    return emitIfExprRef(body, ifIx, fnIx, rk, ifExprRefSlot(ifIx, fnIx, rk))
  }
  emitIfExprAs(body, ifIx, fnIx, ifExprValtype(ifIx, fnIx))
}

// Lower a ref-typed if-expression join (string / struct / array) as a value-typed `if`
// with the multi-byte `(ref $ht)` blocktype (`fbValtype`), each arm emitted in that rep.
// Mirrors `emitIfExprAs` (narrowing save/restore, `else if` recursion), except the arm
// emitter re-seeds the per-arm construction context so an `ObjLit`/list-literal arm builds the right shape.
function emitIfExprRef(
  body: i32[],
  ifIx: i32,
  fnIx: i32,
  kind: VKind,
  slot: i32,
) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    // An else-less `if` used as a value is `T | null` (DECISIONS.md "An else-less `if`
    // used as a value"): the false path yields `null`, so the join is nullable and the
    // missing arm is the rep's own null. The blocktype below and the else arm at the bottom are that one fact, twice.
    const noElse = s.ifElse < 0
    if emitExpr(body, s.ifCond, fnIx) < 0 { return -1 }
    wU8(4) // 0x04 if
    // A join the checker typed `T | null` (one arm `null`, or absent) needs a nullable
    // blocktype, else that arm's `(ref null $ht)` mismatches the non-null result.
    // `nodeTyIsNullable` reads the checker's recorded join type as one generic signal for
    // every ref kind, rather than per-kind — a non-nullable join, or a binding whose arms are both non-null, stays non-null and widens on store.
    const nulJoin = noElse || nodeTyIsNullable(ifIx)
    if nulJoin {
      fbValtypeNullable(kind, slot) // `(ref null $ht)` result blocktype
    } else {
      fbValtype(kind, slot) // ref result blocktype `(ref $ht)`
    }
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const rcT = emitRefIfArm(body, s.ifThen, fnIx, kind, slot, nulJoin)
    if narrowed { restoreNarrow(savedTop) }
    if rcT < 0 { return -1 }
    fbElse() // 0x05 else
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    let rc = 0
    if noElse {
      // The synthesized false path: the rep's own null, matching the nullable blocktype
      // above. `fbRefNullOfKind` is `fbValtypeNullable`'s VALUE twin, so the declaration
      // and the value cannot name different heap types.
      rc = fbRefNullOfKind(kind, slot)
    } else {
      const els = P.nodes[s.ifElse]
      if els is IfStmt {
        rc = emitIfExprRef(body, s.ifElse, fnIx, kind, slot)
      } else {
        rc = emitRefIfArm(body, s.ifElse, fnIx, kind, slot, nulJoin)
      }
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    return 0
  }
  emitFail("emitProgram: expected an if expression")
}

// ── if-expression arm prelude ─────────────────────────────────────────────────
// An if-expression arm is a block whose value is its last statement; every statement
// before it is the prelude, which is what lets a binding arm sit in value position (the
// desugared `match u { A{a} => a }` shape). `emitIfArmOpen` pushes the frame and lowers the prelude; the caller emits the value and closes with `emitIfArmClose`, split in two because each arm emitter lowers the value differently while the prelude and frame are shared.

// Push the arm's lexical frame and lower every statement before the arm's value. Returns
// 0, or -1 (the caller still owes `emitIfArmClose`). A non-empty prelude is lowered only
// when `collectLocalsIf` walked this arm (`armPreludeBlocks`) — the walk that allocated the
// arm's locals; an if-expression the collect pass never descended into is rejected here rather than lowered against slots that belong to something else.
function emitIfArmOpen(body: i32[], blockIx: i32, fnIx: i32) {
  scopePush()
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    if stmts.length > 1 {
      if !armPreludeWalked(blockIx) {
        return emitFail(
          "emitProgram: an if-expression arm that declares a local is supported only as a binding initializer inside a function",
        )
      }
    }
    let i = 0
    while i + 1 < stmts.length {
      if emitStmt(body, stmts[i], fnIx) < 0 { return -1 }
      i = i + 1
    }
  }
  0
}

// True if the collect pass allocated the prelude locals of the arm block at `blockIx`.
function armPreludeWalked(blockIx: i32) {
  let i = 0
  while i < armPreludeBlocks.length {
    if armPreludeBlocks[i] == blockIx { return true }
    i = i + 1
  }
  false
}

// Pop the arm's lexical frame, passing `rc` through so an arm emitter can close and
// return in one expression.
function emitIfArmClose(rc: i32) {
  scopePop()
  rc
}

// The `emitFail` reason for an if-expression arm with no value on the stack: an empty arm
// (no value expression at all), a void call (a well-formed expression yielding nothing), or
// a real statement, each get their own message — "not a single value" would be wrong for
// the void-call case, since such an arm IS a single expression. `what` names the arm flavour so union and variant joins keep their own rep in the text.
function ifArmNoValueFail(what: string, blockIx: i32) {
  const tv = ifArmValueExpr(blockIx)
  if tv < 0 {
    return emitFail("emitProgram: " + what + " is empty, so it yields no value")
  }
  const s = P.nodes[unwrapParen(tv)]
  if s is Call {
    return emitFail(
      "emitProgram: " +
        what +
        " ends in a void call, which yields no value",
    )
  }
  emitFail(
    "emitProgram: " + what + " ends in a statement, which yields no value",
  )
}

// One arm of a ref-typed if-expression: its prelude, then its tail-value statement emitted
// in the join rep. Re-seeds `pendingStructIdx` (struct arms) / `pendingListKind` +
// `pendingListSlot` (ref-list arms) after the prelude, since the previous arm's emit or a
// prelude statement can consume the pending seed. `nulJoin` is threaded from the caller rather than re-derived, so the declaration and the arm's recover cannot disagree about nullness (D1577).
function emitRefIfArm(
  body: i32[],
  blockIx: i32,
  fnIx: i32,
  kind: VKind,
  slot: i32,
  nulJoin: boolean,
) {
  const b = P.nodes[blockIx]
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if ifArmIsValue(tv, fnIx) {
        if emitIfArmOpen(body, blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        // A bare `null` arm lowers as the join's own null, not through `emitNullLitNode`'s
        // seed ladder: `fbRefNullOfKind` is `fbValtypeNullable`'s value twin, so the arm and
        // the blocktype cannot name different heap types. Without it an explicit
        // `else { null }` refuses at every ref kind whose null no boundary seed carries (D1560), while the else-less spelling of the same value keeps working.
        if P.nodes[unwrapParen(tv)] is NullLit {
          return emitIfArmClose(fbRefNullOfKind(kind, slot))
        }
        if kind == "struct" { pendingStructIdx = slot }
        if kind == "reflist" {
          pendingListKind = 5
          pendingListSlot = slot
        }
        // An ATOM arm in a `string` join widens to its member string (the atom is a
        // bare i32 id; the join blocktype is the string ref) — the if-expression seam
        // of the atom-as-string-subtype widen (`retStrWiden` at returns).
        if kind == "str" && exprIsLitAtom(tv, fnIx) {
          return emitIfArmClose(emitAtomToStr(body, tv, fnIx))
        }
        // A non-null blocktype is a delivery (D1577), so an arm whose rep is the join
        // kind's nullable niche owes the same `ref.as_non_null` the return / argument /
        // binding boundaries make (`nulNicheRecoverOwed`) — a nested-struct field stores
        // `(ref null $S)` though its type is not nullable, so an unrecovered arm pushes that under a `(ref $S)` result: invalid wasm. Under a nullable blocktype nothing is owed.
        const rcV = emitExpr(body, tv, fnIx)
        if rcV >= 0 && !nulJoin {
          if nulNicheRecoverOwed(kind, tv, fnIx) { fbRefAsNonNull() }
        }
        return emitIfArmClose(rcV)
      }
    }
    return ifArmNoValueFail("if-expression arm", blockIx)
  }
  emitFail("emitProgram: if-expression arm is not a block")
}

// Lower the if-expression at `ifIx` with a known blocktype byte `kind`, threading it
// through the `else if` recursion so the whole chain shares one result rep.
function emitIfExprAs(body: i32[], ifIx: i32, fnIx: i32, kind: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    // An else-less `if` used as a value is `T | null` (DECISIONS.md "An else-less `if`
    // used as a value"). In the i32-blocktype family the false path is a niche sentinel —
    // 2 for `boolean | null`, -1 for a nullable literal union — the same values
    // `emitNullLitNode` writes for a bare `null` there; a bare numeric join has no such spare value, so it keeps the loud refusal rather than inventing a sentinel in an i32.
    const noElseNiche = s.ifElse < 0
    if noElseNiche {
      if !nodeTyIsNulBool(ifIx) && !nodeTyIsNulLitUnion(ifIx) {
        return emitFail("emitProgram: if-expression requires an else arm")
      }
    }
    if emitExpr(body, s.ifCond, fnIx) < 0 { return -1 }
    fbIf(kind) // 0x04 if, <kind> result blocktype
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const rcT = emitBlockValueAs(body, s.ifThen, fnIx, kind)
    if narrowed { restoreNarrow(savedTop) }
    if rcT < 0 { return -1 }
    fbElse()   // 0x05 else
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    let rc = 0
    if noElseNiche {
      if nodeTyIsNulBool(ifIx) { fbI32Const(2) } else { fbI32Const(0 - 1) }
    } else {
      const els = P.nodes[s.ifElse]
      if els is IfStmt {
        rc = emitIfExprAs(body, s.ifElse, fnIx, kind)
      } else {
        // The explicit `else { null }` spelling reaches `emitNullLitNode`, whose niche arms
        // need a boundary seed an un-annotated binding initializer never sets (D1560) — seed
        // `pendingNulBool`/`pendingNulLitUnion` from the join's own type here, scoped to a bare-`null` tail so no other value in the arm can read it.
        const savedNB = pendingNulBool
        const savedNL = pendingNulLitUnion
        const enull = ifArmValueExpr(s.ifElse)
        if enull >= 0 {
          if P.nodes[unwrapParen(enull)] is NullLit {
            if nodeTyIsNulBool(ifIx) { pendingNulBool = true }
            if nodeTyIsNulLitUnion(ifIx) { pendingNulLitUnion = true }
          }
        }
        rc = emitBlockValueAs(body, s.ifElse, fnIx, kind)
        pendingNulBool = savedNB
        pendingNulLitUnion = savedNL
      }
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    return 0
  }
  emitFail("emitProgram: expected an if expression")
}

// The VALUE of an if-expression arm: its prelude, then its tail-value statement emitted
// as an expression COERCED to the if-expression's result rep `kind` (so an i32-literal
// arm widens into an f64/f32/i64 join). The i32 default emits the value as-is.
function emitBlockValueAs(body: i32[], blockIx: i32, fnIx: i32, kind: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if ifArmIsValue(tv, fnIx) {
        if emitIfArmOpen(body, blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        if kind == 124 { return emitIfArmClose(emitExprAsF64(body, tv, fnIx)) }
        if kind == 125 { return emitIfArmClose(emitExprAsF32(body, tv, fnIx)) }
        if kind == 126 { return emitIfArmClose(emitExprAsI64(body, tv, fnIx)) }
        return emitIfArmClose(emitExpr(body, tv, fnIx))
      }
    }
    return ifArmNoValueFail("if-expression arm", blockIx)
  }
  emitFail("emitProgram: if-expression arm is not a block")
}

// ── nullable / value-union if-expression in binding-init position ─────────────
// `const x: i32 | null = if c then 5 else null` lowers as a void `if` whose every arm
// writes the binding's own local directly — no value-typed-if blocktype and no scratch
// slot needed, since the destination local is the stash. `rep` 0 is the value-union box, 1 a `string | null` ref; `boolean | null` is not a supported local rep here yet.

// Emit ONE arm value (`valIx`) in the binding's nullable rep, then `local.set idx`.
function emitNulArmToLocal(
  body: i32[],
  valIx: i32,
  idx: i32,
  rep: i32,
  unionName: string,
  fnIx: i32,
) {
  if valIx < 0 {
    return emitFail("emitProgram: if-expression arm is not a value")
  }
  if rep == 0 {
    // The binding's local is the union box `(ref $uBox)`, so a concrete-variant arm (a
    // kind-8 `(ref $variant)`) must be boxed to match, exactly as `emitUnionIfArm` and a
    // variant return do. `emitUnionBoxArg` boxes a variant ref and defers every other shape
    // to `emitUnionCoerce` — plain `emitUnionCoerce` alone would store the raw variant ref, invalid wasm.
    if emitUnionBoxArg(body, unionName, valIx, fnIx) < 0 { return -1 }
  } else if rep == 1 {
    // rep 1: a `string | null` arm — a non-null string passes through, a bare `null`
    // lowers as `ref.null $sTypeIdx`. A literal-union atom arm is the one non-null value
    // that does not pass through: its rep is an i32 id, so it widens to a string first —
    // this binding-init path is routed here by `emitLetDeclStmt` and never reaches the if-arm widen at the join.
    if exprIsLitAtom(valIx, fnIx) {
      if emitStrValue(body, valIx, fnIx) < 0 { return -1 }
    } else {
      const nsArmCtx = expCtxHere()
      nsArmCtx.nulString = true
      if emitExprExpect(body, valIx, fnIx, nsArmCtx) < 0 { return -1 }
    }
  } else {
    // rep 2: a `boolean | null` arm — a non-null boolean rides its i32 0/1; a bare
    // `null` lowers as the niche sentinel 2 (`nulBool`).
    const nbArmCtx = expCtxHere()
    nbArmCtx.nulBool = true
    if emitExprExpect(body, valIx, fnIx, nbArmCtx) < 0 { return -1 }
  }
  fbLocalSet(idx)
  0
}

// Emit the rep's NULL (the else-less false path / a synthesized null arm), then
// `local.set idx`: the value-union null-tagged box (rep 0), or `ref.null $aTypeIdx`
// for a `string | null` (rep 1).
function emitNulNullToLocal(_body: i32[], idx: i32, rep: i32) {
  if rep == 0 {
    fbI32Const(nullBoxTag())
    fbRefNullNone() // the payload slot is unread under the null tag
    fbStructNew(uBoxIdx)
  } else if rep == 1 {
    wU8(208) // 0xd0 ref.null
    wSLEB(sTypeIdx)
  } else {
    // rep 2: a `boolean | null` else-less / explicit-null path — the niche sentinel 2.
    fbI32Const(2)
  }
  fbLocalSet(idx)
  0
}

// One arm of a nullable if-BINDING: its prelude (`emitIfArmOpen`), then its tail value
// written into the binding's local. The binding-init counterpart of `emitBlockValueAs` —
// the arm is a Block here too, so a `const` it declares is lowered the same way.
function emitNulArmBlockToLocal(
  body: i32[],
  blockIx: i32,
  idx: i32,
  rep: i32,
  unionName: string,
  fnIx: i32,
) {
  if emitIfArmOpen(body, blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
  emitIfArmClose(
    emitNulArmToLocal(body, ifArmValueExpr(blockIx), idx, rep, unionName, fnIx),
  )
}

// Lower a nullable/value-union if-EXPRESSION binding init at `ifIx` into local `idx`:
// a void `if` whose then-arm writes the binding (narrowed by the condition), and whose
// else writes the else-arm value, a nested `else if` (recurse), or — when there is no
// else — the rep's null.
function emitNullableIfBinding(
  body: i32[],
  ifIx: i32,
  idx: i32,
  rep: i32,
  unionName: string,
  fnIx: i32,
) {
  const s = P.nodes[unwrapParen(ifIx)]
  if s is IfStmt {
    if emitExpr(body, s.ifCond, fnIx) < 0 { return -1 }
    fbIf(64) // 0x04 if, 0x40 void blocktype
    ctrlEnter() // count the frame — see `emitUnionIfValue`
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const rc = emitNulArmBlockToLocal(body, s.ifThen, idx, rep, unionName, fnIx)
    if narrowed { restoreNarrow(savedTop) }
    if rc < 0 { return -1 }
    fbElse() // 0x05 else
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    let erc = 0
    if s.ifElse < 0 {
      erc = emitNulNullToLocal(body, idx, rep)
    } else {
      const els = P.nodes[s.ifElse]
      if els is IfStmt {
        erc = emitNullableIfBinding(body, s.ifElse, idx, rep, unionName, fnIx)
      } else {
        erc = emitNulArmBlockToLocal(body, s.ifElse, idx, rep, unionName, fnIx)
      }
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if erc < 0 { return -1 }
    fbEnd() // 0x0b end
    ctrlLeave()
    return 0
  }
  emitFail("emitProgram: expected an if expression")
}

// ── the union-box binding sink ────────────────────────────────────────────────
// `const u: A | B = if c { a } else { b }` needs the box built once after the merge, not
// once per arm plus a pre-seed (three allocation sites means Heap2Local can scalarize none
// of them, so the box survives as a real heap object). The sink writes each arm's tag and payload into a shared pair and does the single `struct.new` after the `if`; gated on `unionIfBindingAllBox` since an arm that already passes a box through would otherwise be unboxed and rebuilt for nothing.

// Does every terminal arm of the union-box if-binding at `ifIx` CONSTRUCT its box? An
// `else if` chain link recurses; an else-LESS chain contributes the rep's null box, which
// is a construction like any other.
function unionIfBindingAllBox(ifIx: i32, fnIx: i32) {
  const s = P.nodes[unwrapParen(ifIx)]
  if s is IfStmt {
    if !unionIfArmBoxes(ifArmValueExpr(s.ifThen), fnIx) { return false }
    if s.ifElse < 0 { return true }
    const els = P.nodes[s.ifElse]
    if els is IfStmt { return unionIfBindingAllBox(s.ifElse, fnIx) }
    return unionIfArmBoxes(ifArmValueExpr(s.ifElse), fnIx)
  }
  false
}

// The two arm shapes whose lowering does not end in `struct.new $uBox`: a value that is
// already a box (`emitUnionCoerce` passes it through untouched), and a nested if-expression
// (`emitUnionIfValue`'s value-typed `if`, whose last instruction is the frame's `end`).
// Every other shape bottoms out in the box's own construction.
function unionIfArmBoxes(valIx: i32, fnIx: i32) {
  if valIx < 0 { return false }
  if exprUnion(valIx, fnIx) { return false }
  const v = P.nodes[unwrapParen(valIx)]
  if v is IfStmt { return false }
  true
}

// Emit ONE arm value into the sink pair: the arm's box, unwritten by the peephole down to
// its two operands. The BACKSTOP (an arm that did not end in a construction after all)
// stores the box it did produce into the binding's own slot and reads the pair back out of
// it — correct, and costing the rebuild after the `if` that the gate exists to avoid.
function emitUnionArmToPair(
  body: i32[],
  valIx: i32,
  idx: i32,
  unionName: string,
  fnIx: i32,
) {
  if valIx < 0 {
    return emitFail("emitProgram: if-expression arm is not a value")
  }
  if emitUnionBoxArg(body, unionName, valIx, fnIx) < 0 { return -1 }
  if uBoxNewIsLast() {
    uBoxSinkToPair()
    return 0
  }
  fbLocalSet(idx)
  fbLocalGet(idx)
  fbStructGet(uBoxIdx, 0) // field 0: tag
  fbLocalSet(unionSinkBase)
  fbLocalGet(idx)
  fbStructGet(uBoxIdx, 1) // field 1: payload (anyref)
  fbLocalSet(unionSinkBase + 1)
  0
}

// The rep's NULL into the sink pair (the else-less false path): the null tag and the
// unread payload slot, written directly rather than through a box the merge would discard.
function emitUnionNullToPair() {
  fbI32Const(nullBoxTag())
  fbLocalSet(unionSinkBase)
  fbRefNullNone() // the payload slot is unread under the null tag
  fbLocalSet(unionSinkBase + 1)
  0
}

// One arm of a union-box if-BINDING sink: its prelude (`emitIfArmOpen`), then its tail
// value written into the sink pair. The prelude precedes the arm's box construction, so
// the `uBoxNewIsLast` peephole still sees the construction as the last instruction.
function emitUnionArmBlockToPair(
  body: i32[],
  blockIx: i32,
  idx: i32,
  unionName: string,
  fnIx: i32,
) {
  if emitIfArmOpen(body, blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
  emitIfArmClose(
    emitUnionArmToPair(body, ifArmValueExpr(blockIx), idx, unionName, fnIx),
  )
}

// `emitNullableIfBinding`'s rep-0 shape with every arm writing the sink pair instead of
// the binding's slot. The caller performs the one `struct.new` after the `if`.
function emitUnionIfBindingSink(
  body: i32[],
  ifIx: i32,
  idx: i32,
  unionName: string,
  fnIx: i32,
) {
  const s = P.nodes[unwrapParen(ifIx)]
  if s is IfStmt {
    if emitExpr(body, s.ifCond, fnIx) < 0 { return -1 }
    fbIf(64) // 0x04 if, 0x40 void blocktype
    ctrlEnter() // count the frame — see `emitUnionIfValue`
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const rc = emitUnionArmBlockToPair(body, s.ifThen, idx, unionName, fnIx)
    if narrowed { restoreNarrow(savedTop) }
    if rc < 0 { return -1 }
    fbElse() // 0x05 else
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    let erc = 0
    if s.ifElse < 0 {
      erc = emitUnionNullToPair()
    } else {
      const els = P.nodes[s.ifElse]
      if els is IfStmt {
        erc = emitUnionIfBindingSink(body, s.ifElse, idx, unionName, fnIx)
      } else {
        erc = emitUnionArmBlockToPair(body, s.ifElse, idx, unionName, fnIx)
      }
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if erc < 0 { return -1 }
    fbEnd() // 0x0b end
    ctrlLeave()
    return 0
  }
  emitFail("emitProgram: expected an if expression")
}

// The expression whose rep the `emitExprAs*` widenings must classify: an assignment in
// value position classifies by its target cell, not its right-hand side, since `g = 7`
// leaves the cell's rep on the stack (`emitBinExprNode`'s `=` arm stores, then re-reads the
// target). Only the classification moves — the right-hand side still evaluates once — so a widening cell in any value position is not double-widened (`i64.extend_i32_s` over an already-i64 value: invalid wasm).
function widenClassifyExpr(exprIx: i32) {
  const wce = P.nodes[unwrapParen(exprIx)]
  if wce is BinExpr {
    if wce.binOp == "=" {
      // Only an IDENT target is a value expression here (`emitBinExprNode` rejects the
      // rest), and its rep is the target's own.
      const wct = P.nodes[wce.binLeft]
      if wct is Ident { return wce.binLeft }
    }
  }
  exprIx
}

// Emit `ix` with the three wide-scalar literal hints cleared, restoring them after: the
// one home for "this emit's width is decided here, not by the position above it".
// `pendingI64`/`pendingF32`/`pendingF64` are a property of one literal position, not the
// subtree around it — left on, every integer literal inside (an array index, a map key, a `.slice` bound) takes the wide form while its own slot is still i32: `vl check` rc 0, invalid module.
function emitExprWideCleared(body: i32[], ix: i32, fnIx: i32) {
  const savedI64 = pendingI64
  const savedF32 = pendingF32
  const savedF64 = pendingF64
  pendingI64 = false
  pendingF32 = false
  pendingF64 = false
  const r = emitExpr(body, ix, fnIx)
  pendingI64 = savedI64
  pendingF32 = savedF32
  pendingF64 = savedF64
  r
}

// Emit the expression at `exprIx` as an i64 value: a bare integer literal lowers directly
// as `i64.const` (`pendingI64` set), an expression that already yields i64 emits as-is, and
// any other i32 source is emitted then sign-extended (`i64.extend_i32_s`). The literal peel
// runs first so the other two arms can own their own width via `emitExprWideCleared`.
export function emitExprAsI64(body: i32[], exprIx: i32, fnIx: i32) {
  // Peel parens to find a bare literal we can emit directly as i64.const.
  const inner = unwrapParen(exprIx)
  const innerNode = P.nodes[inner]
  if innerNode is NumLit {
    const saved = pendingI64
    pendingI64 = true
    const r = emitExpr(body, inner, fnIx)
    pendingI64 = saved
    return r
  }
  if exprIsI64(widenClassifyExpr(exprIx), fnIx) {
    return emitExprWideCleared(body, exprIx, fnIx)
  }
  // Non-literal i32: evaluate, then sign-extend to i64.
  if emitExprWideCleared(body, exprIx, fnIx) < 0 { return -1 }
  fbI64ExtendI32S()
  0
}

// Emit the expression at `exprIx` as an f64 value: already-f64 emits as-is, otherwise a
// narrower source widens at the boundary — f32 via `f64.promote_f32`, i32 via
// `f64.convert_i32_s` (both lossless, permitted variable widenings), i64 via
// `f64.convert_i64_s` for an i64 literal only (a variable i64→f64 is lossy above 2^53 and the checker rejects it).
export function emitExprAsF64(body: i32[], exprIx: i32, fnIx: i32) {
  // An f32 source promotes losslessly to f64, checked before the f64 fast-path: an
  // arithmetic expression with an f32 operand emits as f32, yet `exprIsF64` also claims it
  // via its float literal — without this check the f64 fast-path would emit f32 into an f64
  // slot and trap. A pure-f64 expression is not `exprIsF32`, so it still takes the fast path.
  const f64Cls = widenClassifyExpr(exprIx)
  if exprIsF32(f64Cls, fnIx) {
    if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
    fbF64PromoteF32()
    return 0
  }
  if exprIsF64(f64Cls, fnIx) { return emitExpr(body, exprIx, fnIx) }
  // A bare int literal (optionally negated) re-encodes directly as `f64.const` — exact,
  // and it keeps a const-global init a valid constexpr (a convert op is not constant).
  // Checked before the i64 branch so a big literal stays one `f64.const` too, mirroring
  // the `pendingF64` NumLit lowering and `emitExprAsF32`'s literal path.
  const f64Inner = unwrapParen(exprIx)
  const f64Node = P.nodes[f64Inner]
  if f64Node is NumLit {
    if numLexIsDecimal(f64Node.numText) {
      fbF64Const(f64Node.numText)
      return 0
    }
  }
  if f64Node is Unary {
    if f64Node.unOp == "-" {
      const negInner = P.nodes[unwrapParen(f64Node.unArg)]
      if negInner is NumLit {
        if numLexIsDecimal(negInner.numText) {
          fbF64Const("-" + negInner.numText)
          return 0
        }
      }
    }
  }
  // An i64 source converts (signed) to f64.
  if exprIsI64(f64Cls, fnIx) {
    if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
    fbF64ConvertI64S()
    return 0
  }
  // Otherwise an i32 expression (or integer literal): convert (signed) to f64.
  if emitExpr(body, exprIx, fnIx) < 0 { return -1 }
  fbF64ConvertI32S()
  0
}

// The decimal text of a (possibly signed) numeric literal at `exprIx`, sign folded into
// the text, or "" when the expression is not a literal. Peels grouping parens and any
// number of unary minuses, matching the checker's peel exactly — granting more shapes
// than the emitter recognizes is invalid wasm. The iteration bound guards a malformed arena, not a semantic limit.
function signedNumLitText(exprIx: i32) {
  let ix = unwrapParen(exprIx)
  let neg = false
  let guard = 0
  while guard < 64 {
    const nd = P.nodes[ix]
    if nd is Unary {
      if nd.unOp != "-" { return "" }
      neg = !neg
      ix = unwrapParen(nd.unArg)
    } else if nd is NumLit {
      if neg { return "-" + nd.numText }
      return nd.numText
    } else {
      return ""
    }
    guard = guard + 1
  }
  ""
}

// Emit the expression at `exprIx` as an f32 value: already-f32 emits as-is; a bare
// (possibly signed) numeric literal lowers directly as `f32.const`, re-encoded at single
// precision and never demoted from f64; otherwise an i32 expression converts with
// `f32.convert_i32_s`. An i32 variable never reaches the convert path unliterally — the checker rejects i32→f32 as lossy above 2^24, so only an exactness-gated literal takes it.
export function emitExprAsF32(body: i32[], exprIx: i32, fnIx: i32) {
  // Peel parens for a bare (possibly negated) numeric literal, checked before the
  // `exprIsF32` delegation: `emitExpr`'s bare-literal default is f64, so a context-adopted
  // f32 field literal would otherwise emit an `f64.const` into an f32 field — invalid wasm.
  // Direct `f32.const` is also a constexpr, unlike the `i32.const` + convert pair, so an integer literal can still reach a `const` global's f32 field or element.
  const litText = signedNumLitText(exprIx)
  if litText != "" {
    fbF32Const(litText)
    return 0
  }
  // An already-f32-valued expression (a variable, an f32 arithmetic / call result) emits
  // directly. An assignment classifies by its target cell (`widenClassifyExpr`), as the
  // i64/f64 widenings do, and owns its own width (`emitExprWideCleared`) so an f32 seed
  // reaching here belongs to the position that set it, not the i32 sub-positions inside it.
  if exprIsF32(widenClassifyExpr(exprIx), fnIx) {
    return emitExprWideCleared(body, exprIx, fnIx)
  }
  // Non-literal i32: evaluate, then convert to f32.
  if emitExprWideCleared(body, exprIx, fnIx) < 0 { return -1 }
  fbF32ConvertI32S()
  0
}

// Lower `exprIx` in the rep of a value atom of kind `k` — the emit half of
// `valBlockTypeOfKind`'s blocktype: i64/f64/f32 route through their widening helper,
// every other kind (i32, boolean, the ref atoms) through `emitExpr`. Kept beside that
// ladder so the two halves of "what rep does this arm produce" move together.
function emitExprAsKind(body: i32[], exprIx: i32, k: i32, fnIx: i32) {
  if k == 3 { return emitExprAsI64(body, exprIx, fnIx) }
  if k == 4 { return emitExprAsF64(body, exprIx, fnIx) }
  if k == 5 { return emitExprAsF32(body, exprIx, fnIx) }
  emitExpr(body, exprIx, fnIx)
}

// ── the numeric exact-or-fail cast (D1041) ────────────────────────────────────
// A numeric `as` to an integer target succeeds iff the value is exactly representable
// there, else fails as the trio fails everywhere (`as?` null, `as!` traps, bare `as`
// propagates). The test is "integral and in range", not a round-trip compare — a round-trip is exact only for `f64 → i32`, not the other three float pairs, since the convert-back rounds and admits a value the target cannot hold; NaN fails integrality for free.

// `dom` is the exactness domain, not the rep target: `u8` names 0..255 inside the `i32`
// the cast produces (D1587), a third set of bounds over the same two comparisons. Both
// `u8` bounds convert exactly at f32 and f64, which is why its upper test is `<=` at both.
function emitNumExactTest(src: string, dom: string) {
  const u8Dom = dom == "u8"
  if src == "i64" {
    // `i64 -> i32` / `i64 -> u8`: a pure range test, and never a wrap. The bounds are exact
    // i64 literals. An i32 SOURCE arrives here too — `emitNumExactCast` widens it, exactly.
    fbLocalGet(numCastI64Slot)
    if u8Dom {
      fbI64Const(0, 0) // i64.const 0
    } else {
      fbI64Const(-1, -2147483648) // i64.const -2147483648
    }
    fbI64GeS()
    fbLocalGet(numCastI64Slot)
    if u8Dom {
      fbI64Const(0, 255) // i64.const 255
    } else {
      fbI64Const(0, 2147483647) // i64.const 2147483647
    }
    fbI64LeS()
    fbI32And()
    return 0
  }
  const isF32 = src == "f32"
  let slot = numCastF64Slot
  if isF32 { slot = numCastF32Slot }
  // INTEGRAL: `trunc(d) == d`. A fraction fails it, and so does NaN (no comparison involving
  // NaN is true), which is the ruling's verdict on a NaN cast arriving for free.
  fbLocalGet(slot)
  if isF32 { fbF32Trunc() } else { fbF64Trunc() }
  fbLocalGet(slot)
  if isF32 { fbF32Eq() } else { fbF64Eq() }
  // IN RANGE, lower: `d >= convert(<domain>::MIN)`. ±Inf fails one side or the other.
  fbLocalGet(slot)
  if u8Dom {
    fbI32Const(0)
    if isF32 { fbF32ConvertI32S() } else { fbF64ConvertI32S() }
  } else if dom == "i32" {
    fbI32Const(-2147483648)
    if isF32 { fbF32ConvertI32S() } else { fbF64ConvertI32S() }
  } else {
    fbI64Const(-2147483648, 0) // i64.const -9223372036854775808
    if isF32 { fbF32ConvertI64S() } else { fbF64ConvertI64S() }
  }
  if isF32 { fbF32Ge() } else { fbF64Ge() }
  fbI32And()
  // IN RANGE, upper — `<=` only where the converted maximum is exact (see the table above).
  fbLocalGet(slot)
  if u8Dom {
    fbI32Const(255)
    if isF32 { fbF32ConvertI32S() } else { fbF64ConvertI32S() }
  } else if dom == "i32" {
    fbI32Const(2147483647)
    if isF32 { fbF32ConvertI32S() } else { fbF64ConvertI32S() }
  } else {
    fbI64Const(2147483647, -1) // i64.const 9223372036854775807
    if isF32 { fbF32ConvertI64S() } else { fbF64ConvertI64S() }
  }
  if u8Dom {
    if isF32 { fbF32Le() } else { fbF64Le() }
  } else if isF32 {
    fbF32Lt()
  } else if dom == "i64" {
    fbF64Lt()
  } else {
    fbF64Le()
  }
  fbI32And()
  0
}

// The conversion itself, reached only where `emitNumExactTest` has already proved it
// cannot fail, so the trapping instructions are used rather than the saturating ones: an
// operand here is in range by construction, and if that is ever false a trap is the
// honest outcome, not a silent clamp.
function emitNumExactConvert(src: string, tgt: string) {
  if src == "i64" {
    fbLocalGet(numCastI64Slot)
    fbI32WrapI64()
    return 0
  }
  if src == "f32" {
    fbLocalGet(numCastF32Slot)
    if tgt == "i32" { fbI32TruncF32S() } else { fbI64TruncF32S() }
    return 0
  }
  fbLocalGet(numCastF64Slot)
  if tgt == "i32" { fbI32TruncF64S() } else { fbI64TruncF64S() }
  0
}

// The `as!` trap's reason, streamed to the host boundary before the abort (the same two
// imports `__trap__("reason")` uses). Built as characters rather than a synthesized
// `StrLit`, since a string minted at emit time is invisible to the collect passes that
// intern `$sTypeIdx` — a program whose only string is this message would `ref.cast` at an unallocated heap index. The wording is kept short since every character costs `i32.const` + `call` per site (D1041).
function emitNumCastTrapMsg(exprIx: i32, tgt: string) {
  let where = ""
  if exprIx >= 0 && exprIx < nodeToks.length {
    const at = nodeToks[exprIx]
    if at >= 0 && at < P.toks.length {
      where = " at " +
        i32ToStr(P.toks[at].line) +
        ":" +
        i32ToStr(P.toks[at].col + 1)
    }
  }
  for cp in "as! " + tgt + where + ": not exact" {
    fbI32Const(cp)
    fbCall(2) // __print_char__ (import 2)
  }
  fbCall(3) // __print_str_flush__ (import 3)
  0
}

// The `null` node a bare `as`'s early return hands to `emitReturnValue`, so the return
// path's own seeds (`emitNullLitNode`'s rep table) serve it rather than a second ladder
// guessing a null encoding per rep. Minted fresh per site, not cached in a module `let` —
// a cached arena index outliving its program is the hazard `emitProgram`'s sidecar-reset guards against, and the LSP compiles many programs through one instance.
function numCastNullNode(): i32 { mkNull("null", -1) }

// The three modes, over one shared test and conversion: `as?` is a value-producing `if`
// whose result is the `{tag, payload}` union box (the same rep `emitUnionCoerce`'s
// `NullLit` builds, so every delivery position already knows the null); `as!` is the
// reason, `unreachable`, then the conversion; a bare `as` returns the enclosing function's own null (built by the return path) then the conversion.
function emitNumExactCast(body: i32[], e: AsExpr, exprIx: i32, fnIx: i32) {
  const tgt = asExprNumTgtName(exprIx)
  // The domain and the target are two names (D1587): the domain decides the range test and
  // the `as!` message, the target decides the conversion opcode and the box row. At `u8`
  // they differ; everywhere else they are the same string.
  const dom = asExprNumCastDomain(exprIx)
  // An i32 source exists only at the `u8` domain, and rides the i64 path rather than a
  // fourth scratch slot: `i64.extend_i32_s` is exact for every i32, the range test is the
  // same two compares, and `i32.wrap_i64` brings the proven 0..255 value back unchanged.
  let src = asExprNumSrcName(exprIx)
  if src == "i32" { src = "i64" }
  // Stage the operand ONCE — the test reads it up to three times and it is typically a call.
  if src == "i64" {
    if emitNumIntrArg(body, e.asObj, 3, fnIx) < 0 { return -1 }
    fbLocalSet(numCastI64Slot)
  } else if src == "f32" {
    if emitNumIntrArg(body, e.asObj, 5, fnIx) < 0 { return -1 }
    fbLocalSet(numCastF32Slot)
  } else {
    if emitNumIntrArg(body, e.asObj, 4, fnIx) < 0 { return -1 }
    fbLocalSet(numCastF64Slot)
  }
  if emitNumExactTest(src, dom) < 0 { return -1 }
  if e.asMode == "null" {
    const nck = valueAtomKind(tgt)
    const nvb = vbHeapIdxOfKind(nck)
    if nvb < 0 || !uDeclared {
      return emitFail(
        "emitProgram: `as? " +
          tgt +
          "` has no value box — the `" +
          tgt +
          " | null` row was never registered",
      )
    }
    fbIfRefNul(uBoxIdx, false) // if (result (ref $uBox))
    ctrlEnter()
    fbI32Const(scalarTagOfKind(nck))
    if emitNumExactConvert(src, tgt) < 0 { return -1 }
    fbStructNew(nvb) // wrap the scalar payload
    fbStructNew(uBoxIdx)
    fbElse()
    // The null-tagged box, not a null box ref — what `T | null` means for a boxed union.
    fbI32Const(nullBoxTag())
    fbRefNullNone() // the payload slot is unread under the null tag
    fbStructNew(uBoxIdx)
    fbEnd()
    ctrlLeave()
    return 0
  }
  fbI32Eqz()
  fbIf(64) // if (void) — the SAD path, the only place the two remaining modes differ
  ctrlEnter()
  if e.asMode == "trap" {
    // The DOMAIN is what the author wrote, so `x as! u8` says `as! u8`, not `as! i32`.
    if emitNumCastTrapMsg(exprIx, dom) < 0 { return -1 }
    fbUnreachable()
  } else {
    // A bare `as` PROPAGATES. The checker proved the enclosing function returns something
    // `null` fits, so the value to hand back is that function's own null — built through
    // `emitReturnValue`, which is where every nullable-return seed already lives.
    if emitReturnValue(body, numCastNullNode(), fnIx) < 0 { return -1 }
    fbReturn()
  }
  fbEnd()
  ctrlLeave()
  emitNumExactConvert(src, tgt)
}

// `x as% T` — the wrap cast (`DECISIONS.md` §"`as%` is the wrap cast"). It cannot fail, so
// there is no test, no sad path and no staging slot: one conversion opcode, and the byte mask
// at the `u8` domain. A literal operand folds to the constant it denotes, which is what lets a
// consumer write a 32-bit bit pattern.
function emitNumWrapCast(body: i32[], e: AsExpr, exprIx: i32, fnIx: i32) {
  const obj = e.asObj
  const dom = asExprNumCastDomain(exprIx)
  let tgt = asExprNumTgtName(exprIx)
  if tgt == "" { tgt = e.asTy }
  // A float on either side and a union operand are both refused at check; these are the
  // floors for an operand whose width only the emitted rep knows.
  if (
    exprIsF32(obj, fnIx) ||
    exprIsF64(obj, fnIx) ||
    tgt == "f32" ||
    tgt == "f64"
  ) {
    return emitFail(
      "emitProgram: `as% " +
        e.asTy +
        "` wraps between integer widths, and this cast names a float — use `as!` or `as?`",
    )
  }
  if asExprIsUnionCastIn(exprIx, fnIx) {
    return emitFail(
      "emitProgram: `as% " +
        e.asTy +
        "` wraps a number, and this operand is a union — take the numeric arm first",
    )
  }
  // An i64 target is the sign-extend, which the i64 helper already is for both sources.
  if tgt == "i64" { return emitNumIntrArg(body, obj, 3, fnIx) }
  const lit = P.nodes[unwrapParen(obj)]
  let folded = false
  if lit is NumLit {
    if !numLexIsFloat(lit.numText) {
      const pr = parseI64Pair(lit.numText)
      fbI32Const(pr[1])
      folded = true
    }
  }
  if !folded {
    if exprIsI64(obj, fnIx) {
      if emitNumIntrArg(body, obj, 3, fnIx) < 0 { return -1 }
      fbI32WrapI64()
    } else if emitNumIntrArg(body, obj, 0, fnIx) < 0 {
      return -1
    }
  }
  if dom == "u8" {
    fbI32Const(255)
    fbI32Bin(113) // 0x71 i32.and
  }
  0
}

function emitAsCast(body: i32[], e: AsExpr, _exprIx: i32, fnIx: i32) {
  const obj = e.asObj
  const tgt = e.asTy
  if e.asMode == "wrap" { return emitNumWrapCast(body, e, _exprIx, fnIx) }
  // union-operand `as` is the propagating cast (`error-handling-design.md` §Trio): evaluate
  // the box once into `$unionAs`, compare its tag against T's, and on a miss `return` the
  // box unchanged — one box struct and a global tag registry make it already a value of
  // the enclosing function's union return type. `m[k] as! V` fuses the map probe instead.
  if e.asMode == "trap" {
    const amk = mapReadScalarBoxKindTy(obj)
    if amk >= 0 {
      const amRef = P.nodes[unwrapParen(obj)]
      if amRef is Index {
        if emitMapPrep(body, amRef.idxArr, amRef.idxIndex, fnIx) < 0 {
          return -1
        }
        pushMapScr(body, 5) // entry
        fbI32Eqz()
        fbIf(64) // void
        fbUnreachable()
        fbEnd()
        if cmSlot >= 0 {
          pushMapVals(body)
          fbStructGet(cmValsWrap(), 0)
          pushMapScr(body, 5)
          fbI32Const(1)
          fbI32Bin(107) // i32.sub
          fbArrayGet(cmValsBack())
        } else {
          pushMapVals(body)
          fbStructGet(lTypeIdx, 0)
          pushMapScr(body, 5)
          fbI32Const(1)
          fbI32Bin(107)
          fbArrayGet(aTypeIdx)
        }
        return 0
      }
    }
  }
  // numeric exact-or-fail (D1041) is checked ahead of the union arm and disjoint from it by
  // operand; only a cast that can fail comes here, the rest fall through to the plain ladder.
  if asExprNumFallible(_exprIx) {
    // the peephole: `trunc(d) as! i32`/`floor`/`ceil`/`nearest` — the operand is integral, so
    // only range can fail (excludes `u8`, D1587: `i32.trunc_f64_s` enforces i32's range, not 0..255).
    const peep = e.asMode == "trap" &&
      asExprNumCastDomain(_exprIx) != "u8" &&
      exprIsIntegralFloat(obj, fnIx)
    if !peep { return emitNumExactCast(body, e, _exprIx, fnIx) }
  }
  if asExprIsUnionCastIn(_exprIx, fnIx) {
    // the target arm's type is the cast node's own recorded type, the checker's proof; for
    // `as?` the node's type is `T | null`, so it is peeled to recover `T` — without the peel
    // the tag and heap derive from the wrong type.
    let tty = nodeTyIxOf(_exprIx)
    if e.asMode == "null" { tty = tyPeelNul(tty) }
    // the target's arms, flattened rather than tested as `TyUnion`: a sub-union target
    // only widens the membership test (a tag chain), with no unbox at all.
    const armTys: i32[] = []
    flattenVariantsInto(tty, armTys)
    const subUnion = armTys.length > 1
    const wantTags: i32[] = []
    let armVi = -1
    let ak = 0
    if !subUnion { ak = unMemAtomKind(tty) }
    let at = 0
    while at < armTys.length {
      const aty = armTys[at]
      let t1 = isArmTagOfTy(aty)
      // a struct arm is a variant: its box tag is `uTags[vi]`, the rank assigned at
      // construction, not an `isArmTagOfTy` value-atom kind.
      let vi = -1
      if t1 < 0 {
        const armNm = nominalStructNameOfTy(aty)
        if armNm != "" { vi = variantIndexOf(armNm) }
        if vi >= 0 { t1 = uTags[vi] }
      }
      if t1 < 0 {
        return emitFail(
          "emitProgram: `as " +
            tgt +
            "` is supported for a value-union arm or a struct-variant arm; this arm is neither — write the explicit `if x is " +
            tgt +
            " { … }` ladder for it",
        )
      }
      if !subUnion { armVi = vi }
      wantTags.push(t1)
      at = at + 1
    }
    if wantTags.length < 1 || (!subUnion && armVi < 0 && ak < 0) {
      return emitFail(
        "emitProgram: `as " +
          tgt +
          "` names no union arm this cast can test",
      )
    }
    // The operand must actually carry the BOX. A niche-repped union (`T | null`) has no tag
    // field to test, and `exprUnion` is the emitter's own answer to that question — the same
    // one every other box consumer asks, rather than a second reading of the type.
    if !exprUnion(obj, fnIx) {
      return emitFail(
        "emitProgram: `as " +
          tgt +
          "` needs a BOXED union operand — a niche-repped one carries no tag to test",
      )
    }
    if emitExpr(body, obj, fnIx) < 0 { return -1 }
    fbLocalSet(unionAsSlot)
    // `tag == w0 || tag == w1 || …` — one compare for a single arm, a chain for a sub-union.
    // The tag is re-read per arm rather than stashed in a second i32 slot: it is a
    // `struct.get` off a local, two instructions, and costs no frame.
    let wi = 0
    while wi < wantTags.length {
      fbLocalGet(unionAsSlot)
      fbStructGet(uBoxIdx, 0) // field 0: the tag
      fbI32Const(wantTags[wi])
      fbI32Bin(70)            // 0x46 i32.eq
      if wi > 0 {
        fbI32Bin(114) // 0x72 i32.or
      }
      wi = wi + 1
    }
    // `as?` yields a value on both paths (a value-producing `if`, not the early exit `as`/
    // `as!` take): `T` when the tag matches, `null` when it does not. Supported only where
    // `T | null` already has a rep — `Circle | null` over a union arm has none yet
    // (`emitProgram: ref valtype with no interned shape`), refused here by naming the gap.
    if e.asMode == "null" {
      // the boxed targets — a sub-union and a numeric value-atom arm — share one lowering:
      // a box already tagged with the wanted arm is a value of the target type, so hand
      // back the operand's own box, or a null box ref on the miss. Boolean is excluded —
      // `boolean | null` is the sentinel niche (`i32.const 2`), not a box.
      if subUnion || armVi < 0 && (ak == 0 || ak == 3 || ak == 4 || ak == 5) {
        fbIfRefNul(uBoxIdx, false) // if (result (ref $uBoxIdx))
        ctrlEnter()
        fbLocalGet(unionAsSlot)
        fbElse()
        // the null-tagged box, what `T | null` means for a boxed union — a non-null box
        // carrying `nullBoxTag()`, not a null box ref: the rep the null test and
        // `emitUnionCoerce`'s `NullLit` both use, so a `!= null` on the result agrees.
        fbI32Const(nullBoxTag())
        fbRefNullNone() // the payload slot is unread under the null tag
        fbStructNew(uBoxIdx)
        fbEnd()
        ctrlLeave()
        return 0
      }
      // a struct-variant target (`as? Circle`) is the `nulvariant` niche, a
      // `(ref null $uVarHeap[vi])`: unbox and cast on the hit, a typed null on the miss.
      if armVi >= 0 {
        if armVi >= uVarHeap.length {
          return emitFail(
            "emitProgram: `as? " +
              tgt +
              "` names a variant with no interned shape",
          )
        }
        fbIfRefNul(uVarHeap[armVi], true)
        ctrlEnter()
        fbLocalGet(unionAsSlot)
        fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
        fbRefCast(uVarHeap[armVi])
        fbElse()
        fbRefNull(uVarHeap[armVi])
        fbEnd()
        ctrlLeave()
        return 0
      }
      // what is left is a value-atom arm: string is the nullable ref below; a numeric arm
      // is refused — `i32 | null` is a value-niche sentinel, a different lowering entirely.
      // boolean needs its own arm: `boolean | null` is the sentinel niche (i32 `2` for
      // null), so the block's result is a scalar where every other target's is a ref.
      if ak == 1 {
        fbIf(127) // 0x04 if, 0x7f i32 result blocktype
        ctrlEnter()
        fbLocalGet(unionAsSlot)
        if emitUnionUnboxTail(ak) < 0 { return -1 }
        fbElse()
        fbI32Const(2) // the null sentinel
        fbEnd()
        ctrlLeave()
        return 0
      }
      if ak != 2 {
        return emitFail(
          "emitProgram: `as? " +
            tgt +
            "` is supported for a value-atom arm, a struct-variant arm and a sub-union; this arm is none of those — write the explicit `if x is " +
            tgt +
            " { … }` ladder for it",
        )
      }
      fbIfRefNul(sTypeIdx, true) // if (result (ref null $sTypeIdx))
      ctrlEnter()
      fbLocalGet(unionAsSlot)
      fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
      fbRefCast(sTypeIdx)
      fbElse()
      fbRefNull(sTypeIdx)
      fbEnd()
      ctrlLeave()
      return 0
    }
    fbI32Eqz() // 0x45
    fbIf(64)   // if, void
    ctrlEnter()
    // the sad path, and the only place `as` and `as!` differ: `as` hands the whole box to
    // the caller, `as!` traps and needs no value at all.
    if e.asMode == "trap" {
      fbUnreachable()
    } else {
      fbLocalGet(unionAsSlot)
      fbReturn()
    }
    fbEnd()
    ctrlLeave()
    fbLocalGet(unionAsSlot)
    // a sub-union result is the box itself, at a narrower type — nothing to unbox.
    if subUnion { return 0 }
    // a struct arm's payload is the variant struct — recover it with the variant heap
    // cast, exactly as the shared-field dispatch does; a value atom takes the shared tail.
    if armVi >= 0 {
      fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
      fbRefCast(uVarHeap[armVi])
      return 0
    }
    return emitUnionUnboxTail(ak)
  }
  // the numeric `x as T` lowering: the operand goes out in its own source rep through the
  // `emitExprAs*` helpers, then one wasm conversion opcode for the pair (float-to-int traps
  // rather than wraps). The width is the cast's, not the delivery position, so
  // `emitNumIntrArg` clears the enclosing wide-scalar context — else a `: f32` binding's `pendingF32` would double-widen it.
  if tgt == "f64" { return emitNumIntrArg(body, obj, 4, fnIx) }
  // classify the source rep: f32 first, since `exprIsF64` over-claims an f32 literal.
  let src = "i32"
  if exprIsF32(obj, fnIx) { src = "f32" }
  else if exprIsI64(obj, fnIx) { src = "i64" }
  else if exprIsF64(obj, fnIx) { src = "f64" }
  if tgt == "i64" {
    // i32→i64 widening (and i64→i64 no-op) via the existing helper.
    if src == "i32" || src == "i64" {
      return emitNumIntrArg(body, obj, 3, fnIx)
    }
    // float→i64: TRAPPING truncation toward zero.
    if src == "f32" {
      if emitNumIntrArg(body, obj, 5, fnIx) < 0 { return -1 }
      fbI64TruncF32S()
      return 0
    }
    if emitNumIntrArg(body, obj, 4, fnIx) < 0 {
      return -1 // f64 → i64
    }
    fbI64TruncF64S()
    return 0
  }
  if tgt == "f32" {
    // i32→f32 (and f32→f32 no-op) via the existing helper (handles literals).
    if src == "i32" || src == "f32" {
      return emitNumIntrArg(body, obj, 5, fnIx)
    }
    if src == "i64" {
      if emitNumIntrArg(body, obj, 3, fnIx) < 0 { return -1 }
      fbF32ConvertI64S()
      return 0
    }
    if emitNumIntrArg(body, obj, 4, fnIx) < 0 {
      return -1 // f64 → f32 demote
    }
    fbF32DemoteF64()
    return 0
  }
  // tgt == "i32".
  if src == "i32" {
    return emitNumIntrArg(body, obj, 0, fnIx) // no-op (plain `emitExpr` at kind 0)
  }
  if src == "i64" {
    if emitNumIntrArg(body, obj, 3, fnIx) < 0 { return -1 }
    fbI32WrapI64()
    return 0
  }
  if src == "f32" {
    if emitNumIntrArg(body, obj, 5, fnIx) < 0 { return -1 }
    fbI32TruncF32S()
    return 0
  }
  if emitNumIntrArg(body, obj, 4, fnIx) < 0 {
    return -1 // f64 → i32 trunc
  }
  fbI32TruncF64S()
  0
}

// ── linear-memory opcodes: the load-width matrix + memory.size/grow ──────────
// The instruction bytes for `buffer-design.md` §C2's load matrix (`i32.load` itself is
// `fbI32Load` in `emit_bytes.vl`); the other widths sit beside their dispatch here.
const OP_I64_LOAD = 0x29
const OP_F32_LOAD = 0x2a
const OP_F64_LOAD = 0x2b
const OP_I32_LOAD8_S = 0x2c
const OP_I32_LOAD8_U = 0x2d
const OP_I32_LOAD16_S = 0x2e
const OP_I32_LOAD16_U = 0x2f
const OP_I64_STORE = 0x37
const OP_F32_STORE = 0x38
const OP_F64_STORE = 0x39
const OP_I32_STORE8 = 0x3a
const OP_I32_STORE16 = 0x3b
const OP_MEMORY_SIZE = 0x3f
const OP_MEMORY_GROW = 0x40

// The misc prefix (0xfc) and the two bulk-memory sub-opcodes behind it — every other
// prefixed instruction here uses 0xfb, the GC prefix, instead. The sub-opcode is a u32
// LEB immediate, not a byte; 10/11 happen to fit one byte today (below 128), which is
// why plain `wU8` still works here.
const OP_MISC_PREFIX = 0xfc
const MISC_MEMORY_COPY = 10
const MISC_MEMORY_FILL = 11

// The opcode byte for load width `name`, or -1 for a name that is not one. Paired with
// `memLoadAlignExp` below — the two are read together at the single call site.
function memLoadOpcode(name: string) {
  if name == "__load_i8__" { return OP_I32_LOAD8_S }
  if name == "__load_u8__" { return OP_I32_LOAD8_U }
  if name == "__load_i16__" { return OP_I32_LOAD16_S }
  if name == "__load_u16__" { return OP_I32_LOAD16_U }
  if name == "__load_i64__" { return OP_I64_LOAD }
  if name == "__load_f32__" { return OP_F32_LOAD }
  if name == "__load_f64__" { return OP_F64_LOAD }
  -1
}

// The natural alignment exponent for load width `name`: log2 of the access width in
// bytes. It is a hint the wasm spec never enforces — a mismatched access still runs,
// just without the engine's fast path — and `__load_i32__`'s exponent 2 has always read
// correctly at odd addresses, a property these widths inherit; the corpus pins it per width.
function memLoadAlignExp(name: string) {
  if name == "__load_i8__" { return 0 }
  if name == "__load_u8__" { return 0 }
  if name == "__load_i16__" { return 1 }
  if name == "__load_u16__" { return 1 }
  if name == "__load_i64__" { return 3 }
  if name == "__load_f32__" { return 2 }
  if name == "__load_f64__" { return 3 }
  -1
}

// One memarg-carrying memory instruction: `<opcode> <align-exp> <offset>`. Offset 0
// always — VL spells the address as an ordinary expression, so the static offset
// immediate has nothing to carry. Loads and stores share this encoding exactly; they
// differ only in their stack effect, which the caller has already arranged.
function fbMemAccess(op: i32, alignExp: i32) {
  wU8(op)
  wU8(alignExp)
  wU8(0) // static offset 0 (the address is the stack operand)
  0
}

// The opcode byte for store width `name`, or -1 otherwise. The wide trio duals
// `memLoadOpcode`'s; the narrow pair collapses its four narrow loads — `i32.store8` is
// the one instruction both `i32.load8_s` and `i32.load8_u` read back, since a store has
// no signedness. All five share the memarg encoding a load uses.
function memStoreOpcode(name: string) {
  if name == "__store_i64__" { return OP_I64_STORE }
  if name == "__store_f32__" { return OP_F32_STORE }
  if name == "__store_f64__" { return OP_F64_STORE }
  if name == "__store_i8__" { return OP_I32_STORE8 }
  if name == "__store_i16__" { return OP_I32_STORE16 }
  -1
}

// The NATURAL alignment exponent for store width `name` — log2 of the access width in bytes,
// the same hint-not-constraint immediate `memLoadAlignExp` documents. i64 and f64 write eight
// bytes (exponent 3); f32 writes four (2), matching `__store_i32__`'s long-standing 2; the
// narrow pair write one byte (0) and two (1), matching their load twins.
function memStoreAlignExp(name: string) {
  if name == "__store_i64__" { return 3 }
  if name == "__store_f32__" { return 2 }
  if name == "__store_f64__" { return 3 }
  if name == "__store_i8__" { return 0 }
  if name == "__store_i16__" { return 1 }
  -1
}

// The two narrow store widths, whose value operand is an i32 rather than the declared
// wide scalar the other three take. Split out so the dispatch is a total two-way choice,
// not an `else` that silently means f64 for a name added to `nameIsMemStoreIntrinsic`
// and forgotten here — that shape builds an f64 operand under an i32 opcode.
function memStoreValueIsI32(name: string) {
  if name == "__store_i8__" { return true }
  if name == "__store_i16__" { return true }
  false
}

// One bulk-memory instruction: the 0xfc prefix, the sub-opcode, then one memory index
// per memory it names (`memory.fill` one, `memory.copy` two: destination then source) —
// both 0, since VL emits a single memory. `n` is unsigned in both, so a negative VL
// length is ~4 GiB and traps in the engine, not the checker.
function fbMemBulk(sub: i32, memIndexCount: i32) {
  wU8(OP_MISC_PREFIX) // 0xfc misc prefix
  wU8(sub)            // the sub-opcode (a u32 LEB; 10 and 11 are one byte each)
  let mi = 0
  while mi < memIndexCount {
    wU8(0) // memory index 0
    mi = mi + 1
  }
  0
}

// `memory.size` → 0x3f 0x00 and `memory.grow` → 0x40 0x00. The trailing byte is the
// memory INDEX immediate, not a flags byte: there is one memory, so it is 0.
function fbMemorySize() {
  wU8(OP_MEMORY_SIZE)
  wU8(0) // memory index 0
  0
}
function fbMemoryGrow() {
  wU8(OP_MEMORY_GROW)
  wU8(0) // memory index 0
  0
}

// ── numeric-opcode intrinsics ────────────────────────────────────────────────
// The IEEE bitcasts. A bitcast moves no bits: the same 32/64-bit pattern is simply
// read at the other type. Each is exactly one wasm instruction, so there is no
// import, no runtime, and nothing for the linker.
const OP_I32_REINTERPRET_F32 = 0xbc
const OP_I64_REINTERPRET_F64 = 0xbd
const OP_F32_REINTERPRET_I32 = 0xbe
const OP_F64_REINTERPRET_I64 = 0xbf
// `emitBitcastIntr`'s "this name is not an intrinsic" answer, distinct from its
// success (0) and its failure (-1) — the caller falls through to its own error.
const NUM_INTR_NONE = -2

// One single-BYTE numeric instruction: the whole encoding IS the opcode byte (no
// immediates), so writing the byte writes the instruction.
function fbNumOp(op: i32) {
  wU8(op)
  0
}

// One operand of a numeric-opcode intrinsic, emitted at the width the operation declares
// (`k`: the `emitExprAsKind` codes) with the enclosing wide-scalar context cleared. The
// width comes from the intrinsic's own signature, never the call's position — else an
// f32-seeding context around a non-f32 operand hits `type mismatch` on a checked program.
function emitNumIntrArg(body: i32[], ix: i32, k: i32, fnIx: i32) {
  const savedF32 = pendingF32
  const savedF64 = pendingF64
  const savedI64 = pendingI64
  pendingF32 = false
  pendingF64 = false
  pendingI64 = false
  const r = emitExprAsKind(body, ix, k, fnIx)
  pendingF32 = savedF32
  pendingF64 = savedF64
  pendingI64 = savedI64
  r
}

// Lower `f32bits` / `f64bits` / `f32fromBits` / `f64fromBits`: push the argument at
// the source type, then the one reinterpret instruction. Returns `NUM_INTR_NONE` when
// `name` is not one of them. The operand takes `emitNumIntrArg` at the bitcast's own
// width — an enclosing f32 context would otherwise mistype the reinterpret's operand.
function emitBitcastIntr(body: i32[], callIx: i32, fnIx: i32, name: string) {
  if (
    name != "f32bits" &&
    name != "f64bits" &&
    name != "f32fromBits" &&
    name != "f64fromBits"
  ) {
    return NUM_INTR_NONE
  }
  const c = P.nodes[callIx]
  if c is Call {
    if c.callArgs.length != 1 {
      return emitFail("emitProgram: " + name + " takes exactly one argument")
    }
    const arg = c.callArgs[0]
    if name == "f32bits" {
      if emitNumIntrArg(body, arg, 5, fnIx) < 0 { return -1 }
      return fbNumOp(OP_I32_REINTERPRET_F32) // 0xbc i32.reinterpret_f32
    }
    if name == "f64bits" {
      if emitNumIntrArg(body, arg, 4, fnIx) < 0 { return -1 }
      return fbNumOp(OP_I64_REINTERPRET_F64) // 0xbd i64.reinterpret_f64
    }
    if name == "f32fromBits" {
      if emitNumIntrArg(body, arg, 0, fnIx) < 0 { return -1 }
      return fbNumOp(OP_F32_REINTERPRET_I32) // 0xbe f32.reinterpret_i32
    }
    if emitNumIntrArg(body, arg, 3, fnIx) < 0 { return -1 }
    return fbNumOp(OP_F64_REINTERPRET_I64) // 0xbf f64.reinterpret_i64
  }
  NUM_INTR_NONE
}

// The f32 instruction for the float intrinsic `name`, or -1 when it is not one.
//   abs 0x8b · ceil 0x8d · floor 0x8e · trunc 0x8f · nearest 0x90 · sqrt 0x91
//   min 0x96 · max 0x97 · copysign 0x98
function floatIntrOpF32(name: string) {
  if name == "abs" { return 0x8b }
  if name == "ceil" { return 0x8d }
  if name == "floor" { return 0x8e }
  if name == "trunc" { return 0x8f }
  if name == "nearest" { return 0x90 }
  if name == "sqrt" { return 0x91 }
  if name == "min" { return 0x96 }
  if name == "max" { return 0x97 }
  if name == "copysign" { return 0x98 }
  -1
}

// The f64 instruction for the float intrinsic `name`, or -1 when it is not one — the
// f32 table shifted up by one block, exactly as the arithmetic opcodes are.
//   abs 0x99 · ceil 0x9b · floor 0x9c · trunc 0x9d · nearest 0x9e · sqrt 0x9f
//   min 0xa4 · max 0xa5 · copysign 0xa6
function floatIntrOpF64(name: string) {
  if name == "abs" { return 0x99 }
  if name == "ceil" { return 0x9b }
  if name == "floor" { return 0x9c }
  if name == "trunc" { return 0x9d }
  if name == "nearest" { return 0x9e }
  if name == "sqrt" { return 0x9f }
  if name == "min" { return 0xa4 }
  if name == "max" { return 0xa5 }
  if name == "copysign" { return 0xa6 }
  -1
}

// The i32 instruction for the integer intrinsic `name`, or -1 when it is not one.
//   clz 0x67 · ctz 0x68 · popcnt 0x69 · div_u 0x6e · rem_u 0x70 · rotl 0x77 · rotr 0x78
//   lt_u 0x49 · gt_u 0x4b · le_u 0x4d · ge_u 0x4f
function intIntrOpI32(name: string) {
  if name == "clz" { return 0x67 }
  if name == "ctz" { return 0x68 }
  if name == "popcnt" { return 0x69 }
  if name == "divU" { return 0x6e }
  if name == "remU" { return 0x70 }
  if name == "rotl" { return 0x77 }
  if name == "rotr" { return 0x78 }
  if name == "ltU" { return 0x49 }
  if name == "gtU" { return 0x4b }
  if name == "leU" { return 0x4d }
  if name == "geU" { return 0x4f }
  -1
}

// The i64 instruction for the integer intrinsic `name`, or -1 when it is not one.
//   clz 0x79 · ctz 0x7a · popcnt 0x7b · div_u 0x80 · rem_u 0x82 · rotl 0x89 · rotr 0x8a
//   lt_u 0x54 · gt_u 0x56 · le_u 0x58 · ge_u 0x5a
function intIntrOpI64(name: string) {
  if name == "clz" { return 0x79 }
  if name == "ctz" { return 0x7a }
  if name == "popcnt" { return 0x7b }
  if name == "divU" { return 0x80 }
  if name == "remU" { return 0x82 }
  if name == "rotl" { return 0x89 }
  if name == "rotr" { return 0x8a }
  if name == "ltU" { return 0x54 }
  if name == "gtU" { return 0x56 }
  if name == "leU" { return 0x58 }
  if name == "geU" { return 0x5a }
  -1
}

// Lower a FLOAT intrinsic (`sqrt`, `min`, `copysign`, …): push every argument at the
// operation's width, then the one instruction. The width rule is the binary operators'
// — f32 when an operand is f32 and neither side is a genuine (non-literal) f64 — so
// `min(x, 0.5)` over an f32 `x` computes in f32 exactly as `x * 0.5` does.
function emitFloatIntr(body: i32[], callIx: i32, fnIx: i32, name: string) {
  const opF32 = floatIntrOpF32(name)
  if opF32 < 0 { return NUM_INTR_NONE }
  const c = P.nodes[callIx]
  if c is Call {
    const args = c.callArgs
    if args.length == 0 {
      return emitFail("emitProgram: " + name + " takes at least one argument")
    }
    let anyF32 = false
    let i = 0
    while i < args.length {
      if exprIsF32(args[i], fnIx) { anyF32 = true }
      i = i + 1
    }
    // `binMixHardF64` over the first and last argument IS the operators' rule: true when
    // either side is a genuine (non-literal) f64. A one-argument intrinsic passes its one
    // operand as both sides, which asks the same question of it.
    const hardF64 = binMixHardF64(args[0], args[args.length - 1], fnIx)
    const useF32 = anyF32 && !hardF64
    // The chosen width is the OPERATION's, so each operand takes it with the enclosing
    // wide-scalar context cleared (`emitNumIntrArg`). The f64 arm is the one that
    // needed it: `nearest(2.5)` under an f32 context lowered `2.5` as `f32.const` and
    // handed `f64.nearest` an f32.
    let fiK = 4
    if useF32 { fiK = 5 }
    let j = 0
    while j < args.length {
      if emitNumIntrArg(body, args[j], fiK, fnIx) < 0 { return -1 }
      j = j + 1
    }
    if useF32 { return fbNumOp(opF32) }
    return fbNumOp(floatIntrOpF64(name))
  }
  NUM_INTR_NONE
}

// Lower an INTEGER intrinsic (`clz`, `rotl`, `divU`, `ltU`, …): push every argument at
// the operation's width, then the one instruction. i64 when an operand is i64 (the i32
// side sign-extends), else i32 — the selection the i64 binary operators use.
function emitIntIntr(body: i32[], callIx: i32, fnIx: i32, name: string) {
  const opI32 = intIntrOpI32(name)
  if opI32 < 0 { return NUM_INTR_NONE }
  const c = P.nodes[callIx]
  if c is Call {
    const args = c.callArgs
    let useI64 = false
    let i = 0
    while i < args.length {
      if exprIsI64(args[i], fnIx) { useI64 = true }
      i = i + 1
    }
    // The chosen width is the OPERATION's — an i32 op's operand is an i32 whatever the
    // enclosing position wants — so each one takes `emitNumIntrArg`. Without it
    // `clz(1) as f32` lowered the `1` as `f32.const` into `i32.clz`.
    let iiK = 0
    if useI64 { iiK = 3 }
    let j = 0
    while j < args.length {
      if emitNumIntrArg(body, args[j], iiK, fnIx) < 0 { return -1 }
      j = j + 1
    }
    if useI64 { return fbNumOp(intIntrOpI64(name)) }
    return fbNumOp(opI32)
  }
  NUM_INTR_NONE
}

// One operand of a linear-memory intrinsic, with every wide-scalar context flag cleared:
// every operand here is an i32 by declaration, so no wide scalar an enclosing position
// wants may reach it — except the three wide stores' second operand, which takes its own
// declared width instead. Array intrinsics are excluded: their fill takes the element's own valtype.
function emitMemIntrinArg(body: i32[], ix: i32, fnIx: i32) {
  emitExprWideCleared(body, ix, fnIx)
}

// Is `name` bound by the user in this frame — a parameter, a local, or a capture of one?
// Scoped to callee position only (a parameter named `__load_i32__` is legal VL); a
// parameter is the only binding form that can hold such a name, since the checker refuses
// a `function`/`const`/`let` of an intrinsic spelling. Guards a capture-of-parameter miss (D1087).
function identNameIsUserBound(name: string, fnIx: i32): boolean {
  if localIndexOf(fnIx, name) >= 0 { return true }
  capturedKindOf(fnIx, name) != null
}

// Node shapes read: Call { callFn: i32, callArgs: i32[] }, callee Ident { identName }.
function emitCall(body: i32[], callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Ident {
      // a user function of the same name must win: checked before any spelling-based
      // builtin match, since matching by spelling alone routes a same-named user
      // declaration into the builtin instead — a whole-set bug, not one name's (D975,
      // filed as a refutation pin: that collision surface must not come back).
      const userOwnsName = fnIndexOfSid(sidOfNode(c.callFn)) >= 0
      // the scope's answer for the dunder intrinsics, whose arms below match the
      // spelling with no declaration lookup at all. See `identNameIsUserBound`.
      const userBindsName = identNameIsUserBound(callee.identName, fnIx)
      // `fromCodePoints(xs)` (H2): bulk string construction into the shared `__utf8_enc__`
      // helper, UTF-8-encoding the list's live code points into an exact-fit backing. Each
      // i32 is a code point, never a byte — filling the buffer by `buf.push(s[i])` instead
      // pushes bytes and double-encodes with no type error, so every `std/` builder uses `for cp`.
      if !userOwnsName && callee.identName == "fromCodePoints" {
        if !aUsed || !lUsed {
          return emitFail(
            "emitProgram: fromCodePoints but array/list types not collected",
          )
        }
        if c.callArgs.length != 1 {
          return emitFail(
            "emitProgram: fromCodePoints takes exactly one argument",
          )
        }
        let fcpArg = c.callArgs[0]
        const fcpN0 = P.nodes[fcpArg]
        if fcpN0 is Paren { fcpArg = fcpN0.parInner }
        const fcpNode = P.nodes[fcpArg]
        if fcpNode is Ident {
          // __utf8_enc__(xs.backing, 0, xs.len)
          if emitExpr(body, fcpArg, fnIx) < 0 { return -1 }
          fbStructGet(lTypeIdx, 0)
          fbI32Const(0)
          if emitExpr(body, fcpArg, fnIx) < 0 { return -1 }
          fbStructGet(lTypeIdx, 1)
          fbCall(gHelpUtf8Enc)
          return 0
        }
        return emitFail(
          "emitProgram: fromCodePoints argument must be a named i32[] binding",
        )
      }
      // `fromCodePoint(code)` is a compiler builtin (H2): construct a single-character VL
      // string from an i32 code point, riding the same `__utf8_enc__` helper `fromCodePoints`
      // does — a one-element i32 array wrapped around the argument. Sharing the encoder
      // avoids a second, inlined width-and-shift ladder disagreeing silently with it.
      if !userOwnsName && callee.identName == "fromCodePoint" {
        if !aUsed {
          return emitFail(
            "emitProgram: fromCodePoint but array type not collected",
          )
        }
        if c.callArgs.length != 1 {
          return emitFail(
            "emitProgram: fromCodePoint takes exactly one argument",
          )
        }
        if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
        fbArrayNewFixed(aTypeIdx, 1) // the one-element CODE-POINT array
        fbI32Const(0)                // start
        fbI32Const(1)                // len
        fbCall(gHelpUtf8Enc)
        return 0
      }
      // `print(x)` is a compiler builtin lowered to the host's import family: a
      // boolean-classified arg calls `__print_bool__`, anything else i32-ish
      // `__print_i32__`. The call yields nothing (void import).
      if !userOwnsName && callee.identName == "print" {
        if c.callArgs.length != 1 {
          return emitFail("emitProgram: print takes exactly one argument")
        }
        // D1576 — `print(<the `null` type>)` prints the word `null`: the value is
        // statically null, so there is no arm to select, and this must run first — every
        // classifier below reads a rep this value does not have. The argument still
        // evaluates, so a call's side effects happen.
        if exprIsNulNone(c.callArgs[0], fnIx) {
          if emitNulNoneForEffect(body, c.callArgs[0], fnIx) < 0 { return -1 }
          return emitPrintNullWord()
        }
        // print(literal-union atom): widen it to its member string — a per-member
        // `if id == <id> { print "<name>" }` chain. Asked before `exprString`, which also
        // answers true for an atom-repped global (the softened render says `string` over a
        // cell laid out as `(mut i32)`) — where they disagree, the atom answer is the rep.
        if exprIsLitAtom(c.callArgs[0], fnIx) {
          // an un-narrowed `K | null` niche is the same i32 with `-1` for null, so it prints
          // its member or the word `null`, exactly like the two niches beside it. Asked
          // first: the expanded spelling also satisfies the member-only query below, and
          // only this arm emits the sentinel.
          const lpNul = nodeNulLitUnionMemberTexts(c.callArgs[0])
          if lpNul.length > 0 {
            return emitPrintNulLitUnion(body, c.callArgs[0], lpNul, fnIx)
          }
          // `litAtomWidenTexts` is `emitAtomToStr`'s shared ladder; its declaration rung is
          // what a monomorphized instance needs, since the instance's leaf nodes share the
          // generic body and record the generic's own type parameter instead.
          const lpTexts = litAtomWidenTexts(c.callArgs[0], fnIx)
          // a claim with no texts means the rep and the recorded type disagree: the chain
          // matches nothing, rc 0 with no output — the quietest possible wrong answer.
          if lpTexts.length == 0 {
            return emitFail(
              "emitProgram: print of a literal-union atom whose type carries no member texts",
            )
          }
          const lpRc = emitPrintAtomStr(body, c.callArgs[0], lpTexts, fnIx)
          return lpRc
        }
        // a nullable-string value may genuinely hold null, and prints `null` when it does.
        // Asked before `exprString`, which also claims it (the softened render says
        // `string` over a `(ref null $a)` cell) — without the order, a possibly-null ref
        // streams straight into `array.len`, a runtime trap on a `vl check`-clean program.
        if exprNullableString(c.callArgs[0], fnIx) {
          return emitPrintNulString(body, c.callArgs[0], fnIx)
        }
        // the other niche, `boolean | null` (an i32 with sentinel 2): the fallback ladder
        // ends in `__print_bool__`, which renders any non-zero as true — an un-arrested
        // null would print true, silently.
        if exprNulBool(c.callArgs[0], fnIx) {
          return emitPrintNulBool(body, c.callArgs[0], fnIx)
        }
        // `print(<value-union box>)` dispatches on the box tag and prints the arm the
        // value holds (D712). Asked after the two niche arms — they are niches, not boxes,
        // and `printUnionPlan` declines both — and before `exprString`, on the same
        // ordering argument as the litunion-atom arm above: a rendering can claim a box.
        const puKinds: i32[] = []
        if printUnionPlan(c.callArgs[0], fnIx, puKinds) {
          return emitPrintValueUnion(body, c.callArgs[0], puKinds, fnIx)
        }
        // a union-valued argument the plan declined must not fall through: the ladder below
        // ends in `call __print_i32__` with a `(ref $uBox)` on the stack, check-clean
        // invalid wasm (D711). The checker gates on the type, this on the expression, so
        // the residue is whatever the expression-side resolvers cannot name.
        if printUnionArmsUnrenderable(c.callArgs[0], fnIx) {
          return emitFail(
            "emitProgram: print of a union value whose arms the tag dispatch cannot classify",
          )
        }
        if exprString(c.callArgs[0], fnIx) {
          return emitPrintStrExpr(body, c.callArgs[0], fnIx)
        }
        // i64 routes to `__print_i64__` (a `(i64)->()` functype) checked before bool/i32;
        // f64 to `__print_f64__`, checked first since a float operand is never i64/bool/i32;
        // f32 to `__print_f32__`, checked before f64 so a mixed f32/float-literal
        // expression (`x + 4.0` with f32 `x`) prints as f32, not f64.
        const argF32 = exprIsF32(c.callArgs[0], fnIx)
        const argI64 = exprIsI64(c.callArgs[0], fnIx)
        const argF64 = exprIsF64(c.callArgs[0], fnIx)
        if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
        if argF32 {
          fbCall(gF32PrintIdx) // 0x10 call __print_f32__
        } else if argF64 {
          fbCall(gF64PrintIdx) // 0x10 call __print_f64__
        } else if argI64 {
          fbCall(4) // 0x10 call __print_i64__ (import index 4)
        } else if exprIsBool(c.callArgs[0], fnIx) {
          fbCall(1) // 0x10 call __print_bool__ (import index 1)
        } else {
          fbCall(0) // 0x10 call __print_i32__ (import index 0)
        }
        return 0
      }
      // The linear-memory intrinsics, lowered inline (the host defines `__store_i32__`/
      // `__load_i32__` as one-instruction wasm functions): store/load become
      // `i32.store`/`i32.load` directly; `__log__` calls the synthetic in-module decoder
      // at `gMemLogIdx` (see `emitMemLogFnCode`).
      if !userBindsName && callee.identName == "__store_i32__" {
        if c.callArgs.length != 2 {
          return emitFail(
            "emitProgram: __store_i32__ takes exactly two arguments",
          )
        }
        if emitMemIntrinArg(body, c.callArgs[0], fnIx) < 0 { return -1 }
        if emitMemIntrinArg(body, c.callArgs[1], fnIx) < 0 { return -1 }
        fbI32Store()
        return 0
      }
      if !userBindsName && callee.identName == "__load_i32__" {
        if c.callArgs.length != 1 {
          return emitFail(
            "emitProgram: __load_i32__ takes exactly one argument",
          )
        }
        if emitMemIntrinArg(body, c.callArgs[0], fnIx) < 0 { return -1 }
        fbI32Load()
        return 0
      }
      // The five other store widths (`buffer-design.md` §C2): push the address (context-
      // cleared like every memory-intrinsic operand), then the value at its own declared
      // width — not `emitMemIntrinArg`, since `__store_f64__(0, 1.5)` needs `f64.const
      // 1.5` — then the opcode at its natural alignment. f32 also seeds `pendingF32`.
      if !userBindsName && nameIsMemStoreIntrinsic(callee.identName) {
        if c.callArgs.length != 2 {
          return emitFail(
            "emitProgram: " +
              callee.identName +
              " takes exactly two arguments (the byte address and the value)",
          )
        }
        if emitMemIntrinArg(body, c.callArgs[0], fnIx) < 0 { return -1 }
        if memStoreValueIsI32(callee.identName) {
          // `i32.store8` / `i32.store16` take an ordinary i32 and TRUNCATE it, so the
          // value goes through the same spine as the address and as `__store_i32__`'s
          // own value — no widening helper, and no `pendingF32` seed to save.
          if emitMemIntrinArg(body, c.callArgs[1], fnIx) < 0 { return -1 }
        } else if callee.identName == "__store_i64__" {
          if emitExprAsI64(body, c.callArgs[1], fnIx) < 0 { return -1 }
        } else if callee.identName == "__store_f32__" {
          const savedStF32 = pendingF32
          pendingF32 = true
          const stRc = emitExprAsF32(body, c.callArgs[1], fnIx)
          pendingF32 = savedStF32
          if stRc < 0 { return -1 }
        } else {
          if emitExprAsF64(body, c.callArgs[1], fnIx) < 0 { return -1 }
        }
        // The same drift guard the load arm carries, for the same reason: the name list
        // and the two tables are THREE lists over the same names in two files, and a
        // width added to one and not the others would reach here with -1 and write it as
        // an opcode byte — a silently invalid module. Unreachable while they agree.
        const msOp = memStoreOpcode(callee.identName)
        const msAlign = memStoreAlignExp(callee.identName)
        if msOp < 0 || msAlign < 0 {
          return emitFail(
            "emitProgram: '" +
              callee.identName +
              "' is a declared store width with no opcode — the intrinsic-name list and the opcode table have drifted",
          )
        }
        fbMemAccess(msOp, msAlign)
        return 0
      }
      // the bulk pair (`buffer-design.md` §C3): three i32 operands, all context-cleared
      // (no width dispatch, unlike the store arm), pushed in the instruction's own order,
      // which VL's argument order matches — a mismatched order would mean reordering
      // arbitrary expressions' side effects.
      if !userBindsName && nameIsMemBulkIntrinsic(callee.identName) {
        if c.callArgs.length != 3 {
          return emitFail(
            "emitProgram: " +
              callee.identName +
              " takes exactly three arguments (the byte count is the last)",
          )
        }
        if emitMemIntrinArg(body, c.callArgs[0], fnIx) < 0 { return -1 }
        if emitMemIntrinArg(body, c.callArgs[1], fnIx) < 0 { return -1 }
        if emitMemIntrinArg(body, c.callArgs[2], fnIx) < 0 { return -1 }
        if callee.identName == "__memory_copy__" {
          // Two memory indices: destination first, then source.
          fbMemBulk(MISC_MEMORY_COPY, 2)
        } else {
          fbMemBulk(MISC_MEMORY_FILL, 1)
        }
        return 0
      }
      // The seven other load widths (`buffer-design.md` §C2): push the address, write the
      // opcode at its natural alignment — the per-width difference is exactly two bytes,
      // held in `memLoadOpcode`/`memLoadAlignExp`. `__load_i32__` keeps its own arm above.
      if !userBindsName && nameIsMemLoadIntrinsic(callee.identName) {
        if c.callArgs.length != 1 {
          return emitFail(
            "emitProgram: " +
              callee.identName +
              " takes exactly one argument (the byte address)",
          )
        }
        if emitMemIntrinArg(body, c.callArgs[0], fnIx) < 0 { return -1 }
        // the guard above and the two tables below are three lists keyed by the same
        // names, in two files: a fourth width added to one and not the others would
        // reach here with -1 and write it as an opcode byte, a silently invalid module.
        // Unreachable while the lists agree, and free when they do.
        const mlOp = memLoadOpcode(callee.identName)
        const mlAlign = memLoadAlignExp(callee.identName)
        if mlOp < 0 || mlAlign < 0 {
          return emitFail(
            "emitProgram: '" +
              callee.identName +
              "' is a declared load width with no opcode — the intrinsic-name list and the opcode table have drifted",
          )
        }
        fbMemAccess(mlOp, mlAlign)
        return 0
      }
      // `memory.size` / `memory.grow` — the two ops that lift the 64 KiB ceiling
      // (`buffer-design.md` §B2/§S4). Both take the memory index as an immediate (0x00,
      // the one memory), never a stack operand. `memory.grow`'s -1-on-failure is the wasm
      // spec's own signal, passed through unchanged: a caller checks it as the spec describes.
      if !userBindsName && callee.identName == "__memory_size__" {
        if c.callArgs.length != 0 {
          return emitFail("emitProgram: __memory_size__ takes no arguments")
        }
        fbMemorySize()
        return 0
      }
      if !userBindsName && callee.identName == "__memory_grow__" {
        if c.callArgs.length != 1 {
          return emitFail(
            "emitProgram: __memory_grow__ takes exactly one argument (the page count to add)",
          )
        }
        if emitMemIntrinArg(body, c.callArgs[0], fnIx) < 0 { return -1 }
        fbMemoryGrow()
        return 0
      }
      if !userBindsName && callee.identName == "__log__" {
        if c.callArgs.length != 2 {
          return emitFail("emitProgram: __log__ takes exactly two arguments")
        }
        if emitMemIntrinArg(body, c.callArgs[0], fnIx) < 0 { return -1 }
        if emitMemIntrinArg(body, c.callArgs[1], fnIx) < 0 { return -1 }
        fbCall(gMemLogIdx)
        return 0
      }
      // ── the filesystem floor (`std:fs`) ────────────────────────────────────────
      // The one intrinsic family that lowers to a host call rather than instructions. One
      // arm for all ten, keyed by four small tables; the index is dynamic (reserved only
      // when used), so a miss fails loudly.
      const fsK = fsIntrinsicSlot(callee.identName)
      if fsK >= 0 {
        const fsWant = fsIntrinsicArity(fsK)
        if fsWant < 0 || c.callArgs.length != fsWant {
          return emitFail(
            "emitProgram: " +
              callee.identName +
              " takes exactly " +
              i32ToStr(fsWant) +
              " argument(s), got " +
              i32ToStr(c.callArgs.length),
          )
        }
        const fsTarget = fsIdxAt(fsK)
        if fsTarget < 0 {
          return emitFail(
            "emitProgram: '" +
              callee.identName +
              "' is called but no import was reserved for it — the use scan and the call lowering have drifted",
          )
        }
        let fsA = 0
        while fsA < c.callArgs.length {
          // threads `pendingListKind = 10` so a literal argument builds the packed
          // wrapper rather than the i32-backed list its elements suggest.
          if fsArgIsU8List(fsK, fsA) {
            if !ba8Used {
              return emitFail(
                "emitProgram: " +
                  callee.identName +
                  " takes a u8[] but the u8 list type was not collected",
              )
            }
            const savedFsLK = pendingListKind
            pendingListKind = 10
            const fsRc = emitExprWideCleared(body, c.callArgs[fsA], fnIx)
            pendingListKind = savedFsLK
            if fsRc < 0 { return -1 }
          } else {
            if fsArgIsI64(fsK, fsA) {
              // Its declared width, as the wide stores' value operand takes: an i32 left
              // on the stack for a plain literal offset would not validate.
              if emitExprAsI64(body, c.callArgs[fsA], fnIx) < 0 { return -1 }
            } else {
              if emitMemIntrinArg(body, c.callArgs[fsA], fnIx) < 0 { return -1 }
            }
          }
          fsA = fsA + 1
        }
        fbCall(fsTarget)
        return 0
      }
      // ── user externs (`extern function`) ───────────────────────────────────
      // The second family that lowers to a host call. Guarded by `userBindsName` like every
      // spelling-matched arm: a PARAMETER of the same name is a legal local and must win.
      if !userBindsName {
        const exK = externLinkOf(callee.identName)
        if exK >= 0 {
          const exWant = externArityAt(exK)
          if exWant < 0 || c.callArgs.length != exWant {
            return emitFail(
              "emitProgram: extern " +
                callee.identName +
                " takes exactly " +
                i32ToStr(exWant) +
                " argument(s), got " +
                i32ToStr(c.callArgs.length),
            )
          }
          const exTarget = externIdxAt(exK)
          if exTarget < 0 {
            return emitFail(
              "emitProgram: extern '" +
                callee.identName +
                "' is called but no import was reserved for it — the manifest and the call lowering have drifted",
            )
          }
          let exA = 0
          while exA < c.callArgs.length {
            // Its DECLARED width, not the argument's own: an i32 literal left on the stack
            // for an `i64` parameter would not validate.
            const exPT = externParamAt(exK, exA)
            if exPT == "i64" {
              if emitExprAsI64(body, c.callArgs[exA], fnIx) < 0 { return -1 }
            } else if exPT == "f64" {
              if emitExprAsF64(body, c.callArgs[exA], fnIx) < 0 { return -1 }
            } else if exPT == "f32" {
              if emitExprAsF32(body, c.callArgs[exA], fnIx) < 0 { return -1 }
            } else {
              // `i32` and `boolean` alike — a boolean is an i32 at the boundary. The checker
              // refuses every other spelling, so none reaches here.
              if emitMemIntrinArg(body, c.callArgs[exA], fnIx) < 0 { return -1 }
            }
            exA = exA + 1
          }
          fbCall(exTarget)
          return 0
        }
      }
      // The array-intrinsic floor (std-design D1 / collections-design §LS.2),
      // lowered INLINE to single WasmGC instructions (array.new /
      // array.new_default / array.copy / unreachable). `__trap__()` is the
      // deliberate abort primitive.
      if !userBindsName && callee.identName == "__trap__" {
        if c.callArgs.length > 1 {
          return emitFail(
            "emitProgram: __trap__ takes an optional string message",
          )
        }
        // `__trap__("reason")`: stream the message to the host boundary FIRST
        // (the same `__print_char__`/`__print_str_flush__` path `print(<string>)`
        // uses), so an abort carries a human-readable reason, THEN `unreachable`.
        if c.callArgs.length == 1 {
          if emitPrintStrExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
        }
        fbUnreachable()
        return 0
      }
      // `__array_new__(n, fill)` → `array.new` (every slot set to `fill`);
      // `__array_new_default__(n)` → `array.new_default` (slots zeroed). Both yield the
      // `{backing, len: n, cap: n}` list wrapper, staging the length in the 1-slot arrNew
      // scratch local. Native element coverage: i32 (i32/boolean) and, for `__array_new__`, f64.
      if (
        !userBindsName &&
        (callee.identName == "__array_new__" ||
          callee.identName == "__array_new_default__")
      ) {
        return emitArrayNewIntr(body, callIx, fnIx)
      }
      // `__array_copy__(dst, dstAt, src, srcAt, count)` → `array.copy` over the two
      // lists' backings (memmove semantics; OOB spans trap via the instruction's own
      // check). Operand order matches the instruction's stack shape, so no scratch is needed.
      if !userBindsName && callee.identName == "__array_copy__" {
        return emitArrayCopyIntr(body, callIx, fnIx)
      }
      // scope-aware, through the whole lexical chain: `buildFnMap` keys lifted functions by
      // name with first-occurrence-wins, so the flat `fnIndexOf` would resolve every
      // frame's `inner(…)` to the module's first `inner` instead of this frame's own —
      // `fnIndexOfInScopeChain` walks out and takes the innermost, gated on `nestedNameSet`.
      const target = fnIndexOfInScopeChain(callee.identName, fnIx)
      // A live closure binding of the name outranks that scan, which walks declarations
      // and so cannot see a param or a local: without it a closure-typed parameter named
      // like a module function lowers to a direct `call` on the function, and the module
      // fails to validate (D1602). Asked only on a hit, so a plain call pays nothing.
      if target >= 0 && identIsBoundClosure(callee.identName, fnIx) {
        return emitCallRef(body, callIx, fnIx)
      }
      if target < 0 {
        // Not a known function name — a closure-valued callee (a let/param/global holding
        // a function value, or a higher-order call result). Dispatch through the closure
        // fat-pointer: push env, push args, push the id, `call_indirect $fnsig`.
        if exprIsClosure(c.callFn, fnIx) {
          return emitCallRef(body, callIx, fnIx)
        }
        // The numeric-opcode intrinsics: one wasm instruction over the arguments, no
        // import and no runtime. Reached only where the name resolved to no function and
        // no closure value, which IS the shadowing rule the checker types against — a
        // program that defines its own `min` calls its own.
        const bcRc = emitBitcastIntr(body, callIx, fnIx, callee.identName)
        if bcRc != NUM_INTR_NONE { return bcRc }
        const fiRc = emitFloatIntr(body, callIx, fnIx, callee.identName)
        if fiRc != NUM_INTR_NONE { return fiRc }
        const iiRc = emitIntIntr(body, callIx, fnIx, callee.identName)
        if iiRc != NUM_INTR_NONE { return iiRc }
        return emitFail("emitProgram: call to unknown function")
      }
      // a direct call to a capturing lifted function (`add(10)` where `add` captures `n`
      // from the enclosing frame): build its closure value and `call_ref` it — a plain
      // `call` would pass a null env and lose the captures. Gated on `fnValUsed` so a
      // no-lambda module never enters this path.
      if fnValUsed && captureCountOf(target) > 0 {
        return emitCapturedCall(body, callIx, fnIx, target)
      }
      return emitDirectCall(body, callIx, fnIx, target)
    }
    // A non-Ident callee yielding a function value (`o.go(10)`, `(expr)(args)`):
    // `call_ref` over the closure fat-pointer.
    if exprIsClosure(c.callFn, fnIx) { return emitCallRef(body, callIx, fnIx) }
    // a UFCS `self`-method call: `o.f(args)` where `f` is a free function whose first
    // parameter is named `self` lowers to the direct call `f(o, args)`, by building the
    // direct-call node in the arena and re-lowering it so every coercion path is shared.
    const um = P.nodes[c.callFn]
    if um is Member {
      // a UFCS member-call normally lowers to a direct `Ident` call before emission;
      // this fallback re-derives the same direct call should it reach emit unrewritten.
      // D1120 — at the site, the same node the merge walk keys on.
      const uName = ufcsAliasAtSite(callIx, um.memProp)
      const uTarget = fnIndexOf(uName)
      if uTarget >= 0 {
        const uFn = P.nodes[fnStmts[uTarget]]
        if uFn is FuncDecl {
          const uParams = uFn.fnParams
          if uParams.length == c.callArgs.length + 1 {
            const uP0 = P.nodes[uParams[0]]
            if uP0 is Param {
              if uP0.parName == "self" {
                const uArgs: i32[] = []
                uArgs.push(um.memObj)
                let ua = 0
                while ua < c.callArgs.length {
                  uArgs.push(c.callArgs[ua])
                  ua = ua + 1
                }
                // The injected receiver is an UNNAMED slot-0 positional; any
                // named args shift right with it ("" rides slot 0) so the
                // rebuilt direct call reorders them around the receiver
                // exactly as the host does.
                const uNames: string[] = []
                if hasNamedArgs(c.callArgNames) {
                  uNames.push("")
                  let un = 0
                  while un < c.callArgNames.length {
                    uNames.push(c.callArgNames[un])
                    un = un + 1
                  }
                }
                return emitCall(
                  body,
                  mkCallN(mkIdent(uName, -1), uArgs, uNames, -1),
                  fnIx,
                )
              }
            }
          }
        }
      }
    }
    return emitFail("emitProgram: callee is not a function name")
  }
  emitFail("emitProgram: expected a call expression")
}

// The argument value nodes of the call at `callIx`, bound into parameter order for a direct
// call to the function at fnStmts position `target`. An all-positional call returns its
// source list untouched; a named call reorders by the callee's parameter names. A binding
// failure surfaces as a -1 slot/surplus entry, which `directArgsBad` detects.
function orderedDirectArgs(callIx: i32, target: i32) {
  const none: i32[] = []
  const c = P.nodes[callIx]
  if c is Call {
    if !hasNamedArgs(c.callArgNames) { return c.callArgs }
    const pNames: string[] = []
    const d = P.nodes[fnStmts[target]]
    if d is FuncDecl {
      const ps = d.fnParams
      let i = 0
      while i < ps.length {
        const p = P.nodes[ps[i]]
        if p is Param { pNames.push(p.parName) }
        i = i + 1
      }
    }
    return orderArgsByParamNames(pNames, c.callArgs, c.callArgNames)
  }
  none
}

// Is the argument at `argIx` a plain struct whose emitted heap type is union-arm `vi`'s —
// a declared layout twin sharing one heap type in the emitted module? The predicate
// (`sHeapIdx[row] == uVarHeap[vi]`) is the same test `emitUnionBoxArg` runs at the box
// boundary. False for a non-struct argument, an unresolvable row, or a slot outside the variant table.
function cloArgIsArmHeapTwin(argIx: i32, vi: i32, fnIx: i32): boolean {
  if vi < 0 { return false }
  if vi >= uVarHeap.length { return false }
  if !exprStruct(argIx, fnIx) { return false }
  const si = structIndexOfExpr(argIx, fnIx)
  if si < 0 { return false }
  if si >= sHeapIdx.length { return false }
  sHeapIdx[si] == uVarHeap[vi]
}

function emitCallRef(body: i32[], callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    if hasNamedArgs(c.callArgNames) {
      return emitFail(
        "emitProgram: named arguments require a declared function",
      )
    }
    // Evaluate the closure once into the call-ref scratch local (`callRefSlot`).
    if emitExpr(body, c.callFn, fnIx) < 0 { return -1 }
    // A NULLABLE function value (`fn | null`, kind 19) loads as `(ref null $cloStruct)`;
    // the scratch slot is non-null, and the checker proved it non-null here (the `if c !=
    // null` narrowing), so recover to non-null.
    if exprNulClosure(c.callFn, fnIx) {
      wU8(212) // 0xd4 ref.as_non_null
    }
    fbLocalSet(callRefSlot)
    // the callee's interned `$fnsig` key — from a function-typed annotation, an inferred
    // binding's sig, a field closure's, or a closure-array element's. Its tokens drive
    // argument coercion below and resolve the functype `ref.cast`s to; "" falls back to
    // the all-i32 arity sig.
    const ckey = cloCallSigKey(callIx, fnIx)
    // soundness floor: a value-union closure result with a composite member (`(i32) => f32
    // | {w:i32}`) is not yet representable — the lambda infers its one concrete arm while
    // the checker types the call as the whole union, so the narrow that reads it mis-reads
    // the plain rep as the box. Reject rather than leak the unsound narrow to invalid wasm.
    if cloCallUnionResultUnrepresentable(callIx, fnIx) {
      return emitFail(
        "emitProgram: value-union closure RESULT is not yet representable",
      )
    }
    // A ref-list closure result whose PRODUCER lambda and cast annotation key distinct,
    // non-layout-twin element slots (a nullable-element list built from a non-null literal):
    // the wrapper structs are distinct heap types, so the call-ref `ref.cast` would TRAP.
    // Reject cleanly — the deferred nullable-element ref-list composition.
    if cloCallReflistElemTwin(callIx, fnIx) {
      return emitFail(
        "emitProgram: closure ref-list result element twin (deferred value-ABI composition)",
      )
    }
    // env = closure.env (field 0).
    fbLocalGet(callRefSlot)
    fbStructGet(cloStructIdx, 0)
    // args, each COERCED to its parameter's scalar valtype (an i32 literal widened into an i64 / f64
    // / f32 param) — the `call_ref` functype demands the exact valtype, exactly as a direct call.
    const args = c.callArgs
    // each argument's valtype is decided by its parameter, so an enclosing wide-scalar
    // context must not leak into it (cleared here, restored after, mirroring the index-
    // receiver discipline) — else a bare i32 literal argument under an outer f32/atom
    // context lowers at the wrong valtype for the `call_ref` functype: invalid wasm.
    const savedArgF32 = pendingF32
    const savedArgF64 = pendingF64
    const savedArgI64 = pendingI64
    const savedArgLU = pendingLitUnion
    const savedArgNulLU = pendingNulLitUnion
    pendingF32 = false
    pendingF64 = false
    pendingLitUnion = 0
    pendingNulLitUnion = false
    pendingI64 = false
    let i = 0
    while i < args.length {
      // D940 — the struct row the functype declares, seeded exactly as the direct call
      // seeds it from `paramStructIdxOf`: an object-literal argument otherwise resolves
      // its own row by field set, the pre-merge row wherever the callee's parameter row
      // moved. The seed is the key's, so it agrees with the functype by construction.
      const pkk = sigParamKindAt(ckey, i)
      if pkk == "struct" || pkk == "nulstruct" {
        pendingStructIdx = sigParamSlotAt(ckey, i)
      }
      const pck = sigParamCoerceKind(ckey, i)
      if pck == "i64" {
        if emitExprAsI64(body, args[i], fnIx) < 0 { return -1 }
      } else if pck == "f64" {
        if emitExprAsF64(body, args[i], fnIx) < 0 { return -1 }
      } else if pck == "f32" {
        if emitExprAsF32(body, args[i], fnIx) < 0 { return -1 }
      } else {
        // the literal-union param positions: a member-literal argument lowers as its
        // interned i32 atom id, and a `null` argument into a `K | null` param as the
        // sentinel `-1` — without them a string ref reached an i32 param slot, invalid
        // wasm with `vl check` clean, in every function-value shape.
        const clu = cloCallParamLitUnion(callIx, i)
        // the value-union param position (the box `u`): the kind comes off the resolved
        // `$fnsig` key so the coercion cannot disagree with the bytes; the box's own
        // identity comes from the checker type instead, since it is slot-free in the ABI —
        // else a raw member argument pushes a string ref where the box is needed.
        let cuNm = ""
        if sigParamKindAt(ckey, i) == "union" {
          cuNm = cloCallParamUnionName(callIx, i, fnIx)
          if cuNm == "" {
            // the key says box and no registered name resolves — a producer disagreement,
            // not a shape the rep declines. Refuse loudly rather than push the un-boxed
            // operand: invalid wasm is the one outcome this arm must never reach.
            return emitFail(
              "emitProgram: value-call union parameter has no resolvable union name",
            )
          }
        }
        // the arm-parameter arm (D269, direction 2 of D200): a `variant` parameter demands
        // one heap type (`uVarHeap[vi]`), so a raw push stays a floor except where it is
        // provably safe. The slot comes off the resolved `$fnsig` key, so the cast target
        // cannot disagree with the bytes.
        let cvSlot = -1
        if sigParamKindAt(ckey, i) == "variant" {
          cvSlot = sigParamSlotAt(ckey, i)
          const cvArg = P.nodes[unwrapParen(args[i])]
          // the layout-twin argument (D732): with a twin declared, the arm and the struct
          // share one heap type in the emitted module (`uVarSTwin`), so the raw push the
          // direct call already performs is valid by construction (asked of the heaps,
          // not the tables — `emitUnionBoxArg`'s discipline at the same seam).
          const cvTwin = cloArgIsArmHeapTwin(args[i], cvSlot, fnIx)
          const cvBuildable = cvSlot >= 0 &&
            (exprUnion(args[i], fnIx) ||
            cvArg is ObjLit ||
            cvTwin)
          if exprVariantIndex(args[i], fnIx) < 0 && !cvBuildable {
            return emitFail(
              "emitProgram: value-call union-ARM parameter given a value that is not that arm — a value call does not yet build one (annotate the binding as the arm, or call it as a named function)",
            )
          }
        }
        if cvSlot >= 0 && exprVariantIndex(args[i], fnIx) < 0 {
          // the two ported seeds. `exprVariantIndex >= 0` means the argument already is
          // the arm, bytes unchanged, so neither fires on it.
          const cvCtx = expCtxHere()
          cvCtx.variantIdx = cvSlot
          if emitExprExpect(body, args[i], fnIx, cvCtx) < 0 { return -1 }
          pendingVariantIdx = -1
          if exprUnion(args[i], fnIx) {
            fbStructGet(uBoxIdx, 1)     // 0xfb 0x02 <box ht> field 1: value (anyref)
            fbRefCast(uVarHeap[cvSlot]) // 0xfb 0x16 <variant struct> ref.cast (non-null)
          }
        } else if cuNm != "" {
          if emitUnionBoxArg(body, cuNm, args[i], fnIx) < 0 { return -1 }
        } else if (
          sigParamKindAt(ckey, i) == "str" &&
          exprIsLitAtom(args[i], fnIx)
        ) {
          // the mirror of `clu`: a literal-union atom argument flowing into a `string`
          // parameter widens to its member string, since the functype declares `(ref
          // $array)` there and the atom local holds an i32 id — a `string` token is a ref,
          // unlike the litunion token, so it is never confusable with i32.
          if emitAtomToStr(body, args[i], fnIx) < 0 { return -1 }
        } else if clu == 0 {
          if emitExpr(body, args[i], fnIx) < 0 { return -1 }
        } else {
          const cluCtx = expCtxHere()
          cluCtx.litUnion = 1
          if clu == 2 { cluCtx.nulLitUnion = true }
          if emitExprExpect(body, args[i], fnIx, cluCtx) < 0 { return -1 }
        }
      }
      i = i + 1
    }
    pendingF32 = savedArgF32
    pendingF64 = savedArgF64
    pendingI64 = savedArgI64
    pendingLitUnion = savedArgLU
    pendingNulLitUnion = savedArgNulLU
    // id = closure.id (field 1) — the callee's wasm function index, `call_indirect`'d at
    // the concrete `$fnsig` (the engine signature-checks the callee against it).
    let sig = -1
    if ckey != "" { sig = cloSigTypeIdxAt(cloSigPosOfKey(ckey)) }
    if sig < 0 { sig = fnSigIdxForArity(args.length) }
    if sig < 0 {
      return emitFail(
        "emitProgram: function-value call arity has no interned signature",
      )
    }
    fbLocalGet(callRefSlot)
    fbStructGet(cloStructIdx, 1)     // the callee's wasm function index
    fbCallIndirect(sig, gFnTableIdx) // 0x11 <fnsig> <table>
    return 0
  }
  emitFail("emitProgram: expected a call expression")
}

// ── statement-sequence lowering ──────────────────────────────────────────────
// A function body is a sequence of statements, lowered onto `body` in order. Control
// flow relies on explicit `return`s rather than block result types: an `if` is a void
// structured block whose branches `return` on their own, so it never yields a value.

// Lower an assignment `target = value` onto `body`: emit the value expression, then
// `local.set <index>` for the target local. The target must be a bare `Ident` naming a
// param or declared local (no member/indexed assignment in this slice).
function emitAssign(body: i32[], binIx: i32, fnIx: i32) {
  const a = P.nodes[binIx]
  if a is BinExpr {
    // the target is read through `unwrapParen`, exactly as the RHS already is (D1089):
    // `(x) = 5` is check-clean, so a `Paren` LHS matching none of the Ident/Index/Member
    // arms reached the floor with the wrong message. Peeling here is one change for all
    // six delivery positions; `sidOfNode(lhsIx)` is load-bearing since a `Paren` node interns its own sid.
    const lhsIx = unwrapParen(a.binLeft)
    const target = P.nodes[lhsIx]
    if target is Ident {
      // the loop-local accumulator: a binding proven by `strAccScan` to append in place
      // into its own buffer's slack instead of allocating a fresh exact-fit string per
      // step — O(n) where the pairwise lowering is O(n^2). An unproven binding never reaches it.
      if strAccAppendOk(binIx, fnIx) {
        return emitStrAccAppend(body, binIx, fnIx)
      }
      const idx = localIndexOf(fnIx, target.identName)
      if idx < 0 {
        // Not a local — a module global? Store with `global.set` (0x24 <globalidx>).
        const gIdx = globalIndexOfSid(sidOfNode(lhsIx))
        if gIdx >= 0 {
          // seed the assigned global's declared type context so the RHS literal builds the
          // same wasm type the cell expects (e.g. `globalNames = []` builds a string-list
          // wrapper, not the default i32-list) — mirroring the global-init seeding.
          const gLet = globalStmts[gIdx]
          const gaKind = globalCellKind(gLet)
          if gaKind == "struct" { pendingStructIdx = globalCellStructIdx(gLet) }
          // a nullable-struct global (`g = null` / `g = { … }` over `let g: S | null`): the
          // cell is `(ref null $S)`, so a bare `null` needs the same struct seed the
          // non-null-cell line above gives — from `nulRefStructIdxOfLet`'s `| null` peel.
          if gaKind == "nulstruct" {
            pendingStructIdx = nulRefStructIdxOfLet(gLet, -1)
          }
          // an arm cell (kind-8 `variant` or `nulvariant`) seeds the variant index, exactly
          // as the binding boundary does, so an object-literal RHS builds the bare
          // `(ref $uVarHeap[vi])` instead of the `{tag, value}` box (D1031's unbox reads the same resolver).
          const gaArmIdx = globalCellArmIdx(gLet, gaKind)
          const gaCellIsArm = gaKind == "variant" || gaKind == "nulvariant"
          if gaCellIsArm { pendingVariantIdx = gaArmIdx }
          pendingListKind = letAnnRefListKind(gLet)
          pendingListSlot = letAnnRefListSlot(gLet)
          // an empty-`[]`-initialized `S[] | null` global's mono-i32-list misread is
          // `exprArray`/`exprRefArray`'s bug in `emit_classify.vl`, not these seeds'. A
          // map-typed global seeds the map shape, so a bare `Map()` RHS constructs this
          // binding's map struct instead of the shared mono one.
          if exprMap(lhsIx, fnIx) {
            pendingMapSlot = mapShapeOfExpr(lhsIx, fnIx)
          }
          // a union-typed global (kind 4) coerces a raw assigned value into the box; three
          // shapes are not that: a literal-union global's cell is a plain `(mut i32)` atom,
          // a concrete-variant RHS must be boxed unconditionally since a union global's
          // cell is always the box, and an arm cell is not the box either.
          const gUNm = letUnionNameOf(gLet, -1)
          if gUNm != "" && !nameIsLitUnionType(gUNm) && !gaCellIsArm {
            if emitUnionBoxArg(body, gUNm, a.binRight, fnIx) < 0 { return -1 }
          } else if exprIsI64(lhsIx, fnIx) {
            // an i64 global target widens an i32 RHS to i64: the bare `i32.const` otherwise
            // clashes with the i64 slot (the checker accepts the assignment, so it is a
            // soundness hole). An already-i64 RHS makes `emitExprAsI64` a no-op.
            if emitExprAsI64(body, a.binRight, fnIx) < 0 { return -1 }
          } else if exprIsF64(lhsIx, fnIx) {
            // the f64 twin: an integer-literal RHS needs widening into `(mut f64)`; an
            // f64-literal RHS needs none.
            if emitExprAsF64(body, a.binRight, fnIx) < 0 { return -1 }
          } else if exprIsF32(lhsIx, fnIx) {
            // the f32 cell: a float RHS must re-encode at single precision, since a bare
            // `.` literal lowers at f64 by default. `emitExprAsF32` re-encodes the literal
            // and delegates everything else. Ordered after the f64 arm: the two classifiers
            // are mutually exclusive over an Ident target, so neither steals the other's cell.
            if emitExprAsF32(body, a.binRight, fnIx) < 0 { return -1 }
          } else if (
            exprString(lhsIx, fnIx) &&
            exprIsLitAtom(a.binRight, fnIx)
          ) {
            // A literal-union atom assigned to a `string` global widens to its member string.
            if emitAtomToStr(body, a.binRight, fnIx) < 0 { return -1 }
          } else if gaKind == "nulnone" {
            // D1576 — the module-global twin of the local arm's `nulnone` store: a
            // `null`-typed cell takes `ref.null none` and nothing else.
            if emitNulNoneForEffect(body, a.binRight, fnIx) < 0 { return -1 }
            fbRefNullNone()
          } else {
            // a niche `X | null` global seeds its null rep for a bare `null` RHS (the table
            // at `emitNullLitNode`), mirroring the seed the global's own initializer gets;
            // a non-null RHS ignores the seed.
            const gsCtx = expCtxForCell(gaKind)
            if exprNulBool(lhsIx, fnIx) { gsCtx.nulBool = true }
            if exprNullableString(lhsIx, fnIx) { gsCtx.nulString = true }
            if exprNulClosure(lhsIx, fnIx) { gsCtx.nulClosure = true }
            if exprNullableList(lhsIx, fnIx) { gsCtx.nulList = true }
            if exprNulLitUnion(lhsIx, fnIx) {
              gsCtx.nulLitUnion = true
              gsCtx.litUnion = 1
            }
            const gaNSK = exprNulScalarListKind(lhsIx, fnIx)
            if gaNSK != null {
              gsCtx.listKind = nulScalarListBuildKind(gaNSK)
              gsCtx.nulRefHeap = nulScalarListWrapHeap(gaNSK)
            }
            if exprNullableMap(lhsIx, fnIx) {
              gsCtx.nulRefHeap = mapTypeIdxOf(mapShapeOfExpr(lhsIx, fnIx))
            }
            // the `nulvariant` niche (`gv = null` → `ref.null $uVarHeap[vi]`), armed only
            // for a bare `null` RHS (the #964 seed-leak gate) so a non-null RHS keeps the ambient seed.
            if gaKind == "nulvariant" {
              const gnvRhs = P.nodes[unwrapParen(a.binRight)]
              if gnvRhs is NullLit {
                gsCtx.nulRefHeap = armDestHeapOf(gaKind, gaArmIdx)
              }
            }
            // a kind-18 nullable ref-array global's null is this global's element wrapper
            // (`pendingListSlot` above already holds the slot), armed only for a bare `null`
            // RHS (the #964 seed-leak gate) so a `[null]` element takes its own heap type instead.
            if gaKind == "nulreflist" {
              if pendingListSlot >= 0 && pendingListSlot < rlWrapIdx.length {
                const gnraRhs = P.nodes[unwrapParen(a.binRight)]
                if gnraRhs is NullLit {
                  gsCtx.nulRefHeap = rlWrapIdx[pendingListSlot]
                }
              }
            }
            // a literal-union global (`v = "b"` over `let v: K`): the member RHS lowers as
            // its interned i32 id, not a heap string — the other half of the litunion
            // exclusion above.
            if exprIsLitAtom(lhsIx, fnIx) { gsCtx.litUnion = 1 }
            if emitExprExpect(body, a.binRight, fnIx, gsCtx) < 0 { return -1 }
          }
          pendingListKind = 0
          pendingListSlot = 0
          pendingMapSlot = -1
          // the scalar dual (D965) at the global-assignment boundary (`b = e` between two
          // module globals) — distinct from the global-init copy in `emit_sections`, since
          // a re-assignment is ordinary code and a const initializer a wasm constexpr.
          emitScalarListWidenSite(body, a.binRight, fnIx, gaKind)
          // the narrowed-arm unbox at the same boundary (D1031) — `gv = s` under `if s is
          // Circle`, between two module globals; `armDestHeapOf` reads the destination pair.
          if narrowedArmNeedsUnbox(a.binRight, fnIx) {
            emitNarrowedArmUnboxTo(armDestHeapOf(gaKind, gaArmIdx))
          }
          // the nullable-niche recover at the same boundary (D1115) — `g = y` under
          // `if y != null`, into a global whose cell is a non-null ref.
          if nulNicheRecoverOwed(gaKind, a.binRight, fnIx) { fbRefAsNonNull() }
          // the two seeds this arm sets must be cleared here too (D1563), or an arm-cell
          // store leaves `pendingVariantIdx` armed for a later `c = null` into an unrelated
          // nullable struct, which then reads the stale variant seed first.
          pendingStructIdx = -1
          pendingVariantIdx = -1
          return emitUserGlobalSet(gIdx) // 0x24 global.set, or a promoted `local.set`
        }
        return emitFail(
          "emitProgram: assignment target is not a parameter, local, or global",
        )
      }
      // a map-typed local seeds the map shape for a bare `Map()` RHS, exactly as the
      // global arm above.
      if exprMap(lhsIx, fnIx) { pendingMapSlot = mapShapeOfExpr(lhsIx, fnIx) }
      // the list seeds a local target needs, keyed off the target expression
      // (`exprListCellBuildKind`) since a declared local has no `LetDecl` left to read and
      // a param never had one — else a list-literal RHS builds the default i32 list into a
      // non-i32 slot. Saved and restored around the whole arm; `fbLocalSet` is no reset.
      const savedAsLK = pendingListKind
      const savedAsLS = pendingListSlot
      pendingListKind = exprListCellBuildKind(lhsIx, fnIx)
      pendingListSlot = exprListCellBuildSlot(lhsIx, fnIx)
      // a union-typed local (kind 4) coerces a raw assigned value into the box (`u = 3.5`
      // over `let u: i32 | f64` boxes the f64); a union-valued RHS passes through unchanged.
      const aUNm = unionNameOfIdentSid(sidOfNode(lhsIx), fnIx)
      if aUNm != "" && !nameIsLitUnionType(aUNm) {
        // a literal-union target is an i32 atom, not a value-union box, and falls through
        // to the seed block below. A kind-4 union-box local boxes a concrete variant RHS
        // like a call arg/return; a kind-8 variant-init local keeps the raw variant rep, so
        // it must not box — use the plain coerce there.
        if declaredKind(target.identName) == "union" {
          if emitUnionBoxArg(body, aUNm, a.binRight, fnIx) < 0 { return -1 }
        } else {
          if emitUnionCoerce(body, aUNm, a.binRight, fnIx) < 0 { return -1 }
        }
      } else if exprNulLitUnion(lhsIx, fnIx) {
        // a `K | null` niche target: the i32 cell holds an atom id or sentinel `-1`. Seeded
        // before the `string` branch, which would otherwise widen the member RHS to a heap string.
        const nluCtx = expCtxHere()
        nluCtx.nulLitUnion = true
        nluCtx.litUnion = 1
        if emitExprExpect(body, a.binRight, fnIx, nluCtx) < 0 { return -1 }
      } else if exprIsI64(lhsIx, fnIx) {
        // An i64 target (`x = 0` over `let x: i64`) widens an i32 RHS to i64 — without this the
        // bare `i32.const` clashes with the i64 slot (the checker accepts the assignment, so it
        // is a soundness hole). `emitExprAsI64` is a no-op for an already-i64 RHS.
        if emitExprAsI64(body, a.binRight, fnIx) < 0 { return -1 }
      } else if exprIsF64(lhsIx, fnIx) {
        // An f64 target (`y = 3` over `let y: f64`) widens an i32 RHS to f64, same rationale.
        if emitExprAsF64(body, a.binRight, fnIx) < 0 { return -1 }
      } else if exprIsF32(lhsIx, fnIx) {
        // An f32 target (`g = 2.5` over `let g: f32`) re-encodes a float RHS at SINGLE
        // precision — the twin of the global arm's f32 cell above, missing here for the
        // same reason and with the same witness (`emitExpr` defaults a bare `.` literal to
        // f64, so the `(mut f32)` slot took an `f64.const`). Params take this arm too.
        if emitExprAsF32(body, a.binRight, fnIx) < 0 { return -1 }
      } else if exprString(lhsIx, fnIx) && exprIsLitAtom(a.binRight, fnIx) {
        // A literal-union atom assigned to a `string` local widens to its member string.
        if emitAtomToStr(body, a.binRight, fnIx) < 0 { return -1 }
      } else if identCellVKind(lhsIx, fnIx) == "nulnone" {
        // D1576 — the only value a `null`-typed cell can take is `null`, so this needs no
        // rep decision from either side: `ref.null none`, the RHS still evaluated for effects.
        if emitNulNoneForEffect(body, a.binRight, fnIx) < 0 { return -1 }
        fbRefNullNone()
      } else {
        // A NICHE `X | null` local seeds its null rep for a bare `null` RHS, as the global
        // arm above does. A non-null RHS ignores the seed (a boolean is a `BoolLit`, a
        // function RHS builds the non-null closure value).
        const asCtx = expCtxHere()
        if exprNulBool(lhsIx, fnIx) { asCtx.nulBool = true }
        if exprNullableString(lhsIx, fnIx) { asCtx.nulString = true }
        if exprNulClosure(lhsIx, fnIx) { asCtx.nulClosure = true }
        if exprNullableList(lhsIx, fnIx) { asCtx.nulList = true }
        // a nullable struct, a distinct-backing nullable scalar list, and a nullable map
        // each need their own seed here (mirroring `emitLetDeclStmt`'s kind ladder) —
        // without it, `a = null` rejects while the same binding initialized to `null` runs.
        if exprNullableStruct(lhsIx, fnIx) {
          const asSi = structIndexOfExpr(lhsIx, fnIx)
          if asSi >= 0 { asCtx.structIdx = asSi }
        }
        const asNSK = exprNulScalarListKind(lhsIx, fnIx)
        if asNSK != null {
          asCtx.listKind = nulScalarListBuildKind(asNSK)
          asCtx.nulRefHeap = nulScalarListWrapHeap(asNSK)
        }
        if exprNullableMap(lhsIx, fnIx) {
          asCtx.nulRefHeap = mapTypeIdxOf(mapShapeOfExpr(lhsIx, fnIx))
        }
        // a kind-18 nullable ref-array's null is this binding's inner element wrapper —
        // the same wrapper the declaration's `= null` seeds (`refListSlotOfExpr` rounds
        // the ident back to it) — armed only for a bare `null` RHS (the #964 seed-leak
        // gate), so a `[null]` element still takes its own heap type.
        if exprNullableRefArray(lhsIx, fnIx) {
          const asRls = refListSlotOfExpr(lhsIx, fnIx)
          if asRls >= 0 && asRls < rlWrapIdx.length {
            const asNraRhs = P.nodes[unwrapParen(a.binRight)]
            if asNraRhs is NullLit { asCtx.nulRefHeap = rlWrapIdx[asRls] }
          }
        }
        // the variant niche (`c: Circle | null`): its null is `ref.null $uVarHeap[vi]`, the
        // declaration's own heap, and an object-literal RHS needs the index seed too, else
        // `emitObj` boxes it instead of building the concrete variant (D22). The heap seed
        // carries the #964 leak gate like its ref-array sibling; a niche-value RHS ignores it.
        if exprNullableVariant(lhsIx, fnIx) {
          const asNvi = nulVariantIdxOfExpr(lhsIx, fnIx)
          if asNvi >= 0 {
            asCtx.variantIdx = asNvi
            if asNvi < uVarHeap.length {
              const asNvRhs = P.nodes[unwrapParen(a.binRight)]
              if asNvRhs is NullLit { asCtx.nulRefHeap = uVarHeap[asNvi] }
            }
          }
        }
        // A literal-union local (`k = "b"`): the member RHS lowers as its interned i32 id.
        if exprIsLitAtom(lhsIx, fnIx) { asCtx.litUnion = 1 }
        if emitExprExpect(body, a.binRight, fnIx, asCtx) < 0 { return -1 }
      }
      pendingMapSlot = -1
      pendingListKind = savedAsLK
      pendingListSlot = savedAsLS
      // read-only covariance at the ASSIGNMENT boundary (D791) — `aU = lv1` over a
      // `let aU: Shape[]` and a `Circle[]`-repped `lv1`.
      emitRefListWidenSite(
        body,
        a.binRight,
        exprEmittedRefListSlot(a.binRight, fnIx),
        exprEmittedRefListSlot(lhsIx, fnIx),
      )
      // the scalar dual (D965) — `b = e` over a `let b: f64[]`. The destination is an
      // EXPRESSION here, not an annotation or a cell column, so its element kind comes
      // from classifying the LHS — the same classifier the source side uses.
      const asgDE = scalarListElemKind(lhsIx, fnIx)
      if asgDE != null {
        emitScalarListWidenSiteElem(body, a.binRight, fnIx, asgDE)
      }
      // the nullable-niche recover at the ASSIGNMENT boundary (D1115) — `z = y` under
      // `if y != null`, into a local or parameter whose slot is a non-null ref. The
      // destination is a NAME here, so its own cell kind is the destination kind.
      if nulNicheRecoverOwed(identCellVKind(lhsIx, fnIx), a.binRight, fnIx) {
        fbRefAsNonNull()
      }
      fbLocalSet(idx) // 0x21 local.set
      return 0
    }
    if target is Index {
      // G8: a map store `m[k] = v` — scan for `k`; overwrite `vals[hit]` on a hit, else
      // append `keys.push(k); vals.push(v)`. Checked BEFORE the list path (a map index
      // is not an array index).
      if exprMap(target.idxArr, fnIx) {
        return emitMapSet(
          body,
          target.idxArr,
          target.idxIndex,
          a.binRight,
          fnIx,
        )
      }
      // indexed store `a[i] = v`: evaluate the wrapper + index, guard `i u< len` and
      // unwrap to the backing, then the value, then `array.set`. A ref list stores a
      // struct ref/union box over the ref list/backing indices; an i32 list stores an i32.
      const isRef = exprRefArray(target.idxArr, fnIx)
      const isStr = exprStringArray(target.idxArr, fnIx)
      // the scalar non-i32 lists: the same unwrap+`array.set` spine over their own
      // wrapper/backing, with the value coerced to the element valtype.
      const isF64 = exprF64Array(target.idxArr, fnIx)
      const isI64 = exprI64Array(target.idxArr, fnIx)
      const isF32 = exprF32Array(target.idxArr, fnIx)
      // the packed byte list — an i32-element list with a one-byte backing, the one rep
      // the `else` i32 fall-through below would otherwise silently claim.
      const isU8 = exprU8Array(target.idxArr, fnIx)
      let lTy = lTypeIdx
      let aTy = aTypeIdx
      // the bounds-check frame kind (+ ref-list table slot) for this target list — the
      // write guards `i u< len` exactly like the read path.
      let idxKind: MfKind = "i32"
      let idxSlot = 0
      // the element-value seeds, as `emitArr` seeds a literal's elements: kind 1 hints the
      // list's declared element struct so `xs[i] = { … }` beats a first-field-name match;
      // kind 2 boxes the value into the shared box; a nested-list element emits under the
      // inner list's own context (`refElemValueCtx`), so `b[i] = [7, 8]` over `i64[][]` builds an i64 list.
      let storeStructIdx = -1
      // the store's variant hint (D796): a ref-list element whose name is a union arm has
      // no struct-table row (`rlElemStructRow` declines it on purpose, D32) — the missing
      // half tells the value where to build instead, else `a[0] = { r: 9 }` stores a box
      // into a `(ref null $Circle)` slot, check-clean invalid wasm.
      let storeVariantIdx = -1
      let storeUnionNm = ""
      let storeNestSlot = -1
      if isRef {
        if !rlUsed {
          return emitFail(
            "emitProgram: ref indexed assignment but ref list type not collected",
          )
        }
        const rslot = refListSlotOfExpr(target.idxArr, fnIx)
        lTy = rlWrapIdx[rslot]
        aTy = rlBackIdx[rslot]
        idxKind = "ref"
        idxSlot = rslot
        if rlElemKindTbl[rslot] == 1 {
          storeStructIdx = rlElemStructRow(rslot)
          // ...and where that declines, the element is an ARM: seed the variant so the
          // ObjLit builds at `uVarHeap[vi]`, the heap the slot's own minting used.
          if storeStructIdx < 0 {
            storeVariantIdx = variantIndexOf(nonNulBaseOf(rlElemName[rslot]))
          }
        }
        if rlElemKindTbl[rslot] == 2 { storeUnionNm = rlElemName[rslot] }
        // Every element kind whose value emit needs the slot's context — a nested list,
        // the nullable-CLOSURE niche, a MAP element — through ONE predicate.
        if rlElemNeedsValueCtx(rslot) { storeNestSlot = rslot }
      } else if isStr {
        // a string list `xs[i] = s`: unwrap to its `(ref null $sTypeIdx)` backing and
        // store the string ref, mirroring `emitIndex`'s string path — else it falls into
        // the i32-list case and `struct.get`s the wrong wrapper type.
        if !slUsed {
          return emitFail(
            "emitProgram: string indexed assignment but string list type not collected",
          )
        }
        lTy = mkListIdx
        aTy = mkArrIdx
        idxKind = "str"
      } else if isF64 {
        if !fa64Used {
          return emitFail(
            "emitProgram: f64 indexed assignment but f64 list type not collected",
          )
        }
        lTy = fl64TypeIdx
        aTy = fa64TypeIdx
        idxKind = "f64"
      } else if isI64 {
        if !ia64Used {
          return emitFail(
            "emitProgram: i64 indexed assignment but i64 list type not collected",
          )
        }
        lTy = il64TypeIdx
        aTy = ia64TypeIdx
        idxKind = "i64"
      } else if isF32 {
        if !fa32Used {
          return emitFail(
            "emitProgram: f32 indexed assignment but f32 list type not collected",
          )
        }
        lTy = fl32TypeIdx
        aTy = fa32TypeIdx
        idxKind = "f32"
      } else if isU8 {
        // a `u8[]` store: the same unwrap + `array.set` spine over the packed backing. The
        // value takes the plain i32 path below — a `u8` element value is an i32, and
        // `array.set`'s i8 storage truncates it to the low 8 bits.
        if !ba8Used {
          return emitFail(
            "emitProgram: u8 indexed assignment but u8 list type not collected",
          )
        }
        lTy = bl8TypeIdx
        aTy = ba8TypeIdx
        idxKind = "u8"
      } else {
        if !lUsed {
          return emitFail(
            "emitProgram: indexed assignment but list type not collected",
          )
        }
        if !exprArray(target.idxArr, fnIx) {
          return emitFail(
            "emitProgram: indexed-assignment target is not an array",
          )
        }
      }
      // source order — receiver, index, value — with the wrapper + index parked on the
      // stack while the value's user code runs. The backing and len resolve only after
      // the value, since an RHS that pushes onto the target list reallocates it; a live
      // hoist row skips the receiver and guards the cached header, safe in a call-free loop.
      const stHz = liveHoistRow(target.idxArr, idxKind, idxSlot)
      if stHz < 0 {
        if emitExpr(body, target.idxArr, fnIx) < 0 { return -1 }
      }
      if emitExpr(body, target.idxIndex, fnIx) < 0 { return -1 }
      pendingStructIdx = storeStructIdx
      const savedSVI = pendingVariantIdx
      if storeVariantIdx >= 0 { pendingVariantIdx = storeVariantIdx }
      if storeUnionNm != "" {
        if emitUnionBoxArg(body, storeUnionNm, a.binRight, fnIx) < 0 {
          return -1
        }
      } else if storeNestSlot >= 0 {
        // A nested-list row store: the RHS builds as the INNER list (inert for a
        // non-literal RHS — an ident/call emits unchanged).
        const snCtx = refElemValueCtx(storeNestSlot)
        if emitExprExpect(body, a.binRight, fnIx, snCtx) < 0 { return -1 }
      } else if isF64 {
        // The stored value re-encodes at the element valtype (a bare-int / int-literal value
        // widens into the f64 slot, exactly as a binding / push does).
        if emitExprAsF64(body, a.binRight, fnIx) < 0 { return -1 }
      } else if isI64 {
        if emitExprAsI64(body, a.binRight, fnIx) < 0 { return -1 }
      } else if isF32 {
        const savedPF32 = pendingF32
        pendingF32 = true
        if emitExprAsF32(body, a.binRight, fnIx) < 0 { return -1 }
        pendingF32 = savedPF32
      } else if arrElemLitUnionTy(target.idxArr, fnIx) >= 0 {
        // `xs[i] = "a"` over a literal-union array: the member RHS lowers as its atom id —
        // the store half of the boundary `exprIsLitAtom`'s Index arm reads. Without it a
        // monomorphized instance's target classifies off the generic's shared node and
        // falls through to the string-widen arm, storing a ref into an i32 backing.
        const xluCtx = expCtxHere()
        xluCtx.litUnion = 1
        if emitExprExpect(body, a.binRight, fnIx, xluCtx) < 0 { return -1 }
      } else if nodeArrayElemIsNulBool(target.idxArr) {
        // `p[i] = null` over a `(boolean | null)[]`: the i32 cell holds 0/1 or the
        // sentinel 2 — seed `pendingNulBool` (via the ctx) so a `null` RHS emits 2 (a
        // boolean RHS is a `BoolLit`, untouched). The list analogue of the scalar niche
        // assignment above.
        const nbCtx = expCtxHere()
        nbCtx.nulBool = true
        if emitExprExpect(body, a.binRight, fnIx, nbCtx) < 0 { return -1 }
      } else if nodeArrayElemIsNulLitUnion(target.idxArr) {
        // `p[i] = "a"` / `p[i] = null` over a `(K | null)[]`: a member RHS lowers as its atom id, a
        // `null` as the `-1` sentinel — seed BOTH `litUnion` and `nulLitUnion` via the ctx.
        const nluCtx = expCtxHere()
        nluCtx.litUnion = 1
        nluCtx.nulLitUnion = true
        if emitExprExpect(body, a.binRight, fnIx, nluCtx) < 0 { return -1 }
      } else if exprIsLitAtom(a.binRight, fnIx) {
        // a literal-union atom stored into a string-backed list element widens to its
        // member string — reached only once the atom-element arms above decline, so the
        // list is genuinely string-backed and the atom's i32 id cannot go in raw.
        if emitStrValue(body, a.binRight, fnIx) < 0 { return -1 }
      } else {
        if emitExpr(body, a.binRight, fnIx) < 0 { return -1 }
      }
      pendingStructIdx = -1
      pendingVariantIdx = savedSVI
      const storeValSlot = listIdxValSlot(idxKind, idxSlot)
      fbLocalSet(storeValSlot) // 0x21 — park the value under the guard operands
      // Guard `i u< len`, unwrap to the backing (`struct.get` field 0) — leaves
      // [backing, safeIndex] resolved AFTER the value ran.
      if stHz >= 0 {
        emitListIdxGuardHoisted(stHz)
      } else {
        emitListIdxGuard(listIdxWrapSlot(idxKind, idxSlot), lTy)
      }
      fbLocalGet(storeValSlot) // 0x20 — the parked value
      fbArraySet(aTy)          // 0xfb 0x0e <backing array type index>
      return 0
    }
    if target is Member {
      // a field write on a narrowed union identifier (`if v is M { v.field = x }`)
      // downcasts through the box like the read path: push the box ref, unbox to the
      // variant struct, push the value, then `struct.set` — mutating the shared arena object.
      if memIsNarrowed(lhsIx) {
        const nvi = memNarrowVariantIndex(lhsIx)
        if nvi < 0 {
          return emitFail(
            "emitProgram: narrowed field-assignment receiver names no variant",
          )
        }
        const nm = P.nodes[lhsIx]
        if nm is Member {
          const nfi = variantFieldIndex(nvi, nm.memProp)
          if nfi < 0 {
            return emitFail(
              "emitProgram: unknown variant field in narrowed field assignment",
            )
          }
          if emitExpr(body, nm.memObj, fnIx) < 0 { return -1 }
          fbStructGet(uBoxIdx, 1)  // box field 1: value (anyref)
          fbRefCast(uVarHeap[nvi]) // ref.cast to the variant struct
          // An ARRAY-typed variant field threads its element kind, exactly as the plain
          // receiver above does — seeded AFTER the receiver's own emit, which is free to
          // clobber the pending globals, and cleared again before the `struct.set`.
          const nvCode = variantFieldTypeAt(nvi, nfi)
          if seedFieldListBuild(nvCode, variantFieldRefSlot(nvi, nfi)) < 0 {
            return -1
          }
          // A SCALAR f64/i64/f32 variant field widens its RHS at the store boundary,
          // exactly as the construct does (`v.f = 9` into an i64 field emitted a raw
          // `i32.const` — invalid wasm at `struct.set`).
          if emitScalarFieldStoreVal(body, a.binRight, fnIx, nvCode) < 0 {
            return -1
          }
          pendingListKind = 0
          pendingListSlot = 0
          fbStructSet(uVarHeap[nvi], nfi)
          return 0
        }
      }
      // A field WRITE on a variant-typed param (`o: TyObj`) writes the variant struct
      // directly (the param IS the unboxed variant ref — no box unwrap).
      const pwvi = exprVariantIndex(target.memObj, fnIx)
      if pwvi >= 0 {
        const m1 = P.nodes[lhsIx]
        if m1 is Member {
          const pwfi = variantFieldIndex(pwvi, m1.memProp)
          if pwfi < 0 {
            return emitFail(
              "emitProgram: unknown variant field in field assignment",
            )
          }
          if emitExpr(body, m1.memObj, fnIx) < 0 { return -1 }
          // Array-field element-kind seed + scalar-field RHS widening, as the narrowed
          // branch above.
          const pwCode = variantFieldTypeAt(pwvi, pwfi)
          if seedFieldListBuild(pwCode, variantFieldRefSlot(pwvi, pwfi)) < 0 {
            return -1
          }
          if emitScalarFieldStoreVal(body, a.binRight, fnIx, pwCode) < 0 {
            return -1
          }
          pendingListKind = 0
          pendingListSlot = 0
          fbStructSet(uVarHeap[pwvi], pwfi)
          return 0
        }
      }
      // the nullable-variant receiver: a `T | null` binding whose `T` is a union arm holds
      // `(ref null $uVarHeap[vi])`, so this differs from the variant-param write above only
      // by one `ref.as_non_null`, safe since the checker admits the write only inside a null test.
      const nwvi = nulVariantIdxOfExpr(target.memObj, fnIx)
      if nwvi >= 0 && exprNullableVariant(target.memObj, fnIx) {
        const nwfi = variantFieldIndex(nwvi, target.memProp)
        if nwfi < 0 {
          return emitFail(
            "emitProgram: unknown variant field in field assignment",
          )
        }
        if emitExpr(body, target.memObj, fnIx) < 0 { return -1 }
        fbRefAsNonNull() // 0xd4 — the enclosing null test narrowed it
        const nwCode = variantFieldTypeAt(nwvi, nwfi)
        if seedFieldListBuild(nwCode, variantFieldRefSlot(nwvi, nwfi)) < 0 {
          return -1
        }
        if emitScalarFieldStoreVal(body, a.binRight, fnIx, nwCode) < 0 {
          return -1
        }
        pendingListKind = 0
        pendingListSlot = 0
        fbStructSet(uVarHeap[nwvi], nwfi)
        return 0
      }
      // field write `recv.field = v` → `struct.set $0 <fieldidx>`; the single declared
      // struct lives at WasmGC type index 0. Operand order is load-bearing: struct ref
      // first, then the value.
      if !sDeclared {
        return emitFail(
          "emitProgram: field assignment but no struct type declared",
        )
      }
      const si = structIndexOfExpr(target.memObj, fnIx)
      if si < 0 {
        return emitFail(
          "emitProgram: field-assignment receiver is not a struct",
        )
      }
      const fieldIdx = sFieldIndex(si, target.memProp)
      if fieldIdx < 0 {
        return emitFail("emitProgram: unknown struct field in field assignment")
      }
      if emitExpr(body, target.memObj, fnIx) < 0 {
        return -1 // struct ref first
      }
      // An empty `[]` for an array-typed field needs its element kind threaded so the
      // wrapper matches the field's declared type — the same `pendingListKind` an
      // annotated `let xs: T[] = []` or an object-literal array field uses (else the
      // empty literal defaults to the i32-list wrapper and the `struct.set` rejects it).
      const fscode = sFieldTypeAt(si, fieldIdx)
      if seedFieldListBuild(fscode, sFieldRefSlot(si, fieldIdx)) < 0 {
        return -1
      }
      // A MAP-typed field (code 19) seeds the map SHAPE — the write twin of `emitObj`'s
      // construct-side seed, carrying the same defect the ident arms above describe.
      pendingMapSlot = -1
      if fscode == 19 { pendingMapSlot = sFieldMapShape(si, fieldIdx) }
      // D1568 — a code-15 field seeds its target struct row, the write twin of the
      // construct-side seed: without it `w.f = null` over `f: C | null` reached
      // `emitNullLitNode` with every seed unset. Restored below (D1563's rule: every seed has a home).
      const savedWPSI = pendingStructIdx
      if fscode == 15 { pendingStructIdx = sFieldTgtStructIdx(si, fieldIdx) }
      // a box-union field (code 16) coerces a raw scalar/struct/null RHS into the box; the
      // niche fields seed their null rep for a bare `null` (the `emitNullLitNode` table).
      // The write twin of the construct-side seed, through `emitUnionBoxArg` since the
      // field cell is `(ref $uBox)` — one home so the three code-16 sites cannot drift.
      if fscode == 16 {
        if (
          emitUnionBoxArg(
            body,
            sFieldElemNameAt(si, fieldIdx),
            a.binRight,
            fnIx,
          ) <
          0
        ) {
          return -1
        }
      } else if fscode == 3 && exprIsLitAtom(a.binRight, fnIx) {
        // A literal-union atom assigned to a `string` field (code 3) widens to its member string.
        if emitAtomToStr(body, a.binRight, fnIx) < 0 { return -1 }
      } else if fscode == 20 && exprIsLitAtom(a.binRight, fnIx) {
        // the `string | null` field takes the same widen: its slot is the same string ref
        // with null permitted, and a widened member string is non-null. `emitObj` and
        // `emitAssign` are the two halves of every field code, and must agree.
        if emitStrValue(body, a.binRight, fnIx) < 0 { return -1 }
      } else if sFieldIsLitUnion(si, fieldIdx) {
        // A literal-union atom field assign (`b.kind = "a"`): the member RHS lowers as its atom id.
        const wluCtx = expCtxHere()
        wluCtx.litUnion = 1
        if emitExprExpect(body, a.binRight, fnIx, wluCtx) < 0 { return -1 }
      } else if sFieldIsLitUnionArray(si, fieldIdx) {
        // An atom-array field assign (`g.f = ["bb"]`): the RHS builds the i32 list of atom
        // ids (the atom context routes the literal off the string-list build — construct
        // parity with `emitObj`'s code-4 atom arm).
        const wlaCtx = expCtxHere()
        wlaCtx.litUnion = 1
        if emitExprExpect(body, a.binRight, fnIx, wlaCtx) < 0 { return -1 }
      } else if fscode == 17 || fscode == 23 || fscode == 24 {
        // A SCALAR f64/i64/f32 field widens its RHS at the store boundary, the exact
        // treatment `emitObj` gives the construct (`p.g = 9` into an i64 field emitted
        // a raw `i32.const` — invalid wasm at `struct.set`; pre-existing, flat AND
        // nested spellings).
        if emitScalarFieldStoreVal(body, a.binRight, fnIx, fscode) < 0 {
          return -1
        }
      } else if fscode == 15 {
        // The ASSIGN half of the construct arm above (`p.g = s` after `if s is Circle`) —
        // `emitObj` and `emitAssign` are the two halves of every field code and have to be
        // wired together, which is the lesson the code-20 arm three branches up records.
        if (
          emitArmDelivery(body, a.binRight, fnIx, sFieldTgtHeapOf(si, fieldIdx)) <
          0
        ) {
          return -1
        }
      } else {
        const fwCtx = expCtxHere()
        if fscode == 20 { fwCtx.nulString = true }
        if fscode == 21 { fwCtx.nulBool = true }
        // A `K | null` niche field assign: member RHS -> atom id, `null` -> -1.
        if fscode == 30 {
          fwCtx.litUnion = 1
          fwCtx.nulLitUnion = true
        }
        // then the value
        if emitExprExpect(body, a.binRight, fnIx, fwCtx) < 0 { return -1 }
      }
      // D1222 — the STORE half of the construct-side recover in `emitObj`; the two halves of
      // every field code have to be wired together, as the code-20 arm above records.
      if nulNicheRecoverOwed(fieldCodeVKind(fscode), a.binRight, fnIx) {
        fbRefAsNonNull()
      }
      pendingListKind = 0
      pendingMapSlot = -1
      pendingStructIdx = savedWPSI
      fbStructSet(sHeapIdx[si], fieldIdx) // 0xfb 0x05 <struct ht> <field index>
      return 0
    }
    return emitFail("emitProgram: assignment target is not a simple name")
  }
  emitFail("emitProgram: expected an assignment expression")
}

// The expected-type context for one element value of the ref-list slot `rslot` — the
// `.push`/indexed-assign twin of `emitArr`'s per-element seeds. A nested-list element
// resets the context to the inner list's own kind, recursively for a kind-9 element; a
// nullable element seeds the null-element ref. A non-literal value reads none of these seeds.
function refElemValueCtx(rslot: i32): ExpCtx {
  const c = expCtxHere()
  const k = rlElemKindTbl[rslot]
  if k == 4 {
    c.listKind = 0
  } else if k == 6 {
    c.listKind = 3
  } else if k == 7 {
    c.listKind = 4
  } else if k == 8 {
    c.listKind = 6
  } else if k == 10 {
    c.listKind = 7
  } else if k == 11 {
    c.listKind = 10 // u8-inner list -> the packed-byte literal build
  } else if k == 9 {
    c.listKind = 5
    c.listSlot = rlElemInnerSlot(rslot)
  }
  if rlElemNullable[rslot] == 1 {
    if k == 4 { c.nulList = true }
    if k == 6 { c.nulRefHeap = mkListIdx }
    if k == 7 { c.nulRefHeap = fl64TypeIdx }
    if k == 8 { c.nulRefHeap = il64TypeIdx }
    if k == 10 { c.nulRefHeap = fl32TypeIdx }
    if k == 11 { c.nulRefHeap = bl8TypeIdx }
    if k == 9 && c.listSlot >= 0 { c.nulRefHeap = rlWrapIdx[c.listSlot] }
    // A nullable-CLOSURE element (kind 5): a `null` value stores as `ref.null` of the
    // shared closure fat-pointer (the slot heap, `cloStructIdx`).
    if k == 5 { c.nulRefHeap = rlElemHeap[rslot] }
    // A nullable-MAP element (kind 3): `ref.null` of the element's own map struct.
    if k == 3 { c.nulRefHeap = rlElemHeap[rslot] }
  }
  // a map element (kind 3): a `Map()` value builds the element's own map struct, not the
  // ambient one — else `xs.push(Map())` over `{[string]: V}[]` `struct.new`s the mono map
  // into a backing typed to the element's struct, invalid wasm. Inert for a non-`Map()`
  // value; only `emitMapNew` reads and clears the seed.
  if k == 3 { c.mapSlot = rlElemMapShape(rslot) }
  c
}

// True if the ref-list slot `rslot` holds nested-list elements (an inner list wrapper —
// scalar kinds 4/6/7/8/10 or a ref inner list, kind 9): the element-value emit must run
// under `refElemValueCtx` so a literal value builds the inner list, not the default.
function rlElemIsNestedList(rslot: i32) {
  const k = rlElemKindTbl[rslot]
  k == 4 || k == 6 || k == 7 || k == 8 || k == 9 || k == 10 || k == 11
}

// Whether a ref-list slot's element-value emit needs `refElemValueCtx` at all — the one
// predicate the `.push` and indexed-assign boundaries share, so the nested-list, nullable-
// closure and map-element cases cannot be taught to one boundary and forgotten at the
// other. Inert for any other kind, which reads only the ambient seeds.
function rlElemNeedsValueCtx(rslot: i32) {
  const k = rlElemKindTbl[rslot]
  if rlElemIsNestedList(rslot) { return true }
  if k == 3 { return true }
  k == 5 && rlElemNullable[rslot] == 1
}

// Stage a list-op receiver that is not a bare local — a global, a struct field, an index —
// into the op frame's `recvRef` scratch slot: the one home the evaluate-once rule every
// list op needs. A nullable list cell needs the recover `emitExpr` withholds (so `g != null`
// can test the raw cell); this slot is a non-null wrapper ref instead, safe by narrowing.
function stageListRecv(body: i32[], objIx: i32, fnIx: i32, base: i32) {
  if emitExpr(body, objIx, fnIx) < 0 { return -1 }
  const r = P.nodes[unwrapParen(objIx)]
  if r is Ident {
    if globalNulListCellRead(fnIx, r.identName) {
      fbRefAsNonNull() // 0xd4
    }
  }
  fbLocalSet(base + 3) // local.set recvRef
  0
}

// True when an ident read of `name` unboxes a narrowed union arm rather than yielding the
// frame slot raw — the gate `emitIdentNode`'s narrowed value-atom and ref-array arms
// share, asked in the same order: a union binding in this frame, a capture (bound in
// another frame), and the typed-IR net behind both. Excludes the narrowed-map arm: a map is not a list receiver.
function identReadIsUnionUnbox(exprIx: i32, name: string, fnIx: i32) {
  if unionNameOfIdentSid(sidOfNode(exprIx), fnIx) != "" { return true }
  if capturedIsUnionBox(fnIx, name) { return true }
  identChainTyBoxedUnion(name, fnIx, 4)
}

// True when the list-op receiver at `objIx` is an identifier narrowed to a list arm of a
// union box: such a name resolves like any local, but the local holds `(ref $uBox)`, so
// it must be staged through `emitExpr` (which runs the unbox) like a global/field/index
// receiver — else `.push`/`.clear` `struct.get`s the raw box, invalid wasm.
function listOpRecvNarrowedUnion(objIx: i32, name: string, fnIx: i32) {
  if narrowedValueAtomOf(name) == "" && narrowedRefArrayOf(name) == "" {
    return false
  }
  // the slot test is load-bearing: `callPopBits` reserves the scratch frame off
  // `identSlotIsUnionBox` alone, so staging on a wider condition here would stage into a
  // frame never laid out. The two passes ask the one question.
  if !identSlotIsUnionBox(fnIx, name) { return false }
  identReadIsUnionUnbox(objIx, name, fnIx)
}

// The scratch base a receiver that stages will use: `base` is the family default already
// resolved; `refSlot >= 0` defers the ref family's per-element-type frame to here, the one
// point that knows staging is happening. A `.pop`/`.clear` stages only a receiver it cannot
// read in place; a `.push` reads `base`..`base+2` regardless, so the ref frame is reserved for the first group only.
function listOpStageBase(base: i32, refSlot: i32): i32 {
  if refSlot < 0 { return base }
  refPushScratchBaseFor(refSlot)
}

// The one home for list-op receiver resolution: resolve `objIx` to the wasm local holding
// the list-wrapper ref, or -1 (loud, already recorded) for a receiver it cannot resolve. A
// bare identifier is such a local unless it is a narrowed union arm; every other form — a
// field, a global, an index — is evaluated once into the `recvRef` scratch slot, no write-back needed.
function listOpRecvLocal(
  body: i32[],
  objIx: i32,
  fnIx: i32,
  base: i32,
  refSlot: i32,
  op: string,
  allowIndex: boolean,
): i32 {
  const recv = P.nodes[objIx]
  if recv is Ident {
    if listOpRecvNarrowedUnion(objIx, recv.identName, fnIx) {
      const sb = listOpStageBase(base, refSlot)
      if stageListRecv(body, objIx, fnIx, sb) < 0 { return -1 }
      return sb + 3
    }
    const lIdx = localIndexOf(fnIx, recv.identName)
    if lIdx >= 0 { return lIdx }
    // A module-GLOBAL list ident: `emitExpr` runs the existing Ident->global read
    // (`global.get` + `ref.as_non_null` for a non-const ref cell).
    if globalIndexOfSid(sidOfNode(objIx)) < 0 {
      return emitFail("emitProgram: " + op + " receiver is not a list local")
    }
    const gb = listOpStageBase(base, refSlot)
    if stageListRecv(body, objIx, fnIx, gb) < 0 { return -1 }
    return gb + 3
  }
  if recv is Member {
    const mb = listOpStageBase(base, refSlot)
    if stageListRecv(body, objIx, fnIx, mb) < 0 { return -1 }
    return mb + 3
  }
  if allowIndex {
    // An INDEXED receiver (`g[0].push(x)` - push onto an INNER list of a nested array, or
    // onto a list read from a list-valued map). The classifiers upstream already recognize a
    // nested `g[i]` read as its inner list, so `lTy`/`aTy`/`base` are the inner list's.
    if recv is Index {
      const ib = listOpStageBase(base, refSlot)
      if stageListRecv(body, objIx, fnIx, ib) < 0 { return -1 }
      return ib + 3
    }
    return emitFail(
      "emitProgram: " +
        op +
        " receiver must be a local, struct field, or index",
    )
  }
  emitFail("emitProgram: " + op + " receiver must be a local or struct field")
}

// Lower a `recv.push(x)` member-call statement — the growable-list append, inlined rather
// than a helper call. `recv` must be a bare `Ident` naming a list local/param, taking
// exactly one i32 argument. Grows by doubling (floor of four) when `len == cap`, copying
// live elements into a fresh backing; G7-ref runs the identical sequence for a ref list.

// D1197 — the push value slot's rep kind, so `.push` can ask `nulNicheRecoverOwed` like
// any other nullable-ref delivery. Non-null `(ref $rlElemHeap)` unless the element is
// itself a nullable niche (a `null` push is then legal and nothing is owed); null also for
// the value-union box (its null is a tag inside a non-null box) and an unresolved slot.
function pushDestVKind(rslot: i32): VKind | null {
  if rslot < 0 || rslot >= rlElemKindTbl.length { return null }
  if rlElemNullable[rslot] == 1 { return null }
  const k = rlElemKindTbl[rslot]
  if k == 1 {
    if rlElemStructRow(rslot) >= 0 { return "struct" }
    return "variant"
  }
  if k == 3 { return "map" }
  if k == 4 { return "list" }
  if k == 5 { return "closure" }
  if k == 6 { return "strlist" }
  if k == 7 { return "f64list" }
  if k == 8 { return "i64list" }
  if k == 9 { return "reflist" }
  if k == 10 { return "f32list" }
  null
}

// receiver resolution for `.push` — `listOpRecvLocal`, the one home the four list ops
// share. Called from two points because a push whose value stages a receiver must resolve
// its own after that value (D1280); one function so the two cannot pass different arguments.
function pushRecvLocal(body: i32[], objIx: i32, fnIx: i32, base: i32) {
  listOpRecvLocal(body, objIx, fnIx, base, -1, ".push", true)
}

// D1592 — `wantValue` is the value-position flag: the checker types `.push` `i32` (the new
// length), so a bound/returned/argument push owes that value while a bare statement owes
// an empty stack. One lowering serves both, reading the value back from the `len` field
// this same sequence writes, so the two cannot disagree.
function emitPush(body: i32[], callIx: i32, fnIx: i32, wantValue: boolean) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      // the receiver must produce a list — a bare list local/param or a struct-field array
      // read. Both `exprArray`/`exprRefArray` classify a `Member` field read already, so a
      // field receiver only needs its wrapper ref materialized into `recvRef`.
      const isRef = exprRefArray(callee.memObj, fnIx)
      const isStr = exprStringArray(callee.memObj, fnIx)
      const isF64 = exprF64Array(callee.memObj, fnIx)
      const isI64 = exprI64Array(callee.memObj, fnIx)
      const isF32 = exprF32Array(callee.memObj, fnIx)
      const isU8 = exprU8Array(callee.memObj, fnIx)
      // a literal-union array push (`xs.push("a")` over `xs: K[]`) rides the i32-list
      // spine, but the pushed member literal must lower as its atom id — seeded through
      // the declaration fallback (`arrElemLitUnionTy`), since a monomorphized instance's
      // receiver ident is shared with the generic body and the direct probe answers false.
      const isLitArr = arrElemLitUnionTy(callee.memObj, fnIx) >= 0
      // a `(boolean | null)[]` push also rides the i32-list spine, but a `null` value must
      // lower as the sentinel 2 (`pendingNulBool`).
      const isNbArr = nodeArrayElemIsNulBool(callee.memObj)
      // a `(K | null)[]` push rides the same spine: a member literal lowers as its atom
      // id, a `null` as the `-1` sentinel — seed both for the value emit.
      const isNlluArr = nodeArrayElemIsNulLitUnion(callee.memObj)
      // a `(string | null)[]` push rides the string-list spine, but a `null` value must
      // lower as `ref.null $sTypeIdx` — seeded the same way `emitArr` seeds that list's
      // element literals; without it a bare `null` push hit the bare-null reject.
      const isNsArr = nodeArrayElemIsNulStr(callee.memObj)
      if (
        !isRef &&
        !isStr &&
        !isF64 &&
        !isI64 &&
        !isF32 &&
        !isU8 &&
        !exprArray(callee.memObj, fnIx)
      ) {
        return emitFail("emitProgram: .push receiver is not a list")
      }
      // pick the list/backing type indices + scratch base for this push kind. A string
      // list runs the identical grow/append sequence over its own wrapper/backing +
      // string-push quad; `array.new_default` zero-inits spare slots to null.
      let lTy = lTypeIdx
      let aTy = aTypeIdx
      let base = pushScratchBase
      // the element-value seeds — the indexed-store block's exact set: kind 1 the declared
      // element struct, kind 2 the union box, kinds 4/6/7/8/9/10 the inner list's context,
      // so `xs.push({ … })`/`i64[][].push([300])` build what the slot declares.
      let pushStructIdx = -1
      // the push twin of the store's variant hint (D796) — same declining
      // `rlElemStructRow`, same arm-heap answer.
      let pushVariantIdx = -1
      let pushUnionNm = ""
      let pushNestSlot = -1
      // the heap a narrowed arm pushed into a `Circle[]` lands in (D1031) — the slot's own
      // element heap, the same one `rlBackIdx` types the backing with.
      let pushArmHeap = -1
      // the value slot's rep kind, for the D1197 non-null recover below. A `(string |
      // null)[]` keeps its nullable slot and stays `null` here.
      let pushDestKind: VKind | null = null
      if isRef {
        if !rlUsed {
          return emitFail(
            "emitProgram: ref .push but ref list type not collected",
          )
        }
        const rslot = refListSlotOfExpr(callee.memObj, fnIx)
        lTy = rlWrapIdx[rslot]
        aTy = rlBackIdx[rslot]
        base = refPushScratchBaseFor(rslot)
        if rlElemKindTbl[rslot] == 1 {
          pushStructIdx = rlElemStructRow(rslot)
          if pushStructIdx < 0 {
            pushVariantIdx = variantIndexOf(nonNulBaseOf(rlElemName[rslot]))
          }
        }
        if rlElemKindTbl[rslot] == 2 { pushUnionNm = rlElemName[rslot] }
        pushArmHeap = rlElemArmHeapOf(rslot)
        pushDestKind = pushDestVKind(rslot)
        // The same ONE predicate the indexed-assign boundary uses (see there).
        if rlElemNeedsValueCtx(rslot) { pushNestSlot = rslot }
      } else if isStr {
        if !slUsed {
          return emitFail(
            "emitProgram: string .push but string list type not collected",
          )
        }
        lTy = mkListIdx
        aTy = mkArrIdx
        base = strPushScratchBase
        if !isNsArr { pushDestKind = "str" }
      } else if isF64 {
        // the three non-i32 scalar kinds run the identical grow/append sequence over
        // their own wrapper/backing, staged in their own typed push quad — only the
        // three type indices below differ.
        if !fa64Used {
          return emitFail(
            "emitProgram: f64 .push but f64 list type not collected",
          )
        }
        lTy = fl64TypeIdx
        aTy = fa64TypeIdx
        base = f64PushScratchBase
      } else if isI64 {
        if !ia64Used {
          return emitFail(
            "emitProgram: i64 .push but i64 list type not collected",
          )
        }
        lTy = il64TypeIdx
        aTy = ia64TypeIdx
        base = i64PushScratchBase
      } else if isF32 {
        if !fa32Used {
          return emitFail(
            "emitProgram: f32 .push but f32 list type not collected",
          )
        }
        lTy = fl32TypeIdx
        aTy = fa32TypeIdx
        base = f32PushScratchBase
      } else if isU8 {
        // the packed byte list runs the identical grow/append sequence over its own
        // wrapper/backing and push quad. The pushed value takes the plain i32 path, and
        // `array.set` on the i8-storage backing truncates it to the low 8 bits.
        if !ba8Used {
          return emitFail(
            "emitProgram: u8 .push but u8 list type not collected",
          )
        }
        lTy = bl8TypeIdx
        aTy = ba8TypeIdx
        base = u8PushScratchBase
      } else if !lUsed {
        return emitFail("emitProgram: .push but list type not collected")
      }
      if c.callArgs.length != 1 {
        return emitFail("emitProgram: .push takes exactly one argument")
      }
      // the receiver is staged after the value when the value itself stages one (D1280):
      // `listOpRecvLocal` parks a non-local receiver in the frame's one `recvRef` slot, so
      // a nested list op inside the pushed value would overwrite it and the append would
      // land on the inner list. Emitting the value first keeps the slot free for this push's own receiver.
      const lateStage = (exprPopBits(c.callArgs[0], fnIx) & 512) != 0
      let lIdx = -1
      if !lateStage {
        lIdx = pushRecvLocal(body, callee.memObj, fnIx, base)
        if lIdx < 0 { return -1 }
      }
      if true {
        const valIdx = base
        const capIdx = base + 1
        const backIdx = base + 2
        const pushArmOwed = narrowedArmNeedsUnbox(c.callArgs[0], fnIx)
        // V = x  (an f64-list push coerces/encodes the value as f64)
        pendingStructIdx = pushStructIdx
        const savedPVI = pendingVariantIdx
        if pushVariantIdx >= 0 { pendingVariantIdx = pushVariantIdx }
        if isF64 {
          if emitExprAsF64(body, c.callArgs[0], fnIx) < 0 { return -1 }
        } else if isI64 {
          if emitExprAsI64(body, c.callArgs[0], fnIx) < 0 { return -1 }
        } else if isF32 {
          // an f32-list push coerces/encodes the value as f32 (a float literal re-encodes).
          const savedPF32 = pendingF32
          pendingF32 = true
          if emitExprAsF32(body, c.callArgs[0], fnIx) < 0 { return -1 }
          pendingF32 = savedPF32
        } else if pushUnionNm != "" {
          if emitUnionBoxArg(body, pushUnionNm, c.callArgs[0], fnIx) < 0 {
            return -1
          }
        } else if pushNestSlot >= 0 {
          // A nested-list element push: the value builds as the INNER list (an inert
          // context for a non-literal value — an ident/call emits unchanged).
          const pnCtx = refElemValueCtx(pushNestSlot)
          if emitExprExpect(body, c.callArgs[0], fnIx, pnCtx) < 0 { return -1 }
        } else if isLitArr {
          if litPushNeedsDestNarrow(c.callArgs[0], fnIx) {
            const dTy = arrElemLitUnionTy(callee.memObj, fnIx)
            if emitDestStrToAtom(body, c.callArgs[0], fnIx, dTy) < 0 {
              return -1
            }
          } else {
            const pluCtx = expCtxHere()
            pluCtx.litUnion = 1
            if emitExprExpect(body, c.callArgs[0], fnIx, pluCtx) < 0 {
              return -1
            }
          }
        } else if isNbArr {
          const pnbCtx = expCtxHere()
          pnbCtx.nulBool = true
          if emitExprExpect(body, c.callArgs[0], fnIx, pnbCtx) < 0 { return -1 }
        } else if isNlluArr {
          const pnluCtx = expCtxHere()
          pnluCtx.litUnion = 1
          pnluCtx.nulLitUnion = true
          if emitExprExpect(body, c.callArgs[0], fnIx, pnluCtx) < 0 {
            return -1
          }
        } else if isNsArr && exprIsLitAtom(c.callArgs[0], fnIx) {
          // A literal-union ATOM pushed into a `(string | null)[]`. The niche's backing IS a
          // plain string list, so the atom widens exactly as it does for a `string[]` — and a
          // widened member string is non-null, so it needs no null seed. A `null` value is not
          // a lit atom and still takes the `nulString` arm below.
          if emitStrValue(body, c.callArgs[0], fnIx) < 0 { return -1 }
        } else if isNsArr {
          const pnsCtx = expCtxHere()
          pnsCtx.nulString = true
          if emitExprExpect(body, c.callArgs[0], fnIx, pnsCtx) < 0 { return -1 }
        } else if isStr && exprIsLitAtom(c.callArgs[0], fnIx) {
          // a literal-union atom pushed into a `string[]` widens to its member string: the
          // backing slot is `(ref null $aTypeIdx)` and the atom's rep is an i32 id — the
          // same boundary a `string` field store applies (`scode == 3` + `exprIsLitAtom`).
          if emitStrValue(body, c.callArgs[0], fnIx) < 0 { return -1 }
        } else {
          if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
        }
        pendingStructIdx = -1
        pendingVariantIdx = savedPVI
        // the narrowed-arm unbox at the `.push` boundary (D1031) — `xs.push(s)` into a
        // `Circle[]` under `if s is Circle`. The element-literal twin is in `emitArr`; both
        // read the same slot heap, so the two spellings of one store cannot disagree.
        if pushArmOwed { emitNarrowedArmUnboxTo(pushArmHeap) }
        // D1197 — the non-null recover `.push` OWED. Eight sibling deliveries of the same
        // narrowed value ask `nulNicheRecoverOwed`; this one asked nothing, so `out.push(e)`
        // under `if e != null` handed a `(ref null $H)` to the non-null value slot —
        // check-clean invalid wasm at the ONE red cell of a 36-cell position matrix.
        if nulNicheRecoverOwed(pushDestKind, c.callArgs[0], fnIx) {
          fbRefAsNonNull()
        }
        fbLocalSet(valIdx) // local.set
        if lateStage {
          lIdx = pushRecvLocal(body, callee.memObj, fnIx, base)
          if lIdx < 0 { return -1 }
        }
        // if len(L) == cap(L)
        pushListLen(body, lIdx, lTy)
        pushListCap(body, lIdx, lTy)
        fbI32Bin(70) // 0x46 i32.eq
        fbIf(64)     // 0x04 if, 0x40 void blocktype
        // NC = (cap(L) == 0) ? 4 : cap(L) * 2   — via if/else yielding i32
        pushListCap(body, lIdx, lTy)
        fbI32Eqz()         // 0x45 i32.eqz  (cap == 0)
        fbIf(127)          // 0x04 if, 0x7f i32 blocktype (yields an i32)
        fbI32Const(4)      // i32.const 4
        fbElse()           // 0x05 else
        pushListCap(body, lIdx, lTy)
        fbI32Const(2)      // i32.const 2
        fbI32Bin(108)      // 0x6c i32.mul
        fbEnd()            // 0x0b end (if/else)
        fbLocalSet(capIdx) // local.set NC
        // NB = array.new_default $aTy NC
        fbLocalGet(capIdx)     // local.get NC
        fbArrayNewDefault(aTy) // 0xfb 0x07 <aTy>
        fbLocalSet(backIdx)    // local.set NB
        // array.copy NB 0 backing(L) 0 len(L)
        fbLocalGet(backIdx)              // local.get NB (dest)
        fbI32Const(0)                    // i32.const 0 (dest offset)
        pushListBacking(body, lIdx, lTy) // src
        fbI32Const(0)                    // i32.const 0 (src offset)
        pushListLen(body, lIdx, lTy)     // count
        fbArrayCopy(aTy, aTy)            // 0xfb 0x11 <dest type> <src type>
        // L.backing = NB
        fbLocalGet(lIdx)    // local.get L
        fbLocalGet(backIdx) // local.get NB
        fbStructSet(lTy, 0) // 0xfb 0x05 <lTy> field 0: backing
        // L.cap = NC
        fbLocalGet(lIdx)    // local.get L
        fbLocalGet(capIdx)  // local.get NC
        fbStructSet(lTy, 2) // 0xfb 0x05 <lTy> field 2: cap
        fbEnd()             // 0x0b end (if)
        // backing(L)[len(L)] = V
        pushListBacking(body, lIdx, lTy)
        pushListLen(body, lIdx, lTy)
        fbLocalGet(valIdx) // local.get V
        fbArraySet(aTy)    // 0xfb 0x0e <aTy>
        // L.len = len(L) + 1
        fbLocalGet(lIdx)    // local.get L
        pushListLen(body, lIdx, lTy)
        fbI32Const(1)       // i32.const 1
        fbI32Bin(106)       // 0x6a i32.add
        fbStructSet(lTy, 1) // 0xfb 0x05 <lTy> field 1: len
        // D1592 — the new length, read back from the field the line above wrote. Emitted
        // only in value position; a bare `.push` statement leaves the stack empty, and
        // `memberCallYieldsValue` is the one predicate both sides consult.
        if wantValue { pushListLen(body, lIdx, lTy) }
        return 0
      }
    }
  }
  emitFail("emitProgram: expected a .push call")
}

// `.pop()` decrements `len` first, so the new `len` is the popped index, before reading
// `backing[len]` — the receiver must be a bare local, no scratch needed.
// D977 — the push scratch base and the used-flag for a scalar list of element kind `k`.
function scalarPushScratchBaseOf(k: VKind): i32 {
  if k == "f64" { return f64PushScratchBase }
  if k == "i64" { return i64PushScratchBase }
  if k == "f32" { return f32PushScratchBase }
  if k == "u8list" { return u8PushScratchBase }
  pushScratchBase
}

function scalarListUsedOf(k: VKind): boolean {
  if k == "f64" { return fa64Used }
  if k == "i64" { return ia64Used }
  if k == "f32" { return fa32Used }
  if k == "u8list" { return ba8Used }
  lUsed
}

// the `.pop()` receiver test, lifted out of `emitPop` so the two dispatch sites can ask
// it before routing (D1087): the member dispatch read `callee.memProp == "pop"` with no
// receiver guard, unlike its `map`/`filter`/`keys`/`values`/`get` neighbours. The four
// families are `emitPop`'s own; asking them from one function keeps routing and the floor in step.
function popRecvIsList(recvIx: i32, fnIx: i32) {
  if exprRefArray(recvIx, fnIx) { return true }
  if exprStringArray(recvIx, fnIx) { return true }
  const pk = scalarListElemKind(recvIx, fnIx)
  if pk != null {
    if pk != "i32" { return true }
  }
  exprArray(recvIx, fnIx)
}

// A checked list read (`xs.pop()`/`xs.get(i)`) at a numeric-scalar element rep, delivered
// as the `T | null` the checker gives it: the `{tag, anyref}` value-union box, absent →
// the null tag. `vk` is the non-null member's kind. Mirrors the boolean arm one rep out —
// i32/i64/f64/f32 have no spare bit pattern for absence, so both branches build the box (D1174).
function emitPopNulBox(
  body: i32[],
  lIdx: i32,
  lTy: i32,
  aTy: i32,
  vk: i32,
  idxIx: i32,
  fnIx: i32,
) {
  const vb = vbHeapIdxOfKind(vk)
  if vb < 0 {
    return emitFail(
      "emitProgram: this list read yields a nullable scalar but its value box was not collected",
    )
  }
  if pushTakeCond(body, lIdx, lTy, idxIx, fnIx) < 0 { return -1 }
  wU8(4)                          // 0x04 if
  fbValtype("union", -1)          // result blocktype: the union box `(ref $uBox)`
  ctrlEnter()
  fbI32Const(scalarTagOfKind(vk)) // the present arm's atom tag
  if pushTakeElem(body, lIdx, lTy, aTy, idxIx, fnIx) < 0 { return -1 }
  fbStructNew(vb)                 // the per-rep value box
  fbStructNew(uBoxIdx)            // { tag, value }
  fbElse()                        // 0x05 else — absent → the null-tagged box
  fbI32Const(nullBoxTag())
  fbRefNullNone()                 // the payload slot is unread under the null tag
  fbStructNew(uBoxIdx)
  fbEnd()                         // 0x0b end
  ctrlLeave()
  0
}

// the checked-read condition, one home for `.pop()` and `.get(i)`: `idxIx < 0` is `.pop`
// and asks `len != 0`; `idxIx >= 0` is `.get` and asks `i u< len`, covering the negative
// and past-len cases together. Both faces deliver the same `T | null` at the same four reps (D1281).
function pushTakeCond(
  body: i32[],
  lIdx: i32,
  lTy: i32,
  idxIx: i32,
  fnIx: i32,
): i32 {
  if idxIx < 0 { return pushListLen(body, lIdx, lTy) }
  if emitExpr(body, idxIx, fnIx) < 0 { return -1 }
  pushListLen(body, lIdx, lTy)
  fbI32Bin(73) // 0x49 i32.lt_u
  0
}

// the element read under that condition. `.pop` DECREMENTS the length first, so the new
// `len` IS the removed element's index; `.get` reads at `idxIx` and never mutates. The
// index expression is emitted a SECOND time here (the condition emitted it once), which
// is what makes the caller's literal-or-name purity gate load-bearing.
function pushTakeElem(
  body: i32[],
  lIdx: i32,
  lTy: i32,
  aTy: i32,
  idxIx: i32,
  fnIx: i32,
): i32 {
  if idxIx < 0 {
    fbLocalGet(lIdx)    // L.len = len - 1
    pushListLen(body, lIdx, lTy)
    fbI32Const(1)
    fbI32Bin(107)       // 0x6b i32.sub
    fbStructSet(lTy, 1) // field 1: len
    pushListBacking(body, lIdx, lTy)
    pushListLen(body, lIdx, lTy)
    fbArrayGet(aTy)     // backing[len] — the popped element
    return 0
  }
  pushListBacking(body, lIdx, lTy)
  if emitExpr(body, idxIx, fnIx) < 0 { return -1 }
  fbArrayGet(aTy) // backing[i] — the read element
  0
}

// The `.get(i)` index purity gate: the index is emitted twice (bounds check + read), so
// only a re-readable expression is admissible — a literal, a name, or a NEGATIVE literal
// (`xs.get(-1)`), which the unsigned compare maps past `len` and so takes the absent arm.
// `emitListGetOr`'s own gate is the same one; this is its unfused twin.
function takeIdxRefusal(idxIx: i32): string {
  const idxN = P.nodes[unwrapParen(idxIx)]
  if idxN is NumLit { return "" }
  if idxN is Ident { return "" }
  if idxN is Unary {
    if idxN.unOp == "-" {
      const inner = P.nodes[unwrapParen(idxN.unArg)]
      if inner is NumLit { return "" }
    }
  }
  "emitProgram: .get index must be a literal or a name"
}

// `xs.pop()` and `xs.get(i)` — the two checked list reads, typed identically (`T | null`),
// differing only in the condition, element index and whether the length decrements
// (`pushTakeCond`/`pushTakeElem`). `getIdx` is the `.get` index node, or -1 for `.pop`;
// serving both from one body keeps `.get` reaching every rep `.pop` reaches (D1281).
function emitPop(
  body: i32[],
  callIx: i32,
  fnIx: i32,
  nulBox: boolean,
  getIdx: i32,
) {
  const opNm = if getIdx < 0 { ".pop" } else { ".get" }
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if getIdx < 0 {
        if c.callArgs.length != 0 {
          return emitFail("emitProgram: .pop takes no arguments")
        }
      } else {
        const idxBad = takeIdxRefusal(getIdx)
        if idxBad != "" { return emitFail(idxBad) }
      }
      const isRef = exprRefArray(callee.memObj, fnIx)
      const isStr = exprStringArray(callee.memObj, fnIx)
      // D977 — the scalar-list family had no arm here: `exprArray` claims only an
      // i32-element list, so `i64[]`/`f64[]`/`f32[]`/`u8[]` fell to a refusal that
      // `emitFail`'s non-halting let reach check-clean invalid wasm instead. The wrapper
      // and backing come from `scalarListWrap`/`scalarListBack`, each kind with its own push scratch base.
      let popEk = scalarListElemKind(callee.memObj, fnIx)
      if popEk == "i32" { popEk = null }
      if !popRecvIsList(callee.memObj, fnIx) {
        return emitFail("emitProgram: " + opNm + " receiver is not a list")
      }
      // The popped element is a REF (struct / union box / map struct / string) for a
      // ref or string list — surface it non-null; an i32 list yields a raw i32. `base` is
      // the scratch frame whose `+3` `recvRef` slot holds a struct-FIELD receiver's wrapper
      // ref (same frame `.push` uses) — used only for a Member receiver.
      let lTy = lTypeIdx
      let aTy = aTypeIdx
      let base = pushScratchBase
      // The ref-list table slot whose scratch frame a STAGING receiver would use, or -1
      // for every other family. Handed to `listOpRecvLocal` so the frame is resolved only
      // where staging happens — see `listOpStageBase`.
      let popRefSlot = -1
      let elemIsRef = false
      if isRef {
        if !rlUsed {
          return emitFail(
            "emitProgram: ref " + opNm + " but ref list type not collected",
          )
        }
        const rslot = refListSlotOfExpr(callee.memObj, fnIx)
        lTy = rlWrapIdx[rslot]
        aTy = rlBackIdx[rslot]
        popRefSlot = rslot
        elemIsRef = true
      } else if popEk != null {
        // The scalar sibling of the i32 default below: same shape, a per-kind wrapper,
        // backing and scratch base.
        if !scalarListUsedOf(popEk) {
          return emitFail(
            "emitProgram: " + opNm + " but list type not collected",
          )
        }
        lTy = scalarListWrap(popEk)
        aTy = scalarListBack(popEk)
        base = scalarPushScratchBaseOf(popEk)
      } else if isStr {
        if !slUsed {
          return emitFail(
            "emitProgram: string " +
              opNm +
              " but string list type not collected",
          )
        }
        lTy = mkListIdx
        aTy = mkArrIdx
        base = strPushScratchBase
        elemIsRef = true
      } else if !lUsed {
        return emitFail("emitProgram: " + opNm + " but list type not collected")
      }
      // Receiver resolution — `listOpRecvLocal`, shared with `.push`/`.clear`/`.pop() ?? d`.
      const lIdx = listOpRecvLocal(
        body,
        callee.memObj,
        fnIx,
        base,
        popRefSlot,
        opNm,
        false,
      )
      if lIdx < 0 { return -1 }
      if true {
        // A BOOLEAN-element list pops CHECKED: `boolean | null` rides the i32
        // niche (true=1 / false=0 / null=2), so an empty pop yields the sentinel
        // 2 instead of trapping — mirroring the host's nullable `.pop()` (B6).
        if !elemIsRef {
          if listElemIsBool(callee.memObj, fnIx) {
            if pushTakeCond(body, lIdx, lTy, getIdx, fnIx) < 0 { return -1 }
            fbIf(127) // 0x04 if, 0x7f i32 result blocktype
            ctrlEnter()
            if pushTakeElem(body, lIdx, lTy, aTy, getIdx, fnIx) < 0 {
              return -1
            }
            fbElse() // 0x05 else — absent → the null sentinel
            fbI32Const(2)
            fbEnd()  // 0x0b end
            ctrlLeave()
            return 0
          }
          // the reps with no niche of their own, at a value position (`nulBox`): i32/i64/
          // f64/f32 have no spare bit pattern for absence, so their `T | null` is the
          // shared value box, built here. The statement caller passes `false` and keeps
          // the raw form, since boxing there would allocate for a value no one reads.
          if nulBox {
            const pnk = tyNulNumScalarValKind(nodeTyIxOf(callIx))
            if pnk >= 0 {
              return emitPopNulBox(body, lIdx, lTy, aTy, pnk, getIdx, fnIx)
            }
          }
          // a `K[]` atom list reads checked too, on the `-1` sentinel below every interned
          // atom id — the boolean arm's shape at the one other niche rep, applying at a
          // statement `.pop()` too since the read itself traps, not the boxing (D1281).
          if tyNulLitUnionInner(nodeTyIxOf(callIx)) {
            if pushTakeCond(body, lIdx, lTy, getIdx, fnIx) < 0 { return -1 }
            fbIf(127) // 0x04 if, 0x7f i32 result blocktype
            ctrlEnter()
            if pushTakeElem(body, lIdx, lTy, aTy, getIdx, fnIx) < 0 {
              return -1
            }
            fbElse() // 0x05 else — absent → the atom-niche null sentinel
            fbI32Const(0 - 1)
            fbEnd()  // 0x0b end
            ctrlLeave()
            return 0
          }
        }
        // an empty ref/string pop answers `null`, it does not trap (D1212): reading
        // `backing[len - 1]` unguarded indexes -1 on an empty list, so `array.get` traps
        // ahead of the `ref.as_non_null` below, while the checker types the call `T |
        // null`. The result is the backing's own `(ref null $elem)`; non-null recovery moves to the read side.
        if elemIsRef {
          let popElemHeap = sTypeIdx
          if popRefSlot >= 0 {
            if popRefSlot >= rlElemHeap.length {
              return emitFail(
                "emitProgram: ref " + opNm + " element heap not interned",
              )
            }
            popElemHeap = rlElemHeap[popRefSlot]
          }
          if pushTakeCond(body, lIdx, lTy, getIdx, fnIx) < 0 { return -1 }
          fbIfRefNul(popElemHeap, true)
          ctrlEnter()
          if pushTakeElem(body, lIdx, lTy, aTy, getIdx, fnIx) < 0 { return -1 }
          fbElse() // 0x05 else — absent → the typed null
          fbRefNull(popElemHeap)
          fbEnd()  // 0x0b end
          ctrlLeave()
          return 0
        }
        // the unchecked tail: a `.pop` statement (value dropped) and the reps with no
        // `T | null` cell of their own — the `K[]` atom list, whose nullable rides the `-1` sentinel.
        if pushTakeElem(body, lIdx, lTy, aTy, getIdx, fnIx) < 0 { return -1 }
        if elemIsRef {
          wU8(212) // 0xd4 ref.as_non_null
        }
        return 0
      }
    }
  }
  emitFail("emitProgram: expected a .pop or .get call")
}

// Lower a `.clear()` statement onto `body`: reset the list's logical length to 0,
// retaining the backing. Generic over the list kind, with `emitPop`'s receiver
// resolution (bare local, module global, or struct field via the `recvRef` scratch).
function emitClear(body: i32[], callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if c.callArgs.length != 0 {
        return emitFail("emitProgram: .clear takes no arguments")
      }
      const isRef = exprRefArray(callee.memObj, fnIx)
      const isStr = exprStringArray(callee.memObj, fnIx)
      // the scalar-list family, the arm `emitPop` grew at D977 and this one did not:
      // `exprArray` claims only an i32-element list, so `i64[]`/`f64[]`/`f32[]`/`u8[]`
      // either failed the receiver test or reset the length through the wrong wrapper
      // type wherever an i32 list happened to be collected too — invalid wasm.
      let clearEk = scalarListElemKind(callee.memObj, fnIx)
      if clearEk == "i32" { clearEk = null }
      if (
        !isRef &&
        !isStr &&
        clearEk == null &&
        !exprArray(callee.memObj, fnIx)
      ) {
        return emitFail("emitProgram: .clear receiver is not a list")
      }
      let lTy = lTypeIdx
      let base = pushScratchBase
      // See `emitPop`'s `popRefSlot`.
      let clearRefSlot = -1
      if isRef {
        if !rlUsed {
          return emitFail(
            "emitProgram: ref .clear but ref list type not collected",
          )
        }
        const rslot = refListSlotOfExpr(callee.memObj, fnIx)
        lTy = rlWrapIdx[rslot]
        clearRefSlot = rslot
      } else if clearEk != null {
        // The scalar sibling of the i32 default below, and `emitPop`'s arm minus the
        // backing (a `.clear` writes only the length field, so no `aTy`).
        if !scalarListUsedOf(clearEk) {
          return emitFail("emitProgram: .clear but list type not collected")
        }
        lTy = scalarListWrap(clearEk)
        base = scalarPushScratchBaseOf(clearEk)
      } else if isStr {
        if !slUsed {
          return emitFail(
            "emitProgram: string .clear but string list type not collected",
          )
        }
        lTy = mkListIdx
        base = strPushScratchBase
      } else if !lUsed {
        return emitFail("emitProgram: .clear but list type not collected")
      }
      const lIdx = listOpRecvLocal(
        body,
        callee.memObj,
        fnIx,
        base,
        clearRefSlot,
        ".clear",
        false,
      )
      if lIdx < 0 { return -1 }
      // L.len = 0
      fbLocalGet(lIdx)
      fbI32Const(0)
      fbStructSet(lTy, 1) // 0xfb 0x05 <lTy> field 1: len
      return 0
    }
  }
  emitFail("emitProgram: expected a .clear call")
}

// Lower a fused `xs.get(i) ?? d` over a scalar-element list (i32/boolean/f64) onto
// `body`: one unsigned bounds compare selects the element read or the default, so the
// `T | null` intermediate never materializes. Receiver a bare name, index a literal/name.
function emitListGetOr(body: i32[], getIx: i32, defIx: i32, fnIx: i32) {
  const c = P.nodes[getIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if c.callArgs.length != 1 {
        return emitFail("emitProgram: .get takes exactly one argument")
      }
      // The scalar element kind (i32 / f64 / i64) selects the list types + read rep — one
      // descriptor lookup instead of an `isF64 ? … : …` fork (so i64 is a descriptor arm).
      const ek = scalarListElemKind(callee.memObj, fnIx)
      if ek == null {
        return emitFail("emitProgram: .get receiver is not a scalar list")
      }
      if !scalarListUsed(ek) {
        return emitFail("emitProgram: .get but list type not collected")
      }
      const lTy = scalarListWrap(ek)
      const aTy = scalarListBack(ek)
      const recvN = P.nodes[unwrapParen(callee.memObj)]
      let okRecv = false
      if recvN is Ident { okRecv = true }
      if !okRecv {
        return emitFail(
          "emitProgram: .get receiver must be a named list binding",
        )
      }
      const idxN = P.nodes[unwrapParen(c.callArgs[0])]
      let okIdx = false
      if idxN is NumLit { okIdx = true }
      if idxN is Ident { okIdx = true }
      if idxN is Unary {
        // A NEGATIVE literal index (`xs.get(-1)`) is pure too — the unsigned
        // bounds compare maps it past `len`, so it takes the default branch.
        if idxN.unOp == "-" {
          const idxArgN = P.nodes[unwrapParen(idxN.unArg)]
          if idxArgN is NumLit { okIdx = true }
        }
      }
      if !okIdx {
        return emitFail("emitProgram: .get index must be a literal or a name")
      }
      // cond: idx u< len  (one unsigned compare covers negative + past-len)
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      fbStructGet(lTy, 1)           // field 1: len
      fbI32Bin(73)                  // 0x49 i32.lt_u
      fbIf(scalarListBlocktype(ek)) // 0x04 if, the element's result blocktype
      ctrlEnter()
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      fbStructGet(lTy, 0)           // field 0: backing
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      fbArrayGet(aTy)               // 0xfb 0x0b array.get — the element
      fbElse()                      // 0x05 else
      if emitScalarValue(body, defIx, fnIx, ek) < 0 { return -1 }
      fbEnd()                       // 0x0b end
      ctrlLeave()
      return 0
    }
  }
  emitFail("emitProgram: expected a list .get call")
}

// Lower a FUSED `xs.pop() ?? d` over a SCALAR-element (i32 / boolean) list onto
// `body`: `len != 0` selects the decrement-and-read (the popped element) or the
// default. The receiver resolves like `emitPop` (bare local, module global, or
// struct field — the latter two staged into the push frame's `recvRef` scratch).
function emitPopOr(body: i32[], popIx: i32, defIx: i32, fnIx: i32) {
  const c = P.nodes[popIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      if c.callArgs.length != 0 {
        return emitFail("emitProgram: .pop takes no arguments")
      }
      if !lUsed {
        return emitFail("emitProgram: .pop but list type not collected")
      }
      const lTy = lTypeIdx
      const aTy = aTypeIdx
      const base = pushScratchBase
      const lIdx = listOpRecvLocal(
        body,
        callee.memObj,
        fnIx,
        base,
        -1,
        ".pop",
        false,
      )
      // the fused `pop ?? d` is i32-family only; no ref frame to defer

      if lIdx < 0 { return -1 }
      // cond: len != 0 (len is never negative)
      pushListLen(body, lIdx, lTy)
      fbIf(127) // 0x04 if, 0x7f i32 result blocktype
      ctrlEnter()
      // L.len = len - 1; backing[L.len]
      fbLocalGet(lIdx)
      pushListLen(body, lIdx, lTy)
      fbI32Const(1)
      fbI32Bin(107)       // 0x6b i32.sub
      fbStructSet(lTy, 1) // field 1: len
      pushListBacking(body, lIdx, lTy)
      pushListLen(body, lIdx, lTy)
      fbArrayGet(aTy)     // the popped element
      fbElse()            // 0x05 else — empty list → the default
      if emitExpr(body, defIx, fnIx) < 0 { return -1 }
      fbEnd()             // 0x0b end
      ctrlLeave()
      return 0
    }
  }
  emitFail("emitProgram: expected a list .pop call")
}

function emitMapFilter(body: i32[], callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      const isMap = callee.memProp == "map"
      if c.callArgs.length != 1 {
        return emitFail(
          "emitProgram: .map/.filter takes exactly one callback argument",
        )
      }
      const recvK = mfRecvKindOf(callee.memObj, fnIx)
      if recvK == null {
        return emitFail(
          "emitProgram: .map/.filter receiver is not a supported list",
        )
      }
      const resK = mfResultKindOf(callIx, fnIx)
      if resK == null {
        return emitFail("emitProgram: unsupported .map/.filter element type")
      }
      // The ref-list slot for a kind-2 result (`.filter` over a struct array) — picks the
      // result backing/wrapper + the matching dst scratch local. -1 for a non-ref result.
      const dstSlot = mfResultSlotOf(callIx, fnIx)
      const cbFe = mfCallbackFe(c.callArgs[0], fnIx)
      let sig = -1
      if cbFe >= 0 {
        sig = fnSigIdxOfFn(cbFe)
      } else {
        // A closure-value callback (a function-typed param/binding — `xs.map(f)` where
        // `f: (i32) => i32`): no lifted fe to inline, so resolve the interned sig from the closure's
        // own `$fnsig` key. The loop `call_ref`s the closure value (emitted into `cL` below via the
        // Ident path) exactly as for a named-function callback — enabling callback-passing HOFs.
        const ck = mfCallbackCloKey(c.callArgs[0], fnIx)
        if ck != "" { sig = cloSigTypeIdxAt(cloSigPosOfKey(ck)) }
      }
      if sig < 0 {
        return emitFail(
          "emitProgram: .map/.filter callback signature is not interned",
        )
      }
      // The SOURCE wrapper/backing heap types (+ whether the element is a ref that
      // needs `ref.as_non_null` after `array.get` — a nullable-NICHE element does NOT:
      // see `listElemStaysNullable`, which the indexed read asks for the same reason).
      const srcElemNul = listElemStaysNullable(callee.memObj, fnIx)
      let srcWrap = lTypeIdx
      let srcBack = aTypeIdx
      let srcElemRef = false
      let srcSlot = -1
      if recvK == "f64" {
        if !fa64Used {
          return emitFail(
            "emitProgram: .map/.filter over f64[] but f64 list type not collected",
          )
        }
        srcWrap = fl64TypeIdx
        srcBack = fa64TypeIdx
      } else if recvK == "i64" {
        if !ia64Used {
          return emitFail(
            "emitProgram: .map/.filter over i64[] but i64 list type not collected",
          )
        }
        srcWrap = il64TypeIdx
        srcBack = ia64TypeIdx
      } else if recvK == "f32" {
        if !fa32Used {
          return emitFail(
            "emitProgram: .map/.filter over f32[] but f32 list type not collected",
          )
        }
        srcWrap = fl32TypeIdx
        srcBack = fa32TypeIdx
      } else if recvK == "ref" {
        if !rlUsed {
          return emitFail(
            "emitProgram: .map/.filter over a ref list but ref list type not collected",
          )
        }
        srcSlot = refListSlotOfExpr(callee.memObj, fnIx)
        srcWrap = rlWrapIdx[srcSlot]
        srcBack = rlBackIdx[srcSlot]
        srcElemRef = !srcElemNul
      } else if recvK == "str" {
        // A STRING list: wrapper `$mkListIdx`, backing `$mkArrIdx` (the array of string
        // refs). The element is itself a ref (an `array i32` of code points), so it needs
        // `ref.as_non_null` after `array.get`, exactly like a ref-list element — unless the
        // element is the `(string | null)[]` niche, which keeps the nullable read.
        if !slUsed {
          return emitFail(
            "emitProgram: .map/.filter over string[] but string list type not collected",
          )
        }
        srcWrap = mkListIdx
        srcBack = mkArrIdx
        srcElemRef = !srcElemNul
      } else if recvK == "u8" {
        // the packed byte source, from `mfRecvKindOf`'s `"u8"` rung (D1141). No
        // `u8[].map`/`.filter` reaches here yet — a `u8` callback parameter is refused one
        // stage earlier — so this arm buys no cell today, but avoids silently minting the
        // 4-byte backing the moment the parameter gap closes.
        if !ba8Used {
          return emitFail(
            "emitProgram: .map/.filter over u8[] but the packed byte list type not collected",
          )
        }
        srcWrap = bl8TypeIdx
        srcBack = ba8TypeIdx
      } else if !lUsed || !aUsed {
        return emitFail("emitProgram: .map/.filter but list type not collected")
      }
      // The RESULT wrapper/backing heap types.
      let dstWrap = lTypeIdx
      let dstBack = aTypeIdx
      if resK == "f64" {
        if !fa64Used {
          return emitFail(
            "emitProgram: .map result is f64[] but f64 list type not collected",
          )
        }
        dstWrap = fl64TypeIdx
        dstBack = fa64TypeIdx
      } else if resK == "i64" {
        if !ia64Used {
          return emitFail(
            "emitProgram: .map result is i64[] but i64 list type not collected",
          )
        }
        dstWrap = il64TypeIdx
        dstBack = ia64TypeIdx
      } else if resK == "f32" {
        if !fa32Used {
          return emitFail(
            "emitProgram: .map result is f32[] but f32 list type not collected",
          )
        }
        dstWrap = fl32TypeIdx
        dstBack = fa32TypeIdx
      } else if resK == "str" {
        // A STRING-list result: a `.filter` over a string list, or a `.map` whose callback
        // returns a string. The backing `$mkArrIdx` holds string refs; `array.set` stores
        // the callback's (non-null) string result directly.
        if !slUsed {
          return emitFail(
            "emitProgram: .map/.filter result is string[] but string list type not collected",
          )
        }
        dstWrap = mkListIdx
        dstBack = mkArrIdx
      } else if resK == "ref" {
        // A REF-list result (a `.filter` over a struct/union array preserves the element type):
        // the result is the SAME ref list as the source, so its wrapper/backing come from the
        // result slot (== the source slot for `.filter`).
        if !rlUsed {
          return emitFail(
            "emitProgram: .filter result is a ref list but ref list type not collected",
          )
        }
        dstWrap = rlWrapIdx[dstSlot]
        dstBack = rlBackIdx[dstSlot]
      } else if resK == "u8" {
        // A `.filter` over a `u8[]` keeps the packed rep (`mfResultKindOf` forwards the
        // receiver's kind) — the destination twin of the source arm above, and unreachable
        // for the same reason until the `u8` callback parameter has a lowering.
        if !ba8Used {
          return emitFail(
            "emitProgram: .filter result is u8[] but the packed byte list type not collected",
          )
        }
        dstWrap = bl8TypeIdx
        dstBack = ba8TypeIdx
      } else if !lUsed || !aUsed {
        return emitFail(
          "emitProgram: .map/.filter result but list type not collected",
        )
      }
      const srcL = mfSrcLocalFor(recvK, srcSlot)
      const dstL = mfDstLocalFor(resK, dstSlot)
      if !fnUsesMapFilter || srcL < 0 || dstL < 0 {
        return emitFail("emitProgram: .map/.filter scratch frame not reserved")
      }
      const iL = mfScratchBase
      const nL = mfScratchBase + 1
      const jL = mfScratchBase + 2
      const cL = mfScratchBase + 3
      // src = <receiver>, evaluated ONCE. (Any nested `.map`/`.filter` in the
      // receiver chain completes — including its result wrapper — before this store,
      // so the shared frame slots are free to reuse.)
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      // A NARROWED nullable-list receiver keeps its nullable slot at EVERY element kind;
      // the src scratch slot is declared non-null (`fbRefRun` writes `0x64`), so recover
      // first (checker-guarded, never traps). See `nulRecvNeedsRecover`.
      if nulRecvNeedsRecover(callee.memObj, fnIx) {
        wU8(212) // 0xd4 ref.as_non_null
      }
      fbLocalSet(srcL)
      // clo = the callback's closure value, built ONCE before the loop. An inline
      // literal / named function constructs it directly; a let-bound value reads its
      // binding (an `Ident` read — it cannot itself contain a HOF site, so the frame
      // slots written above stay live).
      const cbNode = P.nodes[unwrapParen(c.callArgs[0])]
      if cbNode is FuncDecl {
        if emitClosureValue(body, cbFe, fnIx) < 0 { return -1 }
      } else if cbNode is Ident {
        if fnIndexOfSid(sidOfNode(unwrapParen(c.callArgs[0]))) >= 0 {
          if emitClosureValue(body, cbFe, fnIx) < 0 { return -1 }
        } else if emitExpr(body, c.callArgs[0], fnIx) < 0 {
          return -1
        }
      } else {
        return emitFail("emitProgram: unsupported .map/.filter callback")
      }
      fbLocalSet(cL)
      // n = src.len
      fbLocalGet(srcL)
      fbStructGet(srcWrap, 1) // field 1: len
      fbLocalSet(nL)
      // back = array.new_default <dstBack> n
      fbLocalGet(nL)
      fbArrayNewDefault(dstBack)
      fbLocalSet(dstL)
      // i = 0 (and j = 0 for filter)
      fbI32Const(0)
      fbLocalSet(iL)
      if !isMap {
        fbI32Const(0)
        fbLocalSet(jL)
      }
      // block { loop { if i >= n br 1; <element step>; i++; br 0 } }
      fbBlock(64)  // 0x02 block (void)
      ctrlEnter()
      fbLoop(64)   // 0x03 loop (void)
      ctrlEnter()
      fbLocalGet(iL)
      fbLocalGet(nL)
      fbI32Bin(78) // 0x4e i32.ge_s — i >= n?
      fbBrIf(1)    // exit the block
      if isMap {
        // back[i] = call_ref(clo, [elem(i)])
        fbLocalGet(dstL)
        fbLocalGet(iL)
        if (
          emitMfInvoke(body, cL, srcL, iL, srcWrap, srcBack, srcElemRef, sig) <
          0
        ) {
          return -1
        }
        fbArraySet(dstBack) // 0xfb 0x0e <dstBack>
      } else {
        // if call_ref(clo, [elem(i)]): back[j] = elem(i); j++
        if (
          emitMfInvoke(body, cL, srcL, iL, srcWrap, srcBack, srcElemRef, sig) <
          0
        ) {
          return -1
        }
        fbIf(64)      // 0x04 if (void)
        ctrlEnter()
        fbLocalGet(dstL)
        fbLocalGet(jL)
        emitMfElem(body, srcL, iL, srcWrap, srcBack, srcElemRef)
        fbArraySet(dstBack)
        fbLocalGet(jL)
        fbI32Const(1)
        fbI32Bin(106) // 0x6a i32.add
        fbLocalSet(jL)
        fbEnd()
        ctrlLeave()
      }
      fbLocalGet(iL)
      fbI32Const(1)
      fbI32Bin(106) // 0x6a i32.add
      fbLocalSet(iL)
      fbBr(0)       // continue the loop
      fbEnd()       // end loop
      ctrlLeave()
      fbEnd()       // end block
      ctrlLeave()
      // result = wrapper{ back, len, cap }: len = n (map) / j (filter), cap = n.
      fbLocalGet(dstL)
      if isMap { fbLocalGet(nL) } else { fbLocalGet(jL) }
      fbLocalGet(nL)
      fbStructNew(dstWrap)
      return 0
    }
  }
  emitFail("emitProgram: expected a .map/.filter call")
}

// ── the element-converting copy (read-only covariance, D791) ──────────────────
// Consume a `(ref $rlWrapIdx[srcSlot])` on the stack and leave a `(ref $rlWrapIdx[dstSlot])`
// holding the same elements boxed into the shared union box — the only lowering the pair
// has, since a mutable WasmGC array is invariant. Callers must ask `rlWidenAllowed` first.
function emitRefListWidenTop(_body: i32[], srcSlot: i32, dstSlot: i32) {
  const vi = rlWidenVariantOf(srcSlot, dstSlot)
  if vi < 0 || vi >= uTags.length {
    return emitFail(
      "emitProgram: ref-list widening asked for an element pair with no union arm",
    )
  }
  // The `fbValtype` discipline: never index a parallel `rl*` table on a slot that only
  // one of them covers. `rlWidenVariantOf` bounded `rlElemKindTbl`; these are the two
  // columns the loop's heap-type immediates come from.
  if srcSlot >= rlWrapIdx.length || dstSlot >= rlWrapIdx.length {
    return emitFail(
      "emitProgram: ref-list widening slot has no interned wrapper",
    )
  }
  if srcSlot >= rlBackIdx.length || dstSlot >= rlBackIdx.length {
    return emitFail(
      "emitProgram: ref-list widening slot has no interned backing",
    )
  }
  const srcWrap = rlWrapIdx[srcSlot]
  const srcBack = rlBackIdx[srcSlot]
  const dstWrap = rlWrapIdx[dstSlot]
  const dstBack = rlBackIdx[dstSlot]
  const sL = widenSrcWrapSlot(srcSlot)
  const dL = widenDstBackSlot(dstSlot)
  const iL = widenTmpSlot(0)
  const nL = widenTmpSlot(1)
  // Does the SOURCE row's element carry the `| null` niche (D811)? This is the one bit
  // that picks the loop body below, and it is read from the same column
  // `rlWidenVariantOf` bounded.
  const srcNul = srcSlot < rlElemNullable.length && rlElemNullable[srcSlot] == 1
  // src = <stack>, evaluated ONCE by the caller.
  fbLocalSet(sL)
  // n = src.len  (`struct.get` accepts a nullable ref and traps on null, so the
  // nullable frame slot needs no recover here).
  fbLocalGet(sL)
  fbStructGet(srcWrap, 1)
  fbLocalSet(nL)
  // back = array.new_default <dstBack> n
  fbLocalGet(nL)
  fbArrayNewDefault(dstBack)
  fbLocalSet(dL)
  fbI32Const(0)
  fbLocalSet(iL)
  // block { loop { if i >= n br 1; back[i] = {tag, src.back[i]}; i++; br 0 } }
  fbBlock(64)
  ctrlEnter()
  fbLoop(64)
  ctrlEnter()
  fbLocalGet(iL)
  fbLocalGet(nL)
  fbI32Bin(78) // 0x4e i32.ge_s
  fbBrIf(1)
  fbLocalGet(dL)
  fbLocalGet(iL)
  if srcNul {
    // the niche source's two-tag loop body (D811): the source element is `(ref null
    // $elem)` whose null is a legal value, and the destination box has a rep for that — a
    // box carrying `nullBoxTag()`. Boxing under the arm's tag instead is D792's trap: the
    // narrow's `ref.cast` would fail on the null payload, so the tag is picked per element.
    fbLocalGet(sL)
    fbStructGet(srcWrap, 0)
    fbLocalGet(iL)
    fbArrayGet(srcBack)
    wU8(209) // 0xd1 ref.is_null
    fbIfRefNul(uBoxIdx, false) // if (result (ref $uBox))
    ctrlEnter()
    fbI32Const(nullBoxTag())
    fbRefNullNone() // the payload slot is unread under the null tag
    fbStructNew(uBoxIdx)
    fbElse()
    fbI32Const(uTags[vi]) // the arm's program-global tag
    fbLocalGet(sL)
    fbStructGet(srcWrap, 0)
    fbLocalGet(iL)
    fbArrayGet(srcBack)
    fbStructNew(uBoxIdx)
    fbEnd()
    ctrlLeave()
  } else {
    fbI32Const(uTags[vi]) // the arm's program-global tag
    fbLocalGet(sL)
    fbStructGet(srcWrap, 0) // the source backing, `(ref $srcBack)`
    fbLocalGet(iL)
    fbArrayGet(srcBack) // `(ref null $elem)` — the box payload is `anyref`, so no recover
    fbStructNew(uBoxIdx)
  }
  fbArraySet(dstBack)
  fbLocalGet(iL)
  fbI32Const(1)
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(iL)
  fbBr(0)
  fbEnd()
  ctrlLeave()
  fbEnd()
  ctrlLeave()
  // { backing, len, cap } — the wrapper's field 0 is a NON-null `(ref $dstBack)`, so the
  // nullable frame slot recovers here and only here.
  fbLocalGet(dL)
  wU8(212) // 0xd4 ref.as_non_null
  fbLocalGet(nL)
  fbLocalGet(nL)
  fbStructNew(dstWrap)
  0
}

// The scratch slots' `liKinds` column is `MfKind`, whose `u8` names the PACKED backing
// that `VKind`'s `u8list` names the list of. Every other element kind spells the same.
function scalarElemMfKind(k: VKind): MfKind {
  if k == "f64" { return "f64" }
  if k == "i64" { return "i64" }
  if k == "f32" { return "f32" }
  if k == "u8list" { return "u8" }
  "i32"
}

// the scalar sibling of `emitRefListWidenTop` (D965): same loop, a numeric convert where
// the ref version boxes. Exactly the three lossless widenings VL's scalar assignability
// admits (i32→i64, i32→f64, f32→f64) over the full source/destination grid — every other
// pair is a design rejection, outside clause 2. Returns the opcode, or -1 for a decline (never an error).
function scalarWidenConvOp(srcKind: VKind, dstKind: VKind): i32 {
  if srcKind == "i32" {
    if dstKind == "i64" { return 172 }
    if dstKind == "f64" { return 183 }
    return -1
  }
  if srcKind == "f32" {
    if dstKind == "f64" { return 187 }
  }
  -1
}

function emitScalarListWidenTop(_body: i32[], srcKind: VKind, dstKind: VKind) {
  const op = scalarWidenConvOp(srcKind, dstKind)
  if op < 0 {
    return emitFail(
      "emitProgram: scalar-list widening asked for an element pair with no convert",
    )
  }
  const srcWrap = scalarListWrap(srcKind)
  const srcBack = scalarListBack(srcKind)
  const dstWrap = scalarListWrap(dstKind)
  const dstBack = scalarListBack(dstKind)
  const sL = widenScalarWrapSlot(scalarElemMfKind(srcKind))
  const dL = widenScalarBackSlot(scalarElemMfKind(dstKind))
  const iL = widenTmpSlot(0)
  const nL = widenTmpSlot(1)
  // src = <stack>, evaluated ONCE by the caller.
  fbLocalSet(sL)
  // n = src.len  (field 1 of the shared `{ backing, len, cap }` wrapper; `struct.get`
  // accepts a nullable ref and traps on null, so the nullable frame slot needs no
  // recover here).
  fbLocalGet(sL)
  fbStructGet(srcWrap, 1)
  fbLocalSet(nL)
  // back = array.new_default <dstBack> n  — the destination element's ZERO, which is
  // the right fill for every pair above (they are all numeric).
  fbLocalGet(nL)
  fbArrayNewDefault(dstBack)
  fbLocalSet(dL)
  fbI32Const(0)
  fbLocalSet(iL)
  // block { loop { if i >= n br 1; back[i] = conv(src.back[i]); i++; br 0 } }
  fbBlock(64)
  ctrlEnter()
  fbLoop(64)
  ctrlEnter()
  fbLocalGet(iL)
  fbLocalGet(nL)
  fbI32Bin(78) // 0x4e i32.ge_s
  fbBrIf(1)
  fbLocalGet(dL)
  fbLocalGet(iL)
  fbLocalGet(sL)
  fbStructGet(srcWrap, 0) // the source backing
  fbLocalGet(iL)
  fbArrayGet(srcBack) // yields the element in the SOURCE's rep
  wU8(op) // ...and this is the one byte that makes it the destination's
  fbArraySet(dstBack)
  fbLocalGet(iL)
  fbI32Const(1)
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(iL)
  fbBr(0)
  fbEnd()
  ctrlLeave()
  fbEnd()
  ctrlLeave()
  // { backing, len, cap } — field 0 is a NON-null ref, so the nullable frame slot
  // recovers here and only here. `cap == len`: the copy is exact-sized.
  fbLocalGet(dL)
  wU8(212) // 0xd4 ref.as_non_null
  fbLocalGet(nL)
  fbLocalGet(nL)
  fbStructNew(dstWrap)
  0
}

// The delivery-site half: a value just emitted at ref-list slot `srcSlot` is being
// delivered into a `dstSlot` destination. Widen it in place when the pair is widenable
// and the whole-program write scan licenses it; otherwise leave the stack untouched. One
// predicate, one emitter, asked at every delivery — the seven ways VL spells "this list flows there" are `letRefListDestSlot`'s own list.
export function emitRefListWidenSite(
  body: i32[],
  srcIx: i32,
  srcSlot: i32,
  dstSlot: i32,
): boolean {
  if (
    !rlWidenAllowed(
      covarRootName(srcIx),
      covarRootFrame(srcIx),
      srcSlot,
      dstSlot,
    )
  ) {
    return false
  }
  if emitRefListWidenTop(body, srcSlot, dstSlot) < 0 { return false }
  true
}

// The list kind a destination annotation classifies as, reduced to the element kind the
// `scalarList*` family keys on. `""` for anything not a scalar list. `u8list` answers with
// its own list kind since its element value kind (i32) does not identify its packed backing.
function scalarListElemOfListKind(k: VKind): VKind | null {
  if k == "list" { return "i32" }
  if k == "f64list" { return "f64" }
  if k == "i64list" { return "i64" }
  if k == "f32list" { return "f32" }
  if k == "u8list" { return "u8list" }
  null
}

// The scalar delivery site (D965) — `emitRefListWidenSite`'s twin, asked at the same
// boundaries: the pair must be one of the three the copy serves, both sides must classify
// as scalar lists, and D821's per-value write scan must say definitely-unwritten. The
// licence is the ref site's, for the same reason — a converting copy is a snapshot, so an unknown write state declines rather than risk a silently wrong program.
export function emitScalarListWidenSite(
  body: i32[],
  srcIx: i32,
  fnIx: i32,
  dstListKind: VKind,
): boolean {
  const de = scalarListElemOfListKind(dstListKind)
  if de == null { return false }
  emitScalarListWidenSiteElem(body, srcIx, fnIx, de)
}

// The same site keyed by the destination's ELEMENT kind rather than its list kind, for
// the two boundaries that have the destination as an EXPRESSION (the assignment's LHS)
// or as a nested element rather than as an annotation or a cell column.
function emitScalarListWidenSiteElem(
  body: i32[],
  srcIx: i32,
  fnIx: i32,
  de: VKind,
): boolean {
  const sk = scalarListElemKind(srcIx, fnIx)
  if sk == null { return false }
  if scalarWidenConvOp(sk, de) < 0 { return false }
  if covarValueWriteState(covarRootName(srcIx), covarRootFrame(srcIx)) != 0 {
    return false
  }
  if emitScalarListWidenTop(body, sk, de) < 0 { return false }
  true
}

// `emitClampIdx`'s dual over plain wasm i32 LOCALS (not the string-op frame): emit
// `clamp(idx, len)` reading `idx` from local `idxL`, `len` from `lenL`, leaving the
// clamped value on the stack. Same JS slice semantics (`idx < 0 ? max(len+idx, 0) :
// min(idx, len)`) built from `select`.
function emitClampLocal(_body: i32[], idxL: i32, lenL: i32) {
  // negCase = max(len+idx, 0) = select( len+idx, 0, (len+idx) > 0 )
  fbLocalGet(lenL)
  fbLocalGet(idxL)
  fbI32Bin(106) // i32.add → (len+idx)  [a]
  fbI32Const(0) // [b]
  fbLocalGet(lenL)
  fbLocalGet(idxL)
  fbI32Bin(106)
  fbI32Const(0)
  fbI32Bin(74)  // 0x4a i32.gt_s → (len+idx) > 0  [cond]
  wU8(27)       // 0x1b select → negCase
  // nonNegCase = min(idx, len) = select( idx, len, idx < len )
  fbLocalGet(idxL)
  fbLocalGet(lenL)
  fbLocalGet(idxL)
  fbLocalGet(lenL)
  fbI32Bin(72) // 0x48 i32.lt_s → idx < len  [cond]
  wU8(27)      // select → nonNegCase
  // result = select( negCase, nonNegCase, idx < 0 )
  fbLocalGet(idxL)
  fbI32Const(0)
  fbI32Bin(72) // 0x48 i32.lt_s → idx < 0
  wU8(27)      // select → clamped
  0
}

// The wrapper heap-type index the nullable-collection cell at `exprIx` holds: >= 0 the
// wrapper's heap type; -2 a nullable collection whose wrapper this emit cannot name (an
// index-needing lowering must decline, but the recover below still claims it); -1 not a
// nullable collection. One home so a nullable-test and a wrapper consumer cannot disagree.
function nulCollWrapHeap(exprIx: i32, fnIx: i32) {
  if exprNullableList(exprIx, fnIx) { return lTypeIdx }
  const nsk = exprNulScalarListKind(exprIx, fnIx)
  if nsk != null { return nulScalarListWrapHeap(nsk) }
  if exprNullableRefArray(exprIx, fnIx) {
    const s = refListSlotOfExpr(exprIx, fnIx)
    if s >= 0 && s < rlWrapIdx.length { return rlWrapIdx[s] }
    return -2
  }
  -1
}

// True when `exprIx` names a narrowed nullable collection whose cell still holds a
// `(ref null $wrap)` — every rep a list/map operation must `ref.as_non_null` before the
// wrapper `struct.get`. The read dual of `emitNulIsNullTest`'s niche disjunction, so a rep
// the null test claims but this does not would be check-clean invalid wasm, never a diagnostic.
function nulRecvNeedsRecover(exprIx: i32, fnIx: i32) {
  nulCollWrapHeap(exprIx, fnIx) != -1
}

// True when an element read out of list `exprIx` yields a rep that legitimately holds
// null, so the read must stay `(ref null $elem)` rather than take a trapping
// `ref.as_non_null`. Asked by the indexed read and the `.map`/`.filter` element step, so a
// callback's declared param valtype and the value handed to it agree.
function listElemStaysNullable(exprIx: i32, fnIx: i32) {
  if exprNulStrArray(exprIx, fnIx) { return true }
  if exprRefArray(exprIx, fnIx) {
    const s = refListSlotOfExpr(exprIx, fnIx)
    if s >= 0 && s < rlElemNullable.length { return rlElemNullable[s] == 1 }
  }
  false
}

// Lower an array `xs.slice(start, end?)` onto `body`, leaving a new list wrapper of the
// same element kind over the half-open clamped range `[start, end)` (JS semantics). Rides
// the `.map`/`.filter` scratch frame (`srcL`/`dstL` plus four i32 temps), evaluating the
// receiver once into `srcL`; works across i32/boolean, f64, ref and string lists.
function emitArrSlice(body: i32[], callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Member {
      const recvK = mfRecvKindOf(callee.memObj, fnIx)
      if recvK == null {
        return emitFail("emitProgram: .slice receiver is not a supported list")
      }
      let srcSlot = -1
      if recvK == "ref" { srcSlot = refListSlotOfExpr(callee.memObj, fnIx) }
      // The element kind's wrapper + backing heap types.
      let wrap = lTypeIdx
      let back = aTypeIdx
      if recvK == "f64" {
        if !fa64Used {
          return emitFail(
            "emitProgram: .slice over f64[] but f64 list type not collected",
          )
        }
        wrap = fl64TypeIdx
        back = fa64TypeIdx
      } else if recvK == "i64" {
        if !ia64Used {
          return emitFail(
            "emitProgram: .slice over i64[] but i64 list type not collected",
          )
        }
        wrap = il64TypeIdx
        back = ia64TypeIdx
      } else if recvK == "f32" {
        if !fa32Used {
          return emitFail(
            "emitProgram: .slice over f32[] but f32 list type not collected",
          )
        }
        wrap = fl32TypeIdx
        back = fa32TypeIdx
      } else if recvK == "ref" {
        if !rlUsed {
          return emitFail(
            "emitProgram: .slice over a ref list but ref list type not collected",
          )
        }
        wrap = rlWrapIdx[srcSlot]
        back = rlBackIdx[srcSlot]
      } else if recvK == "str" {
        if !slUsed {
          return emitFail(
            "emitProgram: .slice over string[] but string list type not collected",
          )
        }
        wrap = mkListIdx
        back = mkArrIdx
      } else if recvK == "u8" {
        // the packed byte list (D1141): a `(array (mut i8))` backing under the `$bl8`
        // wrapper, the arm this ladder needs since `mfRecvKindOf` would otherwise answer
        // `"i32"` for a `u8[]` receiver and mint the new list over the wrong 4-byte
        // backing. `array.copy` below is i8-to-i8, so the elements survive the copy.
        if !ba8Used {
          return emitFail(
            "emitProgram: .slice over u8[] but the packed byte list type not collected",
          )
        }
        wrap = bl8TypeIdx
        back = ba8TypeIdx
      } else if !lUsed || !aUsed {
        return emitFail("emitProgram: .slice but list type not collected")
      }
      const srcL = mfSrcLocalFor(recvK, srcSlot)
      const dstL = mfDstLocalFor(recvK, srcSlot)
      if !fnUsesMapFilter || srcL < 0 || dstL < 0 {
        return emitFail("emitProgram: .slice scratch frame not reserved")
      }
      // The `.map`/`.filter` frame's first 3 slots are i32 (i, n, j); slot +3 is a
      // closure ref. So slice has THREE i32 temps: `startL`, `endL`, and `auxL` which
      // holds the length during clamping then is reused for the out length.
      const startL = mfScratchBase + 0
      const endL = mfScratchBase + 1
      const auxL = mfScratchBase + 2
      // src = <receiver>, evaluated ONCE. A NARROWED nullable list recovers non-null at
      // EVERY element kind (`srcL` is declared non-null and `struct.get wrap` demands it),
      // not just the i32 one — see `nulRecvNeedsRecover`.
      if emitExpr(body, callee.memObj, fnIx) < 0 { return -1 }
      if nulRecvNeedsRecover(callee.memObj, fnIx) {
        wU8(212) // 0xd4 ref.as_non_null
      }
      fbLocalSet(srcL)
      // auxL = src.len (the wrapper's logical length, field 1)
      fbLocalGet(srcL)
      fbStructGet(wrap, 1)
      fbLocalSet(auxL)
      // start = clamp(rawStart, len)
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      fbLocalSet(startL)
      emitClampLocal(body, startL, auxL)
      fbLocalSet(startL)
      // end = clamp(rawEnd, len), or len when omitted (the 1-arg form slices to the end)
      if c.callArgs.length == 2 {
        if emitExpr(body, c.callArgs[1], fnIx) < 0 { return -1 }
        fbLocalSet(endL)
        emitClampLocal(body, endL, auxL)
        fbLocalSet(endL)
      } else {
        fbLocalGet(auxL)
        fbLocalSet(endL)
      }
      // auxL (len now dead) = outLen = max(end - start, 0) = select(end-start, 0, end>start)
      fbLocalGet(endL)
      fbLocalGet(startL)
      fbI32Bin(107) // i32.sub → end - start  [a]
      fbI32Const(0) // [b]
      fbLocalGet(endL)
      fbLocalGet(startL)
      fbI32Bin(74)  // 0x4a i32.gt_s → end > start  [cond]
      wU8(27)       // 0x1b select
      fbLocalSet(auxL)
      // dst backing = array.new_default <back> outLen
      fbLocalGet(auxL)
      fbArrayNewDefault(back)
      fbLocalSet(dstL)
      // result wrapper = struct.new <wrap> (dstBacking, outLen, outLen) — pushed FIRST so
      // it remains on the stack after the trailing `array.copy` consumes its own operands.
      fbLocalGet(dstL)
      fbLocalGet(auxL)
      fbLocalGet(auxL)
      fbStructNew(wrap)
      // array.copy dst 0 src.backing start outLen
      fbLocalGet(dstL)        // dest backing
      fbI32Const(0)           // dest offset
      fbLocalGet(srcL)
      fbStructGet(wrap, 0)    // src backing
      fbLocalGet(startL)      // src offset
      fbLocalGet(auxL)        // count
      fbArrayCopy(back, back) // array.copy (dest type, src type)
      // The result wrapper from `struct.new` above is the value left on the stack.
      return 0
    }
    return emitFail("emitProgram: .slice receiver is not a member access")
  }
  emitFail("emitProgram: expected an array slice call")
}

// Push `elem(i)` — `src.backing[i]` — onto the stack (`ref.as_non_null` for a ref
// element, surfacing the non-null struct/union box).
function emitMfElem(
  _body: i32[],
  srcL: i32,
  iL: i32,
  srcWrap: i32,
  srcBack: i32,
  srcElemRef: boolean,
) {
  fbLocalGet(srcL)
  fbStructGet(srcWrap, 0) // field 0: backing
  fbLocalGet(iL)
  fbArrayGet(srcBack)     // 0xfb 0x0b <srcBack>
  if srcElemRef {
    wU8(212) // 0xd4 ref.as_non_null
  }
  0
}

// Invoke the callback closure (stashed in local `cL`) on `elem(i)`: push its env
// (field 0), the element, its function index (field 1), then `call_indirect $fnsig`
// — leaving the callback's result on the stack. This runs once per element, which is
// why the id is an i32 load and not a funcref field's host libcall.
function emitMfInvoke(
  body: i32[],
  cL: i32,
  srcL: i32,
  iL: i32,
  srcWrap: i32,
  srcBack: i32,
  srcElemRef: boolean,
  sig: i32,
) {
  fbLocalGet(cL)
  fbStructGet(cloStructIdx, 0)     // env
  emitMfElem(body, srcL, iL, srcWrap, srcBack, srcElemRef)
  fbLocalGet(cL)
  fbStructGet(cloStructIdx, 1)     // the callee's wasm function index
  fbCallIndirect(sig, gFnTableIdx) // 0x11 <fnsig> <table>
  0
}

// `local.get L ; struct.get $lTy 1` — push the list's `len` field onto `body`.
function pushListLen(_body: i32[], lIdx: i32, lTy: i32) {
  fbLocalGet(lIdx)    // local.get
  fbStructGet(lTy, 1) // 0xfb 0x02 <lTy> field 1: len
  0
}

// `local.get L ; struct.get $lTy 2` — push the list's `cap` field onto `body`.
function pushListCap(_body: i32[], lIdx: i32, lTy: i32) {
  fbLocalGet(lIdx)    // local.get
  fbStructGet(lTy, 2) // 0xfb 0x02 <lTy> field 2: cap
  0
}

// `local.get L ; struct.get $lTy 0` — push the list's `backing` ref onto `body`.
function pushListBacking(_body: i32[], lIdx: i32, lTy: i32) {
  fbLocalGet(lIdx)    // local.get
  fbStructGet(lTy, 0) // 0xfb 0x02 <lTy> field 0: backing
  0
}

// Push the list ref a `for v in <iter>` iterates. A map iterable (`m.keys()`, `m.values()`,
// or the bare `for k in m`) reads the ordered list field off the map ref the caller already
// stashed (`mapRecv >= 0`): field 1 for a vals walk, field 0 for a keys walk — not
// re-emitted, so the walked list, tombstone `live[]` and loop bound stay on one object.
function emitForInList(
  body: i32[],
  iterIx: i32,
  fnIx: i32,
  mapRecv: i32,
  mwShape: i32,
) {
  if mapRecv >= 0 {
    cmSlot = mwShape
    if forInMapWalksVals(iterIx, fnIx) { return pushMapVals(body) }
    return pushMapKeys(body)
  }
  emitExpr(body, iterIx, fnIx)
}

// Lower a return-value expression `retArg` for function `fnIx`: seed the return context
// from the function's return type, emit through the matching helper, then reset the
// pending seeds. Does not emit `return` itself — the caller appends `fbReturn` or leaves
// the value on the stack. Unifies explicit `return e` with implicit tail-position returns.
function emitReturnValue(body: i32[], retArg: i32, fnIx: i32) {
  const fn = P.nodes[fnIx]
  // the heap a niche struct/variant result names (`Circle | null`, `Dot | null`) — the
  // narrowed-arm unbox's destination at this boundary (D1031). A bare `: Circle` result
  // needs none: `retVi` routes it through `emitVariantCoerce`.
  let retArmHeap = -1
  // one read, four uses: the inferred-return arms below want `fnStmtsPosOf`'s answer four
  // separate times, and taking it once is a hoist safe because nothing between the reads
  // writes `fnStmts`/`monoOrigNode` — both are written only by the collect/mono passes,
  // which finish before `emitCodeSection` begins. Stays behind `fn.fnRet < 0`, so an annotated return pays nothing.
  let fnPos = -1
  if fn is FuncDecl {
    if fn.fnRet < 0 { fnPos = fnStmtsPosOf(fnIx) }
  }
  if fn is FuncDecl {
    const rsi = retStructIndex(fn.fnRet)
    if rsi >= 0 {
      if retTRFlag(fn.fnRet) == 1 { pendingStructIdx = rsi }
      if retNulRefFlag(fn.fnRet) == 1 { pendingStructIdx = rsi }
      // D911 — the `??` merge redirect, on the returned value: the signature moved to the
      // merged row (gated on `anonLeafRetMovedOf`, a field-set row another function can
      // also resolve to), so without this the callee hands a narrow `struct.new` back
      // through a merged `(result (ref $merged))`. The three call sites read one kind so they cannot drift.
      const rvk = vtKindOfType(fn.fnRet)
      if rvk == "struct" || rvk == "nulstruct" {
        if anonLeafRetMovedOf(fnIx) {
          pendingStructIdx = anonLeafSupersedeOf(rsi)
        }
      }
    }
    // A `: Cat` variant return: seed the variant index so a `return { … }` object literal
    // builds the bare variant struct (kind 8) instead of boxing into the union.
    if retVariantFlag(fn.fnRet) == 1 {
      pendingVariantIdx = variantIndexOf(tyNameOf(fn.fnRet))
    }
    // A `: Circle | null` return seeds BOTH halves of its niche, as the nullable
    // boundaries elsewhere do: the variant index so a `return { … }` literal builds the
    // concrete variant struct, and the heap type so a bare `return null` lowers as
    // `ref.null $uVarHeap[vi]` instead of reaching `emitNullLitNode` with no context.
    if retNulVariantFlag(fn.fnRet) == 1 {
      const rnvi = nulVariantIndexOf(fn.fnRet)
      if rnvi >= 0 && rnvi < uVarHeap.length {
        pendingVariantIdx = rnvi
        pendingNulRefHeap = uVarHeap[rnvi]
      }
      retArmHeap = armDestHeapOf("nulvariant", rnvi)
    }
    // The kind-9 twin: a `Dot | null` result over a DECLARED struct that is the arm's layout
    // twin. Same slot shape, same unbox owed, a struct row instead of a variant one.
    if retNulRefFlag(fn.fnRet) == 1 {
      retArmHeap = armDestHeapOf("nulstruct", retNulRefIndex(fn.fnRet))
    }
    // An INFERRED variant return (a `.map` lambda collapsing to one variant): seed it from
    // the checker's recorded return shape so the else-arm's `{ … }` literal builds the bare
    // variant too, matching the then-arm's narrowed variant rep.
    if fn.fnRet < 0 {
      const rvi = cbRetVariantIdx(fnPos)
      if rvi >= 0 {
        pendingVariantIdx = rvi
      } else if fnPos >= 0 && fnPos < fRetKind.length {
        // the classified pair, when the collapse arm has nothing — the same fact
        // `emitOneFuncType`'s inferred `variant` arm emits the result valtype from, so
        // reading it here (D51) keeps the literal and the functype in agreement:
        // otherwise the literal still boxes into a `(ref $uVarHeap[vi])` result, invalid wasm.
        if fRetKind[fnPos] == "variant" {
          if fnPos < fRetStructIdx.length {
            pendingVariantIdx = fRetStructIdx[fnPos]
          }
        }
      }
    }
    // D887 — an inferred nullable-struct return seeds the same struct context the
    // annotated `: {r: i32} | null` spelling seeds through `retNulRefFlag` above, so the
    // bare `return null` lowers as `ref.null $S` rather than reaching `emitNullLitNode`
    // with no context. The `??`-merge redirect rides along, or caller and callee disagree at the seam.
    if fn.fnRet < 0 {
      if fnPos >= 0 && fnPos < fRetKind.length {
        if fRetKind[fnPos] == "nulstruct" {
          if fnPos < fRetStructIdx.length {
            const nsi = fRetStructIdx[fnPos]
            if nsi >= 0 {
              pendingStructIdx = nsi
              if anonLeafRetMovedOf(fnIx) {
                pendingStructIdx = anonLeafSupersedeOf(nsi)
              }
            }
          }
        }
        // D937 — the nullable-map twin of the arm above: a map's null is not a struct
        // null, so the seed is `pendingNulRefHeap` rather than `pendingStructIdx`, with
        // `pendingMapSlot` seeded beside it so a returned `Map()` builds the same struct
        // the bare `null` is typed against.
        if fRetKind[fnPos] == "nulmap" {
          // D956 — the map's own value slot, not the mono `$mapStruct` D937 assumed: a
          // `{[string]: string} | null` return needs its own slot, from the same home that
          // also seeds the constructor inside the body.
          const nmSlot = inferredRetMapSlot(fnPos)
          pendingMapSlot = nmSlot
          pendingNulRefHeap = mapTypeIdxOf(nmSlot)
        }
      }
    }
    pendingListKind = tyAnnRefListKind(fn.fnRet)
    pendingListSlot = tyAnnRefListSlot(fn.fnRet)
    // an un-annotated return has no annotation node for the two lines above to read, so an
    // empty `[]` needs its own seed (D16): the checker recorded the hole's real type on the
    // literal itself, and `criClassify`'s hole arm mints the result valtype from that same
    // node, so seeding the build from it keeps the two in agreement by construction.
    if fn.fnRet < 0 {
      const hbk = emptyArrHoleBuildKind(retArg)
      if hbk != 0 {
        pendingListKind = hbk
        pendingListSlot = emptyArrHoleBuildSlot(retArg)
      }
    }
  }
  // the result's ref-list row, for the read-only-covariance widening (D791): the
  // annotation's row, or — for an un-annotated function — `criClassify`'s recorded
  // `("reflist", slot)`, the same pair `emitOneFuncType` reads for the result valtype.
  let retRlSlot = -1
  let retSLKind: VKind | null = null
  if fn is FuncDecl {
    if fn.fnRet >= 0 {
      retSLKind = vtKindOfType(fn.fnRet)
      if vtKindOfType(fn.fnRet) == "reflist" {
        retRlSlot = tyAnnRefListSlot(fn.fnRet)
      }
    } else if fnPos >= 0 && fnPos < fRetKind.length {
      if fRetKind[fnPos] == "reflist" && fnPos < fRetStructIdx.length {
        retRlSlot = fRetStructIdx[fnPos]
      }
    }
  }
  let retF32 = false
  let retF64 = false
  let retI64 = false
  let retNulBool = false
  let retNulString = false
  let retNulClosure = false
  let retNulList = false
  let retNulRefArr = false
  let retNulRefArrHeap = -1
  // A NULLABLE map return (`{[string]: V} | null`, kind `nulmap`): a `return m` passes the map ref
  // (which subtypes the nullable result), a `return null` is `ref.null $mapStruct`. `retNulMapShape`
  // is the map SHAPE (for the null heap + a `return Map()`).
  let retNulMap = false
  let retNulMapShape = -1
  // A non-null map return (`{[string]: V}`, kind 6): a `return Map()` must `struct.new` THIS
  // value type's `$mapStruct`, not the shared mono one — `retMapShape` carries the annotation's
  // map SHAPE for the constructor, the bare-map twin of `retNulMapShape`. (`return m` passes an
  // already-built map ref and needs no seed, which is why only the DIRECT constructor is at risk.)
  let retMap = false
  let retMapShape = -1
  let retNulSLKind: VKind | null = null
  let retLitUnion = false
  let retNulLitUnion = false
  // A `string`-returning function whose `return` value is a literal-union atom: widen the
  // atom to its member string at the return boundary (the atom-as-string-subtype edge).
  let retStrWiden = false
  let retUNm = ""
  let retVi = -1
  if fn is FuncDecl {
    // A concrete-variant return (annotated `: Cat`, or a collapsed inferred lambda).
    if retVariantFlag(fn.fnRet) == 1 {
      retVi = variantIndexOf(tyNameOf(fn.fnRet))
    }
    if fn.fnRet < 0 {
      const rvi2 = cbRetVariantIdx(fnPos)
      if rvi2 >= 0 { retVi = rvi2 }
    }
    if retF32Flag(fn.fnRet) == 1 { retF32 = true }
    if retF64Flag(fn.fnRet) == 1 { retF64 = true }
    if retI64Flag(fn.fnRet) == 1 { retI64 = true }
    // An UN-annotated return INFERRED as i64/f64 (the stored kind the A20 pass fills) widens
    // its value too — without this a `return 0` (an i32 literal) in a function whose other
    // branch returns a big i64 / an f64 expression stays `i32.const`, clashing with the i64/f64
    // functype result the inferred-return path declares (a soundness hole the checker accepts).
    if fn.fnRet < 0 {
      const rfe = fnPos
      if rfe >= 0 {
        if fRetKind[rfe] == "i64" { retI64 = true }
        if fRetKind[rfe] == "f64" { retF64 = true }
        // the f32 dual: an inferred f32 return whose body carries a float literal emits f64
        // unless forced, clashing with the f32 functype result (#614); a bare f32 `return x` needs no coercion.
        if fRetKind[rfe] == "f32" { retF32 = true }
        // an inferred `f32[]` return has no producer, so the functype result stays at the
        // `"i32"` default while the emitted `return` pushes the f32 list's `(ref $array)` —
        // check-clean invalid wasm. Neither channel that fills the slot classifies this
        // shape; refuse loudly until it does. The annotated spelling already lowers.
        if fRetKind[rfe] == "i32" && exprF32Array(retArg, fnIx) {
          return emitFail(
            "emitProgram: an f32[] return must be annotated (`: f32[]`) — the inferred form has no result type",
          )
        }
      }
    }
    // a literal-union return reads as a union name but is an i32 atom — excluded from the
    // value-union box return, since `emitUnionBoxArg` would `struct.new` the member. A
    // nullable-closure return is the closure niche, not a value box, routed through
    // `retNulClosure` below; a nullable literal union is excluded on the same grounds.
    if retUnionFlag(fn.fnRet) == 1 {
      if (
        !nodeTyIsLitUnionAlias(fn.fnRet) &&
        !nodeTyIsNulLitUnion(fn.fnRet) &&
        nulCloFlag(fn.fnRet) != 1
      ) {
        retUNm = tyNameOf(fn.fnRet)
      }
    }
    if fn.fnRet < 0 {
      const im = inferRetNameOf(fn.fnName)
      // a value union or registered struct-union inferred return is a union-box return
      // (kind 4): box each concrete-variant/value-atom `return` via `retUNm`. A litunion
      // alias name is excluded on the same grounds as the annotated arm above — it
      // registers as a union name but its value is the interned i32 atom, so boxing it would be wrong.
      if (
        isValueUnionName(im) ||
        (isUNameAB(26, im, inferRetTyIxOf(fn.fnName)) && !nameIsLitUnionType(im))
      ) {
        retUNm = im
      }
      // The inferred twins of the `nodeTyIsLitUnionAlias` / `nodeTyIsNulLitUnion` seeds
      // below: an un-annotated litunion return encodes a member literal as its atom id,
      // and its `| null` niche encodes a bare `null` as the `-1` sentinel.
      if nameIsLitUnionType(im) { retLitUnion = true }
      if nameIsNulLitUnion(im) { retNulLitUnion = true }
    }
    // A CONCRETE-variant return (`: Cat`, or a collapsed-to-one-variant inferred lambda):
    // route the value through `emitVariantCoerce` so a mixed-rep value-`if` (a narrowed
    // union arm + a literal arm) lands in ONE variant rep. Overrides the `pendingVariantIdx`
    // literal seeding above — `emitVariantCoerce` builds the literal itself.
    if retVi >= 0 { pendingVariantIdx = -1 }
    if tyIsNulBool(fn.fnRet) { retNulBool = true }
    if retNulStringFlag(fn.fnRet) == 1 { retNulString = true }
    // A nullable-closure return (`((i32) => i32) | null`, kind 19): a `return null` lowers
    // as `ref.null $cloStruct` (the niche), a function value passes through as the fat
    // pointer widened to the nullable storage — the return analogue of the kind-22 field.
    if nulCloFlag(fn.fnRet) == 1 { retNulClosure = true }
    if retNulListFlag(fn.fnRet) == 1 { retNulList = true }
    // A nullable ref-array return (`<ref-array> | null`, kind 18): a `return [x]` builds the ref
    // list (which subtypes the nullable wrapper), a `return null` is `ref.null $wrapper` — seed the
    // inner wrapper heap so the bare-`null` return path types it.
    if retNulRefArrFlag(fn.fnRet) == 1 {
      retNulRefArr = true
      const rlsRet = tyAnnRefListSlot(fn.fnRet)
      if rlsRet >= 0 && rlsRet < rlWrapIdx.length {
        retNulRefArrHeap = rlWrapIdx[rlsRet]
      }
    }
    if retNulMapFlag(fn.fnRet) == 1 {
      retNulMap = true
      retNulMapShape = mapAnnShape(fn.fnRet)
    }
    if retMapFlag(fn.fnRet) == 1 {
      retMap = true
      retMapShape = mapAnnShape(fn.fnRet)
    }
    // the inferred dual of the arm above: an un-annotated map return (`function mk() {
    // return Map() }`) has no annotation for `retMapFlag` to read, so a bare `Map()` would
    // build the mono struct while the functype declares the value-typed one. The shape
    // comes from the same chokepoint the result valtype does (`mapRetExprShape`).
    if fn.fnRet < 0 && fnPos >= 0 {
      if fRetKind[fnPos] == "map" {
        const imrx = fnRetExprOf(fnIx)
        if imrx >= 0 {
          retMap = true
          retMapShape = mapRetExprShape(imrx, fnPos)
        }
      }
    }
    retNulSLKind = nulScalarListKindOfNode(fn.fnRet)
    if nodeTyIsLitUnionAlias(fn.fnRet) { retLitUnion = true }
    // A `K | null` NICHE return: a `return null` lowers as the i32 sentinel `-1`, a `return "a"`
    // as its atom id — so seed BOTH the niche flag and `pendingLitUnion`.
    if nodeTyIsNulLitUnion(fn.fnRet) { retNulLitUnion = true }
    // reads the annotation spelling, and canon softens a literal union to `string`, so a
    // `: K` return would answer true here too — `retLitUnion` above already claims it, so
    // this narrowing is inert for that case and only fires for a genuine `string` return.
    if nodeTyIsStringPrim(fn.fnRet) {
      if exprIsLitAtom(retArg, fnIx) { retStrWiden = true }
    }
    // the `string | null` niche return takes the same widen: its slot is the same string
    // ref with null permitted, and a widened member string is non-null, so it subtypes the
    // slot. Asked of the arena (`retNulStringFlag`) rather than the spelling test above, since the nullable form does not spell `"string"`.
    if retNulStringFlag(fn.fnRet) == 1 {
      if exprIsLitAtom(retArg, fnIx) { retStrWiden = true }
    }
    // an inline literal-union return (`: "circle" | "rect"`) takes the same widen: the
    // inline and named forms rep differently, so this needs its own arm. A named litunion
    // return (`: K`) reps as the interned atom and is claimed by `retLitUnion` above; an
    // un-named one reps as a string ref, so it must widen.
    if retLitUnionInline(fn.fnRet) {
      if exprIsLitAtom(retArg, fnIx) { retStrWiden = true }
    }
    // the inferred-string dual: an un-annotated function whose checked return is `string`
    // widens an atom return value too; without it the raw i32 id flowed into the
    // string-ref functype result (invalid wasm).
    if fn.fnRet < 0 && cloRetIsString(fnPos) {
      if exprIsLitAtom(retArg, fnIx) { retStrWiden = true }
    }
    // an inferred return whose value is an atom is left as an atom, and the call site
    // widens it (`fRetLitAtom`, from `criClassify`) — one flag, read by both passes.
    // Inferred niche nullable: seed from the A20 name so a `return null`/`return
    // <bool|string>` lowers as the sentinel/`ref.null` rep.
    if fn.fnRet < 0 {
      const nn = inferNicheNullByName(fn.fnName)
      if nn == "boolean|null" { retNulBool = true }
      if nn == "string|null" { retNulString = true }
    }
    // An implicit-return ASSIGNMENT to a `string | null` cell: the re-read this return
    // value IS must keep the RAW nullable ref, because the result valtype the functype
    // declares for it is `(ref null $sTypeIdx)`. Same fact, same function.
    if fn.fnRet < 0 && fnPos >= 0 {
      if fnAssignRetKind(fnPos) == "nulstr" { retNulString = true }
    }
  }
  if retF32 {
    const savedF32 = pendingF32
    pendingF32 = true
    if emitExprAsF32(body, retArg, fnIx) < 0 { return -1 }
    pendingF32 = savedF32
  } else if retF64 {
    if emitExprAsF64(body, retArg, fnIx) < 0 { return -1 }
  } else if retI64 {
    if emitExprAsI64(body, retArg, fnIx) < 0 { return -1 }
  } else if retVi >= 0 {
    if emitVariantCoerce(body, retVi, retArg, fnIx) < 0 { return -1 }
  } else if retUNm != "" {
    // `retUNm` is the union-BOX return (kind 4); a concrete variant `return s` (where `s: S`
    // and the return type is `C | S`) is boxed into the shared `{tag, payload}` rep here.
    if emitUnionBoxArg(body, retUNm, retArg, fnIx) < 0 { return -1 }
  } else if retStrWiden {
    // A literal-union atom returned from a `string`-typed function widens to its member string.
    if emitAtomToStr(body, retArg, fnIx) < 0 { return -1 }
  } else {
    const retCtx = expCtxHere()
    if retNulBool { retCtx.nulBool = true }
    if retNulString { retCtx.nulString = true }
    if retNulClosure { retCtx.nulClosure = true }
    if retNulList { retCtx.nulList = true }
    // The #964 seed-leak gate (stated in full at `emitObj`'s code-28 arm), at the RETURN
    // boundary. Witness: `return [null]` of `({f: boolean | null} | null)[] | null`.
    if retNulRefArr && retNulRefArrHeap >= 0 {
      if P.nodes[unwrapParen(retArg)] is NullLit {
        retCtx.nulRefHeap = retNulRefArrHeap
      }
    }
    // A nulmap return: a `return null` is `ref.null $mapStruct` (`nulRefHeap`), a `return Map()`
    // builds THIS map's struct (`mapSlot`). A `return m` (a map variable) self-identifies and
    // subtypes the nullable result.
    if retNulMap {
      retCtx.nulRefHeap = mapTypeIdxOf(retNulMapShape)
      retCtx.mapSlot = retNulMapShape
    }
    // a bare map return: a `return Map()` builds this map's own `$mapStruct`, the same
    // seed the let/global/field constructor sites thread — else the constructor reads the
    // ambient `pendingMapSlot` (the mono i32 map) while the functype declares the value-typed struct.
    if retMap { retCtx.mapSlot = retMapShape }
    // A DISTINCT-backing nullable scalar list return: a `return [x]` builds the leaf list
    // (`listKind`, which subtypes the nullable result), a `return null` is `ref.null $wrapper`.
    if retNulSLKind != null {
      retCtx.listKind = nulScalarListBuildKind(retNulSLKind)
      retCtx.nulRefHeap = nulScalarListWrapHeap(retNulSLKind)
    }
    if retLitUnion { retCtx.litUnion = 1 }
    if retNulLitUnion {
      retCtx.nulLitUnion = true
      retCtx.litUnion = 1
    }
    if emitExprExpect(body, retArg, fnIx, retCtx) < 0 { return -1 }
    // a return is a kind-9 use site that never grew the recover: a nullable-struct/variant
    // read deliberately stays the raw `(ref null $S)` (`emitCapturedReadRecover`'s rule),
    // so returning it into a non-null struct result needs its own `ref.as_non_null` or the
    // functype promises `(ref $S)` over `(ref null $S)`. A no-op on an already-recovered value.
    if retNeedsNonNullRecover(retArg, fnIx, fnPos) { fbRefAsNonNull() }
  }
  // read-only covariance at the RETURN boundary (D791) — `return lv1` from a `(): Shape[]`.
  if retRlSlot >= 0 {
    emitRefListWidenSite(
      body,
      retArg,
      exprEmittedRefListSlot(retArg, fnIx),
      retRlSlot,
    )
  }
  // the scalar dual (D965) — `return e` from a `(): f64[]`. Read off the ANNOTATION for
  // the reason `retRlSlot` is: the functype's own source is what keeps the widened value
  // and the declared result in agreement by construction.
  if retSLKind != null {
    emitScalarListWidenSite(body, retArg, fnIx, retSLKind)
  }
  // the narrowed-arm unbox at the return boundary (D1031): the bare `: Circle` result is
  // already served through `emitVariantCoerce`; the niche results (`Circle | null`, `Dot |
  // null`) are the ones that took the box into a `(ref null $H)` slot. Read off the same
  // (kind, slot) pair the result valtype is written from.
  if retArmHeap >= 0 && retVi < 0 {
    if narrowedArmNeedsUnbox(retArg, fnIx) {
      emitNarrowedArmUnboxTo(retArmHeap)
    }
  }
  pendingStructIdx = -1
  pendingVariantIdx = -1
  pendingListKind = 0
  pendingListSlot = 0
  0
}

// The exact bytes `fbStructNew(uBoxIdx)` writes, produced BY that encoder into a scratch
// buffer rather than re-derived — so the peephole's pattern cannot drift from the
// instruction it matches if the encoding (or `uBoxIdx`'s ULEB width) ever changes.
function unionBoxNewBytes() {
  const probe: i32[] = []
  const prev = wTarget(probe)
  fbStructNew(uBoxIdx)
  wTarget(prev)
  probe
}

// The exact bytes `fbCall(fnIdx)` writes, produced BY that encoder into a scratch buffer
// — the `unionBoxNewBytes` discipline, so the tail-call peephole's pattern cannot drift
// from the instruction it matches if the funcidx's ULEB width changes.
function callBytes(fnIdx: i32) {
  const probe: i32[] = []
  const prev = wTarget(probe)
  fbCall(fnIdx)
  wTarget(prev)
  probe
}

// Rewrite a trailing direct `call` into `return_call`, reporting whether it fired. A call
// whose bytes are still the last thing written when `return` terminates is in tail
// position by construction. Validity needs no result-type check, since `return_call`
// imposes the same subtyping `return` already does; the one break is arity.
function emitTailCallRet(fnIx: i32) {
  if fnUsesUnionSink { return false }
  if tailCallIdx < 0 { return false }
  if tailCallEnd != wLen() { return false }
  const pat = callBytes(tailCallIdx)
  const np = pat.length
  let ok = true
  let i = 0
  while i < np {
    if wPeekBack(i) != pat[np - 1 - i] { ok = false }
    i = i + 1
  }
  if !ok { return false }
  const fnPos = fnStmtsPosOf(fnIx)
  if fnPos < 0 { return false }
  if fRetVoid[fnPos] == 1 { return false }
  wDropBack(np)
  fbReturnCall(tailCallIdx) // 0x12 return_call
  tailCallEnd = -1
  tailCallIdx = -1
  true
}

// Terminate a return in function-result position: the ordinary `return`, the tail-call
// rewrite when the result is a direct call, or — for a union-box-returning function
// taking the sink — the two `local.set`s and branch to the exit block. A peephole: when
// the last instruction written is `struct.new $uBox`, popping its operands into the exit locals is observably identical.
export function emitUnionRetSink(fnIx: i32) {
  if fnUsesUnionSink {
    if uBoxNewIsLast() {
      uBoxSinkToPair()
      fbBr(ctrlDepth) // 0x0c br to the function's single exit block
      uSinkFired = uSinkFired + 1
      return 0
    }
  }
  if emitTailCallRet(fnIx) { return 0 }
  fbReturn() // 0x0f return
  0
}

// the union-box peephole's match, shared by both sink positions: is the last instruction
// written the box's own `struct.new $uBox`, with its two operands still on the wasm stack
// in field order? Both conditions are load-bearing: the cursor alone admits nothing-written-
// since, the byte pattern alone admits a false match (an operand can spell any opcode).
function uBoxNewIsLast() {
  if uBoxNewEnd != wLen() { return false }
  const pat = unionBoxNewBytes()
  const np = pat.length
  let ok = true
  let i = 0
  while i < np {
    if wPeekBack(i) != pat[np - 1 - i] { ok = false }
    i = i + 1
  }
  ok
}

// Unwrite the matched `struct.new $uBox` and pop its two operands into the sink pair,
// restoring the wasm stack to before the box's operands pushed. Valid only immediately
// after `uBoxNewIsLast()` answers true.
function uBoxSinkToPair() {
  wDropBack(unionBoxNewBytes().length)
  fbLocalSet(unionSinkBase + 1) // the anyref payload — top of stack
  fbLocalSet(unionSinkBase) // the i32 tag — beneath it
  0
}

// Terminate a return: lower the value at `retArg` as function `fnIx`'s result and end the
// exit. Every exit in the emitter goes through here, so the value lowering and its
// terminator can never be paired differently. The one exception is a returned
// if-expression in a sinking function, split into per-arm exits below.
function emitReturnExit(body: i32[], retArg: i32, fnIx: i32) {
  if fnUsesUnionSink {
    const bare = P.nodes[unwrapParen(retArg)]
    if bare is IfStmt {
      return emitUnionRetIfSink(body, unwrapParen(retArg), fnIx)
    }
  }
  if emitReturnValue(body, retArg, fnIx) < 0 { return -1 }
  emitUnionRetSink(fnIx)
  0
}

// `return if c { a } else { b }` in a union-box-returning function taking the sink.
// `emitUnionCoerce`'s value-typed `if` builds a box in each arm, so lowering it as a void
// statement-`if` whose arms each return is the identical program, meeting the sink's
// peephole per arm. The trailing `unreachable` restores the polymorphism a diverging `end` still needs.
function emitUnionRetIfSink(body: i32[], ifIx: i32, fnIx: i32) {
  const s = P.nodes[ifIx]
  if s is IfStmt {
    if s.ifElse < 0 {
      return emitFail("emitProgram: union if-expression requires an else arm")
    }
    if emitExpr(body, s.ifCond, fnIx) < 0 { return -1 }
    fbIf(64) // 0x04 if, 0x40 void blocktype
    // The arms hold sunk RETURNS whose `br` operand is the frame distance to the
    // function's exit block, so this frame has to be counted. The `else` reuses it (one
    // frame per `if`/`else` pair), matching `emitIfTail`/`emitIfStmtStmt`.
    ctrlEnter()
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const rcT = emitUnionRetIfArm(body, s.ifThen, fnIx)
    if narrowed { restoreNarrow(savedTop) }
    if rcT < 0 { return -1 }
    fbElse() // 0x05 else
    // A VALUE union narrows to the COMPLEMENT set in the else-arm (see `emitStmt`).
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    const els = P.nodes[s.ifElse]
    let rc = 0
    if els is IfStmt {
      rc = emitUnionRetIfSink(body, s.ifElse, fnIx) // `else if`: another chain link
    } else {
      rc = emitUnionRetIfArm(body, s.ifElse, fnIx)
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    ctrlLeave()
    fbUnreachable() // 0x00 — every arm exited; see the header
    return 0
  }
  emitFail("emitProgram: expected a union if-expression")
}

// One arm of a sunk returned if-expression: the arm's prelude, then its tail-value
// statement lowered as the function's return value and terminated like any other exit
// (`emitReturnExit`, which recurses when that value is itself an if-expression).
function emitUnionRetIfArm(body: i32[], blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if stmtIsTailValue(tv, fnIx) {
        if emitIfArmOpen(body, blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        return emitIfArmClose(emitReturnExit(body, tv, fnIx))
      }
      const inner = P.nodes[unwrapParen(tv)]
      if inner is IfStmt {
        if emitIfArmOpen(body, blockIx, fnIx) < 0 { return emitIfArmClose(-1) }
        return emitIfArmClose(emitReturnExit(body, tv, fnIx))
      }
    }
    return ifArmNoValueFail("union if-expression arm", blockIx)
  }
  emitFail("emitProgram: union if-expression arm is not a block")
}

// Emit the `null` value of function `fnIx`'s nullable return rep, leaving it on the
// stack as the function's result (the fall-through path's implicit `return null`). Each
// arm mirrors the `NullLit` lowering for that rep; an unsupported rep fails loudly.
export function emitNullForRet(_body: i32[], fnIx: i32) {
  const fn = P.nodes[fnIx]
  if !(fn is FuncDecl) { return emitFail("emitNullForRet: not a function") }
  const r = fn.fnRet
  if tyIsNulBool(r) {
    fbI32Const(2)
    return 0
  }
  if retNulStringFlag(r) == 1 {
    wU8(208) // 0xd0 ref.null
    wSLEB(sTypeIdx)
    return 0
  }
  if retNulRefFlag(r) == 1 {
    // D911 — the `??` merge redirect, on the fall-through null: an empty callee body has
    // no returned value to move, so its whole result is this `ref.null`, which at the
    // narrow row is `(ref null $narrow)` under a `(result (ref null $merged))`.
    let rsi = retNulRefIndex(r)
    if anonLeafRetMovedOf(fnIx) { rsi = anonLeafSupersedeOf(rsi) }
    if rsi >= 0 && rsi < sHeapIdx.length {
      wU8(208) // 0xd0 ref.null
      wSLEB(sHeapIdx[rsi])
      return 0
    }
  }
  if retNulMapFlag(r) == 1 {
    wU8(208) // 0xd0 ref.null — the nullable map struct
    wSLEB(mapTypeIdxOf(mapAnnShape(r)))
    return 0
  }
  if retNulListFlag(r) == 1 {
    wU8(208) // 0xd0 ref.null
    wSLEB(lTypeIdx)
    return 0
  }
  // A nullable ref-array return (`<ref-array> | null`, kind 18): the niche `ref.null $wrapper` over
  // the inner ref-list element wrapper (`tyAnnRefListSlot` strips the `| null` to resolve the slot).
  if retNulRefArrFlag(r) == 1 {
    const rls = tyAnnRefListSlot(r)
    if rls >= 0 && rls < rlWrapIdx.length {
      wU8(208) // 0xd0 ref.null
      wSLEB(rlWrapIdx[rls])
      return 0
    }
  }
  // A nullable-closure return (`((i32) => i32) | null`): the niche `ref.null $cloStruct`.
  if nulCloFlag(r) == 1 {
    wU8(208) // 0xd0 ref.null
    wSLEB(cloStructIdx)
    return 0
  }
  // Value-union box (annotated `i32 | null`, or an inferred return widened to it): the
  // null-tagged box `{ tag: null, payload: ref.null }` — identical to `emitUnionCoerce`'s
  // bare-`null` path.
  let isU = false
  if retUnionFlag(r) == 1 { isU = true }
  if r < 0 {
    const inm = inferRetNameOf(fn.fnName)
    if isValueUnionOfSet(msSetOfText(inm), inm) { isU = true }
  }
  if isU {
    fbI32Const(nullBoxTag())
    fbRefNullNone() // payload slot unread under the null tag
    fbStructNew(uBoxIdx)
    return 0
  }
  // Inferred NICHE nullable (un-annotated `boolean | null` / `string | null`): same null
  // rep as the annotated niche, recognized by name (no `fn.fnRet` node to read).
  if r < 0 {
    const nn = inferNicheNullByName(fn.fnName)
    if nn == "boolean|null" {
      fbI32Const(2)
      return 0
    }
    if nn == "string|null" {
      wU8(208) // 0xd0 ref.null
      wSLEB(sTypeIdx)
      return 0
    }
  }
  emitFail("emitNullForRet: unsupported nullable return rep")
}

// Lower a single statement at `stmtIx` onto `body`, resolving identifiers/params
// against function `fnIx`. Returns 0, or -1 (via `emitFail`) on an unsupported shape.
export function emitStmt(body: i32[], stmtIx: i32, fnIx: i32) {
  // stop after a recorded failure: `emitFail` banks the first message and returns -1, but
  // does not halt the pass, so a caller that drops the -1 keeps emitting over invalidated
  // state — the next unguarded parallel-table read then traps the compiler before the
  // diagnostic prints. Checking the flag at the two recursion roots makes it terminal.
  if emitFailed { return -1 }
  if stmtIx < 0 { return emitFail("emitProgram: missing statement") }
  const s = P.nodes[stmtIx]
  if s is FuncDecl {
    // a nested function declaration statement (`function add(x) x + n`) is lifted to a
    // top-level wasm function by `collectFns`, so it emits no inline code here — just a
    // no-op in its enclosing body. Its name resolves as a closure value when referenced.
    return 0
  }
  // D1045 — a body-scoped `type` declaration, one statement over: the parser hoisted the
  // node into `progStmts`, so every registry needing it comes from the top-level walk, and
  // the declaration emits no inline code here. Not a value, so `stmtIsTailValue` never claims it either.
  if s is TypeDecl { return 0 }
  if s is UnionDecl { return 0 }
  if s is LetDecl { return emitLetDeclStmt(body, s, stmtIx, fnIx) }
  if s is BinExpr {
    // A bare `BinExpr` statement is an assignment (`x = <expr>`); any OTHER operator
    // in statement position is a DISCARDED value (`1 + 1` as a tail statement of a
    // void function) — evaluate it for effect, then `drop` the value it leaves.
    if s.binOp == "=" { return emitAssign(body, stmtIx, fnIx) }
    if emitExpr(body, stmtIx, fnIx) < 0 { return -1 }
    fbDrop() // 0x1a drop
    return 0
  }
  if s is Unary {
    // postfix `x++`/`x--` in statement position: the old-value result is discarded, so
    // emit just the inner increment assignment — the same bytes a plain assignment
    // statement writes. A prefix unary leaves a value instead, falling through below.
    if s.unOp == "p+" || s.unOp == "p-" {
      return emitAssign(body, s.unArg, fnIx)
    }
  }
  if s is Call { return emitCallStmt(body, s, stmtIx, fnIx) }
  if s is RetStmt {
    if s.retArg < 0 {
      // a bare `return` is the ordinary early exit of a void function. `fRetVoid` is read
      // position-keyed through `fnStmtsPosOf`, the channel `emitFuncCode`'s void fall-through reads.
      const rPos = fnStmtsPosOf(fnIx)
      if rPos >= 0 {
        if fRetVoid[rPos] == 1 {
          fbReturn() // 0x0f return
          return 0
        }
      }
      // The floor, and no check-clean program reaches it: the checker pins a body holding a
      // bare `return` to void, at the annotated spelling and the inferred one alike, so a
      // non-void function carrying one is refused before emit (D1600).
      return emitFail(
        "emitProgram: a bare `return` in a function the emitter classified non-void — the checker owed this diagnosis",
      )
    }
    // void-context discard, the explicit-return leg: a `return <expr>` inside a void
    // function evaluates the expression for effect and returns nothing. Reached only by a
    // `synthVoidTwins` twin lowering a checker-valid non-void body under a void functype.
    // Routed through `emitStmt` so the statement ladder decides per shape what is on the stack.
    const rvPos = fnStmtsPosOf(fnIx)
    if rvPos >= 0 && rvPos < fRetVoid.length {
      if fRetVoid[rvPos] == 1 {
        if emitStmt(body, s.retArg, fnIx) < 0 { return -1 }
        fbReturn() // 0x0f return (void: nothing pushed)
        return 0
      }
    }
    // Seed the return context + emit the value (struct / list / union / nullable /
    // widening) and terminate the exit, via the shared helper.
    return emitReturnExit(body, s.retArg, fnIx)
  }
  if s is IfStmt { return emitIfStmtStmt(body, s, stmtIx, fnIx) }
  if s is WhileStmt { return emitWhileStmtStmt(body, s, stmtIx, fnIx) }
  if s is ForRange { return emitForRangeStmt(body, s, stmtIx, fnIx) }
  if s is ForIn { return emitForInStmt(body, s, stmtIx, fnIx) }
  if s is BreakStmt { return emitBreakStmtStmt(body, s, stmtIx, fnIx) }
  if s is ContinueStmt { return emitContinueStmtStmt(body, s, stmtIx, fnIx) }
  // a bare value expression in non-tail statement position is a discarded value: evaluate
  // it for effect, then drop what it leaves — the same rule the `BinExpr` arm above applies
  // to `1 + 1`, reached through `stmtIsTailValue`. The tail statement of a body never
  // arrives here: `emitFuncBody`/`emitStmtTail` route a tail value to `emitReturnExit` first.
  if stmtIsTailValue(stmtIx, fnIx) {
    if emitExpr(body, stmtIx, fnIx) < 0 { return -1 }
    fbDrop() // 0x1a drop
    return 0
  }
  emitFail("emitProgram: unsupported statement in body")
}

function emitLetDeclStmt(body: i32[], s: LetDecl, stmtIx: i32, fnIx: i32) {
  // `let x = <expr>` / `const x = <expr>`: emit the init, then store it into the local's
  // slot. This `LetDecl`'s slot is the next cursor position, not name-resolved (a name
  // lookup would hit an outer same-named binding still in scope here).
  const slot = emitLetCursor
  emitLetCursor = emitLetCursor + 1
  let paramN = 0
  // The START function (`fnIx == -1`, top-level statements) has no params — and no
  // arena node to read, so the lookup must be guarded.
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl { paramN = fn.fnParams.length + envSlotShift(fnIx) }
  }
  const idx = paramN + slot
  if s.letInit < 0 {
    // UNINITIALIZED scalar local (validated by `checkLocalI32`): nothing to store
    // — the wasm local's implicit zero-init covers the declaration; bind the name
    // so later reads/writes resolve to this slot.
    scopeBind(s.letName, slot)
    return 0
  }
  // value-flow monomorphization: a `const g = f` binding to a generic named function, used
  // only as a direct-call callee, is sound — `monomorphize` rewrote each `g(args)` to its
  // per-call instance, so the closure stored here is `call_ref`'d only at the pinned type.
  // Requires a pinning call site (`monoInstantiatedAny`); with none, the floor's loud reject applies instead.
  if fnIx >= 0 {
    const aliasFe = fieldValueFeOf(s.letInit)
    if fnHasUnannotatedParam(aliasFe) {
      if !criFnIsAnonLambda(aliasFe) {
        if monoInstantiatedAny(aliasFe) {
          const encl = P.nodes[fnIx]
          if encl is FuncDecl {
            if !nameUsedAsValueIn(s.letName, encl.fnBody) {
              if emitClosureValueCore(body, aliasFe, fnIx) < 0 { return -1 }
              fbLocalSet(idx) // 0x21 local.set
              scopeBind(s.letName, slot)
              return 0
            }
          }
        }
      }
    }
  }
  // a degenerate un-annotated `let x = null` (A-infer-null): when no later assignment fills
  // the hole, the binding's type is the plain `null` type, and its value is `ref.null none`
  // (D1576), not a zero i32. A filled hole (`x = 5` later) is a `T | null` value-union
  // binding (kind 4) and takes the union-coerce path below.
  if letIsNulNone(stmtIx, fnIx) {
    fbRefNullNone()
    fbLocalSet(idx) // 0x21 local.set
    scopeBind(s.letName, slot)
    return 0
  }
  // Asked BEFORE the init ladder below: an init carrying its own `if` pushes and pops the
  // narrowing stack, and this boundary's question is about the value it receives. Consumed
  // beside the two widen sites at the very bottom (D1031).
  const letArmOwed = narrowedArmNeedsUnbox(s.letInit, fnIx)
  // An empty `[]` initializer over a ref-array annotation (`let xs: T[] = []`) needs
  // the element kind to pick the ref-list construction — record it for `emitArr`. An
  // un-annotated one takes its destination's instead (D381), and `letRefListSlot` is the
  // cell half that must agree.
  const letLb = letListBuild(stmtIx, fnIx)
  pendingListKind = letLb.lbKind
  pendingListSlot = letLb.lbSlot
  // a kind-18 nullable ref-array binding: the list seeds above build the non-null list,
  // this seeds the null arm — the #964 seed-leak gate at the binding boundary.
  if localIsRef[slot] == "nulreflist" {
    if pendingListSlot >= 0 && pendingListSlot < rlWrapIdx.length {
      const nraInit = P.nodes[unwrapParen(s.letInit)]
      if nraInit is NullLit { pendingNulRefHeap = rlWrapIdx[pendingListSlot] }
    }
  }
  // A kind-15 nullable i32-list binding (`i32[] | null = null`): a bare `null` init lowers as
  // `ref.null $lTypeIdx` (the `pendingNulList` arm), the scalar-list analogue of the kind-18 seed above.
  // Without this a literal `= null` init fell through to the bare-null error (the type/narrowing worked,
  // but an actual null value never lowered).
  const letNulList15 = localIsRef[slot] == "nullist"
  // an un-annotated empty `[]` whose usage pins a string element (`const out = [];
  // out.push(self[i])`): seed the string-list kind matching the slot `collectLocals`
  // typed, else the inferred `[]` defaults to the i32 list and the slot store mismatches.
  if pendingListKind == 0 && letInfStrListByUseV(stmtIx, fnIx) {
    pendingListKind = 3
  }
  // a `let b: B = { … }` struct literal must build the annotation's struct, not a
  // first-field-name match — seed `pendingStructIdx` from the annotation when it names a
  // standalone struct. A union annotation names none, so a variant literal still boxes.
  pendingStructIdx = letAnnStructIdx(stmtIx)
  // A NULLABLE-struct binding (`let b: P | null = …`, slot kind 9) seeds the SAME struct
  // context from the slot's recorded struct index — a bare `null` init lowers as
  // `ref.null $P` (the union annotation names no `sNames` entry, so `letAnnStructIdx`
  // gave -1), a struct literal builds that struct. Mirrors the kind-9 global cell's seeding.
  if pendingStructIdx < 0 {
    if localIsRef[slot] == "nulstruct" {
      pendingStructIdx = localStructIdx[slot]
    }
  }
  // A `const c: Cat = { … }` variant-typed binding seeds the VARIANT index so the object
  // literal builds the bare variant struct (kind 8) instead of boxing into the union.
  pendingVariantIdx = letAnnVariantIdx(stmtIx)
  // the slot-kind twin of `letAnnVariantIdx`, exactly as `nulstruct` is `letAnnStructIdx`'s
  // twin above: the annotation is one route to a kind-8 cell and `collectLocals` is the
  // other, so a seed reading only the annotation is blind to a binding classified from its
  // init (D51). Unseeded, the literal builds a `{tag, value}` box into a variant cell — invalid wasm.
  if pendingVariantIdx < 0 {
    if localIsRef[slot] == "variant" {
      pendingVariantIdx = localStructIdx[slot]
    }
  }
  // A map-typed binding seeds the map SHAPE so a `Map()` initializer constructs
  // THIS binding's map struct (mono, or the annotation's ref-valued mv slot).
  if letIsMap(stmtIx, fnIx) { pendingMapSlot = letMapShapeOf(stmtIx, fnIx) }
  // A NULLABLE map binding (`let m: {[string]: V} | null = …`, slot kind `nulmap`): a `Map()` init
  // builds THIS map's struct (`pendingMapSlot` = the shape), and a bare `null` init lowers as
  // `ref.null $mapStruct` (`pendingNulRefHeap` = the map heap type, the generic ref-null seed). The
  // map twin of the kind-9 nulstruct seed above.
  if localIsRef[slot] == "nulmap" {
    const nmShape = nulMapShapeOf(stmtIx, fnIx)
    pendingMapSlot = nmShape
    pendingNulRefHeap = mapTypeIdxOf(nmShape)
  }
  // numeric widening at the binding boundary: an `: f64`/`: f32`/`: i64` slot coerces a
  // narrower init value; an i32-only binding keeps the bytes it had. A union-annotated
  // binding (kind 4) coerces a raw init into the box; an already-union init passes
  // through `emitUnionCoerce` unchanged.
  let letUNm = ""
  let letAnnNm = ""
  if s.letType >= 0 { letAnnNm = tyNameOf(s.letType) }
  // A filled null hole (`let x = null` + later `x = e`, A-infer-null) is its
  // inferred `T|null` value union — coerce the bare `null` init into the box.
  if (
    isUNameAB(27, letAnnNm, annRowOfNode(s.letType)) &&
    !nodeTyIsLitUnionAlias(s.letType) &&
    !nodeTyIsNulLitUnion(s.letType)
  ) {
    // a literal union reads as a union name but is an i32 atom, not a value-union box, so
    // it must not take `emitUnionCoerce` (which would `struct.new` the member) — excluded
    // via the arena's `nodeTyIsLitUnionAlias`, which also catches the nullable form the
    // name test (`nameIsLitUnionType`) cannot see for a member set carrying `null`.
    letUNm = letAnnNm
  } else if !isUNameAB(28, letAnnNm, annRowOfNode(s.letType)) {
    letUNm = nliNameOf(stmtIx)
  }
  // a nullable/value-union if-expression init lowers by writing the binding's own local
  // in each arm of a void `if` — no value-typed-if blocktype needed, since the binding
  // local is the destination. The slot kind `collectLocals` chose is the authoritative
  // rep: kind 4 the value-union box, kind 16 a `string | null` ref, kind 17 a `boolean | null` niche i32.
  if exprIsIfStmt(s.letInit) {
    const slotKind = localIsRef[slot]
    let nulRep = -1
    let nulNm = ""
    if slotKind == "union" {
      if letUNm != "" { nulNm = letUNm }
      else if s.letType >= 0 { nulNm = tyNameOf(s.letType) }
      // D969 — an un-annotated binding has no name to box with: with neither annotation
      // source, `nulNm` stayed "" and this arm declined, so the init fell to the generic
      // emit's scalar-ladder join blocktype over two ref arms — invalid wasm. The init's
      // own union name is asked last, so no annotated spelling changes.
      if nulNm == "" { nulNm = unionNameOfExpr(s.letInit, fnIx) }
      if nulNm != "" { nulRep = 0 }
    } else if slotKind == "nulstr" {
      nulRep = 1
    } else if slotKind == "nulbool" {
      nulRep = 2
    }
    if nulRep >= 0 {
      // the binding sink: with every arm writing the shared pair and ONE `struct.new`
      // after the `if`, the arms' construction sites collapse to that one — and the
      // pre-seed below goes with them, because the single store dominates every read.
      if nulRep == 0 && fnUsesUnionLetSink {
        if unionIfBindingAllBox(s.letInit, fnIx) {
          if emitUnionIfBindingSink(body, s.letInit, idx, nulNm, fnIx) < 0 {
            return -1
          }
          fbLocalGet(unionSinkBase)
          fbLocalGet(unionSinkBase + 1)
          fbStructNew(uBoxIdx) // the binding's ONE box
          fbLocalSet(idx)
          scopeBind(s.letName, slot)
          return 0
        }
      }
      // the value-union box local (kind 4) is a non-null `(ref $uBoxIdx)` — non-
      // defaultable, so the validator needs it definitely assigned before a void-`if`
      // merge; pre-seed the rep's null first. `string | null` is defaultable and needs none.
      if nulRep == 0 {
        if emitNulNullToLocal(body, idx, 0) < 0 { return -1 }
      }
      if (
        emitNullableIfBinding(body, s.letInit, idx, nulRep, nulNm, fnIx) <
        0
      ) {
        return -1
      }
      scopeBind(s.letName, slot)
      return 0
    }
  }
  if localIsRef[slot] == "nulclosure" {
    // a nullable function-value binding: the slot is `(ref null $cloStruct)`. A bare
    // `null` init lowers as `ref.null $cloStruct`; a function init stores its closure
    // ref directly. Takes priority over the union-coerce path, since this is a niche
    // nullable ref, not a box.
    const ncCtx = expCtxForCell(localIsRef[slot])
    if emitExprExpect(body, s.letInit, fnIx, ncCtx) < 0 { return -1 }
  } else if isNulScalarListKind(localIsRef[slot]) {
    // A DISTINCT-backing nullable scalar list binding (`string[]|null`, `f64[]|null`,
    // `i64[]|null`, `f32[]|null`): a bare `null` init lowers as `ref.null $wrapper`
    // (`nulRefHeap`), a list value builds the leaf list (`listKind`) which subtypes the
    // nullable slot. Priority over the union-coerce path (the niche is not a box).
    const nslCtx = expCtxForCell(localIsRef[slot])
    if emitExprExpect(body, s.letInit, fnIx, nslCtx) < 0 { return -1 }
  } else if (
    localIsRef[slot] == "union" &&
    letNulMapReadUnionBox(stmtIx, fnIx)
  ) {
    // A bare `const t = m[k]` read of a UNION-valued map (kind 2): the binding is the
    // established `A | B | null` box local — hit loads the stored box, miss synthesizes
    // the null-tagged box (`emitMapGetUnionBox`). The init is the Index the classifier
    // resolved; read its receiver/key here.
    const umr = P.nodes[unwrapParen(s.letInit)]
    if umr is Index {
      if emitMapGetUnionBox(body, umr.idxArr, umr.idxIndex, fnIx) < 0 {
        return -1
      }
    } else {
      return emitFail(
        "emitProgram: union-valued map read binding's init is not an index read",
      )
    }
  } else if letUNm != "" {
    // The binding boundary is a box-typed destination, so an init that is one ARM of the union
    // boxes here exactly as an argument does (D1606) — `emitUnionCoerce` alone passes an arm
    // value raw, which fits only a variant cell, and a union annotation never types one.
    let letArmBoxed = 0
    if localIsRef[slot] == "union" {
      letArmBoxed = emitUnionArmValueBox(body, s.letInit, fnIx)
      if letArmBoxed < 0 { return -1 }
    }
    if letArmBoxed == 0 {
      if emitUnionCoerce(body, letUNm, s.letInit, fnIx) < 0 { return -1 }
    }
  } else if letIsF32(stmtIx) || letInfersF32(stmtIx, fnIx) {
    // `letIsF32` is annotation-only; `collectLocals` types the slot with `letIsF32 ||
    // letInfersF32`, so an un-annotated `const g = fv * 1.0` needs the same pair here —
    // else this ladder falls to the f64 arm, whose fallback over-claims a mixed
    // f32/float-literal init and stores an f64 into the f32 slot, invalid wasm.
    const savedF32 = pendingF32
    pendingF32 = true
    if emitExprAsF32(body, s.letInit, fnIx) < 0 { return -1 }
    pendingF32 = savedF32
  } else if letIsF64(stmtIx, fnIx) {
    if emitExprAsF64(body, s.letInit, fnIx) < 0 { return -1 }
  } else if letIsI64(stmtIx, fnIx) {
    if emitExprAsI64(body, s.letInit, fnIx) < 0 { return -1 }
  } else if letAnnNm == "string" && exprIsLitAtom(s.letInit, fnIx) {
    // A literal-union atom initializing a `string` local widens to its member string.
    if emitAtomToStr(body, s.letInit, fnIx) < 0 { return -1 }
  } else if letIsNulString(stmtIx, fnIx) && exprIsLitAtom(s.letInit, fnIx) {
    // a literal-union atom initializing a `string | null` binding widens to its member
    // string: the slot is the nullable string reference and the atom's rep is an i32 id.
    // The non-nullable form needs no arm: `collectLocals` classifies a non-nullable atom
    // init as an atom slot, so nothing widens at the init and each read widens instead.
    if emitStrValue(body, s.letInit, fnIx) < 0 { return -1 }
  } else {
    // A NICHE `X | null` binding seeds its null rep for a bare `null` init (the table at
    // `emitNullLitNode`). Keyed on `letNulBool`/`letIsNulString` rather than the annotation
    // alone, so an INFERRED niche binding (`const r = f()` where `f` returns `boolean |
    // null`) seeds it too.
    pendingNulBool = letNulBool(stmtIx, fnIx)
    pendingNulString = letIsNulString(stmtIx, fnIx)
    if s.letType >= 0 {
      if nodeTyIsLitUnionAlias(s.letType) { pendingLitUnion = 1 }
      // an atom-array annotation (`const xs: K[]`) — the let twin of `emitObj`'s
      // `sFieldIsLitUnionArray` arm: the value is the i32 list of atom ids, so the atom
      // context must reach the literal, paired with the `K[]` reject in `letIsStringArray`
      // so the slot and the literal build agree (#1852). A non-literal init is unaffected.
      if tyIsLitUnionArray(nodeTyIxOf(s.letType)) { pendingLitUnion = 1 }
      // `K | null` is dual-natured — a member init is an atom id, only a `null` is the
      // sentinel — so seed BOTH, as the param-arg / return boundaries do.
      if nodeTyIsNulLitUnion(s.letType) {
        pendingLitUnion = 1
        pendingNulLitUnion = true
      }
    }
    const savedNulList = pendingNulList
    if letNulList15 { pendingNulList = true }
    if emitExpr(body, s.letInit, fnIx) < 0 { return -1 }
    pendingNulBool = false
    pendingNulString = false
    pendingNulList = savedNulList
    pendingLitUnion = 0
    pendingNulLitUnion = false
  }
  pendingI64 = false
  pendingStructIdx = -1
  pendingVariantIdx = -1
  pendingListKind = 0
  pendingListSlot = 0
  pendingMapSlot = -1
  pendingNulRefHeap = -1
  // read-only covariance at the BINDING boundary (D791): the value on the stack is a
  // ref list at one row and this binding's cell is another. `const b: Shape[] = a` over
  // a `Circle[]` — D773's witness — is `vl check` rc 0 and INVALID WASM on master, and
  // `emitRefListWidenSite` converts it where the copy is unobservable.
  if localIsRef[slot] == "reflist" {
    emitRefListWidenSite(
      body,
      s.letInit,
      exprEmittedRefListSlot(s.letInit, fnIx),
      localStructIdx[slot],
    )
  }
  // the scalar dual (D965) — `const b: f64[] = e` over an `i32[]`. The cell's own kind IS
  // the destination list kind, so this needs no second derivation.
  emitScalarListWidenSite(body, s.letInit, fnIx, localIsRef[slot])
  // the narrowed-arm unbox at the binding boundary (D1031): the same shape as the two
  // widen sites above, since the cell's own (kind, slot) pair is the destination.
  // `letArmOwed` is taken before the init emits, since an init carrying its own `if`
  // moves the narrowing stack.
  if letArmOwed {
    const letArmHeap = armDestHeapOf(localIsRef[slot], localStructIdx[slot])
    if letArmHeap >= 0 { emitNarrowedArmUnboxTo(letArmHeap) }
  }
  // the nullable-niche recover at the BINDING boundary (D1115) — `const z: i32[] = y` under
  // `if y != null`. The cell's own kind is the destination, exactly as the two widen sites
  // above read it.
  if nulNicheRecoverOwed(localIsRef[slot], s.letInit, fnIx) { fbRefAsNonNull() }
  fbLocalSet(idx) // 0x21 local.set
  // Bind `name → slot` in the current emit-time frame AFTER emitting the init (so the
  // init resolved any same-named OUTER binding), making this binding live for the rest
  // of the block — mirrors the collect pass so resolution matches slot allocation.
  scopeBind(s.letName, slot)
  return 0
}

function emitCallStmt(body: i32[], s: Call, stmtIx: i32, fnIx: i32) {
  // The only call STATEMENT this slice lowers is a list append `recv.push(x)` (a
  // `Call` whose `callFn` is a `Member`). A bare top-level call statement (a function
  // call whose value is discarded) is out of scope.
  const callee = P.nodes[s.callFn]
  if callee is Member {
    // A `.push` STATEMENT discards the new length — emit the append with no value (D1592),
    // rather than emitting one and dropping it.
    if callee.memProp == "push" { return emitPush(body, stmtIx, fnIx, false) }
    // A `.pop()` STATEMENT discards the popped element — emit the pop, then `drop`
    // the value it leaves on the stack.
    if callee.memProp == "pop" {
      if popRecvIsList(callee.memObj, fnIx) {
        if emitPop(body, stmtIx, fnIx, false, -1) < 0 { return -1 }
        fbDrop() // 0x1a drop
        return 0
      }
    }
    // a `.clear()` statement resets the list's length to 0 (backing retained). The gate
    // carries the scalar reps alongside the i32/ref/string ones, so a `u8[]`/`i64[]`/
    // `f64[]`/`f32[]` receiver reaches `emitClear` too, matching `.pop`'s coverage via `emitPop`.
    if callee.memProp == "clear" {
      if (
        exprArray(callee.memObj, fnIx) ||
        exprRefArray(callee.memObj, fnIx) ||
        exprStringArray(callee.memObj, fnIx) ||
        scalarListElemKind(callee.memObj, fnIx) != null
      ) {
        return emitClear(body, stmtIx, fnIx)
      }
    }
    // G8: a map `m.set(k, v)` STATEMENT is the method form of `m[k] = v` — the
    // same scan/overwrite-or-append lowering.
    if callee.memProp == "set" {
      if exprMap(callee.memObj, fnIx) {
        if s.callArgs.length != 2 {
          return emitFail("emitProgram: map set takes exactly two arguments")
        }
        return emitMapSet(
          body,
          callee.memObj,
          s.callArgs[0],
          s.callArgs[1],
          fnIx,
        )
      }
    }
    // A Set `s.add(k)` STATEMENT is the membership-insert form of `s[k] = true` — the
    // SAME scan/overwrite-or-append lowering as `emitMapSet`, but storing the constant
    // boolean `1` (true) as the value (the Set vals-list carries true for live keys).
    // It takes EXACTLY one arg; the result (if any) is discarded.
    if callee.memProp == "add" {
      if exprMap(callee.memObj, fnIx) {
        if s.callArgs.length != 1 {
          return emitFail("emitProgram: set add takes exactly one argument")
        }
        return emitMapSetV(body, callee.memObj, s.callArgs[0], -1, fnIx, true)
      }
    }
    // G8: a bare `m.delete(k)` STATEMENT discards the boolean result — emit the
    // delete, then `drop` the 0/1 it leaves on the stack.
    if callee.memProp == "delete" {
      if exprMap(callee.memObj, fnIx) {
        if s.callArgs.length != 1 {
          return emitFail("emitProgram: map delete takes exactly one argument")
        }
        if emitMapDelete(body, callee.memObj, s.callArgs[0], fnIx) < 0 {
          return -1
        }
        fbDrop() // 0x1a drop (discard the boolean result)
        return 0
      }
    }
    // A closure-field member call STATEMENT (`(o."[]=")(k, v)` — the rewritten
    // index WRITE trap, or any function-valued field invoked for effect):
    // `call_ref` it; drop the result unless the field's function is void.
    if exprIsClosure(s.callFn, fnIx) {
      if emitCallRef(body, stmtIx, fnIx) < 0 { return -1 }
      // the drop decision follows the sig the call resolved (`cloCallSigKey`): a `>v`
      // key leaves nothing on the stack, so dropping is invalid wasm regardless of the
      // field's rep function. Asked first, since the rep-function fallback is wrong
      // exactly when the two disagree.
      let mcVoid = sigKeyRetIsVoid(cloCallSigKey(stmtIx, fnIx))
      if !mcVoid {
        const mcFe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
        if mcFe >= 0 {
          if fRetVoid[mcFe] == 1 { mcVoid = true }
        }
      }
      if !mcVoid {
        fbDrop() // 0x1a drop (discard the unused result)
      }
      return 0
    }
    // D1240 — a member call no mutator arm claimed is a discarded value, the same rule
    // the `Ident` arm below applies to `f(…)`. General rather than a per-method gate:
    // `xs.slice(0, 2)` has an expression form but the statement ladder had no route to it.
    if emitExpr(body, stmtIx, fnIx) < 0 { return -1 }
    if memberCallYieldsValue(stmtIx) {
      fbDrop() // 0x1a drop
    }
    return 0
  }
  if callee is Ident {
    // A bare call whose RESULT is discarded (a helper invoked for its side
    // effects): emit the call, then `drop` the value it leaves — EXCEPT `print`
    // (a void import) and a VOID function (`()->()` leaves nothing).
    if emitCall(body, stmtIx, fnIx) < 0 { return -1 }
    let dropIt = callee.identName != "print"
    // The void memory intrinsics leave nothing on the stack.
    if callee.identName == "__store_i32__" { dropIt = false }
    if nameIsMemStoreIntrinsic(callee.identName) { dropIt = false }
    if nameIsMemBulkIntrinsic(callee.identName) { dropIt = false }
    if callee.identName == "__log__" { dropIt = false }
    // The void array intrinsics: `__array_copy__` leaves nothing; `__trap__`
    // is `unreachable` (no value reaches the drop).
    if callee.identName == "__array_copy__" { dropIt = false }
    if callee.identName == "__trap__" { dropIt = false }
    if dropIt {
      // A name a closure binding covers denotes that binding, so the void question is the
      // closure's — the module function of the name lowered no instruction here (D1602).
      let vt = fnIndexOfSid(sidOfNode(s.callFn))
      if vt >= 0 && identIsBoundClosure(callee.identName, fnIx) { vt = -1 }
      if vt >= 0 {
        if fRetVoid[vt] == 1 { dropIt = false }
      } else if calleeReturnsVoid(callee.identName, fnIx) {
        // A closure-VALUE callee (a param / binding, invisible to `fnIndexOf`) whose
        // `$fnsig` is void leaves nothing — no `drop`.
        dropIt = false
      }
    }
    if dropIt {
      fbDrop() // 0x1a drop
    }
    return 0
  }
  return emitFail("emitProgram: bare call statement is not supported")
}

// The compile-time value of an `if` condition that is a monomorphized-instance guard
// testing an inline struct shape (1/0), or -1 otherwise — narrower than `emitIs`'s static
// path: the receiver must be a bare ident, the tested name a whole-span `{…}` shape, and
// neither a literal variant name nor a nullable-struct receiver (both are runtime tests).
function monoStaticIsGuardOf(condIx: i32, fnIx: i32) {
  const c = P.nodes[condIx]
  if c is IsExpr {
    const recv = P.nodes[unwrapParen(c.isObj)]
    if !(recv is Ident) { return -1 }
    if isLitVariantName(c.isVariant) { return -1 }
    if !nameIsWholeSpanShape(c.isVariant) { return -1 }
    if exprNullableStruct(c.isObj, fnIx) { return -1 }
    return monoStaticIsResult(condIx, fnIx)
  }
  -1
}

// D932 — the `emitLetCursor` positions that emitting the subtree at `ix` would consume. A
// dead-arm skip is a control-flow change the locals layout never hears about, since
// `collectLocals` allocates slots in pre-order over the whole body; every skip below must
// advance the cursor by this count. A `FuncDecl` subtree contributes nothing — its own body owns its own frame.
function cursorSlotsUnder(ix: i32): i32 {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is FuncDecl { return 0 }
  let cnt = 0
  if n is LetDecl { cnt = 1 }
  if n is ForRange { cnt = 2 }
  if n is ForIn { cnt = 3 }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    cnt = cnt + cursorSlotsUnder(kids[i])
    i = i + 1
  }
  cnt
}

// D932 — did the condition emitted since `condStart` fold to a constant? 1/0, or -1
// for any runtime test. Read off the bytes the module actually carries, not a parallel
// predicate — a second derivation of "did it fold" is exactly the drift that let
// `monoStaticIsResult`'s direct answer disagree with the emitted condition.
function emittedCondConst(condStart: i32): i32 {
  if wLen() != condStart + 2 { return -1 }
  if wPeekBack(1) != 65 {
    return -1 // 0x41 i32.const
  }
  const cb = wPeekBack(0)
  if cb == 0 { return 0 }
  if cb == 1 { return 1 }
  -1
}

// The dual of `emitIfStmtStmt`'s dead-arm skip: a statement `if` whose mono-instance
// `is` guard is statically true and whose then-branch always returns ends the block for
// this instance, since everything after it is typed against other instances' bindings
// and generally unable to lower. The caller pads with `unreachable` to stay stack-polymorphic.
function monoStaticGuardEndsBlock(stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  if s is IfStmt {
    if monoStaticIsGuardOf(s.ifCond, fnIx) != 1 { return false }
    return blockAlwaysReturns(s.ifThen)
  }
  false
}

function emitIfStmtStmt(body: i32[], s: IfStmt, _stmtIx: i32, fnIx: i32) {
  // structured void `if`: push the i32 condition, then `if`/`else`/`end`. A
  // monomorphized-instance `is` guard is decided at compile time, so one arm can be
  // provably unreachable in this instance and is emitted empty instead (D932) — read
  // off the emitted condition itself (`emittedCondConst`), not a parallel predicate.
  const condStart = wLen()
  if emitExpr(body, s.ifCond, fnIx) < 0 { return -1 }
  let staticGuard = -1
  const condN = P.nodes[unwrapParen(s.ifCond)]
  if condN is IsExpr { staticGuard = emittedCondConst(condStart) }
  fbIf(64) // 0x04 if, 0x40 void blocktype
  // The `if` opens ONE control frame (the `else` reuses it, `end` closes it), so a
  // `break`/`continue` nested in either arm sees the right relative `br` depth.
  ctrlEnter()
  // If the condition is `n is Variant` over a bare union identifier, narrow `n` to
  // that variant for the THEN-branch only (so `n.field` downcasts). Save/restore the
  // outer narrowing around the branch so nesting and the else-branch are unaffected.
  const savedTop = narrowTop
  const narrowed = setNarrowFromCond(s.ifCond, fnIx)
  if staticGuard != 0 {
    if emitStmts(body, s.ifThen, fnIx) < 0 { return -1 }
  } else {
    // D932 — the skipped arm's `let`s still own their collect-allocated slots.
    emitLetCursor = emitLetCursor + cursorSlotsUnder(s.ifThen)
  }
  if narrowed { restoreNarrow(savedTop) }
  if s.ifElse >= 0 && staticGuard != 1 {
    fbElse() // 0x05 else
    // the else may be a Block or a nested IfStmt (`else if`); both go through
    // `emitStmt`. The then narrowing does not hold in the else-branch, where the guard
    // is false: a value union narrows to the complement set instead (`is T` removes `T`).
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    const els = P.nodes[s.ifElse]
    if els is Block {
      if emitStmts(body, s.ifElse, fnIx) < 0 { return -1 }
    } else {
      if emitStmt(body, s.ifElse, fnIx) < 0 { return -1 }
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
  } else if s.ifElse >= 0 {
    // D932 — the statically-dead else arm, same slot accounting as the then skip.
    emitLetCursor = emitLetCursor + cursorSlotsUnder(s.ifElse)
  }
  fbEnd() // 0x0b end
  ctrlLeave()
  return 0
}

function emitWhileStmtStmt(body: i32[], s: WhileStmt, _stmtIx: i32, fnIx: i32) {
  // structured while loop: block (void) wrapping a loop (void). The condition is
  // checked at the top; if false, exit the block; otherwise run the body then continue
  // the loop. Track the two control frames so break/continue compute their relative br
  // depth. The list-header hoists open before the block, since a loop that never iterates leaves them unread.
  const whHoist = loopHoistOpen(body, s.whileCond, s.whileBody, fnIx, "")
  if whHoist < 0 { return -1 }
  fbBlock(64) // 0x02 block, 0x40 void blocktype
  ctrlEnter()
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.whileLabel)
  fbLoop(64)  // 0x03 loop, 0x40 void blocktype
  ctrlEnter()
  loopContDepth.push(ctrlDepth)
  loopContLabel.push(s.whileLabel)
  // condition + eqz: if condition is false (zero), exit block
  if emitExpr(body, s.whileCond, fnIx) < 0 { return -1 }
  fbI32Eqz() // 0x45 i32.eqz (invert: exit if condition was false)
  fbBrIf(1)  // 0x0d br_if, depth 1 = break out of block
  // the body is a narrowing scope (the checker's `checkWhileStmtNode` narrows it): the
  // condition is re-tested every iteration, so a `while e != null { … }` body reads `e`
  // unboxed. Pushed after `loopHoistOpen`, so the once-run hoist prologue sees the
  // un-narrowed type and never reads a guarded receiver's header before the guard holds.
  const whSavedTop = narrowTop
  const whSavedStrip = narrowStripNullOnly
  narrowStripNullOnly = true
  const whNarrowed = setNarrowFromCond(s.whileCond, fnIx)
  narrowStripNullOnly = whSavedStrip
  // body statements
  if emitStmts(body, s.whileBody, fnIx) < 0 { return -1 }
  if whNarrowed { restoreNarrow(whSavedTop) }
  fbBr(0) // 0x0c br, depth 0 = continue loop
  fbEnd() // 0x0b end (loop)
  ctrlLeave()
  loopContDepth.pop()
  loopContLabel.pop()
  fbEnd() // 0x0b end (block)
  ctrlLeave()
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  loopHoistClose(whHoist)
  return 0
}

function emitForRangeStmt(body: i32[], s: ForRange, _stmtIx: i32, fnIx: i32) {
  // `for v in A to B [step K] { body }` — an inclusive numeric range, lowered to the same
  // block/loop shape as `while`. The loop var `v` and a synthetic bound temp own the next
  // two cursor slots. The step must be a constant integer literal; its sign picks the exit
  // comparison (ascending: v > bound; descending: v < bound). The bound evaluates once.
  const vSlot = emitLetCursor
  emitLetCursor = emitLetCursor + 1
  const bSlot = emitLetCursor
  emitLetCursor = emitLetCursor + 1
  let paramN = 0
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl { paramN = fn.fnParams.length + envSlotShift(fnIx) }
  }
  const vIdx = paramN + vSlot
  const bIdx = paramN + bSlot
  // static step: default +1; `step <int>` / `step -<int>`. The lexeme must fit i32 before
  // the `parseI32` fold — the checker rejects an out-of-range step upstream; this is the
  // emitter's own never-silently-wrong-bytes backstop.
  let stepK = 1
  if s.frStep >= 0 {
    const st = P.nodes[s.frStep]
    if st is NumLit {
      if numLexIsFloat(st.numText) || !numLexFitsI32(st.numText) {
        return emitFail(
          "emitProgram: for-range step must be an i32 integer literal",
        )
      }
      stepK = parseI32(st.numText)
    } else if st is Unary {
      if st.unOp == "-" {
        const inner = P.nodes[st.unArg]
        if inner is NumLit {
          if numLexIsFloat(inner.numText) || !numLexFitsI32(inner.numText) {
            return emitFail(
              "emitProgram: for-range step must be an i32 integer literal",
            )
          }
          stepK = 0 - parseI32(inner.numText)
        } else {
          return emitFail(
            "emitProgram: for-range step must be a constant integer",
          )
        }
      } else {
        return emitFail(
          "emitProgram: for-range step must be a constant integer",
        )
      }
    } else {
      return emitFail("emitProgram: for-range step must be a constant integer")
    }
  }
  if stepK == 0 {
    return emitFail("emitProgram: for-range step must not be zero")
  }
  // v = A; bound = B (each evaluated once, in source order)
  if emitExpr(body, s.frFrom, fnIx) < 0 { return -1 }
  fbLocalSet(vIdx)
  if emitExpr(body, s.frTo, fnIx) < 0 { return -1 }
  fbLocalSet(bIdx)
  // The hoist prologue runs AFTER the range bounds (whose expressions may do
  // anything) and BEFORE the loop variable is bound, so its receiver reads
  // resolve in the enclosing scope. `frVar` itself is never a candidate — the
  // body sees it as a fresh i32 binding.
  const frHoist = loopHoistOpen(body, -1, s.frBody, fnIx, s.frVar)
  if frHoist < 0 { return -1 }
  // Bind the loop var for the body (mirrors the collect pass's scopeBind).
  scopeBind(s.frVar, vSlot)
  fbBlock(64) // 0x02 block, void
  ctrlEnter()
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.frLabel)
  fbLoop(64)  // 0x03 loop, void
  ctrlEnter()
  loopContDepth.push(ctrlDepth)
  loopContLabel.push(s.frLabel)
  // continue-condition: le_s (ascending) / ge_s (descending), inverted to exit
  fbLocalGet(vIdx)
  fbLocalGet(bIdx)
  if stepK > 0 {
    fbI32Bin(76) // 0x4c i32.le_s
  } else {
    fbI32Bin(78) // 0x4e i32.ge_s
  }
  fbI32Eqz() // 0x45 invert: exit when out of range
  fbBrIf(1)  // 0x0d br_if -> break out of block
  // a body with a `continue` binding to this loop needs an inner block as the continue
  // target: branching to its end falls into the increment (a branch to the loop header
  // would skip it — an infinite loop). A body without one keeps the two-frame shape. The
  // inner block carries the loop's label too, shadowing the header entry.
  const frHasCont = blockHasContinueFor(s.frBody, s.frLabel, false)
  if frHasCont {
    fbBlock(64) // continue block
    ctrlEnter()
    loopContDepth.push(ctrlDepth)
    loopContLabel.push(s.frLabel)
  }
  if emitStmts(body, s.frBody, fnIx) < 0 { return -1 }
  if frHasCont {
    fbEnd() // end continue block — `continue` lands here
    ctrlLeave()
    loopContDepth.pop()
    loopContLabel.pop()
  }
  // v = v + K
  fbLocalGet(vIdx)
  fbI32Const(stepK)
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(vIdx)
  fbBr(0)       // continue loop
  fbEnd()       // end loop
  ctrlLeave()
  loopContDepth.pop()
  loopContLabel.pop()
  fbEnd()       // end block
  ctrlLeave()
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  loopHoistClose(frHoist)
  // The loop variable's scope is the loop (see `scopeUnbind`).
  scopeUnbind()
  return 0
}

function emitForInStmt(body: i32[], s: ForIn, _stmtIx: i32, fnIx: i32) {
  // `for v in <list> { body }` — iterate an i32 list, a string list, a struct ref list, or
  // a map's ordered keys/values list. Three cursor slots in collect pre-order: the element
  // var `v`, a hidden cursor `v#i`, and a hidden list temp `v#l` (the iterable evaluates
  // once). Shape mirrors `while`: block/loop, exit on `cursor >= len`, cursor++.
  const ek = forInElemKind(s.fiIter, fnIx)
  if ek == null { return emitFail("emitProgram: unsupported for-in iterable") }
  // A STRING iterable (`for ch in s`): the `#l` temp IS the raw `(ref $sTypeIdx)` array (no
  // list wrapper), so the length is `array.len` and each element `array.get $aTypeIdx` —
  // skipping the `struct.get wrapTy` the i32-list path uses. The loop var is an i32 code unit.
  const strSrc = forInStringSrc(s.fiIter, fnIx)
  // a packed byte-list iterable (`for b in bs`, `bs: u8[]`): the `#l` temp is the `$bl8`
  // wrapper over the one-byte backing, so length is `struct.get $bl8 1` and each element
  // `array.get_u $ba8` — `fbArrayGet` picks the unsigned opcode off the backing heap index itself.
  const u8Src = forInU8Src(s.fiIter, fnIx)
  if u8Src && !ba8Used {
    return emitFail("emitProgram: u8 for-in but u8 list type not collected")
  }
  const vSlot = emitLetCursor
  emitLetCursor = emitLetCursor + 1
  const iSlot = emitLetCursor
  emitLetCursor = emitLetCursor + 1
  const lSlot = emitLetCursor
  emitLetCursor = emitLetCursor + 1
  let paramN = 0
  if fnIx >= 0 {
    const fn = P.nodes[fnIx]
    if fn is FuncDecl { paramN = fn.fnParams.length + envSlotShift(fnIx) }
  }
  const vIdx = paramN + vSlot
  const iIdx = paramN + iSlot
  const lIdx = paramN + lSlot
  let wrapTy = lTypeIdx
  let backTy = aTypeIdx
  if ek == "str" || ek == "nulstr" {
    // `string[]` and `(string | null)[]` share one backing (`$mkList` / `$mkArr`, whose
    // element slot is nullable either way) and differ ONLY in the loop var: `str` recovers
    // each element non-null below, `nulstr` keeps the raw `(ref null $aTypeIdx)` so a null
    // element is a value the body can test rather than a trap.
    wrapTy = mkListIdx
    backTy = mkArrIdx
  } else if (
    ek == "struct" ||
    ek == "variant" ||
    ek == "union" ||
    ek == "nulstruct" ||
    ek == "list" ||
    ek == "nullist" ||
    ek == "strlist" ||
    ek == "f64list" ||
    ek == "i64list" ||
    ek == "f32list" ||
    ek == "u8list" ||
    ek == "nulstrlist" ||
    ek == "nulf64list" ||
    ek == "nuli64list" ||
    ek == "nulf32list" ||
    ek == "nulu8list" ||
    ek == "closure" ||
    ek == "reflist" ||
    ek == "nulreflist"
  ) {
    // a struct ref list, a union-box element list, a nullable-struct element list, a
    // closure element list, a nested-array scalar inner list, or a nested ref array: the
    // wrapper/backing are this ref-list slot's. All recover each element non-null except
    // the nullable niches. A struct-valued map walk reads its mv slot's vals list instead.
    const fimv = forInMapValsSlot(s.fiIter, fnIx)
    if fimv >= 0 {
      wrapTy = mvValsWrapOf(fimv)
      backTy = mvValsBackOf(fimv)
    } else {
      const rslot = refListSlotOfExpr(s.fiIter, fnIx)
      wrapTy = rlWrapIdx[rslot]
      backTy = rlBackIdx[rslot]
    }
  } else if ek == "f64" || ek == "i64" || ek == "f32" {
    // A scalar f64/i64/f32 element list: the wrapper/backing come from the descriptor, and
    // `array.get <back>` yields the scalar directly (no `ref.as_non_null`).
    wrapTy = scalarListWrap(ek)
    backTy = scalarListBack(ek)
  } else if u8Src {
    // The packed byte list — the same descriptor pair, keyed on the `#l` temp's kind rather
    // than the loop var's (which is `"i32"`, shared with the i32 list and the string walk).
    wrapTy = scalarListWrap("u8list")
    backTy = scalarListBack("u8list")
  }
  // for a map iteration, evaluate the receiver once and stash the map ref: the stash is
  // the receiver's only evaluation, so the walked list, the loop bound and the skip's
  // `M.live[cursor]` all read one object and its side effects run once. The pinned
  // `cmSlot` drives the stash local, the list field and the skip's `struct.get` type alike.
  const mapRecv = forInMapRecv(s.fiIter, fnIx)
  let mwShape = -1
  if mapRecv >= 0 {
    mwShape = mapShapeOfExpr(mapRecv, fnIx)
    mwShape = mapShapeFoldSet(mwShape)
    if pushMapRecvRef(body, mapRecv, fnIx) < 0 { return -1 }
    cmSlot = mwShape
    setMapRef(body) // mapRef
  }
  // list = <iter> (evaluated once); cursor = 0
  if emitForInList(body, s.fiIter, fnIx, mapRecv, mwShape) < 0 { return -1 }
  // A NARROWED nullable-list iterable keeps its nullable slot at EVERY element kind — the
  // i32-list niche, a distinct-backing scalar list and a ref array alike; the `#l` temp is
  // non-null, so recover first (checker-guarded). See `nulRecvNeedsRecover`.
  if nulRecvNeedsRecover(s.fiIter, fnIx) {
    wU8(212) // 0xd4 ref.as_non_null
  }
  fbLocalSet(lIdx)
  // a string source runs its cursor in backing coordinates: the `#l` temp holds the
  // header, so hoist the backing into its own slot and pre-compute the exit bound — one
  // `array.get` per code point and no `struct.get` in the loop, since binaryen is not
  // guaranteed to lift a GC `struct.get` out of a loop body.
  let fiSBack = -1
  let fiSEnd = -1
  let fiSPk = -1
  if strSrc {
    fiSBack = strBackSlot()
    fiSEnd = strI32Slot()
    // the packed `(width << 24) | cp` `__utf8_dec__` returns: the loop variable is still a
    // code point, but the stride is now data-dependent, so the width must survive the body
    // to reach the increment. Its own slot per loop, so a nested `for cp in t` cannot clobber it.
    fiSPk = strI32Slot()
    fbLocalGet(lIdx)
    fbStrBack()
    fbLocalSet(fiSBack)
    fbLocalGet(lIdx)
    fbStrStart()
    fbLocalGet(lIdx)
    fbStrLen()
    fbI32Bin(106) // 0x6a i32.add — the one-past-the-end backing offset
    fbLocalSet(fiSEnd)
    fbLocalGet(lIdx)
    fbStrStart()
  } else {
    fbI32Const(0)
  }
  fbLocalSet(iIdx)
  scopeBind(s.fiVar, vSlot)
  fbBlock(64) // 0x02 block, void
  ctrlEnter()
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.fiLabel)
  fbLoop(64)  // 0x03 loop, void
  ctrlEnter()
  loopContDepth.push(ctrlDepth)
  loopContLabel.push(s.fiLabel)
  // exit when cursor >= len (the list wrapper's field 1; a STRING compares its
  // backing-coordinate cursor against the pre-computed `start + len` bound)
  fbLocalGet(iIdx)
  if strSrc {
    fbLocalGet(fiSEnd)
  } else {
    fbLocalGet(lIdx)
    fbStructGet(wrapTy, 1)
  }
  fbI32Bin(78) // 0x4e i32.ge_s
  fbBrIf(1)    // 0x0d br_if -> break out of block
  // tombstone skip: if M.live[cursor] == 0, advance the cursor and re-loop WITHOUT
  // binding `v` / running the body — the deleted entry is invisible to iteration
  // (insertion order of the survivors preserved). `br 1` targets the loop header
  // (if-frame is 0, loop is 1). A delete-free map has live all-1s, so never taken.
  if mapRecv >= 0 {
    cmSlot = mwShape
    pushMapLive(body)    // M.live (off the pinned mapRef)
    fbLocalGet(iIdx)
    fbArrayGet(aTypeIdx) // M.live[cursor]
    fbI32Eqz()           // live[cursor] == 0 ?
    fbIf(64)             // 0x04 if, void
    fbLocalGet(iIdx)
    fbI32Const(1)
    fbI32Bin(106)        // cursor + 1
    fbLocalSet(iIdx)
    fbBr(1)              // 0x0c br -> loop header (re-check exit)
    fbEnd()              // 0x0b end (if)
  }
  // v = backing[cursor] (a string element recovers its non-null ref). A STRING source reads
  // its HOISTED backing at a cursor that is already a backing offset; the code unit is an i32.
  if strSrc {
    // pk = __utf8_dec__(backing, cursor, end) ; v = pk & 0x00ffffff
    fbLocalGet(fiSBack)
    wU8(212) // 0xd4 ref.as_non_null — the hoist slot is nullable so it stays defaultable;
    // `array.get` tolerated that, a CALL does not.
    fbLocalGet(iIdx)
    fbLocalGet(fiSEnd)
    fbCall(gHelpUtf8Dec)
    fbLocalTee(fiSPk)
    fbI32Const(16777215) // 0x00ffffff — strip the width, keep the code point
    fbI32Bin(113)        // 0x71 i32.and
  } else {
    fbLocalGet(lIdx)
    fbStructGet(wrapTy, 0)
    fbLocalGet(iIdx)
    fbArrayGet(backTy)
  }
  if (
    ek == "str" ||
    ek == "struct" ||
    ek == "variant" ||
    ek == "union" ||
    ek == "list" ||
    ek == "strlist" ||
    ek == "f64list" ||
    ek == "i64list" ||
    ek == "f32list" ||
    ek == "u8list" ||
    ek == "closure" ||
    ek == "reflist"
  ) {
    // string/struct/union-box/closure element, or a nested inner-list/ref-list wrapper: all
    // are a non-null ref recovered from the `(ref null <elem>)` slot. Every niche element
    // kind is absent on purpose, since its loop var legitimately holds null — this set and
    // `forInElemKind`'s niche arms are one decision, or a loud reject turns into invalid wasm.
    wU8(212) // 0xd4 ref.as_non_null
  }
  fbLocalSet(vIdx)
  // Same INNER continue block as for-range: `continue` must still increment.
  const fiHasCont = blockHasContinueFor(s.fiBody, s.fiLabel, false)
  if fiHasCont {
    fbBlock(64) // continue block
    ctrlEnter()
    loopContDepth.push(ctrlDepth)
    loopContLabel.push(s.fiLabel)
  }
  if emitStmts(body, s.fiBody, fnIx) < 0 { return -1 }
  if fiHasCont {
    fbEnd() // end continue block — `continue` lands here
    ctrlLeave()
    loopContDepth.pop()
    loopContLabel.pop()
  }
  // cursor = cursor + <stride>. Every source but a string strides by one element; a string
  // strides by the UTF-8 width of the sequence just decoded, parked in the high byte of
  // `fiSPk` — never 0, since an invalid lead byte decodes as a one-byte U+FFFD.
  fbLocalGet(iIdx)
  if strSrc {
    fbLocalGet(fiSPk)
    fbI32Const(24)
    fbI32Bin(118) // 0x76 i32.shr_u
  } else {
    fbI32Const(1)
  }
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(iIdx)
  fbBr(0)       // continue loop
  fbEnd()       // end loop
  ctrlLeave()
  loopContDepth.pop()
  loopContLabel.pop()
  fbEnd()       // end block
  ctrlLeave()
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  // The loop variable's scope is the loop (see `scopeUnbind`).
  scopeUnbind()
  return 0
}

function emitBreakStmtStmt(
  _body: i32[],
  s: BreakStmt,
  _stmtIx: i32,
  _fnIx: i32,
) {
  // `break [label]`: branch out of a loop's wrapping block, so control resumes after the
  // whole loop. Unlabelled targets the innermost; `break outer` scans the parallel label
  // stack from the top. A `break` outside any loop or to an unknown label fails loudly, not with a bad `br`.
  if loopBrkDepth.length == 0 {
    return emitFail("emitProgram: `break` outside a loop")
  }
  const brkAt = loopStackFind(loopBrkLabel, s.brkLabel)
  if brkAt < 0 {
    return emitFail(
      "emitProgram: `break` label does not name an enclosing loop",
    )
  }
  const blkDepth = loopBrkDepth[brkAt]
  fbBr(ctrlDepth - blkDepth) // 0x0c br to the loop's wrapping block
  return 0
}

function emitContinueStmtStmt(
  _body: i32[],
  s: ContinueStmt,
  _stmtIx: i32,
  _fnIx: i32,
) {
  // `continue [label]`: branch to a loop's continue target — the loop header for a
  // `while`, the inner continue block for a `for` (fall into the increment). Unlabelled
  // targets the innermost; `continue outer` scans the label stack from the top.
  if loopContDepth.length == 0 {
    return emitFail("emitProgram: `continue` outside a loop")
  }
  const contAt = loopStackFind(loopContLabel, s.contLabel)
  if contAt < 0 {
    return emitFail(
      "emitProgram: `continue` label does not name an enclosing loop",
    )
  }
  const loopDepth = loopContDepth[contAt]
  fbBr(ctrlDepth - loopDepth) // 0x0c br to the loop's continue target
  return 0
}

// Lower a function's top-level body block at `blockIx`: every statement but the last is
// lowered normally; if the last statement is a bare value expression, it is lowered as
// the function's return value (VL's implicit-return idiom). A last statement that is
// itself a real statement is lowered unchanged. An empty body is left to existing validation.
export function emitFuncBody(body: i32[], blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    // Which of this function's string bindings are loop accumulators. Runs here rather
    // than in `emitFuncCode` because nothing before the body needs the answer, and the
    // set is stamped with `fnIx` so a body that never scanned cannot read a stale one.
    strAccScan(blockIx, fnIx)
    // Enter the function's top-level lexical scope (mirrors `collectLocals` on the body
    // block). The emit-time scope stack drives same-named-local resolution.
    scopePush()
    const stmts = b.blkStmts
    const n = stmts.length
    // A guard `if` (no else, then-branch always returns) narrows the REST of the
    // body to the guard's complement (the host's post-early-return flow narrowing).
    const savedGuardTop = narrowTop
    // void-context discard: in a void function, a value-bearing tail is not the
    // function's result — it lowers through the ordinary statement path (`emitStmt`),
    // which evaluates it for effect and drops what it leaves. Keyed on the function's void
    // classification (`fRetVoid`), never on the tail's shape.
    let bodyIsVoid = false
    const vfPos = fnStmtsPosOf(fnIx)
    if vfPos >= 0 && vfPos < fRetVoid.length {
      if fRetVoid[vfPos] == 1 { bodyIsVoid = true }
    }
    let i = 0
    while i < n {
      const isLast = i == n - 1 && !bodyIsVoid
      if isLast && stmtIsTailValue(stmts[i], fnIx) {
        // Implicit return: seed the return context + push the value (so a trailing
        // `null` / nullable value boxes or sentinels exactly like `return e`), then
        // terminate the exit.
        if emitReturnExit(body, stmts[i], fnIx) < 0 {
          scopePop()
          return -1
        }
      } else if isLast && lastStmtIsValueIf(stmts[i], fnIx) {
        // The body ends in an `if`/`else` whose arms each yield a value (implicit
        // return) rather than `return`ing — lower it tail-aware so each arm's trailing
        // value expression becomes the function's return.
        if emitIfTail(body, stmts[i], fnIx) < 0 {
          scopePop()
          return -1
        }
      } else if isLast && memberCallYieldsValue(stmts[i]) {
        // D1240 — the tail member call of a non-void function is its result (`isLast` is
        // already gated on `!bodyIsVoid`), so it takes the same exit as any other tail
        // value — else the discard arm in `emitCallStmt` drops it under a functype that
        // promises a result, a trap where a refusal belongs.
        if emitReturnExit(body, stmts[i], fnIx) < 0 {
          scopePop()
          return -1
        }
      } else if isLast && elseLessNullableTail(stmts[i], fnIx) {
        // the body ends in an else-less `if` whose then-arm yields a value and whose
        // return type is nullable: lower it tail-aware (the then-arm returns its value);
        // the false fall-through is lowered as `null` by the function-end padding. Gated
        // on the final `fRetVoid`/nullable classification, unlike the fixpoint-feeding predicates.
        if emitIfTail(body, stmts[i], fnIx) < 0 {
          scopePop()
          return -1
        }
      } else {
        if emitStmt(body, stmts[i], fnIx) < 0 {
          scopePop()
          return -1
        }
      }
      // A statically-TRUE `is` guard that always returns ends this instance's body.
      if monoStaticGuardEndsBlock(stmts[i], fnIx) {
        fbUnreachable() // 0x00 (dead padding — the cut path never runs)
        // D932 — the truncated statements' `let`s still own their collect-allocated
        // slots; a sibling emitted after this BLOCK (not after the function) would
        // otherwise bind one slot early. See `cursorSlotsUnder`.
        let cutAt = i + 1
        while cutAt < n {
          emitLetCursor = emitLetCursor + cursorSlotsUnder(stmts[cutAt])
          cutAt = cutAt + 1
        }
        i = n
      } else {
        pushPostGuardNarrow(stmts[i], fnIx)
        i = i + 1
      }
    }
    restoreNarrow(savedGuardTop)
    scopePop()
    return 0
  }
  emitFail("emitProgram: function has no block body")
}

// Lower every statement of the block at `blockIx` onto `body`, in order. Returns 0,
// or -1 (via `emitFail`) on a non-block node or an unsupported statement within.
function emitStmts(body: i32[], blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    // A nested block (if-then / if-else / while-body) is its own lexical scope (mirrors
    // `collectLocals` recursing into it): push a frame so its `let`s shadow correctly and
    // are dropped on exit.
    scopePush()
    const stmts = b.blkStmts
    // Post-guard complement narrowing (see `emitFuncBody`/`pushPostGuardNarrow`).
    const savedGuardTop = narrowTop
    let i = 0
    while i < stmts.length {
      if emitStmt(body, stmts[i], fnIx) < 0 {
        scopePop()
        return -1
      }
      if monoStaticGuardEndsBlock(stmts[i], fnIx) {
        fbUnreachable() // 0x00 — see `monoStaticGuardEndsBlock`
        // D932 — slot accounting over the truncated tail; see `cursorSlotsUnder`.
        let cutAt = i + 1
        while cutAt < stmts.length {
          emitLetCursor = emitLetCursor + cursorSlotsUnder(stmts[cutAt])
          cutAt = cutAt + 1
        }
        i = stmts.length
      } else {
        pushPostGuardNarrow(stmts[i], fnIx)
        i = i + 1
      }
    }
    restoreNarrow(savedGuardTop)
    scopePop()
    return 0
  }
  emitFail("emitProgram: function has no block body")
}

// Lower a block at `blockIx` that sits in tail position (its value is the enclosing
// function's return value). Every statement but the last is lowered normally; the last
// is lowered tail-aware via `emitStmtTail`. The structured-block analogue of
// `emitFuncBody`'s top-level implicit-return handling.
function emitStmtsTail(body: i32[], blockIx: i32, fnIx: i32) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    const n = stmts.length
    if n == 0 { return emitFail("emitProgram: empty block in tail position") }
    // A tail-position nested block is its own lexical scope too (mirrors `collectLocals`).
    scopePush()
    // Post-guard complement narrowing (see `emitFuncBody`/`pushPostGuardNarrow`) —
    // pushed in the loop, active for the TAIL statement, restored on exit.
    const savedGuardTop = narrowTop
    let i = 0
    let cut = false
    while i < n - 1 {
      if emitStmt(body, stmts[i], fnIx) < 0 {
        scopePop()
        return -1
      }
      if monoStaticGuardEndsBlock(stmts[i], fnIx) {
        fbUnreachable() // 0x00 — see `monoStaticGuardEndsBlock`
        // D932 — slot accounting over the truncated tail (the un-emitted tail
        // statement included); see `cursorSlotsUnder`.
        let cutAt = i + 1
        while cutAt < n {
          emitLetCursor = emitLetCursor + cursorSlotsUnder(stmts[cutAt])
          cutAt = cutAt + 1
        }
        cut = true
        i = n - 1
      } else {
        pushPostGuardNarrow(stmts[i], fnIx)
        i = i + 1
      }
    }
    let rc = 0
    if !cut { rc = emitStmtTail(body, stmts[n - 1], fnIx) }
    restoreNarrow(savedGuardTop)
    scopePop()
    return rc
  }
  emitFail("emitProgram: function has no block body")
}

// Lower the single statement at `stmtIx` in TAIL position. A bare tail value becomes
// `emitExpr` + `return`; a nested `if`/`else` recurses tail-aware into its arms; any
// other statement (an explicit `return`, a `while`, etc.) is lowered unchanged by
// `emitStmt` (it already exits or falls through on its own). Returns 0, or -1.
function emitStmtTail(body: i32[], stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  if s is IfStmt { return emitIfTail(body, stmtIx, fnIx) }
  if stmtIsTailValue(stmtIx, fnIx) {
    // An if-tail arm's implicit return — seed the return context (so a `null` arm
    // boxes / sentinels per the function's return type) exactly like `emitFuncBody`.
    return emitReturnExit(body, stmtIx, fnIx)
  }
  // D1240 — an if-ARM tail member call is a value for the same reason a body tail is: this
  // path is reached only from `emitIfTail`, i.e. only where the arms ARE the result.
  if memberCallYieldsValue(stmtIx) { return emitReturnExit(body, stmtIx, fnIx) }
  emitStmt(body, stmtIx, fnIx)
}

// Lower an `if`/`else` at `stmtIx` whose value is the function's return value (tail
// position): each arm is lowered with its last statement tail-aware (`emitStmtsTail`).
// Mirrors `emitStmt`'s void-if shape, but routes the arm bodies through the tail path.
function emitIfTail(body: i32[], stmtIx: i32, fnIx: i32) {
  const s = P.nodes[stmtIx]
  if s is IfStmt {
    // D932 — the tail-position twin of `emitIfStmtStmt`'s dead-arm skip, same byte-read
    // gate (`emittedCondConst`), same slot accounting (`cursorSlotsUnder`). The tail form
    // is the same defect one position over: `function f(v) { if v is string { "\"" + v }
    // else { "o" } }` emitted the statically-false arm's narrowed use in the i32 instance.
    const condStart = wLen()
    if emitExpr(body, s.ifCond, fnIx) < 0 { return -1 }
    let staticGuard = -1
    const condN = P.nodes[unwrapParen(s.ifCond)]
    if condN is IsExpr { staticGuard = emittedCondConst(condStart) }
    fbIf(64) // 0x04 if, 0x40 void blocktype
    // The arms hold RETURNS, and a union-box return SINKS to a `br` whose operand is the
    // frame distance to the function's exit block — so this frame has to be counted. The
    // `else` reuses it (one frame per `if`/`else` pair), matching `emitIfStmtStmt`.
    ctrlEnter()
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    if staticGuard != 0 {
      if emitStmtsTail(body, s.ifThen, fnIx) < 0 { return -1 }
    } else {
      emitLetCursor = emitLetCursor + cursorSlotsUnder(s.ifThen)
    }
    if narrowed { restoreNarrow(savedTop) }
    if s.ifElse >= 0 && staticGuard != 1 {
      fbElse() // 0x05 else
      // A VALUE union narrows to the COMPLEMENT set in the else-arm (see emitStmt).
      const savedElseTop = narrowTop
      const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
      const els = P.nodes[s.ifElse]
      if els is Block {
        if emitStmtsTail(body, s.ifElse, fnIx) < 0 { return -1 }
      } else {
        // `else if`: a lone nested IfStmt, still in tail position.
        if emitStmtTail(body, s.ifElse, fnIx) < 0 { return -1 }
      }
      if narrowedElse { restoreNarrow(savedElseTop) }
    } else if s.ifElse >= 0 {
      emitLetCursor = emitLetCursor + cursorSlotsUnder(s.ifElse)
    }
    fbEnd() // 0x0b end
    ctrlLeave()
    return 0
  }
  emitFail("emitProgram: emitIfTail: not an if statement")
}

// The wasm global index of the user global at `globalStmts` position `gi`: the
// string-literal pool occupies indices 0..pool-1, so user cells follow it. The
// declaration position is not the cell index — a binding promoted to a start-function
// local (G2c) emits no cell, so survivors are re-densified by `gCellIdx`.
export function userGlobalIdx(gi: i32) {
  if gi < 0 || gi >= gCellIdx.length { return gStrPoolTexts.length + gi }
  gStrPoolTexts.length + gCellIdx[gi]
}

// the storage-class chokepoint for a user top-level binding: `fbGlobalGet`/`fbGlobalSet`
// are the module's only `0x23`/`0x24` writers, so routing every user cell through this
// pair makes cell-vs-local one decision no emit site can bypass. A promoted binding
// reached from outside the start function's own frame is rejected loudly here instead.
export function emitUserGlobalGet(gi: i32) {
  if gi >= 0 && gi < gPromoOk.length && gPromoOk[gi] == 1 {
    if !gPromoInStart || gPromoSlot[gi] < 0 {
      return emitFail(
        "emitProgram: promoted top-level binding read outside the top-level statement list",
      )
    }
    fbLocalGet(gPromoSlot[gi])
    return 0
  }
  fbGlobalGet(userGlobalIdx(gi))
  0
}

// The write half of the chokepoint above — `local.set` into the start function's frame
// for a promoted binding, else `global.set` of its cell.
export function emitUserGlobalSet(gi: i32) {
  if gi >= 0 && gi < gPromoOk.length && gPromoOk[gi] == 1 {
    if !gPromoInStart || gPromoSlot[gi] < 0 {
      return emitFail(
        "emitProgram: promoted top-level binding written outside the top-level statement list",
      )
    }
    fbLocalSet(gPromoSlot[gi])
    return 0
  }
  fbGlobalSet(userGlobalIdx(gi))
  0
}

// ── explicit expected-type context (N20) ──────────────────────────────────────
// The `pending*` globals are implicit parameters: a hand-rolled save/restore at every
// site risks a leaked seed. `ExpCtx` makes it explicit — a site snapshots the ambient
// seeds (`expCtxHere`), overrides what it knows, and hands it to `emitExprExpect`.
export type ExpCtx = {
  listKind: i32,        // pendingListKind — what an empty `[]` builds
  listSlot: i32,        // pendingListSlot — WHICH ref-list element type
  structIdx: i32,       // pendingStructIdx — the struct an ObjLit must build
  variantIdx: i32,      // pendingVariantIdx — bare variant an ObjLit must build
  mapSlot: i32,         // pendingMapSlot — the map shape a `Map()` builds
  wantI64: boolean,     // pendingI64 — a NumLit lowers as i64.const
  wantF32: boolean,     // pendingF32 — a NumLit lowers as f32.const
  wantF64: boolean,     // pendingF64 — an integer NumLit lowers as f64.const
  nulBool: boolean,     // pendingNulBool — a bare `null` is the sentinel 2
  nulLitUnion: boolean, // pendingNulLitUnion — a bare `null` is the sentinel -1
  nulString: boolean,   // pendingNulString — a bare `null` is `ref.null $sTypeIdx`
  nulClosure: boolean,  // pendingNulClosure — a bare `null` is `ref.null $cloStruct`
  nulList: boolean,     // pendingNulList — a bare `null` is `ref.null $lTypeIdx`
  nulNone: boolean,     // pendingNulNone — a bare `null` is `ref.null none`, the GC bottom
  nulRefHeap: i32,      // pendingNulRefHeap — heap index a bare `null` refs, -1 none
  rawNullRead: boolean, // pendingRawNullRead — a nullable read stays the RAW ref
  litUnion: i32,        // pendingLitUnion — a member StrLit lowers as its atom id
}

// The current pending seeds as an explicit context — the BASE every site starts
// from (exact ambient semantics), overriding only the fields it knows.
export function expCtxHere(): ExpCtx {
  const c: ExpCtx = {
    listKind: pendingListKind,
    listSlot: pendingListSlot,
    structIdx: pendingStructIdx,
    variantIdx: pendingVariantIdx,
    mapSlot: pendingMapSlot,
    wantI64: pendingI64,
    wantF32: pendingF32,
    wantF64: pendingF64,
    nulBool: pendingNulBool,
    nulLitUnion: pendingNulLitUnion,
    nulString: pendingNulString,
    nulClosure: pendingNulClosure,
    nulList: pendingNulList,
    nulNone: pendingNulNone,
    nulRefHeap: pendingNulRefHeap,
    rawNullRead: pendingRawNullRead,
    litUnion: pendingLitUnion,
  }
  return c
}

// Write a context into the pending seeds (the transport the consumers read).
export function expCtxApply(c: ExpCtx) {
  pendingListKind = c.listKind
  pendingListSlot = c.listSlot
  pendingStructIdx = c.structIdx
  pendingVariantIdx = c.variantIdx
  pendingMapSlot = c.mapSlot
  pendingI64 = c.wantI64
  pendingF32 = c.wantF32
  pendingF64 = c.wantF64
  pendingNulBool = c.nulBool
  pendingNulLitUnion = c.nulLitUnion
  pendingNulString = c.nulString
  pendingNulClosure = c.nulClosure
  pendingNulList = c.nulList
  pendingNulNone = c.nulNone
  pendingNulRefHeap = c.nulRefHeap
  pendingRawNullRead = c.rawNullRead
  pendingLitUnion = c.litUnion
  0
}

// Emit `exprIx` under the explicit expected-type context `ctx`: the ambient
// seeds are saved, `ctx` applied, the expression emitted, and EVERY seed
// restored — scoping the whole context to this one emit.
export function emitExprExpect(
  body: i32[],
  exprIx: i32,
  fnIx: i32,
  ctx: ExpCtx,
) {
  const saved = expCtxHere()
  expCtxApply(ctx)
  const r = emitExpr(body, exprIx, fnIx)
  expCtxApply(saved)
  r
}

// The cell-seed rungs a boundary derives from a cell's KIND alone, over the ambient seeds:
// the local `let`, the start-fn global init and the `global.set` arm. Not the CONST cell —
// its reset clears no null rep, so a seed armed there leaks (D1563). What a boundary reads
// from its own annotation stays at the caller. Difference table: emitter.md 6.1.1.
export function expCtxForCell(kind: VKind): ExpCtx {
  const c = expCtxHere()
  // The i32-backed `i32[] | null` (kind 15) and the nullable function value (kind 19): each
  // lowers a bare `null` as `ref.null` of its own heap type rather than the GC bottom.
  if kind == "nullist" { c.nulList = true }
  if kind == "nulclosure" { c.nulClosure = true }
  expCtxNulScalarList(c, kind)
  c
}

// The rest of the kind set, and `expCtxForCell`'s default: the distinct-backing nullable
// scalar lists take a leaf build code so a list init builds THAT wrapper and a wrapper heap
// so a bare `null` refs it, and both resolvers hand back inert (0 / -1) for every kind they
// do not name — which is what leaves the ambient seed standing for all the others.
function expCtxNulScalarList(c: ExpCtx, kind: VKind) {
  const slk = nulScalarListBuildKind(kind)
  if slk != 0 { c.listKind = slk }
  const slh = nulScalarListWrapHeap(kind)
  if slh >= 0 { c.nulRefHeap = slh }
  0
}

// Emit `print(<string expr>)`: stream each code point through `__print_char__`, then one
// `__print_str_flush__`. Factored from the print handler so the literal-union widening can reuse it.
function emitPrintStrExpr(body: i32[], strExpr: i32, fnIx: i32) {
  if emitExpr(body, strExpr, fnIx) < 0 { return -1 }
  fbLocalSet(strScratchBase + 0)
  emitPrintStrFromScratch(body)
}

// The literal text `null`, streamed through the same `__print_char__`/`__print_str_flush__`
// pair `print(<string>)` uses, through no scratch frame — a constant text needs neither a
// string-ref slot nor loop counters. The null branch of the two nullable-niche prints below.
function emitPrintNullWord() {
  fbI32Const(110) // 'n'
  fbCall(2)       // __print_char__
  fbI32Const(117) // 'u'
  fbCall(2)
  fbI32Const(108) // 'l'
  fbCall(2)
  fbI32Const(108) // 'l'
  fbCall(2)
  fbCall(3)       // __print_str_flush__
  0
}

// `print(<string | null>)`. The niche rep is a `(ref null $sTypeIdx)`; the plain string arm
// below streams it unconditionally and would trap on a genuine null, so this arm exists to
// handle it. One `br_on_null` covers the argument in a single evaluation — there is no
// nullable string local to stash it in, and re-evaluating would call a `string | null`-returning function twice.
function emitPrintNulString(body: i32[], argIx: i32, fnIx: i32) {
  fbBlock(64) // $out
  ctrlEnter()
  fbBlock(64) // $null
  ctrlEnter()
  // The RAW nullable ref. Without `rawNullRead` a kind-16 read recovers itself with
  // `ref.as_non_null` (0xd4) — which TRAPS on the very value this arm exists to handle,
  // before `br_on_null` can see it. Same context flag the `??` arms over a nullable
  // string set for their own `ref.is_null`.
  const rawCtx = expCtxHere()
  rawCtx.rawNullRead = true
  if emitExprExpect(body, argIx, fnIx, rawCtx) < 0 { return -1 }
  wU8(213) // 0xd5 br_on_null
  wULEB(0) // → $null (the enclosing block)
  fbLocalSet(strScratchBase + 0)
  if emitPrintStrFromScratch(body) < 0 { return -1 }
  fbBr(1) // → $out
  fbEnd()
  ctrlLeave()
  emitPrintNullWord()
  fbEnd()
  ctrlLeave()
  0
}

// `print(<boolean | null>)`. The niche rep is an i32 with sentinel 2 for null; the fallback
// ladder would route it to `__print_bool__`, which renders any non-zero as true, so a null
// silently printed true without this arm. A `br_table` on the niche value itself is already
// the arm index (0 false, 1 true, 2 null), evaluating the argument once with no scratch needed.
function emitPrintNulBool(body: i32[], argIx: i32, fnIx: i32) {
  fbBlock(64) // $out
  ctrlEnter()
  fbBlock(64) // $null
  ctrlEnter()
  fbBlock(64) // $true
  ctrlEnter()
  fbBlock(64) // $false
  ctrlEnter()
  if emitExpr(body, argIx, fnIx) < 0 { return -1 }
  wU8(14)     // 0x0e br_table
  wULEB(3)    // three indexed targets, then the default
  wULEB(0)    // 0 → $false (depth 0 from here)
  wULEB(1)    // 1 → $true
  wULEB(2)    // 2 → $null
  wULEB(2)    // default → $null (unreachable: the niche is 0/1/2)
  fbEnd()
  ctrlLeave()
  fbI32Const(0)
  fbCall(1)   // __print_bool__ → "false"
  fbBr(2)     // → $out
  fbEnd()
  ctrlLeave()
  fbI32Const(1)
  fbCall(1)   // __print_bool__ → "true"
  fbBr(1)     // → $out
  fbEnd()
  ctrlLeave()
  emitPrintNullWord()
  fbEnd()
  ctrlLeave()
  0
}

// `print(<literal-union atom>)` — widen the atom to its member string through the shared
// `emitAtomToStrChain` tower, then stream it. Shared rather than re-spelled, since a
// per-member `if id == <id> { print "<member>" }` chain re-reads the receiver once per
// member — free for a place, but another call each time for `print(f())`.
function emitPrintAtomStr(body: i32[], argIx: i32, texts: string[], fnIx: i32) {
  if emitStashAtomId(body, argIx, fnIx) < 0 { return -1 }
  emitPrintAtomFromStash(body, texts)
}

// The stashed-id half of the atom print: the shared widen tower over str-op scratch i32 slot 0,
// then the streaming print of the string it yields. Split out so the `K | null` niche below
// reaches it from INSIDE its sentinel guard without re-evaluating the receiver.
function emitPrintAtomFromStash(body: i32[], texts: string[]) {
  if emitAtomToStrChain(body, texts, 0) < 0 { return -1 }
  fbLocalSet(strScratchBase + 0)
  emitPrintStrFromScratch(body)
}

// `print(<K | null>)` — the atom niche: an i32 member id with `-1` for null, the same
// sentinel `emitNulIsNullTest`'s litunion arm compares against. Both arms read the stash,
// not the receiver, so one evaluation covers the sentinel test and the widen. The sentinel
// test runs first since the member arm's streaming loop reuses slot 0 as its cursor.
function emitPrintNulLitUnion(
  body: i32[],
  argIx: i32,
  texts: string[],
  fnIx: i32,
) {
  if emitStashAtomId(body, argIx, fnIx) < 0 { return -1 }
  pushStrScrI(body, 0)
  fbI32Const(-1)
  fbI32Bin(70) // 0x46 i32.eq
  fbIf(64)     // if (void)
  ctrlEnter()
  emitPrintNullWord()
  fbEnd()
  ctrlLeave()
  pushStrScrI(body, 0)
  fbI32Const(-1)
  fbI32Bin(71) // 0x47 i32.ne
  fbIf(64)     // if (void)
  ctrlEnter()
  if emitPrintAtomFromStash(body, texts) < 0 { return -1 }
  fbEnd()
  ctrlLeave()
  0
}

// one arm of the value-union print: the box is already stashed in `slot`, so recover this
// arm's payload and hand it to that rep's own `__print_*__` sink — the same sink the
// narrowed spelling `if v is i32 { print(v) }` reaches (D712), through the shared
// `emitUnionUnboxTail` recovery. The `null` arm has no payload and prints the word.
function emitPrintUnionArm(body: i32[], slot: i32, k: i32) {
  if k == nullValKind() { return emitPrintNullWord() }
  fbLocalGet(slot)
  if emitUnionUnboxTail(k) < 0 { return -1 }
  if k == 2 {
    // The string arm streams out of the str-op scratch frame — reserved because
    // `exprHasStrOp`'s print arm asked `printUnionHasStrArm`, the SAME plan this dispatch
    // walked. A guard rather than an assumption: without the frame `strScratchBase + 0` is
    // some other local and the module fails to parse.
    if !fnUsesStrOp {
      return emitFail(
        "emitProgram: print of a union with a string arm but no string scratch frame",
      )
    }
    fbLocalSet(strScratchBase + 0)
    return emitPrintStrFromScratch(body)
  }
  if k == 0 {
    fbCall(0) // __print_i32__ (import 0)
    return 0
  }
  if k == 1 {
    fbCall(1) // __print_bool__ (import 1)
    return 0
  }
  // the three wide scalars route to imports whose presence is decided by the module-level
  // annotation scan: a `f64 | i32` union spells its f64 and the import is there — checked
  // anyway, since a missed flag names a nonexistent import index, invalid wasm rather than a message.
  if k == 3 {
    if !gNeedsI64Print {
      return emitFail(
        "emitProgram: print of a union with an i64 arm but no __print_i64__ import",
      )
    }
    fbCall(4) // __print_i64__ (import index 4)
    return 0
  }
  if k == 4 {
    if !gNeedsF64Print {
      return emitFail(
        "emitProgram: print of a union with an f64 arm but no __print_f64__ import",
      )
    }
    fbCall(gF64PrintIdx)
    return 0
  }
  if k == 5 {
    if !gNeedsF32Print {
      return emitFail(
        "emitProgram: print of a union with an f32 arm but no __print_f32__ import",
      )
    }
    fbCall(gF32PrintIdx)
    return 0
  }
  emitFail("emitProgram: print of a union arm with no scalar sink")
}

// `print(<value-union box>)` — read the box tag and print the arm the value actually
// holds (D712): every arm is already inside `printDomainStr()`, so the runtime tag
// dispatch is the only piece needed, the same dispatch the emitter performs for `is`.
// One evaluation: each arm reads the box twice, so it is stashed once in the lazy frame.
function emitPrintValueUnion(body: i32[], argIx: i32, kinds: i32[], fnIx: i32) {
  const slot = sharedFieldRecvSlot()
  // D969 — an if-expression argument must be coerced, not plain-emitted: `emitExpr` picks
  // an if's blocktype from the arms' scalar ladder, so a desugared `??` pushes an i32
  // blocktype over two ref arms into this box slot. `emitUnionCoerce` routes it through `emitUnionIfValue` instead.
  const puIf = P.nodes[unwrapParen(argIx)]
  let puDone = false
  if puIf is IfStmt {
    const puNm = unionNameOfExpr(argIx, fnIx)
    if puNm != "" {
      if emitUnionCoerce(body, puNm, argIx, fnIx) < 0 { return -1 }
      puDone = true
    }
  }
  if !puDone {
    if emitExpr(body, argIx, fnIx) < 0 { return -1 }
  }
  fbLocalSet(slot)
  let i = 0
  while i < kinds.length - 1 {
    fbLocalGet(slot)
    fbStructGet(uBoxIdx, 0) // field 0: tag
    fbI32Const(scalarTagOfKind(kinds[i]))
    fbI32Bin(70)            // 0x46 i32.eq
    fbIf(64)                // if (void)
    ctrlEnter()
    if emitPrintUnionArm(body, slot, kinds[i]) < 0 { return -1 }
    fbElse()
    i = i + 1
  }
  if emitPrintUnionArm(body, slot, kinds[kinds.length - 1]) < 0 { return -1 }
  let e = 0
  while e < kinds.length - 1 {
    fbEnd()
    ctrlLeave()
    e = e + 1
  }
  0
}

// The streaming loop over the string already stashed in `strScrA` — `emitPrintStrExpr`'s
// tail, split out so the nullable arm above can reach it with the ref it recovered from
// `br_on_null` instead of re-evaluating the expression.
function emitPrintStrFromScratch(body: i32[]) {
  hoistStrScr(body, 0) // the streaming loop reads the backing once per code point
  fbI32Const(0)
  setStrScrI(body, 0)
  pushStrScrRef(body, 0)
  fbStrLen() // field 2: the VIEW's length, not the backing's
  setStrScrI(body, 1)
  fbBlock(64)
  ctrlEnter()
  fbLoop(64)
  ctrlEnter()
  pushStrScrI(body, 0)
  pushStrScrI(body, 1)
  fbI32Bin(78) // i32.ge_s
  fbBrIf(1)
  pushStrScrElem(body, 0, 0)
  fbCall(2) // __print_char__
  pushStrScrI(body, 0)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  setStrScrI(body, 0)
  fbBr(0)
  fbEnd()
  ctrlLeave()
  fbEnd()
  ctrlLeave()
  fbCall(3) // __print_str_flush__
  0
}

// Widen a literal-union atom (an i32 id) to a string value — a `select` tower mapping each
// member's id to its string constant, membership checker-guaranteed so the last member is
// the unconditional default. The id evaluates once into str-op scratch slot 0, re-read per
// member. The string-subtype analogue of the numeric i32→f64 widening.
export function emitAtomToStr(body: i32[], atomIx: i32, fnIx: i32) {
  // `litAtomWidenTexts` is the ladder, shared with `print`'s atom arm: the node's own union
  // members, the DECLARATION fallback for an operand whose recorded type is the GENERIC's,
  // then the bare one-member set. Two consumers ask the same question and both need every
  // rung — the classifier decides WHETHER to widen, this one needs the members to widen WITH.
  const texts = litAtomWidenTexts(atomIx, fnIx)
  if texts.length == 0 {
    return emitFail(
      "emitProgram: literal-union string widening with no members",
    )
  }
  if !aUsed {
    return emitFail(
      "emitProgram: literal-union string widening but array type not collected",
    )
  }
  if emitStashAtomId(body, atomIx, fnIx) < 0 { return -1 }
  const r = emitAtomToStrChain(body, texts, 0)
  r
}

// Evaluate an atom-repped literal-union value once and stash its interned i32 id in the
// string-op scratch i32 slot 0 — the slot every widen tower re-reads once per member. A
// tower that re-read the receiver per member instead would re-run a call receiver once per
// member, a silent wrong evaluation count rather than a wrong value.
function emitStashAtomId(body: i32[], atomIx: i32, fnIx: i32) {
  const savedLU = pendingLitUnion
  pendingLitUnion = 1
  if emitExpr(body, atomIx, fnIx) < 0 { return -1 }
  pendingLitUnion = savedLU
  setStrScrI(body, 0)
  0
}

// True if the return annotation at `tyIx` is an un-named (inline) literal union — a pure
// litunion in the arena that is not a registered alias. The alias reps as an interned atom,
// the inline form a string ref; `nodeTyIsLitUnionAlias` is the seam between them.
function retLitUnionInline(tyIx: i32): boolean {
  if tyIx < 0 { return false }
  if nodeTyIsLitUnionAlias(tyIx) { return false }
  tyIsLitUnion(nodeTyIxOf(tyIx))
}

// The `select` tower for `emitAtomToStr`: member `i`'s string if its interned id matches
// the stashed atom, else the chain for `i+1`. The last member is the unconditional default arm.
function emitAtomToStrChain(body: i32[], texts: string[], i: i32) {
  if i >= texts.length - 1 {
    const rd = emitStr(body, mkStr(quoteLex(texts[i]), -1), -1)
    return rd
  }
  // val1 = this member's string constant
  if emitStr(body, mkStr(quoteLex(texts[i]), -1), -1) < 0 { return -1 }
  // val2 = the remaining chain
  if emitAtomToStrChain(body, texts, i + 1) < 0 { return -1 }
  // cond = (stashed id == this member's id)
  pushStrScrI(body, 0)
  fbI32Const(internAtom(quoteLex(texts[i])))
  fbI32Bin(70) // i32.eq
  // select_t typed for a non-null string ref (0x64 $sTypeIdx): val1 if cond else val2
  wU8(28)  // 0x1c select_t
  wU8(1)   // one result valtype
  wU8(100) // 0x64 (ref ht) — non-null
  wSLEB(sTypeIdx)
  0
}

// Emit `ix` as a string value: a literal-union atom widens to its member string; anything
// else lowers normally (it is already a string). Used at every `string`-typed boundary that
// can receive an atom — concat operands, a `string` arg position, a `string` return.
function emitStrValue(body: i32[], ix: i32, fnIx: i32) {
  if exprIsLitAtom(ix, fnIx) {
    const rw = emitAtomToStr(body, ix, fnIx)
    return rw
  }
  const re = emitExpr(body, ix, fnIx)
  re
}

// Narrow a string-repped literal-union value to its interned i32 atom id — `emitAtomToStr`'s
// inverse. A litunion has two reps and `nodeTyIsLitUnionAlias` decides which: a registered
// alias is an interned atom, an un-named one stays a `(ref $array)` string. The tower is
// `emitAtomToStr`'s, mirrored, re-reading the value per member (bounded by `unionEqOperandOk`).
function emitStrToAtom(body: i32[], ix: i32, fnIx: i32) {
  // `tyLitMemberTexts` over the node's recorded type, NOT `nodeLitUnionMemberTexts`: that
  // node query declines a bare `TyLit` on purpose (its callers read an empty list as "not a
  // widenable atom"), and a bare `TyLit` is exactly the one-member set this narrowing serves.
  const texts = tyLitMemberTexts(nodeTyIxOf(ix))
  if texts.length == 0 {
    return emitFail("emitProgram: literal-union atom narrowing with no members")
  }
  if !aUsed {
    return emitFail(
      "emitProgram: literal-union atom narrowing but array type not collected",
    )
  }
  if !unionEqOperandOk(ix) {
    // a non-place value — a call, a `+`, a ternary — is staged rather than refused:
    // evaluated once into `atomStageSlot`, then re-read per member (`emitAtomToStr`'s id
    // stash mirrored). Reached through `emitExpr`'s single `pendingLitUnion` hook, so every
    // destination that seeds that context is served by one arm (D13).
    if !fnUsesAtomStage {
      // the reservation scan claims a strict superset of what this arm stages, so reaching
      // here means the two have drifted. Keep the loud refusal rather than `local.set` an
      // index the locals vector never declared.
      return emitFail(
        "emitProgram: literal-union atom narrowing needs a re-readable receiver",
      )
    }
    // the atom context is cleared across the stash and the chain: the value must reach the
    // slot as the `(ref $array)` it is, and each member constant must lower as a string —
    // under `pendingLitUnion` a member literal folds to its interned id instead, so the
    // tower called `strEq` with an i32 operand. Restored on both exits.
    const savedST = pendingLitUnion
    pendingLitUnion = 0
    let rv = emitExpr(body, ix, fnIx)
    if rv >= 0 {
      fbLocalSet(atomStageSlot)
      rv = emitStagedStrToAtomChain(body, texts, 0, fnIx)
    }
    pendingLitUnion = savedST
    return rv
  }
  // The inner emits run OUTSIDE the atom context: the value re-reads must lower as the
  // string they are (re-entering this arm would not terminate), and the per-member literal
  // must lower as a string CONSTANT, not as its own interned id.
  const savedLU = pendingLitUnion
  pendingLitUnion = 0
  const r = emitStrToAtomChain(body, ix, texts, 0, fnIx)
  pendingLitUnion = savedLU
  r
}

// The `select` tower for `emitStrToAtom`: member `i`'s interned id if the value string-equals
// member `i`, else the chain for `i+1`. The last member is the unconditional default arm.
function emitStrToAtomChain(
  body: i32[],
  ix: i32,
  texts: string[],
  i: i32,
  fnIx: i32,
) {
  if i >= texts.length - 1 {
    fbI32Const(internAtom(quoteLex(texts[i])))
    return 0
  }
  // val1 = this member's interned id
  fbI32Const(internAtom(quoteLex(texts[i])))
  // val2 = the remaining chain
  if emitStrToAtomChain(body, ix, texts, i + 1, fnIx) < 0 { return -1 }
  // cond = (the value string-equals this member)
  if emitExpr(body, ix, fnIx) < 0 { return -1 }
  if emitExpr(body, mkStr(quoteLex(texts[i]), -1), fnIx) < 0 { return -1 }
  if emitStrEqCore(body) < 0 { return -1 }
  fbSelect() // 0x1b select — val1 if cond else val2 (both i32)
  0
}

// ── the destination-driven narrow, for a value whose own type cannot answer ───────────────
// `emitStrToAtom` refuses a value it cannot re-read — wrong at a `.push` into a
// literal-union array inside a monomorphized instance, where the value is a call and the
// leaf's recorded type is still the generic's type variable. The destination knows the member set instead.
function emitDestStrToAtom(body: i32[], valIx: i32, fnIx: i32, luTy: i32) {
  const texts = tyLitMemberTexts(luTy)
  if texts.length == 0 {
    return emitFail("emitProgram: literal-union atom narrowing with no members")
  }
  if !aUsed {
    return emitFail(
      "emitProgram: literal-union atom narrowing but array type not collected",
    )
  }
  const ix = unwrapParen(valIx)
  if unionEqOperandOk(ix) {
    // A PLACE: re-read it per member, no slot.
    const savedRR = pendingLitUnion
    pendingLitUnion = 0
    const rr = emitStrToAtomChain(body, ix, texts, 0, fnIx)
    pendingLitUnion = savedRR
    return rr
  }
  if !fnUsesAtomStage {
    // The reservation scan claims a strict SUPERSET of what this arm stages, so reaching here
    // means the two have drifted. Fail loudly rather than `local.set` an index the locals
    // vector never declared — that is invalid wasm with `vl check` rc 0.
    return emitFail(
      "emitProgram: literal-union atom narrowing needs a staging slot that was not reserved",
    )
  }
  const savedLU = pendingLitUnion
  pendingLitUnion = 0
  const rv = emitExpr(body, ix, fnIx)
  pendingLitUnion = savedLU
  if rv < 0 { return -1 }
  fbLocalSet(atomStageSlot)
  emitStagedStrToAtomChain(body, texts, 0, fnIx)
}

// `emitStrToAtomChain` over the STAGED value: member `i`'s interned id if the slot
// string-equals member `i`, else the chain for `i+1`, last member the unconditional default.
function emitStagedStrToAtomChain(
  body: i32[],
  texts: string[],
  i: i32,
  fnIx: i32,
) {
  if i >= texts.length - 1 {
    fbI32Const(internAtom(quoteLex(texts[i])))
    return 0
  }
  fbI32Const(internAtom(quoteLex(texts[i])))
  if emitStagedStrToAtomChain(body, texts, i + 1, fnIx) < 0 { return -1 }
  fbLocalGet(atomStageSlot)
  if emitExpr(body, mkStr(quoteLex(texts[i]), -1), fnIx) < 0 { return -1 }
  if emitStrEqCore(body) < 0 { return -1 }
  fbSelect() // 0x1b select — val1 if cond else val2 (both i32)
  0
}

// Does a `.push` value into a literal-union array need the destination-driven narrow? Only
// when the existing atom context has no answer: an atom-repped value or a member string
// literal both lower correctly under `pendingLitUnion` already.
function litPushNeedsDestNarrow(valIx: i32, fnIx: i32) {
  if exprIsLitAtom(valIx, fnIx) { return false }
  const v = P.nodes[unwrapParen(valIx)]
  if v is StrLit { return false }
  if strReppedLitUnionAt(valIx, fnIx) {
    if unionEqOperandOk(valIx) { return false }
  }
  true
}

// True when `ix` is a literal-union value whose rep is its member string rather than the
// interned i32 atom — the un-named flattened and inline spellings. Declines an atom-repped
// expression and a member string literal, both already atoms in atom context; the member
// set may be a singleton (`tyIsLitUnionOrLit`), same bare `TyLit` a plain literal produces.
function strReppedLitUnionAt(ix: i32, fnIx: i32) {
  if exprIsLitAtom(ix, fnIx) { return false }
  const av = unwrapParen(ix)
  const e = P.nodes[av]
  if e is StrLit { return false }
  tyIsLitUnionOrLit(nodeTyIxOf(av))
}

// True when `ix` can be lowered in atom context — the interned i32 id the litunion atom
// `==` needs on both sides: an atom-repped expression, a member string literal, or a
// string-repped litunion. A plain `string` is excluded on purpose: `emitStrToAtom`'s
// tower needs membership guaranteed, which a plain `string` does not carry.
function eqAtomOperandOk(ix: i32, fnIx: i32) {
  if exprIsLitAtom(ix, fnIx) { return true }
  const av = unwrapParen(ix)
  const e = P.nodes[av]
  if e is StrLit { return true }
  if exprUnion(ix, fnIx) { return false }
  nodeTyIsLitUnion(av)
}

function emitNumLitNode(_body: i32[], e: NumLit, exprIx: i32, fnIx: i32) {
  // A FLOAT literal (lexeme carries a `.`) in f32 CONTEXT (`pendingF32` — an `: f32`
  // binding/param/return) lowers as `f32.const`. Checked before the default f64 path
  // so a float literal re-encodes at single precision in an f32 slot (never demoted
  // from f64). Outside f32 context a `.` literal stays f64, unchanged. (Slice 5.)
  if numLexIsFloat(e.numText) {
    if pendingF32 {
      fbF32Const(e.numText)
      return 0
    }
    fbF64Const(e.numText)
    return 0
  }
  // An integer literal in f32 CONTEXT lowers DIRECTLY as `f32.const` (re-encoded at
  // single precision — `f32Bytes` parses an integer lexeme as `mant/10^0`), so it is a
  // valid constexpr in a const-global init (a convert op is not). (Slice 5.)
  if pendingF32 {
    fbF32Const(e.numText)
    return 0
  }
  // An integer literal in f64 CONTEXT (const-global init) lowers directly as
  // `f64.const`, keeping the global init a constexpr (`const b: f64 = 5`). (Slice 5.)
  if pendingF64 {
    fbF64Const(e.numText)
    return 0
  }
  // An integer literal in i64 CONTEXT (`pendingI64`) lowers as `i64.const` over the
  // 64-bit (hi, lo) pair parsed from its lexeme — so a value past the i32 range
  // (`9000000000`, `0xFFFFFFFFFF`) survives. Otherwise the default i32 path is
  // unchanged (bare integer literals stay i32 — Slice 1 invariant).
  if pendingI64 {
    const pr = parseI64Pair(e.numText)
    fbI64Const(pr[0], pr[1])
    return 0
  }
  // An integer literal past the i32 range is TYPED i64 by the checker (the host's
  // `defaultIntegerType` magnitude rule), so it lowers as `i64.const` even with no
  // i64 context — the old default `i32.const` silently wrapped (0xDEAD_BEEF).
  if !numLexFitsI32(e.numText) {
    const pr = parseI64Pair(e.numText)
    fbI64Const(pr[0], pr[1])
    return 0
  }
  // a small int literal whose context adopted a wider slot — the checker recorded i64/f64
  // on the node (`objRetWidenAdopt`): honor the recorded rep, so the typed-IR fast paths
  // and the emitted value agree. The checker records a wider numeric on a literal only
  // when it proved it re-encodable.
  if exprIsI64(exprIx, fnIx) {
    const wpr = parseI64Pair(e.numText)
    fbI64Const(wpr[0], wpr[1])
    return 0
  }
  if exprIsF64(exprIx, fnIx) {
    fbF64Const(e.numText)
    return 0
  }
  fbI32Const(parseI32(e.numText))
  return 0
}

function emitCharLitNode(_body: i32[], e: CharLit, _exprIx: i32, _fnIx: i32) {
  // A char literal IS its single Unicode code point as an i32. `charText` is the RAW
  // lexeme (quotes kept, escapes unresolved), so decode it the SAME way string
  // literals decode (`decodeStr` strips the quotes + resolves escapes); a well-formed
  // char yields exactly one code point.
  const cps = decodeStr(strToCps(e.charText))
  if cps.length != 1 {
    return emitFail(
      "emitProgram: char literal must denote exactly one code point",
    )
  }
  fbI32Const(cps[0])
  return 0
}

// the densest single-identifier site in the compiler: one identifier read resolves
// through seven name-keyed lookups here, each otherwise a hash plus a string probe. The
// arena index `_exprIx`, already threaded in and unused, turns the id lookup and the
// other six into array reads.
function emitIdentNode(body: i32[], e: Ident, exprIx: i32, fnIx: i32) {
  // D1576 — a read of a never-filled `let x = null` is the value `null`, so it takes the
  // destination's null rep from the same table a bare `null` literal does. With no seed
  // the read is `ref.null none` (`nulNoneOk`'s last resort), the GC bottom and a subtype
  // of every nullable ref cell.
  if identCellVKind(exprIx, fnIx) == "nulnone" {
    return emitNullBySeed(fnIx, true)
  }
  const isid = sidOfNode(exprIx)
  // a module-`const` parameter default reads its global, not a caller-local of the same
  // name: this node is the declaration's expression, substituted into whichever frame
  // omitted the argument, so the only hygienic reading is the declaration's own. The
  // checker resolves the same node the same way, so the two agree by construction.
  if isDefaultGlobalRef(exprIx) {
    const dgIdx = globalIndexOfSid(isid)
    if dgIdx >= 0 {
      if emitUserGlobalGet(dgIdx) < 0 { return -1 }
      // the `string | null` read rule, the one cell kind whose nullability survives
      // `const`: every other const-cell recovery is gated on `globalNameIsNonConst`,
      // which a module `const` is not, so there is nothing else to mirror.
      if globalCellKind(globalLetOfSid(isid)) == "nulstr" {
        if !nulStrReadStaysRaw() {
          wU8(212) // 0xd4 ref.as_non_null
        }
      }
      return 0
    }
  }
  // the narrowed-arm unboxes come first (each sourcing its box through
  // `emitUnionBoxPush`, whose capture leg reads the env field raw). A value-union binding
  // narrowed to one scalar atom reads unboxed: push the box, recover the `anyref`
  // payload, cast it, and read the value-box field — `if u is i32 { print(u) }` yields the raw i32.
  const vAtom = narrowedValueAtomOf(e.identName)
  if vAtom != "" {
    // the narrowed atom's ABI code, derived once for both reads below.
    const vak = valueAtomKind(vAtom)
    const vSet = unionNameOfIdentSid(isid, fnIx)
    if vSet != "" {
      // D947 — a dead generic narrow reads `unreachable`, not a value box: a type
      // parameter narrowed to an impossible arm type-checks, so the arm is
      // constant-false there and would otherwise read a box that is not there.
      // Bounded to generic functions, since a type parameter is never rebound inside an instance.
      if fnHasTyParams(fnIx) {
        if !unionSetHasAtom(vSet, vAtom) {
          wU8(0) // 0x00 unreachable
          return 0
        }
      }
      return emitValueUnionUnboxRead(body, e.identName, vak, fnIx)
    }
    // the capture storage class's gate. The name question above resolves a binding in THIS
    // frame; a capture's binding is in another one, so it answers "" while the read is
    // narrowed. `capturedIsUnionBox` asks the rep instead — see its own comment.
    if capturedIsUnionBox(fnIx, e.identName) {
      return emitValueUnionUnboxRead(body, e.identName, vak, fnIx)
    }
    // the typed-IR net behind the syntactic miss, carried by all three narrowed-arm
    // reads here: some bindings hold the box without producing a `unionNameOfIdent`
    // render, so the syntactic gate misses and the unbox is skipped, pushing the raw box
    // where the arm's rep belongs — invalid wasm.
    if identChainTyBoxedUnion(e.identName, fnIx, 4) {
      return emitValueUnionUnboxRead(body, e.identName, vak, fnIx)
    }
  }
  // a union binding narrowed to a ref-element array arm reads unboxed to the reflist
  // wrapper: push the box, recover the anyref payload, `ref.cast` to the arm's wrapper —
  // the ref-array analogue of the scalar unbox above, so indexing/`.length` see the list.
  const raNm = narrowedRefArrayOf(e.identName)
  if raNm != "" {
    if unionNameOfIdentSid(isid, fnIx) != "" {
      return emitRefArrayUnionUnboxRead(body, e.identName, fnIx)
    }
    // the capture storage class's gate (see the value-atom arm above).
    if capturedIsUnionBox(fnIx, e.identName) {
      return emitRefArrayUnionUnboxRead(body, e.identName, fnIx)
    }
    // the typed-IR net (see the value-atom arm above).
    if identChainTyBoxedUnion(e.identName, fnIx, 4) {
      return emitRefArrayUnionUnboxRead(body, e.identName, fnIx)
    }
  }
  // a union binding narrowed to a map arm reads unboxed to the map struct ref: push the
  // box, recover the anyref payload, `ref.cast` to the arm's map struct — the map
  // analogue of the ref-array unbox above, so `emitMapPrep` sees the map ref directly.
  const mNm = narrowedMapOf(e.identName)
  if mNm != "" {
    if unionNameOfIdentSid(isid, fnIx) != "" {
      return emitMapUnionUnboxRead(body, e.identName, fnIx)
    }
    // the capture storage class's gate (see the value-atom arm above).
    if capturedIsUnionBox(fnIx, e.identName) {
      return emitMapUnionUnboxRead(body, e.identName, fnIx)
    }
    // the typed-IR net (see the value-atom arm above), over the map-arm chain.
    if identChainTyMapArmUnion(e.identName, fnIx, 4) {
      return emitMapUnionUnboxRead(body, e.identName, fnIx)
    }
  }
  // a captured variable (a free var of a capturing lifted function): read it from the
  // env struct threaded as the leading param (local 0). Checked before the param/local/
  // global paths so a capture shadows nothing. Only fires inside a capturing lifted function.
  if emitCapturedRead(body, e.identName, fnIx, true) == 1 { return 0 }
  // A name resolves to a param (locals 0..p-1) or a declared local (locals p..).
  const idx = localIndexOf(fnIx, e.identName)
  if idx < 0 {
    // a bare top-level/lifted function name in value position constructs a function
    // value (closure fat-pointer): `fnIndexOf` is the function index `emitClosureValue`
    // expects, passed directly. Scope-aware so a nested function sharing a name with
    // another maker's nested function resolves to this frame's.
    const fe = fnIndexOfInScopeSid(isid, e.identName, fnIx)
    if fe >= 0 {
      // void-coerced value seam: this node's `(P…) => T` is coerced to `(P…) => void`
      // by the checker (`fnValVoidCoerce`), so build the void twin's closure instead
      // (`voidTwinForNode`), or the `>v`-sig call signature-checks against the wrong functype.
      const vtw = voidTwinForNode(exprIx, fe)
      if vtw >= 0 { return emitClosureValue(body, vtw, fnIx) }
      return emitClosureValue(body, fe, fnIx)
    }
    // Not a local — a module global? Read it with `global.get` (0x23 <globalidx>).
    const gIdx = globalIndexOfSid(isid)
    if gIdx >= 0 {
      if emitUserGlobalGet(gIdx) < 0 { return -1 }
      const gck0 = globalCellKind(globalLetOfSid(isid))
      // the `string | null` read rule (stated at `emitMem`'s field read) applies here
      // independently of const-ness: a kind-16 slot is always a nullable ref, since a
      // const can still be initialized to `null`.
      if gck0 == "nulstr" {
        if !nulStrReadStaysRaw() {
          wU8(212) // 0xd4 ref.as_non_null
        }
        return 0
      }
      // a non-const ref global rides in a nullable cell (start-fn initialized with
      // `ref.null`); recover the non-null value type codegen expects with
      // `ref.as_non_null` — the cast never traps, since the cell is always initialized
      // first. A const global keeps its non-null cell, so no cast.
      if globalNameIsNonConstSid(isid) {
        // a nullable-struct, nullable-list or nullable-closure cell legitimately holds
        // null, so its reads stay nullable (recovering non-null at the use site
        // instead); a scalar numeric cell is not a ref, so it needs no cast either.
        if (
          gck0 != "i32" &&
          gck0 != "nulstruct" &&
          gck0 != "nulvariant" &&
          gck0 != "i64" &&
          gck0 != "f64" &&
          gck0 != "f32" &&
          gck0 != "nullist" &&
          gck0 != "nulreflist" &&
          gck0 != "nulclosure" &&
          gck0 != "nulmap" &&
          !isNulScalarListKind(gck0)
        ) {
          // a nullable-variant or nullable-map cell legitimately holds null too, so an
          // eager recover here would trap `gn != null` on the exact value the test
          // exists to detect; the field read recovers at its own use site instead. The
          // kind-18 nullable ref-array cell joins this exclusion set for the same reason.
          wU8(212) // 0xd4 ref.as_non_null
        }
      }
      return 0
    }
    return emitFail(
      "emitProgram: identifier is not a parameter, local, or global",
    )
  }
  fbLocalGet(idx)
  // The `string | null` (kind 16) read rule for a param/local — stated at `emitMem`'s
  // field read. Mirrors the kind-15 list read, which never eagerly recovers.
  if !nulStrReadStaysRaw() {
    if paramNulString(fnIx, e.identName) || declaredNulString(e.identName) {
      fbRefAsNonNull() // 0xd4
    }
  }
  return 0
}

function emitUnaryNode(body: i32[], e: Unary, _exprIx: i32, fnIx: i32) {
  // Logical not `!a`: a boolean rides in an i32 (0/1), so `i32.eqz` (0x45) maps
  // 0→1 and any non-zero→0 — exactly `a == 0`. Push the operand, then eqz.
  if e.unOp == "!" {
    if emitExpr(body, e.unArg, fnIx) < 0 { return -1 }
    fbI32Eqz() // 0x45 i32.eqz
    return 0
  }
  // postfix `x++`/`x--` in expression position yields the old value. `unArg` is the
  // increment assignment `x = x ± 1`, which as an expression yields the new value
  // (store-then-re-read); undo the step to recover the pre-increment value.
  if e.unOp == "p+" || e.unOp == "p-" {
    if emitExpr(body, e.unArg, fnIx) < 0 { return -1 }
    fbI32Const(1)
    if e.unOp == "p+" {
      fbI32Bin(107) // 0x6b i32.sub: (x+1) - 1
    } else {
      fbI32Bin(106) // 0x6a i32.add: (x-1) + 1
    }
    return 0
  }
  // Bitwise NOT `~x` == `x ^ -1` (flip every bit). The all-ones mask is an i64
  // `-1` when the operand is i64, an i32 `-1` otherwise; the XOR opcode follows
  // suit. (Slice 2 — the i64 path; the i32 path is the same shape over i32 ops.)
  if e.unOp == "~" {
    if exprIsI64(e.unArg, fnIx) {
      if emitExpr(body, e.unArg, fnIx) < 0 { return -1 }
      fbI64Const(-1, -1) // i64 -1 (all ones)
      fbI32Bin(133)      // 0x85 i64.xor
      return 0
    }
    if emitExpr(body, e.unArg, fnIx) < 0 { return -1 }
    fbI32Const(-1) // i32 -1 (all ones)
    fbI32Bin(115)  // 0x73 i32.xor
    return 0
  }
  // Integer negation: `-x` == `0 - x`, so push 0, the operand, then sub. For an
  // i64 operand the zero and the subtract are i64 (Slice 2).
  if e.unOp != "-" {
    return emitFail("emitProgram: unsupported unary operator")
  }
  // f32 negation uses the dedicated `f32.neg` (0x8c) — flips the sign bit. Checked
  // before f64 (an f32 expr is never `exprIsF64`, but this keeps the float cases
  // grouped and explicit). (Slice 5.)
  if exprIsF32(e.unArg, fnIx) {
    if emitExpr(body, e.unArg, fnIx) < 0 { return -1 }
    wU8(140) // 0x8c f32.neg
    return 0
  }
  // f64 negation uses the dedicated `f64.neg` (0x9a) — flips the sign bit (Slice 3).
  if exprIsF64(e.unArg, fnIx) {
    if emitExpr(body, e.unArg, fnIx) < 0 { return -1 }
    wU8(154) // 0x9a f64.neg
    return 0
  }
  // a negated magnitude-2^31 integer literal (`-2147483648`) is i32, but the bare
  // operand lexeme is one past I32_MAX, so the `exprIsI64` branch below would
  // otherwise lower it as an i64 negation. `parseI32` folds it to I32_MIN directly instead.
  const negInner = unwrapParen(e.unArg)
  const negNode = P.nodes[negInner]
  if negNode is NumLit {
    if !numLexIsFloat(negNode.numText) {
      if numLexIs2Pow31(negNode.numText) {
        fbI32Const(0)
        fbI32Const(parseI32(negNode.numText))
        fbI32Bin(107) // 0x6b i32.sub
        return 0
      }
    }
  }
  if exprIsI64(e.unArg, fnIx) {
    fbI64Const(0, 0) // i64 0
    if emitExpr(body, e.unArg, fnIx) < 0 { return -1 }
    fbI32Bin(125)    // 0x7d i64.sub
    return 0
  }
  fbI32Const(0)
  if emitExpr(body, e.unArg, fnIx) < 0 { return -1 }
  fbI32Bin(107) // 0x6b i32.sub
  return 0
}

function emitCallNode(body: i32[], e: Call, exprIx: i32, fnIx: i32) {
  // G6: `s.slice(start, end)` over a string receiver is an intrinsic — a new
  // `(array i32)` over the clamped half-open range. Other member-calls in value
  // position are out of scope (the only member-call STATEMENT is `.push`).
  if exprIsStrSlice(exprIx, fnIx) { return emitStrSlice(body, exprIx, fnIx) }
  // An array `xs.slice(start, end?)` over a LIST receiver — a same-element-kind
  // sublist (`emitArrSlice`). Checked before the string slice's siblings so it does
  // not fall into a struct member-call path.
  if callIsArrSlice(exprIx, fnIx) { return emitArrSlice(body, exprIx, fnIx) }
  // `s.indexOf(sub)` / `s.includes(sub)` / `s.charCodeAt(i)` over a string
  // receiver are intrinsics too (A7), each yielding an i32.
  if exprIsStrIndexOf(exprIx, fnIx) {
    return emitStrIndexOf(body, exprIx, fnIx)
  }
  if exprIsStrCharCode(exprIx, fnIx) {
    return emitStrCharCode(body, exprIx, fnIx)
  }
  // The Stage 2c codec trio. Dispatched from the SAME ladder rung as `charCodeAt` because
  // they are the same shape — a member call on a string receiver yielding a scalar — and a
  // rung further down would sit past the `Map`/`Set`/`has`/`delete` arms that key on a bare
  // property NAME.
  if exprIsStrCpAt(exprIx, fnIx) { return emitStrCpAt(body, exprIx, fnIx) }
  if exprIsStrCpLen(exprIx, fnIx) { return emitStrCpLen(body, exprIx, fnIx) }
  if exprIsStrCharBoundary(exprIx, fnIx) {
    return emitStrIsCharBoundary(body, exprIx, fnIx)
  }
  if exprIsStrBytes(exprIx, fnIx) { return emitStrBytes(body, exprIx, fnIx) }
  // G8: the `Map()` builtin constructs an empty string-keyed map. `Set()` is a
  // boolean-valued string map over the SAME 7-field struct, so it emits the
  // IDENTICAL empty-map construction.
  const callee = P.nodes[e.callFn]
  if callee is Ident {
    // D975 — a user function named `Map`/`Set` owns its own name here too, for the reason
    // `emitCall`'s header gives: matching by spelling alone would build a fresh map instead
    // of calling it. A real constructor resolves to no function, so the lookup separates them.
    if fnIndexOfSid(sidOfNode(e.callFn)) < 0 {
      if callee.identName == "Map" || callee.identName == "Set" {
        return emitMapNew(body)
      }
    }
  }
  // G8: a map `m.has(k)` member-call yields a 0/1 i32 (linear scan).
  if callee is Member {
    if callee.memProp == "has" {
      if exprMap(callee.memObj, fnIx) {
        if e.callArgs.length != 1 {
          return emitFail("emitProgram: .has takes exactly one argument")
        }
        return emitMapHas(body, callee.memObj, e.callArgs[0], fnIx)
      }
    }
    // G8: a map `m.delete(k)` member-call in value position yields a 0/1 boolean (did a
    // key exist and get removed). The same lowering serves the bare-statement form.
    if callee.memProp == "delete" {
      if exprMap(callee.memObj, fnIx) {
        if e.callArgs.length != 1 {
          return emitFail("emitProgram: .delete takes exactly one argument")
        }
        return emitMapDelete(body, callee.memObj, e.callArgs[0], fnIx)
      }
    }
    // `m.keys()` over a map yields a fresh string list of its LIVE keys.
    if callee.memProp == "keys" {
      if exprMap(callee.memObj, fnIx) {
        if e.callArgs.length != 0 {
          return emitFail("emitProgram: .keys() takes no arguments")
        }
        return emitMapKeys(body, callee.memObj, fnIx)
      }
    }
    // `m.values()` over a mono i32 map yields a fresh i32 list of its LIVE values.
    if callee.memProp == "values" {
      if exprMap(callee.memObj, fnIx) {
        if e.callArgs.length != 0 {
          return emitFail("emitProgram: .values() takes no arguments")
        }
        return emitMapValues(body, callee.memObj, fnIx)
      }
    }
    // `xs.pop()` removes + returns the last list element (any list kind). The receiver
    // guard is the one the `map` / `filter` / `keys` / `values` / `get` neighbours all
    // carry: a non-list receiver falls through, so a function-valued struct FIELD named
    // `pop` is a `call_ref` member call like any other (D1087).
    if callee.memProp == "pop" {
      if popRecvIsList(callee.memObj, fnIx) {
        return emitPop(body, exprIx, fnIx, true, -1)
      }
    }
    // `xs.push(v)` in value position yields the new length — the `i32` the checker has
    // always given it (D1592). It rides the same receiver test as `.pop`, so a receiver
    // one lowers and the other refuses cannot exist.
    if callee.memProp == "push" {
      if popRecvIsList(callee.memObj, fnIx) {
        return emitPush(body, exprIx, fnIx, true)
      }
    }
    // `xs.get(i)` — the checked nullable list read, at every list rep. It is `.pop()`
    // with a bounds condition and no decrement, so it shares that body (D1281). A
    // non-list receiver still falls through — a map `.get(k)` and a function-valued
    // struct field named `get` are `emitCall`'s.
    if callee.memProp == "get" {
      if e.callArgs.length == 1 {
        if popRecvIsList(callee.memObj, fnIx) {
          return emitPop(body, exprIx, fnIx, true, e.callArgs[0])
        }
      }
    }
    // `xs.map(f)` / `xs.filter(p)` over a LIST receiver lower to the inline
    // closure-calling loop (Slices 3–4). A non-list receiver falls through (a
    // function-valued struct FIELD named `map` is a `call_ref` member call).
    if callee.memProp == "map" || callee.memProp == "filter" {
      if mfRecvKindOf(callee.memObj, fnIx) != null {
        return emitMapFilter(body, exprIx, fnIx)
      }
    }
  }
  return emitCall(body, exprIx, fnIx)
}

// the null-rep table: a bare `null` takes the rep the enclosing position seeded (one
// `pending*` flag per `X | null` boundary in this file, each mapped to its sentinel/heap
// in the arms below). Order is load-bearing: the niche arms come first, or the struct seed would claim them.
function emitNullLitNode(_body: i32[], _e: NullLit, _exprIx: i32, fnIx: i32) {
  emitNullBySeed(fnIx, false)
}

// The table above, asked of a value rather than a literal: `nulNoneOk` is the one caller
// holding a value whose type is `null` (D1576), changing only the last resort — with no
// seed, such a read is `ref.null none`. `pendingNulNone` reaches the same answer from a
// boundary whose cell is `nulnone`.
function emitNullBySeed(fnIx: i32, nulNoneOk: boolean) {
  if pendingNulBool {
    fbI32Const(2)
    return 0
  }
  if pendingNulLitUnion {
    fbI32Const(-1)
    return 0
  }
  if pendingNulString {
    wU8(208) // 0xd0 ref.null
    wSLEB(sTypeIdx)
    return 0
  }
  if pendingNulClosure {
    wU8(208) // 0xd0 ref.null
    wSLEB(cloStructIdx)
    return 0
  }
  if pendingNulList {
    wU8(208) // 0xd0 ref.null
    wSLEB(lTypeIdx)
    return 0
  }
  // Reset the seed after CONSUMING it, so it never persists past this `null` (a stray
  // non-(-1) value would mis-type a later bare `null`).
  if pendingNulRefHeap >= 0 {
    const nrh = pendingNulRefHeap
    pendingNulRefHeap = -1
    wU8(208) // 0xd0 ref.null
    wSLEB(nrh)
    return 0
  }
  // a bare `null` under a nullable-variant context: `ref.null $uVarHeap[vi]`, the variant
  // twin of the `pendingStructIdx` arm below. Persistent for the binding/return, since an
  // implicit tail `null` reaches this node after the one-shot seed above is consumed.
  if pendingVariantIdx >= 0 {
    if pendingVariantIdx < uVarHeap.length {
      wU8(208) // 0xd0 ref.null
      wSLEB(uVarHeap[pendingVariantIdx])
      return 0
    }
  }
  // last resort: the enclosing function's own return annotation. Every seed above is set
  // at a boundary and cleared after it, leaving tail position unserved — an implicit
  // tail `null` reaches this node with the statement seeds reset, while `return null` is
  // seeded. Reached only where nothing else claimed the null, so this converts a reject, never re-types a claimed one.
  if fnIx >= 0 {
    const nlFn = P.nodes[fnIx]
    if nlFn is FuncDecl {
      if nlFn.fnRet >= 0 {
        const nlVi = nulVariantIndexOf(nlFn.fnRet)
        if nlVi >= 0 && nlVi < uVarHeap.length {
          wU8(208) // 0xd0 ref.null
          wSLEB(uVarHeap[nlVi])
          return 0
        }
      }
    }
  }
  // A bare `null` VALUE: its target struct comes from the binding/argument/
  // return seed (`pendingStructIdx`) — `ref.null $S`. With no seed it cannot
  // be typed here; fail loudly.
  if pendingStructIdx >= 0 {
    if pendingStructIdx < sHeapIdx.length {
      wU8(208) // 0xd0 ref.null
      wSLEB(sHeapIdx[pendingStructIdx])
      return 0
    }
  }
  // D1567 — the `null` type's own rep, and the table's true last resort: a function whose
  // every returned value is a bare `null` types `TyPrim:null`, so no boundary seeds
  // anything. `nullref` is the GC bottom, a subtype of every nullable ref valtype, so it
  // needs no coercion at any ref destination (`emitDirectCall` converts the i32-repped ones).
  if fnIx >= 0 {
    const nnFn = P.nodes[fnIx]
    if nnFn is FuncDecl {
      if nnFn.fnRet < 0 {
        const nnPos = fnStmtsPosOf(fnIx)
        if nnPos >= 0 && nnPos < fRetKind.length {
          if fRetKind[nnPos] == "nulnone" {
            fbRefNullNone()
            return 0
          }
        }
      }
    }
  }
  if nulNoneOk || pendingNulNone {
    fbRefNullNone()
    return 0
  }
  return emitFail("emitProgram: bare null needs a struct-typed context")
}

function emitObjLitNode(body: i32[], _e: ObjLit, exprIx: i32, fnIx: i32) {
  // a context that expects a concrete variant constructs the bare variant struct, not a
  // union box; `pendingVariantIdx` is the variant, consumed so a nested literal doesn't
  // inherit the hint. Bounded, since the hint can be mis-paired — set from many sites,
  // some of which fall through to the struct table while the kind ladder said variant.
  if pendingVariantIdx >= 0 {
    const pvi = pendingVariantIdx
    pendingVariantIdx = -1
    if pvi < uVariants.length {
      return emitVariantStruct(body, exprIx, pvi, fnIx)
    }
  }
  // A literal whose field-set matches a STANDALONE struct constructs that struct
  // directly (even alongside a union — `ast.vl`'s `Tok`/`Diag` coexist with `Node`).
  // Otherwise, in a union program, it is a union variant: box it `{tag, value}`.
  if structIndexOfObj(exprIx) >= 0 { return emitObj(body, exprIx, fnIx) }
  if uDeclared { return emitUnionBox(body, exprIx, fnIx) }
  return emitObj(body, exprIx, fnIx)
}

function emitMemberNode(body: i32[], e: Member, exprIx: i32, fnIx: i32) {
  // `a.length` on an array or string receiver is a `struct.get` of the receiver's own
  // length field — the list wrapper's `len` (field 1) or the string header's `len`
  // (field 2), a code-point count. `length` over any other receiver falls through to the struct path.
  if e.memProp == "length" {
    if (
      exprArray(e.memObj, fnIx) ||
      exprString(e.memObj, fnIx) ||
      exprRefArray(e.memObj, fnIx) ||
      exprStringArray(e.memObj, fnIx) ||
      exprF64Array(e.memObj, fnIx) ||
      exprI64Array(e.memObj, fnIx) ||
      exprF32Array(e.memObj, fnIx) ||
      exprU8Array(e.memObj, fnIx)
    ) {
      return emitArrLen(body, exprIx, fnIx)
    }
    // G8: `m.length` on a MAP is the LIVE entry count — struct field 5 (`size`),
    // maintained by set/delete (NOT `count`, which includes tombstones).
    if exprMap(e.memObj, fnIx) {
      if emitExpr(body, e.memObj, fnIx) < 0 { return -1 }
      let lsl = mapShapeOfExpr(e.memObj, fnIx)
      lsl = mapShapeFoldSet(lsl)
      fbStructGet(mapTypeIdxOf(lsl), 5) // 0xfb 0x02: field 5 `size`
      return 0
    }
  }
  // `m.size` on a MAP / Set is the same live-entry count as `m.length` (field 5) — the
  // JS Map/Set name. (`.size` is not valid on arrays/strings; they fall through.)
  if e.memProp == "size" {
    if exprMap(e.memObj, fnIx) {
      if emitExpr(body, e.memObj, fnIx) < 0 { return -1 }
      let ssl = mapShapeOfExpr(e.memObj, fnIx)
      ssl = mapShapeFoldSet(ssl)
      fbStructGet(mapTypeIdxOf(ssl), 5) // 0xfb 0x02: field 5 `size`
      return 0
    }
  }
  return emitMem(body, exprIx, fnIx)
}

// The `%` lowering over two float operands: both at f64, then a call into the shared
// `__f64_rem__` helper (D1586). `atF32` re-encodes at f32 first so a literal like `0.1`
// uses f32's value, then promotes and demotes the exact result. The reservation is load-
// bearing: an unreserved helper is a `call` to index -1, so a miss fails loudly here first.
function emitF64RemCall(
  body: i32[],
  lIx: i32,
  rIx: i32,
  fnIx: i32,
  atF32: boolean,
) {
  if gHelpF64Rem < 0 {
    return emitFail(
      "emitProgram: a float '%' reached the emitter with no __f64_rem__ helper reserved",
    )
  }
  if atF32 {
    if emitExprAsF32(body, lIx, fnIx) < 0 { return -1 }
    fbF64PromoteF32()
    if emitExprAsF32(body, rIx, fnIx) < 0 { return -1 }
    fbF64PromoteF32()
  } else {
    if emitExprAsF64(body, lIx, fnIx) < 0 { return -1 }
    if emitExprAsF64(body, rIx, fnIx) < 0 { return -1 }
  }
  fbCall(gHelpF64Rem)
  if atF32 { fbF32DemoteF64() }
  0
}

function emitBinExprNode(body: i32[], e: BinExpr, exprIx: i32, fnIx: i32) {
  // Assignment (`=`) is a STATEMENT, not a value expression in this slice: it has
  // no result on the stack (it `local.set`s). It is lowered by `emitAssign` from
  // `emitStmt`, so seeing it as an operand here is an unsupported nested-assignment.
  if e.binOp == "=" {
    // Assignment is an expression yielding its right-hand side (DECISIONS:
    // assignment-as-expression), lowered as store-then-re-read — `emitAssign` stores, then
    // the target re-reads through the Ident path (a local or module global). The functype
    // must agree with the target cell's own storage class (`fnAssignRetKind`); D29 is the `string | null` half.
    const tgt = P.nodes[e.binLeft]
    if tgt is Ident {
      if emitAssign(body, exprIx, fnIx) < 0 { return -1 }
      return emitExpr(body, e.binLeft, fnIx)
    }
    return emitFail(
      "emitProgram: only an identifier assignment is a value expression",
    )
  }
  // G8: nullish-coalescing `m[k] ?? d` — a FUSED map get-with-default: scan `m` for
  // `k`, push `vals[hit]` on a hit else the default `d`. The self-host checker reads
  // every scope map through `?? -1`. The LHS must be a map index in this slice.
  if e.binOp == "??" { return emitCoalesce(body, e, exprIx, fnIx) }
  // Short-circuit `&&`/`||` lower to a value-typed `if` (blocktype 0x7f): `a && b` is `if (a)
  // { b } else { 0 }`, `a || b` is `if (a) { 1 } else { b }`. The right operand is a narrowing
  // scope like an `if` arm — `&&` narrows it with `setNarrowFromCond`, `||` with
  // `setNarrowFromCondElse`; skip that and a value-union box reaches an unnarrowed compare.
  if e.binOp == "&&" || e.binOp == "||" {
    if emitExpr(body, e.binLeft, fnIx) < 0 {
      return -1 // condition `a`
    }
    fbIf(127) // 0x04 if, 0x7f i32 result-type blocktype (yields an i32)
    const scTop = narrowTop
    if e.binOp == "&&" {
      // then = b, else = 0
      const scNarrowed = setNarrowFromCond(e.binLeft, fnIx)
      if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
      if scNarrowed { restoreNarrow(scTop) }
      fbElse() // 0x05 else
      fbI32Const(0)
    } else {
      // then = 1, else = b
      fbI32Const(1)
      fbElse() // 0x05 else
      const scNarrowedElse = setNarrowFromCondElse(e.binLeft, fnIx)
      if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
      if scNarrowedElse { restoreNarrow(scTop) }
    }
    fbEnd() // 0x0b end
    return 0
  }
  // Structural `==`/`!=` with a still-boxed value-union operand (either side, or both).
  // Checked before the string-eq routing, which would otherwise misclassify a union box
  // compared against a string as a bare string compare, and skips `null` literals — the
  // box-tag null compare below owns `v == null` (the host's `variantTag(info, null)` path).
  if e.binOp == "==" || e.binOp == "!=" {
    const uql = P.nodes[unwrapParen(e.binLeft)]
    const uqr = P.nodes[unwrapParen(e.binRight)]
    // Both sides bare `null` is static — true by the type alone, no rep needed. Without this,
    // each operand reaches `emitNullLitNode`, which needs a struct-typed context to pick a
    // heaptype; with no `T` anywhere, `print(null == null)` hits a loud `bare null needs a
    // struct-typed context` after a clean `vl check` (D1018).

    // Distinct from D20's family, which has a `T | null` and asks about that niche. Here there
    // is no `T`: an unconstrained hole resolves to bare `null`, and `null == null` is true by
    // the type alone.
    if uql is NullLit {
      if uqr is NullLit {
        if e.binOp == "==" { fbI32Const(1) } else { fbI32Const(0) }
        return 0
      }
    }
    let uqNull = false
    if uql is NullLit { uqNull = true }
    if uqr is NullLit { uqNull = true }
    // The litunion exclusion is per-operand, not per-compare — `exprUnion` also claims a
    // `K`-annotated binding, so this arm disqualifies the litunion operand rather than the
    // whole compare. Disqualifying the whole compare let `boxU == k` skip the union path when
    // one side is an atom, pushing the box ref under an `i32.eq`: `vl check` rc 0, invalid wasm.
    if !uqNull {
      const uqL = exprUnion(e.binLeft, fnIx) &&
        !eqAtomOperandOk(e.binLeft, fnIx)
      const uqR = exprUnion(e.binRight, fnIx) &&
        !eqAtomOperandOk(e.binRight, fnIx)
      if uqL && uqR {
        return emitUnionUnionEq(
          body,
          e.binLeft,
          e.binRight,
          e.binOp == "!=",
          fnIx,
        )
      }
      if uqL {
        return emitUnionConcreteEq(
          body,
          e.binLeft,
          e.binRight,
          e.binOp == "!=",
          fnIx,
        )
      }
      if uqR {
        return emitUnionConcreteEq(
          body,
          e.binRight,
          e.binLeft,
          e.binOp == "!=",
          fnIx,
        )
      }
    }
  }
  // A literal-union atom compare (`k == "a"`, `k1 == k2`) emits both operands as i32 ids (a
  // member `StrLit` as its id, a litunion var as its i32 value) and i32-compares, before the
  // string-eq path. Both operands must be atom-lowerable (`eqAtomOperandOk`); a mixed pair
  // falls through to string-eq instead, which widens the atom to its member string.
  if e.binOp == "==" || e.binOp == "!=" {
    // SKIP a `null` operand: `r == null` over a `K | null` niche is the `-1` sentinel compare (the
    // nullable-struct block below owns it). A litunion atom never equals the `null` literal here, and
    // lowering `null` with `pendingLitUnion` would mis-route it to a bare-null struct context.
    let atomNull = false
    if P.nodes[unwrapParen(e.binLeft)] is NullLit { atomNull = true }
    if P.nodes[unwrapParen(e.binRight)] is NullLit { atomNull = true }
    if !atomNull {
      if exprIsLitAtom(e.binLeft, fnIx) || exprIsLitAtom(e.binRight, fnIx) {
        if (
          eqAtomOperandOk(e.binLeft, fnIx) &&
          eqAtomOperandOk(e.binRight, fnIx)
        ) {
          const luCtx = expCtxHere()
          luCtx.litUnion = 1
          if emitExprExpect(body, e.binLeft, fnIx, luCtx) < 0 { return -1 }
          if emitExprExpect(body, e.binRight, fnIx, luCtx) < 0 { return -1 }
          fbI32Bin(70) // 0x46 i32.eq
          if e.binOp == "!=" {
            fbI32Eqz() // 0x45 i32.eqz -> `!=`
          }
          return 0
        }
      }
    }
  }
  // A `==`/`!=` over a nullable ref niche, plus the emitter-capability floor for a rep with no
  // compare core — both off the one comparability home (`nodeEqCmpKind`), the same function
  // the checker's acceptance reads. Comes before the string/list/struct/closure compares
  // below, which classify operands by their non-null rep and would ignore that the null can be there.

  // D1576 — `x == null` where `x` is the `null` type is statically true (`!=` false): both
  // operands are the value `null`, so there is no compare core to run. The niche dispatch
  // below reads each operand at a nullable rep and has no seed for a bare `null` beside a
  // `nulnone` value; `nulNoneEqSides` scopes it, evaluating the non-literal side for effect.
  if e.binOp == "==" || e.binOp == "!=" {
    if nulNoneEqSides(e.binLeft, e.binRight, fnIx) {
      if emitNulNoneForEffect(body, e.binLeft, fnIx) < 0 { return -1 }
      if emitNulNoneForEffect(body, e.binRight, fnIx) < 0 { return -1 }
      if e.binOp == "==" { fbI32Const(1) } else { fbI32Const(0) }
      return 0
    }
  }
  if e.binOp == "==" || e.binOp == "!=" {
    if binEqHasNoLowering(exprIx) {
      return emitFail(
        "emitProgram: `" +
          e.binOp +
          "` over this operand rep has no lowering",
      )
    }
    if binEqGRepUnresolved(exprIx, fnIx) {
      return emitFail(
        "emitProgram: the two operands of this list `" +
          e.binOp +
          "` do not resolve to one comparable list rep",
      )
    }
    const nulNiche = binEqNulNiche(exprIx, fnIx)
    if nulNiche != "" {
      if emitNulNicheEq(body, exprIx, fnIx, nulNiche) < 0 { return -1 }
      if e.binOp == "!=" {
        fbI32Eqz() // 0x45 i32.eqz — the wrapper always leaves the `==` answer
      }
      return 0
    }
  }
  // The `+` half of the same floor: a list concat whose element rep has no core. Above the
  // string/list dispatch below for the reason its `==` twin is — every classifier there reads
  // an operand by a rep it may not have — and above the numeric tail, which a list none of the
  // classifiers claim would otherwise reach.
  if binConcatRepUnresolved(exprIx, fnIx) {
    return emitFail(
      "emitProgram: the two operands of this list `+` do not resolve to one list rep",
    )
  }
  // G6 string operators (a string is a `(array i32)` of code points): `+` is a new
  // concatenated array; `==`/`!=` are element-wise value-equality, not ref identity — so they
  // take their own inline lowering before the i32 `binOpcode` path, which would emit `i32.eq`
  // (ref identity) for strings. Only string-typed operands route here.
  if exprIsStrConcat(exprIx, fnIx) { return emitStrConcat(body, exprIx, fnIx) }
  if exprIsStrEq(exprIx, fnIx) { return emitStrEq(body, exprIx, fnIx) }
  if exprIsStrOrder(exprIx, fnIx) { return emitStrOrder(body, exprIx, fnIx) }
  // List `==`/`!=` (length + element value-compare, recursive through nested lists/string
  // elements) and list `+` (concat) — collections-design §VL.4/§VL.6, inlined rather than
  // helper calls. List `+` over a rep other than the i32 list is checked above the compare
  // dispatch, because `listOpKindOfBin` claims a string list it has no concat for.
  if e.binOp == "+" {
    const catK = catListKindOfBin(exprIx, fnIx)
    if catK > 0 {
      return emitListConcatG(
        body,
        e.binLeft,
        e.binRight,
        fnIx,
        catK,
        catListSlotOfBin(exprIx, fnIx),
      )
    }
  }
  // the generic list compare — every list rep with no core of its own, above the
  // `listOpKindOfBin` branch because its own home already declines every shape that branch
  // claims, and below the `+` concat arm because the two operators never overlap.
  if e.binOp == "==" || e.binOp == "!=" {
    const gK = eqgListKindOfBin(exprIx, fnIx)
    if gK >= 0 {
      if emitExpr(body, e.binLeft, fnIx) < 0 { return -1 }
      if emitEqRecoverNarrowed(e.binLeft, fnIx) < 0 { return -1 }
      if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
      if emitEqRecoverNarrowed(e.binRight, fnIx) < 0 { return -1 }
      if emitListEqAnyRep(body, gK, eqgListSlotOfBin(exprIx, fnIx), fnIx) < 0 {
        return -1
      }
      if e.binOp == "!=" {
        fbI32Eqz() // 0x45 i32.eqz (`!=` negates value-equality)
      }
      return 0
    }
  }
  const lopK = listOpKindOfBin(exprIx, fnIx)
  if lopK >= 0 {
    if e.binOp == "+" {
      if lopK != 0 {
        return emitFail(
          "emitProgram: list concat over this element kind is not supported",
        )
      }
      return emitListConcatI(body, e.binLeft, e.binRight, fnIx)
    }
    if emitExpr(body, e.binLeft, fnIx) < 0 { return -1 }
    if emitEqRecoverNarrowed(e.binLeft, fnIx) < 0 { return -1 }
    if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
    if emitEqRecoverNarrowed(e.binRight, fnIx) < 0 { return -1 }
    if emitEqNonNullCore(body, exprIx, fnIx) < 0 { return -1 }
    if e.binOp == "!=" {
      fbI32Eqz() // 0x45 i32.eqz (`!=` negates value-equality)
    }
    return 0
  }
  // `x == null` / `x != null` over any NULLABLE value — the rep's own null test, never the
  // i32 compare. Checked before the structural string / struct / closure equality below,
  // each of which would compare a value against the `null` literal.
  if e.binOp == "==" || e.binOp == "!=" {
    const nlhs = P.nodes[e.binLeft]
    const nrhs = P.nodes[e.binRight]
    let nref = -1
    if nrhs is NullLit { nref = e.binLeft }
    if nlhs is NullLit { nref = e.binRight }
    if nref >= 0 {
      // The ladder is shared with the `is null` guard — the two spellings ask the same
      // question of the same rep, and `emitNulIsNullTest`'s header carries why they must
      // not be answered in only one place. `!=` is the INVERTED direction, which the ladder
      // emits directly (`i32.ne`) rather than leaving a caller to negate an `i32.eq`.
      const bnt = emitNulIsNullTest(body, nref, fnIx, e.binOp == "!=", false)
      if bnt < 0 { return -1 }
      if bnt > 0 { return 0 }
    }
    // Structural struct equality compares field-wise (`emitStructEq`), asked via
    // `structIndexOfExpr` and the variant twin `exprVariantIndex` — kind-gated storage-class
    // legs over the same nine, tried variant-first because two of `structIndexOfExpr`'s legs
    // are not kind-gated. Both declining falls to the i32 tail, an unreserved-field-slot risk (D57).
    const eqVi = binEqVariantRow(exprIx, fnIx)
    if eqVi >= 0 {
      return emitStructEq(body, exprIx, fnIx, eqRowOfVariant(eqVi))
    }
    const eqSi = binEqStructRow(exprIx, fnIx)
    if eqSi >= 0 { return emitStructEq(body, exprIx, fnIx, eqSi) }
    // The refusal spans both tables — either side naming a layout without the two agreeing is
    // a compare this emitter refuses rather than guesses at, matching D57 (an operand reaching
    // the i32 tail as a `(ref $uVarHeap[vi])`). Two arms of one union sharing a layout resolve
    // to different variant rows and fall to this same refusal, exactly as two disagreeing structs would.
    if (
      structIndexOfExpr(e.binLeft, fnIx) >= 0 ||
      structIndexOfExpr(e.binRight, fnIx) >= 0 ||
      exprVariantIndex(e.binLeft, fnIx) >= 0 ||
      exprVariantIndex(e.binRight, fnIx) >= 0
    ) {
      return emitFail("emitProgram: struct equality is not supported yet")
    }
    // Function-value `==`/`!=`: IDENTITY — the same lifted function (the id
    // field) AND the same captured env (`ref.eq`). Mirrors the host (same
    // table index AND same env; null == null envs are equal).
    if exprIsClosure(e.binLeft, fnIx) || exprIsClosure(e.binRight, fnIx) {
      if emitExpr(body, e.binLeft, fnIx) < 0 { return -1 }
      if emitEqRecoverNarrowed(e.binLeft, fnIx) < 0 { return -1 }
      if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
      if emitEqRecoverNarrowed(e.binRight, fnIx) < 0 { return -1 }
      if emitEqNonNullCore(body, exprIx, fnIx) < 0 { return -1 }
      if e.binOp == "!=" {
        fbI32Eqz() // 0x45 i32.eqz — negate identity-equality
      }
      return 0
    }
  }
  // Wide-scalar slices (f32, then f64, then i64 — one shape, three widths): if either operand
  // is of the width, emit that width's instruction and coerce the other first
  // (`emitExprAsF32`/`AsF64`/`AsI64`), covering both arithmetic and comparisons. The order is
  // load-bearing — f32 first because a float literal is `exprIsF64` too (`x + 4.0` with `x: f32` must route to f32), then f64, then i64.
  const lF32 = exprIsF32(e.binLeft, fnIx)
  const rF32 = exprIsF32(e.binRight, fnIx)
  // A GENUINE (non-literal) f64 operand makes the op f64 — the f32 side widens (`f32 + f64var`),
  // so route to the f64 slice below instead of demoting the f64 here (which trapped). A float
  // literal still adapts DOWN to the f32 operand, so `f32 + 1.0` stays on the f32 slice.
  if (lF32 || rF32) && !binMixHardF64(e.binLeft, e.binRight, fnIx) {
    // float remainder at f32 rides the f64 helper (D1586): an f32 operand is exact in f64,
    // the remainder of two f32-representable values is itself f32-representable, and every
    // step of the helper is exact — so promote / call / demote loses nothing. A second
    // helper would be the same algorithm at a narrower width for no gain.
    if e.binOp == "%" {
      if emitF64RemCall(body, e.binLeft, e.binRight, fnIx, true) < 0 {
        return -1
      }
      return 0
    }
    const opcF32 = binOpcodeF32(e.binOp)
    // No f32 form ⇒ fail, never fall through. Ops with no float form (`%`, bitwise, shift) are
    // integer-only in the checker, so this is unreachable from accepted source — it exists
    // because falling through reaches the i32 tail below, emitting an i32 opcode over a float
    // operand: invalid wasm the engine alone catches (`%` did exactly this before this backstop).
    if opcF32 < 0 {
      return emitFail("emitProgram: operator '" + e.binOp + "' has no f32 form")
    }
    if emitExprAsF32(body, e.binLeft, fnIx) < 0 { return -1 }
    if emitExprAsF32(body, e.binRight, fnIx) < 0 { return -1 }
    fbI32Bin(opcF32)
    return 0
  }
  // Slice 3 — f64.
  const lF64 = exprIsF64(e.binLeft, fnIx)
  const rF64 = exprIsF64(e.binRight, fnIx)
  if lF64 || rF64 {
    // float remainder — the one f64 operator with no instruction, so it calls the shared
    // `__f64_rem__` helper instead of taking an opcode from the table below (D1586).
    if e.binOp == "%" {
      if emitF64RemCall(body, e.binLeft, e.binRight, fnIx, false) < 0 {
        return -1
      }
      return 0
    }
    const opcF = binOpcodeF64(e.binOp)
    // NO f64 form ⇒ fail, never fall through — the f32 slice's reasoning, one width up.
    if opcF < 0 {
      return emitFail("emitProgram: operator '" + e.binOp + "' has no f64 form")
    }
    if emitExprAsF64(body, e.binLeft, fnIx) < 0 { return -1 }
    if emitExprAsF64(body, e.binRight, fnIx) < 0 { return -1 }
    fbI32Bin(opcF)
    return 0
  }
  // Slice 2 — i64 (also bitwise / shift).
  const lI64 = exprIsI64(e.binLeft, fnIx)
  const rI64 = exprIsI64(e.binRight, fnIx)
  if lI64 || rI64 {
    const opc64 = binOpcodeI64(e.binOp)
    if opc64 >= 0 {
      if emitExprAsI64(body, e.binLeft, fnIx) < 0 { return -1 }
      if emitExprAsI64(body, e.binRight, fnIx) < 0 { return -1 }
      fbI32Bin(opc64)
      return 0
    }
  }
  const opcode = binOpcode(e.binOp)
  if opcode < 0 { return emitFail("emitProgram: unsupported binary operator") }
  // Operands first (left then right), then the operator — wasm's stack order.
  if emitExpr(body, e.binLeft, fnIx) < 0 { return -1 }
  if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
  fbI32Bin(opcode)
  return 0
}

// The direct-call lowering for an `Ident` callee resolved to function index
// `target` (env-leading when `fnValUsed`): arguments reordered into parameter
// order and emitted per-parameter with the full coercion suite (struct/variant
// hints, union boxing, nullable bridging, float/i64 widening), then `call`.
function emitDirectCall(body: i32[], callIx: i32, fnIx: i32, target: i32) {
  // The callee's FuncDecl lives at `fnStmts[target]` (the function index is the fnStmts
  // position). Its parameter list lets a struct-literal argument construct as the callee's
  // declared param struct type rather than a field-name guess, fixing a struct argument
  // passed into a forward-referenced/mutually-recursive callee whose param struct shares field names with another struct.
  const cFn = P.nodes[fnStmts[target]]
  // Arguments in parameter order (host parity: `orderArgumentsByParameters` plus operands
  // built per-parameter). A call with no named args keeps its source list untouched; a named
  // call (`f(b: 1, a: 2)`) reorders here so each emitted operand lands on, and is typed by,
  // its declared parameter — including evaluation order, which follows parameter order too.
  const args = orderedDirectArgs(callIx, target)
  if directArgsBad(args, callIx) {
    return emitFail("emitProgram: named argument does not match a parameter")
  }
  // When a function value exists module-wide, EVERY callee carries a hidden leading
  // `structref env` param. A direct call to a top-level function (never capturing)
  // passes a null env. Pushed BEFORE the args, matching the env-leading signature.
  if fnValUsed { fbRefNullStruct() }
  // Each argument's valtype is decided by its parameter (`cParamF32`/`cParamF64`/`cParamI64`
  // below), so an enclosing position's wide-scalar context must not leak into the arg spine —
  // an uncleared `pendingF32` let a bare integer literal lower as `f32.const` into an i32
  // parameter, `vl check`-clean and unparseable. The litunion seeds follow the same rule.
  const savedArgF32 = pendingF32
  const savedArgF64 = pendingF64
  const savedArgLU = pendingLitUnion
  const savedArgNulLU = pendingNulLitUnion
  pendingF32 = false
  pendingF64 = false
  pendingLitUnion = 0
  pendingNulLitUnion = false
  let i = 0
  while i < args.length {
    // If this argument position is a struct-typed parameter, hint `emitObj` with the
    // callee's struct index (consumed by the immediately-following object-literal
    // lowering; a non-literal argument simply ignores it). Default -1 = infer.
    pendingStructIdx = -1
    pendingListKind = 0
    pendingListSlot = 0
    pendingI64 = false
    // D1223 — the map shape is the parameter's, never the enclosing position's. A bare
    // `Map()` self-identifies nothing and builds whatever `pendingMapSlot` names, so the
    // ambient seed is cleared here and re-seeded from the callee's own parameter below;
    // otherwise an outer destination's shape reaches an argument whose parameter is a different map.
    pendingMapSlot = -1
    // A variant-typed param position (kind 8): the callee wants the concrete variant struct
    // ref, but a union-valued argument (a narrowed local/param, a union-returning call) is the
    // box `{tag, value}`. Unbox to the param's variant struct — `struct.get $box 1 ; ref.cast
    // (ref $var)` — a statically safe cast since control reached this call only when narrowed to it.
    let cVi = -1
    // A non-null struct param position (kind 1, `(ref $S)`): a nullable-REP
    // argument needs `ref.as_non_null` at the boundary (see below).
    let cParamStruct = false
    // The non-null list / map param positions — every kind whose slot is a
    // `(ref $wrapper)` that a `(ref null $wrapper)` argument does not satisfy.
    // Same boundary recover as `cParamStruct`, over the reps owning a wrapper.
    let cParamNonNullList = false
    // The non-null closure param position (kind 14, `(ref $cloStruct)`) and the
    // non-null variant param position (kind 8, `(ref $uVarHeap[vi])`) — the two
    // remaining reps whose slot is a bare `(ref $heap)` a `(ref null $heap)`
    // argument does not satisfy. Same boundary recover as `cParamStruct`.
    let cParamClosure = false
    let cParamVariant = false
    // A UNION-typed param position (kind 4): the callee wants the box, so a raw
    // scalar/string/null argument is COERCED into the union representation
    // (`emitUnionCoerce` — the host's call-boundary `coerceUnion`). The param's
    // union NAME carries the atom set for the tag choice.
    let cUNm = ""
    // The niche `X | null` param positions. Each seeds the null rep its kind demands (the
    // table lives at `emitNullLitNode`) and leaves a non-null argument untouched; the two
    // list niches additionally let a list-value/literal argument build the wrapper it
    // subtypes. Kinds: 21 boolean, 16 string, 19 fn, 15 `i32[]`, 18 ref-array, and the distinct-backing scalar lists.
    let cParamNulBool = false
    let cParamNulString = false
    let cParamNulClosure = false
    let cParamNulList = false
    let cParamNulRefArr = false
    let cParamNulRefArrHeap = -1
    // A `Circle | null` param position: the heap type a bare `null` ARGUMENT lowers as
    // (`ref.null $uVarHeap[vi]`), `-1` for none. The variant twin of
    // `cParamNulRefArrHeap`, and it rides the SAME generic `nulRefHeap` seed.
    let cParamNulVariantHeap = -1
    // The other half of that niche: a `Circle | null` slot is `(ref null $uVarHeap[vi])`, so
    // an object literal in it must build the concrete variant struct rather than fall to
    // `emitObj`'s union-program default (`struct.new $Circle ; struct.new $uBox`), which is
    // `vl check`-clean and invalid at load (D22). Four positions seed this pair; this is the argument rung — `emitLetDeclStmt`, `emitReturnValue` and `emitAssign` seed the others.
    let cParamNulVariantIdx = -1
    let cParamNulSLKind: VKind | null = null
    // A literal-union param position: a member-literal argument lowers as its interned i32 id.
    let cParamLitUnion = false
    let cParamNulLitUnion = false
    // A `string` param position (kind 3): a literal-union atom ARGUMENT widens to its member
    // string at the boundary (the atom-as-string-subtype edge).
    let cParamStr = false
    // A ref-array param position's interned element ROW, for the read-only-covariance
    // widening (D791) — the same `tyAnnRefListSlot` the build seed below reads, kept
    // because the seed is cleared before the argument's widening can be asked.
    let cParamRlSlot = -1
    // The SCALAR-list dual of `cParamRlSlot` (D965) — the param's own list kind, so an
    // argument whose element STORAGE differs (`i32[]` into an `f64[]` param) can take the
    // converting copy at this boundary. `""` for every non-scalar-list param, which is
    // what makes the delivery below cost nothing in the ordinary case.
    let cParamSLKind: VKind | null = null
    if cFn is FuncDecl {
      const cParams = cFn.fnParams
      if i < cParams.length {
        const cpnb = P.nodes[cParams[i]]
        if cpnb is Param {
          if tyIsNulBool(cpnb.parType) { cParamNulBool = true }
          if retNulStringFlag(cpnb.parType) == 1 { cParamNulString = true }
          if nulCloFlag(cpnb.parType) == 1 { cParamNulClosure = true }
          if retNulListFlag(cpnb.parType) == 1 { cParamNulList = true }
          cParamNulSLKind = nulScalarListKindOfNode(cpnb.parType)
          if retNulVariantFlag(cpnb.parType) == 1 {
            const cpNvi = nulVariantIndexOf(cpnb.parType)
            if cpNvi >= 0 && cpNvi < uVarHeap.length {
              cParamNulVariantHeap = uVarHeap[cpNvi]
              cParamNulVariantIdx = cpNvi
            }
          }
          if retNulRefArrFlag(cpnb.parType) == 1 {
            cParamNulRefArr = true
            const cpRls = tyAnnRefListSlot(cpnb.parType)
            if cpRls >= 0 && cpRls < rlWrapIdx.length {
              cParamNulRefArrHeap = rlWrapIdx[cpRls]
            }
          }
          // the caller'S HALF of the same question the callee's body asks through
          // `exprIsLitAtom`. Both must use the alias-INDEX test or a narrowed-alias param is
          // declared `i32` while the member-literal argument is lowered as a string ref.
          if tyLitUnionAliasIx(nodeTyIxOf(cpnb.parType)) >= 0 {
            cParamLitUnion = true
          }
          // A `K | null` NICHE param: a member-literal arg (`f("a")`) lowers as its atom id
          // (`pendingLitUnion`), a `null` arg as the i32 sentinel `-1` (`pendingNulLitUnion`).
          if nodeTyIsNulLitUnion(cpnb.parType) { cParamNulLitUnion = true }
        }
        if vtKindOfParam(cParams[i]) == "str" { cParamStr = true }
        if (
          vtKindOfParam(cParams[i]) == "struct" ||
          vtKindOfParam(cParams[i]) == "nulstruct"
        ) {
          pendingStructIdx = paramStructIdxOf(cParams[i])
        }
        // A NULLABLE map param position (`{[string]: V} | null`, kind `nulmap`): a `null` argument
        // lowers as `ref.null $mapStruct` (the generic ref-null seed over THIS map's heap type). A
        // map-value argument is a variable that self-identifies its shape (`exprMap`), so it ignores
        // the seed. Mirrors the nulstruct `pendingStructIdx` seed above.
        if vtKindOfParam(cParams[i]) == "nulmap" {
          pendingNulRefHeap = mapTypeIdxOf(paramStructIdxOf(cParams[i]))
        }
        // D1223 — the `Map()` constructor's shape at the argument boundary, the seed its
        // sibling deliveries all have (`emitLetDeclStmt`'s annotation, `emitAssign`'s global
        // cell, `emitReturnValue`'s `retMap` arm). Without it `take(Map())` read the ambient -1
        // (the mono i32 map) while the param slot is the value-typed map struct: check-clean invalid wasm for every non-mono value type.
        const cpMapK = vtKindOfParam(cParams[i])
        if cpMapK == "map" || cpMapK == "nulmap" {
          pendingMapSlot = paramStructIdxOf(cParams[i])
        }
        if vtKindOfParam(cParams[i]) == "struct" { cParamStruct = true }
        const cpvk = vtKindOfParam(cParams[i])
        if (
          cpvk == "list" ||
          cpvk == "strlist" ||
          cpvk == "f64list" ||
          cpvk == "i64list" ||
          cpvk == "f32list" ||
          cpvk == "reflist" ||
          cpvk == "map"
        ) {
          cParamNonNullList = true
        }
        if cpvk == "closure" { cParamClosure = true }
        if vtKindOfParam(cParams[i]) == "variant" {
          cVi = paramStructIdxOf(cParams[i])
          cParamVariant = true
        }
        if vtKindOfParam(cParams[i]) == "union" {
          const cp4 = P.nodes[cParams[i]]
          if cp4 is Param { cUNm = tyNameOf(cp4.parType) }
        }
        // A ref-array param position (`take(xs: B[])`): seed the list context from the
        // param's annotation so a non-empty `B[]` LITERAL argument builds the param's
        // declared element type, not the first-element field-shape guess. Mirrors the
        // let / return / global seeding (consumed by `emitArr`).
        const cp = P.nodes[cParams[i]]
        if cp is Param {
          pendingListKind = tyAnnRefListKind(cp.parType)
          pendingListSlot = tyAnnRefListSlot(cp.parType)
          if vtKindOfParam(cParams[i]) == "reflist" {
            cParamRlSlot = tyAnnRefListSlot(cp.parType)
          }
          cParamSLKind = vtKindOfParam(cParams[i])
        }
        // An i64 param position lowers an integer-literal argument as `i64.const`.
        if vtKindOfParam(cParams[i]) == "i64" { pendingI64 = true }
      }
    }
    // An f64 / f32 param position lowers the argument coerced to that float type
    // (a float literal re-encodes; an i32/i64/f32 source converts via the lattice
    // helper). (Slice 3 f64; Slice 5 f32.)
    let cParamF64 = false
    let cParamF32 = false
    // An i64 param position widens a narrower (i32) argument at the call
    // boundary via `i64.extend_i32_s` — `emitExprAsI64` (a literal lowers as
    // `i64.const`; an i32 VARIABLE sign-extends). The value-preserving edge
    // the checker permits, mirroring the let / return widenings.
    let cParamI64 = false
    if cFn is FuncDecl {
      const cParams2 = cFn.fnParams
      if i < cParams2.length {
        if vtKindOfParam(cParams2[i]) == "f64" { cParamF64 = true }
        if vtKindOfParam(cParams2[i]) == "f32" { cParamF32 = true }
        if vtKindOfParam(cParams2[i]) == "i64" { cParamI64 = true }
      }
    }
    if cParamF32 {
      const savedF32 = pendingF32
      pendingF32 = true
      if emitExprAsF32(body, args[i], fnIx) < 0 { return -1 }
      pendingF32 = savedF32
      pendingStructIdx = -1
      pendingListKind = 0
      pendingListSlot = 0
      pendingI64 = false
      i = i + 1
    } else if cParamF64 {
      if emitExprAsF64(body, args[i], fnIx) < 0 { return -1 }
      pendingStructIdx = -1
      pendingListKind = 0
      pendingListSlot = 0
      pendingI64 = false
      i = i + 1
    } else if cParamI64 {
      if emitExprAsI64(body, args[i], fnIx) < 0 { return -1 }
      pendingStructIdx = -1
      pendingListKind = 0
      pendingListSlot = 0
      pendingI64 = false
      i = i + 1
    } else {
      if (cParamStr || cParamNulString) && exprIsLitAtom(args[i], fnIx) {
        // A literal-union atom flowing into a `string` param widens to its member string — and
        // into a `string | null` param for the same reason, the slot being that same reference
        // with a null permitted and a widened member string non-null. A `null` argument is not a
        // lit atom and still takes the `nulString`-seeded context below. (Shared tail resets `pending*` hints and advances `i`.)
        if emitAtomToStr(body, args[i], fnIx) < 0 { return -1 }
      } else if cUNm != "" {
        // `cUNm` is set only for a kind-4 union-BOX param (see above), so a concrete
        // variant ARGUMENT (`area(s)` where `s: S`, param `C | S`) is boxed here.
        if emitUnionBoxArg(body, cUNm, args[i], fnIx) < 0 { return -1 }
      } else {
        const argCtx = expCtxHere()
        // The parameter's nullability is assigned, never or'd with the enclosing position's.
        // `expCtxHere()` snapshots the ambient `pending*` seeds, which at a `return f(x)` are
        // the return boundary's; setting them only to true let a nullable result expectation
        // reach a non-nullable argument, keeping a narrowed value's `(ref null $s)` rep under a `(ref $s)` param.
        argCtx.nulBool = cParamNulBool
        argCtx.nulString = cParamNulString
        argCtx.nulClosure = cParamNulClosure
        argCtx.nulList = cParamNulList
        if cParamNulRefArr && cParamNulRefArrHeap >= 0 {
          // The #964 seed-leak gate (stated in full at `emitObj`'s code-28 arm) at the
          // ARGUMENT boundary. Witness: `useIt([null])` on a `(S | null)[] | null` param
          // (fuzz seed 160804094 d5).
          const nraArg = P.nodes[unwrapParen(args[i])]
          if nraArg is NullLit { argCtx.nulRefHeap = cParamNulRefArrHeap }
        }
        const argNulSLK = cParamNulSLKind
        if argNulSLK != null {
          // A list-literal argument builds the leaf wrapper; a `null` argument
          // is `ref.null $wrapper`. Mirrors the return-position seeding.
          argCtx.listKind = nulScalarListBuildKind(argNulSLK)
          argCtx.nulRefHeap = nulScalarListWrapHeap(argNulSLK)
        }
        if cParamNulVariantHeap >= 0 {
          const nvArg = P.nodes[args[i]]
          if nvArg is NullLit { argCtx.nulRefHeap = cParamNulVariantHeap }
        }
        // The non-null half of that niche (D22): an object literal builds the concrete
        // variant struct, which subtypes the `(ref null $uVarHeap[vi])` slot. Seeded
        // unconditionally, like the `cVi` variant-param seed below — `emitObj` alone consumes
        // the hint (`pendingVariantIdx`, cleared on use), so a variant/niche value argument ignores it.
        if cParamNulVariantIdx >= 0 { argCtx.variantIdx = cParamNulVariantIdx }
        if cParamLitUnion { argCtx.litUnion = 1 }
        if cParamNulLitUnion {
          argCtx.litUnion = 1
          argCtx.nulLitUnion = true
        }
        // A variant-PARAM position (`loud(c: Cat)`): seed the variant index so an object
        // LITERAL argument builds the bare variant struct (kind 8). A variant/union VALUE
        // argument ignores the hint (the union-unbox cast below handles a boxed value).
        if cVi >= 0 { argCtx.variantIdx = cVi }
        if emitExprExpect(body, args[i], fnIx, argCtx) < 0 { return -1 }
        // read-only covariance at the ARGUMENT boundary (D791) — `d773_readonly_param`:
        // `look(xs: Shape[])` called with a `Circle[]`.
        if cParamRlSlot >= 0 {
          emitRefListWidenSite(
            body,
            args[i],
            exprEmittedRefListSlot(args[i], fnIx),
            cParamRlSlot,
          )
        }
        // the scalar dual (D965) — `take_f(xs: f64[])` called with an `i32[]`. Same
        // boundary, same licence, a numeric convert instead of a box.
        if cParamSLKind != null {
          emitScalarListWidenSite(body, args[i], fnIx, cParamSLKind)
        }
        pendingVariantIdx = -1
        // A nullable-rep value (a null-narrowed `S | null` param/local, or a recursive `S |
        // null` field read whose wasm slot stays `(ref null $S)`) flowing into a non-null
        // `(ref $S)` param: recover the non-null ref at the call boundary. Narrowing is
        // type-level only, so the checker proves the value non-null but the stack value keeps its nullable rep — the cast never traps.
        if cParamStruct {
          if exprNullableStruct(args[i], fnIx) {
            fbRefAsNonNull() // 0xd4
          }
        }
        // The list/map dual of the recover above, over every nullable wrapper rep: `nullist`,
        // the four distinct-backing scalar lists, `nulreflist` and `nulmap`. A `!= null`-narrowed
        // value keeps its `(ref null $wrapper)` slot, so a call under the guard pushed it under
        // a `(ref $type)` param: check-clean invalid wasm. The recover cannot trap — the checker proved the call guarded.
        if cParamNonNullList {
          if (
            exprNullableList(args[i], fnIx) ||
            exprNulScalarListKind(args[i], fnIx) != null ||
            exprNullableRefArray(args[i], fnIx) ||
            exprNullableMap(args[i], fnIx)
          ) {
            fbRefAsNonNull() // 0xd4
          }
        }
        // The closure and variant duals of the two recovers above, the last two reps whose
        // param slot is a bare `(ref $heap)`. A narrowed callback forwarded in place needs no
        // coercion (`emitCallRef` recovers on its own); only the pass-through spelling is
        // invalid. The variant twin (`Circle | null` into `Circle`) is the same recover; both sit under the guard the checker proved, so neither traps.
        if cParamClosure {
          if exprNulClosure(args[i], fnIx) {
            fbRefAsNonNull() // 0xd4
          }
        }
        if cParamVariant {
          if exprNullableVariant(args[i], fnIx) {
            fbRefAsNonNull() // 0xd4
          }
        }
      }
      // The niche parameter's unbox (D1031) — `g(r)` into `g(x: Circle | null)` under `if r
      // is Circle`. The bare variant parameter's unbox is the arm below; its `| null` twin
      // declares the same heap with a nullable slot and never grew one, so the box went in
      // whole: `vl check` rc 0, invalid wasm. Guarded on `cVi` being absent so the two arms cannot both fire.
      if cVi < 0 && cParamNulVariantIdx >= 0 {
        if narrowedArmNeedsUnbox(args[i], fnIx) {
          emitNarrowedArmUnboxTo(
            armDestHeapOf("nulvariant", cParamNulVariantIdx),
          )
        }
      }
      if cVi >= 0 {
        if exprUnion(args[i], fnIx) {
          fbStructGet(uBoxIdx, 1)  // 0xfb 0x02 <box ht> field 1: value (anyref)
          fbRefCast(uVarHeap[cVi]) // 0xfb 0x16 <variant struct> ref.cast (non-null)
        }
      }
      pendingStructIdx = -1
      pendingListKind = 0
      pendingListSlot = 0
      pendingI64 = false
      i = i + 1
    }
  }
  pendingF32 = savedArgF32
  pendingF64 = savedArgF64
  pendingLitUnion = savedArgLU
  pendingNulLitUnion = savedArgNulLU
  fbCall(gImports + target) // 0x10 call (imports occupy indices 0..gImports-1)
  // Arm the tail-call cursor: if this call is still the last thing written when the
  // enclosing `return` terminates, it is in tail position and `emitUnionRetSink`
  // rewrites the pair into `return_call`.
  tailCallIdx = gImports + target
  tailCallEnd = wLen()
  // D1567 — a `nulnone` result at an i32-repped nullable destination. `nullref` subtypes
  // every nullable ref valtype, so struct/variant/string/list/map/closure destinations take
  // the result unchanged; the two niche nullables do not (`boolean | null` is sentinel 2, `K |
  // null` is sentinel -1), and storing a ref into either is invalid wasm the checker cannot see. Re-derive the rep at the site from the same two seeds `emitNullLitNode` reads.
  if fnPosRetIsNulNone(target) {
    if pendingNulBool || pendingNulLitUnion {
      fbDrop()
      if pendingNulBool { fbI32Const(2) } else { fbI32Const(0 - 1) }
      tailCallIdx = -1
    }
  }

  return 0
}

// The captured-call lowering for an `Ident` callee resolved to a CAPTURING lifted
// function at index `target`: build its closure value live (reading captures) and
// `call_ref` it (a plain `call` would pass a null env and lose the captures).
function emitCapturedCall(body: i32[], callIx: i32, fnIx: i32, target: i32) {
  // Stash the freshly-built closure, then call_ref it (same shape as emitCallRef
  // but the callee is a value we synthesize here, not an existing binding).
  if emitClosureValue(body, target, fnIx) < 0 { return -1 }
  fbLocalSet(callRefSlot)
  fbLocalGet(callRefSlot)
  fbStructGet(cloStructIdx, 0) // env
  // Parameter-order args (named-call reorder; see the direct path below).
  const cargs = orderedDirectArgs(callIx, target)
  if directArgsBad(cargs, callIx) {
    return emitFail("emitProgram: named argument does not match a parameter")
  }
  // Per-parameter argument coercion for the fourth `call_ref` reach (a nested capturing
  // function called by name): the spine pushed every argument raw against the callee's own
  // declared functype. Three kinds are check-clean invalid wasm without this — a union box, an
  // i64/f64/f32 mismatch, and a litunion — each coerced the way the direct twin coerces, safe by construction since each arm fires only where the raw push is already wrong.
  const cfn = P.nodes[fnStmts[target]]
  let cps: i32[] = []
  if cfn is FuncDecl { cps = cfn.fnParams }
  const savedCapLU = pendingLitUnion
  const savedCapNulLU = pendingNulLitUnion
  pendingLitUnion = 0
  pendingNulLitUnion = false
  let cai = 0
  while cai < cargs.length {
    let cuNm = ""
    let cpKind: VKind = "i32"
    let cpLit = false
    if cai < cps.length {
      cpKind = vtKindOfParam(cps[cai])
      const cpn = P.nodes[cps[cai]]
      if cpn is Param {
        if cpKind == "union" { cuNm = tyNameOf(cpn.parType) }
        // Alias-INDEX, so a NARROWED copy is recognized — the captured-call twin of the
        // direct call's `cParamLitUnion`.
        if tyLitUnionAliasIx(nodeTyIxOf(cpn.parType)) >= 0 { cpLit = true }
        if nodeTyIsNulLitUnion(cpn.parType) { cpLit = true }
      }
    }
    if cuNm != "" {
      if emitUnionBoxArg(body, cuNm, cargs[cai], fnIx) < 0 { return -1 }
    } else if cpKind == "i64" {
      if emitExprAsI64(body, cargs[cai], fnIx) < 0 { return -1 }
    } else if cpKind == "f64" {
      if emitExprAsF64(body, cargs[cai], fnIx) < 0 { return -1 }
    } else if cpKind == "f32" {
      if emitExprAsF32(body, cargs[cai], fnIx) < 0 { return -1 }
    } else if cpLit {
      const cluCtx = expCtxHere()
      cluCtx.litUnion = 1
      if emitExprExpect(body, cargs[cai], fnIx, cluCtx) < 0 { return -1 }
    } else if cpKind == "str" && exprIsLitAtom(cargs[cai], fnIx) {
      // The MIRROR of `cpLit`: a literal-union ATOM argument into a `string` parameter
      // widens to its member string, the edge the direct twin takes as `cParamStr`.
      if emitAtomToStr(body, cargs[cai], fnIx) < 0 { return -1 }
    } else {
      if emitExpr(body, cargs[cai], fnIx) < 0 { return -1 }
    }
    cai = cai + 1
  }
  pendingLitUnion = savedCapLU
  pendingNulLitUnion = savedCapNulLU
  // The target's own interned `$fnsig` — the functype it is actually declared with — so the
  // `call_indirect` below passes the engine's signature check and returns the target's real
  // result type. Must be resolved from the target, never from arity alone: `fnSigIdxForArity`
  // only keys `(structref, i32 * ar) -> i32`, which misclassifies any non-i32 param or result. `fnSigIdxOfFn` is the same seam `.map`/`.filter` resolve a named-function callback through.
  const csig = fnSigIdxOfFn(target)
  if csig < 0 {
    return emitFail(
      "emitProgram: captured call target has no interned signature",
    )
  }
  fbLocalGet(callRefSlot)
  fbStructGet(cloStructIdx, 1)      // the callee's wasm function index
  fbCallIndirect(csig, gFnTableIdx) // 0x11 <fnsig> <table>
  return 0
}

// The `__array_new__(n, fill)` / `__array_new_default__(n)` intrinsic lowering.
function emitArrayNewIntr(body: i32[], callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Ident {
      const anIsNew = callee.identName == "__array_new__"
      let anWant = 1
      if anIsNew { anWant = 2 }
      if c.callArgs.length != anWant {
        return emitFail(
          "emitProgram: " +
            callee.identName +
            " takes exactly " +
            i32ToStr(anWant) +
            " argument(s)",
        )
      }
      let anBack = aTypeIdx
      let anWrap = lTypeIdx
      // The element struct for a kind-3 (ref) fill — seeds `pendingStructIdx`
      // so the `{…}` fill emits as the list's declared element struct.
      let anElemStructIdx = -1
      // The `__array_new__` fill twin of the store/push variant hint (D796).
      let anElemVariantIdx = -1
      const ank = arrNewIntrKind(callIx, fnIx)
      if ank == 1 {
        if !fa64Used {
          return emitFail(
            "emitProgram: __array_new__ f64 fill but f64 list types not collected",
          )
        }
        anBack = fa64TypeIdx
        anWrap = fl64TypeIdx
      } else if ank == 4 {
        // D963 — I64 fill → the i64 list pair.
        if !ia64Used {
          return emitFail(
            "emitProgram: __array_new__ i64 fill but i64 list types not collected",
          )
        }
        anBack = ia64TypeIdx
        anWrap = il64TypeIdx
      } else if ank == 5 {
        // D1470 — the PACKED byte list. Reachable only from `__array_new_default__`
        // (`arrNewDefaultKind`): `array.new_default` zeroes an `i8` slot exactly as it
        // zeroes an `i32` one, so the destination's own pair is all this needs.
        if !ba8Used {
          return emitFail(
            "emitProgram: __array_new_default__ u8 element but u8 list types not collected",
          )
        }
        anBack = ba8TypeIdx
        anWrap = bl8TypeIdx
      } else if ank == 6 {
        // D1470 — the f32 list. The `__array_new__` f32 FILL is still refused below; the
        // difference is real, not an oversight: a fill has to re-encode an f64-typed
        // literal into the slot, which is where that arm produced invalid wasm, and
        // `array.new_default` writes the zero with no operand to encode.
        if !fa32Used {
          return emitFail(
            "emitProgram: __array_new_default__ f32 element but f32 list types not collected",
          )
        }
        anBack = fa32TypeIdx
        anWrap = fl32TypeIdx
      } else if ank == 2 {
        // STRING fill → the string list (`array.new` of the shared string-ref
        // backing; a non-null string ref stores into the nullable slot directly).
        if !slUsed {
          return emitFail(
            "emitProgram: __array_new__ string fill but string list types not collected",
          )
        }
        anBack = mkArrIdx
        anWrap = mkListIdx
      } else if ank == 3 {
        // STRUCT fill → the ref list of the element struct (its interned slot).
        if !rlUsed {
          return emitFail(
            "emitProgram: __array_new__ struct fill but ref list types not collected",
          )
        }
        // The STRICT slot: this arm picks the list's backing and wrapper heap types, so an
        // unresolved element must refuse, not clamp. Slot 0 is a real row, and clamping to
        // it built the module at whichever element interned first (D1605).
        const anSlot = refListSlotOfExprStrict(callIx, fnIx)
        const anBad = anSlot >= rlWrapIdx.length || anSlot >= rlBackIdx.length
        if anSlot < 0 || anBad {
          return emitFail(
            "emitProgram: __array_new__ fill type not yet supported natively",
          )
        }
        anBack = rlBackIdx[anSlot]
        anWrap = rlWrapIdx[anSlot]
        anElemStructIdx = rlElemStructRow(anSlot)
        if anElemStructIdx < 0 {
          anElemVariantIdx = variantIndexOf(nonNulBaseOf(rlElemName[anSlot]))
        }
      } else {
        if !aUsed || !lUsed {
          return emitFail(
            "emitProgram: array intrinsic but list types not collected",
          )
        }
        if anIsNew {
          const anFill = c.callArgs[1]
          const anFillNode = P.nodes[anFill]
          // D963 — the i64 guard once here is gone: the i64 pair is interned today, so that
          // fill is kind 4 above and never reaches this fall-through. A stale reason in a
          // refusal is still a refusal.

          // The f32 guard stays, not because the reason is less stale — `f32[]` indexes and
          // reads fine, but the identical wiring for the f32 pair emits invalid wasm, so
          // something else differs there. This note flags that the sentence below is not the actual reason.
          if exprIsF32(anFill, fnIx) {
            return emitFail(
              "emitProgram: __array_new__ f32 fill — f32-element arrays are not supported yet",
            )
          }
          let anFillRef = false
          if anFillNode is ObjLit { anFillRef = true }
          if exprIsClosure(anFill, fnIx) { anFillRef = true }
          if exprArray(anFill, fnIx) { anFillRef = true }
          if exprRefArray(anFill, fnIx) { anFillRef = true }
          if exprStringArray(anFill, fnIx) { anFillRef = true }
          if exprMap(anFill, fnIx) { anFillRef = true }
          if anFillRef {
            // Remaining ref-fill long tail: closures / nested arrays / maps.
            return emitFail(
              "emitProgram: __array_new__ fill type not yet supported natively",
            )
          }
        }
      }
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      fbLocalSet(arrNewScratchBase)
      if anIsNew {
        pendingStructIdx = anElemStructIdx
        const savedAVI = pendingVariantIdx
        if anElemVariantIdx >= 0 { pendingVariantIdx = anElemVariantIdx }
        if emitExpr(body, c.callArgs[1], fnIx) < 0 { return -1 }
        pendingStructIdx = -1
        pendingVariantIdx = savedAVI
        fbLocalGet(arrNewScratchBase)
        fbArrayNew(anBack)
      } else {
        fbLocalGet(arrNewScratchBase)
        fbArrayNewDefault(anBack)
      }
      fbLocalGet(arrNewScratchBase)
      fbLocalGet(arrNewScratchBase)
      fbStructNew(anWrap)
      return 0
    }
  }
  emitFail("emitProgram: emitArrayNewIntr expected an __array_new__ call")
}

// The `__array_copy__(dst, dstAt, src, srcAt, count)` intrinsic lowering.
function emitArrayCopyIntr(body: i32[], callIx: i32, fnIx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const callee = P.nodes[c.callFn]
    if callee is Ident {
      if c.callArgs.length != 5 {
        return emitFail(
          "emitProgram: __array_copy__ takes exactly five arguments",
        )
      }
      const acDstF64 = exprF64Array(c.callArgs[0], fnIx)
      const acSrcF64 = exprF64Array(c.callArgs[2], fnIx)
      if acDstF64 != acSrcF64 {
        return emitFail(
          "emitProgram: __array_copy__ dst and src must share one element type",
        )
      }
      let acBack = aTypeIdx
      let acWrap = lTypeIdx
      if acDstF64 {
        if !fa64Used {
          return emitFail(
            "emitProgram: __array_copy__ f64 lists but f64 list types not collected",
          )
        }
        acBack = fa64TypeIdx
        acWrap = fl64TypeIdx
      } else {
        if (
          exprRefArray(c.callArgs[0], fnIx) ||
          exprStringArray(c.callArgs[0], fnIx) ||
          exprRefArray(c.callArgs[2], fnIx) ||
          exprStringArray(c.callArgs[2], fnIx)
        ) {
          return emitFail(
            "emitProgram: __array_copy__ supports i32/boolean/f64 lists natively",
          )
        }
        if (
          !exprArray(c.callArgs[0], fnIx) ||
          !exprArray(c.callArgs[2], fnIx)
        ) {
          return emitFail(
            "emitProgram: __array_copy__ expects list (T[]) operands",
          )
        }
        if !aUsed || !lUsed {
          return emitFail(
            "emitProgram: array intrinsic but list types not collected",
          )
        }
      }
      if emitExpr(body, c.callArgs[0], fnIx) < 0 { return -1 }
      fbStructGet(acWrap, 0)
      if emitExpr(body, c.callArgs[1], fnIx) < 0 { return -1 }
      if emitExpr(body, c.callArgs[2], fnIx) < 0 { return -1 }
      fbStructGet(acWrap, 0)
      if emitExpr(body, c.callArgs[3], fnIx) < 0 { return -1 }
      if emitExpr(body, c.callArgs[4], fnIx) < 0 { return -1 }
      fbArrayCopy(acBack, acBack)
      return 0
    }
  }
  emitFail("emitProgram: emitArrayCopyIntr expected an __array_copy__ call")
}

// The fused map/list/struct nullish-coalescing lowering (`emitBinExprNode`'s `??` arm).
// Whether the `string | null` `??` node at `exprIx` lowers with a nullable result — i.e.
// whether its value `if` declares `(ref null $aTypeIdx)` rather than `(ref $aTypeIdx)`.

// The result type is the default's null-ness, not a constant: a non-null default collapses
// the read to `string` (`coalesceStaysNullable`), a nullable default leaves it `string | null`.
// It asks `exprNullableString` of the `??` node itself, since the checker's banked type is
// missing on a synthesized node (a chained `p ?? q ?? r` re-associates through `mkBinary`).
function coalesceNulStrStaysNullable(exprIx: i32, fnIx: i32) {
  nulStrReadStaysRaw() && exprNullableString(exprIx, fnIx)
}

// The context one arm of a `string | null` `??` emits under: `raw` iff the arm's value may be
// left as `(ref null $aTypeIdx)`, exactly the block type the lowering just declared.

// Both halves of the read gate are overridden, not just `rawNullRead` — the arms otherwise
// inherit the ambient `pendingNulString` from the consumer, and a nullable-string binding with
// a non-null default read its arms raw inside a `(ref $aTypeIdx)` block. `nulStrReadStaysRaw`
// is the disjunction: "recover" clears both flags, "stay raw" sets both.
function coalesceNulStrArmCtx(raw: boolean): ExpCtx {
  const c = expCtxHere()
  c.rawNullRead = raw
  c.nulString = raw
  return c
}

// The context the DEFAULT arm of a `K | null` `??` emits under: a member `StrLit` / `NumLit`
// default lowers as its interned ATOM ID (`litUnion`) and a bare `null` default as the spare
// sentinel `-1` (`nulLitUnion`) — the same pair the `v = "b"` / `v = null` assignment
// boundary seeds for the identical cell, because both are "produce this niche's i32".
function coalesceNulLitUnionArmCtx(): ExpCtx {
  const c = expCtxHere()
  c.nulLitUnion = true
  c.litUnion = 1
  return c
}

// The context the default arm of a nullable-collection `??` emits under: a list literal
// default builds this cell's backing (`listKind`/`listSlot`) and a bare `null` default the
// matching `ref.null`, both keyed off the LHS place whose rep the block type declares — the
// same two homes the assignment boundary reads (`exprListCellBuildKind`/`exprListCellBuildSlot`).

// `nulList` is the i32-backed family's flag and `nulRefHeap` every other family's wrapper, so
// `nulCollWrapHeap` supplies the latter directly rather than re-deriving the family.
function coalesceNulCollArmCtx(lhsIx: i32, wrapIx: i32, fnIx: i32): ExpCtx {
  const c = expCtxHere()
  c.listKind = exprListCellBuildKind(lhsIx, fnIx)
  c.listSlot = exprListCellBuildSlot(lhsIx, fnIx)
  if exprNullableList(lhsIx, fnIx) {
    c.nulList = true
  } else {
    c.nulRefHeap = wrapIx
  }
  return c
}

// The `br_on_non_null` core every nullable-ref-niche `??` shares, with both contexts and the
// block's null-ness spelled out by the caller. `heapIx` is the cell's own heap type,
// `nulBlock` whether the result may still be null, `lhsCtx` the context the one lhs evaluation
// runs under and `defCtx` the context the default arm emits under.

// One evaluation, no stash, no re-read, and it short-circuits: `br_on_non_null` consumes the
// nullable ref and either branches out carrying `(ref $heapIx)` or falls through to the
// default, covering every lhs source with one arm — the narrow is the branch, so there is no
// separate narrow step to miss (the list-index lhs is where the replaced re-read shape broke).
function emitCoalesceNulRefCtx(
  body: i32[],
  e: BinExpr,
  heapIx: i32,
  nulBlock: boolean,
  lhsCtx: ExpCtx,
  defCtx: ExpCtx,
  fnIx: i32,
) {
  wU8(2) // 0x02 block
  if nulBlock {
    wU8(99) // blocktype: (ref null $heapIx) — the result stays nullable
  } else {
    wU8(100) // blocktype: (ref $heapIx) — the non-null result
  }
  wSLEB(heapIx)
  ctrlEnter()
  if emitExprExpect(body, e.binLeft, fnIx, lhsCtx) < 0 {
    return -1 // the nullable ref, evaluated ONCE
  }
  wU8(214) // 0xd6 br_on_non_null
  wULEB(0) //   non-null → branch to the block end with the (ref $heapIx)
  if emitExprExpect(body, e.binRight, fnIx, defCtx) < 0 { return -1 }
  wU8(11) // 0x0b end
  ctrlLeave()
  0
}

// The core above for the nullable struct (`S | null`) and nullable collections (`i32[] |
// null`, `string[] | null`, …): the lhs takes the ambient seeds (these reps have no
// self-recovering read) and the block type is the default's null-ness
// (`coalesceDefaultNullable`) — a non-null default collapses to `(ref $heapIx)`, a nullable one leaves it nullable, since `br_on_non_null` branches with `(ref $heapIx)`, a subtype of both.
function emitCoalesceNulRef(
  body: i32[],
  e: BinExpr,
  heapIx: i32,
  defCtx: ExpCtx,
  fnIx: i32,
) {
  emitCoalesceNulRefCtx(
    body,
    e,
    heapIx,
    coalesceDefaultNullable(e.binRight, fnIx),
    expCtxHere(),
    defCtx,
    fnIx,
  )
}

function emitCoalesce(body: i32[], e: BinExpr, exprIx: i32, fnIx: i32) {
  // Unwrap a parenthesized lhs so `(m[k]) ?? d` / `(m.get(k)) ?? d` take the same fused
  // map-get path as the bare forms — parens must not change `??` semantics. `lhsIx` is the
  // unwrapped place every structural branch below dispatches on; the generic niche paths
  // re-evaluate `e.binLeft` directly and already peel parens, so they are unaffected.
  const lhsIx = unwrapParen(e.binLeft)
  const lhs = P.nodes[lhsIx]
  // `a ?? b ?? d` parses LEFT-associative (`(a ?? b) ?? d`); `??` is
  // associative, so RE-ASSOCIATE to `a ?? (b ?? d)` — the inner coalesce
  // becomes the outer's default and each LHS is again a plain place the
  // single-step lowerings below handle (host: same chained-coalesce value).
  if lhs is BinExpr {
    if lhs.binOp == "??" {
      return emitExpr(
        body,
        mkBinary(
          "??",
          lhs.binLeft,
          mkBinary("??", lhs.binRight, e.binRight, -1),
          -1,
        ),
        fnIx,
      )
    }
  }
  // D1576 — the `null` type on the left makes the operand dead, the mirror of the narrowing
  // rule below. A never-filled `let x = null` binding (or a `nulnone`-returning call) is
  // statically null, so `x ?? d` is `d`: there is no niche to test, and every arm below would
  // read the operand at a nullable rep this value lacks. The operand is still evaluated and dropped for effect.
  if exprIsNulNone(lhsIx, fnIx) {
    if emitNulNoneForEffect(body, lhsIx, fnIx) < 0 { return -1 }
    return emitExpr(body, e.binRight, fnIx)
  }
  // A narrowing that excludes null makes the default dead: `x ?? d` is `x` there, and the
  // read is the only lowering whose rep can be right. Every niche arm below evaluates its lhs
  // at the declared nullable rep, while `emitIdentNode` reads a narrowed binding at the arm's
  // rep — the mismatch made `if x != null { print(x ?? 0) }` a `vl check`-clean module the engine rejected with `expected (ref null $type), found i32`.

  // The default is not evaluated, which is what `??` means — the rule every arm below holds,
  // over every rep and every lhs source.
  if lhs is Ident {
    if narrowExcludesNull(lhs.identName) { return emitExpr(body, lhsIx, fnIx) }
  }
  if lhs is Index {
    if exprMap(lhs.idxArr, fnIx) {
      return emitMapGetOr(body, lhs.idxArr, lhs.idxIndex, e.binRight, fnIx)
    }
  }
  // The METHOD form `recv.get(k) ?? d` over a map receiver is the SAME fused
  // get-with-default as `recv[k] ?? d` — lower it identically. (The LIST `.get`
  // at ~6890 is a distinct struct-element get and is NOT a map; `exprMap` gates
  // this to map receivers only.)
  if lhs is Call {
    const lcallee = P.nodes[lhs.callFn]
    if lcallee is Member {
      if lcallee.memProp == "get" {
        if exprMap(lcallee.memObj, fnIx) {
          if lhs.callArgs.length != 1 {
            return emitFail("emitProgram: map .get takes exactly one argument")
          }
          return emitMapGetOr(
            body,
            lcallee.memObj,
            lhs.callArgs[0],
            e.binRight,
            fnIx,
          )
        }
        // `xs.get(i) ?? d` over a SCALAR-element list (i32 / boolean / f64) is
        // the FUSED checked read-with-default (B6) — one bounds compare.
        if (
          exprF64Array(lcallee.memObj, fnIx) ||
          exprArray(lcallee.memObj, fnIx)
        ) {
          return emitListGetOr(body, lhsIx, e.binRight, fnIx)
        }
      }
      // `xs.pop() ?? d` over an i32-element list is the fused checked pop-with-default:
      // `len != 0` selects decrement-and-read or `d`.

      // Gated on the one-home discriminator, not an exclusion list. `emitPopOr` reads
      // `lTypeIdx`/`aTypeIdx` unconditionally, and the hand-written `!ref && !string && !f64`
      // exclusion let `i64[]`, `f32[]` and `u8[]` into a lowering that reads their wrapper
      // through the i32 heap type: check-clean invalid wasm. `scalarListElemKind` is the discriminator every other scalar-list op selects a rep with.
      if lcallee.memProp == "pop" {
        if scalarListElemKind(lcallee.memObj, fnIx) == "i32" {
          if (
            !exprRefArray(lcallee.memObj, fnIx) &&
            !exprStringArray(lcallee.memObj, fnIx)
          ) {
            return emitPopOr(body, lhsIx, e.binRight, fnIx)
          }
        }
      }
    }
  }
  // These generic niche `??` paths RE-EVALUATE `e.binLeft` (twice for the bool select,
  // and in the else arm for the string), so they apply only to an effect-free place —
  // an ident binding or a struct FIELD. A CALL lhs (`f() ?? d`) cannot be re-evaluated
  // and is handled by the stash-based call path in the `lhs is Call` block below.
  let lhsReEval = true
  if lhs is Call { lhsReEval = false }
  // D1250 — AN IF-expression operand IS NOT RE-READABLE. Its condition can have effects, and
  // re-reading it re-runs them: `(if bump() { true }) ?? false` bumped TWICE. The arms below
  // that already carry a stash leg read this flag, so they switch over; the `boolean | null`
  // arm gained one for the same reason. `coalChainHasCallLhs` reserves the slots.
  if lhs is IfStmt { lhsReEval = false }
  // `<e> ?? d` over a `boolean | null` niche (an ident binding, a `boolean | null` struct field,
  // or a `(boolean | null)[]` element read) — the i32 cell holds 0/1 or the sentinel 2
  // (`null`); take the default on 2. Generic in `e.binLeft`, so one arm covers every
  // re-readable place.

  // A branching `if` over the 0x7f blocktype, which is what `??` means: the default runs only
  // when the lhs is null. `select` evaluates both value operands unconditionally, so a
  // side-effecting default would run on the present path too — the same lowering the `K |
  // null` niche, the `string | null` niche and every nullable-ref rep already use.
  if !(lhs is Call) && exprNulBool(e.binLeft, fnIx) {
    if emitExpr(body, e.binLeft, fnIx) < 0 {
      return -1 // the niche i32
    }
    // D1250 — a NON-RE-READABLE operand (an if-EXPRESSION) stashes its ONE evaluation, exactly
    // as the `K | null` arm below does; a place operand keeps the re-read, byte-identical.
    if !lhsReEval {
      fbLocalSet(coalesceCallBoolSlot)
      fbLocalGet(coalesceCallBoolSlot)
    }
    fbI32Const(2)
    fbI32Bin(70) // 0x46 i32.eq → x == 2 (null)
    fbIf(127)    // 0x04 if, 0x7f i32 blocktype
    ctrlEnter()
    if emitExpr(body, e.binRight, fnIx) < 0 {
      return -1 // d, reached only on the null path
    }
    fbElse() // 0x05 else — present → the 0/1 cell
    if lhsReEval {
      if emitExpr(body, e.binLeft, fnIx) < 0 { return -1 }
    } else {
      fbLocalGet(coalesceCallBoolSlot)
    }
    fbEnd() // 0x0b end
    ctrlLeave()
    return 0
  }
  // `<e> ?? d` over a `K | null` niche (ident/param/global, a struct field, an element read, or
  // a returning call). The i32 cell holds an interned atom id (>= 0) or sentinel `-1`, so the
  // null test is the `-1` compare and the block type is unconditional `0x7f`.
  // `coalesceLitUnionFits` is the one claim deciding whether the rep survives the default, so `k ?? "zz"` declines here and keeps its loud reject.

  // A branching `if`, not a `select`: `select` evaluates both value operands, so a
  // side-effecting default would run on the present path. The `if` framing costs three bytes
  // more per site; a call lhs is stashed once in the shared i32 coalesce-call slot.
  if coalesceLitUnionFits(exprIx, fnIx) {
    if emitExpr(body, e.binLeft, fnIx) < 0 {
      return -1 // the niche i32, evaluated ONCE
    }
    if !lhsReEval {
      fbLocalSet(coalesceCallBoolSlot)
      fbLocalGet(coalesceCallBoolSlot)
    }
    fbI32Const(-1)
    fbI32Bin(70) // 0x46 i32.eq → x == -1 (null)
    fbIf(127)    // 0x04 if, 0x7f i32 blocktype
    ctrlEnter()
    if emitExprExpect(body, e.binRight, fnIx, coalesceNulLitUnionArmCtx()) < 0 {
      return -1 // d, as this niche's i32
    }
    fbElse() // 0x05 else — present → the atom id
    if lhsReEval {
      if emitExpr(body, e.binLeft, fnIx) < 0 { return -1 }
    } else {
      fbLocalGet(coalesceCallBoolSlot)
    }
    fbEnd() // 0x0b end
    ctrlLeave()
    return 0
  }
  // `<e> ?? d` over a nullable collection niche (`i32[] | null`, `string[] | null` /
  // `f64[] | null` / `i64[] | null` / `f32[] | null`, `i32[][] | null` / `S[] | null`): the
  // cell is a `(ref null $wrapper)`, so it takes the same `br_on_non_null` lowering as the
  // nullable struct below — placed before the sentinel-free ref paths as `emitNulIsNullTest` orders its niches, since the wrapper heap type is what distinguishes the families.
  const cnclw = nulCollWrapHeap(e.binLeft, fnIx)
  if cnclw >= 0 {
    return emitCoalesceNulRef(
      body,
      e,
      cnclw,
      coalesceNulCollArmCtx(e.binLeft, cnclw, fnIx),
      fnIx,
    )
  }
  // `<e> ?? d` over a `string | null` niche (an ident binding, a `string | null` struct field,
  // or a `(string | null)[]` element read): the cell is a `(ref null $sTypeIdx)`, so it takes
  // the same `br_on_non_null` core as the nullable struct/collections — one evaluation of the
  // place, and the narrow is the branch.

  // D7 — the list-index lhs is where a re-read shape broke: `array.get` must stay nullable
  // under every context, so re-reading `e.binLeft` under a recovering context handed a raw
  // `(ref null $str)` into a `(ref $str)` block (and evaluated the index twice). The lhs is
  // read raw (`rawNullRead`); the default follows the block type (`coalesceNulStrArmCtx`).
  if lhsReEval && exprNullableString(e.binLeft, fnIx) {
    const rawCtx = expCtxHere()
    rawCtx.rawNullRead = true
    const coNul = coalesceNulStrStaysNullable(exprIx, fnIx)
    return emitCoalesceNulRefCtx(
      body,
      e,
      sTypeIdx,
      coNul,
      rawCtx,
      coalesceNulStrArmCtx(coNul),
      fnIx,
    )
  }
  // `x ?? d` over a binding seeded by a BOOLEAN-list `.pop()`: the i32 cell holds 0/1 or the
  // niche sentinel 2 (`null`) — the same branching `if` the `boolean | null` arm above uses,
  // so the default runs only on the null path here too.
  if lhs is Ident {
    if identNullableBoolPop(lhs.identName, fnIx) {
      if emitExpr(body, e.binLeft, fnIx) < 0 {
        return -1 // the niche i32
      }
      fbI32Const(2)
      fbI32Bin(70) // 0x46 i32.eq → x == 2 (null)
      fbIf(127)    // 0x04 if, 0x7f i32 blocktype
      ctrlEnter()
      if emitExpr(body, e.binRight, fnIx) < 0 {
        return -1 // d, reached only on the null path
      }
      fbElse() // 0x05 else — present → the 0/1 cell, re-read
      if emitExpr(body, e.binLeft, fnIx) < 0 { return -1 }
      fbEnd()  // 0x0b end
      ctrlLeave()
      return 0
    }
    // `x ?? d` over a boxed value union containing `null` (`i32 | null`): the value-level dual
    // of the null guard — read the box tag; the null tag selects the default, anything else
    // unboxes the one remaining scalar atom (the host's `??` result is the non-null base
    // type). The receiver is a pure name, re-read in the non-null arm.
    const cunm = unionNameOfIdentSid(sidOfNode(lhsIx), fnIx)
    if cunm != "" {
      // D-VALUNION resolves the declared union's set; the narrowing table's id below answers a
      // different question (the set surviving the narrow), so both stay resolved. D-VALKIND
      // and D-SETONCE now share one resolution instead of two — the value-union gate and
      // `unionHasAtomTy`'s name-keyed lookup — and the null test is a kind test over the banked codes.
      const csid = msSetOfText(cunm)
      if (
        isValueUnionOfSet(csid, cunm) &&
        unionHasAtomK(csid, cunm, "null", nullValKind())
      ) {
        // D-union-atom-kind: the residual member's banked ABI code
        // (`unionResidualSoloKindOfSet`); the rendered residual is re-parsed only where the
        // set pool declines — a narrowed subset spelling it never interned.

        // D-SETID: the set arrives as the narrowing table's banked (row, mask) id
        // (`currentNarrowSetIdOf`), so the whole path from narrowing table to ABI code never
        // renders a set and never resolves a rendering back. The un-narrowed leg is
        // `msSetOfText(unionNameOfIdent(…))`; the narrowed leg reads the id the complement push banked instead of re-interning the survivor spelling.
        let cak = unionResidualSoloKindOfSet(
          currentNarrowSetIdOf(lhs.identName, fnIx),
        )
        if cak == -2 {
          // D-RESIDUE: the rendered residual is built ONLY here, where the bank
          // declined — master resolved the narrowing set, subtracted `null` and
          // rendered the survivor on every `??`, then used the rendering nowhere else.
          cak = valueAtomKind(
            removeAtomFromSet(
              currentNarrowSetOf(lhs.identName, fnIx),
              "null",
            ),
          )
        }
        if cak >= 0 && cak != nullValKind() {
          if cak == 2 {
            return emitFail(
              "emitProgram: `??` over a string|null union is not supported yet",
            )
          }
          // A nullable default keeps the result boxed (`coalesceDefaultNullable`). Both arms
          // are already `(ref $uBoxIdx)`: the default is a box, and the lhs re-read is the
          // same box with a non-null tag, so neither arm unboxes and the block type is the box
          // itself — the lowering shape is otherwise identical, so the tag test above is shared.
          if coalesceDefaultNullable(e.binRight, fnIx) {
            if emitExpr(body, e.binLeft, fnIx) < 0 {
              return -1 // the box
            }
            fbStructGet(uBoxIdx, 0) // field 0: tag
            fbI32Const(nullBoxTag())
            fbI32Bin(70)            // 0x46 i32.eq → null?
            fbIfRef(uBoxIdx)        // 0x04 if, (ref $uBoxIdx) blocktype
            ctrlEnter()
            // Through `emitUnionCoerce`, not `emitExpr` (D801). The block type is the box, so
            // the default has to arrive as one — a bare `null` has no rep of its own and would
            // take the loud `bare null needs a struct-typed context` reject. The coerce's
            // `NullLit` arm builds the null-tagged box instead; every non-null default passes through unchanged.
            if emitUnionCoerce(body, cunm, e.binRight, fnIx) < 0 {
              return -1 // d, its own box
            }
            fbElse() // 0x05 else — present → the LHS box, re-read
            if emitExpr(body, e.binLeft, fnIx) < 0 { return -1 }
            fbEnd()  // 0x0b end
            ctrlLeave()
            return 0
          }
          if emitExpr(body, e.binLeft, fnIx) < 0 {
            return -1 // the box
          }
          fbStructGet(uBoxIdx, 0)       // field 0: tag
          fbI32Const(nullBoxTag())
          fbI32Bin(70)                  // 0x46 i32.eq → null?
          fbIf(valBlockTypeOfKind(cak)) // 0x04 if, value blocktype
          ctrlEnter()
          if emitExprAsKind(body, e.binRight, cak, fnIx) < 0 { return -1 }
          fbElse()                      // 0x05 else — present → unbox
          // The banked code `cak` travels INTO the unbox: pre-#1128 this site rendered
          // the residual set for the parameter and the callee parsed the rendering
          // back into `cak`.
          if emitValueUnionUnboxRead(body, lhs.identName, cak, fnIx) < 0 {
            return -1
          }
          fbEnd() // 0x0b end
          ctrlLeave()
          return 0
        }
      }
    }
  }
  // `f(x) ?? d` over a call returning a value union with `null`: a call cannot be re-evaluated
  // (effects and cost), so stash the box once in the coalesce-call slot, then test the tag and
  // unbox off that single evaluation. Scalar atoms only (the value-typed `if` blocktype); one
  // slot is sound across nesting since each `??` sets-tests-uses within its own evaluation.

  // An `as?` yielding a box is the same shape (D1041), and an if-expression operand is a third
  // — all three name an operand that cannot be re-read (re-reading an `as?` re-runs the
  // exactness test). The gate widens rather than adding a second arm, since the lowering reads
  // only `unionNameOfExpr` and the box — the same predicate `coalChainHasCallLhs` reserves the slot on.
  if (
    lhs is Call ||
    ((lhs is AsExpr || lhs is IfStmt) &&
      (tyIsNulValueUnionBox(nodeTyIxOf(lhsIx)) || nodeTyIsNulScalarBox(lhsIx)))
  ) {
    const kunm = unionNameOfExpr(e.binLeft, fnIx)
    if kunm != "" {
      // D-VALUNION + D-SETONCE: one resolution feeds the value-union gate AND the
      // residual code below, which master resolved a second time inside
      // `unionResidualSoloKindOfSet`.
      const ksid = msSetOfText(kunm)
      if (
        isValueUnionOfSet(ksid, kunm) &&
        unionHasAtomK(ksid, kunm, "null", nullValKind())
      ) {
        // D-union-atom-kind — see `unionResidualSoloKindOfSet`.
        let kak = unionResidualSoloKindOfSet(ksid)
        if kak == -2 {
          kak = valueAtomKind(removeAtomFromSet(kunm, "null")) // D-RESIDUE
        }
        if kak >= 0 && kak != nullValKind() {
          if kak == 2 {
            return emitFail(
              "emitProgram: `??` over a string|null call result is not supported yet",
            )
          }
          // D1250 — an if-expression operand arrives through `emitUnionCoerce`, not
          // `emitExpr`. `emitIfExpr` picks the join's blocktype off the arms' scalar ladder,
          // so a `T | null` if-expression came back as a bare i32; the coerce's own `IfStmt`
          // arm (`emitUnionIfValue`) makes the blocktype the box, with a missing else as the null-tagged arm.
          if emitUnionCoerce(body, kunm, e.binLeft, fnIx) < 0 {
            return -1 // the box, evaluated ONCE
          }
          fbLocalSet(coalesceCallSlot)
          // A nullable default keeps the result boxed — the same decision the re-evaluating
          // ident arm makes (`coalesceDefaultNullable`), taken here too because both arms are
          // one lowering over one rep and must declare the same block type. Neither arm
          // unboxes: the default is a box, and the stash already holds the lhs box.
          if coalesceDefaultNullable(e.binRight, fnIx) {
            fbLocalGet(coalesceCallSlot)
            fbStructGet(uBoxIdx, 0) // field 0: tag
            fbI32Const(nullBoxTag())
            fbI32Bin(70)            // 0x46 i32.eq → null?
            fbIfRef(uBoxIdx)        // 0x04 if, (ref $uBoxIdx) blocktype
            ctrlEnter()
            // THROUGH `emitUnionCoerce` — the same D801 seed the ident arm above takes,
            // and taken here for the reason this arm and that one share every other
            // decision: one lowering over one rep, so a bare `null` default must box
            // identically at both spellings.
            if emitUnionCoerce(body, kunm, e.binRight, fnIx) < 0 {
              return -1 // d, its own box
            }
            fbElse() // 0x05 else — present → the stashed box
            fbLocalGet(coalesceCallSlot)
            fbEnd()  // 0x0b end
            ctrlLeave()
            return 0
          }
          fbLocalGet(coalesceCallSlot)
          fbStructGet(uBoxIdx, 0)       // field 0: tag
          fbI32Const(nullBoxTag())
          fbI32Bin(70)                  // 0x46 i32.eq → null?
          fbIf(valBlockTypeOfKind(kak)) // 0x04 if, value blocktype
          ctrlEnter()
          if emitExprAsKind(body, e.binRight, kak, fnIx) < 0 { return -1 }
          fbElse()                      // 0x05 else — present → unbox the stash
          fbLocalGet(coalesceCallSlot)
          fbStructGet(uBoxIdx, 1)       // field 1: value (anyref)
          const kvb = vbHeapIdxOfKind(kak)
          if kvb < 0 {
            return emitFail("emitProgram: union call atom has no value box")
          }
          fbRefCast(kvb)
          fbStructGet(kvb, 0) // the scalar payload
          fbEnd()             // 0x0b end
          ctrlLeave()
          return 0
        }
      }
    }
    // `f() ?? d` over a CALL returning `boolean | null` (the i32 niche): a call cannot be
    // re-read, so STASH the single evaluation in the bool slot, then branch on the sentinel
    // 2 — the call analogue of the `boolean | null` ident path, and the default runs only on
    // the null path for the same reason.
    if exprNulBool(e.binLeft, fnIx) {
      if emitExpr(body, e.binLeft, fnIx) < 0 {
        return -1 // the niche i32, evaluated ONCE
      }
      fbLocalSet(coalesceCallBoolSlot)
      fbLocalGet(coalesceCallBoolSlot)
      fbI32Const(2)
      fbI32Bin(70) // 0x46 i32.eq → x == 2 (null)
      fbIf(127)    // 0x04 if, 0x7f i32 blocktype
      ctrlEnter()
      if emitExpr(body, e.binRight, fnIx) < 0 {
        return -1 // d, reached only on the null path
      }
      fbElse() // 0x05 else — present → the stashed 0/1 cell
      fbLocalGet(coalesceCallBoolSlot)
      fbEnd()  // 0x0b end
      ctrlLeave()
      return 0
    }
    // `f() ?? d` over a CALL returning `string | null` (kind 16): STASH the nullable
    // ref once (raw, via `pendingRawNullRead`), then a value-typed `if` on
    // `ref.is_null` selects `d` or the recovered non-null string — the call analogue
    // of the `string | null` ident path.
    if exprNullableString(e.binLeft, fnIx) {
      const rawCCtx = expCtxHere()
      rawCCtx.rawNullRead = true
      // the raw nullable ref, ONCE
      if emitExprExpect(body, e.binLeft, fnIx, rawCCtx) < 0 { return -1 }
      fbLocalSet(coalesceCallStrSlot)
      fbLocalGet(coalesceCallStrSlot)
      wU8(209) // 0xd1 ref.is_null → 1 if null
      wU8(4)   // 0x04 if
      // The SAME result-nullability question the re-evaluating arm asks — see
      // `coalesceNulStrStaysNullable`. A nullable default keeps the result nullable here too.
      const coNulC = coalesceNulStrStaysNullable(exprIx, fnIx)
      if coNulC {
        wU8(99) // blocktype: (ref null $aTypeIdx) — the result stays nullable
      } else {
        wU8(100) // blocktype: (ref $sTypeIdx) — non-null string result
      }
      wSLEB(sTypeIdx)
      ctrlEnter()
      // Each arm reads UNDER the block type just declared (the re-evaluating arm's
      // discipline): the default is raw only when the result is nullable, and the stashed
      // LHS is non-null on every path that reaches the else (`ref.is_null` said no).
      if (
        emitExprExpect(body, e.binRight, fnIx, coalesceNulStrArmCtx(coNulC)) <
        0
      ) {
        return -1 // d (a string, nullable only when the block is)
      }
      fbElse()         // 0x05 else
      fbLocalGet(coalesceCallStrSlot)
      fbRefAsNonNull() // 0xd4 recover the non-null string the slot holds
      fbEnd()          // 0x0b end
      ctrlLeave()
      return 0
    }
  }
  // `o.v ?? d` over a value-union struct field (`v: i32 | null`, code 16): the field-read dual
  // of the boxed-union name path above — read the box off the field, test its tag for `null`,
  // and select the default or the unboxed single remaining scalar atom. The receiver re-reads
  // in the non-null arm (a name/field chain, like the nullable-struct `?.` path).
  if lhs is Member {
    const msi = structIndexOfExpr(lhs.memObj, fnIx)
    if msi >= 0 {
      const mfi = sFieldIndex(msi, lhs.memProp)
      if mfi >= 0 {
        if sFieldTypeAt(msi, mfi) == 16 {
          const munm = sFieldElemNameAt(msi, mfi)
          // D-VALUNION + D-SETONCE — see the call arm above.
          const msid = msSetOfText(munm)
          if (
            isValueUnionOfSet(msid, munm) &&
            unionHasAtomK(msid, munm, "null", nullValKind())
          ) {
            // D-union-atom-kind — see `unionResidualSoloKindOfSet`.
            let mak = unionResidualSoloKindOfSet(msid)
            if mak == -2 {
              mak = valueAtomKind(removeAtomFromSet(munm, "null")) // D-RESIDUE
            }
            if mak >= 0 && mak != nullValKind() {
              if mak == 2 {
                return emitFail(
                  "emitProgram: `??` over a string|null union field is not supported yet",
                )
              }
              // A NULLABLE default keeps the result boxed — the SAME decision the ident
              // and call arms make (`coalesceDefaultNullable`); the else arm re-reads the
              // field's own box rather than unboxing it.
              if coalesceDefaultNullable(e.binRight, fnIx) {
                if emitExpr(body, lhs.memObj, fnIx) < 0 { return -1 }
                fbStructGet(sHeapIdx[msi], mfi) // the union box
                fbStructGet(uBoxIdx, 0)         // field 0: tag
                fbI32Const(nullBoxTag())
                fbI32Bin(70)                    // 0x46 i32.eq → null?
                fbIfRef(uBoxIdx)                // 0x04 if, (ref $uBoxIdx) blocktype
                ctrlEnter()
                // THROUGH `emitUnionCoerce` — the D801 seed, the third of the three
                // boxed-union `??` spellings that share this lowering.
                if emitUnionCoerce(body, munm, e.binRight, fnIx) < 0 {
                  return -1 // d, its own box
                }
                fbElse() // 0x05 else — present → re-read the field
                if emitExpr(body, lhs.memObj, fnIx) < 0 { return -1 }
                fbStructGet(sHeapIdx[msi], mfi)
                fbEnd()  // 0x0b end
                ctrlLeave()
                return 0
              }
              if emitExpr(body, lhs.memObj, fnIx) < 0 { return -1 }
              fbStructGet(sHeapIdx[msi], mfi) // the union box
              fbStructGet(uBoxIdx, 0)         // field 0: tag
              fbI32Const(nullBoxTag())
              fbI32Bin(70)                    // 0x46 i32.eq → null?
              fbIf(valBlockTypeOfKind(mak))   // 0x04 if, value blocktype
              ctrlEnter()
              if emitExprAsKind(body, e.binRight, mak, fnIx) < 0 { return -1 }
              fbElse()                        // 0x05 else — present → unbox
              if emitExpr(body, lhs.memObj, fnIx) < 0 { return -1 }
              fbStructGet(sHeapIdx[msi], mfi)
              fbStructGet(uBoxIdx, 1)         // field 1: value (anyref)
              const mvb = vbHeapIdxOfKind(mak)
              if mvb < 0 {
                return emitFail(
                  "emitProgram: union field atom has no value box",
                )
              }
              fbRefCast(mvb)
              fbStructGet(mvb, 0) // the scalar payload
              fbEnd()             // 0x0b end
              ctrlLeave()
              return 0
            }
          }
        }
      }
    }
  }
  // The null-safe field read `m[k]?.f ?? d` over a struct-valued map is the fused form: probe;
  // on a hit read the field off the (non-null) value struct, else push the default. A live
  // entry's value slot is never null, so the `?.` null test coincides with the probe's hit
  // test. Scalar (i32/boolean) fields only (a value-typed `if` blocktype carries them).
  if lhs is OptMember {
    const omInner = P.nodes[lhs.omObj]
    if omInner is Index {
      if exprMap(omInner.idxArr, fnIx) {
        const omSl = mapShapeOfExpr(omInner.idxArr, fnIx)
        if omSl >= 0 {
          if mvValKind[omSl] != 1 {
            return emitFail("emitProgram: `?.` needs a struct-valued map")
          }
          // The variant half of the value row, the same either/or the store seed and the `??`
          // default seed have carried since D34. `mvValStructIdx` is -1 for an arm-valued map
          // (`collectS` skips a union member), so this site needs `variantFieldIndex` /
          // `variantFieldTypeAt` / `uVarHeap` — arm-for-arm twins of the struct accessor beside it, since a missing branch answered -1 and blamed the wrong field.
          let omHeap = -1
          let omFi = -1
          let omCode = -1
          // …through the layout identity (D123), the same read the store and `??`
          // default seeds take: the field lookup must run against the row whose heap the
          // vals element holds.
          const omVi = mvValVariantOf(omSl)
          if omVi >= 0 {
            omFi = variantFieldIndex(omVi, lhs.omProp)
            if omFi >= 0 {
              omHeap = uVarHeap[omVi]
              omCode = variantFieldTypeAt(omVi, omFi)
            }
          } else {
            const omSi = mvValStructIdxOf(omSl)
            // `sFieldIndex` bounds its own index (a row of -1 answers -1), so the heap read
            // below is reached only for a row that named the field.
            omFi = sFieldIndex(omSi, lhs.omProp)
            if omFi >= 0 {
              omHeap = sHeapIdx[omSi]
              omCode = sFieldTypeAt(omSi, omFi)
            }
          }
          if omFi < 0 {
            return emitFail(
              "emitProgram: `?.` field is not on the map's value struct",
            )
          }
          if omCode != 0 {
            return emitFail(
              "emitProgram: `?.` over a map read supports only i32/boolean fields",
            )
          }
          if emitMapPrep(body, omInner.idxArr, omInner.idxIndex, fnIx) < 0 {
            return -1
          }
          pushMapScr(body, 5)          // entry
          fbIf(127)                    // if (entry != 0 → hit), i32 blocktype
          pushMapVals(body)
          fbStructGet(cmValsWrap(), 0) // vals backing
          pushMapScr(body, 5)          // entry
          fbI32Const(1)
          fbI32Bin(107)                // i32.sub (entry - 1)
          fbArrayGet(cmValsBack())     // (ref null <value struct>)
          fbRefAsNonNull()             // a live entry's value is non-null
          fbStructGet(omHeap, omFi)    // .f — the arm's `uVarHeap` row or the struct's
          fbElse()                     // else
          if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
          fbEnd()                      // end (if)
          return 0
        }
      }
    }
    // `p?.f ?? d` over a nullable-struct receiver (`p: S | null`, or a nullable-struct field
    // read `n.next`): null selects the default, else the field read off the (non-null) struct.
    // The receiver is a re-readable place (a name, or an effect-free member chain), re-read in
    // the non-null branch. Scalar fields only (the value-typed `if` blocktype carries them).
    if optRecvReReadable(lhs.omObj) {
      if exprNullableStruct(lhs.omObj, fnIx) {
        const nsi = structIndexOfExpr(lhs.omObj, fnIx)
        if nsi >= 0 {
          const nfi = sFieldIndex(nsi, lhs.omProp)
          if nfi < 0 {
            return emitFail("emitProgram: `?.` field is not on the struct")
          }
          // The blocktype is the whole restriction, and it is not one rep wide. Both arms of
          // this `if` yield the field's rep, so it needs a blocktype spelling it —
          // `fbIfForSharedField` already owns this over the same `sFieldTypeAt` codes for the
          // shared-union-field dispatch. Hard-coding `fbIf(127)` refused `f64`/`i64`/`f32`/`string` fields here while the narrowed spelling ran fine at every one of them.
          const nfCode = sFieldTypeAt(nsi, nfi)
          // A nested-struct field (code 15) spells its `if` result from the field's own target
          // row, which `fbIfForSharedField` cannot give from a code alone. Two null tests, not
          // one: a code-15 slot is `(ref null $S)` at both declarations (D1180), and `o?.f ??
          // d` must yield `d` when the field is null too — receiver-null or field-null, short-circuited through one i32 `if` so `struct.get` never runs on a null receiver.
          if nfCode == 15 {
            const ntg = sFieldTgtStructIdx(nsi, nfi)
            if ntg < 0 {
              return emitFail(
                "emitProgram: `?.` over a nested-struct field names no struct row",
              )
            }
            const nDefNul = coalesceDefaultNullable(e.binRight, fnIx)
            if emitExpr(body, lhs.omObj, fnIx) < 0 { return -1 }
            wU8(209) // 0xd1 ref.is_null — the receiver
            fbIf(127)
            ctrlEnter()
            fbI32Const(1)
            fbElse()
            if emitExpr(body, lhs.omObj, fnIx) < 0 { return -1 }
            fbStructGet(sHeapIdx[nsi], nfi)
            wU8(209) // 0xd1 ref.is_null — the field slot
            fbEnd()
            ctrlLeave()
            fbIfRefNul(sHeapIdx[ntg], nDefNul)
            ctrlEnter()
            if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
            fbElse()
            if emitExpr(body, lhs.omObj, fnIx) < 0 { return -1 }
            fbStructGet(sHeapIdx[nsi], nfi)
            if !nDefNul { fbRefAsNonNull() }
            fbEnd()
            ctrlLeave()
            return 0
          }
          if !optChainFieldCodeOk(nfCode) {
            return emitFail(
              "emitProgram: `?.` over a nullable struct has no `if` blocktype for this field's rep",
            )
          }
          if emitExpr(body, lhs.omObj, fnIx) < 0 { return -1 }
          wU8(209) // 0xd1 ref.is_null
          fbIfForSharedField(nfCode) // if (result <the field's own rep>)
          ctrlEnter()
          if (
            emitOptChainDefault(
              body,
              e.binRight,
              nfCode,
              sFieldElemNameAt(nsi, nfi),
              fnIx,
            ) <
            0
          ) {
            return -1
          }
          fbElse() // 0x05 else — present → the field
          if emitExpr(body, lhs.omObj, fnIx) < 0 { return -1 }
          fbStructGet(sHeapIdx[nsi], nfi)
          fbEnd()  // 0x0b end
          ctrlLeave()
          return 0
        }
      }
    }
    // A nested optional chain `o?.inner?.v ?? d` (niche nullable links): any null link selects
    // the default; otherwise the chain reads through non-null refs (each `S | null` link
    // recovers `ref.as_non_null`). The links are effect-free places, re-evaluated in the value
    // arm. Scalar (i32/boolean) leaf fields only (the value-typed `if` blocktype).
    const omDeep = P.nodes[unwrapParen(lhs.omObj)]
    if omDeep is OptMember {
      const dsi = optChainStructIdxOf(lhs.omObj, fnIx)
      if dsi >= 0 {
        const dfi = sFieldIndex(dsi, lhs.omProp)
        if dfi >= 0 {
          if sFieldTypeAt(dsi, dfi) != 0 {
            return emitFail(
              "emitProgram: `?.` chain supports only i32/boolean leaf fields",
            )
          }
          if emitOptChainIsNull(body, lhs.omObj, fnIx) < 0 { return -1 }
          fbIf(127) // 0x04 if, i32 result — a null link → default
          ctrlEnter()
          if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
          fbElse()  // 0x05 else — every link present → the leaf
          if emitOptChainValue(body, lhs.omObj, fnIx) < 0 { return -1 }
          fbStructGet(sHeapIdx[dsi], dfi)
          fbEnd()   // 0x0b end
          ctrlLeave()
          return 0
        }
      }
    }
    // `xs.get(i)?.f ?? d` over a struct-element ref list is the fused form: one bounds
    // compare; in range read the field off the (non-null) element, else the default. A live
    // in-range element is never null, so the `?.` null test coincides with the bounds test —
    // mirroring the map `m[k]?.f ?? d` path above. Scalar fields only.
    const omGet = P.nodes[unwrapParen(lhs.omObj)]
    if omGet is Call {
      const gCallee = P.nodes[omGet.callFn]
      if gCallee is Member {
        if gCallee.memProp == "get" {
          const gSi = structListPopGetElem(unwrapParen(lhs.omObj), fnIx)
          if gSi >= 0 && rlUsed {
            if omGet.callArgs.length != 1 {
              return emitFail("emitProgram: .get takes exactly one argument")
            }
            const gFi = sFieldIndex(gSi, lhs.omProp)
            if gFi < 0 {
              return emitFail(
                "emitProgram: `?.` field is not on the list's element struct",
              )
            }
            if sFieldTypeAt(gSi, gFi) != 0 {
              return emitFail(
                "emitProgram: `?.` over a list .get supports only i32/boolean fields",
              )
            }
            const gRecvN = P.nodes[unwrapParen(gCallee.memObj)]
            let gOkRecv = false
            if gRecvN is Ident { gOkRecv = true }
            if !gOkRecv {
              return emitFail(
                "emitProgram: .get receiver must be a named list binding",
              )
            }
            const gIdxN = P.nodes[unwrapParen(omGet.callArgs[0])]
            let gOkIdx = false
            if gIdxN is NumLit { gOkIdx = true }
            if gIdxN is Ident { gOkIdx = true }
            if !gOkIdx {
              return emitFail(
                "emitProgram: .get index must be a literal or a name",
              )
            }
            const gSlot = refListSlotOfExpr(gCallee.memObj, fnIx)
            // cond: idx u< len
            if emitExpr(body, omGet.callArgs[0], fnIx) < 0 { return -1 }
            if emitExpr(body, gCallee.memObj, fnIx) < 0 { return -1 }
            fbStructGet(rlWrapIdx[gSlot], 1) // field 1: len
            fbI32Bin(73)                     // 0x49 i32.lt_u
            fbIf(127)                        // 0x04 if, 0x7f i32 result blocktype
            ctrlEnter()
            if emitExpr(body, gCallee.memObj, fnIx) < 0 { return -1 }
            fbStructGet(rlWrapIdx[gSlot], 0) // field 0: backing
            if emitExpr(body, omGet.callArgs[0], fnIx) < 0 { return -1 }
            fbArrayGet(rlBackIdx[gSlot])     // → (ref null $elem)
            fbRefAsNonNull()                 // a live in-range element is non-null
            fbStructGet(sHeapIdx[gSi], gFi)  // .f
            fbElse()                         // 0x05 else
            if emitExpr(body, e.binRight, fnIx) < 0 { return -1 }
            fbEnd()                          // 0x0b end
            ctrlLeave()
            return 0
          }
        }
      }
    }
  }
  // The variant sibling of the arm below, its own arm rather than a widening of it: a `T |
  // null` whose `T` is a union arm stores `(ref null $uVarHeap[vi])`, and
  // `structIndexOfExpr` has no row to answer with (`collectS` skips a union member). Same
  // niche, same `br_on_non_null` lowering, one table over — `variantIdx` is the `structIdx` an ObjLit default seeds against.
  if exprNullableVariant(e.binLeft, fnIx) {
    const cvi = nulVariantIdxOfExpr(e.binLeft, fnIx)
    if cvi >= 0 && cvi < uVarHeap.length {
      const vDefCtx = expCtxHere()
      vDefCtx.variantIdx = cvi
      return emitCoalesceNulRef(body, e, uVarHeap[cvi], vDefCtx, fnIx)
    }
  }
  // Generic nullable-struct `??`: a `S | null` value (ident/param binding, struct field, or
  // closure/factory call) coalesced with a struct default. Evaluated once: `br_on_non_null`
  // keeps the non-null struct or falls to the default, needing neither a re-eval nor a
  // per-struct stash — `structIndexOfExpr` resolves the inner struct for the block's result type, including an indexed closure-array/factory call via the checker-type fallback.
  if exprNullableStruct(e.binLeft, fnIx) {
    const csi = structIndexOfExpr(e.binLeft, fnIx)
    if csi >= 0 && csi < sHeapIdx.length {
      // The default arm seeds an ObjLit default to THIS struct; the block type and the
      // one-evaluation shape are the nullable-ref-niche lowering the collections share.
      const defCtx = expCtxHere()
      defCtx.structIdx = csi
      return emitCoalesceNulRef(body, e, sHeapIdx[csi], defCtx, fnIx)
    }
  }
  // D960 — `??` over a nullable value-union box whose operand cannot be re-read. The
  // re-readable spelling never arrives here: `emit_rewrite` desugars it to an `if`, which is
  // right because a rewrite leaves no `??` node for the consumer classifiers to disagree
  // about. A call operand cannot take that route, so it needs a real emit arm: stash the box once, branch on its tag, and give the `if` the box as its result type so both arms agree.

  // The two earlier emit arms fought each other: one emitted a correct `(if (result (ref
  // $box)) …)`, and the return path wrapped it in a second `struct.new $box` — the pair D969
  // untangled, since the consumer double-boxes precisely because `exprUnion` answers false for
  // this node. Teaching `unionNameOfExpr` to answer for a value-union `??` is the other half; neither half works alone.
  if tyIsNulValueUnionBox(nodeTyIxOf(e.binLeft)) {
    const coNm = unionNameOfExpr(exprIx, fnIx)
    if coNm != "" {
      const coSlot = sharedFieldRecvSlot()
      if emitExpr(body, e.binLeft, fnIx) < 0 { return -1 }
      fbLocalSet(coSlot)
      fbLocalGet(coSlot)
      fbStructGet(uBoxIdx, 0) // field 0: tag
      fbI32Const(nullBoxTag())
      fbI32Bin(71) // 0x47 i32.ne  -> present?
      fbIfRefNul(uBoxIdx, false) // if (result (ref $uBox))
      ctrlEnter()
      fbLocalGet(coSlot)
      wU8(212) // 0xd4 ref.as_non_null — the stash cell is nullable, the block type is not
      fbElse()
      if emitUnionCoerce(body, coNm, e.binRight, fnIx) < 0 { return -1 }
      fbEnd()
      ctrlLeave()
      return 0
    }
  }
  // What reaches here is a nullable left operand whose rep has no `??` lowering — not "this is
  // not a map index get", which is what this said while the overwhelming majority of its
  // firings are a non-nullable operand. Those fold to the left operand in `emit_rewrite.vl`
  // and never reach the emitter as a `??` at all, so the message can finally name the actual residue.
  emitFail(
    "emitProgram: `??` over this nullable value is not supported yet — narrow it first, e.g. `if v != null { … }`",
  )
}
