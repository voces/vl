// Fill the capture cache (`capStartTbl` / `capCountTbl` / `capNamesFlat` in `emit_state`)
// with every lifted function's capture list — one walk per function instead of an
// O(body) recompute per query. Call exactly once per program, after the last
// arena-mutating pass; earlier phases walk directly, and the pass loop then enters `capsCached`.
export function capCacheBuild() {
  capStartTbl = []
  capCountTbl = []
  capNamesFlat = []
  let fe = 0
  while fe < fnStmts.length {
    // Only a nested function or a lambda can capture, so with none every list is empty.
    let caps: string[] = []
    if fnNestUsed { caps = capComputeNamesOf(fe) }
    capStartTbl.push(capNamesFlat.length)
    capCountTbl.push(caps.length)
    let ci = 0
    while ci < caps.length {
      capNamesFlat.push(caps[ci])
      ci = ci + 1
    }
    fe = fe + 1
  }
  cloCellTarget = []
  cloCellUsed = false
  while cloCellTarget.length < fnStmts.length { cloCellTarget.push(0) }
  for name in capNamesFlat {
    const t = capCellTargetOf(name)
    if t >= 0 {
      // A cell stands for an env its declaring frame keeps, so its function must capture.
      if t >= capCountTbl.length || capCountTbl[t] == 0 {
        return emitFail(
          "emitProgram: a function-value cell names a function with no env",
        )
      }
      cloCellTarget[t] = 1
      cloCellUsed = true
    }
  }
  0
}

// The value-column wrapper struct for map slot `slot`: a scalar mv kind (f64/i64/f32)
// resolves to that scalar's distinct-backing list wrapper, a negative slot to the base
// i32 wrapper, and anything else to its interned ref-list wrapper (`rlWrapIdx`).
export function mvValsWrapOf(slot: i32) {
  if slot < 0 { return lTypeIdx }
  if mvValKind[slot] == MVK_STR { return mkListIdx }
  if mvValKind[slot] == MVK_F64 { return fl64TypeIdx }
  if mvValKind[slot] == MVK_F32 { return fl32TypeIdx }
  if mvValKind[slot] == MVK_I64 { return il64TypeIdx }
  if mvRlSlot[slot] < 0 || mvRlSlot[slot] >= rlWrapIdx.length {
    emitFail("emitProgram: map value slot has no resolved vals wrapper")
    return 0
  }
  rlWrapIdx[mvRlSlot[slot]]
}

// The scalar element kind (`"f64"`/`"i64"`/`"f32"`) of an mv map-value slot whose value
// is a non-i32 scalar, else null (a ref value rides the nullable valStash instead). The
// chokepoint the map get/set/push consult to branch scalar-store vs ref-store.
function mvScalarValKind(slot: i32): VKind | null {
  if slot < 0 { return null }
  if mvValKind[slot] == MVK_F64 { return "f64" }
  if mvValKind[slot] == MVK_I64 { return "i64" }
  if mvValKind[slot] == MVK_F32 { return "f32" }
  return null
}

// Every `VKind` the four scalar-list descriptors below do not name, as one answer: a
// recorded failure plus the i32 list's own index, so the module stays well-formed while the
// refusal is what a user reads. A SILENT i32 answer here emitted a `string[]` against the
// i32 backing at `vl check` rc 0 (D1684).
function scalarListKindUnlisted(fallback: i32): i32 {
  emitFail(
    "emitProgram: a list op has no rep for this element kind — i32, boolean, string, f64, i64, f32 and u8 elements are the ones it speaks",
  )
  fallback
}

// `wrap`, the wrapper of a wide scalar list, where a build collected it (`used`); otherwise a
// recorded refusal, since a read of a list no build made names a type the module lacks.
function wideListWrap(used: boolean, wrap: i32): i32 {
  if !used {
    emitFail(
      "emitProgram: a list of this element kind is read where no such list was built",
    )
  }
  wrap
}

// The wrapper struct heap type for a scalar element kind.
function scalarListWrap(elemKind: VKind) {
  if elemKind == "u8list" { return bl8TypeIdx }
  if elemKind == "f64" { return wideListWrap(fa64Used, fl64TypeIdx) }
  if elemKind == "i64" { return wideListWrap(ia64Used, il64TypeIdx) }
  if elemKind == "f32" { return wideListWrap(fa32Used, fl32TypeIdx) }
  // The string list's wrapper is the map's keys-list type, which any `string[]` shares.
  if elemKind == "str" { return mkListIdx }
  if elemKind == "i32" { return lTypeIdx }
  scalarListKindUnlisted(lTypeIdx)
}

// The backing `(array (mut <elem>))` heap type for a scalar element kind.
function scalarListBack(elemKind: VKind) {
  if elemKind == "u8list" { return ba8TypeIdx }
  if elemKind == "f64" { return fa64TypeIdx }
  if elemKind == "i64" { return ia64TypeIdx }
  if elemKind == "f32" { return fa32TypeIdx }
  if elemKind == "str" { return mkArrIdx }
  if elemKind == "i32" { return aTypeIdx }
  scalarListKindUnlisted(aTypeIdx)
}

// Open the value-typed `if` a fused `?? d` list read joins on, at the element's own rep. A
// string element is a REF, so it takes `fbIfRef` where every other kind takes a valtype
// byte; one speller, so the two arms of the read cannot disagree about the join type.
function fbIfForScalarListElem(elemKind: VKind) {
  if elemKind == "str" { return fbIfRef(sTypeIdx) }
  fbIf(scalarListBlocktype(elemKind))
}

// The `array.get` result blocktype byte for a scalar element kind (i32 `0x7f`, f64
// `0x7c`, i64 `0x7e`). A `u8[]` element reads as i32 (`array.get_u` widens), so it shares
// the plain i32 blocktype; a `string` element has no byte and goes through `fbIfRef`.
function scalarListBlocktype(elemKind: VKind) {
  if elemKind == "u8list" { return 127 }
  if elemKind == "f64" { return 124 }
  if elemKind == "i64" { return 126 }
  if elemKind == "f32" { return 125 }
  if elemKind == "i32" { return 127 }
  scalarListKindUnlisted(127)
}

// Whether the module-global list types for a scalar element kind are collected — the
// loud-fail guard every list op shares. An unlisted kind answers false, which is the
// caller's own loud refusal rather than a silent read at the i32 list's types.
function scalarListUsed(elemKind: VKind) {
  match elemKind {
    "u8list" => {
      return ba8Used
    }
    "f64" => {
      return fa64Used
    }
    "i64" => {
      return ia64Used
    }
    "f32" => {
      return fa32Used
    }
    // The string-ref list is minted for any `string[]` field and for the map's keys list.
    "str" => {
      return slUsed || mUsed
    }
    "i32" => {
      return lUsed
    }
    // No other kind is a scalar list element, so its list types are never collected.
    "struct" | "list" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "f64list" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "v128" => {}
  }
  false
}

// Emit `exprIx` coerced to a scalar element kind's value rep — the f64/i64 widen of a
// narrower literal/`i32` so a list element / `?? d` default matches the backing type.
// A `u8[]` value is an ordinary i32 (WasmGC has no `u8`; the truncation to one byte is
// `array.set`'s masked write, not this call's), so it passes through like plain i32.
function emitScalarValue(
  body: u8[],
  exprIx: i32,
  fnIx: i32,
  elemKind: VKind,
  ec: ExpCtx,
) {
  if elemKind == "f64" { return emitExprAsF64(body, exprIx, fnIx, ec) }
  if elemKind == "i64" { return emitExprAsI64(body, exprIx, fnIx, ec) }
  if elemKind == "f32" { return emitExprAsF32(body, exprIx, fnIx, ec) }
  emitExpr(body, exprIx, fnIx, ec)
}

// The `pushFieldStorage` slot argument for struct `si`'s field `fi` — the one place the three
// tables a field code can name are chosen between (nested-struct row, map shape, ref-list
// row). `emitTypeSection`, the supertype prefix test and the object-literal order stash
// (D1510) all read it, so the declared slot and the stash local cannot disagree.
export function sFieldStorageSlot(si: i32, fi: i32): i32 {
  const code = sFieldTypeAt(si, fi)
  if code == FC_STRUCT { return sFieldTgtStructIdx(si, fi) }
  if code == FC_MAP || code == FC_NUL_MAP { return sFieldMapShape(si, fi) }
  sFieldRefSlot(si, fi)
}

// The null value of an omitted nullable field (`si`/`fi`, field code `scode`) in a
// struct literal: `ref.null` of the field's own backing for the ref codes, the i32
// sentinel for `boolean | null` (2) or `K | null` (-1, since member ids are >= 0), or
// the null-tagged box for a union field with a `null` member. -1 when not nullable.
function emitOmittedFieldNull(_body: u8[], si: i32, fi: i32, scode: i32) {
  if scode == FC_NUL_STR {
    fbRefNull(sTypeIdx)
    return 0
  }
  if scode == FC_NUL_BOOL {
    fbI32Const(2)
    return 0
  }
  if scode == FC_NUL_LIT_UNION {
    fbI32Const(0 - 1)
    return 0
  }
  if scode == FC_STRUCT {
    const tgt = sFieldTgtStructIdx(si, fi)
    if tgt < 0 { return -1 }
    fbRefNull(sHeapIdx[tgt])
    return 0
  }
  if scode == FC_NUL_I32_LIST {
    fbRefNull(lTypeIdx)
    return 0
  }
  if isNulScalarListFieldCode(scode) {
    fbRefNull(nulScalarListFieldWrapHeap(scode))
    return 0
  }
  if scode == FC_NUL_REF_LIST {
    const rs28 = sFieldRefSlot(si, fi)
    if rs28 >= 0 && rs28 < rlWrapIdx.length {
      fbRefNull(rlWrapIdx[rs28])
      return 0
    }
    return -1
  }
  if scode == FC_NUL_CLOSURE {
    fbRefNull(cloStructIdx)
    return 0
  }
  if scode == FC_NUL_NONE {
    fbRefNullNone()
    return 0
  }
  if scode == FC_NUL_MAP {
    fbRefNull(mapTypeIdxOf(sFieldMapShape(si, fi)))
    return 0
  }
  if scode == FC_UNION {
    // a value-union field defaults to null only when `null` is a member — resolve the
    // member set once, then test its banked null code (`nullValKind()`), not the lexeme.
    const fnm = sFieldElemNameAt(si, fi)
    if (
      unionHasAtomK(
        msSetOfNameTy(fnm, sFieldElemTyIxAt(si, fi)),
        fnm,
        "null",
        nullValKind(),
      )
    ) {
      fbI32Rel(RS_TAG, nullBoxTag())
      fbRefNullNone()
      fbStructNew(uBoxIdx)
      return 0
    }
    return -1
  }
  -1
}

// One struct field's value, from the field's context through the emission arm its code
// selects to the two widen sites. Carved out of `emitObj`'s layout loop so the source-order
// stash pass (D1510) can run exactly the same lowering, once per field. The caller has
// resolved `valIx` and consumed the struct seed; its context is restored on every exit.
function emitStructFieldValue(
  body: u8[],
  si: i32,
  fi: i32,
  valIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const saved = expCtxHere(ec)
  expCtxLeave(
    saved,
    emitStructFieldValueUnder(body, si, fi, valIx, fnIx, ec),
    ec,
  )
}

// `emitStructFieldValue`'s body: it applies the field's context and leaves it for the
// wrapper's exit to undo.
function emitStructFieldValueUnder(
  body: u8[],
  si: i32,
  fi: i32,
  valIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const scode = sFieldTypeAt(si, fi)
  // a struct value is allowed only into a nested-struct field (code 15) or a box-union
  // field (code 16, boxed via `emitUnionCoerce`); any other field code has no rep for it.
  if scode != FC_STRUCT && scode != FC_UNION {
    if exprStruct(valIx, fnIx) {
      return emitFail("emitProgram: nested struct fields are not supported")
    }
  }

  if scode == FC_CLOSURE {
    const cav = nodeAt(unwrapParen(valIx))
    if cav is ArrayLit {
      // a same-field-name literal-shape collision can mis-code a closure-array field as a
      // bare closure; the built list wrapper cannot store into the `(ref $cloStruct)` slot.
      return emitFail(
        "emitProgram: a closure-array struct-field literal is not supported",
      )
    }
  }

  if scode != FC_CLOSURE && scode != FC_NUL_CLOSURE && scode != FC_UNION {
    const cfv = nodeAt(unwrapParen(valIx))
    if cfv is FuncDecl {
      // the inverse mis-resolution: a lambda value's own field-shape interning collided
      // with a non-closure sibling shape, whose slot cannot store the closure ref either.
      return emitFail(
        "emitProgram: a lambda field value resolved to a non-closure field slot",
      )
    }
  }

  // An explicit `null` is the field's own null, as an omitted one is.
  if (
    nodeAt(unwrapParen(valIx)) is NullLit
    && emitOmittedFieldNull(body, si, fi, scode) == 0
  ) {
    return 0
  }
  // The field's ref-list row, which the read-only covariant copy below converts into.
  let fieldRow = 0
  if scode == FC_REF_LIST {
    let fslot = sFieldRefSlot(si, fi)
    if fslot < 0 { fslot = 0 }

    if fslot >= rlElemKindTbl.length {
      return emitFail(
        "emitProgram: ref-list field element type is not interned",
      )
    }
    fieldRow = fslot
  } else if scode == FC_NUL_REF_LIST {
    const fslot28 = sFieldRefSlot(si, fi)
    fieldRow = if fslot28 < 0 { 0 } else { fslot28 }
  }

  if scode == FC_UNION {
    // coerces a raw scalar/string/null into the box with its atom tag via `emitUnionBoxArg`,
    // not `emitUnionCoerce` — a concrete-variant/`nulvariant` value must still be boxed here.
    if (
      emitUnionBoxArg(
        body,
        sFieldElemNameAt(si, fi),
        sFieldRowTyAt(si, fi),
        valIx,
        fnIx,
        ec,
      )
      < 0
    ) {
      return -1
    }
  } else if scode == FC_F64 {
    if emitExprAsF64(body, valIx, fnIx, ec) < 0 { return -1 }
  } else if scode == FC_I64 {
    if emitExprAsI64(body, valIx, fnIx, ec) < 0 { return -1 }
  } else if scode == FC_F32 {
    if emitExprAsF32(body, valIx, fnIx, ec) < 0 { return -1 }
  } else if scode == FC_NUL_STR && exprIsLitAtom(valIx, fnIx) {
    // a literal-union atom (an i32 id) widens to its member string here — the one
    // non-null value that needs converting; niche codes 21/30/22 seed their own null rep.
    if emitStrValue(body, valIx, fnIx, ec) < 0 { return -1 }
  } else if scode == FC_NUL_STR {
    const nsCtx = expCtxHere(ec)
    nsCtx.nulString = true
    if emitExprExpect(body, valIx, fnIx, nsCtx) < 0 { return -1 }
  } else if scode == FC_NUL_BOOL {
    const nbCtx = expCtxHere(ec)
    nbCtx.nulBool = true
    if emitExprExpect(body, valIx, fnIx, nbCtx) < 0 { return -1 }
  } else if scode == FC_NUL_LIT_UNION {
    const nluCtx = expCtxHere(ec)
    nluCtx.litUnion = 1
    nluCtx.nulLitUnion = true
    if emitExprExpect(body, valIx, fnIx, nluCtx) < 0 { return -1 }
  } else if scode == FC_NUL_CLOSURE {
    const ncCtx = expCtxHere(ec)
    if emitExprExpect(body, valIx, fnIx, ncCtx) < 0 { return -1 }
  } else if scode == FC_NUL_NONE {
    // The `null` unit type's slot holds only `ref.null none`; the value runs for effect (D4671).
    if emitNulNoneForEffect(body, valIx, fnIx, ec) < 0 { return -1 }
    fbRefNullNone()
  } else if scode == FC_STR && exprIsLitAtom(valIx, fnIx) {
    // a literal-union atom widens to its member string here.
    if emitAtomToStr(body, valIx, fnIx, ec) < 0 { return -1 }
  } else if sFieldIsLitUnion(si, fi) {
    // the member literal lowers as its interned atom id, not a string.
    const fluCtx = expCtxHere(ec)
    fluCtx.litUnion = 1
    if emitExprExpect(body, valIx, fnIx, fluCtx) < 0 { return -1 }
  } else if sFieldIsLitUnionArray(si, fi) {
    // an atom-array field: without the litunion context each string-lexeme element would
    // build a string list, whose wrapper mismatches the field's `$lTypeIdx` of atom ids.
    const flaCtx = expCtxHere(ec)
    flaCtx.litUnion = 1
    if emitExprExpect(body, valIx, fnIx, flaCtx) < 0 { return -1 }
  } else if scode == FC_STRUCT {
    // A narrowed arm into a nested-struct field (`{ g: s }` after `if s is Circle`) — see
    // `emitArmDelivery`. Inert for every other code-15 value.
    if emitArmDelivery(body, valIx, fnIx, sFieldTgtHeapOf(si, fi), ec) < 0 {
      return -1
    }
  } else {
    if emitExpr(body, valIx, fnIx, ec) < 0 { return -1 }
  }

  // D1222 — the construct half of the field layer's `ref.as_non_null`. A narrowed nullable
  // ref keeps its `(ref null $H)` and the use site recovers, so a `{f: y}` under a non-null
  // guard would put one under a `(ref $H)` field. Asked through the same `nulNicheRecoverOwed`
  // the return, binding and assign deliveries ask; before the widen sites, which consume it.
  if nulNicheRecoverOwed(fieldCodeVKind(scode), valIx, fnIx) {
    fbRefAsNonNull()
  }
  // read-only covariance at the field boundary (D791), against this field's own row.
  emitFieldListWidenSite(body, valIx, fnIx, scode, fieldRow)
  0
}

// The read-only covariant copy a list value owes on its way into a struct field of wasm-type
// code `scode` whose ref-list row is `refSlot`: the ref copy for code 5 (D791), the scalar copy
// for the list codes (D965). Shared by the construct and the field store (D2163).
function emitFieldListWidenSite(
  body: u8[],
  valIx: i32,
  fnIx: i32,
  scode: i32,
  refSlot: i32,
): boolean {
  if scode == FC_REF_LIST {
    return emitRefListWidenSite(
      body,
      valIx,
      exprEmittedRefListSlot(valIx, fnIx),
      refSlot,
    )
  }
  // The i32 list and the distinct scalar backings widen; a string or ref list field does not.
  const sfk = listRepOfFieldCode(scode)
  if sfk == null { return false }
  if sfk == "strlist" || vkListClass(sfk) != 1 { return false }
  if sfk == "reflist" { return false }
  emitScalarListWidenSite(body, valIx, fnIx, sfk)
}

// Lower an object literal `{ f: v, … }` onto `body`: build the struct of its recorded type
// (its destination's, when the checker adopted one), push each field in declared order, then
// `struct.new`. A nullable field may be omitted (`emitOmittedFieldNull`); any other must match.
// `row` >= 0 is a container's struct row the literal is built at instead.
function emitObj(body: u8[], objIx: i32, fnIx: i32, row: i32, ec: ExpCtx) {
  if !sDeclared {
    return emitFail("emitProgram: object literal but no struct type declared")
  }
  if objIx < 0 { return -1 }
  const o = nodeAt(objIx)
  if o is ObjLit {
    const si = if row >= 0 { row } else { structIndexOfObjCtx(objIx, fnIx) }
    if si < 0 {
      return emitFail(
        "emitProgram: object literal field count does not match struct",
      )
    }
    const cnt = sFieldCount[si]
    // D1510 — source-order evaluation. `struct.new` takes its operands in layout order,
    // sorted by field name, so evaluating each initialiser as it is pushed runs a literal
    // written in another order permuted. When the permutation is observable, evaluate in
    // source order into one scratch local per field; `stash` is empty otherwise.
    const stash: i32[] = []
    // A field the layout drops also takes the stash, so its initialiser runs, in source
    // order, for its effect (D1696).
    if (
      objLitDropsField(objIx, sFieldNames, sFieldStart[si], cnt)
      || objLitNeedsOrderStash(objIx, sFieldNames, sFieldStart[si], cnt)
    ) {
      let pi = 0
      while pi < cnt {
        stash.push(0 - 1)
        pi = pi + 1
      }
      const pairs = objFieldSrcPairs(objIx, sFieldNames, sFieldStart[si], cnt)
      let oi = 0
      while oi + 1 < pairs.length {
        const ofi = pairs[oi]
        const ovIx = pairs[oi + 1]
        oi = oi + 2
        if ofi < 0 {
          if emitExpr(body, ovIx, fnIx, ec) < 0 { return -1 }
          fbDrop()
          continue
        }
        if emitStructFieldValue(body, si, ofi, ovIx, fnIx, ec) < 0 { return -1 }
        const oslot = objOrderStashSlot(
          sFieldTypeAt(si, ofi),
          sFieldStorageSlot(si, ofi),
        )
        stash[ofi] = oslot
        fbLocalSet(oslot)
      }
    }
    let fi = 0
    while fi < cnt {
      const valIx = objFieldVal(objIx, sFieldNames[sFieldStart[si] + fi])
      const scode = sFieldTypeAt(si, fi)
      if valIx < 0 {
        // An omitted field pushes a constant, so it has no source position to keep and
        // stays in the layout loop even under the stash.
        if emitOmittedFieldNull(body, si, fi, scode) < 0 {
          return emitFail(
            "emitProgram: object literal is missing a struct field",
          )
        }
        fi = fi + 1
        continue
      }
      if stash.length > 0 {
        fbLocalGet(stash[fi])
        fi = fi + 1
        continue
      }
      if emitStructFieldValue(body, si, fi, valIx, fnIx, ec) < 0 { return -1 }
      fi = fi + 1
    }
    fbStructNew(sHeapIdx[si])
    return 0
  }
  emitFail("emitProgram: expected an object literal")
}

// Whether `ix` is a read of `name`, through parentheses.
function nameIsBareIn(name: string, ix: i32): boolean {
  const x = unwrapParen(ix)
  if x < 0 { return false }
  const n = nodeAt(x)
  n is Ident && n.identName == name
}

// Does `name` appear as a value — any position other than the callee of a direct
// `name(...)` call — in the subtree at `ix`? A generic function bound to `name` is sound
// only when every use is a direct call, since `monomorphize` rewrites each call to its
// instance and a value use escapes to a call the binding cannot type. Mirrors `monoWalk`.
function nameUsedAsValueIn(name: string, ix: i32) {
  if ix < 0 { return false }
  const n = nodeAt(ix)
  match n {
    Ident => {
      return n.identName == name
    }
    Call => {
      if n.callFn < 0 { return false }
      const callee = nodeAt(n.callFn)
      let direct = false
      if callee is Ident {
        if callee.identName == name { direct = true }
      }
      if !direct {
        if nameUsedAsValueIn(name, n.callFn) { return true }
      }
      const args = n.callArgs
      let i = 0
      while i < args.length {
        if nameUsedAsValueIn(name, args[i]) { return true }
        i = i + 1
      }
      return false
    }
    Block => {
      const bs = n.blkStmts
      let i2 = 0
      while i2 < bs.length {
        if nameUsedAsValueIn(name, bs[i2]) { return true }
        i2 = i2 + 1
      }
      return false
    }
    LetDecl => {
      return nameUsedAsValueIn(name, n.letInit)
    }
    IfStmt => {
      if nameUsedAsValueIn(name, n.ifCond) { return true }
      if nameUsedAsValueIn(name, n.ifThen) { return true }
      return nameUsedAsValueIn(name, n.ifElse)
    }
    WhileStmt => {
      if nameUsedAsValueIn(name, n.whileCond) { return true }
      return nameUsedAsValueIn(name, n.whileBody)
    }
    ForRange => {
      if nameUsedAsValueIn(name, n.frFrom) { return true }
      if nameUsedAsValueIn(name, n.frTo) { return true }
      if nameUsedAsValueIn(name, n.frStep) { return true }
      return nameUsedAsValueIn(name, n.frBody)
    }
    ForIn => {
      if nameUsedAsValueIn(name, n.fiIter) { return true }
      return nameUsedAsValueIn(name, n.fiBody)
    }
    RetStmt => {
      return nameUsedAsValueIn(name, n.retArg)
    }
    // A compared name is read for its identity, which calls nothing (D7383).
    BinExpr => {
      if n.binOp == "==" || n.binOp == "!=" {
        if (
          !nameIsBareIn(name, n.binLeft)
          && nameUsedAsValueIn(name, n.binLeft)
        ) {
          return true
        }
        return !nameIsBareIn(name, n.binRight)
          && nameUsedAsValueIn(name, n.binRight)
      }
      if nameUsedAsValueIn(name, n.binLeft) { return true }
      return nameUsedAsValueIn(name, n.binRight)
    }
    Unary => {
      return nameUsedAsValueIn(name, n.unArg)
    }
    Paren => {
      return nameUsedAsValueIn(name, n.parInner)
    }
    Member => {
      return nameUsedAsValueIn(name, n.memObj)
    }
    OptMember => {
      return nameUsedAsValueIn(name, n.omObj)
    }
    Index => {
      if nameUsedAsValueIn(name, n.idxArr) { return true }
      return nameUsedAsValueIn(name, n.idxIndex)
    }
    IsExpr => {
      return nameUsedAsValueIn(name, n.isObj)
    }
    AsExpr => {
      return nameUsedAsValueIn(name, n.asObj)
    }
    // A spread's source is an operand like any other (D2334).
    Spread => {
      return nameUsedAsValueIn(name, n.spdArg)
    }
    ArrayLit => {
      const es = n.arrElems
      let i3 = 0
      while i3 < es.length {
        if nameUsedAsValueIn(name, es[i3]) { return true }
        i3 = i3 + 1
      }
      return false
    }
    ObjLit => {
      const fs = n.objFields
      let i4 = 0
      while i4 < fs.length {
        const f = nodeAt(fs[i4])
        if f is FieldInit {
          if nameUsedAsValueIn(name, f.fiValue) { return true }
        }
        i4 = i4 + 1
      }
      return false
    }
    // No other node holds a value use of a name.
    NumLit | StrLit | CharLit | BoolLit | NullLit | ErrExpr | Param | TypeRef | FuncDecl | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | MatchExpr | ImportDecl | LoopVar => {}
  }
  false
}

// A generic function (un-annotated parameters) taken as a value would emit its params at
// the i32 default, so a `call_indirect` traps the signature check at any other type.
// Reject it as a value unless it is an anonymous lambda used only as a direct-call callee
// (`criFnIsAnonLambda`), which is sound and routes straight to `emitClosureValueCore`.
function emitClosureValue(body: u8[], fe: i32, fnIx: i32, ec: ExpCtx) {
  if fnHasUnannotatedParam(fe) {
    if !criFnIsAnonLambda(fe) { return emitFail(genericFnValueRejectMsg(fe)) }
  }

  return emitClosureValueCore(body, fe, fnIx, ec)
}

// The closure-value fat pointer for lifted function `fe`: `struct.new $cloStruct [ env, id,
// decl ]`. The env is `ref.null struct` for a non-capturing function, else a `struct.new
// $envStruct` of the enclosing frame's captured values; `id` is the lifted wasm index, the
// `call_indirect` operand; `decl` is the `==` identity token (`cloDeclOf`).
export function emitClosureValueCore(
  body: u8[],
  fe: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if fe < 0 || fe >= fnStmts.length {
    return emitFail("emitProgram: function value with no lifted function")
  }
  if cloLifted(fe) {
    return emitFail(
      "emitProgram: a lambda-lifted local function was taken as a value",
    )
  }

  // a signature not representable as a closure `$fnsig` cannot be soundly called as a
  // value even for a direct-call-only binding: the call site would fall back to the
  // all-i32 arity functype and `call_indirect` at the wrong type, trapping the engine.
  if cloSigKeyExt(fe) == "" {
    return emitFail(
      "emitProgram: a function value's signature is not yet supported — "
        + cloSigRejectWhat(fe)
        + " has no representation in the function-value ABI; annotate and call it as a "
        + "named function instead",
    )
  }

  return emitClosureValueOf(body, cloAdapterCanonOf(fe), fnIx, ec)
}

// The function a function-value adapter `fe` calls (`fvaAdapt` in check_assignable.vl): it takes
// at least one parameter, all named `$fp<k>`, and its body is one call of a declared function
// passing them in order; this returns that function's position. -1 for any other function.
function fvaAdapterCallee(fe: i32): i32 {
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const d = nodeAt(fnStmts[fe])
  if !(d is FuncDecl) { return -1 }
  if d.fnName != "" && !keyHasPrefix(d.fnName, "__lambda_") { return -1 }
  const ps = d.fnParams
  if ps.length == 0 || d.fnBody < 0 || d.fnBody >= P.nodes.length { return -1 }
  const b = nodeAt(d.fnBody)
  if !(b is Block) || b.blkStmts.length != 1 { return -1 }
  const c = nodeAt(unwrapParen(b.blkStmts[0]))
  if !(c is Call) || c.callArgs.length != ps.length { return -1 }
  if c.callFn < 0 || c.callFn >= P.nodes.length { return -1 }
  if !(nodeAt(c.callFn) is Ident) { return -1 }
  let i = 0
  while i < ps.length {
    const p = nodeAt(ps[i])
    if !(p is Param) || p.parName != "$fp" + i32ToStr(i) { return -1 }
    if !nameIsBareIn(p.parName, c.callArgs[i]) { return -1 }
    i = i + 1
  }
  fnIndexOfAt(sidOfNode(c.callFn), fnStmts[fe], c.callFn)
}

// The function whose closure id stands for capture-free adapter `fe`: its callee when the callee
// has the adapter's closure signature, else the first adapter emitted of the same callee at that
// signature; `fe` itself for any other function (D7382).
function cloAdapterCanonOf(fe: i32): i32 {
  if fnEnvIdxOf(fe) >= 0 { return fe }
  const callee = fvaAdapterCallee(fe)
  if callee < 0 { return fe }
  const sk = cloSigKeyExt(fe)
  if callee < fnStmts.length && fnEnvIdxOf(callee) < 0 && !cloLifted(callee) {
    if !fnHasUnannotatedParam(callee) && cloSigKeyExt(callee) == sk {
      return callee
    }
  }
  const key = i32ToStr(callee) + "|" + sk
  const have = cloAdapterCanon[key] ?? -1
  if have >= 0 { return have }
  cloAdapterCanon[key] = fe
  fe
}

// A bound on `cloDeclOf`'s walk, which takes one hop per void twin or adapter layer; a chain
// is a few layers deep, so the bound only guards against a cycle.
const CLO_DECL_MAX_HOPS = 16

// The function a closure of `fe` names in its identity field: the one standing for `fe`'s source
// declaration, reached through adapters, void twins and generic instances, so every delivery of
// one declaration compares equal at whatever signature it is delivered (D7180).
function cloDeclOf(fe: i32): i32 {
  const have = cloDeclAt[fe] ?? -1
  if have >= 0 { return have }
  let cur = fe
  let hops = 0
  while hops < CLO_DECL_MAX_HOPS {
    let next = voidTwinTargetOf(cur)
    if next < 0 { next = fvaAdapterCallee(cur) }
    if next < 0 || next == cur { break }
    cur = next
    hops = hops + 1
  }
  if cur >= monoOrigNode.length {
    let q = 0
    while q < monoInstFe.length && q < monoInstOrig.length {
      if monoInstFe[q] == cur {
        cur = monoInstOrig[q]
        break
      }
      q = q + 1
    }
  }
  cloDeclAt[fe] = cur
  cur
}

// The local holding the env of capturing function `fe` in the frame being emitted, or -1 when
// that frame does not declare `fe` (`envCacheFes`).
function envCacheSlotOf(fe: i32): i32 {
  let k = 0
  while k < envCacheFes.length {
    if envCacheFes[k] == fe { return envCacheBase + k }
    k = k + 1
  }
  -1
}

// `emitClosureValueCore` for a function already checked to have a closure signature.
function emitClosureValueOf(body: u8[], fe: i32, fnIx: i32, ec: ExpCtx) {
  const envIdx = fnEnvIdxOf(fe)
  if envIdx < 0 {
    // Capture-free: the module's one constant closure of `fe`. Equality reads the identity
    // field and the (null) env, never the struct, so sharing it is unobservable from VL.
    const g = synthGlobalIdx(SYNTH_CLOSURE, fe)
    if g >= 0 {
      markFnAddrTaken(fe)
      cloDeclOf(fe)
      return fbGlobalGet(g)
    }
    fbRefNullStruct()
  } else if cloCellReaches(fe, fnIx) {
    // Every frame that reads `fe` as a value reaches one cell, so the first read fills it and
    // every later one, in any frame, is the same function value (D7700).
    if emitCloCellRef(body, fe, fnIx, ec) < 0 { return -1 }
    fbStructGet(cloCellIdx, 0)
    fbRefIsNull()
    fbIf(64) // 0x40 void
    if emitCloCellRef(body, fe, fnIx, ec) < 0 { return -1 }
    if emitClosureEnvOf(body, fe, fnIx, envIdx, ec) < 0 { return -1 }
    emitClosureIds(fe)
    fbStructSet(cloCellIdx, 0)
    fbEnd()
    if emitCloCellRef(body, fe, fnIx, ec) < 0 { return -1 }
    fbStructGet(cloCellIdx, 0)
    fbRefAsNonNull()
    return 0
  } else {
    // In the frame that declares `fe`, the env is built once per activation and kept in the
    // frame's cache slot, so two reads of the function compare equal (D7480).
    const ck = envCacheSlotOf(fe)
    if ck >= 0 {
      fbLocalGet(ck)
      fbRefIsNull()
      fbIf(64) // 0x40 void
    }
    if emitClosureEnvOf(body, fe, fnIx, envIdx, ec) < 0 { return -1 }
    if ck >= 0 {
      fbLocalSet(ck)
      fbEnd()
      fbLocalGet(ck)
    }
  }
  emitClosureIds(fe)
}

// Builds a fresh env of capturing function `fe` from frame `fnIx`: one read per capture.
function emitClosureEnvOf(
  body: u8[],
  fe: i32,
  fnIx: i32,
  envIdx: i32,
  ec: ExpCtx,
) {
  const caps = captureNamesOf(fe)
  let ci = 0
  while ci < caps.length {
    if emitCaptureRead(body, caps[ci], fnIx, ec) < 0 { return -1 }
    ci = ci + 1
  }
  fbStructNew(envIdx)
  0
}

// Completes a closure of `fe` over the env on the stack: its id and declaration, then the struct.
function emitClosureIds(fe: i32) {
  // The one place a wasm function index becomes a closure id, so the one place the
  // address-taken set is recorded: the element section lists exactly these entries, and an
  // id no expression here produces cannot reach a `call_indirect`.
  markFnAddrTaken(fe)
  fbI32RelOf(RS_SLOT, fe, gImports + fe + relSkew(RS_SLOT))
  const decl = cloDeclOf(fe)
  fbI32RelOf(RS_SLOT, decl, gImports + decl + relSkew(RS_SLOT))
  fbStructNew(cloStructIdx)
  0
}

// Whether frame `fnIx` reaches `fe`'s cell: it declares `fe`, or its env carries the cell.
function cloCellReaches(fe: i32, fnIx: i32): boolean {
  if (
    !cloCellUsed
    || fe < 0
    || fe >= cloCellTarget.length
    || cloCellTarget[fe] == 0
  ) {
    return false
  }
  if envCacheSlotOf(fe) >= 0 { return true }
  const at = fnStmtsPosOf(fnIx)
  at >= 0 && strListHas(captureNamesOf(at), capCellName(fe))
}

// Pushes `fe`'s cell as frame `fnIx` reaches it: the frame's own slot, allocated at its first
// use in an activation, when the frame declares `fe`, else the field the frame's env carries.
function emitCloCellRef(body: u8[], fe: i32, fnIx: i32, ec: ExpCtx) {
  const ck = envCacheSlotOf(fe)
  if ck >= 0 {
    fbLocalGet(ck)
    fbRefIsNull()
    fbIf(64) // 0x40 void
    fbRefNull(cloStructIdx)
    fbStructNew(cloCellIdx)
    fbLocalSet(ck)
    fbEnd()
    fbLocalGet(ck)
    return 0
  }
  if emitCapturedRead(body, capCellName(fe), fnIx, false, ec) == 1 { return 0 }
  emitFail(
    "emitProgram: a function-value cell is not reachable from this frame",
  )
}

// The rep recovery an env-field read owes after its `struct.get`, decided by
// `captureValKind` so the recovery cannot disagree with the field's own type. A
// `nulstr` capture must recover to non-null here; every other nullable cell
// recovers at its own use site instead.
function emitCapturedReadRecover(fe: i32, name: string, ec: ExpCtx) {
  if captureValKind(fe, name) == "nulstr" {
    if !nulStrReadStaysRaw(ec) { fbRefAsNonNull() }
  }
  0
}

// If `name` is a captured variable of the capturing function `fnIx`, read it from the env
// struct (`ref.cast` local 0 to the env, then `struct.get` the field index) and return 1;
// else return 0 for the caller's param/local/global path. `recover` is false for the
// env-to-env copy building a nested closure's frame — recovering there traps a null capture.
function emitCapturedRead(
  _body: u8[],
  name: string,
  fnIx: i32,
  recover: boolean,
  ec: ExpCtx,
) {
  if fnIx < 0 { return 0 }
  if !fnNestUsed { return 0 }
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return 0 }
  const envIdx = fnEnvIdxOf(fe)
  if envIdx < 0 { return 0 }

  if emitPhaseReached("capsCached") && fe < capCountTbl.length {
    const start = capStartTbl[fe]
    const cnt = capCountTbl[fe]
    let fi = 0
    while fi < cnt {
      if capNamesFlat[start + fi] == name {
        emitCaptureSlotRead(fe, envIdx, fi)
        if recover { emitCapturedReadRecover(fe, name, ec) }
        return 1
      }
      fi = fi + 1
    }
    return 0
  }
  const caps = captureNamesOf(fe)
  let ci = 0
  while ci < caps.length {
    if caps[ci] == name {
      emitCaptureSlotRead(fe, envIdx, ci)
      if recover { emitCapturedReadRecover(fe, name, ec) }
      return 1
    }
    ci = ci + 1
  }
  0
}

// Pushes capture `fi` of lifted function `fe`: its own parameter after the env when the
// function is lambda-lifted (SP-037), else field `fi` of the env struct.
function emitCaptureSlotRead(fe: i32, envIdx: i32, fi: i32) {
  if cloLifted(fe) {
    fbLocalGet(1 + fi)
    return 0
  }
  fbLocalGet(0)
  fbRefCast(envIdx)
  fbStructGet(envIdx, fi)
  0
}

// Read captured variable `name` in the enclosing frame `fnIx` for an env-struct build: a
// param/local is `local.get`, a module global `global.get`, and a transitive capture (the
// enclosing frame is itself a lifted closure re-capturing `name`) reads that frame's own
// env, so the value flows env-to-env down any nesting depth.
function emitCaptureRead(_body: u8[], name: string, fnIx: i32, ec: ExpCtx) {
  const cellOf = capCellTargetOf(name)
  if cellOf >= 0 { return emitCloCellRef(_body, cellOf, fnIx, ec) }
  const idx = localIndexOf(fnIx, name)
  if idx >= 0 {
    fbLocalGet(idx)
    return 0
  }
  const gIdx = globalIndexOf(name)
  if gIdx >= 0 { return emitUserGlobalGet(gIdx) }
  if emitCapturedRead(_body, name, fnIx, false, ec) == 1 { return 0 }

  // capture analysis records every free identifier not bound locally, as a global or as a
  // collected function; an intrinsic is none of those, so name it rather than a variable.
  if isNumIntrinsicName(name) {
    return emitFail(
      "emitProgram: the numeric intrinsic '"
        + name
        + "' is mistaken for a captured variable here — it is not yet callable from a lambda, nor from a named function in a module that uses function values",
    )
  }
  emitFail("emitProgram: captured variable not found in enclosing frame")
}

// ── the variant field-span invariant, enforced rather than assumed ───────────

// `uFieldStart` / `uFieldCount` are parallel to `uVariants` and slice the flat `uFieldNames`
// and `uFieldTypes` stores, and nothing keeps the lengths in step: a registration helper that
// pushes a variant row and then refuses one of its fields leaves a start with no count.
// `emitFail` keeps emitting, so an unguarded span read traps the compiler instead (D1152).
function guardVariantFieldSpan(vi: i32, where: string) {
  if vi >= 0 && vi < uFieldStart.length && vi < uFieldCount.length {
    const end = uFieldStart[vi] + uFieldCount[vi]
    if (
      uFieldStart[vi] >= 0
      && uFieldCount[vi] >= 0
      && end <= uFieldNames.length
      && end <= uFieldTypes.length
    ) {
      return 0
    }
  }
  emitFail(
    "emitProgram: "
      + where
      + ": union-variant "
      + i32ToStr(vi)
      + " is outside the parallel field-span tables — "
      + i32ToStr(uVariants.length)
      + " variants but "
      + i32ToStr(uFieldStart.length)
      + " field starts / "
      + i32ToStr(uFieldCount.length)
      + " field counts / "
      + i32ToStr(uFieldNames.length)
      + " field names / "
      + i32ToStr(uFieldTypes.length)
      + " field types",
  )
}

// One union-variant field's value — `emitStructFieldValue`'s twin, one table over, carved out
// for the same reason: the source-order stash pass (D1510) runs exactly this lowering once per
// field. The caller's context is restored on every exit.
function emitVariantFieldValue(
  body: u8[],
  vi: i32,
  fj: i32,
  valIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const saved = expCtxHere(ec)
  expCtxLeave(
    saved,
    emitVariantFieldValueUnder(body, vi, fj, valIx, fnIx, ec),
    ec,
  )
}

// `emitVariantFieldValue`'s body: it applies the field's context and leaves it for the
// wrapper's exit to undo.
function emitVariantFieldValueUnder(
  body: u8[],
  vi: i32,
  fj: i32,
  valIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const vcode = variantFieldTypeAt(vi, fj)

  const vcfv = nodeAt(unwrapParen(valIx))
  if vcfv is FuncDecl {
    if vcode != FC_CLOSURE && vcode != FC_NUL_CLOSURE && vcode != FC_UNION {
      return emitFail(
        "emitProgram: a lambda field value resolved to a non-closure variant field slot",
      )
    }
  }

  if vcode == FC_F64 {
    if emitExprAsF64(body, valIx, fnIx, ec) < 0 { return -1 }
  } else if vcode == FC_I64 {
    if emitExprAsI64(body, valIx, fnIx, ec) < 0 { return -1 }
  } else if vcode == FC_F32 {
    if emitExprAsF32(body, valIx, fnIx, ec) < 0 { return -1 }
  } else if vcode == FC_NUL_STR {
    const nsCtx = expCtxHere(ec)
    nsCtx.nulString = true
    if emitExprExpect(body, valIx, fnIx, nsCtx) < 0 { return -1 }
  } else if vcode == FC_NUL_BOOL {
    const nbCtx = expCtxHere(ec)
    nbCtx.nulBool = true
    if emitExprExpect(body, valIx, fnIx, nbCtx) < 0 { return -1 }
  } else if vcode == FC_NUL_LIT_UNION {
    const vnluCtx = expCtxHere(ec)
    vnluCtx.litUnion = 1
    vnluCtx.nulLitUnion = true
    if emitExprExpect(body, valIx, fnIx, vnluCtx) < 0 { return -1 }
  } else if vcode == FC_NUL_CLOSURE {
    const ncCtx = expCtxHere(ec)
    if emitExprExpect(body, valIx, fnIx, ncCtx) < 0 { return -1 }
  } else if vcode == FC_NUL_NONE {
    if emitNulNoneForEffect(body, valIx, fnIx, ec) < 0 { return -1 }
    fbRefNullNone()
  } else if variantFieldIsLitUnionArray(vi, fj) {
    const vlaCtx = expCtxHere(ec)
    vlaCtx.litUnion = 1
    if emitExprExpect(body, valIx, fnIx, vlaCtx) < 0 { return -1 }
  } else if vcode == FC_UNION {
    if (
      emitUnionBoxArg(
        body,
        variantFieldElemName(vi, fj),
        uFieldElemTyIxAt(vi, fj),
        valIx,
        fnIx,
        ec,
      )
      < 0
    ) {
      return -1
    }
  } else if vcode == FC_I32 && variantFieldIsLitUnion(vi, fj) {
    const fluCtx = expCtxHere(ec)
    fluCtx.litUnion = 1
    if emitExprExpect(body, valIx, fnIx, fluCtx) < 0 { return -1 }
  } else if vcode == FC_I32_LIST && variantFieldIsLitUnionArray(vi, fj) {
    const flaCtx = expCtxHere(ec)
    flaCtx.litUnion = 1
    if emitExprExpect(body, valIx, fnIx, flaCtx) < 0 { return -1 }
  } else if (
    (vcode == FC_STR || vcode == FC_NUL_STR)
    && exprIsLitAtom(valIx, fnIx)
  ) {
    if emitStrValue(body, valIx, fnIx, ec) < 0 { return -1 }
  } else {
    if emitExpr(body, valIx, fnIx, ec) < 0 { return -1 }
  }
  0
}

function emitVariantStruct(
  body: u8[],
  objIx: i32,
  vi: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if guardVariantFieldSpan(vi, "emitVariantStruct") < 0 { return -1 }
  if vi < 0 { return -1 }
  const start = uFieldStart[vi]
  const cnt = uFieldCount[vi]
  // D1510 — source-order evaluation, `emitObj`'s rule for the union-arm literal. A variant
  // row's fields are laid out sorted by name too, so `{ kind: "rect", w: f(), h: g() }` is
  // pushed `h, kind, w` and would run its initialisers permuted without this.
  const stash: i32[] = []
  if objLitNeedsOrderStash(objIx, uFieldNames, start, cnt) {
    let pj = 0
    while pj < cnt {
      stash.push(0 - 1)
      pj = pj + 1
    }
    const ord = objFieldSrcOrder(objIx, uFieldNames, start, cnt)
    let oj = 0
    while oj < ord.length {
      const ofj = ord[oj]
      const ovIx = objFieldVal(objIx, uFieldNames[start + ofj])
      if ovIx < 0 {
        return emitFail(
          "emitProgram: object literal is missing a union-variant field",
        )
      }
      if emitVariantFieldValue(body, vi, ofj, ovIx, fnIx, ec) < 0 { return -1 }
      const oslot = objOrderStashSlot(
        variantFieldTypeAt(vi, ofj),
        uFieldStorageSlot(vi, ofj),
      )
      stash[ofj] = oslot
      fbLocalSet(oslot)
      oj = oj + 1
    }
  }
  let fj = 0
  while fj < cnt {
    const valIx = objFieldVal(objIx, uFieldNames[start + fj])
    if valIx < 0 && stash.length == 0 && variantFieldMayOmit(vi, fj) {
      // A field the literal leaves out holds null, as a plain struct's does, built exactly as
      // the literal `null` written there would be (D2223).
      const nullIx = mkNull("null", -1)
      if emitVariantFieldValue(body, vi, fj, nullIx, fnIx, ec) < 0 { return -1 }
      fj = fj + 1
      continue
    }
    if valIx < 0 {
      return emitFail(
        "emitProgram: object literal is missing a union-variant field",
      )
    }
    if stash.length > 0 {
      fbLocalGet(stash[fj])
      fj = fj + 1
      continue
    }
    if emitVariantFieldValue(body, vi, fj, valIx, fnIx, ec) < 0 { return -1 }
    fj = fj + 1
  }
  if objLitHasFieldOutside(objIx, start, cnt) {
    return emitFailAt(
      "emitProgram: object literal writes a field its union variant does not declare",
      objIx,
    )
  }
  fbStructNew(uVarHeap[vi])
  0
}

// Whether the literal at `objIx` writes a field outside `uFieldNames[start..start+cnt)`. Such
// a literal is not this arm, whatever hint routed it to the variant builder (D2302).
function objLitHasFieldOutside(objIx: i32, start: i32, cnt: i32): boolean {
  const o = nodeAt(objIx)
  if !(o is ObjLit) { return false }
  let i = 0
  while i < o.objFields.length {
    const f = nodeAt(o.objFields[i])
    if f is FieldInit {
      let k = 0
      let found = false
      while k < cnt && !found {
        if uFieldNames[start + k] == f.fiName { found = true }
        k = k + 1
      }
      if !found { return true }
    }
    i = i + 1
  }
  false
}

// The store-side value of variant `vi`'s field `fi`, shared by the three `emitAssign` member
// stores: a box-union field boxes the right-hand side, f64 / i64 / f32 fields re-encode it,
// and any other code emits it plainly.
function emitVariantFieldStoreVal(
  body: u8[],
  vi: i32,
  fi: i32,
  valIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const code = variantFieldTypeAt(vi, fi)
  if code == FC_UNION {
    return emitUnionBoxArg(
      body,
      variantFieldElemName(vi, fi),
      uFieldElemTyIxAt(vi, fi),
      valIx,
      fnIx,
      ec,
    )
  }
  emitScalarFieldStoreVal(body, valIx, fnIx, code, ec)
}

function emitScalarFieldStoreVal(
  body: u8[],
  valIx: i32,
  fnIx: i32,
  code: i32,
  ec: ExpCtx,
) {
  if code == FC_F64 { return emitExprAsF64(body, valIx, fnIx, ec) }
  if code == FC_I64 { return emitExprAsI64(body, valIx, fnIx, ec) }
  if code == FC_F32 { return emitExprAsF32(body, valIx, fnIx, ec) }

  if code == FC_STR || code == FC_NUL_STR {
    if exprIsLitAtom(valIx, fnIx) { return emitStrValue(body, valIx, fnIx, ec) }
  }
  emitExpr(body, valIx, fnIx, ec)
}

// Lower an object literal `{ f: v, … }` boxed into the declared union onto `body`:
// `struct.new $box (i32.const tagOf(variant)) (struct.new $variant <fields…>)`. The
// literal must match exactly one union variant's field-name set, else it fails loudly.
function emitUnionBox(body: u8[], objIx: i32, fnIx: i32, ec: ExpCtx) {
  const vi = objVariantRowCtx(objIx, fnIx)
  if vi < 0 {
    return emitFail("emitProgram: object literal matches no union variant")
  }
  emitUnionBoxAs(body, objIx, vi, fnIx, ec)
}

// The body of `emitUnionBox` with the variant already resolved — the union-context pick
// (`unionArmVariantForObj`) enters here with its own `vi`.
function emitUnionBoxAs(
  body: u8[],
  objIx: i32,
  vi: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  fbI32Rel(RS_TAG, uTags[vi])
  if emitVariantStruct(body, objIx, vi, fnIx, ec) < 0 { return -1 }
  fbStructNew(uBoxIdx)
  0
}

// Box a struct-typed expression (an ident or call result already built as the plain
// struct `sHeapIdx[ssi]`) into union variant `vi`, whose variant struct is a layout twin
// of but a distinct heap type from it: a plain ref fails the box payload's cast, so
// rebuild the variant struct field by field from the source, then box.
function emitStructExprAsVariantBox(
  body: u8[],
  exprIx: i32,
  vi: i32,
  ssi: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // The guard covers the two span tables; `uTags` and `uVarHeap` are instead one row per
  // `uVariants` row, minted after the last pass that can push one. Each caller bounds `ssi`
  // its own way — `structIdxMatchesVariantIdx` here, `bssi < sHeapIdx.length` at the argument
  // boundary — so neither hands one on unchecked.
  if guardVariantFieldSpan(vi, "emitStructExprAsVariantBox") < 0 { return -1 }
  if vi < 0 { return -1 }
  const names: string[] = []
  const codes: i32[] = []
  variantRowFields(vi, names, codes)
  fbI32Rel(RS_TAG, uTags[vi])
  if emitRecCopy(body, exprIx, ssi, uVarHeap[vi], names, codes, fnIx, ec) < 0 {
    return -1
  }
  fbStructNew(uBoxIdx)
  0
}

// The node `emitRecCopy` is reading its fields from, so the re-entry emits the record itself.
let recCopyHeld = -1

// A fresh record at the heap `dHeap`, whose fields are `dNames` stored as `dCodes`, built from
// the record `exprIx` evaluates to at struct row `ssi`: field by field, each number converted
// (`i32` into `i64`). A source that cannot be re-read is evaluated once into `variantReboxSlot`.
function emitRecCopy(
  body: u8[],
  exprIx: i32,
  ssi: i32,
  dHeap: i32,
  dNames: string[],
  dCodes: i32[],
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  const held = recCopyHeld
  recCopyHeld = exprIx
  const r = emitRecCopyFields(body, exprIx, ssi, dNames, dCodes, fnIx, ec)
  recCopyHeld = held
  if r < 0 { return -1 }
  fbStructNew(dHeap)
  0
}

// `emitRecCopy`'s field loop, with `exprIx` held so each read emits the record itself.
function emitRecCopyFields(
  body: u8[],
  exprIx: i32,
  ssi: i32,
  dNames: string[],
  dCodes: i32[],
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if ssi < 0 || ssi >= sHeapIdx.length {
    return emitFailAt(
      "emitProgram: a record copied at its delivery has no row",
      exprIx,
    )
  }
  const sHeap = sHeapIdx[ssi]
  const reReadable = dNames.length == 1 || exprReReadable(unwrapParen(exprIx))
  if !reReadable {
    if !fnUsesVariantRebox {
      return emitFail(
        "emitProgram: a multi-field record from a call is copied with no scratch slot reserved",
      )
    }
    if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
    fbLocalSet(variantReboxSlot)
  }
  let fj = 0
  while fj < dNames.length {
    const sfi = sFieldIndex(ssi, dNames[fj])
    if sfi < 0 {
      return emitFailAt(
        "emitProgram: a copied record lacks a field of its destination",
        exprIx,
      )
    }
    if reReadable {
      if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
    } else {
      fbLocalGet(variantReboxSlot)
      fbRefCast(sHeap)
    }
    fbStructGet(sHeap, sfi)
    const sk = fieldCodeNumKind(sFieldTypeAt(ssi, sfi))
    const vk = fieldCodeNumKind(dCodes[fj])
    if sk >= 0 && vk >= 0 && sk != vk {
      if njConvert(sk, vk) < 0 { return -1 }
    }
    fj = fj + 1
  }
  0
}

// The row a delivery of `exprIx` copies its record into (`recCopyTyOf`): a struct row, `-2 - vi`
// for the variant row `vi` of an arm type, or -1 when the record is already built there or no
// copy is recorded.
function recCopyRowAt(exprIx: i32, fnIx: i32): i32 {
  const dst = recCopyTyOf(exprIx)
  if dst < 0 || exprIx == recCopyHeld || !exprStruct(exprIx, fnIx) { return -1 }
  const ssi = structIndexOfExpr(exprIx, fnIx)
  if ssi < 0 || ssi >= sHeapIdx.length { return -1 }
  const vi = repVariantShapeRowOf(dst)
  if vi >= 0 && vi < uVarHeap.length {
    if uVarHeap[vi] == sHeapIdx[ssi] { return -1 }
    return -2 - vi
  }
  const dsi = structIndexOfTy(dst)
  if dsi < 0 || dsi >= sHeapIdx.length || sHeapIdx[dsi] == sHeapIdx[ssi] {
    return -1
  }
  dsi
}

// `emitExpr` for a value whose delivery copies it into the row `row` names (`recCopyRowAt`).
function emitRecCopyInto(
  body: u8[],
  exprIx: i32,
  row: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  const names: string[] = []
  const codes: i32[] = []
  const ssi = structIndexOfExpr(exprIx, fnIx)
  if row <= -2 {
    const vi = -2 - row
    if guardVariantFieldSpan(vi, "emitRecCopyInto") < 0 { return -1 }
    variantRowFields(vi, names, codes)
    return emitRecCopy(body, exprIx, ssi, uVarHeap[vi], names, codes, fnIx, ec)
  }
  if (
    row < 0
    || row >= sHeapIdx.length
    || row >= sFieldCount.length
    || row >= sFieldStart.length
  ) {
    return emitFailAt(
      "emitProgram: a record copied at its delivery has no row",
      exprIx,
    )
  }
  let fj = 0
  while fj < sFieldCount[row] {
    names.push(sFieldNames[sFieldStart[row] + fj])
    codes.push(sFieldTypeAt(row, fj))
    fj = fj + 1
  }
  emitRecCopy(body, exprIx, ssi, sHeapIdx[row], names, codes, fnIx, ec)
}

// Pushes variant row `vi`'s field names and codes onto `names` and `codes`, in layout order.
function variantRowFields(vi: i32, names: string[], codes: i32[]) {
  let fj = 0
  while fj < uFieldCount[vi] {
    names.push(uFieldNames[uFieldStart[vi] + fj])
    codes.push(uFieldTypes[uFieldStart[vi] + fj])
    fj = fj + 1
  }
  0
}

// Whether print's argument `ax` is a union box that the scalar ladder would print as its tag:
// a call's result, or a name whose slot is the box and no narrowing unboxes.
function printArgIsUnclassifiedBox(ax: i32, fnIx: i32): boolean {
  if !exprUnion(ax, fnIx) { return false }
  const ax0 = unwrapParen(ax)
  if ax0 < 0 { return false }
  if nodeAt(ax0) is Call { return true }
  printArgIsBoxName(ax0, fnIx)
}

// Whether `ix` names a slot holding a union box that no narrowing unboxes to one type: a partial
// narrowing (the `else` of `is string` over `i32 | R | string`) still leaves the box.
function printArgIsBoxName(ix: i32, fnIx: i32): boolean {
  const n = nodeAt(ix)
  if n is Ident {
    return narrowedArmTyOf(n.identName) < 0
      && identSlotIsUnionBox(fnIx, n.identName)
  }
  false
}

// The compile-time value of a monomorphized-instance `is` guard: 1 (always true), 0
// (always false), or -1 (not statically decidable, so `emitIs`'s runtime paths handle
// it). Each instance pins an un-annotated param to one concrete type.
function monoStaticIsResult(isIx: i32, fnIx: i32) {
  const nd = nodeAt(isIx)
  if nd is IsExpr {
    if variantIndexOf(nd.isVariant) >= 0 { return -1 }

    if nodeTyIsUnion(nd.isObj) {
      const rsp = isVariantSpellingAtRecv(
        nd.isVariant,
        isVarTyIxOf(isIx),
        nd.isObj,
      )
      if variantIndexOf(rsp) >= 0 { return -1 }
    }
    if exprUnion(nd.isObj, fnIx) { return -1 }
    const objTy = nodeTyAt(unwrapParen(nd.isObj), fnIx)
    if isWholeOfOneListUnion(objTy, isVarTyIxOf(isIx)) { return 1 }

    // An exact instance knows the operand's type, where a spelling renders a Set as its
    // boolean map: a union is no static answer, and a single type is its own (D2753).
    const ext = exactOperandTyOf(nd.isObj, fnIx)
    if ext >= 0 {
      const exm: i32[] = []
      flattenVariantsInto(ext, exm)
      if exm.length > 1 { return -1 }
      const ept = isVarTyIxOf(isIx)
      if ept >= 0 {
        if tySameSet(ext, ept, TY_WALK_DEPTH) { return 1 }
        if tySameSpelled(ext, ept, TY_WALK_DEPTH) { return 0 }
      }
    }

    if nodeTyIsNullable(nd.isObj) { return -1 }
    // A join the instance re-typed at its pin answers only for its own type; the name cascade
    // below reads its arms' reps instead (D3568).
    const jo = unwrapParen(nd.isObj)
    if jo >= 0 && nodeAt(jo) is IfStmt {
      const jt = nodeTyIxOf(jo)
      if jt >= 0 && !tyHasTyVar(jt) {
        const ept = isVarTyIxOf(isIx)
        if ept >= 0 && tySameSet(jt, ept, TY_WALK_DEPTH) { return 1 }
        return -1
      }
    }
    const sk = monoArgTyName(nd.isObj, fnIx)
    if sk == "" { return -1 }

    if sigKeyPinPayload(sk) != "" {
      const fvTy = monoArgPinTyIx(nd.isObj, fnIx)
      const fvTest = isVarTyIxOf(isIx)
      if fvTy >= 0 && fvTest >= 0 && tySame(fvTy, fvTest) { return 1 }
      // D951 — the one instantiation the spelling substitution cannot bank a row for. At
      // `T := (i32) => i32` the monomorphizer binds `T` to the `$fnsig` key (`=>i>i`), a name
      // that exists only as a string and that `nameToTy` cannot parse back, so `isVarTyIxOf`
      // is -1 for the substituted node and the arena compare above cannot fire.

      // The spelling is the sound answer here and nowhere else: `sk` is itself a sigkey, and a
      // sigkey is a pure encoding of a function type carrying no identity of its own, so two
      // equal keys are the same function type. Placed inside this arm so it can only add a
      // true the arena compare had no rows to reach.
      if sk == nd.isVariant { return 1 }
      return 0
    }
    if sk == nd.isVariant { return 1 }

    const cmpTy = isVarTyIxOf(isIx)
    if cmpTy >= 0 && !tyRenderSoftensLits(cmpTy) {
      if sk == tyToEmitName(cmpTy) { return 1 }
    }

    // `is` tests value fit, so a record whose every value fits the tested one is it whatever row
    // stores it, and one that fits only some values leaves the answer to the stored value (D8300).
    // An operand whose type is still open answers with its pin, a `#anon` row with its
    // literal's own record.
    let rcv = if ext >= 0 { ext } else { objTy }
    if rcv < 0 || !(tyAt(rcv) is TyObj) || tyHasTyVar(rcv) {
      rcv = if sk[0] == '#' { anonRowOwnTyOf(sk) } else { declTyIxOfName(sk) }
    }
    if cmpTy >= 0 && rcv >= 0 && !tyHasTyVar(rcv) {
      const fk = recArmFitKind(cmpTy, rcv)
      if fk == 1 { return 1 }
      if fk == 2 { return -1 }
    }
    const rm = repIsRowMatchTy(sk, isVarTyIxOf(isIx), repScanLim())
    if rm >= 0 { return rm }
    return 0
  }
  -1
}

// Whether `xTy` is the one list a union of one-list members `recvTy` reps as, with a plain
// scalar leaf: every value of `recvTy` fits it, whichever member spelled it (D6770).
function isWholeOfOneListUnion(recvTy: i32, xTy: i32): boolean {
  if recvTy < 0 || xTy < 0 || xTy >= T.tys.length { return false }
  if oneListUnionRender(recvTy) == "" { return false }
  const ru = tyAt(recvTy)
  if !(ru is TyUnion) { return false }
  const xd = listLeafDepth(xTy)
  if xd <= 0 { return false }
  const pn = tyPrimNameOf(listLeafOf(xTy))
  if pn == null || pn == "string" { return false }
  const m = ru.uMembers[0]
  if listLeafDepth(m) != xd { return false }
  tyScalarBasePrim(listLeafOf(m)) == pn
}

// How many list levels `ty` has before its leaf, or -1 on an arena hole.
function listLeafDepth(ty: i32): i32 {
  let cur = ty
  let d = 0
  while d < 64 {
    if cur < 0 || cur >= T.tys.length { return -1 }
    const t = tyAt(cur)
    if !(t is TyArray) { return d }
    cur = t.aElem
    d = d + 1
  }
  -1
}

// The leaf element type of the list `ty`, or `ty` itself when it is no list.
function listLeafOf(ty: i32): i32 {
  let cur = ty
  let d = 0
  while d < 64 && cur >= 0 && cur < T.tys.length {
    const t = tyAt(cur)
    if !(t is TyArray) { return cur }
    cur = t.aElem
    d = d + 1
  }
  cur
}

// Whether no arm of the union box `recvIx` reads at can carry the value-arm tag `tag`: each arm
// claims another value tag, or is a struct variant, whose tag is below every value tag. False
// when the union is unnamed or an arm is neither, so its tag set is not known.
function unionBoxLacksTag(recvIx: i32, tag: i32, fnIx: i32): boolean {
  if tag < uVariants.length { return false }
  const nm = unionNameOfExpr(recvIx, fnIx)
  if nm == "" { return false }
  const declTy = unionDeclTyIxOfIdentRead(recvIx, fnIx)
  const atoms: string[] = []
  const arms: i32[] = []
  if !unionSetArmTysAB(91, nm, declTy, atoms, arms) || arms.length == 0 {
    return false
  }
  const u = unionRowKeyAB(91, nm, declTy)
  let i = 0
  while i < arms.length {
    const t = isArmTagOfTy(arms[i])
    if t == tag { return false }
    if (
      t < 0
      && variantRowInRowOfTy(u, arms[i]) < 0
      && !(tyAt(arms[i]) is TyObj)
    ) {
      return false
    }
    i = i + 1
  }
  true
}

// The value-atom kind the payload of box arm `armTy` rides, given the arm's own kind `k`: a
// literal-union arm (kind -1, no value atom) is held as its member string, so it rides kind 2.
// Read off the arm's type, never its spelling, so an alias arm resolves too (D5260).
function boxArmKindOfTy(k: i32, armTy: i32): i32 {
  if k >= 0 { return k }
  if tyIsLitUnion(armTy) { return 2 }
  k
}

// The box tag `isArmTagOfTy` tests `ity` by, or -1 for none: a list of numeric literals
// (`K[]` where `type K = 0 | 1`) shares the `i32[]` tag, so its fit is an element test (D4778).
function scalarArmKindOfTy(ity: i32): i32 {
  const t = tyAt(ity)
  if t is TyArray {
    if numLitUnionBaseTy(t.aElem) >= 0 { return -1 }
  }
  boxTagOfTy(ity)
}

// The union-box tag the type `ity` claims as a value-union arm, or -1 when it claims none
// (a struct variant, a literal, an un-interned shape). A bare function-type arm tags on
// its interned signature slot rather than the flat kind-11 value-atom tag — kind 11 alone
// would make `x is F` true for a value built through any function-typed arm.
function isArmTagOfTy(ity: i32): i32 {
  if ity < 0 { return -1 }
  // A literal (`"err"`, `3`, `1 | 2`) is tested by its value, which no tag alone decides.
  if tyAt(ity) is TyLit || numLitUnionBaseTy(ity) >= 0 { return -1 }
  const ak = scalarArmKindOfTy(ity)
  if ak == 11 { return cloArmTagOfTy(ity) }
  if ak == 7 && vbAtomListUsed && tyIsAtomLeafList(ity) {
    return atomListArmTag()
  }
  if ak == 17 { return boolListArmTag(0) }
  if ak == 18 {
    if vbBoolListTop < 0 { return -1 }
    return scalarTagOfKind(18)
  }
  if ak >= 0 { return scalarTagOfKind(ak) }

  // A map type no box arm registered claims no tag (-1): a nullable single map is a niche whose
  // test is the null test, and no box can hold a type none of its arms is (D2493).
  if unMemIsMap(ity) {
    return mapArmTagOfTy(ity, mapShapeFoldSet(mapArmShapeOfTy(ity)))
  }
  const ad = atomLeafListArmTag(atomLeafListDepthOfTy(ity))
  if ad >= 0 { return ad }
  // A nested boolean-leaf list shares its reflist slot with the `i32` twin, not its tag.
  const bd = boolLeafListDepthOfTy(ity)
  if bd >= 1 { return boolListArmTag(bd) }
  if unMemIsRefElemArray(ity) {
    // A list of Sets shares its element slot with the list of boolean maps, so that slot's tag
    // is not the Set list's own and no box is known to carry it (D2753).
    if tyMentionsSet(tyRefArrElemOf(ity), TY_WALK_DEPTH) { return -1 }
    const sl = rlSlotOfTy(tyRefArrElemOf(ity))
    if sl >= 0 { return refArrSlotTag(sl) }
  }
  -1
}

// The arena type the active narrowing of `name` binds, or -1 when `name` is not narrowed
// or the narrowing carries no single type. A complement push (`x != null`) carries a
// member set instead, whose sole surviving member is the bound type.
function narrowedArmTyOf(name: string): i32 {
  const i = narrowSlotOf(name)
  if i < 0 { return -1 }
  narrowSlotTyOf(i)
}

// `recv == <numeric literal>` onto `body`, leaving a 0/1 i32 — the scalar value test shared
// by the bare-literal `is` spelling and the numeric-litunion membership ladder. The
// compare's width follows the lexeme and receiver directly, so a membership ladder cannot
// disagree with the receiver's own valtype.
function emitNumLitEq(
  body: u8[],
  recvIx: i32,
  lv: string,
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitExpr(body, recvIx, fnIx, ec) < 0 { return -1 }
  if numLexIsFloat(lv) {
    fbF64Const(lv)
    fbI32Bin(97)
    return 0
  }
  if exprIsI64(recvIx, fnIx) || !numLexFitsI32(lv) {
    const pr = parseI64Pair(lv)
    fbI64Const(pr[0], pr[1])
    fbI32Bin(81)
    return 0
  }
  fbI32Const(parseI32(lv))
  fbI32Bin(70)
  return 0
}

// Whether a receiver of base `base` can be read once and compared with every one of `texts`:
// each is an integer, and fits `i32` where the base is `i32`; any other base declines.
function numLitOnceReadOk(base: string, texts: string[]): boolean {
  const narrow = base == "i32"
  for t in texts {
    if numLexIsFloat(t) || narrow && !numLexFitsI32(t) { return false }
  }
  narrow || base == "i64"
}

// A fresh lazy-frame slot holding a receiver of base `base`, `i32` or `i64`.
function numLitOnceSlot(base: string): i32 {
  if base == "i64" { return listElemStashSlot("i64", 0) }
  strI32Slot()
}

// Compares the `base` value on the stack, `i32` or `i64`, with the literal `lv`.
function emitNumLitConstEq(base: string, lv: string) {
  if base == "i64" {
    const pr = parseI64Pair(lv)
    fbI64Const(pr[0], pr[1])
    fbI32Bin(81) // 0x51 i64.eq
    return 0
  }
  fbI32Const(parseI32(lv))
  fbI32Bin(70) // 0x46 i32.eq
  0
}

// The base numeric scalar an `is` receiver reps as in this instance — `"i32"`/`"i64"`/
// `"f64"`, or `""` otherwise. `nodeNumScalarBaseName` reads the checker's bank; an
// un-annotated parameter has none, so `monoArgTyName` answers per instance. A nullable
// receiver is refused, since its name would drop the `null`.
function isNumRecvBaseName(recvIx: i32, fnIx: i32) {
  const nb = nodeNumScalarBaseName(recvIx)
  if nb != "" { return nb }
  if nodeTyIsNullable(recvIx) { return "" }
  const mn = monoArgTyName(recvIx, fnIx)
  if mn == "i32" || mn == "i64" || mn == "f64" { return mn }
  ""
}

// The value-union name of an `is` receiver, for the box-tag soundness floor in `emitIs`.
// `unionNameOfExpr` covers every receiver form except the optional chain, whose leaf field
// is resolved here instead. `""` when the receiver is not a union.
function isStrTagUnionNameOf(exprIx: i32, fnIx: i32) {
  const nm = unionNameOfExpr(exprIx, fnIx)
  if nm != "" { return nm }
  const e = nodeAt(unwrapParen(exprIx))
  if e is OptMember {
    const si = optChainStructIdxOf(e.omObj, fnIx)
    if si >= 0 {
      const fi = sFieldIndex(si, e.omProp)
      if fi >= 0 {
        if sFieldTypeAt(si, fi) == FC_UNION { return sFieldElemNameAt(si, fi) }
      }
    }
  }
  ""
}

// The operand of `x == null` / `null == x` whose checked type admits no `null`, or whose hole
// instance `fnIx` binds it to a function type, or -1.
// A capture cell's read `c[0]` carries the checker's type for the name it replaced, which is
// how a narrowing of that name reaches its null tests (D3302).
function cellReadProvesNonNull(ix: i32): boolean {
  if !cboxReadTy.has(ix) { return false }
  tyProvesNonNull(cboxReadTy[ix] ?? -1)
}

function deadNullTestOperand(e: BinExpr, fnIx: i32): i32 {
  const l = unwrapParen(e.binLeft)
  const r = unwrapParen(e.binRight)
  if l < 0 || r < 0 || l >= P.nodes.length || r >= P.nodes.length { return -1 }
  if (
    nodeAt(r) is NullLit
    && !(nodeAt(l) is NullLit)
    && (nodeTyProvesNonNull(l)
      || cellReadProvesNonNull(l)
      || holeBindsFunc(l, fnIx)
      || holePinProvesNonNull(l, fnIx))
  ) {
    return l
  }
  if (
    nodeAt(l) is NullLit
    && !(nodeAt(r) is NullLit)
    && (nodeTyProvesNonNull(r)
      || cellReadProvesNonNull(r)
      || holeBindsFunc(r, fnIx)
      || holePinProvesNonNull(r, fnIx))
  ) {
    return r
  }
  -1
}

// Lower a dead null test to its constant: the operand runs for its effects unless it is a
// bare name, and is never read as nullable (DECISIONS.md, the dead null test).
function emitDeadNullTest(
  body: u8[],
  opIx: i32,
  isNe: boolean,
  fnIx: i32,
  ec: ExpCtx,
) {
  if !(nodeAt(opIx) is Ident) {
    if emitExpr(body, opIx, fnIx, ec) < 0 { return -1 }
    fbDrop()
  }
  if isNe { fbI32Const(1) } else { fbI32Const(0) }
  0
}

// The null test for a nullable value — `x == null`/`x != null` and the `x is null`/`x is
// <member>` guard ask the same question of the same rep. Leaves a 0/1 i32 (1 = null unless
// `invert`); 0 means no arm claims the rep. `nicheOnly` restricts to single-non-null-member
// reps (a box or optional chain has several, so "not null" cannot identify one).
function emitNulIsNullTest(
  body: u8[],
  refIx: i32,
  fnIx: i32,
  invert: boolean,
  nicheOnly: boolean,
  ec: ExpCtx,
) {
  if !nicheOnly || !invert {
    // claimed first: every arm below reads the declared nullable rep while a narrowed
    // binding is read at its arm's rep, so without this the assignment spelling gets no arm.
    const nnRef = nodeAt(unwrapParen(refIx))
    let nnKey = ""
    if nnRef is Ident {
      nnKey = nnRef.identName
    } else {
      nnKey = placeNarrowKeyOf(refIx)
    }
    // A place the checker proved non-null under its narrowing holds no null, whatever rep the
    // narrowing pushed for it.
    // A field or cell folds only on the checker's proof as well, which settles a call that
    // may have written it; a bare name's narrowing is retired where the checker's is.
    let nnFold = nnKey != "" && narrowExcludesNull(nnKey)
    if !(nnRef is Ident) && nnKey != "" {
      nnFold = narrowSlotOf(nnKey) >= 0 && nodeTyProvesNonNull(refIx)
    }
    if nnFold {
      if invert { fbI32Const(1) } else { fbI32Const(0) }
      return 1
    }
  }

  if exprNulBool(refIx, fnIx) {
    if emitExpr(body, refIx, fnIx, ec) < 0 { return -1 }
    fbI32Const(2)
    if invert { fbI32Bin(71) } else { fbI32Bin(70) }
    return 1
  }
  if exprNulLitUnion(refIx, fnIx) {
    if emitExpr(body, refIx, fnIx, ec) < 0 { return -1 }
    fbI32Const(-1)
    if invert { fbI32Bin(71) } else { fbI32Bin(70) }
    return 1
  }
  if !nicheOnly {
    const ncN = nodeAt(unwrapParen(refIx))
    if ncN is OptMember {
      const ncSv = optRecvStageSave()
      optRecvStageMark(refIx)
      if emitOptChainIsNull(body, refIx, fnIx, ec) < 0 { return -1 }
      optRecvStageRestore(ncSv)
      if invert { fbI32Eqz() }
      return 1
    }

    if mapReadScalarBoxKindTy(refIx) >= 0 {
      const mnRef = nodeAt(unwrapParen(refIx))
      if mnRef is Index {
        if emitMapHas(body, mnRef.idxArr, mnRef.idxIndex, fnIx, ec) < 0 {
          return -1
        }
        if !invert { fbI32Eqz() }
        return 1
      }
    }
    if exprUnion(refIx, fnIx) || nodeTyIsNulNumLitUnion(refIx) {
      if emitExpr(body, refIx, fnIx, ec) < 0 { return -1 }
      fbStructGet(uBoxIdx, 0)
      fbI32Rel(RS_TAG, nullBoxTag())
      if invert { fbI32Bin(71) } else { fbI32Bin(70) }
      return 1
    }
  }

  if nodeRepIsNullRef(refIx, fnIx) {
    if emitExpr(body, refIx, fnIx, ec) < 0 { return -1 }
    fbRefIsNull()
    if invert { fbI32Eqz() }
    return 1
  }

  if exprNullableString(refIx, fnIx) {
    // the one arm that must read the receiver raw: a kind-16 ident is otherwise recovered
    // to non-null, which would make `ref.is_null` a const 0.
    const nsCtx = expCtxHere(ec)
    nsCtx.rawNullRead = true
    if emitExprExpect(body, refIx, fnIx, nsCtx) < 0 { return -1 }
    fbRefIsNull()
    if invert { fbI32Eqz() }
    return 1
  }
  if !nicheOnly { return emitInstMapReadIsNull(body, refIx, fnIx, invert, ec) }
  0
}

// The null test of a map read `m[k]` / `m.get(k)` whose instance pins the map's value to a
// scalar, which reads unboxed there: the probe's miss is the null. 0 when not this shape.
function emitInstMapReadIsNull(
  body: u8[],
  refIx: i32,
  fnIx: i32,
  invert: boolean,
  ec: ExpCtx,
) {
  const r = nodeAt(unwrapParen(refIx))
  let recvIx = -1
  let keyIx = -1
  if r is Index {
    recvIx = r.idxArr
    keyIx = r.idxIndex
  } else if r is Call {
    if r.callFn < 0 || r.callArgs.length != 1 { return 0 }
    const callee = nodeAt(r.callFn)
    if callee is Member {
      if callee.memProp == "get" {
        recvIx = callee.memObj
        keyIx = r.callArgs[0]
      }
    }
  }
  if recvIx < 0 || !exprMap(recvIx, fnIx) { return 0 }
  if mapRecvScalarKindInst(recvIx, fnIx) < 0 { return 0 }
  // A stored `null` is a hit the probe cannot tell from a value.
  if tyBearsNull(tyMapValOf(mapRecvTyIn(recvIx, fnIx))) { return 0 }
  if emitMapHas(body, recvIx, keyIx, fnIx, ec) < 0 { return -1 }
  if !invert { fbI32Eqz() }
  1
}

// True when `recvIx`'s storage is the `string | null` niche and it is still nullable here:
// `nodeTyIsNullable` disagreeing with the declaration-scoped `exprNullableString` is the
// `!= null` narrowing signal. A read typed at a type parameter carries no such bank, so it
// takes the guarded compare (D3332).
function litMemberRecvIsNulString(recvIx: i32, fnIx: i32) {
  exprNullableString(recvIx, fnIx)
    && (nodeTyIsNullable(recvIx) || nodeTyHasTyVar(unwrapParen(recvIx)))
}

// `<string | null> is "<m>"` over a null receiver answers false — not an impossibility to
// `ref.as_non_null` away. Read the receiver once as the raw nullable ref; `br_on_null`
// (which consumes it) decides between the string compare and a const 0, mirroring
// `emitPrintNulString`'s block shape rather than the coalesce's.
function emitNulStrLitEq(
  body: u8[],
  recvIx: i32,
  lex: string,
  fnIx: i32,
  ec: ExpCtx,
) {
  fbBlock(127)
  fbBlock(64)

  const rawCtx = expCtxHere(ec)
  rawCtx.rawNullRead = true
  if emitExprExpect(body, recvIx, fnIx, rawCtx) < 0 { return -1 }
  fbBrOnNull(0)
  if emitStrEqLit(body, mkStr(lex, -1), fnIx, ec) < 0 { return -1 }
  fbBr(1)
  fbEnd()
  fbI32Const(0)
  fbEnd()
  0
}

// One member-literal test `recv == <lex>`, in whichever shape the receiver's rep demands:
// the tag-gated payload compare over a value-union box, the null-guarded string compare
// over a `string | null` niche, plain string equality over a string ref, else the numeric
// compare. One home because the bare-literal `is` and the litunion ladder must agree.
function emitLitMemberEq(
  body: u8[],
  recvIx: i32,
  lex: string,
  fnIx: i32,
  ec: ExpCtx,
) {
  if exprUnion(recvIx, fnIx) {
    return emitUnionLitIs(body, recvIx, lex, fnIx, ec)
  }

  if nameIsQuotedLeaf(lex) {
    if !aUsed {
      return emitFail(
        "emitProgram: string `is` test but array type not collected",
      )
    }
    if litMemberRecvIsNulString(recvIx, fnIx) {
      return emitNulStrLitEq(body, recvIx, lex, fnIx, ec)
    }
    if emitExpr(body, recvIx, fnIx, ec) < 0 { return -1 }
    return emitStrEqLit(body, mkStr(lex, -1), fnIx, ec)
  }
  emitNumLitEq(body, recvIx, lex, fnIx, ec)
}

// shared refusal text: the membership ladder's own place bound and the box-tag compare's
// litunion guard are the same underlying refusal, so both callers say the same thing.
function emitFailNoMembershipRecv() {
  emitFail(
    "emitProgram: `is` over a literal union needs a re-readable receiver (each member re-reads it; a call / optional-chain receiver has no membership lowering)",
  )
}

// True when union `nm` carries a literal-union arm beside another value arm — the box
// shape where `x is K` is membership over the payload, never a tag compare (the litunion
// arm shares kind 2's tag with a plain `string` arm). Resolves an alias to its member set
// first: an un-resolved alias would wrongly fall into the tag compare.
function unionCarriesLitUnionArm(nm: string) {
  if nm == "" { return false }
  if nameIsLitUnionArmValueUnion(nm) { return true }
  const setNm = unionMemberSetOf(nm)
  if setNm == nm { return false }
  nameIsLitUnionArmValueUnion(setNm)
}

// How many members of `nm` ride the box as a string ref (a `string` arm or a literal-union
// arm), read from its row's member types, or -1 for a row with an untyped member. One: kind
// 2's tag discriminates that arm; two or more overlap in the tag, so `x is K` needs
// membership over the payload.
function unionStrArmCountOf(nm: string): i32 {
  const mems: i32[] = []
  if !unionMemberTysOf(nm, mems) { return -1 }
  let n = 0
  for m in mems {
    if m >= T.tys.length { return -1 }
    if primNameOf(m) == "string" || tyIsLitUnionOrLit(m) { n = n + 1 }
  }
  n
}

// Whether `recvIx` is a value-union box with no string or literal-union arm, so no string
// literal (`texts`, from `tyLitMemberTexts`) can be its value.
function litStrMembersOutsideBox(
  recvIx: i32,
  texts: string[],
  fnIx: i32,
): boolean {
  if texts.length == 0 || !exprUnion(recvIx, fnIx) { return false }
  const nm = unionNameOfExpr(recvIx, fnIx)
  if nm == "" || !isValueUnionOfSet(msSetOfUnion(nm), nm) { return false }
  unionStrArmCountOf(nm) == 0 && !unionCarriesLitUnionArm(nm)
}

// True when `recvIx` is a receiver `emitLitMemberEq` can be applied to repeatedly: a
// value-union box, a string-repped litunion, a plain `string`, or the `string | null`
// niche (whose compare answers false for null).
function litMembershipRecvOk(recvIx: i32, fnIx: i32) {
  if exprUnion(recvIx, fnIx) {
    const bxNm = unionNameOfExpr(recvIx, fnIx)
    if bxNm == "" { return false }
    if isValueUnionOfSet(msSetOfUnion(bxNm), bxNm) { return true }
    return unionCarriesLitUnionArm(bxNm)
  }
  if nodeTyIsLitUnion(recvIx) { return true }
  if exprString(recvIx, fnIx) { return true }

  exprNullableString(recvIx, fnIx)
}

// The primitive the tested type `ity` denotes, when it is one of the six value
// primitives; `""` for every shape a niche member cannot be confused with (struct, list,
// map, closure, literal, union). `ity` is the checker's own banked type, never re-parsed.
function isTestValuePrimName(ity: i32) {
  if ity < 0 { return "" }
  match tyPrimNameOf(ity) {
    "i32" => {
      return "i32"
    }
    "i64" => {
      return "i64"
    }
    "f32" => {
      return "f32"
    }
    "f64" => {
      return "f64"
    }
    "boolean" => {
      return "boolean"
    }
    "string" => {
      return "string"
    }
    // Not a value primitive a niche member can be confused with, or not a primitive at all.
    "void" | "null" | "never" | "u8" | "v128" | null => {}
  }
  ""
}

// The rep class of the sole non-null member of nullable niche `recvIx`: `"boolean"` /
// `"string"` for the two primitive niches, `"#ref"` for every reference shape, `""` for a
// receiver the `is`-niche ladder does not claim.
function nulNicheBaseClass(recvIx: i32, fnIx: i32) {
  const nk = exprNulKind(recvIx, fnIx)
  if nk == "nulbool" { return "boolean" }
  if nk == "nulstr" { return "string" }
  if nodeRepIsRefKind(recvIx, fnIx) { return "#ref" }
  ""
}

// True when `ity` provably cannot be the sole non-null member of nullable niche `recvIx`,
// so `recv is <ity>` is statically false — else the niche's own null test would wrongly
// answer true for every present value too. One-sided: both halves must be positively known.
function nulNicheIsTestImpossible(recvIx: i32, ity: i32, fnIx: i32) {
  // An exact instance knows the member the niche holds: its twin shares the pattern's row (D2753).
  if exactUnionLacksTwin(recvIx, ity, fnIx) { return true }
  // A map niche holds one map type: a pattern naming another map is never it (D2493).
  if unMemIsMap(ity) && !exprUnion(recvIx, fnIx) {
    // An instance parameter's pin names the niche's map exactly; a spelling needs the lenient
    // comparison, which declines where a Set or a literal union could be either.
    const pin = mapPinnedParamTyOf(recvIx, fnIx)
    if pin >= 0 { return !mapTwinExact(pin, ity) }
    // An instance keyed by its exact pins binds the receiver's type parameter to one type.
    const held = mapExactHeldTyOf(recvIx, fnIx)
    if held >= 0 { return !mapTwinExact(held, ity) }
    // No pin reaches this receiver, and the answer turns on which of the instance's maps it
    // holds, which its spelling cannot say (D2684).
    if mapNicheNeedsPin(fnIx, ity) {
      emitFailAt(
        "emitProgram: `is` cannot tell "
          + tyToEmitName(ity)
          + " from this instance's pinned map yet: test the parameter itself",
        recvIx,
      )
      return false
    }
    return mapNicheLacks(mapValueTyOf(recvIx, fnIx), ity)
  }
  const pTest = isTestValuePrimName(ity)
  if pTest == "" {
    // A record is never the member of a `string` or `boolean` niche, nor a literal union of a
    // reference or `boolean` one (D3344).
    if readIsCallResult(recvIx, fnIx) { return false }
    const pb = nulNicheBaseClass(recvIx, fnIx)
    if tyIsRecord(ity) { return pb == "string" || pb == "boolean" }
    if tyIsLitUnion(ity) { return pb == "#ref" || pb == "boolean" }
    // …nor a literal union of numbers the member of any of them (D3546).
    return pb != "" && numLitUnionBaseName(ity) != ""
  }
  const base = nulNicheBaseClass(recvIx, fnIx)
  if base == "" { return false }
  base != pTest
}

// `<recv>.<field fi of arm vi> == <lex>`, leaving an i32 — the one comparison D1023's
// membership chain is built from, reading the discriminant off the union box. The read is the
// narrow's own three steps, sound here for the reason the tag test that precedes it is: this
// runs only inside the `tag == …` conjunction, so the payload is the arm's struct.

// The compare is picked by the field's storage, not by the lexeme's looks. A string literal
// set has two reps — the interned i32 atom when the field's annotation is a registered alias,
// a `(ref $string)` when it is inline — and the lexeme is `"circle"` either way. The code
// column is what makes the answer independent of the arm's spelling.
function emitDiscrimFieldEq(
  body: u8[],
  recvIx: i32,
  vi: i32,
  fi: i32,
  lex: string,
  fnIx: i32,
  ec: ExpCtx,
) {
  if vi < 0 || vi >= uVarHeap.length {
    return emitFail(
      "emitProgram: discriminant test on an arm with no heap type",
    )
  }
  if guardVariantFieldSpan(vi, "emitDiscrimFieldEq") < 0 { return -1 }
  // The FIELD index is the second half of the same read, and it arrives from a caller's
  // loop rather than from the table — bound it here so the row this reads is provably
  // inside the arm's own span, not merely inside the flat store.
  if fi < 0 || fi >= uFieldCount[vi] {
    return emitFail(
      "emitProgram: emitDiscrimFieldEq: field "
        + i32ToStr(fi)
        + " is outside union-variant "
        + i32ToStr(vi)
        + "'s "
        + i32ToStr(uFieldCount[vi])
        + " fields",
    )
  }
  const code = uFieldTypes[uFieldStart[vi] + fi]
  if emitExpr(body, recvIx, fnIx, ec) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1)
  fbRefCast(uVarHeap[vi])
  fbStructGet(uVarHeap[vi], fi)
  emitFieldLitEq(body, code, lex, fnIx, ec)
}

// Compares the field value on the stack, stored as field code `code`, with the literal `lex`.
function emitFieldLitEq(
  body: u8[],
  code: i32,
  lex: string,
  fnIx: i32,
  ec: ExpCtx,
) {
  if code == FC_STR || code == FC_NUL_STR {
    if !aUsed {
      return emitFail(
        "emitProgram: discriminant string test but array type not collected",
      )
    }
    return emitStrEqLit(body, mkStr(lex, -1), fnIx, ec)
  }
  if code == FC_I32 {
    // The i32 slot serves both the interned string ATOM and a small numeric literal; the
    // quotes are what part them, exactly as they do in `emitLitMemberEq`.
    if nameIsQuotedLeaf(lex) {
      fbI32Rel(RS_ATOM, internAtom(lex))
    } else {
      fbI32Const(parseI32(lex))
    }
    fbI32Bin(70) // 0x46 i32.eq
    return 0
  }
  if code == FC_F64 {
    fbF64Const(lex)
    fbI32Bin(97) // 0x61 f64.eq
    return 0
  }
  if code == FC_I64 {
    const pr = parseI64Pair(lex)
    fbI64Const(pr[0], pr[1])
    fbI32Bin(81) // 0x51 i64.eq
    return 0
  }
  emitFail(
    "emitProgram: a discriminant field of this storage has no membership compare",
  )
}

// `r is B` over a single record `r: A` or `A | null` where every `B` is an `A` but not the
// reverse: the value fits when it is not null and each field `B` narrows holds a member of its
// literal set (D3885, D4058). 0 when the test is not that shape, so the caller's rungs go on.
function emitRecordFitIs(body: u8[], isIx: i32, fnIx: i32, ec: ExpCtx): i32 {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) { return 0 }
  if nd.isVariant == "null" || exprUnion(nd.isObj, fnIx) { return 0 }
  const recv = nd.isObj
  const objTy = nodeTyAt(recv, fnIx)
  const names: string[] = []
  const sets: i32[] = []
  const shape = recFitNarrowedFields(objTy, isVarTyIxOf(isIx), names, sets)
  if shape < 0 { return 0 }
  if shape == 0 {
    return emitFail(
      "emitProgram: `is` over a record tests a field that is not a literal set narrowed from the declared field, which has no lowering yet",
    )
  }
  // A receiver that is not a re-readable place (a call) is evaluated once into the `?.` stash.
  const staged = !unionEqOperandOk(recv)
  if staged && !fnUsesOptRecv {
    return emitFailAt("emitProgram: `is` receiver stash not reserved", recv)
  }
  let heap = -1
  const codes: i32[] = []
  const fis: i32[] = []
  const si = structIndexOfExpr(recv, fnIx)
  const vi = if si >= 0 { -1 } else { exprVariantIndex(recv, fnIx) }
  if si >= 0 && si < sHeapIdx.length {
    heap = sHeapIdx[si]
    for f in names {
      const fi = sFieldIndex(si, f)
      fis.push(fi)
      codes.push(if fi >= 0 { sFieldTypeAt(si, fi) } else { -1 })
    }
  } else if vi >= 0 && vi < uVarHeap.length {
    heap = uVarHeap[vi]
    for f in names {
      const fi = variantFieldIndex(vi, f)
      fis.push(fi)
      codes.push(if fi >= 0 { variantFieldTypeAt(vi, fi) } else { -1 })
    }
  }
  let laidOut = heap >= 0
  for fi in fis {
    if fi < 0 { laidOut = false }
  }
  if !laidOut {
    return emitFail("emitProgram: `is` over a record whose layout is not known")
  }
  const nullable = nodeTyIsNullable(recv)
  if nullable && !exprNullableRefNiche(recv, fnIx) {
    return emitFail(
      "emitProgram: `is` over a nullable record that is not a nullable reference",
    )
  }
  if staged {
    if emitExpr(body, recv, fnIx, ec) < 0 { return -1 }
    fbLocalSet(optRecvSlot)
  }
  if nullable {
    if emitRecordFitRecv(body, recv, fnIx, staged, -1, ec) < 0 { return -1 }
    fbRefIsNull()
    fbIf(127)
    fbI32Const(0)
    fbElse()
  }
  let k = 0
  while k < names.length {
    // A nullable string field answers its null apart, then compares only non-null strings.
    const nulStr = codes[k] == FC_NUL_STR
    const lexes = tyLitSetMemberLexes(
      if nulStr { nonNullTy(sets[k]) } else { sets[k] },
    )
    if nulStr {
      if emitRecordFitRecv(body, recv, fnIx, staged, heap, ec) < 0 { return -1 }
      if nullable && !staged { fbRefAsNonNull() }
      fbStructGet(heap, fis[k])
      fbRefIsNull()
      fbIf(127)
      fbI32Const(if nonNullTy(sets[k]) != sets[k] { 1 } else { 0 })
      fbElse()
      if lexes.length == 0 { fbI32Const(0) }
    }
    let li = 0
    while li < lexes.length {
      if emitRecordFitRecv(body, recv, fnIx, staged, heap, ec) < 0 { return -1 }
      if nullable && !staged { fbRefAsNonNull() }
      fbStructGet(heap, fis[k])
      if nulStr { fbRefAsNonNull() }
      if emitFieldLitEq(body, codes[k], lexes[li], fnIx, ec) < 0 { return -1 }
      if li > 0 {
        fbI32Bin(114) // i32.or
      }
      li = li + 1
    }
    if nulStr { fbEnd() }
    if k > 0 {
      fbI32Bin(113) // i32.and
    }
    k = k + 1
  }
  if nullable { fbEnd() }
  1
}

// `xs is L[]` over a list whose elements are a wider type than the literal set `L`: true when
// every element, at every nesting depth, is a member of `L`, so an empty list fits (D4771,
// extending D3885). 0 when the test is not that shape, 1 when emitted, -1 when refused.
function emitListFitIs(body: u8[], isIx: i32, fnIx: i32, ec: ExpCtx): i32 {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) { return 0 }
  if nd.isVariant == "null" || exprUnion(nd.isObj, fnIx) { return 0 }
  // A generic receiver tests its instance's type, or only its rep where the instance names no
  // type; a nullable one is false on null.
  const instTy = listIsRecvTyOf(nd.isObj, fnIx)
  const nullable = nodeTyIsNullable(nd.isObj)
  const recvTy = if nullable { nonNullTy(instTy) } else { instTy }
  const layers: i32[] = []
  const lit = listFitLitLeafOf(isVarTyIxOf(isIx), recvTy, layers)
  if lit < 0 { return 0 }
  const rep = exprListRep(nd.isObj, fnIx)
  if (
    recvTy < 0
    && rep != "list"
    && rep != "i64list"
    && rep != "strlist"
    && rep != "reflist"
  ) {
    return 0
  }
  const depth = layers.length - 1
  const slots: i32[] = []
  const scalar = listFitScalarOf(nd.isObj, rep, layers, slots, isIx, fnIx)
  if scalar == "" { return -1 }
  const scalarKind: MfKind = if scalar == "str" { "str" } else if scalar == "i64" { "i64" } else { "i32" }
  const scalarV: VKind = if scalar == "str" { "str" } else if scalar == "i64" { "i64" } else { "i32" }
  // How an element compares with a member of `L`: at its integer base, `i64w` for an `i32`
  // widened to `i64`, as a string, or as an atom.
  const numBase = numLitUnionBaseName(lit)
  const wide = tyIntLitWideTexts(lit)
  const numLexes = if wide.length > 0 { wide } else { tyNumLitMemberTexts(lit) }
  const lexes = if numLexes.length > 0 { numLexes } else { tyLitMemberTexts(lit) }
  const leaf = layers[depth]
  const leafBase = if leaf < 0 { "" } else if numLitUnionBaseName(leaf) != "" { numLitUnionBaseName(leaf) } else { tyPrimNameOf(leaf) }
  let leafKind = ""
  if numLexes.length > 0 {
    if leaf >= 0 && leafBase != scalar {
      leafKind = ""
    } else if scalar == "i64" {
      leafKind = "i64"
    } else if scalar == "i32" {
      leafKind = if numBase == "i32" { "i32" } else { "i64w" }
    }
  } else if scalar == "str" {
    if leaf < 0 || leafBase == "string" { leafKind = "str" }
  } else if scalar == "i32" {
    if leaf < 0 || tyLitMemberTexts(leaf).length > 0 { leafKind = "atom" }
  }
  if leafKind == "" || lexes.length == 0 {
    return emitFailAt(
      "emitProgram: `is` over a list tests its elements against a literal set this element type has no compare for",
      isIx,
    )
  }
  if emitExpr(body, nd.isObj, fnIx, ec) < 0 { return -1 }
  if (
    emitListFitLoop(
      body,
      slots,
      0,
      nullable,
      scalarKind,
      scalarV,
      leafKind,
      lexes,
      fnIx,
      ec,
    )
    < 0
  ) {
    return -1
  }
  1
}

// The innermost list's element rep — `i32`, `i64` or `str` — of list `recv` (rep `rep`) nested
// as deep as `layers` says, pushing each enclosing ref list's slot onto `slots`, outermost
// first; "" after a refusal at `isIx` when the rep does not nest that way or disagrees with a
// known type in `layers`.
function listFitScalarOf(
  recv: i32,
  rep: VKind | null,
  layers: i32[],
  slots: i32[],
  isIx: i32,
  fnIx: i32,
): string {
  const depth = layers.length - 1
  if depth == 1 {
    if rep == "list" { return "i32" }
    if rep == "i64list" { return "i64" }
    if rep == "strlist" { return "str" }
    emitFailAt(LIST_FIT_REP_MSG, isIx)
    return ""
  }
  if rep != "reflist" { return listFitRepMiss(isIx) }
  let s = refListSlotOfExpr(recv, fnIx)
  let k = 1
  while k < depth {
    if s < 0 || s >= rlElemKindTbl.length || s >= rlElemNullable.length {
      return listFitRepMiss(isIx)
    }
    if rlElemNullable[s] != 0 { return listFitRepMiss(isIx) }
    if layers[k] >= 0 && rlSlotOfTy(layers[k]) != s {
      return listFitRepMiss(isIx)
    }
    slots.push(s)
    const ek = rlElemKindTbl[s]
    if k < depth - 1 {
      if ek != RLK_REF_LIST { return listFitRepMiss(isIx) }
      s = rlElemInnerSlot(s)
    } else {
      if ek == RLK_I32_LIST { return "i32" }
      if ek == RLK_I64_LIST { return "i64" }
      if ek == RLK_STR_LIST { return "str" }
      return listFitRepMiss(isIx)
    }
    k = k + 1
  }
  listFitRepMiss(isIx)
}

const LIST_FIT_REP_MSG = "emitProgram: `is` over a list tests its elements, and this list's rep is not the one its type names"

// Refuses the fit test at `isIx` for a list rep it cannot walk, answering "".
function listFitRepMiss(isIx: i32): string {
  emitFailAt(LIST_FIT_REP_MSG, isIx)
  ""
}

// `xs is K[]` where, at some list depth, the elements of `xs` and of `K[]` can never meet: true
// exactly when every list at that depth is empty (D4910, by the D4771 ruling). A region the
// test narrows reads an empty `K[]` in place of `xs` (D4911). 0, leaving the static fold, when
// not that shape; 1 when emitted, -1 when refused.
function emitListEmptyFitIs(body: u8[], isIx: i32, fnIx: i32, ec: ExpCtx): i32 {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) { return 0 }
  if nd.isVariant == "null" { return 0 }
  const recvTy = listIsRecvTyOf(nd.isObj, fnIx)
  // An instance that left the receiver's type parameter unbound cannot hand a closure the arm's
  // list, since nothing says whether its elements meet `K`.
  const rv = nodeAt(unwrapParen(nd.isObj))
  if (
    (recvTy < 0 || tyHasTyVar(recvTy))
    && rv is Ident
    && liftedFnCaptures(rv.identName, fnIx)
  ) {
    return emitFailAt(LIST_FIT_SHADOW_MSG, isIx)
  }
  if exprUnion(nd.isObj, fnIx) || nodeTyIsNullable(nd.isObj) {
    return emitListEmptyFitArms(body, isIx, fnIx, recvTy, ec)
  }
  const depth = listDisjointDepth(recvTy, isVarTyIxOf(isIx))
  if depth < 1 { return 0 }
  let grow = -1
  if listNarrowReadDisjoint(fnIx, isIx, nd.isObj, recvTy) {
    const sh = listFitShadowSet(isIx, recvTy, depth, fnIx)
    if sh < 1 { return sh }
    if sh == 2 && rv is Ident {
      grow = listFitGrowRow(rv.identName, isVarTyIxOf(isIx), fnIx)
    }
  }
  const slots: i32[] = []
  let kind: MfKind = "i32"
  let slot = 0
  if exprRefArray(nd.isObj, fnIx) {
    let s = refListSlotOfExpr(nd.isObj, fnIx)
    let k = 1
    kind = "ref"
    while k < depth {
      if s < 0 || s >= rlElemKindTbl.length || rlElemNullable[s] != 0 {
        return emitFailAt(LIST_FIT_REP_MSG, isIx)
      }
      slots.push(s)
      const ek = rlElemKindTbl[s]
      if ek == RLK_REF_LIST { s = rlElemInnerSlot(s) }
      else if k == depth - 1 && ek == RLK_I32_LIST { kind = "i32" }
      else if k == depth - 1 && ek == RLK_STR_LIST { kind = "str" }
      else if k == depth - 1 && ek == RLK_F64_LIST { kind = "f64" }
      else if k == depth - 1 && ek == RLK_I64_LIST { kind = "i64" }
      else if k == depth - 1 && ek == RLK_F32_LIST { kind = "f32" }
      else if k == depth - 1 && ek == RLK_U8_LIST { kind = "u8" }
      else { return emitFailAt(LIST_FIT_REP_MSG, isIx) }
      k = k + 1
    }
    if kind == "ref" {
      if s < 0 || s >= rlWrapIdx.length {
        return emitFailAt(LIST_FIT_REP_MSG, isIx)
      }
      slot = s
    }
  } else if depth > 1 {
    return emitFailAt(LIST_FIT_REP_MSG, isIx)
  } else if exprStringArray(nd.isObj, fnIx) {
    kind = "str"
  } else {
    const lek = scalarListElemKind(nd.isObj, fnIx)
    if lek == null { return emitFailAt(LIST_FIT_REP_MSG, isIx) }
    kind = listIdxKindOf(lek)
  }
  // An arm that pushes tests only until its `K[]` is stored (`listFitGrowFill`).
  if grow >= 0 {
    fbLocalGet(fitGrowLocal[grow])
    fbRefIsNull()
    fbIf(127) // i32
  }
  if emitExpr(body, nd.isObj, fnIx, ec) < 0 { return -1 }
  emitListEmptyLoop(slots, 0, kind, slot)
  if grow >= 0 { return if listFitGrowFill(grow) < 0 { -1 } else { 1 } }
  1
}

// `is K[]` over a union or nullable receiver whose list arm `K[]` can never meet: true exactly
// when the receiver holds such an arm and that list is empty, so the arm's tag or non-null test
// guards the emptiness test (D4912). 0, leaving the static fold, when no arm is such a list.
function emitListEmptyFitArms(
  body: u8[],
  isIx: i32,
  fnIx: i32,
  recvTy: i32,
  ec: ExpCtx,
): i32 {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) { return 0 }
  const kTy = isVarTyIxOf(isIx)
  const boxed = exprUnion(nd.isObj, fnIx)
  // A box's arms are the ones it registered, which the receiver's type need not spell.
  const armTys: i32[] = []
  if boxed {
    const atoms: string[] = []
    const nm = unionNameOfExpr(nd.isObj, fnIx)
    if (
      nm == ""
      || !unionSetArmTysAB(
        92,
        nm,
        unionDeclTyIxOfIdentRead(nd.isObj, fnIx),
        atoms,
        armTys,
      )
    ) {
      return 0
    }
  } else {
    if recvTy < 0 { return 0 }
    flattenVariantsInto(recvTy, armTys)
  }
  const fits: i32[] = []
  let meets = false
  for a in armTys {
    if a >= 0 && a < T.tys.length && tyAt(a) is TyArray {
      if listDisjointDepth(a, kTy) == 1 { fits.push(a) } else { meets = true }
    }
  }
  // An arm whose elements can be `K`, or meet them below the first level, keeps its tag test.
  if fits.length == 0 || meets { return 0 }
  if !unionEqOperandOk(nd.isObj) { return emitFailNoMembershipRecv() }
  if !boxed && fits.length != 1 { return emitFailAt(LIST_FIT_REP_MSG, isIx) }
  for a in fits {
    if listNarrowReadDisjoint(fnIx, isIx, nd.isObj, a) {
      const sh = listFitShadowSet(isIx, a, 1, fnIx)
      if sh < 1 { return sh }
    }
  }
  let i = 0
  while i < fits.length {
    const at = tyAt(fits[i])
    if !(at is TyArray) { return emitFailAt(LIST_FIT_REP_MSG, isIx) }
    const heaps: i32[] = []
    const kind = listFitElemKind(at.aElem, heaps)
    if kind == null { return emitFailAt(LIST_FIT_REP_MSG, isIx) }
    if emitExpr(body, nd.isObj, fnIx, ec) < 0 { return -1 }
    if boxed {
      const tag = isArmTagOfTy(fits[i])
      if tag < 0 { return emitFailAt(LIST_FIT_REP_MSG, isIx) }
      fbStructGet(uBoxIdx, 0)
      fbI32Rel(RS_TAG, tag)
      fbI32Bin(70) // 0x46 i32.eq
    } else {
      fbRefIsNull()
      fbI32Eqz()
    }
    // <arm test> if (result i32) { <the arm's list is empty> } else { 0 }
    fbIf(127)
    if emitExpr(body, nd.isObj, fnIx, ec) < 0 { return -1 }
    if boxed {
      fbStructGet(uBoxIdx, 1)
      fbRefCast(heaps[2])
    } else {
      fbRefAsNonNull()
    }
    emitListEmptyLoop([], 0, kind, heaps[0])
    fbElse()
    fbI32Const(0)
    fbEnd()
    if i > 0 {
      fbI32Bin(114) // 0x72 i32.or
    }
    i = i + 1
  }
  1
}

// The frame kind of a list whose elements are `elemTy`, pushing its ref-list row (0 for a
// scalar list), backing and wrapper heap types onto `out`; null for an element with no list row.
function listFitElemKind(elemTy: i32, out: i32[]): MfKind | null {
  const en = tyPrimNameOf(elemTy)
  let kind: MfKind = "ref"
  if en == "string" { kind = "str" }
  else if en == "f64" { kind = "f64" }
  else if en == "i64" { kind = "i64" }
  else if en == "f32" { kind = "f32" }
  else if en == "u8" { kind = "u8" }
  else if en == "i32" || en == "boolean" { kind = "i32" }
  if kind == "ref" {
    const slot = rlSlotOfTy(elemTy)
    if slot < 0 || slot >= rlWrapIdx.length { return null }
    out.push(slot)
    out.push(rlBackIdx[slot])
    out.push(rlWrapIdx[slot])
    return kind
  }
  const vk: VKind = if kind == "u8" { "u8list" } else { kind }
  out.push(0)
  out.push(scalarListBack(vk))
  out.push(scalarListWrap(vk))
  kind
}

const LIST_FIT_PUSH_MSG = "emitProgram: this `is` arm pushes onto an empty list built with another element type, which cannot hold the pushed value"

const LIST_FIT_SHADOW_MSG = "emitProgram: this `is` arm reads an empty list at an element type it was not built with, and only a variable read directly in its own function can be handed one"

// Stores a fresh empty `K[]` for the `is K[]` at `isIx` in the local the arm reads in place of
// its receiver (`listFitShadowRead`), since the test fits only an empty list. 1 when stored, 2
// when a pushing arm's `listFitGrowRow` local is the test's to store, -1 when refused for a
// receiver no read can be redirected for.
function listFitShadowSet(isIx: i32, recvTy: i32, depth: i32, fnIx: i32): i32 {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) { return emitFailAt(LIST_FIT_SHADOW_MSG, isIx) }
  const r = nodeAt(unwrapParen(nd.isObj))
  if fnIx < 0 { return emitFailAt(LIST_FIT_SHADOW_MSG, isIx) }
  const fn = nodeAt(fnIx)
  if !(r is Ident) || !(fn is FuncDecl) || depth != 1 {
    return emitFailAt(LIST_FIT_SHADOW_MSG, isIx)
  }
  const kTy = isVarTyIxOf(isIx)
  if kTy < 0 || kTy >= T.tys.length {
    return emitFailAt(LIST_FIT_SHADOW_MSG, isIx)
  }
  const kt = tyAt(kTy)
  if !(kt is TyArray) { return emitFailAt(LIST_FIT_SHADOW_MSG, isIx) }
  const heaps: i32[] = []
  const kind = listFitElemKind(kt.aElem, heaps)
  if kind == null { return emitFailAt(LIST_FIT_SHADOW_MSG, isIx) }
  // A closure's read stands in with its own empty `K[]` (`listFitCaptureStandIn`), except
  // between two record lists, which that read cannot tell apart.
  const rt = if recvTy >= 0 && recvTy < T.tys.length { tyAt(recvTy) } else { kt }
  const recvHeaps: i32[] = []
  const recvKind = if rt is TyArray { listFitElemKind(rt.aElem, recvHeaps) } else { null }
  if (
    kind == "ref"
    && (recvKind == null || recvKind == "ref")
    && (nestedFnReadsDisjoint(fn.fnBody, r.identName, recvTy, false)
      || liftedFnReadsDisjoint(r.identName, recvTy, fnIx))
  ) {
    return emitFailAt(LIST_FIT_SHADOW_MSG, isIx)
  }
  const slot = heaps[0]
  const back = heaps[1]
  const wrap = heaps[2]
  const recvLoc = localIndexOf(fnIx, r.identName)
  if recvLoc < 0 { return emitFailAt(LIST_FIT_SHADOW_MSG, isIx) }
  const grow = listFitGrowRow(r.identName, kTy, fnIx)
  let loc = -1
  let i = 0
  while i < fitShName.length {
    if (
      fitShName[i] == r.identName
      && tySame(fitShTy[i], kTy)
      && fitShRecv[i] == recvLoc
    ) {
      loc = fitShLocal[i]
    }
    i = i + 1
  }
  if loc < 0 {
    loc = if grow >= 0 { fitGrowLocal[grow] } else { listFitSlot(kind, slot, 11) }
    fitShName.push(r.identName)
    fitShTy.push(kTy)
    fitShLocal.push(loc)
    fitShRecv.push(recvLoc)
    fitShSlot.push(if kind == "ref" { slot } else { -1 })
  }
  if grow >= 0 { return 2 }
  fbBacking(back, 0)
  arrLitWrap(0, wrap)
  fbLocalSet(loc)
  1
}

// The local `listFitShadowSet` stored for a read of `name` at node `exprIx` typed as that
// local's list and resolving to the same binding, or -1 to read the binding itself.
function listFitShadowRead(name: string, exprIx: i32, fnIx: i32): i32 {
  const row = listFitShadowRow(name, exprIx, fnIx)
  if row < 0 { return -1 }
  fitShLocal[row]
}

// Whether the list at `recv` reads an `is K[]` arm's empty `K[]` whose elements are refs, which no
// push in the arm grows.
function listFitShadowIsRef(recv: i32, fnIx: i32): boolean {
  const r = nodeAt(unwrapParen(recv))
  if !(r is Ident) { return false }
  const row = listFitShadowRow(r.identName, unwrapParen(recv), fnIx)
  row >= 0 && fitShSlot[row] >= 0 && !listFitGrowHolds(fitShLocal[row])
}

// The `fitGrow*` row of an `is K[]` arm in `fnIx` that pushes onto receiver `name` (any `K[]`
// when `kTy` is -1), or -1 (D4934). Its local holds `K[]` from the first test that fits on, so
// that list is the receiver's place: a later test fits it and a `.length` reads it.
function listFitGrowRow(name: string, kTy: i32, fnIx: i32): i32 {
  if !strListHas(listIsIdentNames, name) { return -1 }
  if fitGrowFn != fnIx { listFitGrowScan(fnIx) }
  let i = 0
  while i < fitGrowName.length {
    if fitGrowName[i] == name && (kTy < 0 || tySame(fitGrowTy[i], kTy)) {
      return i
    }
    i = i + 1
  }
  -1
}

// Fills the `fitGrow*` rows for `fnIx`: each `is K[]` over a local list whose elements can never
// be `K`, whose arm pushes onto the receiver, and where every other use of the receiver is one
// `listFitGrowUsesOk` admits. Any other use would read the receiver's own list, which the
// pushed `K[]` has replaced, so such an arm keeps `LIST_FIT_PUSH_MSG`.
function listFitGrowScan(fnIx: i32) {
  fitGrowFn = fnIx
  fitGrowName = []
  fitGrowTy = []
  fitGrowLocal = []
  if fnIx < 0 { return 0 }
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return 0 }
  const isIxs: i32[] = []
  const pushNames: string[] = []
  const pushTys: i32[] = []
  listFitGrowWalk(fn.fnBody, isIxs, pushNames, pushTys)
  for isIx in isIxs {
    const nd = nodeAt(isIx)
    const kTy = isVarTyIxOf(isIx)
    if nd is IsExpr && kTy >= 0 && kTy < T.tys.length {
      const r = nodeAt(unwrapParen(nd.isObj))
      const kt = tyAt(kTy)
      if (
        r is Ident
        && kt is TyArray
        && listFitGrowEligible(nd, r.identName, kTy, fnIx)
      ) {
        let pushed = false
        let p = 0
        while p < pushNames.length {
          if pushNames[p] == r.identName && tySame(pushTys[p], kTy) {
            pushed = true
          }
          p = p + 1
        }
        const heaps: i32[] = []
        const kind = listFitElemKind(kt.aElem, heaps)
        if (
          pushed
          && kind != null
          && listFitGrowUsesOk(fn.fnBody, -1, r.identName, kTy, false, fnIx)
        ) {
          fitGrowName.push(r.identName)
          fitGrowTy.push(kTy)
          fitGrowLocal.push(listFitSlot(kind, heaps[0], 11))
        }
      }
    }
  }
  0
}

// Whether the `is K[]` `nd` over local `name` takes the shadow `listFitShadowSet` stores: no row
// yet, a receiver that is neither a union nor nullable, and elements disjoint at the first depth.
function listFitGrowEligible(
  nd: IsExpr,
  name: string,
  kTy: i32,
  fnIx: i32,
): boolean {
  let i = 0
  while i < fitGrowName.length {
    if fitGrowName[i] == name && tySame(fitGrowTy[i], kTy) { return false }
    i = i + 1
  }
  if localIndexOf(fnIx, name) < 0 { return false }
  if exprUnion(nd.isObj, fnIx) || nodeTyIsNullable(nd.isObj) { return false }
  const recvTy = listIsRecvTyOf(nd.isObj, fnIx)
  recvTy >= 0 && listDisjointDepth(recvTy, kTy) == 1
}

// Collects, under `ix` and outside nested functions, each `is` testing a list type on a named
// variable, and each `.push` onto a named variable with the type its receiver is read at.
function listFitGrowWalk(
  ix: i32,
  isIxs: i32[],
  pushNames: string[],
  pushTys: i32[],
) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is FuncDecl { return 0 }
  if n is IsExpr {
    const r = nodeAt(unwrapParen(n.isObj))
    if r is Ident && strListHas(listIsIdentNames, r.identName) {
      isIxs.push(ix)
    }
  } else if n is Call {
    if n.callFn < 0 { return 0 }
    const cf = nodeAt(n.callFn)
    if cf is Member && cf.memProp == "push" {
      const o = nodeAt(cf.memObj)
      if o is Ident {
        pushNames.push(o.identName)
        pushTys.push(nodeTyIxOf(cf.memObj))
      }
    }
  }
  for k in nodeChildren(ix) { listFitGrowWalk(k, isIxs, pushNames, pushTys) }
  0
}

// Whether every use of `name` under `ix` (child of `par`) is one the arm's `K[]` stands in for:
// a read typed `K[]`, the operand of another `is K[]`, or the receiver of a `.length`, none of
// them in a nested function, which would read its own capture of the receiver.
function listFitGrowUsesOk(
  ix: i32,
  par: i32,
  name: string,
  kTy: i32,
  inner: boolean,
  fnIx: i32,
): boolean {
  if ix < 0 || ix >= P.nodes.length { return true }
  const n = nodeAt(ix)
  if n is FuncDecl {
    return listFitGrowUsesOk(n.fnBody, ix, name, kTy, true, fnIx)
  }
  if n is Ident && n.identName == name {
    if inner { return false }
    const t = nodeTyAt(ix, fnIx)
    if t >= 0 && tySame(t, kTy) { return true }
    if par < 0 { return false }
    const p = nodeAt(par)
    if p is IsExpr && p.isObj == ix {
      const pk = isVarTyIxOf(par)
      return pk >= 0 && tySame(pk, kTy)
    }
    return p is Member && p.memObj == ix && p.memProp == "length"
  }
  for k in nodeChildren(ix) {
    if !listFitGrowUsesOk(k, ix, name, kTy, inner, fnIx) { return false }
  }
  true
}

// Whether `loc` is the local of a `fitGrow*` row, which a push may append to.
function listFitGrowHolds(loc: i32): boolean {
  for l in fitGrowLocal {
    if l == loc { return true }
  }
  false
}

// With the test's answer on the stack inside the `if` `emitListEmptyFitIs` opened on a null
// `fitGrowLocal[row]`, stores a fresh `K[]` there when it fits; a set local answers 1 untested.
function listFitGrowFill(row: i32): i32 {
  const kt = tyAt(fitGrowTy[row])
  if !(kt is TyArray) { return emitFail(LIST_FIT_SHADOW_MSG) }
  const heaps: i32[] = []
  if listFitElemKind(kt.aElem, heaps) == null {
    return emitFail(LIST_FIT_SHADOW_MSG)
  }
  fbIf(127) // i32
  fbBacking(heaps[1], 0)
  arrLitWrap(0, heaps[2])
  if row < 0 { return -1 }
  fbLocalSet(fitGrowLocal[row])
  fbI32Const(1)
  fbElse()
  fbI32Const(0)
  fbEnd()
  fbElse()
  fbI32Const(1)
  fbEnd()
  0
}

// `name.length` outside the arm of an `is K[]` that pushes onto `name`: the `K[]` once a test
// has fitted, the receiver's own list before. 0 when `m` is not such a read, 1 when emitted.
function emitListFitGrowLen(
  body: u8[],
  m: Member,
  memIx: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  const o = nodeAt(m.memObj)
  if !(o is Ident) { return 0 }
  if listFitShadowRead(o.identName, m.memObj, fnIx) >= 0 { return 0 }
  const g = listFitGrowRow(o.identName, -1, fnIx)
  if g < 0 { return 0 }
  const kt = tyAt(fitGrowTy[g])
  if !(kt is TyArray) { return 0 }
  const heaps: i32[] = []
  const kind = listFitElemKind(kt.aElem, heaps)
  if kind == null { return 0 }
  fbLocalGet(fitGrowLocal[g])
  fbRefIsNull()
  fbIf(127) // i32
  if emitArrLen(body, memIx, fnIx, ec) < 0 { return -1 }
  fbElse()
  fbLocalGet(fitGrowLocal[g])
  fbRefAsNonNull()
  emitListLenOnStack(kind, heaps[0])
  fbEnd()
  1
}

// The wrapper of the empty `K[]` a closure's read of capture `name` at `exprIx` stands in with,
// or -1 (D4935): only an `is K[]` fitting an empty list of other elements types it so. A read
// typed at a type parameter's list takes the enclosing region's `K[]` when `anyPos` or when it
// is delivered whole. Two record lists are not told apart, since rows of one shape alias.
function listFitCaptureStandIn(
  name: string,
  exprIx: i32,
  fnIx: i32,
  anyPos: boolean,
): i32 {
  if !strListHas(listIsIdentNames, name) || !identIsEnvCapture(fnIx, name) {
    return -1
  }
  if narListReadsDecl(exprIx) { return -1 }
  const heaps: i32[] = []
  let kind = listFitStandInKind(nodeTyIxOf(exprIx), heaps)
  if kind == null && (anyPos || listFitReadIsWhole(fnIx, exprIx)) {
    kind = listFitStandInKind(listFitRegionKTy(fnIx, name), heaps)
  }
  if kind == null { return -1 }
  const ck = capturedKindOf(fnIx, name)
  if ck == null { return -1 }
  if ck == "reflist" { return if kind == "ref" { -1 } else { heaps[2] } }
  if ck == "strlist" {
    return if heaps[2] == mkListIdx { -1 } else { heaps[2] }
  }
  const se = scalarListElemOfListKind(ck)
  if se == null || scalarListWrap(se) == heaps[2] { return -1 }
  heaps[2]
}

// The scalar element of the stand-in list wrapper `w`, or null for any other list.
function listFitStoodKind(w: i32): VKind | null {
  if w == lTypeIdx { return "i32" }
  if w == fl64TypeIdx { return "f64" }
  if w == il64TypeIdx { return "i64" }
  if w == fl32TypeIdx { return "f32" }
  null
}

// `listFitElemKind` of list type `t`'s elements, or null when `t` is not a list of a kind
// the stand-in builds, a type parameter's elements among them.
function listFitStandInKind(t: i32, heaps: i32[]): MfKind | null {
  if t < 0 || t >= T.tys.length { return null }
  const kt = tyAt(t)
  if !(kt is TyArray) { return null }
  listFitElemKind(kt.aElem, heaps)
}

// The `K[]` an `if <name> is K[]` of an enclosing function tests when the closure at `fnIx` is
// declared in that test's then-branch, or -1: a closure inside a generic body reads its capture at
// the type parameter's list, and only the region says which list the test fitted.
function listFitRegionKTy(fnIx: i32, name: string): i32 {
  let host = fnStmtsPosOf(fnIx)
  if host < 0 { return -1 }
  const self = fnStmts[host]
  while host >= 0 && host < fnParent.length {
    host = fnParent[host]
    if host < 0 || host >= fnStmts.length { return -1 }
    const h = nodeAt(fnStmts[host])
    if h is FuncDecl {
      const k = listFitRegionWalk(h.fnBody, name, self)
      if k >= 0 { return k }
    }
  }
  -1
}

// `listFitRegionKTy`'s walk of one function body.
function listFitRegionWalk(ix: i32, name: string, self: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = nodeAt(ix)
  if n is IfStmt {
    const ci = unwrapParen(n.ifCond)
    const c = if ci < 0 { n } else { nodeAt(ci) }
    if c is IsExpr && nodeContains(n.ifThen, self) {
      const r = nodeAt(unwrapParen(c.isObj))
      if r is Ident && r.identName == name { return isVarTyIxOf(ci) }
    }
  }
  for k in nodeChildren(ix) {
    const t = listFitRegionWalk(k, name, self)
    if t >= 0 { return t }
  }
  -1
}

// Whether the read at `exprIx` in function `fnIx` is delivered whole: not the object of a
// member, an index or a `for`, which read the list in place.
function listFitReadIsWhole(fnIx: i32, exprIx: i32): boolean {
  const fe = fnStmtsPosOf(fnIx)
  if fe < 0 { return false }
  const f = nodeAt(fnStmts[fe])
  if !(f is FuncDecl) { return false }
  let at = exprIx
  let par = nodeParentUnder(f.fnBody, at)
  while par >= 0 && nodeAt(par) is Paren {
    at = par
    par = nodeParentUnder(f.fnBody, at)
  }
  if par < 0 { return false }
  // Each of the four holds the list it reads in place as its first child.
  const p = nodeAt(par)
  const inPlace = p is Member || p is OptMember || p is Index || p is ForIn
  if !inPlace { return true }
  const kids = nodeChildren(par)
  kids.length == 0 || kids[0] != at
}

// The node in the subtree at `ix` with `target` as a child, or -1.
function nodeParentUnder(ix: i32, target: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  for k in nodeChildren(ix) {
    if k == target { return ix }
    const r = nodeParentUnder(k, target)
    if r >= 0 { return r }
  }
  -1
}

// Whether lifted slot `fe` captures `name` and is declared inside the function at `fnIx` (any
// lifted slot, where `fnIx` is not a function): a same-named capture elsewhere is another binding.
function liftedFnCapturesIn(fe: i32, name: string, fnIx: i32): boolean {
  if !strListHas(captureNamesOf(fe), name) { return false }
  if fnIx < 0 { return true }
  const host = nodeAt(fnIx)
  !(host is FuncDecl) || nodeContains(host.fnBody, fnStmts[fe])
}

// Whether some lifted closure inside the function at `fnIx` captures `name`.
function liftedFnCaptures(name: string, fnIx: i32): boolean {
  let k = 0
  while k < cloLiftedFes.length {
    if liftedFnCapturesIn(cloLiftedFes[k], name, fnIx) { return true }
    k = k + 1
  }
  false
}

// Whether a lifted closure inside the function at `fnIx` capturing `name` reads it at a type
// list-disjoint from `instTy`: the lifted body sits outside its frame's, so
// `nestedFnReadsDisjoint` cannot see it.
function liftedFnReadsDisjoint(name: string, instTy: i32, fnIx: i32): boolean {
  let k = 0
  while k < cloLiftedFes.length {
    const fe = cloLiftedFes[k]
    if liftedFnCapturesIn(fe, name, fnIx) {
      const f = nodeAt(fnStmts[fe])
      if f is FuncDecl && nestedFnReadsDisjoint(f.fnBody, name, instTy, true) {
        return true
      }
    }
    k = k + 1
  }
  false
}

// Whether a function nested under `ix` reads `name` at a type list-disjoint from `instTy`; such
// a read is a capture, which the arm's local cannot reach.
function nestedFnReadsDisjoint(
  ix: i32,
  name: string,
  instTy: i32,
  inner: boolean,
): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if n is FuncDecl {
    return nestedFnReadsDisjoint(n.fnBody, name, instTy, true)
  }
  if inner && n is Ident && n.identName == name {
    const t = nodeTyIxOf(ix)
    if t >= 0 && listDisjointDepth(instTy, t) >= 1 { return true }
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if nestedFnReadsDisjoint(kids[i], name, instTy, inner) { return true }
    i = i + 1
  }
  false
}

// Whether function `fnIx` may read the receiver `recv` of the `is` at `isIx` as the narrowed
// type, which the instance's value cannot carry, so the read needs an empty `K[]` in its place
// (D4911): a read typed disjoint from `instTy`, or any read in a region the `is` narrows. A field
// receiver counts every read of a field of the same name.
function listNarrowReadDisjoint(
  fnIx: i32,
  isIx: i32,
  recv: i32,
  instTy: i32,
): boolean {
  // The start function (`fnIx` -1) scans the whole program, its functions' bodies included.
  let body = emitRootIx
  if fnIx >= 0 {
    const fn = nodeAt(fnIx)
    if !(fn is FuncDecl) { return true }
    body = fn.fnBody
  }
  if body < 0 { return true }
  const r = nodeAt(unwrapParen(recv))
  if r is Member {
    return narrowReadsName(body, isIx, r.memProp, true, instTy, fnIx)
  }
  if r is Ident {
    return narrowReadsName(body, isIx, r.identName, false, instTy, fnIx)
  }
  // Flow narrows only an identifier or a field; any other receiver names nothing, so no read matches.
  narrowReadsName(body, isIx, "", false, instTy, fnIx)
}

function narrowReadsName(
  body: i32,
  isIx: i32,
  name: string,
  field: boolean,
  instTy: i32,
  fnIx: i32,
): boolean {
  if name == "" { return false }
  narrowReadDisjointUnder(body, name, field, instTy, fnIx)
    || narrowRegionReads(body, isIx, name, field) == 2
}

function narrowReadDisjointUnder(
  ix: i32,
  name: string,
  field: boolean,
  instTy: i32,
  fnIx: i32,
): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  const hit = if field { n is Member && n.memProp == name } else { n is Ident && n.identName == name }
  if hit {
    const t = nodeTyAt(ix, fnIx)
    if t >= 0 && listDisjointDepth(instTy, t) >= 1 { return true }
  }
  const kids = nodeChildren(ix)
  if n is Block && !field {
    let j = 0
    while j < kids.length {
      if kids[j] >= 0 {
        const s = nodeAt(kids[j])
        if s is LetDecl && s.letName == name { return false }
      }
      j = j + 1
    }
  }
  let i = 0
  while i < kids.length {
    if narrowReadDisjointUnder(kids[i], name, field, instTy, fnIx) {
      return true
    }
    i = i + 1
  }
  false
}

// Whether every list at nesting `at` and below of the list on the stack is empty, leaving 1 or
// 0: `slots[at]`'s ref list is walked while `at` is inside `slots`, and the innermost list, of
// frame kind `kind` (ref-list row `slot` for a ref list), answers by its length.
function emitListEmptyLoop(slots: i32[], at: i32, kind: MfKind, slot: i32) {
  if at >= slots.length {
    emitListLenOnStack(kind, slot)
    fbI32Eqz()
    return 0
  }
  const s = slots[at]
  const wL = listFitSlot("ref", s, 11)
  const bL = listFitSlot("ref", s, 3)
  const nL = listFitSlot("i32", 0, 4)
  const iL = listFitSlot("i32", 0, 4)
  fbLocalSet(wL)
  fbLocalGet(wL)
  fbStructGet(rlWrapIdx[s], 0)
  fbLocalSet(bL)
  fbLocalGet(wL)
  fbStructGet(rlWrapIdx[s], 1)
  fbLocalSet(nL)
  fbI32Const(0)
  fbLocalSet(iL)
  // block (result i32) { loop { 1 if i >= n; 0 unless list i is empty; i += 1 } }
  fbBlock(127)
  fbLoop(64)
  fbI32Const(1)
  fbLocalGet(iL)
  fbLocalGet(nL)
  fbI32Bin(78) // 0x4e i32.ge_s
  fbBrIf(1)
  fbDrop()
  fbI32Const(0)
  fbLocalGet(bL)
  fbLocalGet(iL)
  fbArrayGet(rlBackIdx[s])
  emitListEmptyLoop(slots, at + 1, kind, slot)
  fbI32Eqz()
  fbBrIf(1)
  fbDrop()
  fbLocalGet(iL)
  fbI32Const(1)
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(iL)
  fbBr(0)
  fbEnd()
  fbUnreachable()
  fbEnd()
  0
}

// Replace the list on the stack, of frame kind `kind` (ref-list row `slot` for a ref list), by
// its length, reading a view's length through its helper as `.length` does.
function emitListLenOnStack(kind: MfKind, slot: i32) {
  if kind == "ref" {
    if rvMayView(slot) {
      const rwL = listFitSlot("ref", slot, 11)
      fbLocalSet(rwL)
      rvTestView(rwL)
      fbIf(127) // i32
      fbLocalGet(rwL)
      fbCall(gHelpRvLen)
      fbElse()
      fbLocalGet(rwL)
      fbStructGet(rlWrapIdx[slot], 1)
      fbEnd()
      return 0
    }
    fbStructGet(rlWrapIdx[slot], 1)
    return 0
  }
  if kind == "str" {
    fbStructGet(mkListIdx, 1)
    return 0
  }
  if kind == "i32" {
    fbStructGet(lTypeIdx, 1)
    return 0
  }
  const lek: VKind = if kind == "f64" { "f64" } else if kind == "i64" { "i64" } else if kind == "f32" { "f32" } else { "u8list" }
  const sv = svDstOfKind(lek)
  if sv >= 0 {
    const lwL = listFitSlot(kind, 0, 11)
    fbLocalSet(lwL)
    svTestView(lwL, sv)
    fbIf(127) // i32
    fbLocalGet(lwL)
    fbCall(gHelpSvLen[sv])
    fbElse()
    fbLocalGet(lwL)
    fbStructGet(scalarListWrap(lek), 1)
    fbEnd()
    return 0
  }
  fbStructGet(scalarListWrap(lek), 1)
  0
}

// The fit loop over the list on the stack at nesting `at`: `slots[at]`'s ref list while `at`
// is inside `slots`, else the `scalarKind` list. Leaves 1 when every element fits, else 0.
// A `nullable` list leaves 0 when it is null.
function emitListFitLoop(
  body: u8[],
  slots: i32[],
  at: i32,
  nullable: boolean,
  scalarKind: MfKind,
  scalarV: VKind,
  leafKind: string,
  lexes: string[],
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  const inner = at < slots.length
  const kind: MfKind = if inner { "ref" } else { scalarKind }
  const slot = if inner { slots[at] } else { 0 }
  const wrapTy = if inner { rlWrapIdx[slot] } else { scalarListWrap(scalarV) }
  const backTy = if inner { rlBackIdx[slot] } else { scalarListBack(scalarV) }
  const wL = listFitSlot(kind, slot, 11)
  const bL = listFitSlot(kind, slot, 3)
  const nL = listFitSlot("i32", 0, 4)
  const iL = listFitSlot("i32", 0, 4)
  fbLocalSet(wL)
  if nullable {
    fbLocalGet(wL)
    fbRefIsNull()
    fbIf(127)
    fbI32Const(0)
    fbElse()
  }
  fbLocalGet(wL)
  fbStructGet(wrapTy, 0)
  fbLocalSet(bL)
  fbLocalGet(wL)
  fbStructGet(wrapTy, 1)
  fbLocalSet(nL)
  fbI32Const(0)
  fbLocalSet(iL)
  // block (result i32) { loop { 1 if i >= n; 0 unless element i fits; i += 1 } }
  fbBlock(127)
  fbLoop(64)
  fbI32Const(1)
  fbLocalGet(iL)
  fbLocalGet(nL)
  fbI32Bin(78) // 0x4e i32.ge_s
  fbBrIf(1)
  fbDrop()
  fbI32Const(0)
  fbLocalGet(bL)
  fbLocalGet(iL)
  fbArrayGet(backTy)
  if inner {
    if (
      emitListFitLoop(
        body,
        slots,
        at + 1,
        false,
        scalarKind,
        scalarV,
        leafKind,
        lexes,
        fnIx,
        ec,
      )
      < 0
    ) {
      return -1
    }
  } else if emitListFitElem(body, scalarKind, leafKind, lexes, fnIx, ec) < 0 {
    return -1
  }
  fbI32Eqz()
  fbBrIf(1)
  fbDrop()
  fbLocalGet(iL)
  fbI32Const(1)
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(iL)
  fbBr(0)
  fbEnd()
  fbUnreachable()
  fbEnd()
  if nullable { fbEnd() }
  0
}

// Whether the scalar element on the stack is a member of `lexes` (for `nonnull`, once per
// entry, whether it is not null), leaving 0/1.
function emitListFitElem(
  body: u8[],
  scalarKind: MfKind,
  leafKind: string,
  lexes: string[],
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  const eL = listFitSlot(scalarKind, 0, 2)
  fbLocalSet(eL)
  let i = 0
  while i < lexes.length {
    fbLocalGet(eL)
    if leafKind == "nonnull" {
      fbRefIsNull()
      fbI32Eqz()
    } else if leafKind == "str" {
      fbRefAsNonNull()
      if emitStrEqLit(body, mkStr(quoteLex(lexes[i]), -1), fnIx, ec) < 0 {
        return -1
      }
    } else if leafKind == "atom" {
      fbI32Rel(RS_ATOM, internAtom(quoteLex(lexes[i])))
      fbI32Bin(70) // 0x46 i32.eq
    } else if leafKind == "i64w" {
      fbI64ExtendI32S()
      emitNumLitConstEq("i64", lexes[i])
    } else {
      emitNumLitConstEq(leafKind, lexes[i])
    }
    if i > 0 {
      fbI32Bin(114) // 0x72 i32.or
    }
    i = i + 1
  }
  0
}

// A fresh lazy-frame slot of `liBack` code `code` for frame kind `kind` (ref-list row `slot`):
// never shared, so a nested fit loop keeps its own.
function listFitSlot(kind: MfKind, slot: i32, code: i32): i32 {
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(code)
  listIdxScratchBase + liKinds.length
}

// One read of the record-fit receiver: the stash cast back to `heap` (left uncast when `heap`
// is -1, for the null test) when `staged`, else the receiver expression itself.
function emitRecordFitRecv(
  body: u8[],
  recv: i32,
  fnIx: i32,
  staged: boolean,
  heap: i32,
  ec: ExpCtx,
): i32 {
  if !staged { return emitExpr(body, recv, fnIx, ec) }
  fbLocalGet(optRecvSlot)
  if heap >= 0 { fbRefCast(heap) }
  0
}

// The outer union's tag for each arm of `tty`, in flatten order, with the arm's variant row
// beside it (-1 for a value atom). A union alias member is a SUBSET of the outer box's tags
// and never a nested box, so every membership test over one is this list `i32.or`ed together.
// False when an arm has no tag at all — the caller names its own refusal (D1774).
function unionArmTagsOfTy(tty: i32, tags: i32[], vis: i32[]): boolean {
  const armTys: i32[] = []
  flattenVariantsInto(tty, armTys)
  if armTys.length == 0 { return false }
  let at = 0
  while at < armTys.length {
    const aty = armTys[at]
    let t1 = isArmTagOfTy(aty)
    // a struct arm is a variant: its box tag is `uTags[vi]`, the rank assigned at
    // construction, not an `isArmTagOfTy` value-atom kind.
    let vi = -1
    if t1 < 0 {
      let armNm = nominalStructNameOfTy(aty)
      // An inline record arm has no nominal name; its row is the one every union stores it in.
      if armNm == "" { armNm = armRowNameOfRecord(aty) }
      if armNm != "" { vi = variantIndexOf(armNm) }
      if vi >= 0 { t1 = uTags[vi] }
    }
    if t1 < 0 { return false }
    tags.push(t1)
    vis.push(vi)
    at = at + 1
  }
  true
}

// The membership half of `x is A` (D1023) — emitted after the arm's tag test and `i32.and`ed
// onto it, for each field the tag alone cannot settle. `A`'s tag names the shape; where two
// declared types share a shape, the ruling makes `is` a question about the value. It emits
// nothing when no field needs it (`variantDiscrimFieldNeeded`).

// The receiver is re-read once per member, so `unionEqOperandOk` is the place test and a
// non-place receiver keeps the loud refusal. The tag test is consumed into an `if` rather than
// `i32.and`ed, because `i32.and` evaluates both operands: the discriminant read casts to this
// arm and would run on every other arm's values too, trapping once a third arm differs.
function emitVariantDiscrimTest(
  body: u8[],
  recvIx: i32,
  vi: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if vi < 0 || vi >= uFieldCount.length { return 0 }
  const cnt = uFieldCount[vi]
  let need = false
  let fp = 0
  while fp < cnt {
    if variantDiscrimFieldNeeded(vi, fp) { need = true }
    fp = fp + 1
  }
  if !need { return 0 }
  if !unionEqOperandOk(recvIx) { return emitFailNoMembershipRecv() }
  // <tag test> if (result i32) { <membership> } else { 0 }
  fbIf(127) // 0x04 if, i32 result
  let first = true
  let fi = 0
  while fi < cnt {
    if variantDiscrimFieldNeeded(vi, fi) {
      const lexes = variantFieldLitLexes(vi, fi)
      if lexes.length == 0 {
        return emitFail(
          "emitProgram: a discriminant field with no literal members",
        )
      }
      let li = 0
      while li < lexes.length {
        if emitDiscrimFieldEq(body, recvIx, vi, fi, lexes[li], fnIx, ec) < 0 {
          return -1
        }
        if li > 0 {
          fbI32Bin(114) // 0x72 i32.or — membership across the set
        }
        li = li + 1
      }
      // Every literal field of the tested type must hold: `is A` is membership in ALL of
      // `A`'s literal sets, not in one of them.
      if !first {
        fbI32Bin(113) // 0x71 i32.and
      }
      first = false
    }
    fi = fi + 1
  }
  fbElse()
  fbI32Const(0)
  fbEnd()
  0
}

// The member of the union `recvIx` holds that a tested map `patTy` names up to the order of its
// value union's members or a nested Set's spelling, so the test reads that member's tag; `patTy`
// itself when the union has it exactly, has no such member, or `patTy` is not a map (D2733).
function isPatUnionArmTy(recvIx: i32, patTy: i32, fnIx: i32): i32 {
  if patTy < 0 || !unMemIsMap(patTy) { return patTy }
  const nm = unionNameOfExpr(recvIx, fnIx)
  if nm == "" { return patTy }
  const atoms: string[] = []
  const arms: i32[] = []
  unionSetArmTysAB(93, nm, unionDeclTyIxOfIdentRead(recvIx, fnIx), atoms, arms)
  let same = -1
  let i = 0
  while i < arms.length {
    const a = arms[i]
    if a >= 0 && unMemIsMap(a) {
      if mapTwinSame(a, patTy) { return patTy }
      if same < 0 && tySameSet(a, patTy, TY_WALK_DEPTH) { same = a }
      if same < 0 && tySameSpelled(a, patTy, TY_WALK_DEPTH) { same = a }
    }
    i = i + 1
  }
  if same >= 0 { return same }
  patTy
}

// A box test naming a map with a numeric literal-union value, or its base twin, where the box
// cannot say which it holds: the receiver's union has two members of that one member class, or
// the instance is pinned at the other (D2493). Refused at `at`; -1 when refused, else 0.
function mapSoftTwinTagFail(recvIx: i32, patTy: i32, fnIx: i32, at: i32): i32 {
  if patTy < 0 { return 0 }
  const pat: i32[] = []
  flattenVariantsInto(patTy, pat)
  const arms: i32[] = []
  const nm = unionNameOfExpr(recvIx, fnIx)
  if nm != "" {
    const atoms: string[] = []
    unionSetArmTysAB(
      94,
      nm,
      unionDeclTyIxOfIdentRead(recvIx, fnIx),
      atoms,
      arms,
    )
  }
  const pins: i32[] = []
  instancePinnedMaps(fnIx, pins)
  let i = 0
  while i < pat.length {
    const pm = pat[i]
    if unMemIsMap(pm) {
      let inClass = 0
      let soft = false
      let j = 0
      while j < arms.length {
        if unMemIsMap(arms[j]) && mapTwinSame(arms[j], pm) {
          inClass = inClass + 1
          if !mapTwinExact(arms[j], pm) { soft = true }
        }
        j = j + 1
      }
      let q = 0
      while q < pins.length {
        if pins[q] >= 0 && mapSoftTwin(pins[q], pm) {
          soft = true
          inClass = 2
        }
        q = q + 1
      }
      if soft && inClass > 1 {
        return emitFailAt(
          "emitProgram: a test cannot tell "
            + tyToEmitName(pm)
            + " from the map its numeric literal union reads as yet — wrap each map in a record with a discriminant field",
          at,
        )
      }
    }
    i = i + 1
  }
  0
}

// Lower a type guard `recv is X`: a narrowed operand's narrowing is lifted for the test, an
// un-narrowed frame local typed as exactly `X` is a tautology, and `emitIsTest` does the rest.
function emitIs(body: u8[], isIx: i32, fnIx: i32, ec: ExpCtx) {
  const nd0 = nodeAt(isIx)
  if nd0 is IsExpr {
    // A narrowed operand is tested at its storage, never trusted: the narrowing is lifted
    // for the test, so the read is the declared box and the rungs below test its tag. A
    // write the narrowing does not see (an alias, an escaped closure) is then answered (D2447).
    const masked = maskNarrowFor(isNarrowMaskKey(nd0.isObj, fnIx))
    if masked.length > 0 {
      const sMark = storageReadEnter(nd0.isObj)
      const r = emitIsTest(body, isIx, fnIx, ec)
      storageReadLeave(sMark)
      unmaskNarrow(masked)
      return r
    }
    // A frame local no narrowing binds holds its own type in its slot, so where the checker
    // typed it as exactly the tested type the test is a tautology (`const w = v` under a
    // narrowing of `v`).
    const tl = nodeAt(unwrapParen(nd0.isObj))
    if tl is Ident {
      const isOpTy = nodeTyAt(nd0.isObj, fnIx)
      const isTsTy = isVarTyIxOf(isIx)
      if (
        localIndexOf(fnIx, tl.identName) >= 0
        && isOpTy >= 0
        && isTsTy >= 0
        && !isUnionOfTy(isOpTy)
        && !exprUnion(nd0.isObj, fnIx)
        && tySame(isOpTy, isTsTy)
      ) {
        fbI32Const(1)
        return 0
      }
    }
  }
  emitIsTest(body, isIx, fnIx, ec)
}

// The narrowing key `emitIs` lifts for operand `recvIx`: a name, or a member or index place,
// or "" where the storage itself holds the narrowed rep (a capture whose env field is not the
// union box), which lifting would misread.
function isNarrowMaskKey(recvIx: i32, fnIx: i32): string {
  const r = nodeAt(unwrapParen(recvIx))
  if r is Ident {
    if capturedKindOf(fnIx, r.identName) != null {
      if !capturedIsUnionBox(fnIx, r.identName) { return "" }
    }
    return r.identName
  }
  placeNarrowKeyOf(recvIx)
}

// `x is L` for a list type `L` over a box union with a list arm other than `L`: an arm fits when
// every element does (D4771), so a `string[]` arm tests its strings against `L`'s literals
// (D4779), an arm sharing `L`'s tag tests its atoms (D4938), and any other fits only when empty
// (D4915). 0 when the test is not that shape, 1 when emitted, -1 when refused.
function emitListIsAcrossReps(
  body: u8[],
  isIx: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) { return 0 }
  if nd.isVariant == "null" || !exprUnion(nd.isObj, fnIx) { return 0 }
  const chk = isVarTyIxOf(isIx)
  const nm = unionNameOfExpr(nd.isObj, fnIx)
  if tyArrayElemIx(chk) < 0 || nm == "" { return 0 }
  const atoms: string[] = []
  const arms: i32[] = []
  if (
    !unionSetArmTysAB(
      95,
      nm,
      unionDeclTyIxOfIdentRead(nd.isObj, fnIx),
      atoms,
      arms,
    )
  ) {
    return 0
  }
  const chkTag = isArmTagOfTy(chk)
  const chkLeaf = listLeafTyOf(chk)
  const tags: i32[] = []
  const fits: i32[] = []
  const wraps: i32[] = []
  const slotsAt: i32[][] = []
  let own = false
  let other = false
  for a in arms {
    if tyArrayElemIx(a) >= 0 {
      const t = isArmTagOfTy(a)
      if t < 0 { return 0 }
      let k = if tySame(a, chk) { LIST_ARM_OWN } else { listArmFitAcrossReps(a, chk) }
      const slots: i32[] = []
      if k == 0 {
        if t != chkTag {
          k = LIST_ARM_EMPTY
        } else {
          k = listArmSharedTagFit(a, chk, slots)
          if k == 0 { return 0 }
        }
      }
      if tySame(a, chk) { own = true } else { other = true }
      let j = tags.length - 1
      while j >= 0 && tags[j] != t { j = j - 1 }
      if j < 0 {
        tags.push(t)
        fits.push(k)
        wraps.push(listArmWrapOfTy(a))
        slotsAt.push(slots)
      } else if fits[j] != k {
        // Only `L` itself and an arm whose elements may fit `L` share a tag, and the element
        // test answers for both.
        const elemK = k == LIST_ARM_ATOMS
          || k == LIST_ARM_NULLS
          || k == LIST_ARM_NONNULL
        const elemJ = (fits[j] == LIST_ARM_ATOMS
          || fits[j] == LIST_ARM_NULLS
          || fits[j] == LIST_ARM_NONNULL)
        if elemK && fits[j] == LIST_ARM_OWN {
          fits[j] = k
          slotsAt[j] = slots
        } else if !(k == LIST_ARM_OWN && elemJ) {
          return 0
        }
      }
    }
  }
  if !other { return 0 }
  let empties = false
  let i = 0
  while i < fits.length {
    if fits[i] == LIST_ARM_EMPTY {
      if !own || chkTag < 0 || wraps[i] < 0 { return 0 }
      empties = true
    }
    i = i + 1
  }
  const slot = sharedFieldRecvSlot()
  if emitExpr(body, nd.isObj, fnIx, ec) < 0 { return -1 }
  fbLocalSet(slot)
  // A nullable operand is false on null; the box is a null reference then (D4953).
  const nullable = nodeTyIsNullable(nd.isObj)
  if nullable {
    fbLocalGet(slot)
    fbRefIsNull()
    fbIf(127)
    fbI32Const(0)
    fbElse()
  }
  const lexes = tyLitMemberTexts(chkLeaf)
  fbI32Const(0)
  i = 0
  while i < tags.length {
    fbLocalGet(slot)
    fbRefAsNonNull()
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, tags[i])
    fbI32Bin(70) // 0x46 i32.eq
    const k = fits[i]
    if k != LIST_ARM_OWN {
      fbIf(127)
      fbLocalGet(slot)
      fbRefAsNonNull()
      fbStructGet(uBoxIdx, 1)
      if k == LIST_ARM_EMPTY {
        fbRefCast(wraps[i])
        fbStructGet(wraps[i], 1) // len
        fbI32Eqz()
      } else if k == LIST_ARM_NULLS {
        if emitUnionPayloadUnbox(body, 7) < 0 { return -1 }
        const nulls = ["2"]
        if (
          emitListFitLoop(
            body,
            [],
            0,
            false,
            "i32",
            "i32",
            "i32",
            nulls,
            fnIx,
            ec,
          )
          < 0
        ) {
          return -1
        }
      } else if k == LIST_ARM_NONNULL {
        if emitUnionPayloadUnbox(body, 9) < 0 { return -1 }
        const one = [""]
        if (
          emitListFitLoop(
            body,
            [],
            0,
            false,
            "str",
            "str",
            "nonnull",
            one,
            fnIx,
            ec,
          )
          < 0
        ) {
          return -1
        }
      } else {
        const str = k == LIST_ARM_STRS
        const slots = slotsAt[i]
        if slots.length > 0 {
          fbRefCast(rlWrapIdx[slots[0]])
        } else if emitUnionPayloadUnbox(body, if str { 9 } else { 7 }) < 0 {
          return -1
        }
        const fit = emitListFitLoop(
          body,
          slots,
          0,
          false,
          if str { "str" } else { "i32" },
          if str { "str" } else { "i32" },
          if str { "str" } else { "atom" },
          lexes,
          fnIx,
          ec,
        )
        if fit < 0 { return -1 }
      }
      fbElse()
      fbI32Const(0)
      fbEnd()
    }
    fbI32Bin(114) // 0x72 i32.or
    i = i + 1
  }
  if nullable { fbEnd() }
  if empties {
    return emitListIsRebox(
      body,
      nd.isObj,
      slot,
      chk,
      chkTag,
      tags,
      fits,
      fnIx,
      ec,
    )
  }
  1
}

// How `emitListIsAcrossReps` tests one tag: by the tag alone (`L`, or an arm every element of
// which fits), a `string[]` arm's strings, an empty disjoint-rep arm, an atom arm's atoms, a
// `(boolean | null)[]` arm tested as `null[]` (every element the null sentinel 2), or a
// `(string | null)[]` arm tested as `string[]` (no element null).
const LIST_ARM_OWN = 1
const LIST_ARM_STRS = 2
const LIST_ARM_EMPTY = 3
const LIST_ARM_ATOMS = 4
const LIST_ARM_NULLS = 5
const LIST_ARM_NONNULL = 6

// How `emitListIsAcrossReps` tests list arm `a` against `chk` when the two share one tag and
// rep: by `a`'s atoms (filling `slots`), by null elements, by no null element, or 0 when no
// element test tells them apart.
function listArmSharedTagFit(a: i32, chk: i32, slots: i32[]): i32 {
  if tyIsLitUnion(listLeafTyOf(chk)) {
    const d = atomLeafListDepthOfTy(chk)
    if d >= 0 && atomLeafListDepthOfTy(a) == d && atomArmSlots(a, d, slots) {
      return LIST_ARM_ATOMS
    }
  }
  if isNullTy(tyArrayElemIx(chk)) && !isNullTy(tyArrayElemIx(a)) {
    return LIST_ARM_NULLS
  }
  if listArmIsNullableStrs(a, chk) { return LIST_ARM_NONNULL }
  0
}

// Whether list arm `a` is `(string | null)[]` and `chk` is `string[]`, so the two share the
// string list's tag and an `a` value fits `chk` exactly when no element is null.
function listArmIsNullableStrs(a: i32, chk: i32): boolean {
  const ae = tyArrayElemIx(a)
  const ce = tyArrayElemIx(chk)
  if ae < 0 || ce < 0 || tyPrimNameOf(ce) != "string" { return false }
  const an = nonNullTy(ae)
  an != ae && tyPrimNameOf(an) == "string"
}

// The innermost element type of list type `ty`, below every list layer.
function listLeafTyOf(ty: i32): i32 {
  let cur = ty
  let guard = 0
  while tyArrayElemIx(cur) >= 0 && guard < 64 {
    cur = tyArrayElemIx(cur)
    guard = guard + 1
  }
  cur
}

// Pushes onto `slots` the reflist slot of each of the `depth` outer layers of the atom-leaf list
// arm `a`, outermost first, as `emitListFitLoop` walks them; false when a layer is not the
// reflist its type names.
function atomArmSlots(a: i32, depth: i32, slots: i32[]): boolean {
  if depth == 0 { return true }
  let s = rlSlotOfTy(tyRefArrElemOf(a))
  let k = 0
  while k < depth {
    if s < 0 || s >= rlElemKindTbl.length || s >= rlWrapIdx.length {
      return false
    }
    slots.push(s)
    const ek = rlElemKindTbl[s]
    if k < depth - 1 {
      if ek != RLK_REF_LIST { return false }
      s = rlElemInnerSlot(s)
    } else if ek != RLK_I32_LIST {
      return false
    }
    k = k + 1
  }
  true
}

// The wrapper heap type list arm `a` rides a box's payload in, or -1.
function listArmWrapOfTy(a: i32): i32 {
  const lw = listWrapHeapOfKind(boxTagOfTy(a))
  if lw >= 0 { return lw }
  if !unMemIsRefElemArray(a) { return -1 }
  const sl = rlSlotOfTy(tyRefArrElemOf(a))
  if sl < 0 || sl >= rlWrapIdx.length { return -1 }
  rlWrapIdx[sl]
}

// With an `is L` answer on the stack, re-boxes receiver `recv` (staged in `slot`) as an empty
// `L` when it fitted as an empty list of another arm, and stores the box back into `recv`, so
// the narrowed branch reads and writes an `L` (D4949). The place takes a new list rather than
// the old one changing rep: a reference typed as the other arm must never hold an `L` element.
function emitListIsRebox(
  body: u8[],
  recv: i32,
  slot: i32,
  chk: i32,
  chkTag: i32,
  tags: i32[],
  fits: i32[],
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  const chkWrap = listArmWrapOfTy(chk)
  const chkBack = if chkWrap < 0 { -1 } else { listBackOfWrap(chkWrap) }
  const st = listIsStoreBackOf(recv, fnIx)
  // A place with no store-back reads an empty `L` stand-in, and a push into it traps (D4939).
  if chkBack < 0 || st.kind == LIS_NONE { return 1 }
  const res = listFitSlot("i32", 0, 4)
  fbLocalTee(res)
  fbIf(64)
  fbI32Const(0)
  let i = 0
  while i < tags.length {
    if fits[i] == LIST_ARM_EMPTY {
      fbLocalGet(slot)
      fbRefAsNonNull()
      fbStructGet(uBoxIdx, 0)
      fbI32Rel(RS_TAG, tags[i])
      fbI32Bin(70) // 0x46 i32.eq
      fbI32Bin(114) // 0x72 i32.or
    }
    i = i + 1
  }
  fbIf(64)
  if st.obj >= 0 && emitExpr(body, st.obj, fnIx, ec) < 0 { return -1 }
  if st.kind == LIS_ELEM {
    fbStructGet(rlWrapIdx[st.at], 0) // the backing; the read just made proved the index
    if emitExpr(body, st.idx, fnIx, ec) < 0 { return -1 }
  }
  fbI32Rel(RS_TAG, chkTag)
  fbBacking(chkBack, 0)
  fbI32Const(0)
  fbI32Const(0)
  fbStructNew(chkWrap)
  fbStructNew(uBoxIdx)
  if st.kind == LIS_LOCAL {
    fbLocalSet(st.at)
  } else if st.kind == LIS_GLOBAL {
    if emitUserGlobalSet(st.at) < 0 { return -1 }
  } else if st.kind == LIS_FIELD {
    fbStructSet(sHeapIdx[st.at], st.field)
  } else {
    fbArraySet(rlBackIdx[st.at])
  }
  fbEnd()
  fbEnd()
  fbLocalGet(res)
  1
}

// Where `emitListIsRebox` stores its box: nowhere, a local, a mutable global, a field of a
// record row, or an element of a list of boxes.
const LIS_NONE = 0
const LIS_LOCAL = 1
const LIS_GLOBAL = 2
const LIS_FIELD = 3
const LIS_ELEM = 4
type ListIsStore = { kind: i32, at: i32, field: i32, obj: i32, idx: i32 }

function listIsStore(
  kind: i32,
  at: i32,
  field: i32,
  obj: i32,
  idx: i32,
): ListIsStore {
  { kind: kind, at: at, field: field, obj: obj, idx: idx }
}

// The store-back `emitListIsRebox` can make into `recv`: `at` is the local, global, struct row
// or ref-list slot, `field` the struct field, `obj` and `idx` the container and index to
// re-evaluate. A capture `captureBoxRewrite` turned into a cell arrives as that cell's element.
function listIsStoreBackOf(recv: i32, fnIx: i32): ListIsStore {
  const rn = nodeAt(unwrapParen(recv))
  if rn is Ident {
    const li = localIndexOf(fnIx, rn.identName)
    if li >= 0 && identSlotIsUnionBox(fnIx, rn.identName) {
      return listIsStore(LIS_LOCAL, li, -1, -1, -1)
    }
    const g = if li >= 0 || capturedIsUnionBox(fnIx, rn.identName) { -1 } else { globalIndexOf(rn.identName) }
    if g >= 0 && !globalCellIsImmutable(g) {
      return listIsStore(LIS_GLOBAL, g, -1, -1, -1)
    }
  } else if placeNarrowKeyOf(recv) != "" {
    // Only a place the narrowing names is re-read, so re-evaluating its path has no effect.
    if rn is Member {
      const si = structIndexOfExpr(rn.memObj, fnIx)
      const fi = if si < 0 || si >= sHeapIdx.length { -1 } else { sFieldIndex(si, rn.memProp) }
      if fi >= 0 && sFieldTypeAt(si, fi) == FC_UNION {
        return listIsStore(LIS_FIELD, si, fi, rn.memObj, -1)
      }
    } else if rn is Index {
      const rs = if exprMap(rn.idxArr, fnIx) || !exprRefArray(rn.idxArr, fnIx) { -1 } else { refListSlotOfExpr(rn.idxArr, fnIx) }
      if rs >= 0 && rs < rlWrapIdx.length && rlElemKindTbl[rs] == RLK_UNION {
        return listIsStore(LIS_ELEM, rs, -1, rn.idxArr, rn.idxIndex)
      }
    }
  }
  // Any other operand, or a place whose storage is not a union box, keeps no store.
  listIsStore(LIS_NONE, -1, -1, -1, -1)
}

// The scalar and literal rungs of `emitIsTest`, in order: a scalar map read, a nullable niche,
// a literal atom, a literal-union arm, a numeric-literal base and literal membership. 1 when
// the test is emitted, 0 when every rung declines, -1 on failure.
function emitIsTestLitArms(
  body: u8[],
  isIx: i32,
  nd0: IsExpr,
  fnIx: i32,
  ec: ExpCtx,
) {
  const imk = mapReadScalarBoxKind(nd0.isObj, fnIx)
  if imk >= 0 {
    const imr = emitScalarMapReadIs(body, isIx, nd0.isObj, imk, fnIx, ec)
    if imr < 0 { return -1 }
    if imr > 0 { return 1 }
  }
  if exprNullableRefNiche(nd0.isObj, fnIx) {
    if nulNicheIsTestImpossible(nd0.isObj, isVarTyIxOf(isIx), fnIx) {
      fbI32Const(0)
      return 1
    }
    const nst = emitNulIsNullTest(
      body,
      nd0.isObj,
      fnIx,
      nd0.isVariant != "null",
      true,
      ec,
    )
    if nst < 0 { return -1 }
    if nst > 0 { return 1 }
    // The storage is the ref niche even where the checked type holds no `null`.
    if emitExpr(body, nd0.isObj, fnIx, ec) < 0 { return -1 }
    fbRefIsNull()
    if nd0.isVariant != "null" { fbI32Eqz() }
    return 1
  }
  if exprIsLitAtom(nd0.isObj, fnIx) {
    // Every member of a literal union is a string, so `is string` holds of the atom
    // outright, and of the `K | null` niche exactly when it is not the `-1` null (D2154).
    if tyPrimNameOf(isVarTyIxOf(isIx)) == "string" {
      if exprNulLitUnion(nd0.isObj, fnIx) {
        if emitExpr(body, nd0.isObj, fnIx, ec) < 0 { return -1 }
        fbI32Const(-1)
        fbI32Bin(71) // 0x47 i32.ne
        return 1
      }
      fbI32Const(1)
      return 1
    }
    const laTexts = tyLitMemberTexts(isVarTyIxOf(isIx))
    if laTexts.length > 0 {
      if nodeLitMembersWithin(nd0.isObj, laTexts) {
        fbI32Const(1)
        return 1
      }

      let laOk = laTexts.length == 1
      if unionEqOperandOk(nd0.isObj) { laOk = true }
      if laOk {
        let laI = 0
        while laI < laTexts.length {
          if emitExpr(body, nd0.isObj, fnIx, ec) < 0 { return -1 }
          fbI32Rel(RS_ATOM, internAtom(quoteLex(laTexts[laI])))
          fbI32Bin(70)
          if laI > 0 { fbI32Bin(114) }
          laI = laI + 1
        }
        return 1
      }
    }
  }
  const luNm = unionNameOfExpr(nd0.isObj, fnIx)
  if unionCarriesLitUnionArm(luNm) {
    const luTexts = tyLitMemberTexts(isVarTyIxOf(isIx))
    if luTexts.length > 0 && unionEqOperandOk(nd0.isObj) {
      let luI = 0
      while luI < luTexts.length {
        const luLit = quoteLex(luTexts[luI])
        if emitUnionLitIs(body, nd0.isObj, luLit, fnIx, ec) < 0 { return -1 }
        if luI > 0 { fbI32Bin(114) }
        luI = luI + 1
      }
      return 1
    }
  }
  if numLitUnionHasBase(isVarTyIxOf(isIx)) {
    const nbTexts = tyNumLitMemberTexts(isVarTyIxOf(isIx))
    if (
      nbTexts.length > 0
      && exprUnion(nd0.isObj, fnIx)
      && unionEqOperandOk(nd0.isObj)
    ) {
      const nbNm = unionNameOfExpr(nd0.isObj, fnIx)
      if (
        nbNm != ""
        && (isValueUnionOfSet(msSetOfUnion(nbNm), nbNm)
          || unionCarriesLitUnionArm(nbNm))
      ) {
        let nbI = 0
        while nbI < nbTexts.length {
          if emitUnionLitIs(body, nd0.isObj, nbTexts[nbI], fnIx, ec) < 0 {
            return -1
          }
          if nbI > 0 { fbI32Bin(114) }
          nbI = nbI + 1
        }
        return 1
      }
    }
  }
  if !exprIsLitAtom(nd0.isObj, fnIx) {
    const lsTexts = tyLitMemberTexts(isVarTyIxOf(isIx))
    if lsTexts.length > 0 && litMembershipRecvOk(nd0.isObj, fnIx) {
      if nodeTyIsLitUnion(nd0.isObj) {
        if nodeLitMembersWithin(nd0.isObj, lsTexts) {
          fbI32Const(1)
          return 1
        }
      }
      let lsOk = lsTexts.length == 1
      if unionEqOperandOk(nd0.isObj) { lsOk = true }
      // A box with no string arm holds no string member: false, after the receiver once.
      if !lsOk && litStrMembersOutsideBox(nd0.isObj, lsTexts, fnIx) {
        if emitExpr(body, nd0.isObj, fnIx, ec) < 0 { return -1 }
        fbDrop()
        fbI32Const(0)
        return 1
      }
      if !lsOk { return emitFailNoMembershipRecv() }
      let lsI = 0
      while lsI < lsTexts.length {
        if (
          emitLitMemberEq(body, nd0.isObj, quoteLex(lsTexts[lsI]), fnIx, ec)
          < 0
        ) {
          return -1
        }
        if lsI > 0 { fbI32Bin(114) }
        lsI = lsI + 1
      }
      return 1
    }
  }
  0
}

// The box-tag rung of `emitIsTest`: list emptiness, literal membership over a plain string arm,
// and the arm-tag compare through an ident, member, optional member or box value. 1 when the
// test is emitted, 0 when the rung declines, -1 on failure.
function emitIsTestArmTag(
  body: u8[],
  isIx: i32,
  ndv: IsExpr,
  fnIx: i32,
  ec: ExpCtx,
) {
  // A list `K[]` can never meet is a fit exactly when empty, which neither a box's tag nor a
  // non-null test can say (D4912).
  const fitK = isVarTyIxOf(isIx)
  if fitK >= 0 && tyAt(fitK) is TyArray {
    const uf = emitListEmptyFitIs(body, isIx, fnIx, ec)
    if uf < 0 { return -1 }
    if uf > 0 { return 1 }
  }
  // A literal union tested against a box whose string arm is a plain `string` is membership
  // over the payload: the tag alone answers true for a non-member string (D3348).
  const smTexts = tyLitMemberTexts(isVarTyIxOf(isIx))
  if (
    smTexts.length > 0
    && tyIsLitUnion(isVarTyIxOf(isIx))
    && exprUnion(ndv.isObj, fnIx)
    && unionEqOperandOk(ndv.isObj)
    && !unionCarriesLitUnionArm(unionNameOfExpr(ndv.isObj, fnIx))
    && msSetTakesAtomAsStr(
      msSetOfUnionBox(ndv.isObj, unionNameOfExpr(ndv.isObj, fnIx), fnIx),
    )
    && !readIsCallResult(ndv.isObj, fnIx)
  ) {
    let smI = 0
    while smI < smTexts.length {
      if emitUnionLitIs(body, ndv.isObj, quoteLex(smTexts[smI]), fnIx, ec) < 0 {
        return -1
      }
      if smI > 0 { fbI32Bin(114) }
      smI = smI + 1
    }
    return 1
  }
  let patTy = isPatUnionArmTy(ndv.isObj, isVarTyIxOf(isIx), fnIx)
  // `x is i32` over a literal box banks the literals it covers, held under the base's tag (D3522).
  if !tyIsPrimIx(patTy) {
    const plb = numLitUnionBaseTy(patTy)
    if plb >= 0 && primNameStr(tyEmitPrimOf(plb)) == ndv.isVariant {
      patTy = plb
    }
  }
  if mapSoftTwinTagFail(ndv.isObj, patTy, fnIx, isIx) < 0 { return -1 }
  const armTag = isArmTagOfTy(patTy)
  // An exact instance's union may hold the pattern's twin under one tag (a Set and its
  // boolean map), so a member set without the pattern itself answers false.
  const lacksExact = (unMemIsMap(patTy)
    && exprUnion(ndv.isObj, fnIx)
    && exactUnionLacksMap(ndv.isObj, isVarTyIxOf(isIx), fnIx))
    || (exprUnion(ndv.isObj, fnIx)
    && exactUnionLacksTwin(ndv.isObj, isVarTyIxOf(isIx), fnIx))
  // A map type no arm of the box registered is a member of no value it can hold (a generic
  // body's `is M` at a pin whose union lacks `M`): the answer is false, after the receiver.
  if (
    lacksExact
    || armTag < 0 && unMemIsMap(patTy) && exprUnion(ndv.isObj, fnIx)
  ) {
    if emitExpr(body, ndv.isObj, fnIx, ec) < 0 { return -1 }
    fbDrop()
    fbI32Const(0)
    return 1
  }

  // the tag compare below is unsound for a litunion tested type over a box with two
  // string-repped arms: the litunion arm shares kind 2's tag with a plain `string` arm,
  // so `tag == 2` would answer true for every string the box holds, members or not. A row
  // with an untyped member cannot say, so it takes the refusal too.
  if armTag == 2 && tyIsLitUnion(isVarTyIxOf(isIx)) {
    const amNm = isStrTagUnionNameOf(ndv.isObj, fnIx)
    const amStr = if amNm == "" { 0 } else { unionStrArmCountOf(amNm) }
    if amStr < 0 || amStr > 1 { return emitFailNoMembershipRecv() }
  }
  if armTag >= 0 {
    const vrecv = nodeAt(unwrapParen(ndv.isObj))
    // No arm of this box carries the tag (a generic body's `is i32[]` at a pin whose union
    // has no list), so the test is false and a bare name needs no read (D2955).
    if vrecv is Ident && unionBoxLacksTag(ndv.isObj, armTag, fnIx) {
      fbI32Const(0)
      return 1
    }
    if vrecv is Ident {
      // pushes the raw box slot directly, even when an outer arm already narrowed it to
      // a single atom — the narrowed Ident read would unbox instead of yielding the box.
      if (
        unionNameOfIdentAt(
          sidOfNode(unwrapParen(ndv.isObj)),
          fnIx,
          unwrapParen(ndv.isObj),
        )
          != ""
        && identSlotIsUnionBox(fnIx, vrecv.identName)
      ) {
        if emitUnionBoxPush(body, vrecv.identName, fnIx, ec) < 0 { return -1 }
        fbStructGet(uBoxIdx, 0)
        fbI32Rel(RS_TAG, armTag)
        fbI32Bin(70)
        return 1
      }
    }

    if vrecv is Member {
      if memberUnionFieldNameRead(unwrapParen(ndv.isObj), fnIx) != "" {
        // Only a receiver narrowed to a variant of a box, as `emitMem` asks; a nullable record
        // narrowed by `!= null` is the record itself (D8000).
        if (
          memIsNarrowed(unwrapParen(ndv.isObj))
          && memNarrowVariantIndex(unwrapParen(ndv.isObj)) >= 0
          && exprUnion(vrecv.memObj, fnIx)
        ) {
          if emitNarrowedMem(body, unwrapParen(ndv.isObj), fnIx, ec) < 0 {
            return -1
          }
          fbStructGet(uBoxIdx, 0)
          fbI32Rel(RS_TAG, armTag)
          fbI32Bin(70)
          return 1
        }

        const msi = structIndexOfExpr(vrecv.memObj, fnIx)
        if msi >= 0 {
          const mfi = sFieldIndex(msi, vrecv.memProp)
          if mfi >= 0 {
            if emitExpr(body, vrecv.memObj, fnIx, ec) < 0 { return -1 }
            if (
              exprNullableStruct(vrecv.memObj, fnIx)
              && !readOwesNonNullRecover(vrecv.memObj, fnIx)
            ) {
              fbRefAsNonNull()
            }
            fbStructGet(sHeapIdx[msi], mfi)
            fbStructGet(uBoxIdx, 0)
            fbI32Rel(RS_TAG, armTag)
            fbI32Bin(70)
            return 1
          }
        }

        const aivi = exprVariantIndex(vrecv.memObj, fnIx)
        if aivi >= 0 {
          const aifi = variantFieldIndex(aivi, vrecv.memProp)
          if aifi >= 0 {
            if emitExpr(body, vrecv.memObj, fnIx, ec) < 0 { return -1 }
            fbStructGet(uVarHeap[aivi], aifi)
            fbStructGet(uBoxIdx, 0)
            fbI32Rel(RS_TAG, armTag)
            fbI32Bin(70)
            return 1
          }
        }
      }
    }

    if vrecv is OptMember {
      const oisSi = optChainStructIdxOf(vrecv.omObj, fnIx)
      if oisSi >= 0 {
        const oisFi = sFieldIndex(oisSi, vrecv.omProp)
        if oisFi >= 0 {
          if sFieldTypeAt(oisSi, oisFi) == FC_UNION {
            const oisSv = optRecvStageSave()
            optRecvStageMark(vrecv.omObj)
            if emitOptChainIsNull(body, vrecv.omObj, fnIx, ec) < 0 { return -1 }
            fbIf(127)
            fbI32Const(0)
            fbElse()
            if emitOptChainValue(body, vrecv.omObj, fnIx, ec) < 0 { return -1 }
            fbStructGet(sHeapIdx[oisSi], oisFi)
            fbStructGet(uBoxIdx, 0)
            fbI32Rel(RS_TAG, armTag)
            fbI32Bin(70)
            fbEnd()
            optRecvStageRestore(oisSv)
            return 1
          }
        }
      }
    }
    if exprUnion(ndv.isObj, fnIx) {
      if emitExpr(body, ndv.isObj, fnIx, ec) < 0 { return -1 }
      fbStructGet(uBoxIdx, 0)
      fbI32Rel(RS_TAG, armTag)
      fbI32Bin(70)
      return 1
    }
  }
  0
}

// The numeric-literal-union rung of `emitIsTest` over a non-box receiver: one compare per
// member at the receiver's base, re-read or read once into a slot. 1 when the test is
// emitted, 0 when the rung declines, -1 on failure.
function emitIsTestNumLit(
  body: u8[],
  isIx: i32,
  nd0: IsExpr,
  fnIx: i32,
  ec: ExpCtx,
) {
  if !exprUnion(nd0.isObj, fnIx) {
    let nlBase = numLitUnionBaseName(isVarTyIxOf(isIx))
    let nlTexts = tyNumLitMemberTexts(isVarTyIxOf(isIx))
    // An `i64` receiver compares at `i64`, which holds every member of an `i32` union and
    // of an integer union over both widths (D3658).
    if isNumRecvBaseName(nd0.isObj, fnIx) == "i64" {
      if nlBase == "" {
        nlTexts = tyIntLitWideTexts(isVarTyIxOf(isIx))
        if nlTexts.length > 0 { nlBase = "i64" }
      }
      if nlBase == "i32" { nlBase = "i64" }
    }
    if nlBase != "" && isNumRecvBaseName(nd0.isObj, fnIx) == nlBase {
      let nlOk = nlTexts.length == 1
      if unionEqOperandOk(nd0.isObj) { nlOk = true }
      if nlTexts.length > 0 && nlOk {
        let nlI = 0
        while nlI < nlTexts.length {
          if emitNumLitEq(body, nd0.isObj, nlTexts[nlI], fnIx, ec) < 0 {
            return -1
          }
          if nlI > 0 { fbI32Bin(114) }
          nlI = nlI + 1
        }
        return 1
      }
      // A receiver that cannot be re-read is read once into a slot of its base; the name
      // fold below answers by spelling and would say false for a member (D3570, D3590).
      if nlTexts.length > 0 && numLitOnceReadOk(nlBase, nlTexts) {
        if emitExpr(body, nd0.isObj, fnIx, ec) < 0 { return -1 }
        const nlSlot = numLitOnceSlot(nlBase)
        fbLocalSet(nlSlot)
        let nsI = 0
        while nsI < nlTexts.length {
          fbLocalGet(nlSlot)
          emitNumLitConstEq(nlBase, nlTexts[nsI])
          if nsI > 0 {
            fbI32Bin(114) // 0x72 i32.or
          }
          nsI = nsI + 1
        }
        return 1
      }
    }
  }
  0
}

// Whether no value of the closed record type `rcv` can be record arm `arm`: their field names
// differ, or some shared field shares no value (`recArmFitKind`), as the checker refuses it.
function recNeverFitsArm(arm: i32, rcv: i32): boolean {
  if arm < 0 || rcv < 0 || tyHasTyVar(rcv) { return false }
  if !(tyAt(arm) is TyObj) || !(tyAt(rcv) is TyObj) { return false }
  recArmFitKind(arm, rcv) == 0
}

// The variant rung of `emitIsTest`: `recv is V` for a union variant, alias arm or record,
// by a static row fold where the row is the answer, else the box tag and discriminant test.
// Returns 0 once the test is on the stack, -1 on failure.
function emitIsTestVariant(
  body: u8[],
  isIx: i32,
  nd: IsExpr,
  fnIx: i32,
  ec: ExpCtx,
) {
  const vi = variantIndexOf(
    isVariantSpellingAtRecv(nd.isVariant, isVarTyIxOf(isIx), nd.isObj),
  )
  if vi < 0 {
    if recvIsTestedRecord(nd.isObj, isVarTyIxOf(isIx)) {
      if emitExpr(body, nd.isObj, fnIx, ec) < 0 { return -1 }
      fbDrop()
      fbI32Const(1)
      return 0
    }
    // A union alias arm has no single variant row because it is a SUBSET of the outer
    // box's tags, so the test is the tag chain `as?` already emits for a sub-union target
    // (D1774). A layout-twin arm is excluded: its tag alone does not settle membership,
    // and the per-arm discriminant test has no home inside a chain.
    const isTags: i32[] = []
    const isVis: i32[] = []
    if unionArmTagsOfTy(isVarTyIxOf(isIx), isTags, isVis) {
      let chainOk = isTags.length > 1
        && exprUnion(nd.isObj, fnIx)
        && unionEqOperandOk(nd.isObj)
      let ci = 0
      while ci < isVis.length {
        if variantHasDiscrimField(isVis[ci]) { chainOk = false }
        ci = ci + 1
      }
      if chainOk {
        let ti = 0
        while ti < isTags.length {
          if emitExpr(body, nd.isObj, fnIx, ec) < 0 { return -1 }
          fbStructGet(uBoxIdx, 0)
          fbI32Rel(RS_TAG, isTags[ti])
          fbI32Bin(70)
          if ti > 0 { fbI32Bin(114) }
          ti = ti + 1
        }
        return 0
      }
    }
    // A record no union of the program has as a variant is in no box, so a box's test of it
    // is false, as a pin whose join lacks it answers (D3344).
    // A `K | null` niche holds no record and no value of a primitive other than `string` (D3344).
    const nlPrim = isTestValuePrimName(isVarTyIxOf(isIx))
    const nlNo = exprNulLitUnion(nd.isObj, fnIx)
      && !exprUnion(nd.isObj, fnIx)
      && ((nlPrim != "" && nlPrim != "string")
      || tyIsRecord(isVarTyIxOf(isIx)))
    // A box of value arms only holds no record.
    const boxNm = unionNameOfExpr(nd.isObj, fnIx)
    const boxNo = exprUnion(nd.isObj, fnIx)
      && tyIsRecord(isVarTyIxOf(isIx))
      && boxNm != ""
      && (isValueUnionOfSet(msSetOfUnion(boxNm), boxNm)
      || unionCarriesLitUnionArm(boxNm))
    // Only a join the checker kept apart over declared parameters reaches here by design.
    if (
      (nlNo || boxNo)
      && fnInPinnedInstance(fnIx)
      && holeOperandTyOf(nd.isObj, fnIx) < 0
      && !criFnIsAnonLambda(fnStmtsPosOf(fnIx))
      && !readIsCallResult(nd.isObj, fnIx)
    ) {
      if emitExpr(body, nd.isObj, fnIx, ec) < 0 { return -1 }
      fbDrop()
      fbI32Const(0)
      return 0
    }
    if tyIsUnionMemberOf(nodeTyIxOf(nd.isObj), isVarTyIxOf(isIx)) {
      return emitFail(
        "emitProgram: `is` names a declared union member with no interned arm representation (deferred value-union composition)",
      )
    }
    return emitFail(
      "emitProgram: `is` names a type that is not a union variant",
    )
  }

  // A row holding several members answers from the value's fields after its tag (D5157).
  const shared = armRowSharedAtRecv(nd.isObj, vi)
  const rvi = exprVariantIndex(nd.isObj, fnIx)
  if rvi >= 0 && !shared {
    // The static fold is only sound where the row is the answer (D1023).
    // `exprVariantIndex` resolves an object literal by its field-name set, so where two arms
    // share a shape it names whichever row it matched first — and folding `rvi == vi` would
    // answer `is` by the row a value happened to be built under, the nominal answer.

    // A non-box receiver still folds, because for it the row really is all there is: a slot
    // holding the raw variant ref has no tag and no payload to read, so there is no value to
    // ask. Only a boxed receiver whose shape carries a discriminant falls through to the
    // runtime chain.
    const foldOk = !exprUnion(nd.isObj, fnIx)
      || (!variantHasDiscrimField(rvi)
      && !variantHasDiscrimField(vi)
      && !isFitsAcrossTagRows(
      nd.isVariant,
      isVarTyIxOf(isIx),
      nd.isObj,
      fnIx,
    ))
    if foldOk {
      if rvi == vi { fbI32Const(1) } else { fbI32Const(0) }
      return 0
    }
  }
  if !exprUnion(nd.isObj, fnIx) {
    // An instance's closed record receiver answers by value fit: a record whose fields can
    // never fit the tested arm's is not it (D12520).
    if (
      recNeverFitsArm(isVarTyIxOf(isIx), nodeTyAt(unwrapParen(nd.isObj), fnIx))
    ) {
      if emitExpr(body, nd.isObj, fnIx, ec) < 0 { return -1 }
      fbDrop()
      fbI32Const(0)
      return 0
    }
    return emitFail("emitProgram: `is` receiver is not a union value")
  }
  // A receiver the cross-arm terms re-read is evaluated once when it is not a place.
  let ctSlot = -1
  if (
    (shared
      || isFitsAcrossTagRows(nd.isVariant, isVarTyIxOf(isIx), nd.isObj, fnIx))
    && !unionEqOperandOk(nd.isObj)
  ) {
    ctSlot = sharedFieldRecvSlot()
    if emitExpr(body, nd.isObj, fnIx, ec) < 0 { return -1 }
    fbLocalSet(ctSlot)
  }
  if emitSharedFieldRecv(body, nd.isObj, fnIx, ctSlot, ec) < 0 { return -1 }
  fbStructGet(uBoxIdx, 0)
  fbI32Rel(RS_TAG, uTags[vi])
  fbI32Bin(70)
  if emitVariantDiscrimTest(body, nd.isObj, vi, fnIx, ec) < 0 { return -1 }
  if shared {
    fbIf(127)
    const sf = emitArmFieldsFit(
      body,
      nd.isObj,
      vi,
      uVarTyIx[vi],
      isVarTyIxOf(isIx),
      fnIx,
      ctSlot,
      ec,
    )
    if sf < 0 { return -1 }
    fbElse()
    fbI32Const(0)
    fbEnd()
  }
  const ctIs = emitCrossTagFits(
    body,
    nd.isObj,
    vi,
    isVarTyIxOf(isIx),
    fnIx,
    ctSlot,
    ec,
  )
  if ctIs < 0 { return -1 }
  return 0
}

// 1 or 0 when the re-readable operand of `is` at `isIx` holds only `null` at instance `fnIx`,
// so the test is whether the tested type admits `null`; -1 otherwise. The name cascade would
// read such an operand as the `i32` it shares a pin with (D8182).
function nullInstanceIsResult(isIx: i32, fnIx: i32): i32 {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) { return -1 }
  if !isNullTy(instanceReadTyOf(nd.isObj, fnIx)) { return -1 }
  if !exprReReadable(unwrapParen(nd.isObj)) { return -1 }
  const nlt = isVarTyIxOf(isIx)
  if nlt < 0 || nlt >= T.tys.length || tyAt(nlt) is TyVar { return -1 }
  if tyAdmitsNull(nlt) { 1 } else { 0 }
}

// `recv is X` over an operand read at the rep the narrowing stack leaves it. Fixed,
// load-bearing arm order: niche null tests, atom/literal-union membership, box-tag compares,
// mono-static folds, then the variant tag+discriminant compare. A niche `is` assumes the checker
// proved the tested shape is the sole non-null member, which monomorphization can break (D950).
function emitIsTest(body: u8[], isIx: i32, fnIx: i32, ec: ExpCtx) {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) { return emitIsTestRungs(body, isIx, fnIx, ec) }
  const rep = isRecvStageRep(isIx, fnIx)
  if rep < 0 { return emitIsTestRungs(body, isIx, fnIx, ec) }
  if emitExpr(body, nd.isObj, fnIx, ec) < 0 { return -1 }
  const slot = isRecvStashSlot(rep)
  fbLocalSet(slot)
  const svIx = isRecvStagedIx
  const svSlot = isRecvStagedSlot
  const svNonNull = isRecvStagedNonNull
  isRecvStagedIx = unwrapParen(nd.isObj)
  isRecvStagedSlot = slot
  isRecvStagedNonNull = rep == 3
  const r = emitIsTestRungs(body, isIx, fnIx, ec)
  isRecvStagedIx = svIx
  isRecvStagedSlot = svSlot
  isRecvStagedNonNull = svNonNull
  r
}

// The rep a membership test's receiver is staged at (D12060), or -1 to read it in place: a
// literal-union test re-reads its receiver once per member, so one that is not a re-readable
// place is evaluated first into a local. 0 a union box, 1 an atom id, 2 a nullable string,
// 3 a string.
function isRecvStageRep(isIx: i32, fnIx: i32): i32 {
  const nd = nodeAt(isIx)
  if !(nd is IsExpr) || unionEqOperandOk(nd.isObj) { return -1 }
  const ity = isVarTyIxOf(isIx)
  if tyLitMemberTexts(ity).length < 2 && tyNumLitMemberTexts(ity).length < 2 {
    return -1
  }
  if exprUnion(nd.isObj, fnIx) { return 0 }
  if exprIsLitAtom(nd.isObj, fnIx) { return 1 }
  if exprNullableString(nd.isObj, fnIx) { return 2 }
  if exprString(nd.isObj, fnIx) { return 3 }
  -1
}

// The rungs of `emitIsTest`, over a receiver staged or read in place.
function emitIsTestRungs(body: u8[], isIx: i32, fnIx: i32, ec: ExpCtx) {
  const nd0 = nodeAt(isIx)
  // `r?.f is null` is `r?.f == null`: one test over every link and the field's own null (D3457).
  if nd0 is IsExpr {
    if nd0.isVariant == "null" {
      const ion = nodeAt(unwrapParen(nd0.isObj))
      if ion is OptMember {
        const ionSv = optRecvStageSave()
        optRecvStageMark(nd0.isObj)
        const ionRc = emitOptChainIsNull(body, nd0.isObj, fnIx, ec)
        optRecvStageRestore(ionSv)
        return ionRc
      }
    }
  }
  const nst = nullInstanceIsResult(isIx, fnIx)
  if nst >= 0 {
    fbI32Const(nst)
    return 0
  }
  const rfit = emitRecordFitIs(body, isIx, fnIx, ec)
  if rfit != 0 { return if rfit < 0 { -1 } else { 0 } }
  const lfit = emitListFitIs(body, isIx, fnIx, ec)
  if lfit != 0 { return if lfit < 0 { -1 } else { 0 } }
  const lxr = emitListIsAcrossReps(body, isIx, fnIx, ec)
  if lxr != 0 { return if lxr < 0 { -1 } else { 0 } }
  if nd0 is IsExpr {
    const lar = emitIsTestLitArms(body, isIx, nd0, fnIx, ec)
    if lar != 0 { return if lar < 0 { -1 } else { 0 } }
  }

  if isIx < 0 { return -1 }
  const ndv = nodeAt(isIx)
  if ndv is IsExpr {
    const atr = emitIsTestArmTag(body, isIx, ndv, fnIx, ec)
    if atr != 0 { return if atr < 0 { -1 } else { 0 } }
  }

  if nd0 is IsExpr {
    const nlr = emitIsTestNumLit(body, isIx, nd0, fnIx, ec)
    if nlr != 0 { return if nlr < 0 { -1 } else { 0 } }
  }

  if nd0 is IsExpr {
    const lv = nd0.isVariant
    if isLitVariantName(lv) {
      return emitLitMemberEq(body, nd0.isObj, lv, fnIx, ec)
    }
  }

  if nd0 is IsExpr {
    // this arm's position is the correctness argument: it claims exactly the receivers
    // that would otherwise reach `monoStaticIsResult`'s unsound name-based fold below.
    let nulOk = true
    if nd0.isVariant != "null" {
      if exprNulLitUnion(nd0.isObj, fnIx) { nulOk = false }
      if tyIsLitUnion(isVarTyIxOf(isIx)) { nulOk = false }
      // A box holds every member under its own tag, so being non-null is not being the arm:
      // the variant rungs below test the tag (D2267).
      if exprUnion(nd0.isObj, fnIx) { nulOk = false }
    }
    if nulOk {
      if nulNicheIsTestImpossible(nd0.isObj, isVarTyIxOf(isIx), fnIx) {
        fbI32Const(0)
        return 0
      }
      const nt = emitNulIsNullTest(
        body,
        nd0.isObj,
        fnIx,
        nd0.isVariant != "null",
        true,
        ec,
      )
      if nt < 0 { return -1 }
      if nt > 0 { return 0 }
    }
  }

  if nd0 is IsExpr {
    // A receiver typed at a union of type parameters the checker did not keep apart (an
    // annotation) has no rep this fold can trust, so a literal-union test over one that cannot
    // be re-read refuses as the direct spelling does (D3528).
    const msObj = nodeTyAt(unwrapParen(nd0.isObj), fnIx)
    if (
      tyIsLitUnion(isVarTyIxOf(isIx))
      && !unionEqOperandOk(nd0.isObj)
      && msObj >= 0
      && tyHasTyVar(msObj)
      && tyIsUnionShaped(msObj)
      && !tyIsTpJoinUnion(msObj)
    ) {
      return emitFailNoMembershipRecv()
    }
  }

  if nd0 is IsExpr {
    const st = monoStaticIsResult(isIx, fnIx)
    if st == 0 {
      const ef = emitListEmptyFitIs(body, isIx, fnIx, ec)
      if ef < 0 { return -1 }
      if ef > 0 { return 0 }
    }
    if st >= 0 {
      // A static answer still evaluates a receiver that is not a re-readable place (D12070).
      if !unionEqOperandOk(nd0.isObj) {
        if emitExpr(body, nd0.isObj, fnIx, ec) < 0 { return -1 }
        fbDrop()
      }
      fbI32Const(st)
      return 0
    }
  }

  if nd0 is IsExpr {
    if tyDenotesFunc(isVarTyIxOf(isIx)) {
      if exprNulClosure(nd0.isObj, fnIx) {
        if emitExpr(body, nd0.isObj, fnIx, ec) < 0 { return -1 }
        fbRefIsNull()
        fbI32Eqz()
        return 0
      }
    }
  }

  if !uDeclared {
    return emitFail("emitProgram: `is` test but no union type declared")
  }
  const nd = nodeAt(isIx)
  if nd is IsExpr { return emitIsTestVariant(body, isIx, nd, fnIx, ec) }
  emitFail("emitProgram: expected an `is` expression")
}

// `recv is X` over a box whose other arms sit under their own tags yet may hold values that fit
// `X` (D4056): `i32.or`s onto the tag test one term per such arm `Y` — its tag alone when every
// `Y` fits, else its tag and then, inside an `if`, a test of each field that only some values fit.
function emitCrossTagFits(
  body: u8[],
  recv: i32,
  vi: i32,
  xTy: i32,
  fnIx: i32,
  slot: i32,
  ec: ExpCtx,
): i32 {
  const rows: i32[] = []
  const kinds: i32[] = []
  crossTagFitRows(vi, xTy, recv, rows, kinds, fnIx)
  let i = 0
  while i < rows.length {
    const yi = rows[i]
    if emitSharedFieldRecv(body, recv, fnIx, slot, ec) < 0 { return -1 }
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, uTags[yi])
    fbI32Bin(70)
    if kinds[i] == 2 {
      fbIf(127)
      const ff = emitArmFieldsFit(
        body,
        recv,
        yi,
        uVarTyIx[yi],
        xTy,
        fnIx,
        slot,
        ec,
      )
      if ff < 0 { return -1 }
      fbElse()
      fbI32Const(0)
      fbEnd()
    }
    fbI32Bin(114) // i32.or
    i = i + 1
  }
  0
}

// Leaves 1 when the payload of arm `yi` (arena `yTy`) fits record `xTy` field by field, given that
// its tag already matched. A field only some values fit is either a scalar tested against the
// literal set `xTy` narrows it to, or a box whose every member fits or does not, answered by its
// tag. Anything finer is refused by name.
function emitArmFieldsFit(
  body: u8[],
  recv: i32,
  yi: i32,
  yTy: i32,
  xTy: i32,
  fnIx: i32,
  slot: i32,
  ec: ExpCtx,
): i32 {
  if yi < 0 || yi >= uVarHeap.length {
    return emitFail(
      "emitProgram: `is` across record arms names an arm with no row",
    )
  }
  const names: string[] = []
  const fys: i32[] = []
  const fxs: i32[] = []
  recArmPartialFields(xTy, yTy, names, fys, fxs)
  let i = 0
  while i < names.length {
    const fi = variantFieldIndex(yi, names[i])
    // A field that never holds `null` is tested against the set's non-null members alone.
    let fxSet = fxs[i]
    if nonNullTy(fys[i]) == fys[i] { fxSet = nonNullTy(fxSet) }
    // A nullable string field answers its null apart, then tests only non-null strings: all
    // fit, none does, or they are compared against the set's string members.
    const nulStr = fi >= 0 && variantFieldTypeAt(yi, fi) == FC_NUL_STR
    let nnKind = 2
    if nulStr { nnKind = tyFitKind(nonNullTy(fys[i]), fxSet) }
    const lexes = tyLitSetMemberLexes(
      if nulStr { nonNullTy(fxSet) } else { fxSet },
    )
    if (
      fi >= 0
      && variantFieldTypeAt(yi, fi) != FC_UNION
      && (lexes.length > 0 || nnKind != 2)
    ) {
      if nulStr {
        if emitSharedFieldRecv(body, recv, fnIx, slot, ec) < 0 { return -1 }
        fbStructGet(uBoxIdx, 1)
        fbRefCast(uVarHeap[yi])
        fbStructGet(uVarHeap[yi], fi)
        fbRefIsNull()
        fbIf(127)
        fbI32Const(if nonNullTy(fxSet) != fxSet { 1 } else { 0 })
        fbElse()
        if nnKind != 2 { fbI32Const(nnKind) }
      }
      let li = 0
      if nnKind != 2 { li = lexes.length }
      while li < lexes.length {
        if emitSharedFieldRecv(body, recv, fnIx, slot, ec) < 0 { return -1 }
        fbStructGet(uBoxIdx, 1)
        fbRefCast(uVarHeap[yi])
        fbStructGet(uVarHeap[yi], fi)
        if nulStr { fbRefAsNonNull() }
        if (
          emitFieldLitEq(body, variantFieldTypeAt(yi, fi), lexes[li], fnIx, ec)
          < 0
        ) {
          return -1
        }
        if li > 0 {
          fbI32Bin(114) // i32.or
        }
        li = li + 1
      }
      if nulStr { fbEnd() }
      if i > 0 {
        fbI32Bin(113) // i32.and
      }
      i = i + 1
      continue
    }
    if fi < 0 || variantFieldTypeAt(yi, fi) != FC_UNION {
      return emitFail(
        "emitProgram: `is` across record arms whose shared field holds a value only some of which fit, outside a union box",
      )
    }
    const yes: i32[] = []
    const no: i32[] = []
    const mems: i32[] = []
    flattenVariantsInto(fys[i], mems)
    for mm in mems {
      const fk = tyFitKind(mm, fxs[i])
      const tags: i32[] = []
      const vis: i32[] = []
      if fk == 2 || !unionArmTagsOfTy(mm, tags, vis) || tags.length != 1 {
        return emitFail(
          "emitProgram: `is` across record arms whose shared field's box holds a member only some of whose values fit",
        )
      }
      if fk == 1 { yes.push(tags[0]) } else { no.push(tags[0]) }
    }
    for t in yes {
      if i32ListHas(no, t) {
        return emitFail(
          "emitProgram: `is` across record arms whose shared field's box tags a fitting and a non-fitting member alike",
        )
      }
    }
    if yes.length == 0 { fbI32Const(0) }
    let j = 0
    while j < yes.length {
      if emitSharedFieldRecv(body, recv, fnIx, slot, ec) < 0 { return -1 }
      fbStructGet(uBoxIdx, 1)
      fbRefCast(uVarHeap[yi])
      fbStructGet(uVarHeap[yi], fi)
      fbStructGet(uBoxIdx, 0)
      fbI32Rel(RS_TAG, yes[j])
      fbI32Bin(70)
      if j > 0 { fbI32Bin(114) }
      j = j + 1
    }
    if i > 0 {
      fbI32Bin(113) // i32.and
    }
    i = i + 1
  }
  if names.length == 0 { fbI32Const(1) }
  0
}

// The `string | null` read rule for a field of code `code`, shared by every struct and variant
// field read and by the ident reads in `emitIdentNode`: a value read recovers the non-null ref.
// A null test and a nullable-string target keep the raw ref (`nulStrReadStaysRaw`).
function emitNulStrFieldRecover(code: i32, ec: ExpCtx) {
  if code == FC_NUL_STR && !nulStrReadStaysRaw(ec) { fbRefAsNonNull() }
  0
}

// Lower a narrowed field read `recv.field` where `recv` is narrowed to `narrowVariant` by
// an enclosing `if recv is Variant`: evaluate the box, `struct.get $box 1`, `ref.cast (ref
// $variant)` (non-null: a box never is), then `struct.get` the field. Resolves the variant
// from the receiver's own active narrowing, so two simultaneously-narrowed locals agree.
function emitNarrowedMem(body: u8[], memIx: i32, fnIx: i32, ec: ExpCtx) {
  const m = nodeAt(memIx)
  if m is Member {
    const vi = memNarrowVariantIndex(memIx)
    if vi < 0 {
      return emitFail("emitProgram: narrowed receiver names no union variant")
    }
    const idx = variantFieldIndex(vi, m.memProp)
    if idx < 0 {
      return emitFail(
        "emitProgram: unknown variant field in narrowed field access",
      )
    }
    if emitExpr(body, m.memObj, fnIx, ec) < 0 { return -1 }
    fbStructGet(uBoxIdx, 1)
    fbRefCast(uVarHeap[vi])
    fbStructGet(uVarHeap[vi], idx)
    emitNulStrFieldRecover(variantFieldTypeAt(vi, idx), ec)

    // A value-union field read while the checker types it as one atom unboxes to that atom,
    // through the home the bare-arm twin uses: an index-rooted path has no member key, so
    // only that home's checker-typed arm sees `xs[0].r` under `!= null` (D8145).
    if variantFieldTypeAt(vi, idx) == FC_UNION {
      return emitUnionFieldNarrowUnbox(memIx, fnIx)
    }
    return 0
  }
  emitFail("emitProgram: expected a field access")
}

// Is the `?.` chain base at `exprIx` the one currently staged in `optRecvSlot`?
function optRecvStagedAt(exprIx: i32): boolean {
  if optRecvStagedIx < 0 { return false }
  optRecvStagedIx == unwrapParen(exprIx)
}

// Mark the base of the `?.` chain at `exprIx` for staging, when it is not a re-readable
// place. Writes no bytes: the first `emitOptRecvBase` tees the value in, so an arm that
// never re-reads the receiver — the fused map and `.get` forms — pays nothing.
function optRecvStageMark(exprIx: i32) {
  if !optChainStagesRecv(exprIx) { return 0 }
  const base = optChainBaseOf(exprIx)
  if base < 0 { return 0 }
  // Re-marking a base already teed in KEEPS the tee: the value is in the slot, and clearing
  // the flag would evaluate the receiver a second time (D1826).
  if optRecvStagedIx == base && optRecvStagedSet { return 0 }
  optRecvStagedIx = base
  optRecvStagedSet = false
  0
}

// The `?.` stash marker as one saved value, for a lowering that nests another chain inside
// this one. Paired with `optRecvStageRestore`, which is where the tee survives.
function optRecvStageSave(): i32[] {
  const sv: i32[] = []
  sv.push(optRecvStagedIx)
  sv.push(if optRecvStagedSet { 1 } else { 0 })
  sv
}

// Put back what `optRecvStageSave` took — except the tee, which SURVIVES when both scopes
// stage the same base: the inner lowering already left that value in the slot, and every
// later read of it is a `local.get` rather than a second evaluation of the receiver (D1826).
function optRecvStageRestore(sv: i32[]) {
  const wasSet = optRecvStagedSet && optRecvStagedIx == sv[0]
  optRecvStagedIx = sv[0]
  optRecvStagedSet = wasSet || sv[1] == 1
  0
}

// Push the `?.` chain base at `exprIx`: the stash when this chain stages it — teed in on the
// first read, which every arm emits unconditionally before the branch that reads it again —
// else the expression itself, byte for byte what an un-staged chain has always emitted.
// `asRef` casts the stash back to the base's own struct row; `ref.is_null` needs no cast.
function emitOptRecvBase(
  body: u8[],
  exprIx: i32,
  fnIx: i32,
  asRef: boolean,
  ec: ExpCtx,
) {
  if !optRecvStagedAt(exprIx) { return emitExpr(body, exprIx, fnIx, ec) }
  if optRecvStagedSet {
    fbLocalGet(optRecvSlot)
  } else {
    if !fnUsesOptRecv {
      return emitFailAt("emitProgram: `?.` receiver stash not reserved", exprIx)
    }
    if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
    fbLocalTee(optRecvSlot)
    optRecvStagedSet = true
  }
  if !asRef { return 0 }
  const sri = structIndexOfExpr(exprIx, fnIx)
  if sri < 0 {
    return emitFailAt(
      "emitProgram: a staged `?.` receiver names no struct row",
      exprIx,
    )
  }
  fbRefCast(sHeapIdx[sri])
  0
}

// How a struct field of storage code `code` encodes `null`, in `rdNul`'s vocabulary: 0 never
// null, 1 a null ref, 2 the boolean sentinel `2`, 3 the literal-union sentinel `-1`, 4 the
// box's null tag. A non-nullable struct field (code 15) answers 1: its slot is a nullable ref.
function optChainLeafNulDisc(code: i32): i32 {
  if code == FC_STRUCT || code == FC_NUL_STR || code == FC_NUL_CLOSURE {
    return 1
  }
  if code == FC_NUL_I32_LIST || code == FC_NUL_REF_LIST || code == FC_NUL_MAP {
    return 1
  }
  if nulScalarListFieldWrapHeap(code) >= 0 { return 1 }
  if code == FC_NUL_BOOL { return 2 }
  if code == FC_NUL_LIT_UNION { return 3 }
  if code == FC_UNION { return 4 }
  0
}

// Consume a field value of storage code `code` and push 1 when it is that field's `null`.
// Only called for a code `optChainLeafNulDisc` answers non-zero for.
function emitOptChainLeafNulTest(code: i32) {
  const disc = optChainLeafNulDisc(code)
  if disc == 1 { return fbRefIsNull() }
  if disc == 4 {
    fbStructGet(uBoxIdx, 0) // field 0: the tag
    fbI32Rel(RS_TAG, nullBoxTag())
    return fbI32Bin(70) // 0x46 i32.eq
  }
  if disc == 2 { fbI32Const(2) } else { fbI32Const(0 - 1) }
  fbI32Bin(70) // 0x46 i32.eq
}

// Push 1 if the optional-chain value at `exprIx` is null — any null link folds `null`
// through — else 0. A leaf whose field can hold `null` tests that field's own encoding of
// it (`optChainLeafNulDisc`); any other leaf is never null once every link held.
function emitOptChainIsNull(body: u8[], exprIx: i32, fnIx: i32, ec: ExpCtx) {
  const e = nodeAt(unwrapParen(exprIx))
  if e is OptMember {
    const psi = optChainStructIdxOf(e.omObj, fnIx)
    if psi < 0 {
      return emitFail("emitProgram: `?.` receiver is not a struct chain")
    }
    const pfi = sFieldIndex(psi, e.omProp)
    if pfi < 0 {
      return emitFail("emitProgram: `?.` field is not on the struct")
    }
    if emitOptChainIsNull(body, e.omObj, fnIx, ec) < 0 { return -1 }
    fbIf(127)
    fbI32Const(1)
    fbElse()
    const pfc = sFieldTypeAt(psi, pfi)
    if optChainLeafNulDisc(pfc) == 0 {
      fbI32Const(0)
    } else {
      if emitOptChainValue(body, e.omObj, fnIx, ec) < 0 { return -1 }
      fbStructGet(sHeapIdx[psi], pfi)
      emitOptChainLeafNulTest(pfc)
    }
    fbEnd()
    return 0
  }
  if emitOptRecvBase(body, exprIx, fnIx, false, ec) < 0 { return -1 }
  fbRefIsNull()
  0
}

// Push the non-null value of the optional-chain receiver at `exprIx`, assuming every link
// is already null-tested: each nullable link recovers `ref.as_non_null`. Sole-member
// niches only — a nullable box must not be recovered here, since this also feeds the `is`
// receiver and a `Shape | null` box is legitimately null at the moment its tag is tested.
function emitOptChainValue(body: u8[], exprIx: i32, fnIx: i32, ec: ExpCtx) {
  const e = nodeAt(unwrapParen(exprIx))
  if e is OptMember {
    const psi = optChainStructIdxOf(e.omObj, fnIx)
    if psi < 0 {
      return emitFail("emitProgram: `?.` receiver is not a struct chain")
    }
    const pfi = sFieldIndex(psi, e.omProp)
    if pfi < 0 {
      return emitFail("emitProgram: `?.` field is not on the struct")
    }
    if emitOptChainValue(body, e.omObj, fnIx, ec) < 0 { return -1 }
    fbStructGet(sHeapIdx[psi], pfi)
    fbRefAsNonNull()
    return 0
  }
  // The cast off the stash already recovers a non-null ref; the in-place spelling recovers
  // its own niche.
  if optRecvStagedAt(exprIx) {
    return emitOptRecvBase(body, exprIx, fnIx, true, ec)
  }
  if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
  if (
    exprNullableRefNiche(exprIx, fnIx)
    && !readOwesNonNullRecover(exprIx, fnIx)
  ) {
    fbRefAsNonNull()
  }
  0
}

// The heap type a `?.` leaf of field code `code` delivers as `F | null`: the field's OWN
// storage heap, read off the same table `pushFieldStorage` writes, so the value this arm
// builds and the slot it reads cannot name different types. -1 when the leaf's rep is not a
// ref — a scalar rides the box instead (`optChainLeafBoxKind`).
function optChainLeafRefHeap(code: i32, si: i32, fi: i32): i32 {
  // The nullable atom list (18) shares the i32 list's wrapper, as its field storage does.
  if code == FC_I32_LIST || code == FC_NUL_I32_LIST { return lTypeIdx }
  if code == FC_STR_LIST { return mkListIdx }
  if code == FC_F64_LIST { return fl64TypeIdx }
  if code == FC_I64_LIST { return il64TypeIdx }
  if code == FC_F32_LIST { return fl32TypeIdx }
  if code == FC_U8_LIST {
    if !ba8Used { return -1 }
    return bl8TypeIdx
  }
  if code == FC_REF_LIST || code == FC_NUL_REF_LIST {
    const rs = sFieldRefSlot(si, fi)
    if rs < 0 || rs >= rlWrapIdx.length { return -1 }
    return rlWrapIdx[rs]
  }
  const nsl = nulScalarListFieldWrapHeap(code)
  if nsl >= 0 { return nsl }
  -1
}

// The value-atom kind a `?.` leaf of field code `code` boxes as, for the `F | null` box the
// scalar nullables ride — `i32 | null` and `f64 | null` are the same rep with a different
// tag. -1 when the leaf is not a scalar the box speaks.
function optChainLeafBoxKind(code: i32): i32 {
  if code == FC_I32 { return 0 }
  if code == FC_F64 { return 4 }
  if code == FC_I64 { return 3 }
  if code == FC_F32 { return 5 }
  -1
}

// The four `.get` staging markers as one saved value, so a nested `.get` — one in a `?? d`
// default arm — restores the outer call's marker instead of losing it. Packed rather than
// four locals per site: the two indices are arena positions, the two flags are bits.
function listGetStageSave(): i32[] {
  const sv: i32[] = []
  sv.push(listGetIdxStagedIx)
  sv.push(if listGetIdxStagedSet { 1 } else { 0 })
  sv.push(listGetRecvStagedIx)
  sv.push(if listGetRecvStagedSet { 1 } else { 0 })
  sv
}

// Put back what `listGetStageSave` took.
function listGetStageRestore(sv: i32[]) {
  listGetIdxStagedIx = sv[0]
  listGetIdxStagedSet = sv[1] == 1
  listGetRecvStagedIx = sv[2]
  listGetRecvStagedSet = sv[3] == 1
  0
}

// Mark a `.get(i)` call's index and receiver for staging, each when it is not a re-readable
// place. Writes no bytes: the first read tees the value in, and every arm emits its bounds
// compare before the element read, so the tee dominates (D1677).
function listGetStageMark(callIx: i32) {
  const c = nodeAt(unwrapParen(callIx))
  if c is Call {
    const callee = nodeAt(unwrapParen(c.callFn))
    if callee is Member {
      if !optRecvReReadable(callee.memObj) {
        listGetRecvStagedIx = unwrapParen(callee.memObj)
        listGetRecvStagedSet = false
      }
      if c.callArgs.length == 1 {
        if !listGetIdxReReadable(c.callArgs[0]) {
          listGetIdxStagedIx = unwrapParen(c.callArgs[0])
          listGetIdxStagedSet = false
        }
      }
    }
  }
  0
}

// Push a `.get` index: the i32 stash when this call staged it, teed in on the first read,
// else the expression itself — byte for byte what an un-staged index has always emitted.
function emitListGetIdx(body: u8[], idxIx: i32, fnIx: i32, ec: ExpCtx) {
  if listGetIdxStagedIx < 0 || listGetIdxStagedIx != unwrapParen(idxIx) {
    return emitExpr(body, idxIx, fnIx, ec)
  }
  if listGetIdxStagedSet {
    fbLocalGet(listGetIdxSlot)
    return 0
  }
  if !fnUsesListGet {
    return emitFailAt("emitProgram: `.get` operand stash not reserved", idxIx)
  }
  if emitExpr(body, idxIx, fnIx, ec) < 0 { return -1 }
  fbLocalTee(listGetIdxSlot)
  listGetIdxStagedSet = true
  0
}

// Push a `.get` receiver: the `(ref null struct)` stash cast back to the list's own wrapper
// heap when this call staged it, else the expression itself. `heap` is that wrapper.
function emitListGetRecv(
  body: u8[],
  objIx: i32,
  fnIx: i32,
  heap: i32,
  ec: ExpCtx,
) {
  if listGetRecvStagedIx < 0 || listGetRecvStagedIx != unwrapParen(objIx) {
    if emitExpr(body, objIx, fnIx, ec) < 0 { return -1 }
    return svSyncRecv(objIx, fnIx)
  }
  if listGetRecvStagedSet {
    fbLocalGet(listGetRecvSlot)
  } else {
    if !fnUsesListGet {
      return emitFailAt("emitProgram: `.get` operand stash not reserved", objIx)
    }
    if emitExpr(body, objIx, fnIx, ec) < 0 { return -1 }
    svSyncRecv(objIx, fnIx)
    fbLocalTee(listGetRecvSlot)
    listGetRecvStagedSet = true
  }
  fbRefCast(heap)
  0
}

// Lower a standalone optional chain `recv?.f` — in ordinary value position (a `const`/`let`
// initializer, an argument, a `??` left side) — as the value of its own recorded type
// `F | null`. The shape is the fused `?? d` two-arm select with the default replaced by the
// null of the result's own rep, so the arms below dispatch on rep (`repOfNode`), not field.
function emitOptMemberValue(body: u8[], exprIx: i32, fnIx: i32, ec: ExpCtx) {
  const omSv = optRecvStageSave()
  optRecvStageMark(exprIx)
  const omR = emitOptMemberValueGo(body, exprIx, fnIx, ec)
  optRecvStageRestore(omSv)
  omR
}

// The standalone `?.` arms themselves, with the chain's base already staged when it needed
// staging, so every arm below may read the receiver as often as its rep requires.
function emitOptMemberValueGo(body: u8[], exprIx: i32, fnIx: i32, ec: ExpCtx) {
  const e = nodeAt(unwrapParen(exprIx))
  if e is OptMember {
    const osi = optChainStructIdxOf(e.omObj, fnIx)
    if osi < 0 {
      return emitFailAt(
        "emitProgram: `?.` receiver is not a struct chain",
        exprIx,
      )
    }
    const ofi = sFieldIndex(osi, e.omProp)
    if ofi < 0 {
      return emitFailAt("emitProgram: `?.` field is not on the struct", exprIx)
    }
    const oCode = sFieldTypeAt(osi, ofi)
    const oRefHeap = optChainLeafRefHeap(oCode, osi, ofi)

    // The nested-struct leaf (code 15), the arm the `?.` producer needs (D1084). `o?.f` over
    // `o: T | null` with `T = {f: S}` has type `S | null`, and the rep for that is the nullable
    // struct ref the whole `nulstruct` family already speaks.

    // Shape-identical to the `nulstr` arm below it, with the field's own target struct as the
    // heap type instead of the string array: a null receiver chain yields `ref.null $S`, a live
    // one reads the field. The `else` arm leaves a `(ref $S)`, a subtype of the block's
    // `(ref null $S)`, so the arms join without a cast. `structIndexOfExpr` is the other half.
    if oCode == FC_STRUCT {
      const oti = sFieldTgtStructIdx(osi, ofi)
      if oti < 0 {
        return emitFailAt(
          "emitProgram: `?.` yields a nullable struct whose field names no struct row",
          exprIx,
        )
      }
      if emitOptChainIsNull(body, exprIx, fnIx, ec) < 0 { return -1 }
      fbIfRefNul(sHeapIdx[oti], true)
      fbRefNull(sHeapIdx[oti])
      fbElse()
      if emitOptChainValue(body, e.omObj, fnIx, ec) < 0 { return -1 }
      fbStructGet(sHeapIdx[osi], ofi)
      fbEnd()
      return 0
    }

    // A LIST leaf, the code-15 arm one table over: `T[] | null` is the list wrapper's own
    // nullable ref, so a null link yields `ref.null $wrap` and a live one reads the field.
    // A nullable-list field is already `(ref null $wrap)`, which the same blocktype accepts.
    if oRefHeap >= 0 {
      if emitOptChainIsNull(body, exprIx, fnIx, ec) < 0 { return -1 }
      fbIfRefNul(oRefHeap, true)
      fbRefNull(oRefHeap)
      fbElse()
      if emitOptChainValue(body, e.omObj, fnIx, ec) < 0 { return -1 }
      fbStructGet(sHeapIdx[osi], ofi)
      fbEnd()
      return 0
    }
    // The leaf reps this arm can build, in the order the arms below take them: a nullable
    // REF (a list, a nested struct, a string), the scalar box (i32/boolean/f64/i64/f32),
    // and the value-union box. A map or closure leaf reaches neither and is named as such.
    if (
      oCode != FC_I32
      && oCode != FC_STR
      && oCode != FC_NUL_STR
      && oCode != FC_UNION
      && oCode != FC_NUL_BOOL
      && oCode != FC_NUL_LIT_UNION
      && optChainLeafBoxKind(oCode) < 0
      && oRefHeap < 0
    ) {
      return emitFailAt(
        "emitProgram: a standalone `?.` has no rep for a map or closure leaf field — read it through a `!= null` guard",
        exprIx,
      )
    }
    const ord = repOfNode(exprIx, fnIx)

    // `boolean | null` shares one unconditional i32 blocktype: the sentinel 2 (`null`) and
    // the live 0/1 result are the same valtype, so the two arms below need no cast to join.
    // `K | null` is the same shape over the literal union's atom, `-1` its null.
    if (
      (ord.rdKind == "nulbool" && ord.rdNul == 2)
      || (ord.rdKind == "i32" && ord.rdNul == 3)
    ) {
      if emitOptChainIsNull(body, exprIx, fnIx, ec) < 0 { return -1 }
      fbIf(127)
      if ord.rdNul == 2 { fbI32Const(2) } else { fbI32Const(0 - 1) }
      fbElse()
      if emitOptChainValue(body, e.omObj, fnIx, ec) < 0 { return -1 }
      fbStructGet(sHeapIdx[osi], ofi)
      fbEnd()
      return 0
    }

    // `i32 | null` (and a boxed code-16 leaf) rides the `{tag, payload}` box, `null` as the
    // null tag over an unread payload; both heap types are usage-gated against an uncollected union.
    // A wide scalar leaf rides the same box: `f64 | null` and `i32 | null` are one rep with
    // a different tag, so the kind comes from the leaf's own code and never from `i32`.
    const oBoxKind = optChainLeafBoxKind(oCode)
    if (
      oCode == FC_UNION
      || (ord.rdKind == "union" && ord.rdNul == 4)
      || (oBoxKind > 0 && ord.rdNul == 4)
    ) {
      let ovbKind = 0
      if oBoxKind > 0 { ovbKind = oBoxKind }
      const ovb = vbHeapIdxOfKind(ovbKind)
      if !uDeclared || (oCode != FC_UNION && ovb < 0) {
        return emitFailAt(
          "emitProgram: `?.` yields a nullable scalar but its union box was not collected",
          exprIx,
        )
      }
      if emitOptChainIsNull(body, exprIx, fnIx, ec) < 0 { return -1 }
      fbOpenIf()
      fbValtype("union", -1)
      fbI32Rel(RS_TAG, nullBoxTag())
      fbRefNullNone()
      fbStructNew(uBoxIdx)
      fbElse()
      if oCode == FC_UNION {
        if emitOptChainValue(body, e.omObj, fnIx, ec) < 0 { return -1 }
        fbStructGet(sHeapIdx[osi], ofi)
        fbEnd()
        return 0
      }
      fbI32Rel(RS_TAG, scalarTagOfKind(ovbKind))
      if emitOptChainValue(body, e.omObj, fnIx, ec) < 0 { return -1 }
      fbStructGet(sHeapIdx[osi], ofi)
      fbStructNew(ovb)
      fbStructNew(uBoxIdx)
      fbEnd()
      return 0
    }

    // `string | null` is the nullable raw-array ref niche, so a null link is `ref.null
    // $sTypeIdx` and a present one the field's own string — no box needed.
    if oCode == FC_NUL_STR || (ord.rdKind == "nulstr" && ord.rdNul == 1) {
      if !aUsed {
        return emitFailAt(
          "emitProgram: `?.` yields a nullable string but the string array type was not collected",
          exprIx,
        )
      }
      if emitOptChainIsNull(body, exprIx, fnIx, ec) < 0 { return -1 }
      fbIfRefNul(sTypeIdx, true)
      fbRefNull(sTypeIdx)
      fbElse()
      if emitOptChainValue(body, e.omObj, fnIx, ec) < 0 { return -1 }
      fbStructGet(sHeapIdx[osi], ofi)
      fbEnd()
      return 0
    }
    // A chain the hole instance pins non-null is the plain field read, at the field's own rep (D3215).
    if tyProvesNonNull(nodeTyAt(exprIx, fnIx)) {
      if emitOptChainValue(body, e.omObj, fnIx, ec) < 0 { return -1 }
      fbStructGet(sHeapIdx[osi], ofi)
      return 0
    }
    return emitFailAt(
      "emitProgram: a standalone `?.` has no rep for this result type — read it through `?? d` or a `!= null` guard",
      exprIx,
    )
  }
  emitFailAt("emitProgram: expected an optional-chain member access", exprIx)
}

// Does the function being emitted declare type parameters? The dead-atom elision is
// bounded to these: only a generic instance can carry an `is` arm the instantiation makes
// constant-false, and only there is the name-keyed union lookup single-valued.
function fnHasTyParams(fnIx: i32): boolean {
  const fp = fnStmtsPosOf(fnIx)
  if fp < 0 { return false }
  if fp >= fnStmts.length { return false }
  const f = nodeAt(fnStmts[fp])
  if f is FuncDecl {
    if f.fnTyParams.length > 0 { return true }
  }
  // A monomorphized instance has no type params of its own — `mkFunc(instName, noTyParams, …)`
  // strips them — so the instance must be recognised through its template. Without this the
  // bound never fires for the very shape it exists to admit.
  if fp < monoOrigNode.length {
    const o = monoOrigNode[fp]
    if o >= 0 {
      const of = nodeAt(o)
      if of is FuncDecl { return of.fnTyParams.length > 0 }
    }
  }
  false
}

// Push the raw union box ref of binding `name` (a local, param or module global), bypassing
// the narrowed-unbox Ident path so a tag read works even while the binding is narrowed to a
// single atom — its slot still holds the box, narrowing being type-level only.
function emitUnionBoxPush(_body: u8[], name: string, fnIx: i32, ec: ExpCtx) {
  const idx = localIndexOf(fnIx, name)
  if idx >= 0 {
    fbLocalGet(idx)
  } else {
    // A captured union box: read the field raw out of the env (`recover` false — the box is
    // the field's type, and the unbox every caller appends after this push is the recovery).
    // The narrowing that makes such a read an unbox is the closure's declaration-site
    // narrowing, replayed onto the narrowing stack by `capNarrowSeed`.
    if emitCapturedRead(_body, name, fnIx, false, ec) == 1 { return 0 }
    const gIdx = globalIndexOf(name)
    if gIdx < 0 {
      // Neither a local, a capture of this frame, nor a global — nothing to read the box
      // out of. A clean reject, not invalid wasm.
      return emitFail(
        "emitProgram: narrowed union binding is not a local or global",
      )
    }
    if emitUserGlobalGet(gIdx) < 0 { return -1 }
    // A non-const global box rides in a NULLABLE cell (start-fn initialized);
    // recover the non-null box ref (same as the plain Ident global read).
    if globalNameIsNonConst(name) { fbRefAsNonNull() }
  }
  0
}

// The list wrapper heap type a value-union list atom of kind `k` rides in the box's `anyref`
// payload — directly, with no scalar value box (the `is`-narrow casts to it, the coerce stores
// it) — or -1 when `k` is not a list kind.

// Keyed on the atom's kind, not on its rendered spelling: kind 7 is exactly the i32-list
// backings (`i32[]`, `boolean[]`, a litunion `K[]`, the `(boolean | null)[]` and `(K | null)[]`
// niches), kind 9 exactly the string-list backings, and kinds 8 / 10 / 12 arise only from the
// spellings `f64[]` / `i64[]` / `f32[]`. The caller already needs the kind for its tag.
function listWrapHeapOfKind(k: i32) {
  if k == 7 { return lTypeIdx }
  // A boolean list rides the i32 list; its tag code exists only once a union registered it.
  if k == 17 || k == 18 {
    if vbBoolListTop < 0 { return -1 }
    return lTypeIdx
  }
  if k == 8 { return fl64TypeIdx }
  if k == 9 { return mkListIdx }
  if k == 10 { return il64TypeIdx }
  if k == 12 { return fl32TypeIdx }
  // The packed byte list rides the box's anyref as its own `{backing, len, cap}` wrapper like
  // the five above; only its backing's element is the packed `i8` storage type. `ba8Used` is
  // the guard, not a convenience: `uAtomBandTop` lifts the slot bands off it, so a kind-13 tag
  // without it collides with `refArrSlotTag(0)` and names a heap type the module never interned.
  if k == 13 {
    if !ba8Used { return -1 }
    return bl8TypeIdx
  }
  -1
}

// The banked value-atom kind of the single member left when `null` is removed from the member
// set `s` — the structural form of `valueAtomKind(removeAtomFromSet(set, "null"))`, which four
// `… | null` peeling sites ask. `msSubNull` clears the null members' bits structurally, so the
// residual set keeps its identity rather than being rendered and re-parsed for the ABI code.

// A singleton yields the member's kind straight out of the bank `recordUnMemTys` filled, a
// non-singleton -1, and -2 means the pool does not cover the set — a narrowed subset spelling
// it never interned — so the caller keeps its rendered-atom path. Takes a set id, never a text.
function unionResidualSoloKindOfSet(s: i32) {
  if s < 0 { return -2 }
  msSoloValKind(msSubNull(s))
}

// Is this union a value union — the box question, asked of the interned member set the caller
// already resolved, and of the spelling only where the pool declines. `msIsValueUnion` reads
// the member ABI codes off the bank, where the name path scans the whole rendering twice and
// materializes every atom for the same predicate.

// The caller resolves the set id. The name fallback resolves a declared
// alias first — `isValueUnionName` splits at top-level `|`, so `type WN = N | string` is one
// atom of kind -1 and answers no where the inline spelling answers yes.
function isValueUnionOfSet(s: i32, nm: string): boolean {
  const v = msIsValueUnion(s)
  if v >= 0 { return v == 1 }
  isValueUnionName(unionMemberSetOf(nm))
}

// True if a value-union atom of kind `k` is a ref that rides the box's anyref `value` directly
// with no per-rep scalar value box: a string (kind 2 — `valueAtomKind` answers 2 for the
// spelling `string` and nothing else), any list type, or a closure (kind 11 — the fat-pointer
// struct is a `structref` subtype, so it stores into the box's anyref slot as-is).
function atomIsRefKind(k: i32) {
  if k == 2 { return true }
  if k == 11 { return true }
  return listWrapHeapOfKind(k) >= 0
}

// Lower a narrowed value-union ident read `name` (active narrowing = a single scalar member,
// arriving as its ABI kind `ak`): push the box, `struct.get $box 1` for the `anyref` payload,
// then recover the atom's rep — a `ref.cast (ref $sTypeIdx)` for a string payload, stored
// unboxed, or a `ref.cast (ref $vb)` plus `struct.get $vb 0` for a scalar in its value box.
function emitValueUnionUnboxRead(
  body: u8[],
  name: string,
  ak: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitUnionBoxPush(body, name, fnIx, ec) < 0 { return -1 }
  emitUnionUnboxTail(ak)
}

// Read the name, field or cell at `exprIx`, narrowed under `key` to `A | null` for `A` of atom
// kind `ak` (1 boolean, 2 string), as that niche: read once with the narrowing lifted, which
// delivers the union box, park it, and turn its null tag into the niche's null and any other
// tag into the unboxed payload (D2590).
function emitNarrowedNicheRead(
  body: u8[],
  exprIx: i32,
  key: string,
  ak: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const masked = maskNarrowFor(key)
  const rc = emitExpr(body, exprIx, fnIx, ec)
  unmaskNarrow(masked)
  if rc < 0 { return -1 }
  const st = nicheReadStashSlot()
  fbLocalSet(st)
  fbLocalGet(st)
  fbStructGet(uBoxIdx, 0) // field 0: the tag
  fbI32Rel(RS_TAG, nullBoxTag())
  fbI32Bin(70) // 0x46 i32.eq
  if ak == NICHE_NUL_LIT {
    const texts = nulLitMemberTexts(instanceReadTyOf(exprIx, fnIx))
    if texts.length == 0 {
      return emitFail(
        "emitProgram: nullable literal-union read with no members",
      )
    }
    fbIf(127) // 0x04 if, 0x7f i32 result blocktype
    fbI32Const(0 - 1) // the null sentinel
    fbElse()
    const nicheSaved = expCtxHere(ec)
    const nicheIn = expCtxHere(ec)
    nicheIn.litUnion = 0
    nicheIn.nulLitUnion = false
    expCtxApply(nicheIn, ec)
    const rc3 = emitStashedStrToAtomChain(body, st, texts, 0, fnIx, ec)
    const nicheOut = expCtxHere(ec)
    nicheOut.litUnion = nicheSaved.litUnion
    nicheOut.nulLitUnion = nicheSaved.nulLitUnion
    expCtxApply(nicheOut, ec)
    if rc3 < 0 { return -1 }
    fbEnd()
    return 0
  }
  if ak == 1 {
    fbIf(127) // 0x04 if, 0x7f i32 result blocktype
    fbI32Const(2) // the null sentinel
  } else {
    fbIfRefNul(sTypeIdx, true) // if (result (ref null $sTypeIdx))
    fbRefNull(sTypeIdx)
  }
  fbElse()
  fbLocalGet(st)
  if emitUnionUnboxTail(ak) < 0 { return -1 }
  fbEnd()
  0
}

// Whether `exprIx` is a value box whose every arm is a string, a literal union or `null`
// (`K | L | null`), which a `string | null` destination reads as its niche (D3382).
function boxIsNulStrUnion(exprIx: i32, fnIx: i32): boolean {
  if !exprUnion(exprIx, fnIx) { return false }
  // Inside an instance a parameter's recorded type is the type variable; ask its pin.
  const pinned = exactOperandTyOf(exprIx, fnIx)
  if pinned >= 0 { return tyIsNulStrBoxUnion(pinned) }
  const own = nodeTyIxOf(unwrapParen(exprIx))
  if tyIsNulStrBoxUnion(own) { return true }
  tyIsNulStrBoxUnion(pinSubOperandTyOf(own, fnIx))
}

// The box on the stack as `string | null`: the null tag is `ref.null`, any other arm's payload
// is the string itself (D3382).
function emitBoxToNulStr() {
  const st = nicheReadStashSlot()
  fbLocalSet(st)
  fbLocalGet(st)
  fbStructGet(uBoxIdx, 0) // field 0: the tag
  fbI32Rel(RS_TAG, nullBoxTag())
  fbI32Bin(70) // 0x46 i32.eq
  fbIfRefNul(sTypeIdx, true)
  fbRefNull(sTypeIdx)
  fbElse()
  fbLocalGet(st)
  emitUnionUnboxTail(2)
  fbEnd()
  0
}

// The unbox, from a box already on the stack. Extracted from `emitValueUnionUnboxRead` so the
// union `as` cast — whose operand is an expression, not a named binding, and so cannot use
// `emitUnionBoxPush` — recovers an arm the same way a narrowed read does. Two ladders would be
// two chances to disagree about a payload's rep, which in this area is invalid wasm.

// The atom's ABI code decides all four arms (the `string` compare, the closure test, the
// list-wrapper ladder, `vbHeapIdxOfKind`), so `ak` arrives as the code: `emitCoalesce` holds it
// out of the bank rather than rendering a set to be re-parsed here.
function emitUnionUnboxTail(ak: i32) {
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  if ak == 2 {
    fbRefCast(sTypeIdx) // the payload IS the string array ref
    return 0
  }
  // A CLOSURE atom's payload IS the closure fat-pointer struct — recover it from the box's
  // anyref slot so a narrowed `x is (() => i64)` read yields the callable fat pointer.
  if ak == 11 {
    fbRefCast(cloStructIdx)
    return 0
  }
  const lw = listWrapHeapOfKind(ak)
  if lw >= 0 { return emitListPayloadCast(lw) }
  const vb = vbHeapIdxOfKind(ak)
  if vb < 0 {
    return emitFail("emitProgram: narrowed union atom has no value box")
  }
  fbRefCast(vb)      // 0xfb 0x16 <value box>
  fbStructGet(vb, 0) // the scalar payload
  0
}

// The container half of a place-narrowed union read, from a box already on the stack — the
// member/index place dual of `emitRefArrayUnionUnboxRead` and `emitMapUnionUnboxRead`, which
// both push the box themselves from a name. 1 = a recovery is emitted, 0 = the place carries no
// live container narrowing and the caller leaves the box alone, -1 = a recorded failure.

// The heap type comes from the classifier the consumer already asked, not from a second
// derivation off the narrow stack: `refListSlotOfExprStrict` and `mapShapeOfExpr` are the
// functions `forInElemKind`, `emitIndex` and `emitMapPrep` type themselves against, so a
// delivery casting to a different row than the consumer expects is not expressible here.
function emitPlaceNarrowContainerUnbox(exprIx: i32, fnIx: i32): i32 {
  const con = placeReadContainerAt(exprIx, fnIx)
  if con == RC_REF_LIST {
    const slot = refListSlotOfExprStrict(exprIx, fnIx)
    if slot < 0 || slot >= rlWrapIdx.length {
      return emitFail(
        "emitProgram: narrowed union place ref-array arm has no reflist slot",
      )
    }
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    emitListPayloadCast(rlWrapIdx[slot])
    return 1
  }
  if con == RC_MAP {
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    // `mapShapeOfExpr` answers the mono sentinel -1 for an atom-valued map exactly as the
    // name resolver does, and `mapTypeIdxOf(-1)` is the shared `$mStructIdx` — so the miss
    // and the hit agree here for the same reason they do in `emitMapUnionUnboxRead`.
    fbRefCast(mapTypeIdxOf(mapShapeOfExpr(exprIx, fnIx)))
    return 1
  }
  0
}

// Recover the reflist wrapper ref a union binding read as a ref-element list holds (`x[i]` or
// `x.length` under `if x is S[]`): push the box, read its `anyref` value (field 1), `ref.cast`
// it to the wrapper of the row the read's consumer types itself against.
function emitRefArrayUnionUnboxRead(
  body: u8[],
  name: string,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitUnionBoxPush(body, name, fnIx, ec) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  const slot = refListSlotOfExprStrict(exprIx, fnIx)
  if slot < 0 || slot >= rlWrapIdx.length {
    return emitFail("emitProgram: narrowed ref-array arm has no reflist slot")
  }
  emitListPayloadCast(rlWrapIdx[slot])
}

// Set while a `.push` receiver is emitted: an append into a stand-in empty list would be lost,
// so a push keeps the plain cast and traps loudly instead (D4949).
let listCastForPush = false

// The box's `anyref` payload on the stack, as the list wrapper `wrap` a narrowed read expects.
// An `is L` fits an empty list of another list arm (D4771), and a capture, field or element
// cannot be re-boxed as `L`, so a payload of another wrapper reads as an empty `L` (D4939).
function emitListPayloadCast(wrap: i32) {
  const back = listBackOfWrap(wrap)
  if back < 0 || listCastForPush {
    fbRefCast(wrap)
    return 0
  }
  const st = listPayloadStashSlot()
  fbLocalTee(st)
  fbRefTest(wrap)
  fbIfRef(wrap)
  fbLocalGet(st)
  fbRefCast(wrap)
  fbElse()
  fbBacking(back, 0)
  fbI32Const(0)
  fbI32Const(0)
  fbStructNew(wrap)
  fbEnd()
  0
}

// Recover the map struct ref a union binding narrowed to a map arm holds (`x[k]` or `x.has(k)`
// under an `is` guard naming the map arm): push the box, read its `anyref` value (field 1),
// `ref.cast` to the arm's per-value map struct heap (`mapTypeIdxOf`; its key's mono struct for
// an i32 or atom value). The result is the `(ref $mapStruct)` a bare map binding pushes.
function emitMapUnionUnboxRead(
  body: u8[],
  name: string,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitUnionBoxPush(body, name, fnIx, ec) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  // The arm's map-value slot, the one `mapShapeOfExpr` types this read's consumer against.
  fbRefCast(mapTypeIdxOf(mapShapeOfExpr(exprIx, fnIx))) // the payload IS the map struct ref
  0
}

// An empty `[]` into a union with no `i32[]` arm, built and tagged as the list arm the checker
// adopted it as. The value-atom ladder classifies every empty literal `i32[]` and re-maps only
// onto the scalar-list arms, so a string or ref-list arm got the i32 backing (D2202).
// Returns 1 = handled, 0 = not applicable, -1 = error.
function emitEmptyArrUnionArm(
  body: u8[],
  unionName: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if unionName == "" { return 0 }
  const bare = nodeAt(unwrapParen(exprIx))
  if bare is ArrayLit {
    if bare.arrElems.length != 0 { return 0 }
  } else {
    return 0
  }
  if unionHasAtomTy(unionName, "i32", true) { return 0 }
  const k = emptyArrUnionArmKind(exprIx)
  let tag = -1
  if k == "strlist" {
    tag = scalarTagOfKind(9) // "string[]", the tag a `(string | null)[]` arm shares
  } else if k == "reflist" {
    const slot = emptyArrUnionArmSlot(exprIx)
    if !unionHasRefArrayArmSlot(unionName, slot) { return 0 }
    tag = refArrBoxTagOf(exprIx, fnIx, slot, unionName, unionTy)
  }
  if tag < 0 { return 0 }
  fbI32Rel(RS_TAG, tag)
  const rc = emitExpr(body, exprIx, fnIx, ec)
  if rc < 0 { return -1 }
  fbStructNew(uBoxIdx) // { tag, list-wrapper ref }
  1
}

// Route a list literal flowing into a union whose matching arm is a union-box-element
// ref-array (`(i32 | string)[] | {w: i32}`) through that arm's build: the literal builds at
// the arm's slot, boxing each element, and the wrapper is tagged with the arm's slot tag.

// Needed because the literal's own classification is a scalar list or a concrete struct list,
// neither of which interns the arm's slot, so `emitUnionCoerce`'s slot-match path misses. The
// union's own value-atom list arm still wins, guarded by `unionHasAtom`. Returns 1 = handled,
// 0 = not applicable, -1 = error.
function emitUnionListLitViaRefArm(
  body: u8[],
  unionName: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if unionName == "" { return 0 }
  const bare = nodeAt(unwrapParen(exprIx))
  if bare is ArrayLit {
    // Classify the FIRST element's member ATOM (the arm-choice key; each element still
    // coerces independently inside the build). An element this static probe cannot name
    // (a nested list / map) bails to the caller's existing paths.
    let elemAtom = ""
    // Hoisted: the empty-`[]` branch below shares the arm-slot resolution at the bottom.
    let selfArm = false
    let selfSlot = 0 - 1
    if bare.arrElems.length >= 1 {
      const e0 = bare.arrElems[0]
      // D1016 — a nested list or map element is unnameable by the probe above, and a
      // self-referential union has exactly the arm that admits it: `Json[]`'s element type is
      // `Json` itself, so every element is a legal member and the arm's build boxes it as
      // one, the same recursive step the annotated binding performs. No such arm: bail.
      if exprArray(e0, fnIx) || exprRefArray(e0, fnIx) || exprMap(e0, fnIx) {
        selfSlot = unionRefArrayArmSlotForNestedElem(
          unionName,
          exprMap(e0, fnIx),
        )
        if selfSlot < 0 { return 0 }
        selfArm = true
      }
      if selfArm {
        // the arm is already chosen — the value-atom ladder below must not reclaim it
      } else if exprString(e0, fnIx) {
        elemAtom = "string"
      } else if exprIsBool(e0, fnIx) {
        elemAtom = "boolean"
      } else if exprIsF64(e0, fnIx) {
        elemAtom = "f64"
      } else if exprIsI64(e0, fnIx) {
        elemAtom = "i64"
      } else {
        const e0b = nodeAt(unwrapParen(e0))
        if e0b is ObjLit {
          elemAtom = objVariantName(unwrapParen(e0))
          if elemAtom == "" { return 0 }
        } else {
          elemAtom = "i32" // the ladder's own integer default
        }
      }
      // The union's own value-atom LIST arm is the exact match — let the ladder box it.
      // Not for the self-referential arm: `Json` names the union, and asking whether it has
      // a `Json[]` value atom is asking about the arm we just picked.
      if !selfArm {
        if unionHasAtomTy(unionName, elemAtom, true) { return 0 }
      }
    } else {
      // An EMPTY `[]`: only route when NO value-atom list arm could claim it.
      if (
        unionHasAtomTy(unionName, "i32", true)
        || unionHasAtomTy(unionName, "boolean", true)
        || unionHasAtomTy(unionName, "string", true)
        || unionHasAtomTy(unionName, "f64", true)
        || unionHasAtomTy(unionName, "i64", true)
        || unionHasAtomTy(unionName, "f32", true)
      ) {
        return 0
      }
    }
    let armSlot = unionRefArrayArmSlotForElem(unionName, elemAtom)
    if selfArm { armSlot = selfSlot }
    if armSlot < 0 { return 0 }
    const armTag = refArrBoxTagOf(exprIx, fnIx, armSlot, unionName, unionTy)
    if armTag < 0 {
      return emitFail("emitProgram: boolean list arm has no tag")
    }
    fbI32Rel(RS_TAG, armTag)
    const armBuild: ListBuild = { lbKind: LBK_UNION, lbSlot: armSlot }
    const rc = emitArrAt(body, unwrapParen(exprIx), fnIx, armBuild, ec)
    if rc < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
    return 1
  }
  0
}

// Route an array-literal union carrier into the union's single nested-array arm
// (`string[][] | string`, `i64[][] | boolean | null` — `unionNestedArrayArmSlot`): tag with the
// arm's slot and build the literal at the arm's type, which the checker stamped on it.

// Each inner list then builds the arm's leaf: an `i64[][]` arm widens bare-int leaves at the
// store, and a `string[][]` arm builds string inner lists, which `exprRefArray` cannot see so
// the ref-array carrier path misses them. Returns 1 when routed, 0 when the union has no
// unambiguous nested-array arm and the caller keeps its loud reject, -1 on a failure.
function emitUnionNestedListLit(
  body: u8[],
  unionName: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const bare = nodeAt(unwrapParen(exprIx))
  if bare is ArrayLit {
    const armSlot = unionNestedArrayArmSlot(unionName)
    if armSlot < 0 { return 0 }
    const nestTag = refArrBoxTagOf(exprIx, fnIx, armSlot, unionName, unionTy)
    if nestTag < 0 {
      return emitFail("emitProgram: boolean list arm has no tag")
    }
    fbI32Rel(RS_TAG, nestTag)
    const rc = emitExpr(body, exprIx, fnIx, ec)
    if rc < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
    return 1
  }
  0
}

// The function type a closure carrier boxed into `unionName` tags as — the box side of
// `cloArmTagOfTy`, whose test side is `isArmTagOfTy`.

// The value's own checked type is the answer, not the union's arm: a union may carry several
// function-typed arms, and taking the arm makes every one of them box under the first arm's tag
// (D6). The union's own arm is the fallback, for a carrier the checker banked no function type
// for; a union with one function arm tags the same either way.
function cloBoxArmTy(exprIx: i32, unionName: string, fnIx: i32): i32 {
  const vt = nodeTyAt(exprIx, fnIx)
  if tyIxIsFunc(vt) { return vt }
  const bt = nodeTyAt(unwrapParen(exprIx), fnIx)
  if tyIxIsFunc(bt) { return bt }
  unionClosureArmTy(unionName)
}

// `emitUnionCoerce` lowers an expression coerced into the boxed union's representation (a
// binding init, an assignment, an argument, a return): pass-through when the value already is
// the box, a bare `null` as the null tag over a `ref.null` payload, a raw scalar or string as
// its atom's tag and payload, an object literal through `emitUnionBox`'s `uDeclared` path.

// The tag a map of shape `sh` is BOXED under. An integer-keyed mono map tags above the
// value-atom band only in a module whose collect pass saw it as a union arm, so a box built
// without that mark is refused here rather than tagged into the band below.
function mapBoxTag(sh: i32): i32 {
  const s = mapShapeFoldSet(sh)
  if (s == -4 || s == -6) && !mIntMonoArmUsed {
    return emitFail(
      "emitProgram: an integer-keyed map union arm was not collected",
    )
  }
  mapSlotTag(s)
}

// The tag the map value `exprIx` of shape `sh` boxes under in `unionName`. Where two map types
// of the module's unions share that struct (D2493), each owns a tag, so the member is chosen by
// TYPE: the union's one arm of the shape, else the arm the value's static type is.
function mapBoxTagOf(
  sh: i32,
  unionName: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
): i32 {
  const s = mapShapeFoldSet(sh)
  if !mapShapeTwinned(s) { return mapBoxTag(s) }
  const vt = mapValueTyOf(exprIx, fnIx)
  let arm = -1
  let only = -1
  let n = 0
  const atoms: string[] = []
  const mems: i32[] = []
  if unionSetArmTysAB(106, unionName, unionTy, atoms, mems) {
    let i = 0
    while i < mems.length {
      const m = mems[i]
      if (
        unMemIsMap(m)
        && mapTwinOneStruct(mapShapeFoldSet(mapArmShapeOfTy(m)), s)
      ) {
        // Members the same type count once: `A | B` over two equal maps is one member.
        if only < 0 || !mapTwinSame(only, m) { n = n + 1 }
        only = m
        if vt >= 0 && mapTwinSame(m, vt) { arm = m }
      }
      i = i + 1
    }
  }
  if arm < 0 && n == 1 { arm = only }
  if arm < 0 && n == 0 { arm = vt }
  const tag = mapArmTagOfTy(arm, s)
  if tag < 0 {
    return emitFailAt(
      "emitProgram: a map value's union arm cannot be told from another map of its representation",
      exprIx,
    )
  }
  tag
}

// D1029 — the map arm's re-box: the arm's tag, the map ref, one `struct.new`. Returns 1
// handled, 0 not a map arm, -1 on error. A value narrowed to the union's map arm reads unboxed
// in that scope, so delivering it to a destination typed at the union has to put the box back.
// One home, because a map-value store reaches only `emitUnionBoxArg`, not `emitUnionCoerce`.
function emitUnionMapArmBox(
  body: u8[],
  unionName: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if unionName == "" { return 0 }
  // A value `if` boxes arm by arm (`emitUnionCoerce`'s join): its two arms may be two members.
  if nodeAt(unwrapParen(exprIx)) is IfStmt { return 0 }
  let nullable = false
  if !exprMap(exprIx, fnIx) {
    if !exprNullableMap(exprIx, fnIx) { return 0 }
    nullable = true
  }
  const sh = mapShapeOfExpr(exprIx, fnIx)
  if !unionHasMapArmSlot(unionName, unionTy, sh) { return 0 }
  const tag = mapBoxTagOf(sh, unionName, unionTy, exprIx, fnIx)
  if tag < 0 { return -1 }
  if nullable {
    return emitNulMapArmBox(body, tag, exprIx, "", -1, -1, fnIx, ec)
  }
  fbI32Rel(RS_TAG, tag)
  if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
  fbStructNew(uBoxIdx) // { tag, map struct ref }
  1
}

// A `M | null` value into a box holding `M`: the map arm's box, or when the value is null the
// null-tagged box, or `defIx` boxed into `unionName` for a `??` (D2666). The tag rides under
// the value into `br_on_null`, so the value is read once and no scratch slot is needed.
function emitNulMapArmBox(
  body: u8[],
  tag: i32,
  exprIx: i32,
  unionName: string,
  unionTy: i32,
  defIx: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  fbBlockRefNul(uBoxIdx, false) // (ref $uBox) blocktype
  fbBlock(127) // i32: the tag, carried out when the value is null
  fbI32Rel(RS_TAG, tag)
  const nmCtx = expCtxHere(ec)
  nmCtx.rawNullRead = true
  if emitExprExpect(body, exprIx, fnIx, nmCtx) < 0 { return -1 }
  fbBrOnNull(0)
  fbStructNew(uBoxIdx) // { tag, map struct ref }
  fbBr(1)
  fbEnd()
  fbDrop()
  if defIx >= 0 {
    if emitUnionBoxArg(body, unionName, unionTy, defIx, fnIx, ec) < 0 {
      return -1
    }
  } else {
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone()
    fbStructNew(uBoxIdx) // { null tag, unread }
  }
  fbEnd()
  1
}

// `l ?? d` whose left is a nullable map and whose result is a union box holding that map, as a
// join of two map types is: the left's arm box, else `d` boxed. 1 handled, 0 not this shape.
function emitCoalesceMapJoin(
  body: u8[],
  e: BinExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if !exprNullableMap(e.binLeft, fnIx) { return 0 }
  const un = coalesceResultUnionName(exprIx)
  if un == "" { return 0 }
  const unTy = nodeTyPinIxOf(exprIx)
  const sh = mapShapeOfExpr(e.binLeft, fnIx)
  if !unionHasMapArmSlot(un, unTy, sh) { return 0 }
  const tag = mapBoxTagOf(sh, un, unTy, e.binLeft, fnIx)
  if tag < 0 { return -1 }
  emitNulMapArmBox(
    body,
    tag,
    e.binLeft,
    un,
    nodeTyPinIxOf(exprIx),
    e.binRight,
    fnIx,
    ec,
  )
}

// Whether `unionName`, typed `unionTy` (-1 when unknown), is a box-represented union (a non-null
// value atom beside another member) that has no registry row, so no arm of it can be tagged.
function unionBoxHasNoRow(unionName: string, unionTy: i32): boolean {
  if unionName == "" || unionRowKeyAB(84, unionName, unionTy) >= 0 {
    return false
  }
  const atoms: string[] = []
  unionSetAtomsOf(unionName, atoms)
  if atoms.length < 2 { return false }
  for a in atoms {
    const k = valueAtomKind(a)
    if k >= 0 && k != 6 { return true }
  }
  false
}

// Whether `x is chk` answers right for a value of arm `other` boxed under `chk`'s tag: every
// such value fits `chk`, or the list test reads the elements (`emitListIsAcrossReps`).
function armTagTestHolds(chk: i32, other: i32): boolean {
  if tyFitKind(other, chk) == 1 { return true }
  if tyArrayElemIx(chk) < 0 || tyArrayElemIx(other) < 0 { return false }
  if listArmFitAcrossReps(other, chk) != 0 { return true }
  listArmSharedTagFit(other, chk, []) != 0
}

// The refusal for a box into the union typed `unionTy` (else row `unionName`) where two members
// claim one box tag (`isArmTagOfTy`) and an `is` over one would answer wrong for the other; ""
// when none do. Record and literal members are tagged elsewhere.
function unionArmTagClash(unionName: string, unionTy: i32): string {
  const mems: i32[] = []
  if unionTy >= 0 && tyAt(unionTy) is TyUnion {
    flattenVariantsInto(unionTy, mems)
  } else if !unionMemberTysOf(unionName, mems) {
    return ""
  }
  const tags: i32[] = []
  for m in mems { tags.push(isArmTagOfTy(m)) }
  let i = 0
  while i < mems.length {
    let j = i + 1
    while j < mems.length {
      if (
        tags[i] >= 0
        && tags[i] == tags[j]
        && (!armTagTestHolds(mems[i], mems[j])
          || !armTagTestHolds(mems[j], mems[i]))
      ) {
        return "emitProgram: union members `"
          + tyToStr(mems[i])
          + "` and `"
          + tyToStr(mems[j])
          + "` share one box tag, so `is` could not tell them apart"
      }
      j = j + 1
    }
    i = i + 1
  }
  ""
}

// Coerces the value of `exprIx` into the box of union `unionNameIn`. The caller's context is
// restored on every exit.
export function emitUnionCoerce(
  body: u8[],
  unionNameIn: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const saved = expCtxHere(ec)
  expCtxLeave(
    saved,
    emitUnionCoerceUnder(body, unionNameIn, unionTy, exprIx, fnIx, ec),
    ec,
  )
}

// `emitUnionCoerceUnder`'s arm for a ref-element array carrier entering `unionName`: the
// wrapper rides the box under its arm's slot tag, or the literal rebuilds through a matching
// arm. Returns 0, or -1 once failed; with no arm to carry it the failure is loud.
function emitUnionCoerceRefArray(
  body: u8[],
  unionName: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const raSlot = refListSlotOfExpr(exprIx, fnIx)
  if unionHasRefArrayArmSlot(unionName, raSlot) {
    const raTag = refArrBoxTagOf(exprIx, fnIx, raSlot, unionName, unionTy)
    if raTag < 0 { return emitFail("emitProgram: boolean list arm has no tag") }
    fbI32Rel(RS_TAG, raTag)
    if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
    return 0
  }
  // A ref-array LITERAL whose own slot mismatches (`[{a:1}]` self-classifies as the
  // concrete `C[]` while the arm is `(C | D)[]`): route it through the union-box-element
  // arm's build if one admits its element.
  const viaArm = emitUnionListLitViaRefArm(
    body,
    unionName,
    unionTy,
    exprIx,
    fnIx,
    ec,
  )
  if viaArm < 0 { return -1 }
  if viaArm == 1 { return 0 }
  // A ref-array LITERAL whose interned slot matches no arm but whose union has ONE
  // nested-array arm (`[[50183]]` self-classified `i32[][]` into `i64[][] | boolean |
  // null`): rebuild it through the ARM's slot — the arm's inner-list build widens the
  // bare-int leaves at the store (`emitExprAsI64`), so no in-place re-encode is needed.
  const viaNest = emitUnionNestedListLit(
    body,
    unionName,
    unionTy,
    exprIx,
    fnIx,
    ec,
  )
  if viaNest < 0 { return -1 }
  if viaNest == 1 { return 0 }
  // A ref-element array carrier whose interned slot matches no ref-array arm of the union:
  // a non-literal carrier whose built leaves cannot re-encode in place, or an ambiguous or
  // absent arm. A ref array can only ride the box as a wrapper ref, so with no arm to carry
  // it there is no sound rep — fail loudly rather than mis-box it through the scalar ladder.
  return emitFail(
    "emitProgram: array value does not match any array member of the union (leaf-scalar widening across a nested array is unsupported)",
  )
}

// `emitUnionCoerceUnder`'s arm for a list literal `bare` whose first element is a map: built
// through the array-of-map arm, else the arm whose element union carries a map atom.
// Returns 0, or -1 once failed; with neither arm the failure is loud.
function emitUnionCoerceMapElemList(
  body: u8[],
  unionName: string,
  bare: ArrayLit,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const mapArmSlot = unionRefArrayArmSlotForMapElem(
    unionName,
    mapShapeOfExpr(bare.arrElems[0], fnIx),
  )
  if mapArmSlot >= 0 {
    fbI32Rel(RS_TAG, refArrSlotTag(mapArmSlot))
    if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
    return 0
  }
  // D1016 — before refusing, try the arm whose element is a union carrying a map atom.
  // `unionRefArrayArmSlotForMapElem` above looks for an array-of-map arm, and `Json[]` is
  // not one: its element is the union `Json`, which merely has a map among its atoms. The
  // arm's build boxes each element into the union box.
  const nmSlot = unionRefArrayArmSlotForNestedElem(unionName, true)
  if nmSlot >= 0 {
    fbI32Rel(RS_TAG, refArrSlotTag(nmSlot))
    if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
    return 0
  }
  return emitFail(
    "emitProgram: a union arm that is an array-of-map is not yet supported — use a named element type",
  )
}

// The set id of coerce target `unionName`: `uSet` when the caller resolved it, else by name.
function coerceSetOf(uSet: i32, unionName: string): i32 {
  if uSet >= 0 { return uSet }
  msSetOfUnion(unionName)
}

// Whether coerce target `unionName`, of set id `uSet` (-1 when unresolved), admits `null`.
function coerceSetHasNull(uSet: i32, unionName: string): boolean {
  if uSet >= 0 { return msHasNull(uSet) }
  unionSetHasNull(unionName)
}

// Whether a coerce target of set id `uSet`, else of arena type `uTy`, boxes a literal-union atom
// as its member string. False when the caller holds neither.
function coerceTakesAtomAsStr(uSet: i32, uTy: i32): boolean {
  if uSet >= 0 { return msSetTakesAtomAsStr(uSet) }
  tyBoxTakesAtomAsStr(uTy)
}

// `emitUnionCoerceUnder`'s value-atom path, past its gate: a scalar map read into a nullable
// union and an atom widened to its member string box here, every other value through
// `emitUnionCoerceAtomBox`. Returns 0, or -1 once failed.
function emitUnionCoerceValueAtom(
  body: u8[],
  unionName: string,
  uSet: i32,
  uTy: i32,
  exprIx: i32,
  bareIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // A bare scalar-valued map read entering a nullable union — box it with a tag chosen by the
  // probe, rather than letting the ladder below tag a miss as present. Gated on the union
  // actually containing `null`: without a null member there is no absent to represent, so
  // `m[k]` keeps the ladder's plain boxing.

  // Above the ladder because the ladder cannot see the difference: it classifies the expression
  // (`m[k]` is an i32) and has no access to whether the key is present, so it emits an
  // unconditional value tag over the rep's empty value. For `i32` that empty value is `0`, a
  // real value. The niche-bearing value types are excluded: their empty value already means absent.
  const mrk = mapReadScalarBoxKind(exprIx, fnIx)
  if mrk >= 0 && coerceSetHasNull(uSet, unionName) {
    // Only when the map's own value atom is a MEMBER of the target union. A widening
    // consumption (`{[string]: i32}` read into `i64 | null`) has to go through the
    // ladder's promotion rules, which this arm does not replicate — declining leaves it
    // exactly as it is today rather than tagging it with the wrong width.
    if unionHasAtom(unionName, scalarAtomNameOfKind(mrk)) {
      const mre = nodeAt(unwrapParen(exprIx))
      if mre is Index {
        return emitMapGetScalarBox(
          body,
          mre.idxArr,
          mre.idxIndex,
          mrk,
          fnIx,
          ec,
        )
      }
    }
  }
  // An atom-typed value entering the box, above the value-atom ladder because the ladder
  // cannot classify it at all: `valueAtomKind("K")` is -1, so a `K`-typed local, param or call
  // result falls past every branch to the numeric default and every mixed spelling boxes the
  // raw id under a wrong tag or pushes an i32 at the box's `anyref` payload.

  // The id widens to its member string (`emitAtomToStr`) under kind 2, `isArmTagOfTy`'s
  // litunion tag. `emitAtomToStr` stashes the id in the string-op scratch frame, so the
  // reservation predicates in `emit_fn_scans` must answer true wherever this gate does.
  if coerceTakesAtomAsStr(uSet, uTy) && exprIsLitAtom(exprIx, fnIx) {
    // A `K | null` value's `-1` boxes under the null tag, any other id as its member string
    // under the string tag; the id is read once (D3347).
    const nlTexts = nulAtomWidenTexts(exprIx)
    if nlTexts.length > 0 {
      // Beside a plain `string` arm the join is `string | null`, not this box.
      const nlAtoms: string[] = []
      unionMemberAtomsOf(unionName, nlAtoms)
      let nlStrArm = false
      for na in nlAtoms {
        if na == "string" { nlStrArm = true }
      }
      // A binding typed `K | null` holds the atom at every spelling; a parameter does too, unless
      // its function's declared return reads the box at the declaration's rep.
      const nlArg = nodeAt(unwrapParen(exprIx))
      let nlParam = false
      if (
        nlArg is Ident
        && (fnIx < 0 || paramIndexOf(fnIx, nlArg.identName) < 0)
      ) {
        nlParam = true
      }
      if nlArg is Ident && fnIx >= 0 {
        const nlFn = nodeAt(fnIx)
        // A pinned instance's parameter holds the atom too: the instance reads it at its own rep.
        if nlFn is FuncDecl && (nlFn.fnRet < 0 || fnInPinnedInstance(fnIx)) {
          if paramIndexOf(fnIx, nlArg.identName) >= 0 { nlParam = true }
        }
        // A `K | null` niche parameter holds the atom id whatever the function's return (D4041).
        if (
          paramIndexOf(fnIx, nlArg.identName) >= 0
          && exprNulLitUnion(exprIx, fnIx)
        ) {
          nlParam = true
        }
        // A capture whose env field holds the atom is the atom, as a parameter is (D3358).
        if capturedKindOf(fnIx, nlArg.identName) == "i32" { nlParam = true }
      }
      // A declared `K | null` field or an atom-valued map read is the niche, outside an instance
      // or where the instance's own type for the read is that niche.
      if (
        (nlArg is Member || nlArg is Index)
        && ((!fnInPinnedInstance(fnIx) && !nodeTyHasTyVar(unwrapParen(exprIx)))
          || tyIsNulLitUnionNiche(holeOperandTyOf(exprIx, fnIx)))
        && exprNulLitUnion(exprIx, fnIx)
      ) {
        nlParam = true
      }
      if nlArg is Index && fnInPinnedInstance(fnIx) {
        if tyIsLitUnion(tyMapValOf(mapRecvTyIn(nlArg.idxArr, fnIx))) {
          nlParam = true
        }
      }
      if !coerceSetHasNull(uSet, unionName) || !aUsed || nlStrArm || !nlParam {
        return emitFail(
          "emitProgram: literal-union string widening with no members",
        )
      }
      if emitStashAtomId(body, exprIx, fnIx, ec) < 0 { return -1 }
      fbI32Rel(RS_TAG, nullBoxTag())
      fbI32Rel(RS_TAG, scalarTagOfKind(2))
      pushStrScrI(body, 0)
      fbI32Const(-1)
      fbI32Bin(70) // i32.eq
      fbSelect() // the null tag if the id is -1
      pushStrScrI(body, 0)
      fbI32Const(-1)
      fbI32Bin(70)
      fbIfRefNul(sTypeIdx, true)
      fbRefNull(sTypeIdx)
      fbElse()
      if emitAtomToStrChain(body, nlTexts, 0, strScratchBase + 3) < 0 {
        return -1
      }
      fbEnd()
      fbStructNew(uBoxIdx)
      return 0
    }
    fbI32Rel(RS_TAG, scalarTagOfKind(2)) // the string tag — kind 2 rides the anyref directly
    if emitAtomToStr(body, exprIx, fnIx, ec) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, member-string ref }
    return 0
  }
  return emitUnionCoerceAtomBox(body, unionName, uSet, exprIx, bareIx, fnIx, ec)
}

// The value-atom box `{ tag, payload }` for `exprIx` entering `unionName`: the atom ladder
// settles one value-atom code, and the tag, the payload's widening and any list re-encode all
// follow from it. `bareIx` is the paren-stripped node. Returns 0, or -1 once failed.
function emitUnionCoerceAtomBox(
  body: u8[],
  unionName: string,
  uSet: i32,
  exprIx: i32,
  bareIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const cak = coerceListAtomOf(
    coerceValueAtomKind(unionName, uSet, exprIx, bareIx, fnIx),
    unionName,
    bareIx,
    fnIx,
  )
  // `cak` is final at this point: every arm of the ladder above assigns before the
  // tag is emitted, and the box TAG, the rides-the-anyref test and the scalar value
  // box below are all projections of it (`scalarTagOf` / `atomIsRefKind` /
  // `vbHeapIdxOfKind` each re-derived it from the spelling).
  if cak == 7 && vbAtomListUsed && exprIsAtomList(bareIx, fnIx) {
    fbI32Rel(RS_TAG, atomListArmTag())
  } else {
    fbI32Rel(RS_TAG, scalarTagOfKind(cak))
  }
  if emitCoerceAtomPayload(body, cak, exprIx, fnIx, ec) < 0 { return -1 }
  // A `string` / list member is a REF and rides the box's anyref `value` directly; only a
  // SCALAR atom wraps in its per-rep value box.
  if !atomIsRefKind(cak) {
    const vb = vbHeapIdxOfKind(cak)
    if vb < 0 { return emitFail("emitProgram: union atom has no value box") }
    fbStructNew(vb) // wrap the scalar payload
  }
  fbStructNew(uBoxIdx) // { tag, payload }
  0
}

// The value-atom code `exprIx` boxes at entering `unionName`, before any list widening.
function coerceValueAtomKind(
  unionName: string,
  uSet: i32,
  exprIx: i32,
  bareIx: i32,
  fnIx: i32,
): i32 {
  // Classify the value's atom. Order mirrors the print-import ladder (f32 before f64 — a float
  // literal classifies f64 too; string, bool and i64 are disjoint). The default is i32 unless
  // the union has no `i32` member but does have `i64`, or the literal exceeds the i32 range.

  // The ladder settles the value-atom code, not a spelling: the box tag, the rides-the-anyref
  // test, the scalar value box, the six `atom == …` compares picking the widened emit and the
  // two list re-encodes are all projections of that one code. Faithful because the map is
  // `valueAtomKind`'s own first-match ladder over exactly these eleven lexemes.
  let cak = 0 // "i32"
  // D209 — the third end of the same channel. When the read site delivers the atom rather than
  // the box (`memReadUnboxAtomKind`, the predicate `exprUnion` also asks), the value's atom is
  // that predicate's answer and not this ladder's: every arm below reads the read as a code-16
  // box and declines, so a `string | i32` field read boxes a string ref as an i32.

  // And the atom is taken only where this destination stores it as itself. Where the read's own
  // field widened the payload on the way in, taking the delivered atom raw tags the box `i32`
  // over a slot whose only numeric arm is `i64` — valid wasm, `is i64` silently false.
  // `unionStoreAtomKind` makes the two sides of the round trip inverses.
  const d209k = memReadUnboxAtomKind(bareIx, fnIx)
  if d209k >= 0 && unionStoreAtomKindOfSet(uSet, unionName, d209k) == d209k {
    cak = d209k
  } else if exprString(exprIx, fnIx) {
    cak = 2 // "string"
  } else if exprStringArray(exprIx, fnIx) {
    cak = 9 // "string[]" — a list member rides as a wrapper ref (like a string)
  } else if exprF32Array(exprIx, fnIx) {
    // Checked BEFORE the f64 arm: an f32-typed list value (an `f32[]` local/param/
    // narrowed read) must not be mis-claimed as `f64[]`. A bare float LITERAL still
    // classifies f64 (`exprF32Array` never claims it) — the `f64[]` → `f32[]`
    // re-encode below retargets it when only the f32 arm exists.
    cak = 12 // "f32[]"
  } else if exprF64Array(exprIx, fnIx) {
    cak = 8 // "f64[]"
  } else if exprI64Array(exprIx, fnIx) {
    cak = 10 // "i64[]"
  } else if exprU8Array(exprIx, fnIx) {
    // Checked before the i32-list arm for the same reason the f32 arm precedes the f64 one: a
    // `u8[]` element reads as an i32 everywhere (`array.get_u` widens it), so the generic array
    // arm below would claim it and tag the box `i32[]` over a one-byte backing. Without this
    // arm a `u8[]` carrier falls past the whole ladder and boxes its wrapper ref as an i32.
    cak = 13 // "u8[]"
  } else if exprArray(exprIx, fnIx) {
    cak = 7 // "i32[]"
    // "boolean[]" (17) or "(boolean | null)[]" (18), read at this instance's pin
    const bcode = exprBoolListCode(bareIx, fnIx)
    if bcode == 17 || bcode == 18 { cak = bcode }
    // A literal the union holds as another list on the same storage (`[false]` into a
    // `(boolean | null)[]` arm) takes that arm's code.
    if cak == 17 && !unionHasAtomKindArm(unionName, 17) {
      if unionHasAtomKindArm(unionName, 18) { cak = 18 }
    }
  } else if exprIsV128(exprIx, fnIx) {
    cak = 14 // "v128"
  } else if exprIsF32(exprIx, fnIx) {
    // D978 — ask the union which arm stores an f32, do not assume the f32 one. A union with
    // only an `f64` arm stores it there, losslessly, and assuming kind 5 asks for an f32 box
    // the module never minted.
    cak = 5 // "f32"
    // Only when the union genuinely offers an `f64` ARM and no `f32` one. Asking
    // `unionStoreAtomKind` in general moved a case it should not have
    // (`d901_fold_f32_dest`, a `{q: f32} | null` whose f32 is a FIELD and not an arm), so
    // the test is spelled out here instead of widening that shared mapper.
    const f32Set = coerceSetOf(uSet, unionName)
    if !unionHasAtomK(f32Set, unionName, "f32", 5) {
      if unionHasAtomK(f32Set, unionName, "f64", 4) { cak = 4 }
    }
  } else if exprIsF64(exprIx, fnIx) {
    cak = 4 // "f64"
  } else if exprIsI64(exprIx, fnIx) {
    // D978's shape one arm down: ask the union which arm stores an i64 rather than assuming
    // the i64 one. A union with only a float arm holds an exact integer LITERAL there, which
    // is the only i64-classified value the checker admits into it (D1890's grant is
    // exactness-gated), and assuming kind 3 asks for an i64 value box the module never minted.
    cak = 3 // "i64"
    const i64Set = coerceSetOf(uSet, unionName)
    if !unionHasAtomK(i64Set, unionName, "i64", 3) {
      if unionHasAtomK(i64Set, unionName, "f64", 4) { cak = 4 }
      else if unionHasAtomK(i64Set, unionName, "f32", 5) { cak = 5 }
    }
  } else if exprIsBool(exprIx, fnIx) {
    cak = 1 // "boolean"
  } else {
    // The union's own promotion of an i32-classified value: no `i32` arm but a wider numeric
    // one, so the value is stored as that arm. `unionStoreAtomKind` is that ladder's one home —
    // the same function the un-narrowed read asks to learn which value box holds the payload
    // it is looking at (D291).

    // Promoting to `i64` alone is not enough: an integer flowing into a union whose only numeric
    // atom is a float would stay `cak = 0` and box an i32 into the f64 or f32 value box, which
    // is check-clean invalid wasm in the global, local and argument positions. f64 before f32,
    // matching the list arm.
    const usw = unionStoreAtomKindOfSet(uSet, unionName, 0)
    if usw >= 0 { cak = usw }
    if numLitWidth(bareIx, fnIx) == "i64" { cak = 3 }
  }
  // A float literal types f64 by default, but if the union's float atom is f32 (`f32 | string`,
  // no f64) the literal re-encodes at f32 — pick the f32 atom so it boxes into the f32 value
  // box. The same promotion ladder, entered at f64 instead of i32. The `cak == 4` gate is
  // hoisted out of the call below so the set resolution is paid only by a float value.
  if cak == 4 {
    const fsw = unionStoreAtomKindOfSet(uSet, unionName, 4)
    if fsw >= 0 { cak = fsw }
  }
  cak
}

// The list widening of the atom code `cak0` entering `unionName`: a list literal whose union
// holds it as a wider or packed list takes that arm's code, and builds at that arm's type.
function coerceListAtomOf(
  cak0: i32,
  unionName: string,
  bareIx: i32,
  fnIx: i32,
): i32 {
  let cak = cak0
  // An int-element list whose union has no `i32[]` member but an `i64[]` or `f64[]` one: the
  // elements are small int literals, so the list classifies `i32[]` while the union demands the
  // wider list. A boolean list is its own arm, never a number to widen (D2796), and so is a list
  // of string-literal-union atoms (D4902).
  if (
    cak == 7
    && !unionHasAtomTy(unionName, "i32", true)
    && !(unionHasAtomTy(unionName, "boolean", true) && exprIsBoolList(bareIx, fnIx))
    && !exprIsAtomList(bareIx, fnIx)
  ) {
    if unionHasAtomTy(unionName, "i64", true) {
      cak = 10 // "i64[]"
    } else if unionHasAtomTy(unionName, "f64", true) {
      cak = 8 // "f64[]"
    } else if unionHasAtomTy(unionName, "f32", true) {
      cak = 12 // "f32[]"
    } else if unionHasAtomTy(unionName, "u8", true) {
      // An empty `[]` classifies `i32[]` too: into `u8[] | Buf` it is the packed list.
      cak = 13 // "u8[]"
    }
  }
  // A float-element literal classifies `f64[]`; where the union's only float-list atom is
  // `f32[]` the checker adopted that arm.
  if (
    cak == 8
    && !unionHasAtomTy(unionName, "f64", true)
    && unionHasAtomTy(unionName, "f32", true)
  ) {
    cak = 12 // "f32[]"
  }
  cak
}

// The payload of a value-atom box: `exprIx` widened to the atom `cak`. Returns 0, or -1 once
// failed.
function emitCoerceAtomPayload(
  body: u8[],
  cak: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if cak == 3 {
    if emitExprAsI64(body, exprIx, fnIx, ec) < 0 { return -1 }
  } else if cak == 4 {
    if emitExprAsF64(body, exprIx, fnIx, ec) < 0 { return -1 }
  } else if cak == 5 {
    if emitExprAsF32(body, exprIx, fnIx, ec) < 0 { return -1 }
  } else {
    if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
  }
  0
}

// `emitUnionCoerce`'s body: the arms that thread a list or f32 context apply it and leave it
// for the wrapper's exit to undo.
function emitUnionCoerceUnder(
  body: u8[],
  unionNameIn: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // Resolve a union ALIAS (`type Tagged = {x:i32} | string`) to its pipe-joined member set
  // so the value-atom boxing below (`unionHasValueAtom`/`unionHasAtom`/the atom ladder) sees
  // the atoms — an alias name has no `|` to split. An INLINE union name (already a member
  // set) and a non-union name resolve to "" and pass through unchanged.
  let unionName = unionNameIn
  const ums = unionMemberSetOf(unionName)
  if ums != "" { unionName = ums }
  const clash = unionArmTagClash(unionName, unionTy)
  if clash != "" { return emitFailAt(clash, exprIx) }
  const bareIx = unwrapParen(exprIx)
  if bareIx < 0 { return -1 }
  const bare = nodeAt(bareIx)
  // A `never` call enters any box: its `unreachable` satisfies the destination (D14086).
  if callIsNever(bareIx) { return emitExpr(body, bareIx, fnIx, ec) }
  // An if-expression join (`return if c { catVal } else { dogVal }`): each arm is a distinct
  // union member, so the join cannot ride a single numeric blocktype — emit a value-typed `if`
  // whose result is the union box, union-coercing each arm. Without this the join defaults to
  // an i32 blocktype over ref arms, which is invalid wasm.

  // D969 — ahead of the `exprUnion` raw-pass below, and the order is the whole point. An
  // if-expression that is already a union value hits the raw pass first and is emitted by
  // `emitExpr`, which picks the join's blocktype from the arms' scalar ladder. Only this arm
  // knows the blocktype has to be the box, so it must be asked first.
  if bare is IfStmt && !ifJoinAdaptsScalar(bareIx, fnIx) {
    // A `null`-typed one is the null-tagged box after its arms run for effect (D3355).
    if nodeTyIsNullType(bareIx) {
      fbI32Rel(RS_TAG, nullBoxTag())
      if emitNulNoneBoxPayload(body, bareIx, fnIx, ec) < 0 { return -1 }
      fbStructNew(uBoxIdx)
      return 0
    }
    return emitUnionIfValue(body, unionName, unionTy, bareIx, fnIx, ec)
  }
  if numUnionMinted {
    const nuRb = emitNumUnionRebox(body, exprIx, unionName, fnIx, ec)
    if nuRb != 0 { return nuRb }
  }
  if exprUnion(exprIx, fnIx) { return emitExpr(body, exprIx, fnIx, ec) }
  if bare is NullLit {
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone() // the payload slot is unread under the null tag
    fbStructNew(uBoxIdx)
    return 0
  }
  // D1576 — a `null`-typed value at a box destination is the same null-tagged box, with the
  // value in the payload slot instead of a fresh `ref.null none`: `nullref` is an `anyref`, so
  // it rides the slot the null tag leaves unread and a call's side effects still happen. The
  // binding twin of `emitUnionBoxArg`'s arm, which is the argument boundary's.
  if exprIsNulNone(exprIx, fnIx) {
    fbI32Rel(RS_TAG, nullBoxTag())
    if emitNulNoneBoxPayload(body, exprIx, fnIx, ec) < 0 { return -1 }
    fbStructNew(uBoxIdx)
    return 0
  }
  // A `V | null` niche delivered where the box is expected: the niche carries no tag of its
  // own, so its null must become the union's null. Ahead of the struct arms, which box a
  // nullable record under its arm's tag whatever it holds (D2260), and of the value-atom gate.
  const viaNulNiche = emitUnionBoxNulNiche(
    body,
    unionName,
    unionNameIn,
    unionTy,
    exprIx,
    fnIx,
    ec,
  )
  if viaNulNiche < 0 { return -1 }
  if viaNulNiche == 1 { return 0 }
  emitUnionCoerceRecord(
    body,
    unionName,
    msSetOfUnion(unionNameIn),
    unionTy,
    exprIx,
    bareIx,
    fnIx,
    ec,
  )
}

// `emitUnionCoerceUnder`'s record arms: an object literal, a struct value re-boxed against its
// variant arm, a bare variant value. Every other value goes on to `emitUnionCoerceMap`.
// Returns what `emitUnionCoerceUnder` returns.
function emitUnionCoerceRecord(
  body: u8[],
  unionName: string,
  uSet: i32,
  uTy: i32,
  exprIx: i32,
  bareIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const bare = nodeAt(bareIx)
  // A STRUCT value (an object literal, or a struct-typed expr) auto-boxes through
  // `emitExpr`'s `uDeclared` variant path; only a SCALAR value is value-boxed below.
  // This is what lets a MIXED union (`A | i32`) coerce either kind of member: an object
  // arm boxes as a variant struct, a scalar arm as a value box.
  if bare is ObjLit {
    // The target union's own arms are tried first (`unionArmVariantForObj`): the global scan
    // below picks the first field-name-set match across all unions, which can land on another
    // union's arm sharing the names — two nested-struct arms differing only in the nested
    // layout collide onto the first arm's tag. A single-union program resolves either way.
    const ctxVi = unionArmVariantForObj(unionName, uTy, bareIx, fnIx)
    if ctxVi >= 0 { return emitUnionBoxAs(body, bareIx, ctxVi, fnIx, ec) }
    // When the literal matches a union variant, box it as that variant directly rather than
    // routing through `emitExpr` — whose `structIndexOfObj` re-inference mis-resolves a
    // field-name collision with an enclosing struct to the outer struct, emitting invalid
    // wasm. `objVariantName` is `emitObjLitNode`'s own resolution, only reordered ahead.
    if objVariantNameCtx(bareIx, fnIx) != "" {
      return emitUnionBox(body, bareIx, fnIx, ec)
    }
    return emitExpr(body, exprIx, fnIx, ec)
  }
  // A struct-typed ident or call result that is a variant arm of `unionName` but is built as
  // the plain struct — a distinct heap type from the arm's variant struct — would pass raw
  // where the box wants the variant struct. Re-box it against the matched arm
  // (`emitStructExprAsVariantBox`). Gated on the heaps differing, so a deduped shape is raw.
  if unionName != "" && exprStruct(exprIx, fnIx) {
    const rbVi = unionArmVariantForStructExpr(unionName, uTy, exprIx, fnIx)
    if rbVi >= 0 {
      const rbSsi = structIndexOfExpr(exprIx, fnIx)
      if rbSsi >= 0 {
        if sHeapIdx[rbSsi] != uVarHeap[rbVi] {
          return emitStructExprAsVariantBox(body, exprIx, rbVi, rbSsi, fnIx, ec)
        }
        // The heaps agreeing is not a reason to pass raw (D281). The test above answers "must
        // the payload be rebuilt onto another heap type"; the fall-through below answers "is
        // this value already box-shaped". With the cross-table merge (`uVarSTwin`) the equal
        // branch is reachable, and raw-passing a `(ref $arm)` into a box cell is invalid wasm.
        fbI32Rel(RS_TAG, uTags[rbVi]) // 0x41 i32.const <variant tag> (program-global)
        if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
        fbStructNew(uBoxIdx) // { tag, variant-ref }
        return 0
      }
    }
    // A record built at another row lands on the member the checker names, copied there.
    const lvVi = unionArmLandingForStructExpr(unionName, uTy, exprIx, fnIx)
    if lvVi >= 0 {
      const lvSsi = structIndexOfExpr(exprIx, fnIx)
      return emitStructExprAsVariantBox(body, exprIx, lvVi, lvSsi, fnIx, ec)
    }
  }
  if exprStruct(exprIx, fnIx) {
    // With no row the record arm has no tag, and a raw record ref is no box (D3519).
    if unionBoxHasNoRow(unionName, uTy) {
      return emitFailAt(
        "emitProgram: a record value delivered into a union box this program never registered has no tag",
        exprIx,
      )
    }
    return emitExpr(body, exprIx, fnIx, ec)
  }
  // A bare variant value (a kind-8 local, param or call, its binding classified concrete by
  // `letIsVariant`) passes through: the binding's slot is the raw variant ref. Without this a
  // union carrying a value atom drops the variant ref into the scalar atom ladder and widens
  // it. A box-typed position routes through `emitUnionBoxArg`, which boxes before deferring.
  if exprVariantIndex(exprIx, fnIx) >= 0 {
    return emitExpr(body, exprIx, fnIx, ec)
  }
  emitUnionCoerceMap(body, unionName, uSet, uTy, exprIx, bareIx, fnIx, ec)
}

// `emitUnionCoerceUnder`'s map arms: a map carrier tagged by its value slot, the loud reject of
// a map the union does not box, and a narrowed map arm's re-box. Every other value goes on to
// `emitUnionCoerceList`. Returns what `emitUnionCoerceUnder` returns.
function emitUnionCoerceMap(
  body: u8[],
  unionName: string,
  uSet: i32,
  uTy: i32,
  exprIx: i32,
  bareIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // A map carrier flowing into a union with a matching map arm: the map struct ref rides the
  // box anyref directly, like a reflist wrapper, tagged by its interned value slot
  // (`mapSlotTag`). Checked before the value-atom gate below — such a union may have no value
  // atom, so that gate would bail and emit the raw map ref where a `(ref $uBox)` is expected.
  if unionName != "" && exprMap(exprIx, fnIx) {
    let mSlot = mapShapeOfExpr(exprIx, fnIx)
    // A Set rides its key's mono map slot.
    if mSlot != -3 { mSlot = mapShapeFoldSet(mSlot) }
    if mSlot >= -1 || mSlot == -4 || mSlot == -6 {
      if unionHasMapArmSlot(unionName, uTy, mSlot) {
        const mTag = mapBoxTagOf(mSlot, unionName, uTy, exprIx, fnIx)
        if mTag < 0 { return -1 }
        fbI32Rel(RS_TAG, mTag)
        if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
        fbStructNew(uBoxIdx) // { tag, map-struct ref }
        return 0
      }
    }
  }
  // A map carrier the union does not box (a checker-impossible slot mismatch, or an
  // unsupported map value type `mapShapeOfExpr` returns -3 for): fail loudly rather than
  // default the tag and let every later `is` silently miss.
  if exprMap(exprIx, fnIx) {
    return emitFail(
      "emitProgram: a map value is not a supported union member — use a struct member instead",
    )
  }
  // D1029 — the map arm's re-box, the rung the ref-array arm below already has. A value
  // narrowed to the union's map arm reads unboxed in that scope, so delivering it to a
  // destination typed at the union has to put the box back: the arm's tag, the map ref,
  // `struct.new`. Written as the exact mirror of the ref-array rung so the two stay one shape.
  const d29 = emitUnionMapArmBox(body, unionName, uTy, exprIx, fnIx, ec)
  if d29 < 0 { return -1 }
  if d29 == 1 { return 0 }
  emitUnionCoerceList(body, unionName, uSet, uTy, exprIx, bareIx, fnIx, ec)
}

// `emitUnionCoerceUnder`'s list and closure arms, then the value-atom gate: an empty list, a
// ref-element array, a list literal routed through its arm's build, a bare closure, and every
// remaining value raw or value-boxed. Returns what `emitUnionCoerceUnder` returns.
function emitUnionCoerceList(
  body: u8[],
  unionName: string,
  uSet: i32,
  uTy: i32,
  exprIx: i32,
  bareIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const bare = nodeAt(bareIx)
  const eau = emitEmptyArrUnionArm(body, unionName, uTy, exprIx, fnIx, ec)
  if eau < 0 { return -1 }
  if eau == 1 { return 0 }
  // A ref-element array carrier (`S[]`, `(() => f64)[]`, `(C | D)[]`) flowing into a union with
  // a matching ref-array arm: the reflist wrapper ref rides the box anyref directly, tagged by
  // its interned slot (`refArrSlotTag`). Checked before the value-atom gate below — such a union
  // may have no value atom, so that gate would bail and emit the raw wrapper ref.
  if unionName != "" && exprRefArray(exprIx, fnIx) {
    return emitUnionCoerceRefArray(body, unionName, uTy, exprIx, fnIx, ec)
  }
  // A list literal the checker typed as a ref-list arm builds there (`emitArr`), so it boxes
  // under that arm's tag even where its elements alone read as scalars (`[null]`).
  const atSlot = arrLitRefSlotAtTy(bareIx, fnIx)
  if unionName != "" && unionHasRefArrayArmSlot(unionName, atSlot) {
    const atTag = refArrBoxTagOf(exprIx, fnIx, atSlot, unionName, uTy)
    if atTag < 0 { return emitFail("emitProgram: boolean list arm has no tag") }
    fbI32Rel(RS_TAG, atTag)
    if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, reflist-wrapper ref }
    return 0
  }
  // An array literal whose element is a map (`[m]`) flowing into a union with an array-of-map
  // arm: the arm's reflist element is the map type, but a map-valued literal element is
  // invisible to `exprRefArray` and `arrLitElemName`, which resolve an inline-struct element and
  // not a map ident, so the ref-array arm path above is skipped.

  // Route it through the arm's build: the element's map shape (`mapShapeOfExpr`, mono -1 or a
  // typed mv slot) picks the arm whose element map has the same canonical value rep, the literal
  // builds with the arm's reflist slot threaded, and the wrapper takes the arm's slot tag. A
  // literal matching no arm keeps the loud reject; falling through would be invalid wasm.
  if unionName != "" && bare is ArrayLit {
    if bare.arrElems.length >= 1 && exprMap(bare.arrElems[0], fnIx) {
      return emitUnionCoerceMapElemList(body, unionName, bare, exprIx, fnIx, ec)
    }
    // A nested array literal whose leaf does not self-classify as a ref array (`[["ab"]]` — a
    // string-leaf inner makes `arrLitIsRef` false, so the `exprRefArray` carrier path above
    // misses it) flowing into a union with one nested-array arm: route through the arm's
    // build, exactly like the self-classified mismatch case.
    if bare.arrElems.length >= 1 {
      const bareE0 = nodeAt(bare.arrElems[0])
      if bareE0 is ArrayLit {
        const viaNest2 = emitUnionNestedListLit(
          body,
          unionName,
          uTy,
          exprIx,
          fnIx,
          ec,
        )
        if viaNest2 < 0 { return -1 }
        if viaNest2 == 1 { return 0 }
      }
    }
  }
  // A bare closure carrier (a lambda literal or a closure-typed binding) flowing into a union
  // with a bare-closure arm: the closure fat-pointer struct, a `structref` subtype, rides the
  // box anyref directly, tagged by the closure arm's `scalarTagOf` (value-atom kind 11).
  // Checked before the ladder below, whose scalar branches would store the ref in a value box.
  if unionName != "" && exprIsClosure(exprIx, fnIx) {
    const clArm = unionClosureArmName(unionName)
    if clArm != "" {
      fbI32Rel(RS_TAG, cloArmTagOfTy(cloBoxArmTy(exprIx, unionName, fnIx)))
      if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
      fbStructNew(uBoxIdx) // { tag, closure fat-pointer ref }
      return 0
    }
  }
  // A scalar-element list literal (`["a"]`, `[1]`, invisible to `exprRefArray`) whose union arm
  // is a union-box-element ref-array: route it through the arm's build and tag. Checked before
  // the value-atom gate and ladder below — the gate would emit the raw wrapper into the box
  // slot, and the ladder would tag the box with the scalar-list atom instead of the arm's tag.
  const viaListArm = emitUnionListLitViaRefArm(
    body,
    unionName,
    uTy,
    exprIx,
    fnIx,
    ec,
  )
  if viaListArm < 0 { return -1 }
  if viaListArm == 1 { return 0 }
  if unionName == "" || !unionHasValueAtom(unionName) {
    return emitExpr(body, exprIx, fnIx, ec)
  }
  return emitUnionCoerceValueAtom(
    body,
    unionName,
    uSet,
    uTy,
    exprIx,
    bareIx,
    fnIx,
    ec,
  )
}

// Coerce an expression into a union-box position whose wasm rep is `(ref $uBox)` — a call
// argument to a union param, or a return typed as the union. A concrete variant-struct value is
// a raw `(ref $variant)`, since a struct that is a union member is allocated as a kind-8 variant
// local so it narrows in place, and that raw ref does not match the boxed rep.

// Box it into the shared `{tag, payload}` rep exactly as `emitUnionBox` boxes a struct literal —
// the variant ref is the payload type, so no field copy. Box-typed positions only; exported for
// `emit_sections.vl`'s module-global cells, which are box-typed too.

// D1567 — is the function at `fnStmts` position `pos` one whose every returned value is a bare
// `null`? The checker types such a return `TyPrim:null` and the emitter reps it as `nullref`.
// The one home for that question: the union box destination in `emitUnionBoxArg` and the two
// i32 niches in `emitDirectCall` read it here rather than each spelling the kind compare.
function fnPosRetIsNulNone(pos: i32): boolean {
  if pos < 0 || pos >= fRetKind.length { return false }
  fRetKind[pos] == "nulnone"
}

// The payload of a null-tagged box holding a `null`-typed value: the value itself when
// evaluating it can have effects (a call), and a fresh `ref.null none` otherwise. The slot is
// unread under the null tag, so its only job is to be an `anyref` — which is why an ident read
// must not route through the seed table (D1576), a `boolean | null` seed putting an i32 there.
export function emitNulNoneBoxPayload(
  body: u8[],
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const ix = unwrapParen(exprIx)
  if ix >= 0 && ix < P.nodes.length {
    if nodeAt(ix) is IfStmt {
      if emitIfForEffect(body, ix, fnIx, ec) < 0 { return -1 }
      fbRefNullNone()
      return 0
    }
  }
  emitNulNoneLeafPayload(body, exprIx, fnIx, ec)
}

// `emitNulNoneBoxPayload` for every node but an if-expression: a call is the payload itself.
function emitNulNoneLeafPayload(
  body: u8[],
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const n = nodeAt(unwrapParen(exprIx))
  if n is Call { return emitExpr(body, exprIx, fnIx, ec) }
  // `a ?? b` of the `null` type runs `a` for effect and is `b` (D3355).
  const co = plainCoalesceAt(exprIx)
  if co != null {
    if emitNulNoneForEffect(body, co.binLeft, fnIx, ec) < 0 { return -1 }
    return emitNulNoneBoxPayload(body, co.binRight, fnIx, ec)
  }
  fbRefNullNone()
  0
}

// The `a ?? b` node at `exprIx`, parentheses peeled, or null for any other node or a `??=`.
function plainCoalesceAt(exprIx: i32): BinExpr | null {
  const n = nodeAt(unwrapParen(exprIx))
  if n is BinExpr {
    if n.binOp == "??" && n.binCompound.length == 0 { return n }
  }
  null
}

// D1576 — does this `==` or `!=` compare the `null` type against a `null`? True when at least
// one operand is a `null`-typed value (`exprIsNulNone`) and both sides are either that or a bare
// `null` literal, so both denote the one value `null` and the compare folds to a constant. A
// genuinely nullable operand is excluded: there the answer is that operand's null-ness.
function nulNoneEqSides(leftIx: i32, rightIx: i32, fnIx: i32): boolean {
  if !exprIsNulNone(leftIx, fnIx) && !exprIsNulNone(rightIx, fnIx) {
    return false
  }
  nulNoneEqSide(leftIx, fnIx) && nulNoneEqSide(rightIx, fnIx)
}

// One side of `nulNoneEqSides`: a `null`-typed value, or a bare `null` literal.
function nulNoneEqSide(exprIx: i32, fnIx: i32): boolean {
  if exprIsNulNone(exprIx, fnIx) { return true }
  const n = nodeAt(unwrapParen(exprIx))
  if n is NullLit { return true }
  false
}

// Evaluate a `null`-typed operand for its effects and drop it, where the answer is already
// decided. A call and an if-expression have effects; an ident read has none, and emitting one
// would consume a destination seed (`emitNullBySeed`'s niche `ec.nulBool` / `nulString`) the
// surviving value still needs. Shared by `??`, the folded null compare, and `print`.
function emitNulNoneForEffect(body: u8[], exprIx: i32, fnIx: i32, ec: ExpCtx) {
  const ix = unwrapParen(exprIx)
  if ix >= 0 && ix < P.nodes.length {
    if nodeAt(ix) is IfStmt { return emitIfForEffect(body, ix, fnIx, ec) }
  }
  emitNulNoneLeafForEffect(body, exprIx, fnIx, ec)
}

// `emitNulNoneForEffect` for every node but an if-expression: a bare `null` and a name read have
// no effect, and anything else is lowered and its value dropped, since a `??` or a call in it
// may run code (D3355).
function emitNulNoneLeafForEffect(
  body: u8[],
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const n = nodeAt(unwrapParen(exprIx))
  if n is NullLit || n is Ident { return 0 }
  // A `null`-typed `a ?? b` has a `null`-typed left, so both sides always run.
  const co = plainCoalesceAt(exprIx)
  if co != null {
    if emitNulNoneForEffect(body, co.binLeft, fnIx, ec) < 0 { return -1 }
    return emitNulNoneForEffect(body, co.binRight, fnIx, ec)
  }
  if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
  fbDrop()
  0
}

// Run a `null`-typed if-expression for its effects alone: its conditions as a void `if` chain,
// each arm's prelude, and each arm's value through `emitNulNoneForEffect`, under the narrowing
// its condition gives (D2227).
function emitIfForEffect(body: u8[], ifIx: i32, fnIx: i32, ec: ExpCtx) {
  const s = nodeAt(ifIx)
  if s is IfStmt {
    if emitCondExpr(body, s.ifCond, fnIx, ec) < 0 { return -1 }
    fbIf(64) // 0x40 void
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const rcT = emitArmForEffect(body, s.ifThen, fnIx, ec)
    if narrowed { restoreNarrow(savedTop) }
    if rcT < 0 { return -1 }
    if s.ifElse >= 0 {
      fbElse()
      const savedElseTop = narrowTop
      const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
      let rcE = 0
      if nodeAt(s.ifElse) is IfStmt {
        rcE = emitIfForEffect(body, s.ifElse, fnIx, ec)
      } else {
        rcE = emitArmForEffect(body, s.ifElse, fnIx, ec)
      }
      if narrowedElse { restoreNarrow(savedElseTop) }
      if rcE < 0 { return -1 }
    }
    fbEnd()
    return 0
  }
  emitFail("emitProgram: expected an if expression")
}

// One arm of `emitIfForEffect`: its prelude, then its `null`-typed value for effect.
function emitArmForEffect(body: u8[], blockIx: i32, fnIx: i32, ec: ExpCtx) {
  if emitIfArmOpen(body, blockIx, fnIx, ec) < 0 { return emitIfArmClose(-1) }
  emitIfArmClose(emitNulNoneForEffect(body, ifArmValueExpr(blockIx), fnIx, ec))
}

// The value at `exprIx` boxed into the union `unionName`. A box of a member set holding a member
// `unionName` holds only widened is rebuilt there (`emitBoxAtomRetag`), so a record built or
// written at a wider record's field reads back through every handle (D3006).
export function emitUnionBoxArg(
  body: u8[],
  unionName: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitUnionBoxArgGo(body, unionName, unionTy, exprIx, fnIx, ec) < 0 {
    return -1
  }
  if !exprUnion(exprIx, fnIx) || deliveryRetagHas(exprIx) { return 0 }
  const vun = unionNameOfExpr(exprIx, fnIx)
  if !boxRetagNeeded(vun, unionName) { return 0 }
  emitBoxAtomRetag(vun, unionName, exprIx)
}

function emitUnionBoxArgGo(
  body: u8[],
  unionName: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // D1567 — a `null`-typed value at a box destination is the null-tagged box. `i32 | null` and
  // every other value union reps as `{tag, anyref}`, so a `nullref` result cannot ride the cell
  // raw and must not be boxed as its own arm either — the classifier below reads a Call's kind,
  // finds none, and boxes it as an i32. The payload is the value: `nullref` is an `anyref`.
  if exprIsNulNone(exprIx, fnIx) {
    fbI32Rel(RS_TAG, nullBoxTag())
    if emitNulNoneBoxPayload(body, exprIx, fnIx, ec) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { null tag, a nullref — unread under this tag }
    return 0
  }
  // D1009 — a map read of a union-valued map delivers its miss as a tagged box. `v[k]` on a
  // `{[string]: J}` has type `J | null`, and where `J` itself carries `null` that is a `J`. At
  // the rep the two nulls differ: the sentinel is a bare `ref.null` in the vals slot, `J`'s own
  // null arm a null-tagged box. `emitMapGetUnionBox` is exactly that conversion.
  const bxIdx = nodeAt(unwrapParen(exprIx))
  if bxIdx is Index {
    if exprMap(bxIdx.idxArr, fnIx) {
      const bxSh = mapShapeOfExpr(bxIdx.idxArr, fnIx)
      if bxSh >= 0 && bxSh < mvValKind.length {
        if mvValKind[bxSh] == MVK_UNION {
          return emitMapGetUnionBox(
            body,
            bxIdx.idxArr,
            bxIdx.idxIndex,
            fnIx,
            ec,
          )
        }
      }
    }
  }
  const bxMap = emitUnionMapArmBox(body, unionName, unionTy, exprIx, fnIx, ec)
  if bxMap < 0 { return -1 }
  if bxMap == 1 { return 0 }
  const bxArm = emitUnionArmValueBox(body, exprIx, fnIx, ec)
  if bxArm < 0 { return -1 }
  if bxArm == 1 { return 0 }
  emitUnionCoerce(body, unionName, unionTy, exprIx, fnIx, ec)
}

// Box a value that is already one arm of a value union — a concrete variant ref, or the
// `nulvariant` niche narrowed non-null — into the `{tag, anyref}` box. Returns 1 handled, 0
// not an arm value, -1 on error. Every box-typed destination delivers through it, since
// `emitUnionCoerce` alone passes an arm value raw, which fits only a variant cell (D1606).
function emitUnionArmValueBox(
  body: u8[],
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if exprUnion(exprIx, fnIx) { return 0 }
  // A read that can still be null (a record-valued map's miss) is the niche below even where
  // `exprVariantIndex` names its arm: tagging it with the arm boxes the miss as a record (D10170).
  const nyNul = nodeTyIsNullable(unwrapParen(exprIx))
  let nvi = -1
  if nyNul { nvi = nulVariantIdxOfExpr(exprIx, fnIx) }
  const svi = exprVariantIndex(exprIx, fnIx)
  if svi >= 0 && nvi < 0 {
    // A struct-typed value built as the plain struct (an anonymous union arm returned from a
    // `: {…}` function, or bound to a struct local) is a layout twin of but a distinct heap
    // type from the arm's variant struct: boxing the raw ref validates, and the narrow's
    // `ref.cast` traps at run time. Rebuild it with `emitStructExprAsVariantBox` instead.
    const bssi = structIndexOfExpr(exprIx, fnIx)
    // The bounds half of the twin test. `structIndexOfExpr` answers a struct table row, and
    // `sHeapIdx` is only as long as the rows that reached heap-type assignment, so a row that
    // never interned a shape indexes past it. Every sibling reader carries this bound, and an
    // out-of-bounds read in the compiler is a wasm trap with no diagnostic.

    // Neither same shapes nor the `is` test is required to reach it: `function f(x: A | i32)`
    // called as `f(mkA())` is enough. What is required is a call result in a union argument
    // position. A row with no heap index cannot be a layout twin of anything, so the compare
    // declines instead of indexing and the program continues to the loud reject.
    if (
      bssi >= 0
      && bssi < sHeapIdx.length
      && sHeapIdx[bssi] != uVarHeap[svi]
    ) {
      if emitStructExprAsVariantBox(body, exprIx, svi, bssi, fnIx, ec) < 0 {
        return -1
      }
      return 1
    }
    fbI32Rel(RS_TAG, uTags[svi]) // 0x41 i32.const <variant tag> (program-global)
    if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
    fbStructNew(uBoxIdx) // { tag, variant-ref }
    return 1
  }
  // The niche twin of the rung above (D24). A narrowed `Circle | null` is the `nulvariant`
  // niche — one non-null member, so a bare `(ref null $Circle)` and not a `{tag, value}` box —
  // and `exprVariantIndex` answers -1 for it by construction, its arms being the kind-8 param,
  // the declared local and the global, none of which is the nullable cell.

  // The narrow is what makes it sound: this position is only reachable with the value proved
  // non-null, and the box's payload field is `anyref`, so the niche rides it exactly as the
  // non-null variant ref does.
  if !nyNul { nvi = nulVariantIdxOfExpr(exprIx, fnIx) }
  if nvi >= 0 {
    if nvi < uTags.length {
      // Still nullable at this read (no narrow proved it): the null must become the union's
      // null, not a box tagged with the arm over a null payload (D2260).
      if nyNul {
        const nvSlot = nulNicheBoxSlot()
        const nvCtx = expCtxHere(ec)
        nvCtx.rawNullRead = true
        if emitExprExpect(body, exprIx, fnIx, nvCtx) < 0 { return -1 }
        fbLocalTee(nvSlot)
        fbRefIsNull()
        fbIfRef(uBoxIdx) // 0x04 if, (ref $uBox) blocktype
        fbI32Rel(RS_TAG, nullBoxTag())
        fbRefNullNone()
        fbStructNew(uBoxIdx)
        fbElse()
        fbI32Rel(RS_TAG, uTags[nvi])
        fbLocalGet(nvSlot)
        fbStructNew(uBoxIdx)
        fbEnd()
        return 1
      }
      fbI32Rel(RS_TAG, uTags[nvi]) // 0x41 i32.const <variant tag>
      if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
      fbStructNew(uBoxIdx) // { tag, niche-ref }
      return 1
    }
  }
  0
}

// Lower an if-expression whose value is a union as a value-typed `if` with the union box result
// type, each arm union-coerced. Mirrors `emitIfExprAs` in its narrowing save and restore and its
// `else if` recursion, but the blocktype is the `(ref $uBox)` valtype rather than a numeric byte,
// and the arms route through `emitUnionCoerce` so every arm boxes to the same rep.
function emitUnionIfValue(
  body: u8[],
  unionName: string,
  unionTy: i32,
  ifIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // An `else if` chain is emitted along its spine, so its depth costs no stack (D1990): each
  // link leaves its frame open for the next, and the frames close innermost-first.
  const open: i32[] = []
  let cur = ifIx
  let rc = 1
  while rc == 1 {
    rc = emitUnionIfValueLink(body, unionName, unionTy, cur, fnIx, open, ec)
    if rc == 1 {
      const link = nodeAt(unwrapParen(cur))
      if link is IfStmt { cur = link.ifElse }
    }
  }
  closeIfChainFrames(open, rc, false)
}

// Whether the value `if` at `ifIx` is typed one number a runtime tail is not, while every
// literal tail already has that type: delivered as that number, the runtime tail widens and a
// literal boxes at its own type as the union chain would box it (D3571).
function ifJoinAdaptsScalar(ifIx: i32, fnIx: i32): boolean {
  const pn = tyPrimNameOf(nodeTyAt(ifIx, fnIx))
  if pn != "i64" && pn != "f64" && pn != "f32" { return false }
  let widens = false
  for lf in valueTailLeaves(ifIx) {
    if tyPrimNameOf(nodeTyAt(lf, fnIx)) != pn {
      if cexLitPeel(lf) >= 0 { return false }
      widens = true
    }
  }
  widens
}

// One link of `emitUnionIfValue`: 0 or -1 as that function returns, or 1 when the else is another `if`
// and this link's frame is left open (its else restore target pushed onto `open`).
function emitUnionIfValueLink(
  body: u8[],
  unionName: string,
  unionTy: i32,
  ifIx: i32,
  fnIx: i32,
  open: i32[],
  ec: ExpCtx,
) {
  const s = nodeAt(ifIx)
  if s is IfStmt {
    // An else-less `if` used as a value is `T | null` (`DECISIONS.md`), and in the box rep that
    // null is the null-tagged box — the same value `emitNulNullToLocal` writes for the binding
    // sink's rep 0, built here on the stack instead of into a slot.
    const noElse = s.ifElse < 0
    const condStart = wLen()
    if emitCondExpr(body, s.ifCond, fnIx, ec) < 0 { return -1 }
    const sg = staticIsGuard(s.ifCond, condStart)
    fbOpenIf()             // 0x04 if
    fbValtype("union", -1) // result blocktype: the union box `(ref $uBox)`
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    let rcT = 0
    if sg == 0 {
      rcT = emitDeadValueArm(s.ifThen)
    } else {
      rcT = emitUnionIfArm(body, unionName, unionTy, s.ifThen, fnIx, ec)
    }
    if narrowed { restoreNarrow(savedTop) }
    if rcT < 0 { return -1 }
    fbElse() // 0x05 else
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    let rc = 0
    if noElse {
      fbI32Rel(RS_TAG, nullBoxTag())
      fbRefNullNone() // the payload slot is unread under the null tag
      fbStructNew(uBoxIdx)
    } else {
      const els = nodeAt(s.ifElse)
      if els is IfStmt && !ifJoinAdaptsScalar(s.ifElse, fnIx) {
        if narrowedElse { open.push(savedElseTop) } else { open.push(-1) }
        return 1 // `else if`: the next link, which the caller emits into this open frame
      } else if els is IfStmt {
        rc = emitUnionBoxArg(body, unionName, unionTy, s.ifElse, fnIx, ec)
      } else if sg == 1 {
        rc = emitDeadValueArm(s.ifElse)
      } else {
        rc = emitUnionIfArm(body, unionName, unionTy, s.ifElse, fnIx, ec)
      }
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    return 0
  }
  emitFail("emitProgram: expected a union if-expression")
}

// One arm of a union if-expression: the arm's prelude, then its tail-value statement
// union-coerced to the box rep (`emitUnionCoerce` — a variant struct boxes, a passthrough
// union rides as-is, a scalar value-boxes).
function emitUnionIfArm(
  body: u8[],
  unionName: string,
  unionTy: i32,
  blockIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const b = nodeAt(blockIx)
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if tailIsValueOrNever(tv, fnIx) {
        if emitIfArmOpen(body, blockIx, fnIx, ec) < 0 {
          return emitIfArmClose(-1)
        }
        // The if-value's result is the union box (the blocktype), so a concrete-variant arm — a
        // kind-8 `(ref $variant)` local or value — must be boxed to match, exactly as a variant
        // return or argument is. `emitUnionBoxArg` boxes a variant ref and defers every other
        // shape to `emitUnionCoerce`; plain `emitUnionCoerce` would emit the raw variant ref.
        return emitIfArmClose(
          emitUnionBoxArg(body, unionName, unionTy, tv, fnIx, ec),
        )
      }
      // An arm ending in an if-expression joins into the same box: its arms are lowered as
      // this join's own, so every leaf boxes once, whatever the inner `if` alone would type.
      if nodeAt(unwrapParen(tv)) is IfStmt {
        if emitIfArmOpen(body, blockIx, fnIx, ec) < 0 {
          return emitIfArmClose(-1)
        }
        // An inner join typed one wider number is that number, boxed once (D3571).
        if ifJoinAdaptsScalar(unwrapParen(tv), fnIx) {
          return emitIfArmClose(
            emitUnionBoxArg(body, unionName, unionTy, tv, fnIx, ec),
          )
        }
        return emitIfArmClose(
          emitUnionIfValue(
            body,
            unionName,
            unionTy,
            unwrapParen(tv),
            fnIx,
            ec,
          ),
        )
      }
    }
    return ifArmNoValueFail("union if-expression arm", blockIx)
  }
  emitFail("emitProgram: union if-expression arm is not a block")
}

// ── the narrowed-arm delivery unbox (D1031) ──────────────────────────────────

// An `is`-narrowed struct arm is still the `{tag, payload}` box at the wasm level. It is the one
// narrowed rep whose read does not unbox — `emitIdent` carries an unbox arm for the value-atom,
// ref-array and map arms and none for the struct one — so every destination typed at the arm has
// to recover the payload itself.

// The cast target is the destination's heap and not `uVarHeap[vi]`: the slot is what the store
// must satisfy, and where the arm is merged with a declared twin the indices are the same
// anyway. Not a change to `exprUnion`, which would move every narrowed struct receiver.
function narrowedArmNeedsUnbox(exprIx: i32, fnIx: i32): boolean {
  if (
    narrowedStructArmVi(exprIx) < 0
    && !narrowedNulStructArm(exprIx)
    && !exprTyIsRecord(exprIx, false, fnIx)
    && !exprTyIsRecord(exprIx, true, fnIx)
  ) {
    return false
  }
  exprUnion(exprIx, fnIx)
}

// Whether the checker typed `exprIx` as one record, or as `record | null` when `nullable`.
// A box of that type is a union of same-shape records collapsed to the record (D4989), so
// its payload is the record itself.
function exprTyIsRecord(exprIx: i32, nullable: boolean, fnIx: i32): boolean {
  if exprIx < 0 { return false }
  const ty = nodeTyAt(unwrapParen(exprIx), fnIx)
  if nullable { return ty >= 0 && tyIsRecord(nullableInnerOrNone(ty)) }
  tyIsRecord(ty)
}

// The unbox itself: recover the box's `anyref` payload and cast it to `heapIdx`, nullably when
// `exprIx` is narrowed to `X | null`. Emitted after the value, so the box is already on the
// stack. A negative `heapIdx` emits nothing: a destination whose table slot never resolved has
// no cast target, and `ref.cast -1` would put a garbage heap index in the module.
function emitNarrowedArmUnboxTo(heapIdx: i32, exprIx: i32, fnIx: i32) {
  emitArmUnboxCast(
    heapIdx,
    narrowedNulStructArm(exprIx) || exprTyIsRecord(exprIx, true, fnIx),
  )
}

// That unbox with its nullability given, for a destination that knows it is a niche. A
// destination whose heap is the box itself takes the box as it is.
function emitArmUnboxCast(heapIdx: i32, nullable: boolean) {
  if heapIdx < 0 || heapIdx == uBoxIdx { return 0 }
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  if nullable { fbRefCastNull(heapIdx) } else { fbRefCast(heapIdx) }
  0
}

// The pair, applied at a delivery boundary: emit `exprIx`, then unbox it when it arrives as a
// narrowed arm's box and `heapIdx` names the slot it has to land in. A value that is already
// the bare arm emits unchanged, so every site can call this in place of its `emitExpr`.
function emitArmDelivery(
  body: u8[],
  exprIx: i32,
  fnIx: i32,
  heapIdx: i32,
  ec: ExpCtx,
) {
  const owed = narrowedArmNeedsUnbox(exprIx, fnIx)
  if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
  if owed && heapIdx >= 0 { emitNarrowedArmUnboxTo(heapIdx, exprIx, fnIx) }
  0
}

// The heap a code-15 struct field's slot names — `(ref null $sHeapIdx[target])`. -1 where the
// target row does not resolve, which leaves the delivery above emitting what it otherwise emits
// rather than reading `sHeapIdx[-1]` (the `fbValtype` bounds discipline).
function sFieldTgtHeapOf(si: i32, fi: i32): i32 {
  const t = sFieldTgtStructIdx(si, fi)
  if t < 0 || t >= sHeapIdx.length { return -1 }
  sHeapIdx[t]
}

// The heap a destination names, from the (kind, slot) pair every boundary already holds — the
// same pair `fbValtype` writes the slot's valtype from, so the cast target and the slot cannot
// disagree. -1 for a kind that is not a struct or variant ref and for an index outside its
// table: the delivery then emits unchanged rather than reading `uVarHeap[-1]`.

// The heap a ref-list slot's element names, when that element is a struct or variant ref
// (`rlElemKindTbl` 1) — the destination for a narrowed arm delivered into a `Circle[]`. -1 for
// a union-box element (kind 2), which wants the box and is already right, and for every
// composite element kind, whose value is a list, map or closure and never an arm.
function rlElemArmHeapOf(rslot: i32): i32 {
  if rslot < 0 || rslot >= rlElemKindTbl.length { return -1 }
  if rlElemKindTbl[rslot] != RLK_STRUCT { return -1 }
  if rslot >= rlElemHeap.length { return -1 }
  rlElemHeap[rslot]
}

// The slot half of that pair for a module global's cell — read from the same two resolvers the
// assignment arm already reads, so the cast
// target and the declared cell cannot disagree. `globalCellStructIdx` answers the variant index
// for a `variant` or `nulvariant` cell and the struct row for a `struct` one.
function globalCellArmIdx(gLet: i32, kind: VKind): i32 {
  if kind == "nulstruct" { return nulRefStructIdxOfLet(gLet, -1) }
  globalCellStructIdx(gLet)
}

// The arm unbox at a module global's start-fn initializer, the assignment arm's twin: a box
// delivered into a record cell recovers its payload. A `variant` cell's coerce owns its own.
export function emitGlobalInitArmUnbox(gLet: i32, kind: VKind, initIx: i32) {
  if kind == "variant" || !narrowedArmNeedsUnbox(initIx, -1) { return 0 }
  emitNarrowedArmUnboxTo(
    armDestHeapOf(kind, globalCellArmIdx(gLet, kind)),
    initIx,
    -1,
  )
}

function armDestHeapOf(kind: VKind, idx: i32): i32 {
  if idx < 0 { return -1 }
  // EXHAUSTIVE over `VKind` and `_`-less, like the four byte writers: the 27 kinds with
  // no arm DECLINE by name, so a 32nd member is a compile error here rather than a
  // silent -1 that reads as "this arm has no heap type".
  match kind {
    "variant" | "nulvariant" => {
      if idx < uVarHeap.length { return uVarHeap[idx] }
      return -1
    }
    "struct" | "nulstruct" => {
      if idx < sHeapIdx.length { return sHeapIdx[idx] }
      return -1
    }
    "i32" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "i64" | "f64" | "f64list" | "f32" | "v128" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" => {
      // No heap type of its own at an arm destination: a scalar, a list wrapper, a map
      // or a closure reaches its rep through its own writer, never this table pair.
      return -1
    }
  }
}

// Whether a box value fitting variant `vi` may be laid out as another arm (D4056), so its payload
// cannot be cast to `vi`'s struct.
function variantHasCrossTagFits(vi: i32, exprIx: i32, fnIx: i32): boolean {
  if vi < 0 || vi >= uVarTyIx.length { return false }
  const rows: i32[] = []
  const kinds: i32[] = []
  crossTagFitRows(vi, uVarTyIx[vi], exprIx, rows, kinds, fnIx)
  rows.length > 0
}

// The refusal for delivering such a box where `vi`'s own struct is expected: the value would
// have to be copied into that layout, which would part it from the original.
function emitFailCrossTagDelivery(exprIx: i32, vi: i32): i32 {
  emitFailAt(
    "emitProgram: a value that fits `"
      + uVariants[vi]
      + "` may be stored as another arm with that field-name set; delivering it as "
      + "that arm would copy it",
    exprIx,
  )
}

// Coerce the expression at `exprIx` to the concrete variant `vi`'s rep `(ref $uVarHeap[vi])`.
// The collapse boundary, where a callback typed as one variant meets a mix of reps: an object
// literal builds the bare variant, a narrowed union value unboxes, an already-bare variant
// passes through, a value-`if` join recurses. The variant analogue of `emitUnionCoerce`.
export function emitVariantCoerce(
  body: u8[],
  vi: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const bareIx = unwrapParen(exprIx)
  if bareIx < 0 { return -1 }
  const bare = nodeAt(bareIx)
  // A `never` call enters any variant, as it enters any union box (D14086).
  if callIsNever(bareIx) { return emitExpr(body, bareIx, fnIx, ec) }
  if bare is IfStmt { return emitVariantIfValue(body, vi, bareIx, fnIx, ec) }
  if bare is ObjLit { return emitVariantStruct(body, bareIx, vi, fnIx, ec) }
  // Already the bare variant struct (a variant param/local/call/index): pass through.
  if exprVariantIndex(exprIx, fnIx) >= 0 {
    return emitVariantPassThrough(body, exprIx, fnIx, ec)
  }
  // A union BOX (a narrowed receiver still boxed at the wasm level): unbox to the variant.
  if exprUnion(exprIx, fnIx) {
    if variantHasCrossTagFits(vi, exprIx, fnIx) {
      return emitFailCrossTagDelivery(exprIx, vi)
    }
    if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    if vi < 0 { return -1 }
    fbRefCast(uVarHeap[vi]) // 0xfb 0x16 <variant struct> ref.cast (non-null)
    return 0
  }
  emitVariantPassThrough(body, exprIx, fnIx, ec)
}

// A value already in the bare variant rep, delivered to a non-null variant destination. D1115 —
// the kind-9/10 recover this pass-through owes, and the one nullable-niche return
// `emitReturnValue`'s guard cannot reach: a `: Circle` result routes here instead. Every
// destination this serves is non-null, so a narrowed nullable operand would hand it a null ref.
function emitVariantPassThrough(
  body: u8[],
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
  if (
    exprNullableRefNiche(exprIx, fnIx)
    && !readOwesNonNullRecover(exprIx, fnIx)
  ) {
    fbRefAsNonNull()
  }
  0
}

// Lower an if-EXPRESSION whose VALUE collapses to the concrete variant `vi` as a value-
// typed `if` with the variant struct result blocktype, each arm variant-coerced. Mirrors
// `emitUnionIfValue` (narrowing save/restore, `else if` recursion).
function emitVariantIfValue(
  body: u8[],
  vi: i32,
  ifIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // An `else if` chain is emitted along its spine, so its depth costs no stack (D1990): each
  // link leaves its frame open for the next, and the frames close innermost-first.
  const open: i32[] = []
  let cur = ifIx
  let rc = 1
  while rc == 1 {
    rc = emitVariantIfValueLink(body, vi, cur, fnIx, open, ec)
    if rc == 1 {
      const link = nodeAt(unwrapParen(cur))
      if link is IfStmt { cur = link.ifElse }
    }
  }
  closeIfChainFrames(open, rc, false)
}

// One link of `emitVariantIfValue`: 0 or -1 as that function returns, or 1 when the else is another `if`
// and this link's frame is left open (its else restore target pushed onto `open`).
function emitVariantIfValueLink(
  body: u8[],
  vi: i32,
  ifIx: i32,
  fnIx: i32,
  open: i32[],
  ec: ExpCtx,
) {
  const s = nodeAt(ifIx)
  if s is IfStmt {
    // An else-less `if` used as a value is `T | null` (`DECISIONS.md`): the variant rep's null
    // is `ref.null $uVarHeap[vi]`, so the blocktype goes nullable with it (`fbRefNullOfKind` is
    // `fbValtypeNullable`'s value twin).
    const noElse = s.ifElse < 0
    const condStart = wLen()
    if emitCondExpr(body, s.ifCond, fnIx, ec) < 0 { return -1 }
    const sg = staticIsGuard(s.ifCond, condStart)
    fbOpenIf() // 0x04 if
    if noElse {
      fbValtypeNullable("variant", vi) // `(ref null $(uVarHeap[vi]))`
    } else {
      fbValtype("variant", vi) // result blocktype: the variant struct `(ref $(uVarHeap[vi]))`
    }
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    let rcT = 0
    if sg == 0 {
      rcT = emitDeadValueArm(s.ifThen)
    } else {
      rcT = emitVariantIfArm(body, vi, s.ifThen, fnIx, ec)
    }
    if narrowed { restoreNarrow(savedTop) }
    if rcT < 0 { return -1 }
    fbElse() // 0x05 else
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    let rc = 0
    if noElse {
      rc = fbRefNullOfKind("variant", vi)
    } else {
      const els = nodeAt(s.ifElse)
      if els is IfStmt {
        if narrowedElse { open.push(savedElseTop) } else { open.push(-1) }
        return 1 // `else if`: the next link, which the caller emits into this open frame
      } else if sg == 1 {
        rc = emitDeadValueArm(s.ifElse)
      } else {
        rc = emitVariantIfArm(body, vi, s.ifElse, fnIx, ec)
      }
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    return 0
  }
  emitFail("emitProgram: expected a variant if-expression")
}

// One arm of a variant if-expression: the arm's prelude, then its tail-value statement
// coerced to the concrete variant rep.
function emitVariantIfArm(
  body: u8[],
  vi: i32,
  blockIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const b = nodeAt(blockIx)
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if tailIsValueOrNever(tv, fnIx) {
        if emitIfArmOpen(body, blockIx, fnIx, ec) < 0 {
          return emitIfArmClose(-1)
        }
        return emitIfArmClose(emitVariantCoerce(body, vi, tv, fnIx, ec))
      }
      // An arm ending in an if-expression joins at the same variant, as the union twin does.
      if nodeAt(unwrapParen(tv)) is IfStmt {
        if emitIfArmOpen(body, blockIx, fnIx, ec) < 0 {
          return emitIfArmClose(-1)
        }
        return emitIfArmClose(
          emitVariantIfValue(body, vi, unwrapParen(tv), fnIx, ec),
        )
      }
    }
    return ifArmNoValueFail("variant if-expression arm", blockIx)
  }
  emitFail("emitProgram: variant if-expression arm is not a block")
}

// ── union `==` and `!=` ─────────────────────────────────────────────────────

// `==` and `!=` are structural by value, so a still-boxed value-union operand compares by "does
// the box's tag select the arm whose rep matches the other side, and does the unboxed payload
// value-equal it". The tag compare gates the payload compare — the payload `ref.cast` would
// trap on a wrong-rep arm — as a value-typed `if`, which is the short-circuit needed.

// This emitter re-evaluates the operand rather than hoisting each box into a fresh local, the
// established struct-`==` pattern, so a union operand is restricted to a simple binding read:
// re-reading an ident is effect-free and yields the same box. Anything effectful fails loudly.

// Unbox a union payload already pushed as `anyref` (`struct.get $box 1`) to the rep of the arm
// whose value-atom kind is `k`: a string payload (kind 2) is the string array, cast only; a
// scalar rides its per-rep value box, cast plus field 0. Mirrors `emitValueUnionUnboxRead`.

// Keyed on the atom's code and not its spelling: `atom == "string"` and `vbHeapIdxOfKind` are
// both projections of that one code, and every caller already holds it — the box tag it emits
// one instruction earlier is `scalarTagOfKind` of the same code. A member that is not a value
// atom reaches `vbHeapIdxOfKind(-1)` and the same loud reject.
function emitUnionPayloadUnbox(_body: u8[], k: i32) {
  if k == 2 {
    fbRefCast(sTypeIdx) // the payload IS the string array ref
    return 0
  }
  // A list arm rides the box's `value` field as its wrapper ref, exactly as a string does —
  // `emitUnionUnboxTail`'s ladder, which every other reader of a boxed list arm takes. Without
  // this rung a list arm reaches the scalar value-box lookup and refuses with "atom has no
  // value box" on a `vl check`-clean program.

  // D1098 — a closure arm's payload is the closure fat-pointer struct, exactly as
  // `emitUnionUnboxTail` recovers it for a narrowed read. Without this rung it reaches the
  // scalar value-box lookup and refuses the same way.
  if k == 11 {
    fbRefCast(cloStructIdx)
    return 0
  }
  const lw = listWrapHeapOfKind(k)
  if lw >= 0 {
    fbRefCast(lw)
    return 0
  }
  const vb = vbHeapIdxOfKind(k)
  if vb < 0 { return emitFail("emitProgram: union `==` atom has no value box") }
  fbRefCast(vb)      // 0xfb 0x16 <value box>
  fbStructGet(vb, 0) // the scalar payload
  0
}

// The per-arm payload compare of a union `==`, with both payloads already unboxed to the arm's
// rep and on the stack (left below right), leaving the 0/1 answer. One home for the three
// union-`==` lowerings — union against union over a value union, over a struct union, and union
// against concrete — so a rep that compares at one spelling cannot refuse at another.
function emitUnionAtomPayloadEq(body: u8[], k: i32, fnIx: i32, ec: ExpCtx) {
  if k == 2 { return emitStrEqCore(body) }
  // D1098 — two closures are equal by function IDENTITY (id + env), a separate core with its
  // own frame (`cloEqNoteBin`), and this ladder is where the arm reaches it.
  if k == 11 { return emitCloEqCore(body) }
  const lk = leqCoreKindOfAtomKind(k)
  if lk >= 0 { return emitListEqAnyRep(body, lk, 0, fnIx, ec) }
  // D-EQOPCODE: the scalar payload compare's opcode is another projection of the same code
  // that chose the tag and the unbox, not a fresh question about the arm's spelling.
  fbI32Bin(atomEqOpcodeOfKind(k))
  0
}

// Emit the concrete operand at `otherIx` in the rep of the arm whose value-atom kind is `k` — an
// i32 literal widens to the arm's i64, f64 or f32. Keyed on the code: the three spellings this
// would otherwise compare are the codes 3 / 4 / 5, which `valueAtomKind` assigns to `i64`, `f64`
// and `f32` and to no other spelling, so the caller's single derivation answers all three.
function emitUnionEqOther(
  body: u8[],
  otherIx: i32,
  k: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if k == 3 { return emitExprAsI64(body, otherIx, fnIx, ec) }
  if k == 4 { return emitExprAsF64(body, otherIx, fnIx, ec) }
  // The STRING arm's widening twin of the three numeric ones: a literal-union ATOM operand
  // becomes its member string (`emitStrValue`), which is the rep the box's string payload is
  // compared against. `emitStrValue` is `emitExpr` for everything that is already a string.
  if k == 2 { return emitStrValue(body, otherIx, fnIx, ec) }
  if k == 5 { return emitExprAsF32(body, otherIx, fnIx, ec) }
  emitExpr(body, otherIx, fnIx, ec)
}

// The interned member set of the union box at `boxIx`, whose union name is `uname`: the row the
// name binds, else the row its arena type keys to. A list element, a call result or a parameter
// can carry an annotation spelling no row is bound under (`K|null|i32`), and with no set the
// box's literal-union arm reads as absent (D12050). -1 when neither names a row.
function msSetOfUnionBox(boxIx: i32, uname: string, fnIx: i32): i32 {
  msSetOfNameTy(uname, nodeTyInOf(unwrapParen(boxIx), fnIx))
}

// Union against a concrete value, in either operand order: the box's tag must select the arm
// whose rep matches the other side, then the unboxed payload value-compares it. A rep with no
// arm is statically unequal, `==` 0 and `!=` 1, with both operands still evaluated for side
// effects, box side first. `isNe` negates the result for `!=`.
function emitUnionConcreteEq(
  body: u8[],
  boxIx: i32,
  otherIx: i32,
  isNe: boolean,
  fnIx: i32,
  ec: ExpCtx,
) {
  // D972 — a non-re-readable operand is stashed at its first read, not refused. This compare
  // reads the box up to three times — the no-arm fold, the tag, and the payload inside the
  // tag-matched arm — which is the whole content of `unionEqOperandOk` (Ident, NumLit, StrLit,
  // Member, Index). A call operand is not re-readable.

  // Teed at the first read rather than pre-emitted at the top: the operand must be evaluated
  // where the original code evaluated it, so any context the surrounding lowering seeds is still
  // in force. Pre-emitting it ahead of the gates traps.
  const eqStash = unionEqStashSlot()
  const eqOnce = !unionEqOperandOk(boxIx)
  const uname = unionNameOfExpr(boxIx, fnIx)
  // D-VALUNION / D-SETONCE: the union's interned member set, resolved ONCE — the
  // value-union gate below reads its banked member codes instead of re-splitting the
  // rendering.
  const usid = msSetOfUnionBox(boxIx, uname, fnIx)
  // The arm spellings with a declared alias resolved, and the litunion-arm shape admitted beside
  // the plain value union — the same two lines `emitUnionLitIs` carries, for the same reason: a
  // `K | i32` box is a value-union box with the litunion arm riding it as its member string, and
  // both the gate and the arm-membership test read a name.
  const unmArms = unionMemberSetOf(uname)
  // D1071 — the other operand's rep code, with a real "not an atom" answer. `-1` here is out of
  // band; the two branches below are the only readers, and both consume the code rather than a
  // spelling. `valueAtomNameOfKind` re-derives the spelling for the membership test's decline
  // argument, a bijection over the seven scalar codes and "" above them.
  const eak = unionEqAtomKindOf(otherIx, unmArms, usid, fnIx)
  const atom = valueAtomNameOfKind(eak)
  if eak < 0 {
    // The operand has no atom rep — a struct, a map, a shape the arena named. The box can still
    // hold it as a variant arm, which is a tag test plus that arm's field compare.
    if emitUnionConcreteVariantEq(body, boxIx, otherIx, isNe, fnIx, ec) == 0 {
      return 0
    }
    return emitFail(
      "emitProgram: `==` over a struct union is not supported yet",
    )
  }
  // A mixed union is comparable to a scalar literal. The compare below is arm-agnostic: it reads
  // the box's tag, compares it to the tag of the atom the other operand names, and on a match
  // compares that one payload. The union's remaining arms are never touched — a container arm
  // simply has a tag that does not match, the right answer, needing no compare core.

  // So requiring the whole union to be a value union is stronger than the lowering needs, and
  // would refuse `v == "b"` over a `Json` carrying list and map arms. Widened only where the
  // other operand names an atom the union actually carries: `unionEqArmPresent` is the same
  // membership test the static-false fold below trusts.

  // A `string`-repped other operand has an arm whenever the box can carry it as a string ref — a
  // plain `string` arm or a literal-union arm, `msSetTakesAtomAsStr`'s question and
  // `emitUnionLitIs`'s second leg. The gate asks it too: an alias arm beside a record (`K | E`)
  // has no banked string kind, and the box carries it as one (D4340).
  let eqHasArm = unionEqArmPresent(usid, unmArms, atom, eak)
  if !eqHasArm && eak == 2 && msSetTakesAtomAsStr(usid) { eqHasArm = true }
  if (
    uname == ""
    || (!isValueUnionOfSet(usid, uname)
      && !unionCarriesLitUnionArm(uname)
      && !eqHasArm)
  ) {
    // The second door to the variant compare, for an operand the arena declined to type
    // (`valueRowKind` -2) and which therefore still carries the ladder's i32 default. The
    // expression itself can still name a concrete variant, and reading it is the only thing
    // that distinguishes "an i32" from "a row the arena has not recorded".
    if emitUnionConcreteVariantEq(body, boxIx, otherIx, isNe, fnIx, ec) == 0 {
      return 0
    }
    return emitFail(
      "emitProgram: `==` over a struct union is not supported yet",
    )
  }
  // Without the string leg above a `K | i32` box statically answers `u == k` false: the banked
  // member kinds carry only `i32`, so the arm that holds the value looks absent.
  if !eqHasArm {
    // No arm has the other operand's rep: the box can never hold such a value.
    if emitExpr(body, boxIx, fnIx, ec) < 0 { return -1 }
    fbDrop() // 0x1a drop
    if emitUnionEqOther(body, otherIx, eak, fnIx, ec) < 0 { return -1 }
    fbDrop() // 0x1a drop
    if isNe { fbI32Const(1) } else { fbI32Const(0) }
    return 0
  }
  if eak == 2 && !aUsed {
    return emitFail(
      "emitProgram: union string `==` but array type not collected",
    )
  }
  // A `K | null` operand equals the box's null when it is `-1`, and is a member string
  // otherwise, where the widened operand is non-null (D3347).
  const nulOther = eak == 2
    && exprNulLitUnion(otherIx, fnIx)
    && unionEqOperandOk(otherIx)
    && !eqOnce
    && unionSetHasNull(uname)
  if nulOther {
    if emitExpr(body, otherIx, fnIx, ec) < 0 { return -1 }
    fbI32Const(-1)
    fbI32Bin(70)
    fbIf(127)
    if emitExpr(body, boxIx, fnIx, ec) < 0 { return -1 }
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, nullBoxTag())
    fbI32Bin(70)
    fbElse()
  }
  // tag == tagOf(atom), gating the payload compare.
  if emitExpr(body, boxIx, fnIx, ec) < 0 { return -1 }
  if eqOnce { fbLocalTee(eqStash) }
  fbStructGet(uBoxIdx, 0) // 0xfb 0x02 <box ht> field 0: tag
  // The CONCRETE operand's own arm type, through the very composition the BOX site uses
  // (`cloBoxArmTy` → `cloArmTagOfTy`), so a closure arm is tested against the tag its box
  // actually writes.
  fbI32Rel(RS_TAG, unionEqTagOfArmTy(eak, cloBoxArmTy(otherIx, uname, fnIx)))
  fbI32Bin(70)            // 0x46 i32.eq
  fbIf(127)               // 0x04 if, 0x7f i32 result blocktype
  if eqOnce { fbLocalGet(eqStash) }
  else if emitExpr(body, boxIx, fnIx, ec) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  if emitUnionPayloadUnbox(body, eak) < 0 { return -1 }
  if emitUnionEqOther(body, otherIx, eak, fnIx, ec) < 0 { return -1 }
  if nulOther {
    fbRefAsNonNull() // the `-1` took the other branch
  }
  // D-EQOPCODE: the payload compare is the last projection of `eak`, which already chose
  // the box tag, the payload unbox and the widened operand emit above it.
  if emitUnionAtomPayloadEq(body, eak, fnIx, ec) < 0 { return -1 }
  fbElse() // 0x05 else: wrong-rep arm — structurally unequal
  fbI32Const(0)
  fbEnd()  // 0x0b end
  if nulOther { fbEnd() }
  if isNe {
    fbI32Eqz() // 0x45 i32.eqz (`!=` negates value-equality)
  }
  0
}

// D1098 — the box tag of one arm of a union `==`, which is `scalarTagOfKind` for every atom
// except a bare closure. A closure arm's tag is keyed on its signature (`cloArmTagOfTy` through
// `cloSigSlotTag`): the first signature a module interns keeps the flat kind-11 offset and each
// further one claims the band above, so `scalarTagOfKind(11)` is right for only one of them.

// The tag has one home — `cloArmTagOfTy`, whose box side is `emitUnionCoerce` and whose test
// side is `isArmTagOfTy`. This routes the compare through it too, so all three derive an arm's
// tag from one render of one arena type; `cloBoxArmTy` names the caller split.
function unionEqTagOfArmTy(k: i32, armTy: i32): i32 {
  if k == 11 { return cloArmTagOfTy(armTy) }
  scalarTagOfKind(k)
}

// Does the union carry an arm at the other operand's rep? One question, two instruments, split
// on whether the code has a spelling: the seven scalar codes take the banked `unionHasAtomK`
// with its keyword fall-through, and a container code — which `valueAtomNameOfKind` cannot name,
// 7 being `i32[]` and `boolean[]` and `K[]` — takes the member walk. Both readers ask here.
function unionEqArmPresent(
  usid: i32,
  unmArms: string,
  atom: string,
  eak: i32,
): boolean {
  if atom == "" { return unionHasAtomKindArm(unmArms, eak) }
  unionHasAtomK(usid, unmArms, atom, eak)
}

// D1180 — the variant row the concrete operand's value actually has, which is not always the row
// `exprVariantIndex` names. That resolver is rep-authoritative over bindings, so it carries a leg
// per storage class and none for a struct-field read, and an un-annotated object literal is
// declined once the struct table holds a row matching its field set.

// The bridge is heap identity, not shape matching: `sHeapIdx` and `uVarHeap` are two index spaces
// over one wasm type space, and two rows that interned to the same wasm struct type hold
// interchangeable values. Where they interned separately this answers -1 and the caller keeps its
// loud refusal. Exactly one match, or none: two arms sharing a heap type do not fix the tag.
function eqConcreteVariantRow(exprIx: i32, fnIx: i32) {
  const vi = exprVariantIndex(exprIx, fnIx)
  if vi >= 0 { return vi }
  // The nullable-niche storage class. A code-15 field read whose target is a union arm binds
  // `nulvariant` (D1112), which `exprVariantIndex` declines because that resolver is the non-null
  // one, and which `structIndexOfExpr` declines because an arm has no `sNames` row — so a cell
  // between the two kinds falls through both rungs to the caller's loud refusal.

  // Asked ahead of the heap scan because it is the exact answer: the bridge below infers a row
  // from heap identity and must decline an ambiguous match, while this reads the arm the
  // checker's own type names. The value is the same nullable niche the `nulstruct` operand parks,
  // and the field `struct.get` traps on null exactly as it does for that one.
  const nvi = nulVariantIdxOfExpr(exprIx, fnIx)
  if nvi >= 0 { return nvi }
  const ssi = structIndexOfExpr(exprIx, fnIx)
  if ssi < 0 { return -1 }
  if ssi >= sHeapIdx.length { return -1 }
  const h = sHeapIdx[ssi]
  let found = -1
  let i = 0
  while i < uVarHeap.length {
    if uVarHeap[i] == h {
      if found >= 0 { return -1 }
      found = i
    }
    i = i + 1
  }
  found
}

// D1071 — union `==` a concrete variant (`p == a` with `p: A | i32` and `a: A`). The box's tag
// selects the arm, and on a match that arm's payload is compared field-wise against the concrete
// operand — the union-against-union compare with one side's unbox deleted. -1 declines.

// The concrete operand already has the arm's heap type: when a union is declared the union path
// owns the struct types, so a `const a: A = {x: 1}` beside `type A` in an `A | i32` is a
// `(ref $uVarHeap[vi])`. The box is evaluated first and once and both operands are parked, which
// is what lets a non-place operand work here without `emitUnionConcreteEq`'s gate.
function emitUnionConcreteVariantEq(
  body: u8[],
  boxIx: i32,
  otherIx: i32,
  isNe: boolean,
  fnIx: i32,
  ec: ExpCtx,
) {
  const vi = eqConcreteVariantRow(otherIx, fnIx)
  if vi < 0 { return -1 }
  // The same four parallel-table bounds `emitStructUnionEq` takes before it writes a byte,
  // for the same reason: a variant row the emitter's tables do not cover must DECLINE, never
  // read out of bounds (`emitFail does not halt`).
  if vi >= uVarHeap.length { return -1 }
  if vi >= uTags.length { return -1 }
  if vi >= uFieldStart.length { return -1 }
  if vi >= uFieldCount.length { return -1 }
  if !variantFieldsComparable(vi) { return -1 }
  const sl = unionEqStashSlot()
  const ar = unionEqArmSlot(vi + 1024)
  // Both operands ride the wasm stack until both are computed, and only then are they parked.
  // The three scratch slots here are shared per function, not per site, so a union `==` nested
  // inside `otherIx` re-enters this function and re-uses the same slots. A stack value cannot be
  // reached that way, and after the second operand lands no user code runs before the compare.
  if emitExpr(body, boxIx, fnIx, ec) < 0 { return -1 }
  if emitExpr(body, otherIx, fnIx, ec) < 0 { return -1 }
  fbLocalSet(ar)              // pops the concrete operand, leaving the box on top
  fbLocalSet(sl)
  fbLocalGet(sl)
  fbStructGet(uBoxIdx, 0)     // field 0: tag
  fbI32Rel(RS_TAG, uTags[vi]) // the arm's program-global tag
  fbI32Bin(70)                // 0x46 i32.eq
  fbIf(127)                   // 0x04 if, i32 result
  const al = unionEqArmSlot(vi)
  fbLocalGet(sl)
  fbStructGet(uBoxIdx, 1)     // field 1: payload (anyref)
  fbRefCast(uVarHeap[vi])
  fbLocalSet(al)
  if emitVariantFieldsEq(body, al, ar, vi, fnIx, ec) < 0 { return -1 }
  fbElse()                    // the box holds a different arm — structurally unequal
  fbI32Const(0)
  fbEnd()
  if isNe { fbI32Eqz() }
  0
}

// D973 — `==` over a struct union (`A | B` of declared shapes), both operands the same set.
// Tags unequal means different arms and therefore unequal; tags equal selects one arm, and that
// arm's fields are compared through the variant table. -1 declines.

// Not `emitStructEqRec`, which is keyed on a struct-table row: that table is empty when a union
// is declared, the union path owning the struct types instead, so the arms' fields live in
// `uFieldNames` and `uFieldTypes` and the compare reads them there. A scalar arm beside the
// struct ones is served too; its tag is `scalarTagOfKind`, which no variant tag can collide with.
function emitStructUnionEq(
  body: u8[],
  lIx: i32,
  rIx: i32,
  isNe: boolean,
  uname: string,
  fnIx: i32,
  ec: ExpCtx,
) {
  const arms: string[] = []
  const vis: i32[] = []
  const aks: i32[] = []
  if !unionBoxEqColumns(uname, arms, vis, aks) { return -1 }
  // Both operands ride the wasm stack until both are computed, and only then are they parked.
  // These slots are shared per function, so a left operand parked before the right one is
  // evaluated is a value the right one's code can overwrite — a nested union `==` re-enters this
  // function and re-uses the two slots. The evaluation order is unchanged: left, then right.
  if emitExpr(body, lIx, fnIx, ec) < 0 { return -1 }
  if emitExpr(body, rIx, fnIx, ec) < 0 { return -1 }
  emitUnionBoxEqStaged(body, arms, vis, aks, isNe, uname, fnIx, ec)
}

// The arm columns of a box `==` over union `uname`, index-parallel to `arms` and mutually
// exclusive: a struct arm carries its variant row in `vis` and -1 in `aks`, a scalar arm the
// reverse. False declines, so an arm set the lowering cannot serve keeps its caller's loud
// refusal — asked before any byte is written, which is why it is its own function.
function unionBoxEqColumns(
  uname: string,
  arms: string[],
  vis: i32[],
  aks: i32[],
): boolean {
  unionMemberAtomsOf(uname, arms)
  if arms.length < 2 { return false }
  let i = 0
  while i < arms.length {
    const vi = variantIndexOf(arms[i])
    if vi < 0 {
      // NOT A VARIANT: the arm is servable exactly when it is a value ATOM whose payload
      // this lowering can unbox and compare — the same bound `emitUnionPayloadUnbox` and
      // `atomEqOpcodeOfKind` enforce, asked BEFORE any byte is written so an unservable arm
      // still DECLINES (keeping the caller's loud message) instead of failing loudly here.
      let ak = valueAtomKind(arms[i])
      if ak < 0 { ak = boxArmKindOfTy(ak, unionArmTyOfAtom(uname, arms[i])) }
      if ak < 0 { return false }
      if ak == 2 {
        if !aUsed { return false }
      } else if ak != nullValKind() && ak != 11 {
        // A list arm is servable too: its payload is the wrapper ref, so the unbox is a
        // `ref.cast` and the compare is the generic list core. A closure arm (11) rides the same
        // shape and compares by identity (D1098). Everything left still needs a scalar value box
        // and declines without one.
        if listWrapHeapOfKind(ak) < 0 {
          if vbHeapIdxOfKind(ak) < 0 { return false }
        }
      }
      vis.push(-1)
      aks.push(ak)
      i = i + 1
      continue
    }
    if vi >= uVarHeap.length { return false }
    if vi >= uTags.length { return false }
    if vi >= uFieldStart.length { return false }
    if vi >= uFieldCount.length { return false }
    if !variantFieldsComparable(vi) { return false }
    vis.push(vi)
    aks.push(-1)
    i = i + 1
  }
  true
}

// The tag-then-arm compare over two boxes already on the stack (left below right), leaving the
// 0/1 answer. Split from the operand evaluation because a box-typed field reaches this same core
// through two chain reads rather than two expressions (D1290), and two callers must not carry two
// copies of the dispatch.
function emitUnionBoxEqStaged(
  body: u8[],
  arms: string[],
  vis: i32[],
  aks: i32[],
  isNe: boolean,
  uname: string,
  fnIx: i32,
  ec: ExpCtx,
) {
  const sl = unionEqStashSlot()
  const sr = unionEqStashSlot2()
  fbLocalSet(sr) // pops the right operand, leaving the left on top
  fbLocalSet(sl)
  // Tags first: two different arms are never equal, and the tag is the arm.
  fbLocalGet(sl)
  fbStructGet(uBoxIdx, 0)
  fbLocalGet(sr)
  fbStructGet(uBoxIdx, 0)
  fbI32Bin(70) // 0x46 i32.eq
  fbIf(127)    // 0x04 if, i32 result
  // Then one arm per tag; the last is the fall-through, so N arms need N-1 tests.
  let a = 0
  while a < vis.length - 1 {
    fbLocalGet(sl)
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, unionArmTagOf(vis[a], aks[a], uname, arms[a]))
    fbI32Bin(70)
    fbIf(127)
    if emitUnionArmEq(body, sl, sr, vis[a], aks[a], fnIx, ec) < 0 { return -1 }
    fbElse()
    a = a + 1
  }
  // The chain's fall-through arm — the tag can only be this one by elimination, so it gets
  // no test of its own.
  const lastRc = emitUnionArmEq(
    body,
    sl,
    sr,
    vis[vis.length - 1],
    aks[aks.length - 1],
    fnIx,
    ec,
  )
  if lastRc < 0 { return -1 }
  let e = 0
  while e < vis.length - 1 {
    fbEnd()
    e = e + 1
  }
  fbElse() // tags differ
  if unionCloArmCount(aks) >= 2 {
    // A function value's identity is its declaration, whichever function-type arm holds it.
    emitUnionCloTagIn(sl, vis, aks, uname, arms)
    fbIf(127)
    emitUnionCloTagIn(sr, vis, aks, uname, arms)
    fbIf(127)
    if emitUnionArmEq(body, sl, sr, -1, 11, fnIx, ec) < 0 { return -1 }
    fbElse()
    fbI32Const(0)
    fbEnd()
    fbElse()
    fbI32Const(0)
    fbEnd()
  } else {
    fbI32Const(0)
  }
  fbEnd()
  if isNe { fbI32Eqz() }
  0
}

// How many of a union's arms are function values (atom kind 11).
function unionCloArmCount(aks: i32[]): i32 {
  let n = 0
  for ak in aks {
    if ak == 11 { n = n + 1 }
  }
  n
}

// Pushes whether the box parked in `slot` sits in one of the union's function-value arms.
function emitUnionCloTagIn(
  slot: i32,
  vis: i32[],
  aks: i32[],
  uname: string,
  arms: string[],
) {
  fbI32Const(0)
  let a = 0
  while a < aks.length {
    if aks[a] == 11 {
      fbLocalGet(slot)
      fbStructGet(uBoxIdx, 0)
      fbI32Rel(RS_TAG, unionArmTagOf(vis[a], aks[a], uname, arms[a]))
      fbI32Bin(70)  // 0x46 i32.eq
      fbI32Bin(114) // 0x72 i32.or
    }
    a = a + 1
  }
  0
}

// Can every field of variant `vi` be compared by this lowering? Codes 0 (i32 / boolean) and
// 3 (string) only — a ref, list or map field would need the recursive machinery the struct
// table carries, and declining keeps the caller's loud refusal for those.
function variantFieldsComparable(vi: i32): boolean {
  const start = uFieldStart[vi]
  const cnt = uFieldCount[vi]
  let j = 0
  while j < cnt {
    if start + j >= uFieldTypes.length { return false }
    if !variantFieldComparable(start + j) { return false }
    j = j + 1
  }
  true
}

// One home for "can this variant field be compared", mirrored arm for arm by
// `emitVariantFieldEqCore`: this one decides and that one emits, so a code admitted here with no
// core there is invalid wasm on a `vl check`-clean program.

// D1096 — the admission is the field's rep, not the three codes the ladder happens to have arms
// for: one unservable field declines the whole compare, so a `{ d: f64 }` arm would refuse
// `p == a` while the identical field compares fine at its direct spelling. Most of those cores
// exist already; `i64` and `f32` are the two the struct ladder does not serve either.
function variantFieldComparable(ufi: i32): boolean {
  const c = uFieldTypes[ufi]
  if c == FC_NUL_NONE {
    return true // `null` has one value: the core drops both reads and answers true
  }
  if c == FC_I32 || c == FC_NUL_BOOL || c == FC_NUL_LIT_UNION {
    // i32 and boolean, and the two i32-sentinel niches that share the slot (D1180) — the struct
    // ladder's own rung. Their null rides in the value space, so `i32.eq` answers `null == null`
    // true with no guard.
    return true
  }
  if c == FC_STR {
    return true // string
  }
  if c == FC_F64 {
    return true // f64
  }
  if c == FC_I64 {
    return true // i64
  }
  if c == FC_F32 {
    return true // f32
  }
  if c == FC_CLOSURE {
    return true // a function-valued field: identity (id + env)
  }
  // D974 — a nested shape field (code 15) is comparable when its shape has an interned struct
  // row, which `collectU` mints for exactly these (`internInlineShapeTy`). No row, no compare —
  // the same decline discipline every other code gets.
  if c == FC_STRUCT { return variantNestedRow(ufi) >= 0 }
  // A ref-list field needs the ref-list slot its element name resolves to, both to reserve the
  // frame and to pick the element core; without one there is no compare to emit.
  if c == FC_REF_LIST { return variantRefListFieldSlot(ufi) >= 0 }
  // A BOX field is comparable when the shared box core can serve every arm (D1290).
  if c == FC_UNION { return variantBoxFieldComparable(ufi) }
  // D1180 — a ref-niche field (`string | null`, `T[] | null`) is its non-null twin's core under
  // a null guard, so it is comparable exactly when that twin is. Same table, same guard and the
  // same admission rule as the struct ladder's: one home, two ladders.
  const cn = nulFieldInnerCode(c)
  if cn >= 0 { return variantFieldCodeComparable(ufi, cn) }
  eqVariantListFieldKind(c) >= 0
}

// Can the shared box core serve every arm of a code-16 variant field's union? The field's
// recorded elem name is the atom-set name the box is built against.
function variantBoxFieldComparable(ufi: i32): boolean {
  const bn = uFieldElemName[ufi]
  if bn == "" { return false }
  const bArms: string[] = []
  const bVis: i32[] = []
  const bAks: i32[] = []
  unionBoxEqColumns(bn, bArms, bVis, bAks)
}

// The admission question keyed by an EXPLICIT code, so the niche rung above can ask it of the
// non-null twin without re-entering the niche arm.
function variantFieldCodeComparable(ufi: i32, c: i32): boolean {
  if c == FC_I32 || c == FC_NUL_BOOL || c == FC_NUL_LIT_UNION { return true }
  if c == FC_STR { return true }
  if c == FC_F64 { return true }
  if c == FC_I64 { return true }
  if c == FC_F32 { return true }
  if c == FC_CLOSURE { return true }
  if c == FC_STRUCT { return variantNestedRow(ufi) >= 0 }
  if c == FC_REF_LIST { return variantRefListFieldSlot(ufi) >= 0 }
  eqVariantListFieldKind(c) >= 0
}

// The ref-list slot of the code-5 variant field at flat row `ufi`, or -1 — keyed by the
// field's recorded element type, as `variantFieldRefSlot` keys it by (variant, field).
function variantRefListFieldSlot(ufi: i32): i32 {
  if uFieldElemName[ufi] == "" { return 0 - 1 }
  if ufi >= uFieldElemTyIx.length { return 0 - 1 }
  rlSlotOfTyOrTwin(uFieldElemTyIx[ufi])
}

// D1061 — the box tag of one arm of a mixed struct/scalar union, from whichever of the two
// per-arm columns holds it. The two tag spaces are disjoint by construction: a variant tag is an
// index into `uVariants` and `scalarTagOfKind(k)` is `uVariants.length + k`.
function unionArmTagOf(vi: i32, ak: i32, uname: string, atom: string): i32 {
  if vi >= 0 { return uTags[vi] }
  unionEqTagOfArmTy(ak, unionArmTyOfAtom(uname, atom))
}

// D1061 — one arm of a mixed struct/scalar union, dispatched on which column named it. The
// tag test that selects this arm has ALREADY proved both boxes carry it, so each half only
// has to compare the arm's own payload.
function emitUnionArmEq(
  body: u8[],
  sl: i32,
  sr: i32,
  vi: i32,
  ak: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if vi >= 0 { return emitVariantArmEq(body, sl, sr, vi, fnIx, ec) }
  // The NULL arm carries no payload at all: two boxes that agree on the null tag are equal,
  // and the enclosing tag test is that agreement.
  if ak == nullValKind() {
    fbI32Const(1)
    return 0
  }
  fbLocalGet(sl)
  fbStructGet(uBoxIdx, 1)
  if emitUnionPayloadUnbox(body, ak) < 0 { return -1 }
  fbLocalGet(sr)
  fbStructGet(uBoxIdx, 1)
  if emitUnionPayloadUnbox(body, ak) < 0 { return -1 }
  emitUnionAtomPayloadEq(body, ak, fnIx, ec)
}

// One arm: cast both payloads to the arm's variant heap, park them, and AND the fields.
function emitVariantArmEq(
  body: u8[],
  sl: i32,
  sr: i32,
  vi: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const al = unionEqArmSlot(vi)
  const ar = unionEqArmSlot(vi + 1024)
  fbLocalGet(sl)
  fbStructGet(uBoxIdx, 1)
  fbRefCast(uVarHeap[vi])
  fbLocalSet(al)
  fbLocalGet(sr)
  fbStructGet(uBoxIdx, 1)
  fbRefCast(uVarHeap[vi])
  fbLocalSet(ar)
  emitVariantFieldsEq(body, al, ar, vi, fnIx, ec)
}

// AND the fields of variant `vi` over two already-cast variant refs parked in `al` and `ar`,
// leaving one i32. Split from `emitVariantArmEq` because the two operands do not always both
// arrive out of a box: a union compared against a concrete variant (D1071) unboxes only the left
// one and parks the right operand's own value directly. Only the unbox differs.
function emitVariantFieldsEq(
  body: u8[],
  al: i32,
  ar: i32,
  vi: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // Only the hole is refused here because both callers already took the same four bounds —
  // `emitStructUnionEqConcrete` spells them out, and every `vis` entry the staged compare
  // passes came through `unionBoxEqColumns`, which declines a row the four tables miss.
  if vi < 0 { return -1 }
  const start = uFieldStart[vi]
  const cnt = uFieldCount[vi]
  fbI32Const(1)
  let j = 0
  while j < cnt {
    // D1180 — a ref-niche field, and a code-15 field whose slot is `(ref null $S)` at both
    // spellings, take the null guard: the payload may legitimately be `null`, and the core
    // underneath would `struct.get` it. Without the guard an `Inner | null` arm field is
    // `vl check` rc 0 and traps on `{d: null} == {d: null}`.
    const jc = uFieldTypes[start + j]
    const jn = nulFieldInnerCode(jc)
    if jn >= 0 || jc == FC_STRUCT {
      let inner = jc
      if jn >= 0 { inner = jn }
      if (
        emitVariantNulFieldEq(body, al, ar, vi, j, start + j, inner, fnIx, ec)
        < 0
      ) {
        return -1
      }
    } else {
      fbLocalGet(al)
      fbStructGet(uVarHeap[vi], j)
      fbLocalGet(ar)
      fbStructGet(uVarHeap[vi], j)
      if emitVariantFieldEqCore(body, start + j, fnIx, ec) < 0 { return -1 }
    }
    fbI32Bin(113) // 0x71 i32.and
    j = j + 1
  }
  0
}

// `al.f == ar.f` for a nullable-slotted arm field: the struct ladder's guard, spelled over the
// two parked variant refs instead of a chain path. Both re-reads are `local.get` + `struct.get`
// — free — so the guard needs no scratch.
function emitVariantNulFieldEq(
  body: u8[],
  al: i32,
  ar: i32,
  vi: i32,
  j: i32,
  ufi: i32,
  inner: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  fbLocalGet(al)
  fbStructGet(uVarHeap[vi], j)
  fbRefIsNull()
  fbIf(127)     // the left field was null
  fbLocalGet(ar)
  fbStructGet(uVarHeap[vi], j)
  fbRefIsNull() // both null ⇒ equal
  fbElse()
  fbLocalGet(ar)
  fbStructGet(uVarHeap[vi], j)
  fbRefIsNull()
  fbIf(127)
  fbI32Const(0) // exactly one side null
  fbElse()
  fbLocalGet(al)
  fbStructGet(uVarHeap[vi], j)
  fbRefAsNonNull()
  fbLocalGet(ar)
  fbStructGet(uVarHeap[vi], j)
  fbRefAsNonNull()
  if emitVariantFieldEqCoreAt(body, ufi, fnIx, inner, ec) < 0 { return -1 }
  fbEnd()
  fbEnd()
  0
}

// ONE field's compare, with both values already on the stack (left below right), leaving the
// 0/1 answer. `variantFieldComparable` is this function's admission gate and the two are
// mirrored arm for arm; the floor below is unreachable through that gate and is a floor, not
// a capability refusal.
function emitVariantFieldEqCore(body: u8[], ufi: i32, fnIx: i32, ec: ExpCtx) {
  emitVariantFieldEqCoreAt(body, ufi, fnIx, uFieldTypes[ufi], ec)
}

// The same ladder keyed by an EXPLICIT code — what the null guard re-enters at the niche's
// non-null twin.
function emitVariantFieldEqCoreAt(
  body: u8[],
  ufi: i32,
  fnIx: i32,
  c: i32,
  ec: ExpCtx,
) {
  if c == FC_NUL_NONE {
    // Both sides hold only `null`: drop the two reads, the field always agrees.
    fbDrop()
    fbDrop()
    fbI32Const(1)
    return 0
  }
  if c == FC_I32 || c == FC_NUL_BOOL || c == FC_NUL_LIT_UNION {
    fbI32Bin(70) // 0x46 i32.eq — and the two i32-sentinel niches, see the gate
    return 0
  }
  if c == FC_STR { return emitStrEqCore(body) }
  if c == FC_STRUCT { return emitNestedShapeEq(body, ufi, ec) }
  if c == FC_F64 {
    fbI32Bin(97) // 0x61 f64.eq
    return 0
  }
  if c == FC_I64 {
    fbI32Bin(81) // 0x51 i64.eq
    return 0
  }
  if c == FC_F32 {
    fbI32Bin(91) // 0x5b f32.eq
    return 0
  }
  // A function-valued field is compared by IDENTITY (id + env), the same core a standalone
  // struct's code-14 field takes.
  if c == FC_CLOSURE { return emitCloEqCore(body) }
  if c == FC_REF_LIST {
    return emitListEqAnyRep(
      body,
      LBK_REF,
      variantRefListFieldSlot(ufi),
      fnIx,
      ec,
    )
  }
  if c == FC_UNION {
    if ufi < 0 { return -1 }
    const vbN = uFieldElemName[ufi]
    const vbArms: string[] = []
    const vbVis: i32[] = []
    const vbAks: i32[] = []
    if !unionBoxEqColumns(vbN, vbArms, vbVis, vbAks) { return -1 }
    return emitUnionBoxEqStaged(
      body,
      vbArms,
      vbVis,
      vbAks,
      false,
      vbN,
      fnIx,
      ec,
    )
  }
  const lk = eqVariantListFieldKind(c)
  if lk >= 0 { return emitListEqAnyRep(body, lk, 0, fnIx, ec) }
  emitFail("emitProgram: unsupported variant field type in equality")
}

// D974 — the interned struct row of a variant field's NESTED shape, or -1.
function variantNestedRow(ufi: i32): i32 {
  const nm = uFieldElemName[ufi]
  if nm == "" { return -1 }
  // A NAMED nested type (`type C = {r: i32}` as an arm's field) has a struct row under its
  // NAME; only an INLINE shape needs interning. Asking the name first is what makes the
  // common spelling resolve — `internInlineShapeTy("C", …)` answers -1 for it.
  const named = structIdxOfElemName(nm)
  if named >= 0 && named < sHeapIdx.length { return named }
  const row = internInlineShapeTy(nm, uFieldElemTyIxRow(ufi))
  if row < 0 { return -1 }
  if row >= sHeapIdx.length { return -1 }
  row
}

// Compare two NESTED shape refs already on the stack, field-wise. Unlike the arms themselves,
// a nested shape HAS an interned struct row, so `emitStructEqRec` is available — it just needs
// its operands parked, which is what its `-2` / `-3` sentinels read.
function emitNestedShapeEq(body: u8[], ufi: i32, ec: ExpCtx) {
  const row = variantNestedRow(ufi)
  if row < 0 { return -1 }
  const nl = structEqStashSlot(row)
  const nr = structEqStashSlot(row + 1024)
  fbLocalSet(nr)
  fbLocalSet(nl)
  const savedL = eqStashL
  const savedR = eqStashR
  eqStashL = nl
  eqStashR = nr
  const pathSi: i32[] = []
  const pathFi: i32[] = []
  const r = emitStructEqRec(
    body,
    -2,
    -3,
    row,
    pathSi,
    pathFi,
    fnIxOfNothing(),
    ec,
  )
  eqStashL = savedL
  eqStashR = savedR
  r
}

// `emitStructEqRec` takes a frame index only to resolve EXPRESSION operands; the stash-sentinel
// path never reaches that, so -1 is the honest argument rather than a borrowed frame.
function fnIxOfNothing(): i32 { -1 }

// Union against union: equal iff the same arm (tag) holds and the unboxed payloads value-compare
// equal per that arm. Folded as a nested value-typed `if` chain over the shared non-null arms,
// bottoming out at bare tag equality — which covers the `null` arm and any non-shared arm. The
// right payload's unbox short-circuits on its tag too.
function emitUnionUnionEq(
  body: u8[],
  lIx: i32,
  rIx: i32,
  isNe: boolean,
  fnIx: i32,
  ec: ExpCtx,
) {
  const lname = unionNameOfExpr(lIx, fnIx)
  const rname = unionNameOfExpr(rIx, fnIx)
  // D973 — the struct-union path is tried before the re-readability gate, because it does not
  // need it: it evaluates each operand once into its own slot and reads the slots. The gate
  // exists for the value-union lowering below, which re-reads both sides per arm.
  if lname != "" && lname == rname {
    if !isValueUnionOfSet(msSetOfUnion(lname), lname) {
      if emitStructUnionEq(body, lIx, rIx, isNe, lname, fnIx, ec) == 0 {
        return 0
      }
    }
  }
  if !unionEqOperandOk(lIx) || !unionEqOperandOk(rIx) {
    // An operand that cannot be re-read is evaluated once and compared by the staged core,
    // over the left union's arms: tags are per atom, so a right-hand arm the left lacks
    // fails the tag test, and a shared tag names the same payload rep on both sides.
    const sArms: string[] = []
    const sVis: i32[] = []
    const sAks: i32[] = []
    if (
      lname != ""
      && rname != ""
      && unionBoxEqColumns(lname, sArms, sVis, sAks)
    ) {
      if emitExpr(body, lIx, fnIx, ec) < 0 { return -1 }
      if emitExpr(body, rIx, fnIx, ec) < 0 { return -1 }
      return emitUnionBoxEqStaged(
        body,
        sArms,
        sVis,
        sAks,
        isNe,
        lname,
        fnIx,
        ec,
      )
    }
    return emitFail(
      "emitProgram: union `==` over a non-binding union value is not supported yet",
    )
  }
  // Both operands' member sets are resolved once, here, and every later reader takes the id —
  // rather than the gate re-splitting the rendering and each consumer resolving it again.
  const lsid = msSetOfUnion(lname)
  const rsid = msSetOfUnion(rname)
  // A literal-union arm rides a value box as its member string, so it compares as one (D3347).
  const lVal = isValueUnionOfSet(lsid, lname) || unionCarriesLitUnionArm(lname)
  const rVal = isValueUnionOfSet(rsid, rname) || unionCarriesLitUnionArm(rname)
  if !lVal || !rVal {
    // A struct union compares by tag, then by the arm's fields (D973), riding the same
    // `{tag, payload}` box a value union does. Reaching here means `emitStructUnionEq` declined
    // the arm set, so the refusal names what it could not serve.
    return emitFail(
      "emitProgram: `==` over a struct union is not supported yet",
    )
  }
  // The shared non-null arms, matched by atom, since atoms tag globally. Both operands' member
  // lists come from the recorded member columns when the pool covers them — `msMemberAtomsOf`
  // hands back exactly the atoms `splitUnionAtoms` would, in the row's recorded box-tag order —
  // so the intersection walks two recorded lists. Each side declines independently.

  // The membership compare stays the verbatim spelling compare `unionHasAtom` performs, not
  // `unMemHasAtom`'s keyword-primitive test: an arm spelled `(() => i64)` or a litunion alias is
  // a member here and answers no there. The left row's banked value-atom codes travel with the
  // surviving arms, index-parallel to the atom column; an uncovered row marks its arms -2.
  const lAtoms: string[] = []
  if !msMemberAtomsOfSet(lsid, lAtoms) {
    // `unionSetArmTysAB` appends the atoms whether or not every member type resolved.
    const lMems: i32[] = []
    unionSetArmTysAB(
      96,
      lname,
      unionDeclTyIxOfIdentRead(lIx, fnIx),
      lAtoms,
      lMems,
    )
  }
  const lKinds: i32[] = []
  let lKindsOk = msMemberValKindsOf(lsid, lKinds)
  if lKinds.length != lAtoms.length { lKindsOk = false }
  const rAtoms: string[] = []
  let rOk = msMemberAtomsOfSet(rsid, rAtoms)
  if !rOk {
    // The right list needs the same alias expansion as the left. Without it the intersection
    // below falls to `unionHasAtom(rname, …)`, which answers false for a declared union's own
    // atoms, every arm is filtered out, and the loop emits nothing — so control reaches the
    // tag-only fallback and `==` compares just the two tags (D989).
    const rMems: i32[] = []
    if (
      unionSetArmTysAB(
        97,
        rname,
        unionDeclTyIxOfIdentRead(rIx, fnIx),
        rAtoms,
        rMems,
      )
    ) {
      rOk = true
    }
  }
  const arms: string[] = []
  const armKinds: i32[] = []
  let ai = 0
  while ai < lAtoms.length {
    let inR = false
    if rOk {
      let rj = 0
      while rj < rAtoms.length {
        if rAtoms[rj] == lAtoms[ai] { inR = true }
        rj = rj + 1
      }
    } else {
      inR = unionHasAtomAB(25, rname, nodeTyIxOf(unwrapParen(rIx)), lAtoms[ai])
    }
    if lAtoms[ai] != "null" && inR {
      arms.push(lAtoms[ai])
      if lKindsOk { armKinds.push(lKinds[ai]) } else { armKinds.push(-2) }
    }
    ai = ai + 1
  }
  if (
    unionHasAtomK(lsid, lname, "string", 2)
    && unionHasAtomK(rsid, rname, "string", 2)
    && !aUsed
  ) {
    return emitFail(
      "emitProgram: union string `==` but array type not collected",
    )
  }
  // The READ half of the banked-kind pair: the arm's recorded code, or a per-atom derivation
  // where the bank did not cover the row. Both sides read the LEFT union's arm type — the
  // intersection above matched the two arms by verbatim SPELLING, so they render the same
  // signature and claim the same slot.
  const armKs: i32[] = []
  const armTys: i32[] = []
  const cloTags: i32[] = []
  let ki = 0
  while ki < arms.length {
    let armK = armKinds[ki]
    if armK == -2 { armK = valueAtomKind(arms[ki]) }
    const armTy = unionArmTyOfAtom(lname, arms[ki])
    armK = boxArmKindOfTy(armK, armTy)
    armKs.push(armK)
    armTys.push(armTy)
    if armK == 11 { cloTags.push(unionEqTagOfArmTy(armK, armTy)) }
    ki = ki + 1
  }
  // Outermost `if` is the LAST arm (the host wraps its chain in arm order).
  let k = arms.length - 1
  while k >= 0 {
    const armK = armKs[k]
    if emitExpr(body, lIx, fnIx, ec) < 0 { return -1 }
    // The arm's TAG, not `scalarTagOfKind(armK)`: a closure arm tags by SIGNATURE.
    const armTag = unionEqTagOfArmTy(armK, armTys[k])
    fbStructGet(uBoxIdx, 0) // left tag
    fbI32Rel(RS_TAG, armTag)
    fbI32Bin(70)            // 0x46 i32.eq
    fbIf(127)               // left holds this arm
    // A function value's identity is its declaration, whichever function-type arm holds it, so
    // a closure arm admits the right operand in any closure arm; the payload rep is shared.
    const rightTags: i32[] = []
    if armK == 11 {
      for t in cloTags { rightTags.push(t) }
    } else {
      rightTags.push(armTag)
    }
    let ti = 0
    while ti < rightTags.length {
      if emitExpr(body, rIx, fnIx, ec) < 0 { return -1 }
      fbStructGet(uBoxIdx, 0) // right tag
      fbI32Rel(RS_TAG, rightTags[ti])
      fbI32Bin(70) // 0x46 i32.eq
      if ti > 0 {
        fbI32Bin(114) // 0x72 i32.or
      }
      ti = ti + 1
    }
    fbIf(127)               // right holds it too → payload value-compare
    if emitExpr(body, lIx, fnIx, ec) < 0 { return -1 }
    fbStructGet(uBoxIdx, 1) // left payload (anyref)
    if emitUnionPayloadUnbox(body, armK) < 0 { return -1 }
    if emitExpr(body, rIx, fnIx, ec) < 0 { return -1 }
    fbStructGet(uBoxIdx, 1) // right payload (anyref)
    if emitUnionPayloadUnbox(body, armK) < 0 { return -1 }
    // D-EQOPCODE: `armK` came out of the banked `unMemValKind` column (or the per-atom
    // derivation where the row is uncovered) and already decided the two tag compares and
    // both payload unboxes above — the compare is the same code's fifth projection, not a
    // fresh question about `arms[k]`'s spelling.
    if emitUnionAtomPayloadEq(body, armK, fnIx, ec) < 0 { return -1 }
    fbElse() // right holds a different arm → unequal
    fbI32Const(0)
    fbEnd()
    fbElse() // left holds an earlier arm → recurse down the chain
    k = k - 1
  }
  // Chain bottom: bare tag equality (null arm / non-shared arms).
  if emitExpr(body, lIx, fnIx, ec) < 0 { return -1 }
  fbStructGet(uBoxIdx, 0)
  if emitExpr(body, rIx, fnIx, ec) < 0 { return -1 }
  fbStructGet(uBoxIdx, 0)
  fbI32Bin(70) // 0x46 i32.eq
  // Close every arm's outer `if` frame.
  let c = 0
  while c < arms.length {
    fbEnd()
    c = c + 1
  }
  if isNe {
    fbI32Eqz() // 0x45 i32.eqz
  }
  0
}

// `v is <literal>` over a still-boxed mixed-rep union (`"a" | "b" | 1` boxes as `string | i32`,
// same-rep literals sharing a tag): the tag selects the literal's rep arm, then the unboxed
// payload value-compares the literal. A literal whose rep has no arm is statically false,
// evaluating the receiver for effects. The same gated shape as `emitUnionConcreteEq`.
function emitUnionLitIs(
  body: u8[],
  objIx: i32,
  lit: string,
  fnIx: i32,
  ec: ExpCtx,
) {
  // D1060 — a non-re-readable receiver is stashed at its first read, not refused; the same move
  // `emitUnionConcreteEq` makes, with the same bound. The compare reads the box twice — the tag,
  // then the payload inside the tag-matched arm — which is the whole content of
  // `unionEqOperandOk`, so a call receiver or a path rooted at one would otherwise refuse.

  // Teed at the first read rather than pre-emitted at the top: the receiver must be evaluated
  // where the original code evaluated it, so any context the surrounding lowering seeded is still
  // in force, and so the static-false fold below still evaluates it exactly once.
  const isStash = unionLitIsStashSlot()
  const isOnce = !unionEqOperandOk(objIx)
  const uname = unionNameOfExpr(objIx, fnIx)
  // D-VALUNION / D-SETONCE — see `emitUnionConcreteEq`.
  const usid = msSetOfUnionBox(objIx, uname, fnIx)
  // The arm spellings with a declared alias resolved — every predicate below that reads a name
  // reads this one, while the interned set stays keyed on the name the receiver carries.
  // `unionHasAtomTy` answers by splitting the spelling at top-level `|`,
  // so a `type W = K | i32` alias splits to the single atom `"W"` and no arm holds a literal.
  const unmArms = unionMemberSetOf(uname)
  // D1047 — the empty-name reject stays ahead of the atom ladder. The ladder's i64-widening rung
  // and the mixed-union gate below both ask `unionHasAtomK`, whose fall-through fails loudly on
  // an unregistered row, and a receiver whose union has no name has no row at all. The message is
  // the condition's own; the branch is a floor, unreached by the tests and by the corpus.
  if uname == "" {
    return emitFail(
      "emitProgram: literal `is` over a union with no recorded members",
    )
  }
  // The literal's rep atom: a quoted lexeme is a string, a float f64, an integer i32 — widening
  // to i64 when out of range or when the union's only integer arm is i64, the `emitUnionCoerce`
  // default. The ladder settles the ABI code alongside the spelling, and the map is a bijection
  // on its own image, so the code assigned is the code a parse of its output would return.
  let atom = "i32"
  let lak = 0
  // The quoted-leaf test at its home (`tyname.nameIsQuotedLeaf`). This site carries no bound of
  // its own: every caller reaches it through `isLitVariantName`, whose `length == 0` reject is
  // the bound.
  if nameIsQuotedLeaf(lit) {
    atom = "string"
    lak = 2
  } else if numLexIsFloat(lit) {
    atom = "f64"
    lak = 4
  } else if !numLexFitsI32(lit) {
    atom = "i64"
    lak = 3
  } else if (
    !unionHasAtomK(usid, unmArms, "i32", 0)
    && unionHasAtomK(usid, unmArms, "i64", 3)
  ) {
    atom = "i64"
    lak = 3
  }
  // A quoted literal has a rep arm whenever the box can carry it as a string ref — a plain
  // `string` arm or a literal-union arm, which is exactly `msSetTakesAtomAsStr`'s question.
  // Without its second leg a `K | f64` box statically answers `is "aa"` false: the member kinds
  // bank only `f64`, so the arm that holds the value looks absent. It is the gate's third disjunct.
  let litHasArm = unionHasAtomK(usid, unmArms, atom, lak)
  if !litHasArm && lak == 2 && msSetTakesAtomAsStr(usid) { litHasArm = true }
  // A union carrying a literal-union alias arm (`K | string`, `K | f64`) is a box like any value
  // union — the arm rides it as its member string — but `isValueUnionName` declines it because
  // `valueAtomKind("K")` is -1. Same box, same tags, so the lowering below is unchanged; only the
  // gate has to know the second spelling.

  // D1047 — and the third disjunct, `litHasArm`, mirrors the `==` twin's `eqMixedOk`: a mixed
  // union is testable against a scalar literal over the same tag-then-payload shape. The compare
  // is arm-agnostic, so a struct or container arm simply has a tag that does not match. Widened
  // only where the literal's own rep has an arm, which the static-false fold below already trusts.
  if (
    !isValueUnionOfSet(usid, uname)
    && !unionCarriesLitUnionArm(uname)
    && !litHasArm
  ) {
    return emitFail(
      "emitProgram: literal `is` over a union with no arm of the literal's rep",
    )
  }
  if !litHasArm {
    if emitExpr(body, objIx, fnIx, ec) < 0 { return -1 }
    fbDrop() // 0x1a drop
    fbI32Const(0)
    return 0
  }
  // `lak` decides the tag, the payload unbox and the three constant-emit arms below — one code,
  // five projections.
  if lak == 2 && !aUsed {
    return emitFail(
      "emitProgram: string `is` test but array type not collected",
    )
  }
  if emitExpr(body, objIx, fnIx, ec) < 0 { return -1 }
  if isOnce { fbLocalTee(isStash) }
  fbStructGet(uBoxIdx, 0) // 0xfb 0x02 <box ht> field 0: tag
  fbI32Rel(RS_TAG, scalarTagOfKind(lak))
  fbI32Bin(70)            // 0x46 i32.eq
  fbIf(127)               // 0x04 if, 0x7f i32 result blocktype
  if isOnce { fbLocalGet(isStash) }
  else if emitExpr(body, objIx, fnIx, ec) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
  if emitUnionPayloadUnbox(body, lak) < 0 { return -1 }
  if lak == 2 {
    // The literal lexeme rides a synthesized `StrLit` (same shape as `strText`).
    if emitStrEqLit(body, mkStr(lit, -1), fnIx, ec) < 0 { return -1 }
  } else if lak == 4 {
    fbF64Const(lit)
    fbI32Bin(97) // 0x61 f64.eq
  } else if lak == 3 {
    const pr = parseI64Pair(lit)
    fbI64Const(pr[0], pr[1])
    fbI32Bin(81) // 0x51 i64.eq
  } else {
    fbI32Const(parseI32(lit))
    fbI32Bin(70) // 0x46 i32.eq
  }
  fbElse() // wrong-rep arm — the literal can never match
  fbI32Const(0)
  fbEnd()  // 0x0b end
  0
}

// True if a variant field code has an `if (result …)` blocktype the shared-field dispatch can
// spell. The table's rationale is at the dispatch site in `emitMem`.
function sharedFieldCodeDispatchable(code: i32): boolean {
  if code == FC_I32 {
    return true // i32 / boolean — single valtype byte 0x7f
  }
  if code == FC_F64 {
    return true // f64 — 0x7c
  }
  if code == FC_I64 {
    return true // i64 — 0x7e
  }
  if code == FC_F32 {
    return true // f32 — 0x7d
  }
  if code == FC_STR {
    return aUsed // string — the `(ref $sTypeIdx)` blocktype form
  }
  false
}

// The field-rep codes a `?.` … `??` may carry — `sharedFieldCodeDispatchable` minus the string
// one. Both arms of the `if` have to leave the field's rep on the stack; a wide numeric default
// coerces (`emitOptChainDefault`), but a string default in this value position builds a module the
// engine refuses, its scratch reservation decided by a scan with no arm for this site.
function optChainFieldCodeOk(code: i32): boolean {
  // A string leaf (code 3 or 20) does not reach here: `exprNullableString` calls a `?.` over a
  // string field `string | null`, so `emitCoalesce`'s string-niche arm claims the spelling first
  // (D802). A value-union field (code 16) does not either: `emitOptCoalesceBoxLeaf` takes it.
  sharedFieldCodeDispatchable(code)
}

// The DEFAULT arm of a `?.` … `??`, at the field's rep. A wide numeric field needs the
// default WIDENED to it — `?? 1` against an `i64` field is an `i32.const` unless somebody
// says otherwise, and the `if`'s blocktype is `i64`: invalid wasm. Same three coercions
// `emitUnionCoerce`'s ladder performs for the same reason, and for the same three codes.
function emitOptChainDefault(
  body: u8[],
  dIx: i32,
  code: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if code == FC_F64 { return emitExprAsF64(body, dIx, fnIx, ec) }
  if code == FC_I64 { return emitExprAsI64(body, dIx, fnIx, ec) }
  if code == FC_F32 { return emitExprAsF32(body, dIx, fnIx, ec) }
  emitExpr(body, dIx, fnIx, ec)
}

// Emit the `if` whose result is the shared field's rep. Only called for a code
// `sharedFieldCodeDispatchable` admitted, so it has no failure arm of its own.
function fbIfForSharedField(code: i32) {
  if code == FC_F64 {
    return fbIf(124) // f64
  }
  if code == FC_I64 {
    return fbIf(126) // i64
  }
  if code == FC_F32 {
    return fbIf(125) // f32
  }
  if code == FC_STR {
    return fbIfRef(sTypeIdx) // string header ref
  }
  fbIf(127) // i32 / boolean
}

// True when the shared-field dispatch can spell its `if` result for the plan `vis`/`fis`: a
// scalar or string code, or a reference field every member stores at ONE storage type — the
// same table `pushFieldStorage` writes into the type section, so the blocktype is that valtype.
// A value-union field must also box against one atom set, the box's tags being positional.
function sharedFieldPlanDispatchable(
  code: i32,
  vis: i32[],
  fis: i32[],
): boolean {
  if sharedFieldCodeDispatchable(code) { return true }
  // A `boolean | null` read is the niche's one `i32` (`sharedFieldNulBoolPlan`).
  if code == FC_NUL_BOOL { return true }
  // A `string | null` read is the nullable string ref (`sharedFieldNulStrPlan`).
  if code == FC_NUL_STR { return aUsed }
  // An atom-set read with `null` members is one `i32` (`sharedFieldLitSetPlan`).
  if code == FC_NUL_LIT_UNION && sharedFieldPlanHasNull(vis, fis) {
    return true
  }
  if (
    code == FC_STR
    || code == FC_I32
    || code == FC_NUL_LIT_UNION
    || code == FC_NUL_BOOL
  ) {
    return false
  }
  if vis.length < 1 || fis.length != vis.length { return false }
  if sharedFieldAnyArmBoxes(code, vis, fis) {
    let b = 0
    while b < vis.length {
      if sharedFieldReadBoxes(code, vis[b], fis[b]) {
        const bk = sharedFieldArmAtomKind(vis[b], fis[b])
        if bk == 14 { return false }
        if atomKindNeedsValueBox(bk) && vbHeapIdxOfKind(bk) < 0 { return false }
      }
      b = b + 1
    }
    return true
  }
  const slot0 = uFieldStorageSlot(vis[0], fis[0])
  const elem0 = variantFieldElemName(vis[0], fis[0])
  let i = 1
  while i < vis.length {
    if uFieldStorageSlot(vis[i], fis[i]) != slot0 { return false }
    if code == FC_UNION && variantFieldElemName(vis[i], fis[i]) != elem0 {
      return false
    }
    i = i + 1
  }
  true
}

// Whether the plan `code` boxes member `vi0`'s field rather than reading it as stored: the
// members store the field at different value atoms (`sharedFieldArmsBoxable`), or this member
// stores a scalar where another stores the box (D4056).
function sharedFieldReadBoxes(code: i32, vi0: i32, fi0: i32): boolean {
  code == FC_UNION && variantFieldTypeAt(vi0, fi0) != FC_UNION
}

// Whether any member of the plan boxes its field (`sharedFieldReadBoxes`), so the read
// delivers a box whose narrowed path, if any, unboxes.
function sharedFieldAnyArmBoxes(code: i32, vis: i32[], fis: i32[]): boolean {
  let i = 0
  while i < vis.length && i < fis.length {
    if sharedFieldReadBoxes(code, vis[i], fis[i]) { return true }
    i = i + 1
  }
  false
}

// Whether value atom `k` is boxed in its own scalar value struct, rather than riding the box's
// `anyref` payload as the ref it already is.
function atomKindNeedsValueBox(k: i32): boolean {
  k == 0 || k == 1 || k == 3 || k == 4 || k == 5
}

// One member's arm of the shared-field dispatch: the receiver box, cast to member `vi`, read at
// field `fi` — boxed under the field's atom tag when the plan boxes (`sharedFieldReadBoxes`).
function emitSharedFieldArm(
  body: u8[],
  code: i32,
  vi: i32,
  fi: i32,
  recvIx: i32,
  readIx: i32,
  fnIx: i32,
  slot: i32,
  ec: ExpCtx,
) {
  if vi < 0 || vi >= uVarHeap.length {
    return emitFail("emitProgram: a shared field read names no member row")
  }
  // A `null` member of an atom-set read is the atom slot's `-1`.
  if code == FC_NUL_LIT_UNION && sharedFieldArmNull(vi, fi) {
    fbI32Const(0 - 1)
    return 0
  }
  // A `null` member of a `boolean | null` read is the niche's sentinel `2`.
  if code == FC_NUL_BOOL && sharedFieldArmNull(vi, fi) {
    fbI32Const(2)
    return 0
  }
  // A read the checker narrowed past `null` never reaches a `null` member.
  if (code == FC_I32 || code == FC_STR) && sharedFieldArmNull(vi, fi) {
    fbUnreachable()
    return 0
  }
  const converts = sharedFieldArmConverts(code, vi, fi)
  let texts = sharedFieldArmLitTexts(vi, fi)
  if converts && code == FC_I32 {
    // A lone literal stored as its string reads as its one member's atom.
    if texts.length == 1 {
      fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[0])))
      return 0
    }
    // A member stored at the string whose row spells no literals narrows through the read's
    // own members.
    if texts.length == 0 { texts = tyLitMemberTexts(nodeTyIxOf(readIx)) }
    if texts.length == 0 || !aUsed {
      return emitFail(
        "emitProgram: literal-union atom narrowing with no members",
      )
    }
    if emitSharedFieldRecv(body, recvIx, fnIx, slot, ec) < 0 { return -1 }
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    fbRefCast(uVarHeap[vi])
    fbStructGet(uVarHeap[vi], fi)
    const strSlot = objOrderStashSlot(FC_STR, uFieldStorageSlot(vi, fi))
    fbLocalSet(strSlot)
    const savedLU = expCtxSwapLitUnion(0, ec)
    const r = emitStagedStrToAtomChain(body, texts, 0, strSlot, fnIx, ec)
    expCtxSwapLitUnion(savedLU, ec)
    return r
  }
  const boxes = sharedFieldReadBoxes(code, vi, fi)
  if boxes && sharedFieldArmNull(vi, fi) {
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone()
    fbStructNew(uBoxIdx)
    return 0
  }
  const bk = sharedFieldArmAtomKind(vi, fi)
  const nulStr = boxes && bk < 0 && sharedFieldArmNulStr(vi, fi)
  // A record field rides the box under the read union's arm built at the record's own row.
  let recTag = -1
  if boxes && bk < 0 && !nulStr {
    recTag = sharedFieldArmStructTag(vi, fi, readIx)
  }
  if recTag >= 0 { fbI32Rel(RS_TAG, recTag) }
  else if boxes && !nulStr { fbI32Rel(RS_TAG, scalarTagOfKind(bk)) }
  if emitSharedFieldRecv(body, recvIx, fnIx, slot, ec) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
  fbRefCast(uVarHeap[vi])
  fbStructGet(uVarHeap[vi], fi)
  if converts {
    // An atom set read at the string widens through its own members' tower.
    if texts.length == 0 || !aUsed {
      return emitFail(
        "emitProgram: literal-union string widening with no members",
      )
    }
    const idSlot = objOrderStashSlot(FC_I32, uFieldStorageSlot(vi, fi))
    fbLocalSet(idSlot)
    return emitAtomToStrChain(body, texts, 0, idSlot)
  }
  if nulStr {
    // A `string | null` field boxes under the null tag when its ref is null, else the string tag.
    const sSlot = objOrderStashSlot(FC_NUL_STR, uFieldStorageSlot(vi, fi))
    fbLocalSet(sSlot)
    fbI32Rel(RS_TAG, nullBoxTag())
    fbI32Rel(RS_TAG, scalarTagOfKind(2))
    fbLocalGet(sSlot)
    fbRefIsNull()
    fbSelect()
    fbLocalGet(sSlot)
    fbStructNew(uBoxIdx)
    return 0
  }
  if boxes {
    if atomKindNeedsValueBox(bk) { fbStructNew(vbHeapIdxOfKind(bk)) }
    fbStructNew(uBoxIdx)
  }
  // A `string | null` member read where a narrowing excluded `null` holds a string.
  if code == FC_STR && variantFieldTypeAt(vi, fi) == FC_NUL_STR {
    fbRefAsNonNull()
  }
  0
}

// A field write through an un-narrowed struct union (`(A | B).n = v`): the value is evaluated
// once into a slot of the field's storage type, then each member's arm stores it at that
// member's own index. 1 when lowered, 0 when the write is not such a read's twin (the members
// must store the field at one rep), -1 on failure.
function emitSharedFieldAssign(
  body: u8[],
  memIx: i32,
  valIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const m = nodeAt(memIx)
  if m is Member {
    const vis: i32[] = []
    const fis: i32[] = []
    const code = sharedUnionFieldPlan(
      m.memObj,
      m.memProp,
      memIx,
      fnIx,
      vis,
      fis,
    )
    if code < 0 || !sharedFieldPlanDispatchable(code, vis, fis) { return 0 }
    // A literal-union field stores at each member's own atoms, which the member's construct
    // path already lowers (D5158).
    if (
      sharedFieldAnyArmBoxes(code, vis, fis)
      || sharedFieldAnyArmLitUnion(vis, fis)
    ) {
      return emitSharedFieldAssignPerArm(
        body,
        m.memObj,
        valIx,
        fnIx,
        vis,
        fis,
        ec,
      )
    }
    if !sharedFieldTysIdentical(vis, fis) { return 0 }
    let rslot = -1
    if !(nodeAt(unwrapParen(m.memObj)) is Ident) {
      rslot = sharedFieldRecvSlot()
      if emitExpr(body, m.memObj, fnIx, ec) < 0 { return -1 }
      fbLocalSet(rslot)
    }
    const sfVal = emitScalarFieldStoreVal(body, valIx, fnIx, code, ec)
    if sfVal < 0 { return -1 }
    const vslot = objOrderStashSlot(code, uFieldStorageSlot(vis[0], fis[0]))
    fbLocalSet(vslot)
    let i = 0
    while i < vis.length {
      const last = i == vis.length - 1
      if !last {
        if emitSharedFieldRecv(body, m.memObj, fnIx, rslot, ec) < 0 {
          return -1
        }
        fbStructGet(uBoxIdx, 0) // field 0: tag
        fbI32Rel(RS_TAG, uTags[vis[i]])
        fbI32Bin(70)            // 0x46 i32.eq
        fbIf(64)                // 0x40 void
      }
      if emitSharedFieldRecv(body, m.memObj, fnIx, rslot, ec) < 0 { return -1 }
      fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
      fbRefCast(uVarHeap[vis[i]])
      fbLocalGet(vslot)
      fbStructSet(uVarHeap[vis[i]], fis[i])
      if !last { fbElse() }
      i = i + 1
    }
    let e = 0
    while e < vis.length - 1 {
      fbEnd()
      e = e + 1
    }
    return 1
  }
  0
}

// `emitSharedFieldAssign` over members storing the field at different reps: the receiver is
// stashed once, then each tag's arm lowers the value at its own member's field type. Exactly
// one arm runs, so the value is still evaluated once, after the receiver. 1 lowered, -1 failed.
function emitSharedFieldAssignPerArm(
  body: u8[],
  recvIx: i32,
  valIx: i32,
  fnIx: i32,
  vis: i32[],
  fis: i32[],
  ec: ExpCtx,
) {
  const rslot = sharedFieldRecvSlot()
  if emitExpr(body, recvIx, fnIx, ec) < 0 { return -1 }
  fbLocalSet(rslot)
  let i = 0
  while i < vis.length {
    const last = i == vis.length - 1
    if !last {
      if emitSharedFieldRecv(body, recvIx, fnIx, rslot, ec) < 0 { return -1 }
      fbStructGet(uBoxIdx, 0) // field 0: tag
      fbI32Rel(RS_TAG, uTags[vis[i]])
      fbI32Bin(70)            // 0x46 i32.eq
      fbIf(64)                // 0x40 void
    }
    if emitSharedFieldRecv(body, recvIx, fnIx, rslot, ec) < 0 { return -1 }
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    fbRefCast(uVarHeap[vis[i]])
    if emitVariantFieldValue(body, vis[i], fis[i], valIx, fnIx, ec) < 0 {
      return -1
    }
    fbStructSet(uVarHeap[vis[i]], fis[i])
    if !last { fbElse() }
    i = i + 1
  }
  let e = 0
  while e < vis.length - 1 {
    fbEnd()
    e = e + 1
  }
  1
}

// Whether some member stores the field as a literal union or a literal-union list.
function sharedFieldAnyArmLitUnion(vis: i32[], fis: i32[]): boolean {
  let i = 0
  while i < vis.length && i < fis.length {
    if variantFieldIsLitUnion(vis[i], fis[i]) { return true }
    if variantFieldIsLitUnionArray(vis[i], fis[i]) { return true }
    i = i + 1
  }
  false
}

// Whether every member declares the field at one type, with no literal set among them — the
// only case a store through the union is the same store into each member.
function sharedFieldTysIdentical(vis: i32[], fis: i32[]): boolean {
  if vis.length < 1 || fis.length != vis.length { return false }
  const at0 = uFieldStart[vis[0]] + fis[0]
  let i = 0
  while i < vis.length {
    const at = uFieldStart[vis[i]] + fis[i]
    if at < 0 || at >= uFieldTyText.length || at >= uFieldLitTyIx.length {
      return false
    }
    if at0 < 0 || at0 >= uFieldTyText.length { return false }
    if uFieldTyText[at] != uFieldTyText[at0] || uFieldLitTyIx[at] >= 0 {
      return false
    }
    if variantFieldIsLitUnion(vis[i], fis[i]) { return false }
    if variantFieldIsLitUnionArray(vis[i], fis[i]) { return false }
    i = i + 1
  }
  true
}

// `fbIfForSharedField` for a plan `sharedFieldPlanDispatchable` admitted: a reference field's
// blocktype is its member's storage valtype, written by `pushFieldStorage`.
function fbIfForSharedPlan(code: i32, vi: i32, fi: i32) {
  if (
    sharedFieldCodeDispatchable(code)
    || code == FC_NUL_LIT_UNION
    || code == FC_NUL_BOOL
  ) {
    return fbIfForSharedField(code)
  }
  fbOpenIf()
  pushFieldStorage(code, uFieldStorageSlot(vi, fi))
}

// Push the shared-field dispatch's receiver box: the value stashed in `slot` when the receiver
// is evaluated once (`slot >= 0`), else a fresh emission of the place — an ident, effect-free.
// One function so the tag test and the payload read cannot pick different halves.
function emitSharedFieldRecv(
  body: u8[],
  recvIx: i32,
  fnIx: i32,
  slot: i32,
  ec: ExpCtx,
) {
  if slot >= 0 {
    fbLocalGet(slot)
    // The lazy frame's ref slots are NULLABLE (they must be defaultable), and `struct.get`
    // takes a non-null ref. The value stored is the receiver's own box, so this recovers a
    // nullness the store never had; it cannot trap on a checked program (the checker
    // refuses a shared read through a nullable receiver outright).
    return fbRefAsNonNull() // 0xd4
  }
  emitExpr(body, recvIx, fnIx, ec)
}

// The one home for "a code-16 value-union-box field read whose member path is narrowed to a
// single scalar atom unboxes to that atom's rep". The receiver's own shape decides which
// `struct.get` produced the box — the plain struct table, the arm's `uVarHeap` row, or the
// nullable form of the same — but the unbox after it is one sequence.

// The atom is the checker's type for the read (`memNarrowAtomKind`): a litunion-alias narrow
// unboxes as the string ref the box stores its member as, which is the ident read discipline.
// A read typed as the field's declared type narrows nothing and yields the box unchanged.
function emitUnionFieldNarrowUnbox(memIx: i32, fnIx: i32) {
  // The CONTAINER arms of the same narrowing (`if n.v is K[]`, `if n.v is {[string]: K}`) —
  // disjoint from the value atom below, which answers "" for both (D1014).
  const mCon = emitPlaceNarrowContainerUnbox(memIx, fnIx)
  if mCon != 0 { return mCon - 1 }
  const mAtom = memNarrowAtomKind(memIx, fnIx)
  if mAtom < 0 {
    // D209 — the un-narrowed read the checker typed as a bare atom. The box is the adoption's
    // rep, not the program's: `structIndexOfObjCtx` takes a declared row for an un-annotated
    // literal, so the field is code 16 while the checker never widened the value. Deliver the
    // atom the checker's consumers are typed against; `exprUnion` asks this same predicate.

    // The payload is not always at that atom: a declared `i64 | null` member makes the store
    // widen `7` into `$vbI64` while the checker still types the read `i32`, so cast to what the
    // store put there and narrow back. A `??`-merged box genuinely holds two, so no single cast
    // is right — dispatch on the tag the box carries, only where every arm reaches it.
    const ck = memReadUnboxAtomKind(memIx, fnIx)
    if ck < 0 { return 0 }
    const bk = memReadBoxedAtomKind(memIx, fnIx)
    const bks: i32[] = []
    if memReadBoxedAtomKinds(memIx, fnIx, bks) {
      if bks.length > 1 && atomKindsAllConvertible(bks, ck) {
        return emitUnionFieldTagDispatch(bks, ck)
      }
    }
    if emitUnboxToAtomKind(bk) < 0 { return -1 }
    return emitNarrowStoredAtomKind(bk, ck)
  }
  // The narrowed atom's ABI code decides both arms, exactly as it does at the variant-field twin
  // of this read (`emitNarrowedMem`, the same three instructions and the same two arms) — one
  // derivation, not a spelling compare beside a second `vbHeapIdxOfKind`.
  emitUnboxToAtomKind(mAtom)
}

// D927 — the tag-dispatched unbox: one arm per atom the box can hold, each converted to the
// checker's atom `ck`, in `splitUnionAtoms` order with the last arm as the unconditional
// fall-through. The box is on the stack when this is entered, so it is stashed once — each arm
// reads it twice, and re-emitting a receiver per arm is what `sharedFieldRecvSlot` exists for.
function emitUnionFieldTagDispatch(kinds: i32[], ck: i32) {
  const slot = sharedFieldRecvSlot()
  fbLocalSet(slot)
  let i = 0
  while i < kinds.length - 1 {
    fbLocalGet(slot)
    fbStructGet(uBoxIdx, 0) // field 0: tag
    fbI32Rel(RS_TAG, scalarTagOfKind(kinds[i]))
    fbI32Bin(70) // 0x46 i32.eq
    fbIfForAtomKind(ck)
    fbLocalGet(slot)
    if emitUnboxToAtomKind(kinds[i]) < 0 { return -1 }
    if emitConvertAtomKind(kinds[i], ck) < 0 { return -1 }
    fbElse()
    i = i + 1
  }
  fbLocalGet(slot)
  if emitUnboxToAtomKind(kinds[kinds.length - 1]) < 0 { return -1 }
  if emitConvertAtomKind(kinds[kinds.length - 1], ck) < 0 { return -1 }
  let e = 0
  while e < kinds.length - 1 {
    fbEnd()
    e = e + 1
  }
  0
}

// D927 — the `if` blocktype for a value-atom kind, the atom-side twin of `fbIfForSharedField`'s
// field-code one. Two spellers rather than one because the two callers hold two vocabularies — a
// field code there, a `valueAtomKind` here — and deriving one from the other is what lets a
// spelling compare stand in for a code.
function fbIfForAtomKind(k: i32) {
  if k == 2 {
    return fbIfRef(sTypeIdx) // string header ref
  }
  if k == 3 {
    return fbIf(126) // i64
  }
  if k == 4 {
    return fbIf(124) // f64
  }
  if k == 5 {
    return fbIf(125) // f32
  }
  fbIf(127) // i32 / boolean
}

// D927 — can a payload boxed at `from` be delivered at `to`? The predicate half of
// `emitConvertAtomKind`, asked before any byte is written so the dispatch can stand down whole
// rather than fail in the middle of an arm. `emitNarrowStoredAtomKind`'s four narrowings and
// their five widening inverses; a string or boolean arm converts to nothing but itself.
function atomKindConvertible(from: i32, to: i32): boolean {
  if from == to { return true }
  if from == 0 { return to == 3 || to == 4 || to == 5 }
  if from == 3 { return to == 0 || to == 4 }
  if from == 4 { return to == 0 }
  if from == 5 { return to == 0 || to == 4 }
  false
}

// D927 — every arm of the box, or the dispatch does not run.
function atomKindsAllConvertible(kinds: i32[], to: i32): boolean {
  let i = 0
  while i < kinds.length {
    if !atomKindConvertible(kinds[i], to) { return false }
    i = i + 1
  }
  true
}

// D927 — the conversion itself. The NARROWING half is `emitNarrowStoredAtomKind`'s, reached
// through it so the two cannot drift; the WIDENING half is the direction that function refuses
// by design, because until a box held two atoms nothing ever needed it.
function emitConvertAtomKind(from: i32, to: i32) {
  if from == to { return 0 }
  if from == 0 {
    if to == 3 {
      fbI64ExtendI32S()
      return 0
    }
    if to == 4 {
      fbF64ConvertI32S()
      return 0
    }
    if to == 5 {
      fbF32ConvertI32S()
      return 0
    }
  }
  if from == 3 && to == 4 {
    fbF64ConvertI64S()
    return 0
  }
  emitNarrowStoredAtomKind(from, to)
}

// D291 — the inverse of the store's widening: a payload boxed at kind `from` because the union's
// arm is wider, delivered at the kind `to` the checker typed the read's consumers against, and
// nothing at all when the two agree. The four conversions are exactly the four promotions
// `unionStoreAtomKind` performs, each exact; any other pair is a loud reject rather than a guess.
function emitNarrowStoredAtomKind(from: i32, to: i32) {
  if from == to { return 0 }
  if to == 0 {
    if from == 3 {
      fbI32WrapI64()
      return 0
    }
    if from == 4 {
      fbI32TruncF64S()
      return 0
    }
    if from == 5 {
      fbI32TruncF32S()
      return 0
    }
  }
  if to == 4 && from == 5 {
    fbF64PromoteF32()
    return 0
  }
  emitFail(
    "emitProgram: union field read stored at an atom the checker's atom cannot be recovered from",
  )
}

// The unbox sequence for a value-union box payload at atom kind `mfk`: `struct.get $uBox 1` and
// then the atom's own recovery. One home, so the narrowed read and the un-narrowed one cannot
// emit different instructions for the same atom.

// The recovery itself is `emitUnionUnboxTail`'s, not a second copy of it (D1014): a second ladder
// drifts, refusing a list or closure arm the ident read recovers. What is genuinely this site's
// own is the `aUsed` guard, which turns an unminted `sTypeIdx` into a message.
function emitUnboxToAtomKind(mfk: i32) {
  if mfk == 2 {
    if !aUsed {
      return emitFail(
        "emitProgram: narrowed string union field read but array type not collected",
      )
    }
  }
  emitUnionUnboxTail(mfk)
}

// The message for one of `emitMem`'s three field-access floors — `dflt` prefixed, except for a
// `.length` read, which gets its own. `.length` reaches a floor only through a type parameter:
// every rep that has a length is answered by a classifier above, and a declared struct with a
// `length` field by the struct read these floors guard.

// It is a message swap at the floor and not a guard above it, and the order is the point: the
// same arm at the head of the block takes `Buf.length` with it. Only the corpus `cmp` sees that
// difference — grid, grade columns and histogram are unmoved.
function memFloorMsg(memIx: i32, dflt: string): string {
  const m = nodeAt(memIx)
  if m is Member {
    if m.memProp == "length" {
      return "emitProgram: '.length' on a receiver the emitter cannot classify as a list, string, map or set"
    }
  }
  "emitProgram: " + dflt
}

function emitMem(body: u8[], memIx: i32, fnIx: i32, ec: ExpCtx) {
  // A field read on a narrowed union identifier downcasts through the box, only where the narrow
  // names one variant — the whole of what this route can lower.

  // D1083 — a null-complement narrowing (`type U = A | B | null` under `if u != null`) banks the
  // surviving set as the string `"A | B"`, which `memIsNarrowed` answers true for, so an exact
  // compare against a table holding `A` and `B` separately refuses a check-clean program. Asking
  // `memNarrowVariantIndex` lets a multi-variant survivor set reach the dispatch below instead.
  if memIsNarrowed(memIx) {
    if memNarrowVariantIndex(memIx) >= 0 {
      // …and only where the receiver IS a box. A place whose declared type is the ARM
      // itself carries the bare ref, so its narrowing renames the rep rather than changing
      // it, and unwrapping would read a box the module never built. The same pairing
      // `narrowedArmNeedsUnbox` makes on the delivery side (D1734).
      const m0n = nodeAt(memIx)
      if m0n is Member {
        if exprUnion(m0n.memObj, fnIx) {
          return emitNarrowedMem(body, memIx, fnIx, ec)
        }
      }
    }
  }
  emitMemVariantRead(body, memIx, fnIx, ec)
}

// `emitMem`'s read of a field off a bare or nullable VARIANT receiver; any other receiver
// falls through to the shared-field dispatch. Returns 0, or -1 failed.
function emitMemVariantRead(
  body: u8[],
  memIx: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  // A field read on a VARIANT-typed param `o.field` (`o: TyObj`) reads the variant
  // struct directly — the param already IS the unboxed variant ref, so there is NO box
  // unwrap / cast (gap #2). Evaluate the receiver (`local.get o`), then `struct.get
  // $<uVarHeap[vi]> <fieldIdx>`.
  const m0 = nodeAt(memIx)
  if m0 is Member {
    const pvi = exprVariantIndex(m0.memObj, fnIx)
    if pvi >= 0 {
      const pvfi = variantFieldIndex(pvi, m0.memProp)
      if pvfi < 0 {
        return emitFail("emitProgram: unknown variant field in field access")
      }
      if emitExpr(body, m0.memObj, fnIx, ec) < 0 { return -1 }
      fbStructGet(uVarHeap[pvi], pvfi) // 0xfb 0x02 <variant struct ht> <field index>
      emitNulStrFieldRecover(variantFieldTypeAt(pvi, pvfi), ec)
      // A code-16 (value-union box) field of the arm, read while its member PATH is
      // narrowed, unboxes to the narrowed atom — the arm-for-arm twin of the plain
      // struct read below and of `emitNarrowedMem`'s. Without it the box flowed into an
      // i32 consumer: check-clean INVALID WASM (silent-class-inventory D219).
      if variantFieldTypeAt(pvi, pvfi) == FC_UNION {
        if emitUnionFieldNarrowUnbox(memIx, fnIx) < 0 { return -1 }
      }
      return 0
    }
    // The nullable form of the same read (`c: Circle | null`, inside its `!= null` branch).
    // Identical `struct.get`, one `ref.as_non_null` ahead of it: the cell is a
    // `(ref null $uVarHeap[vi])` and `struct.get` takes a non-null ref. The assertion cannot trap
    // where the checker admits the read — such an access is only reachable through a null test.
    const nvi = nulVariantIdxOfExpr(m0.memObj, fnIx)
    if nvi >= 0 {
      const nvfi = variantFieldIndex(nvi, m0.memProp)
      if nvfi < 0 {
        return emitFail("emitProgram: unknown variant field in field access")
      }
      if emitExpr(body, m0.memObj, fnIx, ec) < 0 { return -1 }
      fbRefAsNonNull() // 0xd4 — the enclosing null test narrowed it
      fbStructGet(uVarHeap[nvi], nvfi)
      emitNulStrFieldRecover(variantFieldTypeAt(nvi, nvfi), ec)
      if variantFieldTypeAt(nvi, nvfi) == FC_UNION {
        if emitUnionFieldNarrowUnbox(memIx, fnIx) < 0 { return -1 }
      }
      return 0
    }
  }
  emitMemSharedRead(body, memIx, fnIx, ec)
}

// `emitMem`'s shared-field read over a struct union, dispatched on the box tag; a plan that
// is not dispatchable falls through to the plain struct read. Returns 0, or -1 failed.
function emitMemSharedRead(body: u8[], memIx: i32, fnIx: i32, ec: ExpCtx): i32 {
  // The shared-field dispatch's result rep. The dispatch below is a chain of `if (result …)`
  // blocks, one per box tag, so the field's rep has to be spellable as a blocktype. Pinned to i32
  // it would make `(A | B).tag` readable for an i32 or boolean field and a loud floor for an
  // `f64`, `i64`, `f32` or `string` one.

  // The three remaining scalars are their own single valtype byte. String needs the other form,
  // `fbIfRef`, since a `(ref $sTypeIdx)` result is not a valtype byte, and it is the code that
  // matters most: a discriminated union's tag is a string field. The predicate and the emitter are
  // two functions over one table because the validation loop must decline before any bytes.

  // Shared-field access over an un-narrowed struct union (`(A | B).tag`): the checker proved the
  // field present on every member, but members may store it at different indices, so dispatch on
  // the box tag and read the field at that member's own index. The arms are exhaustive, the last
  // member being the unconditional fall-through. A narrowed set dispatches over its survivors.
  const mS = nodeAt(memIx)
  if mS is Member {
    // The plan is shared. `sharedUnionFieldPlan` owns the receiver test, the narrowed-set member
    // resolution and the per-member field lookup — the same derivation both classifier twins
    // read, so what this lowers and what `print` dispatches cannot disagree. Dispatchability
    // stays here, being a question about spelling a blocktype rather than about typing a read.
    const shVis: i32[] = []
    const shFis: i32[] = []
    const shCode = sharedUnionFieldPlan(
      mS.memObj,
      mS.memProp,
      memIx,
      fnIx,
      shVis,
      shFis,
    )
    if shCode >= 0 && sharedFieldPlanDispatchable(shCode, shVis, shFis) {
      // The receiver is evaluated once unless re-emitting it is free. The arms below read it
      // twice each — the tag test, then the payload cast — which is why an ident receiver, whose
      // `local.get` re-emits for nothing, needs no slot. A call does not: `g(true).v` would call
      // `g` 2N-1 times, and that restriction is why this family floors.

      // The stash slot is handed out here, during lowering (`sharedFieldRecvSlot`, the lazy list
      // frame), not reserved by a pre-pass: a pre-pass runs before any `is`-narrowing is active
      // and this question consults narrowing, so the two answers differ in both directions. An
      // ident receiver takes no slot and re-emits, so existing programs emit the same bytes.
      const shRecv = nodeAt(unwrapParen(mS.memObj))
      let shSlot = -1
      if !(shRecv is Ident) {
        shSlot = sharedFieldRecvSlot()
        if emitExpr(body, mS.memObj, fnIx, ec) < 0 { return -1 }
        fbLocalSet(shSlot)
      }
      let si2 = 0
      while si2 < shVis.length - 1 {
        if emitSharedFieldRecv(body, mS.memObj, fnIx, shSlot, ec) < 0 {
          return -1
        }
        fbStructGet(uBoxIdx, 0)                       // field 0: tag
        fbI32Rel(RS_TAG, uTags[shVis[si2]])
        fbI32Bin(70)                                  // 0x46 i32.eq
        fbIfForSharedPlan(shCode, shVis[0], shFis[0]) // if (result <the field's own rep>)
        const shArm = emitSharedFieldArm(
          body,
          shCode,
          shVis[si2],
          shFis[si2],
          mS.memObj,
          memIx,
          fnIx,
          shSlot,
          ec,
        )
        if shArm < 0 { return -1 }
        fbElse()
        si2 = si2 + 1
      }
      const shLast = shVis.length - 1
      const shLastArm = emitSharedFieldArm(
        body,
        shCode,
        shVis[shLast],
        shFis[shLast],
        mS.memObj,
        memIx,
        fnIx,
        shSlot,
        ec,
      )
      if shLastArm < 0 { return -1 }
      let se = 0
      while se < shVis.length - 1 {
        fbEnd()
        se = se + 1
      }
      // A plan that boxes, or whose every arm stores the box, delivers a box whatever the
      // receiver's arms declare, so a read the checker typed as one atom unboxes to it.
      if shCode == FC_UNION {
        const shK = pathReadAtomKind(memIx, fnIx)
        if shK >= 0 { return emitUnboxToAtomKind(shK) }
      }
      if sharedFieldAnyArmBoxes(shCode, shVis, shFis) {
        const shAk = memReadCheckerAtomKind(memIx)
        if shAk >= 0 { return emitUnboxToAtomKind(shAk) }
        return emitUnionFieldNarrowUnbox(memIx, fnIx)
      }
      return 0
    }
  }
  emitMemStructRead(body, memIx, fnIx, ec)
}

// `emitMem`'s plain struct field read, with its null, string-niche and union-box recoveries,
// or the node-anchored floor naming why the receiver is not a struct. Returns 0, or -1 failed.
function emitMemStructRead(body: u8[], memIx: i32, fnIx: i32, ec: ExpCtx): i32 {
  // The three field-access floors are node-anchored (`emitFailAt`), not function-anchored. A
  // reader given "line 3, inside `g`" for a read on line 7 looks in the wrong place, and for a
  // top-level read that is what the function cursor says — the start function is lowered last, so
  // `emitCurFnIx` still names the file's final `function`.
  if !sDeclared {
    return emitFailAt(
      memFloorMsg(memIx, "field access but no struct type declared"),
      memIx,
    )
  }
  if memIx < 0 { return -1 }
  const m = nodeAt(memIx)
  if m is Member {
    const si = structIndexOfExpr(m.memObj, fnIx)
    if si < 0 {
      return emitFailAt(
        memFloorMsg(memIx, "field access receiver is not a struct"),
        memIx,
      )
    }
    const idx = sFieldIndex(si, m.memProp)
    if idx < 0 {
      return emitFailAt(
        memFloorMsg(memIx, "unknown struct field in field access"),
        memIx,
      )
    }
    if emitExpr(body, m.memObj, fnIx, ec) < 0 { return -1 }
    // A NULLABLE-struct receiver (`S | null`) recovers its non-null ref before the
    // field read — the checker proved every such access guarded, so the cast can
    // never trap on a checked program.
    if (
      exprNullableStruct(m.memObj, fnIx)
      && !readOwesNonNullRecover(m.memObj, fnIx)
    ) {
      fbRefAsNonNull()
    }
    fbStructGet(sHeapIdx[si], idx) // 0xfb 0x02 <struct ht> <field index>
    const narrowOp = memReadNarrowOp(memIx, fnIx)
    if narrowOp >= 0 { wU8(narrowOp) }
    emitNulStrFieldRecover(sFieldTypeAt(si, idx), ec)
    // A union-typed field (code 16) read while the member path is narrowed to one scalar atom
    // (`if o.y is i32 { … o.y … }`) unboxes the payload — the same recovery as a narrowed union
    // ident read, at the atom the checker typed the read as; an un-narrowed read is the box.
    if sFieldTypeAt(si, idx) == FC_UNION {
      if memReadBoxAmbiguous(memIx, fnIx) { return emitBoxAmbiguousFail(memIx) }
      const own = memReadBoxNarrowTy(memIx, fnIx)
      if own >= 0 {
        if emitBoxAtomRetagTys(sFieldElemTyIxAt(si, idx), own, memIx) < 0 {
          return -1
        }
      }
      if emitUnionFieldNarrowUnbox(memIx, fnIx) < 0 { return -1 }
    }
    return 0
  }
  emitFail("emitProgram: expected a field access")
}

// ── string-literal decoding ─────────────────────────────────────────────────

// A `StrLit` carries the raw lexeme in `strText` — quotes kept, escapes unresolved — so the
// emitter decodes it here to the sequence of Unicode code points the string denotes, walking the
// lexeme by iteration under the same escape grammar the lexer applies (`scanQuoted`):
// `\n \t \r \\ \" \' \0 \b \f \v`, `\xXX`, `\uXXXX`, `\u{…}`. `cpsToUtf8` then encodes them.

// Lower a string literal onto `body`: decode `strText` to its code-point vector, UTF-8-encode it,
// push each byte as `i32.const`, then `array.new_fixed $sBackIdx <count>` for the packed
// `(array (mut i8))` backing and `struct.new $sTypeIdx` for the whole-backing header.

// A literal past the `array.new_fixed` operand cap builds the backing chunked and wraps once at
// the end. The cap is counted in bytes, because the operands are bytes, and `collectStrPool`
// applies the same budget: a literal the pool accepted but this rejected would be emitted twice
// under two different shapes.
function emitStr(_body: u8[], strIx: i32, _fnIx: i32) {
  if !aUsed {
    return emitFail("emitProgram: string literal but array type not collected")
  }
  if strIx < 0 { return -1 }
  const s = nodeAt(strIx)
  if s is StrLit {
    // A POOLED literal (every distinct literal within the `array.new_fixed` cap —
    // `collectStrPool`) reads its interned immutable global: one `global.get`
    // instead of an i32.const-per-codepoint allocation at every evaluation.
    const pi = gStrPoolIx[s.strText] ?? -1
    if pi >= 0 {
      // The pool follows the imported globals: indices nImp..nImp+pool-1.
      fbGlobalGet(externGlobalCount() + pi)
      return 0
    }
    // A literal past the cap reads its data segment: a few code bytes whatever its length.
    const di = if gStrDataLen.length > 0 { gStrDataIx[s.strText] ?? -1 } else { -1 }
    if di >= 0 {
      const dn = gStrDataLen[di]
      fbI32Const(0)  // segment offset
      fbI32Const(dn) // byte count
      fbArrayNewData(sBackIdx, di)
      fbI32Const(0)  // start
      fbI32Const(dn) // len
      fbStrNew()
      return 0
    }
    const cps = cpsToUtf8(decodeStr(strToCps(s.strText)))
    if cps.length > NEW_FIXED_MAX {
      // Past the engines' `array.new_fixed` operand cap — build chunked, since an unchunked
      // emit validates nowhere. The chunked build fills the backing; the header is wrapped
      // around it once the last chunk lands.
      const dst = arrLitChunkStart("i32", 0, sBackIdx, cps.length, true)
      let ci = 0
      let coff = 0
      while ci < cps.length {
        fbI32Const(cps[ci])
        ci = ci + 1
        coff = arrLitChunkFlush(dst, sBackIdx, coff, ci, cps.length)
      }
      fbLocalGet(dst)
      fbRefAsNonNull()       // (the slot is declared nullable)
      fbI32Const(0)          // start
      fbI32Const(cps.length) // len
      fbStrNew()             // the view over the whole freshly built backing
      return 0
    }
    let i = 0
    while i < cps.length {
      fbI32Const(cps[i]) // 0x41 i32.const <code point>
      i = i + 1
    }
    fbArrayNewFixed(sBackIdx, cps.length) // 0xfb 0x08 <typeidx> <count>
    fbI32Const(0)                         // start
    fbI32Const(cps.length)                // len
    fbStrNew()                            // 0xfb 0x00 <string header>
    return 0
  }
  emitFail("emitProgram: expected a string literal")
}

// The (wrapper, backing) heap pair a list of element kind `k` builds — `.slice`'s own ladder,
// asked by the spread literal so the two cannot disagree about a rep. `-1` in either half when
// the module never collected that list type, or when a `"ref"` row is not a real one.
function spreadWrapIdx(k: MfKind, row: i32) {
  // Exhaustive over `MfKind` and `_`-less: the i32-list wrapper is the fall-through, a real
  // answer, so a new element kind must name its own wrapper (D1898).
  match k {
    "f64" => {
      if fa64Used { return fl64TypeIdx }
      return -1
    }
    "i64" => {
      if ia64Used { return il64TypeIdx }
      return -1
    }
    "f32" => {
      if fa32Used { return fl32TypeIdx }
      return -1
    }
    "u8" => {
      if ba8Used { return bl8TypeIdx }
      return -1
    }
    "str" => {
      return mkListIdx
    }
    "ref" => {
      if row < 0 || row >= rlWrapIdx.length { return -1 }
      return rlWrapIdx[row]
    }
    "i32" => {
      if lUsed && aUsed { return lTypeIdx }
      return -1
    }
  }
}

function spreadBackIdx(k: MfKind, row: i32) {
  // Exhaustive over `MfKind` and `_`-less: the i32-list backing is the fall-through, a real
  // answer, so a new element kind must name its own backing (D1898).
  match k {
    "f64" => {
      if fa64Used { return fa64TypeIdx }
      return -1
    }
    "i64" => {
      if ia64Used { return ia64TypeIdx }
      return -1
    }
    "f32" => {
      if fa32Used { return fa32TypeIdx }
      return -1
    }
    "u8" => {
      if ba8Used { return ba8TypeIdx }
      return -1
    }
    "str" => {
      return mkArrIdx
    }
    "ref" => {
      if row < 0 || row >= rlBackIdx.length { return -1 }
      return rlBackIdx[row]
    }
    "i32" => {
      if lUsed && aUsed { return aTypeIdx }
      return -1
    }
  }
}

// `[...a, 1, ...b]` — the runtime-length list literal, on `.slice`'s shape, since
// `array.new_fixed`'s length is a compile-time constant. Every item group — a spread's
// source, or a run of plain elements as its own literal — is evaluated in source order into
// its own frame slot; the destination is allocated once, and each group is one `array.copy`.
function emitArrSpread(
  body: u8[],
  arrIx: i32,
  fnIx: i32,
  lb: ListBuild,
  ec: ExpCtx,
) {
  const a = nodeAt(arrIx)
  if a is ArrayLit {
    const elems = a.arrElems
    const boxRow = spreadBoxDestRow(elems, fnIx, lb)
    if boxRow >= 0 { return emitArrSpreadBoxed(body, arrIx, boxRow, fnIx, ec) }
    const boxSrc = spreadBoxingSource(arrIx, fnIx)
    if boxSrc >= 0 {
      // Nothing threaded a row, so the literal builds at its own typed union-box row.
      const own = spreadOwnBoxRow(arrIx, elems, fnIx)
      if own >= 0 { return emitArrSpreadBoxed(body, arrIx, own, fnIx, ec) }
      return emitFailAt(
        "emitProgram: a spread whose elements must each be boxed into a union or nullable "
          + "element has no lowering yet; build the source list at the literal's element type",
        boxSrc,
      )
    }
    let kk = spreadDestKind(arrIx, fnIx)
    // A destination that threaded a wider scalar list (`const q: f64[] = [...ints]`) is
    // built at, since the literal is built at the type it flows into.
    const pdk = spreadPendingScalar(lb.lbKind)
    if (
      kk != null
      && pdk != null
      && pdk != kk
      && spreadSourcesWidenTo(elems, pdk, fnIx)
    ) {
      kk = pdk
    }
    // A `string[]` destination builds a literal-union atom source's strings (D2868).
    if (
      kk == "i32"
      && lb.lbKind == LBK_STR_LIST
      && spreadSourcesStrOrAtoms(elems, fnIx)
    ) {
      kk = "str"
    }
    if kk == null {
      return emitFail(
        "emitProgram: a spread's source is not a list this rep knows",
      )
    }
    const ownRow = spreadDestRow(elems, fnIx)
    const row = spreadFreshDestRow(arrIx, kk, ownRow, fnIx, lb)
    const wrap = spreadWrapIdx(kk, row)
    const back = spreadBackIdx(kk, row)
    if wrap < 0 || back < 0 {
      return emitFail("emitProgram: spread literal but list type not collected")
    }
    // The item groups in source order: a spread contributes its source, a run of plain
    // elements its own synthesized literal, which `emitArr` builds at this same rep.
    const groups: i32[] = []
    let run: i32[] = []
    let i = 0
    while i < elems.length {
      const src = spreadArgOf(elems[i])
      if src >= 0 {
        if run.length > 0 {
          groups.push(spreadRunLit(run, arrIx, arrIx, a.pos))
          run = []
        }
        groups.push(src)
      } else {
        run.push(elems[i])
      }
      i = i + 1
    }
    if run.length > 0 { groups.push(spreadRunLit(run, arrIx, arrIx, a.pos)) }
    // Every group builds at the DESTINATION's rep, threaded from the kind this literal
    // resolved at rather than from whatever annotation reached it: an un-annotated binding
    // threads nothing, so a plain run would build at the i32 default while the destination
    // is the source's own backing.
    const pk = pendingKindOfMf(kk, row)
    const seq = liKinds.length
    const slots: i32[] = []
    let g = 0
    while g < groups.length {
      // A source of another scalar element builds at its own rep, then copies converting.
      const gk = spreadGroupSrcKind(groups[g], elems, kk, fnIx)
      let groupKind = pk
      if gk != kk { groupKind = pendingKindOfMf(gk, 0) }
      // A fresh source built at a row no source has is built at exactly that row (D4871).
      if row != ownRow && groupKind == LBK_REF { groupKind = LBK_REF_AT_SLOT }
      if emitSpreadGroup(body, groups[g], fnIx, groupKind, row, ec) < 0 {
        return -1
      }
      svSyncRecv(groups[g], fnIx)
      if gk != kk && kk == "str" {
        if emitAtomListToStrTop(spreadSrcAtomTexts(groups[g], fnIx)) < 0 {
          return -1
        }
      } else if gk != kk {
        if (
          emitScalarListWidenTop(
            body,
            spreadScalarVKind(gk),
            spreadScalarVKind(kk),
          )
          < 0
        ) {
          return -1
        }
      }
      const gs = spreadGroupWrapSlot(kk, row, seq + g)
      slots.push(gs)
      fbLocalSet(gs)
      g = g + 1
    }
    return spreadJoinGroups(slots, wrap, back, kk, row, seq)
  }
  emitFail("emitProgram: expected an array literal")
}

// The ref-list row spread literal `arrIx` of kind `kk` builds at: the threaded destination's
// row, else the literal's own typed element's, when every source of another row is itself a
// list literal, built there as any literal is (D4871); else `own`, the first source's.
function spreadFreshDestRow(
  arrIx: i32,
  kk: MfKind,
  own: i32,
  fnIx: i32,
  lb: ListBuild,
): i32 {
  const a = nodeAt(arrIx)
  if kk != "ref" || !(a is ArrayLit) { return own }
  let want = spreadLitElemRow(arrIx)
  if lb.lbKind == LBK_REF || lb.lbKind == LBK_REF_AT_SLOT { want = lb.lbSlot }
  if want == own || want < 0 || want >= rlElemName.length { return own }
  const elems = a.arrElems
  for el in elems {
    const src = spreadArgOf(el)
    if src >= 0 {
      const lit = unwrapParen(src)
      const isLit = lit >= 0 && lit < P.nodes.length && nodeAt(lit) is ArrayLit
      if !isLit && refListSlotOfExpr(src, fnIx) != want { return own }
    }
  }
  want
}

// Join a spread literal's item groups, each already a list at (`kk`, `row`) in its own frame
// slot: allocate the destination once, then one `array.copy` per group in source order.
function spreadJoinGroups(
  slots: i32[],
  wrap: i32,
  back: i32,
  kk: MfKind,
  row: i32,
  seq: i32,
) {
  const totL = widenTmpSlot(2000 + 2 * seq)
  const offL = widenTmpSlot(2001 + 2 * seq)
  const dstL = spreadDstBackSlot(kk, row, seq)
  fbI32Const(0)
  fbLocalSet(totL)
  let t = 0
  while t < slots.length {
    fbLocalGet(totL)
    fbLocalGet(slots[t])
    fbStructGet(wrap, 1) // the group's logical length
    fbI32Bin(106)        // 0x6a i32.add
    fbLocalSet(totL)
    t = t + 1
  }
  fbLocalGet(totL)
  fbArrayNewDefault(back)
  fbLocalSet(dstL)
  // The result wrapper is built FIRST and left on the stack, so the `array.copy` runs below
  // consume their own operands and nothing has to re-read it — `emitArrSlice`'s discipline.
  // The backing rides a NULLABLE frame slot and the wrapper's field is not, so it recovers.
  fbLocalGet(dstL)
  fbRefAsNonNull()
  fbLocalGet(totL)
  fbLocalGet(totL)
  fbStructNew(wrap)
  fbI32Const(0)
  fbLocalSet(offL)
  let c = 0
  while c < slots.length {
    fbLocalGet(dstL)     // dest backing
    fbLocalGet(offL)     // dest offset
    fbLocalGet(slots[c])
    fbStructGet(wrap, 0) // src backing
    fbI32Const(0)        // src offset
    fbLocalGet(slots[c])
    fbStructGet(wrap, 1) // count
    fbArrayCopy(back, back)
    if c + 1 < slots.length {
      fbLocalGet(offL)
      fbLocalGet(slots[c])
      fbStructGet(wrap, 1)
      fbI32Bin(106) // i32.add
      fbLocalSet(offL)
    }
    c = c + 1
  }
  0
}

// The union-box list row a spread literal builds at when its destination threaded one
// (`const q: (i32 | null)[] = [...ints]`, or the row an outer literal, `push` or cell write
// names as `LBK_REF_AT_SLOT`) and some spread source is another list, whose elements are then
// each boxed; -1 otherwise, including when nothing threaded (D2869, D2883).
function spreadBoxDestRow(elems: i32[], fnIx: i32, lb: ListBuild): i32 {
  if (
    lb.lbKind != LBK_UNION
    && lb.lbKind != LBK_REF_AT_SLOT
    && lb.lbKind != LBK_REF
  ) {
    return -1
  }
  const row = lb.lbSlot
  if row < 0 || row >= rlElemKindTbl.length || row >= rlElemName.length {
    return -1
  }
  if rlElemKindTbl[row] != RLK_UNION { return -1 }
  let boxes = false
  let i = 0
  while i < elems.length {
    const src = spreadArgOf(elems[i])
    if src >= 0 {
      const sb = spreadSrcBoxes(src, row, fnIx)
      if sb < 0 { return -1 }
      if sb == 1 { boxes = true }
    }
    i = i + 1
  }
  if boxes { return row }
  -1
}

// `emitArrSpread` for a destination list of union boxes: a same-row source copies as it is,
// a record list is boxed by the element-converting copy, a scalar list by its boxing sibling,
// and a plain run builds at the row; the groups then join as every spread's do.
function emitArrSpreadBoxed(
  body: u8[],
  arrIx: i32,
  row: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const a = nodeAt(arrIx)
  if !(a is ArrayLit) {
    return emitFail("emitProgram: expected an array literal")
  }
  const kk: MfKind = "ref"
  const wrap = spreadWrapIdx(kk, row)
  const back = spreadBackIdx(kk, row)
  if wrap < 0 || back < 0 {
    return emitFail("emitProgram: spread literal but list type not collected")
  }
  const groups: i32[] = []
  const isSrc: boolean[] = []
  let run: i32[] = []
  let i = 0
  while i < a.arrElems.length {
    const src = spreadArgOf(a.arrElems[i])
    if src >= 0 {
      if run.length > 0 {
        groups.push(spreadRunLit(run, arrIx, arrIx, a.pos))
        isSrc.push(false)
        run = []
      }
      groups.push(src)
      isSrc.push(true)
    } else {
      run.push(a.arrElems[i])
    }
    i = i + 1
  }
  if run.length > 0 {
    groups.push(spreadRunLit(run, arrIx, arrIx, a.pos))
    isSrc.push(false)
  }
  const seq = liKinds.length
  const slots: i32[] = []
  let g = 0
  while g < groups.length {
    if emitSpreadGroupBoxed(body, groups[g], isSrc[g], row, fnIx, ec) < 0 {
      return -1
    }
    const gs = spreadGroupWrapSlot(kk, row, seq + g)
    slots.push(gs)
    fbLocalSet(gs)
    g = g + 1
  }
  spreadJoinGroups(slots, wrap, back, kk, row, seq)
}

// One group of `emitArrSpreadBoxed`, left on the stack as a list at union-box row `row`.
function emitSpreadGroupBoxed(
  body: u8[],
  grp: i32,
  isSrc: boolean,
  row: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if !isSrc { return emitSpreadGroup(body, grp, fnIx, LBK_UNION, row, ec) }
  const k = mfRecvKindOf(grp, fnIx)
  if k == "ref" {
    const s = refListSlotOfExpr(grp, fnIx)
    if emitSpreadGroup(body, grp, fnIx, LBK_REF, s, ec) < 0 { return -1 }
    if s == row { return 0 }
    if rlWidenVariantOf(s, row) < 0 {
      return emitFailAt(
        "emitProgram: a boxing spread reached a source `spreadSrcBoxes` does not admit",
        grp,
      )
    }
    return emitRefListWidenTop(body, s, row)
  }
  let un = ""
  if row >= 0 && row < rlElemName.length { un = rlElemName[row] }
  const ak = spreadSrcBoxAtom(grp, un)
  // Unreachable past `spreadSrcBoxes`, which admits only a scalar source whose element is a
  // member or widens to one.
  if k == null || k == "u8" || ak < 0 {
    return emitFailAt(
      "emitProgram: a boxing spread reached a source `spreadSrcBoxes` does not admit",
      grp,
    )
  }
  if emitSpreadGroup(body, grp, fnIx, pendingKindOfMf(k, 0), 0, ec) < 0 {
    return -1
  }
  emitScalarListBoxTop(spreadScalarVKind(k), ak, row)
}

// One list operand `g` of a spread literal or a widening concat: a list literal is built at
// its stamp's pair, else at the pair (`kind`, `row`) the join copies it from; any other
// operand as it is. Returns 0 once the list is on the stack, -1 on failure.
function emitSpreadGroup(
  body: u8[],
  g: i32,
  fnIx: i32,
  kind: i32,
  row: i32,
  ec: ExpCtx,
): i32 {
  const lit = unwrapParen(g)
  if lit < 0 || !(nodeAt(lit) is ArrayLit) {
    return emitExpr(body, g, fnIx, ec)
  }
  const tb = arrLitBuild(lit, arrLitTyAt(lit, fnIx), fnIx)
  if tb != null { return emitArrAt(body, lit, fnIx, tb, ec) }
  const gb: ListBuild = { lbKind: kind, lbSlot: row }
  emitArrAt(body, lit, fnIx, gb, ec)
}

// The element kind group `g` of a spread literal building at `kk` is emitted at: a spread
// source's own kind where it widens to `kk`, else `kk` itself (a plain run, or a same-kind source).
function spreadGroupSrcKind(
  g: i32,
  elems: i32[],
  kk: MfKind,
  fnIx: i32,
): MfKind {
  let i = 0
  while i < elems.length {
    if spreadArgOf(elems[i]) == g {
      const sk = mfRecvKindOf(g, fnIx)
      if sk != null && spreadElemWidens(sk, kk) { return sk }
      if kk == "str" && spreadSrcAtomTexts(g, fnIx).length > 0 { return "i32" }
      return kk
    }
    i = i + 1
  }
  kk
}

// The scalar element kind a list build code names, or `null`.
function spreadPendingScalar(pk: i32): MfKind | null {
  if pk == LBK_F64_LIST { return "f64" }
  if pk == LBK_I64_LIST { return "i64" }
  if pk == LBK_F32_LIST { return "f32" }
  null
}

// The scalar `VKind` spelling of a spread element kind, for the converting copy.
function spreadScalarVKind(k: MfKind): VKind {
  match k {
    "f64" => {
      return "f64"
    }
    "i64" => {
      return "i64"
    }
    "f32" => {
      return "f32"
    }
    "i32" => {
      return "i32"
    }
    "u8" => {
      return "u8list"
    }
    "str" => {
      return "str"
    }
    "ref" => {
      return "reflist"
    }
  }
}

// A run of plain elements as its own `ArrayLit`, built at holder `h`'s type and reporting at
// the spread literal's position.
// A synthesized node takes the parser's last cursor otherwise, which would put a diagnostic
// over it at the end of the file.
function spreadRunLit(run: i32[], arrIx: i32, h: i32, pos: i32): i32 {
  const ix = mkArrayLit(run, pos)
  adoptNodeTok(ix, arrIx)
  elabSpreadRunNote(ix, h)
  ix
}

// Whether any of a string-list literal's elements is a `string | null` value: a nested literal's
// inner list records the template's element, and its hole instance may pin a null there (D3114).
function arrLitHoldsNulStr(elems: i32[], fnIx: i32): boolean {
  let i = 0
  while i < elems.length {
    const e = nodeAt(unwrapParen(elems[i]))
    if !(e is StrLit) && exprNullableString(elems[i], fnIx) { return true }
    i = i + 1
  }
  false
}

// Lower an array literal `[e, e, ...]` onto `body` as a growable list value: the elements in
// source order, `array.new_fixed` for the backing, then `count` twice for len and cap and
// `struct.new` for the wrapper; an empty `[]` shares its type's empty backing. Built at the
// checker's type for it unless it has none; context restored on exit.
function emitArr(body: u8[], arrIx: i32, fnIx: i32, ec: ExpCtx) {
  emitArrAt(body, arrIx, fnIx, arrLitListBuild(arrIx, fnIx), ec)
}

// `emitArr` at the build pair `lb`: the literal's own, or the one a spread literal builds each
// of its item groups at.
function emitArrAt(
  body: u8[],
  arrIx: i32,
  fnIx: i32,
  lb: ListBuild,
  ec: ExpCtx,
) {
  const saved = expCtxHere(ec)
  elabSpreadNote(arrIx)
  const r = emitArrUnder(body, arrIx, fnIx, lb, ec)
  expCtxLeave(saved, r, ec)
}

// The build pair list literal `arrIx` takes in `fnIx`: its stamp's, else its own shape's.
function arrLitListBuild(arrIx: i32, fnIx: i32): ListBuild {
  const tb = arrLitBuild(arrIx, arrLitTyAt(arrIx, fnIx), fnIx)
  if tb != null { return tb }
  const own: ListBuild = {
    lbKind: exprListCellBuildKind(arrIx, fnIx),
    lbSlot: exprListCellBuildSlot(arrIx, fnIx),
  }
  own
}

// The type list literal `arrIx` builds at in `fnIx`: its stamp, a type parameter in it read at
// the instance `fnIx` is.
function arrLitTyAt(arrIx: i32, fnIx: i32): i32 {
  tyAtInstance(litRepTyAt(arrIx, fnIx), fnIx)
}

// `ty` with its type parameters read at the instance `fnIx` is; `ty` where that leaves one open.
function tyAtInstance(ty: i32, fnIx: i32): i32 {
  if ty < 0 || !tyHasTyVar(ty) { return ty }
  const it = instanceTyOf(ty, fnIx)
  if it >= 0 { return it }
  ty
}

// The build pair list literal `arrIx` of type `ty` takes: its type's, else that of the list type
// its destinations agree on; null, for its own shape's, when the record solve builds its
// elements at another record (`recBuildRowOf`).
function arrLitBuild(arrIx: i32, ty: i32, fnIx: i32): ListBuild | null {
  const a = nodeAt(arrIx)
  // Kept until the checker records the list type such elements make (D14381).
  if (
    a is ArrayLit
    && a.arrElems.length > 0
    && nodeAt(a.arrElems[0]) is ObjLit
    && recBuildRowOf(a.arrElems[0]) >= 0
  ) {
    return null
  }
  // A destination's union element boxes the elements, so the list is built at it (D4635).
  if arrLitUnionDestTaken(arrIx) {
    const db = listBuildOfTy(tyAtInstance(arrLitDestTy(arrIx), fnIx))
    if db != null { return db }
  }
  const tb = listBuildOfTy(ty)
  if tb != null { return tb }
  listBuildOfTy(tyAtInstance(arrLitDestTy(arrIx), fnIx))
}

// The ref-list row list literal `arrIx` builds at its checker type, -1 where it is no literal
// or its type names no ref-list row.
function arrLitRefSlotAtTy(arrIx: i32, fnIx: i32): i32 {
  if !(nodeAt(arrIx) is ArrayLit) { return -1 }
  const ty = arrLitTyAt(arrIx, fnIx)
  const tb = arrLitBuild(arrIx, ty, fnIx)
  if tb == null { return -1 }
  if tb.lbKind != LBK_REF && tb.lbKind != LBK_UNION { return -1 }
  tb.lbSlot
}

// The packed `u8[]` arm of `emitArrUnder`: each element as a plain i32 truncated into the
// byte backing, or one data segment when the literal is too long for `array.new_fixed`.
// Returns 0 once the list is on the stack, -1 on failure.
function emitArrU8(body: u8[], elems: i32[], fnIx: i32, ec: ExpCtx) {
  if !ba8Used {
    return emitFail(
      "emitProgram: u8 array literal but u8 list type not collected",
    )
  }
  if elems.length > NEW_FIXED_MAX {
    const dU8 = arrLitDataBuild(body, elems, fnIx, ALD_U8, ba8TypeIdx, ec)
    if dU8 < 0 { return -1 }
    if dU8 == 1 { return arrLitWrap(elems.length, bl8TypeIdx) }
    return emitFail(
      "emitProgram: u8 array literal is too long for one array.new_fixed",
    )
  }
  let iu8 = 0
  while iu8 < elems.length {
    if exprArray(elems[iu8], fnIx) || exprRefArray(elems[iu8], fnIx) {
      return emitFail("emitProgram: nested arrays are not supported")
    }
    if emitExpr(body, elems[iu8], fnIx, ec) < 0 { return -1 }
    iu8 = iu8 + 1
  }
  fbBacking(ba8TypeIdx, elems.length) // builds the packed byte backing
  fbI32Const(elems.length)            // len
  fbI32Const(elems.length)            // cap
  fbStructNew(bl8TypeIdx)             // the `u8[]` wrapper
  return 0
}

// The f32-list arm of `emitArrUnder`. Returns 0 once the list is on the stack, -1 on failure.
function emitArrF32(body: u8[], elems: i32[], fnIx: i32, ec: ExpCtx) {
  if !fa32Used {
    return emitFail(
      "emitProgram: f32 array literal but f32 list type not collected",
    )
  }
  let dstF32 = -1
  let coffF32 = 0
  if elems.length > NEW_FIXED_MAX {
    const dF32 = arrLitDataBuild(body, elems, fnIx, ALD_F32, fa32TypeIdx, ec)
    if dF32 < 0 { return -1 }
    if dF32 == 1 { return arrLitWrap(elems.length, fl32TypeIdx) }
    dstF32 = arrLitChunkStart("f32", 0, fa32TypeIdx, elems.length, false)
  }
  let i32f = 0
  while i32f < elems.length {
    if exprArray(elems[i32f], fnIx) || exprRefArray(elems[i32f], fnIx) {
      return emitFail("emitProgram: nested arrays are not supported")
    }
    // Each element lowered as f32 (a float literal re-encoded; an i32 operand converted
    // via `f32.convert_i32_s`) so the backing's element type matches.
    if emitExprAsF32(body, elems[i32f], fnIx, ec) < 0 { return -1 }
    i32f = i32f + 1
    if dstF32 >= 0 {
      coffF32 = arrLitChunkFlush(
        dstF32,
        fa32TypeIdx,
        coffF32,
        i32f,
        elems.length,
      )
    }
  }
  if dstF32 >= 0 {
    fbLocalGet(dstF32)
    fbRefAsNonNull() // the chunk-built f32 backing
  } else {
    fbBacking(fa32TypeIdx, elems.length) // builds the f32 backing
  }
  fbI32Const(elems.length) // len
  fbI32Const(elems.length) // cap
  fbStructNew(fl32TypeIdx) // the f32-list wrapper
  return 0
}

// The f64-list arm of `emitArrUnder`. Returns 0 once the list is on the stack, -1 on failure.
function emitArrF64(
  body: u8[],
  arrIx: i32,
  elems: i32[],
  fnIx: i32,
  ec: ExpCtx,
) {
  if !fa64Used {
    return emitFail(
      "emitProgram: f64 array literal but f64 list type not collected",
    )
  }
  const hF64 = forLitHoist(
    arrIx,
    elems,
    fnIx,
    ALD_F64,
    fa64TypeIdx,
    fl64TypeIdx,
    ec,
  )
  if hF64 != 0 { return if hF64 < 0 { -1 } else { 0 } }
  let dstF64 = -1
  let coffF64 = 0
  if elems.length > NEW_FIXED_MAX {
    const dF64 = arrLitDataBuild(body, elems, fnIx, ALD_F64, fa64TypeIdx, ec)
    if dF64 < 0 { return -1 }
    if dF64 == 1 { return arrLitWrap(elems.length, fl64TypeIdx) }
    dstF64 = arrLitChunkStart("f64", 0, fa64TypeIdx, elems.length, false)
  }
  let i = 0
  while i < elems.length {
    if exprArray(elems[i], fnIx) || exprRefArray(elems[i], fnIx) {
      return emitFail("emitProgram: nested arrays are not supported")
    }
    // Each element is lowered as an f64 (a float literal → `f64.const`; an i32
    // operand widened via `f64.convert_i32_s`) so the backing's element type matches.
    if emitExprAsF64(body, elems[i], fnIx, ec) < 0 { return -1 }
    i = i + 1
    if dstF64 >= 0 {
      coffF64 = arrLitChunkFlush(dstF64, fa64TypeIdx, coffF64, i, elems.length)
    }
  }
  if dstF64 >= 0 {
    fbLocalGet(dstF64)
    fbRefAsNonNull() // the chunk-built f64 backing
  } else {
    fbBacking(fa64TypeIdx, elems.length) // 0xfb 0x08; builds the f64 backing
  }
  fbI32Const(elems.length) // 0x41 i32.const (len)
  fbI32Const(elems.length) // 0x41 i32.const (cap)
  fbStructNew(fl64TypeIdx) // 0xfb 0x00 <f64-list wrapper struct type index>
  return 0
}

// The i64-list arm of `emitArrUnder`. Returns 0 once the list is on the stack, -1 on failure.
function emitArrI64(body: u8[], elems: i32[], fnIx: i32, ec: ExpCtx) {
  if !ia64Used {
    return emitFail(
      "emitProgram: i64 array literal but i64 list type not collected",
    )
  }
  let dstI64 = -1
  let coffI64 = 0
  if elems.length > NEW_FIXED_MAX {
    const dI64 = arrLitDataBuild(body, elems, fnIx, ALD_I64, ia64TypeIdx, ec)
    if dI64 < 0 { return -1 }
    if dI64 == 1 { return arrLitWrap(elems.length, il64TypeIdx) }
    dstI64 = arrLitChunkStart("i64", 0, ia64TypeIdx, elems.length, false)
  }
  let i = 0
  while i < elems.length {
    if exprArray(elems[i], fnIx) || exprRefArray(elems[i], fnIx) {
      return emitFail("emitProgram: nested arrays are not supported")
    }
    // Each element lowered as i64 (an i64 literal directly; an i32 operand sign-
    // extended via `i64.extend_i32_s`) so the backing's element type matches.
    if emitExprAsI64(body, elems[i], fnIx, ec) < 0 { return -1 }
    i = i + 1
    if dstI64 >= 0 {
      coffI64 = arrLitChunkFlush(dstI64, ia64TypeIdx, coffI64, i, elems.length)
    }
  }
  if dstI64 >= 0 {
    fbLocalGet(dstI64)
    fbRefAsNonNull() // the chunk-built i64 backing
  } else {
    fbBacking(ia64TypeIdx, elems.length) // builds the i64 backing
  }
  fbI32Const(elems.length) // len
  fbI32Const(elems.length) // cap
  fbStructNew(il64TypeIdx) // the i64-list wrapper
  return 0
}

// The string-list arm of `emitArrUnder`. Returns 0 once the list is on the stack, -1 on
// failure.
function emitArrStr(
  body: u8[],
  arrIx: i32,
  elems: i32[],
  fnIx: i32,
  ec: ExpCtx,
) {
  if !slUsed {
    return emitFail(
      "emitProgram: string array literal but string list type not collected",
    )
  }
  const hStr = forLitHoist(arrIx, elems, fnIx, ALD_STR, mkArrIdx, mkListIdx, ec)
  if hStr != 0 { return if hStr < 0 { -1 } else { 0 } }
  let dstStr = -1
  let coffStr = 0
  if elems.length > allocLitChunk() {
    dstStr = arrLitChunkStart("str", 0, mkArrIdx, elems.length, false)
  }
  // A `(string | null)[]` literal shares the string backing, but a `null` element lowers as
  // `ref.null $sTypeIdx` (a real string element rides its `array.new_fixed` string untouched) —
  // seed `nulString` for the element emits (the string niche analogue of `nulBool`).
  // A generic instance reads its own element: the template records `(T | null)[]` (D10881).
  if (arrElemIsNulStrAt(arrIx, fnIx) || arrLitHoldsNulStr(elems, fnIx)) {
    const nsc = expCtxHere(ec)
    nsc.nulString = true
    expCtxApply(nsc, ec)
  }
  let i = 0
  while i < elems.length {
    // A literal-union atom element widens to its member string. The backing is
    // `(ref null $aTypeIdx)` and the atom's rep is an i32 id, so without this the element
    // store is `expected (ref null $type), found i32` — check-clean invalid wasm.

    // Reached whenever the literal already builds a string list, and what decides that is the
    // recorded context type, not the element order: `arrLitIsStr` answers true outright for a
    // `(string | null)[]` and for a `string[]` literal however their elements are ordered, and
    // falls through to the first element's type only when no context rule fires.
    if emitStrValue(body, elems[i], fnIx, ec) < 0 { return -1 }
    i = i + 1
    if dstStr >= 0 {
      coffStr = arrLitChunkFlushAt(
        dstStr,
        mkArrIdx,
        coffStr,
        i,
        elems.length,
        allocLitChunk(),
      )
    }
  }
  if dstStr >= 0 {
    fbLocalGet(dstStr)
    fbRefAsNonNull() // the chunk-built string-ref backing
  } else {
    fbBacking(mkArrIdx, elems.length) // 0xfb 0x08; builds the string-ref backing
  }
  fbI32Const(elems.length) // 0x41 i32.const (len)
  fbI32Const(elems.length) // 0x41 i32.const (cap)
  fbStructNew(mkListIdx)   // 0xfb 0x00 <string-list wrapper struct type index>
  return 0
}

// The ref-list arm of `emitArrUnder`: the element slot comes from a threaded annotation, else
// element 0, and decides the backing, the wrapper and the context each element builds under.
// Returns 0 once the list is on the stack, -1 on failure.
function emitArrRef(
  body: u8[],
  arrIx: i32,
  elems: i32[],
  fnIx: i32,
  lb: ListBuild,
  ec: ExpCtx,
) {
  if !rlUsed {
    return emitFail(
      "emitProgram: ref array literal but ref list type not collected",
    )
  }
  // The element type decides which (backing, wrapper) pair this literal builds: a ref pair's
  // row, else element 0's.
  const rslot = arrRefSlotOf(arrIx, elems, fnIx, lb)
  if rslot < 0 { return -1 }
  // A concrete-VARIANT element list (`Cat[]`) has no `sNames` entry: each element is coerced
  // into the arm read off the slot's element type, any `| null` peeled.
  let elemVariantIdx = -1
  if rlElemKindTbl[rslot] == RLK_STRUCT && rlElemLitStructRow(rslot) < 0 {
    elemVariantIdx = repVariantShapeRowOf(tyPeelNul(rlElemTyIxAt(rslot)))
  }
  // A UNION-element list (kind 2) coerces each element into the box at the
  // write boundary (`emitUnionCoerce` — the host's per-element `coerceUnion`):
  // a bare scalar/string boxes under its atom's tag; an object literal /
  // already-union value passes through to its existing boxing.
  let elemUnionNm = ""
  let elemUnionTy = -1
  if rlElemKindTbl[rslot] == RLK_UNION {
    elemUnionNm = rlUnionNameOfTy(rslot, nodeTyInOf(arrIx, fnIx))
    // The type `rlUnionNameOfTy` names: the slot's element, or the literal's own where the
    // slot is a generic body's hole.
    elemUnionTy = rlElemTyIxAt(rslot)
    const litEt = tyArrayElemIx(nodeTyInOf(arrIx, fnIx))
    if litEt >= 0 && !tyHasTyVar(litEt) && tyHasTyVar(elemUnionTy) {
      elemUnionTy = litEt
    }
  }
  // A nested LIST element kind (`i32[][]` 4 / `string[][]` 6 / `f64[][]` 7 / `i64[][]` 8):
  // the elements ARE arrays, each built at its own type.
  const elemNest = rlElemKindTbl[rslot]
  let dstRef = -1
  let coffRef = 0
  if elems.length > allocLitChunk() {
    dstRef = arrLitChunkStart(
      "ref",
      rslot,
      rlBackIdx[rslot],
      elems.length,
      false,
    )
  }
  let i = 0
  const rc = expCtxHere(ec)
  while i < elems.length {
    // A non-nested-list element list must not hold array elements. Kinds 4/6/7/8 (scalar
    // inner lists) and 9 (ref inner list) legitimately do — and so does a union-box element
    // whose union has a list arm (`(i32[] | f64)[]` with a `[1, 2]` element): the array boxes
    // through `emitUnionBoxArg` and `emitUnionCoerce`, whose own rejects bite.
    if (
      elemNest != RLK_I32_LIST
      && elemNest != RLK_STR_LIST
      && elemNest != RLK_F64_LIST
      && elemNest != RLK_I64_LIST
      && elemNest != RLK_REF_LIST
      && elemNest != RLK_F32_LIST
      && elemNest != RLK_U8_LIST
      && elemUnionNm == ""
    ) {
      if exprArray(elems[i], fnIx) || exprRefArray(elems[i], fnIx) {
        return emitFail("emitProgram: nested arrays are not supported")
      }
    }
    expCtxApply(rc, ec)
    if elemUnionNm != "" {
      // Box the element into the shared union box — a concrete variant element widens via
      // `emitUnionBoxArg`, like a call argument or return.
      if (
        emitUnionBoxArg(body, elemUnionNm, elemUnionTy, elems[i], fnIx, ec)
        < 0
      ) {
        return -1
      }
    } else {
      if (emitArrRefElem(body, elems[i], fnIx, rslot, elemVariantIdx, ec) < 0) {
        return -1
      }
    }
    i = i + 1
    if dstRef >= 0 {
      coffRef = arrLitChunkFlushAt(
        dstRef,
        rlBackIdx[rslot],
        coffRef,
        i,
        elems.length,
        allocLitChunk(),
      )
    }
  }
  if dstRef >= 0 {
    fbLocalGet(dstRef)
    fbRefAsNonNull() // the chunk-built ref backing
  } else {
    fbBacking(rlBackIdx[rslot], elems.length) // 0xfb 0x08; builds the ref backing
  }
  fbI32Const(elems.length)      // 0x41 i32.const (len)
  fbI32Const(elems.length)      // 0x41 i32.const (cap)
  fbStructNew(rlWrapIdx[rslot]) // 0xfb 0x00 <this slot's ref-list wrapper>
  return 0
}

// `emitArrRef`'s ref-list slot: a ref build pair's row, else element 0's, else
// slot 0 when the literal names none. -1 when no element type is interned at all.
function arrRefSlotOf(arrIx: i32, elems: i32[], fnIx: i32, lb: ListBuild) {
  const annKind = lb.lbKind
  const annSlot = lb.lbSlot
  let rslot = 0
  if (
    annKind == LBK_REF
    || annKind == LBK_UNION
    || annKind == LBK_REF_AT_SLOT
  ) {
    rslot = annSlot
  } else if elems.length >= 1 {
    rslot = arrLitRowSlotIn(arrIx, fnIx)
  } else {
    rslot = annSlot
  }
  if rslot < 0 {
    if rlElemName.length < 1 {
      return emitFail(
        "emitProgram: ref array literal with no interned element type",
      )
    }
    rslot = 0
  }
  rslot
}

// One non-union element `e` of `emitArrRef`'s list at slot `rslot`, built as is or coerced
// into the arm `elemVariantIdx`. Returns 0 once the element is on the stack, -1 on failure.
function emitArrRefElem(
  body: u8[],
  e: i32,
  fnIx: i32,
  rslot: i32,
  elemVariantIdx: i32,
  ec: ExpCtx,
) {
  const elCtx = expCtxHere(ec)
  if elemVariantIdx >= 0 && rlElemNullable[rslot] != 1 {
    // A non-null ARM element takes every value through `emitVariantCoerce`, a join
    // included; the coerce owns the narrowed unbox (D4639).
    if emitVariantCoerce(body, elemVariantIdx, e, fnIx, ec) < 0 { return -1 }
  } else {
    const elArmOwed = narrowedArmNeedsUnbox(e, fnIx)
    if emitExprExpect(body, e, fnIx, elCtx) < 0 { return -1 }
    // The narrowed-arm unbox at a ref-list element (D1031) — `[s]` of a `Circle[]` under
    // `if s is Circle`. The slot's own element heap is the destination, the same one
    // `rlBackIdx` types the backing array with.
    if elArmOwed { emitNarrowedArmUnboxTo(rlElemArmHeapOf(rslot), e, fnIx) }
  }
  // Read-only covariance at a nested-list element (D791, D965) — `[lv1]` of a
  // `(readonly Shape[])[]`.
  emitNestedListWidenSite(body, e, fnIx, rslot)
  0
}

// The default i32-list arm of `emitArrUnder`, including literal-union, nullable-boolean and
// `null` elements that share the i32 backing. Returns 0 once the list is on the stack, -1 on
// failure.
function emitArrI32(
  body: u8[],
  arrIx: i32,
  elems: i32[],
  fnIx: i32,
  lbKind: i32,
  ec: ExpCtx,
) {
  if !lUsed {
    return emitFail("emitProgram: array literal but list type not collected")
  }
  // Four element types share the i32 backing but do not lower like i32s, so each seeds the
  // element emits: `K[]` lowers member literals as interned atom ids, `(boolean|null)[]` and
  // `null[]` a `null` as the sentinel 2, and `(K|null)[]` both. The element type comes from the checker's
  // recorded type; the `lbKind` 8 and 9 legs catch an all-`null` `[null]`.
  const litArr = nodeArrayElemIsLitUnion(arrIx)
  const ic = expCtxHere(ec)
  if litArr { ic.litUnion = 1 }
  if (
    arrElemIsNulBoolAt(arrIx, fnIx)
    || arrElemIsNullUnitAt(arrIx, fnIx)
    || lbKind == LBK_NUL_BOOL_LIST
  ) {
    ic.nulBool = true
  }
  if (
    (nodeArrayElemIsNulLitUnion(arrIx) && lbKind != LBK_UNION)
    || lbKind == LBK_NUL_LIT_UNION_LIST
  ) {
    ic.nulLitUnion = true
    ic.litUnion = 1
  }
  expCtxApply(ic, ec)
  const hI32 = forLitHoist(arrIx, elems, fnIx, ALD_I32, aTypeIdx, lTypeIdx, ec)
  if hI32 != 0 { return if hI32 < 0 { -1 } else { 0 } }
  let dstI32 = -1
  let coffI32 = 0
  if elems.length > NEW_FIXED_MAX {
    const dI32 = arrLitDataBuild(body, elems, fnIx, ALD_I32, aTypeIdx, ec)
    if dI32 != 0 {
      if dI32 < 0 { return -1 }
      return arrLitWrap(elems.length, lTypeIdx)
    }
    dstI32 = arrLitChunkStart("i32", 0, aTypeIdx, elems.length, false)
  }
  let i = 0
  while i < elems.length {
    if !litArr {
      if exprArray(elems[i], fnIx) || exprRefArray(elems[i], fnIx) {
        return emitFail("emitProgram: nested arrays are not supported")
      }
      if exprStruct(elems[i], fnIx) {
        return emitFail("emitProgram: struct array elements are not supported")
      }
      // A declared union arm reaching the i32-list fallback — the same shape as the struct arm
      // above and the map arm below. The two namespaces are exclusive, a name in `uVariants`
      // having no `sNames` row, so `exprStruct` declines for an arm by construction and the
      // element would reach `array.new_fixed $aTypeIdx` with a `(ref $uVarHeap)` operand.

      // A ref list of arms has a sound rep and the annotated spellings reach it; what has no
      // rep is an arm element on the i32 backing, which the inferred spelling reaches. Two
      // channels, as at the map arm below: the emit-side classifier, and the checker's recorded
      // node type for an inline literal.
      if exprVariantIndex(elems[i], fnIx) >= 0 || nodeTyIsVariant(elems[i]) {
        return emitFail(
          "emitProgram: union-arm array elements are not supported in this position",
        )
      }
      // A map-typed element reaching the i32-list fallback, with no ref-list or map-array kind
      // threaded: the map struct ref would be stored as an i32 element. A map array can only
      // build through the ref-list path with a threaded map-element kind, so with none here
      // there is no sound rep — fail loudly.
      if exprMap(elems[i], fnIx) || nodeTyIsMap(elems[i]) {
        return emitFail(
          "emitProgram: map array elements are not supported in this position",
        )
      }
    }
    if emitExpr(body, elems[i], fnIx, ec) < 0 { return -1 }
    i = i + 1
    if dstI32 >= 0 {
      coffI32 = arrLitChunkFlush(dstI32, aTypeIdx, coffI32, i, elems.length)
    }
  }
  if dstI32 >= 0 {
    fbLocalGet(dstI32)
    fbRefAsNonNull() // the chunk-built raw backing
  } else {
    fbBacking(aTypeIdx, elems.length) // 0xfb 0x08; builds the raw backing
  }
  // Wrap { backing, len = count, cap = count } via struct.new.
  fbI32Const(elems.length) // 0x41 i32.const (len)
  fbI32Const(elems.length) // 0x41 i32.const (cap)
  fbStructNew(lTypeIdx)    // 0xfb 0x00 <list wrapper struct type index>
  return 0
}

// Whether a non-empty literal's elements are all bare `null`s, so name no element kind.
function arrElemsAllNull(elems: i32[]): boolean {
  if elems.length == 0 { return false }
  let i = 0
  while i < elems.length {
    if !(nodeAt(unwrapParen(elems[i])) is NullLit) { return false }
    i = i + 1
  }
  true
}

// `emitArr`'s body: it applies each arm's element context and leaves it for the wrapper's
// exit to undo.
function emitArrUnder(
  body: u8[],
  arrIx: i32,
  fnIx: i32,
  lb: ListBuild,
  ec: ExpCtx,
) {
  const a = nodeAt(arrIx)
  if a is ArrayLit {
    const elems = a.arrElems
    if hasSpreadItem(elems) { return emitArrSpread(body, arrIx, fnIx, lb, ec) }
    if monoIsClashLit(arrIx) {
      return emitFailAt(
        "emitProgram: a list literal around a generic call whose `??` default is a list of "
          + "another element at this type argument has no lowering yet; give the default the "
          + "operand's own element type",
        arrIx,
      )
    }
    // An empty `[]` whose pair is the i32 default builds at the element type the checker
    // pinned on the literal itself — a join arm's sibling, a return's witness (D2209).
    if elems.length == 0 && lb.lbKind == LBK_I32_LIST {
      const hbk = emptyArrHoleBuildKind(arrIx)
      if hbk != LBK_I32_LIST {
        const hb: ListBuild = {
          lbKind: hbk,
          lbSlot: emptyArrHoleBuildSlot(arrIx),
        }
        return emitArrUnder(body, arrIx, fnIx, hb, ec)
      }
    }
    // Which (backing, wrapper) pair the literal builds — `lb.lbKind` 1/2 a ref backing, 3 a
    // string one, 4 f64, 6 i64, 7 f32, anything else the default `$lTypeIdx` i32 list. Two signals
    // answer it: the literal's own elements (`arrLitIs*`) and the build pair `lb`, from the
    // literal's type. A pair's kind is authoritative and clears what it displaces.
    let isRefLit = arrLitIsRef(arrIx, fnIx)
    let isStrLit = arrLitIsStr(arrIx, fnIx)
    const numKind = arrLitNumKind(arrIx, fnIx)
    let isF64Lit = numKind == ALK_F64
    let isI64Lit = numKind == ALK_I64
    // A literal whose elements are all f32-typed values self-identifies, exactly as the f64 and
    // i64 forms above do. A bare float literal stays f64 — `arrLitIsF32` claims only `exprIsF32`
    // elements, and a `.` literal is deliberately not one — so an annotation remains the only
    // route to `[1.5]` as an f32 list.
    let isF32Lit = arrLitIsF32(arrIx, fnIx)
    if lb.lbKind == LBK_I64_LIST {
      isI64Lit = true
      isF64Lit = false
      isStrLit = false
      isF32Lit = false
    }
    if lb.lbKind == LBK_F64_LIST {
      isF64Lit = true
      isI64Lit = false
      isStrLit = false
      isF32Lit = false
    }
    if lb.lbKind == LBK_F32_LIST {
      isF32Lit = true
      isF64Lit = false
      isI64Lit = false
      isStrLit = false
    }
    // A string-list pair claims a literal whose elements name no kind of their own: a
    // `(string | null)[]` niche under a threaded `null` seed, as in a run a variadic `.push`
    // appends (D4553), or an all-`null` run of a spread literal (D2964). An atom literal under
    // the pair stays an atom list, which the spread converts.
    if (
      lb.lbKind == LBK_STR_LIST
      && !isRefLit
      && (ec.nulString || arrElemsAllNull(elems))
    ) {
      isStrLit = true
      isF64Lit = false
      isI64Lit = false
      isF32Lit = false
    }
    if elems.length == 0 {
      if lb.lbKind == LBK_STR_LIST {
        isStrLit = true
      } else if lb.lbKind == LBK_F64_LIST {
        isF64Lit = true
      } else if lb.lbKind == LBK_I64_LIST {
        isI64Lit = true
      } else if lb.lbKind == LBK_F32_LIST {
        isF32Lit = true
      } else if lb.lbKind == LBK_NUL_BOOL_LIST {
        // A `(boolean | null)[]` empty literal — a plain i32-list wrapper (the boolean
        // sentinel niche shares the i32 backing); nothing to force here.
      } else {
        if lb.lbKind != LBK_I32_LIST { isRefLit = true }
      }
    }
    // A non-empty literal under a threaded union-list annotation (kind 2) is a ref literal even
    // when its elements are bare scalars or strings: a `(string|i32)[]` literal's elements coerce
    // into the union box at the write boundary, they do not type the list. Without the annotation
    // a scalar literal stays the i32 list.
    if lb.lbKind == LBK_UNION {
      isRefLit = true
      isStrLit = false
      isF64Lit = false
      // An `(i64 | null)[]` literal's i64-typed first element must not claim the scalar
      // i64-list path — the elements box (kind 2), like the f64/string forms above.
      isI64Lit = false
      // An `(f32 | null)[]` literal's f32 elements box the same way.
      isF32Lit = false
    }
    // A closure-element list (kind 5, `((i32) => i32)[]`): a literal of function values reads as
    // bare idents, so `arrLitIsRef` — which keys off an objlit or nested-array first element —
    // misses it, and the threaded annotation is authoritative. `isI64Lit` clears too, or a
    // ref-list value with an i64-magnitude first element would build the scalar i64 wrapper.
    if lb.lbKind == LBK_REF_AT_SLOT {
      isRefLit = true
      isStrLit = false
      isF64Lit = false
      isI64Lit = false
      isF32Lit = false
    }
    // A STRUCT ref-list (kind 1) under a threaded annotation: authoritative, like kind 2/5.
    // Matters for a NULLABLE-struct array (`(P | null)[]`) whose FIRST element is `null` —
    // `arrLitIsRef` keys off the first element (a `null` is neither objlit nor nested array)
    // and would otherwise mis-route the literal to the i32-list path.
    if lb.lbKind == LBK_REF {
      isRefLit = true
      isStrLit = false
      isF64Lit = false
      isI64Lit = false
      isF32Lit = false
    }
    // An ATOM-element literal under a threaded atom context (`ec.litUnion` — a `K[]`
    // field / binding): the member elements are STRING exprs syntactically (`arrLitIsStr`
    // would claim the string-list build), but each lowers as its interned i32 atom id —
    // the i32-list path is authoritative, like the kind overrides above.
    if ec.litUnion == 1 {
      isRefLit = false
      isStrLit = false
      isF64Lit = false
      isI64Lit = false
      isF32Lit = false
    }
    // A `(K | null)[]` literal (kind 9, or a probe-detected element type unless a union-box
    // destination is threaded, D3174): member elements lower as atom ids and `null` as -1, so the
    // i32-list path is authoritative over `arrLitIsStr`'s string-literal claim. The element seeds
    // are set further below.
    if (
      lb.lbKind == LBK_NUL_LIT_UNION_LIST
      || (nodeArrayElemIsNulLitUnion(arrIx) && lb.lbKind != LBK_UNION)
    ) {
      isRefLit = false
      isStrLit = false
      isF64Lit = false
      isI64Lit = false
      isF32Lit = false
    }
    // A `u8[]` literal (`lb.lbKind == 10`) — the packed byte list. Checked ahead of every
    // scalar arm below and returning directly, because the elements are ordinary i32 expressions:
    // nothing about the literal itself says `u8`, only the threaded annotation does. Each element
    // is emitted as a plain i32 and `array.new_fixed` truncates it into the packed byte.

    // 13 is `nulu8list`, a `u8[] | null` destination: the same packed path with a nullable cell.
    // Its three siblings each get an arm above (4 f64, 6 i64, 7 f32) that flips the literal's
    // element flag; without one, the literal falls to the default i32 backing while the cell is
    // typed as the packed wrapper — two heap types for one value (D983).
    if (lb.lbKind == LBK_U8_LIST || lb.lbKind == LBK_NUL_U8_LIST) {
      return emitArrU8(body, elems, fnIx, ec)
    }
    if isF32Lit { return emitArrF32(body, elems, fnIx, ec) }
    if isF64Lit { return emitArrF64(body, arrIx, elems, fnIx, ec) }
    if isI64Lit { return emitArrI64(body, elems, fnIx, ec) }
    if isStrLit { return emitArrStr(body, arrIx, elems, fnIx, ec) }
    if isRefLit { return emitArrRef(body, arrIx, elems, fnIx, lb, ec) }
    return emitArrI32(body, arrIx, elems, fnIx, lb.lbKind, ec)
  }
  emitFail("emitProgram: expected an array literal")
}

// ── G8: string-keyed maps — the open-addressing hash map ─────────────────────

// A map is the struct the map-table section describes in full. Operations hash the key (FNV-1a)
// into `index` and linear-probe to a free-or-matching slot, never an O(n) scan. A function that
// touches a map reserves a 15-slot scratch frame at `mapScratchBase`.

// The frame: +0 mapRef, +1 keyRef, +2 curRef, +3 slot, +4 cap, +5 entry, +6 keysBk, +7 valsBk,
// +8 chr, +9 hcur, +10 idxBk, +11 rslot, +12 liveBk, +13 hashBk, +14 valSet. `hcur` is the op's
// key hash, live from `emitMapProbe` through an appending set's `hashes[]` store.

// The i32-keyed rep re-types four of those slots and keeps five of its own, each minted on first
// use (`mapI32KeyLocal`): the i32 key, the keys backing, the key-list builder's two backings and
// the map struct. The i64-keyed rep has the same five (`mapI64KeyLocal`). `cmKeyKind` picks.

// The current op's map struct heap type / vals wrapper / vals backing.
function cmMapTy() { mapTypeIdxOf(cmSlot) }
function cmValsWrap() { mvValsWrapOf(cmSlot) }
function cmValsBack() { mvValsBackOf(cmSlot) }

// True when the current op runs on the i32-keyed rep. Two sources, because a map shape carries
// the key in two places depending on the value: the mono-value sentinels -4 (map) and -5 (Set),
// where a value on the shared i32 `vals` list interns no slot so the key has nowhere else to
// live; and an mv slot's own `mvKeyKind` column, the slot's identity being the (key, value) pair.

// Asked by every accessor below that picks between the two keys lists, the two probe helpers and
// the two key scratch slots. Everything else is key-blind by construction: it reads the value
// side, which the slot answers on its own.
function cmKeyKind() { mapShapeKeyKind(cmSlot) }
// Whether the current op's index is the (tag, entry) pair layout: an i32 or an i64 key.
function cmKeyInt() { cmKeyKind() != MAP_KEY_STR }
// Slot `k` of the current op's integer-key frame: the i32 frame or the i64 one.
function cmIntKeyLocal(k: i32) {
  if cmKeyKind() == MAP_KEY_I64 { return mapI64KeyLocal(k) }
  mapI32KeyLocal(k)
}
// The current op's keys-list wrapper and backing heap types: the string-ref pair for the
// string-keyed rep, the i32 or i64 list pair for an integer-keyed one.
function cmKeysWrap() {
  const k = cmKeyKind()
  if k == MAP_KEY_I32 { return lTypeIdx }
  if k == MAP_KEY_I64 { return il64TypeIdx }
  mkListIdx
}
function cmKeysBack() {
  const k = cmKeyKind()
  if k == MAP_KEY_I32 { return aTypeIdx }
  if k == MAP_KEY_I64 { return ia64TypeIdx }
  mkArrIdx
}
// The current op's target-key scratch local: the string frame's slot 1, a `(ref $sTypeIdx)`
// string, or an integer frame's slot 0, the raw key.
function cmKeyLocal() {
  if msHelp { return 1 }
  if cmKeyInt() { return cmIntKeyLocal(0) }
  mapScratchBase + 1
}
// The current op's grown or compacted keys-backing scratch local: the string frame's slot 6, or
// an integer frame's slot 1.
function cmKeysBkLocal() {
  if msHelp { return 6 }
  if cmKeyInt() { return cmIntKeyLocal(1) }
  mapScratchBase + 6
}
// True while a `__map_set_<row>__` body emits: its map, key and value are params 0, 1 and 2, and
// every other slot is the string frame's own, rebased to local 0, whatever the shape.
let msHelp = false
// The current op's mapRef local. An mv slot always uses its own typed frame slot, asked first
// because that frame is already typed to the slot's map struct whichever key rep it carries. Only
// the two mono shapes have to choose between the shared `(ref $mStructIdx)` scratch slot 0 and
// the i32-keyed frame's own, the mono local being typed to the string-keyed struct.
function cmMapRefLocal() {
  if msHelp { return 0 }
  if cmSlot >= 0 { return fnMvMapRefLocal(cmSlot) }
  if cmKeyInt() { return cmIntKeyLocal(4) }
  mapScratchBase
}
// The current op's vals-backing scratch local (grow/compact temporary).
function cmValsBkLocal() {
  if msHelp { return 7 }
  if cmSlot < 0 { return mapScratchBase + 7 }
  fnMvValsBkLocal(cmSlot)
}

// Evaluate the map receiver `recvIx` once and leave its `(ref $mapStruct)` on the operand stack,
// ready for the mapRef store. One home for evaluating a map receiver: the probe path
// (`emitMapRecvKey`) and the tombstone-aware `for`-in walk both come through here, because the
// two properties this owns are the two a second hand-written copy loses.

// The receiver is emitted exactly once, so its side effects run once and every later read sees
// the same object — a re-emitted receiver is a fresh evaluation, and a factory returning a new
// map per call leaves the two reads on different maps. And a nullable receiver (kind `nulmap`) is
// recovered before the mapRef store; omitting that is check-clean invalid wasm, never a message.
function pushMapRecvRef(body: u8[], recvIx: i32, fnIx: i32, ec: ExpCtx) {
  if emitExpr(body, recvIx, fnIx, ec) < 0 { return -1 }
  if exprNullableMap(recvIx, fnIx) { fbRefAsNonNull() }
  0
}

// `local.get` / `local.set` of the current op's mapRef.
function pushMapRef(_body: u8[]) {
  fbLocalGet(cmMapRefLocal()) // 0x20 local.get
  0
}
function setMapRef(_body: u8[]) {
  fbLocalSet(cmMapRefLocal()) // 0x21 local.set
  0
}

// `local.get` of map scratch slot `n` (the shared mono frame — every slot except
// the mapRef/valsBk/valStash trio is map-shape-agnostic and stays shared).
function pushMapScr(_body: u8[], n: i32) {
  fbLocalGet(mapScratchBase + n) // 0x20 local.get
  0
}

// `local.set` of map scratch slot `n`.
function setMapScr(_body: u8[], n: i32) {
  fbLocalSet(mapScratchBase + n) // 0x21 local.set
  0
}

// `M.keys` (the keys list wrapper ref): `local.get mapRef ; struct.get <mapTy> 0`.
function pushMapKeys(body: u8[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 0) // field 0: keys
  0
}

// `M.vals` (the vals list wrapper ref): `local.get mapRef ; struct.get <mapTy> 1`.
function pushMapVals(body: u8[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 1) // field 1: vals
  0
}

// `M.live` (the i32 tombstone array, parallel to entries; all 1s in this slice):
// `local.get mapRef ; struct.get <mapTy> 2`.
function pushMapLive(body: u8[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 2) // field 2: live
  0
}

// `M.index` (the i32 hash-slot array): `local.get mapRef ; struct.get <mapTy> 3`.
function pushMapIndex(body: u8[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 3) // field 3: index
  0
}

// `M.count` (entries appended): `local.get mapRef ; struct.get <mapTy> 4`.
function pushMapCount(body: u8[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 4) // field 4: count
  0
}

// `M.length` (live entry count): `local.get mapRef ; struct.get <mapTy> 5`.
function pushMapSize(body: u8[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 5) // field 5: size
  0
}

// `M.hashes` (the i32 per-entry FNV cache, parallel to the entries):
// `local.get mapRef ; struct.get <mapTy> 6`.
function pushMapHashes(body: u8[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 6) // field 6: hashes
  0
}

// `M.seqs` (the i64 per-entry insertion sequences, parallel to the entries), present only in a
// module that deletes (D2315): `local.get mapRef ; struct.get <mapTy> 7`.
function pushMapSeqs(body: u8[]) {
  pushMapRef(body)
  fbStructGet(cmMapTy(), 7) // field 7: seqs
  0
}

// The hash of the current op's string key, leaving a non-negative i32 on the stack: the FNV-1a
// of the string in the key slot, a call into the shared `__str_hash__` helper. An i32 key is
// never hashed here: it is its own tag in the pair index.
function emitMapHashOf(_body: u8[]) {
  fbLocalGet(cmKeyLocal())
  fbCall(gHelpStrHash)
  0
}

// The index position of the current op's probe slot (scratch slot 3): the slot itself in a
// string-keyed index; in an integer-keyed one's pairs, `2 * slot + k`, the tag (`k` 0) or the
// entry (`k` 1).
function pushMapSlotPos(body: u8[], k: i32) {
  pushMapScr(body, 3)
  if !cmKeyInt() { return 0 }
  fbI32Const(1)
  fbI32Bin(116) // 0x74 i32.shl
  if k != 0 {
    fbI32Const(k)
    fbI32Bin(114) // 0x72 i32.or
  }
  0
}

// Probe: with `mapRef` (slot 0) and the target `keyRef` (slot 1) set, linear-probe `M.index`,
// wrapping, to the slot holding either the matching key's entry or a free (0) one. Leaves `slot`
// (3) = that probe slot and `entry` (5) = its entry, 0 for a miss. Shared by get, has, set and
// delete; occupancy, dead markers included, stays under 1/2, so a free slot is reached.

// A dead entry stays a probe marker, never a hit, so delete does not break the chain (D2370).
// The string key is hashed here, as `__map_probe__`'s first operand, on an empty operand stack so
// no backing `struct.get` stays live across `__str_hash__`; `keepHash` parks it in scratch +9.
function emitMapProbe(body: u8[], keepHash: boolean) {
  // Push the probe's shape-agnostic components (the map struct type differs per value shape,
  // but `index`/`hashes`/`live`/`keys` are identically typed across shapes — only these
  // `struct.get`s stay at the call site) and call the shared helper, which returns the SLOT.
  const pk = cmKeyKind()
  if pk == MAP_KEY_I32 {
    pushMapIndex(body)
    fbLocalGet(cmKeyLocal()) // the raw i32 key, its own tag
    fbCall(gHelpMapProbeI32)
  } else if pk == MAP_KEY_I64 {
    pushMapIndex(body)
    fbLocalGet(cmKeyLocal()) // the i64 key; the helper hashes it to its tag
    pushMapKeysBacking(body)
    fbCall(gHelpMapProbeI64)
  } else {
    emitMapHashOf(body)
    if keepHash { fbLocalTee(mapScratchBase + 9) }
    pushMapIndex(body)
    pushMapHashes(body)
    pushMapLive(body)
    pushMapKeysBacking(body)
    fbLocalGet(cmKeyLocal()) // the target string key
    fbCall(gHelpMapProbe)
  }
  setMapScr(body, 3) // slot
  // entry = the slot's entry  (0 = miss; else entry-position + 1)
  pushMapIndex(body)
  pushMapSlotPos(body, 1)
  fbArrayGet(aTypeIdx) // array.get
  setMapScr(body, 5)   // entry
  0
}

// The one home of the `-3` map-value reject. Four op sites each spelled out this verdict, two of
// them enumerating a supported side that went stale. So the message names the remainder instead,
// which is small and stays small: `mvValKindOfName` lowers every scalar, litunion atom, struct,
// list at any nesting, nested map, union and closure, plus each one's nullable niche.

// What is left: a struct that is a member of a declared union, living in the variant table where
// the mv slot has no variant half; a nullable closure with a literal-union result; a nullable list
// whose element rep the layer does not name; and a value name resolving to none of these. The
// tail clause is a second producer, for a lowerable value whose mv slot nothing interned.
function failMapValueType() {
  emitFail(
    "emitProgram: unsupported map value type (no rep for a union-member struct, a nullable list over an unnamed element rep, or a nullable litunion-result closure; any other value type here interned no mv slot)",
  )
}

// Construct an EMPTY map `Map()` onto `body`: two empty lists (each `array.new_fixed`
// count 0, wrapped `{ backing, len=0, cap=0 }`), boxed into the map struct.
function emitMapNew(exprIx: i32, fnIx: i32) {
  if !mUsed { return emitFail("emitProgram: Map() but map type not collected") }
  // The shape of the map type the call is stamped with (D14226), keyed as its receivers key it
  // (D14229): -1/-2 the mono map, an mv slot >= 0 THIS value type's map struct. A call whose
  // type still holds a hole has no stamp, and builds as its binding's receivers read it.
  const mt = litRepTyAt(exprIx, fnIx)
  let slot = if mt >= 0 { mapCtorShapeOf(exprIx, mt) } else { mapShapeOfExpr(exprIx, fnIx) }
  if slot == -3 { return failMapValueType() }
  if slot == -2 { slot = -1 }
  if slot == -5 { slot = -4 }
  if slot == -7 { slot = -6 }
  // The keys/vals accessors below read the op context, so pin it to the shape being
  // constructed (a `Map()` is not reached through `emitMapRecvKey`).
  const savedCm = cmSlot
  cmSlot = slot
  // keys list: an empty backing → wrapper, in the KEY's own list rep (string-ref for
  // `{[string]: V}`, the i32 list for `{[i32]: V}`).
  fbBacking(cmKeysBack(), 0) // 0 elements
  fbI32Const(0)              // len = 0
  fbI32Const(0)              // cap = 0
  fbStructNew(cmKeysWrap())
  cmSlot = savedCm
  // vals list: empty backing → wrapper (the i32 list, or the slot's ref list).
  fbBacking(mvValsBackOf(slot), 0)
  fbI32Const(0)
  fbI32Const(0)
  fbStructNew(mvValsWrapOf(slot))
  // live: empty i32 array (cap 0), parallel to the empty keys/vals entry lists. In a module
  // that deletes it grows in lockstep with the keys backing (a fresh entry is live = 1).
  fbBacking(aTypeIdx, 0)
  // index: `INITIAL_CAP * 2` (16) zero-filled slots, 0 meaning empty — an i32 array of 16, or of
  // 32 for an i32 key's pairs. Occupancy, dead markers included, stays under 1/2 by resizing at
  // `count*2 >= cap`, so every probe reaches a free slot under any mix of inserts and deletes (D2280).
  if mapShapeKeyInt(slot) { fbI32Const(32) } else { fbI32Const(16) }
  fbArrayNewDefault(aTypeIdx)
  // count = 0, size = 0.
  fbI32Const(0)
  fbI32Const(0)
  // hashes: empty i32 array (cap 0). A STRING-keyed map grows it in lockstep with the keys
  // (each key's hash, which gates the probe and re-places the entry); an i32 key is its own tag
  // in the pair index, so an i32-keyed map's stays empty.
  fbBacking(aTypeIdx, 0)
  // seqs (empty) and the next sequence (0), in a module that deletes (D2315).
  if gMapDeletes {
    fbBacking(ia64TypeIdx, 0)
    fbI64Const(0, 0)
  }
  // map struct { keys, vals, live, index, count, size, hashes[, seqs, next] } — the mono
  // struct, or the mv slot's (identical shape, vals field referencing the slot's wrapper).
  fbStructNew(mapTypeIdxOf(slot))
  0
}

// Resolve the receiver's map shape and emit the receiver and key expressions, leaving both values
// on the operand stack ([mapRef, keyRef], keyRef on top) with `cmSlot` pinned to the shape. The
// caller pops key (slot 1) then mapRef.

// They stay off the scratch locals on purpose: an inner map op nested in the key expression — or,
// for a set, in the value expression evaluated between the key and the stores — runs its own probe
// through the same shared scratch frame, and a value parked in `mapRef` or `keyRef` would be
// silently clobbered. Values on the wasm operand stack are immune; nested ops touch only locals.
function emitMapRecvKey(
  body: u8[],
  recvIx: i32,
  keyIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if !mUsed {
    return emitFail("emitProgram: map op but map type not collected")
  }
  if !exprMap(recvIx, fnIx) {
    return emitFail("emitProgram: map op receiver is not a map")
  }
  // Resolve the receiver's map SHAPE into the op context. A Set (-2 / -5) runs on the
  // mono machinery of its own KEY rep; an unsupported value type (-3) fails loudly.
  const mshape0 = mapShapeOfExpr(recvIx, fnIx)
  if mshape0 == -3 { return failMapValueType() }
  const mshape = mapShapeFoldSet(mshape0)
  // The KEY expression must match the receiver's key rep. The checker proves the pair
  // agrees, so a mismatch here means the receiver's shape resolved wrong — reject
  // loudly rather than emit a string ref into an i32 keys array (invalid wasm).
  let keyAtom = false
  // A literal-union-keyed map hashes as i32 because its keys REP as the interned atom, so a
  // member written as a string literal must lower as that id rather than as a ref — the
  // checker has already proved the spelling is a member (D1748).
  let keyLitU = false
  const keyK = mapShapeKeyKind(mshape)
  if keyK == MAP_KEY_I64 {
    // An i64 key is emitted at its own width below; the checker proved it is an i64.
    if exprString(keyIx, fnIx) {
      return emitFail("emitProgram: i64-keyed map indexed with a string key")
    }
  } else if keyK == MAP_KEY_I32 {
    if exprString(keyIx, fnIx) {
      if !nodeTyMapKeyIsLitUnion(unwrapParen(recvIx)) {
        return emitFail("emitProgram: i32-keyed map indexed with a string key")
      }
      keyLitU = true
    }
  } else if !exprString(keyIx, fnIx) {
    // An atom-repped literal-union key is a string VALUE whose rep is the interned id, so it is
    // widened to its member text at the boundary rather than refused — the same widen `print`
    // performs, through the one home both consumers share (D1724).
    if !exprIsLitAtom(keyIx, fnIx) {
      return emitFail("emitProgram: map key is not a string")
    }
    keyAtom = true
  }
  // The receiver expr is emitted OUTSIDE the context (it is map-op-free by
  // construction — an Ident/global/constructor).
  if pushMapRecvRef(body, recvIx, fnIx, ec) < 0 { return -1 }
  // A string-keyed map's key is a string ref — shield it from an ambient atom context, since an
  // atom-typed binding init seeds `ec.litUnion` around the whole init and would lower the key
  // literal as an i32 atom id. An i32 key wants no shielding but is unharmed by it. An inner map
  // op in the key expression also clobbers `cmSlot`, so pin it afterwards.
  let keySeed = 0
  if keyLitU { keySeed = 1 }
  const savedKeyLU = expCtxSwapLitUnion(keySeed, ec)
  let kr = 0
  if keyAtom {
    kr = emitAtomToStr(body, keyIx, fnIx, ec)
  } else if keyK == MAP_KEY_I64 {
    kr = emitScalarValue(body, keyIx, fnIx, "i64", ec)
  } else {
    kr = emitExpr(body, keyIx, fnIx, ec)
  }
  expCtxSwapLitUnion(savedKeyLU, ec)
  if kr < 0 { return -1 }
  cmSlot = mshape
  0
}

// Load the map receiver and key into the scratch frame (slots 0 and 1) and run the probe, leaving
// `slot` (slot 3) = the probe slot and `entry` (slot 5) = `index[slot]`, 0 for a miss and else the
// entry position plus 1. `recvIx` and `keyIx` are arena indices; `recvIx` must be a map-typed
// expression and `keyIx` a string.
function emitMapPrep(
  body: u8[],
  recvIx: i32,
  keyIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitMapRecvKey(body, recvIx, keyIx, fnIx, ec) < 0 { return -1 }
  // Pop the stacked pair into the frame only now — user code is done running.
  fbLocalSet(cmKeyLocal()) // the target key
  setMapRef(body)          // mapRef (the shared mono slot, or this mv/i32 frame's)
  emitMapProbe(body, false)
}

// Emit the `??` DEFAULT `d` for a REF-valued map slot (`cmSlot >= 0`) onto `body`, in the
// value's own rep (scalar / union box / struct-list / list-wrapper / struct / nullable
// niche). Factored out of `emitMapGetOr` so the value-null coalesce can emit it exactly
// once whether the read missed the key OR read a stored null.
function emitMapValDefault(
  body: u8[],
  mslot: i32,
  scalarVK: VKind | null,
  defIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if scalarVK != null {
    return emitScalarValue(body, defIx, fnIx, scalarVK, ec)
  } else if mslot >= 0 && mvValKind[mslot] == MVK_UNION {
    // A UNION-valued map's default is coerced into the shared box, like a stored value — a
    // concrete VARIANT default boxes (`emitUnionBoxArg`), as in a call arg / return.
    return emitUnionBoxArg(
      body,
      mvValName[mslot],
      mvValTyIxAt(mslot),
      defIx,
      fnIx,
      ec,
    )
  }
  emitExprExpect(body, defIx, fnIx, expCtxHere(ec))
}

// True when a `??` DEFAULT is itself nullable — a bare `null` literal or a nullable-typed
// expression. `m[k] ?? null` (over a nullable-value map) stays `V | null`, so the ref recover
// must be skipped; a non-null default makes the whole `??` non-null.
function defExprNullable(ix: i32) {
  const u = nodeAt(unwrapParen(ix))
  if u is NullLit { return true }
  nodeTyIsNullable(ix)
}

// Lower a map get `m[k]` with a default (`m[k] ?? d`) onto `body`: probe, then if the
// key is found push `vals[entry-1]`, else push the default `d`. The self-host checker always
// reads a map through `?? -1`, so this is the primary get. `rk` is the `??`'s own atom kind
// (-1 none): a scalar value it is wider than is read and widened to it (D10091).
function emitMapGetOr(
  body: u8[],
  recvIx: i32,
  keyIx: i32,
  defIx: i32,
  fnIx: i32,
  rk: i32,
  ec: ExpCtx,
) {
  if emitMapPrep(body, recvIx, keyIx, fnIx, ec) < 0 { return -1 }
  const wvk = mapRecvScalarKindInst(recvIx, fnIx)
  if wvk >= 0 && coalWidens(wvk, rk) && !defExprNullable(defIx) {
    pushMapScr(body, 5)          // entry
    fbIf(valBlockTypeOfKind(rk)) // if (entry != 0 → found), the result's blocktype
    pushMapScalarHit(body)
    if coalWidenUnboxed(wvk, rk) < 0 { return -1 }
    fbElse()
    if emitExprAsKind(body, defIx, rk, fnIx, ec) < 0 { return -1 }
    fbEnd()
    return 0
  }
  if cmSlot >= 0 {
    // Ref values route through the slot's nullable valStash local rather than a
    // value-typed `if` (needs no interned blocktype): the hit arm sets it from the
    // `(ref null)` slot read, the miss arm from the default, and `ref.as_non_null`
    // recovers non-null — sound because a live entry's val slot is never null.
    const mslot = cmSlot
    // A boxed value-union map value that includes null (`{[string]: i32 | null}`,
    // `{[string]: A | B | null}`) stores null as a null-tagged box; `??` coalesces on
    // that tag and peels the value non-null, the value-union sibling of the ref-niche
    // `ref.is_null` path below. A null-free union value has no tag and takes the plain path.
    if mvValKind[mslot] == MVK_UNION {
      if mvValUnionHasNull(mslot) {
        return emitMapGetOrUnionBox(body, mslot, defIx, fnIx, rk, ec)
      }
    }
    // A SCALAR-valued map (f64/i64) stores the value directly; its default is emitted in
    // the value's rep and it needs no `ref.as_non_null`. A ref value (string/struct) does.
    const scalarVK = mvScalarValKind(mslot)
    if scalarVK != null && defExprNullable(defIx) {
      const sbk = mapRecvScalarBoxKindIn(recvIx, fnIx)
      if sbk >= 0 && (vbHeapIdxOfKind(sbk) >= 0 || nodeTyIsMap(recvIx)) {
        return emitMapGetOrScalarBox(body, sbk, defIx, fnIx, ec)
      }
    }
    // A nullable-value ref niche (value reps as `(ref null <elem>)`) stores null
    // directly in its vals slot: a missing key and a stored null both read as null, and
    // `??` coalesces on that read being null — so read the raw nullable value first and
    // let one `ref.is_null` supply the default for both.
    const nullableRef = scalarVK == null && mvSlotNullable(mslot)
    const stashL = fnMvValStashLocal(mslot)
    pushMapScr(body, 5)          // entry
    fbIf(64)                     // if (entry != 0 → found), void
    pushMapVals(body)
    fbStructGet(cmValsWrap(), 0) // vals backing
    pushMapScr(body, 5)          // entry
    fbI32Const(1)
    fbI32Bin(107)                // i32.sub (entry - 1)
    fbArrayGet(cmValsBack())     // scalar (f64/i64) / (ref null <elem>) slot read
    fbLocalSet(stashL)
    fbElse()                     // else — a MISS
    if nullableRef {
      // A miss IS the read's null; the `ref.is_null` coalesce below supplies the default.
      fbRefNull(mvValElemHeapOf(mslot))
      fbLocalSet(stashL)
    } else {
      if emitMapValDefault(body, mslot, scalarVK, defIx, fnIx, ec) < 0 {
        return -1
      }
      cmSlot = mslot
      fbLocalSet(stashL)
    }
    fbEnd() // end (if)
    if nullableRef {
      // Coalesce on the read value being null — a missing key or a stored null both take `d`.
      fbLocalGet(stashL)
      fbRefIsNull()
      fbIf(64)
      if emitMapValDefault(body, mslot, scalarVK, defIx, fnIx, ec) < 0 {
        return -1
      }
      cmSlot = mslot
      fbLocalSet(stashL)
      fbEnd()
    }
    fbLocalGet(stashL)
    // A scalar f64/i64 result needs no null-recovery; a ref value does (`??` is non-null).
    // For a nullable niche the coalesce already replaced every null with `d`, so recover to
    // non-null EXCEPT when the default itself is nullable (`m[k] ?? null` stays `S | null`).
    if scalarVK == null {
      if !defExprNullable(defIx) { fbRefAsNonNull() }
    }
    return 0
  }
  // A nullable-atom value map (`{[string]: K | null}` / `{[string]: boolean | null}`)
  // stores null as an i32 sentinel in the mono vals slot (`-1` litunion atom, `2`
  // boolean): a missing key and the stored sentinel both read as null, and `??`
  // coalesces on that — read the raw i32 and default when it equals the sentinel.
  let nulSentinel = 0
  let hasSentinel = false
  const orMt = mapRecvTyIn(recvIx, fnIx)
  if mapTyValIsNulLitUnion(orMt) {
    nulSentinel = 0 - 1
    hasSentinel = true
  } else if mapTyValIsNulBool(orMt) || mapTyValIsNullUnit(orMt) {
    nulSentinel = 2
    hasSentinel = true
  }
  if !hasSentinel {
    if defExprNullable(defIx) {
      // A hole's read whose pin no node registered a value box for keeps the unboxed lowering.
      const mbk = mapRecvScalarBoxKindIn(recvIx, fnIx)
      if mbk >= 0 && (vbHeapIdxOfKind(mbk) >= 0 || nodeTyIsMap(recvIx)) {
        return emitMapGetOrScalarBox(body, mbk, defIx, fnIx, ec)
      }
    }
    // if entry != 0 { vals.backing[entry-1] } else { d }  — a value-typed if yielding i32.
    pushMapScr(body, 5)      // entry
    fbIf(127)                // if (entry != 0 → found; a nonzero condition is true), 0x7f i32 blocktype
    pushMapVals(body)
    fbStructGet(lTypeIdx, 0) // struct.get (vals backing), field 0: backing
    pushMapScr(body, 5)      // entry
    fbI32Const(1)
    fbI32Bin(107)            // 0x6b i32.sub  (entry - 1)
    fbArrayGet(aTypeIdx)     // array.get
    fbElse()                 // else
    if emitMonoMapDefault(body, recvIx, defIx, fnIx, ec) < 0 { return -1 }
    fbEnd()                  // end (if)
    return 0
  }
  // raw = (entry != 0) ? backing[entry-1] : sentinel  — a miss reads as null.
  pushMapScr(body, 5)     // entry
  fbIf(127)               // if (entry != 0 → found), i32 blocktype
  pushMapVals(body)
  fbStructGet(lTypeIdx, 0)
  pushMapScr(body, 5)
  fbI32Const(1)
  fbI32Bin(107)
  fbArrayGet(aTypeIdx)
  fbElse()
  fbI32Const(nulSentinel) // miss = null sentinel
  fbEnd()
  // Coalesce: raw == sentinel ? d : raw. Slot +8 (probe hash cursor) is dead after the probe.
  setMapScr(body, 8)
  pushMapScr(body, 8)
  fbI32Const(nulSentinel)
  fbI32Bin(70) // 0x46 i32.eq → raw == sentinel (null, missing OR stored)
  fbIf(127)
  if emitMonoMapDefault(body, recvIx, defIx, fnIx, ec) < 0 { return -1 }
  fbElse()
  pushMapScr(body, 8)
  fbEnd()
  0
}

// Lower `m[k] ?? d` over a boxed value-union map value that includes null: read the box
// (miss → the null-tagged box), then coalesce on its null tag — `scalar | null` peels to the
// raw scalar, widened to `rk` (the `??`'s atom kind, -1 none) when that is wider, and a
// multi-member `… | null` peels to the non-null union box.
function emitMapGetOrUnionBox(
  body: u8[],
  mslot: i32,
  defIx: i32,
  fnIx: i32,
  rk: i32,
  ec: ExpCtx,
) {
  const uvn = mvValName[mslot]
  // The map value union's members come from the recorded member columns; an
  // un-interned value spelling re-splits (the ladder fall-through). One resolution
  // of the member set feeds both this walk and the residual-kind code below, so the
  // two do not each re-derive it and risk disagreeing.
  const uvsid = msSetOfNameTy(uvn, mvValTyIxAt(mslot))
  const atoms: string[] = []
  if !msMemberAtomsOfSet(uvsid, atoms) { unionSetAtomsOf(uvn, atoms) }
  const stashL = fnMvValStashLocal(mslot)
  // raw box: hit → stored (ref null $uBox); miss → the null-tagged box.
  pushMapScr(body, 5)          // entry
  fbIf(64)                     // if (entry != 0 → found), void
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 0) // vals backing
  pushMapScr(body, 5)
  fbI32Const(1)
  fbI32Bin(107)                // i32.sub (entry - 1)
  fbArrayGet(cmValsBack())     // the stored (ref null $uBox) slot read
  fbLocalSet(stashL)
  fbElse()                     // miss = the read's null (a null-tagged box)
  fbI32Rel(RS_TAG, nullBoxTag())
  fbRefNullNone()
  fbStructNew(uBoxIdx)
  fbLocalSet(stashL)
  fbEnd()
  // A `scalar | null` value (exactly one non-null scalar member) peels to the RAW scalar — take
  // the default on the null tag, else unbox the scalar payload. A nullable default keeps the
  // result `scalar | null`, the box itself, so it takes the multi-member arm below (D2253).
  if atoms.length == 2 && !defExprNullable(defIx) {
    // `ak` is the residual member's banked ABI code; when unresolved (-2) it re-parses
    // the rendered atom instead. That fallback is unreached on the corpus and fuzz
    // corpora (`docs/internals/destringify-types-program.md` P-RCH/P-SITE) because an
    // alias-spelled nullable value union is rejected by the checker before emit.
    let ak = unionResidualSoloKindOfSet(uvsid)
    if ak == -2 {
      ak = valueAtomKind(removeAtomFromSet(uvn, "null", mvValTyIxAt(mslot)))
    }
    const vb = vbHeapIdxOfKind(ak)
    if vb < 0 {
      return emitFail("emitProgram: scalar|null map value has no value box")
    }
    let urk = ak
    if coalWidens(ak, rk) { urk = rk }
    fbLocalGet(stashL)
    fbStructGet(uBoxIdx, 0)       // field 0: tag
    fbI32Rel(RS_TAG, nullBoxTag())
    fbI32Bin(70)                  // 0x46 i32.eq → null?
    fbIf(valBlockTypeOfKind(urk)) // value-typed if in the result's rep
    if emitExprAsKind(body, defIx, urk, fnIx, ec) < 0 { return -1 }
    fbElse()
    fbLocalGet(stashL)
    fbStructGet(uBoxIdx, 1)       // field 1: value (anyref payload)
    fbRefCast(vb)
    fbStructGet(vb, 0)            // the scalar payload
    if coalWidenUnboxed(ak, urk) < 0 { return -1 }
    fbEnd()
    return 0
  }
  // A MULTI-member `… | null` value peels to the NON-null union box: on the null tag, box the
  // default like a stored value (`emitUnionBoxArg`); else keep the stored box. `ref.as_non_null`
  // recovers the non-null box the checker's non-null union result promises.
  fbLocalGet(stashL)
  fbStructGet(uBoxIdx, 0) // field 0: tag
  fbI32Rel(RS_TAG, nullBoxTag())
  fbI32Bin(70)            // 0x46 i32.eq → null?
  fbIf(64)
  if emitUnionBoxArg(body, uvn, mvValTyIxAt(mslot), defIx, fnIx, ec) < 0 {
    return -1
  }
  fbLocalSet(stashL)
  fbEnd()
  fbLocalGet(stashL)
  fbRefAsNonNull()
  0
}

// Emit the `??` DEFAULT for a MONO-atom-valued map (`cmSlot < 0`) onto `body`: an i32 atom id
// for a litunion value (a MEMBER literal under `ec.litUnion`, or an atom-typed expr; a bare
// `null` → the `-1` sentinel), else the value's own rep (boolean / i32). A non-member / general
// string is the wrong rep for the fused i32 result — fail loudly.
function emitMonoMapDefault(
  body: u8[],
  recvIx: i32,
  defIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const mdMt = mapRecvTyIn(recvIx, fnIx)
  const atomTexts = mapTyValLitUnionTexts(mdMt)
  let atomDef = false
  let nulAtomDef = false
  if atomTexts.length > 0 {
    const du = nodeAt(unwrapParen(defIx))
    if du is StrLit {
      if litLexIsMember(du.strText, atomTexts) { atomDef = true }
    } else if du is NullLit {
      // A NULLABLE-atom value (`{[string]: K | null}`) admits a bare `null` default — lowered as
      // the `-1` niche sentinel (the `??` result stays `K | null`).
      if mapTyValIsNulLitUnion(mdMt) {
        atomDef = true
        nulAtomDef = true
      }
    } else if exprIsLitAtom(defIx, fnIx) {
      atomDef = true
    }
    if !atomDef && !coalMapReadForeignDefault(recvIx, defIx, fnIx) {
      return emitFail(
        "emitProgram: `??` over an atom-valued map needs a member-literal (or atom) default",
      )
    }
  }
  if nulAtomDef {
    fbI32Const(0 - 1)
    return 0
  }
  if atomDef { expCtxSwapLitUnion(1, ec) }
  const dfr = emitExpr(body, defIx, fnIx, ec)
  if atomDef { expCtxSwapLitUnion(0, ec) }
  if dfr < 0 { return -1 }
  0
}

// The narrowed-read tail of a bare map get `m[1]` whose index carries a live narrowing
// — the map twin of `emitIndex`'s ref-list rungs. Ref-recover runs first, since
// `emitMapGet` leaves a nullable element for every ref-valued map; a union value (kind
// 2) then unboxes to the tested atom, unless the narrow leaves two or more atoms.
function emitNarrowedMapReadTail(idxIx: i32, fnIx: i32) {
  const mrs = mapReadNarrowableSlot(idxIx, fnIx)
  if mrs < 0 { return 0 }
  const key = indexPathKeyOf(idxIx)
  const v = narrowVariantFor(key)
  if v == "" || v == "null" { return 0 }
  // A UNION value already left the NON-null box (`emitMapGetUnionBox` recovers it), so only
  // the unbox is owed; every other ref value is the raw `(ref null <elem>)` vals slot.
  if mvValKind[mrs] == MVK_UNION {
    const ak = mapReadNarrowedAtomKind(idxIx, fnIx)
    if ak >= 0 { return emitUnionUnboxTail(ak) }
    // The CONTAINER arms of the same narrowing (`if m[k] is {[string]: V}`, `… is K[]`),
    // which the atom question above answers -1 for. `mapReadNarrowedContainer` is the gate
    // rather than the unbox's own answer, so the classifiers that stop calling this read a
    // box and the lowering that opens it are deciding off one predicate (D1866).
    if mapReadNarrowedContainer(idxIx, fnIx) {
      const con = emitPlaceNarrowContainerUnbox(idxIx, fnIx)
      if con != 0 { return con - 1 }
    }
    return 0
  }
  fbRefAsNonNull() // 0xd4 (the `is` guard proved the key present)
  0
}

// Lower a bare map GET `m[k]` (no `??`) onto `body`: probe, return `vals[entry-1]` or
// `0` when absent. The checker never uses a bare map get (always `?? -1`); provided for
// completeness so `m[k]` in value position is total (0 default).
function emitMapGet(
  body: u8[],
  recvIx: i32,
  keyIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitMapPrep(body, recvIx, keyIx, fnIx, ec) < 0 { return -1 }
  emitMapGetTail(body, recvIx, fnIx)
}

// The value half of `emitMapGet`, after `emitMapPrep`: the stored value on a hit, the rep's
// empty value on a miss. Leaves the probe's `entry` scratch slot as the probe set it.
function emitMapGetTail(body: u8[], recvIx: i32, fnIx: i32) {
  if cmSlot >= 0 {
    // REF values: yield the NULLABLE element — the (ref null <elem>) vals slot on
    // a hit, `ref.null <elem>` on a miss — via the slot's valStash (same
    // blocktype-avoidance as `emitMapGetOr`). The `m[k]` type is `V | null`.
    const mslot = cmSlot
    pushMapScr(body, 5) // entry
    fbIf(64)            // if (entry != 0), void
    pushMapVals(body)
    fbStructGet(cmValsWrap(), 0)
    pushMapScr(body, 5) // entry
    fbI32Const(1)
    fbI32Bin(107)       // i32.sub (entry - 1)
    fbArrayGet(cmValsBack())
    fbLocalSet(fnMvValStashLocal(mslot))
    fbElse()            // else
    // A miss yields the rep's empty value: 0.0 for an f64 or f32 map, 0 for an i64 map,
    // else `ref.null` for a ref (string/struct) value.
    if mvValKind[mslot] == MVK_F64 { fbF64Const("0") }
    else if mvValKind[mslot] == MVK_I64 { fbI64Const(0, 0) }
    else if mvValKind[mslot] == MVK_F32 { fbF32Const("0") }
    else { fbRefNull(mvValElemHeapOf(mslot)) }
    fbLocalSet(fnMvValStashLocal(mslot))
    fbEnd() // end
    fbLocalGet(fnMvValStashLocal(mslot))
    return 0
  }
  pushMapScr(body, 5) // entry
  fbIf(127)           // if (entry != 0), i32 blocktype
  pushMapVals(body)
  fbStructGet(lTypeIdx, 0)
  pushMapScr(body, 5) // entry
  fbI32Const(1)
  fbI32Bin(107)       // i32.sub (entry - 1)
  fbArrayGet(aTypeIdx)
  fbElse()            // else — a miss reads as the rep's empty value. For a NICHE-BEARING
  // A niche-bearing value map (`K`/`K | null` atoms, `boolean`/`boolean | null`) reads
  // a miss as its sentinel (`-1` litunion, `2` boolean) at both the nullable and the
  // non-nullable spelling — yielding plain `0` there would collide with a real member
  // (atom id 0, or `false`) and make `m[missing] == <that value>` silently true.
  let gtMt = mapRecvTyIn(recvIx, fnIx)
  // A type parameter's value takes its sentinel from the instance's binding of it (D10360).
  if gtMt >= 0 && tyHasTyVar(gtMt) {
    const inst = nodeTyInOf(unwrapParen(recvIx), fnIx)
    if inst >= 0 && inst < T.tys.length && tyAt(inst) is TyMap { gtMt = inst }
  }
  if mapTyValIsNulLitUnion(gtMt) || mapTyValIsLitUnion(gtMt) {
    fbI32Const(0 - 1)
  } else if (
    mapTyValIsNulBool(gtMt)
    || mapTyValIsBool(gtMt)
    || mapTyValIsNullUnit(gtMt)
  ) {
    fbI32Const(2)
  } else {
    fbI32Const(0) // i32.const 0
  }
  fbEnd() // end
  0
}

// Lower a bare map GET `m[k]` of a union-valued map (mv kind 2) onto `body`: the hit arm
// loads the stored `(ref $uBoxIdx)` box, the miss arm synthesizes the null-tagged box
// (`nullBoxTag()`, matching `emitUnionCoerce`'s `NullLit` arm) and recovers it non-null.
// Exported for `emitStartFnCode`'s identical module-scope miss arm.
export function emitMapGetUnionBox(
  body: u8[],
  recvIx: i32,
  keyIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitMapPrep(body, recvIx, keyIx, fnIx, ec) < 0 { return -1 }
  if cmSlot < 0 {
    return emitFail(
      "emitProgram: union-valued map read but no mv slot resolved",
    )
  }
  const mslot = cmSlot
  pushMapScr(body, 5)          // entry
  fbIf(64)                     // if (entry != 0 → found), void
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 0) // vals backing
  pushMapScr(body, 5)          // entry
  fbI32Const(1)
  fbI32Bin(107)                // i32.sub (entry - 1)
  fbArrayGet(cmValsBack())     // the stored (ref null $uBoxIdx) slot read
  fbLocalSet(fnMvValStashLocal(mslot))
  fbElse()                     // else — a miss IS the read's `null`: the null-tagged box
  fbI32Rel(RS_TAG, nullBoxTag())
  fbRefNullNone()              // the payload slot is unread under the null tag
  fbStructNew(uBoxIdx)
  fbLocalSet(fnMvValStashLocal(mslot))
  fbEnd()                      // end (if)
  fbLocalGet(fnMvValStashLocal(mslot))
  fbRefAsNonNull()
  0
}

// The SPELLING of a scalar value-atom kind — the inverse of `valueAtomKind` over exactly
// the four widths `mapReadScalarBoxKind` can answer with. Only those four: this is a
// membership query against a union's rendered atoms, and every other code either has a
// niche of its own (so it never reaches here) or is not a scalar at all.
function scalarAtomNameOfKind(k: i32): string {
  if k == 0 { return "i32" }
  if k == 3 { return "i64" }
  if k == 4 { return "f64" }
  if k == 5 { return "f32" }
  ""
}

// Lower a bare scalar-valued map read `m[k]` directly into the union box: the tag and
// the payload are each chosen by their own conditional (two allocation sites, so
// Heap2Local scalarizes each — `opt-profile-design.md` §3 item 0), allocation-neutral on
// a hit and cheaper on a miss. No valStash local — the blocktype carries the value.
function emitMapGetScalarBox(
  body: u8[],
  recvIx: i32,
  keyIx: i32,
  atomKind: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitMapPrep(body, recvIx, keyIx, fnIx, ec) < 0 { return -1 }
  const vbIdx = vbHeapIdxOfKind(atomKind)
  if vbIdx < 0 {
    return emitFail("emitProgram: scalar map read has no value-box type")
  }
  // ── the TAG: the value's atom on a hit, `null`'s atom on a miss ──
  pushMapScr(body, 5) // entry
  fbIf(127)           // i32 blocktype
  fbI32Rel(RS_TAG, scalarTagOfKind(atomKind))
  fbElse()
  fbI32Rel(RS_TAG, nullBoxTag())
  fbEnd()
  // ── the PAYLOAD: the boxed value on a hit, a null ref on a miss ──
  pushMapScr(body, 5) // entry
  fbIf(110)           // 0x6e anyref blocktype
  pushMapScalarHit(body)
  fbStructNew(vbIdx)
  fbElse()
  fbRefNullNone()
  fbEnd()
  fbStructNew(uBoxIdx)
  0
}

// Push the raw scalar a probed scalar-valued map holds at its found entry — the hit arm of
// every scalar read. Valid only under an `entry != 0` test, after `emitMapPrep`.
function pushMapScalarHit(body: u8[]) {
  if cmSlot >= 0 {
    pushMapVals(body)
    fbStructGet(cmValsWrap(), 0)
    pushMapScr(body, 5)
    fbI32Const(1)
    fbI32Bin(107) // i32.sub (entry - 1)
    fbArrayGet(cmValsBack())
  } else {
    // The mono i32 map: the vals array is the shared `aTypeIdx` backing.
    pushMapVals(body)
    fbStructGet(lTypeIdx, 0)
    pushMapScr(body, 5)
    fbI32Const(1)
    fbI32Bin(107)
    fbArrayGet(aTypeIdx)
  }
}

// `m[k] ?? d` over a null-free scalar-valued map with a NULLABLE default: the result is still
// `S | null`, whose rep is the box, so a hit boxes the stored scalar and a miss delivers `d`
// as the box. After `emitMapPrep`; `ak` is the value's atom kind (D2254).
function emitMapGetOrScalarBox(
  body: u8[],
  ak: i32,
  defIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const vb = vbHeapIdxOfKind(ak)
  if vb < 0 {
    return emitFail("emitProgram: scalar map read has no value-box type")
  }
  pushMapScr(body, 5)    // entry
  fbOpenIf()             // 0x04 if
  fbValtype("union", -1) // result blocktype: the union box `(ref $uBox)`
  fbI32Rel(RS_TAG, scalarTagOfKind(ak))
  pushMapScalarHit(body)
  fbStructNew(vb)
  fbStructNew(uBoxIdx)
  fbElse()
  if (
    emitUnionCoerce(
      body,
      scalarAtomNameOfKind(ak) + " | null",
      -1,
      defIx,
      fnIx,
      ec,
    )
    < 0
  ) {
    return -1
  }
  fbEnd()
  0
}

// `m[k] ?? d` over a scalar-valued map where `d` is another arm of the result's union: a hit
// boxes the stored scalar under its own arm's tag, a miss boxes `d`. 1 handled, 0 when the
// value is not a boxed scalar (a ref value is the generic nullable operand), -1 (D4643).
function emitMapGetOrScalarJoin(
  body: u8[],
  e: BinExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  const r = nodeAt(unwrapParen(e.binLeft))
  let recvIx = -1
  let keyIx = -1
  if r is Index {
    recvIx = r.idxArr
    keyIx = r.idxIndex
  } else if r is Call {
    if r.callFn < 0 { return -1 }
    const callee = nodeAt(r.callFn)
    if callee is Member {
      if r.callArgs.length == 1 {
        recvIx = callee.memObj
        keyIx = r.callArgs[0]
      }
    }
  }
  if recvIx < 0 { return 0 }
  const ak = mapRecvScalarBoxKindIn(recvIx, fnIx)
  if ak < 0 { return 0 }
  const joinN = coalesceResultUnionName(exprIx)
  let joinSet = unionMemberSetOf(joinN)
  if joinSet == "" { joinSet = joinN }
  const vb = vbHeapIdxOfKind(ak)
  if vb < 0 || !unionHasAtomTy(joinSet, scalarAtomNameOfKind(ak), false) {
    return emitFailAt(
      "emitProgram: `??` joins a nullable value into a union with no arm for the value's own type",
      exprIx,
    )
  }
  if emitMapPrep(body, recvIx, keyIx, fnIx, ec) < 0 { return -1 }
  pushMapScr(body, 5) // entry
  fbIfRef(uBoxIdx)    // 0x04 if, (ref $uBox) blocktype — the result's rep
  fbI32Rel(RS_TAG, scalarTagOfKind(ak))
  pushMapScalarHit(body)
  fbStructNew(vb)
  fbStructNew(uBoxIdx)
  fbElse()            // 0x05 else — a miss → the default, boxed
  if (
    emitUnionBoxArg(body, joinN, nodeTyPinIxOf(exprIx), e.binRight, fnIx, ec)
    < 0
  ) {
    return -1
  }
  fbEnd()
  1
}

// Lower a map HAS `m.has(k)` / `k in m` onto `body`: probe, push 1 if found else 0.
function emitMapHas(
  body: u8[],
  recvIx: i32,
  keyIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitMapPrep(body, recvIx, keyIx, fnIx, ec) < 0 { return -1 }
  pushMapScr(body, 5) // entry
  fbI32Const(0)
  fbI32Bin(71)        // 0x47 i32.ne (entry != 0 → 1, else 0)
  0
}

// Push the current probe's hit flag, `entry != 0`. Valid after `emitMapPrep`.
function pushMapHitFlag(body: u8[]) {
  pushMapScr(body, 5) // entry
  fbI32Const(0)
  fbI32Bin(71)        // 0x47 i32.ne
  0
}

// `print(m[k])` over a bare scalar-valued map read (D2466): the stored value through its own
// sink on a hit, the word `null` on a miss. The probe's hit flag is the read's null, so no box
// is built. `k` is `mapReadScalarBoxKind`'s atom kind.
function emitPrintScalarMapRead(
  body: u8[],
  argIx: i32,
  k: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const e = nodeAt(unwrapParen(argIx))
  if e is Index {
    if emitMapPrep(body, e.idxArr, e.idxIndex, fnIx, ec) < 0 { return -1 }
    pushMapScr(body, 5) // entry
    fbIf(64)            // void
    pushMapScalarHit(body)
    if emitPrintScalarSink(k) < 0 { return -1 }
    fbElse()
    emitPrintNullWord()
    fbEnd()
    return 0
  }
  emitFail(
    "emitProgram: scalar map-read print over an operand that is not an index read",
  )
}

// `==` / `!=` with a bare scalar-valued map read on either side (D2466). A miss is `null`, so
// it equals only a `null`: the payload compare is `and`ed with the probe's hit flag, and both
// operands evaluate once, left to right. 1 when lowered, 0 to decline to the caller's ladder
// (null literals, a kind mismatch, a union operand that cannot be re-read), -1 on failure.
function emitScalarMapReadEq(
  body: u8[],
  e: BinExpr,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  const kl = mapReadScalarBoxKind(e.binLeft, fnIx)
  const kr = mapReadScalarBoxKind(e.binRight, fnIx)
  if kl < 0 && kr < 0 { return 0 }
  const ln = nodeAt(unwrapParen(e.binLeft))
  const rn = nodeAt(unwrapParen(e.binRight))
  if ln is NullLit { return 0 }
  if rn is NullLit { return 0 }
  let rc = 0
  if kl >= 0 && kr >= 0 {
    if kl != kr { return 0 }
    rc = emitScalarMapReadPairEq(body, e.binLeft, e.binRight, kl, fnIx, ec)
  } else if kl >= 0 {
    rc = emitScalarMapReadOtherEq(
      body,
      e.binLeft,
      e.binRight,
      kl,
      true,
      fnIx,
      ec,
    )
  } else {
    rc = emitScalarMapReadOtherEq(
      body,
      e.binRight,
      e.binLeft,
      kr,
      false,
      fnIx,
      ec,
    )
  }
  if rc <= 0 { return rc }
  if e.binOp == "!=" { fbI32Eqz() }
  1
}

// Both operands are scalar map reads of kind `k`: equal when both miss, or both hit with equal
// values. The right read's probe is emitted once per arm of the left's hit test.
function emitScalarMapReadPairEq(
  body: u8[],
  lIx: i32,
  rIx: i32,
  k: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  const l = nodeAt(unwrapParen(lIx))
  const r = nodeAt(unwrapParen(rIx))
  if l is Index {
    if r is Index {
      if emitMapPrep(body, l.idxArr, l.idxIndex, fnIx, ec) < 0 { return -1 }
      pushMapScr(body, 5) // left entry
      fbIf(127)           // i32 result
      pushMapScalarHit(body)
      if emitMapPrep(body, r.idxArr, r.idxIndex, fnIx, ec) < 0 { return -1 }
      if emitMapGetTail(body, r.idxArr, fnIx) < 0 { return -1 }
      fbI32Bin(atomEqOpcodeOfKind(k))
      pushMapHitFlag(body)
      fbI32Bin(113)       // 0x71 i32.and
      fbElse()
      if emitMapPrep(body, r.idxArr, r.idxIndex, fnIx, ec) < 0 { return -1 }
      pushMapHitFlag(body)
      fbI32Eqz()
      fbEnd()
      return 1
    }
  }
  0
}

// One operand is a scalar map read of kind `k` (`readLeft` says which side), the other is not.
// A plain scalar compares against the hit value; a value-union box compares by tag, its `null`
// arm matching a miss.
function emitScalarMapReadOtherEq(
  body: u8[],
  readIx: i32,
  otherIx: i32,
  k: i32,
  readLeft: boolean,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  const rd = nodeAt(unwrapParen(readIx))
  if rd is Index {
    if exprUnion(otherIx, fnIx) && !eqAtomOperandOk(otherIx, fnIx) {
      return emitScalarMapReadBoxEq(
        body,
        rd.idxArr,
        rd.idxIndex,
        otherIx,
        k,
        fnIx,
        ec,
      )
    }
    const atom = scalarAtomNameOfKind(k)
    // A numeric literal widens to a wide read's own width (`emitUnionEqOther`); any other
    // operand must already have the read's atom kind.
    const olit = nodeAt(unwrapParen(otherIx))
    let oOk = unionEqAtomKindOf(otherIx, atom + " | null", -1, fnIx) == k
    if olit is NumLit {
      if k >= 3 { oOk = true }
    }
    if !oOk { return 0 }
    if readLeft {
      if emitMapPrep(body, rd.idxArr, rd.idxIndex, fnIx, ec) < 0 { return -1 }
      pushMapHitFlag(body)
      if emitMapGetTail(body, rd.idxArr, fnIx) < 0 { return -1 }
      if emitUnionEqOther(body, otherIx, k, fnIx, ec) < 0 { return -1 }
      fbI32Bin(atomEqOpcodeOfKind(k))
      fbI32Bin(113) // 0x71 i32.and
      return 1
    }
    if emitUnionEqOther(body, otherIx, k, fnIx, ec) < 0 { return -1 }
    if emitMapPrep(body, rd.idxArr, rd.idxIndex, fnIx, ec) < 0 { return -1 }
    if emitMapGetTail(body, rd.idxArr, fnIx) < 0 { return -1 }
    fbI32Bin(atomEqOpcodeOfKind(k))
    pushMapHitFlag(body)
    fbI32Bin(113) // 0x71 i32.and
    return 1
  }
  0
}

// The read against a value-union box `u`: a hit equals `u` holding the same scalar, a miss
// equals `u` holding `null`. `u` is re-read per arm, so it must be re-readable and must not be
// a map read of its own (its probe would overwrite this one's entry).
function emitScalarMapReadBoxEq(
  body: u8[],
  recvIx: i32,
  keyIx: i32,
  boxIx: i32,
  k: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if !unionEqOperandOk(boxIx) { return 0 }
  const bn = nodeAt(unwrapParen(boxIx))
  if bn is Index { return 0 }
  const un = unionNameOfExpr(boxIx, fnIx)
  if un == "" || !unionSetHasNull(un) { return 0 }
  if !unionHasAtom(un, scalarAtomNameOfKind(k)) { return 0 }
  if emitMapPrep(body, recvIx, keyIx, fnIx, ec) < 0 { return -1 }
  pushMapScr(body, 5)     // entry
  fbIf(127)               // i32 result
  if emitExpr(body, boxIx, fnIx, ec) < 0 { return -1 }
  fbStructGet(uBoxIdx, 0) // tag
  fbI32Rel(RS_TAG, scalarTagOfKind(k))
  fbI32Bin(70)            // 0x46 i32.eq
  fbIf(127)
  pushMapScalarHit(body)
  if emitExpr(body, boxIx, fnIx, ec) < 0 { return -1 }
  fbStructGet(uBoxIdx, 1) // payload
  if emitUnionPayloadUnbox(body, k) < 0 { return -1 }
  fbI32Bin(atomEqOpcodeOfKind(k))
  fbElse()
  fbI32Const(0)
  fbEnd()
  fbElse()
  if emitExpr(body, boxIx, fnIx, ec) < 0 { return -1 }
  fbStructGet(uBoxIdx, 0) // tag
  fbI32Rel(RS_TAG, nullBoxTag())
  fbI32Bin(70)            // 0x46 i32.eq
  fbEnd()
  1
}

// `m[k] is T` over a bare scalar-valued map read (D2466): `is null` is a miss and `is` the
// value's own scalar is a hit. 1 when lowered, 0 to decline (any other tested type).
function emitScalarMapReadIs(
  body: u8[],
  isIx: i32,
  readIx: i32,
  k: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  const rd = nodeAt(unwrapParen(readIx))
  if rd is Index {
    const tn = tyPrimNameOf(isVarTyIxOf(isIx))
    if tn == null { return 0 }
    if tn == "null" {
      if emitMapHas(body, rd.idxArr, rd.idxIndex, fnIx, ec) < 0 { return -1 }
      fbI32Eqz()
      return 1
    }
    if tn == scalarAtomNameOfKind(k) {
      if emitMapHas(body, rd.idxArr, rd.idxIndex, fnIx, ec) < 0 { return -1 }
      return 1
    }
  }
  0
}

// Push whether entry `iL` of the `live` array in `liveL` is live: `live[i] != 0` in a module
// that deletes, else the constant 1 — nothing else writes `live`, so it stays empty there.
function pushMapEntryLive(liveL: i32, iL: i32) {
  if !gMapDeletes {
    fbI32Const(1)
    return 0
  }
  fbLocalGet(liveL)
  fbLocalGet(iL)
  fbArrayGet(aTypeIdx)
  fbI32Const(0)
  fbI32Bin(71) // 0x47 i32.ne
  0
}

// Lower `m.keys()` onto `body`, leaving a fresh string list (`$mkListIdx`) of the map's
// live keys in insertion order — the ordered keys/live arrays carry tombstoned entries
// after a delete, so only `live[i] != 0` keys are copied. Uses the 6-slot `mapKeysBase`
// frame; the receiver, a simple binding, is re-emitted per field rather than cached.
function emitMapKeys(body: u8[], recvIx: i32, fnIx: i32, ec: ExpCtx) {
  if !exprMap(recvIx, fnIx) {
    return emitFail("emitProgram: .keys() receiver is not a map")
  }
  if !fnUsesMapKeys {
    return emitFail("emitProgram: .keys() scratch frame not reserved")
  }
  const shape0 = mapShapeOfExpr(recvIx, fnIx)
  if shape0 == -3 { return failMapValueType() }
  // A Set's keys() runs on the mono machinery of its own KEY rep.
  const shape = mapShapeFoldSet(shape0)
  // The KEY rep, from the mono sentinel OR the mv slot's own column — the same question
  // `cmKeyKind` asks. A `{[i32]: string}`'s `.keys()` is an `i32[]` even though its shape
  // is an mv slot, so this cannot key off the sentinel alone.
  const keyK = mapShapeKeyKind(shape)
  if keyK == MAP_KEY_STR && !slUsed {
    return emitFail("emitProgram: .keys() but string list type not collected")
  }
  const mapTy = mapTypeIdxOf(shape)
  // The KEY rep's list wrapper / backing, and — since the builder's frame slots are
  // typed per rep — an integer frame's own out/src slots for an integer-keyed map.
  let keysWrap = mkListIdx
  let keysBack = mkArrIdx
  let outBackL = mapKeysBase + 0
  let keysBackL = mapKeysBase + 1
  if keyK == MAP_KEY_I32 {
    keysWrap = lTypeIdx
    keysBack = aTypeIdx
    outBackL = mapI32KeyLocal(2)
    keysBackL = mapI32KeyLocal(3)
  } else if keyK == MAP_KEY_I64 {
    keysWrap = il64TypeIdx
    keysBack = ia64TypeIdx
    outBackL = mapI64KeyLocal(2)
    keysBackL = mapI64KeyLocal(3)
  }
  const liveL = mapKeysBase + 2
  const iL = mapKeysBase + 3
  const jL = mapKeysBase + 4
  const countL = mapKeysBase + 5
  // keysBack = recv.keys.backing  (field 0 = keys wrapper, its field 0 = backing)
  if emitExpr(body, recvIx, fnIx, ec) < 0 { return -1 }
  fbStructGet(mapTy, 0)
  fbStructGet(keysWrap, 0)
  fbLocalSet(keysBackL)
  // live = recv.live  (field 2)
  if emitExpr(body, recvIx, fnIx, ec) < 0 { return -1 }
  fbStructGet(mapTy, 2)
  fbLocalSet(liveL)
  // count = recv.count  (field 4 — entries INCLUDING tombstones)
  if emitExpr(body, recvIx, fnIx, ec) < 0 { return -1 }
  fbStructGet(mapTy, 4)
  fbLocalSet(countL)
  // out = array.new_default <keysBacking> count (sized at count; `len` set to live j)
  fbLocalGet(countL)
  fbArrayNewDefault(keysBack)
  fbLocalSet(outBackL)
  // j = 0 ; i = 0
  fbI32Const(0)
  fbLocalSet(jL)
  fbI32Const(0)
  fbLocalSet(iL)
  // loop { if i >= count {} else { if live[i] != 0 { out[j]=keys[i]; j++ } ; i++ ; br } }
  fbLoop(64)
  fbLocalGet(iL)
  fbLocalGet(countL)
  fbI32Bin(78) // 0x4e i32.ge_s (i >= count → done)
  fbIf(64)
  // then: done (empty)
  fbElse()
  // if live[i] != 0  (constant true in a module that never deletes, whose `live` stays empty)
  pushMapEntryLive(liveL, iL)
  fbIf(64)
  // out[j] = keys[i]
  fbLocalGet(outBackL)
  fbLocalGet(jL)
  fbLocalGet(keysBackL)
  fbLocalGet(iL)
  fbArrayGet(keysBack)
  fbArraySet(keysBack)
  // j = j + 1
  fbLocalGet(jL)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  fbLocalSet(jL)
  fbEnd() // end (live if)
  // i = i + 1
  fbLocalGet(iL)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  fbLocalSet(iL)
  fbBr(1) // → loop header (else=0, loop=1)
  fbEnd() // end (ge_s if/else)
  fbEnd() // end (loop)
  // wrapper = struct.new <keysWrapper> (out, len=j, cap=count)
  fbLocalGet(outBackL)
  fbLocalGet(jL)
  fbLocalGet(countL)
  fbStructNew(keysWrap)
  0
}

// Lower `m.values()` over a mono i32 map onto `body`, leaving a fresh i32 list
// (`$lTypeIdx`) of the map's live values in insertion order — the value analogue of
// `emitMapKeys`, reading the vals list instead of keys and skipping tombstoned entries.
// Other value types iterate via `for v in m.values()`; the bound-list form is i32-only.
function emitMapValues(body: u8[], recvIx: i32, fnIx: i32, ec: ExpCtx) {
  if !exprMap(recvIx, fnIx) {
    return emitFail("emitProgram: .values() receiver is not a map")
  }
  const shape = mapShapeOfExpr(recvIx, fnIx)
  // A SET's `.values()` yields its ELEMENTS (its keys), built by `emitMapKeys` — for
  // both key reps, which is why the Set sentinel is a PAIR.
  if shape == -2 || shape == -5 || shape == -7 {
    return emitMapKeys(body, recvIx, fnIx, ec)
  }
  if shape == -3 { return failMapValueType() }
  if !fnUsesMapVals {
    return emitFail("emitProgram: .values() scratch frame not reserved")
  }
  const mapTy = mapTypeIdxOf(shape)
  const valsWrap = mvValsWrapOf(shape)
  const valsBack = mvValsBackOf(shape)
  // Frame: a MONO map's self-contained `mapValsBase` (all i32-backed), an mv map's per-slot
  // output backing + the mv frame's `valsBk` source + the key-list frame's live/i/j/count.
  let outBackL = mapValsBase + 0
  let valsBackL = mapValsBase + 1
  let liveL = mapValsBase + 2
  let iL = mapValsBase + 3
  let jL = mapValsBase + 4
  let countL = mapValsBase + 5
  if shape >= 0 {
    outBackL = fnMvValsOutLocal(shape)
    valsBackL = fnMvValsBkLocal(shape)
    liveL = mapKeysBase + 2
    iL = mapKeysBase + 3
    jL = mapKeysBase + 4
    countL = mapKeysBase + 5
  }
  // valsBack = recv.vals.backing  (field 1 = vals wrapper, its field 0 = backing)
  if emitExpr(body, recvIx, fnIx, ec) < 0 { return -1 }
  fbStructGet(mapTy, 1)
  fbStructGet(valsWrap, 0)
  fbLocalSet(valsBackL)
  // live = recv.live  (field 2)
  if emitExpr(body, recvIx, fnIx, ec) < 0 { return -1 }
  fbStructGet(mapTy, 2)
  fbLocalSet(liveL)
  // count = recv.count  (field 4 — entries INCLUDING tombstones)
  if emitExpr(body, recvIx, fnIx, ec) < 0 { return -1 }
  fbStructGet(mapTy, 4)
  fbLocalSet(countL)
  // out = array.new_default <valsBack> count
  fbLocalGet(countL)
  fbArrayNewDefault(valsBack)
  fbLocalSet(outBackL)
  fbI32Const(0)
  fbLocalSet(jL)
  fbI32Const(0)
  fbLocalSet(iL)
  // loop { if i >= count {} else { if live[i] != 0 { out[j]=vals[i]; j++ } ; i++ ; br } }
  fbLoop(64)
  fbLocalGet(iL)
  fbLocalGet(countL)
  fbI32Bin(78) // i32.ge_s
  fbIf(64)
  fbElse()
  pushMapEntryLive(liveL, iL)
  fbIf(64)
  // out[j] = vals[i]
  fbLocalGet(outBackL)
  fbLocalGet(jL)
  fbLocalGet(valsBackL)
  fbLocalGet(iL)
  fbArrayGet(valsBack)
  fbArraySet(valsBack)
  fbLocalGet(jL)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(jL)
  fbEnd() // end (live if)
  fbLocalGet(iL)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(iL)
  fbBr(1)
  fbEnd() // end (ge_s if/else)
  fbEnd() // end (loop)
  // wrapper = struct.new <valsWrap> (out, len=j, cap=count)
  fbLocalGet(outBackL)
  fbLocalGet(jL)
  fbLocalGet(countL)
  fbStructNew(valsWrap)
  0
}

// Resize the `index` when its occupancy (count / cap) crosses 1/2: a `call` into the
// shared `__map_resize__` helper returns the doubled+rehashed backing (or the old one
// when the load factor is fine), stored back unconditionally — only the receiver
// `struct.get`s and the final `struct.set` are shape-typed; the entry lists are untouched.
function emitMapResize(body: u8[]) {
  pushMapRef(body) // the struct.set receiver
  pushMapIndex(body)
  if cmKeyInt() {
    pushMapCount(body)
    fbCall(gHelpMapResizeI32)
  } else {
    pushMapHashes(body)
    pushMapLive(body)
    pushMapCount(body)
    pushMapSize(body)
    fbCall(gHelpMapResize)
  }
  fbStructSet(cmMapTy(), 3) // struct.set field 3: index
  0
}

// Lower `m.clear()` onto `body`: the map keeps its index, backings and capacity, so a refill
// up to the old size allocates nothing. The index is zeroed, the key and value refs dropped so
// they can be collected, and the entry counts reset. A never-written map's backings are the
// shared empty ones; every fill over them has length 0, so none is written.
function emitMapClear(body: u8[], recvIx: i32, fnIx: i32, ec: ExpCtx) {
  if !mUsed {
    return emitFail("emitProgram: map op but map type not collected")
  }
  const mshape0 = mapShapeOfExpr(recvIx, fnIx)
  if mshape0 == -3 { return failMapValueType() }
  if pushMapRecvRef(body, recvIx, fnIx, ec) < 0 { return -1 }
  cmSlot = mapShapeFoldSet(mshape0)
  const mslot = cmSlot
  setMapRef(body)
  pushMapIndex(body)
  fbI32Const(0)
  fbI32Const(0)
  pushMapIndex(body)
  fbArrayLen()
  fbArrayFill(aTypeIdx) // index[0 .. len) = 0, every slot free
  if !cmKeyInt() {
    pushMapKeysBacking(body)
    fbI32Const(0)
    fbRefNull(sTypeIdx)
    pushMapKeysLen(body)
    fbArrayFill(cmKeysBack())
  }
  if mslot >= 0 && mvScalarValKind(mslot) == null {
    pushMapValsBacking(body)
    fbI32Const(0)
    fbRefNull(mvValElemHeapOf(mslot))
    pushMapValsLen(body)
    fbArrayFill(cmValsBack())
  }
  pushMapKeys(body)
  fbI32Const(0)
  fbStructSet(cmKeysWrap(), 1) // keys.len = 0
  pushMapVals(body)
  fbI32Const(0)
  fbStructSet(cmValsWrap(), 1) // vals.len = 0
  pushMapRef(body)
  fbI32Const(0)
  fbStructSet(cmMapTy(), 4) // count = 0
  pushMapRef(body)
  fbI32Const(0)
  fbStructSet(cmMapTy(), 5) // size = 0
  0
}

// Lower a map delete `m.delete(k): boolean` onto `body`: probe to the entry; a miss pushes 0, a
// hit tombstones it (`live[entry-1] = 0`, its slot and sequence kept), drops its key and value
// refs so the payload can be collected, decrements `size`, and pushes 1. A delete never moves an
// entry, so a walk over the same map stays in step; storage is reclaimed on insert (D2315).
function emitMapDelete(
  body: u8[],
  recvIx: i32,
  keyIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitMapPrep(body, recvIx, keyIx, fnIx, ec) < 0 { return -1 }
  const mslot = cmSlot
  // if entry == 0 { 0 } else { tombstone ; drop refs ; size-- ; 1 }
  pushMapScr(body, 5) // entry
  fbIf(127)           // if (entry != 0), 0x7f i32 blocktype
  // an integer key's pair: entry = -1, a probe marker never hit again (a string key's slot keeps
  // its entry, whose `live` below is what the probe tests)
  if cmKeyInt() {
    pushMapIndex(body)
    pushMapSlotPos(body, 1)
    fbI32Const(0 - 1)
    fbArraySet(aTypeIdx)
  }
  // live[entry-1] = 0  (tombstone; keeps the entry's insertion-order position)
  pushMapLive(body)
  pushMapScr(body, 5)  // entry
  fbI32Const(1)
  fbI32Bin(107)        // i32.sub (entry - 1)
  fbI32Const(0)
  fbArraySet(aTypeIdx) // array.set live[entry-1] = 0
  // keys.backing[entry-1] = null  (a string key; an integer key holds no payload)
  if !cmKeyInt() {
    pushMapKeysBacking(body)
    pushMapScr(body, 5)
    fbI32Const(1)
    fbI32Bin(107)
    fbRefNull(sTypeIdx)
    fbArraySet(cmKeysBack())
  }
  // vals.backing[entry-1] = null  (a ref value; a scalar value holds no payload)
  if mslot >= 0 && mvScalarValKind(mslot) == null {
    pushMapValsBacking(body)
    pushMapScr(body, 5)
    fbI32Const(1)
    fbI32Bin(107)
    fbRefNull(mvValElemHeapOf(mslot))
    fbArraySet(cmValsBack())
  }
  // size = size - 1
  pushMapRef(body)          // mapRef
  pushMapSize(body)
  fbI32Const(1)
  fbI32Bin(107)             // i32.sub
  fbStructSet(cmMapTy(), 5) // struct.set field 5: size
  // result = 1: a key is removed.
  fbI32Const(1)
  fbElse() // else
  // result = 0 (absent)
  fbI32Const(0)
  fbEnd() // end (entry if)
  0
}

// Emit a map set's value expr in the map's value rep — scalar coercion, union boxing,
// list-kind / ref-list-slot / struct-index hints, and the atom-id context an overwrite
// or append needs. One evaluation, shared by both arms of `emitMapSetV`. Leaves the
// value on the stack; `cmSlot` may be clobbered by inner map ops, so callers re-pin.
function emitMapSetValExpr(
  body: u8[],
  valIx: i32,
  fnIx: i32,
  mslot: i32,
  atomVal: boolean,
  nulBoolVal: boolean,
  ec: ExpCtx,
) {
  const svk = mvScalarValKind(mslot)
  if svk != null {
    // A SCALAR-valued map (f64/i64): emit the value coerced to the element rep.
    return emitScalarValue(body, valIx, fnIx, svk, ec)
  }
  if mslot >= 0 && mvValKind[mslot] == MVK_UNION {
    // A UNION-valued map: box the stored value into the shared union box (a concrete
    // VARIANT value boxes via `emitUnionBoxArg`, like a call arg / return).
    return emitUnionBoxArg(
      body,
      mvValName[mslot],
      mvValTyIxAt(mslot),
      valIx,
      fnIx,
      ec,
    )
  }
  // A non-null ARM-valued map takes every value through `emitVariantCoerce`, a join included,
  // as an arm-typed local does; the coerce owns the narrowed unbox (D4639).
  if mslot >= 0 && mvValKind[mslot] == MVK_STRUCT && !mvSlotNullable(mslot) {
    const svArmVi = mvValVariantOf(mslot)
    if svArmVi >= 0 { return emitVariantCoerce(body, svArmVi, valIx, fnIx, ec) }
  }
  const svCtx = expCtxHere(ec)
  // An atom-valued mono map's member-literal value lowers as its interned atom id; a
  // NULLABLE-atom value (`{[string]: K | null}`) stores a bare `null` as the `-1` sentinel.
  if atomVal {
    const vnul = nodeAt(unwrapParen(valIx))
    if vnul is NullLit {
      fbI32Const(0 - 1)
      return 0
    }
    svCtx.litUnion = 1
    // A nullable value can only reach the nullable-atom map, whose null is the `-1` (D5330).
    if nodeTyIsNulLitUnion(valIx) || nodeTyIsNulString(valIx) {
      svCtx.nulLitUnion = true
    }
  }
  // A `boolean | null`-valued MONO map (i32 niche) stores a bare `null` as the `2` sentinel —
  // the store-side dual of the read's `mapTyValIsNulBool` coalesce (sentinel 2). A non-null
  // boolean value (true/false) falls through and emits as a plain i32.
  if nulBoolVal {
    const vnb = nodeAt(unwrapParen(valIx))
    if vnb is NullLit {
      fbI32Const(2)
      return 0
    }
    // A `null`-typed value is that `null` too, its effects run first.
    if exprIsNulNone(valIx, fnIx) {
      if emitNulNoneForEffect(body, valIx, fnIx, ec) < 0 { return -1 }
      fbI32Const(2)
      return 0
    }
  }
  // A NULLABLE-value slot (`{[string]: S | null}` / `{[string]: map | null}`) stores a bare
  // `null` as `ref.null <elem>` — the vals element carries it directly and the fused read
  // preserves it. A non-null value ignores the seed. A `string | null` value read stays the
  // raw nullable ref the element holds rather than recovering non-null, which traps (D2596).
  if mvSlotNullable(mslot) {
    if mvValKind[mslot] == MVK_STR { svCtx.nulString = true }
  }
  // A literal-union atom stored into a string-valued map widens to its member string: the
  // vals element is `(ref null $aTypeIdx)` while the atom's rep is an i32 id, so without
  // this the store is a type mismatch — invalid wasm. Gated on `!atomVal`, since an
  // atom-valued map wants the raw id instead (`svCtx.litUnion`, set above).
  if !atomVal {
    if exprIsLitAtom(valIx, fnIx) { return emitStrValue(body, valIx, fnIx, ec) }
  }
  const mvArmOwed = narrowedArmNeedsUnbox(valIx, fnIx)
  if emitExprExpect(body, valIx, fnIx, svCtx) < 0 { return -1 }
  // The narrowed-arm unbox at the map-value boundary (D1031) — `m[k] = s` under `if s is
  // Circle` over a `{[string]: Circle}` — targets the vals element's own heap, the same
  // one `mvSlotNullable`'s `ref.null` seed above reads.
  if mvArmOwed && mslot >= 0 {
    emitNarrowedArmUnboxTo(mvValElemHeapOf(mslot), valIx, fnIx)
  }
  // Read-only covariance at the map-value boundary (D791) — `mU["k"] = lv1` over a
  // `{[string]: Shape[]}` — targets the same `mvValInnerRlSlotAt` row the build seed above
  // reads; it declines for every non-ref-list value type without parsing.
  if mslot >= 0 {
    const mvWiden = mvValInnerRlSlotAt(mslot)
    const mvSrc = exprEmittedRefListSlot(valIx, fnIx)
    if mvWiden >= 0 {
      emitRefListWidenSite(body, valIx, mvSrc, mvWiden)
    } else {
      // A list of union boxes has no row of its own here; its copy keeps the source's type.
      emitRefListWidenSite(body, valIx, mvSrc, mvSrc)
    }
    // the scalar copy at the same boundary (D965, D2163) — `m["k"] = ints` over a
    // `{[string]: readonly f64[]}`, keyed by the value list's own element kind.
    const mvLK = mvListValKind(mslot)
    if mvLK != null {
      const mvSE = scalarListElemOfListKind(mvLK)
      if mvSE != null { emitScalarListWidenSiteElem(body, valIx, fnIx, mvSE) }
    }
  }
  0
}

// `local.set` / `local.get` of the set-value stash: the mv slot's typed valStash, or the
// mono frame's dedicated slot 14. Slot 14 is reserved — no probe / push / grow / resize
// machinery touches it, so the value survives from its write through the overwrite or
// append store; slot 3 (the pushVal stash) is also the probe slot and cannot hold one.
function setMapSetValStash(body: u8[], mslot: i32) {
  if msHelp {
    fbLocalSet(2)
    return 0
  }
  if mslot >= 0 {
    fbLocalSet(fnMvValStashLocal(mslot))
    return 0
  }
  setMapScr(body, 14)
  0
}
function pushMapSetValStash(body: u8[], mslot: i32) {
  if msHelp {
    fbLocalGet(2)
    return 0
  }
  if mslot >= 0 {
    fbLocalGet(fnMvValStashLocal(mslot))
    return 0
  }
  pushMapScr(body, 14)
  0
}

// Lower a map set `m[k] = v` (also `m.set(k, v)`, and `s.add(k)` via `valConst1 = true`):
// probe; a hit overwrites, a miss appends and maybe resizes. Receiver, key and value are
// all evaluated before the probe and before landing in scratch locals, so `m[k] = (m[k]
// ?? 0) + 1` probes the untouched map and a nested map op cannot clobber the shared frame.
function emitMapSetV(
  body: u8[],
  recvIx: i32,
  keyIx: i32,
  valIx: i32,
  fnIx: i32,
  valConst1: boolean,
  ec: ExpCtx,
) {
  // An ATOM-valued map (`{[string]: K}`, `K` a literal union) rides the MONO map: each
  // value is the interned atom id (a plain i32). Its member-literal value is a StrLit
  // syntactically — it must BYPASS the mono string guard below and emit in atom context
  // (`ec.litUnion`), so resolve the receiver's value type up front.
  const svMt = mapRecvTyIn(recvIx, fnIx)
  let atomVal = mapTyValIsLitUnion(svMt)
  if mapTyValIsNulLitUnion(svMt) { atomVal = true }
  // A `boolean | null`-valued map is the MONO i32 niche too — a bare `null` store lowers as the
  // `2` sentinel (the store-side dual of the read's `mapTyValIsNulBool` coalesce).
  // A `null`-valued map stores the same sentinel, the only value it holds (D4671).
  const nulBoolVal = mapTyValIsNulBool(svMt) || mapTyValIsNullUnit(svMt)
  // A mono (i32/boolean-valued) map cannot store a ref value — a string / struct / list
  // ref into an i32 array is invalid wasm — so fail loudly; an mv-slot map stores such
  // values through its own typed vals list, and a constant-true Set value is always a
  // valid i32 boolean. Resolved here only for the gate; `emitMapRecvKey` re-resolves it.
  if valConst1 == false && !atomVal {
    if mapShapeOfExpr(recvIx, fnIx) < 0 {
      if (
        exprString(valIx, fnIx)
        || exprStruct(valIx, fnIx)
        || exprArray(valIx, fnIx)
        || exprRefArray(valIx, fnIx)
        || exprStringArray(valIx, fnIx)
      ) {
        return emitFail("emitProgram: map values must be i32 / boolean")
      }
    }
  }
  // Receiver + key onto the operand stack; `cmSlot` pinned to the shape.
  if emitMapRecvKey(body, recvIx, keyIx, fnIx, ec) < 0 { return -1 }
  const mslot = cmSlot
  // VALUE next — evaluated ONCE, while the map is still untouched and recv/key are
  // still stack-parked — then stashed. Only probe/store machinery runs after this.
  if valConst1 {
    fbI32Const(1) // Set value: constant boolean true
  } else {
    if (
      emitMapSetValExpr(body, valIx, fnIx, mslot, atomVal, nulBoolVal, ec)
      < 0
    ) {
      return -1
    }
  }
  cmSlot = mslot // re-pin: inner map ops in the value expr clobber it
  // [mapRef, key, value] are the shape's store helper's params, in order.
  const setFn = mapSetFnOf(mslot)
  if setFn >= 0 {
    fbCall(setFn)
    return 0
  }
  if setMapSetValStash(body, mslot) < 0 { return -1 }
  fbLocalSet(cmKeyLocal()) // the target key (popped off the stack)
  setMapRef(body)          // mapRef
  emitMapSetStore(body, mslot)
}

// The function a set over map shape `sh` calls: its row's store helper, given the next index
// after the helpers already called the first time a site asks; -1 when the row has no functype.
function mapSetFnOf(sh: i32) {
  const row = mapShapeRow(sh)
  if row < 0 || row >= gMapSetTy.length || gMapSetTy[row] < 0 { return -1 }
  if gMapSetFn[row] < 0 {
    gMapSetFn[row] = gMapSetFnBase + gTailFnRows.length
    gTailFnRows.push(row)
  }
  gMapSetFn[row]
}

// The row of map shape `sh` in the per-shape helper tables: 0 the string-keyed mono map, 1 the
// i32-keyed one, `2 + s` mv slot `s`, the last the i64-keyed one; a Set rows as its key's map.
function mapShapeRow(sh: i32) {
  if sh == -1 || sh == -2 { return 0 }
  if sh == -4 || sh == -5 { return 1 }
  if sh == -6 || sh == -7 { return mvMapTypeIdx.length + 2 }
  if sh < 0 { return -1 }
  sh + 2
}

// `__map_set_<row>__(m, k, v)`'s functype for map shape `sh`: the map, its key rep and the value
// in the type a set site's value expression leaves.
export function mapSetFuncType(sh: i32) {
  const saved = cmSlot
  cmSlot = sh
  fbFuncTypeHead(3)
  fbRefValtype(cmMapTy())
  const k = cmKeyKind()
  if k == MAP_KEY_I32 { fbValtype("i32", -1) }
  else if k == MAP_KEY_I64 { fbValtype("i64", -1) }
  else { fbRefValtype(sTypeIdx) }
  if sh < 0 {
    fbValtype("i32", -1) // the mono map's value
  } else if mvValKind[sh] == MVK_F64 {
    fbValtype("f64", -1)
  } else if mvValKind[sh] == MVK_I64 {
    fbValtype("i64", -1)
  } else if mvValKind[sh] == MVK_F32 {
    fbValtype("f32", -1)
  } else {
    fbRefNullValtype(mvValElemHeapOf(sh)) // the vals element
  }
  wULEB(0)
  cmSlot = saved
  0
}

// The body of `__map_set_<row>__` for map shape `sh`: the store a set site would otherwise
// inline, over the params, with the string frame's slots 3 to 13 as its locals.
export function mapSetFnBody(sh: i32): u8[] {
  const body: u8[] = []
  const prev = wTarget(body)
  const savedSlot = cmSlot
  const savedBase = mapScratchBase
  cmSlot = sh
  wULEB(6)
  wULEB(3)
  fbValtype("i32", -1) // 3 slot, 4 cap, 5 entry
  wULEB(1)
  fbRefValtype(cmKeysBack()) // 6 keysBk
  wULEB(1)
  fbRefValtype(cmValsBack()) // 7 valsBk
  wULEB(1)
  if gMapDeletes {
    fbRefNullValtype(ia64TypeIdx) // 8 the grown seqs
  } else {
    fbValtype("i32", -1) // 8 unused without deletes
  }
  wULEB(3)
  fbValtype("i32", -1) // 9 hcur, 10 and 11 unused
  wULEB(2)
  fbRefValtype(aTypeIdx) // 12 liveBk, 13 hashBk
  mapScratchBase = 0
  msHelp = true
  emitMapSetStore(body, sh)
  msHelp = false
  mapScratchBase = savedBase
  cmSlot = savedSlot
  fbEnd()
  wTarget(prev)
  body
}

// A set's store, with the map, key and value in their locals: probe; a hit overwrites, a miss
// appends, compacting first when the dead entries call for it, and maybe resizes.
function emitMapSetStore(body: u8[], mslot: i32) {
  emitMapProbe(body, true)
  pushMapScr(body, 5) // entry
  fbIf(64)            // if (entry != 0 → overwrite), void
  // OVERWRITE: vals.backing[entry-1] = stash
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 0) // struct.get (vals backing), field 0: backing
  pushMapScr(body, 5)          // entry
  fbI32Const(1)
  fbI32Bin(107)                // i32.sub (entry - 1)
  pushMapSetValStash(body, mslot)
  fbArraySet(cmValsBack())     // array.set
  fbElse()                     // else
  // APPEND. Reclaim the dead entries first once they outnumber the live ones by
  // `INITIAL_CAP`: compaction rebuilds the index, so the free slot is probed again (D2315).
  const cmpFn = mapCompactFnOf(mslot)
  if cmpFn >= 0 {
    pushMapCount(body)
    pushMapSize(body)
    fbI32Bin(107) // i32.sub (count - size)
    pushMapSize(body)
    fbI32Const(8) // INITIAL_CAP
    fbI32Bin(106) // i32.add (size + INITIAL_CAP)
    fbI32Bin(75)  // 0x4b i32.gt_u ((count-size) > (size+INITIAL_CAP))
    fbIf(64)      // if, void
    pushMapRef(body)
    fbCall(cmpFn)
    emitMapProbe(body, true)
    fbEnd()       // end (compact if)
  }
  // the slot's entry = count + 1 (the new entry's position + 1), beside an integer key's tag in
  // its pair: an i32 key is its own tag, an i64 key's is its hash.
  if cmKeyInt() {
    pushMapIndex(body)
    pushMapSlotPos(body, 0)
    if cmKeyKind() == MAP_KEY_I64 {
      fbMapTagOfI64(cmKeyLocal())
    } else {
      fbLocalGet(cmKeyLocal())
    }
    fbArraySet(aTypeIdx) // array.set
  }
  pushMapIndex(body)
  pushMapSlotPos(body, 1)
  pushMapCount(body)
  fbI32Const(1)
  fbI32Bin(106)        // i32.add (count + 1)
  fbArraySet(aTypeIdx) // array.set
  // keys.push(keyRef) ; vals.push(stash)  (clobbers slots 3/4 — already linked above).
  if emitMapPushKey(body) < 0 { return -1 }
  if emitMapPushVal(body) < 0 { return -1 }
  // count = count + 1
  pushMapRef(body)          // mapRef (struct.set receiver)
  pushMapCount(body)
  fbI32Const(1)
  fbI32Bin(106)             // i32.add
  fbStructSet(cmMapTy(), 4) // struct.set field 4: count
  // size = size + 1
  pushMapRef(body)          // mapRef
  pushMapSize(body)
  fbI32Const(1)
  fbI32Bin(106)             // i32.add
  fbStructSet(cmMapTy(), 5) // struct.set field 5: size
  if emitMapResize(body) < 0 { return -1 }
  fbEnd()                   // end (if)
  0
}

// Thin wrapper preserving the original arity: the non-constant-value map set. The
// `s.add(k)` Set form calls `emitMapSetV` with `valConst1 = true`.
function emitMapSet(
  body: u8[],
  recvIx: i32,
  keyIx: i32,
  valIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  emitMapSetV(body, recvIx, keyIx, valIx, fnIx, false, ec)
}

// Inline list-grow append of the scratch `keyRef` (slot 1) onto `M.keys`. The keys
// backing is `(array (mut (ref null $sTypeIdx)))`, so grow uses `array.new_default` /
// `array.copy` over `$mkArrIdx`, reusing the map scratch frame's spare i32 slots (4
// newCap, 3 free here) rather than a dedicated frame — the grow path mirrors `emitPush`.
function emitMapPushKey(body: u8[]) {
  // if keys.len == keys.cap { grow }
  pushMapKeysLen(body)
  pushMapKeysCap(body)
  fbI32Bin(70) // i32.eq
  fbIf(64)     // if, void
  // newCap = cap == 0 ? 4 : cap*2   (slot 4)
  pushMapKeysCap(body)
  fbI32Eqz()         // i32.eqz
  fbIf(127)          // if, i32 blocktype
  fbI32Const(4)
  fbElse()           // else
  pushMapKeysCap(body)
  fbI32Const(2)
  fbI32Bin(108)      // i32.mul
  fbEnd()            // end
  setMapScr(body, 4) // newCap
  // keys.backing = copy of old into a fresh array.new_default(newCap), keys.cap=newCap
  // newBacking on stack: array.new_default <keysBacking> newCap
  pushMapScr(body, 4) // newCap
  fbArrayNewDefault(cmKeysBack())
  // newBacking needs a TYPED ref local (slot 6, `newKeysBacking`): the copy must run
  // BEFORE the swap (swapping first loses the old elements), and `array.copy` CONSUMES
  // its dest operand, so the stack alone cannot supply it twice. `curRef` cannot hold it
  // either — that slot is a `(ref $sTypeIdx)` string ref, the wrong type.
  setMapScrKB(body) // newKeysBacking (slot 6)
  // array.copy newBacking 0 oldBacking 0 len
  pushMapScrKB(body)                      // dest
  fbI32Const(0)
  pushMapKeysBacking(body)                // src (old)
  fbI32Const(0)
  pushMapKeysLen(body)                    // count
  fbArrayCopy(cmKeysBack(), cmKeysBack()) // array.copy (dest type, src type)
  // keys.backing = newBacking
  pushMapKeys(body)
  pushMapScrKB(body)
  fbStructSet(cmKeysWrap(), 0) // struct.set field 0: backing
  // keys.cap = newCap
  pushMapKeys(body)
  pushMapScr(body, 4)
  fbStructSet(cmKeysWrap(), 2) // struct.set field 2: cap
  // In a module that deletes, live grows in LOCKSTEP with the keys backing (entry-parallel):
  // allocate a fresh `(ref $aTypeIdx)` of newCap (slot 12), copy the live region
  // `[0, keys.len)` over, and store it back into M.live (field 2). `keys.len` is still the
  // pre-append count here. A module that never deletes has no dead entry to mark.
  if gMapDeletes {
    pushMapScr(body, 4)             // newCap
    fbArrayNewDefault(aTypeIdx)
    setMapScrLB(body)               // newLiveBacking (slot 12)
    pushMapScrLB(body)              // dest
    fbI32Const(0)
    pushMapLive(body)               // src (old live)
    fbI32Const(0)
    pushMapKeysLen(body)            // count (entries copied)
    fbArrayCopy(aTypeIdx, aTypeIdx) // array.copy (dest type, src type)
    pushMapRef(body)                // mapRef
    pushMapScrLB(body)
    fbStructSet(cmMapTy(), 2)       // struct.set field 2: live
  }
  // a string-keyed map's hashes grow in LOCKSTEP too: fresh `(ref $aTypeIdx)` of newCap
  // (slot 13), copy `[0, keys.len)` over, store back into M.hashes (field 6).
  if !cmKeyInt() {
    pushMapScr(body, 4)             // newCap
    fbArrayNewDefault(aTypeIdx)
    setMapScrHB(body)               // newHashBacking (slot 13)
    pushMapScrHB(body)              // dest
    fbI32Const(0)
    pushMapHashes(body)             // src (old hashes)
    fbI32Const(0)
    pushMapKeysLen(body)            // count (entries copied)
    fbArrayCopy(aTypeIdx, aTypeIdx) // array.copy (dest type, src type)
    pushMapRef(body)                // mapRef
    pushMapScrHB(body)
    fbStructSet(cmMapTy(), 6)       // struct.set field 6: hashes
  }
  // seqs (an i64 array) grows in lockstep too, in a module that deletes (D2315).
  if gMapDeletes {
    const nsL = mapSeqsBackSlot()
    pushMapScr(body, 4)       // newCap
    fbArrayNewDefault(ia64TypeIdx)
    fbLocalSet(nsL)
    fbLocalGet(nsL)           // dest
    fbI32Const(0)
    pushMapSeqs(body)         // src (old seqs)
    fbI32Const(0)
    pushMapKeysLen(body)      // count (entries copied)
    fbArrayCopy(ia64TypeIdx, ia64TypeIdx)
    pushMapRef(body)
    fbLocalGet(nsL)
    fbRefAsNonNull()
    fbStructSet(cmMapTy(), 7) // struct.set field 7: seqs
  }
  fbEnd() // end (grow if)
  // live[keys.len] = 1  (the new entry is live), in a module that can kill one.
  if gMapDeletes {
    pushMapLive(body)
    pushMapKeysLen(body) // entry index (== count, pre-append)
    fbI32Const(1)
    fbArraySet(aTypeIdx) // array.set
  }
  // seqs[keys.len] = next ; next = next + 1 — the entry's insertion sequence, an i64 that no
  // program lives long enough to wrap, which a walk resyncs by after a compaction (D2315).
  if gMapDeletes {
    pushMapSeqs(body)
    pushMapKeysLen(body)
    pushMapRef(body)
    fbStructGet(cmMapTy(), 8)
    fbArraySet(ia64TypeIdx)
    pushMapRef(body)
    pushMapRef(body)
    fbStructGet(cmMapTy(), 8)
    fbI64Const(0, 1)
    fbI32Bin(124) // 0x7c i64.add
    fbStructSet(cmMapTy(), 8)
  }
  // hashes[keys.len] = hash(keyRef) for a string key — cached parallel to the entry, it gates
  // the probe's key compare and re-places the entry on resize; the probe's own, in slot +9.
  if !cmKeyInt() {
    pushMapHashes(body)
    pushMapKeysLen(body) // entry index (== count, pre-append)
    pushMapScr(body, 9)
    fbArraySet(aTypeIdx) // array.set
  }
  // keys.backing[keys.len] = key
  pushMapKeysBacking(body)
  pushMapKeysLen(body)
  fbLocalGet(cmKeyLocal())
  fbArraySet(cmKeysBack()) // array.set
  // keys.len = keys.len + 1
  pushMapKeys(body)
  pushMapKeysLen(body)
  fbI32Const(1)
  fbI32Bin(106)                // i32.add
  fbStructSet(cmKeysWrap(), 1) // struct.set field 1: len
  0
}

// Append the stashed set value onto `M.vals` (inline list-grow push). `emitMapSetV`
// evaluates and stashes the value before the probe, so this only grows the vals list
// and stores the stash — no user code runs inside the append.
function emitMapPushVal(body: u8[]) {
  const mslot = cmSlot
  // if vals.len == vals.cap { grow }
  pushMapValsLen(body)
  pushMapValsCap(body)
  fbI32Bin(70) // i32.eq
  fbIf(64)     // if, void
  // newCap (slot 4)
  pushMapValsCap(body)
  fbI32Eqz()    // i32.eqz
  fbIf(127)     // if, i32 blocktype
  fbI32Const(4)
  fbElse()      // else
  pushMapValsCap(body)
  fbI32Const(2)
  fbI32Bin(108) // i32.mul
  fbEnd()       // end
  setMapScr(body, 4)
  // newBacking = array.new_default <valsBack> newCap → the valsBk scratch
  pushMapScr(body, 4)
  fbArrayNewDefault(cmValsBack())
  setMapScrVB(body) // newValsBacking
  // array.copy newBacking 0 oldBacking 0 len
  pushMapScrVB(body)
  fbI32Const(0)
  pushMapValsBacking(body)
  fbI32Const(0)
  pushMapValsLen(body)
  fbArrayCopy(cmValsBack(), cmValsBack()) // array.copy (dest type, src type)
  // vals.backing = newBacking
  pushMapVals(body)
  pushMapScrVB(body)
  fbStructSet(cmValsWrap(), 0) // struct.set field 0: backing
  // vals.cap = newCap
  pushMapVals(body)
  pushMapScr(body, 4)
  fbStructSet(cmValsWrap(), 2) // struct.set field 2: cap
  fbEnd()                      // end (grow if)
  // vals.backing[vals.len] = the stashed value
  pushMapValsBacking(body)
  pushMapValsLen(body)
  pushMapSetValStash(body, mslot)
  fbArraySet(cmValsBack()) // array.set
  // vals.len = vals.len + 1
  pushMapVals(body)
  pushMapValsLen(body)
  fbI32Const(1)
  fbI32Bin(106)                // i32.add
  fbStructSet(cmValsWrap(), 1) // struct.set field 1: len
  0
}

// `M.keys.len` / `.cap` / `.backing` field reads (struct.get $mkListIdx 1/2/0).
function pushMapKeysLen(body: u8[]) {
  pushMapKeys(body)
  fbStructGet(cmKeysWrap(), 1)
  0
}
function pushMapKeysCap(body: u8[]) {
  pushMapKeys(body)
  fbStructGet(cmKeysWrap(), 2)
  0
}
function pushMapKeysBacking(body: u8[]) {
  pushMapKeys(body)
  fbStructGet(cmKeysWrap(), 0)
  0
}
// `M.vals.len` / `.cap` / `.backing` field reads (struct.get <valsWrap> 1/2/0 —
// the i32 list wrapper for the mono map, this mv slot's ref-list wrapper else).
function pushMapValsLen(body: u8[]) {
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 1)
  0
}
function pushMapValsCap(body: u8[]) {
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 2)
  0
}
function pushMapValsBacking(body: u8[]) {
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 0)
  0
}

// The two ref scratch locals beyond the 6-slot core frame: a non-null keys backing
// ref (slot 6) and a non-null vals backing ref (slot 7), used by the two grows.
function setMapScrKB(_body: u8[]) {
  fbLocalSet(cmKeysBkLocal())
  0
}
function pushMapScrKB(_body: u8[]) {
  fbLocalGet(cmKeysBkLocal())
  0
}
function setMapScrVB(_body: u8[]) {
  fbLocalSet(cmValsBkLocal())
  0
}
function pushMapScrVB(_body: u8[]) {
  fbLocalGet(cmValsBkLocal())
  0
}
// The grown `live` backing ref (slot 12, a non-null `(ref $aTypeIdx)` i32 array),
// used by the keys grow to reallocate `live` in lockstep with the keys backing.
function setMapScrLB(_body: u8[]) {
  fbLocalSet(mapScratchBase + 12)
  0
}
function pushMapScrLB(_body: u8[]) {
  fbLocalGet(mapScratchBase + 12)
  0
}
// The grown `hashes` backing ref (slot 13, a non-null `(ref $aTypeIdx)` i32 array),
// used by the keys grow to reallocate `hashes` in lockstep with the keys backing, and
// by `compact` as the rebuilt hashes backing.
function setMapScrHB(_body: u8[]) {
  fbLocalSet(mapScratchBase + 13)
  0
}
function pushMapScrHB(_body: u8[]) {
  fbLocalGet(mapScratchBase + 13)
  0
}

// The chunk length of a string or ref literal here: a constant initializer has no locals to
// chunk through, and `isConstInit` admits one only within the operand cap.
function allocLitChunk(): i32 {
  if gConstExprEmit { return NEW_FIXED_MAX }
  ALLOC_LIT_CHUNK
}

// Begin a chunked long-literal build: allocate the full `n`-element backing into a fresh
// backing-typed slot of the lazy list frame (so a nested chunked literal cannot clobber
// this one), then open the first chunk and return the destination slot. `strBack` (not
// `kind`, which is "i32" for both) distinguishes a string destination from a list one.
function arrLitChunkStart(
  kind: MfKind,
  rslot: i32,
  backTy: i32,
  n: i32,
  strBack: boolean,
) {
  liKinds.push(kind)
  liSlots.push(rslot)
  if strBack { liBack.push(5) } else { liBack.push(1) }
  const dst = listIdxScratchBase + liKinds.length
  fbI32Const(n)
  fbArrayNewDefault(backTy) // 0xfb 0x07 <typeidx>
  fbLocalSet(dst)
  fbLocalGet(dst)           // the open chunk's copy destination …
  fbI32Const(0)             // … and destination offset
  dst
}

// Chunk boundary check after element `i` of `n` is pushed (`coff` marks the open
// chunk's first element). At `NEW_FIXED_MAX` elements or the literal's end, close
// the chunk — `array.new_fixed` the pushed elements, `array.copy` them into the
// destination — and open the next one when elements remain. Returns the new start.
function arrLitChunkFlush(dst: i32, backTy: i32, coff: i32, i: i32, n: i32) {
  arrLitChunkFlushAt(dst, backTy, coff, i, n, NEW_FIXED_MAX)
}

// `arrLitChunkFlush` closing a chunk at `max` elements rather than at the operand cap.
function arrLitChunkFlushAt(
  dst: i32,
  backTy: i32,
  coff: i32,
  i: i32,
  n: i32,
  max: i32,
) {
  if i - coff < max && i < n { return coff }
  fbArrayNewFixed(backTy, i - coff) // the chunk source array
  fbI32Const(0)                     // source offset
  fbI32Const(i - coff)              // element count
  fbArrayCopy(backTy, backTy)       // 0xfb 0x11 — consumes [dst, off, src, 0, k]
  if i < n {
    fbLocalGet(dst)
    fbI32Const(i)
  }
  i
}

// The element forms of `arrLitDataBuild`: which emitter lowers an element, and so which one
// constant instruction it must produce. `ALD_U8` is the i32 lowering stored one byte wide.
const ALD_I32 = 0
const ALD_I64 = 1
const ALD_F32 = 2
const ALD_F64 = 3
const ALD_U8 = 4

// Build the `backTy` backing of a literal past the `array.new_fixed` cap of number or boolean
// literals as one passive data segment read by `array.new_data`, so its code is a few bytes
// whatever its length (D3417). Returns 1 when the backing is on the stack, 0 when some element
// is not one constant instruction (nothing emitted), -1 when an element fails to lower.
function arrLitDataBuild(
  body: u8[],
  elems: i32[],
  fnIx: i32,
  form: i32,
  backTy: i32,
  ec: ExpCtx,
): i32 {
  let i = 0
  while i < elems.length {
    if !arrLitElemIsConst(elems[i]) { return 0 }
    i = i + 1
  }
  const parts: { b: u8[] }[] = [{ b: [] }]
  let n = 0
  i = 0
  while i < elems.length {
    const one: u8[] = []
    const prev = wTarget(one)
    const rc = arrLitDataElemEmit(body, elems[i], fnIx, form, ec)
    wTarget(prev)
    if rc < 0 { return -1 }
    if parts[parts.length - 1].b.length >= LIT_PART { parts.push({ b: [] }) }
    const w = arrLitDataPut(one, form, parts[parts.length - 1].b)
    if w < 0 { return 0 }
    n = n + w
    i = i + 1
  }
  const seg = gStrDataLen.length
  gStrDataStart.push(gStrDataParts.length)
  gStrDataLen.push(n)
  let k = 0
  while k < parts.length {
    gStrDataParts.push(parts[k])
    k = k + 1
  }
  fbI32Const(0)            // segment offset
  fbI32Const(elems.length) // element count
  fbArrayNewData(backTy, seg)
  1
}

// A fresh backing array of type `ty` from the `n` elements on the stack. An empty one reads the
// module's one zero-length array of that type instead: every list and map holding it has
// capacity 0, so its first store reallocates, and nothing compares backings by identity.
function fbBacking(ty: i32, n: i32) {
  if n == 0 {
    const g = synthGlobalIdx(SYNTH_EMPTY_BACKING, ty)
    if g >= 0 { return fbGlobalGet(g) }
  }
  fbArrayNewFixed(ty, n)
}

// The list literal a `for` is iterating, while its iterable is emitted, else -1. Nothing but
// the loop can reach that list, and the loop only reads it.
let gForIterLit = -1

// Lowers `for` iterable literal `arrIx` of constants as a read of one module constant list
// built by the same element lowering (`form`, an `ALD_*` or `ALD_STR`) into `backTy`/`wrapTy`.
// 1 when it did, 0 when the literal must build as usual (nothing emitted), -1 on failure.
function forLitHoist(
  arrIx: i32,
  elems: i32[],
  fnIx: i32,
  form: i32,
  backTy: i32,
  wrapTy: i32,
  ec: ExpCtx,
): i32 {
  if arrIx != gForIterLit || elems.length == 0 || elems.length > NEW_FIXED_MAX {
    return 0
  }
  let i = 0
  while i < elems.length {
    if !forLitElemIsConst(elems[i]) { return 0 }
    i = i + 1
  }
  const init: u8[] = []
  i = 0
  while i < elems.length {
    const one: u8[] = []
    const prev = wTarget(one)
    let rc = 0
    if form == ALD_STR {
      rc = emitStrValue(one, constStrInitOf(elems[i], fnIx), fnIx, ec)
    } else {
      rc = arrLitDataElemEmit(one, elems[i], fnIx, form, ec)
    }
    wTarget(prev)
    if rc < 0 { return -1 }
    if !isOneConstIns(one) { return 0 }
    relCopy(one, init, init.length)
    let k = 0
    while k < one.length {
      init.push(one[k])
      k = k + 1
    }
    i = i + 1
  }
  const prev = wTarget(init)
  fbArrayNewFixed(backTy, elems.length)
  arrLitWrap(elems.length, wrapTy)
  wTarget(prev)
  relHold(init)
  const g = synthConstListIdx(wrapTy, init)
  if g < 0 { return 0 }
  fbGlobalGet(g)
  1
}

// The element form `forLitHoist` lowers through `emitStrValue`.
const ALD_STR = 5

// Whether element `ix` may lower to one constant: a number or boolean literal, a string
// literal, or a name (whose lowering `isOneConstIns` then decides).
function forLitElemIsConst(ix: i32): boolean {
  if arrLitElemIsConst(ix) { return true }
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return false }
  const e = nodeAt(x)
  e is StrLit || e is Ident
}

// The string literal a module `const` named by `ix` is initialized with, else `ix` itself.
function constStrInitOf(ix: i32, fnIx: i32): i32 {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length || !(nodeAt(x) is Ident) { return ix }
  const li = globalLetOfSidIn(fnIx, sidOfNode(x), x)
  if li < 0 || li >= P.nodes.length { return ix }
  const d = nodeAt(li)
  if d is LetDecl {
    if d.letKw == "const" && d.letInit >= 0 {
      const ini = unwrapParen(d.letInit)
      if ini >= 0 && ini < P.nodes.length && nodeAt(ini) is StrLit {
        return ini
      }
    }
  }
  ix
}

// Whether `ins` is exactly one instruction valid in a constant initializer that trails every
// other global: a numeric constant, or a read of a pooled string literal.
function isOneConstIns(ins: u8[]): boolean {
  if ins.length < 2 { return false }
  const op = ins[0] as i32
  if op == 0x44 {
    return ins.length == 9 // f64.const
  }
  if op == 0x43 {
    return ins.length == 5 // f32.const
  }
  // i32.const, i64.const, global.get: one LEB immediate
  if op != 0x41 && op != 0x42 && op != 0x23 { return false }
  let v = 0
  let sh = 0
  let k = 1
  while k < ins.length - 1 {
    if ((ins[k] as i32) & 0x80) == 0 { return false }
    v = v | (((ins[k] as i32) & 0x7f) << sh)
    sh = sh + 7
    k = k + 1
  }
  if ((ins[k] as i32) & 0x80) != 0 { return false }
  if op != 0x23 { return true }
  v = v | (((ins[k] as i32) & 0x7f) << sh)
  v >= externGlobalCount() && v < externGlobalCount() + gStrPoolTexts.length
}

// Wrap the `n`-element backing on the stack as a full list of wrapper type `wrapTy`.
function arrLitWrap(n: i32, wrapTy: i32): i32 {
  fbI32Const(n) // len
  fbI32Const(n) // cap
  fbStructNew(wrapTy)
  0
}

// Whether element `ix` is a number literal, a negated one, or a boolean literal, in parens or not.
function arrLitElemIsConst(ix: i32): boolean {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return false }
  const e = nodeAt(x)
  if e is Unary {
    return e.unOp == "-" && arrLitLeafIsNum(unwrapParen(e.unArg))
  }
  arrLitLeafIsNum(x) || arrLitLeafIsBool(x)
}

function arrLitLeafIsNum(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  nodeAt(ix) is NumLit
}

function arrLitLeafIsBool(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  nodeAt(ix) is BoolLit
}

// Lower element `ix` the way the literal's own element loop does for `form`.
function arrLitDataElemEmit(
  body: u8[],
  ix: i32,
  fnIx: i32,
  form: i32,
  ec: ExpCtx,
): i32 {
  if form == ALD_I64 { return emitExprAsI64(body, ix, fnIx, ec) }
  if form == ALD_F32 { return emitExprAsF32(body, ix, fnIx, ec) }
  if form == ALD_F64 { return emitExprAsF64(body, ix, fnIx, ec) }
  emitExpr(body, ix, fnIx, ec)
}

// Append the little-endian element bytes the lone constant instruction `ins` denotes to `out`,
// returning their count, or -1 when `ins` is not exactly the one constant `form` expects.
function arrLitDataPut(ins: u8[], form: i32, out: u8[]): i32 {
  if ins.length < 2 { return -1 }
  const op = ins[0] as i32
  if form == ALD_F32 || form == ALD_F64 {
    const w = if form == ALD_F32 { 4 } else { 8 }
    if op != 0x43 + form - ALD_F32 || ins.length != w + 1 { return -1 }
    let j = 1
    while j <= w {
      out.push(ins[j])
      j = j + 1
    }
    return w
  }
  const want = if form == ALD_I64 { 0x42 } else { 0x41 }
  if op != want { return -1 }
  const w = if form == ALD_I64 { 8 } else if form == ALD_U8 { 1 } else { 4 }
  // The signed LEB128 immediate, re-packed eight bits at a time and sign-filled to `w` bytes.
  let bits = 0
  let nb = 0
  let put = 0
  let j = 1
  let last = 0
  while j < ins.length {
    last = ins[j] as i32
    if (last & 0x80) != 0 && j == ins.length - 1 { return -1 }
    if (last & 0x80) == 0 && j != ins.length - 1 { return -1 }
    bits = bits | ((last & 0x7f) << nb)
    nb = nb + 7
    while nb >= 8 && put < w {
      out.push(bits & 0xff)
      bits = bits >>> 8
      nb = nb - 8
      put = put + 1
    }
    j = j + 1
  }
  const fill = if (last & 0x40) != 0 { 0xff } else { 0 }
  if put < w {
    out.push((bits & ((1 << nb) - 1)) | ((fill << nb) & 0xff))
    put = put + 1
  }
  while put < w {
    out.push(fill)
    put = put + 1
  }
  w
}

// Lower the `len`-bounds guard of a list `xs[i]` read/write: stack holds [wrapper,
// index] on entry, leaves [backing, i]. One unsigned compare covers negative and past-len, and
// a failing one traps (`emitListIdxTrap`) instead of reading the zero-init slack `.push` leaves
// past `len`. A list whose backing this module never typed keeps the older `select` to -1.
function emitListIdxGuard(wrapSlot: i32, lTy: i32) {
  const back = listBackOfWrap(lTy)
  if back >= 0 {
    fbLocalSet(listIdxScratchBase)
    fbLocalSet(wrapSlot)
    fbLocalGet(listIdxScratchBase)
    fbLocalGet(wrapSlot)
    fbStructGet(lTy, 1) // field 1: len
    fbI32Bin(79) // 0x4f i32.ge_u
    fbIf(64)
    fbLocalGet(wrapSlot)
    fbStructGet(lTy, 0)
    if listBackIsRecord(back) {
      fbLocalGet(wrapSlot)
      fbStructGet(lTy, 0)
      fbArrayLen()
      fbLocalGet(wrapSlot)
      fbStructGet(lTy, 0)
    }
    emitListIdxTrap(back)
    fbEnd()
    fbLocalGet(wrapSlot)
    fbStructGet(lTy, 0) // field 0: backing
    fbLocalGet(listIdxScratchBase)
    return 0
  }
  fbLocalSet(listIdxScratchBase) // 0x21 local.set — stash the index
  fbLocalSet(wrapSlot)           // 0x21 local.set — stash the wrapper ref
  fbLocalGet(wrapSlot)
  fbStructGet(lTy, 0)            // field 0: backing
  fbLocalGet(listIdxScratchBase)
  fbI32Const(-1)                 // the out-of-range replacement index
  fbLocalGet(listIdxScratchBase)
  fbLocalGet(wrapSlot)
  fbStructGet(lTy, 1)            // field 1: len
  fbI32Bin(73)                   // 0x49 i32.lt_u
  fbSelect()                     // → i if in-bounds else -1
  0
}

// The backing array type of list wrapper `w`, or -1 when no list this module built has it.
function listBackOfWrap(w: i32): i32 {
  let k = 0
  while k < rlWrapIdx.length && k < rlBackIdx.length {
    if rlWrapIdx[k] == w { return rlBackIdx[k] }
    k = k + 1
  }
  if ba8Used && w == bl8TypeIdx { return ba8TypeIdx }
  if fa64Used && w == fl64TypeIdx { return fa64TypeIdx }
  if ia64Used && w == il64TypeIdx { return ia64TypeIdx }
  if fa32Used && w == fl32TypeIdx { return fa32TypeIdx }
  if slUsed && w == mkListIdx { return mkArrIdx }
  if aUsed && w == lTypeIdx { return aTypeIdx }
  -1
}

// Whether `back` is a record list's backing, which `-O` may store flattened: its trap is a
// copy, which the flattening rewrites as it does a list's growth, where a read it would box.
function listBackIsRecord(back: i32): boolean {
  let k = 0
  while k < rlBackIdx.length {
    if rlBackIdx[k] == back { return true }
    k = k + 1
  }
  false
}

// Traps with the engine's own bounds trap from the guard's untaken branch: a read at -1 of the
// backing, or for a record list (`listBackIsRecord`) a one-element copy to index `len` from
// `[backing, len, backing]`. The closing `unreachable` lets `-O` drop a later check of the same
// index and share one trap block, where a trap that fell through kept every check (D4782).
function emitListIdxTrap(back: i32) {
  if listBackIsRecord(back) {
    fbI32Const(0)
    fbI32Const(1)
    fbArrayCopy(back, back)
  } else {
    fbI32Const(-1)
    fbArrayGet(back)
    fbDrop()
  }
  fbUnreachable()
  0
}

// The hoisted twin of `emitListIdxGuard`, for an access whose receiver is a binding
// with a live cached header: the backing ref and `len` are already in locals, so the
// receiver is never (re-)emitted and the stack holds only the index. Leaves the same
// [backing, safeIndex] pair; an index `idxIx` that `rangeProvenIndex` proves in bounds skips the select.
function emitListIdxGuardHoisted(row: i32, idxIx: i32) {
  fbLocalSet(listIdxScratchBase) // 0x21 local.set — stash the index
  const back = listBackOfWrap(hoistWrapTyOfRow(row))
  if back >= 0 && !rangeProvenIndex(row, idxIx) {
    fbLocalGet(listIdxScratchBase)
    fbLocalGet(lhLen[row])
    fbI32Bin(79) // 0x4f i32.ge_u
    fbIf(64)
    fbLocalGet(lhBack[row])
    if listBackIsRecord(back) {
      fbLocalGet(lhBack[row])
      fbArrayLen()
      fbLocalGet(lhBack[row])
    }
    emitListIdxTrap(back)
    fbEnd()
    fbLocalGet(lhBack[row])
    fbLocalGet(listIdxScratchBase)
    return 0
  }
  fbLocalGet(lhBack[row]) // the cached backing (was `struct.get` field 0)
  if rangeProvenIndex(row, idxIx) {
    fbLocalGet(listIdxScratchBase)
    return 0
  }
  fbLocalGet(listIdxScratchBase)
  fbI32Const(-1)         // the out-of-range replacement index
  fbLocalGet(listIdxScratchBase)
  fbLocalGet(lhLen[row]) // the cached len (was `struct.get` field 1)
  fbI32Bin(73)           // 0x49 i32.lt_u
  fbSelect()             // → i if in-bounds else -1
  0
}

// The live hoist row for an index receiver, or -1: the receiver must be a bare
// identifier matching the row's binding, the row must be live, and its rep must match
// the arm asking. The rep check is the backstop that makes a classifier disagreement
// between the prologue and the access decline, rather than read a wrongly-typed local.
function liveHoistRow(exprIx: i32, kind: MfKind, slot: i32) {
  const nm = hoistPathName(exprIx)
  if nm == "" { return 0 - 1 }
  let k = 0
  while k < lhName.length {
    if (
      lhLive[k] > 0
      && lhName[k] == nm
      && lhKind[k] == kind
      && lhSlot[k] == slot
    ) {
      return k
    }
    k = k + 1
  }
  0 - 1
}

// The name a hoist row caches the receiver at `ix` under: a bare identifier's own name, or
// `b.xs` for a field of one; "" for any other receiver. `.` opens no identifier, so the two
// forms never collide.
function hoistPathName(ix: i32): string {
  if ix < 0 || ix >= P.nodes.length { return "" }
  const e = nodeAt(ix)
  if e is Member {
    const root = hoistRootName(e.memObj)
    if root == "" { return "" }
    return root + "." + e.memProp
  }
  hoistRootName(ix)
}

// The name of the bare identifier at `ix`, or "" for any other node: the one receiver a hoist
// row keys on by itself, and the only root a field path may have.
function hoistRootName(ix: i32): string {
  if ix < 0 || ix >= P.nodes.length { return "" }
  const e = nodeAt(ix)
  if e is Ident { return e.identName }
  ""
}

// Whether field receiver `memIx` (`b.xs`, `b` an identifier) lowers to one `struct.get` of a
// plain struct field, so the prologue may read it ahead of the loop: not a union, variant or
// nullable receiver, and not a narrowed read, each of which lowers through a dispatch or a guard.
function hoistFieldRecvOk(memIx: i32, fnIx: i32): boolean {
  const m = nodeAt(memIx)
  if m is Member {
    const o = m.memObj
    if (
      memIsNarrowed(memIx)
      || exprUnion(o, fnIx)
      || exprNullableStruct(o, fnIx)
    ) {
      return false
    }
    if exprVariantIndex(o, fnIx) >= 0 || nulVariantIdxOfExpr(o, fnIx) >= 0 {
      return false
    }
    const si = structIndexOfExpr(o, fnIx)
    return si >= 0 && sFieldIndex(si, m.memProp) >= 0
  }
  false
}

// Does the code under `ix` assign a field named `prop`, of any receiver? A cached `b.xs` is stale
// after `c.xs = …` whenever `c` aliases `b`, and the name is all that can be compared here.
function stmtAssignsProp(ix: i32, prop: string): boolean {
  let cur = ix
  while cur >= 0 {
    if cur >= P.nodes.length { return false }
    const n = nodeAt(cur)
    if n is BinExpr {
      if n.binOp == "=" {
        const t = nodeAt(unwrapParen(n.binLeft))
        if t is Member {
          if t.memProp == prop { return true }
        }
      }
    }
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      if stmtAssignsProp(kids[i], prop) { return true }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  false
}

// Find (or mint) the hoist row for `name` at list rep (`kind`, `slot`). Minting
// takes two slots of the lazy list frame — the backing ref (`liBack` 3, typed as
// this kind's backing array) and the i32 `len` (`liBack` 4).
function listHoistRow(name: string, kind: MfKind, slot: i32) {
  let k = 0
  while k < lhName.length {
    if lhName[k] == name && lhKind[k] == kind && lhSlot[k] == slot { return k }
    k = k + 1
  }
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(3)
  const bSlot = listIdxScratchBase + liKinds.length
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(4)
  const lSlot = listIdxScratchBase + liKinds.length
  lhName.push(name)
  lhKind.push(kind)
  lhSlot.push(slot)
  lhBack.push(bSlot)
  lhLen.push(lSlot)
  lhStart.push(0 - 1) // a list header has no `start`
  lhLive.push(0)
  lhName.length - 1
}

// A raw-string row is keyed (kind "i32", slot -1) — distinct from the i32-LIST rows, which
// are (kind "i32", slot 0), so the two can never be confused by `liveHoistRow`'s rep check.
// `hoistRowIsStr` reads the same pair.
function hoistRowIsStr(row: i32) { lhKind[row] == "i32" && lhSlot[row] < 0 }

// Find (or mint) the hoist row for raw string binding `name`, minting three slots of the
// lazy list frame (backing ref, `start`, `len`). Safe because the header is loop-invariant
// by construction — strings are immutable and there is no string element store — so only a
// rebinding of the name can invalidate the cache, which `blockReboundsName` already refuses.
function strHoistRow(name: string) {
  let k = 0
  while k < lhName.length {
    if lhName[k] == name && hoistRowIsStr(k) { return k }
    k = k + 1
  }
  liKinds.push("i32")
  liSlots.push(0)
  liBack.push(5)
  const sbSlot = listIdxScratchBase + liKinds.length
  liKinds.push("i32")
  liSlots.push(0)
  liBack.push(4)
  const stSlot = listIdxScratchBase + liKinds.length
  liKinds.push("i32")
  liSlots.push(0)
  liBack.push(4)
  const slSlot = listIdxScratchBase + liKinds.length
  lhName.push(name)
  lhKind.push("i32")
  lhSlot.push(0 - 1)
  lhBack.push(sbSlot)
  lhLen.push(slSlot)
  lhStart.push(stSlot)
  lhLive.push(0)
  lhName.length - 1
}

// Mint a fresh lazy-list-frame slot typed as list kind `kind`'s backing array — the same
// `liBack` 1 typing a chunked literal's destination, without emitting anything. Fresh and
// never deduped: a caller holds its backing live across a whole loop, so two callers
// sharing one slot would clobber each other's backing.
function listBackStashSlot(kind: MfKind, slot: i32) {
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(1)
  listIdxScratchBase + liKinds.length
}

// The string-header stash slot (`liBack == 6`, `(ref null $sTypeIdx)`), deduped per
// function since every `s[i]` / `s.charCodeAt(i)` shares it safely — the receiver
// stashes only after both it and the index are fully evaluated, so a nested string
// index has already passed through; it rides the lazy frame, so `emitStrCharCode` needs no `exprHasStrOp` arm.
function strHdrSlot() {
  let k = 0
  while k < liKinds.length {
    if liBack[k] == 6 { return listIdxScratchBase + 1 + k }
    k = k + 1
  }
  liKinds.push("i32")
  liSlots.push(0)
  liBack.push(6)
  listIdxScratchBase + liKinds.length
}

// Lower the bounds guard of a raw-string `s[i]` read: stack holds [string, index] on
// entry, leaves [backing, offset] where `offset` is `start + i` when `i u< len` and `-1`
// otherwise, so the read traps rather than silently returning a sibling view's character
// (the backing is longer than the view). The select is over the offset, not the raw index.
function emitStrIdxGuard() {
  const hs = strHdrSlot()
  fbLocalSet(listIdxScratchBase) // 0x21 local.set — stash the index
  fbLocalSet(hs)                 // 0x21 local.set — stash the string header
  fbLocalGet(hs)
  fbStrBack()                    // field 0: backing
  fbLocalGet(hs)
  fbStrStart()                   // field 1: start
  fbLocalGet(listIdxScratchBase)
  fbI32Bin(106)                  // 0x6a i32.add → start + i   [a]
  fbI32Const(-1)                 // the out-of-range replacement offset  [b]
  fbLocalGet(listIdxScratchBase)
  fbLocalGet(hs)
  fbStrLen()                     // field 2: len
  fbI32Bin(73)                   // 0x49 i32.lt_u (covers negative + past-len)
  fbSelect()                     // → start+i if in-bounds else -1
  0
}

// Mint a FRESH `(ref null $sBackIdx)` lazy-frame slot — the same `liBack` 5 typing a chunked
// string literal's destination gets, without emitting anything. Fresh and never deduped: the
// caller holds the backing live across a whole loop, so two nested `for cp in s` loops
// sharing one slot would clobber the outer one's backing with the inner one's.
function strBackSlot() {
  liKinds.push("i32")
  liSlots.push(0)
  liBack.push(5)
  listIdxScratchBase + liKinds.length
}

// Mint a FRESH `(ref null <mapTy>)` lazy-frame slot (`liBack` 22) holding a `for`-in walk's
// map across its body. Fresh for the reason `strBackSlot` is, and not the shared mapRef: every
// map op in the body rewrites that, and the walk re-reads `live` and `vals` each step (D2313).
function forInMapStashSlot(mapTy: i32) {
  liKinds.push("i32")
  liSlots.push(mapTy)
  liBack.push(22)
  listIdxScratchBase + liKinds.length
}

// Mint a FRESH i64 lazy-frame slot holding a map walk's saved entry sequence (D2315). Its
// `liSlots` tag is -7 so `listIdxValSlot`'s dedupe never hands it to an i64 store stash.
function mapSeqSaveSlot() {
  liKinds.push("i64")
  liSlots.push(0 - 7)
  liBack.push(2)
  listIdxScratchBase + liKinds.length
}

// The function's one `(ref null <i64 array>)` slot for a map-seqs grow, shared: no user code
// runs between its set and its last read (D2315).
function mapSeqsBackSlot() {
  if msHelp { return 8 }
  let k = 0
  while k < liKinds.length {
    if liKinds[k] == "i64" && liSlots[k] == 0 - 7 && liBack[k] == 3 {
      return listIdxScratchBase + 1 + k
    }
    k = k + 1
  }
  liKinds.push("i64")
  liSlots.push(0 - 7)
  liBack.push(3)
  listIdxScratchBase + liKinds.length
}

// Mint a FRESH i32 lazy-frame slot (`liBack` 4, the same code a hoisted list `len` uses).
// Fresh for the same reason `strBackSlot` is.
function strI32Slot() {
  liKinds.push("i32")
  liSlots.push(0)
  liBack.push(4)
  listIdxScratchBase + liKinds.length
}

// The hoisted twin of `emitStrIdxGuard`, for a `s[i]` whose receiver is a binding with a
// live cached header: backing / start / len are already in locals, so the receiver is
// never emitted and the stack holds only the index. Leaves the same [backing, offset]
// pair; the bounds check is not weakened — same `len`, read once before the loop.
function emitStrIdxGuardHoisted(row: i32) {
  fbLocalSet(listIdxScratchBase) // 0x21 local.set — stash the index
  fbLocalGet(lhBack[row])        // the cached backing (was `struct.get` field 0)
  fbLocalGet(lhStart[row])       // the cached start   (was `struct.get` field 1)
  fbLocalGet(listIdxScratchBase)
  fbI32Bin(106)                  // 0x6a i32.add → start + i   [a]
  fbI32Const(-1)                 // the out-of-range replacement offset  [b]
  fbLocalGet(listIdxScratchBase)
  fbLocalGet(lhLen[row])         // the cached len     (was `struct.get` field 2)
  fbI32Bin(73)                   // 0x49 i32.lt_u
  fbSelect()
  0
}

// A fresh element-value slot of the lazy list frame — `(ref null $rlElemHeap[slot])` for
// the "ref" kind. The non-deduping twin of `listIdxValSlot` below: the struct-element
// compare needs two live slots of one type at once (the left element and the right one),
// so a shared slot would compare a value against itself.
function listElemStashSlot(kind: MfKind, slot: i32) {
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(2)
  listIdxScratchBase + liKinds.length
}

// The indexed-store value stash slot for list kind `kind` (`slot` the ref-list table slot
// for kind "ref", else 0) — a `liBack == 2` entry typed as the element value. The value
// parks here across `emitListIdxGuard` so the backing and len resolve after its user code
// runs; no user code runs between the stash and the `array.set`, so sharing is clobber-safe.
function listIdxValSlot(kind: MfKind, slot: i32) {
  let k = 0
  while k < liKinds.length {
    if liKinds[k] == kind && liSlots[k] == slot && liBack[k] == 2 {
      return listIdxScratchBase + 1 + k
    }
    k = k + 1
  }
  liKinds.push(kind)
  liSlots.push(slot)
  liBack.push(2)
  listIdxScratchBase + liKinds.length
}

// True when the call at `callIx` lowers to linear-memory instructions and nothing else:
// a bare-identifier callee, unshadowed here, in the load/store/bulk/size families. No GC
// object is reachable from such a call — every operand is a number and the lowering is one
// instruction — so no list's `backing`/`len` can move across it. Every other call declines.
function hoistSafeMemCall(callIx: i32, fnIx: i32): boolean {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return false }
    const callee = nodeAt(c.callFn)
    if callee is Ident {
      const nm = callee.identName
      if identNameIsUserBound(nm, fnIx) { return false }
      if nm == "__store_i32__" { return true }
      if nm == "__load_i32__" { return true }
      if nm == "__memory_size__" { return true }
      if nm == "__memory_grow__" { return true }
      if nameIsMemStoreIntrinsic(nm) { return true }
      if nameIsMemLoadIntrinsic(nm) { return true }
      if nameIsAtomicIntrinsic(nm) { return true }
      return nameIsMemBulkIntrinsic(nm)
    }
  }
  false
}

// The soundness condition for list-header hoisting: across a loop body that cannot
// reallocate a list, its backing ref and `len` are loop-invariant, so hoisting reads them
// once before the loop instead of per access. Declines on a rebinding, a nullable receiver,
// and every call but `hoistSafeMemCall`'s — any other may reallocate through a param.
function hoistSafeExpr(ix: i32, fnIx: i32): boolean {
  if ix < 0 { return true }
  const e = nodeAt(ix)
  match e {
    NumLit => {
      return true
    }
    StrLit => {
      return true
    }
    CharLit => {
      return true
    }
    BoolLit => {
      return true
    }
    NullLit => {
      return true
    }
    Ident => {
      return true
    }
    Unary => {
      return hoistSafeExpr(e.unArg, fnIx)
    }
    Paren => {
      return hoistSafeExpr(e.parInner, fnIx)
    }
    IsExpr => {
      return hoistSafeExpr(e.isObj, fnIx)
    }
    AsExpr => {
      return hoistSafeExpr(e.asObj, fnIx)
    }
    Member => {
      return hoistSafeExpr(e.memObj, fnIx)
    }
    Index => {
      if !hoistSafeExpr(e.idxArr, fnIx) { return false }
      return hoistSafeExpr(e.idxIndex, fnIx)
    }
    BinExpr => {
      if !hoistSafeExpr(e.binLeft, fnIx) { return false }
      return hoistSafeExpr(e.binRight, fnIx)
    }
    Call => {
      // A counted push of an open build region moves only its own fresh list, which nothing
      // else holds and the region never indexes (D3623).
      if !hoistSafeMemCall(ix, fnIx) && listBuildRegionOf(ix) < 0 {
        return false
      }
      const args = e.callArgs
      let a = 0
      while a < args.length {
        if !hoistSafeExpr(args[a], fnIx) { return false }
        a = a + 1
      }
      return true
    }
    // Every other expression is outside the hoist whitelist.
    OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// The statement half of the whitelist. The fall-through hands an unrecognised
// statement to the EXPRESSION walk (a bare expression statement is how an
// assignment and a call both appear), which declines anything it does not know.
function hoistSafeStmt(ix: i32, fnIx: i32): boolean {
  if ix < 0 { return true }
  const s = nodeAt(ix)
  if s is LetDecl { return hoistSafeExpr(s.letInit, fnIx) }
  if s is RetStmt { return hoistSafeExpr(s.retArg, fnIx) }
  if s is BreakStmt { return true }
  if s is ContinueStmt { return true }
  if s is Block { return hoistSafeBlock(ix, fnIx) }
  if s is IfStmt {
    if !hoistSafeExpr(s.ifCond, fnIx) { return false }
    if !hoistSafeStmt(s.ifThen, fnIx) { return false }
    return hoistSafeStmt(s.ifElse, fnIx)
  }
  if s is WhileStmt {
    if !hoistSafeExpr(s.whileCond, fnIx) { return false }
    return hoistSafeStmt(s.whileBody, fnIx)
  }
  if s is ForRange {
    if !hoistSafeExpr(s.frFrom, fnIx) { return false }
    if !hoistSafeExpr(s.frTo, fnIx) { return false }
    if !hoistSafeExpr(s.frStep, fnIx) { return false }
    return hoistSafeStmt(s.frBody, fnIx)
  }
  if s is ForIn {
    if !hoistSafeExpr(s.fiIter, fnIx) { return false }
    return hoistSafeStmt(s.fiBody, fnIx)
  }
  hoistSafeExpr(ix, fnIx)
}

// Every loop asks both walks of its whole body, so a loop nest would cost the square of its
// depth; the answers are kept per block for one function (D2190). `hmSafe` holds
// `hoistSafeBlock`'s, and `hmNoIdx` the blocks in which `hoistScanExpr` found no index at all.
let hmFn = -2
let hmSafe: {[i32]: boolean} = Map()
let hmNoIdx: {[i32]: boolean} = Map()
let hmIdxSeen = 0

// Start the memos over when the function changes; `emitFuncBody` forces it with `-2`.
function hoistMemoFor(fnIx: i32) {
  if hmFn != fnIx {
    hmFn = fnIx
    hmSafe = Map()
    hmNoIdx = Map()
  }
  0
}

function hoistSafeBlock(ix: i32, fnIx: i32): boolean {
  if ix < 0 { return false }
  const b = nodeAt(ix)
  if b is Block {
    hoistMemoFor(fnIx)
    const known = hmSafe[ix]
    if known != null { return known }
    const stmts = b.blkStmts
    let safe = true
    let i = 0
    while safe && i < stmts.length {
      if !hoistSafeStmt(stmts[i], fnIx) { safe = false }
      i = i + 1
    }
    hmSafe[ix] = safe
    return safe
  }
  false
}

// True when `name` is REBOUND anywhere in the expression at `ix` — only an
// `name = …` assignment can do that in an expression. Runs over an already
// whitelisted body, so the enumeration matches `hoistSafeExpr`'s exactly.
function exprReboundsName(ix: i32, name: string): boolean {
  if ix < 0 { return false }
  const e = nodeAt(ix)
  match e {
    BinExpr => {
      if e.binOp == "=" {
        const lhs = nodeAt(e.binLeft)
        if lhs is Ident {
          if lhs.identName == name { return true }
        }
      }
      if exprReboundsName(e.binLeft, name) { return true }
      return exprReboundsName(e.binRight, name)
    }
    Unary => {
      return exprReboundsName(e.unArg, name)
    }
    Paren => {
      return exprReboundsName(e.parInner, name)
    }
    IsExpr => {
      return exprReboundsName(e.isObj, name)
    }
    AsExpr => {
      return exprReboundsName(e.asObj, name)
    }
    Member => {
      return exprReboundsName(e.memObj, name)
    }
    Index => {
      if exprReboundsName(e.idxArr, name) { return true }
      return exprReboundsName(e.idxIndex, name)
    }
    Call => {
      if exprReboundsName(e.callFn, name) { return true }
      const args = e.callArgs
      let a = 0
      while a < args.length {
        if exprReboundsName(args[a], name) { return true }
        a = a + 1
      }
    }
    // No other expression the whitelist admits can rebind a name.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  false
}

// True when `name` is REBOUND anywhere in the statement at `ix`: a `let`/`const`
// that shadows it, a loop variable that takes the spelling, or an assignment to
// it. Any of the three means the body's `name` is not the wrapper the prologue
// cached.
function stmtReboundsName(ix: i32, name: string): boolean {
  if ix < 0 { return false }
  const s = nodeAt(ix)
  if s is LetDecl {
    if s.letName == name { return true }
    return exprReboundsName(s.letInit, name)
  }
  if s is RetStmt { return exprReboundsName(s.retArg, name) }
  if s is BreakStmt { return false }
  if s is ContinueStmt { return false }
  if s is Block { return blockReboundsName(ix, name) }
  if s is IfStmt {
    if exprReboundsName(s.ifCond, name) { return true }
    if stmtReboundsName(s.ifThen, name) { return true }
    return stmtReboundsName(s.ifElse, name)
  }
  if s is WhileStmt {
    if exprReboundsName(s.whileCond, name) { return true }
    return stmtReboundsName(s.whileBody, name)
  }
  if s is ForRange {
    if s.frVar == name { return true }
    if exprReboundsName(s.frFrom, name) { return true }
    if exprReboundsName(s.frTo, name) { return true }
    if exprReboundsName(s.frStep, name) { return true }
    return stmtReboundsName(s.frBody, name)
  }
  if s is ForIn {
    if s.fiVar == name { return true }
    if s.fiVar2 == name { return true }
    if exprReboundsName(s.fiIter, name) { return true }
    return stmtReboundsName(s.fiBody, name)
  }
  exprReboundsName(ix, name)
}

function blockReboundsName(ix: i32, name: string): boolean {
  if ix < 0 { return false }
  const b = nodeAt(ix)
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      if stmtReboundsName(stmts[i], name) { return true }
      i = i + 1
    }
  }
  false
}

// Record one index receiver identifier and the `Index` node it is first seen on. The
// representative node is what the rep classifiers are asked about later, so the first
// sighting is kept — every later sighting of the same spelling in this body names the
// same binding (the caller has already established the body does not rebind it).
function hoistScanAdd(name: string, idxIx: i32) {
  let i = 0
  while i < lhScanName.length {
    if lhScanName[i] == name { return 0 }
    i = i + 1
  }
  lhScanName.push(name)
  lhScanRep.push(idxIx)
  0
}

function hoistScanExpr(ix: i32) {
  if ix < 0 { return 0 }
  const e = nodeAt(ix)
  match e {
    Index => {
      hmIdxSeen = hmIdxSeen + 1
      const pn = hoistPathName(e.idxArr)
      if pn != "" { hoistScanAdd(pn, ix) }
      hoistScanExpr(e.idxArr)
      hoistScanExpr(e.idxIndex)
      return 0
    }
    Unary => {
      return hoistScanExpr(e.unArg)
    }
    Paren => {
      return hoistScanExpr(e.parInner)
    }
    IsExpr => {
      return hoistScanExpr(e.isObj)
    }
    AsExpr => {
      return hoistScanExpr(e.asObj)
    }
    Member => {
      return hoistScanExpr(e.memObj)
    }
    BinExpr => {
      hoistScanExpr(e.binLeft)
      return hoistScanExpr(e.binRight)
    }
    Call => {
      hoistScanExpr(e.callFn)
      const args = e.callArgs
      let a = 0
      while a < args.length {
        hoistScanExpr(args[a])
        a = a + 1
      }
    }
    // No other expression holds an index the guard can hoist.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  0
}

function hoistScanStmt(ix: i32) {
  if ix < 0 { return 0 }
  const s = nodeAt(ix)
  if s is LetDecl { return hoistScanExpr(s.letInit) }
  if s is RetStmt { return hoistScanExpr(s.retArg) }
  if s is Block { return hoistScanBlock(ix) }
  if s is IfStmt {
    hoistScanExpr(s.ifCond)
    hoistScanStmt(s.ifThen)
    return hoistScanStmt(s.ifElse)
  }
  if s is WhileStmt {
    hoistScanExpr(s.whileCond)
    return hoistScanStmt(s.whileBody)
  }
  if s is ForRange {
    hoistScanExpr(s.frFrom)
    hoistScanExpr(s.frTo)
    hoistScanExpr(s.frStep)
    return hoistScanStmt(s.frBody)
  }
  if s is ForIn {
    hoistScanExpr(s.fiIter)
    return hoistScanStmt(s.fiBody)
  }
  hoistScanExpr(ix)
}

function hoistScanBlock(ix: i32) {
  if ix < 0 { return 0 }
  const b = nodeAt(ix)
  if b is Block {
    if hmNoIdx.has(ix) { return 0 }
    const seen = hmIdxSeen
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      hoistScanStmt(stmts[i])
      i = i + 1
    }
    if hmIdxSeen == seen { hmNoIdx[ix] = true }
  }
  0
}

// Resolve the list rep of an index receiver into a hoist row, or -1 when this receiver
// is not one of the reps the guard hoists. The cascade mirrors `emitIndex`'s own order,
// so a row is only minted for a rep whose access path the hoisted guard can actually
// serve; the nullable arms, checked first exactly as there, decline.
function hoistRowOfRecv(recvIx: i32, name: string, fnIx: i32) {
  // A cell that can hold null declines, however the read narrows: the prologue reads the
  // header above the null guard, and in a loop condition in front of `ref.is_null`.
  if readCellHoldsNullRef(recvIx, fnIx) { return 0 - 1 }
  if exprRefArray(recvIx, fnIx) {
    if !raUsed { return 0 - 1 }
    return listHoistRow(name, "ref", refListSlotOfExpr(recvIx, fnIx))
  }
  if exprNulStrArray(recvIx, fnIx) || exprStringArray(recvIx, fnIx) {
    if !slUsed { return 0 - 1 }
    return listHoistRow(name, "str", 0)
  }
  const ek = scalarListElemKind(recvIx, fnIx)
  if ek != null {
    if !scalarListUsed(ek) { return 0 - 1 }
    return listHoistRow(name, listIdxKindOf(ek), 0)
  }
  // A raw string receiver is checked last, after every list rep, so `exprString` never
  // gets a chance to answer for one. The `| null` niche declines too, for the same reason
  // `exprNullableList` does: the prologue would read the header above the null guard and
  // trap on a null receiver. `exprNullableString` is strictly wider than `exprString`.
  if exprString(recvIx, fnIx) {
    if !aUsed { return 0 - 1 }
    if exprNullableString(recvIx, fnIx) { return 0 - 1 }
    return strHoistRow(name)
  }
  0 - 1
}

// The wrapper struct type index a row's header is read out of — the mirror of
// `hoistRowOfRecv`'s rep decision, and the type the prologue's two `struct.get`s
// carry.
function hoistWrapTyOfRow(row: i32) {
  const k = lhKind[row]
  if k == "ref" { return rlWrapIdx[lhSlot[row]] }
  if k == "str" { return mkListIdx }
  if k == "f64" { return scalarListWrap("f64") }
  if k == "i64" { return scalarListWrap("i64") }
  if k == "f32" { return scalarListWrap("f32") }
  // The PACKED byte list's frame kind is `"u8"` (`listIdxKindOf`), and its wrapper is
  // `$bl8TypeIdx` — the i32 fall-through below would name the 4-byte list's wrapper for a
  // row whose local is typed `(ref null $bl8TypeIdx)`.
  if k == "u8" { return scalarListWrap("u8list") }
  scalarListWrap("i32")
}

// Open the hoists for one loop: scan its body, and for every index receiver that survives
// the soundness conditions, read its header into the row's two locals. Returns the count
// of rows opened (the `loopHoistClose` argument), or -1 on prologue failure. `condIx`, the
// loop's per-iteration condition, is held to the body's own hoist-safety standard — a `while f()` re-runs `f` every iteration.
function loopHoistOpen(
  body: u8[],
  condIx: i32,
  bodyIx: i32,
  fnIx: i32,
  ownVar: string,
  ownVar2: string,
  ec: ExpCtx,
) {
  if !hoistSafeExpr(condIx, fnIx) { return 0 }
  if !hoistSafeBlock(bodyIx, fnIx) { return 0 }
  lhScanName = []
  lhScanRep = []
  hoistScanExpr(condIx)
  hoistScanBlock(bodyIx)
  let opened = 0
  let i = 0
  while i < lhScanName.length {
    const nm = lhScanName[i]
    // A field path `b.xs` is held to its root's rebinding, to no write of any `xs` field in
    // the loop, and to a receiver that reads as one plain `struct.get`.
    let root = nm
    let prop = ""
    const scanned = nodeAt(lhScanRep[i])
    if scanned is Index {
      const recv = nodeAt(scanned.idxArr)
      if recv is Member {
        const ro = nodeAt(recv.memObj)
        if ro is Ident { root = ro.identName }
        prop = recv.memProp
      }
    }
    let ok = root != ownVar && root != ownVar2
    if ok && exprReboundsName(condIx, root) { ok = false }
    if ok && blockReboundsName(bodyIx, root) { ok = false }
    if ok && prop != "" {
      if stmtAssignsProp(condIx, prop) || stmtAssignsProp(bodyIx, prop) {
        ok = false
      }
      if ok && scanned is Index {
        if !hoistFieldRecvOk(scanned.idxArr, fnIx) { ok = false }
      }
    }
    if ok {
      const rep = nodeAt(lhScanRep[i])
      if rep is Index {
        let row = -1
        // A view's cached header is its snapshot, refreshed here; a store through an index in
        // the loop would miss it (D3028).
        if !svHoistBlocked(rep.idxArr, fnIx, condIx, bodyIx) {
          row = hoistRowOfRecv(rep.idxArr, nm, fnIx)
        }
        if row >= 0 && lhLive[row] == 0 {
          if hoistRowIsStr(row) {
            // A raw string's header is `{backing, start, len}` — three reads, because a
            // view's element offset is `start + i` and its bound is `len`, neither
            // recoverable from the other. The list arm below reads two; keeping both
            // spellings in one `if` (rather than a second `loopHoistOpen`) stops them drifting.
            if emitExpr(body, rep.idxArr, fnIx, ec) < 0 { return 0 - 1 }
            fbStrBack()
            fbLocalSet(lhBack[row])
            if emitExpr(body, rep.idxArr, fnIx, ec) < 0 { return 0 - 1 }
            fbStrStart()
            fbLocalSet(lhStart[row])
            if emitExpr(body, rep.idxArr, fnIx, ec) < 0 { return 0 - 1 }
            fbStrLen()
            fbLocalSet(lhLen[row])
          } else {
            const wrapTy = hoistWrapTyOfRow(row)
            if emitExpr(body, rep.idxArr, fnIx, ec) < 0 { return 0 - 1 }
            svSyncRecv(rep.idxArr, fnIx)
            fbStructGet(wrapTy, 0) // field 0: backing
            fbLocalSet(lhBack[row])
            if emitExpr(body, rep.idxArr, fnIx, ec) < 0 { return 0 - 1 }
            fbStructGet(wrapTy, 1) // field 1: len
            fbLocalSet(lhLen[row])
          }
          lhLive[row] = 1
          lhOpen.push(row)
          opened = opened + 1
        }
      }
    }
    i = i + 1
  }
  opened
}

// The live list (not raw-string) hoist row cached for binding `name`, or -1.
function liveListRowNamed(name: string) {
  let k = 0
  while k < lhName.length {
    if lhLive[k] > 0 && lhName[k] == name && !hoistRowIsStr(k) { return k }
    k = k + 1
  }
  0 - 1
}

// Whether `ix` is a non-negative i32 integer literal.
function exprIsNonNegIntLit(ix: i32) {
  if ix < 0 { return false }
  const e = nodeAt(ix)
  if e is NumLit {
    return !numLexIsFloat(e.numText)
      && numLexFitsI32(e.numText)
      && parseI32(e.numText) >= 0
  }
  false
}

// The binding whose length bounds a range loop's top, or "": `xs.length` under `until`,
// `xs.length - 1` under `to`. Either way every value the loop variable takes is `< len`.
function rangeTopLenOf(s: ForRange) {
  let top = s.frTo
  if !s.frExcl {
    if top < 0 { return "" }
    const b = nodeAt(top)
    if b is BinExpr {
      if b.binOp != "-" { return "" }
      const one = nodeAt(b.binRight)
      if one is NumLit {
        if one.numText != "1" { return "" }
      } else {
        return ""
      }
      top = b.binLeft
    } else {
      return ""
    }
  }
  if top < 0 { return "" }
  const m = nodeAt(top)
  if m is Member {
    if m.memProp != "length" { return "" }
    return hoistPathName(m.memObj)
  }
  ""
}

// Open a range proof for `for v in A until xs.length` (or `to xs.length - 1`) with a constant
// positive step, `A` a non-negative literal, `v` never rebound in the body, and `xs` served by
// a live hoist row — whose `len` cannot move while the row is live. Returns the count pushed.
function rangeProofOpen(s: ForRange, stepK: i32, dynStep: boolean) {
  if dynStep || stepK <= 0 { return 0 }
  if !exprIsNonNegIntLit(s.frFrom) { return 0 }
  const nm = rangeTopLenOf(s)
  if nm == "" || nm == s.frVar { return 0 }
  const row = liveListRowNamed(nm)
  if row < 0 { return 0 }
  if blockReboundsName(s.frBody, s.frVar) { return 0 }
  rpVar.push(s.frVar)
  rpRow.push(row)
  1
}

function rangeProofClose(n: i32) {
  let i = 0
  while i < n {
    rpVar.pop()
    rpRow.pop()
    i = i + 1
  }
  0
}

// Whether index expression `idxIx` over hoist row `row` is a range-proven loop variable.
function rangeProvenIndex(row: i32, idxIx: i32) {
  if idxIx < 0 { return false }
  const e = nodeAt(idxIx)
  if e is Ident {
    let k = rpVar.length - 1
    while k >= 0 {
      if rpVar[k] == e.identName { return rpRow[k] == row }
      k = k - 1
    }
  }
  false
}

// Close the `n` rows this loop opened, innermost first.
function loopHoistClose(n: i32) {
  let i = 0
  while i < n {
    const row = lhOpen[lhOpen.length - 1]
    lhOpen.pop()
    lhLive[row] = 0
    i = i + 1
  }
  0
}

function emitIndex(body: u8[], idxIx: i32, fnIx: i32, ec: ExpCtx) {
  const nd = nodeAt(idxIx)
  if nd is Index {
    const tlm = twoListUseMsg(nd.idxArr, OP_INDEX_GET, fnIx)
    if tlm != "" { return emitFailAt(tlm, idxIx) }
    // A DISTINCT-backing nullable scalar list `t[i]` (narrowed inside `if t != null`): the slot is
    // `(ref null $wrapper)`, so recover non-null (the guard proved it present) then read as the leaf
    // list. Checked FIRST — the plain classifiers below do not see through the `| null`.
    const nsk = exprNulScalarListKind(nd.idxArr, fnIx)
    if nsk != null { return emitIndexNulScalarList(body, nd, nsk, fnIx, ec) }
    // A REF list `xs[i]`. Checked BEFORE the `aUsed` guard: a pure ref-list program uses no
    // i32 array.
    if exprRefArray(nd.idxArr, fnIx) {
      return emitIndexRefList(body, nd, idxIx, fnIx, ec)
    }
    // A `(string | null)[]` `xs[i]` → the SAME string backing, but the element legitimately holds
    // `null` (it is a `(ref null $aTypeIdx)`), so the read STAYS nullable — NO `ref.as_non_null`. The
    // bound value is a `nulstr` the caller narrows with `!= null` (`nodeTyIsNulString` classifies it).
    // Checked BEFORE `exprStringArray` (whose non-null recovery would trap on a null element).
    if exprNulStrArray(nd.idxArr, fnIx) {
      if emitIndexStrListRead(body, nd, fnIx, ec) < 0 { return -1 }
      // A read the checker types non-null recovers here for the same reason the ref-list arm
      // does — this is the `(new string | null)[]` rep, eight of D451's 56 cells, and
      // the one the row's "box rather than a niche" mechanism mis-classified.
      if nodeTyProvesNonNull(idxIx) { fbRefAsNonNull() }
      return 0
    }
    // A STRING list `xs[i]` → the string backing's element, then `ref.as_non_null` to
    // surface the non-null string ref. (Checked before the i32 path: a string element is not an i32.)
    if exprStringArray(nd.idxArr, fnIx) {
      if emitIndexStrListRead(body, nd, fnIx, ec) < 0 { return -1 }
      fbRefAsNonNull() // (recover the non-null string)
      return 0
    }
    // A SCALAR list `xs[i]` (f64/i64 checked before i32 since their elements are not i32).
    const ek = scalarListElemKind(nd.idxArr, fnIx)
    if ek != null { return emitIndexScalarList(body, nd, ek, fnIx, ec) }
    if !aUsed {
      return emitFail("emitProgram: index access but array type not collected")
    }
    if !exprString(nd.idxArr, fnIx) {
      return emitFail("emitProgram: index receiver is not an array or string")
    }
    // A raw string `s[i]` — the receiver is a header, so the read is `backing[start + i]`
    // behind the `i u< len` guard that keeps an out-of-range index trapping instead of
    // reading past the view into the rest of the backing. A binding with a live
    // loop-hoisted header skips the receiver entirely and reads three locals.
    const shz = liveHoistRow(nd.idxArr, "i32", 0 - 1)
    if shz < 0 {
      if emitExpr(body, nd.idxArr, fnIx, ec) < 0 { return -1 }
    }
    if emitExpr(body, nd.idxIndex, fnIx, ec) < 0 { return -1 }
    if shz >= 0 { emitStrIdxGuardHoisted(shz) } else { emitStrIdxGuard() }
    fbArrayGet(sBackIdx) // 0xfb 0x0b <string backing array type index>
    return 0
  }
  emitFail("emitProgram: expected an index access")
}

// A DISTINCT-backing nullable scalar list `t[i]` of kind `nsk`, narrowed inside `if t != null`:
// the slot is `(ref null $wrapper)`, so it recovers non-null (the guard proved it present) and
// reads as the leaf list. Returns 0, or -1 when an operand fails.
function emitIndexNulScalarList(
  body: u8[],
  nd: Index,
  nsk: VKind,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if emitExpr(body, nd.idxArr, fnIx, ec) < 0 { return -1 }
  fbRefAsNonNull() // (the `!= null` guard makes this safe)
  if emitExpr(body, nd.idxIndex, fnIx, ec) < 0 { return -1 }
  if nsk == "nulstrlist" {
    emitListIdxGuard(listIdxWrapSlot("str", 0), mkListIdx)
    fbArrayGet(mkArrIdx) // 0xfb 0x0b string backing
    // A nullable-element inner list (`(string | null)[] | null`, narrowed): the
    // element legitimately holds null, so the read stays `(ref null $aTypeIdx)` — an
    // unconditional non-null recover here is correct only for `string[] | null` (whose
    // elements are never null), and traps otherwise. `exprNulStrArray` resolves this.
    if exprNulStrArray(nd.idxArr, fnIx) { return 0 }
    fbRefAsNonNull() // (non-null string element)
    return 0
  }
  // `nek` names the leaf element kind whose wrapper / backing / index-scratch pool this
  // read uses; `u8list` is the packed-byte leaf's spelling (the element is a plain i32,
  // so the kind names the list, not a scalar). Without this arm a `u8[] | null` read fell
  // to the `f64` default and read whatever heap index the offset formula left there — check-clean invalid wasm.
  let nek: VKind = "f64"
  if nsk == "nuli64list" { nek = "i64" }
  if nsk == "nulf32list" { nek = "f32" }
  if nsk == "nulu8list" { nek = "u8list" }
  const nsv = svDstOfKind(nek)
  if nsv >= 0 { return emitSvIndexRead(nek, nsv) }
  emitListIdxGuard(listIdxWrapSlot(listIdxKindOf(nek), 0), scalarListWrap(nek))
  fbArrayGet(scalarListBack(nek)) // yields the element in its rep
  0
}

// A REF list `xs[i]` at index node `idxIx`: unwrap to its `(ref null $elem)` backing,
// `array.get`, then `ref.as_non_null` (`0xd4`) to surface the non-null element (a struct ref /
// union box) — slots in `[0,len)` are always populated, so the cast never traps. Returns 0, or
// -1 on a refusal or a failed operand.
function emitIndexRefList(
  body: u8[],
  nd: Index,
  idxIx: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if !raUsed {
    return emitFail(
      "emitProgram: ref index access but ref array type not collected",
    )
  }
  const rslot = refListSlotOfExpr(nd.idxArr, fnIx)
  if rslot < 0 { return refListRowRefused(nd.idxArr) }
  // A live hoist row serves this access's header from locals, so the
  // RECEIVER is not emitted at all — the prologue before the loop read it
  // once. Only the index goes on the stack.
  const rlHz = liveHoistRow(nd.idxArr, "ref", rslot)
  if rlHz < 0 {
    if emitExpr(body, nd.idxArr, fnIx, ec) < 0 { return -1 }
    // A NULLABLE ref-array receiver (`t: i32[][] | null`, kind 18, narrowed) reads `(ref null …)` —
    // recover non-null before `struct.get` (the `if t != null` guard makes this safe).
    if exprNullableRefArray(nd.idxArr, fnIx) { fbRefAsNonNull() }
  }
  if emitExpr(body, nd.idxIndex, fnIx, ec) < 0 { return -1 }
  // Guard `i u< len`, unwrap to the backing (`struct.get` field 0), read. A list that may be
  // a view reads its element through the view's source (D3041).
  if rlHz >= 0 {
    emitListIdxGuardHoisted(rlHz, nd.idxIndex)
    fbArrayGet(rlBackIdx[rslot]) // 0xfb 0x0b <this slot's ref backing array>
  } else if rvMayView(rslot) {
    emitRvIndexRead(rslot)
  } else {
    emitListIdxGuard(listIdxWrapSlot("ref", rslot), rlWrapIdx[rslot])
    fbArrayGet(rlBackIdx[rslot]) // 0xfb 0x0b <this slot's ref backing array>
  }
  // A nullable-niche element legitimately holds null, so the read stays `(ref null
  // $elem)` with no `ref.as_non_null` recover (the caller narrows with `e != null`).
  // `listElemStaysNullable` is the shared answer — `.map`/`.filter`'s element step asks
  // it too, and answering it differently in the two places is a recover that traps in one.
  if listElemStaysNullable(nd.idxArr, fnIx) {
    // …UNLESS the index PLACE itself is narrowed non-null (D451). The niche half of the
    // channel: nothing to unbox, but the value must stop being `(ref null …)` or it
    // reaches a `(ref …)` consumer as one. The guard is what makes the recovery safe,
    // exactly as the kind-18 receiver recovery above is.
    if nodeTyProvesNonNull(idxIx) { fbRefAsNonNull() }
    return 0
  }
  fbRefAsNonNull() // (recover the non-null element)
  if emitStaleBoxRetag(rslot, idxIx) < 0 { return -1 }
  // A union-box cell whose index place is narrowed to one scalar atom unboxes here
  // (D451): without it `vl check` proves `xs[0]` non-null and every classifier calls it
  // an `i32`, but this arm still leaves the raw `(ref $uBox)` for an unboxed consumer —
  // invalid wasm. Routed through the shared `emitUnionUnboxTail`, not an open-coded unbox.
  const iCon = emitPlaceNarrowContainerUnbox(idxIx, fnIx)
  if iCon != 0 { return iCon - 1 }
  if indexElemUnionName(idxIx, fnIx) != "" {
    const iuk = idxNarrowAtomKind(idxIx, fnIx)
    if iuk >= 0 && iuk != nullValKind() { return emitUnionUnboxTail(iuk) }
  }
  0
}

// The read `string[]` and `(string | null)[]` share: the receiver (or its live hoist row), the
// index, the `i u< len` guard and the `array.get` of the string backing, leaving the element
// `(ref null $sTypeIdx)` for the caller to recover or keep. Returns 0, or -1 on a refusal.
function emitIndexStrListRead(
  body: u8[],
  nd: Index,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if !slUsed {
    return emitFail(
      "emitProgram: string index access but string list type not collected",
    )
  }
  const slHz = liveHoistRow(nd.idxArr, "str", 0)
  if slHz < 0 {
    if emitExpr(body, nd.idxArr, fnIx, ec) < 0 { return -1 }
  }
  if emitExpr(body, nd.idxIndex, fnIx, ec) < 0 { return -1 }
  if slHz >= 0 {
    emitListIdxGuardHoisted(slHz, nd.idxIndex)
  } else {
    emitListIdxGuard(listIdxWrapSlot("str", 0), mkListIdx)
  }
  fbArrayGet(mkArrIdx) // 0xfb 0x0b <string backing array type index>
  0
}

// A SCALAR list `xs[i]` of element kind `ek`: unwrap to its backing and `array.get <back>`,
// yielding the element in its valtype rep. Returns 0, or -1 on a refusal or a failed operand.
function emitIndexScalarList(
  body: u8[],
  nd: Index,
  ek: VKind,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if !scalarListUsed(ek) {
    return emitFail("emitProgram: index access but list type not collected")
  }
  const skHz = liveHoistRow(nd.idxArr, listIdxKindOf(ek), 0)
  if skHz < 0 {
    if emitExpr(body, nd.idxArr, fnIx, ec) < 0 { return -1 }
  }
  if emitExpr(body, nd.idxIndex, fnIx, ec) < 0 { return -1 }
  // A list that may be a view reads its element through the view's source (D3028).
  const ixSv = svDstOfKind(ek)
  if ixSv >= 0 && skHz < 0 { return emitSvIndexRead(ek, ixSv) }
  // Guard `i u< len`, unwrap to the backing (`struct.get` field 0), read.
  if skHz >= 0 {
    emitListIdxGuardHoisted(skHz, nd.idxIndex)
  } else {
    emitListIdxGuard(listIdxWrapSlot(listIdxKindOf(ek), 0), scalarListWrap(ek))
  }
  fbArrayGet(scalarListBack(ek)) // yields the element in its rep
  0
}

// Lower a `.length` onto `body`: a list's length is its wrapper's `len` field (not the
// backing's physical length, which is `cap`) via `struct.get <wrap> 1`; a raw string's
// `.length` is its header's `len` field (`fbStrLen()`), not `array.len` — which would
// report the parent's length for a view. Each element kind is resolved below in its own arm.
function emitArrLen(body: u8[], memIx: i32, fnIx: i32, ec: ExpCtx) {
  const m = nodeAt(memIx)
  if m is Member {
    // A REF list's `.length` is its wrapper's `len` field (`struct.get $wrap 1`).
    if exprRefArray(m.memObj, fnIx) {
      const rslot = refListSlotOfExpr(m.memObj, fnIx)
      if rslot < 0 || rslot >= rlWrapIdx.length {
        return emitFailAt(
          "emitProgram: `.length` receiver's ref-list element does not resolve",
          m.memObj,
        )
      }
      if rvMayView(rslot) {
        // A loop's cached header is refreshed at its entry and holds for its body.
        const rlenHz = liveHoistRow(m.memObj, "ref", rslot)
        if rlenHz >= 0 {
          fbLocalGet(lhLen[rlenHz])
          return 0
        }
      }
      if emitExpr(body, m.memObj, fnIx, ec) < 0 { return -1 }
      if rvMayView(rslot) {
        const rwL = listIdxWrapSlot("ref", rslot)
        fbLocalSet(rwL)
        rvTestView(rwL)
        fbIf(127) // i32
        fbLocalGet(rwL)
        fbCall(gHelpRvLen)
        fbElse()
        fbLocalGet(rwL)
        fbStructGet(rlWrapIdx[rslot], 1)
        fbEnd()
        return 0
      }
      fbStructGet(rlWrapIdx[rslot], 1) // 0xfb 0x02 <ref-list wrapper> field 1: len
      return 0
    }
    // A STRING list's `.length` is its wrapper's `len` field (`struct.get $mkListIdx 1`).
    if exprStringArray(m.memObj, fnIx) {
      if emitExpr(body, m.memObj, fnIx, ec) < 0 { return -1 }
      fbStructGet(mkListIdx, 1) // 0xfb 0x02 <string-list wrapper> field 1: len
      return 0
    }
    // A SCALAR list's `.length` is its wrapper's `len` field (`struct.get <wrap> 1`) — an
    // i32, the same shape for every element kind over that kind's wrapper. (f64/i64 before
    // i32 since their elements are not i32.)
    const lek = scalarListElemKind(m.memObj, fnIx)
    if (
      lek != null
      && (lek == "f64" || lek == "i64" || lek == "f32" || lek == "u8list")
    ) {
      const lenSv = svDstOfKind(lek)
      if lenSv >= 0 && lek != null {
        // A loop's cached header is refreshed at its entry and holds for its body.
        const lenHz = liveHoistRow(m.memObj, listIdxKindOf(lek), 0)
        if lenHz >= 0 {
          fbLocalGet(lhLen[lenHz])
          return 0
        }
      }
      if emitExpr(body, m.memObj, fnIx, ec) < 0 { return -1 }
      if lenSv >= 0 && lek != null {
        const lwL = listIdxWrapSlot(listIdxKindOf(lek), 0)
        fbLocalSet(lwL)
        svTestView(lwL, lenSv)
        fbIf(127) // i32
        fbLocalGet(lwL)
        fbCall(gHelpSvLen[lenSv])
        fbElse()
        fbLocalGet(lwL)
        fbStructGet(scalarListWrap(lek), 1)
        fbEnd()
        return 0
      }
      fbStructGet(scalarListWrap(lek), 1) // field 1: len
      return 0
    }
    if exprArray(m.memObj, fnIx) {
      if emitExpr(body, m.memObj, fnIx, ec) < 0 { return -1 }
      fbStructGet(lTypeIdx, 1) // 0xfb 0x02 <list wrapper struct type index> field 1: len
      return 0
    }
    // A raw string's `.length` is the header's `len` field (`fbStrLen()`), not `array.len`
    // (the backing's physical length, which would report a parent string's length for a
    // view of it). The arm is spelled out and the fallthrough fails loudly instead of
    // defaulting, since a wrong fallthrough would be invalid wasm or a wrong integer.
    if !exprString(m.memObj, fnIx) {
      return emitFail("emitProgram: .length receiver is not an array or string")
    }
    if emitExpr(body, m.memObj, fnIx, ec) < 0 { return -1 }
    fbStrLen() // 0xfb 0x02 <string header> field 2: len
    return 0
  }
  emitFail("emitProgram: expected a length access")
}

// ── G6: string concatenation / value-equality / slice ────────────────────────
// A string is a `{backing, start, len}` view over a `(array (mut i32))` of code points;
// these lower via the same array machinery `.push` uses, with the header hoisted once
// into the shared string scratch frame — each routine evaluates both operands fully before any scratch `local.set`, which is what makes sharing one frame across nested ops safe.

// `local.get` of string scratch local `n` (0 = header A, 1 = header B, 2 = the Out BACKING —
// Stage 2b re-typed slot 2 from a finished string to the element array under construction).
function pushStrScrRef(_body: u8[], n: i32) {
  fbLocalGet(strScratchBase + n) // 0x20 local.get
  0
}

// `local.get` of i32 scratch temp `n` (0..3 → frame slots +3..+6).
function pushStrScrI(_body: u8[], n: i32) {
  fbLocalGet(strScratchBase + 3 + n) // 0x20 local.get
  0
}

// `local.set` of i32 scratch temp `n`.
function setStrScrI(_body: u8[], n: i32) {
  fbLocalSet(strScratchBase + 3 + n) // 0x21 local.set
  0
}

// ── the string-op frame's hoist half ─────────────────────────────────────────
// A string is a header, so a loop reading `A[i]` per step would pay two `struct.get`s
// (backing, start) per trip; `hoistStrScr` reads them once into the frame's last four
// slots, safe because the header's fields are immutable and no string element store exists.

// Hoist operand `n` (0 = A, 1 = B) — its header must already be in `strScratchBase + n`.
function hoistStrScr(_body: u8[], n: i32) {
  fbLocalGet(strScratchBase + n)
  fbStrBack()
  fbLocalSet(strScratchBase + 7 + n)
  fbLocalGet(strScratchBase + n)
  fbStrStart()
  fbLocalSet(strScratchBase + 9 + n)
  0
}

// Push `[backing_n, start_n]` for a hoisted operand — the caller adds its own index and
// closes with `array.get $sBackIdx`.
function pushStrScrBase(_body: u8[], n: i32) {
  fbLocalGet(strScratchBase + 7 + n)
  fbLocalGet(strScratchBase + 9 + n)
  0
}

// `[.., i] -> [.., backing_n[start_n + i]]` is not expressible (the base has to go under the
// index), so this is the whole read for the common `operand[<i32 temp>]` shape: push the
// hoisted base, push temp `t`, add, read.
function pushStrScrElem(body: u8[], n: i32, t: i32) {
  pushStrScrBase(body, n)
  pushStrScrI(body, t)
  fbI32Bin(106) // 0x6a i32.add — start_n + t
  fbArrayGet(sBackIdx)
  0
}

// Lower a string concatenation `a + b` onto `body`, leaving the new string ref on the
// stack: allocate a fresh `(array i32)` of `len(a) + len(b)`, `array.copy` a's code
// points into `[0, lenA)` and b's into `[lenA, lenA+lenB)`. Both operands are evaluated
// first, then stashed, so a nested string op fully completes before either write.
function emitStrConcat(body: u8[], binIx: i32, fnIx: i32, ec: ExpCtx) {
  if !aUsed {
    return emitFail("emitProgram: string concat but array type not collected")
  }
  if binIx < 0 { return -1 }
  const e = nodeAt(binIx)
  if e is BinExpr {
    // Three or more parts fuse: `a + b + c + d` is one `+` node per operand pair, so the
    // pairwise lowering would allocate and copy the accumulated prefix once per pair —
    // quadratic, and every string interpolation is such a chain. `strCatParts` flattens
    // the maximal chain and `emitStrCatN` buys it back with one sized allocation and copy.
    const parts: i32[] = []
    strCatParts(binIx, fnIx, parts)
    if binIx == ssArmRhs {
      ssArmRhs = -1
      return emitStrSiteCat(body, parts, ssArmMode, ssArmBin, fnIx, ec)
    }
    if parts.length > 2 { return emitStrCatN(body, parts, fnIx, ec) }
    // Eval BOTH operands onto the stack (nested string ops complete here) and call
    // the shared `__str_concat__` helper — the allocate+copy core lives once per
    // module (`emitStrConcatFnCode`). A literal-union atom operand widens to its
    // member string (`emitStrValue`) before the call.
    if emitStrCatOperand(body, e.binLeft, fnIx, ec, ec) < 0 { return -1 }
    if emitStrCatOperand(body, e.binRight, fnIx, ec, ec) < 0 { return -1 }
    fbCall(gHelpStrConcat)
    return 0
  }
  emitFail("emitProgram: expected a string concatenation")
}

// Flatten the maximal string `+` chain rooted at `binIx` into its operand expressions,
// left to right, into `parts`. A node is chain-interior exactly when `exprIsStrConcat`
// claims it — the same predicate that routes `+` here — so the walk and the dispatch
// cannot disagree about where the chain ends. A `Paren` sub-chain keeps its own lowering.
function strCatParts(binIx: i32, fnIx: i32, parts: i32[]) {
  const e = nodeAt(binIx)
  if e is BinExpr {
    if exprIsStrConcat(e.binLeft, fnIx) {
      strCatParts(e.binLeft, fnIx, parts)
    } else {
      parts.push(e.binLeft)
    }
    if exprIsStrConcat(e.binRight, fnIx) {
      strCatParts(e.binRight, fnIx, parts)
    } else {
      parts.push(e.binRight)
    }
  }
  0
}

// Part slot `i` of the n-ary concat pool, minted on demand into the lazy list frame
// (`liBack` code 18) and cached for the rest of the function. One pool serves every
// nesting depth: `emitStrCatN` evaluates every part onto the stack before writing a
// single slot, so a nested chain has finished with the pool before the outer chain touches it.
function strCatSlot(i: i32) {
  while strCatSlotIx.length <= i {
    liKinds.push("i32")
    liSlots.push(0)
    liBack.push(18)
    strCatSlotIx.push(listIdxScratchBase + liKinds.length)
  }
  strCatSlotIx[i]
}

// Lower an n-part (n >= 3) string chain: evaluate the parts left to right (each exactly
// once, in source order), sum their lengths, allocate one exact-fit backing, `array.copy`
// each part in at a running offset, and wrap one header. All n values reach the stack
// first and are popped into slots deepest-last (§G6), so no scratch write straddles an operand evaluation.
function emitStrCatN(body: u8[], parts: i32[], fnIx: i32, ec: ExpCtx) {
  const n = parts.length
  let i = 0
  while i < n {
    if emitStrCatOperand(body, parts[i], fnIx, ec, ec) < 0 { return -1 }
    i = i + 1
  }
  let j = n - 1
  while j >= 0 {
    fbLocalSet(strCatSlot(j))
    j = j - 1
  }
  fbLocalGet(strCatSlot(0))
  fbStrLen()
  let k = 1
  while k < n {
    fbLocalGet(strCatSlot(k))
    fbStrLen()
    fbI32Bin(106) // i32.add
    k = k + 1
  }
  fbLocalTee(strScratchBase + 3) // strScrI0 = the total length
  fbArrayNewDefault(sBackIdx)
  fbLocalSet(strScratchBase + 2) // strScrOut = the one exact-fit backing
  fbI32Const(0)
  fbLocalSet(strScratchBase + 4) // strScrI1 = the running destination offset
  let m = 0
  while m < n {
    fbLocalGet(strScratchBase + 2)
    fbLocalGet(strScratchBase + 4)
    fbLocalGet(strCatSlot(m))
    fbStrBack()
    fbLocalGet(strCatSlot(m))
    fbStrStart()
    fbLocalGet(strCatSlot(m))
    fbStrLen()
    fbArrayCopy(sBackIdx, sBackIdx)
    if m + 1 < n {
      fbLocalGet(strScratchBase + 4)
      fbLocalGet(strCatSlot(m))
      fbStrLen()
      fbI32Bin(106) // i32.add
      fbLocalSet(strScratchBase + 4)
    }
    m = m + 1
  }
  fbLocalGet(strScratchBase + 2)
  fbI32Const(0)
  fbLocalGet(strScratchBase + 3)
  fbStrNew()
  0
}

// ── the loop-local string accumulator ────────────────────────────────────────
// `let s = ""; s = s + piece` in a loop is O(n²); `strAccScan` proves a binding is an
// accumulator, and `emitStrAccAppend` then appends in place into slack its own grow
// path allocated — linear, with no builder in the source. Soundness: `s` only ever holds a literal, a fresh concat result, or a buffer it allocated (DECISIONS.md "String building is a lowering").
let saNames: string[] = []
let saDecls: i32[] = []
let saApps: i32[] = []
let saBads: i32[] = []
let saFnIx = 0 - 2
// A mark may only reach a name the scan already knows. At MODULE scope the walk covers
// every function body, where minting a row per identifier would make the scan quadratic in
// the program; the candidate declarations are all noted before the flag goes up.
let saKnownOnly = false

// The row for `name`, or -1.
function saFind(name: string) {
  let i = 0
  while i < saNames.length {
    if saNames[i] == name { return i }
    i = i + 1
  }
  -1
}

// Keep only the rows a later phase could still change: an already-disqualified name, or one
// declared twice, can never qualify, and a dropped row reads as absent — which
// `saNameQualifies` and `saMarkBad` both already treat as "not an accumulator". The prune is
// what keeps the module-wide walk linear in the program rather than in its bindings.
function saPruneSettled() {
  const kn: string[] = []
  const kd: i32[] = []
  const ka: i32[] = []
  const kb: i32[] = []
  let i = 0
  while i < saNames.length {
    if saBads[i] == 0 && saDecls[i] == 1 {
      kn.push(saNames[i])
      kd.push(saDecls[i])
      ka.push(saApps[i])
      kb.push(saBads[i])
    }
    i = i + 1
  }
  saNames = kn
  saDecls = kd
  saApps = ka
  saBads = kb
  0
}

// Find (or start) the row for `name`.
function saRow(name: string) {
  const at = saFind(name)
  if at >= 0 { return at }
  saNames.push(name)
  saDecls.push(0)
  saApps.push(0)
  saBads.push(0)
  saNames.length - 1
}

function saMarkBad(name: string) {
  const at = saFind(name)
  if at >= 0 {
    saBads[at] = 1
    return 0
  }
  if saKnownOnly { return 0 }
  saBads[saRow(name)] = 1
  0
}

// A declaration qualifies only at the one spelling whose value is exact-fit by
// construction: a mutable `let` whose initialiser is a string literal, annotated
// `string` or not at all. Anything else disqualifies the name, because the binding
// could then be handed a buffer some other accumulator still owns.
function saDeclShapeOk(letIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letKw != "let" { return false }
    if d.letInit < 0 { return false }
    const init = nodeAt(d.letInit)
    if !(init is StrLit) { return false }
    if d.letType >= 0 {
      const ann = nodeAt(d.letType)
      if ann is TypeRef { return ann.tyName == "string" }
      return false
    }
    return true
  }
  false
}

// Count the declaration at `letIx` against its name's row, minting the row if needed.
function saNoteDecl(letIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    const r = saRow(d.letName)
    if r < 0 { return 0 }
    saDecls[r] = saDecls[r] + 1
    if !saDeclShapeOk(letIx) { saBads[r] = 1 }
  }
  0
}

// True if any identifier in the subtree at `ix` spells `name`.
function exprMentionsName(ix: i32, name: string) {
  if ix < 0 { return false }
  const n = nodeAt(ix)
  if n is Ident { return n.identName == name }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      if exprMentionsName(kids[i], name) { return true }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  false
}

// True if `rhsIx` is `name + <parts>` — a maximal string chain whose FIRST part is the
// accumulator itself and none of whose remaining parts mentions it. The second half is
// what keeps the lowering's evaluation order unobservable: the parts run before `name`
// is read, which is only sound while they cannot see or change it.
function saSelfAppendOk(rhsIx: i32, name: string, fnIx: i32) {
  if !exprIsStrConcat(rhsIx, fnIx) { return false }
  const parts: i32[] = []
  strCatParts(rhsIx, fnIx, parts)
  if parts.length < 2 { return false }
  const p0 = nodeAt(parts[0])
  if p0 is Ident {
    if p0.identName != name { return false }
  } else {
    return false
  }
  let i = 1
  while i < parts.length {
    if exprMentionsName(parts[i], name) { return false }
    i = i + 1
  }
  true
}

// The walk. `depth` counts enclosing LOOPS (an accumulator has to earn its buffer in
// one); `inLambda` is set inside a nested `FuncDecl`, where every mentioned name is
// disqualified — a captured local does not live in the slot this lowering writes.
function strAccWalk(ix: i32, fnIx: i32, depth: i32, inLambda: boolean) {
  if ix < 0 { return 0 }
  const n = nodeAt(ix)
  if n is Ident {
    if inLambda { saMarkBad(n.identName) }
    return 0
  }
  if n is FuncDecl {
    strAccWalk(n.fnBody, fnIx, 0, true)
    return 0
  }
  if n is LetDecl {
    if inLambda || (saKnownOnly && !saDeclShapeOk(ix)) {
      saMarkBad(n.letName)
    } else {
      saNoteDecl(ix)
    }
    strAccWalk(n.letInit, fnIx, depth, inLambda)
    return 0
  }
  if n is BinExpr {
    if n.binOp == "=" {
      const t = nodeAt(unwrapParen(n.binLeft))
      if t is Ident {
        if inLambda {
          saMarkBad(t.identName)
        } else if saSelfAppendOk(n.binRight, t.identName, fnIx) {
          if depth > 0 && !(saKnownOnly && saFind(t.identName) < 0) {
            saApps[saRow(t.identName)] = saApps[saRow(t.identName)] + 1
          }
        } else {
          const rhs = nodeAt(n.binRight)
          if !(rhs is StrLit) { saMarkBad(t.identName) }
        }
      }
    }
  }
  if n is WhileStmt {
    strAccWalk(n.whileCond, fnIx, depth, inLambda)
    strAccWalk(n.whileBody, fnIx, depth + 1, inLambda)
    return 0
  }
  if n is ForRange {
    strAccWalk(n.frFrom, fnIx, depth, inLambda)
    strAccWalk(n.frTo, fnIx, depth, inLambda)
    strAccWalk(n.frStep, fnIx, depth, inLambda)
    strAccWalk(n.frBody, fnIx, depth + 1, inLambda)
    return 0
  }
  if n is ForIn {
    strAccWalk(n.fiIter, fnIx, depth, inLambda)
    strAccWalk(n.fiBody, fnIx, depth + 1, inLambda)
    return 0
  }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      strAccWalk(kids[i], fnIx, depth, inLambda)
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

// Prove this function's accumulators. Skipped outright where the function performs no
// string op at all, which is most of them.
function strAccScan(blockIx: i32, fnIx: i32) {
  saNames = []
  saDecls = []
  saApps = []
  saBads = []
  saSites = []
  saFnIx = fnIx
  saKnownOnly = false
  if !fnUsesStrOp { return 0 }
  strAccWalk(blockIx, fnIx, 0, false)
  ssWalk(blockIx, fnIx, 0)
  0
}

// ── the site-cached string append ─────────────────────────────────────────────
// `p = p + parts` or `p = parts + p` in a loop, for a place the proof above does not cover. A
// site's `SB` is the buffer it allocated last and `SE` that buffer's frontier; nothing else writes
// `SB`, so a view ending at `SE` extends in place and any other copies (DECISIONS.md "String building is a lowering").
let saSites: i32[] = []

// True if `a` and `b` spell the same place: one node, or equal non-empty `strPlaceKey`s.
function strSamePlace(a: i32, b: i32): boolean {
  const x = unwrapParen(a)
  const y = unwrapParen(b)
  if x < 0 || y < 0 { return false }
  if x == y { return true }
  const k = strPlaceKey(x)
  k != "" && k == strPlaceKey(y)
}

// A canonical spelling of the place at `ix` — a name, or a field or index chain over one
// keyed by names and literals — or "" when it is not such a place.
function strPlaceKey(ix: i32): string {
  const u = unwrapParen(ix)
  if u < 0 { return "" }
  const n = nodeAt(u)
  match n {
    Ident => {
      return "i" + n.identName
    }
    NumLit => {
      return "n" + n.numText
    }
    StrLit => {
      return "s" + i32ToStr(n.strText.length) + ":" + n.strText
    }
    Member => {
      const o = strPlaceKey(n.memObj)
      if o == "" { return "" }
      return o + "." + n.memProp
    }
    Index => {
      const o = strPlaceKey(n.idxArr)
      const k = strPlaceKey(n.idxIndex)
      if o == "" || k == "" { return "" }
      return o + "[" + k + "]"
    }
    CharLit | BoolLit | NullLit | Unary | BinExpr | Call | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {
      // Not an access chain: two spellings of a call or an operator need not read one place.
      return ""
    }
  }
}

// The place a chain part reads: the part itself, or the left side of a `??` over it.
function strPartPlace(ix: i32): i32 {
  const u = unwrapParen(ix)
  if u < 0 { return -1 }
  const n = nodeAt(u)
  if n is BinExpr {
    if n.binOp == "??" { return n.binLeft }
  }
  u
}

// The site shape of the assignment at `binIx`: 1 an append (the chain's first part reads
// the target), 2 a prepend (its last part does), 0 neither.
function strSiteMode(binIx: i32, fnIx: i32): i32 {
  const a = nodeAt(binIx)
  if a is BinExpr {
    if a.binOp != "=" { return 0 }
    if !exprIsStrConcat(a.binRight, fnIx) { return 0 }
    const parts: i32[] = []
    strCatParts(a.binRight, fnIx, parts)
    if parts.length < 2 { return 0 }
    if strSamePlace(a.binLeft, strPartPlace(parts[0])) { return 1 }
    if strSamePlace(a.binLeft, strPartPlace(parts[parts.length - 1])) {
      return 2
    }
  }
  0
}

// Note every site inside a loop of this body. A nested function is its own body.
function ssWalk(ix: i32, fnIx: i32, depth: i32) {
  if ix < 0 { return 0 }
  const n = nodeAt(ix)
  if n is FuncDecl { return 0 }
  if n is BinExpr {
    if depth > 0 && n.binOp == "=" {
      if strSiteMode(ix, fnIx) > 0 { saSites.push(ix) }
    }
  }
  if n is WhileStmt {
    ssWalk(n.whileCond, fnIx, depth)
    ssWalk(n.whileBody, fnIx, depth + 1)
    return 0
  }
  if n is ForRange {
    ssWalk(n.frBody, fnIx, depth + 1)
    return 0
  }
  if n is ForIn {
    ssWalk(n.fiBody, fnIx, depth + 1)
    return 0
  }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      ssWalk(kids[i], fnIx, depth)
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

// The site mode of the assignment at `binIx` when the scan noted it for this body, else 0.
// Re-derived with the emit-time scope, like `strAccAppendOk`.
function strSiteModeAt(binIx: i32, fnIx: i32): i32 {
  if saFnIx != fnIx { return 0 }
  let i = 0
  while i < saSites.length {
    if saSites[i] == binIx { return strSiteMode(binIx, fnIx) }
    i = i + 1
  }
  0
}

// The chain root `emitStrConcat` lowers as a site, its mode, and the assignment it
// belongs to; -1 when none is armed.
let ssArmRhs = -1
let ssArmMode = 0
let ssArmBin = -1

// Arm the site lowering for the assignment at `binIx`, or disarm it.
function strSiteArm(binIx: i32, fnIx: i32) {
  ssArmRhs = -1
  const mode = strSiteModeAt(binIx, fnIx)
  if mode == 0 { return 0 }
  const a = nodeAt(binIx)
  if a is BinExpr {
    ssArmRhs = a.binRight
    ssArmMode = mode
    ssArmBin = binIx
  }
  0
}

// The site's `SB` local (`liBack` 24, keyed by the assignment node); `SE` is the next
// slot. Minted on first use and reused for the rest of the function.
function strSiteSlot(binIx: i32): i32 {
  let i = 0
  while i < liBack.length {
    if liBack[i] == 24 && liSlots[i] == binIx {
      return listIdxScratchBase + i + 1
    }
    i = i + 1
  }
  liKinds.push("i32")
  liSlots.push(binIx)
  liBack.push(24)
  liKinds.push("i32")
  liSlots.push(binIx)
  liBack.push(25)
  listIdxScratchBase + liKinds.length - 1
}

// Lower an armed site's chain, parts evaluated in the copying lowering's order. `mode` 1
// extends what part 0 read, 2 what the last part read. A miss allocates exact-fit, so a one-off
// append keeps no slack; a full hit doubles, so a loop pays one extra copy and stays linear.
function emitStrSiteCat(
  body: u8[],
  parts: i32[],
  mode: i32,
  binIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const n = parts.length
  let i = 0
  while i < n {
    if emitStrCatOperand(body, parts[i], fnIx, ec, ec) < 0 { return -1 }
    i = i + 1
  }
  let j = n - 1
  while j >= 0 {
    fbLocalSet(strCatSlot(j))
    j = j - 1
  }
  const sb = strSiteSlot(binIx)
  const se = sb + 1
  let acc = 0
  if mode == 2 { acc = n - 1 }
  // I0 = the added length: every part but the accumulator.
  fbI32Const(0)
  let k = 0
  while k < n {
    if k != acc {
      fbLocalGet(strCatSlot(k))
      fbStrLen()
      fbI32Bin(106) // i32.add
    }
    k = k + 1
  }
  fbLocalSet(strScratchBase + 3)
  fbLocalGet(strCatSlot(acc))
  fbStrLen()
  fbLocalSet(strScratchBase + 4) // I1 = the accumulator's length
  fbLocalGet(strCatSlot(acc))
  fbStrStart()
  fbLocalSet(strScratchBase + 6) // I3 = its start
  fbLocalGet(strCatSlot(acc))
  fbStrBack()
  fbLocalSet(strScratchBase + 2) // OUT = its backing
  // I2 = ours: this site's buffer, and a view whose edge is the frontier.
  fbLocalGet(strScratchBase + 2)
  fbLocalGet(sb)
  fbRefEq()
  fbLocalGet(strScratchBase + 6)
  if mode == 1 {
    fbLocalGet(strScratchBase + 4)
    fbI32Bin(106)
  }
  fbLocalGet(se)
  fbI32Bin(70)  // i32.eq
  fbI32Bin(113) // i32.and
  fbLocalSet(strScratchBase + 5)
  // Grow unless ours and the slack on the growing side holds the parts.
  fbLocalGet(strScratchBase + 5)
  if mode == 1 {
    fbLocalGet(strScratchBase + 6)
    fbLocalGet(strScratchBase + 4)
    fbI32Bin(106)
    fbLocalGet(strScratchBase + 3)
    fbI32Bin(106)
    fbLocalGet(strScratchBase + 2)
    fbArrayLen()
    fbI32Bin(76) // i32.le_s
  } else {
    fbLocalGet(strScratchBase + 6)
    fbLocalGet(strScratchBase + 3)
    fbI32Bin(78) // i32.ge_s
  }
  fbI32Bin(113)
  fbI32Eqz()
  fbIf(64) // void
  fbLocalGet(strScratchBase + 2)
  fbLocalSet(strScratchBase + 7) // ABK = the old backing
  fbLocalGet(strScratchBase + 4)
  fbLocalGet(strScratchBase + 3)
  fbI32Bin(106)
  fbI32Const(1)
  fbI32Bin(116)
  fbI32Const(16)
  fbI32Bin(106) // 2 * (len + added) + 16: a full hit doubles
  fbLocalGet(strScratchBase + 4)
  fbLocalGet(strScratchBase + 3)
  fbI32Bin(106) // len + added: a miss is exact-fit
  fbLocalGet(strScratchBase + 5)
  fbSelect()
  fbArrayNewDefault(sBackIdx)
  fbLocalTee(strScratchBase + 2)
  fbLocalSet(sb)
  if mode == 2 {
    // A prepend buffer keeps its value at the END, its slack in front.
    fbLocalGet(strScratchBase + 2)
    fbArrayLen()
    fbLocalGet(strScratchBase + 4)
    fbI32Bin(107) // i32.sub
    fbLocalSet(strScratchBase + 5)
  } else {
    fbI32Const(0)
    fbLocalSet(strScratchBase + 5)
  }
  fbLocalGet(strScratchBase + 2)
  fbLocalGet(strScratchBase + 5)
  fbLocalGet(strScratchBase + 7)
  fbLocalGet(strScratchBase + 6)
  fbLocalGet(strScratchBase + 4)
  fbArrayCopy(sBackIdx, sBackIdx)
  fbLocalGet(strScratchBase + 5)
  fbLocalSet(strScratchBase + 6)
  fbEnd()
  // I3 becomes the result's start and I2 the first write offset; SE the new frontier.
  if mode == 1 {
    fbLocalGet(strScratchBase + 6)
    fbLocalGet(strScratchBase + 4)
    fbI32Bin(106)
    fbLocalTee(strScratchBase + 5)
    fbLocalGet(strScratchBase + 3)
    fbI32Bin(106)
    fbLocalSet(se)
  } else {
    fbLocalGet(strScratchBase + 6)
    fbLocalGet(strScratchBase + 3)
    fbI32Bin(107)
    fbLocalTee(strScratchBase + 6)
    fbLocalTee(strScratchBase + 5)
    fbLocalSet(se)
  }
  let m = 0
  let left = n - 1
  while m < n {
    if m != acc {
      fbLocalGet(strScratchBase + 2)
      fbLocalGet(strScratchBase + 5)
      fbLocalGet(strCatSlot(m))
      fbStrBack()
      fbLocalGet(strCatSlot(m))
      fbStrStart()
      fbLocalGet(strCatSlot(m))
      fbStrLen()
      fbArrayCopy(sBackIdx, sBackIdx)
      left = left - 1
      if left > 0 {
        fbLocalGet(strScratchBase + 5)
        fbLocalGet(strCatSlot(m))
        fbStrLen()
        fbI32Bin(106)
        fbLocalSet(strScratchBase + 5)
      }
    }
    m = m + 1
  }
  fbLocalGet(strScratchBase + 2)
  fbLocalGet(strScratchBase + 6)
  fbLocalGet(strScratchBase + 4)
  fbLocalGet(strScratchBase + 3)
  fbI32Bin(106)
  fbStrNew()
  0
}

// The same proof for the START function, whose accumulator is a module CELL rather than a
// slot. `collectFns` partitions the top level into exactly these three lists and lifts every
// nested function into `fnStmts`, so walking all three is the whole program: a mention inside
// any of them disqualifies the name, which is what makes the cell's one home safe to append into.
export function strAccScanStart() {
  saNames = []
  saDecls = []
  saApps = []
  saBads = []
  saSites = []
  saFnIx = -1
  saKnownOnly = false
  if !fnUsesStrOp { return 0 }
  let si = 0
  while si < startStmts.length {
    ssWalk(startStmts[si], -1, 0)
    si = si + 1
  }
  // Declarations first: a function is HOISTED, so a body assigning to a global can be walked
  // before the global's own `let`, and a mark that arrived before the row would be lost. Only
  // a CANDIDATE mints a row — `saFind` is a linear scan, so one row per top-level binding
  // would make this pass quadratic in the program on its own.
  let i = 0
  while i < globalStmts.length {
    if saDeclShapeOk(globalStmts[i]) { saNoteDecl(globalStmts[i]) }
    i = i + 1
  }
  saPruneSettled()
  if saNames.length == 0 { return 0 }
  saKnownOnly = true
  // A second top-level declaration of a candidate name disqualifies it, whatever its shape.
  i = 0
  while i < globalStmts.length {
    if !saDeclShapeOk(globalStmts[i]) {
      const d = nodeAt(globalStmts[i])
      if d is LetDecl { saMarkBad(d.letName) }
    }
    i = i + 1
  }
  i = 0
  while i < globalStmts.length {
    const g = nodeAt(globalStmts[i])
    if g is LetDecl { strAccWalk(g.letInit, -1, 0, false) }
    i = i + 1
  }
  i = 0
  while i < startStmts.length {
    strAccWalk(startStmts[i], -1, 0, false)
    i = i + 1
  }
  // Every user function is foreign ground. Its CHILDREN are walked rather than the `FuncDecl`
  // itself, so a parameter default mentioning the name disqualifies it like a body would.
  i = 0
  while i < fnStmts.length {
    const kids = nodeChildren(fnStmts[i])
    let k = 0
    while k < kids.length {
      strAccWalk(kids[k], -1, 0, true)
      k = k + 1
    }
    i = i + 1
  }
  saKnownOnly = false
  0
}

// Exactly one declaration, no disqualifying use, and at least one self-append inside a
// loop. The one-declaration rule is what makes the name-keyed answer safe: two bindings
// of one name in a function would share this row.
function saNameQualifies(name: string) {
  let i = 0
  while i < saNames.length {
    if saNames[i] == name {
      return saBads[i] == 0 && saDecls[i] == 1 && saApps[i] > 0
    }
    i = i + 1
  }
  false
}

// Where a proven accumulator lives when it is not a slot: the `globalStmts` position of the
// module cell `name`, or -1. Only at module scope, where `emitStartFnCode` is the emitter.
function saAccGlobalIdx(name: string) {
  if saFnIx != -1 { return -1 }
  globalIndexOf(name)
}

// Read the accumulator. A function local by slot; otherwise the module binding through
// `emitUserGlobalGet`, the storage-class chokepoint, which is also what makes a future
// promotion of this cell follow without a second decision here.
function saAccGet(slot: i32, gIx: i32) {
  if slot >= 0 {
    fbLocalGet(slot)
    return 0
  }
  emitUserGlobalGet(gIx)
}

// The write half of the pair above.
function saAccSet(slot: i32, gIx: i32) {
  if slot >= 0 {
    fbLocalSet(slot)
    return 0
  }
  emitUserGlobalSet(gIx)
}

// Does the assignment at `binIx` append to a proven accumulator? Re-asked per site, with
// the emit-time scope populated, so the scan's answer is a filter and never the whole
// test. `saFnIx` pins the set to the body it is computed for.
function strAccAppendOk(binIx: i32, fnIx: i32) {
  if saFnIx != fnIx { return false }
  if saNames.length == 0 { return false }
  const a = nodeAt(binIx)
  if a is BinExpr {
    const t = nodeAt(unwrapParen(a.binLeft))
    if t is Ident {
      if !saNameQualifies(t.identName) { return false }
      if localIndexOf(fnIx, t.identName) < 0 {
        if saAccGlobalIdx(t.identName) < 0 { return false }
      }
      return saSelfAppendOk(a.binRight, t.identName, fnIx)
    }
  }
  false
}

// `s = s + p1 + … + pk` appended in place: the parts are evaluated and stashed first
// (they cannot mention `s`, so reading the accumulator after them is unobservable), the
// backing grows only when the parts do not fit, then one `array.copy` per part at a
// running offset, then one new header. Borrows the string scratch frame's slots.
function emitStrAccAppend(body: u8[], binIx: i32, fnIx: i32, ec: ExpCtx) {
  const a = nodeAt(binIx)
  if a is BinExpr {
    const t = nodeAt(unwrapParen(a.binLeft))
    if t is Ident {
      const slot = localIndexOf(fnIx, t.identName)
      const gIx = saAccGlobalIdx(t.identName)
      const parts: i32[] = []
      strCatParts(a.binRight, fnIx, parts)
      const n = parts.length
      let i = 1
      while i < n {
        if emitStrCatOperand(body, parts[i], fnIx, ec, ec) < 0 { return -1 }
        i = i + 1
      }
      let j = n - 1
      while j >= 1 {
        fbLocalSet(strCatSlot(j - 1))
        j = j - 1
      }
      fbLocalGet(strCatSlot(0))
      fbStrLen()
      let k = 2
      while k < n {
        fbLocalGet(strCatSlot(k - 1))
        fbStrLen()
        fbI32Bin(106) // i32.add
        k = k + 1
      }
      fbLocalSet(strScratchBase + 3) // I0 = the added length
      saAccGet(slot, gIx)
      fbStrLen()
      fbLocalSet(strScratchBase + 4) // I1 = the current length
      saAccGet(slot, gIx)
      fbStrStart()
      fbLocalSet(strScratchBase + 6) // I3 = the current start
      saAccGet(slot, gIx)
      fbStrBack()
      fbLocalSet(strScratchBase + 2) // OUT = the current backing
      fbLocalGet(strScratchBase + 6)
      fbLocalGet(strScratchBase + 4)
      fbI32Bin(106)
      fbLocalGet(strScratchBase + 3)
      fbI32Bin(106)
      fbLocalGet(strScratchBase + 2)
      fbArrayLen()
      fbI32Bin(74)                   // i32.gt_s — start + len + added past the backing?
      fbIf(64)                       // void
      fbLocalGet(strScratchBase + 2)
      fbLocalSet(strScratchBase + 7) // ABK = the old buffer
      fbLocalGet(strScratchBase + 4)
      fbLocalGet(strScratchBase + 3)
      fbI32Bin(106)
      fbI32Const(1)
      fbI32Bin(116)                  // i32.shl — capacity DOUBLING is what makes the loop linear
      fbI32Const(16)
      fbI32Bin(106)
      fbArrayNewDefault(sBackIdx)
      fbLocalSet(strScratchBase + 2)
      fbLocalGet(strScratchBase + 2)
      fbI32Const(0)
      fbLocalGet(strScratchBase + 7)
      fbLocalGet(strScratchBase + 6)
      fbLocalGet(strScratchBase + 4)
      fbArrayCopy(sBackIdx, sBackIdx)
      fbI32Const(0)
      fbLocalSet(strScratchBase + 6) // the fresh buffer starts at 0
      fbEnd()
      fbLocalGet(strScratchBase + 6)
      fbLocalGet(strScratchBase + 4)
      fbI32Bin(106)
      fbLocalSet(strScratchBase + 5) // I2 = the running destination offset
      let m = 1
      while m < n {
        fbLocalGet(strScratchBase + 2)
        fbLocalGet(strScratchBase + 5)
        fbLocalGet(strCatSlot(m - 1))
        fbStrBack()
        fbLocalGet(strCatSlot(m - 1))
        fbStrStart()
        fbLocalGet(strCatSlot(m - 1))
        fbStrLen()
        fbArrayCopy(sBackIdx, sBackIdx)
        if m + 1 < n {
          fbLocalGet(strScratchBase + 5)
          fbLocalGet(strCatSlot(m - 1))
          fbStrLen()
          fbI32Bin(106)
          fbLocalSet(strScratchBase + 5)
        }
        m = m + 1
      }
      fbLocalGet(strScratchBase + 2)
      fbLocalGet(strScratchBase + 6)
      fbLocalGet(strScratchBase + 4)
      fbLocalGet(strScratchBase + 3)
      fbI32Bin(106)
      fbStrNew()
      saAccSet(slot, gIx)
      return 0
    }
  }
  emitFail("emitProgram: expected a string accumulator append")
}

// Lower a string value-equality `a == b` (or `a != b`) onto `body`, leaving a 0/1 i32:
// element-wise, not ref identity — false if the lengths differ, else loop comparing
// `a[i] == b[i]`, all-equal giving 1. `!=` negates with `i32.eqz`. Lowered as a
// value-typed `block`/`loop` so the compare can `br` out early on a mismatch.
function emitStrEq(body: u8[], binIx: i32, fnIx: i32, ec: ExpCtx) {
  if !aUsed {
    return emitFail("emitProgram: string equality but array type not collected")
  }
  if binIx < 0 { return -1 }
  const e = nodeAt(binIx)
  if e is BinExpr {
    const isNe = e.binOp == "!="
    // A literal-union atom operand widens to its member string first (`emitStrValue`), the
    // boundary `emitStrConcat` applies, so `s == k` (`s: string`, `k: K`) is a string compare
    // rather than the atom `i32.eq`. A quoted-literal operand goes last, to `emitStrEqLit`:
    // string equality is symmetric, and the literal's length is then a constant.
    let litIx = -1
    let valIx = -1
    if strEqLitSideOk(binIx, fnIx) {
      if strLitLenOf(e.binRight) >= 0 {
        litIx = e.binRight
        valIx = e.binLeft
      } else if strLitLenOf(e.binLeft) >= 0 {
        litIx = e.binLeft
        valIx = e.binRight
      }
    }
    if litIx >= 0 {
      if emitStrValue(body, valIx, fnIx, ec) < 0 { return -1 }
      if emitEqRecoverNarrowed(valIx, fnIx) < 0 { return -1 }
      if emitStrEqLit(body, litIx, fnIx, ec) < 0 { return -1 }
    } else {
      if emitStrValue(body, e.binLeft, fnIx, ec) < 0 { return -1 }
      if emitEqRecoverNarrowed(e.binLeft, fnIx) < 0 { return -1 }
      if emitStrValue(body, e.binRight, fnIx, ec) < 0 { return -1 }
      if emitEqRecoverNarrowed(e.binRight, fnIx) < 0 { return -1 }
      if emitEqNonNullCore(body, binIx, fnIx, ec) < 0 { return -1 }
    }
    if isNe {
      fbI32Eqz() // 0x45 i32.eqz  (`!=` negates value-equality)
    }
    return 0
  }
  emitFail("emitProgram: expected a string equality")
}

// Whether string `==` node `binIx` lowers through the plain string core, so a literal operand
// may take `emitStrEqLit` instead of `emitEqNonNullCore`.
function strEqLitSideOk(binIx: i32, fnIx: i32): boolean {
  eqCoreKindOfBin(binIx, fnIx, listOpKindOfBin(binIx, fnIx)) == "str"
}

// Lower a string ordering comparison (`<`/`>`/`<=`/`>=`) onto a 0/1, built on one
// primitive, `emitStrLessCore` ("first operand lexicographically < second"): `A < B`
// is `less(A,B)`, `A > B` is `less(B,A)`, and the `<=`/`>=` forms negate. Each operand is
// pushed as a string value (a literal-union atom widens first) — unwidened, ordering compared interned atom ids instead of the strings, e.g. answering `"b" < "a"` true.
function emitStrOrder(body: u8[], binIx: i32, fnIx: i32, ec: ExpCtx) {
  if !aUsed {
    return emitFail("emitProgram: string ordering but array type not collected")
  }
  if binIx < 0 { return -1 }
  const e = nodeAt(binIx)
  if e is BinExpr {
    const op = e.binOp
    let swap = false
    let neg = false
    if op == ">" {
      swap = true
    } else if op == "<=" {
      swap = true
      neg = true
    } else if op == ">=" {
      neg = true
    } else if op != "<" {
      return emitFail("emitProgram: expected a string ordering operator")
    }
    // Push the core's first arg (lower on stack) then its second arg.
    if swap {
      if emitStrValue(body, e.binRight, fnIx, ec) < 0 { return -1 }
      if emitStrValue(body, e.binLeft, fnIx, ec) < 0 { return -1 }
    } else {
      if emitStrValue(body, e.binLeft, fnIx, ec) < 0 { return -1 }
      if emitStrValue(body, e.binRight, fnIx, ec) < 0 { return -1 }
    }
    if emitStrLessCore(body) < 0 { return -1 }
    if neg {
      fbI32Eqz() // 0x45 i32.eqz — `<=`/`>=` negate the strict-less result
    }
    return 0
  }
  emitFail("emitProgram: expected a string ordering")
}

// The string strict-less core: expects the two string refs already on the stack (first
// below second), leaves 1 iff the first is lexicographically less than the second, else
// 0 — unsigned code-point compare up to the shorter length, first mismatch decides, and a
// prefix relationship makes the shorter string less. Mirrors `emitStrEqCore`'s frame shape.
function emitStrLessCore(body: u8[]) {
  fbLocalSet(strScratchBase + 1) // B (stack top)
  fbLocalSet(strScratchBase + 0) // A
  // Hoist both headers' backing + start BEFORE the block — the element loop below reads
  // both operands once per trip.
  hoistStrScr(body, 0)
  hoistStrScr(body, 1)
  fbBlock(127) // 0x02 block, 0x7f i32 blocktype → the 0/1 result
  // lenA = len(A) ; lenB = len(B) — the HEADER's `len` (field 2), not `array.len`
  pushStrScrRef(body, 0)
  fbStrLen()
  setStrScrI(body, 0) // lenA
  pushStrScrRef(body, 1)
  fbStrLen()
  setStrScrI(body, 1) // lenB
  // n = min(lenA, lenB):  n = lenA ; if lenB < lenA { n = lenB }
  pushStrScrI(body, 0)
  setStrScrI(body, 2)
  pushStrScrI(body, 1)
  pushStrScrI(body, 0)
  fbI32Bin(73)        // 0x49 i32.lt_u (lenB < lenA)
  fbIf(64)            // 0x04 if, void
  pushStrScrI(body, 1)
  setStrScrI(body, 2) // n = lenB
  fbEnd()
  // i = 0
  fbI32Const(0)
  setStrScrI(body, 3)
  // loop { if i >= n {} else { compare; i++; br } }
  fbLoop(64)           // 0x03 loop, void
  pushStrScrI(body, 3) // i
  pushStrScrI(body, 2) // n
  fbI32Bin(78)         // 0x4e i32.ge_s (i >= n → common prefix done)
  fbIf(64)             // then: fall through (empty)
  fbElse()
  // if A[i] != B[i] { push (A[i] <_u B[i]) ; br out of block }
  pushStrScrElem(body, 0, 3) // A[i]
  pushStrScrElem(body, 1, 3) // B[i]
  fbI32Bin(71)               // 0x47 i32.ne
  fbIf(64)
  pushStrScrElem(body, 0, 3) // A[i]
  pushStrScrElem(body, 1, 3) // B[i]
  fbI32Bin(73)               // 0x49 i32.lt_u (A[i] < B[i] → the answer at the first diff)
  fbBr(3)                    // 0x0c br depth 3 → out of: if(0)·else(1)·loop(2)·block(3)
  fbEnd()                    // end (mismatch if)
  // i = i + 1
  pushStrScrI(body, 3)
  fbI32Const(1)
  fbI32Bin(106) // 0x6a i32.add
  setStrScrI(body, 3)
  fbBr(1)       // 0x0c br depth 1 → loop header (else=0, loop=1)
  fbEnd()       // end (ge_s if/else)
  fbEnd()       // end (loop)
  // Common prefix equal → the shorter string is less:  lenA < lenB.
  pushStrScrI(body, 0)
  pushStrScrI(body, 1)
  fbI32Bin(73) // 0x49 i32.lt_u (lenA < lenB)
  fbEnd()      // end (block) — leaves the 0/1 result
  0
}

// The string value-equality core: expects the two string refs already on the stack
// (left below right), leaves the 0/1 result. Shared by `emitStrEq` and the
// struct-equality field compare (which pushes field chains as operands) — one `call`
// into the shared `__str_eq__` helper, emitted once per module.
function emitStrEqCore(_body: u8[]) {
  fbCall(gHelpStrEq)
  0
}

// The byte length of the quoted literal node `ix` spells, or -1 when `ix` is not one.
function strLitLenOf(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const s = nodeAt(ix)
  if s is StrLit {
    const di = if gStrDataLen.length > 0 { gStrDataIx[s.strText] ?? -1 } else { -1 }
    if di >= 0 { return gStrDataLen[di] }
    return cpsToUtf8(decodeStr(strToCps(s.strText))).length
  }
  -1
}

// The longest literal `emitStrEqLit` compares byte by byte in place of calling `__str_eq__`.
const STR_EQ_INLINE_BYTES = 2

// Leave 1 when every byte of the string in the string-op frame's last slot, whose length is
// already known to be `bytes.length`, equals the matching byte of `bytes`, else 0.
function emitStrBytesEq(bytes: i32[]) {
  let k = 0
  while k < bytes.length {
    fbLocalGet(strScratchBase + 11)
    fbStrBack()
    fbLocalGet(strScratchBase + 11)
    fbStrStart()
    if k > 0 {
      fbI32Const(k)
      fbI32Bin(106) // 0x6a i32.add
    }
    fbArrayGet(sBackIdx)
    fbI32Const(bytes[k])
    fbI32Bin(70) // 0x46 i32.eq
    if k > 0 {
      fbI32Bin(113) // 0x71 i32.and
    }
    k = k + 1
  }
  0
}

// Compare the string on the stack with literal node `litIx`, leaving the 0/1 result: a length
// other than the literal's answers 0 without evaluating the literal or calling `__str_eq__`,
// and an empty or short literal is compared in place without the call either.
// The operand waits in the string-op frame's last slot; without that frame it is the bare call.
function emitStrEqLit(body: u8[], litIx: i32, fnIx: i32, ec: ExpCtx) {
  const n = strLitLenOf(litIx)
  if n < 0 || !fnUsesStrOp {
    if emitStrValue(body, litIx, fnIx, ec) < 0 { return -1 }
    return emitStrEqCore(body)
  }
  fbLocalTee(strScratchBase + 11)
  fbStrLen()
  if n == 0 {
    fbI32Eqz()
    return 0
  }
  fbI32Const(n)
  fbI32Bin(70) // 0x46 i32.eq
  fbIf(127)    // if (result i32)
  if n <= STR_EQ_INLINE_BYTES && litIx < P.nodes.length {
    const lit = nodeAt(litIx)
    if lit is StrLit {
      emitStrBytesEq(cpsToUtf8(decodeStr(strToCps(lit.strText))))
      fbElse()
      fbI32Const(0)
      fbEnd()
      return 0
    }
  }
  fbLocalGet(strScratchBase + 11)
  if emitStrValue(body, litIx, fnIx, ec) < 0 { return -1 }
  fbCall(gHelpStrEq)
  fbElse()
  fbI32Const(0)
  fbEnd()
  0
}

// ── list value-equality + concat cores (collections-design §VL.4/§VL.6) ───────
// Each core expects its two list wrapper refs already on the stack (left below right)
// and leaves a 0/1 (equality) or the new wrapper (concat), mirroring `emitStrEqCore`'s
// block/loop/br structure — only the length source (`len`, not `array.len`) and the element compare differ per kind.

// i32-list `==`: length + element compare over the LEQI frame.
function emitListEqICore(_body: u8[]) {
  const bA = leqIScratchBase
  fbLocalSet(bA + 1)       // B
  fbLocalSet(bA + 0)       // A
  fbBlock(127)             // block i32
  fbLocalGet(bA + 0)
  fbStructGet(lTypeIdx, 1) // lenA
  fbLocalSet(bA + 3)       // n = lenA
  fbLocalGet(bA + 3)
  fbLocalGet(bA + 1)
  fbStructGet(lTypeIdx, 1) // lenB
  fbI32Bin(71)             // i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(1)
  fbEnd()
  fbI32Const(0)
  fbLocalSet(bA + 4)       // i = 0
  fbLoop(64)
  fbLocalGet(bA + 4)
  fbLocalGet(bA + 3)
  fbI32Bin(78)             // i >= n → done
  fbIf(64)
  fbElse()
  fbLocalGet(bA + 0)
  fbStructGet(lTypeIdx, 0) // backing A
  fbLocalGet(bA + 4)
  fbArrayGet(aTypeIdx)
  fbLocalGet(bA + 1)
  fbStructGet(lTypeIdx, 0) // backing B
  fbLocalGet(bA + 4)
  fbArrayGet(aTypeIdx)
  fbI32Bin(71)             // element i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(3)                  // mismatch → 0, exit block
  fbEnd()
  fbLocalGet(bA + 4)
  fbI32Const(1)
  fbI32Bin(106)            // i + 1
  fbLocalSet(bA + 4)
  fbBr(1)                  // back to loop
  fbEnd()                  // end (ge_s if/else)
  fbEnd()                  // end (loop)
  fbI32Const(1)
  fbEnd()                  // end (block)
  0
}

// String-list `==`: outer loop over the LEQS frame; each element pair rides
// `emitStrEqCore` (the string-op frame — disjoint locals, safe to nest).
function emitListEqSCore(body: u8[]) {
  const bA = leqSScratchBase
  fbLocalSet(bA + 1)        // B
  fbLocalSet(bA + 0)        // A
  fbBlock(127)              // block i32
  fbLocalGet(bA + 0)
  fbStructGet(mkListIdx, 1) // lenA
  fbLocalSet(bA + 2)        // n
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 1)
  fbStructGet(mkListIdx, 1)
  fbI32Bin(71)              // i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(1)
  fbEnd()
  fbI32Const(0)
  fbLocalSet(bA + 3)        // i = 0
  fbLoop(64)
  fbLocalGet(bA + 3)
  fbLocalGet(bA + 2)
  fbI32Bin(78)
  fbIf(64)
  fbElse()
  // push elem A, elem B (non-null string refs), compare via the string core
  fbLocalGet(bA + 0)
  fbStructGet(mkListIdx, 0)
  fbLocalGet(bA + 3)
  fbArrayGet(mkArrIdx)
  fbRefAsNonNull()
  fbLocalGet(bA + 1)
  fbStructGet(mkListIdx, 0)
  fbLocalGet(bA + 3)
  fbArrayGet(mkArrIdx)
  fbRefAsNonNull()
  if emitStrEqCore(body) < 0 { return -1 }
  fbI32Eqz() // 1 = mismatch
  fbIf(64)
  fbI32Const(0)
  fbBr(3)
  fbEnd()
  fbLocalGet(bA + 3)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(bA + 3)
  fbBr(1)
  fbEnd()
  fbEnd()
  fbI32Const(1)
  fbEnd()
  0
}

// `i32[][]` `==`: outer loop over the slot's LEQR frame; each element pair (two
// inner i32-list wrappers) recurses through `emitListEqICore` (disjoint frame).
function emitListEqRCore(body: u8[], slot: i32, base: i32) {
  fbLocalSet(base + 1) // B
  fbLocalSet(base + 0) // A
  fbBlock(127)         // block i32
  fbLocalGet(base + 0)
  fbStructGet(rlWrapIdx[slot], 1)
  fbLocalSet(base + 2) // n
  fbLocalGet(base + 2)
  fbLocalGet(base + 1)
  fbStructGet(rlWrapIdx[slot], 1)
  fbI32Bin(71)
  fbIf(64)
  fbI32Const(0)
  fbBr(1)
  fbEnd()
  fbI32Const(0)
  fbLocalSet(base + 3) // i = 0
  fbLoop(64)
  fbLocalGet(base + 3)
  fbLocalGet(base + 2)
  fbI32Bin(78)
  fbIf(64)
  fbElse()
  fbLocalGet(base + 0)
  fbStructGet(rlWrapIdx[slot], 0)
  fbLocalGet(base + 3)
  fbArrayGet(rlBackIdx[slot])
  fbRefAsNonNull()
  fbLocalGet(base + 1)
  fbStructGet(rlWrapIdx[slot], 0)
  fbLocalGet(base + 3)
  fbArrayGet(rlBackIdx[slot])
  fbRefAsNonNull()
  if emitListEqICore(body) < 0 { return -1 }
  fbI32Eqz()
  fbIf(64)
  fbI32Const(0)
  fbBr(3)
  fbEnd()
  fbLocalGet(base + 3)
  fbI32Const(1)
  fbI32Bin(106)
  fbLocalSet(base + 3)
  fbBr(1)
  fbEnd()
  fbEnd()
  fbI32Const(1)
  fbEnd()
  0
}

// The reserved LEQR frame base for ref-list slot `slot`, or -1.
function leqRBaseOfSlot(slot: i32) {
  const i = i32ListIndexOf(fnListEqRSlots, slot)
  if i < 0 { return -1 }
  leqRBases[i]
}

// The two locals a STRUCT-element compare parked its element pair in, or -1 outside one.
// Read by `emitChainRead` through the root sentinels -2 / -3; see its header for why the
// value rides here rather than as a parameter.
let eqStashL = -1
let eqStashR = -1

// D1180 — TRUE while a ref-NICHE field's compare runs UNDER its null guard, so every chain
// read of it recovers the non-null ref the leaf core wants. It rides here for the same reason
// the stash pair does: `emitChainRead` is called from a dozen arms and threading a parameter
// through all of them would put the flag at every call site instead of the one that sets it.
let eqChainRecover = false

// The `i32.ne`-class element opcode for a scalar-leaf list rep — the only byte that
// differs between the four wide backings' element compares. Kind 0 covers every rep
// that already is an i32 (boolean, an interned atom, an i32-based literal union) and
// kind 10 (packed u8), since `fbArrayGet` zero-extends the byte before comparing.
function eqgNeOpcode(kind: i32) {
  if kind == LBK_F64_LIST {
    return 98 // 0x62 f64.ne
  }
  if kind == LBK_I64_LIST {
    return 82 // 0x52 i64.ne
  }
  if kind == LBK_F32_LIST {
    return 92 // 0x5c f32.ne
  }
  71 // 0x47 i32.ne
}

// The one entry for a list `==` at rep (kind, slot), with both wrapper refs already on
// the stack (left below right); leaves the 0/1 answer, routing to whichever core owns
// the rep (the three pre-existing cores keep every shape they claim; everything else is
// `emitListEqGCore`). A function, not an inline arm, so a nested compare's recursion has one place to go.
function emitListEqAnyRep(
  body: u8[],
  kind: i32,
  slot: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // A list core starts a fresh chain, so the niche guard's recover must not survive into
  // it (D1291): every read the core makes below is its own, and an `i32` leaf field with
  // a stray `ref.as_non_null` appended is check-clean invalid wasm. The flag names the
  // current chain, so it is cleared for the duration of any core that opens another one.
  const savedRec = eqChainRecover
  eqChainRecover = false
  const r = emitListEqAnyRepAt(body, kind, slot, fnIx, ec)
  eqChainRecover = savedRec
  r
}

function emitListEqAnyRepAt(
  body: u8[],
  kind: i32,
  slot: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if kind == LBK_I32_LIST { return emitListEqICore(body) }
  if kind == LBK_STR_LIST { return emitListEqSCore(body) }
  if kind == LBK_REF {
    if slot >= 0 && slot < rlElemKindTbl.length {
      if rlElemKindTbl[slot] == RLK_I32_LIST {
        const rb = leqRBaseOfSlot(slot)
        if rb < 0 {
          return emitFail("emitProgram: ref-list compare frame not reserved")
        }
        return emitListEqRCore(body, slot, rb)
      }
    }
  }
  emitListEqGCore(body, kind, slot, fnIx, ec)
}

// One element read at index `i` of the staged wrapper in frame slot `bA + which`, left
// on the stack ready for compare: `backing[i]`, plus the non-null recovery a ref element
// needs. Split out because the two operands' reads must interleave with their recoveries
// — a single trailing recover would recover the right operand twice, leaving the left nullable.
function emitEqGElemRead(
  bA: i32,
  which: i32,
  wrap: i32,
  back: i32,
  isRef: boolean,
) {
  fbLocalGet(bA + which)
  fbStructGet(wrap, 0) // the backing
  fbLocalGet(bA + 3)   // i
  fbArrayGet(back)
  if isRef {
    fbRefAsNonNull() // 0xd4
  }
  0
}

// One element pair of a struct-element list, compared field-wise, leaving the 0/1
// equality: read `backing[i]` for each side into a fresh lazy-frame slot, then run the
// ordinary struct compare with those slots as its two roots. The stash globals are saved
// and restored rather than cleared, since a nested list of structs re-enters this from inside an outer `emitListEqGCore` whose own element rung may still be running.
function emitEqGStructElem(body: u8[], slot: i32, fnIx: i32, ec: ExpCtx) {
  if !eqgElemHasEqRow(slot) {
    return emitFail(
      "emitProgram: struct-element compare with no interned shape",
    )
  }
  const row = eqgElemEqRow(slot)
  const sa = listElemStashSlot("ref", slot)
  const sb = listElemStashSlot("ref", slot)
  const bA = leqgBaseOfRep(LBK_REF, slot)
  const wrap = catWrapIdxOf(LBK_REF, slot)
  const back = catBackIdxOf(LBK_REF, slot)
  // A[i] → sa, B[i] → sb. Not `emitEqGElemRead`: these want the RAW nullable element, and
  // the slot they land in is nullable too, so there is no recovery to make.
  fbLocalGet(bA + 0)
  fbStructGet(wrap, 0)
  fbLocalGet(bA + 3)
  fbArrayGet(back)
  fbLocalSet(sa)
  fbLocalGet(bA + 1)
  fbStructGet(wrap, 0)
  fbLocalGet(bA + 3)
  fbArrayGet(back)
  fbLocalSet(sb)
  const savedL = eqStashL
  const savedR = eqStashR
  eqStashL = sa
  eqStashR = sb
  const pathSi: i32[] = []
  const pathFi: i32[] = []
  const r = emitStructEqRec(body, -2, -3, row, pathSi, pathFi, fnIx, ec)
  eqStashL = savedL
  eqStashR = savedR
  r
}

// List `==` over every other list rep: needs an element loop and `eqgElemClass`'s answer
// to "compare two of these" — a scalar leaf, a string leaf, or a nested list (recurse) —
// declining any rep it cannot classify rather than guessing a compare. Each recursion
// level has its own frame keyed on (kind, slot), and a list is never its own element, which is what makes the recursion safe.
function emitListEqGCore(
  body: u8[],
  kind: i32,
  slot: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const bA = leqgBaseOfRep(kind, slot)
  if bA < 0 {
    // The scan and the emitter read ONE home (`eqgListKindOfBin` / `eqgElemClass`), so a
    // missing frame is a desync rather than a program property — loud, never a write into
    // a local the function never declared.
    return emitFail(
      "emitProgram: list compare frame was not reserved for this rep",
    )
  }
  const cls = eqgElemClass(kind, slot)
  if cls == "none" {
    return emitFail(
      "emitProgram: list compare over an element rep with no core",
    )
  }
  const wrap = catWrapIdxOf(kind, slot)
  const back = catBackIdxOf(kind, slot)
  const isRef = cls != "scalar"
  fbLocalSet(bA + 1)   // B
  fbLocalSet(bA + 0)   // A
  fbBlock(127)         // block i32
  fbLocalGet(bA + 0)
  fbStructGet(wrap, 1) // lenA
  fbLocalSet(bA + 2)   // n = lenA
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 1)
  fbStructGet(wrap, 1) // lenB
  fbI32Bin(71)         // 0x47 i32.ne
  fbIf(64)
  fbI32Const(0)
  fbBr(1)
  fbEnd()
  fbI32Const(0)
  fbLocalSet(bA + 3)   // i = 0
  fbLoop(64)
  fbLocalGet(bA + 3)
  fbLocalGet(bA + 2)
  fbI32Bin(78)         // 0x4e i32.ge_s — i >= n → done
  fbIf(64)
  fbElse()
  if cls != "struct" {
    if emitEqGElemRead(bA, 0, wrap, back, isRef) < 0 { return -1 }
    if emitEqGElemRead(bA, 1, wrap, back, isRef) < 0 { return -1 }
  }
  match cls {
    "struct" => {
      // A struct element, compared field-wise off two stashed locals. The pair is parked
      // rather than left on the stack because `emitStructEqRec` re-reads each root once per
      // field, and a `(ref null <elem heap>)` slot would trap `struct.get` on null —
      // `eqgElemClass` claims only the non-nullable struct element kind, so it never does.
      if emitEqGStructElem(body, slot, fnIx, ec) < 0 { return -1 }
      fbI32Eqz() // the compare leaves EQUALITY; the branch below tests MISMATCH
    }
    // A recursive record element, through its minted compare function, which leaves EQUALITY.
    "call" => {
      fbCall(gImports + eqgCoreFeOfSlot(slot))
      fbI32Eqz() // 0x45
    }
    "scalar" => {
      // Two scalar leaves: one opcode, and it leaves the MISMATCH the branch below tests.
      wU8(eqgNeOpcode(kind))
    }
    // A REF leaf — a string or an inner list — through its own core, which leaves
    // EQUALITY; the branch below tests mismatch, so negate once.
    "string" => {
      if emitStrEqCore(body) < 0 { return -1 }
      fbI32Eqz() // 0x45
    }
    "list" => {
      if (
        emitListEqAnyRep(body, eqgInnerKind(slot), eqgInnerSlot(slot), fnIx, ec)
        < 0
      ) {
        return -1
      }
      fbI32Eqz() // 0x45
    }
  }
  fbIf(64)
  fbI32Const(0)
  fbBr(3)       // mismatch → 0, exit the block
  fbEnd()
  fbLocalGet(bA + 3)
  fbI32Const(1)
  fbI32Bin(106) // i + 1
  fbLocalSet(bA + 3)
  fbBr(1)       // back to the loop header
  fbEnd()       // end (ge_s if/else)
  fbEnd()       // end (loop)
  fbI32Const(1)
  fbEnd()       // end (block)
  0
}

// The reserved LEQG frame base for compare rep `(kind, slot)`, or -1, over the pair the
// reservation scan pushed.
function leqgBaseOfRep(kind: i32, slot: i32) {
  const i = i32PairIndexOf(fnListEqGKinds, fnListEqGSlots, kind, slot)
  if i < 0 { return -1 }
  leqgBases[i]
}

// i32-list CONCAT `a + b`: a NEW list sized exactly lenA + lenB (one backing
// allocation, two bulk `array.copy`s) — the host's §VL.4 lowering. Both operands
// are evaluated onto the stack before either is stored into the shared LEQI frame, so
// a concat nested in the right operand cannot overwrite A (D2331).
function emitListConcatI(
  body: u8[],
  leftIx: i32,
  rightIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const bA = leqIScratchBase
  if emitExpr(body, leftIx, fnIx, ec) < 0 { return -1 }
  // A NARROWED nullable-list operand (`i32[] | null`, kind 15) keeps its nullable
  // slot; the LEQI scratch slot is non-null, so recover before the store (the
  // checker proved the operand guarded — the cast can never trap).
  if exprNullableList(leftIx, fnIx) { fbRefAsNonNull() }
  if emitExpr(body, rightIx, fnIx, ec) < 0 { return -1 }
  if exprNullableList(rightIx, fnIx) { fbRefAsNonNull() }
  fbLocalSet(bA + 1)       // B
  fbLocalSet(bA + 0)       // A
  fbLocalGet(bA + 0)
  fbStructGet(lTypeIdx, 1) // lenA
  fbLocalGet(bA + 1)
  fbStructGet(lTypeIdx, 1) // lenB
  fbI32Bin(106)            // i32.add
  fbLocalSet(bA + 3)       // n = lenA + lenB
  fbLocalGet(bA + 3)
  fbArrayNewDefault(aTypeIdx)
  fbLocalSet(bA + 2)       // out backing
  // array.copy out 0 backingA 0 lenA
  fbLocalGet(bA + 2)
  fbI32Const(0)
  fbLocalGet(bA + 0)
  fbStructGet(lTypeIdx, 0)
  fbI32Const(0)
  fbLocalGet(bA + 0)
  fbStructGet(lTypeIdx, 1)
  fbArrayCopy(aTypeIdx, aTypeIdx)
  // array.copy out lenA backingB 0 lenB
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 0)
  fbStructGet(lTypeIdx, 1)
  fbLocalGet(bA + 1)
  fbStructGet(lTypeIdx, 0)
  fbI32Const(0)
  fbLocalGet(bA + 1)
  fbStructGet(lTypeIdx, 1)
  fbArrayCopy(aTypeIdx, aTypeIdx)
  // the result wrapper { out, n, n }
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 3)
  fbLocalGet(bA + 3)
  fbStructNew(lTypeIdx)
  0
}

// List concat over every other list rep — the rep-parameterised twin of `emitListConcatI`,
// instruction for instruction: one backing allocation sized `lenA + lenB`, two
// `array.copy`s, one wrapper. A second function rather than a parameter on the first
// because the i32 list stages operands in the LEQI frame and every other rep in its own LCAT frame — different slot types, not just a different base.
function emitListConcatG(
  body: u8[],
  leftIx: i32,
  rightIx: i32,
  fnIx: i32,
  kind: i32,
  slot: i32,
  widen: i32,
  ec: ExpCtx,
) {
  const bA = lcatBaseOfRep(kind, slot)
  if bA < 0 {
    // The scan and the emitter read ONE home (`catListKindOfBin`), so a missing frame is
    // a desync rather than a program property — loud, never a write into a local the
    // function never declared.
    return emitFail(
      "emitProgram: list concat frame was not reserved for this rep",
    )
  }
  const wrap = catWrapIdxOf(kind, slot)
  const back = catBackIdxOf(kind, slot)
  // Both operands reach the stack before the frame is written: the frame is shared per
  // rep, so a concat nested in the right operand would otherwise overwrite A (D2331).
  if emitCatOperand(body, leftIx, fnIx, kind, slot, widen == 1, ec) < 0 {
    return -1
  }
  if emitCatOperand(body, rightIx, fnIx, kind, slot, widen == 2, ec) < 0 {
    return -1
  }
  fbLocalSet(bA + 1)   // B
  fbLocalSet(bA + 0)   // A
  fbLocalGet(bA + 0)
  fbStructGet(wrap, 1) // lenA
  fbLocalGet(bA + 1)
  fbStructGet(wrap, 1) // lenB
  fbI32Bin(106)        // i32.add
  fbLocalSet(bA + 3)   // n = lenA + lenB
  fbLocalGet(bA + 3)
  fbArrayNewDefault(back)
  fbLocalSet(bA + 2)   // out backing
  // array.copy out 0 backingA 0 lenA
  fbLocalGet(bA + 2)
  fbI32Const(0)
  fbLocalGet(bA + 0)
  fbStructGet(wrap, 0)
  fbI32Const(0)
  fbLocalGet(bA + 0)
  fbStructGet(wrap, 1)
  fbArrayCopy(back, back)
  // array.copy out lenA backingB 0 lenB
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 0)
  fbStructGet(wrap, 1)
  fbLocalGet(bA + 1)
  fbStructGet(wrap, 0)
  fbI32Const(0)
  fbLocalGet(bA + 1)
  fbStructGet(wrap, 1)
  fbArrayCopy(back, back)
  // the result wrapper { out, n, n }
  fbLocalGet(bA + 2)
  fbLocalGet(bA + 3)
  fbLocalGet(bA + 3)
  fbStructNew(wrap)
  0
}

// One operand of `emitListConcatG`, left on the stack at concat rep `(kind, slot)`. A `widen`
// operand is of the narrower rep (`catWidenSideOfBin`) and is copied into the concat's: boxed
// into a union-box row as a spread group is, or converted element-wise for a scalar list.
function emitCatOperand(
  body: u8[],
  opIx: i32,
  fnIx: i32,
  kind: i32,
  slot: i32,
  widen: boolean,
  ec: ExpCtx,
) {
  if widen && kind == LBK_REF {
    return emitSpreadGroupBoxed(body, opIx, true, slot, fnIx, ec)
  }
  if widen {
    const sk = mfRecvKindOf(opIx, fnIx)
    let dk: VKind | null = null
    if kind == LBK_F64_LIST { dk = "f64" }
    if kind == LBK_I64_LIST { dk = "i64" }
    if sk == null || dk == null {
      return emitFailAt(
        "emitProgram: a list `+` widening reached an operand `catWidenSideOfBin` does not admit",
        opIx,
      )
    }
    if emitSpreadGroup(body, opIx, fnIx, pendingKindOfMf(sk, 0), 0, ec) < 0 {
      return -1
    }
    if emitEqRecoverNarrowed(opIx, fnIx) < 0 { return -1 }
    svSyncRecv(opIx, fnIx)
    return emitScalarListWidenTop(body, spreadScalarVKind(sk), dk)
  }
  if emitExpr(body, opIx, fnIx, ec) < 0 { return -1 }
  // A NARROWED nullable operand's cell still holds a `(ref null …)` while the frame slot
  // is non-null — the same recovery the compare cores make, off the same one home.
  if emitEqRecoverNarrowed(opIx, fnIx) < 0 { return -1 }
  svSyncRecv(opIx, fnIx)
  0
}

// The reserved LCAT frame base for concat rep `(kind, slot)`, or -1, over the pair the
// reservation scan pushed.
function lcatBaseOfRep(kind: i32, slot: i32) {
  const i = i32PairIndexOf(fnListCatKinds, fnListCatSlots, kind, slot)
  if i < 0 { return -1 }
  lcatBases[i]
}

// Re-evaluate the field access chain `root.f1.f2…` onto `body`: the root expression, then
// one `struct.get` per (row, field) pair — a pure re-read, since the equality compare
// re-walks chains per field. Root indices -2/-3 are sentinels naming the two locals
// `emitListEqGCore` stashed a list element pair in, letting a struct compare run inside a list loop without threading that pair through every call site as a parameter.
function emitChainRead(
  body: u8[],
  rootIx: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
  ec: ExpCtx,
) {
  if rootIx == -2 || rootIx == -3 {
    let stash = eqStashL
    if rootIx == -3 { stash = eqStashR }
    if stash < 0 {
      return emitFail(
        "emitProgram: struct-element compare with no stashed root",
      )
    }
    fbLocalGet(stash)
    let sk = 0
    while sk < pathSi.length {
      fbStructGet(eqRowHeapIdx(pathSi[sk]), pathFi[sk])
      sk = sk + 1
    }
    if eqChainRecover { fbRefAsNonNull() }
    return 0
  }
  if emitExpr(body, rootIx, fnIx, ec) < 0 { return -1 }
  let k = 0
  while k < pathSi.length {
    fbStructGet(eqRowHeapIdx(pathSi[k]), pathFi[k]) // 0xfb 0x02 <ht> <field>
    k = k + 1
  }
  if eqChainRecover { fbRefAsNonNull() }
  0
}

// Compare two closure fat-pointers already on the stack (left below right), leaving a
// 0/1 i32 for function identity: the same source declaration (field 2) and the same
// captured env (`ref.eq` over field 0 — two null envs are equal, two separately created
// envs of the same function are not).
function emitCloEqCore(_body: u8[]) {
  fbLocalSet(cloEqScratchBase + 1) // B = right operand
  fbLocalSet(cloEqScratchBase + 0) // A = left operand
  fbLocalGet(cloEqScratchBase + 0)
  fbStructGet(cloStructIdx, 2)     // A.decl
  fbLocalGet(cloEqScratchBase + 1)
  fbStructGet(cloStructIdx, 2)     // B.decl
  fbI32Bin(70)                     // 0x46 i32.eq
  fbLocalGet(cloEqScratchBase + 0)
  fbStructGet(cloStructIdx, 0)     // A.env
  fbLocalGet(cloEqScratchBase + 1)
  fbStructGet(cloStructIdx, 0)     // B.env
  fbRefEq()                        // (null == null → 1)
  fbI32Bin(113)                    // 0x71 i32.and
  0
}

// The one core-selection ladder for a `==`/`!=` whose two operands are already on the
// stack as non-null refs. Leaves the 0/1 equality answer, never the negation — `!=`
// belongs to the caller. Shared by the plain compare paths and `emitNulNicheEq`, so a rep
// the plain compare handles is a rep the nullable form handles by construction — two ladders is how the two drift apart.
function emitEqNonNullCore(body: u8[], binIx: i32, fnIx: i32, ec: ExpCtx) {
  const e = nodeAt(binIx)
  if e is BinExpr {
    // One ask, threaded into both users below — the `coreK == 7` arm's own generic-rep
    // question re-derives it otherwise, on the same node.
    const eqLop = listOpKindOfBin(binIx, fnIx)
    const coreK = eqCoreKindOfBin(binIx, fnIx, eqLop)
    match coreK {
      "i32list" => {
        return emitListEqICore(body)
      }
      "strlist" => {
        return emitListEqSCore(body)
      }
      "reflist" => {
        let lslot = refListSlotOfExpr(e.binLeft, fnIx)
        if lslot < 0 { lslot = refListSlotOfExpr(e.binRight, fnIx) }
        const lbase = leqRBaseOfSlot(lslot)
        if lbase < 0 {
          return emitFail("emitProgram: ref-list compare frame not reserved")
        }
        return emitListEqRCore(body, lslot, lbase)
      }
      "str" => {
        return emitStrEqCore(body)
      }
      "closure" => {
        return emitCloEqCore(body)
      }
      "glist" => {
        return emitListEqAnyRep(
          body,
          eqgListKindOfBin(binIx, fnIx, eqLop),
          listOpSlotOfBin(binIx, fnIx),
          fnIx,
          ec,
        )
      }
      "none" => {
        return emitFail(
          "emitProgram: `"
            + e.binOp
            + "` over this operand rep has no compare core",
        )
      }
    }
  }
  emitFail("emitProgram: expected a `==`/`!=` for the compare core")
}

// One raw read of a nullable-niche `==` operand — never `ref.as_non_null`, because the
// guard around it exists precisely to see the null this rep can hold (a `string | null`
// ident otherwise recovers itself and traps on the value the guard answers for). A
// literal-union atom operand still widens to its member string first, as `emitStrEq` does.
function emitEqOperandRaw(body: u8[], ix: i32, fnIx: i32, ec: ExpCtx) {
  if exprIsLitAtom(ix, fnIx) { return emitStrValue(body, ix, fnIx, ec) }
  const rawCtx = expCtxHere(ec)
  rawCtx.rawNullRead = true
  emitExprExpect(body, ix, fnIx, rawCtx)
}

// A narrowed nullable-niche operand's cell still holds a `(ref null …)`, and every compare
// core's frame slot demands the non-null ref, so a plain (unguarded) compare recovers its
// operands exactly as `for`-in, `.slice` and the member ops do — safe because the checker
// proved the read guarded. A genuinely-nullable operand never arrives here: `binEqNulNiche` claims it off the checker's banked type and the guard reads it raw.
function emitEqRecoverNarrowed(exprIx: i32, fnIx: i32) {
  if nulRecvNeedsRecover(exprIx, fnIx) || exprNulClosure(exprIx, fnIx) {
    fbRefAsNonNull() // 0xd4 ref.as_non_null
  }
  0
}

// "Is this `==` operand null" — the shared ladder's answer for a nullable operand, a constant 0
// for a non-nullable one (the MIXED pairing `S | null == S`). Never a hand-rolled
// `ref.is_null`: `emitNulIsNullTest` is the one home for the null test of every rep and its
// header carries why.
function emitEqIsNull(body: u8[], ix: i32, fnIx: i32, ec: ExpCtx) {
  const claimed = emitNulIsNullTest(body, ix, fnIx, false, false, ec)
  if claimed < 0 { return -1 }
  if claimed > 0 { return 0 }
  fbI32Const(0)
  0
}

// A `==`/`!=` where at least one operand is a nullable ref niche, lowered as the rep's own
// compare under a null guard: `null == null` is true, `null == v` false, and the
// non-null half runs the rep's existing core unchanged. `br_on_null` consumes the ref it
// tests, so the right operand's code is emitted twice but exactly one path runs at runtime, evaluating each operand exactly once.
function emitNulNicheEq(
  body: u8[],
  binIx: i32,
  fnIx: i32,
  niche: EqCmpKind,
  ec: ExpCtx,
) {
  const e = nodeAt(binIx)
  if e is BinExpr {
    if niche == "nulstruct" { return emitNulStructEq(body, binIx, fnIx, ec) }
    fbBlock(127) // block i32 — $out, the 0/1 answer
    fbBlock(64) // block void — $onenull
    fbBlock(64) // block void — $lnull
    if emitEqOperandRaw(body, e.binLeft, fnIx, ec) < 0 { return -1 }
    fbBrOnNull(0) // → $lnull; on non-null leaves (ref $rep)
    if emitEqOperandRaw(body, e.binRight, fnIx, ec) < 0 { return -1 }
    fbBrOnNull(1) // → $onenull (unwinding past the left ref, which needs no drop)
    if emitEqNonNullCore(body, binIx, fnIx, ec) < 0 { return -1 }
    fbBr(2) // → $out
    fbEnd()
    if emitEqOperandRaw(body, e.binRight, fnIx, ec) < 0 { return -1 }
    fbRefIsNull() // both null ⇒ equal
    fbBr(1) // → $out
    fbEnd()
    fbI32Const(0)
    fbEnd()
    return 0
  }
  emitFail("emitProgram: expected a `==`/`!=` over a nullable niche")
}

// The `nulstruct` arm of `emitNulNicheEq`. The struct core is RE-READ based by contract
// (`emitStructEq`: both operands must be pure re-reads, because every field compare
// re-evaluates the full chain from its root), so there is no single-evaluation form to preserve
// and the guard is spelled as two null TESTS instead of the `br_on_null` consume.
function emitNulStructEq(body: u8[], binIx: i32, fnIx: i32, ec: ExpCtx) {
  const e = nodeAt(binIx)
  if e is BinExpr {
    // Asks the same two namespaces as the non-null dispatch, in the same order (niche rung
    // first) — asking only the struct one is how the nullable half drifts out of the
    // non-null half's capability. `siFound` is load-bearing, not decoration: an eq row is
    // `>= 0` for a struct and `< 0` for a variant, so `-1` is variant row 0 and cannot double as "no answer".
    let si = -1
    let siFound = false
    const nvi = binEqNulVariantRow(binIx, fnIx)
    if nvi >= 0 {
      si = eqRowOfVariant(nvi)
      siFound = true
    }
    if !siFound {
      const nsSi = structIndexOfExpr(e.binLeft, fnIx)
      if nsSi >= 0 {
        si = nsSi
        siFound = true
      }
    }
    if !siFound {
      return emitFail("emitProgram: struct equality over a non-struct operand")
    }
    fbBlock(127) // block i32 — $out
    if emitEqIsNull(body, e.binLeft, fnIx, ec) < 0 { return -1 }
    if emitEqIsNull(body, e.binRight, fnIx, ec) < 0 { return -1 }
    fbI32Bin(71) // 0x47 i32.ne — the two sides disagree on nullness
    fbIf(64)
    fbI32Const(0)
    fbBr(1) // → $out
    fbEnd()
    if emitEqIsNull(body, e.binLeft, fnIx, ec) < 0 { return -1 }
    fbIf(64)
    fbI32Const(1) // both null ⇒ equal
    fbBr(1) // → $out
    fbEnd()
    const pathSi: i32[] = []
    const pathFi: i32[] = []
    if (
      emitStructEqRec(body, e.binLeft, e.binRight, si, pathSi, pathFi, fnIx, ec)
      < 0
    ) {
      return -1
    }
    fbEnd()
    return 0
  }
  emitFail("emitProgram: expected a nullable-struct equality")
}

// True for the `eqCmpKindOfTy` tokens that name a nullable ref niche — the ones whose
// compare needs `emitNulNicheEq`'s guard. The box- and sentinel-repped nullables answer ""
// from that function and are deliberately not here: they already compare tag-first correctly.
function eqKindIsNulNiche(k: EqCmpKind) {
  k == "nulstr"
    || k == "nullist"
    || k == "nulstrlist"
    || k == "nulreflist"
    || k == "nulglist"
    || k == "nulstruct"
    || k == "nulclosure"
}

// The nullable-niche token for this `==`/`!=`, or "" when neither operand is one. Reads
// the checker's banked type, which makes a narrowed operand fall out for free (inside
// `if a != null { a == b }` the banked type is already non-null); a bare `null` operand is
// excluded (owned by `emitNulIsNullTest`). Inside a monomorphized instance the banked type is a shared type variable instead, so `exprNulNicheKind`'s `fnIx`-scoped resolution answers there (D42).
function binEqNulNiche(binIx: i32, fnIx: i32): EqCmpKind {
  const e = nodeAt(binIx)
  if e is BinExpr {
    if e.binOp == "==" || e.binOp == "!=" {
      if nodeAt(unwrapParen(e.binLeft)) is NullLit { return "" }
      if nodeAt(unwrapParen(e.binRight)) is NullLit { return "" }
      const lk = eqCmpKindOfOperand(e.binLeft, fnIx)
      if eqKindIsNulNiche(lk) { return lk }
      const rk = eqCmpKindOfOperand(e.binRight, fnIx)
      if eqKindIsNulNiche(rk) { return rk }
    }
  }
  ""
}

// The emitter's half of the ONE comparability answer: true when a `==`/`!=` operand's rep has
// NO compare core. The checker rejects these (`unsupported-lowering`, off the same
// `eqCmpKindOfTy`), so this is the FLOOR — unreachable from accepted source, and the difference
// between a loud `emitProgram:` failure and the i32 tail emitting `i32.eq` over two refs.
function binEqHasNoLowering(binIx: i32) {
  const e = nodeAt(binIx)
  if e is BinExpr {
    if nodeAt(unwrapParen(e.binLeft)) is NullLit { return false }
    if nodeAt(unwrapParen(e.binRight)) is NullLit { return false }
    return nodeEqCmpKind(e.binLeft) == "none"
      || nodeEqCmpKind(e.binRight) == "none"
  }
  false
}

// The generic list compare's floor: true when the checker accepted the program on the
// generic core (`eqCmpKindOfTy` answered `glist`/`nulglist`) but the emitter cannot name
// the rep — an unresolved ref-list slot, operands at different slots, or the rep tables
// disagreeing with the arena about the element. Same shape and reason as `binConcatRepUnresolved` (D721): without it the fall-through is a silent `i32.eq` over two refs.
function binEqGRepUnresolved(binIx: i32, fnIx: i32) {
  const e = nodeAt(binIx)
  if e is BinExpr {
    if e.binOp != "==" && e.binOp != "!=" { return false }
    if nodeAt(unwrapParen(e.binLeft)) is NullLit { return false }
    if nodeAt(unwrapParen(e.binRight)) is NullLit { return false }
    // True only on the conjunction: the types say "two lists" and the rep side cannot name
    // their pair. Reads the banked types, not `nodeEqCmpKind` (D42), because inside a
    // monomorphized instance the operand nodes share the generic template — the banked
    // type is `T[]` (still a `TyArray`) where the token question goes blind ("").
    if (
      !binPlusIsListByTy(nodeTyAt(e.binLeft, fnIx), nodeTyAt(e.binRight, fnIx))
    ) {
      const tl = eqCoreKindOfTyToken(nodeEqCmpKind(e.binLeft))
      const tr = eqCoreKindOfTyToken(nodeEqCmpKind(e.binRight))
      if tl != "glist" && tr != "glist" { return false }
    }
    // A core's claim on the pair is trusted only when the rep-home classifier
    // (`catListKindOfExpr`) agrees which rep this is: `listOpKindOf` picks among only the
    // three old cores, so it can silently misclassify an unhandled rep (an `i64[]` falling
    // through to the i32 core) — a claim it cannot corroborate is not a claim. Reads zero on today's tree (D755) but guards the next rep added to one ladder and not the other.
    const lop = listOpKindOfBin(binIx, fnIx)
    if lop != "none" {
      const ck = catListKindOfExpr(e.binLeft, fnIx)
      if ck >= 0 {
        // the i32 list, the string list, and a ref list of i32 lists.
        if lop == "i32list" && ck != LBK_I32_LIST { return true }
        if lop == "strlist" && ck != LBK_STR_LIST { return true }
        if lop == "reflist" && ck != LBK_REF { return true }
      }
      return false
    }
    if eqgListKindOfBin(binIx, fnIx, lop) >= 0 { return false }
    // A nullable niche runs the rep's own core under a guard, so a niche the guard claims
    // is a compare that already has one.
    if binEqNulNiche(binIx, fnIx) != "" { return false }
    return true
  }
  false
}

// The `+` twin of `binEqHasNoLowering` (D721): true when the checker's banked types say
// this `+` is a list concat and the emitter cannot resolve the pair to one (wrapper,
// backing) rep — different ref-list slots, or no list rep at all. Reads the banked types
// too, since `catListKindOfBin` answering -1 alone is not evidence of a list; only the conjunction is a failure, since an unguarded numeric tail would otherwise emit `i32.add` over two refs.
function binConcatRepUnresolved(binIx: i32, fnIx: i32) {
  const e = nodeAt(binIx)
  if e is BinExpr {
    if e.binOp != "+" { return false }
    if (
      !binPlusIsListByTy(nodeTyAt(e.binLeft, fnIx), nodeTyAt(e.binRight, fnIx))
    ) {
      return false
    }
    return catListKindOfBin(binIx, fnIx) < 0
  }
  false
}

// Lower a structural struct equality `a == b` (or `!=`) onto `body`, leaving a 0/1 i32:
// field-wise compare mirroring the host's `valueEq`. Both operands must be pure re-reads
// (names / field chains), since every field compare re-evaluates the full chain from its
// root. Takes `row` rather than re-deriving it — the caller already asked both namespaces (struct and variant) and knows which answered; re-asking loses that (`structIndexOfExpr` alone answers -1 for a variant operand).
function emitStructEq(body: u8[], binIx: i32, fnIx: i32, row: i32, ec: ExpCtx) {
  const e = nodeAt(binIx)
  if e is BinExpr {
    const pathSi: i32[] = []
    const pathFi: i32[] = []
    if (
      emitStructEqRec(
        body,
        e.binLeft,
        e.binRight,
        row,
        pathSi,
        pathFi,
        fnIx,
        ec,
      )
      < 0
    ) {
      return -1
    }
    if e.binOp == "!=" {
      fbI32Eqz() // 0x45 i32.eqz — negate value-equality
    }
    return 0
  }
  emitFail("emitProgram: expected a struct equality")
}

// One shape's field-wise compare at path (`pathSi`/`pathFi` from the roots), leaving 0/1:
// an and-chain of per-field compares lowered as nested value-typed `if`s, so a first
// mismatch short-circuits. `si` is an eq row (`eqRowOfVariant`), so one core serves a
// standalone struct and a union arm alike — the two differ only in which table holds the layout.
function emitStructEqRec(
  body: u8[],
  lRoot: i32,
  rRoot: i32,
  si: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
  ec: ExpCtx,
) {
  const cnt = eqRowFieldCount(si)
  if cnt == 0 {
    fbI32Const(1)
    return 0
  }
  let fi = 0
  while fi < cnt {
    if (
      emitStructEqField(body, lRoot, rRoot, si, fi, pathSi, pathFi, fnIx, ec)
      < 0
    ) {
      return -1
    }
    if fi < cnt - 1 {
      fbIf(127) // 0x04 if, 0x7f i32 blocktype — chain the next field
    }
    fi = fi + 1
  }
  // Close the chain: each opened `if` gets `else (i32.const 0) end`.
  let k = cnt - 1
  while k > 0 {
    fbElse() // 0x05 else
    fbI32Const(0)
    fbEnd()  // 0x0b end
    k = k - 1
  }
  0
}

// Compare ONE field at (si, fi) across the two chains, leaving 0/1. The path
// push/pop frames the inner compare so chains rewind for the next sibling field.
function emitStructEqField(
  body: u8[],
  lRoot: i32,
  rRoot: i32,
  si: i32,
  fi: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
  ec: ExpCtx,
) {
  pathSi.push(si)
  pathFi.push(fi)
  const r = emitStructEqFieldInner(
    body,
    lRoot,
    rRoot,
    si,
    fi,
    pathSi,
    pathFi,
    fnIx,
    ec,
  )
  pathSi.pop()
  pathFi.pop()
  r
}

// `L.f == R.f` for a ref-niche field: `null == null` true, one side null false, else the
// non-null code's own core. Two null tests rather than `br_on_null`, since every inner arm
// re-reads its chain from the root. Opens the guard and leaves the both-non-null branch
// open for the caller to fill; paired with `emitNulFieldGuardClose`, split so leaf cores and the code-15 recursion can share one guard while differing on chain-read recovery.
function emitNulFieldGuardOpen(
  body: u8[],
  lRoot: i32,
  rRoot: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitChainRead(body, lRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
  fbRefIsNull()
  fbIf(127)     // 0x04 if, 0x7f i32 blocktype — the left field was null
  if emitChainRead(body, rRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
  fbRefIsNull() // both null ⇒ equal
  fbElse()
  if emitChainRead(body, rRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
  fbRefIsNull()
  fbIf(127)
  fbI32Const(0) // exactly one side null
  fbElse()
  0
}

function emitNulFieldGuardClose() {
  fbEnd()
  fbEnd()
  0
}

function emitNulFieldEq(
  body: u8[],
  lRoot: i32,
  rRoot: i32,
  si: i32,
  fi: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
  inner: i32,
  ec: ExpCtx,
) {
  if emitNulFieldGuardOpen(body, lRoot, rRoot, pathSi, pathFi, fnIx, ec) < 0 {
    return -1
  }
  // Both sides non-null: the leaf core wants `(ref $H)`, and only the guard knows that.
  const savedRec = eqChainRecover
  eqChainRecover = true
  const ir = emitStructEqFieldAt(
    body,
    lRoot,
    rRoot,
    si,
    fi,
    pathSi,
    pathFi,
    fnIx,
    inner,
    ec,
  )
  eqChainRecover = savedRec
  if ir < 0 { return -1 }
  emitNulFieldGuardClose()
}

function emitStructEqFieldInner(
  body: u8[],
  lRoot: i32,
  rRoot: i32,
  si: i32,
  fi: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
  ec: ExpCtx,
) {
  const code = eqRowFieldTypeAt(si, fi)
  const nulInner = nulFieldInnerCode(code)
  if nulInner >= 0 {
    return emitNulFieldEq(
      body,
      lRoot,
      rRoot,
      si,
      fi,
      pathSi,
      pathFi,
      fnIx,
      nulInner,
      ec,
    )
  }
  emitStructEqFieldAt(
    body,
    lRoot,
    rRoot,
    si,
    fi,
    pathSi,
    pathFi,
    fnIx,
    code,
    ec,
  )
}

// The field-compare ladder, keyed by an EXPLICIT code so the null guard above can re-enter it
// at the non-null twin of a niche field.
function emitStructEqFieldAt(
  body: u8[],
  lRoot: i32,
  rRoot: i32,
  si: i32,
  fi: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
  code: i32,
  ec: ExpCtx,
) {
  // Codes 21 (`boolean | null`) and 30 (`K | null`) share the scalar arm (D101): their null
  // rides in the value space rather than beside it, using the same `0x7f i32` storagetype
  // code 0 does, so plain `i32.eq` already answers `null == null` true and `null == "a"`
  // false with no guard needed.
  if code == FC_NUL_NONE {
    // A `null`-typed field holds only `null`, so the two sides always agree.
    fbI32Const(1)
    return 0
  }
  if code == FC_I32 || code == FC_NUL_BOOL || code == FC_NUL_LIT_UNION {
    // Scalar (i32 / boolean), or an i32-sentinel niche field: a native compare.
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
    fbI32Bin(70) // 0x46 i32.eq
    return 0
  }
  if code == FC_F64 || code == FC_I64 || code == FC_F32 {
    // A wide numeric scalar field: one native compare opcode, i32 0/1 result. The two
    // ladders (this one and `emitVariantFieldEqCore`) must not disagree about a field rep
    // — `{d: i64}` compared inside an `A | i32` union but refused outside it before this
    // arm covered i64/f32 too (D1181); one arm now serves all three widths.
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
    if code == FC_F64 {
      fbI32Bin(97) // 0x61 f64.eq
    } else if code == FC_I64 {
      fbI32Bin(81) // 0x51 i64.eq
    } else {
      fbI32Bin(91) // 0x5b f32.eq
    }
    return 0
  }
  if code == FC_STR {
    // String: the element-wise string-eq loop over the two field refs.
    if !aUsed {
      return emitFail(
        "emitProgram: string field equality but array type not collected",
      )
    }
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
    return emitStrEqCore(body)
  }
  if code == FC_STRUCT {
    return emitStructEqNestedField(
      body,
      lRoot,
      rRoot,
      si,
      fi,
      pathSi,
      pathFi,
      fnIx,
      ec,
    )
  }
  if code == FC_I32_LIST {
    return emitStructEqI32ListField(
      body,
      lRoot,
      rRoot,
      pathSi,
      pathFi,
      fnIx,
      ec,
    )
  }
  if code == FC_CLOSURE {
    // Function-valued field: identity compare (id + env) via the closure-eq frame.
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
    return emitCloEqCore(body)
  }
  if code == FC_UNION {
    // A value-union / struct-union box field compares exactly as the box does at top
    // level: tag first, then the arm the tag selects, reading the two boxes off a field
    // path instead of off two operands. Columns are resolved first, so an arm set the
    // core cannot serve declines before any byte is written and reaches the loud refusal below (D1290).
    const bxN = sFieldElemNameAt(si, fi)
    if bxN != "" {
      const bxArms: string[] = []
      const bxVis: i32[] = []
      const bxAks: i32[] = []
      if unionBoxEqColumns(bxN, bxArms, bxVis, bxAks) {
        if emitChainRead(body, lRoot, pathSi, pathFi, fnIx, ec) < 0 {
          return -1
        }
        if emitChainRead(body, rRoot, pathSi, pathFi, fnIx, ec) < 0 {
          return -1
        }
        return emitUnionBoxEqStaged(
          body,
          bxArms,
          bxVis,
          bxAks,
          false,
          bxN,
          fnIx,
          ec,
        )
      }
    }
  }
  if code == FC_REF_LIST {
    // A ref-list field compares exactly as a ref list does at top level: push the two
    // lists and hand them to the shared core, whose struct-element class already routes
    // to the stash-based `emitStructEqRec(body, -2, -3, …)`. The only addition here is
    // reading the two lists off a field path instead of off two operands (D1017).
    if si >= 0 {
      const d17n = sFieldElemNameAt(si, fi)
      if d17n != "" {
        const d17s = sFieldRefSlot(si, fi)
        if d17s >= 0 {
          if emitChainRead(body, lRoot, pathSi, pathFi, fnIx, ec) < 0 {
            return -1
          }
          if emitChainRead(body, rRoot, pathSi, pathFi, fnIx, ec) < 0 {
            return -1
          }
          return emitListEqAnyRep(body, LBK_REF, d17s, fnIx, ec)
        }
      }
    }
  }
  // A scalar-backed list field compares exactly as that list does at top level: read the
  // two lists off the field path and hand them to the generic core, whose frame
  // `leqNoteBin` reserved from the same map (`i32[]`, code 4, keeps its own arm above);
  // `f64[]`/`i64[]`/`string[]`/`f32[]`/`u8[]` fields get the same coverage here (D1020).
  const eqSk = eqScalarListFieldKind(code)
  if eqSk >= 0 {
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
    return emitListEqAnyRep(body, eqSk, 0, fnIx, ec)
  }
  emitFail("emitProgram: unsupported struct field type in equality")
}

// `emitStructEqFieldAt`'s nested-struct field `fi` of row `si`: recurse one level deeper along
// the chain under an unconditional null guard (D1180) — `next: Node` and `next: Node | null`
// share code 15 over one `(ref null $S)` slot, so the guard always runs. Chain reads stay raw
// inside it; a deeper field has its own guard. Returns 0, or -1 on failure.
function emitStructEqNestedField(
  body: u8[],
  lRoot: i32,
  rRoot: i32,
  si: i32,
  fi: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
  ec: ExpCtx,
) {
  const nsi = eqRowTgtStructIdx(si, fi)
  if nsi < 0 {
    return emitFail(
      "emitProgram: nested struct field equality with no interned shape",
    )
  }
  const hf = eqHelpFnOf(nsi)
  if hf >= 0 {
    if emitChainRead(body, lRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
    if emitChainRead(body, rRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
    fbCall(hf)
    return 0
  }
  if emitNulFieldGuardOpen(body, lRoot, rRoot, pathSi, pathFi, fnIx, ec) < 0 {
    return -1
  }
  if emitStructEqRec(body, lRoot, rRoot, nsi, pathSi, pathFi, fnIx, ec) < 0 {
    return -1
  }
  emitNulFieldGuardClose()
}

// A struct row whose compare is written as a helper once its inline compare would read more
// than this many fields: the smallest a doubling record reaches at depth 5.
const EQ_HELP_PATHS = 32

// Per struct row, the leaf fields its inline compare reads, or -1 when a field has no compare;
// -2 marks a row being counted, so a recursive row declines.
let eqHelpPaths: i32[] = []

// Reserve a compare helper functype for every struct row worth one: the program spells `==`
// somewhere, and the row's compare is helper-safe and reads more than `EQ_HELP_PATHS` fields.
export function eqHelpReserve() {
  gEqHelpTy = []
  gEqHelpFn = []
  gEqHelpTyN = 0
  eqHelpPaths = []
  let r = 0
  while r < sFieldCount.length {
    eqHelpPaths.push(-3)
    r = r + 1
  }
  r = 0
  while r < sFieldCount.length {
    if gSawEqOp && eqHelpPathsOf(r) > EQ_HELP_PATHS {
      gEqHelpTy.push(gEqHelpTyN)
      gEqHelpTyN = gEqHelpTyN + 1
    } else {
      gEqHelpTy.push(-1)
    }
    gEqHelpFn.push(-1)
    r = r + 1
  }
  0
}

// The leaf fields struct row `si`'s compare reads, saturating at 2^20, or -1 when one of them
// has no field compare or is a nested struct that is not itself helper-safe.
function eqHelpPathsOf(si: i32): i32 {
  if si < 0 || si >= eqHelpPaths.length { return -1 }
  const memo = eqHelpPaths[si]
  if memo == -2 { return -1 }
  if memo != -3 { return memo }
  eqHelpPaths[si] = -2
  let total = 0
  let fi = 0
  while fi < sFieldCount[si] && total >= 0 {
    const n = eqHelpFieldPaths(si, fi)
    if n < 0 { total = -1 } else { total = total + n }
    if total > 1048576 { total = 1048576 }
    fi = fi + 1
  }
  eqHelpPaths[si] = total
  total
}

// The leaf fields field `fi` of struct row `si` contributes to its compare, or -1. A list,
// union box or function field counts as one: the helper's frame holds what it stages (D9962).
function eqHelpFieldPaths(si: i32, fi: i32): i32 {
  const code = sFieldTypeAt(si, fi)
  if code == FC_STRUCT { return eqHelpPathsOf(sFieldTgtStructIdx(si, fi)) }
  if code == FC_STR || code == FC_NUL_STR {
    if aUsed { return 1 }
    return -1
  }
  if code == FC_NUL_NONE || code == FC_I32 || code == FC_NUL_BOOL { return 1 }
  if code == FC_NUL_LIT_UNION || code == FC_F64 || code == FC_I64 { return 1 }
  if code == FC_F32 || code == FC_UNION || code == FC_CLOSURE { return 1 }
  if code == FC_NUL_CLOSURE || code == FC_I32_LIST || code == FC_REF_LIST {
    return 1
  }
  // Every other list code, nullable or not; a map field has no compare.
  const inner = nulFieldInnerCode(code)
  if inner == FC_I32_LIST || inner == FC_REF_LIST { return 1 }
  if eqScalarListFieldKind(code) >= 0 || eqScalarListFieldKind(inner) >= 0 {
    return 1
  }
  -1
}

// The function a nested compare of struct row `si` calls: its helper, given the next tail
// index the first time a compare asks, or -1 when the row has none and compares inline.
function eqHelpFnOf(si: i32): i32 {
  if si < 0 || si >= gEqHelpTy.length || gEqHelpTy[si] < 0 { return -1 }
  if gEqHelpFn[si] < 0 {
    gEqHelpFn[si] = gMapSetFnBase + gTailFnRows.length
    gTailFnRows.push(-1 - si)
  }
  gEqHelpFn[si]
}

// `__eq_<row>__(a, b)`'s functype: two nullable refs of struct row `si`, an i32 0/1 result.
export function eqHelpFuncType(si: i32) {
  fbFuncTypeHead(2)
  fbRefNullValtype(sHeapIdx[si])
  fbRefNullValtype(sHeapIdx[si])
  wULEB(1)
  fbValtype("i32", -1)
  0
}

export function eqHelpFnName(si: i32): string { "__eq_" + i32ToStr(si) + "__" }

// The instructions of `__eq_<row>__`, after its locals vector: both null equal, one null
// unequal, else the field-wise compare a nested field would otherwise write inline, over the
// two params. Its frame is laid out by the caller before this runs.
export function eqHelpFnBody(si: i32, ec: ExpCtx): u8[] {
  const body: u8[] = []
  const prev = wTarget(body)
  const savedL = eqStashL
  const savedR = eqStashR
  const savedRec = eqChainRecover
  eqStashL = 0
  eqStashR = 1
  eqChainRecover = false
  const pathSi: i32[] = []
  const pathFi: i32[] = []
  if emitNulFieldGuardOpen(body, -2, -3, pathSi, pathFi, -1, ec) >= 0 {
    if emitStructEqRec(body, -2, -3, si, pathSi, pathFi, -1, ec) >= 0 {
      emitNulFieldGuardClose()
    }
  }
  eqStashL = savedL
  eqStashR = savedR
  eqChainRecover = savedRec
  fbEnd()
  wTarget(prev)
  body
}

// `emitStructEqFieldAt`'s `i32[]` field: lengths equal and element-wise equal — `len` from the
// wrapper's field 1 (the backing may be longer), elements off backings stashed in two fresh
// `listBackStashSlot` slots. The i32 counters ride the string-op frame: plain i32 slots
// carrying no rep, safe to share. Returns 0, or -1 on failure.
function emitStructEqI32ListField(
  body: u8[],
  lRoot: i32,
  rRoot: i32,
  pathSi: i32[],
  pathFi: i32[],
  fnIx: i32,
  ec: ExpCtx,
) {
  if !lUsed {
    return emitFail(
      "emitProgram: i32[] field equality but list type not collected",
    )
  }
  // lenL != lenR → 0, else the element loop.
  if emitChainRead(body, lRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
  fbStructGet(lTypeIdx, 1) // wrapper field 1: len
  if emitChainRead(body, rRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
  fbStructGet(lTypeIdx, 1)
  fbI32Bin(71)             // 0x47 i32.ne
  fbIf(127)                // 0x04 if, 0x7f i32 blocktype
  fbI32Const(0)            // length mismatch → 0
  fbElse()                 // 0x05 else — the element loop, like emitStrEqCore
  // A = backing(L.f); B = backing(R.f); I0 = len; I1 = 0
  const eqBkA = listBackStashSlot("i32", 0)
  const eqBkB = listBackStashSlot("i32", 0)
  if emitChainRead(body, lRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
  fbStructGet(lTypeIdx, 0) // backing
  fbLocalSet(eqBkA)
  if emitChainRead(body, rRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
  fbStructGet(lTypeIdx, 0)
  fbLocalSet(eqBkB)
  if emitChainRead(body, lRoot, pathSi, pathFi, fnIx, ec) < 0 { return -1 }
  fbStructGet(lTypeIdx, 1) // len
  setStrScrI(body, 0)
  fbBlock(127)             // 0x02 block, 0x7f i32 — yields the 0/1 result
  fbI32Const(0)
  setStrScrI(body, 1)      // I1 = 0
  fbLoop(64)               // 0x03 loop, void
  pushStrScrI(body, 1)
  pushStrScrI(body, 0)
  fbI32Bin(78)             // 0x4e i32.ge_s — done?
  fbIf(64)                 // then: fall through (all matched)
  fbElse()
  fbLocalGet(eqBkA)
  pushStrScrI(body, 1)
  fbArrayGet(aTypeIdx)
  fbLocalGet(eqBkB)
  pushStrScrI(body, 1)
  fbArrayGet(aTypeIdx)
  fbI32Bin(71)             // 0x47 i32.ne
  fbIf(64)                 // mismatch → 0, exit the result block
  fbI32Const(0)
  fbBr(3)                  // depths: if(0)·else(1)·loop(2)·block(3)
  fbEnd()
  pushStrScrI(body, 1)
  fbI32Const(1)
  fbI32Bin(106)            // i32.add
  setStrScrI(body, 1)
  fbBr(1)                  // continue the loop
  fbEnd()                  // end (else's if)
  fbEnd()                  // end (loop)
  fbI32Const(1)            // every element matched
  fbEnd()                  // end (result block)
  fbEnd()                  // end (length if/else)
  0
}

// Emit `clamp(idx, len)` where `idx` is in i32 temp `idxSlot` and `len` in temp
// `lenSlot`, leaving the clamped value on the stack — JS slice semantics: a negative
// index counts from the end (`len + idx`, floored at 0), a non-negative index is capped
// at `len` (`idx < 0 ? max(len+idx, 0) : min(idx, len)`), built from `select`.
function emitClampIdx(body: u8[], idxSlot: i32, lenSlot: i32) {
  // negCase = max(len+idx, 0) = select( len+idx, 0, (len+idx) > 0 )
  pushStrScrI(body, lenSlot)
  pushStrScrI(body, idxSlot)
  fbI32Bin(106) // i32.add → (len+idx)  [the `a` value]
  fbI32Const(0) // i32.const 0          [the `b` value]
  pushStrScrI(body, lenSlot)
  pushStrScrI(body, idxSlot)
  fbI32Bin(106) // i32.add → (len+idx)
  fbI32Const(0) // i32.const 0
  fbI32Bin(74)  // 0x4a i32.gt_s → (len+idx) > 0   [cond]
  fbSelect()    // → negCase on stack
  // nonNegCase = min(idx, len) = select( idx, len, idx < len )
  pushStrScrI(body, idxSlot) // a = idx
  pushStrScrI(body, lenSlot) // b = len
  pushStrScrI(body, idxSlot)
  pushStrScrI(body, lenSlot)
  fbI32Bin(72)               // 0x48 i32.lt_s → idx < len   [cond]
  fbSelect()                 // → nonNegCase on stack
  // result = select( negCase, nonNegCase, idx < 0 )
  // Stack currently: [negCase, nonNegCase]; push cond then select.
  pushStrScrI(body, idxSlot)
  fbI32Const(0) // i32.const 0
  fbI32Bin(72)  // 0x48 i32.lt_s → idx < 0
  fbSelect()    // → clamped value
  0
}

// Lower a string `s.slice(start, end)`, leaving the new string ref: a header only, sharing
// the receiver's backing (`struct.new $str (s.backing, s.start + start, len)`), O(1) with
// zero element copies. Safe by construction — no string element store and no `ref.eq` on a
// string exist anywhere in the emitter, so a view and a copy are indistinguishable — but a view keeps its whole backing alive; `compact()` is the documented escape (§Header).
function emitStrSlice(body: u8[], callIx: i32, fnIx: i32, ec: ExpCtx) {
  if !aUsed {
    return emitFail("emitProgram: string slice but array type not collected")
  }
  if callIx < 0 { return -1 }
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length != 2 {
      return emitFail(
        "emitProgram: internal: string .slice reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      // Eval receiver + both args onto the stack first (nested string ops complete),
      // then stash: end on top → I1, then start → I0, then receiver → strScrA.
      if emitExpr(body, callee.memObj, fnIx, ec) < 0 { return -1 }
      if emitExpr(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
      if emitExpr(body, c.callArgs[1], fnIx, ec) < 0 { return -1 }
      setStrScrI(body, 1)            // raw end → I1
      setStrScrI(body, 0)            // raw start → I0
      fbLocalSet(strScratchBase + 0) // local.set strScrA (receiver)
      // I2 = len(s) — the HEADER's `len` (field 2). `array.len` here would be the BACKING's
      // physical length, so a slice of a slice would clamp against its parent's extent.
      pushStrScrRef(body, 0)
      fbStrLen()
      setStrScrI(body, 2)
      // I0 = clamp(rawStart, len)
      if emitClampIdx(body, 0, 2) < 0 { return -1 }
      setStrScrI(body, 0)
      // I1 = clamp(rawEnd, len)
      if emitClampIdx(body, 1, 2) < 0 { return -1 }
      setStrScrI(body, 1)
      // I3 = out length = max(end - start, 0) = select( end-start, 0, end > start )
      pushStrScrI(body, 1)
      pushStrScrI(body, 0)
      fbI32Bin(107) // 0x6b i32.sub → end - start   [a]
      fbI32Const(0) // i32.const 0                  [b]
      pushStrScrI(body, 1)
      pushStrScrI(body, 0)
      fbI32Bin(74)  // 0x4a i32.gt_s → end > start  [cond]
      fbSelect()
      setStrScrI(body, 3)
      // The VIEW: same backing, start biased by the receiver's own start, len = I3. This is
      // the whole lowering now — no allocation of elements, no copy.
      pushStrScrRef(body, 0)
      fbStrBack()          // field 0: the SHARED backing
      pushStrScrRef(body, 0)
      fbStrStart()         // field 1: the receiver's own start …
      pushStrScrI(body, 0)
      fbI32Bin(106)        // 0x6a i32.add — … plus the clamped slice start
      pushStrScrI(body, 3) // field 2: len = max(end - start, 0)
      fbStrNew()           // 0xfb 0x00 <string header>
      return 0
    }
    return emitFail(
      "emitProgram: string .slice receiver is not a member access",
    )
  }
  emitFail("emitProgram: expected a string slice call")
}

// Lower `s.indexOf(sub)` (or `s.includes(sub)`), leaving an i32: the first index of `sub`
// in `s`, or -1 (empty `sub` yields 0, the JS convention); `includes` is `indexOf != -1`.
// An outer loop per verify attempt wraps a skip loop that hoists `B[0]` to advance to the
// next matching-first-character start in one load, then a verify loop over the rest — both the empty-needle short-circuit and the too-long-needle guard are load-bearing for that hoist.
function emitStrIndexOf(body: u8[], callIx: i32, fnIx: i32, ec: ExpCtx) {
  if !aUsed {
    return emitFail("emitProgram: string indexOf but array type not collected")
  }
  if callIx < 0 { return -1 }
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length != 1 {
      return emitFail(
        "emitProgram: internal: string .indexOf reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      const isIncludes = callee.memProp == "includes"
      // Eval receiver + needle onto the stack first (nested string ops complete),
      // then stash: needle on top → B, then receiver → A.
      if emitExpr(body, callee.memObj, fnIx, ec) < 0 { return -1 }
      if emitExpr(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
      fbLocalSet(strScratchBase + 1) // local.set strScrB (sub)
      fbLocalSet(strScratchBase + 0) // local.set strScrA (s)
      // Hoist both headers' backing + start before the search — every one of the three
      // loops below reads one or both operands per trip (§Header: hoist in codegen).
      hoistStrScr(body, 0)
      hoistStrScr(body, 1)
      // I3 = len(sub); I2 = len(s) - len(sub), the last start the needle fits at. Both are
      // the HEADER's `len` (field 2): `array.len` would be the shared backing's extent, so a
      // needle that is a VIEW would report its parent's length and the scan would run off it.
      pushStrScrRef(body, 1)
      fbStrLen()
      setStrScrI(body, 3)
      pushStrScrRef(body, 0)
      fbStrLen()
      pushStrScrI(body, 3)
      fbI32Bin(107) // 0x6b i32.sub
      setStrScrI(body, 2)
      fbBlock(127)  // 0x02 block, 0x7f i32 blocktype — yields index / -1
      // Empty needle → 0. This is also what makes the hoisted B[0] below safe.
      pushStrScrI(body, 3)
      fbI32Const(0)
      fbI32Bin(70) // 0x46 i32.eq
      fbIf(64)     // 0x04 if, 0x40 void blocktype
      fbI32Const(0)
      fbBr(1)      // → out of the i32 block
      fbEnd()
      // Needle longer than haystack → -1 (no start exists).
      pushStrScrI(body, 2)
      fbI32Const(0)
      fbI32Bin(72)        // 0x48 i32.lt_s
      fbIf(64)
      fbI32Const(-1)
      fbBr(1)             // → out of the i32 block
      fbEnd()
      fbI32Const(0)
      setStrScrI(body, 0) // I0 = 0
      fbLoop(64)          // 0x03 loop (outer) — one trip per verify attempt
      // I1 = B[0]: the character every candidate start has to carry.
      pushStrScrBase(body, 1) // needle backing + its start …
      fbArrayGet(sBackIdx)    // … which IS the offset of B[0]
      setStrScrI(body, 1)
      fbLoop(64)              // 0x03 loop (skip) — advance to the next candidate
      // Past the last possible start → no match.
      pushStrScrI(body, 0)
      pushStrScrI(body, 2)
      fbI32Bin(74) // 0x4a i32.gt_s
      fbIf(64)
      fbI32Const(-1)
      fbBr(3)      // depths: if(0)·skip(1)·outer(2)·block(3)
      fbEnd()
      // A[I0] != B[0] → not a candidate: advance and keep skipping. ONE load.
      pushStrScrElem(body, 0, 0)
      pushStrScrI(body, 1)
      fbI32Bin(71)  // 0x47 i32.ne
      fbIf(64)
      pushStrScrI(body, 0)
      fbI32Const(1)
      fbI32Bin(106) // 0x6a i32.add
      setStrScrI(body, 0)
      fbBr(1)       // → skip loop header
      fbEnd()
      fbEnd()       // 0x0b end (skip loop) — falls through with A[I0]==B[0]
      // I1 = 1: B[0] already matched, so verification starts at index 1.
      fbI32Const(1)
      setStrScrI(body, 1)
      fbLoop(64) // 0x03 loop (verify)
      // I1 >= len(sub) → full match at I0: yield I0 out of the i32 block.
      pushStrScrI(body, 1)
      pushStrScrI(body, 3)
      fbI32Bin(78) // 0x4e i32.ge_s
      fbIf(64)
      pushStrScrI(body, 0)
      fbBr(3)      // depths: if(0)·verify(1)·outer(2)·block(3)
      fbEnd()
      // A[I0+I1] != B[I1] → mismatch: advance I0 and re-enter the skip loop.
      pushStrScrBase(body, 0)
      pushStrScrI(body, 0)
      fbI32Bin(106)              // 0x6a i32.add — startA + I0
      pushStrScrI(body, 1)
      fbI32Bin(106)              // 0x6a i32.add — … + I1
      fbArrayGet(sBackIdx)       // 0xfb 0x0b array.get
      pushStrScrElem(body, 1, 1) // B[I1]
      fbI32Bin(71)               // 0x47 i32.ne
      fbIf(64)
      pushStrScrI(body, 0)
      fbI32Const(1)
      fbI32Bin(106)              // i32.add
      setStrScrI(body, 0)        // I0 = I0 + 1
      fbBr(2)                    // 0x0c br depth 2 → outer loop header
      fbEnd()                    // 0x0b end (mismatch if)
      // I1 = I1 + 1; br verify loop
      pushStrScrI(body, 1)
      fbI32Const(1)
      fbI32Bin(106)  // i32.add
      setStrScrI(body, 1)
      fbBr(0)        // 0x0c br depth 0 → verify loop header
      fbEnd()        // 0x0b end (verify loop)
      fbEnd()        // 0x0b end (outer loop)
      fbI32Const(-1) // block result; the skip loop owns the real exhaustion exit
      fbEnd()        // 0x0b end (block) — leaves the i32 result
      if isIncludes {
        fbI32Const(-1)
        fbI32Bin(71) // 0x47 i32.ne — `includes` ≡ `indexOf(sub) != -1`
      }
      return 0
    }
    return emitFail(
      "emitProgram: string .indexOf receiver is not a member access",
    )
  }
  emitFail("emitProgram: expected a string indexOf call")
}

// Lower `s.charCodeAt(i)` onto `body`, leaving the char code i32: a guarded
// `backing[start + i]` over the code-point backing, so an out-of-range index traps —
// matching the host's `s[i]` semantics (no JS NaN). The guard is what keeps the trap: the
// backing outlives the view, so `array.get`'s own bounds check is not the view's bound.
function emitStrCharCode(body: u8[], callIx: i32, fnIx: i32, ec: ExpCtx) {
  if !aUsed {
    return emitFail(
      "emitProgram: string charCodeAt but array type not collected",
    )
  }
  if callIx < 0 { return -1 }
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length != 1 {
      return emitFail(
        "emitProgram: internal: string .charCodeAt reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      // The SAME guarded `backing[start + i]` shape `s[i]` gets, INCLUDING the loop-hoist
      // arm — the two are one operation spelled twice (`emitIndex`'s string arm is the
      // sibling ladder), and Stage 2b keeps them reading through ONE pair of helpers so they
      // cannot drift into different bounds rules or different hoisting.
      const ccHz = liveHoistRow(callee.memObj, "i32", 0 - 1)
      if ccHz < 0 {
        if emitExpr(body, callee.memObj, fnIx, ec) < 0 { return -1 }
      }
      if emitExpr(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
      if ccHz >= 0 { emitStrIdxGuardHoisted(ccHz) } else { emitStrIdxGuard() }
      fbArrayGet(sBackIdx) // 0xfb 0x0b array.get
      return 0
    }
    return emitFail(
      "emitProgram: string .charCodeAt receiver is not a member access",
    )
  }
  emitFail("emitProgram: expected a string charCodeAt call")
}

// ── the code-point trio: `cpAt` / `cpLen` / `isCharBoundary` ──────────────────
// All three read the UTF-8 storage directly, which is why they are core intrinsics rather
// than `std:str` functions — nothing writable in VL can see a byte as anything but a byte.
// They ride the same lazy stash `s[i]` uses, so they need no `exprHasStrOp` reservation arm.

// Stash [receiver, index] off the wasm stack into the shared header/index slots. On entry
// BOTH are fully evaluated (a nested string index inside either has already come and gone
// through these slots — the nested-op discipline `strHdrSlot`'s header states). Returns the
// header slot; the index is at `listIdxScratchBase`.
function stashStrRecvIdx(_body: u8[]) {
  const hs = strHdrSlot()
  fbLocalSet(listIdxScratchBase) // the index
  fbLocalSet(hs)                 // the header
  hs
}

// Push the header's one-past-the-end BACKING offset, `start + len` — `__utf8_dec__`'s bound,
// and the reason a sequence that runs off the end of a VIEW decodes to U+FFFD instead of
// reading its sibling view's bytes.
function pushStrHdrEnd(_body: u8[], hs: i32) {
  fbLocalGet(hs)
  fbStrStart()
  fbLocalGet(hs)
  fbStrLen()
  fbI32Bin(106) // 0x6a i32.add
  0
}

// Push the guarded BACKING offset of byte `i`: `start + i` when `i u< len`, else `-1`. The
// SAME select `emitStrIdxGuard` builds, so an out-of-range `cpAt` traps exactly where an
// out-of-range `s[i]` does rather than decoding a neighbour's bytes.
function pushStrGuardedOff(_body: u8[], hs: i32) {
  fbLocalGet(hs)
  fbStrStart()
  fbLocalGet(listIdxScratchBase)
  fbI32Bin(106)  // i32.add → start + i
  fbI32Const(-1) // the out-of-range replacement offset
  fbLocalGet(listIdxScratchBase)
  fbLocalGet(hs)
  fbStrLen()
  fbI32Bin(73)   // 0x49 i32.lt_u — covers negative and past-len in one compare
  fbSelect()
  0
}

// Lower `s.cpAt(i)` — the code point whose UTF-8 sequence BEGINS at byte offset `i`, O(1).
// `__utf8_dec__` returns `(width << 24) | cp`; only the code point is wanted here, so the
// width is masked off. Offset `i` landing mid-sequence is not an error (§Validity): the byte
// there is a continuation byte, which begins nothing, so the answer is U+FFFD.
function emitStrCpAt(body: u8[], callIx: i32, fnIx: i32, ec: ExpCtx) {
  if !aUsed {
    return emitFail("emitProgram: string cpAt but array type not collected")
  }
  if callIx < 0 { return -1 }
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length != 1 {
      return emitFail(
        "emitProgram: internal: string .cpAt reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      if emitExpr(body, callee.memObj, fnIx, ec) < 0 { return -1 }
      if emitExpr(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
      const hs = stashStrRecvIdx(body)
      fbLocalGet(hs)
      fbStrBack()
      pushStrGuardedOff(body, hs)
      pushStrHdrEnd(body, hs)
      fbCall(gHelpUtf8Dec)
      fbI32Const(16777215) // 0x00ffffff — drop the width, keep the code point
      fbI32Bin(113)        // 0x71 i32.and
      return 0
    }
    return emitFail("emitProgram: string .cpAt receiver is not a member access")
  }
  emitFail("emitProgram: expected a string cpAt call")
}

// Lower `s.cpLen()` — the code-point count, one call into `__utf8_cplen__`. O(n), and the
// call site says so.
function emitStrCpLen(body: u8[], callIx: i32, fnIx: i32, ec: ExpCtx) {
  if !aUsed {
    return emitFail("emitProgram: string cpLen but array type not collected")
  }
  if callIx < 0 { return -1 }
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length != 0 {
      return emitFail(
        "emitProgram: internal: string .cpLen reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      if emitExpr(body, callee.memObj, fnIx, ec) < 0 { return -1 }
      fbCall(gHelpUtf8CpLen)
      return 0
    }
    return emitFail(
      "emitProgram: string .cpLen receiver is not a member access",
    )
  }
  emitFail("emitProgram: expected a string cpLen call")
}

// Lower `s.isCharBoundary(i)` (Rust's primitive, O(1)): does byte `i` begin a UTF-8
// sequence? True at `len`, false past `len` or below 0, else the lead/continuation bit
// test. Deliberately does not special-case index 0 the way Rust does — a VL string is not
// guaranteed valid (§Validity), so a view like `"é→".slice(1, 4)` can start on a continuation byte, and answering `true` at 0 unconditionally would report a boundary that is not one.
function emitStrIsCharBoundary(body: u8[], callIx: i32, fnIx: i32, ec: ExpCtx) {
  if !aUsed {
    return emitFail(
      "emitProgram: string isCharBoundary but array type not collected",
    )
  }
  if callIx < 0 { return -1 }
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length != 1 {
      return emitFail(
        "emitProgram: internal: string .isCharBoundary reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      if emitExpr(body, callee.memObj, fnIx, ec) < 0 { return -1 }
      if emitExpr(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
      const hs = stashStrRecvIdx(body)
      // i == len — the end of the VIEW, never of the backing.
      fbLocalGet(listIdxScratchBase)
      fbLocalGet(hs)
      fbStrLen()
      fbI32Bin(70) // 0x46 i32.eq
      fbIf(127)    // if (result i32)
      fbI32Const(1)
      fbElse()
      // In range? (one unsigned compare covers negative and past-len.)
      fbLocalGet(listIdxScratchBase)
      fbLocalGet(hs)
      fbStrLen()
      fbI32Bin(73)  // 0x49 i32.lt_u
      fbIf(127)
      fbLocalGet(hs)
      fbStrBack()
      fbLocalGet(hs)
      fbStrStart()
      fbLocalGet(listIdxScratchBase)
      fbI32Bin(106) // i32.add
      fbArrayGet(sBackIdx)
      fbI32Const(192)
      fbI32Bin(113) // i32.and
      fbI32Const(128)
      fbI32Bin(71)  // 0x47 i32.ne
      fbElse()
      fbI32Const(0)
      fbEnd()
      fbEnd()
      return 0
    }
    return emitFail(
      "emitProgram: string .isCharBoundary receiver is not a member access",
    )
  }
  emitFail("emitProgram: expected a string isCharBoundary call")
}

// Lower `s.bytes()` — one call into `__str_bytes__`, which `array.copy`s the view's byte
// range into a fresh `u8[]`. `ba8Used` is forced by `scanPrintUse`'s `.bytes()` arm, the
// only thing that makes the packed pair exist for a program that spells no `u8[]`.
function emitStrBytes(body: u8[], callIx: i32, fnIx: i32, ec: ExpCtx) {
  if !aUsed || !ba8Used || gHelpStrBytes < 0 {
    return emitFail(
      "emitProgram: string bytes() but the packed byte-list types were not collected",
    )
  }
  if callIx < 0 { return -1 }
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length != 0 {
      return emitFail(
        "emitProgram: internal: string .bytes reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      if emitExpr(body, callee.memObj, fnIx, ec) < 0 { return -1 }
      fbCall(gHelpStrBytes)
      return 0
    }
    return emitFail(
      "emitProgram: string .bytes receiver is not a member access",
    )
  }
  emitFail("emitProgram: expected a string bytes call")
}

// The node `emitMapUnionPayload` is emitting as its union box, so the re-entry emits the box.
let mapUnboxHeld = -1

// A union of maps delivered as the one map `dstTy` whose storage every member shares (D2692):
// the box, then its payload cast to that map's struct. A member of another struct is refused.
function emitMapUnionPayload(
  body: u8[],
  exprIx: i32,
  dstTy: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const held = mapUnboxHeld
  mapUnboxHeld = exprIx
  const boxed = exprUnion(exprIx, fnIx)
  const r = emitExpr(body, exprIx, fnIx, ec)
  mapUnboxHeld = held
  if r < 0 || !boxed { return r }
  const sh = mapShapeFoldSet(mapArmShapeOfTy(dstTy))
  const mems: i32[] = []
  flattenVariantsInto(nodeTyIxOf(exprIx), mems)
  let i = 0
  while i < mems.length {
    const msh = mapShapeFoldSet(mapArmShapeOfTy(mems[i]))
    if !mapTwinOneStruct(msh, sh) {
      return emitFailAt(
        "emitProgram: a union of maps cannot be delivered as "
          + tyToEmitName(dstTy)
          + ": a member is stored differently",
        exprIx,
      )
    }
    i = i + 1
  }
  fbStructGet(uBoxIdx, 1)
  fbRefCast(mapTypeIdxOf(sh))
  0
}

// A union box delivered into a union lacking one of its map members (D2690): a box tagged
// with such a member takes the tag of the destination member it is assignable to, so `is`,
// `match` and `as` in the destination read the member it holds there. A scalar member the
// destination holds only widened (`wFrom` to `wTo`) is rebuilt with the widened payload (D2974).
function emitMapRetag(
  body: u8[],
  exprIx: i32,
  from: i32[],
  to: i32[],
  wFrom: i32[],
  wTo: i32[],
  fnIx: i32,
  ec: ExpCtx,
) {
  const fromTags: i32[] = []
  const toTags: i32[] = []
  mapRetagTagPairs(from, to, fromTags, toTags)
  const held = mapUnboxHeld
  mapUnboxHeld = exprIx
  const boxed = exprUnion(exprIx, fnIx)
  const r = emitExpr(body, exprIx, fnIx, ec)
  mapUnboxHeld = held
  const arms = fromTags.length + wFrom.length
  if r < 0 || !boxed || arms == 0 { return r }
  fbLocalSet(unionAsBoxSlot())
  let w = 0
  while w < wFrom.length {
    if emitWidenRetagArm(wFrom[w], wTo[w]) < 0 { return -1 }
    w = w + 1
  }
  let i = 0
  while i < fromTags.length {
    fbLocalGet(unionAsBoxSlot())
    fbStructGet(uBoxIdx, 0)
    fbI32Rel(RS_TAG, fromTags[i])
    fbI32Bin(70) // i32.eq
    fbIfRefNul(uBoxIdx, false)
    fbI32Rel(RS_TAG, toTags[i])
    fbLocalGet(unionAsBoxSlot())
    fbStructGet(uBoxIdx, 1)
    fbStructNew(uBoxIdx)
    fbElse()
    i = i + 1
  }
  fbLocalGet(unionAsBoxSlot())
  let e = 0
  while e < arms {
    fbEnd()
    e = e + 1
  }
  0
}

// The convert opcode from value atom `fk` to `tk` for the widenings `recordWidenRetag` records,
// or -1 for any other pair.
function widenConvOpOfKinds(fk: i32, tk: i32): i32 {
  if fk == 0 && tk == 3 { return scalarWidenConvOp("i32", "i64") }
  if fk == 0 && tk == 4 { return scalarWidenConvOp("i32", "f64") }
  if fk == 5 && tk == 4 { return scalarWidenConvOp("f32", "f64") }
  -1
}

// The opcode converting value atom `fk` to `tk` exactly, either way a box retag crosses: a
// widening `widenConvOpOfKinds` names, or the narrowing back from one (`atomNarrowOp`).
function atomConvOp(fk: i32, tk: i32): i32 {
  const w = widenConvOpOfKinds(fk, tk)
  if w >= 0 { return w }
  atomNarrowOp(fk, tk)
}

// The refusal of a field read at `memIx` whose wider record stores two of its own members as one.
function emitBoxAmbiguousFail(memIx: i32) {
  emitFailAt(
    "emitProgram: this field is stored at a wider record whose member two of its own members "
      + "widen to, so a read at its own type cannot tell which one it held. Annotate the "
      + "binding with the wider record's type, or build a second literal",
    memIx,
  )
}

// Whether a box held at member set `from` needs `emitBoxAtomRetag` to be read at `to`.
function boxRetagNeeded(from: string, to: string): boolean {
  if from == "" || to == "" || from == to { return false }
  const fa: string[] = []
  unionSetAtomsOf(from, fa)
  const ta: string[] = []
  unionSetAtomsOf(to, ta)
  let i = 0
  while i < fa.length {
    if boxAtomRetagKind(fa[i], ta, fa) >= 0 { return true }
    i = i + 1
  }
  false
}

// The kind of the member of `to` that member `p` of `from` is rebuilt as, or -1: widened by
// `boxWidenAtomFor`'s first-match rule, else narrowed back by its exact inverse
// (`boxNarrowAtomFor`); a stored member two members widen to answers -1, never a guess.
function boxAtomRetagKind(p: string, to: string[], from: string[]): i32 {
  const w = boxWidenAtomFor(p, to, from)
  if w >= 0 { return w }
  const n = boxNarrowAtomFor(p, to, from)
  if n >= 0 { return n }
  -1
}

// One arm of `emitMapRetag`'s chain for a scalar member `fromTy` the destination holds widened
// as `toTy`: under `fromTy`'s tag, the box in `unionAsBoxSlot` is rebuilt under `toTy`'s with its
// payload converted; the arm is left open on its `else`.
function emitWidenRetagArm(fromTy: i32, toTy: i32) {
  const fk = boxTagOfTy(fromTy)
  const tk = boxTagOfTy(toTy)
  const conv = widenConvOpOfKinds(fk, tk)
  const vb = vbHeapIdxOfKind(tk)
  if conv < 0 || vb < 0 {
    return emitFail(
      "emitProgram: a union delivered widened has no box for its widened member",
    )
  }
  fbLocalGet(unionAsBoxSlot())
  fbStructGet(uBoxIdx, 0)
  fbI32Rel(RS_TAG, scalarTagOfKind(fk))
  fbI32Bin(70) // i32.eq
  fbIfRefNul(uBoxIdx, false)
  fbI32Rel(RS_TAG, scalarTagOfKind(tk))
  fbLocalGet(unionAsBoxSlot())
  if emitUnionUnboxTail(fk) < 0 { return -1 }
  wU8(conv)
  fbStructNew(vb)
  fbStructNew(uBoxIdx)
  fbElse()
  0
}

// The union box on the stack, held at the member set `from`, rebuilt at `to`: each scalar member
// `to` lacks is re-boxed as the member of `to` it converts to exactly (`boxAtomRetagKind`). A
// field read narrows a wider record's box back (D3006); a literal built there widens it.
function emitBoxAtomRetag(from: string, to: string, at: i32) {
  const fa: string[] = []
  unionSetAtomsOf(from, fa)
  const ta: string[] = []
  unionSetAtomsOf(to, ta)
  emitBoxAtomRetagAtoms(fa, ta, at)
}

// `emitBoxAtomRetag` from union type `fromTy` to `toTy`, over their canonical members, for a
// pair `memReadBoxPlan` accepted (so both have them).
function emitBoxAtomRetagTys(fromTy: i32, toTy: i32, at: i32) {
  const fa: string[] = []
  canonUnionMembersInto(fromTy, [], fa)
  const ta: string[] = []
  canonUnionMembersInto(toTy, [], ta)
  emitBoxAtomRetagAtoms(fa, ta, at)
}

// `emitBoxAtomRetag` over the member atoms `fa` of the box on the stack and `ta` of its target.
function emitBoxAtomRetagAtoms(fa: string[], ta: string[], at: i32) {
  const slot = sharedFieldRecvSlot()
  fbLocalSet(slot)
  let arms = 0
  let i = 0
  while i < fa.length {
    const k = boxAtomRetagKind(fa[i], ta, fa)
    if k >= 0 {
      const fk = valueAtomKind(fa[i])
      const vb = vbHeapIdxOfKind(k)
      if vb < 0 {
        return emitFailAt(
          "emitProgram: a union stored at a wider record's field has no box for its member",
          at,
        )
      }
      fbLocalGet(slot)
      fbStructGet(uBoxIdx, 0)
      fbI32Rel(RS_TAG, scalarTagOfKind(fk))
      fbI32Bin(70) // i32.eq
      fbIfRefNul(uBoxIdx, false)
      fbI32Rel(RS_TAG, scalarTagOfKind(k))
      fbLocalGet(slot)
      if emitUnionUnboxTail(fk) < 0 { return -1 }
      wU8(atomConvOp(fk, k))
      fbStructNew(vb)
      fbStructNew(uBoxIdx)
      fbElse()
      arms = arms + 1
    }
    i = i + 1
  }
  fbLocalGet(slot)
  fbRefAsNonNull()
  while arms > 0 {
    fbEnd()
    arms = arms - 1
  }
  0
}

// A read leaves its recorded rep on the stack: a nullable cell the checker narrowed to its
// non-null twin recovers here, once, rather than at each consumer.
function emitReadRecover(exprIx: i32, fnIx: i32) {
  if readOwesNonNullRecover(exprIx, fnIx) { fbRefAsNonNull() }
  0
}

export function emitExpr(body: u8[], exprIx: i32, fnIx: i32, ec: ExpCtx) {
  // Stop after a recorded failure: `emitFail` banks the first message and returns -1 but
  // does not halt the pass, so a caller that drops the -1 keeps emitting over invalidated
  // state until an unguarded parallel-table read traps and kills the compiler before the
  // diagnostic prints. Checking the flag at the two recursion roots makes a failure terminal wherever it happened, instead of relying on every caller in between to thread -1 outward.
  if emitFailed { return -1 }
  if exprIx < 0 { return emitFail("emitProgram: missing expression") }
  if exprIx == isRecvStagedIx {
    fbLocalGet(isRecvStagedSlot)
    if isRecvStagedNonNull { fbRefAsNonNull() }
    return 0
  }
  // A tagged function set's value is its member's id, and a call through one dispatches on it.
  const tagLeaf = fnTagLeafId(exprIx)
  if tagLeaf >= 0 {
    fbI32Const(tagLeaf)
    return 0
  }
  const tagArms = fnTagCallArms(exprIx)
  if tagArms.length > 0 {
    if emitFnTagDispatch(body, exprIx, tagArms, fnIx) < 0 { return -1 }
    return 0
  }
  if exprIx == lmaValNode {
    const lmaArg = lmaValArg
    lmaValNode = -1
    return emitExprAsI64(body, lmaArg, lmaCallerFn, ec)
  }
  if mapDeliveryRecorded && exprIx != mapUnboxHeld {
    const mub = mapUnboxTyOf(exprIx)
    if mub >= 0 { return emitMapUnionPayload(body, exprIx, mub, fnIx, ec) }
    if deliveryRetagHas(exprIx) {
      const rtFrom: i32[] = []
      const rtTo: i32[] = []
      mapRetagRowsOf(exprIx, rtFrom, rtTo)
      const wtFrom: i32[] = []
      const wtTo: i32[] = []
      widenRetagRowsOf(exprIx, wtFrom, wtTo)
      return emitMapRetag(body, exprIx, rtFrom, rtTo, wtFrom, wtTo, fnIx, ec)
    }
  }
  const rcRow = recCopyRowAt(exprIx, fnIx)
  if rcRow != -1 { return emitRecCopyInto(body, exprIx, rcRow, fnIx, ec) }
  // The context the nearest enclosing boundary applied, handed to every consumer below.
  const ctx = ec
  // A string-repped literal union reaching an atom-typed destination narrows to its
  // interned id here — one hook rather than one per destination, since `ctx.litUnion`
  // is already the context every atom-typed slot seeds. Without it the store is a
  // `local.set` of a `(ref $array)` into an `i32` slot: invalid wasm at every such destination.
  if ctx.litUnion == 1 {
    // A read of a `const` bound to a literal is that literal, whose id needs no conversion.
    const wideIx = unwrapParen(exprIx)
    if nodeHasWideStrLit(wideIx) {
      const wideLex = quoteLex(nodeWideStrLitText(wideIx))
      return emitStaticLitAtom(body, exprIx, wideLex, fnIx, ec)
    }
    if strReppedLitUnionAt(exprIx, fnIx) {
      // A join whose arms disagree about their rep takes the destination into each arm,
      // under the same context, rather than joining as a string to narrow back (D2199).
      if ifJoinNarrowsPerArm(wideIx) {
        return emitIfExprAs(body, wideIx, fnIx, 127, ec)
      }
      return emitStrToAtom(body, wideIx, fnIx, ec)
    }
    // A join of member literals the checker typed `string`, as a generic body types it, takes
    // the atom destination into each arm too (D3423).
    if ifJoinArmsAllStrLit(wideIx) {
      return emitIfExprAs(body, wideIx, fnIx, 127, ec)
    }
  }
  // …and its nullable twin: a `K | null` place held as a nullable string reaches the niche as
  // `-1` or the present string's id (D5431).
  if ctx.nulLitUnion && nulStrReppedNulLitPlace(exprIx, fnIx) {
    return emitNulStrToNulAtom(body, unwrapParen(exprIx), fnIx, ec)
  }
  // …and a `K | null` read out of a wider box, reaching the atom niche (D3118), a hole's or an
  // instance's read at the type its calls pin.
  if ctx.nulLitUnion {
    const nlk = narrowedNulLitPinBoxKey(exprIx, fnIx)
    if nlk != "" {
      return emitNarrowedNicheRead(body, exprIx, nlk, NICHE_NUL_LIT, fnIx, ec)
    }
  }
  const e = nodeAt(exprIx)
  if e is Index && exprIx != idxSpanNode && idxSpanOn() {
    return emitIndexBanked(body, exprIx, fnIx, ec)
  }
  if e is NumLit { return emitNumLitNode(body, e, exprIx, fnIx, ctx) }
  if e is BoolLit {
    // `boolean` rides in an i32: true=1, false=0 (already decoded into `boolVal`).
    fbI32Const(e.boolVal)
    return 0
  }
  if e is CharLit { return emitCharLitNode(body, e, exprIx, fnIx) }
  if e is Ident {
    if emitIdentNode(body, e, exprIx, fnIx, ctx, ec) < 0 { return -1 }
    return emitReadRecover(exprIx, fnIx)
  }
  if e is Paren { return emitExpr(body, e.parInner, fnIx, ec) }
  if (
    (e is Member || e is Index || callIsMethodAt(exprIx))
    && exprIsNulNone(exprIx, fnIx)
  ) {
    return emitNulNoneRead(body, exprIx, fnIx, ctx, ec)
  }
  if e is Member || e is Index {
    const pnk = placeNicheAtomKind(exprIx, fnIx)
    if pnk >= 0 {
      return emitNarrowedNicheRead(
        body,
        exprIx,
        placeNarrowKeyOf(exprIx),
        pnk,
        fnIx,
        ec,
      )
    }
  }
  if e is Unary { return emitUnaryNode(body, e, exprIx, fnIx, ctx, ec) }
  if e is AsExpr { return emitAsCast(body, e, exprIx, fnIx, ec) }
  if e is Call { return emitCallNode(body, e, exprIx, fnIx, ec) }
  if e is IsExpr { return emitIs(body, exprIx, fnIx, ec) }
  if e is NullLit { return emitNullLitNode(body, e, exprIx, fnIx, ctx, ec) }
  if e is ObjLit { return emitObjLitNode(body, e, exprIx, fnIx, -1, ec) }
  if e is StrLit {
    // A literal-union MEMBER in atom context (`ctx.litUnion`) lowers as its interned i32 id.
    if ctx.litUnion == 1 {
      fbI32Rel(RS_ATOM, internAtom(e.strText))
      return 0
    }
    return emitStr(body, exprIx, fnIx)
  }
  if e is ArrayLit { return emitArr(body, exprIx, fnIx, ec) }
  if e is Index {
    // G8: a map GET `m[k]` (no `??`) — scan, value or 0. A `??` get is fused in the
    // BinExpr branch below (it carries the default).
    if exprMap(e.idxArr, fnIx) {
      // A union-valued map (mv kind 2) reads through the null-tagged box, the same lowering
      // the `const t = m[k]` binding arm takes: a bare `ref.null` miss would leave a
      // consumer's `struct.get $uBox 0` (the tag read) reading a null reference on `m[k] is
      // T`, `!= null`, `== null` and `print(m[k])` alike. The box is the read's own null.
      const ubs = mapReadNarrowableSlot(exprIx, fnIx)
      if ubs >= 0 && mvValKind[ubs] == MVK_UNION {
        if emitMapGetUnionBox(body, e.idxArr, e.idxIndex, fnIx, ec) < 0 {
          return -1
        }
        return emitNarrowedMapReadTail(exprIx, fnIx)
      }
      if emitMapGet(body, e.idxArr, e.idxIndex, fnIx, ec) < 0 { return -1 }
      return emitNarrowedMapReadTail(exprIx, fnIx)
    }
    return emitIndex(body, exprIx, fnIx, ec)
  }
  if e is Member {
    if emitMemberNode(body, e, exprIx, fnIx, ec) < 0 { return -1 }
    return emitReadRecover(exprIx, fnIx)
  }
  // A STANDALONE `?.` (one no enclosing `?? d` / null-test pattern consumed) yields its
  // own `F | null` value — see `emitOptMemberValue`.
  if e is OptMember { return emitOptMemberValue(body, exprIx, fnIx, ec) }
  if e is BinExpr {
    if arithRegionSeen && e.binRegion != 0 {
      return emitBinExprInRegion(body, e, exprIx, fnIx, ec)
    }
    return emitBinExprNode(body, e, exprIx, fnIx, ec)
  }
  if e is FuncDecl {
    // An anonymous `function(...)` literal in value position, lifted to a top-level
    // function by `collectFns` (keeping its name). Construct its closure value.
    const fe = fnStmtsPosOf(exprIx)
    if fe >= 0 { return emitClosureValue(body, fe, fnIx, ec) }
    return emitFail("emitProgram: function literal not lifted")
  }
  if e is IfStmt {
    // An IF-EXPRESSION in value position (`if c { 7 } else { 9 }` — the parser wraps
    // each arm as a one-statement Block; an `else if` chain nests an IfStmt in the
    // else slot). Lowered as `if (result i32)` over the arm VALUES.
    return emitIfExpr(body, exprIx, fnIx, ec)
  }
  // The catch-all must name the expression, not a position: a message written for one
  // caller (the return arm) but reached from anywhere reads as though every unhandled
  // expression happened there. `emitFailAt` puts the caret on the offending node instead,
  // the way every caller that has the node already does.
  emitFailAt("emitProgram: unsupported expression", exprIx)
}

// A condition or a switch scrutinee: never a destination, so it is lowered outside any atom
// context its `if` value is emitted under, where a string literal in it would become an id.
function emitCondExpr(body: u8[], ix: i32, fnIx: i32, ec: ExpCtx) {
  const savedLU = expCtxSwapLitUnion(0, ec)
  const rc = emitExpr(body, ix, fnIx, ec)
  expCtxSwapLitUnion(savedLU, ec)
  rc
}

// The struct row of an if-expression's recorded type, any `| null` peeled: its destination's
// record when the checker adopted one, -1 for a join that is no record.
function ifTypedStructRow(ifIx: i32, fnIx: i32): i32 {
  let t = nodeRepTyAt(ifIx, fnIx)
  if t < 0 { t = nodeTyAt(ifIx, fnIx) }
  if t < 0 { return -1 }
  repRowOfTyStruct(tyPeelNul(t), repScanLim())
}

// `ifExprRefKind` at a destination record `destStruct` (-1 for none): an object-literal then
// arm has no struct row of its own, so it builds at the destination's.
function ifExprRefKindAt(ifIx: i32, fnIx: i32, destStruct: i32): VKind | null {
  const rk = ifExprRefKind(ifIx, fnIx)
  if rk != null || destStruct < 0 { return rk }
  const tv = ifListArmValueIx(ifIx)
  if tv >= 0 && nodeAt(tv) is ObjLit { return "struct" }
  null
}

// Lower an if-expression (`if c then a else b` in value position) onto `body`: cond,
// `if (result <kind>)`, the then-arm value, else the else-arm value (an `else if` chain
// recurses). Both arms are coerced to the branch-join's scalar rep (a mixed `then 1 else
// 2.5` widens to f64); a ref-typed join (string/struct/array) routes to `emitIfExprRef` instead, for the multi-byte `(ref $ht)` blocktype a single numeric byte cannot spell.
function emitIfExpr(body: u8[], ifIx: i32, fnIx: i32, ec: ExpCtx) {
  // The join is classified from its arms' tail values, and a tail naming its own prelude's
  // local reads that local's slot, bound for the classification alone and popped before any
  // arm lowers: in a generic instance the checker's type of such a tail is the type parameter.
  const scoped = armPreludeScopeOpen(ifIx)
  let how = 0
  let vt = 127
  let iun = ""
  let rk: VKind | null = null
  let rslot = -1
  if ifChainAllBareNull(ifIx) || nodeTyIsNullType(ifIx) {
    how = 1
  } else if ifJoinTypedAtom(ifIx, fnIx) || nulStrJoinTakesAtom(ifIx, fnIx, ec) {
    // An atom join lowers every arm in the atom context, whatever rep the arm has alone (D2206).
    how = 2
  } else {
    // A union-valued join is the box whatever reads it, so it takes the box blocktype here and
    // not only at a union destination: an inline `(if c { a } else { b }) != null` reads it (D2250).
    if exprUnion(ifIx, fnIx) { iun = ifJoinUnionNameIn(ifIx, fnIx) }
    if iun != "" {
      how = 3
    } else {
      const destStruct = ifTypedStructRow(ifIx, fnIx)
      rk = ifExprRefKindAt(ifIx, fnIx, destStruct)
      if rk != null {
        how = 4
        rslot = ifExprRefSlot(ifIx, fnIx, rk, destStruct)
      } else {
        vt = ifExprValtype(ifIx, fnIx)
      }
    }
  }
  if scoped { scopePop() }
  // The same dropped null when a member `??` default keeps the join an atom, typed at the union
  // or, with no pin, at a bare valtype (D3290).
  const jpin = nodeTyPinIxOf(ifIx)
  const atomJoin = tyIsLitUnion(jpin) || (how == 0 && jpin < 0)
  if how != 1 && atomJoin && strJoinDropsNulAtom(ifIx, fnIx) {
    return refuseJoinDropsNul(ifIx)
  }
  if how == 1 { return emitAllNullIf(body, ifIx, fnIx, ec) }
  if how == 2 {
    const savedLU = expCtxSwapLitUnion(1, ec)
    const rcA = emitIfExprAs(body, ifIx, fnIx, 127, ec)
    expCtxSwapLitUnion(savedLU, ec)
    return rcA
  }
  if how == 3 { return emitUnionIfValue(body, iun, jpin, ifIx, fnIx, ec) }
  if rk != null { return emitIfExprRef(body, ifIx, fnIx, rk, rslot, ec) }
  emitIfExprAs(body, ifIx, fnIx, vt, ec)
}

// Whether the `if` join at `ifIx`, typed `string | null` or `K | null`, is delivered where a
// `K | null` atom is seeded and every leaf is `null`, a string literal or literal-union typed,
// so each arm lowers in the atom context, as a return does (D5330).
function nulStrJoinTakesAtom(ifIx: i32, fnIx: i32, ec: ExpCtx): boolean {
  if !expCtxHere(ec).nulLitUnion { return false }
  if !nodeTyIsNulString(ifIx) && !nodeTyIsNulLitUnion(ifIx) { return false }
  ifJoinLeavesAtomic(ifIx, fnIx)
}

// Whether every arm value along the `if` chain at `ix`, which has an `else`, is `null`, a string
// literal, or a value of literal-union type.
function ifJoinLeavesAtomic(ix: i32, fnIx: i32): boolean {
  if !ifJoinNarrowsPerArm(ix) { return false }
  const s = nodeAt(ix)
  if s is IfStmt {
    if s.ifElse < 0 || !atomicJoinLeaf(ifArmValueExpr(s.ifThen), fnIx) {
      return false
    }
    if nodeAt(s.ifElse) is IfStmt { return ifJoinLeavesAtomic(s.ifElse, fnIx) }
    return atomicJoinLeaf(ifArmValueExpr(s.ifElse), fnIx)
  }
  false
}

// Whether arm value `ix` is `null`, a string literal, of literal-union type, or a nullable string
// typed `K | null`, which converts to the niche; an arm whose value is another `if` is one when
// that join's leaves are.
function atomicJoinLeaf(ix: i32, fnIx: i32): boolean {
  const u = unwrapParen(ix)
  if u < 0 { return false }
  if exprIsNullLike(u) || nodeAt(u) is StrLit { return true }
  if nodeAt(u) is IfStmt { return ifJoinLeavesAtomic(u, fnIx) }
  exprIsLitAtom(u, fnIx)
    || strReppedLitUnionAt(u, fnIx)
    || nulStrReppedNulLitPlace(u, fnIx)
}

// Whether any arm of the if-expression at `ifIx` binds a local its tail could name; when so,
// a scope frame holding each such local's slot is pushed (else arms first, so the then arm's
// binding of a shared name is the one a read finds). The caller pops it.
function armPreludeScopeOpen(ifIx: i32): boolean {
  const any = chainHasPrelude(ifIx)
  if !any { return false }
  scopePush()
  armPreludeBindChain(ifIx)
  true
}

// An if-expression whose value is the `null` type, by its arms or by the checker's join: it runs
// for its effects alone, and the value is the one `null` the destination seeded — the same rep a
// bare `null` there takes, so no arm can pick a blocktype for it (D2227).
function emitAllNullIf(body: u8[], ifIx: i32, fnIx: i32, ec: ExpCtx) {
  if emitIfForEffect(body, unwrapParen(ifIx), fnIx, ec) < 0 { return -1 }
  emitNullBySeed(ec)
}

// Whether node `ix` is a method call `recv.m(…)`.
function callIsMethodAt(ix: i32): boolean {
  const c = nodeAt(ix)
  if c is Call { return nodeAt(unwrapParen(c.callFn)) is Member }
  false
}

// A field, element or map read, or a `null[]`'s `pop`/`get`, whose type is the `null` unit type:
// the read runs in its own stored rep with the destination's null seeds lifted, is dropped, and
// the value is the `null` the destination seeded, as an ident read of a `null` binding is (D4671).
function emitNulNoneRead(
  body: u8[],
  exprIx: i32,
  fnIx: i32,
  ctx: ExpCtx,
  ec: ExpCtx,
) {
  const outer = expCtxHere(ec)
  const raw = expCtxHere(ec)
  raw.nulBool = false
  raw.nulLitUnion = false
  raw.nulString = false
  raw.litUnion = 0
  expCtxApply(raw, ec)
  let rc = 0
  const e = nodeAt(exprIx)
  if e is Member {
    rc = emitMemberNode(body, e, exprIx, fnIx, ec)
  } else if e is Index {
    if exprMap(e.idxArr, fnIx) {
      rc = emitMapGet(body, e.idxArr, e.idxIndex, fnIx, ec)
    } else {
      rc = emitIndex(body, exprIx, fnIx, ec)
    }
  } else if e is Call {
    rc = emitCallNode(body, e, exprIx, fnIx, ec)
  }
  expCtxApply(outer, ec)
  if rc < 0 { return -1 }
  fbDrop()
  emitNullBySeed(ctx)
}

// Lower a ref-typed if-expression join (string / struct / array) as a value-typed `if`
// with the multi-byte `(ref $ht)` blocktype (`fbValtype`), each arm emitted in that rep.
// Mirrors `emitIfExprAs` (narrowing save/restore, `else if` recursion), except the arm
// emitter re-seeds the per-arm construction context so an `ObjLit`/list-literal arm builds the right shape.
function emitIfExprRef(
  body: u8[],
  ifIx: i32,
  fnIx: i32,
  kind: VKind,
  slot: i32,
  ec: ExpCtx,
) {
  // An `else if` chain is emitted along its spine, so its depth costs no stack (D1990): each
  // link leaves its frame open for the next, and the frames close innermost-first.
  if kind == "str" && strJoinDropsNulAtom(ifIx, fnIx) {
    return refuseJoinDropsNul(ifIx)
  }
  const open: i32[] = []
  let cur = ifIx
  let rc = 1
  let nul = false
  while rc == 1 {
    nul = nul || ifLinkYieldsNull(cur, fnIx)
    rc = emitIfExprRefLink(body, cur, fnIx, kind, slot, open, nul, ec)
    if rc == 1 {
      const link = nodeAt(unwrapParen(cur))
      if link is IfStmt { cur = link.ifElse }
    }
  }
  closeIfChainFrames(open, rc, false)
}

// Whether join arm `armIx` holds a `K | null` atom at this instance: by its pin, or, for a hole
// operand whose arm records no pin of its own, by the operand's pinned type.
function joinArmHoldsNulAtom(armIx: i32, fnIx: i32): boolean {
  if armIx < 0 { return false }
  if nulAtomWidenTexts(armIx).length > 0 { return true }
  tyNulLitUnionMemberTexts(holeOperandTyOf(armIx, fnIx)).length > 0
}

// Refuses the join at `ifIx` that `strJoinDropsNulAtom` names, anchored at its condition, which
// an instance shares with the source: a rebuilt `if` has no token of its own.
function refuseJoinDropsNul(ifIx: i32): i32 {
  let at = ifIx
  const sj = nodeAt(unwrapParen(ifIx))
  if sj is IfStmt { at = sj.ifCond }
  emitFailAt(
    "emitProgram: a string join whose arm is a nullable literal union was typed non-null here",
    at,
  )
}

// Whether the string join at `ifIx` is non-null along its whole chain while an arm widens a
// `K | null` atom, whose `-1` becomes `null`: the join's type dropped a null an arm still holds,
// as a generic's `??` joined with a nullable pin's other side does (D3290).
function strJoinDropsNulAtom(ifIx: i32, fnIx: i32): boolean {
  let cur = ifIx
  let widens = false
  while cur >= 0 {
    if ifLinkYieldsNull(cur, fnIx) { return false }
    const s = nodeAt(unwrapParen(cur))
    cur = -1
    if s is IfStmt {
      if joinArmHoldsNulAtom(ifArmValueExpr(s.ifThen), fnIx) { widens = true }
      if s.ifElse >= 0 {
        if nodeAt(s.ifElse) is IfStmt {
          cur = s.ifElse
        } else {
          if joinArmHoldsNulAtom(ifArmValueExpr(s.ifElse), fnIx) {
            widens = true
          }
        }
      }
    }
  }
  widens
}

// One link of `emitIfExprRef`: 0 or -1 as that function returns, or 1 when the else is another `if`
// and this link's frame is left open (its else restore target pushed onto `open`).
function emitIfExprRefLink(
  body: u8[],
  ifIx: i32,
  fnIx: i32,
  kind: VKind,
  slot: i32,
  open: i32[],
  chainNul: boolean,
  ec: ExpCtx,
) {
  if ifIx < 0 || ifIx >= P.nodes.length {
    return emitFail("emitProgram: expected an if expression")
  }
  if !chainNul {
    const sw = emitIntSwitch(body, ifIx, fnIx, 3, 0, kind, slot, ec)
    if sw < 0 { return -1 }
    if sw > 0 { return 0 }
  }
  const s = nodeAt(ifIx)
  if s is IfStmt {
    // An else-less `if` used as a value is `T | null` (DECISIONS.md "An else-less `if`
    // used as a value"): the false path yields `null`, so the join is nullable and the
    // missing arm is the rep's own null. The blocktype below and the else arm at the bottom are that one fact, twice.
    const noElse = s.ifElse < 0
    const condStart = wLen()
    if emitCondExpr(body, s.ifCond, fnIx, ec) < 0 { return -1 }
    const sg = staticIsGuard(s.ifCond, condStart)
    fbOpenIf() // 0x04 if
    // A join that can yield `null` (`ifLinkYieldsNull`, from this link or one enclosing it)
    // needs a nullable blocktype, else a `(ref null $ht)` arm mismatches the non-null result.
    // A non-nullable join, or a binding whose arms are both non-null, stays non-null and widens on store.
    const nulJoin = chainNul
    if nulJoin {
      fbValtypeNullable(kind, slot) // `(ref null $ht)` result blocktype
    } else {
      fbValtype(kind, slot) // ref result blocktype `(ref $ht)`
    }
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    let rcT = 0
    if sg == 0 {
      rcT = emitDeadValueArm(s.ifThen)
    } else {
      rcT = emitRefIfArm(body, s.ifThen, fnIx, kind, slot, nulJoin, ec)
    }
    if narrowed { restoreNarrow(savedTop) }
    if rcT < 0 { return -1 }
    fbElse() // 0x05 else
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    let rc = 0
    if noElse {
      // The synthesized false path: the rep's own null, matching the nullable blocktype
      // above. `fbRefNullOfKind` is `fbValtypeNullable`'s VALUE twin, so the declaration
      // and the value cannot name different heap types.
      rc = fbRefNullOfKind(kind, slot)
    } else {
      const els = nodeAt(s.ifElse)
      if els is IfStmt {
        if narrowedElse { open.push(savedElseTop) } else { open.push(-1) }
        return 1 // `else if`: the next link, which the caller emits into this open frame
      } else if sg == 1 {
        rc = emitDeadValueArm(s.ifElse)
      } else {
        rc = emitRefIfArm(body, s.ifElse, fnIx, kind, slot, nulJoin, ec)
      }
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    return 0
  }
  emitFail("emitProgram: expected an if expression")
}

// ── if-expression arm prelude ─────────────────────────────────────────────────
// An if-expression arm is a block whose value is its last statement; every statement
// before it is the prelude, which is what lets a binding arm sit in value position (the
// desugared `match u { A{a} => a }` shape). `emitIfArmOpen` pushes the frame and lowers the prelude; the caller emits the value and closes with `emitIfArmClose`, split in two because each arm emitter lowers the value differently while the prelude and frame are shared.

// Push the arm's lexical frame and lower every statement before the arm's value. Returns
// 0, or -1 (the caller still owes `emitIfArmClose`). A prelude declaring a local lowers only
// where `collectLocalsIf` allocated it (`armPreludeBlocks`); any other arm is rejected rather
// than lowered against slots that belong to something else.
function emitIfArmOpen(body: u8[], blockIx: i32, fnIx: i32, ec: ExpCtx) {
  scopePush()
  armNarrowTops.push(narrowTop)
  const b = nodeAt(blockIx)
  if b is Block {
    const stmts = b.blkStmts
    if stmts.length > 1 {
      const decl = armPreludeUnwalkedDecl(blockIx)
      if decl >= 0 {
        return emitFailAt(
          "emitProgram: an if-expression arm declares a local the collect pass did not allocate",
          decl,
        )
      }
    }
    // The prelude delivers nothing to the arm's destination, so it runs outside the atom
    // context the arm's value may be emitted under (D2199).
    const savedLU = expCtxSwapLitUnion(0, ec)
    let i = 0
    while i + 1 < stmts.length {
      preStmtNarrow(stmts[i])
      if emitStmtIn(body, stmts, i, fnIx, ec) < 0 {
        expCtxSwapLitUnion(savedLU, ec)
        return -1
      }
      // A write in the prelude retires what it falsifies, as in any block (D2601).
      pushPostGuardNarrow(stmts[i], fnIx)
      i = i + 1
    }
    expCtxSwapLitUnion(savedLU, ec)
  }
  0
}

// The first node of the arm block at `blockIx` that binds a local no pass allocated, or -1: an
// arm the collect pass walked, or one whose prelude declares nothing, lowers.
function armPreludeUnwalkedDecl(blockIx: i32): i32 {
  if blockIx < 0 { return -1 }
  if armPreludeBlocks[blockIx] ?? false { return -1 }
  firstLocalDeclIn(blockIx)
}

// Pop the arm's lexical frame, passing `rc` through so an arm emitter can close and
// return in one expression.
function emitIfArmClose(rc: i32) {
  scopePop()
  if armNarrowTops.length > 0 {
    restoreNarrow(armNarrowTops[armNarrowTops.length - 1])
    armNarrowTops.pop()
  }
  rc
}

// The narrowing depth at each open arm, restored at its close: a prelude's pushes end with the
// arm, while a retirement it made in place outlives it.
const armNarrowTops: i32[] = []

// The `emitFail` reason for an if-expression arm with no value on the stack: an empty arm
// (no value expression at all), a void call (a well-formed expression yielding nothing), or
// a real statement, each get their own message — "not a single value" would be wrong for
// the void-call case, since such an arm IS a single expression. `what` names the arm flavour so union and variant joins keep their own rep in the text.
function ifArmNoValueFail(what: string, blockIx: i32) {
  const tv = ifArmValueExpr(blockIx)
  if tv < 0 {
    return emitFailAt(
      "emitProgram: " + what + " is empty, so it yields no value",
      blockIx,
    )
  }
  const s = nodeAt(unwrapParen(tv))
  if s is Call {
    return emitFailAt(
      "emitProgram: "
        + what
        + " ends in a void call, which yields no value",
      s.callFn,
    )
  }
  emitFailAt(
    "emitProgram: " + what + " ends in a statement, which yields no value",
    tv,
  )
}

// One arm of a ref-typed if-expression: its prelude, then its tail-value statement emitted
// in the join rep. `nulJoin` is threaded from the caller rather than re-derived, so the
// declaration and the arm's recover cannot disagree about nullness (D1577).
function emitRefIfArm(
  body: u8[],
  blockIx: i32,
  fnIx: i32,
  kind: VKind,
  slot: i32,
  nulJoin: boolean,
  ec: ExpCtx,
) {
  const b = nodeAt(blockIx)
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if ifArmIsValue(tv, fnIx) {
        if emitIfArmOpen(body, blockIx, fnIx, ec) < 0 {
          return emitIfArmClose(-1)
        }
        // A bare `null` arm lowers as the join's own null, not through `emitNullLitNode`'s
        // seed ladder: `fbRefNullOfKind` is `fbValtypeNullable`'s value twin, so the arm and
        // the blocktype cannot name different heap types. Without it an explicit
        // `else { null }` refuses at every ref kind whose null no boundary seed carries (D1560), while the else-less spelling of the same value keeps working.
        if nodeAt(unwrapParen(tv)) is NullLit {
          return emitIfArmClose(fbRefNullOfKind(kind, slot))
        }
        if kind == "struct" {
          // A record value, not a literal, joined into a wider record would need a converting
          // copy, which a delivery of it has nowhere else either (D2100).
          if refIfArmNeedsRecordCopy(tv, slot, fnIx) {
            return emitIfArmClose(
              emitFailAt(
                "emitProgram: this branch hands over a record whose field types differ from the record the branches join to, and a record is shared rather than converted — write the branch as an object literal, or give the value the joined type where it is declared",
                tv,
              ),
            )
          }
        }
        // An ATOM arm in a `string` join widens to its member string (the atom is a
        // bare i32 id; the join blocktype is the string ref) — the if-expression seam
        // of the atom-as-string-subtype widen (`retStrWiden` at returns).
        if kind == "str" && exprIsLitAtom(tv, fnIx) {
          return emitIfArmClose(emitAtomToStr(body, tv, fnIx, ec))
        }
        // A non-null blocktype is a delivery (D1577), so an arm whose rep is the join
        // kind's nullable niche owes the same `ref.as_non_null` the return / argument /
        // binding boundaries make (`nulNicheRecoverOwed`) — a nested-struct field stores
        // `(ref null $S)` though its type is not nullable, so an unrecovered arm pushes that under a `(ref $S)` result: invalid wasm. Under a nullable blocktype nothing is owed.
        const rcV = emitExpr(body, tv, fnIx, ec)
        if rcV >= 0 && !nulJoin {
          if nulNicheRecoverOwed(kind, tv, fnIx) { fbRefAsNonNull() }
        }
        return emitIfArmClose(rcV)
      }
      // An arm ending in an if-expression the value test declines (an else-less one yields
      // `null` on its missing path) joins at this rep too, once this frame can hold its null.
      const inner = unwrapParen(tv)
      if (
        inner >= 0
        && nodeAt(inner) is IfStmt
        && (nulJoin || !ifLinkYieldsNull(inner, fnIx))
      ) {
        if emitIfArmOpen(body, blockIx, fnIx, ec) < 0 {
          return emitIfArmClose(-1)
        }
        return emitIfArmClose(emitIfExprRef(body, inner, fnIx, kind, slot, ec))
      }
    }
    return ifArmNoValueFail("if-expression arm", blockIx)
  }
  emitFail("emitProgram: if-expression arm is not a block")
}

// Lower the if-expression at `ifIx` with a known blocktype byte `kind`, threading it
// through the `else if` recursion so the whole chain shares one result rep.
function emitIfExprAs(body: u8[], ifIx: i32, fnIx: i32, kind: i32, ec: ExpCtx) {
  // An `else if` chain is emitted along its spine, so its depth costs no stack (D1990): each
  // link leaves its frame open for the next, and the frames close innermost-first.
  const open: i32[] = []
  let cur = ifIx
  let rc = 1
  while rc == 1 {
    rc = emitIfExprAsLink(body, cur, fnIx, kind, open, ec)
    if rc == 1 {
      const link = nodeAt(unwrapParen(cur))
      if link is IfStmt { cur = link.ifElse }
    }
  }
  closeIfChainFrames(open, rc, false)
}

// One link of `emitIfExprAs`: 0 or -1 as that function returns, or 1 when the else is another `if`
// and this link's frame is left open (its else restore target pushed onto `open`).
function emitIfExprAsLink(
  body: u8[],
  ifIx: i32,
  fnIx: i32,
  kind: i32,
  open: i32[],
  ec: ExpCtx,
) {
  if !nodeTyIsNullable(ifIx) {
    const sw = emitIntSwitch(body, ifIx, fnIx, 2, kind, "i32", -1, ec)
    if sw < 0 { return -1 }
    if sw > 0 { return 0 }
  }
  if ifIx < 0 { return -1 }
  const s = nodeAt(ifIx)
  if s is IfStmt {
    // An else-less `if` used as a value is `T | null` (DECISIONS.md "An else-less `if`
    // used as a value"). In the i32-blocktype family the false path is a niche sentinel —
    // 2 for `boolean | null`, -1 for a nullable literal union — the same values
    // `emitNullLitNode` writes for a bare `null` there; a bare numeric join has no such spare value, so it keeps the loud refusal rather than inventing a sentinel in an i32.
    const noElseNiche = s.ifElse < 0
    if noElseNiche {
      if !nodeTyIsNulBool(ifIx) && !nodeTyIsNulLitUnion(ifIx) {
        return emitFail("emitProgram: if-expression requires an else arm")
      }
    }
    const condStart = wLen()
    if emitCondExpr(body, s.ifCond, fnIx, ec) < 0 { return -1 }
    const sg = staticIsGuard(s.ifCond, condStart)
    fbIf(kind) // 0x04 if, <kind> result blocktype
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    let rcT = 0
    if sg == 0 {
      rcT = emitDeadValueArm(s.ifThen)
    } else {
      rcT = emitNicheArmValueAs(body, s.ifThen, fnIx, kind, ifIx, ec)
    }
    if narrowed { restoreNarrow(savedTop) }
    if rcT < 0 { return -1 }
    fbElse() // 0x05 else
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    let rc = 0
    if noElseNiche {
      if nodeTyIsNulBool(ifIx) { fbI32Const(2) } else { fbI32Const(0 - 1) }
    } else {
      const els = nodeAt(s.ifElse)
      if els is IfStmt {
        if narrowedElse { open.push(savedElseTop) } else { open.push(-1) }
        return 1 // `else if`: the next link, which the caller emits into this open frame
      } else if sg == 1 {
        rc = emitDeadValueArm(s.ifElse)
      } else {
        rc = emitNicheArmValueAs(body, s.ifElse, fnIx, kind, ifIx, ec)
      }
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    return 0
  }
  emitFail("emitProgram: expected an if expression")
}

// `emitBlockValueAs` for an arm of the i32-family join at `ifIx`. A bare `null` arm reaches
// `emitNullLitNode`, whose niche arms need a boundary seed an un-annotated binding never sets
// (D1560), so it is seeded from the join's own type, scoped to that tail and to either arm (D2227).
function emitNicheArmValueAs(
  body: u8[],
  armIx: i32,
  fnIx: i32,
  kind: i32,
  ifIx: i32,
  ec: ExpCtx,
) {
  const saved = expCtxHere(ec)
  if exprIsNullLike(ifArmValueExpr(armIx)) {
    const seeded = expCtxHere(ec)
    if nodeTyIsNulBool(ifIx) { seeded.nulBool = true }
    if nodeTyIsNulLitUnion(ifIx) { seeded.nulLitUnion = true }
    expCtxApply(seeded, ec)
  }
  const rc = emitBlockValueAs(body, armIx, fnIx, kind, ec)
  const out = expCtxHere(ec)
  out.nulBool = saved.nulBool
  out.nulLitUnion = saved.nulLitUnion
  expCtxApply(out, ec)
  rc
}

// The VALUE of an if-expression arm: its prelude, then its tail-value statement emitted
// as an expression COERCED to the if-expression's result rep `kind` (so an i32-literal
// arm widens into an f64/f32/i64 join). The i32 default emits the value as-is.
function emitBlockValueAs(
  body: u8[],
  blockIx: i32,
  fnIx: i32,
  kind: i32,
  ec: ExpCtx,
) {
  // An arm's value may clear the atom context (a `??` does), and the next arm must still
  // see it, so each arm hands the context back as it found it (D2199).
  const savedLU = expCtxHere(ec).litUnion
  const rc = emitBlockValueAsGo(body, blockIx, fnIx, kind, ec)
  expCtxSwapLitUnion(savedLU, ec)
  rc
}

function emitBlockValueAsGo(
  body: u8[],
  blockIx: i32,
  fnIx: i32,
  kind: i32,
  ec: ExpCtx,
) {
  const b = nodeAt(blockIx)
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if ifArmIsValue(tv, fnIx) {
        if emitIfArmOpen(body, blockIx, fnIx, ec) < 0 {
          return emitIfArmClose(-1)
        }
        if kind == 124 {
          return emitIfArmClose(emitExprAsF64(body, tv, fnIx, ec))
        }
        if kind == 125 {
          return emitIfArmClose(emitExprAsF32(body, tv, fnIx, ec))
        }
        if kind == 126 {
          return emitIfArmClose(emitExprAsI64(body, tv, fnIx, ec))
        }
        return emitIfArmClose(emitExpr(body, tv, fnIx, ec))
      }
    }
    return ifArmNoValueFail("if-expression arm", blockIx)
  }
  emitFail("emitProgram: if-expression arm is not a block")
}

// ── nullable / value-union if-expression in binding-init position ─────────────
// `const x: i32 | null = if c then 5 else null` lowers as a void `if` whose every arm
// writes the binding's own local directly — no value-typed-if blocktype and no scratch
// slot needed, since the destination local is the stash. `rep` 0 is the value-union box, 1 a `string | null` ref; `boolean | null` is not a supported local rep here yet.

// Emit ONE arm value (`valIx`) in the binding's nullable rep, then `local.set idx`.
function emitNulArmToLocal(
  body: u8[],
  valIx: i32,
  idx: i32,
  rep: i32,
  unionName: string,
  unionTy: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if valIx < 0 {
    return emitFail("emitProgram: if-expression arm is not a value")
  }
  if rep == 0 {
    // The binding's local is the union box `(ref $uBox)`, so a concrete-variant arm (a
    // kind-8 `(ref $variant)`) must be boxed to match, exactly as `emitUnionIfArm` and a
    // variant return do. `emitUnionBoxArg` boxes a variant ref and defers every other shape
    // to `emitUnionCoerce` — plain `emitUnionCoerce` alone would store the raw variant ref, invalid wasm.
    if emitUnionBoxArg(body, unionName, unionTy, valIx, fnIx, ec) < 0 {
      return -1
    }
  } else if rep == 1 {
    // rep 1: a `string | null` arm — a non-null string passes through, a bare `null`
    // lowers as `ref.null $sTypeIdx`. A literal-union atom arm is the one non-null value
    // that does not pass through: its rep is an i32 id, so it widens to a string first —
    // this binding-init path is routed here by `emitLetDeclStmt` and never reaches the if-arm widen at the join.
    if exprIsLitAtom(valIx, fnIx) {
      if emitStrValue(body, valIx, fnIx, ec) < 0 { return -1 }
    } else {
      const nsArmCtx = expCtxHere(ec)
      nsArmCtx.nulString = true
      if emitExprExpect(body, valIx, fnIx, nsArmCtx) < 0 { return -1 }
    }
  } else {
    // rep 2: a `boolean | null` arm — a non-null boolean rides its i32 0/1; a bare
    // `null` lowers as the niche sentinel 2 (`nulBool`).
    const nbArmCtx = expCtxHere(ec)
    nbArmCtx.nulBool = true
    if emitExprExpect(body, valIx, fnIx, nbArmCtx) < 0 { return -1 }
  }
  fbLocalSet(idx)
  0
}

// Emit the rep's NULL (the else-less false path / a synthesized null arm), then
// `local.set idx`: the value-union null-tagged box (rep 0), or `ref.null $aTypeIdx`
// for a `string | null` (rep 1).
function emitNulNullToLocal(_body: u8[], idx: i32, rep: i32) {
  if rep == 0 {
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone() // the payload slot is unread under the null tag
    fbStructNew(uBoxIdx)
  } else if rep == 1 {
    fbRefNull(sTypeIdx)
  } else {
    // rep 2: a `boolean | null` else-less / explicit-null path — the niche sentinel 2.
    fbI32Const(2)
  }
  fbLocalSet(idx)
  0
}

// One arm of a nullable if-BINDING: its prelude (`emitIfArmOpen`), then its tail value
// written into the binding's local. The binding-init counterpart of `emitBlockValueAs` —
// the arm is a Block here too, so a `const` it declares is lowered the same way.
function emitNulArmBlockToLocal(
  body: u8[],
  blockIx: i32,
  idx: i32,
  rep: i32,
  unionName: string,
  unionTy: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitIfArmOpen(body, blockIx, fnIx, ec) < 0 { return emitIfArmClose(-1) }
  emitIfArmClose(
    emitNulArmToLocal(
      body,
      ifArmValueExpr(blockIx),
      idx,
      rep,
      unionName,
      unionTy,
      fnIx,
      ec,
    ),
  )
}

// Lower a nullable/value-union if-EXPRESSION binding init at `ifIx` into local `idx`:
// a void `if` whose then-arm writes the binding (narrowed by the condition), and whose
// else writes the else-arm value, a nested `else if` (recurse), or — when there is no
// else — the rep's null.
function emitNullableIfBinding(
  body: u8[],
  ifIx: i32,
  idx: i32,
  rep: i32,
  unionName: string,
  unionTy: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // An `else if` chain is emitted along its spine, so its depth costs no stack (D1990): each
  // link leaves its frame open for the next, and the frames close innermost-first.
  const open: i32[] = []
  let cur = ifIx
  let rc = 1
  while rc == 1 {
    rc = emitNullableIfBindingLink(
      body,
      cur,
      idx,
      rep,
      unionName,
      unionTy,
      fnIx,
      open,
      ec,
    )
    if rc == 1 {
      const link = nodeAt(unwrapParen(cur))
      if link is IfStmt { cur = link.ifElse }
    }
  }
  closeIfChainFrames(open, rc, false)
}

// One link of `emitNullableIfBinding`: 0 or -1 as that function returns, or 1 when the else is another `if`
// and this link's frame is left open (its else restore target pushed onto `open`).
function emitNullableIfBindingLink(
  body: u8[],
  ifIx: i32,
  idx: i32,
  rep: i32,
  unionName: string,
  unionTy: i32,
  fnIx: i32,
  open: i32[],
  ec: ExpCtx,
) {
  const s = nodeAt(unwrapParen(ifIx))
  if s is IfStmt {
    if emitCondExpr(body, s.ifCond, fnIx, ec) < 0 { return -1 }
    fbIf(64) // 0x04 if, 0x40 void blocktype
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const rc = emitNulArmBlockToLocal(
      body,
      s.ifThen,
      idx,
      rep,
      unionName,
      unionTy,
      fnIx,
      ec,
    )
    if narrowed { restoreNarrow(savedTop) }
    if rc < 0 { return -1 }
    fbElse() // 0x05 else
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    let erc = 0
    if s.ifElse < 0 {
      erc = emitNulNullToLocal(body, idx, rep)
    } else {
      const els = nodeAt(s.ifElse)
      if els is IfStmt && !ifJoinAdaptsScalar(s.ifElse, fnIx) {
        if narrowedElse { open.push(savedElseTop) } else { open.push(-1) }
        return 1 // `else if`: the next link, which the caller emits into this open frame
      } else if els is IfStmt {
        erc = emitNulArmToLocal(
          body,
          s.ifElse,
          idx,
          rep,
          unionName,
          unionTy,
          fnIx,
          ec,
        )
      } else {
        erc = emitNulArmBlockToLocal(
          body,
          s.ifElse,
          idx,
          rep,
          unionName,
          unionTy,
          fnIx,
          ec,
        )
      }
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if erc < 0 { return -1 }
    fbEnd() // 0x0b end
    return 0
  }
  emitFail("emitProgram: expected an if expression")
}

// ── the union-box binding sink ────────────────────────────────────────────────
// `const u: A | B = if c { a } else { b }` needs the box built once after the merge, not
// once per arm plus a pre-seed (three allocation sites means Heap2Local can scalarize none
// of them, so the box survives as a real heap object). The sink writes each arm's tag and payload into a shared pair and does the single `struct.new` after the `if`; gated on `unionIfBindingAllBox` since an arm that already passes a box through would otherwise be unboxed and rebuilt for nothing.

// Does every terminal arm of the union-box if-binding at `ifIx` CONSTRUCT its box? An
// `else if` chain link recurses; an else-LESS chain contributes the rep's null box, which
// is a construction like any other.
function unionIfBindingAllBox(ifIx: i32, fnIx: i32) {
  const s = nodeAt(unwrapParen(ifIx))
  if s is IfStmt {
    if !unionIfArmBoxes(ifArmValueExpr(s.ifThen), fnIx) { return false }
    if s.ifElse < 0 { return true }
    const els = nodeAt(s.ifElse)
    if els is IfStmt && !ifJoinAdaptsScalar(s.ifElse, fnIx) {
      return unionIfBindingAllBox(s.ifElse, fnIx)
    }
    if els is IfStmt { return unionIfArmBoxes(s.ifElse, fnIx) }
    return unionIfArmBoxes(ifArmValueExpr(s.ifElse), fnIx)
  }
  false
}

// The two arm shapes whose lowering does not end in `struct.new $uBox`: a value that is
// already a box (`emitUnionCoerce` passes it through untouched), and a nested if-expression
// (`emitUnionIfValue`'s value-typed `if`, whose last instruction is the frame's `end`).
// Every other shape bottoms out in the box's own construction.
function unionIfArmBoxes(valIx: i32, fnIx: i32) {
  if valIx < 0 { return false }
  if exprUnion(valIx, fnIx) { return false }
  const v = nodeAt(unwrapParen(valIx))
  if v is IfStmt { return ifJoinAdaptsScalar(unwrapParen(valIx), fnIx) }
  true
}

// Emit ONE arm value into the sink pair: the arm's box, unwritten by the peephole down to
// its two operands. The BACKSTOP (an arm that did not end in a construction after all)
// stores the box it did produce into the binding's own slot and reads the pair back out of
// it — correct, and costing the rebuild after the `if` that the gate exists to avoid.
function emitUnionArmToPair(
  body: u8[],
  valIx: i32,
  idx: i32,
  unionName: string,
  unionTy: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if valIx < 0 {
    return emitFail("emitProgram: if-expression arm is not a value")
  }
  if emitUnionBoxArg(body, unionName, unionTy, valIx, fnIx, ec) < 0 {
    return -1
  }
  if uBoxNewIsLast() {
    uBoxSinkToPair()
    return 0
  }
  fbLocalSet(idx)
  fbLocalGet(idx)
  fbStructGet(uBoxIdx, 0) // field 0: tag
  fbLocalSet(unionSinkBase)
  fbLocalGet(idx)
  fbStructGet(uBoxIdx, 1) // field 1: payload (anyref)
  fbLocalSet(unionSinkBase + 1)
  0
}

// The rep's NULL into the sink pair (the else-less false path): the null tag and the
// unread payload slot, written directly rather than through a box the merge would discard.
function emitUnionNullToPair() {
  fbI32Rel(RS_TAG, nullBoxTag())
  fbLocalSet(unionSinkBase)
  fbRefNullNone() // the payload slot is unread under the null tag
  fbLocalSet(unionSinkBase + 1)
  0
}

// One arm of a union-box if-BINDING sink: its prelude (`emitIfArmOpen`), then its tail
// value written into the sink pair. The prelude precedes the arm's box construction, so
// the `uBoxNewIsLast` peephole still sees the construction as the last instruction.
function emitUnionArmBlockToPair(
  body: u8[],
  blockIx: i32,
  idx: i32,
  unionName: string,
  unionTy: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitIfArmOpen(body, blockIx, fnIx, ec) < 0 { return emitIfArmClose(-1) }
  emitIfArmClose(
    emitUnionArmToPair(
      body,
      ifArmValueExpr(blockIx),
      idx,
      unionName,
      unionTy,
      fnIx,
      ec,
    ),
  )
}

// `emitNullableIfBinding`'s rep-0 shape with every arm writing the sink pair instead of
// the binding's slot. The caller performs the one `struct.new` after the `if`.
function emitUnionIfBindingSink(
  body: u8[],
  ifIx: i32,
  idx: i32,
  unionName: string,
  unionTy: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // An `else if` chain is emitted along its spine, so its depth costs no stack (D1990): each
  // link leaves its frame open for the next, and the frames close innermost-first.
  const open: i32[] = []
  let cur = ifIx
  let rc = 1
  while rc == 1 {
    rc = emitUnionIfBindingSinkLink(
      body,
      cur,
      idx,
      unionName,
      unionTy,
      fnIx,
      open,
      ec,
    )
    if rc == 1 {
      const link = nodeAt(unwrapParen(cur))
      if link is IfStmt { cur = link.ifElse }
    }
  }
  closeIfChainFrames(open, rc, false)
}

// One link of `emitUnionIfBindingSink`: 0 or -1 as that function returns, or 1 when the else is another `if`
// and this link's frame is left open (its else restore target pushed onto `open`).
function emitUnionIfBindingSinkLink(
  body: u8[],
  ifIx: i32,
  idx: i32,
  unionName: string,
  unionTy: i32,
  fnIx: i32,
  open: i32[],
  ec: ExpCtx,
) {
  const s = nodeAt(unwrapParen(ifIx))
  if s is IfStmt {
    if emitCondExpr(body, s.ifCond, fnIx, ec) < 0 { return -1 }
    fbIf(64) // 0x04 if, 0x40 void blocktype
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const rc = emitUnionArmBlockToPair(
      body,
      s.ifThen,
      idx,
      unionName,
      unionTy,
      fnIx,
      ec,
    )
    if narrowed { restoreNarrow(savedTop) }
    if rc < 0 { return -1 }
    fbElse() // 0x05 else
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    let erc = 0
    if s.ifElse < 0 {
      erc = emitUnionNullToPair()
    } else {
      const els = nodeAt(s.ifElse)
      if els is IfStmt && !ifJoinAdaptsScalar(s.ifElse, fnIx) {
        if narrowedElse { open.push(savedElseTop) } else { open.push(-1) }
        return 1 // `else if`: the next link, which the caller emits into this open frame
      } else if els is IfStmt {
        erc = emitUnionArmToPair(
          body,
          s.ifElse,
          idx,
          unionName,
          unionTy,
          fnIx,
          ec,
        )
      } else {
        erc = emitUnionArmBlockToPair(
          body,
          s.ifElse,
          idx,
          unionName,
          unionTy,
          fnIx,
          ec,
        )
      }
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if erc < 0 { return -1 }
    fbEnd() // 0x0b end
    return 0
  }
  emitFail("emitProgram: expected an if expression")
}

// The expression whose rep the `emitExprAs*` widenings must classify: an assignment in
// value position classifies by the re-read of its target cell (`asgReadNode`), since `g = 7`
// leaves the cell's rep on the stack (`emitBinExprNode`'s `=` arm stores, then re-reads the
// target). Only the classification moves — the right-hand side still evaluates once — so a widening cell in any value position is not double-widened (`i64.extend_i32_s` over an already-i64 value: invalid wasm).
function widenClassifyExpr(exprIx: i32, fnIx: i32) {
  const wce = nodeAt(unwrapParen(exprIx))
  if wce is BinExpr {
    if wce.binOp == "=" {
      // Only an IDENT target is a value expression here (`emitBinExprNode` rejects the
      // rest), and its rep is the one `asgReadNode` names for the re-read.
      const wct = nodeAt(wce.binLeft)
      if wct is Ident { return asgReadNode(unwrapParen(exprIx), fnIx) }
    }
  }
  exprIx
}

// Builds the number literal at `exprIx` (parens and minuses peeled) as one `<w>.const`; -2 when
// `exprIx` is no literal. `w` is the checker's type of the position reading it, for a literal node
// read at several widths: a numeric-union member's operator, or a numeric operator's operand.
// Re-encoding keeps a hex literal past I32_MAX the value it spells.
function emitNumLitAs(exprIx: i32, w: string): i32 {
  if cexLitPeel(exprIx) < 0 { return -2 }
  emitSignedNumLitAt(unwrapParen(exprIx), w)
}

// The assignment at `exprIx` whose value is its right side's number literal (`asgLitWidth`):
// stored, then that literal built at `w`, the checker's width of the position reading it; -2
// for any other node.
function emitAsgLitAs(
  body: u8[],
  exprIx: i32,
  w: string,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  const ix = unwrapParen(exprIx)
  if ix < 0 || ix >= P.nodes.length || asgLitWidth(ix, fnIx) == "" { return -2 }
  const a = nodeAt(ix)
  if !(a is BinExpr) { return -2 }
  if emitAssign(body, ix, fnIx, ec) < 0 { return -1 }
  emitNumLitAs(a.binRight, w)
}

// A literal in the body of a generic or hole instance, which the checker typed once at its
// template, is built at the width `w` its delivery widens to; -2 for any other node. Everywhere
// else a literal is built at its own checker type.
function emitInstLitAs(exprIx: i32, w: string, fnIx: i32): i32 {
  if cexLitPeel(exprIx) < 0 || !fnInPinnedInstance(fnIx) { return -2 }
  emitSignedNumLitAt(unwrapParen(exprIx), w)
}

// Emit the expression at `exprIx` as an i64 value: an expression that already yields i64 emits
// as-is, and any other i32 source is emitted then sign-extended (`i64.extend_i32_s`).
export function emitExprAsI64(body: u8[], exprIx: i32, fnIx: i32, ec: ExpCtx) {
  const lit = emitInstLitAs(exprIx, "i64", fnIx)
  if lit != -2 { return lit }
  const asgLit = emitAsgLitAs(body, exprIx, "i64", fnIx, ec)
  if asgLit != -2 { return asgLit }
  const inner = unwrapParen(exprIx)
  const rw64 = asgRadixWidePrim(inner, fnIx)
  if rw64 != "" { return emitAsgRadixAs(body, inner, rw64, "i64", fnIx, ec) }
  if exprIsI64(widenClassifyExpr(exprIx, fnIx), fnIx) {
    // A join whose wide arm claims `i64` can still be a box of numbers (D3517).
    if njBoxWidens(exprIx, fnIx) {
      return emitNumUnionConvert(body, exprIx, 3, fnIx, ec)
    }
    return emitExpr(body, exprIx, fnIx, ec)
  }
  // A numeric union converts at the member it holds; anything else is an i32, sign-extended.
  if njWidensOut(exprIx, fnIx) {
    return emitNumUnionConvert(body, exprIx, 3, fnIx, ec)
  }
  if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
  fbI64ExtendI32S()
  0
}

// Emit the expression at `exprIx` as an f64 value: already-f64 emits as-is, otherwise a
// narrower source widens at the boundary — f32 via `f64.promote_f32`, i32 via
// `f64.convert_i32_s` (both lossless, permitted variable widenings), i64 via
// `f64.convert_i64_s` for an i64 literal only (a variable i64→f64 is lossy above 2^53 and the checker rejects it).
export function emitExprAsF64(body: u8[], exprIx: i32, fnIx: i32, ec: ExpCtx) {
  // An f32 source promotes losslessly to f64, checked before the f64 fast-path: an
  // arithmetic expression with an f32 operand emits as f32, yet `exprIsF64` also claims it
  // via its float literal — without this check the f64 fast-path would emit f32 into an f64
  // slot and trap. A pure-f64 expression is not `exprIsF32`, so it still takes the fast path.
  const asgLit = emitAsgLitAs(body, exprIx, "f64", fnIx, ec)
  if asgLit != -2 { return asgLit }
  const rw64f = asgRadixWidePrim(unwrapParen(exprIx), fnIx)
  if rw64f != "" { return emitAsgRadixAs(body, exprIx, rw64f, "f64", fnIx, ec) }
  const f64Cls = widenClassifyExpr(exprIx, fnIx)
  if exprIsF32(f64Cls, fnIx) {
    if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
    fbF64PromoteF32()
    return 0
  }
  if exprIsF64(f64Cls, fnIx) || exprIsI64(f64Cls, fnIx) {
    if njBoxWidens(exprIx, fnIx) {
      return emitNumUnionConvert(body, exprIx, 4, fnIx, ec)
    }
  }
  if exprIsF64(f64Cls, fnIx) { return emitExpr(body, exprIx, fnIx, ec) }
  const lit = emitInstLitAs(exprIx, "f64", fnIx)
  if lit != -2 { return lit }
  // An i64 source converts (signed) to f64.
  if exprIsI64(f64Cls, fnIx) {
    if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
    fbF64ConvertI64S()
    return 0
  }
  // A numeric union converts at the member it holds.
  if njWidensOut(exprIx, fnIx) {
    return emitNumUnionConvert(body, exprIx, 4, fnIx, ec)
  }
  // Otherwise an i32 expression (or integer literal): convert (signed) to f64.
  if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
  fbF64ConvertI32S()
  0
}

// Emit the expression at `exprIx` as an f32 value: already-f32 emits as-is; otherwise an i32
// expression converts with `f32.convert_i32_s`. The checker refuses an i32 variable into f32
// (lossy above 2^24), so only an exactness-gated literal takes the convert.
export function emitExprAsF32(body: u8[], exprIx: i32, fnIx: i32, ec: ExpCtx) {
  const lit = emitInstLitAs(exprIx, "f32", fnIx)
  if lit != -2 { return lit }
  const asgLit = emitAsgLitAs(body, exprIx, "f32", fnIx, ec)
  if asgLit != -2 { return asgLit }
  const rw32f = asgRadixWidePrim(unwrapParen(exprIx), fnIx)
  if rw32f != "" { return emitAsgRadixAs(body, exprIx, rw32f, "f32", fnIx, ec) }
  // An already-f32-valued expression (a variable, an f32 arithmetic / call result) emits
  // directly. An assignment classifies by its target cell (`widenClassifyExpr`), as the
  // i64/f64 widenings do.
  if exprIsF32(widenClassifyExpr(exprIx, fnIx), fnIx) {
    if njBoxWidens(exprIx, fnIx) {
      return emitNumUnionConvert(body, exprIx, 5, fnIx, ec)
    }
    return emitExpr(body, exprIx, fnIx, ec)
  }
  // A numeric union converts at the member it holds; anything else is an i32, converted.
  if njWidensOut(exprIx, fnIx) {
    return emitNumUnionConvert(body, exprIx, 5, fnIx, ec)
  }
  if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
  fbF32ConvertI32S()
  0
}

// Lower `exprIx` in the rep of a value atom of kind `k` — the emit half of
// `valBlockTypeOfKind`'s blocktype: i64/f64/f32 route through their widening helper,
// every other kind (i32, boolean, the ref atoms) through `emitExpr`. Kept beside that
// ladder so the two halves of "what rep does this arm produce" move together.
function emitExprAsKind(
  body: u8[],
  exprIx: i32,
  k: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if k == 3 { return emitExprAsI64(body, exprIx, fnIx, ec) }
  if k == 4 { return emitExprAsF64(body, exprIx, fnIx, ec) }
  if k == 5 { return emitExprAsF32(body, exprIx, fnIx, ec) }
  emitExpr(body, exprIx, fnIx, ec)
}

// ── the numeric exact-or-fail cast (D1041) ────────────────────────────────────
// A numeric `as` to an integer target succeeds iff the value is exactly representable
// there, else fails as the trio fails everywhere (`as?` null, `as!` traps, bare `as`
// propagates). The test is "integral and in range", not a round-trip compare — a round-trip is exact only for `f64 → i32`, not the other three float pairs, since the convert-back rounds and admits a value the target cannot hold; NaN fails integrality for free.

// `dom` is the exactness domain, not the rep target: `u8` names 0..255 inside the `i32` (D1587);
// both `u8` bounds convert exactly at f32 and f64, so its upper test is `<=` at both.
// `integral` drops the integrality compare for an operand integral by construction (SP-056);
// NaN then fails the range test instead.
function emitNumExactTest(src: string, dom: string, integral: boolean) {
  const u8Dom = dom == "u8"
  if src == "i64" {
    // `i64 -> i32` / `i64 -> u8`: a pure range test, and never a wrap. The bounds are exact
    // i64 literals. An i32 SOURCE arrives here too — `emitNumExactCast` widens it, exactly.
    fbLocalGet(numCastStashSlot(2))
    if u8Dom {
      fbI64Const(0, 0) // i64.const 0
    } else {
      fbI64Const(-1, -2147483648) // i64.const -2147483648
    }
    fbI64GeS()
    fbLocalGet(numCastStashSlot(2))
    if u8Dom {
      fbI64Const(0, 255) // i64.const 255
    } else {
      fbI64Const(0, 2147483647) // i64.const 2147483647
    }
    fbI64LeS()
    fbI32And()
    return 0
  }
  const isF32 = src == "f32"
  let slot = numCastStashSlot(0)
  if isF32 { slot = numCastStashSlot(1) }
  // INTEGRAL: `trunc(d) == d`. A fraction fails it, and so does NaN (no comparison involving
  // NaN is true), which is the ruling's verdict on a NaN cast arriving for free.
  if !integral {
    fbLocalGet(slot)
    if isF32 { fbF32Trunc() } else { fbF64Trunc() }
    fbLocalGet(slot)
    if isF32 { fbF32Eq() } else { fbF64Eq() }
  }
  // IN RANGE, lower: `d >= convert(<domain>::MIN)`. ±Inf fails one side or the other.
  fbLocalGet(slot)
  if u8Dom {
    fbI32Const(0)
    if isF32 { fbF32ConvertI32S() } else { fbF64ConvertI32S() }
  } else if dom == "i32" {
    fbI32Const(-2147483648)
    if isF32 { fbF32ConvertI32S() } else { fbF64ConvertI32S() }
  } else {
    fbI64Const(-2147483648, 0) // i64.const -9223372036854775808
    if isF32 { fbF32ConvertI64S() } else { fbF64ConvertI64S() }
  }
  if isF32 { fbF32Ge() } else { fbF64Ge() }
  if !integral { fbI32And() }
  // IN RANGE, upper — `<=` only where the converted maximum is exact (see the table above).
  fbLocalGet(slot)
  if u8Dom {
    fbI32Const(255)
    if isF32 { fbF32ConvertI32S() } else { fbF64ConvertI32S() }
  } else if dom == "i32" {
    fbI32Const(2147483647)
    if isF32 { fbF32ConvertI32S() } else { fbF64ConvertI32S() }
  } else {
    fbI64Const(2147483647, -1) // i64.const 9223372036854775807
    if isF32 { fbF32ConvertI64S() } else { fbF64ConvertI64S() }
  }
  if u8Dom {
    if isF32 { fbF32Le() } else { fbF64Le() }
  } else if isF32 {
    fbF32Lt()
  } else if dom == "i64" {
    fbF64Lt()
  } else {
    fbF64Le()
  }
  fbI32And()
  0
}

// The conversion itself, reached only where `emitNumExactTest` has already proved it
// cannot fail, so the trapping instructions are used rather than the saturating ones: an
// operand here is in range by construction, and if that is ever false a trap is the
// honest outcome, not a silent clamp.
function emitNumExactConvert(src: string, tgt: string) {
  if src == "i64" {
    fbLocalGet(numCastStashSlot(2))
    fbI32WrapI64()
    return 0
  }
  if src == "f32" {
    fbLocalGet(numCastStashSlot(1))
    if tgt == "i32" { fbI32TruncF32S() } else { fbI64TruncF32S() }
    return 0
  }
  fbLocalGet(numCastStashSlot(0))
  if tgt == "i32" { fbI32TruncF64S() } else { fbI64TruncF64S() }
  0
}

// The `as!` trap's reason, `as! <tgt> at <line>:<col>: not exact`, printed by the one
// `__as_fail__` body from the site's place and the domain's row, so a site costs one call
// (SP-056). Line 0 names no place. The caller emits the trap itself.
function emitNumCastTrapMsg(exprIx: i32, tgt: string) {
  if gHelpAsFail < 0 || gImports < 4 {
    return emitFail(
      "emitProgram: `as! " + tgt + "` with no `__as_fail__` reserved",
    )
  }
  let row = 0
  while row < AS_FAIL_DOMS.length && AS_FAIL_DOMS[row] != tgt { row = row + 1 }
  if row == AS_FAIL_DOMS.length {
    return emitFail(
      "emitProgram: `as! " + tgt + "` has no `__as_fail__` domain row",
    )
  }
  let line = 0
  let col = 0
  if exprIx >= 0 && exprIx < nodeToks.length {
    const at = nodeToks[exprIx]
    if at >= 0 && at < P.toks.length {
      line = P.toks[at].line
      col = P.toks[at].col + 1
    }
  }
  fbI32Const(line)
  fbI32Const((col << 3) | row)
  fbCall(gHelpAsFail)
  0
}

// The `null` node a bare `as`'s early return hands to `emitReturnValue`, so the return
// path's own seeds (`emitNullLitNode`'s rep table) serve it rather than a second ladder
// guessing a null encoding per rep. Minted fresh per site, not cached in a module `let` —
// a cached arena index outliving its program is the hazard `emitProgram`'s sidecar-reset guards against, and the LSP compiles many programs through one instance.
function numCastNullNode(): i32 { mkNull("null", -1) }

// The three modes, over one shared test and conversion: `as?` is a value-producing `if`
// whose result is the `{tag, payload}` union box (the same rep `emitUnionCoerce`'s
// `NullLit` builds, so every delivery position already knows the null); `as!` is the
// reason, `unreachable`, then the conversion; a bare `as` returns the enclosing function's own null (built by the return path) then the conversion.
function emitNumExactCast(
  body: u8[],
  e: AsExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  emitNumExactCastFrom(body, e, exprIx, asExprNumSrcName(exprIx), fnIx, ec)
}

// `emitNumExactCast` from the source rep `srcIn`, which a type-parameter operand reads off
// its instance rather than its recorded type.
function emitNumExactCastFrom(
  body: u8[],
  e: AsExpr,
  exprIx: i32,
  srcIn: string,
  fnIx: i32,
  ec: ExpCtx,
) {
  const tgt = asExprNumTgtName(exprIx)
  // The domain and the target are two names (D1587): the domain decides the range test and
  // the `as!` message, the target decides the conversion opcode and the box row. At `u8`
  // they differ; everywhere else they are the same string.
  const dom = asExprNumCastDomain(exprIx)
  // An i32 source exists only at the `u8` domain, and rides the i64 path rather than a
  // fourth scratch slot: `i64.extend_i32_s` is exact for every i32, the range test is the
  // same two compares, and `i32.wrap_i64` brings the proven 0..255 value back unchanged.
  let src = srcIn
  if src == "i32" { src = "i64" }
  // Stage the operand ONCE — the test reads it up to three times and it is typically a call.
  if src == "i64" {
    if emitExprAsKind(body, e.asObj, 3, fnIx, ec) < 0 { return -1 }
    fbLocalSet(numCastStashSlot(2))
  } else if src == "f32" {
    if emitExprAsKind(body, e.asObj, 5, fnIx, ec) < 0 { return -1 }
    fbLocalSet(numCastStashSlot(1))
  } else {
    if emitExprAsKind(body, e.asObj, 4, fnIx, ec) < 0 { return -1 }
    fbLocalSet(numCastStashSlot(0))
  }
  const integral = src != "i64" && exprIsIntegralFloat(e.asObj, fnIx)
  if emitNumExactTest(src, dom, integral) < 0 { return -1 }
  if e.asMode == "null" {
    const nck = valueAtomKind(tgt)
    const nvb = vbHeapIdxOfKind(nck)
    if nvb < 0 || !uDeclared {
      return emitFail(
        "emitProgram: `as? "
          + tgt
          + "` has no value box — the `"
          + tgt
          + " | null` row was never registered",
      )
    }
    fbIfRefNul(uBoxIdx, false) // if (result (ref $uBox))
    fbI32Rel(RS_TAG, scalarTagOfKind(nck))
    if emitNumExactConvert(src, tgt) < 0 { return -1 }
    fbStructNew(nvb) // wrap the scalar payload
    fbStructNew(uBoxIdx)
    fbElse()
    // The null-tagged box, not a null box ref — what `T | null` means for a boxed union.
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone() // the payload slot is unread under the null tag
    fbStructNew(uBoxIdx)
    fbEnd()
    return 0
  }
  fbI32Eqz()
  fbIf(64) // if (void) — the SAD path, the only place the two remaining modes differ
  if e.asMode == "trap" {
    // The DOMAIN is what the author wrote, so `x as! u8` says `as! u8`, not `as! i32`. An
    // integral float out of i32's or i64's range fails exactly where the conversion below
    // traps, so it traps there and the host names the range (SP-056).
    if emitNumCastTrapMsg(exprIx, dom) < 0 { return -1 }
    if !integral || dom != tgt { fbUnreachable() }
  } else {
    // A bare `as` PROPAGATES. The checker proved the enclosing function returns something
    // `null` fits, so the value to hand back is that function's own null — built through
    // `emitReturnValue`, which is where every nullable-return seed already lives.
    if emitReturnValue(body, numCastNullNode(), fnIx, ec) < 0 { return -1 }
    fbReturn()
  }
  fbEnd()
  emitNumExactConvert(src, tgt)
}

// The sad path of `as!` or bare `as` over a type parameter pinned at no number: the value is
// never the target, so `as!` traps with its reason and `as` returns the function's own null.
function emitHoleNumCastMiss(
  body: u8[],
  e: AsExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitExpr(body, e.asObj, fnIx, ec) < 0 { return -1 }
  fbDrop()
  if e.asMode == "trap" {
    if emitNumCastTrapMsg(exprIx, asExprNumCastDomain(exprIx)) < 0 { return -1 }
    fbUnreachable()
    return 0
  }
  if emitReturnValue(body, numCastNullNode(), fnIx, ec) < 0 { return -1 }
  fbReturn()
  0
}

// `x as% T` — the wrap cast (`DECISIONS.md` §"`as%` is the wrap cast"). It cannot fail, so
// there is no test, no sad path and no staging slot: one conversion opcode, and the byte mask
// at the `u8` domain. A literal operand folds to the constant it denotes, which is what lets a
// consumer write a 32-bit bit pattern.
function emitNumWrapCast(
  body: u8[],
  e: AsExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const obj = e.asObj
  const dom = asExprNumCastDomain(exprIx)
  let tgt = asExprNumTgtName(exprIx)
  if tgt == "" { tgt = e.asTy }
  // A float on either side and a union operand are both refused at check; these are the
  // floors for an operand whose width only the emitted rep knows.
  if (
    exprIsF32(obj, fnIx)
    || exprIsF64(obj, fnIx)
    || tgt == "f32"
    || tgt == "f64"
  ) {
    return emitFail(
      "emitProgram: `as% "
        + e.asTy
        + "` wraps between integer widths, and this cast names a float — use `as!` or `as?`",
    )
  }
  if asExprIsUnionCastIn(exprIx, fnIx) {
    return emitFail(
      "emitProgram: `as% "
        + e.asTy
        + "` wraps a number, and this operand is a union — take the numeric arm first",
    )
  }
  // An i64 target is the sign-extend, which the i64 helper already is for both sources.
  if tgt == "i64" { return emitExprAsKind(body, obj, 3, fnIx, ec) }
  // `((y >>> k) & m) as% i32` narrows to i32 ops when the mask stays in the low word.
  const nsrc = srWrappedMask(exprIx, fnIx)
  if nsrc.length > 0 { return srEmitNarrowed(body, nsrc, fnIx, ec) }
  const lit = nodeAt(unwrapParen(obj))
  let folded = false
  if lit is NumLit {
    if !numLexIsFloat(lit.numText) {
      const pr = parseI64Pair(lit.numText)
      fbI32Const(pr[1])
      folded = true
    }
  }
  if !folded {
    if exprIsI64(obj, fnIx) {
      if emitExprAsKind(body, obj, 3, fnIx, ec) < 0 { return -1 }
      fbI32WrapI64()
    } else if emitExprAsKind(body, obj, 0, fnIx, ec) < 0 {
      return -1
    }
  }
  if dom == "u8" {
    fbI32Const(255)
    fbI32Bin(113) // 0x71 i32.and
  }
  0
}

// The `as` trio over a niche-repped `T | null` operand: `ref.null` is the whole encoding of
// the absent arm, so there is no tag to test and no payload to unbox. `as!`'s ruled trap IS
// `ref.as_non_null`, and `as?`'s result type is the operand's own rep (D1812).
function emitAsNulNiche(body: u8[], e: AsExpr, fnIx: i32, ec: ExpCtx) {
  const obj = e.asObj
  const payload = nulRefNichePayloadTy(nodeTyIxOf(obj))
  if payload < 0 {
    return emitFail(
      "emitProgram: `as "
        + e.asTy
        + "` needs a BOXED union operand or a nullable-REF one; this `| null` is a value niche whose null is a spare scalar, with neither a tag nor a ref to test",
    )
  }
  if !nulNicheCastWiredTy(payload) {
    return emitFail(
      "emitProgram: `as "
        + e.asTy
        + "` over a `"
        + e.asTy
        + " | null` is lowered for a string, a list, a struct and a union variant; a map or closure cell has no lowering yet at an un-annotated destination — narrow it with `if x != null { … }`",
    )
  }
  // `T | null` is exactly what the operand already is, so `as?` is the identity — the same
  // cell, at the same rep, and every consumer reads the cast node's own `T | null` type.
  if e.asMode == "null" { return emitExpr(body, obj, fnIx, ec) }
  if e.asMode == "trap" {
    if emitExpr(body, obj, fnIx, ec) < 0 { return -1 }
    // One opcode and no heap index: `ref.as_non_null` traps on the miss, which is the ruled
    // sad path, and hands the present value back at its own non-null heap type.
    fbRefAsNonNull()
    return 0
  }
  emitFail(
    "emitProgram: `as "
      + e.asTy
      + "` over a `"
      + e.asTy
      + " | null` propagates the null to the caller, and only the trapping and coalescing forms are lowered for that operand — write `as!`, `as?`, or the explicit `if x == null { return null }`",
  )
}

// `m[k] as! V` over a scalar-boxed map read `amRef`: the fused probe, trapping on a missing
// key and reading the stored value otherwise. Returns 0 or -1.
function emitAsMapProbeTrap(body: u8[], amRef: Index, fnIx: i32, ec: ExpCtx) {
  if emitMapPrep(body, amRef.idxArr, amRef.idxIndex, fnIx, ec) < 0 { return -1 }
  pushMapScr(body, 5) // entry
  fbI32Eqz()
  fbIf(64) // void
  fbUnreachable()
  fbEnd()
  if cmSlot >= 0 {
    pushMapVals(body)
    fbStructGet(cmValsWrap(), 0)
    pushMapScr(body, 5)
    fbI32Const(1)
    fbI32Bin(107) // i32.sub
    fbArrayGet(cmValsBack())
  } else {
    pushMapVals(body)
    fbStructGet(lTypeIdx, 0)
    pushMapScr(body, 5)
    fbI32Const(1)
    fbI32Bin(107)
    fbArrayGet(aTypeIdx)
  }
  return 0
}

// The `as?` arm of a union-operand cast, after the tag test is on the stack: the target
// value on a hit and its `null` on a miss, at the rep the arm (`subUnion`, `armVi`, `ak`,
// `mapHeap`) names for `T | null`. Returns 0, or -1 for an arm with no such rep.
function emitAsUnionOpt(
  subUnion: boolean,
  armVi: i32,
  ak: i32,
  mapHeap: i32,
  tgt: string,
) {
  // the boxed targets — a sub-union and a numeric value-atom arm — share one lowering:
  // a box already tagged with the wanted arm is a value of the target type, so hand
  // back the operand's own box, or a null box ref on the miss. Boolean is excluded —
  // `boolean | null` is the sentinel niche (`i32.const 2`), not a box.
  if (
    subUnion
    || armVi < 0 && (ak == 0 || ak == 3 || ak == 4 || ak == 5 || ak == 14)
  ) {
    fbIfRefNul(uBoxIdx, false) // if (result (ref $uBoxIdx))
    fbLocalGet(unionAsBoxSlot())
    fbElse()
    // the null-tagged box, what `T | null` means for a boxed union — a non-null box
    // carrying `nullBoxTag()`, not a null box ref: the rep the null test and
    // `emitUnionCoerce`'s `NullLit` both use, so a `!= null` on the result agrees.
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone() // the payload slot is unread under the null tag
    fbStructNew(uBoxIdx)
    fbEnd()
    return 0
  }
  // a map or list target's `M | null` is the nullable ref: the payload on the hit, a null.
  if mapHeap >= 0 {
    fbIfRefNul(mapHeap, true)
    fbLocalGet(unionAsBoxSlot())
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    fbRefCast(mapHeap)
    fbElse()
    fbRefNull(mapHeap)
    fbEnd()
    return 0
  }
  // a struct-variant target (`as? Circle`) is the `nulvariant` niche, a
  // `(ref null $uVarHeap[vi])`: unbox and cast on the hit, a typed null on the miss.
  if armVi >= 0 {
    if armVi >= uVarHeap.length {
      return emitFail(
        "emitProgram: `as? "
          + tgt
          + "` names a variant with no interned shape",
      )
    }
    fbIfRefNul(uVarHeap[armVi], true)
    fbLocalGet(unionAsBoxSlot())
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    fbRefCast(uVarHeap[armVi])
    fbElse()
    fbRefNull(uVarHeap[armVi])
    fbEnd()
    return 0
  }
  // what is left is a value-atom arm: string is the nullable ref below; a numeric arm
  // is refused — `i32 | null` is a value-niche sentinel, a different lowering entirely.
  // boolean needs its own arm: `boolean | null` is the sentinel niche (i32 `2` for
  // null), so the block's result is a scalar where every other target's is a ref.
  if ak == 1 {
    fbIf(127) // 0x04 if, 0x7f i32 result blocktype
    fbLocalGet(unionAsBoxSlot())
    if emitUnionUnboxTail(ak) < 0 { return -1 }
    fbElse()
    fbI32Const(2) // the null sentinel
    fbEnd()
    return 0
  }
  if ak != 2 {
    return emitFail(
      "emitProgram: `as? "
        + tgt
        + "` is supported for a value-atom arm, a struct-variant arm and a sub-union; this arm is none of those — write the explicit `if x is "
        + tgt
        + " { … }` ladder for it",
    )
  }
  fbIfRefNul(sTypeIdx, true) // if (result (ref null $sTypeIdx))
  fbLocalGet(unionAsBoxSlot())
  fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
  fbRefCast(sTypeIdx)
  fbElse()
  fbRefNull(sTypeIdx)
  fbEnd()
  return 0
}

// The cast of a union box to literal-union target `tty` (node `exprIx`): a hit is the base's tag
// with a payload equal to a member. The result is the base scalar, the atom id or the member
// string, as the node reps; a miss traps, returns the box, or is `null`, by mode. Returns 0 or -1.
function emitAsBoxToLitUnion(
  body: u8[],
  e: AsExpr,
  exprIx: i32,
  tty: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  let texts = tyNumLitMemberTexts(tty)
  let k = 2
  if texts.length > 0 {
    k = boxTagOfTy(numLitUnionBaseTy(tty))
  } else {
    texts = tyLitMemberTexts(tty)
  }
  if texts.length == 0 || k < 0 || (k == 2 && !aUsed) {
    return emitFail(
      "emitProgram: `as "
        + e.asTy
        + "` names a literal union with no members",
    )
  }
  const st = unionAsBoxSlot()
  if emitExpr(body, e.asObj, fnIx, ec) < 0 { return -1 }
  fbLocalSet(st)
  fbLocalGet(st)
  fbStructGet(uBoxIdx, 0) // field 0: the tag
  fbI32Rel(RS_TAG, scalarTagOfKind(k))
  fbI32Bin(70)            // 0x46 i32.eq
  fbIf(127)               // the payload is read only under its own tag
  let i = 0
  while i < texts.length {
    fbLocalGet(st)
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    if emitUnionPayloadUnbox(body, k) < 0 { return -1 }
    if k == 2 {
      if emitStrEqLit(body, mkStr(quoteLex(texts[i]), -1), fnIx, ec) < 0 {
        return -1
      }
    } else {
      if emitNumLitConstEq(valueAtomNameOfKind(k), texts[i]) < 0 { return -1 }
    }
    if i > 0 {
      fbI32Bin(114) // 0x72 i32.or
    }
    i = i + 1
  }
  fbElse()
  fbI32Const(0)
  fbEnd()
  const atom = k == 2 && exprIsLitAtom(exprIx, fnIx)
  if e.asMode == "null" {
    if k == 2 && exprNulLitUnion(exprIx, fnIx) {
      fbIf(127)
      if emitStashedStrToAtomChain(body, st, texts, 0, fnIx, ec) < 0 {
        return -1
      }
      fbElse()
      fbI32Const(-1) // the atom niche's null
      fbEnd()
      return 0
    }
    return emitAsUnionOpt(false, -1, k, -1, e.asTy)
  }
  fbI32Eqz() // 0x45
  fbIf(64)   // if, void
  if e.asMode == "trap" {
    fbUnreachable()
  } else {
    fbLocalGet(st)
    fbReturn()
  }
  fbEnd()
  if atom { return emitStashedStrToAtomChain(body, st, texts, 0, fnIx, ec) }
  fbLocalGet(st)
  emitUnionUnboxTail(k)
}

// The union-operand cast of `e` (node `_exprIx`): a niche operand's null test, else the tag
// test of the box against the target's arms, then `as?`'s value-producing arm or the
// propagating (`as`) or trapping (`as!`) miss and the unbox. Returns 0 or -1.
function emitAsUnionCast(
  body: u8[],
  e: AsExpr,
  _exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const obj = e.asObj
  const tgt = e.asTy
  // A niche-repped operand carries no tag, so none of the tag machinery below applies to
  // it: the arm test is the null test, and the whole trio shares one lowering.
  if !exprUnion(obj, fnIx) { return emitAsNulNiche(body, e, fnIx, ec) }
  // the target arm's type is the cast node's own recorded type, the checker's proof; for
  // `as?` the node's type is `T | null`, so it is peeled to recover `T` — without the peel
  // the tag and heap derive from the wrong type.
  let tty = nodeTyIxOf(_exprIx)
  if e.asMode == "null" { tty = tyPeelNul(tty) }
  // the target's arms, flattened rather than tested as `TyUnion`: a sub-union target
  // only widens the membership test (a tag chain), with no unbox at all.
  if mapSoftTwinTagFail(obj, tty, fnIx, _exprIx) < 0 { return -1 }
  if asExprBoxToLitUnion(_exprIx, fnIx) {
    // Outside the atom context, so each member compares as its string and not as its id.
    const savedLU = expCtxSwapLitUnion(0, ec)
    const rl = emitAsBoxToLitUnion(body, e, _exprIx, tty, fnIx, ec)
    expCtxSwapLitUnion(savedLU, ec)
    return rl
  }
  const wantTags: i32[] = []
  const wantVis: i32[] = []
  if !unionArmTagsOfTy(tty, wantTags, wantVis) {
    return emitFail(
      "emitProgram: `as "
        + tgt
        + "` is supported for a value-union arm or a struct-variant arm; this arm is neither — write the explicit `if x is "
        + tgt
        + " { … }` ladder for it",
    )
  }
  const subUnion = wantTags.length > 1
  let armVi = -1
  let ak = 0
  // A map arm's payload is its map struct ref, recovered by the heap cast its shape names.
  let mapHeap = -1
  if !subUnion {
    ak = boxTagOfTy(tty)
    armVi = wantVis[0]
    if armVi < 0 && ak < 0 && unMemIsMap(tty) {
      mapHeap = mapTypeIdxOf(mapShapeFoldSet(mapArmShapeOfTy(tty)))
    }
    // A list arm's payload is its list wrapper ref, recovered like a map's by one heap cast.
    if armVi < 0 && ak >= 0 { mapHeap = listWrapHeapOfKind(ak) }
    if armVi < 0 && ak < 0 && mapHeap < 0 && unMemIsRefElemArray(tty) {
      const rs = rlSlotOfTy(tyRefArrElemOf(tty))
      if rs >= 0 && rs < rlWrapIdx.length { mapHeap = rlWrapIdx[rs] }
    }
  }
  // `unionArmTagsOfTy` owns the empty-arm case, so what is left is a single arm the tag
  // reached but neither the variant table nor the atom kinds can name.
  if !subUnion && armVi < 0 && ak < 0 && mapHeap < 0 {
    return emitFail(
      "emitProgram: `as " + tgt + "` names no union arm this cast can test",
    )
  }
  if emitExpr(body, obj, fnIx, ec) < 0 { return -1 }
  fbLocalSet(unionAsBoxSlot())
  // `tag == w0 || tag == w1 || …` — one compare for a single arm, a chain for a sub-union.
  // The tag is re-read per arm rather than stashed in a second i32 slot: it is a
  // `struct.get` off a local, two instructions, and costs no frame.
  let wi = 0
  while wi < wantTags.length {
    fbLocalGet(unionAsBoxSlot())
    fbStructGet(uBoxIdx, 0) // field 0: the tag
    fbI32Rel(RS_TAG, wantTags[wi])
    fbI32Bin(70)            // 0x46 i32.eq
    if wi > 0 {
      fbI32Bin(114) // 0x72 i32.or
    }
    wi = wi + 1
  }
  // `as?` yields a value on both paths (a value-producing `if`, not the early exit `as`/
  // `as!` take): `T` when the tag matches, `null` when it does not. Supported only where
  // `T | null` already has a rep — `Circle | null` over a union arm has none yet
  // (`emitProgram: ref valtype with no interned shape`), refused here by naming the gap.
  if e.asMode == "null" {
    return emitAsUnionOpt(subUnion, armVi, ak, mapHeap, tgt)
  }
  fbI32Eqz() // 0x45
  fbIf(64)   // if, void
  // the sad path, and the only place `as` and `as!` differ: `as` hands the whole box to
  // the caller, `as!` traps and needs no value at all.
  if e.asMode == "trap" {
    fbUnreachable()
  } else {
    fbLocalGet(unionAsBoxSlot())
    fbReturn()
  }
  fbEnd()
  fbLocalGet(unionAsBoxSlot())
  // a sub-union result is the box itself, at a narrower type — nothing to unbox.
  if subUnion { return 0 }
  // a struct arm's payload is the variant struct — recover it with the variant heap
  // cast, exactly as the shared-field dispatch does; a value atom takes the shared tail.
  if armVi >= 0 {
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    fbRefCast(uVarHeap[armVi])
    return 0
  }
  if mapHeap >= 0 {
    fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
    fbRefCast(mapHeap)
    return 0
  }
  return emitUnionUnboxTail(ak)
}

// The `as` trio from a literal-union atom to a registered literal union: the id is staged once
// and compared against each target member's; a miss traps, is handed back by `return`, or is the
// `-1` null sentinel, by mode (D5286).
function emitAsLitAtom(
  body: u8[],
  e: AsExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  let tty = nodeTyIxOf(exprIx)
  if e.asMode == "null" { tty = tyPeelNul(tty) }
  const texts = tyLitMemberTexts(tty)
  // A propagated miss leaves as the id into a literal-union result, or as its member text
  // into a `string` one.
  const retAtom = e.asMode == "prop" && fnReturnsLitAtom(fnIx)
  const missTexts = tyLitMemberTexts(nodeTyIxOf(e.asObj))
  if e.asMode == "prop" && !retAtom {
    const fd = nodeAt(fnIx)
    let retStr = false
    if fd is FuncDecl { retStr = fd.fnRet >= 0 && nodeTyIsStringPrim(fd.fnRet) }
    if !retStr || missTexts.length == 0 {
      return emitFail(
        "emitProgram: `as "
          + e.asTy
          + "` over a literal-union atom propagates its miss, and this function returns neither a literal union nor a string — write `as!` or `as?`",
      )
    }
  }
  if emitExpr(body, e.asObj, fnIx, ec) < 0 { return -1 }
  const s = litAtomCastSlot()
  fbLocalSet(s)
  // A lone literal target (`as! "a"`) yields that literal's string, not the id (D5289).
  const strOut = !asExprLitAtomYieldsAtom(exprIx, fnIx)
  if e.asMode == "null" && !strOut {
    fbLocalGet(s)
    fbI32Const(-1)
  }
  let i = 0
  while i < texts.length {
    fbLocalGet(s)
    fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
    fbI32Bin(70) // 0x46 i32.eq
    if i > 0 {
      fbI32Bin(114) // 0x72 i32.or
    }
    i = i + 1
  }
  if e.asMode == "null" && strOut {
    fbIfRefNul(sTypeIdx, true)
    if emitStr(body, mkStr(quoteLex(texts[0]), -1), -1) < 0 { return -1 }
    fbElse()
    fbRefNull(sTypeIdx)
    fbEnd()
    return 0
  }
  if e.asMode == "null" {
    fbSelect() // the id on a hit, the sentinel on a miss
    return 0
  }
  fbI32Eqz()
  fbIf(64)
  if e.asMode == "trap" {
    fbUnreachable()
  } else if retAtom {
    fbLocalGet(s)
    fbReturn()
  } else {
    if emitAtomToStrChain(body, missTexts, 0, s) < 0 { return -1 }
    fbReturn()
  }
  fbEnd()
  if strOut { return emitStr(body, mkStr(quoteLex(texts[0]), -1), -1) }
  fbLocalGet(s)
  0
}

// The `as` trio from a numeric literal-union scalar to a numeric literal union of its base: the
// scalar is staged once and compared against each target member. A hit is the scalar, or for `as?`
// the base-tagged box; a miss traps, is handed back by `return`, or is the null box (D11221).
function emitAsNumLitScalar(
  body: u8[],
  e: AsExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  let tty = nodeTyIxOf(exprIx)
  if e.asMode == "null" { tty = tyPeelNul(tty) }
  const base = numLitUnionBaseTy(tty)
  const texts = tyNumLitMemberTexts(tty)
  const k = boxTagOfTy(base)
  if texts.length == 0 || (k != 0 && k != 3) {
    return emitFail(
      "emitProgram: `as "
        + e.asTy
        + "` names a literal union with no members",
    )
  }
  let sk: MfKind = "i32"
  if k == 3 { sk = "i64" }
  // A propagated miss leaves at the result's rep: the scalar itself, or boxed under its base's tag.
  let retBox = false
  if e.asMode == "prop" {
    let rk = ""
    if fnIx >= 0 && fnIx < P.nodes.length {
      const fd = nodeAt(fnIx)
      if fd is FuncDecl {
        if fd.fnRet >= 0 {
          rk = vtKindOfType(fd.fnRet)
        } else {
          const fp = fnStmtsPosOf(fnIx)
          if fp >= 0 && fp < fRetKind.length { rk = fRetKind[fp] }
        }
      }
    }
    retBox = rk == "union"
    if !retBox && rk != sk {
      return emitFail(
        "emitProgram: `as "
          + e.asTy
          + "` over a numeric literal union propagates its miss, and this function returns neither that number type nor a union — write `as!` or `as?`",
      )
    }
  }
  if emitExpr(body, e.asObj, fnIx, ec) < 0 { return -1 }
  const s = numLitCastSlot(sk)
  fbLocalSet(s)
  let i = 0
  while i < texts.length {
    fbLocalGet(s)
    if emitNumLitConstEq(valueAtomNameOfKind(k), texts[i]) < 0 { return -1 }
    if i > 0 {
      fbI32Bin(114) // 0x72 i32.or
    }
    i = i + 1
  }
  if e.asMode == "null" {
    const vb = vbHeapIdxOfKind(k)
    if vb < 0 {
      return emitFail("emitProgram: `as? " + e.asTy + "` has no value-box type")
    }
    fbOpenIf()             // 0x04 if
    fbValtype("union", -1) // result blocktype: the union box `(ref $uBox)`
    fbI32Rel(RS_TAG, scalarTagOfKind(k))
    fbLocalGet(s)
    fbStructNew(vb)
    fbStructNew(uBoxIdx)
    fbElse()
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone()        // the payload slot is unread under the null tag
    fbStructNew(uBoxIdx)
    fbEnd()
    return 0
  }
  fbI32Eqz()
  fbIf(64) // if, void
  if e.asMode == "trap" {
    fbUnreachable()
  } else if retBox {
    fbI32Rel(RS_TAG, scalarTagOfKind(k))
    fbLocalGet(s)
    fbStructNew(vbHeapIdxOfKind(k))
    fbStructNew(uBoxIdx)
    fbReturn()
  } else {
    fbLocalGet(s)
    fbReturn()
  }
  fbEnd()
  fbLocalGet(s)
  0
}

function emitAsCast(
  body: u8[],
  e: AsExpr,
  _exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const obj = e.asObj
  const tgt = e.asTy
  // An unsigned narrow load widened to i64 is the zero-extending i64 load (`zextLoadOf`).
  if tgt == "i64" {
    const zlAs = zextLoadOf(_exprIx, fnIx)
    if zlAs >= 0 { return emitZextLoad(body, zlAs, fnIx, ec) }
  }
  // A `new v128` brand cast (`x as F32x4`, `v as! v128`) re-brands the same 128 bits — the
  // checker admitted it only between two v128s, and the canon pass spelled the brand as its base.
  // A boxed `v128 | null` or union operand takes the union arm below instead.
  if tgt == "v128" && !exprUnion(obj, fnIx) {
    return emitExpr(body, obj, fnIx, ec)
  }
  if e.asMode == "wrap" { return emitNumWrapCast(body, e, _exprIx, fnIx, ec) }
  if asExprLitAtomCast(_exprIx, fnIx) {
    return emitAsLitAtom(body, e, _exprIx, fnIx, ec)
  }
  if asExprNumLitScalarCast(_exprIx, fnIx) {
    return emitAsNumLitScalar(body, e, _exprIx, fnIx, ec)
  }
  // A numeric union converts at whichever member it holds when no member's conversion fails.
  if numUnionMinted && nodeIsNumUnion(obj, fnIx) {
    const nuTo = njKindOfTy(nodeTyIxOf(_exprIx))
    if nuTo >= 0 && njAsConverts(njMembersOf(obj, fnIx), nuTo) {
      return emitNumUnionConvert(body, obj, nuTo, fnIx, ec)
    }
  }
  // union-operand `as` is the propagating cast (`error-handling-design.md` §Trio): evaluate
  // the box once into `$unionAs`, compare its tag against T's, and on a miss `return` the
  // box unchanged — one box struct and a global tag registry make it already a value of
  // the enclosing function's union return type. `m[k] as! V` fuses the map probe instead.
  if e.asMode == "trap" {
    const amk = mapReadScalarBoxKindTy(obj)
    if amk >= 0 {
      const amRef = nodeAt(unwrapParen(obj))
      if amRef is Index { return emitAsMapProbeTrap(body, amRef, fnIx, ec) }
    }
  }
  // A type-parameter operand fails as the direct spelling does at this instance's pin (D2791).
  if asExprHoleNumSad(_exprIx) && !asExprIsUnionCastIn(_exprIx, fnIx) {
    const hps = asExprHolePinSrc(_exprIx, fnIx)
    if hps == "-" { return emitHoleNumCastMiss(body, e, _exprIx, fnIx, ec) }
    if hps != "" {
      return emitNumExactCastFrom(body, e, _exprIx, hps, fnIx, ec)
    }
  }
  // numeric exact-or-fail (D1041) is checked ahead of the union arm and disjoint from it by
  // operand; only a cast that can fail comes here, the rest fall through to the plain ladder.
  if asExprHoleNumOpt(_exprIx) && !asExprIsUnionCastIn(_exprIx, fnIx) {
    return emitHoleNumAsOpt(body, e, _exprIx, fnIx, ec)
  }
  if asExprNumFallible(_exprIx) {
    return emitNumExactCast(body, e, _exprIx, fnIx, ec)
  }
  if asExprIsUnionCastIn(_exprIx, fnIx) {
    return emitAsUnionCast(body, e, _exprIx, fnIx, ec)
  }
  emitNumPlainCast(body, obj, tgt, fnIx, ec)
}

// The source rep of numeric operand `obj` as this instance emits it: f32 first, since
// `exprIsF64` over-claims an f32 literal.
function numCastSrcRepOf(obj: i32, fnIx: i32): string {
  if exprIsF32(obj, fnIx) { return "f32" }
  if exprIsI64(obj, fnIx) { return "i64" }
  if exprIsF64(obj, fnIx) { return "f64" }
  "i32"
}

// `u as? N` over a type-parameter operand pinned at a number or a `boolean`: `N | null` at every
// pin (D2754), so a cast that cannot fail at this pin still boxes its value, and one that can
// takes the exact-or-fail box.
function emitHoleNumAsOpt(
  body: u8[],
  e: AsExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const tgt = asExprNumTgtName(exprIx)
  const nck = valueAtomKind(tgt)
  const nvb = vbHeapIdxOfKind(nck)
  if nvb < 0 || !uDeclared {
    return emitFail(
      "emitProgram: `as? "
        + tgt
        + "` has no value box — the `"
        + tgt
        + " | null` row was never registered",
    )
  }
  // The instance's exact pin decides: a number converts, any other type is never the target.
  let ext = exactOperandTyOf(e.asObj, fnIx)
  // A hole's operand reads the pin of the hole instance this is (D3654).
  if ext < 0 { ext = holeOperandTyOf(e.asObj, fnIx) }
  if ext < 0 { ext = holeCaptureTyOf(e.asObj, fnIx) }
  // A gradual union's operand the instance re-typed at a scalar carries that scalar itself.
  if ext < 0 && (monoGradualAsScalar.get(exprIx) ?? false) {
    ext = nodeTyIxOf(e.asObj)
  }
  if ext < 0 {
    return emitFail(
      "emitProgram: `as? "
        + tgt
        + "` over a type parameter needs the instance's exact pin",
    )
  }
  const src = primNameStr(primNameOf(ext))
  const srcNum = src == "i32" || src == "i64" || src == "f32" || src == "f64"
  if !srcNum && src != "boolean" {
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone()
    fbStructNew(uBoxIdx)
    return 0
  }
  if numCastCanFail(src, asExprNumCastDomain(exprIx)) {
    return emitNumExactCastFrom(body, e, exprIx, src, fnIx, ec)
  }
  fbI32Rel(RS_TAG, scalarTagOfKind(nck))
  if emitNumPlainCast(body, e.asObj, tgt, fnIx, ec) < 0 { return -1 }
  fbStructNew(nvb)
  fbStructNew(uBoxIdx)
  0
}

// The numeric `x as T` lowering: the operand goes out in its own source rep through the
// `emitExprAs*` helpers, then one wasm conversion opcode for the pair (float-to-int traps
// rather than wraps).
function emitNumPlainCast(
  body: u8[],
  obj: i32,
  tgt: string,
  fnIx: i32,
  ec: ExpCtx,
) {
  if tgt == "f64" { return emitExprAsKind(body, obj, 4, fnIx, ec) }
  const src = numCastSrcRepOf(obj, fnIx)
  if tgt == "i64" {
    // i32→i64 widening (and i64→i64 no-op) via the existing helper.
    if src == "i32" || src == "i64" {
      return emitExprAsKind(body, obj, 3, fnIx, ec)
    }
    // float→i64: TRAPPING truncation toward zero.
    if src == "f32" {
      if emitExprAsKind(body, obj, 5, fnIx, ec) < 0 { return -1 }
      fbI64TruncF32S()
      return 0
    }
    if emitExprAsKind(body, obj, 4, fnIx, ec) < 0 {
      return -1 // f64 → i64
    }
    fbI64TruncF64S()
    return 0
  }
  if tgt == "f32" {
    // i32→f32 (and f32→f32 no-op) via the existing helper (handles literals).
    if src == "i32" || src == "f32" {
      return emitExprAsKind(body, obj, 5, fnIx, ec)
    }
    if src == "i64" {
      if emitExprAsKind(body, obj, 3, fnIx, ec) < 0 { return -1 }
      fbF32ConvertI64S()
      return 0
    }
    if emitExprAsKind(body, obj, 4, fnIx, ec) < 0 {
      return -1 // f64 → f32 demote
    }
    fbF32DemoteF64()
    return 0
  }
  // tgt == "i32".
  if src == "i32" {
    return emitExprAsKind(body, obj, 0, fnIx, ec) // no-op (plain `emitExpr` at kind 0)
  }
  if src == "i64" {
    if emitExprAsKind(body, obj, 3, fnIx, ec) < 0 { return -1 }
    fbI32WrapI64()
    return 0
  }
  if src == "f32" {
    if emitExprAsKind(body, obj, 5, fnIx, ec) < 0 { return -1 }
    fbI32TruncF32S()
    return 0
  }
  if emitExprAsKind(body, obj, 4, fnIx, ec) < 0 {
    return -1 // f64 → i32 trunc
  }
  fbI32TruncF64S()
  0
}

// ── linear-memory opcodes: the load-width matrix + memory.size/grow ──────────
// The instruction bytes for `buffer-design.md` §C2's load matrix, beside their dispatch.
const OP_I64_LOAD = 0x29
const OP_F32_LOAD = 0x2a
const OP_F64_LOAD = 0x2b
const OP_I32_LOAD8_S = 0x2c
const OP_I32_LOAD8_U = 0x2d
const OP_I32_LOAD16_S = 0x2e
const OP_I32_LOAD16_U = 0x2f
const OP_I64_LOAD8_U = 0x31
const OP_I64_LOAD16_U = 0x33
const OP_I64_LOAD32_U = 0x35
const OP_I64_STORE = 0x37
const OP_F32_STORE = 0x38
const OP_F64_STORE = 0x39
const OP_I32_STORE8 = 0x3a
const OP_I32_STORE16 = 0x3b
const OP_MEMORY_SIZE = 0x3f
const OP_MEMORY_GROW = 0x40

// The misc prefix (0xfc) and the two bulk-memory sub-opcodes behind it — every other
// prefixed instruction here uses 0xfb, the GC prefix, instead. The sub-opcode is a u32
// LEB immediate, not a byte; 10/11 happen to fit one byte today (below 128), which is
// why plain `wU8` still works here.
const OP_MISC_PREFIX = 0xfc
const MISC_MEMORY_COPY = 10
const MISC_MEMORY_FILL = 11

// The opcode byte for load width `name`, or -1 for a name that is not one. Paired with
// `memLoadAlignExp` below — the two are read together at the single call site.
function memLoadOpcode(name: string) {
  if name == "__load_i8__" { return OP_I32_LOAD8_S }
  if name == "__load_u8__" { return OP_I32_LOAD8_U }
  if name == "__load_i16__" { return OP_I32_LOAD16_S }
  if name == "__load_u16__" { return OP_I32_LOAD16_U }
  if name == "__load_i64__" { return OP_I64_LOAD }
  if name == "__load_f32__" { return OP_F32_LOAD }
  if name == "__load_f64__" { return OP_F64_LOAD }
  if name == "__load_u8_i64__" { return OP_I64_LOAD8_U }
  if name == "__load_u16_i64__" { return OP_I64_LOAD16_U }
  if name == "__load_u32_i64__" { return OP_I64_LOAD32_U }
  -1
}

// The natural alignment exponent for load width `name`: log2 of the access width in
// bytes. It is a hint the wasm spec never enforces — a mismatched access still runs,
// just without the engine's fast path — and `__load_i32__`'s exponent 2 has always read
// correctly at odd addresses, a property these widths inherit; the corpus pins it per width.
function memLoadAlignExp(name: string) {
  if name == "__load_i8__" { return 0 }
  if name == "__load_u8__" { return 0 }
  if name == "__load_i16__" { return 1 }
  if name == "__load_u16__" { return 1 }
  if name == "__load_i64__" { return 3 }
  if name == "__load_f32__" { return 2 }
  if name == "__load_f64__" { return 3 }
  if name == "__load_u8_i64__" { return 0 }
  if name == "__load_u16_i64__" { return 1 }
  if name == "__load_u32_i64__" { return 2 }
  -1
}

// One memarg-carrying memory instruction: `<opcode> <align-exp> <offset>`, the offset a u32
// LEB (`emitMemAddr` answers it, carried as its i32 bit pattern). Loads and stores share this
// encoding exactly; they differ only in their stack effect, which the caller has arranged.
function fbMemAccess(op: i32, alignExp: i32, off: i64) {
  wU8(op)
  wU8(alignExp)
  wULEB(off as% i32)
  0
}
const OP_I32_LOAD = 0x28
const OP_I32_STORE = 0x36

// The opcode byte for store width `name`, or -1 otherwise. The wide trio duals
// `memLoadOpcode`'s; the narrow pair collapses its four narrow loads — `i32.store8` is
// the one instruction both `i32.load8_s` and `i32.load8_u` read back, since a store has
// no signedness. All five share the memarg encoding a load uses.
function memStoreOpcode(name: string) {
  if name == "__store_i64__" { return OP_I64_STORE }
  if name == "__store_f32__" { return OP_F32_STORE }
  if name == "__store_f64__" { return OP_F64_STORE }
  if name == "__store_i8__" { return OP_I32_STORE8 }
  if name == "__store_i16__" { return OP_I32_STORE16 }
  -1
}

// The NATURAL alignment exponent for store width `name` — log2 of the access width in bytes,
// the same hint-not-constraint immediate `memLoadAlignExp` documents. i64 and f64 write eight
// bytes (exponent 3); f32 writes four (2), matching `__store_i32__`'s long-standing 2; the
// narrow pair write one byte (0) and two (1), matching their load twins.
function memStoreAlignExp(name: string) {
  if name == "__store_i64__" { return 3 }
  if name == "__store_f32__" { return 2 }
  if name == "__store_f64__" { return 3 }
  if name == "__store_i8__" { return 0 }
  if name == "__store_i16__" { return 1 }
  -1
}

// The two narrow store widths, whose value operand is an i32 rather than the declared
// wide scalar the other three take. Split out so the dispatch is a total two-way choice,
// not an `else` that silently means f64 for a name added to `nameIsMemStoreIntrinsic`
// and forgotten here — that shape builds an f64 operand under an i32 opcode.
function memStoreValueIsI32(name: string) {
  if name == "__store_i8__" { return true }
  if name == "__store_i16__" { return true }
  false
}

// One bulk-memory instruction: the 0xfc prefix, the sub-opcode, then one memory index
// per memory it names (`memory.fill` one, `memory.copy` two: destination then source) —
// both 0, since VL emits a single memory. `n` is unsigned in both, so a negative VL
// length is ~4 GiB and traps in the engine, not the checker.
function fbMemBulk(sub: i32, memIndexCount: i32) {
  wU8(OP_MISC_PREFIX) // 0xfc misc prefix
  wU8(sub)            // the sub-opcode (a u32 LEB; 10 and 11 are one byte each)
  let mi = 0
  while mi < memIndexCount {
    wU8(0) // memory index 0
    mi = mi + 1
  }
  0
}

// `memory.size` → 0x3f 0x00 and `memory.grow` → 0x40 0x00. The trailing byte is the
// memory INDEX immediate, not a flags byte: there is one memory, so it is 0.
function fbMemorySize() {
  wU8(OP_MEMORY_SIZE)
  wU8(0) // memory index 0
  0
}
function fbMemoryGrow() {
  wU8(OP_MEMORY_GROW)
  wU8(0) // memory index 0
  0
}

// ── SIMD (0xFD prefix): the third prefixed family (simd-design.md §D6/A3) ────
// Unlike the 0xfc misc prefix, a SIMD sub-opcode is a REAL u32 LEB — `f32x4.add` is 228 and
// encodes as two bytes — so `wULEB` is required, never `wU8`. Verify each sub-opcode with a
// `wasm-dis --enable-simd` round-trip of the emitted bytes.
const OP_SIMD_PREFIX = 0xfd
const SIMD_I8X16_SHUFFLE = 0x0d

// One SIMD instruction with no trailing immediate (`f32x4.splat`, `f32x4.add`): the prefix,
// then the uLEB sub-opcode. The stack effect the caller has already arranged.
function fbSimdOp(sub: i32) {
  wU8(OP_SIMD_PREFIX)
  wULEB(sub)
  0
}
// A memarg-carrying SIMD load/store (`v128.load`/`v128.store`): `0xFD <sub> <align-exp>
// <offset>`. Align 0 — unaligned (O5), so a vector reads/writes at ANY `Buf` offset.
function fbSimdMem(sub: i32, off: i64) {
  wU8(OP_SIMD_PREFIX)
  wULEB(sub)
  wU8(0) // align exponent 0 (unaligned — a hint the spec never enforces)
  wULEB(off as% i32)
  0
}
// A lane-immediate SIMD instruction (`f32x4.extract_lane`): `0xFD <sub> <lane byte>`. The lane
// is a single immediate byte; the checker refused anything but a 0..3 literal (O3).
function fbSimdLane(sub: i32, lane: i32) {
  wU8(OP_SIMD_PREFIX)
  wULEB(sub)
  wU8(lane)
  0
}
// ── numeric-opcode intrinsics ────────────────────────────────────────────────
// The IEEE bitcasts. A bitcast moves no bits: the same 32/64-bit pattern is simply
// read at the other type. Each is exactly one wasm instruction, so there is no
// import, no runtime, and nothing for the linker.
const OP_I32_REINTERPRET_F32 = 0xbc
const OP_I64_REINTERPRET_F64 = 0xbd
const OP_F32_REINTERPRET_I32 = 0xbe
const OP_F64_REINTERPRET_I64 = 0xbf
// `emitBitcastIntr`'s "this name is not an intrinsic" answer, distinct from its
// success (0) and its failure (-1) — the caller falls through to its own error.
const NUM_INTR_NONE = -2

// One single-BYTE numeric instruction: the whole encoding IS the opcode byte (no
// immediates), so writing the byte writes the instruction.
function fbNumOp(op: i32) {
  wU8(op)
  0
}

// Lower `f32bits` / `f64bits` / `f32fromBits` / `f64fromBits`: push the argument at
// the source type, then the one reinterpret instruction. Returns `NUM_INTR_NONE` when
// `name` is not one of them. The operand goes out at the bitcast's own
// source width.
function emitBitcastIntr(
  body: u8[],
  callIx: i32,
  fnIx: i32,
  name: string,
  ec: ExpCtx,
) {
  if (
    name != "f32bits"
    && name != "f64bits"
    && name != "f32fromBits"
    && name != "f64fromBits"
  ) {
    return NUM_INTR_NONE
  }
  if callIx < 0 { return -1 }
  const c = nodeAt(callIx)
  if c is Call {
    if c.callArgs.length != 1 {
      return emitFail(
        "emitProgram: internal: "
          + name
          + " reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    const arg = c.callArgs[0]
    if name == "f32bits" {
      if emitExprAsKind(body, arg, 5, fnIx, ec) < 0 { return -1 }
      return fbNumOp(OP_I32_REINTERPRET_F32) // 0xbc i32.reinterpret_f32
    }
    if name == "f64bits" {
      if emitExprAsKind(body, arg, 4, fnIx, ec) < 0 { return -1 }
      return fbNumOp(OP_I64_REINTERPRET_F64) // 0xbd i64.reinterpret_f64
    }
    if name == "f32fromBits" {
      if emitExprAsKind(body, arg, 0, fnIx, ec) < 0 { return -1 }
      return fbNumOp(OP_F32_REINTERPRET_I32) // 0xbe f32.reinterpret_i32
    }
    if emitExprAsKind(body, arg, 3, fnIx, ec) < 0 { return -1 }
    return fbNumOp(OP_F64_REINTERPRET_I64) // 0xbf f64.reinterpret_i64
  }
  NUM_INTR_NONE
}

// The f32 instruction for the float intrinsic `name`, or -1 when it is not one.
//   abs 0x8b · ceil 0x8d · floor 0x8e · trunc 0x8f · nearest 0x90 · sqrt 0x91
//   min 0x96 · max 0x97 · copysign 0x98
function floatIntrOpF32(name: string) {
  if name == "abs" { return 0x8b }
  if name == "ceil" { return 0x8d }
  if name == "floor" { return 0x8e }
  if name == "trunc" { return 0x8f }
  if name == "nearest" { return 0x90 }
  if name == "sqrt" { return 0x91 }
  if name == "min" { return 0x96 }
  if name == "max" { return 0x97 }
  if name == "copysign" { return 0x98 }
  -1
}

// The f64 instruction for the float intrinsic `name`, or -1 when it is not one — the
// f32 table shifted up by one block, exactly as the arithmetic opcodes are.
//   abs 0x99 · ceil 0x9b · floor 0x9c · trunc 0x9d · nearest 0x9e · sqrt 0x9f
//   min 0xa4 · max 0xa5 · copysign 0xa6
function floatIntrOpF64(name: string) {
  if name == "abs" { return 0x99 }
  if name == "ceil" { return 0x9b }
  if name == "floor" { return 0x9c }
  if name == "trunc" { return 0x9d }
  if name == "nearest" { return 0x9e }
  if name == "sqrt" { return 0x9f }
  if name == "min" { return 0xa4 }
  if name == "max" { return 0xa5 }
  if name == "copysign" { return 0xa6 }
  -1
}

// The i32 instruction for the integer intrinsic `name`, or -1 when it is not one.
//   clz 0x67 · ctz 0x68 · popcnt 0x69 · div_u 0x6e · rem_u 0x70 · rotl 0x77 · rotr 0x78
//   lt_u 0x49 · gt_u 0x4b · le_u 0x4d · ge_u 0x4f
function intIntrOpI32(name: string) {
  if name == "clz" { return 0x67 }
  if name == "ctz" { return 0x68 }
  if name == "popcnt" { return 0x69 }
  if name == "divU" { return 0x6e }
  if name == "remU" { return 0x70 }
  if name == "rotl" { return 0x77 }
  if name == "rotr" { return 0x78 }
  if name == "ltU" { return 0x49 }
  if name == "gtU" { return 0x4b }
  if name == "leU" { return 0x4d }
  if name == "geU" { return 0x4f }
  -1
}

// The i64 instruction for the integer intrinsic `name`, or -1 when it is not one.
//   clz 0x79 · ctz 0x7a · popcnt 0x7b · div_u 0x80 · rem_u 0x82 · rotl 0x89 · rotr 0x8a
//   lt_u 0x54 · gt_u 0x56 · le_u 0x58 · ge_u 0x5a
function intIntrOpI64(name: string) {
  if name == "clz" { return 0x79 }
  if name == "ctz" { return 0x7a }
  if name == "popcnt" { return 0x7b }
  if name == "divU" { return 0x80 }
  if name == "remU" { return 0x82 }
  if name == "rotl" { return 0x89 }
  if name == "rotr" { return 0x8a }
  if name == "ltU" { return 0x54 }
  if name == "gtU" { return 0x56 }
  if name == "leU" { return 0x58 }
  if name == "geU" { return 0x5a }
  -1
}

// Lower a FLOAT intrinsic (`sqrt`, `min`, `copysign`, …): push every argument at the
// operation's width, then the one instruction. The width rule is the binary operators'
// — f32 when an operand is f32 and neither side is a genuine (non-literal) f64 — so
// `min(x, 0.5)` over an f32 `x` computes in f32 exactly as `x * 0.5` does.
function emitFloatIntr(
  body: u8[],
  callIx: i32,
  fnIx: i32,
  name: string,
  ec: ExpCtx,
) {
  const opF32 = floatIntrOpF32(name)
  if opF32 < 0 { return NUM_INTR_NONE }
  const mmk = minMaxKind(callIx, fnIx)
  if mmk == "i32" || mmk == "i64" {
    if name == "abs" { return emitIntAbs(body, callIx, fnIx, mmk == "i64", ec) }
    return emitIntMinMax(body, callIx, fnIx, name, mmk == "i64", ec)
  }
  if callIx < 0 { return -1 }
  const c = nodeAt(callIx)
  if c is Call {
    const args = c.callArgs
    if args.length == 0 {
      return emitFail(
        "emitProgram: internal: "
          + name
          + " reached with no argument — the checker's arity rule refuses it",
      )
    }
    let anyF32 = false
    let i = 0
    while i < args.length {
      if exprIsF32(args[i], fnIx) { anyF32 = true }
      i = i + 1
    }
    // `binMixHardF64` over the first and last argument IS the operators' rule: true when
    // either side is a genuine (non-literal) f64. A one-argument intrinsic passes its one
    // operand as both sides, which asks the same question of it.
    const hardF64 = binMixHardF64(args[0], args[args.length - 1], fnIx)
    const useF32 = anyF32 && !hardF64
    // The chosen width is the OPERATION's, and each operand goes out at it.
    let fiK = 4
    if useF32 { fiK = 5 }
    let j = 0
    while j < args.length {
      if emitExprAsKind(body, args[j], fiK, fnIx, ec) < 0 { return -1 }
      j = j + 1
    }
    if useF32 { return fbNumOp(opF32) }
    return fbNumOp(floatIntrOpF64(name))
  }
  NUM_INTR_NONE
}

// Lower an integer `min` / `max`, which has no wasm instruction: both operands are
// evaluated in order before either is staged (so a nested call cannot clobber the frame),
// then `select` over a signed compare. Staging slots: i32 at +0/+1, i64 at +2/+3.
function emitIntMinMax(
  body: u8[],
  callIx: i32,
  fnIx: i32,
  name: string,
  wide: boolean,
  ec: ExpCtx,
) {
  const c = nodeAt(callIx)
  if !(c is Call) {
    return emitFail("emitProgram: expected an integer min/max call")
  }
  let k = 0
  let w = 0
  // i32.lt_s 0x48 · i32.gt_s 0x4a · i64.lt_s 0x53 · i64.gt_s 0x55
  let cmp = 0x48
  if wide {
    k = 3
    w = 2
    cmp = 0x53
  }
  const s0 = intMinMaxStashSlot(w)
  const s1 = intMinMaxStashSlot(w + 1)
  if name == "max" { cmp = cmp + 2 }
  if emitExprAsKind(body, c.callArgs[0], k, fnIx, ec) < 0 { return -1 }
  if emitExprAsKind(body, c.callArgs[1], k, fnIx, ec) < 0 { return -1 }
  fbLocalSet(s1)
  fbLocalTee(s0)
  fbLocalGet(s1)
  fbLocalGet(s0)
  fbLocalGet(s1)
  fbNumOp(cmp)
  fbSelect() // → the first operand when the compare holds
  0
}

// Lower an integer `abs`, which has no wasm instruction: `0 - x` when `x` is negative, else
// `x`, through `select`. Wraps as the subtraction does, so `abs(i32.MIN)` is `i32.MIN`.
// Stages the operand in the min/max frame's first slot of its width.
function emitIntAbs(
  body: u8[],
  callIx: i32,
  fnIx: i32,
  wide: boolean,
  ec: ExpCtx,
) {
  const c = nodeAt(callIx)
  if !(c is Call) {
    return emitFail("emitProgram: expected an integer abs call")
  }
  let k = 0
  let w = 0
  if wide {
    k = 3
    w = 2
  }
  const s0 = intMinMaxStashSlot(w)
  if emitExprAsKind(body, c.callArgs[0], k, fnIx, ec) < 0 { return -1 }
  fbLocalSet(s0)
  if wide { fbI64Const(0, 0) } else { fbI32Const(0) }
  fbLocalGet(s0)
  // i32.sub 0x6b · i64.sub 0x7d
  if wide { fbNumOp(0x7d) } else { fbNumOp(0x6b) }
  fbLocalGet(s0)
  fbLocalGet(s0)
  if wide { fbI64Const(0, 0) } else { fbI32Const(0) }
  // i32.lt_s 0x48 · i64.lt_s 0x53
  if wide { fbNumOp(0x53) } else { fbNumOp(0x48) }
  fbSelect() // → the negation when the operand is negative
  0
}

// Lower an INTEGER intrinsic (`clz`, `rotl`, `divU`, `ltU`, …): push every argument at
// the operation's width, then the one instruction. i64 when an operand is i64 (the i32
// side sign-extends), else i32 — the selection the i64 binary operators use.
function emitIntIntr(
  body: u8[],
  callIx: i32,
  fnIx: i32,
  name: string,
  ec: ExpCtx,
) {
  const opI32 = intIntrOpI32(name)
  if opI32 < 0 { return NUM_INTR_NONE }
  if callIx < 0 { return -1 }
  const c = nodeAt(callIx)
  if c is Call {
    const args = c.callArgs
    let useI64 = false
    let i = 0
    while i < args.length {
      if exprIsI64(args[i], fnIx) { useI64 = true }
      i = i + 1
    }
    // The chosen width is the OPERATION's: an i32 op's operand is an i32.
    let iiK = 0
    if useI64 { iiK = 3 }
    let j = 0
    while j < args.length {
      if emitExprAsKind(body, args[j], iiK, fnIx, ec) < 0 { return -1 }
      j = j + 1
    }
    if useI64 { return fbNumOp(intIntrOpI64(name)) }
    return fbNumOp(opI32)
  }
  NUM_INTR_NONE
}

// The value of an integer literal, of an unshadowed top-level `const` bound to one, or of an
// exact sum of those, at `ix` when it is at most `MEM_OFFSET_MAX`; else -1. The checker's
// `memOffsetCheckedValue` twin.
function memOffsetConstValue(ix: i32, fnIx: i32): i64 {
  const ox = unwrapParen(ix)
  if ox < 0 || ox >= P.nodes.length { return -1 }
  const e = nodeAt(ox)
  if e is NumLit { return memOffsetLexValue(e.numText) }
  if e is BinExpr { return memOffsetSumConst(e, fnIx) }
  memOffsetNameConst(ox, fnIx)
}

// The exact sum of a `+` of two constant offsets, or -1 for another operator or a term that is
// not one.
function memOffsetSumConst(e: BinExpr, fnIx: i32): i64 {
  if e.binOp != "+" { return -1 }
  const l = memOffsetConstValue(e.binLeft, fnIx)
  const r = memOffsetConstValue(e.binRight, fnIx)
  if l < 0 || r < 0 || l + r > MEM_OFFSET_MAX { return -1 }
  l + r
}

// The value of the top-level integer `const` the name at `ix` denotes from inside `fnIx`, when no
// binding of that frame shadows it; -1 for anything else, which is every node that is not one.
function memOffsetNameConst(ix: i32, fnIx: i32): i64 {
  const e = nodeAt(ix)
  if e is Ident {
    const li = globalLetOfSidIn(fnIx, sidOfNode(ix), ix)
    if li < 0 || li >= P.nodes.length { return -1 }
    const d = nodeAt(li)
    if d is LetDecl {
      if d.letKw != "const" || d.letInit < 0 { return -1 }
      const lit = nodeAt(unwrapParen(d.letInit))
      if lit is NumLit { return memOffsetLexValue(lit.numText) }
      const cf = constFoldOfLet(d)
      if cf.cfOk && cf.cfV >= 0 { return cf.cfV }
    }
  }
  -1
}

// The call's operand at declared position `k` of a memory intrinsic with `base` operands:
// position 0 is the address, and at the offset form every later one sits one further right.
function memCallArg(c: Call, base: i32, k: i32): i32 {
  if k >= 1 && c.callArgs.length == base + 1 { return c.callArgs[k + 1] }
  c.callArgs[k]
}

// An i32 address operand's compile-time value when it is a constant `memOffsetConstValue`
// reads and at most 2^31-1, so every term and the exact sum equal their i32 values; else -1.
function memAddrConst(ix: i32, fnIx: i32): i64 {
  const v = memOffsetConstValue(ix, fnIx)
  if v > 0x7fffffff { return -1 }
  v
}

// An upper bound on the i32 address operand at `ix` read as unsigned, or -1 when none is
// provable. Every rule is exact under i32 wrap: a masked, shifted-down or narrow-loaded value,
// and products, shifts and sums of bounded values that stay below 2^32.
function memAddrBound(ix: i32, fnIx: i32): i64 {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return -1 }
  const k = memAddrConst(x, fnIx)
  if k >= 0 { return k }
  const e = nodeAt(x)
  if e is BinExpr { return memAddrBinBound(e, fnIx) }
  memAddrLoadBound(x, fnIx)
}

// `memAddrBound` of a binary operator: a mask is at most its smaller bounded side, a logical
// shift right by 1..31 is below 2^(32-k), and a product, left shift or sum of bounded operands
// is bounded while it stays below 2^32. Any other operator has no bound (-1).
function memAddrBinBound(e: BinExpr, fnIx: i32): i64 {
  const op = e.binOp
  if op == "&" {
    const l = memAddrBound(e.binLeft, fnIx)
    const r = memAddrBound(e.binRight, fnIx)
    if l < 0 { return r }
    if r < 0 || l < r { return l }
    return r
  }
  if op == ">>>" || op == "<<" {
    const sh = memAddrConst(e.binRight, fnIx)
    if sh < 0 || sh > 31 { return -1 }
    const l = memAddrBound(e.binLeft, fnIx)
    if op == ">>>" {
      if l >= 0 { return l >> sh }
      if sh == 0 { return -1 }
      return MEM_OFFSET_MAX >> sh
    }
    if l < 0 || (l << sh) > MEM_OFFSET_MAX { return -1 }
    return l << sh
  }
  if op == "*" || op == "+" {
    const l = memAddrBound(e.binLeft, fnIx)
    const r = memAddrBound(e.binRight, fnIx)
    if l < 0 || r < 0 { return -1 }
    if op == "*" {
      if l > 0 && r > MEM_OFFSET_MAX / l { return -1 }
      return l * r
    }
    if l + r > MEM_OFFSET_MAX { return -1 }
    return l + r
  }
  -1
}

// `memAddrBound` of a narrow unsigned load, which zero-extends: 255 or 65535. Any other node,
// a call of a user function of the same name included, has no bound (-1).
function memAddrLoadBound(ix: i32, fnIx: i32): i64 {
  const e = nodeAt(ix)
  if e is Call {
    if e.callFn < 0 { return -1 }
    const f = nodeAt(e.callFn)
    if f is Ident {
      if e.callArgs.length >= 1 && !identNameIsUserBound(f.identName, fnIx) {
        if f.identName == "__load_u8__" { return 255 }
        if f.identName == "__load_u16__" { return 65535 }
      }
    }
  }
  -1
}

// The width in bits of the zero-extended value a load intrinsic `name` can stand for in an
// i64 fold: 8 or 16 for the unsigned narrow loads and their i64 twins, 32 for `__load_i32__`
// and `__load_u32_i64__`, 0 for any other name.
function zextLoadWidth(name: string): i32 {
  if name == "__load_u8__" || name == "__load_u8_i64__" { return 8 }
  if name == "__load_u16__" || name == "__load_u16_i64__" { return 16 }
  if name == "__load_i32__" || name == "__load_u32_i64__" { return 32 }
  0
}

// The node of the call at `ix` (parens peeled) when it calls a load intrinsic with a
// `zextLoadWidth` that no binding of `fnIx` shadows, else -1.
function zextLoadCallAt(ix: i32, fnIx: i32): i32 {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return -1 }
  const e = nodeAt(x)
  if e is Call {
    if e.callFn < 0 { return -1 }
    const f = nodeAt(e.callFn)
    if f is Ident {
      if zextLoadWidth(f.identName) == 0 { return -1 }
      if identNameIsUserBound(f.identName, fnIx) { return -1 }
      return x
    }
  }
  -1
}

// The callee name of a call node `zextLoadCallAt` answered.
function zextLoadCallName(callIx: i32): string {
  const e = nodeAt(callIx)
  if e is Call {
    if e.callFn < 0 { return "" }
    const f = nodeAt(e.callFn)
    if f is Ident { return f.identName }
  }
  ""
}

// An i64 `&` mask operand's value when it is 0xff, 0xffff or 0xffffffff — an integer literal,
// or a top-level i64 `const` bound to one — else -1. An i32 const is refused: widening it
// sign-extends, so its 0xffffffff is an all-ones i64.
function zextMaskValue(ix: i32, fnIx: i32): i64 {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return -1 }
  const e = nodeAt(x)
  let v: i64 = -1
  if e is NumLit {
    v = memOffsetLexValue(e.numText)
  } else if e is Ident {
    if !exprIsI64(x, fnIx) { return -1 }
    v = memOffsetNameConst(x, fnIx)
  }
  if v == 0xff || v == 0xffff || v == MEM_OFFSET_MAX { return v }
  -1
}

// The load call whose ZERO-extended i64 value the expression at `ix` provably is, or -1: a
// `__load_u*_i64__` call, or `__load_u8__`/`__load_u16__` cast `as`/`as%` to i64 (non-negative,
// so its sign-extension is its zero-extension). A masked form is `zextLoadMasked`'s.
function zextLoadOf(ix: i32, fnIx: i32): i32 {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return -1 }
  const e = nodeAt(x)
  if e is Call {
    const c = zextLoadCallAt(x, fnIx)
    if c < 0 { return -1 }
    const cn = zextLoadCallName(c)
    if cn == "__load_u8_i64__" || cn == "__load_u16_i64__" { return c }
    if cn == "__load_u32_i64__" { return c }
    return -1
  }
  if e is AsExpr {
    if e.asTy != "i64" { return -1 }
    if e.asMode != "prop" && e.asMode != "wrap" { return -1 }
    const ac = zextLoadCallAt(e.asObj, fnIx)
    if ac < 0 { return -1 }
    if zextLoadCallName(ac) == "__load_i32__" { return -1 }
    return ac
  }
  zextLoadMasked(x, fnIx)
}

// Whether the node at `ix` (parens peeled) is a call, a cast or an `&`: the only shapes a
// `zextLoadOf` match can have, tested before the other side's mask is read.
function zextLoadShape(ix: i32): boolean {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return false }
  const e = nodeAt(x)
  if e is BinExpr { return e.binOp == "&" }
  e is Call || e is AsExpr
}

// `zextLoadOf` of an `&` whose one side is a `zextMaskValue` covering the other's load width:
// the other side is a `zextLoadOf` match, or `__load_i32__` cast to i64 under exactly
// 0xffffffff, the one mask that turns its sign-extension into a zero-extension. Else -1.
function zextLoadMasked(x: i32, fnIx: i32): i32 {
  const e = nodeAt(x)
  if e is BinExpr {
    if e.binOp != "&" { return -1 }
    let m: i64 = -1
    let other = -1
    if zextLoadShape(e.binLeft) {
      m = zextMaskValue(e.binRight, fnIx)
      other = e.binLeft
    }
    if m < 0 && zextLoadShape(e.binRight) {
      m = zextMaskValue(e.binLeft, fnIx)
      other = e.binRight
    }
    if m < 0 { return -1 }
    const inner = zextLoadOf(other, fnIx)
    if inner >= 0 {
      const w = zextLoadWidth(zextLoadCallName(inner))
      if m == MEM_OFFSET_MAX || w == 8 || (w == 16 && m == 0xffff) {
        return inner
      }
      return -1
    }
    if m != MEM_OFFSET_MAX { return -1 }
    const o = nodeAt(unwrapParen(other))
    if o is AsExpr {
      if o.asTy != "i64" { return -1 }
      if o.asMode != "prop" && o.asMode != "wrap" { return -1 }
      const sc = zextLoadCallAt(o.asObj, fnIx)
      if sc >= 0 && zextLoadCallName(sc) == "__load_i32__" { return sc }
    }
  }
  -1
}

// Lowers the expression `zextLoadOf` matched to its one zero-extending i64 load of `callIx`'s
// width, the call's own address and memarg offset kept.
function emitZextLoad(body: u8[], callIx: i32, fnIx: i32, ec: ExpCtx) {
  const c = nodeAt(callIx)
  if c is Call {
    const w = zextLoadWidth(zextLoadCallName(callIx))
    let nm = "__load_u32_i64__"
    if w == 8 { nm = "__load_u8_i64__" }
    if w == 16 { nm = "__load_u16_i64__" }
    const off = emitMemAddr(body, c, 1, fnIx, nm, ec)
    if off < 0 { return -1 }
    fbMemAccess(memLoadOpcode(nm), memLoadAlignExp(nm), off)
    return 0
  }
  emitFail(
    "emitProgram: a zero-extending load fold matched a node that is not a call",
  )
}

// The constant term of a `+` whose OTHER side `memAddrBound` can bound at all, or -1 for any
// other shape. Bounding K+bound against `MEM_OFFSET_MAX` (plus a caller's own offset) is the
// caller's job, since only the caller knows what else shares that budget. Shared by
// `emitMemAddr`'s own split and the declaration-time fold below.
function memConstFoldK(a: BinExpr, fnIx: i32): i64 {
  if a.binOp != "+" { return -1 }
  const lc = memAddrConst(a.binLeft, fnIx)
  if lc >= 0 && memAddrConst(a.binRight, fnIx) < 0 {
    if memAddrBound(a.binRight, fnIx) >= 0 { return lc }
    return -1
  }
  const rc = memAddrConst(a.binRight, fnIx)
  if rc >= 0 && memAddrConst(a.binLeft, fnIx) < 0 {
    if memAddrBound(a.binLeft, fnIx) >= 0 { return rc }
    return -1
  }
  -1
}

// The non-constant side `memConstFoldK` paired its answer with, or -1 when it found none.
function memConstFoldRest(a: BinExpr, fnIx: i32): i32 {
  if a.binOp != "+" { return -1 }
  if memAddrConst(a.binLeft, fnIx) >= 0 && memAddrConst(a.binRight, fnIx) < 0 {
    return a.binRight
  }
  if memAddrConst(a.binRight, fnIx) >= 0 && memAddrConst(a.binLeft, fnIx) < 0 {
    return a.binLeft
  }
  -1
}

// `memConstFoldK` of a LOCAL `const`'s own initializer, checked against `MEM_OFFSET_MAX` alone,
// or -1 when the whole initializer is already constant (nothing to preserve at runtime) or
// matches neither shape. `emitLetDeclStmt` and `maFoldCandidateCount` share this one answer,
// since a deviation between them is unsound.
function memConstFoldShapeK(initIx: i32, fnIx: i32): i64 {
  const ix = unwrapParen(initIx)
  if ix < 0 || ix >= P.nodes.length { return -1 }
  if memAddrConst(ix, fnIx) >= 0 { return -1 }
  const e = nodeAt(ix)
  if !(e is BinExpr) { return -1 }
  const kv = memConstFoldK(e, fnIx)
  if kv < 0 { return -1 }
  const rest = memConstFoldRest(e, fnIx)
  const m = memAddrBound(rest, fnIx)
  if m < 0 || m + kv > MEM_OFFSET_MAX { return -1 }
  kv
}

// The bounded operand `memConstFoldShapeK` found, or -1 when it found none — a second, cheap
// re-derivation rather than a two-value return, since VL has no tuple type here.
function memConstFoldShapeRest(initIx: i32, fnIx: i32): i32 {
  const ix = unwrapParen(initIx)
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const e = nodeAt(ix)
  if e is BinExpr { return memConstFoldRest(e, fnIx) }
  -1
}

// True when `initIx`'s top-level shape is a `+` at all — the one cheap, non-recursive check
// every caller of `memConstFoldShapeK` runs first, so the real (`memAddrConst`/`memAddrBound`)
// analysis is skipped for the vast majority of `const`s, which are never address sums.
function mfShapeIsSum(initIx: i32): boolean {
  const ix = unwrapParen(initIx)
  if ix < 0 || ix >= P.nodes.length { return false }
  const e = nodeAt(ix)
  if e is BinExpr { return e.binOp == "+" }
  false
}

// How many of this function's already-collected locals qualify for the declaration-time
// address fold, sized before the body is walked (`fnDetectScratch`) so `fbBeginFunc` can
// reserve them. Reads `localDeclIx` — one entry per local slot `collectLocals` already
// allocated, however deeply nested — rather than re-walking the body a second time.
export function maFoldCandidateCount(fnIx: i32): i32 {
  let count = 0
  let i = 0
  while i < localDeclIx.length {
    // `localIsRef[i]` is the slot kind `collectLocals` already classified — "i32" is the one a
    // plain arithmetic sum ever takes, so this skips every i64/f32/f64/ref local (registers, in
    // plumb-shaped code) before touching its declaration node at all.
    if localIsRef[i] == "i32" {
      const declIx = localDeclIx[i]
      if declIx >= 0 && declIx < P.nodes.length {
        const d = nodeAt(declIx)
        if d is LetDecl {
          if d.letKw == "const" && d.letInit >= 0 && mfShapeIsSum(d.letInit) {
            if memConstFoldShapeK(d.letInit, fnIx) >= 0 { count = count + 1 }
          }
        }
      }
    }
    i = i + 1
  }
  count
}

// The declaration-time fold's live table for the function currently emitting: parallel to
// each qualifying `const`'s own node index, the WASM index of its scratch local and the K it
// folded out. Cleared at the top of `emitFuncBody` — a node index is emitted at most once, so
// stale rows from a previous function can never be mistaken for this one's.
let maFoldDeclIx: i32[] = []
let maFoldWasmSlot: i32[] = []
let maFoldK: i64[] = []
// How many of this function's scratch slots (`maFoldScratchBase` + this) are already claimed —
// `maFoldCandidateCount`'s own visiting order, replayed by `emitLetDeclStmt` as it emits each
// qualifying declaration in turn, so the two never need to agree on anything but that order.
let maFoldCursor = 0

// The fold table's row for declaration `declIx`, or -1 — the slot BELONGS to the declaration,
// not to any one emission of it: an unrolled or partially-unrolled loop body (`emitRangeUnrolled`
// and #3129's 4x partial unroll) re-emits the same `LetDecl` node once per copy, and every copy
// must land on the ONE row `maFoldCandidateCount` reserved, not a fresh one each time.
function maFoldRowOfDecl(declIx: i32): i32 {
  let i = 0
  while i < maFoldDeclIx.length {
    if maFoldDeclIx[i] == declIx { return i }
    i = i + 1
  }
  -1
}

// The fold table's row for a live read of local `name`, or -1 — resolved by the same live-slot
// rung `startBlockLetOfSid` reads from `collectLocals`'s `localDeclIx`, so a shadowed name in a
// nested block can never match an outer declaration's row.
function maFoldRowOf(name: string): i32 {
  const slot = scopeSlotOf(name)
  if slot < 0 || slot >= localDeclIx.length { return -1 }
  const decl = localDeclIx[slot]
  if decl < 0 { return -1 }
  maFoldRowOfDecl(decl)
}

// Emits a qualifying `const`'s initializer: push the bounded part, tee it into this
// declaration's own scratch local, then finish `K + bounded` as `emitExpr` would — the value
// is unchanged, so other reads of the name are unaffected. A re-emitted copy of the same
// `declIx` reuses the row `maFoldRowOfDecl` finds rather than claiming a fresh slot.
function emitMemConstFoldLet(
  body: u8[],
  initIx: i32,
  k: i64,
  fnIx: i32,
  declIx: i32,
  ec: ExpCtx,
): i32 {
  const rest = memConstFoldShapeRest(initIx, fnIx)
  if rest < 0 {
    return emitFail(
      "emitProgram: a declaration-time address fold lost its own split",
    )
  }
  if emitExpr(body, rest, fnIx, ec) < 0 { return -1 }
  const existing = maFoldRowOfDecl(declIx)
  let wasmIdx = 0
  if existing >= 0 {
    wasmIdx = maFoldWasmSlot[existing]
  } else {
    wasmIdx = maFoldScratchBase + maFoldCursor
    maFoldCursor = maFoldCursor + 1
    maFoldDeclIx.push(declIx)
    maFoldWasmSlot.push(wasmIdx)
    maFoldK.push(k)
  }
  fbLocalTee(wasmIdx)
  fbI32Const(k as% i32)
  fbI32Bin(0x6a) // i32.add
  0
}

// Pushes the address of memory-intrinsic call `c` (`base` declared operands) and answers the
// memarg offset, or -1 after an emit failure. A constant part moves into the offset only where
// both forms name the same effective address: a constant address, `a + K` provably not
// wrapping, or `a` a local the fold above already reduced to just its bounded part.
function emitMemAddr(
  body: u8[],
  c: Call,
  base: i32,
  fnIx: i32,
  name: string,
  ec: ExpCtx,
): i64 {
  let off: i64 = 0
  if c.callArgs.length == base + 1 {
    off = memOffsetConstValue(c.callArgs[1], fnIx)
  } else if c.callArgs.length != base {
    off = -1
  }
  if off < 0 {
    emitFail(
      "emitProgram: "
        + name
        + " has an argument count or offset the checker refuses (the offset is a compile-time integer in 0..4294967295)",
    )
    return -1
  }
  const addr = unwrapParen(c.callArgs[0])
  if addr >= 0 && addr == lmaAddrNode {
    const lmaRest = lmaAddrRest
    const lmaK = lmaAddrK
    lmaAddrNode = -1
    if emitExprAsKind(body, lmaRest, 3, lmaCallerFn, ec) < 0 { return -1 }
    fbI32WrapI64()
    return lmaK + off
  }
  if addr < 0 || addr >= P.nodes.length {
    if emitExpr(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
    return off
  }
  const whole = memAddrConst(addr, fnIx)
  if whole >= 0 && whole + off <= MEM_OFFSET_MAX {
    fbI32Const(0)
    return whole + off
  }
  const a = nodeAt(addr)
  if a is Ident {
    const mf = maFoldRowOf(a.identName)
    if mf >= 0 {
      const k = maFoldK[mf]
      if k + off <= MEM_OFFSET_MAX {
        fbLocalGet(maFoldWasmSlot[mf])
        return k + off
      }
    }
  }
  if a is BinExpr {
    const kv = memConstFoldK(a, fnIx)
    if kv >= 0 {
      const rest = memConstFoldRest(a, fnIx)
      const m = memAddrBound(rest, fnIx)
      if m >= 0 && m + kv + off <= MEM_OFFSET_MAX {
        if emitExpr(body, rest, fnIx, ec) < 0 { return -1 }
        return kv + off
      }
    }
  }
  if gLowMemUnused > 0 {
    const lk = memLowFoldK(addr, fnIx)
    if lk > 0 && lk + off < gLowMemUnused {
      const wide = memLowWrapped(addr, fnIx)
      const rest = memLowFoldRest(addr, fnIx)
      if wide >= 0 {
        if emitExprAsKind(body, rest, 3, fnIx, ec) < 0 { return -1 }
        fbI32WrapI64()
      } else if emitExpr(body, rest, fnIx, ec) < 0 {
        return -1
      }
      return lk + off
    }
  }
  if emitExpr(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
  off
}

// The i64 operand of an address `x as% i32` when `x` is an i64, else -1. Under
// `gLowMemUnused` its constant terms fold as an i32 address's do: `wrap(x + K)` is
// `wrap(x) + K` modulo 2^32, the same wrap `memLowFoldK` argues about.
function memLowWrapped(addr: i32, fnIx: i32): i32 {
  const e = nodeAt(addr)
  if e is AsExpr {
    if e.asMode != "wrap" { return -1 }
    let tgt = asExprNumTgtName(addr)
    if tgt == "" { tgt = e.asTy }
    if tgt != "i32" || asExprNumCastDomain(addr) == "u8" { return -1 }
    if asExprIsUnionCastIn(addr, fnIx) || !exprIsI64(e.asObj, fnIx) {
      return -1
    }
    return e.asObj
  }
  -1
}

// The non-constant side of a `+` at `ix` whose other side is a `memAddrConst`, or -1.
function memLowStep(ix: i32, fnIx: i32): i32 {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return -1 }
  const e = nodeAt(x)
  if e is BinExpr {
    if e.binOp != "+" { return -1 }
    const lc = memAddrConst(e.binLeft, fnIx)
    const rc = memAddrConst(e.binRight, fnIx)
    if rc >= 0 && lc < 0 { return e.binLeft }
    if lc >= 0 && rc < 0 { return e.binRight }
  }
  -1
}

// The constant that `memLowStep` peeled from the `+` at `ix`; only called where it answered.
function memLowStepK(ix: i32, fnIx: i32): i64 {
  const e = nodeAt(unwrapParen(ix))
  if e is BinExpr {
    const rc = memAddrConst(e.binRight, fnIx)
    if rc >= 0 { return rc }
    return memAddrConst(e.binLeft, fnIx)
  }
  emitFail("emitProgram: a low-memory address fold lost its own `+`")
  -1
}

// The address operand `emitMemAddr` pushes for `addr` (the i64 operand under a wrap).
function memLowBase(addr: i32, fnIx: i32): i32 {
  const w = memLowWrapped(addr, fnIx)
  if w >= 0 { return w }
  addr
}

// The sum of the constant terms `a + K1 + K2 ...` adds to address `addr`, or -1 when it adds
// none or more than `MEM_OFFSET_MAX`. Moving them into the memarg changes the address only where
// the sum wraps past 2^32, where the add's own address is below that sum, and so below
// `gLowMemUnused` once the caller has checked it: an access the promise excludes.
function memLowFoldK(addr: i32, fnIx: i32): i64 {
  let x = memLowBase(addr, fnIx)
  let k: i64 = 0
  let next = memLowStep(x, fnIx)
  while next >= 0 {
    const sk = memLowStepK(x, fnIx)
    if sk < 0 { return -1 }
    k = k + sk
    if k > MEM_OFFSET_MAX { return -1 }
    x = next
    next = memLowStep(x, fnIx)
  }
  if k == 0 { return -1 }
  k
}

// The frame of an accessor call `emitLowMemAccessorCall` inlines: the accessor's own address
// operand, and the caller's operand and constant that replace it; the accessor's value
// parameter read, and the caller's argument it stands for. Each node is -1 once consumed.
let lmaAddrNode = -1
let lmaAddrRest = -1
let lmaAddrK: i64 = 0
let lmaValNode = -1
let lmaValArg = -1
let lmaCallerFn = -1

// Under `gLowMemUnused`, a call `f(x + K, v)` of a trivial memory accessor (`lmaAccessBody`)
// emits `f`'s body in place, its address as `wrap(x)` with K in the memarg, exactly as the
// direct spelling `__load_i64__(x as% i32, K)` folds. 1 when the call does not qualify.
function emitLowMemAccessorCall(
  body: u8[],
  callIx: i32,
  fnIx: i32,
  target: i32,
  ec: ExpCtx,
): i32 {
  const c = nodeAt(callIx)
  const fd = nodeAt(fnStmts[target])
  if c is Call {
    if fd is FuncDecl {
      const bx = lmaAccessBody(target)
      if bx < 0 || c.callArgs.length != fd.fnParams.length { return 1 }
      for nm in c.callArgNames {
        if nm != "" { return 1 }
      }
      const a0 = c.callArgs[0]
      if a0 < 0 || !exprIsI64(a0, fnIx) { return 1 }
      const k = memLowFoldK(a0, fnIx)
      const acc = lmaAccessCall(bx, target)
      if acc < 0 { return 1 }
      const ac = nodeAt(acc)
      if ac is Call {
        let own: i64 = 0
        if ac.callArgs.length == memOffsetBaseArityOf(ac) + 1 {
          own = memOffsetConstValue(ac.callArgs[1], target)
        }
        if (
          k <= 0
          || own < 0
          || k + own >= gLowMemUnused
          || k + own > MEM_OFFSET_MAX
        ) {
          return 1
        }
        let valNode = -1
        let valArg = -1
        if fd.fnParams.length == 2 {
          valArg = c.callArgs[1]
          if valArg < 0 || !exprIsI64(valArg, fnIx) { return 1 }
          valNode = lmaValueRead(memCallArg(ac, 2, 1))
        }
        const sAddr = lmaAddrNode
        const sRest = lmaAddrRest
        const sK = lmaAddrK
        const sVal = lmaValNode
        const sArg = lmaValArg
        const sFn = lmaCallerFn
        const saved = expCtxHere(ec)
        const lc = expCtxHere(ec)
        lc.litUnion = 0
        lc.nulLitUnion = false
        lmaAddrNode = unwrapParen(ac.callArgs[0])
        lmaAddrRest = memLowFoldRest(a0, fnIx)
        lmaAddrK = k
        lmaValNode = valNode
        lmaValArg = valArg
        lmaCallerFn = fnIx
        expCtxApply(lc, ec)
        const rc = emitExpr(body, bx, target, ec)
        const missed = lmaAddrNode >= 0 || lmaValNode >= 0
        lmaAddrNode = sAddr
        lmaAddrRest = sRest
        lmaAddrK = sK
        lmaValNode = sVal
        lmaValArg = sArg
        lmaCallerFn = sFn
        expCtxApply(saved, ec)
        if rc < 0 { return -1 }
        if missed {
          return emitFail(
            "emitProgram: an inlined memory accessor left an operand unread",
          )
        }
        return 0
      }
    }
  }
  1
}

// The operand count of memory intrinsic call `c` without its optional offset.
function memOffsetBaseArityOf(c: Call): i32 {
  if c.callFn < 0 { return 1 }
  const f = nodeAt(c.callFn)
  if f is Ident {
    if f.identName == "__store_i32__" || nameIsMemStoreIntrinsic(f.identName) {
      return 2
    }
  }
  1
}

// The body expression of function `fi` when it is a trivial memory accessor, else -1: not
// generic, i64 parameters with no default, and one expression that is a load of `a as% i32`
// (under `as` casts and `&` with a constant, returning its own type) or a store of `v` or
// `v as T` there, where `a` and `v` are the parameters in order and each is read once.
function lmaAccessBody(fi: i32): i32 {
  if fi < 0 || fi >= fnStmts.length || captureCountOf(fi) > 0 { return -1 }
  const fd = nodeAt(fnStmts[fi])
  if fd is FuncDecl {
    if fd.fnTyParams.length > 0 || fd.fnBody < 0 { return -1 }
    const np = fd.fnParams.length
    if np < 1 || np > 2 { return -1 }
    for p in fd.fnParams {
      const pn = nodeAt(p)
      if pn is Param {
        if pn.parDefault >= 0 || pn.parOpt != 0 || pn.parRest != 0 { return -1 }
        if lmaTypeName(pn.parType) != "i64" { return -1 }
      } else {
        return -1
      }
    }
    const blk = nodeAt(fd.fnBody)
    if blk is Block {
      if blk.blkStmts.length != 1 { return -1 }
      const bx = blk.blkStmts[0]
      const acc = lmaAccessCall(bx, fi)
      if acc < 0 || !lmaIsIntrinsic(acc, fi) { return -1 }
      const ac = nodeAt(acc)
      if ac is Call {
        const arity = memOffsetBaseArityOf(ac)
        if ac.callArgs.length != arity && ac.callArgs.length != arity + 1 {
          return -1
        }
        if unwrapParen(ac.callArgs[0]) < 0 { return -1 }
        if (
          lmaParamRead(memLowWrapped(unwrapParen(ac.callArgs[0]), fi))
          != lmaParamName(fd, 0)
        ) {
          return -1
        }
        if arity == 2 {
          if np != 2 || fd.fnRet >= 0 || unwrapParen(bx) != acc { return -1 }
          const vr = lmaValueRead(memCallArg(ac, 2, 1))
          if lmaParamRead(vr) != lmaParamName(fd, 1) { return -1 }
          return bx
        }
        if np != 1 { return -1 }
        const rt = lmaTypeName(fd.fnRet)
        if rt == "" || rt != lmaPrimOf(bx, fi) { return -1 }
        return bx
      }
    }
  }
  -1
}

// The intrinsic call at the core of accessor expression `ix`: the call itself, or the call
// under `as` casts and a `&` whose other side is a constant (`memOffsetConstValue`, so it has no
// effect and reads no parameter); -1 otherwise.
function lmaAccessCall(ix: i32, fi: i32): i32 {
  let x = unwrapParen(ix)
  let depth = 0
  while depth < 4 && x >= 0 {
    const n = nodeAt(x)
    if n is Call { return x }
    if n is AsExpr {
      x = unwrapParen(n.asObj)
    } else if n is BinExpr {
      if n.binOp != "&" { return -1 }
      if memOffsetConstValue(n.binRight, fi) >= 0 {
        x = unwrapParen(n.binLeft)
      } else if memOffsetConstValue(n.binLeft, fi) >= 0 {
        x = unwrapParen(n.binRight)
      } else {
        return -1
      }
    } else {
      return -1
    }
    depth = depth + 1
  }
  -1
}

// Whether call `acc` in function `fi` is a scalar load or store intrinsic rather than a binding
// of that name.
function lmaIsIntrinsic(acc: i32, fi: i32): boolean {
  const ac = nodeAt(acc)
  if ac is Call {
    if ac.callFn < 0 { return false }
    const f = nodeAt(ac.callFn)
    if f is Ident {
      const nm = f.identName
      if (identNameIsUserBound(nm, fi) || fnIndexOfNode(ac.callFn) >= 0) {
        return false
      }
      return (nm == "__load_i32__"
        || nm == "__store_i32__"
        || nameIsMemLoadIntrinsic(nm)
        || nameIsMemStoreIntrinsic(nm))
    }
  }
  false
}

// The parameter read a store's value operand `ix` is: `v`, or `v as T`; else -1.
function lmaValueRead(ix: i32): i32 {
  const x = unwrapParen(ix)
  if x < 0 { return -1 }
  const n = nodeAt(x)
  if n is AsExpr { return unwrapParen(n.asObj) }
  x
}

// The name an `Ident` node `ix` reads, or "" for any other node.
function lmaParamRead(ix: i32): string {
  if ix < 0 { return "" }
  const n = nodeAt(unwrapParen(ix))
  if n is Ident { return n.identName }
  ""
}

// The name of parameter `k` of `fd`.
function lmaParamName(fd: FuncDecl, k: i32): string {
  const p = nodeAt(fd.fnParams[k])
  if p is Param { return p.parName }
  ""
}

// The primitive a type annotation node names, or "" for none or any other type.
function lmaTypeName(ix: i32): string {
  if ix < 0 { return "" }
  const t = nodeAt(ix)
  if t is TypeRef {
    const nm = t.tyName
    if nm == "i32" || nm == "i64" || nm == "f32" || nm == "f64" { return nm }
  }
  ""
}

// The primitive expression `ix` of function `fi` yields, as `lmaTypeName` spells it.
function lmaPrimOf(ix: i32, fi: i32): string {
  if exprIsI64(ix, fi) { return "i64" }
  if exprIsF64(ix, fi) { return "f64" }
  if exprIsF32(ix, fi) { return "f32" }
  "i32"
}

// The operand left once `memLowFoldK`'s constant terms are peeled from `addr`.
function memLowFoldRest(addr: i32, fnIx: i32): i32 {
  let x = memLowBase(addr, fnIx)
  let next = memLowStep(x, fnIx)
  while next >= 0 {
    x = next
    next = memLowStep(x, fnIx)
  }
  x
}

// The compile-time lane index at a SIMD lane argument, or -1 when it is not a literal in
// `0..max`. The checker (`checkSimdLaneArg`) already refused a non-literal, so this only
// re-reads the value the immediate byte needs; -1 keeps a drift between the two loud, not silent.
function simdLaneImm(argIx: i32, max: i32): i32 {
  const ix = unwrapParen(argIx)
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const e = nodeAt(ix)
  if e is NumLit {
    if numLexIsFloat(e.numText) { return -1 }
    const v = u8LexValue(e.numText)
    if v <= max { return v }
  }
  -1
}

// The SIMD lowering (`simd-design.md` §D6): push the row's operands in order, each at the width
// its operand shape names, then write the one
// 0xFD-prefix instruction with the row's immediates. Lane and shuffle indices are the literals
// the checker pinned; a drift between the two is a loud emit failure, never a wrong byte.
function emitSimdIntrinsic(
  body: u8[],
  c: Call,
  name: string,
  fnIx: i32,
  ec: ExpCtx,
) {
  const row = simdRow(name)
  if row < 0 {
    return emitFail("emitProgram: '" + name + "' is not a known SIMD intrinsic")
  }
  const op = simdRowOp(row)
  const sig = simdRowSig(row)
  const args = c.callArgs
  if sig == SIMD_SIG_SHUF4 || sig == SIMD_SIG_SHUF16 {
    return emitSimdShuffle(body, c, name, fnIx, sig, simdRowLaneMax(row), ec)
  }
  if sig == SIMD_SIG_LOAD || sig == SIMD_SIG_STORE {
    let base = 1
    if sig == SIMD_SIG_STORE { base = 2 }
    const off = emitMemAddr(body, c, base, fnIx, name, ec)
    if off < 0 { return -1 }
    if sig == SIMD_SIG_STORE {
      if emitExpr(body, memCallArg(c, base, 1), fnIx, ec) < 0 { return -1 }
    }
    fbSimdMem(op, off)
    return 0
  }
  if sig == SIMD_SIG_I_V {
    if emitExpr(body, args[0], fnIx, ec) < 0 { return -1 }
    return fbSimdOp(op)
  }
  if sig == SIMD_SIG_L_V {
    if emitExprAsKind(body, args[0], 3, fnIx, ec) < 0 { return -1 }
    return fbSimdOp(op)
  }
  if sig == SIMD_SIG_F_V {
    if emitExprAsF32(body, args[0], fnIx, ec) < 0 { return -1 }
    return fbSimdOp(op)
  }
  if emitExpr(body, args[0], fnIx, ec) < 0 { return -1 }
  if sig == SIMD_SIG_V_V || sig == SIMD_SIG_V_I { return fbSimdOp(op) }
  if sig == SIMD_SIG_VV_V || sig == SIMD_SIG_VVV_V {
    if emitExpr(body, args[1], fnIx, ec) < 0 { return -1 }
    if sig == SIMD_SIG_VVV_V {
      if emitExpr(body, args[2], fnIx, ec) < 0 { return -1 }
    }
    return fbSimdOp(op)
  }
  if sig == SIMD_SIG_VI_V {
    if emitExpr(body, args[1], fnIx, ec) < 0 { return -1 }
    return fbSimdOp(op)
  }
  const max = simdRowLaneMax(row)
  const lane = simdLaneImm(args[1], max)
  if lane < 0 {
    return emitFail(
      "emitProgram: "
        + name
        + " lane index is not a compile-time literal in 0.."
        + i32ToStr(max),
    )
  }
  if sig == SIMD_SIG_REPL_I {
    if emitExpr(body, args[2], fnIx, ec) < 0 { return -1 }
  } else if sig == SIMD_SIG_REPL_L {
    if emitExprAsKind(body, args[2], 3, fnIx, ec) < 0 { return -1 }
  } else if sig == SIMD_SIG_REPL_F {
    if emitExprAsF32(body, args[2], fnIx, ec) < 0 { return -1 }
  } else if (
    sig != SIMD_SIG_LANE_I
    && sig != SIMD_SIG_LANE_L
    && sig != SIMD_SIG_LANE_F
  ) {
    return emitFail(
      "emitProgram: SIMD intrinsic '"
        + name
        + "' has an operand shape with no lowering",
    )
  }
  fbSimdLane(op, lane)
  0
}

// `i8x16.shuffle` over two vectors: sixteen byte-lane immediates, each in 0..31. The 16-lane
// form writes its literals as given; the 4-lane form (`__shuffle_f32x4__`) picks 32-bit lanes
// in 0..7 and writes each one's four bytes.
function emitSimdShuffle(
  body: u8[],
  c: Call,
  name: string,
  fnIx: i32,
  sig: i32,
  max: i32,
  ec: ExpCtx,
) {
  const lanes: i32[] = []
  let si = 2
  while si < c.callArgs.length {
    const l = simdLaneImm(c.callArgs[si], max)
    if l < 0 {
      return emitFail(
        "emitProgram: "
          + name
          + " lane index is not a compile-time literal in 0.."
          + i32ToStr(max),
      )
    }
    lanes.push(l)
    si = si + 1
  }
  if emitExpr(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
  if emitExpr(body, c.callArgs[1], fnIx, ec) < 0 { return -1 }
  wU8(OP_SIMD_PREFIX)
  wULEB(SIMD_I8X16_SHUFFLE)
  let i = 0
  while i < lanes.length {
    if sig == SIMD_SIG_SHUF4 {
      const b = lanes[i] * 4
      wU8(b)
      wU8(b + 1)
      wU8(b + 2)
      wU8(b + 3)
    } else {
      wU8(lanes[i])
    }
    i = i + 1
  }
  0
}

// Pushes the one float operand at the width the name gives it, then writes `0xFC <sub>`.
function emitTruncSatIntrinsic(
  body: u8[],
  c: Call,
  name: string,
  fnIx: i32,
  ec: ExpCtx,
) {
  const op = truncSatOp(name)
  if op < 0 || c.callArgs.length != 1 {
    return emitFail(
      "emitProgram: internal: '"
        + name
        + "' reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  let k = 5
  if truncSatFromF64(op) { k = 4 }
  if emitExprAsKind(body, c.callArgs[0], k, fnIx, ec) < 0 { return -1 }
  wU8(OP_MISC_PREFIX)
  wULEB(op)
  0
}

// ── atomics (0xFE prefix): the threads proposal over linear memory ───────────
// Every memory form carries a memarg whose alignment MUST be the access's natural one (a
// smaller or larger exponent is invalid), and a misaligned address traps at run time.
const OP_ATOMIC_PREFIX = 0xfe

// Pushes the address, then each value operand at the width the row names (a wait's timeout
// and an i64 row's values as i64, the rest as i32), then writes `0xFE <sub> <align> 0`.
// `atomic.fence` has no memarg: its one immediate is a reserved zero byte.
function emitAtomicIntrinsic(
  body: u8[],
  c: Call,
  name: string,
  fnIx: i32,
  ec: ExpCtx,
) {
  const row = atomicRow(name)
  if row < 0 {
    return emitFail(
      "emitProgram: '" + name + "' is not a known atomic intrinsic",
    )
  }
  const op = atomicRowOp(row)
  const sig = atomicRowSig(row)
  const args = c.callArgs
  if sig == ATOMIC_SIG_FENCE {
    wU8(OP_ATOMIC_PREFIX)
    wULEB(op)
    wU8(0) // reserved flags byte
    return 0
  }
  let vals = 0
  if (
    sig == ATOMIC_SIG_STORE
    || sig == ATOMIC_SIG_RMW
    || sig == ATOMIC_SIG_NOTIFY
  ) {
    vals = 1
  } else if sig == ATOMIC_SIG_CMPXCHG || sig == ATOMIC_SIG_WAIT {
    vals = 2
  } else if sig != ATOMIC_SIG_LOAD {
    return emitFail(
      "emitProgram: atomic intrinsic '"
        + name
        + "' has an operand shape with no lowering",
    )
  }
  if args.length != vals + 1 && args.length != vals + 2 {
    return emitFail(
      "emitProgram: internal: atomic intrinsic "
        + name
        + " reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  const off = emitMemAddr(body, c, vals + 1, fnIx, name, ec)
  if off < 0 { return -1 }
  let k = 1
  while k <= vals {
    // A NOTIFY count is i32; a WAIT's last operand is the i64 timeout.
    let wide = atomicRowIsI64(row) && sig != ATOMIC_SIG_NOTIFY
    if sig == ATOMIC_SIG_WAIT && k == 2 { wide = true }
    const ak = memCallArg(c, vals + 1, k)
    if wide {
      if emitExprAsKind(body, ak, 3, fnIx, ec) < 0 { return -1 }
    } else {
      if emitExpr(body, ak, fnIx, ec) < 0 { return -1 }
    }
    k = k + 1
  }
  wU8(OP_ATOMIC_PREFIX)
  wULEB(op)
  wU8(atomicRowAlign(row))
  wULEB(off as% i32)
  0
}

// A call, followed by `unreachable` when its type is `never`: the callee leaves nothing, and
// the stack-polymorphic `unreachable` is what lets that stand in any value position (D1972).
// `__trap__` lowers to its own `unreachable`, so it needs no second one.
function emitCall(body: u8[], callIx: i32, fnIx: i32, ec: ExpCtx) {
  // A hole function's closure read that its shared lifted body cannot carry (D2878).
  const cloRef = cloTailRefusal(callIx, fnIx)
  if cloRef != "" { return emitFail(cloRef) }
  const r = emitCallCore(body, callIx, fnIx, ec)
  if r < 0 { return r }
  if callIsNever(callIx) && !callIsTrapIntrinsic(callIx) { fbUnreachable() }
  r
}

// A call through a tagged function set (`fnTagDecide`): the callee is the i32 id of the member
// it holds, tested against each member's id in turn to make that member's own direct call. The
// last member takes the remaining id. Members giving different results box them into the call's
// union.
function emitFnTagDispatch(body: u8[], callIx: i32, arms: i32[], fnIx: i32) {
  const c = nodeAt(callIx)
  if !(c is Call) { return emitFail("emitProgram: expected a call") }
  const ds = fnTagMembers(fnTagCallSetOf(callIx))
  if ds.length != arms.length {
    return emitFail("emitProgram: a dispatch lost a member")
  }
  if emitExpr(body, c.callFn, fnIx, expCtxDefault()) < 0 { return -1 }
  const slot = fnTagIdSlot()
  fbLocalSet(slot)
  const ty = nodeTyAt(callIx, fnIx)
  // A call through a set of void members leaves no value, and answers 1.
  const isVoid = isVoidTy(ty)
  let kind: VKind | null = "i32"
  if !isVoid { kind = repSigKindOfTy(ty) }
  if kind == null {
    return emitFail(
      "emitProgram: a call through a function set has a result with no rep",
    )
  }
  const boxed = kind == "union"
  let rslot = -1
  if kind == "struct" || kind == "nulstruct" { rslot = repSlotOfTy(ty) }
  if kind == "reflist" || kind == "nulreflist" { rslot = rlSlotOfTy(ty) }
  const un = if boxed { unionNameOfExpr(callIx, fnIx) } else { "" }
  let k = 0
  while k < arms.length {
    const last = k == arms.length - 1
    if !last {
      fbLocalGet(slot)
      fbI32Const(ds[k])
      fbI32Bin(70) // 0x46 i32.eq
      if isVoid {
        fbIf(64)
      } else {
        fbOpenIf()
        fbValtype(kind, rslot)
      }
    }
    let rc = 0
    if boxed {
      rc = emitUnionBoxArg(body, un, ty, arms[k], fnIx, expCtxDefault())
    } else if kind == "f64" {
      // A member's narrower numeric result widens to the call's joined one.
      rc = emitExprAsF64(body, arms[k], fnIx, expCtxDefault())
    } else if kind == "i64" {
      rc = emitExprAsI64(body, arms[k], fnIx, expCtxDefault())
    } else if kind == "f32" {
      rc = emitExprAsF32(body, arms[k], fnIx, expCtxDefault())
    } else {
      rc = emitExpr(body, arms[k], fnIx, expCtxDefault())
    }
    if rc < 0 { return -1 }
    if !last { fbElse() }
    k = k + 1
  }
  k = 0
  while k < arms.length - 1 {
    fbEnd()
    k = k + 1
  }
  tailCallIdx = -1
  if isVoid { 1 } else { 0 }
}

function callIsTrapIntrinsic(callIx: i32) {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return false }
    const callee = nodeAt(c.callFn)
    if callee is Ident { return callee.identName == "__trap__" }
  }
  false
}

// The template hole of render call `c` when this instance pins it to a string or a literal
// atom, else -1. The renderer takes neither, and the checker leaves a pinned body's call in
// place (D2241).
function tplStrHoleOf(c: Call, fnIx: i32) {
  if c.callArgs.length != 1 { return -1 }
  const h = c.callArgs[0]
  if !nodeIsTplHole(h) { return -1 }
  if exprString(h, fnIx) || exprIsLitAtom(h, fnIx) { return h }
  -1
}

// The `__str_from_bytes__(src, at, count)` arm of `emitCallCore`. Returns 0 once the string
// is on the stack, -1 on failure.
function emitCallCoreStrFromBytes(body: u8[], c: Call, fnIx: i32, ec: ExpCtx) {
  if gHelpStrFromBytes < 0 {
    return emitFail(
      "emitProgram: __str_from_bytes__ but its helper was not reserved",
    )
  }
  if c.callArgs.length != 3 {
    return emitFail(
      "emitProgram: internal: __str_from_bytes__ reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  let sfbI = 0
  while sfbI < 3 {
    if emitExpr(body, c.callArgs[sfbI], fnIx, ec) < 0 { return -1 }
    sfbI = sfbI + 1
  }
  fbCall(gHelpStrFromBytes)
  return 0
}

// The `fromCodePoints(xs)` arm of `emitCallCore`: the list read twice by name, or once through
// the spill slot. Returns 0 once the string is on the stack, -1 on failure.
function emitCallCoreFromCodePoints(
  body: u8[],
  callIx: i32,
  c: Call,
  fnIx: i32,
  ec: ExpCtx,
) {
  if !aUsed || !lUsed {
    return emitFail(
      "emitProgram: fromCodePoints but array/list types not collected",
    )
  }
  if c.callArgs.length != 1 {
    return emitFail(
      "emitProgram: internal: fromCodePoints reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  const fcpA0 = c.callArgs[0]
  // An unbound argument slot takes `emitExpr`'s own hole refusal: `unwrapParen` would
  // read `P.nodes[-1]` and trap the compiler before any diagnostic printed.
  if fcpA0 < 0 { return emitExpr(body, fcpA0, fnIx, ec) }
  const fcpArg = unwrapParen(fcpA0)
  // __utf8_enc__(xs.backing, 0, xs.len) — two reads of one list. A bare name is
  // re-readable, so it is emitted twice and costs no local; every other spelling is
  // evaluated ONCE into the spill slot, since a second emission would re-run its
  // effects. `callSpillsFcpArg` is the same question the frame reserved on (D1640).
  if callSpillsFcpArg(callIx) {
    if emitExpr(body, fcpArg, fnIx, ec) < 0 { return -1 }
    fbLocalTee(fcpSpillStashSlot())
    fbStructGet(lTypeIdx, 0)
    fbI32Const(0)
    fbLocalGet(fcpSpillStashSlot())
    fbStructGet(lTypeIdx, 1)
    fbCall(gHelpUtf8Enc)
    return 0
  }
  if emitExpr(body, fcpArg, fnIx, ec) < 0 { return -1 }
  fbStructGet(lTypeIdx, 0)
  fbI32Const(0)
  if emitExpr(body, fcpArg, fnIx, ec) < 0 { return -1 }
  fbStructGet(lTypeIdx, 1)
  fbCall(gHelpUtf8Enc)
  return 0
}

// The `fromCodePoint(code)` arm of `emitCallCore`. Returns 0 once the string is on the stack,
// -1 on failure.
function emitCallCoreFromCodePoint(body: u8[], c: Call, fnIx: i32, ec: ExpCtx) {
  if !aUsed {
    return emitFail("emitProgram: fromCodePoint but array type not collected")
  }
  if c.callArgs.length != 1 {
    return emitFail(
      "emitProgram: internal: fromCodePoint reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  if emitExpr(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
  fbArrayNewFixed(aTypeIdx, 1) // the one-element CODE-POINT array
  fbI32Const(0)                // start
  fbI32Const(1)                // len
  fbCall(gHelpUtf8Enc)
  return 0
}

// The `print(x)` arm of `emitCallCore`: the argument's rep picks the null word, a niche, a box
// dispatch, an atom chain, a string stream or one scalar print import. Returns 0 once the
// call is emitted, -1 on failure.
function emitCallCorePrint(
  body: u8[],
  callIx: i32,
  c: Call,
  fnIx: i32,
  ec: ExpCtx,
) {
  if c.callArgs.length != 1 {
    return emitFail(
      "emitProgram: internal: print reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  // D1576 — `print(<the `null` type>)` prints the word `null`: the value is
  // statically null, so there is no arm to select, and this must run first — every
  // classifier below reads a rep this value does not have. The argument still
  // evaluates, so a call's side effects happen.
  if exprIsNulNone(c.callArgs[0], fnIx) {
    if emitNulNoneForEffect(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
    return emitPrintNullWord()
  }
  // A nullable ref niche whose other arm has no printed form (a record, a list, a map, a
  // closure) can print only as `null`, whatever narrowed it there (D3498).
  const pnNiche = exprNulNicheKind(c.callArgs[0], fnIx)
  if (
    (pnNiche != "" && pnNiche != "nulstr")
    || exprNullableMap(c.callArgs[0], fnIx)
  ) {
    const prMask = maskNarrowFor(narrowedToNullKey(c.callArgs[0]))
    const prRc = emitPrintNulRefNiche(body, c.callArgs[0], fnIx, ec)
    unmaskNarrow(prMask)
    return prRc
  }
  // A read the narrowing pins to `null` is printed with the narrowing lifted, so the box's
  // own tag decides: every ladder below would unbox an arm it does not hold (D2801).
  const pnKey = narrowedToNullKey(c.callArgs[0])
  if pnKey != "" {
    const pnMask = maskNarrowFor(pnKey)
    const pnWas = printPlanPinNull(true)
    const pnRc = emitCallCore(body, callIx, fnIx, ec)
    printPlanPinNull(pnWas)
    unmaskNarrow(pnMask)
    return pnRc
  }
  const pmk = mapReadScalarBoxKind(c.callArgs[0], fnIx)
  if pmk >= 0 {
    return emitPrintScalarMapRead(body, c.callArgs[0], pmk, fnIx, ec)
  }
  // A read narrowed to `K | null` out of a wider box prints as that niche (D7965), a hole's
  // or an instance's read at the type its calls pin (D8122).
  if narrowedNulLitPinBoxKey(c.callArgs[0], fnIx) != "" {
    const nbTexts = nulLitMemberTexts(instanceReadTyOf(c.callArgs[0], fnIx))
    if nbTexts.length > 0 {
      return emitPrintNulLitUnion(body, c.callArgs[0], nbTexts, fnIx, ec)
    }
  }
  // print(literal-union atom): widen it to its member string — a per-member
  // `if id == <id> { print "<name>" }` chain. Asked before `exprString`, which also
  // answers true for an atom-repped global (the softened render says `string` over a
  // cell laid out as `(mut i32)`) — where they disagree, the atom answer is the rep.
  if exprIsLitAtom(c.callArgs[0], fnIx) {
    // an un-narrowed `K | null` niche is the same i32 with `-1` for null, so it prints
    // its member or the word `null`, exactly like the two niches beside it. Asked
    // first: the expanded spelling also satisfies the member-only query below, and
    // only this arm emits the sentinel.
    const lpNul = nulLitAtomTexts(c.callArgs[0], fnIx)
    if lpNul.length > 0 {
      return emitPrintNulLitUnion(body, c.callArgs[0], lpNul, fnIx, ec)
    }
    // `litAtomWidenTexts` is `emitAtomToStr`'s shared ladder; its declaration rung is
    // what a monomorphized instance needs, since the instance's leaf nodes share the
    // generic body and record the generic's own type parameter instead.
    const lpTexts = litAtomWidenTexts(c.callArgs[0], fnIx)
    // a claim with no texts means the rep and the recorded type disagree: the chain
    // matches nothing, rc 0 with no output — the quietest possible wrong answer.
    if lpTexts.length == 0 {
      return emitFail(
        "emitProgram: print of a literal-union atom whose type carries no member texts",
      )
    }
    const lpRc = emitPrintAtomStr(body, c.callArgs[0], lpTexts, fnIx, ec)
    return lpRc
  }
  // a nullable-string value may genuinely hold null, and prints `null` when it does.
  // Asked before `exprString`, which also claims it (the softened render says
  // `string` over a `(ref null $a)` cell) — without the order, a possibly-null ref
  // streams straight into `array.len`, a runtime trap on a `vl check`-clean program.
  const pnk = exprNulKind(c.callArgs[0], fnIx)
  if pnk == "nulstr" {
    return emitPrintNulString(body, c.callArgs[0], fnIx, ec)
  }
  // the other niche, `boolean | null` (an i32 with sentinel 2): the fallback ladder
  // ends in `__print_bool__`, which renders any non-zero as true — an un-arrested
  // null would print true, silently.
  if pnk == "nulbool" { return emitPrintNulBool(body, c.callArgs[0], fnIx, ec) }
  // `print(<value-union box>)` dispatches on the box tag and prints the arm the
  // value holds (D712). Asked after the two niche arms — they are niches, not boxes,
  // and `printUnionPlan` declines both — and before `exprString`, on the same
  // ordering argument as the litunion-atom arm above: a rendering can claim a box.
  const puKinds: i32[] = []
  if printUnionPlan(c.callArgs[0], fnIx, puKinds) {
    return emitPrintValueUnion(body, c.callArgs[0], puKinds, fnIx, ec)
  }
  // a union-valued argument the plan declined must not fall through: the ladder below
  // ends in `call __print_i32__` with a `(ref $uBox)` on the stack, check-clean
  // invalid wasm (D711). The checker gates on the type, this on the expression, so
  // the residue is whatever the expression-side resolvers cannot name.
  if (
    printUnionArmsUnrenderable(c.callArgs[0], fnIx)
    || printArgIsUnclassifiedBox(c.callArgs[0], fnIx)
  ) {
    return emitFail(
      "emitProgram: print of a union value whose arms the tag dispatch cannot classify",
    )
  }
  if exprString(c.callArgs[0], fnIx) {
    return emitPrintStrExpr(body, c.callArgs[0], fnIx, ec)
  }
  // i64 routes to `__print_i64__` (a `(i64)->()` functype) checked before bool/i32;
  // f64 to `__print_f64__`, checked first since a float operand is never i64/bool/i32;
  // f32 to `__print_f32__`, checked before f64 so a mixed f32/float-literal
  // expression (`x + 4.0` with f32 `x`) prints as f32, not f64.
  const argF32 = exprIsF32(c.callArgs[0], fnIx)
  const argI64 = exprIsI64(c.callArgs[0], fnIx)
  const argF64 = exprIsF64(c.callArgs[0], fnIx)
  if emitExpr(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
  if argF32 {
    fbCall(gF32PrintIdx) // 0x10 call __print_f32__
  } else if argF64 {
    fbCall(gF64PrintIdx) // 0x10 call __print_f64__
  } else if argI64 {
    fbCall(4) // 0x10 call __print_i64__ (import index 4)
  } else if exprIsBool(c.callArgs[0], fnIx) {
    fbCall(1) // 0x10 call __print_bool__ (import index 1)
  } else {
    fbCall(0) // 0x10 call __print_i32__ (import index 0)
  }
  return 0
}

// The sub-i32 and wide store intrinsics of `emitCallCore`: the address, the value at its
// declared width, then the store opcode. Returns 0 once emitted, -1 on failure.
function emitCallCoreMemStore(
  body: u8[],
  c: Call,
  callee: Ident,
  fnIx: i32,
  ec: ExpCtx,
) {
  const msOff = emitMemAddr(body, c, 2, fnIx, callee.identName, ec)
  if msOff < 0 { return -1 }
  const msVal = memCallArg(c, 2, 1)
  if memStoreValueIsI32(callee.identName) {
    // `i32.store8` / `i32.store16` take an ordinary i32 and TRUNCATE it, so the
    // value goes through the same spine as the address and as `__store_i32__`'s
    // own value — no widening helper.
    if emitExpr(body, msVal, fnIx, ec) < 0 { return -1 }
  } else if callee.identName == "__store_i64__" {
    if emitExprAsI64(body, msVal, fnIx, ec) < 0 { return -1 }
  } else if callee.identName == "__store_f32__" {
    if emitExprAsF32(body, msVal, fnIx, ec) < 0 { return -1 }
  } else {
    if emitExprAsF64(body, msVal, fnIx, ec) < 0 { return -1 }
  }
  // The same drift guard the load arm carries, for the same reason: the name list
  // and the two tables are THREE lists over the same names in two files, and a
  // width added to one and not the others would reach here with -1 and write it as
  // an opcode byte — a silently invalid module. Unreachable while they agree.
  const msOp = memStoreOpcode(callee.identName)
  const msAlign = memStoreAlignExp(callee.identName)
  if msOp < 0 || msAlign < 0 {
    return emitFail(
      "emitProgram: '"
        + callee.identName
        + "' is a declared store width with no opcode — the intrinsic-name list and the opcode table have drifted",
    )
  }
  fbMemAccess(msOp, msAlign, msOff)
  return 0
}

// The `__memory_copy__` / `__memory_fill__` arm of `emitCallCore`. Returns 0 once emitted, -1
// on failure.
function emitCallCoreMemBulk(
  body: u8[],
  c: Call,
  callee: Ident,
  fnIx: i32,
  ec: ExpCtx,
) {
  if c.callArgs.length != 3 {
    return emitFail(
      "emitProgram: internal: "
        + callee.identName
        + " reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  if emitExpr(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
  if emitExpr(body, c.callArgs[1], fnIx, ec) < 0 { return -1 }
  if emitExpr(body, c.callArgs[2], fnIx, ec) < 0 { return -1 }
  if callee.identName == "__memory_copy__" {
    // Two memory indices: destination first, then source.
    fbMemBulk(MISC_MEMORY_COPY, 2)
  } else {
    fbMemBulk(MISC_MEMORY_FILL, 1)
  }
  return 0
}

// The load intrinsics of `emitCallCore` other than `__load_i32__`. Returns 0 once emitted, -1
// on failure.
function emitCallCoreMemLoad(
  body: u8[],
  c: Call,
  callee: Ident,
  fnIx: i32,
  ec: ExpCtx,
) {
  const mlOff = emitMemAddr(body, c, 1, fnIx, callee.identName, ec)
  if mlOff < 0 { return -1 }
  // the guard above and the two tables below are three lists keyed by the same
  // names, in two files: a fourth width added to one and not the others would
  // reach here with -1 and write it as an opcode byte, a silently invalid module.
  // Unreachable while the lists agree, and free when they do.
  const mlOp = memLoadOpcode(callee.identName)
  const mlAlign = memLoadAlignExp(callee.identName)
  if mlOp < 0 || mlAlign < 0 {
    return emitFail(
      "emitProgram: '"
        + callee.identName
        + "' is a declared load width with no opcode — the intrinsic-name list and the opcode table have drifted",
    )
  }
  fbMemAccess(mlOp, mlAlign, mlOff)
  return 0
}

// The `__log__(ptr, len)` arm of `emitCallCore`. Returns 0 once emitted, -1 on failure.
function emitCallCoreLog(body: u8[], c: Call, fnIx: i32, ec: ExpCtx) {
  if c.callArgs.length != 2 {
    return emitFail(
      "emitProgram: internal: __log__ reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  if emitExpr(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
  if emitExpr(body, c.callArgs[1], fnIx, ec) < 0 { return -1 }
  fbCall(gMemLogIdx)
  return 0
}

// The host-floor arm of `emitCallCore` for intrinsic slot `fsK`: each argument at its declared
// width, then the reserved import. Returns 0 once emitted, -1 on failure.
function emitCallCoreHostFloor(
  body: u8[],
  c: Call,
  callee: Ident,
  fsK: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const fsWant = fsIntrinsicArity(fsK)
  if fsWant < 0 || c.callArgs.length != fsWant {
    return emitFail(
      "emitProgram: internal: "
        + callee.identName
        + " reached with "
        + i32ToStr(c.callArgs.length)
        + " argument(s) — the checker's arity rule refuses it",
    )
  }
  const fsTarget = fsIdxAt(fsK)
  if fsTarget < 0 {
    return emitFail(
      "emitProgram: '"
        + callee.identName
        + "' is called but no import was reserved for it — the use scan and the call lowering have drifted",
    )
  }
  let fsA = 0
  while fsA < c.callArgs.length {
    // A `u8[]` argument needs the packed list type collected.
    if fsArgIsU8List(fsK, fsA) {
      if !ba8Used {
        return emitFail(
          "emitProgram: "
            + callee.identName
            + " takes a u8[] but the u8 list type was not collected",
        )
      }
      if emitExpr(body, c.callArgs[fsA], fnIx, ec) < 0 { return -1 }
    } else {
      if fsArgIsI64(fsK, fsA) {
        // Its declared width, as the wide stores' value operand takes: an i32 left
        // on the stack for a plain literal offset would not validate.
        if emitExprAsI64(body, c.callArgs[fsA], fnIx, ec) < 0 { return -1 }
      } else {
        if emitExpr(body, c.callArgs[fsA], fnIx, ec) < 0 { return -1 }
      }
    }
    fsA = fsA + 1
  }
  fbCall(fsTarget)
  return 0
}

// The user-extern arm of `emitCallCore` for link `exK`: each argument at its declared width,
// then the reserved import. Returns 0 once emitted, -1 on failure.
function emitCallCoreExtern(
  body: u8[],
  c: Call,
  callee: Ident,
  exK: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const exWant = externArityAt(exK)
  if exWant < 0 || c.callArgs.length != exWant {
    return emitFail(
      "emitProgram: internal: extern "
        + callee.identName
        + " reached with "
        + i32ToStr(c.callArgs.length)
        + " argument(s) — the checker's arity rule refuses it",
    )
  }
  const exTarget = externIdxAt(exK)
  if exTarget < 0 {
    return emitFail(
      "emitProgram: extern '"
        + callee.identName
        + "' is called but no import was reserved for it — the manifest and the call lowering have drifted",
    )
  }
  let exA = 0
  while exA < c.callArgs.length {
    // Its DECLARED width, not the argument's own: an i32 literal left on the stack
    // for an `i64` parameter would not validate.
    const exPT = externParamAt(exK, exA)
    if exPT == "i64" {
      if emitExprAsI64(body, c.callArgs[exA], fnIx, ec) < 0 { return -1 }
    } else if exPT == "f64" {
      if emitExprAsF64(body, c.callArgs[exA], fnIx, ec) < 0 { return -1 }
    } else if exPT == "f32" {
      if emitExprAsF32(body, c.callArgs[exA], fnIx, ec) < 0 { return -1 }
    } else {
      // `i32` and `boolean` alike — a boolean is an i32 at the boundary. The checker
      // refuses every other spelling, so none reaches here.
      if emitExpr(body, c.callArgs[exA], fnIx, ec) < 0 { return -1 }
    }
    exA = exA + 1
  }
  fbCall(exTarget)
  return 0
}

// The `__trap__(msg?)` arm of `emitCallCore`. Returns 0 once emitted, -1 on failure.
function emitCallCoreTrap(body: u8[], c: Call, fnIx: i32, ec: ExpCtx) {
  if c.callArgs.length > 1 {
    return emitFail("emitProgram: __trap__ takes an optional string message")
  }
  // `__trap__("reason")`: stream the message to the host boundary FIRST
  // (the same `__print_char__`/`__print_str_flush__` path `print(<string>)`
  // uses), so an abort carries a human-readable reason, THEN `unreachable`.
  if c.callArgs.length == 1 {
    if emitPrintStrExpr(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
  }
  fbUnreachable()
  return 0
}

// The direct call node a UFCS `self`-method call `o.f(args)` rewrites to, `f(o, args)` with
// named arguments shifted past the receiver, or -1 when `f` takes no leading `self`.
function emitCallCoreUfcsNode(callIx: i32, c: Call, um: Member) {
  // a UFCS member-call normally lowers to a direct `Ident` call before emission;
  // this fallback re-derives the same direct call should it reach emit unrewritten.
  // D1120 — at the site, the same node the merge walk keys on.
  let uName = ufcsAliasAtSite(callIx, um.memProp)
  const ud = memberDeclOf(callIx)
  if ud >= 0 {
    if memberMethodOf(callIx) != ud { return -1 }
    uName = binderNameAt(ud)
  }
  const uTarget = fnIndexOf(uName)
  if uTarget >= 0 {
    const uFn = nodeAt(fnStmts[uTarget])
    if uFn is FuncDecl {
      const uParams = uFn.fnParams
      if uParams.length == c.callArgs.length + 1 {
        const uP0 = nodeAt(uParams[0])
        if uP0 is Param {
          if uP0.parName == "self" {
            const uArgs: i32[] = []
            uArgs.push(um.memObj)
            let ua = 0
            while ua < c.callArgs.length {
              uArgs.push(c.callArgs[ua])
              ua = ua + 1
            }
            // The injected receiver is an UNNAMED slot-0 positional; any
            // named args shift right with it ("" rides slot 0) so the
            // rebuilt direct call reorders them around the receiver
            // exactly as the host does.
            const uNames: string[] = []
            if hasNamedArgs(c.callArgNames) {
              uNames.push("")
              let un = 0
              while un < c.callArgNames.length {
                uNames.push(c.callArgNames[un])
                un = un + 1
              }
            }
            return mkCallN(mkIdent(uName, -1), uArgs, uNames, -1)
          }
        }
      }
    }
  }
  -1
}

// `emitCallCore`'s user-function tail for callee `callee`: the scope-resolved function's
// direct, captured or low-memory call, a closure binding's `call_ref`, or a numeric
// intrinsic when the name resolves to no function. Returns 0 or -1.
function emitCallCoreUserFn(
  body: u8[],
  callIx: i32,
  c: Call,
  callee: Ident,
  fnIx: i32,
  ec: ExpCtx,
) {
  // Scope-aware: `buildFnMap` keys lifted functions by name, first wins, so the flat map
  // would give every frame's `inner(…)` the module's first `inner`. The positioned lookup
  // takes the block-local function whose scope covers this call, else a top-level one.
  const target = fnIndexOfInScopeChainAt(
    sidOfNode(c.callFn),
    callee.identName,
    fnIx,
    c.callFn,
  )
  // A live closure binding of the name outranks that scan, which cannot see a param or a
  // local (D1602); a local declared later does not yet shadow the function (D3607). Asked
  // only on a hit, so a plain call pays nothing.
  if (
    target >= 0
    && identNameIsLiveBound(callee.identName, fnIx)
    && identIsBoundClosure(callee.identName, fnIx)
  ) {
    return emitCallRef(body, callIx, fnIx, ec)
  }
  if target < 0 {
    // Not a known function name — a closure-valued callee, dispatched through the closure
    // fat-pointer — unless it is a numeric intrinsic's name that no binding covers here,
    // which is the intrinsic even where a later local closure takes the name (D3607).
    const intrHere = isNumIntrinsicName(callee.identName)
      && !identNameIsBoundAt(callee.identName, fnIx, c.callFn)
      && globalIndexOf(callee.identName) < 0
    if !intrHere && exprIsClosure(c.callFn, fnIx) {
      return emitCallRef(body, callIx, fnIx, ec)
    }
    // The numeric-opcode intrinsics: one wasm instruction over the arguments. Reached
    // only where the name resolved to no function, no closure value and no frame binding
    // (a captured loop variable), which IS the shadowing rule the checker types against —
    // a program that defines its own `min` calls its own (D2010).
    if !identNameIsLiveBound(callee.identName, fnIx) {
      const bcRc = emitBitcastIntr(body, callIx, fnIx, callee.identName, ec)
      if bcRc != NUM_INTR_NONE { return bcRc }
      const fiRc = emitFloatIntr(body, callIx, fnIx, callee.identName, ec)
      if fiRc != NUM_INTR_NONE { return fiRc }
      const iiRc = emitIntIntr(body, callIx, fnIx, callee.identName, ec)
      if iiRc != NUM_INTR_NONE { return iiRc }
    }
    if nodeTyAt(c.callFn, fnIx) == TY_NULL { return emitNullCalleeCall() }
    return emitFail("emitProgram: call to unknown function")
  }
  // A lambda-lifted function takes its captures as parameters (SP-037).
  if cloLifted(target) { return emitDirectCall(body, callIx, fnIx, target, ec) }
  // a direct call to a capturing lifted function (`add(10)` where `add` captures `n`
  // from the enclosing frame): build its closure value and `call_ref` it — a plain
  // `call` would pass a null env and lose the captures. Gated on `fnNestUsed` so a
  // no-lambda module never enters this path.
  if fnNestUsed && captureCountOf(target) > 0 {
    return emitCapturedCall(body, callIx, fnIx, target, ec)
  }
  if gLowMemUnused > 0 {
    const lmaRc = emitLowMemAccessorCall(body, callIx, fnIx, target, ec)
    if lmaRc <= 0 { return lmaRc }
  }
  return emitDirectCall(body, callIx, fnIx, target, ec)
}

// `emitCallCore`'s named-callee arm: the builtins and intrinsics matched by spelling where
// no user declaration or binding owns the name, then `emitCallCoreUserFn`. Returns 0 or -1.
function emitCallCoreIdent(
  body: u8[],
  callIx: i32,
  c: Call,
  callee: Ident,
  fnIx: i32,
  ec: ExpCtx,
) {
  // a user function of the same name must win: checked before any spelling-based
  // builtin match, since matching by spelling alone routes a same-named user
  // declaration into the builtin instead — a whole-set bug, not one name's (D975,
  // filed as a refutation pin: that collision surface must not come back).
  const userOwnsName = fnIndexOfNode(c.callFn) >= 0
  // the scope's answer for the dunder intrinsics, whose arms below match the
  // spelling with no declaration lookup at all. See `identNameIsUserBound`.
  const userBindsName = identNameIsUserBound(callee.identName, fnIx)
  // `__str_from_bytes__(src, at, count)` (D4784): one call into the helper, which bounds-checks
  // the range against `src`'s length and copies it into an exact-fit string.
  if !userBindsName && callee.identName == "__str_from_bytes__" {
    return emitCallCoreStrFromBytes(body, c, fnIx, ec)
  }
  // `fromCodePoints(xs)` (H2): bulk string construction into the shared `__utf8_enc__`
  // helper, UTF-8-encoding the list's live code points into an exact-fit backing. Each
  // i32 is a code point, never a byte — filling the buffer by `buf.push(s[i])` instead
  // pushes bytes and double-encodes with no type error, so every `std/` builder uses `for cp`.
  if !userOwnsName && callee.identName == "fromCodePoints" {
    return emitCallCoreFromCodePoints(body, callIx, c, fnIx, ec)
  }
  // `fromCodePoint(code)` is a compiler builtin (H2): construct a single-character VL
  // string from an i32 code point, riding the same `__utf8_enc__` helper `fromCodePoints`
  // does — a one-element i32 array wrapped around the argument. Sharing the encoder
  // avoids a second, inlined width-and-shift ladder disagreeing silently with it.
  if !userOwnsName && callee.identName == "fromCodePoint" {
    return emitCallCoreFromCodePoint(body, c, fnIx, ec)
  }
  // `print(x)` is a compiler builtin lowered to the host's import family: a
  // boolean-classified arg calls `__print_bool__`, anything else i32-ish
  // `__print_i32__`. The call yields nothing (void import).
  if !userOwnsName && callee.identName == "print" {
    return emitCallCorePrint(body, callIx, c, fnIx, ec)
  }
  // The linear-memory intrinsics, lowered inline (the host defines `__store_i32__`/
  // `__load_i32__` as one-instruction wasm functions): store/load become
  // `i32.store`/`i32.load` directly; `__log__` calls the synthetic in-module decoder
  // at `gMemLogIdx` (see `emitMemLogFnCode`).
  if !userBindsName && callee.identName == "__store_i32__" {
    const s32Off = emitMemAddr(body, c, 2, fnIx, "__store_i32__", ec)
    if s32Off < 0 { return -1 }
    if emitExpr(body, memCallArg(c, 2, 1), fnIx, ec) < 0 { return -1 }
    fbMemAccess(OP_I32_STORE, 2, s32Off)
    return 0
  }
  if !userBindsName && callee.identName == "__load_i32__" {
    const l32Off = emitMemAddr(body, c, 1, fnIx, "__load_i32__", ec)
    if l32Off < 0 { return -1 }
    fbMemAccess(OP_I32_LOAD, 2, l32Off)
    return 0
  }
  // The five other store widths (`buffer-design.md` §C2): push the address, then the
  // value at its own declared width, then the opcode at its natural alignment.
  if !userBindsName && nameIsMemStoreIntrinsic(callee.identName) {
    return emitCallCoreMemStore(body, c, callee, fnIx, ec)
  }
  // the bulk pair (`buffer-design.md` §C3): three i32 operands
  // (no width dispatch, unlike the store arm), pushed in the instruction's own order,
  // which VL's argument order matches — a mismatched order would mean reordering
  // arbitrary expressions' side effects.
  if !userBindsName && nameIsMemBulkIntrinsic(callee.identName) {
    return emitCallCoreMemBulk(body, c, callee, fnIx, ec)
  }
  // The ten other load widths (`buffer-design.md` §C2): push the address, write the
  // opcode at its natural alignment — the per-width difference is exactly two bytes,
  // held in `memLoadOpcode`/`memLoadAlignExp`. `__load_i32__` keeps its own arm above.
  if !userBindsName && nameIsMemLoadIntrinsic(callee.identName) {
    return emitCallCoreMemLoad(body, c, callee, fnIx, ec)
  }
  // The SIMD intrinsics (`simd-design.md` §D6), each lowered inline to a 0xFD-prefix
  // instruction — the third prefixed family, beside the 0xfb GC and 0xfc misc ones.
  // Dispatched by name like the memory intrinsics above it.
  if !userBindsName && nameIsSimdIntrinsic(callee.identName) {
    return emitSimdIntrinsic(body, c, callee.identName, fnIx, ec)
  }
  // The threads-proposal atomics (`simd-design.md` §G1), the 0xFE-prefix family.
  if !userBindsName && nameIsAtomicIntrinsic(callee.identName) {
    return emitAtomicIntrinsic(body, c, callee.identName, fnIx, ec)
  }
  // The scalar saturating truncations, one `0xFC` instruction each.
  if !userBindsName && truncSatOp(callee.identName) >= 0 {
    return emitTruncSatIntrinsic(body, c, callee.identName, fnIx, ec)
  }
  // `memory.size` / `memory.grow` — the two ops that lift the 64 KiB ceiling
  // (`buffer-design.md` §B2/§S4). Both take the memory index as an immediate (0x00,
  // the one memory), never a stack operand. `memory.grow`'s -1-on-failure is the wasm
  // spec's own signal, passed through unchanged: a caller checks it as the spec describes.
  if !userBindsName && callee.identName == "__memory_size__" {
    if c.callArgs.length != 0 {
      return emitFail(
        "emitProgram: internal: __memory_size__ reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    fbMemorySize()
    return 0
  }
  if !userBindsName && callee.identName == "__memory_grow__" {
    if c.callArgs.length != 1 {
      return emitFail(
        "emitProgram: internal: __memory_grow__ reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    if emitExpr(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
    fbMemoryGrow()
    return 0
  }
  // The heap window: a read of the immutable global pair `emitGlobalSection` appends.
  if !userBindsName && callee.identName == "__heap_base__" {
    return emitHeapWindowRead(c.callArgs.length, 0, "__heap_base__")
  }
  if !userBindsName && callee.identName == "__heap_limit__" {
    return emitHeapWindowRead(c.callArgs.length, 1, "__heap_limit__")
  }
  // A build-time constant; as the whole condition of an else-less `if` it never
  // reaches here, because `foldMemShared` already decided that statement.
  if !userBindsName && callee.identName == "__memory_shared__" {
    if c.callArgs.length != 0 {
      return emitFail(
        "emitProgram: internal: __memory_shared__ reached with the wrong argument count — the checker's arity rule refuses it",
      )
    }
    if gSharedMemPages > 0 { fbI32Const(1) } else { fbI32Const(0) }
    return 0
  }
  if !userBindsName && callee.identName == "__log__" {
    return emitCallCoreLog(body, c, fnIx, ec)
  }
  // ── the host floor (`std:fs`, `std:args`, `std:process`, `std:env`) ───────
  // The one intrinsic family that lowers to a host call rather than instructions. One
  // arm for every slot, keyed by four small tables; the index is dynamic (reserved
  // only when used), so a miss fails loudly.
  const fsK = fsIntrinsicSlot(callee.identName)
  if fsK >= 0 { return emitCallCoreHostFloor(body, c, callee, fsK, fnIx, ec) }
  // ── user externs (`extern function`) ───────────────────────────────────
  // The second family that lowers to a host call. Guarded by `userBindsName` like every
  // spelling-matched arm: a PARAMETER of the same name is a legal local and must win.
  if !userBindsName {
    const exK = externLinkOf(callee.identName)
    if exK >= 0 { return emitCallCoreExtern(body, c, callee, exK, fnIx, ec) }
  }
  // The array-intrinsic floor (std-design D1 / collections-design §LS.2),
  // lowered INLINE to single WasmGC instructions (array.new /
  // array.new_default / array.copy / unreachable). `__trap__()` is the
  // deliberate abort primitive.
  if !userBindsName && callee.identName == "__trap__" {
    return emitCallCoreTrap(body, c, fnIx, ec)
  }
  // `__array_new__(n, fill)` → `array.new` (every slot set to `fill`);
  // `__array_new_default__(n)` → `array.new_default` (slots zeroed). Both yield the
  // `{backing, len: n, cap: n}` list wrapper, staging the length in the 1-slot arrNew
  // scratch local. Native element coverage: i32 (i32/boolean) and, for `__array_new__`, f64.
  if (
    !userBindsName
    && (callee.identName == "__array_new__"
      || callee.identName == "__array_new_default__")
  ) {
    return emitArrayNewIntr(body, callIx, fnIx, ec)
  }
  // `__array_copy__(dst, dstAt, src, srcAt, count)` → `array.copy` over the two
  // lists' backings (memmove semantics; OOB spans trap via the instruction's own
  // check). Operand order matches the instruction's stack shape, so no scratch is needed.
  if !userBindsName && callee.identName == "__array_copy__" {
    return emitArrayCopyIntr(body, callIx, fnIx, ec)
  }
  return emitCallCoreUserFn(body, callIx, c, callee, fnIx, ec)
}

// A call through a value this instance types `null` itself, which a guard leaves dead: the
// stack-polymorphic `unreachable` stands in for its result (D3197).
function emitNullCalleeCall(): i32 {
  fbUnreachable()
  0
}

// Node shapes read: Call { callFn: i32, callArgs: i32[] }, callee Ident { identName }.
function emitCallCore(body: u8[], callIx: i32, fnIx: i32, ec: ExpCtx) {
  const c = nodeAt(callIx)
  if c is Call {
    const tplStr = tplStrHoleOf(c, fnIx)
    if tplStr >= 0 { return emitStrValue(body, tplStr, fnIx, ec) }
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Ident {
      return emitCallCoreIdent(body, callIx, c, callee, fnIx, ec)
    }
    // A non-Ident callee yielding a function value (`o.go(10)`, `(expr)(args)`):
    // `call_ref` over the closure fat-pointer.
    if exprIsClosure(c.callFn, fnIx) {
      return emitCallRef(body, callIx, fnIx, ec)
    }
    // a UFCS `self`-method call: `o.f(args)` where `f` is a free function whose first
    // parameter is named `self` lowers to the direct call `f(o, args)`, by building the
    // direct-call node in the arena and re-lowering it so every coercion path is shared.
    const um = nodeAt(c.callFn)
    if um is Member {
      const uCall = emitCallCoreUfcsNode(callIx, c, um)
      if uCall >= 0 { return emitCall(body, uCall, fnIx, ec) }
    }
    // `p?.f(…)` reaches here only when the guard's receiver cannot be read twice (a call, an
    // operator result): `drwOptGuard` declined rather than evaluate it once per arm. Naming
    // it beats "callee is not a function name", which describes the swap, not the reason.
    if um is OptMember {
      return emitFailAt(
        "emitProgram: an optional call needs a receiver the guard can read twice — bind it to a name first",
        callIx,
      )
    }
    if nodeTyAt(c.callFn, fnIx) == TY_NULL { return emitNullCalleeCall() }
    return emitFail("emitProgram: callee is not a function name")
  }
  emitFail("emitProgram: expected a call expression")
}

// The argument value nodes of the call at `callIx`, bound into parameter order for a direct
// call to the function at fnStmts position `target`. An all-positional call returns its
// source list untouched; a named call reorders by the callee's parameter names. A binding
// failure surfaces as a -1 slot/surplus entry, which `directArgsBad` detects.
function orderedDirectArgs(callIx: i32, target: i32) {
  const none: i32[] = []
  const c = nodeAt(callIx)
  if c is Call {
    if !hasNamedArgs(c.callArgNames) { return c.callArgs }
    const pNames: string[] = []
    const d = nodeAt(fnStmts[target])
    if d is FuncDecl {
      const ps = d.fnParams
      let i = 0
      while i < ps.length {
        const p = nodeAt(ps[i])
        if p is Param { pNames.push(p.parName) }
        i = i + 1
      }
    }
    return orderArgsByParamNames(pNames, c.callArgs, c.callArgNames)
  }
  none
}

// Is the argument at `argIx` a plain struct whose emitted heap type is union-arm `vi`'s —
// a declared layout twin sharing one heap type in the emitted module? The predicate
// (`sHeapIdx[row] == uVarHeap[vi]`) is the same test `emitUnionBoxArg` runs at the box
// boundary. False for a non-struct argument, an unresolvable row, or a slot outside the variant table.
function cloArgIsArmHeapTwin(argIx: i32, vi: i32, fnIx: i32): boolean {
  if vi < 0 { return false }
  if vi >= uVarHeap.length { return false }
  if !exprStruct(argIx, fnIx) { return false }
  const si = structIndexOfExpr(argIx, fnIx)
  if si < 0 { return false }
  if si >= sHeapIdx.length { return false }
  sHeapIdx[si] == uVarHeap[vi]
}

// The lifted slot the callee `calleeIx` names when it reads a `const` bound to a
// lambda-lifted function in frame `fnIx`, else -1.
function cloLiftCalleeOf(calleeIx: i32, fnIx: i32): i32 {
  if fnIx < 0 || calleeIx < 0 || calleeIx >= P.nodes.length { return -1 }
  const callee = nodeAt(calleeIx)
  if !(callee is Ident) { return -1 }
  const li = identLetOfAt(sidOfNode(calleeIx), fnIx, calleeIx)
  if li < 0 { return -1 }
  cloLiftLetFe(fnStmtsPosOf(fnIx), li)
}

// A narrowed `X | null` argument keeps its nullable rep, so a parameter of non-null kind `pk`
// whose slot is a bare `(ref $heap)` takes it through `ref.as_non_null`. The checker proved
// the call guarded, so the recover cannot trap. `null` or any other kind is a no-op.
function emitNonNullParamRecover(pk: VKind | null, argIx: i32, fnIx: i32) {
  match pk {
    "struct" | "variant" => {
      if exprNullableRecord(argIx, fnIx) { fbRefAsNonNull() }
    }
    "list" | "strlist" | "f64list" | "i64list" | "f32list" | "reflist" | "map" => {
      if (
        exprNullableList(argIx, fnIx)
        || exprNulScalarListKind(argIx, fnIx) != null
        || exprNullableRefArray(argIx, fnIx)
        || exprNullableMap(argIx, fnIx)
      ) {
        fbRefAsNonNull()
      }
    }
    "closure" => {
      if exprNulClosure(argIx, fnIx) { fbRefAsNonNull() }
    }
    "i32" | "str" | "union" | "nulvariant" | "nulstruct" | "i64" | "f64" | "f32" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" | "v128" | null => {
      // Scalars and atoms have no reference to recover, a nullable slot takes the value as
      // it is, and a union box or a `u8[]` is never narrowed into a bare heap slot.
    }
  }
  0
}

// The call of a function value. The caller's context is restored on every exit.
function emitCallRef(body: u8[], callIx: i32, fnIx: i32, ec: ExpCtx) {
  const saved = expCtxHere(ec)
  expCtxLeave(saved, emitCallRefUnder(body, callIx, fnIx, ec), ec)
}

// One argument of a function-value call: applies `argBase` with the seeds of parameter `i`
// of `ckey`, then lowers `args[i]` coerced to that parameter. Returns -1 on a failure, else 0.
function emitCallRefArg(
  body: u8[],
  callIx: i32,
  fnIx: i32,
  ckey: string,
  argBase: ExpCtx,
  args: i32[],
  i: i32,
  ec: ExpCtx,
) {
  // D940 — the struct row the functype declares, seeded exactly as the direct call
  // seeds it from `paramStructIdxOf`: an object-literal argument otherwise resolves
  // its own row by field set, the pre-merge row wherever the callee's parameter row
  // moved. The seed is the key's, so it agrees with the functype by construction.
  const pkk = sigParamKindAt(ckey, i)
  expCtxApply(argBase, ec)
  const ac = expCtxHere(ec)
  // An argument's raw-read seeds are its parameter's alone, as at a direct call (D3816).
  ac.nulString = pkk == "nulstr"
  ac.rawNullRead = false
  expCtxApply(ac, ec)
  const pck = sigParamCoerceKind(ckey, i)
  if pck == "i64" {
    if emitExprAsI64(body, args[i], fnIx, ec) < 0 { return -1 }
  } else if pck == "f64" {
    if emitExprAsF64(body, args[i], fnIx, ec) < 0 { return -1 }
  } else if pck == "f32" {
    if emitExprAsF32(body, args[i], fnIx, ec) < 0 { return -1 }
  } else {
    // the literal-union param positions: a member-literal argument lowers as its
    // interned i32 atom id, and a `null` argument into a `K | null` param as the
    // sentinel `-1` — without them a string ref reached an i32 param slot, invalid
    // wasm with `vl check` clean, in every function-value shape.
    let clu = cloCallParamLitUnion(callIx, i, fnIx)
    // An un-annotated parameter pinned at a literal union has a hole in the callee's type,
    // so the `i` token is the only word, and an atom argument makes it the atom (D3076).
    if clu == 0 && (pkk == "i32" || pkk == null) {
      if tyIsLitUnion(nodeTyAt(args[i], fnIx)) { clu = 1 }
    }
    // the value-union param position (the box `u`): the kind comes off the resolved
    // `$fnsig` key so the coercion cannot disagree with the bytes; the box's own
    // identity comes from the checker type instead, since it is slot-free in the ABI —
    // else a raw member argument pushes a string ref where the box is needed.
    let cuNm = ""
    if sigParamKindAt(ckey, i) == "union" {
      cuNm = cloCallParamUnionName(callIx, i, fnIx)
      if cuNm == "" {
        // the key says box and no registered name resolves — a producer disagreement,
        // not a shape the rep declines. Refuse loudly rather than push the un-boxed
        // operand: invalid wasm is the one outcome this arm must never reach.
        return emitFail(
          "emitProgram: value-call union parameter has no resolvable union name",
        )
      }
    }
    // the arm-parameter arm (D269, direction 2 of D200): a `variant` parameter demands
    // one heap type (`uVarHeap[vi]`), so a raw push stays a floor except where it is
    // provably safe. The slot comes off the resolved `$fnsig` key, so the cast target
    // cannot disagree with the bytes.
    let cvSlot = -1
    if sigParamKindAt(ckey, i) == "variant" {
      cvSlot = sigParamSlotAt(ckey, i)
      const cvArg = nodeAt(unwrapParen(args[i]))
      // the layout-twin argument (D732): with a twin declared, the arm and the struct
      // share one heap type in the emitted module (`uVarSTwin`), so the raw push the
      // direct call already performs is valid by construction (asked of the heaps,
      // not the tables — `emitUnionBoxArg`'s discipline at the same seam).
      const cvTwin = cloArgIsArmHeapTwin(args[i], cvSlot, fnIx)
      const cvBuildable = cvSlot >= 0
        && (exprUnion(args[i], fnIx) || cvArg is ObjLit || cvTwin)
      if exprVariantIndex(args[i], fnIx) < 0 && !cvBuildable {
        return emitFail(
          "emitProgram: value-call union-ARM parameter given a value that is not that arm — a value call does not yet build one (annotate the binding as the arm, or call it as a named function)",
        )
      }
    }
    if cvSlot >= 0 && exprVariantIndex(args[i], fnIx) < 0 {
      if emitExprExpect(body, args[i], fnIx, ec) < 0 { return -1 }
      if exprUnion(args[i], fnIx) {
        if variantHasCrossTagFits(cvSlot, args[i], fnIx) {
          return emitFailCrossTagDelivery(args[i], cvSlot)
        }
        fbStructGet(uBoxIdx, 1)     // 0xfb 0x02 <box ht> field 1: value (anyref)
        fbRefCast(uVarHeap[cvSlot]) // 0xfb 0x16 <variant struct> ref.cast (non-null)
      }
    } else if pkk == "nulvariant" {
      // The niche parameter (D3074), as the direct call's argument rung builds it: an object
      // literal builds the arm, and a value narrowed out of a box is unboxed to the arm.
      const cnvSlot = sigParamSlotAt(ckey, i)
      if cnvSlot < 0 || cnvSlot >= uVarHeap.length {
        return emitFail(
          "emitProgram: value-call nullable union-arm parameter has no variant slot",
        )
      }
      if emitExprExpect(body, args[i], fnIx, expCtxHere(ec)) < 0 { return -1 }
      if narrowedArmNeedsUnbox(args[i], fnIx) {
        emitNarrowedArmUnboxTo(
          armDestHeapOf("nulvariant", cnvSlot),
          args[i],
          fnIx,
        )
      }
    } else if cuNm != "" {
      if emitUnionBoxArg(body, cuNm, -1, args[i], fnIx, ec) < 0 { return -1 }
    } else if (
      sigParamKindAt(ckey, i) == "str"
      && exprIsLitAtom(args[i], fnIx)
    ) {
      // the mirror of `clu`: a literal-union atom argument flowing into a `string`
      // parameter widens to its member string, since the functype declares `(ref
      // $array)` there and the atom local holds an i32 id — a `string` token is a ref,
      // unlike the litunion token, so it is never confusable with i32.
      if emitAtomToStr(body, args[i], fnIx, ec) < 0 { return -1 }
    } else if (
      clu == 0
      && (isScalarBackedListRep(pkk) || isNulScalarListKind(pkk))
    ) {
      if emitExprExpect(body, args[i], fnIx, expCtxHere(ec)) < 0 { return -1 }
    } else if clu == 0 {
      // The parameter's nullability is assigned from the key, as a direct call assigns it
      // from the declaration: an enclosing position's non-null expectation would otherwise
      // recover a `null` argument into a nullable parameter, a trap (D2552).
      const cuCtx = expCtxHere(ec)
      cuCtx.nulString = pkk == "nulstr"
      cuCtx.nulBool = pkk == "i32" && cloCallParamIsNulBool(callIx, i, fnIx)
      if emitExprExpect(body, args[i], fnIx, cuCtx) < 0 { return -1 }
      // A value narrowed out of a box into a struct parameter is unboxed, as the direct
      // call unboxes it (D1723); the slot is the key's, so the cast agrees with the bytes.
      if pkk != null && narrowedArmNeedsUnbox(args[i], fnIx) {
        emitNarrowedArmUnboxTo(
          armDestHeapOf(pkk, sigParamSlotAt(ckey, i)),
          args[i],
          fnIx,
        )
      }
    } else {
      const cluCtx = expCtxHere(ec)
      cluCtx.litUnion = 1
      if clu == 2 { cluCtx.nulLitUnion = true }
      if emitExprExpect(body, args[i], fnIx, cluCtx) < 0 { return -1 }
    }
    // The same boundary as a direct call's, keyed off the `$fnsig` param (D2537).
    emitNonNullParamRecover(pkk, args[i], fnIx)
  }
  0
}

// The first argument whose type at frame `fnIx` is a scalar or string other than the one
// parameter `i` of function `fe` takes, which no coercion bridges; -1 when every argument fits.
function directCallInstanceArgMisfit(args: i32[], fe: i32, fnIx: i32): i32 {
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    let i = 0
    while i < args.length && i < fn.fnParams.length {
      if cloArgInstanceMisfits(args[i], vtKindOfParam(fn.fnParams[i]), fnIx) {
        return i
      }
      i = i + 1
    }
  }
  -1
}

// Does argument `argIx`, typed by a type variable that instance `fnIx` binds to a scalar or
// string, meet a parameter of another such kind `pk`? A null `pk` never misfits.
function cloArgInstanceMisfits(
  argIx: i32,
  pk: VKind | null,
  fnIx: i32,
): boolean {
  if pk == null || !cloArgKindIsPlain(pk) { return false }
  const own = nodeTyIxOf(unwrapParen(argIx))
  if own < 0 || !tyHasTyVar(own) { return false }
  if exprString(argIx, fnIx) { return pk != "str" }
  if exprIsF64(argIx, fnIx) { return pk != "f64" }
  if exprIsI64(argIx, fnIx) { return pk != "i64" }
  // An i32 widens into a numeric parameter, so only a string parameter refuses it.
  const it = instanceTyOf(own, fnIx)
  if it < 0 || tyIsLitUnion(it) { return false }
  const d = repOfTy(it)
  d.rdCovered != 0 && d.rdKind == "i32" && pk == "str"
}

// The `let`/`const` callee `ix` reads, also when the monomorphizer renamed it to an
// instance; -1 when it names a function.
function callFnBindingOf(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length || !(nodeAt(ix) is Ident) { return -1 }
  const d = identDeclOf(ix)
  if d >= 0 && d < P.nodes.length && nodeAt(d) is LetDecl { return d }
  monoAliasDeclOf(ix)
}

function cloArgKindIsPlain(k: VKind): boolean {
  k == "i32" || k == "i64" || k == "f64" || k == "f32" || k == "str"
}

// `emitCallRef`'s body: each argument applies its parameter's context and leaves it for the
// wrapper's exit to undo.
function emitCallRefUnder(body: u8[], callIx: i32, fnIx: i32, ec: ExpCtx) {
  const c = nodeAt(callIx)
  if c is Call {
    const liftFe = cloLiftCalleeOf(c.callFn, fnIx)
    if liftFe >= 0 { return emitDirectCall(body, callIx, fnIx, liftFe, ec) }
    if hasNamedArgs(c.callArgNames) {
      return emitFail(
        "emitProgram: named arguments work only on declared functions, not on a function value",
      )
    }
    // Evaluate the closure once into the call-ref scratch local (`callRefNestSlot`).
    if emitExpr(body, c.callFn, fnIx, ec) < 0 { return -1 }
    // A NULLABLE function value (`fn | null`, kind 19) loads as `(ref null $cloStruct)`;
    // the scratch slot is non-null, and the checker proved it non-null here (the `if c !=
    // null` narrowing), so recover to non-null.
    if exprNulClosure(c.callFn, fnIx) { fbRefAsNonNull() }
    const crDepth = callRefDepth
    const crSlot = callRefNestSlot(callRefDepth)
    fbLocalSet(crSlot)
    // the callee's interned `$fnsig` key — from a function-typed annotation, an inferred
    // binding's sig, a field closure's, or a closure-array element's. Its tokens drive
    // argument coercion below and resolve the functype `ref.cast`s to; "" falls back to
    // the all-i32 arity sig.
    const ckey = cloCallSigKey(callIx, fnIx)
    // A key taking fewer parameters than the call passes names a function the value no
    // longer holds (a pruned dead binding's signature); its `call_ref` would not validate (D7142).
    if (
      ckey != ""
      && c.callArgs.length > 0
      && sigParamKindAt(ckey, c.callArgs.length - 1) == null
    ) {
      return emitFail(
        "emitProgram: a function value's signature is not known at this call — the type it was given takes fewer parameters than the call passes",
      )
    }
    // soundness floor: a value-union closure result with a composite member (`(i32) => f32
    // | {w:i32}`) is not yet representable — the lambda infers its one concrete arm while
    // the checker types the call as the whole union, so the narrow that reads it mis-reads
    // the plain rep as the box. Reject rather than leak the unsound narrow to invalid wasm.
    if cloCallUnionResultUnrepresentable(callIx, fnIx) {
      return emitFail(
        "emitProgram: value-union closure RESULT is not yet representable",
      )
    }
    // A ref-list closure result whose PRODUCER lambda and cast annotation key distinct,
    // non-layout-twin element slots (a nullable-element list built from a non-null literal):
    // the wrapper structs are distinct heap types, so the call-ref `ref.cast` would TRAP.
    // Reject cleanly — the deferred nullable-element ref-list composition.
    if cloCallReflistElemTwin(callIx, fnIx) {
      return emitFail(
        "emitProgram: closure ref-list result element twin (deferred value-ABI composition)",
      )
    }
    // env = closure.env (field 0).
    fbLocalGet(crSlot)
    fbStructGet(cloStructIdx, 0)
    callRefDepth = crDepth + 1
    // args, each COERCED to its parameter's scalar valtype (an i32 literal widened into an i64 / f64
    // / f32 param) — the `call_ref` functype demands the exact valtype, exactly as a direct call.
    const args = c.callArgs
    // each argument's valtype is decided by its parameter, so an enclosing wide-scalar
    // context must not leak into it — else a bare i32 literal argument under an outer f32/atom
    // context lowers at the wrong valtype for the `call_ref` functype: invalid wasm.
    const argBase = expCtxHere(ec)
    argBase.litUnion = 0
    argBase.nulLitUnion = false
    let i = 0
    while i < args.length {
      if emitCallRefArg(body, callIx, fnIx, ckey, argBase, args, i, ec) < 0 {
        return -1
      }
      i = i + 1
    }
    callRefDepth = crDepth
    // id = closure.id (field 1) — the callee's wasm function index, `call_indirect`'d at
    // the concrete `$fnsig` (the engine signature-checks the callee against it).
    let sig = -1
    if ckey != "" { sig = cloSigTypeIdxAt(cloSigPosOfKey(ckey)) }
    if sig < 0 && !cloCallArityFallbackUnsound(callIx, fnIx) {
      sig = fnSigIdxForArity(args.length)
    }
    if sig < 0 {
      // A binding called at two types can take a slot per type.
      fsAskCallee(c.callFn)
      return emitFail(
        "emitProgram: a function-value call has no interned signature — "
          + cloCallSigRejectWhat(callIx, fnIx),
      )
    }
    fbLocalGet(crSlot)
    fbStructGet(cloStructIdx, 1)     // the callee's wasm function index
    fbCallIndirect(sig, gFnTableIdx) // 0x11 <fnsig> <table>
    armTailCallIndirect(sig, sigKeyRetVoid(ckey))
    return 0
  }
  emitFail("emitProgram: expected a call expression")
}

// ── statement-sequence lowering ──────────────────────────────────────────────
// A function body is a sequence of statements, lowered onto `body` in order. Control
// flow relies on explicit `return`s rather than block result types: an `if` is a void
// structured block whose branches `return` on their own, so it never yields a value.

// The value of the binding write being emitted, in place or moved to a local by the capture-cell
// rewrite. A generic function written to a binding is instanced or refused by the
// written-binding passes (D3939), so its stub is never called.
let stubWriteRhs = 0 - 1
// Cleared per program by `emitProgram`: a node id is only meaningful in the arena that minted it.
export function stubWriteRhsReset() { stubWriteRhs = 0 - 1 }

// Lower an assignment `target = value` onto `body`: the value emits under the target's
// `ExpCtx`, then the store. The caller's context is restored on every exit, failure included.
// The variant row of the declared local `lhsIx` names when its cell holds a bare union arm
// (`variant`), else -1. Every value assigned to such a cell is delivered as that arm.
function assignArmCellVariantIdx(lhsIx: i32, fnIx: i32): i32 {
  if identCellVKind(lhsIx, fnIx) != "variant" { return -1 }
  const slot = identCellSlot(lhsIx)
  if slot < 0 || slot >= localIsRef.length || slot >= localStructIdx.length {
    return -1
  }
  if localIsRef[slot] != "variant" { return -1 }
  const vi = localStructIdx[slot]
  if vi < 0 || vi >= uVarHeap.length { return -1 }
  vi
}

function emitAssign(body: u8[], binIx: i32, fnIx: i32, ec: ExpCtx) {
  const saved = expCtxHere(ec)
  expCtxLeave(saved, emitAssignUnder(body, binIx, fnIx, ec), ec)
}

// `emitAssignUnder`'s module-global arm: the target names no local, so it stores through
// `global.set`, or refuses a name that is no global either. Returns 0 lowered, -1 failed.
function emitAssignGlobal(
  body: u8[],
  a: BinExpr,
  lhsIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // Not a local — a module global? Store with `global.set` (0x24 <globalidx>).
  const gIdx = globalIndexOfSid(sidOfNode(lhsIx))
  if gIdx >= 0 {
    const gLet = globalStmts[gIdx]
    const gaKind = globalCellKind(gLet)
    const gaArmIdx = globalCellArmIdx(gLet, gaKind)
    const gaCellIsArm = gaKind == "variant" || gaKind == "nulvariant"
    // a union-typed global (kind 4) coerces a raw assigned value into the box; three
    // shapes are not that: a literal-union global's cell is a plain `(mut i32)` atom,
    // a concrete-variant RHS must be boxed unconditionally since a union global's
    // cell is always the box, and an arm cell is not the box either.
    const gUNm = letUnionNameOf(gLet, -1)
    // The local arm's rule: a `variant` cell takes the bare arm whatever builds it, and
    // the coerce owns that value's unbox and recover.
    const gaCoerced = gaKind == "variant"
      && gaArmIdx >= 0
      && gaArmIdx < uVarHeap.length
    if (
      gUNm != ""
      && !tyIsLitUnion(nodeTyIxOf(lhsIx))
      && !unionRowIsLitUnion(88, gUNm, letUnionDeclTyIxOf(gLet))
      && !gaCellIsArm
    ) {
      if (
        emitUnionBoxArg(body, gUNm, nodeTyIxOf(lhsIx), a.binRight, fnIx, ec)
        < 0
      ) {
        return -1
      }
    } else if gaCoerced {
      if emitVariantCoerce(body, gaArmIdx, a.binRight, fnIx, ec) < 0 {
        return -1
      }
    } else if exprIsI64(lhsIx, fnIx) {
      // an i64 global target widens an i32 RHS to i64: the bare `i32.const` otherwise
      // clashes with the i64 slot (the checker accepts the assignment, so it is a
      // soundness hole). An already-i64 RHS makes `emitExprAsI64` a no-op.
      if emitExprAsI64(body, a.binRight, fnIx, ec) < 0 { return -1 }
    } else if exprIsF64(lhsIx, fnIx) {
      // the f64 twin: an integer-literal RHS needs widening into `(mut f64)`; an
      // f64-literal RHS needs none.
      if emitExprAsF64(body, a.binRight, fnIx, ec) < 0 { return -1 }
    } else if exprIsF32(lhsIx, fnIx) {
      // the f32 cell: a float RHS must re-encode at single precision, since a bare
      // `.` literal lowers at f64 by default. `emitExprAsF32` re-encodes the literal
      // and delegates everything else. Ordered after the f64 arm: the two classifiers
      // are mutually exclusive over an Ident target, so neither steals the other's cell.
      if emitExprAsF32(body, a.binRight, fnIx, ec) < 0 { return -1 }
    } else if (
      (gaKind == "str" || gaKind == "nulstr")
      && exprString(lhsIx, fnIx)
      && exprIsLitAtom(a.binRight, fnIx)
    ) {
      // A literal-union atom assigned to a `string` global widens to its member string.
      // A cell laid out as the atom itself takes the atom as it is (D3198).
      if emitAtomToStr(body, a.binRight, fnIx, ec) < 0 { return -1 }
    } else if gaKind == "nulnone" {
      // D1576 — the module-global twin of the local arm's `nulnone` store: a
      // `null`-typed cell takes `ref.null none` and nothing else.
      if emitNulNoneForEffect(body, a.binRight, fnIx, ec) < 0 { return -1 }
      fbRefNullNone()
    } else {
      // a non-ref niche `X | null` global seeds its null rep for a bare `null` RHS,
      // mirroring the seed the global's own initializer gets; a non-null RHS ignores it.
      const gsCtx = expCtxHere(ec)
      const gsk = identCellVKind(lhsIx, fnIx)
      if gsk == "nulbool" { gsCtx.nulBool = true }
      if gsk == "nulstr" { gsCtx.nulString = true }
      if exprNulLitUnion(lhsIx, fnIx) {
        gsCtx.nulLitUnion = true
        gsCtx.litUnion = 1
      }
      // a literal-union global (`v = "b"` over `let v: K`): the member RHS lowers as
      // its interned i32 id, not a heap string — the other half of the litunion
      // exclusion above.
      if exprIsLitAtom(lhsIx, fnIx) { gsCtx.litUnion = 1 }
      if emitExprExpect(body, a.binRight, fnIx, gsCtx) < 0 { return -1 }
    }
    // the scalar dual (D965) at the global-assignment boundary (`b = e` between two
    // module globals) — distinct from the global-init copy in `emit_sections`, since
    // a re-assignment is ordinary code and a const initializer a wasm constexpr.
    emitScalarListWidenSite(body, a.binRight, fnIx, gaKind)
    // and the ref copy (D791) at the same boundary, the local assignment's twin (D2163).
    emitRefListWidenSite(
      body,
      a.binRight,
      exprEmittedRefListSlot(a.binRight, fnIx),
      exprEmittedRefListSlot(lhsIx, fnIx),
    )
    // the narrowed-arm unbox at the same boundary (D1031) — `gv = s` under `if s is
    // Circle`, between two module globals; `armDestHeapOf` reads the destination pair.
    if !gaCoerced && narrowedArmNeedsUnbox(a.binRight, fnIx) {
      emitNarrowedArmUnboxTo(armDestHeapOf(gaKind, gaArmIdx), a.binRight, fnIx)
    }
    // the nullable-niche recover at the same boundary (D1115) — `g = y` under
    // `if y != null`, into a global whose cell is a non-null ref.
    if !gaCoerced && nulNicheRecoverOwed(gaKind, a.binRight, fnIx) {
      fbRefAsNonNull()
    }
    return emitUserGlobalSet(gIdx) // 0x24 global.set, or a promoted `local.set`
  }
  return emitFail(
    "emitProgram: assignment target is not a parameter, local, or global",
  )
}

// Whether the registered union `nm`, declared `ty` (-1 for none), is a homogeneous literal
// union, which reps as its atom or base scalar rather than a box, asked of its row's arena
// type; false when no row, or no type, carries it.
function unionRowIsLitUnion(site: i32, nm: string, ty: i32): boolean {
  const u = unionRowKeyAB(site, nm, ty)
  if u < 0 || u >= unTyIx.length { return false }
  homogLitUnionBase(unTyIx[u]) >= 0
}

// `emitAssignIdent`'s plain arm: the RHS of `x = v` into a local or parameter cell, seeded with
// the null, struct, list, map, variant and literal-union reps the cell carries. Returns 0 lowered,
// -1 failed.
function emitAssignLocalSeeded(
  body: u8[],
  a: BinExpr,
  lhsIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // A NICHE `X | null` local seeds its null rep for a bare `null` RHS, as the global
  // arm above does. A non-null RHS ignores the seed (a boolean is a `BoolLit`, a
  // function RHS builds the non-null closure value). The cell's kind decides, not the read's: a
  // narrowed name holds its declared cell.
  const asCtx = expCtxHere(ec)
  const ack = identCellVKind(lhsIx, fnIx)
  if ack == "nulbool" { asCtx.nulBool = true }
  if ack == "nulstr" { asCtx.nulString = true }
  // A literal-union local (`k = "b"`): the member RHS lowers as its interned i32 id.
  if exprIsLitAtom(lhsIx, fnIx) { asCtx.litUnion = 1 }
  if emitExprExpect(body, a.binRight, fnIx, asCtx) < 0 { return -1 }
  0
}

// `emitAssignUnder`'s arm over a name target `x = v`: the string accumulator, a module
// global, then a local or parameter cell. `target` is `P.nodes[lhsIx]`. Returns 0 lowered,
// -1 failed.
function emitAssignIdent(
  body: u8[],
  binIx: i32,
  fnIx: i32,
  a: BinExpr,
  lhsIx: i32,
  target: Ident,
  ec: ExpCtx,
) {
  stubWriteRhs = unwrapParen(a.binRight)
  // the loop-local accumulator: a binding proven by `strAccScan` to append in place
  // into its own buffer's slack instead of allocating a fresh exact-fit string per
  // step — O(n) where the pairwise lowering is O(n^2). An unproven binding never reaches it.
  if strAccAppendOk(binIx, fnIx) {
    return emitStrAccAppend(body, binIx, fnIx, ec)
  }
  const idx = localIndexOf(fnIx, target.identName)
  if idx < 0 { return emitAssignGlobal(body, a, lhsIx, fnIx, ec) }
  // a union-typed local (kind 4) coerces a raw assigned value into the box (`u = 3.5`
  // over `let u: i32 | f64` boxes the f64); a union-valued RHS passes through unchanged.
  const aUNm = unionNameOfIdentAt(sidOfNode(lhsIx), fnIx, lhsIx)
  // A cell holding the atom is no box, whatever union its template joined (D3268).
  const aAtomCell = aUNm != ""
    && declaredKind(target.identName) != "union"
    && exprIsLitAtom(lhsIx, fnIx)
  const aArmVi = assignArmCellVariantIdx(lhsIx, fnIx)
  if aArmVi >= 0 {
    // An arm cell takes the bare variant struct whatever builds it: an object literal, an
    // `if` or `match` joining literals, a narrowed box (D4613, D4639).
    if emitVariantCoerce(body, aArmVi, a.binRight, fnIx, ec) < 0 { return -1 }
  } else if (
    aUNm != ""
    && !unionRowIsLitUnion(
      89,
      aUNm,
      unionDeclTyIxOfIdentAt(sidOfNode(lhsIx), fnIx, lhsIx),
    )
    && !aAtomCell
  ) {
    // a literal-union target is an i32 atom, not a value-union box, and falls through
    // to the seed block below. A kind-4 union-box local boxes a concrete variant RHS
    // like a call arg/return; a kind-8 variant-init local keeps the raw variant rep, so
    // it must not box — use the plain coerce there.
    if declaredKind(target.identName) == "union" {
      if (
        emitUnionBoxArg(body, aUNm, nodeTyAt(lhsIx, fnIx), a.binRight, fnIx, ec)
        < 0
      ) {
        return -1
      }
    } else {
      if (
        emitUnionCoerce(body, aUNm, nodeTyIxOf(lhsIx), a.binRight, fnIx, ec)
        < 0
      ) {
        return -1
      }
    }
  } else if exprNulLitUnion(lhsIx, fnIx) {
    // a `K | null` niche target: the i32 cell holds an atom id or sentinel `-1`. Seeded
    // before the `string` branch, which would otherwise widen the member RHS to a heap string.
    const nluCtx = expCtxHere(ec)
    nluCtx.nulLitUnion = true
    nluCtx.litUnion = 1
    if emitExprExpect(body, a.binRight, fnIx, nluCtx) < 0 { return -1 }
  } else if exprIsI64(lhsIx, fnIx) {
    // An i64 target (`x = 0` over `let x: i64`) widens an i32 RHS to i64 — without this the
    // bare `i32.const` clashes with the i64 slot (the checker accepts the assignment, so it
    // is a soundness hole). `emitExprAsI64` is a no-op for an already-i64 RHS.
    if emitExprAsI64(body, a.binRight, fnIx, ec) < 0 { return -1 }
  } else if exprIsF64(lhsIx, fnIx) {
    // An f64 target (`y = 3` over `let y: f64`) widens an i32 RHS to f64, same rationale.
    if emitExprAsF64(body, a.binRight, fnIx, ec) < 0 { return -1 }
  } else if exprIsF32(lhsIx, fnIx) {
    // An f32 target (`g = 2.5` over `let g: f32`) re-encodes a float RHS at SINGLE
    // precision — the twin of the global arm's f32 cell above, missing here for the
    // same reason and with the same witness (`emitExpr` defaults a bare `.` literal to
    // f64, so the `(mut f32)` slot took an `f64.const`). Params take this arm too.
    if emitExprAsF32(body, a.binRight, fnIx, ec) < 0 { return -1 }
  } else if exprString(lhsIx, fnIx) && exprIsLitAtom(a.binRight, fnIx) {
    // A literal-union atom assigned to a `string` local widens to its member string.
    if emitAtomToStr(body, a.binRight, fnIx, ec) < 0 { return -1 }
  } else if identCellVKind(lhsIx, fnIx) == "nulnone" {
    // D1576 — the only value a `null`-typed cell can take is `null`, so this needs no
    // rep decision from either side: `ref.null none`, the RHS still evaluated for effects.
    if emitNulNoneForEffect(body, a.binRight, fnIx, ec) < 0 { return -1 }
    fbRefNullNone()
  } else {
    if emitAssignLocalSeeded(body, a, lhsIx, fnIx, ec) < 0 { return -1 }
  }
  // read-only covariance at the ASSIGNMENT boundary (D791) — `aU = lv1` over a
  // `let aU: Shape[]` and a `Circle[]`-repped `lv1`.
  emitRefListWidenSite(
    body,
    a.binRight,
    exprEmittedRefListSlot(a.binRight, fnIx),
    exprEmittedRefListSlot(lhsIx, fnIx),
  )
  // the scalar dual (D965) — `b = e` over a `let b: f64[]`. The destination is an
  // EXPRESSION here, not an annotation or a cell column, so its element kind comes
  // from classifying the LHS — the same classifier the source side uses.
  const asgDE = scalarListElemKind(lhsIx, fnIx)
  if asgDE != null {
    emitScalarListWidenSiteElem(body, a.binRight, fnIx, asgDE)
  }
  // the nullable-niche recover at the ASSIGNMENT boundary (D1115) — `z = y` under
  // `if y != null`, into a local or parameter whose slot is a non-null ref. The
  // destination is a NAME here, so its own cell kind is the destination kind.
  // An arm cell's coerce above owns both of the next two steps.
  if (
    aArmVi < 0
    && nulNicheRecoverOwed(identCellVKind(lhsIx, fnIx), a.binRight, fnIx)
  ) {
    fbRefAsNonNull()
  }
  // the narrowed-arm unbox at the ASSIGNMENT boundary, the binding boundary's twin: the
  // destination cell's own `(kind, slot)` columns are the destination, read through the
  // slot rather than the expression's type — the cell is a `variant` for an inferred
  // union's arm and `structIndexOfExpr` answers -1 for it (D1685).
  if aArmVi < 0 && narrowedArmNeedsUnbox(a.binRight, fnIx) {
    const asgSlot = identCellSlot(lhsIx)
    if (
      asgSlot >= 0
      && asgSlot < localIsRef.length
      && asgSlot < localStructIdx.length
    ) {
      emitNarrowedArmUnboxTo(
        armDestHeapOf(localIsRef[asgSlot], localStructIdx[asgSlot]),
        a.binRight,
        fnIx,
      )
    }
  }
  fbLocalSet(idx) // 0x21 local.set
  return 0
}

// An indexed store's target list: its rep, its wrapper and backing types, its bounds-check
// frame kind and ref-list table slot, and the element seeds the value emits under (a struct
// row, a variant, a box union's name, a ref-list slot whose element needs the value's context;
// -1 or "" when unset).
type IdxStore = {
  isRef: boolean,
  isStr: boolean,
  isF64: boolean,
  isI64: boolean,
  isF32: boolean,
  isU8: boolean,
  lTy: i32,
  aTy: i32,
  mfKind: MfKind,
  slot: i32,
  structIdx: i32,
  variantIdx: i32,
  unionNm: string,
  unionTy: i32,
  nestSlot: i32,
}

// `emitAssignIndex`'s target classification of list `arrIx` into `st`, which starts as the
// plain i32 list with no seeds. Returns 0, or a refusal's -1 when the list's type is not
// collected or its element row does not resolve.
function idxStoreClassify(arrIx: i32, fnIx: i32, st: IdxStore): i32 {
  if st.isRef {
    if !rlUsed {
      return emitFail(
        "emitProgram: ref indexed assignment but ref list type not collected",
      )
    }
    const rslot = refListSlotOfExpr(arrIx, fnIx)
    if rslot < 0 { return refListRowRefused(arrIx) }
    st.lTy = rlWrapIdx[rslot]
    st.aTy = rlBackIdx[rslot]
    st.mfKind = "ref"
    st.slot = rslot
    if rlElemKindTbl[rslot] == RLK_STRUCT {
      st.structIdx = rlElemStructRow(rslot)
      // ...and where that declines, the element is an ARM, at `uVarHeap[vi]`.
      if st.structIdx < 0 {
        st.variantIdx = variantIndexOf(nonNulBaseOf(rlElemName[rslot]))
      }
    }
    if rlElemKindTbl[rslot] == RLK_UNION {
      st.unionNm = rlElemName[rslot]
      st.unionTy = rlElemTyIxAt(rslot)
    }
    // A nullable element's value emits under the ambient seeds, as `.push`'s does.
    if rlElemNullable[rslot] == 1 { st.nestSlot = rslot }
  } else if st.isStr {
    // a string list `xs[i] = s`: unwrap to its `(ref null $sTypeIdx)` backing and
    // store the string ref, mirroring `emitIndex`'s string path — else it falls into
    // the i32-list case and `struct.get`s the wrong wrapper type.
    if !slUsed {
      return emitFail(
        "emitProgram: string indexed assignment but string list type not collected",
      )
    }
    st.lTy = mkListIdx
    st.aTy = mkArrIdx
    st.mfKind = "str"
  } else if st.isF64 {
    if !fa64Used {
      return emitFail(
        "emitProgram: f64 indexed assignment but f64 list type not collected",
      )
    }
    st.lTy = fl64TypeIdx
    st.aTy = fa64TypeIdx
    st.mfKind = "f64"
  } else if st.isI64 {
    if !ia64Used {
      return emitFail(
        "emitProgram: i64 indexed assignment but i64 list type not collected",
      )
    }
    st.lTy = il64TypeIdx
    st.aTy = ia64TypeIdx
    st.mfKind = "i64"
  } else if st.isF32 {
    if !fa32Used {
      return emitFail(
        "emitProgram: f32 indexed assignment but f32 list type not collected",
      )
    }
    st.lTy = fl32TypeIdx
    st.aTy = fa32TypeIdx
    st.mfKind = "f32"
  } else if st.isU8 {
    // a `u8[]` store: the same unwrap + `array.set` spine over the packed backing. The
    // value takes the plain i32 path below — a `u8` element value is an i32, and
    // `array.set`'s i8 storage truncates it to the low 8 bits.
    if !ba8Used {
      return emitFail(
        "emitProgram: u8 indexed assignment but u8 list type not collected",
      )
    }
    st.lTy = bl8TypeIdx
    st.aTy = ba8TypeIdx
    st.mfKind = "u8"
  } else {
    if !lUsed {
      return emitFail(
        "emitProgram: indexed assignment but list type not collected",
      )
    }
    if !exprArray(arrIx, fnIx) {
      return emitFail("emitProgram: indexed-assignment target is not an array")
    }
  }
  0
}

// `emitAssignIndex`'s stored value `a.binRight` into list `arrIx`, emitted under the target's
// element seeds and re-encoded at its element rep. Returns 0, or -1 failed.
function emitIdxStoreValue(
  body: u8[],
  fnIx: i32,
  a: BinExpr,
  arrIx: i32,
  st: IdxStore,
  ec: ExpCtx,
): i32 {
  if st.unionNm != "" {
    if emitUnionBoxArg(body, st.unionNm, st.unionTy, a.binRight, fnIx, ec) < 0 {
      return -1
    }
  } else if st.nestSlot >= 0 {
    // A nested-list row store: the RHS builds as the INNER list (inert for a
    // non-literal RHS — an ident/call emits unchanged).
    const snCtx = expCtxHere(ec)
    if emitExprExpect(body, a.binRight, fnIx, snCtx) < 0 { return -1 }
  } else if st.isF64 {
    // The stored value re-encodes at the element valtype (a bare-int / int-literal value
    // widens into the f64 slot, exactly as a binding / push does).
    if emitExprAsF64(body, a.binRight, fnIx, ec) < 0 { return -1 }
  } else if st.isI64 {
    if emitExprAsI64(body, a.binRight, fnIx, ec) < 0 { return -1 }
  } else if st.isF32 {
    if emitExprAsF32(body, a.binRight, fnIx, ec) < 0 { return -1 }
  } else if arrElemLitUnionTy(arrIx, fnIx) >= 0 {
    // `xs[i] = "a"` over a literal-union array: the member RHS lowers as its atom id —
    // the store half of the boundary `exprIsLitAtom`'s Index arm reads. Without it a
    // monomorphized instance's target classifies off the generic's shared node and
    // falls through to the string-widen arm, storing a ref into an i32 backing.
    const xluCtx = expCtxHere(ec)
    xluCtx.litUnion = 1
    if emitExprExpect(body, a.binRight, fnIx, xluCtx) < 0 { return -1 }
  } else if (
    arrElemIsNulBoolAt(arrIx, fnIx)
    || arrElemIsNullUnitAt(arrIx, fnIx)
  ) {
    // `p[i] = null` over a `(boolean | null)[]`: the i32 cell holds 0/1 or the
    // sentinel 2 — seed `ec.nulBool` (via the ctx) so a `null` RHS emits 2 (a
    // boolean RHS is a `BoolLit`, untouched). The list analogue of the scalar niche
    // assignment above.
    const nbCtx = expCtxHere(ec)
    nbCtx.nulBool = true
    if emitExprExpect(body, a.binRight, fnIx, nbCtx) < 0 { return -1 }
  } else if nodeArrayElemIsNulLitUnion(arrIx) {
    // `p[i] = "a"` / `p[i] = null` over a `(K | null)[]`: a member RHS lowers as its atom id, a
    // `null` as the `-1` sentinel — seed BOTH `litUnion` and `nulLitUnion` via the ctx.
    const nluCtx = expCtxHere(ec)
    nluCtx.litUnion = 1
    nluCtx.nulLitUnion = true
    if emitExprExpect(body, a.binRight, fnIx, nluCtx) < 0 { return -1 }
  } else if exprIsLitAtom(a.binRight, fnIx) {
    // a literal-union atom stored into a string-backed list element widens to its
    // member string — reached only once the atom-element arms above decline, so the
    // list is genuinely string-backed and the atom's i32 id cannot go in raw.
    if emitStrValue(body, a.binRight, fnIx, ec) < 0 { return -1 }
  } else if nodeArrayElemIsNulStr(arrIx) {
    // `p[i] = null` over a `(string | null)[]`: the null is the string backing's own
    // `ref.null`, as in the list literal (D2393).
    const nsCtx = expCtxHere(ec)
    nsCtx.nulString = true
    if emitExprExpect(body, a.binRight, fnIx, nsCtx) < 0 { return -1 }
  } else {
    if emitExpr(body, a.binRight, fnIx, ec) < 0 { return -1 }
  }
  0
}

// `emitAssignUnder`'s arm over an index target `xs[i] = v`: a map store or a list element
// store. Returns 0 lowered, -1 failed.
function emitAssignIndex(
  body: u8[],
  fnIx: i32,
  a: BinExpr,
  target: Index,
  ec: ExpCtx,
) {
  // G8: a map store `m[k] = v` — scan for `k`; overwrite `vals[hit]` on a hit, else
  // append `keys.push(k); vals.push(v)`. Checked BEFORE the list path (a map index
  // is not an array index).
  if exprMap(target.idxArr, fnIx) {
    return emitMapSet(
      body,
      target.idxArr,
      target.idxIndex,
      a.binRight,
      fnIx,
      ec,
    )
  }
  // indexed store `a[i] = v`: evaluate the wrapper + index, guard `i u< len` and
  // unwrap to the backing, then the value, then `array.set`. A ref list stores a
  // struct ref/union box over the ref list/backing indices; an i32 list stores an i32.
  const isRef = exprRefArray(target.idxArr, fnIx)
  const isStr = exprStringArray(target.idxArr, fnIx)
  // the scalar non-i32 lists: the same unwrap+`array.set` spine over their own
  // wrapper/backing, with the value coerced to the element valtype.
  const isF64 = exprF64Array(target.idxArr, fnIx)
  const isI64 = exprI64Array(target.idxArr, fnIx)
  const isF32 = exprF32Array(target.idxArr, fnIx)
  // the packed byte list — an i32-element list with a one-byte backing, the one rep
  // the `else` i32 fall-through below would otherwise silently claim.
  const isU8 = exprU8Array(target.idxArr, fnIx)
  const st: IdxStore = {
    isRef: isRef,
    isStr: isStr,
    isF64: isF64,
    isI64: isI64,
    isF32: isF32,
    isU8: isU8,
    lTy: lTypeIdx,
    aTy: aTypeIdx,
    mfKind: "i32",
    slot: 0,
    structIdx: -1,
    variantIdx: -1,
    unionNm: "",
    unionTy: -1,
    nestSlot: -1,
  }
  const crc = idxStoreClassify(target.idxArr, fnIx, st)
  if crc != 0 { return crc }
  // source order — receiver, index, value — with the wrapper + index parked on the
  // stack while the value's user code runs. The backing and len resolve only after
  // the value, since an RHS that pushes onto the target list reallocates it; a live
  // hoist row skips the receiver and guards the cached header, safe in a call-free loop.
  const stHz = liveHoistRow(target.idxArr, st.mfKind, st.slot)
  if stHz < 0 {
    if emitExpr(body, target.idxArr, fnIx, ec) < 0 { return -1 }
  }
  if emitExpr(body, target.idxIndex, fnIx, ec) < 0 { return -1 }
  if emitIdxStoreValue(body, fnIx, a, target.idxArr, st, ec) < 0 { return -1 }
  // the read-only covariant copy at the indexed-store boundary (D2163)
  if st.mfKind == "ref" {
    emitNestedListWidenSite(body, a.binRight, fnIx, st.slot)
  }
  // the narrowed-arm unbox at the ELEMENT-assignment boundary, the binding boundary's
  // twin one container over: the element's own variant or struct row is where the arm
  // lands, and those two seeds are what the value emits under (D1685).
  if narrowedArmNeedsUnbox(a.binRight, fnIx) {
    if st.variantIdx >= 0 {
      emitNarrowedArmUnboxTo(
        armDestHeapOf("variant", st.variantIdx),
        a.binRight,
        fnIx,
      )
    } else if st.structIdx >= 0 {
      emitNarrowedArmUnboxTo(
        armDestHeapOf("struct", st.structIdx),
        a.binRight,
        fnIx,
      )
    }
  }
  const storeValSlot = listIdxValSlot(st.mfKind, st.slot)
  fbLocalSet(storeValSlot) // 0x21 — park the value under the guard operands
  // Guard `i u< len`, unwrap to the backing (`struct.get` field 0) — leaves
  // [backing, safeIndex] resolved AFTER the value ran.
  if stHz >= 0 {
    emitListIdxGuardHoisted(stHz, target.idxIndex)
  } else {
    emitListIdxGuard(listIdxWrapSlot(st.mfKind, st.slot), st.lTy)
  }
  fbLocalGet(storeValSlot) // 0x20 — the parked value
  fbArraySet(st.aTy)       // 0xfb 0x0e <backing array type index>
  return 0
}

// A variant field write's tail once its receiver struct ref is on the stack: seeds an ARRAY
// field's element kind, widens a scalar f64/i64/f32 field's RHS `rhs` at the store boundary,
// then `struct.set`s field `fi` of variant `vi`. Returns 0, or -1 failed.
function emitVariantFieldWrite(
  body: u8[],
  vi: i32,
  fi: i32,
  rhs: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if emitVariantFieldStoreVal(body, vi, fi, rhs, fnIx, ec) < 0 { return -1 }
  if vi < 0 { return -1 }
  fbStructSet(uVarHeap[vi], fi)
  0
}

// `emitAssignMember`'s value for field `fieldIdx` (code `fscode`) of struct row `si`, its
// target context already applied: a box union coerces into the box, a literal-union atom widens
// or lowers as its id, a scalar re-encodes, a niche seeds its null. Returns 0, or -1 failed.
function emitStructFieldStoreValue(
  body: u8[],
  si: i32,
  fieldIdx: i32,
  fscode: i32,
  rhs: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  // The niche fields seed their null rep for a bare `null` (the `emitNullLitNode` table). A
  // box-union field (code 16) goes through `emitUnionBoxArg`, since the field cell is
  // `(ref $uBox)` — one home so the three code-16 sites cannot drift.
  if fscode == FC_UNION {
    if (
      emitUnionBoxArg(
        body,
        sFieldElemNameAt(si, fieldIdx),
        sFieldRowTyAt(si, fieldIdx),
        rhs,
        fnIx,
        ec,
      )
      < 0
    ) {
      return -1
    }
  } else if fscode == FC_STR && exprIsLitAtom(rhs, fnIx) {
    // A literal-union atom assigned to a `string` field (code 3) widens to its member string.
    if emitAtomToStr(body, rhs, fnIx, ec) < 0 { return -1 }
  } else if fscode == FC_NUL_STR && exprIsLitAtom(rhs, fnIx) {
    // the `string | null` field takes the same widen: its slot is the same string ref
    // with null permitted, and a widened member string is non-null. `emitObj` and
    // `emitAssign` are the two halves of every field code, and must agree.
    if emitStrValue(body, rhs, fnIx, ec) < 0 { return -1 }
  } else if sFieldIsLitUnion(si, fieldIdx) {
    // A literal-union atom field assign (`b.kind = "a"`): the member RHS lowers as its atom id.
    const wluCtx = expCtxHere(ec)
    wluCtx.litUnion = 1
    if emitExprExpect(body, rhs, fnIx, wluCtx) < 0 { return -1 }
  } else if sFieldIsLitUnionArray(si, fieldIdx) {
    // An atom-array field assign (`g.f = ["bb"]`): the RHS builds the i32 list of atom
    // ids (the atom context routes the literal off the string-list build — construct
    // parity with `emitObj`'s code-4 atom arm).
    const wlaCtx = expCtxHere(ec)
    wlaCtx.litUnion = 1
    if emitExprExpect(body, rhs, fnIx, wlaCtx) < 0 { return -1 }
  } else if fscode == FC_F64 || fscode == FC_I64 || fscode == FC_F32 {
    // A SCALAR f64/i64/f32 field widens its RHS at the store boundary, the exact
    // treatment `emitObj` gives the construct (`p.g = 9` into an i64 field emitted
    // a raw `i32.const` — invalid wasm at `struct.set`; pre-existing, flat AND
    // nested spellings).
    if emitScalarFieldStoreVal(body, rhs, fnIx, fscode, ec) < 0 { return -1 }
  } else if fscode == FC_NUL_NONE {
    // The `null` unit type's slot, the construct arm's twin (D4671).
    if emitNulNoneForEffect(body, rhs, fnIx, ec) < 0 { return -1 }
    fbRefNullNone()
  } else if fscode == FC_STRUCT {
    // The ASSIGN half of the construct arm (`p.g = s` after `if s is Circle`) — `emitObj`
    // and `emitAssign` are the two halves of every field code and have to be wired
    // together, which is the lesson the code-20 arm three branches up records.
    if emitArmDelivery(body, rhs, fnIx, sFieldTgtHeapOf(si, fieldIdx), ec) < 0 {
      return -1
    }
  } else {
    const fwCtx = expCtxHere(ec)
    if fscode == FC_NUL_STR { fwCtx.nulString = true }
    if fscode == FC_NUL_BOOL { fwCtx.nulBool = true }
    // A `K | null` niche field assign: member RHS -> atom id, `null` -> -1.
    if fscode == FC_NUL_LIT_UNION {
      fwCtx.litUnion = 1
      fwCtx.nulLitUnion = true
    }
    // then the value
    if emitExprExpect(body, rhs, fnIx, fwCtx) < 0 { return -1 }
  }
  0
}

// `emitAssignUnder`'s arm over a field target `o.f = v`: through a narrowed union box, into
// a variant receiver, or straight into the record. `target` is `P.nodes[lhsIx]`. Returns 0
// lowered, -1 failed.
function emitAssignMember(
  body: u8[],
  fnIx: i32,
  a: BinExpr,
  lhsIx: i32,
  target: Member,
  ec: ExpCtx,
) {
  // a field write on a narrowed union identifier (`if v is M { v.field = x }`)
  // downcasts through the box like the read path: push the box ref, unbox to the
  // variant struct, push the value, then `struct.set` — mutating the shared arena object.
  if memIsNarrowed(lhsIx) {
    const nvi = memNarrowVariantIndex(lhsIx)
    if nvi < 0 {
      return emitFail(
        "emitProgram: narrowed field-assignment receiver names no variant",
      )
    }
    if lhsIx < 0 { return -1 }
    const nm = nodeAt(lhsIx)
    if nm is Member {
      const nfi = variantFieldIndex(nvi, nm.memProp)
      if nfi < 0 {
        return emitFail(
          "emitProgram: unknown variant field in narrowed field assignment",
        )
      }
      if emitExpr(body, nm.memObj, fnIx, ec) < 0 { return -1 }
      fbStructGet(uBoxIdx, 1)  // box field 1: value (anyref)
      fbRefCast(uVarHeap[nvi]) // ref.cast to the variant struct
      // The field's context is taken AFTER the receiver's own emit, which may leave seeds
      // of its own behind.
      return emitVariantFieldWrite(body, nvi, nfi, a.binRight, fnIx, ec)
    }
  }
  // A field WRITE on a variant-typed param (`o: TyObj`) writes the variant struct
  // directly (the param IS the unboxed variant ref — no box unwrap).
  const pwvi = exprVariantIndex(target.memObj, fnIx)
  if pwvi >= 0 {
    if lhsIx < 0 { return -1 }
    const m1 = nodeAt(lhsIx)
    if m1 is Member {
      const pwfi = variantFieldIndex(pwvi, m1.memProp)
      if pwfi < 0 {
        return emitFail(
          "emitProgram: unknown variant field in field assignment",
        )
      }
      if emitExpr(body, m1.memObj, fnIx, ec) < 0 { return -1 }
      return emitVariantFieldWrite(body, pwvi, pwfi, a.binRight, fnIx, ec)
    }
  }
  // the nullable-variant receiver: a `T | null` binding whose `T` is a union arm holds
  // `(ref null $uVarHeap[vi])`, so this differs from the variant-param write above only
  // by one `ref.as_non_null`, safe since the checker admits the write only inside a null test.
  const nwvi = nulVariantIdxOfExpr(target.memObj, fnIx)
  if nwvi >= 0 {
    const nwfi = variantFieldIndex(nwvi, target.memProp)
    if nwfi < 0 {
      return emitFail("emitProgram: unknown variant field in field assignment")
    }
    if emitExpr(body, target.memObj, fnIx, ec) < 0 { return -1 }
    fbRefAsNonNull() // 0xd4 — the enclosing null test narrowed it
    return emitVariantFieldWrite(body, nwvi, nwfi, a.binRight, fnIx, ec)
  }
  const shw = emitSharedFieldAssign(body, lhsIx, a.binRight, fnIx, ec)
  if shw < 0 { return -1 }
  if shw == 1 { return 0 }
  // field write `recv.field = v` → `struct.set $0 <fieldidx>`; the single declared
  // struct lives at WasmGC type index 0. Operand order is load-bearing: struct ref
  // first, then the value.
  if !sDeclared {
    return emitFail("emitProgram: field assignment but no struct type declared")
  }
  const si = structIndexOfExpr(target.memObj, fnIx)
  if si < 0 {
    return emitFail("emitProgram: field-assignment receiver is not a struct")
  }
  const fieldIdx = sFieldIndex(si, target.memProp)
  if fieldIdx < 0 {
    return emitFail("emitProgram: unknown struct field in field assignment")
  }
  if emitExpr(body, target.memObj, fnIx, ec) < 0 {
    return -1 // struct ref first
  }
  const fscode = sFieldTypeAt(si, fieldIdx)
  if (
    emitStructFieldStoreValue(body, si, fieldIdx, fscode, a.binRight, fnIx, ec)
    < 0
  ) {
    return -1
  }
  // D1222 — the STORE half of the construct-side recover in `emitObj`; the two halves of
  // every field code have to be wired together, as the code-20 arm above records.
  if nulNicheRecoverOwed(fieldCodeVKind(fscode), a.binRight, fnIx) {
    fbRefAsNonNull()
  }
  // the read-only covariant copy at the field-store boundary, the construct's twin (D2163)
  emitFieldListWidenSite(
    body,
    a.binRight,
    fnIx,
    fscode,
    sFieldRefSlot(si, fieldIdx),
  )
  fbStructSet(sHeapIdx[si], fieldIdx) // 0xfb 0x05 <struct ht> <field index>
  return 0
}

// `emitAssign`'s body: an arm applies its target's context and leaves it for the exit to undo.
function emitAssignUnder(body: u8[], binIx: i32, fnIx: i32, ec: ExpCtx) {
  const a = nodeAt(binIx)
  if a is BinExpr {
    // A map cell's `null` is a miss, which no write narrows, so only other places refuse.
    nulWidenWriteRhs = -1
    const nwTgt = nodeAt(unwrapParen(a.binLeft))
    if !(nwTgt is Index) || !exprMap(nwTgt.idxArr, fnIx) {
      nulWidenWriteRhs = unwrapParen(a.binRight)
    }
    // the target is read through `unwrapParen`, exactly as the RHS already is (D1089):
    // `(x) = 5` is check-clean, so a `Paren` LHS matching none of the Ident/Index/Member
    // arms reached the floor with the wrong message. Peeling here is one change for all
    // six delivery positions; `sidOfNode(lhsIx)` is load-bearing since a `Paren` node interns its own sid.
    const lhsIx = unwrapParen(a.binLeft)
    if lhsIx < 0 { return -1 }
    const target = nodeAt(lhsIx)
    strSiteArm(binIx, fnIx)
    if target is Ident {
      return emitAssignIdent(body, binIx, fnIx, a, lhsIx, target, ec)
    }
    if target is Index { return emitAssignIndex(body, fnIx, a, target, ec) }
    if target is Member {
      return emitAssignMember(body, fnIx, a, lhsIx, target, ec)
    }
    return emitFail("emitProgram: assignment target is not a simple name")
  }
  emitFail("emitProgram: expected an assignment expression")
}

// Stage a list-op receiver that is not a bare local — a global, a struct field, an index —
// into the op frame's `recvRef` scratch slot: the one home the evaluate-once rule every
// list op needs. A nullable list cell needs the recover `emitExpr` withholds (so `g != null`
// can test the raw cell); this slot is a non-null wrapper ref instead, safe by narrowing.
function stageListRecv(
  body: u8[],
  objIx: i32,
  fnIx: i32,
  base: i32,
  ec: ExpCtx,
) {
  if emitExpr(body, objIx, fnIx, ec) < 0 { return -1 }
  const r = nodeAt(unwrapParen(objIx))
  if r is Ident {
    if globalNulListCellRead(fnIx, r.identName) {
      fbRefAsNonNull() // 0xd4
    } else if capturedNulListCellRead(fnIx, r.identName) {
      fbRefAsNonNull() // 0xd4
    }
  } else if nulRecvNeedsRecover(objIx, fnIx) {
    // A narrowed nullable field/index/call receiver reads `(ref null $wrap)` (D2235).
    fbRefAsNonNull() // 0xd4
  }
  fbLocalSet(base + 3) // local.set recvRef
  0
}

// True when an ident read of `name` unboxes a narrowed union arm rather than yielding the
// frame slot raw — the gate `emitIdentNode`'s narrowed value-atom and ref-array arms
// share, asked in the same order: a union binding in this frame, a capture (bound in
// another frame), and the typed-IR net behind both. Excludes the narrowed-map arm: a map is not a list receiver.
function identReadIsUnionUnbox(exprIx: i32, name: string, fnIx: i32) {
  if unionNameOfIdentAt(sidOfNode(exprIx), fnIx, exprIx) != "" { return true }
  if capturedIsUnionBox(fnIx, name) { return true }
  identChainTyBoxedUnion(name, fnIx, 4)
}

// True when the list-op receiver at `objIx` is an identifier narrowed to a list arm of a
// union box: such a name resolves like any local, but the local holds `(ref $uBox)`, so
// it must be staged through `emitExpr` (which runs the unbox) like a global/field/index
// receiver — else `.push`/`.clear` `struct.get`s the raw box, invalid wasm.
function listOpRecvNarrowedUnion(objIx: i32, name: string, fnIx: i32) {
  if (
    identReadAtomKindAt(objIx, fnIx) < 0
    && identReadContainerAt(objIx, fnIx) != RC_REF_LIST
  ) {
    return false
  }
  // the slot test is load-bearing: `callPopBits` reserves the scratch frame off
  // `identSlotIsUnionBox` alone, so staging on a wider condition here would stage into a
  // frame never laid out. The two passes ask the one question.
  if !identSlotIsUnionBox(fnIx, name) { return false }
  identReadIsUnionUnbox(objIx, name, fnIx)
}

// The scratch base a receiver that stages will use: `base` is the family default already
// resolved; `refSlot >= 0` defers the ref family's per-element-type frame to here, the one
// point that knows staging is happening. A `.pop`/`.clear` stages only a receiver it cannot
// read in place; a `.push` reads `base`..`base+2` regardless, so the ref frame is reserved for the first group only.
function listOpStageBase(base: i32, refSlot: i32): i32 {
  if refSlot < 0 { return base }
  refPushScratchBaseFor(refSlot)
}

// The one home for list-op receiver resolution: resolve `objIx` to the wasm local holding
// the list-wrapper ref, or -1 (loud, already recorded) for a receiver it cannot resolve. A
// bare identifier is such a local unless it is a narrowed union arm; every other receiver is
// staged once into the `recvRef` scratch slot, which `listOpRecvStages` reserves for it.
function listOpRecvLocal(
  body: u8[],
  objIx: i32,
  fnIx: i32,
  base: i32,
  refSlot: i32,
  op: string,
  ec: ExpCtx,
): i32 {
  const recv = nodeAt(objIx)
  if recv is Ident {
    if !listOpRecvNarrowedUnion(objIx, recv.identName, fnIx) {
      // An `is K[]` arm's empty list of another element (D4911): an op that only reads it
      // reads the arm's own, and a push lands there when the arm keeps it (D4934).
      const fitSh = listFitShadowRead(recv.identName, objIx, fnIx)
      if fitSh >= 0 && op == ".push" && !listFitGrowHolds(fitSh) {
        return emitFailAt(LIST_FIT_PUSH_MSG, objIx)
      }
      if fitSh >= 0 { return fitSh }
      // A closure's stand-in for such a list is its own, and a push into it would be lost.
      if (
        op == ".push"
        && listFitCaptureStandIn(recv.identName, objIx, fnIx, true) >= 0
      ) {
        return emitFailAt(LIST_FIT_PUSH_MSG, objIx)
      }
      const lIdx = localIndexOf(fnIx, recv.identName)
      if lIdx >= 0 { return lIdx }
      // A captured list ident (D1965) or a module global: the env field or global holds
      // the wrapper ref, so staging it through `emitExpr` mutates that same list in place.
      if (
        !identIsEnvCapture(fnIx, recv.identName)
        && globalIndexOfSid(sidOfNode(objIx)) < 0
      ) {
        return emitFail("emitProgram: " + op + " receiver is not a list local")
      }
    }
  }
  // A field, an index, a call, or a parenthesised, `??` or `if` value (SP-044): any
  // expression yielding the wrapper ref, evaluated once so the op's reads share it.
  const sb = listOpStageBase(base, refSlot)
  if stageListRecv(body, objIx, fnIx, sb, ec) < 0 { return -1 }
  sb + 3
}

// Lower a `recv.push(x)` member-call statement — the growable-list append, inlined rather
// than a helper call. `recv` must be a bare `Ident` naming a list local/param, taking
// exactly one i32 argument. Grows by doubling (floor of four) when `len == cap`, copying
// live elements into a fresh backing; G7-ref runs the identical sequence for a ref list.

// D1197 — the push value slot's rep kind, so `.push` can ask `nulNicheRecoverOwed` like
// any other nullable-ref delivery. Non-null `(ref $rlElemHeap)` unless the element is
// itself a nullable niche (a `null` push is then legal and nothing is owed); null also for
// the value-union box (its null is a tag inside a non-null box) and an unresolved slot.
function pushDestVKind(rslot: i32): VKind | null {
  if rslot < 0 || rslot >= rlElemKindTbl.length { return null }
  if rlElemNullable[rslot] == 1 { return null }
  const k = rlElemKindTbl[rslot]
  if k == RLK_STRUCT {
    if rlElemStructRow(rslot) >= 0 { return "struct" }
    return "variant"
  }
  if k == RLK_MAP { return "map" }
  if k == RLK_CLOSURE { return "closure" }
  // Code 2, the value-union box, owes nothing: its null is a tag inside a non-null box.
  rlElemListRep(k)
}

// receiver resolution for `.push` — `listOpRecvLocal`, the one home the four list ops
// share. Called from two points because a push whose value stages a receiver must resolve
// its own after that value (D1280); one function so the two cannot pass different arguments.
function pushRecvLocal(
  body: u8[],
  objIx: i32,
  fnIx: i32,
  base: i32,
  ec: ExpCtx,
) {
  listCastForPush = true
  const r = listOpRecvLocal(body, objIx, fnIx, base, -1, ".push", ec)
  listCastForPush = false
  r
}

// The build code a list of element kind `k` is built at — the mapping `emitArr`'s own
// arms read, so a synthesized literal lands on the same backing the receiver already has.
function pendingKindOfMf(k: MfKind, row: i32) {
  // Exhaustive over `MfKind` and `_`-less: `0` is the i32-list build code, a real answer, so a
  // new element kind must name its own rather than inherit it (D1898 made this scrutinee
  // matchable).
  match k {
    "f64" => {
      return LBK_F64_LIST
    }
    "i64" => {
      return LBK_I64_LIST
    }
    "f32" => {
      return LBK_F32_LIST
    }
    "u8" => {
      return LBK_U8_LIST
    }
    "str" => {
      return LBK_STR_LIST
    }
    "ref" => {
      if rlElemKindTbl[row] == RLK_UNION { return LBK_UNION }
      return LBK_REF
    }
    "i32" => {
      // The i32-list build code — the arm the fall-through named.
      return LBK_I32_LIST
    }
  }
}

// The list build of the run a variadic `.push` appends: the receiver's own, since the run is
// a synthesized literal no checker stamp reaches.
function pushRunListBuild(
  recvIx: i32,
  fnIx: i32,
  kk: MfKind,
  row: i32,
): ListBuild {
  let k = pendingKindOfMf(kk, row)
  if arrElemIsNulBoolAt(recvIx, fnIx) || arrElemIsNullUnitAt(recvIx, fnIx) {
    k = LBK_NUL_BOOL_LIST
  }
  if nodeArrayElemIsNulLitUnion(recvIx) { k = LBK_NUL_LIT_UNION_LIST }
  const lb: ListBuild = { lbKind: k, lbSlot: row }
  lb
}

// The context that run builds under: the element seeds the one-argument push gives its value,
// so a literal-union member lowers as its atom id and a `null` as the slot's niche (D4553).
function pushRunBuildCtx(recvIx: i32, fnIx: i32, ec: ExpCtx): ExpCtx {
  const c = expCtxHere(ec)
  if arrElemLitUnionTy(recvIx, fnIx) >= 0 { c.litUnion = 1 }
  if arrElemIsNulBoolAt(recvIx, fnIx) || arrElemIsNullUnitAt(recvIx, fnIx) {
    c.nulBool = true
  }
  if nodeArrayElemIsNulLitUnion(recvIx) {
    c.litUnion = 1
    c.nulLitUnion = true
  }
  if arrElemIsNulStrAt(recvIx, fnIx) { c.nulString = true }
  c
}

// `xs.push(a, b)` / `xs.push(...ys)` — the variadic appends. The arguments build as one list
// at the receiver's own rep, so a spread argument is `emitArrSpread`'s business; the receiver
// then grows once and the new elements arrive as a single `array.copy`. The one-argument
// push keeps its own element-wise lowering, which is what makes this path free of it.
function emitPushMany(
  body: u8[],
  callIx: i32,
  fnIx: i32,
  wantValue: boolean,
  ec: ExpCtx,
) {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      const kk = mfRecvKindOf(callee.memObj, fnIx)
      if kk == null {
        return emitFail("emitProgram: .push receiver is not a list")
      }
      let row = 0
      if kk == "ref" { row = refListSlotOfExpr(callee.memObj, fnIx) }
      const wrap = spreadWrapIdx(kk, row)
      const back = spreadBackIdx(kk, row)
      if wrap < 0 || back < 0 {
        return emitFail("emitProgram: .push but list type not collected")
      }
      const seq = liKinds.length
      const recvS = spreadGroupWrapSlot(kk, row, seq)
      const srcS = spreadGroupWrapSlot(kk, row, seq + 1)
      const backS = spreadDstBackSlot(kk, row, seq)
      const totL = widenTmpSlot(3000 + seq)
      // The receiver, evaluated ONCE — an argument that is itself a list op would otherwise
      // restage it, which is how a hoisted receiver gets clobbered.
      listCastForPush = true
      const recvRc = emitExpr(body, callee.memObj, fnIx, ec)
      listCastForPush = false
      if recvRc < 0 { return -1 }
      if nulRecvNeedsRecover(callee.memObj, fnIx) { fbRefAsNonNull() }
      fbLocalSet(recvS)
      const lst = spreadRunLit(c.callArgs, callIx, callee.memObj, c.pos)
      const runSaved = expCtxHere(ec)
      expCtxApply(pushRunBuildCtx(callee.memObj, fnIx, ec), ec)
      const lstRc = emitArrAt(
        body,
        lst,
        fnIx,
        pushRunListBuild(callee.memObj, fnIx, kk, row),
        ec,
      )
      expCtxApply(runSaved, ec)
      if lstRc < 0 { return -1 }
      fbLocalSet(srcS)
      // tot = recv.len + new.len
      fbLocalGet(recvS)
      fbStructGet(wrap, 1)
      fbLocalGet(srcS)
      fbStructGet(wrap, 1)
      fbI32Bin(106) // 0x6a i32.add
      fbLocalSet(totL)
      // if recv.cap < tot, grow the backing to EXACTLY tot — a bulk append knows the length
      // it needs, so the doubling a one-at-a-time push amortizes over has nothing to buy.
      fbLocalGet(recvS)
      fbStructGet(wrap, 2)
      fbLocalGet(totL)
      fbI32Bin(72) // 0x48 i32.lt_s
      fbIf(64)     // 0x04 if, 0x40 void blocktype
      fbLocalGet(totL)
      fbArrayNewDefault(back)
      fbLocalSet(backS)
      fbLocalGet(backS)
      fbI32Const(0)
      fbLocalGet(recvS)
      fbStructGet(wrap, 0)
      fbI32Const(0)
      fbLocalGet(recvS)
      fbStructGet(wrap, 1)
      fbArrayCopy(back, back)
      fbLocalGet(recvS)
      fbLocalGet(backS)
      fbRefAsNonNull()
      fbStructSet(wrap, 0)
      fbLocalGet(recvS)
      fbLocalGet(totL)
      fbStructSet(wrap, 2)
      fbEnd()      // 0x0b end (if)
      // recv.backing[recv.len ..] = new
      fbLocalGet(recvS)
      fbStructGet(wrap, 0)
      fbLocalGet(recvS)
      fbStructGet(wrap, 1)
      fbLocalGet(srcS)
      fbStructGet(wrap, 0)
      fbI32Const(0)
      fbLocalGet(srcS)
      fbStructGet(wrap, 1)
      fbArrayCopy(back, back)
      fbLocalGet(recvS)
      fbLocalGet(totL)
      fbStructSet(wrap, 1)
      // D1592 — the value a `.push` yields is the new length, read back from the field this
      // same sequence just wrote, so the two cannot disagree.
      if wantValue { fbLocalGet(totL) }
      return 0
    }
    return emitFail("emitProgram: .push receiver is not a member access")
  }
  emitFail("emitProgram: expected a push call")
}

// D1592 — `wantValue` is the value-position flag: the checker types `.push` `i32` (the new
// length), so a bound/returned/argument push owes that value while a bare statement owes
// an empty stack. One lowering serves both, reading the value back from the `len` field
// this same sequence writes, so the two cannot disagree.
function emitPush(
  body: u8[],
  callIx: i32,
  fnIx: i32,
  wantValue: boolean,
  ec: ExpCtx,
) {
  const c = nodeAt(callIx)
  if c is Call {
    // One plain argument is the element-wise lowering below; anything else — several
    // arguments, or a spread — appends in bulk.
    if c.callArgs.length != 1 || hasSpreadItem(c.callArgs) {
      return emitPushMany(body, callIx, fnIx, wantValue, ec)
    }
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      // the receiver must produce a list — a bare list local/param or a struct-field array
      // read. Both `exprArray`/`exprRefArray` classify a `Member` field read already, so a
      // field receiver only needs its wrapper ref materialized into `recvRef`.
      const isRef = exprRefArray(callee.memObj, fnIx)
      const isStr = exprStringArray(callee.memObj, fnIx)
      const isF64 = exprF64Array(callee.memObj, fnIx)
      const isI64 = exprI64Array(callee.memObj, fnIx)
      const isF32 = exprF32Array(callee.memObj, fnIx)
      const isU8 = exprU8Array(callee.memObj, fnIx)
      // a literal-union array push (`xs.push("a")` over `xs: K[]`) rides the i32-list
      // spine, but the pushed member literal must lower as its atom id — seeded through
      // the declaration fallback (`arrElemLitUnionTy`), since a monomorphized instance's
      // receiver ident is shared with the generic body and the direct probe answers false.
      const isLitArr = arrElemLitUnionTy(callee.memObj, fnIx) >= 0
      // a `(boolean | null)[]` push also rides the i32-list spine, but a `null` value must
      // lower as the sentinel 2 (`ec.nulBool`).
      const isNbArr = (arrElemIsNulBoolAt(callee.memObj, fnIx)
        || arrElemIsNullUnitAt(callee.memObj, fnIx))
      // a `(K | null)[]` push rides the same spine: a member literal lowers as its atom
      // id, a `null` as the `-1` sentinel — seed both for the value emit.
      const isNlluArr = nodeArrayElemIsNulLitUnion(callee.memObj)
      // a `(string | null)[]` push rides the string-list spine, but a `null` value must
      // lower as `ref.null $sTypeIdx` — seeded the same way `emitArr` seeds that list's
      // element literals; without it a bare `null` push hit the bare-null reject.
      const isNsArr = arrElemIsNulStrAt(callee.memObj, fnIx)
      if (
        !isRef
        && !isStr
        && !isF64
        && !isI64
        && !isF32
        && !isU8
        && !exprArray(callee.memObj, fnIx)
      ) {
        return emitFail("emitProgram: .push receiver is not a list")
      }
      const pv: PushValKinds = {
        isF64: isF64,
        isI64: isI64,
        isF32: isF32,
        pushUnionNm: "",
        pushUnionTy: -1,
        pushNestSlot: -1,
        isLitArr: isLitArr,
        isNbArr: isNbArr,
        isNlluArr: isNlluArr,
        isNsArr: isNsArr,
        isStr: isStr,
      }
      const ps = pushSlotOf(callee.memObj, fnIx, isRef, isU8, pv)
      if ps == null { return -1 }
      if c.callArgs.length != 1 {
        return emitFail(
          "emitProgram: internal: the one-argument .push reached with another count — `emitPush` routes every other count to `emitPushMany`",
        )
      }
      return emitPushOne(
        body,
        callIx,
        callee.memObj,
        c.callArgs[0],
        fnIx,
        ps,
        pv,
        wantValue,
        ec,
      )
    }
  }
  emitFail("emitProgram: expected a .push call")
}

// Where a one-argument `.push` appends: the list's wrapper and backing types, its push
// scratch base, the element-value seeds (declared struct, variant hint, narrowed-arm heap),
// the value slot's rep kind for the non-null recover, and the ref-list row or -1.
type PushSlot = {
  lTy: i32,
  aTy: i32,
  base: i32,
  armHeap: i32,
  destKind: VKind | null,
  rSlot: i32,
}

// The `PushSlot` of a push onto receiver `recvIx`, whose list family the flags and `pv` name;
// a ref list also writes its union-box name and nested-list slot into `pv`. Returns null after
// recording the refusal when the family has no collected types or its row does not resolve.
function pushSlotOf(
  recvIx: i32,
  fnIx: i32,
  isRef: boolean,
  isU8: boolean,
  pv: PushValKinds,
): PushSlot | null {
  // A string list runs the identical grow/append sequence over its own wrapper/backing +
  // string-push quad; `array.new_default` zero-inits spare slots to null.
  const ps: PushSlot = {
    lTy: lTypeIdx,
    aTy: aTypeIdx,
    base: pushScratchBase,
    armHeap: -1,
    destKind: null,
    rSlot: -1,
  }
  if isRef {
    if !rlUsed {
      emitFail("emitProgram: ref .push but ref list type not collected")
      return null
    }
    const rslot = refListSlotOfExpr(recvIx, fnIx)
    if rslot < 0 {
      refListRowRefused(recvIx)
      return null
    }
    ps.rSlot = rslot
    ps.lTy = rlWrapIdx[rslot]
    ps.aTy = rlBackIdx[rslot]
    ps.base = refPushScratchBaseFor(rslot)
    if rlElemKindTbl[rslot] == RLK_UNION {
      pv.pushUnionNm = rlElemName[rslot]
      pv.pushUnionTy = rlElemTyIxAt(rslot)
    }
    // The heap a narrowed arm pushed into a `Circle[]` lands in (D1031) — the slot's own
    // element heap, the same one `rlBackIdx` types the backing with.
    ps.armHeap = rlElemArmHeapOf(rslot)
    ps.destKind = pushDestVKind(rslot)
    if rlElemNullable[rslot] == 1 { pv.pushNestSlot = rslot }
  } else if pv.isStr {
    if !slUsed {
      emitFail("emitProgram: string .push but string list type not collected")
      return null
    }
    ps.lTy = mkListIdx
    ps.aTy = mkArrIdx
    ps.base = strPushScratchBase
    // A `(string | null)[]` keeps its nullable slot and stays `null` here.
    if !pv.isNsArr { ps.destKind = "str" }
  } else if pv.isF64 {
    // the three non-i32 scalar kinds run the identical grow/append sequence over
    // their own wrapper/backing, staged in their own typed push quad — only the
    // three type indices below differ.
    if !fa64Used {
      emitFail("emitProgram: f64 .push but f64 list type not collected")
      return null
    }
    ps.lTy = fl64TypeIdx
    ps.aTy = fa64TypeIdx
    ps.base = f64PushScratchBase
  } else if pv.isI64 {
    if !ia64Used {
      emitFail("emitProgram: i64 .push but i64 list type not collected")
      return null
    }
    ps.lTy = il64TypeIdx
    ps.aTy = ia64TypeIdx
    ps.base = i64PushScratchBase
  } else if pv.isF32 {
    if !fa32Used {
      emitFail("emitProgram: f32 .push but f32 list type not collected")
      return null
    }
    ps.lTy = fl32TypeIdx
    ps.aTy = fa32TypeIdx
    ps.base = f32PushScratchBase
  } else if isU8 {
    // the packed byte list runs the identical grow/append sequence over its own
    // wrapper/backing and push quad. The pushed value takes the plain i32 path, and
    // `array.set` on the i8-storage backing truncates it to the low 8 bits.
    if !ba8Used {
      emitFail("emitProgram: u8 .push but u8 list type not collected")
      return null
    }
    ps.lTy = bl8TypeIdx
    ps.aTy = ba8TypeIdx
    ps.base = u8PushScratchBase
  } else if !lUsed {
    emitFail("emitProgram: .push but list type not collected")
    return null
  }
  ps
}

// The one-argument `.push` of `argIx` (call `callIx`) onto receiver `recvIx`: stage the receiver, build
// the value at the element rep `pv` names into the slot `ps` names, and append it. Returns 0,
// or -1 when the receiver or the value fails.
function emitPushOne(
  body: u8[],
  callIx: i32,
  recvIx: i32,
  argIx: i32,
  fnIx: i32,
  ps: PushSlot,
  pv: PushValKinds,
  wantValue: boolean,
  ec: ExpCtx,
): i32 {
  const base = ps.base
  // the receiver is staged after the value when the value itself stages one (D1280):
  // `listOpRecvLocal` parks a non-local receiver in the frame's one `recvRef` slot, so
  // a nested list op inside the pushed value would overwrite it and the append would
  // land on the inner list. Emitting the value first keeps the slot free for this push's own receiver.
  const lateStage = (exprPopBits(argIx, fnIx) & 512) != 0
  let lIdx = -1
  if !lateStage {
    lIdx = pushRecvLocal(body, recvIx, fnIx, base, ec)
    if lIdx < 0 { return -1 }
  }
  const valIdx = base
  const pushArmOwed = narrowedArmNeedsUnbox(argIx, fnIx)
  // V = x  (an f64-list push coerces/encodes the value as f64)
  if emitPushValue(body, recvIx, argIx, fnIx, pv, ec) < 0 { return -1 }
  // the narrowed-arm unbox at the `.push` boundary (D1031) — `xs.push(s)` into a
  // `Circle[]` under `if s is Circle`. The element-literal twin is in `emitArr`; both
  // read the same slot heap, so the two spellings of one store cannot disagree.
  if pushArmOwed { emitNarrowedArmUnboxTo(ps.armHeap, argIx, fnIx) }
  // the read-only covariant copy at the `.push` boundary (D2163)
  if ps.rSlot >= 0 { emitNestedListWidenSite(body, argIx, fnIx, ps.rSlot) }
  // D1197 — the non-null recover `.push` OWED. Eight sibling deliveries of the same
  // narrowed value ask `nulNicheRecoverOwed`; this one asked nothing, so `out.push(e)`
  // under `if e != null` handed a `(ref null $H)` to the non-null value slot.
  if nulNicheRecoverOwed(ps.destKind, argIx, fnIx) { fbRefAsNonNull() }
  fbLocalSet(valIdx) // local.set
  if lateStage {
    lIdx = pushRecvLocal(body, recvIx, fnIx, base, ec)
    if lIdx < 0 { return -1 }
  }
  emitPushAppend(body, callIx, lIdx, ps.lTy, ps.aTy, base, wantValue)
  0
}

// Which element rep a one-argument `.push` builds its value at: the scalar widths, the
// union box and nested list a ref list's element names, and the atom and niche seeds.
type PushValKinds = {
  isF64: boolean,
  isI64: boolean,
  isF32: boolean,
  pushUnionNm: string,
  pushUnionTy: i32,
  pushNestSlot: i32,
  isLitArr: boolean,
  isNbArr: boolean,
  isNlluArr: boolean,
  isNsArr: boolean,
  isStr: boolean,
}

// The value `argIx` a `.push` onto receiver `recvIx` appends, built and coerced at the
// element rep `pv` names. Returns -1 on a failure, else 0.
function emitPushValue(
  body: u8[],
  recvIx: i32,
  argIx: i32,
  fnIx: i32,
  pv: PushValKinds,
  ec: ExpCtx,
) {
  const isF64 = pv.isF64
  const isI64 = pv.isI64
  const isF32 = pv.isF32
  const pushUnionNm = pv.pushUnionNm
  const pushNestSlot = pv.pushNestSlot
  const isLitArr = pv.isLitArr
  const isNbArr = pv.isNbArr
  const isNlluArr = pv.isNlluArr
  const isNsArr = pv.isNsArr
  const isStr = pv.isStr
  if isF64 {
    if emitExprAsF64(body, argIx, fnIx, ec) < 0 { return -1 }
  } else if isI64 {
    if emitExprAsI64(body, argIx, fnIx, ec) < 0 { return -1 }
  } else if isF32 {
    // an f32-list push coerces/encodes the value as f32 (a float literal re-encodes).
    if emitExprAsF32(body, argIx, fnIx, ec) < 0 { return -1 }
  } else if pushUnionNm != "" {
    if emitUnionBoxArg(body, pushUnionNm, pv.pushUnionTy, argIx, fnIx, ec) < 0 {
      return -1
    }
  } else if pushNestSlot >= 0 {
    // A nested-list element push: the value builds as the INNER list (an inert
    // context for a non-literal value — an ident/call emits unchanged).
    const pnCtx = expCtxHere(ec)
    if emitExprExpect(body, argIx, fnIx, pnCtx) < 0 { return -1 }
  } else if isLitArr {
    if litPushNeedsDestNarrow(argIx, fnIx) {
      const dTy = arrElemLitUnionTy(recvIx, fnIx)
      if emitDestStrToAtom(body, argIx, fnIx, dTy, ec) < 0 { return -1 }
    } else {
      const pluCtx = expCtxHere(ec)
      pluCtx.litUnion = 1
      if emitExprExpect(body, argIx, fnIx, pluCtx) < 0 { return -1 }
    }
  } else if isNbArr {
    const pnbCtx = expCtxHere(ec)
    pnbCtx.nulBool = true
    if emitExprExpect(body, argIx, fnIx, pnbCtx) < 0 { return -1 }
  } else if isNlluArr {
    const pnluCtx = expCtxHere(ec)
    pnluCtx.litUnion = 1
    pnluCtx.nulLitUnion = true
    if emitExprExpect(body, argIx, fnIx, pnluCtx) < 0 { return -1 }
  } else if isNsArr && exprIsLitAtom(argIx, fnIx) {
    // A literal-union ATOM pushed into a `(string | null)[]`. The niche's backing IS a
    // plain string list, so the atom widens exactly as it does for a `string[]` — and a
    // widened member string is non-null, so it needs no null seed. A `null` value is not
    // a lit atom and still takes the `nulString` arm below.
    if emitStrValue(body, argIx, fnIx, ec) < 0 { return -1 }
  } else if isNsArr {
    const pnsCtx = expCtxHere(ec)
    pnsCtx.nulString = true
    if emitExprExpect(body, argIx, fnIx, pnsCtx) < 0 { return -1 }
  } else if isStr && exprIsLitAtom(argIx, fnIx) {
    // a literal-union atom pushed into a `string[]` widens to its member string: the
    // backing slot is `(ref null $aTypeIdx)` and the atom's rep is an i32 id — the
    // same boundary a `string` field store applies (`scode == 3` + `exprIsLitAtom`).
    if emitStrValue(body, argIx, fnIx, ec) < 0 { return -1 }
  } else {
    if emitExpr(body, argIx, fnIx, ec) < 0 { return -1 }
  }
  0
}

// Appends the value staged in local `base` to the list in local `lIdx` (wrapper `lTy`,
// backing `aTy`), growing the backing when full; a counted push of an open build region
// appends through its locals. With `wantValue`, leaves the new length.
function emitPushAppend(
  body: u8[],
  callIx: i32,
  lIdx: i32,
  lTy: i32,
  aTy: i32,
  base: i32,
  wantValue: boolean,
) {
  const valIdx = base
  const capIdx = base + 1
  const backIdx = base + 2
  // A counted push of an open build region appends through its locals while under the
  // reserve, and otherwise syncs `len` and takes the growing append below (D3623).
  const reg = listBuildRegionOf(callIx)
  let fast = false
  if reg >= 0 {
    fast = !wantValue
      && lbList[reg] == lIdx
      && lbWrap[reg] == lTy
      && lbBackTy[reg] == aTy
    if fast {
      fbLocalGet(lbCnt[reg])
      fbI32Const(lbCap[reg])
      fbI32Bin(73) // 0x49 i32.lt_u
      fbIf(64)
      fbLocalGet(lbBack[reg])
      fbLocalGet(lbCnt[reg])
      fbLocalGet(valIdx)
      fbArraySet(aTy)
      fbElse()
    }
    fbLocalGet(lbList[reg])
    fbLocalGet(lbCnt[reg])
    fbStructSet(lbWrap[reg], 1) // len
  }
  // if len(L) == cap(L)
  pushListLen(body, lIdx, lTy)
  pushListCap(body, lIdx, lTy)
  fbI32Bin(70) // 0x46 i32.eq
  fbIf(64)     // 0x04 if, 0x40 void blocktype
  // NC = (cap(L) == 0) ? 4 : cap(L) * 2   — via if/else yielding i32
  pushListCap(body, lIdx, lTy)
  fbI32Eqz()         // 0x45 i32.eqz  (cap == 0)
  fbIf(127)          // 0x04 if, 0x7f i32 blocktype (yields an i32)
  fbI32Const(4)      // i32.const 4
  fbElse()           // 0x05 else
  pushListCap(body, lIdx, lTy)
  fbI32Const(2)      // i32.const 2
  fbI32Bin(108)      // 0x6c i32.mul
  fbEnd()            // 0x0b end (if/else)
  fbLocalSet(capIdx) // local.set NC
  // NB = array.new_default $aTy NC
  fbLocalGet(capIdx)     // local.get NC
  fbArrayNewDefault(aTy) // 0xfb 0x07 <aTy>
  fbLocalSet(backIdx)    // local.set NB
  // array.copy NB 0 backing(L) 0 len(L)
  fbLocalGet(backIdx)              // local.get NB (dest)
  fbI32Const(0)                    // i32.const 0 (dest offset)
  pushListBacking(body, lIdx, lTy) // src
  fbI32Const(0)                    // i32.const 0 (src offset)
  pushListLen(body, lIdx, lTy)     // count
  fbArrayCopy(aTy, aTy)            // 0xfb 0x11 <dest type> <src type>
  // L.backing = NB
  fbLocalGet(lIdx)    // local.get L
  fbLocalGet(backIdx) // local.get NB
  fbStructSet(lTy, 0) // 0xfb 0x05 <lTy> field 0: backing
  // L.cap = NC
  fbLocalGet(lIdx)    // local.get L
  fbLocalGet(capIdx)  // local.get NC
  fbStructSet(lTy, 2) // 0xfb 0x05 <lTy> field 2: cap
  fbEnd()             // 0x0b end (if)
  // backing(L)[len(L)] = V
  pushListBacking(body, lIdx, lTy)
  pushListLen(body, lIdx, lTy)
  fbLocalGet(valIdx) // local.get V
  fbArraySet(aTy)    // 0xfb 0x0e <aTy>
  // L.len = len(L) + 1
  fbLocalGet(lIdx)    // local.get L
  pushListLen(body, lIdx, lTy)
  fbI32Const(1)       // i32.const 1
  fbI32Bin(106)       // 0x6a i32.add
  fbStructSet(lTy, 1) // 0xfb 0x05 <lTy> field 1: len
  if reg >= 0 {
    if fast { fbEnd() }
    fbLocalGet(lbCnt[reg])
    fbI32Const(1)
    fbI32Bin(106) // 0x6a i32.add
    fbLocalSet(lbCnt[reg])
  }
  // D1592 — the new length, read back from the field the line above wrote. Emitted
  // only in value position; a bare `.push` statement leaves the stack empty, and
  // `memberCallYieldsValue` is the one predicate both sides consult.
  if wantValue { pushListLen(body, lIdx, lTy) }
}

// `.pop()` decrements `len` first, so the new `len` is the popped index, before reading
// `backing[len]` — the receiver must be a bare local, no scratch needed.
// D977 — the push scratch base and the used-flag for a scalar list of element kind `k`.
function scalarPushScratchBaseOf(k: VKind): i32 {
  match k {
    "f64" => {
      return f64PushScratchBase
    }
    "i64" => {
      return i64PushScratchBase
    }
    "f32" => {
      return f32PushScratchBase
    }
    "u8list" => {
      return u8PushScratchBase
    }
    // Every other kind pushes through the i32 list's scratch.
    "i32" | "struct" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "f64list" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "v128" => {}
  }
  pushScratchBase
}

function scalarListUsedOf(k: VKind): boolean {
  match k {
    "f64" => {
      return fa64Used
    }
    "i64" => {
      return ia64Used
    }
    "f32" => {
      return fa32Used
    }
    "u8list" => {
      return ba8Used
    }
    // Every other kind is answered by the i32 list's flag.
    "i32" | "struct" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "f64list" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "v128" => {}
  }
  lUsed
}

// the `.pop()` receiver test, lifted out of `emitPop` so the two dispatch sites can ask
// it before routing (D1087): the member dispatch read `callee.memProp == "pop"` with no
// receiver guard, unlike its `map`/`filter`/`keys`/`values`/`get` neighbours. The four
// families are `emitPop`'s own; asking them from one function keeps routing and the floor in step.
function popRecvIsList(recvIx: i32, fnIx: i32) {
  if exprRefArray(recvIx, fnIx) { return true }
  if exprStringArray(recvIx, fnIx) { return true }
  const pk = scalarListElemKind(recvIx, fnIx)
  if pk != null {
    if pk != "i32" { return true }
  }
  exprArray(recvIx, fnIx)
}

// A checked list read (`xs.pop()`/`xs.get(i)`) at a numeric-scalar element rep, delivered
// as the `T | null` the checker gives it: the `{tag, anyref}` value-union box, absent →
// the null tag. `vk` is the non-null member's kind. Mirrors the boolean arm one rep out —
// i32/i64/f64/f32 have no spare bit pattern for absence, so both branches build the box (D1174).
function emitPopNulBox(
  body: u8[],
  lIdx: i32,
  lTy: i32,
  aTy: i32,
  vk: i32,
  idxIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const vb = vbHeapIdxOfKind(vk)
  if vb < 0 {
    return emitFail(
      "emitProgram: this list read yields a nullable scalar but its value box was not collected",
    )
  }
  if pushTakeCond(body, lIdx, lTy, idxIx, fnIx, ec) < 0 { return -1 }
  fbOpenIf()                            // 0x04 if
  fbValtype("union", -1)                // result blocktype: the union box `(ref $uBox)`
  fbI32Rel(RS_TAG, scalarTagOfKind(vk)) // the present arm's atom tag
  if pushTakeElem(body, lIdx, lTy, aTy, idxIx, fnIx, ec) < 0 { return -1 }
  fbStructNew(vb)                       // the per-rep value box
  fbStructNew(uBoxIdx)                  // { tag, value }
  fbElse()                              // 0x05 else — absent → the null-tagged box
  fbI32Rel(RS_TAG, nullBoxTag())
  fbRefNullNone()                       // the payload slot is unread under the null tag
  fbStructNew(uBoxIdx)
  fbEnd()                               // 0x0b end
  0
}

// the checked-read condition, one home for `.pop()` and `.get(i)`: `idxIx < 0` is `.pop`
// and asks `len != 0`; `idxIx >= 0` is `.get` and asks `i u< len`, covering the negative
// and past-len cases together. Both faces deliver the same `T | null` at the same four reps (D1281).
function pushTakeCond(
  body: u8[],
  lIdx: i32,
  lTy: i32,
  idxIx: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if idxIx < 0 { return pushListLen(body, lIdx, lTy) }
  if emitListGetIdx(body, idxIx, fnIx, ec) < 0 { return -1 }
  pushListLen(body, lIdx, lTy)
  fbI32Bin(73) // 0x49 i32.lt_u
  0
}

// the element read under that condition. `.pop` DECREMENTS the length first, so the new
// `len` IS the removed element's index; `.get` reads at `idxIx` and never mutates. The
// index expression is emitted a SECOND time here (the condition emitted it once), which
// is what makes the caller's literal-or-name purity gate load-bearing.
function pushTakeElem(
  body: u8[],
  lIdx: i32,
  lTy: i32,
  aTy: i32,
  idxIx: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if idxIx < 0 {
    fbLocalGet(lIdx)    // L.len = len - 1
    pushListLen(body, lIdx, lTy)
    fbI32Const(1)
    fbI32Bin(107)       // 0x6b i32.sub
    fbStructSet(lTy, 1) // field 1: len
    pushListBacking(body, lIdx, lTy)
    pushListLen(body, lIdx, lTy)
    fbArrayGet(aTy)     // backing[len] — the popped element
    return 0
  }
  pushListBacking(body, lIdx, lTy)
  if emitListGetIdx(body, idxIx, fnIx, ec) < 0 { return -1 }
  fbArrayGet(aTy) // backing[i] — the read element
  0
}

// Refuse a ref-list read, write or walk whose element row does not resolve. Every table the
// slot indexes needs a real row, and slot 0 is one, so there is no row to borrow. Returns -1.
function refListRowRefused(exprIx: i32): i32 {
  emitFailAt("emitProgram: a ref list's element row does not resolve", exprIx)
}

// `xs.pop()` and `xs.get(i)` — the two checked list reads, typed identically (`T | null`),
// differing only in the condition, index and length decrement (`pushTakeCond`/`pushTakeElem`);
// one body keeps `.get` at every rep `.pop` reaches (D1281). `getIdx` is the `.get` index or
// -1. Returns 0 with the value on the stack, 1 when a statement pop left none, or -1.
function emitPop(
  body: u8[],
  callIx: i32,
  fnIx: i32,
  nulBox: boolean,
  getIdx: i32,
  ec: ExpCtx,
) {
  const pgSv = listGetStageSave()
  const pgR = emitPopGo(body, callIx, fnIx, nulBox, getIdx, ec)
  listGetStageRestore(pgSv)
  pgR
}

// The `.pop` / `.get` arms themselves, with the call's operands already marked for staging.
function emitPopGo(
  body: u8[],
  callIx: i32,
  fnIx: i32,
  nulBox: boolean,
  getIdx: i32,
  ec: ExpCtx,
) {
  const opNm = if getIdx < 0 { ".pop" } else { ".get" }
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      if getIdx < 0 {
        if c.callArgs.length != 0 {
          return emitFail(
            "emitProgram: internal: .pop reached with the wrong argument count — the checker's arity rule refuses it",
          )
        }
      } else {
        listGetStageMark(callIx)
      }
      const isRef = exprRefArray(callee.memObj, fnIx)
      const isStr = exprStringArray(callee.memObj, fnIx)
      // D977 — the scalar-list family had no arm here: `exprArray` claims only an
      // i32-element list, so `i64[]`/`f64[]`/`f32[]`/`u8[]` fell to a refusal that
      // `emitFail`'s non-halting let reach check-clean invalid wasm instead. The wrapper
      // and backing come from `scalarListWrap`/`scalarListBack`, each kind with its own push scratch base.
      let popEk = scalarListElemKind(callee.memObj, fnIx)
      if popEk == "i32" { popEk = null }
      if !popRecvIsList(callee.memObj, fnIx) {
        return emitFail("emitProgram: " + opNm + " receiver is not a list")
      }
      // The popped element is a REF (struct / union box / map struct / string) for a
      // ref or string list — surface it non-null; an i32 list yields a raw i32. `base` is
      // the scratch frame whose `+3` `recvRef` slot holds a struct-FIELD receiver's wrapper
      // ref (same frame `.push` uses) — used only for a Member receiver.
      let lTy = lTypeIdx
      let aTy = aTypeIdx
      let base = pushScratchBase
      // The ref-list table slot whose scratch frame a STAGING receiver would use, or -1
      // for every other family. Handed to `listOpRecvLocal` so the frame is resolved only
      // where staging happens — see `listOpStageBase`.
      let popRefSlot = -1
      let elemIsRef = false
      if isRef {
        if !rlUsed {
          return emitFail(
            "emitProgram: ref " + opNm + " but ref list type not collected",
          )
        }
        const rslot = refListSlotOfExpr(callee.memObj, fnIx)
        if rslot < 0 { return refListRowRefused(callee.memObj) }
        lTy = rlWrapIdx[rslot]
        aTy = rlBackIdx[rslot]
        popRefSlot = rslot
        elemIsRef = true
      } else if popEk != null {
        // The scalar sibling of the i32 default below: same shape, a per-kind wrapper,
        // backing and scratch base.
        if !scalarListUsedOf(popEk) {
          return emitFail(
            "emitProgram: " + opNm + " but list type not collected",
          )
        }
        lTy = scalarListWrap(popEk)
        aTy = scalarListBack(popEk)
        base = scalarPushScratchBaseOf(popEk)
      } else if isStr {
        if !slUsed {
          return emitFail(
            "emitProgram: string "
              + opNm
              + " but string list type not collected",
          )
        }
        lTy = mkListIdx
        aTy = mkArrIdx
        base = strPushScratchBase
        elemIsRef = true
      } else if !lUsed {
        return emitFail("emitProgram: " + opNm + " but list type not collected")
      }
      // Receiver resolution — `listOpRecvLocal`, shared with `.push`/`.clear`/`.pop() ?? d`.
      const lIdx = listOpRecvLocal(
        body,
        callee.memObj,
        fnIx,
        base,
        popRefSlot,
        opNm,
        ec,
      )
      if lIdx < 0 { return -1 }
      if getIdx >= 0 { emitListGetViewSync(lIdx, popEk, callee.memObj, fnIx) }
      // A pop the checker typed as the element itself, under a `.length` test of its receiver
      // (D3558): the list is non-empty, so the element is read unchecked in its own rep.
      if getIdx < 0 && nodeTyExcludesNull(callIx) {
        if pushTakeElem(body, lIdx, lTy, aTy, getIdx, fnIx, ec) < 0 {
          return -1
        }
        if elemIsRef {
          fbRefAsNonNull()
          if popUnionBoxElem(popRefSlot) {
            if emitStaleBoxRetag(popRefSlot, callIx) < 0 { return -1 }
          }
        }
        return 0
      }
      if !elemIsRef {
        // A BOOLEAN-element list pops CHECKED: `boolean | null` rides the i32
        // niche (true=1 / false=0 / null=2), so an empty pop yields the sentinel
        // 2 instead of trapping — mirroring the host's nullable `.pop()` (B6).
        if listElemIsBool(callee.memObj, fnIx) {
          return emitPopNicheChecked(body, lIdx, lTy, aTy, getIdx, fnIx, 2, ec)
        }
        // the reps with no niche of their own, at a value position (`nulBox`): i32/i64/
        // f64/f32 have no spare bit pattern for absence, so their `T | null` is the
        // shared value box, built here. The statement caller passes `false` and keeps
        // the raw form, since boxing there would allocate for a value no one reads.
        if nulBox {
          const pnk = tyNulNumScalarValKind(nodeTyIxOf(callIx))
          if pnk >= 0 {
            return emitPopNulBox(body, lIdx, lTy, aTy, pnk, getIdx, fnIx, ec)
          }
        }
        // a `K[]` atom list reads checked too, on the `-1` sentinel below every interned
        // atom id — the boolean arm's shape at the one other niche rep, applying at a
        // statement `.pop()` too since the read itself traps, not the boxing (D1281).
        if tyNulLitUnionInner(nodeTyIxOf(callIx)) {
          return emitPopNicheChecked(
            body,
            lIdx,
            lTy,
            aTy,
            getIdx,
            fnIx,
            0 - 1,
            ec,
          )
        }
      }
      if elemIsRef {
        return emitPopRefChecked(
          body,
          callIx,
          lIdx,
          lTy,
          aTy,
          getIdx,
          fnIx,
          popRefSlot,
          opNm,
          ec,
        )
      }
      // A numeric `.pop` statement has no null cell to answer with, so it pops under the
      // length test and drops the element itself: an empty list is left as it is (D8360).
      if !nulBox && getIdx < 0 {
        if pushTakeCond(body, lIdx, lTy, getIdx, fnIx, ec) < 0 { return -1 }
        fbIf(64) // 0x40 void
        if pushTakeElem(body, lIdx, lTy, aTy, getIdx, fnIx, ec) < 0 {
          return -1
        }
        fbDrop() // 0x1a drop
        fbEnd()  // 0x0b end
        return 1
      }
      // the unchecked tail: the reps with no `T | null` cell of their own.
      if pushTakeElem(body, lIdx, lTy, aTy, getIdx, fnIx, ec) < 0 { return -1 }
      return 0
    }
  }
  emitFail("emitProgram: expected a .pop or .get call")
}

// A `.get` of a view reads its refreshed snapshot (D3028, D3041): sync the scalar view of
// kind `popEk` or the ref view behind receiver `recvIx` whose wrapper is in local `lIdx`.
function emitListGetViewSync(
  lIdx: i32,
  popEk: VKind | null,
  recvIx: i32,
  fnIx: i32,
) {
  if popEk != null {
    const gsv = svDstOfKind(popEk)
    if gsv >= 0 {
      fbLocalGet(lIdx)
      fbCall(gHelpSvSync[gsv])
      fbDrop()
    }
  }
  if rvRecvMayView(recvIx, fnIx) {
    fbLocalGet(lIdx)
    fbCall(gHelpRvSync)
    fbDrop()
  }
}

// A checked `.pop`/`.get` over an i32-niche list: the element when the list has one, else the
// niche's `absent` sentinel (2 for `boolean | null`, -1 for a `K[]` atom list). Returns 0, or
// -1 when the condition or the read fails.
function emitPopNicheChecked(
  body: u8[],
  lIdx: i32,
  lTy: i32,
  aTy: i32,
  getIdx: i32,
  fnIx: i32,
  absent: i32,
  ec: ExpCtx,
): i32 {
  if pushTakeCond(body, lIdx, lTy, getIdx, fnIx, ec) < 0 { return -1 }
  fbIf(127) // 0x04 if, 0x7f i32 result blocktype
  if pushTakeElem(body, lIdx, lTy, aTy, getIdx, fnIx, ec) < 0 { return -1 }
  fbElse()  // 0x05 else — absent → the niche's null sentinel
  fbI32Const(absent)
  fbEnd()   // 0x0b end
  0
}

// A checked `.pop`/`.get` over a ref or string list (`popRefSlot` -1 for a string list): an
// empty list answers `null`, it does not trap (D1212), and the result is the backing's own
// `(ref null $elem)`, or the null-tagged box for a value-union element. Returns 0, or -1.
function emitPopRefChecked(
  body: u8[],
  callIx: i32,
  lIdx: i32,
  lTy: i32,
  aTy: i32,
  getIdx: i32,
  fnIx: i32,
  popRefSlot: i32,
  opNm: string,
  ec: ExpCtx,
): i32 {
  let popElemHeap = sTypeIdx
  if popRefSlot >= 0 {
    if popRefSlot >= rlElemHeap.length {
      return emitFail("emitProgram: ref " + opNm + " element heap not interned")
    }
    popElemHeap = rlElemHeap[popRefSlot]
  }
  // A value-union element has no nullable niche: its `T | null` is the box itself
  // with `null` riding as the null TAG, which is the rep every consumer of a
  // union cell already reads. `emitMapGetUnionBox` answers the same question the
  // same way for a union-valued map read (D1825).
  if popUnionBoxElem(popRefSlot) {
    if pushTakeCond(body, lIdx, lTy, getIdx, fnIx, ec) < 0 { return -1 }
    fbIfRef(uBoxIdx)
    if pushTakeElem(body, lIdx, lTy, aTy, getIdx, fnIx, ec) < 0 { return -1 }
    fbRefAsNonNull()
    if emitStaleBoxRetag(popRefSlot, callIx) < 0 { return -1 }
    fbElse() // 0x05 else — absent → the null-tagged box
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone()
    fbStructNew(uBoxIdx)
    fbEnd() // 0x0b end
    return 0
  }
  if pushTakeCond(body, lIdx, lTy, getIdx, fnIx, ec) < 0 { return -1 }
  fbIfRefNul(popElemHeap, true)
  if pushTakeElem(body, lIdx, lTy, aTy, getIdx, fnIx, ec) < 0 { return -1 }
  fbElse() // 0x05 else — absent → the typed null
  fbRefNull(popElemHeap)
  fbEnd()  // 0x0b end
  0
}

// Lower a `.clear()` statement onto `body`: reset the list's logical length to 0,
// retaining the backing. Generic over the list kind, with `emitPop`'s receiver
// resolution (bare local, module global, or struct field via the `recvRef` scratch).
function emitClear(body: u8[], callIx: i32, fnIx: i32, ec: ExpCtx) {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      if c.callArgs.length != 0 {
        return emitFail(
          "emitProgram: internal: .clear reached with the wrong argument count — the checker's arity rule refuses it",
        )
      }
      const isRef = exprRefArray(callee.memObj, fnIx)
      const isStr = exprStringArray(callee.memObj, fnIx)
      // the scalar-list family, the arm `emitPop` grew at D977 and this one did not:
      // `exprArray` claims only an i32-element list, so `i64[]`/`f64[]`/`f32[]`/`u8[]`
      // either failed the receiver test or reset the length through the wrong wrapper
      // type wherever an i32 list happened to be collected too — invalid wasm.
      let clearEk = scalarListElemKind(callee.memObj, fnIx)
      if clearEk == "i32" { clearEk = null }
      if (
        !isRef
        && !isStr
        && clearEk == null
        && !exprArray(callee.memObj, fnIx)
      ) {
        return emitFail("emitProgram: .clear receiver is not a list")
      }
      let lTy = lTypeIdx
      let base = pushScratchBase
      // See `emitPop`'s `popRefSlot`.
      let clearRefSlot = -1
      if isRef {
        if !rlUsed {
          return emitFail(
            "emitProgram: ref .clear but ref list type not collected",
          )
        }
        const rslot = refListSlotOfExpr(callee.memObj, fnIx)
        if rslot < 0 { return refListRowRefused(callee.memObj) }
        lTy = rlWrapIdx[rslot]
        clearRefSlot = rslot
      } else if clearEk != null {
        // The scalar sibling of the i32 default below, and `emitPop`'s arm minus the
        // backing (a `.clear` writes only the length field, so no `aTy`).
        if !scalarListUsedOf(clearEk) {
          return emitFail("emitProgram: .clear but list type not collected")
        }
        lTy = scalarListWrap(clearEk)
        base = scalarPushScratchBaseOf(clearEk)
      } else if isStr {
        if !slUsed {
          return emitFail(
            "emitProgram: string .clear but string list type not collected",
          )
        }
        lTy = mkListIdx
        base = strPushScratchBase
      } else if !lUsed {
        return emitFail("emitProgram: .clear but list type not collected")
      }
      const lIdx = listOpRecvLocal(
        body,
        callee.memObj,
        fnIx,
        base,
        clearRefSlot,
        ".clear",
        ec,
      )
      if lIdx < 0 { return -1 }
      // L.len = 0
      fbLocalGet(lIdx)
      fbI32Const(0)
      fbStructSet(lTy, 1) // 0xfb 0x05 <lTy> field 1: len
      return 0
    }
  }
  emitFail("emitProgram: expected a .clear call")
}

// Lower a fused `xs.get(i) ?? d` over a scalar-element list (i32/boolean/f64) onto
// `body`: one unsigned bounds compare selects the element read or the default, so the
// `T | null` intermediate never materializes. Receiver a bare name, index a literal/name.
function emitListGetOr(
  body: u8[],
  getIx: i32,
  defIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const lgSv = listGetStageSave()
  const lgR = emitListGetOrGo(body, getIx, defIx, fnIx, ec)
  listGetStageRestore(lgSv)
  lgR
}

// The fused `xs.get(i) ?? d` arm itself, with the call's operands already marked.
function emitListGetOrGo(
  body: u8[],
  getIx: i32,
  defIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const c = nodeAt(getIx)
  if c is Call {
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      if c.callArgs.length != 1 {
        return emitFail(
          "emitProgram: internal: .get reached with the wrong argument count — the checker's arity rule refuses it",
        )
      }
      // The scalar element kind (i32 / f64) selects the list types + read rep. The caller
      // gates on `exprF64Array || exprArray`, so a string list, whose element may be null,
      // takes the generic nullable read instead (D2276).
      const ek = scalarListElemKind(callee.memObj, fnIx)
      if ek == null {
        return emitFail("emitProgram: .get receiver is not a scalar list")
      }
      if !scalarListUsed(ek) {
        return emitFail("emitProgram: .get but list type not collected")
      }
      const lTy = scalarListWrap(ek)
      const aTy = scalarListBack(ek)
      // The index and the receiver are each emitted twice below, so a non-place operand is
      // staged once in the `.get` stash rather than refused (D1677).
      listGetStageMark(getIx)
      // cond: len u> idx  (one unsigned compare covers negative + past-len). The receiver
      // is evaluated before the index, as every other `.get` spelling does (D3756).
      if emitListGetRecv(body, callee.memObj, fnIx, lTy, ec) < 0 { return -1 }
      fbStructGet(lTy, 1)       // field 1: len
      if emitListGetIdx(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
      fbI32Bin(75)              // 0x4b i32.gt_u
      fbIfForScalarListElem(ek) // 0x04 if, the element's own result rep
      if emitListGetRecv(body, callee.memObj, fnIx, lTy, ec) < 0 { return -1 }
      fbStructGet(lTy, 0)       // field 0: backing
      if emitListGetIdx(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
      fbArrayGet(aTy)           // 0xfb 0x0b array.get — the element
      fbElse()                  // 0x05 else
      if emitScalarValue(body, defIx, fnIx, ek, ec) < 0 { return -1 }
      fbEnd()                   // 0x0b end
      return 0
    }
  }
  emitFail("emitProgram: expected a list .get call")
}

// Lower a FUSED `xs.pop() ?? d` over a SCALAR-element list (i32 / boolean, and f64 / i64 / f32)
// onto `body`: `len != 0` selects the decrement-and-read (the popped element) or the
// default. The receiver resolves like `emitPop` (bare local, module global, or
// struct field — the latter two staged into the push frame's `recvRef` scratch).
function emitPopOr(body: u8[], popIx: i32, defIx: i32, fnIx: i32, ec: ExpCtx) {
  const c = nodeAt(popIx)
  if c is Call {
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      if c.callArgs.length != 0 {
        return emitFail(
          "emitProgram: internal: .pop reached with the wrong argument count — the checker's arity rule refuses it",
        )
      }
      const ek0 = scalarListElemKind(callee.memObj, fnIx)
      if ek0 == null || ek0 == "u8list" {
        return emitFail(
          "emitProgram: fused .pop ?? d receiver is not an i32/f64/i64/f32 list",
        )
      }
      const ek: VKind = ek0
      if !scalarListUsed(ek) {
        return emitFail("emitProgram: .pop but list type not collected")
      }
      const lTy = scalarListWrap(ek)
      const aTy = scalarListBack(ek)
      const base = scalarPushScratchBaseOf(ek)
      // the fused `pop ?? d` is scalar-only; no ref frame to defer
      const lIdx = listOpRecvLocal(
        body,
        callee.memObj,
        fnIx,
        base,
        -1,
        ".pop",
        ec,
      )
      if lIdx < 0 { return -1 }
      // cond: len != 0 (len is never negative)
      pushListLen(body, lIdx, lTy)
      fbIfForScalarListElem(ek) // 0x04 if, the element's own result rep
      // L.len = len - 1; backing[L.len]
      fbLocalGet(lIdx)
      pushListLen(body, lIdx, lTy)
      fbI32Const(1)
      fbI32Bin(107)       // 0x6b i32.sub
      fbStructSet(lTy, 1) // field 1: len
      pushListBacking(body, lIdx, lTy)
      pushListLen(body, lIdx, lTy)
      fbArrayGet(aTy)     // the popped element
      fbElse()            // 0x05 else — empty list → the default
      if emitScalarValue(body, defIx, fnIx, ek, ec) < 0 { return -1 }
      fbEnd()             // 0x0b end
      return 0
    }
  }
  emitFail("emitProgram: expected a list .pop call")
}

// Writes into `src` the source list types for receiver kind `recvK` at `recvIx`; `src` arrives
// holding the i32 list's. `srcElemRef` is whether an element needs `ref.as_non_null` after
// `array.get`, which a nullable-niche element does not. Returns -1 on a failure, else 0.
function mfSrcTysOf(recvK: MfKind, recvIx: i32, fnIx: i32, src: MfSrcTys) {
  const srcElemNul = listElemStaysNullable(recvIx, fnIx)
  if recvK == "f64" {
    if !fa64Used {
      return emitFail(
        "emitProgram: .map/.filter over f64[] but f64 list type not collected",
      )
    }
    src.srcWrap = fl64TypeIdx
    src.srcBack = fa64TypeIdx
  } else if recvK == "i64" {
    if !ia64Used {
      return emitFail(
        "emitProgram: .map/.filter over i64[] but i64 list type not collected",
      )
    }
    src.srcWrap = il64TypeIdx
    src.srcBack = ia64TypeIdx
  } else if recvK == "f32" {
    if !fa32Used {
      return emitFail(
        "emitProgram: .map/.filter over f32[] but f32 list type not collected",
      )
    }
    src.srcWrap = fl32TypeIdx
    src.srcBack = fa32TypeIdx
  } else if recvK == "ref" {
    if !rlUsed {
      return emitFail(
        "emitProgram: .map/.filter over a ref list but ref list type not collected",
      )
    }
    const srcSlot = refListSlotOfExpr(recvIx, fnIx)
    if srcSlot < 0 { return refListRowRefused(recvIx) }
    src.srcSlot = srcSlot
    src.srcWrap = rlWrapIdx[srcSlot]
    src.srcBack = rlBackIdx[srcSlot]
    src.srcElemRef = !srcElemNul
  } else if recvK == "str" {
    // A STRING list: wrapper `$mkListIdx`, backing `$mkArrIdx` (the array of string
    // refs). The element is itself a ref (an `array i32` of code points), so it needs
    // `ref.as_non_null` after `array.get`, exactly like a ref-list element — unless the
    // element is the `(string | null)[]` niche, which keeps the nullable read.
    if !slUsed {
      return emitFail(
        "emitProgram: .map/.filter over string[] but string list type not collected",
      )
    }
    src.srcWrap = mkListIdx
    src.srcBack = mkArrIdx
    src.srcElemRef = !srcElemNul
  } else if recvK == "u8" {
    // the packed byte source, from `mfRecvKindOf`'s `"u8"` rung (D1141). No
    // `u8[].map`/`.filter` reaches here yet — a `u8` callback parameter is refused one
    // stage earlier — so this arm buys no cell today, but avoids silently minting the
    // 4-byte backing the moment the parameter gap closes.
    if !ba8Used {
      return emitFail(
        "emitProgram: .map/.filter over u8[] but the packed byte list type not collected",
      )
    }
    src.srcWrap = bl8TypeIdx
    src.srcBack = ba8TypeIdx
  } else if !lUsed || !aUsed {
    return emitFail("emitProgram: .map/.filter but list type not collected")
  }
  0
}

// The wrapper and backing heap types of a `.map`/`.filter` source list, its ref-list row
// (-1 for a non-ref list), and whether its element is read as a non-null ref.
type MfSrcTys = {
  srcWrap: i32,
  srcBack: i32,
  srcElemRef: boolean,
  srcSlot: i32,
}

// The interned signature of `.map`/`.filter` callback `argIx`: the lifted function `cbFe`'s, or
// for a closure value (a function-typed parameter or binding) its own `$fnsig` key's. -1 when
// none is interned.
function mfCallbackSigOf(argIx: i32, cbFe: i32, fnIx: i32): i32 {
  let sig = -1
  if cbFe >= 0 {
    sig = fnSigIdxOfFn(cbFe)
  } else {
    // A closure-value callback (`xs.map(f)` where `f: (i32) => i32`) has no lifted fe to
    // inline; the loop `call_ref`s the closure value exactly as for a named-function callback.
    const ck = mfCallbackCloKey(argIx, fnIx)
    if ck != "" { sig = cloSigTypeIdxAt(cloSigPosOfKey(ck)) }
  }
  sig
}

// The closure value of `.map`/`.filter` callback `argIx`: an inline literal or named function
// builds it from `cbFe`, a let-bound value reads its binding. Returns 0, or -1 once failed.
function emitMfCallbackValue(
  body: u8[],
  argIx: i32,
  cbFe: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const cbNode = nodeAt(unwrapParen(argIx))
  if cbNode is FuncDecl {
    if emitClosureValue(body, cbFe, fnIx, ec) < 0 { return -1 }
  } else if cbNode is Ident {
    if cbIdentNamesFn(argIx, fnIx) {
      if emitClosureValue(body, cbFe, fnIx, ec) < 0 { return -1 }
    } else if emitExpr(body, argIx, fnIx, ec) < 0 {
      return -1
    }
  } else if fnChoiceArmsPlain(argIx, 0) {
    // An `if` choosing a function per arm builds its closure value as a binding of it does.
    if emitExpr(body, argIx, fnIx, ec) < 0 { return -1 }
  } else {
    return emitFail("emitProgram: unsupported .map/.filter callback")
  }
  0
}

function emitMapFilter(body: u8[], callIx: i32, fnIx: i32, ec: ExpCtx) {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      const isMap = callee.memProp == "map"
      if c.callArgs.length != 1 {
        return emitFail(
          "emitProgram: internal: .map/.filter reached with the wrong argument count — the checker's arity rule refuses it",
        )
      }
      const recvK = mfRecvKindOf(callee.memObj, fnIx)
      if recvK == null {
        return emitFail(
          "emitProgram: .map/.filter receiver is not a supported list",
        )
      }
      const resK = mfResultKindOf(callIx, fnIx)
      if resK == null {
        return emitFail("emitProgram: unsupported .map/.filter element type")
      }
      // The ref-list slot for a kind-2 result (`.filter` over a struct array) — picks the
      // result backing/wrapper + the matching dst scratch local. -1 for a non-ref result.
      const dstSlot = mfResultSlotOf(callIx, fnIx)
      const cbFe = mfCallbackFe(c.callArgs[0], fnIx)
      const sig = mfCallbackSigOf(c.callArgs[0], cbFe, fnIx)
      if sig < 0 {
        return emitFail(
          "emitProgram: .map/.filter callback signature is not interned",
        )
      }
      const src: MfSrcTys = {
        srcWrap: lTypeIdx,
        srcBack: aTypeIdx,
        srcElemRef: false,
        srcSlot: -1,
      }
      if mfSrcTysOf(recvK, callee.memObj, fnIx, src) < 0 { return -1 }
      const srcWrap = src.srcWrap
      const srcBack = src.srcBack
      const srcElemRef = src.srcElemRef
      const srcSlot = src.srcSlot
      // The RESULT wrapper/backing heap types.
      const dst: MfDstTys = { dstWrap: lTypeIdx, dstBack: aTypeIdx }
      if mfDstTysOf(resK, dstSlot, callIx, dst) < 0 { return -1 }
      const dstWrap = dst.dstWrap
      const dstBack = dst.dstBack
      const srcL = mfSrcLocalFor(recvK, srcSlot)
      const dstL = mfDstLocalFor(resK, dstSlot)
      if !fnUsesMapFilter || srcL < 0 || dstL < 0 {
        return emitFail("emitProgram: .map/.filter scratch frame not reserved")
      }
      const iL = mfScratchBase
      const nL = mfScratchBase + 1
      const jL = mfScratchBase + 2
      const cL = mfCallbackLocal()
      // src = <receiver>, evaluated ONCE. (Any nested `.map`/`.filter` in the
      // receiver chain completes — including its result wrapper — before this store,
      // so the shared frame slots are free to reuse.)
      if emitExpr(body, callee.memObj, fnIx, ec) < 0 { return -1 }
      // A NARROWED nullable-list receiver keeps its nullable slot at EVERY element kind;
      // the src scratch slot is declared non-null (`fbRefRun` writes `0x64`), so recover
      // first (checker-guarded, never traps). See `nulRecvNeedsRecover`.
      if nulRecvNeedsRecover(callee.memObj, fnIx) { fbRefAsNonNull() }
      svSyncRecv(callee.memObj, fnIx)
      fbLocalSet(srcL)
      mfSrcSlot = -1
      if srcElemRef { mfSrcSlot = srcSlot }
      mfSvDst = svDstOfKind(scalarListElemKind(callee.memObj, fnIx))
      mfRv = rvRecvMayView(callee.memObj, fnIx)
      // clo = the callback's closure value, built ONCE before the loop. An inline
      // literal / named function constructs it directly; a let-bound value reads its
      // binding (an `Ident` read — it cannot itself contain a HOF site, so the frame
      // slots written above stay live).
      if emitMfCallbackValue(body, c.callArgs[0], cbFe, fnIx, ec) < 0 {
        return -1
      }
      fbLocalSet(cL)
      // n = src.len
      fbLocalGet(srcL)
      fbStructGet(srcWrap, 1) // field 1: len
      fbLocalSet(nL)
      // back = array.new_default <dstBack> n
      fbLocalGet(nL)
      fbArrayNewDefault(dstBack)
      fbLocalSet(dstL)
      // i = 0 (and j = 0 for filter)
      fbI32Const(0)
      fbLocalSet(iL)
      if !isMap {
        fbI32Const(0)
        fbLocalSet(jL)
      }
      // block { loop { if i >= n br 1; <element step>; i++; br 0 } }
      fbBlock(64)  // 0x02 block (void)
      fbLoop(64)   // 0x03 loop (void)
      fbLocalGet(iL)
      fbLocalGet(nL)
      fbI32Bin(78) // 0x4e i32.ge_s — i >= n?
      fbBrIf(1)    // exit the block
      if isMap {
        // back[i] = call_ref(clo, [elem(i)])
        fbLocalGet(dstL)
        fbLocalGet(iL)
        if (
          emitMfInvoke(body, cL, srcL, iL, srcWrap, srcBack, srcElemRef, sig)
          < 0
        ) {
          return -1
        }
        fbArraySet(dstBack) // 0xfb 0x0e <dstBack>
      } else {
        // e = elem(i); if call_ref(clo, [e]): back[j] = e; j++. The element is read once, so
        // the kept value is the one the callback tested, whatever it writes (D3060).
        let eSlot = 0
        if resK == "ref" { eSlot = dstSlot }
        const eL = listIdxValSlot(resK, eSlot)
        if emitMfElem(body, srcL, iL, srcWrap, srcBack, srcElemRef) < 0 {
          return -1
        }
        fbLocalSet(eL)
        fbLocalGet(cL)
        fbStructGet(cloStructIdx, 0) // env
        fbLocalGet(eL)
        if srcElemRef { fbRefAsNonNull() }
        fbLocalGet(cL)
        fbStructGet(cloStructIdx, 1) // the callee's wasm function index
        fbCallIndirect(sig, gFnTableIdx)
        fbIf(64)                     // 0x04 if (void)
        fbLocalGet(dstL)
        fbLocalGet(jL)
        fbLocalGet(eL)
        fbArraySet(dstBack)
        fbLocalGet(jL)
        fbI32Const(1)
        fbI32Bin(106)                // 0x6a i32.add
        fbLocalSet(jL)
        fbEnd()
      }
      fbLocalGet(iL)
      fbI32Const(1)
      fbI32Bin(106) // 0x6a i32.add
      fbLocalSet(iL)
      fbBr(0)       // continue the loop
      fbEnd()       // end loop
      fbEnd()       // end block
      mfSrcSlot = -1
      mfSvDst = -1
      mfRv = false
      // result = wrapper{ back, len, cap }: len = n (map) / j (filter), cap = n.
      fbLocalGet(dstL)
      if isMap { fbLocalGet(nL) } else { fbLocalGet(jL) }
      fbLocalGet(nL)
      fbStructNew(dstWrap)
      return 0
    }
  }
  emitFail("emitProgram: expected a .map/.filter call")
}

// The wrapper and backing heap types of a `.map`/`.filter` result list.
type MfDstTys = {
  dstWrap: i32,
  dstBack: i32,
}

// Writes into `dst` the result list types for result kind `resK`; `dst` arrives holding the
// i32 list's, and `dstSlot` is a ref-list result's row. Returns -1 on a failure, else 0.
function mfDstTysOf(resK: MfKind, dstSlot: i32, callIx: i32, dst: MfDstTys) {
  if resK == "f64" {
    if !fa64Used {
      return emitFail(
        "emitProgram: .map result is f64[] but f64 list type not collected",
      )
    }
    dst.dstWrap = fl64TypeIdx
    dst.dstBack = fa64TypeIdx
  } else if resK == "i64" {
    if !ia64Used {
      return emitFail(
        "emitProgram: .map result is i64[] but i64 list type not collected",
      )
    }
    dst.dstWrap = il64TypeIdx
    dst.dstBack = ia64TypeIdx
  } else if resK == "f32" {
    if !fa32Used {
      return emitFail(
        "emitProgram: .map result is f32[] but f32 list type not collected",
      )
    }
    dst.dstWrap = fl32TypeIdx
    dst.dstBack = fa32TypeIdx
  } else if resK == "str" {
    // A STRING-list result: a `.filter` over a string list, or a `.map` whose callback
    // returns a string. The backing `$mkArrIdx` holds string refs; `array.set` stores
    // the callback's (non-null) string result directly.
    if !slUsed {
      return emitFail(
        "emitProgram: .map/.filter result is string[] but string list type not collected",
      )
    }
    dst.dstWrap = mkListIdx
    dst.dstBack = mkArrIdx
  } else if resK == "ref" {
    // A REF-list result (a `.filter` over a struct/union array preserves the element type):
    // the result is the SAME ref list as the source, so its wrapper/backing come from the
    // result slot (== the source slot for `.filter`).
    if !rlUsed {
      return emitFail(
        "emitProgram: .filter result is a ref list but ref list type not collected",
      )
    }
    if dstSlot < 0 { return refListRowRefused(callIx) }
    dst.dstWrap = rlWrapIdx[dstSlot]
    dst.dstBack = rlBackIdx[dstSlot]
  } else if resK == "u8" {
    // A `.filter` over a `u8[]` keeps the packed rep (`mfResultKindOf` forwards the
    // receiver's kind) — the destination twin of the source arm above, and unreachable
    // for the same reason until the `u8` callback parameter has a lowering.
    if !ba8Used {
      return emitFail(
        "emitProgram: .filter result is u8[] but the packed byte list type not collected",
      )
    }
    dst.dstWrap = bl8TypeIdx
    dst.dstBack = ba8TypeIdx
  } else if !lUsed || !aUsed {
    return emitFail(
      "emitProgram: .map/.filter result but list type not collected",
    )
  }
  0
}

// The frame every element-converting list copy shares: the source list on the stack is held in
// `sL`, a destination backing of its length made in `dL`, and a loop over `i` entered with the
// store's array and index pushed when the element step writes; the step then leaves the element.
function emitCopyLoopOpen(
  sL: i32,
  srcWrap: i32,
  nL: i32,
  dstBack: i32,
  dL: i32,
  iL: i32,
) {
  fbLocalSet(sL)
  fbLocalGet(sL)
  fbStructGet(srcWrap, 1)
  fbLocalSet(nL)
  fbLocalGet(nL)
  fbArrayNewDefault(dstBack)
  fbLocalSet(dL)
  fbI32Const(0)
  fbLocalSet(iL)
  fbBlock(64)
  fbLoop(64)
  fbLocalGet(iL)
  fbLocalGet(nL)
  fbI32Bin(78) // i32.ge_s
  fbBrIf(1)
  0
}

// Close `emitCopyLoopOpen`'s loop after the element's store and leave the destination list, whose
// backing field is non-null and whose capacity is its length.
function emitCopyLoopClose(iL: i32, dL: i32, nL: i32, dstWrap: i32) {
  fbLocalGet(iL)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  fbLocalSet(iL)
  fbBr(0)
  fbEnd()
  fbEnd()
  fbLocalGet(dL)
  fbRefAsNonNull()
  fbLocalGet(nL)
  fbLocalGet(nL)
  fbStructNew(dstWrap)
  0
}

// ── the element-converting copy (read-only covariance, D791) ──────────────────
// Consume a `(ref $rlWrapIdx[srcSlot])` on the stack and leave a `(ref $rlWrapIdx[dstSlot])`
// holding the same elements boxed into the shared union box — the only lowering the pair
// has, since a mutable WasmGC array is invariant. Callers must ask `rlWidenAllowed` first.
function emitRefListWidenTop(_body: u8[], srcSlot: i32, dstSlot: i32) {
  const vi = rlWidenVariantOf(srcSlot, dstSlot)
  if vi < 0 || vi >= uTags.length {
    return emitFail(
      "emitProgram: ref-list widening asked for an element pair with no union arm",
    )
  }
  // The `fbValtype` discipline: never index a parallel `rl*` table on a slot that only
  // one of them covers. `rlWidenVariantOf` bounded `rlElemKindTbl`; these are the two
  // columns the loop's heap-type immediates come from.
  if srcSlot >= rlWrapIdx.length || dstSlot >= rlWrapIdx.length {
    return emitFail(
      "emitProgram: ref-list widening slot has no interned wrapper",
    )
  }
  if srcSlot >= rlBackIdx.length || dstSlot >= rlBackIdx.length {
    return emitFail(
      "emitProgram: ref-list widening slot has no interned backing",
    )
  }
  const srcWrap = rlWrapIdx[srcSlot]
  const srcBack = rlBackIdx[srcSlot]
  const dstWrap = rlWrapIdx[dstSlot]
  const dstBack = rlBackIdx[dstSlot]
  const sL = widenSrcWrapSlot(srcSlot)
  const dL = widenDstBackSlot(dstSlot)
  const iL = widenTmpSlot(0)
  const nL = widenTmpSlot(1)
  // Does the SOURCE row's element carry the `| null` niche (D811)? This is the one bit
  // that picks the loop body below, and it is read from the same column
  // `rlWidenVariantOf` bounded.
  const srcNul = srcSlot < rlElemNullable.length && rlElemNullable[srcSlot] == 1
  // src = <stack>, evaluated ONCE by the caller.
  emitCopyLoopOpen(sL, srcWrap, nL, dstBack, dL, iL)
  // block { loop { if i >= n br 1; back[i] = {tag, src.back[i]}; i++; br 0 } }
  fbLocalGet(dL)
  fbLocalGet(iL)
  if srcNul {
    // the niche source's two-tag loop body (D811): the source element is `(ref null
    // $elem)` whose null is a legal value, and the destination box has a rep for that — a
    // box carrying `nullBoxTag()`. Boxing under the arm's tag instead is D792's trap: the
    // narrow's `ref.cast` would fail on the null payload, so the tag is picked per element.
    fbLocalGet(sL)
    fbStructGet(srcWrap, 0)
    fbLocalGet(iL)
    fbArrayGet(srcBack)
    fbRefIsNull()
    fbIfRefNul(uBoxIdx, false) // if (result (ref $uBox))
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone() // the payload slot is unread under the null tag
    fbStructNew(uBoxIdx)
    fbElse()
    fbI32Rel(RS_TAG, uTags[vi]) // the arm's program-global tag
    fbLocalGet(sL)
    fbStructGet(srcWrap, 0)
    fbLocalGet(iL)
    fbArrayGet(srcBack)
    fbStructNew(uBoxIdx)
    fbEnd()
  } else {
    fbI32Rel(RS_TAG, uTags[vi]) // the arm's program-global tag
    fbLocalGet(sL)
    fbStructGet(srcWrap, 0) // the source backing, `(ref $srcBack)`
    fbLocalGet(iL)
    fbArrayGet(srcBack) // `(ref null $elem)` — the box payload is `anyref`, so no recover
    fbStructNew(uBoxIdx)
  }
  fbArraySet(dstBack)
  emitCopyLoopClose(iL, dL, nL, dstWrap)
  0
}

// The scratch slots' `liKinds` column is `MfKind`, whose `u8` names the PACKED backing
// that `VKind`'s `u8list` names the list of. Every other element kind spells the same.
function scalarElemMfKind(k: VKind): MfKind {
  match k {
    "f64" => {
      return "f64"
    }
    "i64" => {
      return "i64"
    }
    "f32" => {
      return "f32"
    }
    "u8list" => {
      return "u8"
    }
    // Every other kind keys the i32 scratch column.
    "i32" | "struct" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "f64list" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "v128" => {}
  }
  "i32"
}

// the scalar sibling of `emitRefListWidenTop` (D965): same loop, a numeric convert where
// the ref version boxes. Exactly the three lossless widenings VL's scalar assignability
// admits (i32→i64, i32→f64, f32→f64) over the full source/destination grid — every other
// pair is a design rejection, outside clause 2. Returns the opcode, or -1 for a decline (never an error).
function scalarWidenConvOp(srcKind: VKind, dstKind: VKind): i32 {
  match srcKind {
    "i32" => {
      match dstKind {
        "i64" => {
          return 172
        }
        "f64" => {
          return 183
        }
        // No other destination is a lossless widening of i32.
        "i32" | "struct" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "f64list" | "f32" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" | "v128" => {}
      }
      return -1
    }
    "f32" => {
      match dstKind {
        "f64" => {
          return 187
        }
        // No other destination is a lossless widening of f32.
        "i32" | "struct" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "i64" | "f64list" | "f32" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" | "v128" => {}
      }
    }
    // No other source kind widens.
    "struct" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "i64" | "f64" | "f64list" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "u8list" | "v128" => {}
  }
  -1
}

function emitScalarListWidenTop(_body: u8[], srcKind: VKind, dstKind: VKind) {
  const op = scalarWidenConvOp(srcKind, dstKind)
  if op < 0 {
    return emitFail(
      "emitProgram: scalar-list widening asked for an element pair with no convert",
    )
  }
  const srcWrap = scalarListWrap(srcKind)
  const srcBack = scalarListBack(srcKind)
  const dstWrap = scalarListWrap(dstKind)
  const dstBack = scalarListBack(dstKind)
  const sL = widenScalarWrapSlot(scalarElemMfKind(srcKind))
  const dL = widenScalarBackSlot(scalarElemMfKind(dstKind))
  const iL = widenTmpSlot(0)
  const nL = widenTmpSlot(1)
  // src = <stack>, evaluated ONCE by the caller.
  emitCopyLoopOpen(sL, srcWrap, nL, dstBack, dL, iL)
  // block { loop { if i >= n br 1; back[i] = conv(src.back[i]); i++; br 0 } }
  fbLocalGet(dL)
  fbLocalGet(iL)
  fbLocalGet(sL)
  fbStructGet(srcWrap, 0) // the source backing
  fbLocalGet(iL)
  fbArrayGet(srcBack) // yields the element in the SOURCE's rep
  wU8(op) // ...and this is the one byte that makes it the destination's
  fbArraySet(dstBack)
  emitCopyLoopClose(iL, dL, nL, dstWrap)
  0
}

// Consume a list of literal-union atoms (`i32` ids) on the stack and leave a `string[]` whose
// elements are each atom's member string, `texts` giving the members (D2868). The string-list
// sibling of `emitScalarListWidenTop`; the per-element tower is `emitAtomToStr`'s.
function emitAtomListToStrTop(texts: string[]) {
  if texts.length == 0 {
    return emitFail(
      "emitProgram: a spread widening literal-union atoms to strings has no members",
    )
  }
  const srcWrap = scalarListWrap("i32")
  const srcBack = scalarListBack("i32")
  const dstWrap = scalarListWrap("str")
  const dstBack = scalarListBack("str")
  const sL = widenScalarWrapSlot("i32")
  const dL = widenScalarBackSlot("str")
  const iL = widenTmpSlot(0)
  const nL = widenTmpSlot(1)
  const aL = widenTmpSlot(2)
  emitCopyLoopOpen(sL, srcWrap, nL, dstBack, dL, iL)
  // block { loop { if i >= n br 1; a = src.back[i]; back[i] = str(a); i++; br 0 } }
  fbLocalGet(sL)
  fbStructGet(srcWrap, 0)
  fbLocalGet(iL)
  fbArrayGet(srcBack)
  fbLocalSet(aL)
  fbLocalGet(dL)
  fbLocalGet(iL)
  if emitAtomLocalToStrChain(texts, 0, aL) < 0 { return -1 }
  fbArraySet(dstBack)
  emitCopyLoopClose(iL, dL, nL, dstWrap)
  0
}

// `emitAtomToStrChain` over an atom id held in local `aL` rather than the string-op frame,
// which a function reserves only when it has a string operation of its own.
function emitAtomLocalToStrChain(texts: string[], i: i32, aL: i32) {
  if i >= texts.length - 1 {
    return emitStr([], mkStr(quoteLex(texts[i]), -1), -1)
  }
  if emitStr([], mkStr(quoteLex(texts[i]), -1), -1) < 0 { return -1 }
  if emitAtomLocalToStrChain(texts, i + 1, aL) < 0 { return -1 }
  fbLocalGet(aL)
  fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
  fbI32Bin(70) // i32.eq
  fbSelectRef(sTypeIdx)
  0
}

// The convert opcode an element of `srcKind` takes before it is boxed under value atom
// `atomK`: -1 when the atom is the element's own, -2 when no lossless widening reaches it.
function scalarBoxWidenOp(srcKind: VKind, atomK: i32): i32 {
  if atomK == 3 {
    if srcKind == "i64" { return -1 }
    const o = scalarWidenConvOp(srcKind, "i64")
    if o < 0 { return -2 }
    return o
  }
  if atomK == 4 {
    if srcKind == "f64" { return -1 }
    const o = scalarWidenConvOp(srcKind, "f64")
    if o < 0 { return -2 }
    return o
  }
  -1
}

// Consume a scalar list of `srcKind` on the stack and leave a `(ref $rlWrapIdx[dstSlot])` whose
// union-box elements each hold one source element under value atom `atomK`'s tag: the boxing
// sibling of `emitScalarListWidenTop`, for a spread into a list of a union element (D2869).
function emitScalarListBoxTop(srcKind: VKind, atomK: i32, dstSlot: i32) {
  const conv = scalarBoxWidenOp(srcKind, atomK)
  if conv == -2 {
    return emitFail(
      "emitProgram: a spread boxing a scalar list has no convert into its element's atom",
    )
  }
  let vb = -1
  if atomK != 2 {
    vb = vbHeapIdxOfKind(atomK)
    if vb < 0 {
      return emitFail(
        "emitProgram: a spread boxing a scalar list has no value box for its element",
      )
    }
  }
  if dstSlot < 0 || dstSlot >= rlWrapIdx.length || dstSlot >= rlBackIdx.length {
    return emitFail(
      "emitProgram: a spread boxing a scalar list has no destination row",
    )
  }
  const srcWrap = scalarListWrap(srcKind)
  const srcBack = scalarListBack(srcKind)
  const dstWrap = rlWrapIdx[dstSlot]
  const dstBack = rlBackIdx[dstSlot]
  let sk = scalarElemMfKind(srcKind)
  if srcKind == "str" { sk = "str" }
  const sL = widenScalarWrapSlot(sk)
  const dL = widenDstBackSlot(dstSlot)
  const iL = widenTmpSlot(0)
  const nL = widenTmpSlot(1)
  emitCopyLoopOpen(sL, srcWrap, nL, dstBack, dL, iL)
  // block { loop { if i >= n br 1; back[i] = {tag, box(src.back[i])}; i++; br 0 } }
  fbLocalGet(dL)
  fbLocalGet(iL)
  fbI32Rel(RS_TAG, scalarTagOfKind(atomK))
  fbLocalGet(sL)
  fbStructGet(srcWrap, 0)
  fbLocalGet(iL)
  fbArrayGet(srcBack)
  if conv >= 0 { wU8(conv) }
  if vb >= 0 { fbStructNew(vb) }
  fbStructNew(uBoxIdx)
  fbArraySet(dstBack)
  emitCopyLoopClose(iL, dL, nL, dstWrap)
  0
}

// A ref-list slot's element type name for a message, or `"?"` where the slot has no row —
// the parallel `rl*` columns are sized independently, so this is the one bounded read.
function rlWidenElemName(slot: i32): string {
  if slot < 0 { return "?" }
  if slot >= rlElemName.length { return "?" }
  rlElemName[slot]
}

// A widenable pair whose converting copy the licence declined. The copy is a snapshot, so an
// unknown write state may not be guessed at, and no second lowering exists — the delivery
// would otherwise leave the source's rep in a destination-repped slot. Refused here rather
// than in the checker, whose half of the licence omits the rep-scoped write scan (D1656).
function emitRefListWidenDeclined(
  srcIx: i32,
  srcSlot: i32,
  dstSlot: i32,
): boolean {
  const dn = rlWidenElemName(dstSlot)
  emitFailAt(
    "emitProgram: covariant list delivery: a "
      + rlWidenElemName(srcSlot)
      + "[] cannot be delivered into a "
      + dn
      + "[] here. The two element storages differ, so the destination would have to hold an "
      + "element-converting COPY, and that copy is a snapshot — legal only where nothing "
      + "writes either list. This program writes through one of them, and the covariant-write "
      + "analysis cannot reach every handle on this value: a container whose call result is "
      + "delivered under no name, an intermediate container given a name of its own, and a "
      + "callee whose parameter list this program does not spell (a function-typed parameter, "
      + "a re-pointed function binding, a lambda held in a field) each end its walk, so it "
      + "cannot tell whether that write reaches this list. Declare the receiving parameter "
      + "`readonly "
      + dn
      + "[]` — a read-only view needs no such proof, since nothing may write through it — or "
      + "give every container the value passes through a name, call only functions and "
      + "lambdas bound once by name, or declare the source as "
      + dn
      + "[]",
    srcIx,
  )
  false
}

// Whether `srcIx` names a binding whose record-literal list the checker built at a union list.
function identBuiltAtUnionList(srcIx: i32): boolean {
  if !(nodeAt(unwrapParen(srcIx)) is Ident) { return false }
  const k = cwKeyOfRoot(srcIx)
  k >= 0 && nodeAt(k) is LetDecl && letInitUnionListTy(k, cwKeyFrame(k)) >= 0
}

// The delivery-site half: a value just emitted at ref-list slot `srcSlot` is being
// delivered into a `dstSlot` destination. Widen it in place when the pair is widenable
// and the whole-program write scan licenses it; a widenable pair the scan declines is a
// loud refusal, since no other lowering exists. One predicate, one emitter, every delivery.
export function emitRefListWidenSite(
  body: u8[],
  srcIx: i32,
  srcSlot: i32,
  dstSlot: i32,
): boolean {
  const rtFrom: i32[] = []
  const rtTo: i32[] = []
  listWidenRetagRowsOf(srcIx, rtFrom, rtTo)
  if rtFrom.length > 0 {
    return emitRefListRetagSite(srcIx, srcSlot, dstSlot, rtFrom, rtTo)
  }
  // A list two unions alias is built at union boxes (D853), which no record list can hold.
  if rlBoxIntoRowList(srcSlot, dstSlot) && identBuiltAtUnionList(srcIx) {
    emitFailAt(
      "emitProgram: list delivery: this list is built as a list of union boxes, because it "
        + "is also delivered as two different unions, so it cannot also be delivered as a "
        + rlWidenElemName(dstSlot)
        + "[]. Copy it for this use",
      srcIx,
    )
    return false
  }
  // Not a widenable pair: the same slot, or two element reps with no conversion between
  // them. The common case at every delivery, and nothing is owed.
  if rlWidenVariantOf(srcSlot, dstSlot) < 0 { return false }
  if (!rlWidenAllowed(cwKeyOfRoot(srcIx), srcSlot, dstSlot)) {
    // A `readonly` destination needs no write proof: a view reads the source as it is (D3041).
    if refViewReadonlyAt(srcIx) && rvMayView(dstSlot) {
      if rvEmitView(srcSlot) { return true }
    }
    return emitRefListWidenDeclined(srcIx, srcSlot, dstSlot)
  }
  // A source other handles may write is delivered as a view that reads through it (D3041).
  if !covarRootFreshLocal(srcIx) && rvMayView(dstSlot) {
    if rvEmitView(srcSlot) { return true }
  }
  if emitRefListWidenTop(body, srcSlot, dstSlot) < 0 { return false }
  true
}

// A list of union boxes delivered as a `readonly` list whose element holds member `from[k]` only
// as `to[k]` (D2999): copied, each box rebuilt under the widened member, where nothing writes the
// source and every handle on it is known. Otherwise it stays shared, which only a read of such a
// member misreads (D3026): a trap, where a stale snapshot would print a wrong value.
function emitRefListRetagSite(
  srcIx: i32,
  srcSlot: i32,
  dstSlot: i32,
  from: i32[],
  to: i32[],
): boolean {
  if covarValueWriteState(cwKeyOfRoot(srcIx)) != 0 { return false }
  if !covarRootFreshLocal(srcIx) { return false }
  if (
    srcSlot < 0
    || dstSlot < 0
    || srcSlot >= rlWrapIdx.length
    || dstSlot >= rlWrapIdx.length
    || srcSlot >= rlBackIdx.length
    || dstSlot >= rlBackIdx.length
  ) {
    emitFailAt(
      "emitProgram: a union list delivered widened has no interned list type",
      srcIx,
    )
    return false
  }
  const srcWrap = rlWrapIdx[srcSlot]
  const srcBack = rlBackIdx[srcSlot]
  const dstWrap = rlWrapIdx[dstSlot]
  const dstBack = rlBackIdx[dstSlot]
  const sL = widenSrcWrapSlot(srcSlot)
  const dL = widenDstBackSlot(dstSlot)
  const iL = widenTmpSlot(0)
  const nL = widenTmpSlot(1)
  emitCopyLoopOpen(sL, srcWrap, nL, dstBack, dL, iL)
  // block { loop { if i >= n br 1; back[i] = retag(src.back[i]); i++; br 0 } }
  fbLocalGet(dL)
  fbLocalGet(iL)
  fbLocalGet(sL)
  fbStructGet(srcWrap, 0)
  fbLocalGet(iL)
  fbArrayGet(srcBack)
  // Below `len` every element is a box: a `null` member is boxed under its own tag.
  fbRefAsNonNull()
  fbLocalSet(unionAsBoxSlot())
  let w = 0
  while w < from.length {
    if emitWidenRetagArm(from[w], to[w]) < 0 { return false }
    w = w + 1
  }
  fbLocalGet(unionAsBoxSlot())
  let e = 0
  while e < from.length {
    fbEnd()
    e = e + 1
  }
  fbArraySet(dstBack)
  emitCopyLoopClose(iL, dL, nL, dstWrap)
  true
}

// The list kind a destination annotation classifies as, reduced to the element kind the
// `scalarList*` family keys on. `""` for anything not a scalar list. `u8list` answers with
// its own list kind since its element value kind (i32) does not identify its packed backing.
function scalarListElemOfListKind(k: VKind): VKind | null {
  match k {
    "list" => {
      return "i32"
    }
    "f64list" => {
      return "f64"
    }
    "i64list" => {
      return "i64"
    }
    "f32list" => {
      return "f32"
    }
    "u8list" => {
      return "u8list"
    }
    // Not a scalar list.
    "i32" | "struct" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "i64" | "f64" | "f32" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulu8list" | "nulmap" | "nulnone" | "v128" => {}
  }
  null
}

// The scalar delivery site (D965) — `emitRefListWidenSite`'s twin, asked at the same
// boundaries: the pair must be one of the three the copy serves, both sides must classify
// as scalar lists, and D821's per-value write scan must say definitely-unwritten. The
// licence is the ref site's, for the same reason — a converting copy is a snapshot, so an unknown write state declines rather than risk a silently wrong program.
export function emitScalarListWidenSite(
  body: u8[],
  srcIx: i32,
  fnIx: i32,
  dstListKind: VKind,
): boolean {
  const de = scalarListElemOfListKind(dstListKind)
  if de == null { return false }
  emitScalarListWidenSiteElem(body, srcIx, fnIx, de)
}

// The copy a list value owes on its way into an element of the ref list at `rslot` — a
// nested-list literal element, a `.push` or an indexed store (D2163). The element's nest
// code names the destination: 9 an inner ref list, 4/7/8/10 an `i32`/`f64`/`i64`/`f32` list.
function emitNestedListWidenSite(
  body: u8[],
  valIx: i32,
  fnIx: i32,
  rslot: i32,
): boolean {
  if rslot < 0 || rslot >= rlElemKindTbl.length { return false }
  const nest = rlElemKindTbl[rslot]
  if nest == RLK_REF_LIST {
    const inner = rlElemInnerSlot(rslot)
    if inner < 0 { return false }
    return emitRefListWidenSite(
      body,
      valIx,
      exprEmittedRefListSlot(valIx, fnIx),
      inner,
    )
  }
  let nse: VKind | null = null
  if nest == RLK_I32_LIST { nse = "i32" }
  if nest == RLK_F64_LIST { nse = "f64" }
  if nest == RLK_I64_LIST { nse = "i64" }
  if nest == RLK_F32_LIST { nse = "f32" }
  if nse == null { return false }
  emitScalarListWidenSiteElem(body, valIx, fnIx, nse)
}

// The same site keyed by the destination's ELEMENT kind rather than its list kind, for
// the two boundaries that have the destination as an EXPRESSION (the assignment's LHS)
// or as a nested element rather than as an annotation or a cell column.
function emitScalarListWidenSiteElem(
  body: u8[],
  srcIx: i32,
  fnIx: i32,
  de: VKind,
): boolean {
  if listFitStoodIn >= 0 && listFitStoodIn == unwrapParen(srcIx) {
    listFitStoodIn = -1
    const stood = listFitStoodKind(listFitStoodWrap)
    if stood == null || stood == de || scalarWidenConvOp(stood, de) < 0 {
      return false
    }
    return emitScalarListWidenTop(body, stood, de) >= 0
  }
  const sk = scalarListElemKind(srcIx, fnIx)
  if sk == null { return false }
  if scalarWidenConvOp(sk, de) < 0 { return false }
  // A `.map` / `.filter` / `.slice` result is a list nothing else holds, so its copy is the value.
  const fresh = unwrapParen(srcIx)
  if callIsMapFilter(fresh, fnIx) || callIsArrSlice(fresh, fnIx) {
    return emitScalarListWidenTop(body, sk, de) >= 0
  }
  // A named source other handles may write is delivered as a view that reads through it
  // (D3028). A literal has no root, and is built at the destination's element already.
  const wroot = covarRootName(srcIx)
  const wst = covarValueWriteState(cwKeyOfRoot(srcIx))
  if wroot != "" && (wst != 0 || !covarRootFreshLocal(srcIx)) {
    const p = svPairOfKinds(sk, de)
    if p >= 0 {
      fbCall(gHelpSvMk[p])
      return true
    }
  }
  if wst != 0 { return false }
  if emitScalarListWidenTop(body, sk, de) < 0 { return false }
  true
}

// The view pair (`svPairOn`) serving a `src` list read as a `dst` one, or -1 where none is built.
// The three pairs are exactly the three converts `scalarWidenConvOp` names, in its order.
function svPairOfKinds(src: VKind, dst: VKind): i32 {
  const op = scalarWidenConvOp(src, dst)
  const ops = [172, 183, 187]
  let p = 0
  while p < ops.length {
    if ops[p] == op && svPairOn(p) { return p }
    p = p + 1
  }
  -1
}

// The view destination a scalar list of element `k` reads as (0 `i64`, 1 `f64`), or -1 where
// no view of that element is built: `k` is a destination exactly when an `i32` widens to it.
function svDstOfKind(k: VKind | null): i32 {
  if svPairs == 0 || k == null { return -1 }
  const d = svPairOfKinds("i32", k)
  if d == 0 { return 0 }
  if svDstOn(1) && scalarWidenConvOp("i32", k) == 183 { return 1 }
  -1
}

// Refresh the list just emitted for `recvIx` when it may be a view, before an operation reads
// its backing whole: the view's snapshot then holds its source as it is now (D3028).
function svSyncRecv(recvIx: i32, fnIx: i32) {
  if rvRecvMayView(recvIx, fnIx) {
    fbCall(gHelpRvSync)
    return 0
  }
  if svPairs == 0 { return 0 }
  const d = svDstOfKind(scalarListElemKind(recvIx, fnIx))
  if d >= 0 { fbCall(gHelpSvSync[d]) }
  0
}

// Push whether the list in local `wL` is a view read as destination `d`: one `ref.test` per view
// type of that destination, so a plain list pays a failed test and takes its own read.
function svTestView(wL: i32, d: i32) {
  let n = 0
  let p = 0
  while p < svViewTy.length {
    if svPairOn(p) && (p == 0) == (d == 0) {
      fbLocalGet(wL)
      fbRefTest(svViewTy[p])
      if n > 0 {
        fbI32Bin(114) // 0x72 i32.or
      }
      n = n + 1
    }
    p = p + 1
  }
  if n == 0 { fbI32Const(0) }
  0
}

// The element read of a list of element `ek` that may be a view read as `d`, with the list and
// the index on the stack: a view reads through its source, any other list reads its backing.
function emitSvIndexRead(ek: VKind, d: i32) {
  const wL = listIdxWrapSlot(listIdxKindOf(ek), 0)
  fbLocalSet(listIdxScratchBase)
  fbLocalSet(wL)
  svTestView(wL, d)
  fbIf(scalarListBlocktype(ek))
  fbLocalGet(wL)
  fbLocalGet(listIdxScratchBase)
  fbCall(gHelpSvGet[d])
  fbElse()
  fbLocalGet(wL)
  fbLocalGet(listIdxScratchBase)
  emitListIdxGuard(wL, scalarListWrap(ek))
  fbArrayGet(scalarListBack(ek))
  fbEnd()
  0
}

// Whether the statement or expression at `ix` stores through an index anywhere, over the node
// kinds `hoistSafeStmt` admits: such a store reaches a view's source without passing its snapshot.
function storesIndex(ix: i32, fnIx: i32): boolean {
  if ix < 0 { return false }
  const e = nodeAt(ix)
  if e is Block {
    let i = 0
    while i < e.blkStmts.length {
      if storesIndex(e.blkStmts[i], fnIx) { return true }
      i = i + 1
    }
    return false
  }
  if e is LetDecl { return storesIndex(e.letInit, fnIx) }
  if e is BreakStmt || e is ContinueStmt { return false }
  if e is RetStmt { return storesIndex(e.retArg, fnIx) }
  if e is IfStmt {
    return storesIndex(e.ifCond, fnIx)
      || storesIndex(e.ifThen, fnIx)
      || storesIndex(e.ifElse, fnIx)
  }
  if e is WhileStmt {
    return storesIndex(e.whileCond, fnIx) || storesIndex(e.whileBody, fnIx)
  }
  if e is ForRange {
    return storesIndex(e.frFrom, fnIx)
      || storesIndex(e.frTo, fnIx)
      || storesIndex(e.frStep, fnIx)
      || storesIndex(e.frBody, fnIx)
  }
  if e is ForIn {
    return storesIndex(e.fiIter, fnIx) || storesIndex(e.fiBody, fnIx)
  }
  if e is Unary { return storesIndex(e.unArg, fnIx) }
  if e is Paren { return storesIndex(e.parInner, fnIx) }
  if e is IsExpr { return storesIndex(e.isObj, fnIx) }
  if e is AsExpr { return storesIndex(e.asObj, fnIx) }
  if e is Member { return storesIndex(e.memObj, fnIx) }
  if e is Index {
    return storesIndex(e.idxArr, fnIx) || storesIndex(e.idxIndex, fnIx)
  }
  if e is BinExpr {
    if e.binOp == "=" && nodeAt(e.binLeft) is Index { return true }
    return storesIndex(e.binLeft, fnIx) || storesIndex(e.binRight, fnIx)
  }
  if e is Call {
    let a = 0
    while a < e.callArgs.length {
      if storesIndex(e.callArgs[a], fnIx) { return true }
      a = a + 1
    }
    return storesIndex(e.callFn, fnIx)
  }
  // A literal or a name stores nothing; any other kind is one the hoist whitelist refuses.
  !hoistSafeExpr(ix, fnIx)
}

// Whether a loop over `condIx` and `bodyIx` may not cache the header of the list at `recvIx`:
// it may be a view, and the loop stores through an index, which its snapshot would not see.
function svHoistBlocked(
  recvIx: i32,
  fnIx: i32,
  condIx: i32,
  bodyIx: i32,
): boolean {
  if rvRecvMayView(recvIx, fnIx) {
    return storesIndex(condIx, fnIx) || storesIndex(bodyIx, fnIx)
  }
  if svPairs == 0 { return false }
  if svDstOfKind(scalarListElemKind(recvIx, fnIx)) < 0 { return false }
  storesIndex(condIx, fnIx) || storesIndex(bodyIx, fnIx)
}

// Whether the list `recvIx` reads may be a record-list view (D3041): a union-box list in a module
// that builds one.
function rvRecvMayView(recvIx: i32, fnIx: i32): boolean {
  if rvSrcSlot.length == 0 || !exprRefArray(recvIx, fnIx) { return false }
  rvMayView(refListSlotOfExpr(recvIx, fnIx))
}

// Push whether the list in local `wL` is a record-list view: one `ref.test` per view type.
function rvTestView(wL: i32) {
  let p = 0
  while p < rvViewTy.length {
    fbLocalGet(wL)
    fbRefTest(rvViewTy[p])
    if p > 0 {
      fbI32Bin(114) // 0x72 i32.or
    }
    p = p + 1
  }
  if rvViewTy.length == 0 { fbI32Const(0) }
  0
}

// The element read of a union-box list at ref-list row `rslot` that may be a view, with the list
// and the index on the stack: a view boxes the element out of its source, any other list reads its
// backing. Leaves the backing's own `(ref null $uBox)`.
function emitRvIndexRead(rslot: i32) {
  const wL = listIdxWrapSlot("ref", rslot)
  fbLocalSet(listIdxScratchBase)
  fbLocalSet(wL)
  rvTestView(wL)
  fbIfRefNul(uBoxIdx, true)
  fbLocalGet(wL)
  fbLocalGet(listIdxScratchBase)
  fbCall(gHelpRvGet)
  fbElse()
  fbLocalGet(wL)
  fbLocalGet(listIdxScratchBase)
  emitListIdxGuard(wL, rlWrapIdx[rslot])
  fbArrayGet(rlBackIdx[rslot])
  fbEnd()
  0
}

// Build a view of the record list on the stack, at source row `srcSlot` (D3041): a snapshot the
// sync helper fills, beside the list itself. False where the row has no view type.
function rvEmitView(srcSlot: i32): boolean {
  if srcSlot < 0 || srcSlot >= rlTwin.length || rvUnionSlot < 0 { return false }
  const p = rvPairOf(rlTwin[srcSlot], rlWidenVariantOf(srcSlot, rvUnionSlot))
  if p < 0 || rvUnionSlot >= rlBackIdx.length { return false }
  const sL = widenSrcWrapSlot(srcSlot)
  fbLocalSet(sL)
  fbI32Const(0)
  fbArrayNewDefault(rlBackIdx[rvUnionSlot])
  fbI32Const(0)
  fbI32Const(0)
  fbLocalGet(sL)
  fbRefAsNonNull()
  fbStructNew(rvViewTy[p])
  fbCall(gHelpRvSync)
  true
}

// `emitClampIdx`'s dual over plain wasm i32 LOCALS (not the string-op frame): emit
// `clamp(idx, len)` reading `idx` from local `idxL`, `len` from `lenL`, leaving the
// clamped value on the stack. Same JS slice semantics (`idx < 0 ? max(len+idx, 0) :
// min(idx, len)`) built from `select`.
function emitClampLocal(_body: u8[], idxL: i32, lenL: i32) {
  // negCase = max(len+idx, 0) = select( len+idx, 0, (len+idx) > 0 )
  fbLocalGet(lenL)
  fbLocalGet(idxL)
  fbI32Bin(106) // i32.add → (len+idx)  [a]
  fbI32Const(0) // [b]
  fbLocalGet(lenL)
  fbLocalGet(idxL)
  fbI32Bin(106)
  fbI32Const(0)
  fbI32Bin(74)  // 0x4a i32.gt_s → (len+idx) > 0  [cond]
  fbSelect()    // → negCase
  // nonNegCase = min(idx, len) = select( idx, len, idx < len )
  fbLocalGet(idxL)
  fbLocalGet(lenL)
  fbLocalGet(idxL)
  fbLocalGet(lenL)
  fbI32Bin(72) // 0x48 i32.lt_s → idx < len  [cond]
  fbSelect() // → nonNegCase
  // result = select( negCase, nonNegCase, idx < 0 )
  fbLocalGet(idxL)
  fbI32Const(0)
  fbI32Bin(72) // 0x48 i32.lt_s → idx < 0
  fbSelect() // → clamped
  0
}

// The wrapper heap-type index the nullable-collection cell at `exprIx` holds: >= 0 the
// wrapper's heap type; -2 a nullable collection whose wrapper this emit cannot name (an
// index-needing lowering must decline, but the recover below still claims it); -1 not a
// nullable collection. One home so a nullable-test and a wrapper consumer cannot disagree.
function nulCollWrapHeap(exprIx: i32, fnIx: i32) {
  if exprNullableList(exprIx, fnIx) { return lTypeIdx }
  const nsk = exprNulScalarListKind(exprIx, fnIx)
  if nsk != null { return nulScalarListWrapHeap(nsk) }
  if exprNullableRefArray(exprIx, fnIx) {
    const s = refListSlotOfExpr(exprIx, fnIx)
    if s >= 0 && s < rlWrapIdx.length { return rlWrapIdx[s] }
    return -2
  }
  -1
}

// True when `exprIx` names a narrowed nullable collection whose cell still holds a
// `(ref null $wrap)` — every rep a list/map operation must `ref.as_non_null` before the
// wrapper `struct.get`. The read dual of `emitNulIsNullTest`'s niche disjunction, so a rep
// the null test claims but this does not would be check-clean invalid wasm, never a diagnostic.
function nulRecvNeedsRecover(exprIx: i32, fnIx: i32) {
  nulCollWrapHeap(exprIx, fnIx) != -1
}

// True when an element read out of list `exprIx` yields a rep that legitimately holds
// null, so the read must stay `(ref null $elem)` rather than take a trapping
// `ref.as_non_null`. Asked by the indexed read and the `.map`/`.filter` element step, so a
// callback's declared param valtype and the value handed to it agree.
function listElemStaysNullable(exprIx: i32, fnIx: i32) {
  if exprNulStrArray(exprIx, fnIx) { return true }
  if exprRefArray(exprIx, fnIx) {
    const s = refListSlotOfExpr(exprIx, fnIx)
    if s >= 0 && s < rlElemNullable.length { return rlElemNullable[s] == 1 }
  }
  false
}

// Lower an array `xs.slice(start, end?)` onto `body`, leaving a new list wrapper of the
// same element kind over the half-open clamped range `[start, end)` (JS semantics). Rides
// the `.map`/`.filter` scratch frame (`srcL`/`dstL` plus four i32 temps), evaluating the
// receiver once into `srcL`; works across i32/boolean, f64, ref and string lists.
function emitArrSlice(body: u8[], callIx: i32, fnIx: i32, ec: ExpCtx) {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Member {
      const recvK = mfRecvKindOf(callee.memObj, fnIx)
      if recvK == null {
        return emitFail("emitProgram: .slice receiver is not a supported list")
      }
      let srcSlot = -1
      if recvK == "ref" { srcSlot = refListSlotOfExpr(callee.memObj, fnIx) }
      // The element kind's wrapper + backing heap types.
      let wrap = lTypeIdx
      let back = aTypeIdx
      if recvK == "f64" {
        if !fa64Used {
          return emitFail(
            "emitProgram: .slice over f64[] but f64 list type not collected",
          )
        }
        wrap = fl64TypeIdx
        back = fa64TypeIdx
      } else if recvK == "i64" {
        if !ia64Used {
          return emitFail(
            "emitProgram: .slice over i64[] but i64 list type not collected",
          )
        }
        wrap = il64TypeIdx
        back = ia64TypeIdx
      } else if recvK == "f32" {
        if !fa32Used {
          return emitFail(
            "emitProgram: .slice over f32[] but f32 list type not collected",
          )
        }
        wrap = fl32TypeIdx
        back = fa32TypeIdx
      } else if recvK == "ref" {
        if !rlUsed {
          return emitFail(
            "emitProgram: .slice over a ref list but ref list type not collected",
          )
        }
        if srcSlot < 0 { return refListRowRefused(callee.memObj) }
        wrap = rlWrapIdx[srcSlot]
        back = rlBackIdx[srcSlot]
      } else if recvK == "str" {
        if !slUsed {
          return emitFail(
            "emitProgram: .slice over string[] but string list type not collected",
          )
        }
        wrap = mkListIdx
        back = mkArrIdx
      } else if recvK == "u8" {
        // the packed byte list (D1141): a `(array (mut i8))` backing under the `$bl8`
        // wrapper, the arm this ladder needs since `mfRecvKindOf` would otherwise answer
        // `"i32"` for a `u8[]` receiver and mint the new list over the wrong 4-byte
        // backing. `array.copy` below is i8-to-i8, so the elements survive the copy.
        if !ba8Used {
          return emitFail(
            "emitProgram: .slice over u8[] but the packed byte list type not collected",
          )
        }
        wrap = bl8TypeIdx
        back = ba8TypeIdx
      } else if !lUsed || !aUsed {
        return emitFail("emitProgram: .slice but list type not collected")
      }
      const srcL = mfSrcLocalFor(recvK, srcSlot)
      const dstL = mfDstLocalFor(recvK, srcSlot)
      if !fnUsesMapFilter || srcL < 0 || dstL < 0 {
        return emitFail("emitProgram: .slice scratch frame not reserved")
      }
      // The `.map`/`.filter` frame's first 3 slots are i32 (i, n, j); slot +3 is a
      // closure ref. So slice has THREE i32 temps: `startL`, `endL`, and `auxL` which
      // holds the length during clamping then is reused for the out length.
      const startL = mfScratchBase + 0
      const endL = mfScratchBase + 1
      const auxL = mfScratchBase + 2
      // src = <receiver>, evaluated ONCE. A NARROWED nullable list recovers non-null at
      // EVERY element kind (`srcL` is declared non-null and `struct.get wrap` demands it),
      // not just the i32 one — see `nulRecvNeedsRecover`.
      if emitExpr(body, callee.memObj, fnIx, ec) < 0 { return -1 }
      if nulRecvNeedsRecover(callee.memObj, fnIx) { fbRefAsNonNull() }
      svSyncRecv(callee.memObj, fnIx)
      // The receiver and both bounds reach the stack before the frame is written: the frame
      // is shared, so a slice, `.map` or `.filter` in an argument would overwrite it (D2332).
      if emitExpr(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
      if c.callArgs.length == 2 {
        if emitExpr(body, c.callArgs[1], fnIx, ec) < 0 { return -1 }
        fbLocalSet(endL)
      }
      fbLocalSet(startL)
      fbLocalSet(srcL)
      // auxL = src.len (the wrapper's logical length, field 1)
      fbLocalGet(srcL)
      fbStructGet(wrap, 1)
      fbLocalSet(auxL)
      // start = clamp(rawStart, len)
      emitClampLocal(body, startL, auxL)
      fbLocalSet(startL)
      // end = clamp(rawEnd, len), or len when omitted (the 1-arg form slices to the end)
      if c.callArgs.length == 2 {
        emitClampLocal(body, endL, auxL)
        fbLocalSet(endL)
      } else {
        fbLocalGet(auxL)
        fbLocalSet(endL)
      }
      // auxL (len now dead) = outLen = max(end - start, 0) = select(end-start, 0, end>start)
      fbLocalGet(endL)
      fbLocalGet(startL)
      fbI32Bin(107) // i32.sub → end - start  [a]
      fbI32Const(0) // [b]
      fbLocalGet(endL)
      fbLocalGet(startL)
      fbI32Bin(74)  // 0x4a i32.gt_s → end > start  [cond]
      fbSelect()
      fbLocalSet(auxL)
      // dst backing = array.new_default <back> outLen
      fbLocalGet(auxL)
      fbArrayNewDefault(back)
      fbLocalSet(dstL)
      // result wrapper = struct.new <wrap> (dstBacking, outLen, outLen) — pushed FIRST so
      // it remains on the stack after the trailing `array.copy` consumes its own operands.
      fbLocalGet(dstL)
      fbLocalGet(auxL)
      fbLocalGet(auxL)
      fbStructNew(wrap)
      // array.copy dst 0 src.backing start outLen
      fbLocalGet(dstL)        // dest backing
      fbI32Const(0)           // dest offset
      fbLocalGet(srcL)
      fbStructGet(wrap, 0)    // src backing
      fbLocalGet(startL)      // src offset
      fbLocalGet(auxL)        // count
      fbArrayCopy(back, back) // array.copy (dest type, src type)
      // The result wrapper from `struct.new` above is the value left on the stack.
      return 0
    }
    return emitFail("emitProgram: .slice receiver is not a member access")
  }
  emitFail("emitProgram: expected an array slice call")
}

// Push `elem(i)` — `src.backing[i]` — onto the stack (`ref.as_non_null` for a ref
// element, surfacing the non-null struct/union box).
function emitMfElem(
  _body: u8[],
  srcL: i32,
  iL: i32,
  srcWrap: i32,
  srcBack: i32,
  srcElemRef: boolean,
) {
  if mfSvDst >= 0 && !srcElemRef {
    fbLocalGet(srcL)
    fbLocalGet(iL)
    fbCall(gHelpSvGet[mfSvDst])
    return 0
  }
  if mfRv && srcElemRef {
    fbLocalGet(srcL)
    fbLocalGet(iL)
    fbCall(gHelpRvGet)
    if mfSrcSlot >= 0 { return emitStaleBoxRetag(mfSrcSlot, -1) }
    return 0
  }
  fbLocalGet(srcL)
  fbStructGet(srcWrap, 0) // field 0: backing
  fbLocalGet(iL)
  fbArrayGet(srcBack)     // 0xfb 0x0b <srcBack>
  if srcElemRef {
    fbRefAsNonNull()
    if mfSrcSlot >= 0 { return emitStaleBoxRetag(mfSrcSlot, -1) }
  }
  0
}

// The ref-list slot `emitMfElem` reads from, for a read-side retag of its union boxes; -1 outside
// a `.map`/`.filter` loop or where the source is not a ref list.
let mfSrcSlot = -1
// The view destination `emitMfElem` reads each element through, as a callback's write to the
// source must be seen by the next read (D3028); -1 where the source cannot be a view.
let mfSvDst = -1
// Whether `emitMfElem`'s source may be a record-list view, read element by element (D3041).
let mfRv = false

// The members a union box read out of ref-list slot `slot` may hold beyond its own: each narrower
// scalar the slot's union holds only widened, which a list shared across a widening delivery
// still carries (D3026). "" when there is none, or no such delivery in the module.
function staleBoxFrom(slot: i32): string {
  if !listWidenRetagAny() { return "" }
  if slot < 0 || slot >= rlElemName.length || slot >= rlElemKindTbl.length {
    return ""
  }
  if rlElemKindTbl[slot] != RLK_UNION { return "" }
  const u = rlElemName[slot]
  const ua: string[] = []
  unionSetAtomsOf(u, ua)
  // Which of the value atoms (`valueAtomKind` 0..5) the union holds.
  const has = [false, false, false, false, false, false]
  let i = 0
  while i < ua.length {
    const ak = valueAtomKind(ua[i])
    if ak >= 0 && ak < has.length { has[ak] = true }
    i = i + 1
  }
  const hasI32 = has[0]
  const hasI64 = has[3]
  const hasF64 = has[4]
  const hasF32 = has[5]
  // A member no box of this module is built for cannot be carried.
  let from = ""
  if !hasI32 && (hasI64 || hasF64) && vbHeapIdxOfKind(0) >= 0 { from = "i32" }
  if !hasF32 && hasF64 && vbHeapIdxOfKind(5) >= 0 {
    if from == "" { from = "f32" } else { from = from + "|f32" }
  }
  from
}

// Rebuild the union box on the stack, read out of ref-list slot `slot`, under the member of its
// own union that a narrower member it still carries widens to (`staleBoxFrom`).
function emitStaleBoxRetag(slot: i32, at: i32) {
  if slot < 0 || slot >= rlElemName.length { return 0 }
  const from = staleBoxFrom(slot)
  if from == "" { return 0 }
  emitBoxAtomRetag(from, rlElemName[slot], at)
}

// Invoke the callback closure (stashed in local `cL`) on `elem(i)`: push its env
// (field 0), the element, its function index (field 1), then `call_indirect $fnsig`
// — leaving the callback's result on the stack. This runs once per element, which is
// why the id is an i32 load and not a funcref field's host libcall.
function emitMfInvoke(
  body: u8[],
  cL: i32,
  srcL: i32,
  iL: i32,
  srcWrap: i32,
  srcBack: i32,
  srcElemRef: boolean,
  sig: i32,
) {
  fbLocalGet(cL)
  fbStructGet(cloStructIdx, 0)     // env
  emitMfElem(body, srcL, iL, srcWrap, srcBack, srcElemRef)
  fbLocalGet(cL)
  fbStructGet(cloStructIdx, 1)     // the callee's wasm function index
  fbCallIndirect(sig, gFnTableIdx) // 0x11 <fnsig> <table>
  0
}

// `local.get L ; struct.get $lTy 1` — push the list's `len` field onto `body`.
function pushListLen(_body: u8[], lIdx: i32, lTy: i32) {
  fbLocalGet(lIdx)    // local.get
  fbStructGet(lTy, 1) // 0xfb 0x02 <lTy> field 1: len
  0
}

// `local.get L ; struct.get $lTy 2` — push the list's `cap` field onto `body`.
function pushListCap(_body: u8[], lIdx: i32, lTy: i32) {
  fbLocalGet(lIdx)    // local.get
  fbStructGet(lTy, 2) // 0xfb 0x02 <lTy> field 2: cap
  0
}

// `local.get L ; struct.get $lTy 0` — push the list's `backing` ref onto `body`.
function pushListBacking(_body: u8[], lIdx: i32, lTy: i32) {
  fbLocalGet(lIdx)    // local.get
  fbStructGet(lTy, 0) // 0xfb 0x02 <lTy> field 0: backing
  0
}

// Push the list ref a `for v in <iter>` iterates. A map iterable (`m.keys()`, `m.values()`,
// or the bare `for k in m`) reads the ordered list field off the map ref the caller already
// stashed (`mapRecv >= 0`): field 1 for a vals walk, field 0 for a keys walk — not
// re-emitted, so the walked list, tombstone `live[]` and loop bound stay on one object.
function emitForInList(
  body: u8[],
  iterIx: i32,
  fnIx: i32,
  mapRecv: i32,
  mwShape: i32,
  ec: ExpCtx,
) {
  if mapRecv >= 0 {
    cmSlot = mwShape
    if forInMapWalksVals(iterIx, fnIx) { return pushMapVals(body) }
    return pushMapKeys(body)
  }
  const prevLit = gForIterLit
  gForIterLit = unwrapParen(iterIx)
  const rc = emitExpr(body, iterIx, fnIx, ec)
  gForIterLit = prevLit
  if rc < 0 { return -1 }
  svSyncRecv(iterIx, fnIx)
}

// Whether function `fnIx` (at `fnStmts` position `fnPos` when inferred) declares a ref-list result.
function retResultIsRefList(fnIx: i32, fnPos: i32): boolean {
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    if fn.fnRet >= 0 { return vtKindOfType(fn.fnRet) == "reflist" }
  }
  fnPos >= 0 && fnPos < fRetKind.length && fRetKind[fnPos] == "reflist"
}

// Whether `retArg` is a `.map` call whose result list at function `fnIx` is not a ref list.
function retMapBuildsOtherList(retArg: i32, fnIx: i32): boolean {
  const rx = unwrapParen(retArg)
  if rx < 0 { return false }
  const c = nodeAt(rx)
  if !(c is Call) { return false }
  if c.callFn < 0 { return false }
  const m = nodeAt(c.callFn)
  if !(m is Member) { return false }
  if m.memProp != "map" { return false }
  const rk = mfResultKindOf(rx, fnIx)
  rk != null && rk != "ref"
}

// Whether `retArg` is a `null` value and function `fn`'s result is a non-null record or
// variant ref, which no `null` can ride (`fnPos` as `emitReturnValue` derives it).
function retNullIntoNonNullRef(retArg: i32, fnIx: i32, fnPos: i32): boolean {
  if (
    !(nodeAt(unwrapParen(retArg)) is NullLit)
    && !exprIsNulNone(retArg, fnIx)
  ) {
    return false
  }
  let rk: VKind | null = null
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    if fn.fnRet >= 0 { rk = vtKindOfType(fn.fnRet) }
    else if fnPos >= 0 && fnPos < fRetKind.length { rk = fRetKind[fnPos] }
  }
  rk == "struct" || rk == "variant"
}

// The variant row an un-annotated return of function `fnPos` builds: the collapse arm's, else
// the classified `variant` pair the functype's result is emitted from; -1 for any other return.
function inferredRetVariantIdx(fnPos: i32): i32 {
  const rvi = cbRetVariantIdx(fnPos)
  if rvi >= 0 { return rvi }
  if fnPos < 0 || fnPos >= fRetKind.length || fnPos >= fRetStructIdx.length {
    return -1
  }
  if fRetKind[fnPos] == "variant" { return fRetStructIdx[fnPos] }
  -1
}

// The narrowed-arm unbox's destination heap for a return of function `fn` (at `fnStmts`
// position `fnPos`, -1 when annotated), annotated or inferred; -1 when the result owes none.
function returnArmHeapOf(fn: FuncDecl, fnPos: i32): i32 {
  let retArmHeap = -1
  // A `: Circle | null` result's niche heap.
  if retNulVariantFlag(fn.fnRet) == 1 {
    const rnvi = nulVariantIndexOf(fn.fnRet)
    retArmHeap = armDestHeapOf("nulvariant", rnvi)
  }
  // The kind-9 twin: a `Dot | null` result over a DECLARED struct that is the arm's layout
  // twin. Same slot shape, same unbox owed, a struct row instead of a variant one.
  if retNulRefFlag(fn.fnRet) == 1 {
    retArmHeap = armDestHeapOf("nulstruct", retNulRefIndex(fn.fnRet))
  }
  // The plain-struct twin of the two annotated seeds: `function g(): A` returning a narrowed
  // arm of an inferred union, whose arm no seed above can find. The annotation's own rep and
  // slot are the destination, as the parameter's are at the call boundary (D1723).
  if retArmHeap < 0 && fn.fnRet >= 0 {
    retArmHeap = armDestHeapOf(
      vtKindOfType(fn.fnRet),
      annValtypeSlotOf(fn.fnRet),
    )
  }
  // Its un-annotated twin: the destination is then the classified return pair,
  // the same `(kind, slot)` the functype's result valtype is emitted from.
  if retArmHeap < 0 && fn.fnRet < 0 {
    if fnPos >= 0 && fnPos < fRetKind.length && fnPos < fRetStructIdx.length {
      retArmHeap = armDestHeapOf(fRetKind[fnPos], fRetStructIdx[fnPos])
    }
  }
  retArmHeap
}

// Whether the return value `retArg` of `fn` is a literal-union atom widened to its member
// string: a `string`, `string | null` or inline literal-union result, annotated or inferred.
function retStrWidenOf(
  fn: FuncDecl,
  retArg: i32,
  fnIx: i32,
  fnPos: i32,
): boolean {
  let retStrWiden = false
  // reads the annotation spelling, and canon softens a literal union to `string`, so a
  // `: K` return would answer true here too — `retLitUnion` above already claims it, so
  // this narrowing is inert for that case and only fires for a genuine `string` return.
  if nodeTyIsStringPrim(fn.fnRet) {
    if exprIsLitAtom(retArg, fnIx) { retStrWiden = true }
  }
  // the `string | null` niche return takes the same widen: its slot is the same string
  // ref with null permitted, and a widened member string is non-null, so it subtypes the
  // slot. Asked of the arena (`retNulStringFlag`) rather than the spelling test above, since the nullable form does not spell `"string"`.
  if retNulStringFlag(fn.fnRet) == 1 {
    if exprIsLitAtom(retArg, fnIx) { retStrWiden = true }
  }
  // an inline literal-union return (`: "circle" | "rect"`) takes the same widen: the
  // inline and named forms rep differently, so this needs its own arm. A named litunion
  // return (`: K`) reps as the interned atom and is claimed by `retLitUnion` above; an
  // un-named one reps as a string ref, so it must widen.
  if retLitUnionInline(fn.fnRet, fnIx) {
    if exprIsLitAtom(retArg, fnIx) { retStrWiden = true }
  }
  // A lone string literal result (`: "circle"`) is a string value, so an atom widens (D7445).
  if fn.fnRet >= 0 && tyIsBareStrLit(nodeTyAt(fn.fnRet, fnIx)) {
    if exprIsLitAtom(retArg, fnIx) { retStrWiden = true }
  }
  // the inferred-string dual: an un-annotated function whose checked return is `string`
  // widens an atom return value too; without it the raw i32 id flowed into the
  // string-ref functype result (invalid wasm).
  if fn.fnRet < 0 && cloRetIsString(fnPos) {
    if exprIsLitAtom(retArg, fnIx) { retStrWiden = true }
  }
  retStrWiden
}

// `emitReturnValue`'s plain arm: `retArg` emitted under a context carrying the result's
// nullable, map, list and literal-union seeds, then the nullable-string unbox and non-null
// recover the result owes. Returns 0, or -1 once failed.
function emitReturnPlainValue(
  body: u8[],
  retArg: i32,
  fnIx: i32,
  fnPos: i32,
  retNulBool: boolean,
  retNulString: boolean,
  retLitUnion: boolean,
  retNulLitUnion: boolean,
  ec: ExpCtx,
): i32 {
  const retCtx = expCtxHere(ec)
  if retNulBool { retCtx.nulBool = true }
  if retNulString { retCtx.nulString = true }
  if retLitUnion { retCtx.litUnion = 1 }
  if retNulLitUnion {
    retCtx.nulLitUnion = true
    retCtx.litUnion = 1
  }
  const retBoxToNulStr = retNulString && boxIsNulStrUnion(retArg, fnIx)
  if retLitUnion || retNulLitUnion {
    const noMem = retStrLitNoMember(retArg, retNulLitTexts(fnIx), fnIx)
    if noMem >= 0 {
      return emitFailAt(
        "emitProgram: a returned string cannot be shown to be a member of the literal union this instantiation's result is",
        noMem,
      )
    }
  }
  if (
    retNulLitUnion
    && !retNulString
    && nodeTyIsNulString(unwrapParen(retArg))
  ) {
    if (
      emitNulStrJoinAsAtom(body, retArg, retNulLitTexts(fnIx), retCtx, fnIx, ec)
      < 0
    ) {
      return -1
    }
  } else {
    if emitExprExpect(body, retArg, fnIx, retCtx) < 0 { return -1 }
  }
  if retBoxToNulStr { emitBoxToNulStr() }
  // a return is a kind-9 use site that never grew the recover: a nullable-struct/variant
  // read deliberately stays the raw `(ref null $S)` (`emitCapturedReadRecover`'s rule),
  // so returning it into a non-null struct result needs its own `ref.as_non_null` or the
  // functype promises `(ref $S)` over `(ref null $S)`. A no-op on an already-recovered value.
  if retNeedsNonNullRecover(retArg, fnIx, fnPos) { fbRefAsNonNull() }
  0
}

// The coerced arms of a return value, in priority order: an f32, f64 or i64 widen, a
// concrete variant (`retVi`), a union box (`retUNm`), or a literal-union atom widened to its
// string. The caller takes the plain arm when none applies. Returns 0 or -1.
function emitReturnCoercedValue(
  body: u8[],
  retArg: i32,
  fnIx: i32,
  retF32: boolean,
  retF64: boolean,
  retI64: boolean,
  retVi: i32,
  retUNm: string,
  retUTy: i32,
  retStrWiden: boolean,
  retNulString: boolean,
  retInferred: boolean,
  ec: ExpCtx,
): i32 {
  if retF32 {
    if emitExprAsF32(body, retArg, fnIx, ec) < 0 { return -1 }
  } else if retF64 {
    if emitExprAsF64(body, retArg, fnIx, ec) < 0 { return -1 }
  } else if retI64 {
    if emitExprAsI64(body, retArg, fnIx, ec) < 0 { return -1 }
  } else if retVi >= 0 {
    if emitVariantCoerce(body, retVi, retArg, fnIx, ec) < 0 { return -1 }
  } else if retUNm != "" {
    // `retUNm` is the union-BOX return (kind 4); a concrete variant `return s` (where `s: S`
    // and the return type is `C | S`) is boxed into the shared `{tag, payload}` rep here.
    if emitUnionBoxArg(body, retUNm, retUTy, retArg, fnIx, ec) < 0 { return -1 }
  } else if retStrWiden {
    // A literal-union atom returned from a `string`-typed function widens to its member string.
    // A `K | null` value needs a result that holds `null`, which an inferred one does not
    // declare here (D3198).
    if !retNulString && retInferred && nulAtomWidenTexts(retArg).length > 0 {
      return emitFailAt(
        "emitProgram: an inferred return of a nullable literal union has no string result to widen into",
        retArg,
      )
    }
    if emitAtomToStr(body, retArg, fnIx, ec) < 0 { return -1 }
  }
  0
}

// The widenings at a return boundary, after the value is emitted: a ref-list (`retRlSlot`) or
// scalar-list (`retSLKind`) covariance copy, and the narrowed-arm unbox to `retArmHeap` when
// no concrete variant (`retVi`) already served it.
function emitReturnBoundaryWidens(
  body: u8[],
  retArg: i32,
  fnIx: i32,
  retRlSlot: i32,
  retSLKind: VKind | null,
  retArmHeap: i32,
  retVi: i32,
) {
  // read-only covariance at the RETURN boundary (D791) — `return lv1` from a `(): Shape[]`.
  if retRlSlot >= 0 {
    emitRefListWidenSite(
      body,
      retArg,
      exprEmittedRefListSlot(retArg, fnIx),
      retRlSlot,
    )
  }
  // the scalar dual (D965) — `return e` from a `(): f64[]`. Read off the ANNOTATION for
  // the reason `retRlSlot` is: the functype's own source is what keeps the widened value
  // and the declared result in agreement by construction.
  if retSLKind != null {
    emitScalarListWidenSite(body, retArg, fnIx, retSLKind)
  }
  // the narrowed-arm unbox at the return boundary (D1031): the bare `: Circle` result is
  // already served through `emitVariantCoerce`; the niche results (`Circle | null`, `Dot |
  // null`) are the ones that took the box into a `(ref null $H)` slot. Read off the same
  // (kind, slot) pair the result valtype is written from.
  if retArmHeap >= 0 && retVi < 0 {
    if narrowedArmNeedsUnbox(retArg, fnIx) {
      emitNarrowedArmUnboxTo(retArmHeap, retArg, fnIx)
    }
  }
  0
}

// What a function's result asks of its `return` values: the numeric widens, the variant and
// union-box targets, the niche and map seeds, and the literal-union atom forms.
type RetFlags = {
  retF32: boolean,
  retF64: boolean,
  retI64: boolean,
  retNulBool: boolean,
  retNulString: boolean,
  retLitUnion: boolean,
  retNulLitUnion: boolean,
  // A literal-union atom returned as `string` widens to its member text.
  retStrWiden: boolean,
  retUNm: string,
  retUTy: i32,
  retVi: i32,
  retInferred: boolean,
}

// Seed `rf`'s variant index, numeric widens and union-box name from `fn`'s result, annotated
// or inferred. Returns -1 after refusing an inferred `f32[]` return, else 0.
function retFlagsSeedResult(
  fn: FuncDecl,
  retArg: i32,
  fnIx: i32,
  fnPos: i32,
  rf: RetFlags,
): i32 {
  rf.retInferred = fn.fnRet < 0
  // A concrete-variant return (annotated `: Cat`, or a collapsed inferred lambda).
  if retVariantFlag(fn.fnRet) == 1 { rf.retVi = annVariantRowOf(fn.fnRet) }
  // Every value an inferred arm return delivers, a join included, goes through
  // `emitVariantCoerce`, not only the literal the seed above reaches (D4639).
  if fn.fnRet < 0 {
    const rvi2 = inferredRetVariantIdx(fnPos)
    if rvi2 >= 0 { rf.retVi = rvi2 }
  }
  if retF32Flag(fn.fnRet) == 1 { rf.retF32 = true }
  if retF64Flag(fn.fnRet) == 1 { rf.retF64 = true }
  if retI64Flag(fn.fnRet) == 1 { rf.retI64 = true }
  // An UN-annotated return INFERRED as i64/f64 (the stored kind the A20 pass fills) widens
  // its value too — without this a `return 0` (an i32 literal) in a function whose other
  // branch returns a big i64 / an f64 expression stays `i32.const`, clashing with the i64/f64
  // functype result the inferred-return path declares (a soundness hole the checker accepts).
  if fn.fnRet < 0 {
    const rfe = fnPos
    if rfe >= 0 {
      if fRetKind[rfe] == "i64" { rf.retI64 = true }
      if fRetKind[rfe] == "f64" { rf.retF64 = true }
      // the f32 dual: an inferred f32 return whose body carries a float literal emits f64
      // unless forced, clashing with the f32 functype result (#614); a bare f32 `return x` needs no coercion.
      if fRetKind[rfe] == "f32" { rf.retF32 = true }
      // an inferred `f32[]` return has no producer, so the functype result stays at the
      // `"i32"` default while the emitted `return` pushes the f32 list's `(ref $array)` —
      // check-clean invalid wasm. Neither channel that fills the slot classifies this
      // shape; refuse loudly until it does. The annotated spelling already lowers.
      if fRetKind[rfe] == "i32" && exprF32Array(retArg, fnIx) {
        return emitFail(
          "emitProgram: an f32[] return must be annotated (`: f32[]`) — the inferred form has no result type",
        )
      }
    }
  }
  // a literal-union return reads as a union name but is an i32 atom — excluded from the
  // value-union box return, since `emitUnionBoxArg` would `struct.new` the member. A
  // nullable-closure return is the closure niche, not a value box, and takes the plain
  // arm; a nullable literal union is excluded on the same grounds.
  if retUnionFlag(fn.fnRet) == 1 {
    if (
      !nodeTyIsLitUnionAlias(fn.fnRet)
      && !nodeTyIsNulLitUnion(fn.fnRet)
      && nulCloFlag(fn.fnRet) != 1
    ) {
      rf.retUNm = tyNameOf(fn.fnRet)
      rf.retUTy = nodeTyIxOf(fn.fnRet)
    }
  }
  if fn.fnRet < 0 {
    const im = inferRetNameOf(inferRetFnKey(fnIx, fn.fnName))
    const imTy = inferRetTyIxOf(inferRetFnKey(fnIx, fn.fnName))
    const imLit = im != "" && imTy >= 0 && tyIsLitUnion(imTy)
    // a value union or registered struct-union inferred return is a union-box return
    // (kind 4): box each concrete-variant/value-atom `return` via `retUNm`. A litunion
    // alias name is excluded on the same grounds as the annotated arm above — it
    // registers as a union name but its value is the interned i32 atom, so boxing it would be wrong.
    if (isValueUnionName(im) || (isUNameAB(26, im, imTy) && !imLit)) {
      rf.retUNm = im
      rf.retUTy = imTy
    }
    // The inferred twins of the `nodeTyIsLitUnionAlias` / `nodeTyIsNulLitUnion` seeds
    // below: an un-annotated litunion return encodes a member literal as its atom id,
    // and its `| null` niche encodes a bare `null` as the `-1` sentinel.
    if imLit { rf.retLitUnion = true }
    if tyIsNullableLitUnion(imTy) { rf.retNulLitUnion = true }
  }
  0
}

// Seed `rf`'s niche, map, literal-union and string-widen flags from `fn`'s result.
function retFlagsSeedNiches(
  fn: FuncDecl,
  retArg: i32,
  fnIx: i32,
  fnPos: i32,
  rf: RetFlags,
) {
  if tyIsNulBool(fn.fnRet) { rf.retNulBool = true }
  if retNulStringFlag(fn.fnRet) == 1 { rf.retNulString = true }
  if nodeTyIsLitUnionAlias(fn.fnRet) { rf.retLitUnion = true }
  // A synthesized `: K` (a lambda pinned at its alias) is typed at the alias's copy, which
  // the index test above misses and the provenance-reading one does not (D3120).
  if fn.fnRet >= 0 && tyIsLitUnion(nodeTyAt(fn.fnRet, fnIx)) {
    rf.retLitUnion = true
  }
  // A `K | null` NICHE return: a `return null` lowers as the i32 sentinel `-1`, a `return "a"`
  // as its atom id — so seed BOTH the niche flag and `ec.litUnion`.
  if nodeTyIsNulLitUnion(fn.fnRet) { rf.retNulLitUnion = true }
  rf.retStrWiden = retStrWidenOf(fn, retArg, fnIx, fnPos)
  // An atom result keeps an atom value: a synthesized `: K` also reads as `string` to the
  // spelling tests above, which would widen the value the result holds as its id (D3160).
  if rf.retLitUnion && !retKindIsStr(fnPos) { rf.retStrWiden = false }
  // an inferred return whose value is an atom is left as an atom, and the call site
  // widens it (`fRetLitAtom`, from `criClassify`) — one flag, read by both passes.
  // Inferred niche nullable: seed from the A20 name so a `return null`/`return
  // <bool|string>` lowers as the sentinel/`ref.null` rep.
  if fn.fnRet < 0 {
    const nn = inferNicheNullByName(inferRetFnKey(fnIx, fn.fnName))
    if nn == "boolean|null" { rf.retNulBool = true }
    if nn == "string|null" { rf.retNulString = true }
  }
  // The inferred `string | null` twin of the `cloRetIsString` widen: an atom arm of a join
  // the checker typed `string | null` widens to its member text, `null` for the niche (D3336).
  if fn.fnRet < 0 && rf.retNulString && !rf.retLitUnion && !rf.retNulLitUnion {
    if exprIsLitAtom(retArg, fnIx) { rf.retStrWiden = true }
  }
}

// `emitReturnValue` past its seeds: classify the result of `fn` into the return's widen and
// niche flags, emit `retArg` under `ctx` through the arm they pick, then the list widenings
// and the narrowed-arm unbox to `retArmHeap`. Restores the caller's context; returns 0 or -1.
function emitReturnValueTail(
  body: u8[],
  retArg: i32,
  fnIx: i32,
  fnPos: i32,
  ctx: ExpCtx,
  retArmHeap: i32,
  retRlSlot: i32,
  retSLKind: VKind | null,
  ec: ExpCtx,
): i32 {
  const fn = nodeAt(fnIx)
  const rf: RetFlags = {
    retF32: false,
    retF64: false,
    retI64: false,
    retNulBool: false,
    retNulString: false,
    retLitUnion: false,
    retNulLitUnion: false,
    retStrWiden: false,
    retUNm: "",
    retUTy: -1,
    retVi: -1,
    retInferred: false,
  }
  if fn is FuncDecl {
    const seeded = retFlagsSeedResult(fn, retArg, fnIx, fnPos, rf)
    if seeded < 0 { return seeded }
    retFlagsSeedNiches(fn, retArg, fnIx, fnPos, rf)
  }
  const saved = expCtxHere(ec)
  expCtxApply(ctx, ec)
  if (
    rf.retF32
    || rf.retF64
    || rf.retI64
    || rf.retVi >= 0
    || rf.retUNm != ""
    || rf.retStrWiden
  ) {
    if (
      emitReturnCoercedValue(
        body,
        retArg,
        fnIx,
        rf.retF32,
        rf.retF64,
        rf.retI64,
        rf.retVi,
        rf.retUNm,
        rf.retUTy,
        rf.retStrWiden,
        rf.retNulString,
        rf.retInferred,
        ec,
      )
      < 0
    ) {
      return expCtxLeave(saved, -1, ec)
    }
  } else {
    if (
      emitReturnPlainValue(
        body,
        retArg,
        fnIx,
        fnPos,
        rf.retNulBool,
        rf.retNulString,
        rf.retLitUnion,
        rf.retNulLitUnion,
        ec,
      )
      < 0
    ) {
      return expCtxLeave(saved, -1, ec)
    }
  }
  emitReturnBoundaryWidens(
    body,
    retArg,
    fnIx,
    retRlSlot,
    retSLKind,
    retArmHeap,
    rf.retVi,
  )
  // The caller's context comes back whole: a seed a `return { … }` or `return Map()` leaves
  // unconsumed would otherwise type the next function's `null` (D2564).
  expCtxLeave(saved, 0, ec)
}

// Lower a return-value expression `retArg` for function `fnIx`: build the return's `ExpCtx`
// from the function's return type, emit through the matching helper under it, then restore
// the caller's context. Does not emit `return` itself — the caller appends `fbReturn` or
// leaves the value on the stack. Unifies explicit `return e` with implicit tail returns.
function emitReturnValue(body: u8[], retArg: i32, fnIx: i32, ec: ExpCtx) {
  const fn = nodeAt(fnIx)
  const ctx = expCtxHere(ec)
  // the heap a niche struct/variant result names (`Circle | null`, `Dot | null`) — the
  // narrowed-arm unbox's destination at this boundary (D1031). A bare `: Circle` result
  // needs none: `retVi` routes it through `emitVariantCoerce`.
  let retArmHeap = -1
  // one read, four uses: the inferred-return arms below want `fnStmtsPosOf`'s answer four
  // separate times, and taking it once is a hoist safe because nothing between the reads
  // writes `fnStmts`/`monoOrigNode` — both are written only by the collect/mono passes,
  // which finish before `emitCodeSection` begins. Stays behind `fn.fnRet < 0`, so an annotated return pays nothing.
  let fnPos = -1
  if fn is FuncDecl {
    if fn.fnRet < 0 { fnPos = fnStmtsPosOf(fnIx) }
  }
  // A `null` returned where the result is a non-null record or variant: a lambda's join of
  // parameter holes and `null` loses the null at the pin (D3506), so refuse, not mistype.
  if retNullIntoNonNullRef(retArg, fnIx, fnPos) {
    return emitFailAt(
      "emitProgram: a `null` is returned where this instantiation's result is a non-null record",
      retArg,
    )
  }
  // A union-list result over a `.map` whose callback this pin gives a niche or scalar result
  // builds a different list than the result declares; refused rather than mistyped.
  if retResultIsRefList(fnIx, fnPos) {
    if retMapBuildsOtherList(retArg, fnIx) {
      return emitFailAt(
        "emitProgram: a returned `.map` builds a list the function's result does not name at this instantiation",
        retArg,
      )
    }
  }
  if fn is FuncDecl { retArmHeap = returnArmHeapOf(fn, fnPos) }
  // the result's ref-list row, for the read-only-covariance widening (D791): the
  // annotation's row, or — for an un-annotated function — `criClassify`'s recorded
  // `("reflist", slot)`, the same pair `emitOneFuncType` reads for the result valtype.
  let retRlSlot = -1
  let retSLKind: VKind | null = null
  if fn is FuncDecl {
    if fn.fnRet >= 0 {
      retSLKind = vtKindOfType(fn.fnRet)
      if vtKindOfType(fn.fnRet) == "reflist" {
        retRlSlot = tyAnnRefListSlot(fn.fnRet)
      }
    } else if fnPos >= 0 && fnPos < fRetKind.length {
      if fRetKind[fnPos] == "reflist" && fnPos < fRetStructIdx.length {
        retRlSlot = fRetStructIdx[fnPos]
      }
    }
  }
  emitReturnValueTail(
    body,
    retArg,
    fnIx,
    fnPos,
    ctx,
    retArmHeap,
    retRlSlot,
    retSLKind,
    ec,
  )
}

// The member texts of the `K | null` result of function `fnIx`: its annotation's (a
// synthesized one in an instance), else its inferred return's; empty when neither has any.
function retNulLitTexts(fnIx: i32): string[] {
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    if fn.fnRet >= 0 { return nulLitMemberTexts(nodeTyIxOf(fn.fnRet)) }
    return nulLitMemberTexts(inferRetTyIxOf(inferRetFnKey(fnIx, fn.fnName)))
  }
  const none: string[] = []
  none
}

// A value join typed `string | null` delivered to a `K | null` atom result: each arm lowers in
// the atom context, so the result stays the i32 niche. A leaf the niche cannot hold — a string
// that is no member of `texts`, or a string value that is not an atom — refuses (D4173).
function emitNulStrJoinAsAtom(
  body: u8[],
  ix: i32,
  texts: string[],
  ctx: ExpCtx,
  fnIx: i32,
  ec: ExpCtx,
) {
  const u = unwrapParen(ix)
  if !ifJoinNarrowsPerArm(u) || texts.length == 0 {
    return emitFailAt(
      "emitProgram: a `string | null` value is returned where this instantiation's result is a nullable literal union",
      ix,
    )
  }
  const bad = nulAtomJoinMisfit(u, texts, fnIx, true)
  if bad >= 0 {
    return emitFailAt(
      "emitProgram: a returned string cannot be shown to be a member of the literal union this instantiation's result is",
      bad,
    )
  }
  const saved = expCtxHere(ec)
  expCtxApply(ctx, ec)
  const r = emitIfExprAs(body, u, fnIx, 127, ec)
  expCtxApply(saved, ec)
  r
}

// The string literal `ix` returns, itself or as a leaf of its join, that names none of the
// non-empty member list `texts`; -1 when there is none.
function retStrLitNoMember(ix: i32, texts: string[], fnIx: i32): i32 {
  if texts.length == 0 { return -1 }
  nulAtomJoinMisfit(ix, texts, fnIx, false)
}

// The first leaf value of the value join at `ix` that a literal-union atom with member texts
// `texts` cannot hold, or -1: a string literal naming no member, and when `strict`, any leaf
// that is neither `null`, a member literal nor an atom.
function nulAtomJoinMisfit(
  ix: i32,
  texts: string[],
  fnIx: i32,
  strict: boolean,
): i32 {
  const u = unwrapParen(ix)
  if u < 0 { return ix }
  const n = nodeAt(u)
  if n is IfStmt {
    if n.ifElse < 0 { return u }
    const t = nulAtomJoinMisfit(ifArmValueExpr(n.ifThen), texts, fnIx, strict)
    if t >= 0 { return t }
    if nodeAt(n.ifElse) is IfStmt {
      return nulAtomJoinMisfit(n.ifElse, texts, fnIx, strict)
    }
    return nulAtomJoinMisfit(ifArmValueExpr(n.ifElse), texts, fnIx, strict)
  }
  if n is MatchExpr {
    for b in n.matchBodies {
      let v = b
      if b >= 0 && nodeAt(b) is Block { v = ifArmValueExpr(b) }
      const m = nulAtomJoinMisfit(v, texts, fnIx, strict)
      if m >= 0 { return m }
    }
    return -1
  }
  if n is StrLit {
    let i = 0
    while i < texts.length {
      if strLexSameValue(quoteLex(texts[i]), n.strText) { return -1 }
      i = i + 1
    }
    return u
  }
  nulAtomLeafMisfit(u, fnIx, strict)
}

// `u` when the non-string leaf `u` misfits a literal-union atom under `strict` (neither `null`
// nor an atom), else -1.
function nulAtomLeafMisfit(u: i32, fnIx: i32, strict: boolean): i32 {
  if !strict || exprIsNullLike(u) || exprIsLitAtom(u, fnIx) { return -1 }
  u
}

// The exact bytes `fbStructNew(uBoxIdx)` writes, produced BY that encoder into a scratch
// buffer rather than re-derived — so the peephole's pattern cannot drift from the
// instruction it matches if the encoding (or `uBoxIdx`'s ULEB width) ever changes.
function unionBoxNewBytes() {
  const probe: u8[] = []
  const prev = wTarget(probe)
  fbStructNew(uBoxIdx)
  wTarget(prev)
  probe
}

// The exact bytes the armed tail-call cursor's call wrote, produced BY its encoder into a
// scratch buffer — the `unionBoxNewBytes` discipline, so the tail-call peephole's pattern
// cannot drift from the instruction it matches if an index's ULEB width changes.
function tailCallBytes() {
  const probe: u8[] = []
  const prev = wTarget(probe)
  if tailCallTable < 0 {
    fbCall(tailCallIdx)
  } else {
    fbCallIndirect(tailCallIdx, tailCallTable)
  }
  wTarget(prev)
  probe
}

// Whether the armed call's bytes end `back` bytes before the write cursor.
function tailCallEndsAt(back: i32) {
  const pat = tailCallBytes()
  const np = pat.length
  let i = 0
  while i < np {
    if wPeekBack(back + i) != pat[np - 1 - i] { return false }
    i = i + 1
  }
  true
}

// Unwrite the armed call, `back` bytes before the cursor, together with those bytes, and write
// its tail form in their place; disarms the cursor.
function tailCallRewrite(back: i32) {
  wDropBack(back + tailCallBytes().length)
  if tailCallTable < 0 {
    fbReturnCall(tailCallIdx) // 0x12 return_call
  } else {
    fbReturnCallIndirect(tailCallIdx, tailCallTable) // 0x13 return_call_indirect
  }
  tailCallEnd = -1
  tailCallIdx = -1
  0
}

// Rewrite a trailing call into its tail form, reporting whether it fired. A call whose bytes
// are still the last thing written when `return` terminates is in tail position by
// construction. Validity needs no result-type check, since a tail call imposes the same
// subtyping `return` already does; the one break is arity, so a void caller is declined here.
function emitTailCallRet(fnIx: i32) {
  if fbRetExtra.length > 0 { return emitLiftSelfTailRet(fnIx) }
  if tailCallIdx < 0 || tailCallEnd != wLen() { return false }
  if !tailCallEndsAt(0) { return false }
  const fnPos = fnStmtsPosOf(fnIx)
  if fnPos < 0 { return false }
  if fRetVoid[fnPos] == 1 { return false }
  tailCallRewrite(0)
  true
}

// The tail-call rewrite at a void function's exit: the explicit `return f()` and the trailing
// call statement, and the end of a tail-position `if` arm. Only a call to a void callee that
// hands nothing back qualifies, since `return` tolerates a leftover result and a tail call
// does not (D4654, D4655, D4680).
export function emitVoidTailCall(fnIx: i32) {
  if fbRetExtra.length > 0 { return false }
  if tailCallIdx < 0 || tailCallEnd != wLen() { return false }
  const fnPos = fnStmtsPosOf(fnIx)
  if fnPos < 0 || fnPos >= fRetVoid.length || fRetVoid[fnPos] != 1 {
    return false
  }
  if tailCallTable >= 0 {
    if !tailCallVoid || !tailCallEndsAt(0) { return false }
    tailCallRewrite(0)
    return true
  }
  const callee = tailCallIdx - gImports
  if callee < 0 || callee >= fRetVoid.length || fRetVoid[callee] != 1 {
    return false
  }
  if cloLiftWriteCount(callee) > 0 { return false }
  if !tailCallEndsAt(0) { return false }
  tailCallRewrite(0)
  true
}

// The tail-call rewrite in a lifted function that hands captures back: only a call to itself
// returns what the function itself would, so its write-back is dropped with it (D3664).
function emitLiftSelfTailRet(fnIx: i32) {
  if fnUsesUnionSink || tailCallIdx < 0 || tailCallEnd < 0 { return false }
  if tailCallTable >= 0 || liftWbEnd != wLen() { return false }
  const fnPos = fnStmtsPosOf(fnIx)
  if fnPos < 0 || tailCallIdx != gImports + fnPos { return false }
  const wb = wLen() - tailCallEnd
  if !tailCallEndsAt(wb) { return false }
  tailCallRewrite(wb)
  liftWbEnd = -1
  true
}

// Terminate a return in function-result position: the ordinary `return`, the tail-call
// rewrite when the result is a direct call, or — for a union-box-returning function
// taking the sink — the two `local.set`s and branch to the exit block. A peephole: when
// the last instruction written is `struct.new $uBox`, popping its operands into the exit locals is observably identical.
export function emitUnionRetSink(fnIx: i32) {
  if fnUsesUnionSink {
    if uBoxNewIsLast() {
      uBoxSinkToPair()
      fbBr(ctrlDepth) // 0x0c br to the function's single exit block
      uSinkFired = uSinkFired + 1
      return 0
    }
  }
  if emitTailCallRet(fnIx) { return 0 }
  fbReturn() // 0x0f return
  0
}

// the union-box peephole's match, shared by both sink positions: is the last instruction
// written the box's own `struct.new $uBox`, with its two operands still on the wasm stack
// in field order? Both conditions are load-bearing: the cursor alone admits nothing-written-
// since, the byte pattern alone admits a false match (an operand can spell any opcode).
function uBoxNewIsLast() {
  if uBoxNewEnd != wLen() { return false }
  const pat = unionBoxNewBytes()
  const np = pat.length
  let ok = true
  let i = 0
  while i < np {
    if wPeekBack(i) != pat[np - 1 - i] { ok = false }
    i = i + 1
  }
  ok
}

// Unwrite the matched `struct.new $uBox` and pop its two operands into the sink pair,
// restoring the wasm stack to before the box's operands pushed. Valid only immediately
// after `uBoxNewIsLast()` answers true.
function uBoxSinkToPair() {
  wDropBack(unionBoxNewBytes().length)
  fbLocalSet(unionSinkBase + 1) // the anyref payload — top of stack
  fbLocalSet(unionSinkBase) // the i32 tag — beneath it
  0
}

// `emitReturnExit` for a body's tail value statement, read at its arm-prelude locals as
// `emitStmt` reads a statement (D5331).
function emitTailReturnExit(body: u8[], stmtIx: i32, fnIx: i32, ec: ExpCtx) {
  const kept = stmtArmScopeOpen(stmtIx)
  const rc = emitReturnExit(body, stmtIx, fnIx, ec)
  if kept >= 0 { stmtArmScopeClose(kept) }
  rc
}

// Terminate a return: lower the value at `retArg` as function `fnIx`'s result and end the
// exit. Every exit in the emitter goes through here, so the value lowering and its
// terminator can never be paired differently. The one exception is a returned
// if-expression in a sinking function, split into per-arm exits below.
function emitReturnExit(body: u8[], retArg: i32, fnIx: i32, ec: ExpCtx) {
  if fnUsesUnionSink {
    const bare = nodeAt(unwrapParen(retArg))
    if bare is IfStmt {
      return emitUnionRetIfSink(body, unwrapParen(retArg), fnIx, ec)
    }
  }
  if emitReturnValue(body, retArg, fnIx, ec) < 0 { return -1 }
  emitUnionRetSink(fnIx)
  0
}

// `return if c { a } else { b }` in a union-box-returning function taking the sink.
// `emitUnionCoerce`'s value-typed `if` builds a box in each arm, so lowering it as a void
// statement-`if` whose arms each return is the identical program, meeting the sink's
// peephole per arm. The trailing `unreachable` restores the polymorphism a diverging `end` still needs.
function emitUnionRetIfSink(body: u8[], ifIx: i32, fnIx: i32, ec: ExpCtx) {
  // An `else if` chain is emitted along its spine, so its depth costs no stack (D1990): each
  // link leaves its frame open for the next, and the frames close innermost-first.
  const open: i32[] = []
  let cur = ifIx
  let rc = 1
  while rc == 1 {
    rc = emitUnionRetIfSinkLink(body, cur, fnIx, open, ec)
    if rc == 1 {
      const link = nodeAt(unwrapParen(cur))
      if link is IfStmt { cur = link.ifElse }
    }
  }
  closeIfChainFrames(open, rc, true)
}

// One link of `emitUnionRetIfSink`: 0 or -1 as that function returns, or 1 when the else is another `if`
// and this link's frame is left open (its else restore target pushed onto `open`).
function emitUnionRetIfSinkLink(
  body: u8[],
  ifIx: i32,
  fnIx: i32,
  open: i32[],
  ec: ExpCtx,
) {
  const s = nodeAt(ifIx)
  if s is IfStmt {
    if emitCondExpr(body, s.ifCond, fnIx, ec) < 0 { return -1 }
    fbIf(64) // 0x04 if, 0x40 void blocktype
    const savedTop = narrowTop
    const narrowed = setNarrowFromCond(s.ifCond, fnIx)
    const rcT = emitUnionRetIfArm(body, s.ifThen, fnIx, ec)
    if narrowed { restoreNarrow(savedTop) }
    if rcT < 0 { return -1 }
    fbElse() // 0x05 else
    // A VALUE union narrows to the COMPLEMENT set in the else-arm (see `emitStmt`).
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    let rc = 0
    if s.ifElse < 0 {
      // An else-less `if` yields `null` on its missing path (D2040): that path returns the
      // function's own null, exiting like every other arm.
      rc = emitNullForRet(body, fnIx)
      if rc >= 0 { rc = emitUnionRetSink(fnIx) }
    } else if nodeAt(s.ifElse) is IfStmt {
      if narrowedElse { open.push(savedElseTop) } else { open.push(-1) }
      return 1 // `else if`: the next link, which the caller emits into this open frame
    } else {
      rc = emitUnionRetIfArm(body, s.ifElse, fnIx, ec)
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
    if rc < 0 { return -1 }
    fbEnd() // 0x0b end
    fbUnreachable() // 0x00 — every arm exited; see the header
    return 0
  }
  emitFail("emitProgram: expected a union if-expression")
}

// One arm of a sunk returned if-expression: the arm's prelude, then its tail-value
// statement lowered as the function's return value and terminated like any other exit
// (`emitReturnExit`, which recurses when that value is itself an if-expression).
function emitUnionRetIfArm(body: u8[], blockIx: i32, fnIx: i32, ec: ExpCtx) {
  const b = nodeAt(blockIx)
  if b is Block {
    const tv = ifArmValueExpr(blockIx)
    if tv >= 0 {
      if tailIsValueOrNever(tv, fnIx) {
        if emitIfArmOpen(body, blockIx, fnIx, ec) < 0 {
          return emitIfArmClose(-1)
        }
        return emitIfArmClose(emitReturnExit(body, tv, fnIx, ec))
      }
      const inner = nodeAt(unwrapParen(tv))
      if inner is IfStmt {
        if emitIfArmOpen(body, blockIx, fnIx, ec) < 0 {
          return emitIfArmClose(-1)
        }
        return emitIfArmClose(emitReturnExit(body, tv, fnIx, ec))
      }
    }
    return ifArmNoValueFail("union if-expression arm", blockIx)
  }
  emitFail("emitProgram: union if-expression arm is not a block")
}

// Emit the `null` value of function `fnIx`'s nullable return rep, leaving it on the
// stack as the function's result (the fall-through path's implicit `return null`). Each
// arm mirrors the `NullLit` lowering for that rep; an unsupported rep fails loudly.
export function emitNullForRet(_body: u8[], fnIx: i32) {
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return emitFail("emitNullForRet: not a function") }
  const r = fn.fnRet
  if tyIsNulBool(r) {
    fbI32Const(2)
    return 0
  }
  if retNulStringFlag(r) == 1 {
    fbRefNull(sTypeIdx)
    return 0
  }
  if retNulRefFlag(r) == 1 {
    const rsi = retNulRefIndex(r)
    if rsi >= 0 && rsi < sHeapIdx.length {
      fbRefNull(sHeapIdx[rsi])
      return 0
    }
  }
  if retNulMapFlag(r) == 1 {
    fbRefNull(mapTypeIdxOf(mapAnnShape(r))) // the nullable map struct
    return 0
  }
  // A record that is also a union's member is that member's variant struct, nullable.
  if retNulVariantFlag(r) == 1 {
    const nvi = nulVariantIndexOf(r)
    if nvi >= 0 && nvi < uVarHeap.length {
      fbRefNull(uVarHeap[nvi])
      return 0
    }
  }
  if retNulListFlag(r) == 1 {
    fbRefNull(lTypeIdx)
    return 0
  }
  // A distinct-backing nullable scalar list (`i64[] | null`, `string[] | null`): the leaf
  // list's own wrapper, the heap a `return null` of the same function names.
  const nslKind = nulScalarListKindOfNode(r)
  if nslKind != null {
    const nslHeap = nulScalarListWrapHeap(nslKind)
    if nslHeap >= 0 {
      fbRefNull(nslHeap)
      return 0
    }
  }
  // A nullable ref-array return (`<ref-array> | null`, kind 18): the niche `ref.null $wrapper` over
  // the inner ref-list element wrapper (`tyAnnRefListSlot` strips the `| null` to resolve the slot).
  if retNulRefArrFlag(r) == 1 {
    const rls = tyAnnRefListSlot(r)
    if rls >= 0 && rls < rlWrapIdx.length {
      fbRefNull(rlWrapIdx[rls])
      return 0
    }
  }
  // A nullable-closure return (`((i32) => i32) | null`): the niche `ref.null $cloStruct`.
  if nulCloFlag(r) == 1 {
    fbRefNull(cloStructIdx)
    return 0
  }
  if fnRetIsNulAtom(fnIx) {
    fbI32Const(-1) // the nullable atom's null sentinel
    return 0
  }
  // Value-union box (annotated `i32 | null`, or an inferred return widened to it): the
  // null-tagged box `{ tag: null, payload: ref.null }` — identical to `emitUnionCoerce`'s
  // bare-`null` path.
  let isU = false
  if retUnionFlag(r) == 1 { isU = true }
  if r < 0 {
    const inm = inferRetNameOf(inferRetFnKey(fnIx, fn.fnName))
    if (
      isValueUnionOfSet(
        msSetOfNameTy(inm, inferRetTyIxOf(inferRetFnKey(fnIx, fn.fnName))),
        inm,
      )
    ) {
      isU = true
    }
  }
  if isU {
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone() // payload slot unread under the null tag
    fbStructNew(uBoxIdx)
    return 0
  }
  // Inferred NICHE nullable (un-annotated `boolean | null` / `string | null`): same null
  // rep as the annotated niche, recognized by name (no `fn.fnRet` node to read).
  if r < 0 {
    const nn = inferNicheNullByName(inferRetFnKey(fnIx, fn.fnName))
    if nn == "boolean|null" {
      fbI32Const(2)
      return 0
    }
    if nn == "string|null" {
      fbRefNull(sTypeIdx)
      return 0
    }
  }
  emitFail("emitNullForRet: unsupported nullable return rep")
}

// Lower a single statement at `stmtIx` onto `body`, resolving identifiers/params
// against function `fnIx`. Returns 0, or -1 (via `emitFail`) on an unsupported shape.
export function emitStmt(body: u8[], stmtIx: i32, fnIx: i32, ec: ExpCtx) {
  if !exprArmLocalsAny { return emitStmtGo(body, stmtIx, fnIx, ec) }
  const kept = stmtArmScopeOpen(stmtIx)
  const rc = emitStmtGo(body, stmtIx, fnIx, ec)
  if kept >= 0 { stmtArmScopeClose(kept) }
  rc
}

function emitStmtGo(body: u8[], stmtIx: i32, fnIx: i32, ec: ExpCtx) {
  // stop after a recorded failure: `emitFail` banks the first message and returns -1, but
  // does not halt the pass, so a caller that drops the -1 keeps emitting over invalidated
  // state — the next unguarded parallel-table read then traps the compiler before the
  // diagnostic prints. Checking the flag at the two recursion roots makes it terminal.
  if emitFailed { return -1 }
  if stmtIx < 0 { return emitFail("emitProgram: missing statement") }
  const s = nodeAt(stmtIx)
  if s is FuncDecl {
    // a nested function declaration statement (`function add(x) x + n`) is lifted to a
    // top-level wasm function by `collectFns`, so it emits no inline code here — just a
    // no-op in its enclosing body. Its name resolves as a closure value when referenced; a
    // cached env is dropped here, so each execution of the declaration is a new function value.
    let ck = -1
    if envCacheFes.length > 0 { ck = envCacheSlotOf(fnStmtsPosOf(stmtIx)) }
    if ck >= 0 {
      fbRefNull(envCacheTys[ck - envCacheBase])
      fbLocalSet(ck)
    }
    return 0
  }
  // D1045 — a body-scoped `type` declaration, one statement over: the parser hoisted the
  // node into `progStmts`, so every registry needing it comes from the top-level walk, and
  // the declaration emits no inline code here. Not a value, so `stmtIsTailValue` never claims it either.
  if s is TypeDecl { return 0 }
  if s is UnionDecl { return 0 }
  if s is LetDecl { return emitLetDeclStmt(body, s, stmtIx, fnIx, ec) }
  if s is BinExpr {
    // A bare `BinExpr` statement is an assignment (`x = <expr>`); any OTHER operator
    // in statement position is a DISCARDED value (`1 + 1` as a tail statement of a
    // void function) — evaluate it for effect, then `drop` the value it leaves.
    if s.binOp == "=" { return emitAssign(body, stmtIx, fnIx, ec) }
    if emitExpr(body, stmtIx, fnIx, ec) < 0 { return -1 }
    fbDrop() // 0x1a drop
    return 0
  }
  if s is Unary {
    // postfix `x++`/`x--` in statement position: the old-value result is discarded, so
    // emit just the inner increment assignment — the same bytes a plain assignment
    // statement writes. A prefix unary leaves a value instead, falling through below.
    if s.unOp == "p+" || s.unOp == "p-" {
      return emitAssign(body, s.unArg, fnIx, ec)
    }
  }
  if s is Call { return emitCallStmt(body, s, stmtIx, fnIx, ec) }
  // A parenthesised call statement is that call statement: a void one leaves no value for the
  // discard below to drop (D2637).
  if s is Paren {
    if nodeAt(unwrapParen(stmtIx)) is Call {
      return emitStmt(body, unwrapParen(stmtIx), fnIx, ec)
    }
  }
  if s is RetStmt {
    if s.retArg < 0 {
      // a bare `return` is the ordinary early exit of a void function. `fRetVoid` is read
      // position-keyed through `fnStmtsPosOf`, the channel `emitFuncCode`'s void fall-through reads.
      const rPos = fnStmtsPosOf(fnIx)
      if rPos >= 0 {
        if fRetVoid[rPos] == 1 {
          // The checker splits `return f()` here into `f()` and this bare `return`.
          if emitVoidTailCall(fnIx) { return 0 }
          fbReturn() // 0x0f return
          return 0
        }
      }
      // The floor, and no check-clean program reaches it: the checker pins a body holding a
      // bare `return` to void, at the annotated spelling and the inferred one alike, so a
      // non-void function carrying one is refused before emit (D1600).
      return emitFail(
        "emitProgram: a bare `return` in a function the emitter classified non-void — the checker owed this diagnosis",
      )
    }
    // void-context discard, the explicit-return leg: a `return <expr>` inside a void
    // function evaluates the expression for effect and returns nothing. Reached only by a
    // `synthVoidTwins` twin lowering a checker-valid non-void body under a void functype.
    // Routed through `emitStmt` so the statement ladder decides per shape what is on the stack.
    const rvPos = fnStmtsPosOf(fnIx)
    if rvPos >= 0 && rvPos < fRetVoid.length {
      if fRetVoid[rvPos] == 1 {
        if emitStmt(body, s.retArg, fnIx, ec) < 0 { return -1 }
        if emitVoidTailCall(fnIx) { return 0 }
        fbReturn() // 0x0f return (void: nothing pushed)
        return 0
      }
    }
    // Seed the return context + emit the value (struct / list / union / nullable /
    // widening) and terminate the exit, via the shared helper.
    return emitReturnExit(body, s.retArg, fnIx, ec)
  }
  if s is IfStmt { return emitIfStmtStmt(body, stmtIx, fnIx, ec) }
  if s is WhileStmt { return emitWhileStmtStmt(body, s, stmtIx, fnIx, ec) }
  if s is ForRange { return emitForRangeStmt(body, s, stmtIx, fnIx, ec) }
  if s is ForIn { return emitForInStmt(body, s, stmtIx, fnIx, ec) }
  if s is BreakStmt { return emitBreakStmtStmt(body, s, stmtIx, fnIx) }
  if s is ContinueStmt { return emitContinueStmtStmt(body, s, stmtIx, fnIx) }
  // a bare value expression in non-tail statement position is a discarded value: evaluate
  // it for effect, then drop what it leaves — the same rule the `BinExpr` arm above applies
  // to `1 + 1`, reached through `stmtIsTailValue`. The tail statement of a body never
  // arrives here: `emitFuncBody`/`emitStmtTail` route a tail value to `emitReturnExit` first.
  if stmtIsBareFnName(stmtIx) { return 0 }
  if stmtIsTailValue(stmtIx, fnIx) {
    if emitExpr(body, stmtIx, fnIx, ec) < 0 { return -1 }
    fbDrop() // 0x1a drop
    return 0
  }
  emitFail("emitProgram: unsupported statement in body")
}

// Whether discarded statement `stmtIx` is a function's bare name, through parentheses: its
// closure has no effect, so it emits nothing and needs no closure type (D6980). A hole
// function's name counts only once the prune noted it inert, so a refused one still refuses (D6960).
function stmtIsBareFnName(stmtIx: i32): boolean {
  const x = unwrapParen(stmtIx)
  if x < 0 || !(nodeAt(x) is Ident) { return false }
  if i32ListHas(monoInertValues, x) { return true }
  const d = identDeclOf(x)
  if d < 0 || d >= P.nodes.length { return false }
  const f = nodeAt(d)
  if !(f is FuncDecl) { return false }
  for p in f.fnParams {
    const q = nodeAt(p)
    if q is Param && q.parType < 0 { return false }
  }
  true
}

function emitLetDeclStmt(
  body: u8[],
  s: LetDecl,
  stmtIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // `let x = <expr>` / `const x = <expr>`: emit the init, then store it into the local's
  // slot. This `LetDecl`'s slot is the next cursor position, not name-resolved (a name
  // lookup would hit an outer same-named binding still in scope here).
  if cboxIsWriteLet(s.letName) { stubWriteRhs = unwrapParen(s.letInit) }
  const slot = declSlotTake(stmtIx, 1)
  if slot < 0 || slot >= localIsRef.length {
    return emitFailAt(
      "emitProgram: a local declaration has no collected slot",
      stmtIx,
    )
  }
  let paramN = 0
  // The START function (`fnIx == -1`, top-level statements) has no params — and no
  // arena node to read, so the lookup must be guarded.
  if fnIx >= 0 {
    const fn = nodeAt(fnIx)
    if fn is FuncDecl { paramN = fn.fnParams.length + envSlotShift(fnIx) }
  }
  const idx = paramN + slot
  // A `const` bound to a lambda-lifted function holds no value: every use calls it directly.
  if (
    fnIx >= 0
    && s.letInit >= 0
    && cloLiftLetFe(fnStmtsPosOf(fnIx), stmtIx) >= 0
  ) {
    scopeBind(s.letName, slot)
    return 0
  }
  if s.letInit < 0 {
    // UNINITIALIZED scalar local (validated by `checkLocalI32`): nothing to store
    // — the wasm local's implicit zero-init covers the declaration; bind the name
    // so later reads/writes resolve to this slot.
    scopeBind(s.letName, slot)
    return 0
  }
  // value-flow monomorphization: a `const g = f` binding to a generic named function, used
  // only as a direct-call callee, is sound — `monomorphize` rewrote each `g(args)` to its
  // per-call instance, so the closure stored here is `call_ref`'d only at the pinned type.
  // Requires a pinning call site (`monoInstantiatedAny`); with none, the floor's loud reject applies instead.
  if fnIx >= 0 {
    const aliasFe = fieldValueFeOf(s.letInit)
    if fnHasUnannotatedParam(aliasFe) {
      if !criFnIsAnonLambda(aliasFe) {
        if monoInstantiatedAny(aliasFe) {
          const encl = nodeAt(fnIx)
          if encl is FuncDecl {
            if !nameUsedAsValueIn(s.letName, encl.fnBody) {
              if emitClosureValueCore(body, aliasFe, fnIx, ec) < 0 { return -1 }
              fbLocalSet(idx) // 0x21 local.set
              scopeBind(s.letName, slot)
              return 0
            }
          }
        }
      }
    }
  }
  // A never-filled null hole (`let x = null`) is the plain `null` type, whose value is
  // `ref.null none`, not a zero i32; a filled one is a `T | null` box and takes the
  // union-coerce path below. The initializer still runs, for its effects and exits (D3355).
  if letIsNulNone(stmtIx, fnIx) {
    if emitNulNoneBoxPayload(body, s.letInit, fnIx, ec) < 0 { return -1 }
    fbLocalSet(idx) // 0x21 local.set
    scopeBind(s.letName, slot)
    return 0
  }
  // Asked BEFORE the init ladder below: an init carrying its own `if` pushes and pops the
  // narrowing stack, and this boundary's question is about the value it receives. Consumed
  // beside the two widen sites at the very bottom (D1031). The second disjunct is the cell's
  // own question, so a cell typed at the arm cannot be reached without its unbox.
  const letArmOwed = narrowedArmNeedsUnbox(s.letInit, fnIx)
    || letInitTyIsNarrowedArm(stmtIx, fnIx)
    || letInitTyIsNarrowedNulArm(stmtIx, fnIx)
  // A bare-arm cell's init is delivered by `emitVariantCoerce`, which owns the unbox and the
  // niche recover both, so neither bottom step runs for it.
  const letArmCell = localIsRef[slot] == "variant"
  const ctx = letInitCtxOf(ec)
  // The init emits under `ctx`; every exit below restores the caller's context.
  const saved = expCtxHere(ec)
  expCtxApply(ctx, ec)
  // numeric widening at the binding boundary: an `: f64`/`: f32`/`: i64` slot coerces a
  // narrower init value; an i32-only binding keeps the bytes it had. A union-annotated
  // binding (kind 4) coerces a raw init into the box; an already-union init passes
  // through `emitUnionCoerce` unchanged.
  let letUNm = ""
  let letAnnNm = ""
  if s.letType >= 0 { letAnnNm = tyNameOf(s.letType) }
  // A filled null hole (`let x = null` + later `x = e`, A-infer-null) is its
  // inferred `T|null` value union — coerce the bare `null` init into the box.
  if (
    isUNameAnnAB(27, s.letType)
    && !nodeTyIsLitUnionAlias(s.letType)
    && !nodeTyIsNulLitUnion(s.letType)
  ) {
    // a literal union reads as a union name but is an i32 atom, not a value-union box, so
    // it must not take `emitUnionCoerce` (which would `struct.new` the member) — excluded
    // via the arena's `nodeTyIsLitUnionAlias`, which also catches the nullable form the
    // name test (`nameIsLitUnionType`) cannot see for a member set carrying `null`.
    letUNm = letAnnNm
  } else if !isUNameAnnAB(28, s.letType) {
    letUNm = nliNameOf(stmtIx)
  }
  if letUNm == "" && localIsRef[slot] == "union" {
    letUNm = letNulScalarBoxName(stmtIx, fnIx)
  }
  // a nullable/value-union if-expression init lowers by writing the binding's own local
  // in each arm of a void `if` — no value-typed-if blocktype needed, since the binding
  // local is the destination. The slot kind `collectLocals` chose is the authoritative
  // rep: kind 4 the value-union box, kind 16 a `string | null` ref, kind 17 a `boolean | null` niche i32.
  if exprIsIfStmt(s.letInit) {
    const lif = emitLetIfInit(body, s, slot, idx, letUNm, fnIx, ec)
    if lif <= 0 { return expCtxLeave(saved, lif, ec) }
  }
  if (
    emitLetInitValue(
      body,
      s,
      stmtIx,
      slot,
      localIsRef[slot],
      localStructIdx[slot],
      fnIx,
      letUNm,
      letAnnNm,
      letArmCell,
      ec,
    )
    < 0
  ) {
    return expCtxLeave(saved, -1, ec)
  }
  expCtxApply(saved, ec)
  emitLetDelivery(body, s, slot, fnIx, letArmOwed, letArmCell)
  fbLocalSet(idx) // 0x21 local.set
  // Bind `name → slot` in the current emit-time frame AFTER emitting the init (so the
  // init resolved any same-named OUTER binding), making this binding live for the rest
  // of the block — mirrors the collect pass so resolution matches slot allocation.
  scopeBind(s.letName, slot)
  emitListReserve(s, stmtIx, idx, slot, fnIx)
  return 0
}

// `emitLetDeclStmt`'s init step: emits `s`'s initializer for local `slot` (kind `slotKind`,
// struct `slotStruct`) by the cell's rep — a niche, a union box (`letUNm`), an arm cell, a wide
// scalar, a widened atom or the plain path. The caller applied the init context and restores it.
// Returns -1 on a failure, else 0.
function emitLetInitValue(
  body: u8[],
  s: LetDecl,
  stmtIx: i32,
  slot: i32,
  slotKind: VKind,
  slotStruct: i32,
  fnIx: i32,
  letUNm: string,
  letAnnNm: string,
  letArmCell: boolean,
  ec: ExpCtx,
) {
  if slotKind == "nulclosure" || isNulScalarListKind(slotKind) {
    // A nullable function value or distinct-backing scalar list: a niche nullable ref, not a
    // box, so it takes priority over the union-coerce path. A bare `null` is `ref.null none`
    // and a value is the leaf ref, each of which subtypes the slot.
    const nslCtx = expCtxHere(ec)
    if emitExprExpect(body, s.letInit, fnIx, nslCtx) < 0 { return -1 }
  } else if (slotKind == "union" && letNulMapReadUnionBox(stmtIx, fnIx)) {
    // A bare `const t = m[k]` read of a UNION-valued map (kind 2): the binding is the
    // established `A | B | null` box local — hit loads the stored box, miss synthesizes
    // the null-tagged box (`emitMapGetUnionBox`). The init is the Index the classifier
    // resolved; read its receiver/key here.
    const umr = nodeAt(unwrapParen(s.letInit))
    if umr is Index {
      if emitMapGetUnionBox(body, umr.idxArr, umr.idxIndex, fnIx, ec) < 0 {
        return -1
      }
    } else {
      return emitFail(
        "emitProgram: union-valued map read binding's init is not an index read",
      )
    }
  } else if letArmCell {
    // An arm cell takes the bare variant struct whatever builds it, as at assignment (D4639).
    if emitVariantCoerce(body, slotStruct, s.letInit, fnIx, ec) < 0 {
      return -1
    }
  } else if letUNm != "" {
    // The binding boundary is a box-typed destination, so an init that is one ARM of the union
    // boxes here exactly as an argument does (D1606) — `emitUnionCoerce` alone passes an arm
    // value raw, which fits only a variant cell, and a union annotation never types one.
    let letArmBoxed = 0
    if slotKind == "union" {
      letArmBoxed = emitUnionArmValueBox(body, s.letInit, fnIx, ec)
      if letArmBoxed < 0 { return -1 }
    }
    if letArmBoxed == 0 {
      // An inferred null-hole union (`nliNameOf`) is recorded by name alone, so it has no type.
      let letUTy = -1
      if s.letType >= 0 { letUTy = nodeTyIxOf(s.letType) }
      if emitUnionCoerce(body, letUNm, letUTy, s.letInit, fnIx, ec) < 0 {
        return -1
      }
    }
  } else if letIsF32(stmtIx) || letInfersF32(stmtIx, fnIx) {
    // `letIsF32` is annotation-only; `collectLocals` types the slot with `letIsF32 ||
    // letInfersF32`, so an un-annotated `const g = fv * 1.0` needs the same pair here —
    // else this ladder falls to the f64 arm, whose fallback over-claims a mixed
    // f32/float-literal init and stores an f64 into the f32 slot, invalid wasm.
    if emitExprAsF32(body, s.letInit, fnIx, ec) < 0 { return -1 }
  } else if letIsF64(stmtIx, fnIx) {
    if emitExprAsF64(body, s.letInit, fnIx, ec) < 0 { return -1 }
  } else if letIsI64(stmtIx, fnIx) {
    if emitExprAsI64(body, s.letInit, fnIx, ec) < 0 { return -1 }
  } else if (
    (letAnnNm == "string" || tyIsBareStrLit(nodeTyIxOf(s.letType)))
    && exprIsLitAtom(s.letInit, fnIx)
    && !localSlotIsLitAtom(slot)
  ) {
    // A literal-union atom initializing a `string` local widens to its member string. Not
    // where the SLOT is the atom: an inline literal-union annotation renders as `string`, so
    // the rendered name alone would widen into an atom cell (D1752).
    if emitAtomToStr(body, s.letInit, fnIx, ec) < 0 { return -1 }
  } else if letIsNulString(stmtIx, fnIx) && exprIsLitAtom(s.letInit, fnIx) {
    // a literal-union atom initializing a `string | null` binding widens to its member
    // string: the slot is the nullable string reference and the atom's rep is an i32 id.
    // The non-nullable form needs no arm: `collectLocals` classifies a non-nullable atom
    // init as an atom slot, so nothing widens at the init and each read widens instead.
    if emitStrValue(body, s.letInit, fnIx, ec) < 0 { return -1 }
  } else {
    if emitLetPlainInit(body, s, stmtIx, slot, fnIx, ec) < 0 { return -1 }
  }
  0
}

// The context a `let` emits its init under: the caller's, less a `K | null` niche, which is
// the binding's own (seeded on the plain path), never that of a join whose arm prelude this
// binding is (D5430).
function letInitCtxOf(ec: ExpCtx): ExpCtx {
  const ctx = expCtxHere(ec)
  ctx.nulLitUnion = false
  ctx
}

// A `let` whose init is an `if` over a nullable or value-union cell, written into local
// `idx` by each arm. Returns 0 once bound, 1 when the cell's rep takes no such lowering, and
// -1 on a failure.
function emitLetIfInit(
  body: u8[],
  s: LetDecl,
  slot: i32,
  idx: i32,
  letUNm: string,
  fnIx: i32,
  ec: ExpCtx,
) {
  const slotKind = localIsRef[slot]
  let nulRep = -1
  let nulNm = ""
  // The binding's union type: its annotation, else the joined `if` it is initialised by.
  let nulTy = nodeTyAt(s.letInit, fnIx)
  if s.letType >= 0 { nulTy = nodeTyIxOf(s.letType) }
  if slotKind == "union" {
    if letUNm != "" { nulNm = letUNm }
    else if s.letType >= 0 { nulNm = tyNameOf(s.letType) }
    // D969 — an un-annotated binding has no name to box with: with neither annotation
    // source, `nulNm` stayed "" and this arm declined, so the init fell to the generic
    // emit's scalar-ladder join blocktype over two ref arms — invalid wasm. The init's
    // own union name is asked last, so no annotated spelling changes.
    if nulNm == "" { nulNm = unionNameOfExpr(s.letInit, fnIx) }
    if nulNm != "" { nulRep = 0 }
  } else if slotKind == "nulstr" {
    nulRep = 1
  } else if slotKind == "nulbool" {
    nulRep = 2
  }
  if nulRep >= 0 {
    // the binding sink: with every arm writing the shared pair and ONE `struct.new`
    // after the `if`, the arms' construction sites collapse to that one — and the
    // pre-seed below goes with them, because the single store dominates every read.
    if nulRep == 0 && fnUsesUnionLetSink {
      if unionIfBindingAllBox(s.letInit, fnIx) {
        if (
          emitUnionIfBindingSink(body, s.letInit, idx, nulNm, nulTy, fnIx, ec)
          < 0
        ) {
          return -1
        }
        fbLocalGet(unionSinkBase)
        fbLocalGet(unionSinkBase + 1)
        fbStructNew(uBoxIdx) // the binding's ONE box
        fbLocalSet(idx)
        scopeBind(s.letName, slot)
        return 0
      }
    }
    // the value-union box local (kind 4) is a non-null `(ref $uBoxIdx)` — non-
    // defaultable, so the validator needs it definitely assigned before a void-`if`
    // merge; pre-seed the rep's null first. `string | null` is defaultable and needs none.
    if nulRep == 0 {
      if emitNulNullToLocal(body, idx, 0) < 0 { return -1 }
    }
    if (
      emitNullableIfBinding(
        body,
        s.letInit,
        idx,
        nulRep,
        nulNm,
        nulTy,
        fnIx,
        ec,
      )
      < 0
    ) {
      return -1
    }
    scopeBind(s.letName, slot)
    return 0
  }
  1
}

// A `let`'s init on the plain path, under its niche and atom seeds; a
// `const` used as a memory address takes the address fold. Returns -1 on a failure, else 0.
function emitLetPlainInit(
  body: u8[],
  s: LetDecl,
  stmtIx: i32,
  slot: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // The enclosing value's seeds come back after, since a binding in an if-arm prelude
  // precedes that arm's own value (D3352).
  const valCtx = expCtxHere(ec)
  // A NICHE `X | null` binding seeds its null rep for a bare `null` init (the table at
  // `emitNullLitNode`). Keyed on `letNulBool`/`letIsNulString` rather than the annotation
  // alone, so an INFERRED niche binding (`const r = f()` where `f` returns `boolean |
  // null`) seeds it too.
  valCtx.nulBool = letNulBool(stmtIx, fnIx)
  valCtx.nulString = letIsNulString(stmtIx, fnIx)
  if s.letType >= 0 {
    if nodeTyIsLitUnionAlias(s.letType) { valCtx.litUnion = 1 }
    // an atom-array annotation (`const xs: K[]`) — the let twin of `emitObj`'s
    // `sFieldIsLitUnionArray` arm: the value is the i32 list of atom ids, so the atom
    // context must reach the literal, paired with the `K[]` reject in `letIsStringArray`
    // so the slot and the literal build agree (#1852). A non-literal init is unaffected.
    if tyIsLitUnionArray(nodeTyIxOf(s.letType)) { valCtx.litUnion = 1 }
    // `K | null` is dual-natured — a member init is an atom id, only a `null` is the
    // sentinel — so seed BOTH, as the param-arg / return boundaries do.
    if nodeTyIsNulLitUnion(s.letType) {
      valCtx.litUnion = 1
      valCtx.nulLitUnion = true
    }
  } else if (
    narrowedNulLitBoxKey(s.letInit, fnIx) != ""
    || letNulLitUnion(stmtIx, fnIx)
  ) {
    // The un-annotated twin: the niche cell `letNulLitUnion` gave it converts the box (D3118).
    valCtx.litUnion = 1
    valCtx.nulLitUnion = true
  }
  // An atom cell takes its init as the atom, whatever rep the value is read in.
  if localSlotIsLitAtom(slot) { valCtx.litUnion = 1 }
  expCtxApply(valCtx, ec)
  // The declaration-time address fold: a `const p = K + bounded` later used as a memory
  // address needs its bounded part kept in its own scratch local — `const`-only, since a
  // `let` can be reassigned. The checks are `maFoldCandidateCount`'s own, in the same
  // order, so the two can never disagree about which declarations qualify.
  let mfK: i64 = -1
  if (
    fnIx >= 0
    && localIsRef[slot] == "i32"
    && s.letKw == "const"
    && mfShapeIsSum(s.letInit)
  ) {
    mfK = memConstFoldShapeK(s.letInit, fnIx)
  }
  if mfK >= 0 {
    if emitMemConstFoldLet(body, s.letInit, mfK, fnIx, stmtIx, ec) < 0 {
      return -1
    }
  } else if emitExpr(body, s.letInit, fnIx, ec) < 0 {
    return -1
  }
  0
}

// What a `let`'s init value owes its cell in local `slot` before the store: the ref-list and
// scalar-list widens, the narrowed-arm unbox, and the nullable-niche recover.
function emitLetDelivery(
  body: u8[],
  s: LetDecl,
  slot: i32,
  fnIx: i32,
  letArmOwed: boolean,
  letArmCell: boolean,
) {
  // read-only covariance at the BINDING boundary (D791): the value on the stack is a
  // ref list at one row and this binding's cell is another. `const b: Shape[] = a` over
  // a `Circle[]` — D773's witness — is `vl check` rc 0 and INVALID WASM on master, and
  // `emitRefListWidenSite` converts it where the copy is unobservable.
  if localIsRef[slot] == "reflist" {
    emitRefListWidenSite(
      body,
      s.letInit,
      exprEmittedRefListSlot(s.letInit, fnIx),
      localStructIdx[slot],
    )
  }
  // the scalar dual (D965) — `const b: f64[] = e` over an `i32[]`. The cell's own kind IS
  // the destination list kind, so this needs no second derivation.
  emitScalarListWidenSite(body, s.letInit, fnIx, localIsRef[slot])
  // the narrowed-arm unbox at the binding boundary (D1031): the same shape as the two
  // widen sites above, since the cell's own (kind, slot) pair is the destination.
  // `letArmOwed` is taken before the init emits, since an init carrying its own `if`
  // moves the narrowing stack.
  if letArmOwed && !letArmCell {
    const letArmHeap = armDestHeapOf(localIsRef[slot], localStructIdx[slot])
    if letArmHeap >= 0 {
      emitArmUnboxCast(
        letArmHeap,
        narrowedNulStructArm(s.letInit) || localIsRef[slot] == "nulvariant",
      )
    }
  }
  // the nullable-niche recover at the BINDING boundary (D1115) — `const z: i32[] = y` under
  // `if y != null`. The cell's own kind is the destination, exactly as the two widen sites
  // above read it.
  if !letArmCell && nulNicheRecoverOwed(localIsRef[slot], s.letInit, fnIx) {
    fbRefAsNonNull()
  }
}

// The statement list and position of the statement `emitStmt` is about to lower, so a `let`
// can read the statements after it; `letSibPos` is -1 outside such a call (D3623).
let letSibStmts: i32[] = []
let letSibPos = -1

// `emitStmt` on `stmts[i]`, with the list and position published for `emitListReserve`.
function emitStmtIn(
  body: u8[],
  stmts: i32[],
  i: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  letSibStmts = stmts
  letSibPos = i
  const rc = emitStmt(body, stmts[i], fnIx, ec)
  letSibPos = -1
  if rc >= 0 && lbEnd.length > 0 { listBuildClose(stmts[i]) }
  rc
}

// The most elements a list reserve allocates up front.
const LIST_RESERVE_MAX = 65536

// What a reserve scan found: the elements the pushes add, the push nodes counted, and the
// last statement that pushes.
type ListReserve = { lrCount: i32, lrPushes: i32[], lrLast: i32 }

// A fresh `[]` binding whose next uses are unconditional `push`es inside constant-trip range
// loops gets its backing at the final size, and those pushes append through locals while the
// count is under it (D3623). Each still tests the count, so a wrong one costs a growth, never
// a wrong answer.
function emitListReserve(
  s: LetDecl,
  stmtIx: i32,
  idx: i32,
  slot: i32,
  fnIx: i32,
) {
  const pos = letSibPos
  letSibPos = -1
  if pos < 0 || pos >= letSibStmts.length || letSibStmts[pos] != stmtIx {
    return 0
  }
  const init = nodeAt(unwrapParen(s.letInit))
  if !(init is ArrayLit) { return 0 }
  if init is ArrayLit {
    if init.arrElems.length != 0 { return 0 }
  }
  const want = reserveMfKindOfSlot(localIsRef[slot])
  if want == null { return 0 }
  const stmts = letSibStmts
  const r: ListReserve = { lrCount: 0, lrPushes: [], lrLast: -1 }
  let j = pos + 1
  while j < stmts.length {
    const c = reservePushCount(stmts[j], s.letName, r, fnIx)
    if c < 0 {
      j = stmts.length
    } else {
      r.lrCount = r.lrCount + c
      if c > 0 { r.lrLast = j }
      j = j + 1
    }
    if r.lrCount > LIST_RESERVE_MAX { return 0 }
  }
  if r.lrCount <= 0 || r.lrPushes.length == 0 { return 0 }
  const recv = listPushRecv(r.lrPushes[0])
  if mfRecvKindOf(recv, fnIx) != want { return 0 }
  let row = 0
  if want == "ref" { row = refListSlotOfExpr(recv, fnIx) }
  if row < 0 { return 0 }
  const wrap = spreadWrapIdx(want, row)
  const back = spreadBackIdx(want, row)
  if wrap < 0 || back < 0 { return 0 }
  fbLocalGet(idx)
  fbI32Const(r.lrCount)
  fbArrayNewDefault(back)
  fbStructSet(wrap, 0) // backing
  fbLocalGet(idx)
  fbI32Const(r.lrCount)
  fbStructSet(wrap, 2) // cap
  // The length is written back after the region's last statement, so one must follow it.
  if r.lrLast >= stmts.length - 1 { return 0 }
  liKinds.push(want)
  liSlots.push(row)
  liBack.push(3)
  const bSlot = listIdxScratchBase + liKinds.length
  const cSlot = strI32Slot()
  fbLocalGet(idx)
  fbStructGet(wrap, 0)
  fbLocalSet(bSlot)
  fbI32Const(0)
  fbLocalSet(cSlot)
  const reg = lbList.length
  lbList.push(idx)
  lbEnd.push(stmts[r.lrLast])
  lbBack.push(bSlot)
  lbCnt.push(cSlot)
  lbCap.push(r.lrCount)
  lbWrap.push(wrap)
  lbBackTy.push(back)
  let k = 0
  while k < r.lrPushes.length {
    lbPush.push(r.lrPushes[k])
    lbPushOf.push(reg)
    k = k + 1
  }
  0
}

// The receiver node of the `push` call at `callIx`.
function listPushRecv(callIx: i32): i32 {
  const n = nodeAt(callIx)
  if n is Call {
    const cf = nodeAt(unwrapParen(n.callFn))
    if cf is Member { return unwrapParen(cf.memObj) }
  }
  -1
}

// The open build region whose counted pushes include `callIx`, or -1.
function listBuildRegionOf(callIx: i32): i32 {
  let k = lbPush.length - 1
  while k >= 0 {
    if lbPush[k] == callIx {
      const reg = lbPushOf[k]
      if lbEnd[reg] >= 0 { return reg }
      return -1
    }
    k = k - 1
  }
  -1
}

// After statement `ix`: write back the length of every open build region it ends.
function listBuildClose(ix: i32) {
  let reg = 0
  while reg < lbEnd.length {
    if lbEnd[reg] == ix {
      fbLocalGet(lbList[reg])
      fbLocalGet(lbCnt[reg])
      fbStructSet(lbWrap[reg], 1) // len
      lbEnd[reg] = -1
    }
    reg = reg + 1
  }
  0
}

// The list kind a `push` onto a local of slot kind `k` lowers at, or null for a slot that is
// not a non-null list local. The scalar lists are `scalarListElemOfListKind`'s to name.
function reserveMfKindOfSlot(k: VKind): MfKind | null {
  if k == "strlist" { return "str" }
  if k == "reflist" { return "ref" }
  const sk = scalarListElemOfListKind(k)
  if sk == null { return null }
  scalarElemMfKind(sk)
}

// The elements statement `ix` pushes onto `nm`, each push unconditional: `nm.push(x)` is one
// and a constant-trip range loop multiplies its body's. -1 when it reads, writes or shadows
// `nm` any other way, or holds a `break`, `continue` or `return`; that ends the scan.
function reservePushCount(ix: i32, nm: string, r: ListReserve, fnIx: i32): i32 {
  const n = nodeAt(ix)
  if n is Call {
    const cf = nodeAt(unwrapParen(n.callFn))
    if cf is Member {
      const ro = nodeAt(unwrapParen(cf.memObj))
      let onNm = false
      if ro is Ident { onNm = ro.identName == nm }
      if cf.memProp == "push" && onNm {
        if n.callArgs.length != 1 || hasSpreadItem(n.callArgs) { return -1 }
        if exprMentionsName(n.callArgs[0], nm) || stmtHasExit(n.callArgs[0]) {
          return -1
        }
        r.lrPushes.push(ix)
        return 1
      }
    }
  }
  if n is ForRange {
    if !exprMentionsName(ix, nm) { return reserveNeutral(ix, nm) }
    if n.frVar == nm { return -1 }
    const trips = rangeConstTrips(n, fnIx)
    if trips < 0 { return -1 }
    if exprMentionsName(n.frFrom, nm) || exprMentionsName(n.frTo, nm) {
      return -1
    }
    const mark = r.lrPushes.length
    const inner = reserveBodyCount(n.frBody, nm, r, fnIx)
    if inner < 0 || (trips > 0 && inner > LIST_RESERVE_MAX / trips) {
      while r.lrPushes.length > mark { r.lrPushes.pop() }
      return -1
    }
    return trips * inner
  }
  reserveNeutral(ix, nm)
}

// `reservePushCount` summed over the statements of the block at `ix`, or -1.
function reserveBodyCount(ix: i32, nm: string, r: ListReserve, fnIx: i32): i32 {
  const b = nodeAt(ix)
  if !(b is Block) { return -1 }
  let inner = 0
  if b is Block {
    let i = 0
    while i < b.blkStmts.length {
      const c = reservePushCount(b.blkStmts[i], nm, r, fnIx)
      if c < 0 { return -1 }
      inner = inner + c
      if inner > LIST_RESERVE_MAX { return -1 }
      i = i + 1
    }
  }
  inner
}

// 0 for a statement that neither touches `nm` nor can leave early, else -1.
function reserveNeutral(ix: i32, nm: string): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  if exprMentionsName(ix, nm) || stmtHasExit(ix) { return -1 }
  const n = nodeAt(ix)
  if n is LetDecl {
    if n.letName == nm { return -1 }
  }
  0
}

// Whether the code under `ix` holds a `break`, `continue` or `return`.
function stmtHasExit(ix: i32): boolean {
  let cur = ix
  while cur >= 0 {
    const n = nodeAt(cur)
    if n is BreakStmt || n is ContinueStmt || n is RetStmt { return true }
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      if stmtHasExit(kids[i]) { return true }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  false
}

// The trips of a range loop whose ends and step are constants within 2^30, or -1.
function rangeConstTrips(n: ForRange, fnIx: i32): i32 {
  if !forRangeStepIsConst(n.frStep) { return -1 }
  if !rangeConstIs(n.frFrom, fnIx) || !rangeConstIs(n.frTo, fnIx) { return -1 }
  let k = 1
  if n.frStep >= 0 {
    if !rangeConstIs(n.frStep, fnIx) { return -1 }
    k = rangeConstVal(n.frStep, fnIx)
  }
  const a = rangeConstVal(n.frFrom, fnIx)
  const b = rangeConstVal(n.frTo, fnIx)
  const lim = 1073741824
  if k == 0 || a >= lim || a <= 0 - lim || b >= lim || b <= 0 - lim {
    return -1
  }
  let span = b - a
  if k < 0 {
    span = a - b
    k = 0 - k
  }
  if span < 0 { return 0 }
  if n.frExcl { return (span + k - 1) / k }
  span / k + 1
}

// `emitCallStmt`'s arm over a named callee `f(…)`: the call, then a `drop` unless the callee is
// void (`print`, a void intrinsic or host import, a void function or closure). Returns 0, or -1
// once failed.
function emitCallStmtIdent(
  body: u8[],
  s: Call,
  callee: Ident,
  stmtIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // A bare call whose RESULT is discarded (a helper invoked for its side
  // effects): emit the call, then `drop` the value it leaves — EXCEPT `print`
  // (a void import) and a VOID function (`()->()` leaves nothing).
  if emitCall(body, stmtIx, fnIx, ec) < 0 { return -1 }
  let dropIt = callee.identName != "print"
  // The void memory intrinsics leave nothing on the stack.
  if callee.identName == "__store_i32__" { dropIt = false }
  if nameIsMemStoreIntrinsic(callee.identName) { dropIt = false }
  if nameIsMemBulkIntrinsic(callee.identName) { dropIt = false }
  // `__store_v128__` is void (the other SIMD intrinsics leave a value the drop below wants).
  if callee.identName == "__store_v128__" { dropIt = false }
  if atomicIntrinsicIsVoid(callee.identName) { dropIt = false }
  if callee.identName == "__log__" { dropIt = false }
  // The void array intrinsics: `__array_copy__` leaves nothing; `__trap__`
  // is `unreachable` (no value reaches the drop).
  if callee.identName == "__array_copy__" { dropIt = false }
  if callee.identName == "__trap__" { dropIt = false }
  // A void HOST import leaves nothing either. Asked through the slot table rather than
  // by spelling, so a diverging slot added there cannot be missed here — every other
  // entry in this ladder is a name, and a name is what a new slot would not carry.
  if fsRetIsVoid(fsIntrinsicSlot(callee.identName)) { dropIt = false }
  if calleeIsVoidExtern(callee.identName, fnIx) { dropIt = false }
  if dropIt {
    // A name a closure binding covers denotes that binding, so the void question is the
    // closure's — the module function of the name lowered no instruction here (D1602).
    let vt = fnIndexOfNode(s.callFn)
    if vt >= 0 && identIsBoundClosure(callee.identName, fnIx) { vt = -1 }
    if vt >= 0 {
      if fRetVoid[vt] == 1 { dropIt = false }
    } else {
      // A closure-VALUE callee (a param / binding, invisible to `fnIndexOf`) whose
      // `$fnsig` is void leaves nothing — no `drop`. POSITIONED, or two sibling module
      // blocks binding one closure name resolve to no key at all (D1862).
      const cvAt = unwrapParen(s.callFn)
      if calleeReturnsVoidAt(sidOfNode(s.callFn), fnIx, cvAt) { dropIt = false }
      // The key that lowered the call decides too, as for a member callee: a module
      // binding copying a list element of hole functions is keyed only by it (D7485).
      if dropIt && sigKeyRetIsVoid(cloCallSigKey(stmtIx, fnIx)) {
        dropIt = false
      }
    }
  }
  if dropIt {
    fbDrop() // 0x1a drop
  }
  0
}

function emitCallStmt(body: u8[], s: Call, stmtIx: i32, fnIx: i32, ec: ExpCtx) {
  // The only call STATEMENT this slice lowers is a list append `recv.push(x)` (a
  // `Call` whose `callFn` is a `Member`). A bare top-level call statement (a function
  // call whose value is discarded) is out of scope.
  if s.callFn < 0 { return -1 }
  const tagArms = fnTagCallArms(stmtIx)
  if tagArms.length > 0 {
    const dr = emitFnTagDispatch(body, stmtIx, tagArms, fnIx)
    if dr < 0 { return -1 }
    if dr == 0 { fbDrop() }
    return 0
  }
  const callee = nodeAt(s.callFn)
  if callee is Member {
    // A `.push` STATEMENT discards the new length — emit the append with no value (D1592),
    // rather than emitting one and dropping it.
    if callee.memProp == "push" {
      return emitPush(body, stmtIx, fnIx, false, ec)
    }
    // A `.pop()` STATEMENT discards the popped element — emit the pop, then `drop`
    // the value it leaves on the stack, unless `emitPop` answered 1 (it dropped it already).
    if callee.memProp == "pop" {
      if popRecvIsList(callee.memObj, fnIx) {
        const popR = emitPop(body, stmtIx, fnIx, false, -1, ec)
        if popR < 0 { return -1 }
        if popR == 0 {
          fbDrop() // 0x1a drop
        }
        return 0
      }
    }
    // a `.clear()` statement resets the list's length to 0 (backing retained). The gate
    // carries the scalar reps alongside the i32/ref/string ones, so a `u8[]`/`i64[]`/
    // `f64[]`/`f32[]` receiver reaches `emitClear` too, matching `.pop`'s coverage via `emitPop`.
    if callee.memProp == "clear" {
      if (
        exprArray(callee.memObj, fnIx)
        || exprRefArray(callee.memObj, fnIx)
        || exprStringArray(callee.memObj, fnIx)
        || scalarListElemKind(callee.memObj, fnIx) != null
      ) {
        return emitClear(body, stmtIx, fnIx, ec)
      }
      if exprMap(callee.memObj, fnIx) {
        if s.callArgs.length != 0 {
          return emitFail(
            "emitProgram: internal: map clear reached with the wrong argument count — the checker's arity rule refuses it",
          )
        }
        return emitMapClear(body, callee.memObj, fnIx, ec)
      }
    }
    // G8: a map `m.set(k, v)` STATEMENT is the method form of `m[k] = v` — the
    // same scan/overwrite-or-append lowering.
    if callee.memProp == "set" {
      if exprMap(callee.memObj, fnIx) {
        if s.callArgs.length != 2 {
          return emitFail(
            "emitProgram: internal: map set reached with the wrong argument count — the checker's arity rule refuses it",
          )
        }
        return emitMapSet(
          body,
          callee.memObj,
          s.callArgs[0],
          s.callArgs[1],
          fnIx,
          ec,
        )
      }
    }
    // A Set `s.add(k)` STATEMENT is the membership-insert form of `s[k] = true` — the
    // SAME scan/overwrite-or-append lowering as `emitMapSet`, but storing the constant
    // boolean `1` (true) as the value (the Set vals-list carries true for live keys).
    // It takes EXACTLY one arg; the result (if any) is discarded.
    if callee.memProp == "add" {
      if exprMap(callee.memObj, fnIx) {
        if s.callArgs.length != 1 {
          return emitFail(
            "emitProgram: internal: set add reached with the wrong argument count — the checker's arity rule refuses it",
          )
        }
        return emitMapSetV(
          body,
          callee.memObj,
          s.callArgs[0],
          -1,
          fnIx,
          true,
          ec,
        )
      }
    }
    // G8: a bare `m.delete(k)` STATEMENT discards the boolean result — emit the
    // delete, then `drop` the 0/1 it leaves on the stack.
    if callee.memProp == "delete" {
      if exprMap(callee.memObj, fnIx) {
        if s.callArgs.length != 1 {
          return emitFail(
            "emitProgram: internal: map delete reached with the wrong argument count — the checker's arity rule refuses it",
          )
        }
        if emitMapDelete(body, callee.memObj, s.callArgs[0], fnIx, ec) < 0 {
          return -1
        }
        fbDrop() // 0x1a drop (discard the boolean result)
        return 0
      }
    }
    // A closure-field member call STATEMENT (`(o."[]=")(k, v)` — the rewritten
    // index WRITE trap, or any function-valued field invoked for effect):
    // `call_ref` it; drop the result unless the field's function is void.
    if exprIsClosure(s.callFn, fnIx) {
      if emitCallRef(body, stmtIx, fnIx, ec) < 0 { return -1 }
      // the drop decision follows the sig the call resolved (`cloCallSigKey`): a `>v`
      // key leaves nothing on the stack, so dropping is invalid wasm regardless of the
      // field's rep function. Asked first, since the rep-function fallback is wrong
      // exactly when the two disagree.
      let mcVoid = sigKeyRetIsVoid(cloCallSigKey(stmtIx, fnIx))
      if !mcVoid {
        const mcFe = fieldClosureFeOfRecv(callee.memObj, callee.memProp, fnIx)
        if mcFe >= 0 {
          if fRetVoid[mcFe] == 1 { mcVoid = true }
        }
      }
      if !mcVoid {
        fbDrop() // 0x1a drop (discard the unused result)
      }
      return 0
    }
    // D1240 — a member call no mutator arm claimed is a discarded value, the same rule
    // the `Ident` arm below applies to `f(…)`. General rather than a per-method gate:
    // `xs.slice(0, 2)` has an expression form but the statement ladder had no route to it.
    if emitExpr(body, stmtIx, fnIx, ec) < 0 { return -1 }
    if memberCallYieldsValue(stmtIx) {
      fbDrop() // 0x1a drop
    }
    return 0
  }
  if callee is Ident {
    return emitCallStmtIdent(body, s, callee, stmtIx, fnIx, ec)
  }
  // A closure-VALUE callee neither a member nor a name, in genuine statement position:
  // `call_ref` it and drop what its own `$fnsig` leaves — nothing for a `>v` key. A resolved
  // valued key is one `stmtIsTailValue` would have claimed as a tail, so reaching here means a
  // discarded result; only an unresolved key refuses (D2111).
  if exprIsClosure(s.callFn, fnIx) {
    const csKey = cloCallSigKey(stmtIx, fnIx)
    if sigKeyRetIsVoid(csKey) { return emitCallRef(body, stmtIx, fnIx, ec) }
    if csKey != "" {
      if emitCallRef(body, stmtIx, fnIx, ec) < 0 { return -1 }
      fbDrop() // 0x1a drop (discard the unused result)
      return 0
    }
    return emitFail(
      "emitProgram: a function-value call statement yields a value the tail-value ladder did not claim",
    )
  }
  return emitFail(
    "emitProgram: a call statement's callee is neither a name, a member, nor a function value",
  )
}

// The compile-time value of an `if` condition that is a monomorphized-instance guard
// testing an inline struct shape (1/0), or -1 otherwise — narrower than `emitIs`'s static
// path: the receiver must be a bare ident, the tested name a whole-span `{…}` shape, and
// neither a literal variant name nor a nullable-struct receiver (both are runtime tests).
function monoStaticIsGuardOf(condIx: i32, fnIx: i32) {
  const c = nodeAt(condIx)
  if c is IsExpr {
    const recv = nodeAt(unwrapParen(c.isObj))
    if !(recv is Ident) { return -1 }
    if isLitVariantName(c.isVariant) { return -1 }
    if !nameIsWholeSpanShape(c.isVariant) { return -1 }
    if exprNullableStruct(c.isObj, fnIx) { return -1 }
    return monoStaticIsResult(condIx, fnIx)
  }
  -1
}

// The first of the `n` consecutive slots the declaration at `declIx` owns: the slot the collect
// walk pinned to its node when it sits in an expression-position if-expression, else the next
// `n` cursor positions, stepping over every position such a declaration owns (D2785).
function declSlotTake(declIx: i32, n: i32): i32 {
  const pinned = declSlotPinned(declIx)
  if pinned >= 0 { return pinned }
  if localByNode.length > 0 { cursorSkipByNode() }
  const first = emitLetCursor
  emitLetCursor = emitLetCursor + n
  first
}

// Step `emitLetCursor` past the positions a by-node declaration owns (`localByNode`).
function cursorSkipByNode() {
  while emitLetCursor < localByNode.length && localByNode[emitLetCursor] == 1 {
    emitLetCursor = emitLetCursor + 1
  }
  0
}

// Advance `emitLetCursor` over `n` cursor-owned positions, as a skipped subtree's declarations
// would have taken them one by one.
function cursorAdvance(n: i32) {
  let k = 0
  while k < n {
    cursorSkipByNode()
    emitLetCursor = emitLetCursor + 1
    k = k + 1
  }
  0
}

// D932 — the `emitLetCursor` positions that emitting the subtree at `ix` would consume. A
// dead-arm skip is a control-flow change the locals layout never hears about, since
// `collectLocals` allocates slots in pre-order over the whole body; every skip below must
// advance the cursor by this count. A `FuncDecl` subtree contributes nothing — its own body owns its own frame.
function cursorSlotsUnder(ix: i32): i32 {
  if ix < 0 { return 0 }
  const n = nodeAt(ix)
  if n is FuncDecl { return 0 }
  let cnt = 0
  if n is LetDecl { cnt = 1 }
  if n is ForRange { cnt = 2 }
  if n is ForIn { cnt = 3 }
  // A declaration found by node took no cursor position.
  if declSlotPinned(ix) >= 0 { cnt = 0 }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      cnt = cnt + cursorSlotsUnder(kids[i])
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  cnt
}

// D932 — did the condition emitted since `condStart` fold to a constant? 1/0, or -1
// for any runtime test. Read off the bytes the module actually carries, not a parallel
// predicate — a second derivation of "did it fold" is exactly the drift that let
// `monoStaticIsResult`'s direct answer disagree with the emitted condition.
function emittedCondConst(condStart: i32): i32 {
  if wLen() != condStart + 2 { return -1 }
  if wPeekBack(1) != 65 {
    return -1 // 0x41 i32.const
  }
  const cb = wPeekBack(0)
  if cb == 0 { return 0 }
  if cb == 1 { return 1 }
  -1
}

// `emittedCondConst` of an `is` test `condIx`, or its `!`, emitted since `condStart`, or -1 for
// any other condition: an instance decides its own `is` tests, so one arm can be dead there.
function staticIsGuard(condIx: i32, condStart: i32): i32 {
  if condIx < 0 { return -1 }
  const c = nodeAt(unwrapParen(condIx))
  if c is Unary {
    if c.unOp != "!" { return -1 }
    if !(nodeAt(unwrapParen(c.unArg)) is IsExpr) { return -1 }
    return emittedCondConst(condStart)
  }
  if !(c is IsExpr) { return -1 }
  emittedCondConst(condStart)
}

// A value arm this instance's `is` test proved dead: `unreachable` meets any blocktype, and
// its lets keep their slots (D932). Lowered, it would read its value at the arm's own type.
function emitDeadValueArm(blockIx: i32): i32 {
  cursorAdvance(cursorSlotsUnder(blockIx))
  fbUnreachable()
  0
}

// The dual of `emitIfStmtStmt`'s dead-arm skip: a statement `if` whose mono-instance
// `is` guard is statically true and whose then-branch always exits ends the block for
// this instance, since everything after it is typed against other instances' bindings
// and generally unable to lower. The caller pads with `unreachable` to stay stack-polymorphic.
function monoStaticGuardEndsBlock(stmtIx: i32, fnIx: i32) {
  const s = nodeAt(stmtIx)
  if s is IfStmt {
    if negGuardDecidedTrue(s.ifCond, fnIx) { return stmtAlwaysExits(s.ifThen) }
    if monoStaticIsGuardOf(s.ifCond, fnIx) != 1 { return false }
    return stmtAlwaysExits(s.ifThen)
  }
  false
}

// The function, condition node and emitted constant (`staticIsGuard`) of the most recently
// lowered statement `if`: the enclosing block asks whether that guard is decided.
let negGuardFn = -1
let negGuardCond = -1
let negGuardVal = -1

// Whether `condIx` is a `!is` the statement `if` just lowered decided true: the instance's pin
// cannot hold the tested type, so a tail after an exiting arm reads it at that type (D2957).
function negGuardDecidedTrue(condIx: i32, fnIx: i32): boolean {
  if condIx < 0 || condIx != negGuardCond || negGuardVal != 1 { return false }
  if fnIx != negGuardFn { return false }
  const c = nodeAt(unwrapParen(condIx))
  if c is Unary { return c.unOp == "!" }
  false
}

// ── a dense integer `match` as a `br_table` (PL-001) ─────────────────────────
// The chain an integer `match` desugared to (`intMatchHeadAt`) lowers to one `br_table` over
// nested blocks when its literal set is dense: at least 3 distinct values spanning fewer than
// `2 * values + 8`; the rule is match-design.md §"A dense integer match is a `br_table`".

// The value of integer pattern `patIx` (a `NumLit`, `-` over one, or a `const` arm read of
// either) as a 64-bit pair pushed onto `out` as hi then lo; false for any other node.
function switchLitPair(patIx: i32, out: i32[]) {
  const lit = matchConstPatLitAt(patIx)
  if lit >= 0 { return switchLitPair(lit, out) }
  let numIx = patIx
  let neg = false
  const p = nodeAt(patIx)
  if p is Unary {
    if p.unOp != "-" { return false }
    numIx = p.unArg
    neg = true
  }
  if numIx < 0 { return false }
  const n = nodeAt(numIx)
  if n is NumLit {
    if numLexIsFloat(n.numText) { return false }
    const pr = parseI64Pair(n.numText)
    let hi = pr[0]
    let lo = pr[1]
    if neg {
      let carry = 0
      if lo == 0 { carry = 1 }
      lo = 0 - lo
      hi = (hi ^ -1) + carry
    }
    out.push(hi)
    out.push(lo)
    return true
  }
  false
}

// Collects arm `arm`'s case values from its condition — `scrut == lit`, or an `||` tree of
// them over the SAME scrutinee node — into `vals`/`arms`; false on any other shape. A value
// that is not a sign-extended `i32` declines, so every table key fits in an `i32`.
function switchCondCollect(
  condIx: i32,
  scrutIx: i32,
  arm: i32,
  vals: i32[],
  arms: i32[],
) {
  const c = nodeAt(condIx)
  if c is BinExpr {
    if c.binOp == "||" {
      if !switchCondCollect(c.binLeft, scrutIx, arm, vals, arms) {
        return false
      }
      return switchCondCollect(c.binRight, scrutIx, arm, vals, arms)
    }
    if c.binOp == "==" && c.binLeft == scrutIx {
      const pr: i32[] = []
      if !switchLitPair(c.binRight, pr) { return false }
      if pr[0] != (pr[1] >> 31) { return false }
      vals.push(pr[1])
      arms.push(arm)
      return true
    }
  }
  false
}

// The scrutinee node of the chain condition `condIx` — the left operand of its leftmost
// `==` — or -1 when the condition is not an `==`/`||` tree.
function switchScrutOf(condIx: i32) {
  let at = condIx
  while at >= 0 {
    const c = nodeAt(at)
    if c is BinExpr {
      if c.binOp == "==" { return c.binLeft }
      if c.binOp != "||" { return -1 }
      at = c.binLeft
    } else {
      return -1
    }
  }
  -1
}

// The scrutinee's width for a `br_table`: 1 for a plain `i32` place, 2 for a plain `i64` one,
// 0 when the chain stays — not an `Ident`, a union box, an atom, a float, or no recorded type.
function switchScrutWidth(scrutIx: i32, fnIx: i32) {
  if scrutIx < 0 { return 0 }
  if !(nodeAt(scrutIx) is Ident) { return 0 }
  const w = nodeTyIntWidth(scrutIx)
  if w == 0 { return 0 }
  if exprUnion(scrutIx, fnIx) || exprIsLitAtom(scrutIx, fnIx) { return 0 }
  if exprIsF64(scrutIx, fnIx) || exprIsF32(scrutIx, fnIx) { return 0 }
  if (w == 2) != exprIsI64(scrutIx, fnIx) { return 0 }
  w
}

// One arm body of a switch in `mode`: 0 statement, 1 function tail, 2 scalar value of
// blocktype `kind`, 3 ref value of `rk`/`slot`.
function emitSwitchArm(
  body: u8[],
  blk: i32,
  fnIx: i32,
  mode: i32,
  kind: i32,
  rk: VKind,
  slot: i32,
  ec: ExpCtx,
) {
  if mode == 2 { return emitBlockValueAs(body, blk, fnIx, kind, ec) }
  if mode == 3 { return emitRefIfArm(body, blk, fnIx, rk, slot, false, ec) }
  if blk < 0 || blk >= P.nodes.length {
    return emitFail("emitProgram: a match arm has no body")
  }
  const b = nodeAt(blk)
  if b is Block {
    if mode == 1 { return emitStmtsTail(body, blk, fnIx, ec) }
    return emitStmts(body, blk, fnIx, ec)
  }
  if mode == 1 { return emitStmtTail(body, blk, fnIx, ec) }
  emitStmt(body, blk, fnIx, ec)
}

// Lowers the integer-`match` chain headed at `headIx` as a `br_table` in `mode` (see
// `emitSwitchArm`): 1 when lowered, 0 when it declined having written nothing, -1 on an emit
// failure. Arms are emitted in chain order — the collect pass's — so the let cursor stays in step.
function emitIntSwitch(
  body: u8[],
  headIx: i32,
  fnIx: i32,
  mode: i32,
  kind: i32,
  rk: VKind,
  slot: i32,
  ec: ExpCtx,
) {
  if !intMatchHeadAt(headIx) { return 0 }
  const vals: i32[] = []
  const arms: i32[] = []
  const thens: i32[] = []
  let scrutIx = -1
  let cur = headIx
  let elseBlk = -1
  let walking = true
  while walking {
    const s = nodeAt(cur)
    if s is IfStmt {
      if scrutIx < 0 { scrutIx = switchScrutOf(s.ifCond) }
      if scrutIx < 0 { return 0 }
      if !switchCondCollect(s.ifCond, scrutIx, thens.length, vals, arms) {
        return 0
      }
      thens.push(s.ifThen)
      const next = s.ifElse
      let more = false
      if next >= 0 {
        if nodeAt(next) is IfStmt { more = !intMatchHeadAt(next) }
      }
      if more {
        cur = next
      } else {
        elseBlk = next
        walking = false
      }
    } else {
      return 0
    }
  }
  const w = switchScrutWidth(scrutIx, fnIx)
  if w == 0 { return 0 }
  if elseBlk < 0 && mode >= 2 { return 0 }
  const m = thens.length
  let lo = vals[0]
  let hi = vals[0]
  let i = 1
  while i < vals.length {
    if vals[i] < lo { lo = vals[i] }
    if vals[i] > hi { hi = vals[i] }
    i = i + 1
  }
  // `hi - lo` wraps negative exactly when the true span passes 2^31, which is never dense.
  const span = hi - lo
  if span < 0 || span >= 2 * vals.length + 8 { return 0 }
  // A repeated value keeps its FIRST arm, as the chain's first passing test does.
  const table: i32[] = []
  let t = 0
  while t <= span {
    table.push(m)
    t = t + 1
  }
  let distinct = 0
  i = 0
  while i < vals.length {
    const at = vals[i] - lo
    if table[at] == m {
      table[at] = arms[i]
      distinct = distinct + 1
    }
    i = i + 1
  }
  if distinct < 3 || span >= 2 * distinct + 8 { return 0 }
  // The outer frame carries the value in the value modes; every inner frame is void.
  fbOpenBlock() // 0x02 block
  if mode == 3 { fbValtype(rk, slot) }
  else if mode == 2 { wU8(kind) }
  else { wU8(64) }
  const endDepth = ctrlDepth
  fbBlock(64) // the else arm's frame, the `br_table` default
  let k = 0
  while k < m {
    fbBlock(64)
    k = k + 1
  }
  if emitCondExpr(body, scrutIx, fnIx, ec) < 0 { return -1 }
  if w == 2 {
    // An i64 index `d = s - lo` is in range iff `d <u span + 1`; out of range selects the
    // default slot `span + 1`, so no 64-bit value can wrap onto a case.
    fbI64Const(lo >> 31, lo)
    fbI32Bin(125) // 0x7d i64.sub
    fbI32WrapI64()
    fbI32Const(span + 1)
    if emitCondExpr(body, scrutIx, fnIx, ec) < 0 { return -1 }
    fbI64Const(lo >> 31, lo)
    fbI32Bin(125) // 0x7d i64.sub
    fbI64Const(0, span + 1)
    fbI32Bin(84) // 0x54 i64.lt_u
    fbSelect()
  } else if lo != 0 {
    // i32 subtraction wraps mod 2^32 and `br_table` reads its index unsigned, so `s - lo`
    // lands in `[0, span]` exactly when `s` is in `[lo, hi]`.
    fbI32Const(lo)
    fbI32Bin(107) // 0x6b i32.sub
  }
  wU8(14) // 0x0e br_table
  wULEB(span + 1)
  t = 0
  while t <= span {
    wULEB(table[t])
    t = t + 1
  }
  wULEB(m) // default: the else arm's frame
  k = 0
  while k < m {
    fbEnd()
    if emitSwitchArm(body, thens[k], fnIx, mode, kind, rk, slot, ec) < 0 {
      return -1
    }
    fbBr(ctrlDepth - endDepth)
    k = k + 1
  }
  fbEnd()
  if elseBlk >= 0 {
    if emitSwitchArm(body, elseBlk, fnIx, mode, kind, rk, slot, ec) < 0 {
      return -1
    }
  }
  fbEnd()
  1
}

// Closes the frames an `else if` chain's links left open, innermost-first, as the recursive
// emitters' unwinding did: each restores its else narrowing (`open` holds the target, or -1),
// then — only when `rc` is not a failure — writes its `end` and marks the join unreachable
// when every arm exited. Returns `rc`.
function closeIfChainFrames(open: i32[], rc: i32, unreachable: boolean) {
  let k = open.length
  while k > 0 {
    k = k - 1
    if open[k] >= 0 { restoreNarrow(open[k]) }
    if rc >= 0 {
      fbEnd() // 0x0b end
      if unreachable { fbUnreachable() }
    }
  }
  rc
}

function emitIfStmtStmt(body: u8[], stmtIx: i32, fnIx: i32, ec: ExpCtx) {
  // An `else if` chain is lowered along its spine, so its depth costs no stack (D1990): a link
  // whose else is the next link leaves its `if` frame open, and the open frames close
  // innermost-first once the chain's last arm is emitted. Each entry is that link's else
  // narrowing restore target, or -1.
  const open: i32[] = []
  // A chain ending a void body is in tail position in every arm (D4681).
  const tail = stmtIx >= 0 && stmtIx == voidTailAt
  let cur = stmtIx
  while cur >= 0 {
    const at = cur
    cur = -1
    // `emitStmt`'s entry guard, for every link after the first.
    if at != stmtIx && emitFailed { return -1 }
    const s = nodeAt(at)
    if s is IfStmt {
      const sw = emitIntSwitch(body, at, fnIx, 0, 64, "i32", -1, ec)
      if sw < 0 { return -1 }
      if sw == 0 {
        const rc = emitIfLinkStmt(body, s, fnIx, open, tail, ec)
        if rc < 0 { return -1 }
        if rc == 1 { cur = s.ifElse }
      }
    }
  }
  closeIfChainFrames(open, 0, false)
}

// One link of `emitIfStmtStmt`'s chain. Returns 0 with its frame closed, -1 on failure, or 1
// when its else is another `if`: the frame is left open and its else narrowing's restore
// target (-1 when the else did not narrow) is pushed onto `open`.
function emitIfLinkStmt(
  body: u8[],
  s: IfStmt,
  fnIx: i32,
  open: i32[],
  tail: boolean,
  ec: ExpCtx,
) {
  // A-exhaust: the LAST arm of a chain the checker PROVED exhaustive is reached only when its
  // test holds, so it lowers as the bare `else` — no comparison, no `if` frame. The narrowing
  // still runs, since the arm reads its own member's fields (`condProvenTrue`).
  if s.ifElse < 0 && condProvenTrue(s.ifCond) {
    const pgTop = narrowTop
    const pgNar = setNarrowFromCond(s.ifCond, fnIx)
    const pgRc = emitTailArm(body, s.ifThen, fnIx, tail, ec)
    if pgNar { restoreNarrow(pgTop) }
    return pgRc
  }
  // A bare `{ … }` (lowered to `if true`) and a written `if true` run their arm
  // unconditionally, so they lower inline with no frame: binaryen's code-pushing re-walks the
  // rest of a block for every `if`, and a translated unit holds thousands of these. D2335.
  if s.ifElse < 0 && condLitTrue(s.ifCond) {
    return emitTailArm(body, s.ifThen, fnIx, tail, ec)
  }
  // structured void `if`: push the i32 condition, then `if`/`else`/`end`. A
  // monomorphized-instance `is` guard is decided at compile time, so one arm can be
  // provably unreachable in this instance and is emitted empty instead (D932) — read
  // off the emitted condition itself (`emittedCondConst`), not a parallel predicate.
  const condStart = wLen()
  if emitCondExpr(body, s.ifCond, fnIx, ec) < 0 { return -1 }
  const staticGuard = staticIsGuard(s.ifCond, condStart)
  negGuardFn = fnIx
  negGuardCond = s.ifCond
  negGuardVal = staticGuard
  fbIf(64) // 0x04 if, 0x40 void blocktype
  // If the condition is `n is Variant` over a bare union identifier, narrow `n` to
  // that variant for the THEN-branch only (so `n.field` downcasts). Save/restore the
  // outer narrowing around the branch so nesting and the else-branch are unaffected.
  const savedTop = narrowTop
  const narrowed = setNarrowFromCond(s.ifCond, fnIx)
  if staticGuard != 0 {
    if emitTailArm(body, s.ifThen, fnIx, tail, ec) < 0 { return -1 }
  } else {
    // D932 — the skipped arm's `let`s still own their collect-allocated slots.
    cursorAdvance(cursorSlotsUnder(s.ifThen))
  }
  if narrowed { restoreNarrow(savedTop) }
  if s.ifElse >= 0 && staticGuard != 1 {
    fbElse() // 0x05 else
    // The then narrowing does not hold in the else-branch, where the guard is false: a value
    // union narrows to the complement set instead (`is T` removes `T`).
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    const els = nodeAt(s.ifElse)
    if els is IfStmt {
      if narrowedElse { open.push(savedElseTop) } else { open.push(-1) }
      return 1
    }
    if els is Block {
      if emitTailArm(body, s.ifElse, fnIx, tail, ec) < 0 { return -1 }
    } else {
      if emitStmt(body, s.ifElse, fnIx, ec) < 0 { return -1 }
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
  } else if s.ifElse >= 0 {
    // D932 — the statically-dead else arm, same slot accounting as the then skip.
    cursorAdvance(cursorSlotsUnder(s.ifElse))
  }
  fbEnd() // 0x0b end
  return 0
}

// The statement ending the void function being emitted, or -1: nothing runs after it, so an
// `if` there is in tail position in every arm, as is the last statement of each arm.
let voidTailAt = -1

// `emitStmts` on an `if` arm; when the `if` is in tail position, the arm's last statement is
// too, and a call the arm ends with becomes a tail call (D4681).
function emitTailArm(
  body: u8[],
  blockIx: i32,
  fnIx: i32,
  tail: boolean,
  ec: ExpCtx,
) {
  if !tail || blockIx < 0 || blockIx >= P.nodes.length {
    return emitStmts(body, blockIx, fnIx, ec)
  }
  const b = nodeAt(blockIx)
  let last = -1
  if b is Block {
    if b.blkStmts.length > 0 { last = b.blkStmts[b.blkStmts.length - 1] }
  }
  voidTailAt = last
  const rc = emitStmts(body, blockIx, fnIx, ec)
  voidTailAt = -1
  if rc < 0 { return -1 }
  emitVoidTailCall(fnIx)
  0
}

function emitWhileStmtStmt(
  body: u8[],
  s: WhileStmt,
  stmtIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if s.whileBlk == 1 { return emitLabelBlock(body, s, stmtIx, fnIx, ec) }
  emitWhileLoop(body, s, stmtIx, fnIx, ec)
}

// A labelled block: one `block` frame a `break` leaves. It takes no `continue`, so a bare one
// inside it still finds the loop around it. A non-null value types the frame (`lvFrameOpen`):
// a tail assigned to the result binding falls out with it, and any other end is unreachable.
function emitLabelBlock(
  body: u8[],
  s: WhileStmt,
  _stmtIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const lv = lvFrameOpen(s)
  if lv < 0 { return -1 }
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.whileLabel)
  const rc = emitStmts(body, s.whileBody, fnIx, ec)
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  if rc < 0 { return -1 }
  if lv == 1 {
    if lvTailAssigns(s) {
      fbLocalGet(localIndexOf(fnIx, s.whileLv))
    } else {
      fbUnreachable()
    }
  }
  lvFrameClose(s, lv, fnIx)
}

// Opens the break frame of the `while` or labelled block `s`: typed by its result binding's
// valtype when a non-null value leaves by `br` (1), else void (0); -1 on failure.
function lvFrameOpen(s: WhileStmt): i32 {
  if s.whileLv == "" {
    fbBlock(64) // 0x02 block, 0x40 void blocktype
    return 0
  }
  const slot = scopeSlotOf(s.whileLv)
  if slot < 0 || slot >= localIsRef.length {
    emitFail("emitProgram: a loop value's result binding has no local")
    return -1
  }
  fbOpenBlock()
  fbValtype(localIsRef[slot], localStructIdx[slot])
  lvFrameDepth.push(ctrlDepth)
  lvFrameName.push(s.whileLv)
  1
}

// Closes the frame `lvFrameOpen` returned `lv` for; a typed one stores the value it carries
// out into the result binding, which initializes that binding at the enclosing level.
function lvFrameClose(s: WhileStmt, lv: i32, fnIx: i32) {
  fbEnd()
  if lv == 1 {
    lvFrameDepth.pop()
    lvFrameName.pop()
    fbLocalSet(localIndexOf(fnIx, s.whileLv))
  }
  0
}

// Whether the labelled block `s` ends by assigning its tail to its result binding.
function lvTailAssigns(s: WhileStmt): boolean {
  const b = nodeAt(s.whileBody)
  if b is Block {
    const n = b.blkStmts.length
    if n == 0 { return false }
    const a = nodeAt(b.blkStmts[n - 1])
    if a is BinExpr {
      if a.binOp != "=" { return false }
      const t = nodeAt(a.binLeft)
      if t is Ident { return t.identName == s.whileLv }
    }
  }
  false
}

function emitWhileLoop(
  body: u8[],
  s: WhileStmt,
  _stmtIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // structured while loop: block (void) wrapping a loop (void). The condition is
  // checked at the top; if false, exit the block; otherwise run the body then continue
  // the loop. Track the two control frames so break/continue compute their relative br
  // depth. The list-header hoists open before the block, since a loop that never iterates leaves them unread.
  const whHoist = loopHoistOpen(
    body,
    s.whileCond,
    s.whileBody,
    fnIx,
    "",
    "",
    ec,
  )
  if whHoist < 0 { return -1 }
  const whLv = lvFrameOpen(s)
  if whLv < 0 { return -1 }
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.whileLabel)
  fbLoop(64) // 0x03 loop, 0x40 void blocktype
  loopContDepth.push(ctrlDepth)
  loopContLabel.push(s.whileLabel)
  // condition + eqz: if condition is false (zero), exit block. A literal `true` never exits,
  // so it writes no test at all.
  if !condLitTrue(s.whileCond) {
    if emitExpr(body, s.whileCond, fnIx, ec) < 0 { return -1 }
    fbI32Eqz() // 0x45 i32.eqz (invert: exit if condition was false)
    fbBrIf(1)  // 0x0d br_if, depth 1 = break out of block
  }
  // the body is a narrowing scope (the checker's `checkWhileStmtNode` narrows it): the
  // condition is re-tested every iteration, so a `while e != null { … }` body reads `e`
  // unboxed. Pushed after `loopHoistOpen`, so the once-run hoist prologue sees the
  // un-narrowed type and never reads a guarded receiver's header before the guard holds.
  const whSavedTop = narrowTop
  const whNarrowed = setNarrowFromCond(s.whileCond, fnIx)
  // body statements
  if emitStmts(body, s.whileBody, fnIx, ec) < 0 { return -1 }
  if whNarrowed { restoreNarrow(whSavedTop) }
  fbBr(0) // 0x0c br, depth 0 = continue loop
  fbEnd() // 0x0b end (loop)
  loopContDepth.pop()
  loopContLabel.pop()
  // A typed frame is left only by a `break v`, so falling out of the loop cannot happen.
  if whLv == 1 { fbUnreachable() }
  lvFrameClose(s, whLv, fnIx) // 0x0b end (block)
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  loopHoistClose(whHoist)
  return 0
}

function emitForRangeStmt(
  body: u8[],
  s: ForRange,
  stmtIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // `for v in A to B [step K] { body }` — a numeric range, lowered to the same block/loop
  // shape as `while`: the loop var and a bound temp take the next two cursor slots, a
  // non-constant step a third (evaluated once). The step's sign picks the exit test (dynamic
  // via `select`); `frExcl` (`until`) makes it strict — `v < B` not `v <= B`, so `0 until 0` is empty.
  const dynStep = !forRangeStepIsConst(s.frStep)
  let nSlots = 2
  if dynStep { nSlots = 3 }
  const vSlot = declSlotTake(stmtIx, nSlots)
  const bSlot = vSlot + 1
  let sSlot = -1
  if dynStep { sSlot = vSlot + 2 }
  let paramN = 0
  if fnIx >= 0 {
    const fn = nodeAt(fnIx)
    if fn is FuncDecl { paramN = fn.fnParams.length + envSlotShift(fnIx) }
  }
  const vIdx = paramN + vSlot
  const bIdx = paramN + bSlot
  const sIdx = paramN + sSlot
  // A static step is absent (+1), an integer literal or a negated one (`forRangeStepIsConst`).
  // The lexeme must fit i32 before the `parseI32` fold, a negated 2^31 included; the checker
  // refuses an out-of-range step, so the refusals here are backstops.
  let stepK = 1
  if s.frStep >= 0 && !dynStep {
    const litIx = cexLitPeel(s.frStep)
    const neg = intLitIsNegated(s.frStep)
    let folded = false
    if litIx >= 0 {
      const lit = nodeAt(litIx)
      if lit is NumLit {
        const t = lit.numText
        const fits = numLexFitsI32(t) || (neg && numLexIs2Pow31(t))
        if numLexIsFloat(t) || !fits {
          return emitFail(
            "emitProgram: for-range step must be an i32 integer literal",
          )
        }
        stepK = parseI32(t)
        if neg { stepK = 0 - stepK }
        folded = true
      }
    }
    if !folded {
      return emitFail("emitProgram: for-range step must be a constant integer")
    }
  }
  if !dynStep && stepK == 0 {
    return emitFail("emitProgram: for-range step must not be zero")
  }
  // v = A; bound = B (each evaluated once, in source order). A constant bound is compared as
  // the constant itself, so no local carries it and every test reads an immediate.
  const bConst = rangeConstIs(s.frTo, fnIx)
  let bVal = 0
  if bConst { bVal = rangeConstVal(s.frTo, fnIx) }
  if emitExpr(body, s.frFrom, fnIx, ec) < 0 { return -1 }
  fbLocalSet(vIdx)
  if !bConst {
    if emitExpr(body, s.frTo, fnIx, ec) < 0 { return -1 }
    fbLocalSet(bIdx)
  }
  if dynStep {
    if emitExpr(body, s.frStep, fnIx, ec) < 0 { return -1 }
    fbLocalSet(sIdx)
  }
  // The hoist prologue runs AFTER the range bounds (whose expressions may do
  // anything) and BEFORE the loop variable is bound, so its receiver reads
  // resolve in the enclosing scope. `frVar` itself is never a candidate — the
  // body sees it as a fresh i32 binding.
  const frHoist = loopHoistOpen(body, -1, s.frBody, fnIx, s.frVar, "", ec)
  if frHoist < 0 { return -1 }
  const frProof = rangeProofOpen(s, stepK, dynStep)
  // Bind the loop var for the body (mirrors the collect pass's scopeBind).
  scopeBind(s.frVar, vSlot)
  const aConst = rangeConstIs(s.frFrom, fnIx)
  let aVal = 0
  if aConst { aVal = rangeConstVal(s.frFrom, fnIx) }
  let trips = -1
  if aConst && bConst && !dynStep {
    trips = rangeUnrollTrips(s, aVal, bVal, stepK, fnIx)
  }
  let rc = 0
  if trips > 0 {
    rc = emitRangeUnrolled(body, s, fnIx, vIdx, aVal, stepK, trips, ec)
  } else {
    const rt: RangeTest = {
      vIdx: vIdx,
      bIdx: bIdx,
      bConst: bConst,
      bVal: bVal,
      sIdx: sIdx,
      dynStep: dynStep,
      stepK: stepK,
      excl: s.frExcl,
    }
    if rangePartialUnrollOk(s, stepK, dynStep, fnIx) {
      rc = emitRangePartial(body, s, fnIx, rt, ec)
    } else {
      rc = emitRangeRolled(body, s, fnIx, rt, ec)
    }
  }
  loopHoistClose(frHoist)
  rangeProofClose(frProof)
  // The loop variable's scope is the loop (see `scopeUnbind`).
  scopeUnbind()
  rc
}

// A range loop's continue test, its operands resolved: the loop var's local, the bound's local
// or constant, and the step's local or constant. `excl` is the half-open `until`.
type RangeTest = {
  vIdx: i32,
  bIdx: i32,
  bConst: boolean,
  bVal: i32,
  sIdx: i32,
  dynStep: boolean,
  stepK: i32,
  excl: boolean,
}

// Pushes the i32 "`v` is still in range". A dynamic step picks the direction with a `select`,
// and a zero step makes the loop empty, the answer a backwards constant range already gives.
function emitRangeTest(rt: RangeTest) {
  let ascCmp = 76 // 0x4c i32.le_s
  let descCmp = 78 // 0x4e i32.ge_s
  if rt.excl {
    ascCmp = 72  // 0x48 i32.lt_s — half-open ascending
    descCmp = 74 // 0x4a i32.gt_s — half-open descending
  }
  if rt.dynStep {
    fbLocalGet(rt.vIdx)
    emitRangeBound(rt)
    fbI32Bin(ascCmp)  // the ascending test
    fbLocalGet(rt.vIdx)
    emitRangeBound(rt)
    fbI32Bin(descCmp) // the descending test
    fbLocalGet(rt.sIdx)
    fbI32Const(0)
    fbI32Bin(74)      // 0x4a i32.gt_s — is the step positive?
    fbSelect()        // the ascending test iff the step is positive
    fbLocalGet(rt.sIdx)
    fbI32Eqz()
    fbI32Eqz()        // step != 0
    fbI32Bin(113)     // 0x71 i32.and
    return 0
  }
  fbLocalGet(rt.vIdx)
  emitRangeBound(rt)
  if rt.stepK > 0 { fbI32Bin(ascCmp) } else { fbI32Bin(descCmp) }
  0
}

function emitRangeBound(rt: RangeTest) {
  if rt.bConst { fbI32Const(rt.bVal) } else { fbLocalGet(rt.bIdx) }
  0
}

// The range test evaluated at compile time for `v`, for a constant bound and a static step.
function rangeTestHolds(rt: RangeTest, v: i32): boolean {
  const b = rt.bVal
  if rt.stepK > 0 {
    if rt.excl { return v < b }
    return v <= b
  }
  if rt.excl { return v > b }
  v >= b
}

// The range loop, top-tested: `block { loop { br_if block (!test); body; v += K; br loop } }`.
// A bottom-tested `br_if` back-edge is not used: wasmtime runs it up to 2.4x slower
// (DECISIONS.md, "Loops stay top-tested"). A `continue` lands at the end of an inner block, so it
// still steps.
function emitRangeRolled(
  body: u8[],
  s: ForRange,
  fnIx: i32,
  rt: RangeTest,
  ec: ExpCtx,
) {
  fbBlock(64) // 0x02 block, void
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.frLabel)
  fbLoop(64)  // 0x03 loop, void
  loopContDepth.push(ctrlDepth)
  loopContLabel.push(s.frLabel)
  emitRangeTest(rt)
  fbI32Eqz()  // 0x45 invert: exit when out of range
  fbBrIf(1)   // 0x0d br_if -> break out of block
  // a body with a `continue` binding to this loop needs an inner block as the continue
  // target: branching to its end falls into the increment (a branch to the loop header
  // would skip it — an infinite loop). The inner block carries the loop's label too.
  const frHasCont = blockHasContinueFor(s.frBody, s.frLabel, false)
  if frHasCont {
    fbBlock(64) // continue block
    loopContDepth.push(ctrlDepth)
    loopContLabel.push(s.frLabel)
  }
  if emitStmts(body, s.frBody, fnIx, ec) < 0 { return -1 }
  if frHasCont {
    fbEnd() // end continue block — `continue` lands here
    loopContDepth.pop()
    loopContLabel.pop()
  }
  // v = v + K
  fbLocalGet(rt.vIdx)
  if rt.dynStep { fbLocalGet(rt.sIdx) } else { fbI32Const(rt.stepK) }
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(rt.vIdx)
  fbBr(0)       // continue loop
  fbEnd()       // end loop
  loopContDepth.pop()
  loopContLabel.pop()
  fbEnd()       // end block
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  0
}

// The copies per trip of a partially unrolled range loop, and the most nodes its body may hold;
// both are chosen in DECISIONS.md, "Small variable-trip range loops are unrolled 4x".
const PARTIAL_UNROLL_COPIES = 4
const PARTIAL_UNROLL_MAX_NODES = 40

// Whether a range loop that is not fully unrolled runs its body `PARTIAL_UNROLL_COPIES` times per
// trip: a static step of 1, a body that holds no loop, never writes the loop var, and passes
// `unrollCost` (no function, no call but an inline memory intrinsic) within the node cap.
function rangePartialUnrollOk(
  s: ForRange,
  stepK: i32,
  dynStep: boolean,
  fnIx: i32,
): boolean {
  if dynStep || stepK != 1 { return false }
  if stmtAssignsName(s.frBody, s.frVar) { return false }
  partialUnrollCost(s.frBody, fnIx) >= 0
}

// The node count under `ix`, or -1 past `PARTIAL_UNROLL_MAX_NODES` or on a kind outside the
// cheap set: literals and `null`, scalar operators, `is`, locals, field reads, `if`, a `let`,
// `break`/`continue`/`return`, an index into a list or string, an inline memory intrinsic. Any
// other call, a loop, a function, a map index or an allocating literal lowers to far more.
function partialUnrollCost(ix: i32, fnIx: i32): i32 {
  let cnt = 0
  let cur = ix
  while cur >= 0 {
    if cur >= P.nodes.length { return -1 }
    const n = nodeAt(cur)
    let ok = n is NumLit
      || n is CharLit
      || n is BoolLit
      || n is NullLit
      || n is Ident
    ok = ok
      || n is Unary
      || n is BinExpr
      || n is Member
      || n is Paren
      || n is AsExpr
    ok = ok || n is IsExpr || n is TypeRef
    ok = ok || n is IfStmt || n is Block || n is LetDecl || n is BreakStmt
    ok = ok || n is ContinueStmt || n is RetStmt
    if n is Index {
      const r = n.idxArr
      ok = scalarListElemKind(r, fnIx) != null || exprRefArray(r, fnIx)
      ok = ok || exprStringArray(r, fnIx) || exprString(r, fnIx)
    }
    if n is Call { ok = hoistSafeMemCall(cur, fnIx) }
    if !ok { return -1 }
    cnt = cnt + 1
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      if kids[i] >= 0 {
        const c = partialUnrollCost(kids[i], fnIx)
        if c < 0 { return -1 }
        cnt = cnt + c
        if cnt > PARTIAL_UNROLL_MAX_NODES { return -1 }
      }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  cnt
}

// The range loop run as `PARTIAL_UNROLL_COPIES` body copies per trip while that many trips
// remain (`v < bound - D`; a bound too low to subtract runs none), then rolled. Copy `k` stores
// and reads the loop var as `u + k`, `u` the trip's first value, so two reads stay one expression
// and the copies chain no increments. `break` leaves both loops; `continue` ends its own copy.
function emitRangePartial(
  body: u8[],
  s: ForRange,
  fnIx: i32,
  rt: RangeTest,
  ec: ExpCtx,
) {
  fbBlock(64) // 0x02 block, void — the `break` target of both loops
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.frLabel)
  let d = PARTIAL_UNROLL_COPIES - 1
  if !rt.excl { d = d - 1 }
  const intMin = -2147483647 - 1
  // A constant bound too low to subtract from runs no main trip at all.
  const mainRuns = !rt.bConst || rt.bVal >= intMin + d
  if mainRuns {
    let limSlot = -1
    if !rt.bConst {
      // lim = bound >= INT_MIN + d ? bound - d : INT_MIN
      limSlot = strI32Slot()
      fbLocalGet(rt.bIdx)
      fbI32Const(d)
      fbI32Bin(107) // 0x6b i32.sub
      fbI32Const(intMin)
      fbLocalGet(rt.bIdx)
      fbI32Const(intMin + d)
      fbI32Bin(78)  // 0x4e i32.ge_s
      fbSelect()
      fbLocalSet(limSlot)
    }
    const uSlot = strI32Slot()
    fbBlock(64)  // 0x02 block, void — the main loop's exit
    fbLoop(64)   // 0x03 loop, void
    fbLocalGet(rt.vIdx)
    if rt.bConst { fbI32Const(rt.bVal - d) } else { fbLocalGet(limSlot) }
    fbI32Bin(72) // 0x48 i32.lt_s
    fbI32Eqz()
    fbBrIf(1)    // leave the main loop
    fbLocalGet(rt.vIdx)
    fbLocalSet(uSlot)
    const hasCont = blockHasContinueFor(s.frBody, s.frLabel, false)
    const cursor0 = emitLetCursor
    let k = 0
    while k < PARTIAL_UNROLL_COPIES {
      emitLetCursor = cursor0
      if k > 0 {
        fbLocalGet(uSlot)
        fbI32Const(k)
        fbI32Bin(106) // 0x6a i32.add
        fbLocalSet(rt.vIdx)
      }
      urSlot.push(rt.vIdx)
      urVal.push(k)
      urBase.push(uSlot)
      if hasCont {
        fbBlock(64) // this copy's continue block
        loopContDepth.push(ctrlDepth)
        loopContLabel.push(s.frLabel)
      }
      const rc = emitStmts(body, s.frBody, fnIx, ec)
      if hasCont {
        fbEnd()
        loopContDepth.pop()
        loopContLabel.pop()
      }
      urSlot.pop()
      urVal.pop()
      urBase.pop()
      if rc < 0 { return -1 }
      k = k + 1
    }
    emitLetCursor = cursor0
    fbLocalGet(uSlot)
    fbI32Const(PARTIAL_UNROLL_COPIES)
    fbI32Bin(106) // 0x6a i32.add
    fbLocalSet(rt.vIdx)
    fbBr(0)       // next main trip
    fbEnd()       // end loop
    fbEnd()       // end block
  }
  if emitRangeRolled(body, s, fnIx, rt, ec) < 0 { return -1 }
  fbEnd() // end block
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  0
}

// The most trips, and the most body nodes summed over every copy, a range loop is fully unrolled
// at; the two limits are chosen in DECISIONS.md, "Small constant range loops are unrolled".
const UNROLL_MAX_TRIPS = 16
const UNROLL_MAX_NODES = 640
const UNROLL_PUSH_NODES = 16

// The range loop fully unrolled: `trips` copies of the body in one block, copy `k` reading the
// loop var as the constant `A + k*K`. `break` leaves the block and `continue` ends its copy.
// Every copy mints the body's `let`s into the same slots.
function emitRangeUnrolled(
  body: u8[],
  s: ForRange,
  fnIx: i32,
  vIdx: i32,
  aVal: i32,
  stepK: i32,
  trips: i32,
  ec: ExpCtx,
) {
  fbBlock(64) // 0x02 block, void — the `break` target
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.frLabel)
  const hasCont = blockHasContinueFor(s.frBody, s.frLabel, false)
  const cursor0 = emitLetCursor
  let k = 0
  let v = aVal
  while k < trips {
    emitLetCursor = cursor0
    fbI32Const(v)
    fbLocalSet(vIdx)
    urSlot.push(vIdx)
    urVal.push(v)
    urBase.push(-1)
    if hasCont {
      fbBlock(64) // this copy's continue block
      loopContDepth.push(ctrlDepth)
      loopContLabel.push(s.frLabel)
    }
    const rc = emitStmts(body, s.frBody, fnIx, ec)
    if hasCont {
      fbEnd()
      loopContDepth.pop()
      loopContLabel.pop()
    }
    urSlot.pop()
    urVal.pop()
    urBase.pop()
    if rc < 0 { return -1 }
    v = v + stepK
    k = k + 1
  }
  fbEnd() // end block
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  0
}

// The innermost unrolled copy whose loop var is local `idx`, or -1.
function unrolledSlotAt(idx: i32) {
  let j = urSlot.length - 1
  while j >= 0 {
    if urSlot[j] == idx { return j }
    j = j - 1
  }
  -1
}

// The trip count of a constant range loop worth unrolling, or -1. The rolled loop is simulated
// with its own i32 steps, and declined when a step would wrap (the rolled loop then never ends),
// when the body writes the loop var, or when `unrollCost` declines it or its copies exceed
// `UNROLL_MAX_NODES`.
function rangeUnrollTrips(
  s: ForRange,
  aVal: i32,
  bVal: i32,
  stepK: i32,
  fnIx: i32,
) {
  const rt: RangeTest = {
    vIdx: -1,
    bIdx: -1,
    bConst: true,
    bVal: bVal,
    sIdx: -1,
    dynStep: false,
    stepK: stepK,
    excl: s.frExcl,
  }
  let v = aVal
  let t = 0
  while rangeTestHolds(rt, v) {
    t = t + 1
    if t > UNROLL_MAX_TRIPS { return -1 }
    const next = v + stepK
    if stepK > 0 && next < v { return -1 }
    if stepK < 0 && next > v { return -1 }
    v = next
  }
  if t == 0 { return -1 }
  if stmtAssignsName(s.frBody, s.frVar) { return -1 }
  const cost = unrollCost(s.frBody, fnIx, UNROLL_MAX_NODES)
  if cost < 0 || cost * t > UNROLL_MAX_NODES { return -1 }
  t
}

// The node count of the code under `ix`, a nested constant range loop's body counted once per
// trip, or -1 when it holds a function, a call that is not an inline memory intrinsic, or exceeds
// `cap`. A call outweighs the test and step unrolling saves, and the host reads a call inside a
// loop as hot. A build region's push is inline, weighing `UNROLL_PUSH_NODES` more (D3623).
function unrollCost(ix: i32, fnIx: i32, cap: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is FuncDecl { return -1 }
  let cnt = 1
  if n is Call {
    if listBuildRegionOf(ix) >= 0 { cnt = cnt + UNROLL_PUSH_NODES }
    else if !hoistSafeMemCall(ix, fnIx) { return -1 }
  }
  if n is ForRange {
    const inner = rangeStaticTrips(n, fnIx)
    if inner > 0 {
      const b = unrollCost(n.frBody, fnIx, cap)
      if b < 0 { return -1 }
      const tot = 3 + b * inner
      if tot > cap { return -1 }
      return tot
    }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      const c = unrollCost(kids[i], fnIx, cap)
      if c < 0 { return -1 }
      cnt = cnt + c
      if cnt > cap { return -1 }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  cnt
}

// The trip count of a range loop with constant ends and a literal step when it is at most
// `UNROLL_MAX_TRIPS`; 0 for any other.
function rangeStaticTrips(n: ForRange, fnIx: i32) {
  if !forRangeStepIsConst(n.frStep) { return 0 }
  if !rangeConstIs(n.frFrom, fnIx) || !rangeConstIs(n.frTo, fnIx) { return 0 }
  let k = 1
  if n.frStep >= 0 {
    if !rangeConstIs(n.frStep, fnIx) { return 0 }
    k = rangeConstVal(n.frStep, fnIx)
  }
  if k == 0 { return 0 }
  const rt: RangeTest = {
    vIdx: -1,
    bIdx: -1,
    bConst: true,
    bVal: rangeConstVal(n.frTo, fnIx),
    sIdx: -1,
    dynStep: false,
    stepK: k,
    excl: n.frExcl,
  }
  let v = rangeConstVal(n.frFrom, fnIx)
  let t = 0
  while rangeTestHolds(rt, v) && t <= UNROLL_MAX_TRIPS {
    t = t + 1
    v = v + k
  }
  if t > UNROLL_MAX_TRIPS { return 0 }
  t
}

// Whether `ix` is a range end with a compile-time i32 value: an integer literal fitting i32, a
// negated one, either in parens, or an unshadowed module `const` bound to one.
function rangeConstIs(ix: i32, fnIx: i32): boolean {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return false }
  const k = cexLitPeel(x)
  if k >= 0 {
    const lit = nodeAt(k)
    if lit is NumLit {
      return !numLexIsFloat(lit.numText) && numLexFitsI32(lit.numText)
    }
  }
  // Any other kind has a value only as the name of a module `const` bound to one of the above.
  const init = rangeConstInitOf(x, fnIx)
  init >= 0 && rangeConstIs(init, -1)
}

// `rangeConstIs`'s value, paired arm for arm; 0 for a node the predicate refused, so a caller
// asks the predicate first.
function rangeConstVal(ix: i32, fnIx: i32): i32 {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return 0 }
  const k = cexLitPeel(x)
  if k >= 0 {
    const lit = nodeAt(k)
    if lit is NumLit {
      const v = parseI32(lit.numText)
      return if intLitIsNegated(x) { 0 - v } else { v }
    }
  }
  // Any other kind is the name of a module `const`, as `rangeConstIs` accepted it.
  rangeConstVal(rangeConstInitOf(x, fnIx), -1)
}

// The initialiser of the unshadowed module `const` the name at `x` denotes from inside `fnIx`,
// when it is unannotated or `i32` and its initialiser is a literal or a negation; else -1.
function rangeConstInitOf(x: i32, fnIx: i32): i32 {
  const e = nodeAt(x)
  if !(e is Ident) { return -1 }
  const li = globalLetOfSidIn(fnIx, sidOfNode(x), x)
  if li < 0 || li >= P.nodes.length { return -1 }
  const d = nodeAt(li)
  if d is LetDecl {
    if d.letKw != "const" || d.letInit < 0 { return -1 }
    if d.letType >= 0 && tyNameOf(d.letType) != "i32" { return -1 }
    const init = nodeAt(unwrapParen(d.letInit))
    if init is NumLit || init is Unary { return d.letInit }
  }
  -1
}

// A map walk's step after its body: when an insert in the body compacted the map, the entry at
// the cursor lacks the sequence `seqL` saved, and `__map_resync__` moves the cursor to just
// before the first entry with a later sequence, where JS `Map` iteration would go next (D2315).
function emitForInMapResync(mapL: i32, curL: i32, seqL: i32, shape: i32) {
  cmSlot = shape
  // if M.seqs[cursor] != seq { cursor = __map_resync__(M.seqs, M.count, seq) }
  fbLocalGet(mapL)
  fbStructGet(cmMapTy(), 7)
  fbLocalGet(curL)
  fbArrayGet(ia64TypeIdx)
  fbLocalGet(seqL)
  fbI32Bin(82)              // 0x52 i64.ne
  fbIf(64)                  // if, void
  fbLocalGet(mapL)
  fbStructGet(cmMapTy(), 7)
  fbLocalGet(mapL)
  fbStructGet(cmMapTy(), 4) // M.count
  fbLocalGet(seqL)
  fbCall(gHelpMapResync)
  fbLocalSet(curL)
  fbEnd()                   // end (if)
  0
}

// The compaction helper for map shape `sh` (a Set folds onto its key rep's mono map), or -1
// when the module reserved none: nothing deletes, so no entry is ever dead (D2315).
function mapCompactFnOf(sh: i32) {
  const row = mapShapeRow(sh)
  if row < 0 || row >= gHelpMapCompact.length { return -1 }
  gHelpMapCompact[row]
}

// Does the code under `ix` assign the bare name `nm`, outside any nested function?
function stmtAssignsName(ix: i32, nm: string): boolean {
  let cur = ix
  while cur >= 0 {
    const n = nodeAt(cur)
    if n is FuncDecl { return false }
    if n is BinExpr {
      if n.binOp == "=" {
        const t = nodeAt(unwrapParen(n.binLeft))
        if t is Ident {
          if t.identName == nm { return true }
        }
      }
    }
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      if stmtAssignsName(kids[i], nm) { return true }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  false
}

function emitForInStmt(
  body: u8[],
  s: ForIn,
  stmtIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // `for v[, w] in <list> { body }` — iterate an i32 list, a string list, a struct ref list,
  // or a map's ordered keys/values list. Cursor slots in collect pre-order: the element var
  // `v`, a hidden cursor `v#i`, a hidden list temp `v#l` (the iterable evaluates once), and
  // the second name last. Shape mirrors `while`: block/loop, exit on `cursor >= len`, cursor++.
  const ek = forInElemKind(s.fiIter, fnIx)
  if ek == null {
    return emitFailAt("emitProgram: unsupported for-in iterable", s.fiIter)
  }
  // A STRING iterable (`for ch in s`): the `#l` temp IS the raw `(ref $sTypeIdx)` array (no
  // list wrapper), so the length is `array.len` and each element `array.get $aTypeIdx` —
  // skipping the `struct.get wrapTy` the i32-list path uses. The loop var is an i32 code unit.
  const strSrc = forInStringSrc(s.fiIter, fnIx)
  // a packed byte-list iterable (`for b in bs`, `bs: u8[]`): the `#l` temp is the `$bl8`
  // wrapper over the one-byte backing, so length is `struct.get $bl8 1` and each element
  // `array.get_u $ba8` — `fbArrayGet` picks the unsigned opcode off the backing heap index itself.
  const u8Src = forInU8Src(s.fiIter, fnIx)
  if u8Src && !ba8Used {
    return emitFail("emitProgram: u8 for-in but u8 list type not collected")
  }
  // The SECOND name's slot, minted last in the same pre-order the collect pass mints it.
  const pairName = s.fiVar2
  const hasPair = pairName != ""
  let nSlots = 3
  if hasPair { nSlots = 4 }
  const vSlot = declSlotTake(stmtIx, nSlots)
  // An `is K[]` arm's empty list of ref elements never iterates, and its loop slots are
  // typed at the receiver's own element, so the loop is not emitted (D4962).
  if listFitShadowIsRef(s.fiIter, fnIx) { return 0 }
  const iSlot = vSlot + 1
  const lSlot = vSlot + 2
  let pSlot = -1
  if hasPair { pSlot = vSlot + 3 }
  let paramN = 0
  if fnIx >= 0 {
    const fn = nodeAt(fnIx)
    if fn is FuncDecl { paramN = fn.fnParams.length + envSlotShift(fnIx) }
  }
  const vIdx = paramN + vSlot
  const iIdx = paramN + iSlot
  const lIdx = paramN + lSlot
  const pIdx = paramN + pSlot
  // A map's second name is its VALUE; every other iterable's is a dense INDEX. The slot is
  // the vals list's when there is one, and the plain i32 list's for a mono-value map.
  const pairValsSlot = forInPairValsSlot(s.fiIter, fnIx)
  const pairIsVal = hasPair && forInPairIsMapVal(s.fiIter, fnIx)
  let pairWrapTy = lTypeIdx
  let pairBackTy = aTypeIdx
  if pairValsSlot >= 0 {
    pairWrapTy = mvValsWrapOf(pairValsSlot)
    pairBackTy = mvValsBackOf(pairValsSlot)
  }
  // A map pair's value recovers non-null at exactly the element kinds the loop var does, or
  // one spelling recovers and the other traps on a stored null.
  const pairEk = forInPairElemKind(s.fiIter, fnIx)
  const pairRecover = pairIsVal && pairEk != null && forInElemRecovers(pairEk)
  const fb: ForInBacking = {
    wrapTy: lTypeIdx,
    backTy: aTypeIdx,
    hKind: "i32",
    hSlot: 0,
    hOk: true,
  }
  if forInBackingOf(s, fnIx, ek, u8Src, fb) < 0 { return -1 }
  const mapRecv = forInMapRecv(s.fiIter, fnIx)
  const lp: ForInLoop = {
    ek: ek,
    strSrc: strSrc,
    hasPair: hasPair,
    pairIsVal: pairIsVal,
    pairEk: pairEk,
    pairRecover: pairRecover,
    pairWrapTy: pairWrapTy,
    pairBackTy: pairBackTy,
    vIdx: vIdx,
    iIdx: iIdx,
    lIdx: lIdx,
    pIdx: pIdx,
    pCtr: -1,
    fiHBack: -1,
    fiHLen: -1,
    fiSv: -1,
    fiRv: false,
    fiSBack: -1,
    fiSEnd: -1,
    fiSPk: -1,
    mapRecv: mapRecv,
    mwShape: -1,
    fiMap: -1,
    wrapTy: fb.wrapTy,
    backTy: fb.backTy,
    hKind: fb.hKind,
    hSlot: fb.hSlot,
  }
  if mapRecv >= 0 {
    if emitForInMapStash(body, fnIx, lp, ec) < 0 { return -1 }
  }
  // list = <iter> (evaluated once); cursor = 0
  if emitForInList(body, s.fiIter, fnIx, mapRecv, lp.mwShape, ec) < 0 {
    return -1
  }
  // A NARROWED nullable-list iterable keeps its nullable slot at EVERY element kind — the
  // i32-list niche, a distinct-backing scalar list and a ref array alike; the `#l` temp is
  // non-null, so recover first (checker-guarded). See `nulRecvNeedsRecover`.
  if nulRecvNeedsRecover(s.fiIter, fnIx) { fbRefAsNonNull() }
  fbLocalSet(lIdx)
  // A body that cannot reallocate a list (`hoistSafeBlock`: no call, so no push/pop through
  // any alias) sees one backing and one `len` throughout, so both are read once here. Any
  // other body re-reads the header per step, so an element pushed mid-walk is visited.
  if (
    fb.hOk
    && !strSrc
    && mapRecv < 0
    && pairValsSlot < 0
    && hoistSafeBlock(s.fiBody, fnIx)
    && !svHoistBlocked(s.fiIter, fnIx, -1, s.fiBody)
  ) {
    emitForInHoistHeader(lp)
  }
  // A walk whose body may write reads a view's length and elements through its source at every
  // step, as it re-reads a shared list's header (D3028).
  if lp.fiHLen < 0 && (ek == "f64" || ek == "i64") { lp.fiSv = svDstOfKind(ek) }
  lp.fiRv = lp.fiHLen < 0 && fb.hKind == "ref" && rvMayView(fb.hSlot)
  emitForInCursorInit(lp)
  // A body that writes the index gets a hidden counter, and the index is a fresh copy of it
  // each iteration, so the write never moves the walk (D2342).
  if hasPair && !pairIsVal && stmtAssignsName(s.fiBody, pairName) {
    lp.pCtr = strI32Slot()
  }
  if hasPair && !pairIsVal {
    // A dense counter of body executions: the cursor is a backing offset for a string and
    // skips tombstones for a set, so it is not the index at two of the three sequences.
    fbI32Const(0)
    if lp.pCtr >= 0 { fbLocalSet(lp.pCtr) } else { fbLocalSet(pIdx) }
  }
  // The body's own index receivers, as `while` and a range loop hoist theirs.
  const fiHoist = loopHoistOpen(body, -1, s.fiBody, fnIx, s.fiVar, pairName, ec)
  if fiHoist < 0 { return -1 }
  scopeBind(s.fiVar, vSlot)
  if hasPair { scopeBind(pairName, pSlot) }
  if emitForInLoop(body, s, fnIx, lp, ec) < 0 { return -1 }
  loopHoistClose(fiHoist)
  // The loop variables' scope is the loop (see `scopeUnbind`) — one release per name.
  if hasPair { scopeUnbind() }
  scopeUnbind()
  return 0
}

// A map walk's receiver `lp.mapRecv`, evaluated once into the walk's own stash: the walked
// list, the loop bound, the skip's `M.live[cursor]` and the pair's value all read one object.
// The stash is per loop, never the shared mapRef, which any map op in the body rewrites
// (D2313). Writes `lp.mwShape` and `lp.fiMap`; returns -1 when the receiver fails, else 0.
function emitForInMapStash(
  body: u8[],
  fnIx: i32,
  lp: ForInLoop,
  ec: ExpCtx,
): i32 {
  lp.mwShape = mapShapeFoldSet(mapShapeOfExpr(lp.mapRecv, fnIx))
  if pushMapRecvRef(body, lp.mapRecv, fnIx, ec) < 0 { return -1 }
  cmSlot = lp.mwShape
  setMapRef(body) // mapRef — read by `emitForInList`, before any body op rewrites it
  lp.fiMap = forInMapStashSlot(cmMapTy())
  pushMapRef(body)
  fbLocalSet(lp.fiMap)
  0
}

// The header hoist of a walk whose body cannot reallocate the list: the backing and `len`
// read once from the `#l` temp into `lp.fiHBack` and `lp.fiHLen`.
function emitForInHoistHeader(lp: ForInLoop) {
  lp.fiHBack = listBackStashSlot(lp.hKind, lp.hSlot)
  lp.fiHLen = strI32Slot()
  fbLocalGet(lp.lIdx)
  fbStructGet(lp.wrapTy, 0)
  fbLocalSet(lp.fiHBack)
  fbLocalGet(lp.lIdx)
  fbStructGet(lp.wrapTy, 1)
  fbLocalSet(lp.fiHLen)
}

// The walk's cursor start into `lp.iIdx`: 0, or for a string source its start in backing
// coordinates, with the backing, the exit bound and the decoder's packed width in slots of
// their own (`lp.fiSBack`, `lp.fiSEnd`, `lp.fiSPk`), so the loop runs no `struct.get`.
function emitForInCursorInit(lp: ForInLoop) {
  if lp.strSrc {
    lp.fiSBack = strBackSlot()
    lp.fiSEnd = strI32Slot()
    // the packed `(width << 24) | cp` `__utf8_dec__` returns: the loop variable is still a
    // code point, but the stride is now data-dependent, so the width must survive the body
    // to reach the increment. Its own slot per loop, so a nested `for cp in t` cannot clobber it.
    lp.fiSPk = strI32Slot()
    fbLocalGet(lp.lIdx)
    fbStrBack()
    fbLocalSet(lp.fiSBack)
    fbLocalGet(lp.lIdx)
    fbStrStart()
    fbLocalGet(lp.lIdx)
    fbStrLen()
    fbI32Bin(106) // 0x6a i32.add — the one-past-the-end backing offset
    fbLocalSet(lp.fiSEnd)
    fbLocalGet(lp.lIdx)
    fbStrStart()
  } else {
    fbI32Const(0)
  }
  fbLocalSet(lp.iIdx)
}

// The walked list's wrapper and backing types, and the lazy-frame kind and ref slot of its
// backing for the header hoist; `hOk` false where the walked list is a map's, not a list
// wrapper of its own.
type ForInBacking = {
  wrapTy: i32,
  backTy: i32,
  hKind: MfKind,
  hSlot: i32,
  hOk: boolean,
}

// Writes into `fb` the backing of a `for`-in over element kind `ek`; `fb` arrives holding
// the i32 list's. Returns -1 when a ref list has no row, else 0.
function forInBackingOf(
  s: ForIn,
  fnIx: i32,
  ek: VKind,
  u8Src: boolean,
  fb: ForInBacking,
) {
  if ek == "str" || ek == "nulstr" {
    // `string[]` and `(string | null)[]` share one backing (`$mkList` / `$mkArr`, whose
    // element slot is nullable either way) and differ ONLY in the loop var: `str` recovers
    // each element non-null below, `nulstr` keeps the raw `(ref null $aTypeIdx)` so a null
    // element is a value the body can test rather than a trap.
    fb.wrapTy = mkListIdx
    fb.backTy = mkArrIdx
    fb.hKind = "str"
  } else if (
    ek == "struct"
    || ek == "variant"
    || ek == "nulvariant"
    || ek == "union"
    || ek == "nulstruct"
    || ek == "list"
    || ek == "nullist"
    || ek == "strlist"
    || ek == "f64list"
    || ek == "i64list"
    || ek == "f32list"
    || ek == "u8list"
    || ek == "nulstrlist"
    || ek == "nulf64list"
    || ek == "nuli64list"
    || ek == "nulf32list"
    || ek == "nulu8list"
    || ek == "closure"
    || ek == "nulclosure"
    || ek == "reflist"
    || ek == "nulreflist"
    || ek == "map"
    || ek == "nulmap"
  ) {
    // a struct ref list, a union-box element list, a nullable-struct element list, a
    // closure element list, a nested-array scalar inner list, or a nested ref array: the
    // wrapper/backing are this ref-list slot's. All recover each element non-null except
    // the nullable niches. A struct-valued map walk reads its mv slot's vals list instead.
    const fimv = forInMapValsSlot(s.fiIter, fnIx)
    if fimv >= 0 {
      fb.wrapTy = mvValsWrapOf(fimv)
      fb.backTy = mvValsBackOf(fimv)
      fb.hOk = false
    } else {
      const rslot = refListSlotOfExpr(s.fiIter, fnIx)
      if rslot < 0 { return refListRowRefused(s.fiIter) }
      fb.wrapTy = rlWrapIdx[rslot]
      fb.backTy = rlBackIdx[rslot]
      fb.hKind = "ref"
      fb.hSlot = rslot
    }
  } else if ek == "f64" || ek == "i64" || ek == "f32" {
    // A scalar f64/i64/f32 element list: the wrapper/backing come from the descriptor, and
    // `array.get <back>` yields the scalar directly (no `ref.as_non_null`).
    fb.wrapTy = scalarListWrap(ek)
    fb.backTy = scalarListBack(ek)
    fb.hKind = listIdxKindOf(ek)
  } else if u8Src {
    // The packed byte list — the same descriptor pair, keyed on the `#l` temp's kind rather
    // than the loop var's (which is `"i32"`, shared with the i32 list and the string walk).
    fb.wrapTy = scalarListWrap("u8list")
    fb.backTy = scalarListBack("u8list")
    fb.hKind = "u8"
  }
  0
}

// What a `for`-in walk's loop reads from its setup: the element and pair kinds, the loop's
// locals, the hoisted header and string bounds, the map stash, and the backing's types.
type ForInLoop = {
  ek: VKind,
  strSrc: boolean,
  hasPair: boolean,
  pairIsVal: boolean,
  pairEk: VKind | null,
  pairRecover: boolean,
  pairWrapTy: i32,
  pairBackTy: i32,
  vIdx: i32,
  iIdx: i32,
  lIdx: i32,
  pIdx: i32,
  pCtr: i32,
  fiHBack: i32,
  fiHLen: i32,
  fiSv: i32,
  fiRv: boolean,
  fiSBack: i32,
  fiSEnd: i32,
  fiSPk: i32,
  mapRecv: i32,
  mwShape: i32,
  fiMap: i32,
  wrapTy: i32,
  backTy: i32,
  hKind: MfKind,
  hSlot: i32,
}

// The element kinds whose loop var is a non-null ref recovered from a nullable slot.
function forInElemRecovers(ek: VKind): boolean {
  ek == "str"
    || ek == "struct"
    || ek == "variant"
    || ek == "union"
    || ek == "list"
    || ek == "strlist"
    || ek == "f64list"
    || ek == "i64list"
    || ek == "f32list"
    || ek == "u8list"
    || ek == "closure"
    || ek == "reflist"
    || ek == "map"
}

// `emitForInLoop`'s exit test: `br_if 1` out of the break block when cursor >= len (the list
// wrapper's field 1; a STRING compares its backing-coordinate cursor against the pre-computed
// `start + len` bound).
function emitForInExitTest(lp: ForInLoop) {
  fbLocalGet(lp.iIdx)
  if lp.strSrc {
    fbLocalGet(lp.fiSEnd)
  } else if lp.fiHLen >= 0 {
    fbLocalGet(lp.fiHLen)
  } else if lp.fiSv >= 0 {
    fbLocalGet(lp.lIdx)
    fbCall(gHelpSvLen[lp.fiSv])
  } else if lp.fiRv {
    fbLocalGet(lp.lIdx)
    fbCall(gHelpRvLen)
  } else {
    fbLocalGet(lp.lIdx)
    fbStructGet(lp.wrapTy, 1)
  }
  fbI32Bin(78) // 0x4e i32.ge_s
  fbBrIf(1)    // 0x0d br_if -> break out of block
}

// `emitForInLoop`'s tombstone skip over a map walk in a module that deletes: when
// M.live[cursor] == 0, advance the cursor and `br 1` to the loop header without binding `v` or
// running the body. Returns the local holding the entry's sequence for the post-body resync
// (D2315), or -1 when there is none.
function emitForInTombstoneSkip(lp: ForInLoop): i32 {
  let fiSeq = -1
  if lp.mapRecv >= 0 && gMapDeletes {
    cmSlot = lp.mwShape
    // M.live, off the walk's own stash
    fbLocalGet(lp.fiMap)
    fbStructGet(cmMapTy(), 2)
    fbLocalGet(lp.iIdx)
    fbArrayGet(aTypeIdx) // M.live[cursor]
    fbI32Eqz()           // live[cursor] == 0 ?
    fbIf(64)             // 0x04 if, void
    fbLocalGet(lp.iIdx)
    fbI32Const(1)
    fbI32Bin(106)        // cursor + 1
    fbLocalSet(lp.iIdx)
    fbBr(1)              // 0x0c br -> loop header (re-check exit)
    fbEnd()              // 0x0b end (if)
    if gHelpMapResync >= 0 {
      fiSeq = mapSeqSaveSlot()
      fbLocalGet(lp.fiMap)
      fbStructGet(cmMapTy(), 7)
      fbLocalGet(lp.iIdx)
      fbArrayGet(ia64TypeIdx)
      fbLocalSet(fiSeq)
    }
  }
  fiSeq
}

// `emitForInLoop`'s binds: `v = backing[cursor]` (a STRING source decodes the code point at its
// hoisted backing's offset), recovered non-null when `elemRecover`, then a map walk's value or
// the pair counter into the pair local. Returns 0, or -1 failed.
function emitForInBind(s: ForIn, lp: ForInLoop, elemRecover: boolean): i32 {
  const ek = lp.ek
  const iIdx = lp.iIdx
  if ek == "nulnone" {
    // A `null[]` element is never read: its loop var is the `null` cell, null from its default.
  } else if lp.strSrc {
    // pk = __utf8_dec__(backing, cursor, end) ; v = pk & 0x00ffffff
    fbLocalGet(lp.fiSBack)
    fbRefAsNonNull() // the hoist slot is nullable so it stays defaultable;
    // `array.get` tolerated that, a CALL does not.
    fbLocalGet(iIdx)
    fbLocalGet(lp.fiSEnd)
    fbCall(gHelpUtf8Dec)
    fbLocalTee(lp.fiSPk)
    fbI32Const(16777215) // 0x00ffffff — strip the width, keep the code point
    fbI32Bin(113)        // 0x71 i32.and
  } else if lp.fiHBack >= 0 {
    fbLocalGet(lp.fiHBack)
    fbLocalGet(iIdx)
    fbArrayGet(lp.backTy)
  } else if lp.fiSv >= 0 {
    fbLocalGet(lp.lIdx)
    fbLocalGet(iIdx)
    fbCall(gHelpSvGet[lp.fiSv])
  } else if lp.fiRv {
    fbLocalGet(lp.lIdx)
    fbLocalGet(iIdx)
    fbCall(gHelpRvGet)
  } else {
    fbLocalGet(lp.lIdx)
    fbStructGet(lp.wrapTy, 0)
    fbLocalGet(iIdx)
    fbArrayGet(lp.backTy)
  }
  if elemRecover {
    // string/struct/union-box/closure element, or a nested inner-list/ref-list wrapper: all
    // are a non-null ref recovered from the `(ref null <elem>)` slot. Every niche element
    // kind is absent on purpose, since its loop var legitimately holds null — this set and
    // `forInElemKind`'s niche arms are one decision, or a loud reject turns into invalid wasm.
    fbRefAsNonNull()
    if lp.hKind == "ref" && lp.hSlot >= 0 {
      if emitStaleBoxRetag(lp.hSlot, s.fiIter) < 0 { return -1 }
    }
  }
  if ek != "nulnone" { fbLocalSet(lp.vIdx) }
  if lp.pairIsVal && lp.pairEk != "nulnone" {
    // `v = M.vals.backing[cursor]` — the value beside the key just bound, off the walk's
    // stash the tombstone skip already reads, so the receiver is evaluated once.
    cmSlot = lp.mwShape
    fbLocalGet(lp.fiMap)
    fbStructGet(cmMapTy(), 1) // M.vals
    fbStructGet(lp.pairWrapTy, 0)
    fbLocalGet(iIdx)
    fbArrayGet(lp.pairBackTy)
    if lp.pairRecover {
      fbRefAsNonNull() // a non-null value kind off a nullable element slot
    }
    fbLocalSet(lp.pIdx)
  }
  if lp.pCtr >= 0 {
    fbLocalGet(lp.pCtr)
    fbLocalSet(lp.pIdx)
  }
  0
}

// `emitForInLoop`'s step: cursor += <stride>, one element for every source but a string, which
// strides by the UTF-8 width of the sequence just decoded, parked in the high byte of `fiSPk`
// (never 0). A key walk's pair index advances too, on the path the BODY ran, so a deleted
// entry does not consume one.
function emitForInStep(lp: ForInLoop) {
  const iIdx = lp.iIdx
  fbLocalGet(iIdx)
  if lp.strSrc {
    fbLocalGet(lp.fiSPk)
    fbI32Const(24)
    fbI32Bin(118) // 0x76 i32.shr_u
  } else {
    fbI32Const(1)
  }
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(iIdx)
  if lp.hasPair && !lp.pairIsVal {
    let pStep = lp.pIdx
    if lp.pCtr >= 0 { pStep = lp.pCtr }
    fbLocalGet(pStep)
    fbI32Const(1)
    fbI32Bin(106) // 0x6a i32.add
    fbLocalSet(pStep)
  }
}

// A `for`-in walk's break block and loop: the exit test, the map's tombstone skip, the
// element and pair binds, the body and the cursor step. Returns -1 on a failure, else 0.
function emitForInLoop(
  body: u8[],
  s: ForIn,
  fnIx: i32,
  lp: ForInLoop,
  ec: ExpCtx,
) {
  const elemRecover = forInElemRecovers(lp.ek)
  fbBlock(64) // 0x02 block, void
  loopBrkDepth.push(ctrlDepth)
  loopBrkLabel.push(s.fiLabel)
  if (
    lp.fiHBack >= 0
    && !lp.hasPair
    && lp.ek != "nulnone"
    && partialUnrollCost(s.fiBody, fnIx) >= 0
  ) {
    const fiCopies: ForInCopies = {
      back: lp.fiHBack,
      len: lp.fiHLen,
      cursor: lp.iIdx,
      v: lp.vIdx,
      backTy: lp.backTy,
      recover: elemRecover,
    }
    if emitForInCopies(body, s, fnIx, fiCopies, ec) < 0 { return -1 }
  }
  fbLoop(64) // 0x03 loop, void
  loopContDepth.push(ctrlDepth)
  loopContLabel.push(s.fiLabel)
  emitForInExitTest(lp)
  const fiSeq = emitForInTombstoneSkip(lp)
  if emitForInBind(s, lp, elemRecover) < 0 { return -1 }
  // Same INNER continue block as for-range: `continue` must still increment.
  const fiHasCont = blockHasContinueFor(s.fiBody, s.fiLabel, false)
  if fiHasCont {
    fbBlock(64) // continue block
    loopContDepth.push(ctrlDepth)
    loopContLabel.push(s.fiLabel)
  }
  if emitStmts(body, s.fiBody, fnIx, ec) < 0 { return -1 }
  if fiHasCont {
    fbEnd() // end continue block — `continue` lands here
    loopContDepth.pop()
    loopContLabel.pop()
  }
  if fiSeq >= 0 { emitForInMapResync(lp.fiMap, lp.iIdx, fiSeq, lp.mwShape) }
  emitForInStep(lp)
  fbBr(0) // continue loop
  fbEnd() // end loop
  loopContDepth.pop()
  loopContLabel.pop()
  fbEnd() // end block
  loopBrkDepth.pop()
  loopBrkLabel.pop()
  0
}

// The locals and types a `for`-in walk's unrolled copies read: the hoisted backing and `len`,
// the cursor, the loop var, the backing's array type, and whether an element is recovered
// non-null (`ref.as_non_null`) as the rolled walk recovers it.
type ForInCopies = {
  back: i32,
  len: i32,
  cursor: i32,
  v: i32,
  backTy: i32,
  recover: boolean,
}

// Ahead of a hoisted list walk's rolled loop, the walk with its body copied
// `PARTIAL_UNROLL_COPIES` times per trip while that many elements remain; copy `k` binds the
// element at `cursor + k`. The rolled loop then walks the rest from the cursor this leaves.
// Emitted inside the walk's `break` block; `continue` ends its own copy.
function emitForInCopies(
  body: u8[],
  s: ForIn,
  fnIx: i32,
  c: ForInCopies,
  ec: ExpCtx,
) {
  const limSlot = strI32Slot()
  fbLocalGet(c.len)
  fbI32Const(PARTIAL_UNROLL_COPIES - 1)
  fbI32Bin(107) // 0x6b i32.sub — `len` is never negative, so this cannot wrap
  fbLocalSet(limSlot)
  fbBlock(64)   // 0x02 block, void — the main loop's exit
  fbLoop(64)    // 0x03 loop, void
  fbLocalGet(c.cursor)
  fbLocalGet(limSlot)
  fbI32Bin(78)  // 0x4e i32.ge_s
  fbBrIf(1)     // leave the main loop
  const hasCont = blockHasContinueFor(s.fiBody, s.fiLabel, false)
  const cursor0 = emitLetCursor
  let k = 0
  while k < PARTIAL_UNROLL_COPIES {
    emitLetCursor = cursor0
    fbLocalGet(c.back)
    fbLocalGet(c.cursor)
    if k > 0 {
      fbI32Const(k)
      fbI32Bin(106) // 0x6a i32.add
    }
    fbArrayGet(c.backTy)
    if c.recover { fbRefAsNonNull() }
    fbLocalSet(c.v)
    if hasCont {
      fbBlock(64) // this copy's continue block
      loopContDepth.push(ctrlDepth)
      loopContLabel.push(s.fiLabel)
    }
    const rc = emitStmts(body, s.fiBody, fnIx, ec)
    if hasCont {
      fbEnd()
      loopContDepth.pop()
      loopContLabel.pop()
    }
    if rc < 0 { return -1 }
    k = k + 1
  }
  emitLetCursor = cursor0
  fbLocalGet(c.cursor)
  fbI32Const(PARTIAL_UNROLL_COPIES)
  fbI32Bin(106) // 0x6a i32.add
  fbLocalSet(c.cursor)
  fbBr(0)       // next main trip
  fbEnd()       // end loop
  fbEnd()       // end block
  0
}

function emitBreakStmtStmt(_body: u8[], s: BreakStmt, _stmtIx: i32, fnIx: i32) {
  // `break [label]`: branch out of a loop's wrapping block, so control resumes after the
  // whole loop. Unlabelled targets the innermost; `break @outer` scans the parallel label
  // stack from the top. A `break` outside any loop or to an unknown label fails loudly, not with a bad `br`.
  if loopBrkDepth.length == 0 {
    return emitFail("emitProgram: `break` outside a loop")
  }
  const brkAt = loopStackFind(loopBrkLabel, s.brkLabel)
  if brkAt < 0 {
    return emitFail(
      "emitProgram: `break` label does not name an enclosing loop",
    )
  }
  const blkDepth = loopBrkDepth[brkAt]
  // A value leaving a typed frame rides the `br`: the statement before this one stored it.
  if s.brkHasVal == 1 {
    let k = lvFrameDepth.length - 1
    while k >= 0 {
      if lvFrameDepth[k] == blkDepth {
        fbLocalGet(localIndexOf(fnIx, lvFrameName[k]))
        k = 0
      }
      k = k - 1
    }
  }
  fbBr(ctrlDepth - blkDepth) // 0x0c br to the loop's wrapping block
  return 0
}

function emitContinueStmtStmt(
  _body: u8[],
  s: ContinueStmt,
  _stmtIx: i32,
  _fnIx: i32,
) {
  // `continue [label]`: branch to a loop's continue target — the loop header for a
  // `while`, the inner continue block for a `for` (fall into the increment). Unlabelled
  // targets the innermost; `continue @outer` scans the label stack from the top.
  if loopContDepth.length == 0 {
    return emitFail("emitProgram: `continue` outside a loop")
  }
  const contAt = loopStackFind(loopContLabel, s.contLabel)
  if contAt < 0 {
    return emitFail(
      "emitProgram: `continue` label does not name an enclosing loop",
    )
  }
  const loopDepth = loopContDepth[contAt]
  fbBr(ctrlDepth - loopDepth) // 0x0c br to the loop's continue target
  return 0
}

// Lower a function's top-level body block at `blockIx`: every statement but the last is
// lowered normally; if the last statement is a bare value expression, it is lowered as
// the function's return value (VL's implicit-return idiom). A last statement that is
// itself a real statement is lowered unchanged. An empty body is left to existing validation.
export function emitFuncBody(body: u8[], blockIx: i32, fnIx: i32, ec: ExpCtx) {
  const b = nodeAt(blockIx)
  if b is Block {
    // Which of this function's string bindings are loop accumulators. Runs here rather
    // than in `emitFuncCode` because nothing before the body needs the answer, and the
    // set is stamped with `fnIx` so a body that never scanned cannot read a stale one.
    strAccScan(blockIx, fnIx)
    // The declaration-time address fold's table: a node index is a row at most once, but the
    // scratch slots it names are per-function, so both are cleared here.
    maFoldDeclIx = []
    maFoldWasmSlot = []
    maFoldK = []
    maFoldCursor = 0
    hmFn = -2
    // Enter the function's top-level lexical scope (mirrors `collectLocals` on the body
    // block). The emit-time scope stack drives same-named-local resolution.
    scopePush()
    const stmts = b.blkStmts
    const n = stmts.length
    // A guard `if` (no else, then-branch always returns) narrows the REST of the
    // body to the guard's complement (the host's post-early-return flow narrowing).
    const savedGuardTop = narrowTop
    // void-context discard: in a void function, a value-bearing tail is not the
    // function's result — it lowers through the ordinary statement path (`emitStmt`),
    // which evaluates it for effect and drops what it leaves. Keyed on the function's void
    // classification (`fRetVoid`), never on the tail's shape.
    let bodyIsVoid = false
    const vfPos = fnStmtsPosOf(fnIx)
    if vfPos >= 0 && vfPos < fRetVoid.length {
      if fRetVoid[vfPos] == 1 { bodyIsVoid = true }
    }
    let i = 0
    while i < n {
      preStmtNarrow(stmts[i])
      const isLast = i == n - 1 && !bodyIsVoid
      // Banked after whichever arm lowers it: an implicit return leaves through
      // `emitReturnExit`, so hooking the plain arm alone missed the tail statement.
      const tlAt = body.length
      if isLast && blockTailIsDead(stmts) {
        if emitDeadTail(body, stmts, fnIx, ec) < 0 {
          scopePop()
          return -1
        }
      } else if isLast && stmtIsTailValue(stmts[i], fnIx) {
        // Implicit return: seed the return context + push the value (so a trailing
        // `null` / nullable value boxes or sentinels exactly like `return e`), then
        // terminate the exit.
        if emitTailReturnExit(body, stmts[i], fnIx, ec) < 0 {
          scopePop()
          return -1
        }
      } else if isLast && lastStmtIsValueIf(stmts[i], fnIx) {
        // The body ends in an `if`/`else` whose arms each yield a value (implicit
        // return) rather than `return`ing — lower it tail-aware so each arm's trailing
        // value expression becomes the function's return.
        if emitIfTail(body, stmts[i], fnIx, ec) < 0 {
          scopePop()
          return -1
        }
      } else if isLast && memberCallYieldsValue(stmts[i]) {
        // D1240 — the tail member call of a non-void function is its result (`isLast` is
        // already gated on `!bodyIsVoid`), so it takes the same exit as any other tail
        // value — else the discard arm in `emitCallStmt` drops it under a functype that
        // promises a result, a trap where a refusal belongs.
        if emitReturnExit(body, stmts[i], fnIx, ec) < 0 {
          scopePop()
          return -1
        }
      } else if isLast && elseLessNullableTail(stmts[i], fnIx) {
        // the body ends in an else-less `if` whose then-arm yields a value and whose
        // return type is nullable: lower it tail-aware (the then-arm returns its value);
        // the false fall-through is lowered as `null` by the function-end padding. Gated
        // on the final `fRetVoid`/nullable classification, unlike the fixpoint-feeding predicates.
        if emitIfTail(body, stmts[i], fnIx, ec) < 0 {
          scopePop()
          return -1
        }
      } else {
        voidTailAt = -1
        if bodyIsVoid && i == n - 1 { voidTailAt = stmts[i] }
        const rcIn = emitStmtIn(body, stmts, i, fnIx, ec)
        voidTailAt = -1
        if rcIn < 0 {
          scopePop()
          return -1
        }
      }
      bankBodyStmtSpan(stmts[i], fnIx, tlAt, body.length)
      // A statically-TRUE `is` guard that always returns ends this instance's body.
      if monoStaticGuardEndsBlock(stmts[i], fnIx) {
        fbUnreachable() // 0x00 (dead padding — the cut path never runs)
        // D932 — the truncated statements' `let`s still own their collect-allocated
        // slots; a sibling emitted after this BLOCK (not after the function) would
        // otherwise bind one slot early. See `cursorSlotsUnder`.
        let cutAt = i + 1
        while cutAt < n {
          cursorAdvance(cursorSlotsUnder(stmts[cutAt]))
          cutAt = cutAt + 1
        }
        i = n
      } else {
        pushPostGuardNarrow(stmts[i], fnIx)
        i = i + 1
      }
    }
    restoreNarrow(savedGuardTop)
    scopePop()
    return 0
  }
  emitFail("emitProgram: function has no block body")
}

// The `Index` node `emitExpr` is lowering under `emitIndexBanked`, so the re-entry lowers it.
let idxSpanNode = -1

// Whether element reads bank their own `vl-src` row: only when the section is written at all.
function idxSpanOn(): boolean { gEmitNames != 0 && gEmitSrcMap != 0 }

// Lowers element read `exprIx` and banks its byte range as an element-read span row, so a
// trap in it resolves to the read's own column rather than its statement's. Adds no code:
// the row lands only in the `vl-src` section, and only when `body` is the buffer written.
function emitIndexBanked(body: u8[], exprIx: i32, fnIx: i32, ec: ExpCtx): i32 {
  const outer = idxSpanNode
  const from = body.length
  const direct = curBuf.length == from
  idxSpanNode = exprIx
  const r = emitExpr(body, exprIx, fnIx, ec)
  idxSpanNode = outer
  const to = body.length
  if r < 0 || !direct || to <= from { return r }
  let pos = -1
  if fnIx >= 0 { pos = fnStmtsPosOf(fnIx) }
  bankSpanRow(exprIx, pos, from, to, 6, "")
  r
}

// Banks a statement's byte range, so a trap frame resolves to the line the instruction came
// from rather than the declaration. Kind 5 inside a function, kind 1 at module scope — the row
// `emitStartFnCode` already banks there. A statement that emitted no bytes gets no row.
function bankBodyStmtSpan(stmtIx: i32, fnIx: i32, from: i32, to: i32) {
  if to <= from { return 0 }
  if fnIx < 0 { return bankSpanRow(stmtIx, -1, from, to, 1, "") }
  bankSpanRow(stmtIx, fnStmtsPosOf(fnIx), from, to, 5, "")
}

// Lower every statement of the block at `blockIx` onto `body`, in order. Returns 0,
// or -1 (via `emitFail`) on a non-block node or an unsupported statement within.
function emitStmts(body: u8[], blockIx: i32, fnIx: i32, ec: ExpCtx) {
  const b = nodeAt(blockIx)
  if b is Block {
    // A nested block (if-then / if-else / while-body) is its own lexical scope (mirrors
    // `collectLocals` recursing into it): push a frame so its `let`s shadow correctly and
    // are dropped on exit.
    scopePush()
    const stmts = b.blkStmts
    // Post-guard complement narrowing (see `emitFuncBody`/`pushPostGuardNarrow`).
    const savedGuardTop = narrowTop
    let i = 0
    while i < stmts.length {
      // The statement's own byte range, so a trap frame names the line the instruction came
      // from rather than the declaration (ROADMAP row 22). Offsets are relative to `body`;
      // `emitFuncCode` rebases them onto the module with the rest of this frame's rows.
      const stmtAt = body.length
      preStmtNarrow(stmts[i])
      if emitStmtIn(body, stmts, i, fnIx, ec) < 0 {
        scopePop()
        return -1
      }
      bankBodyStmtSpan(stmts[i], fnIx, stmtAt, body.length)
      if monoStaticGuardEndsBlock(stmts[i], fnIx) {
        fbUnreachable() // 0x00 — see `monoStaticGuardEndsBlock`
        // D932 — slot accounting over the truncated tail; see `cursorSlotsUnder`.
        let cutAt = i + 1
        while cutAt < stmts.length {
          cursorAdvance(cursorSlotsUnder(stmts[cutAt]))
          cutAt = cutAt + 1
        }
        i = stmts.length
      } else {
        pushPostGuardNarrow(stmts[i], fnIx)
        i = i + 1
      }
    }
    restoreNarrow(savedGuardTop)
    scopePop()
    return 0
  }
  emitFail("emitProgram: function has no block body")
}

// Lower a block at `blockIx` that sits in tail position (its value is the enclosing
// function's return value). Every statement but the last is lowered normally; the last
// is lowered tail-aware via `emitStmtTail`. The structured-block analogue of
// `emitFuncBody`'s top-level implicit-return handling.
function emitStmtsTail(body: u8[], blockIx: i32, fnIx: i32, ec: ExpCtx) {
  const b = nodeAt(blockIx)
  if b is Block {
    const stmts = b.blkStmts
    const n = stmts.length
    if n == 0 { return emitFail("emitProgram: empty block in tail position") }
    // A tail-position nested block is its own lexical scope too (mirrors `collectLocals`).
    scopePush()
    // Post-guard complement narrowing (see `emitFuncBody`/`pushPostGuardNarrow`) —
    // pushed in the loop, active for the TAIL statement, restored on exit.
    const savedGuardTop = narrowTop
    let i = 0
    let cut = false
    while i < n - 1 {
      preStmtNarrow(stmts[i])
      if emitStmtIn(body, stmts, i, fnIx, ec) < 0 {
        scopePop()
        return -1
      }
      if monoStaticGuardEndsBlock(stmts[i], fnIx) {
        fbUnreachable() // 0x00 — see `monoStaticGuardEndsBlock`
        // D932 — slot accounting over the truncated tail (the un-emitted tail
        // statement included); see `cursorSlotsUnder`.
        let cutAt = i + 1
        while cutAt < n {
          cursorAdvance(cursorSlotsUnder(stmts[cutAt]))
          cutAt = cutAt + 1
        }
        cut = true
        i = n - 1
      } else {
        pushPostGuardNarrow(stmts[i], fnIx)
        i = i + 1
      }
    }
    let rc = 0
    if !cut && blockTailIsDead(stmts) {
      rc = emitDeadTail(body, stmts, fnIx, ec)
    } else if !cut {
      preStmtNarrow(stmts[n - 1])
      rc = emitStmtTail(body, stmts[n - 1], fnIx, ec)
    }
    restoreNarrow(savedGuardTop)
    scopePop()
    return rc
  }
  emitFail("emitProgram: function has no block body")
}

// Lowers a dead tail as `unreachable`, keeping the slots its locals own; a nested function
// declaration still takes the statement path. Returns 0, or -1.
function emitDeadTail(body: u8[], stmts: i32[], fnIx: i32, ec: ExpCtx): i32 {
  const t = stmts[stmts.length - 1]
  if nodeAt(t) is FuncDecl {
    if emitStmtIn(body, stmts, stmts.length - 1, fnIx, ec) < 0 { return -1 }
  } else {
    cursorAdvance(cursorSlotsUnder(t))
  }
  fbUnreachable() // 0x00 — the predecessor exited
  0
}

// Lower the single statement at `stmtIx` in TAIL position. A bare tail value becomes
// `emitExpr` + `return`; a nested `if`/`else` recurses tail-aware into its arms; any
// other statement (an explicit `return`, a `while`, etc.) is lowered unchanged by
// `emitStmt` (it already exits or falls through on its own). Returns 0, or -1.
function emitStmtTail(body: u8[], stmtIx: i32, fnIx: i32, ec: ExpCtx) {
  const s = nodeAt(stmtIx)
  if s is IfStmt { return emitIfTail(body, stmtIx, fnIx, ec) }
  if stmtIsTailValue(stmtIx, fnIx) {
    // An if-tail arm's implicit return — seed the return context (so a `null` arm
    // boxes / sentinels per the function's return type) exactly like `emitFuncBody`.
    return emitTailReturnExit(body, stmtIx, fnIx, ec)
  }
  // D1240 — an if-ARM tail member call is a value for the same reason a body tail is: this
  // path is reached only from `emitIfTail`, i.e. only where the arms ARE the result.
  if memberCallYieldsValue(stmtIx) {
    return emitReturnExit(body, stmtIx, fnIx, ec)
  }
  emitStmt(body, stmtIx, fnIx, ec)
}

// Lower an `if`/`else` at `stmtIx` whose value is the function's return value (tail
// position): each arm is lowered with its last statement tail-aware (`emitStmtsTail`).
// Mirrors `emitStmt`'s void-if shape, but routes the arm bodies through the tail path.
function emitIfTail(body: u8[], stmtIx: i32, fnIx: i32, ec: ExpCtx) {
  // An `else if` chain is lowered along its spine, as `emitIfStmtStmt` lowers one (D1990).
  const open: i32[] = []
  let cur = stmtIx
  while cur >= 0 {
    const at = cur
    cur = -1
    if at < 0 || at >= P.nodes.length {
      return emitFail("emitProgram: emitIfTail: not an if statement")
    }
    const sw = emitIntSwitch(body, at, fnIx, 1, 64, "i32", -1, ec)
    if sw < 0 { return -1 }
    if sw == 0 {
      const s = nodeAt(at)
      if s is IfStmt {
        const rc = emitIfLinkTail(body, s, fnIx, open, ec)
        if rc < 0 { return -1 }
        if rc == 1 { cur = s.ifElse }
      } else {
        return emitFail("emitProgram: emitIfTail: not an if statement")
      }
    }
  }
  closeIfChainFrames(open, 0, false)
}

// One link of `emitIfTail`'s chain, with `emitIfLinkStmt`'s contract: 0 closed, -1 failed, 1
// left open for the next link with its else restore target pushed onto `open`.
function emitIfLinkTail(
  body: u8[],
  s: IfStmt,
  fnIx: i32,
  open: i32[],
  ec: ExpCtx,
) {
  // D932 — the tail-position twin of `emitIfStmtStmt`'s dead-arm skip, same byte-read
  // gate (`emittedCondConst`), same slot accounting (`cursorSlotsUnder`). The tail form
  // is the same defect one position over: `function f(v) { if v is string { "\"" + v }
  // else { "o" } }` emitted the statically-false arm's narrowed use in the i32 instance.
  const condStart = wLen()
  if emitCondExpr(body, s.ifCond, fnIx, ec) < 0 { return -1 }
  const staticGuard = staticIsGuard(s.ifCond, condStart)
  fbIf(64) // 0x04 if, 0x40 void blocktype
  const savedTop = narrowTop
  const narrowed = setNarrowFromCond(s.ifCond, fnIx)
  if staticGuard != 0 {
    if emitStmtsTail(body, s.ifThen, fnIx, ec) < 0 { return -1 }
  } else {
    cursorAdvance(cursorSlotsUnder(s.ifThen))
  }
  if narrowed { restoreNarrow(savedTop) }
  if s.ifElse >= 0 && staticGuard != 1 {
    fbElse() // 0x05 else
    // A VALUE union narrows to the COMPLEMENT set in the else-arm (see emitStmt).
    const savedElseTop = narrowTop
    const narrowedElse = setNarrowFromCondElse(s.ifCond, fnIx)
    const els = nodeAt(s.ifElse)
    if els is IfStmt {
      // `else if`: the next link, still in tail position.
      if narrowedElse { open.push(savedElseTop) } else { open.push(-1) }
      return 1
    }
    if els is Block {
      if emitStmtsTail(body, s.ifElse, fnIx, ec) < 0 { return -1 }
    } else {
      if emitStmtTail(body, s.ifElse, fnIx, ec) < 0 { return -1 }
    }
    if narrowedElse { restoreNarrow(savedElseTop) }
  } else if s.ifElse >= 0 {
    cursorAdvance(cursorSlotsUnder(s.ifElse))
  }
  fbEnd() // 0x0b end
  return 0
}

// `global.get` of heap-window global `which` (0 base, 1 limit). A miss is the scan and the
// section disagreeing about whether the pair exists, which no program can spell.
function emitHeapWindowRead(nArgs: i32, which: i32, name: string) {
  if nArgs != 0 {
    return emitFail(
      "emitProgram: internal: "
        + name
        + " reached with arguments — the checker's arity rule refuses it",
    )
  }
  if gHeapGlobalIdx < 0 {
    return emitFail(
      "emitProgram: "
        + name
        + " read, but the heap-window globals were not emitted",
    )
  }
  fbGlobalGet(gHeapGlobalIdx + which)
  0
}

// The wasm global index of the user global at `globalStmts` position `gi`. Imported globals
// (`extern let`) occupy 0..nImp-1 and answer their link row; the string-literal pool follows,
// then the defined cells. A promoted (G2c) or imported binding emits no cell, so survivors
// are re-densified by `gCellIdx`.
export function userGlobalIdx(gi: i32) {
  const nImp = externGlobalCount()
  if gi < 0 || gi >= gCellIdx.length { return nImp + gStrPoolTexts.length + gi }
  if nImp > 0 {
    const link = externGlobalLinkOfNode(globalStmts[gi])
    if link >= 0 { return link }
  }
  nImp + gStrPoolTexts.length + gCellIdx[gi]
}

// the storage-class chokepoint for a user top-level binding: every user cell's `0x23`/`0x24`
// goes through this pair, so cell, local or immediate is one decision no emit site can bypass.
// A promoted binding read outside the start function's frame is rejected loudly; a folded
// const is its immediate, never uninitialised, so it takes no guard.
export function emitUserGlobalGet(gi: i32) {
  if gi >= 0 && gi < gFoldOk.length && gFoldOk[gi] == 1 {
    return emitFoldedConstRead(gi)
  }
  if gi >= 0 && gi < gPromoOk.length && gPromoOk[gi] == 1 {
    if !gPromoInStart || gPromoSlot[gi] < 0 {
      return emitFail(
        "emitProgram: promoted top-level binding read outside the top-level statement list",
      )
    }
    fbLocalGet(gPromoSlot[gi])
    return 0
  }
  if initGuardNeeded(gi, false) {
    if emitInitGuard(gi, "read") < 0 { return -1 }
  }
  fbGlobalGet(userGlobalIdx(gi))
  0
}

// Writes the immediate `captureFoldedConsts` banked for folded const `gi`. A read before the
// capture ran has no cell to fall back on, so it fails loudly.
function emitFoldedConstRead(gi: i32) {
  if gi >= gFoldAt.length || gi >= gFoldLen.length || gFoldAt[gi] < 0 {
    return emitFail(
      "emitProgram: a folded module const read before its value was captured",
    )
  }
  const at = gFoldAt[gi]
  const end = at + gFoldLen[gi]
  if end > gFoldPool.length {
    return emitFail(
      "emitProgram: a folded module const read past its banked bytes",
    )
  }
  relFoldNote(gi)
  let k = at
  while k < end {
    wU8(gFoldPool[k])
    k = k + 1
  }
  0
}

// Set while an assignment's value re-reads the global it just stored (`emitBinExprNode`).
let initGuardOff = false

// The earliest top-level position at which `fnStmts[p]` can run: its own, else its enclosing
// frame's or its instance origin's, `INIT_REACH_NEVER` when no top-level code names any of them.
function initFnReachOf(p: i32): i32 {
  let best = INIT_REACH_NEVER
  let cur = p
  let steps = 0
  while cur >= 0 && cur < gInitFnReach.length && steps <= gInitFnReach.length {
    if gInitFnReach[cur] < best { best = gInitFnReach[cur] }
    let up = -1
    if cur < fnParent.length { up = fnParent[cur] }
    if up < 0 && cur < fnInstOrigin.length { up = fnInstOrigin[cur] }
    cur = up
    steps = steps + 1
  }
  best
}

// Whether a read (a write, when `write`) of guarded global `gi` at the cursor can run before it
// holds its value: in the start function, at or before its declaration (the checker orders the
// rest); in a function body, when top-level code at or before `gInitAt[gi]` can call it, or when
// no top-level code names it at all.
function initGuardNeeded(gi: i32, write: boolean): boolean {
  if !gInitAny || initGuardOff { return false }
  if gi < 0 || gi >= gInitGuard.length || gi >= globalStmtOrd.length {
    return false
  }
  if gInitGuard[gi] != 1 && !(write && gInitGuard[gi] == 2) { return false }
  // No initializer runs later to overwrite an early write.
  const d = nodeAt(globalStmts[gi])
  if d is LetDecl {
    if write && d.letInit < 0 { return false }
  }
  if gPromoInStart {
    return gInitStartOrd >= 0 && gInitStartOrd <= globalStmtOrd[gi]
  }
  if emitCurFnPos < 0 || gi >= gInitAt.length { return false }
  const r = initFnReachOf(emitCurFnPos)
  r == INIT_REACH_NEVER || r <= gInitAt[gi]
}

// The value the progress cell holds once global `gi` has its value: one past its rank.
export function initGuardValue(gi: i32): i32 {
  if gi < 0 || gi >= gInitRank.length { return gi + 1 }
  gInitRank[gi] + 1
}

// The source name of the function being lowered, for the guard's `via` clause: its declared
// name, else its instance origin's, else the binding a lambda is bound to, else "".
function initGuardFnName(p: i32): string {
  let cur = p
  let steps = 0
  while cur >= 0 && cur < fnStmts.length && steps <= fnStmts.length {
    const tk = declNameTokOf(fnStmts[cur])
    if tk >= 0 && tk < P.toks.length { return P.toks[tk].text }
    if cur < fnDispNames.length && fnDispNames[cur] != "" {
      return fnDispNames[cur]
    }
    // A monomorphized instance keeps its origin's name before the `$` its pin appends.
    const fd = nodeAt(fnStmts[cur])
    if fd is FuncDecl {
      let cut = 0
      while cut < fd.fnName.length && fd.fnName[cut] != '$' { cut = cut + 1 }
      const base = fd.fnName.slice(0, cut)
      if base != "" && base.slice(0, 8) != "__lambda" { return base }
    }
    let up = -1
    if cur < fnInstOrigin.length { up = fnInstOrigin[cur] }
    cur = up
    steps = steps + 1
  }
  ""
}

// The `gInitGNames`/`gInitGLocs` row of global `gi`, interned on first use: its source
// name, and where it is declared.
function initGuardGlobalRow(gi: i32): i32 {
  let k = 0
  while k < gInitGIdx.length {
    if gInitGIdx[k] == gi { return k }
    k = k + 1
  }
  const text = initGuardGlobalText(gi)
  gInitGIdx.push(gi)
  gInitGNames.push(text[0])
  gInitGLocs.push(text[1])
  gInitGIdx.length - 1
}

// Global `gi`'s guard texts: its quoted source name, and where it is declared.
export function initGuardGlobalText(gi: i32): string[] {
  const d = nodeAt(globalStmts[gi])
  let name = ""
  if d is LetDecl { name = d.letName }
  let tk = declNameTokOf(globalStmts[gi])
  if tk >= 0 && tk < P.toks.length { name = P.toks[tk].text }
  if tk < 0 && globalStmts[gi] < nodeToks.length {
    tk = nodeToks[globalStmts[gi]]
  }
  let where = ""
  if tk >= 0 && tk < P.toks.length {
    const file = srcmapFileOfTok(tk)
    if file == "" {
      where = " (line " + i32ToStr(P.toks[tk].line) + ")"
    } else {
      where = " (" + file + ":" + i32ToStr(P.toks[tk].line) + ")"
    }
  }
  ["`" + name + "` ", where]
}

// The `gInitReaders` row naming the function being lowered (empty in the start function),
// interned on first use.
function initGuardReaderRow(): i32 {
  let via = ""
  if !gPromoInStart {
    const fname = initGuardFnName(emitCurFnPos)
    if fname == "" { via = ", via a closure" } else { via = ", via " + fname }
  }
  let k = 0
  while k < gInitReaders.length {
    if gInitReaders[k] == via { return k }
    k = k + 1
  }
  gInitReaders.push(via)
  gInitReaders.length - 1
}

// Calls `__init_fail__` when the progress cell has not yet passed global `gi` (D2652);
// `verb` is "read" or "written".
function emitInitGuard(gi: i32, verb: string) {
  if gInitProgIdx < 0 || gHelpInitFail < 0 || gImports < 4 {
    return emitFail("emitProgram: read-before-init guard with no progress cell")
  }
  fbGlobalGet(gInitProgIdx)
  fbI32RelOf(RS_GUARD, gi, initGuardValue(gi) + relSkew(RS_GUARD))
  fbI32Bin(72)          // 0x48 i32.lt_s
  fbIf(64)              // 0x40 void
  fbI32RelOf(RS_GNAME, gi, initGuardGlobalRow(gi) + relSkew(RS_GNAME))
  if verb == "written" { fbI32Const(1) } else { fbI32Const(0) }
  const rr = initGuardReaderRow()
  fbI32RelOf(RS_GREAD, rr, rr + relSkew(RS_GREAD))
  fbCall(gHelpInitFail) // never returns
  fbEnd()
  0
}

// The write half of the chokepoint above — `local.set` into the start function's frame
// for a promoted binding, else `global.set` of its cell.
export function emitUserGlobalSet(gi: i32) {
  if gi >= 0 && gi < gPromoOk.length && gPromoOk[gi] == 1 {
    if !gPromoInStart || gPromoSlot[gi] < 0 {
      return emitFail(
        "emitProgram: promoted top-level binding written outside the top-level statement list",
      )
    }
    fbLocalSet(gPromoSlot[gi])
    return 0
  }
  // An immutable cell is written only by its constexpr; a store here would be invalid wasm.
  if globalCellIsImmutable(gi) {
    return emitFail("emitProgram: a store to an immutable module const")
  }
  // A write a function can make before the initializer ran would be overwritten by it (D2654);
  // the start function's own writes are its initializers and the checker orders the rest.
  if !gPromoInStart && initGuardNeeded(gi, true) {
    if emitInitGuard(gi, "written") < 0 { return -1 }
  }
  fbGlobalSet(userGlobalIdx(gi))
  0
}

// ── explicit expected-type context (N20) ──────────────────────────────────────
// The expected-type seeds travel as the `ec` parameter of every emitter that reaches
// `emitExpr`. A site copies its caller's context (`expCtxHere`), overrides what it knows,
// and hands the copy to `emitExprExpect`; the record a compile starts from is `expCtxDefault`.
export type ExpCtx = {
  nulBool: boolean,     // a bare `null` is the sentinel 2
  nulLitUnion: boolean, // a bare `null` is the sentinel -1
  nulString: boolean,   // a bare `null` is `ref.null $sTypeIdx`
  rawNullRead: boolean, // a nullable read stays the RAW ref
  litUnion: i32,        // a member StrLit lowers as its atom id
}

// The context no destination has seeded: every field at its inert value.
export function expCtxDefault(): ExpCtx {
  const c: ExpCtx = {
    nulBool: false,
    nulLitUnion: false,
    nulString: false,
    rawNullRead: false,
    litUnion: 0,
  }
  return c
}

// Whether a `string | null` read stays the raw nullable ref rather than recovering with
// `ref.as_non_null`: under a null test (`rawNullRead`) or a nullable-string target
// (`nulString`), where recovering would trap. The reads and the `??` block type both ask it.
function nulStrReadStaysRaw(ctx: ExpCtx) { ctx.rawNullRead || ctx.nulString }

// A copy of `ec`, the base a site starts from, overriding only the fields it knows.
export function expCtxHere(ec: ExpCtx): ExpCtx {
  const c: ExpCtx = {
    nulBool: ec.nulBool,
    nulLitUnion: ec.nulLitUnion,
    nulString: ec.nulString,
    rawNullRead: ec.rawNullRead,
    litUnion: ec.litUnion,
  }
  return c
}

// Copies `c` into `ec` field by field, so a caller holding `ec` sees the new seeds and a
// later edit to `c` does not reach it.
export function expCtxApply(c: ExpCtx, ec: ExpCtx) {
  ec.nulBool = c.nulBool
  ec.nulLitUnion = c.nulLitUnion
  ec.nulString = c.nulString
  ec.rawNullRead = c.rawNullRead
  ec.litUnion = c.litUnion
  0
}

// Puts this module's per-compile stashes, depths and memo cursors back to their declared
// values: an earlier compile that stopped on a failure path may have left one set.
export function wasmEmitStateReset() {
  arrNewFillDepth = 0
  eqStashL = -1
  eqStashR = -1
  gForIterLit = -1
  hmFn = -2
  hmIdxSeen = 0
  idxSpanNode = -1
  initGuardOff = false
  letSibPos = -1
  letSibStmts = []
  lmaAddrK = 0
  lmaAddrNode = -1
  lmaAddrRest = -1
  lmaCallerFn = -1
  lmaValArg = -1
  lmaValNode = -1
  mapUnboxHeld = -1
  recCopyHeld = -1
  mfSrcSlot = -1
  mfSvDst = -1
  negGuardCond = -1
  negGuardFn = -1
  negGuardVal = -1
  njBin = -1
  njDepth = 0
  njLIx = -1
  njLLit = false
  njLSlot = -1
  njLTys = []
  njLUnion = false
  njOp = ""
  njRIx = -1
  njRLit = false
  njRSlot = -1
  njRTys = []
  njRUnion = false
  njResBox = false
  nulWidenWriteRhs = -1
  saFnIx = 0 - 2
  ssArmBin = -1
  ssArmMode = 0
  ssArmRhs = -1
  voidTailAt = -1
  0
}

// Restore the context `saved` and hand back `r`: the exit of a site that applied its own
// context, on its success and its failure paths alike.
function expCtxLeave(saved: ExpCtx, r: i32, ec: ExpCtx): i32 {
  expCtxApply(saved, ec)
  r
}

// Sets the literal-union seed to `atom` and returns the seed it replaced, for a second call to
// put back; no other ambient seed is touched.
function expCtxSwapLitUnion(atom: i32, ec: ExpCtx): i32 {
  const c = expCtxHere(ec)
  const was = c.litUnion
  c.litUnion = atom
  expCtxApply(c, ec)
  was
}

// Emit `exprIx` under the expected-type context `ctx`. The emit gets its own copy, so
// what it consumes reaches neither `ctx` nor the caller's context.
export function emitExprExpect(
  body: u8[],
  exprIx: i32,
  fnIx: i32,
  ctx: ExpCtx,
) {
  emitExpr(body, exprIx, fnIx, expCtxHere(ctx))
}

// Emit `print(<string expr>)`: stream each code point through `__print_char__`, then one
// `__print_str_flush__`. Factored from the print handler so the literal-union widening can reuse it.
function emitPrintStrExpr(body: u8[], strExpr: i32, fnIx: i32, ec: ExpCtx) {
  if emitExpr(body, strExpr, fnIx, ec) < 0 { return -1 }
  fbLocalSet(strScratchBase + 0)
  emitPrintStrFromScratch(body)
}

// The literal text `null`, streamed through the same `__print_char__`/`__print_str_flush__`
// pair `print(<string>)` uses, through no scratch frame — a constant text needs neither a
// string-ref slot nor loop counters. The null branch of the two nullable-niche prints below.
function emitPrintNullWord() {
  fbI32Const(110) // 'n'
  fbCall(2)       // __print_char__
  fbI32Const(117) // 'u'
  fbCall(2)
  fbI32Const(108) // 'l'
  fbCall(2)
  fbI32Const(108) // 'l'
  fbCall(2)
  fbCall(3)       // __print_str_flush__
  0
}

// `print(<string | null>)`. The niche rep is a `(ref null $sTypeIdx)`; the plain string arm
// below streams it unconditionally and would trap on a genuine null, so this arm exists to
// handle it. One `br_on_null` covers the argument in a single evaluation — there is no
// nullable string local to stash it in, and re-evaluating would call a `string | null`-returning function twice.
function emitPrintNulString(body: u8[], argIx: i32, fnIx: i32, ec: ExpCtx) {
  fbBlock(64) // $out
  fbBlock(64) // $null
  // The RAW nullable ref. Without `rawNullRead` a kind-16 read recovers itself with
  // `ref.as_non_null` (0xd4) — which TRAPS on the very value this arm exists to handle,
  // before `br_on_null` can see it. Same context flag the `??` arms over a nullable
  // string set for their own `ref.is_null`.
  const rawCtx = expCtxHere(ec)
  rawCtx.rawNullRead = true
  if emitExprExpect(body, argIx, fnIx, rawCtx) < 0 { return -1 }
  fbBrOnNull(0) // → $null (the enclosing block)
  fbLocalSet(strScratchBase + 0)
  if emitPrintStrFromScratch(body) < 0 { return -1 }
  fbBr(1) // → $out
  fbEnd()
  emitPrintNullWord()
  fbEnd()
  0
}

// `print(v)` over a nullable ref niche whose other arm has no printed form (D3498): the word
// `null` after a run-time test, and a trap when the value is not null, which a checked program
// never reaches, since no text would be right for it.
function emitPrintNulRefNiche(body: u8[], argIx: i32, fnIx: i32, ec: ExpCtx) {
  const rawCtx = expCtxHere(ec)
  rawCtx.rawNullRead = true
  if emitExprExpect(body, argIx, fnIx, rawCtx) < 0 { return -1 }
  fbRefIsNull()
  fbIf(64)
  emitPrintNullWord()
  fbElse()
  fbUnreachable()
  fbEnd()
  0
}

// `print(<boolean | null>)`. The niche rep is an i32 with sentinel 2 for null; the fallback
// ladder would route it to `__print_bool__`, which renders any non-zero as true, so a null
// silently printed true without this arm. A `br_table` on the niche value itself is already
// the arm index (0 false, 1 true, 2 null), evaluating the argument once with no scratch needed.
function emitPrintNulBool(body: u8[], argIx: i32, fnIx: i32, ec: ExpCtx) {
  fbBlock(64) // $out
  fbBlock(64) // $null
  fbBlock(64) // $true
  fbBlock(64) // $false
  if emitExpr(body, argIx, fnIx, ec) < 0 { return -1 }
  wU8(14)     // 0x0e br_table
  wULEB(3)    // three indexed targets, then the default
  wULEB(0)    // 0 → $false (depth 0 from here)
  wULEB(1)    // 1 → $true
  wULEB(2)    // 2 → $null
  wULEB(2)    // default → $null (unreachable: the niche is 0/1/2)
  fbEnd()
  fbI32Const(0)
  fbCall(1)   // __print_bool__ → "false"
  fbBr(2)     // → $out
  fbEnd()
  fbI32Const(1)
  fbCall(1)   // __print_bool__ → "true"
  fbBr(1)     // → $out
  fbEnd()
  emitPrintNullWord()
  fbEnd()
  0
}

// `print(<literal-union atom>)` — widen the atom to its member string through the shared
// `emitAtomToStrChain` tower, then stream it. Shared rather than re-spelled, since a
// per-member `if id == <id> { print "<member>" }` chain re-reads the receiver once per
// member — free for a place, but another call each time for `print(f())`.
function emitPrintAtomStr(
  body: u8[],
  argIx: i32,
  texts: string[],
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitStashAtomId(body, argIx, fnIx, ec) < 0 { return -1 }
  emitPrintAtomFromStash(body, texts)
}

// The stashed-id half of the atom print: the shared widen tower over str-op scratch i32 slot 0,
// then the streaming print of the string it yields. Split out so the `K | null` niche below
// reaches it from INSIDE its sentinel guard without re-evaluating the receiver.
function emitPrintAtomFromStash(body: u8[], texts: string[]) {
  if emitAtomToStrChain(body, texts, 0, strScratchBase + 3) < 0 { return -1 }
  fbLocalSet(strScratchBase + 0)
  emitPrintStrFromScratch(body)
}

// `print(<K | null>)` — the atom niche: an i32 member id with `-1` for null, the same
// sentinel `emitNulIsNullTest`'s litunion arm compares against. Both arms read the stash,
// not the receiver, so one evaluation covers the sentinel test and the widen. The sentinel
// test runs first since the member arm's streaming loop reuses slot 0 as its cursor.
function emitPrintNulLitUnion(
  body: u8[],
  argIx: i32,
  texts: string[],
  fnIx: i32,
  ec: ExpCtx,
) {
  // A `K | null` read out of a wider box converts to the niche first (D7965).
  const nlk = narrowedNulLitPinBoxKey(argIx, fnIx)
  if nlk != "" {
    if emitNarrowedNicheRead(body, argIx, nlk, NICHE_NUL_LIT, fnIx, ec) < 0 {
      return -1
    }
    setStrScrI(body, 0)
  } else if emitStashAtomId(body, argIx, fnIx, ec) < 0 {
    return -1
  }
  pushStrScrI(body, 0)
  fbI32Const(-1)
  fbI32Bin(70) // 0x46 i32.eq
  fbIf(64)     // if (void)
  emitPrintNullWord()
  fbEnd()
  pushStrScrI(body, 0)
  fbI32Const(-1)
  fbI32Bin(71) // 0x47 i32.ne
  fbIf(64)     // if (void)
  if emitPrintAtomFromStash(body, texts) < 0 { return -1 }
  fbEnd()
  0
}

// one arm of the value-union print: the box is already stashed in `slot`, so recover this
// arm's payload and hand it to that rep's own `__print_*__` sink — the same sink the
// narrowed spelling `if v is i32 { print(v) }` reaches (D712), through the shared
// `emitUnionUnboxTail` recovery. The `null` arm has no payload and prints the word.
function emitPrintUnionArm(body: u8[], slot: i32, k: i32) {
  if k == nullValKind() { return emitPrintNullWord() }
  // A vector has no print; the checker admits the print only where it narrowed the vector
  // arm away, so the tag cannot select it.
  if k == 14 {
    fbUnreachable()
    return 0
  }
  fbLocalGet(slot)
  if emitUnionUnboxTail(k) < 0 { return -1 }
  if k == 2 {
    // The string arm streams out of the str-op scratch frame — reserved because
    // `exprHasStrOp`'s print arm asked `printUnionHasStrArm`, the SAME plan this dispatch
    // walked. A guard rather than an assumption: without the frame `strScratchBase + 0` is
    // some other local and the module fails to parse.
    if !fnUsesStrOp {
      return emitFail(
        "emitProgram: print of a union with a string arm but no string scratch frame",
      )
    }
    fbLocalSet(strScratchBase + 0)
    return emitPrintStrFromScratch(body)
  }
  emitPrintScalarSink(k)
}

// Print the scalar of value-atom kind `k` already on the stack through its own `__print_*__`
// import: i32, boolean, i64, f64 and f32. Any other kind has no scalar sink and fails loud.
function emitPrintScalarSink(k: i32) {
  if k == 0 {
    fbCall(0) // __print_i32__ (import 0)
    return 0
  }
  if k == 1 {
    fbCall(1) // __print_bool__ (import 1)
    return 0
  }
  // the three wide scalars route to imports whose presence is decided by the module-level
  // annotation scan: a `f64 | i32` union spells its f64 and the import is there — checked
  // anyway, since a missed flag names a nonexistent import index, invalid wasm rather than a message.
  if k == 3 {
    if !gNeedsI64Print {
      return emitFail(
        "emitProgram: print of a union with an i64 arm but no __print_i64__ import",
      )
    }
    fbCall(4) // __print_i64__ (import index 4)
    return 0
  }
  if k == 4 {
    if !gNeedsF64Print {
      return emitFail(
        "emitProgram: print of a union with an f64 arm but no __print_f64__ import",
      )
    }
    fbCall(gF64PrintIdx)
    return 0
  }
  if k == 5 {
    if !gNeedsF32Print {
      return emitFail(
        "emitProgram: print of a union with an f32 arm but no __print_f32__ import",
      )
    }
    fbCall(gF32PrintIdx)
    return 0
  }
  emitFail("emitProgram: print of a union arm with no scalar sink")
}

// `print(<value-union box>)` — read the box tag and print the arm the value actually
// holds (D712): every arm is already inside `printDomainStr()`, so the runtime tag
// dispatch is the only piece needed, the same dispatch the emitter performs for `is`.
// One evaluation: each arm reads the box twice, so it is stashed once in the lazy frame.
function emitPrintValueUnion(
  body: u8[],
  argIx: i32,
  kinds: i32[],
  fnIx: i32,
  ec: ExpCtx,
) {
  const slot = sharedFieldRecvSlot()
  // D969 — an if-expression argument must be coerced, not plain-emitted: `emitExpr` picks
  // an if's blocktype from the arms' scalar ladder, so a desugared `??` pushes an i32
  // blocktype over two ref arms into this box slot. `emitUnionCoerce` routes it through `emitUnionIfValue` instead.
  const puIf = nodeAt(unwrapParen(argIx))
  let puDone = false
  if puIf is IfStmt {
    const puNm = unionNameOfExpr(argIx, fnIx)
    if puNm != "" {
      if emitUnionCoerce(body, puNm, nodeTyIxOf(argIx), argIx, fnIx, ec) < 0 {
        return -1
      }
      puDone = true
    }
  }
  if !puDone {
    if emitExpr(body, argIx, fnIx, ec) < 0 { return -1 }
  }
  fbLocalSet(slot)
  let i = 0
  while i < kinds.length - 1 {
    fbLocalGet(slot)
    fbStructGet(uBoxIdx, 0) // field 0: tag
    fbI32Rel(RS_TAG, scalarTagOfKind(kinds[i]))
    fbI32Bin(70)            // 0x46 i32.eq
    fbIf(64)                // if (void)
    if emitPrintUnionArm(body, slot, kinds[i]) < 0 { return -1 }
    fbElse()
    i = i + 1
  }
  if emitPrintUnionArm(body, slot, kinds[kinds.length - 1]) < 0 { return -1 }
  let e = 0
  while e < kinds.length - 1 {
    fbEnd()
    e = e + 1
  }
  0
}

// The streaming loop over the string already stashed in `strScrA` — `emitPrintStrExpr`'s
// tail, split out so the nullable arm above can reach it with the ref it recovered from
// `br_on_null` instead of re-evaluating the expression.
function emitPrintStrFromScratch(body: u8[]) {
  hoistStrScr(body, 0) // the streaming loop reads the backing once per code point
  fbI32Const(0)
  setStrScrI(body, 0)
  pushStrScrRef(body, 0)
  fbStrLen() // field 2: the VIEW's length, not the backing's
  setStrScrI(body, 1)
  fbBlock(64)
  fbLoop(64)
  pushStrScrI(body, 0)
  pushStrScrI(body, 1)
  fbI32Bin(78) // i32.ge_s
  fbBrIf(1)
  pushStrScrElem(body, 0, 0)
  fbCall(2) // __print_char__
  pushStrScrI(body, 0)
  fbI32Const(1)
  fbI32Bin(106) // i32.add
  setStrScrI(body, 0)
  fbBr(0)
  fbEnd()
  fbEnd()
  fbCall(3) // __print_str_flush__
  0
}

// Widen a literal-union atom (an i32 id) to a string value — a `select` tower mapping each
// member's id to its string constant, membership checker-guaranteed so the last member is
// the unconditional default. The id evaluates once into str-op scratch slot 0, re-read per
// member. The string-subtype analogue of the numeric i32→f64 widening.
export function emitAtomToStr(body: u8[], atomIx: i32, fnIx: i32, ec: ExpCtx) {
  // `litAtomWidenTexts` is the ladder, shared with `print`'s atom arm: the node's own union
  // members, the DECLARATION fallback for an operand whose recorded type is the GENERIC's,
  // then the bare one-member set. Two consumers ask the same question and both need every
  // rung — the classifier decides WHETHER to widen, this one needs the members to widen WITH.
  const nulTexts = nulAtomWidenTexts(atomIx)
  if nulTexts.length > 0 {
    return emitNulAtomToStr(body, atomIx, nulTexts, fnIx, ec)
  }
  const texts = litAtomWidenTexts(atomIx, fnIx)
  if texts.length == 0 {
    return emitFail(
      "emitProgram: literal-union string widening with no members",
    )
  }
  if !aUsed {
    return emitFail(
      "emitProgram: literal-union string widening but array type not collected",
    )
  }
  if emitStashAtomId(body, atomIx, fnIx, ec) < 0 { return -1 }
  const r = emitAtomToStrChain(body, texts, 0, strScratchBase + 3)
  r
}

// The right-hand side of the assignment being lowered, which `emitNulAtomToStr` refuses to
// widen when it is typed at a type parameter or lowered in an instance: the checker narrowed the
// place to non-null after the write and folded its null tests, which a `-1` would make wrong.
let nulWidenWriteRhs = -1

// Widen a `K | null` atom to a `string | null`: `-1` is `ref.null`, any other id takes the
// member tower. The id is evaluated once (D3198).
function emitNulAtomToStr(
  body: u8[],
  atomIx: i32,
  texts: string[],
  fnIx: i32,
  ec: ExpCtx,
) {
  if (
    unwrapParen(atomIx) == nulWidenWriteRhs
    && (nodeTyHasTyVar(unwrapParen(atomIx)) || fnInPinnedInstance(fnIx))
  ) {
    return emitFail(
      "emitProgram: literal-union string widening with no members",
    )
  }
  if !aUsed {
    return emitFail(
      "emitProgram: literal-union string widening but array type not collected",
    )
  }
  if emitStashAtomId(body, atomIx, fnIx, ec) < 0 { return -1 }
  pushStrScrI(body, 0)
  fbI32Const(-1)
  fbI32Bin(70) // 0x46 i32.eq → null?
  fbIfRefNul(sTypeIdx, true)
  fbRefNull(sTypeIdx)
  fbElse()
  if emitAtomToStrChain(body, texts, 0, strScratchBase + 3) < 0 { return -1 }
  fbEnd()
  0
}

// Evaluate an atom-repped literal-union value once and stash its interned i32 id in the
// string-op scratch i32 slot 0 — the slot every widen tower re-reads once per member. A
// tower that re-read the receiver per member instead would re-run a call receiver once per
// member, a silent wrong evaluation count rather than a wrong value.
function emitStashAtomId(body: u8[], atomIx: i32, fnIx: i32, ec: ExpCtx) {
  const savedLU = expCtxSwapLitUnion(1, ec)
  if emitExpr(body, atomIx, fnIx, ec) < 0 { return -1 }
  expCtxSwapLitUnion(savedLU, ec)
  setStrScrI(body, 0)
  0
}

// Whether the function at `fnStmts` position `fnPos` has a collected `string` result.
function retKindIsStr(fnPos: i32): boolean {
  fnPos >= 0 && fnPos < fRetKind.length && fRetKind[fnPos] == "str"
}

// The `select` tower for `emitAtomToStr`: member `i`'s string if its interned id matches
// the atom stashed in local `idSlot`, else the chain for `i+1`. The last member is the default arm.
function emitAtomToStrChain(body: u8[], texts: string[], i: i32, idSlot: i32) {
  if i >= texts.length - 1 {
    const rd = emitStr(body, mkStr(quoteLex(texts[i]), -1), -1)
    return rd
  }
  // val1 = this member's string constant
  if emitStr(body, mkStr(quoteLex(texts[i]), -1), -1) < 0 { return -1 }
  // val2 = the remaining chain
  if emitAtomToStrChain(body, texts, i + 1, idSlot) < 0 { return -1 }
  // cond = (stashed id == this member's id)
  fbLocalGet(idSlot)
  fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
  fbI32Bin(70) // i32.eq
  // select_t typed for a non-null string ref (0x64 $sTypeIdx): val1 if cond else val2
  fbSelectRef(sTypeIdx)
  0
}

// Emit `ix` as a string value: a literal-union atom widens to its member string; anything
// else lowers normally (it is already a string). Used at every `string`-typed boundary that
// can receive an atom — concat operands, a `string` arg position, a `string` return.
function emitStrValue(body: u8[], ix: i32, fnIx: i32, ec: ExpCtx) {
  if exprIsLitAtom(ix, fnIx) {
    const rw = emitAtomToStr(body, ix, fnIx, ec)
    return rw
  }
  const re = emitExpr(body, ix, fnIx, ec)
  re
}

// A concatenation operand: a string VALUE even when the destination the whole chain feeds is
// `string | null`, so that target's raw-read seed must not reach it, or a narrowed nullable
// reads as `(ref null)` into a non-null slot (D2682).
function emitStrCatOperand(
  body: u8[],
  ix: i32,
  fnIx: i32,
  ctx: ExpCtx,
  ec: ExpCtx,
) {
  if ctx.nulString || ctx.rawNullRead {
    const opCtx = expCtxHere(ec)
    opCtx.nulString = false
    opCtx.rawNullRead = false
    if exprIsLitAtom(ix, fnIx) {
      const saved = expCtxHere(ec)
      expCtxApply(opCtx, ec)
      const ra = emitAtomToStr(body, ix, fnIx, ec)
      expCtxApply(saved, ec)
      return ra
    }
    return emitExprExpect(body, ix, fnIx, opCtx)
  }
  emitStrValue(body, ix, fnIx, ec)
}

// Narrow a string-repped literal-union value to its interned i32 atom id — `emitAtomToStr`'s
// inverse. A litunion has two reps and `nodeTyIsLitUnionAlias` decides which: a registered
// alias is an interned atom, an un-named one stays a `(ref $array)` string. The tower is
// `emitAtomToStr`'s, mirrored, re-reading the value per member (bounded by `unionEqOperandOk`).
function emitStrToAtom(body: u8[], ix: i32, fnIx: i32, ec: ExpCtx) {
  // `tyLitMemberTexts` over the node's recorded type, NOT `nodeLitUnionMemberTexts`: that
  // node query declines a bare `TyLit` on purpose (its callers read an empty list as "not a
  // widenable atom"), and a bare `TyLit` is exactly the one-member set this narrowing serves.
  const texts = tyLitMemberTexts(nodeUnwidenedTyOf(ix))
  if texts.length == 0 {
    return emitFail("emitProgram: literal-union atom narrowing with no members")
  }
  if !aUsed {
    return emitFail(
      "emitProgram: literal-union atom narrowing but array type not collected",
    )
  }
  if !unionEqOperandOk(ix) {
    // a non-place value — a call, a `+`, a ternary — is staged rather than refused:
    // evaluated once into `atomStageSlot`, then re-read per member (`emitAtomToStr`'s id
    // stash mirrored). Reached through `emitExpr`'s single `ec.litUnion` hook, so every
    // destination that seeds that context is served by one arm (D13).
    if !fnUsesAtomStage {
      // the reservation scan claims a strict superset of what this arm stages, so reaching
      // here means the two have drifted. Keep the loud refusal rather than `local.set` an
      // index the locals vector never declared.
      return emitFail(
        "emitProgram: literal-union atom narrowing needs a re-readable receiver",
      )
    }
    // the atom context is cleared across the stash and the chain: the value must reach the
    // slot as the `(ref $array)` it is, and each member constant must lower as a string —
    // under `ec.litUnion` a member literal folds to its interned id instead, so the
    // tower called `strEq` with an i32 operand. Restored on both exits.
    const savedST = expCtxSwapLitUnion(0, ec)
    let rv = emitExpr(body, ix, fnIx, ec)
    if rv >= 0 {
      fbLocalSet(atomStageSlot)
      rv = emitStagedStrToAtomChain(body, texts, 0, atomStageSlot, fnIx, ec)
    }
    expCtxSwapLitUnion(savedST, ec)
    return rv
  }
  // The inner emits run OUTSIDE the atom context: the value re-reads must lower as the
  // string they are (re-entering this arm would not terminate), and the per-member literal
  // must lower as a string CONSTANT, not as its own interned id.
  const savedLU = expCtxSwapLitUnion(0, ec)
  const r = emitStrToAtomChain(body, ix, texts, 0, fnIx, ec)
  expCtxSwapLitUnion(savedLU, ec)
  r
}

// The `select` tower over a box parked in `st` whose payload is the member's string: member
// `i`'s interned id if the payload string-equals member `i`, the last member the default.
function emitStashedStrToAtomChain(
  body: u8[],
  st: i32,
  texts: string[],
  i: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if i >= texts.length - 1 {
    fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
    return 0
  }
  fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
  if emitStashedStrToAtomChain(body, st, texts, i + 1, fnIx, ec) < 0 {
    return -1
  }
  fbLocalGet(st)
  fbStructGet(uBoxIdx, 1) // 0xfb 0x02 <box ht> field 1: value (anyref)
  fbRefCast(sTypeIdx)
  if emitStrEqLit(body, mkStr(quoteLex(texts[i]), -1), fnIx, ec) < 0 {
    return -1
  }
  fbSelect() // 0x1b select — val1 if cond else val2 (both i32)
  0
}

// The `select` tower for `emitStrToAtom`: member `i`'s interned id if the value string-equals
// member `i`, else the chain for `i+1`. The last member is the unconditional default arm.
function emitStrToAtomChain(
  body: u8[],
  ix: i32,
  texts: string[],
  i: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if i >= texts.length - 1 {
    fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
    return 0
  }
  // val1 = this member's interned id
  fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
  // val2 = the remaining chain
  if emitStrToAtomChain(body, ix, texts, i + 1, fnIx, ec) < 0 { return -1 }
  // cond = (the value string-equals this member)
  if emitExpr(body, ix, fnIx, ec) < 0 { return -1 }
  if emitStrEqLit(body, mkStr(quoteLex(texts[i]), -1), fnIx, ec) < 0 {
    return -1
  }
  fbSelect() // 0x1b select — val1 if cond else val2 (both i32)
  0
}

// Whether `ix` is a re-readable place typed `K | null`, for string literals `K`, whose value
// is held as a nullable string rather than the atom niche.
function nulStrReppedNulLitPlace(ix: i32, fnIx: i32): boolean {
  const u = unwrapParen(ix)
  if u < 0 || !unionEqOperandOk(u) { return false }
  if nodeAt(u) is StrLit || exprIsLitAtom(u, fnIx) { return false }
  if !tyIsNullableLitUnion(nodeUnwidenedTyOf(u)) { return false }
  if exprNulLitUnion(u, fnIx) { return false }
  exprNullableString(u, fnIx)
}

// The `K | null` niche of nullable-string place `ix`: `-1` when it is null, else the id of the
// member it string-equals, the last member the default.
function emitNulStrToNulAtom(body: u8[], ix: i32, fnIx: i32, ec: ExpCtx) {
  const texts = nulLitMemberTexts(nodeUnwidenedTyOf(ix))
  if texts.length == 0 {
    return emitFail("emitProgram: literal-union atom narrowing with no members")
  }
  const outer = expCtxHere(ec)
  const raw = expCtxHere(ec)
  raw.litUnion = 0
  raw.nulLitUnion = false
  raw.nulString = true
  expCtxApply(raw, ec)
  let rc = emitExpr(body, ix, fnIx, ec)
  if rc >= 0 {
    fbRefIsNull()
    fbIf(127) // if (result i32)
    fbI32Const(-1)
    fbElse()
    rc = emitNulStrToAtomChain(body, ix, texts, 0, fnIx, ec)
    fbEnd()
  }
  expCtxApply(outer, ec)
  rc
}

// `emitStrToAtomChain` over a nullable-string place already tested non-null.
function emitNulStrToAtomChain(
  body: u8[],
  ix: i32,
  texts: string[],
  i: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
  if i >= texts.length - 1 { return 0 }
  if emitNulStrToAtomChain(body, ix, texts, i + 1, fnIx, ec) < 0 { return -1 }
  if emitExpr(body, ix, fnIx, ec) < 0 { return -1 }
  fbRefAsNonNull()
  if emitStrEqLit(body, mkStr(quoteLex(texts[i]), -1), fnIx, ec) < 0 {
    return -1
  }
  fbSelect() // 0x1b select — val1 if cond else val2 (both i32)
  0
}

// ── the destination-driven narrow, for a value whose own type cannot answer ───────────────
// `emitStrToAtom` refuses a value it cannot re-read — wrong at a `.push` into a
// literal-union array inside a monomorphized instance, where the value is a call and the
// leaf's recorded type is still the generic's type variable. The destination knows the member set instead.
function emitDestStrToAtom(
  body: u8[],
  valIx: i32,
  fnIx: i32,
  luTy: i32,
  ec: ExpCtx,
) {
  const texts = tyLitMemberTexts(luTy)
  if texts.length == 0 {
    return emitFail("emitProgram: literal-union atom narrowing with no members")
  }
  if !aUsed {
    return emitFail(
      "emitProgram: literal-union atom narrowing but array type not collected",
    )
  }
  const ix = unwrapParen(valIx)
  if unionEqOperandOk(ix) {
    // A PLACE: re-read it per member, no slot.
    const savedRR = expCtxSwapLitUnion(0, ec)
    const rr = emitStrToAtomChain(body, ix, texts, 0, fnIx, ec)
    expCtxSwapLitUnion(savedRR, ec)
    return rr
  }
  if !fnUsesAtomStage {
    // The reservation scan claims a strict SUPERSET of what this arm stages, so reaching here
    // means the two have drifted. Fail loudly rather than `local.set` an index the locals
    // vector never declared — that is invalid wasm with `vl check` rc 0.
    return emitFail(
      "emitProgram: literal-union atom narrowing needs a staging slot that was not reserved",
    )
  }
  const savedLU = expCtxSwapLitUnion(0, ec)
  const rv = emitExpr(body, ix, fnIx, ec)
  expCtxSwapLitUnion(savedLU, ec)
  if rv < 0 { return -1 }
  fbLocalSet(atomStageSlot)
  emitStagedStrToAtomChain(body, texts, 0, atomStageSlot, fnIx, ec)
}

// `emitStrToAtomChain` over the value staged in string slot `slot`: member `i`'s interned id if
// the slot string-equals member `i`, else the chain for `i+1`, last member the default.
function emitStagedStrToAtomChain(
  body: u8[],
  texts: string[],
  i: i32,
  slot: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if i >= texts.length - 1 {
    fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
    return 0
  }
  fbI32Rel(RS_ATOM, internAtom(quoteLex(texts[i])))
  if emitStagedStrToAtomChain(body, texts, i + 1, slot, fnIx, ec) < 0 {
    return -1
  }
  fbLocalGet(slot)
  if emitStrEqLit(body, mkStr(quoteLex(texts[i]), -1), fnIx, ec) < 0 {
    return -1
  }
  fbSelect() // 0x1b select — val1 if cond else val2 (both i32)
  0
}

// Does a `.push` value into a literal-union array need the destination-driven narrow? Only
// when the existing atom context has no answer: an atom-repped value or a member string
// literal both lower correctly under `ec.litUnion` already.
function litPushNeedsDestNarrow(valIx: i32, fnIx: i32) {
  if exprIsLitAtom(valIx, fnIx) { return false }
  const v = nodeAt(unwrapParen(valIx))
  if v is StrLit { return false }
  if strReppedLitUnionAt(valIx, fnIx) {
    if unionEqOperandOk(valIx) { return false }
  }
  true
}

// True when `ix` is a literal-union value whose rep is its member string rather than the
// interned i32 atom — the un-named flattened and inline spellings. Declines an atom-repped
// expression and a member string literal, both already atoms in atom context; the member
// set may be a singleton (`tyIsLitUnionOrLit`), same bare `TyLit` a plain literal produces.
function strReppedLitUnionAt(ix: i32, fnIx: i32) {
  if exprIsLitAtom(ix, fnIx) { return false }
  const av = unwrapParen(ix)
  if av < 0 { return false }
  const e = nodeAt(av)
  if e is StrLit { return false }
  tyIsLitUnionOrLit(nodeUnwidenedTyOf(av))
}

// The lexeme (quotes kept) operand `ix` is statically known to be: a string literal, or an
// expression whose type is exactly one string literal (a bare `"z"`, or a one-member literal
// union); "" otherwise. A type is the value set, so a one-literal type is one value.
function staticStrLitLex(ix: i32, fnIx: i32): string {
  const u = unwrapParen(ix)
  if u < 0 { return "" }
  const n = nodeAt(u)
  if n is StrLit { return n.strText }
  if nodeHasWideStrLit(u) { return quoteLex(nodeWideStrLitText(u)) }
  const t = nodeTyAt(u, fnIx)
  if !tyIsOneStrLit(t) { return "" }
  quoteLex(tyLitMemberTexts(t)[0])
}

// Whether two string lexemes (quotes kept) spell the same value — decoded, so an escape and the
// character it stands for agree.
function strLexSameValue(a: string, b: string): boolean {
  if a == b { return true }
  const da = decodeStr(strToCps(a))
  const db = decodeStr(strToCps(b))
  if da.length != db.length { return false }
  let i = 0
  while i < da.length {
    if da[i] != db[i] { return false }
    i = i + 1
  }
  true
}

// The lexeme (quotes kept) of the member in `texts` whose value `lex` spells, else `lex` itself —
// whose interned id then matches no member's.
function memberLexOfValue(texts: string[], lex: string): string {
  let i = 0
  while i < texts.length {
    const m = quoteLex(texts[i])
    if strLexSameValue(m, lex) { return m }
    i = i + 1
  }
  lex
}

// Pushes the interned atom id of statically-known operand `ix` (lexeme `lex`): a literal is its
// id outright, anything else is evaluated for its effects and dropped first.
function emitStaticLitAtom(
  body: u8[],
  ix: i32,
  lex: string,
  fnIx: i32,
  ec: ExpCtx,
) {
  if !(nodeAt(unwrapParen(ix)) is StrLit) {
    const savedLU = expCtxSwapLitUnion(0, ec)
    const rc = emitExpr(body, ix, fnIx, ec)
    expCtxSwapLitUnion(savedLU, ec)
    if rc < 0 { return -1 }
    fbDrop()
  }
  fbI32Rel(RS_ATOM, internAtom(lex))
  0
}

// True when `ix` can be lowered in atom context — the interned i32 id the litunion atom
// `==` needs on both sides: an atom-repped expression, a member string literal, or a
// string-repped litunion. A plain `string` is excluded on purpose: `emitStrToAtom`'s
// tower needs membership guaranteed, which a plain `string` does not carry.
function eqAtomOperandOk(ix: i32, fnIx: i32) {
  if exprIsLitAtom(ix, fnIx) { return true }
  const av = unwrapParen(ix)
  if av < 0 { return false }
  const e = nodeAt(av)
  if e is StrLit { return true }
  if exprUnion(ix, fnIx) { return false }
  nodeTyIsLitUnion(av)
}

// Lowers the lexeme `text` as one `<w>.const`. A float lexeme is never an integer constant; an
// integer one at `i32` wraps, so the `2147483648` under an `i32` negation is I32_MIN.
function emitNumLexAt(text: string, w: string) {
  if numLexIsFloat(text) {
    if w == "f32" { fbF32Const(text) } else { fbF64Const(text) }
    return 0
  }
  if w == "f32" {
    fbF32Const(text)
    return 0
  }
  if w == "f64" {
    fbF64Const(text)
    return 0
  }
  if w == "i64" {
    const pr = parseI64Pair(text)
    fbI64Const(pr[0], pr[1])
    return 0
  }
  fbI32Const(parseI32(text))
  0
}

// Lowers a literal, or `-` over one (parens peeled), as one `<w>.const` at the width `w` the
// caller names: re-encoding the lexeme keeps a hex bit pattern past I32_MAX the value it spells.
function emitSignedNumLitAt(ix: i32, w: string): i32 {
  const n = nodeAt(ix)
  if n is NumLit { return emitNumLexAt(n.numText, w) }
  if n is Unary {
    const mark = wLen()
    if emitSignedNumLitAt(unwrapParen(n.unArg), w) < 0 { return -1 }
    if wNegateConstFrom(mark) { return 0 }
  }
  emitFail("emitProgram: a signed literal did not fold to one constant")
}

function emitNumLitNode(
  _body: u8[],
  e: NumLit,
  exprIx: i32,
  fnIx: i32,
  _ctx: ExpCtx,
) {
  emitNumLexAt(e.numText, numLitWidth(exprIx, fnIx))
}

function emitCharLitNode(_body: u8[], e: CharLit, _exprIx: i32, _fnIx: i32) {
  // A char literal IS its single Unicode code point as an i32. `charText` is the RAW
  // lexeme (quotes kept, escapes unresolved), so decode it the SAME way string
  // literals decode (`decodeStr` strips the quotes + resolves escapes); a well-formed
  // char yields exactly one code point.
  const cps = decodeStr(strToCps(e.charText))
  if cps.length != 1 {
    return emitFail(
      "emitProgram: char literal must denote exactly one code point",
    )
  }
  fbI32Const(cps[0])
  return 0
}

// The recovery a read of module global `isid` owes after its `global.get`, shared by an
// identifier read and a substituted parameter default. A kind-16 `string | null` cell is
// always a nullable ref; a non-const ref cell is start-initialised, so it is nullable in
// wasm and recovered unless its kind legitimately holds null or is not a ref at all.
function emitGlobalReadRecover(isid: i32, ctx: ExpCtx) {
  const gck0 = globalCellKind(globalLetOfSid(isid))
  if gck0 == "nulstr" {
    if !nulStrReadStaysRaw(ctx) { fbRefAsNonNull() }
    return 0
  }
  if !globalNameIsNonConstSid(isid) { return 0 }
  if vkIsNonNullRef(gck0) { fbRefAsNonNull() }
  0
}

// the densest single-identifier site in the compiler: one identifier read resolves
// through seven name-keyed lookups here, each otherwise a hash plus a string probe. The
// arena index `_exprIx`, already threaded in and unused, turns the id lookup and the
// other six into array reads.
function emitIdentNode(
  body: u8[],
  e: Ident,
  exprIx: i32,
  fnIx: i32,
  ctx: ExpCtx,
  ec: ExpCtx,
) {
  // D1576 — a read of a never-filled `let x = null` is the value `null`, so it takes the
  // destination's null rep from the same table a bare `null` literal does.
  if identCellVKind(exprIx, fnIx) == "nulnone" { return emitNullBySeed(ctx) }
  // An `is K[]` arm's read of an empty list of another element (D4911), ahead of the narrowed
  // unboxes, which would cast the receiver's own list to `K[]`.
  const fitSh = listFitShadowRead(e.identName, exprIx, fnIx)
  if fitSh >= 0 {
    fbLocalGet(fitSh)
    fbRefAsNonNull()
    return 0
  }
  // …and a closure's read of its capture there, which reads an empty `K[]` of its own (D4935).
  listFitStoodIn = -1
  const capSh = listFitCaptureStandIn(e.identName, exprIx, fnIx, false)
  if capSh >= 0 {
    fbBacking(listBackOfWrap(capSh), 0)
    arrLitWrap(0, capSh)
    listFitStoodIn = exprIx
    listFitStoodWrap = capSh
    return 0
  }
  const isid = sidOfNode(exprIx)
  // a module-`const` parameter default reads its global, not a caller-local of the same
  // name: this node is the declaration's expression, substituted into whichever frame
  // omitted the argument, so the only hygienic reading is the declaration's own. The
  // checker resolves the same node the same way, so the two agree by construction.
  if isDefaultGlobalRef(exprIx) {
    const dgIdx = globalIndexOfSid(isid)
    if dgIdx >= 0 {
      if emitUserGlobalGet(dgIdx) < 0 { return -1 }
      // the same recovery the argument spelling of this read gets (D3510)
      emitGlobalReadRecover(isid, ctx)
      return 0
    }
  }
  // the narrowed-arm unboxes come first (each sourcing its box through
  // `emitUnionBoxPush`, whose capture leg reads the env field raw). A union-box cell the
  // checker typed this read as one atom of reads unboxed: push the box, recover the `anyref`
  // payload, cast it, and read the value-box field — `if u is i32 { print(u) }` yields the raw i32.
  const vak = identReadAtomKindAt(exprIx, fnIx)
  if vak >= 0 {
    // D947 — a dead generic narrow reads `unreachable`, not a value box: a type
    // parameter narrowed to an impossible arm type-checks, so the arm is
    // constant-false there and would otherwise read a box that is not there.
    if fnHasTyParams(fnIx) {
      const vSet = unionNameOfIdentAt(isid, fnIx, exprIx)
      const vAtom = valueAtomNameOfKind(vak)
      if vSet != "" && vAtom != "" && !unionSetHasAtom(vSet, vAtom) {
        fbUnreachable()
        return 0
      }
    }
    return emitValueUnionUnboxRead(body, e.identName, vak, fnIx, ec)
  }
  // a union binding narrowed to a niche-repped `A | null` reads as that niche, under the
  // storage gates `identReadsUnionBox` names (D2590).
  const nNk = nicheReadKindAt(exprIx, e.identName, fnIx)
  if nNk >= 0 {
    if identReadsUnionBox(isid, e.identName, exprIx, fnIx) {
      return emitNarrowedNicheRead(body, exprIx, e.identName, nNk, fnIx, ec)
    }
  }
  // a union binding narrowed to a ref-element array arm reads unboxed to the reflist
  // wrapper: push the box, recover the anyref payload, `ref.cast` to the arm's wrapper —
  // the ref-array analogue of the scalar unbox above, so indexing/`.length` see the list.
  const iCon = identReadContainerAt(exprIx, fnIx)
  if iCon == RC_REF_LIST {
    if identReadsUnionBox(isid, e.identName, exprIx, fnIx) {
      return emitRefArrayUnionUnboxRead(body, e.identName, exprIx, fnIx, ec)
    }
  }
  // a union binding narrowed to a map arm reads unboxed to the map struct ref: push the
  // box, recover the anyref payload, `ref.cast` to the arm's map struct — the map
  // analogue of the ref-array unbox above, so `emitMapPrep` sees the map ref directly.
  if iCon == RC_MAP {
    // the same three gates as the value-atom arm above, the typed-IR net over the map-arm chain.
    if (
      unionNameOfIdentAt(isid, fnIx, exprIx) != ""
      || capturedIsUnionBox(fnIx, e.identName)
      || identChainTyMapArmUnion(e.identName, fnIx, 4)
    ) {
      return emitMapUnionUnboxRead(body, e.identName, exprIx, fnIx, ec)
    }
  }
  // a captured variable (a free var of a capturing lifted function): read it from the
  // env struct threaded as the leading param (local 0). Checked before the param/local/
  // global paths so a capture shadows nothing. Only fires inside a capturing lifted function.
  if emitCapturedRead(body, e.identName, fnIx, true, ec) == 1 { return 0 }
  // A name resolves to a param (locals 0..p-1) or a declared local (locals p..).
  const idx = localIndexOf(fnIx, e.identName)
  if idx < 0 {
    return emitIdentNonLocalRead(body, e, isid, exprIx, fnIx, ctx, ec)
  }
  emitIdentLocalRead(e, idx, fnIx, ctx)
}

// Whether a narrowed read of `name` finds the union box it unboxes: a binding of this frame
// with a union render, a capture held as a box, or the typed-IR net for a binding with neither.
function identReadsUnionBox(
  isid: i32,
  name: string,
  exprIx: i32,
  fnIx: i32,
): boolean {
  const r = (unionNameOfIdentAt(isid, fnIx, exprIx) != ""
    || capturedIsUnionBox(fnIx, name)
    || identChainTyBoxedUnion(name, fnIx, 4))
  r
}

// A read of `e` that is no param or local of this frame: a function value, else a module
// global. Returns 0, or -1 once failed.
function emitIdentNonLocalRead(
  body: u8[],
  e: Ident,
  isid: i32,
  exprIx: i32,
  fnIx: i32,
  ctx: ExpCtx,
  ec: ExpCtx,
) {
  // a bare top-level/lifted function name in value position constructs a function
  // value (closure fat-pointer): `fnIndexOf` is the function index `emitClosureValue`
  // expects, passed directly. Scope-aware so a nested function sharing a name with
  // another maker's nested function resolves to this frame's.
  const fe = fnIndexOfInScopeAt(isid, e.identName, fnIx, exprIx)
  if fe >= 0 {
    // void-coerced value seam: this node's `(P…) => T` is coerced to `(P…) => void`
    // by the checker (`fnValVoidCoerce`), so build the void twin's closure instead
    // (`voidTwinForNode`), or the `>v`-sig call signature-checks against the wrong functype.
    const vtw = voidTwinForNode(exprIx, fe)
    if vtw >= 0 { return emitClosureValue(body, vtw, fnIx, ec) }
    if exprIx != stubWriteRhs && !monoStubValueOk(fe, exprIx) {
      // Handed through an identity call into a binding, the binding can take a slot per type.
      fsAsk(exprIx)
      return emitFailAt(
        "emitProgram: a generic function taken as a value reaches no call that fixes its type "
          + "— annotate the destination's function type",
        exprIx,
      )
    }
    // A value nothing can call has no signature to keep, so a hole function may be one (D6660).
    if i32ListHas(monoInertCalled, exprIx) {
      return emitClosureValueCore(body, fe, fnIx, ec)
    }
    // So may one whose template a call instanced, called only through an alias (D7383).
    if i32ListHas(monoInertValues, exprIx) && monoInstantiatedAny(fe) {
      return emitClosureValueCore(body, fe, fnIx, ec)
    }
    // A hole function refused as a value may be one an identity call hands a binding (D6020).
    if fnHasUnannotatedParam(fe) && !criFnIsAnonLambda(fe) { fsAsk(exprIx) }
    return emitClosureValue(body, fe, fnIx, ec)
  }
  // Not a local — a module global? Read it with `global.get` (0x23 <globalidx>).
  const gIdx = globalIndexOfSid(isid)
  if gIdx >= 0 {
    if emitUserGlobalGet(gIdx) < 0 { return -1 }
    emitGlobalReadRecover(isid, ctx)
    return 0
  }
  return emitFail(
    "emitProgram: identifier is not a parameter, local, or global",
  )
}

// A read of `e` from its local `idx`, or an unrolled range variable's constant. Returns 0.
function emitIdentLocalRead(e: Ident, idx: i32, fnIx: i32, ctx: ExpCtx) {
  // A fully unrolled range loop's variable reads as its copy's constant.
  const urAt = unrolledSlotAt(idx)
  if urAt >= 0 {
    if urBase[urAt] < 0 {
      fbI32Const(urVal[urAt])
      return 0
    }
    fbLocalGet(urBase[urAt])
    if urVal[urAt] != 0 {
      fbI32Const(urVal[urAt])
      fbI32Bin(106) // 0x6a i32.add
    }
    return 0
  }
  fbLocalGet(idx)
  // The `string | null` (kind 16) read rule for a param/local — stated at `emitMem`'s
  // field read. Mirrors the kind-15 list read, which never eagerly recovers.
  if !nulStrReadStaysRaw(ctx) {
    if paramNulString(fnIx, e.identName) || declaredNulString(e.identName) {
      fbRefAsNonNull() // 0xd4
    }
  }
  return 0
}

function emitUnaryNode(
  body: u8[],
  e: Unary,
  exprIx: i32,
  fnIx: i32,
  _ctx: ExpCtx,
  ec: ExpCtx,
) {
  // Logical not `!a`: a boolean rides in an i32 (0/1), so `i32.eqz` (0x45) maps
  // 0→1 and any non-zero→0 — exactly `a == 0`. Push the operand, then eqz.
  if e.unOp == "!" {
    const ngStart = wLen()
    if emitExpr(body, e.unArg, fnIx, ec) < 0 { return -1 }
    // An instance's decided `is` stays one constant under `!`, so `staticIsGuard` reads the
    // negated test as decided too and the dead arm is not lowered (D2957).
    const ngK = staticIsGuard(e.unArg, ngStart)
    if ngK >= 0 {
      wDropBack(2)
      fbI32Const(1 - ngK)
      return 0
    }
    fbI32Eqz() // 0x45 i32.eqz
    return 0
  }
  // postfix `x++`/`x--` in expression position yields the old value. `unArg` is the
  // increment assignment `x = x ± 1`, which as an expression yields the new value
  // (store-then-re-read); undo the step to recover the pre-increment value.
  if e.unOp == "p+" || e.unOp == "p-" {
    if emitExpr(body, e.unArg, fnIx, ec) < 0 { return -1 }
    fbI32Const(1)
    if e.unOp == "p+" {
      fbI32Bin(107) // 0x6b i32.sub: (x+1) - 1
    } else {
      fbI32Bin(106) // 0x6a i32.add: (x-1) + 1
    }
    return 0
  }
  // Bitwise NOT `~x` == `x ^ -1` (flip every bit). The all-ones mask is an i64
  // `-1` when the operand is i64, an i32 `-1` otherwise; the XOR opcode follows
  // suit. (Slice 2 — the i64 path; the i32 path is the same shape over i32 ops.)
  if e.unOp == "~" {
    if exprIsI64(e.unArg, fnIx) {
      if emitExpr(body, e.unArg, fnIx, ec) < 0 { return -1 }
      fbI64Const(-1, -1) // i64 -1 (all ones)
      fbI32Bin(133)      // 0x85 i64.xor
      return 0
    }
    if emitExpr(body, e.unArg, fnIx, ec) < 0 { return -1 }
    fbI32Const(-1) // i32 -1 (all ones)
    fbI32Bin(115)  // 0x73 i32.xor
    return 0
  }
  // A two-base literal set negates at `i64`, the width its arithmetic computes at (D3512).
  if (
    e.unOp == "-"
    && !tyIsPrimIx(nodeTyAt(e.unArg, fnIx))
    && njIsLitSide(e.unArg, fnIx)
  ) {
    fbI64Const(0, 0)
    if emitNumUnionConvert(body, e.unArg, 3, fnIx, ec) < 0 { return -1 }
    fbI32Bin(125) // 0x7d i64.sub
    return 0
  }
  if numUnionMinted && e.unOp == "-" && nodeIsNumUnion(e.unArg, fnIx) {
    return emitNumUnionNeg(body, e.unArg, fnIx, ec)
  }
  // Integer negation: `-x` == `0 - x`, so push 0, the operand, then sub. For an
  // i64 operand the zero and the subtract are i64 (Slice 2).
  if e.unOp != "-" {
    return emitFail("emitProgram: unsupported unary operator")
  }
  // A negated numeric literal folds to one constant (`wNegateConstFrom`), which keeps a
  // module const initialized with it a constant expression. The operator below is
  // the fallback, and it computes the same value.
  const negInner = unwrapParen(e.unArg)
  if negInner < 0 { return -1 }
  const negNode = nodeAt(negInner)
  const negLit = negNode is NumLit
  const negMark = wLen()
  // A negated literal is one constant at the negation's own type, which may be narrower than its
  // operand's: `-2147483648` is `i32` over an `i64` magnitude.
  const negW = numLitTyWidth(exprIx, fnIx)
  if negLit && negW != "" { return emitSignedNumLitAt(exprIx, negW) }
  // f32 negation uses the dedicated `f32.neg` (0x8c) — flips the sign bit. Checked
  // before f64 (an f32 expr is never `exprIsF64`, but this keeps the float cases
  // grouped and explicit). (Slice 5.)
  if exprIsF32(e.unArg, fnIx) {
    if emitExpr(body, e.unArg, fnIx, ec) < 0 { return -1 }
    if negLit && wNegateConstFrom(negMark) { return 0 }
    fbF32Neg()
    return 0
  }
  // f64 negation uses the dedicated `f64.neg` (0x9a) — flips the sign bit (Slice 3).
  if exprIsF64(e.unArg, fnIx) {
    if emitExpr(body, e.unArg, fnIx, ec) < 0 { return -1 }
    if negLit && wNegateConstFrom(negMark) { return 0 }
    fbF64Neg()
    return 0
  }
  // A literal operand multiplies by -1 when it does not fold, since the zero `0 - x` needs
  // would already have to be on the stack; the two agree under wrapping.
  if exprIsI64(e.unArg, fnIx) {
    if negLit {
      if emitExpr(body, e.unArg, fnIx, ec) < 0 { return -1 }
      if wNegateConstFrom(negMark) { return 0 }
      fbI64Const(-1, -1)
      fbI32Bin(126) // 0x7e i64.mul
      return 0
    }
    fbI64Const(0, 0) // i64 0
    if emitExpr(body, e.unArg, fnIx, ec) < 0 { return -1 }
    fbI32Bin(125)    // 0x7d i64.sub
    return 0
  }
  if negLit {
    if emitExpr(body, e.unArg, fnIx, ec) < 0 { return -1 }
    if wNegateConstFrom(negMark) { return 0 }
    fbI32Const(-1)
    fbI32Bin(108) // 0x6c i32.mul
    return 0
  }
  fbI32Const(0)
  if emitExpr(body, e.unArg, fnIx, ec) < 0 { return -1 }
  fbI32Bin(107) // 0x6b i32.sub
  return 0
}

function emitCallNode(body: u8[], e: Call, exprIx: i32, fnIx: i32, ec: ExpCtx) {
  // G6: `s.slice(start, end)` over a string receiver is an intrinsic — a new
  // `(array i32)` over the clamped half-open range. Other member-calls in value
  // position are out of scope (the only member-call STATEMENT is `.push`).
  if exprIsStrMethod(exprIx, fnIx, "slice") {
    return emitStrSlice(body, exprIx, fnIx, ec)
  }
  // An array `xs.slice(start, end?)` over a LIST receiver — a same-element-kind
  // sublist (`emitArrSlice`). Checked before the string slice's siblings so it does
  // not fall into a struct member-call path.
  if callIsArrSlice(exprIx, fnIx) {
    return emitArrSlice(body, exprIx, fnIx, ec)
  }
  // `s.indexOf(sub)` / `s.includes(sub)` / `s.charCodeAt(i)` over a string
  // receiver are intrinsics too (A7), each yielding an i32.
  if exprIsStrIndexOf(exprIx, fnIx) {
    return emitStrIndexOf(body, exprIx, fnIx, ec)
  }
  if exprIsStrMethod(exprIx, fnIx, "charCodeAt") {
    return emitStrCharCode(body, exprIx, fnIx, ec)
  }
  // The Stage 2c codec trio. Dispatched from the SAME ladder rung as `charCodeAt` because
  // they are the same shape — a member call on a string receiver yielding a scalar — and a
  // rung further down would sit past the `Map`/`Set`/`has`/`delete` arms that key on a bare
  // property NAME.
  if exprIsStrMethod(exprIx, fnIx, "cpAt") {
    return emitStrCpAt(body, exprIx, fnIx, ec)
  }
  if exprIsStrMethod(exprIx, fnIx, "cpLen") {
    return emitStrCpLen(body, exprIx, fnIx, ec)
  }
  if exprIsStrMethod(exprIx, fnIx, "isCharBoundary") {
    return emitStrIsCharBoundary(body, exprIx, fnIx, ec)
  }
  if exprIsStrMethod(exprIx, fnIx, "bytes") {
    return emitStrBytes(body, exprIx, fnIx, ec)
  }
  // G8: the `Map()` builtin constructs an empty string-keyed map. `Set()` is a
  // boolean-valued string map over the SAME 7-field struct, so it emits the
  // IDENTICAL empty-map construction.
  if e.callFn < 0 { return -1 }
  const callee = nodeAt(e.callFn)
  if callee is Ident {
    // D975 — a user function named `Map`/`Set` owns its own name here too, for the reason
    // `emitCall`'s header gives: matching by spelling alone would build a fresh map instead
    // of calling it. A real constructor resolves to no function, so the lookup separates them.
    if fnIndexOfNode(e.callFn) < 0 {
      if callee.identName == "Map" || callee.identName == "Set" {
        return emitMapNew(exprIx, fnIx)
      }
    }
  }
  // G8: a map `m.has(k)` member-call yields a 0/1 i32 (linear scan).
  if callee is Member {
    if callee.memProp == "has" {
      if exprMap(callee.memObj, fnIx) {
        if e.callArgs.length != 1 {
          return emitFail(
            "emitProgram: internal: .has reached with the wrong argument count — the checker's arity rule refuses it",
          )
        }
        return emitMapHas(body, callee.memObj, e.callArgs[0], fnIx, ec)
      }
    }
    // G8: a map `m.delete(k)` member-call in value position yields a 0/1 boolean (did a
    // key exist and get removed). The same lowering serves the bare-statement form.
    if callee.memProp == "delete" {
      if exprMap(callee.memObj, fnIx) {
        if e.callArgs.length != 1 {
          return emitFail(
            "emitProgram: internal: .delete reached with the wrong argument count — the checker's arity rule refuses it",
          )
        }
        return emitMapDelete(body, callee.memObj, e.callArgs[0], fnIx, ec)
      }
    }
    // `m.keys()` over a map yields a fresh string list of its LIVE keys.
    if callee.memProp == "keys" {
      if exprMap(callee.memObj, fnIx) {
        if e.callArgs.length != 0 {
          return emitFail(
            "emitProgram: internal: .keys() reached with the wrong argument count — the checker's arity rule refuses it",
          )
        }
        return emitMapKeys(body, callee.memObj, fnIx, ec)
      }
    }
    // `m.values()` over a mono i32 map yields a fresh i32 list of its LIVE values.
    if callee.memProp == "values" {
      if exprMap(callee.memObj, fnIx) {
        if e.callArgs.length != 0 {
          return emitFail(
            "emitProgram: internal: .values() reached with the wrong argument count — the checker's arity rule refuses it",
          )
        }
        return emitMapValues(body, callee.memObj, fnIx, ec)
      }
    }
    // `xs.pop()` removes + returns the last list element (any list kind). The receiver
    // guard is the one the `map` / `filter` / `keys` / `values` / `get` neighbours all
    // carry: a non-list receiver falls through, so a function-valued struct FIELD named
    // `pop` is a `call_ref` member call like any other (D1087).
    if callee.memProp == "pop" {
      if popRecvIsList(callee.memObj, fnIx) {
        return emitPop(body, exprIx, fnIx, true, -1, ec)
      }
    }
    // `xs.push(v)` in value position yields the new length — the `i32` the checker has
    // always given it (D1592). It rides the same receiver test as `.pop`, so a receiver
    // one lowers and the other refuses cannot exist.
    if callee.memProp == "push" {
      if popRecvIsList(callee.memObj, fnIx) {
        return emitPush(body, exprIx, fnIx, true, ec)
      }
    }
    // `xs.get(i)` — the checked nullable list read, at every list rep. It is `.pop()`
    // with a bounds condition and no decrement, so it shares that body (D1281). A
    // non-list receiver still falls through — a map `.get(k)` and a function-valued
    // struct field named `get` are `emitCall`'s.
    if callee.memProp == "get" {
      if e.callArgs.length == 1 {
        if popRecvIsList(callee.memObj, fnIx) {
          return emitPop(body, exprIx, fnIx, true, e.callArgs[0], ec)
        }
      }
    }
    // `xs.map(f)` / `xs.filter(p)` over a LIST receiver lower to the inline
    // closure-calling loop (Slices 3–4). A non-list receiver falls through (a
    // function-valued struct FIELD named `map` is a `call_ref` member call).
    if callee.memProp == "map" || callee.memProp == "filter" {
      if mfRecvKindOf(callee.memObj, fnIx) != null {
        return emitMapFilter(body, exprIx, fnIx, ec)
      }
    }
  }
  return emitCall(body, exprIx, fnIx, ec)
}

// A bare `null` literal, built at the destination `ctx` seeds.
function emitNullLitNode(
  _body: u8[],
  _e: NullLit,
  _exprIx: i32,
  _fnIx: i32,
  ctx: ExpCtx,
  _ec: ExpCtx,
) {
  emitNullBySeed(ctx)
}

// A bare `null`, or a value whose type is `null`, at the destination `ctx` seeds. A
// `boolean | null`, literal-union or string destination names its own null; every other
// destination is a nullable ref, and `ref.null none`, the GC bottom, is a subtype of each (D1567).
function emitNullBySeed(ctx: ExpCtx) {
  if ctx.nulBool {
    fbI32Const(2)
    return 0
  }
  if ctx.nulLitUnion {
    fbI32Const(-1)
    return 0
  }
  if ctx.nulString {
    fbRefNull(sTypeIdx)
    return 0
  }
  fbRefNullNone()
}

function emitObjLitNode(
  body: u8[],
  _e: ObjLit,
  exprIx: i32,
  fnIx: i32,
  row: i32,
  ec: ExpCtx,
) {
  // A literal the checker built at a concrete variant, or one unadopted whose field set names a
  // variant and no struct, constructs the bare variant struct, not a union box.
  const ad = nodeRepTyAt(exprIx, fnIx)
  const pvi = if ad >= 0 && ad != nodeTyAt(exprIx, fnIx) { litArmRowOf(exprIx, fnIx, ad) } else { objLitVariantIdxNoStructRow(exprIx, fnIx) }
  if pvi >= 0 && pvi < uVariants.length {
    return emitVariantStruct(body, exprIx, pvi, fnIx, ec)
  }
  // A literal whose field-set matches a STANDALONE struct constructs that struct
  // directly (even alongside a union — `ast.vl`'s `Tok`/`Diag` coexist with `Node`).
  // Otherwise, in a union program, it is a union variant: box it `{tag, value}`.
  if structIndexOfObjCtx(exprIx, fnIx) >= 0 {
    return emitObj(body, exprIx, fnIx, row, ec)
  }
  if uDeclared { return emitUnionBox(body, exprIx, fnIx, ec) }
  return emitObj(body, exprIx, fnIx, row, ec)
}

function emitMemberNode(
  body: u8[],
  e: Member,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const tlm = twoListUseMsg(e.memObj, e.memProp, fnIx)
  if tlm != "" { return emitFailAt(tlm, exprIx) }
  // `a.length` on an array or string receiver is a `struct.get` of the receiver's own
  // length field — the list wrapper's `len` (field 1) or the string header's `len`
  // (field 2), a code-point count. `length` over any other receiver falls through to the struct path.
  if e.memProp == "length" {
    const growLen = emitListFitGrowLen(body, e, exprIx, fnIx, ec)
    if growLen != 0 { return if growLen < 0 { -1 } else { 0 } }
    // A string-literal union atom widens to its member's string, whose header holds the length.
    if memberLenWidensAtom(e.memObj, fnIx) {
      if emitAtomToStr(body, e.memObj, fnIx, ec) < 0 { return -1 }
      fbStrLen()
      return 0
    }
    if (
      exprArray(e.memObj, fnIx)
      || exprString(e.memObj, fnIx)
      || exprRefArray(e.memObj, fnIx)
      || exprStringArray(e.memObj, fnIx)
      || exprF64Array(e.memObj, fnIx)
      || exprI64Array(e.memObj, fnIx)
      || exprF32Array(e.memObj, fnIx)
      || exprU8Array(e.memObj, fnIx)
    ) {
      return emitArrLen(body, exprIx, fnIx, ec)
    }
    // G8: `m.length` on a MAP is the LIVE entry count — struct field 5 (`size`),
    // maintained by set/delete (NOT `count`, which includes tombstones).
    if exprMap(e.memObj, fnIx) {
      if emitExpr(body, e.memObj, fnIx, ec) < 0 { return -1 }
      let lsl = mapShapeOfExpr(e.memObj, fnIx)
      lsl = mapShapeFoldSet(lsl)
      fbStructGet(mapTypeIdxOf(lsl), 5) // 0xfb 0x02: field 5 `size`
      return 0
    }
  }
  return emitMem(body, exprIx, fnIx, ec)
}

// ── numeric-union dispatch ─────────────────────────────────────────────────────
// An operator over a union of numeric primitives computes at each member's own type: each
// operand is evaluated once into a lazy-frame stash, a tag test picks the member, and every
// member pair takes the scalar rule (`numPairOpTy`). A union result re-boxes each pair's value.

// How deeply the operands being stashed are nested, so an inner dispatch stashes apart.
let njDepth = 0
// The dispatch being lowered: its operator node, its two operands' member types (a scalar
// operand is its one type), their stash slots (-2 for a literal emitted per arm), and the
// result's shape. Set once per dispatch; the arms read them and run no user code.
let njBin = -1
let njOp = ""
let njLTys: i32[] = []
let njRTys: i32[] = []
let njLUnion = false
let njRUnion = false
let njLSlot = -1
let njRSlot = -1
let njLIx = -1
let njRIx = -1
let njResBox = false
let njBlockKind: VKind = "i32"
// Whether each side is a two-base integer-literal union, whose pairs compute at `i64` (D3512).
let njLLit = false
let njRLit = false

// The value-atom kind of numeric primitive type `t` (0 i32, 3 i64, 4 f64, 5 f32), or -1.
function njKindOfTy(t: i32): i32 {
  const p = tyPrimNameOf(t)
  if p == null { return -1 }
  const k = valueAtomKind(primNameStr(p))
  if k == 0 || k == 3 || k == 4 || k == 5 { return k }
  -1
}

// The valtype kind of value-atom kind `k`.
function njVKind(k: i32): VKind {
  if k == 3 { return "i64" }
  if k == 4 { return "f64" }
  if k == 5 { return "f32" }
  "i32"
}

// Whether the value at `ix` is a union of numeric primitives (`njMembersOf`).
export function nodeIsNumUnion(ix: i32, fnIx: i32): boolean {
  if ix < 0 { return false }
  // Nearly every operand is typed at one primitive, which answers without a walk.
  if tyIsPrimIx(nodeTyAt(ix, fnIx)) { return false }
  njMembersOf(ix, fnIx).length > 0
}

// Whether the value at `ix` is a box of numbers a widening delivery converts out of member by
// member: a numeric union, or an integer-literal union over two bases (D3491), which mints no
// numeric union and so is asked without that gate.
function njWidensOut(ix: i32, fnIx: i32): boolean {
  // Nearly every widened value is typed at one primitive, which is no box.
  if tyIsPrimIx(nodeTyAt(ix, fnIx)) { return false }
  if numUnionMinted && nodeIsNumUnion(ix, fnIx) { return true }
  njLitBasesOf(ix, fnIx).length > 0
}

// Whether the value at `ix` lowers as a box of numbers that converts out member by member,
// though a widening's fast path classified it at the destination's width.
function njBoxWidens(ix: i32, fnIx: i32): boolean {
  njWidensOut(ix, fnIx) && exprUnion(ix, fnIx)
}

// The bases of the two-base literal-number union the value at `ix` holds (`litNumUnionBasesOf`):
// its recorded type's, at the instance `fnIx` where that is a hole or type parameter (D9523),
// or, for a name narrowed past `null`, its nullable type's. Empty otherwise.
function njLitBasesOf(ix: i32, fnIx: i32): i32[] {
  const t = njSideTyOf(ix, fnIx)
  const lb = litNumUnionBasesOf(t)
  if lb.length > 0 || t < 0 { return lb }
  const nn = nonNullTy(t)
  if nn == t { return lb }
  const nb = litNumUnionBasesOf(nn)
  if nb.length == 0 { return nb }
  const u = nodeAt(unwrapParen(ix))
  if u is Ident {
    if narrowDropsNull(u.identName) { return nb }
  }
  lb
}

// The type of operand `ix` a dispatch reads its literal bases off: its recorded type, or where
// that is a hole or type parameter, the one instance `fnIx` binds it to.
function njSideTyOf(ix: i32, fnIx: i32): i32 {
  const t = nodeTyAt(ix, fnIx)
  if t < 0 || t >= T.tys.length || !(tyAt(t) is TyVar) { return t }
  const it = nodeTyInOf(ix, fnIx)
  if it < 0 || it >= T.tys.length || tyHasTyVar(it) { return t }
  it
}

// Whether the value at `ix` is a two-base integer-literal union rather than a numeric union: its
// members are constants, so an operator over it computes at the common width `i64` (D3512).
function njIsLitSide(ix: i32, fnIx: i32): boolean {
  numUnionMembersOf(njSideTyOf(ix, fnIx)).length == 0
    && njLitBasesOf(ix, fnIx).length > 0
}

// The type member `m` of the current dispatch's `left` or right side computes at.
function njPairSideTy(left: boolean, m: i32): i32 {
  if (left && njLLit) || (!left && njRLit) { return numPrimTyOfKind(3) }
  m
}

// The member types of the numeric union at `ix`: its recorded type's, or, where an instance
// left that a type parameter, the members of the union its box is lowered as. Empty otherwise.
function njMembersOf(ix: i32, fnIx: i32): i32[] {
  const t = nodeTyAt(ix, fnIx)
  const ms = numUnionMembersOf(t)
  if ms.length > 0 { return ms }
  const lb = njLitBasesOf(ix, fnIx)
  if lb.length > 0 { return lb }
  const none: i32[] = []
  // Only a name can be a box its recorded type does not name; any other node is typed by it,
  // at the instance's pin where it records a hole (D9701).
  const u = nodeAt(unwrapParen(ix))
  if !(u is Ident) {
    if t >= 0 && t < T.tys.length && tyAt(t) is TyVar {
      return numUnionMembersOf(njSideTyOf(ix, fnIx))
    }
    return none
  }
  if tyIsNumericBox(t) {
    // A name narrowed past its `null` holds only the number members of its box.
    if narrowDropsNull(u.identName) { return numUnionMembersOf(nonNullTy(t)) }
    return none
  }
  // An instance's parameter can carry no recorded type at all; its box still names the members.
  if t >= 0 && !tyHasTyVar(t) { return none }
  if !exprUnion(ix, fnIx) { return none }
  let name = unionNameOfExpr(ix, fnIx)
  // A name an instance narrowed (`!= null`) holds the members its narrowing names.
  if u is Ident {
    const nv = narrowVariantFor(u.identName)
    if nv != "" && nv != "null" { name = nv }
  }
  if name == "" { return none }
  const out: i32[] = []
  for k in njKindsOfUnionName(name) {
    if k == 6 {
      // Skipped: an operator reaches a type parameter's box only past a check that excluded
      // `null` (the template's narrowing), whatever member set the instance's name spells.
    } else if k != 0 && k != 3 && k != 4 && k != 5 {
      return none
    } else {
      out.push(numPrimTyOfKind(k))
    }
  }
  if out.length < 2 { return none }
  out
}

// A lazy-frame slot for dispatch depth and side `key`: code 26 a `(ref null $uBox)`, code 27 a
// scalar of `kind`. Deduped on all three, so siblings at one depth share it.
function njSlot(code: i32, kind: MfKind, key: i32): i32 {
  let k = 0
  while k < liKinds.length {
    if liBack[k] == code && liSlots[k] == key && liKinds[k] == kind {
      return listIdxScratchBase + 1 + k
    }
    k = k + 1
  }
  liKinds.push(kind)
  liSlots.push(key)
  liBack.push(code)
  listIdxScratchBase + liKinds.length
}

// The scalar-stash kind of value-atom kind `k`.
function njMfKind(k: i32): MfKind {
  if k == 3 { return "i64" }
  if k == 4 { return "f64" }
  if k == 5 { return "f32" }
  "i32"
}

// Converts the numeric value on the stack from kind `from` to kind `to`: the exact widenings a
// pair performs and the conversions an infallible `as` names.
function njConvert(from: i32, to: i32) {
  if from == to { return 0 }
  if to == 4 {
    if from == 0 { return fbF64ConvertI32S() }
    if from == 3 { return fbF64ConvertI64S() }
    if from == 5 { return fbF64PromoteF32() }
  }
  if to == 5 {
    if from == 0 { return fbF32ConvertI32S() }
    if from == 3 { return fbF32ConvertI64S() }
    if from == 4 { return fbF32DemoteF64() }
  }
  if to == 3 && from == 0 { return fbI64ExtendI32S() }
  emitFail("emitProgram: a numeric union member has no conversion to this type")
}

// Evaluates operand `ix` once: a numeric union's box into slot code 26, a scalar into code 27.
// A bare numeric literal is left to each arm, at the pair's type (-2). -1 on failure.
function njStash(
  body: u8[],
  ix: i32,
  isUnion: boolean,
  key: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if isUnion {
    // A join whose arms are scalars is built as the box here, as a union destination builds it.
    let sr = 0
    if exprUnion(ix, fnIx) {
      sr = emitExpr(body, ix, fnIx, ec)
    } else {
      sr = emitUnionCoerce(
        body,
        valueUnionKeyTextOfTy(nodeTyIxOf(ix)),
        nodeTyIxOf(ix),
        ix,
        fnIx,
        ec,
      )
    }
    if sr < 0 { return -1 }
    const bs = njSlot(26, "i32", key)
    fbLocalSet(bs)
    return bs
  }
  if cexLitPeel(ix) >= 0 { return -2 }
  const k = njKindOfExpr(ix, fnIx)
  if emitExprAsKind(body, ix, k, fnIx, ec) < 0 { return -1 }
  const ss = njSlot(27, njMfKind(k), key)
  fbLocalSet(ss)
  ss
}

// The kind of scalar operand `ix`: its recorded type's, or, where an instance left that open,
// the width its lowering reads it at.
function njKindOfExpr(ix: i32, fnIx: i32): i32 {
  const k = njKindOfTy(nodeTyIxOf(ix))
  if k >= 0 { return k }
  if exprIsF64(ix, fnIx) { return 4 }
  if exprIsF32(ix, fnIx) { return 5 }
  if exprIsI64(ix, fnIx) { return 3 }
  0
}

// Pushes one side of the current dispatch at kind `p`, the side holding member type `m`; a
// literal side is built at `p`, the dispatch member's width.
function njPushSide(left: boolean, m: i32, p: i32) {
  let slot = njRSlot
  let isU = njRUnion
  let ix = njRIx
  if left {
    slot = njLSlot
    isU = njLUnion
    ix = njLIx
  }
  if slot == -2 {
    return emitNumLitAs(ix, primNameStr(tyPrimNameOf(numPrimTyOfKind(p))))
  }
  fbLocalGet(slot)
  const mk = njKindOfTy(m)
  if isU {
    if emitUnionUnboxTail(mk) < 0 { return -1 }
  }
  njConvert(mk, p)
}

// The tag test `box.tag == tag(kind k)` over the box in `slot`.
function njTagTest(slot: i32, k: i32) {
  fbLocalGet(slot)
  fbStructGet(uBoxIdx, 0)
  fbI32Rel(RS_TAG, scalarTagOfKind(k))
  fbI32Bin(70) // 0x46 i32.eq
}

// One member pair of the current binary dispatch: both sides at the pair's type, the operator,
// and the pair's value boxed when the result is a union.
function njPair(a: i32, b: i32) {
  const n = nodeAt(njBin)
  if !(n is BinExpr) {
    return emitFail("emitProgram: numeric union dispatch lost its operator")
  }
  const pty = numPairOpTy(n, njPairSideTy(true, a), njPairSideTy(false, b))
  const p = njKindOfTy(pty)
  if pty < 0 || p < 0 {
    return emitFail(
      "emitProgram: a numeric union member pair has no operator type",
    )
  }
  if njResBox { fbI32Rel(RS_TAG, scalarTagOfKind(p)) }
  const fRem = njOp == "%" && (p == 4 || p == 5)
  if fRem && gHelpF64Rem < 0 {
    return emitFail(
      "emitProgram: a float '%' reached the emitter with no __f64_rem__ helper reserved",
    )
  }
  if njPushSide(true, a, p) < 0 { return -1 }
  if fRem && p == 5 { fbF64PromoteF32() }
  if njPushSide(false, b, p) < 0 { return -1 }
  if fRem {
    if p == 5 { fbF64PromoteF32() }
    fbCall(gHelpF64Rem)
    if p == 5 { fbF32DemoteF64() }
  } else {
    let opc = binOpcode(njOp)
    if p == 3 { opc = binOpcodeI64(njOp) }
    if p == 4 { opc = binOpcodeF64(njOp) }
    if p == 5 { opc = binOpcodeF32(njOp) }
    if opc < 0 {
      return emitFail(
        "emitProgram: operator '"
          + njOp
          + "' has no form at a numeric union member",
      )
    }
    fbI32Bin(opc)
  }
  if njResBox {
    fbStructNew(vbHeapIdxOfKind(p))
    fbStructNew(uBoxIdx)
  }
  0
}

// The right side's dispatch under left member `a`, from right member `j` on.
function njArmR(a: i32, j: i32) {
  if !njRUnion || j == njRTys.length - 1 { return njPair(a, njRTys[j]) }
  njTagTest(njRSlot, njKindOfTy(njRTys[j]))
  fbOpenIf()
  fbValtype(njBlockKind, -1)
  if njPair(a, njRTys[j]) < 0 { return -1 }
  fbElse()
  if njArmR(a, j + 1) < 0 { return -1 }
  fbEnd()
  0
}

// The left side's dispatch from left member `i` on; the last member is the bare `else`.
function njArmL(i: i32) {
  if !njLUnion || i == njLTys.length - 1 { return njArmR(njLTys[i], 0) }
  njTagTest(njLSlot, njKindOfTy(njLTys[i]))
  fbOpenIf()
  fbValtype(njBlockKind, -1)
  if njArmR(njLTys[i], 0) < 0 { return -1 }
  fbElse()
  if njArmL(i + 1) < 0 { return -1 }
  fbEnd()
  0
}

// The numeric type scalar operand `ix` is dispatched at: its recorded type when that is a
// number, else the primitive of the width it lowers at.
function njScalarTy(ix: i32, fnIx: i32): i32 {
  const t = nodeTyIxOf(ix)
  if njKindOfTy(t) >= 0 { return t }
  numPrimTyOfKind(njKindOfExpr(ix, fnIx))
}

// Whether `e` is an operator over a numeric union and a number: not a `null` test, an
// assignment or a short-circuit.
function njDispatches(e: BinExpr, fnIx: i32): boolean {
  // Two primitive operands, nearly every operator, answer without a call each.
  if (
    tyIsPrimIx(nodeTyAt(e.binLeft, fnIx))
    && tyIsPrimIx(nodeTyAt(e.binRight, fnIx))
  ) {
    return false
  }
  if !nodeIsNumUnion(e.binLeft, fnIx) && !nodeIsNumUnion(e.binRight, fnIx) {
    return false
  }
  if nodeAt(unwrapParen(e.binLeft)) is NullLit { return false }
  if nodeAt(unwrapParen(e.binRight)) is NullLit { return false }
  // An equality can meet the `null` an instance's box holds, which the dispatch skips; the
  // union equality tests the tag first (D3520).
  if (
    (e.binOp == "==" || e.binOp == "!=")
    && (njBoxHoldsNull(e.binLeft, fnIx) || njBoxHoldsNull(e.binRight, fnIx))
  ) {
    return false
  }
  e.binOp != "=" && e.binOp != "&&" && e.binOp != "||" && e.binOp != "??"
}

// Whether the name at `ix` is an instance's box whose member set holds a `null` it has not
// been narrowed past: the member `njMembersOf` skips.
function njBoxHoldsNull(ix: i32, fnIx: i32): boolean {
  const u = nodeAt(unwrapParen(ix))
  if !(u is Ident) { return false }
  const t = nodeTyIxOf(ix)
  if t < 0 || !tyHasTyVar(t) || !exprUnion(ix, fnIx) { return false }
  const nv = narrowVariantFor(u.identName)
  if nv != "" && nv != "null" { return false }
  const name = unionNameOfExpr(ix, fnIx)
  if name == "" { return false }
  for k in njKindsOfUnionName(name) {
    if k == 6 { return true }
  }
  false
}

// `a op b` where an operand is a numeric union.
function emitNumUnionBin(
  body: u8[],
  e: BinExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const lMs = njMembersOf(e.binLeft, fnIx)
  const rMs = njMembersOf(e.binRight, fnIx)
  const key = njDepth * 2
  njDepth = njDepth + 1
  const ls = njStash(body, e.binLeft, lMs.length > 0, key, fnIx, ec)
  let rs = -1
  if ls != -1 {
    rs = njStash(body, e.binRight, rMs.length > 0, key + 1, fnIx, ec)
  }
  njDepth = njDepth - 1
  if ls == -1 || rs == -1 { return -1 }
  njBin = exprIx
  njOp = e.binOp
  njLUnion = lMs.length > 0
  njRUnion = rMs.length > 0
  njLLit = njLUnion && njIsLitSide(e.binLeft, fnIx)
  njRLit = njRUnion && njIsLitSide(e.binRight, fnIx)
  njLTys = lMs
  if !njLUnion { njLTys = [njScalarTy(e.binLeft, fnIx)] }
  njRTys = rMs
  if !njRUnion { njRTys = [njScalarTy(e.binRight, fnIx)] }
  njLSlot = ls
  njRSlot = rs
  njLIx = e.binLeft
  njRIx = e.binRight
  // The result's shape from the pairs themselves, as the checker's `numUnionResultTy` builds it.
  const rks = njResultKinds(e)
  if rks.length == 0 {
    return emitFail(
      "emitProgram: a numeric union member pair has no operator type",
    )
  }
  njResBox = rks.length > 1 && !numCmpOp(e.binOp)
  njBlockKind = "i32"
  if njResBox { njBlockKind = "union" }
  else if !numCmpOp(e.binOp) { njBlockKind = njVKind(rks[0]) }
  // The node's consumers read its recorded type, so a result shape it does not name is refused
  // loudly rather than handed on in a rep they do not expect (D3453).
  if !numCmpOp(e.binOp) {
    const recTy = njSideTyOf(exprIx, fnIx)
    const recBox = tyIsNumUnion(recTy)
    if recBox != njResBox || (!njResBox && njKindOfTy(recTy) != rks[0]) {
      return emitFail(
        "emitProgram: an operator over a numeric union has no recorded result type at this instance",
      )
    }
  }
  njArmL(0)
}

// The distinct kinds the member pairs of the current dispatch compute at, in first-seen order;
// empty when a pair has none.
function njResultKinds(e: BinExpr): i32[] {
  const out: i32[] = []
  const none: i32[] = []
  for a in njLTys {
    for b in njRTys {
      const k = njKindOfTy(
        numPairOpTy(e, njPairSideTy(true, a), njPairSideTy(false, b)),
      )
      if k < 0 { return none }
      let seen = false
      for q in out {
        if q == k { seen = true }
      }
      if !seen { out.push(k) }
    }
  }
  out
}

// Whether `as` to kind `to` over the members `ms` can fail at none of them (`numUnionAsConverts`).
function njAsConverts(ms: i32[], to: i32): boolean {
  const tn = primNameStr(tyPrimNameOf(numPrimTyOfKind(to)))
  for m in ms {
    if numCastCanFail(primNameStr(tyPrimNameOf(m)), tn) { return false }
  }
  true
}

// Converts the numeric union at `ix` to kind `to` at whichever member it holds: an infallible
// `as`, and a delivery into a numeric primitive every member widens to exactly.
function emitNumUnionConvert(
  body: u8[],
  ix: i32,
  to: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const ms = njMembersOf(ix, fnIx)
  const key = njDepth * 2
  njDepth = njDepth + 1
  const bs = njStash(body, ix, true, key, fnIx, ec)
  njDepth = njDepth - 1
  if bs < 0 { return -1 }
  njConvertArm(ms, 0, bs, to)
}

// The conversion dispatch from member `i` on; the last member is the bare `else`.
function njConvertArm(ms: i32[], i: i32, bs: i32, to: i32) {
  const mk = njKindOfTy(ms[i])
  if i == ms.length - 1 {
    fbLocalGet(bs)
    if emitUnionUnboxTail(mk) < 0 { return -1 }
    return njConvert(mk, to)
  }
  njTagTest(bs, mk)
  fbOpenIf()
  fbValtype(njVKind(to), -1)
  fbLocalGet(bs)
  if emitUnionUnboxTail(mk) < 0 { return -1 }
  if njConvert(mk, to) < 0 { return -1 }
  fbElse()
  if njConvertArm(ms, i + 1, bs, to) < 0 { return -1 }
  fbEnd()
  0
}

// The value-atom kinds of the members of union name `unionName`, spaces trimmed.
function njKindsOfUnionName(unionName: string): i32[] {
  const atoms: string[] = []
  unionArmsOf(unionName, atoms)
  const out: i32[] = []
  for a in atoms {
    let lo = 0
    let hi = a.length
    while lo < hi && a[lo] == ' ' { lo = lo + 1 }
    while hi > lo && a[hi - 1] == ' ' { hi = hi - 1 }
    out.push(valueAtomKind(a.slice(lo, hi)))
  }
  out
}

// The destination kind a numeric member of kind `k` is stored at in a union of kinds `dk`: its
// own, else the one it widens to exactly (`i64` then `f64` for `i32`, `f64` for `f32`); -1 none.
function njStoreKind(k: i32, dk: i32[]): i32 {
  for d in dk {
    if d == k { return k }
  }
  let w: i32[] = []
  if k == 0 { w = [3, 4] }
  if k == 5 { w = [4] }
  for c in w {
    for d in dk {
      if d == c { return c }
    }
  }
  -1
}

// A numeric union at `ix` delivered to the union `unionName` that lacks one of its members but
// holds a member it widens to: re-boxed member by member. 1 done, 0 not this shape, -1 failure.
function emitNumUnionRebox(
  body: u8[],
  ix: i32,
  unionName: string,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if unionName == "" || !nodeIsNumUnion(ix, fnIx) { return 0 }
  // A delivery the checker recorded a re-tag for is re-tagged as it is emitted.
  if mapDeliveryRecorded && deliveryRetagHas(ix) { return 0 }
  const ms = njMembersOf(ix, fnIx)
  const dk = njKindsOfUnionName(unionName)
  let needs = false
  for m in ms {
    const k = njKindOfTy(m)
    const sk = njStoreKind(k, dk)
    if sk < 0 { return 0 }
    if sk != k { needs = true }
  }
  if !needs { return 0 }
  const key = njDepth * 2
  njDepth = njDepth + 1
  const bs = njStash(body, ix, true, key, fnIx, ec)
  njDepth = njDepth - 1
  if bs < 0 { return -1 }
  if njReboxArm(ms, 0, bs, dk) < 0 { return -1 }
  1
}

// The re-box dispatch from member `i` on; the last member is the bare `else`.
function njReboxArm(ms: i32[], i: i32, bs: i32, dk: i32[]) {
  const mk = njKindOfTy(ms[i])
  const sk = njStoreKind(mk, dk)
  const last = i == ms.length - 1
  if !last {
    njTagTest(bs, mk)
    fbOpenIf()
    fbValtype("union", -1)
  }
  if sk == mk {
    fbLocalGet(bs)
    fbRefAsNonNull()
  } else {
    fbI32Rel(RS_TAG, scalarTagOfKind(sk))
    fbLocalGet(bs)
    if emitUnionUnboxTail(mk) < 0 { return -1 }
    if njConvert(mk, sk) < 0 { return -1 }
    fbStructNew(vbHeapIdxOfKind(sk))
    fbStructNew(uBoxIdx)
  }
  if !last {
    fbElse()
    if njReboxArm(ms, i + 1, bs, dk) < 0 { return -1 }
    fbEnd()
  }
  0
}

// `-x` over the numeric union at `ix`: each member negates at its own type, re-boxed.
function emitNumUnionNeg(body: u8[], ix: i32, fnIx: i32, ec: ExpCtx) {
  const ms = njMembersOf(ix, fnIx)
  const key = njDepth * 2
  njDepth = njDepth + 1
  const bs = njStash(body, ix, true, key, fnIx, ec)
  njDepth = njDepth - 1
  if bs < 0 { return -1 }
  njNegArm(ms, 0, bs)
}

// The negation dispatch from member `i` on; the last member is the bare `else`.
function njNegArm(ms: i32[], i: i32, bs: i32) {
  const mk = njKindOfTy(ms[i])
  if i < ms.length - 1 {
    njTagTest(bs, mk)
    fbOpenIf()
    fbValtype("union", -1)
  }
  fbI32Rel(RS_TAG, scalarTagOfKind(mk))
  if mk == 0 { fbI32Const(0) }
  if mk == 3 { fbI64Const(0, 0) }
  fbLocalGet(bs)
  if emitUnionUnboxTail(mk) < 0 { return -1 }
  if mk == 0 {
    fbI32Bin(107) // 0x6b i32.sub
  }
  if mk == 3 {
    fbI32Bin(125) // 0x7d i64.sub
  }
  if mk == 4 { fbF64Neg() }
  if mk == 5 { fbF32Neg() }
  fbStructNew(vbHeapIdxOfKind(mk))
  fbStructNew(uBoxIdx)
  if i < ms.length - 1 {
    fbElse()
    if njNegArm(ms, i + 1, bs) < 0 { return -1 }
    fbEnd()
  }
  0
}

// The `%` lowering over two float operands: both at f64, then a call into the shared
// `__f64_rem__` helper (D1586). `atF32` re-encodes at f32 first so a literal like `0.1`
// uses f32's value, then promotes and demotes the exact result. The reservation is load-
// bearing: an unreserved helper is a `call` to index -1, so a miss fails loudly here first.
function emitF64RemCall(
  body: u8[],
  lIx: i32,
  rIx: i32,
  fnIx: i32,
  atF32: boolean,
  ec: ExpCtx,
) {
  if gHelpF64Rem < 0 {
    return emitFail(
      "emitProgram: a float '%' reached the emitter with no __f64_rem__ helper reserved",
    )
  }
  if atF32 {
    if emitExprAsF32(body, lIx, fnIx, ec) < 0 { return -1 }
    fbF64PromoteF32()
    if emitExprAsF32(body, rIx, fnIx, ec) < 0 { return -1 }
    fbF64PromoteF32()
  } else {
    if emitExprAsF64(body, lIx, fnIx, ec) < 0 { return -1 }
    if emitExprAsF64(body, rIx, fnIx, ec) < 0 { return -1 }
  }
  fbCall(gHelpF64Rem)
  if atF32 { fbF32DemoteF64() }
  0
}

// ── Shift/mask strength reduction (plumb PL-037 item 2) ──────────────────────────────────
// `((x >>> k) & m) << j` is `(x >>> (k-j)) & (m << j)` (or `(x << (j-k)) & (m << j)` when j > k):
// bit i of both is m[i-j] & x[i-j+k] for i >= j and 0 below, since a logical shift fills zeros.
// Binaryen 130 folds neither this nor the i64 narrowing below at any level, so the emitter does.

// Whether node `ix` is typed exactly `i64` (`wide`) or `i32` (a paren is its inner node).
function srTyIs(ix: i32, wide: boolean, fnIx: i32): boolean {
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return false }
  const p = tyPrimNameOf(nodeTyAt(x, fnIx))
  if wide { return p == "i64" }
  p == "i32"
}

// A shift count at `ix`: a compile-time integer in 0..w-1, else -1.
function srShiftConst(ix: i32, w: i32, fnIx: i32): i64 {
  const v = memOffsetConstValue(ix, fnIx)
  if v < 0 || v >= w { return -1 }
  v
}

// A mask at `ix`: a compile-time integer that is non-negative at width `w` (at most 2^31-1 for
// i32, 2^32-1 for i64 — `memOffsetConstValue`'s own ceiling), else -1.
function srMaskConst(ix: i32, w: i32, fnIx: i32): i64 {
  if w == 32 { return memAddrConst(ix, fnIx) }
  memOffsetConstValue(ix, fnIx)
}

// The exponent j of a power-of-two multiplier at `ix`, 0..w-1, else -1: `y * 2^j` is `y << j`
// at every width, both being multiplication modulo 2^w.
function srPow2Exp(ix: i32, w: i32, fnIx: i32): i64 {
  const v = srMaskConst(ix, w, fnIx)
  if v <= 0 || (v & (v - 1)) != 0 { return -1 }
  let j: i64 = 0
  while ((1 as i64) << j) < v { j = j + 1 }
  if j >= w { return -1 }
  j
}

// Whether `m < 2^bits` for a non-negative mask `m` (every such mask is below 2^33).
function srMaskBelow(m: i64, bits: i64): boolean {
  if bits >= 33 { return true }
  m < ((1 as i64) << bits)
}

// The shifted source under mask `m` at width `w`, as [x, k, narrow]; [] when `ix` is not one.
// `x >>> k`, or `x >> k` when m < 2^(w-k) (the sign fill never reaches a mask bit), gives
// [x, k, 0]. At w = 32, `(y >>> k) as% i32` or `(y >> k) as% i32` with y an i64 gives [y, k, 1]
// when k <= 31 and m < 2^(32-k): the mask reads bits k..31 of y only, which `wrap(y)` keeps.
function srShiftSource(ix: i32, m: i64, w: i32, fnIx: i32): i64[] {
  const none: i64[] = []
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return none }
  const e = nodeAt(x)
  if e is BinExpr { return srShiftBin(e, x, m, w, false, fnIx) }
  srNarrowSource(x, m, w, fnIx)
}

// `srShiftSource` of a node that is not a shift: an `as% i32` wrap of an i64 shift at w = 32,
// else [].
function srNarrowSource(x: i32, m: i64, w: i32, fnIx: i32): i64[] {
  const none: i64[] = []
  const e = nodeAt(x)
  if e is AsExpr {
    if w != 32 || e.asMode != "wrap" { return none }
    if asExprNumCastDomain(x) != "i32" || !srTyIs(x, false, fnIx) {
      return none
    }
    const z = unwrapParen(e.asObj)
    if z < 0 || z >= P.nodes.length { return none }
    const ze = nodeAt(z)
    if ze is BinExpr { return srShiftBin(ze, z, m, 64, true, fnIx) }
  }
  none
}

// `srShiftSource` of the shift node `e` (at `x`, width `w`). A narrowing source must also keep
// every mask bit inside the low word: k <= 31 and m < 2^(32-k).
function srShiftBin(
  e: BinExpr,
  x: i32,
  m: i64,
  w: i32,
  narrow: boolean,
  fnIx: i32,
): i64[] {
  const none: i64[] = []
  if e.binOp != ">>>" && e.binOp != ">>" { return none }
  if !srTyIs(x, w == 64, fnIx) || !srTyIs(e.binLeft, w == 64, fnIx) {
    return none
  }
  const k = srShiftConst(e.binRight, w, fnIx)
  if k < 0 { return none }
  if e.binOp == ">>" && !srMaskBelow(m, w - k) { return none }
  if narrow {
    if k > 31 || !srMaskBelow(m, 32 - k) { return none }
    return [e.binLeft as% i64, k, 1]
  }
  [e.binLeft as% i64, k, 0]
}

// The mask `&` at `ix` of width `w`, as [m, other]; [] when `ix` is not one.
function srMaskOperands(ix: i32, w: i32, fnIx: i32): i64[] {
  const none: i64[] = []
  const x = unwrapParen(ix)
  if x < 0 || x >= P.nodes.length { return none }
  const e = nodeAt(x)
  if e is BinExpr {
    if e.binOp != "&" || !srTyIs(x, w == 64, fnIx) { return none }
    const mr = srMaskConst(e.binRight, w, fnIx)
    if mr >= 0 { return [mr, e.binLeft as% i64] }
    const ml = srMaskConst(e.binLeft, w, fnIx)
    if ml >= 0 { return [ml, e.binRight as% i64] }
  }
  none
}

// A masked shift at `ix` of width `w`, as [x, k, narrow, m]; [] when `ix` is not one. Either
// `(<shift source>) & m`, or at w = 32 `((y >>> k) & m) as% i32` with y an i64, k <= 31 and
// m < 2^(32-k): the wrap keeps the low word of `(y >>> k) & m`, and so does the narrow form.
function srMaskedSource(ix: i32, w: i32, fnIx: i32): i64[] {
  const mo = srMaskOperands(ix, w, fnIx)
  if mo.length > 0 {
    const src = srShiftSource(mo[1] as% i32, mo[0], w, fnIx)
    if src.length == 0 { return src }
    return [src[0], src[1], src[2], mo[0]]
  }
  if w != 32 { return mo }
  srWrappedMask(unwrapParen(ix), fnIx)
}

// `srMaskedSource` of an `as% i32` wrap over an i64 masked shift, else [].
function srWrappedMask(x: i32, fnIx: i32): i64[] {
  const none: i64[] = []
  if x < 0 || x >= P.nodes.length { return none }
  const e = nodeAt(x)
  if e is AsExpr {
    if e.asMode != "wrap" { return none }
    if asExprNumCastDomain(x) != "i32" || !srTyIs(x, false, fnIx) {
      return none
    }
    const mo = srMaskOperands(e.asObj, 64, fnIx)
    if mo.length == 0 { return none }
    const src = srShiftSource(mo[1] as% i32, mo[0], 64, fnIx)
    if src.length == 0 { return none }
    if src[1] > 31 || !srMaskBelow(mo[0], 32 - src[1]) { return none }
    return [src[0], src[1], 1, mo[0]]
  }
  none
}

// Pushes a constant at width `w` (an i32 takes the low 32 bits).
function srConst(v: i64, w: i32) {
  if w == 64 {
    fbI64Const((v >>> 32) as% i32, v as% i32)
  } else {
    fbI32Const(v as% i32)
  }
  0
}

// The opcode of `op` at width `w`.
function srOpcode(op: string, w: i32): i32 {
  if w == 64 { return binOpcodeI64(op) }
  binOpcode(op)
}

// Pushes source `src` ([x, k, narrow]) exactly as the unreduced chain would have evaluated x: at
// its own width, then `i32.wrap_i64` for a narrowing source.
function srPushSource(
  body: u8[],
  src: i64[],
  w: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  const x = src[0] as% i32
  if src[2] == 1 {
    if emitExprAsKind(body, x, 3, fnIx, ec) < 0 { return -1 }
    fbI32WrapI64()
    return 0
  }
  if w == 64 { return emitExprAsI64(body, x, fnIx, ec) }
  emitExpr(body, x, fnIx, ec)
}

// Emits narrowing source `src` ([y, k, 1, m]) as `(wrap(y) >>> k) & m`, all at i32.
function srEmitNarrowed(body: u8[], src: i64[], fnIx: i32, ec: ExpCtx): i32 {
  if srPushSource(body, src, 32, fnIx, ec) < 0 { return -1 }
  if src[1] > 0 {
    srConst(src[1], 32)
    fbI32Bin(srOpcode(">>>", 32))
  }
  srConst(src[3], 32)
  fbI32Bin(srOpcode("&", 32))
  0
}

// Emits `e` (at `exprIx`, width `w`) strength-reduced when it is one of the shapes above:
// `((x >>> k) & m) << j`, the same with `* 2^j`, or a narrowing `(y >>> k) as% i32 & m`.
// Answers 0 when emitted, -1 on an emit failure, 1 when `e` is none of them (nothing
// pushed). Every operand but x is a constant, so evaluation order and traps are unchanged.
function emitShiftMaskFold(
  body: u8[],
  e: BinExpr,
  exprIx: i32,
  w: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if !srTyIs(exprIx, w == 64, fnIx) { return 1 }
  if e.binOp == "&" {
    if w != 32 { return 1 }
    const nsrc = srMaskedSource(exprIx, w, fnIx)
    if nsrc.length == 0 || nsrc[2] != 1 { return 1 }
    return srEmitNarrowed(body, nsrc, fnIx, ec)
  }
  let j: i64 = -1
  let inner = -1
  if e.binOp == "<<" {
    j = srShiftConst(e.binRight, w, fnIx)
    inner = e.binLeft
  } else if e.binOp == "*" {
    j = srPow2Exp(e.binRight, w, fnIx)
    inner = e.binLeft
    if j < 0 {
      j = srPow2Exp(e.binLeft, w, fnIx)
      inner = e.binRight
    }
  }
  if j < 0 { return 1 }
  const src = srMaskedSource(inner, w, fnIx)
  if src.length == 0 { return 1 }
  if srPushSource(body, src, w, fnIx, ec) < 0 { return -1 }
  const k = src[1]
  if k > j {
    srConst(k - j, w)
    fbI32Bin(srOpcode(">>>", w))
  } else if j > k {
    srConst(j - k, w)
    fbI32Bin(srOpcode("<<", w))
  }
  srConst(src[3] << j, w)
  fbI32Bin(srOpcode("&", w))
  0
}

// `emitBinExprNode` holding its arithmetic region's classifier answers for the whole walk (D2445).
function emitBinExprInRegion(
  body: u8[],
  e: BinExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const opened = bcSpineEnter(exprIx, fnIx)
  const rc = emitBinExprNode(body, e, exprIx, fnIx, ec)
  bcSpineLeave(opened)
  rc
}

// Store the assignment at `asgIx` and re-read its target cell, then apply `unwidenOp` (an
// opcode, or -1 for none) to take the cell's rep back to the value's (D2512).
function emitAsgValue(
  body: u8[],
  asgIx: i32,
  fnIx: i32,
  unwidenOp: i32,
  ec: ExpCtx,
): i32 {
  const a = nodeAt(asgIx)
  if !(a is BinExpr) { return emitFail("emitProgram: expected an assignment") }
  if emitAssign(body, asgIx, fnIx, ec) < 0 { return -1 }
  // A box cell re-read at the one member the checker typed the value at (`asgReadNarrowTy`).
  const asgTop = pushAsgReadNarrow(asgIx, fnIx)
  // The re-read yields the value just stored, so it is never a read before init (D2652).
  const savedGuardOff = initGuardOff
  initGuardOff = true
  const asgMark = asgReReadEnter(asgIx)
  const asgRc = emitExpr(body, a.binLeft, fnIx, ec)
  asgReReadLeave(asgMark)
  initGuardOff = savedGuardOff
  if asgTop >= 0 { restoreNarrow(asgTop) }
  if asgRc >= 0 && unwidenOp >= 0 { wU8(unwidenOp) }
  asgRc
}

// Emit the assignment at `exprIx`, whose right side is built at the wide primitive `wp`
// (`asgRadixWidePrim`), as a value of primitive `want`: the stored cell where the widths
// agree, else the 32-bit pattern the checker typed it at, converted as an `i32` is (D3733).
function emitAsgRadixAs(
  body: u8[],
  exprIx: i32,
  wp: string,
  want: string,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  const ix = unwrapParen(exprIx)
  if wp == want { return emitAsgValue(body, ix, fnIx, -1, ec) }
  if want == "f64" && wp == "i64" {
    if emitAsgValue(body, ix, fnIx, -1, ec) < 0 { return -1 }
    fbF64ConvertI64S()
    return 0
  }
  if emitAsgValue(body, ix, fnIx, asgReadUnwidenOp(ix, fnIx), ec) < 0 {
    return -1
  }
  if want == "i64" {
    fbI64ExtendI32S()
  } else if want == "f64" {
    fbF64ConvertI32S()
  } else if want == "f32" {
    fbF32ConvertI32S()
  } else {
    return emitFail(
      "emitProgram: a radix assignment value has no "
        + want
        + " conversion",
    )
  }
  0
}

function emitBinExprNode(
  body: u8[],
  e: BinExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // A mask that only zero-extends a load is the zero-extending load itself (`zextLoadOf`).
  if e.binOp == "&" {
    const zlAnd = zextLoadOf(exprIx, fnIx)
    if zlAnd >= 0 { return emitZextLoad(body, zlAnd, fnIx, ec) }
  }
  // Assignment (`=`) is a STATEMENT, not a value expression in this slice: it has
  // no result on the stack (it `local.set`s). It is lowered by `emitAssign` from
  // `emitStmt`, so seeing it as an operand here is an unsupported nested-assignment.
  if e.binOp == "=" {
    // Assignment is an expression yielding its right-hand side (DECISIONS:
    // assignment-as-expression), lowered as store-then-re-read — `emitAssign` stores, then
    // the target re-reads through the Ident path (a local or module global). The functype
    // reads the checker's type of the assignment; D29 is the `string | null` half.
    const asgLit = emitAsgLitAs(
      body,
      exprIx,
      asgLitWidth(exprIx, fnIx),
      fnIx,
      ec,
    )
    if asgLit != -2 { return asgLit }
    if asgYieldsNullLit(exprIx) {
      if emitAssign(body, exprIx, fnIx, ec) < 0 { return -1 }
      return emitExpr(body, e.binRight, fnIx, ec)
    }
    if assignTargetReReads(exprIx, fnIx) {
      return emitAsgValue(
        body,
        exprIx,
        fnIx,
        asgReadUnwidenOp(exprIx, fnIx),
        ec,
      )
    }
    return emitFail(
      "emitProgram: only an identifier assignment is a value expression",
    )
  }
  // G8: nullish-coalescing `m[k] ?? d` — a FUSED map get-with-default: scan `m` for
  // `k`, push `vals[hit]` on a hit else the default `d`. The self-host checker reads
  // every scope map through `?? -1`. The LHS must be a map index in this slice.
  if e.binOp == "??" { return emitCoalesce(body, e, exprIx, fnIx, ec) }
  // A numeric union beside a number compares per member, ahead of the box's tag compare; a
  // `null` test of one keeps the box's own test.
  if numUnionMinted && (e.binOp == "==" || e.binOp == "!=") {
    if njDispatches(e, fnIx) {
      return emitNumUnionBin(body, e, exprIx, fnIx, ec)
    }
  }
  // A null test of a value the checker proved non-null is dead: its answer is a constant.
  if e.binOp == "==" || e.binOp == "!=" {
    const dnIx = deadNullTestOperand(e, fnIx)
    if dnIx >= 0 {
      return emitDeadNullTest(body, dnIx, e.binOp == "!=", fnIx, ec)
    }
  }
  // Short-circuit `&&`/`||` lower to a value-typed `if` (blocktype 0x7f): `a && b` is `if (a)
  // { b } else { 0 }`, `a || b` is `if (a) { 1 } else { b }`. The right operand is a narrowing
  // scope like an `if` arm — `&&` narrows it with `setNarrowFromCond`, `||` with
  // `setNarrowFromCondElse`; skip that and a value-union box reaches an unnarrowed compare.
  if e.binOp == "&&" || e.binOp == "||" {
    if emitExpr(body, e.binLeft, fnIx, ec) < 0 {
      return -1 // condition `a`
    }
    fbIf(127) // 0x04 if, 0x7f i32 result-type blocktype (yields an i32)
    const scTop = narrowTop
    if e.binOp == "&&" {
      // then = b, else = 0
      const scNarrowed = setNarrowFromCond(e.binLeft, fnIx)
      if emitExpr(body, e.binRight, fnIx, ec) < 0 { return -1 }
      if scNarrowed { restoreNarrow(scTop) }
      fbElse() // 0x05 else
      fbI32Const(0)
    } else {
      // then = 1, else = b
      fbI32Const(1)
      fbElse() // 0x05 else
      const scNarrowedElse = setNarrowFromCondElse(e.binLeft, fnIx)
      if emitExpr(body, e.binRight, fnIx, ec) < 0 { return -1 }
      if scNarrowedElse { restoreNarrow(scTop) }
    }
    fbEnd() // 0x0b end
    return 0
  }
  // Structural `==`/`!=` with a still-boxed value-union operand (either side, or both).
  // Checked before the string-eq routing, which would otherwise misclassify a union box
  // compared against a string as a bare string compare, and skips `null` literals — the
  // box-tag null compare below owns `v == null` (the host's `variantTag(info, null)` path).
  if e.binOp == "==" || e.binOp == "!=" {
    const uql = nodeAt(unwrapParen(e.binLeft))
    const uqr = nodeAt(unwrapParen(e.binRight))
    // Both sides bare `null` is static — true by the type alone, no rep needed (D1018).

    // Distinct from D20's family, which has a `T | null` and asks about that niche. Here there
    // is no `T`: an unconstrained hole resolves to bare `null`, and `null == null` is true by
    // the type alone.
    if uql is NullLit {
      if uqr is NullLit {
        if e.binOp == "==" { fbI32Const(1) } else { fbI32Const(0) }
        return 0
      }
    }
    const smq = emitScalarMapReadEq(body, e, fnIx, ec)
    if smq < 0 { return -1 }
    if smq > 0 { return 0 }
    let uqNull = false
    if uql is NullLit { uqNull = true }
    if uqr is NullLit { uqNull = true }
    // The litunion exclusion is per-operand, not per-compare — `exprUnion` also claims a
    // `K`-annotated binding, so this arm disqualifies the litunion operand rather than the
    // whole compare. Disqualifying the whole compare let `boxU == k` skip the union path when
    // one side is an atom, pushing the box ref under an `i32.eq`: `vl check` rc 0, invalid wasm.
    if !uqNull {
      const uqL = exprUnion(e.binLeft, fnIx)
        && !eqAtomOperandOk(e.binLeft, fnIx)
      const uqR = exprUnion(e.binRight, fnIx)
        && !eqAtomOperandOk(e.binRight, fnIx)
      if uqL && uqR {
        return emitUnionUnionEq(
          body,
          e.binLeft,
          e.binRight,
          e.binOp == "!=",
          fnIx,
          ec,
        )
      }
      if uqL {
        return emitUnionConcreteEq(
          body,
          e.binLeft,
          e.binRight,
          e.binOp == "!=",
          fnIx,
          ec,
        )
      }
      if uqR {
        return emitUnionConcreteEq(
          body,
          e.binRight,
          e.binLeft,
          e.binOp == "!=",
          fnIx,
          ec,
        )
      }
    }
  }
  return emitBinLitEq(body, e, exprIx, fnIx, ec)
}

// `emitBinExprNode` past its union compares: the string-literal and atom compares, and the
// `==` floors and nullable niches every later compare would misread.
function emitBinLitEq(
  body: u8[],
  e: BinExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // Two string-literal types compare in O(1): an operand typed as one string literal is that
  // literal whatever it reads, so beside another such operand the compare folds, and beside an
  // atom it is its interned id. Both operands still evaluate, for their effects (D2156).
  if e.binOp == "==" || e.binOp == "!=" {
    const slL = staticStrLitLex(e.binLeft, fnIx)
    const slR = staticStrLitLex(e.binRight, fnIx)
    if slL != "" && slR != "" {
      if emitStaticLitAtom(body, e.binLeft, slL, fnIx, ec) < 0 { return -1 }
      fbDrop()
      if emitStaticLitAtom(body, e.binRight, slR, fnIx, ec) < 0 { return -1 }
      fbDrop()
      if strLexSameValue(slL, slR) == (e.binOp == "==") {
        fbI32Const(1)
      } else {
        fbI32Const(0)
      }
      return 0
    }
    const slAtomL = slL != "" && exprIsLitAtom(e.binRight, fnIx)
    const slAtomR = slR != "" && exprIsLitAtom(e.binLeft, fnIx)
    if slAtomL || slAtomR {
      // The static side is spelled as the member it equals, since an atom is interned by its
      // member's lexeme; a value no member equals leaves an id no atom carries, so `==` is false.
      let slLex = slR
      let slAtomIx = e.binLeft
      if slAtomL {
        slLex = slL
        slAtomIx = e.binRight
      }
      const slMem = memberLexOfValue(litAtomWidenTexts(slAtomIx, fnIx), slLex)
      const slCtx = expCtxHere(ec)
      slCtx.litUnion = 1
      if slAtomL {
        if emitStaticLitAtom(body, e.binLeft, slMem, fnIx, ec) < 0 { return -1 }
        if emitExprExpect(body, e.binRight, fnIx, slCtx) < 0 { return -1 }
      } else {
        if emitExprExpect(body, e.binLeft, fnIx, slCtx) < 0 { return -1 }
        if emitStaticLitAtom(body, e.binRight, slMem, fnIx, ec) < 0 {
          return -1
        }
      }
      fbI32Bin(70) // 0x46 i32.eq
      if e.binOp == "!=" { fbI32Eqz() }
      return 0
    }
  }
  // A literal-union atom compare (`k == "a"`, `k1 == k2`) emits both operands as i32 ids (a
  // member `StrLit` as its id, a litunion var as its i32 value) and i32-compares, before the
  // string-eq path. Both operands must be atom-lowerable (`eqAtomOperandOk`); a mixed pair
  // falls through to string-eq instead, which widens the atom to its member string.
  if e.binOp == "==" || e.binOp == "!=" {
    // SKIP a `null` operand: `r == null` over a `K | null` niche is the `-1` sentinel compare (the
    // nullable-struct block below owns it). A litunion atom never equals the `null` literal here, and
    // lowering `null` with `ec.litUnion` would mis-route it to a bare-null struct context.
    let atomNull = false
    if nodeAt(unwrapParen(e.binLeft)) is NullLit { atomNull = true }
    if nodeAt(unwrapParen(e.binRight)) is NullLit { atomNull = true }
    if !atomNull {
      if exprIsLitAtom(e.binLeft, fnIx) || exprIsLitAtom(e.binRight, fnIx) {
        if (
          eqAtomOperandOk(e.binLeft, fnIx)
          && eqAtomOperandOk(e.binRight, fnIx)
        ) {
          const luCtx = expCtxHere(ec)
          luCtx.litUnion = 1
          if emitExprExpect(body, e.binLeft, fnIx, luCtx) < 0 { return -1 }
          if emitExprExpect(body, e.binRight, fnIx, luCtx) < 0 { return -1 }
          fbI32Bin(70) // 0x46 i32.eq
          if e.binOp == "!=" {
            fbI32Eqz() // 0x45 i32.eqz -> `!=`
          }
          return 0
        }
      }
    }
  }
  // A `==`/`!=` over a nullable ref niche, plus the emitter-capability floor for a rep with no
  // compare core — both off the one comparability home (`nodeEqCmpKind`), the same function
  // the checker's acceptance reads. Comes before the string/list/struct/closure compares
  // below, which classify operands by their non-null rep and would ignore that the null can be there.

  // D1576 — `x == null` where `x` is the `null` type is statically true (`!=` false): both
  // operands are the value `null`, so there is no compare core to run. The niche dispatch
  // below reads each operand at a nullable rep and has no seed for a bare `null` beside a
  // `nulnone` value; `nulNoneEqSides` scopes it, evaluating the non-literal side for effect.
  if e.binOp == "==" || e.binOp == "!=" {
    if nulNoneEqSides(e.binLeft, e.binRight, fnIx) {
      if emitNulNoneForEffect(body, e.binLeft, fnIx, ec) < 0 { return -1 }
      if emitNulNoneForEffect(body, e.binRight, fnIx, ec) < 0 { return -1 }
      if e.binOp == "==" { fbI32Const(1) } else { fbI32Const(0) }
      return 0
    }
  }
  if e.binOp == "==" || e.binOp == "!=" {
    if binEqHasNoLowering(exprIx) {
      return emitFail(
        "emitProgram: `"
          + e.binOp
          + "` over this operand rep has no lowering",
      )
    }
    if binEqGRepUnresolved(exprIx, fnIx) {
      return emitFail(
        "emitProgram: the two operands of this list `"
          + e.binOp
          + "` do not resolve to one comparable list rep",
      )
    }
    const nulNiche = binEqNulNiche(exprIx, fnIx)
    if nulNiche != "" {
      if emitNulNicheEq(body, exprIx, fnIx, nulNiche, ec) < 0 { return -1 }
      if e.binOp == "!=" {
        fbI32Eqz() // 0x45 i32.eqz — the wrapper always leaves the `==` answer
      }
      return 0
    }
  }
  return emitBinRefOps(body, e, exprIx, fnIx, ec)
}

// `emitBinExprNode` over reference operands: the list `+` floor, the string, list, struct
// and function-value compares, and a `null` test of any nullable value.
function emitBinRefOps(
  body: u8[],
  e: BinExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // The `+` half of the same floor: a list concat whose element rep has no core. Above the
  // string/list dispatch below for the reason its `==` twin is — every classifier there reads
  // an operand by a rep it may not have — and above the numeric tail, which a list none of the
  // classifiers claim would otherwise reach.
  if binConcatRepUnresolved(exprIx, fnIx) {
    return emitFail(
      "emitProgram: the two operands of this list `+` do not resolve to one list rep",
    )
  }
  // G6 string operators (a string is a `(array i32)` of code points): `+` is a new
  // concatenated array; `==`/`!=` are element-wise value-equality, not ref identity — so they
  // take their own inline lowering before the i32 `binOpcode` path, which would emit `i32.eq`
  // (ref identity) for strings. Only string-typed operands route here.
  if exprIsStrConcat(exprIx, fnIx) {
    return emitStrConcat(body, exprIx, fnIx, ec)
  }
  if exprIsStrEq(exprIx, fnIx) { return emitStrEq(body, exprIx, fnIx, ec) }
  if exprIsStrOrder(exprIx, fnIx) {
    return emitStrOrder(body, exprIx, fnIx, ec)
  }
  // List `==`/`!=` (length + element value-compare, recursive through nested lists/string
  // elements) and list `+` (concat) — collections-design §VL.4/§VL.6, inlined rather than
  // helper calls. List `+` over a rep other than the i32 list is checked above the compare
  // dispatch, because `listOpKindOfBin` claims a string list it has no concat for.
  if e.binOp == "+" {
    const catK = catListKindOfBin(exprIx, fnIx)
    if catK > 0 {
      return emitListConcatG(
        body,
        e.binLeft,
        e.binRight,
        fnIx,
        catK,
        catSlotOfBin(exprIx, fnIx),
        catWidenSideOfBin(exprIx, fnIx),
        ec,
      )
    }
  }
  // Asked once and threaded into both arms below, which are one node's answer.
  const lopK = listOpKindOfBin(exprIx, fnIx)
  // the generic list compare — every list rep with no core of its own, above the
  // `listOpKindOfBin` branch because its own home already declines every shape that branch
  // claims, and below the `+` concat arm because the two operators never overlap.
  if e.binOp == "==" || e.binOp == "!=" {
    const gK = eqgListKindOfBin(exprIx, fnIx, lopK)
    if gK >= 0 {
      if emitExpr(body, e.binLeft, fnIx, ec) < 0 { return -1 }
      if emitEqRecoverNarrowed(e.binLeft, fnIx) < 0 { return -1 }
      svSyncRecv(e.binLeft, fnIx)
      if emitExpr(body, e.binRight, fnIx, ec) < 0 { return -1 }
      if emitEqRecoverNarrowed(e.binRight, fnIx) < 0 { return -1 }
      svSyncRecv(e.binRight, fnIx)
      if (
        emitListEqAnyRep(body, gK, listOpSlotOfBin(exprIx, fnIx), fnIx, ec)
        < 0
      ) {
        return -1
      }
      if e.binOp == "!=" {
        fbI32Eqz() // 0x45 i32.eqz (`!=` negates value-equality)
      }
      return 0
    }
  }
  if lopK != "none" {
    if e.binOp == "+" {
      if lopK != "i32list" {
        return emitFail(
          "emitProgram: list concat over this element kind is not supported",
        )
      }
      return emitListConcatI(body, e.binLeft, e.binRight, fnIx, ec)
    }
    if emitExpr(body, e.binLeft, fnIx, ec) < 0 { return -1 }
    if emitEqRecoverNarrowed(e.binLeft, fnIx) < 0 { return -1 }
    svSyncRecv(e.binLeft, fnIx)
    if emitExpr(body, e.binRight, fnIx, ec) < 0 { return -1 }
    if emitEqRecoverNarrowed(e.binRight, fnIx) < 0 { return -1 }
    svSyncRecv(e.binRight, fnIx)
    if emitEqNonNullCore(body, exprIx, fnIx, ec) < 0 { return -1 }
    if e.binOp == "!=" {
      fbI32Eqz() // 0x45 i32.eqz (`!=` negates value-equality)
    }
    return 0
  }
  // `x == null` / `x != null` over any NULLABLE value — the rep's own null test, never the
  // i32 compare. Checked before the structural string / struct / closure equality below,
  // each of which would compare a value against the `null` literal.
  if e.binOp == "==" || e.binOp == "!=" {
    const nlhs = nodeAt(e.binLeft)
    const nrhs = nodeAt(e.binRight)
    let nref = -1
    if nrhs is NullLit { nref = e.binLeft }
    if nlhs is NullLit { nref = e.binRight }
    if nref >= 0 {
      // The ladder is shared with the `is null` guard — the two spellings ask the same
      // question of the same rep, and `emitNulIsNullTest`'s header carries why they must
      // not be answered in only one place. `!=` is the INVERTED direction, which the ladder
      // emits directly (`i32.ne`) rather than leaving a caller to negate an `i32.eq`.
      const bnt = emitNulIsNullTest(
        body,
        nref,
        fnIx,
        e.binOp == "!=",
        false,
        ec,
      )
      if bnt < 0 { return -1 }
      if bnt > 0 { return 0 }
    }
    // Structural struct equality compares field-wise (`emitStructEq`), asked via
    // `structIndexOfExpr` and the variant twin `exprVariantIndex` — kind-gated storage-class
    // legs over the same nine, tried variant-first because two of `structIndexOfExpr`'s legs
    // are not kind-gated. Both declining falls to the i32 tail, an unreserved-field-slot risk (D57).
    const eqVi = binEqVariantRow(exprIx, fnIx)
    if eqVi >= 0 {
      return emitStructEq(body, exprIx, fnIx, eqRowOfVariant(eqVi), ec)
    }
    const eqSi = binEqStructRow(exprIx, fnIx)
    if eqSi >= 0 { return emitStructEq(body, exprIx, fnIx, eqSi, ec) }
    // The refusal spans both tables — either side naming a layout without the two agreeing is
    // a compare this emitter refuses rather than guesses at, matching D57 (an operand reaching
    // the i32 tail as a `(ref $uVarHeap[vi])`). Two arms of one union sharing a layout resolve
    // to different variant rows and fall to this same refusal, exactly as two disagreeing structs would.
    if (
      structIndexOfExpr(e.binLeft, fnIx) >= 0
      || structIndexOfExpr(e.binRight, fnIx) >= 0
      || exprVariantIndex(e.binLeft, fnIx) >= 0
      || exprVariantIndex(e.binRight, fnIx) >= 0
    ) {
      return emitFail("emitProgram: struct equality is not supported yet")
    }
    // Function-value `==`/`!=`: IDENTITY — the same lifted function (the id
    // field) AND the same captured env (`ref.eq`). Mirrors the host (same
    // table index AND same env; null == null envs are equal).
    if exprIsClosure(e.binLeft, fnIx) || exprIsClosure(e.binRight, fnIx) {
      if emitExpr(body, e.binLeft, fnIx, ec) < 0 { return -1 }
      if emitEqRecoverNarrowed(e.binLeft, fnIx) < 0 { return -1 }
      if emitExpr(body, e.binRight, fnIx, ec) < 0 { return -1 }
      if emitEqRecoverNarrowed(e.binRight, fnIx) < 0 { return -1 }
      if emitEqNonNullCore(body, exprIx, fnIx, ec) < 0 { return -1 }
      if e.binOp == "!=" {
        fbI32Eqz() // 0x45 i32.eqz — negate identity-equality
      }
      return 0
    }
  }
  return emitBinNumeric(body, e, exprIx, fnIx, ec)
}

// An operand of a numeric operator at the operator's width `w`: a literal is built there, so a
// literal node read at two widths (a const's initializer under a desugared match arm) is right at
// each; anything else widens to `w`.
function emitBinOperandAs(
  body: u8[],
  ix: i32,
  w: string,
  fnIx: i32,
  ec: ExpCtx,
) {
  const lit = emitNumLitAs(ix, w)
  if lit != -2 { return lit }
  if w == "f32" { return emitExprAsF32(body, ix, fnIx, ec) }
  if w == "f64" { return emitExprAsF64(body, ix, fnIx, ec) }
  emitExprAsI64(body, ix, fnIx, ec)
}

// The scalar type an operand of a numeric operator has to the checker: its recorded type, a
// literal or literal union peeled to its base.
function binOperandScalarTy(ix: i32, fnIx: i32): i32 {
  const t = nodeTyAt(ix, fnIx)
  const p = tyScalarBasePrim(t)
  const scalars: i32[] = [TY_I32, TY_I64, TY_F32, TY_F64]
  let k = 0
  while k < scalars.length {
    if p != null && tyPrimNameOf(scalars[k]) == p { return scalars[k] }
    k = k + 1
  }
  t
}

// The width a scalar numeric operator works at: the checker's pair rule over its operands
// (`numPairOpTy`), or `i32` when an operand has no scalar type.
function binNumWidth(e: BinExpr, fnIx: i32): string {
  const t = numPairOpTy(
    e,
    binOperandScalarTy(e.binLeft, fnIx),
    binOperandScalarTy(e.binRight, fnIx),
  )
  if t < 0 { return "i32" }
  tyScalarBasePrim(t) ?? "i32"
}

// `emitBinExprNode`'s numeric tail: a numeric union per member, else the operator at the
// checker's width (`binNumWidth`), each operand built or widened there.
function emitBinNumeric(
  body: u8[],
  e: BinExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // Every other operator over a numeric union dispatches per member.
  if numUnionMinted && njDispatches(e, fnIx) {
    return emitNumUnionBin(body, e, exprIx, fnIx, ec)
  }
  const w = binNumWidth(e, fnIx)
  if w == "f32" {
    // float remainder at f32 rides the f64 helper (D1586): an f32 operand is exact in f64,
    // the remainder of two f32-representable values is itself f32-representable, and every
    // step of the helper is exact — so promote / call / demote loses nothing. A second
    // helper would be the same algorithm at a narrower width for no gain.
    if e.binOp == "%" {
      if emitF64RemCall(body, e.binLeft, e.binRight, fnIx, true, ec) < 0 {
        return -1
      }
      return 0
    }
    const opcF32 = binOpcodeF32(e.binOp)
    // No f32 form ⇒ fail, never fall through. Ops with no float form (`%`, bitwise, shift) are
    // integer-only in the checker, so this is unreachable from accepted source — it exists
    // because falling through reaches the i32 tail below, emitting an i32 opcode over a float
    // operand: invalid wasm the engine alone catches (`%` did exactly this before this backstop).
    if opcF32 < 0 {
      return emitFail("emitProgram: operator '" + e.binOp + "' has no f32 form")
    }
    if emitBinOperandAs(body, e.binLeft, "f32", fnIx, ec) < 0 { return -1 }
    if emitBinOperandAs(body, e.binRight, "f32", fnIx, ec) < 0 { return -1 }
    fbI32Bin(opcF32)
    return 0
  }
  if w == "f64" {
    // float remainder — the one f64 operator with no instruction, so it calls the shared
    // `__f64_rem__` helper instead of taking an opcode from the table below (D1586).
    if e.binOp == "%" {
      if emitF64RemCall(body, e.binLeft, e.binRight, fnIx, false, ec) < 0 {
        return -1
      }
      return 0
    }
    const opcF = binOpcodeF64(e.binOp)
    // NO f64 form ⇒ fail, never fall through — the f32 slice's reasoning, one width up.
    if opcF < 0 {
      return emitFail("emitProgram: operator '" + e.binOp + "' has no f64 form")
    }
    if emitBinOperandAs(body, e.binLeft, "f64", fnIx, ec) < 0 { return -1 }
    if emitBinOperandAs(body, e.binRight, "f64", fnIx, ec) < 0 { return -1 }
    fbI32Bin(opcF)
    return 0
  }
  if w == "i64" {
    const sr64 = emitShiftMaskFold(body, e, exprIx, 64, fnIx, ec)
    if sr64 <= 0 { return sr64 }
    const opc64 = binOpcodeI64(e.binOp)
    if opc64 >= 0 {
      if emitBinOperandAs(body, e.binLeft, "i64", fnIx, ec) < 0 { return -1 }
      if emitBinOperandAs(body, e.binRight, "i64", fnIx, ec) < 0 { return -1 }
      fbI32Bin(opc64)
      return 0
    }
  }
  const sr32 = emitShiftMaskFold(body, e, exprIx, 32, fnIx, ec)
  if sr32 <= 0 { return sr32 }
  const opcode = binOpcode(e.binOp)
  if opcode < 0 { return emitFail("emitProgram: unsupported binary operator") }
  // Operands first (left then right), then the operator — wasm's stack order.
  if emitExpr(body, e.binLeft, fnIx, ec) < 0 { return -1 }
  if emitExpr(body, e.binRight, fnIx, ec) < 0 { return -1 }
  fbI32Bin(opcode)
  return 0
}

// The direct call to function index `target`: arguments in parameter order, each emitted
// under its parameter's context with the full coercion suite, then `call`. The caller's
// context is restored before the `call`, and on every failure exit.
function emitDirectCall(
  body: u8[],
  callIx: i32,
  fnIx: i32,
  target: i32,
  ec: ExpCtx,
) {
  // A binding's one callee, called in an instance that binds an argument to another type,
  // asks for a copy of the body and the binding per instance (D6320).
  const dc = nodeAt(callIx)
  if dc is Call {
    const bd = callFnBindingOf(dc.callFn)
    if (
      bd >= 0
      && !hasNamedArgs(dc.callArgNames)
      && directCallInstanceArgMisfit(dc.callArgs, target, fnIx) >= 0
    ) {
      fsAsk(bd)
      let bn = ""
      const bdn = nodeAt(bd)
      if bdn is LetDecl { bn = bdn.letName }
      // An instance body's nodes carry the instantiating call's position, so the binding anchors.
      return emitFailAt(
        "emitProgram: the function binding `"
          + bn
          + "` is called in a body instanced at two types, and one binding names one function",
        bd,
      )
    }
  }
  const saved = expCtxHere(ec)
  if (
    expCtxLeave(
      saved,
      emitDirectCallArgsUnder(body, callIx, fnIx, target, ec),
      ec,
    )
    < 0
  ) {
    return -1
  }
  emitDirectCallTail(target, fnIx, ec)
}

// Does a direct call with `nArgs` operands pass more than callee `target` declares? False when
// the callee has a rest parameter, which takes any number.
function directArgsOverflow(nArgs: i32, target: i32): boolean {
  const cFn = nodeAt(fnStmts[target])
  if cFn is FuncDecl {
    let i = 0
    while i < cFn.fnParams.length {
      const p = nodeAt(cFn.fnParams[i])
      if p is Param {
        if p.parRest == 1 { return false }
      }
      i = i + 1
    }
    return nArgs > cFn.fnParams.length
  }
  false
}

// `emitDirectCall`'s operands: each argument applies its parameter's context and leaves it
// for the caller's exit to undo.
function emitDirectCallArgsUnder(
  body: u8[],
  callIx: i32,
  fnIx: i32,
  target: i32,
  ec: ExpCtx,
) {
  // The callee's FuncDecl lives at `fnStmts[target]` (the function index is the fnStmts
  // position). Its parameter list lets a struct-literal argument construct as the callee's
  // declared param struct type rather than a field-name guess, fixing a struct argument
  // passed into a forward-referenced/mutually-recursive callee whose param struct shares field names with another struct.
  const cFn = nodeAt(fnStmts[target])
  // Arguments in parameter order (host parity: `orderArgumentsByParameters` plus operands
  // built per-parameter). A call with no named args keeps its source list untouched; a named
  // call (`f(b: 1, a: 2)`) reorders here so each emitted operand lands on, and is typed by,
  // its declared parameter — including evaluation order, which follows parameter order too.
  const args = orderedDirectArgs(callIx, target)
  if directArgsBad(args, callIx) {
    return emitFail("emitProgram: named argument does not match a parameter")
  }
  // A call with more operands than the callee takes would leave the extras under the result.
  if directArgsOverflow(args.length, target) {
    return emitFail(
      "emitProgram: a call passes more arguments than the function it calls takes",
    )
  }
  // A callee carrying the env param (`fnHasEnvParam`) takes a null one from a direct call,
  // pushed before the args to match its env-leading signature.
  if fnHasEnvParam(target) { fbRefNullStruct() }
  // A lambda-lifted callee takes its captures next, read in this frame (SP-037).
  if cloLifted(target) {
    const lcaps = captureNamesOf(target)
    let lci = 0
    while lci < lcaps.length {
      if emitCaptureRead(body, lcaps[lci], fnIx, ec) < 0 { return -1 }
      lci = lci + 1
    }
  }
  // Every argument starts from the caller's context with the litunion, map and null-heap
  // seeds cleared: each is its parameter's, never the enclosing position's, or a bare `Map()` builds an outer shape
  // (D1223), or a `null` read takes a map value's heap. The parameter's seeds follow below.
  const argBase = expCtxHere(ec)
  argBase.litUnion = 0
  argBase.nulLitUnion = false
  let i = 0
  while i < args.length {
    expCtxApply(argBase, ec)
    const sd = directArgSeedsOf(target, i)
    // An f64 / f32 param position lowers the argument coerced to that float type
    // (a float literal re-encodes; an i32/i64/f32 source converts via the lattice
    // helper). (Slice 3 f64; Slice 5 f32.)
    let cParamF64 = false
    let cParamF32 = false
    // An i64 param position widens a narrower (i32) argument at the call
    // boundary via `i64.extend_i32_s` — `emitExprAsI64` (a literal lowers as
    // `i64.const`; an i32 VARIABLE sign-extends). The value-preserving edge
    // the checker permits, mirroring the let / return widenings.
    let cParamI64 = false
    if cFn is FuncDecl {
      const cParams2 = cFn.fnParams
      if i < cParams2.length {
        if vtKindOfParam(cParams2[i]) == "f64" { cParamF64 = true }
        if vtKindOfParam(cParams2[i]) == "f32" { cParamF32 = true }
        if vtKindOfParam(cParams2[i]) == "i64" { cParamI64 = true }
      }
    }
    if cParamF32 {
      if emitExprAsF32(body, args[i], fnIx, ec) < 0 { return -1 }
      i = i + 1
    } else if cParamF64 {
      if emitExprAsF64(body, args[i], fnIx, ec) < 0 { return -1 }
      i = i + 1
    } else if cParamI64 {
      if emitExprAsI64(body, args[i], fnIx, ec) < 0 { return -1 }
      i = i + 1
    } else {
      if emitDirectArgValue(body, args[i], fnIx, sd, ec) < 0 { return -1 }
      const ub = emitDirectArgUnbox(args[i], fnIx, sd)
      if ub != 0 { return ub }
      i = i + 1
    }
  }
  0
}

// `emitDirectCallArgsUnder`'s value for argument `arg` at a parameter that is not a scalar
// f64/f32/i64, emitted under the seeds `sd` its parameter gives: an atom widening, a box, or
// the expression under its niche and list seeds, then widened and recovered. Returns 0, or -1.
function emitDirectArgValue(
  body: u8[],
  arg: i32,
  fnIx: i32,
  sd: DirectArgSeeds,
  ec: ExpCtx,
): i32 {
  const cRecoverKind = sd.cRecoverKind
  const cUNm = sd.cUNm
  const cParamNulBool = sd.cParamNulBool
  const cParamNulString = sd.cParamNulString
  const cParamLitUnion = sd.cParamLitUnion
  const cParamNulLitUnion = sd.cParamNulLitUnion
  const cParamStr = sd.cParamStr
  const cParamRlSlot = sd.cParamRlSlot
  const cParamSLKind = sd.cParamSLKind
  if (cParamStr || cParamNulString) && exprIsLitAtom(arg, fnIx) {
    // A literal-union atom flowing into a `string` param widens to its member string — and
    // into a `string | null` param for the same reason, the slot being that same reference
    // with a null permitted and a widened member string non-null. A `null` argument is not a
    // lit atom and still takes the `nulString`-seeded context below.
    if emitAtomToStr(body, arg, fnIx, ec) < 0 { return -1 }
  } else if cUNm != "" {
    // `cUNm` is set only for a kind-4 union-BOX param (see above), so a concrete
    // variant ARGUMENT (`area(s)` where `s: S`, param `C | S`) is boxed here.
    if emitUnionBoxArg(body, cUNm, sd.cUTy, arg, fnIx, ec) < 0 { return -1 }
  } else {
    const argCtx = expCtxHere(ec)
    // The parameter's nullability is assigned, never or'd with the enclosing position's.
    // `expCtxHere(ec)` copies the caller's seeds, which at a `return f(x)` are
    // the return boundary's; setting them only to true let a nullable result expectation
    // reach a non-nullable argument, keeping a narrowed value's `(ref null $s)` rep under a `(ref $s)` param.
    argCtx.nulBool = cParamNulBool
    argCtx.nulString = cParamNulString
    // A raw-read seed is the enclosing null test's or `??` arm's, never the argument's: left
    // set, a narrowed `string | null` reached a `string` parameter unrecovered (D3816).
    argCtx.rawNullRead = false
    if cParamLitUnion { argCtx.litUnion = 1 }
    if cParamNulLitUnion {
      argCtx.litUnion = 1
      argCtx.nulLitUnion = true
    }
    const argBoxToNulStr = cParamNulString && boxIsNulStrUnion(arg, fnIx)
    if emitExprExpect(body, arg, fnIx, argCtx) < 0 { return -1 }
    if argBoxToNulStr { emitBoxToNulStr() }
    // read-only covariance at the ARGUMENT boundary (D791) — `d773_readonly_param`:
    // `look(xs: Shape[])` called with a `Circle[]`.
    if cParamRlSlot >= 0 {
      emitRefListWidenSite(
        body,
        arg,
        exprEmittedRefListSlot(arg, fnIx),
        cParamRlSlot,
      )
    }
    // the scalar dual (D965) — `take_f(xs: f64[])` called with an `i32[]`. Same
    // boundary, same licence, a numeric convert instead of a box.
    if cParamSLKind != null {
      emitScalarListWidenSite(body, arg, fnIx, cParamSLKind)
    }
    emitNonNullParamRecover(cRecoverKind, arg, fnIx)
  }
  0
}

// `emitDirectCallArgsUnder`'s unbox of a narrowed argument `arg` to the heap its parameter
// declares, once its value is on the stack: a niche variant, a bare variant, or the
// parameter's own (kind, slot) — guarded so at most one fires. Returns 0, or a refusal.
function emitDirectArgUnbox(arg: i32, fnIx: i32, sd: DirectArgSeeds): i32 {
  const cVi = sd.cVi
  const cParamNulVariantIdx = sd.cParamNulVariantIdx
  const cArgParamKind = sd.cArgParamKind
  const cArgParamRow = sd.cArgParamRow
  // The niche parameter's unbox (D1031) — `g(r)` into `g(x: Circle | null)` under `if r
  // is Circle`. The bare variant parameter's unbox is the arm below; its `| null` twin
  // declares the same heap with a nullable slot and never grew one, so the box went in
  // whole: `vl check` rc 0, invalid wasm. Guarded on `cVi` being absent so the two arms cannot both fire.
  if cVi < 0 && cParamNulVariantIdx >= 0 {
    if narrowedArmNeedsUnbox(arg, fnIx) {
      emitNarrowedArmUnboxTo(
        armDestHeapOf("nulvariant", cParamNulVariantIdx),
        arg,
        fnIx,
      )
    }
  }
  if cVi >= 0 {
    if exprUnion(arg, fnIx) {
      if variantHasCrossTagFits(cVi, arg, fnIx) {
        return emitFailCrossTagDelivery(arg, cVi)
      }
      fbStructGet(uBoxIdx, 1)  // 0xfb 0x02 <box ht> field 1: value (anyref)
      fbRefCast(uVarHeap[cVi]) // 0xfb 0x16 <variant struct> ref.cast (non-null)
    }
  }
  // The same unbox for a param whose annotation names a plain struct: an inferred
  // union's arm is no registered member, so `cVi` is -1 and the box went in whole. The
  // parameter's own (kind, slot) is the destination, as the cell's is at the binding
  // boundary; guarded so the three arms cannot both fire (D1723).
  if cVi < 0 && cParamNulVariantIdx < 0 {
    if narrowedArmNeedsUnbox(arg, fnIx) {
      emitNarrowedArmUnboxTo(
        armDestHeapOf(cArgParamKind, cArgParamRow),
        arg,
        fnIx,
      )
    }
  }
  0
}

// What argument `i` of a direct call to `target` takes from its parameter: the null rep a
// niche parameter seeds, the variant, union and list rows, and the rep a narrowed argument
// recovers to. A field keeps its default when the callee has no parameter `i`.
type DirectArgSeeds = {
  cVi: i32,
  cArgParamKind: VKind,
  cArgParamRow: i32,
  cRecoverKind: VKind | null,
  cUNm: string,
  cUTy: i32,
  cParamNulBool: boolean,
  cParamNulString: boolean,
  cParamNulVariantIdx: i32,
  cParamLitUnion: boolean,
  cParamNulLitUnion: boolean,
  cParamStr: boolean,
  cParamRlSlot: i32,
  cParamSLKind: VKind | null,
}

// The seeds of argument `i` of a direct call to `target`, read off its parameter.
function directArgSeedsOf(target: i32, i: i32): DirectArgSeeds {
  const cFn = nodeAt(fnStmts[target])
  // A variant-typed param position (kind 8): the callee wants the concrete variant struct
  // ref, but a union-valued argument (a narrowed local/param, a union-returning call) is the
  // box `{tag, value}`. Unbox to the param's variant struct — `struct.get $box 1 ; ref.cast
  // (ref $var)` — a statically safe cast since control reached this call only when narrowed to it.
  let cVi = -1
  // The parameter's own rep and table slot, carried to the narrowed-arm unbox below: the
  // inner block that reads `cParams` closes before it.
  let cArgParamKind: VKind = "i32"
  let cArgParamRow = -1
  // The parameter's rep, for the narrowed-argument recover `emitNonNullParamRecover` makes.
  let cRecoverKind: VKind | null = null
  // A UNION-typed param position (kind 4): the callee wants the box, so a raw
  // scalar/string/null argument is COERCED into the union representation
  // (`emitUnionCoerce` — the host's call-boundary `coerceUnion`). The param's
  // union NAME carries the atom set for the tag choice.
  let cUNm = ""
  let cUTy = -1
  // The `boolean | null` and `string | null` param positions, whose `null` is not a ref
  // null: each seeds the null rep its kind names and leaves a non-null argument untouched.
  let cParamNulBool = false
  let cParamNulString = false
  // A `Circle | null` param position's variant row, the narrowed-arm unbox's destination
  // (D1031); -1 for none.
  let cParamNulVariantIdx = -1
  // A literal-union param position: a member-literal argument lowers as its interned i32 id.
  let cParamLitUnion = false
  let cParamNulLitUnion = false
  // A `string` param position (kind 3): a literal-union atom ARGUMENT widens to its member
  // string at the boundary (the atom-as-string-subtype edge).
  let cParamStr = false
  // A ref-array param position's interned element ROW, for the read-only-covariance
  // widening (D791) — the same `tyAnnRefListSlot` the build seed below reads, kept
  // because the seed is cleared before the argument's widening can be asked.
  let cParamRlSlot = -1
  // The SCALAR-list dual of `cParamRlSlot` (D965) — the param's own list kind, so an
  // argument whose element STORAGE differs (`i32[]` into an `f64[]` param) can take the
  // converting copy at this boundary. `""` for every non-scalar-list param, which is
  // what makes the delivery below cost nothing in the ordinary case.
  let cParamSLKind: VKind | null = null
  if cFn is FuncDecl {
    const cParams = cFn.fnParams
    if i < cParams.length {
      const cpK = vtKindOfParam(cParams[i])
      const cpRow = paramStructIdxOf(cParams[i])
      cArgParamKind = cpK
      cArgParamRow = cpRow
      if cpK == "str" { cParamStr = true }
      cRecoverKind = cpK
      if cpK == "variant" { cVi = cpRow }
      if cpK == "union" {
        const cp4 = nodeAt(cParams[i])
        if cp4 is Param {
          cUNm = tyNameOf(cp4.parType)
          cUTy = nodeTyIxOf(cp4.parType)
        }
      }
      // A ref-array param position (`take(xs: B[])`): its ref-list row and kind.
      const cp = nodeAt(cParams[i])
      if cp is Param {
        if cpK == "reflist" { cParamRlSlot = tyAnnRefListSlot(cp.parType) }
        cParamSLKind = cpK
      }
      const cpnb = nodeAt(cParams[i])
      if cpnb is Param {
        if tyIsNulBool(cpnb.parType) { cParamNulBool = true }
        if retNulStringFlag(cpnb.parType) == 1 { cParamNulString = true }
        if retNulVariantFlag(cpnb.parType) == 1 {
          const cpNvi = nulVariantIndexOf(cpnb.parType)
          if cpNvi >= 0 && cpNvi < uVarHeap.length {
            cParamNulVariantIdx = cpNvi
          }
        }
        // the caller'S HALF of the same question the callee's body asks through
        // `exprIsLitAtom`. Both must use the alias-INDEX test or a narrowed-alias param is
        // declared `i32` while the member-literal argument is lowered as a string ref.
        if tyIsLitUnion(nodeTyIxOf(cpnb.parType)) { cParamLitUnion = true }
        // A `K | null` NICHE param: a member-literal arg (`f("a")`) lowers as its atom id
        // (`ec.litUnion`), a `null` arg as the i32 sentinel `-1` (`ec.nulLitUnion`).
        if nodeTyIsNulLitUnion(cpnb.parType) { cParamNulLitUnion = true }
      }
    }
  }
  const seeds: DirectArgSeeds = {
    cVi: cVi,
    cArgParamKind: cArgParamKind,
    cArgParamRow: cArgParamRow,
    cRecoverKind: cRecoverKind,
    cUNm: cUNm,
    cUTy: cUTy,
    cParamNulBool: cParamNulBool,
    cParamNulString: cParamNulString,
    cParamNulVariantIdx: cParamNulVariantIdx,
    cParamLitUnion: cParamLitUnion,
    cParamNulLitUnion: cParamNulLitUnion,
    cParamStr: cParamStr,
    cParamRlSlot: cParamRlSlot,
    cParamSLKind: cParamSLKind,
  }
  seeds
}

// The `call` and what follows it, under the caller's restored context: the tail-call
// cursor, a lifted callee's capture write-back, and the `nulnone` result's niche re-rep.
function emitDirectCallTail(target: i32, fnIx: i32, ctx: ExpCtx) {
  fbCall(gImports + target) // 0x10 call (imports occupy indices 0..gImports-1)
  // Arm the tail-call cursor: if this call is still the last thing written when the
  // enclosing `return` terminates, it is in tail position and `emitUnionRetSink`
  // rewrites the pair into `return_call`.
  tailCallIdx = gImports + target
  tailCallTable = -1
  tailCallEnd = wLen()
  // A lifted callee hands back the captures it assigned after its result: each goes back
  // where this frame keeps it, the last result first (D3664).
  const nWb = cloLiftWriteCount(target)
  if nWb > 0 {
    const wbCaps = captureNamesOf(target)
    let wbi = nWb - 1
    while wbi >= 0 {
      const wbIdx = localIndexOf(fnIx, wbCaps[cloLiftWriteCapAt(target, wbi)])
      if wbIdx < 0 {
        return emitFail(
          "emitProgram: a lifted call's assigned capture has no home here",
        )
      }
      fbLocalSet(wbIdx)
      wbi = wbi - 1
    }
    liftWbEnd = wLen()
  }
  // D1567 — a `nulnone` result at an i32-repped nullable destination. `nullref` subtypes
  // every nullable ref valtype, so struct/variant/string/list/map/closure destinations take
  // the result unchanged; the two niche nullables do not (`boolean | null` is sentinel 2, `K |
  // null` is sentinel -1), and storing a ref into either is invalid wasm the checker cannot see. Re-derive the rep at the site from the same two seeds `emitNullLitNode` reads.
  if fnPosRetIsNulNone(target) {
    if ctx.nulBool || ctx.nulLitUnion {
      fbDrop()
      if ctx.nulBool { fbI32Const(2) } else { fbI32Const(0 - 1) }
      tailCallIdx = -1
    }
  }

  return 0
}

// The captured-call lowering for an `Ident` callee resolved to a CAPTURING lifted
// function at index `target`: build its closure value live (reading captures) and
// `call_ref` it (a plain `call` would pass a null env and lose the captures).
function emitCapturedCall(
  body: u8[],
  callIx: i32,
  fnIx: i32,
  target: i32,
  ec: ExpCtx,
) {
  if cloLifted(target) { return emitDirectCall(body, callIx, fnIx, target, ec) }
  // Stash the freshly-built closure, then call_ref it (same shape as emitCallRef
  // but the callee is a value we synthesize here, not an existing binding). `Core`, not
  // `emitClosureValue`: the generic-value floor guards a closure that escapes its pin, and
  // this one is consumed by the call that pinned it, so an un-annotated parameter is fine.
  if emitClosureValueCore(body, target, fnIx, ec) < 0 { return -1 }
  const crDepth = callRefDepth
  const crSlot = callRefNestSlot(callRefDepth)
  fbLocalSet(crSlot)
  fbLocalGet(crSlot)
  fbStructGet(cloStructIdx, 0) // env
  callRefDepth = crDepth + 1
  // Parameter-order args (named-call reorder; see the direct path below).
  const cargs = orderedDirectArgs(callIx, target)
  if directArgsBad(cargs, callIx) {
    return emitFail("emitProgram: named argument does not match a parameter")
  }
  // Per-parameter argument coercion for the fourth `call_ref` reach (a nested capturing
  // function called by name): the spine pushed every argument raw against the callee's own
  // declared functype. Three kinds are check-clean invalid wasm without this — a union box, an
  // i64/f64/f32 mismatch, and a litunion — each coerced the way the direct twin coerces, safe by construction since each arm fires only where the raw push is already wrong.
  if target < 0 { return -1 }
  const cfn = nodeAt(fnStmts[target])
  let cps: i32[] = []
  if cfn is FuncDecl { cps = cfn.fnParams }
  const capSaved = expCtxHere(ec)
  const capIn = expCtxHere(ec)
  capIn.litUnion = 0
  capIn.nulLitUnion = false
  expCtxApply(capIn, ec)
  let cai = 0
  while cai < cargs.length {
    let cuNm = ""
    let cpKind: VKind = "i32"
    let cpLit = false
    let cuTy = -1
    if cai < cps.length {
      cpKind = vtKindOfParam(cps[cai])
      const cpn = nodeAt(cps[cai])
      if cpn is Param {
        if cpKind == "union" {
          cuNm = tyNameOf(cpn.parType)
          cuTy = nodeTyIxOf(cpn.parType)
        }
        // Alias-INDEX, so a NARROWED copy is recognized — the captured-call twin of the
        // direct call's `cParamLitUnion`.
        if tyIsLitUnion(nodeTyIxOf(cpn.parType)) { cpLit = true }
        if nodeTyIsNulLitUnion(cpn.parType) { cpLit = true }
      }
    }
    const capArg = expCtxHere(ec)
    capArg.nulString = cpKind == "nulstr"
    capArg.rawNullRead = false
    expCtxApply(capArg, ec)
    if cuNm != "" {
      if emitUnionBoxArg(body, cuNm, cuTy, cargs[cai], fnIx, ec) < 0 {
        return -1
      }
    } else if cpKind == "i64" {
      if emitExprAsI64(body, cargs[cai], fnIx, ec) < 0 { return -1 }
    } else if cpKind == "f64" {
      if emitExprAsF64(body, cargs[cai], fnIx, ec) < 0 { return -1 }
    } else if cpKind == "f32" {
      if emitExprAsF32(body, cargs[cai], fnIx, ec) < 0 { return -1 }
    } else if cpLit {
      const cluCtx = expCtxHere(ec)
      cluCtx.litUnion = 1
      if emitExprExpect(body, cargs[cai], fnIx, cluCtx) < 0 { return -1 }
    } else if cpKind == "str" && exprIsLitAtom(cargs[cai], fnIx) {
      // The MIRROR of `cpLit`: a literal-union ATOM argument into a `string` parameter
      // widens to its member string, the edge the direct twin takes as `cParamStr`.
      if emitAtomToStr(body, cargs[cai], fnIx, ec) < 0 { return -1 }
    } else {
      if emitExpr(body, cargs[cai], fnIx, ec) < 0 { return -1 }
      // A value narrowed out of a box into an arm or nullable-arm parameter is unboxed, as
      // the direct call's argument rung unboxes it.
      if cai < cps.length && narrowedArmNeedsUnbox(cargs[cai], fnIx) {
        emitNarrowedArmUnboxTo(
          armDestHeapOf(cpKind, paramStructIdxOf(cps[cai])),
          cargs[cai],
          fnIx,
        )
      }
    }
    cai = cai + 1
  }
  const capOut = expCtxHere(ec)
  capOut.litUnion = capSaved.litUnion
  capOut.nulLitUnion = capSaved.nulLitUnion
  capOut.nulString = capSaved.nulString
  capOut.rawNullRead = capSaved.rawNullRead
  expCtxApply(capOut, ec)
  callRefDepth = crDepth
  // The target's own interned `$fnsig` — the functype it is actually declared with — so the
  // `call_indirect` below passes the engine's signature check and returns the target's real
  // result type. Must be resolved from the target, never from arity alone: `fnSigIdxForArity`
  // only keys `(structref, i32 * ar) -> i32`, which misclassifies any non-i32 param or result. `fnSigIdxOfFn` is the same seam `.map`/`.filter` resolve a named-function callback through.
  const csig = fnSigIdxOfFn(target)
  if csig < 0 {
    return emitFail(
      "emitProgram: captured call target has no interned signature",
    )
  }
  fbLocalGet(crSlot)
  fbStructGet(cloStructIdx, 1)      // the callee's wasm function index
  fbCallIndirect(csig, gFnTableIdx) // 0x11 <fnsig> <table>
  armTailCallIndirect(csig, sigKeyRetVoid(cloSigKeyExt(target)))
  return 0
}

// Arm the tail-call cursor on the function-value call just written, so a `return` that
// follows it directly becomes `return_call_indirect` (D4657); `isVoid` says the signature has
// no result, which a void caller's exit also needs (D4680).
function armTailCallIndirect(sig: i32, isVoid: boolean) {
  tailCallIdx = sig
  tailCallTable = gFnTableIdx
  tailCallVoid = isVoid
  tailCallEnd = wLen()
  0
}

// Whether the `$fnsig` key `key` has the void result suffix `>v`.
function sigKeyRetVoid(key: string): boolean {
  const n = key.length
  n >= 2 && key[n - 2] == '>' && key[n - 1] == 'v'
}

// The `__array_new__(n, fill)` / `__array_new_default__(n)` intrinsic lowering.
function emitArrayNewIntr(body: u8[], callIx: i32, fnIx: i32, ec: ExpCtx) {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Ident {
      const anIsNew = callee.identName == "__array_new__"
      let anWant = 1
      if anIsNew { anWant = 2 }
      if c.callArgs.length != anWant {
        return emitFail(
          "emitProgram: internal: "
            + callee.identName
            + " reached with the wrong argument count — the checker's arity rule refuses it",
        )
      }
      let anBack = aTypeIdx
      let anWrap = lTypeIdx
      const ank = arrNewIntrKind(callIx, fnIx)
      match ank {
        "f64list" => {
          if !fa64Used {
            return emitFail(
              "emitProgram: __array_new__ f64 fill but f64 list types not collected",
            )
          }
          anBack = fa64TypeIdx
          anWrap = fl64TypeIdx
        }
        "i64list" => {
          // D963 — I64 fill → the i64 list pair.
          if !ia64Used {
            return emitFail(
              "emitProgram: __array_new__ i64 fill but i64 list types not collected",
            )
          }
          anBack = ia64TypeIdx
          anWrap = il64TypeIdx
        }
        "u8list" => {
          // D1470 — the PACKED byte list. Reachable only from `__array_new_default__`
          // (`arrNewDefaultKind`): `array.new_default` zeroes an `i8` slot exactly as it
          // zeroes an `i32` one, so the destination's own pair is all this needs.
          if !ba8Used {
            return emitFail(
              "emitProgram: __array_new_default__ u8 element but u8 list types not collected",
            )
          }
          anBack = ba8TypeIdx
          anWrap = bl8TypeIdx
        }
        "f32list" => {
          // D1470 — the f32 list, from `__array_new_default__`'s destination or, since D1673,
          // from an f32 FILL. A float literal fill is not one: it types f64, and the checker
          // refuses it against an `f32[]` destination before the emitter sees it.
          if !fa32Used {
            return emitFail(
              "emitProgram: __array_new_default__ f32 element but f32 list types not collected",
            )
          }
          anBack = fa32TypeIdx
          anWrap = fl32TypeIdx
        }
        "strlist" => {
          // STRING fill → the string list (`array.new` of the shared string-ref
          // backing; a non-null string ref stores into the nullable slot directly).
          if !slUsed {
            return emitFail(
              "emitProgram: __array_new__ string fill but string list types not collected",
            )
          }
          anBack = mkArrIdx
          anWrap = mkListIdx
        }
        "reflist" => {
          // STRUCT fill → the ref list of the element struct (its interned slot).
          if !rlUsed {
            return emitFail(
              "emitProgram: __array_new__ struct fill but ref list types not collected",
            )
          }
          // The STRICT slot: this arm picks the list's backing and wrapper heap types, so an
          // unresolved element must refuse, not clamp. Slot 0 is a real row, and clamping to
          // it built the module at whichever element interned first (D1605).
          const anSlot = refListSlotOfExprStrict(callIx, fnIx)
          const anBad = anSlot >= rlWrapIdx.length || anSlot >= rlBackIdx.length
          if anSlot < 0 || anBad {
            return emitFail(
              "emitProgram: __array_new__ fill type not yet supported natively",
            )
          }
          anBack = rlBackIdx[anSlot]
          anWrap = rlWrapIdx[anSlot]
        }
        "list" | "none" => {
          if !aUsed || !lUsed {
            return emitFail(
              "emitProgram: array intrinsic but list types not collected",
            )
          }
          if anIsNew {
            const anFillObj = nodeAt(c.callArgs[1]) is ObjLit
            if (
              arrNewI32FillRefusal(callIx, c.callArgs[1], anFillObj, fnIx)
              < 0
            ) {
              return -1
            }
          }
        }
      }
      if emitExpr(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
      // The length is re-read after the fill runs, so a site inside another site's fill takes
      // a slot of its own depth; the outermost keeps the frame's one slot (D2333).
      let anLenL = arrNewScratchBase
      if arrNewFillDepth > 0 {
        anLenL = widenTmpSlot(0 - 1000 - arrNewFillDepth)
      }
      fbLocalSet(anLenL)
      if anIsNew {
        const anFillRc = emitArrNewFill(
          body,
          c.callArgs[1],
          fnIx,
          ank == "strlist",
          ec,
        )
        if anFillRc < 0 { return -1 }
        fbLocalGet(anLenL)
        fbArrayNew(anBack)
      } else {
        fbLocalGet(anLenL)
        fbArrayNewDefault(anBack)
      }
      fbLocalGet(anLenL)
      fbLocalGet(anLenL)
      fbStructNew(anWrap)
      return 0
    }
  }
  emitFail("emitProgram: emitArrayNewIntr expected an __array_new__ call")
}

// How many `__array_new__` fills enclose the site being lowered (D2333).
let arrNewFillDepth = 0

// The i32 list's fill guard for call `callIx` with fill `fill` (`fillIsObj` when it is an object
// literal): returns -1 after recording the refusal when nothing named the element rep, or the
// fill is a ref value, else 0.
function arrNewI32FillRefusal(
  callIx: i32,
  fill: i32,
  fillIsObj: boolean,
  fnIx: i32,
): i32 {
  // The i32 list is this arm's answer for an i32 or boolean fill and also
  // `arrNewIntrKind`'s fall-through. Where nothing named the kind — not the fill, not
  // the destination, not an instance's parameter annotation — the list is a guess,
  // and a guess about the fill's rep is silent invalid wasm (D1630).
  if !arrNewKindNamed(callIx, fnIx) {
    return emitFail(
      "emitProgram: __array_new__ fill names no element rep, and its destination names none either",
    )
  }
  // The i64 and f32 guards that sat here are gone (D1673): both pairs are interned,
  // so those fills take kinds 4 and 6 above and never reach this fall-through.
  let anFillRef = false
  if fillIsObj { anFillRef = true }
  if exprIsClosure(fill, fnIx) { anFillRef = true }
  if exprArray(fill, fnIx) { anFillRef = true }
  if exprRefArray(fill, fnIx) { anFillRef = true }
  if exprStringArray(fill, fnIx) { anFillRef = true }
  if exprMap(fill, fnIx) { anFillRef = true }
  if anFillRef {
    // Remaining ref-fill long tail: closures / nested arrays / maps.
    return emitFail(
      "emitProgram: __array_new__ fill type not yet supported natively",
    )
  }
  0
}

// The fill `fill` of an `__array_new__` site, emitted at the element's seeds: a `string | null`
// or `null` fill's niche.
// Returns the fill's rc, every seed restored.
function emitArrNewFill(
  body: u8[],
  fill: i32,
  fnIx: i32,
  isStrList: boolean,
  ec: ExpCtx,
): i32 {
  const anSaved = expCtxHere(ec)
  const anCtx = expCtxHere(ec)
  // A `string | null` fill keeps its null: the string backing's slot is nullable, so the
  // read is seeded as a `(string | null)[]` element's is (DV-402).
  if isStrList && exprNullableString(fill, fnIx) { anCtx.nulString = true }
  // A `null`-typed fill is the i32 list's sentinel 2, as a `null[]` element is (D4671).
  if exprIsNulNone(fill, fnIx) { anCtx.nulBool = true }
  expCtxApply(anCtx, ec)
  arrNewFillDepth = arrNewFillDepth + 1
  const anFillRc = emitExpr(body, fill, fnIx, ec)
  arrNewFillDepth = arrNewFillDepth - 1
  // The fill's own string and null seeds go back.
  const anAfter = expCtxHere(ec)
  anAfter.nulString = anSaved.nulString
  anAfter.nulBool = anSaved.nulBool
  expCtxApply(anAfter, ec)
  if anFillRc < 0 { return -1 }
  0
}

// The `__array_copy__(dst, dstAt, src, srcAt, count)` intrinsic lowering.
function emitArrayCopyIntr(body: u8[], callIx: i32, fnIx: i32, ec: ExpCtx) {
  const c = nodeAt(callIx)
  if c is Call {
    if c.callFn < 0 { return -1 }
    const callee = nodeAt(c.callFn)
    if callee is Ident {
      if c.callArgs.length != 5 {
        return emitFail(
          "emitProgram: internal: __array_copy__ reached with the wrong argument count — the checker's arity rule refuses it",
        )
      }
      const acDstF64 = exprF64Array(c.callArgs[0], fnIx)
      const acSrcF64 = exprF64Array(c.callArgs[2], fnIx)
      if acDstF64 != acSrcF64 {
        return emitFail(
          "emitProgram: __array_copy__ dst and src must share one element type",
        )
      }
      let acBack = aTypeIdx
      let acWrap = lTypeIdx
      if acDstF64 {
        if !fa64Used {
          return emitFail(
            "emitProgram: __array_copy__ f64 lists but f64 list types not collected",
          )
        }
        acBack = fa64TypeIdx
        acWrap = fl64TypeIdx
      } else {
        if (
          exprRefArray(c.callArgs[0], fnIx)
          || exprStringArray(c.callArgs[0], fnIx)
          || exprRefArray(c.callArgs[2], fnIx)
          || exprStringArray(c.callArgs[2], fnIx)
        ) {
          return emitFail(
            "emitProgram: __array_copy__ supports i32/boolean/f64 lists natively",
          )
        }
        if (
          !exprArray(c.callArgs[0], fnIx)
          || !exprArray(c.callArgs[2], fnIx)
        ) {
          return emitFail(
            "emitProgram: __array_copy__ expects list (T[]) operands",
          )
        }
        if !aUsed || !lUsed {
          return emitFail(
            "emitProgram: array intrinsic but list types not collected",
          )
        }
      }
      if emitExpr(body, c.callArgs[0], fnIx, ec) < 0 { return -1 }
      fbStructGet(acWrap, 0)
      if emitExpr(body, c.callArgs[1], fnIx, ec) < 0 { return -1 }
      if emitExpr(body, c.callArgs[2], fnIx, ec) < 0 { return -1 }
      fbStructGet(acWrap, 0)
      if emitExpr(body, c.callArgs[3], fnIx, ec) < 0 { return -1 }
      if emitExpr(body, c.callArgs[4], fnIx, ec) < 0 { return -1 }
      fbArrayCopy(acBack, acBack)
      return 0
    }
  }
  emitFail("emitProgram: emitArrayCopyIntr expected an __array_copy__ call")
}

// The fused map/list/struct nullish-coalescing lowering (`emitBinExprNode`'s `??` arm).
// Whether the `string | null` `??` node at `exprIx` lowers with a nullable result — i.e.
// whether its value `if` declares `(ref null $aTypeIdx)` rather than `(ref $aTypeIdx)`.

// The result type is the default's null-ness, not a constant: a non-null default collapses
// the read to `string` (`coalesceStaysNullable`), a nullable default leaves it `string | null`.
// It asks `exprNullableString` of the `??` node itself, since the checker's banked type is
// missing on a synthesized node (a chained `p ?? q ?? r` re-associates through `mkBinary`).
function coalesceNulStrStaysNullable(exprIx: i32, fnIx: i32, ec: ExpCtx) {
  nulStrReadStaysRaw(ec) && exprNullableString(exprIx, fnIx)
}

// The context one arm of a `string | null` `??` emits under: `raw` iff the arm's value may be
// left as `(ref null $aTypeIdx)`, exactly the block type the lowering just declared.

// Both halves of the read gate are overridden, not just `rawNullRead` — the arms otherwise
// inherit the ambient `ec.nulString` from the consumer, and a nullable-string binding with
// a non-null default read its arms raw inside a `(ref $aTypeIdx)` block. `nulStrReadStaysRaw`
// is the disjunction: "recover" clears both flags, "stay raw" sets both.
function coalesceNulStrArmCtx(raw: boolean, ec: ExpCtx): ExpCtx {
  const c = expCtxHere(ec)
  c.rawNullRead = raw
  c.nulString = raw
  return c
}

// The context the DEFAULT arm of a `K | null` `??` emits under: a member `StrLit` / `NumLit`
// default lowers as its interned ATOM ID (`litUnion`) and a bare `null` default as the spare
// sentinel `-1` (`nulLitUnion`) — the same pair the `v = "b"` / `v = null` assignment
// boundary seeds for the identical cell, because both are "produce this niche's i32".
function coalesceNulLitUnionArmCtx(ec: ExpCtx): ExpCtx {
  const c = expCtxHere(ec)
  c.nulLitUnion = true
  c.litUnion = 1
  return c
}

// The value-atom code a nullable-scalar-list `VKind` carries once it is non-null — the atom
// twin of `nulScalarListWrapHeap`'s wrapper table, one code per backing.
function nulScalarListAtomKind(kind: VKind): i32 {
  match kind {
    "nulstrlist" => {
      return 9
    }
    "nulf64list" => {
      return 8
    }
    "nuli64list" => {
      return 10
    }
    "nulf32list" => {
      return 12
    }
    "nulu8list" => {
      return 13
    }
    // Not a nullable scalar-backed list, so no atom code.
    "i32" | "struct" | "list" | "str" | "union" | "reflist" | "map" | "strlist" | "variant" | "nulvariant" | "nulstruct" | "i64" | "f64" | "f64list" | "f32" | "closure" | "nullist" | "nulstr" | "nulbool" | "nulreflist" | "nulclosure" | "i64list" | "f32list" | "nulmap" | "nulnone" | "u8list" | "v128" => {}
  }
  -1
}

// The value-atom code the nullable-ref niche at `lhsIx` carries once it is non-null, or -1 for
// a niche whose atom is not a scalar-backed one (a struct, a variant, a ref-element array).
// Read off the NICHE, since the value is still nullable and classifies as no atom at all.
function coalNicheAtomKind(lhsIx: i32, fnIx: i32): i32 {
  if exprNullableString(lhsIx, fnIx) { return 2 }
  if exprNullableList(lhsIx, fnIx) {
    // A boolean list tags apart from the `i32` list it shares storage with.
    if boolLeafListDepthOfTy(tyPeelNul(nodeTyIxOf(unwrapParen(lhsIx)))) == 0 {
      return 17
    }
    return 7
  }
  const nsk = exprNulScalarListKind(lhsIx, fnIx)
  if nsk != null { return nulScalarListAtomKind(nsk) }
  -1
}

// The element spelling a ref value-atom code names — `valueAtomKind`'s inverse over exactly
// the codes a nullable-ref niche can carry, for the union-membership test below. The code is
// an array atom unless it is 2 (`string`), so the caller derives the array flag from it.
function refAtomElemName(k: i32): string {
  if k == 2 { return "string" }
  if k == 7 { return "i32" }
  if k == 17 { return "boolean" }
  if k == 8 { return "f64" }
  if k == 9 { return "string" }
  if k == 10 { return "i64" }
  if k == 12 { return "f32" }
  if k == 13 { return "u8" }
  ""
}

// The result union's box tag for the OPERAND's own non-null rep, or -1 when no arm of that
// union carries it. A miss is a loud refusal at the caller and never a fall-through: a box
// tagged with an atom the union does not have is valid wasm whose `is` test is silently false.
function coalNicheBoxTag(
  joinSet: string,
  joinTy: i32,
  lhsIx: i32,
  heapIx: i32,
  fnIx: i32,
): i32 {
  if exprNullableRefArray(lhsIx, fnIx) {
    const rs = refListSlotOfExpr(lhsIx, fnIx)
    if rs < 0 { return -1 }
    if !unionHasRefArrayArmSlot(joinSet, rs) { return -1 }
    return refArrSlotTag(rs)
  }
  const ak = coalNicheAtomKind(lhsIx, fnIx)
  if ak >= 0 {
    const en = refAtomElemName(ak)
    if en == "" { return -1 }
    if !unionHasAtomTy(joinSet, en, ak != 2) { return -1 }
    return scalarTagOfKind(ak)
  }
  const vi = unionArmVariantWithHeap(joinSet, joinTy, heapIx)
  if vi >= 0 && vi < uTags.length { return uTags[vi] }
  -1
}

// The heap type a nullable-ref niche carries, or -1 — the same two tables the `??` niche
// arms read (`exprNullableVariant` then `exprNullableStruct`), so the box stash and the
// `br_on_non_null` block cannot disagree about the value's rep. -1 for every other niche,
// whose tag `coalNicheBoxTag` resolves from its atom code instead of from a heap.
function nulNicheValueHeap(exprIx: i32, fnIx: i32): i32 {
  const nvi = nulVariantIdxOfExpr(exprIx, fnIx)
  if nvi >= 0 {
    if nvi < uVarHeap.length { return uVarHeap[nvi] }
    return -1
  }
  if exprNullableStruct(exprIx, fnIx) {
    const nsi = structIndexOfExpr(exprIx, fnIx)
    if nsi >= 0 && nsi < sHeapIdx.length { return sHeapIdx[nsi] }
  }
  -1
}

// Box a `V | null` niche into union `unionName` (its member set; `unionKey` the name the caller
// resolved it from, asked about `null` by key): 1 when it lowered, 0 when the value is not that
// shape or the union has no arm for it, -1 on a refusal. One evaluation is parked in the niche
// stash, and the null test picks the tag; the payload rides the box's `anyref` slot (D1721).
function emitUnionBoxNulNiche(
  body: u8[],
  unionName: string,
  unionKey: string,
  unionTy: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if unionName == "" { return 0 }
  const nnIx = unwrapParen(exprIx)
  // The value's shape is asked before the union's `null`, so only a niche reads the set.
  const nnBool = exprNulBool(nnIx, fnIx)
  if !nnBool && !coalesceNulRefNicheOperand(nnIx, fnIx) { return 0 }
  if !unionSetHasNull(unionKey) { return 0 }
  // A `boolean | null` is the i32 niche whose null is the value 2, so the null test is on the
  // value, not the ref (D2260).
  if nnBool {
    const bvb = vbHeapIdxOfKind(1)
    if bvb < 0 { return 0 }
    const bSlot = widenTmpSlot(4000)
    if emitExpr(body, exprIx, fnIx, ec) < 0 { return -1 }
    fbLocalTee(bSlot)
    fbI32Const(2)
    fbI32Bin(70)     // 0x46 i32.eq → null?
    fbIfRef(uBoxIdx) // 0x04 if, (ref $uBox) blocktype
    fbI32Rel(RS_TAG, nullBoxTag())
    fbRefNullNone()
    fbStructNew(uBoxIdx)
    fbElse()
    fbI32Rel(RS_TAG, scalarTagOfKind(1))
    fbLocalGet(bSlot)
    fbStructNew(bvb)
    fbStructNew(uBoxIdx)
    fbEnd()
    return 1
  }
  const nnTag = coalNicheBoxTag(
    unionName,
    unionTy,
    nnIx,
    nulNicheValueHeap(nnIx, fnIx),
    fnIx,
  )
  if nnTag < 0 { return 0 }
  const nnSlot = nulNicheBoxSlot()
  // Read raw: a nullable-string ident is otherwise recovered non-null, which traps on the very
  // null this rung exists to box (D2260).
  const nnCtx = expCtxHere(ec)
  nnCtx.rawNullRead = true
  if emitExprExpect(body, exprIx, fnIx, nnCtx) < 0 { return -1 }
  fbLocalTee(nnSlot)
  fbRefIsNull()
  fbIfRef(uBoxIdx) // 0x04 if, (ref $uBox) blocktype — the box is the result either way
  fbI32Rel(RS_TAG, nullBoxTag())
  fbRefNullNone()  // the payload slot is unread under the null tag
  fbStructNew(uBoxIdx)
  fbElse()         // 0x05 else — present → the niche's own ref, under its arm's tag
  fbI32Rel(RS_TAG, nnTag)
  fbLocalGet(nnSlot)
  fbStructNew(uBoxIdx)
  fbEnd()          // 0x0b end
  1
}

// Will the DEFAULT reach the box rep? A struct-typed value that is neither an object literal
// nor a resolvable arm of `joinSet` passes RAW through the box coercion, and a bare
// `(ref $struct)` under a box blocktype is invalid wasm. Only that shape can, so only it is
// asked; every other default either boxes or takes its own loud reject (D1720).
function coalJoinDefaultBoxes(
  joinSet: string,
  joinTy: i32,
  defIx: i32,
  fnIx: i32,
): boolean {
  const d = nodeAt(unwrapParen(defIx))
  if d is ObjLit { return true }
  // A default that is itself a box (a nested join) is already the box rep.
  if exprUnion(defIx, fnIx) { return true }
  if !exprStruct(defIx, fnIx) { return true }
  if unionArmVariantForStructExpr(joinSet, joinTy, defIx, fnIx) >= 0 {
    return true
  }
  exprVariantIndex(defIx, fnIx) >= 0
}

// The boxed twin of the core below, for a default that JOINS rather than fits: the checker
// typed this `??` as a union, so the result is the value box and the operand's raw ref cannot
// leave a `br_on_non_null` block as itself. Stage it once in the `?.` receiver slot — the
// branch that boxes it has to read it back, which `br_on_non_null` cannot do (D1714).
function emitCoalesceNulRefJoin(
  body: u8[],
  e: BinExpr,
  exprIx: i32,
  heapIx: i32,
  lhsCtx: ExpCtx,
  fnIx: i32,
  ec: ExpCtx,
) {
  const joinN = coalesceResultUnionName(exprIx)
  let joinSet = unionMemberSetOf(joinN)
  if joinSet == "" { joinSet = joinN }
  const joinTy = nodeTyPinIxOf(exprIx)
  const tag = coalNicheBoxTag(
    joinSet,
    joinTy,
    unwrapParen(e.binLeft),
    heapIx,
    fnIx,
  )
  if tag < 0 {
    return emitFailAt(
      "emitProgram: `??` joins a nullable value into a union with no arm for the value's own type",
      exprIx,
    )
  }
  if !coalJoinDefaultBoxes(joinSet, joinTy, e.binRight, fnIx) {
    return emitFailAt(
      "emitProgram: `??` default names no arm of the union its result is",
      exprIx,
    )
  }
  if !fnUsesOptRecv {
    return emitFailAt("emitProgram: `??` operand stash not reserved", exprIx)
  }
  if emitExprExpect(body, e.binLeft, fnIx, lhsCtx) < 0 {
    return -1 // the nullable ref, evaluated ONCE
  }
  fbLocalTee(optRecvSlot)
  fbRefIsNull()
  fbIfRef(uBoxIdx) // 0x04 if, (ref $uBox) blocktype — the result's rep
  // Through `emitUnionBoxArg`, not `emitUnionCoerce`: a struct default that is already a
  // kind-8 VARIANT local is a raw `(ref $variant)`, which the coerce hands back unboxed, and
  // the box blocktype then holds a bare struct. The box-typed destinations share this entry.
  if (
    emitUnionBoxArg(body, joinN, nodeTyPinIxOf(exprIx), e.binRight, fnIx, ec)
    < 0
  ) {
    return -1
  }
  fbElse()             // 0x05 else — present → the staged ref, boxed under its own arm's tag
  fbI32Rel(RS_TAG, tag)
  fbLocalGet(optRecvSlot)
  fbStructNew(uBoxIdx) // { tag, the niche's own ref }
  fbEnd()              // 0x0b end
  0
}

// The boxed `??` over the `boolean | null` i32 niche, for a default that joins rather than
// fits: the operand is evaluated once into a scratch slot, its null (the value 2) takes the
// boxed default, and a present 0/1 is boxed under the union's boolean arm (D2383).
function emitCoalesceNulBoolJoin(
  body: u8[],
  e: BinExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const joinN = coalesceResultUnionName(exprIx)
  let joinSet = unionMemberSetOf(joinN)
  if joinSet == "" { joinSet = joinN }
  const joinTy = nodeTyPinIxOf(exprIx)
  const bvb = vbHeapIdxOfKind(1)
  if bvb < 0 || !unionHasAtomTy(joinSet, "boolean", false) {
    return emitFailAt(
      "emitProgram: `??` joins a nullable value into a union with no arm for the value's own type",
      exprIx,
    )
  }
  if !coalJoinDefaultBoxes(joinSet, joinTy, e.binRight, fnIx) {
    return emitFailAt(
      "emitProgram: `??` default names no arm of the union its result is",
      exprIx,
    )
  }
  const bSlot = widenTmpSlot(4000)
  if emitExpr(body, e.binLeft, fnIx, ec) < 0 { return -1 }
  fbLocalTee(bSlot)
  fbI32Const(2)
  fbI32Bin(70)     // 0x46 i32.eq → null?
  fbIfRef(uBoxIdx) // 0x04 if, (ref $uBox) blocktype — the result's rep
  if (
    emitUnionBoxArg(body, joinN, nodeTyPinIxOf(exprIx), e.binRight, fnIx, ec)
    < 0
  ) {
    return -1
  }
  fbElse() // 0x05 else — present → the 0/1 under the boolean arm's tag
  fbI32Rel(RS_TAG, scalarTagOfKind(1))
  fbLocalGet(bSlot)
  fbStructNew(bvb)
  fbStructNew(uBoxIdx)
  fbEnd()  // 0x0b end
  0
}

// `k ?? d` at a `string` result over the `K | null` atom niche: `-1` takes the default as a
// string, any other id widens through the member tower `emitAtomToStr` uses.
function emitCoalesceNulAtomStr(body: u8[], e: BinExpr, fnIx: i32, ec: ExpCtx) {
  const texts = nulLitAtomTexts(e.binLeft, fnIx)
  if texts.length == 0 || !aUsed {
    return emitFail(
      "emitProgram: `??` over a nullable literal union has no member strings",
    )
  }
  const slot = widenTmpSlot(4001)
  if emitExprExpect(body, e.binLeft, fnIx, coalesceNulLitUnionArmCtx(ec)) < 0 {
    return -1
  }
  fbLocalTee(slot)
  fbI32Const(-1)
  fbI32Bin(70) // 0x46 i32.eq → null?
  fbIfRefNul(sTypeIdx, defExprNullable(e.binRight))
  if exprIsLitAtom(e.binRight, fnIx) {
    if emitAtomToStr(body, e.binRight, fnIx, ec) < 0 { return -1 }
  } else {
    if emitExpr(body, e.binRight, fnIx, ec) < 0 { return -1 }
  }
  fbElse() // present → the id's member string
  fbLocalGet(slot)
  setStrScrI(body, 0)
  if emitAtomToStrChain(body, texts, 0, strScratchBase + 3) < 0 { return -1 }
  fbEnd()
  0
}

// The `br_on_non_null` core every nullable-ref-niche `??` shares, with both contexts and the
// block's null-ness spelled out by the caller. `heapIx` is the cell's own heap type,
// `nulBlock` whether the result may still be null, `lhsCtx` the context the one lhs evaluation
// runs under and `defCtx` the context the default arm emits under.

// One evaluation, no stash, no re-read, and it short-circuits: `br_on_non_null` consumes the
// nullable ref and either branches out carrying `(ref $heapIx)` or falls through to the
// default, covering every lhs source with one arm — the narrow is the branch, so there is no
// separate narrow step to miss (the list-index lhs is where the replaced re-read shape broke).
function emitCoalesceNulRefCtx(
  body: u8[],
  e: BinExpr,
  exprIx: i32,
  heapIx: i32,
  nulBlock: boolean,
  lhsCtx: ExpCtx,
  defCtx: ExpCtx,
  fnIx: i32,
  ec: ExpCtx,
) {
  // A default of another type makes the result the union box, which this block type cannot be:
  // `br_on_non_null` branches with the raw ref it tested, so the boxed shape is its own arm.
  if coalesceNicheJoinsToBox(exprIx, fnIx) {
    return emitCoalesceNulRefJoin(body, e, exprIx, heapIx, lhsCtx, fnIx, ec)
  }
  // A union of records with no row, as two instances of one generic record make, has no box.
  if (
    tyIsStructBearingUnion(nodeTyIxOf(exprIx))
    && !coalesceResultIsBox(exprIx)
  ) {
    return emitFailAt(
      "emitProgram: this `??` joins records into a union that has no box yet, as a union of two instances of one generic record does not",
      exprIx,
    )
  }
  if coalListDefaultClash(e, fnIx) {
    return emitFailAt(
      "emitProgram: `??` over a list whose default is a list of another storage builds no single list at this type argument — give the default the operand's own element type",
      exprIx,
    )
  }
  // blocktype `(ref null $heapIx)` keeps the result nullable; `(ref $heapIx)` is non-null.
  fbBlockRefNul(heapIx, nulBlock)
  if emitExprExpect(body, e.binLeft, fnIx, lhsCtx) < 0 {
    return -1 // the nullable ref, evaluated ONCE
  }
  fbBrOnNonNull(0) // non-null → branch to the block end with the (ref $heapIx)
  if heapIx == sTypeIdx && exprIsLitAtom(e.binRight, fnIx) {
    if emitCoalesceAtomStrDefault(body, e.binRight, nulBlock, fnIx, ec) < 0 {
      return -1
    }
  } else {
    if emitExprExpect(body, e.binRight, fnIx, defCtx) < 0 { return -1 }
  }
  fbEnd() // 0x0b end
  0
}

// The default of a `string | null` `??` when it is a literal-union atom (`K` or `K | null`):
// widened to its member string, `-1` to `ref.null`, and recovered non-null when the block is.
function emitCoalesceAtomStrDefault(
  body: u8[],
  defIx: i32,
  nulBlock: boolean,
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitAtomToStr(body, defIx, fnIx, ec) < 0 { return -1 }
  if !nulBlock && nulAtomWidenTexts(defIx).length > 0 {
    fbRefAsNonNull() // 0xd4 the block is non-null: the default's null is narrowed away
  }
  0
}

// Whether a `??` typed as its operand's one list has a default stored as another list at this
// instance. A list literal default is built at the operand's element when it is numeric and
// fits (`[1]` into `f64[]`); anything else has no converting copy. D2799 is the generic case.
function coalListDefaultClash(e: BinExpr, fnIx: i32): boolean {
  let lit = false
  const d = nodeAt(unwrapParen(e.binRight))
  if d is ArrayLit {
    if d.arrElems.length == 0 { return false }
    lit = true
  }
  const dk = exprListRep(e.binRight, fnIx)
  if dk == null { return false }
  const lk = coalOperandListRep(e.binLeft, fnIx)
  if lk == "" || lk == dk { return false }
  if (
    !lit
    || dk == "strlist"
    || dk == "reflist"
    || lk == "strlist"
    || lk == "reflist"
  ) {
    return true
  }
  if lk == "f64list" || lk == "f32list" { return false }
  if lk == "i64list" { return dk == "f64list" }
  dk == "f64list" || dk == "i64list"
}

// The list rep a nullable-list `??` operand holds at this instance, named as `exprListRep`
// names a default's; "" when the operand is no nullable list this path lowers.
function coalOperandListRep(exprIx: i32, fnIx: i32): string {
  if exprNullableList(exprIx, fnIx) { return "list" }
  const nsk = exprNulScalarListKind(exprIx, fnIx)
  if nsk == "nulstrlist" { return "strlist" }
  if nsk == "nulf64list" { return "f64list" }
  if nsk == "nuli64list" { return "i64list" }
  if nsk == "nulf32list" { return "f32list" }
  if nsk == "nulu8list" { return "u8list" }
  coalOperandRefListRep(exprIx, fnIx)
}

// The rest of `coalOperandListRep`: "reflist" for a nullable record or nested list, else "".
function coalOperandRefListRep(exprIx: i32, fnIx: i32): string {
  if exprNullableRefArray(exprIx, fnIx) { return "reflist" }
  ""
}

// The core above for the nullable struct (`S | null`) and nullable collections (`i32[] |
// null`, `string[] | null`, …): the lhs takes the ambient seeds (these reps have no
// self-recovering read) and the block type is the default's null-ness
// (`coalesceDefaultNullable`) — a non-null default collapses to `(ref $heapIx)`, a nullable one leaves it nullable, since `br_on_non_null` branches with `(ref $heapIx)`, a subtype of both.
function emitCoalesceNulRef(
  body: u8[],
  e: BinExpr,
  exprIx: i32,
  heapIx: i32,
  defCtx: ExpCtx,
  fnIx: i32,
  ec: ExpCtx,
) {
  emitCoalesceNulRefCtx(
    body,
    e,
    exprIx,
    heapIx,
    coalesceDefaultNullable(e.binRight, fnIx),
    expCtxHere(ec),
    defCtx,
    fnIx,
    ec,
  )
}

// Widen a `??`'s unboxed operand from its own atom kind to the RESULT's, for the case where a
// wider default widened the whole expression (`i32 | null ?? 1.5` is an f64). Equal kinds emit
// nothing; a pair with no conversion refuses loudly, the block type already being the
// result's (D1699).
function coalWidenUnboxed(from: i32, to: i32) {
  if from == to { return 0 }
  if from == 0 {
    if to == 4 {
      fbF64ConvertI32S() // i32 -> f64
      return 0
    }
    if to == 5 {
      fbF32ConvertI32S() // i32 -> f32
      return 0
    }
    if to == 3 {
      fbI64ExtendI32S() // i32 -> i64
      return 0
    }
  }
  if from == 5 {
    if to == 4 {
      fbF64PromoteF32() // f32 -> f64
      return 0
    }
  }
  if from == 3 {
    if to == 4 {
      fbF64ConvertI64S() // i64 -> f64
      return 0
    }
  }
  emitFail(
    "emitProgram: `??` widens its operand to a result kind with no conversion",
  )
}

// True when `coalWidenUnboxed` converts atom kind `from` to a different kind `to`.
function coalWidens(from: i32, to: i32): boolean {
  if from == 0 { return to == 3 || to == 4 || to == 5 }
  if from == 3 || from == 5 { return to == 4 }
  false
}

// The checker's atom kind for the `??` at `exprIx`, -1 when it is not a value atom or is null.
function coalResultKindOf(exprIx: i32, fnIx: i32): i32 {
  const k = boxTagOfTy(coalResultTyOf(exprIx, fnIx))
  if k == nullValKind() { return -1 }
  k
}

// `l ?? d`, with a `?.` chain on the left staged for the whole lowering when its base is not
// a re-readable place — the fused arms read the receiver two and three times, and the stash
// is what lets them do that to a call. One save/restore, since a default may hold a chain.
function emitCoalesce(
  body: u8[],
  e: BinExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const coRecvSv = optRecvStageSave()
  const coGetSv = listGetStageSave()
  optRecvStageMark(e.binLeft)
  const coR = emitCoalesceGo(body, e, exprIx, fnIx, ec)
  optRecvStageRestore(coRecvSv)
  listGetStageRestore(coGetSv)
  coR
}

// Is `exprIx` a list ELEMENT read — a subscript `a[i]`, or the `.get(i)` spelling of one? The
// `??` box-unbox arm's bound: an element's rep comes from its list's element slot, where a
// struct field's can come from a row the literal merged onto (D1411). A map `.get` is claimed
// by the fused map arm long before this and is excluded by name, not by arrival order.
function isListElementRead(exprIx: i32, fnIx: i32): boolean {
  const e = nodeAt(unwrapParen(exprIx))
  if e is Index { return true }
  isListGetCall(exprIx, fnIx)
}

// The `.get(i)` half of `isListElementRead`, asked on its own because a `.get` is the CHECKED
// read: an out-of-range index yields NO box, where a subscript traps. That is a second null
// channel the present-test has to cover, and only for this spelling.
function isListGetCall(exprIx: i32, fnIx: i32): boolean {
  const e = nodeAt(unwrapParen(exprIx))
  if e is Call {
    if e.callFn < 0 { return false }
    const geCallee = nodeAt(e.callFn)
    if geCallee is Member {
      if geCallee.memProp == "get" && e.callArgs.length == 1 {
        return !exprMap(geCallee.memObj, fnIx)
      }
    }
  }
  false
}

// The wasm result byte a value-box atom kind unboxes to, or -1 when the kind is not a
// numeric scalar. `boolean` and `string` never reach the caller — each has its own niche —
// and a ref atom rides the box's anyref rather than a per-rep value box (D1828).
function nulBoxScalarValtype(kind: i32) {
  if kind == 0 {
    return 127 // i32
  }
  if kind == 3 {
    return 126 // i64
  }
  if kind == 4 {
    return 124 // f64
  }
  if kind == 5 {
    return 125 // f32
  }
  -1
}

// The `?? d` default at the atom kind the present arm unboxes to, so the two arms of the
// `if` agree: an i64/f64/f32 destination re-encodes its literal exactly as a union-box
// argument does.
function emitCoalesceScalarDefault(
  body: u8[],
  defIx: i32,
  kind: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if kind == 3 { return emitExprAsI64(body, defIx, fnIx, ec) }
  if kind == 4 { return emitExprAsF64(body, defIx, fnIx, ec) }
  if kind == 5 { return emitExprAsF32(body, defIx, fnIx, ec) }
  emitExpr(body, defIx, fnIx, ec)
}

// `x ?? d` over a nullable value box read with its narrowing lifted: the box's tag decides, the
// present arm unboxed at the coalesce's rep (a numeric scalar, or the value box itself).
function emitCoalesceBoxRuntime(
  body: u8[],
  e: BinExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const bk = boxTagOfTy(nodeTyIxOf(exprIx))
  const bVt = nulBoxScalarValtype(bk)
  const bVb = vbHeapIdxOfKind(bk)
  let bNm = ""
  if exprUnion(exprIx, fnIx) { bNm = unionNameOfExpr(exprIx, fnIx) }
  if (bVt < 0 || bVb < 0) && bNm == "" {
    return emitFail(
      "emitProgram: `??` over a null-narrowed value box has no rep for its result",
    )
  }
  const bSlot = sharedFieldRecvSlot()
  if emitExpr(body, e.binLeft, fnIx, ec) < 0 { return -1 }
  fbLocalSet(bSlot)
  fbLocalGet(bSlot)
  fbStructGet(uBoxIdx, 0) // field 0: tag
  fbI32Rel(RS_TAG, nullBoxTag())
  fbI32Bin(71) // 0x47 i32.ne — present?
  if bVt >= 0 && bVb >= 0 {
    fbIf(bVt)
    fbLocalGet(bSlot)
    fbStructGet(uBoxIdx, 1) // field 1: the payload anyref
    fbRefCast(bVb)
    fbStructGet(bVb, 0)
    fbElse()
    if emitCoalesceScalarDefault(body, e.binRight, bk, fnIx, ec) < 0 {
      return -1
    }
    fbEnd()
    return 0
  }
  fbIfRefNul(uBoxIdx, false) // if (result (ref $uBox))
  fbLocalGet(bSlot)
  fbRefAsNonNull()
  fbElse()
  if emitUnionBoxArg(body, bNm, nodeTyIxOf(exprIx), e.binRight, fnIx, ec) < 0 {
    return -1
  }
  fbEnd()
  0
}

// `r?.f ?? d` over a value-box field, which can itself hold `null`: one test covers a null
// link and a null field, and the present arm reads the box at the `??`'s own rep — the
// unboxed scalar, or the box of a union result (D3457).
function emitOptCoalesceBoxLeaf(
  body: u8[],
  e: BinExpr,
  lhs: OptMember,
  heap: i32,
  fi: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const lhsIx = unwrapParen(e.binLeft)
  let bNm = ""
  if exprUnion(exprIx, fnIx) { bNm = unionNameOfExpr(exprIx, fnIx) }
  // A link `emitCoalesceGo` re-associated out of a chain carries no type of its own; its
  // result is then the leaf's `T | null` with the null removed.
  let rTy = nodeTyIxOf(exprIx)
  if rTy < 0 { rTy = tyPeelNul(nodeTyIxOf(lhsIx)) }
  const bk = boxTagOfTy(rTy)
  const bVt = nulBoxScalarValtype(bk)
  if bNm == "" && bVt < 0 {
    return emitFail(
      "emitProgram: `?.` … `??` over a nullable value-box field has no rep for its result",
    )
  }
  // The box holds the FIELD's scalar; a default that widens the result (`?? 2.5` over an
  // `i32 | null` field) converts it after the unbox.
  const fk = boxTagOfTy(tyPeelNul(nodeTyIxOf(lhsIx)))
  const fVb = vbHeapIdxOfKind(fk)
  if bNm == "" && (fVb < 0 || !scalarKindWidens(fk, bk)) {
    return emitFail(
      "emitProgram: `?.` … `??` over a nullable value-box field has no conversion to its result",
    )
  }
  if emitOptChainIsNull(body, lhsIx, fnIx, ec) < 0 { return -1 }
  if bNm == "" {
    fbIf(bVt)
    if emitCoalesceScalarDefault(body, e.binRight, bk, fnIx, ec) < 0 {
      return -1
    }
  } else {
    fbIfRef(uBoxIdx)
    if (
      emitUnionBoxArg(body, bNm, nodeTyIxOf(exprIx), e.binRight, fnIx, ec)
      < 0
    ) {
      return -1
    }
  }
  fbElse()
  if emitOptChainValue(body, lhs.omObj, fnIx, ec) < 0 { return -1 }
  fbStructGet(heap, fi)
  if bNm == "" {
    fbStructGet(uBoxIdx, 1) // field 1: the payload anyref
    fbRefCast(fVb)
    fbStructGet(fVb, 0)
    emitScalarWiden(fk, bk)
  }
  fbEnd()
  0
}

// Whether a scalar of value-atom kind `from` (0 i32, 3 i64, 4 f64, 5 f32) widens losslessly
// to kind `to`: itself, i32 to i64 or f64, or f32 to f64.
function scalarKindWidens(from: i32, to: i32): boolean {
  if from == to { return true }
  if from == 0 { return to == 3 || to == 4 }
  from == 5 && to == 4
}

// The widening `scalarKindWidens` admits, applied to the scalar on the stack.
function emitScalarWiden(from: i32, to: i32) {
  if from == to { return 0 }
  if to == 3 { return fbI64ExtendI32S() }
  if from == 5 { return fbF64PromoteF32() }
  fbF64ConvertI32S()
}

// The receiver of a `??` field read: `cast` is the arm heap a one-arm-narrowed union box is
// cast to, -2 a null-tested nullable arm asserted non-null, -1 the receiver read as it is.
function emitCoalArmRecv(
  body: u8[],
  recvIx: i32,
  cast: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if emitExpr(body, recvIx, fnIx, ec) < 0 { return -1 }
  if cast >= 0 {
    fbStructGet(uBoxIdx, 1)
    fbRefCast(cast)
  }
  if cast == -2 { fbRefAsNonNull() }
  0
}

// The `if lhs != null { lhs } else { d }` node for `lhs ?? d` when `lhs` reads a map off a hole
// whose pin's value excludes null and is no literal union, and the default is nullable at the
// pin; -1 otherwise. The node carries the `??`'s type.
function coalHoleMapReadNullTest(
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
): i32 {
  const rd = nodeAt(lhsIx)
  if !(rd is Index) || !exprReReadable(lhsIx) { return -1 }
  const own = nodeTyIxOf(unwrapParen(rd.idxArr))
  if own < 0 || own >= T.tys.length || !(tyAt(own) is TyVar) { return -1 }
  const mt = mapRecvTyIn(rd.idxArr, fnIx)
  if mt < 0 { return -1 }
  const vt = tyMapValOf(mt)
  // A nullable number's box is the join's own rep, so its read is the `then` arm as is.
  // Typed at that box, since a re-associated chain's inner link carries no type of its own.
  if coalHoleNulNumRead(e, fnIx) {
    const nnIf = coalNullTestIf(e, exprIx, fnIx)
    nodeTyRecord(nnIf, vt)
    return nnIf
  }
  if vt < 0 || tyBearsNull(vt) || tyIsLitUnion(vt) { return -1 }
  const dix = unwrapParen(e.binRight)
  if dix < 0 { return -1 }
  if (!coalesceDefaultNullable(dix, fnIx) && !tyBearsNull(nodeTyPinIxOf(dix))) {
    return -1
  }
  const ifIx = coalNullTestIf(e, exprIx, fnIx)
  // Typed at the instance's join, which the shared `??` records only as its hole.
  const rt = coalResultTyOf(exprIx, fnIx)
  if rt >= 0 && rt < T.tys.length && !(tyAt(rt) is TyVar) {
    nodeTyRecord(ifIx, rt)
  }
  ifIx
}

// The `if lhs != null { lhs } else { d }` node for a re-readable map read `lhs ?? d` that joins
// into a box the fused read cannot build, a boxed or atom value beside another arm; -1 otherwise.
function coalMapReadJoinNullTest(
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
): i32 {
  const rd = nodeAt(lhsIx)
  if !(rd is Index) || !exprReReadable(lhsIx) { return -1 }
  if !exprMap(rd.idxArr, fnIx) || mapRecvScalarBoxKindIn(rd.idxArr, fnIx) >= 0 {
    return -1
  }
  const vt = tyMapValOf(mapRecvTyIn(rd.idxArr, fnIx))
  if !tyIsLitUnion(vt) && !tyIsUnionShaped(vt) && !tyBearsNull(vt) { return -1 }
  coalNullTestIf(e, exprIx, fnIx)
}

// `if l != null { l } else { d }` for `l ?? d`, carrying the `??`'s type. A declared atom niche's
// arm re-reads `l` at its non-null set, the narrowing the checker would have recorded.
function coalNullTestIf(e: BinExpr, exprIx: i32, fnIx: i32): i32 {
  const thenS: i32[] = []
  thenS.push(coalNarrowedReRead(unwrapParen(e.binLeft), fnIx))
  const elseS: i32[] = []
  elseS.push(e.binRight)
  const pos = e.pos
  const ifIx = mkIf(
    mkBinary("!=", e.binLeft, mkNull("null", pos), pos),
    mkBlock(thenS, pos),
    mkBlock(elseS, pos),
    pos,
  )
  nodeTyCarry(ifIx, exprIx)
  ifIx
}

// `if true { l } else { d }` for an instance's `l ?? d` whose operand it typed without `null` at
// a type the `??`'s join widens, so the dead default still shapes the join the arms deliver
// into; -1 when the operand bears `null`, matches the join, or either type is a hole.
function coalRetypedDeadJoinIf(
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
): i32 {
  if !fnInPinnedInstance(fnIx) { return -1 }
  const lt = nodeTyAt(lhsIx, fnIx)
  if (
    lt < 0
    || lt >= T.tys.length
    || tyAt(lt) is TyVar
    || !tyProvesNonNull(lt)
  ) {
    return -1
  }
  const pt = nodeTyPinIxOf(exprIx)
  if pt < 0 || pt >= T.tys.length || pt == lt || tyHasTyVar(pt) { return -1 }
  const thenS: i32[] = []
  thenS.push(e.binLeft)
  const elseS: i32[] = []
  elseS.push(e.binRight)
  const pos = e.pos
  const ifIx = mkIf(
    mkBool(1, pos),
    mkBlock(thenS, pos),
    mkBlock(elseS, pos),
    pos,
  )
  nodeTyRecord(ifIx, pt)
  ifIx
}

// A copy of the name, field or map read `ix` typed without `null` (a literal union, or one atom
// for a field or element read), or `ix` itself when its type, an instance's own for a hole, is
// neither.
function coalNarrowedReRead(ix: i32, fnIx: i32): i32 {
  let lt = nodeTyAt(ix, fnIx)
  if lt >= 0 && lt < T.tys.length && tyAt(lt) is TyVar {
    lt = holeOperandTyOf(ix, fnIx)
  }
  if lt < 0 || lt >= T.tys.length || tyAt(lt) is TyVar { return ix }
  const nn = tyPeelNul(lt)
  if nn == lt { return ix }
  const l = nodeAt(ix)
  // A field or element read the test narrows to one atom reads at it, as the checker types it.
  if !tyIsLitUnion(nn) {
    const nk = boxTagOfTy(nn)
    if l is Ident || nk < 0 || nk == 6 { return ix }
  }
  let cp = -1
  if l is Member { cp = mkMember(l.memObj, l.memProp, l.pos) }
  if l is Index { cp = mkIndex(l.idxArr, l.idxIndex, l.pos) }
  if l is Ident {
    cp = mkIdent(l.identName, l.pos)
    identFrom(cp, ix)
  }
  if cp < 0 { return ix }
  nodeTyRecord(cp, nn)
  cp
}

function emitCoalesceGo(
  body: u8[],
  e: BinExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // Unwrap a parenthesized lhs so `(m[k]) ?? d` / `(m.get(k)) ?? d` take the same fused
  // map-get path as the bare forms — parens must not change `??` semantics. `lhsIx` is the
  // unwrapped place every structural branch below dispatches on; the generic niche paths
  // re-evaluate `e.binLeft` directly and already peel parens, so they are unaffected.
  const lhsIx = unwrapParen(e.binLeft)
  if lhsIx < 0 { return -1 }
  // A left operand an instance closes to a type with no `null` is the whole `??`, as
  // `emit_rewrite` folds the concrete spelling; the shared node kept the template's hole.
  if (
    fnIx >= 0
    && tyHasTyVar(nodeTyIxOf(lhsIx))
    && tyExcludesNull(nodeTyAt(lhsIx, fnIx))
  ) {
    return emitExpr(body, e.binLeft, fnIx, ec)
  }
  const lhs = nodeAt(lhsIx)
  // `a ?? b ?? d` parses LEFT-associative (`(a ?? b) ?? d`); `??` is
  // associative, so RE-ASSOCIATE to `a ?? (b ?? d)` — the inner coalesce
  // becomes the outer's default and each LHS is again a plain place the
  // single-step lowerings below handle (host: same chained-coalesce value).
  if lhs is BinExpr {
    if lhs.binOp == "??" {
      const reInner = mkBinary("??", lhs.binRight, e.binRight, -1)
      const reOuter = mkBinary("??", lhs.binLeft, reInner, -1)
      // A chain joining structs is one box: both links take the chain's union, a supertype of
      // the inner link's own join with the same null-ness, so its arm tags agree (D2373).
      const chTy = nodeTyPinIxOf(exprIx)
      // A chain joining numbers of different types apart is one box the same way.
      if (
        tyIsStructBearingUnion(chTy)
        || (numUnionMinted && tyHoldsNumbersApart(chTy))
      ) {
        nodeTyRecord(reInner, chTy)
        nodeTyRecord(reOuter, chTy)
      } else {
        // Otherwise the outer link is the chain. The inner one lies between `d` and the chain,
        // so it is the chain's type exactly when `d` already is.
        nodeTyCarry(reOuter, exprIx)
        if tySame(nodeTyAt(exprIx, fnIx), nodeTyAt(e.binRight, fnIx)) {
          nodeTyCarry(reInner, exprIx)
        }
      }
      return emitExpr(body, reOuter, fnIx, ec)
    }
  }
  // D1576 — the `null` type on the left makes the operand dead, the mirror of the narrowing
  // rule below. A never-filled `let x = null` binding (or a `nulnone`-returning call) is
  // statically null, so `x ?? d` is `d`: there is no niche to test, and every arm below would
  // read the operand at a nullable rep this value lacks. The operand is still evaluated and dropped for effect.
  if exprIsNulNone(lhsIx, fnIx) {
    if emitNulNoneForEffect(body, lhsIx, fnIx, ec) < 0 { return -1 }
    return emitExpr(body, e.binRight, fnIx, ec)
  }
  // An instance's `if` with a `null` arm keeps the generic `V | null` no arm below has a rep for.
  if (
    lhs is IfStmt
    && tyHasTyVar(nodeTyIxOf(lhsIx))
    && fnInPinnedInstance(fnIx)
  ) {
    const armIf = coalNullArmIf(e, exprIx)
    if armIf >= 0 { return emitExpr(body, armIf, fnIx, ec) }
  }
  if coalesceOperandPinNonNull(exprIx, fnIx) {
    return emitExpr(body, lhsIx, fnIx, ec)
  }
  // An operand an instance re-typed at a pin that excludes `null` has a dead default.
  if coalRetypedDead(exprIx, lhsIx, fnIx) {
    return emitExpr(body, lhsIx, fnIx, ec)
  }
  const djIf = coalRetypedDeadJoinIf(e, lhsIx, exprIx, fnIx)
  if djIf >= 0 { return emitExpr(body, djIf, fnIx, ec) }
  // A field the receiver's stored row holds flat cannot be null, whatever row a narrowing
  // typed the read at, so the default is dead (D8342).
  if coalFieldStoredFlat(exprIx, lhsIx, fnIx) {
    return emitExpr(body, lhsIx, fnIx, ec)
  }
  if coalesceRetypedAtomToStr(exprIx, fnIx) {
    return emitAtomToStr(body, lhsIx, fnIx, ec)
  }
  // A read the narrowing pins to `null` may have been written since the test (a loop, a
  // closure, a call), so the narrowing is lifted and the box tested at run time (D2801).
  const cnKey = narrowedToNullKey(lhsIx)
  if cnKey != "" {
    const cnMask = maskNarrowFor(cnKey)
    const cnRc = emitCoalesceBoxRuntime(body, e, exprIx, fnIx, ec)
    unmaskNarrow(cnMask)
    return cnRc
  }
  // A pop under a `.length` test of its receiver yields its element (D3558).
  if popTakesElem(lhsIx) && nodeTyIxOf(lhsIx) == nodeTyIxOf(exprIx) {
    return emitExpr(body, lhsIx, fnIx, ec)
  }
  // A hole's map read with a nullable default is the null test the rewrite makes of the direct
  // spelling (D2248), decided here because only the instance knows the map and the default.
  const holeIf = coalHoleMapReadNullTest(e, lhsIx, exprIx, fnIx)
  if holeIf >= 0 { return emitExpr(body, holeIf, fnIx, ec) }
  // A default that is another arm of the result's union reads the map as a nullable operand,
  // through the join arms below.
  const mapFused = !coalesceMapReadJoins(exprIx, fnIx)
  if !mapFused {
    const msj = emitMapGetOrScalarJoin(body, e, exprIx, fnIx, ec)
    if msj < 0 { return -1 }
    if msj > 0 { return 0 }
    const mjIf = coalMapReadJoinNullTest(e, lhsIx, exprIx, fnIx)
    if mjIf >= 0 { return emitExpr(body, mjIf, fnIx, ec) }
  }
  if lhs is Index {
    if mapFused && exprMap(lhs.idxArr, fnIx) {
      return emitMapGetOr(
        body,
        lhs.idxArr,
        lhs.idxIndex,
        e.binRight,
        fnIx,
        coalResultKindOf(exprIx, fnIx),
        ec,
      )
    }
  }
  const cmj = emitCoalesceMapJoin(body, e, exprIx, fnIx, ec)
  if cmj < 0 { return -1 }
  if cmj > 0 { return 0 }
  // The METHOD form `recv.get(k) ?? d` over a map receiver is the SAME fused
  // get-with-default as `recv[k] ?? d` — lower it identically. (The LIST `.get`
  // at ~6890 is a distinct struct-element get and is NOT a map; `exprMap` gates
  // this to map receivers only.)
  if lhs is Call {
    if lhs.callFn < 0 { return -1 }
    const lcallee = nodeAt(lhs.callFn)
    if lcallee is Member {
      if lcallee.memProp == "get" {
        if mapFused && exprMap(lcallee.memObj, fnIx) {
          if lhs.callArgs.length != 1 {
            return emitFail(
              "emitProgram: internal: map .get reached with the wrong argument count — the checker's arity rule refuses it",
            )
          }
          return emitMapGetOr(
            body,
            lcallee.memObj,
            lhs.callArgs[0],
            e.binRight,
            fnIx,
            coalResultKindOf(exprIx, fnIx),
            ec,
          )
        }
        // `xs.get(i) ?? d` over a SCALAR-element list (i32 / boolean / f64, and an i64 or
        // f32 one whose `??` keeps the element type) is the FUSED checked read-with-default
        // (B6) — one bounds compare.
        const lgk = scalarListElemKind(lcallee.memObj, fnIx)
        const lgPrim = tyPrimNameOf(nodeTyIxOf(exprIx))
        if (
          exprF64Array(lcallee.memObj, fnIx)
          || exprArray(lcallee.memObj, fnIx)
          || (lgk == "i64" && lgPrim == "i64")
          || (lgk == "f32" && lgPrim == "f32")
        ) {
          return emitListGetOr(body, lhsIx, e.binRight, fnIx, ec)
        }
      }
      // `xs.pop() ?? d` over a scalar list is the fused checked pop-with-default: `len != 0`
      // selects decrement-and-read or `d`. Gated on `scalarListElemKind`, the discriminator
      // `emitPopOr` selects its rep with; a wide kind only where the `??` keeps the element type.
      if lcallee.memProp == "pop" {
        const pk = scalarListElemKind(lcallee.memObj, fnIx)
        const pkPrim = tyPrimNameOf(nodeTyIxOf(exprIx))
        if (
          pk == "i32"
          || (pk == "f64" && pkPrim == "f64")
          || (pk == "i64" && pkPrim == "i64")
          || (pk == "f32" && pkPrim == "f32")
        ) {
          if (
            !exprRefArray(lcallee.memObj, fnIx)
            && !exprStringArray(lcallee.memObj, fnIx)
          ) {
            return emitPopOr(body, lhsIx, e.binRight, fnIx, ec)
          }
        }
      }
    }
  }
  return emitCoalesceNiche(body, e, lhsIx, exprIx, fnIx, ec)
}

// The niche-cell arms of `emitCoalesceGo`, from the `boolean | null` select through the
// nullable `string`; `lhs` is `P.nodes[lhsIx]`, the unwrapped operand. Returns what
// `emitCoalesceGo` returns: 0 lowered, -1 failed.
function emitCoalesceNiche(
  body: u8[],
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const lhs = nodeAt(lhsIx)
  // These generic niche `??` paths RE-EVALUATE `e.binLeft` (twice for the bool select,
  // and in the else arm for the string), so they apply only to an effect-free place —
  // an ident binding or a struct FIELD. A CALL lhs (`f() ?? d`) cannot be re-evaluated
  // and is handled by the stash-based call path in the `lhs is Call` block below.
  let lhsReEval = true
  if lhs is Call { lhsReEval = false }
  // D1250 — AN IF-expression operand IS NOT RE-READABLE. Its condition can have effects, and
  // re-reading it re-runs them: `(if bump() { true }) ?? false` bumped TWICE. The arms below
  // that already carry a stash leg read this flag, so they switch over; the `boolean | null`
  // arm gained one for the same reason. `coalChainHasCallLhs` reserves the slots.
  if lhs is IfStmt { lhsReEval = false }
  // `<e> ?? d` over a `boolean | null` niche (an ident binding, a `boolean | null` struct field,
  // or a `(boolean | null)[]` element read) — the i32 cell holds 0/1 or the sentinel 2
  // (`null`); take the default on 2. Generic in `e.binLeft`, so one arm covers every
  // re-readable place.

  // A branching `if` over the 0x7f blocktype, which is what `??` means: the default runs only
  // when the lhs is null. `select` evaluates both value operands unconditionally, so a
  // side-effecting default would run on the present path too — the same lowering the `K |
  // null` niche, the `string | null` niche and every nullable-ref rep already use.
  if exprNulBool(e.binLeft, fnIx) && coalesceNicheJoinsToBox(exprIx, fnIx) {
    return emitCoalesceNulBoolJoin(body, e, exprIx, fnIx, ec)
  }
  if !(lhs is Call) && exprNulBool(e.binLeft, fnIx) {
    if emitExpr(body, e.binLeft, fnIx, ec) < 0 {
      return -1 // the niche i32
    }
    // D1250 — a NON-RE-READABLE operand (an if-EXPRESSION) stashes its ONE evaluation, exactly
    // as the `K | null` arm below does; a place operand keeps the re-read, byte-identical.
    if !lhsReEval {
      fbLocalSet(coalesceCallBoolSlot)
      fbLocalGet(coalesceCallBoolSlot)
    }
    fbI32Const(2)
    fbI32Bin(70) // 0x46 i32.eq → x == 2 (null)
    fbIf(127)    // 0x04 if, 0x7f i32 blocktype
    if emitExpr(body, e.binRight, fnIx, ec) < 0 {
      return -1 // d, reached only on the null path
    }
    fbElse() // 0x05 else — present → the 0/1 cell
    if lhsReEval {
      if emitExpr(body, e.binLeft, fnIx, ec) < 0 { return -1 }
    } else {
      fbLocalGet(coalesceCallBoolSlot)
    }
    fbEnd() // 0x0b end
    return 0
  }
  // `<e> ?? d` over a `K | null` niche (ident/param/global, a struct field, an element read, or
  // a returning call). The i32 cell holds an interned atom id (>= 0) or sentinel `-1`, so the
  // null test is the `-1` compare and the block type is unconditional `0x7f`.
  // `coalesceLitUnionFits` is the one claim deciding whether the rep survives the default, so `k ?? "zz"` declines here and keeps its loud reject.

  // A branching `if`, not a `select`: `select` evaluates both value operands, so a
  // side-effecting default would run on the present path. The `if` framing costs three bytes
  // more per site; a call lhs is stashed once in the shared i32 coalesce-call slot.
  if coalesceLitUnionFits(exprIx, fnIx) {
    // The operand reads at the niche its classifier names, so a prelude join builds the atom.
    if (
      emitExprExpect(body, e.binLeft, fnIx, coalesceNulLitUnionArmCtx(ec))
      < 0
    ) {
      return -1 // the niche i32, evaluated ONCE
    }
    if !lhsReEval {
      fbLocalSet(coalesceCallBoolSlot)
      fbLocalGet(coalesceCallBoolSlot)
    }
    fbI32Const(-1)
    fbI32Bin(70) // 0x46 i32.eq → x == -1 (null)
    fbIf(127)    // 0x04 if, 0x7f i32 blocktype
    if (
      emitExprExpect(body, e.binRight, fnIx, coalesceNulLitUnionArmCtx(ec))
      < 0
    ) {
      return -1 // d, as this niche's i32
    }
    fbElse() // 0x05 else — present → the atom id
    if lhsReEval {
      if (
        emitExprExpect(body, e.binLeft, fnIx, coalesceNulLitUnionArmCtx(ec))
        < 0
      ) {
        return -1
      }
    } else {
      fbLocalGet(coalesceCallBoolSlot)
    }
    fbEnd() // 0x0b end
    return 0
  }
  // `<e> ?? d` over a `K | null` niche whose default is not a member: the result is a
  // `string`, so the atom is evaluated once and the present arm widens it (D3198).
  if coalesceNulAtomToStr(exprIx, fnIx) {
    return emitCoalesceNulAtomStr(body, e, fnIx, ec)
  }
  // `<e> ?? d` over a nullable collection niche (`i32[] | null`, `string[] | null` /
  // `f64[] | null` / `i64[] | null` / `f32[] | null`, `i32[][] | null` / `S[] | null`): the
  // cell is a `(ref null $wrapper)`, so it takes the same `br_on_non_null` lowering as the
  // nullable struct below — placed before the sentinel-free ref paths as `emitNulIsNullTest` orders its niches, since the wrapper heap type is what distinguishes the families.
  const cnclw = nulCollWrapHeap(e.binLeft, fnIx)
  if cnclw >= 0 {
    return emitCoalesceNulRef(body, e, exprIx, cnclw, expCtxHere(ec), fnIx, ec)
  }
  // `<e> ?? d` over a `string | null` niche (an ident binding, a `string | null` struct field,
  // or a `(string | null)[]` element read): the cell is a `(ref null $sTypeIdx)`, so it takes
  // the same `br_on_non_null` core as the nullable struct/collections — one evaluation of the
  // place, and the narrow is the branch.

  // The lhs is read raw (`rawNullRead`) so an `array.get` stays nullable under every context,
  // and the default follows the block type (`coalesceNulStrArmCtx`). Ungated on
  // re-readability: the core evaluates the operand ONCE, so a CALL takes this arm too —
  // gated, it fell past every niche to a lowering with the wrong heap (D1763).
  if exprNullableString(e.binLeft, fnIx) {
    const rawCtx = expCtxHere(ec)
    rawCtx.rawNullRead = true
    const coNul = coalesceNulStrStaysNullable(exprIx, fnIx, ec)
    return emitCoalesceNulRefCtx(
      body,
      e,
      exprIx,
      sTypeIdx,
      coNul,
      rawCtx,
      coalesceNulStrArmCtx(coNul, ec),
      fnIx,
      ec,
    )
  }
  return emitCoalesceIdentBox(body, e, lhsIx, exprIx, fnIx, ec)
}

// The `emitCoalesceGo` arms over a re-readable boxed operand: a boolean-pop binding, a
// nullable value-union binding, and a nullable value-union list element. Returns what
// `emitCoalesceGo` returns.
function emitCoalesceIdentBox(
  body: u8[],
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const lhs = nodeAt(lhsIx)
  if lhs is Ident {
    if identNullableBoolPop(lhs.identName, fnIx) {
      return emitCoalesceBoolPop(body, e, fnIx, ec)
    }
    // `x ?? d` over a boxed value union containing `null` (`i32 | null`): the value-level dual
    // of the null guard — read the box tag; the null tag selects the default, anything else
    // unboxes the one remaining scalar atom (the host's `??` result is the non-null base
    // type). The receiver is a pure name, re-read in the non-null arm.
    const cunm = unionNameOfIdentAt(sidOfNode(lhsIx), fnIx, lhsIx)
    if cunm != "" {
      const cak = coalValUnionResidualKind(lhs.identName, lhsIx, cunm, fnIx)
      if cak >= 0 && cak != nullValKind() {
        return emitCoalesceValUnionIdent(
          body,
          e,
          lhs.identName,
          exprIx,
          cunm,
          cak,
          fnIx,
          ec,
        )
      }
    }
  }
  return emitCoalesceElemBox(body, e, lhsIx, exprIx, fnIx, ec)
}

// `x ?? d` over a binding seeded by a BOOLEAN-list `.pop()`: the i32 cell holds 0/1 or the
// niche sentinel 2 (`null`) — the same branching `if` the `boolean | null` arm uses, so the
// default runs only on the null path here too. Returns 0, or -1 when an operand fails.
function emitCoalesceBoolPop(
  body: u8[],
  e: BinExpr,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if emitExpr(body, e.binLeft, fnIx, ec) < 0 {
    return -1 // the niche i32
  }
  fbI32Const(2)
  fbI32Bin(70) // 0x46 i32.eq → x == 2 (null)
  fbIf(127)    // 0x04 if, 0x7f i32 blocktype
  if emitExpr(body, e.binRight, fnIx, ec) < 0 {
    return -1 // d, reached only on the null path
  }
  fbElse() // 0x05 else — present → the 0/1 cell, re-read
  if emitExpr(body, e.binLeft, fnIx, ec) < 0 { return -1 }
  fbEnd()  // 0x0b end
  0
}

// The banked ABI code of the one member left when `null` is removed from binding `name`'s
// value union `cunm` at node `lhsIx`, or -1 when `cunm` is not a value union holding `null`.
// A negative answer, or the null kind itself, means the arm declines.
function coalValUnionResidualKind(
  name: string,
  lhsIx: i32,
  cunm: string,
  fnIx: i32,
): i32 {
  // D-VALUNION resolves the declared union's set; the narrowing table's id below answers a
  // different question (the set surviving the narrow), so both stay resolved, and the null
  // test is a kind test over the banked codes.
  const csid = msSetOfNameTy(cunm, nodeTyAt(lhsIx, fnIx))
  if (
    !isValueUnionOfSet(csid, cunm)
    || !unionHasAtomK(csid, cunm, "null", nullValKind())
  ) {
    return -1
  }
  // D-SETID: the set arrives as the narrowing table's banked (row, mask) id, so the path from
  // narrowing table to ABI code never renders a set; the rendered residual is built only
  // where the bank declines — a narrowed subset spelling it never interned.
  let cak = unionResidualSoloKindOfSet(currentNarrowSetIdAt(name, fnIx, lhsIx))
  if cak == -2 {
    cak = valueAtomKind(
      removeAtomFromSet(
        currentNarrowSetAt(name, fnIx, lhsIx),
        "null",
        nodeTyIxOf(lhsIx),
      ),
    )
  }
  cak
}

// The union the `??` at `exprIx` boxes its result as, or "" when the checker typed it a scalar.
// A MIXED union (`i32 | A`) and a scalar joined to a literal union (`i32 | "a" | "b"`) are boxes
// too, named off the registry since their render is no value-union name. Tags are
// program-global, so a box operand stands in the join unchanged (D1703).
function coalResultBoxName(exprIx: i32, fnIx: i32): string {
  const rt = coalResultTyOf(exprIx, fnIx)
  const rn = valueUnionNameOfTy(rt)
  if rn != "" { return rn }
  const mn = nodeMixedUnionName(exprIx)
  if mn != "" { return mn }
  nodeJoinRowName(exprIx, fnIx)
}

// `x ?? d` over binding `name` of nullable value union `cunm`, whose residual member is kind
// `cak`: a box when the checker typed the `??` as a union, else the scalar at the result's
// kind. Returns 0, or -1 when an operand fails or the residual is a string.
function emitCoalesceValUnionIdent(
  body: u8[],
  e: BinExpr,
  name: string,
  exprIx: i32,
  cunm: string,
  cak: i32,
  fnIx: i32,
  ec: ExpCtx,
): i32 {
  if cak == 2 {
    return emitFail(
      "emitProgram: `??` over a string|null union is not supported yet",
    )
  }
  // The result is a BOX exactly when the checker typed this `??` as a union — a
  // nullable default keeps `T | null`, another type joins to `T | U`. The default is
  // coerced into the RESULT union, not the operand's, which has no tag for it; the
  // operand's own box needs none, tags being global atom codes (D1699).
  const cResN = coalResultBoxName(exprIx, fnIx)
  if cResN != "" || coalesceDefaultNullable(e.binRight, fnIx) {
    let cCoerceN = cResN
    let cCoerceTy = coalResultTyOf(exprIx, fnIx)
    if cCoerceN == "" {
      cCoerceN = cunm
      cCoerceTy = nodeTyIxOf(unwrapParen(e.binLeft))
    }
    if emitExpr(body, e.binLeft, fnIx, ec) < 0 {
      return -1 // the box
    }
    fbStructGet(uBoxIdx, 0) // field 0: tag
    fbI32Rel(RS_TAG, nullBoxTag())
    fbI32Bin(70)            // 0x46 i32.eq → null?
    fbIfRef(uBoxIdx)        // 0x04 if, (ref $uBoxIdx) blocktype
    // Through `emitUnionCoerce`, not `emitExpr` (D801): the block type is the box, so a bare
    // `null` default, which has no rep of its own, arrives as the null-tagged box the coerce's
    // `NullLit` arm builds; every non-null default passes through unchanged.
    if emitUnionCoerce(body, cCoerceN, cCoerceTy, e.binRight, fnIx, ec) < 0 {
      return -1 // d, its own box
    }
    fbElse() // 0x05 else — present → the LHS box, re-read
    if emitExpr(body, e.binLeft, fnIx, ec) < 0 { return -1 }
    fbEnd()  // 0x0b end
    return 0
  }
  // The result kind is the CHECKER's, not the operand's residual: a wider default
  // widens the whole `??` (`i32 | null ?? 1.5` is an f64), and the block type has to be
  // that. `cak` still drives the unbox, since the box holds the operand's own atom;
  // the widen below carries it up to the result (D1699).
  let cRk = cak
  const cRkN = boxTagOfTy(coalResultTyOf(exprIx, fnIx))
  if cRkN >= 0 && cRkN != nullValKind() { cRk = cRkN }
  if emitExpr(body, e.binLeft, fnIx, ec) < 0 {
    return -1 // the box
  }
  fbStructGet(uBoxIdx, 0)       // field 0: tag
  fbI32Rel(RS_TAG, nullBoxTag())
  fbI32Bin(70)                  // 0x46 i32.eq → null?
  fbIf(valBlockTypeOfKind(cRk)) // 0x04 if, value blocktype
  if emitExprAsKind(body, e.binRight, cRk, fnIx, ec) < 0 { return -1 }
  fbElse()                      // 0x05 else — present → unbox at the banked code `cak`
  if emitValueUnionUnboxRead(body, name, cak, fnIx, ec) < 0 { return -1 }
  if coalWidenUnboxed(cak, cRk) < 0 { return -1 }
  fbEnd()                       // 0x0b end
  0
}

// A nullable value-union BOX operand whose `??` result is the bare scalar rather than another
// box: a `(i32 | null)[]` ELEMENT is the box, so `x ?? d` yields the element's own rep, asked
// of the REP. Stash once, test the tag, unbox on the present arm (D1828); any other operand
// goes on to `emitCoalesceCallStash`. Returns what `emitCoalesceGo` returns.
function emitCoalesceElemBox(
  body: u8[],
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // Ahead of the call-stash arm, which claims a `.get(i)` by SYNTAX: the `.get` spelling of
  // an element read belongs to this arm, not to a value-union-returning call (D1829).

  // Bounded to a list ELEMENT read on purpose. A struct FIELD whose literal merged onto a
  // declared row of another code has a rep the storage does not honour, and unboxing it there
  // would trade D1411's loud refusal for invalid wasm.
  const nbRep = repOfNode(e.binLeft, fnIx)
  if (
    isListElementRead(e.binLeft, fnIx)
    && nbRep.rdKind == "union"
    && nbRep.rdNul == 4
  ) {
    // The box holds the element's own atom, unboxed at that kind and widened to the result's,
    // which a wider default makes wider (D3795). The result is read at the instance's pin,
    // since a generic body records its `??` at the hole (D3744).
    const nbKind = boxTagOfTy(coalResultTyOf(exprIx, fnIx))
    const nbElem = boxTagOfTy(nonNullTy(nodeTyIxOf(e.binLeft)))
    const nbVt = nulBoxScalarValtype(nbKind)
    const nbVb = vbHeapIdxOfKind(nbElem)
    if (
      nbVt >= 0
      && nbVb >= 0
      && nulBoxScalarValtype(nbElem) >= 0
      && scalarKindWidens(nbElem, nbKind)
    ) {
      const nbSlot = sharedFieldRecvSlot()
      if emitExpr(body, e.binLeft, fnIx, ec) < 0 { return -1 }
      fbLocalSet(nbSlot)
      // Present = a box is there AND its tag is not the null tag. A `.get` miss yields no box
      // at all, so its test short-circuits on `ref.is_null` and the tag read never runs on a
      // null; a subscript traps out of range and keeps the one-test shape it always had.
      if isListGetCall(e.binLeft, fnIx) {
        fbLocalGet(nbSlot)
        fbRefIsNull()
        fbIf(127)
        fbI32Const(0)
        fbElse()
        fbLocalGet(nbSlot)
        fbStructGet(uBoxIdx, 0) // field 0: tag
        fbI32Rel(RS_TAG, nullBoxTag())
        fbI32Bin(71) // 0x47 i32.ne
        fbEnd()
      } else {
        fbLocalGet(nbSlot)
        fbStructGet(uBoxIdx, 0) // field 0: tag
        fbI32Rel(RS_TAG, nullBoxTag())
        fbI32Bin(71) // 0x47 i32.ne — present?
      }
      fbIf(nbVt)
      fbLocalGet(nbSlot)
      fbStructGet(uBoxIdx, 1) // field 1: the payload anyref
      fbRefCast(nbVb)
      fbStructGet(nbVb, 0)
      emitScalarWiden(nbElem, nbKind)
      fbElse()
      if emitCoalesceScalarDefault(body, e.binRight, nbKind, fnIx, ec) < 0 {
        return -1
      }
      fbEnd()
      return 0
    }
  }
  return emitCoalesceCallStash(body, e, lhsIx, exprIx, fnIx, ec)
}

// The `emitCoalesceGo` arms over an operand that cannot be re-read (a call, an `as?` or an
// if-expression yielding a box): each stashes its one evaluation in a coalesce slot.
// Returns what `emitCoalesceGo` returns.
function emitCoalesceCallStash(
  body: u8[],
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const lhs = nodeAt(lhsIx)
  // `f(x) ?? d` over a call returning a value union with `null`: a call cannot be re-evaluated
  // (effects and cost), so stash the box once in the coalesce-call slot, then test the tag and
  // unbox off that single evaluation. Scalar atoms only (the value-typed `if` blocktype); one
  // slot is sound across nesting since each `??` sets-tests-uses within its own evaluation.

  // An `as?` yielding a box is the same shape (D1041), and an if-expression operand is a third
  // — all three name an operand that cannot be re-read (re-reading an `as?` re-runs the
  // exactness test). The gate widens rather than adding a second arm, since the lowering reads
  // only `unionNameOfExpr` and the box — the same predicate `coalChainHasCallLhs` reserves the slot on.
  if (
    lhs is Call
    || ((lhs is AsExpr || lhs is IfStmt)
      && (tyIsNulValueUnionBox(nodeTyIxOf(lhsIx)) || nodeTyIsNulScalarBox(lhsIx)))
  ) {
    const kunm = unionNameOfExpr(e.binLeft, fnIx)
    if kunm != "" {
      // D-VALUNION + D-SETONCE: one resolution feeds the value-union gate AND the
      // residual code below, which master resolved a second time inside
      // `unionResidualSoloKindOfSet`.
      const ksid = msSetOfNameTy(kunm, nodeTyIxOf(lhsIx))
      if (
        isValueUnionOfSet(ksid, kunm)
        && unionHasAtomK(ksid, kunm, "null", nullValKind())
      ) {
        // D-union-atom-kind — see `unionResidualSoloKindOfSet`.
        let kak = unionResidualSoloKindOfSet(ksid)
        if kak == -2 {
          kak = valueAtomKind(
            removeAtomFromSet(kunm, "null", nodeTyIxOf(lhsIx)),
          ) // D-RESIDUE
        }
        if kak >= 0 && kak != nullValKind() {
          if kak == 2 {
            return emitFail(
              "emitProgram: `??` over a string|null call result is not supported yet",
            )
          }
          // D1250 — an if-expression operand arrives through `emitUnionCoerce`, not
          // `emitExpr`. `emitIfExpr` picks the join's blocktype off the arms' scalar ladder,
          // so a `T | null` if-expression came back as a bare i32; the coerce's own `IfStmt`
          // arm (`emitUnionIfValue`) makes the blocktype the box, with a missing else as the null-tagged arm.
          if (
            emitUnionCoerce(body, kunm, nodeTyIxOf(lhsIx), e.binLeft, fnIx, ec)
            < 0
          ) {
            return -1 // the box, evaluated ONCE
          }
          fbLocalSet(coalesceCallSlot)
          // The result rep is the CHECKER's, read exactly as the re-evaluating ident arm reads
          // it: a union result is a box whatever made it one, a wider default widens the whole
          // expression. Both arms are one lowering over one rep and must decide alike (D1701).
          const kResN = coalResultBoxName(exprIx, fnIx)
          const kResTy = coalResultTyOf(exprIx, fnIx)
          let kRk = kak
          const kRkN = boxTagOfTy(kResTy)
          if kRkN >= 0 && kRkN != nullValKind() { kRk = kRkN }
          // A union result keeps the box — the default is coerced into the RESULT union, and
          // the stash already holds the operand's, whose tags are program-global.
          if kResN != "" || coalesceDefaultNullable(e.binRight, fnIx) {
            let kCoerceN = kResN
            let kCoerceTy = kResTy
            if kCoerceN == "" {
              kCoerceN = kunm
              kCoerceTy = nodeTyIxOf(lhsIx)
            }
            fbLocalGet(coalesceCallSlot)
            fbStructGet(uBoxIdx, 0) // field 0: tag
            fbI32Rel(RS_TAG, nullBoxTag())
            fbI32Bin(70)            // 0x46 i32.eq → null?
            fbIfRef(uBoxIdx)        // 0x04 if, (ref $uBoxIdx) blocktype
            // THROUGH `emitUnionCoerce` — the same D801 seed the ident arm above takes,
            // and taken here for the reason this arm and that one share every other
            // decision: one lowering over one rep, so a bare `null` default must box
            // identically at both spellings.
            if (
              emitUnionCoerce(body, kCoerceN, kCoerceTy, e.binRight, fnIx, ec)
              < 0
            ) {
              return -1 // d, its own box
            }
            fbElse() // 0x05 else — present → the stashed box
            fbLocalGet(coalesceCallSlot)
            fbEnd()  // 0x0b end
            return 0
          }
          fbLocalGet(coalesceCallSlot)
          fbStructGet(uBoxIdx, 0)       // field 0: tag
          fbI32Rel(RS_TAG, nullBoxTag())
          fbI32Bin(70)                  // 0x46 i32.eq → null?
          fbIf(valBlockTypeOfKind(kRk)) // 0x04 if, value blocktype
          if emitExprAsKind(body, e.binRight, kRk, fnIx, ec) < 0 { return -1 }
          fbElse()                      // 0x05 else — present → unbox the stash
          fbLocalGet(coalesceCallSlot)
          fbStructGet(uBoxIdx, 1)       // field 1: value (anyref)
          const kvb = vbHeapIdxOfKind(kak)
          if kvb < 0 {
            return emitFail("emitProgram: union call atom has no value box")
          }
          fbRefCast(kvb)
          fbStructGet(kvb, 0) // the scalar payload
          if coalWidenUnboxed(kak, kRk) < 0 { return -1 }
          fbEnd()             // 0x0b end
          return 0
        }
      }
    }
    // `f() ?? d` over a CALL returning `boolean | null` (the i32 niche): a call cannot be
    // re-read, so STASH the single evaluation in the bool slot, then branch on the sentinel
    // 2 — the call analogue of the `boolean | null` ident path, and the default runs only on
    // the null path for the same reason.
    if exprNulBool(e.binLeft, fnIx) {
      if emitExpr(body, e.binLeft, fnIx, ec) < 0 {
        return -1 // the niche i32, evaluated ONCE
      }
      fbLocalSet(coalesceCallBoolSlot)
      fbLocalGet(coalesceCallBoolSlot)
      fbI32Const(2)
      fbI32Bin(70) // 0x46 i32.eq → x == 2 (null)
      fbIf(127)    // 0x04 if, 0x7f i32 blocktype
      if emitExpr(body, e.binRight, fnIx, ec) < 0 {
        return -1 // d, reached only on the null path
      }
      fbElse() // 0x05 else — present → the stashed 0/1 cell
      fbLocalGet(coalesceCallBoolSlot)
      fbEnd()  // 0x0b end
      return 0
    }
    // `f() ?? d` over a CALL returning `string | null` (kind 16): STASH the nullable
    // ref once (raw, via `ec.rawNullRead`), then a value-typed `if` on
    // `ref.is_null` selects `d` or the recovered non-null string — the call analogue
    // of the `string | null` ident path.
    if exprNullableString(e.binLeft, fnIx) {
      const rawCCtx = expCtxHere(ec)
      rawCCtx.rawNullRead = true
      // the raw nullable ref, ONCE
      if emitExprExpect(body, e.binLeft, fnIx, rawCCtx) < 0 { return -1 }
      fbLocalSet(coalesceCallStrSlot)
      fbLocalGet(coalesceCallStrSlot)
      fbRefIsNull() // → 1 if null
      // The SAME result-nullability question the re-evaluating arm asks — see
      // `coalesceNulStrStaysNullable`. A nullable default keeps the result nullable here too.
      const coNulC = coalesceNulStrStaysNullable(exprIx, fnIx, ec)
      fbIfRefNul(sTypeIdx, coNulC)
      // Each arm reads UNDER the block type just declared (the re-evaluating arm's
      // discipline): the default is raw only when the result is nullable, and the stashed
      // LHS is non-null on every path that reaches the else (`ref.is_null` said no).
      if (
        emitExprExpect(body, e.binRight, fnIx, coalesceNulStrArmCtx(coNulC, ec))
        < 0
      ) {
        return -1 // d (a string, nullable only when the block is)
      }
      fbElse()         // 0x05 else
      fbLocalGet(coalesceCallStrSlot)
      fbRefAsNonNull() // 0xd4 recover the non-null string the slot holds
      fbEnd()          // 0x0b end
      return 0
    }
  }
  return emitCoalesceUnionField(body, e, lhsIx, exprIx, fnIx, ec)
}

// The variant row the receiver of the field read `memIx` is narrowed to when that receiver is
// a union box, or -1: the pairing `emitMem` reads through `emitNarrowedMem`.
function coalNarrowedBoxArm(memIx: i32, fnIx: i32): i32 {
  const m = nodeAt(memIx)
  if !(m is Member) || !memIsNarrowed(memIx) { return -1 }
  const vi = memNarrowVariantIndex(memIx)
  if vi < 0 || !exprUnion(m.memObj, fnIx) { return -1 }
  vi
}

// The `emitCoalesceGo` arm over a value-union record field `o.v ?? d`, then the rest of the
// ladder. Returns what `emitCoalesceGo` returns.
function emitCoalesceUnionField(
  body: u8[],
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const lhs = nodeAt(lhsIx)
  // `o.v ?? d` over a value-union struct field (`v: i32 | null`, code 16): the field-read dual
  // of the boxed-union name path above — read the box off the field, test its tag for `null`,
  // and select the default or the unboxed single remaining scalar atom. The receiver re-reads
  // in the non-null arm (a name/field chain, like the nullable-struct `?.` path).
  if lhs is Member {
    // The receiver is a struct row or a union arm; an arm's field reads off its own heap
    // type exactly as a row's does (D4667).
    let mHeap = -1
    let mfi = -1
    let mphys = ""
    let mCast = -1
    // A box receiver narrowed to one arm is unwrapped to that arm, asked ahead of the row as
    // `emitMem` asks it: an index place is typed at the arm, so `structIndexOfExpr` answers
    // for a ref it does not hold (D8145). A null-tested nullable arm is asserted non-null.
    let mvi = coalNarrowedBoxArm(lhsIx, fnIx)
    if mvi >= 0 { mCast = uVarHeap[mvi] }
    const msi = if mvi >= 0 { -1 } else { structIndexOfExpr(lhs.memObj, fnIx) }
    if msi >= 0 {
      mfi = sFieldIndex(msi, lhs.memProp)
      if mfi >= 0 && sFieldTypeAt(msi, mfi) == FC_UNION {
        mHeap = sHeapIdx[msi]
        mphys = sFieldElemNameAt(msi, mfi)
      }
    } else {
      if mvi < 0 { mvi = exprVariantIndex(lhs.memObj, fnIx) }
      if mvi < 0 {
        mvi = nulVariantIdxOfExpr(lhs.memObj, fnIx)
        if mvi >= 0 { mCast = -2 }
      }
      if mvi >= 0 {
        mfi = variantFieldIndex(mvi, lhs.memProp)
        if mfi >= 0 && variantFieldTypeAt(mvi, mfi) == FC_UNION {
          mHeap = uVarHeap[mvi]
          mphys = variantFieldElemName(mvi, mfi)
        }
      }
    }
    if mHeap >= 0 {
      // A wider record's box is read at the receiver's own member set (D3006).
      if memReadBoxAmbiguous(lhsIx, fnIx) { return emitBoxAmbiguousFail(lhsIx) }
      let munm = memReadBoxNarrowName(lhsIx, fnIx)
      if munm == "" { munm = mphys }
      // D-VALUNION + D-SETONCE — see the call arm above.
      const msid = msSetOfNameTy(munm, nodeTyAt(lhsIx, fnIx))
      if (
        isValueUnionOfSet(msid, munm)
        && unionHasAtomK(msid, munm, "null", nullValKind())
      ) {
        // D-union-atom-kind — see `unionResidualSoloKindOfSet`.
        let mak = unionResidualSoloKindOfSet(msid)
        if mak == -2 {
          mak = valueAtomKind(
            removeAtomFromSet(munm, "null", nodeTyIxOf(lhsIx)),
          ) // D-RESIDUE
        }
        if mak >= 0 && mak != nullValKind() {
          if mak == 2 {
            return emitFail(
              "emitProgram: `??` over a string|null union field is not supported yet",
            )
          }
          // A union result or a NULLABLE default keeps the result boxed — the SAME decision
          // the ident and call arms make; the else arm re-reads the field's own box rather
          // than unboxing it, and the default is coerced into the result's union.
          const mResN = coalResultBoxName(exprIx, fnIx)
          if mResN != "" || coalesceDefaultNullable(e.binRight, fnIx) {
            let mCoerceN = mResN
            let mCoerceTy = coalResultTyOf(exprIx, fnIx)
            if mCoerceN == "" {
              mCoerceN = munm
              mCoerceTy = nodeTyIxOf(lhsIx)
            }
            if emitCoalArmRecv(body, lhs.memObj, mCast, fnIx, ec) < 0 {
              return -1
            }
            fbStructGet(mHeap, mfi) // the union box
            fbStructGet(uBoxIdx, 0) // field 0: tag
            fbI32Rel(RS_TAG, nullBoxTag())
            fbI32Bin(70)            // 0x46 i32.eq → null?
            fbIfRef(uBoxIdx)        // 0x04 if, (ref $uBoxIdx) blocktype
            // THROUGH `emitUnionCoerce` — the D801 seed, the third of the three
            // boxed-union `??` spellings that share this lowering.
            if (
              emitUnionCoerce(body, mCoerceN, mCoerceTy, e.binRight, fnIx, ec)
              < 0
            ) {
              return -1 // d, its own box
            }
            fbElse() // 0x05 else — present → re-read the field
            if emitCoalArmRecv(body, lhs.memObj, mCast, fnIx, ec) < 0 {
              return -1
            }
            fbStructGet(mHeap, mfi)
            if munm != mphys {
              if emitBoxAtomRetag(mphys, munm, lhsIx) < 0 { return -1 }
            }
            fbEnd() // 0x0b end
            return 0
          }
          // The result kind is the checker's, as at the ident and call arms: a wider default
          // widens the whole `??` (D1699, D10060).
          let mRk = mak
          const mRkN = boxTagOfTy(coalResultTyOf(exprIx, fnIx))
          if mRkN >= 0 && mRkN != nullValKind() { mRk = mRkN }
          if emitCoalArmRecv(body, lhs.memObj, mCast, fnIx, ec) < 0 {
            return -1
          }
          fbStructGet(mHeap, mfi)       // the union box
          fbStructGet(uBoxIdx, 0)       // field 0: tag
          fbI32Rel(RS_TAG, nullBoxTag())
          fbI32Bin(70)                  // 0x46 i32.eq → null?
          fbIf(valBlockTypeOfKind(mRk)) // 0x04 if, value blocktype
          if emitExprAsKind(body, e.binRight, mRk, fnIx, ec) < 0 { return -1 }
          fbElse()                      // 0x05 else — present → unbox
          if emitCoalArmRecv(body, lhs.memObj, mCast, fnIx, ec) < 0 {
            return -1
          }
          fbStructGet(mHeap, mfi)
          if munm != mphys {
            if emitBoxAtomRetag(mphys, munm, lhsIx) < 0 { return -1 }
          }
          fbStructGet(uBoxIdx, 1) // field 1: value (anyref)
          const mvb = vbHeapIdxOfKind(mak)
          if mvb < 0 {
            return emitFail("emitProgram: union field atom has no value box")
          }
          fbRefCast(mvb)
          fbStructGet(mvb, 0) // the scalar payload
          if coalWidenUnboxed(mak, mRk) < 0 { return -1 }
          fbEnd()             // 0x0b end
          return 0
        }
      }
    }
  }
  return emitCoalesceOptMember(body, e, lhsIx, exprIx, fnIx, ec)
}

// `xs.get(i)?.f ?? d` over a ref list whose element row is `gSi` (heap `gHeap`): one bounds
// compare, then the field off the in-range element or the default. Returns -1 on a failure,
// else 0.
function emitCoalesceOptListGet(
  body: u8[],
  e: BinExpr,
  lhs: OptMember,
  omGet: Call,
  gCallee: Member,
  gSi: i32,
  gHeap: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if omGet.callArgs.length != 1 {
    return emitFail(
      "emitProgram: internal: .get reached with the wrong argument count — the checker's arity rule refuses it",
    )
  }
  const gFi = sFieldIndex(gSi, lhs.omProp)
  if gFi < 0 {
    return emitFail(
      "emitProgram: `?.` field is not on the list's element struct",
    )
  }
  if sFieldTypeAt(gSi, gFi) != FC_I32 {
    return emitFail(
      "emitProgram: `?.` over a list .get supports only i32/boolean fields",
    )
  }
  const gSlot = refListSlotOfExpr(gCallee.memObj, fnIx)
  if gSlot < 0 { return refListRowRefused(gCallee.memObj) }
  // The same two operands, emitted twice each below — staged, not refused (D1677).
  listGetStageMark(unwrapParen(lhs.omObj))
  // cond: idx u< len
  if emitListGetIdx(body, omGet.callArgs[0], fnIx, ec) < 0 { return -1 }
  const gWrap = rlWrapIdx[gSlot]
  if emitListGetRecv(body, gCallee.memObj, fnIx, gWrap, ec) < 0 { return -1 }
  fbStructGet(rlWrapIdx[gSlot], 1) // field 1: len
  fbI32Bin(73)                     // 0x49 i32.lt_u
  fbIf(127)                        // 0x04 if, 0x7f i32 result blocktype
  if emitListGetRecv(body, gCallee.memObj, fnIx, gWrap, ec) < 0 { return -1 }
  fbStructGet(gWrap, 0)            // field 0: backing
  if emitListGetIdx(body, omGet.callArgs[0], fnIx, ec) < 0 { return -1 }
  fbArrayGet(rlBackIdx[gSlot])     // → (ref null $elem)
  fbRefAsNonNull()                 // a live in-range element is non-null
  fbStructGet(gHeap, gFi)          // .f
  fbElse()                         // 0x05 else
  if emitExpr(body, e.binRight, fnIx, ec) < 0 { return -1 }
  fbEnd()                          // 0x0b end
  return 0
}

// `p?.f ?? d` over a nullable receiver whose record row is `nsi` (heap `nHeap`): null selects
// the default, else the field. Returns what `emitCoalesceGo` returns.
function emitCoalesceOptNulRecord(
  body: u8[],
  e: BinExpr,
  lhs: OptMember,
  nsi: i32,
  nHeap: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const nfi = sFieldIndex(nsi, lhs.omProp)
  if nfi < 0 { return emitFail("emitProgram: `?.` field is not on the struct") }
  // The blocktype is the whole restriction, and it is not one rep wide. Both arms of
  // this `if` yield the field's rep, so it needs a blocktype spelling it —
  // `fbIfForSharedField` already owns this over the same `sFieldTypeAt` codes for the
  // shared-union-field dispatch. Hard-coding `fbIf(127)` refused `f64`/`i64`/`f32`/`string` fields here while the narrowed spelling ran fine at every one of them.
  const nfCode = sFieldTypeAt(nsi, nfi)
  // A nested-struct field (code 15) spells its `if` result from the field's own target
  // row, which `fbIfForSharedField` cannot give from a code alone. Two null tests, not
  // one: a code-15 slot is `(ref null $S)` at both declarations (D1180), and `o?.f ??
  // d` must yield `d` when the field is null too — receiver-null or field-null, short-circuited through one i32 `if` so `struct.get` never runs on a null receiver.
  if nfCode == FC_STRUCT {
    const ntg = sFieldTgtStructIdx(nsi, nfi)
    if ntg < 0 {
      return emitFail(
        "emitProgram: `?.` over a nested-struct field names no struct row",
      )
    }
    const nDefNul = coalesceDefaultNullable(e.binRight, fnIx)
    if emitOptRecvBase(body, lhs.omObj, fnIx, false, ec) < 0 { return -1 }
    fbRefIsNull() // the receiver
    fbIf(127)
    fbI32Const(1)
    fbElse()
    if emitOptRecvBase(body, lhs.omObj, fnIx, true, ec) < 0 { return -1 }
    fbStructGet(nHeap, nfi)
    fbRefIsNull() // the field slot
    fbEnd()
    fbIfRefNul(sHeapIdx[ntg], nDefNul)
    if emitExpr(body, e.binRight, fnIx, ec) < 0 { return -1 }
    fbElse()
    if emitOptRecvBase(body, lhs.omObj, fnIx, true, ec) < 0 { return -1 }
    fbStructGet(nHeap, nfi)
    if !nDefNul { fbRefAsNonNull() }
    fbEnd()
    return 0
  }
  if nfCode == FC_UNION {
    return emitOptCoalesceBoxLeaf(body, e, lhs, nHeap, nfi, exprIx, fnIx, ec)
  }
  if !optChainFieldCodeOk(nfCode) {
    return emitFail(
      "emitProgram: `?.` over a nullable struct has no `if` blocktype for this field's rep",
    )
  }
  if emitOptRecvBase(body, lhs.omObj, fnIx, false, ec) < 0 { return -1 }
  fbRefIsNull()
  fbIfForSharedField(nfCode) // if (result <the field's own rep>)
  if emitOptChainDefault(body, e.binRight, nfCode, fnIx, ec) < 0 { return -1 }
  fbElse()                   // 0x05 else — present → the field
  if emitOptRecvBase(body, lhs.omObj, fnIx, true, ec) < 0 { return -1 }
  fbStructGet(nHeap, nfi)
  fbEnd()                    // 0x0b end
  return 0
}

// `p?.f ?? d` over a receiver typed `Arm | null`, laid out at variant row `nvi` rather than a
// struct row: a hole instance's pin reaches it, where the rewrite that guards a concrete one
// reads the shared node (D3215). A field whose rep has an `if` blocktype only.
function emitCoalesceOptNulVariant(
  body: u8[],
  e: BinExpr,
  lhs: OptMember,
  nvi: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if nvi < 0 || nvi >= uVarHeap.length {
    return emitFail("emitProgram: `?.` receiver has no union arm row")
  }
  const vfi = variantFieldIndex(nvi, lhs.omProp)
  if vfi < 0 {
    return emitFail("emitProgram: `?.` field is not on the union arm")
  }
  const vCode = variantFieldTypeAt(nvi, vfi)
  if !optChainFieldCodeOk(vCode) {
    return emitFail(
      "emitProgram: `?.` over a nullable union arm has no `if` blocktype for this field's rep",
    )
  }
  if emitOptRecvBase(body, lhs.omObj, fnIx, false, ec) < 0 { return -1 }
  fbRefIsNull()
  fbIfForSharedField(vCode)
  if emitOptChainDefault(body, e.binRight, vCode, fnIx, ec) < 0 { return -1 }
  fbElse()
  if emitOptRecvBase(body, lhs.omObj, fnIx, false, ec) < 0 { return -1 }
  fbRefCast(uVarHeap[nvi])
  fbStructGet(uVarHeap[nvi], vfi)
  fbEnd()
  0
}

// `m[k]?.f ?? d` over a map whose value row is `omSl`: probe, then the field off the hit's
// value or the default. Returns -1 on a failure, else 0.
function emitCoalesceOptMapField(
  body: u8[],
  e: BinExpr,
  lhs: OptMember,
  omInner: Index,
  omSl: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  if mvValKind[omSl] != MVK_STRUCT {
    return emitFail("emitProgram: `?.` needs a struct-valued map")
  }
  // The variant half of the value row, the same either/or the store seed and the `??`
  // default seed have carried since D34. `mvValStructIdx` is -1 for an arm-valued map
  // (`collectS` skips a union member), so this site needs `variantFieldIndex` /
  // `variantFieldTypeAt` / `uVarHeap` — arm-for-arm twins of the struct accessor beside it, since a missing branch answered -1 and blamed the wrong field.
  let omHeap = -1
  let omFi = -1
  let omCode = -1
  // …through the layout identity (D123), the same read the store and `??`
  // default seeds take: the field lookup must run against the row whose heap the
  // vals element holds.
  const omVi = mvValVariantOf(omSl)
  if omVi >= 0 {
    omFi = variantFieldIndex(omVi, lhs.omProp)
    if omFi >= 0 {
      omHeap = uVarHeap[omVi]
      omCode = variantFieldTypeAt(omVi, omFi)
    }
  } else {
    const omSi = mvValStructIdxOf(omSl)
    // `sFieldIndex` bounds its own index (a row of -1 answers -1), so the heap read
    // below is reached only for a row that named the field.
    omFi = sFieldIndex(omSi, lhs.omProp)
    if omFi >= 0 {
      if omSi < 0 { return -1 }
      omHeap = sHeapIdx[omSi]
      omCode = sFieldTypeAt(omSi, omFi)
    }
  }
  if omFi < 0 {
    return emitFail("emitProgram: `?.` field is not on the map's value struct")
  }
  if omCode != FC_I32 {
    return emitFail(
      "emitProgram: `?.` over a map read supports only i32/boolean fields",
    )
  }
  if emitMapPrep(body, omInner.idxArr, omInner.idxIndex, fnIx, ec) < 0 {
    return -1
  }
  pushMapScr(body, 5)          // entry
  fbIf(127)                    // if (entry != 0 → hit), i32 blocktype
  pushMapVals(body)
  fbStructGet(cmValsWrap(), 0) // vals backing
  pushMapScr(body, 5)          // entry
  fbI32Const(1)
  fbI32Bin(107)                // i32.sub (entry - 1)
  fbArrayGet(cmValsBack())     // (ref null <value struct>)
  fbRefAsNonNull()             // a live entry's value is non-null
  fbStructGet(omHeap, omFi)    // .f — the arm's `uVarHeap` row or the struct's
  fbElse()                     // else
  if emitExpr(body, e.binRight, fnIx, ec) < 0 { return -1 }
  fbEnd()                      // end (if)
  return 0
}

// The `emitCoalesceGo` arms over an optional-chain operand `?.f ?? d`: a map read, a
// nullable record, a nested chain and a list `.get`. Returns what `emitCoalesceGo` returns.
function emitCoalesceOptMember(
  body: u8[],
  e: BinExpr,
  lhsIx: i32,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  const lhs = nodeAt(lhsIx)
  // The null-safe field read `m[k]?.f ?? d` over a struct-valued map is the fused form: probe;
  // on a hit read the field off the (non-null) value struct, else push the default. A live
  // entry's value slot is never null, so the `?.` null test coincides with the probe's hit
  // test. Scalar (i32/boolean) fields only (a value-typed `if` blocktype carries them).
  if lhs is OptMember {
    const omInner = nodeAt(lhs.omObj)
    if omInner is Index {
      if exprMap(omInner.idxArr, fnIx) {
        const omSl = mapShapeOfExpr(omInner.idxArr, fnIx)
        if omSl >= 0 {
          return emitCoalesceOptMapField(body, e, lhs, omInner, omSl, fnIx, ec)
        }
      }
    }
    // `p?.f ?? d` over a nullable-struct receiver (`p: S | null`, or a nullable-struct field
    // read `n.next`): null selects the default, else the field read off the (non-null) struct.
    // The receiver is read two or three times here, from `optRecvSlot` when it is a call and
    // in place when it is a name. Scalar fields only (the value-typed `if` blocktype).
    if exprNullableStruct(lhs.omObj, fnIx) {
      const nsi = structIndexOfExpr(lhs.omObj, fnIx)
      if nsi >= 0 {
        return emitCoalesceOptNulRecord(
          body,
          e,
          lhs,
          nsi,
          sHeapIdx[nsi],
          exprIx,
          fnIx,
          ec,
        )
      }
    }
    const nvi = nulVariantIdxOfExpr(lhs.omObj, fnIx)
    if nvi >= 0 {
      return emitCoalesceOptNulVariant(body, e, lhs, nvi, fnIx, ec)
    }
    // A nested optional chain `o?.inner?.v ?? d` (niche nullable links): any null link selects
    // the default; otherwise the chain reads through non-null refs (each `S | null` link
    // recovers `ref.as_non_null`). The links are effect-free places, re-evaluated in the value
    // arm. Scalar (i32/boolean) leaf fields only (the value-typed `if` blocktype).
    const omDeep = nodeAt(unwrapParen(lhs.omObj))
    if omDeep is OptMember {
      const dsi = optChainStructIdxOf(lhs.omObj, fnIx)
      if dsi >= 0 {
        const dfi = sFieldIndex(dsi, lhs.omProp)
        if dfi >= 0 {
          if sFieldTypeAt(dsi, dfi) != FC_I32 {
            return emitFail(
              "emitProgram: `?.` chain supports only i32/boolean leaf fields",
            )
          }
          if emitOptChainIsNull(body, lhs.omObj, fnIx, ec) < 0 { return -1 }
          fbIf(127) // 0x04 if, i32 result — a null link → default
          if emitExpr(body, e.binRight, fnIx, ec) < 0 { return -1 }
          fbElse()  // 0x05 else — every link present → the leaf
          if emitOptChainValue(body, lhs.omObj, fnIx, ec) < 0 { return -1 }
          fbStructGet(sHeapIdx[dsi], dfi)
          fbEnd()   // 0x0b end
          return 0
        }
      }
    }
    // `xs.get(i)?.f ?? d` over a struct-element ref list is the fused form: one bounds
    // compare; in range read the field off the (non-null) element, else the default. A live
    // in-range element is never null, so the `?.` null test coincides with the bounds test —
    // mirroring the map `m[k]?.f ?? d` path above. Scalar fields only.
    const omGet = nodeAt(unwrapParen(lhs.omObj))
    if omGet is Call {
      if omGet.callFn < 0 { return -1 }
      const gCallee = nodeAt(omGet.callFn)
      if gCallee is Member {
        if gCallee.memProp == "get" {
          const gSi = structListPopGetElem(unwrapParen(lhs.omObj), fnIx)
          if gSi >= 0 && rlUsed {
            return emitCoalesceOptListGet(
              body,
              e,
              lhs,
              omGet,
              gCallee,
              gSi,
              sHeapIdx[gSi],
              fnIx,
              ec,
            )
          }
        }
      }
    }
  }
  return emitCoalesceNullableRefs(body, e, exprIx, fnIx, ec)
}

// The last `emitCoalesceGo` arms, the nullable-ref cores (a union arm, a record, a value-union
// box, a map), and the refusal for any other nullable operand. Returns what
// `emitCoalesceGo` returns.
function emitCoalesceNullableRefs(
  body: u8[],
  e: BinExpr,
  exprIx: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  // The variant sibling of the arm below, its own arm rather than a widening of it: a `T |
  // null` whose `T` is a union arm stores `(ref null $uVarHeap[vi])`, and
  // `structIndexOfExpr` has no row to answer with (`collectS` skips a union member). Same
  // niche, same `br_on_non_null` lowering, one table over.
  const cvi = nulVariantIdxOfExpr(e.binLeft, fnIx)
  if cvi >= 0 {
    if cvi < uVarHeap.length {
      return emitCoalesceNulRef(
        body,
        e,
        exprIx,
        uVarHeap[cvi],
        expCtxHere(ec),
        fnIx,
        ec,
      )
    }
  }
  // Generic nullable-struct `??`: a `S | null` value (ident/param binding, struct field, or
  // closure/factory call) coalesced with a struct default. Evaluated once: `br_on_non_null`
  // keeps the non-null struct or falls to the default, needing neither a re-eval nor a
  // per-struct stash — `structIndexOfExpr` resolves the inner struct for the block's result type, including an indexed closure-array/factory call via the checker-type fallback.
  if exprNullableStruct(e.binLeft, fnIx) {
    const csi = structIndexOfExpr(e.binLeft, fnIx)
    if csi >= 0 && csi < sHeapIdx.length {
      // The block type and the one-evaluation shape are the nullable-ref-niche lowering the
      // collections share.
      return emitCoalesceNulRef(
        body,
        e,
        exprIx,
        sHeapIdx[csi],
        expCtxHere(ec),
        fnIx,
        ec,
      )
    }
  }
  // D960 — `??` over a nullable value-union box whose operand cannot be re-read. The
  // re-readable spelling never arrives here: `emit_rewrite` desugars it to an `if`, which is
  // right because a rewrite leaves no `??` node for the consumer classifiers to disagree
  // about. A call operand cannot take that route, so it needs a real emit arm: stash the box once, branch on its tag, and give the `if` the box as its result type so both arms agree.

  // The two earlier emit arms fought each other: one emitted a correct `(if (result (ref
  // $box)) …)`, and the return path wrapped it in a second `struct.new $box` — the pair D969
  // untangled, since the consumer double-boxes precisely because `exprUnion` answers false for
  // this node. Teaching `unionNameOfExpr` to answer for a value-union `??` is the other half; neither half works alone.
  if tyIsNulValueUnionBox(nodeTyAt(e.binLeft, fnIx)) {
    const coNm = unionNameOfExpr(exprIx, fnIx)
    if coNm != "" {
      const coSlot = sharedFieldRecvSlot()
      if emitExpr(body, e.binLeft, fnIx, ec) < 0 { return -1 }
      fbLocalSet(coSlot)
      fbLocalGet(coSlot)
      fbStructGet(uBoxIdx, 0) // field 0: tag
      fbI32Rel(RS_TAG, nullBoxTag())
      fbI32Bin(71) // 0x47 i32.ne  -> present?
      fbIfRefNul(uBoxIdx, false) // if (result (ref $uBox))
      fbLocalGet(coSlot)
      fbRefAsNonNull() // the stash cell is nullable, the block type is not
      fbElse()
      if (
        emitUnionBoxArg(body, coNm, nodeTyIxOf(exprIx), e.binRight, fnIx, ec)
        < 0
      ) {
        return -1
      }
      fbEnd()
      return 0
    }
    // An instance's re-readable list cell, typed at the box only at its pin, is the null test
    // the rewrite makes of the concrete spelling (D8820).
    const coLhs = unwrapParen(e.binLeft)
    if coLhs >= 0 && fnInPinnedInstance(fnIx) && exprReReadable(coLhs) {
      const coCell = nodeAt(coLhs)
      if coCell is Index && !exprMap(coCell.idxArr, fnIx) {
        return emitExpr(body, coalNullTestIf(e, exprIx, fnIx), fnIx, ec)
      }
    }
  }
  // `<e> ?? d` over a nullable map: the cell is a `(ref null $map)` of the operand's shape, so it
  // takes the same `br_on_non_null` core, and a `Map()` default builds that shape (D3257).
  if exprNullableMap(e.binLeft, fnIx) {
    let cms = mapShapeOfExpr(e.binLeft, fnIx)
    if cms == -3 { cms = mapShapeOfTyPeeled(nodeTyIxOf(e.binLeft)) }
    if cms != -3 {
      return emitCoalesceNulRef(
        body,
        e,
        exprIx,
        mapTypeIdxOf(cms),
        expCtxHere(ec),
        fnIx,
        ec,
      )
    }
  }
  // What reaches here is a nullable left operand whose rep has no `??` lowering — not "this is
  // not a map index get", which is what this said while the overwhelming majority of its
  // firings are a non-nullable operand. Those fold to the left operand in `emit_rewrite.vl`
  // and never reach the emitter as a `??` at all, so the message can finally name the actual residue.

  // A re-readable atom niche joining into a box is the null test it spells.
  const lhsIx = unwrapParen(e.binLeft)
  if (
    lhsIx >= 0
    && exprReReadable(lhsIx)
    && exprNulLitUnion(lhsIx, fnIx)
    && coalesceResultIsBox(exprIx)
  ) {
    return emitExpr(body, coalNullTestIf(e, exprIx, fnIx), fnIx, ec)
  }
  // A re-readable cell joining numbers of different types apart is the null test it spells,
  // typed at the instance's join when the shared `??` records only its hole (D9701).
  if lhsIx >= 0 && exprReReadable(lhsIx) {
    const nrt = coalResultTyOf(exprIx, fnIx)
    if numUnionMinted && tyHoldsNumbersApart(nrt) {
      const nIf = coalNullTestIf(e, exprIx, fnIx)
      nodeTyRecord(nIf, nrt)
      return emitExpr(body, nIf, fnIx, ec)
    }
  }
  const armIf = coalNullArmIf(e, exprIx)
  if armIf >= 0 { return emitExpr(body, armIf, fnIx, ec) }
  // A record union's shared `scalar | null` field reads as its box (D13280).
  const fk = coalBoxFieldScalarKind(lhsIx, fnIx)
  if fk >= 0 {
    return emitCoalesceBoxFieldScalar(body, e, exprIx, fk, fnIx, ec)
  }
  emitFail(
    "emitProgram: `??` over this nullable value is not supported yet — narrow it first, e.g. `if v != null { … }`",
  )
}

// The scalar atom kind of the `scalar | null` box the field read `lhsIx` yields, read off the
// box's own member set so a hole instance answers too; -1 for any other operand.
function coalBoxFieldScalarKind(lhsIx: i32, fnIx: i32): i32 {
  if lhsIx < 0 || !(nodeAt(lhsIx) is Member) || !exprUnion(lhsIx, fnIx) {
    return -1
  }
  const un = memberUnionFieldNameRead(lhsIx, fnIx)
  if un == "" { return -1 }
  const sid = msSetOfNameTy(un, nodeTyAt(lhsIx, fnIx))
  if !unionHasAtomK(sid, un, "null", nullValKind()) { return -1 }
  const k = unionResidualSoloKindOfSet(sid)
  if nulBoxScalarValtype(k) < 0 || vbHeapIdxOfKind(k) < 0 { return -1 }
  k
}

// `f ?? d` over a field read `f` yielding a `scalar | null` box of atom kind `fk`: the box is
// read once, its tag decides, and the present arm unboxes and widens to the `??`'s own scalar.
function emitCoalesceBoxFieldScalar(
  body: u8[],
  e: BinExpr,
  exprIx: i32,
  fk: i32,
  fnIx: i32,
  ec: ExpCtx,
) {
  let rk = coalResultKindOf(exprIx, fnIx)
  if rk < 0 { rk = fk }
  if rk != fk && !coalWidens(fk, rk) {
    return emitFail(
      "emitProgram: `??` over a nullable value-box field has no conversion to its result",
    )
  }
  const slot = sharedFieldRecvSlot()
  if emitExpr(body, e.binLeft, fnIx, ec) < 0 { return -1 }
  fbLocalSet(slot)
  fbLocalGet(slot)
  fbStructGet(uBoxIdx, 0) // field 0: tag
  fbI32Rel(RS_TAG, nullBoxTag())
  fbI32Bin(71) // 0x47 i32.ne — present?
  fbIf(nulBoxScalarValtype(rk))
  fbLocalGet(slot)
  fbStructGet(uBoxIdx, 1) // field 1: the payload anyref
  const vb = vbHeapIdxOfKind(fk)
  fbRefCast(vb)
  fbStructGet(vb, 0)
  if coalWidenUnboxed(fk, rk) < 0 { return -1 }
  fbElse()
  if emitCoalesceScalarDefault(body, e.binRight, rk, fnIx, ec) < 0 { return -1 }
  fbEnd()
  0
}

// `if c { d } else { a ?? d }` for `(if c { null } else { a }) ?? d`, and its mirror, which is
// what `?? d` means for an `if` with a `null` arm: the `??` moves onto the other arm, whose own
// rep an instance types, where the `if` keeps its generic `V | null` (D10130). Only a desugared
// `if` reaches here: a written one is already bound to a local. -1 otherwise.
function coalNullArmIf(e: BinExpr, exprIx: i32): i32 {
  const lhsIx = unwrapParen(e.binLeft)
  if lhsIx < 0 { return -1 }
  const n = nodeAt(lhsIx)
  if !(n is IfStmt) || n.ifElse < 0 { return -1 }
  const tv = coalSoleStmt(n.ifThen)
  const ev = coalSoleStmt(n.ifElse)
  if tv < 0 || ev < 0 { return -1 }
  const tNull = nodeAt(tv) is NullLit
  const eNull = nodeAt(ev) is NullLit
  if tNull == eNull { return -1 }
  const pos = e.pos
  let live = tv
  if tNull { live = ev }
  const inner = mkBinary("??", live, e.binRight, pos)
  nodeTyCarry(inner, exprIx)
  const liveS: i32[] = []
  liveS.push(inner)
  const deadS: i32[] = []
  deadS.push(e.binRight)
  let thenB = mkBlock(liveS, pos)
  let elseB = mkBlock(deadS, pos)
  if tNull {
    thenB = mkBlock(deadS, pos)
    elseB = mkBlock(liveS, pos)
  }
  const ifIx = mkIf(n.ifCond, thenB, elseB, pos)
  nodeTyCarry(ifIx, exprIx)
  ifIx
}

// The one statement block `ix` holds, or -1 when it holds another number or is not a block.
function coalSoleStmt(ix: i32): i32 {
  if ix < 0 { return -1 }
  const b = nodeAt(ix)
  if b is Block {
    if b.blkStmts.length == 1 { return b.blkStmts[0] }
  }
  -1
}

// Whether the `??` at `exprIx` reads the field `lhsIx` of a record whose stored row holds that
// field at a non-null scalar, the same scalar as the `??` and its default. False for any other
// operand, a receiver with no struct row, or a field stored at a nullable code.
function coalFieldStoredFlat(exprIx: i32, lhsIx: i32, fnIx: i32): boolean {
  const m = nodeAt(lhsIx)
  if !(m is Member) { return false }
  const e = nodeAt(unwrapParen(exprIx))
  if !(e is BinExpr) { return false }
  if !nodeTyIsNullable(lhsIx) { return false }
  const si = structIndexOfExpr(m.memObj, fnIx)
  const fj = sFieldIndex(si, m.memProp)
  if fj < 0 { return false }
  const fc = sFieldTypeAt(si, fj)
  const pn = tyPrimNameOf(nodeTyPinIxOf(exprIx))
  if pn == null || tyPrimNameOf(nodeTyIxOf(e.binRight)) != pn { return false }
  if fc == FC_I32 { return pn == "i32" }
  if fc == FC_I64 { return pn == "i64" }
  if fc == FC_F64 { return pn == "f64" }
  if fc == FC_F32 { return pn == "f32" }
  if fc == FC_STR { return pn == "string" }
  false
}
