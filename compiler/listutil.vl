// Linear membership over a short list, written once. Every caller holds a list of a few
// entries (a scope's names, a type's members, a walk's seen set), so a scan is the right
// shape and a hash set would cost more than it saves. A leaf: it imports nothing, so
// any module can reach it.

// Whether `v` is an element of `xs`.
export function strListHas(xs: string[], v: string) {
  let i = 0
  while i < xs.length {
    if xs[i] == v { return true }
    i = i + 1
  }
  false
}

// Whether `v` is an element of `xs`.
export function i32ListHas(xs: i32[], v: i32) {
  let i = 0
  while i < xs.length {
    if xs[i] == v { return true }
    i = i + 1
  }
  false
}

// The first index of `v` in `xs`, or -1 when it is absent. A 0 is the first element, so
// every caller tests the answer against 0 before indexing with it.
export function strListIndexOf(xs: string[], v: string) {
  let i = 0
  while i < xs.length {
    if xs[i] == v { return i }
    i = i + 1
  }
  -1
}
