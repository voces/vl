// Linear scans over short lists, written once: membership, lookup and equality. Every
// caller holds a list of a few entries (a scope's names, a type's members, a walk's seen
// set), so a scan is the right shape and a hash set would cost more than it saves. A leaf:
// it imports nothing, so any module can reach it.

// Whether `v` is an element of `xs`.
export function strListHas(xs: string[], v: string) {
  let i = 0
  while i < xs.length {
    if xs[i] == v { return true }
    i = i + 1
  }
  false
}

// Whether `v` is an element of `xs`.
export function i32ListHas(xs: i32[], v: i32) {
  let i = 0
  while i < xs.length {
    if xs[i] == v { return true }
    i = i + 1
  }
  false
}

// The first index of `v` in `xs`, or -1 when it is absent. A 0 is the first element, so
// every caller tests the answer against 0 before indexing with it.
export function strListIndexOf(xs: string[], v: string) {
  let i = 0
  while i < xs.length {
    if xs[i] == v { return i }
    i = i + 1
  }
  -1
}

// The first index of `v` in `xs`, or -1 when it is absent.
export function i32ListIndexOf(xs: i32[], v: i32) {
  let i = 0
  while i < xs.length {
    if xs[i] == v { return i }
    i = i + 1
  }
  -1
}

// The first index at which the parallel lists `xs`/`ys` hold the pair (`a`, `b`), or -1 when
// no row does — a lookup in a table keyed by two columns.
export function i32PairIndexOf(xs: i32[], ys: i32[], a: i32, b: i32) {
  let i = 0
  while i < xs.length && i < ys.length {
    if xs[i] == a && ys[i] == b { return i }
    i = i + 1
  }
  -1
}

// `xs` itself when it holds `v`, else a copy of `xs` with `v` appended. `xs` is never changed,
// so a list read out of a table may be extended without the copy reaching the table.
export function i32ListWith(xs: i32[], v: i32): i32[] {
  if i32ListHas(xs, v) { return xs }
  const out: i32[] = []
  let i = 0
  while i < xs.length {
    out.push(xs[i])
    i = i + 1
  }
  out.push(v)
  out
}

// A copy of `xs` with `v` appended, duplicate or not.
export function i32ListPlus(xs: i32[], v: i32): i32[] {
  const out: i32[] = []
  let i = 0
  while i < xs.length {
    out.push(xs[i])
    i = i + 1
  }
  out.push(v)
  out
}

// `xs[i]`, or -1 when `i` is outside `xs`: the read of a per-node or per-row column that
// is padded lazily, so a short column answers "no entry" rather than trapping.
export function i32ListAt(xs: i32[], i: i32): i32 {
  if i < 0 || i >= xs.length { return -1 }
  xs[i]
}

// Whether `a` and `b` hold the same elements in the same order.
export function i32ListEq(a: i32[], b: i32[]): boolean {
  if a.length != b.length { return false }
  let i = 0
  while i < a.length {
    if a[i] != b[i] { return false }
    i = i + 1
  }
  true
}

// Whether `a` and `b` hold the same bytes in the same order.
export function u8ListEq(a: u8[], b: u8[]): boolean {
  if a.length != b.length { return false }
  let i = 0
  while i < a.length {
    if a[i] != b[i] { return false }
    i = i + 1
  }
  true
}
