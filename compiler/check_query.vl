// `check_query.vl` — the read-only LSP QUERY layer over a finished check: symbol
// occurrences / def / refs / hover (`sym*`), redundant-type reports (`redun*`), inlay
// hints. Reads `check_state` + the checker's `T`/types, never drives checking.

import {
  BoolLit,
  CharLit,
  FuncDecl,
  Ident,
  NullLit,
  NumLit,
  P,
  Param,
  StrLit,
  Unary,
  declNameTokOf,
  nodeToks,
  paramDefaultOf,
} from "./ast"
import {
  SYM_MEM_METHOD,
  inlayCol,
  inlayKind,
  inlayLine,
  inlayOcc,
  inlayType,
  memcIsFn,
  memcName,
  memcType,
  rcoalCol,
  rcoalLine,
  rcoalTok,
  rcoalType,
  redunECol,
  redunELine,
  redunName,
  redunSCol,
  redunSLine,
  redunTok,
  redunType,
  scopeResKind,
  scopeResName,
  scopeResRaw,
  scopeResTok,
  scopeResType,
  sigParDefault,
  sigParName,
  sigParType,
  sigRet,
  symBindKind,
  symBindNode,
  symBindType,
  symEnabled,
  symMemCol,
  symMemEndCol,
  symMemLine,
  symMemNode,
  symMemTy,
  symOccDecl,
  symOccIsDecl,
  symOccTok,
  symOccTy,
  symVisEC,
  symVisEL,
  symVisKind,
  symVisName,
  symVisNode,
  symVisSC,
  symVisSL,
} from "./check_state"
// Every rendered type string this module hands out is READ BY A PERSON (hover,
// inlay, completion details), so it renders through the USER pathway —
// `tyToStrUser`/`tyToStructStrUser`, demangle ∘ render — never the raw
// `tyToStr`, whose spelling doubles as canon/interner keys and keeps its `$mN`
// mangles. The boundary is documented at the pair's definition (typecheck.vl).
import {
  T,
  TyFunc,
  TyNullable,
  TyObj,
  TyPrim,
  cUserTypes,
  demangleName,
  inlayHole,
  tyToStrUser,
  tyToStructStrUser,
} from "./typecheck"

// The kind (0=variable 1=parameter 2=function) of the binding `declNode`
// resolves to, or -1 when it is not a recorded binding — semantic-token coloring.
export function symBindKindOf(declNode: i32) {
  let i = 0
  while i < symBindNode.length {
    if symBindNode[i] == declNode { return symBindKind[i] }
    i = i + 1
  }
  -1
}
// ── symbol-table QUERY API (consumed by the driver's exports) ────────────────
// Turn the LSP symbol machinery on/off. The driver flips it on before a
// symbol-aware `checkProgram`; everything else leaves it off (free, no recording).
export function symSetEnabled(on: i32) {
  symEnabled = on
  0
}
// The recorded occurrences (declarations + uses), in source-walk order.
export function symOccCount() { symOccTok.length }
// The bindingId (declaring node index) the occurrence `i` resolves to.
export function symOccBinding(i: i32) {
  if i >= 0 && i < symOccDecl.length { return symOccDecl[i] }
  -1
}
// 1 when occurrence `i` is its binding's declaration, 0 for a use.
export function symOccIsDeclAt(i: i32) {
  if i >= 0 && i < symOccIsDecl.length { return symOccIsDecl[i] }
  0
}
// The binding KIND of occurrence `i` (0=variable 1=parameter 2=function), or -1
// when out of range — semantic-token coloring reads this per identifier.
export function symOccKindAt(i: i32) {
  if i >= 0 && i < symOccDecl.length { return symBindKindOf(symOccDecl[i]) }
  -1
}
// The FLOW-NARROWED type retained at occurrence `i`, or -1 when that use sat under
// no narrowing (or the index is out of range). Bounds-safe so an older recording
// that never filled the column degrades to "not narrowed".
export function symOccNarrowTy(i: i32) {
  if i < 0 || i >= symOccTy.length { return -1 }
  symOccTy[i]
}
// The TYPE to answer a position query with for occurrence `i`: its flow-narrowed
// type when one was in force there, else the retained type of the binding it
// resolves to. THE ONE PLACE the narrowed-vs-declared choice is made, so hover and
// member completion cannot disagree about what `result` is inside an `is` arm.
// -1 when neither is known.
export function symOccQueryTy(i: i32) {
  const nt = symOccNarrowTy(i)
  if nt >= 0 { return nt }
  if i < 0 || i >= symOccDecl.length { return -1 }
  bindTypeOf(symOccDecl[i])
}
export function symOccTokOf(i: i32) {
  if i >= 0 && i < symOccTok.length { return symOccTok[i] }
  -1
}
// Occurrence `i`'s anchor TOKEN index (into `P.toks`), or -1. The driver maps it
// to the owning MODULE (a module's tokens occupy a contiguous range of `P.toks`
// after the merge) for cross-file find-references.
export function symOccTokAt(i: i32) { symOccTokOf(i) }
// The four span coordinates of occurrence `i` (`symOccStartLine`/`StartCol`/
// `EndLine`/`EndCol`), derived from its anchor token: a lexeme never spans lines,
// so the end line equals the start line and the end column is `col + text.length`.
// A missing/out-of-range token degrades to 0s.
export function symOccStartLine(i: i32) {
  const tk = symOccTokOf(i)
  if tk >= 0 && tk < P.toks.length { return P.toks[tk].line }
  0
}
export function symOccStartCol(i: i32) {
  const tk = symOccTokOf(i)
  if tk >= 0 && tk < P.toks.length { return P.toks[tk].col }
  0
}
export function symOccEndLine(i: i32) { symOccStartLine(i) }
export function symOccEndCol(i: i32) {
  const tk = symOccTokOf(i)
  if tk >= 0 && tk < P.toks.length {
    return P.toks[tk].col + P.toks[tk].text.length
  }
  0
}
// Whether occurrence `i`'s span covers (line, col): start inclusive, end
// inclusive (a cursor on the last char of a name still resolves — the host
// `spanContains` convention).
export function symOccCovers(i: i32, line: i32, col: i32) {
  const sl = symOccStartLine(i)
  if sl == 0 { return false }
  if line != sl { return false }
  const sc = symOccStartCol(i)
  const ec = symOccEndCol(i)
  col >= sc && col <= ec
}
// The occurrence index covering (line, col), tightest span winning (a name
// nested in a larger construct beats an outer one); -1 if the cursor is off any
// identifier occurrence.
export function symOccAt(line: i32, col: i32) {
  let best = -1
  let bestWidth = 0
  let i = 0
  while i < symOccTok.length {
    if symOccCovers(i, line, col) {
      const w = symOccEndCol(i) - symOccStartCol(i)
      if best < 0 || w < bestWidth {
        best = i
        bestWidth = w
      }
    }
    i = i + 1
  }
  best
}
// The DECLARATION occurrence index for the binding under (line, col), or -1.
// Drives go-to-definition: jump to this occurrence's span.
export function symDefAt(line: i32, col: i32) {
  const occ = symOccAt(line, col)
  if occ < 0 { return -1 }
  const binding = symOccDecl[occ]
  let i = 0
  while i < symOccTok.length {
    if symOccDecl[i] == binding && symOccIsDecl[i] == 1 { return i }
    i = i + 1
  }
  // A binding with no recorded declaration occurrence (defensive): the use under
  // the cursor is itself the best available anchor.
  occ
}
// The count of occurrences (declaration + uses) of the binding under (line, col)
// — find-references. `symRefAt(line, col, k)` returns the k-th such occurrence
// INDEX (read its span via the `symOcc*` accessors).
export function symRefsCountAt(line: i32, col: i32) {
  const occ = symOccAt(line, col)
  if occ < 0 { return 0 }
  const binding = symOccDecl[occ]
  let n = 0
  let i = 0
  while i < symOccTok.length {
    if symOccDecl[i] == binding { n = n + 1 }
    i = i + 1
  }
  n
}
export function symRefAt(line: i32, col: i32, k: i32) {
  const occ = symOccAt(line, col)
  if occ < 0 { return -1 }
  const binding = symOccDecl[occ]
  let seen = 0
  let i = 0
  while i < symOccTok.length {
    if symOccDecl[i] == binding {
      if seen == k { return i }
      seen = seen + 1
    }
    i = i + 1
  }
  -1
}
// The retained type-arena index of binding `binding`, or -1 when none was kept.
export function bindTypeOf(binding: i32) {
  let i = 0
  while i < symBindNode.length {
    if symBindNode[i] == binding { return symBindType[i] }
    i = i + 1
  }
  -1
}
// ── Named function signature (hover) ─────────────────────────────────────────
// A FUNCTION binding hovers with its parameter NAMES: `TyFunc` deliberately
// carries no names (`{ fnParamTypes, fnRet }` — the names live on the
// declaration), so zip the binding's FuncDecl parameter names with the type's
// parameter types: `(name: string, body: () => void) => void`. Returns "" when
// the render does not apply, and the caller falls back to the bare type:
//   - the binding is not FuncDecl-declared — a lambda-bound value (LetStmt) or a
//     function-typed parameter (Param) keeps the bare structural type;
//   - the retained type is not a TyFunc (defensive);
//   - the decl's param count disagrees with the type's (defensive).
// IMPORTED functions work through the same tables: the merged program shares one
// node arena, so a dep module's FuncDecl is addressable here and its parameter
// names are source names (the merge mangles only top-level DECL names). A future
// signature-help provider (D9 slot 10) reads exactly this zip, one param per
// index. Renders through the user pathway, like every string leaving this file.
function fnSigStr(declNode: i32, ty: i32) {
  if declNode < 0 || declNode >= P.nodes.length { return "" }
  const nd = P.nodes[declNode]
  if !(nd is FuncDecl) { return "" }
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if !(t is TyFunc) { return "" }
  if nd.fnParams.length != t.fnParamTypes.length { return "" }
  let s = "("
  let i = 0
  while i < nd.fnParams.length {
    const pn = P.nodes[nd.fnParams[i]]
    if !(pn is Param) { return "" }
    if i > 0 { s = s + ", " }
    s = s + pn.parName + ": " + tyToStrUser(t.fnParamTypes[i])
    i = i + 1
  }
  s + ") => " + tyToStrUser(t.fnRet)
}
// The rendered TYPE STRING of the binding under (line, col), or "" when the
// cursor is off any tracked binding or its type was not retained. The arena
// `T.tys` persists for the whole check, so the retained index renders even after
// the binding's scope closed (hover-types). A FuncDecl-declared binding renders
// as its NAMED signature (`fnSigStr` above); everything else as the bare type.
//
// A use under a FLOW NARROWING renders the narrowed type: hovering `result` inside
// `if result is string { … }` says `string`, not the declared `string | IoError`.
// The named-signature path is skipped for such a use — `fnSigStr` zips the DECL's
// parameter names against the binding's own type, which is not what is in force
// here — so a narrowed occurrence renders bare.
export function symTypeStrAt(line: i32, col: i32) {
  const occ = symOccAt(line, col)
  if occ < 0 { return "" }
  const ty = symOccQueryTy(occ)
  if ty < 0 { return "" }
  if symOccNarrowTy(occ) < 0 {
    const sig = fnSigStr(symOccDecl[occ], ty)
    if sig != "" { return sig }
  }
  tyToStrUser(ty)
}
export function inlayPush(k: i32, occ: i32, ty: i32) {
  inlayKind.push(k)
  inlayLine.push(symOccEndLine(occ))
  inlayCol.push(symOccEndCol(occ))
  inlayType.push(tyToStrUser(ty))
  inlayOcc.push(occ)
}
export function symInlayScan() {
  inlayKind = []
  inlayLine = []
  inlayCol = []
  inlayType = []
  inlayOcc = []
  let i = 0
  while i < symOccIsDecl.length {
    if symOccIsDecl[i] == 1 {
      const ty = bindTypeOf(symOccDecl[i])
      if ty >= 0 {
        const k = symOccKindAt(i)
        if k == 2 {
          const t = T.tys[ty]
          if t is TyFunc {
            if !inlayHole(t.fnRet) { inlayPush(1, i, t.fnRet) }
          }
        } else {
          if !inlayHole(ty) { inlayPush(0, i, ty) }
        }
      }
    }
    i = i + 1
  }
  inlayKind.length
}
export function symInlayCount() { inlayKind.length }
export function symInlayKindAt(i: i32) { inlayKind[i] }
export function symInlayLineAt(i: i32) { inlayLine[i] }
export function symInlayColAt(i: i32) { inlayCol[i] }
export function symInlayTypeLen(i: i32) { inlayType[i].length }
export function symInlayTypeCharAt(i: i32, j: i32) { inlayType[i][j] }
export function symInlayOccAt(i: i32) { inlayOcc[i] }
export function redunCount() { redunName.length }
export function redunSLineAt(i: i32) { redunSLine[i] }
export function redunSColAt(i: i32) { redunSCol[i] }
export function redunELineAt(i: i32) { redunELine[i] }
export function redunEColAt(i: i32) { redunECol[i] }
export function redunNameAt(i: i32) { redunName[i] }
export function redunTypeAt(i: i32) { redunType[i] }
export function redunTokAt(i: i32) { redunTok[i] }
// The finding's human message. THE single spelling of this diagnostic: the CLI
// report, `--fix`'s companion output and the wasm driver's `redunMsg*` byte ABI
// all read it here, so no consumer can drift from another's wording.
export function redunMsgAt(i: i32) {
  "redundant type annotation: `" +
    redunName[i] +
    "` is inferred as `" +
    redunType[i] +
    "` — remove it to lean on inference"
}
// ── Dead `??` defaults ──────────────────────────────────────────────────────────
// The checker's `rcoal*` findings (a `??` whose left operand can never be null), read
// exactly as `redun*` is: count + per-index position, with the message BUILT here so
// the CLI report and the corpus oracle share one spelling.
export function rcoalCount() { rcoalTok.length }
export function rcoalLineAt(i: i32) { rcoalLine[i] }
export function rcoalColAt(i: i32) { rcoalCol[i] }
export function rcoalTokAt(i: i32) { rcoalTok[i] }
// THE single spelling of this diagnostic. Says what is dead (the default), why (the
// left operand's type), and what to do — the message convention the emitter-capability
// errors already follow: name the construct, then the action after an em dash.
export function rcoalMsgAt(i: i32) {
  "this `??` default is never used: `" +
    rcoalType[i] +
    "` is never null — drop the `??` and its default"
}

// Type-alias hover: the rendered type of the user TYPE NAME (a `type`-declared
// struct/union alias) whose token covers (line, col) — the decl name or a use in
// an annotation. A type name isn't a value-binding occurrence, so this scans the
// token stream for the identifier at the cursor and resolves it through the
// declared-types map (`cUserTypes`), reusing existing state (no occurrence table).
// "" when the cursor is off a known user type. Builtins (`i32`, …) are NOT user
// types — the host serves those from its builtin list. Line is 1-based, col 0-based.
// End-INCLUSIVE containment, like every position query here (`symOccCovers`,
// `visContainsPos`): a cursor just past the name's last char still resolves.
export function symTypeAliasAt(line: i32, col: i32) {
  let i = 0
  while i < P.toks.length {
    const t = P.toks[i]
    if (
      t.kind == "IDENT" &&
      t.line == line &&
      col >= t.col &&
      col <= t.col + t.text.length
    ) {
      // In a MULTI-MODULE compile the merge renames the entry's own type decls
      // too (`W` → `W$m0`), so the map's key is the mangled spelling while the
      // token still reads `W` — without the `$m0` fallback the alias hover
      // simply went dark in any program with an import (measured 2026-08-31).
      // An alias's arena index is never negative, so -1 is a clean miss sentinel.
      let ty = cUserTypes[t.text] ?? (-1)
      if ty < 0 { ty = cUserTypes[t.text + "$m0"] ?? (-1) }
      // THE ONE DISPLAY QUERY THAT WANTS THE STRUCTURAL RENDER, and the reason is
      // its question. Every other surface asks "what type is this VALUE", and the
      // useful answer is the name the source gives it. This one is handed the NAME
      // and asks what it stands for, so the nominal render would answer `Pt` for a
      // hover over `Pt` — the alias's body is the whole content of the reply.
      // `tyToStructStrUser` is that render (through the user pathway — the body
      // can embed a mangled NEWTYPE name), and it is source-spelled — the
      // structural entry has no second spelling to pick from.
      if ty >= 0 { return tyToStructStrUser(ty) }
    }
    i = i + 1
  }
  ""
}
// The rendered TYPE STRING of the member access whose PROPERTY NAME covers
// (line, col) — member hover (`o.x` / `o?.y`). The narrowest covering span wins
// (defensive against any overlap). "" when the cursor is off any recorded member.
// End-INCLUSIVE containment, like every position query here (`symOccCovers`,
// `visContainsPos`): a cursor just past the name's last char still resolves.
export function symMemTypeStrAt(line: i32, col: i32) {
  const best = symMemIxAt(line, col)
  if best < 0 { return "" }
  const ty = symMemTy[best]
  if ty < 0 { return "" }
  tyToStrUser(ty)
}
// The recorded member access whose PROPERTY NAME covers (line, col), narrowest
// span first, or -1. One home for the walk, because signature help asks the same
// question of the same table (`o.cb(…)` — a struct field holding a function) and
// two copies of a containment rule is how two surfaces come to disagree about
// which member a cursor is on.
export function symMemIxAt(line: i32, col: i32) {
  let best = -1
  let bestW = 0
  let i = 0
  while i < symMemNode.length {
    if symMemLine[i] == line && col >= symMemCol[i] && col <= symMemEndCol[i] {
      const w = symMemEndCol[i] - symMemCol[i]
      if best < 0 || w < bestW {
        best = i
        bestW = w
      }
    }
    i = i + 1
  }
  best
}
// Whether type `ty` is a function — the `method` vs `property` distinction for
// semantic tokens. Unwraps a nullable wrapper so an optional method (`o?.fn`)
// still classifies as a method, matching the host member walk.
export function symMemIsFn(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable { return symMemIsFn(t.nInner) }
  t is TyFunc
}
// Member-access enumeration (semantic tokens): every recorded member-access
// property name, in record order, with its span and method/property class — the
// native equivalent of the host's AST member walk. The host reads
// `symMemberCount()` then the per-index accessors. Line is 1-based, col 0-based;
// `symMemberLen` is the property name's length; `symMemberIsMethod` is 1 for a
// function-typed member, else 0.
export function symMemberCount() { symMemNode.length }
export function symMemberLine(i: i32) { symMemLine[i] }
export function symMemberCol(i: i32) { symMemCol[i] }
export function symMemberLen(i: i32) { symMemEndCol[i] - symMemCol[i] }
export function symMemberIsMethod(i: i32) {
  if symMemTy[i] == SYM_MEM_METHOD { return 1 }
  if symMemIsFn(symMemTy[i]) { return 1 }
  0
}
// The rendered TYPE STRING of binding `declNode`, or "" when no type was retained.
// The arena persists for the whole check, so the index renders post-scope-close.
// A USER-FACING render (its one consumer is the completion detail `symScopeAt`
// fills), so it goes through the user pathway — this is where `symScopeAt`'s
// former inline `demangleMsg` wraps (#2074) collapsed to.
export function symBindTypeStr(declNode: i32) {
  let i = 0
  while i < symBindNode.length {
    if symBindNode[i] == declNode {
      const ty = symBindType[i]
      if ty < 0 { return "" }
      return tyToStrUser(ty)
    }
    i = i + 1
  }
  ""
}
// Whether visibility entry `i`'s scope span contains (line, col) — `start`
// inclusive, `stop` inclusive (a cursor at a scope's last column still counts).
export function visContainsPos(i: i32, line: i32, col: i32) {
  const afterStart = line > symVisSL[i] ||
    (line == symVisSL[i] && col >= symVisSC[i])
  const beforeEnd = line < symVisEL[i] ||
    (line == symVisEL[i] && col <= symVisEC[i])
  afterStart && beforeEnd
}
// Whether entry `a`'s scope is TIGHTER (more deeply nested) than entry `b`'s —
// the lexical-shadowing tiebreak: a same-line scope compares by column width, a
// multi-line scope by line count. Mirrors the host `spanShorter`.
export function visTighter(a: i32, b: i32) {
  const aSame = symVisSL[a] == symVisEL[a]
  const bSame = symVisSL[b] == symVisEL[b]
  if aSame && bSame {
    return (symVisEC[a] - symVisSC[a]) < (symVisEC[b] - symVisSC[b])
  }
  (symVisEL[a] - symVisSL[a]) < (symVisEL[b] - symVisSL[b])
}
// A binding's decl-name token, falling back to its node's anchor token — the
// same fallback the occurrence recorder uses (`symDecl`). `-1` only when the
// node has neither, which the driver's module filter then treats as entry.
function visDeclTok(declNode: i32): i32 {
  const tok = declNameTokOf(declNode)
  if tok >= 0 { return tok }
  if declNode >= 0 && declNode < nodeToks.length { return nodeToks[declNode] }
  -1
}
// Scope-at-position (completion): the user bindings (var/param/function) visible
// at (line, col) — 1-based line, 0-based col. Computes the result into the
// `scopeRes*` arrays (read by the per-index accessors) and returns the count.
// One binding per name: when several of a name are visible, the TIGHTEST scope
// wins (an inner `let` shadows an outer). The host folds in builtins/imports.
// An imported name is recorded under its mangled merge name (`add$m1`); it's
// de-mangled to its source name (`add`) for display, and de-dup is keyed on that
// source name so a local and a same-named import collapse (tightest wins).
export function symScopeAt(line: i32, col: i32) {
  scopeResName = []
  scopeResKind = []
  scopeResType = []
  scopeResRaw = []
  scopeResTok = []
  const resVis: i32[] = []
  const idxByName: {[string]: i32} = Map()
  let i = 0
  while i < symVisName.length {
    if visContainsPos(i, line, col) {
      const nm = demangleName(symVisName[i])
      const existing = idxByName[nm] ?? (-1)
      if existing < 0 {
        idxByName[nm] = scopeResName.length
        scopeResName.push(nm)
        scopeResKind.push(symVisKind[i])
        // `symBindTypeStr` renders through the user pathway, so a MANGLED user
        // type name (`Expectation$m1`) from a dep-module binding never reaches
        // the completion detail.
        scopeResType.push(symBindTypeStr(symVisNode[i]))
        scopeResRaw.push(symVisName[i])
        scopeResTok.push(visDeclTok(symVisNode[i]))
        resVis.push(i)
      } else if visTighter(i, resVis[existing]) {
        scopeResKind[existing] = symVisKind[i]
        scopeResType[existing] = symBindTypeStr(symVisNode[i])
        scopeResRaw[existing] = symVisName[i]
        scopeResTok[existing] = visDeclTok(symVisNode[i])
        resVis[existing] = i
      }
    }
    i = i + 1
  }
  scopeResName.length
}
export function symScopeNameLen(i: i32) {
  if i < 0 || i >= scopeResName.length { return 0 }
  scopeResName[i].length
}
export function symScopeNameCharAt(i: i32, j: i32) {
  if i < 0 || i >= scopeResName.length { return 0 }
  scopeResName[i][j]
}
export function symScopeKindAt(i: i32) {
  if i < 0 || i >= scopeResKind.length { return 0 }
  scopeResKind[i]
}
export function symScopeTypeLen(i: i32) {
  if i < 0 || i >= scopeResType.length { return 0 }
  scopeResType[i].length
}
export function symScopeTypeCharAt(i: i32, j: i32) {
  if i < 0 || i >= scopeResType.length { return 0 }
  scopeResType[i][j]
}
// Whether `nm` is a plain identifier (so it's dot-accessible) — excludes the
// operator field names (`+`, `==`, …) an object type also carries. Mirrors the
// host's `/^[A-Za-z_][A-Za-z0-9_]*$/` guard.
export function isIdentName(nm: string) {
  if nm.length == 0 { return false }
  const c0 = nm[0]
  if !((c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95) {
    return false
  }
  let k = 1
  while k < nm.length {
    const c = nm[k]
    const ok = (c >= 65 && c <= 90) ||
      (c >= 97 && c <= 122) ||
      c == 95 ||
      (c >= 48 && c <= 57)
    if !ok { return false }
    k = k + 1
  }
  true
}
// Soften a receiver type to its member-bearing core: unwrap a nullable (`o?.`).
export function memcSoften(ty: i32) {
  if ty < 0 { return ty }
  const t = T.tys[ty]
  if t is TyNullable { return memcSoften(t.nInner) }
  ty
}
export function memcPush(nm: string, ds: string, fn: i32) {
  memcName.push(nm)
  memcType.push(ds)
  memcIsFn.push(fn)
}
export function symMemberScanAt(line: i32, col: i32) {
  memcName = []
  memcType = []
  memcIsFn = []
  const occ = symOccAt(line, col)
  if occ < 0 { return 0 }
  // The SAME choice hover makes (`symOccQueryTy`): a receiver under a flow
  // narrowing offers the NARROWED arm's members. `result.` inside `if result is
  // IoError { … }` offers `msg`/`code`; on the declared `string | IoError` the
  // scan below finds neither a `TyObj` nor a `string` and offers nothing, which is
  // what it used to do at both spellings.
  let ty = symOccQueryTy(occ)
  if ty < 0 { return 0 }
  ty = memcSoften(ty)
  if ty < 0 { return 0 }
  const t = T.tys[ty]
  if t is TyObj {
    let k = 0
    while k < t.objFieldNames.length {
      const nm = t.objFieldNames[k]
      if isIdentName(nm) {
        const fty = t.objFieldTypes[k]
        let isfn = 0
        if symMemIsFn(fty) { isfn = 1 }
        memcPush(nm, tyToStrUser(fty), isfn)
      }
      k = k + 1
    }
  } else if t is TyPrim {
    if t.primName == "string" {
      // The string builtin methods the host surfaces (call-arms in this file).
      // HAND-WRITTEN INTO THE SAME COLUMN `tyToStr` FILLS above, so they carry the same
      // rule: a signature a reader sees is spelled the way VL source spells it (`=>`).
      memcPush("slice", "(i32, i32) => string", 1)
      memcPush("indexOf", "(string) => i32", 1)
      memcPush("includes", "(string) => boolean", 1)
      memcPush("charCodeAt", "(i32) => i32", 1)
      // The Stage 2c codec trio — offered here as well as typed in `typecheck`, because
      // the completion table is the sibling ladder that has silently lagged before
      // (`.length` is typed on a string and STILL not offered; §2.7 L6).
      memcPush("cpAt", "(i32) => i32", 1)
      memcPush("cpLen", "() => i32", 0)
      memcPush("isCharBoundary", "(i32) => boolean", 1)
      memcPush("bytes", "() => u8[]", 0)
    }
  }
  memcName.length
}
export function symMemberScanCount() { memcName.length }
export function symMemberScanNameLen(i: i32) {
  if i < 0 || i >= memcName.length { return 0 }
  memcName[i].length
}
export function symMemberScanNameCharAt(i: i32, j: i32) {
  if i < 0 || i >= memcName.length { return 0 }
  memcName[i][j]
}
export function symMemberScanTypeLen(i: i32) {
  if i < 0 || i >= memcType.length { return 0 }
  memcType[i].length
}
export function symMemberScanTypeCharAt(i: i32, j: i32) {
  if i < 0 || i >= memcType.length { return 0 }
  memcType[i][j]
}
export function symMemberScanIsFn(i: i32) {
  if i < 0 || i >= memcIsFn.length { return 0 }
  memcIsFn[i]
}
// ── Signature help (D9.10): the callee's parameter table at (line, col) ───────
// `fnSigStr` above answers "what does this function look like"; this answers
// "…and which of its parameters is argument 3". Same zip, kept in COLUMNS — see
// `check_state.vl`'s header for why the rendered string cannot serve the second
// question. A pure QUERY over what the check already recorded: it reads
// `symOcc*` / `symBind*` / `symMem*` and the type arena, records nothing, and
// changes no program's diagnostics or bytes.

// One parameter row. The type renders through the USER pathway like every other
// string leaving this file.
function sigPush(nm: string, ty: i32, dflt: string) {
  sigParName.push(nm)
  sigParType.push(tyToStrUser(ty))
  sigParDefault.push(dflt)
  0
}

// A parameter DEFAULT as source text, or "" when the parameter has none.
//
// A LOCAL RENDERER, not `format.vl`'s `expr`: the formatter is a LATER layer
// (it imports this one's neighbours, not the other way round), and the whole set
// v1 admits is four leaf shapes plus a sign. That set is closed by the checker's
// own rule (`paramDefaultIsLiteral`), so the ladder cannot silently fall short
// of the language — a form this does not know is a form the checker refuses.
// The `Ident` arm DEMANGLES, because a module `const` default reads `SEP$m1` in
// the merged arena and `SEP` in the file the user is looking at.
function sigDefaultText(pIx: i32): string {
  const dIx = paramDefaultOf(pIx)
  if dIx < 0 { return "" }
  const d = P.nodes[dIx]
  if d is NumLit { return d.numText }
  if d is StrLit { return d.strText }
  if d is CharLit { return d.charText }
  if d is BoolLit {
    if d.boolVal == 1 { return "true" }
    return "false"
  }
  if d is NullLit { return d.nullKw }
  if d is Ident { return demangleName(d.identName) }
  if d is Unary {
    const inner = P.nodes[d.unArg]
    if inner is NumLit { return d.unOp + inner.numText }
  }
  ""
}
// Fill the table from function type `ty`, naming the parameters off `declNode`'s
// `FuncDecl` when there is one and it agrees on arity (`fnSigStr`'s defensive
// gate, and for the same reason: a disagreeing pair would label argument k with
// parameter k+1's name). `skip` drops leading parameters — 1 for a UFCS call,
// whose `self` the receiver already supplied. Returns the ROW COUNT, or -1 when
// `ty` is not a function; the two are distinguishable because a zero-parameter
// function is a real signature with 0 rows.
function sigFill(declNode: i32, ty: i32, skip: i32) {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if !(t is TyFunc) { return -1 }
  const pts = t.fnParamTypes
  if skip > pts.length { return -1 }
  const names: string[] = []
  const dflts: string[] = []
  if declNode >= 0 && declNode < P.nodes.length {
    const nd = P.nodes[declNode]
    if nd is FuncDecl {
      if nd.fnParams.length == pts.length {
        let i = 0
        while i < nd.fnParams.length {
          const pn = P.nodes[nd.fnParams[i]]
          if pn is Param { names.push(pn.parName) } else { names.push("") }
          // Same arity gate as the names, and for the same reason: a
          // disagreeing pair would attach parameter k+1's default to argument k.
          dflts.push(sigDefaultText(nd.fnParams[i]))
          i = i + 1
        }
      }
    }
  }
  let k = skip
  while k < pts.length {
    let nm = ""
    if k < names.length { nm = names[k] }
    let df = ""
    if k < dflts.length { df = dflts[k] }
    sigPush(nm, pts[k], df)
    k = k + 1
  }
  sigRet = tyToStrUser(t.fnRet)
  pts.length - skip
}
// The declaring node of a free SELF-FUNCTION named `nm` — the UFCS rule the
// emitter applies (`emit_rewrite.vl`'s `drwSelfFnOf`): a top-level function whose
// FIRST parameter is NAMED `self`. Matched on the DEMANGLED name, because a
// multi-module merge renames every declaration (`shout` → `shout$m1`) while the
// property token still reads `shout` — the same mangling `symTypeAliasAt` has to
// see through. -1 when no such function is declared.
//
// ARITY IS DELIBERATELY NOT CHECKED, where the emitter's rule checks it: the
// emitter knows how many arguments the call HAS, and a signature-help query is
// asked halfway through typing them. Nor is the receiver's type: this is a
// display query, and a `self`-function of the right NAME is what the user is
// mid-way through calling. First match wins — two modules may each declare one,
// and either beats no answer.
function sigSelfFnDeclOf(nm: string) {
  let i = 0
  while i < symBindNode.length {
    if symBindKind[i] == 2 {
      const d = symBindNode[i]
      if d >= 0 && d < P.nodes.length {
        const nd = P.nodes[d]
        if nd is FuncDecl {
          if demangleName(nd.fnName) == nm && nd.fnParams.length > 0 {
            const p0 = P.nodes[nd.fnParams[0]]
            if p0 is Param {
              if p0.parName == "self" { return d }
            }
          }
        }
      }
    }
    i = i + 1
  }
  -1
}
// The IDENT token text at (line, col), or "" — the member PROPERTY name a
// position query lands on when the cursor is not on a tracked occurrence.
// End-inclusive, like every position query in this file.
function sigIdentAt(line: i32, col: i32) {
  let i = 0
  while i < P.toks.length {
    const t = P.toks[i]
    if (
      t.kind == "IDENT" &&
      t.line == line &&
      col >= t.col &&
      col <= t.col + t.text.length
    ) {
      return t.text
    }
    i = i + 1
  }
  ""
}
// The parameter table of the function being CALLED, whose name is at (line, col).
// Returns the parameter count, or -1 when nothing there is callable. Three routes,
// in the order a call site can name a callee:
//
//   1. A tracked BINDING — `greet(…)`, an imported name, or a function-typed
//      local (`lam(…)`, whose `TyFunc` has types but no names).
//   2. A member whose type RESOLVED — a struct field holding a function
//      (`o.cb(…)`). A UFCS callee is recorded with the `SYM_MEM_METHOD` sentinel
//      instead of a type, so it falls past this route rather than through it.
//   3. UFCS — `x.f(…)` over a free `function f(self, …)`, with the `self` row
//      dropped (see `check_state.vl`).
//
// Not served: a BUILTIN method (`xs.push`, `s.slice`). The checker types those in
// the call arms without recording a member type, so there is nothing here to read
// — the same reason member hover is dark on them today. Naming that gap is the
// point of saying so: it wants the builtin table to grow a parameter column, not
// a second resolver here.
export function symSigAt(line: i32, col: i32) {
  sigParName = []
  sigParType = []
  sigParDefault = []
  sigRet = ""
  const occ = symOccAt(line, col)
  if occ >= 0 { return sigFill(symOccDecl[occ], symOccQueryTy(occ), 0) }
  const mi = symMemIxAt(line, col)
  if mi >= 0 {
    if symMemTy[mi] >= 0 {
      const n = sigFill(-1, symMemTy[mi], 0)
      if n >= 0 { return n }
    }
  }
  const nm = sigIdentAt(line, col)
  if nm == "" { return -1 }
  const d = sigSelfFnDeclOf(nm)
  if d < 0 { return -1 }
  sigFill(d, bindTypeOf(d), 1)
}
export function symSigParamNameLen(i: i32) {
  if i < 0 || i >= sigParName.length { return 0 }
  sigParName[i].length
}
export function symSigParamNameCharAt(i: i32, j: i32) {
  if i < 0 || i >= sigParName.length { return 0 }
  sigParName[i][j]
}
export function symSigParamTypeLen(i: i32) {
  if i < 0 || i >= sigParType.length { return 0 }
  sigParType[i].length
}
export function symSigParamTypeCharAt(i: i32, j: i32) {
  if i < 0 || i >= sigParType.length { return 0 }
  sigParType[i][j]
}
export function symSigParamDefaultLen(i: i32) {
  if i < 0 || i >= sigParDefault.length { return 0 }
  sigParDefault[i].length
}
export function symSigParamDefaultCharAt(i: i32, j: i32) {
  if i < 0 || i >= sigParDefault.length { return 0 }
  sigParDefault[i][j]
}
export function symSigRetLen() { sigRet.length }
export function symSigRetCharAt(j: i32) { sigRet[j] }
