// `check_query.vl` — the read-only LSP query layer over a finished check: symbol
// occurrences, definition, references and hover (`sym*`), redundant-annotation and
// dead-`??` reports, inlay hints, completion and signature help. Reads
// `check_state.vl` and the checker's `T` / types; it never drives checking.

import {
  BoolLit,
  CharLit,
  FuncDecl,
  Ident,
  Member,
  NullLit,
  NumLit,
  OptMember,
  P,
  Param,
  StrLit,
  Unary,
  declHasExportKw,
  declNameTokOf,
  nodeToks,
  paramDefaultOf,
} from "./ast"
import {
  SYM_MEM_METHOD,
  inlayCol,
  inlayKind,
  inlayLine,
  inlayOcc,
  inlayType,
  isvalCol,
  isvalLine,
  isvalLit,
  isvalName,
  isvalTok,
  isvalType,
  memcIsFn,
  memcName,
  memcType,
  rcoalCol,
  rcoalLine,
  rcoalTok,
  rcoalType,
  redunECol,
  redunELine,
  redunName,
  redunSCol,
  redunSLine,
  redunTok,
  redunType,
  scopeResKind,
  scopeResName,
  scopeResRaw,
  scopeResTok,
  scopeResType,
  sigParDefault,
  sigParName,
  sigParType,
  sigRet,
  symBindKind,
  symBindNode,
  symBindType,
  symEnabled,
  symMemCol,
  symMemEndCol,
  symMemLine,
  symMemNode,
  symMemTy,
  symOccDecl,
  symOccIsDecl,
  symOccTok,
  symOccTy,
  symVisEC,
  symVisEL,
  symVisKind,
  symVisName,
  symVisNode,
  symVisSC,
  symVisSL,
  ufcDetail,
  ufcExported,
  ufcName,
  ufcTok,
} from "./check_state"
// Every rendered type string this module hands out is read by a person (hover, inlay,
// completion detail), so it renders through the user pathway — `tyToStrUser` /
// `tyToStructStrUser`, demangle then render — never the raw `tyToStr`, whose spelling
// doubles as a canon and interner key and keeps its `$mN` mangles.
import {
  T,
  TyFunc,
  TyNullable,
  TyObj,
  TyPrim,
  assignable,
  cUserTypes,
  demangleName,
  inlayHole,
  nodeTyIxOf,
  tyToStrUser,
  tyToStructStrUser,
} from "./typecheck"

// The kind (0=variable 1=parameter 2=function) of the binding `declNode`
// resolves to, or -1 when it is not a recorded binding — semantic-token coloring.
export function symBindKindOf(declNode: i32) {
  let i = 0
  while i < symBindNode.length {
    if symBindNode[i] == declNode { return symBindKind[i] }
    i = i + 1
  }
  -1
}
// ── symbol-table query API (consumed by the driver's exports) ────────────────
// Turn the LSP symbol machinery on or off. The driver flips it on before a
// symbol-aware `checkProgram`; everything else leaves it off and records nothing.
export function symSetEnabled(on: i32) {
  symEnabled = on
  0
}
// The recorded occurrences (declarations + uses), in source-walk order.
export function symOccCount() { symOccTok.length }
// The bindingId (declaring node index) the occurrence `i` resolves to.
export function symOccBinding(i: i32) {
  if i >= 0 && i < symOccDecl.length { return symOccDecl[i] }
  -1
}
// 1 when occurrence `i` is its binding's declaration, 0 for a use.
export function symOccIsDeclAt(i: i32) {
  if i >= 0 && i < symOccIsDecl.length { return symOccIsDecl[i] }
  0
}
// The binding kind of occurrence `i` (0 = variable, 1 = parameter, 2 = function), or
// -1 when out of range — semantic-token coloring reads this per identifier.
export function symOccKindAt(i: i32) {
  if i >= 0 && i < symOccDecl.length { return symBindKindOf(symOccDecl[i]) }
  -1
}
// The flow-narrowed type retained at occurrence `i`, or -1 when that use sits under
// no narrowing or the index is out of range. Bounds-safe, so an unfilled column
// degrades to "not narrowed".
function symOccNarrowTy(i: i32) {
  if i < 0 || i >= symOccTy.length { return -1 }
  symOccTy[i]
}
// The type to answer a position query with for occurrence `i`: its flow-narrowed type
// when one is in force there, else the retained type of the binding it resolves to,
// and -1 when neither is known. The one place that choice is made, so hover and member
// completion cannot disagree about what `result` is inside an `is` arm.
export function symOccQueryTy(i: i32) {
  const nt = symOccNarrowTy(i)
  if nt >= 0 { return nt }
  if i < 0 || i >= symOccDecl.length { return -1 }
  bindTypeOf(symOccDecl[i])
}
function symOccTokOf(i: i32) {
  if i >= 0 && i < symOccTok.length { return symOccTok[i] }
  -1
}
// Occurrence `i`'s anchor token index (into `P.toks`), or -1. The driver maps it to
// the owning module — a module's tokens occupy a contiguous range of `P.toks` after
// the merge — for cross-file find-references.
export function symOccTokAt(i: i32) { symOccTokOf(i) }
// The four span coordinates of occurrence `i` (`symOccStartLine`/`StartCol`/
// `EndLine`/`EndCol`), derived from its anchor token: a lexeme never spans lines,
// so the end line equals the start line and the end column is `col + text.length`.
// A missing/out-of-range token degrades to 0s.
export function symOccStartLine(i: i32) {
  const tk = symOccTokOf(i)
  if tk >= 0 && tk < P.toks.length { return P.toks[tk].line }
  0
}
export function symOccStartCol(i: i32) {
  const tk = symOccTokOf(i)
  if tk >= 0 && tk < P.toks.length { return P.toks[tk].col }
  0
}
export function symOccEndLine(i: i32) { symOccStartLine(i) }
export function symOccEndCol(i: i32) {
  const tk = symOccTokOf(i)
  if tk >= 0 && tk < P.toks.length {
    return P.toks[tk].col + P.toks[tk].text.length
  }
  0
}
// Whether occurrence `i`'s span covers (line, col): start inclusive, end
// inclusive (a cursor on the last char of a name still resolves — the host
// `spanContains` convention).
export function symOccCovers(i: i32, line: i32, col: i32) {
  const sl = symOccStartLine(i)
  if sl == 0 { return false }
  if line != sl { return false }
  const sc = symOccStartCol(i)
  const ec = symOccEndCol(i)
  col >= sc && col <= ec
}
// The occurrence index covering (line, col), tightest span winning (a name
// nested in a larger construct beats an outer one); -1 if the cursor is off any
// identifier occurrence.
export function symOccAt(line: i32, col: i32) {
  let best = -1
  let bestWidth = 0
  let i = 0
  while i < symOccTok.length {
    if symOccCovers(i, line, col) {
      const w = symOccEndCol(i) - symOccStartCol(i)
      if best < 0 || w < bestWidth {
        best = i
        bestWidth = w
      }
    }
    i = i + 1
  }
  best
}
// The declaration occurrence index for the binding under (line, col), or -1. Drives
// go-to-definition: jump to this occurrence's span.
export function symDefAt(line: i32, col: i32) {
  const occ = symOccAt(line, col)
  if occ < 0 { return -1 }
  const binding = symOccDecl[occ]
  let i = 0
  while i < symOccTok.length {
    if symOccDecl[i] == binding && symOccIsDecl[i] == 1 { return i }
    i = i + 1
  }
  // A binding with no recorded declaration occurrence (defensive): the use under
  // the cursor is itself the best available anchor.
  occ
}
// The count of occurrences (declaration plus uses) of the binding under (line, col)
// — find-references. `symRefAt(line, col, k)` returns the k-th such occurrence index,
// whose span is read through the `symOcc*` accessors.
export function symRefsCountAt(line: i32, col: i32) {
  const occ = symOccAt(line, col)
  if occ < 0 { return 0 }
  const binding = symOccDecl[occ]
  let n = 0
  let i = 0
  while i < symOccTok.length {
    if symOccDecl[i] == binding { n = n + 1 }
    i = i + 1
  }
  n
}
export function symRefAt(line: i32, col: i32, k: i32) {
  const occ = symOccAt(line, col)
  if occ < 0 { return -1 }
  const binding = symOccDecl[occ]
  let seen = 0
  let i = 0
  while i < symOccTok.length {
    if symOccDecl[i] == binding {
      if seen == k { return i }
      seen = seen + 1
    }
    i = i + 1
  }
  -1
}
// The retained type-arena index of binding `binding`, or -1 when it kept none.
function bindTypeOf(binding: i32) {
  let i = 0
  while i < symBindNode.length {
    if symBindNode[i] == binding { return symBindType[i] }
    i = i + 1
  }
  -1
}
// ── named function signature (hover) ─────────────────────────────────────────

// A function binding hovers with its parameter names, which `TyFunc` does not carry,
// so this zips the binding's `FuncDecl` parameter names with the type's parameter
// types. "" when that does not apply and the caller falls back to the bare type: not
// `FuncDecl`-declared, not a `TyFunc`, or a parameter count the two disagree on.
function fnSigStr(declNode: i32, ty: i32) {
  if declNode < 0 || declNode >= P.nodes.length { return "" }
  const nd = P.nodes[declNode]
  if !(nd is FuncDecl) { return "" }
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if !(t is TyFunc) { return "" }
  if nd.fnParams.length != t.fnParamTypes.length { return "" }
  let s = "("
  let i = 0
  while i < nd.fnParams.length {
    const pn = P.nodes[nd.fnParams[i]]
    if !(pn is Param) { return "" }
    if i > 0 { s = s + ", " }
    s = s + pn.parName + ": " + tyToStrUser(t.fnParamTypes[i])
    i = i + 1
  }
  s + ") => " + tyToStrUser(t.fnRet)
}
// The rendered type string of the binding under (line, col), or "" when the cursor is
// off any tracked binding or its type is not retained. A `FuncDecl`-declared binding
// renders as its named signature (`fnSigStr`); a use under a flow narrowing renders
// the narrowed type bare, since `fnSigStr` would zip names against a type not in force.
export function symTypeStrAt(line: i32, col: i32) {
  const occ = symOccAt(line, col)
  if occ < 0 { return "" }
  const ty = symOccQueryTy(occ)
  if ty < 0 { return "" }
  if symOccNarrowTy(occ) < 0 {
    const sig = fnSigStr(symOccDecl[occ], ty)
    if sig != "" { return sig }
  }
  tyToStrUser(ty)
}
function inlayPush(k: i32, occ: i32, ty: i32) {
  inlayKind.push(k)
  inlayLine.push(symOccEndLine(occ))
  inlayCol.push(symOccEndCol(occ))
  inlayType.push(tyToStrUser(ty))
  inlayOcc.push(occ)
}
export function symInlayScan() {
  inlayKind = []
  inlayLine = []
  inlayCol = []
  inlayType = []
  inlayOcc = []
  let i = 0
  while i < symOccIsDecl.length {
    if symOccIsDecl[i] == 1 {
      const ty = bindTypeOf(symOccDecl[i])
      if ty >= 0 {
        const k = symOccKindAt(i)
        if k == 2 {
          const t = T.tys[ty]
          if t is TyFunc {
            if !inlayHole(t.fnRet) { inlayPush(1, i, t.fnRet) }
          }
        } else {
          if !inlayHole(ty) { inlayPush(0, i, ty) }
        }
      }
    }
    i = i + 1
  }
  inlayKind.length
}
export function symInlayCount() { inlayKind.length }
export function symInlayKindAt(i: i32) { inlayKind[i] }
export function symInlayLineAt(i: i32) { inlayLine[i] }
export function symInlayColAt(i: i32) { inlayCol[i] }
export function symInlayTypeLen(i: i32) { inlayType[i].length }
export function symInlayTypeCharAt(i: i32, j: i32) { inlayType[i][j] }
export function symInlayOccAt(i: i32) { inlayOcc[i] }
export function redunCount() { redunName.length }
export function redunSLineAt(i: i32) { redunSLine[i] }
export function redunSColAt(i: i32) { redunSCol[i] }
export function redunELineAt(i: i32) { redunELine[i] }
export function redunEColAt(i: i32) { redunECol[i] }
export function redunNameAt(i: i32) { redunName[i] }
export function redunTypeAt(i: i32) { redunType[i] }
export function redunTokAt(i: i32) { redunTok[i] }
// The finding's human message, and the single spelling of it: the CLI report,
// `--fix`'s companion output and the wasm driver's `redunMsg*` byte ABI all read it
// here, so no consumer can drift from another's wording.
export function redunMsgAt(i: i32) {
  "redundant type annotation: `" +
    redunName[i] +
    "` is inferred as `" +
    redunType[i] +
    "` — remove it to lean on inference"
}
// ── dead `??` defaults ───────────────────────────────────────────────────────
// The checker's `rcoal*` findings, read exactly as `redun*` is: count plus per-index
// position, with the message built here so the CLI report and the corpus oracle share
// one spelling.
export function rcoalCount() { rcoalTok.length }
export function rcoalLineAt(i: i32) { rcoalLine[i] }
export function rcoalColAt(i: i32) { rcoalCol[i] }
export function rcoalTokAt(i: i32) { rcoalTok[i] }
// The single spelling of this diagnostic. It says what is dead (the default), why (the
// left operand's type), and what to do — the convention the emitter-capability errors
// follow: name the construct, then the action after an em dash.
export function rcoalMsgAt(i: i32) {
  "this `??` default is never used: `" +
    rcoalType[i] +
    "` is never null — drop the `??` and its default"
}
// ── `is <literal>` over a collapsed operand ──────────────────────────────────
// The checker's `isval*` findings, read exactly as `redun*` and `rcoal*` are.
export function isvalCount() { isvalTok.length }
export function isvalLineAt(i: i32) { isvalLine[i] }
export function isvalColAt(i: i32) { isvalCol[i] }
export function isvalTokAt(i: i32) { isvalTok[i] }
// The single spelling of this diagnostic. It states the type the operand actually has
// (the collapse is invisible in the source), what the test therefore degenerates to,
// and the fix — a distinguishable arm, since `string | "err"` cannot tell a failure
// from a string that reads "err".
export function isvalMsgAt(i: i32) {
  "`" +
    isvalName[i] +
    "` is `" +
    isvalType[i] +
    "` — `is " +
    isvalLit[i] +
    "` is a value test (`==`) and cannot tell a failure from data; give the failure a distinguishable arm (`| null` or a struct)"
}

// Type-alias hover: the rendered type of the user type name (a `type`-declared struct
// or union alias) whose token covers (line, col), or "" when the cursor is off one. A
// type name is not a value-binding occurrence, so this scans the token stream and
// resolves through `cUserTypes`. Builtins are the host's list; containment is end-inclusive.
export function symTypeAliasAt(line: i32, col: i32) {
  let i = 0
  while i < P.toks.length {
    const t = P.toks[i]
    if (
      t.kind == "IDENT" &&
      t.line == line &&
      col >= t.col &&
      col <= t.col + t.text.length
    ) {
      // A multi-module merge renames the entry's own type decls (`W` → `W$m0`), so the
      // map's key is mangled while the token still reads `W`. -1 is a clean miss.
      let ty = cUserTypes[t.text] ?? (-1)
      if ty < 0 { ty = cUserTypes[t.text + "$m0"] ?? (-1) }
      // The one display query that wants the structural render: it is handed the name
      // and asks what it stands for, so a nominal render would answer `Pt` for `Pt`.
      if ty >= 0 { return tyToStructStrUser(ty) }
    }
    i = i + 1
  }
  ""
}
// The rendered type string of the member access whose property name covers (line,
// col) — member hover (`o.x` / `o?.y`). The narrowest covering span wins, and "" means
// the cursor is off any recorded member. End-inclusive, like every position query here.
export function symMemTypeStrAt(line: i32, col: i32) {
  const best = symMemIxAt(line, col)
  if best < 0 { return "" }
  const ty = symMemTy[best]
  if ty < 0 { return "" }
  tyToStrUser(ty)
}
// The recorded member access whose property name covers (line, col), narrowest span
// first, or -1. One home for the walk, because signature help asks the same question
// of the same table, and two copies of a containment rule is how two surfaces come to
// disagree about which member a cursor is on.
function symMemIxAt(line: i32, col: i32) {
  let best = -1
  let bestW = 0
  let i = 0
  while i < symMemNode.length {
    if symMemLine[i] == line && col >= symMemCol[i] && col <= symMemEndCol[i] {
      const w = symMemEndCol[i] - symMemCol[i]
      if best < 0 || w < bestW {
        best = i
        bestW = w
      }
    }
    i = i + 1
  }
  best
}
// Whether type `ty` is a function — the `method` vs `property` distinction for
// semantic tokens. Unwraps a nullable wrapper so an optional method (`o?.fn`)
// still classifies as a method, matching the host member walk.
function symMemIsFn(ty: i32) {
  if ty < 0 { return false }
  const t = T.tys[ty]
  if t is TyNullable { return symMemIsFn(t.nInner) }
  t is TyFunc
}
// Member-access enumeration (semantic tokens): every recorded property name in record
// order, with its span and method-or-property class. The host reads `symMemberCount()`
// then the per-index accessors; line is 1-based, col 0-based, `symMemberLen` is the
// property name's length, and `symMemberIsMethod` is 1 for a function-typed member.
export function symMemberCount() { symMemNode.length }
export function symMemberLine(i: i32) { symMemLine[i] }
export function symMemberCol(i: i32) { symMemCol[i] }
export function symMemberLen(i: i32) { symMemEndCol[i] - symMemCol[i] }
export function symMemberIsMethod(i: i32) {
  if symMemTy[i] == SYM_MEM_METHOD { return 1 }
  if symMemIsFn(symMemTy[i]) { return 1 }
  0
}
// The rendered type string of binding `declNode`, or "" when no type is retained. The
// arena persists for the whole check, so the index renders after the scope closes. A
// user-facing render — its one consumer is the completion detail `symScopeAt` fills —
// so it goes through the user pathway.
export function symBindTypeStr(declNode: i32) {
  let i = 0
  while i < symBindNode.length {
    if symBindNode[i] == declNode {
      const ty = symBindType[i]
      if ty < 0 { return "" }
      return tyToStrUser(ty)
    }
    i = i + 1
  }
  ""
}
// Whether visibility entry `i`'s scope span contains (line, col) — `start`
// inclusive, `stop` inclusive (a cursor at a scope's last column still counts).
function visContainsPos(i: i32, line: i32, col: i32) {
  const afterStart = line > symVisSL[i] ||
    (line == symVisSL[i] && col >= symVisSC[i])
  const beforeEnd = line < symVisEL[i] ||
    (line == symVisEL[i] && col <= symVisEC[i])
  afterStart && beforeEnd
}
// Whether entry `a`'s scope is tighter (more deeply nested) than entry `b`'s — the
// lexical-shadowing tiebreak: a same-line scope compares by column width, a multi-line
// scope by line count.
function visTighter(a: i32, b: i32) {
  const aSame = symVisSL[a] == symVisEL[a]
  const bSame = symVisSL[b] == symVisEL[b]
  if aSame && bSame {
    return (symVisEC[a] - symVisSC[a]) < (symVisEC[b] - symVisSC[b])
  }
  (symVisEL[a] - symVisSL[a]) < (symVisEL[b] - symVisSL[b])
}
// A binding's decl-name token, falling back to its node's anchor token — the
// same fallback the occurrence recorder uses (`symDecl`). `-1` only when the
// node has neither, which the driver's module filter then treats as entry.
function visDeclTok(declNode: i32): i32 {
  const tok = declNameTokOf(declNode)
  if tok >= 0 { return tok }
  if declNode >= 0 && declNode < nodeToks.length { return nodeToks[declNode] }
  -1
}
// Scope-at-position (completion): the user bindings visible at (line, col), computed
// into the `scopeRes*` arrays and returning the count. One binding per name — the
// tightest scope wins. An imported name is recorded mangled (`add$m1`), demangled for
// display, and de-duped on the source name so a local and a same-named import collapse.
export function symScopeAt(line: i32, col: i32) {
  scopeResName = []
  scopeResKind = []
  scopeResType = []
  scopeResRaw = []
  scopeResTok = []
  const resVis: i32[] = []
  const idxByName: {[string]: i32} = Map()
  let i = 0
  while i < symVisName.length {
    if visContainsPos(i, line, col) {
      const nm = demangleName(symVisName[i])
      const existing = idxByName[nm] ?? (-1)
      if existing < 0 {
        idxByName[nm] = scopeResName.length
        scopeResName.push(nm)
        scopeResKind.push(symVisKind[i])
        // `symBindTypeStr` renders through the user pathway, so a mangled type name
        // from a dep-module binding never reaches the completion detail.
        scopeResType.push(symBindTypeStr(symVisNode[i]))
        scopeResRaw.push(symVisName[i])
        scopeResTok.push(visDeclTok(symVisNode[i]))
        resVis.push(i)
      } else if visTighter(i, resVis[existing]) {
        scopeResKind[existing] = symVisKind[i]
        scopeResType[existing] = symBindTypeStr(symVisNode[i])
        scopeResRaw[existing] = symVisName[i]
        scopeResTok[existing] = visDeclTok(symVisNode[i])
        resVis[existing] = i
      }
    }
    i = i + 1
  }
  scopeResName.length
}
export function symScopeNameLen(i: i32) {
  if i < 0 || i >= scopeResName.length { return 0 }
  scopeResName[i].length
}
export function symScopeNameCharAt(i: i32, j: i32) {
  if i < 0 || i >= scopeResName.length { return 0 }
  scopeResName[i][j]
}
export function symScopeKindAt(i: i32) {
  if i < 0 || i >= scopeResKind.length { return 0 }
  scopeResKind[i]
}
export function symScopeTypeLen(i: i32) {
  if i < 0 || i >= scopeResType.length { return 0 }
  scopeResType[i].length
}
export function symScopeTypeCharAt(i: i32, j: i32) {
  if i < 0 || i >= scopeResType.length { return 0 }
  scopeResType[i][j]
}
// Whether `nm` is a plain identifier (so it's dot-accessible) — excludes the
// operator field names (`+`, `==`, …) an object type also carries. Mirrors the
// host's `/^[A-Za-z_][A-Za-z0-9_]*$/` guard.
function isIdentName(nm: string) {
  if nm.length == 0 { return false }
  const c0 = nm[0]
  if !((c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95) {
    return false
  }
  let k = 1
  while k < nm.length {
    const c = nm[k]
    const ok = (c >= 65 && c <= 90) ||
      (c >= 97 && c <= 122) ||
      c == 95 ||
      (c >= 48 && c <= 57)
    if !ok { return false }
    k = k + 1
  }
  true
}
// Soften a receiver type to its member-bearing core: unwrap a nullable (`o?.`).
function memcSoften(ty: i32) {
  if ty < 0 { return ty }
  const t = T.tys[ty]
  if t is TyNullable { return memcSoften(t.nInner) }
  ty
}
function memcPush(nm: string, ds: string, fn: i32) {
  memcName.push(nm)
  memcType.push(ds)
  memcIsFn.push(fn)
}
export function symMemberScanAt(line: i32, col: i32) {
  memcName = []
  memcType = []
  memcIsFn = []
  const occ = symOccAt(line, col)
  if occ < 0 { return 0 }
  // The same choice hover makes (`symOccQueryTy`): a receiver under a flow narrowing
  // offers the narrowed arm's members, and the declared union offers none at all.
  let ty = symOccQueryTy(occ)
  if ty < 0 { return 0 }
  ty = memcSoften(ty)
  if ty < 0 { return 0 }
  const t = T.tys[ty]
  if t is TyObj {
    let k = 0
    while k < t.objFieldNames.length {
      const nm = t.objFieldNames[k]
      if isIdentName(nm) {
        const fty = t.objFieldTypes[k]
        let isfn = 0
        if symMemIsFn(fty) { isfn = 1 }
        memcPush(nm, tyToStrUser(fty), isfn)
      }
      k = k + 1
    }
  } else if t is TyPrim {
    if t.primName == "string" {
      // The string builtin methods the host surfaces, hand-written into the column
      // `tyToStr` fills above, so a signature reads the way VL source spells it (`=>`).
      memcPush("slice", "(i32, i32) => string", 1)
      memcPush("indexOf", "(string) => i32", 1)
      memcPush("includes", "(string) => boolean", 1)
      memcPush("charCodeAt", "(i32) => i32", 1)
      // The Stage 2c codec trio, offered here as well as typed in `typecheck`: the
      // completion table is a sibling ladder that can lag the type rules (§2.7 L6).
      memcPush("cpAt", "(i32) => i32", 1)
      memcPush("cpLen", "() => i32", 0)
      memcPush("isCharBoundary", "(i32) => boolean", 1)
      memcPush("bytes", "() => u8[]", 0)
    }
  }
  memcName.length
}
export function symMemberScanCount() { memcName.length }
export function symMemberScanNameLen(i: i32) {
  if i < 0 || i >= memcName.length { return 0 }
  memcName[i].length
}
export function symMemberScanNameCharAt(i: i32, j: i32) {
  if i < 0 || i >= memcName.length { return 0 }
  memcName[i][j]
}
export function symMemberScanTypeLen(i: i32) {
  if i < 0 || i >= memcType.length { return 0 }
  memcType[i].length
}
export function symMemberScanTypeCharAt(i: i32, j: i32) {
  if i < 0 || i >= memcType.length { return 0 }
  memcType[i][j]
}
export function symMemberScanIsFn(i: i32) {
  if i < 0 || i >= memcIsFn.length { return 0 }
  memcIsFn[i]
}
// ── UFCS candidates at (line, col) ───────────────────────────────────────────

// The other half of `symMemberScanAt`'s answer: the free `self`-functions the receiver
// dispatches to. The test is `ufcsCallTy`'s — first parameter named `self` and the
// receiver assignable to it — so the set cannot advertise a call the checker would
// refuse. Arity is not asked; field precedence is the host's, merging field-first.
function ufcSigStr(declNode: i32, ty: i32) {
  // `fnSigStr` with the receiver row dropped, the same `skip = 1` signature help
  // applies (`sigFill`): `self` is supplied, so showing it would misname argument 1.
  if declNode < 0 || declNode >= P.nodes.length { return "" }
  const nd = P.nodes[declNode]
  if !(nd is FuncDecl) { return "" }
  if ty < 0 { return "" }
  const t = T.tys[ty]
  if !(t is TyFunc) { return "" }
  const pts = t.fnParamTypes
  let s = "("
  let i = 1
  while i < pts.length {
    if i > 1 { s = s + ", " }
    let nm = ""
    if nd.fnParams.length == pts.length {
      const pn = P.nodes[nd.fnParams[i]]
      if pn is Param { nm = pn.parName }
    }
    if nm == "" {
      s = s + tyToStrUser(pts[i])
    } else {
      s = s + nm + ": " + tyToStrUser(pts[i])
    }
    i = i + 1
  }
  s + ") => " + tyToStrUser(t.fnRet)
}
// The receiver type for a UFCS query at (line, col), by either route a caller names
// one: a member access whose property name is under the cursor (the receiver is that
// access's object, whatever expression it is), or a tracked binding occurrence. Route
// 1 first — a bare identifier on a member's property is the property name, not the receiver.
function ufcRecvTyAt(line: i32, col: i32) {
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    let obj = -1
    let pl = 0
    if nd is Member {
      obj = nd.memObj
      pl = nd.memProp.length
    } else if nd is OptMember {
      obj = nd.omObj
      pl = nd.omProp.length
    }
    if obj >= 0 && i < nodeToks.length {
      // The member node's `nodeToks` entry is the property token — the anchor `symMem`
      // spans, plus the unresolved members it never records, which a missing import makes.
      const tk = nodeToks[i]
      if tk >= 0 && tk < P.toks.length {
        const t = P.toks[tk]
        if t.line == line && col >= t.col && col <= t.col + pl {
          const rt = nodeTyIxOf(obj)
          if rt >= 0 { return rt }
        }
      }
    }
    i = i + 1
  }
  const occ = symOccAt(line, col)
  if occ < 0 { return -1 }
  symOccQueryTy(occ)
}
export function symUfcsScanAt(line: i32, col: i32) {
  ufcName = []
  ufcDetail = []
  ufcTok = []
  ufcExported = []
  let ty = ufcRecvTyAt(line, col)
  if ty < 0 { return 0 }
  ty = memcSoften(ty)
  if ty < 0 { return 0 }
  let i = 0
  while i < symBindNode.length {
    if symBindKind[i] == 2 {
      const d = symBindNode[i]
      if d >= 0 && d < P.nodes.length {
        const nd = P.nodes[d]
        if nd is FuncDecl {
          if nd.fnParams.length > 0 {
            const p0 = P.nodes[nd.fnParams[0]]
            if p0 is Param {
              if p0.parName == "self" {
                const fty = symBindType[i]
                if fty >= 0 {
                  const ft = T.tys[fty]
                  if ft is TyFunc {
                    if ft.fnParamTypes.length > 0 {
                      if assignable(ty, ft.fnParamTypes[0]) {
                        ufcName.push(demangleName(nd.fnName))
                        ufcDetail.push(ufcSigStr(d, fty))
                        ufcTok.push(declNameTokOf(d))
                        if declHasExportKw(d) {
                          ufcExported.push(1)
                        } else {
                          ufcExported.push(0)
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    i = i + 1
  }
  ufcName.length
}
export function symUfcsScanCount() { ufcName.length }
export function symUfcsScanNameLen(i: i32) {
  if i < 0 || i >= ufcName.length { return 0 }
  ufcName[i].length
}
export function symUfcsScanNameCharAt(i: i32, j: i32) {
  if i < 0 || i >= ufcName.length { return 0 }
  ufcName[i][j]
}
export function symUfcsScanDetailLen(i: i32) {
  if i < 0 || i >= ufcDetail.length { return 0 }
  ufcDetail[i].length
}
export function symUfcsScanDetailCharAt(i: i32, j: i32) {
  if i < 0 || i >= ufcDetail.length { return 0 }
  ufcDetail[i][j]
}
// Candidate `i`'s decl-name token — the driver maps it to the owning module
// (`modOfTok`), which is the module key the host writes an import from.
export function symUfcsScanTokAt(i: i32) {
  if i < 0 || i >= ufcTok.length { return -1 }
  ufcTok[i]
}
// 1 when candidate `i`'s declaration carried an `export` modifier. An unexported
// candidate in a dep module cannot be imported and must not be offered; one in the
// entry module needs no import either way, so the caller — the side that knows which
// module is the entry — applies the flag rather than this scan dropping the row.
export function symUfcsScanExportedAt(i: i32) {
  if i < 0 || i >= ufcExported.length { return 0 }
  ufcExported[i]
}
// ── signature help: the callee's parameter table at (line, col) ──────────────

// `fnSigStr` answers what a function looks like; this answers which of its parameters
// is argument 3. The same zip kept in columns — `check_state.vl`'s `sigParName` block
// says why the rendered string cannot serve the second question. A pure query over
// what the check recorded: it records nothing and changes no diagnostics or bytes.

// One parameter row. The type renders through the user pathway, like every other
// string leaving this file.
function sigPush(nm: string, ty: i32, dflt: string) {
  sigParName.push(nm)
  sigParType.push(tyToStrUser(ty))
  sigParDefault.push(dflt)
  0
}

// A parameter default as source text, or "" when the parameter has none. A local
// renderer rather than `format.vl`'s `expr`, since the formatter is a later layer and
// the admitted set is closed by the checker's own `paramDefaultIsLiteral`. The `Ident`
// arm demangles: a module `const` default reads `SEP$m1` in the merged arena.
function sigDefaultText(pIx: i32): string {
  const dIx = paramDefaultOf(pIx)
  if dIx < 0 { return "" }
  const d = P.nodes[dIx]
  if d is NumLit { return d.numText }
  if d is StrLit { return d.strText }
  if d is CharLit { return d.charText }
  if d is BoolLit {
    if d.boolVal == 1 { return "true" }
    return "false"
  }
  if d is NullLit { return d.nullKw }
  if d is Ident { return demangleName(d.identName) }
  if d is Unary {
    const inner = P.nodes[d.unArg]
    if inner is NumLit { return d.unOp + inner.numText }
  }
  ""
}
// Fill the table from function type `ty`, naming the parameters off `declNode`'s
// `FuncDecl` when there is one and it agrees on arity — a disagreeing pair would label
// argument k with parameter k+1's name. `skip` drops leading parameters, 1 for a UFCS
// call. Returns the row count, or -1 when `ty` is not a function.
function sigFill(declNode: i32, ty: i32, skip: i32) {
  if ty < 0 { return -1 }
  const t = T.tys[ty]
  if !(t is TyFunc) { return -1 }
  const pts = t.fnParamTypes
  if skip > pts.length { return -1 }
  const names: string[] = []
  const dflts: string[] = []
  if declNode >= 0 && declNode < P.nodes.length {
    const nd = P.nodes[declNode]
    if nd is FuncDecl {
      if nd.fnParams.length == pts.length {
        let i = 0
        while i < nd.fnParams.length {
          const pn = P.nodes[nd.fnParams[i]]
          if pn is Param { names.push(pn.parName) } else { names.push("") }
          // Same arity gate as the names, and for the same reason: a
          // disagreeing pair would attach parameter k+1's default to argument k.
          dflts.push(sigDefaultText(nd.fnParams[i]))
          i = i + 1
        }
      }
    }
  }
  let k = skip
  while k < pts.length {
    let nm = ""
    if k < names.length { nm = names[k] }
    let df = ""
    if k < dflts.length { df = dflts[k] }
    sigPush(nm, pts[k], df)
    k = k + 1
  }
  sigRet = tyToStrUser(t.fnRet)
  pts.length - skip
}
// The declaring node of a free `self`-function named `nm`, or -1 — the emitter's UFCS
// rule (`emit_rewrite.drwSelfFnOf`): a top-level function whose first parameter is
// named `self`, matched on the demangled name since a merge renames declarations but
// not the property token. A display query: neither arity nor receiver type is asked.
function sigSelfFnDeclOf(nm: string) {
  let i = 0
  while i < symBindNode.length {
    if symBindKind[i] == 2 {
      const d = symBindNode[i]
      if d >= 0 && d < P.nodes.length {
        const nd = P.nodes[d]
        if nd is FuncDecl {
          if demangleName(nd.fnName) == nm && nd.fnParams.length > 0 {
            const p0 = P.nodes[nd.fnParams[0]]
            if p0 is Param {
              if p0.parName == "self" { return d }
            }
          }
        }
      }
    }
    i = i + 1
  }
  -1
}
// The identifier token text at (line, col), or "" — the member property name a
// position query lands on when the cursor is not on a tracked occurrence.
// End-inclusive, like every position query in this file.
function sigIdentAt(line: i32, col: i32) {
  let i = 0
  while i < P.toks.length {
    const t = P.toks[i]
    if (
      t.kind == "IDENT" &&
      t.line == line &&
      col >= t.col &&
      col <= t.col + t.text.length
    ) {
      return t.text
    }
    i = i + 1
  }
  ""
}
// The parameter table of the function being called, whose name is at (line, col);
// returns the parameter count, or -1 when nothing there is callable. Three routes: a
// tracked binding; a member whose type resolved (a UFCS callee carries
// `SYM_MEM_METHOD` and falls past); UFCS itself, `self` row dropped.
export function symSigAt(line: i32, col: i32) {
  sigParName = []
  sigParType = []
  sigParDefault = []
  sigRet = ""
  const occ = symOccAt(line, col)
  if occ >= 0 { return sigFill(symOccDecl[occ], symOccQueryTy(occ), 0) }
  const mi = symMemIxAt(line, col)
  if mi >= 0 {
    if symMemTy[mi] >= 0 {
      const n = sigFill(-1, symMemTy[mi], 0)
      if n >= 0 { return n }
    }
  }
  const nm = sigIdentAt(line, col)
  if nm == "" { return -1 }
  const d = sigSelfFnDeclOf(nm)
  if d < 0 { return -1 }
  sigFill(d, bindTypeOf(d), 1)
}
export function symSigParamNameLen(i: i32) {
  if i < 0 || i >= sigParName.length { return 0 }
  sigParName[i].length
}
export function symSigParamNameCharAt(i: i32, j: i32) {
  if i < 0 || i >= sigParName.length { return 0 }
  sigParName[i][j]
}
export function symSigParamTypeLen(i: i32) {
  if i < 0 || i >= sigParType.length { return 0 }
  sigParType[i].length
}
export function symSigParamTypeCharAt(i: i32, j: i32) {
  if i < 0 || i >= sigParType.length { return 0 }
  sigParType[i][j]
}
export function symSigParamDefaultLen(i: i32) {
  if i < 0 || i >= sigParDefault.length { return 0 }
  sigParDefault[i].length
}
export function symSigParamDefaultCharAt(i: i32, j: i32) {
  if i < 0 || i >= sigParDefault.length { return 0 }
  sigParDefault[i][j]
}
export function symSigRetLen() { sigRet.length }
export function symSigRetCharAt(j: i32) { sigRet[j] }
