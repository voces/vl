// Null folding and list-twin merging over a substituted union.
// Does not import the checker.
import { substLitBoxNested, tyIsNulStrBoxUnion } from "./check_ty_rep"
import { flattenVariantsInto, isNullTy } from "./tyquery"
import {
  T,
  TY_NULL,
  TY_STR,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  tyAt,
  tyEq,
} from "./check_types"
import { mkUnionTy } from "./check_union_mint"
import { i32ListHas } from "./listutil"

// Whether `kept` already holds the list type `m` at another arena index: a list of the same
// element type, so `Rec[]` and a same-shape `Rec2[]` are one list, as the annotation route
// spells them (D14770).
function substListTwinIn(kept: i32[], m: i32): boolean {
  if m < 0 || m >= T.tys.length || !(tyAt(m) is TyArray) { return false }
  for k in kept {
    if k >= 0 && k < T.tys.length && tyAt(k) is TyArray && tyEq(k, m) {
      return true
    }
  }
  false
}

// The inner a substituted `(...) | null` wraps: `u` itself, or, when a bound parameter put a null
// inside it (`A | B` at `A := string | null`), its members once each with the nulls folded into the
// wrapper — one type alone, else their union (D3499).
export function nullableFlatInner(u: i32): i32 {
  if u < 0 || u >= T.tys.length { return u }
  const ut = tyAt(u)
  if !(ut is TyUnion) { return u }
  let nested = false
  for m in ut.uMembers {
    if m >= 0 && m < T.tys.length && (isNullTy(m) || tyAt(m) is TyNullable) {
      nested = true
    }
  }
  if !nested { return u }
  const ms: i32[] = []
  flattenVariantsInto(u, ms)
  const kept: i32[] = []
  for m in ms {
    if !isNullTy(m) && !i32ListHas(kept, m) && !substListTwinIn(kept, m) {
      kept.push(m)
    }
  }
  if kept.length == 0 { return u }
  if kept.length == 1 { return kept[0] }
  mkUnionTy(kept)
}

// The members of a substituted union with every null folded out, when the substitution left a
// nullable member or bound a parameter to `null` (`(A | null) | B`, `A | B` at `A := T | null`);
// empty when it did not. A declared bare `null` member keeps its shape.
export function substUnionNullFolded(ms: i32[], out: i32[]): i32[] {
  const res: i32[] = []
  if substNullFoldOff { return res }
  let nested = false
  let i = 0
  while i < out.length && i < ms.length {
    const m = out[i]
    if m >= 0 && m < T.tys.length && tyAt(m) is TyNullable { nested = true }
    if isNullTy(m) && !isNullTy(ms[i]) { nested = true }
    i = i + 1
  }
  if !nested { return res }
  const flat: i32[] = []
  for m in out {
    // A `K | L | null` box binding is the `string | null` an instance pins it at, so the
    // call and the instance fold it alike (D3382 converts the box at the argument).
    if tyIsNulStrBoxUnion(m) {
      flat.push(TY_STR)
      flat.push(TY_NULL)
    } else {
      flattenVariantsInto(m, flat)
    }
  }
  for m in flat {
    if !isNullTy(m) { res.push(m) }
  }
  // Two distinct lists, one of records, keep the nesting: that nullable union is not yet built
  // at every reader (its flat spelling fails there too), and the nested one runs at some.
  if substFoldListCount(res) > 1 && substFoldHasRecordList(res) {
    const none2: i32[] = []
    return none2
  }
  res
}

// Set while an instance is built for a pin spelled `K | (L | null)`: its softened pin drops the
// nested null, so the instance keeps the call's unfolded union rather than fold alone.
let substNullFoldOff = false

// Sets `substNullFoldOff` when a pin is that spelling; the previous setting, to restore.
export function substNullFoldOffFor(pins: i32[]): boolean {
  const was = substNullFoldOff
  let off = false
  for p in pins {
    if substLitBoxNested(p) { off = true }
  }
  substNullFoldOff = off
  was
}

// Restores `substNullFoldOff` to `was`.
export function substNullFoldRestore(was: boolean) {
  substNullFoldOff = was
  0
}

// Whether a member of `ms` is a list whose element, through lists and nullables, is not a primitive.
function substFoldHasRecordList(ms: i32[]): boolean {
  for m in ms {
    if m >= 0 && m < T.tys.length && tyAt(m) is TyArray {
      if !substLeafIsPrim(m, 16) { return true }
    }
  }
  false
}

// Whether `ty`, seen through lists and nullables, is a primitive.
function substLeafIsPrim(ty: i32, depth: i32): boolean {
  if ty < 0 || ty >= T.tys.length || depth <= 0 { return false }
  const t = tyAt(ty)
  match t {
    TyPrim => true
    TyArray => substLeafIsPrim(t.aElem, depth - 1)
    TyNullable => substLeafIsPrim(t.nInner, depth - 1)
    // A record, union or any other leaf is not one primitive.
    TyErr | TyObj | TyFunc | TyUnion | TyMap | TyVar | TyLit | TyNeg => false
  }
}

// The number of distinct list types among `ms`.
function substFoldListCount(ms: i32[]): i32 {
  const lists: i32[] = []
  for m in ms {
    if m >= 0 && m < T.tys.length && tyAt(m) is TyArray {
      if !i32ListHas(lists, m) && !substListTwinIn(lists, m) { lists.push(m) }
    }
  }
  lists.length
}
