// The IR shadow (ir-design-2026-11.md §5.2, step I0): with the shadow armed, `emitFuncCode`
// hands each function here after its legacy lowering. The phase-A builder covers I1's set
// (constants, primitive ops, locals, `if`/loops/`break`/`continue`/`return`, direct calls and
// globals); any other construct leaves the function uncovered, a counted reason, not an error.
// A covered function is verified and then discarded: nothing is claimed, so no byte moves.
import {
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  FuncDecl,
  Ident,
  IfStmt,
  Index,
  LetDecl,
  Member,
  NullLit,
  NumLit,
  P,
  Param,
  Paren,
  RetStmt,
  Spread,
  StrLit,
  Unary,
  WhileStmt,
  hasNamedArgs,
  i32ToStr,
  nodeAt,
} from "./ast"
import {
  IrFamily,
  IrFn,
  IrNode,
  OImm,
  OStr,
  OVar,
  Opnd,
  PrimOp,
  Rhs,
  SLet,
  StrOp,
  binPrimOp,
  irBodyLeaves,
  irFnNew,
  irFnText,
  irGlobalNote,
  irNodeFamily,
  irNodeNew,
  irSigNote,
  irSpanNote,
  irVarNew,
} from "./ir"
import { repIsNoValue, repIsScalar, repPrim, repWhat } from "./ir"
import { irTyOpen, irVerify, numKindOf } from "./ir_verify"
import {
  irAstKind,
  irDualEmit,
  irHexOf,
  irLowerClaim,
  irLoweredEntry,
} from "./ir_lower"
import {
  BinNulTest,
  GlobalCtx,
  atomEqPlanOf,
  binNulTestOf,
  binNumWidth,
  boxOwedAt,
  callEndsNever,
  deadNullTestOperand,
  globalReadRecovers,
  idxStorePlainWhy,
  idxStorePlanOf,
  nulNoneEqSides,
  nulTestArmOf,
  nullOwnIsAtom,
  numLitAsApplies,
  popPlanOf,
  popStmtPlainWhy,
  pushPlainWhy,
  pushPlanOf,
  strLitTakesAtom,
  widenPlanOf,
} from "./wasmEmit"
import {
  RAtom,
  RList,
  RNullable,
  repNodeAt,
  repNodeGen,
  repNodeOfTy,
  repTyOf,
} from "./emit_rep"
import { ctxTyAt, nodeTyAt, scopeTyAt } from "./emit_capture_frames"
import { isBlockBody } from "./block_body"
import {
  declaredIndexAt,
  envSlotShift,
  exprIsStrMethod,
  exprMap,
  fnIndexOfNode,
  localIndexOf,
} from "./emit_classify"
import { declaredSlotOfDecl } from "./emit_struct_order"
import { fRecRetTy, fRetVoid, fnStmts, gPromoInStart } from "./emit_state"
import { fnCheckedRetTy, globalIndexOfSid } from "./emit_fn_ret_kinds"
import { identDeclOf, sidOfNode } from "./symbols"
import { memOffsetLexValue } from "./check_intrinsics"
import { charLitCp, unwrapParen } from "./emit_base"
import { f32Bytes, f64Bytes, numLexIsFloat } from "./emit_bignum"
import { isVoidTy } from "./tyquery"
import { TY_BOOL, TY_I32, TY_NEVER, tyScalarBasePrim } from "./check_types"

let ibArmed = false
let ibDetail = false
let ibCorrupt = 0
let ibRowKey: string[] = []
let ibRowN: i32[] = []

// Arms (1) or disarms (0) the shadow for the compiles that follow; 2 also details the first
// examples of each dual-emit mismatch class. 3 leaves it disarmed and claims I1's families
// (scalar, control, call, global), the test of the claim path itself. 4 is the blocker census:
// each function's build goes on past a missed statement, and its row names every class it missed.
export function irShadowArm(on: i32) {
  ibArmed = on == 1 || on == 2 || on == 4
  ibDetail = on == 2
  ibClaimAll = on == 3
  ibAllMiss = on == 4
  return 0
}

let ibAllMiss = false
// The classes the blocker census met in the function being built.
let ibMisses: string[] = []
// How many misses the census let the build go on past, so a statement can tell it built whole.
let ibMissesPast = 0

// Under the census, records `why` and lets the build go on; otherwise answers it.
function censusGoesOn(why: string): boolean {
  if !ibAllMiss { return false }
  ibMissesPast = ibMissesPast + 1
  for m in ibMisses {
    if m == why { return true }
  }
  ibMisses.push(why)
  return true
}

// The families whose every occurrence the shadow has matched, so a function built wholly of them
// ships the IR's bytes and legacy does not run for it (design §10). A slice adds its family here.
const CLAIMED: IrFamily[] = []
let ibClaimAll = false

function familyClaimed(fam: IrFamily): boolean {
  if ibClaimAll { return fam != "list" && fam != "other" }
  for c in CLAIMED {
    if c == fam { return true }
  }
  return false
}

// Whether every node of the function just built is in a claimed family. A local or parameter of a
// reference rep is the list family's.
function claimable(): boolean {
  if CLAIMED.length == 0 && !ibClaimAll { return false }
  for n in ib.irNodes {
    if !familyClaimed(irNodeFamily(n)) { return false }
  }
  for v in ib.irVars {
    if v.vSlot >= 0 && !repIsScalar(v.vRep) && !familyClaimed("list") {
      return false
    }
  }
  return true
}

// The claim seam, before legacy lowers the function at `fnIx` (`fnStmts` slot `fnPos`): when the
// builder covers it and every node is claimed, the lowering writes its code entry onto `out` and
// this answers true, so legacy does not run. Armed, legacy always runs and the shadow checks it.
export function irClaimFn(fnIx: i32, fnPos: i32, out: u8[]): boolean {
  // Nothing claimed builds nothing: the predicate's cost is paid only once a family is claimed.
  if ibArmed || CLAIMED.length == 0 && !ibClaimAll { return false }
  const gen = repNodeGen()
  if build(fnIx, fnPos) != "" || repNodeGen() != gen || !claimable() {
    return false
  }
  if irVerify(ib).vfRule != 0 {
    count("claim fell back: verifier")
    return false
  }
  const why = irLowerClaim(ib, globalCtxOf(fnPos), fnPos, out)
  if why != "" {
    count("claim fell back: " + why)
    return false
  }
  count("claimed")
  return true
}

// The shadow's failing controls: 0 none; 1 swaps the first variable's rep and 2 deletes the first
// temp's definition, which the verifier must refuse; 3 adds a byte to the lowering and 4 drops a
// span row, which the dual emit must report.
export function irShadowCorrupt(k: i32) {
  ibCorrupt = k
  return 0
}

export function irShadowArmed(): boolean { return ibArmed }

// Starts a compile's report.
export function irShadowBegin() {
  ibRowKey = []
  ibRowN = []
  return 0
}

function count(key: string) {
  let i = 0
  while i < ibRowKey.length {
    if ibRowKey[i] == key {
      ibRowN[i] = ibRowN[i] + 1
      return 0
    }
    i = i + 1
  }
  ibRowKey.push(key)
  ibRowN.push(1)
  return 0
}

export function irShadowRowCount() { return ibRowKey.length }

export function irShadowRowLen(i: i32) { return ibRowKey[i].length }

export function irShadowRowAt(i: i32, j: i32) { return ibRowKey[i][j] }

export function irShadowRowN(i: i32) { return ibRowN[i] }

// The function being built and the first construct outside the set.
let ib: IrFn = irFnNew(-1, "")
let ibFnIx = -1
// Whether the builder admits an assignment as a value. It does not, so no global read it builds
// is an assignment's re-read and the lowering's guard context is never `gcGuardOff`.
const ASSIGN_AS_VALUE = false
let ibMiss = ""
let ibDeclVar: {[i32]: i32} = Map()
let ibLoopName: string[] = []
let ibLoopBrk: i32[] = []
let ibLoopCont: i32[] = []
let ibLabelN = 0
let ibBool = -1
let ibNoValue = -1

// Whether a value of rep `r` and type `ty` can be a variable, a parameter, a result or an
// expression here: a scalar, or a reference rep the list builder admits.
function valueRep(r: i32, ty: i32): boolean {
  return repIsScalar(r)
    || repNodeAt(r) is RAtom
    || boxedNullable(r)
    || atomNullable(r)
    || irVarRepOkHook(r, ty)
}

// Whether rep `r` is a literal-union atom's `K | null` (discipline 3): the id, or a sentinel.
function atomNullable(r: i32): boolean {
  const n = repNodeAt(r)
  return n is RNullable && n.rnDisc == 3
}

// Whether rep `r` is a nullable boxed as a union is (discipline 4): `{tag, payload}`.
function boxedNullable(r: i32): boolean {
  const n = repNodeAt(r)
  return n is RNullable && n.rnDisc == 4
}

function refRepNone(_r: i32, _ty: i32): boolean { return false }

function indexUnset(_b: i32[], _ix: i32, _rep: i32): Opnd {
  return irBMiss("index hook not installed")
}

function memberUnset(_b: i32[], _ix: i32, _rep: i32): Opnd {
  return irBMiss("member hook not installed")
}

function inPlaceNone(_ix: i32, _fnIx: i32): boolean { return false }

function strBinUnset(_b: i32[], _ix: i32, _rep: i32): Opnd {
  return irBMiss(STR_OPERAND)
}

// The list builder's hooks (`ir_build_ref.vl`), installed before emit; the defaults leave every
// reference rep, element read and member read outside the set.
export let irVarRepOkHook: (r: i32, ty: i32) => boolean = refRepNone
export let irIndexHook: (b: i32[], ix: i32, rep: i32) => Opnd = indexUnset
export let irMemberHook: (b: i32[], ix: i32, rep: i32) => Opnd = memberUnset
export let irStrBinHook: (b: i32[], ix: i32, rep: i32) => Opnd = strBinUnset
export let irInPlaceHook: (ix: i32, fnIx: i32) => boolean = inPlaceNone

// The function being built, its declaration, and the rep a statement node carries.
export function irBFn(): IrFn { return ib }

export function irBFnIx(): i32 { return ibFnIx }

export function irBNoValue(): i32 { return ibNoValue }

export function irBMiss(why: string): Opnd {
  if ibMiss == "" { ibMiss = why }
  const o: Opnd = { ov: -1 }
  return o
}

// `miss` for a statement, which yields nothing.
function skip(why: string): i32 {
  irBMiss(why)
  return 0
}

function missRhs(why: string): Rhs {
  irBMiss(why)
  const r: Rhs = { ggSym: -1, ggNonNull: false }
  return r
}

export function irBNode(b: i32[], n: IrNode, ty: i32, rep: i32, at: i32) {
  b.push(irNodeNew(ib, n, ty, rep, at))
  return 0
}

// Builds `stmts` into a fresh body and returns it.
function bodyOf(stmts: i32[]): i32[] {
  const nb: i32[] = []
  for s in stmts { stmt(nb, s) }
  return nb
}

// The rep of node `ix`'s checked type in this instance when it is a primitive one, else -1.
function primRepOf(ix: i32): i32 {
  // The tree gives `void` an i32 leaf for the flat kinds; it is no value here.
  const t = nodeTyAt(ix, ibFnIx)
  const r = repNodeOfTy(t)
  if isVoidTy(t) || !valueRep(r, t) { return -1 }
  return r
}

export function irBOpRep(o: Opnd): i32 {
  return match o {
    OVar => if o.ov >= 0 && o.ov < ib.irVars.length { ib.irVars[o.ov].vRep } else { -1 }
    OImm => o.oiRep
    OStr => o.osRep
  }
}

// A fresh temp of `ix`'s type, defined by `rhs`.
export function irBLetTemp(b: i32[], rhs: Rhs, ix: i32, rep: i32): Opnd {
  const ty = nodeTyAt(ix, irBFnIx())
  const v = irVarNew(irBFn(), rep, ty, "temp", -1)
  irBNode(b, { lDst: v, lRhs: rhs }, ty, rep, ix)
  const o: Opnd = { ov: v }
  return o
}

// The variable of local declaration `d` (a `LetDecl` or a `Param`), made on first use.
export function irBDeclVar(d: i32): i32 {
  const known = ibDeclVar[d] ?? -1
  if known >= 0 { return known }
  const ty = scopeTyAt(d, ibFnIx)
  const rep = repNodeOfTy(ty)
  if isVoidTy(ty) || !valueRep(rep, ty) {
    irBMiss("local rep " + repWhat(rep))
    return -1
  }
  if irTyOpen(ty) {
    irBMiss("open local type")
    return -1
  }
  const s = declaredSlotOfDecl(d)
  const slot = if s >= 0 { declaredIndexAt(ibFnIx, s) } else { -1 }
  // One variable per wasm local: an instance's read resolves to the template's declaration.
  const held = localVarAt(slot)
  if held >= 0 {
    if ib.irVars[held].vRep != rep {
      irBMiss("local slot shared across reps")
      return -1
    }
    ibDeclVar[d] = held
    return held
  }
  const v = irVarNew(ib, rep, ty, "local", slot)
  ibDeclVar[d] = v
  return v
}

// The local variable holding wasm local `w`, or -1.
function localVarAt(w: i32): i32 {
  if w < 0 { return -1 }
  let v = 0
  while v < ib.irVars.length {
    const x = ib.irVars[v]
    if x.vKind == "local" && x.vSlot == w { return v }
    v = v + 1
  }
  return -1
}

// `a && b` / `a || b`: a local the two arms of an `if` write.
function shortCircuit(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const l = irBExpr(b, n.binLeft)
  if ibMiss != "" || irBOpRep(l) != ibBool { return irBMiss("logical operand") }
  const ty = nodeTyAt(ix, ibFnIx)
  const t = irVarNew(ib, rep, ty, "local", -1)
  const rhsBody: i32[] = []
  const r = irBExpr(rhsBody, n.binRight)
  if irBOpRep(r) != ibBool { return irBMiss("logical operand") }
  irBNode(rhsBody, { asDst: t, asSrc: r }, -1, irBNoValue(), ix)
  const fixBody: i32[] = []
  const bits: i64 = if n.binOp == "&&" { 0 } else { 1 }
  const fixed: Opnd = { oiRep: ibBool, oiBits: bits }
  irBNode(fixBody, { asDst: t, asSrc: fixed }, -1, ibNoValue, ix)
  if n.binOp == "&&" {
    irBNode(
      b,
      { siCond: l, siThen: rhsBody, siElse: fixBody, siOut: t },
      ty,
      rep,
      ix,
    )
  } else {
    irBNode(
      b,
      { siCond: l, siThen: fixBody, siElse: rhsBody, siOut: t },
      ty,
      rep,
      ix,
    )
  }
  const o: Opnd = { ov: t }
  return o
}

function numLit(n: NumLit, rep: i32): Opnd {
  const k: string = repPrim(rep) ?? ""
  if k == "f64" || k == "f32" {
    const bs = if k == "f64" { f64Bytes(n.numText) } else { f32Bytes(n.numText) }
    let bits: i64 = 0
    let i = bs.length - 1
    while i >= 0 {
      bits = bits * 256 + ((bs[i] & 255) as i64)
      i = i - 1
    }
    const f: Opnd = { oiRep: rep, oiBits: bits }
    return f
  }
  if numLexIsFloat(n.numText) { return irBMiss("float literal at an integer") }
  const v = memOffsetLexValue(n.numText)
  if v < 0 || k == "i32" && v > 2147483647 { return irBMiss("wide literal") }
  const o: Opnd = { oiRep: rep, oiBits: v }
  return o
}

function identRead(b: i32[], n: Ident, ix: i32, rep: i32): Opnd {
  const d = identDeclOf(ix)
  if d < 0 { return irBMiss("unresolved read") }
  const dn = nodeAt(d)
  const w = localIndexOf(ibFnIx, ix)
  if (dn is LetDecl || dn is Param) && w >= 0 {
    // A parameter is found by its wasm index: an instance's read resolves to the template's.
    const v = if dn is Param { paramVarAt(w) } else { irBDeclVar(d) }
    if v < 0 { return irBMiss("local rep") }
    if ib.irVars[v].vRep != rep { return irBMiss("narrowed read") }
    const o: Opnd = { ov: v }
    return o
  }
  const g = globalIndexOfSid(sidOfNode(ix))
  if dn is LetDecl && g >= 0 {
    if globalRep(g, d) != rep { return irBMiss("global read coercion") }
    const sid = sidOfNode(ix)
    return irBLetTemp(
      b,
      { ggSym: g, ggNonNull: globalReadRecovers(sid, ix, ibFnIx) },
      ix,
      rep,
    )
  }
  return irBMiss("read of " + n.identName)
}

// The parameter variable holding wasm local `w`, or -1.
function paramVarAt(w: i32): i32 {
  for v in ib.irParams {
    if ib.irVars[v].vSlot == w { return v }
  }
  return -1
}

// The rep of global `g`, declared at `d`, noted in `ib`; -1 when it is no scalar.
function globalRep(g: i32, d: i32): i32 {
  const ty = scopeTyAt(d, -1)
  const r = repNodeOfTy(ty)
  if isVoidTy(ty) || !valueRep(r, ty) { return -1 }
  irGlobalNote(ib, g, r)
  return r
}

// The result type of the function at `fnStmts` slot `pos` (declared at `d`, annotated by `ann`):
// its annotation, else the checker's inferred result, else its recorded type's; -1 for none.
function resultTy(pos: i32, ann: i32, d: i32): i32 {
  if ann >= 0 { return nodeTyAt(ann, d) }
  const t = fnCheckedRetTy(pos)
  if t >= 0 { return t }
  return if pos >= 0 && pos < fRecRetTy.length { fRecRetTy[pos] } else { -1 }
}

// The result rep of that function. Legacy's voidness (`fRetVoid`) decides no value, as its
// functype does; the tree gives `void` an i32 leaf, so no value is `never`'s rep.
function resultRep(pos: i32, ann: i32, d: i32): i32 {
  if pos >= 0 && pos < fRetVoid.length && fRetVoid[pos] == 1 {
    return repNodeOfTy(TY_NEVER)
  }
  const rt = resultTy(pos, ann, d)
  return if isVoidTy(rt) { repNodeOfTy(TY_NEVER) } else { repNodeOfTy(rt) }
}

// The parameter and result reps of `fnStmts` slot `pos`, noted in `ib`; false when one is not
// a primitive or void rep.
function calleeSig(pos: i32): boolean {
  if pos < 0 || pos >= fnStmts.length { return false }
  const d = fnStmts[pos]
  const fn = nodeAt(d)
  if !(fn is FuncDecl) { return false }
  const ps: i32[] = []
  for p in fn.fnParams {
    const pt = scopeTyAt(p, d)
    const r = repNodeOfTy(pt)
    if !valueRep(r, pt) { return false }
    ps.push(r)
  }
  const rr = resultRep(pos, fn.fnRet, d)
  if !(valueRep(rr, resultTy(pos, fn.fnRet, d)) || repIsNoValue(rr)) {
    return false
  }
  irSigNote(ib, pos, ps, rr)
  return true
}

// A direct call `ix` of a declared, capture-free function by name; its arguments by position.
function callRhs(b: i32[], c: Call, ix: i32): Rhs {
  if c.callFn < 0 || hasNamedArgs(c.callArgNames) {
    return missRhs("named call")
  }
  const cf = nodeAt(c.callFn)
  if cf is Member { return methodRhs(b, c, cf, ix) }
  if !(cf is Ident) { return missRhs("indirect call") }
  const d = identDeclOf(c.callFn)
  if d < 0 || !(nodeAt(d) is FuncDecl) {
    return missRhs("call of a non-declaration")
  }
  const pos = fnIndexOfNode(c.callFn)
  if pos < 0 || pos >= fnStmts.length || fnStmts[pos] != d {
    return missRhs("call target")
  }
  if !calleeSig(pos) { return missRhs("callee signature") }
  const callee = nodeAt(d)
  const args: Opnd[] = []
  if callee is FuncDecl {
    if callee.fnParams.length != c.callArgs.length {
      return missRhs("argument count")
    }
    let i = 0
    while i < c.callArgs.length {
      const a = irBExpr(b, c.callArgs[i])
      if ibMiss != "" { return missRhs("argument") }
      if irBOpRep(a) != repNodeOfTy(scopeTyAt(callee.fnParams[i], d)) {
        return missRhs("argument coercion")
      }
      args.push(a)
      i = i + 1
    }
  }
  const r: Rhs = { caCallee: pos, caArgs: args, caNever: callEndsNever(ix) }
  return r
}

// A string method legacy's call ladder takes by name (`exprIsStrMethod`): its receiver and
// arguments, then legacy's own tail. Any other method is a miss that names it.
function methodRhs(b: i32[], c: Call, m: Member, ix: i32): Rhs {
  if (
    m.memProp == "push"
    && c.callArgs.length == 1
    && !(nodeAt(c.callArgs[0]) is Spread)
  ) {
    return pushRhs(b, c, m, ix)
  }
  let op: StrOp = "slice"
  if exprIsStrMethod(ix, ibFnIx, "cpLen") {
    op = "cplen"
  } else if !exprIsStrMethod(ix, ibFnIx, "slice") {
    return missRhs("method " + m.memProp)
  }
  const args: Opnd[] = [irBExpr(b, m.memObj)]
  for a in c.callArgs { args.push(irBExpr(b, a)) }
  if ibMiss != "" { return missRhs("method operand") }
  // The receiver is a string and every argument an i32.
  let i = 0
  while i < args.length {
    const p = repPrim(irBOpRep(args[i]))
    if p == null || (if i == 0 { p != "str" } else { p != "i32" }) {
      return missRhs("method operand coercion")
    }
    i = i + 1
  }
  const r: Rhs = { soOp: op, soArgs: args, soAt: ix }
  return r
}

// Whether call `c` is a no-argument `.pop()`.
function isPopStmt(c: Call): boolean {
  if c.callFn < 0 || c.callArgs.length != 0 { return false }
  const f = nodeAt(c.callFn)
  return f is Member && f.memProp == "pop"
}

// A `.pop()` statement legacy writes as its checked take-and-drop (`popStmtPlainWhy`).
function popStmt(b: i32[], c: Call, ix: i32) {
  const pq = popPlanOf(ix, ibFnIx)
  // No plan is a ref or string list, which legacy pops checked as a ref.
  if pq == null { return skip("pop ref element") }
  const why = popStmtPlainWhy(pq, ix, ibFnIx)
  if why != "" { return skip(why) }
  if c.callFn < 0 || c.callFn >= P.nodes.length { return skip("pop callee") }
  const f = nodeAt(c.callFn)
  if !(f is Member) { return skip("pop callee") }
  const v = irBExpr(b, f.memObj)
  if ibMiss != "" { return 0 }
  if !(repNodeAt(irBOpRep(v)) is RList) { return skip("pop operand coercion") }
  irBNode(b, { efRhs: { lqV: v, lqAt: ix } }, -1, ibNoValue, ix)
  return 0
}

// A one-argument `.push` legacy writes as the plain append (`pushPlainWhy`): its receiver, then
// its value at the list's element rep.
function pushRhs(b: i32[], c: Call, m: Member, ix: i32): Rhs {
  const pp = pushPlanOf(ix, ibFnIx)
  if pp == null { return missRhs("push plan") }
  const why = pushPlainWhy(pp, ibFnIx)
  if why != "" { return missRhs(why) }
  const v = irBExpr(b, m.memObj)
  const ln = repNodeAt(irBOpRep(v))
  if ibMiss != "" || !(ln is RList) { return missRhs("push operand coercion") }
  const x = deliver(b, c.callArgs[0], ln.rlsElem)
  if ibMiss != "" { return missRhs("method operand") }
  if !(ln is RList) || irBOpRep(x) != ln.rlsElem {
    return missRhs("push operand coercion")
  }
  const r: Rhs = { lpV: v, lpX: x, lpAt: ix }
  return r
}

// Why operand `ix` is outside the set, or "": it must be typed at a numeric primitive or
// `boolean`, whose signedness picks the op (`opUnsigned`).
function operandWhy(ix: i32): string {
  const p = tyScalarBasePrim(nodeTyAt(ix, ibFnIx))
  if p == null { return "operand type" }
  const ps: string = p
  if isNumericPrim(ps) || ps == "boolean" { return "" }
  return "operand at " + ps
}

const STR_OPERAND = "operand at string"

// The rep of binary `n`'s operator width (`binNumWidth`) where an operand has it and the two
// differ, else -1.
function binWidthRep(n: BinExpr): i32 {
  const lr = primRepOf(n.binLeft)
  const rr = primRepOf(n.binRight)
  if lr == rr || lr < 0 || rr < 0 { return -1 }
  const w = binNumWidth(n, ibFnIx)
  // Each primitive is narrowed to a plain string before the compare (D16822).
  const lp = repPrim(lr)
  const rp = repPrim(rr)
  if lp != null {
    const ls: string = lp
    if ls == w { return lr }
  }
  if rp != null {
    const rs: string = rp
    if rs == w { return rr }
  }
  return -1
}

function irRepOtherThan(ix: i32, r: i32): boolean { return primRepOf(ix) != r }

// The value of `ix` delivered at rep `dst`: as built, or widened where legacy widens it, through
// `widenPlanOf`'s `plain` arm. Its literal arms write the constant at the destination width with
// legacy's own literal writers, which the IR does not share yet, so each is a named miss.
function deliver(b: i32[], ix: i32, dst: i32): Opnd {
  // A `null` literal into a `K | null` is legacy's own sentinel (`emitNullAt`).
  if ibMiss == "" && dst >= 0 && atomNullable(dst) {
    if nodeAt(unwrapParen(ix)) is NullLit && nullOwnIsAtom(ix, ibFnIx) {
      return repTemp(b, { nuAt: ix }, ix, dst)
    }
  }
  // A `null` literal has no value of its own: the box writer writes the null tag alone.
  if ibMiss == "" && dst >= 0 && nodeAt(unwrapParen(ix)) is NullLit {
    if boxedNullable(dst) && boxOwedAt(ix, ibFnIx) {
      const none: Opnd = { oiRep: ibNoValue, oiBits: 0 }
      return boxTemp(b, none, ix, dst)
    }
  }
  return widenTo(b, irBExpr(b, ix), ix, dst)
}

// `v`, built from `ix`, boxed into boxed nullable `dst` by legacy's box writer.
function boxTemp(b: i32[], v: Opnd, ix: i32, dst: i32): Opnd {
  return repTemp(b, { bxV: v, bxAt: ix }, ix, dst)
}

// A temp at destination rep `dst`, typed at it, holding `r` for delivery node `ix`.
function repTemp(b: i32[], r: Rhs, ix: i32, dst: i32): Opnd {
  const ty = repTyOf(dst)
  const t = irVarNew(ib, dst, ty, "temp", -1)
  irBNode(b, { lDst: t, lRhs: r }, ty, dst, ix)
  const o: Opnd = { ov: t }
  return o
}

// Operand `v`, built from `ix`, widened to rep `dst` as `deliver` widens it.
function widenTo(b: i32[], v: Opnd, ix: i32, dst: i32): Opnd {
  if ibMiss != "" || dst < 0 || irBOpRep(v) == dst { return v }
  // The checker records the box at the node; legacy's box writer builds it around the value.
  if boxedNullable(dst) && boxOwedAt(ix, ibFnIx) {
    return boxTemp(b, v, ix, dst)
  }
  // An atom into its `K | null` is the same i32: legacy's table has no row for it, since a
  // nullable niche is no box (`boxOwedAt`).
  const dn = repNodeAt(dst)
  if dn is RNullable && dn.rnDisc == 3 && dn.rnInner == irBOpRep(v) {
    if !boxOwedAt(ix, ibFnIx) { return repTemp(b, { rgV: v }, ix, dst) }
  }
  const sk = numKindOf(irBOpRep(v))
  const dk = numKindOf(dst)
  if sk < 0 || dk < 3 { return v }
  const p = widenPlanOf(ix, dk, ibFnIx)
  if p.wpArm != "plain" { return irBMiss("widen " + p.wpArm) }
  if p.wpSrc != sk { return irBMiss("widen source") }
  // The temp is typed at the destination, whose rep it holds.
  const ty = repTyOf(dst)
  const t = irVarNew(ib, dst, ty, "temp", -1)
  irBNode(
    b,
    { lDst: t, lRhs: { nwV: v, nwSrc: sk, nwDst: dk, nwAt: ix } },
    ty,
    dst,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// Whether operand `ix` is typed at a literal union delivered as an interned atom.
// An `==`/`!=` with an atom operand, by legacy's own arm (`atomEqPlanOf`). A side typed as one
// string literal is written by legacy's literal writer (an unread immediate here); only a `StrLit`
// spelling is taken, since anything else it would evaluate with legacy's expression writer.
function atomCompare(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const p = atomEqPlanOf(n, ibFnIx)
  const ne = n.binOp == "!="
  const none: Opnd = { oiRep: ibNoValue, oiBits: 0 }
  if p.aqArm == "none" { return irBMiss("atom compare") }
  if p.aqArm == "fold" { return irBMiss("atom compare fold") }
  if p.aqArm == "static" {
    const sIx = if p.aqStaticLeft { n.binLeft } else { n.binRight }
    if !(nodeAt(unwrapParen(sIx)) is StrLit) {
      return irBMiss("atom compare static operand")
    }
    const aIx = if p.aqStaticLeft { n.binRight } else { n.binLeft }
    const a = atomSide(b, aIx)
    if ibMiss != "" { return a }
    const st = if p.aqStaticLeft { 1 } else { 2 }
    const l = if p.aqStaticLeft { none } else { a }
    const r = if p.aqStaticLeft { a } else { none }
    return irBLetTemp(
      b,
      { aeL: l, aeR: r, aeStatic: st, aeNe: ne, aeAt: ix },
      ix,
      rep,
    )
  }
  // `ids`: two atom values.
  const l = atomSide(b, n.binLeft)
  if ibMiss != "" { return l }
  const r = atomSide(b, n.binRight)
  if ibMiss != "" { return r }
  return irBLetTemp(
    b,
    { aeL: l, aeR: r, aeStatic: 0, aeNe: ne, aeAt: ix },
    ix,
    rep,
  )
}

// The value of atom operand `ix`, which must build at an atom rep or its `K | null`.
function atomSide(b: i32[], ix: i32): Opnd {
  const v = irBExpr(b, ix)
  if ibMiss != "" { return v }
  const r = irBOpRep(v)
  if !(repNodeAt(r) is RAtom) && !atomNullable(r) {
    return irBMiss("atom compare operand")
  }
  return v
}

function atomOperand(ix: i32): boolean {
  const r = repNodeOfTy(nodeTyAt(ix, ibFnIx))
  return repNodeAt(r) is RAtom || atomNullable(r)
}

// A `==`/`!=` against a `null` literal, by legacy's own route: no dead test and no `null`-typed
// pair (`deadNullTestOperand`, `nulNoneEqSides`), then the null test's arm (`nulTestArmOf`) with
// the direction the dispatch hands it. Only a `K | null`'s sentinel compare is built.
function nulTest(
  b: i32[],
  n: BinExpr,
  bt: BinNulTest,
  ix: i32,
  rep: i32,
): Opnd {
  if deadNullTestOperand(n, ibFnIx) >= 0 { return irBMiss("null test dead") }
  if nulNoneEqSides(n.binLeft, n.binRight, ibFnIx) {
    return irBMiss("null test of null")
  }
  const arm = nulTestArmOf(bt.bnRef, ibFnIx, bt.bnInvert, false)
  if arm != "atom" { return irBMiss("null test " + arm) }
  const v = irBExpr(b, bt.bnRef)
  if ibMiss != "" { return v }
  if !atomNullable(irBOpRep(v)) { return irBMiss("null test operand") }
  return irBLetTemp(b, { ntV: v, ntInvert: bt.bnInvert, ntAt: ix }, ix, rep)
}

function isNumericPrim(p: string): boolean {
  return p == "i32"
    || p == "i64"
    || p == "f64"
    || p == "f32"
    || p == "u32"
    || p == "u64"
}

// Whether operand `ix` is typed at an unsigned integer, so its op takes the unsigned form.
function opUnsigned(ix: i32): boolean {
  const p = tyScalarBasePrim(nodeTyAt(ix, ibFnIx))
  if p == null { return false }
  const ps: string = p
  return ps == "u32" || ps == "u64"
}

export function irBExpr(b: i32[], ix: i32): Opnd {
  if ibMiss != "" || ix < 0 { return irBMiss("no node") }
  const n = nodeAt(ix)
  if n is Paren { return irBExpr(b, n.parInner) }
  const rep = primRepOf(ix)
  if rep < 0 {
    return irBMiss("rep " + repWhat(repNodeOfTy(nodeTyAt(ix, ibFnIx))))
  }
  if n is NumLit { return numLit(n, rep) }
  if n is BoolLit {
    const bits: i64 = if n.boolVal != 0 { 1 } else { 0 }
    const o: Opnd = { oiRep: rep, oiBits: bits }
    return o
  }
  if n is Ident { return identRead(b, n, ix, rep) }
  if n is Unary {
    if n.unOp != "-" && n.unOp != "!" { return irBMiss("unary " + n.unOp) }
    const uw = operandWhy(n.unArg)
    if uw != "" { return irBMiss(uw) }
    const a = irBExpr(b, n.unArg)
    if ibMiss != "" { return a }
    if irBOpRep(a) != rep { return irBMiss("operand coercion") }
    const op: PrimOp = if n.unOp == "-" { "neg" } else { "not" }
    return irBLetTemp(b, { poOp: op, poArgs: [a] }, ix, rep)
  }
  if n is BinExpr {
    if n.binOp == "&&" || n.binOp == "||" { return shortCircuit(b, n, ix, rep) }
    if n.binOp == "=" && !ASSIGN_AS_VALUE {
      return irBMiss("assignment as a value")
    }
    const bt = binNulTestOf(n)
    if bt != null { return nulTest(b, n, bt, ix, rep) }
    if atomOperand(n.binLeft) || atomOperand(n.binRight) {
      return atomCompare(b, n, ix, rep)
    }
    if (
      operandWhy(n.binLeft) == STR_OPERAND
      || operandWhy(n.binRight) == STR_OPERAND
    ) {
      return irStrBinHook(b, ix, rep)
    }
    const p = binPrimOp(n.binOp, opUnsigned(n.binLeft))
    if p == null || n.binIdent != 0 { return irBMiss("operator " + n.binOp) }
    const lw = operandWhy(n.binLeft)
    if lw != "" { return irBMiss(lw) }
    const rw = operandWhy(n.binRight)
    if rw != "" { return irBMiss(rw) }
    // Mixed numeric widths meet at the operator's width, each operand widened before the next
    // is built, as legacy builds them (`emitBinOperandAs`); a literal there is legacy's to write.
    const dst = binWidthRep(n)
    if (
      dst >= 0
      && irRepOtherThan(n.binLeft, dst)
      && numLitAsApplies(n.binLeft)
    ) {
      return irBMiss("widen literal")
    }
    if (
      dst >= 0
      && irRepOtherThan(n.binRight, dst)
      && numLitAsApplies(n.binRight)
    ) {
      return irBMiss("widen literal")
    }
    const l = widenTo(b, irBExpr(b, n.binLeft), n.binLeft, dst)
    const r = widenTo(b, irBExpr(b, n.binRight), n.binRight, dst)
    if ibMiss != "" { return l }
    if irBOpRep(l) != irBOpRep(r) { return irBMiss("operand coercion") }
    return irBLetTemp(b, { poOp: p, poArgs: [l, r] }, ix, rep)
  }
  if n is Call {
    const rhs = callRhs(b, n, ix)
    if ibMiss != "" { return irBMiss("call") }
    return irBLetTemp(b, rhs, ix, rep)
  }
  if n is Index { return irIndexHook(b, ix, rep) }
  if n is Member { return irMemberHook(b, ix, rep) }
  if n is StrLit { return strLit(ix, rep) }
  if n is CharLit {
    const cp = charLitCp(n)
    if cp < 0 || repPrim(rep) != "i32" { return irBMiss("char literal") }
    const c: Opnd = { oiRep: rep, oiBits: cp as i64 }
    return c
  }
  return irBMiss("expression " + irAstKind(ix))
}

// A string literal at the `str` rep, or delivered as its destination's interned atom.
function strLit(ix: i32, rep: i32): Opnd {
  if strLitTakesAtom(ix, ibFnIx) {
    const ar = repNodeOfTy(ctxTyAt(ix, ibFnIx))
    if !(repNodeAt(ar) is RAtom) { return irBMiss("string atom") }
    const a: Opnd = { osAt: ix, osRep: ar }
    return a
  }
  if repPrim(rep) != "str" { return irBMiss("string literal rep") }
  const o: Opnd = { osAt: ix, osRep: rep }
  return o
}

function assign(b: i32[], n: BinExpr, ix: i32) {
  const t = nodeAt(n.binLeft)
  if t is Index { return elemStore(b, n, t, ix) }
  if !(t is Ident) { return skip("assignment target") }
  if irInPlaceHook(ix, ibFnIx) { return skip("string append in place") }
  const d = identDeclOf(n.binLeft)
  if d >= 0 && localIndexOf(ibFnIx, n.binLeft) >= 0 {
    const v = irBDeclVar(d)
    if v < 0 { return skip("assignment coercion") }
    const src = deliver(b, n.binRight, ib.irVars[v].vRep)
    if ibMiss != "" { return 0 }
    if irBOpRep(src) != ib.irVars[v].vRep { return skip("assignment coercion") }
    irBNode(b, { asDst: v, asSrc: src }, -1, ibNoValue, ix)
    return 0
  }
  const g = globalIndexOfSid(sidOfNode(n.binLeft))
  if g < 0 || d < 0 { return skip("assignment target") }
  const src = deliver(b, n.binRight, globalRep(g, d))
  if ibMiss != "" { return 0 }
  if globalRep(g, d) != irBOpRep(src) { return skip("global store coercion") }
  irBNode(b, { gsSym: g, gsSrc: src }, -1, ibNoValue, ix)
  return 0
}

// `xs[i] = v` that legacy writes as the plain store (`idxStorePlainWhy`): receiver, index and
// value in source order, then the store, whose guard runs after the value.
function elemStore(b: i32[], n: BinExpr, t: Index, ix: i32) {
  // Legacy takes a map store before it plans an element store.
  if exprMap(t.idxArr, ibFnIx) { return skip("map store") }
  const st = idxStorePlanOf(t, ibFnIx)
  if st == null { return skip("store plan") }
  const why = idxStorePlainWhy(st, t.idxArr, n.binRight, ibFnIx)
  if why != "" { return skip(why) }
  const v = irBExpr(b, t.idxArr)
  const i = irBExpr(b, t.idxIndex)
  const ln = repNodeAt(irBOpRep(v))
  if !(ln is RList) { return skip("store operand coercion") }
  const x = deliver(b, n.binRight, ln.rlsElem)
  if ibMiss != "" { return 0 }
  if (
    !(ln is RList)
    || repPrim(irBOpRep(i)) != "i32"
    || irBOpRep(x) != ln.rlsElem
  ) {
    return skip("store operand coercion")
  }
  irBNode(b, { bcV: v, bcIx: i }, -1, ibNoValue, ix)
  irBNode(b, { lsV: v, lsIx: i, lsSrc: x }, -1, ibNoValue, ix)
  return 0
}

function loopIx(label: string): i32 {
  let i = ibLoopName.length - 1
  while i >= 0 {
    if label == "" || ibLoopName[i] == label { return i }
    i = i - 1
  }
  return -1
}

function whileStmt(b: i32[], n: WhileStmt, ix: i32) {
  if n.whileBlk != 0 || n.whileLv >= 0 { return skip("labelled block") }
  const brk = labelNew()
  const cont = labelNew()
  ibLoopName.push(n.whileLabel)
  ibLoopBrk.push(brk)
  ibLoopCont.push(cont)
  const loopBody: i32[] = []
  const c = irBExpr(loopBody, n.whileCond)
  if ibMiss == "" && irBOpRep(c) != ibBool { irBMiss("loop condition") }
  const exit: IrNode = { brLabel: brk, brHas: false, brVal: c }
  const exitBody = [irNodeNew(ib, exit, -1, ibNoValue, ix)]
  irBNode(
    loopBody,
    { siCond: c, siThen: [], siElse: exitBody, siOut: -1 },
    -1,
    ibNoValue,
    ix,
  )
  const wb = nodeAt(n.whileBody)
  if wb is Block {
    for s in wb.blkStmts { stmt(loopBody, s) }
  } else {
    stmt(loopBody, n.whileBody)
  }
  irBNode(
    loopBody,
    { brLabel: cont, brHas: false, brVal: c },
    -1,
    ibNoValue,
    ix,
  )
  const blockBody: i32[] = []
  irBNode(blockBody, { lpLabel: cont, lpBody: loopBody }, -1, ibNoValue, ix)
  ibLoopName.pop()
  ibLoopBrk.pop()
  ibLoopCont.pop()
  irBNode(b, { bkLabel: brk, bkBody: blockBody, bkOut: -1 }, -1, ibNoValue, ix)
  return 0
}

// A label no other branch target in this function uses.
function labelNew(): i32 {
  ibLabelN = ibLabelN + 1
  return ibLabelN - 1
}

function chainLink(e: i32): i32[] {
  const nb: i32[] = []
  stmtIn(nb, e)
  return nb
}

function elseStmts(e: i32): i32[] {
  if e < 0 { return [] }
  const en = nodeAt(e)
  if en is Block { return en.blkStmts }
  return [e]
}

// Builds statement `ix` onto `b`, noting the run of nodes it built for the source map.
function stmt(b: i32[], ix: i32) {
  const n0 = b.length
  stmtIn(b, ix)
  if ibMiss != "" && censusGoesOn(ibMiss) { ibMiss = "" }
  if b.length > n0 { irSpanNote(ib, ix, b[n0], b[b.length - 1]) }
  return 0
}

function stmtIn(b: i32[], ix: i32) {
  if ibMiss != "" { return 0 }
  const n = nodeAt(ix)
  if n is Block {
    for s in n.blkStmts { stmt(b, s) }
    return 0
  }
  if n is LetDecl {
    const v = irBDeclVar(ix)
    if v < 0 || n.letInit < 0 { return skip("declaration") }
    const src = deliver(b, n.letInit, ib.irVars[v].vRep)
    if ibMiss != "" { return 0 }
    if irBOpRep(src) != ib.irVars[v].vRep {
      return skip("declaration coercion")
    }
    irBNode(b, { asDst: v, asSrc: src }, -1, ibNoValue, ix)
    return 0
  }
  if n is IfStmt {
    const c = irBExpr(b, n.ifCond)
    if ibMiss != "" || irBOpRep(c) != ibBool { return skip("condition") }
    const th = nodeAt(n.ifThen)
    const thenB = if th is Block { bodyOf(th.blkStmts) } else { bodyOf([n.ifThen]) }
    // An `else if` link is part of its chain's statement: no span of its own.
    const elseB = if n.ifElse >= 0 && nodeAt(n.ifElse) is IfStmt { chainLink(n.ifElse) } else { bodyOf(elseStmts(n.ifElse)) }
    irBNode(
      b,
      { siCond: c, siThen: thenB, siElse: elseB, siOut: -1 },
      -1,
      ibNoValue,
      ix,
    )
    return 0
  }
  if n is WhileStmt {
    whileStmt(b, n, ix)
    return 0
  }
  if n is BreakStmt {
    const l = loopIx(n.brkLabel)
    if l < 0 || n.brkHasVal != 0 { return skip("break") }
    const z: Opnd = { ov: -1 }
    irBNode(
      b,
      { brLabel: ibLoopBrk[l], brHas: false, brVal: z },
      -1,
      ibNoValue,
      ix,
    )
    return 0
  }
  if n is ContinueStmt {
    const l = loopIx(n.contLabel)
    if l < 0 { return skip("continue") }
    const z: Opnd = { ov: -1 }
    irBNode(
      b,
      { brLabel: ibLoopCont[l], brHas: false, brVal: z },
      -1,
      ibNoValue,
      ix,
    )
    return 0
  }
  if n is RetStmt {
    const none = repIsNoValue(ib.irRetRep)
    if n.retArg < 0 {
      if !none { return skip("bare return") }
      const z: Opnd = { ov: -1 }
      irBNode(b, { rtHas: false, rtV: z }, -1, ibNoValue, ix)
      return 0
    }
    if none { return skip("void return value") }
    const v = deliver(b, n.retArg, ib.irRetRep)
    if ibMiss != "" || irBOpRep(v) != ib.irRetRep {
      return skip("return coercion")
    }
    irBNode(b, { rtHas: true, rtV: v }, -1, ibNoValue, ix)
    return 0
  }
  if n is BinExpr && n.binOp == "=" {
    assign(b, n, ix)
    return 0
  }
  if n is Call {
    if isPopStmt(n) { return popStmt(b, n, ix) }
    const rhs = callRhs(b, n, ix)
    if ibMiss != "" { return 0 }
    irBNode(b, { efRhs: rhs }, -1, ibNoValue, ix)
    return 0
  }
  if (
    n is Paren
    || n is Ident
    || n is NumLit
    || n is BoolLit
    || n is Unary
    || n is BinExpr
  ) {
    // Legacy evaluates a bare value and drops it.
    const v = irBExpr(b, ix)
    if ibMiss != "" { return 0 }
    irBNode(b, { dpV: v }, -1, ibNoValue, ix)
    return 0
  }
  skip("statement")
}

// A non-void body's tail. An expression body's one statement is its value; a block body's last
// statement is a statement, and a body that runs past it returns its result's `null`.
function tailReturn(b: i32[], stmts: i32[], at: i32) {
  if stmts.length == 0 { return skip("empty valued body") }
  let i = 0
  while i < stmts.length - 1 {
    stmt(b, stmts[i])
    i = i + 1
  }
  const last = stmts[stmts.length - 1]
  const ln = nodeAt(last)
  if ln is WhileStmt { return skip("valued tail loop") }
  if ln is RetStmt || ln is IfStmt {
    const past = ibMissesPast
    stmt(b, last)
    // A tail `if` whose arms yield values rather than returning is I1's (`siOut`). An arm the
    // census built past a miss in is incomplete, not valued.
    if ibMiss == "" && past == ibMissesPast && !irBodyLeaves(ib, b) {
      return skip("valued tail if")
    }
    return 0
  }
  if isBlockBody(at) {
    stmt(b, last)
    return skip("block body falls off")
  }
  const n0 = b.length
  const v = deliver(b, last, ib.irRetRep)
  if ibMiss != "" || irBOpRep(v) != ib.irRetRep { return skip("tail coercion") }
  irBNode(b, { rtHas: true, rtV: v }, -1, ibNoValue, at)
  irSpanNote(ib, last, b[n0], b[b.length - 1])
  return 0
}

// Builds the IR of the function at `fnIx` (`fnStmts` slot `fnPos`), or "" plus a reason.
function build(fnIx: i32, fnPos: i32): string {
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return "not a function" }
  ib = irFnNew(fnIx, fn.fnName)
  ibFnIx = fnIx
  ibMiss = ""
  ibMisses = []
  ibDeclVar = Map()
  ibLoopName = []
  ibLoopBrk = []
  ibLoopCont = []
  ibLabelN = 0
  ibBool = repNodeOfTy(TY_BOOL)
  if fn.fnTyParams.length > 0 { return "template" }
  ib.irRetTy = resultTy(fnPos, fn.fnRet, fnIx)
  ib.irRetRep = resultRep(fnPos, fn.fnRet, fnIx)
  const none = repIsNoValue(ib.irRetRep)
  if !(valueRep(ib.irRetRep, ib.irRetTy) || none) {
    if !censusGoesOn("result rep " + repWhat(ib.irRetRep)) {
      return "result rep " + repWhat(ib.irRetRep)
    }
  }
  ibNoValue = if none { ib.irRetRep } else { -1 }
  const shift = envSlotShift(fnIx)
  let i = 0
  while i < fn.fnParams.length {
    const p = fn.fnParams[i]
    const ty = scopeTyAt(p, fnIx)
    const r = repNodeOfTy(ty)
    if isVoidTy(ty) || !valueRep(r, ty) {
      if !censusGoesOn("parameter rep " + repWhat(r)) {
        return "parameter rep " + repWhat(r)
      }
    }
    // An unannotated parameter's type is open until a call instances it.
    if irTyOpen(ty) && !censusGoesOn("open parameter type") {
      return "open parameter type"
    }
    const v = irVarNew(ib, r, ty, "param", shift + i)
    ibDeclVar[p] = v
    ib.irParams.push(v)
    i = i + 1
  }
  if ibNoValue < 0 { ibNoValue = repNodeOfTy(TY_NEVER) }
  if !repIsNoValue(ibNoValue) { return "no void rep" }
  if fn.fnBody < 0 || fn.fnBody >= P.nodes.length { return "body" }
  const body = nodeAt(fn.fnBody)
  if !(body is Block) { return "body" }
  const top: i32[] = []
  if none {
    for s in body.blkStmts { stmt(top, s) }
  } else {
    tailReturn(top, body.blkStmts, fn.fnBody)
  }
  ib.irBody = top
  return ibMiss
}

// The failing control: breaks `ib` in the way `ibCorrupt` names.
function corrupt() {
  if ibCorrupt == 1 && ib.irVars.length > 0 {
    const v = ib.irVars[0]
    const other = if repPrim(v.vRep) == "bool" { repNodeOfTy(TY_I32) } else { ibBool }
    v.vRep = other
  }
  if ibCorrupt == 2 {
    let i = 0
    while i < ib.irNodes.length {
      const n = ib.irNodes[i]
      if (
        n is SLet
        && n.lDst >= 0
        && n.lDst < ib.irVars.length
        && ib.irVars[n.lDst].vKind == "temp"
      ) {
        const t: IrNode = { tpWhy: 0 }
        ib.irNodes[i] = t
        return 0
      }
      i = i + 1
    }
  }
  return 0
}

// The context the function at `fnStmts` slot `fnPos` accesses globals in. The start function's
// top-level body never reaches the IR, so it is a body's.
function globalCtxOf(fnPos: i32): GlobalCtx {
  const c: GlobalCtx = {
    gcInStart: false,
    gcFnPos: fnPos,
    gcGuardOff: ASSIGN_AS_VALUE,
  }
  return c
}

// The dual emit of a verified function: its lowering against the legacy code entry `emitFuncCode`
// wrote onto `out` from `outStart`, and the span rows it banked from `spanBase`. "" when they
// match, else the mismatch class.
function dualEmit(fnPos: i32, out: u8[], outStart: i32, spanBase: i32): string {
  const legacy: u8[] = []
  let i = outStart
  while i < out.length {
    legacy.push(out[i])
    i = i + 1
  }
  const skew = if ibCorrupt == 3 { 1 } else if ibCorrupt == 4 { 2 } else { 0 }
  if gPromoInStart {
    count("fail the start body reached the IR shadow")
    return "start body"
  }
  const why = irDualEmit(
    ib,
    globalCtxOf(fnPos),
    legacy,
    spanBase,
    outStart,
    skew,
  )
  if why == "" {
    count("matched")
    return ""
  }
  count("mismatch " + why)
  if ibDetail && rowN("mismatch " + why) <= 3 {
    count(
      "detail "
        + why
        + " in "
        + ib.irName
        + "\nlegacy "
        + irHexOf(legacy)
        + "\nir     "
        + irHexOf(irLoweredEntry())
        + "\n"
        + irFnText(ib),
    )
  }
  return why
}

// How many times row `key` has been counted.
function rowN(key: string): i32 {
  let i = 0
  while i < ibRowKey.length {
    if ibRowKey[i] == key { return ibRowN[i] }
    i = i + 1
  }
  return 0
}

// The seam: builds, verifies, lowers and discards the function at `fnIx`, counting the outcome.
export function irShadowFn(
  fnIx: i32,
  fnPos: i32,
  out: u8[],
  outStart: i32,
  spanBase: i32,
) {
  count("fns")
  const gen = repNodeGen()
  const why = build(fnIx, fnPos)
  if ibAllMiss { return censusRow(why) }
  if why != "" {
    count("uncovered " + why)
    return 0
  }
  count("covered")
  corrupt()
  const v = irVerify(ib)
  // A tree rebuilt mid-build leaves node indices that name nothing; no verdict holds.
  if repNodeGen() != gen {
    count("rep epoch moved")
    return 0
  }
  if v.vfRule == 0 {
    count("verified")
    const dual = dualEmit(fnPos, out, outStart, spanBase)
    // A function the claim rule takes must match: a claim is never a fallback.
    if dual != "" && claimable() {
      count("fail a claimable function did not match: " + dual)
    }
    return 0
  }
  count(
    "fail rule "
      + i32ToStr(v.vfRule)
      + " in "
      + ib.irName
      + " at "
      + i32ToStr(v.vfNode)
      + ": "
      + v.vfMsg
      + "\n"
      + irFnText(ib),
  )
  return 0
}

// The census row of the function just built: its blocker classes, sorted, or none.
function censusRow(why: string) {
  if why != "" { censusGoesOn(why) }
  if ibMisses.length == 0 {
    count("blockers none")
    return 0
  }
  // Insertion sort, so one set of classes is one key whatever order the build met them in.
  let i = 1
  while i < ibMisses.length {
    const x = ibMisses[i]
    let j = i - 1
    while j >= 0 && ibMisses[j] > x {
      ibMisses[j + 1] = ibMisses[j]
      j = j - 1
    }
    ibMisses[j + 1] = x
    i = i + 1
  }
  let key = ibMisses[0]
  let k = 1
  while k < ibMisses.length {
    key = key + " + " + ibMisses[k]
    k = k + 1
  }
  count("blockers " + key)
  return 0
}
