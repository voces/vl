// The IR shadow (ir-design-2026-11.md §5.2, step I0): with the shadow armed, `emitFuncCode`
// hands each function here after its legacy lowering. The phase-A builder covers I1's set
// (constants, primitive ops, locals, `if`/loops/`break`/`continue`/`return`, direct calls and
// globals); any other construct leaves the function uncovered, a counted reason, not an error.
// A covered function is verified and then discarded: nothing is claimed, so no byte moves.
import {
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  ContinueStmt,
  FuncDecl,
  Ident,
  IfStmt,
  LetDecl,
  NumLit,
  P,
  Param,
  Paren,
  RetStmt,
  Unary,
  WhileStmt,
  hasNamedArgs,
  i32ToStr,
  nodeAt,
} from "./ast"
import {
  IrFn,
  IrNode,
  OImm,
  OStr,
  OVar,
  Opnd,
  PrimOp,
  Rhs,
  SLet,
  irFnNew,
  irFnText,
  irNodeNew,
  irSigNote,
  irVarNew,
} from "./ir"
import { irVerify } from "./ir_verify"
import { repIdKind, repIdOfTy } from "./emit_rep"
import { nodeTyAt, scopeTyAt } from "./emit_capture_frames"
import {
  declaredIndexAt,
  envSlotShift,
  fnIndexOfNode,
  localIndexOf,
} from "./emit_classify"
import { declaredSlotOfDecl } from "./emit_struct_order"
import { fnStmts } from "./emit_state"
import { fnCheckedRetTy, globalIndexOfSid } from "./emit_fn_ret_kinds"
import { identDeclOf, sidOfNode } from "./symbols"
import { memOffsetLexValue } from "./check_intrinsics"
import { f32Bytes, f64Bytes, numLexIsFloat } from "./emit_bignum"
import { isVoidTy } from "./tyquery"
import { TY_BOOL, TY_I32, TY_NEVER } from "./check_types"

let ibArmed = false
let ibCorrupt = 0
let ibRowKey: string[] = []
let ibRowN: i32[] = []

// Arms (1) or disarms (0) the shadow for the compiles that follow.
export function irShadowArm(on: i32) {
  ibArmed = on != 0
  0
}

// The shadow's failing control: 0 verifies the built function, 1 swaps the first variable's rep
// for another, 2 deletes the first temp's definition. Either must make the verifier fail.
export function irShadowCorrupt(k: i32) {
  ibCorrupt = k
  0
}

export function irShadowArmed(): boolean { ibArmed }

// Starts a compile's report.
export function irShadowBegin() {
  ibRowKey = []
  ibRowN = []
  0
}

function count(key: string) {
  let i = 0
  while i < ibRowKey.length {
    if ibRowKey[i] == key {
      ibRowN[i] = ibRowN[i] + 1
      return 0
    }
    i = i + 1
  }
  ibRowKey.push(key)
  ibRowN.push(1)
  0
}

export function irShadowRowCount() { ibRowKey.length }

export function irShadowRowLen(i: i32) { ibRowKey[i].length }

export function irShadowRowAt(i: i32, j: i32) { ibRowKey[i][j] }

export function irShadowRowN(i: i32) { ibRowN[i] }

// The function being built and the first construct outside the set.
let ib: IrFn = irFnNew(-1, "")
let ibFnIx = -1
let ibMiss = ""
let ibDeclVar: {[i32]: i32} = Map()
let ibLoopName: string[] = []
let ibLoopBrk: i32[] = []
let ibLoopCont: i32[] = []
let ibLabelN = 0
let ibBool = -1
let ibNoValue = -1

function miss(why: string): Opnd {
  if ibMiss == "" { ibMiss = why }
  const o: Opnd = { ov: -1 }
  o
}

// `miss` for a statement, which yields nothing.
function skip(why: string): i32 {
  miss(why)
  0
}

function missRhs(why: string): Rhs {
  miss(why)
  const r: Rhs = { ggSym: -1 }
  r
}

function emitNode(b: i32[], n: IrNode, ty: i32, rep: i32, at: i32) {
  b.push(irNodeNew(ib, n, ty, rep, at))
  0
}

// Builds `stmts` into a fresh body and returns it.
function bodyOf(stmts: i32[]): i32[] {
  const nb: i32[] = []
  for s in stmts { stmt(nb, s) }
  nb
}

function isPrimKind(k: string): boolean {
  k == "i32" || k == "i64" || k == "f64" || k == "f32" || k == "bool"
}

// The rep of node `ix`'s checked type in this instance when it is a primitive one, else -1.
function primRepOf(ix: i32): i32 {
  const r = repIdOfTy(nodeTyAt(ix, ibFnIx))
  if !isPrimKind(repIdKind(r)) { return -1 }
  r
}

function opRep(o: Opnd): i32 {
  match o {
    OVar => if o.ov >= 0 && o.ov < ib.irVars.length { ib.irVars[o.ov].vRep } else { -1 }
    OImm => o.oiRep
    OStr => -1
  }
}

// A fresh temp of `ix`'s type, defined by `rhs`.
function letTemp(b: i32[], rhs: Rhs, ix: i32, rep: i32): Opnd {
  const ty = nodeTyAt(ix, ibFnIx)
  const v = irVarNew(ib, rep, ty, "temp", -1)
  emitNode(b, { lDst: v, lRhs: rhs }, ty, rep, ix)
  const o: Opnd = { ov: v }
  o
}

// The variable of local declaration `d` (a `LetDecl` or a `Param`), made on first use.
function declVar(d: i32): i32 {
  const known = ibDeclVar[d] ?? -1
  if known >= 0 { return known }
  const ty = scopeTyAt(d, ibFnIx)
  const rep = repIdOfTy(ty)
  if !isPrimKind(repIdKind(rep)) {
    miss("local rep " + repIdKind(rep))
    return -1
  }
  const s = declaredSlotOfDecl(d)
  const slot = if s >= 0 { declaredIndexAt(ibFnIx, s) } else { -1 }
  const v = irVarNew(ib, rep, ty, "local", slot)
  ibDeclVar[d] = v
  v
}

function binPrim(op: string): PrimOp | null {
  if op == "+" { return "add" }
  if op == "-" { return "sub" }
  if op == "*" { return "mul" }
  if op == "/" { return "div" }
  if op == "%" { return "rem" }
  if op == "&" { return "and" }
  if op == "|" { return "or" }
  if op == "^" { return "xor" }
  if op == "<<" { return "shl" }
  if op == ">>" { return "shr" }
  if op == ">>>" { return "shru" }
  if op == "==" { return "eq" }
  if op == "!=" { return "ne" }
  if op == "<" { return "lt" }
  if op == "<=" { return "le" }
  if op == ">" { return "gt" }
  if op == ">=" { return "ge" }
  // Assignment, `&&`/`||`, `??` and every other operator are lowered by their own arms.
  null
}

// `a && b` / `a || b`: a local the two arms of an `if` write.
function shortCircuit(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const l = expr(b, n.binLeft)
  if ibMiss != "" || opRep(l) != ibBool { return miss("logical operand") }
  const ty = nodeTyAt(ix, ibFnIx)
  const t = irVarNew(ib, rep, ty, "local", -1)
  const rhsBody: i32[] = []
  const r = expr(rhsBody, n.binRight)
  if opRep(r) != ibBool { return miss("logical operand") }
  emitNode(rhsBody, { asDst: t, asSrc: r }, -1, ibNoValue, ix)
  const fixBody: i32[] = []
  const bits: i64 = if n.binOp == "&&" { 0 } else { 1 }
  const fixed: Opnd = { oiRep: ibBool, oiBits: bits }
  emitNode(fixBody, { asDst: t, asSrc: fixed }, -1, ibNoValue, ix)
  if n.binOp == "&&" {
    emitNode(
      b,
      { siCond: l, siThen: rhsBody, siElse: fixBody, siOut: t },
      ty,
      rep,
      ix,
    )
  } else {
    emitNode(
      b,
      { siCond: l, siThen: fixBody, siElse: rhsBody, siOut: t },
      ty,
      rep,
      ix,
    )
  }
  const o: Opnd = { ov: t }
  o
}

function numLit(n: NumLit, rep: i32): Opnd {
  const k = repIdKind(rep)
  if k == "f64" || k == "f32" {
    const bs = if k == "f64" { f64Bytes(n.numText) } else { f32Bytes(n.numText) }
    let bits: i64 = 0
    let i = bs.length - 1
    while i >= 0 {
      bits = bits * 256 + ((bs[i] & 255) as i64)
      i = i - 1
    }
    const f: Opnd = { oiRep: rep, oiBits: bits }
    return f
  }
  if numLexIsFloat(n.numText) { return miss("float literal at an integer") }
  const v = memOffsetLexValue(n.numText)
  if v < 0 || k == "i32" && v > 2147483647 { return miss("wide literal") }
  const o: Opnd = { oiRep: rep, oiBits: v }
  o
}

function identRead(b: i32[], n: Ident, ix: i32, rep: i32): Opnd {
  const d = identDeclOf(ix)
  if d < 0 { return miss("unresolved read") }
  const dn = nodeAt(d)
  if (dn is LetDecl || dn is Param) && localIndexOf(ibFnIx, ix) >= 0 {
    const v = declVar(d)
    if v < 0 { return miss("local rep") }
    if ib.irVars[v].vRep != rep { return miss("narrowed read") }
    const o: Opnd = { ov: v }
    return o
  }
  const g = globalIndexOfSid(sidOfNode(ix))
  if dn is LetDecl && g >= 0 { return letTemp(b, { ggSym: g }, ix, rep) }
  miss("read of " + n.identName)
}

// The parameter and result reps of `fnStmts` slot `pos`, noted in `ib`; false when one is not
// a primitive or void rep.
function calleeSig(pos: i32): boolean {
  if pos < 0 || pos >= fnStmts.length { return false }
  const d = fnStmts[pos]
  const fn = nodeAt(d)
  if !(fn is FuncDecl) { return false }
  const ps: i32[] = []
  for p in fn.fnParams {
    const r = repIdOfTy(scopeTyAt(p, d))
    if !isPrimKind(repIdKind(r)) { return false }
    ps.push(r)
  }
  const rt = if fn.fnRet >= 0 { nodeTyAt(fn.fnRet, d) } else { fnCheckedRetTy(pos) }
  const rr = if isVoidTy(rt) { repIdOfTy(TY_NEVER) } else { repIdOfTy(rt) }
  const rk = repIdKind(rr)
  if !(isPrimKind(rk) || rk == "novalue") { return false }
  irSigNote(ib, pos, ps, rr)
  true
}

// A direct call of a declared, capture-free function by name; its arguments by position.
function callRhs(b: i32[], c: Call): Rhs {
  if c.callFn < 0 || hasNamedArgs(c.callArgNames) {
    return missRhs("named call")
  }
  if !(nodeAt(c.callFn) is Ident) { return missRhs("indirect call") }
  const d = identDeclOf(c.callFn)
  if d < 0 || !(nodeAt(d) is FuncDecl) {
    return missRhs("call of a non-declaration")
  }
  const pos = fnIndexOfNode(c.callFn)
  if pos < 0 || pos >= fnStmts.length || fnStmts[pos] != d {
    return missRhs("call target")
  }
  if !calleeSig(pos) { return missRhs("callee signature") }
  const callee = nodeAt(d)
  const args: Opnd[] = []
  if callee is FuncDecl {
    if callee.fnParams.length != c.callArgs.length {
      return missRhs("argument count")
    }
    let i = 0
    while i < c.callArgs.length {
      const a = expr(b, c.callArgs[i])
      if ibMiss != "" { return missRhs("argument") }
      if opRep(a) != repIdOfTy(scopeTyAt(callee.fnParams[i], d)) {
        return missRhs("argument coercion")
      }
      args.push(a)
      i = i + 1
    }
  }
  const r: Rhs = { caCallee: pos, caArgs: args }
  r
}

function expr(b: i32[], ix: i32): Opnd {
  if ibMiss != "" || ix < 0 { return miss("no node") }
  const n = nodeAt(ix)
  if n is Paren { return expr(b, n.parInner) }
  const rep = primRepOf(ix)
  if rep < 0 {
    return miss("rep " + repIdKind(repIdOfTy(nodeTyAt(ix, ibFnIx))))
  }
  if n is NumLit { return numLit(n, rep) }
  if n is BoolLit {
    const bits: i64 = if n.boolVal != 0 { 1 } else { 0 }
    const o: Opnd = { oiRep: rep, oiBits: bits }
    return o
  }
  if n is Ident { return identRead(b, n, ix, rep) }
  if n is Unary {
    if n.unOp != "-" && n.unOp != "!" { return miss("unary " + n.unOp) }
    const a = expr(b, n.unArg)
    if ibMiss != "" { return a }
    if opRep(a) != rep { return miss("operand coercion") }
    const op: PrimOp = if n.unOp == "-" { "neg" } else { "not" }
    return letTemp(b, { poOp: op, poArgs: [a] }, ix, rep)
  }
  if n is BinExpr {
    if n.binOp == "&&" || n.binOp == "||" { return shortCircuit(b, n, ix, rep) }
    const p = binPrim(n.binOp)
    if p == null || n.binIdent != 0 { return miss("operator " + n.binOp) }
    const l = expr(b, n.binLeft)
    const r = expr(b, n.binRight)
    if ibMiss != "" { return l }
    if opRep(l) != opRep(r) { return miss("operand coercion") }
    return letTemp(b, { poOp: p, poArgs: [l, r] }, ix, rep)
  }
  if n is Call {
    const rhs = callRhs(b, n)
    if ibMiss != "" { return miss("call") }
    return letTemp(b, rhs, ix, rep)
  }
  miss("expression")
}

function assign(b: i32[], n: BinExpr, ix: i32) {
  const t = nodeAt(n.binLeft)
  if !(t is Ident) { return skip("assignment target") }
  const d = identDeclOf(n.binLeft)
  const src = expr(b, n.binRight)
  if ibMiss != "" { return 0 }
  if d >= 0 && localIndexOf(ibFnIx, n.binLeft) >= 0 {
    const v = declVar(d)
    if v < 0 || opRep(src) != ib.irVars[v].vRep {
      return skip("assignment coercion")
    }
    emitNode(b, { asDst: v, asSrc: src }, -1, ibNoValue, ix)
    return 0
  }
  const g = globalIndexOfSid(sidOfNode(n.binLeft))
  if g < 0 { return skip("assignment target") }
  emitNode(b, { gsSym: g, gsSrc: src }, -1, ibNoValue, ix)
  0
}

function loopIx(label: string): i32 {
  let i = ibLoopName.length - 1
  while i >= 0 {
    if label == "" || ibLoopName[i] == label { return i }
    i = i - 1
  }
  -1
}

function whileStmt(b: i32[], n: WhileStmt, ix: i32) {
  if n.whileBlk != 0 || n.whileLv >= 0 { return skip("labelled block") }
  const brk = labelNew()
  const cont = labelNew()
  ibLoopName.push(n.whileLabel)
  ibLoopBrk.push(brk)
  ibLoopCont.push(cont)
  const loopBody: i32[] = []
  const c = expr(loopBody, n.whileCond)
  if ibMiss == "" && opRep(c) != ibBool { miss("loop condition") }
  const exit: IrNode = { brLabel: brk, brHas: false, brVal: c }
  const exitBody = [irNodeNew(ib, exit, -1, ibNoValue, ix)]
  emitNode(
    loopBody,
    { siCond: c, siThen: [], siElse: exitBody, siOut: -1 },
    -1,
    ibNoValue,
    ix,
  )
  const wb = nodeAt(n.whileBody)
  if wb is Block {
    for s in wb.blkStmts { stmt(loopBody, s) }
  } else {
    stmt(loopBody, n.whileBody)
  }
  emitNode(
    loopBody,
    { brLabel: cont, brHas: false, brVal: c },
    -1,
    ibNoValue,
    ix,
  )
  const blockBody: i32[] = []
  emitNode(blockBody, { lpLabel: cont, lpBody: loopBody }, -1, ibNoValue, ix)
  ibLoopName.pop()
  ibLoopBrk.pop()
  ibLoopCont.pop()
  emitNode(b, { bkLabel: brk, bkBody: blockBody, bkOut: -1 }, -1, ibNoValue, ix)
  0
}

// A label no other branch target in this function uses.
function labelNew(): i32 {
  ibLabelN = ibLabelN + 1
  ibLabelN - 1
}

function elseStmts(e: i32): i32[] {
  if e < 0 { return [] }
  const en = nodeAt(e)
  if en is Block { return en.blkStmts }
  [e]
}

function stmt(b: i32[], ix: i32) {
  if ibMiss != "" { return 0 }
  const n = nodeAt(ix)
  if n is Block {
    for s in n.blkStmts { stmt(b, s) }
    return 0
  }
  if n is LetDecl {
    const v = declVar(ix)
    if v < 0 || n.letInit < 0 { return skip("declaration") }
    const src = expr(b, n.letInit)
    if ibMiss != "" { return 0 }
    if opRep(src) != ib.irVars[v].vRep { return skip("declaration coercion") }
    emitNode(b, { asDst: v, asSrc: src }, -1, ibNoValue, ix)
    return 0
  }
  if n is IfStmt {
    const c = expr(b, n.ifCond)
    if ibMiss != "" || opRep(c) != ibBool { return skip("condition") }
    const th = nodeAt(n.ifThen)
    const thenB = if th is Block { bodyOf(th.blkStmts) } else { bodyOf([n.ifThen]) }
    const elseB = bodyOf(elseStmts(n.ifElse))
    emitNode(
      b,
      { siCond: c, siThen: thenB, siElse: elseB, siOut: -1 },
      -1,
      ibNoValue,
      ix,
    )
    return 0
  }
  if n is WhileStmt {
    whileStmt(b, n, ix)
    return 0
  }
  if n is BreakStmt {
    const l = loopIx(n.brkLabel)
    if l < 0 || n.brkHasVal != 0 { return skip("break") }
    const z: Opnd = { ov: -1 }
    emitNode(
      b,
      { brLabel: ibLoopBrk[l], brHas: false, brVal: z },
      -1,
      ibNoValue,
      ix,
    )
    return 0
  }
  if n is ContinueStmt {
    const l = loopIx(n.contLabel)
    if l < 0 { return skip("continue") }
    const z: Opnd = { ov: -1 }
    emitNode(
      b,
      { brLabel: ibLoopCont[l], brHas: false, brVal: z },
      -1,
      ibNoValue,
      ix,
    )
    return 0
  }
  if n is RetStmt {
    const none = repIdKind(ib.irRetRep) == "novalue"
    if n.retArg < 0 {
      if !none { return skip("bare return") }
      const z: Opnd = { ov: -1 }
      emitNode(b, { rtHas: false, rtV: z }, -1, ibNoValue, ix)
      return 0
    }
    if none { return skip("void return value") }
    const v = expr(b, n.retArg)
    if ibMiss != "" || opRep(v) != ib.irRetRep {
      return skip("return coercion")
    }
    emitNode(b, { rtHas: true, rtV: v }, -1, ibNoValue, ix)
    return 0
  }
  if n is BinExpr && n.binOp == "=" {
    assign(b, n, ix)
    return 0
  }
  if n is Call {
    const rhs = callRhs(b, n)
    if ibMiss != "" { return 0 }
    emitNode(b, { efRhs: rhs }, -1, ibNoValue, ix)
    return 0
  }
  if (
    n is Paren
    || n is Ident
    || n is NumLit
    || n is BoolLit
    || n is Unary
    || n is BinExpr
  ) {
    expr(b, ix)
    return 0
  }
  skip("statement")
}

// A non-void body's tail: its last statement's value is returned.
function tailReturn(b: i32[], stmts: i32[], at: i32) {
  if stmts.length == 0 { return skip("empty valued body") }
  let i = 0
  while i < stmts.length - 1 {
    stmt(b, stmts[i])
    i = i + 1
  }
  const last = stmts[stmts.length - 1]
  const ln = nodeAt(last)
  if ln is RetStmt || ln is WhileStmt || ln is IfStmt {
    stmt(b, last)
    return 0
  }
  const v = expr(b, last)
  if ibMiss != "" || opRep(v) != ib.irRetRep { return skip("tail coercion") }
  emitNode(b, { rtHas: true, rtV: v }, -1, ibNoValue, at)
  0
}

// Builds the IR of the function at `fnIx` (`fnStmts` slot `fnPos`), or "" plus a reason.
function build(fnIx: i32, fnPos: i32): string {
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return "not a function" }
  ib = irFnNew(fnIx, fn.fnName)
  ibFnIx = fnIx
  ibMiss = ""
  ibDeclVar = Map()
  ibLoopName = []
  ibLoopBrk = []
  ibLoopCont = []
  ibLabelN = 0
  ibBool = repIdOfTy(TY_BOOL)
  if fn.fnTyParams.length > 0 { return "template" }
  const rt = if fn.fnRet >= 0 { nodeTyAt(fn.fnRet, fnIx) } else { fnCheckedRetTy(fnPos) }
  ib.irRetTy = rt
  // The tree gives `void` the i32 flat rep; the IR's no-value rep is `never`'s.
  ib.irRetRep = if isVoidTy(rt) { repIdOfTy(TY_NEVER) } else { repIdOfTy(rt) }
  const rk = repIdKind(ib.irRetRep)
  if !(isPrimKind(rk) || rk == "novalue") { return "result rep " + rk }
  ibNoValue = if rk == "novalue" { ib.irRetRep } else { -1 }
  const shift = envSlotShift(fnIx)
  let i = 0
  while i < fn.fnParams.length {
    const p = fn.fnParams[i]
    const ty = scopeTyAt(p, fnIx)
    const r = repIdOfTy(ty)
    if !isPrimKind(repIdKind(r)) { return "parameter rep " + repIdKind(r) }
    const v = irVarNew(ib, r, ty, "param", shift + i)
    ibDeclVar[p] = v
    ib.irParams.push(v)
    i = i + 1
  }
  if ibNoValue < 0 { ibNoValue = repIdOfTy(TY_NEVER) }
  if repIdKind(ibNoValue) != "novalue" { return "no void rep" }
  if fn.fnBody < 0 || fn.fnBody >= P.nodes.length { return "body" }
  const body = nodeAt(fn.fnBody)
  if !(body is Block) { return "body" }
  const top: i32[] = []
  if rk == "novalue" {
    for s in body.blkStmts { stmt(top, s) }
  } else {
    tailReturn(top, body.blkStmts, fn.fnBody)
  }
  ib.irBody = top
  ibMiss
}

// The failing control: breaks `ib` in the way `ibCorrupt` names.
function corrupt() {
  if ibCorrupt == 1 && ib.irVars.length > 0 {
    const v = ib.irVars[0]
    const other = if repIdKind(v.vRep) == "bool" { repIdOfTy(TY_I32) } else { ibBool }
    v.vRep = other
  }
  if ibCorrupt == 2 {
    let i = 0
    while i < ib.irNodes.length {
      const n = ib.irNodes[i]
      if (
        n is SLet
        && n.lDst >= 0
        && n.lDst < ib.irVars.length
        && ib.irVars[n.lDst].vKind == "temp"
      ) {
        const t: IrNode = { tpWhy: 0 }
        ib.irNodes[i] = t
        return 0
      }
      i = i + 1
    }
  }
  0
}

// The seam: builds, verifies and discards the function at `fnIx`, counting the outcome.
export function irShadowFn(fnIx: i32, fnPos: i32) {
  count("fns")
  const why = build(fnIx, fnPos)
  if why != "" {
    count("uncovered " + why)
    return 0
  }
  count("covered")
  corrupt()
  const v = irVerify(ib)
  if v.vfRule == 0 {
    count("verified")
    return 0
  }
  count(
    "fail rule "
      + i32ToStr(v.vfRule)
      + " in "
      + ib.irName
      + " at "
      + i32ToStr(v.vfNode)
      + ": "
      + v.vfMsg
      + "\n"
      + irFnText(ib),
  )
  0
}
