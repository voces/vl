} from "./emit_start_block"
import {
  TY_BOOL,
  TY_I32,
  TY_I64,
  TY_NEVER,
  TY_NUL_STR,
  TY_STR,
  tyIsRecord,
  tyScalarBasePrim,
} from "./check_types"
import { declSlotPinned } from "./emit_collect"
import { ListBuild } from "./emit_ref_list_kinds"

let ibArmed = false
let ibMode = 0
let ibDetail = false
let ibCorrupt = 0
let ibRowKey: string[] = []
let ibRowN: i32[] = []

// The shadow's mode for the compiles that follow: 0 off, 1 armed, 2 armed with mismatch and `rep`
// miss detail, 3 disarmed claiming every family but `other` (the claim path's test), 4 the
// blocker census (each row names every class the function missed), 5 disarmed with the shipped
// claim's rows printed.
export function irShadowArm(on: i32) {
  ibMode = on
  ibArmed = armedIn(on)
  setIrShadowOn(ibArmed)
  ibDetail = on == 2
  ibClaimAll = on == 3
  ibAllMiss = on == 4
  ibPrePost = on == 6
  return 0
}

// Whether shadow mode `on` arms the checks that compare the IR with what legacy wrote.
function armedIn(on: i32): boolean {
  return on == 1 || on == 2 || on == 4 || on == 6
}

// Mode 6, the order check: each function is also built and lowered where a claim builds it,
// before legacy emits it, and compared with the shadow's build after. A builder or plan that reads
// state legacy fills while emitting answers differently in the two orders.
let ibPrePost = false
let ibPreBuilt = false
let ibPreWhy = ""
let ibPreText = ""
let ibPreCode: u8[] = []

// Under mode 6, builds, verifies and lowers the function at `fnIx` before legacy emits it.
export function irPreBuild(fnIx: i32, fnPos: i32) {
  ibPreBuilt = false
  if !ibPrePost { return 0 }
  // The early build runs where a claim does, so unarmed as a claim is: an armed check that
  // legacy has written the function already would fail it. A failure it causes stays a failure,
  // since the writer has stopped, and the row names the function.
  const failedBefore = emitFailed
  ibArmed = false
  preBuildUnarmed(fnIx, fnPos)
  ibArmed = armedIn(ibMode)
  if !failedBefore && emitFailed {
    count(
      "prepost differs: the early build failed the compile ("
        + emitErr
        + ") in "
        + ib.irName,
    )
  }
  return 0
}

function preBuildUnarmed(fnIx: i32, fnPos: i32) {
  const gen = repNodeGen()
  const minted = synthMintCount()
  const why = build(fnIx, fnPos)
  if synthMintCount() != minted {
    count("prepost: the early build minted a synthetic global")
  }
  ibPreWhy = why
  if why != "" || repNodeGen() != gen { return 0 }
  ibPreBuilt = true
  ibPreText = irFnText(ib)
  ibPreCode = []
  if irBVerify(ib).vfRule == 0 {
    ibPreCode = irLowerProbe(ib, globalCtxOf(fnPos))
  }
  return 0
}

// Under mode 6, a row naming the function when its build after legacy differs from its build
// before: built in one order only, or a different IR. `why` is the later build's miss.
function prePostBuilt(why: string) {
  const built = why == ""
  if built != ibPreBuilt {
    count(
      "prepost differs: built "
        + (if built { "after legacy only (" + ibPreWhy + ")" } else { "before legacy only (" + why + ")" })
        + " in "
        + ib.irName,
    )
    return 0
  }
  if built && irFnText(ib) != ibPreText {
    count("prepost differs: ir text in " + ib.irName)
  }
  return 0
}

// Under mode 6, a row naming the function when its lowering after legacy differs from its
// lowering before; `dual` is the shadow's verdict, whose `unlowered` means no lowering.
function prePostLowered(dual: string) {
  const unlowered = dual.length >= 9 && dual.slice(0, 9) == "unlowered"
  const post: u8[] = if unlowered { [] } else { irLoweredEntry() }
  let same = post.length == ibPreCode.length
  let i = 0
  while same && i < post.length {
    if post[i] != ibPreCode[i] { same = false }
    i = i + 1
  }
  if !same { count("prepost differs: lowered in " + ib.irName) }
  return 0
}

let ibAllMiss = false
// The classes the blocker census met in the function being built.
let ibMisses: string[] = []
// How many misses the census let the build go on past, so a statement can tell it built whole.
let ibMissesPast = 0

// Under the census, records `why` and lets the build go on; otherwise answers it.
function censusGoesOn(why: string): boolean {
  if !ibAllMiss { return false }
  ibMissesPast = ibMissesPast + 1
  for m in ibMisses {
    if m == why { return true }
  }
  ibMisses.push(why)
  return true
}

// The families whose every occurrence the shadow has matched, so a function built wholly of them
// ships the IR's bytes and legacy does not run for it (design §10). A slice adds its family here.
const CLAIMED: IrFamily[] = [
  "scalar", "control", "call", "global", "map", "list", "box", "record",
  "closure", "start", "raw", "mem",
]
let ibClaimAll = false
// Set while `irClaimFn` builds, never under the shadow, which builds every function whole.
let ibClaimBuild = false

function familyClaimed(fam: IrFamily): boolean {
  if ibClaimAll { return fam != "other" }
  for c in CLAIMED {
    if c == fam { return true }
  }
  return false
}

// Whether every node of the function just built is in a claimed family. A local or parameter of a
// reference rep is the list family's.
function claimable(): boolean {
  if CLAIMED.length == 0 && !ibClaimAll { return false }
  for n in ib.irNodes {
    if !familyClaimed(irNodeFamily(n)) { return false }
  }
  for v in ib.irVars {
    if v.vSlot >= 0 && !repIsScalar(v.vRep) && !familyClaimed("list") {
      return false
    }
  }
  return true
}

// The scope one claim seam opens: the soft-refusal state it replaces, restored when it closes, and
// the atom table's mark, so a claim that falls back leaves what legacy then writes as legacy alone
// would. Seams never nest: an inner claim that wrote inside an outer one that fell back would keep
// bytes naming atoms the outer rollback forgets, so a second open scope is a compiler bug.
type ClaimScope = { sfWas: boolean, sfMsg: string, sfAt: i32, csAtoms: i32 }

let claimScopeOpen = false

function claimScopeBegin(): ClaimScope {
  // Hard, not the open scope's soft refusal: the nesting is the compiler's bug, not the claim's.
  if claimScopeOpen {
    emitSoftFail = false
    emitFail("emitProgram: a claim seam opened inside another claim's scope")
  }
  claimScopeOpen = true
  const s: ClaimScope = {
    sfWas: emitSoftFail,
    sfMsg: emitSoftMsg,
    sfAt: emitSoftAt,
    csAtoms: litAtomMark(),
  }
  emitSoftFail = true
  emitSoftMsg = ""
  emitSoftAt = -1
  return s
}

// Closes scope `s` for a claim that wrote (`ok`) or fell back: a fallback forgets the atoms it
// interned and the read reps it remembered (D17241, D17243). Answers the refusal a shared legacy
// helper raised inside it, or "".
function claimScopeEnd(s: ClaimScope, ok: boolean): string {
  claimScopeOpen = false
  const m = emitSoftMsg
  emitSoftFail = s.sfWas
  emitSoftMsg = s.sfMsg
  emitSoftAt = s.sfAt
  if !ok {
    litAtomRollback(s.csAtoms)
    readRepMemoAdvance()
  }
  return m
}

// Whether a helper refused while this claim built: the claim declines before it writes a byte.
function softRefused(what: string): boolean {
  if emitSoftMsg == "" { return false }
  count(
    "claim fell back: "
      + what
      + "a legacy helper refused in `"
      + ib.irName
      + "`: "
      + emitSoftMsg,
  )
  return true
}

// The last claim's decline: its unit, what it declined, and the node that names. Set once a
// claim's build is done, cleared when the claim succeeds, and read by a refusal of the same unit.
// A unit no claim declined reads "".
let declUnit = -1
let declWhat = ""
let declAt = -1
// The refusal a decline met, verbatim: a contract the claim raised, or a legacy helper's refusal
// inside it; "" for a miss.
let declRefusal = ""

// What the claim for `unit` (a function, or the top-level code's first statement) declined, such
// as "this statement (is guard)", or "" when it did not decline.
export function irDeclinedFor(unit: i32): string {
  if unit < 0 || unit != declUnit { return "" }
  return declWhat
}

// The node the last decline names: the statement holding a builder miss, else the unit.
export function irDeclineAt(): i32 { return declAt }

// The refusal the claim for `unit` met, verbatim, or "" when it declined on a miss or did not
// decline. Such a unit's refusal is that sentence, not "cannot yet lower".
export function irDeclineRefusalFor(unit: i32): string {
  if unit < 0 || unit != declUnit { return "" }
  return declRefusal
}

// Records the refusal a claim met (the pending unit's), at the node it named when it named one,
// and answers false, as a decline does.
function declineRefused(msg: string): boolean {
  declRefusal = msg
  if emitSoftAt >= 0 { declAt = emitSoftAt }
  return false
}

// Records the lowering's why for a decline: a legacy helper's refusal inside it is that refusal.
function declineWhy(whole: string, why: string) {
  declWhat = whole + " (" + why + ")"
  const at = why.indexOf("`: ")
  if why.indexOf("a legacy helper refused in ") == 0 && at > 0 {
    declineRefused(why.slice(at + 3, why.length))
  }
}

// Records, once the build is done, that the claim for `unit` declines with what the build missed
// (or `whole`) unless a later step clears it: a claim that succeeds sets `declUnit` to -1.
function declinePending(unit: i32, built: string, whole: string) {
  declUnit = unit
  declRefusal = ""
  declWhat = if built != "" { "this statement (" + built + ")" } else { whole }
  declAt = if built != "" { missAtOr(unit) } else { unit }
}

// The node a builder miss names: the statement holding it, else the unit.
function missAtOr(unit: i32): i32 {
  if ibMissAt >= 0 { return ibMissAt }
  return unit
}

// The claim seam, before legacy lowers the function at `fnIx` (`fnStmts` slot `fnPos`): when the
// builder covers it and every node is claimed, the lowering writes its code entry onto `out` and
// this answers true, so legacy does not run. Armed, legacy always runs and the shadow checks it.
export function irClaimFn(fnIx: i32, fnPos: i32, out: u8[]): boolean {
  declUnit = -1
  // Nothing claimed builds nothing: the predicate's cost is paid only once a family is claimed.
  if ibArmed || CLAIMED.length == 0 && !ibClaimAll { return false }
  const s = claimScopeBegin()
  const ok = claimFn(fnIx, fnPos, out)
  claimScopeEnd(s, ok)
  return ok
}

function claimFn(fnIx: i32, fnPos: i32, out: u8[]): boolean {
  const gen = repNodeGen()
  const minted = synthMintCount()
  ibClaimBuild = true
  const built = build(fnIx, fnPos)
  ibClaimBuild = false
  declinePending(fnIx, built, "this function")
  if softRefused("") { return declineRefused(emitSoftMsg) }
  if claimBuildMinted(minted) { return false }
  if built != "" || repNodeGen() != gen || !claimable() { return false }
  corrupt()
  if irBVerify(ib).vfRule != 0 {
    count("claim fell back: verifier")
    return false
  }
  const why = irLowerClaim(ib, globalCtxOf(fnPos), fnPos, out)
  if why != "" {
    declineWhy("this function", why)
    count("claim fell back: " + why)
    return false
  }
  declUnit = -1
  count("claimed")
  return true
}

// Whether a claim's build minted a synthetic global past count `before`: the builder asks plans
// read-only, so one it minted would move the global section ahead of legacy's writing.
function claimBuildMinted(before: i32): boolean {
  if synthMintCount() == before { return false }
  count("claim fell back: build minted a synthetic global")
  return true
}

// Whether the start body may be claimed: the `start` family is, and the shadow is not armed.
export function irStartClaimOn(): boolean {
  return !ibArmed && familyClaimed("start")
}

// The claim seam for a start body (the single start, or an init function's, `poolFill` false),
// before legacy writes it: built from `order` (an `orderGi` entry at or above 0 being that
// global's initializer), and when every node is in a claimed family, the lowering writes its
// code entry onto `out` and this answers true.
export function irClaimStart(
  order: i32[],
  orderGi: i32[],
  poolFill: boolean,
  out: u8[],
): boolean {
  declUnit = -1
  if !irStartClaimOn() { return false }
  const s = claimScopeBegin()
  const ok = claimStart(order, orderGi, poolFill, out)
  claimScopeEnd(s, ok)
  return ok
}

function claimStart(
  order: i32[],
  orderGi: i32[],
  poolFill: boolean,
  out: u8[],
): boolean {
  const gen = repNodeGen()
  const minted = synthMintCount()
  ibClaimBuild = true
  const built = buildStart(order, orderGi, poolFill)
  ibClaimBuild = false
  declinePending(
    if order.length > 0 { order[0] } else { -1 },
    built,
    "this top-level code",
  )
  if softRefused("start ") { return declineRefused(emitSoftMsg) }
  if claimBuildMinted(minted) { return false }
  if built != "" || repNodeGen() != gen || !claimable() { return false }
  corrupt()
  if irBVerify(ib).vfRule != 0 {
    count("claim fell back: verifier")
    return false
  }
  const why = irLowerClaim(ib, ibGlobalCtx(), -1, out)
  if why != "" {
    declineWhy("this top-level code", why)
    count("claim fell back: " + why)
    return false
  }
  declUnit = -1
  count("claimed start")
  return true
}

// The shadow's failing controls: 0 none; the verifier refuses 1 (a rep swapped), 2 (a temp's
// definition deleted), 7 to 12 (`unrelatedMapControl`, `otherAgainControl`, `nulEqNoNullableControl`,
// `nicheKindControl` both ways, `headControl`); the dual emit reports 3 (a byte added), 4 (a span
// row dropped) and 5 (its element-read rows); 6 is the held coercion.
export function irShadowCorrupt(k: i32) {
  ibCorrupt = k
  return 0
}

export function irShadowArmed(): boolean { return ibArmed }

// Starts a compile's report.
export function irShadowBegin() {
  ibRowKey = []
  ibRowN = []
  claimScopeOpen = false
  cellHeapMemo = Map()
  return 0
}

function count(key: string) {
  let i = 0
  while i < ibRowKey.length {
    if ibRowKey[i] == key {
      ibRowN[i] = ibRowN[i] + 1
      return 0
    }
    i = i + 1
  }
  ibRowKey.push(key)
  ibRowN.push(1)
  return 0
}

export function irShadowRowCount() { return ibRowKey.length }

export function irShadowRowLen(i: i32) { return ibRowKey[i].length }

export function irShadowRowAt(i: i32, j: i32) { return ibRowKey[i][j] }

export function irShadowRowN(i: i32) { return ibRowN[i] }

// The function being built and the first construct outside the set.
let ib: IrFn = irFnNew(-1, "")
let ibFnIx = -1
// Whether this build held a parameter or a `let` at a row legacy declares; only then can a read
// be of one (`declRowParamVarOf`).
let ibDeclRowSeen = false
// The `fnStmts` slot of the function being built, for the global storage classes.
let ibFnPos = -1
// The returned record literal the result-row rule declined for a nested field at another rep of
// its row, so the return's miss names that case; -1 when none.
let ibRetNestedTwin = -1
let ibMiss = ""
// The innermost statement whose build set `ibMiss`, or -1.
let ibMissAt = -1
// The right side of the name write (`x = v`, or a capture-box write `let`) last built, as legacy's
// `stubWriteRhs`: a generic function read there is the stub cell's own value, not unfixed.
let ibStubRhs = -1
// The initializer of the binding being built when legacy stores it as a generic function's core
// closure (`letStoresGenericAliasCore`): legacy never refuses that read, so neither does the claim.
let ibAliasRhs = -1
let ibDeclVar: {[i32]: i32} = Map()
let ibLoopName: string[] = []
let ibLoopBrk: i32[] = []
let ibLoopCont: i32[] = []
// The result binding of each break label whose frame carries a loop value.
let ibLvOf: {[i32]: i32} = Map()
let ibLabelN = 0
// The `shadow` arm rows built so far (`fitShadowVar`): name, `K`, receiver local and variable.
let ibFitShName: string[] = []
let ibFitShTy: i32[] = []
let ibFitShRecv: i32[] = []
let ibFitShVar: i32[] = []
// `ifChain`'s answer for a guard that ends its block; `stmt` writes the cut behind it.
const IF_CUTS_BLOCK = -9
// The statements whose end closes a list reserve region the body opened (`reserve.open`), and
// each region's counted pushes, planned for legacy's unroll decision (`lbPlanAdd`).
let ibReserveEnd: i32[] = []
let ibReservePushes: i32[][] = []
// The fully unrolled range loops being built, by `ForRange`, and the constant each copy's
// variable reads, innermost last. Stacks, not a map: a map delete anywhere in the compiler makes
// every map it builds dearer.
// By the null-test `if` of a minted `??` link's `holeMap` arm, the link's type (`chainLinkTy`).
let ibLinkIfTy: {[i32]: i32} = Map()
let ibRangeImmAt: i32[] = []
let ibRangeImmVal: i32[] = []
let ibBool = -1
let ibNoValue = -1

// Whether a value of rep `r` and type `ty` can be a variable, a parameter, a result or an
// expression here: a scalar, or a reference rep the list builder admits.
function valueRep(r: i32, ty: i32): boolean {
  return repIsScalar(r)
    || repPrim(r) == "v128"
    || repNodeAt(r) is RAtom
    || repNodeAt(r) is RBox
    || repNodeAt(r) is RRecord
    || repNodeAt(r) is RClosure
    || repNodeAt(r) is RMap
    || boxedNullable(r)
    || atomNullable(r)
    || strNullable(r)
    || refNullable(r)
    || boolNullable(r)
    || repPrim(r) == "null"
    || irVarRepOkHook(r, ty)
}

// A box's `is` test at the variant rung legacy answers by the tag alone (`isArmOf` from rank 0,
// no staged receiver, `isVariantTagPlain`), over a plain read (`isBoxGuardPlain`).
function boxTest(b: i32[], n: IsExpr, ix: i32, rep: i32): Opnd {
  // `emitIs`'s pre-rungs first: a test at its storage, or one decided before any rung.
  const d = isDecidedPlanOf(ix, ibFnIx)
  if d.idArm == "storage" { return storedBoxTest(b, n, ix, rep) }
  if d.idArm != "test" { return isDecidedTest(b, n, d, ix, rep) }
  if n.isFit >= 0 { return isFitTest(b, n, rep) }
  if isRecvStageRep(ix, ibFnIx) >= 0 { return isStagedTest(b, n, ix, rep) }
  return isRung(b, n, ix, rep, isArmOf(ix, ibFnIx, 0, false))
}

// A test the checker minted as a content check (`isFit`, a map against a narrower map): the check
// itself, as `emitIsTest` writes it.
function isFitTest(b: i32[], n: IsExpr, rep: i32): Opnd {
  const v = irBExpr(b, n.isFit)
  if ibMiss != "" { return v }
  if irBOpRep(v) != rep { return irBMiss("is fit rep") }
  return v
}

// An `is` decided before any rung (`isDecidedPlanOf`), as `isDecidedOperand` writes it: the operand
// evaluated and dropped when the plan says, then the constant.
function isDecidedTest(
  b: i32[],
  n: IsExpr,
  d: IsDecided,
  ix: i32,
  rep: i32,
): Opnd {
  if rep != ibBool { return irBMiss("is result rep") }
  if d.idEval {
    const o = irBExpr(b, n.isObj)
    if ibMiss != "" { return o }
    irBNode(b, { dpV: o }, -1, ibNoValue, ix)
  }
  const bits: i64 = if d.idBit != 0 { 1 } else { 0 }
  const c: Opnd = { oiRep: rep, oiBits: bits }
  return c
}

// `recv is K` over a numeric literal union along `numIsPlanOf` (`emitIsTestNumLit`): the receiver
// once into a slot, or once per member, a re-read written again as the builder read it.
function isNumLit(b: i32[], n: IsExpr, ix: i32, rep: i32): Opnd {
  if rep != ibBool { return irBMiss("is result rep") }
  const pl = numIsPlanOf(ix, n, ibFnIx)
  if pl.nlTexts.length == 0 { return irBMiss("is numeric literal none") }
  const v = irBExpr(b, n.isObj)
  if ibMiss != "" { return v }
  if repPrim(irBOpRep(v)) == null {
    return irBMiss("is numeric literal operand rep")
  }
  if !pl.nlOnce && pl.nlTexts.length > 1 {
    if !(v is OVar) || v.ov < 0 {
      return irBMiss("is numeric literal receiver")
    }
    if (
      ib.irVars[v.ov].vKind == "temp"
      && !recvReadsAgain(unwrapParen(n.isObj))
    ) {
      return irBMiss("is numeric literal receiver")
    }
  }
  return irBLetTemp(b, { niV: v, niAt: ix }, ix, rep)
}

// `x is "lit"` on the `litMember` rung, as `emitLitMemberEq` writes it: the one string literal's
// compare, which the literal arms' member test writes the same way. A number literal is a miss.
function isLitMember(b: i32[], n: IsExpr, ix: i32, rep: i32): Opnd {
  if !litMemberIsString(ix) { return irBMiss("is literal member number") }
  return isLitArmsTest(b, n, ix, rep, "memberEq")
}

// `x is L` over a box of list arms on the `listAcross` rung, as `emitListIsAcrossReps` writes it.
function isListAcross(b: i32[], n: IsExpr, ix: i32, rep: i32): Opnd {
  if rep != ibBool { return irBMiss("is result rep") }
  const v = irBExpr(b, n.isObj)
  if ibMiss != "" { return v }
  return irBLetTemp(b, { laV: v, laAt: ix }, ix, rep)
}

// `is` test `ix` from rung `arm` on, as `emitIsTestRungs` takes it: a rung that declines passes
// to the next (`isArmOf` from the rank after it).
function isRung(b: i32[], n: IsExpr, ix: i32, rep: i32, arm: IsArm): Opnd {
  if arm == "nulTest" { return isNulTest(b, n, ix, rep) }
  if arm == "never" || arm == "pinNever" {
    return isConstTest(b, n, 0, ix, rep)
  }
  if arm == "litArms" { return isLitArms(b, n, ix, rep) }
  if arm == "nullInst" { return isNullInstTest(ix, rep) }
  if arm == "emptyFit" {
    const p = emptyFitPlanOf(ix, ibFnIx)
    if emptyFitDeclines(p, ix) {
      return isRung(
        b,
        n,
        ix,
        rep,
        isArmOf(ix, ibFnIx, isArmRank(arm) + 1, false),
      )
    }
    return isEmptyFit(b, n, ix, rep, p)
  }
  if arm == "static" {
    // A static `false` first tries legacy's empty-list fit, which may still write a test.
    const st = monoStaticIsResult(ix, ibFnIx)
    if st == 1 { return isConstTest(b, n, 1, ix, rep) }
    const p = emptyFitPlanOf(ix, ibFnIx)
    if emptyFitDeclines(p, ix) { return isConstTest(b, n, 0, ix, rep) }
    return isEmptyFit(b, n, ix, rep, p)
  }
  if arm == "numLit" { return isNumLit(b, n, ix, rep) }
  if arm == "listAcross" { return isListAcross(b, n, ix, rep) }
  if arm == "recordFit" {
    const p = recordFitPlanOf(ix, ibFnIx)
    if p == 0 {
      return isRung(
        b,
        n,
        ix,
        rep,
        isArmOf(ix, ibFnIx, isArmRank(arm) + 1, false),
      )
    }
    if p < 0 { return irBMiss("is record fit refused") }
    if p == 2 { return irBMiss("is record fit staged") }
    if rep != ibBool { return irBMiss("is result rep") }
    const v = irBExpr(b, n.isObj)
    if ibMiss != "" { return v }
    // Legacy's field tests re-read it, so a variable (`fitRecvReadHook`).
    if !(v is OVar) { return irBMiss("is record fit receiver") }
    return irBLetTemp(b, { rfV: v, rfAt: ix }, ix, rep)
  }
  if arm == "listFit" {
    const p = listFitIsPlanOf(ix, ibFnIx)
    if p.lftOk == 0 {
      return isRung(
        b,
        n,
        ix,
        rep,
        isArmOf(ix, ibFnIx, isArmRank(arm) + 1, false),
      )
    }
    if p.lftOk < 0 { return irBMiss("is list fit refused") }
    if rep != ibBool { return irBMiss("is result rep") }
    const v = irBExpr(b, n.isObj)
    if ibMiss != "" { return v }
    return irBLetTemp(b, { lsV: v, lsAt: ix }, ix, rep)
  }
  if arm == "litMember" { return isLitMember(b, n, ix, rep) }
  // A float box tested against integer literals is each member's box test or-ed, `numBox`'s.
  if arm == "floatLits" { return isLitArmsTest(b, n, ix, rep, "numBox") }
  if arm != "variant" && arm != "armTag" { return irBMiss("is rung") }
  // Each rung's own answer, asked once: the arm tag's `tagIsArmOf`, the variant's plain row.
  const ta: TagIsArm = if arm == "armTag" { tagIsArmOf(ix, n, ibFnIx) } else { "none" }
  const vi = if arm == "variant" { isVariantTagPlain(ix, ibFnIx) } else { -1 }
  if ta == "tagAbsent" { return isTagAbsentTest(rep) }
  if arm == "variant" && vi < 0 { return isVariantTest(b, n, ix, rep) }
  // A test that cannot tell a map from its literal-union twin is legacy's own refusal, raised here.
  if ta == "softTwin" && emitSoftFail {
    mapSoftTwinTagFail(n.isObj, isArmPatTy(ix, n, ibFnIx), ibFnIx, ix)
  }
  if !isBoxGuardPlain(ix, ibFnIx) { return irBMiss("is guard") }
  if rep != ibBool { return irBMiss("is result rep") }
  if ta == "lacks" {
    const lv = irBExpr(b, n.isObj)
    if ibMiss != "" { return lv }
    return isLacksTest(b, lv, ix, rep)
  }
  // Membership over the box's string payload is the `boxLits` arm's test over the same members.
  if ta == "boxLitSet" { return isLitArmsTest(b, n, ix, rep, "boxLits") }
  if ta == "optField" { return optFieldTest(b, n, ix, rep) }
  const tag = boxTestTagOf(n, ix, arm, ta, vi)
  if ibMiss != "" { return irBMiss(ibMiss) }
  // A record's box field is read raw, at its storage, as legacy's `memStruct` arm reads it; a
  // global's box raw too (`emitUnionBoxPush`'s global arm), whatever its narrowing.
  const stored = arm == "armTag" && (ta == "memStruct" || ta == "memVariant")
  const gbox = ta == "identBox"
    && localIndexOf(ibFnIx, unwrapParen(n.isObj)) < 0
  const mark = if stored { storageReadEnter(n.isObj) } else { storageReadEnter(-1) }
  const v = if gbox { irBBoxLocal(b, unwrapParen(n.isObj)) } else { irBExpr(b, n.isObj) }
  storageReadLeave(mark)
  if ibMiss != "" { return v }
  // A read at its storage is the field's own plain box, as the verifier holds a stored read; a
  // narrowed read is its storage's declared box (`storedMemberBoxTest`).
  const st = if stored { readNarrowedStoreAt(n.isObj, ibFnIx) } else { -1 }
  if (
    stored && !heldAsBox(irBOpRep(v))
    || st >= 0 && irBOpRep(v) != repNodeOfTy(st)
  ) {
    return irBMiss("is member storage rep")
  }
  if !(repNodeAt(irBOpRep(v)) is RBox) && !boxedNullable(irBOpRep(v)) {
    return irBMiss("is operand rep")
  }
  return irBLetTemp(b, { teV: v, teTag: tag }, ix, rep)
}

// `xs is K[]` whose elements never meet `K`'s at some depth, along plan `p`'s walk: the list,
// then its emptiness at every depth. A union receiver's arms and a shadowed region are misses.
function isEmptyFit(
  b: i32[],
  n: IsExpr,
  ix: i32,
  rep: i32,
  p: EmptyFitPlan,
): Opnd {
  if p.efArm == "union" { return isEmptyFitArms(b, n, ix, rep, p) }
  const fit = if p.efArm == "shadow" { fitShadowVar(n, ix, p) } else { -1 }
  if ibMiss != "" { return irBMiss(ibMiss) }
  if p.efArm != "loop" && fit < 0 { return irBMiss("is empty fit " + p.efArm) }
  if p.efRepWhy != "" { return irBMiss("is empty fit rep") }
  if rep != ibBool { return irBMiss("is result rep") }
  const v = irBExpr(b, n.isObj)
  if ibMiss != "" { return v }
  if !(repNodeAt(irBOpRep(v)) is RList) {
    return irBMiss("is empty fit operand rep")
  }
  return irBLetTemp(b, { leV: v, leAt: ix, leFit: fit }, ix, rep)
}

// The variable a `shadow` arm's region reads `xs` as (`listFitShadowSet`): one per name, `K` and
// receiver local, made at the first such test in build order, which is legacy's emit order. Its
// slot is the scratch local the lowering's store allocates. A pushing arm or a closure's
// capture is a miss.
function fitShadowVar(n: IsExpr, ix: i32, p: EmptyFitPlan): i32 {
  const r = unwrapParen(n.isObj)
  if r < 0 || r >= P.nodes.length { return -1 }
  const rn = nodeAt(r)
  if !(rn is Ident) { return -1 }
  const pl = listFitShadowPlanOf(ix, p.efRecvTy, p.efDepth, ibFnIx)
  if pl < 0 {
    irBMiss("is empty fit shadow refused")
    return -1
  }

  const kTy = listFitShadowTyOf(ix)
  const recv = localIndexOf(ibFnIx, r)
  let i = 0
  while i < ibFitShName.length {
    if (
      ibFitShName[i] == rn.identName
      && listFitShadowSameTy(ibFitShTy[i], kTy)
      && ibFitShRecv[i] == recv
    ) {
      return ibFitShVar[i]
    }
    i = i + 1
  }
  const fr = repNodeOfTy(kTy)
  if !(repNodeAt(fr) is RList) {
    irBMiss("is empty fit shadow rep")
    return -1
  }
  const v = irVarNew(ib, fr, kTy, "local", -1)
  ibFitShName.push(rn.identName)
  ibFitShTy.push(kTy)
  ibFitShRecv.push(recv)
  ibFitShVar.push(v)
  return v
}

// The `shadow` arm variable read `ix` of `n` takes in place of its binding, as legacy's
// `listFitShadowRow` redirects it: the same name and receiver local, typed as the arm's list.
function fitShadowReadVar(n: Ident, ix: i32): i32 {
  if ibFitShName.length == 0 { return -1 }
  const recv = localIndexOf(ibFnIx, unwrapParen(ix))
  if recv < 0 { return -1 }
  let i = 0
  while i < ibFitShName.length {
    if (
      ibFitShName[i] == n.identName
      && ibFitShRecv[i] == recv
      && listFitShadowReadsRow(ibFitShTy[i], ix, ibFnIx)
    ) {
      return ibFitShVar[i]
    }
    i = i + 1
  }
  return -1
}

// `recv is <literal type>` at the `litArms` rung, along `litIsArmOf`'s arm as `emitIsTestLitArms`
// writes it: a scalar map read's hit or miss, a ref niche's null test, or a constant. A constant
// is built only over a re-readable receiver, since legacy writes no receiver read before it.
function isLitArms(b: i32[], n: IsExpr, ix: i32, rep: i32): Opnd {
  const la = litIsArmOf(ix, n, ibFnIx)
  return match la {
    "mapNull" | "mapHas" => mapReadHas(b, n.isObj, la == "mapHas", ix, rep)
    "nicheTest" => isNulTest(b, n, ix, rep)
    "nicheNever" | "atomTrue" | "memberTrue" => {
      if rep != ibBool { return irBMiss("is result rep") }
      if !unionEqOperandOk(n.isObj) {
        return irBMiss("is literal constant receiver")
      }
      const bits: i64 = if la == "nicheNever" { 0 } else { 1 }
      const o: Opnd = { oiRep: rep, oiBits: bits }
      o
    }
    "nicheRaw" | "atomNotNul" | "atomEq" | "memberEq" | "boxLits" | "numBox" => {
      isLitArmsTest(b, n, ix, rep, la)
    }
    "memberNoRecv" | "none" => {
      irBMiss("is rung litArms " + la)
    }
  }
}

// Why a member of `is` test `ix`'s `memberEq` arm does not compare as a string over receiver
// `recvIx` at rep `r` (a string's plain compare, or a `string | null`'s guarded one), else "".
function memberEqMissOf(recvIx: i32, ix: i32, r: i32): string {
  const texts = litIsMemberTexts(ix)
  if texts.length == 0 { return "is literal member none" }
  const rn = repNodeAt(r)
  let i = 0
  while i < texts.length {
    const a = litMemberEqArmOf(recvIx, quoteLex(texts[i]), ibFnIx)
    const ok = match a {
      "str" => repPrim(r) == "str"
      "nulStr" => rn is RNullable && repPrim(rn.rnInner) == "str"
      "union" => tagBoxRep(r) && boxLitsMissOf(recvIx, [quoteLex(texts[i])]) == ""
      "num" => false
    }
    if !ok { return "is literal member " + a + " at " + repWhat(r) }
    i = i + 1
  }
  return ""
}

// Whether rep `r` is a box whose tag a literal's test reads: a box, or a null-tagged box, whose
// null is one more tag of the same box.
function tagBoxRep(r: i32): boolean {
  const n = repNodeAt(r)
  return n is RBox || n is RNullable && n.rnDisc == 4
}

// Why a box receiver `recvIx` is not tested against each literal of `lexes` by a tag test (or a
// static false) the IR writes, else "": `emitUnionLitIs` refuses the literal.
function boxLitsMissOf(recvIx: i32, lexes: string[]): string {
  if lexes.length == 0 { return "is literal box none" }
  for lex in lexes {
    const a = unionLitIsPlanOf(recvIx, lex, ibFnIx).ulArm
    if a == "noSet" || a == "noArm" { return "is literal box " + a }
  }
  return ""
}

// A literal arm that reads its operand and writes its own test (`RLitArms`): a ref niche's null
// test, an atom's compare with the null id, or each member's compare. A re-read is a variable's.
function isLitArmsTest(
  b: i32[],
  n: IsExpr,
  ix: i32,
  rep: i32,
  la: LitIsArm,
): Opnd {
  if rep != ibBool { return irBMiss("is result rep") }
  // An atom compare reads its operand's cell, the id legacy compares, not its string decode.
  const v = exprAt(b, n.isObj, la == "atomEq" || la == "atomNotNul")
  if ibMiss != "" { return v }
  const vn = repNodeAt(irBOpRep(v))
  const ok = match la {
    "nicheRaw" => vn is RNullable && vn.rnDisc != 3 && vn.rnDisc != 2
    "atomNotNul" => atomNullable(irBOpRep(v))
    "atomEq" => vn is RAtom || atomNullable(irBOpRep(v))
    "memberEq" => true
    "boxLits" | "numBox" => tagBoxRep(irBOpRep(v))
    "mapNull" | "mapHas" | "nicheNever" | "nicheTest" | "atomTrue" | "memberNoRecv" | "memberTrue" | "none" => false
  }
  if !ok { return irBMiss("is literal arms operand rep") }
  const why = if la == "memberEq" { memberEqMissOf(n.isObj, ix, irBOpRep(v)) } else if la == "boxLits" || la == "numBox" { boxLitsMissOf(n.isObj, litIsBoxLexes(ix, la)) } else { "" }
  if why != "" { return irBMiss(why) }
  // A receiver read more than once is read again as the builder read it (`irHoistRecv`).
  if (
    litArmsReadsOf(ix, la, n.isObj, ibFnIx) > 1
    && (!(v is OVar)
      || v.ov < 0
      || ib.irVars[v.ov].vKind == "temp" && !recvReadsAgain(unwrapParen(n.isObj)))
  ) {
    return irBMiss("is literal arms receiver")
  }
  return irBLetTemp(b, { liV: v, liArm: la, liAt: ix }, ix, rep)
}

// Whether `emitListEmptyFitIs` answers 0 along plan `p`, passing to the next rung.
function emptyFitDeclines(p: EmptyFitPlan, ix: i32): boolean {
  if p.efArm == "decline" { return true }
  if p.efArm != "union" { return false }
  return emptyFitArmsPlanOf(ix, ibFnIx, p.efRecvTy).eaWhy == "decline"
}

// `u is K[]` over a box variable with list arms `K[]` never meets: each arm's tag and emptiness
// (`emptyFitArmsPlanOf`), re-reading the variable. A nullable receiver, a region that reads an
// arm's list, and any other receiver are misses.
function isEmptyFitArms(
  b: i32[],
  n: IsExpr,
  ix: i32,
  rep: i32,
  p: EmptyFitPlan,
): Opnd {
  const ap = emptyFitArmsPlanOf(ix, ibFnIx, p.efRecvTy)
  if !ap.eaBoxed { return irBMiss("is empty fit nullable") }
  if !emptyFitArmsPlain(ap) { return irBMiss("is empty fit union") }
  if rep != ibBool { return irBMiss("is result rep") }
  const v = irBExpr(b, n.isObj)
  if ibMiss != "" { return v }
  if (
    !(v is OVar)
    || v.ov < 0
    || ib.irVars[v.ov].vKind == "temp"
    || !(repNodeAt(irBOpRep(v)) is RBox)
  ) {
    return irBMiss("is empty fit receiver")
  }
  return irBLetTemp(b, { lfV: v, lfAt: ix }, ix, rep)
}

// The variable a staged `is` receiver is read from while its rungs build (`isStagedTest`), or -1.
let ibStagedVar = -1

// A receiver `emitIsTest` evaluates once into its stash before the rungs re-read it (D12060): the
// receiver, built first, held in a variable on that stash, then the rungs from rank 0 over it with
// legacy's stage marked. Every node the rungs build is a temp the stage writes inside it.
function isStagedTest(b: i32[], n: IsExpr, ix: i32, rep: i32): Opnd {
  if rep != ibBool { return irBMiss("is result rep") }
  if isRecvStagedIx >= 0 || ibStagedVar >= 0 {
    return irBMiss("is staged nested")
  }
  const k = isRecvStageRep(ix, ibFnIx)
  const v = irBExpr(b, n.isObj)
  if ibMiss != "" { return v }
  const vr = irBOpRep(v)
  if !stagedKeyHolds(k, vr) { return irBMiss("is staged rep") }
  const ty = heldTy(outTyOf(unwrapParen(n.isObj), vr))
  if irTyHeldOpen(ty, vr) { return irBMiss("open temp type") }
  const sv = irVarNew(ib, vr, ty, "local", -1)
  const n0 = b.length
  isRecvStagedIx = unwrapParen(n.isObj)
  isRecvStagedNonNull = k == 3
  ibStagedVar = sv
  const t = isRung(b, n, ix, rep, isArmOf(ix, ibFnIx, 0, true))
  isRecvStagedIx = -1
  isRecvStagedNonNull = false
  ibStagedVar = -1
  if ibMiss != "" { return t }
  let i = n0
  while i < b.length {
    if !(ib.irNodes[b[i]] is SLet) { return irBMiss("is staged statement") }
    i = i + 1
  }
  return irBLetTemp(
    b,
    { stV: v, stVar: sv, stKey: k, stTest: t, stAt: ix },
    ix,
    rep,
  )
}

// Whether rep `r` is what stash key `k` holds: a union box (its null a tag too), an atom id (its
// null the null id), a nullable string, or a string the stash holds nullable.
function stagedKeyHolds(k: i32, r: i32): boolean {
  if k == 0 { return repNodeAt(r) is RBox || boxedNullable(r) }
  if k == 1 { return repNodeAt(r) is RAtom || atomNullable(r) }
  if k == 2 { return strNullable(r) }
  return k == 3 && repPrim(r) == "str"
}

// While an arm-site read's arm builds (`irBArmSiteArm`): node `ibArmRecvIx` reads the arm's
// payload variable `ibArmRecvVar`, and node `ibArmIdxIx` the operand in `ibArmIdxOps`, if any.
let ibArmRecvIx = -1
let ibArmRecvVar = -1
let ibArmIdxIx = -1
let ibArmIdxOps: Opnd[] = []

// Arm `m` of arm-site read `ix` built into `b` and delivered at `rep`, as legacy's arm lowers it:
// the read at element type `e`, its receiver at `m` read as payload variable `pv`, and its index
// or key node `on` read as `io`'s one operand (none for a `.length`).
export function irBArmSiteArm(
  b: i32[],
  ix: i32,
  m: i32,
  e: i32,
  pv: i32,
  on: i32,
  io: Opnd[],
  rep: i32,
): Opnd {
  if ibArmRecvVar >= 0 { return irBMiss("arm site nested") }
  // A box read is boxed at the read's own union, as legacy's `emitUnionCoerce` boxes it.
  const u = nodeTyAt(ix, ibFnIx)
  // A read at a numeric literal set takes each arm's member at the set's own rep (D17001).
  const lit = armSiteAtLitSet(ix, ibFnIx)
  const mark = luOvEnter(armSiteRecv(ix), m)
  luOvEnter(ix, e)
  readRepMemoAdvance()
  ibArmRecvIx = armSiteRecv(ix)
  ibArmRecvVar = pv
  ibArmIdxIx = on
  ibArmIdxOps = io
  let d = if heldAsBox(rep) || lit { exprAt(b, ix, false) } else { deliver(b, ix, rep, -1) }
  if heldAsBox(rep) && ibMiss == "" && irBOpRep(d) != rep {
    d = boxTempIn(b, d, ix, rep, -1, u)
  }
  const sk = numKindOf(irBOpRep(d))
  if lit && ibMiss == "" && irBOpRep(d) != rep && sk > 0 && numKindOf(rep) > 0 {
    const nw: Rhs = { nwV: d, nwSrc: sk, nwDst: numKindOf(rep), nwAt: ix }
    d = irBLetTempTy(b, nw, ix, rep, repTyOf(rep))
  }
  ibArmRecvIx = -1
  ibArmRecvVar = -1
  ibArmIdxIx = -1
  ibArmIdxOps = []
  luOvLeave(mark)
  // The read-rep memo's key names no override, so what it holds is forgotten across one.
  readRepMemoAdvance()
  return d
}

// The staged receiver's read (`isStagedTest`), as `emitExpr` reads it past its dead-never and
// coercion arms: the stash's variable.
function stagedRecvRead(ix: i32): Opnd {
  const pre = exprPrePathWhy(ix, ibFnIx)
  if (
    pre == "pre-path dead never"
    || pre == "pre-path coercion"
    || pre == "pre-path tag dispatch"
  ) {
    return irBMiss("is staged receiver " + pre)
  }
  const o: Opnd = { ov: ibStagedVar }
  return o
}

// `recv is U` for a union alias arm `U` of the receiver's box: per tag of `U`, the box read again
// and its tag compared, each after the first or-ed in, as `emitIsTestVariant`'s `tagChain` writes
// it, over a receiver that reads again with no effect (`unionEqOperandOk`).
function isTagChain(b: i32[], n: IsExpr, ix: i32, rep: i32, tags: i32[]): Opnd {
  if tags.length == 0 { return irBMiss("is variant tagChain none") }
  if !unionEqOperandOk(n.isObj) {
    return irBMiss("is variant tagChain receiver")
  }
  let acc = tagChainTest(b, n, ix, rep, tags[0])
  let i = 1
  while i < tags.length && ibMiss == "" {
    const t = tagChainTest(b, n, ix, rep, tags[i])
    acc = irBLetTemp(b, { poOp: "or", poArgs: [acc, t] }, ix, rep)
    i = i + 1
  }
  return acc
}

// Whether every node body `b` gained from `at` on is a temp's definition, none a statement.
function onlyTempsFrom(b: i32[], at: i32): boolean {
  let i = at
  while i < b.length {
    const nd = ib.irNodes[b[i]]
    if !(nd is SLet) || nd.lDst < 0 || ib.irVars[nd.lDst].vKind != "temp" {
      return false
    }
    i = i + 1
  }
  return true
}

// One tag of `isTagChain`: the receiver read again, then its box's tag compared with `tag`.
function tagChainTest(b: i32[], n: IsExpr, ix: i32, rep: i32, tag: i32): Opnd {
  const v = irBExpr(b, n.isObj)
  if ibMiss != "" { return v }
  if !heldAsBox(irBOpRep(v)) {
    return irBMiss("is variant tagChain receiver rep")
  }
  return irBLetTemp(b, { teV: v, teTag: tag }, ix, rep)
}

// `recv is X` over a nullable niche at `isArmOf`'s null-test rung: the niche's own null test
// (`nulTestArmOf`, niche only), true for present unless `X` is `null`. An impossible test is
// false, its receiver evaluated when it is no re-readable place.
function isNulTest(b: i32[], n: IsExpr, ix: i32, rep: i32): Opnd {
  if isNulTestImpossible(ix, ibFnIx) { return isConstTest(b, n, 0, ix, rep) }
  if rep != ibBool { return irBMiss("is result rep") }
  const invert = !isTestsNull(ix)
  const arm = nulTestArmOf(n.isObj, ibFnIx, invert, true)
  if arm != "atom" && arm != "bool" && arm != "nullRef" && arm != "nulStr" {
    return irBMiss("is null test " + arm)
  }
  const v = irBExpr(b, n.isObj)
  if ibMiss != "" { return v }
  if !nulTestOperandOk(arm, irBOpRep(v)) { return irBMiss("null test operand") }
  return irBLetTemp(b, { ntV: v, ntInvert: invert, ntAt: ix }, ix, rep)
}

// `recv is V` at the variant rung where `V` has no plain tag, along `variantIsArmOf` as
// `emitIsTestVariant` writes it: the receiver evaluated and dropped, then its constant. The row
// arm is `isVariantRow`'s, the alias arm's tag chain `isTagChain`'s.
function isVariantTest(b: i32[], n: IsExpr, ix: i32, rep: i32): Opnd {
  if rep != ibBool { return irBMiss("is result rep") }
  const tags: i32[] = []
  const na: VariantIsArm = variantIsArmOf(ix, n, ibFnIx, tags)
  if na == "row" {
    return isVariantRow(
      b,
      n,
      ix,
      rep,
      if tags.length > 0 { tags[0] } else { -1 },
    )
  }
  if na == "tagChain" { return isTagChain(b, n, ix, rep, tags) }
  if na != "recordTrue" && na != "pinFalse" {
    return irBMiss("is variant " + na)
  }
  const o = irBExpr(b, n.isObj)
  if ibMiss != "" { return o }
  irBNode(b, { dpV: o }, -1, ibNoValue, ix)
  const bits: i64 = if na == "recordTrue" { 1 } else { 0 }
  const c: Opnd = { oiRep: rep, oiBits: bits }
  return c
}

// `recv is V` at `V`'s tested row `vi`, along `variantRowArmOf` as `emitIsTestVariantRow` writes
// it: a static fold, a closed record that never fits, the row's tag alone, the tag and its
// discriminant fields, or the full chain over legacy's tail. A staged chain misses.
function isVariantRow(b: i32[], n: IsExpr, ix: i32, rep: i32, vi: i32): Opnd {
  const arm: VariantRowArm = variantRowArmOf(ix, n, ibFnIx, vi)
  if arm == "foldTrue" || arm == "foldFalse" {
    const c: Opnd = {
      oiRep: rep,
      oiBits: if arm == "foldTrue" { 1 } else { 0 },
    }
    return c
  }
  if arm == "neverFits" {
    const o = irBExpr(b, n.isObj)
    if ibMiss != "" { return o }
    irBNode(b, { dpV: o }, -1, ibNoValue, ix)
    const z: Opnd = { oiRep: rep, oiBits: 0 }
    return z
  }
  // A chain staged into the shared slot (a receiver no re-readable place) stays legacy's.
  if arm == "chain" && !unionEqOperandOk(n.isObj) {
    return irBMiss("is variant row chain staged")
  }
  if arm != "plainTag" && arm != "discrim" && arm != "chain" {
    return irBMiss("is variant row " + arm)
  }
  if !isBoxGuardPlain(ix, ibFnIx) { return irBMiss("is guard") }
  const v = irBExpr(b, n.isObj)
  if ibMiss != "" { return v }
  if arm == "discrim" {
    // Read once per literal, so a variable; the cast to the arm's heap needs a non-null box.
    if !(v is OVar) || !(repNodeAt(irBOpRep(v)) is RBox) {
      return irBMiss("is variant discrim receiver")
    }
    return irBLetTemp(b, { vdV: v, vdVi: vi, vdAt: ix }, ix, rep)
  }
  if arm == "chain" {
    // Legacy's tail re-reads it, so a box variable (`fitRecvReadHook`).
    if !(v is OVar) || !(repNodeAt(irBOpRep(v)) is RBox) {
      return irBMiss("is variant chain receiver")
    }
    return irBLetTemp(b, { vcV: v, vcVi: vi, vcAt: ix }, ix, rep)
  }
  if !(repNodeAt(irBOpRep(v)) is RBox) && !boxedNullable(irBOpRep(v)) {
    return irBMiss("is operand rep")
  }
  return irBLetTemp(b, { teV: v, teTag: uTags[vi] }, ix, rep)
}

// `recv is null` over a pinned instance's operand (`nullInstanceIsResult`): its constant, the
// receiver unread, as legacy's `nullInst` rung writes it.
function isNullInstTest(ix: i32, rep: i32): Opnd {
  if rep != ibBool { return irBMiss("is result rep") }
  const res = nullInstanceIsResult(ix, ibFnIx)
  if res < 0 { return irBMiss("is null instance") }
  const bits: i64 = if res != 0 { 1 } else { 0 }
  const o: Opnd = { oiRep: rep, oiBits: bits }
  return o
}

// A box test no arm of whose box carries the tag (`tagIsArmOf`'s `tagAbsent`): `false`, the
// receiver unread, as legacy's `emitIsTestArmTag` writes it.
function isTagAbsentTest(rep: i32): Opnd {
  if rep != ibBool { return irBMiss("is result rep") }
  const o: Opnd = { oiRep: rep, oiBits: 0 }
  return o
}

// An `is` test whose answer is static `v`, as legacy's `isConstAfterRecv` writes it: a receiver
// that is no re-readable place (`unionEqOperandOk`) evaluated and dropped, then the constant.
function isConstTest(b: i32[], n: IsExpr, v: i32, ix: i32, rep: i32): Opnd {
  if rep != ibBool { return irBMiss("is result rep") }
  if !unionEqOperandOk(n.isObj) {
    const o = irBExpr(b, n.isObj)
    if ibMiss != "" { return o }
    irBNode(b, { dpV: o }, -1, ibNoValue, ix)
  }
  const bits: i64 = if v != 0 { 1 } else { 0 }
  const o: Opnd = { oiRep: rep, oiBits: bits }
  return o
}

// `0, 1, ..., n - 1`.
function iotaOf(n: i32): i32[] {
  const out: i32[] = []
  let i = 0
  while i < n {
    out.push(i)
    i = i + 1
  }
  return out
}

// An object literal on a layout path legacy builds it by alone (`objLitArmOf`: a struct's
// `objLitLayoutRowOf`, a variant's `objLitVariantLayoutOf`): each field in layout order at its
// `plain` arm, owing no recovery, kept at its kid of the record rep, then the row's `struct.new`.
function objLit(b: i32[], ix: i32, rep: i32): Opnd {
  // A struct literal legacy builds at its destination's row is built at that row, at its own type.
  if objLitArmOf(ix, ibFnIx) == "struct" {
    const row = objLitLayoutRowOf(ix, ibFnIx)
    // The delivery's record, where it names the row legacy builds at (in layout or through the
    // order stash), is the type the literal is built at: the row's own recorded type, or the
    // literal's, may hold a field at another rep the same bytes carry.
    // A literal that omits fields is built at that row too, each omitted field its null (`emitObj`).
    const stashed = if row >= 0 { -1 } else { objLitStashRowOf(ix, ibFnIx) }
    const dropped = if row >= 0 || stashed >= 0 { -1 } else { objLitDropStashRowAt(ix, structIndexOfObjCtx(ix, ibFnIx)) }
    const built = if row >= 0 { row } else if stashed >= 0 { stashed } else if dropped >= 0 { dropped } else { objLitOmitRow(ix, -1) }
    const ct = recordPartTy(heldTy(ctxTyAt(ix, ibFnIx)))
    const cr = if built >= 0 && ct >= 0 && !irTyOpen(ct) && structIndexOfTy(ct) == built { repNodeOfTy(ct) } else { -1 }
    if cr >= 0 && cr != rep && repNodeAt(cr) is RRecord {
      return objLitAt(b, ix, cr, ct, built, false)
    }
    const rt = if row >= 0 && row < sTyIx.length { sTyIx[row] } else { -1 }
    const rr = if rt >= 0 && rowTyBuildsAt(rt, row) { repNodeOfTy(rt) } else { -1 }
    if rr >= 0 && rr != rep && repNodeAt(rr) is RRecord {
      return objLitAt(b, ix, rr, rt, row, false)
    }
  }
  // A variant literal is built at its layout row's type too, where that row's rep is another.
  if objLitArmOf(ix, ibFnIx) == "variant" {
    // Built from a wider record, a literal whose arm drops an effectful field is built there too.
    const vl = objLitVariantLayoutOf(ix, ibFnIx)
    const vi = if vl >= 0 { vl } else { objLitVariantDropStashAt(ix, objLitBuildVariantRow(ix, ibFnIx), ibFnIx) }
    const vt = if vi >= 0 && vi < uVarTyIx.length { uVarTyIx[vi] } else { -1 }
    const vr = if vt >= 0 && !irTyOpen(vt) { repNodeOfTy(vt) } else { -1 }
    if vr >= 0 && vr != rep && repNodeAt(vr) is RRecord {
      return objLitAtVariantRow(b, ix, vi)
    }
  }
  return objLitAt(
    b,
    ix,
    rep,
    rowlessRecordTy(ix, nodeTyAt(ix, ibFnIx), rep),
    -1,
    false,
  )
}

// The type a value of `ix` at rep `rep` is held at: its own (`exprTyOf`), or a storage row's
// (`rowlessRecordTy`).
function outTyOf(ix: i32, rep: i32): i32 {
  const t = exprTyOf(ix)
  // A minted `??` link with no type of its own holds its map's value (`openCoalMapTy`).
  if t < 0 || irTyOpen(heldTy(t)) {
    const ct = openCoalMapTy(ix)
    if ct >= 0 && repNodeOfTy(ct) == rep { return ct }
  }
  const ft = nullFoldedTy(t, rep)
  if ft >= 0 { return ft }
  // A record list held at its laid-out row is typed at that row's list (`listRowRep`).
  if t >= 0 && repNodeOfTy(t) != rep && repNodeAt(rep) is RList {
    const lt = listRowTyOf(ix, repNodeOfTy(t))
    if lt >= 0 && repNodeOfTy(lt) == rep { return lt }
  }
  return rowlessRecordTy(ix, t, rep)
}

// Where type `t` is `T | null` over a `T` that already admits `null` (a recursive alias the checker
// does not fold) and the value is held at `T`'s rep `rep`, the type holding it there; else -1.
function nullFoldedTy(t: i32, rep: i32): i32 {
  if t < 0 || !(repNodeAt(rep) is RNullable) { return -1 }
  const n = repNodeAt(repNodeOfTy(t))
  if !(n is RNullable) || n.rnInner != rep { return -1 }
  const rt = repTyOf(rep)
  return if rt >= 0 && repNodeOfTy(rt) == rep { rt } else { -1 }
}

// Type `t` of `ix`, or where `rowlessRecordRep` moved its rep `rep` to a storage row, that row's
// recorded type.
function rowlessRecordTy(ix: i32, t: i32, rep: i32): i32 {
  if t < 0 || repNodeOfTy(t) == rep || !builtRecord(t, repNodeOfTy(t)) {
    return t
  }
  const rt = builtStoredTy(t, repNodeOfTy(t), storeRowOf(ix))
  return if rt >= 0 && repNodeOfTy(rt) == rep { rt } else { t }
}

// Whether record type `t` at rep `rep` is one no struct row records: `rowlessStoredTy`'s own
// test, asked first where naming the row costs a walk.
function rowlessRecord(t: i32, rep: i32): boolean {
  return t >= 0 && repNodeAt(rep) is RRecord && structIndexOfTy(t) < 0
}

// The struct row legacy stores value `ix` in (`structIndexOfExpr`), or -1.
function storeRowOf(ix: i32): i32 {
  const row = structIndexOfExpr(ix, ibFnIx)
  return if row >= 0 && row < sTyIx.length { row } else { -1 }
}

// Storage row type `rowTy` where a value of record type `t` at rep `rep`, a type no struct row
// records, is held at that row's rep; else -1. A value and a place each name the row they store it in.
function rowlessStoredTy(t: i32, rep: i32, rowTy: i32): i32 {
  if !rowlessRecord(t, rep) || rowTy < 0 || irTyOpen(rowTy) { return -1 }
  const rr = repNodeOfTy(rowTy)
  return if rr != rep && repNodeAt(rr) is RRecord { rowTy } else { -1 }
}

// Whether the ref-list row legacy lays list `arr` out on (`refListSlotOfExpr`) holds its elements
// at rep `e`: the row a built list is held at (`listRowRep`), so its element reads there.
function listRowElemIs(arr: i32, e: i32): boolean {
  const slot = refListSlotOfExpr(unwrapParen(arr), ibFnIx)
  const et = if slot >= 0 { rlElemTyIxAt(slot) } else { -1 }
  return et >= 0 && !irTyOpen(et) && repNodeOfTy(et) == e
}

// Whether a value of type `t` (any type at all) is held at record rep `rep`: the rep alone decides.
function builtRecord(t: i32, rep: i32): boolean {
  return t >= 0 && repNodeAt(rep) is RRecord
}

// The type of storage row `row` where a built value of record type `t` at rep `rep` is held at
// that row's rep, another record; else -1. A row open only where it stores closed counts.
function builtStoredTy(t: i32, rep: i32, row: i32): i32 {
  const rowTy = if row >= 0 { sTyIx[row] } else { -1 }
  if !builtRecord(t, rep) || rowTy < 0 || !rowTyBuildsAt(rowTy, row) {
    return -1
  }
  const rr = repNodeOfTy(rowTy)
  return if rr != rep && repNodeAt(rr) is RRecord { rowTy } else { -1 }
}

// Type `ty`, or for a reference's nullable niche its record's type, read off the niche's rep.
function recordPartTy(ty: i32): i32 {
  if ty < 0 { return ty }
  const r = repNodeOfTy(ty)
  const n = repNodeAt(r)
  return if n is RNullable && refNullable(r) { repTyOf(n.rnInner) } else { ty }
}

// Whether struct row `row`'s recorded type `rt` closes at its rep: closed, or open only in function
// fields of a tagged set the row stores as the set's i32 id (`structRowFieldStoresAtom`), directly
// or in a nested record field's own row (`sFieldTgtStructIdx`).
function rowTyBuildsAt(rt: i32, row: i32): boolean {
  return rowTyBuildsAtGo(rt, row, [])
}

// `rowTyBuildsAt` below the rows `seen` on the path; a row met again answers no.
function rowTyBuildsAtGo(rt: i32, row: i32, seen: i32[]): boolean {
  if !irTyOpen(rt) { return true }
  const rr = repNodeOfTy(rt)
  if row < 0 || irTyHeldOpen(rt, rr) || !(repNodeAt(rr) is RRecord) {
    return false
  }
  for r in seen {
    if r == row { return false }
  }
  // The type holds a tagged set as its id where a row may still store it as a closure, so each
  // open field asks the row's own storage.
  seen.push(row)
  for name in repRecordFieldNames(rr) {
    const ft = recFieldTyOf(rt, name)
    if irTyOpen(ft) && !openFieldStoredAsIds(ft, row, name, seen) {
      return false
    }
  }
  return true
}

// Whether open field `name` of type `ft` in struct row `row` is stored closed: a tagged set, which
// the rep tree reps as its i32 id, stored as plain i32, or a nested record whose own row stores
// its open parts so.
function openFieldStoredAsIds(
  ft: i32,
  row: i32,
  name: string,
  seen: i32[],
): boolean {
  if tyDenotesFunc(ft) {
    return repPrim(repNodeOfTy(ft)) == "i32"
      && structRowFieldStoresAtom(row, name) == 1
  }
  if !(repNodeAt(repNodeOfTy(ft)) is RRecord) { return false }
  const fi = sFieldIndex(row, name)
  return fi >= 0 && rowTyBuildsAtGo(ft, sFieldTgtStructIdx(row, fi), seen)
}

// `objLit` at type `ty`, or, where `at` is not -1, built at the row its destination builds it at:
// variant row `at` (`variant`, as `emitVariantStruct` builds it) or struct row `at`.
function objLitAt(
  b: i32[],
  ix: i32,
  rep: i32,
  ty: i32,
  at: i32,
  variant: boolean,
): Opnd {
  const arm: ObjLitArm = if at < 0 { objLitArmOf(ix, ibFnIx) } else if variant { "variant" } else { "struct" }
  if arm == "unionBox" { return irBMiss("object " + arm) }
  const plainRow = if at >= 0 && variant { objLitVariantLayoutAt(ix, at) } else if at >= 0 { objLitLayoutRowAt(ix, at) } else if arm == "struct" { objLitLayoutRowOf(ix, ibFnIx) } else { objLitVariantLayoutOf(ix, ibFnIx) }
  // Else legacy's order stash: each field in source order into a scratch local, then the layout.
  const stashRow0 = if plainRow >= 0 { -1 } else if at >= 0 && variant { objLitVariantStashAt(ix, at) } else if at >= 0 { objLitStashRowAt(ix, at) } else if arm == "struct" { objLitStashRowOf(ix, ibFnIx) } else { objLitVariantStashOf(ix, ibFnIx) }
  // A struct literal whose row drops a field takes legacy's stash too: each initialiser in source
  // order, a dropped one evaluated for its effect alone (D1696).
  const dropRow = dropStashRowOf(ix, at, arm, plainRow >= 0 || stashRow0 >= 0)
  const stashRow = if stashRow0 >= 0 { stashRow0 } else { dropRow }
  // A struct literal that omits fields is built at its row with each omitted field's null, as
  // `emitObj` builds it, where no field's source order is observable.
  const omitRow = if plainRow >= 0 || stashRow >= 0 { -1 } else if arm == "struct" { objLitOmitRow(ix, at) } else { objLitVariantOmitAt(
    ix,
    if at >= 0 { at } else { objLitBuildVariantRow(ix, ibFnIx) },
  ) }
  const row = if plainRow >= 0 { plainRow } else if stashRow >= 0 { stashRow } else { omitRow }
  if row < 0 { return irBMiss("object layout") }
  const start = if arm == "struct" { sFieldStart[row] } else { uFieldStart[row] }
  const cnt = if arm == "struct" { sFieldCount[row] } else { uFieldCount[row] }
  if !(repNodeAt(rep) is RRecord) || repNodeOfTy(ty) != rep {
    return irBMiss("object rep")
  }
  const ks = repNodeKids(rep)
  if ks.length != cnt { return irBMiss("object field count") }
  const fields: Opnd[] = []
  const layout: i32[] = []
  const src: i32[] = []
  const none: Opnd = { ov: -1 }
  for _k in ks {
    fields.push(none)
    layout.push(-1)
  }
  const pairs = if dropRow >= 0 { objFieldSrcPairs(ix, sFieldNames, start, cnt) } else { [] }
  const order = if dropRow >= 0 { pairSlots(pairs) } else if stashRow >= 0 { objFieldSrcOrder(ix, sFieldNames, start, cnt) } else { iotaOf(cnt) }
  if order.length != cnt { return irBMiss("object stash order") }
  let pp = 0
  // Each field built so far: its value, layout position, kid, node and where its build ended.
  const vals: Opnd[] = []
  const fis: i32[] = []
  const kids: i32[] = []
  const valIxs: i32[] = []
  const ends: i32[] = []
  const starts: i32[] = []
  // Under the drop stash every field is set into its slot as built, around the dropped ones.
  let set = dropRow >= 0
  let oi = 0
  while oi < cnt {
    if dropRow >= 0 {
      pp = droppedInits(b, pairs, pp)
      if ibMiss != "" { return irBMiss(ibMiss) }
      pp = pp + 2
    }
    const fi = order[oi]
    if fi < 0 || fi >= cnt { return irBMiss("object stash order") }
    const name = sFieldNames[start + fi]
    const k = repRecordKidOf(rep, ty, name)
    if k < 0 || k >= ks.length { return irBMiss("object field kid") }
    // A variant's omitted field is the `null` its check minted, built as written (`emitVariantStruct`).
    const given = objFieldVal(ix, name)
    const valIx = if given < 0 && omitRow >= 0 && arm == "variant" { omittedFieldNullNode(ix, name) } else { given }
    if valIx < 0 && omitRow >= 0 && arm == "struct" {
      const nul = irBLetTempTy(
        b,
        { fnRow: row, fnFi: fi },
        ix,
        ks[k],
        fieldSiteTy(arm, row, fi),
      )
      if ibMiss != "" { return nul }
      fields[k] = nul
      layout[fi] = k
      oi = oi + 1
      continue
    }
    const why = fieldPlainWhy(arm, row, fi, valIx, ks[k])
    // A fresh `Map()` at another rep than its row's is legacy's own refusal, raised here alike.
    if why == "object field mapClash" && emitSoftFail {
      emitFailAt(
        "emitProgram: a record field holds a fresh `Map()` whose values store functions at one rep while the record's row stores them at another, so the two map types differ; building it at one rep is not done yet",
        valIx,
      )
    }
    if why != "" { return irBMiss(why) }
    const mark = b.length
    starts.push(mark)
    const own = fieldExplicitNullOwn(arm, row, fi, valIx)
    const typed = own < 0 && fieldExplicitNullTyped(arm, row, fi, valIx)
    // A variant's omitted sentinel field is its field's own null, as legacy's `emitVariantStruct`
    // writes the minted `null` at the field.
    const omitOwn = if given < 0 && own < 0 && arm == "variant" { nullOwnOfRep(ks[k]) } else { -1 }
    const omitNul = omitOwn >= 0 && nullOwnRepFits(omitOwn, ks[k])
    const v0 = if omitNul { repTemp(b, { nuAt: valIx, nuOwn: omitOwn, nuRead: [] }, valIx, ks[k]) } else if own >= 0 { repTemp(b, { nuAt: valIx, nuOwn: own, nuRead: [] }, valIx, ks[k]) } else if typed { fieldNullTemp(b, row, fi, valIx, ks[k]) } else { deliver(b, valIx, ks[k], fieldSiteTy(arm, row, fi)) }
    if ibMiss != "" { return v0 }
    // A value built at its own rep, into a field the row holds as that rep's nullable (a record
    // built at a wider row, D16957), is widened to it.
    const v1 = if nullableOver(ks[k], irBOpRep(v0)) && heldAsBox(ks[k]) { boxTemp(b, v0, valIx, ks[k]) } else { v0 }
    if ibMiss != "" { return v1 }
    const vr = irBOpRep(v1)
    // A closure value at a field whose closure rep leaves a part open, or fills one, is the same
    // closure struct, retagged.
    const holed = vr != ks[k]
      && holeRetagNoted(vr, ks[k], true)
      && exprPrePathWhy(valIx, ibFnIx) == ""
    // A closure at a field legacy writes plainly whose kid names another signature: the row's heap
    // types its closure kid from another row, and the struct holds any closure.
    const clo = vr != ks[k]
      && !holed
      && own < 0
      && !typed
      && repNodeAt(vr) is RClosure
      && repNodeAt(ks[k]) is RClosure
      && exprPrePathWhy(valIx, ibFnIx) == ""
      && recHeapNoted(rep)
    // …and so is one at a field that holds such a closure or `null` (`cloNicheTakes`).
    const nicheClo = !holed
      && !clo
      && own < 0
      && !typed
      && cloNicheTakes(v1, ks[k], valIx)
      && recHeapNoted(rep)
    // A record or list the field holds as it stands, apart in no hole, is retagged too.
    const stands = vr != ks[k]
      && !holed
      && !clo
      && !nicheClo
      && retagsAsStands(vr, ks[k], valIx)
    // A sub-word field (`repSubWord`) takes a plain i32, which the struct's field truncates.
    const packed = repSubWord(ks[k]) && repPrim(vr) == "i32"
    if (
      vr != ks[k]
      && !holed
      && !clo
      && !stands
      && !nicheClo
      && !packed
      && !openRepTakes(fieldSiteTy(arm, row, fi), ks[k], vr)
    ) {
      return irBMiss("object field coercion")
    }
    const v = if nicheClo { cloNicheRetag(b, v1, ks[k], valIx) } else if holed || clo || stands { repTemp(b, { rgV: v1 }, valIx, ks[k]) } else { v1 }
    if ibMiss != "" { return v }
    if clo { irCloFieldRetagNote(ib, b[b.length - 1]) }
    layout[fi] = k
    if stashRow >= 0 { src.push(k) }
    // Under the order stash a later field's valued `if` sets every field into its slot as legacy
    // writes it, the earlier ones at their own ends, so the `if` lands after their sets.
    if stashRow >= 0 && !set && oi > 0 && writesInPlaceFrom(b, mark) {
      set = true
      let j = 0
      while j < oi {
        const one: i32[] = []
        irBNode(
          one,
          { efRhs: stashSetOf(vals[j], ix, at, arm, fis[j], kids[j]) },
          -1,
          ibNoValue,
          valIxs[j],
        )
        insertAt(b, ends[j] + j, one[0])
        j = j + 1
      }
    }
    if set {
      irBNode(
        b,
        { efRhs: stashSetOf(v, ix, at, arm, fi, k) },
        -1,
        ibNoValue,
        valIx,
      )
    } else if oi > 0 && omitRow < 0 && stashRow < 0 {
      // An earlier field is staged below a later one's valued `if`, as an earlier argument is.
      if !irBStageLeads(b, mark, starts, vals, valIxs) {
        return irBMiss("short-circuit field after another")
      }
      let j = 0
      while j < vals.length {
        fields[kids[j]] = vals[j]
        j = j + 1
      }
    } else if (
      oi > 0
      && stashRow < 0
      && valuedIfFrom(b, mark)
      && !inPlaceFrom(b, mark)
    ) {
      // Off the stash, each earlier field is staged below this one's valued `if`, as an earlier
      // argument is.
      if !irBStageLeads(b, mark, starts, vals, valIxs) {
        return irBMiss("staged field")
      }
      let j = 0
      while j < vals.length {
        fields[kids[j]] = vals[j]
        j = j + 1
      }
    } else if (
      oi > 0
      && ifBelowLead(b, mark, "short-circuit field after another")
    ) {
      return v
    }
    fields[k] = v
    starts.push(mark)
    vals.push(v)
    fis.push(fi)
    kids.push(k)
    valIxs.push(valIx)
    ends.push(b.length)
    oi = oi + 1
  }
  if dropRow >= 0 {
    droppedInits(b, pairs, pp)
    if ibMiss != "" { return irBMiss(ibMiss) }
  }
  const rhs: Rhs = {
    mrFields: if set { [] } else { fields },
    mrLayout: layout,
    mrSrc: src,
    mrAt: ix,
    mrRow: at,
    mrVariant: arm == "variant",
    mrBuiltRow: row,
    mrSet: set,
  }
  if at < 0 && repNodeOfTy(exprTyOf(ix)) == rep {
    return builtAtRow(irBLetTemp(b, rhs, ix, rep), arm, row)
  }
  // Built at a destination's row, or at the storage row of a type no row records
  // (`rowlessRecordTy`), the record is that row's type, not the literal's own. A type open only in
  // parts held as ids (a tagged function set's i32) is closed at its rep.
  if irTyHeldOpen(ty, rep) { return irBMiss("open temp type") }
  const t = irVarNew(ib, rep, ty, "temp", -1)
  irBNode(b, { lDst: t, lRhs: rhs }, ty, rep, ix)
  const o: Opnd = { ov: t }
  return builtAtRow(o, arm, row)
}

// Record temp `o` of a struct literal built at struct row `row` (`arm` "struct"), noted at that heap.
function builtAtRow(o: Opnd, arm: ObjLitArm, row: i32): Opnd {
  if ibMiss == "" && arm == "struct" && o is OVar {
    irVarHeapNote(ib, o.ov, row)
  }
  return o
}

// The row literal `ix` (arm `arm`, destination row `at` or -1) is built at through legacy's drop
// stash, or -1 where `taken` (a layout or order-stash row already holds it).
function dropStashRowOf(ix: i32, at: i32, arm: ObjLitArm, taken: boolean): i32 {
  if taken { return -1 }
  if arm == "struct" {
    return objLitDropStashRowAt(
      ix,
      if at >= 0 { at } else { structIndexOfObjCtx(ix, ibFnIx) },
    )
  }
  const vi = if at >= 0 { at } else { objLitBuildVariantRow(ix, ibFnIx) }
  return if arm == "variant" { objLitVariantDropStashAt(ix, vi, ibFnIx) } else { -1 }
}

// The layout slots of `objFieldSrcPairs`'s pairs, in source order, the dropped ones left out.
function pairSlots(pairs: i32[]): i32[] {
  const out: i32[] = []
  let i = 0
  while i + 1 < pairs.length {
    if pairs[i] >= 0 { out.push(pairs[i]) }
    i = i + 2
  }
  return out
}

// From pair `pp` on, each dropped initialiser before the next kept one, evaluated and dropped as
// legacy's stash writes it; the index of that kept pair, or the end.
function droppedInits(b: i32[], pairs: i32[], from: i32): i32 {
  let pp = from
  while pp + 1 < pairs.length && pairs[pp] < 0 {
    const dv = irBExpr(b, pairs[pp + 1])
    if ibMiss != "" { return pp }
    irBNode(b, { dpV: dv }, -1, ibNoValue, pairs[pp + 1])
    pp = pp + 2
  }
  return pp
}

// The struct row a literal omitting fields is built at (its destination's row `at`, else its own),
// or -1: one with every given field a field of the row and no source order observable.
function objLitOmitRow(ix: i32, at: i32): i32 {
  const si = if at >= 0 { at } else { structIndexOfObjCtx(ix, ibFnIx) }
  if si < 0 || si >= sFieldCount.length || objLitStashes(ix, si) { return -1 }
  return si
}

// Field `fi` (kid `k`) of the order-stashed literal at `ix`, built at row `at`, set from `v`.
function stashSetOf(
  v: Opnd,
  ix: i32,
  at: i32,
  arm: ObjLitArm,
  fi: i32,
  k: i32,
): Rhs {
  const r: Rhs = {
    ssV: v,
    ssAt: ix,
    ssRow: at,
    ssVariant: arm == "variant",
    ssFi: fi,
    ssK: k,
  }
  return r
}

// Whether operands built into `b` from `at` on hold a valued `if` or a boxed `??`, which legacy
// writes in place.
function writesInPlaceFrom(b: i32[], at: i32): boolean {
  let i = at
  while i < b.length {
    const n = ib.irNodes[b[i]]
    if n is SIf && n.siOut >= 0 || n is SCoalBox || n is SArmSite {
      return true
    }
    i = i + 1
  }
  return false
}

// The struct field arms whose write is the value delivered at the field's rep: `plain`, the
// widenings (`emitWidened`, `widenPlanOf`), the box (`emitUnionBoxOwed`, the hole box plan) and a
// nullable record's value where `emitArmDelivery` owes no unbox (`fieldPlainWhy` checks that).
function fieldArmDelivers(fa: StructFieldArm): boolean {
  return fa == "plain"
    || fa == "f64"
    || fa == "i64"
    || fa == "f32"
    || fa == "union"
    || fa == "armDelivery"
    || fa == "strAtom"
}

// Whether the literal's field rep `dst` is the slot arm `fa` writes: the row a literal is built at
// may be its destination's, whose field boxes or widens where the literal's own type does not.
function fieldArmRepFits(fa: StructFieldArm, dst: i32): boolean {
  return match fa {
    "union" => repNodeAt(dst) is RBox || boxedNullable(dst)
    "f64" => repPrim(dst) == "f64"
    "i64" => repPrim(dst) == "i64"
    "f32" => repPrim(dst) == "f32"
    // The remaining arms write no conversion the IR delivers; `fieldArmDelivers` refuses them.
    "plain" | "mapClash" | "holder" | "noKind" | "nested" | "cloArray" | "lambda" | "explicitNull" | "refSlot" | "nulStrAtom" | "strAtom" | "nulnone" | "armDelivery" => true
  }
}

// Whether variant field arm `va` is the value delivered at the literal's field rep `dst`: `plain`,
// a widening into a slot of its width, or the box (`emitVariantFieldBox`, the hole box plan) into
// a box slot.
function variantArmFits(va: VariantFieldArm, dst: i32): boolean {
  return match va {
    "plain" => true
    "box" => repNodeAt(dst) is RBox || boxedNullable(dst)
    "f64" => repPrim(dst) == "f64"
    "i64" => repPrim(dst) == "i64"
    "f32" => repPrim(dst) == "f32"
    "noKind" | "lambda" | "nulnone" | "strAtom" => false
  }
}

// Why field `fi` of literal row `row` at arm `arm` is not written as its value alone, or "".
function fieldPlainWhy(
  arm: ObjLitArm,
  row: i32,
  fi: i32,
  valIx: i32,
  dst: i32,
): string {
  if arm == "variant" {
    const va = variantFieldArmOf(row, fi, valIx, ibFnIx)
    if va == "nulnone" {
      return nulNoneFieldWhy("object variant field nulnone", valIx, dst)
    }
    if !variantArmFits(va, dst) { return "object variant field " + va }
    // A box goes in as the deliver fence lets it: a recorded box first, else legacy's plan.
    if (
      va == "box"
      && exprUnion(valIx, ibFnIx)
      && boxIntoOtherUnion(valIx, dst, fieldSiteTy(arm, row, fi))
    ) {
      return "object variant field box from a box"
    }
    return ""
  }
  const fa = structFieldArmOf(row, fi, valIx, ibFnIx, false)
  if fa == "explicitNull" {
    const own = fieldNullOwnOf(row, fi)
    if own < 0 {
      // A typed reference's or nullable map's null is its heap's `ref.null`, `emitOmittedFieldNull`'s
      // own write.
      if fieldTypedNullWrites(row, fi) && repNodeAt(dst) is RNullable {
        return ""
      }
      return "object field explicitNull typed null"
    }
    if !nullOwnRepFits(own, dst) { return "object field explicitNull rep" }
    return ""
  }
  if fa == "nulnone" {
    return nulNoneFieldWhy("object field nulnone", valIx, dst)
  }
  if !fieldArmDelivers(fa) { return "object field " + fa }
  // A union of records stored at the field's record heap is cast there by `deliver` (D16321).
  if (
    fa == "armDelivery"
    && narrowedArmNeedsUnbox(valIx, ibFnIx)
    && !recordArmsUnboxOwed(valIx, dst)
  ) {
    return "object field arm unbox"
  }
  if !fieldArmRepFits(fa, dst) { return "object field row rep" }
  // A box goes in as the deliver fence lets it: a recorded box first, else legacy's plan.
  if (
    fa == "union"
    && exprUnion(valIx, ibFnIx)
    && boxIntoOtherUnion(valIx, dst, fieldSiteTy(arm, row, fi))
  ) {
    return "object field box from a box"
  }
  if nulNicheRecoverOwed(sFieldStoreKind(row, fi), valIx, ibFnIx) {
    return "object field recovery"
  }
  return ""
}

// The null struct field `fi` of row `row` takes for its explicit `null` value `valIx`, as
// legacy's `emitOmittedFieldNull` writes it (`fieldNullOwnOf`), or -1 where the field takes a value.
function fieldExplicitNullOwn(
  arm: ObjLitArm,
  row: i32,
  fi: i32,
  valIx: i32,
): i32 {
  if arm == "variant" {
    const va = variantFieldArmOf(row, fi, valIx, ibFnIx)
    return if va == "nulnone" && nulNoneWritesNothing(valIx) { NULL_OWN_NONE } else { -1 }
  }
  const fa = structFieldArmOf(row, fi, valIx, ibFnIx, false)
  if fa == "nulnone" && nulNoneWritesNothing(valIx) { return NULL_OWN_NONE }
  if fa != "explicitNull" { return -1 }
  return fieldNullOwnOf(row, fi)
}

// Why a `null` unit field's value `valIx` is not its slot's null alone (`emitNulNoneForEffect`
// writes nothing for it), or "": a value that runs for effect stays `why`.
function nulNoneFieldWhy(why: string, valIx: i32, dst: i32): string {
  if !nulNoneWritesNothing(valIx) { return why }
  if !nullOwnRepFits(NULL_OWN_NONE, dst) { return why + " rep" }
  return ""
}

// Whether struct field `fi` of row `row` takes its explicit `null` value `valIx` as its typed
// reference's or nullable map's null (`fieldTypedNullWrites`).
function fieldExplicitNullTyped(
  arm: ObjLitArm,
  row: i32,
  fi: i32,
  valIx: i32,
): boolean {
  if arm != "struct" { return false }
  if structFieldArmOf(row, fi, valIx, ibFnIx, false) != "explicitNull" {
    return false
  }
  return fieldNullOwnOf(row, fi) < 0 && fieldTypedNullWrites(row, fi)
}

// The null legacy's `nullread` arm writes for identifier read `ix` at its destination
// (`nullReadDstOwnOf`); NULL_READ_STORED where its storage read is that null; else -1. A shared
// cell's read respelling such a name takes its destination's null the same way.
const NULL_READ_STORED = 0 - 2
function nullReadOwnAt(ix: i32): i32 {
  const sl = unwrapParen(ix)
  if sl < 0 || sl >= P.nodes.length { return -1 }
  const n = nodeAt(sl)
  if n is Index && idxCellReadIsNull(sl, ibFnIx) {
    return nullReadDstOwnOf(sl, ibFnIx)
  }
  if !(n is Ident) || !identReadsNull(sl, ibFnIx) { return -1 }
  if exprPrePathWhy(ix, ibFnIx) != "" { return -1 }
  const own = nullReadDstOwnOf(sl, ibFnIx)
  return if own >= 0 { own } else { NULL_READ_STORED }
}

// The null a sentinel nullable rep `dst` holds, a boolean's or an atom's (`nullOwnRepFits`); -1 for
// any other rep, whose null the field's delivery writes.
function nullOwnOfRep(dst: i32): i32 {
  if boolNullable(dst) { return NULL_OWN_BOOL }
  if atomNullable(dst) { return NULL_OWN_ATOM }
  return -1
}

// Whether rep `dst` holds the null `own` (`NULL_OWN_*`) names, as the verifier's `RNullOf` rule
// reads it: a union box, a `K | null`, a `boolean | null`, a `string | null`, a nullable ref, or
// the `null` unit, whose one value is the bottom ref.
function nullOwnRepFits(own: i32, dst: i32): boolean {
  if own == NULL_OWN_BOX { return repNodeAt(dst) is RBox || boxedNullable(dst) }
  if own == NULL_OWN_ATOM { return atomNullable(dst) }
  if own == NULL_OWN_BOOL { return boolNullable(dst) }
  if own == NULL_OWN_STR { return strNullable(dst) }
  return own == NULL_OWN_NONE && (refNullable(dst) || repPrim(dst) == "null")
}

// A narrowed receiver's test at its storage (D2447), as legacy's `emitIs` decides it in storage
// mode, where its read is the declared box: a plain variant row's tag or the arm-tag test, over the
// raw slot of a local box, or the empty-list fit and the null instance's constant, all asked and
// built at the storage.
function storedBoxTest(b: i32[], n: IsExpr, ix: i32, rep: i32): Opnd {
  if rep != ibBool { return irBMiss("is result rep") }
  const mark = storageReadEnter(n.isObj)
  let arm: IsArm = if n.isFit < 0 && isRecvStageRep(ix, ibFnIx) < 0 { isArmOf(ix, ibFnIx, 0, false) } else { "notIs" }
  // An empty-list fit that declines passes to the next rung, as `emitIsTestRungs` takes it.
  while arm == "emptyFit" && emptyFitDeclines(emptyFitPlanOf(ix, ibFnIx), ix) {
    arm = isArmOf(ix, ibFnIx, isArmRank(arm) + 1, false)
  }
  if arm == "emptyFit" || arm == "nullInst" {
    const o = if arm == "nullInst" { isNullInstTest(ix, rep) } else { isEmptyFit(b, n, ix, rep, emptyFitPlanOf(ix, ibFnIx)) }
    storageReadLeave(mark)
    return o
  }
  const ta: TagIsArm = if arm == "armTag" { tagIsArmOf(ix, n, ibFnIx) } else { "none" }
  const vi = if arm == "variant" { isVariantTagPlain(ix, ibFnIx) } else { -1 }
  const memTa = ta == "memStruct" || ta == "memVariant" || ta == "memNarrow"
  const tag = if ta == "identBox" || ta == "box" || memTa { isArmTagOf(ix, n, ibFnIx) } else if vi >= 0 && vi < uTags.length { uTags[vi] } else { -1 }
  storageReadLeave(mark)
  // Any other rung is the ordinary one, its receiver read at the storage legacy marks.
  if arm != "armTag" && arm != "variant" {
    if arm == "notIs" { return irBMiss("is storage rung") }
    const om = storageReadEnter(n.isObj)
    const o = isRung(b, n, ix, rep, arm)
    storageReadLeave(om)
    return o
  }
  if arm == "variant" && tag < 0 { return irBMiss("is variant shape") }
  if ta == "tagAbsent" { return isTagAbsentTest(rep) }
  if ta == "boxLitSet" {
    const lm = storageReadEnter(n.isObj)
    const lo = isLitArmsTest(b, n, ix, rep, "boxLits")
    storageReadLeave(lm)
    return lo
  }
  if ta == "lacks" || ta == "box" && tag >= 0 {
    // A name's or an element's read at its storage is the declared box.
    const rn = nodeAt(unwrapParen(n.isObj))
    if !(rn is Ident || rn is Index) {
      return irBMiss("is stored box receiver")
    }
    return storedValueTagTest(b, n, ix, rep, ta, tag)
  }
  // A local record's box field at its storage is the field read raw (`storedMemberBoxTest`); a
  // global's read unboxes its narrowed field, legacy's arm does not.
  if memTa && tag >= 0 {
    const mr = nodeAt(unwrapParen(n.isObj))
    if (
      !(mr is Member)
      || ibFnIx < 0
      || localIndexOf(ibFnIx, unwrapParen(mr.memObj)) < 0
    ) {
      return irBMiss("is stored member receiver")
    }
    return storedMemberBoxTest(b, n, ix, rep, tag)
  }
  if arm == "armTag" && (ta != "identBox" || tag < 0) {
    return irBMiss("is arm tag " + ta)
  }
  const r = unwrapParen(n.isObj)
  if r >= 0 && r < P.nodes.length && nodeAt(r) is Member {
    return storedMemberBoxTest(b, n, ix, rep, tag)
  }
  const v = rawBoxVar(r)
  // A module global's box is its cell read raw, as legacy's storage read pushes it.
  if v < 0 && globalBoxSymOf(identDeclOf(r), r) >= 0 {
    const gv = irBBoxLocal(b, r)
    if ibMiss != "" { return gv }
    return irBLetTemp(b, { teV: gv, teTag: tag }, ix, rep)
  }
  const cb = if v < 0 { capturedBoxRaw(b, r) } else { null }
  if ibMiss != "" { return irBMiss(ibMiss) }
  if cb != null { return irBLetTemp(b, { teV: cb, teTag: tag }, ix, rep) }
  if v < 0 { return irBMiss("is box not a local") }
  const o: Opnd = { ov: v }
  return irBLetTemp(b, { teV: o, teTag: tag }, ix, rep)
}

// A captured union box `r` read raw past its narrowing: a lifted function's own parameter, or its
// environment's field at the box's rep; null where `r` is no captured box.
function capturedBoxRaw(b: i32[], r: i32): Opnd | null {
  const n = nodeAt(r)
  if !(n is Ident) || ibFnIx < 0 || captureSlotOf(n.identName, ibFnIx) < 0 {
    return null
  }
  const fe = fnStmtsPosOf(ibFnIx)
  const cr = capRepFor(fe, n.identName, -1)
  const ty = capTyOf(fe, n.identName)
  if !heldAsBox(cr) || ty < 0 || repNodeOfTy(ty) != cr { return null }
  if cloLifted(fe) {
    const lv = liftCapVar(fe, n.identName, -1)
    if lv < 0 || ib.irVars[lv].vRep != cr { return null }
    const o: Opnd = { ov: lv }
    return o
  }
  return irBLetTempTy(
    b,
    { evSlot: captureSlotOf(n.identName, ibFnIx), evAt: r },
    r,
    cr,
    ty,
  )
}

// A member receiver's test at its storage: the field read as the storage read, its declared box.
function storedMemberBoxTest(
  b: i32[],
  n: IsExpr,
  ix: i32,
  rep: i32,
  tag: i32,
): Opnd {
  const mark = storageReadEnter(n.isObj)
  const v = irBExpr(b, n.isObj)
  storageReadLeave(mark)
  if ibMiss != "" { return v }
  // The read is its storage's declared box, as legacy's storage read is.
  const st = readNarrowedStoreAt(n.isObj, ibFnIx)
  if (
    st < 0
    || !(repNodeAt(irBOpRep(v)) is RBox)
    || irBOpRep(v) != repNodeOfTy(st)
  ) {
    return irBMiss("is member storage rep")
  }
  return irBLetTemp(b, { teV: v, teTag: tag }, ix, rep)
}

// A box value's test at its storage, the receiver read under the storage mark as legacy reads it:
// its arm tag (`box`), or evaluated and dropped for a map the box cannot hold (`lacks`).
function storedValueTagTest(
  b: i32[],
  n: IsExpr,
  ix: i32,
  rep: i32,
  ta: TagIsArm,
  tag: i32,
): Opnd {
  const mark = storageReadEnter(n.isObj)
  const v = irBExpr(b, n.isObj)
  storageReadLeave(mark)
  if ibMiss != "" { return v }
  if ta == "lacks" { return isLacksTest(b, v, ix, rep) }
  if !(repNodeAt(irBOpRep(v)) is RBox) && !boxedNullable(irBOpRep(v)) {
    return irBMiss("is stored box rep " + repWhat(irBOpRep(v)))
  }
  return irBLetTemp(b, { teV: v, teTag: tag }, ix, rep)
}

// A map the box cannot hold: receiver `v` evaluated and dropped, then `false`, as legacy's
// `lacks` arm writes it.
function isLacksTest(b: i32[], v: Opnd, ix: i32, rep: i32): Opnd {
  irBNode(b, { dpV: v }, -1, ibNoValue, ix)
  const o: Opnd = { oiRep: rep, oiBits: 0 }
  return o
}

// The variable holding local box `r` (a binding, parameter or walk variable) in legacy's live
// slot, read raw past any narrowing, or -1. A `U | null` box is the same box, its `null` one more tag.
function rawBoxVar(r: i32): i32 {
  const d = identDeclOf(r)
  const w = localIndexOf(ibFnIx, r)
  if d < 0 || w < 0 || !(nodeAt(r) is Ident) { return -1 }
  const dn = nodeAt(d)
  if !(dn is LetDecl || dn is Param || dn is LoopVar) { return -1 }
  const v = if dn is Param { paramVarAt(w) } else if dn is LoopVar { ibDeclVar[d] ?? -1 } else { irBDeclVar(d) }
  if (v < 0 || ib.irVars[v].vSlot != w || !heldAsBox(ib.irVars[v].vRep)) {
    return -1
  }
  return v
}

// The tag box test `ix` compares at rung `arm`: variant row `vi`'s tag, or the pattern's arm tag
// at `tagIsArmOf`'s answer `ta`: a box value's, a record's box field's, or a local box's read raw
// (`identBox`). `tagAbsent` never reaches here: it is `isTagAbsentTest`'s.
function boxTestTagOf(
  n: IsExpr,
  ix: i32,
  arm: IsArm,
  ta: TagIsArm,
  vi: i32,
): i32 {
  if arm == "variant" {
    if vi < 0 || vi >= uTags.length {
      irBMiss("is variant shape")
      return 0
    }
    return uTags[vi]
  }
  // A box value's tag is read off the receiver's own value, as legacy's `box` arm reads it, and a
  // record's box field off the field read at its storage (`memStruct`).
  if (
    ta == "box"
    || ta == "memStruct"
    || ta == "memNarrow"
    || ta == "memVariant"
  ) {
    return isArmTagOf(ix, n, ibFnIx)
  }
  if ta != "identBox" {
    irBMiss("is arm tag " + ta)
    return 0
  }
  const r = unwrapParen(n.isObj)
  const rn = if r >= 0 && r < P.nodes.length { nodeAt(r) } else { null }
  const cap = rn is Ident && captureSlotOf(rn.identName, ibFnIx) >= 0
  if (
    localIndexOf(ibFnIx, r) < 0
    && globalBoxSymOf(identDeclOf(r), r) < 0
    && !cap
  ) {
    irBMiss("is box not a local")
    return 0
  }
  return isArmTagOf(ix, n, ibFnIx)
}

// Whether rep `r` is a literal-union atom's `K | null` (discipline 3): the id, or a sentinel.
function atomNullable(r: i32): boolean {
  const n = repNodeAt(r)
  return n is RNullable && n.rnDisc == 3
}

// Whether rep `r` holds a literal union's id, the `K | null` niche's bits: that niche, or `K` a
// narrowing read past its `-1` null.
function atomIdRep(r: i32): boolean {
  return atomNullable(r) || repNodeAt(r) is RAtom
}

// The atom whose id rep `r` holds (`atomIdRep`): `r` itself, or the member inside a `K | null`
// niche; -1 for any other rep.
function atomOfIdRep(r: i32): i32 {
  if !atomIdRep(r) { return -1 }
  return if atomNullable(r) { repOfNulInner(r) } else { r }
}

// Whether rep `r` is `string | null` (discipline 1): the string's ref, or a null ref.
function strNullable(r: i32): boolean {
  const n = repNodeAt(r)
  if !(n is RNullable) || n.rnDisc != 1 { return false }
  const p = repPrim(n.rnInner)
  return p != null && p == "str"
}

// Whether rep `r` is a record, list, map or closure or null (discipline 1): the reference, or a
// null reference of its type.
function refNullable(r: i32): boolean {
  const n = repNodeAt(r)
  if !(n is RNullable) || n.rnDisc != 1 { return false }
  const i = repNodeAt(n.rnInner)
  return i is RRecord || i is RList || i is RMap || i is RClosure
}

// Whether rep `r` is `boolean | null` (discipline 2): the i32 0 or 1, or the sentinel 2.
function boolNullable(r: i32): boolean {
  const n = repNodeAt(r)
  return n is RNullable && n.rnDisc == 2 && repPrim(n.rnInner) == "bool"
}

// Whether rep `r` is a nullable boxed as a union is (discipline 4): `{tag, payload}`.
export function boxedNullable(r: i32): boolean {
  const n = repNodeAt(r)
  return n is RNullable && n.rnDisc == 4
}

// Whether rep `r` is held as a union box: a box, or a boxed nullable.
export function heldAsBox(r: i32): boolean {
  return repNodeAt(r) is RBox || boxedNullable(r)
}

function refRepNone(_r: i32, _ty: i32): boolean { return false }

function indexUnset(_b: i32[], _ix: i32, _rep: i32): Opnd {
  return irBMiss("index hook not installed")
}

function armSiteUnset(_b: i32[], _ix: i32, _rep: i32): Opnd {
  return irBMiss("arm site hook not installed")
}

function memberUnset(_b: i32[], _ix: i32, _rep: i32): Opnd {
  return irBMiss("member hook not installed")
}

function openMemberNone(_ix: i32): i32 { return -1 }

function inPlaceNone(_ix: i32, _fnIx: i32): i32 { return 0 }

function unionEqNone(_ix: i32, _fnIx: i32): boolean { return false }

function listEqNone(_ix: i32, _fnIx: i32): boolean { return false }
function listCatNone(_ix: i32, _fnIx: i32): string { return "none" }

function strBinUnset(_b: i32[], _ix: i32, _rep: i32): Opnd {
  return irBMiss(STR_OPERAND)
}

// The list builder's hooks (`ir_build_ref.vl`), installed before emit; the defaults leave every
// reference rep, element read, member read, union compare (`unionUnionEqStagedOf`,
// `unionUnionEqArmOf`) and list compare (`listEqRouteOf`) outside the set.
export let irVarRepOkHook: (r: i32, ty: i32) => boolean = refRepNone
export let irIndexHook: (b: i32[], ix: i32, rep: i32) => Opnd = indexUnset
export let irMemberHook: (b: i32[], ix: i32, rep: i32) => Opnd = memberUnset
export let irArmSiteHook: (b: i32[], ix: i32, rep: i32) => Opnd = armSiteUnset
export let irOpenMemberRepHook: (ix: i32) => i32 = openMemberNone
export let irStrBinHook: (b: i32[], ix: i32, rep: i32) => Opnd = strBinUnset
export let irInPlaceHook: (ix: i32, fnIx: i32) => i32 = inPlaceNone
export let irUnionEqHook: (ix: i32, fnIx: i32) => boolean = unionEqNone
export let irListEqHook: (ix: i32, fnIx: i32) => boolean = listEqNone
export let irListCatHook: (ix: i32, fnIx: i32) => string = listCatNone

// The function being built, its declaration, and the rep a statement node carries.
export function irBFn(): IrFn { return ib }

export function irBFnIx(): i32 { return ibFnIx }

export function irBNoValue(): i32 { return ibNoValue }

// The string rep.
export function irBStrRep(): i32 { return repNodeOfTy(TY_STR) }

export function irBMiss(why: string): Opnd {
  if ibMiss == "" { ibMiss = why }
  const o: Opnd = { ov: -1 }
  return o
}

// `miss` for a statement, which yields nothing.
function skip(why: string): i32 {
  irBMiss(why)
  return 0
}

function missRhs(why: string): Rhs {
  irBMiss(why)
  const r: Rhs = { ggSym: -1, ggNonNull: false, ggNn: -1 }
  return r
}

export function irBNode(b: i32[], n: IrNode, ty: i32, rep: i32, at: i32) {
  b.push(irNodeNew(ib, n, ty, rep, at))
  // A claim's build ends at a node no claimed family holds: `claimable` would refuse it.
  if ibClaimBuild && !familyClaimed(irNodeFamily(n)) {
    irBMiss("unclaimed family")
  }
  return 0
}

// Builds `stmts` into a fresh body and returns it.
function bodyOf(stmts: i32[]): i32[] {
  const nb: i32[] = []
  stmtRun(nb, stmts)
  return nb
}

// The rep of node `ix`'s checked type in this instance when it is a primitive one, else -1.
function primRepOf(ix: i32): i32 { return primRepOfTy(nodeTyAt(ix, ibFnIx)) }

function primRepOfTy(t: i32): i32 {
  // The tree gives `void` an i32 leaf for the flat kinds; it is no value here.
  const r = repNodeOfTy(t)
  if isVoidTy(t) || !valueRep(r, t) { return -1 }
  return r
}

// `primRepOf` at `exprTyOf`'s type, a byte as an i32 (`byteHeld`).
function exprRepOf(ix: i32): i32 {
  const t = exprTyOf(ix)
  const r = primRepOfTy(t)
  if r >= 0 { return listRowRep(ix, rowlessRecordRep(ix, t, r)) }
  return primRepOfTy(byteHeld(t))
}

// Rep `r` of built record list `ix`, or the list of the ref-list row legacy lays it out on where
// that row's record element is not `r`'s (`listRowTyOf`).
function listRowRep(ix: i32, r: i32): i32 {
  const lt = listRowTyOf(ix, r)
  if lt < 0 { return r }
  return repNodeOfTy(lt)
}

// The list type of the ref-list row legacy lays built record list `ix` out on
// (`refListSlotOfExpr`), where `ix` is at rep `r` whose record element is not that row's: a kept
// maker's records, built at the row they are adopted at; else -1. A read of a place holds the
// place's rep.
function listRowTyOf(ix: i32, r: i32): i32 {
  const l = repNodeAt(r)
  if !(l is RList) || !(repNodeAt(l.rlsElem) is RRecord) { return -1 }
  const nd = nodeAt(unwrapParen(ix))
  if nd is Ident || nd is Member { return -1 }
  const slot = refListSlotOfExpr(unwrapParen(ix), ibFnIx)
  const et = if slot >= 0 { rlElemTyIxAt(slot) } else { -1 }
  if et < 0 || irTyOpen(et) { return -1 }
  const lt = listTyOfElem(et)
  const ln = repNodeAt(repNodeOfTy(lt))
  if (
    !(ln is RList)
    || ln.rlsElem == l.rlsElem
    || !(repNodeAt(ln.rlsElem) is RRecord)
  ) {
    return -1
  }
  return lt
}

// Rep `r` of built value `ix` at record type `t`, or the rep of the row legacy stores it in
// (`structIndexOfExpr`): a value's rep follows its storage. A place keeps its own.
function rowlessRecordRep(ix: i32, t: i32, r: i32): i32 {
  if !builtRecord(t, r) { return r }
  // A read of a place holds the place's rep, which the place decides (`rowlessLetTy`).
  const nd = nodeAt(unwrapParen(ix))
  if nd is Ident || nd is Member { return r }
  const rt = builtStoredTy(t, r, storeRowOf(ix))
  if rt < 0 { return r }
  // An element read moves only off a list laid out at that row (`listRowRep`).
  if (
    structIndexOfTy(t) >= 0
    && nd is Index
    && !listRowElemIs(nd.idxArr, repNodeOfTy(rt))
  ) {
    return r
  }
  return repNodeOfTy(rt)
}

// The type of `??` `ix` along the `mapIndexGetOr` arm: its map's value, the default filling a
// miss so it holds no `null`; -1 for any other node.
function openCoalMapTy(ix: i32): i32 {
  const n = nodeAt(ix)
  if (
    !(n is BinExpr)
    || n.binOp != "??"
    || coalArmOf(n, ix, ibFnIx) != "mapIndexGetOr"
  ) {
    return -1
  }
  const lr = nodeAt(unwrapParen(n.binLeft))
  if !(lr is Index) { return -1 }
  const mt = tyMapValOf(mapRecvTyIn(lr.idxArr, ibFnIx))
  if mt < 0 { return -1 }
  const inner = recoveredReadTyOf(mt)
  return if inner >= 0 { inner } else { mt }
}

// The type of `??` link `ix` the chain re-association minted, its chain's (`coalLinkChainOf`); of a
// minted link's `holeMap` null test, the link's (`ibLinkIfTy`); -1 for any other node.
function chainLinkTy(ix: i32): i32 {
  const n = nodeAt(ix)
  if n is BinExpr && n.binOp == "??" {
    const ch = coalLinkChainOf(ix)
    return if ch >= 0 { exprTyOf(ch) } else { -1 }
  }
  return ibLinkIfTy[ix] ?? -1
}

// The type every arm of un-narrowed union field read `m` stores its literal-union atom at
// (`sharedFieldPlanLitTy`), where that type reps as an atom; -1 otherwise.
function sharedFieldAtomTy(m: Member, ix: i32): i32 {
  const vis: i32[] = []
  const fis: i32[] = []
  if sharedUnionFieldPlan(m.memObj, m.memProp, ix, ibFnIx, vis, fis) != FC_I32 {
    return -1
  }
  const st = sharedFieldPlanLitTy(vis, fis)
  if st < 0 { return -1 }
  // A lone literal arm type reps as a string; the alias registered at its texts is the atom set.
  const at = if repNodeAt(repNodeOfTy(st)) is RAtom { st } else { litAliasTyOrSelf(st) }
  return if at >= 0 && repNodeAt(repNodeOfTy(at)) is RAtom { at } else { -1 }
}

// Whether field read `ix` is of a narrowed variant row's plain field, not a union box's.
function strRowField(ix: i32): boolean {
  return narrowedFieldPlain(ix, ibFnIx) >= 0
    && !narrowedFieldIsUnionBox(ix, ibFnIx)
}

// The atom type `let` `d` holds when its initializer is a shared union field read every arm
// stores as an atom (`sharedFieldAtomTy`), else -1.
function letSharedFieldAtomTy(d: i32): i32 {
  const l = nodeAt(d)
  if !(l is LetDecl) || l.letInit < 0 { return -1 }
  const iv = unwrapParen(l.letInit)
  if iv < 0 || iv >= P.nodes.length { return -1 }
  const m = nodeAt(iv)
  return if m is Member { sharedFieldAtomTy(m, iv) } else { -1 }
}

// The rep of `openCoalMapTy`'s type, or -1.
function openCoalMapRep(ix: i32): i32 {
  const t = openCoalMapTy(ix)
  return if t >= 0 { repNodeOfTy(t) } else { -1 }
}

// The rep of arithmetic operator `ix` at legacy's width (`binNumWidth`), or -1 for any other node.
function openBinRep(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = nodeAt(ix)
  if (
    !(n is BinExpr)
    || binIsCompare(n.binOp)
    || binPrimOp(n.binOp, false) == null
  ) {
    return -1
  }
  const t = repElemTyOfName(binNumWidth(n, ibFnIx))
  return if t >= 0 { repNodeOfTy(t) } else { -1 }
}

// Miss `miss` at node `ix` whose type has no rep; the shadow's detail mode adds a row naming the
// node's kind and the function, and leaves the class itself unchanged.
function repMissAt(ix: i32, miss: string): Opnd {
  if ibDetail {
    count("detail " + miss + " of " + irAstKind(ix) + " in " + ib.irName)
  }
  return irBMiss(miss)
}

// Call `n` at `ix`, whose own type has no rep, at its callee's result rep: a direct call of a
// declaration that returns; any other call misses as the rep it lacks.
function openCallValue(b: i32[], n: Call, ix: i32): Opnd {
  const miss = "rep " + repWhat(repNodeOfTy(nodeTyAt(ix, ibFnIx)))
  if (
    mapNewCall(n)
    || arrNewCallNamed(n, ibFnIx)
    || tplStrHoleOf(n, ibFnIx) >= 0
  ) {
    return repMissAt(ix, miss)
  }
  const rhs = callRhs(b, n, ix)
  if ibMiss != "" { return irBMiss("call") }
  if !(rhs is RCall) || rhs.caNever { return repMissAt(ix, miss) }
  const si = irSigOf(ib, rhs.caCallee)
  const r = if si >= 0 { ib.irSigRet[si] } else { -1 }
  if r < 0 || repIsNoValue(r) { return repMissAt(ix, miss) }
  return irBLetTempTy(b, rhs, ix, r, repTyOf(r))
}

// The rep of the type legacy builds array literal `ix` at (`arrLitBuiltTyOf`), or -1.
function openArrLitRep(ix: i32): i32 {
  const bt = arrLitBuiltTyOf(ix, ibFnIx)
  if bt >= 0 && !irTyOpen(bt) && valueRep(repNodeOfTy(bt), bt) {
    return repNodeOfTy(bt)
  }
  // An open built type is the scalar list its builder arm writes (`arrLitArmOf`).
  const arm = arrLitArmOf(ix, ibFnIx, arrLitListBuild(ix, ibFnIx))
  const scalar = arm == "i32"
    || arm == "i64"
    || arm == "f32"
    || arm == "f64"
    || arm == "str"
  const en = if arm == "str" { "string" } else { arm }
  const lt = if scalar { repElemTyOfName(en + "[]") } else { -1 }
  return if lt >= 0 { repNodeOfTy(lt) } else { -1 }
}

// The rep of the variable read `ix` reads, when `ix` reads this frame's parameter, a `let` the
// build holds or a capture, and its own type has no rep; -1 otherwise.
export function irBOpenLocalReadRep(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const id = nodeAt(ix)
  if !(id is Ident) { return -1 }
  // A capture is at the kind legacy stores it at (`captureValKind`), read through `repDescTy`.
  if captureSlotOf(id.identName, ibFnIx) >= 0 {
    const fe = fnStmtsPosOf(ibFnIx)
    const ct = repDescTy(
      repDescRet(
        captureValKind(fe, id.identName),
        captureValStructIdx(fe, id.identName),
        "",
      ),
    )
    return if ct >= 0 { repNodeOfTy(ct) } else { -1 }
  }
  const d = identDeclOf(ix)
  if d < 0 || d >= P.nodes.length { return -1 }
  const dn = nodeAt(d)
  const w = if dn is Param { localIndexOf(ibFnIx, ix) } else { -1 }
  const v = if w >= 0 { paramVarAt(w) } else if dn is LetDecl { ibDeclVar[d] ?? -1 } else { -1 }
  // A global's read is at its cell's rep (`globalRep`), as its initializer noted or its type gives.
  if v < 0 && dn is LetDecl && localIndexOf(ibFnIx, ix) < 0 {
    const g = globalIndexOfSid(sidOfNode(ix))
    const gr = if g >= 0 { globalRep(g, d) } else { -1 }
    return if gr >= 0 && valueRep(gr, -1) { gr } else { -1 }
  }
  if v < 0 || v >= ib.irVars.length { return -1 }
  const r = ib.irVars[v].vRep
  return if valueRep(r, ib.irVars[v].vTy) { r } else { -1 }
}

// The type field read `n` is built at where its receiver is a call, a field or a name the IR builds
// at a closed record type (`exprTyOf`): that field's kid type in it, or -1.
function builtFieldTy(n: Member): i32 {
  const o = unwrapParen(n.memObj)
  if (
    o < 0
    || !(nodeAt(o) is Call || nodeAt(o) is Member || nodeAt(o) is Ident)
  ) {
    return -1
  }
  const rt = exprTyOf(o)
  if rt < 0 || irTyOpen(rt) { return -1 }
  const r = repNodeOfTy(rt)
  if !(repNodeAt(r) is RRecord) { return -1 }
  const k = repRecordKidOf(r, rt, n.memProp)
  const ft = if k >= 0 { repTyOf(repNodeKids(r)[k]) } else { -1 }
  return if ft >= 0 && !irTyOpen(ft) { ft } else { -1 }
}

// The record type a module binding read `ix` is held at where its cell is a closed record
// (`globalRep`, at legacy's storage row), or -1: the module twin of `storedVarOf`.
function globalCellRecordTy(ix: i32): i32 {
  if ix < 0 || !(nodeAt(ix) is Ident) { return -1 }
  const d = identDeclOf(ix)
  if d < 0 || !(nodeAt(d) is LetDecl) || boundVarOf(ix) >= 0 { return -1 }
  const g = globalIndexOfSid(sidOfNode(ix))
  if g < 0 { return -1 }
  const cr = globalRep(g, d)
  if cr < 0 || !(repNodeAt(cr) is RRecord) { return -1 }
  const ct = repTyOf(cr)
  return if ct >= 0 && !irTyOpen(ct) { ct } else { -1 }
}

// `ix`'s type: its callee's result for an untyped call of a declaration (an operator a generic
// instance rewrote to its overload), else its recorded type.
export function exprTyOf(ix: i32): i32 {
  // An assignment's re-read of its target is of the value just stored, as legacy's `readTyHere`.
  const ra = asgReReadOf(ix)
  if ra >= 0 {
    const pt = asgReReadTy(ra, ibFnIx)
    if pt >= 0 { return pt }
  }
  // A read at its storage is of the type its storage holds, past its narrowing.
  if isStorageRead(ix) {
    const st = readNarrowedStoreAt(ix, ibFnIx)
    if st >= 0 { return st }
  }
  // A read of a binding holding a returned record whole is that record (`emitHolderRead`).
  const ht = holderReadTy(ix)
  if ht >= 0 { return ht }
  // A read of a parameter held at the row legacy declares it at reads that row.
  const pv = declRowParamVarOf(ix)
  if pv >= 0 { return ib.irVars[pv].vTy }
  const t = nodeTyAt(ix, ibFnIx)
  // A read typed open reads its binding's storage where the IR holds that variable closed.
  if t >= 0 && irTyOpen(t) {
    const sv = storedVarOf(ix, t)
    if sv >= 0 { return ib.irVars[sv].vTy }
    const gt = globalCellRecordTy(ix)
    if gt >= 0 { return gt }
  }
  if ix < 0 || ix >= P.nodes.length { return t }
  const n = nodeAt(ix)
  // A `??` link a chain's re-association minted, or its `holeMap` null test, is of its chain's type.
  if t < 0 && (n is BinExpr || n is IfStmt) {
    const lt = chainLinkTy(ix)
    if lt >= 0 { return lt }
  }
  // A field typed open of a receiver the IR builds closed is of that field's type there.
  if n is Member && irTyOpen(t) {
    const ft = builtFieldTy(n)
    if ft >= 0 { return ft }
  }
  // A field read legacy holds as an atom whose own type names no set (a shared union field
  // joined to one literal) is of the set its arms store (`litAtomMemberTy`).
  if n is Member && t >= 0 {
    const tr = repNodeOfTy(t)
    const atomTy = repNodeAt(tr) is RAtom
    // A lone literal is the one string type an atom field joins to; a plain string is never one.
    const loneLit = !atomTy
      && t != TY_STR
      && t != TY_NUL_STR
      && repPrim(tr) == "str"
    if loneLit && exprIsLitAtom(ix, ibFnIx) {
      const st = sharedFieldAtomTy(n, ix)
      if st >= 0 { return st }
    }
    // An atom-typed field a row stores as a string beside its base's arm is read as that string.
    if atomTy && strRowField(ix) && strReppedLitUnionAt(ix, ibFnIx) {
      return TY_STR
    }
  }
  // A direct call typed open, or typed at the closure its callee returns a bundle record for
  // (`fnRetHeldAsBundle`), is of its callee's result as the IR holds it (`resultTy`).
  if t >= 0 && !(n is Call && (irTyOpen(t) || bundleCallOf(n, ix, t))) {
    return t
  }
  if n is Call {
    if n.callFn < 0 || !(nodeAt(n.callFn) is Ident) { return t }
    const d = identDeclOf(n.callFn)
    const pos = fnIndexOfNode(n.callFn)
    if d < 0 || pos < 0 || pos >= fnStmts.length || !callTargetIs(pos, d) {
      return t
    }
    const fn = nodeAt(fnStmts[pos])
    // Where legacy picks a member of the bundle record after the call, the value is that member.
    if t < 0 || irTyOpen(t) {
      const pk = if elabHasRetRecords() || bundleAnyNoted() { bundleResultPickOf(ix, pos, ibFnIx) } else { noPick() }
      if pk.bpField >= 0 && pk.bpTy >= 0 && !irTyOpen(pk.bpTy) {
        return pk.bpTy
      }
    }
    if fn is FuncDecl { return resultTy(pos, fn.fnRet, fnStmts[pos]) }
  }
  // A capture cell's `c[0]` the rewrite left untyped (a store target, its spilled re-read, a
  // function-typed read) holds the cell's element (`cboxElemTyOfCell`).
  if t < 0 && n is Index {
    const rv = unwrapParen(n.idxArr)
    if rv >= 0 && cboxReadsCell(rv) {
      return cboxElemTyOfCell(nodeTyAt(rv, ibFnIx))
    }
  }
  // An untyped read of a binding in an instance body reads its storage: the type the IR holds
  // the binding's variable at.
  const v = boundVarOf(ix)
  if v >= 0 { return ib.irVars[v].vTy }
  return if t < 0 { capturedClosureTy(ix) } else { t }
}

// Whether direct call `n` (node `ix`), typed `t`, is the bundle record its callee returns at that
// type (`fnRetHeldAsBundle`), kept whole, so its value is the callee's `resultTy`.
function bundleCallOf(n: Call, ix: i32, t: i32): boolean {
  // A bundle result is a returned record or a handed-back bundle parameter: with neither noted
  // in this build, `fnBundleRetSigs` answers none.
  if !elabHasRetRecords() && !bundleAnyNoted() { return false }
  if n.callFn < 0 || !(nodeAt(n.callFn) is Ident) { return false }
  if !(repNodeAt(repNodeOfTy(t)) is RClosure) { return false }
  const pos = fnIndexOfNode(n.callFn)
  if pos < 0 || pos >= fnStmts.length || !fnRetHeldAsBundle(pos, t) {
    return false
  }
  // Where legacy picks a member after the call, the value is that member, at the call's type.
  const pk = bundleResultPickOf(ix, pos, ibFnIx)
  return pk.bpField < 0 && pk.bpHeap != -2
}

// Whether direct call `ix` of `callee` returns its bundle parameter's record where its value is
// used at none of the members (`bpHeap` -2); the builder declines it, so the program counts as a
// capability the IR cannot yet lower.
function bundlePickRefused(ix: i32, callee: i32): boolean {
  if !elabHasRetRecords() && !bundleAnyNoted() { return false }
  if bundleResultPickOf(ix, callee, ibFnIx).bpHeap != -2 { return false }
  return true
}

function noPick(): BundlePick {
  const none: BundlePick = { bpHeap: -1, bpField: -1, bpTy: -1, bpKey: "" }
  return none
}

// The type an untyped read `ix` of a captured hole-lambda binding is held at: its open type, at
// the uniform closure, where legacy's capture is a closure (`captureValKind`) and so is the
// binding's cell (`letBindRep`); -1 otherwise. The call through it is keyed by `callRefPlainKey`.
function capturedClosureTy(ix: i32): i32 {
  const n = nodeAt(ix)
  if !(n is Ident) { return -1 }
  const fe = fnStmtsPosOf(ibFnIx)
  if fe < 0 || captureSlotOf(n.identName, ibFnIx) < 0 { return -1 }
  if captureValKind(fe, n.identName) != "closure" { return -1 }
  const d = parentBindingOf(fe, n.identName)
  if d < 0 || !(nodeAt(d) is LetDecl) { return -1 }
  const pf = parentBindingFrameArenaOf(fe, n.identName)
  if !letBindRepClaims(d, pf) || letBindRep(d, pf).rdKind != "closure" {
    return -1
  }
  const ty = capTyOf(fe, n.identName)
  return if ty >= 0 && repNodeAt(repNodeOfTy(ty)) is RClosure { ty } else { -1 }
}

// The type local binding `d` holds a returned record whole at in `frame` (`holderRecordTy`): that
// record, or `| null` beside it where the binding's type holds null, as a map read's miss; else -1.
function holderHeldRecordTy(d: i32, frame: i32): i32 {
  const ht = holderRecordTy(d, frame)
  return if ht >= 0 && holderHoldsNull(d, frame) { nullableRecordTyOf(ht) } else { ht }
}

// The record type read `ix` of a holding binding is (`holderRecordTy`), where this frame's
// variable for it, or the module cell of a global one, holds that record; -1 otherwise.
function holderReadTy(ix: i32): i32 {
  if !elabHasHolderRecords() { return -1 }
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = nodeAt(ix)
  if !(n is Ident) { return -1 }
  // A holder captured whole is read at the record its capture holds (`capTyOf`).
  if identReadArmOf(n, ix, ibFnIx, false) == "capture" {
    return capturedHolderTy(n.identName)
  }
  const d = identDeclOf(ix)
  const ht = holderRecordTy(d, ibFnIx)
  if ht < 0 { return -1 }
  const v = boundVarOf(ix)
  // A local holding it beside `null` (`holderHeldRecordTy`) is read as it is until narrowed.
  const vt = if v >= 0 { ib.irVars[v].vTy } else { -1 }
  const vn = if v >= 0 { repNodeAt(ib.irVars[v].vRep) } else { null }
  if vt != ht && vn is RNullable && vn.rnInner == repNodeOfTy(ht) {
    return if holderReadPastNull(ix, ibFnIx) { ht } else { vt }
  }
  if v >= 0 { return if vt == ht { ht } else { -1 } }
  // A module holder's read is of the record its cell holds (`globalRep`).
  const g = globalIndexOfSid(sidOfNode(ix))
  if g < 0 { return -1 }
  const mt = holderRecordTy(d, -1)
  if mt < 0 { return -1 }
  const cr = globalRep(g, d)
  if cr == repNodeOfTy(mt) { return mt }
  // One beside `null` (cell kind `nulstruct`), read narrowed past it, is the record.
  const cn = repNodeAt(cr)
  const past = cn is RNullable
    && cn.rnInner == repNodeOfTy(mt)
    && holderReadPastNull(ix, ibFnIx)
  return if past { mt } else { -1 }
}

// The record a capture `name` of this frame holds where its binding keeps a returned bundle whole
// (`holderRecordTy` in the frame that owns it), else -1.
function capturedHolderTy(name: string): i32 {
  const fe = fnStmtsPosOf(ibFnIx)
  const d = parentBindingOf(fe, name)
  if d < 0 || !(nodeAt(d) is LetDecl) { return -1 }
  const ht = holderRecordTy(d, parentBindingFrameArenaOf(fe, name))
  return if ht >= 0 && capTyOf(fe, name) == ht { ht } else { -1 }
}

// `boundVarOf(ix)` for read `ix` of open type `t`, where the IR holds it closed and legacy stores
// it as `t`'s rep: a closure its cell holds (`cellTakesClosure`), or a list of closures its cell
// or its local's declared valtype holds (where legacy writes no valtype for `t`, that
// declaration alone); else -1.
function storedVarOf(ix: i32, t: i32): i32 {
  const v = boundVarOf(ix)
  if v < 0 || irTyOpen(ib.irVars[v].vTy) { return -1 }
  const d = identDeclOf(ix)
  if d < 0 || !(nodeAt(d) is LetDecl) { return -1 }
  const vr = ib.irVars[v].vRep
  if repNodeAt(vr) is RList {
    const tr = repNodeOfTy(t)
    if letBindRepClaims(d, ibFnIx) {
      return if repStoresAs(tr, vr) && letBindKindIs(d, "reflist") { v } else { -1 }
    }
    if !repStoresAs(tr, vr) {
      return if slotDeclStores(t, tr, vr, ib.irVars[v].vSlot) { v } else { -1 }
    }
    return if u8sSame(irSlotValtype(ib.irVars[v].vSlot), refRepValtype(vr)) { v } else { -1 }
  }
  return if letBindKindIs(d, "closure") { v } else { -1 }
}

// Whether legacy's cell for `let` `d` claims a rep of kind `k` (`letBindRep`).
function letBindKindIs(d: i32, k: VKind): boolean {
  return letBindRepClaims(d, ibFnIx) && letBindRep(d, ibFnIx).rdKind == k
}

// Whether local `slot`, as legacy declares it, holds variable rep `vr` where it is read or
// shared at open type `ty`'s rep `rep`, for which legacy declares no valtype.
function slotDeclStores(ty: i32, rep: i32, vr: i32, slot: i32): boolean {
  return undeclaredRepTakes(ty, rep, vr)
    && u8sSame(irSlotValtype(slot), refRepValtype(vr))
}

// The variable read `ix` is retyped to, its storage (`storedVarOf`), or -1.
export function storedReadOf(ix: i32): i32 {
  const t = nodeTyAt(ix, ibFnIx)
  return if t >= 0 && irTyOpen(t) { storedVarOf(ix, t) } else { -1 }
}

// The variable the IR built for the `let` or parameter read `ix` names, or -1.
function boundVarOf(ix: i32): i32 {
  const d = identDeclOf(ix)
  if d < 0 { return -1 }
  const dn = nodeAt(d)
  if !(dn is LetDecl) && !(dn is Param) { return -1 }
  if dn is Param { return paramVarAt(localIndexOf(ibFnIx, ix)) }
  const kv = ibDeclVar[d] ?? -1
  return if kv >= 0 { kv } else { slotVarOf(d) }
}

// The variable already holding declaration `d`'s wasm local in this frame, or -1.
function slotVarOf(d: i32): i32 {
  const s = declaredSlotOfDecl(d)
  return if s >= 0 { localVarAt(declaredIndexAt(ibFnIx, s)) } else { -1 }
}

// The variable a read of `let` `d` reads: where `d`'s own type is open, the one its instance's
// declaration already holds at that local, else `irBDeclVar`'s.
function readDeclVar(d: i32): i32 {
  if irTyOpen(heldTy(scopeTyAt(d, ibFnIx))) {
    const sv = slotVarOf(d)
    if sv >= 0 { return sv }
  }
  return irBDeclVar(d)
}

export function irBOpRep(o: Opnd): i32 {
  return match o {
    OVar => if o.ov >= 0 && o.ov < ib.irVars.length { ib.irVars[o.ov].vRep } else { -1 }
    OImm => o.oiRep
    OStr => o.osRep
  }
}

// Type `ty` as this function holds it: closed at its instance where the checker recorded one
// (`instTyOrSelf`), else as it is.
function heldTy(ty: i32): i32 {
  if !irTyOpen(ty) { return ty }
  const it = instTyOrSelf(ty, ibFnIx)
  return if irTyOpen(it) { ty } else { it }
}

// A `u8` value is the i32 legacy holds it in, since only a packed list's storage is a byte;
// any other type is itself.
function byteHeld(ty: i32): i32 {
  if tyScalarBasePrim(ty) != "u8" { return ty }
  return if repPrim(repNodeOfTy(ty)) == "u8" { TY_I32 } else { ty }
}

// Whether type `ty` at rep `rep` is open where this body is built: a start body is built once, so
// no instance changes the rep an open part is built at, so a typed one holds there.
function ibTyOpen(ty: i32, rep: i32): boolean {
  if ty >= 0 && rep >= 0 && irFnBuiltOnce(ib) { return false }
  return irTyHeldOpen(ty, rep)
}

// A fresh temp of `ix`'s type, defined by `rhs`.
export function irBLetTemp(b: i32[], rhs: Rhs, ix: i32, rep: i32): Opnd {
  return irBLetTempTy(b, rhs, ix, rep, heldTy(outTyOf(ix, rep)))
}

// `irBLetTemp` at type `ty`, where the value is built at another type than its node's.
export function irBLetTempTy(
  b: i32[],
  rhs: Rhs,
  ix: i32,
  rep: i32,
  ty0: i32,
): Opnd {
  // A byte value's temp holds the i32 it is built at (`byteHeld`).
  const ty1 = if repPrim(rep) == "i32" { byteHeld(ty0) } else { ty0 }
  // A scalar value typed at a still-open variable holds the scalar its rep names whatever instance
  // closes it, so it is typed at that rep's own type.
  const p = repPrim(rep)
  const scalar = p == "i32"
    || p == "i64"
    || p == "f32"
    || p == "f64"
    || p == "bool"
  const ty2 = if scalar && irTyHeldOpen(ty1, rep) && repTyOf(rep) >= 0 { repTyOf(rep) } else { ty1 }
  // A closure held at an open type's uniform closure rep is typed at that rep's own type, which
  // rule 1 takes as held (`closureHeld`), so its type and rep agree for rule 3.
  const crt = repTyOf(rep)
  const cloHeld = repNodeAt(rep) is RClosure
    && repNodeOfTy(ty2) != rep
    && crt >= 0
    && repNodeOfTy(crt) == rep
    && !irTyHeldOpen(crt, rep)
  const ty = if cloHeld { crt } else { ty2 }
  // A node typed at a still-open variable (a generic's result no call has instanced) has no type
  // the verifier can close, so its function stays legacy's.
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  // A closure read at an open type's rep (a field of a record built while a binding held a
  // generic) is not its closed type's closure rep, which rule 3 refuses.
  if (
    repNodeAt(rep) is RClosure
    && repNodeOfTy(ty) != rep
    && !irUntypedClosure(ty, rep)
  ) {
    return irBMiss("closure temp at an open type's rep")
  }
  const v = irVarNew(irBFn(), rep, ty, "temp", -1)
  irBNode(b, { lDst: v, lRhs: rhs }, ty, rep, ix)
  const o: Opnd = { ov: v }
  return o
}

// The box local, parameter, walk variable or module global Ident `ix` reads, at its own box rep
// whatever its narrowing, as `emitUnionBoxPush` pushes it.
export function irBBoxLocal(b: i32[], ix: i32): Opnd {
  const d = identDeclOf(ix)
  const w = localIndexOf(ibFnIx, ix)
  // A capture's box is its lifted parameter or its environment field (`capturedBoxRaw`).
  if w < 0 {
    const cb = capturedBoxRaw(b, ix)
    if ibMiss != "" { return irBMiss(ibMiss) }
    if cb != null { return cb }
  }
  if d >= 0 && w < 0 { return globalBoxRead(b, d, ix) }
  if d < 0 || w < 0 { return irBMiss("box receiver") }
  const dn = nodeAt(d)
  if !(dn is LetDecl || dn is Param || dn is LoopVar) {
    return irBMiss("box receiver")
  }
  const v = if dn is Param { paramVarAt(w) } else if dn is LoopVar { ibDeclVar[d] ?? -1 } else { irBDeclVar(d) }
  // A nullable union (discipline 4) is held in the same `{tag, payload}` box.
  if v < 0 || !heldAsBox(ib.irVars[v].vRep) { return irBMiss("box receiver") }
  const o: Opnd = { ov: v }
  return o
}

// Whether binding `d`'s variable `v`, of an open function type, takes closure `src` its
// initializer built at its instance's signature: legacy's cell holds a closure (`letBindRep`), so
// the variable is retyped to the closure built.
function cellTakesClosure(d: i32, v: i32, src: Opnd): boolean {
  const x = ib.irVars[v]
  if !irTyOpen(x.vTy) || !(repNodeAt(x.vRep) is RClosure) { return false }
  if !(repNodeAt(irBOpRep(src)) is RClosure) || !(src is OVar) || src.ov < 0 {
    return false
  }
  if !letBindRepClaims(d, ibFnIx) || letBindRep(d, ibFnIx).rdKind != "closure" {
    return false
  }
  const st = ib.irVars[src.ov].vTy
  if irTyOpen(st) { return false }
  x.vRep = irBOpRep(src)
  x.vTy = st
  return true
}

// The variable of local declaration `d` (a `LetDecl` or a `Param`), made on first use.
export function irBDeclVar(d: i32): i32 {
  const known = ibDeclVar[d] ?? -1
  if known >= 0 { return known }
  // Legacy holds a binding of a returned record whole as that record (`letCellKind`), `| null`
  // beside it where its type holds null (`holderHeldRecordTy`), and one holding a single member
  // of it as that member's closure (`holderMemberTy`).
  const ht = holderHeldRecordTy(d, ibFnIx)
  const hm = if ht < 0 && (elabHasRetRecords() || bundleAnyNoted()) { holderMemberTy(d, ibFnIx) } else { -1 }
  const ty0 = if ht >= 0 { ht } else if hm >= 0 && !irTyOpen(hm) { hm } else { heldTy(scopeTyAt(d, ibFnIx)) }
  // A map local is held as legacy stores it, its mv slot off its initializer (`mapSlotHeldTy`).
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
  const ty = if dn is LetDecl { mapSlotHeldTy(ty0, dn.letInit) } else { ty0 }
  const rep = repNodeOfTy(ty)
  if isVoidTy(ty) || !valueRep(rep, ty) {
    irBMiss("local rep " + repWhat(rep))
    return -1
  }
  if irTyHeldOpen(ty, rep) {
    irBMiss("open local type")
    return -1
  }
  // Legacy's cell for a binding it holds as the atom is the id, whatever its type's own rep.
  if (
    d >= 0
    && d < P.nodes.length
    && nodeAt(d) is LetDecl
    && letBindIsAtom(d, ibFnIx)
    && !(repNodeAt(rep) is RAtom || atomNullable(rep))
  ) {
    // Held at the type legacy's cell holds (`letAtomCellTy`), the literal set a join of consts keeps.
    const at0 = letAtomCellTy(d, ibFnIx)
    const r0 = if at0 >= 0 { repNodeOfTy(heldTy(at0)) } else { -1 }
    const atom0 = r0 >= 0 && (repNodeAt(r0) is RAtom || atomNullable(r0))
    const at = if atom0 { at0 } else { letSharedFieldAtomTy(d) }
    const ar = if at >= 0 { repNodeOfTy(heldTy(at)) } else { -1 }
    if ar >= 0 && (repNodeAt(ar) is RAtom || atomNullable(ar)) {
      return declVarAt(d, ar, heldTy(at))
    }
    irBMiss("atom cell local rep")
    return -1
  }
  const lt = declRowLetTy(d, rep)
  if lt >= 0 { return declVarAt(d, repNodeOfTy(lt), lt) }
  const rl = rowlessLetTy(d, ty, rep)
  if rl >= 0 { return declVarAt(d, repNodeOfTy(rl), rl) }
  if letLitUndeclaredRow(d) { ibDeclRowSeen = true }
  return declVarAt(d, rep, ty)
}

// The record type of the struct row legacy declares `let` `d`'s local at, where that row is not
// rep `rep` and the initializer reads a parameter held at that row (`declRowParamVarOf`); else -1.
function declRowLetTy(d: i32, rep: i32): i32 {
  if d < 0 || d >= P.nodes.length { return -1 }
  const n = nodeAt(d)
  if !(n is LetDecl) || n.letInit < 0 { return -1 }
  const pv = declRowParamVarOf(unwrapParen(n.letInit))
  if pv < 0 { return -1 }
  const s = declaredSlotOfDecl(d)
  const slot = if s >= 0 { declaredIndexAt(ibFnIx, s) } else { -1 }
  const lt = irSlotRowTy(slot)
  if lt < 0 || repNodeOfTy(lt) == rep { return -1 }
  return if repNodeOfTy(lt) == ib.irVars[pv].vRep { lt } else { -1 }
}

// Whether local `v`, declared at `d` and not yet used, takes its initializer's rep `built` as its
// storage row, the D14434 binding column's (`letBindTy`), as legacy's cell does; `v` is retyped.
function localStoredAt(v: i32, d: i32, built: i32): boolean {
  const bt = heldTy(letBindTy(d, ibFnIx))
  const st = if bt >= 0 && repNodeOfTy(bt) == built { bt } else { localSlotRecordTy(d, built) }
  if st < 0 { return false }
  ib.irVars[v].vRep = built
  ib.irVars[v].vTy = st
  ibDeclRowSeen = true
  return true
}

// The record type of the struct row legacy declares `let` `d`'s local at (`irSlotRowTy`), where
// its rep is record rep `built`; else -1.
function localSlotRecordTy(d: i32, built: i32): i32 {
  if !(repNodeAt(built) is RRecord) || d < 0 || !(nodeAt(d) is LetDecl) {
    return -1
  }
  const s = declaredSlotOfDecl(d)
  const rt = if s >= 0 { irSlotRowTy(declaredIndexAt(ibFnIx, s)) } else { -1 }
  return if rt >= 0 && !irTyOpen(rt) && repNodeOfTy(rt) == built { rt } else { -1 }
}

// Whether local `v`, declared at `d`, holds its storage row while read `ix` is typed at its
// binding (`localStoredAt`), or at a record type no row records (`rowlessLetTy`): the read takes
// the local as it is.
function localReadStored(v: i32, d: i32, rep: i32): boolean {
  if d < 0 || !(nodeAt(d) is LetDecl) { return false }
  const bt = heldTy(scopeTyAt(d, ibFnIx))
  if rep != repNodeOfTy(bt) { return false }
  return ib.irVars[v].vRep == repNodeOfTy(heldTy(letBindTy(d, ibFnIx)))
    || ib.irVars[v].vRep != rep
    && rowlessLetTy(d, bt, rep) == ib.irVars[v].vTy
}

// The record type of the struct row legacy declares `let` `d`'s local at, where its type `ty` (rep
// `rep`) is a record no struct row records; else -1.
function rowlessLetTy(d: i32, ty: i32, rep: i32): i32 {
  if (
    d < 0
    || d >= P.nodes.length
    || !(nodeAt(d) is LetDecl)
    || !rowlessRecord(ty, rep)
  ) {
    return -1
  }
  const s = declaredSlotOfDecl(d)
  const slot = if s >= 0 { declaredIndexAt(ibFnIx, s) } else { -1 }
  const st = rowlessStoredTy(ty, rep, irSlotRowTy(slot))
  if st >= 0 || !letIsArmCell(d) { return st }
  // An arm cell holds its rowless record at the variant row legacy's `emitVariantCoerce` builds.
  const vi = letArmCellRow(d, ibFnIx)
  return rowlessStoredTy(
    ty,
    rep,
    if vi >= 0 && vi < uVarTyIx.length { uVarTyIx[vi] } else { -1 },
  )
}

// Loop variable `d` read at `ix`: the walk's variable, or in a fragment the element's slot at the
// read's own rep and type, which `irSlotRunAgrees` then holds to legacy's cell.
function fragLoopVar(d: i32, ix: i32, rep: i32): i32 {
  const known = ibDeclVar[d] ?? -1
  if known >= 0 { return known }
  const ty = heldTy(exprTyOf(ix))
  if irTyHeldOpen(ty, rep) {
    irBMiss("open local type")
    return -1
  }
  return declVarAt(d, rep, ty)
}

// The variable of loop variable `d`, a walk's element at rep `rep` and type `ty`.
function irBLoopVar(d: i32, rep: i32, ty: i32): i32 {
  const known = ibDeclVar[d] ?? -1
  if known >= 0 { return known }
  return declVarAt(d, rep, ty)
}

// The local variable of declaration `d` at its declared slot, of rep `rep` and type `ty`.
function declVarAt(d: i32, rep: i32, ty: i32): i32 {
  const s = declaredSlotOfDecl(d)
  const slot = if s >= 0 { declaredIndexAt(ibFnIx, s) } else { -1 }
  // A declaration with no local of this frame (a capture lifted into a parameter) is legacy's.
  if slot < 0 {
    irBMiss("local slot")
    return -1
  }
  // One variable per wasm local: an instance's read resolves to the template's declaration.
  const held = localVarAt(slot)
  if held >= 0 {
    if (
      ib.irVars[held].vRep != rep
      && !openRepTakes(ty, rep, ib.irVars[held].vRep)
      && !slotDeclStores(ty, rep, ib.irVars[held].vRep, slot)
    ) {
      irBMiss("local slot shared across reps")
      return -1
    }
    ibDeclVar[d] = held
    return held
  }
  const v = irVarNew(ib, rep, ty, "local", slot)
  ibDeclVar[d] = v
  return v
}

// The local variable holding wasm local `w`, or -1.
function localVarAt(w: i32): i32 {
  if w < 0 { return -1 }
  return ib.irLocalAt[w] ?? -1
}

// Whether condition `condIx`, built onto `b` from length `at`, is the bare constant `is` legacy's
// `staticIsGuard` reads back: an immediate with nothing written before it.
function bareConstIs(c: Opnd, condIx: i32, b: i32[], at: i32): boolean {
  return c is OImm && b.length == at && condIsTest(condIx)
}

// Whether condition `ix` is an `is` test or its negation, the shapes `staticIsGuard` reads back.
function condIsTest(ix: i32): boolean {
  const c = nodeAt(unwrapParen(ix))
  if c is Unary {
    return c.unOp == "!" && nodeAt(unwrapParen(c.unArg)) is IsExpr
  }
  return c is IsExpr
}

// A value `if` on legacy's plain scalar path (`ifExprPlainWhy`): a slotless out each arm's one
// value writes, as `&&` and `||` build it. An `else` arm whose value is itself a value `if` is the
// next link, built along the spine rather than through `deliver` (D1990); the links' nodes and
// their outs' assigns then land innermost first, the order a recursion's returns give them.
function ifExpr(b: i32[], n0: IfStmt, ix0: i32, rep0: i32): Opnd {
  return ifExprAt(b, n0, ix0, rep0, -1)
}

// `ifExpr`, its first link built at type `ty0` where that is not -1: a destination's own, whose
// rep `rep0` each arm then delivers at. Such a link ends the chain.
function ifExprAt(b: i32[], n0: IfStmt, ix0: i32, rep0: i32, ty0: i32): Opnd {
  // A dense integer `match` at a scalar join is one `br_table` whose arms carry the value
  // (`emitIfExprAsLink`'s `emitIntSwitch` mode 2), where its plan has an `else`.
  if (
    ty0 < 0
    && ifExprShapeWhy(ix0, ibFnIx) == "int match"
    && ifExprSwitchMay(ix0)
    && valtypeOf(rep0) >= 0
    && valtypeOf(rep0) == ifExprJoinVt(ix0, ibFnIx)
  ) {
    const p = intSwitchPlanOf(ix0, ibFnIx)
    if p != null && p.ispElse >= 0 { return valuedSwitch(b, ix0, p, rep0) }
  }
  if ty0 < 0 && ifExprPlainWhy(ix0, ibFnIx) == "null join" {
    return nullJoinIf(b, n0, ix0, rep0)
  }
  const rj = ifRefJoinOf(ix0, ibFnIx)
  const rk = rj.rjKind
  if ty0 < 0 && rk != null && ifExprPlainWhy(ix0, ibFnIx) == "ref " + rk {
    return ifRefExpr(b, n0, ix0, rep0, rj)
  }
  if ty0 < 0 && ifExprPlainWhy(ix0, ibFnIx) == "union" {
    return unionIfExpr(b, n0, ix0, rep0)
  }
  // The head's rep is the one the join plan writes every link at, else the chain is legacy's.
  const hv = valtypeOf(rep0)
  if hv >= 0 && hv != ifExprJoinVt(ix0, ibFnIx) {
    return irBMiss("expression if join kind")
  }
  const bs: i32[][] = []
  const ixs: i32[] = []
  const reps: i32[] = []
  const conds: Opnd[] = []
  const tys: i32[] = []
  const outs: i32[] = []
  const thens: i32[][] = []
  const elses: i32[] = []
  let cb = b
  let n = n0
  let cix = ix0
  const crep = rep0
  let lastDk = -1
  while true {
    // A link built at a destination's type is `emitIfExprAs` at that type: its shape alone.
    const pw = if ty0 >= 0 { ifExprShapeWhy(cix, ibFnIx) } else { ifExprPlainWhy(cix, ibFnIx) }
    if pw != "" { return irBMiss("expression if " + pw) }
    const cat = cb.length
    const c = irBExpr(cb, n.ifCond)
    if ibMiss != "" || irBOpRep(c) != ibBool { return irBMiss("if condition") }
    // A constant `is` condition legacy decides off its bytes (`staticValueIfCond`): a `false`
    // writes its then arm dead, a `true` its block `else`.
    const dk = if c is OImm && bareConstIs(c, n.ifCond, cb, cat) { if c.oiBits != 0 { 1 } else { 0 } } else { -1 }
    // Every link is written at the head's kind (`emitIfExprAs` asks `ifJoinPlanOf` of the head
    // alone), so a link takes the head's rep and type, never its own; a head built at a
    // destination's type takes `ty0`.
    const ty = if cix != ix0 { tys[0] } else if ty0 >= 0 { ty0 } else { byteHeld(rowlessRecordTy(cix, nodeTyAt(cix, ibFnIx), crep)) }
    if irTyHeldOpen(ty, crep) { return irBMiss("open temp type") }
    const t = irVarNew(ib, crep, ty, "local", -1)
    let thenB: i32[] = []
    if dk == 0 {
      irBNode(thenB, { tpWhy: 0 }, -1, ibNoValue, n.ifThen)
    } else {
      thenB = ifArm(n.ifThen, t, crep)
    }
    if ibMiss != "" { return irBMiss("if arm") }
    lastDk = dk
    bs.push(cb)
    ixs.push(cix)
    reps.push(crep)
    conds.push(c)
    tys.push(ty)
    outs.push(t)
    thens.push(thenB)
    elses.push(n.ifElse)
    // The next link: a direct `else if`, or an `else` block whose one statement is an `if`. A
    // literal `true` decides a block `else` dead, so the chain ends there.
    const direct = n.ifElse >= 0
      && n.ifElse < P.nodes.length
      && nodeAt(n.ifElse) is IfStmt
    if n.ifElse < 0 || !direct && (valueIfLitTrue(n.ifCond) || dk == 1) {
      break
    }
    const tv = if direct { n.ifElse } else { ifArmValueExpr(n.ifElse) }
    if tv < 0 { break }
    const nx = nodeAt(tv)
    if !(nx is IfStmt) { break }
    // At a destination's type legacy walks only a direct `else if` as a link (`emitIfExprAs`); an
    // `else` block's `if` is that arm's value, not a link.
    if ty0 >= 0 && !direct { return irBMiss("atom if join chain") }
    // An `else` block's prelude runs before its `if`, which is then that arm's value, not a link.
    if !direct && armHasPrelude(n.ifElse) {
      return irBMiss("expression if else prelude")
    }
    // `irBExpr`'s own prelude for the link it would reach. At a destination's type legacy writes a
    // direct link itself (`emitIfExprAsLink`), never through `emitExpr`, so that link has none.
    const pre = if ty0 >= 0 && direct { "" } else { exprPrePathWhy(tv, ibFnIx) }
    // A link the atom hook writes as a join at the destination is that arm's value, not a link.
    if pre == "pre-path atom hook" && atomJoinHookAt(tv) { break }
    if pre != "" { return irBMiss(pre) }
    const eb: i32[] = []
    cb = eb
    n = nx
    cix = tv
  }
  let k = bs.length - 1
  // Legacy writes a dead `else` as `unreachable` (`emitDeadValueArm`), and a missing one as the
  // out's niche (`ifNoElseNicheOf`), a bare `null`'s there; a constant condition kills its then.
  let elseB: i32[] = []
  if elses[k] < 0 {
    if conds[k] is OImm { return irBMiss("expression if static condition") }
    const own = if ifNoElseNicheOf(ixs[k]) == 2 { NULL_OWN_BOOL } else { NULL_OWN_ATOM }
    const nv = repTemp(
      elseB,
      { nuAt: ixs[k], nuOwn: own, nuRead: [] },
      ixs[k],
      reps[k],
    )
    irBNode(elseB, { asDst: outs[k], asSrc: nv }, -1, ibNoValue, ixs[k])
  } else if valueIfLitTrue(n.ifCond) || lastDk == 1 {
    irBNode(elseB, { tpWhy: 0 }, -1, ibNoValue, elses[k])
  } else {
    elseB = ifArm(elses[k], outs[k], reps[k])
  }
  if ibMiss != "" { return irBMiss("if arm") }
  while k >= 0 {
    irBNode(
      bs[k],
      sIf(conds[k], thens[k], elseB, outs[k], true),
      tys[k],
      reps[k],
      ixs[k],
    )
    if k == 0 { break }
    // Link `k` is link `k - 1`'s `else` value, delivered at that link's rep as `ifArm` does.
    const inner: Opnd = { ov: outs[k] }
    const v = widenTo(bs[k], inner, ixs[k], reps[k - 1], -1)
    if ibMiss == "" && irBOpRep(v) != reps[k - 1] { irBMiss("if arm coercion") }
    if ibMiss == "" {
      irBNode(
        bs[k],
        { asDst: outs[k - 1], asSrc: v },
        -1,
        ibNoValue,
        elses[k - 1],
      )
    }
    if ibMiss != "" { return irBMiss("if arm") }
    elseB = bs[k]
    k = k - 1
  }
  const o: Opnd = { ov: outs[0] }
  return o
}

// Whether the atom hook writes `ix` as a join built at its destination (`emitIfExprAs`).
function atomJoinHookAt(ix: i32): boolean {
  const a = atomHookArmOf(ix, ibFnIx, false)
  return a == "litJoin" || a == "perArmJoin"
}

// A value `if` joined at a reference (legacy's `emitIfExprRef`): one link whose arms each write
// their value as itself (`refIfArmOf`'s `plain`) at the join's rep, under the blocktype the
// lowering asks `ifRefJoinOf` for. A chain's links share the head's kind (`refIfLink`).
function ifRefExpr(b: i32[], n: IfStmt, ix: i32, rep: i32, rj: RefJoin): Opnd {
  const kind = rj.rjKind ?? "struct"
  if (
    kind != "str"
    && kind != "list"
    && kind != "strlist"
    && kind != "reflist"
    && kind != "struct"
    && kind != "map"
    && kind != "variant"
    && kind != "closure"
    && kind != "f64list"
    && kind != "i64list"
    && kind != "f32list"
    && kind != "u8list"
  ) {
    return irBMiss("expression if ref " + kind)
  }
  if kind == "str" && strJoinDropsNulAtom(ix, ibFnIx) {
    return irBMiss("ref if drops null atom")
  }
  // A record join legacy writes at a row of another record (`ifTypedStructRow`, its destination's)
  // is built at that row's record, each arm delivered there.
  const sr = if kind == "struct" && rj.rjSlot >= 0 && rj.rjSlot < sTyIx.length { repNodeOfTy(sTyIx[rj.rjSlot]) } else { -1 }
  const atRow = sr >= 0
    && sr != rep
    && repNodeAt(sr) is RRecord
    && repNodeAt(rep) is RRecord
    && !irTyOpen(sTyIx[rj.rjSlot])
  const jr = if atRow { sr } else { rep }
  const ty = if atRow { sTyIx[rj.rjSlot] } else { rowlessRecordTy(ix, nodeTyAt(ix, ibFnIx), rep) }
  if irTyHeldOpen(ty, jr) { return irBMiss("open temp type") }
  // A record join whose narrowed arm names no row here (legacy reads it off the arm in its scope)
  // is built at its rep's own record row (D4645's spellings).
  if kind == "struct" && rj.rjSlot < 0 {
    const ut = repTyOf(rep)
    const us = if ut >= 0 && !irTyOpen(ut) { structIndexOfTy(ut) } else { -1 }
    if us < 0 || repNodeOfTy(ut) != rep { return irBMiss("if record join row") }
    return refIfLink(b, n, ix, rep, ut, kind, us, false)
  }
  return refIfLink(b, n, ix, jr, ty, kind, rj.rjSlot, false)
}

// A `null`-typed value `if`, as legacy's `emitAllNullIf` writes it: the `if` for its effects alone,
// then the destination's null (`emitNullAt`).
function nullJoinIf(b: i32[], n: IfStmt, ix: i32, rep: i32): Opnd {
  ifForEffect(b, n, ix)
  if ibMiss != "" { return irBMiss(ibMiss) }
  return nullUnitTemp(b, ix, rep, [])
}

// `emitIfForEffect`: the conditions as a void `if` chain, each arm's prelude and its `null`-typed
// value for effect (`nulNoneEffect`), an `else if` its next link.
function ifForEffect(b: i32[], n: IfStmt, ix: i32) {
  const c = irBExpr(b, n.ifCond)
  if ibMiss != "" || irBOpRep(c) != ibBool { return irBMiss("if condition") }
  const thenB = effectArm(n.ifThen)
  if ibMiss != "" { return 0 }
  const elseB: i32[] = []
  if n.ifElse >= 0 {
    const en = nodeAt(n.ifElse)
    if en is IfStmt {
      ifForEffect(elseB, en, n.ifElse)
    } else {
      for k in effectArm(n.ifElse) { elseB.push(k) }
    }
    if ibMiss != "" { return 0 }
  }
  irBNode(b, sIf(c, thenB, elseB, -1, n.ifElse >= 0), -1, ibNoValue, ix)
  return 0
}

// One arm of `ifForEffect`: its prelude, then its value for effect.
function effectArm(blockIx: i32): i32[] {
  const body: i32[] = []
  armPrelude(body, blockIx)
  if ibMiss != "" { return body }
  const tv = ifArmValueExpr(blockIx)
  if tv < 0 {
    irBMiss("null join arm value")
    return body
  }
  nulNoneEffect(body, tv, blockIx, null)
  return body
}

// A value `if` on the union join's rung, as legacy's `emitUnionIfValue` writes it: a chain of `if`s
// at the box's blocktype, each arm its value boxed into the join's union (`emitUnionBoxOwed` at
// `nodeTyInOf`), a missing `else` the null box.
function unionIfExpr(b: i32[], n: IfStmt, ix: i32, rep: i32): Opnd {
  if !heldAsBox(rep) { return irBMiss("union if rep") }
  const ty = nodeTyAt(ix, ibFnIx)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  return unionIfLink(b, n, ix, rep, ty, nodeTyInOf(ix, ibFnIx), false)
}

// An else-less value `if` delivered into union `uty`'s box at rep `rep` (`elseLessUnionIfWhy`):
// `emitUnionIfValue`'s one link, its arm boxed into `uty` and its `else` the null box.
function elseLessUnionIf(
  b: i32[],
  n: IfStmt,
  ix: i32,
  rep: i32,
  uty: i32,
): Opnd {
  const c = irBExpr(b, n.ifCond)
  if ibMiss != "" || irBOpRep(c) != ibBool { return irBMiss("if condition") }
  if c is OImm { return irBMiss("union if static condition") }
  if irTyOpen(uty) { return irBMiss("open temp type") }
  const t = irVarNew(ib, rep, uty, "local", -1)
  const thenB = unionIfArm(n.ifThen, t, rep, uty, false)
  if ibMiss != "" { return irBMiss(ibMiss) }
  const elseB: i32[] = []
  const nb = repTemp(
    elseB,
    { nuAt: ix, nuOwn: NULL_OWN_BOX, nuRead: [] },
    ix,
    rep,
  )
  irBNode(elseB, { asDst: t, asSrc: nb }, -1, ibNoValue, ix)
  if ibMiss != "" { return irBMiss(ibMiss) }
  irBNode(b, sIf(c, thenB, elseB, t, true), uty, rep, ix)
  const o: Opnd = { ov: t }
  return o
}

// One link of `unionIfExpr` (`emitUnionIfValueLink`): an `else if` is the next link, written into
// this link's `else` and delivered to its out.
function unionIfLink(
  b: i32[],
  n: IfStmt,
  ix: i32,
  rep: i32,
  ty: i32,
  uty: i32,
  atDst: boolean,
): Opnd {
  // Legacy writes every link at the head's box; the lowering opens a link at its own join, or,
  // written into a box destination (`atDst`, `unionIfAtDstWhy`), at that box whatever its join.
  const pw = ifExprPlainWhy(ix, ibFnIx)
  if !atDst && pw != "union" {
    return irBMiss(
      if pw == "" { "union if chain join" } else { "union if " + pw },
    )
  }
  const cat = b.length
  const c = irBExpr(b, n.ifCond)
  if ibMiss != "" || irBOpRep(c) != ibBool { return irBMiss("if condition") }
  // A constant condition is one legacy decides off its bytes and writes a dead arm for
  // (`staticValueIfCond`): a decided `is` kills its then when `false`, and it or a literal `true`
  // kills its block `else`. Any other constant is written as built, both arms live.
  const decided = bareConstIs(c, n.ifCond, b, cat) || valueIfLitTrue(n.ifCond)
  const dk = if c is OImm && n.ifElse >= 0 && decided { if c.oiBits != 0 { 1 } else { 0 } } else { -1 }
  const t = irVarNew(ib, rep, ty, "local", -1)
  let thenB: i32[] = []
  if dk == 0 {
    irBNode(thenB, { tpWhy: 0 }, -1, ibNoValue, n.ifThen)
  } else {
    thenB = unionIfArm(n.ifThen, t, rep, uty, atDst)
  }
  if ibMiss != "" { return irBMiss(ibMiss) }
  let elseB: i32[] = []
  if n.ifElse < 0 {
    const nb = repTemp(
      elseB,
      { nuAt: ix, nuOwn: NULL_OWN_BOX, nuRead: [] },
      ix,
      rep,
    )
    irBNode(elseB, { asDst: t, asSrc: nb }, -1, ibNoValue, ix)
  } else {
    const en = nodeAt(n.ifElse)
    if en is IfStmt && !ifJoinAdaptsScalar(n.ifElse, ibFnIx) {
      const inner = unionIfLink(elseB, en, n.ifElse, rep, ty, uty, atDst)
      if ibMiss != "" { return inner }
      irBNode(elseB, { asDst: t, asSrc: inner }, -1, ibNoValue, n.ifElse)
    } else if en is IfStmt {
      const x = floorDeliver(elseB, n.ifElse, rep, uty)
      if ibMiss != "" { return x }
      if irBOpRep(x) != rep { return irBMiss("union if arm rep") }
      irBNode(elseB, { asDst: t, asSrc: x }, -1, ibNoValue, n.ifElse)
    } else if dk == 1 {
      irBNode(elseB, { tpWhy: 0 }, -1, ibNoValue, n.ifElse)
    } else {
      elseB = unionIfArm(n.ifElse, t, rep, uty, atDst)
    }
  }
  if ibMiss != "" { return irBMiss(ibMiss) }
  const s = sIf(c, thenB, elseB, t, true)
  s.siAtDst = atDst
  irBNode(b, s, ty, rep, ix)
  const o: Opnd = { ov: t }
  return o
}

// Value `ix` delivered into box rep `dst` of union `uty`, as `emitUnionBoxOwed` writes it: one
// the checker records no box at is boxed at `uty` (the floor), a `null` literal as its null box.
function floorDeliver(b: i32[], ix: i32, dst: i32, uty: i32): Opnd {
  const owed = boxOwedAt(ix, ibFnIx)
  if !owed && nodeAt(unwrapParen(ix)) is NullLit {
    const nulV: Opnd = { oiRep: ibNoValue, oiBits: 0 }
    return boxTempIn(b, nulV, ix, dst, -1, uty)
  }
  const v = deliver(b, ix, dst, uty)
  if ibMiss == "" && !owed && irBOpRep(v) != dst {
    return boxTempIn(b, v, ix, dst, -1, uty)
  }
  return v
}

// One arm of `unionIfLink` (`emitUnionIfArm`): its prelude, then its tail value boxed into the
// join's union and written to out `t`. A tail that is itself a value `if` joins into this box as
// the next link, or, typed one wider number (`ifJoinAdaptsScalar`), is boxed once.
function unionIfArm(
  blockIx: i32,
  t: i32,
  rep: i32,
  uty: i32,
  atDst: boolean,
): i32[] {
  const body: i32[] = []
  const tv = ifArmValueExpr(blockIx)
  const tn = if tv >= 0 { nodeAt(unwrapParen(tv)) } else { null }
  const nested = tv >= 0 && !tailIsValueOrNever(tv, ibFnIx) && tn is IfStmt
  if (
    !(nodeAt(blockIx) is Block)
    || tv < 0
    || !tailIsValueOrNever(tv, ibFnIx) && !nested
  ) {
    irBMiss("union if arm")
    return body
  }
  armPrelude(body, blockIx)
  if ibMiss != "" { return body }
  if nested && tn is IfStmt && !ifJoinAdaptsScalar(unwrapParen(tv), ibFnIx) {
    const inner = unionIfLink(
      body,
      tn,
      unwrapParen(tv),
      rep,
      ib.irVars[t].vTy,
      uty,
      atDst,
    )
    if ibMiss == "" {
      irBNode(body, { asDst: t, asSrc: inner }, -1, ibNoValue, tv)
    }
    return body
  }
  // A call that never returns enters the box as itself (`emitUnionBoxOwed`): no box, no store.
  if callIsNever(unwrapParen(tv)) {
    stmtNode(body, tv, NO_SIBS, -1)
    if ibMiss == "" && !irBodyLeaves(ib, body) && !endsPath(body) {
      irBMiss("union if never arm")
    }
    return body
  }
  const x0 = floorDeliver(body, tv, rep, uty)
  // An arm the checker recorded no box for is boxed into the join's union here, as legacy's
  // `emitUnionIfValue` boxes each arm (`emitUnionBoxArg`).
  const x = if ibMiss == "" && irBOpRep(x0) != rep && heldAsBox(rep) && uty >= 0 { boxTempIn(body, x0, tv, rep, -1, uty) } else { x0 }
  if ibMiss == "" && irBOpRep(x) != rep { irBMiss("union if arm rep") }
  if ibMiss == "" {
    irBNode(body, { asDst: t, asSrc: x }, -1, ibNoValue, blockIx)
  }
  return body
}

// One link of a reference join's chain (`emitIfExprRefLink`), at the head's rep, type and join,
// which the link carries (`siJoin`) as legacy writes every link; an `else if` is the next link, in
// this link's `else`. The blocktype is nullable from the first link yielding `null` inward
// (`siJoinNul`), so an inner link that yields none still opens at the chain's nullable type.
function refIfLink(
  b: i32[],
  n: IfStmt,
  ix: i32,
  rep: i32,
  ty: i32,
  kind: VKind,
  slot: i32,
  nulAcc: boolean,
): Opnd {
  const own = ifLinkYieldsNull(ix, ibFnIx)
  const nul = nulAcc || own
  // Legacy tries a `br_table` on a link whose chain yields no null (`emitIfExprRefLink`); one whose
  // plan declines is the plain link.
  const sp = if !nul && intSwitchMayLower(ix) { intSwitchPlanOf(ix, ibFnIx) } else { null }
  if sp != null && sp.ispElse >= 0 { return irBMiss("ref if switch") }
  const cat = b.length
  const c = irBExpr(b, n.ifCond)
  if ibMiss != "" || irBOpRep(c) != ibBool { return irBMiss("if condition") }
  // A constant condition legacy decides off its bytes, writing a dead arm for it: a decided `is`
  // (`staticValueIfCond`) kills its then when `false`, its block `else` when `true`.
  if n.ifElse < 0 && c is OImm { return irBMiss("ref if static condition") }
  const dk = if c is OImm && bareConstIs(c, n.ifCond, b, cat) { if c.oiBits != 0 { 1 } else { 0 } } else { -1 }
  const t = irVarNew(ib, rep, ty, "local", -1)
  let thenB: i32[] = []
  if dk == 0 {
    irBNode(thenB, { tpWhy: 0 }, -1, ibNoValue, n.ifThen)
  } else {
    thenB = refIfArm(n.ifThen, t, rep, kind, slot, nul)
  }
  if ibMiss != "" { return irBMiss("ref if arm") }
  let elseB: i32[] = []
  // An else-less link's `else` is the join's own typed null (`emitIfExprRefLink`'s `noElse`).
  const en = if n.ifElse >= 0 { nodeAt(n.ifElse) } else { nodeAt(ix) }
  if n.ifElse < 0 {
    const z = repTemp(elseB, { jnKind: kind, jnSlot: slot }, ix, rep)
    irBNode(elseB, { asDst: t, asSrc: z }, -1, ibNoValue, ix)
  } else if en is IfStmt {
    const inner = refIfLink(elseB, en, n.ifElse, rep, ty, kind, slot, nul)
    if ibMiss != "" { return inner }
    irBNode(elseB, { asDst: t, asSrc: inner }, -1, ibNoValue, n.ifElse)
  } else if valueIfLitTrue(n.ifCond) || dk == 1 {
    // Legacy writes a dead `else` as `unreachable` (`emitDeadValueArm`).
    irBNode(elseB, { tpWhy: 0 }, -1, ibNoValue, n.ifElse)
  } else {
    elseB = refIfArm(n.ifElse, t, rep, kind, slot, nul)
  }
  if ibMiss != "" { return irBMiss("ref if arm") }
  irBNode(
    b,
    {
      siCond: c,
      siThen: thenB,
      siElse: elseB,
      siOut: t,
      siElseKw: true,
      siJoin: { rjKind: kind, rjSlot: slot },
      siJoinNul: nul,
      siAtDst: false,
    },
    ty,
    rep,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// Whether if-arm `blockIx` ends in an assignment whose value is a wider record written into a
// name (`asgValueArmOf` "widerRow").
function ifArmWiderWrite(blockIx: i32): boolean {
  const tv = unwrapParen(ifArmValueExpr(blockIx))
  if tv < 0 || tv >= P.nodes.length { return false }
  const n = nodeAt(tv)
  return n is BinExpr
    && n.binOp == "="
    && asgValueArmOf(tv, ibFnIx) == "widerRow"
}

// One arm of `ifRefExpr`: its value as itself at `rep`, an atom decoded to it, or the join's null,
// written to out `t`.
function refIfArm(
  blockIx: i32,
  t: i32,
  rep: i32,
  kind: VKind,
  slot: i32,
  nul: boolean,
): i32[] {
  const body: i32[] = []
  const arm0 = refIfArmOf(blockIx, ibFnIx, kind, slot, nul)
  // A wider record written into a name is a value (`assignValueWider`), which legacy's arm planner
  // reads as a statement and refuses: the IR builds it as the arm's plain value.
  const arm = if arm0 == "noValue" && ifArmWiderWrite(blockIx) { "plain" } else { arm0 }
  if arm != "plain" && arm != "atomStr" && arm != "null" && arm != "unbox" {
    irBMiss("ref if arm " + arm)
    return body
  }
  armPrelude(body, blockIx)
  if ibMiss != "" { return body }
  const tv = ifArmValueExpr(blockIx)
  // A call that never returns is the arm's statement: legacy writes it and no store into the out.
  if tv >= 0 && callIsNever(unwrapParen(tv)) {
    stmtNode(body, tv, NO_SIBS, -1)
    if ibMiss == "" && !irBodyLeaves(ib, body) { irBMiss("ref if never arm") }
    return body
  }
  // A bare `null` arm is the join's own typed null.
  if arm == "null" {
    const z = repTemp(body, { jnKind: kind, jnSlot: slot }, tv, rep)
    irBNode(body, { asDst: t, asSrc: z }, -1, ibNoValue, blockIx)
    return body
  }
  // A narrowed read of a union is its box, recovered at the join's record in the arm (D17026).
  if arm == "unbox" {
    const u = if armUnboxOwed(tv, rep) { armUnboxTemp(body, tv, rep, repTyOf(rep), false) } else if recordArmsUnboxOwed(tv, rep) { recordArmsUnboxTemp(body, tv, rep, repTyOf(rep)) } else { irBMiss("ref if arm unbox shape") }
    if ibMiss == "" && irBOpRep(u) != rep { irBMiss("ref if arm unbox rep") }
    if ibMiss == "" {
      irBNode(body, { asDst: t, asSrc: u }, -1, ibNoValue, blockIx)
    }
    return body
  }
  // An atom arm in a `string` join decodes to its member string (`emitAtomToStr`), from the atom
  // as its cell holds it.
  // A struct literal whose row is on the join's record heap is built as that record, as a binding's
  // or an argument's is (`objLitTwinTyAtRow`).
  const lt = if arm == "plain" && tv >= 0 { objLitTwinTyAtRow(tv, rep, -1, -1) } else { -1 }
  // A plain arm whose own rep is not the join's and no retag reaches it is delivered at the
  // join's rep, its widening, box or conversion written in the arm.
  const er = if arm == "plain" && lt < 0 && tv >= 0 { exprRepOf(tv) } else { -1 }
  const toJoin = er >= 0
    && er != rep
    && !holeRetagNoted(er, rep, true)
    && !repNullRefFits(er, rep)
  const built = if toJoin { deliver(body, tv, rep, repTyOf(rep)) } else if lt >= 0 { objLitAt(
    body,
    unwrapParen(tv),
    rep,
    lt,
    objLitLayoutRowOf(unwrapParen(tv), ibFnIx),
    false,
  ) } else { exprAt(body, tv, arm == "atomStr") }
  // An arm built at a closure rep the join's leaves open, or fills, is the same closure retagged.
  const holed = arm == "plain"
    && ibMiss == ""
    && irBOpRep(built) != rep
    && holeRetagNoted(irBOpRep(built), rep, true)
    && exprPrePathWhy(tv, ibFnIx) == ""
  // A `null`-typed arm is the bottom ref, which a nullable reference join holds as it stands.
  const bottom = arm == "plain"
    && ibMiss == ""
    && irBOpRep(built) != rep
    && repNullRefFits(irBOpRep(built), rep)
  const v = if arm == "atomStr" && ibMiss == "" { atomToStr(body, built, tv, rep) } else if ibMiss == "" && (holed || bottom || refIfArmNiches(built, tv, rep)) { repTemp(body, { rgV: built }, tv, rep) } else { built }
  if ibMiss == "" && irBOpRep(v) != rep { irBMiss("ref if arm rep") }
  if ibMiss == "" {
    irBNode(body, { asDst: t, asSrc: v }, -1, ibNoValue, blockIx)
  }
  return body
}

// Whether arm value `v` (node `tv`) is the non-null reference of a nullable join `rep`: legacy
// writes it as itself, the same reference, so the IR only retags it.
function refIfArmNiches(v: Opnd, tv: i32, rep: i32): boolean {
  const d = repNodeAt(rep)
  return d is RNullable
    && d.rnInner == irBOpRep(v)
    && (strNullable(rep) || refNullable(rep))
    && !boxOwedAt(tv, ibFnIx)
}

// A nullable or union binding's `if` initializer as legacy writes it per arm (`emitLetIfInit`, rep
// `pa`, a box's union `uty`): a box binding seeded with the null box, then a void `if` chain whose
// arms each deliver their value into `v` and whose missing `else` writes the cell's null.
function letIfArms(b: i32[], ifIx: i32, v: i32, pa: i32, uty: i32) {
  const vr = ib.irVars[v].vRep
  // `letIfInitRep`'s cells: a union box (a nullable one, discipline 4, the same `{tag, payload}`),
  // `string | null`, `boolean | null`. Only the box is not defaultable, so only it is seeded.
  const own = if pa == 0 { NULL_OWN_BOX } else if pa == 1 { NULL_OWN_STR } else { NULL_OWN_BOOL }
  const fits = if pa == 0 { heldAsBox(vr) } else if pa == 1 { strNullable(vr) } else { boolNullable(vr) }
  if !fits { return skip("declaration if per arm rep") }
  if pa == 0 { nullInto(b, ifIx, v, vr, own) }
  return letIfArmLink(b, ifIx, v, vr, own, uty)
}

// A union binding's `if` initializer under the binding sink (`emitUnionIfBindingSink`): a void
// `if` chain whose arms each put their box into the sink pair, a missing `else` the null, then the
// binding's one box built from the pair into `v`.
function letIfSinkArms(b: i32[], ifIx: i32, v: i32, uty: i32) {
  const vr = ib.irVars[v].vRep
  if !heldAsBox(vr) { return skip("declaration if per arm rep") }
  letIfSinkLink(b, ifIx, v, vr, uty)
  if ibMiss != "" { return 0 }
  irBNode(
    b,
    { srOp: "sink.close", srHeap: -1, srArgs: [], srImm: v },
    -1,
    ibNoValue,
    ifIx,
  )
  return 0
}

// One link of `letIfSinkArms` (`emitUnionIfBindingSinkLink`).
function letIfSinkLink(b: i32[], ifIx: i32, v: i32, vr: i32, uty: i32) {
  const n = nodeAt(unwrapParen(ifIx))
  if !(n is IfStmt) { return skip("declaration if per arm node") }
  const c = irBExpr(b, n.ifCond)
  if ibMiss != "" || irBOpRep(c) != ibBool { return skip("condition") }
  const thenB = letIfSinkBody(n.ifThen, v, vr, uty)
  if ibMiss != "" { return 0 }
  const elseB: i32[] = []
  if n.ifElse < 0 {
    irBNode(
      elseB,
      { srOp: "sink.null", srHeap: -1, srArgs: [], srImm: -1 },
      -1,
      ibNoValue,
      ifIx,
    )
  } else if nodeAt(n.ifElse) is IfStmt {
    if ifJoinAdaptsScalar(n.ifElse, ibFnIx) {
      return skip("declaration if per arm scalar link")
    }
    letIfSinkLink(elseB, n.ifElse, v, vr, uty)
  } else {
    for x in letIfSinkBody(n.ifElse, v, vr, uty) { elseB.push(x) }
  }
  if ibMiss != "" { return 0 }
  irBNode(b, sIf(c, thenB, elseB, -1, true), -1, ibNoValue, ifIx)
  return 0
}

// Arm value `tv` delivered into `v`'s rep `vr`; into a box of union `uty` (not -1), one the
// checker records no box at is then boxed there, as `emitUnionBoxOwed` writes it (`boxOwedAt`).
function armBoxDeliver(b: i32[], tv: i32, vr: i32, uty: i32): Opnd {
  const x = deliver(b, tv, vr, -1)
  if uty < 0 || ibMiss != "" || irBOpRep(x) == vr || boxOwedAt(tv, ibFnIx) {
    return x
  }
  return boxTempIn(b, x, tv, vr, -1, uty)
}

// One arm of `letIfSinkLink`: its prelude, then its value boxed at `v`'s union `uty`
// (`armBoxDeliver`), as `emitUnionArmToPair` writes it, and put into the sink pair.
function letIfSinkBody(blockIx: i32, v: i32, vr: i32, uty: i32): i32[] {
  const body: i32[] = []
  const blk = nodeAt(blockIx)
  const tv = ifArmValueExpr(blockIx)
  if !(blk is Block) || tv < 0 {
    skip("declaration if per arm prelude")
    return body
  }
  // The statements before the value, as legacy's `emitIfArmOpen` writes them.
  armPrelude(body, blockIx)
  if ibMiss != "" { return body }
  // A call that never returns is the arm's statement: legacy writes it and no store after it.
  if callIsNever(unwrapParen(tv)) {
    stmtNode(body, tv, NO_SIBS, -1)
    if ibMiss == "" && !irBodyLeaves(ib, body) {
      skip("declaration if never arm")
    }
    return body
  }
  const x = armBoxDeliver(body, tv, vr, uty)
  if ibMiss == "" && irBOpRep(x) != vr {
    skip("declaration if per arm coercion")
  }
  if ibMiss == "" {
    irBNode(
      body,
      { srOp: "sink.put", srHeap: -1, srArgs: [x], srImm: v },
      -1,
      ibNoValue,
      blockIx,
    )
  }
  return body
}

// The null `own` (`NULL_OWN_*`) written into `v` at `at`.
function nullInto(b: i32[], at: i32, v: i32, vr: i32, own: i32) {
  const t = repTemp(b, { nuAt: at, nuOwn: own, nuRead: [] }, at, vr)
  irBNode(b, { asDst: v, asSrc: t }, -1, ibNoValue, at)
  return 0
}

// One link of `letIfArms` (`emitNullableIfBindingLink`).
function letIfArmLink(
  b: i32[],
  ifIx: i32,
  v: i32,
  vr: i32,
  own: i32,
  uty: i32,
) {
  const n = nodeAt(unwrapParen(ifIx))
  if !(n is IfStmt) { return skip("declaration if per arm node") }
  const c = irBExpr(b, n.ifCond)
  if ibMiss != "" || irBOpRep(c) != ibBool { return skip("condition") }
  const thenB = letIfArmBody(n.ifThen, v, vr, uty)
  if ibMiss != "" { return 0 }
  const elseB: i32[] = []
  if n.ifElse < 0 {
    nullInto(elseB, ifIx, v, vr, own)
  } else if nodeAt(n.ifElse) is IfStmt {
    if ifJoinAdaptsScalar(n.ifElse, ibFnIx) {
      return skip("declaration if per arm scalar link")
    }
    letIfArmLink(elseB, n.ifElse, v, vr, own, uty)
  } else {
    for x in letIfArmBody(n.ifElse, v, vr, uty) { elseB.push(x) }
  }
  if ibMiss != "" { return 0 }
  irBNode(b, sIf(c, thenB, elseB, -1, true), -1, ibNoValue, ifIx)
  return 0
}

// One arm of `letIfArmLink`: its prelude, then its value delivered into `v` (`armBoxDeliver`), as
// `emitNulArmToLocal` writes it.
function letIfArmBody(blockIx: i32, v: i32, vr: i32, uty: i32): i32[] {
  const body: i32[] = []
  const blk = nodeAt(blockIx)
  const tv = ifArmValueExpr(blockIx)
  if !(blk is Block) || tv < 0 {
    skip("declaration if per arm prelude")
    return body
  }
  // The statements before the value, as legacy's `emitIfArmOpen` writes them.
  armPrelude(body, blockIx)
  if ibMiss != "" { return body }
  // A call that never returns is the arm's statement: legacy writes it and no store after it.
  if callIsNever(unwrapParen(tv)) {
    stmtNode(body, tv, NO_SIBS, -1)
    if ibMiss == "" && !irBodyLeaves(ib, body) {
      skip("declaration if never arm")
    }
    return body
  }
  const x = armBoxDeliver(body, tv, vr, uty)
  if ibMiss == "" && irBOpRep(x) != vr {
    skip("declaration if per arm coercion")
  }
  if ibMiss == "" {
    irBNode(body, { asDst: v, asSrc: x }, -1, ibNoValue, blockIx)
  }
  return body
}

// Whether body `b` ends in a temp's definition, an operand still waiting to be read.
function endsInTemp(b: i32[]): boolean {
  if b.length == 0 { return false }
  const id = b[b.length - 1]
  if id < 0 || id >= ib.irNodes.length { return false }
  const n = ib.irNodes[id]
  if !(n is SLet) || n.lDst < 0 || n.lDst >= ib.irVars.length { return false }
  return ib.irVars[n.lDst].vKind == "temp"
}

// The body of value-`if` arm `blockIx`: its one value, delivered at `rep`, written to out `t`. A
// direct `else if` the chain does not walk as a link is its own value.
function ifArm(blockIx: i32, t: i32, rep: i32): i32[] {
  const body: i32[] = []
  armPrelude(body, blockIx)
  if ibMiss != "" { return body }
  const tv = if nodeAt(blockIx) is IfStmt { blockIx } else { ifArmValueExpr(blockIx) }
  if tv < 0 {
    irBMiss("if arm value")
    return body
  }
  // A call that never returns leaves no value for the out: legacy writes it, and its `end` is
  // stack-polymorphic.
  if tv >= 0 && callIsNever(unwrapParen(tv)) {
    // Where legacy widens the arm's value it widens the dead one too (`emitWidened`).
    if blockValueWidenKind(valtypeOf(rep)) >= 0 {
      irBMiss("never arm widened")
      return body
    }
    stmtNode(body, tv, NO_SIBS, -1)
    if ibMiss == "" && !irBodyLeaves(ib, body) { irBMiss("never arm") }
    return body
  }
  const v = deliver(body, tv, rep, -1)
  if ibMiss == "" && irBOpRep(v) != rep { irBMiss("if arm coercion") }
  if ibMiss == "" {
    irBNode(body, { asDst: t, asSrc: v }, -1, ibNoValue, blockIx)
  }
  return body
}

// A value `if` arm's prelude, every statement before its value, as legacy's `emitIfArmOpen` lowers
// them (`emitStmtIn`, which banks no row of its own).
function armPrelude(body: i32[], blockIx: i32) {
  const blk = nodeAt(blockIx)
  if !(blk is Block) { return 0 }
  const stmts = blk.blkStmts
  let i = 0
  while i + 1 < stmts.length && ibMiss == "" {
    stmtNode(body, stmts[i], stmts, i)
    i = i + 1
  }
  return 0
}

// Whether value-`if` arm `blockIx` is a block with statements before its value.
function armHasPrelude(blockIx: i32): boolean {
  const blk = nodeAt(blockIx)
  return blk is Block && blk.blkStmts.length > 1
}

// `a && b` / `a || b`: a local the two arms of an `if` write.
function shortCircuit(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const lat = b.length
  const l = irBExpr(b, n.binLeft)
  if ibMiss != "" || irBOpRep(l) != ibBool { return irBMiss("logical operand") }
  // Legacy reads a constant `is` back off its bytes and writes the right side as a dead arm.
  if bareConstIs(l, n.binLeft, b, lat) {
    return irBMiss("decided is short-circuit")
  }
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  const t = irVarNew(ib, rep, ty, "local", -1)
  const rhsBody: i32[] = []
  const r = irBExpr(rhsBody, n.binRight)
  if irBOpRep(r) != ibBool { return irBMiss("logical operand") }
  irBNode(rhsBody, { asDst: t, asSrc: r }, -1, irBNoValue(), ix)
  const fixBody: i32[] = []
  const bits: i64 = if n.binOp == "&&" { 0 } else { 1 }
  const fixed: Opnd = { oiRep: ibBool, oiBits: bits }
  irBNode(fixBody, { asDst: t, asSrc: fixed }, -1, ibNoValue, ix)
  if n.binOp == "&&" {
    irBNode(b, sIf(l, rhsBody, fixBody, t, true), ty, rep, ix)
  } else {
    irBNode(b, sIf(l, fixBody, rhsBody, t, true), ty, rep, ix)
  }
  const o: Opnd = { ov: t }
  return o
}

// Number literal `n` at `ix` as an immediate at rep `rep`, where its own width is that rep's.
function numLit(n: NumLit, ix: i32, rep: i32): Opnd {
  const k: string = repPrim(rep) ?? ""
  // Past the narrow reading, legacy spells the literal at its own width (`emitNumLexAt`).
  if (
    (k == "i32" || k == "i64")
    && !numLexIsFloat(n.numText)
    && !numLitNarrow(n, k)
    && numLitWidth(ix, ibFnIx) != k
  ) {
    return irBMiss("wide literal width")
  }
  return numLitAt(n, ix, rep)
}

// Whether integer literal `n` reads as its narrow value at width `k`.
function numLitNarrow(n: NumLit, k: string): boolean {
  const v = memOffsetLexValue(n.numText)
  return v >= 0 && (k != "i32" || v <= 2147483647)
}

// Number literal `n` at `ix` as an immediate at rep `rep`, its lexeme spelled at that rep's width
// whatever the literal's own (`emitNumLexAt`).
function numLitAt(n: NumLit, ix: i32, rep: i32): Opnd {
  const k: string = repPrim(rep) ?? ""
  if k == "f64" || k == "f32" {
    const text = numLitLexAt(ix, n.numText, k)
    const bs = if k == "f64" { f64Bytes(text) } else { f32Bytes(text) }
    let bits: i64 = 0
    let i = bs.length - 1
    while i >= 0 {
      bits = bits * 256 + ((bs[i] & 255) as i64)
      i = i - 1
    }
    const f: Opnd = { oiRep: rep, oiBits: bits }
    return f
  }
  if numLexIsFloat(n.numText) { return irBMiss("float literal at an integer") }
  if numLitNarrow(n, k) {
    const o: Opnd = { oiRep: rep, oiBits: memOffsetLexValue(n.numText) }
    return o
  }
  // The bits legacy's literal writer spells: the lexeme split into halves at `i64`, wrapped at
  // `i32` (`emitNumLexAt`).
  let bits: i64 = 0
  if k == "i64" {
    const pr = parseI64Pair(n.numText)
    bits = ((pr[0] as i64) << 32) | ((pr[1] as i64) & 4294967295)
  } else if k == "i32" {
    bits = parseI32(n.numText) as i64
  } else {
    return irBMiss("wide literal")
  }
  const w: Opnd = { oiRep: rep, oiBits: bits }
  return w
}

function identRead(b: i32[], n: Ident, ix: i32, rep: i32, cell: boolean): Opnd {
  const d = identDeclOf(ix)
  if d < 0 { return irBMiss("unresolved read") }
  const dn = nodeAt(d)
  // A bundle parameter holds a record of closures each instance types (D14841): read at a member
  // pick (`bundleCallRhs`), or whole as that record where the IR holds it as one.
  if dn is Param && bundleAnyNoted() && bundleParamOfRead(ix, ibFnIx) >= 0 {
    // A closure's read of an enclosing frame's bundle parameter is its capture of that record.
    if identReadArmOf(n, ix, ibFnIx, false) == "capture" {
      return bundleCaptureRead(b, ix)
    }
    const pv = paramVarAt(localIndexOf(ibFnIx, ix))
    if pv < 0 || !(repNodeAt(ib.irVars[pv].vRep) is RRecord) {
      return irBMiss("bundle parameter read")
    }
    const o: Opnd = { ov: pv }
    return o
  }
  if captureSlotOf(n.identName, ibFnIx) >= 0 {
    return captureRead(b, n, ix, rep)
  }
  // A read in a `shadow` arm's region is the arm's empty list (`fitShadowVar`).
  const fv = fitShadowReadVar(n, ix)
  if fv >= 0 {
    if ib.irVars[fv].vRep != rep {
      return irBMiss("is empty fit shadow read rep")
    }
    const fo: Opnd = { ov: fv }
    return fo
  }
  const w = localIndexOf(ibFnIx, ix)
  // A walk's element is its loop's; a fragment inside a walk it did not build reads the element's
  // legacy slot, as a `let` it did not build, and its locals are checked against legacy's cells.
  const walkVar = dn is LoopVar && ((ibDeclVar[d] ?? -1) >= 0 || ib.irFragment)
  // A range loop's variable is the one its loop made, read as its copy's constant inside a full
  // unroll; a range loop it did not build is legacy's.
  const ri = if dn is ForRange { rangeImmAt(d) } else { -1 }
  if ri >= 0 {
    if rep != repNodeOfTy(TY_I32) { return irBMiss("range constant coercion") }
    const o: Opnd = { oiRep: rep, oiBits: ibRangeImmVal[ri] as i64 }
    return o
  }
  const rangeVar = dn is ForRange && (ibDeclVar[d] ?? -1) >= 0
  if (dn is LetDecl || dn is Param || walkVar || rangeVar) && w >= 0 {
    // A parameter is found by its wasm index: an instance's read resolves to the template's.
    const v = if dn is Param { paramVarAt(w) } else if dn is LoopVar { fragLoopVar(d, ix, rep) } else if rangeVar { ibDeclVar[d] ?? -1 } else { readDeclVar(d) }
    if v < 0 { return irBMiss("local rep") }
    // A read of a `null` unit local is its destination's null, as `emitNullAt` writes it.
    if (
      repPrim(ib.irVars[v].vRep) == "null"
      && identReadArmOf(n, ix, ibFnIx, false) == "nulnone"
    ) {
      return nullUnitTemp(b, ix, rep, [])
    }
    if ib.irVars[v].vRep != rep {
      return narrowedLocalRead(b, n, ix, v, rep, cell)
    }
    ib.irReadVar[ix] = v
    const o: Opnd = { ov: v }
    return o
  }
  const g = globalIndexOfSid(sidOfNode(ix))
  // A read of a never-filled `null` unit global is its destination's null, as legacy's
  // `emitIdentNode` writes it (`emitNullAt`), the same fold a local read takes.
  if (
    dn is LetDecl
    && g >= 0
    && identReadArmOf(n, ix, ibFnIx, false) == "nulnone"
  ) {
    return nullUnitTemp(b, ix, rep, [])
  }
  if dn is LetDecl && g >= 0 {
    // Legacy stores a map cell at its binding's storage type (`letCellSlot`'s `letMapShapeOfTy`,
    // `letBindTy`), so in a build that has not noted the cell, a read typed there reads it as is.
    if (
      irGlobalRepOf(ib, g) < 0
      && globalCellKind(d) == "map"
      && rep == globalTyRep(letBindTy(d, -1))
    ) {
      globalNoteAt(g, d, rep)
    }
    const cellRep = globalRep(g, d)
    // A seated read narrowed to `null` whose storage read is that null is the cell as it stands,
    // as a local's is (`nullReadOwnAt`).
    if (
      cell
      && cellRep != rep
      && identReadArmOf(n, ix, ibFnIx, false) == "nullread"
      && nullReadOwnAt(ix) == NULL_READ_STORED
    ) {
      return globalStoredRead(b, g, ix, cellRep, heldTy(letBindTy(d, -1)))
    }
    // A union cell narrowed to an atom or a record arm unboxes its box, as a local's does.
    const ba: BoxNarrowArm = if cellRep != rep { boxNarrowArmOf(ix, cellRep, rep, identReadArmOf(n, ix, ibFnIx, false)) } else { "none" }
    if ba == "atom" || ba == "variant" {
      return globalUnboxRead(b, g, d, ix, cellRep, rep, ba, -1)
    }
    // A union cell narrowed to a smaller union is the same box, staged at the narrowed rep as a
    // box local's is.
    if (
      cellRep != rep
      && heldAsBox(cellRep)
      && heldAsBox(rep)
      && identReadArmOf(n, ix, ibFnIx, false) == "nonlocal"
    ) {
      const bx = globalBoxAt(b, g, d, ix, cellRep)
      if ibMiss != "" { return bx }
      // A compare reads the box again, as legacy re-reads the global (`globalBoxAt`'s read).
      const gr: Rhs = {
        ggSym: g,
        ggNonNull: irBGlobalBoxRecovers(ix),
        ggNn: -1,
      }
      ib.irReadAgain[ix] = gr
      return irBLetTemp(b, { sgV: bx }, ix, rep)
    }
    // A box cell narrowed to a `boolean | null` or `string | null` niche, or a list's, closure's or
    // map's `A | null`, is its box through the niche tail, as a box local's is.
    if (
      cellRep != rep
      && heldAsBox(cellRep)
      && identReadArmOf(n, ix, ibFnIx, false) == "niche"
    ) {
      const nk = nicheReadKindAt(ix, ibFnIx)
      if nk != 1 && nk != 2 && nicheReadRefOf(ix, ibFnIx) == "" {
        return irBMiss("narrowed read niche kind")
      }
      const bx = globalBoxAt(b, g, d, ix, cellRep)
      if ibMiss != "" { return bx }
      return irBLetTemp(
        b,
        { nrV: bx, nrAt: ix, nrKind: nk, nrRow: false },
        ix,
        rep,
      )
    }
    // A union cell narrowed to a ref-element list or a map arm reads unboxed to it.
    const con = if cellRep != rep { boxContainerReadOf(n, ix, cellRep, rep) } else { -1 }
    if con >= 0 {
      return globalUnboxRead(b, g, d, ix, cellRep, rep, "container", con)
    }
    // A union cell (`globalCellKind`) stores the box, which a narrowed read unboxes; a boxed
    // `T | null` cell read at the box inside it is that box, its null one more tag.
    const cn = repNodeAt(cellRep)
    const boxCore = cellRep != rep
      && globalCellKind(d) == "union"
      && cn is RNullable
      && cn.rnDisc == 4
      && cn.rnInner == rep
      && nullNarrowArmOf(ix, cellRep, rep) == "plain"
    const narrowed = boxCore
      || cellRep != rep
      && globalCellKind(d) != "union"
      && nullNarrowArmOf(ix, cellRep, rep) == "plain"
    // In a build whose initializer stored the cell at its storage row (`globalInitValue`), a read
    // the checker typed at the binding reads the cell as it is, at that row.
    const stored = cellRep != rep
      && !narrowed
      && rep == globalTyRep(scopeTyAt(d, -1))
      && cellRep == globalTyRep(letBindTy(d, -1))
    // An atom-assignment cell (`atomCellRep`) read at a string is its id, decoded as legacy's
    // `emitAtomToStr` decodes it; a delivery (`cell`) takes the id as it stands.
    if (
      cellRep != rep
      && repNodeAt(cellRep) is RAtom
      && repPrim(rep) == "str"
      && atomCellRep(d, rep) == cellRep
    ) {
      const id = globalStoredRead(b, g, ix, cellRep, repTyOf(cellRep))
      if ibMiss != "" || cell { return id }
      return repTemp(b, { sxV: id, sxAt: ix }, ix, rep)
    }
    // A list cell the global section declares at the list its initializer built, an instance's
    // (`cellDeclStores`), is read as it is, at that list.
    const declStored = cellRep != rep
      && !narrowed
      && !stored
      && repNodeAt(rep) is RList
      && cellDeclStores(d, rep, cellRep)
    if declStored {
      return globalStoredRead(b, g, ix, cellRep, repTyOf(cellRep))
    }
    // A reference the cell holds at a rep that stores as the read's (`repStoresAs`) is legacy's
    // plain `global.get`, read at the read's rep.
    const alike = cellRep != rep
      && !narrowed
      && !stored
      && repStoresAs(rep, cellRep)
    // A record type no struct row records, read at it, reads the cell at the row its initializer
    // stored, as a local's (`rowlessLetTy`).
    const rowTy = if cellRep != rep && !narrowed && !stored { globalRowlessTy(d, cellRep, rep) } else { -1 }
    // A tagged set's id the tag decision delivers as its member's closure (`fnCloCoerceAtNode`) is read
    // as the cell holds it, the id `fnCloTail` drops.
    const tagId = cellRep != rep
      && repNodeAt(rep) is RClosure
      && repPrim(cellRep) == "i32"
      && fnCloCoerceAtNode(ix) >= 0
    // A closure cell read where its type leaves a closure part open or fills one is the same
    // closure struct, retagged.
    const holed = cellRep != rep
      && !narrowed
      && !stored
      && holeRetagNoted(cellRep, rep, true)
      && exprPrePathWhy(ix, ibFnIx) == ""
    // An atom cell read where the checker typed a string passes its id to a delivery's seated
    // read (`cell`), whose atom arm decodes it, as a local's does.
    const atomId = cellRep != rep
      && !narrowed
      && !stored
      && cell
      && (atomAtStr(cellRep, rep)
      || atomNullable(cellRep) && repPrim(rep) == "str")
    // A binding holding one closed member of a returned record, read where the read's type leaves
    // a variable open, is that member's closure as its cell holds it (`globalHolderTy`).
    const gh = if cellRep != rep && !narrowed && !stored && !holed && !alike { globalHolderTy(d) } else { -1 }
    // A string cell narrowed to a literal set reads, where legacy decodes no atom
    // (`exprIsLitAtom`), as the string it holds, as a local's does.
    const strHeld = cellRep != rep
      && !narrowed
      && !stored
      && repNodeAt(rep) is RAtom
      && repPrim(cellRep) == "str"
      && !exprIsLitAtom(ix, ibFnIx)
    const member = gh >= 0
      && repNodeOfTy(gh) == cellRep
      && irTyHeldOpen(heldTy(exprTyOf(ix)), rep)
    const declined = cellRep != rep
      && !narrowed
      && !stored
      && !holed
      && !alike
      && !member
      && !atomId
      && rowTy < 0
      && !tagId
      && !strHeld
    // A read narrowed to `null` whose storage is that null (`NULL_READ_STORED`) is the cell as it
    // stands, at the binding's row, as a local's storage read is.
    if (
      declined
      && nullReadOwnAt(ix) == NULL_READ_STORED
      && repNodeOfTy(heldTy(letBindTy(d, -1))) == cellRep
    ) {
      return globalStoredRead(b, g, ix, cellRep, heldTy(letBindTy(d, -1)))
    }
    // A struct cell read at a record its row holds is read at that row.
    const rowRt = if declined { globalCellRowReadTy(ix, d, cellRep, rep) } else { -1 }
    if rowRt >= 0 { return globalStoredRead(b, g, ix, cellRep, rowRt) }
    if declined { return irBMiss("global read coercion") }
    if stored {
      return globalStoredRead(b, g, ix, cellRep, heldTy(letBindTy(d, -1)))
    }
    if rowTy >= 0 { return globalStoredRead(b, g, ix, cellRep, rowTy) }
    if tagId {
      return globalStoredRead(b, g, ix, cellRep, heldTy(letBindTy(d, -1)))
    }
    const gm = irGlobalReadMiss(g, ibGlobalCtx())
    if gm != "" { return irBMiss(gm) }
    const sid = sidOfNode(ix)
    const gr: Rhs = {
      ggSym: g,
      ggNonNull: globalReadRecovers(sid, ix, ibFnIx),
      ggNn: if boxCore { 0 } else if narrowed { if readOwesNonNullRecover(ix, ibFnIx) { 1 } else { 0 } } else { -1 },
    }
    ib.irReadAgain[ix] = gr
    if holed {
      // The cell is read at its storage row, the binding's type, or the member a binding holding
      // one of a returned record holds (`globalHolderTy`).
      const bt = heldTy(letBindTy(d, -1))
      const lt = if repNodeOfTy(bt) != cellRep && globalHolderTy(d) >= 0 { globalHolderTy(d) } else { bt }
      if repNodeOfTy(lt) != cellRep { return irBMiss("global read coercion") }
      const held = irBLetTempTy(b, gr, ix, cellRep, lt)
      // Retagged to a rep whose type is open, the value would have no type; the member is read as
      // the cell holds it.
      if lt != bt && irTyHeldOpen(heldTy(exprTyOf(ix)), rep) { return held }
      return repTemp(b, { rgV: held }, ix, rep)
    }
    if atomId {
      // The id is read at the binding's own type, whose rep is the cell's.
      const at = heldTy(letBindTy(d, -1))
      if repNodeOfTy(at) != cellRep { return irBMiss("global read coercion") }
      return irBLetTempTy(b, gr, ix, cellRep, at)
    }
    if member { return irBLetTempTy(b, gr, ix, cellRep, gh) }
    if strHeld { return irBLetTempTy(b, gr, ix, cellRep, TY_STR) }
    noteCellHeap(d, rep)
    return irBLetTempTy(b, gr, ix, rep, globalReadTy(d, ix, rep))
  }
  if dn is FuncDecl && repNodeAt(rep) is RClosure {
    return cloValue(b, ix, rep, heldTy(exprTyOf(ix)))
  }
  return irBMiss("read of " + n.identName)
}

// Notes a struct cell's heap (`globalCellStructIdx`; a nullable cell uses its record's) for the
// record rep `rep` it is read at, where that rep's type has no heap of its own and its fields lower
// alike with, or widen to, the cell row's own; a second cell of that rep on another heap unnotes it.
function noteCellHeap(d: i32, rep: i32) {
  if !(repNodeAt(rep) is RRecord) { return 0 }
  const key = i32ToStr(d) + ":" + i32ToStr(rep) + ":" + i32ToStr(repTyOf(rep))
  const memo = cellHeapMemo[key] ?? -2
  const h = if memo != -2 { memo } else { cellHeapOf(d, rep) }
  cellHeapMemo[key] = h
  if h >= 0 { askRecordHeapNone(repTyOf(rep)) }
  return irRecHeapNoteOne(ib, rep, h)
}

// Each (global, rep, type) answer `cellHeapOf` gave in this program's emit (`irShadowBegin`).
let cellHeapMemo: {[string]: i32} = Map()

function cellHeapOf(d: i32, rep: i32): i32 {
  const k = globalCellKind(d)
  if recHeapOf(rep) >= 0 || k != "struct" && k != "nulstruct" { return -1 }
  return rowHeapFor(rep, globalCellStructIdx(d))
}

// The heap of struct row `row` for heapless record rep `rep` read off it, where `rep`'s fields lower
// alike with, or widen to, the row's own; -1 otherwise.
function rowHeapFor(rep: i32, row: i32): i32 {
  const h = structRowHeap(row)
  const rr = repNodeOfTy(slotRowTyOf(row))
  if h < 0 || rr < 0 || recHeapOf(rr) != h { return -1 }
  const hs: {[i32]: i32} = Map()
  hs[rep] = h
  recHeapsNote(hs, rr)
  if !repsLowerAlike(rep, rr, hs) && !recFieldsWiden(rep, rr, hs) { return -1 }
  return h
}

// A `string | null` capture read where its type bears no null: its slot, then the `ref.as_non_null`
// legacy writes for it (`emitCapturedReadRecover`), at the plain string.
function capturedStrRecovered(
  b: i32[],
  fe: i32,
  name: string,
  ix: i32,
  rep: i32,
): Opnd {
  if repPrim(rep) != "str" { return irBMiss("capture recover rep") }
  if cloLifted(fe) {
    // A lifted function's capture is its own parameter, recovered as a local read is.
    const v = liftCapVar(fe, name, -1)
    if v < 0 || !strNullable(ib.irVars[v].vRep) {
      return irBMiss("capture recover")
    }
    const o: Opnd = { ov: v }
    return irBLetTempTy(
      b,
      { rcV: o, rcAt: ix, rcNn: 1 },
      ix,
      rep,
      heldTy(exprTyOf(ix)),
    )
  }
  const ev: Rhs = { evSlot: captureSlotOf(name, ibFnIx), evAt: ix }
  return irBLetTempTy(b, ev, ix, rep, heldTy(exprTyOf(ix)))
}

// The type read `ix` of global `d` at rep `rep` is held at: the read's own, or the type the
// binding holds where the read's leaves a variable open and the held type's rep is `rep`.
function globalReadTy(d: i32, ix: i32, rep: i32): i32 {
  const ty = heldTy(exprTyOf(ix))
  // A read typed where nothing fixes a list's element (`openCellRep`) is at its rep's type.
  if (
    globalTyRep(ty) < 0
    && repTyOf(rep) >= 0
    && globalTyRep(scopeTyAt(d, -1)) < 0
  ) {
    return repTyOf(rep)
  }
  if !irTyHeldOpen(ty, rep) { return ty }
  const ht = globalHolderTy(d)
  if ht >= 0 && repNodeOfTy(ht) == rep { return ht }
  // A read whose own type has no rep is at its cell's (`irBOpenLocalReadRep`), whose type it takes.
  const rt = repTyOf(rep)
  return if exprRepOf(ix) < 0 && rt >= 0 && !irTyHeldOpen(rt, rep) { rt } else { ty }
}

// The record type of the struct row global `d`'s cell holds at rep `cellRep`, where the read at
// `rep` is typed at a record no struct row records; else -1.
function globalRowlessTy(d: i32, cellRep: i32, rep: i32): i32 {
  const st = heldTy(scopeTyAt(d, -1))
  if rep != repNodeOfTy(st) { return -1 }
  return rowlessStoredTy(st, rep, repTyOf(cellRep))
}

// The row type a struct global `d`'s cell (rep `cellRep`) is read at for its read `ix` at record
// rep `rep`, where the read's record is that row's or one no row records, held there
// (`rowlessStoredTy`); else -1.
function globalCellRowReadTy(ix: i32, d: i32, cellRep: i32, rep: i32): i32 {
  const row = globalCellStructIdx(d)
  if globalCellKind(d) != "struct" || row < 0 || row >= sTyIx.length {
    return -1
  }
  const rt = sTyIx[row]
  if rt < 0 || irTyOpen(rt) || repNodeOfTy(rt) != cellRep { return -1 }
  const t = nodeTyAt(ix, ibFnIx)
  if t < 0 || repNodeOfTy(t) != rep || !(repNodeAt(rep) is RRecord) {
    return -1
  }
  if structIndexOfTy(t) == row { return rt }
  return if rowlessStoredTy(t, rep, rt) == rt { rt } else { -1 }
}

// Read `ix` of global `g` as its cell stores it: rep `cellRep`, typed at `ty`, the
// binding's own type or its row's, as legacy's `global.get` reads it.
function globalStoredRead(
  b: i32[],
  g: i32,
  ix: i32,
  cellRep: i32,
  ty: i32,
): Opnd {
  const gm = irGlobalReadMiss(g, ibGlobalCtx())
  if gm != "" { return irBMiss(gm) }
  const gr: Rhs = {
    ggSym: g,
    ggNonNull: globalReadRecovers(sidOfNode(ix), ix, ibFnIx),
    ggNn: -1,
  }
  ib.irReadAgain[ix] = gr
  return irBLetTempTy(b, gr, ix, cellRep, ty)
}

// Capture `n` read at `rep` on legacy's `capture` arm (`emitCapturedRead`): a lifted function's
// own parameter after its environment, else its environment's field; at the capture's own rep.
function captureRead(b: i32[], n: Ident, ix: i32, rep: i32): Opnd {
  // Legacy's `unbox` arm reads a captured union box narrowed to a member: the box, then unboxed.
  const arm = identReadArmOf(n, ix, ibFnIx, false)
  // A `null`-typed capture read on legacy's `nulnone` arm is its destination's null, as a `null`
  // unit local's is: the environment is not read.
  if (
    arm == "nulnone"
    && repPrim(capRepOf(fnStmtsPosOf(ibFnIx), n.identName)) == "null"
  ) {
    return nullUnitTemp(b, ix, rep, [])
  }
  const unbox = arm == "unbox"
  if !unbox && arm != "capture" { return irBMiss("read of " + n.identName) }
  const fe = fnStmtsPosOf(ibFnIx)
  const name = n.identName
  if captureValKind(fe, name) == "nulstr" && nulStrReadRecovers(ix, ibFnIx) {
    return capturedStrRecovered(b, fe, name, ix, rep)
  }
  const cr = capRepFor(fe, name, if unbox { -1 } else { rep })
  if cr == rep { noteCapHeap(fe, name, rep) }
  // A capture of a binding legacy holds as an atom, read at a string, is that atom, decoded.
  const ar = if !unbox && cr != rep { captureAtomCellRep(fe, name, ix, rep) } else { -1 }
  if ar >= 0 { return capturedAtomDecoded(b, fe, name, ix, ar, rep) }
  // A nullable capture read at the member the checker narrowed it to: the capture at its own rep.
  const na: NullNarrowArm = if cr != rep && !unbox { nullNarrowArmOf(ix, cr, rep) } else { "none" }
  const ak = if unbox && heldAsBox(cr) { identUnboxAtomOf(ix, ibFnIx) } else { -1 }
  if unbox && ak < 0 { return irBMiss("capture unbox") }
  const narrowed = unbox || na == "plain" || na == "held"
  // A closure capture read where its type leaves a closure part open, or fills one, is the same
  // closure struct, retagged.
  const holed = cr != rep
    && !narrowed
    && holeRetagNoted(cr, rep, true)
    && exprPrePathWhy(ix, ibFnIx) == ""
  // A union-box capture read at a narrower union's box is the same box (`RStage`), as a box
  // local's narrowed read is: legacy's `capture` arm writes the env read alone. The checker must
  // have narrowed the read out of the capture's storage (`readNarrowedTyAt`); `narrowed` already
  // took a nullable read at its inner rep.
  const boxed = cr != rep
    && !narrowed
    && !holed
    && arm == "capture"
    && heldAsBox(cr)
    && heldAsBox(rep)
    && readNarrowedTyAt(ix, ibFnIx) >= 0
  // A capture held at a record row its read's type does not record is read as it is held, as a
  // local's read is (`rowlessReadTyOfVar`), typed at the row its fields are read at.
  const rowTy = if cr != rep && !narrowed && !holed && !boxed { capRowlessTy(fe, name, ix, cr) } else { -1 }
  if (
    cr != rep
    && !narrowed
    && !holed
    && !boxed
    && rowTy < 0
    && !capCellListSame(fe, name, cr, rep)
  ) {
    return irBMiss("capture binding")
  }
  if rowTy >= 0 { return capturedAsHeld(b, fe, name, ix, cr, rowTy) }
  // The capture is held at its binding's type, or a walk variable's (`capLoopTyOf`), whose rep
  // must be the one it is read at first.
  const atOwn = narrowed || holed || boxed
  const bty = if atOwn { capTyOf(fe, name) } else { -1 }
  const cty = if atOwn && bty < 0 { capLoopTyOf(fe, name) } else { bty }
  if atOwn && (cty < 0 || repNodeOfTy(cty) != cr) {
    return irBMiss("capture binding")
  }
  if !cloLifted(fe) {
    // An `is K[]`-tested capture legacy reads as an empty `K[]` of its own (D4935).
    if listFitCaptureStandIn(name, ix, ibFnIx, false, []) >= 0 {
      return irBMiss("capture list test")
    }
    const ev: Rhs = { evSlot: captureSlotOf(name, ibFnIx), evAt: ix }
    if !atOwn {
      // Legacy reads a capture again from the environment.
      ib.irReadAgain[ix] = ev
      return irBLetTempTy(b, ev, ix, cr, capReadTy(fe, name, ix, cr))
    }
    const own = irBLetTempTy(b, ev, ix, cr, cty)
    // Retagged to a rep whose type is open, the value would have no type; a holder's member is
    // read as its capture holds it, as a global holder's is.
    if holed && irTyHeldOpen(heldTy(exprTyOf(ix)), rep) { return own }
    if holed { return repTemp(b, { rgV: own }, ix, rep) }
    if boxed { return irBLetTemp(b, { sgV: own }, ix, rep) }
    if unbox { return captureUnbox(b, own, ix, rep, ak) }
    return captureRecover(b, own, ix, rep, na)
  }
  const v = liftCapVar(fe, name, if unbox { -1 } else { rep })
  const held = if atOwn { cr } else { rep }
  if v < 0 || ib.irVars[v].vRep != held { return irBMiss("capture binding") }
  ib.irReadVar[ix] = v
  const o: Opnd = { ov: v }
  if holed && irTyHeldOpen(heldTy(exprTyOf(ix)), rep) { return o }
  if holed { return repTemp(b, { rgV: o }, ix, rep) }
  if boxed { return irBLetTemp(b, { sgV: o }, ix, rep) }
  if unbox { return captureUnbox(b, o, ix, rep, ak) }
  return if narrowed { captureRecover(b, o, ix, rep, na) } else { o }
}

// The type capture `name` of `fe`, held at rep `cr`, is held at where its read `ix` names a record
// row that type does not record (`rowlessReadTyAt`); -1 for none.
function capRowlessTy(fe: i32, name: string, ix: i32, cr: i32): i32 {
  const ct = capTyOf(fe, name)
  if ct < 0 || repNodeOfTy(ct) != cr { return -1 }
  const rt = rowlessReadTyAt(nodeTyAt(ix, ibFnIx), ct)
  return if rt == ct { ct } else { -1 }
}

// Read `ix` of capture `name` of `fe` at its own rep `cr` and type `ct`: the environment's field,
// or the lifted function's parameter.
function capturedAsHeld(
  b: i32[],
  fe: i32,
  name: string,
  ix: i32,
  cr: i32,
  ct: i32,
): Opnd {
  if !cloLifted(fe) {
    const ev: Rhs = { evSlot: captureSlotOf(name, ibFnIx), evAt: ix }
    ib.irReadAgain[ix] = ev
    return irBLetTempTy(b, ev, ix, cr, ct)
  }
  const v = liftCapVar(fe, name, cr)
  if v < 0 || ib.irVars[v].vRep != cr { return irBMiss("capture binding") }
  ib.irReadVar[ix] = v
  const o: Opnd = { ov: v }
  return o
}

// The atom rep capture `name` of `fe` is held at where its read `ix` at plain string `rep` reads
// a binding legacy holds as the atom (`exprIsLitAtom`), else -1. The `K | null` niche misses.
function captureAtomCellRep(fe: i32, name: string, ix: i32, rep: i32): i32 {
  if repPrim(rep) != "str" || strNullable(rep) || !exprIsLitAtom(ix, ibFnIx) {
    return -1
  }
  if exprNulLitUnion(ix, ibFnIx) {
    irBMiss("capture atom niche")
    return -1
  }
  const ty = atomRecordAt(ix, ibFnIx)
  const ar = if ty >= 0 { repNodeOfTy(ty) } else { -1 }
  if ar < 0 || !(repNodeAt(ar) is RAtom) { return -1 }
  return if capRepFor(fe, name, ar) == ar { ar } else { -1 }
}

// Capture `name` of `fe`, held at atom rep `ar`, read at string `rep`: the environment's field or
// the lifted function's parameter, decoded to its member string (`RAtomStr`).
function capturedAtomDecoded(
  b: i32[],
  fe: i32,
  name: string,
  ix: i32,
  ar: i32,
  rep: i32,
): Opnd {
  const aty = atomRecordAt(ix, ibFnIx)
  if !cloLifted(fe) {
    const ev: Rhs = { evSlot: captureSlotOf(name, ibFnIx), evAt: ix }
    return atomToStr(b, irBLetTempTy(b, ev, ix, ar, aty), ix, rep)
  }
  const v = liftCapVarAt(fe, name, ar, aty)
  if v < 0 || ib.irVars[v].vRep != ar { return irBMiss("capture binding") }
  ib.irReadVar[ix] = v
  const o: Opnd = { ov: v }
  return atomToStr(b, o, ix, rep)
}

// Notes the heap of the struct row legacy's capture `name` of `fe` is stored at
// (`captureValStructIdx`) for the record rep `rep` it is read at, where that rep has none, as
// `noteCellHeap` does for a global's cell.
function noteCapHeap(fe: i32, name: string, rep: i32) {
  if !(repNodeAt(rep) is RRecord) { return 0 }
  const key = "c"
    + i32ToStr(fe)
    + ":"
    + name
    + ":"
    + i32ToStr(rep)
    + ":"
    + i32ToStr(repTyOf(rep))
  const memo = cellHeapMemo[key] ?? -2
  const h = if memo != -2 { memo } else { capHeapOf(fe, name, rep) }
  cellHeapMemo[key] = h
  if h >= 0 { askRecordHeapNone(repTyOf(rep)) }
  return irRecHeapNoteOne(ib, rep, h)
}

function capHeapOf(fe: i32, name: string, rep: i32): i32 {
  if recHeapOf(rep) >= 0 || captureValKind(fe, name) != "struct" { return -1 }
  return rowHeapFor(rep, captureValStructIdx(fe, name))
}

// Captured box `o` read at member `rep` on legacy's `unbox` arm: unboxed at atom kind `ak`
// (`identUnboxAtomOf`), as a local box's `unbox` read is.
function captureUnbox(b: i32[], o: Opnd, ix: i32, rep: i32, ak: i32): Opnd {
  return irBLetTemp(
    b,
    { bnV: o, bnAt: ix, bnRep: rep, bnAtom: ak, bnCon: -1 },
    ix,
    rep,
  )
}

// Narrowed capture read `ix` of `o` at its member `rep`, on `nullNarrowArmOf`'s arm `na`: what
// `emitCapturedRead` leaves, then `emitReadRecover`'s `ref.as_non_null` where the read owes it.
function captureRecover(
  b: i32[],
  o: Opnd,
  ix: i32,
  rep: i32,
  na: NullNarrowArm,
): Opnd {
  const nn = if readOwesNonNullRecover(ix, ibFnIx) { 1 } else { 0 }
  const r: Rhs = { rcV: o, rcAt: ix, rcNn: nn }
  if na == "held" {
    return irBLetTempTy(b, r, ix, rep, recoveredReadTyOf(heldTy(exprTyOf(ix))))
  }
  return irBLetTemp(b, r, ix, rep)
}

// Whether capture `name` of `fe`, held at list `cr`, is the list `rep` a read asks for: legacy's
// capture and its binding's cell are a list of closures (`captureValKind`, `letBindRep`), whose
// one wasm type holds the instance's closures and the binding's open ones alike.
function capCellListSame(fe: i32, name: string, cr: i32, rep: i32): boolean {
  const a = repNodeAt(cr)
  const w = repNodeAt(rep)
  if !(a is RList) || !(w is RList) { return false }
  if (
    !(repNodeAt(a.rlsElem) is RClosure)
    || !(repNodeAt(w.rlsElem) is RClosure)
  ) {
    return false
  }
  if captureValKind(fe, name) != "reflist" { return false }
  const d = parentBindingOf(fe, name)
  if d < 0 || !(nodeAt(d) is LetDecl) { return false }
  const pf = parentBindingFrameArenaOf(fe, name)
  return letBindRepClaims(d, pf) && letBindRep(d, pf).rdKind == "reflist"
}

// The rep of capture `name` of function `fe`, its binding's type in the frame that owns it; -1
// when that rep is no value, open, or not the valtype legacy gives the capture (`captureValKind`).
function capRepOf(fe: i32, name: string): i32 { return capRepFor(fe, name, -1) }

// `capRepOf`, where a captured loop variable (`captureLoopNodeOf`), whose declaration records no
// type, takes read rep `readRep`, or with no read its loop's type (`capLoopTyOf`), when legacy's
// capture valtype for it (`captureValKind`) agrees, else -1. A binding whose type gives no rep (open
// in the frame that owns it) takes `readRep` the same way.
function capRepFor(fe: i32, name: string, readRep: i32): i32 {
  let ty = capTyOf(fe, name)
  if ty < 0 && readRep >= 0 && captureLoopNodeOf(fe, name) >= 0 {
    ty = repTyOf(readRep)
  }
  if ty < 0 && readRep < 0 { ty = capLoopTyOf(fe, name) }
  const r = capRepAtTy(fe, name, ty)
  if r >= 0 || readRep < 0 { return r }
  return capRepAtTy(fe, name, repTyOf(readRep))
}

// The rep of capture `name` of `fe` held at type `ty`; -1 when `ty` is -1, no value, open, or not
// the valtype legacy gives the capture (`captureValKind`).
function capRepAtTy(fe: i32, name: string, ty: i32): i32 {
  if ty < 0 { return -1 }
  const r = repNodeOfTy(ty)
  if isVoidTy(ty) || !valueRep(r, ty) || irTyHeldOpen(ty, r) { return -1 }
  const vt: u8[] = []
  const prev = wTarget(vt)
  fbValtype(captureValKind(fe, name), captureValStructIdx(fe, name))
  wTarget(prev)
  // An atom and the `K | null` and `boolean | null` niches are held as their i32.
  const n = repNodeAt(r)
  const held = n is RAtom || atomNullable(r) || boolNullable(r)
  const t = if held { 0x7f } else { valtypeOf(r) }
  if vt.length == 0 { return -1 }
  if t >= 0 && (vt.length != 1 || vt[0] != t) { return -1 }
  // A `null`-typed capture (a generic's `null` instance) is held at `nullref`.
  const nul = repPrim(r) == "null" && vt.length == 1 && vt[0] == 0x71
  if t < 0 && vt[0] != 0x63 && vt[0] != 0x64 && !nul { return -1 }
  return r
}

// The type read `ix` of capture `name` of `fe`, at capture rep `cr`, is held at: the read's own,
// or the binding's where the read's leaves a variable open and the binding's rep is `cr` (a
// bundle parameter of hole type, held as its record).
function capReadTy(fe: i32, name: string, ix: i32, cr: i32): i32 {
  const ty = heldTy(exprTyOf(ix))
  if !irTyHeldOpen(ty, cr) { return ty }
  const cty = capTyOf(fe, name)
  return if cty >= 0 && repNodeOfTy(cty) == cr { cty } else { ty }
}

// The type of capture `name` of function `fe`: its binding's in the frame that owns it, or -1.
function capTyOf(fe: i32, name: string): i32 {
  const d = parentBindingOf(fe, name)
  if d < 0 { return -1 }
  const frame = parentBindingFrameArenaOf(fe, name)
  const ty = heldTy(scopeTyAt(d, frame))
  // A bundle parameter, and a binding holding a returned bundle whole (`holderRecordTy`), are held
  // as the record of one closure per signature, captured or not.
  if nodeAt(d) is Param && bundleSigsOfParam(d).length > 0 {
    return bundleHeldTy(d, ty)
  }
  const ht = if nodeAt(d) is LetDecl { holderRecordTy(d, frame) } else { -1 }
  if ht >= 0 { return ht }
  // One holding a single closed member of it is held as that member's closure, as `irBDeclVar`
  // holds the local (`holderMemberTy`).
  const hm = if nodeAt(d) is LetDecl && (elabHasRetRecords() || bundleAnyNoted()) { holderMemberTy(d, frame) } else { -1 }
  return if hm >= 0 && !irTyOpen(hm) { hm } else { ty }
}

// The type of captured loop variable `name` of `fe` with no read to type it: a `for-in`'s element
// in the frame that owns the loop (`forInElemTyOf`), a range's i32 counter; -1 for a `for-in`'s
// second name or no loop.
function capLoopTyOf(fe: i32, name: string): i32 {
  const lp = captureLoopNodeOf(fe, name)
  if lp < 0 { return -1 }
  const ln = nodeAt(lp)
  if ln is ForRange { return TY_I32 }
  if !(ln is ForIn) || ln.fiVar2 == name { return -1 }
  return forInElemTyOf(ln.fiIter, parentBindingFrameArenaOf(fe, name))
}

// The parameter variable of the lifted function `fe` being built for its capture `name`, at
// `capRepFor`'s rep for a first read at `readRep` (-1 for none), made at its first use; -1 when a
// captured `for-in` variable has no rep yet. One held at its read's rep, not its binding type's
// (a shared cell), is typed at that rep.
function liftCapVar(fe: i32, name: string, readRep: i32): i32 {
  return liftCapVarAt(fe, name, readRep, -1)
}

// `liftCapVar`, its parameter typed `atTy` where that is not -1.
function liftCapVarAt(fe: i32, name: string, readRep: i32, atTy: i32): i32 {
  const w = 1 + captureSlotOf(name, ibFnIx)
  const known = paramVarAt(w)
  if known >= 0 { return known }
  const r = capRepFor(fe, name, readRep)
  const bty = if atTy >= 0 { atTy } else { capTyOf(fe, name) }
  const ty = if readRep < 0 && bty < 0 { capLoopTyOf(fe, name) } else { bty }
  if ty < 0 && r < 0 { return -1 }
  const vty = if ty >= 0 && (r < 0 || repNodeOfTy(ty) == r) { ty } else { repTyOf(r) }
  const v = irVarNew(ib, r, vty, "param", w)
  ib.irParams.push(v)
  return v
}

// A function name or literal `ix` read as a closure value: capture-free as a global's initializer
// reads one, or over a fresh environment of its captures as this frame holds them; at type `ty`.
function cloValue(b: i32[], ix: i32, rep: i32, ty: i32): Opnd {
  const fe = cloValueFeOf(ix)
  if fe < 0 {
    cloUnfixedRefuse(ix)
    return irBMiss(cloValueWhy(ix))
  }
  // A binding legacy stores as a generic function's core closure (`ibAliasRhs`) is written core.
  const core = cloValueIsCore(ix, fe) || ix == ibAliasRhs
  const why = if core { closureValueCoreWhy(fe) } else { closureValueWhy(fe) }
  // A generic function taken as a value is legacy's contract, raised before the claim declines.
  if (why != "" && emitSoftFail && !core && closureValueIsGeneric(fe)) {
    emitFailAt(why, ix)
  }
  if why != "" { return irBMiss("closure value refused") }
  const env: Opnd[] = if fnEnvIdxOf(fe) >= 0 { cloEnvOf(b, fe, ix) } else { [] }
  if ibMiss != "" { return irBMiss(ibMiss) }
  return irBLetTempTy(b, { mcFn: fe, mcEnv: env, mcAt: ix }, ix, rep, ty)
}

// A function value returned at another closure rep, with no coercion recorded at it, built at the
// function's result: legacy returns the same closure ref whatever signature its type names.
function retCloAt(b: i32[], retIx: i32): Opnd | null {
  const ix = unwrapParen(retIx)
  if ix < 0 || !(repNodeAt(ib.irRetRep) is RClosure) { return null }
  const own = exprRepOf(ix)
  if own == ib.irRetRep || !(repNodeAt(own) is RClosure) { return null }
  if exprPrePathWhy(ix, ibFnIx) != "" || cloValueFeOf(ix) < 0 { return null }
  return cloValue(b, ix, ib.irRetRep, ib.irRetTy)
}

// Whether a capture of `fe` is a binding of this frame's body, which legacy's fill of `fe`'s cell
// finds only by its emitter's scope: the builder then hands the lowering the environment.
function cloEnvReadsLocal(fe: i32): boolean {
  for name in captureNamesOf(fe) {
    if capCellTargetOf(name) < 0 && paramIndexOf(ibFnIx, name) < 0 {
      if cloEnvBoundVar(fe, name) >= 0 || loopCapVar(fe, name) >= 0 {
        return true
      }
    }
  }
  return false
}

// The variable this frame built for capture `name` of `fe`'s binding (`parentBindingOf`) where it
// is a declaration of this frame's own body; -1 for none.
function cloEnvBoundVar(fe: i32, name: string): i32 {
  const d = parentBindingOf(fe, name)
  if d < 0 || d >= P.nodes.length || !(nodeAt(d) is LetDecl) || !ownBinding(d) {
    return -1
  }
  return ibDeclVar[d] ?? -1
}

// The environment of capturing function `fe`, read at `ix`, as `emitClosureEnvOf` builds it: each
// capture a parameter or binding of this frame, or this frame's own capture, read as a temp the
// lowering writes at its use, inside a cached environment's slot test; a function-value cell has no
// operand. A value of `fe` through its cell has none at all: legacy fills the cell. A global misses.
function cloEnvOf(b: i32[], fe: i32, ix: i32): Opnd[] {
  const out: Opnd[] = []
  if cloCellReaches(fe, ibFnIx) && !cloEnvReadsLocal(fe) { return out }
  const self = fnStmtsPosOf(ibFnIx)
  for name in captureNamesOf(fe) {
    if capCellTargetOf(name) >= 0 { continue }
    const p = paramIndexOf(ibFnIx, name)
    const lv = if p < 0 { loopCapVar(fe, name) } else { -1 }
    const r0 = if lv >= 0 { capRepFor(fe, name, ib.irVars[lv].vRep) } else { capRepOf(fe, name) }
    // A capture of this frame's own parameter whose binding frame is not found (an instance's
    // closure) is held at that parameter's type.
    const pv = if r0 < 0 && p >= 0 { paramVarAt(envSlotShift(ibFnIx) + p) } else { -1 }
    const r = if pv >= 0 { capRepAtTy(fe, name, ib.irVars[pv].vTy) } else { r0 }
    if r < 0 || capCellTargetOf(name) >= 0 {
      irBMiss("closure env capture")
      return out
    }
    const d = if p < 0 && lv < 0 { liftCapDecl(fe, name) } else { -1 }
    let v = if p >= 0 { paramVarAt(envSlotShift(ibFnIx) + p) } else if lv >= 0 { lv } else if d >= 0 { irBDeclVar(d) } else { -1 }
    // A binding the body walk does not reach is the one legacy reads by name in this frame
    // (`captureHomeOf`): the capture's binding (`parentBindingOf`), once built here.
    if v < 0 && p < 0 && lv < 0 && d < 0 { v = cloEnvBoundVar(fe, name) }
    const fi = if v < 0 { captureSlotOf(name, ibFnIx) } else { -1 }
    if fi >= 0 && capRepOf(self, name) == r {
      if cloLifted(self) {
        v = liftCapVar(self, name, -1)
      } else {
        // Held at its binding's type, or at the rep's own where no binding frame is found, as
        // `liftCapVar` holds a lifted frame's.
        const cty = capTyOf(fe, name)
        const t = irBLetTempTy(
          b,
          { evSlot: fi, evAt: -1 },
          ix,
          r,
          if cty >= 0 { cty } else { repTyOf(r) },
        )
        if t is OVar { v = t.ov }
      }
    }
    if v < 0 {
      irBMiss("closure env capture")
      return out
    }
    const o: Opnd = { ov: v }
    // A closure held apart from its environment slot only in its holes is the same struct, retagged.
    // A record slot whose type no struct row records takes the binding's own row, as it stands.
    if ib.irVars[v].vRep != r {
      if rowlessSlotTakes(ib.irVars[v].vRep, r) {
        out.push(o)
        continue
      }
      if !holeRetagNoted(ib.irVars[v].vRep, r, true) {
        irBMiss("closure env capture")
        return out
      }
      out.push(repTemp(b, { rgV: o }, ix, r))
      continue
    }
    out.push(o)
  }
  return out
}

// The container (`RC_REF_LIST`, `RC_MAP`) a box local of rep `ownRep` read at `ix` unboxes to at
// list or map rep `rep` on legacy's `reflist` or `map` arm, else -1.
function boxContainerReadOf(n: Ident, ix: i32, ownRep: i32, rep: i32): i32 {
  const arm = identReadArmOf(n, ix, ibFnIx, false)
  if boxNarrowArmOf(ix, ownRep, rep, arm) != "container" { return -1 }
  return if arm == "reflist" { RC_REF_LIST } else { RC_MAP }
}

// Local `v` read at `rep`, which its narrowing gives it, not its own: a box at the variant a
// destination unboxes it to, or a nullable at its inner rep; `cell` as `exprAt` passes it.
function narrowedLocalRead(
  b: i32[],
  n: Ident,
  ix: i32,
  v: i32,
  rep: i32,
  cell: boolean,
): Opnd {
  const o: Opnd = { ov: v }
  const arm = identReadArmOf(n, ix, ibFnIx, false)
  // A string cell narrowed to a literal set reads, where legacy decodes no atom
  // (`exprIsLitAtom`), as the string it holds: a `string | null` through its recover.
  const own = ib.irVars[v].vRep
  if (
    arm == "local"
    && repNodeAt(rep) is RAtom
    && (repPrim(own) == "str" || strNullable(own))
    && !exprIsLitAtom(ix, ibFnIx)
  ) {
    if repPrim(own) == "str" { return o }
    const src: Rhs = { rcV: o, rcAt: ix, rcNn: recoverNonNulls(ix) }
    ib.irReadAgain[ix] = src
    return irBLetTempTy(b, src, ix, repNodeOfTy(TY_STR), TY_STR)
  }
  const ba = boxNarrowArmOf(ix, ib.irVars[v].vRep, rep, arm)
  if ba == "variant" {
    return irBLetTemp(
      b,
      { bnV: o, bnAt: ix, bnRep: rep, bnAtom: -1, bnCon: -1 },
      ix,
      rep,
    )
  }
  // A list read's overrides (`identListOverrideOf`) are asked at the lowering, which holds them.
  const na = if arm == "local" { nullNarrowArmOf(ix, ib.irVars[v].vRep, rep) } else { "none" }
  if na == "miss" { return irBMiss("nullable read recover") }
  if na == "held" || na == "plain" {
    // Legacy writes the recover again where it re-reads the name (`irReadAgain`).
    const rc: Rhs = { rcV: o, rcAt: ix, rcNn: recoverNonNulls(ix) }
    ib.irReadAgain[ix] = rc
    const rty = if na == "held" { recoveredReadTyOf(heldTy(exprTyOf(ix))) } else { heldTy(outTyOf(ix, rep)) }
    return irBLetTempTy(b, rc, ix, rep, rty)
  }
  if ba == "atom" {
    const ak = identUnboxAtomOf(ix, ibFnIx)
    if ak < 0 { return irBMiss("narrowed read dead") }
    const ar: Rhs = { bnV: o, bnAt: ix, bnRep: rep, bnAtom: ak, bnCon: -1 }
    // A loop's hoisted receiver reads it the same way again, where the unbox leaves `rep`.
    if irBUnboxKindRep(ak, rep) == rep { ib.irReadAgain[ix] = ar }
    return unboxAtomTemp(
      b,
      { bnV: o, bnAt: ix, bnRep: rep, bnAtom: ak, bnCon: -1 },
      ix,
      rep,
    )
  }
  // A union-box local narrowed to a ref-element list or a map arm reads unboxed to it.
  const con = boxContainerReadOf(n, ix, ib.irVars[v].vRep, rep)
  if con >= 0 {
    // A loop's hoisted receiver reads it the same way again.
    const cr: Rhs = { bnV: o, bnAt: ix, bnRep: rep, bnAtom: -1, bnCon: con }
    ib.irReadAgain[ix] = cr
    return irBLetTemp(b, cr, ix, rep)
  }
  // A union box narrowed to a smaller union is the same box; a compare reads it again.
  if ba == "box" {
    const sg: Rhs = { sgV: o }
    ib.irReadAgain[ix] = sg
    return irBLetTemp(b, sg, ix, rep)
  }
  // A box local narrowed to a `boolean | null` or `string | null` niche, or a list's, closure's or
  // map's `A | null` (legacy's `niche` arm).
  if arm == "niche" {
    const nk = nicheReadKindAt(ix, ibFnIx)
    if nk != 1 && nk != 2 && nicheReadRefOf(ix, ibFnIx) == "" {
      return irBMiss("narrowed read niche kind")
    }
    if !heldAsBox(ib.irVars[v].vRep) {
      return irBMiss("narrowed read niche cell")
    }
    return irBLetTemp(
      b,
      { nrV: o, nrAt: ix, nrKind: nk, nrRow: false },
      ix,
      rep,
    )
  }
  // A read's operand rep is its cell's, which for an atom cell the checker types at a string (a
  // D1752 binding, or a narrowing to one member) differs from the node's. Only a delivery's seated
  // read (`cell`) takes it: its atom arm decodes it, or the id passes to an atom destination.
  if cell && atomAtStr(ib.irVars[v].vRep, rep) { return o }
  // An operand read of an atom cell narrowed to a string-typed set decodes it there.
  if !cell && arm == "local" && atomAtStr(ib.irVars[v].vRep, rep) {
    return atomToStr(b, o, ix, rep)
  }
  // A `K | null` cell narrowed past `null` to one member passes its id as it stands; a decode of
  // it into a non-null string is no delivery (`atomAtStr`).
  if cell && atomNullable(ib.irVars[v].vRep) && repPrim(rep) == "str" {
    return o
  }
  // A read narrowed to `null` whose storage read is its null (`nullReadOwnAt`) is the local:
  // seated, or any read whose destination holds no null of its own, as legacy's past-null arm.
  if (
    arm == "nullread"
    && identReadArmOf(n, ix, ibFnIx, true) == "local"
    && (cell || nullReadOwnAt(ix) == NULL_READ_STORED)
  ) {
    return o
  }
  // Else an operand read narrowed to `null` is its own null at `rep`, as a delivery's is.
  if arm == "nullread" && !cell {
    const nro = nullReadOwnAt(ix)
    if nro >= 0 && nullOwnRepFits(nro, rep) {
      return repTemp(
        b,
        { nuAt: unwrapParen(ix), nuOwn: nro, nuRead: [] },
        ix,
        rep,
      )
    }
  }
  if localReadStored(v, identDeclOf(ix), rep) { return o }
  // A seated read of a box cell on the plain arm is the box legacy's `local.get` writes.
  if cell && arm == "local" && heldAsBox(ib.irVars[v].vRep) { return o }
  // A read of a variable held at a row its read type does not record is the variable as it is,
  // the row `declRowReadTy` reads its fields at (`rowlessReadTyOfVar`).
  if rowlessReadTyOfVar(ix, v) == ib.irVars[v].vTy { return o }
  if (
    holeRetagNoted(ib.irVars[v].vRep, rep, true)
    && exprPrePathWhy(ix, ibFnIx) == ""
  ) {
    return repTemp(b, { rgV: o }, ix, rep)
  }
  return irBMiss("narrowed read")
}

// Whether `null` side `ns`, an assignment of an effect-free value to a name other than tested
// name `t`, gives the same answer written ahead of `t`'s read as after it.
function rightNullStoreCommutes(ns: i32, t: i32): boolean {
  const a = unwrapParen(ns)
  const tr = unwrapParen(t)
  if a < 0 || a >= P.nodes.length || tr < 0 || tr >= P.nodes.length {
    return false
  }
  const an = nodeAt(a)
  const tn = nodeAt(tr)
  if !(an is BinExpr) || an.binOp != "=" || !(tn is Ident) { return false }
  const tgt = unwrapParen(an.binLeft)
  if tgt < 0 || tgt >= P.nodes.length || !(nodeAt(tgt) is Ident) {
    return false
  }
  const td = identDeclOf(tr)
  return td >= 0 && identDeclOf(tgt) != td && exprEffectFree(an.binRight)
}

// Notes node `ix` as a plain field read, kid `k`, the loop prologue may write again
// (`irReadField`).
export function irBNoteFieldReread(ix: i32, k: i32) {
  ib.irReadField[ix] = k
  return 0
}

// Notes node `ix` as a read the lowering writes again whole, as `rhs` `r` (`irReadAgain`).
export function irBNoteReadAgain(ix: i32, r: Rhs) {
  ib.irReadAgain[ix] = r
  return 0
}

// The parameter variable holding wasm local `w`, or -1.
function paramVarAt(w: i32): i32 {
  for v in ib.irParams {
    if ib.irVars[v].vSlot == w { return v }
  }
  return -1
}

// Global `g` (declared at `d`) read at `ix` as the atom, record or container arm (`ba`, `con`) the
// checker narrowed its union box to: `emitUnionBoxPush`'s box read, then legacy's unbox to it.
function globalUnboxRead(
  b: i32[],
  g: i32,
  d: i32,
  ix: i32,
  cellRep: i32,
  rep: i32,
  ba: BoxNarrowArm,
  con: i32,
): Opnd {
  // A record arm's payload is the box cast to the arm (`bnAtom` -1), a container arm's the box
  // unboxed to it (`bnCon`), as a local's read writes them.
  const ak = if ba == "atom" { identUnboxAtomOf(ix, ibFnIx) } else { -1 }
  if ba == "atom" && ak < 0 { return irBMiss("narrowed read dead") }
  const box = globalBoxAt(b, g, d, ix, cellRep)
  if ibMiss != "" { return box }
  const r: RBoxNarrow = {
    bnV: box,
    bnAt: ix,
    bnRep: rep,
    bnAtom: ak,
    bnCon: con,
  }
  // A loop's hoisted receiver reads it again from the global, where the unbox leaves `rep`.
  if ak < 0 || irBUnboxKindRep(ak, rep) == rep {
    ib.irReadAgain[ix] = r
    ib.irReadBoxed[ix] = globalBoxRhs(g, ix)
  }
  const t = if ak >= 0 { unboxAtomTemp(b, r, ix, rep) } else { irBLetTemp(b, r, ix, rep) }
  if t is OVar && box is OVar && t.ov >= 0 && ib.irReadAgain.has(ix) {
    ib.irSkipBase.set(t.ov, box.ov)
  }
  return t
}

// Box read `r` at `ix` unboxed to its atom kind, read at `rep` (`irBUnboxKindRep`).
function unboxAtomTemp(b: i32[], r: RBoxNarrow, ix: i32, rep: i32): Opnd {
  const ur = irBUnboxKindRep(r.bnAtom, rep)
  if ur == rep { return irBLetTemp(b, r, ix, rep) }
  return irBLetTempTy(
    b,
    { bnV: r.bnV, bnAt: ix, bnRep: ur, bnAtom: r.bnAtom, bnCon: -1 },
    ix,
    ur,
    TY_STR,
  )
}

// A temp at `string` for read `ix`, holding `r`, whose node is typed at another type.
export function irBLetStrTemp(b: i32[], r: Rhs, ix: i32): Opnd {
  return irBLetTempTy(b, r, ix, repNodeOfTy(TY_STR), TY_STR)
}

// The rep an unbox to value-atom kind `k` leaves for a read at `rep`: a literal-union member is
// boxed as its string, which the unbox leaves, so an atom `rep` reads at `string`.
export function irBUnboxKindRep(k: i32, rep: i32): i32 {
  if k == 2 && repNodeAt(rep) is RAtom { return repNodeOfTy(TY_STR) }
  return rep
}

// Module global `g` (declared at `d`, cell rep `cellRep`) read at `ix` as the box
// `emitUnionBoxPush` pushes: its cell, recovered where it is not a constant.
function globalBoxAt(b: i32[], g: i32, d: i32, ix: i32, cellRep: i32): Opnd {
  const gm = irGlobalReadMiss(g, ibGlobalCtx())
  if gm != "" { return irBMiss(gm) }
  return irBLetTempTy(
    b,
    globalBoxRhs(g, ix),
    ix,
    cellRep,
    heldTy(scopeTyAt(d, -1)),
  )
}

// The read of global `g`'s box at `ix`, recovered where it is not a constant.
function globalBoxRhs(g: i32, ix: i32): Rhs {
  const r: Rhs = { ggSym: g, ggNonNull: irBGlobalBoxRecovers(ix), ggNn: -1 }
  return r
}

// The box a union global Ident `ix` (declared at `d`) holds, as `emitUnionBoxPush` reads a name
// that is neither a local nor a capture of this frame.
function globalBoxRead(b: i32[], d: i32, ix: i32): Opnd {
  const g = globalBoxSymOf(d, ix)
  if g < 0 { return irBMiss("box receiver") }
  return globalBoxAt(b, g, d, ix, globalRep(g, d))
}

// The module global whose box union Ident `ix` (declared at `d`) reads where it is neither a local
// nor a capture of this frame (`emitUnionBoxPush`'s global arm), else -1.
function globalBoxSymOf(d: i32, ix: i32): i32 {
  if d < 0 || d >= P.nodes.length || ix < 0 || ix >= P.nodes.length {
    return -1
  }
  const n = nodeAt(ix)
  if !(n is Ident) || captureSlotOf(n.identName, ibFnIx) >= 0 { return -1 }
  const g = globalIndexOfSid(sidOfNode(ix))
  if !(nodeAt(d) is LetDecl) || g < 0 || !heldAsBox(globalRep(g, d)) {
    return -1
  }
  return g
}

// The module global a shared read's box receiver `ix` reads, read again for each arm as
// `emitUnionBoxPush` pushes it, else -1 after a named miss.
export function irBGlobalBoxRecv(ix: i32): i32 {
  const d = identDeclOf(ix)
  const g = if d >= 0 && localIndexOf(ibFnIx, ix) < 0 { globalBoxSymOf(d, ix) } else { -1 }
  if g < 0 {
    irBMiss("box receiver")
    return -1
  }
  const gm = irGlobalReadMiss(g, ibGlobalCtx())
  if gm != "" {
    irBMiss(gm)
    return -1
  }
  return g
}

// Whether global box read `ix` recovers its non-null box, as `emitUnionBoxPush` decides.
export function irBGlobalBoxRecovers(ix: i32): boolean {
  return globalNameIsNonConstSid(sidOfNode(ix))
}

// How many `ref.as_non_null` legacy writes after nullable local read `ix`, decided in the read's
// own context: one where a `string | null` read recovers, one where it owes its narrowed rep.
function recoverNonNulls(ix: i32): i32 {
  const a = if localNulStrRecovers(ix, ibFnIx) { 1 } else { 0 }
  return a + (if readOwesNonNullRecover(ix, ibFnIx) { 1 } else { 0 })
}

// How a local's or global's read `ix` of a union-box cell (`cellRep`, discipline 4 included) takes
// the narrowed rep `rep` on legacy's read arm `arm`: "variant" a record arm's payload, "atom" the
// atom `unbox` names, "container" the list or map arm `reflist`/`map` names, "box" the same box at
// a smaller union's rep, else "none".
type BoxNarrowArm = "none" | "variant" | "atom" | "container" | "box"
function boxNarrowArmOf(
  ix: i32,
  cellRep: i32,
  rep: i32,
  arm: IdentReadArm,
): BoxNarrowArm {
  const c = repNodeAt(cellRep)
  if !(c is RBox || c is RNullable && c.rnDisc == 4) { return "none" }
  if (
    repNodeAt(rep) is RRecord
    && narrowedVariantRepIs(narrowedBoxVariantPlain(ix, ibFnIx), rep)
  ) {
    return "variant"
  }
  if arm == "unbox" { return "atom" }
  if (
    arm == "reflist" && repNodeAt(rep) is RList
    || arm == "map" && repNodeAt(rep) is RMap
  ) {
    return "container"
  }
  if heldAsBox(cellRep) && heldAsBox(rep) && arm == "local" { return "box" }
  return "none"
}

// How read `ix` of a cell at rep `cellRep` takes the non-null member `rep` the checker narrowed it
// to, for a local's and a global's read alike: "plain" the cell's read and legacy's recover, "held"
// a read the checker left nullable (an assignment's re-read) held at its non-null type, "miss" any
// other recover, "none" when `cellRep` is not `rep | null`.
type NullNarrowArm = "none" | "plain" | "held" | "miss"
function nullNarrowArmOf(ix: i32, cellRep: i32, rep: i32): NullNarrowArm {
  const c = repNodeAt(cellRep)
  if !(c is RNullable) || c.rnInner != rep { return "none" }
  const ty = heldTy(exprTyOf(ix))
  if repNodeOfTy(ty) == rep { return "plain" }
  const inner = recoveredReadTyOf(ty)
  if inner >= 0 && repNodeOfTy(inner) == rep { return "held" }
  // Any other recover to a rep the read's type is not would mint a temp of the nullable type.
  return "miss"
}

// The rep of global `g`, declared at `d`, noted in `ib`; -1 when it is no scalar.
function globalRep(g: i32, d: i32): i32 {
  const noted = irGlobalRepOf(ib, g)
  if noted >= 0 { return noted }
  const ht = globalHolderTy(d)
  // A holder's cell beside `null` (cell kind `nulstruct`) is the record's nullable.
  const ct = if ht >= 0 && globalCellKind(d) == "nulstruct" { nullableRecordTyOf(ht) } else { ht }
  const r0 = globalTyRep(if ht >= 0 { ct } else { scopeTyAt(d, -1) })
  const r = if ht < 0 { atomCellRep(d, cellAtStorageRow(d, openCellRep(d, r0))) } else { r0 }
  if r >= 0 {
    globalNoteAt(g, d, r)
    if ht >= 0 { ib.irGlobalHeld[g] = true }
  }
  return r
}

// Global `d`'s cell where its type has no rep (a list whose element nothing fixes, a scalar read
// off a value whose type nothing fixed): the valtype its cell kind declares, an `i32` list for
// `list` and `nullist`, as legacy's global section writes it; else `r`.
function openCellRep(d: i32, r: i32): i32 {
  if r >= 0 { return r }
  const k = globalCellKind(d)
  const sc = if k == "i32" { TY_I32 } else if k == "i64" || k == "f64" || k == "f32" { repElemTyOfName(k) } else { -1 }
  if sc >= 0 { return globalTyRep(sc) }
  if k != "list" && k != "nullist" { return r }
  const lt = repElemTyOfName("i32[]")
  if lt < 0 { return r }
  return globalTyRep(if k == "nullist" { nullableTyOf(lt) } else { lt })
}

// Global `d`'s cell where the global section declares an i32 cell for a string binding whose
// initializer is an assignment to an atom cell: that atom, the id the assignment yields; else `r`.
function atomCellRep(d: i32, r: i32): i32 {
  if repPrim(r) != "str" || globalCellKind(d) != "i32" { return r }
  const g = nodeAt(d)
  if !(g is LetDecl) || g.letInit < 0 { return r }
  const ai = nodeAt(unwrapParen(g.letInit))
  if !(ai is BinExpr) || ai.binOp != "=" { return r }
  // A `K | null` place's assignment value is the member written, the atom inside its niche.
  const at = atomOfIdRep(repNodeOfTy(heldTy(exprTyOf(ai.binLeft))))
  return if at >= 0 { at } else { r }
}

// A record global whose checked rep `r` has no struct heap is held at its storage row's rep
// (`letBindTy`) where that has one, as its initializer stores it (D17087); else `r`.
function cellAtStorageRow(d: i32, r: i32): i32 {
  if !(repNodeAt(r) is RRecord) { return r }
  const key = "g" + i32ToStr(d) + ":" + i32ToStr(r) + ":" + i32ToStr(repTyOf(r))
  const memo = cellHeapMemo[key] ?? -2
  if memo != -2 { return memo }
  const sr = globalTyRep(letBindTy(d, -1))
  const at = if (sr < 0
    || sr == r
    || !(repNodeAt(sr) is RRecord)
    || recHeapOf(r) >= 0
    || recHeapOf(sr) < 0) { r } else { sr }
  cellHeapMemo[key] = at
  return at
}

// The type global `d`'s cell holds: the record a holding binding holds whole, or the one member
// of it a binding holds (`globalHolderTy`), else its own type.
function globalHeldTy(d: i32): i32 {
  const ht = globalHolderTy(d)
  return if ht >= 0 { ht } else { scopeTyAt(d, -1) }
}

// The type a module binding `d` holds a returned record at, as `irBDeclVar` holds a local's: the
// record whole (`holderRecordTy`, the struct legacy's `letCellKindGo` gives its cell), or the one
// closed member a binding holds (`holderMemberTy`); else -1.
function globalHolderTy(d: i32): i32 {
  const ht = if elabHasHolderRecords() { holderRecordTy(d, -1) } else { -1 }
  if ht >= 0 { return ht }
  const hm = if elabHasRetRecords() || bundleAnyNoted() { holderMemberTy(d, -1) } else { -1 }
  return if hm >= 0 && !irTyOpen(hm) { hm } else { -1 }
}

// Notes global `g`'s rep `rep` in `ib`, with its declaration `d`'s storage-row type
// (`letBindTy`), which the verifier checks a read off the checked type's rep against.
function globalNoteAt(g: i32, d: i32, rep: i32) {
  const st = globalStoreTy(d, rep)
  if irGlobalRepOf(ib, g) < 0 {
    irGlobalStoreNote(ib, g, st)
  } else if irGlobalStoreTyOf(ib, g) != st {
    // One global has one declaration, so a second storage row for it is a builder fault.
    irBMiss("global storage row disagrees")
  }
  irGlobalNote(ib, g, rep)
  return 0
}

// The storage-row type of global `d` noted at rep `rep`: its binding's (`letBindTy`), or where
// that is a record no struct row records, the row legacy declares the cell at, `rep`'s record, or
// the list the global section declares the cell at.
function globalStoreTy(d: i32, rep: i32): i32 {
  const st = letBindTy(d, -1)
  const ht = heldTy(st)
  // An atom-assignment cell is stored at its atom (`atomCellRep`).
  if (
    repNodeAt(rep) is RAtom
    && atomCellRep(d, repNodeOfTy(ht)) == rep
    && repTyOf(rep) >= 0
  ) {
    return repTyOf(rep)
  }
  // A list cell declared at the instance list its initializer built is stored at that list.
  if (
    repNodeAt(rep) is RList
    && repNodeOfTy(ht) != rep
    && repTyOf(rep) >= 0
    && cellDeclStores(d, repNodeOfTy(ht), rep)
  ) {
    return repTyOf(rep)
  }
  // A cell whose type has no rep (`openCellRep`) is stored at its rep's type.
  if globalTyRep(ht) < 0 && repTyOf(rep) >= 0 { return repTyOf(rep) }
  const rt = rowlessStoredTy(ht, repNodeOfTy(ht), repTyOf(rep))
  return if rt >= 0 { rt } else { st }
}

// The rep a global held at type `ty` takes; -1 when it is no scalar.
function globalTyRep(ty: i32): i32 {
  const r = repNodeOfTy(ty)
  if isVoidTy(ty) || !valueRep(r, ty) { return -1 }
  return r
}

// The result type of the function at `fnStmts` slot `pos` (declared at `d`, annotated by `ann`):
// its annotation, else its recorded result, which legacy's functype names, else the checker's;
// either held at the struct row legacy declares it at where that row's rep differs (`retDeclRowTy`).
function resultTy(pos: i32, ann: i32, d: i32): i32 {
  if ann >= 0 {
    const at = nodeTyAt(ann, d)
    const adt = retDeclRowTy(pos, at)
    return resultFrameTy(pos, if adt >= 0 { adt } else { at })
  }
  const rec = if pos >= 0 && pos < fRecRetTy.length { fRecRetTy[pos] } else { -1 }
  const t = if rec >= 0 { rec } else { fnCheckedRetTy(pos) }
  // A function legacy returns a bundle record from returns that record (`fnBundleRetSigs`),
  // whether its result is recorded or checked.
  const bs = if pos >= 0 && pos < fnStmts.length && fnRetHeldAsBundle(pos, t) { fnBundleRetSigs(pos) } else { [] }
  if bs.length > 0 { return bundleRecordTyOf(bs) }
  const dt = retDeclRowTy(pos, t)
  return resultFrameTy(pos, if dt >= 0 { dt } else { t })
}

// Result type `t` of `fnStmts` slot `pos`, or, where `t` is open or has no value rep, the one
// legacy's declared result descriptor names alone (`resultDescTy`).
function resultFrameTy(pos: i32, t: i32): i32 {
  if t < 0 || isVoidTy(t) { return t }
  const r = repNodeOfTy(t)
  if valueRep(r, t) && !irTyHeldOpen(t, r) { return t }
  const dt = resultDescTy(pos)
  return if dt >= 0 { dt } else { t }
}

// The type `fnStmts` slot `pos`'s declared result descriptor (`fRetKind`, `fRetStructIdx`) names
// alone (`repDescTy`), or -1.
function resultDescTy(pos: i32): i32 {
  if pos < 0 || pos >= fRetKind.length || pos >= fRetStructIdx.length {
    return -1
  }
  return repDescTy(repDescRet(fRetKind[pos], fRetStructIdx[pos], ""))
}

// The record type of the struct row legacy declares `fnStmts` slot `pos`'s inferred result at
// (`fRetKind`, `fRetStructIdx`) where result type `t` is held at another rep that is no twin of
// the row's, or -1: the row's declared type (`declRowTy`), or its recorded one where that is open
// only where it stores closed.
function retDeclRowTy(pos: i32, t: i32): i32 {
  if pos < 0 || pos >= fRetKind.length || pos >= fRetStructIdx.length {
    return -1
  }
  const si = fRetStructIdx[pos]
  if fRetKind[pos] != "struct" || si < 0 || si >= sTyIx.length { return -1 }
  const dt = declRowTy(si)
  const st = sTyIx[si]
  const rt = if dt >= 0 { dt } else if st >= 0 && rowTyBuildsAt(st, si) { st } else { -1 }
  if rt < 0 || repNodeOfTy(rt) == repNodeOfTy(t) { return -1 }
  // A result whose type is the row's own keeps its rep where that is a twin of the row's.
  if (
    repRowOfTyStruct(t, repScanLim()) == si
    && recTwinRep(repNodeOfTy(t), repNodeOfTy(rt))
  ) {
    return -1
  }
  return rt
}

// Whether record rep `src` is `dst` with at most some fields, at any depth, widened to their
// nullable: the twin a retag carries as it stands.
function recTwinRep(src: i32, dst: i32): boolean {
  if src == dst { return true }
  const a = repNodeAt(src)
  const d = repNodeAt(dst)
  if d is RNullable && refNullable(dst) && recTwinRep(src, d.rnInner) {
    return true
  }
  if !(a is RRecord) || !(d is RRecord) || a.rrVariant != d.rrVariant {
    return false
  }
  if a.rrFields.length != d.rrFields.length { return false }
  let i = 0
  while i < a.rrFields.length {
    if !recTwinRep(a.rrFields[i], d.rrFields[i]) { return false }
    i = i + 1
  }
  return true
}

// The result rep of that function. Legacy's voidness (`fRetVoid`) decides no value, as its
// functype does; the tree gives `void` an i32 leaf, so no value is `never`'s rep.
function resultRep(pos: i32, ann: i32, d: i32): i32 {
  if pos >= 0 && pos < fRetVoid.length && fRetVoid[pos] == 1 {
    return repNodeOfTy(TY_NEVER)
  }
  const rt = resultTy(pos, ann, d)
  return if isVoidTy(rt) { repNodeOfTy(TY_NEVER) } else { repNodeOfTy(rt) }
}

// The parameter and result reps of `fnStmts` slot `pos`, noted in `ib`; false when one is not
// a primitive or void rep.
function calleeSig(pos: i32): boolean {
  if pos < 0 || pos >= fnStmts.length { return false }
  const d = fnStmts[pos]
  const fn = nodeAt(d)
  if !(fn is FuncDecl) { return false }
  const ps: i32[] = []
  for p in fn.fnParams {
    const pt = calleeParamTy(p, d)
    const r = repNodeOfTy(pt)
    if !valueRep(r, pt) { return false }
    ps.push(r)
  }
  const rr = resultRep(pos, fn.fnRet, d)
  if !(valueRep(rr, resultTy(pos, fn.fnRet, d)) || repIsNoValue(rr)) {
    return false
  }
  irSigNote(ib, pos, ps, rr)
  return true
}

// The first of arguments `args` typed `never`, or -1.
function neverArgOf(args: i32[]): i32 {
  let k = 0
  while k < args.length {
    if heldTy(exprTyOf(args[k])) == TY_NEVER { return k }
    k = k + 1
  }
  return -1
}

// Call `ix` whose argument `nv` of `args` never returns, as legacy writes it: the arguments before
// it (effect-free here, so none is written), that argument's call as a statement, then the call's
// `unreachable` (`RDeadNever`).
function deadCallAfter(b: i32[], args: i32[], nv: i32, ix: i32): Rhs {
  let k = 0
  while k < nv {
    if !exprEffectFree(args[k]) { return missRhs("dead call argument before") }
    k = k + 1
  }
  const ai = unwrapParen(args[nv])
  const an = if ai >= 0 && ai < P.nodes.length { nodeAt(ai) } else { null }
  if !(an is Call) { return missRhs("dead call argument") }
  const r = callRhs(b, an, ai)
  if ibMiss != "" { return missRhs(ibMiss) }
  irBNode(b, { efRhs: r }, -1, ibNoValue, ai)
  const d: Rhs = { dnAt: ix, dnPad: callEndsNever(ix) }
  return d
}

// Whether slot `pos` holds declaration `d`, or the instance the monomorphizer minted from generic
// `d`: a first instance takes the template's own slot (`monoOrigNode` keeps the original), a later
// one a slot of its own (`monoInstFe`, from the template's slot `monoInstOrig`).
function callTargetIs(pos: i32, d: i32): boolean {
  if pos < 0 || pos >= fnStmts.length { return false }
  if fnStmts[pos] == d { return true }
  if pos < monoGen.length && monoGen[pos] == 1 && pos < monoOrigNode.length {
    return monoOrigNode[pos] == d
  }
  let k = 0
  while k < monoInstFe.length && k < monoInstOrig.length {
    if monoInstFe[k] == pos {
      const o = monoInstOrig[k]
      return o >= 0 && o < monoOrigNode.length && monoOrigNode[o] == d
    }
    k = k + 1
  }
  return false
}

// Render call `c`'s template hole that this instance pins to a string or atom, as that hole's
// string: `emitCallCore` writes it before any call route (`emitStrValue`).
function tplHoleStr(b: i32[], c: Call): Opnd {
  const h = tplStrHoleOf(c, ibFnIx)
  const v = if exprIsLitAtom(h, ibFnIx) { deliverStr(b, h) } else { irBExpr(b, h) }
  if ibMiss != "" { return v }
  if repPrim(irBOpRep(v)) != "str" {
    return irBMiss("template hole pinned rep")
  }
  return v
}

// A direct call `ix` of a declared, capture-free function by name; its arguments by position.
// The test harness's emit-refusal hook (`--test-emit-refusal`), raised where legacy's call arm
// raises it: at the call, or unanchored for the declaration-anchored twin.
function testEmitRefused(cf: Ident, ix: i32): boolean {
  if testHookNamed(cf.identName, "__vl_test_emit_refusal__") {
    if emitSoftFail { emitFailAt(TEST_EMIT_REFUSAL_MSG, ix) }
    return true
  }
  if testHookNamed(cf.identName, "__vl_test_emit_refusal_decl__") {
    if emitSoftFail { emitFail(TEST_EMIT_REFUSAL_MSG) }
    return true
  }
  return false
}

function callRhs(b: i32[], c: Call, ix: i32): Rhs {
  if c.callFn < 0 { return missRhs("named call") }
  const cf = nodeAt(c.callFn)
  if gTestEmitRefusal != 0 && cf is Ident && testEmitRefused(cf, ix) {
    return missRhs("test emit refusal")
  }
  // Named arguments reach only a declared function's direct call, which binds them to its
  // parameters (`orderedDirectArgs`).
  if hasNamedArgs(c.callArgNames) { return namedCallRhs(b, c, ix) }
  if cf is Member { return methodRhs(b, c, cf, ix) }
  // A call through any other closure expression is a plain closure call where legacy's is.
  if !(cf is Ident) {
    // A place holding a returned record whole is called at its member, as `emitHolderCall` reads it.
    if holderCallSigs(ix, ibFnIx).length > 0 { return holderCallRhs(b, c, ix) }
    if callRefPlainKey(ix, ibFnIx) == "" { callSplitRefuse(c, ix) }
    if callRefPlainKey(ix, ibFnIx) == "" { return missRhs("indirect call") }
    // A call straight off a returned record's member, as `emitCallCore` sends it to `emitCallRef`.
    const rx = unwrapParen(c.callFn)
    if !exprIsClosure(c.callFn, ibFnIx) && callResultMemberTy(rx, ibFnIx) >= 0 {
      return resultMemberCallRhs(b, c, ix, rx)
    }
    return closureCallRhs(b, c, ix)
  }
  const d = identDeclOf(c.callFn)
  // A call through a `const` holding a returned record whole picks its member first, as
  // `emitHolderCall` routes it.
  if holderCallSigs(ix, ibFnIx).length > 0 { return holderCallRhs(b, c, ix) }
  if arrCopyCallNamed(c, ibFnIx) { return missRhs("list copy value") }
  if memAccessCallNamed(c, ibFnIx) { return memAccessRhs(b, c, ix) }
  if memOpCallNamed(c, ibFnIx) { return memOpRhs(b, c, ix) }
  if simdCallNamed(c, ibFnIx) { return simdRhs(b, c, ix) }
  if atomicCallNamed(c, ibFnIx) { return atomicRhs(b, c, ix) }
  if truncSatCallNamed(c, ibFnIx) { return truncSatRhs(b, c, ix) }
  if cf.identName == "__log__" && !identNameIsUserBound(c.callFn, ibFnIx) {
    return logCallRhs(b, c, ix)
  }
  if hostCallNamed(c, ibFnIx) { return hostCallRhs(b, c, ix) }
  if d < 0 && strFromBytesCallNamed(c, ibFnIx) {
    return strFromBytesRhs(b, c, ix)
  }
  if d < 0 && trapCallNamed(c, ibFnIx) && tplStrHoleOf(c, ibFnIx) < 0 {
    return trapCallRhs(b, c, ix)
  }
  if d < 0 && numIntrCallReached(c, cf, ibFnIx) && tplStrHoleOf(c, ibFnIx) < 0 {
    if cf.identName == "fromCodePoint" || cf.identName == "fromCodePoints" {
      return fromCpRhs(b, c, cf, ix)
    }
    return numIntrRhs(b, c, cf, ix)
  }
  // A binding holding a lambda-lifted function is a direct call of it; any other, a closure's.
  const lf = if d >= 0 && (nodeAt(d) is LetDecl || nodeAt(d) is Param) { cloLiftCalleeOf(c.callFn, ibFnIx) } else { -1 }
  if lf < 0 && d >= 0 && (nodeAt(d) is LetDecl || nodeAt(d) is Param) {
    if bundleParamOfRead(c.callFn, ibFnIx) >= 0 {
      return bundleCallRhs(b, c, ix)
    }
    return closureCallRhs(b, c, ix)
  }
  // A loop variable holding a function value is a closure call too.
  if d >= 0 && nodeAt(d) is LoopVar { return closureCallRhs(b, c, ix) }
  if lf < 0 && (d < 0 || !(nodeAt(d) is FuncDecl)) {
    callSplitRefuse(c, ix)
    return missRhs("call of a non-declaration")
  }
  // The function `emitCallCoreUserFn` calls, unless a binding of the name routes it to a closure.
  const pos = if lf >= 0 { lf } else { userFnCallTarget(c, cf, ibFnIx) }
  if lf < 0 && userFnCallRoutesRef(c, cf, ibFnIx, pos) {
    return missRhs("call routed through a closure")
  }
  if pos < 0 || pos >= fnStmts.length { return missRhs("call target") }
  if lf >= 0 && directCallInstanceArgMisfit(c.callArgs, lf, ibFnIx) >= 0 {
    return missRhs("binding call misfit")
  }
  return directCallAt(b, c, ix, pos)
}

// Call `c` with named arguments, as `emitCallCoreUserFn` sends it to `emitDirectCall`: a name
// that resolves to a declared function no binding routes to a closure; every other is a miss.
function namedCallRhs(b: i32[], c: Call, ix: i32): Rhs {
  if c.callFn < 0 || c.callFn >= P.nodes.length { return missRhs("named call") }
  const cf = nodeAt(c.callFn)
  if !(cf is Ident) { return missRhs("named call") }
  const d = identDeclOf(c.callFn)
  if (
    d < 0
    || !(nodeAt(d) is FuncDecl)
    || holderCallSigs(ix, ibFnIx).length > 0
  ) {
    return missRhs("named call")
  }
  if cloLiftCalleeOf(c.callFn, ibFnIx) >= 0 { return missRhs("named call") }
  const pos = userFnCallTarget(c, cf, ibFnIx)
  if (
    pos < 0
    || pos >= fnStmts.length
    || userFnCallRoutesRef(c, cf, ibFnIx, pos)
  ) {
    return missRhs("named call")
  }
  return directCallAt(b, c, ix, pos)
}

// The lambda literal `arg` handed to bundle parameter `par`, as `emitBundleArg` builds it, or the
// function read `arg` (`fnRead`), as `emitBundleReadArg` does, through `bundleRecBuild`.
function bundleArgRec(b: i32[], arg: i32, par: i32, fnRead: boolean): Opnd {
  const sigs = bundleSigsOfParam(par)
  const p = nodeAt(par)
  const pt = if p is Param && p.parType >= 0 { nodeTyAt(p.parType, -1) } else { -1 }
  if fnRead && pt < 0 { return irBMiss("bundle argument read type") }
  const si = if fnRead { repRowOfTyStruct(pt, repScanLim()) } else { paramStructIdxOf(par) }
  const rty = if fnRead { pt } else { bundleRecordTyOf(sigs) }
  return bundleRecBuild(b, arg, sigs, si, rty, fnRead)
}

// A choice `if c { f } else { g }` handed to bundle parameter `par`, as `emitBundleChoiceArg`
// writes it: at the row of the parameter's annotated type, each arm's function read built as
// that record, joined by an `if` opening at the row's non-null reference.
function bundleChoiceArg(b: i32[], arg: i32, par: i32): Opnd {
  const pt = bundleChoiceTyOf(par)
  if pt < 0 { return irBMiss("bundle argument read type") }
  const si = repRowOfTyStruct(pt, repScanLim())
  return bundleChoiceRec(b, arg, bundleSigsOfParam(par), si, pt)
}

// One arm of `bundleChoiceArg`: a function read's record, a one-statement block's, or a nested
// choice's, joined at row `si`.
function bundleChoiceRec(
  b: i32[],
  arg: i32,
  sigs: i32[],
  si: i32,
  rty: i32,
): Opnd {
  const x = unwrapParen(arg)
  if x < 0 || x >= P.nodes.length { return irBMiss("bundle choice arm") }
  const n = nodeAt(x)
  if n is Ident { return bundleRecBuild(b, x, sigs, si, rty, true) }
  if n is Block && n.blkStmts.length == 1 {
    return bundleChoiceRec(b, n.blkStmts[0], sigs, si, rty)
  }
  if !(n is IfStmt) || n.ifElse < 0 { return irBMiss("bundle choice arm") }
  const cat = b.length
  const c = irBExpr(b, n.ifCond)
  if ibMiss != "" || irBOpRep(c) != ibBool { return irBMiss("if condition") }
  if bareConstIs(c, n.ifCond, b, cat) { return irBMiss("decided is condition") }
  const rep = repNodeOfTy(rty)
  const t = irVarNew(ib, rep, rty, "local", -1)
  const thenB: i32[] = []
  const tv = bundleChoiceRec(thenB, n.ifThen, sigs, si, rty)
  if ibMiss != "" { return tv }
  irBNode(thenB, { asDst: t, asSrc: tv }, -1, ibNoValue, n.ifThen)
  const elseB: i32[] = []
  const ev = bundleChoiceRec(elseB, n.ifElse, sigs, si, rty)
  if ibMiss != "" { return ev }
  irBNode(elseB, { asDst: t, asSrc: ev }, -1, ibNoValue, n.ifElse)
  irBNode(
    b,
    {
      siCond: c,
      siThen: thenB,
      siElse: elseB,
      siOut: t,
      siElseKw: true,
      siJoin: { rjKind: "struct", rjSlot: si },
      siJoinNul: false,
      siAtDst: false,
    },
    rty,
    rep,
    x,
  )
  const o: Opnd = { ov: t }
  return o
}

// The record of closures at struct row `si`, of type `rty`, holding `sigs`, built from `arg`: the
// closure of each signature's instance (`monoBundleFe`, or `monoBundleReadFe` for a function read)
// in the row's field order, then the record, as `emitBundleArg` and `emitBundleReadArg` write it.
function bundleRecBuild(
  b: i32[],
  arg: i32,
  sigs: i32[],
  si: i32,
  rty: i32,
  fnRead: boolean,
): Opnd {
  if si < 0 || si >= sFieldCount.length || si >= sFieldStart.length {
    return irBMiss("bundle argument row")
  }
  const rep = repNodeOfTy(rty)
  const ks = repNodeKids(rep)
  if !(repNodeAt(rep) is RRecord) || ks.length != sFieldCount[si] {
    return irBMiss("bundle argument rep")
  }
  const fields: Opnd[] = []
  for _k in ks { fields.push({ ov: -1 }) }
  const layout: i32[] = []
  let fi = 0
  while fi < sFieldCount[si] {
    const nm = sFieldNames[sFieldStart[si] + fi]
    let k = 0
    while k < sigs.length && nm != "c" + i32ToStr(k) { k = k + 1 }
    const fe = if k >= sigs.length { -1 } else if fnRead { monoBundleReadFe(arg, ibFnIx, sigs[k]) } else { monoBundleFe(arg, ibFnIx, sigs, k) }
    const kid = repRecordKidOf(rep, rty, nm)
    if (
      fe < 0
      || kid < 0
      || kid >= ks.length
      || repNodeOfTy(sigs[k]) != ks[kid]
    ) {
      return irBMiss("bundle argument closure")
    }
    if closureValueCoreWhy(fe) != "" {
      return irBMiss("bundle argument closure refused")
    }
    const env: Opnd[] = if fnEnvIdxOf(fe) >= 0 { cloEnvOf(b, fe, arg) } else { [] }
    if ibMiss != "" { return irBMiss(ibMiss) }
    fields[kid] = irBLetTempTy(
      b,
      { mcFn: fe, mcEnv: env, mcAt: arg },
      arg,
      ks[kid],
      sigs[k],
    )
    layout.push(kid)
    fi = fi + 1
  }
  const r: Rhs = {
    mrFields: fields,
    mrLayout: layout,
    mrSrc: [],
    mrAt: arg,
    mrRow: si,
    mrVariant: false,
    mrBuiltRow: si,
    mrSet: false,
  }
  return irBLetTempTy(b, r, arg, rep, rty)
}

// Direct call `ix` of the function at `fnStmts` slot `pos`: its environment, captures and
// arguments as `emitDirectCall` writes them, or a captured call's closure.
function directCallAt(b: i32[], c: Call, ix: i32, pos: i32): Rhs {
  const inst = fnStmts[pos]
  // The arguments in parameter order, as `emitDirectCall` binds a named call's.
  const named = hasNamedArgs(c.callArgNames)
  const cargs = if named { orderedDirectArgs(ix, pos) } else { c.callArgs }
  for a in cargs {
    if a < 0 { return missRhs("named call") }
  }
  // A template hole this instance pins to a string or atom is written by legacy without the call.
  if tplStrHoleOf(c, ibFnIx) >= 0 { return missRhs("template hole pinned") }
  if !calleeSig(pos) {
    // An argument that never returns ends the call: a never-typed parameter has no rep to sign.
    const nv = neverArgOf(cargs)
    if nv >= 0 { return deadCallAfter(b, cargs, nv, ix) }
    return missRhs("callee signature")
  }
  // A callee with a hidden environment parameter takes a null one before its arguments, and a
  // lifted one its captures next; one that captures through its environment stays legacy's.
  const env = envSlotShift(inst) > 0
  const caps = if cloLifted(pos) { liftCaps(b, pos, ix) } else { [] }
  if ibMiss != "" { return missRhs("callee captures") }
  // A lifted callee that assigns a capture hands it back after its result (D3664).
  const wb = liftWriteBacks(pos, caps)
  if ibMiss != "" { return missRhs(ibMiss) }
  if env && !cloLifted(pos) && captureCountOf(pos) > 0 {
    if named { return missRhs("named call") }
    return capturedCallRhs(b, c, ix, pos)
  }
  if envSlotShift(inst) > 1 + caps.length {
    return missRhs("callee environment")
  }
  if lowMemFoldsCallee(pos) { return missRhs("low-memory accessor") }
  const callee = nodeAt(inst)
  const args: Opnd[] = []
  if callee is FuncDecl {
    if callee.fnParams.length != cargs.length {
      return missRhs("argument count")
    }
    const starts: i32[] = []
    let i = 0
    while i < cargs.length {
      const at = b.length
      starts.push(at)
      // A bundle parameter takes a record of closures, on legacy's arm (`bundleArgArmOf`): a
      // lambda literal's built per signature, or a record read as it is.
      if bundleSigsOfParam(callee.fnParams[i]).length > 0 {
        const barm = bundleArgArmOf(callee.fnParams[i], cargs[i], ibFnIx)
        if barm == "lambda" || barm == "fnRead" {
          const bt = bundleHeldTy(
            callee.fnParams[i],
            scopeTyAt(callee.fnParams[i], inst),
          )
          if !(repNodeAt(repNodeOfTy(bt)) is RRecord) {
            return missRhs("bundle argument closed parameter")
          }
          const ba = bundleArgRec(
            b,
            cargs[i],
            callee.fnParams[i],
            barm == "fnRead",
          )
          if ibMiss != "" { return missRhs(ibMiss) }
          args.push(ba)
          i = i + 1
          continue
        }
        if barm == "choice" {
          const ba = bundleChoiceArg(b, cargs[i], callee.fnParams[i])
          if ibMiss != "" { return missRhs(ibMiss) }
          args.push(ba)
          i = i + 1
          continue
        }
        // A holder's record, or a plain argument, is delivered below; only a member read remains.
        if barm == "member" { return missRhs("bundle argument member") }
      }
      // An argument is delivered at its parameter's rep in the callee's signature (`calleeSig`).
      const pt = calleeParamTy(callee.fnParams[i], inst)
      const pr = repNodeOfTy(pt)
      // A bundle read handed to a parameter of one closure is the member legacy picks off its record
      // (`bundleArgArmOf`'s member arm, `bundleHandMemberAt`); none picked is legacy's refusal.
      if (
        repNodeAt(pr) is RClosure
        && (bundleAnyNoted() || elabHasHolderRecords())
        && nodeAt(unwrapParen(cargs[i])) is Ident
        && bundleArgArmOf(callee.fnParams[i], cargs[i], ibFnIx) == "member"
      ) {
        if (
          bundleHandMemberAt(ix, i, cargs[i], ibFnIx) < 0
          || !(repNodeAt(pr) is RClosure)
        ) {
          return missRhs("bundle argument member")
        }
        const rec = exprAt(b, cargs[i], false)
        if ibMiss != "" { return missRhs("argument") }
        if !(repNodeAt(irBOpRep(rec)) is RRecord) {
          return missRhs("bundle argument member")
        }
        args.push(
          irBLetTempTy(
            b,
            { hpV: rec, hpAt: ix, hpArg: cargs[i], hpI: i },
            cargs[i],
            pr,
            pt,
          ),
        )
        i = i + 1
        continue
      }
      // An argument the checker records no box at is boxed at its parameter's union, legacy's
      // direct-call floor (`directArgUnionTyOf`).
      const fl = if heldAsBox(pr) && !boxOwedAt(cargs[i], ibFnIx) { directArgUnionTyOf(pos, i) } else { -1 }
      const fu = if fl >= 0 && repNodeOfTy(fl) == pr { fl } else { -1 }
      // A struct literal legacy builds at a row of its parameter's row's heap (`paramStructIdxOf`)
      // is built at the parameter's rep; a `null` literal at the floor is its union's null box.
      const lt = if repNodeAt(pr) is RRecord { objLitTwinTyAtRow(cargs[i], pr, pt, paramStructIdxOf(callee.fnParams[i])) } else { -1 }
      const a = if lt >= 0 { objLitAt(
        b,
        unwrapParen(cargs[i]),
        pr,
        lt,
        objLitLayoutRowOf(unwrapParen(cargs[i]), ibFnIx),
        false,
      ) } else if fu >= 0 && nodeAt(unwrapParen(cargs[i])) is NullLit { boxTempIn(b, { oiRep: ibNoValue, oiBits: 0 }, cargs[i], pr, -1, fu) } else { deliver(b, cargs[i], pr, fu) }
      if ibMiss != "" { return missRhs("argument") }
      if i > 0 && !irBStageLeads(b, at, starts, args, cargs) {
        return missRhs("short-circuit argument after another")
      }
      // A value its parameter takes as it stands or retagged is converted first (`irConvert`).
      const ra = if convertKindOf(a, pr, pt, cargs[i]) >= 0 { irConvert(b, a, pr, pt, cargs[i]) } else { a }
      // A union parameter boxes the argument as legacy's `emitUnionBoxOwed` does (the floor); a
      // reference its parameter's valtype holds as it stands is passed as is (`repStoresAs`).
      const fa0 = if fu >= 0 && irBOpRep(ra) != pr { boxTempIn(b, ra, cargs[i], pr, -1, fu) } else { ra }
      if ibMiss != "" { return missRhs(ibMiss) }
      const fa = irConvert(b, fa0, pr, pt, cargs[i])
      if ibMiss != "" { return missRhs(ibMiss) }
      args.push(fa)
      i = i + 1
    }
  }
  const r: Rhs = {
    caCallee: pos,
    caArgs: args,
    caNever: callEndsNever(ix),
    caEnv: env,
    caCaps: caps,
    caWb: wb,
  }
  return r
}

// Whether `fnStmts` slot `pos` is a function whose every returned value is a bare `null` (D1567).
function nulNoneCallee(pos: i32): boolean {
  return pos >= 0 && pos < fRetKind.length && fRetKind[pos] == "nulnone"
}

// Direct call `rhs` of such a function, where its null is the sentinel `own` names: the call run
// and dropped, then that sentinel at the call's context rep, as `emitDirectCallTail` writes it.
function nulNoneCallSentinel(b: i32[], rhs: RCall, ix: i32, own: i32): Opnd {
  const dr = repNodeOfTy(heldTy(ctxTyAt(ix, ibFnIx)))
  if !nullOwnRepFits(own, dr) { return irBMiss("null-typed call sentinel rep") }
  const si = irSigOf(ib, rhs.caCallee)
  if si < 0 { return irBMiss("null-typed call signature") }
  const sr = ib.irSigRet[si]
  const cv = irBLetTempTy(b, rhs, ix, sr, repTyOf(sr))
  irBNode(b, { dpV: cv }, -1, ibNoValue, ix)
  return repTemp(b, { nuAt: ix, nuOwn: own, nuRead: [] }, ix, dr)
}

// Whether a ref-niche nullable `r` (`T | null` held as a nullable ref) holds a value of rep `v`
// as it stands: `v` is its inner rep, or is stored at its inner rep's valtype.
function nicheRefTakes(r: i32, v: i32): boolean {
  const n = repNodeAt(r)
  return n is RNullable
    && n.rnDisc == 1
    && (n.rnInner == v || repStoresAs(n.rnInner, v))
}

// The parameter variables lifted function `pos` hands back after its result: each capture it
// assigns, at the slot legacy's exits read (`fbSeedRetExtra`, `1 +` its capture index).
function liftRetExtra(pos: i32): i32[] {
  const out: i32[] = []
  const n = cloLiftWriteCount(pos)
  if n == 0 { return out }
  const names = captureNamesOf(pos)
  let j = 0
  while j < n {
    const k = cloLiftWriteCapAt(pos, j)
    const v = if k >= 0 && k < names.length { liftCapVar(pos, names[k], -1) } else { -1 }
    if v < 0 || ib.irVars[v].vSlot != 1 + k {
      irBMiss("lifted extra result")
      return out
    }
    out.push(v)
    j = j + 1
  }
  return out
}

// The parameter variable of capture `name` that this lifted frame assigns at legacy's local `w`
// (`cloLiftWriteSlot`), or -1 where `name` is no such capture.
function liftWriteVar(name: string, w: i32): i32 {
  const self = fnStmtsPosOf(ibFnIx)
  if !cloLifted(self) || cloLiftWriteSlot(self, name) != w { return -1 }
  const v = liftCapVar(self, name, -1)
  return if v >= 0 && ib.irVars[v].vSlot == w { v } else { -1 }
}

// The variables lifted callee `pos` hands its assigned captures back to, in its result order: each
// the binding its capture is passed from (`caps`), which holds legacy's declared or parameter slot.
function liftWriteBacks(pos: i32, caps: Opnd[]): i32[] {
  const out: i32[] = []
  let j = 0
  while j < cloLiftWriteCount(pos) {
    const k = cloLiftWriteCapAt(pos, j)
    const o = if k >= 0 && k < caps.length { caps[k] } else { null }
    if !(o is OVar) || o.ov < 0 || ib.irVars[o.ov].vKind == "temp" {
      irBMiss("callee write-back operand")
      return out
    }
    out.push(o.ov)
    j = j + 1
  }
  return out
}

// The `let` or `const` of the function being built that capture `name` of lifted function `pos`
// reads, found at a read of it in the lifted body; -1 for none, or for a binding of another frame.
function liftCapDecl(pos: i32, name: string): i32 {
  const key = i32ToStr(pos) + "|" + name
  const known = ibLiftCapDecl[key] ?? -2
  if known != -2 { return known }
  let found = -1
  const todo: i32[] = [fnStmts[pos]]
  // A capture the body does not read is carried for a nested function it names that captures it;
  // that function's body is walked too, once, unless the lifted function reads it through its cell.
  const seen: {[i32]: boolean} = Map()
  while todo.length > 0 && found < 0 {
    const i = todo.pop() ?? -1
    const n = if i >= 0 && i < P.nodes.length { nodeAt(i) } else { null }
    if n is Ident {
      const d = identDeclOf(i)
      const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { null }
      if n.identName == name && dn is LetDecl { found = d }
      if dn is FuncDecl && !(seen[d] ?? false) {
        seen[d] = true
        const fp = fnStmtsPosOf(d)
        if (
          fp >= 0
          && strListHas(captureNamesOf(fp), name)
          && !strListHas(captureNamesOf(pos), capCellName(fp))
        ) {
          todo.push(d)
        }
      }
    }
    if i >= 0 && i < P.nodes.length { nodeChildrenPush(i, todo) }
  }
  // A read in a cloned instance's nested function can still name its template's binding; the
  // frame's own binding is the one clone minted from it (`declOrigOf`). Two such clones miss.
  if found >= 0 && !ownBinding(found) {
    const twin = ibOwnByOrig[found] ?? -1
    if twin == -2 { irBMiss("capture instance twin ambiguous") }
    found = if twin >= 0 { twin } else { -1 }
  }
  ibLiftCapDecl[key] = found
  return found
}

// Whether declaration `d` stands in the body of the function being built, outside any function
// nested in it. The set is built once per function.
function ownBinding(d: i32): boolean {
  if !ibOwnBuilt {
    ibOwnBuilt = true
    const fn = if ibFnIx >= 0 && ibFnIx < P.nodes.length { nodeAt(ibFnIx) } else { null }
    const todo: i32[] = if fn is FuncDecl { [fn.fnBody] } else { ibStartRoots.slice(0) }
    while todo.length > 0 {
      const i = todo.pop() ?? -1
      if i >= 0 && i < P.nodes.length && !(nodeAt(i) is FuncDecl) {
        if nodeAt(i) is LetDecl {
          ibOwnDecls[i] = true
          const o = declOrigOf(i)
          if o >= 0 { ibOwnByOrig[o] = if ibOwnByOrig.has(o) { -2 } else { i } }
        }
        nodeChildrenPush(i, todo)
      }
    }
  }
  return ibOwnDecls[d] ?? false
}

// Whether an environment slot at record rep `slot`, whose type no struct row records (its heap
// is never noted), takes a binding held at record rep `held` on a noted heap with the same fields:
// legacy declares such a slot at the binding's storage row (`rowlessLetTy`).
function rowlessSlotTakes(held: i32, slot: i32): boolean {
  const h = repNodeAt(held)
  const s = repNodeAt(slot)
  if !(h is RRecord) || !(s is RRecord) || h.rrVariant || s.rrVariant {
    return false
  }
  if recHeapNoted(slot) || !recHeapNoted(held) { return false }
  const a = repRecordFieldNames(held)
  const c = repRecordFieldNames(slot)
  if a.length != c.length { return false }
  let i = 0
  while i < a.length {
    if a[i] != c[i] { return false }
    i = i + 1
  }
  return true
}

// The `let`s and `const`s of the function being built, outside any nested function, once built.
let ibOwnDecls: {[i32]: boolean} = Map()
// Each of those that copies another declaration, keyed by the one it copies (`declOrigOf`); -2
// where two copy it.
let ibOwnByOrig: {[i32]: i32} = Map()
let ibOwnBuilt = false
// A start body's statements and the initializers it builds: its block-locals stand in them.
let ibStartRoots: i32[] = []

// For the function being built, by lifted function and capture name, the binding `liftCapDecl`
// found.
let ibLiftCapDecl: {[string]: i32} = Map()

// The variable this frame's loop made for the loop variable that capture `name` of `fe` names
// (`captureLoopNodeOf`): a `for-in`'s element or key, or a range's counter; -1 for none.
function loopCapVar(fe: i32, name: string): i32 {
  const lp = captureLoopNodeOf(fe, name)
  if lp < 0 { return -1 }
  const ln = nodeAt(lp)
  const d = if ln is ForIn { captureLoopVarDeclOf(fe, name) } else if ln is ForRange { lp } else { -1 }
  return if d >= 0 { ibDeclVar[d] ?? -1 } else { -1 }
}

// The captures lifted function `pos` takes after its environment, each a parameter, a binding or
// a lifted capture of the function being built, or a capture its environment holds, read in
// order at call `ix`; a miss names any other.
function liftCaps(b: i32[], pos: i32, ix: i32): Opnd[] {
  const out: Opnd[] = []
  for name in captureNamesOf(pos) {
    const p = paramIndexOf(ibFnIx, name)
    const lv = if p < 0 { loopCapVar(pos, name) } else { -1 }
    if (
      lv >= 0
      && capRepFor(pos, name, ib.irVars[lv].vRep) != ib.irVars[lv].vRep
    ) {
      irBMiss("callee captures")
      return out
    }
    const d = if p < 0 && lv < 0 { liftCapDecl(pos, name) } else { -1 }
    let v = if p >= 0 { paramVarAt(envSlotShift(ibFnIx) + p) } else if lv >= 0 { lv } else if d >= 0 { irBDeclVar(d) } else { -1 }
    // A capture of this frame passes on as this frame reads it: a lifted frame's own parameter,
    // or a field of its environment read at the callee's rep (a cell or another rep misses).
    if v < 0 && captureSlotOf(name, ibFnIx) >= 0 {
      const self = fnStmtsPosOf(ibFnIx)
      // The environment read is a temp ahead of the callee's null environment; it has no effect.
      if !cloLifted(self) {
        const cr = capRepOf(self, name)
        if cr < 0 || cr != capRepOf(pos, name) || capCellTargetOf(name) >= 0 {
          irBMiss("callee captures env")
          return out
        }
        const ct = capTyOf(self, name)
        const ev: Rhs = { evSlot: captureSlotOf(name, ibFnIx), evAt: -1 }
        out.push(
          irBLetTempTy(b, ev, ix, cr, if ct >= 0 { ct } else { repTyOf(cr) }),
        )
        continue
      }
      if (
        capRepOf(self, name) >= 0
        && capRepOf(self, name) == capRepOf(pos, name)
      ) {
        v = liftCapVar(self, name, -1)
      }
    }
    if v < 0 || capCellTargetOf(name) >= 0 {
      irBMiss("callee captures")
      return out
    }
    const o: Opnd = { ov: v }
    out.push(o)
  }
  return out
}

// The function type of nested function `pos` called by `c`: its declaration's, closed by the
// instance where it is a generic's, else the read's recorded type; -1 for none.
function capturedCalleeTy(c: Call, pos: i32): i32 {
  const d = identDeclOf(c.callFn)
  const dty = if d >= 0 { nodeTyAt(d, -1) } else { -1 }
  const ity = if dty >= 0 { elabInstTyAt(dty, fnStmts[pos]) } else { -1 }
  if ity >= 0 { return ity }
  if dty >= 0 { return dty }
  return heldTy(exprTyOf(c.callFn))
}

// The closure rep of instance `pos` built from its own parameter and result reps, where no type
// spells its signature (a generic instanced at two types); void as its `$fnsig` key says. -1 when
// a part has no rep.
function instanceClosureRep(pos: i32): i32 {
  const inst = fnStmts[pos]
  const fn = nodeAt(inst)
  if !(fn is FuncDecl) { return -1 }
  const ps: i32[] = []
  for p in fn.fnParams {
    const r = repNodeOfTy(scopeTyAt(p, inst))
    if r < 0 { return -1 }
    ps.push(r)
  }
  const isVoid = sigKeyRetIsVoid(cloSigKeyExt(pos))
  const ret = repNodeOfTy(resultTy(pos, fn.fnRet, inst))
  if ret < 0 && !isVoid { return -1 }
  return repClosureOfReps(ps, ret, isVoid)
}

// A direct call `ix` of nested function `pos`, which reads its captures from its environment, as
// `emitCapturedCall` writes it: the function's closure over a fresh environment, called through
// legacy's shared head and tail at the function's own `$fnsig`, each argument on the plain arm.
function capturedCallRhs(b: i32[], c: Call, ix: i32, pos: i32): Rhs {
  if closureValueCoreWhy(pos) != "" {
    return missRhs("captured call closure refused")
  }
  const sig = fnSigIdxOfFn(pos)
  if sig < 0 { return missRhs("captured call signature") }
  // The closure is the instance `pos` legacy builds and calls at `sig`: its declaration's type as
  // that instance closes it. A generic's read carries no type of its own in the caller's frame.
  const cty = capturedCalleeTy(c, pos)
  // With no type the instance closes, the closure is its own reps' rep, typed -1
  // (`irUntypedClosure`).
  const frep = if cty >= 0 { repNodeOfTy(cty) } else { instanceClosureRep(pos) }
  // An interned node a type built first is that type's.
  const fty = if cty >= 0 { cty } else { repTyOf(frep) }
  if !(repNodeAt(frep) is RClosure) {
    return missRhs("captured call closure rep")
  }
  const env = cloEnvOf(b, pos, ix)
  if ibMiss != "" { return missRhs(ibMiss) }
  const f = irBLetTempTy(
    b,
    { mcFn: pos, mcEnv: env, mcAt: ix },
    c.callFn,
    frep,
    fty,
  )
  if ibMiss != "" { return missRhs(ibMiss) }
  const callee = nodeAt(fnStmts[pos])
  if !(callee is FuncDecl) || callee.fnParams.length != c.callArgs.length {
    return missRhs("argument count")
  }
  const args: Opnd[] = []
  let i = 0
  while i < c.callArgs.length {
    if bundleSigsOfParam(callee.fnParams[i]).length > 0 {
      return missRhs("bundle argument")
    }
    // A widening is delivered at its parameter's number (`emitWidened`), and a box at the
    // parameter's union (`emitDelivered`, `emitUnionBoxOwed`).
    const arm = capturedArgArmOf(c.callArgs[i], i, pos, ibFnIx)
    const pty = scopeTyAt(callee.fnParams[i], fnStmts[pos])
    const dst = repNodeOfTy(pty)
    const delivers = capturedArgDelivers(arm)
    if arm != "plain" && !delivers {
      return missRhs("captured call argument " + arm)
    }
    const at = b.length
    const a = if delivers { deliver(b, c.callArgs[i], dst, pty) } else { irBExpr(b, c.callArgs[i]) }
    if ibMiss != "" { return missRhs("argument") }
    if ifBelowLead(b, at, "short-circuit closure argument") {
      return missRhs("short-circuit closure argument")
    }
    if irBOpRep(a) != dst { return missRhs("captured call argument rep") }
    args.push(a)
    i = i + 1
  }
  const isVoid = sigKeyRetIsVoid(cloSigKeyExt(pos))
  const r: Rhs = {
    crFn: f,
    crSig: sig,
    crArgs: args,
    crVoid: isVoid,
    crDrop: !isVoid,
    crNever: callEndsNever(ix),
    crHead: false,
  }
  return r
}

// Whether a captured-call argument on arm `arm` is delivered at its parameter's rep: a widening the
// IR builds, or a box; `widenF32`, a literal union, an atom and an unbox are legacy's alone.
function capturedArgDelivers(arm: CapturedArgArm): boolean {
  return match arm {
    "widenI64" | "widenF64" | "boxTable" | "boxFloor" => true
    "widenF32" | "lit" | "atomStr" | "unbox" | "plain" => false
  }
}

// A closure call whose function set has no one signature is legacy's own refusal, raised at the
// call before the claim declines, inside a claim only (`callRefSplitKind`).
function callSplitRefuse(c: Call, ix: i32) {
  if !emitSoftFail { return 0 }
  const k = callRefSplitKind(ix, c.callFn, ibFnIx)
  if k == 1 {
    emitFailAt(
      "emitProgram: this call runs functions that return different types, and one of them is also held where it cannot be stored as one of the functions this value may hold, so the call has no one signature",
      ix,
    )
  }
  if k == 2 {
    emitFailAt(
      "emitProgram: this call runs a function value that may hold any of a set of functions returning different types, held where the instance keeps them at one signature; dispatching such a call per function is not built yet",
      ix,
    )
  }
  return 0
}

// A call `ix` through a closure binding that legacy writes plainly (`callRefPlainKey`): the
// closure, then each argument at its parameter's scalar, string or record rep.
function closureCallRhs(b: i32[], c: Call, ix: i32): Rhs {
  const key = callRefPlainKey(ix, ibFnIx)
  if key == "" { callSplitRefuse(c, ix) }
  if key == "" { return missRhs("call of a non-declaration") }
  if !legacyPlainAgrees(ix, key) {
    return missRhs("closure call plan disagrees")
  }
  const cf = if c.callFn >= 0 && c.callFn < P.nodes.length { nodeAt(c.callFn) } else { null }
  const f = if cf is Member && nodeTyAt(c.callFn, ibFnIx) < 0 { sharedFieldCallee(b, cf, c.callFn) } else { irBExpr(b, c.callFn) }
  if ibMiss != "" { return missRhs("closure callee") }
  if !(repNodeAt(irBOpRep(f)) is RClosure) {
    return missRhs("closure callee rep")
  }
  return closureCallAt(b, c, ix, key, f)
}

// Whether callee `fx` is a name this frame reads through its capture (`identReadArmOf`).
function calleeIsCapture(fx: i32): boolean {
  if fx < 0 || fx >= P.nodes.length { return false }
  const n = nodeAt(fx)
  return n is Ident && identReadArmOf(n, fx, ibFnIx, false) == "capture"
}

// Whether `emitCallCore` sends call `ix` of a field to `emitCallRef`: a closure, a place holding a
// returned record whole, or a returned record's member.
function fieldCallRoutesRef(c: Call, ix: i32): boolean {
  if exprIsClosure(c.callFn, ibFnIx) || placeRecordSigs(ix, ibFnIx).length > 0 {
    return true
  }
  return callResultMemberTy(unwrapParen(c.callFn), ibFnIx) >= 0
}

// Bundle callee `fx` read through a capture of this frame, at the record its capture holds; else a
// named miss.
function bundleCaptureRead(b: i32[], fx: i32): Opnd {
  const n = nodeAt(fx)
  if !(n is Ident) || identReadArmOf(n, fx, ibFnIx, false) != "capture" {
    return irBMiss("bundle callee")
  }
  const cr = capRepOf(fnStmtsPosOf(ibFnIx), n.identName)
  if cr < 0 || !(repNodeAt(cr) is RRecord) {
    return irBMiss("bundle callee capture rep")
  }
  return captureRead(b, n, fx, cr)
}

// Callee `x.f` at node `at`, a generic's shared template member no instance typed (mono shares it
// between instances that dispatch it differently, D1063): legacy reads the field at its storage
// (`emitMemStructRead`), so the IR reads the receiver's record kid at its own type.
function sharedFieldCallee(b: i32[], m: Member, at: i32): Opnd {
  const ot = nodeTyAt(m.memObj, ibFnIx)
  const r = if ot >= 0 { repNodeOfTy(ot) } else { -1 }
  const si = structIndexOfExpr(m.memObj, ibFnIx)
  const fi = if si >= 0 { sFieldIndex(si, m.memProp) } else { -1 }
  // A nullable record receiver (a `?.` on an un-annotated parameter) is read by legacy off the
  // nullable reference the chain tested; the verifier admits no field read of a nullable.
  const rn = repNodeAt(r)
  if rn is RNullable && repNodeAt(rn.rnInner) is RRecord {
    return irBMiss("shared member callee nullable receiver")
  }
  if !(repNodeAt(r) is RRecord) || fi < 0 {
    return irBMiss("shared member callee row")
  }
  // Legacy's narrowed and union-box tails read the node's own type, which it has none of.
  if memReadNarrowOp(at, ibFnIx) >= 0 || sFieldIsUnionBox(si, fi) {
    return irBMiss("shared member callee tail")
  }
  // The field is read at its kid's own type, which its record rep carries.
  const k = repRecordKidOf(r, ot, m.memProp)
  const ft = if k >= 0 { repTyOf(repNodeKids(r)[k]) } else { -1 }
  if (
    ft < 0
    || ibTyOpen(ft, repNodeKids(r)[k])
    || repNodeKids(r)[k] != repNodeOfTy(ft)
  ) {
    return irBMiss("shared member callee kid")
  }
  const rv = irBExpr(b, m.memObj)
  if ibMiss != "" { return rv }
  if irBOpRep(rv) != r { return irBMiss("shared member callee receiver") }
  const g: Rhs = {
    gfV: rv,
    gfIx: k,
    gfAt: at,
    gfStored: false,
    gfStr: false,
    gfShared: true,
  }
  return irBLetTempTy(b, g, at, repNodeKids(r)[k], ft)
}

// Armed, legacy has written call `ix` already, and must have taken the plain path at `key`.
function legacyPlainAgrees(ix: i32, key: string): boolean {
  if ibArmed && callRefLegacyPlainKey(ix) != key {
    emitFail(
      "emitProgram: internal: the IR's plain closure call disagrees with legacy's",
    )
    return false
  }
  return true
}

// A call `ix` through a bundle parameter (D14841) that legacy writes plainly
// (`bundleCallRefPlainKey`): the member `bundlePickOf` reads, called at its key.
function bundleCallRhs(b: i32[], c: Call, ix: i32): Rhs {
  const key = bundleCallRefPlainKey(ix, ibFnIx)
  if key == "" { return missRhs("bundle call") }
  if !legacyPlainAgrees(ix, key) {
    return missRhs("closure call plan disagrees")
  }
  const pk = bundlePickOf(ix, ibFnIx)
  // The parameter's local, or a captured bundle read at the record its capture holds (`capTyOf`).
  const cf = if c.callFn >= 0 && c.callFn < P.nodes.length { nodeAt(c.callFn) } else { null }
  const p = if cf is Ident { paramIndexOf(ibFnIx, cf.identName) } else { -1 }
  const pv = if p >= 0 { paramVarAt(envSlotShift(ibFnIx) + p) } else { -1 }
  const v: Opnd = if pv >= 0 { { ov: pv } } else { bundleCaptureRead(b, c.callFn) }
  if ibMiss != "" { return missRhs(ibMiss) }
  const crep = repNodeOfTy(pk.bpTy)
  if !(repNodeAt(crep) is RClosure) { return missRhs("bundle member rep") }
  const f = irBLetTempTy(b, { bpV: v, bpAt: ix }, c.callFn, crep, pk.bpTy)
  if ibMiss != "" { return missRhs(ibMiss) }
  return closureCallAt(b, c, ix, key, f)
}

// A call `ix` through a `const` holding a returned record whole (D15144) that legacy writes
// plainly (`holderCallRefPlainKey`): the member `holderPickOf` reads, called at its key.
function holderCallRhs(b: i32[], c: Call, ix: i32): Rhs {
  const key = holderCallRefPlainKey(ix, ibFnIx)
  if key == "" { return missRhs("holder call") }
  if !legacyPlainAgrees(ix, key) {
    return missRhs("closure call plan disagrees")
  }
  const pk = holderPickOf(ix, ibFnIx)
  // A holder captured whole is read at the record its capture holds (`capTyOf`).
  const v = if calleeIsCapture(c.callFn) { bundleCaptureRead(b, c.callFn) } else { holderRecordOf(b, c.callFn) }
  if ibMiss != "" { return missRhs("holder callee") }
  const crep = repNodeOfTy(pk.bpTy)
  if !(repNodeAt(crep) is RClosure) { return missRhs("holder member rep") }
  const f = irBLetTempTy(b, { bpV: v, bpAt: ix }, c.callFn, crep, pk.bpTy)
  if ibMiss != "" { return missRhs(ibMiss) }
  return closureCallAt(b, c, ix, key, f)
}

// Call `ix` of the member closure that direct call `rx` picks from the bundle record it returns
// (`bundleResultPickOf`, legacy's `emitBundleResultPick`), at plain key `callRefPlainKey`.
function resultMemberCallRhs(b: i32[], c: Call, ix: i32, rx: i32): Rhs {
  const key = callRefPlainKey(ix, ibFnIx)
  if !legacyPlainAgrees(ix, key) {
    return missRhs("closure call plan disagrees")
  }
  const ic = nodeAt(rx)
  if !(ic is Call) { return missRhs("result member callee") }
  const rhs = callRhs(b, ic, rx)
  if ibMiss != "" { return missRhs("result member callee") }
  if !(rhs is RCall) { return missRhs("result member callee") }
  const si = irSigOf(ib, rhs.caCallee)
  const sr = if si >= 0 { ib.irSigRet[si] } else { -1 }
  if sr < 0 || !(repNodeAt(sr) is RRecord) {
    return missRhs("result member record")
  }
  const pk = bundleResultPickOf(rx, rhs.caCallee, ibFnIx)
  const crep = if pk.bpField >= 0 && pk.bpTy >= 0 { repNodeOfTy(pk.bpTy) } else { -1 }
  if crep < 0 || !(repNodeAt(crep) is RClosure) {
    return missRhs("result member pick")
  }
  const rec = irBLetTempTy(b, rhs, rx, sr, repTyOf(sr))
  const f = irBLetTempTy(
    b,
    { rkV: rec, rkAt: rx, rkFe: rhs.caCallee },
    rx,
    crep,
    pk.bpTy,
  )
  if ibMiss != "" { return missRhs(ibMiss) }
  return closureCallAt(b, c, ix, key, f)
}

// Closure call `ix` of `f` at plain key `key`: each argument at its parameter, then the call.
function closureCallAt(b: i32[], c: Call, ix: i32, key: string, f: Opnd): Rhs {
  const args: Opnd[] = []
  // Where the callee ends, where each argument starts, and the call's head once one is staged.
  const fEnd = b.length
  const starts: i32[] = []
  let head: Opnd = f
  let staged = false
  let i = 0
  while i < c.callArgs.length {
    const at = b.length
    starts.push(at)
    // A function handed as a bundle is the record of its closures, as `emitBundleReadArg` writes it.
    const bb = callRefBundleArgOf(c, ibFnIx, key, i)
    if bb.bbTy >= 0 {
      const si = repRowOfTyStruct(bb.bbTy, repScanLim())
      const ba = bundleRecBuild(b, c.callArgs[i], bb.bbSigs, si, bb.bbTy, true)
      if ibMiss != "" { return missRhs(ibMiss) }
      // The key's parameter takes the record row, whatever the closure's function type says.
      if sigParamSlotAt(key, i) != si {
        return missRhs("closure bundle argument row")
      }
      args.push(ba)
      i = i + 1
      continue
    }
    // A widening is delivered at its parameter's number, as `emitWidened` writes it, and a box at
    // the parameter's union, as `emitUnionBoxAtRecord` writes it.
    const arm = callRefArgArmOf(ix, ibFnIx, key, c.callArgs[i], i)
    const wt = closureArgWidenTy(arm)
    // An atom, a scalar list or a union arm is written as it stands, so it must already be at the
    // parameter's rep.
    const asIs = arm == "atom"
      || arm == "scalarList"
      || arm == "general" && sigParamKindAt(key, i) == "variant"
      || arm == "armUnbox"
      && callRefArmUnboxPlan(key, i, c.callArgs[i], ibFnIx) == "asIs"
    // A nullable arm parameter takes its record ref, a narrowed box unboxed to it (`armOpen`).
    const atRep = arm == "box" || arm == "armUnbox" || arm == "nulArm" || asIs
    const bx = if atRep { closureParamRep(f, i) } else { -1 }
    if atRep && bx < 0 { return missRhs("closure box parameter rep") }
    // A `null` literal on the general arm is built at the parameter's rep, the null `nullOwnAt`
    // names there, as legacy's `emitNullLitNode` writes it.
    const nl = if wt < 0
      && bx < 0
      && arm == "general"
      && nodeAt(unwrapParen(c.callArgs[i])) is NullLit { closureParamRep(f, i) } else { -1 }
    // On the general arm a value the atom hook converts is built at its atom parameter's rep by
    // the hook's arm, as `emitExpr` writes it there.
    const ah = if wt < 0
      && bx < 0
      && nl < 0
      && arm == "general"
      && exprPrePathWhy(c.callArgs[i], ibFnIx) == "pre-path atom hook"
      && closureParamRep(f, i) >= 0
      && repNodeAt(closureParamRep(f, i)) is RAtom { closureParamRep(f, i) } else { -1 }
    const a0 = if wt >= 0 { deliver(b, c.callArgs[i], repNodeOfTy(wt), wt) } else if bx >= 0
      && (!asIs || nodeAt(unwrapParen(c.callArgs[i])) is NullLit || arm == "atom") { deliver(b, c.callArgs[i], bx, repTyOf(bx)) } else if arm == "atomToStr" { closureArgAtomStr(b, c.callArgs[i], f, i) } else if nl >= 0 { deliver(b, c.callArgs[i], nl, -1) } else if ah >= 0 { deliver(b, c.callArgs[i], ah, -1) } else { irBExpr(b, c.callArgs[i]) }
    if ibMiss != "" { return missRhs("argument") }
    // A hole-typed argument (a captured un-annotated parameter) is written as its slot holds it,
    // converted to the scalar the key's parameter names, as legacy's general arm writes it.
    const hp = if arm == "general" && exprHoleTyped(c.callArgs[i], ibFnIx) { keyScalarRep(sigParamKindAt(key, i)) } else { -1 }
    const a = if hp >= 0 { irConvert(b, a0, hp, -1, c.callArgs[i]) } else { a0 }
    if ibMiss != "" { return missRhs("argument") }
    // An argument that writes a statement stages the call's head, and the arguments before it,
    // ahead of that statement, as legacy writes them before it (`RCallRefHead`).
    if ifBelowLeadHas(b, at, b.length) {
      if !staged {
        staged = true
        head = closureHeadStage(b, fEnd, f, ix)
        if ibMiss != "" { return missRhs("short-circuit closure argument") }
        let k = 0
        while k < starts.length {
          starts[k] = starts[k] + 1
          k = k + 1
        }
      }
      const argIxs = c.callArgs.slice(0, args.length)
      if !irBStageLeads(b, starts[args.length], starts, args, argIxs) {
        return missRhs("short-circuit closure argument")
      }
    }
    if wt >= 0 && irBOpRep(a) != repNodeOfTy(wt) {
      return missRhs("closure argument coercion")
    }
    if bx >= 0 && irBOpRep(a) != bx && !nulListTakes(bx, irBOpRep(a), arm) {
      return missRhs("closure argument box")
    }
    // A `null` literal built at the parameter's rep is that parameter's value.
    if (
      wt < 0
      && bx < 0
      && !(nl >= 0 && irBOpRep(a) == nl)
      && !closureArgRepIs(irBOpRep(a), sigParamKindAt(key, i))
    ) {
      return missRhs("closure argument coercion")
    }
    args.push(a)
    i = i + 1
  }
  const r: Rhs = {
    crFn: head,
    crSig: cloSigTypeIdxAt(cloSigPosOfKey(key)),
    crArgs: args,
    crVoid: sigKeyRetIsVoid(key),
    crDrop: closureCallDrops(c, ix),
    crNever: callEndsNever(ix),
    crHead: staged,
  }
  return r
}

// Closure `f`'s call head (`RCallRefHead`) at the callee's own type, inserted into `b` at `at`,
// where the callee ends.
function closureHeadStage(b: i32[], at: i32, f: Opnd, ix: i32): Opnd {
  if !(f is OVar) || f.ov < 0 || f.ov >= ib.irVars.length {
    return irBMiss("call_ref head callee")
  }
  const one: i32[] = []
  const h = irBLetTempTy(one, { chFn: f }, ix, irBOpRep(f), ib.irVars[f.ov].vTy)
  if ibMiss != "" || one.length != 1 { return irBMiss("call_ref head") }
  insertAt(b, at, one[0])
  return h
}

// Call statement `n`'s right-hand side as legacy's statement ladder writes it: a closure call
// through a member or expression callee goes to `emitCallRef`, not `emitCall`, so no
// `unreachable` follows it even when it never returns.
function stmtCallRefNever(rhs: Rhs, n: Call): Rhs {
  if !(rhs is RCallRef) || !rhs.crNever || n.callFn < 0 { return rhs }
  if nodeAt(n.callFn) is Ident { return rhs }
  const r: Rhs = {
    crFn: rhs.crFn,
    crSig: rhs.crSig,
    crArgs: rhs.crArgs,
    crVoid: rhs.crVoid,
    crDrop: rhs.crDrop,
    crNever: false,
    crHead: rhs.crHead,
  }
  return r
}

// Whether closure call `c` at `ix`, as a statement, drops its value: a named callee as legacy's
// statement ladder decides (`callStmtIdentDrops`), any other as its plan's voidness.
function closureCallDrops(c: Call, ix: i32): boolean {
  const cf = if c.callFn >= 0 && c.callFn < P.nodes.length { nodeAt(c.callFn) } else { null }
  if cf is Ident { return callStmtIdentDrops(c, cf, ix, ibFnIx) }
  return !callRefPlainVoid(ix, ibFnIx)
}

// The rep closure `f` takes its parameter `i` at, or -1.
function closureParamRep(f: Opnd, i: i32): i32 {
  const n = repNodeAt(irBOpRep(f))
  if !(n is RClosure) || i < 0 || i >= n.rcParams.length { return -1 }
  return n.rcParams[i]
}

// The number type a closure-call argument on arm `arm` widens to, or -1 for none the IR builds
// (an `f32` widening is legacy's).
function closureArgWidenTy(arm: CallRefArgArm): i32 {
  return match arm {
    "widenI64" => irTyI64()
    "widenF64" => irTyF64()
    "widenF32" | "wideIntoI32" | "heapIntoI32" | "boxUnrecorded" | "armNotBuilt" | "armUnbox" | "nulArm" | "box" | "atomToStr" | "scalarList" | "general" | "atom" => -1
  }
}

// Whether an argument built at rep `r` is what a closure parameter of kind `k` takes as it stands.
// Atom argument `ix` of a function-value call, at parameter `i` of callee `f`, decoded at the
// parameter's string rep as `emitCallRefArg`'s `atomToStr` arm writes it (`emitAtomToStr`).
function closureArgAtomStr(b: i32[], ix: i32, f: Opnd, i: i32): Opnd {
  const dst = closureParamRep(f, i)
  if dst < 0 || !(repPrim(dst) == "str" || strNullable(dst)) {
    return irBMiss("closure atom argument rep")
  }
  const v = irBExpr(b, ix)
  if ibMiss != "" { return v }
  if !atomAtStr(irBOpRep(v), dst) {
    return irBMiss("closure atom argument rep")
  }
  return atomToStr(b, v, ix, dst)
}

// Whether a scalar list at rep `got` is what a nullable list parameter at rep `want` takes as it is:
// the list itself under the parameter's nullable, on the `scalarList` arm.
function nulListTakes(want: i32, got: i32, arm: CallRefArgArm): boolean {
  const w = repNodeAt(want)
  return arm == "scalarList" && w is RNullable && w.rnInner == got
}

function closureArgRepIs(r: i32, k: VKind | null): boolean {
  const n = repNodeAt(r)
  const p = repPrim(r)
  const ps: string = if p == null { "" } else { p }
  return match k {
    "i32" => ps == "i32" || ps == "bool"
    "i64" | "f64" | "f32" | "str" | "v128" => ps == k
    "struct" => n is RRecord
    "closure" => n is RClosure
    "list" | "strlist" | "f64list" | "i64list" | "f32list" | "reflist" => n is RList
    "map" => n is RMap
    // A nullable parameter takes the reference or its nullable, as the argument is written.
    "nulstr" => ps == "str" || strNullable(r)
    "nulclosure" => n is RClosure || n is RNullable && repNodeAt(n.rnInner) is RClosure
    "nulmap" => n is RMap || n is RNullable && repNodeAt(n.rnInner) is RMap
    "nulstruct" => n is RRecord || n is RNullable && repNodeAt(n.rnInner) is RRecord
    "nullist" => n is RList || n is RNullable && repNodeAt(n.rnInner) is RList
    "union" | "variant" | "nulvariant" | "nulbool" | "nulreflist" | "nulstrlist" | "nulf64list" | "nuli64list" | "nulf32list" | "nulv128list" | "nulu8list" | "nulnone" | "u8list" | "v128list" | null => false
  }
}

// Whether every operand in `os` is a temp, which the lowering writes below a later valued `if`
// in its order (`stageLead`); a variable or an immediate is written at its reader instead.
function opndsAreTemps(os: Opnd[]): boolean {
  for o in os {
    if !(o is OVar) || o.ov < 0 || o.ov >= ib.irVars.length { return false }
    if ib.irVars[o.ov].vKind != "temp" { return false }
  }
  return true
}

// For an argument built into `b` from `at` on that holds a valued `if`: makes each earlier
// argument in `args` that is a variable or immediate a staged temp at its own start (`starts`),
// so the lowering writes them all below the `if` in order. False when one cannot be.
export function irBStageLeads(
  b: i32[],
  at: i32,
  starts: i32[],
  args: Opnd[],
  argIxs: i32[],
): boolean {
  // A receiver stage is written in place, below which the lowering stages nothing. A literal's
  // order stash sets its fields below them. So is a void `if` (a `null`-typed one run for its
  // effect), below which the lowering writes no staged temp.
  if listStageFrom(b, at) || voidIfFrom(b, at) { return false }
  // A box over a tag dispatch or a join span has its head written ahead of that span
  // (`dispatchBoxHead`), above any operand staged before it, where legacy writes that operand
  // first (D17564).
  const lead = dispatchBoxFrom(b, at) || boxLeadSpanFrom(b, at)
  // A store the operand makes (an assignment as its value) is a statement: an earlier operand
  // read at its use would see the stored value, so it is staged below the store, as below an `if`.
  const store = storeFrom(b, at)
  const coal = coalBoxFrom(b, at, true) || coalBoxFrom(b, at, false)
  const stash = stashSetFrom(b, at) || tagStashFrom(b, at)
  if (
    !valuedIfFrom(b, at) && !coal && !stash && !store && !lead
    || opndsAreTemps(args)
  ) {
    return true
  }
  let j = 0
  while j < args.length {
    const a = args[j]
    // A valued `if`'s out is already on the stack, in its order.
    if a is OVar && (a.ov < 0 || a.ov >= ib.irVars.length) { return false }
    const held = a is OVar
      && (ib.irVars[a.ov].vKind == "temp"
      || valuedIfOut(b, a.ov)
      || coal && coalBoxOut(b, a.ov))
    if !held {
      const ty = stageTyOf(a, argIxs[j])
      if ty < 0 {
        irBMiss("staged literal type")
        return false
      }
      const one: i32[] = []
      const t = irBLetTempTy(one, { sgV: a }, argIxs[j], irBOpRep(a), ty)
      if ibMiss != "" || one.length != 1 { return false }
      insertAt(b, starts[j], one[0])
      let k = j + 1
      while k < starts.length {
        starts[k] = starts[k] + 1
        k = k + 1
      }
      args[j] = t
    }
    j = j + 1
  }
  return true
}

// The type a staged operand `a` built for node `ix` is held at: its node's, or for a literal its
// delivery's when it is built at that rep (a literal at an atom parameter is the atom's id); -1
// for a literal at neither.
function stageTyOf(a: Opnd, ix: i32): i32 {
  const own = heldTy(exprTyOf(ix))
  if repNodeOfTy(own) == irBOpRep(a) { return own }
  // An immediate at a rep its type does not name (a function set's id) has no staged type.
  if a is OImm { return -1 }
  if !(a is OStr) { return own }
  const ctx = heldTy(ctxTyAt(ix, ibFnIx))
  return if repNodeOfTy(ctx) == irBOpRep(a) { ctx } else { -1 }
}

// Inserts node `id` into body `b` at position `at`.
function insertAt(b: i32[], at: i32, id: i32) {
  b.push(id)
  let i = b.length - 1
  while i > at {
    b[i] = b[i - 1]
    i = i - 1
  }
  b[at] = id
  return 0
}

// Whether operands built into `b` from `at` on hold a node the lowering writes in place: a boxed
// `??`, or a push receiver's stage.
function inPlaceFrom(b: i32[], at: i32): boolean {
  return coalBoxFrom(b, at, true)
    || coalBoxFrom(b, at, false)
    || receiverStageFrom(b, at)
}

// `inPlaceFrom` less a `??` that writes the temps staged before it below its tag test
// (`coalArmStagesLeads`), as a valued `if` does, and less a literal's order stash, whose fields
// it sets below them too.
function inPlaceUnstagedFrom(b: i32[], at: i32): boolean {
  return coalBoxFrom(b, at, false) || listStageFrom(b, at)
}

// Whether operands built into `b` from `at` on hold a push receiver's stage, which the lowering
// writes with nothing pending below it.
function receiverStageFrom(b: i32[], at: i32): boolean {
  return stmtFrom(b, at, "listStage") || stmtFrom(b, at, "stash")
}

// Whether operands built into `b` from `at` on hold a push receiver's stage.
function listStageFrom(b: i32[], at: i32): boolean {
  return stmtFrom(b, at, "listStage")
}

// Whether operands built into `b` from `at` on hold a tag dispatch's stash, which the lowering
// writes below the operands staged before it (`tagStashEffect`).
function tagStashFrom(b: i32[], at: i32): boolean {
  return stmtFrom(b, at, "tagStash")
}

// Whether operands built into `b` from `at` on hold a tag dispatch's stash under a box the
// lowering leads (`irBoxLeadBox`).
function dispatchBoxFrom(b: i32[], at: i32): boolean {
  if !tagStashFrom(b, at) { return false }
  let i = at
  while i < b.length {
    for x in ib.irBoxLeadBox {
      if x == b[i] { return true }
    }
    i = i + 1
  }
  return false
}

// Whether operands built into `b` from `at` on end a box-lead span (`irBoxLeadBox`).
function boxLeadSpanFrom(b: i32[], at: i32): boolean {
  let i = at
  while i < b.length {
    for x in ib.irBoxLeadBox {
      if x == b[i] { return true }
    }
    i = i + 1
  }
  return false
}

// Whether operands built into `b` from `at` on hold an order-stashed literal's field set.
function stashSetFrom(b: i32[], at: i32): boolean {
  return stmtFrom(b, at, "stash")
}

// Whether operands built into `b` from `at` on hold a store statement.
function storeFrom(b: i32[], at: i32): boolean {
  return stmtFrom(b, at, "store")
}

// Whether variable `v` is the out of a valued `if` in body `b`.
function valuedIfOut(b: i32[], v: i32): boolean {
  for id in b {
    const n = ib.irNodes[id]
    if n is SIf && n.siOut == v || n is SArmSite && n.saOut == v { return true }
  }
  return false
}

// Whether operands built into `b` from `at` on hold a `??` (`SCoalBox`) whose arm stages an
// earlier operand below it, as a valued `if` does (`coalArmStagesLeads`), or, with `stages`
// false, one whose arm does not.
function coalBoxFrom(b: i32[], at: i32, stages: boolean): boolean {
  return stmtFrom(b, at, if stages { "coalStaged" } else { "coalInPlace" })
}

// Whether `v` is the out of a `??` in `b` (`SCoalBox`).
function coalBoxOut(b: i32[], v: i32): boolean {
  for id in b {
    const n = ib.irNodes[id]
    if n is SCoalBox && n.cbOut == v { return true }
  }
  return false
}

// Whether operands built into `b` from `at` on hold a void `if` (a `null`-typed one run for its
// effect), a statement as a store is.
function voidIfFrom(b: i32[], at: i32): boolean {
  return stmtFrom(b, at, "voidIf")
}

// Whether operands built into `b` from `at` on hold a valued `if` (an arm-site read's chain is one).
function valuedIfFrom(b: i32[], at: i32): boolean {
  return stmtFrom(b, at, "valuedIf")
}

// What node `n` is to the operands built around it: a temp is written inline at its one use, any
// other node is a statement written where it stands, which an operand built before it and used
// after it must be staged below (`irBStageLeads`). A void `if` and a receiver stage are not yet
// staged around: `irBStageLeads` refuses them.
type StmtClass = "temp" | "valuedIf" | "voidIf" | "coalStaged" | "coalInPlace" | "store"
  | "stash" | "tagStash" | "listStage" | "effect" | "control"

function stmtClassOf(n: IrNode): StmtClass {
  return match n {
    SLet => "temp"
    SIf => if n.siOut >= 0 { "valuedIf" } else { "voidIf" }
    SArmSite => "valuedIf"
    SCoalBox => if coalArmStagesLeads(n.cbArm) { "coalStaged" } else { "coalInPlace" }
    SAssign | SGlobalSet | SSetField | SListSet | SCellSet => "store"
    SEffect => effectStmtClassOf(n.efRhs)
    SArmWrite | SDrop | SBoundsCheck | SRawOp => "effect"
    SBlock | SBr | SForIn | SIntSwitch | SLoop | SRangeLoop | SReturn | SSwitch | STrap => "control"
  }
}

// The class of an effect statement over `r`: a literal's order stash, a tag dispatch's stash or a
// push receiver's stage; any other effect is a plain one, written where it stands.
function effectStmtClassOf(r: Rhs): StmtClass {
  if stashRhs(r) { return "stash" }
  if tagStashRhs(r) { return "tagStash" }
  return if listStageRhs(r) { "listStage" } else { "effect" }
}

function stashRhs(r: Rhs): boolean { return r is RStashSet }

function tagStashRhs(r: Rhs): boolean { return r is RTagStash }

function listStageRhs(r: Rhs): boolean { return r is RListStage }

// Whether a statement of class `c` among an operand's later siblings has the operands before it
// written below it, as `ifBelowLeadHas` reads it: a valued or void `if`, a `??` box, a store or a
// literal's order stash.
function stmtLeadsBelow(c: StmtClass): boolean {
  return match c {
    "valuedIf" | "voidIf" | "coalStaged" | "coalInPlace" | "store" | "stash" => true
    "temp" | "tagStash" | "listStage" | "effect" | "control" => false
  }
}

// Whether body `b` from `at` on holds a statement of class `c`.
function stmtFrom(b: i32[], at: i32, c: StmtClass): boolean {
  let i = at
  while i < b.length {
    if stmtClassOf(ib.irNodes[b[i]]) == c { return true }
    i = i + 1
  }
  return false
}

// `ifBelowLead` for a node whose operands `leads`, written before those from `at`, are all
// temps the lowering stages below the `if` or a store (`opndsAreTemps`): then no miss.
export function ifBelowLeadOf(
  b: i32[],
  at: i32,
  why: string,
  leads: Opnd[],
): boolean {
  if opndsAreTemps(leads) && !inPlaceUnstagedFrom(b, at) { return false }
  return ifBelowLead(b, at, why)
}

// Whether operands built into `b` from `at` on hold a valued `if` (a boxed `??` is one) below a
// part their node writes first (a receiver or an earlier operand, read at its use), naming `why`
// as the miss. Legacy writes such an `if` in place, which the IR's statement-level `if` cannot
// reorder.
export function ifBelowLead(b: i32[], at: i32, why: string): boolean {
  return ifBelowLeadIn(b, at, b.length, why)
}

// Where body `b` ends in a box whose head the lowering writes ahead of a span (`irBoxLeadFirst`),
// the index of that span's first node, which legacy writes below the head; else the box's index.
function leadFirstAt(b: i32[]): i32 {
  const bx = b[b.length - 1]
  let i = 0
  while i < ib.irBoxLeadBox.length {
    if ib.irBoxLeadBox[i] == bx { return b.length - 1 - ib.irBoxLeadN[i] }
    i = i + 1
  }
  return b.length
}

// `ifBelowLead` over the operands built into `b` from `at` up to `to`.
function ifBelowLeadIn(b: i32[], at: i32, to: i32, why: string): boolean {
  if !ifBelowLeadHas(b, at, to) { return false }
  irBMiss(why)
  return true
}

// A binary operator's left operand `lead[0]`, built into `b` from `ls`, staged below a right
// operand built from `at` that holds a statement it must be written below (`irBStageLeads`), as a
// later argument's earlier ones are. False, with a miss, where the right operand holds a statement
// nothing is staged below (a `??` written in place, a receiver stage) or the stage cannot be made.
function stageLeftBelow(
  b: i32[],
  ls: i32,
  at: i32,
  lead: Opnd[],
  leftIx: i32,
): boolean {
  const below = valuedIfFrom(b, at)
    || coalBoxFrom(b, at, true)
    || storeFrom(b, at)
    || stashSetFrom(b, at)
    || tagStashFrom(b, at)
  if below && !coalBoxFrom(b, at, false) && !receiverStageFrom(b, at) {
    if !irBStageLeads(b, at, [ls], lead, [leftIx]) {
      irBMiss("staged lead")
      return false
    }
    return true
  }
  return !ifBelowLeadOf(b, at, "short-circuit right operand", lead)
}

// Whether the operands built into `b` from `at` up to `to` write a statement legacy would write
// below a lead opened before them: an `if` (valued, or one run for its effect: a `null` join's or
// a `null`-typed if-expression's), a boxed `??` or a stash.
function ifBelowLeadHas(b: i32[], at: i32, to: i32): boolean {
  let i = at
  while i < to {
    if stmtLeadsBelow(stmtClassOf(ib.irNodes[b[i]])) { return true }
    i = i + 1
  }
  return false
}

// `fromCodePoint(cp)` over an i32, or `fromCodePoints(xs)` over a local or global i32 list, which
// legacy reads twice by name. Any other list spelling legacy reads once into its spill slot.
function fromCpRhs(b: i32[], c: Call, f: Ident, ix: i32): Rhs {
  if c.callArgs.length != 1 || nodeAt(c.callArgs[0]) is Spread {
    return missRhs("code point argument")
  }
  const many = f.identName == "fromCodePoints"
  const spill = many && callSpillsFcpArg(ix)
  const a = irBExpr(b, c.callArgs[0])
  if ibMiss != "" { return missRhs("code point operand") }
  if spill {
    const sl = repNodeAt(irBOpRep(a))
    if !(sl is RList) || repPrim(sl.rlsElem) != "i32" {
      return missRhs("code point operand coercion")
    }
  } else if many {
    if !(a is OVar) || a.ov < 0 || a.ov >= ib.irVars.length {
      return missRhs("code point list read")
    }
    // Legacy reads the list twice by name: a local's variable, or a global's read written again.
    if (
      ib.irVars[a.ov].vKind == "temp"
      && !ib.irReadAgain.has(unwrapParen(c.callArgs[0]))
    ) {
      return missRhs("code point list read")
    }
    const ln = repNodeAt(irBOpRep(a))
    if !(ln is RList) || repPrim(ln.rlsElem) != "i32" {
      return missRhs("code point operand coercion")
    }
  } else if repPrim(irBOpRep(a)) != "i32" {
    return missRhs("code point operand coercion")
  }
  const op: StrOp = if many { "fromcps" } else { "fromcp" }
  const r: Rhs = { soOp: op, soArgs: [a], soAt: ix }
  return r
}

// A SIMD load or store as legacy's arm writes it: the address along `memAddrPlanOf`'s `const` arm (an
// immediate 0) or `rest` arm (its node), then a store's vector. Every other address arm is a miss.
function simdMemRhs(b: i32[], c: Call, ix: i32, row: i32): Rhs {
  const base = simdMemBase(row)
  const ap = irBAddrPlan(c, base)
  const at = b.length
  const args: Opnd[] = []
  match ap.maArm {
    "const" => {
      const z: Opnd = { oiRep: repNodeOfTy(TY_I32), oiBits: 0 }
      args.push(z)
    }
    "rest" => args.push(irBExpr(b, ap.maRest))
    "fold" => args.push(foldAddrRead(b, c))
    "bad" | "lma" | "wide" => {
      return missRhs("simd memory address " + ap.maArm)
    }
  }
  if base == 2 { args.push(irBExpr(b, memCallArg(c, 2, 1))) }
  if ibMiss != "" { return missRhs("simd memory operand") }
  if ifBelowLead(b, at, "simd memory short-circuit operand") {
    return missRhs("simd memory short-circuit operand")
  }
  if (
    repPrim(irBOpRep(args[0])) != "i32"
    || base == 2 && repPrim(irBOpRep(args[1])) != "v128"
  ) {
    return missRhs("simd memory operand coercion")
  }
  const r: Rhs = {
    sdArgs: args,
    sdAt: ix,
    sdMemBase: base,
    sdPrims: [],
    sdResPrim: "",
  }
  return r
}

// A SIMD intrinsic as legacy's arm writes it (`emitSimdIntrinsic`): each value operand at the prim
// its row names (`simdOperandPrim`), a lane index being no operand. A load or store, whose address
// is the memory plan's, is a named miss.
function simdRhs(b: i32[], c: Call, ix: i32): Rhs {
  const row = simdCallRow(c)
  if row < 0 { return missRhs("simd row") }
  if simdRowIsMem(row) { return simdMemRhs(b, c, ix, row) }
  const at = b.length
  const args: Opnd[] = []
  const want: string[] = []
  let i = 0
  while i < c.callArgs.length {
    const p = simdOperandPrim(row, i)
    if p != "" {
      args.push(irBExpr(b, c.callArgs[i]))
      want.push(p)
    }
    i = i + 1
  }
  if ibMiss != "" { return missRhs("simd operand") }
  if ifBelowLead(b, at, "simd short-circuit operand") {
    return missRhs("simd short-circuit operand")
  }
  i = 0
  while i < args.length {
    if repPrim(irBOpRep(args[i])) != want[i] {
      return missRhs("simd operand coercion")
    }
    i = i + 1
  }
  const r: Rhs = {
    sdArgs: args,
    sdAt: ix,
    sdMemBase: 0,
    sdPrims: want,
    sdResPrim: simdResultPrim(row),
  }
  return r
}

// A host call as legacy's arm writes it (`emitCallCoreHost`): each argument as it stands, one the
// plan widens already at its kind's prim, then the import's `call`. A plan legacy refuses is a miss.
function hostCallRhs(b: i32[], c: Call, ix: i32): Rhs {
  const pl = hostCallPlanOf(c)
  if pl.hpFail != "" || pl.hpImport < 0 { return missRhs("host call plan") }
  const at = b.length
  const args: Opnd[] = []
  for a in c.callArgs { args.push(irBExpr(b, a)) }
  if ibMiss != "" { return missRhs("host call operand") }
  if ifBelowLead(b, at, "host call short-circuit operand") {
    return missRhs("host call short-circuit operand")
  }
  let i = 0
  while i < args.length {
    const k = pl.hpKinds[i]
    if k != 0 && repPrim(irBOpRep(args[i])) != numKindPrim(k) {
      return missRhs("host call operand coercion")
    }
    i = i + 1
  }
  const r: Rhs = {
    chImport: pl.hpImport,
    chArgs: args,
    chVoid: pl.hpVoid,
    chNever: callEndsNever(ix),
  }
  return r
}

// `__log__(offset, length)` as `emitCallCoreLog` writes it: both operands as they stand, then a
// call of the reserved `__log__` import.
function logCallRhs(b: i32[], c: Call, ix: i32): Rhs {
  if c.callArgs.length != 2 { return missRhs("log arguments") }
  const at = b.length
  const args: Opnd[] = []
  for a in c.callArgs { args.push(irBExpr(b, a)) }
  if ibMiss != "" { return missRhs("log operand") }
  if ifBelowLead(b, at, "log short-circuit operand") {
    return missRhs("log short-circuit operand")
  }
  for a in args {
    if repPrim(irBOpRep(a)) != "i32" { return missRhs("log operand rep") }
  }
  const r: Rhs = {
    chImport: gMemLogIdx,
    chArgs: args,
    chVoid: true,
    chNever: callEndsNever(ix),
  }
  return r
}

// `__str_from_bytes__(src, at, count)` as legacy's arm writes it: the three operands as they stand
// (a byte list, then two i32s), then the helper call (`strFromBytesTail`).
function strFromBytesRhs(b: i32[], c: Call, ix: i32): Rhs {
  if c.callArgs.length != 3 { return missRhs("byte string arguments") }
  const at = b.length
  const args: Opnd[] = []
  for a in c.callArgs { args.push(irBExpr(b, a)) }
  if ibMiss != "" { return missRhs("byte string operand") }
  if ifBelowLead(b, at, "byte string short-circuit operand") {
    return missRhs("byte string short-circuit operand")
  }
  const sl = repNodeAt(irBOpRep(args[0]))
  if !(sl is RList) || repPrim(sl.rlsElem) != "u8" {
    return missRhs("byte string source rep")
  }
  if (
    repPrim(irBOpRep(args[1])) != "i32"
    || repPrim(irBOpRep(args[2])) != "i32"
  ) {
    return missRhs("byte string operand coercion")
  }
  const r: Rhs = { soOp: "frombytes", soArgs: args, soAt: ix }
  return r
}

// A numeric intrinsic as legacy writes it (`numIntrPlanOf`): each operand at the operation's kind,
// widened where `emitExprAsKind` widens it, then its one instruction, or an integer
// `abs`/`min`/`max`'s select (`intSelTail`).
function numIntrRhs(b: i32[], c: Call, f: Ident, ix: i32): Rhs {
  const pl = numIntrPlanOf(ix, ibFnIx, f.identName)
  const sel = numIntrSelOf(pl.niArm, f.identName)
  if sel == null { return missRhs("intrinsic " + pl.niArm) }
  if (
    c.callArgs.length == 0
    || pl.niArm == "bitcast" && c.callArgs.length != 1
    || pl.niArm == "intAbs" && c.callArgs.length != 1
    || pl.niArm == "intMinMax" && c.callArgs.length != 2
  ) {
    return missRhs("intrinsic argument count")
  }
  const want = numKindPrim(pl.niKind)
  const wt = numIntrOperandTy(pl)
  const dst = if wt >= 0 { repNodeOfTy(wt) } else { -1 }
  const args: Opnd[] = []
  const starts: i32[] = []
  for a in c.callArgs {
    const at = b.length
    starts.push(at)
    const v = if dst >= 0 { deliver(b, a, dst, -1) } else { irBExpr(b, a) }
    if ibMiss != "" { return missRhs("argument") }
    if args.length > 0 && !irBStageLeads(b, at, starts, args, c.callArgs) {
      return missRhs("short-circuit argument after another")
    }
    const p = repPrim(irBOpRep(v))
    if p == null || p != want { return missRhs("intrinsic operand coercion") }
    args.push(v)
  }
  const r: Rhs = {
    nxArgs: args,
    nxOp: pl.niOp,
    nxSel: sel,
    nxWide: pl.niKind == 3,
    nxAt: ix,
  }
  return r
}

// How intrinsic arm `arm` of call name `name` lowers: "op" for one instruction, the integer
// select it is, or null for an arm that is no intrinsic (`none`) or one legacy cannot read (`bad`).
function numIntrSelOf(arm: NumIntrArm, name: string): NumIntrSel | null {
  return match arm {
    "bitcast" | "float" | "int" => "op"
    "intAbs" => "abs"
    "intMinMax" => if name == "max" { "max" } else { "min" }
    "none" | "bad" => null
  }
}

// The prim rep of number kind `k` as the numeric plans name kinds (0 i32, 3 i64, 4 f64,
// 5 f32), or "" for any other kind.
function numKindPrim(k: i32): string {
  if k == 0 { return "i32" }
  if k == 3 { return "i64" }
  if k == 4 { return "f64" }
  if k == 5 { return "f32" }
  return ""
}

// `recv.has(key)` at node `ix` (a call, or a map read's null test) on a map read plainly, with a
// key written as itself (`mapKeyArmOf`), as legacy's `emitMapHas` writes it.
function mapHasRhs(b: i32[], recvIx: i32, keyIx: i32, ix: i32): Rhs {
  const sh = mapRecvShapeOf(recvIx, ibFnIx)
  if sh == -3 { return missRhs("map has value type") }
  const ka = mapKeyArmOf(recvIx, keyIx, ibFnIx, sh)
  if ka != "plain" && ka != "i64" { return missRhs("map key " + ka) }
  const rk = mapRecvKeyOf(b, recvIx, keyIx, "map has receiver", ka == "i64")
  if rk == null { return missRhs(ibMiss) }
  const r: Rhs = {
    mhSym: rk.mkSym,
    mhNonNull: rk.mkNonNull,
    mhLoc: rk.mkLoc,
    mhRecv: recvIx,
    mhKey: rk.mkKey,
    mhAt: ix,
  }
  return r
}

// `m.delete(k)` on legacy's arm: its receiver and key as `m.has(k)` takes them.
function mapDeleteRhs(b: i32[], recvIx: i32, keyIx: i32, ix: i32): Rhs {
  const sh = mapRecvShapeOf(recvIx, ibFnIx)
  if sh == -3 { return missRhs("map delete value type") }
  const ka = mapKeyArmOf(recvIx, keyIx, ibFnIx, sh)
  if ka != "plain" && ka != "i64" { return missRhs("map key " + ka) }
  const rk = mapRecvKeyOf(b, recvIx, keyIx, "map delete receiver", ka == "i64")
  if rk == null { return missRhs(ibMiss) }
  const r: Rhs = {
    mdSym: rk.mkSym,
    mdNonNull: rk.mkNonNull,
    mdLoc: rk.mkLoc,
    mdRecv: recvIx,
    mdKey: rk.mkKey,
    mdAt: ix,
  }
  return r
}

// `.map`/`.filter` on legacy's arm (`mapFilterWhy`): the receiver, then a function-typed binding as
// the callback's value, or the `null` immediate for a capture-free function the lowering builds.
function mapFilterRhs(b: i32[], c: Call, m: Member, ix: i32): Rhs {
  const why = mapFilterWhy(ix, ibFnIx)
  // A call yielding the callback is written as legacy writes a plain function value (`fnValuePlain`).
  const callCb = why == "map callback expression"
    && nodeAt(unwrapParen(c.callArgs[0])) is Call
    && fnValuePlain(c.callArgs[0], 0)
  if why != "" && why != "map callback env" && !callCb { return missRhs(why) }
  const v = irBExpr(b, m.memObj)
  if ibMiss != "" { return missRhs("method operand") }
  if !(repNodeAt(irBOpRep(v)) is RList) { return missRhs("map receiver rep") }
  const at = b.length
  const cb = unwrapParen(c.callArgs[0])
  if cb < 0 || cb >= P.nodes.length { return missRhs("map callback") }
  let f: Opnd = { oiRep: ibNoValue, oiBits: 0 }
  if !(nodeAt(cb) is FuncDecl || cbIdentNamesFn(c.callArgs[0], ibFnIx)) {
    f = irBExpr(b, cb)
    if ibMiss != "" { return missRhs("method operand") }
    if ifBelowLead(b, at, "map short-circuit operand") {
      return missRhs("map short-circuit operand")
    }
  }
  // A capturing function literal: its captures, each read where legacy's closure writer reads it.
  let env: Opnd[] = []
  if why == "map callback env" {
    const fe = if nodeAt(cb) is FuncDecl { fnStmtsPosOf(cb) } else { -1 }
    if fe < 0 || fnEnvIdxOf(fe) < 0 || closureValueWhy(fe) != "" {
      return missRhs("map callback env")
    }
    env = cloEnvOf(b, fe, cb)
    if ibMiss != "" { return missRhs(ibMiss) }
    if b.length != at { return missRhs("map callback env read") }
  }
  const r: Rhs = { hfV: v, hfC: f, hfEnv: env, hfAt: ix }
  return r
}

// `m.keys()` or `m.values()` as legacy's writer takes it: the map variable as itself, or a read
// written again as the builder read it (`recvReadsAgain`), since that writer reads its receiver
// once per step; any other receiver is evaluated once (`miOnce`).
function mapIterRhs(b: i32[], m: Member, ix: i32): Rhs {
  if mapShapeOfExpr(m.memObj, ibFnIx) == -3 {
    return missRhs("map iter value type")
  }
  const at = b.length
  const v = irBExpr(b, m.memObj)
  if ibMiss != "" { return missRhs("method operand") }
  const temp = v is OVar && v.ov >= 0 && ib.irVars[v.ov].vKind == "temp"
  const again = temp && recvReadsAgain(unwrapParen(m.memObj))
  if !(v is OVar) || b.length != at && !temp {
    return missRhs("map iter receiver")
  }
  if !(repNodeAt(irBOpRep(v)) is RMap) {
    return missRhs("map iter receiver rep")
  }
  const once = temp && !again
  const r: Rhs = {
    miV: v,
    miAt: ix,
    miVals: m.memProp == "values",
    miOnce: once,
  }
  return r
}

// A list `.slice` on legacy's arm (`callIsArrSlice`): the receiver, then its i32 bounds.
function listSliceRhs(b: i32[], c: Call, m: Member, ix: i32): Rhs {
  const starts = [b.length]
  const v = irBExpr(b, m.memObj)
  if ibMiss != "" { return missRhs("method operand") }
  if !(repNodeAt(irBOpRep(v)) is RList) { return missRhs("slice receiver rep") }
  const ops = [v]
  if (
    !stagedOperands(
      b,
      ops,
      starts,
      [m.memObj],
      c.callArgs,
      "slice short-circuit operand",
    )
  ) {
    return missRhs(ibMiss)
  }
  const args = ops.slice(1)
  for a in args {
    if repPrim(irBOpRep(a)) != "i32" { return missRhs("slice bound coercion") }
  }
  const r: Rhs = { scV: ops[0], scArgs: args, scAt: ix }
  return r
}

// Builds the operands `ixs` after `ops` (built from `starts`, for nodes `opIxs`), each earlier
// operand staged below a later one that holds a valued `if`, a `??`, a store or a stash, as a
// call's arguments are (`irBStageLeads`). False, with `why` the miss, when one cannot be.
function stagedOperands(
  b: i32[],
  ops: Opnd[],
  starts: i32[],
  opIxs: i32[],
  ixs: i32[],
  why: string,
): boolean {
  for a in ixs {
    const at = b.length
    starts.push(at)
    const o = irBExpr(b, a)
    if ibMiss != "" { return false }
    if !irBStageLeads(b, at, starts, ops, opIxs) {
      irBMiss(why)
      return false
    }
    ops.push(o)
    opIxs.push(a)
  }
  return true
}

// A string method legacy's call ladder takes by name (`exprIsStrMethod`): its receiver and
// arguments, then legacy's own tail. Any other method is a miss that names it.
function methodRhs(b: i32[], c: Call, m: Member, ix: i32): Rhs {
  // A push onto a list; a record's function-valued field named `push` is the closure call below.
  const listPush = m.memProp == "push"
    && repNodeAt(repNodeOfTy(nodeTyAt(m.memObj, ibFnIx))) is RList
  // Several arguments, or a spread, append in bulk: legacy's `emitPushMany`.
  if (listPush && (c.callArgs.length != 1 || nodeAt(c.callArgs[0]) is Spread)) {
    return pushManyRhs(b, m, ix)
  }
  if (
    listPush
    && c.callArgs.length == 1
    && !(nodeAt(c.callArgs[0]) is Spread)
  ) {
    return pushRhs(b, c, m, ix)
  }
  if m.memProp == "pop" && c.callArgs.length == 0 {
    return popValueRhs(b, m, ix)
  }
  if (
    m.memProp == "get"
    && c.callArgs.length == 1
    && popRecvIsList(m.memObj, ibFnIx)
  ) {
    return getValueRhs(b, c, m, ix)
  }
  if m.memProp == "has" && c.callArgs.length == 1 && exprMap(m.memObj, ibFnIx) {
    return mapHasRhs(b, m.memObj, c.callArgs[0], ix)
  }
  if (
    m.memProp == "delete"
    && c.callArgs.length == 1
    && exprMap(m.memObj, ibFnIx)
  ) {
    return mapDeleteRhs(b, m.memObj, c.callArgs[0], ix)
  }
  if m.memProp == "map" || m.memProp == "filter" {
    return mapFilterRhs(b, c, m, ix)
  }
  if (
    (m.memProp == "keys" || m.memProp == "values")
    && c.callArgs.length == 0
    && exprMap(m.memObj, ibFnIx)
  ) {
    return mapIterRhs(b, m, ix)
  }
  if !exprIsStrMethod(ix, ibFnIx, "slice") && callIsArrSlice(ix, ibFnIx) {
    return listSliceRhs(b, c, m, ix)
  }
  let op: StrOp = "slice"
  if exprIsStrMethod(ix, ibFnIx, "cpLen") {
    op = "cplen"
  } else if (
    exprIsStrMethod(ix, ibFnIx, "charCodeAt")
    && c.callArgs.length == 1
  ) {
    op = "charcode"
  } else if exprIsStrMethod(ix, ibFnIx, "cpAt") && c.callArgs.length == 1 {
    op = "cpat"
  } else if (
    exprIsStrMethod(ix, ibFnIx, "isCharBoundary")
    && c.callArgs.length == 1
  ) {
    op = "charbound"
  } else if exprIsStrMethod(ix, ibFnIx, "bytes") && c.callArgs.length == 0 {
    op = "bytes"
  } else if exprIsStrIndexOf(ix, ibFnIx) && c.callArgs.length == 1 {
    op = if m.memProp == "includes" { "includes" } else { "indexof" }
  } else if !exprIsStrMethod(ix, ibFnIx, "slice") {
    // A function-valued field of a record, called through its closure as legacy's `emitCallRef`.
    if callRefPlainKey(ix, ibFnIx) != "" { return closureCallRhs(b, c, ix) }
    // A field holding a returned record whole, which `emitCallCore` sends to `emitCallRef`, is
    // called at its member, as `emitHolderCall` reads it.
    if holderCallSigs(ix, ibFnIx).length > 0 && fieldCallRoutesRef(c, ix) {
      return holderCallRhs(b, c, ix)
    }
    // A call through a field no function reaches is `unreachable` (`emitNullCalleeCall`), padded
    // with a second where the call is typed `never` (`callEndsNever`).
    if callCalleeDead(ix, c, ibFnIx) {
      return { dnAt: ix, dnPad: callEndsNever(ix) }
    }
    callSplitRefuse(c, ix)
    return missRhs("method " + m.memProp)
  }
  const starts = [b.length]
  const args: Opnd[] = [irBExpr(b, m.memObj)]
  if ibMiss != "" { return missRhs("method operand") }
  if (
    !stagedOperands(
      b,
      args,
      starts,
      [m.memObj],
      c.callArgs,
      "method short-circuit operand",
    )
  ) {
    return missRhs(ibMiss)
  }
  // The receiver is a string, a needle a string, and every other argument an i32.
  const argPrim = if op == "indexof" || op == "includes" { "str" } else { "i32" }
  let i = 0
  while i < args.length {
    const p = repPrim(irBOpRep(args[i]))
    if p == null || (if i == 0 { p != "str" } else { p != argPrim }) {
      return missRhs("method operand coercion")
    }
    i = i + 1
  }
  const r: Rhs = { soOp: op, soArgs: args, soAt: ix }
  return r
}

// Whether call `c` is a no-argument `.pop()`.
function isPopStmt(c: Call): boolean {
  if c.callFn < 0 || c.callArgs.length != 0 { return false }
  const f = nodeAt(c.callFn)
  return f is Member && f.memProp == "pop"
}

// `print(m[k])` over a scalar-valued map read (`print`'s `mapScalar` arm): the receiver and key,
// then the probe and its value or `null` (`emitPrintScalarMapRead`).
function printMapScalar(b: i32[], argIx: i32, ix: i32) {
  const k = mapReadScalarBoxKind(argIx, ibFnIx)
  const ai = unwrapParen(argIx)
  if k < 0 || ai < 0 || ai >= P.nodes.length { return skip("print mapScalar") }
  const rd = nodeAt(ai)
  if !(rd is Index) { return skip("print mapScalar node") }
  const sh = mapRecvShapeOf(rd.idxArr, ibFnIx)
  const ka = mapKeyArmOf(rd.idxArr, rd.idxIndex, ibFnIx, sh)
  if ka != "plain" && ka != "i64" { return skip("print mapScalar key " + ka) }
  const rk = mapRecvKeyOf(
    b,
    rd.idxArr,
    rd.idxIndex,
    "print mapScalar receiver",
    ka == "i64",
  )
  if rk == null { return skip(ibMiss) }
  const r: Rhs = {
    mtSym: rk.mkSym,
    mtNonNull: rk.mkNonNull,
    mtLoc: rk.mkLoc,
    mtKey: rk.mkKey,
    mtAt: ai,
    mtBox: -1,
    mtRow: false,
    mtTrap: false,
    mtPrint: k,
    mtWhole: false,
  }
  irBNode(b, { efRhs: r }, -1, ibNoValue, ix)
  return 0
}

// Whether call `c` is the `print` builtin, legacy's own arm: one argument, a callee no
// declaration owns, and no pinned template hole.
function isPrintStmt(c: Call): boolean {
  if c.callFn < 0 || c.callArgs.length != 1 { return false }
  const f = nodeAt(c.callFn)
  if !(f is Ident) || f.identName != "print" { return false }
  return identDeclOf(c.callFn) < 0
    && fnIndexOfNode(c.callFn) < 0
    && tplStrHoleOf(c, ibFnIx) < 0
}

// A `print` statement whose arm (`printArmOf`) is a string stream or a scalar import, its
// argument at that arm's rep. Every other arm is a named miss.
function printStmt(b: i32[], c: Call, ix: i32) {
  const arm = printArmOf(c.callArgs[0], ibFnIx)
  if arm == "mapScalar" { return printMapScalar(b, c.callArgs[0], ix) }
  // A `null`-typed argument runs for its effect, then the word `null` (`emitNulNoneForEffect`).
  if arm == "nulNone" {
    const e = nulNoneEffect(b, c.callArgs[0], ix, null)
    if ibMiss != "" { return 0 }
    irBNode(b, { efRhs: { pnV: e, pnAt: ix, pnOpened: -1 } }, -1, ibNoValue, ix)
    return 0
  }
  if arm == "boxNull" { return printBoxNull(b, c.callArgs[0], ix) }
  if arm == "nulRefNiche" { return printNulRefNiche(b, c.callArgs[0], ix) }
  const want = printArmRep(arm)
  if want == "" { return skip("print " + arm) }
  // A `K | null` read out of a wider box converts to the niche first (`emitPrintNulLitUnion`).
  const fromBox = want == "nulAtom"
    && narrowedNulLitPinBoxKey(c.callArgs[0], ibFnIx) != ""
  const unionIf = arm == "union" && nodeAt(unwrapParen(c.callArgs[0])) is IfStmt
  const from = b.length
  // A nullable arm's element read narrowed to the `null` unit prints the element as stored, which
  // holds that null, as legacy's arm reads it.
  const au = unwrapParen(c.callArgs[0])
  const nulElem = (want == "nulBool" || want == "nulStr")
    && au >= 0
    && au < P.nodes.length
    && nodeAt(au) is Index
    && repPrim(exprRepOf(au)) == "null"
  const pm = if nulElem { storageReadEnter(au) } else { storageReadEnter(-1) }
  // An atom arm, or its `K | null`, streams the id its operand is held at (`emitStashAtomId`).
  const asgAtom = if want == "atom" { asgAtomRep(c.callArgs[0]) } else { -1 }
  const v = if unionIf { printUnionIf(b, c.callArgs[0]) } else if fromBox { nulLitNicheRead(b, c.callArgs[0]) } else if asgAtom >= 0 { deliver(b, c.callArgs[0], asgAtom, -1) } else if want == "atom" || want == "nulAtom" { exprAt(b, c.callArgs[0], true) } else { irBExpr(b, c.callArgs[0]) }
  storageReadLeave(pm)
  if ibMiss != "" { return 0 }
  // Legacy opens a nullable string's or boolean's print blocks before its operand, so where the
  // operand wrote a valued `if` (or a stash) the blocks open before it (`RPrintOpen`).
  const opened = if (want == "nulStr" || want == "nulBool") && ifBelowLeadHas(b, from, b.length) { if want == "nulBool" { 1 } else { 0 } } else { -1 }
  if opened >= 0 { printOpenAt(b, from, opened, ix) }
  const vr = irBOpRep(v)
  const p = repPrim(vr)
  let ok = p != null && p == want
  // A boolean read at an i32 rep (a hole instance's parameter) is the same i32 the bool arm prints.
  if want == "bool" && p != null && p == "i32" { ok = true }
  if want == "nulStr" { ok = strNullable(vr) }
  if want == "nulBool" { ok = boolNullable(vr) }
  if want == "atom" { ok = repNodeAt(vr) is RAtom }
  // The `K | null` tail reads an i32 id and tests it for `-1`; an operand already narrowed or
  // coalesced to a plain atom is that id, which the test never matches (`printAtomTail`).
  if want == "nulAtom" { ok = atomNullable(vr) || repNodeAt(vr) is RAtom }
  if want == "union" { ok = repNodeAt(vr) is RBox || boxedNullable(vr) }
  if !ok { return skip("print operand rep") }
  irBNode(
    b,
    { efRhs: { pnV: v, pnAt: ix, pnOpened: opened } },
    -1,
    ibNoValue,
    ix,
  )
  return 0
}

// A `print` of a box an `is` chain narrowed to `null` (`boxNull`): the argument read at its
// storage, the box, printed along the union arm it takes there with the plan's null arm pinned, as
// `emitCallCorePrint` writes it.
function printBoxNull(b: i32[], arg: i32, ix: i32) {
  const mark = storageReadEnter(arg)
  const was = printPlanPinNull(true)
  const inner = printArmOf(arg, ibFnIx)
  const v = if inner == "union" { irBExpr(b, arg) } else { irBMiss("print boxNull arm " + inner) }
  printPlanPinNull(was)
  storageReadLeave(mark)
  if ibMiss != "" { return 0 }
  const vr = irBOpRep(v)
  if !(repNodeAt(vr) is RBox) && !boxedNullable(vr) {
    return skip("print operand rep")
  }
  irBNode(b, { efRhs: { pnV: v, pnAt: ix, pnOpened: -1 } }, -1, ibNoValue, ix)
  return 0
}

// A `print` of a nullable reference whose other arm has no printed form (`nulRefNiche`): the
// argument, then the null test's tail. A name is read at its storage, which holds the nullable
// reference however far the narrowing went, as legacy's read writes it.
function printNulRefNiche(b: i32[], arg: i32, ix: i32) {
  const a = unwrapParen(arg)
  const stored = readNarrowedBoxToNull(arg, ibFnIx)
    || a >= 0 && a < P.nodes.length && nodeAt(a) is Ident
  const mark = if stored { storageReadEnter(arg) } else { storageReadEnter(-1) }
  const v = irBExpr(b, arg)
  storageReadLeave(mark)
  if ibMiss != "" { return 0 }
  if !refNullable(irBOpRep(v)) { return skip("print operand rep") }
  irBNode(b, { efRhs: { pnV: v, pnAt: ix, pnOpened: -1 } }, -1, ibNoValue, ix)
  return 0
}

// The atom an assignment `ix` used as a value writes to its place (a `K` place, or the member
// inside a `K | null` niche), which legacy delivers as the id it is; -1 otherwise.
function asgAtomRep(ix: i32): i32 {
  const a = unwrapParen(ix)
  if a < 0 || a >= P.nodes.length { return -1 }
  const n = nodeAt(a)
  if !(n is BinExpr) || n.binOp != "=" { return -1 }
  return atomOfIdRep(repNodeOfTy(heldTy(exprTyOf(n.binLeft))))
}

// Place `ix`, narrowed to `K | null` out of a wider box, as that niche: read at its storage, the
// box, then converted (`RNicheRead`), as `emitNarrowedNicheRead` writes it.
function nulLitNicheRead(b: i32[], ix: i32): Opnd {
  const rep = repNodeOfTy(heldTy(instanceReadTyOf(ix, ibFnIx)))
  if !atomNullable(rep) { return irBMiss("nullable literal niche rep") }
  const mark = storageReadEnter(ix)
  const o = irBExpr(b, ix)
  storageReadLeave(mark)
  if ibMiss != "" { return o }
  return irBLetTemp(
    b,
    { nrV: o, nrAt: ix, nrKind: NICHE_NUL_LIT, nrRow: false },
    ix,
    rep,
  )
}

// Field or element read `ix` the checker narrowed out of a union box to its niche: the place read
// at its storage, the box, then converted (`RNicheRead`), as `emitNarrowedNicheRead` writes it.
function placeNicheRead(b: i32[], ix: i32): Opnd {
  const nk = placeNicheAtomKind(ix, ibFnIx)
  const rep = exprRepOf(ix)
  if nk < 0 || rep < 0 { return irBMiss("pre-path niche read") }
  const mark = storageReadEnter(ix)
  const o = exprAtPre(b, ix, false, "")
  storageReadLeave(mark)
  if ibMiss != "" { return o }
  if !heldAsBox(irBOpRep(o)) { return irBMiss("pre-path niche read box") }
  return irBLetTemp(b, { nrV: o, nrAt: ix, nrKind: nk, nrRow: true }, ix, rep)
}

// A `print`'s `if` argument at the union arm, as legacy's `emitPrintValueUnion` writes it: at a
// box type, delivered where the checker records its box and else built with each arm boxed at its
// own union (`emitUnionBoxOwed`'s floor); at any other type, as it stands.
function printUnionIf(b: i32[], arg: i32): Opnd {
  if boxTyNameAt(arg) == "" { return irBExpr(b, arg) }
  if !boxOwedAt(arg, ibFnIx) { return irBExpr(b, arg) }
  const ty = instTyOrSelf(exprTyOf(arg), ibFnIx)
  if irTyOpen(ty) { return irBMiss("open temp type") }
  return deliver(b, arg, repNodeOfTy(ty), -1)
}

// `__trap__(msg?)`: its message streamed as a string `print` streams one, then `unreachable`, as
// `emitCallCoreTrap` writes them.
function trapStmt(b: i32[], c: Call, ix: i32) {
  if c.callArgs.length > 1 { return skip("trap arguments") }
  // A function returning `never` has a result legacy pads with its own `unreachable`.
  if ibFnPos >= 0 && fnCheckedRetTy(ibFnPos) == TY_NEVER {
    return skip("trap in a never function")
  }
  if c.callArgs.length == 1 {
    if printArmOf(c.callArgs[0], ibFnIx) != "str" {
      return skip("trap message")
    }
    const v = irBExpr(b, c.callArgs[0])
    if ibMiss != "" { return 0 }
    if repPrim(irBOpRep(v)) != "str" { return skip("trap message rep") }
    irBNode(b, { efRhs: { pnV: v, pnAt: ix, pnOpened: -1 } }, -1, ibNoValue, ix)
  }
  irBNode(b, { tpWhy: 0 }, -1, ibNoValue, ix)
  return 0
}

// `__trap__(msg?)` read as a value: its message streamed, then legacy's `unreachable` for the
// value, padded where the call ends a `never` (`emitCallCoreTrap`, `callEndsNever`).
function trapCallRhs(b: i32[], c: Call, ix: i32): Rhs {
  if c.callArgs.length > 1 { return missRhs("trap arguments") }
  if c.callArgs.length == 1 {
    if printArmOf(c.callArgs[0], ibFnIx) != "str" {
      return missRhs("trap message")
    }
    const v = irBExpr(b, c.callArgs[0])
    if ibMiss != "" { return missRhs("trap message") }
    if repPrim(irBOpRep(v)) != "str" { return missRhs("trap message rep") }
    irBNode(b, { efRhs: { pnV: v, pnAt: ix, pnOpened: -1 } }, -1, ibNoValue, ix)
  }
  const r: Rhs = { dnAt: ix, dnPad: callEndsNever(ix) }
  return r
}

// Places the blocks a nullable print opens (`RPrintOpen`, arm `arm`) at index `at` of body `b`,
// before the operand statements built from there.
function printOpenAt(b: i32[], at: i32, arm: i32, ix: i32) {
  irBNode(b, { efRhs: { poArm: arm } }, -1, ibNoValue, ix)
  const id = b.pop() ?? -1
  let i = b.length
  b.push(id)
  while i > at {
    b[i] = b[i - 1]
    i = i - 1
  }
  b[at] = id
  return 0
}

// The rep a `print` arm the IR builds reads its argument at, or "" for an arm it leaves to legacy.
function printArmRep(arm: PrintArm): string {
  return match arm {
    "str" => "str"
    "f32" => "f32"
    "f64" => "f64"
    "i64" => "i64"
    "bool" => "bool"
    "i32" => "i32"
    "nulStr" => "nulStr"
    "nulBool" => "nulBool"
    "atom" => "atom"
    "nulAtom" | "nulLitPin" => "nulAtom"
    "union" => "union"
    "nulNone" | "nulRefNiche" | "boxNull" | "mapScalar" | "unrenderable" => ""
  }
}

// Whether call statement `c` is legacy's map store by method: 2 for `m.set(k, v)`, 1 for a Set's
// `s.add(k)`, -1 for any other call.
function mapSetCallOf(c: Call): i32 {
  if c.callFn < 0 { return -1 }
  const f = nodeAt(c.callFn)
  if !(f is Member) || !exprMap(f.memObj, ibFnIx) { return -1 }
  if f.memProp == "set" && c.callArgs.length == 2 { return 2 }
  if f.memProp == "add" && c.callArgs.length == 1 { return 1 }
  return -1
}

// A map store `recv[key] = val` (or `.set`, or a Set's `.add` with `val` -1) along legacy's
// plain arms: a map global read plainly, a key written as itself, and a value written as itself
// (`mapSetValArmOf`); the store is legacy's tail.
function mapSet(b: i32[], recv: i32, key: i32, val: i32, ix: i32) {
  const g = mapGlobalOf(recv)
  const recvAt = b.length
  const loc = mapRecvLoc(b, recv, g, "map store receiver")
  if ibMiss != "" { return 0 }
  const sh = mapRecvShapeOf(recv, ibFnIx)
  if sh == -3 { return skip("map store value type") }
  const ka = mapKeyArmOf(recv, key, ibFnIx, sh)
  if ka != "plain" && ka != "i64" { return skip("map key " + ka) }
  let valArm: MapSetValArm = "plain"
  if val >= 0 {
    if mapSetRefIntoMono(recv, val, ibFnIx) {
      return skip("map store ref into a mono map")
    }
    const arm = mapSetValArmOf(
      val,
      ibFnIx,
      sh,
      mapSetAtomVal(recv, ibFnIx),
      mapSetNulBoolVal(recv, ibFnIx),
    )
    // An arm-valued map's literal is built at the slot's variant row, as legacy's coerce builds it
    // (`emitVariantStruct`).
    if arm == "variant" {
      const vc = variantCoerceArmOf(mvValVariantOf(sh), val, ibFnIx)
      if vc != "struct" && vc != "bare" {
        return skip("map store value variant " + vc)
      }
    } else if (
      arm != "plain"
      && arm != "scalar"
      && arm != "union"
      && arm != "atomNull"
      && arm != "boolNull"
    ) {
      return skip("map store value " + arm)
    }
    valArm = arm
    // Legacy unboxes a narrowed arm only on the plain arm (`emitMapSetValExpr`); a union-valued
    // map boxes the value through `emitUnionBoxOwed`, as `mapSetValue` delivers it.
    if arm == "plain" && narrowedArmNeedsUnbox(val, ibFnIx) {
      return skip("map store value unbox")
    }
  } else if !mapRecvIsSet(recv, ibFnIx) {
    return skip("map add of a non-set")
  }
  const at = b.length
  const k = mapKeyAt(b, recv, key, ka == "i64")
  if ibMiss != "" { return 0 }
  const one: Opnd = { oiRep: ibBool, oiBits: 1 }
  const vAt = b.length
  const v0 = if val < 0 { one } else if mapSetVariantLit(recv, val, sh) { mapVariantLit(b, val, sh) } else { mapSetValue(b, val, g, loc, sh, valArm) }
  if ibMiss != "" { return 0 }
  const v = if valArm == "variant" && val >= 0 && !mapSetVariantLit(recv, val, sh) { variantPassValue(v0, val, g, loc) } else { v0 }
  if ibMiss != "" { return 0 }
  if mapRecvReassigned(b, at, loc) { return skip("map receiver reassigned") }
  const nonNull = g >= 0 && globalReadRecovers(sidOfNode(recv), recv, ibFnIx)
  // Legacy writes the receiver and key before the value; a valued `if` the IR writes ahead of
  // the node has them staged below it, in that order (`mapSetStageLeads`).
  const leads: Opnd[] = [loc, k]
  if !mapSetStageLeads(b, recv, key, g, nonNull, recvAt, at, vAt, leads) {
    return 0
  }
  const r: Rhs = {
    msSym: g,
    msNonNull: nonNull,
    msLoc: leads[0],
    msRecv: recv,
    msKey: leads[1],
    msVal: v,
    msAdd: val < 0,
    msPark: false,
  }
  irBNode(b, { efRhs: r }, -1, ibNoValue, ix)
  return 0
}

// A variant map's value `v` of `val` already in its variant's rep, as legacy's pass-through writes
// it (`emitVariantPassThrough`). Legacy's `ref.as_non_null` for a nullable ref niche its read does
// not recover has no witness program, so that case is a named miss. It lands at the map's value
// rep or misses.
function variantPassValue(v: Opnd, val: i32, g: i32, loc: Opnd): Opnd {
  const mr = repNodeAt(
    if g >= 0 { irGlobalRepOf(ib, g) } else { irBOpRep(loc) },
  )
  if !(mr is RMap) { return irBMiss("map store receiver rep") }
  if exprNullableRefNiche(val, ibFnIx) && !readOwesNonNullRecover(val, ibFnIx) {
    return irBMiss("map store value variant bare recover")
  }
  if irBOpRep(v) != mr.rmVal {
    return irBMiss("map store value variant bare rep")
  }
  return v
}

// Map store value `val` into receiver `g` or `loc` of shape `sh` on legacy's arm `arm`
// (`mapSetValArmOf`): as itself, widened to the map's scalar value rep (`emitScalarValue`), or
// boxed into its union value as `emitUnionBoxOwed` boxes it.
function mapSetValue(
  b: i32[],
  val: i32,
  g: i32,
  loc: Opnd,
  sh: i32,
  arm: MapSetValArm,
): Opnd {
  const mr = repNodeAt(
    if g >= 0 { irGlobalRepOf(ib, g) } else { irBOpRep(loc) },
  )
  // A `null` literal on the plain arm is legacy's own null (`nullOwnAt`) at the map's value rep.
  const nul = nodeAt(unwrapParen(val)) is NullLit
  // On the plain arm an atom-valued map's value the atom hook converts is built at the map's
  // value rep by the hook's arm, as `emitExpr` writes it there.
  if (
    arm == "plain"
    && mr is RMap
    && repNodeAt(mr.rmVal) is RAtom
    && exprPrePathWhy(val, ibFnIx) == "pre-path atom hook"
  ) {
    return deliver(b, val, mr.rmVal, -1)
  }
  if (
    arm != "scalar"
    && arm != "union"
    && arm != "atomNull"
    && arm != "boolNull"
    && !(nul && mr is RMap)
  ) {
    return irBExpr(b, val)
  }
  if !(mr is RMap) { return irBMiss("map store receiver rep") }
  // A `null` into an atom- or `boolean | null`-valued map is that value's sentinel, as legacy
  // writes it (`-1`, `2`: `emitNullOwn`'s).
  if arm == "atomNull" || arm == "boolNull" {
    const own = if arm == "atomNull" { NULL_OWN_ATOM } else { NULL_OWN_BOOL }
    if !nullOwnRepFits(own, mr.rmVal) {
      return irBMiss("map store value " + arm + " rep")
    }
    return repTemp(
      b,
      { nuAt: unwrapParen(val), nuOwn: own, nuRead: [] },
      val,
      mr.rmVal,
    )
  }
  const ty = if arm == "union" { mvValTyIxAt(sh) } else { -1 }
  if (
    arm == "union"
    && exprUnion(val, ibFnIx)
    && boxIntoOtherUnion(val, mr.rmVal, ty)
  ) {
    return irBMiss("map store box from a box")
  }
  const v = deliver(b, val, mr.rmVal, ty)
  if ibMiss == "" && irBOpRep(v) != mr.rmVal {
    return irBMiss("map store value " + arm + " rep")
  }
  return v
}

// For a map store whose value from `vAt` holds a valued `if`: the receiver and key `leads` staged
// below it at their starts. A global receiver is its read, at the store's own recovery, as a temp
// (the lowering checks that producer); a nullable map's recovery tail would land above the `if`.
// False after a named miss.
function mapSetStageLeads(
  b: i32[],
  recv: i32,
  key: i32,
  g: i32,
  nonNull: boolean,
  recvAt: i32,
  keyAt: i32,
  vAt: i32,
  leads: Opnd[],
): boolean {
  const why = "map store short-circuit operand"
  // A store the value makes (an assignment as the value) is written in place by legacy, after
  // a receiver and key it reads at their use; the IR's statement would land above them.
  if storeFrom(b, vAt) && !opndsAreTemps(leads) {
    irBMiss("map store value store")
    return false
  }
  const stagingCoal = coalBoxFrom(b, vAt, true)
  if !valuedIfFrom(b, vAt) && !stagingCoal || inPlaceUnstagedFrom(b, vAt) {
    return !ifBelowLead(b, keyAt, why)
  }
  if exprNullableMap(recv, ibFnIx) {
    irBMiss("map store nullable receiver below a short-circuit")
    return false
  }
  const starts: i32[] = [recvAt, keyAt]
  if g >= 0 {
    const rep = irGlobalRepOf(ib, g)
    if rep < 0 {
      irBMiss("map store global rep")
      return false
    }
    const one: i32[] = []
    leads[0] = irBLetTemp(
      one,
      { ggSym: g, ggNonNull: nonNull, ggNn: -1 },
      recv,
      rep,
    )
    if ibMiss != "" || one.length != 1 { return false }
    insertAt(b, recvAt, one[0])
    starts[1] = starts[1] + 1
  }
  // The value starts one node later past an inserted global read.
  const valAt = if g >= 0 { vAt + 1 } else { vAt }
  if !irBStageLeads(b, valAt, starts, leads, [recv, key]) {
    if ibMiss == "" { ifBelowLead(b, valAt, why) }
    return false
  }
  return ibMiss == "" && !ifBelowLeadOf(b, valAt, why, leads)
}

// A `.pop()` at a value position over any list legacy pops (`popAnyPlanOf`): its receiver, then
// legacy's scalar pop tail (`popScalarTail`). A ref or string list is legacy's.
function popValueRhs(b: i32[], m: Member, ix: i32): Rhs {
  if popAnyPlanOf(ix, ibFnIx) == null { return missRhs("method pop") }
  const v = irBExpr(b, m.memObj)
  if ibMiss != "" { return missRhs("method operand") }
  if !(repNodeAt(irBOpRep(v)) is RList) {
    return missRhs("pop operand coercion")
  }
  const r: Rhs = { lqV: v, lqIx: [], lqAt: ix }
  return r
}

// A list `.get(i)` on legacy's arm, `.pop`'s body with a bound (`emitPop`): the receiver, then the
// index, which legacy writes from the call twice, so only an index it re-reads in place is taken.
function getValueRhs(b: i32[], c: Call, m: Member, ix: i32): Rhs {
  if popAnyPlanOf(ix, ibFnIx) == null { return missRhs("method get") }
  const reRead = listGetIdxReReadable(c.callArgs[0])
  const la = b.length
  const v0 = irBExpr(b, m.memObj)
  if ibMiss != "" { return missRhs("method operand") }
  if !(repNodeAt(irBOpRep(v0)) is RList) {
    return missRhs("get operand coercion")
  }
  // Ahead of an index legacy cannot re-read, a receiver read legacy re-reads waits aside while the
  // index builds, and any other is held in a local of its own (`heldInLocal`), so an index's own
  // fused `??` finds no temp waiting.
  const aside: i32[] = []
  const pure = optRecvReReadable(m.memObj)
  if !reRead && pure {
    while b.length > la { aside.push(b.pop() ?? -1) }
  }
  const v = if !reRead && !pure && v0 is OVar { heldInLocal(b, v0, ix) } else { v0 }
  const at = b.length
  const i0 = irBExpr(b, c.callArgs[0])
  if ibMiss != "" { return missRhs("method operand") }
  if irBOpRep(i0) != repNodeOfTy(TY_I32) { return missRhs("get index operand") }
  // An index that built nothing is legacy's own re-read; any other is one temp, written once to a
  // local at its first use (`irGetIdxBegin`), or held in a local of its own after its statements.
  const idxNodes = b.length - at
  const idxOneTemp = oneTempAt(b, at, i0)
  const idxPlain = reRead && idxNodes == 0
  if !idxPlain && !(i0 is OVar) { return missRhs("get index operand") }
  const i = if !idxPlain && !idxOneTemp { heldInLocal(b, i0, ix) } else { i0 }
  if aside.length > 0 {
    const tail: i32[] = []
    if idxNodes == 0 || idxOneTemp {
      while b.length > at { tail.push(b.pop() ?? -1) }
    }
    while aside.length > 0 { b.push(aside.pop() ?? -1) }
    while tail.length > 0 { b.push(tail.pop() ?? -1) }
  }
  const r: Rhs = { lqV: v, lqIx: [i], lqAt: ix }
  return r
}

// Whether body `b` gained exactly one node from `at` on, the `let` defining temp `o`.
function oneTempAt(b: i32[], at: i32, o: Opnd): boolean {
  if b.length != at + 1 || !(o is OVar) || o.ov < 0 { return false }
  const n = ib.irNodes[b[at]]
  return n is SLet && n.lDst == o.ov && ib.irVars[o.ov].vKind == "temp"
}

// Operand `l` of a fused read at node `ix`, which legacy's head reads twice, held in a local of its
// own (the lowering's `ownedSlot`): a later operand's own fused `??` then finds no temp waiting.
function heldInLocal(b: i32[], l: Opnd, ix: i32): Opnd {
  if !(l is OVar) || l.ov < 0 || l.ov >= ib.irVars.length { return l }
  const v = irVarNew(ib, ib.irVars[l.ov].vRep, ib.irVars[l.ov].vTy, "local", -1)
  irBNode(b, { asDst: v, asSrc: l }, -1, ibNoValue, ix)
  const o: Opnd = { ov: v }
  return o
}

// Whether map store value `val` into receiver `recv`'s mv slot `sh` is an object literal legacy
// builds at the slot's variant row (`mapSetValArmOf` `variant`, `variantCoerceArmOf` `struct`).
function mapSetVariantLit(recv: i32, val: i32, sh: i32): boolean {
  const arm = mapSetValArmOf(
    val,
    ibFnIx,
    sh,
    mapSetAtomVal(recv, ibFnIx),
    mapSetNulBoolVal(recv, ibFnIx),
  )
  return arm == "variant"
    && variantCoerceArmOf(mvValVariantOf(sh), val, ibFnIx) == "struct"
}

// Object literal `val` built at mv slot `sh`'s variant row, at the slot's value type's rep.
function mapVariantLit(b: i32[], val: i32, sh: i32): Opnd {
  const pre = exprPrePathWhy(val, ibFnIx)
  if pre != "" { return irBMiss(pre) }
  const ty = mvValTyIxAt(sh)
  if ty < 0 { return irBMiss("map store value type") }
  return objLitAt(
    b,
    unwrapParen(val),
    repNodeOfTy(ty),
    ty,
    mvValVariantOf(sh),
    true,
  )
}

// A `.pop()` statement over any list legacy pops (`popAnyPlanOf`), through legacy's pop tail.
function popStmt(b: i32[], c: Call, ix: i32) {
  const pq = popAnyPlanOf(ix, ibFnIx)
  // No plan is a ref list whose row is not collected.
  if pq == null { return skip("pop ref element") }
  if c.callFn < 0 || c.callFn >= P.nodes.length { return skip("pop callee") }
  const f = nodeAt(c.callFn)
  if !(f is Member) { return skip("pop callee") }
  const v = irBExpr(b, f.memObj)
  if ibMiss != "" { return 0 }
  if !(repNodeAt(irBOpRep(v)) is RList) { return skip("pop operand coercion") }
  irBNode(b, { efRhs: { lqV: v, lqIx: [], lqAt: ix } }, -1, ibNoValue, ix)
  return 0
}

// Whether call `c` is a no-argument `.clear()` on a list, legacy's own gate (`clearRecvIsList`).
function isListClearStmt(c: Call): boolean {
  if c.callFn < 0 || c.callFn >= P.nodes.length || c.callArgs.length != 0 {
    return false
  }
  const f = nodeAt(c.callFn)
  return f is Member
    && f.memProp == "clear"
    && clearRecvIsList(f.memObj, ibFnIx)
}

// A list `.clear()` statement, through legacy's plan (`clearPlanOf`) and length reset.
function clearStmt(b: i32[], c: Call, ix: i32) {
  if clearPlanOf(ix, ibFnIx).clFail != "" { return skip("clear plan") }
  if c.callFn < 0 || c.callFn >= P.nodes.length { return skip("clear callee") }
  const f = nodeAt(c.callFn)
  if !(f is Member) { return skip("clear callee") }
  const v = irBExpr(b, f.memObj)
  if ibMiss != "" { return 0 }
  if !(repNodeAt(irBOpRep(v)) is RList) {
    return skip("clear operand coercion")
  }
  irBNode(b, { efRhs: { lkV: v, lkAt: ix } }, -1, ibNoValue, ix)
  return 0
}

// Whether call `c` is a no-argument `.clear()` on a map or set, legacy's `emitMapClear` arm.
function isMapClearStmt(c: Call): boolean {
  if c.callFn < 0 || c.callFn >= P.nodes.length || c.callArgs.length != 0 {
    return false
  }
  const f = nodeAt(c.callFn)
  return f is Member && f.memProp == "clear" && exprMap(f.memObj, ibFnIx)
}

// A map or set `.clear()` statement: its receiver as a map operation reads it (`mapRecvLoc`), then
// legacy's reset in place (`mapClearTail`).
function mapClearStmt(b: i32[], c: Call, ix: i32) {
  if c.callFn < 0 || c.callFn >= P.nodes.length {
    return skip("map clear callee")
  }
  const f = nodeAt(c.callFn)
  if !(f is Member) { return skip("map clear callee") }
  if mapRecvShapeOf(f.memObj, ibFnIx) == -3 {
    return skip("map clear value type")
  }
  const g = mapGlobalOf(f.memObj)
  const loc = mapRecvLoc(b, f.memObj, g, "map clear receiver")
  if ibMiss != "" { return 0 }
  const nonNull = g >= 0
    && globalReadRecovers(sidOfNode(f.memObj), f.memObj, ibFnIx)
  const r: Rhs = {
    mcSym: g,
    mcNonNull: nonNull,
    mcLoc: loc,
    mcRecv: f.memObj,
    mcAt: ix,
  }
  irBNode(b, { efRhs: r }, -1, ibNoValue, ix)
  return 0
}

// Whether push receiver `recvIx` is a list held in its own local, so no input of
// `listOpRecvHeldPlan` it reaches is emit-time state: a declared local or parameter excludes the
// scope stack and a lifted closure's write slots, an unnarrowed read the fit regions and the
// narrowed union, and an uncaptured one the capture stand-in.
function pushRecvHeldAtRest(recvIx: i32): boolean {
  const n = nodeAt(recvIx)
  if !(n is Ident) || identDeclOf(recvIx) < 0 { return false }
  if declaredSlotOf(recvIx) < 0 && paramIndexOf(ibFnIx, n.identName) < 0 {
    return false
  }
  if (
    readNarrowedTyAt(recvIx, ibFnIx) >= 0
    || identIsEnvCapture(ibFnIx, n.identName)
  ) {
    return false
  }
  return listOpRecvHeldPlan(recvIx, ibFnIx, ".push") >= 0
}

// A `.push` receiver `recv`, its temps noted so the lowering writes any list payload cast in
// them strict, as legacy reads a receiver (`recvReadsListPayload`, `listCastForPush`).
function pushRecvExpr(b: i32[], recv: i32): Opnd {
  const v0 = ib.irVars.length
  const v = irBExpr(b, recv)
  if recvReadsListPayload(recv, ibFnIx) {
    let t = v0
    while t < ib.irVars.length {
      if ib.irVars[t].vKind == "temp" { irPushRecvNote(ib, t) }
      t = t + 1
    }
  }
  return v
}

// A one-argument `.push` legacy writes as the plain append (`pushPlainWhy`): its receiver, then
// its value at the list's element rep.
function pushRhs(b: i32[], c: Call, m: Member, ix: i32): Rhs {
  const pp = pushPlanOf(ix, ibFnIx)
  if pp == null { return missRhs("push plan") }
  const why = pushPlainWhy(pp, ibFnIx)
  // A late receiver held in its own local is read by index after the value either way.
  const late = why == "push late receiver"
  const held = pushRecvHeldAtRest(pp.ppRecv)
  // A nullable element slot's push is legacy's plain build of the value (`pushNestSlot`).
  const nest = why == "push nested list element"
  if why != "" && !late && !nest { return missRhs(why) }
  // Any other late receiver is built after the value, as legacy stages it (D1280).
  if late && !held { return pushLateRhs(b, c, m, ix) }
  const clear = !endsInTemp(b)
  const at = b.length
  const v = pushRecvExpr(b, m.memObj)
  const ln = repNodeAt(irBOpRep(v))
  if ibMiss != "" || !(ln is RList) { return missRhs("push operand coercion") }
  // A packed list's element, at any sub-word width, is pushed as a plain i32, which its backing
  // truncates.
  const er = if repSubWord(ln.rlsElem) { repNodeOfTy(TY_I32) } else { ln.rlsElem }
  const xAt = b.length
  const x0 = deliver(b, c.callArgs[0], er, -1)
  if ibMiss != "" { return missRhs("method operand") }
  // A closure whose rep leaves a part open, or fills one, is the element's closure struct,
  // retagged, as a list literal's element is.
  const holed = irBOpRep(x0) != er
    && repNodeAt(irBOpRep(x0)) is RClosure
    && repNodeAt(er) is RClosure
    && holeRetagNoted(irBOpRep(x0), er, true)
    && exprPrePathWhy(c.callArgs[0], ibFnIx) == ""
  // So is a value that stands at the element's rep (`retagsAsStands`).
  const stands = irBOpRep(x0) != er
    && retagsAsStands(irBOpRep(x0), er, c.callArgs[0])
  const x = if holed || stands { repTemp(b, { rgV: x0 }, c.callArgs[0], er) } else { x0 }
  if irBOpRep(x) != er { return missRhs("push operand coercion") }
  if nest && !pushNullableElemPlain(c.callArgs[0], er) {
    return missRhs("push nullable element coercion")
  }
  // A receiver held in its own local is read by index after the value, as legacy reads it.
  // A value holding a valued `if` stages the receiver below it, as does one holding only a boxed
  // `??` (`coalBoxFrom`).
  const vif = valuedIfFrom(b, xAt)
  const cbx = !vif && (coalBoxFrom(b, xAt, true) || coalBoxFrom(b, xAt, false))
  const recv: PushRecv = if pushRecvHeldAtRest(pp.ppRecv) || !vif && !cbx { v } else { pushStage(b, v, ix, at, xAt, clear, cbx) }
  if ibMiss != "" { return missRhs("push short-circuit operand") }
  // An unstaged receiver is written at its use, above any valued `if` built from `at` on.
  if (
    !(recv is PStaged)
    && !pushRecvHeldAtRest(pp.ppRecv)
    && ifBelowLead(b, at, "push short-circuit operand")
  ) {
    return missRhs("push short-circuit operand")
  }
  const r: Rhs = { lpV: recv, lpX: x, lpAt: ix }
  return r
}

// A `.push` `ix` whose value stages a list receiver of its own: the value at the receiver's element
// rep, then the receiver, so the value's list op cannot overwrite this push's staged receiver.
function pushLateRhs(b: i32[], c: Call, m: Member, ix: i32): Rhs {
  const ln = repNodeAt(exprRepOf(m.memObj))
  if !(ln is RList) { return missRhs("push operand coercion") }
  const er = if repSubWord(ln.rlsElem) { repNodeOfTy(TY_I32) } else { ln.rlsElem }
  const x = deliver(b, c.callArgs[0], er, -1)
  if ibMiss != "" { return missRhs("method operand") }
  if irBOpRep(x) != er { return missRhs("push operand coercion") }
  const at = b.length
  const v = pushRecvExpr(b, m.memObj)
  if ibMiss != "" || irBOpRep(v) != exprRepOf(m.memObj) {
    return missRhs("push operand coercion")
  }
  if ifBelowLead(b, at, "push short-circuit operand") {
    return missRhs("push short-circuit operand")
  }
  const r: Rhs = { lpV: v, lpX: x, lpAt: ix }
  return r
}

// Whether value `argIx` pushed onto a nullable element slot `er` is legacy's plain build of it: at
// its own rep, that ref widened to its nullable (no bytes), or a bare `null` as the slot's null ref.
function pushNullableElemPlain(argIx: i32, er: i32): boolean {
  const a = exprRepOf(argIx)
  if a == er { return true }
  const n = repNodeAt(er)
  if !(n is RNullable) || !refNullable(er) { return false }
  return n.rnInner == a || nodeAt(unwrapParen(argIx)) is NullLit
}

// A variadic push `ix` (`emitPushMany`): the receiver, then the run legacy builds of the
// arguments (`pushManyRunLit`) at the receiver's list build, appended in bulk.
function pushManyRhs(b: i32[], m: Member, ix: i32): Rhs {
  const lb = pushManyRunBuild(ix, ibFnIx)
  if lb == null { return missRhs("push many receiver") }
  const at = b.length
  const v = pushRecvExpr(b, m.memObj)
  if ibMiss != "" || !(repNodeAt(irBOpRep(v)) is RList) {
    return missRhs("push many receiver rep")
  }
  const lit = pushManyRunLit(ix, ibFnIx)
  const ln = if lit >= 0 && lit < P.nodes.length { nodeAt(lit) } else { null }
  if !(ln is ArrayLit) { return missRhs("push many run") }
  const xAt = b.length
  // The run is a synthesized literal no checker stamp reaches: it is typed at its receiver's list.
  const rt = heldTy(nodeTyAt(m.memObj, ibFnIx))
  const l = arrayLit(b, ln, lit, irBOpRep(v), lb, rt)
  if ibMiss != "" { return missRhs(ibMiss) }
  if irBOpRep(l) != irBOpRep(v) { return missRhs("push many run rep") }
  // The receiver is staged before the run, so a valued `if` the run writes would sit above it.
  if (
    valuedIfFrom(b, xAt)
    || ifBelowLead(b, at, "push many short-circuit operand")
  ) {
    return missRhs("push many short-circuit operand")
  }
  const r: Rhs = { pmV: v, pmL: l, pmAt: ix }
  return r
}

// Push `ix`'s receiver `v` staged into its frame slot at `xAt`, before a valued `if` or boxed `??`
// (`coal`) its value writes, as legacy stages it. Nothing may be live below it (`clear`); an `if`
// in the receiver's nodes, or an in-place operand after it, is a miss (with `coal`, only a stage).
function pushStage(
  b: i32[],
  v: Opnd,
  ix: i32,
  at: i32,
  xAt: i32,
  clear: boolean,
  coal: boolean,
): PushRecv {
  if !clear { irBMiss("push stage after an operand") }
  let i = at
  while ibMiss == "" && i < xAt {
    const n = ib.irNodes[b[i]]
    if n is SIf && n.siOut >= 0 || n is SCoalBox || n is SArmSite {
      irBMiss("push short-circuit receiver")
    }
    i = i + 1
  }
  if (
    ibMiss == ""
    && (if coal { receiverStageFrom(b, xAt) } else { inPlaceFrom(b, xAt) })
  ) {
    irBMiss("push stage below a boxed coalesce")
  }
  if ibMiss != "" { return v }
  const one: i32[] = []
  irBNode(one, { efRhs: { rsgV: v, rsgAt: ix } }, -1, ibNoValue, ix)
  if ibMiss != "" || one.length != 1 { return v }
  insertAt(b, xAt, one[0])
  const st: PStaged = { pstNode: one[0] }
  return st
}

// A binary operator legacy writes on its `numUnion` route (`emitNumUnionBin`): each non-literal
// side, a union side already its box and a scalar side already at its kind, then the member
// dispatch. A side legacy converts at the stash is a named miss.
function numUnionBin(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const args: Opnd[] = []
  const at = b.length
  for side in [n.binLeft, n.binRight] {
    const isU = numUnionIsUnionSide(side, ibFnIx)
    if isU && !numUnionSideBoxed(side, ibFnIx) {
      return irBMiss("numeric union side box")
    }
    if !isU && numUnionSideLit(side) { continue }
    const o = irBExpr(b, side)
    if ibMiss != "" { return o }
    if isU && !(repNodeAt(irBOpRep(o)) is RBox) {
      return irBMiss("numeric union side box")
    }
    if !isU {
      const p = numUnionSidePrim(side)
      const op = repPrim(irBOpRep(o))
      if p == "" || op == null || op != p {
        return irBMiss("numeric union side coercion")
      }
    }
    args.push(o)
  }
  if (
    args.length == 2
    && ifBelowLeadOf(b, at, "numeric union right side", [args[0]])
  ) {
    return irBMiss("numeric union right side")
  }
  if primRepOf(ix) != rep { return irBMiss("numeric union result rep") }
  return irBLetTemp(b, { nbArgs: args, nbAt: ix }, ix, rep)
}

// A function-value `==`/`!=` legacy writes on its `closure` route (`emitClosureEq`): each closure
// as built. An operand legacy recovers after its read (`eqOperandRecovers`) is a named miss.
function closureEq(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  if repPrim(rep) != "bool" { return irBMiss("function compare result rep") }
  if (
    eqOperandRecovers(n.binLeft, ibFnIx)
    || eqOperandRecovers(n.binRight, ibFnIx)
  ) {
    return irBMiss("function compare recovered operand")
  }
  const l = irBExpr(b, n.binLeft)
  if ibMiss != "" { return l }
  const at = b.length
  const r = irBExpr(b, n.binRight)
  if ibMiss != "" { return r }
  if ifBelowLeadOf(b, at, "function compare right operand", [l]) { return r }
  if (
    !(repNodeAt(irBOpRep(l)) is RClosure)
    || !(repNodeAt(irBOpRep(r)) is RClosure)
  ) {
    return irBMiss("function compare operand rep")
  }
  return irBLetTemp(b, { cqL: l, cqR: r, cqAt: ix }, ix, rep)
}

// A reference identity on legacy's `identRef` or per-arm `identMixed` route: each operand as
// `emitExpr` builds it, the payload read and the compare the lowering's (`RIdentityEq`).
function identityEq(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  if repPrim(rep) != "bool" { return irBMiss("identity compare result rep") }
  const l = irBExpr(b, n.binLeft)
  if ibMiss != "" { return l }
  const at = b.length
  const r = irBExpr(b, n.binRight)
  if ibMiss != "" { return r }
  if ifBelowLeadOf(b, at, "identity compare right operand", [l]) { return r }
  // An operand legacy reads by its box's payload must be the box; a read narrowed out of a
  // union's storage is built at its member, which legacy does not push.
  if (
    identityOperandUnboxes(n.binLeft, ibFnIx) && !heldAsBox(irBOpRep(l))
    || identityOperandUnboxes(n.binRight, ibFnIx) && !heldAsBox(irBOpRep(r))
  ) {
    return irBMiss("identity compare narrowed box operand")
  }
  return irBLetTemp(b, { ieL: l, ieR: r, ieAt: ix }, ix, rep)
}

// A `==`/`!=` legacy writes on its `structEq` or `variantEq` route (`emitStructEq` over the route's
// eq row `row`): an operand it stashes is built as a value, and one it re-reads at every field
// (`structEqStagesLeft`/`Right`) must be a variable, read from its local. A field or index place
// re-read is a named miss.
function structEqOp(b: i32[], n: BinExpr, ix: i32, rep: i32, row: i32): Opnd {
  return structEqOpAt(b, n, ix, rep, row, false)
}

// `structEqOp`, `nul` the nullable records' guarded compare (`emitNulStructEq`), which reads no
// operand at a ref list element place.
function structEqOpAt(
  b: i32[],
  n: BinExpr,
  ix: i32,
  rep: i32,
  row: i32,
  nul: boolean,
): Opnd {
  if repPrim(rep) != "bool" { return irBMiss("record compare result rep") }
  const lS = structEqStagesLeft(n.binLeft, n.binRight)
  const rS = structEqStagesRight(n.binRight)
  const lAt = b.length
  const ls = structEqSide(b, n.binLeft, lS)
  if ibMiss != "" { return ls[0] }
  const at = b.length
  const rs = structEqSide(b, n.binRight, rS)
  if ibMiss != "" { return rs[0] }
  // A stashed left is written ahead of the right's valued `if`: staged below it (`irBStageLeads`).
  const leads: Opnd[] = [ls[0]]
  if (
    rS
    && lS
    && ls.length == 1
    && !irBStageLeads(b, at, [lAt], leads, [n.binLeft])
  ) {
    return irBMiss("record compare right operand")
  }
  if (
    rS
    && lS
    && ls.length > 1
    && ifBelowLeadOf(b, at, "record compare right operand", ls)
  ) {
    return ls[0]
  }
  const l = leads[0]
  const r = rs[0]
  if repIsScalar(irBOpRep(l)) || repIsScalar(irBOpRep(r)) {
    return irBMiss("record compare operand rep")
  }
  const lIx: Opnd[] = []
  const rIx: Opnd[] = []
  if ls.length > 1 { lIx.push(ls[1]) }
  if rs.length > 1 { rIx.push(rs[1]) }
  if (
    nul
    && (lIx.length > 0 && !eqElemNullTestOk(n.binLeft, ibFnIx)
      || rIx.length > 0 && !eqElemNullTestOk(n.binRight, ibFnIx))
  ) {
    return irBMiss("nullable record eq element place")
  }
  // A bare record beside a nullable one is legacy's same guard over a non-null side, written
  // with locals the IR does not declare: a named miss until it does.
  return irBLetTemp(
    b,
    {
      seL: l,
      seR: r,
      seAt: ix,
      seRow: row,
      seLIx: lIx,
      seRIx: rIx,
      seNul: nul,
    },
    ix,
    rep,
  )
}

// A record compare's operand `ix`, `[value]`: as built where legacy stashes it (`staged`). One it
// re-reads at every field must build to a variable and nothing else, or be a plain ref list read
// (`refListReadPlain`) over a variable at a variable or immediate index, `[receiver, index]`.
function structEqSide(b: i32[], ix: i32, staged: boolean): Opnd[] {
  const at = b.length
  if !staged && refListReadPlain(ix, ibFnIx) {
    const nd = nodeAt(ix)
    if !(nd is Index) { return [irBMiss("record compare place operand")] }
    const v = irBExpr(b, nd.idxArr)
    if ibMiss != "" { return [v] }
    const recv = structEqVarOpnd(v) && b.length == at
      || structEqPlaceRead(b, at, v, nd.idxArr)
    const mid = b.length
    const i = irBExpr(b, nd.idxIndex)
    if ibMiss != "" { return [i] }
    const idx = i is OImm
      || structEqVarOpnd(i) && b.length == mid
      || structEqPlaceRead(b, mid, i, nd.idxIndex)
    if !recv || !idx { return [irBMiss("record compare element place")] }
    return [v, i]
  }
  const o = irBExpr(b, ix)
  if ibMiss != "" { return [o] }
  const place = structEqVarOpnd(o) && b.length == at
    || structEqPlaceRead(b, at, o, ix)
  // An optional chain no stash or place holds is written once to a fresh local (`structEq`).
  const once = nodeAt(unwrapParen(ix)) is OptMember
    && structEqOnceRep(irBOpRep(o))
  if !staged && !place && !once {
    return [irBMiss("record compare place operand")]
  }
  return [o]
}

// Whether a record compare side at rep `r` is a record or its nullable, which a fresh local holds.
function structEqOnceRep(r: i32): boolean {
  const n = repNodeAt(r)
  if n is RRecord { return true }
  return n is RNullable && n.rnDisc == 1 && repNodeAt(n.rnInner) is RRecord
}

// Whether operand `o`, built from `b[at]` on for node `ix`, is a place legacy re-reads at each
// field (`structEqRoots` at the place): a name's global read, a variable or a narrowed nullable
// variable's read, under a chain of field reads, each one `let` of `b` in order.
function structEqPlaceRead(b: i32[], at: i32, o: Opnd, ix: i32): boolean {
  let m = nodeAt(unwrapParen(ix))
  while m is Member { m = nodeAt(unwrapParen(m.memObj)) }
  if !(m is Ident) || !(o is OVar) { return false }
  let v = o.ov
  let k = b.length - 1
  while k >= at {
    const n = ib.irNodes[b[k]]
    if !(n is SLet) || n.lDst != v { return false }
    const r = n.lRhs
    if r is RGlobalGet { return k == at }
    if r is RRecover { return k == at && structEqVarOpnd(r.rcV) }
    if !(r is RGetField) || !(r.gfV is OVar) { return false }
    if structEqVarOpnd(r.gfV) { return k == at }
    v = r.gfV.ov
    k = k - 1
  }
  return false
}

// Legacy's atom tower over local `ix` (`strToAtomArmOf`'s `chain`) at atom destination `dst`:
// the local's string read built once per tested member, last first as the tower writes them; a
// second build is legal only of a read with no effect (`exprEffectFree`).
function atomTower(b: i32[], ix: i32, dst: i32, ty: i32): Opnd {
  const n = nodeAt(ix)
  const k = strToAtomTexts(ix).length - 1
  if k < 1 { return irBMiss("atom tower members") }
  if k > 1 && !exprEffectFree(ix) { return irBMiss("atom tower place") }
  const none: Opnd = { oiRep: ibNoValue, oiBits: 0 }
  const reads: Opnd[] = []
  while reads.length < k { reads.push(none) }
  let i = k - 1
  while i >= 0 {
    const at = b.length
    // A place other than a name is read past its tower hook, the string legacy's tower reads again.
    const rd = if n is Ident { identRead(b, n, ix, repNodeOfTy(TY_STR), false) } else { exprAtPre(b, ix, false, "") }
    if ibMiss != "" { return rd }
    if repPrim(irBOpRep(rd)) != "str" { return irBMiss("atom tower read rep") }
    // A read this build minted is the raw string legacy reads, so it is typed at the string.
    if (
      b.length > at
      && rd is OVar
      && rd.ov >= 0
      && rd.ov < ib.irVars.length
      && ib.irVars[rd.ov].vKind == "temp"
    ) {
      ib.irVars[rd.ov].vTy = TY_STR
    }
    reads[i] = rd
    i = i - 1
  }
  return irBLetTempTy(b, { saReads: reads, saAt: ix }, ix, dst, ty)
}

// Whether operand `o` is a variable (no temp), which a record compare re-reads from its local.
function structEqVarOpnd(o: Opnd): boolean {
  return o is OVar
    && o.ov >= 0
    && o.ov < ib.irVars.length
    && ib.irVars[o.ov].vKind != "temp"
}

// A `==`/`!=` legacy writes on its `nulNiche` route (`emitNulNicheEq`): each operand as
// `emitEqOperandRaw` writes it, the right twice, a variable read again and another pure operand
// built again, as legacy writes it again. A nullable record's compare is a named miss.
function nulNicheEq(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const why = nulNicheEqWhy(ix, ibFnIx)
  // Two nullable records compare field-wise under a nullness guard (`emitNulStructEq`).
  if why == "nullable record eq" {
    const row = nulStructEqRowOf(ix, ibFnIx)
    if row == NUL_STRUCT_EQ_NO_ROW { return irBMiss("nullable record eq row") }
    return structEqOpAt(b, n, ix, rep, row, true)
  }
  if why != "" { return irBMiss(why) }
  if repPrim(rep) != "bool" { return irBMiss("nullable eq result rep") }
  const l = eqOperandRaw(b, n.binLeft)
  const at = b.length
  const r = eqOperandRaw(b, n.binRight)
  if ibMiss != "" { return l }
  const plain = b.length == at
    && r is OVar
    && r.ov >= 0
    && r.ov < ib.irVars.length
    && ib.irVars[r.ov].vKind != "temp"
  // A second build of a pure operand mints nothing a first did not (`exprEffectFree`), nor does a
  // call's over pure arguments: each build is written on the path that reads it, as legacy's are.
  if !plain && !exprEffectFree(n.binRight) && !callOfPureArgs(n.binRight) {
    return irBMiss("nullable eq right operand")
  }
  const r2 = if plain { r } else { eqOperandRaw(b, n.binRight) }
  if ibMiss != "" { return l }
  return irBLetTemp(b, { neL: l, neR: r, neR2: r2, neAt: ix }, ix, rep)
}

// Whether `ix` is a call each of whose arguments is effect-free (`exprEffectFree`).
function callOfPureArgs(ix: i32): boolean {
  const c = nodeAt(unwrapParen(ix))
  if !(c is Call) { return false }
  for a in c.callArgs {
    if !exprEffectFree(a) { return false }
  }
  return true
}

// A scalar map read against a plain operand (`eqRouteOf`'s `scalarMap`, its `read` arm), as
// `emitScalarMapReadOtherEq` writes it: the operand and the probe in source order.
function scalarMapEq(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const p = scalarMapEqPlanOf(n, ibFnIx)
  if p.smArm != "read" { return irBMiss("scalar map compare " + p.smArm) }
  const k = p.smKind
  if k != 0 && k != 1 { return irBMiss("scalar map compare kind") }
  if rep != ibBool { return irBMiss("scalar map compare rep") }
  const rd = nodeAt(unwrapParen(p.smRead))
  if !(rd is Index) { return irBMiss("scalar map compare read") }
  const ka = mapKeyArmOf(
    rd.idxArr,
    rd.idxIndex,
    ibFnIx,
    mapRecvShapeOf(rd.idxArr, ibFnIx),
  )
  if ka != "plain" { return irBMiss("map key " + ka) }
  const left = p.smRead == n.binLeft
  const none: Opnd = { oiRep: ibNoValue, oiBits: 0 }
  const o1 = if left { none } else { scalarMapEqOther(b, p.smOther, k) }
  if ibMiss != "" { return o1 }
  const rk = mapRecvKeyOf(
    b,
    rd.idxArr,
    rd.idxIndex,
    "map compare receiver",
    false,
  )
  if rk == null { return irBMiss(ibMiss) }
  const o = if left { scalarMapEqOther(b, p.smOther, k) } else { o1 }
  if ibMiss != "" { return o }
  const r: Rhs = {
    mqSym: rk.mkSym,
    mqNonNull: rk.mkNonNull,
    mqLoc: rk.mkLoc,
    mqKey: rk.mkKey,
    mqOther: o,
    mqAt: ix,
  }
  return irBLetTemp(b, r, ix, rep)
}

// A scalar map compare's operand of kind `k` (an i32 or a boolean), read in place by the lowering.
function scalarMapEqOther(b: i32[], ix: i32, k: i32): Opnd {
  const at = b.length
  const o = irBExpr(b, ix)
  if ibMiss != "" { return o }
  const want = if k == 1 { irBOpRep(o) == ibBool } else { repPrim(irBOpRep(o)) == "i32" }
  if b.length != at || !(o is OVar || o is OImm) || !want {
    return irBMiss("scalar map compare operand")
  }
  return o
}

// An operand of legacy's guarded compare as `emitEqOperandRaw` writes it: an atom it decodes
// (`eqOperandDecodes`) at its string, nullable where its plan's `null` is (`atomStrPlanOf`), else
// its value.
function eqOperandRaw(b: i32[], ix: i32): Opnd {
  if !eqOperandDecodes(ix, ibFnIx) { return irBExpr(b, ix) }
  const ty = if atomStrPlanOf(ix, ibFnIx, false).apNul { TY_NUL_STR } else { TY_STR }
  return deliver(b, ix, repNodeOfTy(ty), ty)
}

// A `==`/`!=` legacy writes on its numeric tail (`eqRouteOf`'s `numeric`) over a `boolean | null`
// niche and a bool or another niche, or over two operands at one `i32` or `bool` cell (a function
// set's ids): each operand's cell, then the plain compare.
function nicheBoolEq(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const p = binPrimOp(n.binOp, false)
  if p == null { return irBMiss("operator " + n.binOp) }
  const ls = b.length
  const l0 = irBExpr(b, n.binLeft)
  const at = b.length
  const r = irBExpr(b, n.binRight)
  if ibMiss != "" { return l0 }
  const lead = [l0]
  if !stageLeftBelow(b, ls, at, lead, n.binLeft) { return l0 }
  const l = lead[0]
  const lr = irBOpRep(l)
  const rr = irBOpRep(r)
  const ln = repBoolNiche(lr)
  const rn = repBoolNiche(rr)
  const lp = repPrim(lr)
  const cell = lr == rr && lp != null && (lp == "i32" || lp == "bool")
  const niche = (ln || rn)
    && (ln || repPrim(lr) == "bool")
    && (rn || repPrim(rr) == "bool")
  if !cell && !niche { return irBMiss(OPERAND_TYPE) }
  return irBLetTemp(b, { poOp: p, poArgs: [l, r] }, ix, rep)
}

function binIsCompare(op: string): boolean {
  return op == "=="
    || op == "!="
    || op == "<"
    || op == "<="
    || op == ">"
    || op == ">="
}

// Why operand `ix` is outside the set, or "": it must be typed at a numeric primitive or
// `boolean`, whose signedness picks the op (`opUnsigned`).
function operandWhy(ix: i32): string {
  const p = tyScalarBasePrim(nodeTyAt(ix, ibFnIx))
  if p == null { return OPERAND_TYPE }
  const ps: string = p
  if isNumericPrim(ps) || ps == "boolean" { return "" }
  return "operand at " + ps
}

const STR_OPERAND = "operand at string"
const OPERAND_TYPE = "operand type"

// The rep of binary `n`'s operator width (`binNumWidth`) where an operand has it and the two
// differ, else -1.
function binWidthRep(n: BinExpr): i32 {
  const lr = primRepOf(n.binLeft)
  const rr = primRepOf(n.binRight)
  if lr == rr || lr < 0 || rr < 0 { return -1 }
  const w = binNumWidth(n, ibFnIx)
  // Each primitive is narrowed to a plain string before the compare (D16822).
  const lp = repPrim(lr)
  const rp = repPrim(rr)
  if lp != null {
    const ls: string = lp
    if ls == w { return lr }
  }
  if rp != null {
    const rs: string = rp
    if rs == w { return rr }
  }
  return -1
}

function irRepOtherThan(ix: i32, r: i32): boolean { return primRepOf(ix) != r }

// Whether an atom at rep `sr` read at rep `dst` is legacy's atom decode: an atom at a string, or
// its `K | null` at a `string | null`.
function atomAtStr(sr: i32, dst: i32): boolean {
  return repNodeAt(sr) is RAtom && (repPrim(dst) == "str" || strNullable(dst))
    || atomNullable(sr) && strNullable(dst)
}

// Atom `v`, node `ix`'s value, decoded at string rep `dst` as legacy's `emitAtomToStr` decodes it.
function atomToStr(b: i32[], v: Opnd, ix: i32, dst: i32): Opnd {
  if !exprIsLitAtom(ix, ibFnIx) { return irBMiss("atom string source") }
  // The decode's `null` comes from the plan, which the verifier cannot see.
  if atomStrPlanOf(ix, ibFnIx, false).apNul && !strNullable(dst) {
    return irBMiss("atom decode nullable into a non-null string")
  }
  return repTemp(b, { sxV: v, sxAt: ix }, ix, dst)
}

// The value of `ix` delivered at a plain string: an atom decodes to its member string.
export function deliverStr(b: i32[], ix: i32): Opnd {
  return deliver(b, ix, repNodeOfTy(TY_STR), TY_STR)
}

// Value `e` a union list's element is built from for its box (a literal's element, a store's value):
// a `null` literal has no value of its own, so the box writer writes the null tag alone.
function unionElemValue(b: i32[], e: i32): Opnd {
  if nodeAt(unwrapParen(e)) is NullLit {
    const none: Opnd = { oiRep: ibNoValue, oiBits: 0 }
    return none
  }
  return irBExpr(b, e)
}

// Whether `ix` is a list literal with a record literal among its elements.
function listLitHoldsObjLit(ix: i32): boolean {
  const n = nodeAt(unwrapParen(ix))
  if !(n is ArrayLit) { return false }
  for e in n.arrElems {
    if nodeAt(unwrapParen(e)) is ObjLit { return true }
  }
  return false
}

// Whether rep `r` is a record or a nullable record.
function recordRepOrNull(r: i32): boolean {
  const n = repNodeAt(r)
  return n is RRecord || n is RNullable && repNodeAt(n.rnInner) is RRecord
}

// The value of `ix` delivered at rep `dst`: as built, or widened where legacy widens it, through
// `widenPlanOf`'s `plain` arm. Its literal arms write the constant at the destination width with
// legacy's own literal writers, which the IR does not share yet, so each is a named miss.
function deliver(b: i32[], ix: i32, dst: i32, dstTy: i32): Opnd {
  // A value a dead `never` read feeds is legacy's `unreachable` at its consumer's rep, which
  // writes no conversion after it.
  if ibMiss == "" && dst >= 0 && exprReadsDeadNever(ix, ibFnIx) {
    return deadNeverTemp(b, ix, dst)
  }
  // A `??` whose own type has no rep (a link legacy mints) is built at the destination's rep, as
  // legacy writes it at the kind its consumer asks.
  const du = unwrapParen(ix)
  const dn = if du >= 0 && du < P.nodes.length { nodeAt(du) } else { null }
  // An assignment delivered at its place's atom is that atom's id, not the string its type reps.
  if ibMiss == "" && dst >= 0 && dn is BinExpr && asgAtomRep(du) == dst {
    return assignValue(b, dn, du, dst)
  }
  if (
    ibMiss == ""
    && dst >= 0
    && dn is BinExpr
    && dn.binOp == "??"
    && exprRepOf(du) < 0
  ) {
    // At a box, a map read's `??` is built at the map's value rep and boxed as that member.
    const lr = nodeAt(unwrapParen(dn.binLeft))
    const vr = if heldAsBox(dst) && lr is Index { repNodeOfTy(tyMapValOf(mapRecvTyIn(lr.idxArr, ibFnIx))) } else { -1 }
    if vr >= 0 {
      const v = coalesce(b, dn, du, vr, false)
      if ibMiss != "" { return v }
      return boxTemp(b, v, du, dst)
    }
    return coalesce(b, dn, du, dst, false)
  }
  // A value `if` whose own type has no rep (a list whose element nothing fixes) is built at the
  // destination's rep, each arm delivered there.
  if ibMiss == "" && dst >= 0 && dn is IfStmt && exprRepOf(du) < 0 {
    return ifExprAt(b, dn, du, dst, repTyOf(dst))
  }
  // A read the checker narrowed to `null` is the destination's null where legacy's `nullread` arm
  // writes one (`nullReadDstOwnOf`), not its storage's.
  const nro = if ibMiss == "" && dst >= 0 { nullReadOwnAt(ix) } else { -1 }
  if nro >= 0 {
    if !nullOwnRepFits(nro, dst) { return irBMiss("null read destination rep") }
    return repTemp(
      b,
      { nuAt: unwrapParen(ix), nuOwn: nro, nuRead: [] },
      ix,
      dst,
    )
  }
  // Else the storage read is that null, the local as it stands (`identReadArmOf` past the null).
  if nro == NULL_READ_STORED {
    // A union destination whose box plan writes the null's own tag leaves the storage unread.
    if (
      heldAsBox(dst)
      && holeBoxPlanOf(ix, holeBoxTyAt(ix, ibFnIx), ibFnIx).hbArm == "null"
    ) {
      return boxTemp(b, { oiRep: ibNoValue, oiBits: 0 }, ix, dst)
    }
    // The `null` unit holds that null alone, written as its own (`ref.null`), the storage unread.
    if dst == repNodeOfNullUnit() {
      return repTemp(
        b,
        { nuAt: unwrapParen(ix), nuOwn: NULL_OWN_NONE, nuRead: [] },
        ix,
        dst,
      )
    }
    const sv = exprAt(b, ix, true)
    // At the `null` unit the storage read is returned as it stands: a fresh binding takes it at
    // its storage row (`localStoredAt`), as legacy declares that local; any other consumer
    // checks the rep it gets.
    if ibMiss == "" && irBOpRep(sv) != dst && repPrim(dst) != "null" {
      return irBMiss("null read storage rep")
    }
    return sv
  }
  // A `null` literal into a `K | null`, a `boolean | null`, a `string | null`, a nullable
  // reference or the `null` unit is legacy's own null (`nullOwnAt`): a sentinel, the string's
  // typed null ref, or the bottom ref.
  if ibMiss == "" && dst >= 0 && nodeAt(unwrapParen(ix)) is NullLit {
    const atom = atomNullable(dst)
    const ref = refNullable(dst) || repPrim(dst) == "null"
    const bool = boolNullable(dst)
    const lit = unwrapParen(ix)
    const own = if atom || ref || bool || strNullable(dst) { nullOwnAt(lit, ibFnIx) } else { -1 }
    const want = if atom { NULL_OWN_ATOM } else if ref { NULL_OWN_NONE } else if bool { NULL_OWN_BOOL } else { NULL_OWN_STR }
    if own == want {
      return repTemp(b, { nuAt: lit, nuOwn: own, nuRead: [] }, ix, dst)
    }
    // A `null` naming no null of its own is the bottom ref, which a nullable string also holds
    // (`emitNullAt`).
    if own == NULL_OWN_NONE && strNullable(dst) {
      return repTemp(b, { nuAt: lit, nuOwn: own, nuRead: [] }, ix, dst)
    }
  }
  // A `null` literal has no value of its own: the box writer writes the null tag alone.
  if ibMiss == "" && dst >= 0 && nodeAt(unwrapParen(ix)) is NullLit {
    if heldAsBox(dst) && boxOwedAt(ix, ibFnIx) {
      const none: Opnd = { oiRep: ibNoValue, oiBits: 0 }
      return boxTemp(b, none, ix, dst)
    }
  }
  // A function literal or name with no type of its own (a generic hole's) is the closure value
  // its destination holds, which legacy's `emitClosureValue` writes whatever the hole.
  if (
    ibMiss == ""
    && dst >= 0
    && repNodeAt(dst) is RClosure
    && untypedCloValue(ix)
  ) {
    // A hole function's value is typed at the field's own rep where the row's site type, which
    // another instance may have set, is not it.
    const hole = holeCloTy(nodeTyAt(unwrapParen(ix), ibFnIx))
    const ty = if dstTy >= 0 && !(hole && repNodeOfTy(dstTy) != dst) { dstTy } else { repTyOf(dst) }
    return cloValue(b, unwrapParen(ix), dst, ty)
  }
  // A name the checker coerced to return `void` is its void twin's closure, whose own rep is the
  // destination's (`fnValueArmOf`'s `twin`).
  if (
    ibMiss == ""
    && dst >= 0
    && repNodeAt(dst) is RClosure
    && cloValueIsTwin(unwrapParen(ix))
    && instanceAt(unwrapParen(ix), dst)
  ) {
    const ty = if dstTy >= 0 && repNodeOfTy(dstTy) == dst { dstTy } else { repTyOf(dst) }
    return cloValue(b, unwrapParen(ix), dst, ty)
  }
  // A function name typed as a tagged set's id, read where the set marks no leaf, is the closure
  // its destination holds: legacy's `emitIdentNode` writes `emitClosureValue` whatever the type.
  if (
    ibMiss == ""
    && dst >= 0
    && repNodeAt(dst) is RClosure
    && taggedNameCloValue(ix)
  ) {
    const ty = if dstTy >= 0 && repNodeOfTy(dstTy) == dst { dstTy } else { repTyOf(dst) }
    return cloValue(b, unwrapParen(ix), dst, ty)
  }
  // A box local narrowed to a record arm at a record destination: the box, then the table's
  // unbox to the arm's record (`narrowedArmNeedsUnbox`, `emitCoerced`'s `unbox`).
  if ibMiss == "" && armUnboxOwed(ix, dst) {
    return armUnboxTemp(b, ix, dst, dstTy, false)
  }
  // A union whose every arm is a record stored at a record destination's heap (D16321): the box,
  // then the table's cast to that heap.
  if ibMiss == "" && recordArmsUnboxOwed(ix, dst) {
    return recordArmsUnboxTemp(b, ix, dst, dstTy)
  }
  // A box local narrowed to a record arm, delivered as it stands: legacy reads the box itself,
  // not the record its narrowing unboxes to at a record destination.
  const bx = unwrapParen(ix)
  if (
    ibMiss == ""
    && dst >= 0
    && bx >= 0
    && bx < P.nodes.length
    && heldAsBox(dst)
    && boxOwedAt(ix, ibFnIx)
    && narrowedBoxVariantPlain(bx, ibFnIx) >= 0
    && holeBoxPlanOf(ix, holeBoxTyAt(ix, ibFnIx), ibFnIx).hbArm == "pass"
  ) {
    return boxTemp(b, irBBoxLocal(b, bx), ix, dst)
  }
  // An element or field the box plan passes is the box its list or record holds, as legacy reads
  // it. The plan is asked last: it is dear, and most deliveries are neither.
  const ex = unwrapParen(ix)
  const pn = if ibMiss == "" && dst >= 0 && ex >= 0 && ex < P.nodes.length && heldAsBox(dst) { nodeAt(ex) } else { null }
  const lr = if pn is Index { repNodeAt(repNodeOfTy(nodeTyAt(pn.idxArr, ibFnIx))) } else { null }
  const er = if lr is RList && heldAsBox(lr.rlsElem) { lr.rlsElem } else { -1 }
  const fr = if pn is Member { rawFieldRepOf(ex) } else { -1 }
  if (
    (er >= 0 || fr >= 0 && heldAsBox(fr))
    && exprPrePathWhy(ex, ibFnIx) == ""
    && boxOwedAt(ix, ibFnIx)
    && holeBoxPlanOf(ix, holeBoxTyAt(ix, ibFnIx), ibFnIx).hbArm == "pass"
  ) {
    const pv = if er >= 0 { irIndexHook(b, ex, er) } else { irMemberHook(b, ex, fr) }
    if ibMiss != "" { return pv }
    return boxTemp(b, pv, ix, dst)
  }
  // An else-less `if` into a box is legacy's union coercion of the join, its `else` the null box,
  // at the union the box ladder below boxes at.
  if ibMiss == "" && dst >= 0 && heldAsBox(dst) {
    const eu = if boxOwedAt(ix, ibFnIx) { holeBoxTyAt(ix, ibFnIx) } else if dstTy >= 0 { dstTy } else { repTyOf(dst) }
    const en = nodeAt(unwrapParen(ix))
    if en is IfStmt && eu >= 0 && elseLessUnionIfWhy(ix, ibFnIx, eu) == "" {
      return elseLessUnionIf(b, en, unwrapParen(ix), dst, eu)
    }
    // One with an `else` is legacy's `emitUnionIfValue` at that union, each arm boxed there.
    if (
      en is IfStmt
      && eu >= 0
      && repNodeOfTy(eu) == dst
      && unionIfAtDstWhy(ix, ibFnIx, eu) == ""
      && holeBoxPlanOf(ix, eu, ibFnIx).hbArm == "ladder"
    ) {
      return unionIfLink(b, en, unwrapParen(ix), dst, eu, eu, true)
    }
  }
  // A literal the box plan boxes as another variant arm is built at that arm's row, as legacy's
  // `emitVariantStruct` builds it.
  if ibMiss == "" && dst >= 0 && heldAsBox(dst) && boxOwedAt(ix, ibFnIx) {
    const vi = boxLitArmRow(ix)
    if vi >= 0 {
      return boxTempAt(b, objLitAtVariantRow(b, ix, vi), ix, dst, vi)
    }
  }
  // A `Map()` whose own type has no rep (its key and value come from the destination) is built at
  // the destination's map, then widened to a nullable map, as legacy writes it there.
  const mnu = unwrapParen(ix)
  const mnc = if mnu >= 0 && mnu < P.nodes.length { nodeAt(mnu) } else { null }
  if (
    ibMiss == ""
    && dst >= 0
    && mnc is Call
    && mapNewCall(mnc)
    && exprRepOf(ix) < 0
  ) {
    const md = repNodeAt(dst)
    const mr = if md is RMap { dst } else if md is RNullable && repNodeAt(md.rnInner) is RMap { md.rnInner } else { -1 }
    if mr >= 0 {
      const mv = irBLetTempTy(b, { mnAt: mnu }, mnu, mr, repTyOf(mr))
      return widenTo(b, mv, ix, dst, dstTy)
    }
  }
  // At an open destination the atom hook's node is built at its own atom rep, the type the hook
  // converts it to; the destination then takes that value as it takes any.
  if (
    ibMiss == ""
    && dst >= 0
    && repNodeAt(dst) is RUnsup
    && exprPrePathWhy(ix, ibFnIx) == "pre-path atom hook"
  ) {
    const own = exprRepOf(ix)
    if own >= 0 && repNodeAt(own) is RAtom { return deliver(b, ix, own, -1) }
  }
  // At a `K | null` destination the atom hook's node is built at `K` by its arm, then widened.
  if (
    ibMiss == ""
    && dst >= 0
    && atomNullable(dst)
    && exprPrePathWhy(ix, ibFnIx) == "pre-path atom hook"
  ) {
    const dnn = repNodeAt(dst)
    if dnn is RNullable && repNodeAt(dnn.rnInner) is RAtom {
      const av = deliver(b, ix, dnn.rnInner, -1)
      return widenTo(b, av, ix, dst, dstTy)
    }
  }
  // At an atom destination the atom hook's node (`exprPrePathWhy`) is built by its arm. A join is
  // built at the destination, each arm delivered there (a member literal as its id), as legacy's
  // `emitIfExprAs` writes it (`litJoin`, `perArmJoin`); a one-literal place is its member's id,
  // unread (`sole`).
  if (
    ibMiss == ""
    && dst >= 0
    && repNodeAt(dst) is RAtom
    && exprPrePathWhy(ix, ibFnIx) == "pre-path atom hook"
  ) {
    const arm = atomHookArmOf(ix, ibFnIx, false)
    const jn = nodeAt(unwrapParen(ix))
    const jt = if dstTy >= 0 { dstTy } else { repTyOf(dst) }
    if (arm == "litJoin" || arm == "perArmJoin") && jn is IfStmt && jt >= 0 {
      return ifExprAt(b, jn, unwrapParen(ix), dst, jt)
    }
    if arm == "strToAtom" && strToAtomArmOf(unwrapParen(ix)) == "sole" {
      return irBLetTempTy(b, { asAt: unwrapParen(ix) }, ix, dst, jt)
    }
    if arm == "strToAtom" && strToAtomArmOf(unwrapParen(ix)) == "chain" {
      return atomTower(b, unwrapParen(ix), dst, jt)
    }
    if arm == "wideLit" && !(jn is StrLit) {
      const wv = exprAtPre(b, unwrapParen(ix), false, "")
      if ibMiss != "" { return wv }
      if irBOpRep(wv) == ibNoValue { return irBMiss("wide literal read rep") }
      return irBLetTempTy(b, { awV: wv, awAt: unwrapParen(ix) }, ix, dst, jt)
    }
    if arm == "strToAtom" && strToAtomArmOf(unwrapParen(ix)) == "staged" {
      const sv = exprAtPre(b, unwrapParen(ix), false, "")
      if ibMiss != "" { return sv }
      if repPrim(irBOpRep(sv)) != "str" {
        return irBMiss("staged atom value rep")
      }
      return irBLetTempTy(b, { zsV: sv, zsAt: unwrapParen(ix) }, ix, dst, jt)
    }
  }
  // A string literal legacy writes as an atom (`strLitTakesAtom`) into an atom destination is that
  // atom, though its own type reps as a string: a field typed by one bare literal (D7440).
  if ibMiss == "" && dst >= 0 && repNodeAt(dst) is RAtom {
    const sl = unwrapParen(ix)
    if (
      sl >= 0
      && sl < P.nodes.length
      && nodeAt(sl) is StrLit
      && exprPrePathWhy(sl, ibFnIx) == ""
      && strLitTakesAtom(sl, ibFnIx)
      && !(repNodeAt(exprRepOf(sl)) is RAtom)
    ) {
      const a: Opnd = { osAt: sl, osRep: dst }
      return a
    }
  }
  // A scalar map read the box plan boxes is the probe's own box.
  if ibMiss == "" && dst >= 0 && boxedNullable(dst) {
    const mk = mapReadBoxKindAt(ix)
    if mk >= 0 {
      return mapGetAt(b, unwrapParen(ix), dst, mk, true, -1, false, false)
    }
  }
  // A union-valued map read the box plan takes whole (`mapBox`) is its stored box, a miss the
  // null-tagged box, past any narrowing its plain read unboxes (`emitMapGetUnionBox`).
  if ibMiss == "" && dst >= 0 && heldAsBox(dst) {
    const vt = mapBoxValTyAt(ix)
    if vt >= 0 {
      const mv = mapGetAt(
        b,
        unwrapParen(ix),
        repNodeOfTy(vt),
        -1,
        false,
        vt,
        false,
        true,
      )
      if ibMiss != "" { return mv }
      return boxTemp(b, mv, ix, dst)
    }
  }
  // A member record read the box plan passes as its field's box is built at its storage.
  if ibMiss == "" && dst >= 0 && heldAsBox(dst) && memberBoxReadAt(ix, ibFnIx) {
    return memberBoxTemp(b, ix, dst)
  }
  if ibMiss == "" && dst >= 0 && repNodeAt(dst) is RRecord {
    const ot = objLitTwinTyAt(ix, dst, dstTy)
    if ot >= 0 {
      return objLitAt(
        b,
        unwrapParen(ix),
        dst,
        ot,
        objLitLayoutRowOf(unwrapParen(ix), ibFnIx),
        false,
      )
    }
  }
  // A `Map()` whose own type is left open is built at its destination's map, where legacy's
  // constructor writes it.
  const mc = unwrapParen(ix)
  if (
    ibMiss == ""
    && dst >= 0
    && repNodeAt(dst) is RMap
    && mapCtorOf(mc)
    && exprRepOf(mc) < 0
    && exprPrePathWhy(mc, ibFnIx) == ""
  ) {
    const mt = if dstTy >= 0 && repNodeOfTy(dstTy) == dst { dstTy } else { repTyOf(dst) }
    return irBLetTempTy(b, { mnAt: mc }, ix, dst, mt)
  }
  // A hole's map read `l ?? d` into a box is legacy's null-test `if` (`coalHoleMapIfOf`), each
  // arm delivered into the box.
  const hm = if ibMiss == "" && dst >= 0 && heldAsBox(dst) { holeMapIfAt(ix) } else { -1 }
  if hm >= 0 { return deliver(b, hm, dst, dstTy) }
  const at = b.length
  // A union map read boxed at its record (`emitCoerced`), or at the destination's union where none
  // is owed, is the box ladder's own read.
  const outer = ib.irUnbankedRead
  if dst >= 0 && heldAsBox(dst) {
    const ut = if boxOwedAt(ix, ibFnIx) { holeBoxTyAt(ix, ibFnIx) } else if dstTy >= 0 { dstTy } else { repTyOf(dst) }
    if unionBoxArgReadsMapBox(ut, ix, ibFnIx) {
      ib.irUnbankedRead = unwrapParen(ix)
    }
  }
  // A box narrowed to an arm the plan re-boxes under a wider one (`narrowBox`) is read as the box
  // it is stored as, whose payload the box takes, as legacy reads it (`emitUnionWideArmBox`).
  const nbox = dst >= 0
    && heldAsBox(dst)
    && nodeAt(unwrapParen(ix)) is Ident
    && holeBoxPlanOf(ix, holeBoxTyAt(ix, ibFnIx), ibFnIx).hbArm
    == "narrowBox"
  const mark = if nbox { storageReadEnter(unwrapParen(ix)) } else { storageReadEnter(-1) }
  const v0 = exprAt(b, ix, true)
  storageReadLeave(mark)
  const v = widenTo(b, v0, ix, dst, dstTy)
  ib.irUnbankedRead = outer
  if (
    ibMiss == ""
    && boxLeadsAt(b, at)
    && !boxTagLateAt(b, at)
    && !boxOfJoinAt(b, at)
  ) {
    boxLateAt(b, at)
  }
  // A `null`-typed value is the bottom ref, which a nullable reference holds as it stands (D1567).
  if (
    ibMiss == ""
    && dst >= 0
    && irBOpRep(v) != dst
    && repNullRefFits(irBOpRep(v), dst)
  ) {
    return repTemp(b, { rgV: v }, ix, dst)
  }
  return v
}

// The null-test `if` of `??` node `ix` along the `holeMap` arm, or -1.
function holeMapIfAt(ix: i32): i32 {
  const u = unwrapParen(ix)
  if u < 0 || u >= P.nodes.length { return -1 }
  const n = nodeAt(u)
  if !(n is BinExpr) || n.binOp != "??" || n.binCompound.length != 0 {
    return -1
  }
  if coalArmOf(n, u, ibFnIx) != "holeMap" { return -1 }
  return coalHoleMapIfOf(n, u, ibFnIx)
}

// The type a struct literal `ix` is built at for record destination `dst` (`dstTy`, else the
// rep's type) where its own rep is another: legacy builds it at a row (`objLitLayoutRowOf`) whose
// type is stored at the destination type's heap (`recordHeapOfTy`), so it is that record; or -1.
function objLitTwinTyAt(ix: i32, dst: i32, dstTy: i32): i32 {
  return objLitTwinTyAtRow(ix, dst, dstTy, -1)
}

// `objLitTwinTyAt` where the destination's struct row is `dstRow` (legacy's, at least 0), whose
// heap stands for the destination type's: a hole parameter's row, which its type cannot name. With
// a row, a literal whose own rep is the destination's is built there too, not at its row's type.
function objLitTwinTyAtRow(ix: i32, dst: i32, dstTy: i32, dstRow: i32): i32 {
  const ol = unwrapParen(ix)
  if ol < 0 || ol >= P.nodes.length || !(nodeAt(ol) is ObjLit) { return -1 }
  if objLitArmOf(ol, ibFnIx) != "struct" { return -1 }
  if dstRow < 0 && exprRepOf(ol) == dst { return -1 }
  return litTwinTyOnHeap(ol, dst, dstTy, dstRow, false)
}

// A ref list's struct literal element whose own rep or layout row's type is a same-layout twin of
// the element's on the element's heap, as legacy builds it there: the element's type, else -1.
function elemTwinTy(e: i32, er: i32): i32 {
  const ol = unwrapParen(e)
  if ol < 0 || ol >= P.nodes.length || !(nodeAt(ol) is ObjLit) { return -1 }
  if objLitArmOf(ol, ibFnIx) != "struct" { return -1 }
  const row = objLitLayoutRowOf(ol, ibFnIx)
  if row < 0 || row >= sTyIx.length { return -1 }
  if exprRepOf(ol) == er && repNodeOfTy(sTyIx[row]) == er { return -1 }
  return litTwinTyOnHeap(ol, er, -1, -1, true)
}

// `objLitTwinTyAtRow` past its own-rep test: the destination's type where literal `ol`'s layout row
// is stored at the destination's heap, else -1. `ask` reads a heap no type records from legacy.
function litTwinTyOnHeap(
  ol: i32,
  dst: i32,
  dstTy: i32,
  dstRow: i32,
  ask: boolean,
): i32 {
  const dt = if dstTy >= 0 { dstTy } else { repTyOf(dst) }
  if dt < 0 || irTyOpen(dt) || repNodeOfTy(dt) != dst { return -1 }
  const row = objLitLayoutRowOf(ol, ibFnIx)
  if row < 0 || row >= sTyIx.length { return -1 }
  // With `ask`, a type that records no heap of its own is stored at the one legacy asks for it.
  const dh = if dstRow >= 0 && dstRow < sTyIx.length { recordHeapOfTy(sTyIx[dstRow]) } else if dstRow < 0 { recordHeapOfTy(dt) } else { -1 }
  const h = if dh < 0 && dstRow < 0 && ask { recHeapOf(dst) } else { dh }
  const rh = recordHeapOfTy(sTyIx[row])
  const own = if rh < 0 && ask { recHeapOf(repNodeOfTy(sTyIx[row])) } else { rh }
  return if h >= 0 && h == own { dt } else { -1 }
}

// The value-atom kind of map read `ix` where legacy boxes it here by the box plan's `mapScalar`
// arm, else -1.
function mapReadBoxKindAt(ix: i32): i32 {
  const bx = unwrapParen(ix)
  if bx < 0 || bx >= P.nodes.length || !(nodeAt(bx) is Index) { return -1 }
  if !boxOwedAt(ix, ibFnIx) { return -1 }
  const p = holeBoxPlanOf(ix, holeBoxTyAt(ix, ibFnIx), ibFnIx)
  return if p.hbArm == "mapScalar" { p.hbKind } else { -1 }
}

// The value type of union-valued map read `ix` where legacy boxes it here by the box plan's
// `mapBox` arm, else -1.
function mapBoxValTyAt(ix: i32): i32 {
  const bx = unwrapParen(ix)
  if bx < 0 || bx >= P.nodes.length { return -1 }
  const rd = nodeAt(bx)
  if !(rd is Index) || !boxOwedAt(ix, ibFnIx) { return -1 }
  if mapGetArmOf(bx, ibFnIx) != "unionBox" { return -1 }
  if holeBoxPlanOf(ix, holeBoxTyAt(ix, ibFnIx), ibFnIx).hbArm != "mapBox" {
    return -1
  }
  return mapReadValTyOf(bx, ibFnIx)
}

// Member record read `ix` delivered as the box its field holds: the read built at its storage, at
// the field's declared union rep.
function memberBoxTemp(b: i32[], ix: i32, dst: i32): Opnd {
  const marks = memberBoxReadEnter(ix)
  const v = irBExpr(b, ix)
  memberBoxReadLeave(marks)
  if ibMiss != "" { return v }
  const ft = boxedFieldUnionTyOf(ix, ibFnIx)
  if ft < 0 || irBOpRep(v) != repNodeOfTy(ft) {
    return irBMiss("member box rep")
  }
  return boxTemp(b, v, ix, dst)
}

// The variant row the box plan builds object literal `ix` at where that is not the literal's own
// layout (`obj` arm), or -1.
function boxLitArmRow(ix: i32): i32 {
  const lit = unwrapParen(ix)
  if lit < 0 || lit >= P.nodes.length || !(nodeAt(lit) is ObjLit) { return -1 }
  const p = holeBoxPlanOf(ix, holeBoxTyAt(ix, ibFnIx), ibFnIx)
  if p.hbArm != "obj" || objLitVariantLayoutOf(lit, ibFnIx) == p.hbKind {
    return -1
  }
  return p.hbKind
}

// Object literal `ix` built at variant row `vi`, at the row's own type: a box's arm and a literal
// whose own type the row widens are both built where legacy builds them.
function objLitAtVariantRow(b: i32[], ix: i32, vi: i32): Opnd {
  const pre = exprPrePathWhy(ix, ibFnIx)
  if pre != "" { return irBMiss(pre) }
  const ty = if vi < uVarTyIx.length { uVarTyIx[vi] } else { -1 }
  if ty < 0 { return irBMiss("variant row literal type") }
  // In a generic instance the row's registered type may still carry a variable.
  const rep = repNodeOfTy(ty)
  if irTyOpen(ty) || irTyHeldOpen(ty, rep) {
    return irBMiss("open variant row literal type")
  }
  return objLitAt(b, unwrapParen(ix), rep, ty, vi, true)
}

// The literal stash-set record `v` of body `b` builds (`mrAt`), or -1.
function setRecAt(b: i32[], v: Opnd): i32 {
  if !(v is OVar) { return -1 }
  for id in b {
    const n = ib.irNodes[id]
    if n is SLet && n.lDst == v.ov {
      const r = n.lRhs
      return if r is RMakeRec && r.mrSet { r.mrAt } else { -1 }
    }
  }
  return -1
}

// Whether `v` is a record body `b` built with its fields set into the order stash (`mrSet`).
function setRecIn(b: i32[], v: Opnd): boolean {
  if !(v is OVar) { return false }
  for id in b {
    const n = ib.irNodes[id]
    if n is SLet && n.lDst == v.ov {
      const r = n.lRhs
      return r is RMakeRec && r.mrSet
    }
  }
  return false
}

// `v`, built from `ix`, boxed into boxed nullable `dst` by the shared box plan.
function boxTemp(b: i32[], v: Opnd, ix: i32, dst: i32): Opnd {
  return boxTempAt(b, v, ix, dst, -1)
}

// Whether read `v` can be left unread: an immediate or a variable, or a temp `b` defined last by
// a leaf that reads no operand, which is dropped.
function nulReadDropped(b: i32[], v: Opnd): boolean {
  if v is OImm { return true }
  if !(v is OVar) || v.ov < 0 { return false }
  if ib.irVars[v.ov].vKind != "temp" { return true }
  if b.length == 0 { return false }
  const n = ib.irNodes[b[b.length - 1]]
  if !(n is SLet) || n.lDst != v.ov || irRhsOpnds(n.lRhs).length > 0 {
    return false
  }
  b.pop()
  return true
}

// Whether `v` is the temp the last node of `b` defines by a call that never returns.
function neverCallTempIn(b: i32[], v: Opnd): boolean {
  if !(v is OVar) || b.length == 0 { return false }
  const n = ib.irNodes[b[b.length - 1]]
  if !(n is SLet) || n.lDst != v.ov { return false }
  const r = n.lRhs
  return r is RCall && r.caNever || r is RCallRef && r.crNever
}

// Where the last node of `b` defines `v` as the unbox of an assignment's parked box
// (`assignValueBoxedArm`): that node dropped and the box returned; else null.
function parkedBoxOf(b: i32[], v: Opnd): Opnd | null {
  if !(v is OVar) || b.length < 2 { return null }
  const n = ib.irNodes[b[b.length - 1]]
  if !(n is SLet) || n.lDst != v.ov { return null }
  const r = n.lRhs
  if !(r is RBoxNarrow) || r.bnAtom < 0 { return null }
  const pv = r.bnV
  if !(pv is OVar) || !(repNodeAt(irBOpRep(pv)) is RBox) { return null }
  const pn = ib.irNodes[b[b.length - 2]]
  if !(pn is SLet) || pn.lDst != pv.ov || !(pn.lRhs is RAsgParked) {
    return null
  }
  b.pop()
  return pv
}

// `boxTemp` for `v` built at variant row `at`, or at its own layout where `at` is -1.
function boxTempAt(b: i32[], v: Opnd, ix: i32, dst: i32, at: i32): Opnd {
  return boxTempIn(b, v, ix, dst, at, holeBoxTyAt(ix, ibFnIx))
}

// `boxTempAt` into union `uTy`, which legacy's box plan is made at.
function boxTempIn(
  b: i32[],
  v: Opnd,
  ix: i32,
  dst: i32,
  at: i32,
  uTy0: i32,
): Opnd {
  if ibMiss != "" { return v }
  // A value with no recorded box union is boxed into its destination rep's own union.
  const uTy = if uTy0 < 0 { repTyOf(dst) } else { uTy0 }
  // A `null`-typed call is the box ladder's first rung (`emitNulNoneBoxPayload`), the call its
  // payload; any other `null`-typed value stays legacy's.
  if exprIsNulNone(ix, ibFnIx) && heldAsBox(dst) {
    if nodeAt(unwrapParen(ix)) is Call {
      return repTemp(b, { nnV: v, nnPay: true, nnAt: ix }, ix, dst)
    }
    // A name read or a bare `null` writes nothing; its payload is the bottom ref, and the read
    // built for it (a leaf reading no operand) is dropped unread.
    if !nulNoneWritesNothing(ix) || !nulReadDropped(b, v) {
      // Any other `null`-typed value (a valued `if` run for its effects) is run and dropped, and
      // its box is the null box, reading no payload.
      if !(v is OVar) { return irBMiss("box of a null-typed value") }
      const drop: IrNode = { dpV: v }
      irBNode(b, drop, -1, ibNoValue, ix)
      const none: Opnd = { oiRep: irBOpRep(v), oiBits: 0 }
      return repTemp(b, { nnV: none, nnPay: false, nnAt: ix }, ix, dst)
    }
    return repTemp(b, { nnV: v, nnPay: false, nnAt: ix }, ix, dst)
  }
  let p = holeBoxPlanOf(ix, uTy, ibFnIx)
  // A call that never returns has no value to box: its temp takes the box's rep, its consumer's,
  // as legacy writes the call alone (`callIsNever`).
  if neverCallTempIn(b, v) {
    const last = b[b.length - 1]
    if (
      v is OVar
      && v.ov >= 0
      && v.ov < ib.irVars.length
      && last >= 0
      && last < ib.irNodeRep.length
    ) {
      ib.irVars[v.ov].vRep = dst
      ib.irNodeRep[last] = dst
      return v
    }
  }
  // A `null` the builder delivers for a node that is no `null` literal (a binding's absent
  // initializer, an assignment of `null` used as a value) is the destination's null box, as legacy
  // writes a bare `null`; a `null`-unit read that reads nothing is dropped (`nulReadDropped`).
  if (
    p.hbArm == "ladder"
    && nullOwnRepFits(NULL_OWN_BOX, dst)
    && (v is OImm && irBOpRep(v) == ibNoValue
      || repPrim(irBOpRep(v)) == "null" && nulReadDropped(b, v))
  ) {
    return repTemp(
      b,
      { nuAt: unwrapParen(ix), nuOwn: NULL_OWN_BOX, nuRead: [] },
      ix,
      dst,
    )
  }
  // An assignment the ladder would box is boxed as its target's value after its store, on the
  // target's own plan (an `asgLit`, say: the stored literal's box at the target's kind).
  let pAt = ix
  const a0 = nodeAt(unwrapParen(ix))
  if p.hbArm == "ladder" && a0 is BinExpr && a0.binOp == "=" {
    const tgt = unwrapParen(a0.binLeft)
    const tp = if tgt >= 0 && tgt < P.nodes.length && nodeAt(tgt) is Ident { holeBoxPlanOf(tgt, uTy, ibFnIx) } else { p }
    if tp.hbArm == "atom" {
      p = tp
      pAt = tgt
    }
  }
  // An assignment's value unboxed from the box its store parked, where the plan passes a box: that
  // box itself, the unbox dropped (legacy passes the unboxed value, which no box holds).
  if p.hbArm == "pass" {
    const pb = parkedBoxOf(b, v)
    if pb != null {
      // The parked box is the hole's box under its own union's rep: the same box (`RStage`).
      return if irBOpRep(pb) == dst { pb } else { irBLetTempTy(b, { sgV: pb }, ix, dst, repTyOf(dst)) }
    }
  }
  const why = boxPlanWhy(p, v, ix)
  if why != "" { return irBMiss(why) }
  // A box that writes its tag ahead of its value writes it ahead of an assignment's store, which
  // the builder writes first: the lowering writes that tag ahead of the assignment's span.
  const an = nodeAt(unwrapParen(ix))
  const asg = p.hbArm != "pass"
    && p.hbArm != "memberBox"
    && an is BinExpr
    && an.binOp == "="
  if asg && !holeBoxLeads(p.hbArm) { return irBMiss("box of an assignment") }
  const asgSpan = if asg { tagSpanEnding(b, ix) } else { noSpan() }
  if asg && asgSpan.length == 0 {
    return irBMiss("box of an assignment past its span")
  }
  // An operand built before the span is written where it is read, below the head legacy writes
  // after it, which would put the two out of order.
  if p.hbArm == "nulNiche" && nulNicheBoxTagOf(p.hbKind, ix, ibFnIx) < 0 {
    return irBMiss("box niche with no arm")
  }
  // The box writer may leave an immediate unread, so one built for a node with an effect (a
  // stored literal's value) is legacy's to box.
  if (v is OImm || v is OStr) && !exprEffectFree(ix) && !asg {
    return irBMiss("box of an effect's immediate")
  }
  // A literal boxed as its context arm is the IR's record only when it is built at that arm.
  const row = if at >= 0 { at } else { objLitVariantLayoutOf(unwrapParen(ix), ibFnIx) }
  if p.hbArm == "obj" && row != p.hbKind { return irBMiss("box literal arm") }
  // Legacy writes a dispatch whole under the box's leading tag: the lowering writes that tag ahead
  // of the dispatch's first node where the box directly follows its span (`irBoxLeadFirst`).
  const dispatched = p.hbArm != "pass"
    && p.hbArm != "memberBox"
    && exprPrePathWhy(ix, ibFnIx) == "pre-path tag dispatch"
  if dispatched && !holeBoxLeads(p.hbArm) {
    return irBMiss("boxed tag dispatch")
  }
  const span = if dispatched { tagSpanEnding(b, ix) } else { asgSpan }
  if dispatched && span.length == 0 {
    return irBMiss("boxed tag dispatch past its span")
  }
  // Legacy writes the box's leading tag before the stash's field sets; the IR's sets precede it.
  // The lowering writes that tag at the record's first set, for the literal boxed itself.
  const ownLit = (p.hbArm == "rec" || p.hbArm == "obj")
    && setRecAt(b, v) == unwrapParen(ix)
  if (
    p.hbArm != "pass"
    && p.hbArm != "memberBox"
    && setRecIn(b, v)
    && !ownLit
  ) {
    return irBMiss("box of a stash-set record")
  }
  const o = repTemp(
    b,
    {
      bxV: v,
      bxAt: pAt,
      bxTy: uTy,
      bxFree: exprEffectFree(ix) || asgSpan.length > 0,
    },
    ix,
    dst,
  )
  if span.length > 0 {
    ib.irBoxLeadFirst.push(span[0])
    ib.irBoxLeadBox.push(b[b.length - 1])
    ib.irBoxLeadN.push(span[2])
  }
  return o
}

function noSpan(): i32[] { return [] }

// Tag dispatch `ix`'s span (`irTagSpan`) where it is the last run of body `b`, else empty.
function tagSpanEnding(b: i32[], ix: i32): i32[] {
  const s = ib.irTagSpan[unwrapParen(ix)] ?? []
  if s.length != 3 || b.length < s[2] { return noSpan() }
  if b[b.length - 1] != s[1] || b[b.length - s[2]] != s[0] { return noSpan() }
  return s
}

// Notes a tag dispatch's or an assignment value's span at `ix`: the nodes `b` gained from `b0` on.
function tagSpanNote(b: i32[], b0: i32, ix: i32) {
  if ibMiss != "" || b.length <= b0 { return 0 }
  ib.irTagSpan[unwrapParen(ix)] = [b[b0], b[b.length - 1], b.length - b0]
  return 0
}

// Whether the delivery built into `b` from `at` on is a valued `if` or coalesce, its out's numeric
// steps (`numConvSrcOf`), and their box alone, whose head the lowering writes ahead of that join
// (`stashIfBoxHead`), as legacy does.
function boxOfJoinAt(b: i32[], at: i32): boolean {
  let ja = if ifCondLetAt(ib, b, at) { at + 1 } else { at }
  // A coalesce may follow its operand's own nodes, none of them a statement the lead would be
  // written above: the lowering writes the head ahead of the coalesce, which reads them there.
  let q = ja
  while (
    q < b.length
    && !(ib.irNodes[b[q]] is SCoalBox)
    && !(ib.irNodes[b[q]] is SIf)
  ) {
    q = q + 1
  }
  const qn = if q < b.length { ib.irNodes[b[q]] } else { null }
  if (q > ja && qn is SCoalBox && !ifBelowLeadHas(b, ja, q)) { ja = q }
  if b.length < ja + 2 { return false }
  const j = ib.irNodes[b[ja]]
  let out = if j is SIf { j.siOut } else if j is SCoalBox { j.cbOut } else { -1 }
  // Between the join and its box, only one-operand numeric steps of the value before.
  let k = ja + 1
  while k < b.length - 1 {
    const c = ib.irNodes[b[k]]
    if out < 0 || numConvSrcOf(c) != out || !(c is SLet) { return false }
    out = c.lDst
    k = k + 1
  }
  const n = ib.irNodes[b[b.length - 1]]
  if out < 0 || !(n is SLet) { return false }
  const r = n.lRhs
  if !(r is RToBox) { return false }
  const v = r.bxV
  if !(v is OVar) || v.ov != out { return false }
  // Only a box whose head leads its value, or takes its slot ahead of it, has that head written
  // ahead of the join.
  return holeBoxHeadAhead(holeBoxPlanOf(r.bxAt, r.bxTy, ibFnIx).hbArm)
}

// Whether the delivery built into `b` from `at` on ends in a box whose plan's head is its tag alone
// (`boxTagOnly`) over a value holding a statement, which goes late (`boxLateAt`) ahead of the
// head-first arms: those stay for a head that is more than a tag.
function boxTagLateAt(b: i32[], at: i32): boolean {
  if !ifBelowLeadHas(b, at, leadFirstAt(b)) { return false }
  const n = ib.irNodes[b[b.length - 1]]
  if !(n is SLet) { return false }
  const r = n.lRhs
  // A `null`-typed call's box writes the null tag alone ahead of its call.
  if r is RNulNoneBox && r.nnPay {
    ib.irBoxLate.push(unwrapParen(r.nnAt))
    return true
  }
  if (
    !(r is RToBox)
    || !boxTagOnly(holeBoxPlanOf(r.bxAt, r.bxTy, ibFnIx).hbArm)
  ) {
    return false
  }
  ib.irBoxLate.push(unwrapParen(r.bxAt))
  return true
}

// Where the delivery built into `b` from `at` on ends in a box whose head leads and its value's
// own nodes hold a statement (a valued `if` or `??`), notes the box late (`irBoxLate`): its head
// follows the value, which the lowering holds in a local.
function boxLateAt(b: i32[], at: i32) {
  if !ifBelowLeadHas(b, at, leadFirstAt(b)) { return 0 }
  const n = ib.irNodes[b[b.length - 1]]
  if !(n is SLet) { return irBMiss("box of a valued if") }
  const r = n.lRhs
  if !(r is RToBox) {
    return irBMiss("box of a valued if over a null-typed call")
  }
  ib.irBoxLate.push(unwrapParen(r.bxAt))
  return 0
}

// Whether the delivery built into `b` from `at` on ends in a box whose plan writes its tag ahead of
// its value: a valued node built since then has its value written already, under that tag.
function boxLeadsAt(b: i32[], at: i32): boolean {
  if b.length <= at { return false }
  const n = ib.irNodes[b[b.length - 1]]
  if !(n is SLet) { return false }
  const r = n.lRhs
  // A `null`-typed call's box writes its tag ahead of the call (`emitNulNoneBoxPayload`).
  if r is RNulNoneBox { return r.nnPay }
  if !(r is RToBox) { return false }
  const arm = holeBoxPlanOf(r.bxAt, r.bxTy, ibFnIx).hbArm
  return arm != "pass" && arm != "memberBox"
}

// Why box plan `p` does not take operand `v`, or "": a `null` and a literal leave an immediate
// unread, an atom box takes the value at its kind (or at the kind its widening starts from), a
// `K | null` atom its id, and a box passes a box.
function boxPlanWhy(p: HoleBox, v: Opnd, ix: i32): string {
  const r = irBOpRep(v)
  const ok = match p.hbArm {
    "null" => v is OImm && r == ibNoValue
    "lit" => v is OImm
    "pass" | "memberBox" | "retag" | "numRebox" | "narrowBox" => repNodeAt(r) is RBox || boxedNullable(r)
    "atomStr" => atomNullable(r)
    "atomAsStr" => repNodeAt(r) is RAtom
    "nulNiche" => refNullable(r) || strNullable(r)
    "nulBool" => repBoolNiche(r)
    "rec" | "obj" | "recCopy" => repNodeAt(r) is RRecord
    "refList" | "atomList" => repNodeAt(r) is RList
    // A scalar map read is built as the probe's own box (`mapGetAt`), which this plan writes as is.
    "mapScalar" => boxedNullable(r)
    // A union-valued map read is built as its box, a miss the null-tagged box (`mapGetAt`).
    "mapBox" => tempIsWholeMapRead(v, ix)
    "map" => repNodeAt(r) is RMap
    "nulMap" => mapNullable(r)
    "clo" => repNodeAt(r) is RClosure
    // A `boolean | null` read boxes its niche's 0/1 as the boolean atom, as legacy's does.
    "atom" => if p.hbSrc >= 0 { numKindOf(r) == p.hbSrc } else if p.hbKind == V128_ATOM_KIND { repPrim(r) == "v128" } else { holeKindRep(p.hbKind, r) || p.hbKind == 1 && repBoolNiche(r) }
    "ladder" => false
  }
  if ok { return "" }
  return "box " + p.hbArm
}

// Whether rep `r` is a `M | null` map.
function mapNullable(r: i32): boolean {
  const n = repNodeAt(r)
  return n is RNullable && repNodeAt(n.rnInner) is RMap
}

// Whether rep `r` is value-atom kind `k`'s own: `i32`, `boolean`, `string`, or a list's.
function holeKindRep(k: i32, r: i32): boolean {
  // The vector's kind is an atom appended past the list kinds; its payload is the vector.
  if scalarAtomNameOfKind(k) == "v128" { return repPrim(r) == "v128" }
  // A list kind's payload is the list itself, the plan's kind read off the value's own type.
  if k > 5 { return repNodeAt(r) is RList }
  const p = repPrim(r)
  if p == null { return false }
  return k == 0 && p == "i32" || k == 1 && p == "bool" || k == 2 && p == "str"
}

// Whether rep `r` is the one an unbox to value-atom kind `k` leaves: `holeKindRep`'s, or a widened
// number's.
export function irBAtomKindRep(k: i32, r: i32): boolean {
  return holeKindRep(k, r) || k >= 3 && k <= 5 && numKindOf(r) == k
}

// A temp at destination rep `dst`, typed at it, holding `r` for delivery node `ix`.
// Struct row `row`'s field `fi` set to a typed `null` at node `ix`, held at the record's kid rep
// `k`. A kid rep its own type does not intern to is a named miss: the temp would hold a rep its
// type does not name.
function fieldNullTemp(b: i32[], row: i32, fi: i32, ix: i32, k: i32): Opnd {
  if repNodeOfTy(repTyOf(k)) != k { return irBMiss("record field null rep") }
  return repTemp(b, { fnRow: row, fnFi: fi }, ix, k)
}

function repTemp(b: i32[], r: Rhs, ix: i32, dst: i32): Opnd {
  return repTempTy(b, r, ix, dst, repTyOf(dst))
}

// The result type of the callee at `fnStmts` slot `pos` (`resultTy`) where its rep is `sr`, else
// the type that minted `sr` (`repTyOf`).
function calleeResultTyAt(pos: i32, sr: i32): i32 {
  const fn = if pos >= 0 && pos < fnStmts.length { nodeAt(fnStmts[pos]) } else { null }
  const t = if fn is FuncDecl { resultTy(pos, fn.fnRet, fnStmts[pos]) } else { -1 }
  return if t >= 0 && repNodeOfTy(t) == sr { t } else { repTyOf(sr) }
}

// `repTemp` at type `ty`, the delivery's own type whose rep is `dst`: a rep node hash-consed or
// minted inside a recursive cycle can name another type first (`repTyOf`), one of another rep.
function repTempTy(b: i32[], r: Rhs, ix: i32, dst: i32, ty0: i32): Opnd {
  const ty = if ty0 >= 0 && repNodeOfTy(ty0) == dst { ty0 } else { repTyOf(dst) }
  const t = irVarNew(ib, dst, ty, "temp", -1)
  irBNode(b, { lDst: t, lRhs: r }, ty, dst, ix)
  const o: Opnd = { ov: t }
  return o
}

// Whether a box operand built from `ix` into box rep `dst` would change union: with no box recorded
// at the node, it stays as it stands only where legacy's box plan into `dstTy` passes it whole.
// An unknown `dstTy` (-1) reads the union `dst` holds; with neither, it cannot be shown to pass.
function boxIntoOtherUnion(ix: i32, dst: i32, dstTy0: i32): boolean {
  if !(repNodeAt(dst) is RBox) && !boxedNullable(dst) { return false }
  if boxOwedAt(ix, ibFnIx) { return false }
  const dstTy = if dstTy0 < 0 { repTyOf(dst) } else { dstTy0 }
  // A value typed the destination's own union (an `as?` to a sub-union) is that box.
  if dstTy >= 0 && nodeTyAt(unwrapParen(ix), ibFnIx) == dstTy { return false }
  return dstTy < 0 || holeBoxPlanOf(ix, dstTy, ibFnIx).hbArm != "pass"
}

// Whether rep `dst` is the nullable of rep `r`, `r` a scalar.
function nullableOver(dst: i32, r: i32): boolean {
  const n = repNodeAt(dst)
  return repIsScalar(r) && n is RNullable && n.rnInner == r
}

// Whether closure value `v` (node `ix`) is retagged into nullable closure rep `dst` by its niche:
// `dst` holds a closure or `null`, `v` a closure of the one closure struct, delivered plainly.
function cloNicheTakes(v: Opnd, dst: i32, ix: i32): boolean {
  const vr = irBOpRep(v)
  const dn = repNodeAt(dst)
  return vr != dst
    && dn is RNullable
    && dn.rnDisc == 1
    && repNodeAt(dn.rnInner) is RClosure
    && repNodeAt(vr) is RClosure
    && exprPrePathWhy(ix, ibFnIx) == ""
}

// Closure value `v` (node `ix`) retagged to nullable closure rep `dst`'s closure, then into its
// niche (`cloNicheTakes`).
function cloNicheRetag(b: i32[], v: Opnd, dst: i32, ix: i32): Opnd {
  const dn = repNodeAt(dst)
  if !(dn is RNullable) { return irBMiss("closure niche rep") }
  const c = if irBOpRep(v) == dn.rnInner { v } else { repTemp(b, { rgV: v }, ix, dn.rnInner) }
  if irBOpRep(v) != dn.rnInner { irCloFieldRetagNote(ib, b[b.length - 1]) }
  return repTemp(b, { rgV: c }, ix, dst)
}

// The union legacy's field writer boxes literal row `row`'s field `fi` at.
function fieldSiteTy(arm: ObjLitArm, row: i32, fi: i32): i32 {
  return if arm == "variant" { variantFieldBoxTy(row, fi) } else { structFieldBoxTy(row, fi) }
}

// Operand `v`, built from `ix`, widened to rep `dst` as `deliver` widens it.
function widenTo(b: i32[], v: Opnd, ix: i32, dst: i32, dstTy: i32): Opnd {
  if ibMiss != "" || dst < 0 { return v }
  if irBOpRep(v) == dst {
    if boxIntoOtherUnion(ix, dst, dstTy) {
      return irBMiss("box into another union")
    }
    return v
  }
  // The checker records the box at the node; legacy's box writer builds it around the value.
  if heldAsBox(dst) && boxOwedAt(ix, ibFnIx) { return boxTemp(b, v, ix, dst) }
  // An atom into its `K | null` is the same i32, and a reference into its nullable the same ref:
  // legacy's table has no row for either, since a nullable niche is no box (`boxOwedAt`).
  const dn = repNodeAt(dst)
  if (
    dn is RNullable
    && (dn.rnDisc == 3 || strNullable(dst) || refNullable(dst) || boolNullable(dst))
    && dn.rnInner == irBOpRep(v)
  ) {
    if !boxOwedAt(ix, ibFnIx) { return repTemp(b, { rgV: v }, ix, dst) }
  }
  // A record on its nullable's inner heap (`recRetagAt`) is retagged to the inner, then widened.
  if (
    dn is RNullable
    && refNullable(dst)
    && repNodeAt(irBOpRep(v)) is RRecord
    && recRetagAt(irBOpRep(v), dn.rnInner, ix)
    && !boxOwedAt(ix, ibFnIx)
  ) {
    const inner = repTemp(b, { rgV: v }, ix, dn.rnInner)
    return repTemp(b, { rgV: inner }, ix, dst)
  }
  if atomAtStr(irBOpRep(v), dst) { return atomToStr(b, v, ix, dst) }
  // A `K | null` narrowed past its null decodes to a plain string where legacy's plan writes no
  // null (`atomStrPlanOf`), as `atomToStr` checks.
  if atomNullable(irBOpRep(v)) && repPrim(dst) == "str" {
    return atomToStr(b, v, ix, dst)
  }
  const sk = numKindOf(irBOpRep(v))
  const dk = numKindOf(dst)
  // A numeric union's box at a wider number converts at the member it holds, along legacy's plan
  // (`widenPlanOf`'s `convert`), over the box as built (`numUnionSideBoxed`).
  if dk >= 3 && repNodeAt(irBOpRep(v)) is RBox {
    const cp = widenPlanOf(ix, dk, ibFnIx)
    if cp.wpArm != "convert" { return irBMiss("widen box " + cp.wpArm) }
    if !numUnionSideBoxed(ix, ibFnIx) { return irBMiss("widen convert box") }
    // The temp is typed at the destination, whose rep it holds.
    return irBLetTempTy(
      b,
      { nuV: v, nuTo: dk, nuAt: ix },
      ix,
      dst,
      repTyOf(dst),
    )
  }
  if sk < 0 || dk < 3 { return v }
  const p = widenPlanOf(ix, dk, ibFnIx)
  // A stored literal's value is the literal again, built at the destination (`emitAsgLitAs`).
  const asg = nodeAt(unwrapParen(ix))
  if p.wpArm == "asgLit" && v is OImm && asg is BinExpr {
    return signedLitAt(unwrapParen(asg.binRight), dst)
  }
  // A literal in a pinned instance, or a float literal at f32, is the literal again at the
  // destination width (`widenLitAt`).
  if litWidenArm(p.wpArm) && isSignedNumLit(ix) {
    return signedLitAt(unwrapParen(ix), dst)
  }
  // An assignment of a wide cell (`asgRadixWidePrim`) hands on the cell's own read where the
  // width is the cell's, or that read converted; any other width converts the narrowed value
  // (`emitAsgRadixAs`).
  if p.wpArm == "radix" {
    const wk = if p.wpWide == "i64" { 3 } else if p.wpWide == "f64" { 4 } else if p.wpWide == "f32" { 5 } else { -1 }
    if wk < 0 { return irBMiss("widen radix width") }
    if wk == dk || dk == 4 && wk == 3 {
      const wide = radixWideRead(b, v)
      if ibMiss != "" { return wide }
      if wk == dk {
        if irBOpRep(wide) != dst { return irBMiss("widen radix rep") }
        return wide
      }
      return numWidenTemp(b, wide, 3, 4, dst, ix)
    }
    return numWidenTemp(b, v, sk, dk, dst, ix)
  }
  if p.wpArm != "plain" { return irBMiss("widen " + p.wpArm) }
  if p.wpSrc != sk { return irBMiss("widen source") }
  return numWidenTemp(b, v, sk, dk, dst, ix)
}

// Value `v` at number kind `sk` widened to kind `dk` at rep `dst`, node `ix`, in a temp typed at
// the destination, whose rep it holds.
function numWidenTemp(
  b: i32[],
  v: Opnd,
  sk: i32,
  dk: i32,
  dst: i32,
  ix: i32,
): Opnd {
  const ty = repTyOf(dst)
  const t = irVarNew(ib, dst, ty, "temp", -1)
  irBNode(
    b,
    { lDst: t, lRhs: { nwV: v, nwSrc: sk, nwDst: dk, nwAt: ix } },
    ty,
    dst,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// The cell's own read under assignment value `v`, the narrowing `assignValueGo` wrote last
// (`RAsgUnwiden`) taken back off `b`; any other value is a miss.
function radixWideRead(b: i32[], v: Opnd): Opnd {
  if !(v is OVar) || b.length == 0 { return irBMiss("widen radix value") }
  const id = b[b.length - 1]
  if id < 0 || id >= ib.irNodes.length { return irBMiss("widen radix value") }
  const n = ib.irNodes[id]
  if !(n is SLet) || n.lDst != v.ov { return irBMiss("widen radix value") }
  const r = n.lRhs
  if !(r is RAsgUnwiden) { return irBMiss("widen radix value") }
  b.pop()
  return r.uwV
}

// The temp of a call that never returns, `v`, read at i32 and widened to `to` at node `ix`; a
// never operand of another shape is a miss.
function neverWidened(b: i32[], v: Opnd, ix: i32, to: i32): Opnd {
  if ibMiss != "" { return v }
  if (
    !(v is OVar)
    || v.ov < 0
    || v.ov >= ib.irVars.length
    || !repIsNoValue(irBOpRep(v))
  ) {
    return irBMiss("never operand not a call")
  }
  const i32r = repNodeOfTy(TY_I32)
  ib.irVars[v.ov].vRep = i32r
  const dk = numKindOf(to)
  const t = irVarNew(ib, to, repTyOf(to), "temp", -1)
  const w: Rhs = { nwV: v, nwSrc: numKindOf(i32r), nwDst: dk, nwAt: ix }
  irBNode(b, { lDst: t, lRhs: w }, repTyOf(to), to, ix)
  const o: Opnd = { ov: t }
  return o
}

// Two lists, each built at its own list rep, compared by legacy's list compare.
function listEq(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const ls = b.length
  const l0 = irBExpr(b, n.binLeft)
  if ibMiss != "" { return l0 }
  const at = b.length
  const r = irBExpr(b, n.binRight)
  if ibMiss != "" { return r }
  const lead = [l0]
  if !stageLeftBelow(b, ls, at, lead, n.binLeft) { return r }
  const l = lead[0]
  if (
    !(repNodeAt(irBOpRep(l)) is RList)
    || !(repNodeAt(irBOpRep(r)) is RList)
  ) {
    return irBMiss("list compare operand rep")
  }
  return irBLetTemp(b, { qeL: l, qeR: r, qeAt: ix }, ix, rep)
}

// Two lists at the concat's rep, concatenated by legacy's concat (`listCatRouteOf` "plain").
function listCat(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const ls = b.length
  const l0 = irBExpr(b, n.binLeft)
  if ibMiss != "" { return l0 }
  const at = b.length
  const r = irBExpr(b, n.binRight)
  if ibMiss != "" { return r }
  const lead = [l0]
  if !stageLeftBelow(b, ls, at, lead, n.binLeft) { return r }
  const l = lead[0]
  // A widening concat's narrower side is a list at its own rep, widened by its tail (`catWidenTail`).
  const ws = if catWidenTakes(ix, ibFnIx) { catWidenSideOfBin(ix, ibFnIx) } else { 0 }
  const lok = irBOpRep(l) == rep || ws == 1 && repNodeAt(irBOpRep(l)) is RList
  const rok = irBOpRep(r) == rep || ws == 2 && repNodeAt(irBOpRep(r)) is RList
  if !lok || !rok || !(repNodeAt(rep) is RList) {
    return irBMiss("list concat operand rep")
  }
  return irBLetTemp(b, { ljL: l, ljR: r, ljAt: ix, ljWiden: ws }, ix, rep)
}

// Two union boxes, each built at its own box rep, compared by legacy's staged compare.
function unionEq(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const ls = b.length
  const l0 = unionEqSide(b, n.binLeft)
  if ibMiss != "" { return l0 }
  const at = b.length
  const r = unionEqSide(b, n.binRight)
  if ibMiss != "" { return r }
  const lead = [l0]
  if !stageLeftBelow(b, ls, at, lead, n.binLeft) { return r }
  const l = lead[0]
  // A boxed nullable is held as the box the staged compare reads.
  if !heldAsBox(irBOpRep(l)) || !heldAsBox(irBOpRep(r)) {
    return irBMiss("union compare operand rep")
  }
  return irBLetTemp(
    b,
    { ueL: l, ueR: r, ueNe: n.binOp == "!=", ueAt: ix },
    ix,
    rep,
  )
}

// Union compare operand `ix`: a local legacy reads as its box (`exprUnion`) is its box variable,
// past the narrowing its type carries; any other operand as built.
function unionEqSide(b: i32[], ix: i32): Opnd {
  const n = nodeAt(ix)
  if (
    n is Ident
    && exprUnion(ix, ibFnIx)
    && captureSlotOf(n.identName, ibFnIx) < 0
  ) {
    const v = boundVarOf(ix)
    if v >= 0 && heldAsBox(ib.irVars[v].vRep) {
      ib.irReadVar[ix] = v
      const o: Opnd = { ov: v }
      return o
    }
  }
  return irBExpr(b, ix)
}

// Whether compare operand `ix` may be a union box: no scalar, and held as a box (`eqRouteOf`
// decides; this only spares the scalar and plain-reference compares the question).
function unionSideOf(ix: i32): boolean {
  if operandWhy(ix) != OPERAND_TYPE { return false }
  return heldAsBox(repNodeOfTy(nodeTyAt(ix, ibFnIx))) || boxLocalRead(ix)
}

// Whether `ix` reads a local legacy holds as its box (`exprUnion`), past its type's narrowing.
function boxLocalRead(ix: i32): boolean {
  const n = nodeAt(ix)
  if (
    !(n is Ident)
    || !exprUnion(ix, ibFnIx)
    || captureSlotOf(n.identName, ibFnIx) >= 0
  ) {
    return false
  }
  const v = boundVarOf(ix)
  return v >= 0 && heldAsBox(ib.irVars[v].vRep)
}

// A union compare on the null legs with a side that is no place, as legacy stages it: the level
// opened, an operand left of a staged box parked first, a staged box parked, then the legs over
// the rest (`unionNulEq`).
function unionNulStagedEq(
  b: i32[],
  n: BinExpr,
  boxIx: i32,
  otherIx: i32,
  np: UnionEqNulPlan,
  ix: i32,
  rep: i32,
  swap: boolean,
): Opnd {
  if rep != ibBool { return irBMiss("union compare rep") }
  const leg = np.unLeg
  const boxSt = np.unBoxStaged
  const opSt = np.unOpStaged
  const opFirst = swap && boxSt && opSt
  const none: Opnd = { oiRep: ibNoValue, oiBits: 0 }
  const k = np.unPlan.uqKind
  let st = 0
  if boxSt { st = st + 1 }
  if opSt { st = st + 2 }
  if opFirst { st = st + 4 }
  irBNode(
    b,
    { efRhs: { usOp: 4, usV: none, usKind: st & 1, usAt: ix } },
    -1,
    ibNoValue,
    ix,
  )
  // The legs read the operand ahead of a box that is not parked, so it is built first.
  let o = none
  if opFirst || !boxSt {
    o = nulLegOperand(b, otherIx, leg)
    if ibMiss != "" { return o }
  }
  if opFirst {
    irBNode(
      b,
      { efRhs: { usOp: 5, usV: o, usKind: leg, usAt: ix } },
      -1,
      ibNoValue,
      ix,
    )
  }
  const bx = irBExpr(b, boxIx)
  if ibMiss != "" { return bx }
  if !heldAsBox(irBOpRep(bx)) { return irBMiss("union staged compare box") }
  let again = false
  if boxSt {
    irBNode(
      b,
      { efRhs: { usOp: 6, usV: bx, usKind: k, usAt: ix } },
      -1,
      ibNoValue,
      ix,
    )
  } else if !(bx is OVar) || bx.ov < 0 || bx.ov >= ib.irVars.length {
    return irBMiss("union compare box")
  } else if ib.irVars[bx.ov].vKind == "temp" {
    if !recvReadsAgain(unwrapParen(boxIx)) {
      return irBMiss("union compare box")
    }
    again = true
  }
  if boxSt && !opFirst {
    o = nulLegOperand(b, otherIx, leg)
    if ibMiss != "" { return o }
  }
  // An unparked operand read after a parked box is a place, or a read written again at each use.
  let oAgain = false
  if !opFirst && !opSt {
    const place = o is OVar
      && o.ov >= 0
      && o.ov < ib.irVars.length
      && ib.irVars[o.ov].vKind != "temp"
    oAgain = boxSt
      && !place
      && o is OVar
      && o.ov >= 0
      && o.ov < ib.irVars.length
      && recvReadsAgain(unwrapParen(otherIx))
    if !place && !oAgain { return irBMiss("union compare null operand") }
  }
  let bOp = bx
  if boxSt { bOp = none }
  let oOp = o
  if opFirst { oOp = none }
  return irBLetTemp(
    b,
    {
      ucBox: bOp,
      ucOther: oOp,
      ucNe: n.binOp == "!=",
      ucSwap: swap,
      ucStash: false,
      ucNul: true,
      ucAgain: again,
      ucStage: st,
      ucOtherAgain: oAgain,
      ucAt: ix,
    },
    ix,
    rep,
  )
}

// The null legs' operand at leg `leg`, at the rep its null test reads (1 a `K | null` id, 2 the
// `boolean | null` niche, 3 a nullable string).
function nulLegOperand(b: i32[], otherIx: i32, leg: i32): Opnd {
  const o = irBExpr(b, otherIx)
  if ibMiss != "" { return o }
  const r = irBOpRep(o)
  const ok = if leg == 1 { atomIdRep(r) } else if leg == 2 { boolNullable(r) } else { strNullable(r) }
  if !ok { return irBMiss("union compare null operand rep") }
  return o
}

// A union box against a concrete operand (`eqRouteOf`'s `unionLeft`/`unionRight`, `swap` the
// latter) on legacy's plain plan: the box a variable read twice, the operand at the arm's rep.
// A union compare whose operand has effects, as `emitUnionEqStaged` writes it: its level opened,
// each side built and parked in source order, the level closed, then the tails over the slots.
function unionStagedEq(
  b: i32[],
  n: BinExpr,
  boxIx: i32,
  otherIx: i32,
  k: i32,
  ix: i32,
  rep: i32,
  swap: boolean,
): Opnd {
  if rep != ibBool { return irBMiss("union compare rep") }
  if !(k >= 0 && k <= 5 || k == 11 || listWrapHeapOfKind(k) >= 0) {
    return irBMiss("union staged compare kind")
  }
  const none: Opnd = { oiRep: ibNoValue, oiBits: 0 }
  irBNode(
    b,
    { efRhs: { usOp: 0, usV: none, usKind: k, usAt: ix } },
    -1,
    ibNoValue,
    ix,
  )
  if !swap && stagedBox(b, boxIx, k, ix) < 0 { return irBMiss(ibMiss) }
  if stagedOperand(b, otherIx, k, ix) < 0 { return irBMiss(ibMiss) }
  if swap && stagedBox(b, boxIx, k, ix) < 0 { return irBMiss(ibMiss) }
  irBNode(
    b,
    { efRhs: { usOp: 3, usV: none, usKind: k, usAt: ix } },
    -1,
    ibNoValue,
    ix,
  )
  return irBLetTemp(
    b,
    { uqsNe: n.binOp == "!=", uqsSwap: swap, uqsAt: ix },
    ix,
    rep,
  )
}

// A staged compare's box, built and parked; -1 on a miss.
function stagedBox(b: i32[], boxIx: i32, k: i32, ix: i32): i32 {
  const bx = irBExpr(b, boxIx)
  if ibMiss != "" { return -1 }
  if !heldAsBox(irBOpRep(bx)) {
    irBMiss("union staged compare box")
    return -1
  }
  irBNode(
    b,
    { efRhs: { usOp: 1, usV: bx, usKind: k, usAt: ix } },
    -1,
    ibNoValue,
    ix,
  )
  return 0
}

// A staged compare's operand, delivered at arm kind `k` as `emitUnionEqOther` writes it, and parked.
function stagedOperand(b: i32[], otherIx: i32, k: i32, ix: i32): i32 {
  const wt = numCastKindTy(k)
  let o: Opnd = { oiRep: ibNoValue, oiBits: 0 }
  if k == 2 { o = deliverStr(b, otherIx) }
  else if wt >= 0 { o = deliver(b, otherIx, repNodeOfTy(wt), wt) }
  else { o = irBExpr(b, otherIx) }
  if ibMiss != "" { return -1 }
  const orep = irBOpRep(o)
  const orn = repNodeAt(orep)
  let ok = false
  if wt >= 0 {
    ok = orep == repNodeOfTy(wt)
  } else if k == 11 {
    ok = orn is RClosure
  } else if listWrapHeapOfKind(k) >= 0 {
    ok = orn is RList
  } else if k == 2 {
    ok = repPrim(orep) == "str"
  }
  // A `boolean | null` operand is its niche's i32, whose null 2 no bool payload equals.
  else if k == 1 {
    ok = orep == ibBool || boolNullable(orep)
  } else {
    ok = repPrim(orep) == "i32"
  }
  if !ok {
    irBMiss("union staged compare operand rep")
    return -1
  }
  irBNode(
    b,
    { efRhs: { usOp: 2, usV: o, usKind: k, usAt: ix } },
    -1,
    ibNoValue,
    ix,
  )
  return 0
}

// A union box against a number on legacy's cross-width door: the box, then the number at its own
// kind (`emitUnionEqOther`), each read once, then legacy's tail (`unionNumCrossTail`).
function unionNumCrossEq(
  b: i32[],
  n: BinExpr,
  boxIx: i32,
  otherIx: i32,
  ix: i32,
  rep: i32,
  swap: boolean,
): Opnd {
  if rep != ibBool { return irBMiss("union compare rep") }
  const eak = unionEqOperandKindOf(boxIx, otherIx, ibFnIx)
  if eak != 0 && eak != 3 && eak != 4 && eak != 5 {
    return irBMiss("union cross-width compare kind")
  }
  const bx = irBExpr(b, boxIx)
  if ibMiss != "" { return bx }
  if !heldAsBox(irBOpRep(bx)) {
    return irBMiss("union cross-width compare box")
  }
  const wt = numCastKindTy(eak)
  let o: Opnd = { oiRep: ibNoValue, oiBits: 0 }
  if wt >= 0 {
    o = deliver(b, otherIx, repNodeOfTy(wt), wt)
  } else {
    o = irBExpr(b, otherIx)
  }
  if ibMiss != "" { return o }
  const ok = if wt >= 0 { irBOpRep(o) == repNodeOfTy(wt) } else { repPrim(irBOpRep(o)) == "i32" }
  if !ok { return irBMiss("union cross-width compare operand rep") }
  const ne = n.binOp == "!="
  return irBLetTemp(
    b,
    {
      ncBox: bx,
      ncOther: o,
      ncKind: eak,
      ncNe: ne,
      ncSwap: swap,
      ncAt: ix,
    },
    ix,
    rep,
  )
}

// A union box against a record on legacy's variant door: the box, then the record, each read
// once, then legacy's tail (`unionVariantEqTail`).
function unionVariantEq(
  b: i32[],
  n: BinExpr,
  boxIx: i32,
  otherIx: i32,
  ix: i32,
  rep: i32,
  swap: boolean,
): Opnd {
  if rep != ibBool { return irBMiss("union compare rep") }
  const bx = irBExpr(b, boxIx)
  if ibMiss != "" { return bx }
  if !heldAsBox(irBOpRep(bx)) { return irBMiss("union variant compare box") }
  const o = irBExpr(b, otherIx)
  if ibMiss != "" { return o }
  const on = repNodeAt(irBOpRep(o))
  const rec = on is RRecord
    || on is RNullable && repNodeAt(on.rnInner) is RRecord
  if !rec { return irBMiss("union variant compare operand") }
  const ne = n.binOp == "!="
  return irBLetTemp(
    b,
    { uvBox: bx, uvOther: o, uvNe: ne, uvSwap: swap, uvAt: ix },
    ix,
    rep,
  )
}

function unionConcreteEq(
  b: i32[],
  n: BinExpr,
  ix: i32,
  rep: i32,
  swap: boolean,
): Opnd {
  const boxIx = if swap { n.binRight } else { n.binLeft }
  const otherIx = if swap { n.binLeft } else { n.binRight }
  // An operand with effects, or left of a box with effects: both sides parked once each, in source
  // order (D17068, D17116).
  const sp = unionEqStagedPlanOf(boxIx, otherIx, swap, ibFnIx)
  if sp.uqKind >= 0 {
    return unionStagedEq(b, n, boxIx, otherIx, sp.uqKind, ix, rep, swap)
  }
  const qp0 = unionConcreteEqPlanOf(boxIx, otherIx, ibFnIx)
  // A record operand legacy compares on its variant door, field by field.
  if qp0.uqKind < 0 {
    const vi = unionEqVariantRowOf(boxIx, otherIx, ibFnIx)
    if vi >= 0 { return unionVariantEq(b, n, boxIx, otherIx, ix, rep, swap) }
    const kas = unionNumCrossKindsOf(boxIx, otherIx, ibFnIx)
    if kas.length > 0 {
      return unionNumCrossEq(b, n, boxIx, otherIx, ix, rep, swap)
    }
  }
  // An operand holding `null` takes legacy's null leg; a box that is no place, its stash.
  // Asked only where the plain plan declines; a box of -1 answers no leg.
  const nulBox = if qp0.uqKind < 0 { boxIx } else { -1 }
  const np = unionEqNulPlanOf(nulBox, otherIx, swap, ibFnIx)
  const nul = np.unLeg > 0
  // A side of the null legs that is no place is parked once, as legacy stages it (D17065).
  if nul && (np.unBoxStaged || np.unOpStaged) {
    return unionNulStagedEq(b, n, boxIx, otherIx, np, ix, rep, swap)
  }
  const stash = qp0.uqKind < 0 && !nul
  let qp = qp0
  if nul { qp = np.unPlan }
  if stash { qp = unionEqStashPlanOf(boxIx, otherIx, ibFnIx) }
  if qp.uqKind < 0 { return irBMiss("union compare plan") }
  if rep != ibBool { return irBMiss("union compare rep") }
  const bx = unionEqSide(b, boxIx)
  if ibMiss != "" { return bx }
  if stash && !heldAsBox(irBOpRep(bx)) { return irBMiss("union compare box") }
  // Read twice, so a parameter or local, or a read the lowering writes again (`irHoistRecv`).
  const again = bx is OVar
    && bx.ov >= 0
    && bx.ov < ib.irVars.length
    && ib.irVars[bx.ov].vKind == "temp"
    && recvReadsAgain(unwrapParen(boxIx))
  if (
    !stash
    && (!(bx is OVar)
      || bx.ov < 0
      || bx.ov >= ib.irVars.length
      || ib.irVars[bx.ov].vKind == "temp" && !again
      || !heldAsBox(irBOpRep(bx)))
  ) {
    return irBMiss("union compare box")
  }
  const k = qp.uqKind
  // The scalar kinds, a closure and a list arm: the payload and compare tails are legacy's.
  const lwh = listWrapHeapOfKind(k)
  if !(k >= 0 && k <= 5 || k == 11 || lwh >= 0) {
    return irBMiss("union compare kind")
  }
  // A number arm's operand is delivered widened to it, as `emitUnionEqOther` writes it.
  const wt = numCastKindTy(k)
  const at = b.length
  let o: Opnd = { oiRep: ibNoValue, oiBits: 0 }
  if k == 2 && !nul { o = deliverStr(b, otherIx) }
  else if wt >= 0 { o = deliver(b, otherIx, repNodeOfTy(wt), wt) }
  else { o = irBExpr(b, otherIx) }
  if ibMiss != "" { return o }
  // The operand is written inside the tag's `if`, so it is one the lowering reads in place, or a
  // plain read the lowering writes at its use (`recvReadsAgain`).
  const atUse = o is OVar
    && o.ov >= 0
    && o.ov < ib.irVars.length
    && ib.irVars[o.ov].vKind == "temp"
    && recvReadsAgain(unwrapParen(otherIx))
  // A null leg reads the operand ahead of the box, so its temp follows a box the builder read as
  // a variable.
  const boxVar = bx is OVar
    && bx.ov >= 0
    && bx.ov < ib.irVars.length
    && ib.irVars[bx.ov].vKind != "temp"
  const otherAgain = nul && atUse && boxVar
  if (
    (b.length != at || !(o is OVar || o is OImm || o is OStr))
    && !(atUse && !nul)
    && !otherAgain
  ) {
    return irBMiss("union compare operand")
  }
  // A null leg reads its operand twice: a parameter or local, or a read written again.
  if (
    nul
    && !otherAgain
    && (!(o is OVar)
      || o.ov < 0
      || o.ov >= ib.irVars.length
      || ib.irVars[o.ov].vKind == "temp")
  ) {
    return irBMiss("union compare null operand")
  }
  const orn = repNodeAt(irBOpRep(o))
  // Off the null leg a `boolean | null` operand is its niche's i32, which no bool payload's 2 equals.
  const want = if nul { if np.unLeg == 1 { atomIdRep(irBOpRep(o)) } else if k == 2 { strNullable(irBOpRep(o)) } else { boolNullable(irBOpRep(o)) } } else if wt >= 0 { irBOpRep(o) == repNodeOfTy(wt) } else if k == 11 { orn is RClosure } else if lwh >= 0 { orn is RList } else if k == 2 { repPrim(irBOpRep(o)) == "str" } else if k == 1 { irBOpRep(o) == ibBool || boolNullable(irBOpRep(o)) } else { repPrim(irBOpRep(o)) == "i32" }
  if !want { return irBMiss("union compare operand rep") }
  const readAgain = again && !stash
  return irBLetTemp(
    b,
    {
      ucBox: bx,
      ucOther: o,
      ucNe: n.binOp == "!=",
      ucSwap: swap,
      ucStash: stash,
      ucNul: nul,
      ucAgain: readAgain,
      ucStage: 0,
      ucOtherAgain: otherAgain,
      ucAt: ix,
    },
    ix,
    rep,
  )
}

// Whether operand `ix` is typed at a literal union delivered as an interned atom.
// An `==`/`!=` with an atom operand, by legacy's own arm (`atomEqPlanOf`). A side typed as one
// string literal is its member's id: a `StrLit` spelling is an unread immediate here, anything
// else is built and dropped by the lowering, in source order.
function atomCompare(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const p = atomEqPlanOf(n, ibFnIx)
  const ne = n.binOp == "!="
  const none: Opnd = { oiRep: ibNoValue, oiBits: 0 }
  if p.aqArm == "none" { return irBMiss("atom compare") }
  if p.aqArm == "fold" {
    const fl = staticSideOf(b, n.binLeft)
    if ibMiss != "" { return fl }
    const fr = staticSideOf(b, n.binRight)
    if ibMiss != "" { return fr }
    return irBLetTemp(
      b,
      { aeL: fl, aeR: fr, aeStatic: 3, aeNe: ne, aeAt: ix },
      ix,
      rep,
    )
  }
  if p.aqArm == "static" {
    const sIx = if p.aqStaticLeft { n.binLeft } else { n.binRight }
    const aIx = if p.aqStaticLeft { n.binRight } else { n.binLeft }
    const sl = if p.aqStaticLeft { staticSideOf(b, sIx) } else { none }
    if ibMiss != "" { return sl }
    const at = b.length
    const a = atomSide(b, aIx)
    if ibMiss != "" { return a }
    // A statement nothing is staged below (a `??` written in place, a receiver or list stage, a
    // void `if`) keeps the id at its reader, which the lowering refuses.
    if (
      p.aqStaticLeft
      && ifBelowLeadHas(b, at, b.length)
      && !inPlaceUnstagedFrom(b, at)
      && !receiverStageFrom(b, at)
      && !voidIfFrom(b, at)
    ) {
      const id = stagedStaticId(b, at, sIx, aIx, p.aqLex)
      if ibMiss != "" { return id }
      return irBLetTemp(
        b,
        { aeL: id, aeR: a, aeStatic: 4, aeNe: ne, aeAt: ix },
        ix,
        rep,
      )
    }
    const sr = if p.aqStaticLeft { none } else { staticSideOf(b, sIx) }
    if ibMiss != "" { return sr }
    const st = if p.aqStaticLeft { 1 } else { 2 }
    const l = if p.aqStaticLeft { sl } else { a }
    const r = if p.aqStaticLeft { a } else { sr }
    return irBLetTemp(
      b,
      { aeL: l, aeR: r, aeStatic: st, aeNe: ne, aeAt: ix },
      ix,
      rep,
    )
  }
  // `ids`: two atom values, the left staged below a statement the right writes.
  const ls = b.length
  const l0 = atomSide(b, n.binLeft)
  if ibMiss != "" { return l0 }
  const at = b.length
  const r = atomSide(b, n.binRight)
  if ibMiss != "" { return r }
  const lead = [l0]
  if !stageLeftBelow(b, ls, at, lead, n.binLeft) { return l0 }
  return irBLetTemp(
    b,
    { aeL: lead[0], aeR: r, aeStatic: 0, aeNe: ne, aeAt: ix },
    ix,
    rep,
  )
}

// A literal static left side `ix` as its member `lex`'s id, held at the type of atom side `aIx`,
// staged at `at` below a statement that side built from there, where legacy writes the id first.
function stagedStaticId(
  b: i32[],
  at: i32,
  ix: i32,
  aIx: i32,
  lex: string,
): Opnd {
  const u = unwrapParen(ix)
  if u < 0 || u >= P.nodes.length {
    return irBMiss("staged atom compare literal")
  }
  const sl = nodeAt(u)
  const ty = heldTy(exprTyOf(unwrapParen(aIx)))
  const ar = repNodeOfTy(ty)
  if !(sl is StrLit) || sl.strText != lex || !(repNodeAt(ar) is RAtom) {
    return irBMiss("staged atom compare literal")
  }
  const o: Opnd = { osAt: u, osRep: ar }
  const one: i32[] = []
  const t = irBLetTempTy(one, { sgV: o }, u, ar, ty)
  if ibMiss != "" || one.length != 1 {
    return irBMiss("staged atom compare literal")
  }
  insertAt(b, at, one[0])
  return t
}

// The operand of static side `ix`: the unread immediate of a `StrLit`, else its value, which the
// lowering drops. Legacy writes it raw, so a local read stays at its cell's rep (an atom).
function staticSideOf(b: i32[], ix: i32): Opnd {
  const none: Opnd = { oiRep: ibNoValue, oiBits: 0 }
  if nodeAt(unwrapParen(ix)) is StrLit { return none }
  const fr = rawFieldRepOf(ix)
  const v = if fr >= 0 { irMemberHook(b, unwrapParen(ix), fr) } else { exprAt(b, ix, true) }
  if ibMiss != "" { return v }
  if v is OImm || irBOpRep(v) == ibNoValue {
    return irBMiss("atom compare static operand")
  }
  return v
}

// The rep a record field read `ix` is stored at, where it differs from the read's own (a field
// the checker narrowed to one literal), else -1: a raw read is written at its storage.
function rawFieldRepOf(ix: i32): i32 {
  const u = unwrapParen(ix)
  if u < 0 || u >= P.nodes.length { return -1 }
  const n = nodeAt(u)
  if !(n is Member) || exprPrePathWhy(u, ibFnIx) != "" { return -1 }
  const dt = declRowReadTy(n.memObj)
  const ot = if dt >= 0 { dt } else { nodeTyAt(n.memObj, ibFnIx) }
  const r = repNodeOfTy(ot)
  if !(repNodeAt(r) is RRecord) { return -1 }
  const k = repRecordKidOf(r, ot, n.memProp)
  const ks = repNodeKids(r)
  if k < 0 || k >= ks.length || ks[k] == exprRepOf(u) { return -1 }
  return ks[k]
}

// Whether `ix` reads a local legacy holds as an atom (`letAtomCellTy`) whose own type is no atom.
function atomCellWidened(ix: i32): boolean {
  const u = unwrapParen(ix)
  if u < 0 || u >= P.nodes.length || !(nodeAt(u) is Ident) { return false }
  const d = identDeclOf(u)
  if (
    d < 0
    || d >= P.nodes.length
    || !(nodeAt(d) is LetDecl)
    || letAtomCellTy(d, ibFnIx) < 0
  ) {
    return false
  }
  const r = repNodeOfTy(heldTy(scopeTyAt(d, ibFnIx)))
  return !(repNodeAt(r) is RAtom || atomNullable(r))
}

// The value of atom operand `ix`, which must build at an atom rep or its `K | null`.
function atomSide(b: i32[], ix: i32): Opnd {
  const v = irBExpr(b, unwrapParen(ix))
  if ibMiss != "" { return v }
  const r = irBOpRep(v)
  if !(repNodeAt(r) is RAtom) && !atomNullable(r) {
    return irBMiss("atom compare operand")
  }
  return v
}

function atomOperand(ix: i32): boolean {
  const r = repNodeOfTy(nodeTyAt(unwrapParen(ix), ibFnIx))
  return repNodeAt(r) is RAtom || atomNullable(r)
}

// A `==`/`!=` over two `null`-typed sides, as legacy's `emitNulNoneEq` writes it: each side for
// its effect, left then right, where the answer is read, then the constant; a bare `null` or a
// name read runs nothing.
function nulNonePairEq(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const effs: Opnd[] = []
  const le = nulNoneEffect(b, n.binLeft, ix, effs)
  if ibMiss != "" { return le }
  const re = nulNoneEffect(b, n.binRight, ix, effs)
  if ibMiss != "" { return re }
  const eq: Opnd = { oiRep: rep, oiBits: if n.binOp == "==" { 1 } else { 0 } }
  if effs.length == 0 { return eq }
  return irBLetTemp(b, { aeEff: effs, aeV: eq, aeAt: ix }, ix, rep)
}

// A `==`/`!=` against a `null` literal, by legacy's own route: a dead test, or a `null`-typed
// pair (`nulNoneEqSides`), is its constant; then the null test's arm (`nulTestArmOf`) with the
// direction the dispatch hands it. Built: a niche's compare, a nullable ref's or string's typed
// test, a union box's null tag, and a scalar map read's probe.
function nulTest(
  b: i32[],
  n: BinExpr,
  bt: BinNulTest,
  ix: i32,
  rep: i32,
): Opnd {
  const dn = deadNullTestOperand(n, ibFnIx)
  if dn >= 0 { return deadNulTest(b, n, dn, ix, rep) }
  // A `null`-typed pair is legacy's constant (`emitNulNoneEq`): each side runs for its effect,
  // left then right, where the answer is read, and a bare `null` or a name read runs nothing.
  if nulNoneEqSides(n.binLeft, n.binRight, ibFnIx) {
    return nulNonePairEq(b, n, ix, rep)
  }
  const arm = nulTestArmOf(bt.bnRef, ibFnIx, bt.bnInvert, false)
  if arm == "mapHas" { return nulTestMapHas(b, bt, ix, rep) }
  if arm == "optChain" { return nulTestOptChain(b, bt, ix, rep) }
  if arm == "nullty" { return nulTestNullTy(b, bt, ix, rep) }
  // A read the checker narrowed to `null` (or past it) is legacy's constant, its operand unread.
  if (arm == "nulfold" || arm == "nnfold") && repPrim(rep) == "bool" {
    const fo: Opnd = {
      oiRep: rep,
      oiBits: if (arm == "nulfold") != bt.bnInvert { 1 } else { 0 },
    }
    return fo
  }
  if (
    arm != "atom"
    && arm != "bool"
    && arm != "nullRef"
    && arm != "nulStr"
    && arm != "boxTag"
  ) {
    return irBMiss("null test " + arm)
  }
  const v = nulTestOperand(b, arm, bt.bnRef)
  if ibMiss != "" { return v }
  if !nulTestOperandOk(arm, irBOpRep(v)) { return irBMiss("null test operand") }
  return irBLetTemp(b, { ntV: v, ntInvert: bt.bnInvert, ntAt: ix }, ix, rep)
}

// The operand of null test arm `arm` over `ref`: a box's tag test reads the box legacy compares, a
// union-box global narrowed to a rep that is no box as its cell stores it, a binding holding a
// returned record (`globalHolderTy`) as its nullable cell, and any other read at its cell.
function nulTestOperand(b: i32[], arm: NulTestArm, ref: i32): Opnd {
  const r = unwrapParen(ref)
  if (
    (arm == "boxTag" || arm == "nullRef")
    && r >= 0
    && r < P.nodes.length
    && nodeAt(r) is Ident
    && globalTarget(r)
  ) {
    const d = identDeclOf(r)
    const g = globalIndexOfSid(sidOfNode(r))
    const cr = globalRep(g, d)
    const st = heldTy(letBindTy(d, -1))
    if (
      arm == "boxTag"
      && cr >= 0
      && heldAsBox(cr)
      && !heldAsBox(exprRepOf(r))
      && cr == globalTyRep(st)
    ) {
      return globalStoredRead(b, g, r, cr, st)
    }
    const ht = if arm == "nullRef" && cr >= 0 { globalHolderTy(d) } else { -1 }
    // The cell holds the record, or `null` beside it where the binding's value is a map read.
    const cn = repNodeAt(cr)
    const hr = if ht >= 0 { repNodeOfTy(ht) } else { -1 }
    const held = hr >= 0 && (hr == cr || cn is RNullable && cn.rnInner == hr)
    if held && refNullable(cr) && exprRepOf(r) != cr {
      globalHeldNote(g)
      return globalStoredRead(
        b,
        g,
        r,
        cr,
        if hr == cr { ht } else { repTyOf(cr) },
      )
    }
  }
  return if arm == "boxTag" { exprAt(b, ref, true) } else { irBExpr(b, ref) }
}

// Whether operand rep `vr` is the one null-test arm `arm` reads; an arm `RNulTest` does not
// build reads none.
function nulTestOperandOk(arm: NulTestArm, vr: i32): boolean {
  return match arm {
    "atom" => atomNullable(vr)
    "bool" => boolNullable(vr)
    "nulStr" => strNullable(vr)
    // A `const` holding a record of members reads as that record (`holderRecordSigs`).
    "nullRef" => strNullable(vr) || refNullable(vr) || repNodeAt(vr) is RRecord
    "boxTag" => heldAsBox(vr)
    "nnfold" | "nulfold" | "nullty" | "optChain" | "mapHas" | "instMap" | "none" => false
  }
}

// `x?.f == null`: the chain built once as its value, then that value's own null test by its rep
// (`optChainNulTestOk`), where legacy writes the chain's test and its read apart.
function nulTestOptChain(b: i32[], bt: BinNulTest, ix: i32, rep: i32): Opnd {
  const v = irBExpr(b, bt.bnRef)
  if ibMiss != "" { return v }
  if !optChainNulTestOk(irBOpRep(v)) {
    return irBMiss("null test optChain rep")
  }
  return irBLetTemp(b, { ntV: v, ntInvert: bt.bnInvert, ntAt: ix }, ix, rep)
}

// Whether a nullable value at rep `vr` has a null test of its own: a niche of any discipline, or a
// union box.
function optChainNulTestOk(vr: i32): boolean {
  return atomNullable(vr)
    || boolNullable(vr)
    || strNullable(vr)
    || refNullable(vr)
    || heldAsBox(vr)
}

// `m[k] == null` over a scalar map read, as legacy writes it: the map's has probe, then
// `i32.eqz` for `==`.
function nulTestMapHas(b: i32[], bt: BinNulTest, ix: i32, rep: i32): Opnd {
  return mapReadHas(b, bt.bnRef, bt.bnInvert, ix, rep)
}

// Whether scalar map read `readIx` hit, as `emitMapHas` writes it, or with `present` false that
// it missed (`i32.eqz`): a map read's null test and its `is` literal arms.
function mapReadHas(
  b: i32[],
  readIx: i32,
  present: boolean,
  ix: i32,
  rep: i32,
): Opnd {
  const r = nodeAt(unwrapParen(readIx))
  if !(r is Index) { return irBMiss("null test map operand") }
  if rep != ibBool { return irBMiss("null test result rep") }
  const h = mapHasRhs(b, r.idxArr, r.idxIndex, ix)
  if ibMiss != "" { return irBMiss(ibMiss) }
  const v = irBLetTemp(b, h, ix, rep)
  if present || ibMiss != "" { return v }
  return irBLetTemp(b, { poOp: "not", poArgs: [v] }, ix, rep)
}

// A null test the checker proved dead (`deadNullTestOperand`), as legacy's `emitDeadNullTest`
// writes it: the operand for its effects and dropped, unless it is a bare name, then the constant.
// A numeric union's per-member compare takes the node first in legacy (`njDispatches`).
function deadNulTest(b: i32[], n: BinExpr, opIx: i32, ix: i32, rep: i32): Opnd {
  if numUnionMinted && njDispatches(n, ibFnIx) {
    return irBMiss("null test numeric union")
  }
  if !(nodeAt(opIx) is Ident) {
    const v = irBExpr(b, opIx)
    if ibMiss != "" { return v }
    irBNode(b, { dpV: v }, -1, ibNoValue, ix)
  }
  const bits: i64 = if n.binOp == "!=" { 1 } else { 0 }
  const o: Opnd = { oiRep: rep, oiBits: bits }
  return o
}

// A null test of a value typed `null`, as legacy's `nullty` arm writes it (`emitDeadNullTest`): a
// name or a bare `null` is the constant alone (`nulNoneWritesNothing`); a field is read raw at its
// storage (`rawFieldRepOf`) and dropped first, as `staticSideOf` reads one.
function nulTestNullTy(b: i32[], bt: BinNulTest, ix: i32, rep: i32): Opnd {
  if !nulNoneWritesNothing(bt.bnRef) {
    const fr = rawFieldRepOf(bt.bnRef)
    // A field whose storage rep is not named (a receiver no row decision reached) is read as the
    // node reads it: its value is dropped, so only its effects stand.
    const v = if fr >= 0 { irMemberHook(b, unwrapParen(bt.bnRef), fr) } else { exprAt(b, bt.bnRef, true) }
    if ibMiss != "" { return v }
    // The drop and the constant stand in the test's place, after any operand pending before it.
    const r: Rhs = { dnV: v, dnBits: if bt.bnInvert { 0 } else { 1 } }
    return irBLetTemp(b, r, ix, rep)
  }
  const o: Opnd = { oiRep: rep, oiBits: if bt.bnInvert { 0 } else { 1 } }
  return o
}

// `__array_new__(n, fill)` as legacy's arm writes it (`arrNewPlanOf`): the length, the fill at the
// list's element rep, then the allocation; `__array_new_default__` its own. A refused site is a
// named miss.
function arrNew(b: i32[], n: Call, ix: i32, rep: i32): Opnd {
  if n.callFn < 0 || n.callFn >= P.nodes.length {
    return irBMiss("array new callee")
  }
  const f = nodeAt(n.callFn)
  if (
    f is Ident
    && f.identName == "__array_new_default__"
    && n.callArgs.length == 1
  ) {
    return arrNewDefault(b, n, ix, rep)
  }
  if !(f is Ident) || f.identName != "__array_new__" || n.callArgs.length != 2 {
    return irBMiss("array new callee")
  }
  const fill = n.callArgs[1]
  if arrNewWhyOf(ix, fill, ibFnIx) != "" { return irBMiss("array new refused") }
  const boxTy = arrNewFillBoxTy(ix, fill, ibFnIx)
  const ln = repNodeAt(rep)
  if !(ln is RList) { return irBMiss("array new rep") }
  const at = b.length
  const len = irBExpr(b, n.callArgs[0])
  // The fill is delivered at the element rep, as a literal element of the same value is; one
  // legacy boxes is boxed at its union (`arrNewFillBoxTy`), as a union element is.
  // Otherwise at the element rep's own type, so a fill already boxed at that union passes as is.
  const et = repTyOf(ln.rlsElem)
  const v = if boxTy >= 0 { boxTempIn(b, unionElemValue(b, fill), fill, ln.rlsElem, -1, boxTy) } else { deliver(b, fill, ln.rlsElem, et) }
  if ibMiss != "" { return v }
  if ifBelowLead(b, at, "array new short-circuit operand") { return v }
  if repPrim(irBOpRep(len)) != "i32" {
    return irBMiss("array new length coercion")
  }
  if irBOpRep(v) != ln.rlsElem { return irBMiss("array new fill coercion") }
  return irBLetTemp(b, { lnLen: len, lnFill: v, lnAt: ix }, ix, rep)
}

// A memory-management intrinsic as legacy's arm writes it (`emitCallCoreMemOp`): its i32
// operands as they stand, then the arm's instruction. A plan legacy refuses is a named miss.
function memOpRhs(b: i32[], c: Call, ix: i32): Rhs {
  if memOpPlanOf(c).moFail != "" { return missRhs("memory op plan") }
  const at = b.length
  const args: Opnd[] = []
  for a in c.callArgs { args.push(irBExpr(b, a)) }
  if ibMiss != "" { return missRhs("memory op operand") }
  if ifBelowLead(b, at, "memory op short-circuit operand") {
    return missRhs("memory op short-circuit operand")
  }
  for o in args {
    if repPrim(irBOpRep(o)) != "i32" {
      return missRhs("memory op operand coercion")
    }
  }
  const r: Rhs = { moArgs: args, moAt: ix }
  return r
}

// `__array_new_default__(n)` as legacy's arm writes it (`arrNewPlanOf`): the length, then the
// zeroed allocation. A refused site is a named miss.
function arrNewDefault(b: i32[], n: Call, ix: i32, rep: i32): Opnd {
  if arrNewWhyOf(ix, -1, ibFnIx) != "" { return irBMiss("array new refused") }
  if !(repNodeAt(rep) is RList) { return irBMiss("array new rep") }
  const len = irBExpr(b, n.callArgs[0])
  if ibMiss != "" { return len }
  if repPrim(irBOpRep(len)) != "i32" {
    return irBMiss("array new length coercion")
  }
  return irBLetTemp(b, { ldLen: len, ldAt: ix }, ix, rep)
}

// The address plan of memory call `c` (`base` declared operands) over the fold rows this function
// has derived (`foldLetAt`), as `memAddrPlanOf` answers it over legacy's own table.
function irBAddrPlan(c: Call, base: i32): MemAddrPlan {
  return memAddrPlanWith(
    c,
    base,
    ibFnIx,
    { mfDecl: ib.irMaDecl, mfSlot: ib.irMaSlot, mfK: ib.irMaK },
  )
}

// A `fold` arm's address: the folded binding's own read, which the lowering writes as its fold
// local at the plan's offset; anything but a local's plain read is a miss.
function foldAddrRead(b: i32[], c: Call): Opnd {
  const a = irBExpr(b, c.callArgs[0])
  if ibMiss != "" { return a }
  if !(a is OVar) || a.ov < 0 || ib.irVars[a.ov].vKind != "local" {
    return irBMiss("memory address fold read")
  }
  return a
}

// A linear-memory load or store of an i32 as legacy's arm writes it (`memAccessPlanOf`): the
// address along `memAddrPlanOf`'s `const` arm (an immediate 0) or `rest` arm (its node), then a
// store's value. A widened store value and every other address arm are named misses.
function memAccessRhs(b: i32[], c: Call, ix: i32): Rhs {
  if c.callFn < 0 || c.callFn >= P.nodes.length {
    return missRhs("memory access callee")
  }
  const f = nodeAt(c.callFn)
  if !(f is Ident) { return missRhs("memory access callee") }
  return memAccessNamed(b, c, ix, f.identName)
}

// Load or store call `c` at node `ix`, written as intrinsic `name`.
function memAccessNamed(b: i32[], c: Call, ix: i32, name: string): Rhs {
  const p = memAccessPlanOf(name)
  if p.mxOp < 0 || p.mxAlign < 0 { return missRhs("memory access width") }
  const ap = irBAddrPlan(c, p.mxBase)
  const at = b.length
  const args: Opnd[] = []
  match ap.maArm {
    "const" => {
      const z: Opnd = { oiRep: repNodeOfTy(TY_I32), oiBits: 0 }
      args.push(z)
    }
    "rest" => args.push(irBExpr(b, ap.maRest))
    "fold" => args.push(foldAddrRead(b, c))
    "bad" | "lma" | "wide" => {
      return missRhs("memory address " + ap.maArm)
    }
  }
  if p.mxBase == 2 { args.push(irBExpr(b, memCallArg(c, 2, 1))) }
  if ibMiss != "" { return missRhs("memory access operand") }
  if ifBelowLead(b, at, "memory access short-circuit operand") {
    return missRhs("memory access short-circuit operand")
  }
  // The address is an i32; a store's value is already at its width's prim, which legacy's
  // widening then leaves as it stands.
  if (
    repPrim(irBOpRep(args[0])) != "i32"
    || p.mxBase == 2 && repPrim(irBOpRep(args[1])) != p.mxPrim
  ) {
    return missRhs("memory access operand coercion")
  }
  const r: Rhs = {
    mmArgs: args,
    mmAt: ix,
    mmBase: p.mxBase,
    mmPrim: p.mxPrim,
    mmName: name,
  }
  return r
}

// A narrow load legacy folds with its widening (`zextLoadOf`: `as i64`, or a mask that only
// zero-extends) into the `_i64` load that zero-extends as it reads, at the fold node `ix`.
function zextLoadRead(b: i32[], ix: i32, rep: i32): Opnd {
  const c = zextLoadOf(ix, ibFnIx)
  if c < 0 || c >= P.nodes.length { return irBMiss("zero-extending load node") }
  const n = nodeAt(c)
  if !(n is Call) { return irBMiss("zero-extending load node") }
  if repPrim(rep) != "i64" { return irBMiss("zero-extending load rep") }
  const r = memAccessNamed(b, n, c, zextLoadName(c))
  if ibMiss != "" { return irBMiss(ibMiss) }
  return irBLetTemp(b, r, ix, rep)
}

// An atomic intrinsic as legacy's arm writes it (`atomicPlanOf`): the address along
// `memAddrPlanOf`'s `const` or `rest` arm, then each value operand already at `atomicValPrim`.
// A fence has no operand. Every other address arm and a widened operand are named misses.
function atomicRhs(b: i32[], c: Call, ix: i32): Rhs {
  const pl = atomicPlanOf(c)
  if pl.apFail != "" { return missRhs("atomic plan") }
  const args: Opnd[] = []
  const vals: string[] = [""]
  let vk = 1
  while vk < pl.apBase {
    vals.push(atomicValPrim(pl.apRow, vk))
    vk = vk + 1
  }
  const res = atomicResultPrim(pl.apRow)
  if pl.apBase == 0 {
    const r: Rhs = {
      amArgs: args,
      amAt: ix,
      amBase: 0,
      amValPrims: vals,
      amResPrim: res,
    }
    return r
  }
  const ap = irBAddrPlan(c, pl.apBase)
  const at = b.length
  match ap.maArm {
    "const" => {
      const z: Opnd = { oiRep: repNodeOfTy(TY_I32), oiBits: 0 }
      args.push(z)
    }
    "rest" => args.push(irBExpr(b, ap.maRest))
    "fold" => args.push(foldAddrRead(b, c))
    "bad" | "lma" | "wide" => {
      return missRhs("memory address " + ap.maArm)
    }
  }
  let k = 1
  while k < pl.apBase {
    args.push(irBExpr(b, memCallArg(c, pl.apBase, k)))
    k = k + 1
  }
  if ibMiss != "" { return missRhs("atomic operand") }
  if ifBelowLead(b, at, "atomic short-circuit operand") {
    return missRhs("atomic short-circuit operand")
  }
  if repPrim(irBOpRep(args[0])) != "i32" {
    return missRhs("atomic operand coercion")
  }
  k = 1
  while k < pl.apBase {
    if repPrim(irBOpRep(args[k])) != vals[k] {
      return missRhs("atomic operand coercion")
    }
    k = k + 1
  }
  const r: Rhs = {
    amArgs: args,
    amAt: ix,
    amBase: pl.apBase,
    amValPrims: vals,
    amResPrim: res,
  }
  return r
}

// A scalar saturating truncation as legacy's arm writes it (`truncSatPlanOf`): the float operand
// already at the plan's prim, then the instruction. A widened operand is a named miss.
function truncSatRhs(b: i32[], c: Call, ix: i32): Rhs {
  const pl = truncSatPlanOf(c)
  if pl.tpOp < 0 { return missRhs("trunc_sat plan") }
  const v = irBExpr(b, c.callArgs[0])
  if ibMiss != "" { return missRhs("trunc_sat operand") }
  if repPrim(irBOpRep(v)) != pl.tpFrom {
    return missRhs("trunc_sat operand coercion")
  }
  const r: Rhs = {
    tsV: v,
    tsAt: ix,
    tsOp: pl.tpOp,
    tsFrom: pl.tpFrom,
    tsTo: pl.tpTo,
  }
  return r
}

// `__array_copy__(dst, dstAt, src, srcAt, count)` as legacy's arm writes it (`arrCopyPlanOf`): the
// five operands as they stand, two lists of one rep and three i32s. A refused site is a named miss.
function listCopyStmt(b: i32[], n: Call, ix: i32): i32 {
  if n.callArgs.length != 5 { return skip("list copy arguments") }
  if arrCopyPlanOf(ix, ibFnIx).acWhy != "" { return skip("list copy refused") }
  const at = b.length
  const args: Opnd[] = []
  for a in n.callArgs { args.push(irBExpr(b, a)) }
  if ibMiss != "" { return 0 }
  if ifBelowLead(b, at, "list copy short-circuit operand") { return 0 }
  const dl = irBOpRep(args[0])
  if !(repNodeAt(dl) is RList) || irBOpRep(args[2]) != dl {
    return skip("list copy list rep")
  }
  for k in [1, 3, 4] {
    if repPrim(irBOpRep(args[k])) != "i32" {
      return skip("list copy operand coercion")
    }
  }
  const r: Rhs = { lcArgs: args, lcAt: ix }
  irBNode(b, { efRhs: r }, -1, ibNoValue, ix)
  return 0
}

// A list literal along legacy's short build (`arrLitArmOf`, `arrLitShortWhy`): an i32, f64, i64, f32,
// string, packed, v128 or plain ref list, each element delivered at the list's element rep. Every other
// arm is a named miss.
function arrayLit(
  b: i32[],
  n: ArrayLit,
  ix: i32,
  rep: i32,
  lb: ListBuild,
  bt: i32,
): Opnd {
  const arm = arrLitArmOf(ix, ibFnIx, lb)
  if arm == "spread" { return spreadLit(b, n, ix, rep, lb, bt) }
  // A ref list builds along `emitArrRef`'s short arms (`arrLitRefShortSlot`) or not at all: each
  // element as is, or each boxed by its record, which `deliver` writes at the box rep.
  // …or, past the chunk cap, the short arms' chunked twin (`arrLitRefLongSlot`).
  const short = if arm == "ref" { arrLitRefShortSlot(ix, ibFnIx, lb) } else { -1 }
  const lslot = if arm == "ref" && short < 0 && arrLitVariantSlot(ix, ibFnIx, lb) < 0 { arrLitRefLongSlot(ix, ibFnIx, lb) } else { -1 }
  // …or a non-null variant's, each element a literal built at the variant's row or a value of it.
  // …or, along legacy's general path, each element coerced to the variant's row all the same.
  const vshort = if arm == "ref" && short < 0 { arrLitVariantSlot(ix, ibFnIx, lb) } else { -1 }
  const vslot = if vshort < 0 && arm == "ref" && short < 0 && lslot < 0 { arrLitVariantLongSlot(ix, ibFnIx, lb) } else { vshort }
  // …or a union-box slot's per-element build, each element boxed into the slot's union.
  const uslot = if arm == "ref" && short < 0 && vslot < 0 && lslot < 0 { arrLitUnionLongSlot(ix, n.arrElems, ibFnIx, lb) } else { -1 }
  if (
    arm == "ref"
    && arrLitRefShortSlot(ix, ibFnIx, lb) < 0
    && vslot < 0
    && uslot < 0
    && lslot < 0
  ) {
    return irBMiss("array ref")
  }
  if (
    arm != "i32"
    && arm != "f64"
    && arm != "i64"
    && arm != "f32"
    && arm != "str"
    && arm != "ref"
    && arm != "u8"
    && arm != "v128"
  ) {
    return irBMiss("array " + arm)
  }
  const sw = if arm == "ref" { "" } else { arrLitShortWhy(ix, ibFnIx, arm, n.arrElems.length) }
  // A string list past the operand cap is legacy's chunked build, of literal elements only here.
  const strChunk = sw == "long" && arm == "str" && allStrLits(n.arrElems)
  // A long literal of constants builds from one data segment (`arrLitLongRouteOf`); a computed
  // element's store, or another arm's chunked build, is legacy's.
  const route = if sw == "long" && !strChunk { arrLitLongRouteOf(n.arrElems, ibFnIx, arm, lb.lbSlot) } else { "chunk" }
  const dataConst = sw == "long" && !strChunk && route == "dataConst"
  // Any other long literal of a scalar arm is legacy's chunked build (`arrLitChunkPlanOf`), its
  // elements built as a short literal's are.
  const chunk = sw == "long" && !strChunk && route == "chunk" && arm != "ref"
  // A long literal with computed elements is the segment of its constants, each computed element
  // stored after (`arrLitDataOpen`): a constant is one immediate, a computed one built as usual.
  const dataComputed = sw == "long" && !strChunk && route == "dataComputed"
  if sw == "long" && !strChunk && !dataConst && !chunk && !dataComputed {
    return irBMiss("array long " + route)
  }
  // A `null[]` element seeding an i32 list is the sentinel 2 (`emitArrI32`).
  const nulSent = sw == "null sentinel"
  if sw != "" && sw != "long" && !nulSent { return irBMiss("array " + sw) }
  // Typed at the type legacy's build decision takes (`arrLitBuiltTyOf`): an instance's `[1.5]` at
  // `T[]` is an f32 list where its stamp says f64. Its own-shape route keeps the stamp. `bt` is the
  // type behind `lb`, the build the literal's delivery threaded.
  const atBt = bt >= 0 && repNodeAt(repNodeOfTy(bt)) is RList
  const lrep = if atBt { repNodeOfTy(bt) } else { rep }
  const ln = repNodeAt(lrep)
  if !(ln is RList) { return irBMiss("array rep") }
  // A union-box slot's elements are boxes: a list the instance reps at its bound member is not one.
  if (
    arm == "ref"
    && (arrLitUnionBoxSlot(ix, ibFnIx, lb) >= 0 || uslot >= 0)
    && !heldAsBox(ln.rlsElem)
  ) {
    return irBMiss("array union element rep")
  }
  // A packed list's elements are built as plain i32s, which its backing truncates; a `null[]`'s
  // too, its i32 storage holding each `null` as the sentinel.
  const er = if arm == "u8" || repPrim(ln.rlsElem) == "null" { repNodeOfTy(TY_I32) } else { ln.rlsElem }
  const elems: Opnd[] = []
  const starts: i32[] = []
  // A `for` iterable's signed number literal at a number element is one immediate, as legacy's
  // hoist reads it whole; at any other element (a numeric union's box) it is delivered.
  const ep = repPrim(er) ?? ""
  const forIter = arrLitIsForIter(ix)
    && (ep == "i32" || ep == "i64" || ep == "f32" || ep == "f64")
  for e in n.arrElems {
    const at = b.length
    starts.push(at)
    const v = if dataConst || dataComputed && arrLitElemIsConst(e) { longConstElem(e, er) } else if vslot >= 0 { variantElem(b, e, er, vslot) } else if uslot >= 0 { boxTempIn(
      b,
      unionElemValue(b, e),
      e,
      er,
      -1,
      arrRefUnionElemTy(ix, uslot, ibFnIx),
    ) } else if forIter && isSignedNumLit(e) { signedLitAt(unwrapParen(e), er) } else if nulSent && arrElemNulSent(e, ibFnIx) { nulSentinelElem(b, e, er) } else if arm == "ref" && elemTwinTy(e, er) >= 0 { objLitAt(
      b,
      unwrapParen(e),
      er,
      elemTwinTy(e, er),
      objLitLayoutRowOf(unwrapParen(e), ibFnIx),
      false,
    ) } else { deliver(b, e, er, -1) }
    if ibMiss != "" { return v }
    // An element written before a valued `if` is staged below it, as a call's argument is.
    if elems.length > 0 && !irBStageLeads(b, at, starts, elems, n.arrElems) {
      return irBMiss("short-circuit array element after another")
    }
    // A closure whose rep leaves a part open, or fills one, is the element's closure struct,
    // retagged, as a record field's is. A record or list element is not: its retag is no closure's.
    const holed = irBOpRep(v) != er
      && repNodeAt(irBOpRep(v)) is RClosure
      && repNodeAt(er) is RClosure
      && holeRetagNoted(irBOpRep(v), er, true)
      && exprPrePathWhy(e, ibFnIx) == ""
    // A list twin, a variant record at its struct twin, or a record on the element's heap or a
    // declared subtype's goes in as it stands, retagged, as an argument does (`retagsAsStands`).
    const ve = if holed || irBOpRep(v) != er && retagsAsStands(irBOpRep(v), er, e) { repTemp(b, { rgV: v }, e, er) } else { v }
    if irBOpRep(ve) != er { return irBMiss("array element coercion") }
    elems.push(ve)
  }
  // A chunked ref list writes each chunk's flush between its elements, which a valued `if`'s out,
  // waiting on the stack below the elements after it, cannot cross.
  if (
    arm == "ref"
    && starts.length > allocLitChunk()
    && ifBelowLeadHas(b, starts[0], b.length)
  ) {
    return irBMiss("chunked list valued element")
  }
  const r: Rhs = {
    mlElems: elems,
    mlKind: lb.lbKind,
    mlSlot: lb.lbSlot,
    mlAt: ix,
    mlArm: arm,
  }
  if atBt { return irBLetTempTy(b, r, ix, lrep, heldTy(bt)) }
  return irBLetTemp(b, r, ix, lrep)
}

// Element `e` of a list literal at variant slot `vslot` (`arrLitVariantSlot`), at element rep
// `er`: an object literal built at the variant's row, as `emitVariantStruct` builds it, else the
// value as it stands.
function variantElem(b: i32[], e: i32, er: i32, vslot: i32): Opnd {
  const vi = rlElemVariantRow(vslot)
  if variantCoerceArmOf(vi, e, ibFnIx) != "struct" {
    return deliver(b, e, er, -1)
  }
  return variantCoerced(b, e, er, rlElemTyIxAt(vslot), vi)
}

// Whether local binding `ix` is an arm cell, whose initializer legacy's `emitLetInitValue`
// delivers through `emitVariantCoerce`: a `variant` cell bound to anything but an `if`.
function letIsArmCell(ix: i32): boolean {
  const n = nodeAt(ix)
  return n is LetDecl
    && !exprIsIfStmt(n.letInit)
    && letCellKind(ix, ibFnIx) == "variant"
}

// Value `e` delivered at rep `rep` of type `ty` as `emitVariantCoerce` builds it into variant row
// `vi`: an object literal at the row (its `struct` arm), else the value at the type.
function variantCoerced(b: i32[], e: i32, rep: i32, ty: i32, vi: i32): Opnd {
  if vi < 0 || variantCoerceArmOf(vi, e, ibFnIx) != "struct" {
    return deliver(b, e, rep, ty)
  }
  const pre = exprPrePathWhy(e, ibFnIx)
  if pre != "" { return irBMiss(pre) }
  return objLitAt(b, unwrapParen(e), rep, ty, vi, true)
}

// A spread literal along legacy's plain arm (`spreadPlanOf`): each item group, a spread source or a
// run of plain elements as legacy's run literal, built raw as legacy emits it at the literal's own
// list rep and row, into slots its recorded ordinal keys; a boxing literal along `spreadBoxedLit`.
// A converting literal is a miss.
function spreadLit(
  b: i32[],
  n: ArrayLit,
  ix: i32,
  want: i32,
  lb: ListBuild,
  bt: i32,
): Opnd {
  // Legacy notes the literals the spread holds first (`emitArrAt`), so each is typed at its holder's
  // element; the plan asked without that note mints the literals' own lists. The note is idempotent.
  elabSpreadNote(ix)
  // Built at its built type's list, which a fresh source typed at the destination's element sets
  // apart from the literal's own (D4871); the consumer meets that rep. A twin keeps the literal's.
  const btRep = if bt >= 0 { repNodeOfTy(bt) } else { -1 }
  const rebuilt = btRep >= 0
    && btRep != want
    && repNodeAt(btRep) is RList
    && !listRetag(want, btRep)
    && !holeRetagNoted(want, btRep, true)
  const rep = if rebuilt { btRep } else { want }
  const destRow = spreadBoxDestRow(n.arrElems, ibFnIx, lb)
  if destRow >= 0 { return spreadBoxedLit(b, n, ix, lb, destRow) }
  if spreadBoxingSource(ix, ibFnIx) >= 0 {
    const own = spreadOwnBoxRow(ix, n.arrElems, ibFnIx)
    if own < 0 { return irBMiss("array spread boxed") }
    return spreadBoxedLit(b, n, ix, lb, own)
  }
  const p = spreadPlanOf(ix, ibFnIx, lb)
  if p.spWhy != "" { return irBMiss("array spread plan") }
  // A group at another element kind is converted by the plan's own tail (`spreadGroupStash`): an
  // atom list into a `string` list, or a scalar list widened.
  const conv: i32[] = []
  let ck = 0
  while ck < p.spSrcKinds.length {
    const k = p.spSrcKinds[ck]
    if k != p.spKind {
      if !spreadGroupConverts(k, p.spKind) {
        return irBMiss("array spread conversion")
      }
      conv.push(ck)
    }
    ck = ck + 1
  }
  // A group at a sub row (a source whose element is a subtype of the row's) is stashed and copied
  // at that row, as the list it is.
  const atOwn: i32[] = []
  let gr = 0
  while gr < p.spGroupRows.length {
    if i32ListHas(conv, gr) || p.spGroupRows[gr] != p.spRow { atOwn.push(gr) }
    gr = gr + 1
  }
  if !(repNodeAt(rep) is RList) { return irBMiss("array rep") }
  // The groups as legacy's arm makes them, every run literal before any group is built.
  const grps: i32[] = []
  let run: i32[] = []
  for e in n.arrElems {
    const src = spreadArgOf(e)
    if src >= 0 {
      if run.length > 0 {
        grps.push(spreadRunLit(run, ix, ix, n.pos))
        run = []
      }
      grps.push(src)
    } else {
      run.push(e)
    }
  }
  if run.length > 0 { grps.push(spreadRunLit(run, ix, ix, n.pos)) }
  if grps.length != p.spSrcs.length {
    return irBMiss("array spread plan groups")
  }
  const at = b.length
  const srcs: Opnd[] = []
  let g = 0
  while g < grps.length {
    const v0 = spreadSrcBuild(b, p, g, grps[g], ix, rep)
    if ibMiss != "" { return v0 }
    // A source list whose rep is the literal's twin, or apart only in a hole, is the same list
    // retagged: the plan copies its elements raw, at one kind.
    const v = if irBOpRep(v0) != rep
      && (listRetag(irBOpRep(v0), rep) || holeRetagNoted(irBOpRep(v0), rep, true)) { repTemp(b, { rgV: v0 }, grps[g], rep) } else { v0 }
    // A converted group reaches the tail as a list at its own element rep, which the tail converts.
    if i32ListHas(conv, g) && irBOpRep(v) == rep {
      return irBMiss("array spread conversion")
    }
    if (
      irBOpRep(v) != rep
      && !(i32ListHas(atOwn, g) && repNodeAt(irBOpRep(v)) is RList)
    ) {
      return irBMiss("array spread source rep")
    }
    srcs.push(v)
    g = g + 1
  }
  // An unminted pair is minted where legacy's arm asks it, before the first group's writing.
  if !spreadPairKnown(p) && b.length > at {
    const nt: SpreadPairNote = {
      sqAt: ix,
      sqKind: lb.lbKind,
      sqSlot: lb.lbSlot,
      sqBoxRow: -1,
    }
    ib.irSpreadPair[b[at]] = nt
  }
  if ifBelowLead(b, at, "array spread short-circuit operand") { return srcs[0] }
  const r: Rhs = {
    spSrcs: srcs,
    spGroups: grps,
    spKind: lb.lbKind,
    spSlot: lb.lbSlot,
    spAt: ix,
    spBoxRow: -1,
    spOwn: atOwn,
  }
  // A minted literal (a variadic push's run) has no checker type; it holds its build's. A literal
  // held at its laid-out row is typed at that row's list (`outTyOf`).
  const own = if rebuilt { heldTy(bt) } else { heldTy(outTyOf(ix, rep)) }
  const ty = if irTyHeldOpen(own, rep) && bt >= 0 { heldTy(bt) } else { own }
  return irBLetTempTy(b, r, ix, rep, ty)
}

// A spread literal along legacy's boxing arm (`emitArrSpreadBoxed`) at union-box row `row`: each
// group built as `emitSpreadGroupBoxed` builds it, a run or linked literal at the literal's own
// rep, a source as itself, which the lowering then boxes or retags to the row.
function spreadBoxedLit(
  b: i32[],
  n: ArrayLit,
  ix: i32,
  lb: ListBuild,
  row: i32,
): Opnd {
  // The list holds `row`'s boxes, whatever the literal's own type: its rep is that row's list.
  const lt = listTyOfElem(arrRefUnionElemTy(ix, row, ibFnIx))
  const lrep = repNodeOfTy(lt)
  const ln = repNodeAt(lrep)
  if !(ln is RList) || !heldAsBox(ln.rlsElem) {
    return irBMiss("array spread boxed rep")
  }
  const grps: i32[] = []
  const isSrc: boolean[] = []
  let run: i32[] = []
  for e in n.arrElems {
    const src = spreadArgOf(e)
    if src >= 0 {
      if run.length > 0 {
        grps.push(spreadRunLit(run, ix, ix, n.pos))
        isSrc.push(false)
        run = []
      }
      grps.push(src)
      isSrc.push(true)
    } else {
      run.push(e)
    }
  }
  if run.length > 0 {
    grps.push(spreadRunLit(run, ix, ix, n.pos))
    isSrc.push(false)
  }
  const at = b.length
  const srcs: Opnd[] = []
  let g = 0
  while g < grps.length {
    const v = spreadBoxedGroup(b, grps[g], isSrc[g], row, lrep, lt)
    if ibMiss != "" { return v }
    srcs.push(v)
    g = g + 1
  }
  // An unminted pair is minted where legacy's boxing arm asks it, before the first group's writing.
  if !spreadRefPairKnown(row) && b.length > at {
    const nt: SpreadPairNote = {
      sqAt: ix,
      sqKind: lb.lbKind,
      sqSlot: lb.lbSlot,
      sqBoxRow: row,
    }
    ib.irSpreadPair[b[at]] = nt
  }
  if ifBelowLead(b, at, "array spread short-circuit operand") { return srcs[0] }
  const r: Rhs = {
    spSrcs: srcs,
    spGroups: grps,
    spKind: lb.lbKind,
    spSlot: lb.lbSlot,
    spAt: ix,
    spBoxRow: row,
    spOwn: [],
  }
  return irBLetTempTy(b, r, ix, lrep, lt)
}

// Group `grp` of a boxing spread as `emitSpreadGroupBoxed` builds it before its tail: a run or a
// linked literal at the union-box row `row` (its list rep `rep`, type `ty`) unless its typed build
// takes it, any other source as itself; a literal source at another build is a miss.
function spreadBoxedGroup(
  b: i32[],
  grp: i32,
  isSrc: boolean,
  row: i32,
  rep: i32,
  ty: i32,
): Opnd {
  const lit = unwrapParen(grp)
  if lit < 0 { return irBMiss("array spread source") }
  const ln = nodeAt(lit)
  if !(ln is ArrayLit) { return irBExpr(b, grp) }
  const ba = arrLitBuildAt(lit, arrLitTyAt(lit, ibFnIx), ibFnIx)
  const tb = ba.baBuild
  if tb != null {
    const lrep = if ba.baTy >= 0 { repNodeOfTy(ba.baTy) } else { exprRepOf(lit) }
    if lrep < 0 { return irBMiss("array spread literal source rep") }
    return arrayLit(b, ln, lit, lrep, tb, ba.baTy)
  }
  if !spreadBoxedGroupIsRun(grp, isSrc) {
    return irBMiss("array spread boxed literal source")
  }
  const gb: ListBuild = { lbKind: LBK_UNION, lbSlot: row }
  return arrayLit(b, ln, lit, rep, gb, ty)
}

// Group `g`'s list `src` of literal `ix` (rep `rep`) built as `emitSpreadGroup` emits it: a list
// literal at its own typed build, typed at that build's type, else at the group's, which is the
// literal's own kind and row and so its type; any other source as itself, with no paren between.
function spreadSrcBuild(
  b: i32[],
  p: SpreadPlan,
  g: i32,
  src: i32,
  ix: i32,
  rep: i32,
): Opnd {
  const lit = unwrapParen(src)
  if lit < 0 { return irBMiss("array spread source") }
  const ln = nodeAt(lit)
  if !(ln is ArrayLit) { return irBExpr(b, src) }
  const ba = arrLitBuildAt(lit, arrLitTyAt(lit, ibFnIx), ibFnIx)
  const tb = ba.baBuild
  if tb != null {
    // At its build's type, which a run literal legacy's arm minted is the only rep of, and which a
    // literal its group widens differs from its own type at.
    const lrep = if ba.baTy >= 0 { repNodeOfTy(ba.baTy) } else { exprRepOf(lit) }
    if lrep < 0 { return irBMiss("array spread literal source rep") }
    return arrayLit(b, ln, lit, lrep, tb, ba.baTy)
  }
  const gb: ListBuild = { lbKind: p.spGroupKinds[g], lbSlot: p.spGroupRows[g] }
  return arrayLit(b, ln, lit, rep, gb, exprTyOf(ix))
}

// `l ?? d` by legacy's own ladder: the arm `coalArmOf` names. Only a fused map read is built.
// `cell` as `exprAt`'s: an arm that writes its left operand alone passes it to that operand.
function coalesce(
  b: i32[],
  n: BinExpr,
  ix: i32,
  rep: i32,
  cell: boolean,
): Opnd {
  const arm = coalArmOf(n, ix, ibFnIx)
  if arm == "closed" { return coalClosed(b, n, ix, rep) }
  if arm == "chain" { return coalChain(b, n, ix, rep) }
  if arm == "niche" { return coalNiche(b, n, ix, rep) }
  if arm == "popOr" { return coalPopOr(b, n, ix, rep) }
  if arm == "listGetOr" { return coalListGetOr(b, n, ix, rep) }
  // A map read joining a union is legacy's synthesized null-test `if` (`coalNullTestIf`), built
  // as the valued `if` it is.
  if arm == "mapJoinIf" {
    const v = irBExpr(b, coalNullTestIf(n, ix, ibFnIx))
    if ibMiss != "" { return v }
    if irBOpRep(v) != rep { return irBMiss("coalesce mapJoinIf rep") }
    return v
  }
  // The operand as itself where its type rules out `null`, or a dead join legacy types at the
  // join (`coalDeadJoinIfOf`), built as the valued `if` it is.
  if (
    arm == "retypedDead"
    || arm == "pinNonNull"
    || arm == "fieldFlat"
    || arm == "popElem"
  ) {
    if cell { return exprAt(b, n.binLeft, true) }
    return coalAsBuilt(b, unwrapParen(n.binLeft), rep, arm)
  }
  if arm == "deadJoin" {
    return coalAsBuilt(b, coalDeadJoinIfOf(n, ix, ibFnIx), rep, arm)
  }
  // A `null`-typed operand runs for its effect alone, then the default is the value.
  if arm == "nulnone" {
    const effs: Opnd[] = []
    const e = nulNoneEffect(b, n.binLeft, ix, effs)
    if ibMiss != "" { return e }
    const d = coalAsBuilt(b, n.binRight, rep, arm)
    if ibMiss != "" || effs.length == 0 { return d }
    // The left's effects are written where the value is read, as legacy writes the whole `??`.
    return irBLetTemp(b, { aeEff: effs, aeV: d, aeAt: ix }, ix, rep)
  }
  // A hole's map read is legacy's null-test `if` too (`coalHoleMapIfOf`), a minted link's of the
  // link's type, which it carries none of.
  if arm == "holeMap" {
    const hi = coalHoleMapIfOf(n, ix, ibFnIx)
    if coalLinkChainOf(unwrapParen(ix)) >= 0 && nodeTyAt(hi, ibFnIx) < 0 {
      ibLinkIfTy[hi] = exprTyOf(ix)
    }
    const v = irBExpr(b, hi)
    if ibMiss != "" { return v }
    if irBOpRep(v) != rep { return irBMiss("coalesce holeMap rep") }
    return v
  }
  if arm == "mapScalarJoin" { return coalMapScalarJoin(b, n, ix, rep) }
  if arm == "boxRuntime" { return coalBoxRuntime(b, n, ix, rep) }
  if arm != "mapIndexGetOr" { return irBMiss("coalesce " + arm) }
  return mapGetOr(b, n, ix, rep)
}

// A fused map read's inline default: built as itself, or, where that is a record at a row other
// than the read's, delivered at the read's rep as the hit's record is held.
function inlineDefault(b: i32[], ix: i32, rep: i32): Opnd {
  const own: i32[] = []
  const v = irBExpr(own, ix)
  if ibMiss != "" || irBOpRep(v) == rep || !(repNodeAt(rep) is RRecord) {
    for id in own { b.push(id) }
    return v
  }
  return deliver(b, ix, rep, -1)
}

// `m[k] ?? d` over a scalar-valued map joining a union, as `emitMapGetOrScalarJoin` writes it: the
// probe, a hit's scalar boxed at its own arm, and `d` boxed into the union in the miss arm.
function coalMapScalarJoin(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const lhsIx = unwrapParen(n.binLeft)
  if lhsIx < 0 { return irBMiss("map read") }
  const rd = nodeAt(lhsIx)
  if !(rd is Index) || coalMapRecvOf(n) != rd.idxArr {
    return irBMiss("coalesce mapScalarJoin call")
  }
  const ak = mapRecvScalarBoxKindIn(rd.idxArr, ibFnIx)
  if ak < 0 || !mapScalarJoinBoxes(n, ak, ibFnIx) {
    return irBMiss("coalesce mapScalarJoin row")
  }
  if !heldAsBox(rep) { return irBMiss("coalesce mapScalarJoin rep") }
  const sh = mapRecvShapeOf(rd.idxArr, ibFnIx)
  const ka = mapKeyArmOf(rd.idxArr, rd.idxIndex, ibFnIx, sh)
  if ka != "plain" && ka != "i64" { return irBMiss("map key " + ka) }
  const rcv = mapRecvKeyOf(
    b,
    rd.idxArr,
    rd.idxIndex,
    "map read receiver",
    ka == "i64",
  )
  if rcv == null { return irBMiss(ibMiss) }
  const db: i32[] = []
  const dv = deliver(db, n.binRight, rep, boxDstTyOf(n.binRight, ibFnIx))
  if ibMiss != "" { return dv }
  if irBOpRep(dv) != rep { return irBMiss("map read default rep") }
  if !defaultSelfContained(db, 0, dv) {
    return irBMiss("coalesce mapScalarJoin default computes")
  }
  for id in db { b.push(id) }
  const r: Rhs = {
    mgSym: rcv.mkSym,
    mgNonNull: rcv.mkNonNull,
    mgLoc: rcv.mkLoc,
    mgKey: rcv.mkKey,
    mgAt: ix,
    mgForm: 7,
    mgDef: dv,
  }
  return irBLetTemp(b, r, ix, rep)
}

// A `null`-typed operand `x` run for its effect, as legacy's `emitNulNoneForEffect` writes it:
// nothing for a `null` or a name, the receiver of a `?.`, both sides of a `??`, an if-expression's
// void `if` (`ifForEffect`), else the value built and dropped here, or where `sink` is given,
// pushed onto it for its reader to drop.
function nulNoneEffect(b: i32[], x: i32, ix: i32, sink: Opnd[] | null): Opnd {
  const none: Opnd = { oiRep: ibNoValue, oiBits: 0 }
  if nulNoneWritesNothing(x) { return none }
  const u = unwrapParen(x)
  if u < 0 { return irBMiss("coalesce nulnone effect") }
  const n = nodeAt(u)
  if n is IfStmt {
    // A void `if` leaves no value a sink's reader could drop in order, so it is written here; with
    // no temp waiting below it, that is where legacy writes it too.
    if sink != null && endsInTemp(b) {
      return irBMiss("coalesce nulnone effect if")
    }
    ifForEffect(b, n, u)
    return none
  }
  if n is OptMember { return nulNoneEffect(b, n.omObj, ix, sink) }
  const co = plainCoalesceAt(u)
  if co != null {
    const l = nulNoneEffect(b, co.binLeft, ix, sink)
    if ibMiss != "" { return l }
    return nulNoneEffect(b, co.binRight, ix, sink)
  }
  // An element read is dropped as it is stored (`buildIndex`'s `nulDropped`).
  const em = if n is Index { storageReadEnter(u) } else { storageReadEnter(-1) }
  const v = irBExpr(b, u)
  storageReadLeave(em)
  if ibMiss != "" { return v }
  if sink == null {
    irBNode(b, { dpV: v }, -1, ibNoValue, ix)
  } else {
    sink.push(v)
  }
  return none
}

// Node `x` built as itself at the `??`'s rep `rep`, or the miss arm `arm` names.
function coalAsBuilt(b: i32[], x: i32, rep: i32, arm: string): Opnd {
  if x < 0 { return irBMiss("coalesce " + arm) }
  const v = irBExpr(b, x)
  if ibMiss != "" { return v }
  if irBOpRep(v) != rep { return irBMiss("coalesce " + arm + " rep") }
  return v
}

// `a ?? b ?? d` as legacy lowers it: the re-associated outer link `a ?? (b ?? d)` minted ahead of
// the bodies (`coalChainLinkOf`), at the chain's own rep.
function coalChain(b: i32[], _n: BinExpr, ix: i32, rep: i32): Opnd {
  const ro = coalChainLinkOf(ix, ibFnIx)
  if ro < 0 { return irBMiss("coalesce chain unminted") }
  const o = irBExpr(b, ro)
  if ibMiss != "" { return o }
  if irBOpRep(o) != rep { return irBMiss("coalesce chain rep") }
  return o
}

// `l ?? d` whose left operand an instance closed to a type with no `null`: legacy writes the left
// operand alone, at its own rep. A widened atom left is legacy's.
function coalClosed(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  if coalClosedWidensAtom(unwrapParen(n.binLeft), ix, ibFnIx) {
    return irBMiss("coalesce closed atom")
  }
  const l = irBExpr(b, n.binLeft)
  if ibMiss != "" { return l }
  if irBOpRep(l) != rep { return irBMiss("coalesce closed coercion") }
  return l
}

// The fused `xs.pop() ?? d` over a scalar list (legacy's `emitPopOr`): the receiver, then the
// shared `if` on its length, the default built into its empty arm so it runs only there. The
// default must already sit at the element rep, the one `emitScalarValue` writes it at.
function coalPopOr(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const lhsIx = unwrapParen(n.binLeft)
  const p = popOrPlanOf(lhsIx, ibFnIx)
  if p == null { return irBMiss("coalesce popOr plan") }
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  // Its value stays on the stack from here, so no temp an operand before it built may wait.
  if endsInTemp(b) { return irBMiss("coalesce popOr after an operand") }
  const l = irBExpr(b, p.poRecv)
  if ibMiss != "" { return l }
  const ln = repNodeAt(irBOpRep(l))
  if !(ln is RList) || ln.rlsElem != rep {
    return irBMiss("coalesce popOr result rep")
  }
  const t = irVarNew(ib, rep, ty, "local", -1)
  const nb: i32[] = []
  if !coalNeverDefault(nb, n.binRight, rep, t) {
    const d = irBExpr(nb, n.binRight)
    if ibMiss != "" { return d }
    if irBOpRep(d) != rep { return irBMiss("popOr default conversion") }
    irBNode(nb, { asDst: t, asSrc: d }, -1, ibNoValue, ix)
  }
  if ibMiss != "" { return irBMiss(ibMiss) }
  irBNode(
    b,
    {
      cbL: l,
      cbLB: [],
      cbArm: "popOr",
      cbNull: nb,
      cbOut: t,
      cbAt: ix,
      cbMap: null,
      cbIdx: null,
    },
    ty,
    rep,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// The fused `xs.get(i) ?? d` over a scalar list (legacy's `emitListGetOr`): its shared head reads
// the receiver and the index twice from the call, so only operands it re-reads in place are
// taken; the default is built into the `else` arm at the element rep, as `coalPopOr`'s.
function coalListGetOr(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const c = nodeAt(unwrapParen(n.binLeft))
  if !(c is Call) || c.callFn < 0 || c.callArgs.length != 1 {
    return irBMiss("coalesce listGetOr call")
  }
  const m = nodeAt(c.callFn)
  if !(m is Member) { return irBMiss("coalesce listGetOr call") }
  const recvReRead = optRecvReReadable(m.memObj)
  const idxReRead = listGetIdxReReadable(c.callArgs[0])
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  // Its value stays on the stack from here, so no temp an operand before it built may wait.
  if endsInTemp(b) { return irBMiss("coalesce listGetOr after an operand") }
  const la = b.length
  const l = irBExpr(b, m.memObj)
  if ibMiss != "" { return l }
  // A receiver legacy cannot re-read is held in a local of its own (`heldInLocal`).
  if !recvReRead && !(l is OVar) {
    return irBMiss("coalesce listGetOr staged operand")
  }
  const recv = if recvReRead { l } else { heldInLocal(b, l, ix) }
  const ln = repNodeAt(irBOpRep(l))
  if !(ln is RList) || ln.rlsElem != rep {
    return irBMiss("coalesce listGetOr result rep")
  }
  // A receiver legacy re-reads is a pure read the lowering skips: its nodes wait aside while the
  // index builds, so an index's own fused `??` finds no temp waiting, and go back before a plain
  // index or after an index's statements.
  const aside: i32[] = []
  if recvReRead {
    while b.length > la { aside.push(b.pop() ?? -1) }
  }
  const at = b.length
  const i0 = irBExpr(b, c.callArgs[0])
  if ibMiss != "" { return i0 }
  const idxNodes = b.length - at
  const idxOneTemp = oneTempAt(b, at, i0)
  if irBOpRep(i0) != repNodeOfTy(TY_I32) {
    return irBMiss("coalesce listGetOr index operand")
  }
  // An index that built nothing is legacy's own re-read; any other is one temp, held once in a
  // local (`irGetIdxBegin`), or held in a local of its own after the statements it built (an inner
  // fused `??`, say).
  const idxPlain = idxReRead && idxNodes == 0
  if !idxPlain && !(i0 is OVar) {
    return irBMiss("coalesce listGetOr index operand")
  }
  const i = if !idxPlain && !idxOneTemp { heldInLocal(b, i0, ix) } else { i0 }
  if aside.length > 0 {
    const tail: i32[] = []
    if idxNodes == 0 || idxOneTemp {
      while b.length > at { tail.push(b.pop() ?? -1) }
    }
    while aside.length > 0 { b.push(aside.pop() ?? -1) }
    while tail.length > 0 { b.push(tail.pop() ?? -1) }
  }
  // Legacy's head reads the index at each use, so an immediate, a variable or that temp is handed
  // to it.
  const reread = i is OImm
    || i is OVar
    && i.ov >= 0
    && i.ov < ib.irVars.length
    && (ib.irVars[i.ov].vKind != "temp" || !idxPlain)
  const t = irVarNew(ib, rep, ty, "local", -1)
  const nb: i32[] = []
  if !coalNeverDefault(nb, n.binRight, rep, t) {
    const d = irBExpr(nb, n.binRight)
    if ibMiss != "" { return d }
    if irBOpRep(d) != rep { return irBMiss("listGetOr default conversion") }
    irBNode(nb, { asDst: t, asSrc: d }, -1, ibNoValue, ix)
  }
  if ibMiss != "" { return irBMiss(ibMiss) }
  irBNode(
    b,
    {
      cbL: recv,
      cbLB: [],
      cbArm: "listGetOr",
      cbNull: nb,
      cbOut: t,
      cbAt: ix,
      cbMap: null,
      cbIdx: if reread { i } else { null },
    },
    ty,
    rep,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// `l ?? d` over a `string | null` along legacy's plain block (`coalNulRefArmOf`), its default
// a string literal and its result the block's own rep. Every other niche arm is a named miss.
function coalNiche(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const lhsIx = unwrapParen(n.binLeft)
  if lhsIx < 0 { return irBMiss("coalesce operand") }
  const na = coalNicheArmOf(n, lhsIx, ix, ibFnIx)
  if na == "nulAtomStr" { return coalAtomStr(b, n, lhsIx, ix, rep) }
  if na == "identBox" { return coalBox(b, n, lhsIx, ix, rep) }
  if na == "coll" || na == "clo" { return coalNulRef(b, n, lhsIx, ix, rep) }
  if na == "litUnion" { return coalNicheCell(b, n, lhsIx, ix, rep, "litUnion") }
  if na == "nulBool" { return coalNicheCell(b, n, lhsIx, ix, rep, "nulBool") }
  if na == "nulBoolJoin" { return coalNulBoolJoin(b, n, ix, rep) }
  if na != "str" { return irBMiss("coalesce niche " + na) }
  const sa = coalNulRefArmOf(n, ix, ibFnIx)
  if sa == "join" { return coalNulStrJoin(b, n, ix, rep) }
  if sa == "litAtom" { return coalNulStr(b, n, ix, rep, true) }
  if sa != "plain" { return irBMiss("coalesce string shape") }
  const dIx = unwrapParen(n.binRight)
  if dIx < 0 || !(nodeAt(dIx) is StrLit) {
    return coalNulStr(b, n, ix, rep, false)
  }
  // An if-expression operand is built inside the block, where legacy writes it (`nulStr`).
  if nodeAt(lhsIx) is IfStmt { return coalNulStr(b, n, ix, rep, false) }
  const lat = b.length
  const l = irBExpr(b, n.binLeft)
  if ibMiss != "" { return l }
  // Legacy writes the operand inside the coalesce's block, above which a valued `if` cannot sit,
  // nor an inner `??`, whose out stays on the stack as one's does.
  if valuedIfFrom(b, lat) { return irBMiss("coalesce of a valued if") }
  if coalBoxFrom(b, lat, true) || coalBoxFrom(b, lat, false) {
    return irBMiss("coalesce string operand holds a ??")
  }
  if !strNullable(irBOpRep(l)) { return irBMiss("coalesce operand rep") }
  const nul = coalesceNulStrStaysNullable(ix, ibFnIx)
  const want = if nul { irBOpRep(l) } else { strInnerOf(irBOpRep(l)) }
  if rep != want { return irBMiss("coalesce result rep") }
  const d = irBExpr(b, n.binRight)
  if ibMiss != "" { return d }
  if !(d is OStr) { return irBMiss("coalesce string default") }
  const r: Rhs = { czL: l, czD: d, czAt: ix }
  return irBLetTemp(b, r, ix, rep)
}

// `l ?? d` over a `string | null` whose default joins it into a box: legacy's join at the string
// heap (`emitCoalesceNulRefJoin` at `sTy()`), the operand staged ahead of its `if` and the default
// delivered into the result's box on the null path.
function coalNulStrJoin(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  if coalNulRefJoinWhy(n, sTy(), ibFnIx) != "" {
    return irBMiss("coalesce string join refused")
  }
  if !boxOwedAt(n.binRight, ibFnIx) {
    return irBMiss("coalesce string join default")
  }
  if !heldAsBox(rep) { return irBMiss("coalesce string join rep") }
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  const l = irBExpr(b, n.binLeft)
  if ibMiss != "" { return l }
  if !(l is OVar) || l.ov < 0 { return irBMiss("coalesce string operand") }
  if !strNullable(irBOpRep(l)) { return irBMiss("coalesce operand rep") }
  const t = irVarNew(ib, rep, ty, "local", -1)
  const nb: i32[] = []
  const d = deliver(nb, n.binRight, rep, -1)
  if ibMiss != "" { return d }
  if irBOpRep(d) != rep { return irBMiss("coalesce string default rep") }
  irBNode(nb, { asDst: t, asSrc: d }, -1, ibNoValue, ix)
  const arm: CoalValArm = "nulStr"
  irBNode(
    b,
    {
      cbL: l,
      cbLB: [],
      cbArm: arm,
      cbNull: nb,
      cbOut: t,
      cbAt: ix,
      cbMap: null,
      cbIdx: null,
    },
    ty,
    rep,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// `l ?? d` over a `string | null` whose default computes: legacy's `br_on_non_null` core at the
// string heap (`emitCoalesceNulRefCtx` at `sTy()`), the operand built into the block and the
// default built where it runs only on `null`, the block nullable as `coalesceNulStrStaysNullable`.
// An `atom` default (the `litAtom` arm) decodes to its member string (`emitCoalesceAtomStrDefault`).
function coalNulStr(
  b: i32[],
  n: BinExpr,
  ix: i32,
  rep: i32,
  atom: boolean,
): Opnd {
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  const lb: i32[] = []
  const l = irBExpr(lb, n.binLeft)
  if ibMiss != "" { return l }
  if !(l is OVar) || l.ov < 0 { return irBMiss("coalesce string operand") }
  if !strNullable(irBOpRep(l)) { return irBMiss("coalesce operand rep") }
  const nul = coalesceNulStrStaysNullable(ix, ibFnIx)
  const want = if nul { irBOpRep(l) } else { strInnerOf(irBOpRep(l)) }
  if rep != want { return irBMiss("coalesce result rep") }
  const nb: i32[] = []
  let t = -1
  if atom || !coalNeverDefault(nb, n.binRight, rep, t) {
    const d0 = irBExpr(nb, n.binRight)
    if ibMiss != "" { return d0 }
    const d = if atom { coalAtomStrDefault(nb, d0, n.binRight, nul, rep) } else { d0 }
    if ibMiss != "" { return d }
    if irBOpRep(d) != rep { return irBMiss("coalesce string default rep") }
    // A default and an operand that build nothing are written in place, as the literal's core is.
    if lb.length == 0 && nb.length == 0 {
      const r: Rhs = { czL: l, czD: d, czAt: ix }
      return irBLetTemp(b, r, ix, rep)
    }
    t = irVarNew(ib, rep, ty, "local", -1)
    irBNode(nb, { asDst: t, asSrc: d }, -1, ibNoValue, ix)
  }
  if ibMiss != "" { return irBMiss(ibMiss) }
  if t < 0 { t = irVarNew(ib, rep, ty, "local", -1) }
  const arm: CoalValArm = "nulStr"
  irBNode(
    b,
    {
      cbL: l,
      cbLB: lb,
      cbArm: arm,
      cbNull: nb,
      cbOut: t,
      cbAt: ix,
      cbMap: null,
      cbIdx: null,
    },
    ty,
    rep,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// Atom default `v` of node `dIx` decoded at string rep `rep`; a `null` the decode keeps where the
// block is non-null (legacy's `ref.as_non_null` after it) is a miss.
function coalAtomStrDefault(
  nb: i32[],
  v: Opnd,
  dIx: i32,
  nul: boolean,
  rep: i32,
): Opnd {
  if !nul && nulAtomWidenTexts(dIx, ibFnIx).length > 0 {
    return irBMiss("coalesce string atom default non-null")
  }
  return atomToStr(nb, v, dIx, rep)
}

// `l ?? d` over a boxed operand along `coalBoxArmOf`'s arm: the operand's box, then legacy's
// shared `if` on it, the default built into its null arm so it runs only there. A binding arm
// re-reads its box, so its operand is a plain variable; a stashed one is a call.
function coalBox(b: i32[], n: BinExpr, lhsIx: i32, ix: i32, rep: i32): Opnd {
  const arm = coalBoxArmOf(n, lhsIx, ix, ibFnIx)
  // A name past the boxed arms reaches legacy's nullable-reference rungs directly, and a call does
  // once it is neither of the call niches (`emitCoalesceCallNiche`).
  if arm == "next" && coalNulRefRungReached(n, lhsIx, ibFnIx) {
    return coalNulRef(b, n, lhsIx, ix, rep)
  }
  const built = match arm {
    "valBox" | "valScalar" | "elem" | "callBox" | "callScalar" => true
    "boolPop" | "valNoKind" | "callNoKind" | "next" => false
  }
  const na = if arm == "next" { coalNextArmOf(n, lhsIx, ix, ibFnIx) } else { "nulRefs" }
  if !built && na == "field" { return coalField(b, n, lhsIx, ix, rep, -1) }
  // A call's (or an `if`'s) `boolean | null` is stashed once and tested against its sentinel, as
  // the niche cell's arm writes a stashed operand (`emitCoalesceCallNiche`, `coalNicheOpen`).
  if !built && na == "callBool" && coalLhsStashes(lhsIx) {
    return coalNicheCell(b, n, lhsIx, ix, rep, "nulBool")
  }
  // Past the optional chains legacy reaches the nullable-reference rungs (`coalOptPassesToNulRefs`).
  // A `p?.f` whose hole receiver an instance holds as a non-null record is that row's field.
  if !built && na == "opt" {
    const osi = optRecvInstanceRow(lhsIx)
    if osi >= 0 { return coalField(b, n, lhsIx, ix, rep, osi) }
  }
  if !built && na == "opt" && coalOptPassesToNulRefs(lhsIx, ibFnIx) {
    return coalNulRef(b, n, lhsIx, ix, rep)
  }
  if !built && na == "opt" { return coalOptLeafBuild(b, n, lhsIx, ix, rep) }
  if !built { return irBMiss("coalesce box " + arm) }
  // A stashed operand is the value legacy's stash takes (`coalStashResidualKind`): a call, an `as`
  // or an `if`.
  const sn = nodeAt(lhsIx)
  if (
    (arm == "callBox" || arm == "callScalar")
    && !(sn is Call || sn is AsExpr || sn is IfStmt)
  ) {
    return irBMiss("coalesce box stash operand")
  }
  const boxOut = arm == "valBox" || arm == "callBox"
  if boxOut != heldAsBox(rep) { return irBMiss("coalesce box result rep") }
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  // Its value stays on the stack from here, so no temp an operand before it built may wait,
  // unless the lowering writes that temp below the tag test (`coalArmStagesLeads`).
  if endsInTemp(b) && !coalArmStagesLeads(arm) {
    return irBMiss("coalesce box after an operand")
  }
  const l = irBExpr(b, n.binLeft)
  if ibMiss != "" { return l }
  if !heldAsBox(irBOpRep(l)) { return irBMiss("coalesce box operand rep") }
  // A binding's box is read again as the builder read it (`irHoistRecv`).
  if arm == "valBox" || arm == "valScalar" {
    if !(l is OVar) || l.ov < 0 { return irBMiss("coalesce box place") }
    if ib.irVars[l.ov].vKind == "temp" && !recvReadsAgain(lhsIx) {
      return irBMiss("coalesce box place")
    }
  }
  const t = irVarNew(ib, rep, ty, "local", -1)
  const nb: i32[] = []
  if !coalNeverDefault(nb, n.binRight, rep, t) {
    const d = deliver(nb, n.binRight, rep, -1)
    if ibMiss != "" { return d }
    if irBOpRep(d) != rep { return irBMiss("coalesce box default rep") }
    irBNode(nb, { asDst: t, asSrc: d }, -1, ibNoValue, ix)
  }
  if ibMiss != "" { return irBMiss(ibMiss) }
  irBNode(
    b,
    {
      cbL: l,
      cbLB: [],
      cbArm: arm,
      cbNull: nb,
      cbOut: t,
      cbAt: ix,
      cbMap: null,
      cbIdx: null,
    },
    ty,
    rep,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// `l ?? d` along legacy's `boxStash` rung (`emitCoalesceBoxStash`): the operand's box, then its tag
// test's box-typed `if`, the default built into its absent arm.
function coalBoxStash(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  if !heldAsBox(rep) { return irBMiss("coalesce box stash result rep") }
  const l = irBExpr(b, n.binLeft)
  if ibMiss != "" { return l }
  return coalBoxTagged(b, n, ix, rep, l, "boxStash")
}

// `l ?? d` whose operand the checker narrowed to `null` though it may have been written since (a
// loop, a closure, a call), along legacy's `boxRuntime` rung: the box read at its storage, then its
// tag test, the box stash's at a box result and else the payload's unboxed.
function coalBoxRuntime(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const mark = storageReadEnter(unwrapParen(n.binLeft))
  const l = irBExpr(b, n.binLeft)
  storageReadLeave(mark)
  if ibMiss != "" { return l }
  const arm: CoalValArm = if heldAsBox(rep) { "boxStash" } else { "boxRuntime" }
  return coalBoxTagged(b, n, ix, rep, l, arm)
}

// The tag-tested `??` over box `l` along `arm`: the default built into its absent arm.
function coalBoxTagged(
  b: i32[],
  n: BinExpr,
  ix: i32,
  rep: i32,
  l: Opnd,
  arm: CoalValArm,
): Opnd {
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  if !heldAsBox(irBOpRep(l)) {
    return irBMiss("coalesce box stash operand rep")
  }
  const t = irVarNew(ib, rep, ty, "local", -1)
  const nb: i32[] = []
  if !coalNeverDefault(nb, n.binRight, rep, t) {
    const d = deliver(nb, n.binRight, rep, -1)
    if ibMiss != "" { return d }
    if irBOpRep(d) != rep { return irBMiss("coalesce box stash default rep") }
    irBNode(nb, { asDst: t, asSrc: d }, -1, ibNoValue, ix)
  }
  if ibMiss != "" { return irBMiss(ibMiss) }
  irBNode(
    b,
    {
      cbL: l,
      cbLB: [],
      cbArm: arm,
      cbNull: nb,
      cbOut: t,
      cbAt: ix,
      cbMap: null,
      cbIdx: null,
    },
    ty,
    rep,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// `l ?? d` over a `K | null` niche joined into a box, as `emitCoalesceNulAtomJoin` writes it: the
// operand stashed once, the default delivered boxed on its null, else its member string boxed.
function coalNulAtomJoin(
  b: i32[],
  n: BinExpr,
  lhsIx: i32,
  ix: i32,
  rep: i32,
): Opnd {
  if coalNulAtomJoinWhy(n, ibFnIx) != "" {
    return irBMiss("coalesce atom join refused")
  }
  if nulLitAtomTexts(lhsIx, ibFnIx).length == 0 {
    return irBMiss("coalesce atom join member")
  }
  if !(repNodeAt(rep) is RBox) {
    return irBMiss("coalesce atom join result rep")
  }
  if !boxOwedAt(n.binRight, ibFnIx) {
    return irBMiss("coalesce atom join default")
  }
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  const l = irBExpr(b, n.binLeft)
  if ibMiss != "" { return l }
  const ln = repNodeAt(irBOpRep(l))
  if !(ln is RNullable) || ln.rnDisc != 3 {
    return irBMiss("coalesce atom join operand rep")
  }
  const t = irVarNew(ib, rep, ty, "local", -1)
  const nb: i32[] = []
  const d = deliver(nb, n.binRight, rep, -1)
  if ibMiss != "" { return d }
  if irBOpRep(d) != rep { return irBMiss("coalesce atom join default rep") }
  irBNode(nb, { asDst: t, asSrc: d }, -1, ibNoValue, ix)
  irBNode(
    b,
    {
      cbL: l,
      cbLB: [],
      cbArm: "nulAtomJoin",
      cbNull: nb,
      cbOut: t,
      cbAt: ix,
      cbMap: null,
      cbIdx: null,
    },
    ty,
    rep,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// The struct row of `p?.f`'s receiver where the template typed it a hole and this instance holds
// it as a non-null record (D17566); -1 otherwise.
function optRecvInstanceRow(lhsIx: i32): i32 {
  if lhsIx < 0 || lhsIx >= P.nodes.length || !optRecvHoleTyped(lhsIx) {
    return -1
  }
  const m = nodeAt(lhsIx)
  if !(m is OptMember) { return -1 }
  const r = exprRepOf(unwrapParen(m.omObj))
  if !(repNodeAt(r) is RRecord) { return -1 }
  return structIndexOfTy(repTyOf(r))
}

// `o.v ?? d` over a value-union record field past the boxed arms, along `coalFieldPlanOf` as
// `emitCoalesceUnionField` writes it: the record, a variable it re-reads, then the shared null
// test's `if`, the default built into its null arm. A receiver it unwraps (`cfCast`) is unwrapped
// after each read.
function coalField(
  b: i32[],
  n: BinExpr,
  lhsIx: i32,
  ix: i32,
  rep: i32,
  optSi: i32,
): Opnd {
  const p = if optSi >= 0 { coalFieldPlanOfOpt(n, lhsIx, optSi, ix, ibFnIx) } else { coalFieldPlanOf(n, lhsIx, ix, ibFnIx) }
  if p.cfArm != "boxed" && p.cfArm != "unbox" {
    return irBMiss("coalesce field " + p.cfArm)
  }
  const boxed = p.cfArm == "boxed"
  const repOk = if boxed { repNodeAt(rep) is RBox } else { repPrim(rep) != null }
  if !repOk { return irBMiss("coalesce field result rep") }
  const m = nodeAt(lhsIx)
  // A `p?.f` an instance holds over a non-null record (`optSi`) reads its receiver as `p.f`'s.
  const recvIx = if m is Member { m.memObj } else if m is OptMember && optSi >= 0 { m.omObj } else { -1 }
  if recvIx < 0 { return irBMiss("coalesce field node") }
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  // A box legacy unwraps itself is read at its storage, not narrowed. An operand built before it
  // is written below the field's test (`coalArmStagesLeads`).
  const r = if p.cfCast >= 0 { storageReadOf(b, recvIx) } else { irBExpr(b, recvIx) }
  if ibMiss != "" { return r }
  // A receiver legacy re-emits is read again as the builder read it (`irHoistRecv`).
  if !(r is OVar) || r.ov < 0 { return irBMiss("coalesce field place") }
  // One legacy keeps in its stash (`coalFieldRecvStash`, a call) is read back from there.
  if (
    ib.irVars[r.ov].vKind == "temp"
    && !recvReadsAgain(unwrapParen(recvIx))
    && unionEqOperandOk(recvIx)
  ) {
    return irBMiss("coalesce field place")
  }
  // The receiver is the record, or a box or a nullable record legacy unwraps (`cfCast`).
  const rr = repNodeAt(irBOpRep(r))
  const recvOk = if p.cfCast >= 0 { heldAsBox(irBOpRep(r)) } else if p.cfCast == -2 { rr is RNullable && repNodeAt(rr.rnInner) is RRecord } else { rr is RRecord }
  if !recvOk { return irBMiss("coalesce field receiver rep") }
  const t = irVarNew(ib, rep, ty, "local", -1)
  const nb: i32[] = []
  if !coalNeverDefault(nb, n.binRight, rep, t) {
    const d = deliver(nb, n.binRight, rep, -1)
    if ibMiss != "" { return d }
    if irBOpRep(d) != rep { return irBMiss("coalesce field default rep") }
    irBNode(nb, { asDst: t, asSrc: d }, -1, ibNoValue, ix)
  }
  if ibMiss != "" { return irBMiss(ibMiss) }
  const arm: CoalValArm = if boxed { "fieldBox" } else { "fieldVal" }
  irBNode(
    b,
    {
      cbL: r,
      cbLB: [],
      cbArm: arm,
      cbNull: nb,
      cbOut: t,
      cbAt: ix,
      cbMap: null,
      cbIdx: null,
    },
    ty,
    rep,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// A local's, parameter's or loop variable's read at node `ix` at its own variable's rep, past any
// narrowing, or a union global's box, read again as built (`irLReadAgain`); any other node is built
// as itself.
function storageReadOf(b: i32[], ix: i32): Opnd {
  const u = unwrapParen(ix)
  const n = if u >= 0 && u < P.nodes.length { nodeAt(u) } else { null }
  // An element read is read at its storage as legacy marks it (`storageReadEnter`), the box.
  if n is Index {
    const mark = storageReadEnter(u)
    const ev = irBExpr(b, ix)
    storageReadLeave(mark)
    return ev
  }
  if !(n is Ident) { return irBExpr(b, ix) }
  const d = identDeclOf(u)
  const w = localIndexOf(ibFnIx, u)
  const g = if d >= 0 && w < 0 { globalBoxSymOf(d, u) } else { -1 }
  if g >= 0 {
    const gm = irGlobalReadMiss(g, ibGlobalCtx())
    if gm != "" { return irBMiss(gm) }
    const gr: Rhs = { ggSym: g, ggNonNull: irBGlobalBoxRecovers(u), ggNn: -1 }
    ib.irReadAgain[u] = gr
    return irBLetTempTy(b, gr, u, globalRep(g, d), heldTy(scopeTyAt(d, -1)))
  }
  if d < 0 || w < 0 { return irBExpr(b, ix) }
  const dn = nodeAt(d)
  const v = if dn is Param { paramVarAt(w) } else if dn is LetDecl { readDeclVar(d) } else if dn is LoopVar { ibDeclVar[d] ?? -1 } else { -1 }
  if v < 0 || captureSlotOf(n.identName, ibFnIx) >= 0 { return irBExpr(b, ix) }
  return identRead(b, n, u, ib.irVars[v].vRep, false)
}

// Whether the read built at node `ix` can be written again as built (`irHoistRecv`): a variable's
// read, a global's, or a plain field read of one of those.
export function recvReadsAgain(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  if ib.irReadVar.has(ix) || ib.irReadAgain.has(ix) || ib.irReadElem.has(ix) {
    return true
  }
  const m = nodeAt(ix)
  if ib.irReadOpt.has(ix) { return true }
  return ib.irReadField.has(ix)
    && m is Member
    && recvReadsAgain(unwrapParen(m.memObj))
}

// `p?.f ?? d` past the boxed and field rungs, along `coalOptArmOf` and `coalOptLeafPlanOf` as
// `emitCoalesceOptNulRecord` writes a nullable record's scalar or string field: the receiver, a
// variable it re-reads, then the shared null test's `if`, the default built into its null arm.
function coalOptLeafBuild(
  b: i32[],
  n: BinExpr,
  lhsIx: i32,
  ix: i32,
  rep: i32,
): Opnd {
  const oa = coalOptArmOf(lhsIx, ibFnIx)
  if oa == "mapField" { return coalOptMapField(b, n, lhsIx, ix, rep) }
  if oa != "nulRecord" { return irBMiss("coalesce optional " + oa) }
  const m = nodeAt(lhsIx)
  if !(m is OptMember) { return irBMiss("coalesce optional node") }
  const nsi = structIndexOfExpr(m.omObj, ibFnIx)
  const lp = coalOptLeafPlanOf(m, nsi)
  // A union box field is `emitOptCoalesceBoxLeaf`'s, over a base that is no link itself.
  const bp = if lp.olLeaf == null { coalOptBoxLeafPlanAt(n, m, nsi, ix, ibFnIx) } else { null }
  const boxLeaf = bp != null && bp.obFail == ""
  // A record field is the two-test core of `emitCoalesceOptNulRecord`.
  const rp = if lp.olLeaf == null && !boxLeaf { coalOptRecLeafPlanAt(n, m, nsi, ibFnIx) } else { null }
  const recLeaf = rp != null && rp.orTgtHeap >= 0
  if lp.olLeaf == null && !boxLeaf && !recLeaf {
    return irBMiss("coalesce optional record field")
  }
  // A box field at the end of a chain reads the chain's root, whose links the lowering walks
  // (`emitOptChainIsNull`, `emitOptChainValue`).
  const chain = boxLeaf && nodeAt(unwrapParen(m.omObj)) is OptMember
  const rootIx = if chain { optChainRootOf(m.omObj) } else { m.omObj }
  if rootIx < 0 { return irBMiss("coalesce optional box field chain") }
  if chain && readOwesNonNullRecover(rootIx, ibFnIx) {
    return irBMiss("coalesce optional box field chain recover")
  }
  const boxOut = bp != null && bp.obBox != ""
  if recLeaf {
    if !recordRepOrNull(rep) { return irBMiss("coalesce optional result rep") }
  } else if (
    boxOut && !(repNodeAt(rep) is RBox)
    || !boxOut && repPrim(rep) == null
  ) {
    return irBMiss("coalesce optional result rep")
  }
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  // Its value stays on the stack from here, so no temp an operand before it built may wait.
  if endsInTemp(b) { return irBMiss("coalesce optional after an operand") }
  const r = irBExpr(b, rootIx)
  if ibMiss != "" { return r }
  // A receiver legacy re-emits is read again as the builder read it (`irHoistRecv`).
  if !(r is OVar) || r.ov < 0 { return irBMiss("coalesce optional place") }
  // A receiver legacy stages is teed into its `?.` stash and read back from it by the scalar
  // leaf (`coalOptLeaf`) and the box leaf's chain walk (`coalOptBoxChain`); it is the chain's base
  // itself, since a nested chain's staging is its own.
  const staged = optChainStagesRecv(lhsIx)
  if (
    staged
    && !boxLeaf
    && (recLeaf || nodeAt(unwrapParen(m.omObj)) is OptMember)
  ) {
    return irBMiss("coalesce optional staged receiver")
  }
  if (
    !staged
    && ib.irVars[r.ov].vKind == "temp"
    && !recvReadsAgain(unwrapParen(rootIx))
  ) {
    return irBMiss("coalesce optional place")
  }
  const t = irVarNew(ib, rep, ty, "local", -1)
  const nb: i32[] = []
  if !coalNeverDefault(nb, n.binRight, rep, t) {
    // A union result's default is boxed into the `??`'s own union (`emitUnionBoxOwed`).
    const d = deliver(
      nb,
      n.binRight,
      rep,
      if boxOut && bp != null { bp.obTy } else { -1 },
    )
    if ibMiss != "" { return d }
    if irBOpRep(d) != rep { return irBMiss("coalesce optional default rep") }
    irBNode(nb, { asDst: t, asSrc: d }, -1, ibNoValue, ix)
  }
  if ibMiss != "" { return irBMiss(ibMiss) }
  const arm: CoalValArm = if boxLeaf { "optBoxLeaf" } else if recLeaf { "optRecLeaf" } else { "optLeaf" }
  irBNode(
    b,
    {
      cbL: r,
      cbLB: [],
      cbArm: arm,
      cbNull: nb,
      cbOut: t,
      cbAt: ix,
      cbMap: null,
      cbIdx: null,
    },
    ty,
    rep,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// `m[k]?.f ?? d` along `optMapFieldPlanOf`, as `emitCoalesceOptMapField` writes it: the map
// receiver and key the probe reads, then the hit's field, the default built into its miss arm.
function coalOptMapField(
  b: i32[],
  n: BinExpr,
  lhsIx: i32,
  ix: i32,
  rep: i32,
): Opnd {
  const m = nodeAt(lhsIx)
  if !(m is OptMember) { return irBMiss("coalesce optional node") }
  const rd = nodeAt(m.omObj)
  if !(rd is Index) { return irBMiss("coalesce optional mapField node") }
  if (
    optMapFieldPlanOf(m.omProp, mapShapeOfExpr(rd.idxArr, ibFnIx)).ofLeaf
    == null
  ) {
    return irBMiss("coalesce optional mapField plan")
  }
  if repPrim(rep) == null { return irBMiss("coalesce optional result rep") }
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  // Its value stays on the stack from here, so no temp an operand before it built may wait.
  if endsInTemp(b) { return irBMiss("coalesce optional after an operand") }
  const ka = mapKeyArmOf(
    rd.idxArr,
    rd.idxIndex,
    ibFnIx,
    mapRecvShapeOf(rd.idxArr, ibFnIx),
  )
  if ka != "plain" && ka != "i64" { return irBMiss("map key " + ka) }
  const rcv = mapRecvKeyOf(
    b,
    rd.idxArr,
    rd.idxIndex,
    "coalesce optional map receiver",
    ka == "i64",
  )
  if rcv == null { return irBMiss(ibMiss) }
  const t = irVarNew(ib, rep, ty, "local", -1)
  const nb: i32[] = []
  const d = deliver(nb, n.binRight, rep, -1)
  if ibMiss != "" { return d }
  if irBOpRep(d) != rep { return irBMiss("coalesce optional default rep") }
  irBNode(nb, { asDst: t, asSrc: d }, -1, ibNoValue, ix)
  irBNode(
    b,
    {
      cbL: rcv.mkLoc,
      cbLB: [],
      cbArm: "optMapField",
      cbNull: nb,
      cbOut: t,
      cbAt: ix,
      cbMap: { prSym: rcv.mkSym, prNonNull: rcv.mkNonNull, prKey: rcv.mkKey, prForm: 0 },
      cbIdx: null,
    },
    ty,
    rep,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// `f ?? d` over a shared `scalar | null` field read along `coalBoxFieldScalarPlanOf`: the box,
// then legacy's tag test, the default delivered at the `??`'s own scalar in its `else`.
function coalBoxFieldScalar(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const p = coalBoxFieldScalarPlanOf(n, ix, ibFnIx)
  if p.bfKind < 0 { return irBMiss("coalesce nulRef boxFieldScalar plan") }
  if !irBAtomKindRep(p.bfRes, rep) {
    return irBMiss("coalesce nulRef boxFieldScalar rep")
  }
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  const l = irBExpr(b, n.binLeft)
  if ibMiss != "" { return l }
  if !boxedNullable(irBOpRep(l)) {
    return irBMiss("coalesce nulRef boxFieldScalar operand rep")
  }
  const t = irVarNew(ib, rep, ty, "local", -1)
  const nb: i32[] = []
  if !coalNeverDefault(nb, n.binRight, rep, t) {
    const d = deliver(nb, n.binRight, rep, -1)
    if ibMiss != "" { return d }
    if irBOpRep(d) != rep { return irBMiss("coalesce nulRef default rep") }
    irBNode(nb, { asDst: t, asSrc: d }, -1, ibNoValue, ix)
  }
  if ibMiss != "" { return irBMiss(ibMiss) }
  const arm: CoalValArm = "boxFieldScalar"
  irBNode(
    b,
    {
      cbL: l,
      cbLB: [],
      cbArm: arm,
      cbNull: nb,
      cbOut: t,
      cbAt: ix,
      cbMap: null,
      cbIdx: null,
    },
    ty,
    rep,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// `l ?? d` over a nullable reference (legacy's `emitCoalesceNulRef`) along `coalNulRefPlanOf`: the
// plain block, or a join's staged `if`, with the default built where it runs only on `null`. A plain
// default is written as itself; a join's only on the recorded-box branch `deliver` shares.
function coalNulRef(b: i32[], n: BinExpr, lhsIx: i32, ix: i32, rep: i32): Opnd {
  // Past the core, legacy's rungs by `coalNulRefsArmOf`: a null test `coalNullTestIf` spells is
  // built as the valued `if` it is; the rest are misses by their arm.
  const ra = coalNulRefsArmOf(n, ix, ibFnIx)
  if (
    ra == "pinnedCellIf"
    || ra == "atomJoinIf"
    || ra == "cellIf"
    || ra == "numJoinIf"
  ) {
    const v = irBExpr(b, coalNullTestIf(n, ix, ibFnIx))
    if ibMiss != "" { return v }
    if irBOpRep(v) != rep { return irBMiss("coalesce nulRef " + ra + " rep") }
    return v
  }
  if ra == "boxStash" { return coalBoxStash(b, n, ix, rep) }
  if ra == "atomJoinStash" { return coalNulAtomJoin(b, n, lhsIx, ix, rep) }
  if ra == "boxFieldScalar" { return coalBoxFieldScalar(b, n, ix, rep) }
  if ra != "heap" && ra != "mapHeap" { return irBMiss("coalesce nulRef " + ra) }
  const p = coalNulRefPlanOf(n, lhsIx, ix, ibFnIx)
  if p == null { return irBMiss("coalesce nulRef heap") }
  const join = p.nrArm == "join"
  if !join && p.nrArm != "plain" {
    return irBMiss("coalesce nulRef " + p.nrArm)
  }
  if join && coalNulRefJoinWhy(n, p.nrHeap, ibFnIx) != "" {
    return irBMiss("coalesce nulRef join refused")
  }
  if join && !boxOwedAt(n.binRight, ibFnIx) {
    return irBMiss("coalesce nulRef join default")
  }
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  // A plain block opens before its operand, so the operand is built into the block (`cbLB`).
  const lb: i32[] = []
  const l = irBExpr(if join { b } else { lb }, n.binLeft)
  if ibMiss != "" { return l }
  if !(l is OVar) || l.ov < 0 { return irBMiss("coalesce nulRef operand") }
  const ln = repNodeAt(irBOpRep(l))
  if !(ln is RNullable) || ln.rnDisc == 4 {
    return irBMiss("coalesce nulRef operand rep")
  }
  const nul = coalesceDefaultNullable(n.binRight, ibFnIx)
  const want = if join { rep } else if nul { irBOpRep(l) } else { ln.rnInner }
  // A map joined into its default's wider map type, stored alike, is that type as it stands.
  const alike = !join
    && !nul
    && repNodeAt(rep) is RMap
    && repNodeAt(ln.rnInner) is RMap
    && coalNulMapJoinStoresAlike(n, ix, ibFnIx)
  if rep != want && !alike || join && !heldAsBox(rep) {
    return irBMiss("coalesce nulRef result rep")
  }
  const t = irVarNew(ib, rep, ty, "local", -1)
  const nb: i32[] = []
  if !coalNeverDefault(nb, n.binRight, rep, t) {
    const d0 = if join { deliver(nb, n.binRight, rep, -1) } else { irBExpr(nb, n.binRight) }
    if ibMiss != "" { return d0 }
    // A default whose rep leaves a closure's part open, or fills one, is the result's struct,
    // retagged, as a record field's is.
    const holed = irBOpRep(d0) != rep
      && holeRetagNoted(irBOpRep(d0), rep, true)
      && exprPrePathWhy(n.binRight, ibFnIx) == ""
    const d = if holed { repTemp(nb, { rgV: d0 }, n.binRight, rep) } else { d0 }
    if irBOpRep(d) != rep { return irBMiss("coalesce nulRef default rep") }
    irBNode(nb, { asDst: t, asSrc: d }, -1, ibNoValue, ix)
  }
  if ibMiss != "" { return irBMiss(ibMiss) }
  irBNode(
    b,
    {
      cbL: l,
      cbLB: lb,
      cbArm: "nulRef",
      cbNull: nb,
      cbOut: t,
      cbAt: ix,
      cbMap: null,
      cbIdx: null,
    },
    ty,
    rep,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// `l ?? d` over an i32 niche cell (legacy's `emitCoalesceNicheCell`): an atom's or a
// `boolean | null`'s. The present arm re-reads the operand unless legacy stashes it
// (`coalLhsStashes`), and a re-read is built only over a variable.
function coalNicheCell(
  b: i32[],
  n: BinExpr,
  lhsIx: i32,
  ix: i32,
  rep: i32,
  arm: CoalValArm,
): Opnd {
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  const l = irBExpr(b, n.binLeft)
  if ibMiss != "" { return l }
  if !(l is OVar) || l.ov < 0 { return irBMiss("coalesce niche operand") }
  // A re-read is the operand's read written again as built (`irHoistRecv`).
  if (
    !coalLhsStashes(lhsIx)
    && ib.irVars[l.ov].vKind == "temp"
    && !recvReadsAgain(unwrapParen(n.binLeft))
  ) {
    return irBMiss("coalesce niche place")
  }
  const lr = irBOpRep(l)
  const ln = repNodeAt(lr)
  if !(ln is RNullable) { return irBMiss("coalesce niche operand rep") }
  const atom = arm == "litUnion"
  if atom && ln.rnDisc != 3 || !atom && !repBoolNiche(lr) {
    return irBMiss("coalesce niche operand rep")
  }
  if rep != lr && rep != ln.rnInner {
    return irBMiss("coalesce niche result rep")
  }
  const t = irVarNew(ib, rep, ty, "local", -1)
  const nb: i32[] = []
  if !coalNeverDefault(nb, n.binRight, rep, t) {
    // A default the atom hook writes (a `const` bound to a member literal) is delivered at the
    // niche's atom, as `const d: K = Z` delivers it.
    const hook = atom
      && exprPrePathWhy(n.binRight, ibFnIx) == "pre-path atom hook"
    const d = if hook { deliver(nb, n.binRight, rep, ty) } else { irBExpr(nb, n.binRight) }
    if ibMiss != "" { return d }
    if irBOpRep(d) != rep { return irBMiss("coalesce niche default rep") }
    irBNode(nb, { asDst: t, asSrc: d }, -1, ibNoValue, ix)
  }
  if ibMiss != "" { return irBMiss(ibMiss) }
  irBNode(
    b,
    {
      cbL: l,
      cbLB: [],
      cbArm: arm,
      cbNull: nb,
      cbOut: t,
      cbAt: ix,
      cbMap: null,
      cbIdx: null,
    },
    ty,
    rep,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// Whether body `b` ends in a node that ends its path (`irNodeEndsPath`).
function endsPath(b: i32[]): boolean {
  return b.length > 0 && irNodeEndsPath(ib.irNodes[b[b.length - 1]])
}

// Whether default `dIx` of a `??` is a call that never returns, built onto the null arm `nb` as its
// statement: legacy writes the call and its `unreachable` there and stores nothing into the out. At a
// wider number `rep` legacy widens the call's dead `i32` value into out `t`, and so does the IR.
function coalNeverDefault(nb: i32[], dIx: i32, rep: i32, t: i32): boolean {
  const d = unwrapParen(dIx)
  if d < 0 || !callIsNever(d) { return false }
  if numKindOf(rep) >= 3 {
    const v = irBExpr(nb, dIx)
    if ibMiss != "" { return true }
    const sk = numKindOf(irBOpRep(v))
    if t < 0 || sk <= 0 || sk >= numKindOf(rep) {
      irBMiss("coalesce never default widened")
      return true
    }
    const w = irBLetTempTy(
      nb,
      { nwV: v, nwSrc: sk, nwDst: numKindOf(rep), nwAt: dIx },
      dIx,
      rep,
      repTyOf(rep),
    )
    irBNode(nb, { asDst: t, asSrc: w }, -1, ibNoValue, dIx)
    return true
  }
  stmtNode(nb, d, NO_SIBS, -1)
  if (
    ibMiss == ""
    && (nb.length == 0 || !irNodeEndsPath(ib.irNodes[nb[nb.length - 1]]))
  ) {
    irBMiss("coalesce never default")
  }
  return true
}

// `l ?? d` over the `boolean | null` niche joining a union box (`emitCoalesceNulBoolJoin`): the
// operand once into its slot, its null the default delivered into the box, a present 0/1 boxed
// under the boolean arm.
function coalNulBoolJoin(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const why = coalNulBoolJoinWhy(n, ibFnIx)
  if why != "" { return irBMiss("coalesce nulBoolJoin plan") }
  if !heldAsBox(rep) { return irBMiss("coalesce nulBoolJoin result rep") }
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  // Its value stays on the stack from here, so no temp an operand before it built may wait.
  if endsInTemp(b) { return irBMiss("coalesce nulBoolJoin after an operand") }
  const l = irBExpr(b, n.binLeft)
  if ibMiss != "" { return l }
  if !repBoolNiche(irBOpRep(l)) {
    return irBMiss("coalesce nulBoolJoin operand rep")
  }
  const t = irVarNew(ib, rep, ty, "local", -1)
  const nb: i32[] = []
  const d = deliver(nb, n.binRight, rep, -1)
  if ibMiss != "" { return d }
  if irBOpRep(d) != rep { return irBMiss("coalesce nulBoolJoin default rep") }
  irBNode(nb, { asDst: t, asSrc: d }, -1, ibNoValue, ix)
  const arm: CoalValArm = "nulBoolJoin"
  irBNode(
    b,
    {
      cbL: l,
      cbLB: [],
      cbArm: arm,
      cbNull: nb,
      cbOut: t,
      cbAt: ix,
      cbMap: null,
      cbIdx: null,
    },
    ty,
    rep,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// `l ?? d` over a `K | null` at a `string` (legacy's `emitCoalesceNulAtomStr`), its default a
// string that builds nothing, which the null branch writes as itself.
function coalAtomStr(
  b: i32[],
  n: BinExpr,
  lhsIx: i32,
  ix: i32,
  rep: i32,
): Opnd {
  const dIx = unwrapParen(n.binRight)
  if dIx < 0 || exprIsLitAtom(n.binRight, ibFnIx) {
    return irBMiss("coalesce atom default")
  }
  if nulLitAtomTexts(lhsIx, ibFnIx).length == 0 {
    return irBMiss("coalesce atom members")
  }
  if repPrim(rep) != "str" { return irBMiss("coalesce result rep") }
  const l = irBExpr(b, n.binLeft)
  if ibMiss != "" { return l }
  if !atomNullable(irBOpRep(l)) { return irBMiss("coalesce operand rep") }
  // A default that builds nothing (a literal, a name) is written in place in the `null` branch.
  const nb: i32[] = []
  const d = irBExpr(nb, n.binRight)
  if ibMiss != "" { return d }
  if nb.length != 0 || irBOpRep(d) != rep {
    return irBMiss("coalesce atom default")
  }
  const r: Rhs = { zaL: l, zaD: d, zaAt: ix }
  return irBLetTemp(b, r, ix, rep)
}

// The string rep a `string | null` rep `r` holds.
function strInnerOf(r: i32): i32 {
  const n = repNodeAt(r)
  if n is RNullable { return n.rnInner }
  return -1
}

// The value rep of map rep `mrep`, or -1 for no map.
function mapValRepOf(mrep: i32): i32 {
  const mr = repNodeAt(mrep)
  return if mr is RMap { mr.rmVal } else { -1 }
}

// Why a union map read's box-arm default is not boxed into the slot's union at value rep `vr`, or
// "": never from another union's box, the map store's own guard.
function mapGetOrBoxDefaultMiss(def: i32, vr: i32, sh: i32): string {
  if exprUnion(def, ibFnIx) && boxIntoOtherUnion(def, vr, mvValTyIxAt(sh)) {
    return "map read union default from a box"
  }
  return ""
}

// The rep of map read receiver `rcv`: its global's cell or its operand.
function rcvMapRep(rcv: MapRecvKey): i32 {
  return if rcv.mkSym >= 0 { irGlobalRepOf(ib, rcv.mkSym) } else { irBOpRep(rcv.mkLoc) }
}

// Why a null-free union map value read under `??` at `rep` is not the plain mv arm's read, or "":
// the read is the slot's box and the default boxes into it as `emitMapValDefault` does, never
// from another union's box.
function mapGetOrUnionMiss(
  rcv: MapRecvKey,
  def: i32,
  rep: i32,
  sh: i32,
): string {
  const mr = repNodeAt(rcvMapRep(rcv))
  if !(mr is RMap) || mr.rmVal != rep { return "map read union rep" }
  if exprUnion(def, ibFnIx) && boxIntoOtherUnion(def, rep, mvValTyIxAt(sh)) {
    return "map read union default from a box"
  }
  return ""
}

// The rep map read `??` `ix` yields at, `rep` its type's: where that type's struct row records
// another record, whose rep is the map's value rep `vr`, the value legacy holds there (the
// storage-key row D14890 keeps the type's own rep beside); else `rep`.
function mapReadStoredRep(ix: i32, rep: i32, vr: i32): i32 {
  if (
    vr < 0
    || vr == rep
    || !(repNodeAt(rep) is RRecord)
    || !(repNodeAt(vr) is RRecord)
  ) {
    return rep
  }
  const t = nodeTyAt(ix, ibFnIx)
  const si = if t >= 0 { structIndexOfTy(t) } else { -1 }
  if si < 0 || si >= sTyIx.length || sTyIx[si] == t { return rep }
  return if repNodeOfTy(sTyIx[si]) == vr { vr } else { rep }
}

// The type `mapReadStoredRep`'s row records for read `ix`, or -1.
function mapReadStoredTy(ix: i32): i32 {
  const t = nodeTyAt(ix, ibFnIx)
  const si = if t >= 0 { structIndexOfTy(t) } else { -1 }
  return if si >= 0 && si < sTyIx.length { sTyIx[si] } else { -1 }
}

// `g[k] ?? d` along legacy's helper route, its plain `i32` read or its plain mv slot read
// (`mapGetOrArmOf`, `mapGetOrMvPlain`): a map global read plainly and a key written as itself
// (`mapKeyArmOf`); the helper's miss holds an i32 default, and a plain read's miss arm a default
// that computes nothing ahead of the read.
function mapGetOr(b: i32[], n: BinExpr, ix: i32, repIn: i32): Opnd {
  let rep = repIn
  const lhsIx = unwrapParen(n.binLeft)
  if lhsIx < 0 { return irBMiss("map read") }
  const rd = nodeAt(lhsIx)
  if !(rd is Index) { return irBMiss("map read") }
  const rk = coalResultKindOf(ix, ibFnIx)
  const arm = mapGetOrArmOf(rd.idxArr, n.binRight, ibFnIx, rk)
  const mv = arm == "mv" && mapGetOrMvPlain(rd.idxArr, n.binRight, ibFnIx)
  // A `scalar | null` union value peels to its scalar, the default in the result's kind.
  const uq = if arm == "mv" && !mv { mapGetOrUnionScalarPlanOf(mapRecvShapeOf(rd.idxArr, ibFnIx), n.binRight, rk) } else { null }
  const mvu = uq != null && uq.muKind >= 0
  const nz = arm == "mv"
    && !mv
    && !mvu
    && mapGetOrNicheStash(rd.idxArr, n.binRight, ibFnIx)
  const bx = arm == "mv"
    && !mv
    && !mvu
    && !nz
    && mapGetOrUnionBoxOf(mapRecvShapeOf(rd.idxArr, ibFnIx), n.binRight)
  // An atom-valued map's read is the plain `i32` read; a nullable atom or boolean value's, its
  // sentinel's. Each default is delivered at the read's rep, as `emitMonoMapDefault` writes it.
  const at = arm == "atom"
  const st = arm == "sentinel"
  if (
    arm != "helper"
    && arm != "i32"
    && !at
    && !st
    && !mv
    && !mvu
    && !nz
    && !bx
  ) {
    return irBMiss("map read " + arm)
  }
  const inline = arm != "helper"
  const ka = mapKeyArmOf(
    rd.idxArr,
    rd.idxIndex,
    ibFnIx,
    mapRecvShapeOf(rd.idxArr, ibFnIx),
  )
  if ka != "plain" && ka != "i64" { return irBMiss("map key " + ka) }
  const rp = repPrim(rep)
  const uk = if uq != null { uq.muWide } else { -1 }
  const repOk = if mvu { irBAtomKindRep(uk, rep) } else { rp == "i32"
    || (arm == "i32" || arm == "helper") && rp == "bool"
    || (at || st) && repHeldAsI32(rep)
    || mv
    || nz
    || bx }
  if !repOk { return irBMiss("map read rep") }
  // A default the miss arm writes as a body leaves the read's value on the stack from here.
  const clear = !endsInTemp(b)
  const rcv = mapRecvKeyOf(
    b,
    rd.idxArr,
    rd.idxIndex,
    "map read receiver",
    ka == "i64",
  )
  if rcv == null { return irBMiss(ibMiss) }
  // A record no row records, read off a map holding it at its storage row, is that row's record.
  rep = mapReadStoredRep(ix, rep, mapValRepOf(rcvMapRep(rcv)))
  // The default is written in the miss arm: in place there, or as the body a fused read's arm holds.
  const db: i32[] = []
  const sh = mapRecvShapeOf(rd.idxArr, ibFnIx)
  const ub = mv && mvValKindAt(sh) == "union"
  const um = if ub { mapGetOrUnionMiss(rcv, n.binRight, rep, sh) } else { "" }
  if um != "" { return irBMiss(um) }
  if nz && !mapNicheReadsAt(rcvMapRep(rcv), rep) {
    return irBMiss("map read niche rep")
  }
  if bx && !mapBoxReadsAt(rcvMapRep(rcv), rep) {
    return irBMiss("map read box rep")
  }
  // The box arm's default is boxed into the slot's union, the map's value rep; where that is the
  // boxed `T | null` of a non-null read, into the read's box, the same struct.
  const bv0 = if bx { mapValRepOf(rcvMapRep(rcv)) } else { -1 }
  const bn = if bv0 >= 0 { repNodeAt(bv0) } else { null }
  const bv = if bv0 != rep && bn is RNullable && bn.rnDisc == 4 && bn.rnInner == rep { rep } else { bv0 }
  const bm = if bx { mapGetOrBoxDefaultMiss(n.binRight, bv, sh) } else { "" }
  if bm != "" { return irBMiss(bm) }
  const dv: Opnd = if ub { deliver(db, n.binRight, rep, mvValTyIxAt(sh)) } else if bx { deliver(db, n.binRight, bv, mvValTyIxAt(sh)) } else if at || st { deliver(db, n.binRight, rep, -1) } else if inline { inlineDefault(db, n.binRight, rep) } else { { oiRep: rep, oiBits: 0 } }
  if ibMiss != "" { return dv }
  if irBOpRep(dv) != (if bx { bv } else { rep }) {
    return irBMiss("map read default rep")
  }
  const form = if st { 6 } else if bx { 5 } else if nz { 4 } else if mvu { 3 } else if mv { 2 } else if inline { 1 } else { 0 }
  // The mv slot's read is the map's value as itself: a read held at another rep (a record type no
  // row records, read at its storage row) is one the map's own rep does not yet carry.
  if form == 2 && mapValRepOf(rcvMapRep(rcv)) != rep {
    return irBMiss("map read mv value rep")
  }
  if !defaultSelfContained(db, 0, dv) {
    if !clear { return irBMiss("map read default after an operand") }
    // A fused read's default is its out, so the box arm fuses only at the value's own rep.
    if bx && bv != rep { return irBMiss("map read box default computes") }
    return mapGetOrBox(
      b,
      db,
      dv,
      ix,
      rep,
      {
        prSym: rcv.mkSym,
        prNonNull: rcv.mkNonNull,
        prKey: rcv.mkKey,
        prForm: form,
      },
      rcv.mkLoc,
      if rep != repIn { mapReadStoredTy(ix) } else { -1 },
    )
  }
  for id in db { b.push(id) }
  const r: Rhs = {
    mgSym: rcv.mkSym,
    mgNonNull: rcv.mkNonNull,
    mgLoc: rcv.mkLoc,
    mgKey: rcv.mkKey,
    mgAt: ix,
    mgForm: form,
    mgDef: dv,
  }
  // Held at the storage row it is read from, typed at that row's record (`mapReadStoredRep`).
  if rep != repIn { return irBLetTempTy(b, r, ix, rep, mapReadStoredTy(ix)) }
  return irBLetTemp(b, r, ix, rep)
}

// A bare map read `m[k]` by legacy's arm (`mapGetArmOf`), its key written as itself: an mv slot's
// ref value at its niche, or a mono-valued map read at the value's own rep.
export function mapGetBare(b: i32[], ix: i32, rep: i32): Opnd {
  return mapGetAt(b, ix, rep, -1, ix != ib.irUnbankedRead, -1, false, false)
}

// `mapGetBare`, or under value-atom kind `box` (not -1) the read the box plan boxes into boxed
// nullable `rep` (`mapScalar`), its miss the box's null; under `trap` the read `as!` makes of a
// scalar value, trapping on a miss; under `whole` a union-valued map's box past its narrowing. The
// temp is typed at `tempTy`, or where -1 the read's own.
function mapGetAt(
  b: i32[],
  ix: i32,
  rep: i32,
  box: i32,
  row: boolean,
  tempTy: i32,
  trap: boolean,
  whole: boolean,
): Opnd {
  const rd = nodeAt(ix)
  if !(rd is Index) { return irBMiss("map get") }
  const arm = mapGetArmOf(ix, ibFnIx)
  const sh = mapRecvShapeOf(rd.idxArr, ibFnIx)
  const ka = mapKeyArmOf(rd.idxArr, rd.idxIndex, ibFnIx, sh)
  if ka != "plain" && ka != "i64" { return irBMiss("map key " + ka) }
  const rk = mapRecvKeyOf(
    b,
    rd.idxArr,
    rd.idxIndex,
    "map get receiver",
    ka == "i64",
  )
  if rk == null { return irBMiss(ibMiss) }
  const mr = if rk.mkSym >= 0 { irGlobalRepOf(ib, rk.mkSym) } else { irBOpRep(rk.mkLoc) }
  const m = repNodeAt(mr)
  if !(m is RMap) { return irBMiss("map get receiver rep") }
  // A union-valued map's read is its value's box, the null-tagged box on a miss. One narrowed to a
  // record member no plan reads is the box read whole, then narrowed; legacy writes it through
  // `emitExpr`, which banks the read's row whatever row a caller expecting the box passed.
  let narrowTo = -1
  if arm == "unionBox" {
    // At its narrowing the read is unboxed to the member's scalar after (`narrowedMapReadOf`).
    const nm = narrowedMapReadOf(ix, ibFnIx)
    const na: NarrowedMapReadArm = if whole { "none" } else { nm.nmArm }
    const repOk = match na {
      // The read is the value's box, its miss the box's `null` tag.
      "none" => rep == m.rmVal
        || repNodeAt(repBoxCore(rep)) is RBox && repBoxCore(rep) == repBoxCore(m.rmVal)
      // …to the member's scalar, or a function member's closure (the payload cast to its heap).
      "unbox" => (repPrim(rep) != null || repNodeAt(rep) is RClosure)
        && repNodeOfTy(nodeTyAt(ix, ibFnIx)) == rep
      // …or to its container member, at the read's own type (`emitNarrowedMapReadTail`).
      "container" => repNodeOfTy(nodeTyAt(ix, ibFnIx)) == rep
      "nonNull" => false
    }
    if box < 0 && !repOk && !whole && repNodeAt(rep) is RRecord {
      narrowTo = rep
    }
    if (box >= 0 || !repOk) && narrowTo < 0 {
      return irBMiss("map get union box rep")
    }
  }
  // A scalar read typed at a boxed nullable its map's value rep is not (one arm of a union of
  // maps) is the probe's own box at that value's kind, as the box plan's `mapScalar` writes it.
  const sk = if box < 0
    && arm != "unionBox"
    && boxedNullable(rep)
    && !mapGetRepOk(sh, m.rmVal, rep, rd.idxArr) { mapTyScalarBoxKind(repTyOf(mr)) } else { -1 }
  const bk = if sk >= 0 { sk } else { box }
  // A read the instance types without the null its map's value holds is the helper's value at
  // that niche, as legacy reads it: a miss and a stored null are both its sentinel.
  const plain = arm == "unionBox"
    || bk >= 0
    || mapGetRepOk(sh, m.rmVal, rep, rd.idxArr)
  const nt = if plain { -1 } else { mapReadNicheTy(sh, m.rmVal, rep, rd.idxArr) }
  const twTy = if plain || nt >= 0 { -1 } else { mapGetTwinTy(sh, m.rmVal, rep, rd.idxArr) }
  if !plain && nt < 0 && twTy < 0 { return irBMiss("map get rep") }
  const r: Rhs = {
    mtSym: rk.mkSym,
    mtNonNull: rk.mkNonNull,
    mtLoc: rk.mkLoc,
    mtKey: rk.mkKey,
    mtAt: ix,
    mtBox: bk,
    mtRow: row,
    mtTrap: trap,
    mtPrint: -1,
    mtWhole: whole,
  }
  if narrowTo >= 0 {
    const wr: Rhs = {
      mtSym: rk.mkSym,
      mtNonNull: rk.mkNonNull,
      mtLoc: rk.mkLoc,
      mtKey: rk.mkKey,
      mtAt: ix,
      mtBox: -1,
      mtRow: true,
      mtTrap: false,
      mtPrint: -1,
      mtWhole: true,
    }
    const wv = irBLetTempTy(b, wr, ix, m.rmVal, repTyOf(m.rmVal))
    if ibMiss != "" { return wv }
    return irBLetTemp(
      b,
      { bnV: wv, bnAt: ix, bnRep: narrowTo, bnAtom: -1, bnCon: -1 },
      ix,
      narrowTo,
    )
  }
  if nt >= 0 { return irBLetTempTy(b, r, ix, m.rmVal, nt) }
  // A read at a twin of the value's rep is the value's own read, retagged.
  if twTy >= 0 {
    const v = irBLetTempTy(b, r, ix, repNodeOfTy(twTy), twTy)
    if ibMiss != "" { return v }
    return repTemp(b, { rgV: v }, ix, rep)
  }
  if bk < 0 && tempTy >= 0 { return irBLetTempTy(b, r, ix, rep, tempTy) }
  if bk < 0 { return irBLetTemp(b, r, ix, rep) }
  // The box is the union's own, typed at it where a narrowed re-read's node is the member's.
  const bt = if tempTy >= 0 { tempTy } else if sk >= 0 { nodeTyAt(ix, ibFnIx) } else { holeBoxTyAt(ix, ibFnIx) }
  if bt < 0 || repNodeOfTy(heldTy(bt)) != rep {
    return irBMiss("map get box type")
  }
  return irBLetTempTy(b, r, ix, rep, heldTy(bt))
}

// The `V | null` type, `V` the type of an mv slot `sh`'s stored value rep `val`, where `val` is
// the read rep `rep`'s inner apart only in closure openness (`holeRetagNoted`): the read is held
// there, then retagged; -1 for any other read.
function mapGetTwinTy(sh: i32, val: i32, rep: i32, recvIx: i32): i32 {
  if sh < 0 { return -1 }
  const n = repNodeAt(rep)
  if !(n is RNullable) || n.rnDisc != 1 || n.rnInner == val { return -1 }
  const vt = repTyOf(val)
  if vt < 0 { return -1 }
  const nt = nullableTyOf(vt)
  const nr = repNodeOfTy(nt)
  const nn = repNodeAt(nr)
  if !(nn is RNullable) || nn.rnDisc != 1 || nn.rnInner != val { return -1 }
  if !mapGetRepOk(sh, val, nr, recvIx) { return -1 }
  return if holeRetagNoted(nr, rep, true) { nt } else { -1 }
}

// The value type of map `recvIx` where a read the instance types at rep `rep` is held at the
// map's value rep `val`, the `boolean | null` niche of `rep`; -1 for any other read.
function mapReadNicheTy(sh: i32, val: i32, rep: i32, recvIx: i32): i32 {
  if sh >= 0 { return -1 }
  const vn = repNodeAt(val)
  if (!(vn is RNullable) || vn.rnInner != rep || !boolNullable(val)) {
    return -1
  }
  const vt = tyMapValOf(nodeTyAt(recvIx, ibFnIx))
  if vt < 0 || repNodeOfTy(vt) != val { return -1 }
  return vt
}

// Whether a bare map read of `recvIx` (value rep `val`, shape `sh`) leaves rep `rep`: an mv
// slot's ref value at its null niche, or recovered when the read is narrowed; a mono-valued map's
// value as itself, or a `boolean` value at its nullable.
function mapGetRepOk(sh: i32, val: i32, rep: i32, recvIx: i32): boolean {
  // A `boolean`-valued map's miss reads `2`, the `boolean | null` sentinel, and an atom-valued map's
  // `-1`, the `K | null` one (`mapGetMissOf`).
  if sh < 0 {
    if rep == val { return true }
    // A read typed at the bare atom is narrowed past an atom value's `-1` null: the same bits.
    const vn = repNodeAt(val)
    if atomNullable(val) && vn is RNullable && vn.rnInner == rep { return true }
    const bn = repNodeAt(rep)
    if !(bn is RNullable) || bn.rnInner != val { return false }
    const miss = mapGetMissOf(recvIx, ibFnIx)
    return boolNullable(rep) && miss == 2 || atomNullable(rep) && miss == -1
  }
  const k = mvValKindAt(sh)
  if k == null || k == "v128" || k == "union" { return false }
  // A scalar slot's read at the value itself is narrowed past its null.
  if k == "f64" || k == "i64" || k == "f32" { return rep == val }
  const n = repNodeAt(rep)
  // Narrowed, the read is the value, or the record inside a value that is itself a ref niche.
  const vn = repNodeAt(val)
  if !(n is RNullable) {
    return rep == val || vn is RNullable && vn.rnDisc == 1 && vn.rnInner == rep
  }
  // A slot whose value is already a ref niche reads at that niche: a miss is its null.
  return n.rnDisc == 1 && (n.rnInner == val || rep == val)
}

// A map read whose default computes, as `SCoalBox`'s fused map-read arm: the probe's shared head
// and tail around the default body `db`, which writes the slotless out on the miss path.
function mapGetOrBox(
  b: i32[],
  db: i32[],
  dv: Opnd,
  ix: i32,
  rep: i32,
  mp: MapProbe,
  loc: Opnd,
  outTy: i32,
): Opnd {
  const ty = if outTy >= 0 { outTy } else { outTyOf(ix, rep) }
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  const t = irVarNew(ib, rep, ty, "local", -1)
  irBNode(db, { asDst: t, asSrc: dv }, -1, ibNoValue, ix)
  irBNode(
    b,
    {
      cbL: loc,
      cbLB: [],
      cbArm: "mapIndexGetOr",
      cbNull: db,
      cbOut: t,
      cbAt: ix,
      cbMap: mp,
      cbIdx: null,
    },
    ty,
    rep,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// Whether operand `o`, built into `b` from `at` on, computes nothing ahead of its use: a variable or
// an immediate, or the temp of the one node built, which its use writes in place.
function defaultSelfContained(b: i32[], at: i32, o: Opnd): boolean {
  if b.length == at {
    return !(o is OVar
      && o.ov >= 0
      && o.ov < ib.irVars.length
      && ib.irVars[o.ov].vKind == "temp")
  }
  if b.length != at + 1 || !(o is OVar) { return false }
  const n = ib.irNodes[b[at]]
  return n is SLet && n.lDst == o.ov
}

// A map operation's receiver then key, as legacy reads them: map global `mkSym` (recovered for
// `mkNonNull`), or where it is -1 receiver operand `mkLoc`; then key `mkKey`, which must not
// reassign the receiver. Null on a miss.
type MapRecvKey = { mkSym: i32, mkNonNull: boolean, mkLoc: Opnd, mkKey: Opnd }
function mapRecvKeyOf(
  b: i32[],
  recvIx: i32,
  keyIx: i32,
  why: string,
  wide: boolean,
): MapRecvKey | null {
  const g = mapGlobalOf(recvIx)
  const loc = mapRecvLoc(b, recvIx, g, why)
  if ibMiss != "" { return null }
  const at = b.length
  const k = mapKeyAt(b, recvIx, keyIx, wide)
  if ibMiss != "" { return null }
  if mapRecvReassigned(b, at, loc) {
    irBMiss("map receiver reassigned")
    return null
  }
  const nonNull = g >= 0
    && globalReadRecovers(sidOfNode(recvIx), recvIx, ibFnIx)
  return { mkSym: g, mkNonNull: nonNull, mkLoc: loc, mkKey: k }
}

// Map key `keyIx` of receiver `recvIx` as legacy writes it: at the `i64` an `i64`-keyed map holds
// where `wide` (`emitScalarValue`), a key the atom hook converts at the receiver's atom key rep by
// the hook's arm, else as itself.
function mapKeyAt(b: i32[], recvIx: i32, keyIx: i32, wide: boolean): Opnd {
  if wide { return deliver(b, keyIx, repNodeOfTy(TY_I64), TY_I64) }
  if exprPrePathWhy(keyIx, ibFnIx) == "pre-path atom hook" {
    const kt = nodeMapKeyTyOf(unwrapParen(recvIx))
    const r = if kt >= 0 { repNodeOfTy(kt) } else { -1 }
    if r >= 0 && repNodeAt(r) is RAtom { return deliver(b, keyIx, r, kt) }
  }
  return irBExpr(b, keyIx)
}

// A map operation's receiver other than global `g`: any expression read as a map, in place (a
// variable, or the one temp its use writes, as legacy writes the receiver first); the immediate
// none where `g` names the global, and miss `why` for any other receiver.
function mapRecvLoc(b: i32[], recvIx: i32, g: i32, why: string): Opnd {
  const none: Opnd = { oiRep: ibNoValue, oiBits: 0 }
  if g >= 0 { return none }
  if recvIx < 0 { return irBMiss(why) }
  const at = b.length
  const o = irBExpr(b, recvIx)
  if ibMiss != "" { return o }
  // A valued `if`'s or a boxed `??`'s out is the receiver's value left on the stack, read first.
  if (
    !(o is OVar)
    || b.length > at
      && !defaultSelfContained(b, b.length - 1, o)
      && !recvIfOut(b, at, o)
  ) {
    return irBMiss(why + " computes")
  }
  if !(repNodeAt(irBOpRep(o)) is RMap) { return irBMiss(why + " rep") }
  return o
}

// Whether receiver operand `o` is the out of the last statement built into `b` from `at`, a
// valued `if` (`SIf` or `SArmSite`) or a boxed `??`.
function recvIfOut(b: i32[], at: i32, o: OVar): boolean {
  if b.length <= at { return false }
  const n = ib.irNodes[b[b.length - 1]]
  return n is SIf && n.siOut == o.ov
    || n is SArmSite && n.saOut == o.ov
    || n is SCoalBox && n.cbOut == o.ov
}

// Whether a node built into `b` from `at` on, at any depth, assigns map receiver variable `loc`:
// legacy reads the receiver ahead of its operands, the lowering at the operation.
function mapRecvReassigned(b: i32[], at: i32, loc: Opnd): boolean {
  if !(loc is OVar) { return false }
  let i = at
  while i < b.length {
    if nodeAssigns(b[i], loc.ov) { return true }
    i = i + 1
  }
  return false
}

// Whether node `ni` of the function being built, or a node of a body it holds, assigns `v`.
function nodeAssigns(ni: i32, v: i32): boolean {
  if ni < 0 || ni >= ib.irNodes.length { return false }
  const n = ib.irNodes[ni]
  return match n {
    SAssign => n.asDst == v
    SIf => bodyAssigns(n.siThen, v) || bodyAssigns(n.siElse, v)
    SCoalBox => coalBoxAssigns(n, v)
    SArmSite => n.saOut == v
    SArmWrite => armsAssign(n.awArms, v)
    SBlock => bodyAssigns(n.bkBody, v)
    SLoop => bodyAssigns(n.lpBody, v)
    SForIn => n.xfVar == v || n.xfVar2 == v || bodyAssigns(n.xfBody, v)
    SRangeLoop => {
      if n.rlVar == v || bodyAssigns(n.rlTail, v) { return true }
      for c in n.rlCopies {
        if bodyAssigns(c, v) { return true }
      }
      false
    }
    SSwitch => {
      for arm in n.swArms {
        if bodyAssigns(arm.swBody, v) { return true }
      }
      false
    }
    SIntSwitch => {
      for arm in n.isArms {
        if bodyAssigns(arm, v) { return true }
      }
      bodyAssigns(n.isElse, v)
    }
    SLet | SSetField | SListSet | SCellSet | SGlobalSet | SBoundsCheck | SEffect | SBr | SReturn | STrap | SDrop | SRawOp => false
  }
}

// Whether a `??`'s default or its operand block assigns variable `v`; its own frame, so the
// per-level `nodeAssigns` frame stays as small as its other arms need.
function coalBoxAssigns(n: SCoalBox, v: i32): boolean {
  return bodyAssigns(n.cbNull, v) || bodyAssigns(n.cbLB, v)
}

// Whether any arm body in `arms` assigns `v`.
function armsAssign(arms: i32[][], v: i32): boolean {
  for a in arms {
    if bodyAssigns(a, v) { return true }
  }
  return false
}

function bodyAssigns(body: i32[], v: i32): boolean {
  for ni in body {
    if nodeAssigns(ni, v) { return true }
  }
  return false
}

// Map type `ty` of a binding as legacy stores it, its mv slot read off expression `recvIx` (a read
// of a global, a local's initializer): where its value type is open (a hole) and that slot stores a
// closed value type (a bundle's record), the map of that type; else `ty`.
function mapSlotHeldTy(ty: i32, recvIx: i32): i32 {
  const m = repNodeAt(repNodeOfTy(ty))
  if !(m is RMap) || !irTyOpen(repTyOf(m.rmVal)) || recvIx < 0 { return ty }
  const sh = mapRecvShapeOf(recvIx, ibFnIx)
  if sh < 0 { return ty }
  const st = mvValTyIxAt(sh)
  if st < 0 || irTyOpen(st) { return ty }
  const mt = mapTyWithVal(ty, st)
  return if mt >= 0 && repNodeAt(repNodeOfTy(mt)) is RMap { mt } else { ty }
}

// The module global map read `recvIx` names, its rep noted in `ib`; -1 for any other receiver.
function mapGlobalOf(recvIx: i32): i32 {
  const g = mapRecvGlobalIx(recvIx, ibFnIx)
  if g < 0 { return -1 }
  const d = identDeclOf(recvIx)
  const r = repNodeOfTy(mapSlotHeldTy(scopeTyAt(d, -1), recvIx))
  if !(repNodeAt(r) is RMap) { return -1 }
  globalNoteAt(g, d, r)
  return g
}

function isNumericPrim(p: string): boolean {
  return p == "i32"
    || p == "i64"
    || p == "f64"
    || p == "f32"
    || p == "u32"
    || p == "u64"
}

// Whether operand `ix` is typed at an unsigned integer, so its op takes the unsigned form.
function opUnsigned(ix: i32): boolean {
  const p = tyScalarBasePrim(nodeTyAt(ix, ibFnIx))
  if p == null { return false }
  const ps: string = p
  return ps == "u32" || ps == "u64"
}

// A tagged function set's value: its member's id, an i32 immediate as legacy writes it.
function tagLeaf(ix: i32): Opnd {
  // Legacy writes the member's id as an `i32.const` whatever rep the node's own open type names;
  // a destination that is not the set's `i32` misses at its own rep check.
  const own = primRepOf(ix)
  const p = repPrim(own)
  const rep = if p != null && p == "i32" { own } else { repNodeOfTy(TY_I32) }
  const o: Opnd = { oiRep: rep, oiBits: fnTagLeafEmitted(ix, ibFnIx) as i64 }
  return o
}

// A call through a tagged function set, as `emitFnTagDispatch` writes it: the callee's set id kept,
// then a valued `if` per member but the last, which takes the final `else`. Each arm is its call,
// delivered at the call's rep. A lambda arm, which legacy stages at its instance, and a result
// past the scalars and strings, are named misses.
function tagDispatch(b: i32[], ix: i32): Opnd {
  return tagDispatchAt(b, ix, true)
}

// `tagDispatch`, its value read at the call's own rep when `read`; a statement's is dropped, so
// only the dispatch's own result rep matters there.
function tagDispatchAt(b: i32[], ix: i32, read: boolean): Opnd {
  const c = nodeAt(unwrapParen(ix))
  if !(c is Call) { return irBMiss("tag dispatch node") }
  const arms = tagDispatchArms(ix, ibFnIx)
  const ids = tagDispatchIds(ix, ibFnIx)
  if arms.length == 0 || ids.length != arms.length {
    return irBMiss("tag dispatch members")
  }
  for a in arms {
    if tagArmLambdaCallee(a) >= 0 && lambdaArmFe(a) < 0 {
      return irBMiss("tag dispatch lambda arm")
    }
  }
  // The call's type read at this instance, as legacy keys its result.
  const ty = instTyOrSelf(tagDispatchTy(ix, arms, ibFnIx), ibFnIx)
  if irTyOpen(ty) { return irBMiss("open temp type") }
  // Legacy keys the dispatch on its result's kind: none has no rep, and a union boxes each arm.
  const kind = repSigKindOfTy(ty)
  if kind == null { return irBMiss("tag dispatch result") }
  const rep = repNodeOfTy(ty)
  if read && primRepOf(ix) != rep { return irBMiss("tag dispatch result rep") }
  const b0 = b.length
  const f = tagCallee(b, c.callFn)
  if ibMiss != "" { return f }
  if repPrim(irBOpRep(f)) != "i32" { return irBMiss("tag dispatch callee rep") }
  irBNode(b, { efRhs: { tgsV: f } }, -1, ibNoValue, ix)
  if arms.length == 1 {
    const one = tagArm(b, arms[0], rep, ty)
    if one is OVar && dispatchDeclinesTail() { ib.irNoTail.push(one.ov) }
    tagSpanNote(b, b0, ix)
    return one
  }
  // Links in member order, then their `if`s innermost first, each out assigned into its parent's.
  const bs: i32[][] = []
  const conds: Opnd[] = []
  const outs: i32[] = []
  const thens: i32[][] = []
  let cb = b
  let k = 0
  while k < arms.length - 1 {
    const cv = tagIsTemp(cb, ids[k], ix)
    const t = irVarNew(ib, rep, ty, "local", -1)
    const th: i32[] = []
    const v = tagArm(th, arms[k], rep, ty)
    if ibMiss != "" { return v }
    irBNode(th, { asDst: t, asSrc: v }, -1, ibNoValue, arms[k])
    bs.push(cb)
    conds.push(cv)
    outs.push(t)
    thens.push(th)
    const eb: i32[] = []
    cb = eb
    k = k + 1
  }
  const last = arms.length - 1
  const lv = tagArm(cb, arms[last], rep, ty)
  if ibMiss != "" { return lv }
  irBNode(cb, { asDst: outs[last - 1], asSrc: lv }, -1, ibNoValue, arms[last])
  let elseB = cb
  let j = last - 1
  while j >= 0 {
    irBNode(bs[j], sIf(conds[j], thens[j], elseB, outs[j], true), ty, rep, ix)
    if j == 0 { break }
    const inner: Opnd = { ov: outs[j] }
    irBNode(bs[j], { asDst: outs[j - 1], asSrc: inner }, -1, ibNoValue, ix)
    elseB = bs[j]
    j = j - 1
  }
  const o: Opnd = { ov: outs[0] }
  tagSpanNote(b, b0, ix)
  return o
}

// A tagged call's callee `f`, as `emitFnTagDispatch` writes it (`emitExpr`): where its checked rep
// differs from its storage's, a module global that is no function value (`emitIdentNonLocalRead`)
// or a capture of an unlifted closure (`emitCapturedRead`) is read as stored, the member id.
function tagCallee(b: i32[], f: i32): Opnd {
  const n = nodeAt(f)
  if n is Ident && identReadArmOf(n, f, ibFnIx, false) == "nonlocal" {
    const d = identDeclOf(f)
    const g = globalIndexOfSid(sidOfNode(f))
    if (
      g >= 0
      && d >= 0
      && nodeAt(d) is LetDecl
      && fnValueFeOf(n, sidOfNode(f), f, ibFnIx) < 0
      && globalRep(g, d) != exprRepOf(f)
    ) {
      return globalStoredRead(
        b,
        g,
        f,
        globalRep(g, d),
        heldTy(letBindTy(d, -1)),
      )
    }
  }
  if n is Ident && identReadArmOf(n, f, ibFnIx, false) == "capture" {
    const fe = fnStmtsPosOf(ibFnIx)
    const cr = capRepOf(fe, n.identName)
    const d = identDeclOf(f)
    if cr >= 0 && cr != exprRepOf(f) && d >= 0 && nodeAt(d) is LetDecl {
      const ty = heldTy(letBindTy(d, -1))
      if !cloLifted(fe) {
        return irBLetTempTy(
          b,
          { evSlot: captureSlotOf(n.identName, ibFnIx), evAt: f },
          f,
          cr,
          ty,
        )
      }
      // A lifted function holds the id as its own parameter after its environment.
      const v = liftCapVarAt(fe, n.identName, cr, ty)
      if v < 0 || ib.irVars[v].vRep != cr { return irBMiss("capture binding") }
      ib.irReadVar[f] = v
      const o: Opnd = { ov: v }
      return o
    }
  }
  return irBExpr(b, f)
}

// Whether tagged call `ix` leaves no value (`tagDispatchTyIsVoid` at its dispatch type).
function tagDispatchStmtIsVoid(ix: i32): boolean {
  const arms = tagDispatchArms(ix, ibFnIx)
  if arms.length == 0 { return false }
  return tagDispatchTyIsVoid(tagDispatchTy(ix, arms, ibFnIx))
}

// A statement call through a tagged set that leaves no value, as `emitFnTagDispatch` writes it:
// the callee, of any expression, read and its set id kept, then a void `if` per member but the
// last, which takes the final `else`. Each arm is its call as a statement, a valued member's
// result dropped.
function tagDispatchVoid(b: i32[], ix: i32): i32 {
  const c = nodeAt(unwrapParen(ix))
  if !(c is Call) { return skip("tag dispatch node") }
  const arms = tagDispatchArms(ix, ibFnIx)
  const ids = tagDispatchIds(ix, ibFnIx)
  if arms.length == 0 || ids.length != arms.length {
    return skip("tag dispatch members")
  }
  for a in arms {
    if tagArmLambdaCallee(a) >= 0 && lambdaArmFe(a) < 0 {
      return skip("tag dispatch lambda arm")
    }
  }
  const f = tagCallee(b, c.callFn)
  if ibMiss != "" { return 0 }
  if repPrim(irBOpRep(f)) != "i32" { return skip("tag dispatch callee rep") }
  irBNode(b, { efRhs: { tgsV: f } }, -1, ibNoValue, ix)
  if arms.length == 1 { return tagArmStmt(b, arms[0]) }
  const bs: i32[][] = []
  const conds: Opnd[] = []
  const thens: i32[][] = []
  let cb = b
  let k = 0
  while k < arms.length - 1 {
    const cv = tagIsTemp(cb, ids[k], ix)
    const th: i32[] = []
    tagArmStmt(th, arms[k])
    if ibMiss != "" { return 0 }
    bs.push(cb)
    conds.push(cv)
    thens.push(th)
    const eb: i32[] = []
    cb = eb
    k = k + 1
  }
  tagArmStmt(cb, arms[arms.length - 1])
  if ibMiss != "" { return 0 }
  let elseB = cb
  let j = bs.length - 1
  while j >= 0 {
    irBNode(bs[j], sIf(conds[j], thens[j], elseB, -1, true), -1, ibNoValue, ix)
    elseB = bs[j]
    j = j - 1
  }
  return 0
}

// Dispatch arm call `a` as a statement into body `b`: a lambda arm a direct call of its instance.
function tagArmStmt(b: i32[], a: i32): i32 {
  const ac = nodeAt(a)
  if !(ac is Call) { return skip("tag dispatch arm node") }
  const fe = lambdaArmFe(a)
  if fe >= 0 { return tagArmCall(b, directCallAt(b, ac, a, fe), a) }
  // A member's call reaches the function legacy's resolves at this instance.
  const cf = if ac.callFn >= 0 { nodeAt(ac.callFn) } else { null }
  if !(cf is Ident) { return skip("tag dispatch arm callee") }
  const t = userFnCallTarget(ac, cf, ibFnIx)
  if t < 0 || t >= fnStmts.length { return skip("tag dispatch arm target") }
  return tagArmCall(b, directCallAt(b, ac, a, t), a)
}

// Arm call `r` as a statement of body `b`, at arm node `a`.
function tagArmCall(b: i32[], r: Rhs, a: i32): i32 {
  if ibMiss != "" { return 0 }
  irBNode(b, { efRhs: r }, -1, ibNoValue, a)
  if dispatchDeclinesTail() { ib.irNoTailEff.push(b[b.length - 1]) }
  return 0
}

// The test of the stashed id against member id `id`, a `bool` temp whatever the call's type.
function tagIsTemp(b: i32[], id: i32, ix: i32): Opnd {
  const v = irVarNew(ib, ibBool, TY_BOOL, "temp", -1)
  irBNode(b, { lDst: v, lRhs: { tgiId: id } }, TY_BOOL, ibBool, ix)
  const o: Opnd = { ov: v }
  return o
}

// The instance a lambda dispatch arm `a` calls, as legacy stages it (`emitArmRowFe`), or -1.
function lambdaArmFe(a: i32): i32 {
  const f = tagArmLambdaCallee(a)
  return if f < 0 { -1 } else { monoBundleReadFe(f, ibFnIx, elabArmSigAt(a, ibFnIx)) }
}

// Dispatch arm call `a`, delivered at the call's rep `rep` (type `ty`) into body `b`. A lambda arm
// is a direct call of its instance. Under a union result an arm the checker records no box at is
// boxed at the call's union, legacy's `emitUnionBoxOwed` floor.
function tagArm(b: i32[], a: i32, rep: i32, ty: i32): Opnd {
  const kind = repSigKindOfTy(ty)
  const fu = if kind != null && tagDispatchBoxes(kind) && !boxOwedAt(a, ibFnIx) { ty } else { -1 }
  const fe = lambdaArmFe(a)
  const ac = nodeAt(a)
  if fe >= 0 && ac is Call {
    const r = directCallAt(b, ac, a, fe)
    if ibMiss != "" { return irBMiss(ibMiss) }
    if !(r is RCall) { return irBMiss("tag dispatch lambda arm call") }
    const si = irSigOf(ib, r.caCallee)
    if si < 0 { return irBMiss("tag dispatch arm coercion") }
    const sr = ib.irSigRet[si]
    if sr == rep { return irBLetTempTy(b, r, a, rep, ty) }
    if fu < 0 { return irBMiss("tag dispatch arm coercion") }
    const lv = irBLetTempTy(b, r, a, sr, instTyOrSelf(exprTyOf(a), ibFnIx))
    return tagArmBoxed(b, lv, a, rep, fu)
  }
  const v = deliver(b, a, rep, fu)
  if ibMiss != "" || irBOpRep(v) == rep { return v }
  if fu < 0 { return irBMiss("tag dispatch arm coercion") }
  return tagArmBoxed(b, v, a, rep, fu)
}

// Arm value `v` of arm `a` boxed into union `uTy` at rep `rep`.
function tagArmBoxed(b: i32[], v: Opnd, a: i32, rep: i32, uTy: i32): Opnd {
  const bv = boxTempIn(b, v, a, rep, -1, uTy)
  if ibMiss == "" && irBOpRep(bv) != rep {
    return irBMiss("tag dispatch arm coercion")
  }
  return bv
}

export function irBExpr(b: i32[], ix: i32): Opnd { return exprAt(b, ix, false) }

// The value of `ix`; `cell` where a delivery builds it, so a local read may take its cell's rep.
function exprAt(b: i32[], ix: i32, cell: boolean): Opnd {
  if ibMiss != "" || ix < 0 { return irBMiss("no node") }
  if ibStagedVar >= 0 && ix == isRecvStagedIx { return stagedRecvRead(ix) }
  if ibArmRecvVar >= 0 {
    if ix == ibArmRecvIx {
      const o: Opnd = { ov: ibArmRecvVar }
      return o
    }
    if ix == ibArmIdxIx && ibArmIdxOps.length == 1 { return ibArmIdxOps[0] }
  }
  const pre = exprPrePathWhy(ix, ibFnIx)
  if pre == "pre-path coercion" { return coerced(b, ix, cell) }
  return exprAtPre(b, ix, cell, pre)
}

// A node-keyed coercion at `ix` (`emitCoerced`): the value built as legacy builds it under
// `coerceHeld`, past the coercion, then the coercion's tail (`coerceTail`), at the type the copy
// delivers or, for a retag, at the box's own.
function coerced(b: i32[], ix: i32, cell: boolean): Opnd {
  const ck = coerceKindAt(ix, ibFnIx)
  if ck == "recCopy" { return recCopied(b, ix, cell) }
  if ck != "listCopy" && ck != "mapRetag" && ck != "mapUnbox" && ck != "fnClo" {
    return irBMiss("pre-path coercion " + ck)
  }
  if ck == "fnClo" && fnCloFeOf(ix) < 0 {
    return irBMiss("pre-path coercion fnClo instance")
  }
  const v = exprAtPre(b, ix, cell, exprPrePathPastCoerce(ix, ibFnIx))
  if ibMiss != "" { return v }
  const ty = coercedTy(ix, ck)
  const rep = if ty >= 0 { primRepOfTy(ty) } else { -1 }
  if rep < 0 { return irBMiss("pre-path coercion " + ck + " rep") }
  if (
    ck != "listCopy"
    && ck != "fnClo"
    && ty == exprTyOf(ix)
    && irBOpRep(v) != rep
  ) {
    return irBMiss("pre-path coercion retag rep")
  }
  return irBLetTempTy(b, { cvV: v, cvAt: ix }, ix, rep, ty)
}

// The type coercion `ck` at `ix` delivers: a list copy's destination, a union of maps' one map
// (`mapUnboxTailTy`), else the node's own type, which a retag or a value no box keeps.
function coercedTy(ix: i32, ck: string): i32 {
  if ck == "listCopy" {
    return heldTy(instTyOrSelf(listCopyAtNode(ix), ibFnIx))
  }
  if ck == "mapUnbox" {
    const t = mapUnboxTailTy(ix, ibFnIx)
    if t >= 0 { return heldTy(t) }
  }
  if ck == "fnClo" { return heldTy(fnCloCoerceAtNode(ix)) }
  return exprTyOf(ix)
}

// Whether record copy source `ix` is a name read the builder notes as a variable's or global's
// (no capture), which the lowering writes again for legacy's copy.
function recCopySourceIsName(ix: i32): boolean {
  const u = unwrapParen(ix)
  if u < 0 || u >= P.nodes.length { return false }
  const n = nodeAt(u)
  if !(n is Ident) || captureSlotOf(n.identName, ibFnIx) >= 0 { return false }
  return localIndexOf(ibFnIx, u) >= 0 || globalTarget(u)
}

// A record copy at `ix` into a struct row (`emitRecCopyInto`) at the destination record's rep: the
// value built once past the coercion, then the copy (`coerceTail`); or, for a source the copy
// re-reads per field (`recCopyReReads`), legacy's whole copy (`RRecCopyPure`).
function recCopied(b: i32[], ix: i32, cell: boolean): Opnd {
  // A copy into a union's variant row (`-2 - vi`) is legacy's copy over that row's fields too.
  if recCopyRowAt(ix, ibFnIx) == -1 {
    return irBMiss("pre-path coercion recCopy variant")
  }
  const dt = recCopyDstTyAt(ix, ibFnIx)
  const ty = if dt >= 0 { heldTy(dt) } else { -1 }
  const rep = if ty >= 0 { primRepOfTy(ty) } else { -1 }
  if rep < 0 || !(repNodeAt(rep) is RRecord) {
    return irBMiss("pre-path coercion recCopy rep")
  }
  // A pure source is re-read per field, which one built operand cannot be: legacy writes it whole,
  // over the IR's read of a variable's or a global's source (`recCopySourceIsName`).
  if recCopyReReads(ix, ibFnIx) {
    // A source that is no place is read once (a one-field copy), so it is built whole.
    const once = recCopyReadsOnce(ix)
    const src: Opnd[] = []
    if once || recCopySourceIsName(ix) {
      const sv = exprAtPre(b, ix, cell, exprPrePathPastCoerce(ix, ibFnIx))
      if ibMiss != "" { return sv }
      src.push(sv)
    }
    return irBLetTempTy(b, { rpAt: ix, rpV: src, rpOnce: once }, ix, rep, ty)
  }
  const v = exprAtPre(b, ix, cell, exprPrePathPastCoerce(ix, ibFnIx))
  if ibMiss != "" { return v }
  return irBLetTempTy(b, { cvV: v, cvAt: ix }, ix, rep, ty)
}

// Whether fresh binding `letIx`'s initializer `init` is a read narrowed to `null` whose storage is
// that null (`NULL_READ_STORED`), where the binding is stored as a nullable reference
// (`letBindRep`): legacy copies the storage as it stands, which `localStoredAt` then takes.
function letStoresNullRead(letIx: i32, init: i32, v: i32): boolean {
  return nullReadOwnAt(init) == NULL_READ_STORED
    && letBindRepClaims(letIx, ibFnIx)
    && repDescIsNullRef(letBindRep(letIx, ibFnIx))
    && repNodeOfTy(heldTy(letBindTy(letIx, ibFnIx))) != ib.irVars[v].vRep
}

// Whether binding `letIx`'s initializer `init` is a narrowed arm unboxed into a nullable arm cell
// (`letCellKind` "nulvariant"), which legacy's `emitLetDelivery` casts to as a nullable ref.
function letCellNulArmUnbox(letIx: i32, init: i32, dst: i32): boolean {
  return exprPrePathWhy(init, ibFnIx) == ""
    && letCellKind(letIx, ibFnIx) == "nulvariant"
    && armUnboxOwed(init, dst)
}

// Whether `ix` is a box local narrowed to a record arm, delivered at record destination `dst`.
function armUnboxOwed(ix: i32, dst: i32): boolean {
  const au = unwrapParen(ix)
  return dst >= 0
    && au >= 0
    && au < P.nodes.length
    && recordRepOrNull(dst)
    && narrowedArmNeedsUnbox(ix, ibFnIx)
    && (nodeAt(au) is Ident && narrowedArmTyAt(au, ibFnIx) >= 0
    || asgBoxRep(au) >= 0)
}

// The box rep of assignment `ix` used as a value, where legacy's value is its target's re-read
// (`asgReadNode`) and that is a union box (`exprUnion`): the target's own rep; -1 for any other node.
function asgBoxRep(ix: i32): i32 {
  const n = nodeAt(ix)
  if (
    !(n is BinExpr)
    || n.binOp != "="
    || asgValueArmOf(ix, ibFnIx) != "reRead"
  ) {
    return -1
  }
  if (
    asgReadNode(ix, ibFnIx) != unwrapParen(n.binLeft)
    || !exprUnion(ix, ibFnIx)
  ) {
    return -1
  }
  const r = exprRepOf(n.binLeft)
  return if r >= 0 && heldAsBox(r) { r } else { -1 }
}

// Whether `ix` is a union of records each stored at record destination `dst`'s heap, which the
// table delivers there unboxed (`recordArmsUnboxOwedAt`).
function recordArmsUnboxOwed(ix: i32, dst: i32): boolean {
  if dst < 0 || !(repNodeAt(dst) is RRecord) { return false }
  const h = recHeapOf(dst)
  return h >= 0 && recordArmsUnboxOwedAt(h, ix, ibFnIx)
}

// `recordArmsUnboxOwed`'s `ix` built as its box, then cast to `dst`'s heap (`RArmUnbox.uaDst`).
function recordArmsUnboxTemp(b: i32[], ix: i32, dst: i32, dstTy: i32): Opnd {
  const v = irBExpr(b, ix)
  if ibMiss != "" { return v }
  if !(repNodeAt(irBOpRep(v)) is RBox) {
    return irBMiss("record arms unbox operand")
  }
  const ut = if dstTy >= 0 && repNodeOfTy(dstTy) == dst { dstTy } else { repTyOf(dst) }
  return irBLetTempTy(
    b,
    {
      uaV: v,
      uaAt: unwrapParen(ix),
      uaCellNul: false,
      uaDst: dst,
      uaAsg: false,
    },
    ix,
    dst,
    ut,
  )
}

// The box of `armUnboxOwed`'s `ix`, then the table's unbox to its arm's record, typed at the
// destination, whose record the arm's may only fit. `cellNul`: a nullable arm cell's binding.
function armUnboxTemp(
  b: i32[],
  ix: i32,
  dst: i32,
  dstTy: i32,
  cellNul: boolean,
): Opnd {
  const au = unwrapParen(ix)
  // An assignment's re-read box (`asgBoxRep`) is cast at the destination's heap (`uaAsg`).
  const asg = asgBoxRep(au) >= 0
  const bo = if asg { exprAt(b, au, true) } else { irBBoxLocal(b, au) }
  if ibMiss != "" { return bo }
  const ut = if dstTy >= 0 && primRepOfTy(dstTy) == dst { dstTy } else { repTyOf(dst) }
  return irBLetTempTy(
    b,
    {
      uaV: bo,
      uaAt: au,
      uaCellNul: cellNul,
      uaDst: if asg { dst } else { -1 },
      uaAsg: asg,
    },
    ix,
    dst,
    ut,
  )
}

// A postfix `x++` / `x--` read for its value, the old one: its increment assignment, whose value is
// the new one, then the step undone at the place's width, as legacy's `emitUnary` writes it.
function postfixValue(b: i32[], n: Unary, ix: i32, rep: i32): Opnd {
  const one = oneAt(rep)
  if one.oiRep < 0 { return irBMiss("postfix rep") }
  const v = irBExpr(b, n.unArg)
  if ibMiss != "" { return v }
  if irBOpRep(v) != rep { return irBMiss("postfix operand rep") }
  const p = binPrimOp(if n.unOp == "p+" { "-" } else { "+" }, false)
  if p == null { return irBMiss("postfix operator") }
  return irBLetTemp(b, { poOp: p, poArgs: [v, one] }, ix, rep)
}

// The number one at numeric rep `rep` as an immediate (a float's bits), or a rep of -1.
function oneAt(rep: i32): OImm {
  const k: string = repPrim(rep) ?? ""
  const bits: i64 = if k == "f64" { 4607182418800017408 } else if k == "f32" { 1065353216 } else { 1 }
  const ok = k == "i32" || k == "i64" || k == "f64" || k == "f32"
  return { oiRep: if ok { rep } else { -1 }, oiBits: bits }
}

// The value of `ix`, which a dead `never` read feeds, at rep `dst`: where -1, its own rep, else
// the `i32` legacy's never value takes. No value reaches it (`RDeadNever`).
function deadNeverTemp(b: i32[], ix: i32, dst: i32): Opnd {
  const own = exprRepOf(ix)
  const rep = if dst >= 0 { dst } else if own >= 0 && !repIsNoValue(own) { own } else { repNodeOfTy(TY_I32) }
  return irBLetTempTy(b, { dnAt: ix, dnPad: false }, ix, rep, TY_NEVER)
}

// A place or method-call read whose storage is the `null` unit, as legacy's `emitNulNoneRead`
// writes it: the read for its effects, dropped, then its destination's null (`nullOwnAt`), all
// where the value is read.
function nulUnitPlaceRead(b: i32[], ix: i32, cell: boolean): Opnd {
  if nullUnitRepAt(ix, exprRepOf(ix)) < 0 {
    return irBMiss("null unit read rep")
  }
  const v = exprAtPre(b, ix, cell, "")
  if ibMiss != "" { return v }
  return nullUnitTemp(b, ix, exprRepOf(ix), [v])
}

// The rep a `null`-unit value at `ix` is written at for a consumer asking `rep`: `rep` where its
// null is the one `nullOwnAt` names, else, where `rep` is the unit itself, the contextual type's
// whose null it is (a bool's or a string's null, as `emitNullAt` writes it); -1 for none.
function nullUnitRepAt(ix: i32, rep: i32): i32 {
  const own = nullOwnAt(ix, ibFnIx)
  if own < 0 { return -1 }
  if rep >= 0 && nullOwnRepFits(own, rep) { return rep }
  if rep >= 0 && repPrim(rep) != "null" { return -1 }
  const cr = repNodeOfTy(heldTy(ctxTyAt(ix, ibFnIx)))
  return if cr >= 0 && nullOwnRepFits(own, cr) { cr } else { -1 }
}

// A `null`-unit value at `ix` (`RNullOf`, after `read` for its effects) at `nullUnitRepAt`'s rep.
function nullUnitTemp(b: i32[], ix: i32, rep: i32, read: Opnd[]): Opnd {
  const at = nullUnitRepAt(ix, rep)
  if at < 0 { return irBMiss("null unit read rep") }
  const r: Rhs = { nuAt: ix, nuOwn: nullOwnAt(ix, ibFnIx), nuRead: read }
  if at == rep { return repTemp(b, r, ix, rep) }
  return repTempTy(b, r, ix, at, heldTy(ctxTyAt(ix, ibFnIx)))
}

// `exprAt` past the pre-path, whose answer for `ix` is `pre`.
function exprAtPre(b: i32[], ix: i32, cell: boolean, pre: string): Opnd {
  // Legacy writes `unreachable` for a value a dead `never` read feeds (`emitExpr`, D16006);
  // the pre-path names it first, and a caller that passes none has ruled it out for `ix`.
  if pre == "pre-path dead never" { return deadNeverTemp(b, ix, -1) }
  if pre == "pre-path tag leaf" { return tagLeaf(ix) }
  if pre == "pre-path tag dispatch" { return tagDispatch(b, ix) }
  if pre == "pre-path null unit read" { return nulUnitPlaceRead(b, ix, cell) }
  if pre == "pre-path nul atom niche" { return nulLitNicheRead(b, ix) }
  if pre == "pre-path niche read" { return placeNicheRead(b, ix) }
  if pre != "" { return irBMiss(pre) }
  const n = nodeAt(ix)
  if n is Paren { return exprAt(b, n.parInner, cell) }
  // The `true` of a bare block's `if true` rewrite (`drwBareBlock`) is untyped, and a bool.
  if n is BoolLit && nodeTyAt(ix, ibFnIx) < 0 {
    const t: Opnd = {
      oiRep: ibBool,
      oiBits: if n.boolVal != 0 { 1 } else { 0 },
    }
    return t
  }
  // A `match` arm's string pattern over an open scrutinee is untyped, and a string where it does
  // not take its member's atom, as legacy's `emitStr` writes any untyped literal.
  if n is StrLit && nodeTyAt(ix, ibFnIx) < 0 && !strLitTakesAtom(ix, ibFnIx) {
    return strLit(ix, repNodeOfTy(TY_STR))
  }
  const own = exprRepOf(ix)
  // A `never` call, operator or field read is legacy's i32: its consumer widens it as any i32.
  const nv = own < 0
    && (n is Call || n is BinExpr || n is Member || n is Unary)
    && exprTyOf(ix) == TY_NEVER
  // A read of a parameter or `let` whose own type has no rep is at its variable's rep
  // (`paramFrameTy`, legacy's declared kind, or the binding's built value).
  const pr = if own < 0 && !nv { irBOpenLocalReadRep(ix) } else { -1 }
  // An arithmetic operator whose own type has no rep computes at legacy's width (`binNumWidth`).
  const br = if own < 0 && !nv && pr < 0 { openBinRep(ix) } else { -1 }
  // An array literal whose own type has no rep is at the type legacy builds it at.
  const ar = if own < 0 && n is ArrayLit { openArrLitRep(ix) } else { -1 }
  // A shared field read off a hole receiver is at its arms' one storage type (`ir_build_ref`).
  const mr = if own < 0 && !nv && n is Member { irOpenMemberRepHook(ix) } else { -1 }
  // A `??` map read whose own type has no rep (a link legacy mints) is at the map's value rep,
  // where legacy's `mapGetOr` arm writes it.
  const cr = if own < 0 && !nv && pr < 0 && br < 0 { openCoalMapRep(ix) } else { -1 }
  // An assignment whose value legacy re-reads off a union-box target is that box (`asgBoxRep`).
  const xr = if own >= 0 && n is BinExpr { asgBoxRep(ix) } else { -1 }
  // A `null` literal with no type of its own (one a rewrite minted) is legacy's `emitNullAt`:
  // the bottom ref, at the `null` unit, where it names no null of its own.
  const un = own < 0
    && !nv
    && n is NullLit
    && nullOwnAt(ix, ibFnIx) == NULL_OWN_NONE
  const rep = if un { repNodeOfNullUnit() } else if nv { repNodeOfTy(TY_I32) } else if pr >= 0 { pr } else if br >= 0 { br } else if ar >= 0 { ar } else if mr >= 0 { mr } else if cr >= 0 { cr } else if xr >= 0 { xr } else { own }
  // A direct call whose own type has no rep is at its callee's result rep.
  if rep < 0 && n is Call && !nv { return openCallValue(b, n, ix) }
  // A desugared optional call's minted callee has no type: it is the field the plain `.f` call reads
  // at its storage (`sharedFieldCallee`), as `closureCallRhs` reads an untyped member callee.
  if rep < 0 && n is Member && optCallCalleeOfMember(ix) >= 0 {
    return sharedFieldCallee(b, n, ix)
  }
  if rep < 0 {
    return repMissAt(ix, "rep " + repWhat(repNodeOfTy(nodeTyAt(ix, ibFnIx))))
  }
  if n is NumLit { return numLit(n, ix, rep) }
  if n is BoolLit {
    const bits: i64 = if n.boolVal != 0 { 1 } else { 0 }
    const o: Opnd = { oiRep: rep, oiBits: bits }
    return o
  }
  if n is Ident { return identRead(b, n, ix, rep, cell) }
  if n is Unary {
    if n.unOp == "p+" || n.unOp == "p-" { return postfixValue(b, n, ix, rep) }
    if n.unOp != "-" && n.unOp != "!" && n.unOp != "~" {
      return irBMiss("unary " + n.unOp)
    }
    // A negated literal is one constant at the negation's own width, which may be narrower than
    // its operand's: `-2147483647` over an `i64` magnitude (`emitSignedNumLitAt`).
    const neg = if n.unOp == "-" { unwrapParen(n.unArg) } else { -1 }
    if (
      neg >= 0
      && neg < P.nodes.length
      && nodeAt(neg) is NumLit
      && numLitTyWidth(ix, ibFnIx) != ""
    ) {
      return signedLitAt(ix, rep)
    }
    // `-` and `~` over a `never` operand are legacy's i32, at the operand's own i32 (D14420).
    const unv = exprTyOf(n.unArg) == TY_NEVER
    if unv && n.unOp == "!" { return irBMiss("not over a never operand") }
    const uw = if unv { "" } else { operandWhy(n.unArg) }
    if uw != "" { return irBMiss(uw) }
    const aat = b.length
    const a = irBExpr(b, n.unArg)
    if ibMiss != "" { return a }
    if irBOpRep(a) != rep { return irBMiss("operand coercion") }
    // A constant `is` under `!` is the one constant legacy reads back and negates (D2957).
    if a is OImm && n.unOp == "!" && bareConstIs(a, n.unArg, b, aat) {
      const nb: i64 = if a.oiBits != 0 { 0 } else { 1 }
      const o: Opnd = { oiRep: rep, oiBits: nb }
      return o
    }
    // `~x` is legacy's `x ^ -1`, the all-ones mask at the operand's width.
    const uty = if unv { repTyOf(rep) } else { heldTy(exprTyOf(ix)) }
    if n.unOp == "~" {
      const ones: Opnd = { oiRep: rep, oiBits: -1 }
      return irBLetTempTy(b, { poOp: "xor", poArgs: [a, ones] }, ix, rep, uty)
    }
    // Legacy's integer `-x` is `0 - x`, the zero written before the operand, which a valued `if`
    // in it would sit above.
    const vt = valtypeOf(rep)
    if (
      n.unOp == "-"
      && (vt == 0x7f || vt == 0x7e)
      && ifBelowLead(b, aat, "integer negation of a valued if")
    ) {
      return a
    }
    const op: PrimOp = if n.unOp == "-" { "neg" } else { "not" }
    return irBLetTempTy(b, { poOp: op, poArgs: [a] }, ix, rep, uty)
  }
  if n is BinExpr {
    if n.binOp == "&&" || n.binOp == "||" { return shortCircuit(b, n, ix, rep) }
    // Legacy folds a mask that only zero-extends a load into the zero-extending load.
    if n.binOp == "&" && zextLoadOf(ix, ibFnIx) >= 0 {
      return zextLoadRead(b, ix, rep)
    }
    if n.binOp == "=" { return assignValue(b, n, ix, rep) }
    // An identity over a per-arm union is legacy's `identMixed` compare, ahead of its null test.
    const bt = binNulTestOf(n)
    const mixed = n.binIdent != 0 && eqRouteOf(n, ix, ibFnIx) == "identMixed"
    if bt != null && !mixed { return nulTest(b, n, bt, ix, rep) }
    // A non-literal `null` against a nullable is that operand's null test, by legacy's route; a
    // `null` side other than a name read, which legacy runs for its effect, is legacy's.
    const nt = binNulNameTestOf(n, ibFnIx)
    if nt != null && eqRouteOf(n, ix, ibFnIx) == "nulName" {
      const nulLeft = nt.bnRef == n.binRight
      const ns = if nulLeft { n.binLeft } else { n.binRight }
      if nulNoneWritesNothing(ns) { return nulTest(b, n, nt, ix, rep) }
      // A left `null` side runs for its effect ahead of the test (`emitNulNameTestBin`).
      // A right side runs after the tested name; written first it reads alike when it has no effect,
      // or stores an effect-free value to another name, which no write reaches the tested name through.
      if (
        !nulLeft
        && !exprEffectFree(ns)
        && !rightNullStoreCommutes(ns, nt.bnRef)
      ) {
        return irBMiss("null name test of a non-name null side")
      }
      const effs: Opnd[] = []
      const e0 = b.length
      const e = nulNoneEffect(b, ns, ix, effs)
      if ibMiss != "" { return e }
      // A store in it is a statement written where it stands, ahead of the test, as legacy
      // writes the side first; a tested side with an effect of its own is still legacy's.
      if !onlyTempsFrom(b, e0) && !exprEffectFree(nt.bnRef) {
        return irBMiss("null name test of a null side that stores")
      }
      const t = nulTest(b, n, nt, ix, rep)
      if ibMiss != "" || effs.length == 0 { return t }
      return irBLetTemp(b, { aeEff: effs, aeV: t, aeAt: ix }, ix, rep)
    }
    if n.binOp == "??" { return coalesce(b, n, ix, rep, cell) }
    // Legacy declares a string compare's locals for a side the checker typed `string` and holds as
    // an atom, which no IR compare route declares; it misses rather than move those bytes.
    if (
      (n.binOp == "==" || n.binOp == "!=")
      && (atomCellWidened(n.binLeft) || atomCellWidened(n.binRight))
    ) {
      return irBMiss("compare of a joined const atom")
    }
    // Legacy compares such an assignment's re-read atom by its own fold, which no IR compare
    // route writes.
    if (
      (n.binOp == "==" || n.binOp == "!=")
      && (asgMemberReReadAt(n.binLeft) || asgMemberReReadAt(n.binRight))
    ) {
      return irBMiss("assignment-value atom re-read as a compare operand")
    }
    // A union box against a concrete operand is legacy's union compare, by legacy's own route.
    if (
      (n.binOp == "==" || n.binOp == "!=")
      && (unionSideOf(n.binLeft) || unionSideOf(n.binRight))
    ) {
      const rt = eqRouteOf(n, ix, ibFnIx)
      if rt == "unionLeft" || rt == "unionRight" {
        return unionConcreteEq(b, n, ix, rep, rt == "unionRight")
      }
    }
    // Two operands typed at single string literals fold to a constant (`atomEqPlanOf`).
    if (
      (n.binOp == "==" || n.binOp == "!=")
      && atomEqPlanOf(n, ibFnIx).aqArm == "fold"
    ) {
      return atomCompare(b, n, ix, rep)
    }
    // An atom operand of no atom compare (a `+`, or `==` against a plain string) is the string
    // op's, which decodes the atom to its member string, as legacy's dispatch routes it.
    // An operand whose own type is open takes legacy's plan for the compare, as an atom one does.
    if (
      (atomOperand(n.binLeft)
        || atomOperand(n.binRight)
        || irTyOpen(exprTyOf(n.binLeft))
        || irTyOpen(exprTyOf(n.binRight)))
      && atomEqPlanOf(n, ibFnIx).aqArm != "none"
    ) {
      return atomCompare(b, n, ix, rep)
    }
    // `===`/`!==` over references is legacy's identity (`emitIdentityBin`).
    if (
      n.binIdent != 0
      && (eqRouteOf(n, ix, ibFnIx) == "identRef"
        || eqRouteOf(n, ix, ibFnIx) == "identMixed")
    ) {
      return identityEq(b, n, ix, rep)
    }
    if (
      operandWhy(n.binLeft) == STR_OPERAND
      || operandWhy(n.binRight) == STR_OPERAND
    ) {
      // A string compare over a nullable operand is legacy's guarded compare (`eqRouteOf`).
      if (
        (n.binOp == "==" || n.binOp == "!=")
        && eqRouteOf(n, ix, ibFnIx) == "nulNiche"
      ) {
        return nulNicheEq(b, n, ix, rep)
      }
      return irStrBinHook(b, ix, rep)
    }
    // A compound operand's compare is legacy's union or list compare, or a miss below.
    if (
      operandWhy(n.binLeft) == OPERAND_TYPE
      || operandWhy(n.binRight) == OPERAND_TYPE
    ) {
      if irUnionEqHook(ix, ibFnIx) { return unionEq(b, n, ix, rep) }
      if irListEqHook(ix, ibFnIx) { return listEq(b, n, ix, rep) }
      // Two lists stored apart compare by value across their storages (`xrepEmitPair`).
      if (
        (n.binOp == "==" || n.binOp == "!=")
        && eqRouteOf(n, ix, ibFnIx) == "xrep"
      ) {
        return listEq(b, n, ix, rep)
      }
      const cat = irListCatHook(ix, ibFnIx)
      if cat == "plain" || cat == "widen" && catWidenTakes(ix, ibFnIx) {
        return listCat(b, n, ix, rep)
      }
      if cat != "none" { return irBMiss("list concat " + cat) }
      if eqRouteOf(n, ix, ibFnIx) == "numeric" {
        return nicheBoolEq(b, n, ix, rep)
      }
      if eqRouteOf(n, ix, ibFnIx) == "numUnion" {
        return numUnionBin(b, n, ix, rep)
      }
      if eqRouteOf(n, ix, ibFnIx) == "structEq" {
        return structEqOp(b, n, ix, rep, binEqStructRow(ix, ibFnIx))
      }
      if eqRouteOf(n, ix, ibFnIx) == "variantEq" {
        return structEqOp(b, n, ix, rep, variantEqRowOf(ix, ibFnIx))
      }
      if eqRouteOf(n, ix, ibFnIx) == "nulNiche" {
        return nulNicheEq(b, n, ix, rep)
      }
      if eqRouteOf(n, ix, ibFnIx) == "closure" {
        return closureEq(b, n, ix, rep)
      }
      if eqRouteOf(n, ix, ibFnIx) == "scalarMap" {
        return scalarMapEq(b, n, ix, rep)
      }
    }
    // A compare over a bare scalar map read (`scalarMapEqPlanOf` asks the same, so no other operand
    // can take legacy's probe route) reads the probe's compare where legacy routes it there
    // (`eqRouteOf`), whatever the operands' reps: a narrowed read has no compound block.
    if (
      (n.binOp == "==" || n.binOp == "!=")
      && (mapReadScalarBoxKind(n.binLeft, ibFnIx) >= 0
        || mapReadScalarBoxKind(n.binRight, ibFnIx) >= 0)
    ) {
      if eqRouteOf(n, ix, ibFnIx) == "scalarMap" {
        return scalarMapEq(b, n, ix, rep)
      }
      // Guard: legacy's route and the IR's disagree; miss rather than ship the operator's bytes.
      return irBMiss("scalar map compare route")
    }
    if (
      (n.binOp == "==" || n.binOp == "!=")
      && nulNoneEqSides(n.binLeft, n.binRight, ibFnIx)
      && eqRouteOf(n, ix, ibFnIx) == "nulNone"
    ) {
      return nulNonePairEq(b, n, ix, rep)
    }
    const p = binPrimOp(n.binOp, opUnsigned(n.binLeft))
    if p == null || n.binIdent != 0 { return irBMiss("operator " + n.binOp) }
    // Legacy strength-reduces a masked shift (`shiftMaskFoldOf`) at an integer width.
    const fw = binNumWidth(n, ibFnIx)
    if fw != "f32" && fw != "f64" {
      const fb = if fw == "i64" { 64 } else { 32 }
      const fold = shiftMaskFoldOf(n, ix, fb, ibFnIx)
      if fold.length > 0 { return shiftMaskFold(b, fold, fb, ix, rep) }
    }
    // An operand typed `never` is built at the other's rep, which picks the op (D14420).
    const nl = exprTyOf(n.binLeft) == TY_NEVER
    const nr = exprTyOf(n.binRight) == TY_NEVER
    if nl && nr { return irBMiss("operator over two never operands") }
    const lw = operandWhy(if nl { n.binRight } else { n.binLeft })
    if lw != "" { return irBMiss(lw) }
    const rw = operandWhy(if nr { n.binLeft } else { n.binRight })
    if rw != "" { return irBMiss(rw) }
    const never = nl || nr
    const sib = if nl { n.binRight } else { n.binLeft }
    // Legacy writes the op at i32 beside an i32 operand; beside a wider one, at that operand's
    // width (D17064): the `never` side diverges first, so no value of it is ever read.
    const i32r = repNodeOfTy(TY_I32)
    const sr = exprRepOf(sib)
    if never && sr != i32r && !nl {
      return irBMiss("never operator over a non-i32 operand")
    }
    const orep = if !never { rep } else if binIsCompare(n.binOp) { ibBool } else if sr == i32r { i32r } else { sr }
    // Mixed numeric widths meet at the operator's width, each operand widened before the next
    // is built, as legacy builds them (`emitBinOperandAs`); a literal there is built at that
    // width (`emitNumLitAs`).
    const dst = binWidthRep(n)
    const lLit = dst >= 0
      && irRepOtherThan(n.binLeft, dst)
      && numLitAsApplies(n.binLeft)
    const rLit = dst >= 0
      && irRepOtherThan(n.binRight, dst)
      && numLitAsApplies(n.binRight)
    const ls = b.length
    // A left `never` beside a wider operand is read at i32, its consumer's rep, and widened to
    // that operand's width, as legacy writes it; no value of it is ever read.
    const wideNever = never && nl && sr != i32r
    const l = if lLit { signedLitAt(unwrapParen(n.binLeft), dst) } else if wideNever { neverWidened(b, irBExpr(b, n.binLeft), n.binLeft, sr) } else { widenTo(b, irBExpr(b, n.binLeft), n.binLeft, dst, -1) }
    const at = b.length
    const r = if rLit { signedLitAt(unwrapParen(n.binRight), dst) } else { widenTo(b, irBExpr(b, n.binRight), n.binRight, dst, -1) }
    if ibMiss != "" { return l }
    const lead = [l]
    if !stageLeftBelow(b, ls, at, lead, n.binLeft) { return l }
    const sl = lead[0]
    if irBOpRep(sl) != irBOpRep(r) { return irBMiss("operand coercion") }
    if never {
      return irBLetTempTy(
        b,
        { poOp: p, poArgs: [sl, r] },
        ix,
        orep,
        repTyOf(orep),
      )
    }
    return irBLetTemp(b, { poOp: p, poArgs: [sl, r] }, ix, rep)
  }
  if n is Call {
    // A map's `.has` / `.get` over a box of maps, read per arm as legacy's `emitCall` reads it first.
    if armSiteReads(ix, ibFnIx) { return irArmSiteHook(b, ix, rep) }
    if mapNewCall(n) {
      if !(repNodeAt(rep) is RMap) { return irBMiss("map new rep") }
      return irBLetTemp(b, { mnAt: ix }, ix, rep)
    }
    if arrNewCallNamed(n, ibFnIx) { return arrNew(b, n, ix, rep) }
    if tplStrHoleOf(n, ibFnIx) >= 0 {
      const hv = tplHoleStr(b, n)
      if ibMiss == "" && irBOpRep(hv) != rep {
        return irBMiss("template hole pinned rep")
      }
      return hv
    }
    const rhs = callRhs(b, n, ix)
    if ibMiss != "" { return irBMiss("call") }
    if rhs is RCall && bundlePickRefused(ix, rhs.caCallee) {
      return irBMiss("bundle result pick refused")
    }
    if rhs is RCall && rhs.caNever { return irBLetTemp(b, rhs, ix, rep) }
    if rhs is RCall && nulNoneCallee(rhs.caCallee) {
      const sentinel = nullOwnAt(ix, ibFnIx)
      if sentinel == NULL_OWN_BOOL || sentinel == NULL_OWN_ATOM {
        return nulNoneCallSentinel(b, rhs, ix, sentinel)
      }
    }
    // A call typed past its callee's result: a bundle pick, a reference the destination stores as
    // it stands, else the callee's own rep.
    if rhs is RCall {
      const si = irSigOf(ib, rhs.caCallee)
      if si >= 0 && ib.irSigRet[si] != rep {
        // A bundle record legacy picks a member of after the call (`bundleResultPickOf`) is
        // the record, then that member; a pick legacy refuses (`bpHeap` -2) has no field.
        const sr = ib.irSigRet[si]
        const pk = if repNodeAt(sr) is RRecord && repNodeAt(rep) is RClosure { bundleResultPickOf(ix, rhs.caCallee, ibFnIx) } else { noPick() }
        if pk.bpField >= 0 && pk.bpTy >= 0 && repNodeOfTy(pk.bpTy) == rep {
          const rec = irBLetTempTy(b, rhs, ix, sr, repTyOf(sr))
          return irBLetTempTy(
            b,
            { rkV: rec, rkAt: ix, rkFe: rhs.caCallee },
            ix,
            rep,
            pk.bpTy,
          )
        }
        // A result legacy stores as the destination's valtype (`repStoresAs`: a held closure, a
        // ref-element list) is left as it stands, as at an argument or a global.
        if repStoresAs(rep, sr) { return irBLetTemp(b, rhs, ix, rep) }
        // Any other call is built at the callee's rep: legacy's direct call writes the value the
        // callee returns as it stands, and the call's consumer meets that rep.
        return irBLetTempTy(b, rhs, ix, sr, calleeResultTyAt(rhs.caCallee, sr))
      }
    }
    return irBLetTemp(b, rhs, ix, rep)
  }
  if n is Index { return irIndexHook(b, ix, rep) }
  if n is Member { return irMemberHook(b, ix, rep) }
  if n is StrLit { return strLit(ix, rep) }
  if n is ArrayLit {
    // An open built type is the type of the rep it is built at (`openArrLitRep`).
    const abt = arrLitBuiltTyOf(ix, ibFnIx)
    const bt = if ar >= 0 && (abt < 0 || irTyOpen(abt)) { repTyOf(rep) } else { abt }
    return arrayLit(b, n, ix, rep, arrLitListBuild(ix, ibFnIx), bt)
  }
  if n is CharLit {
    const cp = charLitCp(n)
    if cp < 0 || repPrim(rep) != "i32" { return irBMiss("char literal") }
    const c: Opnd = { oiRep: rep, oiBits: cp as i64 }
    return c
  }
  if n is IsExpr { return boxTest(b, n, ix, rep) }
  if n is IfStmt { return ifExpr(b, n, ix, rep) }
  if n is FuncDecl && repNodeAt(rep) is RClosure {
    return cloValue(b, ix, rep, heldTy(exprTyOf(ix)))
  }
  if n is AsExpr {
    const arm = asCastArmOf(ix, ibFnIx)
    if arm == "zextLoad" { return zextLoadRead(b, ix, rep) }
    if arm == "union" { return asUnion(b, n, ix, rep) }
    if arm == "litAtom" || arm == "numLitScalar" {
      return asLit(b, n, ix, rep, arm)
    }
    if arm == "numUnion" { return asNumUnion(b, n, ix, rep) }
    if arm == "mapOptBox" { return asMapOptBox(b, n, ix, rep) }
    // `m[k] as? V` over a read already at `V | null` is the read itself (`emitAsCast`).
    if arm == "mapOptRead" {
      const v = irBExpr(b, n.asObj)
      if ibMiss != "" { return v }
      if irBOpRep(v) != rep { return irBMiss("map read cast rep") }
      return v
    }
    if arm == "mapProbeTrap" { return asMapProbeTrap(b, n, ix, rep) }
    if arm == "instMiss" && n.asMode == "null" {
      return asInstMissOpt(b, n, ix, rep)
    }
    if arm == "instMiss" { return asInstMissEnd(b, n, ix, rep) }
    if arm == "holeMiss" { return asHoleMiss(b, n, ix, rep) }
    if arm == "holeOpt" && holeOptShapeOf(ix, ibFnIx) == "null" {
      return asHoleOptNull(b, ix, rep)
    }
    if arm == "holeOpt" && holeOptShapeOf(ix, ibFnIx) == "box" {
      return asHoleOptBox(b, n, ix, rep)
    }
    if arm == "wrap" {
      const wa = asWrapArmOf(ix, ibFnIx)
      if wa == "narrowMask" { return wrapNarrowed(b, ix, rep) }
      if wa == "litFold" { return wrapLit(b, n, ix, rep) }
    }
    return asCast(b, n, ix, rep)
  }
  if n is ObjLit { return objLit(b, ix, rep) }
  if n is OptMember { return optRead(b, n, ix, rep) }
  // A `null` literal at the `null` unit, naming no null of its own, is the bottom ref, as legacy's
  // `emitNullAt` writes it.
  if (
    n is NullLit
    && repPrim(rep) == "null"
    && nullOwnAt(ix, ibFnIx) == NULL_OWN_NONE
  ) {
    return repTemp(b, { nuAt: ix, nuOwn: NULL_OWN_NONE, nuRead: [] }, ix, rep)
  }
  return irBMiss("expression " + irAstKind(ix))
}

// A cast over a union box by legacy's tag test, or its element test across list reps
// (`asUnionTagWhy` names the other lowerings): the box, then the test and tail at the cast's rep. `as?`'s valued `if` takes its value from the
// stack, so no temp an operand before it built may wait there.
function asUnion(b: i32[], n: AsExpr, ix: i32, rep: i32): Opnd {
  const why = asUnionTagWhy(ix, ibFnIx)
  if why == "niche" { return asNiche(b, n, ix, rep) }
  if why != "" && why != "list across reps" && why != "literal union" {
    return irBMiss("union cast " + why)
  }
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  if rep != repNodeOfTy(ty) { return irBMiss("union cast result rep") }
  const v = irBExpr(b, n.asObj)
  if ibMiss != "" { return v }
  if !(repNodeAt(irBOpRep(v)) is RBox) && !boxedNullable(irBOpRep(v)) {
    return irBMiss("union cast operand rep")
  }
  return irBLetTemp(b, { auV: v, auAt: ix }, ix, rep)
}

// An infallible `as` over a numeric union's box (`asCastArmOf`'s `numUnion`), as
// `emitNumUnionConvert` writes it: the box, converted at the member it holds (`RNumUnionConvert`).
function asNumUnion(b: i32[], n: AsExpr, ix: i32, rep: i32): Opnd {
  const dk = numKindOf(rep)
  if dk < 3 { return irBMiss("numeric union cast rep") }
  if !numUnionSideBoxed(n.asObj, ibFnIx) {
    return irBMiss("numeric union cast unboxed")
  }
  const v = irBExpr(b, n.asObj)
  if ibMiss != "" { return v }
  if !(repNodeAt(irBOpRep(v)) is RBox) {
    return irBMiss("numeric union cast operand rep")
  }
  return irBLetTempTy(
    b,
    { nuV: v, nuTo: dk, nuAt: n.asObj },
    ix,
    rep,
    repTyOf(rep),
  )
}

// `m[k] as? V` over a scalar-valued map (`asCastArmOf`'s `mapOptBox`): the box plan's boxed read
// (`emitMapGetScalarBox`), the value's box on a hit and its null on a miss.
function asMapOptBox(b: i32[], n: AsExpr, ix: i32, rep: i32): Opnd {
  const mk = mapReadScalarBoxKindIn(n.asObj, ibFnIx)
  if mk < 0 || !boxedNullable(rep) { return irBMiss("map cast box rep") }
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  return mapGetAt(b, unwrapParen(n.asObj), rep, mk, true, ty, false, false)
}

// `m[k] as! V` over a scalar-valued map (`asCastArmOf`'s `mapProbeTrap`), as `emitAsMapProbeTrap`
// writes it: the probe, a trap on a missing key, then the stored value at the map's value rep.
function asMapProbeTrap(b: i32[], n: AsExpr, ix: i32, rep: i32): Opnd {
  const rd = unwrapParen(n.asObj)
  if rd < 0 || rd >= P.nodes.length || !(nodeAt(rd) is Index) {
    return irBMiss("map cast trap read")
  }
  if repPrim(rep) == null { return irBMiss("map cast trap rep") }
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  return mapGetAt(b, rd, rep, -1, false, ty, true, false)
}

// `as?` at an instance whose operand it can never hit (`asCastArmOf`'s `instMiss`), as
// `emitAsInstMiss` writes it: the operand evaluated and dropped, then the cast's null.
function asInstMissOpt(b: i32[], n: AsExpr, ix: i32, rep: i32): Opnd {
  const own = asInstMissNullOwn(ix)
  if !nullOwnRepFits(own, rep) { return irBMiss("cast miss null rep") }
  const v = irBExpr(b, n.asObj)
  if ibMiss != "" { return v }
  irBNode(b, { dpV: v }, -1, ibNoValue, ix)
  return repTemp(b, { nuAt: ix, nuOwn: own, nuRead: [] }, ix, rep)
}

// `as!` or a bare `as` at an instance whose operand it can never hit, as `emitAsInstMiss` writes
// them: `as!` drops the operand and traps, `as` returns it as the remainder. Nothing reaches the
// cast's own value (`RDeadNever`, whose `unreachable` is `as!`'s trap).
function asInstMissEnd(b: i32[], n: AsExpr, ix: i32, rep: i32): Opnd {
  if n.asMode == "trap" {
    const v = irBExpr(b, n.asObj)
    if ibMiss != "" { return v }
    irBNode(b, { dpV: v }, -1, ibNoValue, ix)
  } else {
    const v = retDelivered(b, n.asObj)
    if ibMiss != "" { return v }
    irBNode(b, { rtHas: true, rtV: v }, -1, ibNoValue, ix)
  }
  return irBLetTempTy(b, { dnAt: ix, dnPad: false }, ix, rep, TY_NEVER)
}

// `u as! N` or a bare `u as N` over a type parameter pinned at no number (`holeMiss`), as
// `emitHoleNumCastMiss` writes it: the operand dropped, then `as!`'s report and trap, or `as`
// returning the function's own null. Nothing reaches the cast's value (`RDeadNever`).
function asHoleMiss(b: i32[], n: AsExpr, ix: i32, rep: i32): Opnd {
  if n.asMode != "trap" && n.asMode != "prop" {
    return irBMiss("hole cast mode")
  }
  const v = irBExpr(b, n.asObj)
  if ibMiss != "" { return v }
  irBNode(b, { dpV: v }, -1, ibNoValue, ix)
  if n.asMode == "trap" {
    irBNode(
      b,
      { srOp: "as.fail", srHeap: -1, srArgs: [], srImm: ix },
      -1,
      ibNoValue,
      ix,
    )
  } else {
    const nn = numCastNullNode(ix)
    if nn < 0 { return irBMiss("as miss null") }
    const r = retDelivered(b, nn)
    if ibMiss != "" { return r }
    irBNode(b, { rtHas: true, rtV: r }, -1, ibNoValue, ix)
  }
  return irBLetTempTy(b, { dnAt: ix, dnPad: false }, ix, rep, TY_NEVER)
}

// `u as? N` over a type parameter pinned at no number or `boolean` (`holeOptShapeOf`'s "null"):
// the null-tagged box, as `emitHoleNumAsOpt` writes it, the operand never read.
function asHoleOptNull(b: i32[], ix: i32, rep: i32): Opnd {
  if !nullOwnRepFits(NULL_OWN_BOX, rep) { return irBMiss("cast miss null rep") }
  return repTemp(b, { nuAt: ix, nuOwn: NULL_OWN_BOX, nuRead: [] }, ix, rep)
}

// `u as? N` over a type parameter whose cast cannot fail at its pin (`holeOptShapeOf`'s "box"):
// the plain cast (`numCast`), boxed under the tag legacy writes ahead of it (`RHoleOptBox`).
function asHoleOptBox(b: i32[], n: AsExpr, ix: i32, rep: i32): Opnd {
  if !nullOwnRepFits(NULL_OWN_BOX, rep) { return irBMiss("cast box rep") }
  const st = holeOptBoxScalarTy(ix)
  if st < 0 { return irBMiss("cast box scalar") }
  const v = numCast(b, n, ix, repNodeOfTy(st), st)
  if ibMiss != "" { return v }
  return irBLetTemp(b, { hxV: v, hxAt: ix }, ix, rep)
}

// `((y >>> k) & m) as% i32` narrowed to i32 (`asWrapArmOf`'s `narrowMask`), as legacy's
// `srEmitNarrowed` writes `srWrappedMask`'s [y, k, 1, m]: `shiftMaskFold`'s form with no outer shift.
function wrapNarrowed(b: i32[], ix: i32, rep: i32): Opnd {
  const f = srWrappedMask(ix, ibFnIx)
  if f.length != 4 { return irBMiss("wrap narrowed mask") }
  return shiftMaskFold(b, [f[0], f[1], f[2], f[3], -1], 32, ix, rep)
}

// An integer literal under `as%` (`asWrapArmOf`'s `litFold`), as `emitNumWrapLit` writes it: the
// 32-bit constant its text denotes (`parseI64Pair`'s low word), then the byte mask at `u8`.
function wrapLit(b: i32[], n: AsExpr, ix: i32, rep: i32): Opnd {
  const lit = nodeAt(unwrapParen(n.asObj))
  if !(lit is NumLit) || repPrim(rep) != "i32" {
    return irBMiss("wrap literal rep")
  }
  const c: Opnd = { oiRep: rep, oiBits: parseI64Pair(lit.numText)[1] as i64 }
  if asExprNumCastDomain(ix) != "u8" { return c }
  const m: Opnd = { oiRep: rep, oiBits: 255 }
  return irBLetTemp(b, { poOp: "and", poArgs: [c, m] }, ix, rep)
}

// A literal-union cast (`asCastArmOf`'s `litAtom` and `numLitScalar` arms), as legacy writes it:
// the operand by its own `emitExpr`, then the staged member test and tail (`RAsTail`), at the
// cast's own rep. A cast legacy refuses (`asLitAtomWhy`, `asNumLitScalarWhy`) is left to it.
function asLit(b: i32[], n: AsExpr, ix: i32, rep: i32, arm: string): Opnd {
  const why = if arm == "litAtom" { asLitAtomWhy(ix, ibFnIx) } else { asNumLitScalarWhy(ix, ibFnIx) }
  // Each of these refusals is a contract on the cast as written, raised before the claim declines.
  if why != "" && emitSoftFail { emitFailAt(why, ix) }
  if why != "" { return irBMiss("literal cast refused") }
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  if rep != repNodeOfTy(ty) { return irBMiss("literal cast result rep") }
  const v = irBExpr(b, n.asObj)
  if ibMiss != "" { return v }
  const vr = irBOpRep(v)
  if !repIsScalar(vr) && !(repNodeAt(vr) is RAtom) {
    return irBMiss("literal cast operand rep")
  }
  return irBLetTemp(b, { akV: v, akAt: ix }, ix, rep)
}

// A cast over a niche-repped `T | null` operand, as `emitAsNulNiche` writes it: `as?` is the
// operand at its own rep, `as!` its `ref.as_non_null` (`RCast`), and the propagating `as` a block.
function asNiche(b: i32[], n: AsExpr, ix: i32, rep: i32): Opnd {
  const why = asNicheCastWhy(ix, ibFnIx)
  if why == "propagate" { return asNicheProp(b, n, ix, rep) }
  if why == "one list" { return asOneList(b, n, ix, rep) }
  if why != "" { return irBMiss("union cast niche " + why) }
  const v = irBExpr(b, n.asObj)
  if ibMiss != "" { return v }
  const vr = irBOpRep(v)
  if n.asMode == "null" {
    if vr != rep { return irBMiss("union cast niche rep") }
    return v
  }
  const vn = repNodeAt(vr)
  if (
    !(vn is RNullable)
    || vn.rnInner != rep
    || !refNullable(vr) && !strNullable(vr)
  ) {
    return irBMiss("union cast niche rep")
  }
  return irBLetTemp(b, { ctV: v, ctTarget: rep, ctOnFail: "trap" }, ix, rep)
}

// A cast over a union of lists stored as its one list (`asNicheCastWhy`'s "one list"), as
// `emitAsOneListCast` writes it: the list, then legacy's fit and miss at the cast's own rep.
function asOneList(b: i32[], n: AsExpr, ix: i32, rep: i32): Opnd {
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  if rep != repNodeOfTy(ty) { return irBMiss("union cast one list result rep") }
  if n.asMode == "null" && endsInTemp(b) {
    return irBMiss("union cast after an operand")
  }
  const v = irBExpr(b, n.asObj)
  if ibMiss != "" { return v }
  const vn = repNodeAt(irBOpRep(v))
  const inner = if vn is RNullable { repNodeAt(vn.rnInner) } else { vn }
  if !(inner is RList) { return irBMiss("union cast one list operand rep") }
  return irBLetTemp(b, { auV: v, auAt: ix }, ix, rep)
}

// The propagating `as` over a niche-repped `T | null` operand: the operand built inside the block,
// whose null path returns the function's null (`RRetNull`) and leaves legacy's `unreachable`.
function asNicheProp(b: i32[], n: AsExpr, ix: i32, rep: i32): Opnd {
  if asPropNicheHeapOf(n.asObj, ibFnIx) < 0 {
    return irBMiss("union cast niche propagate heap")
  }
  if nullRetPlanOf(ibFnIx) == null {
    return irBMiss("union cast niche propagate null plan")
  }
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  const lb: i32[] = []
  const l = irBExpr(lb, n.asObj)
  if ibMiss != "" { return l }
  if !(l is OVar) || l.ov < 0 { return irBMiss("union cast niche operand") }
  const vr = irBOpRep(l)
  const vn = repNodeAt(vr)
  if (
    !(vn is RNullable)
    || vn.rnInner != rep
    || !refNullable(vr) && !strNullable(vr)
  ) {
    return irBMiss("union cast niche rep")
  }
  const nb: i32[] = []
  const r: Rhs = { rnrAt: ix }
  const rt = irBLetTempTy(nb, r, ix, ib.irRetRep, ib.irRetTy)
  irBNode(nb, { rtHas: true, rtV: rt }, -1, ibNoValue, ix)
  irBNode(nb, { tpWhy: 0 }, -1, ibNoValue, ix)
  const t = irVarNew(ib, rep, ty, "local", -1)
  const arm: CoalValArm = "asProp"
  irBNode(
    b,
    { cbL: l, cbLB: lb, cbArm: arm, cbNull: nb, cbOut: t, cbAt: ix, cbMap: null },
    ty,
    rep,
    ix,
  )
  const o: Opnd = { ov: t }
  return o
}

// An `as` at a `v128` rep over a `v128` operand re-brands the same bits, which legacy writes as
// the operand alone (`asCastArmOf`'s `v128` arm, or its `plain` arm at a `new v128` target);
// any other `as` is numeric.
function asCast(b: i32[], n: AsExpr, ix: i32, rep: i32): Opnd {
  if repPrim(rep) != "v128" { return numCast(b, n, ix, rep, -1) }
  const arm = asCastArmOf(ix, ibFnIx)
  if arm != "v128" && arm != "plain" { return irBMiss("vector as " + arm) }
  const v = irBExpr(b, n.asObj)
  if ibMiss != "" { return v }
  if irBOpRep(v) != rep { return irBMiss("vector as operand rep") }
  return v
}

// A numeric `as` whose arm legacy writes as its operand at one kind then a tail
// (`numCastKindOf`): the operand is built and widened to that kind as `emitExprAsKind` builds it.
function numCast(b: i32[], n: AsExpr, ix: i32, rep: i32, ty: i32): Opnd {
  const k = numCastKindOf(ix, ibFnIx)
  if k < 0 { return irBMiss("expression as " + asCastArmOf(ix, ibFnIx)) }
  const ow = operandWhy(n.asObj)
  if ow != "" { return irBMiss(ow) }
  const v = irBExpr(b, n.asObj)
  if ibMiss != "" { return v }
  const dst = if k == 0 { irBOpRep(v) } else { repNodeOfTy(numCastKindTy(k)) }
  if k != 0 {
    const p = widenPlanOf(n.asObj, k, ibFnIx)
    if (
      p.wpArm != "plain"
      && !(litWidenArm(p.wpArm) && isSignedNumLit(n.asObj))
    ) {
      return irBMiss("widen " + p.wpArm)
    }
  }
  const o = if k >= 3 && repPrim(irBOpRep(v)) == "bool" { boolWiden(b, v, n.asObj, dst, k) } else { widenTo(b, v, n.asObj, dst, -1) }
  if ibMiss != "" { return o }
  if irBOpRep(o) != dst || !repIsScalar(dst) {
    return irBMiss("as operand coercion")
  }
  const miss = numCastMiss(b, n, ix)
  if ibMiss != "" { return miss }
  if ty >= 0 {
    return irBLetTempTy(b, { ncV: o, ncAt: ix, ncMiss: miss }, ix, rep, ty)
  }
  return irBLetTemp(b, { ncV: o, ncAt: ix, ncMiss: miss }, ix, rep)
}

// A `boolean` cast operand `v` at node `ix` widened to kind `k` at rep `dst` as the i32 0 or 1
// it holds, along legacy's plain plan from an i32 (`numPlainCastKind` reads it as one).
function boolWiden(b: i32[], v: Opnd, ix: i32, dst: i32, k: i32): Opnd {
  const p = widenPlanOf(ix, k, ibFnIx)
  if p.wpArm != "plain" || p.wpSrc != 1 {
    return irBMiss("widen boolean " + p.wpArm)
  }
  return irBLetTempTy(
    b,
    { nwV: v, nwSrc: 1, nwDst: k, nwAt: ix },
    ix,
    dst,
    repTyOf(dst),
  )
}

// The null a bare exact `as` at `ix` returns on its sad path, the function's own, as legacy's
// `numExactCastTail` returns it (`emitReturnValue`); `ov` -1 for any other cast. It builds only
// temps, which the sad path writes where it reads them.
function numCastMiss(b: i32[], n: AsExpr, ix: i32): Opnd {
  const none: Opnd = { ov: -1 }
  if n.asMode != "prop" || numCastExactSrc(ix, ibFnIx) == "" { return none }
  const nn = numCastNullNode(ix)
  if nn < 0 { return irBMiss("as miss null") }
  const m0 = b.length
  const v = retDelivered(b, nn)
  if ibMiss != "" { return v }
  if irBOpRep(v) != ib.irRetRep || !onlyTempsFrom(b, m0) {
    return irBMiss("as miss value")
  }
  return v
}

// Legacy's strength-reduced masked shift (`shiftMaskFoldOf`'s [x, k, narrow, m, j]): x at the
// fold's width, then the shift netting `k` against `j` and the mask `m << j`, both constants, as
// `emitShiftMaskFold` writes them.
function shiftMaskFold(b: i32[], f: i64[], w: i32, ix: i32, rep: i32): Opnd {
  const ir = repNodeOfTy(if w == 64 { numCastKindTy(3) } else { TY_I32 })
  if rep != ir { return irBMiss("shift-mask fold rep") }
  const x = f[0] as% i32
  const ow = operandWhy(x)
  if ow != "" { return irBMiss(ow) }
  let v = irBExpr(b, x)
  if ibMiss != "" { return v }
  if w == 64 {
    const p = widenPlanOf(x, 3, ibFnIx)
    if p.wpArm != "plain" && !(litWidenArm(p.wpArm) && isSignedNumLit(x)) {
      return irBMiss("widen " + p.wpArm)
    }
    v = widenTo(b, v, x, ir, -1)
    if ibMiss != "" { return v }
  }
  // A narrowing source (an i64 read at width 32) is legacy's `srPushSource`: the source at i64,
  // then `i32.wrap_i64`.
  if f[2] == 1 && irBOpRep(v) != ir {
    const w64 = repNodeOfTy(numCastKindTy(3))
    const p = widenPlanOf(x, 3, ibFnIx)
    if p.wpArm != "plain" && !(litWidenArm(p.wpArm) && isSignedNumLit(x)) {
      return irBMiss("widen " + p.wpArm)
    }
    const v64 = widenTo(b, v, x, w64, -1)
    if ibMiss != "" { return v64 }
    if irBOpRep(v64) != w64 {
      return irBMiss("shift-mask fold narrowing source")
    }
    v = irBLetTempTy(
      b,
      { nwV: v64, nwSrc: 3, nwDst: 1, nwAt: x },
      x,
      ir,
      TY_I32,
    )
    if ibMiss != "" { return v }
  }
  if irBOpRep(v) != ir { return irBMiss("shift-mask fold narrowing source") }
  const k = f[1]
  // The narrowing form `(y >>> k) as% i32 & m` has no outer shift: `srEmitNarrowed`'s j of 0.
  const j = if f[4] < 0 { 0 } else { f[4] }
  let s = v
  if k != j {
    const by: Opnd = { oiRep: ir, oiBits: if k > j { k - j } else { j - k } }
    const op: PrimOp = if k > j { "shru" } else { "shl" }
    s = irBLetTemp(b, { poOp: op, poArgs: [v, by] }, ix, ir)
  }
  const mj = f[3] << j
  const m: Opnd = {
    oiRep: ir,
    oiBits: if w == 64 { mj } else { (mj as% i32) as i64 },
  }
  return irBLetTemp(b, { poOp: "and", poArgs: [s, m] }, ix, rep)
}

// `x?.f is K` over a record's box field `f` (`ROptRead` with a tag), as legacy's `optField` arm writes
// it: an unstaged base `x` that owes no recover, a variable read twice.
function optFieldTest(b: i32[], n: IsExpr, ix: i32, rep: i32): Opnd {
  const om = unwrapParen(n.isObj)
  if om < 0 || om >= P.nodes.length { return irBMiss("is optional field node") }
  const m = nodeAt(om)
  if !(m is OptMember) { return irBMiss("is optional field node") }
  const base = unwrapParen(m.omObj)
  if base < 0 || base >= P.nodes.length || nodeAt(base) is OptMember {
    return irBMiss("is optional field chain")
  }
  if optChainStagesRecv(om) || optChainStagesRecv(m.omObj) {
    return irBMiss("is optional field staged")
  }
  if readOwesNonNullRecover(m.omObj, ibFnIx) {
    return irBMiss("is optional field recover")
  }
  const tag = isArmTagOf(ix, n, ibFnIx)
  if tag < 0 { return irBMiss("is optional field tag") }
  const v = irBExpr(b, m.omObj)
  if ibMiss != "" { return v }
  if !(v is OVar) || v.ov < 0 || ib.irVars[v.ov].vKind == "temp" {
    return irBMiss("is optional field base")
  }
  return irBLetTemp(b, { orV: v, orAt: ix, orTag: tag }, ix, rep)
}

// A standalone `?.` over an unstaged chain (`ROptRead`), as `emitOptMemberValueGo` writes it along
// `optLeafArmOf`: the chain's root is a read the lowering writes again, owing no recover, and the
// lowering walks its links (`emitOptChainIsNull`, `emitOptChainValue`).
function optRead(b: i32[], n: OptMember, ix: i32, rep: i32): Opnd {
  if exprIsNulNone(ix, ibFnIx) { return irBMiss("optional read of null") }
  if optLeafArmOf(ix, ibFnIx) == "fail" { return irBMiss("optional read arm") }
  const base = optChainRootOf(n.omObj)
  if base < 0 || base >= P.nodes.length {
    return irBMiss("optional read chain")
  }
  // A root legacy stages into its `?.` stash (`optChainStagesRecv`) is read once and teed there.
  const staged = optChainStagesRecv(ix)
  if readOwesNonNullRecover(base, ibFnIx) {
    return irBMiss("optional read recover")
  }
  const ty = outTyOf(ix, rep)
  if ibTyOpen(ty, rep) { return irBMiss("open temp type") }
  if rep != repNodeOfTy(ty) { return irBMiss("optional read rep") }
  const r = irBExpr(b, base)
  if ibMiss != "" { return r }
  if !(r is OVar) || r.ov < 0 { return irBMiss("optional read base") }
  // Legacy reads an unstaged root again after each null test, so a temp's read must re-read alike.
  if !staged && ib.irVars[r.ov].vKind == "temp" && !recvReadsAgain(base) {
    return irBMiss("optional read base")
  }
  const o: ROptRead = { orV: r, orAt: ix, orTag: -1 }
  // A staged read is not written again whole: its stash holds what a later chain stages.
  if !staged { ib.irReadOpt[ix] = o }
  return irBLetTempTy(b, o, ix, rep, ty)
}

// The root of the `?.` chain whose receiver is `x`: the first node below its links, unparenthesized;
// a link off no struct chain (`optChainStructIdxOf`) answers -1.
function optChainRootOf(x: i32): i32 {
  let u = unwrapParen(x)
  while u >= 0 && u < P.nodes.length {
    const m = nodeAt(u)
    if !(m is OptMember) { return u }
    if optChainStructIdxOf(m.omObj, ibFnIx) < 0 { return -1 }
    u = unwrapParen(m.omObj)
  }
  return -1
}

// A string literal at the `str` rep, or delivered as its destination's interned atom.
function strLit(ix: i32, rep: i32): Opnd {
  if strLitTakesAtom(ix, ibFnIx) {
    const ar = repNodeOfTy(ctxTyAt(ix, ibFnIx))
    // At a `K | null` the literal is its member's id, which the niche holds as is (`RRetag`).
    const an = repNodeAt(ar)
    const at = if an is RNullable && an.rnDisc == 3 { an.rnInner } else { ar }
    if !(repNodeAt(at) is RAtom) { return irBMiss("string atom") }
    const a: Opnd = { osAt: ix, osRep: at }
    return a
  }
  if repPrim(rep) != "str" { return irBMiss("string literal rep") }
  const o: Opnd = { osAt: ix, osRep: rep }
  return o
}

function assign(b: i32[], n: BinExpr, ix: i32) {
  // Legacy appends a string in place at a local and at a list element alike; a site's chain
  // must be the right side the store delivers.
  const mode = irInPlaceHook(ix, ibFnIx)
  if mode < 0 { return accAppend(b, n, ix) }
  const n0 = ib.irNodes.length
  assignTo(b, n, ix)
  if ibMiss == "" && mode > 0 && !siteBuilt(n0, ix) {
    return skip("string append site")
  }
  return 0
}

// A proven accumulator append: the chain's parts after the accumulator, then legacy's tail,
// which reads, grows and writes the accumulator itself.
function accAppend(b: i32[], n: BinExpr, ix: i32) {
  const parts = strCatPartsOf(n.binRight, ibFnIx)
  const args: Opnd[] = []
  const starts: i32[] = []
  const ixs: i32[] = []
  let i = 1
  while i < parts.length {
    const from = b.length
    const a = irBExpr(b, parts[i])
    if ibMiss != "" { return 0 }
    if args.length > 0 && !irBStageLeads(b, from, starts, args, ixs) {
      return skip("string operand after another")
    }
    starts.push(from)
    ixs.push(parts[i])
    if repPrim(irBOpRep(a)) != "str" { return skip("string operand coercion") }
    args.push(a)
    i = i + 1
  }
  const r: Rhs = { soOp: "acc", soArgs: args, soAt: ix }
  irBNode(b, { efRhs: r }, -1, ibNoValue, ix)
  return 0
}

// Whether a node from `n0` on joins site `ix`'s chain (`buildStrBin`'s `str.site`).
function siteBuilt(n0: i32, ix: i32): boolean {
  let i = n0
  while i < ib.irNodes.length {
    const nd = ib.irNodes[i]
    if nd is SLet {
      const r = nd.lRhs
      if r is RStrOp && r.soOp == "site" && r.soAt == ix { return true }
    }
    i = i + 1
  }
  return false
}

// An assignment as a value that legacy re-reads (`asgValueArmOf` "reRead"): the store, then the
// target's read. A guarded global's read misses, so the guard-off context
// legacy re-reads in reads it as the builder's own does.
function assignValue(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  if nodeAt(n.binLeft) is Ident { ibStubRhs = unwrapParen(n.binRight) }
  // The nodes it builds are its span, which a box leading its value is written ahead of.
  const b0 = b.length
  const o = assignValueGo(b, n, ix, rep)
  tagSpanNote(b, b0, ix)
  return o
}

function assignValueGo(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const arm = asgValueArmOf(ix, ibFnIx)
  if arm == "lit" { return assignValueLit(b, n, ix, rep) }
  if arm == "nullLit" { return assignValueNullLit(b, n, ix, rep) }
  if arm == "parked" { return assignValueParked(b, n, ix, rep) }
  if arm == "boxedArm" { return assignValueBoxedArm(b, n, ix, rep) }
  if arm == "widerRow" { return assignValueWider(b, n, ix, rep) }
  // An assignment whose type no arm delivers is refused by contract, not declined as a gap.
  if arm == "none" && emitSoftFail {
    emitFailAt(
      "emitProgram: an assignment used as a value whose type is not its target's has no value lowering",
      ix,
    )
  }
  if arm != "reRead" { return irBMiss("assignment value " + arm) }
  // The store between an operand already built and the box's re-read would put that operand out of
  // stack order, as `assignValueLit`'s would.
  if asgBoxRep(ix) >= 0 && endsInTemp(b) {
    return irBMiss("assignment value box after an operand")
  }
  // A value narrower than its cell is re-read at the cell's rep, then narrowed back by the one
  // opcode legacy writes (`asgReadUnwidenOp`).
  const uw = asgReadUnwidenOp(ix, ibFnIx)
  const t = nodeAt(n.binLeft)
  if !(t is Ident || t is Member || t is Index) {
    return irBMiss("assignment value target")
  }
  assignTo(b, n, ix)
  if ibMiss != "" { return irBMiss(ibMiss) }
  const m = asgReReadEnter(ix)
  // A field or element target is read again whole, its receiver and index included. A global's
  // or an atom local's re-read is seated (`cell`): its cell's id is the read `widenTo` decodes.
  const rr = if uw >= 0 { repNodeOfTy(heldTy(exprTyOf(n.binLeft))) } else { rep }
  const seat = if uw >= 0 { globalTarget(n.binLeft) } else { asgReReadSeated(n.binLeft) }
  const o = if t is Ident { identRead(b, t, n.binLeft, rr, seat) } else { irBExpr(b, n.binLeft) }
  asgReReadLeave(m)
  if uw >= 0 {
    if ibMiss != "" { return o }
    // A re-read the checker already narrowed past null is recovered, and legacy's cast after it
    // has no nullable to narrow.
    if uw == 212 && !(repNodeAt(irBOpRep(o)) is RNullable) {
      return irBMiss("assignment value unwiden of a recovered read")
    }
    return irBLetTemp(b, { uwV: o, uwOp: uw, uwAt: ix }, ix, rep)
  }
  // The cell's atom re-read at a `string` assignment is decoded, as legacy widens it (`widenTo`),
  // a local `K | null` cell's included: the assigned member is no `null` (`atomToStr` checks).
  const r0 = irBOpRep(o)
  const nulLocal = t is Ident && !globalTarget(n.binLeft) && atomNullable(r0)
  const dec = atomAtStr(r0, rep) || nulLocal && repPrim(rep) == "str"
  const w = if ibMiss == "" && dec { widenTo(b, o, ix, rep, -1) } else { o }
  // A closure re-read where the assignment's type leaves a closure part open, or fills one, is
  // the same closure struct, retagged, as a closure cell's read is.
  if (
    ibMiss == ""
    && irBOpRep(w) != rep
    && repNodeAt(irBOpRep(w)) is RClosure
    && holeRetagNoted(irBOpRep(w), rep, true)
  ) {
    return irBLetTemp(b, { rgV: w }, ix, rep)
  }
  if ibMiss == "" && irBOpRep(w) != rep {
    return irBMiss("assignment value re-read rep")
  }
  return w
}

// An assignment as a value its element store, struct field store or map set parks
// (`asgValueArmOf` "parked"): the store (a field's or a map's marked to park), then the slot read
// back (`RAsgParked`). A field of a kind no scratch local holds is a named miss.
function assignValueParked(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const t = nodeAt(n.binLeft)
  if t is Member && !asgFieldParks(ix, ibFnIx) {
    return irBMiss("assignment value parked field")
  }
  if !(t is Index) && !(t is Member) {
    return irBMiss("assignment value parked target")
  }
  const src = parkedStore(b, n, ix)
  if ibMiss != "" { return irBMiss(ibMiss) }
  const sn = repNodeAt(src)
  // A value narrower than its slot is narrowed back by the one opcode legacy writes after it.
  const uw = asgReadUnwidenOp(ix, ibFnIx)
  if uw >= 0 {
    if sn is RNullable { return irBMiss("assignment value parked unwiden") }
    const p = irBLetTemp(b, { apAt: ix }, ix, src)
    return irBLetTemp(b, { uwV: p, uwOp: uw, uwAt: ix }, ix, rep)
  }
  if src != rep && !(sn is RNullable && sn.rnInner == rep) {
    return irBMiss("assignment value parked rep")
  }
  return irBLetTemp(b, { apAt: ix }, ix, rep)
}

// Assignment `ix`'s store built into `b`, a field's or a map's marked to park its value; the rep
// the store holds the value at (a miss where the store is none of those).
function parkedStore(b: i32[], n: BinExpr, ix: i32): i32 {
  const at = b.length
  assignTo(b, n, ix)
  if ibMiss != "" { return -1 }
  const last = if b.length > at { ib.irNodes[b[b.length - 1]] } else { null }
  const ms = if last is SEffect { last.efRhs } else { null }
  if !(last is SListSet) && !(last is SSetField) && !(ms is RMapSet) {
    irBMiss("assignment value parked store")
    return -1
  }
  if last is SSetField { last.sfPark = true }
  if ms is RMapSet { ms.msPark = true }
  return if last is SListSet { irBOpRep(last.lsSrc) } else if last is SSetField { irBOpRep(last.sfSrc) } else if ms is RMapSet { irBOpRep(ms.msVal) } else { -1 }
}

// An assignment as a value its element store or map set parks as a union box (`asgValueArmOf`
// "boxedArm"): the box read back and recovered (`RAsgParked`), then unboxed to the value's arm
// (`RBoxNarrow`), as `emitAsgValueOf` writes it.
function assignValueBoxedArm(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  if !(nodeAt(n.binLeft) is Index) {
    return irBMiss("assignment value boxedArm target")
  }
  const tag = boxTagOfTy(nodeTyAt(ix, ibFnIx))
  if tag < 0 { return irBMiss("assignment value boxedArm tag") }
  const src = parkedStore(b, n, ix)
  if ibMiss != "" { return irBMiss(ibMiss) }
  if !(repNodeAt(src) is RBox) {
    return irBMiss("assignment value boxedArm rep")
  }
  const p = irBLetTempTy(b, { apAt: ix }, ix, src, repTyOf(src))
  return irBLetTemp(
    b,
    { bnV: p, bnAt: ix, bnRep: rep, bnAtom: tag, bnCon: -1 },
    ix,
    rep,
  )
}

// An assignment as a value whose name's record the right side's wider record extends
// (`asgValueArmOf` "widerRow"): the store, the name re-read at its own record, then cast to the
// wider row (`RRecDown`), as `emitAsgValueOf` writes it (D16105).
function assignValueWider(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  const t = nodeAt(n.binLeft)
  if !(t is Ident) { return irBMiss("assignment value widerRow target") }
  if !(repNodeAt(rep) is RRecord) {
    return irBMiss("assignment value widerRow rep")
  }
  assignTo(b, n, ix)
  if ibMiss != "" { return irBMiss(ibMiss) }
  const m = asgReReadEnter(ix)
  const rr = repNodeOfTy(exprTyOf(n.binLeft))
  const o = identRead(b, t, n.binLeft, rr, asgReReadSeated(n.binLeft))
  asgReReadLeave(m)
  if ibMiss != "" { return o }
  return irBLetTemp(b, { rdV: o, rdAt: ix }, ix, rep)
}

// An assignment of `null` the checker types `null` (`asgValueArmOf` "nullLit"): the store, then
// the null its destination holds, as `emitAsgValueOf` writes it.
function assignValueNullLit(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  assignTo(b, n, ix)
  if ibMiss != "" { return irBMiss(ibMiss) }
  // The null is the assignment's own (`emitNullAt` at the assignment), not the cell's (D17090).
  const lit = unwrapParen(n.binRight)
  const own = nullOwnAt(ix, ibFnIx)
  // The `null` unit holds the bottom ref alone; an assignment whose own null is a typed one (a
  // string's, a sentinel) is not that value, so it misses rather than fail the verifier.
  if repPrim(rep) == "null" && own != NULL_OWN_NONE {
    return irBMiss("assignment value nullLit rep")
  }
  return repTemp(b, { nuAt: lit, nuOwn: own, nuRead: [] }, ix, rep)
}

// Whether `ix`, under any parentheses, is an assignment storing one member of a literal-union
// place, which legacy yields as the re-read atom (`asgLitUnionMemberReRead`).
function asgMemberReReadAt(ix: i32): boolean {
  const x = unwrapParen(ix)
  return x >= 0 && asgLitUnionMemberReRead(x, ibFnIx)
}

// Whether the re-read of assignment target `ix` is seated: a global, or a local already held at a
// cell of an atom or a `K | null`, which legacy's `emitExpr` reads as the cell's id. It asks the
// local the store just wrote, minting none: a captured cell is held elsewhere.
function asgReReadSeated(ix: i32): boolean {
  if globalTarget(ix) { return true }
  const d = identDeclOf(ix)
  if d < 0 || !(nodeAt(d) is LetDecl) { return false }
  const v = ibDeclVar[d] ?? -1
  return v >= 0
    && (repNodeAt(ib.irVars[v].vRep) is RAtom
    || atomNullable(ib.irVars[v].vRep))
}

// Whether identifier `ix` names a module global's `let`, not a local or a capture.
function globalTarget(ix: i32): boolean {
  const d = identDeclOf(ix)
  return d >= 0
    && nodeAt(d) is LetDecl
    && localIndexOf(ibFnIx, ix) < 0
    && globalIndexOfSid(sidOfNode(ix)) >= 0
}

// An assignment whose value is its right side's number literal (`asgValueArmOf` "lit"): the
// store, then that literal built again at the assignment's rep, as `emitAsgLitAs` writes it.
function assignValueLit(b: i32[], n: BinExpr, ix: i32, rep: i32): Opnd {
  assignTo(b, n, ix)
  if ibMiss != "" { return irBMiss(ibMiss) }
  return signedLitAt(unwrapParen(n.binRight), rep)
}

// The number literal at `lit`, under any parentheses and minus signs, as one immediate at rep
// `rep` (`emitSignedNumLitAt`): each minus negates it as the lowering folds a `neg` of one.
function signedLitAt(lit: i32, rep: i32): Opnd {
  const n = nodeAt(lit)
  if n is NumLit { return numLitAt(n, lit, rep) }
  if !(n is Unary) || n.unOp != "-" { return irBMiss("signed literal") }
  const a = signedLitAt(unwrapParen(n.unArg), rep)
  if !(a is OImm) { return a }
  const k: string = repPrim(rep) ?? ""
  const one: i64 = 1
  const bits = if k == "f64" { a.oiBits ^ (one << 63) } else if k == "f32" { a.oiBits ^ (one << 31) } else { 0 - a.oiBits }
  const o: Opnd = { oiRep: rep, oiBits: bits }
  return o
}

// Whether widen arm `a` writes its literal operand again at the destination (`widenLitAt`).
function litWidenArm(a: string): boolean {
  return a == "instLit" || a == "floatLit"
}

// Whether `ix` is a number literal under any parentheses and minus signs (`signedLitAt`'s shape).
function isSignedNumLit(ix: i32): boolean {
  const x = unwrapParen(ix)
  if x < 0 { return false }
  const n = nodeAt(x)
  if n is NumLit { return true }
  return n is Unary && n.unOp == "-" && isSignedNumLit(n.unArg)
}

// Whether `rhs` is a field or element write used as a value, which legacy writes into another
// store's value through its parked scratch frame.
function writesPlaceValue(rhs: i32): boolean {
  const x = unwrapParen(rhs)
  if x < 0 || x >= P.nodes.length { return false }
  const e = nodeAt(x)
  if !(e is BinExpr) || e.binOp != "=" { return false }
  const t = nodeAt(e.binLeft)
  return t is Member || t is Index
}

function assignTo(b: i32[], n: BinExpr, ix: i32) {
  const at = b.length
  if nodeAt(n.binLeft) is Ident { ibStubRhs = unwrapParen(n.binRight) }
  assignToGo(b, n, ix)
  siteArmNote(b, at, n, ix)
  return 0
}

// Notes the first node assignment `ix` built into `b` from `at`, where its right side is a `+`
// chain legacy's `strSiteArm` may arm as an append site.
function siteArmNote(b: i32[], at: i32, n: BinExpr, ix: i32) {
  if ibMiss != "" || b.length <= at { return 0 }
  const r = nodeAt(unwrapParen(n.binRight))
  if !(r is BinExpr) || r.binOp != "+" { return 0 }
  ib.irSiteArmAt[b[at]] = ix
  ib.irHasSiteArms = true
  return 0
}

function assignToGo(b: i32[], n: BinExpr, ix: i32) {
  if writesPlaceValue(n.binRight) {
    return skip("store of a field or element write")
  }
  const t = nodeAt(n.binLeft)
  if t is Index { return elemStore(b, n, t, ix) }
  if t is Member { return fieldStore(b, n, t, ix) }
  if !(t is Ident) { return skip("assignment target") }
  const d = identDeclOf(n.binLeft)
  const w = if d >= 0 { localIndexOf(ibFnIx, n.binLeft) } else { -1 }
  if w >= 0 {
    const lv = liftWriteVar(t.identName, w)
    const v = if lv >= 0 { lv } else { irBDeclVar(d) }
    if v < 0 { return skip("assignment coercion") }
    // Legacy declares a `null` local storing an assignment of `null` apart from the IR's locals.
    if (
      repPrim(ib.irVars[v].vRep) == "null"
      && asgYieldsNullLit(unwrapParen(n.binRight))
    ) {
      return skip("store of an assignment of null into a null local")
    }
    const sv = storeValue(b, n.binRight, ib.irVars[v].vRep, ix)
    if ibMiss != "" { return 0 }
    const src = irConvertStored(
      b,
      sv,
      ib.irVars[v].vRep,
      ib.irVars[v].vTy,
      n.binRight,
    )
    if ibMiss != "" { return 0 }
    irBNode(b, { asDst: v, asSrc: src }, -1, ibNoValue, ix)
    return 0
  }
  const g = globalIndexOfSid(sidOfNode(n.binLeft))
  if g < 0 || d < 0 { return skip("assignment target") }
  const val = storeValue(b, n.binRight, globalRep(g, d), ix)
  if ibMiss != "" { return 0 }
  const src = irConvertStored(
    b,
    val,
    globalRep(g, d),
    repTyOf(globalRep(g, d)),
    n.binRight,
  )
  if ibMiss != "" { return 0 }
  const gm = irGlobalWriteMiss(g, ibGlobalCtx())
  if gm != "" { return skip(gm) }
  irBNode(b, { gsSym: g, gsSrc: src }, -1, ibNoValue, ix)
  return 0
}

// Assignment `at`'s value `x` at its cell's rep `rep`: delivered, or into a `null` cell, run for its
// effect and then the bottom null at `at`, as legacy's `nulnone` store writes it
// (`emitNulNoneForEffect`).
function storeValue(b: i32[], x: i32, rep: i32, at: i32): Opnd {
  // An empty list literal holds no element to type it, so it is built at its cell's list, as legacy
  // writes it at the cell's type.
  const xu = unwrapParen(x)
  const xn = if xu >= 0 && xu < P.nodes.length { nodeAt(xu) } else { null }
  if xn is ArrayLit && xn.arrElems.length == 0 && repNodeAt(rep) is RList {
    return arrayLit(b, xn, xu, rep, arrLitListBuild(xu, ibFnIx), repTyOf(rep))
  }
  if repPrim(rep) != "null" { return deliver(b, x, rep, -1) }
  const e = nulNoneEffect(b, x, at, null)
  if ibMiss != "" { return e }
  return repTemp(b, { nuAt: at, nuOwn: NULL_OWN_NONE, nuRead: [] }, at, rep)
}

// A store through a box of list arms inside `is K[]` (`SArmWrite`): per arm, the store built over
// the arm's payload variable, the receiver read as it (`ibArmRecvVar`) and typed at the arm.
function elemArmWrite(b: i32[], n: BinExpr, t: Index, ix: i32) {
  if ibArmRecvVar >= 0 { return skip("store arm write nested") }
  const recv = unwrapParen(t.idxArr)
  if recv < 0 || recv >= P.nodes.length || !(nodeAt(recv) is Ident) {
    return skip("store arm write receiver")
  }
  const v = irBExpr(b, recv)
  if ibMiss != "" { return 0 }
  // Legacy reads the box again by its name at each arm: a variable's local, or a global the
  // lowering reads again (`irHoistRecv`).
  if (
    !(v is OVar)
    || v.ov < 0
    || ib.irVars[v.ov].vKind == "temp" && !recvReadsAgain(recv)
  ) {
    return skip("store arm write receiver")
  }
  const bodies: i32[][] = []
  const vars: i32[] = []
  for m in armIndexWriteArmsOf(t, ibFnIx) {
    const pr = repNodeOfTy(m)
    if pr < 0 { return skip("store arm write arm") }
    const pv = irVarNew(ib, pr, m, "local", -1)
    const ab: i32[] = []
    const mark = luOvEnter(recv, m)
    readRepMemoAdvance()
    ibArmRecvIx = recv
    ibArmRecvVar = pv
    elemStore(ab, n, t, ix)
    ibArmRecvIx = -1
    ibArmRecvVar = -1
    luOvLeave(mark)
    readRepMemoAdvance()
    if ibMiss != "" { return 0 }
    bodies.push(ab)
    vars.push(pv)
  }
  irBNode(
    b,
    { awV: v, awAt: ix, awArms: bodies, awVars: vars },
    -1,
    ibNoValue,
    ix,
  )
  return 0
}

// `xs[i] = v` that legacy writes as the plain store (`idxStoreOtherWhy`): receiver, index and
// value in source order, then the store, whose guard runs after the value. A union list's value that
// owes no box is boxed at the site's union (`idxStoreSiteBoxes`), as legacy's `emitUnionBoxArg`.
function elemStore(b: i32[], n: BinExpr, t: Index, ix: i32) {
  // Legacy writes a store through a box of list arms per arm before any other plan.
  if armIndexWriteArmsOf(t, ibFnIx).length > 0 {
    return elemArmWrite(b, n, t, ix)
  }
  // Legacy takes a map store before it plans an element store.
  if exprMap(t.idxArr, ibFnIx) {
    return mapSet(b, t.idxArr, t.idxIndex, n.binRight, ix)
  }
  const st = idxStorePlanOf(t, ibFnIx)
  if st == null { return skip("store plan") }
  // Legacy writes an unstamped unit into a `null[]` as its sentinel, apart from the value's emit.
  const nulStore = idxStoreNullUnitUnstamped(t.idxArr, n.binRight, ibFnIx)
  const why = idxStoreOtherWhy(st, n.binRight, ibFnIx)
  if why != "" { return skip(why) }
  const site = idxStoreSiteBoxes(st, n.binRight, ibFnIx)
  // A nested list's literal holding a record literal: legacy banks the store's element-read row from
  // its receiver, the lowering from the record's own read, so the rows disagree.
  if st.nestSlot >= 0 && listLitHoldsObjLit(n.binRight) {
    return skip("store element record literal")
  }
  const vat = b.length
  const v = irBExpr(b, t.idxArr)
  const at = b.length
  const i = irBExpr(b, t.idxIndex)
  const ln = repNodeAt(irBOpRep(v))
  if !(ln is RList) { return skip("store operand coercion") }
  // A packed list's element is stored as a plain i32, which its backing truncates; a `null[]`'s
  // as its i32 storage's sentinel.
  const er = if repSubWord(ln.rlsElem) || repPrim(ln.rlsElem) == "null" { repNodeOfTy(TY_I32) } else { ln.rlsElem }
  const xat = b.length
  // Its sentinel is an i32 only where the list's own rep holds `null[]`'s i32 storage.
  if nulStore && repPrim(ln.rlsElem) != "null" {
    return skip("store null unit sentinel rep")
  }
  const x0 = if nulStore { nulSentinelStore(b, n.binRight, er) } else if site { boxTempIn(b, unionElemValue(b, n.binRight), n.binRight, er, -1, st.unionTy) } else { deliver(b, n.binRight, er, -1) }
  if ibMiss != "" { return 0 }
  // A value that stands at the element's rep (`retagsAsStands`) is stored retagged.
  const x = if irBOpRep(x0) != er && retagsAsStands(irBOpRep(x0), er, n.binRight) { repTemp(b, { rgV: x0 }, n.binRight, er) } else { x0 }
  if ifBelowLeadIn(b, at, xat, "store short-circuit operand") { return 0 }
  if repPrim(irBOpRep(i)) != "i32" || irBOpRep(x) != er {
    return skip("store operand coercion")
  }
  // A valued `if` is written in place after the receiver and index, which are staged below it;
  // the store's tail is their one consumer (a hoisted receiver's skip misses at the lowering).
  const lead = [v, i]
  if !irBStageLeads(b, xat, [vat, at], lead, [t.idxArr, t.idxIndex]) {
    return skip("if into an element store")
  }
  irBNode(b, { bcV: lead[0], bcIx: lead[1] }, -1, ibNoValue, ix)
  irBNode(b, { lsV: lead[0], lsIx: lead[1], lsSrc: x }, -1, ibNoValue, ix)
  return 0
}

// A field write `o.f = v` through an un-narrowed union of records, on legacy's shared dispatch
// (`emitSharedFieldAssign`): one value staged for every arm (plan 2), or the value written in each
// arm at that arm's field (plan 1). Plan 2 reads a named receiver again per arm, as legacy does;
// plan 1, and any other receiver, stages it once.
function sharedFieldStore(b: i32[], n: BinExpr, t: Member, ix: i32): i32 {
  const vis: i32[] = []
  const fis: i32[] = []
  const plan = sharedFieldStorePlan(unwrapParen(n.binLeft), ibFnIx, vis, fis)
  if plan == 0 { return skip("field store shared plan") }
  const named = nodeAt(unwrapParen(t.memObj)) is Ident
  const stash = plan == 1 || !named
  const none: Opnd = { oiRep: ibNoValue, oiBits: 0 }
  let r: Opnd = none
  let g = -1
  if stash { r = irBExpr(b, t.memObj) }
  else if localIndexOf(ibFnIx, t.memObj) < 0 { g = irBGlobalBoxRecv(t.memObj) }
  else { r = irBBoxLocal(b, t.memObj) }
  if ibMiss != "" { return 0 }
  if g < 0 && !heldAsBox(irBOpRep(r)) {
    return skip("field store shared receiver rep")
  }
  const vs: Opnd[] = []
  let i = 0
  while i < (if plan == 1 { vis.length } else { 1 }) {
    const vt = if vis[i] < uVarTyIx.length { uVarTyIx[vis[i]] } else { -1 }
    const vr = repNodeOfTy(vt)
    if !(repNodeAt(vr) is RRecord) { return skip("field store shared arm rep") }
    const k = repRecordKidOf(vr, vt, t.memProp)
    if k < 0 { return skip("field store shared arm field") }
    const dst = repNodeKids(vr)[k]
    const at = b.length
    const v = deliver(b, n.binRight, dst, variantFieldBoxTy(vis[i], fis[i]))
    if ibMiss != "" { return 0 }
    if irBOpRep(v) != dst { return skip("field store shared value rep") }
    // A value written inside its arm is one the lowering writes in place.
    if (
      plan == 1
      && (b.length != at || !(v is OImm || v is OStr || v is OVar && irBVarAt(v)))
    ) {
      return skip("field store shared arm value")
    }
    vs.push(v)
    i = i + 1
  }
  const sh: Rhs = {
    shR: r,
    shStash: stash,
    shGlobal: g,
    shGlobalNonNull: g >= 0 && irBGlobalBoxRecovers(t.memObj),
    shVs: vs,
    shAt: ix,
  }
  irBNode(b, { efRhs: sh }, -1, ibNoValue, ix)
  return 0
}

// Whether operand `v` is a variable the lowering reads in place: a local or parameter, not a temp.
function irBVarAt(v: OVar): boolean {
  return v.ov >= 0 && v.ov < ib.irVars.length && ib.irVars[v.ov].vKind != "temp"
}

// The variant a narrowed store receiver `ix` reads as: a box local's or global's plain read
// unboxes to it, and a field read narrowed out of a union is its arm's variant.
function narrowedRecvVariant(ix: i32): i32 {
  if nodeAt(unwrapParen(ix)) is Member {
    return narrowedStructArmVi(ix, ibFnIx)
  }
  return narrowedBoxVariantPlain(ix, ibFnIx)
}

// A struct field store `o.f = v` that legacy writes as the record, the bare value and its
// store tail (`fieldStoreArmOf`'s `struct` arm, `fieldStoreValueArmOf`); a variant's, the record
// a variant receiver is or a box narrowed to one yields (`variantParam`, `narrowVariant`).
function fieldStore(b: i32[], n: BinExpr, t: Member, ix: i32) {
  const arm = fieldStoreArmOf(n.binLeft, ibFnIx)
  if arm == "shared" { return sharedFieldStore(b, n, t, ix) }
  if arm != "struct" && arm != "variantParam" && arm != "narrowVariant" {
    return skip("field store " + arm)
  }
  const sf = if arm == "struct" { fieldStoreStructAt(n.binLeft, ibFnIx) } else if arm == "variantParam" { fieldStoreVariantAt(n.binLeft, ibFnIx) } else { fieldStoreNarrowedAt(n.binLeft, ibFnIx) }
  if sf.length != 2 { return skip("field store shape") }
  // The receiver's narrowed read casts to the variant its own read picks; the store's `struct.set`
  // writes `sf[0]`'s heap, so the two must name one variant.
  if (arm == "narrowVariant" && narrowedRecvVariant(t.memObj) != sf[0]) {
    return skip("field store narrowed variant")
  }
  const va = if arm == "struct" { fieldStoreValueArmOf(sf[0], sf[1], n.binRight, ibFnIx) } else { variantFieldStoreValueArmOf(sf[0], sf[1], n.binRight, ibFnIx) }
  if !fieldStoreValueDelivers(va) { return skip("field store value " + va) }
  const vAt = b.length
  const v0 = irBExpr(b, t.memObj)
  if ibMiss != "" { return 0 }
  const rt = nodeTyAt(t.memObj, ibFnIx)
  const r0 = repNodeOfTy(rt)
  if !(repNodeAt(r0) is RRecord) { return skip("field store receiver") }
  const k0 = repRecordKidOf(r0, rt, t.memProp)
  if k0 < 0 { return skip("field kid") }
  // A receiver instanced at a stored row (D15827) is built at that row, whose field legacy's store
  // writes, where its type reads the field at another rep.
  const r = if fieldStoreRepFits(va, repNodeKids(r0)[k0]) { r0 } else { irBOpRep(v0) }
  const k = if r == r0 { k0 } else if repNodeAt(r) is RRecord { repRecordKidOf(r, rt, t.memProp) } else { -1 }
  if k < 0 { return skip("field store row rep") }
  const dst = repNodeKids(r)[k]
  if !fieldStoreRepFits(va, dst) { return skip("field store row rep") }
  const siteTy = if arm == "struct" { structFieldBoxTy(sf[0], sf[1]) } else { variantFieldBoxTy(sf[0], sf[1]) }
  // A box goes in as the deliver fence lets it: a recorded box first, else legacy's plan.
  if (
    va == "box"
    && exprUnion(n.binRight, ibFnIx)
    && boxIntoOtherUnion(n.binRight, dst, siteTy)
  ) {
    return skip("field store box from a box")
  }
  const at = b.length
  const x0 = deliver(b, n.binRight, dst, siteTy)
  if ibMiss != "" { return 0 }
  // A sub-word field (`repSubWord`) takes a plain i32, which `struct.set` truncates.
  const subWord = repSubWord(dst) && repPrim(irBOpRep(x0)) == "i32"
  const x = if subWord { x0 } else { irConvertStored(b, x0, dst, siteTy, n.binRight) }
  if ibMiss != "" { return 0 }
  // Legacy reads the receiver, then the value: a receiver variable is staged at its own start, so
  // the lowering writes it below a valued `if` the value wrote ahead of the store.
  const leads: Opnd[] = [v0]
  const starts: i32[] = [vAt]
  const why = "field store short-circuit operand"
  if !irBStageLeads(b, at, starts, leads, [t.memObj]) {
    if ibMiss == "" { ifBelowLead(b, at, why) }
    return 0
  }
  if ibMiss != "" || ifBelowLeadOf(b, at, why, leads) { return 0 }
  const v = leads[0]
  if irBOpRep(v) != r { return skip("field store receiver rep") }
  irBNode(b, { sfV: v, sfIx: k, sfSrc: x, sfPark: false }, -1, ibNoValue, ix)
  return 0
}

// The field store value arms whose write is the value delivered at the field's rep: the bare
// value, the box (`emitUnionBoxOwed`, the hole box plan), the widenings (`emitWidened`), an atom's
// decode to its string (`emitAtomToStr`, which `emitStrValue` writes for an atom) and a nullable
// record's value where `emitArmDelivery` owes no unbox (`fieldStore` checks that).
function fieldStoreValueDelivers(va: FieldStoreValArm): boolean {
  return match va {
    "plain" | "box" | "f64" | "i64" | "f32" | "atomToStr" | "strValue" | "armDelivery" => true
    "noKind" | "nulnone" | "unencodable" => false
  }
}

// Whether the receiver's field rep `dst` is the slot value arm `va` writes: a box into a box, a
// widening into its width, an atom's decode into a string.
function fieldStoreRepFits(va: FieldStoreValArm, dst: i32): boolean {
  return match va {
    "box" => repNodeAt(dst) is RBox || boxedNullable(dst)
    "f64" => repPrim(dst) == "f64"
    "i64" => repPrim(dst) == "i64"
    "f32" => repPrim(dst) == "f32"
    "atomToStr" => repPrim(dst) == "str"
    "strValue" => repPrim(dst) == "str" || strNullable(dst)
    "plain" | "armDelivery" => true
    "noKind" | "nulnone" | "unencodable" => false
  }
}

function loopIx(label: string): i32 {
  let i = ibLoopName.length - 1
  while i >= 0 {
    if label == "" || ibLoopName[i] == label { return i }
    i = i - 1
  }
  return -1
}

// The loop a `continue` to `label` targets: a labelled block takes no `continue`, so a bare one
// inside it finds the loop around it, as legacy's continue stack holds loops only.
function contIx(label: string): i32 {
  let i = ibLoopName.length - 1
  while i >= 0 {
    if ibLoopCont[i] >= 0 && (label == "" || ibLoopName[i] == label) {
      return i
    }
    i = i - 1
  }
  return -1
}

// Whether map walk receiver `mr`'s operand rep `r` is one the walk's stash takes: a map, or a
// nullable map the shared `mapRecvRefTail` recovers.
function mapRecvRepOk(r: i32, mr: i32): boolean {
  const n = repNodeAt(r)
  if n is RMap { return true }
  return n is RNullable
    && repNodeAt(n.rnInner) is RMap
    && exprNullableMap(mr, ibFnIx)
}

// Whether map walk iterable `iter` is a `.values()` call; a bare map and `.keys()` walk keys.
function mapWalkReadsValues(iter: i32): boolean {
  const e = nodeAt(unwrapParen(iter))
  if !(e is Call) || e.callFn < 0 { return false }
  const c = nodeAt(e.callFn)
  return c is Member && c.memProp == "values"
}

// A `for` statement along legacy's walk (`forInPlainWhy`, a hoisted one included): the list
// once, its element variable at the declared slot, and the body. Every other walk is a named miss.
function forInStmt(b: i32[], n: ForIn, ix: i32) {
  const why = forInPlainWhy(n, ix, ibFnIx)
  // A walk in an expression-position arm takes its node-pinned slots (`declSlotTake`), which
  // the lowering's declared slot names where the two agree.
  const pinned = why == "pinned slot"
    && declSlotPinned(ix) == declaredSlotOfDecl(n.fiDecl1)
  if why == "list union" { return forInListUnion(b, n, ix) }
  if why != "" && why != "hoisted" && !pinned { return skip("for in " + why) }
  // A map walk's operand is its receiver, whose keys or values list the lowering reads.
  const mr = forInMapRecv(n.fiIter, ibFnIx)
  const g = if mr >= 0 { mapGlobalOf(mr) } else { -1 }
  // A global receiver is read as one, never as an operand; any other is built raw, as legacy's
  // stash writes it, at a map rep its shared recovery owns.
  if mr >= 0 && g < 0 && mapRecvGlobalIx(mr, ibFnIx) >= 0 {
    return skip("for in map receiver")
  }
  const none: Opnd = { oiRep: ibNoValue, oiBits: 0 }
  const src = if mr >= 0 { mr } else { n.fiIter }
  const l = if g >= 0 { none } else { irBExpr(b, src) }
  if ibMiss != "" { return 0 }
  if mr >= 0 && g < 0 && !mapRecvRepOk(irBOpRep(l), mr) {
    return skip("for in map receiver rep")
  }
  // A list walks its elements, a byte list's each read unsigned as an i32; a string its code
  // points, each an i32; a map its keys or values.
  const lr = irBOpRep(l)
  const ln = repNodeAt(lr)
  const lpr = repPrim(lr)
  // A list read at a stored row's field: legacy declares the loop variable at the element type.
  if (
    g < 0
    && mr < 0
    && ln is RList
    && nodeAt(unwrapParen(src)) is Member
    && lr != repNodeOfTy(nodeTyAt(src, ibFnIx))
  ) {
    return skip("for in stored-row receiver")
  }
  let er = -1
  if ln is RList {
    er = if repPrim(ln.rlsElem) == "u8" { repNodeOfTy(TY_I32) } else { ln.rlsElem }
  }
  if lpr != null && lpr == "str" { er = repNodeOfTy(TY_I32) }
  if mr >= 0 { er = repNodeOfTy(forInElemTyOf(n.fiIter, ibFnIx)) }
  if er < 0 { return skip("for in operand coercion") }
  // A map walks its values into an i32 or a string, or at the rep its receiver's map stores them
  // at (`rmVal`); its keys at the key rep legacy declares the variable at (`forInElemTyOf`), which
  // the walk records, as a map rep holds no key. The verifier's rule.
  const vals = mr >= 0 && mapWalkReadsValues(n.fiIter)
  const keyRep = if mr >= 0 && !vals { er } else { -1 }
  if keyRep >= 0 && !mapKeyRep(keyRep) { return skip("for in map element rep") }
  if mr >= 0 && vals && er != repNodeOfTy(TY_I32) && repPrim(er) != "str" {
    const mrep = if g >= 0 { irGlobalRepOf(ib, g) } else { irBOpRep(l) }
    if er != mapWalkValRep(mrep) { return skip("for in map element rep") }
  }
  const v = irBLoopVar(n.fiDecl1, er, repTyOf(er))
  if v < 0 || ib.irVars[v].vRep != er { return skip("for in variable rep") }
  // A second name binds a sequence's index, an i32, or a map's value at its type's rep
  // (`forInBindTy`): legacy's walk writes either into the pair slot, which the body reads.
  let v2 = -1
  if n.fiVar2 != "" {
    const pr = repNodeOfTy(
      forInBindTy(readContainerTyAt(n.fiIter, ibFnIx), true),
    )
    if mr < 0 && pr != repNodeOfTy(TY_I32) { return skip("for in pair rep") }
    v2 = irBLoopVar(n.fiDecl2, pr, repTyOf(pr))
    if v2 < 0 || ib.irVars[v2].vRep != pr {
      return skip("for in pair variable rep")
    }
  }
  const brk = labelNew()
  const cont = labelNew()
  ibLoopName.push(n.fiLabel)
  ibLoopBrk.push(brk)
  ibLoopCont.push(cont)
  const fb: i32[] = []
  const body = nodeAt(n.fiBody)
  if body is Block {
    stmtRun(fb, body.blkStmts)
  } else {
    stmt(fb, n.fiBody, NO_SIBS, -1)
  }
  ibLoopName.pop()
  ibLoopBrk.pop()
  ibLoopCont.pop()
  if ibMiss != "" { return 0 }
  irBNode(
    b,
    {
      xfList: l,
      xfVar: v,
      xfVar2: v2,
      xfBody: fb,
      xfAt: ix,
      xfBrk: brk,
      xfCont: cont,
      xfMap: g,
      xfMapNonNull: mr >= 0 && globalReadRecovers(sidOfNode(mr), mr, ibFnIx),
      xfVals: vals,
      xfKeyRep: keyRep,
      xfLu: false,
    },
    -1,
    ibNoValue,
    ix,
  )
  return 0
}

// A walk of a union of lists' box (`luForWalkPlanOf`), the body built once: the lowering reads each
// element off the arm the box holds, boxed into the element union or converted to the flat kind.
function forInListUnion(b: i32[], n: ForIn, ix: i32) {
  const lp = luForWalkPlanOf(n, ibFnIx)
  if lp.lbWhy != "" { return skip("for in list union arm") }
  const l = irBExpr(b, n.fiIter)
  if ibMiss != "" { return 0 }
  if !(repNodeAt(irBOpRep(l)) is RBox) {
    return skip("for in list union box rep")
  }
  const et = luForWalkElemTy(n, ibFnIx)
  const er = repNodeOfTy(et)
  // A box walk binds the element union's box; a flat one the scalar or string each element becomes.
  const elemOk = if lp.lbPlan.destKind == "union" { repNodeAt(er) is RBox || boxedNullable(er) } else { repPrim(er) != null }
  if !elemOk { return skip("for in list union element rep") }
  const v = irBLoopVar(n.fiDecl1, er, et)
  if v < 0 || ib.irVars[v].vRep != er { return skip("for in variable rep") }
  let v2 = -1
  if n.fiVar2 != "" {
    const pr = repNodeOfTy(TY_I32)
    v2 = irBLoopVar(n.fiDecl2, pr, TY_I32)
    if v2 < 0 || ib.irVars[v2].vRep != pr {
      return skip("for in pair variable rep")
    }
  }
  const brk = labelNew()
  const cont = labelNew()
  ibLoopName.push(n.fiLabel)
  ibLoopBrk.push(brk)
  ibLoopCont.push(cont)
  const fb: i32[] = []
  const body = nodeAt(n.fiBody)
  if body is Block {
    stmtRun(fb, body.blkStmts)
  } else {
    stmt(fb, n.fiBody, NO_SIBS, -1)
  }
  ibLoopName.pop()
  ibLoopBrk.pop()
  ibLoopCont.pop()
  if ibMiss != "" { return 0 }
  irBNode(
    b,
    {
      xfList: l,
      xfVar: v,
      xfVar2: v2,
      xfBody: fb,
      xfAt: ix,
      xfBrk: brk,
      xfCont: cont,
      xfMap: -1,
      xfMapNonNull: false,
      xfVals: false,
      xfKeyRep: -1,
      xfLu: true,
    },
    -1,
    ibNoValue,
    ix,
  )
  return 0
}

// A range loop legacy writes rolled or fully unrolled (`forRangeArm`): the loop var, then the
// bound unless it is constant, each at the slot its collect pass declared. Rolled, `while`'s
// block and loop around the body, a `continue` landing at the end of an inner block, and the step
// before the back edge; unrolled, a block of `forRangeUnrolled`'s copies.
function forRangeStmt(b: i32[], n: ForRange, ix: i32) {
  const arm = forRangeArm(n, ix, ibFnIx)
  const why = forRangeRolledBlock(n, ix, ibFnIx)
  // A partial loop, and a rolled one's wrap exit, are written by legacy's helpers (`SRangeLoop`).
  const helpers = arm == "partial" || arm == "rolled" && why == "wrap exit"
  const opened = why == "hoisted" || why == "proven"
  if why != "" && !opened && !(helpers && why == "wrap exit") {
    return skip("for range " + why)
  }
  const k = forRangeStaticStep(n)
  const s = declaredSlotOfDecl(ix)
  const vw = if s >= 0 { declaredIndexAt(ibFnIx, s) } else { -1 }
  const bw = if s >= 0 { declaredIndexAt(ibFnIx, s + 1) } else { -1 }
  // A copy of this loop that an unrolled outer loop builds again reuses the slots' variables.
  const prior = ibDeclVar[ix] ?? -1
  const again = prior >= 0 && localVarAt(vw) == prior
  if (
    vw < 0
    || bw < 0
    || !again && (localVarAt(vw) >= 0 || localVarAt(bw) >= 0)
  ) {
    return skip("for range slot")
  }
  const ri = repNodeOfTy(TY_I32)
  const a = irBExpr(b, n.frFrom)
  if ibMiss != "" { return 0 }
  if irBOpRep(a) != ri { return skip("for range bound rep") }
  const v = if again { prior } else { irVarNew(ib, ri, TY_I32, "local", vw) }
  ibDeclVar[ix] = v
  // An instance's loop is a clone whose body reads still name the source's declaration.
  const src = nodeSrc[ix] ?? -1
  if src >= 0 { ibDeclVar[src] = v }
  irBNode(b, { asDst: v, asSrc: a }, -1, ibNoValue, ix)
  let bound: Opnd = { oiRep: ri, oiBits: 0 }
  if rangeConstIs(n.frTo, ibFnIx) {
    const c: Opnd = { oiRep: ri, oiBits: rangeConstVal(n.frTo, ibFnIx) as i64 }
    bound = c
  } else {
    const t = irBExpr(b, n.frTo)
    if ibMiss != "" { return 0 }
    if irBOpRep(t) != ri { return skip("for range bound rep") }
    const bv = if again && localVarAt(bw) >= 0 { localVarAt(bw) } else { irVarNew(ib, ri, TY_I32, "local", bw) }
    irBNode(b, { asDst: bv, asSrc: t }, -1, ibNoValue, ix)
    const o: Opnd = { ov: bv }
    bound = o
  }
  if arm == "unrolled" { return forRangeUnrolled(b, n, ix, v) }
  if helpers { return forRangeHelperLoop(b, n, ix, v, arm == "partial") }
  const brk = labelNew()
  const top = labelNew()
  const hasCont = blockHasContinueFor(n.frBody, n.frLabel, false)
  const cont = if hasCont { labelNew() } else { top }
  const loopBody: i32[] = []
  const vo: Opnd = { ov: v }
  const cmp: PrimOp = if k > 0 && n.frExcl { "lt" } else if k > 0 { "le" } else if n.frExcl { "gt" } else { "ge" }
  const c = irBLetTempTy(
    loopBody,
    { poOp: cmp, poArgs: [vo, bound] },
    ix,
    ibBool,
    TY_BOOL,
  )
  const exit: IrNode = { brLabel: brk, brHas: false, brVal: c }
  const exitBody = [irNodeNew(ib, exit, -1, ibNoValue, ix)]
  irBNode(loopBody, sIf(c, [], exitBody, -1, true), -1, ibNoValue, ix)
  ibLoopName.push(n.frLabel)
  ibLoopBrk.push(brk)
  ibLoopCont.push(cont)
  const fb: i32[] = []
  const body = nodeAt(n.frBody)
  if body is Block {
    stmtRun(fb, body.blkStmts)
  } else {
    stmt(fb, n.frBody, NO_SIBS, -1)
  }
  ibLoopName.pop()
  ibLoopBrk.pop()
  ibLoopCont.pop()
  if ibMiss != "" { return 0 }
  // The continue block is at the body, so only the loop's outer block at `ix` opens its hoists.
  if hasCont {
    irBNode(
      loopBody,
      { bkLabel: cont, bkBody: fb, bkOut: -1 },
      -1,
      ibNoValue,
      n.frBody,
    )
  } else {
    for x in fb { loopBody.push(x) }
  }
  const kk: Opnd = { oiRep: ri, oiBits: k as i64 }
  const nv = irBLetTempTy(
    loopBody,
    { poOp: "add", poArgs: [vo, kk] },
    ix,
    ri,
    TY_I32,
  )
  irBNode(loopBody, { asDst: v, asSrc: nv }, -1, ibNoValue, ix)
  irBNode(loopBody, { brLabel: top, brHas: false, brVal: c }, -1, ibNoValue, ix)
  const blockBody: i32[] = []
  irBNode(blockBody, { lpLabel: top, lpBody: loopBody }, -1, ibNoValue, ix)
  irBNode(b, { bkLabel: brk, bkBody: blockBody, bkOut: -1 }, -1, ibNoValue, ix)
  return 0
}

// Legacy's full unroll of range loop `n` into variable `v` (`forRangeUnrollPlan`): in a block,
// each copy sets `v` to its constant and runs the body reading that constant, in an inner block
// when a `continue` lands at the copy's end.
function forRangeUnrolled(b: i32[], n: ForRange, ix: i32, v: i32): i32 {
  const plan = forRangeUnrollPlan(n, ix, ibFnIx)
  if plan.length != 3 { return skip("for range plan") }
  const ri = repNodeOfTy(TY_I32)
  const brk = labelNew()
  const hasCont = blockHasContinueFor(n.frBody, n.frLabel, false)
  const blockBody: i32[] = []
  ibLoopName.push(n.frLabel)
  ibLoopBrk.push(brk)
  let val = plan[0]
  let k = 0
  while k < plan[2] && ibMiss == "" {
    const c: Opnd = { oiRep: ri, oiBits: val as i64 }
    irBNode(blockBody, { asDst: v, asSrc: c }, -1, ibNoValue, ix)
    const cont = if hasCont { labelNew() } else { brk }
    ibLoopCont.push(cont)
    ibRangeImmAt.push(ix)
    ibRangeImmVal.push(val)
    const fb: i32[] = []
    const body = nodeAt(n.frBody)
    if body is Block {
      stmtRun(fb, body.blkStmts)
    } else {
      stmt(fb, n.frBody, NO_SIBS, -1)
    }
    ibRangeImmAt.pop()
    ibRangeImmVal.pop()
    ibLoopCont.pop()
    if hasCont {
      irBNode(
        blockBody,
        { bkLabel: cont, bkBody: fb, bkOut: -1 },
        -1,
        ibNoValue,
        n.frBody,
      )
    } else {
      for x in fb { blockBody.push(x) }
    }
    val = val + plan[1]
    k = k + 1
  }
  ibLoopName.pop()
  ibLoopBrk.pop()
  if ibMiss != "" { return 0 }
  irBNode(b, { bkLabel: brk, bkBody: blockBody, bkOut: -1 }, -1, ibNoValue, ix)
  return 0
}

// Legacy's partial or wrapping range loop `n` into `v` (`SRangeLoop`): a partial one's main loop
// holds `rangePartialCopies` copies of the body, as legacy's plan says, then the rolled loop's.
function forRangeHelperLoop(
  b: i32[],
  n: ForRange,
  ix: i32,
  v: i32,
  partial: boolean,
): i32 {
  const rt = forRangeTestOf(n, ix, ibFnIx)
  const copies: i32[][] = []
  const conts: i32[] = []
  const brk = if partial { labelNew() } else { -1 }
  const hasCont = blockHasContinueFor(n.frBody, n.frLabel, false)
  if partial {
    const nc = rangePartialCopies(rt, rangeMayWrap(n, rt))
    ibLoopName.push(n.frLabel)
    ibLoopBrk.push(brk)
    let k = 0
    while k < nc && ibMiss == "" {
      const cont = if hasCont { labelNew() } else { brk }
      ibLoopCont.push(cont)
      copies.push(rangeBodyOf(n))
      ibLoopCont.pop()
      conts.push(cont)
      k = k + 1
    }
    ibLoopName.pop()
    ibLoopBrk.pop()
  }
  const tailBrk = labelNew()
  const tailCont = labelNew()
  ibLoopName.push(n.frLabel)
  ibLoopBrk.push(tailBrk)
  ibLoopCont.push(tailCont)
  const tail = rangeBodyOf(n)
  ibLoopName.pop()
  ibLoopBrk.pop()
  ibLoopCont.pop()
  if ibMiss != "" { return 0 }
  irBNode(
    b,
    {
      rlAt: ix,
      rlVar: v,
      rlPartial: partial,
      rlCopies: copies,
      rlConts: conts,
      rlBrk: brk,
      rlTail: tail,
      rlTailBrk: tailBrk,
      rlTailCont: tailCont,
    },
    -1,
    ibNoValue,
    ix,
  )
  return 0
}

// The IR's body of range loop `n`, built afresh.
function rangeBodyOf(n: ForRange): i32[] {
  const fb: i32[] = []
  const body = nodeAt(n.frBody)
  if body is Block {
    stmtRun(fb, body.blkStmts)
  } else {
    stmt(fb, n.frBody, NO_SIBS, -1)
  }
  return fb
}

// The innermost unrolled copy of range loop `d`, or of an instance's clone of it, or -1.
function rangeImmAt(d: i32): i32 {
  let k = ibRangeImmAt.length - 1
  while k >= 0 {
    if ibRangeImmAt[k] == d || (nodeSrc[ibRangeImmAt[k]] ?? -1) == d {
      return k
    }
    k = k - 1
  }
  return -1
}

function whileStmt(b: i32[], n: WhileStmt, ix: i32) {
  // A loop value leaves its frame through its result binding (`lvFrameOpen`).
  const lv = if n.whileLv >= 0 { irBDeclVar(n.whileLv) } else { -1 }
  if n.whileLv >= 0 && lv < 0 { return skip("loop value binding") }
  if n.whileBlk != 0 { return labelBlock(b, n, ix, lv) }
  const brk = labelNew()
  const cont = labelNew()
  if lv >= 0 { ibLvOf[brk] = lv }
  ibLoopName.push(n.whileLabel)
  ibLoopBrk.push(brk)
  ibLoopCont.push(cont)
  const loopBody: i32[] = []
  // A valued frame's `while true` writes no test (`condLitTrue`); it has no exit but its breaks.
  if lv >= 0 && !condLitTrue(n.whileCond) { skip("loop value condition") }
  if lv < 0 {
    const c = irBExpr(loopBody, n.whileCond)
    if ibMiss == "" && irBOpRep(c) != ibBool { irBMiss("loop condition") }
    const exit: IrNode = { brLabel: brk, brHas: false, brVal: c }
    const exitBody = [irNodeNew(ib, exit, -1, ibNoValue, ix)]
    irBNode(loopBody, sIf(c, [], exitBody, -1, true), -1, ibNoValue, ix)
  }
  const wb = nodeAt(n.whileBody)
  if wb is Block {
    stmtRun(loopBody, wb.blkStmts)
  } else {
    stmt(loopBody, n.whileBody, NO_SIBS, -1)
  }
  const none: Opnd = { ov: -1 }
  irBNode(
    loopBody,
    { brLabel: cont, brHas: false, brVal: none },
    -1,
    ibNoValue,
    ix,
  )
  const blockBody: i32[] = []
  irBNode(blockBody, { lpLabel: cont, lpBody: loopBody }, -1, ibNoValue, ix)
  ibLoopName.pop()
  ibLoopBrk.pop()
  ibLoopCont.pop()
  // A valued frame is left only by a `break v`, so falling out of its loop cannot happen.
  if lv >= 0 { irBNode(blockBody, { tpWhy: 0 }, -1, ibNoValue, ix) }
  irBNode(b, { bkLabel: brk, bkBody: blockBody, bkOut: lv }, -1, ibNoValue, ix)
  return 0
}

// A labelled block (`emitLabelBlock`): one block frame a `break` leaves, which takes no
// `continue`. One carrying value `lv` ends with its tail falling out of it when the tail assigns
// the result binding, and with `unreachable` otherwise.
function labelBlock(b: i32[], n: WhileStmt, ix: i32, lv: i32) {
  const brk = labelNew()
  if lv >= 0 { ibLvOf[brk] = lv }
  ibLoopName.push(n.whileLabel)
  ibLoopBrk.push(brk)
  ibLoopCont.push(-1)
  const body: i32[] = []
  const wb = nodeAt(n.whileBody)
  if wb is Block {
    stmtRun(body, wb.blkStmts)
  } else {
    stmt(body, n.whileBody, NO_SIBS, -1)
  }
  ibLoopName.pop()
  ibLoopBrk.pop()
  ibLoopCont.pop()
  if lv >= 0 {
    const out: Opnd = { ov: lv }
    if lvTailAssigns(n) {
      irBNode(
        body,
        { brLabel: brk, brHas: true, brVal: out },
        -1,
        ibNoValue,
        ix,
      )
    } else {
      irBNode(body, { tpWhy: 0 }, -1, ibNoValue, ix)
    }
  }
  irBNode(b, { bkLabel: brk, bkBody: body, bkOut: lv }, -1, ibNoValue, ix)
  return 0
}

// A label no other branch target in this function uses.
function labelNew(): i32 {
  ibLabelN = ibLabelN + 1
  return ibLabelN - 1
}

// An `if` statement and its `else if` links, built along the chain's spine rather than by
// recursing per link (D1990): each link's test and `then` arm in source order into the body the
// link before it leaves as its `else`, then the final `else`, then each link's node innermost
// first, the order a recursion's returns allocate them in. A link has no span of its own.
function ifChain(b: i32[], ix: i32) {
  const links: i32[] = []
  const outs: i32[][] = []
  const conds: Opnd[] = []
  const thens: i32[][] = []
  const kws: boolean[] = []
  let cur = ix
  let out = b
  let lastElse = -1
  let cut = false
  // A link legacy writes as a `br_table` takes the rest of the chain, and is the last link's else;
  // so is a last link whose test the checker proved, written as its arm alone (`ifLinkExhausts`).
  let sw = false
  while true {
    const n = nodeAt(cur)
    if !(n is IfStmt) { return skip("condition") }
    const p = if intSwitchMayLower(cur) { intSwitchPlanOf(cur, ibFnIx) } else { null }
    if p != null {
      intSwitch(out, cur, p, false)
      if ibMiss != "" || links.length == 0 { return 0 }
      sw = true
      break
    }
    if ifLinkExhausts(n) {
      const th = nodeAt(n.ifThen)
      for x in if th is Block { bodyOf(th.blkStmts) } else { bodyOf([n.ifThen]) } {
        out.push(x)
      }
      if ibMiss != "" || links.length == 0 { return 0 }
      sw = true
      break
    }
    // A decided `is` guard: legacy reads its constant back and writes no then arm (D932). A
    // tag the box lacks is never a covering test, so the arm is not one legacy writes dead.
    const decided = isDecidedFalse(n.ifCond, ibFnIx)
    const no: Opnd = { oiRep: ibBool, oiBits: 0 }
    const cat = out.length
    const c = if decided { no } else { irBExpr(out, n.ifCond) }
    if ibMiss != "" || irBOpRep(c) != ibBool { return skip("condition") }
    // Another constant `is` legacy decides off its bytes (`staticIsGuard`): a `false` writes no
    // then arm, a `true` no else. One that ends its block cuts the rest, which is legacy's.
    const k = if !decided && c is OImm && bareConstIs(c, n.ifCond, out, cat) { if c.oiBits != 0 { 1 } else { 0 } } else { -1 }
    // Legacy cuts only after the statement, so a guard on a later link is not one. A head
    // guard the instance decides true cuts even where its test is written (`monoStaticIsGuardOf`).
    if (
      links.length == 0
      && guardEndsBlockWith(cur, if k == 1 { 1 } else { -1 }, ibFnIx)
    ) {
      cut = true
    } else if k == 1 && guardEndsBlockWith(cur, k, ibFnIx) {
      return skip("decided is guard ends block")
    }
    const th = nodeAt(n.ifThen)
    const thenB: i32[] = []
    if ifThenIsDead(n) {
      // A covering test's dead `then` is uncollected; legacy writes `unreachable` (D16006).
      irBNode(thenB, { tpWhy: 0 }, -1, ibNoValue, n.ifThen)
    } else if !decided && k != 0 {
      for x in if th is Block { bodyOf(th.blkStmts) } else { bodyOf([n.ifThen]) } {
        thenB.push(x)
      }
    }
    links.push(cur)
    outs.push(out)
    conds.push(c)
    thens.push(thenB)
    // A dead `else` (`ifWritesElse`) is uncollected: legacy writes none of it (D16006), nor of
    // the `else` a decided-true guard leaves dead.
    const kw = ifWritesElse(n) && k != 1
    kws.push(kw)
    lastElse = if kw { n.ifElse } else { -1 }
    if lastElse < 0 || !(nodeAt(lastElse) is IfStmt) { break }
    const nb: i32[] = []
    out = nb
    cur = n.ifElse
  }
  // A dead `else` (`ifWritesElse`) is neither written nor counted by legacy, so it is not built.
  const ll = nodeAt(links[links.length - 1])
  const deadElse = ll is IfStmt && lastElse >= 0 && !ifWritesElse(ll)
  let elseB = if sw { out } else if deadElse { [] } else { bodyOf(elseStmts(lastElse)) }
  let k = links.length - 1
  while k >= 0 {
    const kw = kws[k]
    irBNode(
      outs[k],
      sIf(conds[k], thens[k], elseB, -1, kw),
      -1,
      ibNoValue,
      links[k],
    )
    elseB = outs[k]
    k = k - 1
  }
  return if cut { IF_CUTS_BLOCK } else { 0 }
}

function elseStmts(e: i32): i32[] {
  if e < 0 { return [] }
  const en = nodeAt(e)
  if en is Block { return en.blkStmts }
  return [e]
}

// Whether `on`, built into `b` from `n0` on, is a switch operand legacy reads again: a place's
// variable (no temp), or the constant an unrolled range copy reads its variable as.
function intSwitchOn(b: i32[], n0: i32, on: Opnd): boolean {
  if b.length != n0 { return false }
  if on is OImm { return true }
  if !(on is OVar) || on.ov < 0 || on.ov >= ib.irVars.length { return false }
  return ib.irVars[on.ov].vKind != "temp"
}

// The valued integer `match` at `ix` that `p` plans: each arm and the else writes its value at
// `rep` into the out the frame carries, as `ifArm` writes a value `if`'s.
function valuedSwitch(b: i32[], ix: i32, p: IntSwitchPlan, rep: i32): Opnd {
  const n0 = b.length
  const on = irBExpr(b, p.ispOn)
  if ibMiss != "" { return on }
  if !intSwitchOn(b, n0, on) { return irBMiss("int switch scrutinee") }
  const ty = byteHeld(rowlessRecordTy(ix, nodeTyAt(ix, ibFnIx), rep))
  if irTyHeldOpen(ty, rep) { return irBMiss("open temp type") }
  const t = irVarNew(ib, rep, ty, "local", -1)
  const arms: i32[][] = []
  for th in p.ispThens { arms.push(ifArm(th, t, rep)) }
  const els = ifArm(p.ispElse, t, rep)
  if ibMiss != "" { return irBMiss("if arm") }
  const sn: SIntSwitch = {
    isTail: false,
    isOut: t,
    isOn: on,
    isWide: p.ispWide,
    isLo: p.ispLo,
    isTable: p.ispTable,
    isArms: arms,
    isElse: els,
  }
  irBNode(b, sn, ty, rep, ix)
  const o: Opnd = { ov: t }
  return o
}

// The integer `match` chain at `ix` that `p` plans as one `br_table`: legacy reads the place itself,
// twice when 64-bit, so its operand is the place's variable. A tail chain's arms return their
// last value (`tailArm`); a statement chain's are statement lists, as `emitSwitchArm` writes them.
function intSwitch(b: i32[], ix: i32, p: IntSwitchPlan, tail: boolean) {
  const n0 = b.length
  const on = irBExpr(b, p.ispOn)
  if ibMiss != "" { return 0 }
  if !intSwitchOn(b, n0, on) { return skip("int switch scrutinee") }
  const arms: i32[][] = []
  for t in p.ispThens {
    arms.push(if tail { tailArm(t) } else { bodyOf(elseStmts(t)) })
  }
  const els = if p.ispElse < 0 { [] } else if tail { tailArm(p.ispElse) } else { bodyOf(elseStmts(p.ispElse)) }
  if ibMiss != "" { return 0 }
  const sn: SIntSwitch = {
    isTail: tail,
    isOut: -1,
    isOn: on,
    isWide: p.ispWide,
    isLo: p.ispLo,
    isTable: p.ispTable,
    isArms: arms,
    isElse: els,
  }
  irBNode(b, sn, -1, ibNoValue, ix)
  return 0
}

// The sibling list of a statement built outside a statement list; its position is -1.
const NO_SIBS: i32[] = []

// Each statement of `stmts` in order, as a statement list.
function stmtRun(b: i32[], stmts: i32[]) {
  let i = 0
  while i < stmts.length {
    stmtAt(b, stmts, i)
    i = if blockCut(b) { stmts.length } else { i + 1 }
  }
  return 0
}

// Statement `i` of list `stmts`.
function stmtAt(b: i32[], stmts: i32[], i: i32) {
  return stmt(b, stmts[i], stmts, i)
}

// Builds statement `ix` onto `b`, noting the run of nodes it built for the source map. `ix` is
// `sibs[pos]`, which a declaration's list reserve reads its following statements from, or `pos`
// is -1 outside a list.
function stmt(b: i32[], ix: i32, sibs: i32[], pos: i32) {
  const n0 = b.length
  const sn = nodeAt(ix)
  if sn is LetDecl && sn.letInit >= 0 && cboxIsWriteLet(ix) {
    ibStubRhs = unwrapParen(sn.letInit)
  }
  if sn is LetDecl && letStoresGenericAliasCore(sn, ibFnIx) {
    ibAliasRhs = unwrapParen(sn.letInit)
  }
  const cut = stmtNode(b, ix, sibs, pos) == IF_CUTS_BLOCK
    && nodeAt(ix) is IfStmt
  if ibMiss != "" && ibMissAt < 0 { ibMissAt = ix }
  if ibMiss != "" && censusGoesOn(ibMiss) {
    ibMiss = ""
    ibMissAt = -1
    ibStubRhs = -1
  }
  // Legacy writes back a region's length after its last statement, inside that statement's
  // span (`emitStmtIn`).
  if reserveEnds(ix) {
    irBNode(
      b,
      { srOp: "reserve.close", srHeap: -1, srArgs: [], srImm: ix },
      -1,
      ibNoValue,
      ix,
    )
  }
  if b.length > n0 { irSpanNote(ib, ix, b[n0], b[b.length - 1]) }
  if cut { irBNode(b, { tpWhy: TRAP_BLOCK_CUT }, -1, ibNoValue, ix) }
  return 0
}

// Whether the last statement built onto `b` cut the rest of its block (`TRAP_BLOCK_CUT`).
function blockCut(b: i32[]): boolean {
  if b.length == 0 { return false }
  const n = ib.irNodes[b[b.length - 1]]
  return n is STrap && n.tpWhy == TRAP_BLOCK_CUT
}

// Notes global `g` held whole as its record (`irGlobalHeld`), as `globalRep` notes a holder's cell.
function globalHeldNote(g: i32) {
  if g < 0 { return 0 }
  ib.irGlobalHeld[g] = true
  return 0
}

// The record a bundle holder `f` holds, which a pick reads a member of: a global holding it beside
// `null` (a map read) is read narrowed to the record, its recover legacy's `ref.as_non_null`.
function holderRecordOf(b: i32[], f: i32): Opnd {
  const r = unwrapParen(f)
  if r >= 0 && r < P.nodes.length && nodeAt(r) is Ident && globalTarget(r) {
    const d = identDeclOf(r)
    const g = globalIndexOfSid(sidOfNode(r))
    const cr = globalRep(g, d)
    const ht = globalHolderTy(d)
    const hr = if ht >= 0 { repNodeOfTy(ht) } else { -1 }
    const cn = repNodeAt(cr)
    if (
      hr >= 0
      && cn is RNullable
      && cn.rnInner == hr
      && repNodeAt(hr) is RRecord
    ) {
      const gm = irGlobalReadMiss(g, ibGlobalCtx())
      if gm != "" { return irBMiss(gm) }
      const gr: Rhs = {
        ggSym: g,
        ggNonNull: globalReadRecovers(sidOfNode(r), r, ibFnIx),
        ggNn: if readOwesNonNullRecover(r, ibFnIx) { 1 } else { 0 },
      }
      ib.irReadAgain[r] = gr
      globalHeldNote(g)
      return irBLetTempTy(b, gr, r, hr, ht)
    }
  }
  return irBExpr(b, f)
}

// `let` `ix` (variable `v`) initialised with a bundle holder's read: the holder's record, then the
// member the binding's type names (`RHolderPick`), at the binding's rep and type.
function holderPickLet(b: i32[], n: LetDecl, ix: i32, v: i32): i32 {
  if !(repNodeAt(ib.irVars[v].vRep) is RClosure) {
    return skip("holder pick binding rep")
  }
  const rec = holderRecordOf(b, n.letInit)
  if ibMiss != "" { return 0 }
  if !(repNodeAt(irBOpRep(rec)) is RRecord) {
    return skip("holder pick record")
  }
  const t = irBLetTempTy(
    b,
    { hkV: rec, hkAt: ix, hkArg: n.letInit },
    n.letInit,
    ib.irVars[v].vRep,
    ib.irVars[v].vTy,
  )
  irBNode(b, { asDst: v, asSrc: t }, -1, ibNoValue, ix)
  return 0
}

// Whether statement `ix` ends a reserve region the body opened; it is taken off the list.
function reserveEnds(ix: i32): boolean {
  let i = 0
  let hit = false
  while i < ibReserveEnd.length {
    if ibReserveEnd[i] == ix {
      ibReserveEnd[i] = -1
      lbPlanDrop(ibReservePushes[i])
      hit = true
    }
    i = i + 1
  }
  return hit
}

// The constant a `const` declaration `ix` folds out of its later memory addresses, or -1: legacy's
// own checks in `emitLetPlainInit`'s order, over an i32 local of a function.
function foldLetK(n: LetDecl, ix: i32): i64 {
  if ibFnIx < 0 || n.letKw != "const" || !mfShapeIsSum(n.letInit) { return -1 }
  const slot = declaredSlotOfDecl(ix)
  if slot < 0 || slot >= localIsRef.length || localIsRef[slot] != "i32" {
    return -1
  }
  return memConstFoldShapeK(n.letInit, ibFnIx)
}

// Declaration `ix` of `v` folding constant `k`: its bounded part teed into the fold local legacy
// reserves for it, one per declaration in the order the body first writes them, plus `k`.
function foldLetAt(b: i32[], n: LetDecl, ix: i32, v: i32, k: i64) {
  const rest = memConstFoldShapeRest(n.letInit, ibFnIx)
  if rest < 0 { return skip("address fold split") }
  let row = 0
  while row < ib.irMaDecl.length && ib.irMaDecl[row] != ix { row = row + 1 }
  if row == ib.irMaDecl.length {
    if row >= fnMemAddrFoldCount { return skip("address fold slot") }
    ib.irMaDecl.push(ix)
    ib.irMaSlot.push(maFoldScratchBase + row)
    ib.irMaK.push(k)
  }
  const i32r = repNodeOfTy(TY_I32)
  const rv = deliver(b, rest, i32r, TY_I32)
  if ibMiss != "" { return 0 }
  if irBOpRep(rv) != i32r { return skip("address fold operand") }
  const t = irBLetTemp(
    b,
    { mfiV: rv, mfiSlot: ib.irMaSlot[row], mfiK: k },
    ix,
    i32r,
  )
  if ib.irVars[v].vRep != i32r { return skip("address fold binding rep") }
  irBNode(b, { asDst: v, asSrc: t }, -1, ibNoValue, ix)
  return 0
}

function stmtNode(b: i32[], ix: i32, sibs: i32[], pos: i32) {
  if ibMiss != "" { return 0 }
  const n = nodeAt(ix)
  if n is Block {
    stmtRun(b, n.blkStmts)
    return 0
  }
  // A nested function declaration is lifted, and writes nothing where it stands, unless it
  // drops a cached environment.
  if n is FuncDecl {
    // A cached environment is dropped here, so each execution declares a new function value.
    if irEnvCached(fnStmtsPosOf(ix)) {
      irBNode(b, { efRhs: { edFn: fnStmtsPosOf(ix) } }, -1, ibNoValue, ix)
    }
    return 0
  }
  // A body-scope type or union declaration is hoisted to the program's, and writes nothing here.
  if n is TypeDecl || n is UnionDecl { return 0 }
  if n is LetDecl {
    // A `const` bound to a lambda-lifted function holds no value: every use calls it directly.
    if n.letInit >= 0 && cloLiftLetFe(fnStmtsPosOf(ibFnIx), ix) >= 0 {
      return 0
    }
    const fresh = (ibDeclVar[ix] ?? -1) < 0
    const v = irBDeclVar(ix)
    // A `const` every read copied the tree of computes nothing, as legacy writes it (D15001).
    if v >= 0 && keptDeclStoresNothing(n, ix) { return 0 }
    if v < 0 { return skip("declaration") }
    // An uninitialized binding writes nothing, as legacy's `emitLetDeclStmt` writes nothing: its
    // local's default covers it, and a reference one is declared nullable (`localUnset`).
    if n.letInit < 0 { return 0 }
    // A `null` binding of an assignment of `null` stores, then binds the bottom null, as legacy's
    // `emitNulNoneLeafPayload` writes it.
    const ai = unwrapParen(n.letInit)
    if (
      ai >= 0
      && ai < P.nodes.length
      && asgYieldsNullLit(ai)
      && letIsNulNone(ix, ibFnIx)
    ) {
      const an = nodeAt(ai)
      if an is BinExpr {
        assignTo(b, an, ai)
        if ibMiss != "" { return 0 }
        const nv = repTemp(
          b,
          {
            nuAt: unwrapParen(an.binRight),
            nuOwn: NULL_OWN_NONE,
            nuRead: [],
          },
          ai,
          ib.irVars[v].vRep,
        )
        irBNode(b, { asDst: v, asSrc: nv }, -1, ibNoValue, ix)
        return 0
      }
    }
    // Legacy may build a `[]` its pushes follow at its final size, through locals (D3623).
    const lr = if pos >= 0 { listReserveScan(n, sibs, pos, ibFnIx) } else { null }
    // The lowering opens a reserve over a function's body only (`reserveOpen`).
    const inFn = ibFnIx >= 0
      && ibFnIx < P.nodes.length
      && nodeAt(ibFnIx) is FuncDecl
    if lr != null && !inFn { return skip("list reserve outside a function") }
    // An annotated binding of a bundle holder's read takes the member its type names, as legacy's
    // `emitTypedHolderInit` picks it ahead of every other initializer.
    if typedHolderMember(ix, ibFnIx) >= 0 { return holderPickLet(b, n, ix, v) }
    // Legacy writes a nullable or union binding's `if` initializer in each arm.
    const pa = letIfInitPerArmRep(ix, ibFnIx)
    if pa == 0 && letIfInitSinks(n.letInit, ibFnIx) {
      return letIfSinkArms(b, n.letInit, v, letIfInitTy(n, ibFnIx))
    }
    if pa > 0 { return letIfArms(b, n.letInit, v, pa, -1) }
    if pa == 0 { return letIfArms(b, n.letInit, v, pa, letIfInitTy(n, ibFnIx)) }
    // Legacy's own binding arm reads a union-valued map's box past `emitExpr`, banking no
    // element-read row (`letNulMapReadUnionBox`).
    // A `const` legacy keeps the bounded part of for later memory addresses (`emitLetPlainInit`).
    const mk = foldLetK(n, ix)
    if mk >= 0 { return foldLetAt(b, n, ix, v, mk) }
    const built = if letNulMapReadUnionBox(ix, ibFnIx) { mapGetAt(
      b,
      unwrapParen(n.letInit),
      ib.irVars[v].vRep,
      -1,
      false,
      -1,
      false,
      false,
    ) } else if letCellNulArmUnbox(ix, n.letInit, ib.irVars[v].vRep) { armUnboxTemp(b, n.letInit, ib.irVars[v].vRep, ib.irVars[v].vTy, true) } else if letIsArmCell(ix) { variantCoerced(
      b,
      n.letInit,
      ib.irVars[v].vRep,
      ib.irVars[v].vTy,
      letArmCellRow(ix, ibFnIx),
    ) } else if letStoresNullRead(ix, n.letInit, v) { exprAt(b, n.letInit, true) } else { deliver(b, n.letInit, ib.irVars[v].vRep, ib.irVars[v].vTy) }
    if ibMiss != "" { return 0 }
    // A ref list bound at its record-or-null twin, or a union-box list or map at another union's,
    // is the same value; legacy writes no convert where no coercion is recorded at the initializer.
    // A fresh local stored at the value's own rep takes it (`localStoredAt`), as a closure cell
    // takes its closure (`cellTakesClosure`); else the value is converted to the cell's rep.
    const stored = irBOpRep(built) != ib.irVars[v].vRep
      && convertKindOf(
      built,
      ib.irVars[v].vRep,
      ib.irVars[v].vTy,
      n.letInit,
    )
      != CONVERT_RETAG
      && (fresh && localStoredAt(v, ix, irBOpRep(built))
      || cellTakesClosure(ix, v, built))
    const src = if stored { built } else { irConvertStored(b, built, ib.irVars[v].vRep, ib.irVars[v].vTy, n.letInit) }
    if ibMiss != "" { return 0 }
    irBNode(b, { asDst: v, asSrc: src }, -1, ibNoValue, ix)
    if lr != null {
      irBNode(
        b,
        { srOp: "reserve.open", srHeap: pos, srArgs: [], srImm: v },
        -1,
        ibNoValue,
        ix,
      )
      ibReserveEnd.push(sibs[lr.lrLast])
      const pushes = listReserveRegionPushes(
        n,
        sibs,
        pos,
        declaredSlotOfDecl(ix),
        ibFnIx,
      )
      ibReservePushes.push(pushes)
      lbPlanAdd(pushes)
    }
    return 0
  }
  if n is IfStmt { return ifChain(b, ix) }
  if n is WhileStmt {
    whileStmt(b, n, ix)
    return 0
  }
  if n is ForIn { return forInStmt(b, n, ix) }
  if n is ForRange { return forRangeStmt(b, n, ix) }
  if n is BreakStmt {
    const l = loopIx(n.brkLabel)
    if l < 0 { return skip("break") }
    // A `break v` out of a typed frame reads the value its statement before stored into the
    // frame's result binding; out of a `for`, whose frame is void, it is a plain `br`.
    const lv = ibLvOf[ibLoopBrk[l]] ?? -1
    if n.brkHasVal == 0 && lv >= 0 { return skip("break") }
    const z: Opnd = { ov: lv }
    irBNode(
      b,
      { brLabel: ibLoopBrk[l], brHas: lv >= 0, brVal: z },
      -1,
      ibNoValue,
      ix,
    )
    return 0
  }
  if n is ContinueStmt {
    const l = contIx(n.contLabel)
    if l < 0 { return skip("continue") }
    const z: Opnd = { ov: -1 }
    irBNode(
      b,
      { brLabel: ibLoopCont[l], brHas: false, brVal: z },
      -1,
      ibNoValue,
      ix,
    )
    return 0
  }
  if n is RetStmt {
    const none = repIsNoValue(ib.irRetRep)
    if n.retArg < 0 {
      if !none { return skip("bare return") }
      const z: Opnd = { ov: -1 }
      irBNode(b, { rtHas: false, rtV: z }, -1, ibNoValue, ix)
      return 0
    }
    // At a function with no result, `return <expr>` is `<expr>` for its effect, then a bare return.
    if none {
      stmtNode(b, n.retArg, NO_SIBS, -1)
      if ibMiss != "" { return 0 }
      const z: Opnd = { ov: -1 }
      irBNode(b, { rtHas: false, rtV: z }, -1, ibNoValue, ix)
      return 0
    }
    // A returned call that never returns is that call, then the `return` legacy writes after it,
    // dead and bare; at a wider number legacy also widens the dead value.
    const rx = unwrapParen(n.retArg)
    const rt = if rx >= 0 && rx < P.nodes.length { nodeAt(rx) } else { null }
    if rt is Call && callIsNever(rx) {
      if numKindOf(ib.irRetRep) >= 3 { return skip("returned trap widened") }
      stmtNode(b, rx, NO_SIBS, -1)
      if ibMiss != "" { return 0 }
      if b.length == 0 || !irNodeEndsPath(ib.irNodes[b[b.length - 1]]) {
        return skip("returned never call")
      }
      const z: Opnd = { ov: -1 }
      irBNode(b, { rtHas: false, rtV: z }, -1, ibNoValue, ix)
      return 0
    }
    if retRefusedWhy(n.retArg, ibFnIx) != "" { return skip("return refused") }
    // A returned value `if` is legacy's tail `if`, each arm's value its own exit.
    if retIsValueIf(n.retArg) {
      // `end` is followed by the result's `null` where it bears one (`emitNullForRet`), returned.
      const nul = fnRetNullBearing(ibFnIx)
      if nul && nullRetPlanOf(ibFnIx) == null {
        return skip("returned if null plan")
      }
      tailIf(b, unwrapParen(n.retArg))
      if ibMiss != "" { return 0 }
      if nul {
        const r: Rhs = { rnrAt: ix }
        const t = irBLetTempTy(b, r, ix, ib.irRetRep, ib.irRetTy)
        irBNode(b, { rtHas: true, rtV: t }, -1, ibNoValue, ix)
        return 0
      }
      // Legacy's `unreachable` after the `end` its returning arms leave behind.
      irBNode(b, { tpWhy: 0 }, -1, ibNoValue, ix)
      return 0
    }
    const built = retCloAt(b, n.retArg) ?? retDelivered(b, n.retArg)
    if ibMiss != "" { return 0 }
    // A returned literal whose nested field sits at another rep of its row (D17385).
    if (
      ibRetNestedTwin >= 0
      && ibRetNestedTwin == unwrapParen(n.retArg)
      && convertKindOf(built, ib.irRetRep, ib.irRetTy, n.retArg) < 0
    ) {
      return skip("return coercion nested twin")
    }
    const v = irConvert(b, built, ib.irRetRep, ib.irRetTy, n.retArg)
    if ibMiss != "" { return 0 }
    irBNode(b, { rtHas: true, rtV: v }, -1, ibNoValue, ix)
    return 0
  }
  if n is BinExpr && n.binOp == "=" {
    assign(b, n, ix)
    return 0
  }
  // A postfix `x++` / `x--` statement discards its old value: it is its increment, the assignment
  // the parser wraps (a place's prefix increment), as legacy's `emitStmt` writes it.
  if n is Unary && (n.unOp == "p+" || n.unOp == "p-") {
    return stmtNode(b, n.unArg, sibs, pos)
  }
  // A parenthesised call statement is that call statement, as legacy's `emitStmt` has it.
  if n is Paren && nodeAt(unwrapParen(ix)) is Call {
    return stmtNode(b, unwrapParen(ix), sibs, pos)
  }
  if n is Call {
    if isPopStmt(n) { return popStmt(b, n, ix) }
    if isListClearStmt(n) { return clearStmt(b, n, ix) }
    if isMapClearStmt(n) { return mapClearStmt(b, n, ix) }
    const ms = mapSetCallOf(n)
    if ms >= 0 && n.callFn < P.nodes.length {
      const mf = nodeAt(n.callFn)
      if !(mf is Member) { return skip("map store callee") }
      if ms == 1 { return mapSet(b, mf.memObj, n.callArgs[0], -1, ix) }
      return mapSet(b, mf.memObj, n.callArgs[0], n.callArgs[1], ix)
    }
    if isPrintStmt(n) { return printStmt(b, n, ix) }
    if trapCallNamed(n, ibFnIx) && identDeclOf(n.callFn) < 0 {
      return trapStmt(b, n, ix)
    }
    if arrCopyCallNamed(n, ibFnIx) { return listCopyStmt(b, n, ix) }
    // A call through a tagged function set is legacy's dispatch, its value dropped.
    if callStmtDispatches(ix, ibFnIx) {
      if tagDispatchStmtIsVoid(ix) { return tagDispatchVoid(b, ix) }
      const v = tagDispatchAt(b, ix, false)
      if ibMiss != "" { return 0 }
      irBNode(b, { dpV: v }, -1, ibNoValue, ix)
      return 0
    }
    if tplStrHoleOf(n, ibFnIx) >= 0 {
      const hv = tplHoleStr(b, n)
      if ibMiss != "" { return 0 }
      irBNode(b, { dpV: hv }, -1, ibNoValue, ix)
      return 0
    }
    const rhs = callRhs(b, n, ix)
    if ibMiss != "" { return 0 }
    // A discarded slice or map delete is a value legacy evaluates and drops.
    if rhs is RListSlice || rhs is RMapDelete {
      const sr = exprRepOf(ix)
      if sr < 0 { return skip("slice statement rep") }
      const v = irBLetTemp(b, rhs, ix, sr)
      if ibMiss != "" { return 0 }
      irBNode(b, { dpV: v }, -1, ibNoValue, ix)
      return 0
    }
    irBNode(b, { efRhs: stmtCallRefNever(rhs, n) }, -1, ibNoValue, ix)
    return 0
  }
  // A discarded value legacy does not write: a bare function name or an inert literal.
  if stmtWritesNothing(ix) { return 0 }
  if (
    n is Paren
    || n is Ident
    || n is NumLit
    || n is BoolLit
    || n is Unary
    || n is BinExpr
    || stmtIsTailValue(ix, ibFnIx)
  ) {
    // Legacy evaluates a bare value and drops it.
    const v = irBExpr(b, ix)
    if ibMiss != "" { return 0 }
    irBNode(b, { dpV: v }, -1, ibNoValue, ix)
    return 0
  }
  skip("statement")
}

// Whether `return ix` is legacy's tail `if` (`emitIfTail`): a returned value `if`.
function retIsValueIf(ix: i32): boolean {
  const u = unwrapParen(ix)
  if u < 0 || u >= P.nodes.length || !(nodeAt(u) is IfStmt) { return false }
  return lastStmtIsValueIf(u, ibFnIx) || elseLessNullableTail(u, ibFnIx)
}

// A non-void body's tail. An expression body's one statement is its value; a block body's last
// statement is a statement, and a body that runs past it, or has none, falls into legacy's pad.
function tailReturn(b: i32[], stmts: i32[], at: i32) {
  if stmts.length == 0 { return 0 }
  let i = 0
  while i < stmts.length - 1 {
    stmtAt(b, stmts, i)
    if blockCut(b) { return 0 }
    i = i + 1
  }
  const last = stmts[stmts.length - 1]
  // A block body's last statement is a statement, a value `if` included: legacy takes only an
  // expression body's statement as its tail (`emitFuncBody`), and the lowering pads past it.
  if isBlockBody(at) {
    stmt(b, last, stmts, stmts.length - 1)
    return 0
  }
  const ln = nodeAt(last)
  if ln is IfStmt && lastStmtIsValueIf(last, ibFnIx) {
    // The body's tail `if` is a body statement, which legacy banks a row for.
    const n0 = b.length
    tailIf(b, last)
    if ibMiss == "" && b.length > n0 {
      irSpanNote(ib, last, b[n0], b[b.length - 1])
    }
    return 0
  }
  if ln is IfStmt && elseLessNullableTail(last, ibFnIx) {
    return skip("else-less nullable tail")
  }
  if ln is RetStmt || ln is IfStmt {
    const past = ibMissesPast
    stmt(b, last, stmts, stmts.length - 1)
    // A tail `if` whose arms yield values rather than returning is I1's (`siOut`). An arm the
    // census built past a miss in is incomplete, not valued.
    if ibMiss == "" && past == ibMissesPast && !irBodyLeaves(ib, b) {
      return skip("valued tail if")
    }
    return 0
  }
  const n0 = b.length
  if retRefusedWhy(last, ibFnIx) != "" { return skip("return refused") }
  const v0 = retDelivered(b, last)
  if ibMiss != "" { return 0 }
  const v = irConvert(b, v0, ib.irRetRep, ib.irRetTy, last)
  if ibMiss != "" { return 0 }
  irBNode(b, { rtHas: true, rtV: v }, -1, ibNoValue, at)
  irSpanNote(ib, last, b[n0], b[b.length - 1])
  return 0
}

// Returned value `arg` delivered at the result's rep. One the checker records no box at is boxed
// at the return's own union, legacy's return floor (`retUnionTyOf`); a `null` literal there is
// that union's null box.
function retDelivered(b: i32[], arg: i32): Opnd {
  const r = ib.irRetRep
  const ru = if heldAsBox(r) && !boxOwedAt(arg, ibFnIx) { retUnionTyOf(ibFnIx, ibFnPos) } else { -1 }
  const fu = if ru >= 0 && repNodeOfTy(ru) == r { ru } else { -1 }
  if fu >= 0 && nodeAt(unwrapParen(arg)) is NullLit {
    const nulV: Opnd = { oiRep: ibNoValue, oiBits: 0 }
    return boxTempIn(b, nulV, arg, r, -1, fu)
  }
  // A returned `Map()` is built at the result's map, the shape legacy's constructor writes for
  // this instance (`mapNewShapeOf`), where a generic's shared node is typed at its template.
  const ux = unwrapParen(arg)
  const un = if ux >= 0 && ux < P.nodes.length { nodeAt(ux) } else { null }
  if (
    un is Call
    && mapNewCall(un)
    && repNodeAt(r) is RMap
    && exprPrePathWhy(ux, ibFnIx) == ""
  ) {
    return irBLetTempTy(b, { mnAt: ux }, ux, r, ib.irRetTy)
  }
  // A struct literal legacy builds at its layout row, where that row is the result's own
  // (`fRetStructIdx`), is the result's value as written there (`emitReturnPlainValue`): built at
  // the result's rep and type.
  if (
    un is ObjLit
    && objLitArmOf(ux, ibFnIx) == "struct"
    && repNodeAt(r) is RRecord
    && !irTyOpen(ib.irRetTy)
    && exprPrePathWhy(ux, ibFnIx) == ""
  ) {
    const row = objLitLayoutRowOf(ux, ibFnIx)
    const rs = if (ibFnPos >= 0
      && ibFnPos < fRetKind.length
      && ibFnPos < fRetStructIdx.length
      && fRetKind[ibFnPos] == "struct") { fRetStructIdx[ibFnPos] } else { structIndexOfTy(ib.irRetTy) }
    if row >= 0 && row == rs {
      if retLitFieldsAtTheirReps(ux, r, ib.irRetTy, row) {
        return objLitAt(b, ux, r, ib.irRetTy, row, false)
      }
      ibRetNestedTwin = ux
    }
  }
  const v = deliver(b, arg, r, fu)
  if ibMiss == "" && fu >= 0 && irBOpRep(v) != r {
    return boxTempIn(b, v, arg, r, -1, fu)
  }
  return retRecover(b, v, arg)
}

// Whether each struct literal among record literal `ix`'s field values (at row `row` of rep `r`,
// type `ty`) is built at its field's own rep, or that rep's inner where the field is nullable: a
// nested literal at another rep of the same row would take a retag the result does not owe.
function retLitFieldsAtTheirReps(ix: i32, r: i32, ty: i32, row: i32): boolean {
  const ks = repNodeKids(r)
  let i = 0
  while i < sFieldCount[row] {
    const name = sFieldNames[sFieldStart[row] + i]
    const v = unwrapParen(objFieldVal(ix, name))
    if v >= 0 && nodeAt(v) is ObjLit && objLitArmOf(v, ibFnIx) == "struct" {
      const k = repRecordKidOf(r, ty, name)
      if k < 0 || k >= ks.length { return false }
      const kn = repNodeAt(ks[k])
      const want = if kn is RNullable { kn.rnInner } else { ks[k] }
      const vr = sFieldRowRep(objLitLayoutRowOf(v, ibFnIx))
      if vr < 0 || vr != want { return false }
    }
    i = i + 1
  }
  return true
}

// The rep a struct literal laid out at row `row` is built at: the row's recorded type's, or -1.
function sFieldRowRep(row: i32): i32 {
  if row < 0 || row >= sTyIx.length { return -1 }
  const rt = sTyIx[row]
  return if rt >= 0 && rowTyBuildsAt(rt, row) { repNodeOfTy(rt) } else { -1 }
}

// Returned value `v` of `arg` at the result's rep where legacy's plain return writes a
// `ref.as_non_null` after it (`retNeedsNonNullRecover`): a nullable value whose inner rep is the
// result's. Any other value as it stands.
function retRecover(b: i32[], v: Opnd, arg: i32): Opnd {
  if ibMiss != "" { return v }
  const r = ib.irRetRep
  const vn = repNodeAt(irBOpRep(v))
  if !(vn is RNullable) || vn.rnInner != r { return v }
  const fn = nodeAt(ibFnIx)
  const fp = if fn is FuncDecl && fn.fnRet < 0 { fnStmtsPosOf(ibFnIx) } else { -1 }
  if !retNeedsNonNullRecover(arg, ibFnIx, fp) { return v }
  const rc: Rhs = { rcV: v, rcAt: arg, rcNn: 1 }
  return irBLetTempTy(b, rc, arg, r, ib.irRetTy)
}

// A value `if` in tail position (legacy's `emitIfTail`): the statement `if` with each arm's last
// value returned, its `else if` the chain's next link.
function tailIf(b: i32[], ix: i32) {
  const n = nodeAt(ix)
  if !(n is IfStmt) { return skip("tail if node") }
  const why = tailIfPlainWhy(ix, ibFnIx)
  if why == "tail if switch" {
    const p = intSwitchPlanOf(ix, ibFnIx)
    if p != null { return intSwitch(b, ix, p, true) }
  } else if why == "tail if one number" {
    return tailIfOneNumber(b, ix)
  } else if why != "" {
    return skip(why)
  }
  // A decided `false` `is` writes no then arm (`emitGuardCond`); another constant `is` is one
  // legacy decides off its bytes, so it is a miss.
  const decided = isDecidedFalse(n.ifCond, ibFnIx)
  const no: Opnd = { oiRep: ibBool, oiBits: 0 }
  const cat = b.length
  const c = if decided { no } else { irBExpr(b, n.ifCond) }
  if ibMiss != "" || irBOpRep(c) != ibBool { return skip("condition") }
  // Another constant `is` legacy decides off its bytes (`emitGuardCond`): a `false` writes no
  // then arm, a `true` no `else`.
  const k = if !decided && c is OImm && bareConstIs(c, n.ifCond, b, cat) { if c.oiBits != 0 { 1 } else { 0 } } else { -1 }
  const thenB = if decided || k == 0 { [] } else { tailArm(n.ifThen) }
  // An else-less link writes no `else` (`emitIfLinkTail`); what falls through is its caller's pad.
  const elseB: i32[] = []
  const hasElse = n.ifElse >= 0 && k != 1
  if hasElse && n.ifElse < P.nodes.length && nodeAt(n.ifElse) is IfStmt {
    tailIf(elseB, n.ifElse)
  } else if hasElse {
    const eb = tailArm(n.ifElse)
    for x in eb { elseB.push(x) }
  }
  if ibMiss != "" { return 0 }
  irBNode(b, sIf(c, thenB, elseB, -1, hasElse), -1, ibNoValue, ix)
  return 0
}

// A tail `if` typed one wider number (`retIfIsOneNumber`): that number, each arm widened to it,
// boxed once into the result and returned, as legacy's `emitReturnExit` writes it.
function tailIfOneNumber(b: i32[], ix: i32) {
  const r = ib.irRetRep
  const ru = retUnionTyOf(ibFnIx, ibFnPos)
  if !heldAsBox(r) || ru < 0 || repNodeOfTy(ru) != r {
    return skip("tail if one number")
  }
  const v = floorDeliver(b, ix, r, ru)
  if ibMiss != "" { return 0 }
  if irBOpRep(v) != r { return skip("tail if one number rep") }
  irBNode(b, { rtHas: true, rtV: v }, -1, ibNoValue, ix)
  return 0
}

// A tail `if` arm: its statements, the last returned when it is a value or a nested value `if`.
function tailArm(blockIx: i32): i32[] {
  const body: i32[] = []
  const stmts = elseStmts(blockIx)
  if stmts.length == 0 {
    skip("dead tail arm")
    return body
  }
  const dead = blockTailIsDead(stmts)
  // A dead tail's nested function declaration still takes legacy's statement path.
  if dead && nodeAt(stmts[stmts.length - 1]) is FuncDecl {
    skip("dead tail declaration")
    return body
  }
  let i = 0
  // Legacy lowers an arm's prelude by `emitStmtIn`, which banks no row of its own.
  while i < stmts.length - 1 {
    stmtNode(body, stmts[i], stmts, i)
    i = i + 1
  }
  // Past an exit, legacy writes the dead tail as `unreachable` (`emitDeadTail`).
  if dead {
    irBNode(body, { tpWhy: 0 }, -1, ibNoValue, stmts[stmts.length - 1])
    return body
  }
  const last = stmts[stmts.length - 1]
  const ln = nodeAt(last)
  // An else-less `if` ending an arm is a `T | null` value: legacy's `emitStmtTail` writes it as a
  // tail link with no `else`, and the body's pad returns what falls through.
  if (
    ln is IfStmt
    && (lastStmtIsValueIf(last, ibFnIx) || elseLessNullableTail(last, ibFnIx))
  ) {
    tailIf(body, last)
    return body
  }
  if ln is RetStmt || ln is IfStmt || ifArmValueExpr(blockIx) != last {
    stmt(body, last, stmts, stmts.length - 1)
    if ibMiss == "" && !irBodyLeaves(ib, body) { skip("tail arm") }
    return body
  }
  // An arm value legacy writes as a statement (`tailArmStmtIsValue`), such as a call that never
  // returns, goes through `emitStmt`, which banks no row of its own.
  if !tailArmStmtIsValue(last, ibFnIx) {
    stmtNode(body, last, stmts, stmts.length - 1)
    if ibMiss == "" && !irBodyLeaves(ib, body) { skip("tail arm") }
    return body
  }
  if retRefusedWhy(last, ibFnIx) != "" {
    skip("return refused")
    return body
  }
  const v0 = retRecover(body, deliver(body, last, ib.irRetRep, -1), last)
  if ibMiss != "" { return body }
  // A scalar arm value at a boxed result is boxed at the result's union, the box plan legacy's
  // owed box writes (`emitUnionBoxOwed`).
  const v1 = if irBOpRep(v0) != ib.irRetRep
    && heldAsBox(ib.irRetRep)
    && repPrim(irBOpRep(v0)) != null { boxTempIn(body, v0, last, ib.irRetRep, -1, ib.irRetTy) } else { v0 }
  const v = irConvert(body, v1, ib.irRetRep, ib.irRetTy, last)
  if ibMiss != "" { return body }
  // Legacy banks no statement row for an arm's tail value (`emitTailReturnExit`).
  irBNode(body, { rtHas: true, rtV: v }, -1, ibNoValue, last)
  return body
}

// Builds the IR of the function at `fnIx` (`fnStmts` slot `fnPos`), or "" plus a reason.
function build(fnIx: i32, fnPos: i32): string {
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return "not a function" }
  ibReset(fnIx, fn.fnName, fnPos)
  if fn.fnTyParams.length > 0 { return "template" }
  ib.irRetTy = resultTy(fnPos, fn.fnRet, fnIx)
  ib.irRetRep = resultRep(fnPos, fn.fnRet, fnIx)
  const none = repIsNoValue(ib.irRetRep)
  if !(valueRep(ib.irRetRep, ib.irRetTy) || none) {
    if !censusGoesOn("result rep " + repWhat(ib.irRetRep)) {
      return "result rep " + repWhat(ib.irRetRep)
    }
  }
  ibNoValue = if none { ib.irRetRep } else { -1 }
  const pw = buildParams(fn, fnIx, true)
  if pw != "" { return pw }
  ib.irRetExtra = liftRetExtra(fnPos)
  if ibMiss != "" { return ibMiss }
  if ibNoValue < 0 { ibNoValue = repNodeOfTy(TY_NEVER) }
  if !repIsNoValue(ibNoValue) { return "no void rep" }
  if fn.fnBody < 0 || fn.fnBody >= P.nodes.length { return "body" }
  const body = nodeAt(fn.fnBody)
  if !(body is Block) { return "body" }
  const top: i32[] = []
  if none {
    stmtRun(top, body.blkStmts)
  } else {
    tailReturn(top, body.blkStmts, fn.fnBody)
  }
  ib.irBody = top
  return ibMiss
}

// Verifies `f` once the facts its checks read are noted on it (`irNoteVerifyFacts`).
function irBVerify(f: IrFn): IrVerdict {
  irNoteVerifyFacts(f)
  return irVerify(f)
}

// Starts building function `fnIx` (named `name`, at `fnStmts` slot `fnPos`) into a fresh `ib`.
function ibReset(fnIx: i32, name: string, fnPos: i32) {
  ib = irFnNew(fnIx, name)
  ib.irEndPad = fnFallThroughPadOf(fnIx)
  ibFnIx = fnIx
  ibFnPos = fnPos
  ibRetNestedTwin = -1
  ibDeclRowSeen = false
  ibCalleeParamAt = Map()
  ibCalleeParamFn = Map()
  ibMiss = ""
  ibMissAt = -1
  ibStubRhs = -1
  ibAliasRhs = -1
  ibMisses = []
  ibReserveEnd = []
  ibReservePushes = []
  lbPlanDrop(null)
  ibRangeImmAt = []
  ibRangeImmVal = []
  ibLinkIfTy = Map()
  ibDeclVar = Map()
  ibLiftCapDecl = Map()
  ibOwnDecls = Map()
  ibOwnByOrig = Map()
  ibOwnBuilt = false
  ibStartRoots = []
  ibLoopName = []
  ibLoopBrk = []
  ibLoopCont = []
  ibLvOf = Map()
  ibLabelN = 0
  ibFitShName = []
  ibFitShTy = []
  ibFitShRecv = []
  ibFitShVar = []
  ibBool = repNodeOfTy(TY_BOOL)
  return 0
}

// Parameter `p`'s type as legacy holds it: a bundle parameter's open type is the record of one
// closure per signature it is called at (`bundleRecordTyOf`), else its checker type, closed at the
// instance the checker recorded.
function paramHeldTy(p: i32, fnIx: i32): i32 {
  const ty = bundleHeldTy(p, heldTy(paramCheckedTy(p, fnIx)))
  if bundleSigsOfParam(p).length > 0 { return ty }
  if vtKindOfParam(p) != "struct" || paramStructIdxOf(p) < 0 { return ty }
  if repRowOfTyStruct(ty, repScanLim()) == paramStructIdxOf(p) { return ty }
  const dt = paramDeclRowTy(p)
  if dt < 0 { return ty }
  ibDeclRowSeen = true
  return dt
}

// The type a call to `fnIx` delivers parameter `p` at, which its signature notes: a struct
// parameter at legacy's declared row where its checked type's row is another (`paramHeldTy`).
function calleeParamTy(p: i32, fnIx: i32): i32 {
  const ty = bundleHeldTy(p, paramCheckedTy(p, fnIx))
  if !tyIsRecord(ty) || irTyOpen(ty) { return ty }
  const k = ibCalleeParamAt[p] ?? -1
  if k >= 0 && (ibCalleeParamFn[p] ?? -1) == fnIx { return k }
  const si = if vtKindOfParam(p) == "struct" && bundleSigsOfParam(p).length == 0 { paramStructIdxOf(p) } else { -1 }
  const dt = if si >= 0 && repRowOfTyStruct(ty, repScanLim()) != si { declRowTy(si) } else { -1 }
  const r = if dt >= 0 { dt } else { ty }
  ibCalleeParamAt[p] = r
  ibCalleeParamFn[p] = fnIx
  return r
}

// `calleeParamTy`'s answers for the function being built, by parameter node, each beside the
// callee it answers for.
let ibCalleeParamAt: {[i32]: i32} = Map()
let ibCalleeParamFn: {[i32]: i32} = Map()

// Parameter `p`'s type in `fnIx`: its scope's, else, in a clone whose nodes carry none (a baked
// callback's), the annotation legacy's valtype reads (`annTyOf(parTyNode(p))`).
function paramCheckedTy(p: i32, fnIx: i32): i32 {
  const t = scopeTyAt(p, fnIx)
  return if t >= 0 { t } else { annTyOf(parTyNode(p)) }
}

// The record type struct row `si` stores (`slotRowTyOf`) where it is closed and its row is `si`
// again, else -1: the caller keeps the checker's type (the fallback).
function declRowTy(si: i32): i32 {
  const t = slotRowTyOf(si)
  if t < 0 || irTyOpen(t) { return -1 }
  return if repRowOfTyStruct(t, repScanLim()) == si { t } else { -1 }
}

// The variable of read `ix` where the IR holds it at legacy's declared row: a parameter's
// (`paramDeclRowTy`), or a `let`'s retyped to its slot's declared row (`declRowLetTy`); or -1.
function declRowParamVarOf(ix: i32): i32 {
  if !ibDeclRowSeen { return -1 }
  if ix < 0 || ix >= P.nodes.length || !(nodeAt(ix) is Ident) { return -1 }
  const d = identDeclOf(ix)
  if d < 0 || d >= P.nodes.length { return -1 }
  const v = boundVarOf(ix)
  if v < 0 || ibFnIx < 0 || ibFnIx >= P.nodes.length { return -1 }
  if !(repNodeAt(ib.irVars[v].vRep) is RRecord) { return -1 }
  const dn = nodeAt(d)
  if dn is LetDecl {
    const st = irSlotRowTy(ib.irVars[v].vSlot)
    if st < 0 || ib.irVars[v].vTy != st { return -1 }
    if st != heldTy(scopeTyAt(d, ibFnIx)) { return v }
    // A read typed at a record whose row is not the slot's reads the row the slot is declared at.
    const t = nodeTyAt(ix, ibFnIx)
    if t < 0 || t == st || !(repNodeAt(repNodeOfTy(t)) is RRecord) { return -1 }
    return if repRowOfTyStruct(t, repScanLim()) != repRowOfTyStruct(st, repScanLim()) { v } else { -1 }
  }
  if !(dn is Param) { return -1 }
  const fn = nodeAt(ibFnIx)
  if !(fn is FuncDecl) { return -1 }
  const i = ib.irVars[v].vSlot - envSlotShift(ibFnIx)
  if i < 0 || i >= fn.fnParams.length { return -1 }
  return if ib.irVars[v].vTy == paramDeclRowTy(fn.fnParams[i]) { v } else { -1 }
}

// Whether `let` `d` is initialized by a record literal whose own type's row is not the row its
// slot is declared at, so legacy builds it at the slot's (D16463) and a read may be of that row.
function letLitUndeclaredRow(d: i32): boolean {
  if d < 0 || d >= P.nodes.length { return false }
  const n = nodeAt(d)
  if !(n is LetDecl) || n.letInit < 0 { return false }
  const init = unwrapParen(n.letInit)
  if init < 0 || init >= P.nodes.length || !(nodeAt(init) is ObjLit) {
    return false
  }
  const t = nodeTyAt(init, ibFnIx)
  const s = declaredSlotOfDecl(d)
  const st = irSlotRowTy(if s >= 0 { declaredIndexAt(ibFnIx, s) } else { -1 })
  if t < 0 || st < 0 { return false }
  return repRowOfTyStruct(t, repScanLim()) != repRowOfTyStruct(st, repScanLim())
}

// The type a receiver `ix` is held at where that is legacy's row and not its own: a parameter's
// declared row (`declRowParamVarOf`), a local's (`rowlessLetTy`), or a built value's storage row
// (`rowlessRecordRep`); else -1.
export function declRowReadTy(ix: i32): i32 {
  const u = unwrapParen(ix)
  const v = declRowParamVarOf(u)
  if v >= 0 { return ib.irVars[v].vTy }
  if u < 0 || u >= P.nodes.length { return -1 }
  const un = nodeAt(u)
  if !(un is Ident) {
    if un is Member { return -1 }
    const bt = exprTyOf(u)
    const br = repNodeOfTy(bt)
    if !rowlessRecord(bt, br) { return -1 }
    const rt = rowlessRecordTy(u, bt, exprRepOf(u))
    return if rt != bt { rt } else { -1 }
  }
  const d = identDeclOf(u)
  const lv = if d >= 0 { ibDeclVar[d] ?? -1 } else { -1 }
  if lv < 0 { return boundRowlessReadTy(u) }
  const t = heldTy(scopeTyAt(d, ibFnIx))
  // Only a local the place half moved holds a rep its type does not give.
  if ib.irVars[lv].vRep == repNodeOfTy(t) { return boundRowlessReadTy(u) }
  const rl = rowlessLetTy(d, t, repNodeOfTy(t))
  return if rl >= 0 && rl == ib.irVars[lv].vTy { rl } else { boundRowlessReadTy(u) }
}

// The record type name read `u` is held at where its variable (a parameter, or a local) holds a
// record row the read's type does not: a record no struct row records, or one stored at another
// row, which a `let`'s read also takes (`declRowParamVarOf`); else -1.
function boundRowlessReadTy(u: i32): i32 {
  return rowlessReadTyOfVar(u, boundVarOf(u))
}

// `boundRowlessReadTy` for read `u` of variable `v`, which any local read names, a loop's own.
function rowlessReadTyOfVar(u: i32, v: i32): i32 {
  if v < 0 { return -1 }
  return rowlessReadTyAt(nodeTyAt(u, ibFnIx), ib.irVars[v].vTy)
}

// The type `vt` a place is held at where a read of it typed `t` names a record row `vt` does not
// record, or none (`rowlessStoredTy`); -1 when the two agree.
function rowlessReadTyAt(t: i32, vt: i32): i32 {
  const r = repNodeOfTy(t)
  const rl = rowlessStoredTy(t, r, vt)
  if rl >= 0 { return rl }
  if t < 0 || vt < 0 || t == vt || !(repNodeAt(r) is RRecord) { return -1 }
  if !(repNodeAt(repNodeOfTy(vt)) is RRecord) { return -1 }
  const a = repRowOfTyStruct(t, repScanLim())
  const c = repRowOfTyStruct(vt, repScanLim())
  return if a >= 0 && c >= 0 && a != c { vt } else { -1 }
}

// The record type of the struct row legacy declares parameter `p` at (`paramStructIdxOf`), or -1.
function paramDeclRowTy(p: i32): i32 {
  if vtKindOfParam(p) != "struct" || paramStructIdxOf(p) < 0 { return -1 }
  return declRowTy(paramStructIdxOf(p))
}

// Bundle parameter `p`'s open type `ty` as its record of one closure per signature; any other
// parameter's type as it is.
function bundleHeldTy(p: i32, ty: i32): i32 {
  const sigs = bundleSigsOfParam(p)
  if sigs.length == 0 { return ty }
  // Legacy stores a bundle parameter as its record (`vtKindOfParam`), whatever its checked type.
  if irTyOpen(ty) || vtKindOfParam(p) == "struct" {
    return bundleRecordTyOf(sigs)
  }
  return ty
}

// The type parameter `p` of `fnIx` is held at: its own (`paramHeldTy`), or, where that has no value
// rep or is open, the closed closure type every caller binds a hole parameter to (`parTyNode`), else
// the one legacy's declared descriptor for it names alone (`repDescTy`).
function paramFrameTy(p: i32, fnIx: i32): i32 {
  const ty = paramHeldTy(p, fnIx)
  const r = repNodeOfTy(ty)
  if !isVoidTy(ty) && valueRep(r, ty) && !irTyHeldOpen(ty, r) { return ty }
  const pt = parTyNode(p)
  if (
    vtKindOfParam(p) == "closure"
    && pt >= 0
    && !irTyOpen(pt)
    && repNodeAt(repNodeOfTy(pt)) is RClosure
  ) {
    return pt
  }
  const dt = repDescTy(repDescRet(vtKindOfParam(p), paramStructIdxOf(p), ""))
  return if dt >= 0 { dt } else { ty }
}

// The variables of `fn`'s parameters, in legacy's slots past the environment; "" or the miss. A
// fragment's (`whole` false) leaves out a parameter it could not hold, so only reading it misses.
function buildParams(fn: FuncDecl, fnIx: i32, whole: boolean): string {
  const shift = envSlotShift(fnIx)
  let i = 0
  while i < fn.fnParams.length {
    const p = fn.fnParams[i]
    const ty = paramFrameTy(p, fnIx)
    const r = repNodeOfTy(ty)
    if !whole && (isVoidTy(ty) || !valueRep(r, ty) || irTyHeldOpen(ty, r)) {
      i = i + 1
      continue
    }
    if isVoidTy(ty) || !valueRep(r, ty) {
      if !censusGoesOn("parameter rep " + repWhat(r)) {
        return "parameter rep " + repWhat(r)
      }
    }
    // An unannotated parameter's type is open until a call instances it.
    if irTyHeldOpen(ty, r) && !censusGoesOn("open parameter type") {
      return "open parameter type"
    }
    const v = irVarNew(ib, r, ty, "param", shift + i)
    ibDeclVar[p] = v
    ib.irParams.push(v)
    i = i + 1
  }
  return ""
}

// The builder's whole state, saved around a fragment built while another build is open.
type IbFrame = {
  bfIb: IrFn,
  bfFnIx: i32,
  bfFnPos: i32,
  bfDeclRowSeen: boolean,
  bfMiss: string,
  bfMisses: string[],
  bfDeclVar: {[i32]: i32},
  bfLoopName: string[],
  bfLoopBrk: i32[],
  bfLoopCont: i32[],
  bfLabelN: i32,
  bfBool: i32,
  bfNoValue: i32,
}

function ibSave(): IbFrame {
  const f: IbFrame = {
    bfIb: ib,
    bfFnIx: ibFnIx,
    bfFnPos: ibFnPos,
    bfDeclRowSeen: ibDeclRowSeen,
    bfMiss: ibMiss,
    bfMisses: ibMisses,
    bfDeclVar: ibDeclVar,
    bfLoopName: ibLoopName,
    bfLoopBrk: ibLoopBrk,
    bfLoopCont: ibLoopCont,
    bfLabelN: ibLabelN,
    bfBool: ibBool,
    bfNoValue: ibNoValue,
  }
  return f
}

function ibRestore(f: IbFrame) {
  ib = f.bfIb
  ibFnIx = f.bfFnIx
  ibFnPos = f.bfFnPos
  ibRetNestedTwin = -1
  ibDeclRowSeen = f.bfDeclRowSeen
  ibMiss = f.bfMiss
  ibMisses = f.bfMisses
  ibDeclVar = f.bfDeclVar
  ibLoopName = f.bfLoopName
  ibLoopBrk = f.bfLoopBrk
  ibLoopCont = f.bfLoopCont
  ibLabelN = f.bfLabelN
  ibBool = f.bfBool
  ibNoValue = f.bfNoValue
  return 0
}

// The op seam's legacy-to-IR door: node `ix` of function `fnIx` lowered onto the buffer legacy is
// writing, at the rep of `ty` (-1: the node's type), in legacy's frame (live slots, no new local).
// "" when written; else the miss, nothing written: a live legacy context (`legacyContextLiveWhy`; a
// `probe` skips it and banks no row), a build, rep-epoch, verifier or lowering miss.
function irLowerNodeIn(ix: i32, fnIx: i32, ty: i32, probe: boolean): string {
  if !probe {
    const live = legacyContextLiveWhy(ix)
    if live != "" { return "legacy context live: " + live }
  }
  const sv = ibSave()
  const why = lowerNodeIn(ix, fnIx, ty, probe, -1, -1)
  ibRestore(sv)
  return why
}

// Global `gi`'s constant initializer (statement `gst`) lowered onto the buffer the global section
// is writing: its value delivered at the cell's rep, as a start body's initializer is, with no
// frame. "" when written; else the miss, nothing written.
export function irLowerConstCell(gi: i32, gst: i32, probe: boolean): string {
  const g = nodeAt(gst)
  if !(g is LetDecl) || g.letInit < 0 { return "const cell not a binding" }
  const sv = ibSave()
  const why = lowerNodeIn(g.letInit, -1, -1, probe, gi, gst)
  ibRestore(sv)
  return why
}

// The claim seam for global `gi`'s constant initializer: unarmed and every node in a claimed family,
// the IR writes it and this answers true, so legacy does not; armed, legacy always runs.
export function irClaimConstCell(gi: i32, gst: i32): boolean {
  if ibArmed { return false }
  const s = claimScopeBegin()
  const why = irLowerConstCell(gi, gst, false)
  claimScopeEnd(s, why == "")
  if why != "" {
    if why.indexOf("a legacy helper refused in ") == 0 {
      count("claim fell back: const cell " + why)
    }
    return false
  }
  count("claimed const cell")
  return true
}

// Under the armed shadow, the per-occurrence count of a legacy site (ir-design §10): node `ix` of
// `fnIx` at type `ty`, legacy's bytes for it in the current buffer from `from` on, lowered as a
// fragment into a scratch buffer and counted `node-in <kind>: matched`, `differ` or `miss <why>`.
export function irNodeInShadow(
  ix: i32,
  fnIx: i32,
  ty: i32,
  from: i32,
  before: LiFrame,
): i32 {
  if !ibArmed { return 0 }
  // The probe allocates scratch rows from the frame legacy began with, then legacy's are put back.
  const after = liFrameSave()
  liFrameRestore(before)
  const row = nodeInShadowGo(ix, fnIx, ty, from)
  liFrameRestore(after)
  return row
}

function nodeInShadowGo(ix: i32, fnIx: i32, ty: i32, from: i32): i32 {
  const live = legacyContextLiveWhy(ix)
  if live != "" { count("node-in context live: " + live) }
  if ibCorrupt == 6 { heldControl(ix, fnIx) }
  const cur = wTarget([])
  const why = irLowerNodeIn(ix, fnIx, ty, true)
  const got = wTarget(cur)
  let row = "matched"
  if why != "" {
    row = "miss " + why
  } else if !bytesFrom(cur, from, got) {
    row = "differ"
    if ibDetail {
      row = row + " " + irHexOf(cur.slice(from)) + "| " + irHexOf(got)
    }
  }
  return count("node-in " + irAstKind(ix) + ": " + row)
}

// Under the armed shadow, global `gi`'s constant initializer `ix` (statement `gst`, arm `arm`),
// legacy's bytes for it from `from` on, lowered as a fragment: `const cell <arm> <kind>: matched`
// or `miss <why>`, and a differ as `mismatch bytes: const cell <arm> <kind>`.
export function irConstCellShadow(
  gi: i32,
  gst: i32,
  ix: i32,
  from: i32,
  arm: string,
): i32 {
  if !ibArmed { return 0 }
  const live = legacyContextLiveWhy(ix)
  const cur = wTarget([])
  const why = irLowerConstCell(gi, gst, true)
  const got = wTarget(cur)
  // The dual emit's control 3 adds a byte to the fragment, which must turn a match into a differ.
  if ibCorrupt == 3 && why == "" { got.push(1) }
  const at = arm + " " + irAstKind(ix)
  if why == "" && !bytesFrom(cur, from, got) {
    // A differ is a mismatch, so the corpus baseline and the bytes veto see it.
    const hex = if ibDetail { " " + irHexOf(cur.slice(from)) + "| " + irHexOf(got) } else { "" }
    return count("mismatch bytes: const cell " + at + hex)
  }
  const row = if why != "" { "miss " + why } else { "matched" }
  const under = if live != "" { " under " + live } else { "" }
  return count("const cell " + at + ": " + row + under)
}

// The held-coercion control (`irShadowCorrupt(6)`): the guard read with the mark on the fragment's
// root, then on its enclosing function, an ancestor; the first must name it and the second not.
function heldControl(ix: i32, fnIx: i32) {
  const was = coerceHeldSwap(ix)
  count("node-in held root: " + legacyContextLiveWhy(ix))
  coerceHeldSwap(fnIx)
  count("node-in held ancestor: " + legacyContextLiveWhy(ix))
  coerceHeldSwap(was)
  return 0
}

// Whether `b` from `at` on holds exactly `want`.
function bytesFrom(b: u8[], at: i32, want: u8[]): boolean {
  if at < 0 || b.length - at != want.length { return false }
  let i = 0
  while i < want.length {
    if b[at + i] != want[i] { return false }
    i = i + 1
  }
  return true
}

function lowerNodeIn(
  ix: i32,
  fnIx: i32,
  ty: i32,
  probe: boolean,
  cellGi: i32,
  cellSt: i32,
): string {
  const gen = repNodeGen()
  // An append the fragment holds reads the accumulator rows, which a rescan would rewrite under
  // legacy's own emit of this body. A constant initializer holds no assignment.
  if !gConstExprEmit && !strAccRowsAre(fnIx) {
    return "string accumulator rows"
  }
  let fnPos = -1
  if fnIx < 0 {
    // A start body's top-level code, under the guards its whole build takes (`buildStart`).
    // A const cell's constant initializer hosts one too: it has no frame, so no variable.
    if !gPromoInStart && !gConstExprEmit { return "fragment outside a body" }
    // The progress cell is the start body's to write between statements; a constant has none.
    if gInitProgIdx >= 0 && !gConstExprEmit { return "progress cell" }
    ibReset(-1, "@fragment", -1)
  } else {
    if fnIx >= P.nodes.length { return "fragment outside a body" }
    const fn = nodeAt(fnIx)
    if !(fn is FuncDecl) { return "fragment outside a body" }
    if fn.fnTyParams.length > 0 { return "template" }
    fnPos = fnStmtsPosOf(fnIx)
    ibReset(fnIx, fn.fnName, fnPos)
    buildParams(fn, fnIx, false)
  }
  ib.irFragment = true
  ibNoValue = repNodeOfTy(TY_NEVER)
  ib.irRetRep = ibNoValue
  ib.irRetTy = TY_NEVER
  const top: i32[] = []
  // A const cell's value is delivered at the cell's rep, as `globalInit` delivers a start body's.
  const out = if cellSt >= 0 { constCellValue(top, cellGi, cellSt, ix) } else { irBExpr(top, ix) }
  ib.irBody = top
  if ibMiss != "" { return ibMiss }
  const want = if cellSt >= 0 { globalRep(cellGi, cellSt) } else { repNodeOfTy(if ty >= 0 { ty } else { nodeTyAt(ix, fnIx) }) }
  if irBOpRep(out) != want { return "fragment rep" }
  if repNodeGen() != gen { return "rep epoch moved" }
  const v = irBVerify(ib)
  if v.vfRule != 0 {
    return "verifier rule " + i32ToStr(v.vfRule) + ": " + v.vfMsg
  }
  // A variable the fragment made for a declaration it never built took its rep from the type;
  // legacy's slot holds the frame's rep, which may differ (an atom cell, a niche).
  for x in ib.irVars {
    if gConstExprEmit && x.vKind != "temp" {
      return "constant initializer variable"
    }
    if x.vKind == "local" && !irSlotRunAgrees(x.vRep, x.vSlot) {
      return "local cell rep"
    }
  }
  // A const cell ships as a function does: only when every node is in a claimed family.
  if cellSt >= 0 && !probe && !claimable() { return "unclaimed family" }
  return irLowerFragment(ib, out, globalCtxNow(), fnPos, probe)
}

// The map join's failing control (`irShadowCorrupt(7)`): a nullable map `??`'s map out moved to
// another map's rep and type, which the verifier's nullable-reference rule must refuse.
function unrelatedMapControl() {
  for n in ib.irNodes {
    if !(n is SCoalBox) || n.cbArm != "nulRef" || n.cbOut < 0 { continue }
    const o = ib.irVars[n.cbOut].vRep
    if !(repNodeAt(o) is RMap) { continue }
    for v in ib.irVars {
      if (
        repNodeAt(v.vRep) is RMap
        && v.vRep != o
        && v.vRep != repOfNulInner(irBOpRep(n.cbL))
      ) {
        ib.irVars[n.cbOut].vRep = v.vRep
        ib.irVars[n.cbOut].vTy = v.vTy
        return 0
      }
    }
  }
  return 0
}

// The operand re-read's failing control (`irShadowCorrupt(8)`): a union compare off the null leg
// marked as reading its operand again, which the verifier must refuse.
function otherAgainControl() {
  for n in ib.irNodes {
    if !(n is SLet) { continue }
    const r = n.lRhs
    if r is RUnionConcreteEq && !r.ucNul {
      r.ucOtherAgain = true
      return 0
    }
  }
  return 0
}

// The nullable compare's failing control (`irShadowCorrupt(9)`): a record compare of two
// non-nullable sides marked nullable, which verifier rule 2 must refuse.
function nulEqNoNullableControl() {
  for n in ib.irNodes {
    if !(n is SLet) { continue }
    const r = n.lRhs
    if r is RStructEq && !r.seNul {
      r.seNul = true
      return 0
    }
  }
  return 0
}

// The niche read's failing controls (`irShadowCorrupt(10)`, `(11)`): each reference niche read's
// kind moved to another shape's, forward (list, closure, map) or back, which rule 2 must refuse.
function nicheKindControl(back: boolean) {
  for n in ib.irNodes {
    if !(n is SLet) { continue }
    const r = n.lRhs
    if (
      !(r is RNicheRead)
      || r.nrKind == 1
      || r.nrKind == 2
      || r.nrKind == NICHE_NUL_LIT
    ) {
      continue
    }
    const isMap = r.nrKind == NICHE_NUL_MAP
    const isFn = r.nrKind == 11
    if back {
      r.nrKind = if isMap { 11 } else if isFn { 7 } else { NICHE_NUL_MAP }
    } else {
      r.nrKind = if isMap { 7 } else if isFn { NICHE_NUL_MAP } else { 11 }
    }
  }
  return 0
}

// The inner rep of nullable rep `r`, or -1.
function repOfNulInner(r: i32): i32 {
  const n = repNodeAt(r)
  return if n is RNullable { n.rnInner } else { -1 }
}

// The call head's failing control (`irShadowCorrupt(12)`): a staged head read by its call as a plain
// callee, which rule 10 must refuse.
function headControl() {
  for n in ib.irNodes {
    const r = if n is SLet { n.lRhs } else if n is SEffect { n.efRhs } else { null }
    if r is RCallRef && r.crHead { r.crHead = false }
  }
  return 0
}

// The failing control: breaks `ib` in the way `ibCorrupt` names.
function corrupt() {
  if ibCorrupt == 7 { unrelatedMapControl() }
  if ibCorrupt == 8 { otherAgainControl() }
  if ibCorrupt == 9 { nulEqNoNullableControl() }
  if ibCorrupt == 10 || ibCorrupt == 11 { nicheKindControl(ibCorrupt == 11) }
  if ibCorrupt == 12 { headControl() }
  if ibCorrupt == 1 && ib.irVars.length > 0 {
    const v = ib.irVars[0]
    const other = if repPrim(v.vRep) == "bool" { repNodeOfTy(TY_I32) } else { ibBool }
    v.vRep = other
  }
  if ibCorrupt == 2 {
    let i = 0
    while i < ib.irNodes.length {
      const n = ib.irNodes[i]
      if (
        n is SLet
        && n.lDst >= 0
        && n.lDst < ib.irVars.length
        && ib.irVars[n.lDst].vKind == "temp"
      ) {
        const t: IrNode = { tpWhy: 0 }
        ib.irNodes[i] = t
        return 0
      }
      i = i + 1
    }
  }
  return 0
}

// The context the function at `fnStmts` slot `fnPos` accesses globals in. The start function's
// top-level body never reaches the IR, so it is a body's.
// The context the function being built accesses globals in: the start function's, or a body's.
function ibGlobalCtx(): GlobalCtx {
  if ibFnIx >= 0 { return globalCtxOf(ibFnPos) }
  const c: GlobalCtx = { gcInStart: true, gcFnPos: -1, gcGuardOff: false }
  return c
}

function globalCtxOf(fnPos: i32): GlobalCtx {
  const c: GlobalCtx = { gcInStart: false, gcFnPos: fnPos, gcGuardOff: false }
  return c
}

// The dual emit of a verified function: its lowering against the legacy code entry `emitFuncCode`
// wrote onto `out` from `outStart`, and the span rows it banked from `spanBase`. "" when they
// match, else the mismatch class.
function dualEmit(
  pre: string,
  ctx: GlobalCtx,
  out: u8[],
  outStart: i32,
  spanBase: i32,
): string {
  const legacy: u8[] = []
  let i = outStart
  while i < out.length {
    legacy.push(out[i])
    i = i + 1
  }
  const skew = if ibCorrupt == 3 { 1 } else if ibCorrupt == 4 { 2 } else if ibCorrupt == 5 { 3 } else { 0 }
  if gPromoInStart {
    count("fail the start body reached the IR shadow")
    return "start body"
  }
  const why = irDualEmit(ib, ctx, legacy, spanBase, outStart, skew)
  if why == "" {
    count(pre + "matched")
    return ""
  }
  count("mismatch " + pre + why)
  if ibDetail && rowN("mismatch " + pre + why) <= 3 {
    count(
      "detail "
        + why
        + " in "
        + ib.irName
        + "\nlegacy "
        + irHexOf(legacy)
        + "\nir     "
        + irHexOf(irLoweredEntry())
        + "\n"
        + irFnText(ib),
    )
  }
  return why
}

// How many times row `key` has been counted.
function rowN(key: string): i32 {
  let i = 0
  while i < ibRowKey.length {
    if ibRowKey[i] == key { return ibRowN[i] }
    i = i + 1
  }
  return 0
}

// The seam: builds, verifies, lowers and discards the function at `fnIx`, counting the outcome.
export function irShadowFn(
  fnIx: i32,
  fnPos: i32,
  out: u8[],
  outStart: i32,
  spanBase: i32,
) {
  count("fns")
  const gen = repNodeGen()
  const why = build(fnIx, fnPos)
  if ibAllMiss { return censusRow(why) }
  if ibPrePost { prePostBuilt(why) }
  if why != "" {
    count("uncovered " + why)
    return 0
  }
  count("covered")
  corrupt()
  const v = irBVerify(ib)
  // A tree rebuilt mid-build leaves node indices that name nothing; no verdict holds.
  if repNodeGen() != gen {
    count("rep epoch moved")
    return 0
  }
  if v.vfRule == 0 {
    count("verified")
    const dual = dualEmit("", globalCtxOf(fnPos), out, outStart, spanBase)
    if ibPrePost && ibPreBuilt { prePostLowered(dual) }
    // A function the claim rule takes must match: a claim is never a fallback.
    if dual != "" && claimable() {
      count(
        "fail a claimable function did not match: " + dual + " in " + ib.irName,
      )
    }
    return 0
  }
  count(
    "fail rule "
      + i32ToStr(v.vfRule)
      + " in "
      + ib.irName
      + " at "
      + i32ToStr(v.vfNode)
      + ": "
      + v.vfMsg
      + "\n"
      + irFnText(ib),
  )
  return 0
}

// The seam for a start body (the single start, or an init function's, `poolFill` false): builds
// it from `order` (`orderGi` at or above 0 naming a global's initializer), verifies, lowers and
// compares it with the entry legacy wrote onto `out` from `outStart`. Rows carry a `start `
// prefix; a mismatch is `mismatch start <why>`, a failure names the body.
export function irShadowStart(
  out: u8[],
  outStart: i32,
  spanBase: i32,
  order: i32[],
  orderGi: i32[],
  poolFill: boolean,
) {
  count("start fns")
  const built = buildStart(order, orderGi, poolFill)
  // Under the census a start built on past its misses is uncovered at every class it met.
  if ibAllMiss && built != "" { censusGoesOn(built) }
  const why = if ibAllMiss { censusKey() } else { built }
  if why != "" {
    count("start uncovered " + why)
    return 0
  }
  count("start covered")
  const v = irBVerify(ib)
  if v.vfRule != 0 {
    count(
      "fail rule "
        + i32ToStr(v.vfRule)
        + " in "
        + ib.irName
        + ": "
        + v.vfMsg
        + "\n"
        + irFnText(ib),
    )
    return 0
  }
  count("start verified")
  dualEmit("start ", ibGlobalCtx(), out, outStart, spanBase)
  return 0
}

// The closure thunk of the function at `fnStmts` slot `fe`, one `collectCloThunks` gave a thunk:
// an env parameter it ignores, then the target's parameters forwarded to one call of it, a tail
// call whatever the target returns, as `emitCloThunkCode` writes it. "" or the miss.
function buildThunk(fe: i32): string {
  ib = irFnNew(-1, "@thunk")
  ib.irHelper = true
  ib.irThunk = true
  ibFnIx = -1
  ibFnPos = -1
  ibRetNestedTwin = -1
  ibMiss = ""
  ibMissAt = -1
  ibStubRhs = -1
  ibAliasRhs = -1
  ibNoValue = repNodeOfTy(TY_NEVER)
  if fe < 0 || fe >= fnStmts.length { return "thunk target" }
  const d = fnStmts[fe]
  const fn = nodeAt(d)
  if !(fn is FuncDecl) { return "thunk target" }
  ib.irName = "@thunk " + fn.fnName
  ib.irParams.push(irVarNew(ib, repRawOf(htStructHeap(), true), -1, "param", 0))
  // Each parameter is forwarded as it stands, at the rep the target's own frame gives it
  // (`buildParams`), whatever that rep is.
  const ps: i32[] = []
  const args: Opnd[] = []
  for p in fn.fnParams {
    const pt = paramFrameTy(p, d)
    const r = repNodeOfTy(pt)
    if irTyHeldOpen(pt, r) { return "thunk open parameter type" }
    const v = irVarNew(ib, r, pt, "param", 1 + ps.length)
    ib.irParams.push(v)
    ps.push(r)
    args.push({ ov: v })
  }
  // An open result the target's frame cannot type is legacy's declared result descriptor's
  // (`resultDescTy`), which its functype returns.
  const tt0 = resultTy(fe, fn.fnRet, d)
  const odt = if irTyOpen(tt0) && thunkRetTy(tt0, resultRep(fe, fn.fnRet, d)) == tt0 { resultDescTy(fe) } else { -1 }
  const rr = if odt >= 0 { repNodeOfTy(odt) } else { resultRep(fe, fn.fnRet, d) }
  irSigNote(ib, fe, ps, rr)
  ib.irRetRep = rr
  const c: RCall = {
    caCallee: fe,
    caArgs: args,
    caNever: false,
    caEnv: false,
    caCaps: [],
    caWb: [],
  }
  if repIsNoValue(rr) {
    ib.irRetTy = TY_NEVER
    ib.irBody = [irNodeNew(ib, { efRhs: c }, -1, ibNoValue, -1)]
    return ""
  }
  const tt = tt0
  ib.irRetTy = if odt >= 0 { odt } else { thunkRetTy(tt, rr) }
  ib.irRetFromRep = ib.irRetTy != tt
  if irTyOpen(ib.irRetTy) { return "thunk open result type" }
  const t = irVarNew(ib, rr, ib.irRetTy, "temp", -1)
  const call = irNodeNew(ib, { lDst: t, lRhs: c }, ib.irRetTy, rr, -1)
  const ret = irNodeNew(ib, { rtHas: true, rtV: { ov: t } }, -1, ibNoValue, -1)
  ib.irBody = [call, ret]
  return ""
}

// The result type a thunk returns at rep `r`: the target's `ty`, or where that is open, the rep's
// own type (`repTyOf`) when that is closed and is the same rep. A thunk tail-calls and returns the
// call's value as it stands, so only the rep reaches the lowering.
function thunkRetTy(ty: i32, r: i32): i32 {
  if !irTyOpen(ty) { return ty }
  const own = repTyOf(r)
  if own < 0 || irTyOpen(own) || repNodeOfTy(own) != r { return ty }
  return own
}

// The claim seam for the thunk of `fe`, before legacy writes it: when it builds and every node is
// in a claimed family, the lowering writes its code entry onto `out` and this answers true.
export function irClaimThunk(fe: i32, out: u8[]): boolean {
  if ibArmed || CLAIMED.length == 0 && !ibClaimAll { return false }
  const s = claimScopeBegin()
  const ok = claimThunk(fe, out)
  claimScopeEnd(s, ok)
  return ok
}

function claimThunk(fe: i32, out: u8[]): boolean {
  const built = buildThunk(fe)
  if softRefused("thunk ") { return false }
  if built != "" || !claimable() { return false }
  corrupt()
  if irBVerify(ib).vfRule != 0 { return thunkFellBack("verifier") }
  const why = irLowerHelper(ib, out)
  if why != "" { return thunkFellBack(why) }
  count("claimed thunk")
  return true
}

function thunkFellBack(why: string): boolean {
  count("claim fell back: thunk " + why)
  return false
}

// Under the armed shadow, the thunk of `fe` legacy wrote onto `out` from `from`, against its IR
// lowering: `thunk matched`, `thunk uncovered <why>`, or a `mismatch thunk` class.
export function irShadowThunk(fe: i32, out: u8[], from: i32) {
  if !ibArmed { return 0 }
  count("thunk fns")
  const why = buildThunk(fe)
  if why != "" { return count("thunk uncovered " + why) }
  corrupt()
  const v = irBVerify(ib)
  if v.vfRule != 0 {
    return count(
      "fail rule "
        + i32ToStr(v.vfRule)
        + " in "
        + ib.irName
        + ": "
        + v.vfMsg
        + "\n"
        + irFnText(ib),
    )
  }
  const got: u8[] = []
  const lw = irLowerHelper(ib, got)
  if lw != "" { return count("mismatch thunk " + lw) }
  // The dual emit's control 3 adds a byte, which must turn a match into a differ.
  if ibCorrupt == 3 { got.push(1) }
  if !bytesFrom(out, from, got) {
    const hex = if ibDetail { " " + irHexOf(out.slice(from)) + "| " + irHexOf(got) } else { "" }
    return count("mismatch bytes: thunk" + hex)
  }
  return count("thunk matched")
}

// The compare helper `__eq_<si>__`: its two parameters, references to struct row `si`, compared
// field-wise, as `eqHelpFnBody` writes it. "" or the miss.
function buildEqHelp(si: i32): string {
  ib = irFnNew(-1, "@eq")
  ib.irHelper = true
  ibFnIx = -1
  ibFnPos = -1
  ibRetNestedTwin = -1
  ibMiss = ""
  ibMissAt = -1
  ibStubRhs = -1
  ibAliasRhs = -1
  ibNoValue = repNodeOfTy(TY_NEVER)
  if si < 0 || si >= sHeapIdx.length { return "compare helper row" }
  ib.irName = "@eq " + i32ToStr(si)
  const pr = repRawOf(sHeapIdx[si], true)
  const l = irVarNew(ib, pr, -1, "param", 0)
  const r = irVarNew(ib, pr, -1, "param", 1)
  ib.irParams.push(l)
  ib.irParams.push(r)
  const i32r = repNodeOfTy(TY_I32)
  ib.irRetRep = i32r
  ib.irRetTy = TY_I32
  const t = irVarNew(ib, i32r, TY_I32, "temp", -1)
  const cmp: Rhs = { ehL: { ov: l }, ehR: { ov: r }, ehRow: si }
  const def = irNodeNew(ib, { lDst: t, lRhs: cmp }, TY_I32, i32r, -1)
  const ret = irNodeNew(ib, { rtHas: true, rtV: { ov: t } }, -1, ibNoValue, -1)
  ib.irBody = [def, ret]
  return ""
}

// The claim seam for `__eq_<si>__`, in the frame `eqHelpFnCode` opened and before legacy writes
// it: when it builds and every node is in a claimed family, its code entry goes onto `out`.
export function irClaimEqHelp(si: i32, out: u8[]): boolean {
  if ibArmed || CLAIMED.length == 0 && !ibClaimAll { return false }
  const s = claimScopeBegin()
  const ok = claimEqHelp(si, out)
  claimScopeEnd(s, ok)
  return ok
}

function claimEqHelp(si: i32, out: u8[]): boolean {
  const built = buildEqHelp(si)
  if softRefused("eq helper ") { return false }
  if built != "" || !claimable() { return false }
  corrupt()
  if irBVerify(ib).vfRule != 0 { return eqHelpFellBack("verifier") }
  const why = irLowerEqHelper(ib, out)
  if why != "" { return eqHelpFellBack(why) }
  count("claimed eq helper")
  return true
}

function eqHelpFellBack(why: string): boolean {
  count("claim fell back: eq helper " + why)
  return false
}

// Under the armed shadow, `__eq_<si>__`'s IR lowering, before legacy writes it from the same empty
// lazy frame; empty when it does not build, verify or lower, with that row counted.
export function irShadowEqHelp(si: i32): u8[] {
  const got: u8[] = []
  if !ibArmed { return got }
  count("eq helper fns")
  const why = buildEqHelp(si)
  if why != "" {
    count("eq helper uncovered " + why)
    return got
  }
  corrupt()
  const v = irBVerify(ib)
  if v.vfRule != 0 {
    count(
      "fail rule "
        + i32ToStr(v.vfRule)
        + " in "
        + ib.irName
        + ": "
        + v.vfMsg
        + "\n"
        + irFnText(ib),
    )
    return []
  }
  const lw = irShadowLowerEqHelper(ib, got)
  if lw != "" {
    count("mismatch eq helper " + lw)
    return []
  }
  // The dual emit's control 3 adds a byte, which must turn a match into a differ.
  if ibCorrupt == 3 { got.push(1) }
  return got
}

// `irShadowEqHelp`'s lowering `got` against the helper legacy then wrote onto `out` from `from`:
// `eq helper matched` or `mismatch bytes: eq helper`.
export function irShadowEqHelpCheck(got: u8[], out: u8[], from: i32) {
  if !ibArmed || got.length == 0 { return 0 }
  if !bytesFrom(out, from, got) {
    const hex = if ibDetail { " " + irHexOf(out.slice(from)) + "| " + irHexOf(got) } else { "" }
    return count("mismatch bytes: eq helper" + hex)
  }
  return count("eq helper matched")
}

// Builds a start body: each top-level statement (`orderGi[i]` -1), or global `orderGi[i]`'s
// initializer (`-2 - gi` for one that runs elsewhere), in order, each with its progress store under
// a top-level row (kind 1); the single start's opens with the pool fill. "" or the first miss.
function buildStart(order: i32[], orderGi: i32[], poolFill: boolean): string {
  ib = irFnNew(-1, if poolFill { "@start" } else { "@init" })
  ib.irPoolFill = poolFill
  ibFnIx = -1
  ibFnPos = -1
  ibRetNestedTwin = -1
  ibMiss = ""
  ibMissAt = -1
  ibStubRhs = -1
  ibAliasRhs = -1
  ibMisses = []
  ibDeclVar = Map()
  ibLiftCapDecl = Map()
  ibOwnDecls = Map()
  ibOwnByOrig = Map()
  ibOwnBuilt = false
  ibStartRoots = []
  let k = 0
  while k < order.length {
    if orderGi[k] == -1 { ibStartRoots.push(order[k]) }
    // A global's initializer built here holds block-locals of this frame, not the global itself.
    const gd = if orderGi[k] >= 0 { nodeAt(order[k]) } else { null }
    if gd is LetDecl && gd.letInit >= 0 { ibStartRoots.push(gd.letInit) }
    k = k + 1
  }
  ibLoopName = []
  ibLoopBrk = []
  ibLoopCont = []
  ibLvOf = Map()
  ibLabelN = 0
  ibFitShName = []
  ibFitShTy = []
  ibFitShRecv = []
  ibFitShVar = []
  ibBool = repNodeOfTy(TY_BOOL)
  ibNoValue = repNodeOfTy(TY_NEVER)
  if !repIsNoValue(ibNoValue) { return "no void rep" }
  ib.irRetRep = ibNoValue
  ib.irRetTy = TY_NEVER
  const top: i32[] = []
  let i = 0
  while i < order.length {
    const n0 = top.length
    // A global whose initializer runs elsewhere writes only its progress (`startIrOrder`).
    const gi = if orderGi[i] <= -2 { -2 - orderGi[i] } else { orderGi[i] }
    if orderGi[i] >= 0 { globalInit(top, orderGi[i], order[i]) }
    else if orderGi[i] == -1 { stmtNode(top, order[i], NO_SIBS, -1) }
    if ibMiss != "" { return ibMiss }
    // Legacy advances the read-before-init progress cell after each item where a guarded global
    // settles (`emitInitProgressAt`), before it banks the item's row.
    if gInitProgIdx >= 0 {
      const ord = startItemOrd(order[i], gi)
      if ord < 0 { return "progress cell position" }
      if (gInitProgAfter[ord] ?? -1) >= 0 {
        irBNode(top, { efRhs: { ipOrd: ord } }, -1, ibNoValue, order[i])
      }
    }
    // Legacy banks a top-level row (kind 1) over each item that wrote bytes.
    if top.length > n0 {
      irSpanNoteKind(ib, order[i], top[n0], top[top.length - 1], 1)
    }
    i = i + 1
  }
  ib.irBody = top
  return ibMiss
}

// The top-level position of start item `node`, global `gi`'s initializer when `gi` >= 0, as the
// start body numbers it for its progress cell (`globalStmtOrd`, `startStmtOrd`); -1 for none.
function startItemOrd(node: i32, gi: i32): i32 {
  if gi >= 0 {
    return if gi < globalStmtOrd.length { globalStmtOrd[gi] } else { -1 }
  }
  let si = 0
  while si < startStmts.length && si < startStmtOrd.length {
    if startStmts[si] == node { return startStmtOrd[si] }
    si = si + 1
  }
  return -1
}

// Global `gi`'s `null`-typed initializer `init`, as `emitNulNoneBoxPayload` writes it, then the
// store; an if-expression is a named miss.
function globalInitNulNone(b: i32[], gi: i32, gst: i32, init: i32): i32 {
  const rep = globalRep(gi, gst)
  if rep < 0 { return skip("global initializer rep") }
  const src = nulNoneBoxPayload(b, init, rep)
  if ibMiss != "" { return 0 }
  const gm = irGlobalWriteMiss(gi, ibGlobalCtx())
  if gm != "" { return skip(gm) }
  irBNode(b, { gsSym: gi, gsSrc: src }, -1, ibNoValue, gst)
  return 0
}

// A `null`-typed value `x` at rep `rep` as `emitNulNoneBoxPayload` writes it: an if-expression
// for its effects, then the bottom null; any other node as `nulNonePayload` writes it.
function nulNoneBoxPayload(b: i32[], x: i32, rep: i32): Opnd {
  const u = unwrapParen(x)
  const n = if u >= 0 && u < P.nodes.length { nodeAt(u) } else { null }
  if !(n is IfStmt) { return nulNonePayload(b, x, rep) }
  ifForEffect(b, n, u)
  if ibMiss != "" { return irBMiss(ibMiss) }
  return repTemp(b, { nuAt: u, nuOwn: NULL_OWN_NONE, nuRead: [] }, u, rep)
}

// A `null`-typed value `x` at rep `rep` as `emitNulNoneLeafPayload` writes it: a call's own value,
// `a ?? b` as `a` for effect then `b`'s payload, an assignment yielding `null` then the bottom
// null, and anything else run for effect (`nulNoneEffect`) then the bottom `ref.null none`.
function nulNonePayload(b: i32[], x: i32, rep: i32): Opnd {
  const u = unwrapParen(x)
  if u < 0 || u >= P.nodes.length {
    return irBMiss("global initializer nulnone node")
  }
  const n = nodeAt(u)
  if n is IfStmt { return irBMiss("global initializer nulnone if") }
  if n is Call {
    const v = irBExpr(b, u)
    if ibMiss != "" { return v }
    if irBOpRep(v) != rep {
      return irBMiss("global initializer nulnone call rep")
    }
    return v
  }
  const co = plainCoalesceAt(u)
  if co != null {
    const l = nulNoneEffect(b, co.binLeft, u, null)
    if ibMiss != "" { return l }
    return nulNonePayload(b, co.binRight, rep)
  }
  if asgYieldsNullLit(u) && n is BinExpr {
    assign(b, n, u)
    if ibMiss != "" { return irBMiss(ibMiss) }
  } else {
    const e = nulNoneEffect(b, u, u, null)
    if ibMiss != "" { return e }
  }
  return repTemp(b, { nuAt: u, nuOwn: NULL_OWN_NONE, nuRead: [] }, u, rep)
}

// Global `gi`'s initializer, at statement `gst`, written as legacy's plain arm writes it: the
// value delivered at the cell's rep, then its store.
function globalInit(b: i32[], gi: i32, gst: i32) {
  const g = nodeAt(gst)
  if !(g is LetDecl) { return 0 }
  const gck = globalCellKind(gst)
  const arm = startInitArmOf(gst, gck)
  // A union cell is the box, its initializer boxed at the binding's union type as legacy's
  // `emitUnionBoxOwed` writes it.
  if arm == "unionBox" {
    const rep = globalRep(gi, gst)
    if rep < 0 { return skip("global initializer rep") }
    const bv = deliver(b, g.letInit, rep, letBindingUnionTy(gst, -1))
    if ibMiss != "" { return 0 }
    if irBOpRep(bv) != rep { return skip("global initializer coercion") }
    const bm = irGlobalWriteMiss(gi, ibGlobalCtx())
    if bm != "" { return skip(bm) }
    irBNode(b, { gsSym: gi, gsSrc: bv }, -1, ibNoValue, gst)
    return 0
  }
  // A bare `const t = m[k]` over a union-valued map reads the value's box past `emitExpr`, its
  // miss the null-tagged box (`emitMapGetUnionBox`), banking no element-read row, as a local's does.
  if arm == "mapBox" {
    const rep = globalRep(gi, gst)
    if rep < 0 { return skip("global initializer rep") }
    const mv = mapGetAt(
      b,
      unwrapParen(g.letInit),
      rep,
      -1,
      false,
      -1,
      false,
      false,
    )
    if ibMiss != "" { return 0 }
    if irBOpRep(mv) != rep { return skip("global initializer mapBox rep") }
    const mm = irGlobalWriteMiss(gi, ibGlobalCtx())
    if mm != "" { return skip(mm) }
    irBNode(b, { gsSym: gi, gsSrc: mv }, -1, ibNoValue, gst)
    return 0
  }
  if arm == "nulnone" { return globalInitNulNone(b, gi, gst, g.letInit) }
  if arm == "alias" || arm == "holder" || arm == "atom" {
    const rep = globalRep(gi, gst)
    if rep < 0 { return skip("global initializer rep") }
    const av = if arm == "alias" { globalAliasCore(b, gst, rep) } else if arm == "holder" { globalHolderPick(b, gst, g.letInit, rep) } else { deliver(b, g.letInit, rep, -1) }
    if ibMiss != "" { return 0 }
    if irBOpRep(av) != rep { return skip("global initializer " + arm + " rep") }
    const am = irGlobalWriteMiss(gi, ibGlobalCtx())
    if am != "" { return skip(am) }
    irBNode(b, { gsSym: gi, gsSrc: av }, -1, ibNoValue, gst)
    return 0
  }
  if arm != "plain" && arm != "widen" && arm != "variant" {
    return skip("global initializer " + arm)
  }
  // A numeric cell's initializer is delivered widened to it, as legacy's `emitWidened` writes it,
  // and a narrowed arm's unbox (`emitGlobalInitArmUnbox`) is the delivery's own.
  // A bare-arm cell takes the arm's struct whatever builds it (`emitVariantCoerce`): the value is
  // delivered at the cell's type.
  const src = if arm == "variant" { globalInitVariant(b, gi, gst, g.letInit) } else if mapCtorOf(g.letInit) { mapNewInit(b, gi, gst, g.letInit) } else if gck == "closure" { cloInit(b, gi, gst, g.letInit) } else { globalInitValue(b, gi, gst, g.letInit) }
  if ibMiss != "" { return 0 }
  const gm = irGlobalWriteMiss(gi, ibGlobalCtx())
  if gm != "" { return skip(gm) }
  irBNode(b, { gsSym: gi, gsSrc: src }, -1, ibNoValue, gst)
  return 0
}

// Global statement `gst`'s alias of a generic function used only as a direct callee: the
// capture-free closure core, as legacy's `emitClosureValueCore` writes it at a start's alias arm.
function globalAliasCore(b: i32[], gst: i32, rep: i32): Opnd {
  const fe = monoGenericAliasFe(gst)
  if fe < 0 || fnEnvIdxOf(fe) >= 0 {
    return irBMiss("global initializer alias env")
  }
  if !(repNodeAt(rep) is RClosure) {
    return irBMiss("global initializer alias rep")
  }
  if closureValueCoreWhy(fe) != "" { return irBMiss("closure value refused") }
  const empty: Opnd[] = []
  return repTemp(b, { mcFn: fe, mcEnv: empty, mcAt: gst }, gst, rep)
}

// Global statement `gst`'s annotated read of a bundle holder `init`: the member its type names, as
// legacy's `emitTypedHolderInit` picks it.
function globalHolderPick(b: i32[], gst: i32, init: i32, rep: i32): Opnd {
  if !(repNodeAt(rep) is RClosure) { return irBMiss("holder pick binding rep") }
  const rec = holderRecordOf(b, init)
  if ibMiss != "" { return rec }
  if !(repNodeAt(irBOpRep(rec)) is RRecord) {
    return irBMiss("holder pick record")
  }
  return repTemp(b, { hkV: rec, hkAt: gst, hkArg: init }, init, rep)
}

// Global `gi`'s initializer `init` at its bare-arm cell, delivered at the cell's type so a
// variant's coercion arm builds it at the arm's row.
function globalInitVariant(b: i32[], gi: i32, gst: i32, init: i32): Opnd {
  const rep = globalRep(gi, gst)
  if rep < 0 { return irBMiss("global initializer rep") }
  const ty = heldTy(scopeTyAt(gst, -1))
  const v0 = variantCoerced(b, init, rep, ty, globalCellStructIdx(gst))
  // A plain record on the arm row's heap with the arm's fields is the variant as it stands
  // (`recRetag`), retagged as a local's initializer is.
  const v = if (ibMiss == ""
    && irBOpRep(v0) != rep
    && recRetag(irBOpRep(v0), rep)
    && exprPrePathWhy(init, ibFnIx) == "") { repTemp(b, { rgV: v0 }, init, rep) } else { v0 }
  if ibMiss == "" && irBOpRep(v) != rep {
    return irBMiss("global initializer variant coercion")
  }
  return v
}

// The value of global `gi`'s initializer `init`, delivered at the cell's rep with no coercion. A
// value built at the cell's storage row, the D14434 binding column's (`letBindTy`), stores at it,
// and this build's reads of the global then meet that rep (D14426, DECISIONS.md).
function globalInitValue(b: i32[], gi: i32, gst: i32, init: i32): Opnd {
  // An assignment to an atom cell as the initializer: legacy stores the atom's id in this cell,
  // where the IR would decode the target's re-read to the cell's string.
  const ai = nodeAt(unwrapParen(init))
  if (
    ai is BinExpr
    && ai.binOp == "="
    && repNodeAt(repNodeOfTy(heldTy(exprTyOf(ai.binLeft)))) is RAtom
  ) {
    // Where the global section declares the cell an i32, the atom's own, the assignment's value is
    // stored as the id it yields.
    const ar = repNodeOfTy(heldTy(exprTyOf(ai.binLeft)))
    if globalCellKind(gst) != "i32" || irGlobalRepOf(ib, gi) >= 0 {
      return irBMiss("global initializer atom assignment")
    }
    // The store, then its target read again at the atom: the value legacy's `local.get` yields.
    assign(b, ai, unwrapParen(init))
    if ibMiss != "" { return irBMiss(ibMiss) }
    const av = irBExpr(b, ai.binLeft)
    if ibMiss != "" { return av }
    if irBOpRep(av) != ar {
      return irBMiss("global initializer atom assignment")
    }
    globalNoteAt(gi, gst, ar)
    return av
  }
  const noted = irGlobalRepOf(ib, gi)
  const rep = if noted >= 0 { noted } else { openCellRep(gst, globalTyRep(globalHeldTy(gst))) }
  if rep < 0 { return irBMiss("global initializer rep") }
  // A constant list literal whose binding's storage row (`letBindTy`, D14434) is another list, a
  // wider record's, is built at that row, which the cell then stores.
  const bindRep = if noted < 0 && gConstExprEmit { globalTyRep(letBindTy(gst, -1)) } else { -1 }
  const iu = unwrapParen(init)
  const atBind = bindRep >= 0
    && bindRep != rep
    && repNodeAt(bindRep) is RList
    && iu >= 0
    && iu < P.nodes.length
    && nodeAt(iu) is ArrayLit
  const iv = if atBind { nodeAt(iu) } else { null }
  const d = if iv is ArrayLit { arrayLit(
    b,
    iv,
    iu,
    bindRep,
    arrLitListBuild(iu, ibFnIx),
    heldTy(letBindTy(gst, -1)),
  ) } else { deliver(b, init, rep, -1) }
  if ibMiss != "" { return d }
  // A record on the cell's own struct heap, or a declared subtype's, is stored retagged; so is a
  // list or closure the body lanes' retags take, unless legacy already stores it as it stands.
  const dr = irBOpRep(d)
  const v = if dr != rep
    && (recRetagNoted(dr, rep, init)
    || !cellTakesAsIs(gst, noted, dr, rep) && bodyRetagAt(dr, rep, init)) { repTemp(b, { rgV: d }, init, rep) } else { d }
  const vr = irBOpRep(v)
  const stored = noted < 0
    && vr != rep
    && (vr == globalTyRep(letBindTy(gst, -1))
    || cellHeapHolds(gst, vr)
    || cellDeclStores(gst, rep, vr)
    || holderCellTakesNull(gst, rep, vr))
  // A `null`-typed value is the bottom ref, already a value of a nullable reference cell.
  const bottom = repNullRefFits(vr, rep)
  // Legacy's `global.set` stores a reference the cell's valtype holds as it stands (`repStoresAs`):
  // a closure of another closure rep, both the uniform closure.
  if vr != rep && !stored && !bottom && repStoresAs(rep, vr) {
    globalNoteAt(gi, gst, rep)
    return v
  }
  if vr != rep && !stored && !bottom {
    return irBMiss("global initializer coercion")
  }
  globalNoteAt(gi, gst, if bottom { rep } else { vr })
  if noted < 0 && vr == rep && globalHolderTy(gst) >= 0 {
    ib.irGlobalHeld[gi] = true
  }
  return v
}

// Whether global `gst`'s cell at rep `rep` takes a value at rep `vr` with no retag: the value's own
// cell (`globalTyRep`, `cellHeapHolds`), the bottom ref, or a reference `repStoresAs` holds.
function cellTakesAsIs(gst: i32, noted: i32, vr: i32, rep: i32): boolean {
  if (
    noted < 0
    && (vr == globalTyRep(letBindTy(gst, -1)) || cellHeapHolds(gst, vr))
  ) {
    return true
  }
  return repNullRefFits(vr, rep) || repStoresAs(rep, vr)
}

// Whether a value at rep `src`, delivered from `at`, is the value at rep `dst` as it stands, as the
// body lanes' retags take it: a list twin (`listRetag`), a box list or map (`boxListRetag`,
// `boxMapRetag`), or a closure or list apart only in a hole (`holeRetagNoted`), with no coercion
// legacy records at `at`.
function bodyRetagAt(src: i32, dst: i32, at: i32): boolean {
  const list = repNodeAt(src) is RList
    && (listRetag(src, dst) || boxListRetag(src, dst))
    || boxMapRetag(src, dst)
  // Two records also lower alike field by field, as the verifier's hole retag asks.
  const recs = repNodeAt(src) is RRecord && repNodeAt(dst) is RRecord
  const hole = holeRetagNoted(src, dst, true)
    && (!recs || repsLowerAlike(src, dst, ib.irRecHeap))
  return (list || hole) && exprPrePathWhy(at, ibFnIx) == ""
}

// Whether global `gst`'s cell holds value rep `vr` as it stands: the global section declares the
// cell (`globalCellKind`, `letCellSlot`, read again after that section minted it) at `vr`'s heap.
// An open-typed cell's rep has no valtype of its own; a closed one's list is the instance's.
function cellDeclStores(gst: i32, rep: i32, vr: i32): boolean {
  const open = undeclaredRepTakes(globalHeldTy(gst), rep, vr)
  const lists = repNodeAt(rep) is RList && repNodeAt(vr) is RList
  if !open && !lists || refRepValtype(vr).length == 0 { return false }
  const k = globalCellKind(gst)
  const vt: u8[] = []
  const prev = wTarget(vt)
  fbValtype(k, letCellSlot(gst, -1, k))
  wTarget(prev)
  return u8sSame(vt, refRepValtype(vr))
}

// Whether global `gst`, a holder legacy keeps a returned record in whole (`globalHolderTy`, cell
// kind `struct` or `nulstruct`) and declares nullable as it initializes it at start, takes that
// record or null.
function holderCellTakesNull(gst: i32, rep: i32, vr: i32): boolean {
  const n = repNodeAt(vr)
  return n is RNullable
    && n.rnDisc == 1
    && n.rnInner == rep
    && globalHolderTy(gst) >= 0
    && (globalCellKind(gst) == "struct" || globalCellKind(gst) == "nulstruct")
    && globalIsNonConst(gst)
}

// Whether global `gst`'s cell, a struct legacy declares at a heap (`globalCellHeap`), is the heap of
// record value rep `vr`: legacy's `global.set` stores it as it stands.
function cellHeapHolds(gst: i32, vr: i32): boolean {
  const h = recHeapOf(vr)
  return h >= 0 && repNodeAt(vr) is RRecord && h == globalCellHeap(gst)
}

// Global `gi`'s constant initializer `init`, at statement `gst`, as legacy's `emitConstCellInit`
// writes it: an integer constant expression it folds (`letInitFoldsExpr`) is its folded value
// (`constFoldOfLet`), the one `*.const` of the cell's own width that `emitConstFoldValue` writes;
// any other is delivered at the cell's rep.
function constCellValue(b: i32[], gi: i32, gst: i32, init: i32): Opnd {
  const g = nodeAt(gst)
  if !(g is LetDecl) || !letInitFoldsExpr(g) {
    return globalInitValue(b, gi, gst, init)
  }
  // Legacy refuses a cell that is not the init's own width; the IR leaves it to that refusal.
  if !constFoldWidthOk(globalCellKind(gst), init) {
    return irBMiss("folded constant width")
  }
  const rep = globalRep(gi, gst)
  if rep < 0 { return irBMiss("global initializer rep") }
  const v: Opnd = { oiRep: rep, oiBits: constFoldOfLet(g).cfV }
  return v
}

// Whether `ix` is a builtin `Map()` or `Set()` call: the name unbound, no argument. Stricter than
// legacy's dispatch, which tests only for no user function, on purpose.
function mapCtorOf(ix: i32): boolean {
  const n = nodeAt(unwrapParen(ix))
  if !(n is Call) || n.callArgs.length != 0 || n.callFn < 0 { return false }
  const f = nodeAt(n.callFn)
  if (
    !(f is Ident)
    || fnIndexOfNode(n.callFn) >= 0
    || identDeclOf(n.callFn) >= 0
  ) {
    return false
  }
  return f.identName == "Map" || f.identName == "Set"
}

// The empty map global `gi` starts as: legacy's constructor at the cell's map rep, or at its
// storage row (`letBindTy`) where the constructor builds that, as `globalInitValue` stores one.
function mapNewInit(b: i32[], gi: i32, gst: i32, init: i32): Opnd {
  const cell = repNodeOfTy(scopeTyAt(gst, -1))
  // A nullable map cell is its map's ref niche: the new map stores as it stands.
  const cn = repNodeAt(cell)
  const niche = cn is RNullable
    && cn.rnDisc == 1
    && repNodeAt(cn.rnInner) is RMap
  const rep = if cn is RNullable && niche { cn.rnInner } else { cell }
  if !(repNodeAt(rep) is RMap) { return irBMiss("global initializer rep") }
  const ix = unwrapParen(init)
  const pre = exprPrePathWhy(ix, ibFnIx)
  if pre != "" { return irBMiss(pre) }
  const nr = repNodeOfTy(nodeTyAt(ix, ibFnIx))
  if niche {
    if nr != rep { return irBMiss("global initializer coercion") }
    globalNoteAt(gi, gst, cell)
    return irBLetTemp(b, { mnAt: ix }, ix, nr)
  }
  const stored = irGlobalRepOf(ib, gi) < 0
    && nr != rep
    && nr == globalTyRep(letBindTy(gst, -1))
  if nr != rep && !stored { return irBMiss("global initializer coercion") }
  globalNoteAt(gi, gst, nr)
  return irBLetTemp(b, { mnAt: ix }, ix, nr)
}

// Whether name `ix` is read as its function's void twin (`voidTwinForNode`).
function cloValueIsTwin(ix: i32): boolean {
  const n = nodeAt(ix)
  if !(n is Ident) { return false }
  const fe = fnValueFeOf(n, sidOfNode(ix), ix, ibFnIx)
  return fe >= 0 && voidTwinForNode(ix, fe) >= 0
}

// Whether function value `ix` is an instance whose own closure rep is `rep` (`instanceClosureRep`).
function instanceAt(ix: i32, rep: i32): boolean {
  const fe = cloValueFeOf(ix)
  return fe >= 0 && instanceClosureRep(fe) == rep
}

// The closure global `gi` starts as: a capture-free function literal, or a function name read as
// a value on legacy's checked arm (`fnValueArmOf`), written by legacy's `emitClosureValue`.
function cloInit(b: i32[], gi: i32, gst: i32, init: i32): Opnd {
  // Any other initializer, a call's result or a global holding a closure among them, is the value
  // `emitExpr` writes: a name is a function value only where `emitIdentNonLocalRead` finds one.
  const iu = unwrapParen(init)
  if iu < 0 || iu >= P.nodes.length { return globalInitValue(b, gi, gst, init) }
  const iv = nodeAt(iu)
  const fnName = iv is Ident && fnValueFeOf(iv, sidOfNode(iu), iu, ibFnIx) >= 0
  if !(iv is FuncDecl || fnName) { return globalInitValue(b, gi, gst, init) }
  const rep = repNodeOfTy(scopeTyAt(gst, -1))
  if !(repNodeAt(rep) is RClosure) { return irBMiss("global initializer rep") }
  const ix = unwrapParen(init)
  const pre = exprPrePathWhy(ix, ibFnIx)
  if pre != "" { return irBMiss(pre) }
  // A hole or generic function's value at an annotated cell is the instance legacy picks for it,
  // whose own closure rep is the cell's; it is typed at the cell's type.
  // So is a function's void twin at a `void` cell (`fnValueArmOf`'s `twin`).
  const nt = nodeTyAt(ix, ibFnIx)
  const inst = repNodeOfTy(nt) != rep
    && (irTyOpen(heldTy(exprTyOf(ix))) || cloValueIsTwin(ix))
  if repNodeOfTy(nt) != rep && !(inst && instanceAt(ix, rep)) {
    return irBMiss("global initializer coercion")
  }
  const v = cloValue(
    b,
    ix,
    rep,
    if inst { scopeTyAt(gst, -1) } else { heldTy(exprTyOf(ix)) },
  )
  if ibMiss == "" { globalNoteAt(gi, gst, rep) }
  return v
}

// The function closure value `ix` names: a lifted function literal, or a bare name the read
// ladder sends to `emitIdentNonLocalRead`'s checked arm; -1 for any other spelling. A global's
// initializer is never the stubbed write's right side, so no `stubRhs` exempts it.
function cloValueFeOf(ix: i32): i32 {
  const n = nodeAt(ix)
  if n is FuncDecl { return fnStmtsPosOf(ix) }
  if !(n is Ident) || identReadArmOf(n, ix, ibFnIx, false) != "nonlocal" {
    return -1
  }
  const fe = fnValueFeOf(n, sidOfNode(ix), ix, ibFnIx)
  if fe < 0 { return -1 }
  return match fnValueArmOf(fe, ix, -1) {
    "checked" | "inert" | "aliasCore" => fe
    // A value the checker coerced to return `void` closes over the function's void twin.
    "twin" => voidTwinForNode(ix, fe)
    "unfixed" => -1
  }
}

// Whether closure value `ix` of function `fe` is written without the generic-value refusal: a name
// read on `fnValueArmOf`'s `inert` or `aliasCore` arm, which legacy writes by
// `emitClosureValueCore`.
function cloValueIsCore(ix: i32, fe: i32): boolean {
  const n = nodeAt(ix)
  if !(n is Ident) { return false }
  return match fnValueArmOf(fe, ix, -1) {
    "inert" | "aliasCore" => true
    "checked" | "twin" | "unfixed" => false
  }
}

// Whether recorded type `t` is a closure type left open, a hole function's own `(a) => a`: its
// value is built at the rep the record field holds, and a read of that field reads at it.
export function holeCloTy(t: i32): boolean {
  return t >= 0 && irTyOpen(t) && repNodeAt(repNodeOfTy(t)) is RClosure
}

// Whether `ix` is a function literal or name read as a closure value that records no type, or a
// hole function's (`holeCloTy`).
function untypedCloValue(ix: i32): boolean {
  const u = unwrapParen(ix)
  if u < 0 || u >= P.nodes.length { return false }
  const t = nodeTyAt(u, ibFnIx)
  if t >= 0 && !holeCloTy(t) { return false }
  if exprPrePathWhy(u, ibFnIx) != "" { return false }
  return cloValueFeOf(u) >= 0
}

// Whether `ix` is a function name whose type is a tagged set's id (`fnTagTyIsTagged`) at a read the
// set does not write as a member's id (`fnTagLeafEmitted`), and no coercion converts.
function taggedNameCloValue(ix: i32): boolean {
  const u = unwrapParen(ix)
  if u < 0 || u >= P.nodes.length || !(nodeAt(u) is Ident) { return false }
  if !exprTypedTagId(u, ibFnIx) || fnTagLeafEmitted(u, ibFnIx) >= 0 {
    return false
  }
  if coerceKindAt(u, ibFnIx) != "none" || exprPrePathWhy(u, ibFnIx) != "" {
    return false
  }
  return cloValueFeOf(u) >= 0
}

// Why `cloValueFeOf` found no function for closure value `ix`.
// A generic function read as a value that no call fixes is legacy's own refusal, raised at the
// read before the claim declines; a stub write's right side is exempt, as legacy's is.
function cloUnfixedRefuse(ix: i32) {
  const n = nodeAt(ix)
  if !(n is Ident) || identReadArmOf(n, ix, ibFnIx, false) != "nonlocal" {
    return 0
  }
  const fe = fnValueFeOf(n, sidOfNode(ix), ix, ibFnIx)
  if fe >= 0 && emitSoftFail && fnValueArmOf(fe, ix, ibStubRhs) == "unfixed" {
    emitFailAt(
      "emitProgram: a generic function taken as a value reaches no call that fixes its type "
        + "— annotate the destination's function type",
      ix,
    )
  }
  return 0
}

function cloValueWhy(ix: i32): string {
  const n = nodeAt(ix)
  if n is FuncDecl { return "closure literal not lifted" }
  if n is Call { return "closure value of a call" }
  if !(n is Ident) { return "closure value expression" }
  const arm = identReadArmOf(n, ix, ibFnIx, false)
  if arm != "nonlocal" { return "closure name read " + arm }
  const fe = fnValueFeOf(n, sidOfNode(ix), ix, ibFnIx)
  if fe < 0 { return "closure name of a global" }
  return "closure value " + fnValueArmOf(fe, ix, -1)
}

// The census row of the function just built: its blocker classes, sorted, or none.
function censusRow(why: string) {
  if why != "" { censusGoesOn(why) }
  const key = censusKey()
  count(if key == "" { "blockers none" } else { "blockers " + key })
  return 0
}

// The census's classes met in the body being built, sorted and joined by ` + `, or "".
function censusKey(): string {
  if ibMisses.length == 0 { return "" }
  // Insertion sort, so one set of classes is one key whatever order the build met them in.
  let i = 1
  while i < ibMisses.length {
    const x = ibMisses[i]
    let j = i - 1
    while j >= 0 && ibMisses[j] > x {
      ibMisses[j + 1] = ibMisses[j]
      j = j - 1
    }
    ibMisses[j + 1] = x
    i = i + 1
  }
  let key = ibMisses[0]
  let k = 1
  while k < ibMisses.length {
    key = key + " + " + ibMisses[k]
    k = k + 1
  }
  return key
}

// Whether a record at rep `src`, delivered from `at`, goes in at plain record rep `dst` as it
// stands: on `dst`'s own heap (`recRowRetag`) or a declared subtype's (`recSubRetag`), with no
// coercion legacy records at `at`.
function recRetagAt(src: i32, dst: i32, at: i32): boolean {
  return (recRowRetag(src, dst, ib.irRecHeap)
    || recSubAdmit(src, recStorageRow(src), dst, ib.irRecHeap, ib.irRecSub))
    && exprPrePathWhy(at, ibFnIx) == ""
}

// The struct row legacy stores a value of plain record rep `r` at when its type has no row of
// its own (`structRowOfRecordTy`); -1 for any other rep.
function recStorageRow(r: i32): i32 {
  const n = repNodeAt(r)
  if !(n is RRecord) || n.rrVariant { return -1 }
  return structRowOfRecordTy(repTyOf(r))
}

// Whether rep `src`, built from `at`, is the record or list rep `dst` as it stands with no coercion
// legacy records at `at`: a list twin, a union-box list, a variant record at its struct twin, or a
// record on `dst`'s heap or a declared subtype's.
function retagsAsStands(src: i32, dst: i32, at: i32): boolean {
  if exprPrePathWhy(at, ibFnIx) != "" { return false }
  return listRetag(src, dst)
    || boxListRetag(src, dst)
    || recRetag(src, dst)
    || recRetagNoted(src, dst, at)
}

// Whether record rep `r`'s struct heap is noted, noting it first.
function recHeapNoted(r: i32): boolean {
  noteRecHeaps(r)
  return irRecHeapOf(ib, r) >= 0
}

// `recRetagAt` after noting both reps' record heaps: a record returned at its result's row on one
// heap whose fields lower alike, a closure field's signature among them.
function recRetagNoted(src: i32, dst: i32, at: i32): boolean {
  noteRecHeaps(src)
  noteRecHeaps(dst)
  return recRetagAt(src, dst, at)
}

// `recValRetag` over temp `o`, after noting the heaps reachable from `o`'s kids and `dst`'s.
function recValRetagNoted(o: Opnd, dst: i32): boolean {
  if !(o is OVar) || irVarHeapOf(ib, o.ov) < 0 { return false }
  const src = irBOpRep(o)
  for k in repNodeKids(src) { recHeapsNote(ib.irRecHeap, k) }
  for k in repNodeKids(dst) { recHeapsNote(ib.irRecHeap, k) }
  return recValRetag(ib, o.ov, src, dst)
}

// Value `v` delivered at rep `dst` (type `dstTy`) at node `at`, converted from its own rep where the
// checker's types agree: as it stands, retagged, or a named miss the scoreboard counts as capability
// debt. The one conversion every delivery site calls; each arm is its destination kind's cases.
export function irConvert(
  b: i32[],
  v: Opnd,
  dst: i32,
  dstTy: i32,
  at: i32,
): Opnd {
  if ibMiss != "" { return v }
  const k = convertKindOf(v, dst, dstTy, at)
  if k == CONVERT_AS_IS { return v }
  if k == CONVERT_RETAG { return repTempTy(b, { rgV: v }, at, dst, dstTy) }
  if k == CONVERT_NICHE { return nicheInto(b, v, dst, at) }
  if k == CONVERT_BOX { return boxTempIn(b, v, at, dst, -1, dstTy) }
  return irBMiss("convert " + repWhat(irBOpRep(v)) + " -> " + repWhat(dst))
}

// `irConvert` into a cell, which stores one rep: a value taken as it stands at another rep is
// retagged where a retag admits it, goes in by its niche, or misses.
function irConvertStored(
  b: i32[],
  v: Opnd,
  dst: i32,
  dstTy: i32,
  at: i32,
): Opnd {
  if ibMiss != "" { return v }
  if irBOpRep(v) != dst && convertKindOf(v, dst, dstTy, at) == CONVERT_AS_IS {
    if convertRetag(v, irBOpRep(v), dst, at, !(repNodeAt(dst) is RRecord)) {
      return repTempTy(b, { rgV: v }, at, dst, dstTy)
    }
    if nicheIntoTakes(v, dst, at) { return nicheInto(b, v, dst, at) }
    return irBMiss("convert " + repWhat(irBOpRep(v)) + " -> " + repWhat(dst))
  }
  return irConvert(b, v, dst, dstTy, at)
}

// How `irConvert` takes value `v` to rep `dst`: as it stands, by a retag, into a nullable's niche,
// or -1 for no case yet. A closure goes into a nullable closure by its niche, retagged.
const CONVERT_AS_IS = 0
const CONVERT_RETAG = 1
const CONVERT_NICHE = 2
const CONVERT_BOX = 3
function convertKindOf(v: Opnd, dst: i32, dstTy: i32, at: i32): i32 {
  const src = irBOpRep(v)
  if cloNicheTakes(v, dst, at) { return CONVERT_NICHE }
  if src == dst || convertAsIs(src, dst, dstTy) { return CONVERT_AS_IS }
  const d = repNodeAt(dst)
  if d == null { return -1 }
  // Records retag only by the verifier's field-wise rules; a row copy is not yet a case.
  const re = match d {
    RRecord => convertRetag(v, src, dst, at, false)
    RList | RMap | RClosure | RNullable | RBox => convertRetag(v, src, dst, at, true)
    RAtom | RPrim | RRaw | RNoValue | RUnsup => convertRetag(v, src, dst, at, true)
  }
  if re { return CONVERT_RETAG }
  if nicheIntoTakes(v, dst, at) { return CONVERT_NICHE }
  return if heldAsBox(dst) && !heldAsBox(src) && dstTy >= 0 { CONVERT_BOX } else { -1 }
}

// Whether value `v` goes into niche nullable rep `dst` (`rnDisc` 1): it is the nullable's inner
// value, or retags to it, with the operand's pre-path clear.
function nicheIntoTakes(v: Opnd, dst: i32, at: i32): boolean {
  const dn = repNodeAt(dst)
  if !(dn is RNullable) || dn.rnDisc != 1 || irBOpRep(v) == dst { return false }
  if exprPrePathWhy(at, ibFnIx) != "" { return false }
  return irBOpRep(v) == dn.rnInner
    || cloNicheTakes(v, dst, at)
    || convertKindOf(v, dn.rnInner, repTyOf(dn.rnInner), at) == CONVERT_RETAG
}

// Value `v` retagged to niche nullable rep `dst`'s inner rep where it is apart, then into the niche.
function nicheInto(b: i32[], v: Opnd, dst: i32, at: i32): Opnd {
  const dn = repNodeAt(dst)
  if !(dn is RNullable) {
    return irBMiss("convert into a niche of no nullable")
  }
  if repNodeAt(dn.rnInner) is RClosure && repNodeAt(irBOpRep(v)) is RClosure {
    return cloNicheRetag(b, v, dst, at)
  }
  const c = if irBOpRep(v) == dn.rnInner { v } else { repTemp(b, { rgV: v }, at, dn.rnInner) }
  return repTemp(b, { rgV: c }, at, dst)
}

// Whether a value at rep `src` is the value at `dst` as it stands: an open type's rep, a valtype
// `dst` stores, the bottom ref in a nullable ref, or a niche's ref.
function convertAsIs(src: i32, dst: i32, dstTy: i32): boolean {
  return openRepTakes(dstTy, dst, src)
    || repStoresAs(dst, src)
    || repNullRefFits(src, dst)
    || nicheRefTakes(dst, src)
}

// Whether value `v` at rep `src` retags to `dst`: a list's twin, closure openness (`clo`, never a
// record's), or a record's struct twin or noted row, with the operand's pre-path clear.
function convertRetag(
  v: Opnd,
  src: i32,
  dst: i32,
  at: i32,
  clo: boolean,
): boolean {
  const ok = listRetag(src, dst)
    || boxListRetag(src, dst)
    || mapRetag(src, dst)
    || cloListUndeclaredTakes(src, dst)
    || holeRetagNoted(src, dst, clo && !(repNodeAt(src) is RRecord))
    || recRetag(src, dst)
    || recRetagNoted(src, dst, at)
    || recValRetagNoted(v, dst)
  return ok && exprPrePathWhy(at, ibFnIx) == ""
}

// Whether rep `src` is `dst` as it stands, a list (`listRetagHole`) or, with `clo`, any value
// (`cloHoleRetag`), apart only in closure openness; each record rep's heap is noted first, which
// the walk and the verifier compare.
function holeRetagNoted(src: i32, dst: i32, clo: boolean): boolean {
  noteRecHeaps(src)
  noteRecHeaps(dst)
  return listRetagHole(ib, src, dst) || clo && cloHoleRetag(ib, src, dst)
}

// Notes the heap of each record rep the hole walk reaches from `r`: through lists, nullables, a
// map's values and closures, stopping at a record, as `repFillsHole` does.
function noteRecHeaps(r: i32) {
  const n = repNodeAt(r)
  if n == null { return 0 }
  match n {
    RRecord => irRecHeapNote(ib, r, recHeapOf(r))
    RList => noteRecHeaps(n.rlsElem)
    RNullable => noteRecHeaps(n.rnInner)
    RMap => noteRecHeaps(n.rmVal)
    RClosure => {
      for p in n.rcParams { noteRecHeaps(p) }
      noteRecHeaps(n.rcRet)
    }
    RAtom | RBox | RNoValue | RPrim | RRaw | RUnsup => 0
  }
  return 0
}

// Whether each element is a string literal, an immediate at its use.
// An element of an i32 list seeded with the `null` sentinel that is the list's `null`, as legacy
// writes it: the sentinel 2, after any value other than a `null` literal written for its effect
// and dropped.
function nulSentinelElem(b: i32[], e: i32, er: i32): Opnd {
  if repPrim(er) != "i32" { return irBMiss("array null sentinel rep") }
  const two: Opnd = { oiRep: er, oiBits: 2 }
  if nodeAt(unwrapParen(e)) is NullLit { return two }
  const v = irBExpr(b, e)
  if ibMiss != "" { return v }
  return irBLetTempTy(b, { aeEff: [v], aeV: two, aeAt: e }, e, er, TY_I32)
}

// An unstamped `null` stored into a `null[]`, as `emitIdxStoreValue` writes it: the value for its
// effect (`emitNulNoneForEffect`, nothing for a `null` or a name read), then the sentinel 2.
function nulSentinelStore(b: i32[], x: i32, er: i32): Opnd {
  const two: Opnd = { oiRep: er, oiBits: 2 }
  const effs: Opnd[] = []
  const e = nulNoneEffect(b, x, x, effs)
  if ibMiss != "" { return e }
  if effs.length == 0 { return two }
  return irBLetTempTy(b, { aeEff: effs, aeV: two, aeAt: x }, x, er, TY_I32)
}

function allStrLits(es: i32[]): boolean {
  for e in es {
    const u = unwrapParen(e)
    if u < 0 || u >= P.nodes.length || !(nodeAt(u) is StrLit) { return false }
  }
  return true
}

// Constant element `e` of a long literal (`arrLitElemIsConst`: a number literal, negated or not, or
// a boolean) as one immediate at `rep`, for the verifier: the lowering writes the data segment.
function longConstElem(e: i32, rep: i32): Opnd {
  const x = unwrapParen(e)
  if x < 0 || x >= P.nodes.length { return irBMiss("array long element") }
  const n = nodeAt(x)
  if n is BoolLit {
    const o: Opnd = { oiRep: rep, oiBits: n.boolVal as i64 }
    return o
  }
  if !isSignedNumLit(x) { return irBMiss("array long element") }
  return signedLitAt(x, rep)
}

// Whether `v` is the whole-box read of map read `ix` (`mapBoxValTyAt`'s build).
function tempIsWholeMapRead(v: Opnd, ix: i32): boolean {
  if !(v is OVar) || v.ov < 0 { return false }
  for n in ib.irNodes {
    if n is SLet && n.lDst == v.ov {
      const r = n.lRhs
      return r is RMapGet && r.mtWhole && r.mtAt == unwrapParen(ix)
    }
  }
  return false
}
