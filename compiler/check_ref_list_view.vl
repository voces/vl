// Record lists delivered as a `readonly` list of a boxed union, through literal fields and
// elements, and the answer carried to a spilled read.
// Does not import the checker.
import { ArrayLit, FieldInit, ObjLit, P, nodeAt } from "./ast"
import { covarRootFreshLocal, covarValueWriteState } from "./check_covar_write"
import { nodeTyIxOf } from "./check_node_tys"
import { covarNonNullArms } from "./check_ty_relate"
import {
  T,
  TyArray,
  TyNullable,
  TyObj,
  TyUnion,
  objFieldType,
  tyAt,
} from "./check_types"
import { cwKeyOfRoot, cwPeel } from "./check_write_scan"
import { i32ListHas } from "./listutil"

// The record element types delivered as a list of a union holding them from a source whose other
// handles the write analysis cannot see. Such a delivery is a view of its source (D3041).
export let refViewSrcTys: i32[] = []
// The source expressions of those deliveries whose destination is `readonly`: a view serves them
// whatever writes the source, since nothing writes through the view.
export let refViewRoNodes: i32[] = []

// Record a record list delivered as a list of a boxed union from a root other than a fresh
// `const` literal (`refViewSrcTys`): the emitter builds such a delivery as a view (D3041).
export function noteRefListView(srcExpr: i32, srcTy: i32, dstTy: i32) {
  if srcTy == dstTy || srcTy < 0 || dstTy < 0 { return 0 }
  if srcTy >= T.tys.length || dstTy >= T.tys.length { return 0 }
  const s = tyAt(srcTy)
  const d = tyAt(dstTy)
  // A literal delivers each of its fields or elements at the destination's own, one seam down.
  let cx = -1
  if srcExpr >= 0 && srcExpr < P.nodes.length { cx = cwPeel(srcExpr) }
  if cx >= 0 && cx < P.nodes.length {
    const ce = nodeAt(cx)
    if ce is ObjLit { return noteRefListViewFields(ce.objFields, dstTy) }
    if ce is ArrayLit { return noteRefListViewElems(ce.arrElems, dstTy) }
  }
  if s is TyArray {
    if d is TyArray {
      const se = s.aElem
      const de = d.aElem
      if se < 0 || de < 0 || se >= T.tys.length || de >= T.tys.length {
        return 0
      }
      // A `| null` record element rides the box's own null tag.
      let sr = se
      const sn = tyAt(se)
      if sn is TyNullable { sr = sn.nInner }
      if sr < 0 || sr >= T.tys.length { return 0 }
      const st = tyAt(sr)
      // A `| null` over the union still boxes, with `null` a tag inside the box.
      let du = de
      const dn = tyAt(de)
      if dn is TyNullable { du = dn.nInner }
      if du < 0 || du >= T.tys.length { return 0 }
      const dt = tyAt(du)
      if st is TyObj {
        if dt is TyUnion {
          if covarNonNullArms(dt.uMembers) < 2 { return 0 }
          // A fresh `const` literal is copied only where nothing writes it (D3059).
          if covarRootFreshLocal(srcExpr) {
            if covarValueWriteState(cwKeyOfRoot(srcExpr)) == 0 { return 0 }
          }
          if !i32ListHas(refViewSrcTys, se) { refViewSrcTys.push(se) }
          if d.aRead == 1 && !i32ListHas(refViewRoNodes, srcExpr) {
            refViewRoNodes.push(srcExpr)
          }
        }
      }
    }
  }
  0
}

// `noteRefListView` over an object literal's fields, each at its destination field's type.
function noteRefListViewFields(fields: i32[], dstTy: i32) {
  const d = tyAt(dstTy)
  if d is TyObj {
    let fi = 0
    while fi < fields.length {
      const fn = nodeAt(fields[fi])
      if fn is FieldInit {
        const dft = objFieldType(d, fn.fiName)
        if dft >= 0 { noteRefListView(fn.fiValue, nodeTyIxOf(fn.fiValue), dft) }
      }
      fi = fi + 1
    }
  }
  0
}

// `noteRefListView` over a list literal's elements, each at the destination's element type.
function noteRefListViewElems(elems: i32[], dstTy: i32) {
  const d = tyAt(dstTy)
  if d is TyArray {
    let ei = 0
    while ei < elems.length {
      noteRefListView(elems[ei], nodeTyIxOf(elems[ei]), d.aElem)
      ei = ei + 1
    }
  }
  0
}

// Whether the record list `srcExpr` delivers is delivered as a `readonly` union-box list.
export function refViewReadonlyAt(srcExpr: i32): boolean {
  i32ListHas(refViewRoNodes, srcExpr)
}

// Carries that answer from `srcExpr` to `read`, a spilled read that now delivers its value.
export function refViewCarry(srcExpr: i32, read: i32) {
  if refViewReadonlyAt(srcExpr) && !refViewReadonlyAt(read) {
    refViewRoNodes.push(read)
  }
  0
}

// Clears this module's tables (called from `initChecker`).
export function refListViewReset() {
  refViewSrcTys = []
  refViewRoNodes = []
}
