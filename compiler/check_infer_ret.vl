// Read side of the inferred-return rows: the recorded name, arena type and null question
// for a function or an anonymous lambda.
// Does not import the checker.
import { i32ToStr } from "./ast"
import {
  inferRetTy,
  inferRetTyIx,
  inferRetVUAt,
} from "./check_infer_rows"
import { tyBearsNull } from "./check_types"

// Name → its first index in the arrays, so the hot `inferRetNameOf` is an O(1) map lookup rather
// than a linear scan. An i32-valued map kept in sync by `recordInferRet`, first-wins. The arrays
// stay for the emitter's indexed access (`inferRetCount`/`inferRetTyAt`) and to hold the string
// type the map cannot.
export let inferRetIdx: {[string]: i32} = Map()

// The inferred-return null question, asked of the arena type `recordInferRet` banked beside
// the name, not of the rendered spelling (which only ever split on `|`). `ty < 0` returns
// false because every name-keyed row carries a real arena index; the node-keyed `#`-prefixed
// rows are the exception and are not read through this function.
export function inferRetBearsNull(name: string): boolean {
  const ty = inferRetTyIxOf(name)
  if ty < 0 { return false }
  tyBearsNull(ty)
}

export function inferRetNameOf(name: string) {
  const irHit = inferRetIdx[name]
  if irHit is i32 {
    const i = irHit
    if i >= 0 { return inferRetTy[i] }
  }
  ""
}

// The inferred-return name of an anonymous lambda, keyed by its `FuncDecl` node index (the
// emitter passes `fnStmts[i]`). Anonymous lambdas are recorded under a `#<nodeIx>` sentinel
// key (they have no real name); the emitter consults this when the name-keyed lookup misses.
export function inferRetNameByNode(nodeIx: i32) {
  return inferRetNameOf("#" + i32ToStr(nodeIx))
}

// The arena sibling of `inferRetNameOf` / `inferRetNameByNode`: the `Ty` index the recorder
// banked for the same row the name comes from, so a consumer needing the type does not
// re-parse the name to get it. `-1` where the recorder had no arena index.
export function inferRetTyIxOf(name: string) {
  const irxHit = inferRetIdx[name]
  if irxHit is i32 {
    const i = irxHit
    if i >= 0 { return inferRetTyIx[i] }
  }
  -1
}

// Whether the inferred-return name recorded under `name` is a value union, as its producer said.
export function inferRetIsValueUnion(name: string): boolean {
  const vuHit = inferRetIdx[name]
  if vuHit is i32 { return inferRetVUAt(vuHit) }
  false
}

export function inferRetTyIxByNode(nodeIx: i32) {
  return inferRetTyIxOf("#" + i32ToStr(nodeIx))
}

// The row index, resolved once — so a consumer that wants both the recorded name and the
// recorded type reads one lookup and two columns instead of two lookups that happen to agree.
// Every `recordInferRet` call site passes both, so no row can carry a name without a type.
export function inferRetRowOf(name: string): i32 {
  const irrHit = inferRetIdx[name]
  if irrHit is i32 { return irrHit }
  -1
}

export function inferRetRowByNode(nodeIx: i32): i32 {
  inferRetRowOf("#" + i32ToStr(nodeIx))
}

// Clears this module's tables (called from `initChecker`).
export function inferRetReset() { inferRetIdx = Map() }
