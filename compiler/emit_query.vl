// `emit_query.vl` — pure classification queries over the AST: binding/value-kind
// predicates (`param*`/`let*`/`is*`/`union*`) and control-flow, valued-return and
// arr-new scans (`if*`/`block*`/`expr*`/`nli*`). State-free, depending only on
// `emit_base` and the lower modules.

import { nodeTyIsMap, nodeTyIxOf, nodeTyPrimName } from "./check_node_tys"
import { inferRetFnKey } from "./check_side_rows"
import { inferRetNameOf } from "./check_infer_ret"
import { tyIsNulValueUnionBox } from "./check_types"
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  ImportDecl,
  Index,
  IsExpr,
  LetDecl,
  LoopVar,
  MatchExpr,
  Member,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  Program,
  RetStmt,
  Spread,
  StrLit,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  externGlobalLinkOfNode,
  nodeAt,
  nodeChildren,
} from "./ast"
import { numLexIs2Pow31, numLexIsFloat, parseI64Pair } from "./emit_bignum"
import { cexLitPeel, intLitIsNegated } from "./check_num_lits"
import {
  ALLOC_LIT_CHUNK,
  isConstInit,
  pushUniqueAtom,
  retF64Flag,
  setShapeOfTy,
  tyIsFuncType,
  tyIsNulBool,
  tyNameOf,
  unwrapParen,
} from "./emit_base"
import { nodeTyAt, numLitWidth } from "./emit_capture_frames"
import { globalIndexBySid, globalStmts, scopeSlotOf } from "./emit_state"
import { sidArrGet, sidOfNode } from "./symbols"
import { nodeRepIs, nodeTyIsNulScalarBox } from "./emit_rep"
import { valueAtomKind } from "./check_ty_rep"

// True if param `name` of function `fnIx` is a nullable function value (`fn | null`,
// kind 19) — the closure dual of `paramNulRef`.
export function paramNulClosure(fnIx: i32, name: string) {
  nodeRepIs(paramTypeNode(fnIx, name), "nulclosure", fnIx)
}
// True if the `LetDecl` at `letIx` declares a nullable i32-list local or global
// (`i32[] | null`, kind 15). Annotation-only: no call yet returns a nullable list,
// and a `[…]` init under the annotation keeps the nullable slot — narrowing is
// type-level, the slot type is the annotation's.
export function letIsNulList(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      if nodeRepIs(d.letType, "nullist", fnIx) { return true }
    }
  }
  false
}
// True if the parameter `name` of function `fnIx` is a nullable i32 list.
export function paramNulList(fnIx: i32, name: string) {
  nodeRepIs(paramTypeNode(fnIx, name), "nullist", fnIx)
}
export function paramNulString(fnIx: i32, name: string) {
  nodeRepIs(paramTypeNode(fnIx, name), "nulstr", fnIx)
}
// True if the block contains a `return e` with a value (recursing into if/while/for
// bodies) — a bare `return` does not count, since a void function may bare-return.
export function blockHasValuedReturn(blockIx: i32) {
  const b = nodeAt(blockIx)
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      const st = nodeAt(stmts[i])
      if st is RetStmt {
        if st.retArg >= 0 { return true }
      } else if st is IfStmt {
        if ifChainHasValuedReturn(stmts[i]) { return true }
      } else if st is WhileStmt {
        if blockHasValuedReturn(st.whileBody) { return true }
      } else if st is ForRange {
        if blockHasValuedReturn(st.frBody) { return true }
      } else if st is ForIn {
        if blockHasValuedReturn(st.fiBody) { return true }
      }
      i = i + 1
    }
  }
  false
}
function ifChainHasValuedReturn(ifIx: i32) {
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ifIx
  while cur >= 0 {
    const st = nodeAt(cur)
    cur = -1
    if st is IfStmt {
      if blockHasValuedReturn(st.ifThen) { return true }
      if st.ifElse >= 0 {
        if nodeAt(st.ifElse) is IfStmt { cur = st.ifElse }
        else if blockHasValuedReturn(st.ifElse) { return true }
      }
    }
  }
  false
}
export function firstValuedReturn(blockIx: i32) {
  const b = nodeAt(blockIx)
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      const st = nodeAt(stmts[i])
      if st is RetStmt {
        if st.retArg >= 0 { return st.retArg }
      } else if st is IfStmt {
        const r = firstValuedReturnIf(stmts[i])
        if r >= 0 { return r }
      } else if st is WhileStmt {
        const r = firstValuedReturn(st.whileBody)
        if r >= 0 { return r }
      } else if st is ForRange {
        const r = firstValuedReturn(st.frBody)
        if r >= 0 { return r }
      } else if st is ForIn {
        const r = firstValuedReturn(st.fiBody)
        if r >= 0 { return r }
      }
      i = i + 1
    }
  }
  -1
}
function firstValuedReturnIf(ifIx: i32) {
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ifIx
  while cur >= 0 {
    const st = nodeAt(cur)
    cur = -1
    if st is IfStmt {
      const r = firstValuedReturn(st.ifThen)
      if r >= 0 { return r }
      if st.ifElse >= 0 {
        const els = nodeAt(st.ifElse)
        match els {
          Block => {
            return firstValuedReturn(st.ifElse)
          }
          IfStmt => {
            cur = st.ifElse
          }
          // any other else has no valued return
          NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
        }
      }
    }
  }
  -1
}
// ── parameter resolution ─────────────────────────────────────────────────────
// Scans the FuncDecl's `fnParams` for the param named `name`, returning its 0-based
// position (params occupy wasm locals `0..n-1`, before any declared locals) or -1.
// The caller adds `envSlotShift` for a module carrying the hidden env param.
export function paramIndexOf(fnIx: i32, name: string) {
  if fnIx < 0 {
    return -1 // module-scope initializer (no enclosing function)
  }
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    const params = fn.fnParams
    let i = 0
    while i < params.length {
      const p = nodeAt(params[i])
      if p is Param {
        if p.parName == name { return i }
      }
      i = i + 1
    }
  }
  -1
}
// `f(x) ?? d` scratch slot: a `??` whose left operand is a call cannot re-evaluate its
// lhs like `x ?? d` can, so it stashes the call's result in a 1-slot `(ref $uBoxIdx)`
// frame. `coalChainHasCallLhs` walks the left spine of a `??` chain (excluding the
// outermost `binRight`) since `emitCoalesce` re-associates `a ?? b ?? d` before this runs.
function coalChainHasCallLhs(binIx: i32) {
  const e = nodeAt(binIx)
  if e is BinExpr {
    const lIx = unwrapParen(e.binLeft)
    if lIx < 0 || lIx >= P.nodes.length { return false }
    const l = nodeAt(lIx)
    match l {
      Call => {
        return true
      }
      // Two more non-re-readable lhs shapes need this slot reserved too: an if-expression
      // operand — any rep stashes once, so a side-effecting condition is not evaluated
      // twice (D1250) — and an `as?` yielding a box, which cannot re-run the exactness
      // test on `(d as? i32) ?? 0` and so stashes like a call.
      IfStmt => {
        return true
      }
      AsExpr => {
        if tyIsNulValueUnionBox(nodeTyIxOf(lIx)) { return true }
        // A solo numeric nullable (`i32 | null`) is a box too, but `tyIsNulValueUnionBox`
        // answers false for it (it counts two-or-more members; a lone nullable is a niche).
        if nodeTyIsNulScalarBox(lIx) { return true }
      }
      BinExpr => {
        if l.binOp == "??" {
          const m = nodeAt(unwrapParen(l.binRight))
          if m is Call { return true }
          return coalChainHasCallLhs(lIx)
        }
      }
      // every other lhs can be re-read
      NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
    }
  }
  false
}

// What a scratch-frame scan looks for: "arrNew" is an intrinsic allocator call
// (`__array_new__` / `__array_new_default__`), which reserves the 1-slot arrNew frame;
// "coalesceCall" is a `??` whose left spine cannot be re-read (`coalChainHasCallLhs`),
// which reserves the 1-slot coalesce-call frame.
export type ScratchQuery = "arrNew" | "coalesceCall"

// True if the expression at `exprIx` contains what `q` asks for anywhere.
export function exprHasScratch(exprIx: i32, q: ScratchQuery) {
  if exprIx < 0 { return false }
  const e = nodeAt(exprIx)
  match e {
    Call => {
      if q == "arrNew" && e.callFn >= 0 && e.callFn < P.nodes.length {
        const callee = nodeAt(e.callFn)
        if callee is Ident {
          if callee.identName == "__array_new__" { return true }
          if callee.identName == "__array_new_default__" { return true }
        }
      }
      if exprHasScratch(e.callFn, q) { return true }
      const args = e.callArgs
      let i = 0
      while i < args.length {
        if exprHasScratch(args[i], q) { return true }
        i = i + 1
      }
      return false
    }
    BinExpr => {
      if q == "coalesceCall" && e.binOp == "??" {
        if coalChainHasCallLhs(exprIx) { return true }
      }
      if exprHasScratch(e.binLeft, q) { return true }
      return exprHasScratch(e.binRight, q)
    }
    Member => {
      return exprHasScratch(e.memObj, q)
    }
    // The `?.` receiver, walked like the `.` one above (D1667).
    OptMember => {
      return exprHasScratch(e.omObj, q)
    }
    Index => {
      if exprHasScratch(e.idxArr, q) { return true }
      return exprHasScratch(e.idxIndex, q)
    }
    Unary => {
      return exprHasScratch(e.unArg, q)
    }
    Paren => {
      return exprHasScratch(e.parInner, q)
    }
    IsExpr => {
      return exprHasScratch(e.isObj, q)
    }
    AsExpr => {
      return exprHasScratch(e.asObj, q)
    }
    // An if-expression is an `IfStmt` node in value position; without this arm neither its
    // allocator length nor its `??` would reach the frame the scan reserves.
    IfStmt => {
      return ifChainHasScratch(exprIx, q)
    }
    ObjLit => {
      const fields = e.objFields
      let i = 0
      while i < fields.length {
        const f = nodeAt(fields[i])
        if f is FieldInit {
          if exprHasScratch(f.fiValue, q) { return true }
        }
        i = i + 1
      }
      return false
    }
    // A spread's source is an operand like any other (D2334).
    Spread => {
      return exprHasScratch(e.spdArg, q)
    }
    ArrayLit => {
      const elems = e.arrElems
      let i = 0
      while i < elems.length {
        if exprHasScratch(elems[i], q) { return true }
        i = i + 1
      }
      return false
    }
    // a leaf or a form whose operands this scan does not reach
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | ForRange | ForIn | MatchExpr | ImportDecl | LoopVar => {}
  }
  false
}

// True if any statement in the block at `blockIx` (descending into if/else arms and loop
// bodies) contains what `q` asks for. The non-statement case falls through to the
// expression walker rather than enumerating shapes — an expression-bodied lambda's
// synthetic one-statement Block is exactly what a fixed set would miss.
export function blockHasScratch(blockIx: i32, q: ScratchQuery) {
  const b = nodeAt(blockIx)
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      const s = nodeAt(stmts[i])
      if s is LetDecl {
        if exprHasScratch(s.letInit, q) { return true }
      } else if s is RetStmt {
        if exprHasScratch(s.retArg, q) { return true }
      } else if s is IfStmt {
        if ifChainHasScratch(stmts[i], q) { return true }
      } else if s is WhileStmt {
        if exprHasScratch(s.whileCond, q) { return true }
        if blockHasScratch(s.whileBody, q) { return true }
      } else if s is ForIn {
        if exprHasScratch(s.fiIter, q) { return true }
        if blockHasScratch(s.fiBody, q) { return true }
      } else if s is ForRange {
        if exprHasScratch(s.frFrom, q) { return true }
        if exprHasScratch(s.frTo, q) { return true }
        if exprHasScratch(s.frStep, q) { return true }
        if blockHasScratch(s.frBody, q) { return true }
      } else {
        if exprHasScratch(stmts[i], q) { return true }
      }
      i = i + 1
    }
  }
  false
}

// True if any arm of the `if` / `else if` chain at `ifIx` contains what `q` asks for —
// condition, then-branch, `else` block, or a chained `else if`.
function ifChainHasScratch(ifIx: i32, q: ScratchQuery) {
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ifIx
  while cur >= 0 {
    const s = nodeAt(cur)
    cur = -1
    if s is IfStmt {
      if exprHasScratch(s.ifCond, q) { return true }
      if blockHasScratch(s.ifThen, q) { return true }
      if s.ifElse >= 0 {
        const els = nodeAt(s.ifElse)
        match els {
          Block => {
            return blockHasScratch(s.ifElse, q)
          }
          IfStmt => {
            cur = s.ifElse
          }
          // any other else holds no scratch
          NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
        }
      }
    }
  }
  false
}

// True if the FuncDecl at `fnIx` contains what `q` asks for, so it reserves that frame.
export function fnHasScratch(fnIx: i32, q: ScratchQuery) {
  const fn = nodeAt(fnIx)
  if fn is FuncDecl { return blockHasScratch(fn.fnBody, q) }
  false
}
// True if the expression at `ix` is an if-EXPRESSION (an `IfStmt` in value position).
export function exprIsIfStmt(ix: i32) {
  if ix < 0 { return false }
  const e = nodeAt(unwrapParen(ix))
  if e is IfStmt { return true }
  false
}
// The tail value expression of an if-expression arm — the last statement of the arm
// Block, or -1 for an empty arm or non-block (`exprIs*` guards `< 0`, reading it as the
// i32 default). An arm may carry leading statements before its value (its prelude,
// lowered by `emitIfArmOpen`); only the block's last statement is the arm's value.
export function ifArmValueExpr(blockIx: i32) {
  const b = nodeAt(blockIx)
  if b is Block {
    const stmts = b.blkStmts
    if stmts.length > 0 { return stmts[stmts.length - 1] }
  }
  -1
}
// True if the parameter `name` of the function at `fnIx` is annotated `f64`.
export function paramIsF64(fnIx: i32, name: string) {
  retF64Flag(paramTypeNode(fnIx, name)) == 1
}
// Whether the loop body at `blockIx` contains a `continue` binding to this loop
// (labelled `label`, "" when unlabelled). An unlabelled `continue` binds to the
// innermost loop, so it counts only when not `nested`; a labelled `continue @l` binds
// to the loop labelled `l` from anywhere, including inside nested loops.
export function blockHasContinueFor(
  blockIx: i32,
  label: string,
  nested: boolean,
) {
  subtreeHasContinueFor(blockIx, label, nested)
}
// The walk behind `blockHasContinueFor`, over every child, so a `continue` inside an
// expression (a value `if` or `match` arm) is found as well as one in a statement.
// A nested loop's body is `nested`; a function body is a boundary no `continue` crosses.
// An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
function subtreeHasContinueFor(ix: i32, label: string, nested: boolean) {
  let cur = ix
  while cur >= 0 && cur < P.nodes.length {
    const n = nodeAt(cur)
    if n is IfStmt {
      if subtreeHasContinueFor(n.ifCond, label, nested) { return true }
      if subtreeHasContinueFor(n.ifThen, label, nested) { return true }
      cur = n.ifElse
    } else {
      return nodeHasContinueFor(cur, label, nested)
    }
  }
  false
}
// One node of `subtreeHasContinueFor`'s walk other than an `if`: a `continue`, a boundary,
// or a descent into every child.
function nodeHasContinueFor(ix: i32, label: string, nested: boolean) {
  const n = nodeAt(ix)
  if n is ContinueStmt {
    if n.contLabel == "" { return !nested }
    return label != "" && n.contLabel == label
  }
  if n is FuncDecl { return false }
  let inner = nested
  // A labelled block is no loop: a bare `continue` inside it binds to the loop around it.
  let isLoop = n is ForRange || n is ForIn
  if n is WhileStmt { isLoop = n.whileBlk == 0 }
  if isLoop {
    if label == "" { return false }
    inner = true
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if subtreeHasContinueFor(kids[i], label, inner) { return true }
    i = i + 1
  }
  false
}
// True if the `LetDecl` at `letIx` is annotated `boolean|null`.
export function letIsNulBoolAnn(letIx: i32) {
  if letIx < 0 { return false }
  const d = nodeAt(letIx)
  if d is LetDecl { return tyIsNulBool(d.letType) }
  false
}
// Whether the module global declared by the `LetDecl` at `letIx` has no constant
// initializer (a non-const one, or none), so its cell is nullable and zero-initialized and a
// later write gives it its value. False for a non-`LetDecl` and an `extern let`, whose cell is the import.
export function globalIsNonConst(letIx: i32) {
  if letIx < 0 { return false }
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letInit < 0 { return externGlobalLinkOfNode(letIx) < 0 }
    return !letInitIsConst(d)
  }
  false
}
// Whether a module binding's initializer lowers as a constant expression: `isConstInit`, or
// a negated numeric literal, which folds to one constant (`wNegateConstFrom`) — but only into
// a bare numeric cell, since a union box widens an i64 operand with `i64.extend_i32_s`.
function letInitIsConst(d: LetDecl): boolean {
  letInitIsLiteral(d) || constFoldOfLet(d).cfOk
}

// Whether a long list literal initializes a cell its annotation does not spell as a bare scalar
// list, so its elements box and it builds in the start function, in chunks (D3462).
function letInitLongIntoBoxedCell(d: LetDecl): boolean {
  if d.letType < 0 { return false }
  const a = nodeAt(unwrapParen(d.letInit))
  if a is ArrayLit {
    if a.arrElems.length <= ALLOC_LIT_CHUNK { return false }
    const tn = tyNameOf(d.letType)
    return tn != "i32[]"
      && tn != "i64[]"
      && tn != "f64[]"
      && tn != "f32[]"
      && tn != "u8[]"
      && tn != "boolean[]"
  }
  false
}

// Whether a module binding's initializer is itself a constant expression, needing no fold.
function letInitIsLiteral(d: LetDecl): boolean {
  if isConstInit(d.letInit) { return !letInitLongIntoBoxedCell(d) }
  const u = nodeAt(unwrapParen(d.letInit))
  if u is Unary {
    if u.unOp != "-" { return false }
    const a = nodeAt(unwrapParen(u.unArg))
    if a is NumLit {
      if d.letType < 0 { return true }
      const tn = tyNameOf(d.letType)
      return tn == "i32" || tn == "i64" || tn == "f64" || tn == "f32"
    }
  }
  false
}

// Whether module `const` `d` is a constant only by `constFoldOfLet`: its cell holds the folded
// value, and a read of it before its declaration is still guarded as the start function's is.
export function letInitFoldsExpr(d: LetDecl): boolean {
  !letInitIsLiteral(d) && constFoldOfLet(d).cfOk
}

// A compile-time integer: `cfOk` false when the expression does not fold, `cfV` the value
// (an i32 result sign-extended), `cfN` the nodes the fold visited against its budget.
export type ConstFold = { cfOk: boolean, cfV: i64, cfN: i32 }

// The nodes one fold may visit, referenced initializers included. A const whose expansion is
// larger keeps its cell, which bounds a doubling chain like `B = A + A; C = B + B`.
const CONST_FOLD_BUDGET = 256

function cfNo(): ConstFold { { cfOk: false, cfV: 0 as i64, cfN: 0 } }

// The value of module `const` `d` when its initializer is an integer constant expression of
// its own type: integer literals, other such consts, `+ - * / % & | ^ << >> >>>`, unary
// `-`/`~`, and integer casts. Computed with the runtime's own operators, so it wraps and
// masks shift counts identically; a division that would trap is left to trap.
export function constFoldOfLet(d: LetDecl): ConstFold {
  if d.letKw != "const" || d.letInit < 0 { return cfNo() }
  const tn = nodeTyPrimName(d.letInit)
  if tn != "i32" && tn != "i64" { return cfNo() }
  if d.letType >= 0 {
    if tyNameOf(d.letType) != tn { return cfNo() }
  }
  constFoldExpr(d.letInit, tn == "i64", CONST_FOLD_BUDGET)
}

// `ix` folded at i64 when `wide`, else at i32, visiting at most `budget` nodes. Every
// operator node must carry the fold's own type, so no operand is widened on the way.
function constFoldExpr(ix: i32, wide: boolean, budget: i32): ConstFold {
  if budget <= 0 || ix < 0 { return cfNo() }
  const e = nodeAt(ix)
  if e is Paren { return constFoldExpr(e.parInner, wide, budget - 1) }
  if e is NumLit {
    if !wide && constFoldLitWide(ix) { return cfNo() }
    return constFoldLit(e.numText, wide)
  }
  const tn = nodeTyPrimName(ix)
  if e is AsExpr { return constFoldCast(e, tn, wide, budget) }
  if (wide && tn != "i64") || (!wide && tn != "i32") { return cfNo() }
  if e is Ident { return constFoldIdent(ix, wide, budget) }
  if e is Unary {
    if cexLitPeel(ix) >= 0 { return constFoldLitAt(ix, wide) }
    const a = constFoldExpr(e.unArg, wide, budget - 1)
    if !a.cfOk { return a }
    if e.unOp == "-" {
      return constFoldWrap((0 as i64) - a.cfV, wide, a.cfN + 1)
    }
    if e.unOp == "~" { return constFoldWrap(~a.cfV, wide, a.cfN + 1) }
    return cfNo()
  }
  if e is BinExpr {
    const l = constFoldExpr(e.binLeft, wide, budget - 1)
    if !l.cfOk { return l }
    const r = constFoldExpr(e.binRight, wide, budget - 1 - l.cfN)
    if !r.cfOk { return r }
    const n = l.cfN + r.cfN + 1
    if wide { return constFoldOp64(e.binOp, l.cfV, r.cfV, n) }
    return constFoldOp32(e.binOp, l.cfV as% i32, r.cfV as% i32, n)
  }
  cfNo()
}

// An integer cast to the fold's own width: `as i64` of an i32 sign-extends, `as% i32` of an
// i64 keeps the low 32 bits, and a checked narrowing folds only where it cannot fail.
function constFoldCast(
  e: AsExpr,
  tn: string,
  wide: boolean,
  budget: i32,
): ConstFold {
  if e.asTy != tn || (wide && tn != "i64") || (!wide && tn != "i32") {
    return cfNo()
  }
  // A literal operand, negated or not, is converted from its full magnitude, as the emitter
  // builds it at the cast's source width.
  let from = nodeTyPrimName(e.asObj)
  const lit = cexLitPeel(e.asObj) >= 0
  if lit { from = "i64" }
  if from != "i32" && from != "i64" { return cfNo() }
  let a = cfNo()
  if lit {
    a = cfStep(constFoldLitAt(e.asObj, from == "i64"))
  } else {
    a = cfStep(constFoldExpr(e.asObj, from == "i64", budget - 1))
  }
  if !a.cfOk || wide || from == "i32" { return a }
  if e.asMode == "wrap" { return constFoldWrap(a.cfV, false, a.cfN) }
  const lo = constFoldWrap(a.cfV, false, a.cfN)
  if lo.cfV != a.cfV { return cfNo() }
  lo
}

// Whether the integer literal at `ix` is an i64: the emitter builds it as `i64.const`, and a
// `-` in front of it negates that value, not its low 32 bits.
function constFoldLitWide(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  numLitWidth(ix, -1) == "i64"
}

// The literal under parentheses and minuses at `ix`, folded at i64 when `wide`: its full value,
// signed, which at i32 is refused for an i64 literal unless the negation fits (`-2147483648`).
function constFoldLitAt(ix: i32, wide: boolean): ConstFold {
  const k = cexLitPeel(ix)
  if k < 0 { return cfNo() }
  const lit = nodeAt(k)
  if !(lit is NumLit) { return cfNo() }
  const neg = intLitIsNegated(ix)
  if !wide && constFoldLitWide(k) && !(neg && numLexIs2Pow31(lit.numText)) {
    return cfNo()
  }
  const a = constFoldLit(lit.numText, true)
  if !a.cfOk || !neg { return constFoldWrap(a.cfV, wide, 2) }
  constFoldWrap((0 as i64) - a.cfV, wide, 2)
}

// `a` with one more visited node charged to it.
function cfStep(a: ConstFold): ConstFold {
  { cfOk: a.cfOk, cfV: a.cfV, cfN: a.cfN + 1 }
}

// An integer literal at the fold's width: at i32 its low 32 bits, the bit pattern the
// runtime's `i32.const` carries.
function constFoldLit(text: string, wide: boolean): ConstFold {
  if numLexIsFloat(text) { return cfNo() }
  const pr = parseI64Pair(text)
  const lo = (pr[1] as i64) & (0xffffffff as i64)
  constFoldWrap(((pr[0] as i64) << (32 as i64)) | lo, wide, 1)
}

// A read of another module `const`, folded through that const's own initializer.
function constFoldIdent(ix: i32, wide: boolean, budget: i32): ConstFold {
  const gi = sidArrGet(globalIndexBySid, sidOfNode(ix))
  if gi < 0 || gi >= globalStmts.length { return cfNo() }
  const g = nodeAt(globalStmts[gi])
  if g is LetDecl {
    if g.letKw != "const" || g.letInit < 0 { return cfNo() }
    return cfStep(constFoldExpr(g.letInit, wide, budget - 1))
  }
  cfNo()
}

// `v` cut to the fold's width: an i32 result is its low 32 bits, sign-extended.
function constFoldWrap(v: i64, wide: boolean, n: i32): ConstFold {
  if wide { return { cfOk: true, cfV: v, cfN: n } }
  { cfOk: true, cfV: (v << (32 as i64)) >> (32 as i64), cfN: n }
}

// One i32 operator, computed by the operator the runtime lowers it with. A zero divisor and
// `INT_MIN / -1` trap at run time, so they do not fold.
function constFoldOp32(op: string, a: i32, b: i32, n: i32): ConstFold {
  let v = 0
  if op == "+" {
    v = a + b
  } else if op == "-" {
    v = a - b
  } else if op == "*" {
    v = a * b
  } else if op == "&" {
    v = a & b
  } else if op == "|" {
    v = a | b
  } else if op == "^" {
    v = a ^ b
  } else if op == "<<" {
    v = a << b
  } else if op == ">>" {
    v = a >> b
  } else if op == ">>>" {
    v = a >>> b
  } else if op == "/" || op == "%" {
    if b == 0 || (b == -1 && a == -2147483647 - 1) { return cfNo() }
    if op == "/" { v = a / b } else { v = a % b }
  } else {
    return cfNo()
  }
  { cfOk: true, cfV: v as i64, cfN: n }
}

// The i64 twin of `constFoldOp32`.
function constFoldOp64(op: string, a: i64, b: i64, n: i32): ConstFold {
  let v = 0 as i64
  if op == "+" {
    v = a + b
  } else if op == "-" {
    v = a - b
  } else if op == "*" {
    v = a * b
  } else if op == "&" {
    v = a & b
  } else if op == "|" {
    v = a | b
  } else if op == "^" {
    v = a ^ b
  } else if op == "<<" {
    v = a << b
  } else if op == ">>" {
    v = a >> b
  } else if op == ">>>" {
    v = a >>> b
  } else if op == "/" || op == "%" {
    const zero = 0 as i64
    if b == zero || (b == zero - (1 as i64) && a == (1 as i64) << (63 as i64)) {
      return cfNo()
    }
    if op == "/" { v = a / b } else { v = a % b }
  } else {
    return cfNo()
  }
  { cfOk: true, cfV: v, cfN: n }
}
// Whether the cell at `globalStmts` position `gi` is an immutable wasm global: a `const`
// whose initializer is a constant expression, so the global section is its only writer.
// Engines fold or hoist a read of an immutable global; a mutable one is re-loaded.
export function globalCellIsImmutable(gi: i32): boolean {
  if gi < 0 || gi >= globalStmts.length { return false }
  const d = nodeAt(globalStmts[gi])
  if d is LetDecl {
    if d.letKw != "const" || d.letInit < 0 { return false }
    return letInitIsConst(d)
  }
  false
}
// True if the module global `LetDecl` at `letIx` carries a type annotation (`let g: T
// = …`). When it does, the cell's wasm type must come from the annotation, the same way
// a local or param resolves its valtype — otherwise `global.get g` on an init-inferred
// struct type mismatches a same-typed local's `local.set`/call struct table index.
export function globalHasTypeAnn(letIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl { return d.letType >= 0 }
  false
}
// The value-union atom name an assignment RHS fills a null hole with ("i32",
// "boolean", "string", "f64", "i64"), or "" when the RHS is not classifiable at
// collection time (an ident, a member read, …). A call RHS reads the callee's
// declared return annotation straight from the arena; the fn tables are not built yet.
export function nliAtomOfExpr(exprIx: i32) {
  if exprIx < 0 { return "" }
  const e = nodeAt(unwrapParen(exprIx))
  match e {
    NumLit => {
      return numLitWidth(unwrapParen(exprIx), -1)
    }
    StrLit => {
      return "string"
    }
    BoolLit => {
      return "boolean"
    }
    Call => {
      if e.callFn < 0 || e.callFn >= P.nodes.length { return "" }
      const callee = nodeAt(e.callFn)
      if callee is Ident {
        const cn = callee.identName
        let ti = 0
        while ti < P.nodes.length {
          const f = nodeAt(ti)
          if f is FuncDecl {
            if f.fnName == cn {
              let rn = tyNameOf(f.fnRet)
              // An un-annotated callee is not an unknown callee: `tyNameOf` answers "" both
              // for "no return type" and for "checker inferred one" (`inferRetIdx`, filled by
              // `elaborateInferRets`), so falling back to `inferRetNameOf` here recovers the
              // inferred name — `registerValueUnionName` is name-keyed, so a name is what it needs.
              if rn == "" { rn = inferRetNameOf(inferRetFnKey(ti, f.fnName)) }
              if valueAtomKind(rn) >= 0 && rn != "null" { return rn }
              return ""
            }
          }
          ti = ti + 1
        }
      }
    }
    // not classifiable at collection time
    CharLit | NullLit | Ident | Unary | BinExpr | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  ""
}
// Scan the statement list `walk` from position `from` for the FIRST classifiable
// assignment `name = e`, descending into branch/loop blocks.
export function nliScanStmts(walk: i32[], from: i32, name: string) {
  let i = from
  while i < walk.length {
    const a = nliScanStmt(walk[i], name)
    if a != "" { return a }
    i = i + 1
  }
  ""
}
// Scan one statement (an `else if` chains a lone IfStmt through here too).
function nliScanStmt(stmtIx: i32, name: string) {
  if stmtIx < 0 { return "" }
  const s = nodeAt(stmtIx)
  match s {
    BinExpr => {
      if s.binOp == "=" {
        const tgt = nodeAt(s.binLeft)
        if tgt is Ident {
          if tgt.identName == name { return nliAtomOfExpr(s.binRight) }
        }
      }
      return ""
    }
    IfStmt => {
      const a = nliScanBlock(s.ifThen, name)
      if a != "" { return a }
      return nliScanStmt(s.ifElse, name)
    }
    Block => {
      return nliScanStmts(s.blkStmts, 0, name)
    }
    WhileStmt => {
      return nliScanBlock(s.whileBody, name)
    }
    ForRange => {
      return nliScanBlock(s.frBody, name)
    }
    ForIn => {
      return nliScanBlock(s.fiBody, name)
    }
    // no assignment this scan descends into
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | BreakStmt | ContinueStmt | RetStmt | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  ""
}
function nliScanBlock(blockIx: i32, name: string) {
  if blockIx < 0 { return "" }
  nliScanStmt(blockIx, name)
}
// Classifies one if-expression arm (`blockIx`, a one-statement Block) at registration
// time — a static pre-pass, so only literal or annotated-call atoms resolve. Returns 1
// for a bare `null` arm, 0 for a classified atom (pushed onto `atoms`), or -2 if the
// arm is unclassifiable.
function collectArmAtom(blockIx: i32, atoms: string[]) {
  const v = ifArmValueExpr(blockIx)
  if v < 0 { return -2 }
  const bare = nodeAt(unwrapParen(v))
  if bare is NullLit { return 1 }
  const atom = nliAtomOfExpr(v)
  if atom == "" { return -2 }
  pushUniqueAtom(atoms, atom)
  0
}
// Gathers the value atoms of every arm of the if-expression at `ifIx` into `atoms`
// (deduped), recursing through an `else if` chain. Returns -2 if any arm is
// unclassifiable, else 0/1 for whether a `null` arm or an else-less false path exists.
export function ifExprCollectAtoms(ifIx: i32, atoms: string[]) {
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let hasNull = 0
  let cur = ifIx
  while cur >= 0 {
    const s = nodeAt(unwrapParen(cur))
    cur = -1
    if s is IfStmt {
      const t = collectArmAtom(s.ifThen, atoms)
      if t == -2 { return -2 }
      if t == 1 { hasNull = 1 }
      if s.ifElse < 0 {
        return 1 // else-less: the false path is null
      }
      if nodeAt(s.ifElse) is IfStmt {
        cur = s.ifElse
      } else {
        const e = collectArmAtom(s.ifElse, atoms)
        if e == -2 { return -2 }
        if e == 1 { hasNull = 1 }
        return hasNull
      }
    }
  }
  -2
}
// The type-annotation node index of parameter `name` of function `fnIx` (its `parType`),
// or -1 (no such param, module scope, un-annotated, or `name` shadowed by a live lexical
// binding). The one param-scan the whole `param*` type-predicate family shares, so they
// agree with `localIndexOf` on the same shadowing — a disagreement there built invalid wasm.
export function paramTypeNode(fnIx: i32, name: string) {
  if fnIx < 0 { return -1 }
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    const params = fn.fnParams
    let i = 0
    while i < params.length {
      const p = nodeAt(params[i])
      if p is Param {
        if p.parName == name {
          if scopeSlotOf(name) >= 0 { return -1 }
          return p.parType
        }
      }
      i = i + 1
    }
  }
  -1
}

// Usage-driven element inference for an un-annotated empty `[]` binding: a
// string-literal `.push` argument makes it a `string[]` (`const xs = []; xs.push("hi")`),
// mirroring the checker's own usage-driven inference. Only string-literal push
// arguments count — a richer operand would need the full classifier, recursing back here.
export function letInfStrListByUse(letIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 { return false }
    if d.letInit < 0 { return false }
    const ini = nodeAt(unwrapParen(d.letInit))
    if ini is ArrayLit {
      if ini.arrElems.length != 0 { return false }
      let i = 0
      while i < P.nodes.length {
        const nd = nodeAt(i)
        if nd is Call && nd.callFn >= 0 && nd.callFn < P.nodes.length {
          const callee = nodeAt(nd.callFn)
          if callee is Member {
            if callee.memProp == "push" {
              const recv = nodeAt(callee.memObj)
              if recv is Ident {
                if recv.identName == d.letName {
                  if nd.callArgs.length == 1 {
                    const argN = nodeAt(unwrapParen(nd.callArgs[0]))
                    if argN is StrLit { return true }
                  }
                }
              }
            }
          }
        }
        i = i + 1
      }
    }
  }
  false
}
// True if the parameter `name` of function `fnIx` is a bare map type — `nodeTyIsMap`
// on the arena, not a name test. A union param whose first atom is a map (`{[string]:
// V} | X`) is NOT a bare map: it boxes into the union, so an un-annotated copy of the
// param must ride the box and read the map arm through `is`-narrowing.
export function paramMap(fnIx: i32, name: string) {
  nodeTyIsMap(paramTypeNode(fnIx, name))
}
// True if the `LetDecl` at `letIx` binds a set — its annotation or initializer is set-typed
// (`mSet`), or its initializer is the `Set()` constructor. Set-ness is a flavor bit over the
// shared map rep: a set's `.values()` yields its elements (the keys list), not the membership
// booleans in `vals`.
export function letIsSet(letIx: i32, fnIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 && setShapeOfTy(nodeTyAt(d.letType, fnIx)) != 0 {
      return true
    }
    if d.letInit >= 0 && setShapeOfTy(nodeTyAt(d.letInit, fnIx)) != 0 {
      return true
    }
    // A `let m: Map<…>` with no initializer names no constructor (D3255).
    if d.letInit < 0 { return false }
    const init = nodeAt(d.letInit)
    if init is Call {
      if init.callFn < 0 || init.callFn >= P.nodes.length { return false }
      const callee = nodeAt(init.callFn)
      if callee is Ident { return callee.identName == "Set" }
    }
  }
  false
}
// True if the `LetDecl`/global at `letIx` declares an `f32` binding. Annotation-only:
// a bare float literal stays f64 by default, so only an explicit `: f32` annotation
// selects the f32 slot (valtype `0x7d`, kind 13) and lowers the initializer as `f32.const`.
export function letIsF32(letIx: i32) {
  const d = nodeAt(letIx)
  if d is LetDecl {
    if d.letType >= 0 {
      const lt = nodeAt(d.letType)
      if lt is TypeRef {
        // `nodeTyPrimName` answers "" both for "not f32" and for "no type recorded", so this
        // picks the arena leg only where `nodeTyIxOf` covers the node, falling back to the raw
        // spelling otherwise — under-answering would drop an f32 local into the f64 slot. An f32
        // alias cannot disagree between the two: `canonEmitTypeNames` rewrites it to `f32` first.
        if nodeTyIxOf(d.letType) >= 0 {
          if nodeTyPrimName(d.letType) == "f32" { return true }
        } else if lt.tyName == "f32" {
          return true
        }
      }
    }
  }
  false
}
// True if the parameter `name` of function `fnIx` is annotated as a function type
// (lowered to the closure fat-pointer, kind 14).
export function paramIsClosure(fnIx: i32, name: string) {
  tyIsFuncType(paramTypeNode(fnIx, name))
}
