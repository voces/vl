import {
  RepDesc,
  mapShapeKeyKind,
  nulScalarBoxAtomOf,
  repOfNodeAt,
  repOfTy,
  repVariantShapeRowOf,
  tyMapKeyKind,
} from "./emit_rep"
import { mvCanonRepOf } from "./emit_shape_rows"
