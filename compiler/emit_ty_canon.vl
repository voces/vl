// `emit_ty_canon.vl` — a type's canonical key and spelled-alike tests, and the
// pinned or hole type a binding, operand or instance carries.

import {
  BinExpr,
  Block,
  FuncDecl,
  Ident,
  IfStmt,
  LetDecl,
  MatchExpr,
  NullLit,
  Param,
  nodeAt,
} from "./ast"
import { holePinReadOf } from "./check_emit_queries"
