// The binding-identity audit: after the last arena-rewriting pass, every `Ident` the emitter
// can reach must carry a declaration in `identDeclOf`. Off unless a host arms it; armed, it
// counts the identifiers left at -1, by the kind of node holding them and by the pass that
// minted them (`docs/internals/fn-value-flow-design.md` §(f) step 0).
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  ImportDecl,
  Index,
  IsExpr,
  LetDecl,
  MatchExpr,
  Member,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  Program,
  RetStmt,
  Spread,
  StrLit,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  nodeChildren,
} from "./ast"
import {
  IDENT_BUILTIN,
  identAuditPassSet,
  identDeclOf,
  identWritePassOf,
} from "./symbols"

let iaArmed = false
let iaNamed = false
let iaMarkName: string[] = []
let iaMarkLen: i32[] = []
let iaRowKey: string[] = []
let iaRowN: i32[] = []
let iaUnresolved = 0
let iaBuiltinDeclared = 0
let iaMisresolved = 0

// Arm (1) or disarm (0) the audit for the compiles that follow; 2 also names each identifier
// in its row.
export function identAuditArm(on: i32) {
  iaArmed = on != 0
  iaNamed = on == 2
  0
}

// Start a compile's audit: the arena so far is the parser's and the checker's.
export function identAuditBegin() {
  iaMarkName = []
  iaMarkLen = []
  iaRowKey = []
  iaRowN = []
  iaUnresolved = 0
  iaBuiltinDeclared = 0
  iaMisresolved = 0
  if iaArmed { identAuditMark("check") }
  0
}

// Record that pass `name` has run, so a node minted since the previous mark is attributed
// to it.
export function identAuditMark(name: string) {
  if !iaArmed { return 0 }
  iaMarkName.push(name)
  iaMarkLen.push(P.nodes.length)
  identAuditPassSet(iaMarkName.length)
  0
}

// The pass that last touched identifier `ix`: the later of the one that minted it (the first
// mark taken after it existed) and the one that last wrote its entry.
function iaMinter(ix: i32): string {
  let m = iaMarkLen.length
  let i = 0
  while i < iaMarkLen.length {
    if ix < iaMarkLen[i] && m == iaMarkLen.length { m = i }
    i = i + 1
  }
  const w = identWritePassOf(ix)
  if w > m { m = w }
  if m < iaMarkName.length { return iaMarkName[m] }
  "after the last pass"
}

function iaCount(key: string) {
  let i = 0
  while i < iaRowKey.length {
    if iaRowKey[i] == key {
      iaRowN[i] = iaRowN[i] + 1
      return 0
    }
    i = i + 1
  }
  iaRowKey.push(key)
  iaRowN.push(1)
  0
}

// The position an `Ident` child of `parent` occupies, named by the holder's kind.
function iaPosition(parent: i32, child: i32): string {
  if parent < 0 { return "statement" }
  const p = P.nodes[parent]
  match p {
    NumLit => "NumLit"
    StrLit => "StrLit"
    CharLit => "CharLit"
    BoolLit => "BoolLit"
    NullLit => "NullLit"
    Ident => "Ident"
    Unary => "Unary"
    BinExpr => if p.binLeft == child { "BinExpr.left" } else { "BinExpr.right" }
    Call => if p.callFn == child { "Call.callee" } else { "Call.arg" }
    Member => "Member"
    OptMember => "OptMember"
    Paren => "Paren"
    ErrExpr => "ErrExpr"
    LetDecl => "LetDecl"
    Param => "Param.default"
    TypeRef => "TypeRef"
    FuncDecl => "FuncDecl"
    IfStmt => "IfStmt"
    WhileStmt => "WhileStmt"
    BreakStmt => "BreakStmt"
    ContinueStmt => "ContinueStmt"
    RetStmt => "RetStmt"
    Block => "Block"
    Program => "Program"
    FieldDef => "FieldDef"
    TypeDecl => "TypeDecl"
    FieldInit => "FieldInit"
    ObjLit => "ObjLit"
    ArrayLit => "ArrayLit"
    Index => if p.idxArr == child { "Index.base" } else { "Index.index" }
    UnionDecl => "UnionDecl"
    IsExpr => "IsExpr"
    AsExpr => "AsExpr"
    ForRange => "ForRange"
    ForIn => "ForIn"
    MatchExpr => "MatchExpr"
    ImportDecl => "ImportDecl"
    Spread => "Spread"
  }
}

// The name declaration node `d` binds, or "" when `d` declares no name.
function iaDeclName(d: i32): string {
  if d < 0 || d >= P.nodes.length { return "" }
  const n = P.nodes[d]
  match n {
    FuncDecl => n.fnName
    LetDecl => n.letName
    Param => n.parName
    ForRange => n.frVar
    ForIn => n.fiVar
    NumLit => ""
    StrLit => ""
    CharLit => ""
    BoolLit => ""
    NullLit => ""
    Ident => ""
    Unary => ""
    BinExpr => ""
    Call => ""
    Member => ""
    OptMember => ""
    Paren => ""
    ErrExpr => ""
    TypeRef => ""
    IfStmt => ""
    WhileStmt => ""
    BreakStmt => ""
    ContinueStmt => ""
    RetStmt => ""
    Block => ""
    Program => ""
    FieldDef => ""
    TypeDecl => ""
    FieldInit => ""
    ObjLit => ""
    ArrayLit => ""
    Index => ""
    UnionDecl => ""
    IsExpr => ""
    AsExpr => ""
    MatchExpr => ""
    ImportDecl => ""
    Spread => ""
  }
}

// Whether a use spelled `nm` may resolve to declaration `d`: the same name, or a rename of
// it (`nm` is the declared name plus a `$` suffix), or a `for k, v` loop's second variable.
function iaNameFits(nm: string, d: i32): boolean {
  const dn = iaDeclName(d)
  if nm == dn || iaRenameOf(nm, dn) { return true }
  const n = P.nodes[d]
  if n is ForIn { return nm == n.fiVar2 || iaRenameOf(nm, n.fiVar2) }
  false
}

function iaRenameOf(nm: string, dn: string): boolean {
  if dn.length == 0 || nm.length <= dn.length || nm[dn.length] != '$' {
    return false
  }
  let i = 0
  while i < dn.length {
    if nm[i] != dn[i] { return false }
    i = i + 1
  }
  true
}

// The names a declaration binds at the point the walk stands, innermost last, and the nodes
// already visited; both live for one `identAuditRun`.
let iaScope: string[] = []
let iaSeen: boolean[] = []

function iaInScope(name: string): boolean {
  let i = iaScope.length - 1
  while i >= 0 {
    if iaScope[i] == name { return true }
    i = i - 1
  }
  false
}

// The kind of node `d`, as a position names it without the slot.
function iaKindOf(d: i32): string {
  const pos = iaPosition(d, -1)
  let i = 0
  while i < pos.length {
    if pos[i] == '.' { return pos.slice(0, i) }
    i = i + 1
  }
  pos
}

// Count the reachable `Ident` at `ix` (child of `par`) in at most one row: no recorded
// declaration; `IDENT_BUILTIN` although a declaration of its name is in scope; or resolved to a
// node that does not declare its name.
function iaIdent(ix: i32, par: i32, name: string) {
  const d = identDeclOf(ix)
  if d == -1 {
    iaUnresolved = iaUnresolved + 1
    iaCount(iaKey("", par, ix, name))
  } else if d == IDENT_BUILTIN {
    if iaInScope(name) {
      iaBuiltinDeclared = iaBuiltinDeclared + 1
      iaCount(iaKey("builtin although declared: ", par, ix, name))
    }
  } else if !iaNameFits(name, d) {
    iaMisresolved = iaMisresolved + 1
    let cls = "resolved elsewhere: "
    if iaDeclName(d).length == 0 {
      cls = "resolved to a non-declaration (" + iaKindOf(d) + "): "
    }
    iaCount(iaKey(cls, par, ix, name))
  }
  0
}

// Visit `ix` (child of `par`) and what it reaches once, keeping `iaScope` to the bindings in
// scope: a function's name and parameters, a loop's variables, and a block's declarations from
// the statement that makes them on.
function iaWalk(ix: i32, par: i32) {
  if ix < 0 || ix >= P.nodes.length || iaSeen[ix] { return 0 }
  iaSeen[ix] = true
  const n = P.nodes[ix]
  if n is Ident { return iaIdent(ix, par, n.identName) }
  const mark = iaScope.length
  if n is FuncDecl {
    if n.fnName.length > 0 { iaScope.push(n.fnName) }
    for pi in n.fnParams {
      const pn = P.nodes[pi]
      if pn is Param { iaScope.push(pn.parName) }
    }
  } else if n is ForRange {
    iaScope.push(n.frVar)
  } else if n is ForIn {
    iaScope.push(n.fiVar)
    if n.fiVar2.length > 0 { iaScope.push(n.fiVar2) }
  }
  if n is Block {
    for st in n.blkStmts {
      const sn = P.nodes[st]
      if sn is FuncDecl { iaScope.push(sn.fnName) }
      iaWalk(st, ix)
      if sn is LetDecl { iaScope.push(sn.letName) }
    }
  } else {
    for k in nodeChildren(ix) { iaWalk(k, ix) }
  }
  while iaScope.length > mark { iaScope.pop() }
  0
}

// Walk from the module's statements `stmts` and every function `fns` names, counting each
// reachable `Ident` once (`iaIdent`). A module binding is in scope everywhere.
export function identAuditRun(stmts: i32[], fns: i32[]) {
  if !iaArmed { return 0 }
  iaSeen = []
  while iaSeen.length < P.nodes.length { iaSeen.push(false) }
  iaScope = []
  for st in stmts {
    const sn = P.nodes[st]
    if sn is FuncDecl { iaScope.push(sn.fnName) }
    if sn is LetDecl { iaScope.push(sn.letName) }
  }
  for st in stmts { iaWalk(st, -1) }
  for f in fns { iaWalk(f, -1) }
  iaScope = []
  iaSeen = []
  0
}

// A row key: `<class><position> @ <minting pass>`, then the name when the arm asked for it.
function iaKey(cls: string, par: i32, ix: i32, name: string): string {
  let key = cls + iaPosition(par, ix) + " @ " + iaMinter(ix)
  if iaNamed { key = key + " '" + name + "'" }
  key
}

// The reachable identifiers the last armed compile left without a declaration.
export function identAuditUnresolved() { iaUnresolved }

// The reachable identifiers resolved to no node although a reachable declaration binds the name.
export function identAuditBuiltinDeclared() { iaBuiltinDeclared }

// The reachable identifiers resolved to a node that does not declare their name.
export function identAuditMisresolved() { iaMisresolved }

// The breakdown rows: `<position> @ <minting pass>` and how many identifiers it holds.
export function identAuditRowCount() { iaRowKey.length }

export function identAuditRowLen(i: i32) { iaRowKey[i].length }

export function identAuditRowAt(i: i32, j: i32) { iaRowKey[i][j] }

export function identAuditRowN(i: i32) { iaRowN[i] }
