// The record rows the collect passes decided, as text, for a test to read after a compile: one
// line per struct row (`row <i> <name> decl=<0|1> heap=<h> codes=<c,…>`) and one per union arm
// (`arm <i> <name> twin=<row|-1> heap=<h> codes=<c,…>`); `heap` is the wasm type index, -1 before it is assigned, then one per declared type name
// (`type <name> row=<row|-1> variant=<arm|-1> class=<key>`). An instrument only; no pass reads it. The
// up-front row pass is graded against these lines.
import { i32ToStr } from "./ast"
import { cUserTypes } from "./check_types"
import { structIndexByName } from "./emit_atom_kinds"
import { exactArmRowOfTy, variantIndexOf } from "./emit_local_slots"
import { recordRowClassOf } from "./record_rows"
import {
  armFieldTypes,
  sFieldCount,
  sFieldStart,
  sFieldTypes,
  sHeapIdx,
  sNames,
  sRowDecl,
  uFieldCount,
  uFieldStart,
  uVariants,
  variantHeap,
} from "./emit_state"
import { variantStructHeapTwinAt } from "./emit_shape_rows"

let rowDumpText = ""

// The codes of `n` fields of `codes` from `start`, comma-separated; "" past either table's end.
function rowDumpCodes(codes: i32[], start: i32, n: i32): string {
  let out = ""
  let k = 0
  while k < n {
    const ix = start + k
    if ix < 0 || ix >= codes.length { return out }
    if k > 0 { out = out + "," }
    out = out + i32ToStr(codes[ix])
    k = k + 1
  }
  out
}

// Row `si`'s wasm heap type index, or -1 before one is assigned.
function rowDumpHeapOf(si: i32): i32 {
  if si < 0 || si >= sHeapIdx.length { return -1 }
  sHeapIdx[si]
}

// Builds the dump from the tables the last compile left, and returns its length.
export function rowDumpBuild(): i32 {
  let out = ""
  let si = 0
  while (
    si < sNames.length
    && si < sFieldStart.length
    && si < sFieldCount.length
  ) {
    let decl = 0
    if si < sRowDecl.length { decl = sRowDecl[si] }
    out = out
      + "row "
      + i32ToStr(si)
      + " "
      + sNames[si]
      + " decl="
      + i32ToStr(decl)
      + " heap="
      + i32ToStr(rowDumpHeapOf(si))
      + " codes="
      + rowDumpCodes(sFieldTypes, sFieldStart[si], sFieldCount[si])
      + "\n"
    si = si + 1
  }
  const acodes = armFieldTypes()
  let vi = 0
  while (
    vi < uVariants.length
    && vi < uFieldStart.length
    && vi < uFieldCount.length
  ) {
    out = out
      + "arm "
      + i32ToStr(vi)
      + " "
      + uVariants[vi]
      + " twin="
      + i32ToStr(variantStructHeapTwinAt(vi))
      + " heap="
      + i32ToStr(variantHeap(vi))
      + " codes="
      + rowDumpCodes(acodes, uFieldStart[vi], uFieldCount[vi])
      + "\n"
    vi = vi + 1
  }
  for k in cUserTypes.keys() {
    out = out
      + "type "
      + k
      + " row="
      + i32ToStr(structIndexByName(k))
      + " variant="
      + i32ToStr(rowDumpVariantOf(k))
      + " class="
      + recordRowClassOf(cUserTypes[k] ?? -1)
      + "\n"
  }
  rowDumpText = out
  out.length
}

// The arm row declared type `k` is stored at: its own name's, else the arm whose type its checked
// type is (a record of an arm's type shares that arm's row).
function rowDumpVariantOf(k: string): i32 {
  const v = variantIndexOf(k)
  if v >= 0 { return v }
  exactArmRowOfTy(cUserTypes[k] ?? -1)
}

// The dump's length, and its `i`th code unit.
export function rowDumpLen(): i32 { rowDumpText.length }

export function rowDumpAt(i: i32): i32 {
  if i < 0 || i >= rowDumpText.length { return 0 }
  rowDumpText[i]
}
