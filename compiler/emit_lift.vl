// `emit_lift.vl` — lambda lifting of local functions that never escape (SP-037). A `const`
// bound to a lambda, or a block-local `function`, whose every use is a direct call in the
// frame that declares it (or, for a block-local function, in its own body) is called as a
// plain function taking its captures as parameters after the env: no closure value and no
// env struct is built. Anything this scan cannot prove keeps the closure path. A shared `let`
// whose every capturer lifts stays a local: a capturer that assigns it returns the new value
// after its own result, and each call site writes it back (D3664).

import {
  BinExpr,
  Call,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  LetDecl,
  Member,
  Node,
  OptMember,
  P,
  Param,
  Spread,
  hasNamedArgs,
  nodeChildren,
} from "./ast"
import { emitFail } from "./emit_bytes"
import { unwrapParen } from "./emit_base"
import { nodeTyIxOf, nodeTyReachesClosure, tySame } from "./typecheck"
import {
  cloLiftCapN,
  cloLiftFe,
  cloLiftFrame,
  cloLiftLet,
  cloLiftWrIdx,
  cloLiftWrN,
  cloLiftWrName,
  cloLiftWrStart,
  cloUnboxNeed,
  cloUnboxWrFn,
  cloUnboxWrName,
  fnInstOrigin,
  fnParent,
  fnStmts,
  fnValUsed,
  lfBlockOf,
  lfCloneHead,
  lfOriginOf,
} from "./emit_state"
import {
  captureNamesOf,
  fnHasUnannotatedParam,
  fnStmtsPosOf,
} from "./emit_classify"

// Where the walk stands: the declaring frame's own code, the candidate's own body, or any
// other nested function (where a use is a capture, so an escape).
const CL_HOST = 0
const CL_SELF = 1
const CL_NESTED = 2

let clName = ""
let clSelf = -1
let clLet = -1
let clIsLocalFn = false
let clOk = true
let clCaps: string[] = []
let clCapDecls: i32[] = []
// The owning frame of each candidate declaration, and the declarations two frames reach: a
// callback specialization or a clone shares its host's statements (D3713).
let clOwner: {[i32]: i32} = Map()
let clShared: {[i32]: boolean} = Map()

// Decide every lifted slot. Runs once the arena is final, before any functype is written.
export function cloLiftScan() {
  cloLiftCapN = []
  cloLiftFrame = []
  cloLiftLet = []
  cloLiftFe = []
  clOwner = Map()
  clShared = Map()
  cloLiftWrStart = []
  cloLiftWrN = []
  cloLiftWrIdx = []
  cloLiftWrName = []
  let pp = 0
  while fnValUsed && pp < fnStmts.length {
    const d = P.nodes[fnStmts[pp]]
    if d is FuncDecl { clNoteWalk(d.fnBody, pp) }
    pp = pp + 1
  }
  let fe = 0
  while fe < fnStmts.length {
    let n = -1
    if fnValUsed { n = cloLiftDecide(fe) }
    cloLiftCapN.push(n)
    if clWritesRow(fe) < 0 { return -1 }
    fe = fe + 1
  }
  cloUnboxCheck()
}

// Refuses when a capturer of a binding `captureBoxRewrite` left unboxed is not lifted: that
// judgement reads only the syntax tree, and a closure value would copy what it assigns.
function cloUnboxCheck() {
  let ni = 0
  while ni < cloUnboxNeed.length {
    if !cloLifted(fnStmtsPosOf(cloUnboxNeed[ni])) {
      return emitFail(
        "emitProgram: a function sharing a captured `let` as a plain local was not lambda-lifted (D3664)",
      )
    }
    ni = ni + 1
  }
  0
}

// Appends slot `fe`'s row of the write-back tables: the captures it assigns, if lifted.
function clWritesRow(fe: i32) {
  cloLiftWrStart.push(cloLiftWrIdx.length)
  let n = 0
  if cloUnboxWrFn.length > 0 && cloLifted(fe) {
    const caps = captureNamesOf(fe)
    let wi = 0
    while wi < cloUnboxWrFn.length {
      if cloUnboxWrFn[wi] == fnStmts[fe] {
        let ci = 0
        while ci < caps.length && caps[ci] != cloUnboxWrName[wi] { ci = ci + 1 }
        if ci >= caps.length {
          return emitFail(
            "emitProgram: a lambda-lifted function assigns a capture it does not take (D3664)",
          )
        }
        cloLiftWrIdx.push(ci)
        cloLiftWrName.push(cloUnboxWrName[wi])
        n = n + 1
      }
      wi = wi + 1
    }
  }
  cloLiftWrN.push(n)
  0
}

// ── keeping a captured `let` off the heap (D3664) ────────────────────────────────────────
// When every function capturing a shared `let` is lifted, each call passes the value in and
// takes back what the callee assigned, so the binding needs no cell. `captureBoxRewrite` asks
// before `cloLiftScan` runs: the answer reads the syntax tree, in frames no later pass clones.

let cuName = ""
let cuTy = -1
let cuOk = true
let cuCur = -1
let cuFns: i32[] = []
let cuCallees: string[] = []

// The names among `cands` (bindings of frame `fe` a closure must share, typed `candTys`) that
// can stay plain locals. Records the capturers `cloLiftScan` must lift and what each assigns.
export function cloUnboxPick(
  fe: i32,
  cands: string[],
  candTys: i32[],
): string[] {
  const out: string[] = []
  if !fnValUsed || cands.length == 0 || !cuChainOk(fe) { return out }
  const host = P.nodes[fnStmts[fe]]
  if !(host is FuncDecl) { return out }
  let ci = 0
  while ci < cands.length {
    cuTy = candTys[ci]
    if cuPickOne(fe, host.fnBody, cands[ci]) { out.push(cands[ci]) }
    ci = ci + 1
  }
  out
}

// Whether binding `nm` of frame `fe`, whose body is `body`, can stay a plain local.
function cuPickOne(fe: i32, body: i32, nm: string): boolean {
  cuName = nm
  cuOk = true
  cuCur = -1
  cuFns = []
  cuScan(body, 0)
  if !cuOk || cuFns.length == 0 { return false }
  cuCallees = []
  let fi = 0
  while fi < cuFns.length {
    const dfe = fnStmtsPosOf(cuFns[fi])
    if dfe < 0 || dfe >= fnParent.length || fnParent[dfe] != fe { return false }
    if !cuChainOk(dfe) { return false }
    if clChainIsGeneric(dfe) || clSyntax(dfe) < 0 { return false }
    cuCallees.push(clName)
    fi = fi + 1
  }
  cuArgsScan(body)
  if !cuOk { return false }
  fi = 0
  while fi < cuFns.length {
    cloUnboxNeed.push(cuFns[fi])
    const d = P.nodes[cuFns[fi]]
    if d is FuncDecl {
      if cuAssigns(d.fnBody) {
        cloUnboxWrFn.push(cuFns[fi])
        cloUnboxWrName.push(nm)
      }
    }
    fi = fi + 1
  }
  true
}

// No frame from `fe` outward has type parameters, an un-annotated parameter or a parameter
// whose type reaches a function, so none is monomorphized or specialised after this pass.
function cuChainOk(fe: i32): boolean {
  let pp = fe
  let steps = 0
  while pp >= 0 && steps <= fnStmts.length {
    const d = P.nodes[fnStmts[pp]]
    if !(d is FuncDecl) { return false }
    if d.fnTyParams.length > 0 || fnHasUnannotatedParam(pp) { return false }
    let pi = 0
    while pi < d.fnParams.length {
      const p = P.nodes[d.fnParams[pi]]
      if p is Param {
        if p.parType >= 0 && nodeTyReachesClosure(p.parType) { return false }
      }
      pi = pi + 1
    }
    if pp >= fnParent.length { return false }
    pp = fnParent[pp]
    steps = steps + 1
  }
  true
}

// Collects in `cuFns` the functions nested directly in the frame that name `cuName`. A use
// further in, any binding of the name inside a nested function, or an assignment whose value
// is typed apart from the binding (a cell yields the value, a local re-reads it, D3733) refuses.
function cuScan(ix: i32, depth: i32) {
  if !cuOk || ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  if cuIsAssign(n) && !tySame(nodeTyIxOf(ix), cuTy) { cuOk = false }
  if n is Ident {
    if n.identName == cuName {
      if depth == 1 {
        if cuFns.length == 0 || cuFns[cuFns.length - 1] != cuCur {
          cuFns.push(cuCur)
        }
      }
      if depth > 1 { cuOk = false }
    }
    return 0
  }
  if depth > 0 {
    if n is LetDecl {
      if n.letName == cuName { cuOk = false }
    }
    if n is Param {
      if n.parName == cuName { cuOk = false }
    }
    if n is ForRange {
      if n.frVar == cuName { cuOk = false }
    }
    if n is ForIn {
      if n.fiVar == cuName || n.fiVar2 == cuName { cuOk = false }
    }
  }
  let inner = depth
  if n is FuncDecl {
    if depth > 0 && n.fnName == cuName { cuOk = false }
    inner = depth + 1
    if depth == 0 { cuCur = ix }
  }
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    cuScan(kids[k], inner)
    k = k + 1
  }
  0
}

// Refuses when an argument of a call to a capturer could change `cuName`: a call to a
// capturer, an assignment to the name, or a spread. A capturer reads the value before its
// arguments run, and a cell is read after them.
function cuArgsScan(ix: i32) {
  if !cuOk || ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  if n is Call {
    if cuIsCapturerCall(n) {
      let ai = 0
      while ai < n.callArgs.length {
        if cuArgDirty(n.callArgs[ai]) { cuOk = false }
        ai = ai + 1
      }
    }
  }
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    cuArgsScan(kids[k])
    k = k + 1
  }
  0
}

function cuIsCapturerCall(n: Call): boolean {
  const callee = P.nodes[n.callFn]
  if callee is Ident {
    let i = 0
    while i < cuCallees.length {
      if cuCallees[i] == callee.identName { return true }
      i = i + 1
    }
  }
  false
}

// Whether the argument at `ix` could change `cuName` or names a capturer at all.
function cuArgDirty(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = P.nodes[ix]
  if n is Spread { return true }
  if n is Call {
    if cuIsCapturerCall(n) { return true }
  }
  if cuIsAssign(n) { return true }
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    if cuArgDirty(kids[k]) { return true }
    k = k + 1
  }
  false
}

// Whether the body at `ix` assigns `cuName`.
function cuAssigns(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  if cuIsAssign(P.nodes[ix]) { return true }
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    if cuAssigns(kids[k]) { return true }
    k = k + 1
  }
  false
}

function cuIsAssign(n: Node): boolean {
  if n is BinExpr {
    if n.binOp == "=" {
      const l = P.nodes[unwrapParen(n.binLeft)]
      if l is Ident { return l.identName == cuName }
    }
  }
  false
}

// Notes the lambda `const`s frame `pp`'s own code declares. A nested function is neither
// noted nor entered: its lift is keyed by its own slot, so a shared one lifts correctly.
function clNoteWalk(ix: i32, pp: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  if n is FuncDecl { return 0 }
  if n is LetDecl {
    if n.letInit >= 0 {
      if P.nodes[unwrapParen(n.letInit)] is FuncDecl { clNoteOwner(ix, pp) }
    }
  }
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    clNoteWalk(kids[k], pp)
    k = k + 1
  }
  0
}

function clNoteOwner(ix: i32, pp: i32) {
  const was = clOwner.get(ix) ?? -1
  if was < 0 { clOwner.set(ix, pp) }
  else if was != pp { clShared.set(ix, true) }
  0
}

// True when the frame chain from `pos` up holds a generic or monomorphized frame, whose body
// is shared between pins: lifting is decided per slot, so those keep the closure path.
function clChainIsGeneric(pos: i32): boolean {
  let pp = pos
  let steps = 0
  while pp >= 0 && steps <= fnStmts.length {
    if pp < fnInstOrigin.length && fnInstOrigin[pp] >= 0 { return true }
    if lfOriginOf(pp) >= 0 { return true }
    if pp < lfCloneHead.length && lfCloneHead[pp] >= 0 { return true }
    const d = P.nodes[fnStmts[pp]]
    if d is FuncDecl {
      if d.fnTyParams.length > 0 { return true }
    }
    if pp >= fnParent.length { return true }
    pp = fnParent[pp]
    steps = steps + 1
  }
  false
}

// The capture count when slot `fe` can be lifted, else -1.
function cloLiftDecide(fe: i32): i32 {
  if fe >= fnParent.length { return -1 }
  if fnParent[fe] < 0 { return -1 }
  if fnHasUnannotatedParam(fe) { return -1 }
  if clChainIsGeneric(fe) { return -1 }
  const n = clSyntax(fe)
  if n < 0 { return -1 }
  // A declaration another frame also emits would be lifted in one frame and built as a
  // value in the other, so it keeps the closure path.
  if clShared.has(fnStmts[fe]) || (clLet >= 0 && clShared.has(clLet)) {
    return -1
  }
  if clLet >= 0 {
    cloLiftFrame.push(fnParent[fe])
    cloLiftLet.push(clLet)
    cloLiftFe.push(fe)
  }
  n
}

// The capture count when every use of slot `fe` in its declaring frame is a direct call,
// else -1; sets `clLet` to the `const` binding it, if any. Reads only the syntax tree.
function clSyntax(fe: i32): i32 {
  const host = fnParent[fe]
  const self = fnStmts[fe]
  const hostNode = P.nodes[fnStmts[host]]
  if !(hostNode is FuncDecl) { return -1 }
  clName = ""
  clSelf = self
  clLet = -1
  clIsLocalFn = false
  const selfNode = P.nodes[self]
  if lfBlockOf(fe) >= 0 {
    if selfNode is FuncDecl {
      clName = selfNode.fnName
      clIsLocalFn = true
    }
  } else {
    clFindBinding(hostNode.fnBody)
  }
  if clName == "" { return -1 }
  clCaps = captureNamesOf(fe)
  clCapDecls = []
  let ci = 0
  while ci < clCaps.length {
    if clCaps[ci] == clName { return -1 }
    clCapDecls.push(0)
    ci = ci + 1
  }
  clOk = true
  const hps = hostNode.fnParams
  let pi = 0
  while pi < hps.length {
    clWalk(hps[pi], CL_HOST)
    pi = pi + 1
  }
  clWalk(hostNode.fnBody, CL_HOST)
  if !clOk { return -1 }
  ci = 0
  while ci < clCapDecls.length {
    if clCapDecls[ci] > 1 { return -1 }
    ci = ci + 1
  }
  clCaps.length
}

// Finds the `const` in the host body whose initializer is the lambda `clSelf`. Nested
// frames are not searched, since a binding there belongs to that frame.
function clFindBinding(ix: i32) {
  if ix < 0 || ix >= P.nodes.length || clName != "" { return 0 }
  const n = P.nodes[ix]
  if n is LetDecl {
    if (
      n.letKw == "const"
      && n.letInit >= 0
      && unwrapParen(n.letInit) == clSelf
    ) {
      clName = n.letName
      clLet = ix
      return 0
    }
  }
  if n is FuncDecl { return 0 }
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    clFindBinding(kids[k])
    k = k + 1
  }
  0
}

// Counts a declaration of `nm`: another binding of the candidate's name refuses, and a
// capture's name declared twice refuses, since a call site reads captures by name.
function clNoteDecl(nm: string, ix: i32) {
  if nm == clName && ix != clLet && ix != clSelf { clOk = false }
  let ci = 0
  while ci < clCaps.length {
    if clCaps[ci] == nm { clCapDecls[ci] = clCapDecls[ci] + 1 }
    ci = ci + 1
  }
  0
}

// Walks `ix`, refusing on any use of the candidate's name that is not the callee of a call
// in the host frame (or in its own body, for a block-local function).
function clWalk(ix: i32, where: i32) {
  if !clOk || ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  if n is Ident {
    if n.identName == clName { clOk = false }
    return 0
  }
  if n is Call {
    const callee = P.nodes[n.callFn]
    if callee is Ident {
      if callee.identName == clName {
        if where == CL_NESTED { clOk = false }
        if where == CL_SELF && !clIsLocalFn { clOk = false }
        if hasNamedArgs(n.callArgNames) && !clIsLocalFn { clOk = false }
        let ai = 0
        while ai < n.callArgs.length {
          clWalk(n.callArgs[ai], where)
          ai = ai + 1
        }
        return 0
      }
    }
  }
  if n is Member {
    if n.memProp == clName { clOk = false }
  }
  if n is OptMember {
    if n.omProp == clName { clOk = false }
  }
  if n is LetDecl { clNoteDecl(n.letName, ix) }
  if n is Param { clNoteDecl(n.parName, ix) }
  if n is ForRange { clNoteDecl(n.frVar, ix) }
  if n is ForIn {
    clNoteDecl(n.fiVar, ix)
    if n.fiVar2 != "" { clNoteDecl(n.fiVar2, ix) }
  }
  let inner = where
  if n is FuncDecl {
    clNoteDecl(n.fnName, ix)
    if ix == clSelf { inner = CL_SELF } else { inner = CL_NESTED }
  }
  const kids = nodeChildren(ix)
  let k = 0
  while k < kids.length {
    clWalk(kids[k], inner)
    k = k + 1
  }
  0
}

// The lifted slot the `const` binding at `letIx` in frame position `pos` stands for, or -1.
export function cloLiftLetFe(pos: i32, letIx: i32): i32 {
  let i = 0
  while i < cloLiftLet.length {
    if cloLiftLet[i] == letIx && cloLiftFrame[i] == pos { return cloLiftFe[i] }
    i = i + 1
  }
  -1
}

// Whether slot `fe` is lambda-lifted.
export function cloLifted(fe: i32): boolean {
  fe >= 0 && fe < cloLiftCapN.length && cloLiftCapN[fe] >= 0
}
