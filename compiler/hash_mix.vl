// Key mixing for the compiler's own open-addressed tables, which mask a key to a power of
// two. Ids are minted in order, so a key that is not mixed places a run of them in one
// contiguous cluster that every linear probe landing in it walks (D7460).

// `k` with every input bit spread over every output bit (murmur3's 32-bit finaliser). A
// bijection, so two keys collide in a masked table only when their low bits do after mixing.
export function hashMix(k0: i32): i32 {
  let k = k0 ^ (k0 >>> 16)
  k = k * -2048144789
  k = k ^ (k >>> 13)
  k = k * -1028477387
  k ^ (k >>> 16)
}
