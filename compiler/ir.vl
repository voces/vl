// The typed mid-level IR (docs/internals/ir-design-2026-11.md §1): structured control, operands
// in ANF, mutable locals rather than SSA. One `IrFn` holds one function's arena, so it can be
// built, verified and printed in isolation. Ids are i32 indices into that arena; a rep is an
// `emit_rep.vl` tree node (`repNodeOfTy`), valid only within the rebuild epoch that produced it,
// and a type a checker arena index. Conversions arrive as one coercion node with `coercionAt`
// (step I3).
import { i32ListHas } from "./listutil"
import { i32ToStr } from "./ast"
import { RefJoin } from "./emit_plan_if_join"
import {
  recordHeapOfTy,
  recordHeapSubOf,
  structRowHeap,
} from "./emit_shape_intern"
import { CoalValArm } from "./emit_plan_null"
import { ArrLitArm } from "./emit_plan_list"
import { HoleBox, LitIsArm } from "./emit_plan_union"
import { VKind } from "./emit_state"
import {
  RAtom,
  RBox,
  RClosure,
  RList,
  RMap,
  RNoValue,
  RNullable,
  RPrim,
  RRaw,
  RRecord,
  RUnsup,
  RpPrim,
  askRecordHeap,
  repNodeAt,
  repNodeKids,
  repRecordFieldNames,
  repRecordKidOf,
  repTyOf,
} from "./emit_rep"

// An operand: a variable, an immediate of a primitive rep, or an interned string.
export type OVar = { ov: i32 }
export type OImm = { oiRep: i32, oiBits: i64 }
// `osAt`: the string literal's node, which legacy's literal arm writes at `osRep`, a string or
// the destination's atom.
export type OStr = { osAt: i32, osRep: i32 }
export type Opnd = OVar | OImm | OStr

// The primitive operations, per `PrimRep`; the verifier gives each its operand signature.
// Signedness lives on the op: `u32`/`u64` share i32's and i64's reps, so the unsigned forms
// (`divu` … `geu`, `shru`) are chosen from the operand's type.
export type PrimOp = "add" | "sub" | "mul" | "div" | "divu" | "rem" | "remu" | "and" | "or"
  | "xor" | "shl" | "shr" | "shru" | "eq" | "ne" | "lt" | "ltu" | "le" | "leu" | "gt" | "gtu"
  | "ge" | "geu" | "neg" | "not"
export type MapOp = "has" | "set" | "delete" | "keys" | "size"
// `site` joins an append site's chain into its buffer, `soAt` the assignment; `acc` appends
// the parts after a proven accumulator to it, as a statement. `bytes` copies into a fresh `u8[]`.
// `fromcp` builds a string from one i32 code point, `fromcps` from a local i32 list it reads twice.
// `indexof` and `includes` search the receiver for a string needle; `charcode` reads one unit.
export type StrOp = "concat"
  | "site"
  | "acc"
  | "len"
  | "at"
  | "slice"
  | "eq"
  | "lt"
  | "cplen"
  | "fromcp"
  | "fromcps"
  | "frombytes"
  | "indexof"
  | "includes"
  | "charcode"
  | "cpat"
  | "charbound"
  | "bytes"
export type CastFail = "trap" | "null"

// The right-hand side of an `SLet`; the result rep is its destination's.
export type RPrimOp = { poOp: PrimOp, poArgs: Opnd[] }
// `caNever`: the callee never returns, so the call is followed by `unreachable` (`callEndsNever`).
// `caEnv`: the callee takes a hidden environment parameter, passed null before the arguments;
// `caCaps`: a lifted callee's captures, passed after it; `caWb`: the variables the captures it
// assigns go back to after the call, in its result order, the last set first (D3664).
export type RCall = {
  caCallee: i32,
  caArgs: Opnd[],
  caNever: boolean,
  caEnv: boolean,
  caCaps: Opnd[],
  caWb: i32[],
}
// `crSig`: the `$fnsig` type index; `crVoid`: the key returns nothing; `crDrop`: a call statement
// drops its result, as legacy decides (`callRefPlainVoid`); `crNever`: the callee never returns,
// so the call is followed by `unreachable` and has no tail form (`callEndsNever`).
// `crHead`: `crFn` is an `RCallRefHead` temp, which wrote the callee, its stash and env already.
export type RCallRef = {
  crFn: Opnd,
  crSig: i32,
  crArgs: Opnd[],
  crVoid: boolean,
  crDrop: boolean,
  crNever: boolean,
  crHead: boolean,
}
// Closure `chFn`'s call head (`callRefStash`, `callRefEnvOpen`), staged ahead of an argument that
// writes a statement, as legacy writes the head before its arguments. Read once, by its `RCallRef`.
export type RCallRefHead = { chFn: Opnd }
// A host call (`hostCallPlanOf`): its arguments at the plan's widths, then a `call` of import
// `chImport`, which leaves nothing when `chVoid`, and `unreachable` after it when `chNever`.
export type RCallHost = {
  chImport: i32,
  chArgs: Opnd[],
  chVoid: boolean,
  chNever: boolean,
}
// `teTag`: the tag a box test compares, a variant row's (`isVariantTagPlain`) or an arm's
// (`isArmTagOf`).
export type RTest = { teV: Opnd, teTag: i32 }
// Box variable `vdV` at arm `vdVi`'s tag, then, when it holds, each discriminant field's literal
// set at `is` test `vdAt`, the variable read once per literal (`emitVariantDiscrimTest`): a bool.
export type RVariantDiscrim = { vdV: Opnd, vdVi: i32, vdAt: i32 }
// Box variable `vcV` at arm `vcVi`'s full variant chain at `is` test `vcAt`: legacy's tail
// (`variantRowChainTail`) with each receiver read the variable (`fitRecvReadHook`): a bool.
export type RVariantChain = { vcV: Opnd, vcVi: i32, vcAt: i32 }
// Record variable `rfV` at `is` test `rfAt` along `recordFitPlanOf`: legacy's `emitRecordFitIs`,
// each field test reading the variable (`fitRecvReadHook`): a bool.
export type RRecordFitIs = { rfV: Opnd, rfAt: i32 }
// A field read off a box local narrowed to one variant (`narrowedFieldPlain`); `bfAt` its member.
export type RBoxField = { bfV: Opnd, bfAt: i32 }
// A shared field read `srAt` over un-narrowed box `srV`, dispatched on its tag per member (legacy's
// `emitMemSharedRead`): a box local read twice an arm, module global `srGlobal` (not -1, `srV`
// unread) read the same way, or with `srStash` a receiver read once into legacy's stash slot.
export type RSharedRead = {
  srV: Opnd,
  srAt: i32,
  srStash: boolean,
  srGlobal: i32,
  srGlobalNonNull: boolean,
}
// A field write `shAt` through an un-narrowed union of records (legacy's `emitSharedFieldAssign`):
// receiver box `shR` staged once (`shStash`), else a box local read per arm, or module global
// `shGlobal` (`shR` unread) read per arm; then the value, one operand staged once or one per arm.
export type RSharedFieldSet = {
  shR: Opnd,
  shStash: boolean,
  shGlobal: i32,
  shGlobalNonNull: boolean,
  shVs: Opnd[],
  shAt: i32,
}
// A box local read at the variant its narrowing names (`narrowedBoxVariantPlain`), whose record is
// `bnRep`, the destination's; or, with `bnAtom` an atom kind (`identUnboxAtomOf`), read unboxed to
// that atom, -1 otherwise. `bnAt` the read.
export type RBoxNarrow = {
  bnV: Opnd,
  bnAt: i32,
  bnRep: i32,
  bnAtom: i32,
  bnCon: i32,
}
// A box unboxed at a record destination as `emitArmUnboxCast` writes it, cast as `armUnboxRoute` says.
// `uaAt` is the read; `uaDst` (else -1) the record a union of records or an assignment's box (`uaAsg`)
// lands at; `uaCellNul` a binding whose cell is a nullable arm, which legacy casts to as a nullable
// ref whatever the value's own nullability (`emitLetDelivery`).
export type RArmUnbox = {
  uaV: Opnd,
  uaAt: i32,
  uaCellNul: boolean,
  uaDst: i32,
  uaAsg: boolean,
}

// How `RArmUnbox` `r` is cast: an assignment's box at its destination's heap ("asg"), a union of
// records at `uaDst`'s heap ("recordArms"), else a narrowed read at its arm record's ("arm").
export type ArmUnboxRoute = "asg" | "recordArms" | "arm"
export function armUnboxRoute(r: RArmUnbox): ArmUnboxRoute {
  if r.uaAsg { return "asg" }
  return if r.uaDst >= 0 { "recordArms" } else { "arm" }
}
// A box local read at its storage as the niche (`nicheReadKindAt`, kind `nrKind`) its narrowing
// names, `nrAt` the read: the null tag is the niche's null, any other arm its payload. `nrRow`: an
// element read banks one row over the box read and the tail, not the box read's own.
export type RNicheRead = { nrV: Opnd, nrAt: i32, nrKind: i32, nrRow: boolean }
// A nullable local read at its inner rep, `rcAt` the read; `rcNn` is how many `ref.as_non_null`
// legacy writes after it, decided where the read is built (an assignment's re-read context).
export type RRecover = { rcV: Opnd, rcAt: i32, rcNn: i32 }
// The union-operand cast `auAt` over box `auV`, by legacy's tag test and tail
// (`emitAsUnionTagged`): the target arm unboxed, the box at a sub-union, `null` on `as?`'s miss.
export type RAsUnion = { auV: Opnd, auAt: i32 }
// The literal-union cast `akAt` over operand `akV`, by legacy's staged member test and tail
// (`asLitAtomTail`, `asNumLitScalarTail`): the hit, and by mode the trap, return or `as?` null.
export type RAsTail = { akV: Opnd, akAt: i32 }
// Value `aeV` of node `aeAt` after operands `aeEff`, each written for its effect and dropped where
// the value is read, as legacy writes a `??` whose left is typed `null` (`emitNulNoneForEffect`).
export type RAfterEffects = { aeEff: Opnd[], aeV: Opnd, aeAt: i32 }
// A record copy at node `rpAt` of a source legacy re-reads per field (`recCopyReReads`), written
// whole by legacy's copy (`recCopyPureEmit`), which reads the source as `rpV` (read once where
// `rpOnce`, else a read the IR writes again). Retired at I8 with `RMapNew`.
export type RRecCopyPure = { rpAt: i32, rpV: Opnd[], rpOnce: boolean }
export type RCast = { ctV: Opnd, ctTarget: i32, ctOnFail: CastFail }
export type RTagOf = { tgV: Opnd }
// `mrFields` in kid order; `mrLayout[i]` the kid layout position `i` writes; `mrSrc` the kids in
// stash source order, else empty; `mrSet` where `RStashSet`s set them (`mrFields` then empty).
// `mrAt` the literal, at its own row or, where `mrRow` is not -1, its destination's; `mrVariant`
// whether that row is a variant's; `mrBuiltRow` the row the builder built the fields by.
export type RMakeRec = {
  mrFields: Opnd[],
  mrLayout: i32[],
  mrSrc: i32[],
  mrAt: i32,
  mrRow: i32,
  mrVariant: boolean,
  mrBuiltRow: i32,
  mrSet: boolean,
}
// One field of an order-stashed record literal (`mrSet`), set in source order into the slot
// legacy's stash opens for layout position `ssFi` (kid `ssK`) of the literal at `ssAt`, built at
// `ssRow` (a variant's where `ssVariant`); its `RMakeRec` reads the slots back.
export type RStashSet = {
  ssV: Opnd,
  ssAt: i32,
  ssRow: i32,
  ssVariant: boolean,
  ssFi: i32,
  ssK: i32,
}
// A field read at node `gfAt`, kid `gfIx` of `gfV`'s record; `gfStored` where the builder built it
// at its storage (an `is` receiver's), so it is lowered under the same mark; `gfStr` where a
// union-box field's unbox leaves the string a literal-union member is boxed as; `gfShared` where
// `gfAt` is a generic's shared template node no instance typed, read at the field's own storage.
export type RGetField = {
  gfV: Opnd,
  gfIx: i32,
  gfAt: i32,
  gfStored: boolean,
  gfStr: boolean,
  gfShared: boolean,
}
// A list literal at node `mlAt` of elements `mlElems`, built under the list build (`mlKind`,
// `mlSlot`) its delivery threaded, by legacy's short tail at the arm the builder asked (`mlArm`).
export type RMakeList = {
  mlElems: Opnd[],
  mlKind: i32,
  mlSlot: i32,
  mlAt: i32,
  mlArm: ArrLitArm,
}
// A spread literal at node `spAt`: each item group's list in source order (`spSrcs`, a spread's
// source or a run of plain elements as legacy's run literal `spGroups` names), built under the list
// build (`spKind`, `spSlot`) its delivery threaded, along the spread tails legacy's own arm writes.
export type RSpread = {
  spSrcs: Opnd[],
  spGroups: i32[],
  spKind: i32,
  spSlot: i32,
  spAt: i32,
  // The union-box row legacy's boxing arm builds at (`emitArrSpreadBoxed`), else -1.
  spBoxRow: i32,
  // The groups each a list at its own rep: one the plan converts to the literal's element kind
  // (`spreadGroupStash`), or one at its own sub row, whose element the row's is a supertype of.
  spOwn: i32[],
}
// `__array_new__(lnLen, lnFill)` at call node `lnAt`, written by legacy's stash and tail.
export type RListNew = { lnLen: Opnd, lnFill: Opnd, lnAt: i32 }
// `__array_new_default__(ldLen)` at call node `ldAt`: the zeroed list legacy's default tail writes.
export type RListNewDefault = { ldLen: Opnd, ldAt: i32 }
// `__array_copy__(dst, dstAt, src, srcAt, count)` at call node `lcAt`, over its five operands.
export type RListCopy = { lcArgs: Opnd[], lcAt: i32 }
// A linear-memory load or store intrinsic at call node `mmAt` over its address and, for a store,
// its value: `mmBase` operands (1 a load, 2 a store) at width prim `mmPrim`, as the builder planned.
// `mmName` is the intrinsic it writes: the call's own, or a zero-extending fold's `_i64` load.
export type RMemAccess = {
  mmArgs: Opnd[],
  mmAt: i32,
  mmBase: i32,
  mmPrim: string,
  mmName: string,
}
// A declaration-time address fold's initializer (`emitMemConstFoldLet`): bounded part `mfiV`, kept
// in wasm local `mfiSlot` by a tee, plus constant `mfiK`, the binding's own value.
export type RMaFoldInit = { mfiV: Opnd, mfiSlot: i32, mfiK: i64 }
// An atomic intrinsic at call node `amAt` over its address and value operands, as the builder
// planned it: `amBase` operands (0 a fence), operand `k >= 1` at prim `amValPrims[k]`, and a
// result at `amResPrim` ("" for none).
export type RAtomic = {
  amArgs: Opnd[],
  amAt: i32,
  amBase: i32,
  amValPrims: string[],
  amResPrim: string,
}
// A scalar saturating truncation at call node `tsAt` of float operand `tsV`: instruction `tsOp`
// from float prim `tsFrom` to integer prim `tsTo`, as the builder planned it.
export type RTruncSat = {
  tsV: Opnd,
  tsAt: i32,
  tsOp: i32,
  tsFrom: string,
  tsTo: string,
}
// A memory-management intrinsic at call node `moAt` over its i32 operands (`memOpPlanOf`).
export type RMemOp = { moArgs: Opnd[], moAt: i32 }
// `lgAt`: the read's `Index` node, which legacy's hoist and range-proof decisions key on;
// `lgStored` where the builder built it at its storage (`isStorageRead`). `lgAgain`: the read as
// `irHoistRecv` writes it once more, a temp operand read again, not taken.
export type RListGet = {
  lgV: Opnd,
  lgIx: Opnd,
  lgAt: i32,
  lgStored: boolean,
  lgAgain: boolean,
}
// `llAt`: the `.length` `Member` node, which legacy's hoist and view decisions key on.
export type RListLen = { llV: Opnd, llAt: i32 }
// `nwV`, of number kind `nwSrc`, widened to kind `nwDst` at delivery node `nwAt` (kinds as
// `widenPlanOf` names them: 1 i32, 3 i64, 4 f64, 5 f32). A narrowing is exact: a shift-mask fold's
// wrap, or a literal set's member read out of a wider list arm (`numNarrowTail`).
export type RNumWiden = { nwV: Opnd, nwSrc: i32, nwDst: i32, nwAt: i32 }
// A standalone `?.` at node `orAt` over the chain base `orV`, read twice: its null test and leaf
// head, then the base as non-null and the leaf's tail, as `emitOptMemberValueGo` writes them.
// With `orTag` at least 0, `orAt` is an `is` over `x?.f`, a record's box field, which legacy's
// `optField` arm writes as that null test, then the field's tag compared with `orTag`.
export type ROptRead = { orV: Opnd, orAt: i32, orTag: i32 }
// An assignment's value at node `uwAt` re-read from its wider cell `uwV` and narrowed back by the
// one opcode `uwOp` legacy's `asgReadUnwidenOp` names: an integer wrap or truncation, an `f32`
// demotion, or `ref.as_non_null` of a reference held in its own nullable niche.
export type RAsgUnwiden = { uwV: Opnd, uwOp: i32, uwAt: i32 }
// An assignment `apAt` as a value its store parked (`asgValueArmOf` "parked"): the element store's,
// field store's or map set's parked slot read back and recovered, as `emitAsgValueOf` reads it.
export type RAsgParked = { apAt: i32 }
// Record `rdV`, an assignment `rdAt`'s re-read, cast to the wider row its right side extends
// (`asgNameWiderRow`), as `emitAsgValueOf`'s `widerRow` arm writes it (D16105).
export type RRecDown = { rdV: Opnd, rdAt: i32 }
// A numeric `as` at cast node `ncAt` over operand `ncV`, built at the kind `numCastKindOf`
// names; legacy's `numCastTail` writes the conversion, and an `as!`'s test and trap.
// A numeric `as` at node `ncAt` over `ncV`; a bare exact `as`'s miss returns `ncMiss`, the
// function's own null (`ov` -1 where it has none).
export type RNumCast = { ncV: Opnd, ncAt: i32, ncMiss: Opnd }
// `bxV` boxed into union `bxTy`, which delivery node `bxAt` delivers into: the one the checker
// records there, or a direct call's parameter union where it records none; `bxFree` whether
// `bxAt` has no effect left to write (an assignment's store is its span), so an immediate may
// stand for it; `bxPlan` the box plan the builder chose, which the lowering writes.
export type RToBox = {
  bxV: Opnd,
  bxAt: i32,
  bxTy: i32,
  bxFree: boolean,
  bxPlan: HoleBox,
}
// `u as? N` over a type parameter boxing scalar `hxV` at cast node `hxAt` (`holeOptShapeOf`'s
// "box"), whose tag legacy writes ahead of the operand (`holeOptBoxHead`, `holeOptBoxTail`).
export type RHoleOptBox = { hxV: Opnd, hxAt: i32 }
// The value of node `dnAt`, which a dead arm's `never` read feeds (`exprReadsDeadNever`) or a call
// reaching no function (`callCalleeDead`): legacy writes `unreachable` in its place, a second where
// `dnPad` (a call typed `never`, `callEndsNever`), and its consumer's code goes on (D16006).
export type RDeadNever = { dnAt: i32, dnPad: boolean }
// Atom `rgV` as the `K | null` (discipline 3) that holds it: the same i32, so no bytes.
export type RRetag = { rgV: Opnd }
// Atom `sxV`, or its `K | null`, as the string, or `string | null`, legacy's atom decode writes
// for delivery node `sxAt` (`emitAtomToStr`).
export type RAtomStr = { sxV: Opnd, sxAt: i32 }
// The `null` legacy builds where node `nuAt` is delivered: the null `nuOwn` names (`nullOwnAt`),
// a `K | null` sentinel or a `string | null`'s typed null. `nuRead`, when given, is a null-unit
// place read written for its effect and dropped first, where the null is read.
export type RNullOf = { nuAt: i32, nuOwn: i32, nuRead: Opnd[] }
// Struct row `fnRow`'s field `fnFi`'s null, for a field an object literal omits or sets to a typed
// `null`, as legacy's `emitOmittedFieldNull` writes it.
export type RFieldNull = { fnRow: i32, fnFi: i32 }
// The function's own `null` at its nullable return rep (`nullRetPlanOf`), as legacy pads a returned
// value `if` with it at `rnrAt` (`emitNullForRet`).
export type RRetNull = { rnrAt: i32 }
// A reference join's bare `null` arm: the `ref.null` of join kind `jnKind`'s heap at row `jnSlot`,
// as legacy writes it (`fbRefNullOfKind`). The builder takes both from `ifRefJoinOf` once.
export type RJoinNull = { jnKind: VKind, jnSlot: i32 }
// A `==`/`!=` at node `neAt` on legacy's `nulNiche` route over nullable operands `neL` and `neR`,
// under the null guard `nulNicheEqHead` opens; the guard writes the right operand twice, `neR`
// and then `neR2`, which is `neR` for a variable and a second build of the operand otherwise.
export type RNulNicheEq = { neL: Opnd, neR: Opnd, neR2: Opnd, neAt: i32 }
// `ntV`, a `K | null`, a nullable reference or a union box, tested against `null` at compare node `ntAt`; `ntInvert` for `!=`, as the
// binary dispatch hands it to legacy's null test (`binNulTestOf`).
export type RNulTest = { ntV: Opnd, ntInvert: boolean, ntAt: i32 }
// The `==` (or, with `aeNe`, `!=`) of two atoms at `aeAt`. `aeStatic` 1 or 2: that side is one
// string literal, its id from its lexeme (an unread immediate, else evaluated and dropped); 0 two
// atom values; 3 two literal sides folded to a constant; 4 a literal left side whose id `aeL` is
// staged below a statement the right side writes.
export type RAtomEq = {
  aeL: Opnd,
  aeR: Opnd,
  aeStatic: i32,
  aeNe: boolean,
  aeAt: i32,
}
// A union box `ucBox` against `ucOther` at `ucAt` (`ucSwap`: box on the right) by legacy's plan,
// `ucStash` its stash, `ucNul` the operand's null leg, `ucAgain` its read written again, `ucStage`
// the null legs' parked sides (1 the box, 2 the operand, 4 the operand parked first), `ucOtherAgain`
// a null leg's operand read written again in its plain arm.
export type RUnionConcreteEq = {
  ucBox: Opnd,
  ucOther: Opnd,
  ucNe: boolean,
  ucSwap: boolean,
  ucStash: boolean,
  ucNul: boolean,
  ucAgain: boolean,
  ucStage: i32,
  ucOtherAgain: boolean,
  ucAt: i32,
}
// The `==` (or, with `ueNe`, `!=`) of two union boxes at compare node `ueAt`, written by legacy's
// compare over the two operands (`unionUnionBoxesTail`): the struct union's, or the staged one.
export type RUnionEq = { ueL: Opnd, ueR: Opnd, ueNe: boolean, ueAt: i32 }
// A union box `uvBox` against the record `uvOther` at `uvAt` (`uvSwap`: the box on the right), on
// legacy's variant door.
// A union box `ncBox` against the number `ncOther` of kind `ncKind` at `ncAt` (`ncSwap`: the box on
// the right), on legacy's cross-width door: each number arm compared at the wider kind.
export type RUnionNumCrossEq = {
  ncBox: Opnd,
  ncOther: Opnd,
  ncKind: i32,
  ncNe: boolean,
  ncSwap: boolean,
  ncAt: i32,
}
// One step of a staged union compare at `usAt` (`emitUnionEqStaged`, arm kind `usKind`): `usOp` 0
// opens its level, 1 parks the box `usV`, 2 parks the operand `usV`, 3 closes it; on the null legs
// 4 opens (`usKind` 1: the box staged), 5 parks the operand first (`usKind` its leg), 6 the box.
export type RUnionStage = { usOp: i32, usV: Opnd, usKind: i32, usAt: i32 }
// A staged union compare's value at `uqsAt`: the plan's tails over the parked sides.
export type RUnionStagedEq = { uqsNe: boolean, uqsSwap: boolean, uqsAt: i32 }
export type RUnionVariantEq = {
  uvBox: Opnd,
  uvOther: Opnd,
  uvNe: boolean,
  uvSwap: boolean,
  uvAt: i32,
}
// The `==` (or `!=`) of two lists at compare node `qeAt`, written by legacy's list compare
// (`listEqTail`) after each operand's own recovery (`listEqOperandTail`).
export type RListEq = { qeL: Opnd, qeR: Opnd, qeAt: i32 }
// A function-value `==`/`!=` at node `cqAt` on legacy's `closure` route over closures `cqL` and
// `cqR`: identity, written by `closureEqTail`.
export type RClosureEq = { cqL: Opnd, cqR: Opnd, cqAt: i32 }
// A reference identity `===`/`!==` at node `ieAt` on legacy's `identRef` route over `ieL` and
// `ieR`: each operand, a union box by its payload (`identityOperandTail`), then `ref.eq`.
export type RIdentityEq = { ieL: Opnd, ieR: Opnd, ieAt: i32 }
// The `+` of two lists at concat node `ljAt`, written by legacy's concat (`listCatTail`) after each
// operand's own recovery (`listCatOperandTail`).
// `ljWiden` names the side (1 left, 2 right, 0 none) built at its own narrower list, which the
// lowering widens to the concat's element (`catWidenTail`).
export type RListCat = { ljL: Opnd, ljR: Opnd, ljAt: i32, ljWiden: i32 }
// The value `cvV` of node `cvAt` converted by the coercion its checker record owes there, a list
// copy or a union box's retag, written by legacy's tail after it (`coerceTail`).
export type RCoerce = { cvV: Opnd, cvAt: i32 }
// A push's receiver already staged by the `RListStage` statement at node `pstNode`.
export type PStaged = { pstNode: i32 }
// A push's receiver: an operand it reads, or the stage that holds it.
export type PushRecv = OVar | OImm | OStr | PStaged
// A one-argument `.push` of `lpX` onto list `lpV`, its call `lpAt`; as a value, the new length.
export type RListPush = { lpV: PushRecv, lpX: Opnd, lpAt: i32 }
// A variadic `.push` (several arguments, or a spread) onto list `pmV`, its call `pmAt`: the run
// `pmL`, legacy's own literal of the arguments, appended in bulk; as a value, the new length.
export type RListPushMany = { pmV: Opnd, pmL: Opnd, pmAt: i32 }
// The receiver `rsgV` of push call `rsgAt`, staged into that push's frame slot ahead of a value
// that writes a valued `if`; a statement, named by exactly one later push.
export type RListStage = { rsgV: Opnd, rsgAt: i32 }
// A `.pop()` on list `lqV`, its call `lqAt`: the element is taken, and an empty list is left as
// it is. With an index in `lqIx`, a `.get(i)`: the element at `i` read under the bound, the list
// untouched; legacy writes the index from the call itself, twice (`pushTakeCond`).
export type RListPop = { lqV: Opnd, lqIx: Opnd[], lqAt: i32 }
// A `.clear()` statement on list `lkV`, its call `lkAt`: the length is zeroed, the backing kept.
export type RListClear = { lkV: Opnd, lkAt: i32 }
// `RMapFilter`'s operands: the list, the callback, then the captures it builds the callback from.
function mapFilterOpnds(r: RMapFilter): Opnd[] {
  const out: Opnd[] = [r.hfV, r.hfC]
  for o in r.hfEnv { out.push(o) }
  return out
}

// A `.map` or `.filter` of list `hfV` at call `hfAt` by callback `hfC`: a function-typed value, or
// the `null` immediate for a function built at the loop, from its captures `hfEnv` when it has any.
// `hfV` is the no-value immediate where an `RMapFilterHead` statement already wrote the list.
export type RMapFilter = { hfV: Opnd, hfC: Opnd, hfEnv: Opnd[], hfAt: i32 }
// The list `mhV` of `.map`/`.filter` call `mhAt` and its store into the call's source local, as a
// statement ahead of a callback that writes one; named by exactly one later headed `RMapFilter`.
export type RMapFilterHead = { mhV: Opnd, mhAt: i32 }
// A list `.slice` of list `scV` at call `scAt` over its bounds `scArgs` (start, then an optional end).
export type RListSlice = { scV: Opnd, scArgs: Opnd[], scAt: i32 }
// A map operation `mpOp` at node `mpAt` over `mpArgs`, its receiver first: `size` is `m.length`,
// legacy's live entry count (`mapLengthPlain`).
export type RMapOp = { mpOp: MapOp, mpArgs: Opnd[], mpAt: i32 }
// The empty map a builtin `Map()` or `Set()` call at node `mnAt` builds, by legacy's writer.
export type RMapNew = { mnAt: i32 }
// A set of `msVal` at key `msKey` into map global `msSym` (receiver node `msRecv`, recovered for
// `msNonNull`), or, with `msSym` -1, into receiver operand `msLoc`; a Set's `add` (`msAdd`) stores the
// constant `true`. `msPark`: the set keeps its value for its assignment's value (`RAsgParked`).
export type RMapSet = {
  msSym: i32,
  msNonNull: boolean,
  msLoc: Opnd,
  msRecv: i32,
  msKey: Opnd,
  msVal: Opnd,
  msAdd: boolean,
  msPark: boolean,
}
// `czL ?? czD` at `??` node `czAt` over a `string | null`: legacy's block, in which `czD`, a
// string literal written by legacy's literal writer, runs only when `czL` is null.
export type RCoalStr = { czL: Opnd, czD: Opnd, czAt: i32 }
// `zaL ?? zaD` over a `K | null`: the id's member string, or the string default where it is null.
export type RCoalAtomStr = { zaL: Opnd, zaD: Opnd, zaAt: i32 }
// A tagged call's set id `tgsV`, kept in the dispatch slot its arms test (`tagStashTail`).
export type RTagStash = { tgsV: Opnd }
// The kept set id is member id `tgiId` (`tagIsTail`).
export type RTagIs = { tgiId: i32 }
// `leV`, a list, tested empty at every depth down to the arm `is` test `leAt` names, as legacy's
// `emitListEmptyLoop` walks it (`emptyFitPlanOf`): a bool. A `shadow` arm's test first stores
// the arm's empty `K[]` in variable `leFit` (`listFitShadowSet`), which the region reads; else -1.
export type RListEmpty = { leV: Opnd, leAt: i32, leFit: i32 }
// Box variable `lfV` tested at each list arm of `is` test `lfAt` whose elements never meet the
// tested type (`emptyFitArmsPlanOf`): the arm's tag, then its list's emptiness, or'd: a bool.
export type RListEmptyArms = { lfV: Opnd, lfAt: i32 }
// `laV is L` for list type `L` over a box of list arms at `is` test `laAt`, along
// `listIsAcrossRepsPlan`: the box once into the shared receiver slot, then each arm's test.
export type RListIsAcross = { laV: Opnd, laAt: i32 }
// `lsV is L` for list type `L` over a list whose elements are wider than `L` at `is` test `lsAt`,
// along `listFitPlanOf`: each element, at every depth, a member of `L`: a bool.
export type RListFitIs = { lsV: Opnd, lsAt: i32 }
// `liV` at literal arm `liArm` of `is` test `liAt` (`litIsArmOf`), read once per member the arm
// compares, as `emitIsTestLitArms` writes it: a bool.
export type RLitArms = { liV: Opnd, liArm: LitIsArm, liAt: i32 }
// `niV is K` over a numeric literal union at `is` test `niAt`, along `numIsPlanOf`: the receiver read
// once into a slot, or once per member.
export type RNumIs = { niV: Opnd, niAt: i32 }
// `is` test `stAt` whose receiver legacy evaluates once into its stash (`isRecvStageRep` key
// `stKey`): `stV` into that slot, which variable `stVar` then names, and the rungs' bool `stTest`.
export type RIsStaged = {
  stV: Opnd,
  stVar: i32,
  stKey: i32,
  stTest: Opnd,
  stAt: i32,
}
// A binary operator at node `nbAt` on legacy's `numUnion` route, over its non-literal sides in
// order (a literal side is written at each member's width, so it has no operand).
export type RNumUnionBin = { nbArgs: Opnd[], nbAt: i32 }
// Numeric union box `nuV` of node `nuAt` converted to number kind `nuTo` at the member it holds,
// as legacy's `emitNumUnionConvert` writes it (`widenPlanOf`'s `convert`).
export type RNumUnionConvert = { nuV: Opnd, nuTo: i32, nuAt: i32 }
// A `null`-typed value of node `nnAt` boxed under the null tag, as legacy's box ladder's first
// rung writes it (`emitNulNoneBoxPayload`): with `nnPay`, call `nnV` is the payload, else the
// bottom ref is.
export type RNulNoneBox = { nnV: Opnd, nnPay: boolean, nnAt: i32 }
// A numeric intrinsic at call `nxAt`: its operands, then its one instruction `nxOp`
// (`numIntrPlanOf`) at `nxSel` "op", or an integer `abs`/`min`/`max`'s select (`intSelTail`),
// at i64 when `nxWide`.
export type RNumIntr = {
  nxArgs: Opnd[],
  nxOp: i32,
  nxSel: NumIntrSel,
  nxWide: boolean,
  nxAt: i32,
}
export type NumIntrSel = "op" | "abs" | "min" | "max"
// A SIMD intrinsic at call `sdAt`: its value operands, then its one instruction and any lane
// immediates (`simdTail`). As the builder planned it, a load or store has `sdMemBase` operands (1
// or 2, else 0); any other op takes operands at `sdPrims` and leaves `sdResPrim` ("" for none).
export type RSimd = {
  sdArgs: Opnd[],
  sdAt: i32,
  sdMemBase: i32,
  sdPrims: string[],
  sdResPrim: string,
}
// A `print` statement at call `pnAt` of argument `pnV`, written by legacy's tail for its arm.
export type RPrint = { pnV: Opnd, pnAt: i32, pnOpened: i32 }
// The blocks legacy opens before a nullable string's (`poArm` 0) or boolean's (1) `print` operand
// (`printNulStrOpen`), placed before the operand's statements; the `RPrint` whose `pnOpened` is
// that arm closes them. `pnOpened` is -1 for a print that opens its own.
export type RPrintOpen = { poArm: i32 }
// `m[k] ?? d` at `??` node `mgAt`: map global `mgSym` (recovered for `mgNonNull`), else receiver
// `mgLoc`, key `mgKey`; by `mgForm` the default goes to `__map_get_<row>__`'s miss (0), else is `mgDef`
// in the miss arm of: `i32` read (1), mv slot (2), `scalar | null` value's scalar (3), niche null (4),
// nullable union's box (5), sentinel (6), boxed union join (7), scalar boxed as `T | null` (8).
export type RMapGetOr = {
  mgSym: i32,
  mgNonNull: boolean,
  mgLoc: Opnd,
  mgKey: Opnd,
  mgAt: i32,
  mgForm: i32,
  mgDef: Opnd,
}
// A bare `m[k]` at Index `mtAt` (global `mtSym`, else receiver `mtLoc`; key `mtKey`), by
// `mapGetArmOf`: `mtBox` the box plan's atom kind or -1, `mtRow` banks the element-read row,
// `mtTrap` traps on a miss, `mtPrint` (a scalar kind or -1) prints it, and `mtWhole` reads a
// union-valued map's box past its narrowing (`emitMapGetUnionBox`).
export type RMapGet = {
  mtSym: i32,
  mtNonNull: boolean,
  mtLoc: Opnd,
  mtKey: Opnd,
  mtAt: i32,
  mtBox: i32,
  mtRow: boolean,
  mtTrap: boolean,
  mtPrint: i32,
  mtWhole: boolean,
}
// `m.keys()` or, under `miVals`, `m.values()` at call `miAt` over map variable `miV`, which legacy's
// writer reads three times (`mapListStep`): a fresh list of the live entries. Under `miOnce` the
// receiver is a temp no read repeats, evaluated once into a local the three reads take.
export type RMapIter = {
  miV: Opnd,
  miAt: i32,
  miVals: boolean,
  miOnce: boolean,
}
// A scalar map read `m[k]` against operand `mqOther` at compare node `mqAt` (`scalarMapEqPlanOf`'s
// `read` arm): map global `mqSym` (recovered for `mqNonNull`) or receiver `mqLoc`, key `mqKey`;
// a miss equals nothing. An i32 0 or 1.
export type RMapEq = {
  mqSym: i32,
  mqNonNull: boolean,
  mqLoc: Opnd,
  mqKey: Opnd,
  mqOther: Opnd,
  mqAt: i32,
}
// `m.has(k)` at call `mhAt` on map global `mhSym` (receiver node `mhRecv`, recovered for
// `mhNonNull`), or with `mhSym` -1 receiver operand `mhLoc`, key `mhKey`: legacy's probe and hit flag, an
// i32 0 or 1.
export type RMapHas = {
  mhSym: i32,
  mhNonNull: boolean,
  mhLoc: Opnd,
  mhRecv: i32,
  mhKey: Opnd,
  mhAt: i32,
}
// `m.clear()` at call `mcAt` on map global `mcSym` (receiver node `mcRecv`, recovered for
// `mcNonNull`), or with `mcSym` -1 receiver operand `mcLoc`: legacy's reset of the map in place.
export type RMapClear = {
  mcSym: i32,
  mcNonNull: boolean,
  mcLoc: Opnd,
  mcRecv: i32,
  mcAt: i32,
}
// `m.delete(k)` at call `mdAt` on map global `mdSym` (receiver node `mdRecv`, recovered for
// `mdNonNull`), or with `mdSym` -1 receiver operand `mdLoc`, key `mdKey`: legacy's probe, the
// entry's tombstone and an i32 0 or 1.
export type RMapDelete = {
  mdSym: i32,
  mdNonNull: boolean,
  mdLoc: Opnd,
  mdRecv: i32,
  mdKey: Opnd,
  mdAt: i32,
}
// A `==`/`!=` at node `seAt` on legacy's field-wise record compare over eq row `seRow` (a struct's
// or a variant's): an operand legacy stashes is lowered once; one it re-reads at every field is a
// variable, or with `seLIx`/`seRIx` holding an index, a ref list element read over that variable.
// `seNul` is two nullable records', guarded by their nullness (`nulStructEqGuardTail`).
export type RStructEq = {
  seL: Opnd,
  seR: Opnd,
  seAt: i32,
  seRow: i32,
  seLIx: Opnd[],
  seRIx: Opnd[],
  seNul: boolean,
}
// `__eq_<ehRow>__`'s compare of its two parameters `ehL` and `ehR`, as `eqHelpTail` writes it.
export type REqHelp = { ehL: Opnd, ehR: Opnd, ehRow: i32 }
export type RStrOp = { soOp: StrOp, soArgs: Opnd[], soAt: i32 }
export type RMakeClo = { mcFn: i32, mcEnv: Opnd[], mcAt: i32 }
export type RFnId = { fiMember: i32 }
// Tagged function set id `tcV`, held in a variable, as the closure of the member it names
// (`tcFns`, the members of the set type `tcTy` carries, in id order); with `tcBox`, `tcV` is the
// id's `i32 | null` box and its null the closure's null.
export type RTagClo = { tcV: Opnd, tcFns: i32[], tcTy: i32, tcBox: boolean }
// Closure `ckV`, held in a variable, of tagged set type `ckTy` as its member's id (`ckFns`, in id
// order); with `ckNul` the closure is nullable, and with `ckBox` the id is written in the
// `i32 | null` box, the closure's null as its null.
export type RCloTag = {
  ckV: Opnd,
  ckFns: i32[],
  ckTy: i32,
  ckNul: boolean,
  ckBox: boolean,
}
// The interned id of the one member of a literal place at node `asAt`, written for it by legacy's
// atom hook (`strToAtomArmOf`'s `sole`); the place is not read.
export type RAtomSole = { asAt: i32 }
// Legacy's `nullty` null test (`emitDeadNullTest`): operand `dnV` built for its effect and dropped,
// then the test's constant `dnBits`, in the operand's place.
export type RDeadNullTest = { dnV: Opnd, dnBits: i64 }
// Legacy's atom tower over a literal place at node `saAt` (`strToAtomArmOf`'s `chain`): each
// member's id, then the place's string read `saReads[i]` tested against member `i`, last first.
export type RStrToAtom = { saReads: Opnd[], saAt: i32 }
// Legacy's staged atom narrowing of value `zsV`, the raw string of node `zsAt`
// (`strToAtomArmOf`'s `staged`): parked once, then the tower over the parked string.
export type RStrToAtomStaged = { zsV: Opnd, zsAt: i32 }
// The hook's `wideLit` arm at node `awAt`, a read of a `const` bound to a literal: the raw
// value `awV` dropped, then the literal's id.
export type RAtomWide = { awV: Opnd, awAt: i32 }
export type RCellNew = { cnInit: Opnd }
export type RCellGet = { cgCell: Opnd }
// `ggNonNull`: the read is followed by `ref.as_non_null` (`globalReadRecovers`). `ggNn`: for a read
// narrowed past the cell's null, how many more `emitReadRecover` writes, decided where it is built;
// -1 for a read at the cell's own rep.
export type RGlobalGet = { ggSym: i32, ggNonNull: boolean, ggNn: i32 }
// Capture `evSlot` of the function's environment, read at `evAt`, as legacy's capture arm reads it.
export type REnvGet = { evSlot: i32, evAt: i32 }
// The environment of nested function `edFn` this frame caches, dropped where its declaration runs.
export type REnvDrop = { edFn: i32 }
// The start body's read-before-init progress after top-level position `ipOrd`, as legacy's
// `emitInitProgressAt` writes it: the cell set past the guarded global that position settles.
export type RInitProgress = { ipOrd: i32 }
// The closure the bundle parameter or record holder `bpV` holds for call `bpAt`, as `bundlePickOf`
// picks it.
export type RBundlePick = { bpV: Opnd, bpAt: i32 }
// The member closure direct call `rkAt` of `fnStmts` slot `rkFe` picks from the bundle record
// `rkV` it returned, as `bundleResultPickOf` (legacy's `emitBundleResultPick`) names it.
export type RResultPick = { rkV: Opnd, rkAt: i32, rkFe: i32 }
// The member closure argument `hpI` (node `hpArg`) of direct call `hpAt` hands of the bundle record
// `hpV` it reads, as `bundleMemberPickOf` (legacy's `emitBundleMemberPick`) names it.
export type RHandPick = { hpV: Opnd, hpAt: i32, hpArg: i32, hpI: i32 }
// Member `hkM` of the bundle holder record `hkV` that read `hkArg` names, as legacy's
// `bundleMemberPickOf` picks it: an annotated binding's (`typedHolderMember`) or a field's.
export type RHolderPick = { hkV: Opnd, hkM: i32, hkArg: i32 }
// A runtime helper's wasm GC instruction over raw reps, keyed by heap type `rwHeap`: the field of
// a `struct.get`, the callee index of a `call`, the variable a `tee` writes in `rwImm`. `test`
// reads an i32 as the bool wasm's `if` takes it to be, nonzero true, and writes nothing. `tag64`
// is an i64 key variable's map pair tag, through the one writer every map tag comes from.
export type RawOp = "struct.get" | "struct.new" | "array.get" | "array.new_default" | "array.len"
  | "ref.eq" | "ref.cast" | "ref.as_non_null" | "ref.null" | "ref.is_null" | "call" | "tee" | "test"
  | "load" | "tag64" | "ref.test" | "select" | "push"
export type RRawOp = { rwOp: RawOp, rwHeap: i32, rwArgs: Opnd[], rwImm: i32 }
// A helper's i32 constant `rlVal` that the relocation table names in space `rlSp` from `rlSub`.
export type RRel = { rlSp: i32, rlSub: i32, rlVal: i32 }
// An operand's own value as a temp, which writes the operand alone: a variable or immediate
// argument before one whose valued `if` the lowering writes it below (`stageLead`), or a union box
// read at a narrower union's box rep, the same box.
export type RStage = { sgV: Opnd }
export type Rhs = RAfterEffects
  | RArmUnbox
  | RAsTail
  | RAsUnion
  | RAsgParked
  | RAsgUnwiden
  | RAtomEq
  | RAtomSole
  | RAtomStr
  | RAtomWide
  | RAtomic
  | RBoxField
  | RBoxNarrow
  | RBundlePick
  | RCall
  | RCallHost
  | RCallRef
  | RCallRefHead
  | RCast
  | RCellGet
  | RCellNew
  | RCloTag
  | RClosureEq
  | RCoalAtomStr
  | RCoalStr
  | RCoerce
  | RDeadNever
  | RDeadNullTest
  | REnvDrop
  | REnvGet
  | REqHelp
  | RFieldNull
  | RFnId
  | RGetField
  | RGlobalGet
  | RHandPick
  | RHolderPick
  | RHoleOptBox
  | RIdentityEq
  | RInitProgress
  | RIsStaged
  | RJoinNull
  | RListCat
  | RListClear
  | RListCopy
  | RListEmpty
  | RListEmptyArms
  | RListEq
  | RListFitIs
  | RListGet
  | RListIsAcross
  | RListLen
  | RListNew
  | RListNewDefault
  | RListPop
  | RListPush
  | RListPushMany
  | RListSlice
  | RListStage
  | RLitArms
  | RMaFoldInit
  | RMakeClo
  | RMakeList
  | RMakeRec
  | RMapClear
  | RMapDelete
  | RMapEq
  | RMapFilter
  | RMapFilterHead
  | RMapGet
  | RMapGetOr
  | RMapHas
  | RMapIter
  | RMapNew
  | RMapOp
  | RMapSet
  | RMemAccess
  | RMemOp
  | RNicheRead
  | RNulNicheEq
  | RNulNoneBox
  | RNulTest
  | RNullOf
  | RNumCast
  | RNumIntr
  | RNumIs
  | RNumUnionBin
  | RNumUnionConvert
  | RNumWiden
  | ROptRead
  | RPrimOp
  | RPrint
  | RPrintOpen
  | RRawOp
  | RRecCopyPure
  | RRecDown
  | RRecordFitIs
  | RRecover
  | RRel
  | RResultPick
  | RRetNull
  | RRetag
  | RSharedFieldSet
  | RSharedRead
  | RSimd
  | RSpread
  | RStage
  | RStashSet
  | RStrOp
  | RStrToAtom
  | RStrToAtomStaged
  | RStructEq
  | RTagClo
  | RTagIs
  | RTagOf
  | RTagStash
  | RTest
  | RToBox
  | RTruncSat
  | RUnionConcreteEq
  | RUnionEq
  | RUnionNumCrossEq
  | RUnionStage
  | RUnionStagedEq
  | RUnionVariantEq
  | RVariantChain
  | RVariantDiscrim

// A `match` arm: union arm `swArm` (-1 for the default, which names what it excludes in
// `swWhy`), and its body.
export type SwitchArm = { swArm: i32, swWhy: string, swBody: i32[] }

// The statements. A body is a list of node ids; an `SIf`'s or `SBlock`'s out-variable (-1 for
// none) is written by an `SAssign` that ends each arm, or by each `SBr` to the block's label.
export type SLet = { lDst: i32, lRhs: Rhs }
export type SAssign = { asDst: i32, asSrc: Opnd }
// `sfPark`: the store parks its value for its assignment's value to read back (`RAsgParked`).
export type SSetField = { sfV: Opnd, sfIx: i32, sfSrc: Opnd, sfPark: boolean }
export type SListSet = { lsV: Opnd, lsIx: Opnd, lsSrc: Opnd }
export type SCellSet = { csCell: Opnd, csSrc: Opnd }
export type SGlobalSet = { gsSym: i32, gsSrc: Opnd }
export type SBoundsCheck = { bcV: Opnd, bcIx: Opnd }
export type SEffect = { efRhs: Rhs }
export type SBlock = { bkLabel: i32, bkBody: i32[], bkOut: i32 }
export type SLoop = { lpLabel: i32, lpBody: i32[] }
// A range loop legacy writes through its own helpers (`forRangeArm` "partial", or "rolled" with a
// wrap exit) at `rlAt` into `rlVar`: the partial main loop's copies `rlCopies` (break to `rlBrk`,
// continue to `rlConts[k]`), then the rolled loop's `rlTail` (`rlTailBrk`, `rlTailCont`). A
// migration node that retires at I8 with `SForIn` (ir-design §1.2).
export type SRangeLoop = {
  rlAt: i32,
  rlVar: i32,
  rlPartial: boolean,
  rlCopies: i32[][],
  rlConts: i32[],
  rlBrk: i32,
  rlTail: i32[],
  rlTailBrk: i32,
  rlTailCont: i32,
}
// The plain walk of `for` statement `xfAt` over `xfList` into `xfVar` (`forInPlainWhy`): legacy's
// loop around `xfBody`, `break` to `xfBrk` and `continue` to `xfCont`. A map walk reads map global
// `xfMap` (recovered for `xfMapNonNull`), `xfList` then an unread immediate; with `xfMap` -1 a map
// walk's `xfList` is its receiver, at a map rep.
export type SForIn = {
  xfList: Opnd,
  xfVar: i32,
  xfVar2: i32,
  xfBody: i32[],
  xfAt: i32,
  xfBrk: i32,
  xfCont: i32,
  xfMap: i32,
  xfMapNonNull: boolean,
  // A map walk reads values, not keys.
  xfVals: boolean,
  // A keys walk's key rep, from the receiver's checked map type (a map rep holds no key), else -1.
  xfKeyRep: i32,
  // A walk of a union of lists' box (`luForWalkPlanOf`): each element read off the arm the box holds,
  // boxed into the element union or converted to the flat kind, the body written once.
  xfLu: boolean,
}
// `siElseKw`: the source wrote a live `else`, which legacy writes even when its arm is empty.
// `siJoin`, `siJoinNul`: a reference join decided for this `if` (a chain's head's, as
// `emitIfExprRef` writes every link), and whether its blocktype is nullable; a null kind opens
// at the `if`'s own.
export type SIf = {
  siCond: Opnd,
  siThen: i32[],
  siElse: i32[],
  siOut: i32,
  siElseKw: boolean,
  siJoin: RefJoin,
  siJoinNul: boolean,
  // A value `if` written into a box arm by arm, opening at that box's blocktype whatever its own
  // join (`emitUnionCoerceUnder`'s `if` arm).
  siAtDst: boolean,
}

// An `if` that opens at its own join (no decided `siJoin`).
export function sIf(
  c: Opnd,
  thenB: i32[],
  elseB: i32[],
  out: i32,
  elseKw: boolean,
): SIf {
  return {
    siCond: c,
    siThen: thenB,
    siElse: elseB,
    siOut: out,
    siElseKw: elseKw,
    siJoin: { rjKind: null, rjSlot: -1 },
    siJoinNul: false,
    siAtDst: false,
  }
}
export type SSwitch = { swOn: i32, swArms: SwitchArm[], swOut: i32 }
// Whether a `??` along arm `a` stages an earlier operand's temps below its operand: a niche
// cell's `if`, a nullable reference's block, a boxed binding's tag test, a call's box stash and a
// union field's test read only that operand before they open.
export function coalArmStagesLeads(a: CoalValArm): boolean {
  return match a {
    "litUnion" | "nulBool" | "nulRef" | "nulStr" | "asProp" | "nulBoolJoin" | "valBox" | "valScalar" | "callBox" | "callScalar" | "boxStash" | "boxRuntime" | "fieldBox" | "fieldVal" => true
    "boolPop" | "valNoKind" | "elem" | "callNoKind" | "next" | "popOr" | "listGetOr" | "mapIndexGetOr" | "optLeaf" | "optBoxLeaf" | "optRecLeaf" | "optMapField" | "nulAtomJoin" | "boxFieldScalar" => false
  }
}
// An integer `match` chain written as one `br_table` (`IntSwitchPlan`): operand `isOn` less
// `isLo`, read again under the range test when `isWide`; `isTable[d]` the arm index `d` takes,
// `isArms.length` the else, whose body is `isElse`. A tail chain's (`isTail`) arms return; a
// valued one's write out `isOut` (-1 for none), which its frame carries.
export type SIntSwitch = {
  isTail: boolean,
  isOut: i32,
  isOn: Opnd,
  isWide: boolean,
  isLo: i32,
  isTable: i32[],
  isArms: i32[][],
  isElse: i32[],
}
// A `??` at `cbAt` whose head and present arm are legacy's shared tails along arm `cbArm`, with a
// lazy default and a valued out: operand `cbL`, the `if` or block the tails open on it, and the
// default `cbNull`, which writes out `cbOut` on the null path; `cbMap`, a fused map read's probe.
// `cbLB` builds `cbL` inside the block a nullable reference's plain arm opens, empty elsewhere.
export type SCoalBox = {
  cbL: Opnd,
  cbLB: i32[],
  cbArm: CoalValArm,
  cbNull: i32[],
  cbOut: i32,
  cbAt: i32,
  cbMap: MapProbe | null,
  // The `listGetOr` arm's index, an immediate or a variable legacy's head reads at each use
  // (`listGetIdxHook`); null where legacy reads its own.
  cbIdx: Opnd | null,
}
// A fused map read's probe: map global `prSym` (recovered for `prNonNull`), or where it is -1 the
// receiver in `cbL`, key `prKey`, and `RMapGetOr`'s inline form `prForm` (1 the `i32` read, 2 mv,
// 3 a union value's scalar, 4 a ref niche, 5 a nullable union's box).
export type MapProbe = {
  prSym: i32,
  prNonNull: boolean,
  prKey: Opnd,
  prForm: i32,
}
export type SBr = { brLabel: i32, brHas: boolean, brVal: Opnd }
export type SReturn = { rtHas: boolean, rtV: Opnd }
export type STrap = { tpWhy: i32 }
// `tpWhy` of the trap behind a guard that ends its block (D932): nothing after it in that block
// is built, as legacy cuts it.
export const TRAP_BLOCK_CUT = 1
// A value evaluated and discarded, as legacy writes a bare value statement. Migration only: it
// goes, with every use, once bytes may move.
export type SDrop = { dpV: Opnd }
// A helper's raw instruction that yields nothing: `srImm` is a set's field, a data segment, a callee.
// `as.fail` reports cast node `srImm`'s `as!` failure (`__as_fail__`), in any body.
export type RawEff = "struct.set"
  | "array.set"
  | "array.copy"
  | "array.init_data"
  | "array.fill"
  | "call"
  | "reserve.open"
  | "reserve.close"
  | "sink.put"
  | "sink.null"
  | "sink.close"
  | "as.fail"
export type SRawOp = { srOp: RawEff, srHeap: i32, srArgs: Opnd[], srImm: i32 }
// A read `saAt` through a box of lists or maps (an element, `.length`, `.has` or `.get`) on
// legacy's tag chain: `saOps` the box, then its index or key (none for a `.length`); per arm
// `saArms[k]` reads payload variable `saVars[k]` and writes out `saOut`; the index is read as
// `saIdx` when set. `saStash`: the box is held in legacy's receiver stash, not re-read by name.
export type SArmSite = {
  saOps: Opnd[],
  saAt: i32,
  saStash: boolean,
  saArms: i32[][],
  saVars: i32[],
  saIdx: i32,
  saOut: i32,
}
// A store `awAt` through a box of list arms inside `is K[]` (`emitArmIndexWriteAt`), or a `for`
// `awAt` over a union of maps' box (`emitMapUnionFor`): per arm `awArms[k]`, the box `awV` read by
// name, its tag tested, its payload cast into variable `awVars[k]`, and the arm's store or walk
// over it; `unreachable` past the last arm.
export type SArmWrite = { awV: Opnd, awAt: i32, awArms: i32[][], awVars: i32[] }
export type IrNode = SArmSite
  | SArmWrite
  | SAssign
  | SBlock
  | SBoundsCheck
  | SBr
  | SCellSet
  | SCoalBox
  | SDrop
  | SEffect
  | SForIn
  | SGlobalSet
  | SIf
  | SIntSwitch
  | SLet
  | SListSet
  | SLoop
  | SRangeLoop
  | SRawOp
  | SReturn
  | SSetField
  | SSwitch
  | STrap

export type VarKind = "param" | "local" | "temp"
// A variable: its rep (fixed at its definition), type, kind and wasm local index (-1 unset).
export type IrVar = { vRep: i32, vTy: i32, vKind: VarKind, vSlot: i32 }

// One function: the node arena with each node's type, rep and source node, the variables, the
// top-level body, the parameters and result, and the signatures of the functions and the reps of
// the globals it uses, and the source statement that built each run of nodes (`irSpan*`).
// A spread literal `sqAt`, its build's kind and slot, and its boxing row or -1 (`irSpreadPair`).
export type SpreadPairNote = {
  sqAt: i32,
  sqKind: i32,
  sqSlot: i32,
  sqBoxRow: i32,
}

export type IrFn = {
  irNodes: IrNode[],
  irNodeTy: i32[],
  irNodeRep: i32[],
  irNodeAt: i32[],
  // The `if` nodes built as tail links (`tailIf`): legacy's `emitIfTail` writes a literal-true
  // test, which a statement `if` drops.
  irTailLinks: i32[],
  irVars: IrVar[],
  irBody: i32[],
  irParams: i32[],
  irRetRep: i32,
  irRetTy: i32,
  irAt: i32,
  irName: string,
  // A start body that opens with legacy's pool fill: the single start, never an init function.
  irPoolFill: boolean,
  // A runtime helper the door builds: the only function a raw rep or op may appear in.
  irHelper: boolean,
  // A door fragment (`lowerNodeIn`): its locals are checked against legacy's cells, so a walk's
  // element it did not build reads that element's legacy slot.
  irFragment: boolean,
  // A closure thunk: one call forwarding its parameters, in tail form whatever the callee
  // returns, as `emitCloThunkCode` writes it.
  irThunk: boolean,
  // A thunk whose result type is its rep's own (`repTyOf`), its target's being open: the verifier
  // then checks the thunk forwards faithfully, since that type round-trips to its rep by origin.
  irRetFromRep: boolean,
  // A function no instance re-builds at other reps (`fnBuiltOnce`): its open parts hold as built.
  irBuiltOnce: boolean,
  // A lifted function's assigned captures, the parameter variables every exit hands back after
  // its result (D3664), in legacy's order (`fbSeedRetExtra`).
  irRetExtra: i32[],
  irSigFn: i32[],
  irSigParams: i32[][],
  irSigRet: i32[],
  irGlobalSym: i32[],
  irGlobalRep: i32[],
  irGlobalAt: {[i32]: i32},
  // The heap the builder noted for each record rep a hole retag compares (`irRecHeapNote`).
  irRecHeap: {[i32]: i32},
  // The struct row a struct literal's record temp is built at (`irVarHeapNote`); its heap is
  // `structRowHeap`'s.
  irVarHeap: {[i32]: i32},
  // The struct row each record variable is laid out at (`irVarRowNote`): its rep is that row's
  // rep (`rowRep`), or its nullable, and its wasm type the row's heap.
  irVarRow: {[i32]: i32},
  // The rep each struct row a variable is noted at is laid out at (`irVarRowNote`).
  irRowRep: {[i32]: i32},
  // The retag nodes the builder noted as a closure stored at a record field legacy writes plainly,
  // whose closure kid another row on the same heap typed (`irCloFieldRetagNote`).
  irCloFieldRetag: {[i32]: boolean},
  // The temps a `.push` receiver's read builds, which legacy writes with its list payload cast
  // strict (`listCastForPush`).
  irPushRecv: {[i32]: boolean},
  // The storage-row type (`letBindTy`) of each global the builder reads or stores at that row.
  irGlobalStoreTy: {[i32]: i32},
  // Facts the builder notes for the verifier by node (`irNoteVerifyFacts`): the checked type of a
  // global or field read's node, and an int a node's own check reads (see `irFactIntOf`).
  irFactTy: {[i32]: i32},
  irFactInt: {[i32]: i32},
  // A record's site type per layout position, by node (legacy's field box type at its built row).
  irFactKidTy: {[i32]: i32[]},
  // The valtype bytes legacy writes a rep at, for each rep the verifier compares stored alike, and
  // whether each open-typed variable's open parts are functions held at a fixed rep.
  irRepValtype: {[i32]: u8[]},
  irVarHeldIds: {[i32]: boolean},
  // The globals whose cell holds the record a holding binding holds whole, noted at that record's
  // rep: a read of one at that rep is at its storage.
  irGlobalHeld: {[i32]: boolean},
  // The padding a valued body needs at its end, as the builder found it: "" (it leaves on every
  // path), "null" (a live fall-through returns null) or "unreachable" (a dead one).
  irEndPad: string,
  // The width retags' declared supertype pairs the builder found (`recSubAdmit`), `src, dst` rep ids
  // flat in turn.
  irRecSub: i32[],
  irSpanAst: i32[],
  irSpanFirst: i32[],
  irSpanLast: i32[],
  // The row kind each span banks: 5 for a statement, 1 for a start function's top-level item.
  irSpanKind: i32[],
  // The first `local` variable at each wasm slot, so a slot's lookup is not a scan of every variable.
  irLocalAt: {[i32]: i32},
  // The spans opening at each node, in note order, so lowering a node does not scan every span.
  irSpansAt: {[i32]: i32[]},
  // How many spans end at each node, so closing a node's spans scans only past them.
  irSpanEnds: {[i32]: i32},
  // The node an element read's row opens at, by the read's node, where its receiver's build began
  // with a statement; and the set of those nodes, whose start the lowering notes.
  irIdxRowAt: {[i32]: i32},
  irRowOpens: {[i32]: boolean},
  irHasRowOpens: boolean,
  // The assignment whose writing opens at each node whose right side may be an append site: the
  // lowering asks legacy's site arm there, as `emitAssignUnder` does, which mints its global pair.
  irSiteArmAt: {[i32]: i32},
  irHasSiteArms: boolean,
  // The spread literal whose groups' writing opens at each node, where the builder found its list
  // pair unminted: the lowering asks the pair there, before the groups, as `emitArrSpread` does.
  irSpreadPair: {[i32]: SpreadPairNote},
  // The variable each name read the builder took as a plain read of it, by the read's node.
  irReadVar: {[i32]: i32},
  // The union map read a delivery is building where legacy's box ladder reads it past `emitExpr`
  // (`unionBoxArgReadsMapBox`), banking no element-read row; -1 at any other.
  irUnbankedRead: i32,
  // A global read the builder built, by the read's node: written again as it stands.
  irReadAgain: {[i32]: Rhs},
  // The box read a global's narrowed unbox in `irReadAgain` takes when written again, by the read's
  // node: the global's read, in place of the box temp its first read consumed.
  irReadBoxed: {[i32]: Rhs},
  // The box temp each such read's temp reads, by that temp: a skip of the read consumes it first.
  irSkipBase: {[i32]: i32},
  // A list read the builder built at a node over a variable or an immediate, written again as built.
  irReadElem: {[i32]: Rhs},
  // How many times the lowering has read the receiver of the literal arms it is writing.
  irLitReads: i32,
  // The plain field reads the builder built, by the read's node: its object read again, then the
  // field. With `irReadVar` and `irReadAgain`, how the loop prologue reads its receivers.
  irReadField: {[i32]: i32},
  // The standalone `?.` reads the builder built over a chain root it reads again, by the read's
  // node: the whole read written again, as legacy re-emits a `?.` receiver.
  irReadOpt: {[i32]: ROptRead},
  // The declaration-time address-fold rows the builder derived, in legacy's order: each qualifying
  // `const`'s node, the wasm local holding its bounded part, and its folded constant.
  irMaDecl: i32[],
  irMaSlot: i32[],
  irMaK: i64[],
  // The call temps legacy writes with its tail-call cursor disarmed (a tag dispatch's arm), so a
  // `return` of one keeps `call; return`.
  irNoTail: i32[],
  // The effect nodes, a statement dispatch's arms, whose call legacy writes with its tail-call
  // cursor disarmed, so a call in tail position keeps its plain form.
  irNoTailEff: i32[],
}

// Whether effect node `id` is one `irNoTailEff` names.
export function irNoTailEffHas(f: IrFn, id: i32): boolean {
  for t in f.irNoTailEff {
    if t == id { return true }
  }
  return false
}

// Whether call temp `v` is one `irNoTail` names.
export function irNoTailHas(f: IrFn, v: i32): boolean {
  for t in f.irNoTail {
    if t == v { return true }
  }
  return false
}

// Whether `f` is built once, so no instance re-builds it at other reps: a start body, or a function
// the builder found has one instance (`irBuiltOnce`).
export function irFnBuiltOnce(f: IrFn): boolean {
  return f.irName == "@start" || f.irName == "@init" || f.irBuiltOnce
}

export function irFnNew(at: i32, name: string): IrFn {
  const f: IrFn = {
    irNodes: [],
    irNodeTy: [],
    irNodeRep: [],
    irNodeAt: [],
    irTailLinks: [],
    irVars: [],
    irBody: [],
    irParams: [],
    irRetRep: -1,
    irRetTy: -1,
    irAt: at,
    irName: name,
    irPoolFill: false,
    irHelper: false,
    irFragment: false,
    irThunk: false,
    irRetFromRep: false,
    irBuiltOnce: false,
    irRetExtra: [],
    irSigFn: [],
    irSigParams: [],
    irSigRet: [],
    irGlobalSym: [],
    irGlobalRep: [],
    irGlobalAt: Map(),
    irRecHeap: Map(),
    irVarHeap: Map(),
    irVarRow: Map(),
    irRowRep: Map(),
    irCloFieldRetag: Map(),
    irPushRecv: Map(),
    irGlobalStoreTy: Map(),
    irFactTy: Map(),
    irFactInt: Map(),
    irFactKidTy: Map(),
    irRepValtype: Map(),
    irVarHeldIds: Map(),
    irGlobalHeld: Map(),
    irEndPad: "",
    irRecSub: [],
    irSpanAst: [],
    irSpanFirst: [],
    irSpanLast: [],
    irSpanKind: [],
    irLocalAt: Map(),
    irSpansAt: Map(),
    irSpanEnds: Map(),
    irIdxRowAt: Map(),
    irRowOpens: Map(),
    irHasRowOpens: false,
    irSiteArmAt: Map(),
    irHasSiteArms: false,
    irSpreadPair: Map(),
    irReadVar: Map(),
    irUnbankedRead: -1,
    irNoTail: [],
    irNoTailEff: [],
    irReadAgain: Map(),
    irReadBoxed: Map(),
    irSkipBase: Map(),
    irReadElem: Map(),
    irLitReads: 0,
    irReadField: Map(),
    irReadOpt: Map(),
    irMaDecl: [],
    irMaSlot: [],
    irMaK: [],
  }
  return f
}

// Appends a variable to `f` and returns its id.
export function irVarNew(
  f: IrFn,
  rep: i32,
  ty: i32,
  kind: VarKind,
  slot: i32,
): i32 {
  f.irVars.push({ vRep: rep, vTy: ty, vKind: kind, vSlot: slot })
  const v = f.irVars.length - 1
  if kind == "local" && slot >= 0 && (f.irLocalAt[slot] ?? -1) < 0 {
    f.irLocalAt[slot] = v
  }
  return v
}

// Appends node `n` with its header fields to `f`'s arena and returns its id; the caller places
// the id in a body.
export function irNodeNew(f: IrFn, n: IrNode, ty: i32, rep: i32, at: i32): i32 {
  f.irNodes.push(n)
  f.irNodeTy.push(ty)
  f.irNodeRep.push(rep)
  f.irNodeAt.push(at)
  return f.irNodes.length - 1
}

// The signature `f` records for callee `fnPos`: its index into `irSig*`, or -1 for none.
export function irSigOf(f: IrFn, fnPos: i32): i32 {
  let i = 0
  while i < f.irSigFn.length {
    if f.irSigFn[i] == fnPos { return i }
    i = i + 1
  }
  return -1
}

// Records callee `fnPos`'s parameter and result reps once.
export function irSigNote(f: IrFn, fnPos: i32, params: i32[], ret: i32) {
  if irSigOf(f, fnPos) >= 0 { return 0 }
  f.irSigFn.push(fnPos)
  f.irSigParams.push(params)
  f.irSigRet.push(ret)
  return 0
}

// Records that source statement `ast` built the nodes from `first` to `last` of one body.
export function irSpanNote(f: IrFn, ast: i32, first: i32, last: i32) {
  // At module scope (the start function) a statement's row is kind 1, as `bankBodyStmtSpan` banks.
  const kind = if f.irAt < 0 { 1 } else { 5 }
  return irSpanNoteKind(f, ast, first, last, kind)
}

// A span of row kind `kind` over AST node `ast`, from node `first` to node `last`.
export function irSpanNoteKind(
  f: IrFn,
  ast: i32,
  first: i32,
  last: i32,
  kind: i32,
) {
  f.irSpanAst.push(ast)
  f.irSpanFirst.push(first)
  f.irSpanLast.push(last)
  f.irSpanKind.push(kind)
  const at = f.irSpansAt[first] ?? []
  at.push(f.irSpanAst.length - 1)
  f.irSpansAt[first] = at
  f.irSpanEnds[last] = (f.irSpanEnds[last] ?? 0) + 1
  return 0
}

// The heap `f` noted for record rep `r`, or -1 for none.
export function irRecHeapOf(f: IrFn, r: i32): i32 {
  return f.irRecHeap[r] ?? -1
}

// Whether temp `v` is read inside a `.push` receiver (`irPushRecvNote`).
export function irPushRecvAt(f: IrFn, v: i32): boolean {
  return f.irPushRecv[v] ?? false
}

// Notes temp `v` as built inside a `.push` receiver.
export function irPushRecvNote(f: IrFn, v: i32) {
  f.irPushRecv[v] = true
  return 0
}

// Whether `f` noted retag node `id` as a closure stored at a plainly written record field.
export function irCloFieldRetagAt(f: IrFn, id: i32): boolean {
  return f.irCloFieldRetag[id] ?? false
}

// Notes retag node `id` as a closure stored at a plainly written record field.
export function irCloFieldRetagNote(f: IrFn, id: i32) {
  f.irCloFieldRetag[id] = true
  return 0
}

// The struct row record temp `v` is built at (`irVarHeapNote`), or -1 for none.
export function irVarHeapOf(f: IrFn, v: i32): i32 {
  return f.irVarHeap[v] ?? -1
}

// The struct row record variable `v` is laid out at (`irVarRowNote`), or -1 for none.
export function irVarRow(f: IrFn, v: i32): i32 { return f.irVarRow[v] ?? -1 }

// The struct row operand `o` is laid out at: its variable's (`irVarRow`), or -1 for an immediate.
export function irOpRow(f: IrFn, o: Opnd): i32 {
  return if o is OVar && o.ov >= 0 { irVarRow(f, o.ov) } else { -1 }
}

// Notes record variable `v` as laid out at struct row `row`, whose rep is `rr`, once.
export function irVarRowNote(f: IrFn, v: i32, row: i32, rr: i32) {
  if row >= 0 && (f.irVarRow[v] ?? -1) == -1 {
    f.irVarRow[v] = row
    f.irRowRep[row] = rr
  }
  return 0
}

// The rep struct row `row` is laid out at (`irVarRowNote`), or -1 where no variable is noted there.
export function irRowRepOf(f: IrFn, row: i32): i32 {
  return f.irRowRep[row] ?? -1
}

// Notes record temp `v` as built at struct row `row`, whatever heap its rep notes.
export function irVarHeapNote(f: IrFn, v: i32, row: i32) {
  if row >= 0 { f.irVarHeap[v] = row }
  return 0
}

// Notes record rep `r` stored at heap `h`, once.
export function irRecHeapNote(f: IrFn, r: i32, h: i32) {
  if (f.irRecHeap[r] ?? -1) == -1 { f.irRecHeap[r] = h }
  return 0
}

// Notes heap `h` for rep `r` as one source's answer: a second answer that differs leaves `r` with
// no heap (-2), which no later note fills.
export function irRecHeapNoteOne(f: IrFn, r: i32, h: i32) {
  if h < 0 { return 0 }
  const cur = f.irRecHeap[r] ?? -1
  if cur == -1 { f.irRecHeap[r] = h }
  else if cur != h { f.irRecHeap[r] = -2 }
  return 0
}

// The rep `f` records for global `sym`, or -1 for none.
export function irGlobalRepOf(f: IrFn, sym: i32): i32 {
  const i = f.irGlobalAt[sym] ?? -1
  return if i >= 0 && i < f.irGlobalRep.length { f.irGlobalRep[i] } else { -1 }
}

// The storage-row type the builder took global `sym` at, or -1 where it took none.
export function irGlobalStoreTyOf(f: IrFn, sym: i32): i32 {
  return f.irGlobalStoreTy[sym] ?? -1
}

// Records that the builder took global `sym` at its storage row, of type `ty`.
export function irGlobalStoreNote(f: IrFn, sym: i32, ty: i32) {
  f.irGlobalStoreTy[sym] = ty
  return 0
}

// The checked type the builder noted for node `i`'s read, or -1.
export function irFactTyOf(f: IrFn, i: i32): i32 { return f.irFactTy[i] ?? -1 }

// The int the builder noted for node `i`, else `d`: a memory op's void (1) or value (0), a literal
// arms test's read count, a narrowed map read's unbox (1) or not (0), and a `null`'s kind (1 the
// null box, 0 the bottom ref, 2 another).
export function irFactIntOf(f: IrFn, i: i32, d: i32): i32 {
  return f.irFactInt[i] ?? d
}

// The site types the builder noted per layout position for record node `i`, or none.
export function irFactKidTyOf(f: IrFn, i: i32): i32[] {
  return f.irFactKidTy[i] ?? []
}

// Records global `sym`'s rep once.
export function irGlobalNote(f: IrFn, sym: i32, rep: i32) {
  if irGlobalRepOf(f, sym) >= 0 { return 0 }
  f.irGlobalAt[sym] = f.irGlobalSym.length
  f.irGlobalSym.push(sym)
  f.irGlobalRep.push(rep)
  return 0
}

// Whether `body` leaves on every path: it ends in a branch, a return or a trap, or in an `if`
// both of whose arms leave. A loop is never counted as leaving. An `else` is followed along the
// spine, not recursed into (D1990).
export function irBodyLeaves(f: IrFn, body: i32[]): boolean {
  let cur = body
  while true {
    if cur.length == 0 { return false }
    const last = cur[cur.length - 1]
    if last < 0 || last >= f.irNodes.length { return false }
    const n = f.irNodes[last]
    match n {
      SBr | SReturn | STrap => {
        return true
      }
      SIf => {
        if !irBodyLeaves(f, n.siThen) { return false }
        cur = n.siElse
      }
      SIntSwitch => {
        for a in n.isArms {
          if !irBodyLeaves(f, a) { return false }
        }
        cur = n.isElse
      }
      SArmSite |
        SArmWrite |
        SAssign |
        SBlock |
        SBoundsCheck |
        SCellSet |
        SCoalBox |
        SDrop |
        SEffect |
        SForIn |
        SGlobalSet |
        SLet |
        SListSet |
        SLoop |
        SRangeLoop |
        SRawOp |
        SSetField |
        SSwitch => {
        return false
      }
    }
  }
}

// Whether node `n` ends its path: a trap, or the effect of a call that never returns.
export function irNodeEndsPath(n: IrNode): boolean {
  if n is STrap { return true }
  if !(n is SEffect) { return false }
  const r = n.efRhs
  return match r {
    RCall => r.caNever
    RCallHost => r.chNever
    RCallRef => r.crNever
    RCallRefHead => false
    // A dead call writes `unreachable`.
    RDeadNever => true
    RAfterEffects |
      RArmUnbox |
      RAsTail |
      RAsUnion |
      RAsgParked |
      RAsgUnwiden |
      RAtomEq |
      RAtomSole |
      RAtomStr |
      RAtomWide |
      RAtomic |
      RBoxField |
      RBoxNarrow |
      RBundlePick |
      RCast |
      RCellGet |
      RCellNew |
      RCloTag |
      RClosureEq |
      RCoalAtomStr |
      RCoalStr |
      RCoerce |
      RDeadNullTest |
      REnvDrop |
      REnvGet |
      REqHelp |
      RFieldNull |
      RFnId |
      RGetField |
      RGlobalGet |
      RHandPick |
      RHolderPick |
      RHoleOptBox |
      RIdentityEq |
      RInitProgress |
      RIsStaged |
      RJoinNull |
      RListCat |
      RListClear |
      RListCopy |
      RListEmpty |
      RListEmptyArms |
      RListEq |
      RListFitIs |
      RListGet |
      RListIsAcross |
      RListLen |
      RListNew |
      RListNewDefault |
      RListPop |
      RListPush |
      RListPushMany |
      RListSlice |
      RListStage |
      RLitArms |
      RMaFoldInit |
      RMakeClo |
      RMakeList |
      RMakeRec |
      RMapClear |
      RMapDelete |
      RMapEq |
      RMapFilter |
      RMapFilterHead |
      RMapGet |
      RMapGetOr |
      RMapHas |
      RMapIter |
      RMapNew |
      RMapOp |
      RMapSet |
      RMemAccess |
      RMemOp |
      RNicheRead |
      RNulNicheEq |
      RNulNoneBox |
      RNulTest |
      RNullOf |
      RNumCast |
      RNumIntr |
      RNumIs |
      RNumUnionBin |
      RNumUnionConvert |
      RNumWiden |
      ROptRead |
      RPrimOp |
      RPrint |
      RPrintOpen |
      RRawOp |
      RRecCopyPure |
      RRecDown |
      RRecordFitIs |
      RRecover |
      RRel |
      RResultPick |
      RRetNull |
      RRetag |
      RSharedFieldSet |
      RSharedRead |
      RSimd |
      RSpread |
      RStage |
      RStashSet |
      RStrOp |
      RStrToAtom |
      RStrToAtomStaged |
      RStructEq |
      RTagClo |
      RTagIs |
      RTagOf |
      RTagStash |
      RTest |
      RToBox |
      RTruncSat |
      RUnionConcreteEq |
      RUnionEq |
      RUnionNumCrossEq |
      RUnionStage |
      RUnionStagedEq |
      RUnionVariantEq |
      RVariantChain |
      RVariantDiscrim => false
  }
}

// Whether a map of rep `mrep` holds a ref niche (discipline 1) whose non-null value is rep `out`:
// the value a `??` read over that niche yields.
export function mapNicheReadsAt(mrep: i32, out: i32): boolean {
  const mr = repNodeAt(mrep)
  if !(mr is RMap) { return false }
  const v = repNodeAt(mr.rmVal)
  return v is RNullable && v.rnDisc == 1 && v.rnInner == out
}

// Whether a map of rep `mrep` holds a boxed nullable union (discipline 4) whose `??` read is rep
// `out`: the value's rep itself under a nullable default, else the box inside it.
export function mapBoxReadsAt(mrep: i32, out: i32): boolean {
  const mr = repNodeAt(mrep)
  if !(mr is RMap) { return false }
  const v = repNodeAt(mr.rmVal)
  return v is RNullable
    && v.rnDisc == 4
    && (out == mr.rmVal || out == v.rnInner)
}

// Whether rep `r` is held as an `i32`: an `i32` or `boolean`, a literal-union atom, or its
// `K | null` (discipline 3) or `boolean | null` (discipline 2) niche.
export function repHeldAsI32(r: i32): boolean {
  const p = repPrim(r)
  if p == "i32" || p == "bool" { return true }
  const n = repNodeAt(r)
  return n is RAtom || n is RNullable && (n.rnDisc == 2 || n.rnDisc == 3)
}

// Whether rep `r` is the `boolean | null` niche (discipline 2): an i32 cell, `2` for null.
export function repBoolNiche(r: i32): boolean {
  const n = repNodeAt(r)
  return n is RNullable && n.rnDisc == 2 && repPrim(n.rnInner) == "bool"
}

// Whether a value at rep `src` is already one of rep `dst` with nothing written: the `null` unit's
// bottom ref into a rep that lowers to a nullable reference (`ref null $T`, discipline 1). A niche
// nullable (an atom's `-1`, a boolean's `2`, a box's null tag) encodes its null, so it is no such rep.
export function repNullRefFits(src: i32, dst: i32): boolean {
  const d = repNodeAt(dst)
  return repPrim(src) == "null" && d is RNullable && d.rnDisc == 1
}

// The rep a values walk of map rep `m` (or a nullable map) binds, its value (`rmVal`); -1 when `m`
// is no map. A key is no part of a map rep, so a keys walk's rep is recorded on the walk.
export function mapWalkValRep(m: i32): i32 {
  const n = repNodeAt(m)
  const c = if n is RNullable { n.rnInner } else { m }
  const cn = repNodeAt(c)
  return if cn is RMap { cn.rmVal } else { -1 }
}

// Whether rep `r` is one a map key is held at: an `i32`, an `i64`, a string or an atom.
export function mapKeyRep(r: i32): boolean {
  const p = repPrim(r)
  return p != null && (p == "i32" || p == "i64" || p == "str")
    || repNodeAt(r) is RAtom
}

// The union box rep `r` holds: the box under any boxed nullables (discipline 4, whose `null` is
// one more tag of the same box), else `r`.
export function repBoxCore(r: i32): i32 {
  let c = r
  let n = repNodeAt(c)
  while n is RNullable && n.rnDisc == 4 {
    c = n.rnInner
    n = repNodeAt(c)
  }
  return c
}

// Rep `r`'s primitive when it is an unpacked primitive leaf, else null.
export function repPrim(r: i32): RpPrim | null {
  const n = repNodeAt(r)
  if n == null { return null }
  return match n {
    RPrim => if n.rpPacked != 0 { null } else { n.rpK }
    RAtom |
      RBox |
      RClosure |
      RList |
      RMap |
      RNoValue |
      RNullable |
      RRaw |
      RRecord |
      RUnsup => null
  }
}

// Whether rep `r` is a sub-word storage width: a `u8`, or a packed row (a `flat` record's
// `i8`, `u16` or `i16` field). Such a slot takes a plain i32, which its store truncates.
export function repSubWord(r: i32): boolean {
  const n = repNodeAt(r)
  return n is RPrim && (n.rpK == "u8" || n.rpPacked != 0)
}

// Whether rep `r` is a value rep a variable may hold: a primitive I1 lowers.
export function repIsScalar(r: i32): boolean {
  const p = repPrim(r)
  return p == "i32" || p == "i64" || p == "f64" || p == "f32" || p == "bool"
}

export function repIsNoValue(r: i32): boolean {
  return repNodeAt(r) is RNoValue
}

// Rep `r` for a reader: its primitive or its node's kind, `?` outside the tree.
export function repWhat(r: i32): string {
  const n = repNodeAt(r)
  if n == null { return "?" }
  return match n {
    RPrim => n.rpK
    RAtom => "atom"
    RList => "list"
    RMap => "map"
    RBox => "box"
    RClosure => "closure"
    RRecord => "record"
    RNullable => "nullable"
    RUnsup => "unsup"
    RNoValue => "novalue"
    RRaw => "raw"
  }
}

function repText(r: i32): string { return repWhat(r) + "#" + i32ToStr(r) }

// A map operation's receiver: global `sym`, or receiver operand `loc` where `sym` is -1.
function mapRecvText(sym: i32, loc: Opnd): string {
  if sym >= 0 { return "global " + i32ToStr(sym) }
  return opndText(loc)
}

// Pushes the bodies node `id` holds onto the walk, last first, so they are walked in order.
export function irPushBodies(f: IrFn, id: i32, bodies: i32[][], pos: i32[]) {
  if id < 0 || id >= f.irNodes.length { return 0 }
  const n = f.irNodes[id]
  match n {
    SBlock => {
      bodies.push(n.bkBody)
      pos.push(0)
    }
    SLoop => {
      bodies.push(n.lpBody)
      pos.push(0)
    }
    SForIn => {
      bodies.push(n.xfBody)
      pos.push(0)
    }
    SRangeLoop => {
      bodies.push(n.rlTail)
      pos.push(0)
      for c in n.rlCopies {
        bodies.push(c)
        pos.push(0)
      }
    }
    SIf => {
      bodies.push(n.siElse)
      pos.push(0)
      bodies.push(n.siThen)
      pos.push(0)
    }
    SCoalBox => {
      bodies.push(n.cbNull)
      pos.push(0)
      bodies.push(n.cbLB)
      pos.push(0)
    }
    SArmSite => {
      let k = n.saArms.length - 1
      while k >= 0 {
        bodies.push(n.saArms[k])
        pos.push(0)
        k = k - 1
      }
    }
    SArmWrite => {
      let k = n.awArms.length - 1
      while k >= 0 {
        bodies.push(n.awArms[k])
        pos.push(0)
        k = k - 1
      }
    }
    SSwitch => {
      let k = n.swArms.length - 1
      while k >= 0 {
        bodies.push(n.swArms[k].swBody)
        pos.push(0)
        k = k - 1
      }
    }
    SIntSwitch => {
      bodies.push(n.isElse)
      pos.push(0)
      let k = n.isArms.length - 1
      while k >= 0 {
        bodies.push(n.isArms[k])
        pos.push(0)
        k = k - 1
      }
    }
    SAssign |
      SBoundsCheck |
      SBr |
      SCellSet |
      SDrop |
      SEffect |
      SGlobalSet |
      SLet |
      SListSet |
      SRawOp |
      SReturn |
      SSetField |
      STrap => {}
  }
  return 0
}

// A push's operands: its value, and its receiver unless a stage holds it.
function pushOpnds(r: RListPush): Opnd[] {
  const v = r.lpV
  return match v {
    PStaged => [r.lpX]
    OVar | OImm | OStr => [v, r.lpX]
  }
}

function pushRecvText(v: PushRecv): string {
  return match v {
    PStaged => "staged@" + i32ToStr(v.pstNode)
    OVar | OImm | OStr => opndText(v)
  }
}

function opndText(o: Opnd): string {
  return match o {
    OVar => "v" + i32ToStr(o.ov)
    OImm => {
      const b = o.oiBits
      if b >= -2147483648 && b <= 2147483647 {
        return repWhat(o.oiRep) + " " + i32ToStr(b as% i32)
      }
      repWhat(o.oiRep) + " <wide>"
    }
    OStr => "str@" + i32ToStr(o.osAt)
  }
}

function opndsText(os: Opnd[]): string {
  let s = ""
  for o in os {
    if s != "" { s = s + ", " }
    s = s + opndText(o)
  }
  return s
}

// `a` then `b`, as one list.
function opndsCat(a: Opnd[], b: Opnd[]): Opnd[] {
  const out: Opnd[] = []
  for o in a { out.push(o) }
  for o in b { out.push(o) }
  return out
}

// The operands right-hand side `r` reads, in no promised order: what a temp's definition
// consumes, for a pass that needs which temps another temp's value is built from.
export function irRhsOpnds(r: Rhs): Opnd[] {
  return match r {
    RPrimOp => r.poArgs
    RCall => opndsCat(r.caCaps, r.caArgs)
    RCallRef => opndsCat([r.crFn], r.crArgs)
    RCallRefHead => [r.chFn]
    RCallHost => r.chArgs
    RTest => [r.teV]
    RRecordFitIs => [r.rfV]
    RVariantChain => [r.vcV]
    RVariantDiscrim => [r.vdV]
    RBoxField => [r.bfV]
    RSharedFieldSet => opndsCat([r.shR], r.shVs)
    RSharedRead => [r.srV]
    RBoxNarrow => [r.bnV]
    RNicheRead => [r.nrV]
    RRecCopyPure => r.rpV
    RRecover => [r.rcV]
    RCast => [r.ctV]
    RTagOf => [r.tgV]
    RMakeRec => r.mrFields
    RGetField => [r.gfV]
    RMakeList => r.mlElems
    RSpread => r.spSrcs
    RListNew => [r.lnLen, r.lnFill]
    RListNewDefault => [r.ldLen]
    RListCopy => r.lcArgs
    RMemAccess => r.mmArgs
    RMaFoldInit => [r.mfiV]
    RAtomic => r.amArgs
    RTruncSat => [r.tsV]
    RMemOp => r.moArgs
    RListGet => [r.lgV, r.lgIx]
    RListLen => [r.llV]
    RListPush => pushOpnds(r)
    RListPushMany => [r.pmV, r.pmL]
    RListStage => [r.rsgV]
    RListPop => opndsCat([r.lqV], r.lqIx)
    RListClear => [r.lkV]
    RMapFilter => mapFilterOpnds(r)
    RMapFilterHead => [r.mhV]
    RListSlice => opndsCat([r.scV], r.scArgs)
    RMapOp => r.mpArgs
    RMapNew => []
    RMapSet => [r.msLoc, r.msKey, r.msVal]
    RMapGetOr => [r.mgLoc, r.mgKey, r.mgDef]
    RMapGet => [r.mtLoc, r.mtKey]
    RMapHas => [r.mhLoc, r.mhKey]
    RMapClear => [r.mcLoc]
    RMapDelete => [r.mdLoc, r.mdKey]
    RMapEq => [r.mqLoc, r.mqKey, r.mqOther]
    RMapIter => [r.miV]
    RPrint => [r.pnV]
    RPrintOpen => []
    RStrOp => r.soArgs
    RStructEq => opndsCat([r.seL, r.seR], opndsCat(r.seLIx, r.seRIx))
    REqHelp => [r.ehL, r.ehR]
    RNumWiden => [r.nwV]
    ROptRead => [r.orV]
    RNumCast => if r.ncMiss is OVar && r.ncMiss.ov < 0 { [r.ncV] } else { [r.ncV, r.ncMiss] }
    RAsgParked => []
    RRecDown => [r.rdV]
    RAsgUnwiden => [r.uwV]
    RNumIntr => r.nxArgs
    RNumUnionBin => r.nbArgs
    RNumUnionConvert => [r.nuV]
    RNulNoneBox => if r.nnPay { [r.nnV] } else { [] }
    RSimd => r.sdArgs
    RCoalStr => [r.czL, r.czD]
    RCoalAtomStr => [r.zaL, r.zaD]
    RToBox => [r.bxV]
    RHoleOptBox => [r.hxV]
    RDeadNever => []
    RRetag => [r.rgV]
    RAtomStr => [r.sxV]
    RNullOf => r.nuRead
    RFieldNull => []
    RRetNull => []
    RJoinNull => []
    RNulTest => [r.ntV]
    RNulNicheEq => [r.neL, r.neR, r.neR2]
    RAtomEq => [r.aeL, r.aeR]
    RAsUnion => [r.auV]
    RAfterEffects => {
      const os: Opnd[] = []
      for e in r.aeEff { os.push(e) }
      os.push(r.aeV)
      os
    }
    RAsTail => [r.akV]
    RArmUnbox => [r.uaV]
    RTagStash => [r.tgsV]
    RStashSet => [r.ssV]
    RTagIs => []
    RTagClo => [r.tcV]
    RCloTag => [r.ckV]
    RListEmpty => [r.leV]
    RListEmptyArms => [r.lfV]
    RListIsAcross => [r.laV]
    RListFitIs => [r.lsV]
    RLitArms => [r.liV]
    RNumIs => [r.niV]
    RIsStaged => [r.stV, r.stTest]
    RUnionConcreteEq => [r.ucBox, r.ucOther]
    RUnionEq => [r.ueL, r.ueR]
    RUnionVariantEq => [r.uvBox, r.uvOther]
    RUnionStage => [r.usV]
    RUnionStagedEq => []
    RUnionNumCrossEq => [r.ncBox, r.ncOther]
    RListEq => [r.qeL, r.qeR]
    RClosureEq => [r.cqL, r.cqR]
    RIdentityEq => [r.ieL, r.ieR]
    RListCat => [r.ljL, r.ljR]
    RCoerce => [r.cvV]
    RMakeClo => r.mcEnv
    RFnId => []
    RAtomSole => []
    RDeadNullTest => [r.dnV]
    RAtomWide => [r.awV]
    RStrToAtom => r.saReads
    RStrToAtomStaged => [r.zsV]
    RCellNew => [r.cnInit]
    RCellGet => [r.cgCell]
    RGlobalGet => []
    REnvGet => []
    REnvDrop => []
    RInitProgress => []
    RBundlePick => [r.bpV]
    RResultPick => [r.rkV]
    RHandPick => [r.hpV]
    RHolderPick => [r.hkV]
    RRawOp => r.rwArgs
    RRel => []
    RStage => [r.sgV]
  }
}

function rhsText(r: Rhs): string {
  return match r {
    RPrimOp => r.poOp + "(" + opndsText(r.poArgs) + ")"
    RCall => "call f"
      + i32ToStr(r.caCallee)
      + "("
      + opndsText(r.caArgs)
      + ")"
      + (if r.caNever { " never" } else { "" })
    RCallRefHead => "call_ref.head " + opndText(r.chFn)
    RCallRef => "call_ref "
      + opndText(r.crFn)
      + "("
      + opndsText(r.crArgs)
      + ")"
      + (if r.crNever { " never" } else { "" })
    RCallHost => "call_host " + i32ToStr(r.chImport) + "(" + opndsText(r.chArgs) + ")"
    RTest => "is " + opndText(r.teV) + " tag " + i32ToStr(r.teTag)
    RRecordFitIs => "record fit " + opndText(r.rfV)
    RVariantChain => "is " + opndText(r.vcV) + " variant " + i32ToStr(r.vcVi) + " chain"
    RVariantDiscrim => "is " + opndText(r.vdV) + " variant " + i32ToStr(r.vdVi) + " discrim"
    RBoxField => "box_field " + opndText(r.bfV) + " @" + i32ToStr(r.bfAt)
    RSharedFieldSet => "shared_field_set " + opndText(r.shR) + " := " + opndsText(r.shVs)
    RSharedRead => "shared_read "
      + opndText(r.srV)
      + " @"
      + i32ToStr(r.srAt)
      + (if r.srStash { " stash" } else { "" })
    RBoxNarrow => "box_narrow " + opndText(r.bnV) + " @" + i32ToStr(r.bnAt)
    RNicheRead => "niche_read " + opndText(r.nrV) + " @" + i32ToStr(r.nrAt)
    RRecCopyPure => "record copy pure @" + i32ToStr(r.rpAt)
    RRecover => "recover " + opndText(r.rcV) + " @" + i32ToStr(r.rcAt)
    RCast => "as " + opndText(r.ctV) + " " + repText(r.ctTarget) + " " + r.ctOnFail
    RTagOf => "tag " + opndText(r.tgV)
    RMakeRec => "record(" + opndsText(r.mrFields) + ")"
    RGetField => "field " + opndText(r.gfV) + "." + i32ToStr(r.gfIx)
    RMakeList => "list(" + opndsText(r.mlElems) + ")"
    RSpread => "spread(" + opndsText(r.spSrcs) + ")"
    RListNew => "list_new(" + opndText(r.lnLen) + ", " + opndText(r.lnFill) + ")"
    RListNewDefault => "list_new_default(" + opndText(r.ldLen) + ")"
    RListCopy => "list_copy(" + opndsText(r.lcArgs) + ")"
    RMemAccess => "mem_access(" + opndsText(r.mmArgs) + ")"
    RMaFoldInit => "ma_fold_init(" + opndText(r.mfiV) + ", " + i32ToStr(r.mfiSlot) + ")"
    RAtomic => "atomic(" + opndsText(r.amArgs) + ")"
    RTruncSat => "trunc_sat(" + opndText(r.tsV) + ")"
    RMemOp => "mem_op(" + opndsText(r.moArgs) + ")"
    RListGet => "get " + opndText(r.lgV) + "[" + opndText(r.lgIx) + "]"
    RListLen => "len " + opndText(r.llV)
    RListPush => "push " + pushRecvText(r.lpV) + " " + opndText(r.lpX)
    RListPushMany => "push_many " + opndText(r.pmV) + " " + opndText(r.pmL)
    RListStage => "stage_recv " + opndText(r.rsgV)
    RListPop => if r.lqIx.length == 0 { "pop " + opndText(r.lqV) } else { "get " + opndText(r.lqV) + ", " + opndsText(r.lqIx) }
    RListClear => "clear " + opndText(r.lkV)
    RMapFilter => "mapfilter "
      + opndText(r.hfV)
      + ", "
      + opndText(r.hfC)
      + "("
      + opndsText(r.hfEnv)
      + ")"
    RMapFilterHead => "mapfilter_head " + opndText(r.mhV)
    RListSlice => "slice " + opndText(r.scV) + ", " + opndsText(r.scArgs)
    RNumWiden => "widen " + opndText(r.nwV)
    ROptRead => "opt_read "
      + opndText(r.orV)
      + (if r.orTag >= 0 { " is tag " + i32ToStr(r.orTag) } else { "" })
    RNumCast => "cast " + opndText(r.ncV)
    RAsgParked => "asg parked"
    RRecDown => "rec down " + opndText(r.rdV)
    RAsgUnwiden => "unwiden " + opndText(r.uwV)
    RToBox => "box " + opndText(r.bxV)
    RHoleOptBox => "hole opt box " + opndText(r.hxV)
    RDeadNever => "dead never"
    RAtomStr => "atomstr " + opndText(r.sxV)
    RRetag => "retag " + opndText(r.rgV)
    RNullOf => "null"
    RFieldNull => "field null"
    RRetNull => "return null"
    RJoinNull => "join null"
    RNulTest => "isnull " + opndText(r.ntV)
    RNulNicheEq => "nulniche_eq("
      + opndText(r.neL)
      + ", "
      + opndText(r.neR)
      + ", "
      + opndText(r.neR2)
      + ")"
    RAtomEq => "atom.eq " + opndText(r.aeL) + " " + opndText(r.aeR)
    RAsUnion => "as.union " + opndText(r.auV)
    RAfterEffects => "after " + i32ToStr(r.aeEff.length) + " effects " + opndText(r.aeV)
    RAsTail => "as.tail " + opndText(r.akV)
    RArmUnbox => "arm_unbox "
      + opndText(r.uaV)
      + " @"
      + i32ToStr(r.uaAt)
      + (if r.uaCellNul { " cellnul" } else { "" })
      + (if r.uaAsg { " asg" } else { "" })
    RUnionConcreteEq => "union.eqc "
      + (if r.ucStash { "stash " } else { "" })
      + (if r.ucNul { "nul " } else { "" })
      + opndText(r.ucBox)
      + " "
      + opndText(r.ucOther)
    RUnionEq => "union.eq " + opndText(r.ueL) + " " + opndText(r.ueR)
    RUnionVariantEq => "union.eqv " + opndText(r.uvBox) + " " + opndText(r.uvOther)
    RUnionStage => "union.stage " + i32ToStr(r.usOp) + " " + opndText(r.usV)
    RUnionStagedEq => "union.eqs"
    RUnionNumCrossEq => "union.eqx " + opndText(r.ncBox) + " " + opndText(r.ncOther)
    RListEq => "list.eq " + opndText(r.qeL) + " " + opndText(r.qeR)
    RClosureEq => "closure_eq(" + opndText(r.cqL) + ", " + opndText(r.cqR) + ")"
    RIdentityEq => "identity_eq(" + opndText(r.ieL) + ", " + opndText(r.ieR) + ")"
    RListCat => "list.cat " + opndText(r.ljL) + " " + opndText(r.ljR)
    RCoerce => "coerce " + opndText(r.cvV)
    RMapOp => "map." + r.mpOp + "(" + opndsText(r.mpArgs) + ")"
    RMapNew => "map.new"
    RMapSet => "map.set "
      + mapRecvText(r.msSym, r.msLoc)
      + "("
      + opndText(r.msKey)
      + " "
      + opndText(r.msVal)
      + ")"
    RPrint => "print " + opndText(r.pnV)
    RPrintOpen => "print_open " + i32ToStr(r.poArm)
    RCoalStr => "coalesce " + opndText(r.czL) + " " + opndText(r.czD)
    RCoalAtomStr => "coalesce atom " + opndText(r.zaL) + " " + opndText(r.zaD)
    RTagStash => "tag stash " + opndText(r.tgsV)
    RStashSet => "stash set @"
      + i32ToStr(r.ssAt)
      + "."
      + i32ToStr(r.ssFi)
      + " "
      + opndText(r.ssV)
    RTagIs => "tag is " + i32ToStr(r.tgiId)
    RTagClo => "tag clo " + opndText(r.tcV) + " of " + i32ToStr(r.tcFns.length)
    RCloTag => "clo tag " + opndText(r.ckV) + " of " + i32ToStr(r.ckFns.length)
    RListEmpty => "list empty " + opndText(r.leV)
    RListEmptyArms => "list empty arms " + opndText(r.lfV)
    RListIsAcross => "list is across " + opndText(r.laV)
    RListFitIs => "list fit " + opndText(r.lsV)
    RLitArms => "lit arms " + r.liArm + " " + opndText(r.liV)
    RNumIs => "num is " + opndText(r.niV)
    RIsStaged => "is staged " + opndText(r.stV) + " " + opndText(r.stTest)
    RNumIntr => "intrinsic "
      + (if r.nxSel == "op" { i32ToStr(r.nxOp) } else { r.nxSel })
      + "("
      + opndsText(r.nxArgs)
      + ")"
    RNumUnionBin => "num_union(" + opndsText(r.nbArgs) + ")"
    RNumUnionConvert => "num_union_convert " + opndText(r.nuV)
    RNulNoneBox => "nul_none_box " + (if r.nnPay { opndText(r.nnV) } else { "bottom" })
    RSimd => "simd(" + opndsText(r.sdArgs) + ")"
    RMapGetOr => "map.get_or " + mapRecvText(r.mgSym, r.mgLoc) + "[" + opndText(r.mgKey) + "]"
    RMapGet => "map.get " + mapRecvText(r.mtSym, r.mtLoc) + "[" + opndText(r.mtKey) + "]"
    RMapHas => "map.has " + mapRecvText(r.mhSym, r.mhLoc) + "[" + opndText(r.mhKey) + "]"
    RMapClear => "map.clear " + mapRecvText(r.mcSym, r.mcLoc)
    RMapDelete => "map.delete " + mapRecvText(r.mdSym, r.mdLoc) + "[" + opndText(r.mdKey) + "]"
    RMapEq => "map.eq "
      + mapRecvText(r.mqSym, r.mqLoc)
      + "["
      + opndText(r.mqKey)
      + "] "
      + opndText(r.mqOther)
    RMapIter => (if r.miVals { "map.values " } else { "map.keys " })
      + (if r.miOnce { "once " } else { "" })
      + opndText(r.miV)
    RStrOp => "str." + r.soOp + "(" + opndsText(r.soArgs) + ")"
    RStructEq => "struct_eq("
      + opndsText(opndsCat([r.seL, r.seR], opndsCat(r.seLIx, r.seRIx)))
      + ")"
    REqHelp => "eq_helper " + i32ToStr(r.ehRow) + "(" + opndsText([r.ehL, r.ehR]) + ")"
    RMakeClo => "closure f" + i32ToStr(r.mcFn) + "(" + opndsText(r.mcEnv) + ")"
    RFnId => "fn_id " + i32ToStr(r.fiMember)
    RAtomSole => "atom_sole @" + i32ToStr(r.asAt)
    RDeadNullTest => "dead_null_test("
      + opndText(r.dnV)
      + ") "
      + (if r.dnBits == 1 { "true" } else { "false" })
    RAtomWide => "atom_wide(" + opndText(r.awV) + ")"
    RStrToAtom => "str_to_atom(" + opndsText(r.saReads) + ")"
    RStrToAtomStaged => "str_to_atom_staged(" + opndText(r.zsV) + ")"
    RCellNew => "cell " + opndText(r.cnInit)
    RCellGet => "cell_get " + opndText(r.cgCell)
    RStage => "stage " + opndText(r.sgV)
    RRel => "rel " + i32ToStr(r.rlSp) + " " + i32ToStr(r.rlSub) + " " + i32ToStr(r.rlVal)
    RRawOp => r.rwOp
      + " h"
      + i32ToStr(r.rwHeap)
      + " #"
      + i32ToStr(r.rwImm)
      + "("
      + opndsText(r.rwArgs)
      + ")"
    REnvGet => "env " + i32ToStr(r.evSlot)
    REnvDrop => "env drop f" + i32ToStr(r.edFn)
    RInitProgress => "init progress @" + i32ToStr(r.ipOrd)
    RBundlePick => "bundle pick " + opndText(r.bpV)
    RResultPick => "result pick " + opndText(r.rkV)
    RHandPick => "hand pick " + opndText(r.hpV)
    RHolderPick => "holder pick " + opndText(r.hkV)
    RGlobalGet => "global " + i32ToStr(r.ggSym) + (if r.ggNonNull { " nonnull" } else { "" })
  }
}

function indent(d: i32): string {
  let s = ""
  let i = 0
  while i < d {
    s = s + "  "
    i = i + 1
  }
  return s
}

function bodyText(f: IrFn, body: i32[], d: i32): string {
  let s = ""
  for id in body { s = s + nodeText(f, id, d) }
  return s
}

// A fused map read's probe as text: its global and key, or nothing on another arm.
function mapProbeText(mp: MapProbe | null): string {
  if mp == null { return "" }
  const g = if mp.prSym >= 0 { " g" + i32ToStr(mp.prSym) } else { "" }
  return g + "[" + opndText(mp.prKey) + "]"
}

function outText(v: i32): string {
  if v < 0 { return "" }
  return " -> v" + i32ToStr(v)
}

// A `??`'s text at indent `p`, depth `d`: its operand block, the node, its default.
function coalBoxText(f: IrFn, n: SCoalBox, p: string, d: i32): string {
  return bodyText(f, n.cbLB, d)
    + p
    + "coalesce "
    + n.cbArm
    + " "
    + opndText(n.cbL)
    + mapProbeText(n.cbMap)
    + outText(n.cbOut)
    + "\n"
    + bodyText(f, n.cbNull, d + 1)
}

function nodeText(f: IrFn, id: i32, d: i32): string {
  if id < 0 || id >= f.irNodes.length {
    return indent(d) + "<node " + i32ToStr(id) + ">\n"
  }
  const n = f.irNodes[id]
  const p = indent(d)
  return match n {
    SLet => p + "v" + i32ToStr(n.lDst) + " = " + rhsText(n.lRhs) + "\n"
    SAssign => p + "v" + i32ToStr(n.asDst) + " := " + opndText(n.asSrc) + "\n"
    SSetField => p + opndText(n.sfV) + "." + i32ToStr(n.sfIx) + " := " + opndText(n.sfSrc) + "\n"
    SListSet => p
      + opndText(n.lsV)
      + "["
      + opndText(n.lsIx)
      + "] := "
      + opndText(n.lsSrc)
      + "\n"
    SCellSet => p + "cell " + opndText(n.csCell) + " := " + opndText(n.csSrc) + "\n"
    SGlobalSet => p + "global " + i32ToStr(n.gsSym) + " := " + opndText(n.gsSrc) + "\n"
    SBoundsCheck => p + "check " + opndText(n.bcV) + "[" + opndText(n.bcIx) + "]\n"
    SEffect => p + rhsText(n.efRhs) + "\n"
    SBlock => p
      + "block L"
      + i32ToStr(n.bkLabel)
      + outText(n.bkOut)
      + "\n"
      + bodyText(f, n.bkBody, d + 1)
    SLoop => p + "loop L" + i32ToStr(n.lpLabel) + "\n" + bodyText(f, n.lpBody, d + 1)
    SForIn => {
      p
        + "for v"
        + i32ToStr(n.xfVar)
        + (if n.xfVar2 >= 0 { ", v" + i32ToStr(n.xfVar2) } else { "" })
        + " in "
        + opndText(n.xfList)
        + " L"
        + i32ToStr(n.xfBrk)
        + " L"
        + i32ToStr(n.xfCont)
        + (if n.xfMap >= 0 { " map g" + i32ToStr(n.xfMap) } else { "" })
        + "\n"
        + bodyText(f, n.xfBody, d + 1)
    }
    SRangeLoop => {
      let t = p
        + "range v"
        + i32ToStr(n.rlVar)
        + (if n.rlPartial { " partial" } else { " wrap" })
        + "\n"
      let k = 0
      while k < n.rlCopies.length {
        t = t
          + p
          + " copy "
          + i32ToStr(k)
          + " L"
          + i32ToStr(n.rlConts[k])
          + "\n"
          + bodyText(f, n.rlCopies[k], d + 1)
        k = k + 1
      }
      t
        + p
        + " rolled L"
        + i32ToStr(n.rlTailBrk)
        + " L"
        + i32ToStr(n.rlTailCont)
        + "\n"
        + bodyText(f, n.rlTail, d + 1)
    }
    SIf => {
      let s = p
        + "if "
        + opndText(n.siCond)
        + outText(n.siOut)
        + "\n"
        + bodyText(f, n.siThen, d + 1)
      if n.siElse.length > 0 || n.siElseKw {
        s = s + p + "else\n" + bodyText(f, n.siElse, d + 1)
      }
      s
    }
    SCoalBox => coalBoxText(f, n, p, d)
    SArmSite => {
      let s = p
        + "arm_site @"
        + i32ToStr(n.saAt)
        + (if n.saStash { " stash" } else { "" })
      for o in n.saOps { s = s + " " + opndText(o) }
      s = s + outText(n.saOut) + "\n"
      let k = 0
      while k < n.saArms.length {
        s = s
          + p
          + "arm v"
          + i32ToStr(n.saVars[k])
          + "\n"
          + bodyText(f, n.saArms[k], d + 1)
        k = k + 1
      }
      s
    }
    SArmWrite => {
      let s = p
        + "arm_write @"
        + i32ToStr(n.awAt)
        + " "
        + opndText(n.awV)
        + "\n"
      let k = 0
      while k < n.awArms.length {
        s = s
          + p
          + "arm v"
          + i32ToStr(n.awVars[k])
          + "\n"
          + bodyText(f, n.awArms[k], d + 1)
        k = k + 1
      }
      s
    }
    SSwitch => {
      let s = p + "switch v" + i32ToStr(n.swOn) + outText(n.swOut) + "\n"
      for a in n.swArms {
        s = s
          + p
          + "arm "
          + i32ToStr(a.swArm)
          + "\n"
          + bodyText(f, a.swBody, d + 1)
      }
      s
    }
    SIntSwitch => {
      let s = p
        + "intswitch "
        + opndText(n.isOn)
        + outText(n.isOut)
        + " lo "
        + i32ToStr(n.isLo)
      if n.isWide { s = s + " wide" }
      s = s + " table"
      for t in n.isTable { s = s + " " + i32ToStr(t) }
      s = s + "\n"
      let k = 0
      while k < n.isArms.length {
        s = s
          + p
          + "arm "
          + i32ToStr(k)
          + "\n"
          + bodyText(f, n.isArms[k], d + 1)
        k = k + 1
      }
      s + p + "else\n" + bodyText(f, n.isElse, d + 1)
    }
    SBr => {
      if n.brHas {
        return p + "br L" + i32ToStr(n.brLabel) + " " + opndText(n.brVal) + "\n"
      }
      p + "br L" + i32ToStr(n.brLabel) + "\n"
    }
    SReturn => if n.rtHas { p + "return " + opndText(n.rtV) + "\n" } else { p + "return\n" }
    STrap => p + "trap " + i32ToStr(n.tpWhy) + "\n"
    SDrop => p + "drop " + opndText(n.dpV) + "\n"
    SRawOp => p
      + n.srOp
      + " h"
      + i32ToStr(n.srHeap)
      + " #"
      + i32ToStr(n.srImm)
      + "("
      + opndsText(n.srArgs)
      + ")\n"
  }
}

// `f` as text: a header naming each variable's kind and rep, then the body, one node a line.
// The construct family a cutover slice switches to the IR's bytes as one unit (design §10):
// scalar arithmetic, control flow, direct calls, globals, list access, map reads, memory and SIMD
// intrinsics, and the constructs no slice owns yet. `start` is no node's: it claims the start body.
export type IrFamily = "scalar"
  | "control"
  | "call"
  | "global"
  | "list"
  | "map"
  | "box"
  | "record"
  | "closure"
  | "start"
  | "raw"
  | "mem"
  | "other"

export function irNodeFamily(n: IrNode): IrFamily {
  return match n {
    SLet => irRhsFamily(n.lRhs)
    SEffect => irRhsFamily(n.efRhs)
    SAssign |
      SBlock |
      SBr |
      SDrop |
      SForIn |
      SIf |
      SIntSwitch |
      SLoop |
      SRangeLoop |
      SReturn |
      STrap => "control"
    SArmSite | SArmWrite => "box"
    SCoalBox => match n.cbArm {
      "popOr" | "listGetOr" => "list"
      "nulRef" | "boxStash" | "boxRuntime" | "nulAtomJoin" => "box"
      "litUnion" | "nulBool" | "boxFieldScalar" | "nulStr" | "asProp" | "nulBoolJoin" => "box"
      "fieldBox" | "fieldVal" | "optLeaf" | "optBoxLeaf" | "optRecLeaf" => "record"
      "mapIndexGetOr" | "optMapField" => "map"
      "boolPop" | "valBox" | "valScalar" | "valNoKind" | "elem" | "callBox" | "callScalar" | "callNoKind" | "next" => "box"
    }
    SGlobalSet => "global"
    SBoundsCheck | SListSet => "list"
    SSetField => "record"
    SCellSet | SSwitch => "other"
    SRawOp => "raw"
  }
}

export function irRhsFamily(r: Rhs): IrFamily {
  return match r {
    RAfterEffects |
      RAsTail |
      RAsgParked |
      RAsgUnwiden |
      RAtomEq |
      RAtomSole |
      RAtomStr |
      RAtomWide |
      RClosureEq |
      RCoalAtomStr |
      RCoalStr |
      RDeadNever |
      RDeadNullTest |
      REqHelp |
      RHoleOptBox |
      RIdentityEq |
      RIsStaged |
      RJoinNull |
      RLitArms |
      RNulNicheEq |
      RNulTest |
      RNullOf |
      RNumCast |
      RNumIntr |
      RNumIs |
      RNumUnionBin |
      RNumUnionConvert |
      RNumWiden |
      RPrimOp |
      RRecover |
      RRetNull |
      RRetag |
      RStrToAtom |
      RStrToAtomStaged |
      RStructEq |
      RTagIs |
      RTagStash |
      RToBox |
      RUnionConcreteEq |
      RUnionEq |
      RUnionNumCrossEq |
      RUnionStage |
      RUnionStagedEq |
      RUnionVariantEq => "scalar"
    RCall |
      RCallHost |
      RPrint |
      RPrintOpen => "call"
    RGlobalGet | RInitProgress => "global"
    RCoerce |
      RListCat |
      RListClear |
      RListCopy |
      RListEmpty |
      RListEmptyArms |
      RListEq |
      RListFitIs |
      RListGet |
      RListIsAcross |
      RListLen |
      RListNew |
      RListNewDefault |
      RListPop |
      RListPush |
      RListPushMany |
      RListSlice |
      RListStage |
      RMakeList |
      RMapFilter |
      RMapFilterHead |
      RSpread |
      RStrOp => "list"
    RMapClear |
      RMapDelete |
      RMapEq |
      RMapGet |
      RMapGetOr |
      RMapHas |
      RMapIter |
      RMapNew |
      RMapOp |
      RMapSet => "map"
    RArmUnbox |
      RAsUnion |
      RBoxField |
      RBoxNarrow |
      RCast |
      RNicheRead |
      RNulNoneBox |
      RSharedFieldSet |
      RSharedRead |
      RTest => "box"
    RRecordFitIs => "record"
    RVariantChain => "box"
    RVariantDiscrim => "box"
    RFieldNull |
      RGetField |
      RMakeRec |
      ROptRead |
      RRecCopyPure |
      RRecDown |
      RStashSet => "record"
    RBundlePick |
      RCallRef |
      RCallRefHead |
      RCloTag |
      REnvDrop |
      REnvGet |
      RHandPick |
      RHolderPick |
      RMakeClo |
      RResultPick |
      RTagClo => "closure"
    RCellGet |
      RCellNew |
      RFnId |
      RTagOf => "other"
    RAtomic |
      RMaFoldInit |
      RMemAccess |
      RMemOp |
      RSimd |
      RTruncSat => "mem"
    RRawOp | RRel => "raw"
    RStage => "scalar"
  }
}

export function irFnText(f: IrFn): string {
  let s = "fn " + f.irName + " -> " + repText(f.irRetRep) + "\n"
  let i = 0
  while i < f.irVars.length {
    const v = f.irVars[i]
    s = s + "  v" + i32ToStr(i) + ": " + v.vKind + " " + repText(v.vRep) + "\n"
    i = i + 1
  }
  return s + bodyText(f, f.irBody, 1)
}

// The op binary lexeme `op` names, its unsigned form when `uns`; null for an operator another
// arm lowers (assignment, `&&`, `||`, `??`).
export function binPrimOp(op: string, uns: boolean): PrimOp | null {
  if op == "+" { return "add" }
  if op == "-" { return "sub" }
  if op == "*" { return "mul" }
  if op == "/" { return if uns { "divu" } else { "div" } }
  if op == "%" { return if uns { "remu" } else { "rem" } }
  if op == "&" { return "and" }
  if op == "|" { return "or" }
  if op == "^" { return "xor" }
  if op == "<<" { return "shl" }
  if op == ">>" { return if uns { "shru" } else { "shr" } }
  if op == ">>>" { return "shru" }
  if op == "==" { return "eq" }
  if op == "!=" { return "ne" }
  if op == "<" { return if uns { "ltu" } else { "lt" } }
  if op == "<=" { return if uns { "leu" } else { "le" } }
  if op == ">" { return if uns { "gtu" } else { "gt" } }
  if op == ">=" { return if uns { "geu" } else { "ge" } }
  return null
}

// The opcode of `op` over primitive `p`, or -1 where wasm has none (a float `rem`, an int `neg`).
export function primOpcode(op: PrimOp, p: RpPrim): i32 {
  return match p {
    "i32" | "bool" => opI32(op)
    "i64" => opI64(op)
    "f32" => opF32(op)
    "f64" => opF64(op)
    "str" | "u8" | "null" | "v128" => -1
  }
}

function opI32(op: PrimOp): i32 {
  return match op {
    "add" => 0x6a
    "sub" => 0x6b
    "mul" => 0x6c
    "div" => 0x6d
    "divu" => 0x6e
    "rem" => 0x6f
    "remu" => 0x70
    "and" => 0x71
    "or" => 0x72
    "xor" => 0x73
    "shl" => 0x74
    "shr" => 0x75
    "shru" => 0x76
    "eq" => 0x46
    "ne" => 0x47
    "lt" => 0x48
    "ltu" => 0x49
    "gt" => 0x4a
    "gtu" => 0x4b
    "le" => 0x4c
    "leu" => 0x4d
    "ge" => 0x4e
    "geu" => 0x4f
    "not" => 0x45
    "neg" => -1
  }
}

function opI64(op: PrimOp): i32 {
  return match op {
    "add" => 0x7c
    "sub" => 0x7d
    "mul" => 0x7e
    "div" => 0x7f
    "divu" => 0x80
    "rem" => 0x81
    "remu" => 0x82
    "and" => 0x83
    "or" => 0x84
    "xor" => 0x85
    "shl" => 0x86
    "shr" => 0x87
    "shru" => 0x88
    "eq" => 0x51
    "ne" => 0x52
    "lt" => 0x53
    "ltu" => 0x54
    "gt" => 0x55
    "gtu" => 0x56
    "le" => 0x57
    "leu" => 0x58
    "ge" => 0x59
    "geu" => 0x5a
    "not" | "neg" => -1
  }
}

function opF32(op: PrimOp): i32 {
  return match op {
    "add" => 0x92
    "sub" => 0x93
    "mul" => 0x94
    "div" => 0x95
    "eq" => 0x5b
    "ne" => 0x5c
    "lt" => 0x5d
    "gt" => 0x5e
    "le" => 0x5f
    "ge" => 0x60
    "neg" => 0x8c
    "divu" | "rem" | "remu" | "and" | "or" | "xor" | "shl" | "shr" | "shru" | "ltu" | "gtu" | "leu" | "geu" | "not" => -1
  }
}

function opF64(op: PrimOp): i32 {
  return match op {
    "add" => 0xa0
    "sub" => 0xa1
    "mul" => 0xa2
    "div" => 0xa3
    "eq" => 0x61
    "ne" => 0x62
    "lt" => 0x63
    "gt" => 0x64
    "le" => 0x65
    "ge" => 0x66
    "neg" => 0x9a
    "divu" | "rem" | "remu" | "and" | "or" | "xor" | "shl" | "shr" | "shru" | "ltu" | "gtu" | "leu" | "geu" | "not" => -1
  }
}

// The opcode of binary lexeme `op` at `p` in its signed form, or -1 where wasm has none.
export function lexOpcode(op: string, p: RpPrim): i32 {
  const o = binPrimOp(op, false)
  if o == null { return -1 }
  return primOpcode(o, p)
}

// Whether a list at rep `src` is the list at rep `dst` as it stands: the same record, list or map
// elements, or record twins on one heap (`recRetag`), one side's possibly `| null`, which one ref
// list holds (its backing is already nullable).
export function listRetag(src: i32, dst: i32): boolean {
  const a = repNodeAt(src)
  const d = repNodeAt(dst)
  if !(a is RList) || !(d is RList) { return false }
  // A `boolean[]` rides the `i32[]` backing, so either is the other as it stands.
  if i32Backed(a.rlsElem) && i32Backed(d.rlsElem) && a.rlsElem != d.rlsElem {
    return true
  }
  return elemCoresRetag(a.rlsElem, d.rlsElem)
}

// Whether element or value reps `a` and `d` are stored alike: one core (`recElemCore`), or
// record twins on one heap.
function elemCoresRetag(a: i32, d: i32): boolean {
  const ea = recElemCore(a)
  const ed = recElemCore(d)
  return ea >= 0 && (ea == ed || ed >= 0 && recRetag(ea, ed))
}

// Whether element rep `e` is an unpacked `i32` or `bool`, which an `i32[]` backing holds.
function i32Backed(e: i32): boolean {
  const n = repNodeAt(e)
  return n is RPrim && n.rpPacked == 0 && (n.rpK == "i32" || n.rpK == "bool")
}

// Whether a list at rep `src` and one at rep `dst` hold union boxes of one element kind (both
// boxes, or both boxed nullables): every union row twins one wasm list over the one box heap
// (`rlTwinSigOf`), whose tags are program-global, so the one is the other as it stands.
export function boxListRetag(src: i32, dst: i32): boolean {
  const a = repNodeAt(src)
  const d = repNodeAt(dst)
  if !(a is RList) || !(d is RList) { return false }
  const ea = repNodeAt(a.rlsElem)
  const ed = repNodeAt(d.rlsElem)
  if ea is RBox { return ed is RBox }
  return ea is RNullable && ea.rnDisc == 4 && ed is RNullable && ed.rnDisc == 4
}

// Whether a map at rep `src` and one at rep `dst` hold union boxes as values, a box or a boxed
// nullable on either side: one map shape over the one box heap, whose values are nullable refs.
export function boxMapRetag(src: i32, dst: i32): boolean {
  const a = repNodeAt(src)
  const d = repNodeAt(dst)
  if !(a is RMap) || !(d is RMap) || a.rmVal == d.rmVal { return false }
  return boxOrBoxedNullable(a.rmVal) && boxOrBoxedNullable(d.rmVal)
}

function boxOrBoxedNullable(r: i32): boolean {
  const n = repNodeAt(r)
  return n is RBox || n is RNullable && n.rnDisc == 4
}

// Whether a map at rep `src` is the map at rep `dst` as it stands: values stored alike
// (`elemCoresRetag`), one side's possibly `| null`, or union boxes (`boxMapRetag`).
export function mapRetag(src: i32, dst: i32): boolean {
  const a = repNodeAt(src)
  const d = repNodeAt(dst)
  if !(a is RMap) || !(d is RMap) || a.rmVal == d.rmVal { return false }
  return elemCoresRetag(a.rmVal, d.rmVal) || boxMapRetag(src, dst)
}

// Whether a list at rep `src` is the list at rep `dst` as it stands, `dst` leaving a closure's
// parameter or result unknown: a result whose type still holds a hole the value fills.
export function listRetagHole(f: IrFn, src: i32, dst: i32): boolean {
  const a = repNodeAt(src)
  const d = repNodeAt(dst)
  if !(a is RList) || !(d is RList) { return false }
  return repFillsHole(f, a.rlsElem, d.rlsElem, false)
}

// Whether a closure at rep `src`, or a list, map or record holding one, is the value at `dst` as it
// stands: the two differ only where one side leaves a closure's parameter or result unknown, and
// every closure lowers to the one closure struct.
export function cloHoleRetag(f: IrFn, src: i32, dst: i32): boolean {
  if src == dst { return false }
  const a = repNodeAt(src)
  const d = repNodeAt(dst)
  // A map's values, at the top only: `repFillsHole` itself, behind `listRetagHole`, admits none.
  if a is RMap && d is RMap {
    return a.rmVal != d.rmVal && cloHoleRetag(f, a.rmVal, d.rmVal)
  }
  return repFillsHole(f, src, dst, false) || repFillsHole(f, dst, src, false)
}

// Notes, for each record of hole rep `dst` that has no heap, the heap of the record of `src` that
// fills it, walking both alike: a record with an open field has no row of its own, so the value
// stands on its filler's. A second filler on another heap leaves it with none (`irRecHeapNoteOne`).
export function recHoleHeapsNote(f: IrFn, src: i32, dst: i32) {
  return holeHeapsNoteIn(f, src, dst, false)
}

// `recHoleHeapsNote` under a closure (`inClo`), where a field may be left unknown.
function holeHeapsNoteIn(f: IrFn, src: i32, dst: i32, inClo: boolean) {
  const a = repNodeAt(src)
  const d = repNodeAt(dst)
  if src == dst || a == null || d == null { return 0 }
  match d {
    RList => if a is RList { holeHeapsNoteIn(f, a.rlsElem, d.rlsElem, inClo) }
    RNullable => if a is RNullable { holeHeapsNoteIn(f, a.rnInner, d.rnInner, inClo) }
    RMap => if a is RMap { holeHeapsNoteIn(f, a.rmVal, d.rmVal, inClo) }
    RClosure => if a is RClosure && a.rcParams.length == d.rcParams.length {
      let i = 0
      while i < d.rcParams.length {
        holeHeapsNoteIn(f, a.rcParams[i], d.rcParams[i], true)
        i = i + 1
      }
      holeHeapsNoteIn(f, a.rcRet, d.rcRet, true)
    }
    RRecord => if a is RRecord && recHoleFilledBy(f, src, dst, inClo) { irRecHeapNoteOne(f, dst, irRecHeapOf(f, src)) }
    RAtom |
      RBox |
      RNoValue |
      RPrim |
      RRaw |
      RUnsup => 0
  }
  return 0
}

// Whether record `src`, on a noted heap, fills record hole `dst`, which has none: one variant flag,
// the same field names, and each field filling its hole, records among them noted first.
function recHoleFilledBy(f: IrFn, src: i32, dst: i32, inClo: boolean): boolean {
  const a = repNodeAt(src)
  const d = repNodeAt(dst)
  if !(a is RRecord) || !(d is RRecord) || a.rrVariant != d.rrVariant {
    return false
  }
  if (
    irRecHeapOf(f, src) < 0
    || irRecHeapOf(f, dst) != -1
    || recHeapOf(dst) >= 0
  ) {
    return false
  }
  const na = repRecordFieldNames(src)
  const nd = repRecordFieldNames(dst)
  if na.length != nd.length || a.rrFields.length != d.rrFields.length {
    return false
  }
  let i = 0
  while i < nd.length && i < d.rrFields.length {
    if na[i] != nd[i] { return false }
    holeHeapsNoteIn(f, a.rrFields[i], d.rrFields[i], inClo)
    if !repFillsHole(f, a.rrFields[i], d.rrFields[i], inClo) { return false }
    i = i + 1
  }
  return true
}

// Whether rep `src` is `dst`, or `dst` with parts of a closure (`inClo`) left unknown.
function repFillsHole(f: IrFn, src: i32, dst: i32, inClo: boolean): boolean {
  if src == dst { return true }
  const a = repNodeAt(src)
  const d = repNodeAt(dst)
  if a == null || d == null { return false }
  return match d {
    RUnsup => inClo
    RList => a is RList && repFillsHole(f, a.rlsElem, d.rlsElem, inClo)
    RNullable => a is RNullable
      && a.rnDisc == d.rnDisc
      && repFillsHole(f, a.rnInner, d.rnInner, inClo)
    // A record is the value at its heap whatever its fields' reps, and a recursive record's fields
    // lead back to it, so two records are one value exactly where one noted heap stores both.
    RRecord => a is RRecord
      && a.rrVariant == d.rrVariant
      && irRecHeapOf(f, src) >= 0
      && irRecHeapOf(f, src) == irRecHeapOf(f, dst)
    RClosure => a is RClosure
      && a.rcVoid == d.rcVoid
      && repsFillHoles(f, a.rcParams, d.rcParams, true)
      && repFillsHole(f, a.rcRet, d.rcRet, true)
    // Every union lowers to the one box, its tags program-global, so two unions of one member set
    // in either order are one value.
    RBox => a is RBox && sameArmSet(a.rbArms, d.rbArms)
    RAtom |
      RMap |
      RNoValue |
      RPrim |
      RRaw => false
  }
}

// Whether arm lists `a` and `b` hold the same arms, in any order.
function sameArmSet(a: i32[], b: i32[]): boolean {
  if a.length != b.length { return false }
  for x in a {
    if !i32ListHas(b, x) { return false }
  }
  for y in b {
    if !i32ListHas(a, y) { return false }
  }
  return true
}

// Whether each of reps `src` fills the hole of the same-placed rep of `dst`.
function repsFillHoles(
  f: IrFn,
  src: i32[],
  dst: i32[],
  inClo: boolean,
): boolean {
  if src.length != dst.length { return false }
  let i = 0
  while i < src.length {
    if !repFillsHole(f, src[i], dst[i], inClo) { return false }
    i = i + 1
  }
  return true
}

// Whether a record at variant rep `src` is the record at plain rep `dst` as it stands, or a plain
// record the variant: the same fields (a `null` unit one over its nullable), stored on one heap.
export function recRetag(src: i32, dst: i32): boolean {
  const a = repNodeAt(src)
  const d = repNodeAt(dst)
  if !(a is RRecord) || !(d is RRecord) || a.rrVariant == d.rrVariant {
    return false
  }
  const h = recHeapOf(src)
  if h < 0 || h != recHeapOf(dst) { return false }
  if a.rrFields.length != d.rrFields.length { return false }
  let i = 0
  while i < a.rrFields.length {
    const x = a.rrFields[i]
    const y = d.rrFields[i]
    if x != y && !nullUnitOver(x, y) && !nullUnitOver(y, x) { return false }
    i = i + 1
  }
  return true
}

// Whether field rep `b` is the `null` unit over nullable field rep `a`: on one heap the field is
// the nullable's storage, which holds the `null` the unit's type admits alone.
function nullUnitOver(a: i32, b: i32): boolean {
  const y = repNodeAt(b)
  return y is RPrim && y.rpK == "null" && repNodeAt(a) is RNullable
}

// Whether a plain record at rep `src` is the record at plain rep `dst` as it stands: one struct
// heap (`recordHeapOfTy`, legacy's storage of both types, noted in `hs`) and fields that lower alike.
export function recRowRetag(src: i32, dst: i32, hs: {[i32]: i32}): boolean {
  const a = repNodeAt(src)
  const d = repNodeAt(dst)
  if (
    !(a is RRecord)
    || !(d is RRecord)
    || a.rrVariant
    || d.rrVariant
    || src == dst
  ) {
    return false
  }
  const h = heapNotedOr(hs, src)
  if h < 0 || h != heapNotedOr(hs, dst) { return false }
  recHeapsNote(hs, src)
  recHeapsNote(hs, dst)
  return repsLowerAlike(src, dst, hs) || recFieldsWiden(src, dst, hs)
}

// Whether plain record rep `src`, with no heap of its own, held on heap `h` (a list's element storage
// legacy lays out) stands at plain record rep `dst` on `h` as `recRowRetag` admits; where it does,
// `src` is noted at `h` in `hs`, so the retag's check reads the same heap.
export function recRowRetagOn(
  src: i32,
  dst: i32,
  h: i32,
  hs: {[i32]: i32},
): boolean {
  if h < 0 || heapNotedOr(hs, src) >= 0 || heapNotedOr(hs, dst) != h {
    return false
  }
  hs[src] = h
  if recRowRetag(src, dst, hs) { return true }
  hs[src] = -1
  return false
}

// Whether record temp `v` at plain record rep `src`, built at a struct row (`irVarHeapOf`) its rep
// notes no heap for, stands at plain record rep `dst` on that row's heap (`structRowHeap`): fields
// lower alike by name over the heaps noted in `f`. A row with no heap stands nowhere. The note is
// the temp's own, so it says nothing of another value of `src`.
export function recValRetag(f: IrFn, v: i32, src: i32, dst: i32): boolean {
  const a = repNodeAt(src)
  const d = repNodeAt(dst)
  const h = structRowHeap(irVarHeapOf(f, v))
  if (
    !(a is RRecord)
    || !(d is RRecord)
    || a.rrVariant
    || d.rrVariant
    || src == dst
    || h < 0
    || heapNotedOr(f.irRecHeap, src) >= 0
  ) {
    return false
  }
  return h == heapNotedOr(f.irRecHeap, dst)
    && fieldsLowerAlike(src, dst, [src], [dst], f.irRecHeap)
}

// Rep `r`'s heap as noted in `hs`, else its own (`recHeapOf`); -1 for none or a conflicting note.
function heapNotedOr(hs: {[i32]: i32}, r: i32): i32 {
  const n = hs[r] ?? -1
  if n != -1 { return n }
  return recHeapOf(r)
}

// Whether plain record rep `src` stands at plain record rep `dst`, both noted in `hs` at one heap,
// as a narrower view: each field lowers alike, or goes into a nullable field of `dst` as that field's
// inner rep or as `null`. The ref is the same; the row stores the nullable field.
export function recFieldsWiden(src: i32, dst: i32, hs: {[i32]: i32}): boolean {
  const x = repNodeAt(src)
  const y = repNodeAt(dst)
  if !(x is RRecord) || !(y is RRecord) || x.rrVariant || y.rrVariant {
    return false
  }
  const h = hs[src] ?? -1
  if h < 0 || h != (hs[dst] ?? -1) { return false }
  const nb = repRecordFieldNames(dst)
  if (
    repRecordFieldNames(src).length != nb.length
    || x.rrFields.length != y.rrFields.length
  ) {
    return false
  }
  let j = 0
  while j < nb.length && j < y.rrFields.length {
    const i = repRecordKidOf(src, repTyOf(src), nb[j])
    if (
      i < 0
      || i >= x.rrFields.length
      || !fieldWidens(x.rrFields[i], y.rrFields[j], hs)
    ) {
      return false
    }
    j = j + 1
  }
  return true
}

// Whether field rep `a` is stored as field rep `b`: alike, or `b` nullable over `a` or `a` `null`.
function fieldWidens(a: i32, b: i32, hs: {[i32]: i32}): boolean {
  if repsLowerAlike(a, b, hs) { return true }
  const y = repNodeAt(b)
  if !(y is RNullable) { return false }
  const x = repNodeAt(a)
  return repsLowerAlike(a, y.rnInner, hs) || x is RPrim && x.rpK == "null"
}

// Whether record rep `src` stands at record rep `dst`, either one a variant, as one value on one
// heap (`heapNotedOr` over `hs`): same field names, each field alike, widened (`fieldWidens`), or
// a nullable read at `dst` as `null`, which the checker's type says it holds. Fields read by heap.
export function recNullFieldsAlike(
  src: i32,
  dst: i32,
  hs: {[i32]: i32},
): boolean {
  const x = repNodeAt(src)
  const y = repNodeAt(dst)
  if !(x is RRecord) || !(y is RRecord) || src == dst { return false }
  const h = heapNotedOr(hs, src)
  if h < 0 || h != heapNotedOr(hs, dst) { return false }
  const nb = repRecordFieldNames(dst)
  if (
    repRecordFieldNames(src).length != nb.length
    || x.rrFields.length != y.rrFields.length
    || nb.length != y.rrFields.length
  ) {
    return false
  }
  let j = 0
  while j < nb.length {
    const i = repRecordKidOf(src, repTyOf(src), nb[j])
    if i < 0 || i >= x.rrFields.length { return false }
    const a = x.rrFields[i]
    const b = y.rrFields[j]
    const bn = repNodeAt(b)
    const narrowed = repNodeAt(a) is RNullable
      && bn is RPrim
      && bn.rpK == "null"
    if !narrowed && !fieldWidens(a, b, hs) { return false }
    j = j + 1
  }
  return true
}

// Whether a plain record at rep `src` stands at plain rep `dst` as it is, by width, as the builder
// admits it: `dst`'s heap is a declared supertype of `src`'s or of its storage row `srcRow`'s
// (`recordHeapSubOf`), noted in `subs` with both reps' heaps in `hs`, and `recSubRetag` holds.
export function recSubAdmit(
  src: i32,
  srcRow: i32,
  dst: i32,
  hs: {[i32]: i32},
  subs: i32[],
): boolean {
  const a = repNodeAt(src)
  const d = repNodeAt(dst)
  if (
    !(a is RRecord)
    || !(d is RRecord)
    || a.rrVariant
    || d.rrVariant
    || src == dst
  ) {
    return false
  }
  if !recordHeapSubOf(repTyOf(src), srcRow, repTyOf(dst)) { return false }
  if !recSubNoted(subs, src, dst) {
    subs.push(src)
    subs.push(dst)
  }
  recHeapsNote(hs, src)
  recHeapsNote(hs, dst)
  return recSubRetag(src, dst, hs, subs)
}

// Whether `subs` holds the pair `src`, `dst`.
function recSubNoted(subs: i32[], src: i32, dst: i32): boolean {
  let i = 0
  while i + 1 < subs.length {
    if subs[i] == src && subs[i + 1] == dst { return true }
    i = i + 2
  }
  return false
}

// Whether plain record rep `dst` is a declared supertype of plain record rep `src` the builder
// noted (`subs`), whose fields lead `src`'s by name and lower alike over the heaps noted in `hs`.
export function recSubRetag(
  src: i32,
  dst: i32,
  hs: {[i32]: i32},
  subs: i32[],
): boolean {
  const a = repNodeAt(src)
  const d = repNodeAt(dst)
  if (
    !(a is RRecord)
    || !(d is RRecord)
    || a.rrVariant
    || d.rrVariant
    || src == dst
  ) {
    return false
  }
  return recSubNoted(subs, src, dst) && recPrefixLowersAlike(src, dst, hs)
}

// Whether record rep `dst`'s fields, in name order, lead record rep `src`'s and lower alike to
// them, as a wasm supertype's fields lead its subtype's.
function recPrefixLowersAlike(src: i32, dst: i32, hs: {[i32]: i32}): boolean {
  const x = repNodeAt(src)
  const y = repNodeAt(dst)
  const ns = repRecordFieldNames(src)
  const nd = repRecordFieldNames(dst)
  if (
    !(x is RRecord)
    || !(y is RRecord)
    || nd.length >= ns.length
    || nd.length != y.rrFields.length
  ) {
    return false
  }
  let last = ""
  let j = 0
  while j < nd.length {
    const i = repRecordKidOf(src, repTyOf(src), nd[j])
    if (
      i < 0
      || i >= x.rrFields.length
      || !repsLowerAlike(x.rrFields[i], y.rrFields[j], hs)
    ) {
      return false
    }
    if nd[j] > last { last = nd[j] }
    j = j + 1
  }
  for n in ns {
    if repRecordKidOf(dst, repTyOf(dst), n) < 0 && n < last { return false }
  }
  return true
}

// Whether reps `a` and `b` lower to the same valtypes: one scalar class, any two closures or any two
// boxes (each kind is one struct), two records on one struct heap noted in `hs` whose fields, by
// name, lower alike, or the same list, map or nullable shape kid by kid. A pair met again holds.
export function repsLowerAlike(a: i32, b: i32, hs: {[i32]: i32}): boolean {
  return lowerAlikeOn(a, b, [], [], hs)
}

// Notes in `hs` the struct heap (`recHeapOf`) of each record rep reachable from rep `r`, as the
// builder's IR fact that `repsLowerAlike` reads. A rep already noted still has its kids walked.
export function recHeapsNote(hs: {[i32]: i32}, r: i32) {
  const todo: i32[] = [r]
  const seen: {[i32]: boolean} = Map()
  while todo.length > 0 {
    const t = todo.pop() ?? -1
    if t < 0 || (seen[t] ?? false) { continue }
    seen[t] = true
    if repNodeAt(t) is RRecord && (hs[t] ?? -1) == -1 { hs[t] = recHeapOf(t) }
    for k in repNodeKids(t) { todo.push(k) }
  }
  return 0
}

function lowerAlikeOn(
  a: i32,
  b: i32,
  pa: i32[],
  pb: i32[],
  hs: {[i32]: i32},
): boolean {
  if a == b { return true }
  let k = 0
  while k < pa.length {
    if pa[k] == a && pb[k] == b { return true }
    k = k + 1
  }
  const x = repNodeAt(a)
  const y = repNodeAt(b)
  if x == null || y == null { return false }
  pa.push(a)
  pb.push(b)
  const ok = match x {
    RPrim => y is RPrim && primLowersAs(x) == primLowersAs(y) && x.rpPacked == y.rpPacked
    RAtom => y is RAtom
    RNullable => y is RNullable
      && x.rnDisc == y.rnDisc
      && lowerAlikeOn(x.rnInner, y.rnInner, pa, pb, hs)
    RList => y is RList && lowerAlikeOn(x.rlsElem, y.rlsElem, pa, pb, hs)
    RMap => y is RMap && lowerAlikeOn(x.rmVal, y.rmVal, pa, pb, hs)
    RBox => y is RBox
    RClosure => y is RClosure
    RRecord => y is RRecord
      && x.rrVariant == y.rrVariant
      && (hs[a] ?? -1) >= 0
      && (hs[a] ?? -1) == (hs[b] ?? -1)
      && fieldsLowerAlike(a, b, pa, pb, hs)
    RNoValue |
      RRaw |
      RUnsup => false
  }
  pa.pop()
  pb.pop()
  return ok
}

// The valtype class a primitive rep lowers to: `bool` is stored as an `i32`.
function primLowersAs(p: RPrim): string {
  return match p.rpK {
    "bool" => "i32"
    "i32" | "i64" | "f32" | "f64" | "v128" | "str" | "u8" | "null" => p.rpK
  }
}

// A record rep's fields follow its type's spelling, so `b`'s are matched to `a`'s by name.
function fieldsLowerAlike(
  a: i32,
  b: i32,
  pa: i32[],
  pb: i32[],
  hs: {[i32]: i32},
): boolean {
  const x = repNodeAt(a)
  const y = repNodeAt(b)
  const na = repRecordFieldNames(a)
  const nb = repRecordFieldNames(b)
  if (
    !(x is RRecord)
    || !(y is RRecord)
    || na.length != nb.length
    || x.rrFields.length != y.rrFields.length
  ) {
    return false
  }
  let j = 0
  while j < nb.length && j < y.rrFields.length {
    const i = repRecordKidOf(a, repTyOf(a), nb[j])
    if (
      i < 0
      || i >= x.rrFields.length
      || !lowerAlikeOn(x.rrFields[i], y.rrFields[j], pa, pb, hs)
    ) {
      return false
    }
    j = j + 1
  }
  return true
}

// The struct heap a value of record rep `r` is stored at: its type's own (`recordHeapOfTy`), else
// the heap of the row legacy stores it at, asked so it is recorded (`askRecordHeap`); -1 for none.
export function recHeapOf(r: i32): i32 {
  if !(repNodeAt(r) is RRecord) { return -1 }
  const ty = repTyOf(r)
  const h = recordHeapOfTy(ty)
  if h >= 0 { return h }
  return askRecordHeap(ty)
}

// The rep list element `e` is stored at with or without a `| null`, or -1: a record, list, map or
// string its nullable ref backing holds alike, or a boolean or atom its i32 backing holds with the
// null as the niche's sentinel.
function recElemCore(e: i32): i32 {
  const n = repNodeAt(e)
  if n == null { return -1 }
  return match n {
    RAtom |
      RList |
      RMap |
      RRecord => e
    RPrim => if (n.rpK == "str" || n.rpK == "bool") && n.rpPacked == 0 { e } else { -1 }
    RNullable => {
      const i = repNodeAt(n.rnInner)
      const ref = i is RRecord
        || i is RList
        || i is RMap
        || n.rnDisc == 1 && repPrim(n.rnInner) == "str"
      const niche = n.rnDisc == 2 && repPrim(n.rnInner) == "bool"
        || n.rnDisc == 3 && i is RAtom
      if ref || niche { n.rnInner } else { -1 }
    }
    RBox |
      RClosure |
      RNoValue |
      RRaw |
      RUnsup => -1
  }
}
