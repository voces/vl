// `check_elab_cap.vl` — what one elaboration records while it re-checks an instance body: each
// node's type at the instance, and each call's closed bindings. Recording is live only at the
// elaboration's own quiet depth, so a probe nested inside the body records nothing.

import { cwIxCovers } from "./check_write_scan"
import { decDigitsOf } from "./strutil"
import { parenPeelIx } from "./check_places"
import {
  CW_OCC_USE,
  CW_UP_ELEM,
  CW_UP_LETINIT,
  cwBindingOf,
  cwFnCalls,
  cwFnValueDeclOf,
  cwFnValueTargets,
  cwFramedNode,
  cwIxKind,
  cwIxNode,
  cwIxUp,
  cwIxUpKind,
  cwKeyOfDecl,
  cwKeyOfRoot,
  cwLetCalledFnTargets,
  cwLetFnTargets,
  cwLetRepointFnTargets,
  cwLetSlotFnTargets,
  cwListElemFnTargets,
  cwListElemWriteFnTargets,
  cwOccNext,
  cwOccWalk,
  cwParamArgs,
  cwPathFnTargets,
  cwPathFnTargetsFrom,
  cwSlotPath,
  cwSlotValuesFrom,
  cwSlotWrittenValues,
  cwUseCaptures,
  fnDeclIx,
} from "./check_write_scan"
import {
  T,
  TY_I32,
  Ty,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  mkArrayTy,
  mkMapTy,
  mkNullableTy,
  mkObjTy,
  tyArrayElemIx,
  tyFieldTyOf,
  tyHasInferHole,
  tySame,
} from "./check_types"
import { declTyOf } from "./check_nar_store"
import {
  ArrayLit,
  BinExpr,
  Call,
  FieldInit,
  FuncDecl,
  Ident,
  IfStmt,
  Index,
  LetDecl,
  MatchExpr,
  Member,
  ObjLit,
  P,
  Param,
  Paren,
  TypeRef,
  annTsOf,
  i32ToStr,
  nodeAt,
  nodeChildren,
  tsMentionsAnyName,
} from "./ast"
import { curFnDeclIx, inferQuiet, quietDepth } from "./check_cursor"
import { litPinN } from "./check_literals"
import { restoreSlot, scopeVisibleSnapshot } from "./check_scopes"
import { tyHasTyVar } from "./tyquery"
import {
  i32ListHas,
  i32ListIndexOf,
  strListHas,
  strListIndexOf,
} from "./listutil"
import { identArmNote, identDeclOf, identIsArm, nodeSrc } from "./symbols"
import { nodeTyIxOf, nodeTySetGrow } from "./check_node_tys"
import { hdBase, hdRowOf } from "./check_hole_pins"
import { mintReset, rsVoidSplit } from "./check_mint"
import { elabFnSetTy, fnTagged, fvaListCopyReset } from "./check_fn_tag_facts"
export { fnTagTyIsTagged } from "./check_fn_tag_facts"

// Whether an elaboration is recording, and the quiet depth it records at.
export let elabCapOn = false
export let elabCapQuiet = 0

// Node → type, for the elaboration in progress.
export let elabCapTy: {[i32]: i32} = Map()

// Literal → the type it is built at, for the elaboration in progress: its rep stamp there.
export let elabCapRep: {[i32]: i32} = Map()

// Node → the destination type it is delivered at, for the elaboration in progress.
export let elabCapCtx: {[i32]: i32} = Map()

// Node → the union it is delivered into, for the elaboration in progress.
export let elabCapBox: {[i32]: i32} = Map()

// The nodes whose `elabCapBox` record a `??` join wrote, for the elaboration in progress.
export let elabCapBoxJoin: {[i32]: boolean} = Map()

// Literal → the union whose arm it is adopted into, for the elaboration in progress.
export let elabCapRepUnion: {[i32]: i32} = Map()

// Narrowed read → the storage type it reads out of, for the elaboration in progress.
export let elabCapNarrowed: {[i32]: i32} = Map()

// The calls the elaboration in progress bound: call node, its binding names and types.
export let elabCallIx: i32[] = []
export let elabCallN: string[][] = []
export let elabCallT: i32[][] = []
export let elabCallD: i32[] = []

// How many arms of a test the instance makes dead enclose the check now, the nodes recorded
// inside one, and the diagnostics raised outside every one.
export let elabCapDead = 0
export let elabCapDeadIx: {[i32]: boolean} = Map()
export let elabCapDeadDiags = 0
export function elabCapDeadDiagsSet(n: i32) { elabCapDeadDiags = n }
// How many tests the elaboration in progress found dead at its pin without a diagnostic.
export let elabCapDeadTests = 0
// How many tests the elaboration in progress found always true at its pin, and whether the
// statement just checked leaves the rest of its block dead there.
export let elabCapAlwaysTests = 0
export let elabCapDeadRest = false

// Whether a record made now belongs to the elaboration in progress.
export function elabCapLive(): boolean {
  elabCapOn && quietDepth == elabCapQuiet
}

// Whether a type decided now stands: outside every quiet probe and every call's re-check of a
// generic body's constraints, or in an instance's re-check.
export function stampsStand(): boolean {
  (!inferQuiet && !stampsHeld) || elabCapLive()
}

// Set while a call's argument types re-check a generic body's constraints: one call decides no
// build type for a node every instance shares (D14721).
export let stampsHeld = false

export function stampsHeldSet(v: boolean) { stampsHeld = v }

// Opens recording at quiet depth `depth` with empty tables.
export function elabCapBegin(depth: i32) {
  elabCapOn = true
  elabCapQuiet = depth
  elabCapTy = Map()
  elabCapRep = Map()
  elabCapRepUnion = Map()
  elabCapCtx = Map()
  elabCapBox = Map()
  elabCapBoxJoin = Map()
  elabCapNarrowed = Map()
  elabCapDead = 0
  elabCapDeadIx = Map()
  elabCapDeadDiags = 0
  elabCapDeadTests = 0
  elabCapAlwaysTests = 0
  elabCapDeadRest = false
  elabCallIx = []
  elabCallN = []
  elabCallT = []
  elabCallD = []
  elabCbD = []
  elabCbX = []
  elabCbN = []
  elabCbT = []
  0
}

export function elabCapEnd() {
  elabCapOn = false
  0
}

// Records node `ix` at type `t`; a later record of the node wins.
export function elabCapNote(ix: i32, t: i32) {
  if ix < 0 { return 0 }
  elabCapTy[ix] = t
  if elabCapDead > 0 { elabCapDeadIx[ix] = true }
  0
}

// Records the read `ix`, typed `t`, as narrowed out of `store`; a read typed at its storage is none.
export function elabCapNarrowNote(ix: i32, t: i32, store: i32) {
  if ix < 0 { return 0 }
  elabCapNarrowed[ix] = if store >= 0 && store != t { store } else { -1 }
  0
}

// Enters the arm of a test the instance makes dead; whether it is the outermost one.
export function elabCapDeadEnter(): boolean {
  elabCapDead = elabCapDead + 1
  elabCapDead == 1
}

// Leaves that arm; the outermost counts the diagnostics raised since `d0` as dead ones.
export function elabCapDeadLeave(outer: boolean, d0: i32) {
  elabCapDead = elabCapDead - 1
  if outer { elabCapDeadDiags = elabCapDeadDiags + T.diags.length - d0 }
  0
}

// Notes a test the instance makes dead whose refusal the re-check does not raise.
export function elabCapDeadTestNote() {
  elabCapDeadTests = elabCapDeadTests + 1
  0
}

// Notes a test the instance makes always true.
export function elabCapAlwaysTestNote() {
  elabCapAlwaysTests = elabCapAlwaysTests + 1
  0
}

export function elabCapDeadRestSet(v: boolean) { elabCapDeadRest = v }

// After a block's statement: opens the dead rest of the block when that statement left one,
// answering the diagnostic mark to close it at; `mark` unchanged when one is open or none is due.
export function elabDeadRestOpen(mark: i32): i32 {
  if !elabCapDeadRest { return mark }
  elabCapDeadRest = false
  if mark >= 0 || !elabCapLive() { return mark }
  elabCapDead = elabCapDead + 1
  T.diags.length
}

// At the block's end: closes a dead rest `elabDeadRestOpen` opened at `mark`.
export function elabDeadRestClose(mark: i32) {
  if mark < 0 { return 0 }
  elabCapDead = elabCapDead - 1
  if elabCapDead == 0 {
    elabCapDeadDiags = elabCapDeadDiags + T.diags.length - mark
  }
  0
}

// Records call `ix`'s bindings.
export function elabCallNote(ix: i32, names: string[], tys: i32[]) {
  const nm: string[] = []
  const ty: i32[] = []
  let i = 0
  while i < names.length && i < tys.length {
    nm.push(names[i])
    ty.push(tys[i])
    i = i + 1
  }
  elabCallIx.push(ix)
  elabCallN.push(nm)
  elabCallT.push(ty)
  elabCallD.push(elabCallDecl[ix] ?? -1)
  0
}

// A generic declaration handed by name to a list method as its callback argument `X`, bound by
// the element: rows noted in an instance's re-check, and rows noted at the root.
export let elabCbD: i32[] = []
export let elabCbX: i32[] = []
export let elabCbN: string[][] = []
export let elabCbT: i32[][] = []
export let elabCbRootD: i32[] = []
export let elabCbRootX: i32[] = []
export let elabCbRootN: string[][] = []
export let elabCbRootT: i32[][] = []

export function elabCbNote(d: i32, x: i32, names: string[], tys: i32[]) {
  if d < 0 || names.length == 0 { return 0 }
  if elabCapLive() {
    elabCbD.push(d)
    elabCbX.push(x)
    elabCbN.push(names.slice(0, names.length))
    elabCbT.push(tys.slice(0, tys.length))
  } else if !inferQuiet {
    elabCbRootD.push(d)
    elabCbRootX.push(x)
    elabCbRootN.push(names.slice(0, names.length))
    elabCbRootT.push(tys.slice(0, tys.length))
  }
  0
}

// Calls of a module binding above its declaration, which the checker types no row for.
export let elabEarlyCalls: i32[] = []

export function elabEarlyCallNote(ix: i32) {
  if !inferQuiet && !i32ListHas(elabEarlyCalls, ix) { elabEarlyCalls.push(ix) }
  0
}

// Each generic call's callee declaration, by call node, as the checker resolved it.
export let elabCallDecl: {[i32]: i32} = Map()

export function elabCallDeclNote(ix: i32, decl: i32) {
  if ix >= 0 { elabCallDecl[ix] = decl }
  0
}

export function elabCallDeclOf(ix: i32): i32 { elabCallDecl[ix] ?? -1 }

// The elaboration key whose body is being re-checked, -1 in the generic pass.
export let elabCapKey = -1

// Whether a delivery's coercion record may be written now: in the generic pass, not in an
// instance's re-check or a call's re-check of its return, which would record one pin (D14804).
export function coerceRecordOpen(): boolean {
  elabCapKey < 0 && litPinN.length == 0
}
export function elabCapKeySet(k: i32) {
  elabCapKey = k
  0
}

// Each nested declaration's enclosing declaration, -1 at module scope, from the generic pass.
export let elabEncl: {[i32]: i32} = Map()

// The bindings visible where an open nested declaration is checked, by `<key>|<decl>`: what a
// re-check of its body at an instance declares around it, since its free names resolve there.
export let elabSnapIx: {[string]: i32} = Map()
export let elabSnapTys: i32[][] = []
export let elabSnapSlot: i32[][] = []
let elabSnapStore: i32[][] = []

export function elabSnapKey(k: i32, decl: i32): string {
  i32ToStr(k) + "|" + i32ToStr(decl)
}

// Notes nested declaration `decl` (checked under `enclDecl`), and when its signature `paramTys`
// or its type parameters are open, the bindings visible around it.
export function elabNestNote(
  decl: i32,
  enclDecl: i32,
  nTyParams: i32,
  paramTys: i32[],
) {
  const live = elabCapLive()
  if !live && inferQuiet { return 0 }
  if !live { elabEncl[decl] = enclDecl }
  let open = nTyParams > 0
  for p in paramTys {
    if p >= 0 && p < T.tys.length && tyHasTyVar(p) { open = true }
  }
  // A closed declaration in an open encloser reads the encloser's open captures (D4046), and so
  // does one whose encloser is closed but nested in an open one.
  let enc = enclDecl
  let up = 0
  while !open && enc >= 0 && enc < P.nodes.length && up < P.nodes.length {
    const es = nodeTyIxOf(enc)
    if es >= 0 && es < T.tys.length && tyHasTyVar(es) { open = true }
    enc = elabEncl[enc] ?? -1
    up = up + 1
  }
  if !open { return 0 }
  const key = elabSnapKey(if live { elabCapKey } else { -1 }, decl)
  const slots: i32[] = []
  const tys: i32[] = []
  const stores: i32[] = []
  scopeVisibleSnapshot(slots, tys, stores)
  let si = 0
  while si < slots.length {
    const nt = declTyOf(slots[si])
    if nt >= 0 { tys[si] = nt }
    si = si + 1
  }
  const have = elabSnapIx[key] ?? -1
  if have >= 0 {
    elabSnapTys[have] = tys
    elabSnapSlot[have] = slots
    elabSnapStore[have] = stores
    return 0
  }
  elabSnapIx[key] = elabSnapSlot.length
  elabSnapTys.push(tys)
  elabSnapSlot.push(slots)
  elabSnapStore.push(stores)
  0
}

// Declares snapshot `s` into the innermost frame.
export function elabSnapDeclare(s: i32) {
  let i = 0
  while i < elabSnapSlot[s].length {
    restoreSlot(elabSnapSlot[s][i], elabSnapTys[s][i], elabSnapStore[s][i])
    i = i + 1
  }
  0
}

// The declaration whose parameter hole `name` is, or -1 (`paramHoleName`'s three spellings).
export function elabHoleDeclOf(name: string): i32 {
  if name.length < 2 || name[0] != '?' { return -1 }
  let dot = name.length - 1
  while dot > 0 && name[dot] != '.' { dot = dot - 1 }
  if dot <= 1 { return -1 }
  if name.slice(0, 3) == "?#L" { return decDigitsOf(name.slice(3, dot)) }
  if name[1] == '#' { return -1 }
  let at = dot - 1
  while at > 1 && name[at] != '@' { at = at - 1 }
  if at > 1 { return decDigitsOf(name.slice(at + 1, dot)) }
  fnDeclIx[name.slice(1, dot)] ?? -1
}

// The closed pins a hole took outside a call (a delivery into a function-typed destination),
// grouped per declaration: consecutive pins of one declaration's holes are one instance. A
// generic delivered as a value banks its instance here too (`elabValueRowNote`).
export let elabHoleRowDecl: i32[] = []
export let elabHoleRowFrom: i32[] = []
export let elabHoleRowN: string[][] = []
export let elabHoleRowT: i32[][] = []
// By row: the binding its pins are substituted from (`elabPinBindingIs`), the whole call's, of
// which the row holds only the names pinned in its epoch.
export let elabHoleRowBindN: string[][] = []
export let elabHoleRowBindT: i32[][] = []
// The key the elaboration is walking now (`elabOne`), -1 outside every walk: a pin banked outside a
// live re-check during that walk is the walked key's (per-instance-identity-2026-11.md, M5).
let elabWalkNow = -1

// Sets the key being walked, returning the one it replaces.
export function elabWalkNowSet(k: i32): i32 {
  const was = elabWalkNow
  elabWalkNow = k
  was
}

// The binding the pins noted now come from, and a count that moves when it changes:
// pins under two bindings are two instances, however consecutive.
let elabPinBindN: string[] = []
let elabPinBindT: i32[] = []
let elabPinEpoch = 0
export let elabHoleRowEpoch: i32[] = []

// Set once `elabRun` has settled: a pin noted after it, outside an instance's own re-check, is a
// read of a settled type and banks no row (a late row would drain into an instance no call has).
export let elabPinsClosed = false
export function elabPinsClosedSet(v: boolean) { elabPinsClosed = v }

export function elabPinBindingIs(names: string[], tys: i32[]) {
  let same = names.length == elabPinBindN.length
    && tys.length == elabPinBindT.length
  let i = 0
  while same && i < names.length {
    if names[i] != elabPinBindN[i] { same = false }
    i = i + 1
  }
  i = 0
  while same && i < tys.length {
    if tys[i] != elabPinBindT[i] { same = false }
    i = i + 1
  }
  if same { return 0 }
  elabPinBindN = names.slice(0, names.length)
  elabPinBindT = tys.slice(0, tys.length)
  elabPinEpoch = elabPinEpoch + 1
  0
}

// The hole-pin row count, for a trial whose pins are dropped with its diagnostics.
export function elabHoleRowMark(): i32 { elabHoleRowDecl.length }

// Drops the hole-pin rows banked since mark `m`.
export function elabHoleRowCut(m: i32) {
  while elabHoleRowDecl.length > m {
    elabHoleRowDecl.pop()
    elabHoleRowFrom.pop()
    elabHoleRowEpoch.pop()
    elabHoleRowN.pop()
    elabHoleRowT.pop()
    elabHoleRowBindN.pop()
    elabHoleRowBindT.pop()
  }
  0
}

// Drops the hole-pin rows of declaration `d` banked since mark `m`: a call's argument checks pin
// its callee's holes provisionally, and the call's own pin step banks the binding it settles.
export function elabHoleRowDropDecl(m: i32, d: i32) {
  if d < 0 { return 0 }
  let w = m
  let r = m
  while r < elabHoleRowDecl.length {
    if elabHoleRowDecl[r] != d {
      elabHoleRowDecl[w] = elabHoleRowDecl[r]
      elabHoleRowFrom[w] = elabHoleRowFrom[r]
      elabHoleRowEpoch[w] = elabHoleRowEpoch[r]
      elabHoleRowN[w] = elabHoleRowN[r]
      elabHoleRowT[w] = elabHoleRowT[r]
      elabHoleRowBindN[w] = elabHoleRowBindN[r]
      elabHoleRowBindT[w] = elabHoleRowBindT[r]
      w = w + 1
    }
    r = r + 1
  }
  elabHoleRowCut(w)
}

export function elabHolePinNote(name: string, ty: i32) {
  const live = elabCapLive()
  if !live && (inferQuiet || elabPinsClosed) { return 0 }
  if !elabTyClosed(ty, 0) { return 0 }
  const d = elabHoleDeclOf(name)
  if d < 0 { return 0 }
  const from = if live { elabCapKey } else { elabWalkNow }
  const last = elabHoleRowDecl.length - 1
  if (
    last >= 0
    && elabHoleRowDecl[last] == d
    && elabHoleRowFrom[last] == from
    && elabHoleRowEpoch[last] == elabPinEpoch
  ) {
    let dup = false
    for nm in elabHoleRowN[last] {
      if nm == name { dup = true }
    }
    if !dup {
      elabHoleRowN[last].push(name)
      elabHoleRowT[last].push(ty)
      return 0
    }
  }
  elabHoleRowDecl.push(d)
  elabHoleRowFrom.push(from)
  elabHoleRowEpoch.push(elabPinEpoch)
  elabHoleRowN.push([name])
  elabHoleRowT.push([ty])
  elabHoleRowBindN.push(elabPinBindN.slice(0, elabPinBindN.length))
  elabHoleRowBindT.push(elabPinBindT.slice(0, elabPinBindT.length))
  0
}

// Banks binding `names`/`tys` of function `d` as an instance a function value reaches, as a hole
// pin row does; a binding that is not closed banks nothing.
export function elabValueRowNote(d: i32, names: string[], tys: i32[]) {
  const live = elabCapLive()
  if (!live && inferQuiet) || d < 0 || names.length == 0 { return 0 }
  for t in tys {
    if !elabTyClosed(t, 0) { return 0 }
  }
  elabHoleRowDecl.push(d)
  elabHoleRowFrom.push(if live { elabCapKey } else { elabWalkNow })
  elabHoleRowEpoch.push(-1)
  elabHoleRowN.push(names.slice(0, names.length))
  elabHoleRowT.push(tys.slice(0, tys.length))
  elabHoleRowBindN.push(names.slice(0, names.length))
  elabHoleRowBindT.push(tys.slice(0, tys.length))
  0
}

// The generic values delivered at a closed function type, with the binding the delivery gives
// them and the result the destination's type declares: a result that only converts to it is
// built as it (D9282).
export let elabWideRowDecl: i32[] = []
export let elabWideRowFrom: i32[] = []
export let elabWideRowN: string[][] = []
export let elabWideRowT: i32[][] = []
export let elabWideRowRet: i32[] = []

export function elabWideRowNote(d: i32, names: string[], tys: i32[], ret: i32) {
  const live = elabCapLive()
  if (
    (!live && inferQuiet)
    || d < 0
    || names.length == 0
    || !elabTyClosed(ret, 0)
  ) {
    return 0
  }
  for t in tys {
    if !elabTyClosed(t, 0) { return 0 }
  }
  elabWideRowDecl.push(d)
  elabWideRowFrom.push(if live { elabCapKey } else { -1 })
  elabWideRowN.push(names.slice(0, names.length))
  elabWideRowT.push(tys.slice(0, tys.length))
  elabWideRowRet.push(ret)
  0
}

// Each maker call `fvaMakerCallRows` banked, with the closed result its binding's calls take.
let elabMakerCallSigs: {[i32]: i32} = Map()

// The callee read of each such call, and the makers one of whose reads takes no instance.
let elabMakerCalleeReads: {[i32]: boolean} = Map()
let elabMakersBlocked: {[i32]: boolean} = Map()

export function elabMakerCallReset() {
  elabMakerCallSigs = Map()
  elabMakerCalleeReads = Map()
  elabMakersBlocked = Map()
  0
}

export function elabMakerCallNote(call: i32, sig: i32) {
  elabMakerCallSigs[call] = sig
  const c = nodeAt(call)
  if c is Call { elabMakerCalleeReads[parenPeelIx(c.callFn)] = true }
  0
}

// Whether read `r` is the callee of a noted maker call.
export function elabMakerReadCalled(r: i32): boolean {
  elabMakerCalleeReads.get(r) ?? false
}

// Withdraws maker `m` from instancing: one of its reads reaches its root.
export function elabMakerBlock(m: i32) {
  elabMakersBlocked[m] = true
  0
}

// Whether maker `m` is instanced at its uses' results: none of its reads reaches its root, or
// the root returns a tagged set's id, which no instance's walk retypes.
export function elabMakerOpen(m: i32): boolean {
  !(elabMakersBlocked.get(m) ?? false) || fnTagRetIsTagged(m)
}

// Whether a maker row banks maker `d` at closed result `ret`.
export function elabMakerRowHas(d: i32, ret: i32): boolean {
  let r = 0
  while r < elabWideRowDecl.length {
    if (
      elabWideRowDecl[r] == d
      && elabWideRowN[r].length == 0
      && tySame(elabWideRowRet[r], ret)
    ) {
      return true
    }
    r = r + 1
  }
  false
}

// The closed result maker call `call` is built at, or -1.
export function elabMakerCallSig(call: i32): i32 {
  elabMakerCallSigs.get(call) ?? -1
}

// A maker's row: a wide row with no binding, built at the destination's closed result `ret`.
export function elabMakerRowNote(d: i32, ret: i32) {
  const live = elabCapLive()
  if ((!live && inferQuiet) || d < 0 || !elabTyClosed(ret, 0)) { return 0 }
  elabWideRowDecl.push(d)
  elabWideRowFrom.push(if live { elabCapKey } else { -1 })
  elabWideRowN.push([])
  elabWideRowT.push([])
  elabWideRowRet.push(ret)
  0
}

// The rows `elabValueRowNote` banked for a call that leaves a type parameter at the D4551 default
// `i32`: an instance only such a row asks for is a guess, since the default is no binding.
export let elabDefaultRowDecl: i32[] = []
export let elabDefaultRowT: i32[][] = []

// Each call that binds none of its callee's type parameters closed, with the binding its default
// instance takes: the elaboration keys the call at that instance (D4551).
export let elabUnboundCallIx: i32[] = []
export let elabUnboundCallD: i32[] = []
export let elabUnboundCallFrom: i32[] = []
export let elabUnboundCallN: string[][] = []
export let elabUnboundCallT: i32[][] = []

export function elabUnboundCallKeyNote(
  ix: i32,
  d: i32,
  names: string[],
  tys: i32[],
) {
  const live = elabCapLive()
  if (!live && inferQuiet) || ix < 0 || d < 0 || names.length == 0 { return 0 }
  for t in tys {
    if !elabTyClosed(t, 0) { return 0 }
  }
  elabUnboundCallIx.push(ix)
  elabUnboundCallD.push(d)
  elabUnboundCallFrom.push(if live { elabCapKey } else { elabWalkNow })
  elabUnboundCallN.push(names.slice(0, names.length))
  elabUnboundCallT.push(tys.slice(0, tys.length))
  0
}

export function elabDefaultRowNote(d: i32, tys: i32[]) {
  elabDefaultRowDecl.push(d)
  elabDefaultRowT.push(tys.slice(0, tys.length))
  0
}

// Whether `d` at `tys` is a row `elabDefaultRowNote` banked.
export function elabDefaultRowHas(d: i32, tys: i32[]): boolean {
  let r = 0
  while r < elabDefaultRowDecl.length {
    if elabDefaultRowDecl[r] == d && elabDefaultRowT[r].length == tys.length {
      let same = true
      let i = 0
      while same && i < tys.length {
        if !tySame(elabDefaultRowT[r][i], tys[i]) { same = false }
        i = i + 1
      }
      if same { return true }
    }
    r = r + 1
  }
  false
}

// Whether `t` is a closed, fully resolved type: no type variable and no pending return anywhere.
export function elabTyClosed(t: i32, depth: i32): boolean {
  if etcN > 0 {
    etcMemo = Map()
    etcN = 0
  }
  elabTyClosedOwn(t, depth, [])
}

// The answers of one `elabTyClosed` walk with no owning declaration, keyed by type and depth, so
// a type reached along many paths is walked once; cleared by the next walk.
let etcMemo: {[i32]: boolean} = Map()
let etcN = 0

// Whether type variable `name` is a type parameter or a hole of a declaration in `own`.
function elabOwnedBy(own: i32[], name: string): boolean {
  const hd = elabHoleDeclOf(name)
  for d in own {
    if d == hd { return true }
    const n = nodeAt(d)
    if n is FuncDecl {
      for tp in n.fnTyParams {
        if tp == name { return true }
      }
    }
  }
  false
}

// The name of the hole a derived hole (an operator's pending answer, a field of a hole) derives
// from at its root, so it is owned where that hole is; a plain type variable's own name.
export function elabHoleRootName(t: i32): string {
  let r = t
  let n = 0
  while hdRowOf(r) >= 0 && n < 64 {
    r = hdBase[hdRowOf(r)]
    n = n + 1
  }
  const x = T.tys[r]
  if x is TyVar { return x.tvName }
  ""
}

// `elabTyClosed`, where a type variable of a declaration in `own` counts as closed.
function elabTyClosedOwn(t: i32, depth: i32, own: i32[]): boolean {
  if t < 0 || t >= T.tys.length { return false }
  if depth > 16 { return true }
  if own.length > 0 { return elabTyClosedWalk(t, depth, own) }
  const key = t * 17 + depth
  const hit = etcMemo[key]
  if hit != null { return hit }
  const r = elabTyClosedWalk(t, depth, own)
  etcMemo[key] = r
  etcN = etcN + 1
  r
}

// One step of `elabTyClosedOwn` at `t`, which is in the arena and at most 16 deep.
function elabTyClosedWalk(t: i32, depth: i32, own: i32[]): boolean {
  const x = T.tys[t]
  match x {
    TyVar => {
      return elabOwnedBy(own, elabHoleRootName(t))
    }
    TyArray => {
      return elabTyClosedOwn(x.aElem, depth + 1, own)
    }
    TyNullable => {
      return elabTyClosedOwn(x.nInner, depth + 1, own)
    }
    TyMap => {
      return elabTyClosedOwn(x.mKey, depth + 1, own)
        && elabTyClosedOwn(x.mVal, depth + 1, own)
    }
    TyObj => {
      for ft in x.objFieldTypes {
        if !elabTyClosedOwn(ft, depth + 1, own) { return false }
      }
      return true
    }
    TyFunc => {
      // A function value is its singleton `Fn#d`, or any member of its set, when its
      // signature is closed but for its members' own type parameters and holes, at any depth.
      const d = elabFnIdOf(t)
      let ds: i32[] = []
      if d >= 0 { ds = [d] } else { ds = elabFnSetOf(t) }
      let fresh = false
      const own2 = own.slice(0, own.length)
      for m in ds {
        if nodeAt(m) is FuncDecl && !i32ListHas(own, m) {
          own2.push(m)
          fresh = true
        }
      }
      if fresh && elabTyClosedOwn(t, depth + 1, own2) { return true }
      for pt in x.fnParamTypes {
        if !elabTyClosedOwn(pt, depth + 1, own) { return false }
      }
      return elabTyClosedOwn(x.fnRet, depth + 1, own)
    }
    TyUnion => {
      for m in x.uMembers {
        if !elabTyClosedOwn(m, depth + 1, own) { return false }
      }
      return true
    }
    TyPrim | TyErr | TyLit | TyNeg => {
      return true
    }
  }
}

// `elabFnSetTy` (in `check_fn_tag_facts`) maps a function type to an id into `fnSets`: a read of
// a function's name or a lambda literal types its value at an index only that function has (its
// singleton `Fn#d`), and a join of two sets is a fresh index.
// Each interned set, its members ascending; `fnSetByKey` finds one by its spelling.
let fnSets: i32[][] = []

// Every function some set of functions holds, once each: the functions used as values.
export function elabFnSetMembers(): i32[] {
  const out: i32[] = fnValGenerics.slice(0, fnValGenerics.length)
  for ms in fnSets {
    for m in ms {
      if !i32ListHas(out, m) { out.push(m) }
    }
  }
  out
}
// `elabFnSetMembers` less a function every set of which holds it alone: one a binding holds by
// itself and calls.
function elabFnSetMembersShared(): i32[] {
  const out: i32[] = fnValGenerics.slice(0, fnValGenerics.length)
  for ms in fnSets {
    if ms.length < 2 { continue }
    for m in ms {
      if !i32ListHas(out, m) { out.push(m) }
    }
  }
  out
}
// `elabFnSetMembersShared` less a function no untagged set called through holds: a call through
// a tagged set dispatches at that call, so each instance of the member takes its own arm.
export function elabFnSetMembersUntagged(): i32[] {
  const called: i32[] = []
  for c in fnTagCallIxs {
    const s = fnTagCallSet[c] ?? -1
    if (
      s >= 0
      && s < fnSets.length
      && !(fnTagged[s] ?? false)
      && !i32ListHas(called, s)
    ) {
      called.push(s)
    }
  }
  const out: i32[] = []
  for m in elabFnSetMembersShared() {
    let open = i32ListHas(fnValGenerics, m)
    for s in called {
      if i32ListHas(fnSets[s], m) { open = true }
    }
    if open { out.push(m) }
  }
  out
}
let fnSetByKey: {[string]: i32} = Map()
// Generic declarations read as a value whose signature names none of their type parameters.
let fnValGenerics: i32[] = []
// The fresh index each joined pair of function types took, by `a,b`.
let fnJoinMemo: {[string]: i32} = Map()
// The type each widened `let` node's reads take this pass (`elabFnLetTy`).
let fnLetReadTy: {[i32]: i32} = Map()

// The type the reads of `let` node `bd` take when they read the set of every function written
// to it; -1 when they read the initialiser's type.
export function fnLetReadTyOf(bd: i32): i32 { fnLetReadTy[bd] ?? -1 }
// By re-pointed `let` node: the set of every function it may hold, or -1 when one is not a
// function.
let fnLetSet: {[i32]: i32} = Map()
let fnSlotSet: {[i32]: i32} = Map()

// Set while the global-init pre-pass types a module binding's initializer: the function set that
// initializer yields is a fact a body checked before the binding reads (D6000), so it is recorded
// although the pre-pass's other types do not stand.
export let globalInitRecordsFnSets = false
export function globalInitRecordsFnSetsSet(v: boolean) {
  globalInitRecordsFnSets = v
}

// Whether a value of function type `t` read now still decides `t`'s set. Only an open signature
// needs one, since a closed one keys an instance by its spelling, and a quiet probe's types do
// not stand.
export function elabFnValWanted(t: i32): boolean {
  if !stampsStand() && !globalInitRecordsFnSets { return false }
  if t < 0 { return false }
  tyHasTyVar(t)
}

// The id of the set holding `ms`, which is ascending and duplicate-free.
function fnSetIntern(ms: i32[]): i32 {
  let key = ""
  for m in ms { key = key + i32ToStr(m) + "," }
  const have = fnSetByKey[key] ?? -1
  if have >= 0 { return have }
  fnSets.push(ms)
  fnSetByKey[key] = fnSets.length - 1
  fnSets.length - 1
}

// The members of sets `a` and `b` (either -1 for none), ascending and once each.
function fnSetUnion(a: i32, b: i32): i32[] {
  const out: i32[] = []
  const xs = if a >= 0 { fnSets[a] } else { out }
  const ys = if b >= 0 { fnSets[b] } else { out }
  let i = 0
  let j = 0
  const ms: i32[] = []
  while i < xs.length || j < ys.length {
    if j >= ys.length || (i < xs.length && xs[i] < ys[j]) {
      ms.push(xs[i])
      i = i + 1
    } else if i >= xs.length || ys[j] < xs[i] {
      ms.push(ys[j])
      j = j + 1
    } else {
      ms.push(xs[i])
      i = i + 1
      j = j + 1
    }
  }
  ms
}

// Whether set `s` holds a function that declares type parameters: a `let` holding one that a closure
// writes keeps its initializer's generic type.
function fnSetHasGeneric(s: i32): boolean {
  if s < 0 || s >= fnSets.length { return false }
  for d in fnSets[s] {
    const f = nodeAt(d)
    if f is FuncDecl && f.fnTyParams.length > 0 { return true }
  }
  false
}

// Notes a value of function type `t` as one of function `d`, the declaration or lambda it reads.
export function elabFnValNote(t: i32, d: i32) {
  if (
    d >= 0
    && stampsStand()
    && !tyHasTyVar(t)
    && !i32ListHas(fnValGenerics, d)
  ) {
    const f = nodeAt(d)
    if f is FuncDecl && f.fnTyParams.length > 0 { fnValGenerics.push(d) }
  }
  if d < 0 || !elabFnValWanted(t) { return 0 }
  const one: i32[] = [d]
  elabFnSetTy[t] = fnSetIntern(
    fnSetUnion(elabFnSetTy[t] ?? -1, fnSetIntern(one)),
  )
  0
}

// Function type `t` carrying the set of members `ms` (ascending, non-empty): `t` when it already
// does or is no function type, else a copy of its signature, minted once per `t` and set.
export function elabFnSetTyMint(t: i32, ms: i32[]): i32 {
  if t < 0 || t >= T.tys.length || ms.length == 0 { return t }
  const tf = T.tys[t]
  if !(tf is TyFunc) { return t }
  const s = fnSetIntern(ms)
  if (elabFnSetTy[t] ?? -1) == s { return t }
  const key = "id" + i32ToStr(s) + "," + i32ToStr(t)
  const memo = fnJoinMemo[key] ?? -1
  if memo >= 0 && memo < T.tys.length { return memo }
  const ps: i32[] = []
  for p in tf.fnParamTypes { ps.push(p) }
  const g: Ty = { fnParamTypes: ps, fnRet: tf.fnRet }
  T.tys.push(g)
  const fresh = T.tys.length - 1
  elabFnSetTy[fresh] = s
  fnJoinMemo[key] = fresh
  fresh
}

// The functions a value of type `t` may be, ascending; [] when `t` carries no set.
export function elabFnSetOf(t: i32): i32[] {
  const none: i32[] = []
  const s = elabFnSetTy[t] ?? -1
  if s < 0 { return none }
  fnSets[s]
}

// The function `t` is the singleton type of, or -1.
export function elabFnIdOf(t: i32): i32 {
  const ms = elabFnSetOf(t)
  if ms.length != 1 { return -1 }
  ms[0]
}

// The type a join of function types `a` and `b` into `j` gives its value: `j` itself when both
// carry one set, else a fresh index with `j`'s signature, holding the union when each side
// carries a set and none when one side may be any function, so `j`'s own set is not widened. A
// side that is no value yet (-1) leaves `j` as the other side made it.
export function elabFnJoinTy(j: i32, a: i32, b: i32): i32 {
  if j < 0 || j >= T.tys.length || a < 0 || b < 0 { return j }
  const jf = T.tys[j]
  if !(jf is TyFunc) { return j }
  const sa = elabFnSetTy[a] ?? -1
  const sb = elabFnSetTy[b] ?? -1
  if sa < 0 && sb < 0 { return j }
  if sa == sb && (elabFnSetTy[j] ?? -1) == sa { return j }
  const key = i32ToStr(a) + "," + i32ToStr(b)
  const memo = fnJoinMemo[key] ?? -1
  if memo >= 0 && memo < T.tys.length {
    const mf = T.tys[memo]
    if (
      mf is TyFunc
      && mf.fnRet == jf.fnRet
      && mf.fnParamTypes == jf.fnParamTypes
    ) {
      return memo
    }
  }
  const ps: i32[] = []
  for p in jf.fnParamTypes { ps.push(p) }
  const g: Ty = { fnParamTypes: ps, fnRet: jf.fnRet }
  T.tys.push(g)
  const fresh = T.tys.length - 1
  if sa >= 0 && sb >= 0 { elabFnSetTy[fresh] = fnSetIntern(fnSetUnion(sa, sb)) }
  fnJoinMemo[key] = fresh
  fresh
}

// `elabFnJoinTy` for list element types: a join `j` of lists `a` and `b` whose leaves are
// functions takes the union of the leaves' sets at every depth, so a list of inner lists of
// fewer members holds the whole set. `j` when neither side's leaf carries a set.
export function elabFnJoinListTy(j: i32, a: i32, b: i32): i32 {
  if (
    j < 0
    || j >= T.tys.length
    || a < 0
    || a >= T.tys.length
    || b < 0
    || b >= T.tys.length
  ) {
    return j
  }
  const jl = T.tys[j]
  const al = T.tys[a]
  const bl = T.tys[b]
  if !(jl is TyArray) || !(al is TyArray) || !(bl is TyArray) { return j }
  const je = jl.aElem
  if je < 0 || je >= T.tys.length { return j }
  const jt = T.tys[je]
  const ne = if jt is TyArray { elabFnJoinListTy(je, al.aElem, bl.aElem) } else { elabFnJoinTy(je, al.aElem, bl.aElem) }
  if ne == je { return j }
  mkArrayTy(ne)
}

// `elabFnJoinTy` for map element types of a list literal: a join `j` of maps `a` and `b` whose
// values are functions takes the union of the values' sets, so every map of the list is read
// through one set whichever element comes first (D15352). `j` when neither side carries a set.
export function elabFnJoinMapTy(j: i32, a: i32, b: i32): i32 {
  const jm = if j >= 0 && j < T.tys.length { T.tys[j] } else { null }
  const am = if a >= 0 && a < T.tys.length { T.tys[a] } else { null }
  const bm = if b >= 0 && b < T.tys.length { T.tys[b] } else { null }
  if !(jm is TyMap) || !(am is TyMap) || !(bm is TyMap) { return j }
  const nv = elabFnJoinTy(jm.mVal, am.mVal, bm.mVal)
  if nv == jm.mVal { j } else { mkMapTy(jm.mKey, nv, jm.mSet) }
}

// `elabFnJoinTy` through lists and records, for a function's returned values: join `j` of `a`
// and `b` takes the union of the function sets at every leaf the three share, `j` when none
// widens (D15209). A list under a record under a list is not joined: no row is built for it.
export function elabFnJoinDeepTy(j: i32, a: i32, b: i32, rowDepth: i32): i32 {
  elabFnJoinDeepAt(j, a, b, rowDepth, 0)
}

// `elabFnJoinDeepTy` for two record elements of one list literal: each field joins its sets, as
// the writes of one slot do, when every member on both sides is a named function; `j` otherwise,
// since a lambda beside a generic member would need that member's closure. A list under such a
// record is not joined (no row is built for it).
export function elabFnJoinElemTy(j: i32, a: i32, b: i32): i32 {
  if !elabFnLeavesNamed(a, 0) || !elabFnLeavesNamed(b, 0) { return j }
  elabFnJoinDeepAt(j, a, b, 0, 1)
}

// Whether every function leaf of type `t` (through records and lists) carries a set, and each set
// holds only named functions.
function elabFnLeavesNamed(t: i32, depth: i32): boolean {
  if t < 0 || t >= T.tys.length || depth > 6 { return true }
  const tt = T.tys[t]
  match tt {
    TyFunc => {
      const ms = elabFnSetOf(t)
      if ms.length == 0 { return false }
      for m in ms {
        const d = if m >= 0 && m < P.nodes.length { nodeAt(m) } else { null }
        if !(d is FuncDecl) || d.fnName == "" { return false }
      }
      return true
    }
    TyArray => {
      return elabFnLeavesNamed(tt.aElem, depth + 1)
    }
    TyObj => {
      for f in tt.objFieldTypes {
        if !elabFnLeavesNamed(f, depth + 1) { return false }
      }
      return true
    }
    // No other kind is walked by the join this guards.
    TyPrim | TyErr | TyUnion | TyNullable | TyVar | TyLit | TyNeg | TyMap => {
      return true
    }
  }
}

// Notes, for a value `if` or `match` whose arms typed `a` and `b` joined to `j`, each function
// set in a record field of `j` (not in a list) beside the arm's own set there: the choice holds each arm's
// ids, so each arm's set is decided with the join's (D15290).
export function elabFnArmJoinNote(j: i32, a: i32, b: i32) {
  elabFnArmJoinAt(j, a, b, 0, false)
}

// `elabFnArmJoinNote` for a function's returned values, `a` and `b` joined to `j`. Each returned
// literal is built at the function's result row, so a list a returned record holds is noted
// too (D15366).
export function elabFnRetJoinNote(j: i32, a: i32, b: i32) {
  elabFnJoinRecLists = true
  elabFnArmJoinAt(j, a, b, 0, false)
  elabFnJoinRecLists = false
}

// Whether the join note in progress is a return's, whose records' lists are noted too.
let elabFnJoinRecLists = false

function elabFnArmJoinAt(j: i32, a: i32, b: i32, depth: i32, inRec: boolean) {
  if (
    depth > 6
    || j < 0
    || j >= T.tys.length
    || a < 0
    || a >= T.tys.length
    || b < 0
    || b >= T.tys.length
  ) {
    return 0
  }
  const jt = T.tys[j]
  const at = T.tys[a]
  const bt = T.tys[b]
  match jt {
    TyFunc => {
      const u = elabFnSetTy[j] ?? -1
      if !inRec || u < 0 { return 0 }
      for sd in [elabFnSetTy[a] ?? -1, elabFnSetTy[b] ?? -1] {
        if sd >= 0 && sd != u {
          fnWidenSrcTo.push(u)
          fnWidenSrcFrom.push(sd)
        }
      }
      return 0
    }
    // A list's elements are built at their own row: a join of lists of two sets is not noted.
    TyObj => {
      if !(at is TyObj) || !(bt is TyObj) { return 0 }
      let i = 0
      while i < jt.objFieldNames.length {
        const nm = jt.objFieldNames[i]
        const ia = strListIndexOf(at.objFieldNames, nm)
        const ib = strListIndexOf(bt.objFieldNames, nm)
        if ia >= 0 && ib >= 0 {
          elabFnArmJoinAt(
            jt.objFieldTypes[i],
            at.objFieldTypes[ia],
            bt.objFieldTypes[ib],
            depth + 1,
            true,
          )
        }
        i = i + 1
      }
      return 0
    }
    // A list of functions, at any depth of lists, holds each side's ids at the join's set, as a
    // record field does (D15227). One an arm's record holds, and a list of records, is built at
    // that record's own row and is not noted (D15290, D15303); a returned one is (D15366).
    TyArray => {
      if (
        inRec && !elabFnJoinRecLists
        || !(at is TyArray)
        || !(bt is TyArray)
        || !elabListLeafIsFn(j, 6)
      ) {
        return 0
      }
      const inner = jt.aElem >= 0
        && jt.aElem < T.tys.length
        && T.tys[jt.aElem] is TyFunc
      elabFnArmJoinAt(jt.aElem, at.aElem, bt.aElem, depth + 1, inner)
      return 0
    }
    TyPrim | TyErr | TyUnion | TyNullable | TyVar | TyLit | TyNeg | TyMap => {
      return 0
    }
  }
}

// Whether list type `t`'s elements, through at most `depth` nested lists, are functions.
function elabListLeafIsFn(t: i32, depth: i32): boolean {
  if depth <= 0 || t < 0 || t >= T.tys.length { return false }
  const tt = T.tys[t]
  if !(tt is TyArray) { return false }
  const e = tt.aElem
  if e < 0 || e >= T.tys.length { return false }
  if T.tys[e] is TyFunc { return true }
  elabListLeafIsFn(e, depth - 1)
}

// `elabFnJoinDeepTy` at `j`, `shape` saying what holds it: 0 nothing, 1 a list, 2 a record in
// a list, 3 a list in a record in a list, 4 a record in a list with a type-parameter field, whose
// lists keep their own sets.
function elabFnJoinDeepAt(j: i32, a: i32, b: i32, depth: i32, shape: i32): i32 {
  if (
    depth > 6
    || j < 0
    || j >= T.tys.length
    || a < 0
    || a >= T.tys.length
    || b < 0
    || b >= T.tys.length
  ) {
    return j
  }
  const jt = T.tys[j]
  const at = T.tys[a]
  const bt = T.tys[b]
  match jt {
    TyFunc => {
      return elabFnJoinTy(j, a, b)
    }
    TyArray => {
      if !(at is TyArray) || !(bt is TyArray) || shape == 3 || shape == 4 {
        return j
      }
      const ne = elabFnJoinDeepAt(
        jt.aElem,
        at.aElem,
        bt.aElem,
        depth + 1,
        if shape == 2 { 3 } else { 1 },
      )
      return if ne == jt.aElem { j } else { mkArrayTy(ne) }
    }
    TyObj => {
      if !(at is TyObj) || !(bt is TyObj) || shape == 3 { return j }
      const n = jt.objFieldNames.length
      if at.objFieldNames.length != n || bt.objFieldNames.length != n {
        return j
      }
      const tys: i32[] = []
      const fs = if shape < 1 { 0 } else if elabObjHasTyParam(j) { 4 } else { 2 }
      let changed = false
      let i = 0
      while i < n {
        const nm = jt.objFieldNames[i]
        if at.objFieldNames[i] != nm || bt.objFieldNames[i] != nm { return j }
        const f = jt.objFieldTypes[i]
        const w = elabFnJoinDeepAt(
          f,
          at.objFieldTypes[i],
          bt.objFieldTypes[i],
          depth + 1,
          fs,
        )
        if w != f { changed = true }
        tys.push(w)
        i = i + 1
      }
      if !changed { return j }
      const names: string[] = []
      for nm in jt.objFieldNames { names.push(nm) }
      return mkObjTy(names, tys)
    }
    // No other kind holds a function at a place both sides share.
    TyPrim | TyErr | TyUnion | TyNullable | TyVar | TyLit | TyNeg | TyMap => {
      return j
    }
  }
}

// Whether record type `t` has a field typed at a declared type parameter, not an inference hole.
function elabObjHasTyParam(t: i32): boolean {
  const o = T.tys[t]
  if !(o is TyObj) { return false }
  for f in o.objFieldTypes {
    if (
      f >= 0
      && f < T.tys.length
      && T.tys[f] is TyVar
      && !tyHasInferHole(f, 0)
    ) {
      return true
    }
  }
  false
}

// Whether `dst` holds, at some place `own` shares through lists and records, a function set
// other than `own`'s there, so a value of `own` delivered to `dst` takes `dst`'s sets (D15209).
export function elabFnSetsWiden(own: i32, dst: i32, depth: i32): boolean {
  if (
    depth > 6
    || own < 0
    || own >= T.tys.length
    || dst < 0
    || dst >= T.tys.length
  ) {
    return false
  }
  const ot = T.tys[own]
  const dt = T.tys[dst]
  match dt {
    TyFunc => {
      return ot is TyFunc
        && (elabFnSetTy[dst] ?? -1) != (elabFnSetTy[own] ?? -1)
    }
    TyArray => {
      return ot is TyArray && elabFnSetsWiden(ot.aElem, dt.aElem, depth + 1)
    }
    TyObj => {
      if !(ot is TyObj) || ot.objFieldNames.length != dt.objFieldNames.length {
        return false
      }
      let i = 0
      while i < dt.objFieldNames.length {
        if (
          ot.objFieldNames[i] == dt.objFieldNames[i]
          && elabFnSetsWiden(ot.objFieldTypes[i], dt.objFieldTypes[i], depth + 1)
        ) {
          return true
        }
        i = i + 1
      }
      return false
    }
    // No other kind holds a function at a place both sides share.
    TyPrim | TyErr | TyUnion | TyNullable | TyVar | TyLit | TyNeg | TyMap => {
      return false
    }
  }
}

// The set of every function the `let` node `bd` may hold: its initialiser and each value its
// own scope writes to it, read from the source; -1 when one is not a function.
function fnLetSetOf(bd: i32): i32 {
  const have = fnLetSet[bd] ?? -2
  if have != -2 { return have }
  let s = -1
  const ts = cwLetFnTargets(bd)
  if ts.length > 0 && ts[0] >= 0 { s = fnSetIntern(fnSetSorted(ts)) }
  fnLetSet[bd] = s
  s
}

// Every `let` node whose set of functions has been read, in no set order.
export function elabFnLetBindings(): i32[] {
  const out: i32[] = []
  for bd in fnLetSet.keys() {
    if (fnLetSet[bd] ?? -1) >= 0 { out.push(bd) }
  }
  out
}

// The functions the `let` node `bd` may hold, ascending; [] when one is not a function.
export function elabFnLetMembers(bd: i32): i32[] {
  const none: i32[] = []
  const s = fnLetSetOf(bd)
  if s < 0 { return none }
  fnSets[s]
}

// The type a `let` node `bd` with inferred `t` gives its reads: `t` carrying the set of every
// function written to it as well as its initialiser's, as an `if`'s arms join. One that holds its
// initialiser's value throughout (`pcLetHoldsInit`) is that value, as a `const` is (D15120, D15122).
export function elabFnLetTy(bd: i32, t: i32): i32 {
  const n = nodeAt(bd)
  if (
    !(n is LetDecl)
    || n.letKw != "let"
    || pcLetHoldsInit(bd)
    || pcLetSourcesOneTyParam(bd)
    || t < 0
    || t >= T.tys.length
  ) {
    return t
  }
  const tf = T.tys[t]
  if !(tf is TyFunc) { return t }
  const s = elabFnSetTy[t] ?? -1
  if s < 0 { return t }
  if i32ListHas(fnLetVeto, bd) { return t }
  const w = fnLetSetOf(bd)
  if w < 0 || w == s { return t }
  const key = "let" + i32ToStr(bd) + "," + i32ToStr(t)
  const memo = fnJoinMemo[key] ?? -1
  if memo >= 0 && memo < T.tys.length {
    fnLetReadTy[bd] = memo
    return memo
  }
  const ps: i32[] = []
  for p in tf.fnParamTypes { ps.push(p) }
  const g: Ty = { fnParamTypes: ps, fnRet: tf.fnRet }
  T.tys.push(g)
  const fresh = T.tys.length - 1
  elabFnSetTy[fresh] = fnSetIntern(fnSetUnion(s, w))
  fnJoinMemo[key] = fresh
  fnLetReadTy[bd] = fresh
  if !fnTagEtaRan {
    fnLetWide.push(fresh)
    fnLetWideAt.push(bd)
  }
  fresh
}

// The type value type `t`, pinned into a slot of the container the receiver node `recv` names,
// gives that slot: `t` joined with every function the binding's own scope writes into its slots,
// as a list literal's elements join, so a read before a write sees the same slot type as one after.
export function elabSlotJoinTy(recv: i32, t: i32): i32 {
  if recv < 0 || t < 0 || t >= T.tys.length { return t }
  let r = recv
  let rn = nodeAt(r)
  while rn is Paren {
    r = rn.parInner
    rn = nodeAt(r)
  }
  // A map read out of a list binding's element joins every function its elements' slots are
  // written (D15118).
  let el = false
  if rn is Index {
    r = parenPeelIx(rn.idxArr)
    rn = if r >= 0 && r < P.nodes.length { nodeAt(r) } else { rn }
    el = true
  }
  if !(rn is Ident) { return t }
  const bd = identDeclOf(r)
  if bd < 0 || !(nodeAt(bd) is LetDecl) { return t }
  const tf = T.tys[t]
  // A record a map's slot holds joins each function field with every function written there.
  if tf is TyObj && !el { return elabSlotRecJoinTy(bd, t) }
  if !(tf is TyFunc) { return t }
  const s = elabFnSetTy[t] ?? -1
  if s < 0 || i32ListHas(fnLetVeto, bd) { return t }
  // The slot's path under its root binding: a bound map's own slots, or its elements' maps'.
  const path: string[] = if el { ["[]", "[]"] } else { ["[]"] }
  const w = if el { fnPathSetOf(bd, path) } else { fnSlotSetOf(bd) }
  if w < 0 || w == s { return t }
  const u = fnSetIntern(fnSetUnion(s, w))
  if u == s { return t }
  let key = "slot:" + i32ToStr(bd)
  for st in path { key = key + "/" + st }
  key = key + "," + i32ToStr(t)
  const memo = fnJoinMemo[key] ?? -1
  if memo >= 0 && memo < T.tys.length { return memo }
  const ps: i32[] = []
  for p in tf.fnParamTypes { ps.push(p) }
  const g: Ty = { fnParamTypes: ps, fnRet: tf.fnRet }
  T.tys.push(g)
  const fresh = T.tys.length - 1
  elabFnSetTy[fresh] = u
  fnJoinMemo[key] = fresh
  if !i32ListHas(fnSlotWidened, bd) { fnSlotWidened.push(bd) }
  fresh
}

// Whether every member of set `s` is a named generic function: a set the tag rule can tag at a map
// slot's record field, which a closure set mono must pin would not be (D15493).
function fnSetAllNamedGenerics(s: i32): boolean {
  if s < 0 || s >= fnSets.length || fnSets[s].length == 0 { return false }
  for m in fnSets[s] {
    const f = if m >= 0 && m < P.nodes.length { nodeAt(m) } else { null }
    if !(f is FuncDecl) || f.fnName == "" || f.fnTyParams.length == 0 {
      return false
    }
  }
  true
}

// Grows record literal `v`, written into a map slot of joined record `slot`, to that record: each
// function field whose set the slot's widens takes the slot's, a parameter read excepted (D15455).
export function elabSlotRecLitGrow(v: i32, slot: i32) {
  const lx = parenPeelIx(v)
  if lx < 0 || lx >= P.nodes.length || slot < 0 || slot >= T.tys.length {
    return 0
  }
  const ln = nodeAt(lx)
  const so = T.tys[slot]
  if !(ln is ObjLit) || !(so is TyObj) { return 0 }
  let grew = false
  for fx in ln.objFields {
    const f = nodeAt(fx)
    const j = if f is FieldInit { strListIndexOf(so.objFieldNames, f.fiName) } else { -1 }
    const fv = if f is FieldInit { parenPeelIx(f.fiValue) } else { -1 }
    const st = if j >= 0 { so.objFieldTypes[j] } else { -1 }
    const ss = if st >= 0 { elabFnSetTy[st] ?? -1 } else { -1 }
    const vt = if fv >= 0 { nodeTyIxOf(fv) } else { -1 }
    const vs = if vt >= 0 { elabFnSetTy[vt] ?? -1 } else { -1 }
    const fd = if fv >= 0 && nodeAt(fv) is Ident { identDeclOf(fv) } else { -1 }
    const paramRead = fd >= 0 && fd < P.nodes.length && nodeAt(fd) is Param
    const within = vs >= 0 && vs != ss && fnSetIntern(fnSetUnion(vs, ss)) == ss
    if ss >= 0 && !paramRead && within {
      nodeTySetGrow(fv, st)
      grew = true
    }
  }
  if grew { nodeTySetGrow(lx, slot) }
  0
}

// Record `t` pinned into map binding `bd`'s slots, each function field's set joined with every
// function the binding's scope writes at that field of a slot, as a list literal's records join
// (D15493). Each record literal written into a slot is re-typed at the joined record; `t` when no
// field widens.
function elabSlotRecJoinTy(bd: i32, t: i32): i32 {
  const to = T.tys[t]
  if !(to is TyObj) || i32ListHas(fnLetVeto, bd) { return t }
  const names: string[] = []
  const tys: i32[] = []
  let changed = false
  let i = 0
  while i < to.objFieldNames.length {
    const nm = to.objFieldNames[i]
    let ft = to.objFieldTypes[i]
    const fa = if ft >= 0 && ft < T.tys.length { T.tys[ft] } else { null }
    const fs = if fa is TyFunc { elabFnSetTy[ft] ?? -1 } else { -1 }
    const w = if fs >= 0 { fnPathSetOf(bd, ["[]", nm]) } else { -1 }
    const u = if w >= 0 { fnSetIntern(fnSetUnion(fs, w)) } else { fs }
    if fa is TyFunc && u != fs && fnSetAllNamedGenerics(u) {
      const key = "slotrec:" + i32ToStr(bd) + "/" + nm + "," + i32ToStr(ft)
      let fresh = fnJoinMemo[key] ?? -1
      if fresh < 0 || fresh >= T.tys.length {
        const ps: i32[] = []
        for p in fa.fnParamTypes { ps.push(p) }
        const g: Ty = { fnParamTypes: ps, fnRet: fa.fnRet }
        T.tys.push(g)
        fresh = T.tys.length - 1
        elabFnSetTy[fresh] = u
        fnJoinMemo[key] = fresh
      }
      ft = fresh
      changed = true
    }
    names.push(nm)
    tys.push(ft)
    i = i + 1
  }
  if !changed { return t }
  const nt = mkObjTy(names, tys)
  // Each literal written into a slot holds the joined field, its named functions' leaves included.
  const vals: i32[] = []
  const ats: i32[] = []
  if cwSlotWrittenValues(cwKeyOfDecl(bd), ["[]"], vals, ats) >= 0 {
    for v in vals {
      const vn = if v >= 0 && v < P.nodes.length { nodeAt(v) } else { null }
      if vn is ObjLit {
        for fx in vn.objFields {
          const f = nodeAt(fx)
          const j = if f is FieldInit { strListIndexOf(names, f.fiName) } else { -1 }
          const fv = if f is FieldInit { parenPeelIx(f.fiValue) } else { -1 }
          const fd = if fv >= 0 && nodeAt(fv) is Ident { identDeclOf(fv) } else { -1 }
          const paramRead = fd >= 0
            && fd < P.nodes.length
            && nodeAt(fd) is Param
          if j >= 0 && fv >= 0 && !paramRead && tys[j] != to.objFieldTypes[j] {
            nodeTySetGrow(fv, tys[j])
          }
        }
        nodeTySetGrow(v, nt)
      }
    }
  }
  nt
}

// The type the field at `steps` (outermost first) of binding `bd`, inferred `t`, gives its reads,
// for a field holding a function or a list of them: `t` whose set also holds every function written
// into it, as `elabFnListLetTy` widens a list binding (D15166, D15119); `t` otherwise. Non-empty
// `seeds` stand for what the initialiser stores, a call's returned values (D15270).
export function elabFnFieldTy(
  bd: i32,
  steps: string[],
  t: i32,
  seeds: i32[],
): i32 {
  if bd < 0 || t < 0 || t >= T.tys.length || i32ListHas(fnLetVeto, bd) {
    return t
  }
  const ta = T.tys[t]
  const listed = ta is TyArray
  const e = if ta is TyArray { ta.aElem } else { t }
  if e < 0 || e >= T.tys.length { return t }
  const tf = T.tys[e]
  if !(tf is TyFunc) { return t }
  const s = elabFnSetTy[e] ?? -1
  if s < 0 { return t }
  const path: string[] = []
  for st in steps { path.push(st) }
  if listed { path.push("[]") }
  const name = fnFieldPathKey(steps)
  let w = -1
  if seeds.length == 0 {
    w = fnPathSetOf(bd, path)
  } else {
    const ts = cwPathFnTargetsFrom(bd, path, seeds)
    if ts.length > 0 && ts[0] >= 0 { w = fnSetIntern(fnSetSorted(ts)) }
  }
  if w < 0 { return t }
  // Records listed together share the slot, so their writes join it too.
  const vals: i32[] = []
  const ats: i32[] = []
  if !fnFieldListedWith(bd, path, vals, ats) { return t }
  // Bindings a call of the same function initialises hold the same returned literal (D15273).
  if seeds.length > 0 && !fnFieldCalledWith(bd, path, seeds, vals, ats) {
    return t
  }
  const ds: i32[] = []
  for v in vals {
    const d = cwFnValueDeclOf(v)
    if d < 0 { return t }
    if !i32ListHas(ds, d) { ds.push(d) }
  }
  if ds.length > 0 {
    w = fnSetIntern(fnSetUnion(w, fnSetIntern(fnSetSorted(ds))))
  }
  const u = fnSetIntern(fnSetUnion(s, w))
  if u == s { return t }
  let key = "field:" + i32ToStr(bd)
  for st in path { key = key + "/" + st }
  key = key + "," + i32ToStr(t)
  const memo = fnJoinMemo[key] ?? -1
  if memo >= 0 && memo < T.tys.length { return memo }
  const ps: i32[] = []
  for p in tf.fnParamTypes { ps.push(p) }
  const g: Ty = { fnParamTypes: ps, fnRet: tf.fnRet }
  T.tys.push(g)
  const fresh = T.tys.length - 1
  elabFnSetTy[fresh] = u
  // A record a call returns holds its literal's ids, so its set is decided with this one.
  if seeds.length > 0 {
    fnWidenSrcTo.push(u)
    fnWidenSrcFrom.push(s)
  }
  fnFieldWidened.push(bd)
  fnFieldWidenedName.push(name)
  const lt = if listed { mkArrayTy(fresh) } else { fresh }
  fnJoinMemo[key] = lt
  lt
}

// Adds to `vals` what each other binding a call of `bd`'s own callee initialises stores at
// `path`, that callee returning `seeds`, so bindings of one function's returned record share its
// field's set. False when one of those writes is not a literal's part.
function fnFieldCalledWith(
  bd: i32,
  path: string[],
  seeds: i32[],
  vals: i32[],
  ats: i32[],
): boolean {
  const b = if bd >= 0 && bd < P.nodes.length { nodeAt(bd) } else { null }
  if !(b is LetDecl) || b.letInit < 0 { return true }
  const c = nodeAt(parenPeelIx(b.letInit))
  if !(c is Call) || c.callFn < 0 { return true }
  const cf = parenPeelIx(c.callFn)
  if cf < 0 || cf >= P.nodes.length { return true }
  const cn = nodeAt(cf)
  if !(cn is Ident) { return true }
  const fx = fnDeclIx[cn.identName] ?? -1
  if fx < 0 || identDeclOf(cf) != fx { return true }
  const calls: i32[] = []
  cwFnCalls(fx, calls)
  for at in calls {
    if at >= 0 && cwIxCovers(at) && cwIxUpKind[at] == CW_UP_LETINIT {
      const d = cwIxUp[at]
      if d >= 0 && d != bd && d < P.nodes.length && nodeAt(d) is LetDecl {
        const dl = nodeAt(d)
        const di = if dl is LetDecl { dl.letInit } else { -1 }
        if cwSlotValuesFrom(cwKeyOfDecl(d), di, seeds, path, vals, ats) < 0 {
          return false
        }
      }
    }
  }
  true
}

// Adds to `vals` what each other binding listed beside `bd` in a list literal stores at `path`,
// so records listed together share their field's set, as a literal's elements join (D15195).
// False when one of those is not a literal's part.
function fnFieldListedWith(
  bd: i32,
  path: string[],
  vals: i32[],
  ats: i32[],
): boolean {
  const k = cwKeyOfDecl(bd)
  if k < 0 { return true }
  const ow = cwOccWalk(k)
  while cwOccNext(ow) {
    const r = ow.row
    const u = cwIxNode[r]
    if (
      cwIxKind[r] == CW_OCC_USE
      && u >= 0
      && cwIxCovers(u)
      && cwIxUpKind[u] == CW_UP_ELEM
    ) {
      const lit = cwIxUp[u]
      const ln = if lit >= 0 && lit < P.nodes.length { nodeAt(lit) } else { null }
      if ln is ArrayLit {
        for e in ln.arrElems {
          const pe = parenPeelIx(e)
          if pe >= 0 && pe < P.nodes.length && pe != u && nodeAt(pe) is Ident {
            const d = identDeclOf(pe)
            if d >= 0 && d != bd && nodeAt(d) is LetDecl {
              if cwSlotWrittenValues(cwKeyOfDecl(d), path, vals, ats) < 0 {
                return false
              }
            }
          }
        }
      }
    }
  }
  true
}

// Whether `elabFnFieldTy` widened the list field at `steps` of record binding `bd`.
// Whether the elaboration widened any function field of the record binding `bd`.
export function elabFnFieldWidenedAny(bd: i32): boolean {
  !i32ListHas(fnLetVeto, bd) && i32ListHas(fnFieldWidened, bd)
}

export function elabFnFieldWidened(bd: i32, steps: string[]): boolean {
  if i32ListHas(fnLetVeto, bd) { return false }
  const name = fnFieldPathKey(steps)
  let i = 0
  while i < fnFieldWidened.length {
    if fnFieldWidened[i] == bd && fnFieldWidenedName[i] == name { return true }
    i = i + 1
  }
  false
}

// Whether the function value `arg` names a member of the set slot type `want` carries, a slot
// type `elabSlotJoinTy` joined over the container's writes: such a value is one of the writes the
// join admitted, whatever its result at a call's arguments (D15160).
export function elabSlotSetHolds(want: i32, arg: i32): boolean {
  const s = fnTagSetOfTy(want)
  if s < 0 { return false }
  const d = cwFnValueDeclOf(arg)
  d >= 0 && i32ListHas(fnTagMembers(s), d)
}

// `steps` as one key, the field names joined by dots.
function fnFieldPathKey(steps: string[]): string {
  let k = ""
  for st in steps {
    if k != "" { k = k + "." }
    k = k + st
  }
  k
}

// Whether `elabSlotJoinTy` joined the slot writes of container binding `bd`, an open map's
// among them, and no check vetoed the join (D15137).
export function elabFnSlotWidened(bd: i32): boolean {
  i32ListHas(fnSlotWidened, bd) && !i32ListHas(fnLetVeto, bd)
}

// The type an un-annotated list binding `bd` with inferred `t` gives its reads: `t` whose element
// set also holds every function the binding's own scope writes into its slots, as the literal's
// elements join (D14645), its signature closed function type `closedAt` when that is not -1.
// `t` when nothing widens it or an earlier check vetoed the widening.
export function elabFnListLetTy(bd: i32, t: i32, closedAt: i32): i32 {
  if bd < 0 || t < 0 || t >= T.tys.length { return t }
  if closedAt < 0 && i32ListHas(fnLetVeto, bd) { return t }
  const ta = T.tys[t]
  if !(ta is TyArray) { return t }
  const e = ta.aElem
  if e < 0 || e >= T.tys.length { return t }
  const tf = T.tys[e]
  if !(tf is TyFunc) { return t }
  const s = elabFnSetTy[e] ?? -1
  if s < 0 { return t }
  const w = fnSlotSetOf(bd)
  if w < 0 || w == s { return t }
  const u = fnSetIntern(fnSetUnion(s, w))
  if u == s { return t }
  const key = "list"
    + i32ToStr(bd)
    + ","
    + i32ToStr(t)
    + ","
    + i32ToStr(closedAt)
  const memo = fnJoinMemo[key] ?? -1
  if memo >= 0 && memo < T.tys.length { return memo }
  const cf = if closedAt >= 0 && closedAt < T.tys.length { T.tys[closedAt] } else { tf }
  if !(cf is TyFunc) { return t }
  const ps: i32[] = []
  for p in cf.fnParamTypes { ps.push(p) }
  const g: Ty = { fnParamTypes: ps, fnRet: cf.fnRet }
  T.tys.push(g)
  const fresh = T.tys.length - 1
  elabFnSetTy[fresh] = u
  fnListWidened.push(bd)
  fnListWidenedElem.push(fresh)
  const lt = mkArrayTy(fresh)
  fnJoinMemo[key] = lt
  lt
}

// Appends to `out` each value a slot write of a list widened to set `s` stores that names member
// `d`, a write a callee makes through a parameter included, and returns the list's element type,
// or -1 when no such write lands only in lists of `s` (D14648).
export function fnTagWriteLeavesOf(d: i32, s: i32, out: i32[]): i32 {
  let et = -1
  let i = 0
  while i < fnListWidened.length {
    const vals: i32[] = []
    const ats: i32[] = []
    if (
      fnTagSetOfTy(fnListWidenedElem[i]) == s
      && cwSlotWrittenValues(cwKeyOfDecl(fnListWidened[i]), ["[]"], vals, ats) >= 0
    ) {
      for v in vals {
        if cwFnValueDeclOf(v) == d && !i32ListHas(out, v) {
          if !fnWriteOnlyInto(v, fnListWidened[i]) { return -1 }
          out.push(v)
          et = fnListWidenedElem[i]
        }
      }
    }
    i = i + 1
  }
  et
}

// Appends to `out` each value a slot write into a map binding of `held` whose value carries set `s`
// stores that names member `d`, a write a callee makes through a parameter included, and returns
// that map's value type; -1 when no such write lands only in maps of `s` (D15531).
export function fnTagMapWriteLeavesOf(
  d: i32,
  s: i32,
  held: i32[],
  out: i32[],
): i32 {
  let vt = -1
  for hb in held {
    const mt = fnMapBindValTy(hb)
    if mt >= 0 && fnTagSetOfTy(mt) == s {
      const vals: i32[] = []
      const ats: i32[] = []
      if cwSlotWrittenValues(cwKeyOfDecl(hb), ["[]"], vals, ats) >= 0 {
        for v in vals {
          if cwFnValueDeclOf(v) == d && !i32ListHas(out, v) {
            if !fnWriteOnlyIntoMap(v, s) { return -1 }
            out.push(v)
            vt = mt
          }
        }
      }
    }
  }
  vt
}

// The value type of map binding `hb`, a `let` whose initialiser or own type is a map; -1 otherwise.
function fnMapBindValTy(hb: i32): i32 {
  if hb < 0 || hb >= P.nodes.length { return -1 }
  const n = nodeAt(hb)
  if !(n is LetDecl) { return -1 }
  const t = if n.letInit >= 0 { nodeTyIxOf(n.letInit) } else { nodeTyIxOf(hb) }
  const m = if t >= 0 && t < T.tys.length { T.tys[t] } else { null }
  if m is TyMap { m.mVal } else { -1 }
}

// Whether the store of write value `v` lands only in maps whose value carries set `s`: its target
// roots at one, or at a parameter every call hands only such maps or such parameters.
function fnWriteOnlyIntoMap(v: i32, s: i32): boolean {
  if v < 0 || !cwIxCovers(v) { return false }
  const p = cwIxUp[v]
  if p < 0 { return false }
  const pn = nodeAt(p)
  let tgt = -1
  if pn is BinExpr && pn.binOp == "=" && parenPeelIx(pn.binRight) == v {
    tgt = pn.binLeft
  } else if pn is Call {
    const f = nodeAt(parenPeelIx(pn.callFn))
    if f is Member && f.memProp == "set" { tgt = f.memObj }
  }
  if tgt < 0 { return false }
  const path: string[] = []
  const root = cwSlotPath(tgt, path)
  if root < 0 || !(nodeAt(root) is Ident) { return false }
  fnMapArgOnlyOf(identDeclOf(root), s, 0)
}

// Whether declaration `d` is a map binding whose value carries set `s`, or a parameter every call
// hands only such bindings through such parameters.
function fnMapArgOnlyOf(d: i32, s: i32, depth: i32): boolean {
  if d < 0 || d >= P.nodes.length || depth > 8 { return false }
  const mt = fnMapBindValTy(d)
  if mt >= 0 { return fnTagSetOfTy(mt) == s }
  if !(nodeAt(d) is Param) { return false }
  const args: i32[] = []
  if !cwParamArgs(d, args) || args.length == 0 { return false }
  for a in args {
    const ap = parenPeelIx(a)
    if ap < 0 || !(nodeAt(ap) is Ident) { return false }
    if !fnMapArgOnlyOf(identDeclOf(ap), s, depth + 1) { return false }
  }
  true
}

// Whether the store of write value `v` lands only in lists widened to `bd`'s set: its target
// roots at one, or at a parameter every call hands one or another such parameter. The leaf then emits its id at
// every instance of the writing function.
function fnWriteOnlyInto(v: i32, bd: i32): boolean {
  if v < 0 || !cwIxCovers(v) { return false }
  const p = cwIxUp[v]
  if p < 0 { return false }
  const pn = nodeAt(p)
  let tgt = -1
  if pn is BinExpr && pn.binOp == "=" && parenPeelIx(pn.binRight) == v {
    tgt = pn.binLeft
  } else if pn is Call {
    const f = nodeAt(parenPeelIx(pn.callFn))
    if f is Member && f.memProp == "push" { tgt = f.memObj }
  }
  if tgt < 0 { return false }
  const path: string[] = []
  const root = cwSlotPath(tgt, path)
  if root < 0 || !(nodeAt(root) is Ident) { return false }
  fnArgOnlyFrom(identDeclOf(root), bd, 0)
}

// Whether `d` and `bd` are both widened list bindings of one set.
function fnWidenedSameSet(d: i32, bd: i32): boolean {
  const i = i32ListIndexOf(fnListWidened, d)
  const j = i32ListIndexOf(fnListWidened, bd)
  i >= 0
    && j >= 0
    && fnTagSetOfTy(fnListWidenedElem[i]) == fnTagSetOfTy(fnListWidenedElem[j])
}

// Whether declaration `d` is `bd` or a list widened to its set, or a parameter every call hands
// only such bindings through such parameters.
function fnArgOnlyFrom(d: i32, bd: i32, depth: i32): boolean {
  if d == bd || fnWidenedSameSet(d, bd) { return true }
  if d < 0 || depth > 8 || !(nodeAt(d) is Param) { return false }
  const args: i32[] = []
  // An uncalled function's body is still built, at its parameters' defaults.
  if !cwParamArgs(d, args) || args.length == 0 { return false }
  for a in args {
    const ap = parenPeelIx(a)
    if ap < 0 || !(nodeAt(ap) is Ident) { return false }
    if !fnArgOnlyFrom(identDeclOf(ap), bd, depth + 1) { return false }
  }
  true
}

// The functions list binding `bd` with inferred `t` holds once `elabFnListLetTy` widens it with
// its scope's writes, ascending; [] when it is not widened, is re-pointed, or its element
// signature is closed. An untagged set's veto does not apply: it is asked for a closed signature.
export function elabFnListOpenWideMembers(bd: i32, t: i32): i32[] {
  const none: i32[] = []
  if bd < 0 || t < 0 || t >= T.tys.length { return none }
  const ta = T.tys[t]
  if !(ta is TyArray) { return none }
  const e = ta.aElem
  if e < 0 || e >= T.tys.length || !(T.tys[e] is TyFunc) || !tyHasTyVar(e) {
    return none
  }
  const s = elabFnSetTy[e] ?? -1
  if s < 0 { return none }
  const w = fnSlotSetOf(bd)
  if w < 0 || w == s { return none }
  const u = fnSetIntern(fnSetUnion(s, w))
  if u == s || u < 0 || u >= fnSets.length { return none }
  // A re-pointed binding holds another literal's functions at its reads after the re-point.
  if cwLetRepointFnTargets(bd).length > 0 { return none }
  fnSets[u]
}

// Whether set `s` has a lambda member that reads a binding declared outside it.
export function fnSetHasCapturingLambda(s: i32): boolean {
  if s < 0 || s >= fnSets.length { return false }
  for m in fnSets[s] {
    const f = if m >= 0 && m < P.nodes.length { nodeAt(m) } else { null }
    if f is FuncDecl && f.fnName == "" && fnLambdaCaptures(m) { return true }
  }
  false
}

// Whether lambda `x` reads a binding declared outside it that it captures.
function fnLambdaCaptures(x: i32): boolean {
  const inside: Map<i32, boolean> = Map()
  const sub: i32[] = []
  const todo: i32[] = [x]
  while todo.length > 0 {
    const y = todo.pop() ?? -1
    if y >= 0 && y < P.nodes.length && !(inside[y] ?? false) {
      inside[y] = true
      sub.push(y)
      for c in nodeChildren(y) { todo.push(c) }
    }
  }
  for y in sub {
    if nodeAt(y) is Ident {
      const d = identDeclOf(y)
      if d >= 0 && !(inside[d] ?? false) && cwUseCaptures(y) { return true }
    }
  }
  false
}

// The smaller sets whose ids a widening to set `s` copied in, which `s` must share: the lists
// initialising list bindings widened to `s`, other than a literal the widening re-types, and the
// records a call returns into a binding whose function field widens to `s`.
export function fnWidenedSourceSets(s: i32): i32[] {
  const out: i32[] = []
  let j = 0
  while j < fnWidenSrcTo.length {
    const o = fnWidenSrcFrom[j]
    if fnWidenSrcTo[j] == s && o >= 0 && o != s && !i32ListHas(out, o) {
      out.push(o)
    }
    j = j + 1
  }
  for bd in fnListWidened {
    const n = if bd >= 0 && bd < P.nodes.length { nodeAt(bd) } else { null }
    if n is LetDecl && n.letInit >= 0 && !i32ListHas(fnLetVeto, bd) {
      const init = n.letInit
      const it = if init < P.nodes.length { nodeTyIxOf(init) } else { -1 }
      const ia = if it >= 0 && it < T.tys.length { T.tys[it] } else { null }
      const bt = nodeTyIxOf(bd)
      const ba = if bt >= 0 && bt < T.tys.length { T.tys[bt] } else { null }
      if ia is TyArray && ba is TyArray && fnTagSetOfTy(ba.aElem) == s {
        const o = fnTagSetOfTy(ia.aElem)
        if o >= 0 && o != s && !i32ListHas(out, o) { out.push(o) }
      }
    }
  }
  out
}

// The set list binding `bd`, initialised by a literal of type `t`, holds once its scope's writes
// join the literal's elements (`elabFnListLetTy`); -1 when nothing widens it.
export function elabFnListWideSet(bd: i32, t: i32): i32 {
  if bd < 0 || t < 0 || t >= T.tys.length { return -1 }
  const ta = T.tys[t]
  if !(ta is TyArray) { return -1 }
  const s = elabFnSetTy[ta.aElem] ?? -1
  const w = fnSlotSetOf(bd)
  if s < 0 || w < 0 || w == s { return -1 }
  fnSetIntern(fnSetUnion(s, w))
}

// Whether the list binding `bd` gives its reads a set widened with what its scope writes, and no
// check vetoed that widening; a call through its element then fixes its own member's tuple.
export function elabFnListWidened(bd: i32): boolean {
  i32ListHas(fnListWidened, bd) && !i32ListHas(fnLetVeto, bd)
}

// The set of every function the `let` node `bd` writes into its slots; -1 when one is not a
// function or there is none. Inside an instance the initialiser's elements are typed by that
// instance, so only the writes count: a parameter's elements hold the instance's set, not every
// call's.
function fnSlotSetOf(bd: i32): i32 {
  if elabCapOn { return fnSlotSetIn(bd, false) }
  const have = fnSlotSet[bd] ?? -2
  if have != -2 { return have }
  const s = fnSlotSetIn(bd, true)
  fnSlotSet[bd] = s
  s
}

// The set of the functions written at slot `path` under binding `bd`, or -1.
function fnPathSetOf(bd: i32, path: string[]): i32 {
  const ts = cwPathFnTargets(bd, path)
  if ts.length == 0 || ts[0] < 0 { return -1 }
  fnSetIntern(fnSetSorted(ts))
}

// `fnSlotSetOf`, counting the initialiser's elements when `inits`.
function fnSlotSetIn(bd: i32, inits: boolean): i32 {
  let s = -1
  const ts = cwLetSlotFnTargets(bd)
  if ts.length > 0 && ts[0] >= 0 { s = fnSetIntern(fnSetSorted(ts)) }
  // An alias's writes land in the list its source binds.
  const es = if inits { cwListElemFnTargets(bd) } else { cwListElemWriteFnTargets(bd) }
  if es.length > 0 && es[0] >= 0 {
    const e = fnSetIntern(fnSetSorted(es))
    s = if s >= 0 { fnSetIntern(fnSetUnion(s, e)) } else { e }
  }
  // A `let` re-pointed to another literal of functions holds that literal's too.
  const rs = cwLetRepointFnTargets(bd)
  if rs.length > 0 && rs[0] >= 0 {
    const r = fnSetIntern(fnSetSorted(rs))
    s = if s >= 0 { fnSetIntern(fnSetUnion(s, r)) } else { r }
  }
  s
}

// The functions a call through callee node `callFn` may reach: its type's set, and for a read of
// a `let`, or a field or element of what a `let` binds, each function its scope stores there.
// Generic members too, which the checker's own sets leave out.
export function elabCalleeTargets(callFn: i32): i32[] {
  const out: i32[] = []
  for m in elabFnSetOf(elabLiveTyOf(callFn)) { out.push(m) }
  const p = parenPeelIx(callFn)
  if p < 0 || p >= P.nodes.length { return out }
  // A `??` holds either side's functions: what its read holds, and its default (D15463).
  const pn = nodeAt(p)
  if pn is BinExpr && pn.binOp == "??" {
    elabTargetsAdd(out, elabCalleeTargets(pn.binLeft))
    const rd = cwFnValueDeclOf(pn.binRight)
    if rd >= 0 && !i32ListHas(out, rd) { out.push(rd) }
    elabTargetsAdd(out, elabCalleeTargets(pn.binRight))
    return out
  }
  // A read of a `let`: every function its scope writes to it.
  const bd = identDeclOf(p)
  if bd >= 0 {
    elabTargetsAdd(out, cwLetFnTargets(bd))
    elabTargetsAdd(out, cwLetCalledFnTargets(bd))
    elabTargetsAdd(out, cwFnValueTargets(cwBindingOf(p)))
    // A binding initialized from a field or element read holds what that read reaches.
    const bn = nodeAt(bd)
    if (
      bn is LetDecl
      && bn.letInit >= 0
      && !(nodeAt(parenPeelIx(bn.letInit)) is Ident)
    ) {
      elabTargetsAdd(out, elabCalleeTargets(bn.letInit))
    }
  }
  // A field or element read: every function its binding stores at that path.
  const path: string[] = []
  const root = cwSlotPath(p, path)
  // Read off a parameter: what every call hands it stores at that path.
  if (root >= 0 && path.length > 0) { elabParamPathTargets(root, path, out) }
  if (
    root < 0
    || path.length == 0
    || !cwFramedNode(root)
    || cwKeyOfRoot(root) < 0
  ) {
    return out
  }
  if path.length == 1 && path[0] == "[]" {
    const s = fnSlotSetOf(identDeclOf(root))
    if s >= 0 { elabTargetsAdd(out, fnSets[s]) }
  }
  const vals: i32[] = []
  const ats: i32[] = []
  if cwSlotWrittenValues(cwBindingOf(root), path, vals, ats) >= 0 {
    for v in vals {
      const d = cwFnValueDeclOf(v)
      if d >= 0 && !i32ListHas(out, d) { out.push(d) }
      // A stored `let` holds every function its scope writes to it.
      if d < 0 {
        const vb = identDeclOf(parenPeelIx(v))
        if vb >= 0 && nodeAt(vb) is LetDecl {
          elabTargetsAdd(out, cwLetFnTargets(vb))
        }
      }
    }
  }
  out
}

// Appends to `out` each function every call's argument for the parameter `root` reads stores at
// `path`, when each argument is a binding the write scan places; adds nothing otherwise.
function elabParamPathTargets(root: i32, path: string[], out: i32[]) {
  const pd = identDeclOf(root)
  if pd < 0 || !(nodeAt(pd) is Param) { return 0 }
  const args: i32[] = []
  if !cwParamArgs(pd, args) { return 0 }
  const found: i32[] = []
  for a in args {
    const ap = parenPeelIx(a)
    if ap < 0 { return 0 }
    const an = nodeAt(ap)
    // A record literal holds at a one-field path what its field is initialized to, or nothing.
    if an is ObjLit && path.length == 1 {
      for fi in an.objFields {
        const f = nodeAt(fi)
        if f is FieldInit && f.fiName == path[0] {
          const d = cwFnValueDeclOf(f.fiValue)
          if d < 0 { return 0 }
          if !i32ListHas(found, d) { found.push(d) }
        }
      }
      continue
    }
    // A list literal holds at an element path what each element may be.
    if an is ArrayLit && path[0] == "[]" {
      if !elabListLitPathTargets(ap, path, 0, found) { return 0 }
      continue
    }
    if !(an is Ident) { return 0 }
    const vals: i32[] = []
    const ats: i32[] = []
    if cwSlotWrittenValues(cwBindingOf(ap), path, vals, ats) < 0 { return 0 }
    for v in vals {
      const d = cwFnValueDeclOf(v)
      if d < 0 { return 0 }
      if !i32ListHas(found, d) { found.push(d) }
    }
  }
  elabTargetsAdd(out, found)
}

// Appends to `found` each function the list literal `e` holds at `path` from step `i`, every step
// an element (`[]`) of a nested list literal; false when one is not known to be a function.
function elabListLitPathTargets(
  e: i32,
  path: string[],
  i: i32,
  found: i32[],
): boolean {
  const p = parenPeelIx(e)
  if p < 0 || p >= P.nodes.length { return false }
  const n = nodeAt(p)
  if !(n is ArrayLit) || i >= path.length || path[i] != "[]" { return false }
  for el in n.arrElems {
    if i + 1 < path.length {
      if !elabListLitPathTargets(el, path, i + 1, found) { return false }
    } else {
      const ts = elabValueFnTargets(el)
      if ts.length == 0 || ts[0] < 0 { return false }
      for d in ts {
        if !i32ListHas(found, d) { found.push(d) }
      }
    }
  }
  true
}

// The functions the expression `e` may be: one named or written there, or each function the
// `let` it reads is written; [-1] when that is not known.
function elabValueFnTargets(e: i32): i32[] {
  const d = cwFnValueDeclOf(e)
  if d >= 0 { return [d] }
  const p = parenPeelIx(e)
  if p < 0 || !(nodeAt(p) is Ident) { return [-1] }
  const bd = identDeclOf(p)
  if bd < 0 || !(nodeAt(bd) is LetDecl) { return [-1] }
  const out: i32[] = []
  elabTargetsAdd(out, cwLetFnTargets(bd))
  elabTargetsAdd(out, cwFnValueTargets(cwBindingOf(p)))
  if out.length == 0 { [-1] } else { out }
}

// Appends to `out` each id of `ts` it lacks; a list led by -1 (not every value a function) adds
// none.
function elabTargetsAdd(out: i32[], ts: i32[]) {
  if ts.length == 0 || ts[0] < 0 { return 0 }
  for t in ts {
    if !i32ListHas(out, t) { out.push(t) }
  }
  0
}

// The ids `ts` without repeats, ascending.
function fnSetSorted(ts: i32[]): i32[] {
  const ms: i32[] = []
  for t in ts {
    if !i32ListHas(ms, t) {
      ms.push(t)
      let at = ms.length - 1
      while at > 0 && ms[at - 1] > t {
        ms[at] = ms[at - 1]
        at = at - 1
      }
      ms[at] = t
    }
  }
  ms
}

// The type node `ix` has in the running instance, while one is recorded, else the type the
// check recorded; -1 for none.
export function elabLiveTyOf(ix: i32): i32 {
  let t = -1
  if elabCapLive() { t = elabCapTy[ix] ?? -1 }
  if t < 0 { t = nodeTyIxOf(ix) }
  t
}

// The function a call through callee node `callFn` reaches by its value's singleton type, or -1.
export function elabCalleeFnId(callFn: i32): i32 {
  const t = elabLiveTyOf(callFn)
  // A `?.` callee is typed as its field's function behind `| null`.
  if t >= 0 && t < T.tys.length {
    const x = T.tys[t]
    if x is TyNullable { return elabFnIdOf(x.nInner) }
  }
  elabFnIdOf(t)
}

// The calls through a value of a set of two or more functions, once each in the order first
// seen; by call node, the set's id, its parameter types' spelling and whether the members give
// the call different results (D3975).
let fnTagCallIxs: i32[] = []
let fnTagCallSet: {[i32]: i32} = Map()
let fnTagCallKey: {[i32]: string} = Map()
let fnTagCallSplit: {[i32]: boolean} = Map()
let fnTagCallVoidSplit: {[i32]: boolean} = Map()
let fnTagCallRs: {[i32]: i32[]} = Map()
// By call node: the refusal a call whose members disagree owes when its set stays a closure.
let fnTagCallMsg: {[i32]: string} = Map()
let fnTagCallMsgAt: {[i32]: i32} = Map()
// By leaf node of a tagged set's value: the member whose id it emits.
let fnTagLeaf: {[i32]: i32} = Map()
// By leaf node of a tagged set's value: the set it is an id of.
let fnTagLeafSet: {[i32]: i32} = Map()
// By function declaration: one whose result is a tagged set's value.
let fnTagRet: {[i32]: boolean} = Map()
// By call node: a direct call of each member at the call's arguments, in set order.
let fnTagArms: {[i32]: i32[]} = Map()
// By call node and set id: the member calls of a generic call whose instances see another tagged
// set than the one its first note recorded.
let fnTagArmsBy: {[string]: i32[]} = Map()
// By arm call node: the member declaration it calls, recorded when the arm is built, so every
// pass checks the arm as a call of that member whatever its callee's name resolves to.
let fnTagArmMember: {[i32]: i32} = Map()
// By `let` declaration: the tagged set it holds, recorded when the set is tagged.
let fnTagBind: {[i32]: i32} = Map()
// Per union a shared type parameter is bound to (`fnTagSharedJoinSet`), the arguments' sets.
let fnTagJoinFrom: {[i32]: i32[]} = Map()
// Per call and argument, as `call * 64 + i`: the joined set the elaboration binds that argument's
// shared type parameter to (`elabSetArgBind`).
let fnTagCallJoin: {[i32]: i32} = Map()

// Whether call `ix` names the one member of set `s` by its own name: a direct call, not a call
// through a value of the set.
function fnTagSelfCall(ix: i32, s: i32): boolean {
  const c = nodeAt(ix)
  if !(c is Call) { return false }
  const ds = fnTagMembers(s)
  if ds.length != 1 || c.callFn < 0 || c.callFn >= P.nodes.length {
    return false
  }
  const n = nodeAt(c.callFn)
  const f = nodeAt(ds[0])
  if !(n is Ident) || !(f is FuncDecl) { return false }
  n.identName == f.fnName
}

// Notes the call `ix` through a value of set `s` at parameter types spelled `key`, `split`
// when its members give it different results; clears any refusal an earlier pass recorded.
export function fnTagCallNote(
  ix: i32,
  s: i32,
  key: string,
  split: boolean,
  rs: i32[],
) {
  if fnTagSelfCall(ix, s) { return 0 }
  if !fnTagCallSet.has(ix) { fnTagCallIxs.push(ix) }
  fnTagCallSet[ix] = s
  fnTagCallKey[ix] = key
  fnTagCallSplit[ix] = split
  fnTagCallVoidSplit[ix] = split && rsVoidSplit(rs)
  fnTagCallRs[ix] = rs
  fnTagCallMsg[ix] = ""
  fnTagCallMsgAt[ix] = -1
  0
}

// Records the refusal `msg` at `at` that call `ix` owes unless its set is tagged.
export function fnTagCallRefusal(ix: i32, msg: string, at: i32) {
  fnTagCallMsg[ix] = msg
  fnTagCallMsgAt[ix] = at
  0
}

// Every call `fnTagCallNote` recorded, in the order first seen.
export function fnTagCalls(): i32[] { fnTagCallIxs }

// The set id call `ix` goes through, or -1.
export function fnTagCallSetOf(ix: i32): i32 { fnTagCallSet[ix] ?? -1 }

// The sets a call's callee is typed with, each beside the closed argument types of its calls
// (-1 for a call with an open one), and whether some callee is an open function type no set
// names; read by `fnSetCalledWithAny` and `fnSetCallArgsOf`.
let fnSetCallees: i32[] = []
let fnSetCalleeArgs: i32[][][] = []
// Beside each tuple, per argument, the generic function declaration an open argument names, or -1.
let fnSetCalleeGens: i32[][][] = []
let fnSetOpenCallee = false
// "holder|path" of each binding slot a call reads its callee from, beside each call's closed
// argument tuple (-1 for an open argument).
let fnSlotCallAt: {[string]: i32} = Map()
let fnSlotCallArgs: i32[][][] = []
// Each slot's calls that read their callee from it as the slot: not a const element read that
// names one function.
let fnSlotThrough: {[string]: i32[]} = Map()
// "holder|path" of each binding slot a read hands as an argument to a parameter annotated with a
// closed function type, beside each such annotation.
let fnSlotAnnTys: {[string]: i32[]} = Map()

// The slots a read of which is handed to a parameter whose function type is open, so each call
// picks the signature it delivers there, for `fnSlotHandedOpen`.
let fnSlotOpenHands: {[string]: boolean} = Map()

// Notes the type `ct` a call through a function value checked its callee at, with its argument
// types `args` and the generic declaration `gens` each open argument names (-1 for none): its set,
// or an open function type with none; a call naming a declared function is no such call.
export function fnSetCalleeNote(
  ct: i32,
  named: boolean,
  args: i32[],
  gens: i32[],
) {
  if named || ct < 0 || ct >= T.tys.length || !(T.tys[ct] is TyFunc) {
    return 0
  }
  const s = elabFnSetTy[ct] ?? -1
  if s >= 0 {
    let at = i32ListIndexOf(fnSetCallees, s)
    if at < 0 {
      fnSetCallees.push(s)
      fnSetCalleeArgs.push([])
      fnSetCalleeGens.push([])
      at = fnSetCallees.length - 1
    }
    const tup: i32[] = []
    const gen: i32[] = []
    let i = 0
    while i < args.length {
      const a = args[i]
      const closed = a >= 0 && !tyHasTyVar(a)
      tup.push(if closed { a } else { -1 })
      gen.push(if !closed && i < gens.length { gens[i] } else { -1 })
      i = i + 1
    }
    fnSetCalleeArgs[at].push(tup)
    fnSetCalleeGens[at].push(gen)
  } else if tyHasTyVar(ct) {
    fnSetOpenCallee = true
  }
  0
}

// The one tuple of closed argument types every noted call through a set holding one of `ds` is
// made at; empty when there is none, two differ, or one is open.
export function fnSetCallArgsOf(ds: i32[]): i32[] {
  let one: i32[] = []
  let have = false
  let i = 0
  while i < fnSetCallees.length {
    const cs = fnSetCallees[i]
    let hits = false
    if cs >= 0 && cs < fnSets.length {
      for d in fnSets[cs] {
        if i32ListHas(ds, d) { hits = true }
      }
    }
    if hits {
      for tup in fnSetCalleeArgs[i] {
        if i32ListHas(tup, -1) { return [] }
        if have && !tyListSame(one, tup) { return [] }
        one = tup
        have = true
      }
    }
    i = i + 1
  }
  one
}

// The generic function declaration every noted call through a set holding one of `ds` hands at
// argument `i`; -1 where none is noted, one call hands another value there, or two differ.
export function fnSetCallGenAt(ds: i32[], i: i32): i32 {
  let g = -1
  let at = 0
  while at < fnSetCallees.length {
    const cs = fnSetCallees[at]
    let hits = false
    if cs >= 0 && cs < fnSets.length {
      for d in fnSets[cs] {
        if i32ListHas(ds, d) { hits = true }
      }
    }
    if hits {
      for gen in fnSetCalleeGens[at] {
        const one = if i < gen.length { gen[i] } else { -1 }
        if one < 0 || (g >= 0 && one != g) { return -1 }
        g = one
      }
    }
    at = at + 1
  }
  g
}

// Whether lists `a` and `b` name the same types in order.
// Notes a call whose callee is read from slot `path` of binding `holder`, with its arguments'
// types `args`, for `fnSlotCallArgsOf`.
export function fnSlotCallNote(
  holder: i32,
  path: string[],
  args: i32[],
  through: i32,
) {
  if holder < 0 { return 0 }
  const key = fnSlotKey(holder, path)
  if through >= 0 {
    const cs = fnSlotThrough[key] ?? []
    if !i32ListHas(cs, through) { cs.push(through) }
    fnSlotThrough[key] = cs
  }
  let at = fnSlotCallAt[key] ?? -1
  if at < 0 {
    fnSlotCallArgs.push([])
    at = fnSlotCallArgs.length - 1
    fnSlotCallAt[key] = at
  }
  const tup: i32[] = []
  for a in args { tup.push(if a >= 0 && !tyHasTyVar(a) { a } else { -1 }) }
  fnSlotCallArgs[at].push(tup)
  // An instance's re-check notes the call again under that instance's key.
  if elabCapLive() && elabCapKey >= 0 {
    const kk = key + "#" + i32ToStr(elabCapKey)
    let ka = fnSlotCallAt[kk] ?? -1
    if ka < 0 {
      fnSlotCallArgs.push([])
      ka = fnSlotCallArgs.length - 1
      fnSlotCallAt[kk] = ka
    }
    fnSlotCallArgs[ka].push(tup)
  }
  0
}

// Notes a read of slot `path` of binding `holder` handed as an argument to a parameter annotated
// with the closed function type `ft`, for `fnSlotAnnTyOf`; a quiet probe notes nothing.
export function fnSlotAnnNote(holder: i32, path: string[], ft: i32) {
  if (
    inferQuiet
    || holder < 0
    || ft < 0
    || ft >= T.tys.length
    || !(T.tys[ft] is TyFunc)
  ) {
    return 0
  }
  if tyHasTyVar(ft) {
    fnSlotOpenHands[fnSlotKey(holder, path)] = true
    return 0
  }
  const key = fnSlotKey(holder, path)
  const have = fnSlotAnnTys[key] ?? []
  for t in have {
    if tySame(t, ft) { return 0 }
  }
  have.push(ft)
  fnSlotAnnTys[key] = have
  0
}

// Whether a read of slot `path` of `holder` is handed to a parameter whose function type is open.
export function fnSlotHandedOpen(holder: i32, path: string[]): boolean {
  fnSlotOpenHands.has(fnSlotKey(holder, path))
}

// The one closed function type every parameter a read of slot `path` of `holder` is handed to is
// annotated with; -1 when none is, or two differ.
export function fnSlotAnnTyOf(holder: i32, path: string[]): i32 {
  const have = fnSlotAnnTys[fnSlotKey(holder, path)] ?? []
  if have.length != 1 { return -1 }
  have[0]
}

function fnSlotKey(holder: i32, path: string[]): string {
  let k = i32ToStr(holder) + "|"
  for p in path { k = k + p + "/" }
  k
}

// The calls reading their callee through slot `path` of `holder` as the slot, not as a const
// element read that names one function.
export function fnSlotThroughCalls(holder: i32, path: string[]): i32[] {
  fnSlotThrough[fnSlotKey(holder, path)] ?? []
}

// The one tuple of closed argument types every call reading its callee from slot `path` of
// `holder` is made at; empty when none is, two differ, or one is open.
export function fnSlotCallArgsOf(holder: i32, path: string[]): i32[] {
  fnSlotCallArgsAt(holder, path, -1)
}

// `fnSlotCallArgsOf` over the calls instance `k`'s re-check noted (-1: every call, unkeyed).
export function fnSlotCallArgsAt(holder: i32, path: string[], k: i32): i32[] {
  const none: i32[] = []
  const key = fnSlotKey(holder, path)
    + (if k >= 0 { "#" + i32ToStr(k) } else { "" })
  const at = fnSlotCallAt[key] ?? -1
  if at < 0 { return none }
  let one: i32[] = []
  let have = false
  for tup in fnSlotCallArgs[at] {
    for a in tup {
      if a < 0 { return none }
    }
    if have && !tyListSame(one, tup) { return none }
    one = tup
    have = true
  }
  one
}

function tyListSame(a: i32[], b: i32[]): boolean {
  if a.length != b.length { return false }
  let i = 0
  while i < a.length {
    if !tySame(a[i], b[i]) { return false }
    i = i + 1
  }
  true
}

export function fnSetCalledWithAny(ds: i32[]): boolean {
  if fnSetOpenCallee { return true }
  for cs in fnSetCallees {
    if cs >= 0 && cs < fnSets.length {
      for d in fnSets[cs] {
        if i32ListHas(ds, d) { return true }
      }
    }
  }
  for ix in fnTagCallIxs {
    const cs = fnTagCallSet[ix] ?? -1
    if cs >= 0 && cs < fnSets.length {
      for d in fnSets[cs] {
        if i32ListHas(ds, d) { return true }
      }
    }
  }
  false
}

// Whether call `ix`'s members give it different results.
export function fnTagCallSplits(ix: i32): boolean {
  fnTagCallSplit[ix] ?? false
}

// Whether call `ix`'s members split only as nothing against one value (`rsVoidSplit`).
export function fnTagCallSplitsVoid(ix: i32): boolean {
  fnTagCallVoidSplit[ix] ?? false
}

// What each member of call `ix`'s set returns there, in set order.
export function fnTagCallRsOf(ix: i32): i32[] {
  const none: i32[] = []
  fnTagCallRs[ix] ?? none
}

// The refusal call `ix` owes when its set is not tagged, "" for none, and where it lands.
export function fnTagCallMsgOf(ix: i32): string { fnTagCallMsg[ix] ?? "" }
export function fnTagCallMsgAtOf(ix: i32): i32 { fnTagCallMsgAt[ix] ?? -1 }

// The set id type `t` carries, or -1.
export function fnTagSetOfTy(t: i32): i32 {
  if t < 0 { return -1 }
  elabFnSetTy[t] ?? -1
}

// The functions the slot `path` of a value of type `t` can hold, each step `e` an element, `v` a
// map's value, `r` a call's result or `f.<name>` a field: the members of the set its type carries,
// [] where the type carries none.
export function fnTagSlotMembers(t: i32, path: string[]): i32[] {
  let c = t
  for k in path {
    while c >= 0 && c < T.tys.length && T.tys[c] is TyNullable {
      const n = T.tys[c]
      c = if n is TyNullable { n.nInner } else { -1 }
    }
    if c < 0 || c >= T.tys.length { return [] }
    const ct = T.tys[c]
    if (k == "e" || k == "v") && ct is TyArray {
      c = ct.aElem
    } else if (k == "e" || k == "v") && ct is TyMap {
      c = ct.mVal
    } else if k == "r" && ct is TyFunc {
      c = ct.fnRet
    } else if ct is TyObj && k.length > 2 && k.slice(0, 2) == "f." {
      const i = strListIndexOf(ct.objFieldNames, k.slice(2, k.length))
      if i < 0 { return [] }
      c = ct.objFieldTypes[i]
    } else {
      return []
    }
  }
  while c >= 0 && c < T.tys.length && T.tys[c] is TyNullable {
    const n = T.tys[c]
    c = if n is TyNullable { n.nInner } else { -1 }
  }
  const out: i32[] = []
  for m in fnTagMembers(fnTagSetOfTy(c)) { out.push(m) }
  out
}

// Whether a value of type `t` holds one of two or more declared functions, chosen where it is made.
export function fnTagChoiceOfTy(t: i32): boolean {
  const ds = fnTagMembers(fnTagSetOfTy(t))
  if ds.length < 2 { return false }
  for d in ds {
    const f = nodeAt(d)
    if !(f is FuncDecl) { return false }
  }
  true
}

// Whether a value of type `t` holds one of a set of named non-generic functions, of any size.
export function fnTagSetValueOfTy(t: i32): boolean {
  const s = fnTagSetOfTy(t)
  const ds = fnTagMembers(s)
  if ds.length == 0 || fnSetHasGeneric(s) { return false }
  for d in ds {
    const f = nodeAt(d)
    if !(f is FuncDecl) || f.fnName == "" { return false }
  }
  true
}

// Whether a value of type `t` is one lambda with an open parameter: it has no one closure
// signature, so its delivery to a closed function type is decided by the set (D14884).
export function fnTagHoleLambdaOfTy(t: i32): boolean {
  const ds = fnTagMembers(fnTagSetOfTy(t))
  if ds.length != 1 || ds[0] < 0 || ds[0] >= P.nodes.length { return false }
  const f = nodeAt(ds[0])
  if !(f is FuncDecl) || f.fnName != "" || f.fnTyParams.length > 0 {
    return false
  }
  for p in f.fnParams {
    const q = nodeAt(p)
    if q is Param && q.parType < 0 { return true }
  }
  false
}

// Whether the value at `site`, of type `t`, is a choice: one of two or more declared functions,
// or a one-member `if` or `match`, directly or through the `const` or `let` it initialises.
export function fnTagChoiceAt(site: i32, t: i32): boolean {
  if fnTagChoiceOfTy(t) { return true }
  const ds = fnTagMembers(fnTagSetOfTy(t))
  if ds.length != 1 || !(nodeAt(ds[0]) is FuncDecl) { return false }
  let x = fnTagPeel(site)
  if x < 0 { return false }
  const n = nodeAt(x)
  if n is Ident {
    const ld = identDeclOf(x)
    if ld < 0 { return false }
    const l = nodeAt(ld)
    if !(l is LetDecl) { return false }
    x = fnTagPeel(l.letInit)
  }
  if x < 0 { return false }
  const v = nodeAt(x)
  v is IfStmt || v is MatchExpr
}

// The node `ix` names through parentheses.
function fnTagPeel(ix: i32): i32 {
  if ix < 0 { return ix }
  const e = nodeAt(ix)
  if e is Paren { return fnTagPeel(e.parInner) }
  ix
}

// A choice delivered where a closed function type is expected is built there as a closure over
// the value, chosen once, when its set is tagged: one check notes the sites, and the next builds
// them (`fnTagEtaAgain`).
let fnTagEscapes: i32[] = []
let fnTagEscapeTys: i32[] = []
let fnTagEscapeDsts: i32[] = []
let fnTagEtaSites: i32[] = []
let fnTagEtaRan = false

// The widened `let` types of this check and their `let` nodes; the `let`s whose widened set the
// decision left untagged, which the next check gives their initialiser's type.
let fnLetWide: i32[] = []
let fnLetWideAt: i32[] = []
// The widened `let` reads this check handed to an open function parameter, and their `let`s: the
// callee's instances bind that parameter to the set, which only the decision after them sees.
let fnLetOpenHands: i32[] = []
let fnLetOpenHandBds: i32[] = []
// Each un-annotated parameter, keyed `decl|index`, → the set of the value each call hands it, -1
// for a value of no set.
let fnParamHands: {[string]: i32[]} = Map()
// Beside each, the declaration whose body holds the call (-1 at module scope) and the argument.
let fnParamHandFroms: {[string]: i32[]} = Map()
let fnParamHandArgs: {[string]: i32[]} = Map()
// The `let`s a delivery to a closed function type reads, whose adapter only the first decision's
// tag builds.
let fnLetEscBds: i32[] = []
// The list bindings `elabFnListLetTy` widened in this check.
let fnListWidened: i32[] = []
let fnListWidenedElem: i32[] = []
// The container bindings `elabSlotJoinTy` widened.
let fnSlotWidened: i32[] = []
// The record bindings, and their list fields, `elabFnFieldTy` widened.
let fnFieldWidened: i32[] = []
// Each set a widening copied a smaller set's ids into, beside that smaller set (D15270).
let fnWidenSrcTo: i32[] = []
let fnWidenSrcFrom: i32[] = []
let fnFieldWidenedName: string[] = []
let fnLetVeto: i32[] = []
// The list literals whose open element signature the functions written into their binding closed.
let fnListClosedLits: i32[] = []

// Notes list literal `lit` as one whose element signature its binding's writes closed, so each
// generic it names is delivered at that signature.
export function elabFnListClosedNote(lit: i32) {
  if !i32ListHas(fnListClosedLits, lit) { fnListClosedLits.push(lit) }
}

// Whether `elabFnListClosedNote` noted list literal `lit`.
export function elabFnListClosedLit(lit: i32): boolean {
  i32ListHas(fnListClosedLits, lit)
}

// Keeps the delivered-value rows whose every type is below `base`; 0 drops them all.
function elabWideRowsKeep(base: i32) {
  const d: i32[] = []
  const f: i32[] = []
  const n: string[][] = []
  const t: i32[][] = []
  const rt: i32[] = []
  let r = 0
  while r < elabWideRowDecl.length {
    let stable = elabWideRowRet[r] >= 0 && elabWideRowRet[r] < base
    for x in elabWideRowT[r] {
      if x < 0 || x >= base { stable = false }
    }
    if stable {
      d.push(elabWideRowDecl[r])
      f.push(elabWideRowFrom[r])
      n.push(elabWideRowN[r])
      t.push(elabWideRowT[r])
      rt.push(elabWideRowRet[r])
    }
    r = r + 1
  }
  elabWideRowDecl = d
  elabWideRowFrom = f
  elabWideRowN = n
  elabWideRowT = t
  elabWideRowRet = rt
  0
}

// A restart re-mints the type arena past the builtins it begins with, so a row banked by the pass
// before keeps only when every type it names is one of those (an index below the fresh arena).
function elabHoleRowsKeepStable() {
  const base = T.tys.length
  elabWideRowsKeep(base)
  const d: i32[] = []
  const f: i32[] = []
  const e: i32[] = []
  const n: string[][] = []
  const t: i32[][] = []
  const bn: string[][] = []
  const bt: i32[][] = []
  let r = 0
  while r < elabHoleRowDecl.length {
    let stable = true
    for x in elabHoleRowT[r] {
      if x < 0 || x >= base { stable = false }
    }
    if stable {
      d.push(elabHoleRowDecl[r])
      f.push(elabHoleRowFrom[r])
      e.push(-1)
      n.push(elabHoleRowN[r])
      t.push(elabHoleRowT[r])
      // A binding entry naming a type the restart re-mints is left out.
      const kn: string[] = []
      const kt: i32[] = []
      let j = 0
      while j < elabHoleRowBindN[r].length && j < elabHoleRowBindT[r].length {
        const x = elabHoleRowBindT[r][j]
        if x >= 0 && x < base {
          kn.push(elabHoleRowBindN[r][j])
          kt.push(x)
        }
        j = j + 1
      }
      bn.push(kn)
      bt.push(kt)
    }
    r = r + 1
  }
  elabHoleRowDecl = d
  elabHoleRowFrom = f
  elabHoleRowEpoch = e
  elabHoleRowN = n
  elabHoleRowT = t
  elabHoleRowBindN = bn
  elabHoleRowBindT = bt
  const dd: i32[] = []
  const dt: i32[][] = []
  r = 0
  while r < elabDefaultRowDecl.length {
    let stable = true
    for x in elabDefaultRowT[r] {
      if x < 0 || x >= base { stable = false }
    }
    if stable {
      dd.push(elabDefaultRowDecl[r])
      dt.push(elabDefaultRowT[r])
    }
    r = r + 1
  }
  elabDefaultRowDecl = dd
  elabDefaultRowT = dt
  0
}

// Forgets every fact keyed by a type index, which a restart of the check re-mints from an empty
// arena: a stale entry would give another type a set. A call through a set is one only in the
// check that last typed it, so its note goes too: a callee the next check types closed is a
// closure call, and the decision must not tag a set on its account.
export function fnTyFactsReset() {
  elabHoleRowsKeepStable()
  elabPinBindN = []
  elabPinBindT = []
  mintReset()
  fnTagUndecide()
  elabFnSetTy = Map()
  fnTagCallIxs = []
  fnTagCallSet = Map()
  fnTagCallKey = Map()
  fnTagCallSplit = Map()
  fnTagCallVoidSplit = Map()
  fnTagCallRs = Map()
  fnTagCallMsg = Map()
  fnTagCallMsgAt = Map()
  fnJoinMemo = Map()
  fnLetReadTy = Map()
  fnLetWide = []
  fnLetWideAt = []
  fnLetOpenHands = []
  fnLetOpenHandBds = []
  fnParamHands = Map()
  fnParamHandFroms = Map()
  fnParamHandArgs = Map()
  fnLetEscBds = []
  fnListWidened = []
  fnListWidenedElem = []
  fnSlotWidened = []
  fnFieldWidened = []
  fnFieldWidenedName = []
  fnWidenSrcTo = []
  fnWidenSrcFrom = []
  0
}

// Forgets the sites of an earlier program; once per `checkProgram`.
export function fnTagEtaReset() {
  fnTagEtaSites = []
  fnTagEtaSetAt = Map()
  fnTagEtaRan = false
  fnTagEscapes = []
  fnTagEscapeTys = []
  fnTagEscapeDsts = []
  fnLetWide = []
  fnLetWideAt = []
  fnLetOpenHands = []
  fnLetOpenHandBds = []
  fnParamHands = Map()
  fnParamHandFroms = Map()
  fnParamHandArgs = Map()
  fnLetEscBds = []
  fnListWidened = []
  fnListWidenedElem = []
  fnSlotWidened = []
  fnFieldWidened = []
  fnFieldWidenedName = []
  fnWidenSrcTo = []
  fnWidenSrcFrom = []
  fnListClosedLits = []
  fnLetVeto = []
}

// Notes delivery `site` for the decision that may build it, once the set its value or its
// destination type `ty` carries is tagged.
export function fnTagEscapeNote(site: i32, ty: i32, dst: i32) {
  if fnTagEtaRan { return }
  const bd = identDeclOf(parenPeelIx(site))
  if bd >= 0 && !i32ListHas(fnLetEscBds, bd) { fnLetEscBds.push(bd) }
  fnTagEscapes.push(site)
  fnTagEscapeTys.push(ty)
  fnTagEscapeDsts.push(dst)
}

// The destination types noted beside `fnTagEscapesTake`'s sites, in order, which the decision
// then forgets.
export function fnTagEscapeDstsTake(): i32[] {
  const out = fnTagEscapeDsts
  fnTagEscapeDsts = []
  out
}

// The deliveries noted this check, which the decision then forgets.
export function fnTagEscapesTake(): i32[] {
  const out = fnTagEscapes
  fnTagEscapes = []
  out
}

// The types noted beside `fnTagEscapesTake`'s sites, in order, which the decision then forgets.
export function fnTagEscapeTysTake(): i32[] {
  const out = fnTagEscapeTys
  fnTagEscapeTys = []
  out
}

// The set each delivery asked to be built carried, by site, kept until the next program.
let fnTagEtaSetAt: {[i32]: i32} = Map()

// The sets of the deliveries this check builds as closures over their values, each once.
export function fnTagEtaBuiltSets(): i32[] {
  const out: i32[] = []
  if !fnTagEtaRan { return out }
  for site in fnTagEtaSites {
    const s = fnTagEtaSetAt[site] ?? -1
    if s >= 0 && !i32ListHas(out, s) { out.push(s) }
  }
  out
}

// The set delivery `site` carried when it asked to be built, or -1.
export function fnTagEtaSetOf(site: i32): i32 { fnTagEtaSetAt[site] ?? -1 }

// Whether delivery `site` is built as a closure over its value.
export function fnTagEtaAt(site: i32): boolean {
  fnTagEtaRan && i32ListHas(fnTagEtaSites, site)
}

// Asks for `site`, a set an adapter this check builds passes on to a closed parameter, to be
// built as well.
export function fnTagEtaInner(site: i32) {
  if fnTagEtaRan && !i32ListHas(fnTagEtaSites, site) {
    fnTagEtaSites.push(site)
  }
}

// Asks for delivery `site` of set `s` to be built; true when it is new.
export function fnTagEtaWant(site: i32, s: i32): boolean {
  if fnTagEtaRan || i32ListHas(fnTagEtaSites, site) { return false }
  fnTagEtaSites.push(site)
  fnTagEtaSetAt[site] = s
  true
}

// Notes `site`, a read handed to a function parameter whose type is still open at the call, when
// it reads a `let` this check widened.
export function fnLetOpenHandNote(site: i32) {
  const bd = identDeclOf(site)
  if bd < 0 || (fnLetReadTy[bd] ?? -1) < 0 || i32ListHas(fnLetOpenHands, site) {
    return 0
  }
  fnLetOpenHands.push(site)
  fnLetOpenHandBds.push(bd)
  0
}

// Notes that a call in the body of `from` (-1 at module scope) hands parameter `i` of function
// `decl` argument `arg`, of type `argTy`.
export function fnParamHandNote(
  decl: i32,
  i: i32,
  argTy: i32,
  from: i32,
  arg: i32,
) {
  if decl < 0 || i < 0 { return 0 }
  const key = i32ToStr(decl) + "|" + i32ToStr(i)
  const have = fnParamHands[key] ?? []
  have.push(fnTagSetOfTy(argTy))
  fnParamHands[key] = have
  const fr = fnParamHandFroms[key] ?? []
  fr.push(from)
  fnParamHandFroms[key] = fr
  const ar = fnParamHandArgs[key] ?? []
  ar.push(arg)
  fnParamHandArgs[key] = ar
  0
}

// Beside `fnParamHandSets`, the argument each call hands.
export function fnParamHandArgsOf(decl: i32, i: i32): i32[] {
  fnParamHandArgs[i32ToStr(decl) + "|" + i32ToStr(i)] ?? []
}

// Beside `fnParamHandSets`, the declaration each call is in, -1 at module scope.
export function fnParamHandFromsOf(decl: i32, i: i32): i32[] {
  fnParamHandFroms[i32ToStr(decl) + "|" + i32ToStr(i)] ?? []
}

// The set of the value each call hands parameter `i` of `decl`, -1 for a value of no set.
export function fnParamHandSets(decl: i32, i: i32): i32[] {
  fnParamHands[i32ToStr(decl) + "|" + i32ToStr(i)] ?? []
}

// Whether read `site` of a widened `let` is handed to an open function parameter.
export function fnLetOpenHandAt(site: i32): boolean {
  i32ListHas(fnLetOpenHands, site)
}

// Whether `t` is the type a `let` written with other functions than its initialiser gives its reads.
export function fnLetIsWide(t: i32): boolean { i32ListHas(fnLetWide, t) }

// Whether the program is checked once more, at most once: to build the sites asked for, or to
// give a `let` whose widened set stayed untagged its initialiser's type.
export function fnTagEtaAgain(): boolean {
  if fnTagEtaRan { return false }
  let i = 0
  while i < fnLetWide.length && i < fnLetWideAt.length {
    // A `let` handed to an open parameter is decided after the elaboration, which instances the
    // callee with that parameter bound to the whole set, unless a closed delivery needs it built.
    const bd = fnLetWideAt[i]
    const late = i32ListHas(fnLetOpenHandBds, bd)
      && !i32ListHas(fnLetEscBds, bd)
    if !fnTagTyIsTagged(fnLetWide[i]) && !late { fnLetVeto.push(bd) }
    i = i + 1
  }
  if fnTagEtaSites.length == 0 && fnLetVeto.length == 0 { return false }
  fnTagEtaRan = true
  true
}

// The members of set `s`, ascending.
// How many sets of functions the program holds; set ids run from 0 below it.
export function fnTagSetCount(): i32 { fnSets.length }

export function fnTagMembers(s: i32): i32[] {
  const none: i32[] = []
  if s < 0 || s >= fnSets.length { return none }
  fnSets[s]
}

// Whether type `t` is a list of a tagged set's ids, whose cell is the i32 list, or a list of such
// lists.
export function fnTagListTy(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const a = T.tys[t]
  if a is TyArray { return fnTagTyIsTagged(a.aElem) || fnTagListTy(a.aElem) }
  false
}

// Whether type `t` holds a tagged set's ids: such a list or map, a list of such lists, or a record
// with a field that is one or holds one, at most `depth` levels deep.
export function fnTagHoldsTy(t: i32, depth: i32): boolean {
  if depth <= 0 || t < 0 || t >= T.tys.length { return false }
  const o = T.tys[t]
  match o {
    TyArray => {
      return fnTagTyIsTagged(o.aElem) || fnTagHoldsTy(o.aElem, depth - 1)
    }
    TyObj => {
      for f in o.objFieldTypes {
        if fnTagTyIsTagged(f) || fnTagHoldsTy(f, depth - 1) { return true }
      }
      return false
    }
    TyMap => {
      return fnTagTyIsTagged(o.mVal)
    }
    // No other kind holds ids as a container.
    TyPrim | TyErr | TyFunc | TyUnion | TyNullable | TyVar | TyLit | TyNeg => {
      return false
    }
  }
}

// The rep each held list literal and `let` of a tagged set is built at, stamped when the set is
// tagged: its type with every list of the set's ids the `i32` list it is (D15220).
let fnTagHeldRep: {[i32]: i32} = Map()

// The rep `fnTagHeldNote` stamped on node `x`, or -1 where it stamped none.
export function fnTagHeldRepOf(x: i32): i32 { fnTagHeldRep[x] ?? -1 }

// Stamps held node `x`, a list literal or a `let`, with its type's rep, where that differs.
export function fnTagHeldNote(x: i32) {
  if x < 0 || x >= P.nodes.length { return 0 }
  const n = nodeAt(x)
  let t = nodeTyIxOf(x)
  if n is LetDecl && n.letInit >= 0 { t = nodeTyIxOf(n.letInit) }
  // A binding of a read of a stamped place holds that place's rep (D15350).
  const pr = if n is LetDecl { fnTagPlaceRep(n.letInit) } else { -1 }
  if pr >= 0 {
    if pr != t { fnTagHeldRep[x] = pr }
    return 0
  }
  const v0 = if n is LetDecl { n.letInit } else { x }
  const deep = fnTagListOfLists(t) && fnTagInnerLitsOnly(v0, t, 0)
  const r = fnTagRepTyIn(t, 16, deep)
  if r >= 0 && r != t { fnTagHeldRep[x] = r }
  // The inner literals of a list of lists are built at the same rep's elements (D15350).
  if deep { fnTagHeldInner(v0, r, 0) }
  0
}

// The rep stamped at the place `v` reads: a stamped node or binding, or an element or field of
// one; -1 where no stamp reaches it.
function fnTagPlaceRep(v: i32): i32 {
  // The place is walked inward to the first stamped node or binding; `steps` is the path back.
  let x = if v >= 0 && v < P.nodes.length { parenPeelIx(v) } else { -1 }
  let t = -1
  const steps: string[] = []
  let hops = 0
  while x >= 0 && x < P.nodes.length && hops < 16 {
    t = fnTagHeldRep[x] ?? -1
    const xn = nodeAt(x)
    if t >= 0 {
      hops = 16
    } else if xn is Member {
      steps.push(xn.memProp)
      x = parenPeelIx(xn.memObj)
    } else if xn is Index {
      steps.push("")
      x = parenPeelIx(xn.idxArr)
    } else {
      // Any other node is the root: a name reads its binding's stamp.
      const d = identDeclOf(x)
      t = if d >= 0 && d != x { fnTagHeldRep[d] ?? -1 } else { -1 }
      hops = 16
    }
    hops = hops + 1
  }
  let k = steps.length - 1
  while k >= 0 && t >= 0 {
    t = if steps[k] == "" { tyArrayElemIx(t) } else { tyFieldTyOf(t, steps[k]) }
    k = k - 1
  }
  t
}

// Whether record type `t` has a field of a tagged set itself, not a list of one.
function fnTagHasTaggedField(t: i32): boolean {
  const o = if t >= 0 && t < T.tys.length { T.tys[t] } else { null }
  if !(o is TyObj) { return false }
  for f in o.objFieldTypes {
    if fnTagTyIsTagged(f) { return true }
  }
  false
}

// The record literals `fnTagHeldInner` found built at another record, each beside that record;
// the tag pass stamps and drains them.
export let fnTagHeldRecs: i32[] = []

// Whether `t` is a list whose element is a list.
function fnTagListOfLists(t: i32): boolean {
  const o = if t >= 0 && t < T.tys.length { T.tys[t] } else { null }
  const e = if o is TyArray && o.aElem >= 0 && o.aElem < T.tys.length { T.tys[o.aElem] } else { null }
  e is TyArray
}

// Whether `v`, of list type `t`, is a list literal whose every element of a list type is a list
// literal too, all the way down: a binding read there keeps its own rep (D15350).
function fnTagInnerLitsOnly(v: i32, t: i32, depth: i32): boolean {
  const vx = if v >= 0 && v < P.nodes.length { parenPeelIx(v) } else { -1 }
  const vn = if vx >= 0 && vx < P.nodes.length { nodeAt(vx) } else { null }
  const o = if t >= 0 && t < T.tys.length { T.tys[t] } else { null }
  if !(vn is ArrayLit) || !(o is TyArray) || depth > 8 { return false }
  if !fnTagListOfLists(t) { return true }
  for el in vn.arrElems {
    if !fnTagInnerLitsOnly(el, o.aElem, depth + 1) { return false }
  }
  true
}

// Stamps each list literal element of list literal `v` with the element of rep `r`.
function fnTagHeldInner(v: i32, r: i32, depth: i32) {
  const vx = if v >= 0 && v < P.nodes.length { parenPeelIx(v) } else { -1 }
  const vn = if vx >= 0 && vx < P.nodes.length { nodeAt(vx) } else { null }
  const ro = if r >= 0 && r < T.tys.length { T.tys[r] } else { null }
  if !(vn is ArrayLit) || !(ro is TyArray) || depth > 8 { return 0 }
  const eo = if ro.aElem >= 0 && ro.aElem < T.tys.length { T.tys[ro.aElem] } else { null }
  for el in vn.arrElems {
    const ex = parenPeelIx(el)
    if ex >= 0 && ex < P.nodes.length && nodeAt(ex) is ArrayLit {
      if ro.aElem != nodeTyIxOf(ex) { fnTagHeldRep[ex] = ro.aElem }
      fnTagHeldInner(ex, ro.aElem, depth + 1)
    }
    // A record literal whose function field the rep holds as its id is built at the rep's
    // record, so it shares that record's row.
    if (
      ex >= 0
      && ex < P.nodes.length
      && nodeAt(ex) is ObjLit
      && eo is TyObj
      && fnTagHasTaggedField(nodeTyIxOf(ex))
    ) {
      fnTagHeldRecs.push(ex)
      fnTagHeldRecs.push(ro.aElem)
    }
  }
  0
}

// Type `t` with every list whose element is a tagged set an `i32` list, through lists, records,
// nullables and map values; `t` itself where nothing is rewritten. With `deep`, `t` is inside a
// list's element list, where a record's tagged function field is its `i32` id, since no literal of
// the outer list mints that record's row (D15350).
function fnTagRepTyIn(t: i32, depth: i32, deep: boolean): i32 {
  if depth <= 0 || t < 0 || t >= T.tys.length { return t }
  const o = T.tys[t]
  match o {
    TyArray => {
      if fnTagTyIsTagged(o.aElem) { return mkArrayTy(TY_I32) }
      const e = fnTagRepTyIn(o.aElem, depth - 1, deep)
      return if e == o.aElem { t } else { mkArrayTy(e) }
    }
    TyObj => {
      const tys: i32[] = []
      let changed = false
      for f in o.objFieldTypes {
        const r = if deep && fnTagTyIsTagged(f) { TY_I32 } else { fnTagRepTyIn(f, depth - 1, deep) }
        if r != f { changed = true }
        tys.push(r)
      }
      if !changed { return t }
      const names: string[] = []
      for nm in o.objFieldNames { names.push(nm) }
      return mkObjTy(names, tys)
    }
    TyNullable => {
      const r = fnTagRepTyIn(o.nInner, depth - 1, deep)
      return if r == o.nInner { t } else { mkNullableTy(r) }
    }
    // A map's value record is minted by no literal of the map's own, so its tagged function
    // fields are their `i32` ids, as inside a list's element list.
    TyMap => {
      const r = fnTagRepTyIn(o.mVal, depth - 1, true)
      return if r == o.mVal { t } else { mkMapTy(o.mKey, r, o.mSet) }
    }
    // No other kind holds a set's ids as a container.
    TyPrim | TyErr | TyFunc | TyUnion | TyVar | TyLit | TyNeg => {
      return t
    }
  }
}

// Whether set `s` is tagged.
export function fnTagSetIsTagged(s: i32): boolean { fnTagged[s] ?? false }

// The tagged sets' ids, ascending.
export function fnTagTaggedSets(): i32[] {
  const r: i32[] = []
  let s = 0
  while s < fnSets.length {
    if fnTagged[s] ?? false { r.push(s) }
    s = s + 1
  }
  r
}

// The member whose id leaf node `ix` emits, or -1.
export function fnTagLeafId(ix: i32): i32 {
  fnTagLeaf[ix] ?? (fnTagLeaf[nodeSrc[ix] ?? -1] ?? -1)
}

// The tagged set whose id leaf node `ix` emits, or -1.
export function fnTagLeafSetOf(ix: i32): i32 {
  fnTagLeafSet[ix] ?? (fnTagLeafSet[nodeSrc[ix] ?? -1] ?? -1)
}

// A function type carrying set `s` itself, not a list of it; -1 when no type does.
export function fnTagSetTy(s: i32): i32 {
  if s < 0 { return -1 }
  for t in elabFnSetTy.keys() {
    if (elabFnSetTy[t] ?? -1) == s && t < T.tys.length && T.tys[t] is TyFunc {
      return t
    }
  }
  -1
}

// The direct calls call `ix` dispatches between, one per member in set order; [] when its set
// is not tagged.
export function fnTagCallArms(ix: i32): i32[] {
  const none: i32[] = []
  if !fnTagSetIsTagged(fnTagCallSetOf(ix)) { return none }
  fnTagArms[ix] ?? none
}

function fnTagArmsKey(ix: i32, s: i32): string {
  i32ToStr(ix) + "," + i32ToStr(s)
}

// The member calls built for call `ix` at tagged set `s`; [] for none, or when `s` is untagged.
export function fnTagArmsAt(ix: i32, s: i32): i32[] {
  const none: i32[] = []
  if s < 0 || !fnTagSetIsTagged(s) { return none }
  if s == fnTagCallSetOf(ix) { return fnTagArms[ix] ?? none }
  fnTagArmsBy[fnTagArmsKey(ix, s)] ?? none
}

// Records that arm call `arm` calls member declaration `d`.
export function fnTagArmMemberNote(arm: i32, d: i32) {
  if arm >= 0 && d >= 0 { fnTagArmMember[arm] = d }
  const an = if arm >= 0 && arm < P.nodes.length { nodeAt(arm) } else { null }
  if an is Call && an.callFn >= 0 && d >= 0 { identArmNote(an.callFn) }
  0
}

// The member declaration arm call `arm` calls, or -1 for a call that is no arm.
export function fnTagArmMemberOf(arm: i32): i32 { fnTagArmMember[arm] ?? -1 }

// Records that `let` declaration `b` holds tagged set `s`, its value one of the set's ids.
export function fnTagBindNote(b: i32, s: i32) {
  if b >= 0 && s >= 0 { fnTagBind[b] = s }
  0
}

// Whether `let` declaration `b` holds a tagged set, so its cell is an id and not a closure.
export function fnTagBindHolds(b: i32): boolean { (fnTagBind[b] ?? -1) >= 0 }

// Whether `d` is a function declared under the name `name`.
export function fnDeclNameIs(d: i32, name: string): boolean {
  if d < 0 || d >= P.nodes.length { return false }
  const n = nodeAt(d)
  n is FuncDecl && n.fnName == name
}

// The member declaration dispatch arm callee `ix`, or a copy of one, is bound to; -1 for any other
// node.
export function fnTagArmCalleeOf(ix: i32): i32 {
  if !identIsArm(ix) { return -1 }
  const d = identDeclOf(ix)
  if d >= 0 && d < P.nodes.length && nodeAt(d) is FuncDecl { d } else { -1 }
}
// Records the member calls `arms` call `ix` dispatches between at set `s`.
export function fnTagArmsAtSet(ix: i32, s: i32, arms: i32[]) {
  if s == fnTagCallSetOf(ix) {
    fnTagArms[ix] = arms
  } else {
    fnTagArmsBy[fnTagArmsKey(ix, s)] = arms
  }
  0
}

// Records set `s` as tagged, with leaf `leaves[k]` naming member `ids[k]`.
export function fnTagMark(s: i32, leaves: i32[], ids: i32[]) {
  fnTagged[s] = true
  let k = 0
  while k < leaves.length {
    fnTagLeaf[leaves[k]] = ids[k]
    fnTagLeafSet[leaves[k]] = s
    k = k + 1
  }
  0
}

// Marks `ix`, a read of member declaration `d`, as a leaf of the tagged set function type `t`
// carries, so a literal built at a joined result emits `d`'s id there (D15226); false when `t`
// is untagged or `d` is no member.
export function fnTagLeafJoin(ix: i32, d: i32, t: i32): boolean {
  const s = if t >= 0 { elabFnSetTy[t] ?? -1 } else { -1 }
  if (
    ix < 0
    || d < 0
    || s < 0
    || !(fnTagged[s] ?? false)
    || !i32ListHas(fnTagMembers(s), d)
  ) {
    return false
  }
  fnTagLeaf[ix] = d
  fnTagLeafSet[ix] = s
  true
}

// Gives `copy`, a lifted instance of the lambda at `orig`, the id leaf `orig` emits.
export function fnTagLeafCarry(copy: i32, orig: i32) {
  const id = fnTagLeafId(orig)
  if id >= 0 && copy >= 0 { fnTagLeaf[copy] = id }
  0
}

// Records that function declaration `d` returns a value of a tagged set.
export function fnTagRetMark(d: i32) {
  fnTagRet[d] = true
  0
}

// Whether function declaration `d` returns the id of a tagged set's member.
export function fnTagRetIsTagged(d: i32): boolean { fnTagRet[d] ?? false }

// Records call `nc`, an instance's copy of tagged call `tpl` at set `s`, as dispatching between
// `arms`; a set other than the one `tpl` is noted at is the instance's own, with no split.
export function fnTagCallCopy(nc: i32, tpl: i32, s: i32, arms: i32[]) {
  if s < 0 { return 0 }
  const none: i32[] = []
  if s != fnTagCallSetOf(tpl) {
    fnTagCallNote(nc, s, "", false, none)
    fnTagArms[nc] = arms
    return 0
  }
  fnTagCallNote(
    nc,
    s,
    fnTagCallKey[tpl] ?? "",
    fnTagCallSplit[tpl] ?? false,
    fnTagCallRs[tpl] ?? none,
  )
  fnTagArms[nc] = arms
  0
}

// Forgets every tagging decision, before the checker's last pass makes them again.
export function fnTagUndecide() {
  fnTagHeldRep = Map()
  fnTagged = Map()
  fnTagLeaf = Map()
  fnTagLeafSet = Map()
  fnTagRet = Map()
  0
}

// The literals a joined result's build moved to another rep, whose earlier row was minted at the
// old one (D15226).
let elabRestamped: {[i32]: boolean} = Map()

export function elabRestampNote(x: i32) { elabRestamped[x] = true }

// Whether the joined result's build moved literal `x` (`elabRestampNote`).
export function elabRestampedAt(x: i32): boolean { elabRestamped[x] ?? false }

// Clears every per-program elaboration table; a compile's rounds each start from none.
export function elabCapReset() {
  elabCapOn = false
  elabRestamped = Map()
  fvaListCopyReset()
  etcMemo = Map()
  etcN = 0
  elabEarlyCalls = []
  elabCapQuiet = 0
  elabCapTy = Map()
  elabCbD = []
  elabCbX = []
  elabCbN = []
  elabCbT = []
  elabCbRootD = []
  elabCbRootX = []
  elabCbRootN = []
  elabCbRootT = []
  elabCallIx = []
  elabCallN = []
  elabCallT = []
  elabCallD = []
  elabCallDecl = Map()
  elabCapKey = -1
  elabEncl = Map()
  elabSnapIx = Map()
  elabSnapTys = []
  elabSnapSlot = []
  elabSnapStore = []
  elabHoleRowDecl = []
  elabHoleRowFrom = []
  elabPinsClosed = false
  elabHoleRowEpoch = []
  elabDefaultRowDecl = []
  elabDefaultRowT = []
  elabPinBindN = []
  elabPinBindT = []
  elabHoleRowN = []
  elabHoleRowT = []
  elabHoleRowBindN = []
  elabHoleRowBindT = []
  elabUnboundCallIx = []
  elabUnboundCallD = []
  elabUnboundCallFrom = []
  elabUnboundCallN = []
  elabUnboundCallT = []
  elabWalkNow = -1
  elabWideRowsKeep(0)
  elabFnSetTy = Map()
  fnSets = []
  fnValGenerics = []
  fnSetByKey = Map()
  fnJoinMemo = Map()
  fnLetReadTy = Map()
  fnLetSet = Map()
  fnSlotSet = Map()
  fnSetCallees = []
  fnSetCalleeArgs = []
  fnSetCalleeGens = []
  fnSetOpenCallee = false
  fnSlotCallAt = Map()
  fnSlotCallArgs = []
  fnSlotThrough = Map()
  fnSlotAnnTys = Map()
  fnSlotOpenHands = Map()
  fnTagCallIxs = []
  fnTagCallSet = Map()
  fnTagCallKey = Map()
  fnTagCallSplit = Map()
  fnTagCallVoidSplit = Map()
  fnTagCallRs = Map()
  fnTagCallMsg = Map()
  fnTagCallMsgAt = Map()
  fnTagged = Map()
  fnTagHeldRep = Map()
  mintReset()
  fnTagLeaf = Map()
  fnTagLeafSet = Map()
  fnTagRet = Map()
  fnTagArms = Map()
  fnTagArmsBy = Map()
  fnTagArmMember = Map()
  fnTagBind = Map()
  fnTagJoinFrom = Map()
  fnTagCallJoin = Map()
  0
}

// Whether parameter `i` of `f` is annotated by a bare own type parameter `T` that no return
// annotation names, so the instance binds `T` to one set: alone, to the argument's; shared with
// other parameters `T` annotates bare, to the union of theirs (`fnTagSharedJoinSet`), where
// `args` hands each the same named function, a generic one each, or a read of one caller's `T`.
export function fnTagOwnTyParamJoins(
  f: FuncDecl,
  i: i32,
  args: i32[],
): boolean {
  if i < 0 || i >= f.fnParams.length { return false }
  const pn = nodeAt(f.fnParams[i])
  if !(pn is Param) || pn.parType < 0 { return false }
  const tn = nodeAt(pn.parType)
  if !(tn is TypeRef) || !strListHas(f.fnTyParams, tn.tyName) { return false }
  const nm: string[] = [tn.tyName]
  if f.fnRet >= 0 && tsMentionsAnyName(annTsOf(f.fnRet), nm) { return false }
  let d = -1
  let g = ""
  let shared = false
  let k = 0
  while k < f.fnParams.length {
    const q = nodeAt(f.fnParams[k])
    if (
      k != i
      && q is Param
      && q.parType >= 0
      && tsMentionsAnyName(annTsOf(q.parType), nm)
    ) {
      const qt = nodeAt(q.parType)
      if (
        !(qt is TypeRef)
        || qt.tyName != tn.tyName
        || k >= args.length
        || i >= args.length
      ) {
        return false
      }
      // Each argument names a function, or each reads a parameter of the caller's one type
      // parameter, which binds one set per instance (D6240's hand-on to another generic).
      if !shared {
        d = fnTagSharedArgDecl(args[i])
        g = if d < 0 { fnTagSharedArgTyParam(args[i]) } else { "" }
        if d < 0 && g == "" { return false }
        shared = true
      }
      if d >= 0 && !fnTagJoinsWith(d, fnTagSharedArgDecl(args[k])) {
        return false
      }
      if d < 0 && fnTagSharedArgTyParam(args[k]) != g { return false }
    }
    k = k + 1
  }
  true
}

// Whether parameter `i` of `f` is annotated bare by an own type parameter `T` the result names
// bare too, that every parameter naming `T` annotates bare, each handed by `args` a named
// function joinable with the others (`fnTagJoinsWith`): the result is one of their values.
function fnTagRetSharedJoins(f: FuncDecl, i: i32, args: i32[]): boolean {
  if f.fnRet < 0 || i < 0 || i >= f.fnParams.length || i >= args.length {
    return false
  }
  const pn = nodeAt(f.fnParams[i])
  if !(pn is Param) || pn.parType < 0 { return false }
  const tn = nodeAt(pn.parType)
  const rn = nodeAt(f.fnRet)
  if !(tn is TypeRef) || !(rn is TypeRef) || rn.tyName != tn.tyName {
    return false
  }
  if !strListHas(f.fnTyParams, tn.tyName) { return false }
  const nm: string[] = [tn.tyName]
  const d = fnTagSharedArgDecl(args[i])
  if d < 0 { return false }
  let shared = false
  let k = 0
  while k < f.fnParams.length {
    const q = nodeAt(f.fnParams[k])
    if (
      k != i
      && q is Param
      && q.parType >= 0
      && tsMentionsAnyName(annTsOf(q.parType), nm)
    ) {
      const qt = nodeAt(q.parType)
      if !(qt is TypeRef) || qt.tyName != tn.tyName || k >= args.length {
        return false
      }
      if !fnTagJoinsWith(d, fnTagSharedArgDecl(args[k])) { return false }
      shared = true
    }
    k = k + 1
  }
  shared
}

// Whether named functions `d` and `e` bind one type parameter together: the same function, or
// two that are each generic or a hole function, so each is a set member whose id holds in their
// union.
export function fnTagJoinsWith(d: i32, e: i32): boolean {
  if d == e { return true }
  if d < 0 || e < 0 || d >= P.nodes.length || e >= P.nodes.length {
    return false
  }
  const dn = nodeAt(d)
  const en = nodeAt(e)
  dn is FuncDecl && en is FuncDecl && fnTagOpenDecl(dn) && fnTagOpenDecl(en)
}

// Whether function `f` declares a type parameter or leaves a parameter un-annotated, so a value
// of it is a set member, not one closed signature.
function fnTagOpenDecl(f: FuncDecl): boolean {
  if f.fnTyParams.length > 0 { return true }
  for p in f.fnParams {
    const q = nodeAt(p)
    if q is Param && q.parType < 0 { return true }
  }
  false
}

// A function type carrying the union of the sets types `a` and `b` carry: `a` when they carry
// one, a type of `a`'s signature when no type carries the union yet, -1 when either carries none.
function fnTagJoinedSetTy(a: i32, b: i32): i32 {
  const sa = fnTagSetOfTy(a)
  const sb = fnTagSetOfTy(b)
  if sa < 0 || sb < 0 { return -1 }
  if sa == sb { return a }
  const u = fnSetIntern(fnSetUnion(sa, sb))
  const have = fnTagSetTy(u)
  if have >= 0 { return have }
  if a >= T.tys.length { return -1 }
  const af = T.tys[a]
  if !(af is TyFunc) { return -1 }
  const ps: i32[] = []
  for q in af.fnParamTypes { ps.push(q) }
  const g: Ty = { fnParamTypes: ps, fnRet: af.fnRet }
  T.tys.push(g)
  elabFnSetTy[T.tys.length - 1] = u
  T.tys.length - 1
}

// The set parameter `i` of `f` binds where `fnTagOwnTyParamJoins` or `fnTagRetSharedJoins` holds
// and `args` hands its type parameter two generic functions: the union of the arguments' sets; -1
// for any other.
export function fnTagSharedJoinSet(f: FuncDecl, i: i32, args: i32[]): i32 {
  if !fnTagOwnTyParamJoins(f, i, args) && !fnTagRetSharedJoins(f, i, args) {
    return -1
  }
  const pn = nodeAt(f.fnParams[i])
  if !(pn is Param) || pn.parType < 0 || pn.parType >= P.nodes.length {
    return -1
  }
  const tn = nodeAt(pn.parType)
  if !(tn is TypeRef) { return -1 }
  let jt = nodeTyIxOf(parenPeelIx(args[i]))
  let k = 0
  while k < f.fnParams.length && k < args.length && jt >= 0 {
    const q = nodeAt(f.fnParams[k])
    const qt = if q is Param && q.parType >= 0 { nodeAt(q.parType) } else { null }
    if k != i && qt is TypeRef && qt.tyName == tn.tyName {
      jt = fnTagJoinedSetTy(jt, nodeTyIxOf(parenPeelIx(args[k])))
    }
    k = k + 1
  }
  fnTagSetOfTy(jt)
}

// Records that an instance binds a shared type parameter to union `u`, which set `s` joins.
export function fnTagJoinFromNote(u: i32, s: i32) {
  if u < 0 || s < 0 || u == s { return 0 }
  const have = fnTagJoinFrom[u] ?? []
  if !i32ListHas(have, s) { have.push(s) }
  fnTagJoinFrom[u] = have
  0
}

// Records that call `call` binds the type parameter its argument `i` shares to joined set `u`.
export function fnTagCallJoinNote(call: i32, i: i32, u: i32) {
  if call >= 0 && i >= 0 && i < 64 && u >= 0 {
    fnTagCallJoin[call * 64 + i] = u
  }
  0
}

// The joined set call `call` binds its argument `i`'s shared type parameter to; -1 for none.
export function fnTagCallJoinOf(call: i32, i: i32): i32 {
  if call < 0 || i < 0 || i >= 64 { return -1 }
  fnTagCallJoin[call * 64 + i] ?? -1
}

// The argument sets an instance's shared type parameter joins into union `u`.
export function fnTagJoinFromOf(u: i32): i32[] { fnTagJoinFrom[u] ?? [] }

// The type parameter that bare-annotates the parameter argument `a` reads, or "" for any other
// argument.
function fnTagSharedArgTyParam(a: i32): string {
  const x = parenPeelIx(a)
  if x < 0 || x >= P.nodes.length || !(nodeAt(x) is Ident) { return "" }
  const pd = identDeclOf(x)
  if pd < 0 || pd >= P.nodes.length { return "" }
  const pn = nodeAt(pd)
  if !(pn is Param) || pn.parType < 0 { return "" }
  const tn = nodeAt(pn.parType)
  if tn is TypeRef { tn.tyName } else { "" }
}

// Per binding whose initialiser is a read: the declaration read (-1 for none), and flags.
let pcSrc: {[i32]: i32} = Map()
let pcFlags: {[i32]: i32} = Map()
let pcAnn: {[i32]: string} = Map()
let pcBuilt = false
// Per assigned binding: the declaration every `=` into it reads, or -2 when they differ.
let pcWriteSrc: {[i32]: i32} = Map()
const PC_CONST = 1
const PC_ASSIGNED = 2
const PC_ANN_OTHER = 4

// Empties the copy record; the next read or the pass end rebuilds it from the tree.
export function paramCopyReset() {
  pcSrc = Map()
  pcFlags = Map()
  pcAnn = Map()
  pcBuilt = false
  0
}

// Records, for each `let`/`const` initialised by a name read, what it reads, whether it is a
// `const`, what bare type name annotates it, and whether any `=` assigns it.
export function paramCopyBuild() {
  pcSrc = Map()
  pcFlags = Map()
  pcAnn = Map()
  const assigned: {[i32]: boolean} = Map()
  pcWriteSrc = Map()
  let i = 0
  while i < P.nodes.length {
    pcAssignNote(i, assigned)
    i = i + 1
  }
  i = 0
  while i < P.nodes.length {
    pcLetNote(i, assigned)
    i = i + 1
  }
  pcBuilt = true
  0
}

// Marks the binding an `=` at node `i` assigns; any other node assigns none.
function pcAssignNote(i: i32, assigned: {[i32]: boolean}): i32 {
  const n = nodeAt(i)
  if n is BinExpr && n.binOp == "=" {
    const l = parenPeelIx(n.binLeft)
    if l >= 0 && nodeAt(l) is Ident {
      const ld = identDeclOf(l)
      if ld >= 0 {
        assigned[ld] = true
        const r = parenPeelIx(n.binRight)
        const rs = if r >= 0 && nodeAt(r) is Ident { identDeclOf(r) } else { -2 }
        const was = pcWriteSrc[ld] ?? -3
        pcWriteSrc[ld] = if was == -3 || was == rs { rs } else { -2 }
      }
    }
    return 0
  }
  pcNotRecorded(i)
}

// Records the binding at node `i` when a name read initialises it; any other node is not one.
function pcLetNote(i: i32, assigned: {[i32]: boolean}): i32 {
  const n = nodeAt(i)
  if n is LetDecl && n.letInit >= 0 {
    const v = parenPeelIx(n.letInit)
    if v < 0 || !(nodeAt(v) is Ident) { return 0 }
    pcSrc[i] = identDeclOf(v)
    let fl = if n.letKw == "const" { PC_CONST } else { 0 }
    if assigned[i] ?? false { fl = fl | PC_ASSIGNED }
    if n.letType >= 0 {
      const tn = nodeAt(n.letType)
      if tn is TypeRef { pcAnn[i] = tn.tyName } else { fl = fl | PC_ANN_OTHER }
    }
    pcFlags[i] = fl
    return 0
  }
  pcNotRecorded(i)
}

// A node the copy record has no row for.
function pcNotRecorded(_i: i32): i32 { 0 }

// Whether binding `d`, a `let` initialised by a name read, is assigned nowhere: it holds that
// read's value throughout, as a `const` would.
export function pcLetUnassigned(d: i32): boolean {
  pcHas(d) && ((pcFlags[d] ?? 0) & PC_ASSIGNED) == 0
}

// Whether binding `d`, a `let` initialised by a name read, holds that read's value throughout:
// nothing assigns it, or every assignment stores a read of the same declaration.
export function pcLetHoldsInit(d: i32): boolean {
  if pcLetUnassigned(d) { return true }
  pcHas(d) && (pcWriteSrc[d] ?? -2) == (pcSrc[d] ?? -1)
}

// Whether binding `d`, a `let` initialised by a parameter read, is written only from one other
// parameter of the same function, both annotated with one bare type parameter of it: in every
// instance the two have one type, so `d` holds a value of that type, whichever of them it holds (D15123).
export function pcLetSourcesOneTyParam(d: i32): boolean {
  if !pcHas(d) { return false }
  const a = pcSrc[d] ?? -1
  const b = pcWriteSrc[d] ?? -1
  if a < 0 || b < 0 || a >= P.nodes.length || b >= P.nodes.length {
    return false
  }
  const an = nodeAt(a)
  const bn = nodeAt(b)
  if !(an is Param) || !(bn is Param) { return false }
  const f = curFnDeclIx
  if f < 0 || f >= P.nodes.length { return false }
  const fd = nodeAt(f)
  if (
    !(fd is FuncDecl)
    || !i32ListHas(fd.fnParams, a)
    || !i32ListHas(fd.fnParams, b)
  ) {
    return false
  }
  const at = if an.parType >= 0 { nodeAt(an.parType) } else { an }
  const bt = if bn.parType >= 0 { nodeAt(bn.parType) } else { bn }
  at is TypeRef
    && bt is TypeRef
    && at.tyName == bt.tyName
    && strListHas(fd.fnTyParams, at.tyName)
}

// Whether binding `d` is in the copy record, building it on a first read.
function pcHas(d: i32): boolean {
  if !pcBuilt { paramCopyBuild() }
  pcSrc.has(d)
}

// Whether recorded binding `d` is annotated, by a bare type parameter of `f` when `own`.
function pcAnnOk(d: i32, f: FuncDecl, unannOk: boolean): boolean {
  if ((pcFlags[d] ?? 0) & PC_ANN_OTHER) != 0 { return false }
  const a = pcAnn[d] ?? ""
  if a == "" { return unannOk }
  strListHas(f.fnTyParams, a)
}

// The parameter of `f` that binding `d` copies: a `const`, un-annotated or annotated with a bare
// type parameter of `f`, seeded by a read of the parameter, directly or through such copies; -1
// for any other binding. A copy holds the parameter's own value.
export function fnTagParamCopyOf(f: FuncDecl, d: i32): i32 {
  let x = d
  let hops = 0
  while hops < 8 && x >= 0 && x < P.nodes.length {
    hops = hops + 1
    if (
      !pcHas(x)
      || ((pcFlags[x] ?? 0) & PC_CONST) == 0
      || !pcAnnOk(x, f, true)
    ) {
      return -1
    }
    const src = pcSrc[x] ?? -1
    if i32ListHas(f.fnParams, src) { return src }
    x = src
  }
  -1
}

// The parameter of `fn` that binding `d` copies: `d` is annotated with a bare type parameter of
// `fn`, nothing assigns it, and it is seeded by a read of a parameter annotated so, directly or
// through such copies. A copy holds the parameter's value, so it takes the parameter's pin; -1
// for any other binding.
export function paramCopySeedOf(fn: FuncDecl, d: i32): i32 {
  let x = d
  let hops = 0
  while hops < 8 {
    hops = hops + 1
    if x < 0 || x >= P.nodes.length || !pcHas(x) || !pcAnnOk(x, fn, false) {
      return -1
    }
    if ((pcFlags[x] ?? 0) & PC_ASSIGNED) != 0 { return -1 }
    const src = pcSrc[x] ?? -1
    if src >= 0 && src < P.nodes.length && i32ListHas(fn.fnParams, src) {
      const pn = nodeAt(src)
      if pn is Param && pn.parType >= 0 {
        const tn = nodeAt(pn.parType)
        if tn is TypeRef && strListHas(fn.fnTyParams, tn.tyName) { return src }
      }
      return -1
    }
    x = src
  }
  -1
}

// The named function argument `a` names, directly or through `const` bindings of its name, or -1.
export function fnTagSharedArgDecl(a: i32): i32 {
  let x = a
  let hops = 0
  while hops < 8 {
    while x >= 0 && x < P.nodes.length && nodeAt(x) is Paren {
      const pn = nodeAt(x)
      x = if pn is Paren { pn.parInner } else { -1 }
    }
    if x < 0 || x >= P.nodes.length || !(nodeAt(x) is Ident) { return -1 }
    const d = identDeclOf(x)
    if d < 0 || d >= P.nodes.length { return -1 }
    const dn = nodeAt(d)
    if dn is FuncDecl { return d }
    if !(dn is LetDecl) || dn.letKw != "const" || dn.letType >= 0 { return -1 }
    x = dn.letInit
    hops = hops + 1
  }
  -1
}
