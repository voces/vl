// `check_elab_cap.vl` — what one elaboration records while it re-checks an instance body: each
// node's type at the instance, and each call's closed bindings. Recording is live only at the
// elaboration's own quiet depth, so a probe nested inside the body records nothing.

import {
  Call,
  FuncDecl,
  Ident,
  IfStmt,
  LetDecl,
  MatchExpr,
  P,
  Paren,
  i32ToStr,
  nodeAt,
} from "./ast"
import { inferQuiet, quietDepth } from "./check_cursor"
import {
  constScopes,
  declareSlot,
  fnAliasScopes,
  fnDeclScopes,
  scopeDepthsOf,
  scopeSlotAt,
  scopeTyAt,
} from "./check_scopes"
import {
  T,
  Ty,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
} from "./check_types"
import { tyHasTyVar } from "./tyquery"
import { i32ListHas } from "./listutil"
import { identDeclOf, nodeSrc } from "./symbols"
import { nodeTyIxOf } from "./check_node_tys"
import {
  cwLetFnTargets,
  cwLetSlotFnTargets,
  fnDeclIx,
} from "./check_write_scan"
import { weDigits } from "./check_write_effects"
import { hdBase, hdRowOf } from "./check_hole_pins"
import { elabFnSetTy, fnTagged } from "./check_fn_tag_facts"
export { fnTagTyIsTagged } from "./check_fn_tag_facts"

// Whether an elaboration is recording, and the quiet depth it records at.
export let elabCapOn = false
export let elabCapQuiet = 0

// Node → type, for the elaboration in progress.
export let elabCapTy: {[i32]: i32} = Map()

// Literal → the type it is built at, for the elaboration in progress: its rep stamp there.
export let elabCapRep: {[i32]: i32} = Map()

// Literal → the union whose arm it is adopted into, for the elaboration in progress.
export let elabCapRepUnion: {[i32]: i32} = Map()

// The calls the elaboration in progress bound: call node, its binding names and types.
export let elabCallIx: i32[] = []
export let elabCallN: string[][] = []
export let elabCallT: i32[][] = []
export let elabCallD: i32[] = []

// How many arms of a test the instance makes dead enclose the check now, the nodes recorded
// inside one, and the diagnostics raised outside every one.
export let elabCapDead = 0
export let elabCapDeadIx: {[i32]: boolean} = Map()
export let elabCapDeadDiags = 0

// Whether a record made now belongs to the elaboration in progress.
export function elabCapLive(): boolean {
  elabCapOn && quietDepth == elabCapQuiet
}

// Whether a type decided now stands: outside every quiet probe, or in an instance's re-check.
export function stampsStand(): boolean { !inferQuiet || elabCapLive() }

// Opens recording at quiet depth `depth` with empty tables.
export function elabCapBegin(depth: i32) {
  elabCapOn = true
  elabCapQuiet = depth
  elabCapTy = Map()
  elabCapRep = Map()
  elabCapRepUnion = Map()
  elabCapDead = 0
  elabCapDeadIx = Map()
  elabCapDeadDiags = 0
  elabCallIx = []
  elabCallN = []
  elabCallT = []
  elabCallD = []
  0
}

export function elabCapEnd() {
  elabCapOn = false
  0
}

// Records node `ix` at type `t`; a later record of the node wins.
export function elabCapNote(ix: i32, t: i32) {
  if ix < 0 { return 0 }
  elabCapTy[ix] = t
  if elabCapDead > 0 { elabCapDeadIx[ix] = true }
  0
}

// Enters the arm of a test the instance makes dead; whether it is the outermost one.
export function elabCapDeadEnter(): boolean {
  elabCapDead = elabCapDead + 1
  elabCapDead == 1
}

// Leaves that arm; the outermost counts the diagnostics raised since `d0` as dead ones.
export function elabCapDeadLeave(outer: boolean, d0: i32) {
  elabCapDead = elabCapDead - 1
  if outer { elabCapDeadDiags = elabCapDeadDiags + T.diags.length - d0 }
  0
}

// Records call `ix`'s bindings.
export function elabCallNote(ix: i32, names: string[], tys: i32[]) {
  const nm: string[] = []
  const ty: i32[] = []
  let i = 0
  while i < names.length && i < tys.length {
    nm.push(names[i])
    ty.push(tys[i])
    i = i + 1
  }
  elabCallIx.push(ix)
  elabCallN.push(nm)
  elabCallT.push(ty)
  elabCallD.push(elabCallDecl[ix] ?? -1)
  0
}

// Each generic call's callee declaration, by call node, as the checker resolved it.
export let elabCallDecl: {[i32]: i32} = Map()

export function elabCallDeclNote(ix: i32, decl: i32) {
  if ix >= 0 { elabCallDecl[ix] = decl }
  0
}

export function elabCallDeclOf(ix: i32): i32 { elabCallDecl[ix] ?? -1 }

// The elaboration key whose body is being re-checked, -1 in the generic pass.
export let elabCapKey = -1
export function elabCapKeySet(k: i32) {
  elabCapKey = k
  0
}

// Each nested declaration's enclosing declaration, -1 at module scope, from the generic pass.
export let elabEncl: {[i32]: i32} = Map()

// The bindings visible where an open nested declaration is checked, by `<key>|<decl>`: what a
// re-check of its body at an instance declares around it, since its free names resolve there.
export let elabSnapIx: {[string]: i32} = Map()
export let elabSnapNames: string[][] = []
export let elabSnapTys: i32[][] = []
export let elabSnapSlot: i32[][] = []
export let elabSnapConst: i32[][] = []
export let elabSnapFnDecl: i32[][] = []
export let elabSnapFnAlias: i32[][] = []

export function elabSnapKey(k: i32, decl: i32): string {
  i32ToStr(k) + "|" + i32ToStr(decl)
}

// Notes nested declaration `decl` (checked under `enclDecl`), and when its signature `paramTys`
// or its type parameters are open, the bindings visible around it.
export function elabNestNote(
  decl: i32,
  enclDecl: i32,
  nTyParams: i32,
  paramTys: i32[],
) {
  const live = elabCapLive()
  if !live && inferQuiet { return 0 }
  if !live { elabEncl[decl] = enclDecl }
  let open = nTyParams > 0
  for p in paramTys {
    if p >= 0 && p < T.tys.length && tyHasTyVar(p) { open = true }
  }
  if !open { return 0 }
  const key = elabSnapKey(if live { elabCapKey } else { -1 }, decl)
  const names: string[] = []
  const tys: i32[] = []
  const slots: i32[] = []
  const cs: i32[] = []
  const fds: i32[] = []
  const fas: i32[] = []
  let d = 1
  while d < T.frames.length {
    for nm in T.frames[d].keys() {
      const ds = scopeDepthsOf[nm]
      if ds != null && ds.length > 0 && ds[ds.length - 1] == d {
        names.push(nm)
        tys.push(scopeTyAt(d, nm))
        slots.push(scopeSlotAt(d, nm))
        cs.push(
          if d < constScopes.length { constScopes[d][nm] ?? -1 } else { -1 },
        )
        fds.push(
          if d < fnDeclScopes.length { fnDeclScopes[d][nm] ?? -1 } else { -1 },
        )
        fas.push(
          if d < fnAliasScopes.length { fnAliasScopes[d][nm] ?? -1 } else { -1 },
        )
      }
    }
    d = d + 1
  }
  const have = elabSnapIx[key] ?? -1
  if have >= 0 {
    elabSnapNames[have] = names
    elabSnapTys[have] = tys
    elabSnapSlot[have] = slots
    elabSnapConst[have] = cs
    elabSnapFnDecl[have] = fds
    elabSnapFnAlias[have] = fas
    return 0
  }
  elabSnapIx[key] = elabSnapNames.length
  elabSnapNames.push(names)
  elabSnapTys.push(tys)
  elabSnapSlot.push(slots)
  elabSnapConst.push(cs)
  elabSnapFnDecl.push(fds)
  elabSnapFnAlias.push(fas)
  0
}

// Declares snapshot `s` into the innermost frame.
export function elabSnapDeclare(s: i32) {
  const top = T.frames.length - 1
  let i = 0
  while i < elabSnapNames[s].length {
    const nm = elabSnapNames[s][i]
    declareSlot(elabSnapSlot[s][i], nm, elabSnapTys[s][i])
    if elabSnapConst[s][i] >= 0 && top < constScopes.length {
      constScopes[top][nm] = elabSnapConst[s][i]
    }
    if elabSnapFnDecl[s][i] >= 0 && top < fnDeclScopes.length {
      fnDeclScopes[top][nm] = elabSnapFnDecl[s][i]
    }
    if elabSnapFnAlias[s][i] >= 0 && top < fnAliasScopes.length {
      fnAliasScopes[top][nm] = elabSnapFnAlias[s][i]
    }
    i = i + 1
  }
  0
}

// The declaration whose parameter hole `name` is, or -1 (`paramHoleName`'s three spellings).
export function elabHoleDeclOf(name: string): i32 {
  if name.length < 2 || name[0] != '?' { return -1 }
  let dot = name.length - 1
  while dot > 0 && name[dot] != '.' { dot = dot - 1 }
  if dot <= 1 { return -1 }
  if name.slice(0, 3) == "?#L" { return weDigits(name.slice(3, dot)) }
  if name[1] == '#' { return -1 }
  let at = dot - 1
  while at > 1 && name[at] != '@' { at = at - 1 }
  if at > 1 { return weDigits(name.slice(at + 1, dot)) }
  fnDeclIx[name.slice(1, dot)] ?? -1
}

// The closed pins a hole took outside a call (a delivery into a function-typed destination),
// grouped per declaration: consecutive pins of one declaration's holes are one instance.
export let elabHoleRowDecl: i32[] = []
export let elabHoleRowFrom: i32[] = []
export let elabHoleRowN: string[][] = []
export let elabHoleRowT: i32[][] = []

export function elabHolePinNote(name: string, ty: i32) {
  const live = elabCapLive()
  if !live && inferQuiet { return 0 }
  if !elabTyClosed(ty, 0) { return 0 }
  const d = elabHoleDeclOf(name)
  if d < 0 { return 0 }
  const from = if live { elabCapKey } else { -1 }
  const last = elabHoleRowDecl.length - 1
  if last >= 0 && elabHoleRowDecl[last] == d && elabHoleRowFrom[last] == from {
    let dup = false
    for nm in elabHoleRowN[last] {
      if nm == name { dup = true }
    }
    if !dup {
      elabHoleRowN[last].push(name)
      elabHoleRowT[last].push(ty)
      return 0
    }
  }
  elabHoleRowDecl.push(d)
  elabHoleRowFrom.push(from)
  elabHoleRowN.push([name])
  elabHoleRowT.push([ty])
  0
}

// Whether `t` is a closed, fully resolved type: no type variable and no pending return anywhere.
export function elabTyClosed(t: i32, depth: i32): boolean {
  elabTyClosedOwn(t, depth, [])
}

// Whether type variable `name` is a type parameter or a hole of a declaration in `own`.
function elabOwnedBy(own: i32[], name: string): boolean {
  const hd = elabHoleDeclOf(name)
  for d in own {
    if d == hd { return true }
    const n = nodeAt(d)
    if n is FuncDecl {
      for tp in n.fnTyParams {
        if tp == name { return true }
      }
    }
  }
  false
}

// The name of the hole a derived hole (an operator's pending answer, a field of a hole) derives
// from at its root, so it is owned where that hole is; a plain type variable's own name.
export function elabHoleRootName(t: i32): string {
  let r = t
  let n = 0
  while hdRowOf(r) >= 0 && n < 64 {
    r = hdBase[hdRowOf(r)]
    n = n + 1
  }
  const x = T.tys[r]
  if x is TyVar { return x.tvName }
  ""
}

// `elabTyClosed`, where a type variable of a declaration in `own` counts as closed.
function elabTyClosedOwn(t: i32, depth: i32, own: i32[]): boolean {
  if t < 0 || t >= T.tys.length { return false }
  if depth > 16 { return true }
  const x = T.tys[t]
  match x {
    TyVar => {
      return elabOwnedBy(own, elabHoleRootName(t))
    }
    TyArray => {
      return elabTyClosedOwn(x.aElem, depth + 1, own)
    }
    TyNullable => {
      return elabTyClosedOwn(x.nInner, depth + 1, own)
    }
    TyMap => {
      return elabTyClosedOwn(x.mKey, depth + 1, own)
        && elabTyClosedOwn(x.mVal, depth + 1, own)
    }
    TyObj => {
      for ft in x.objFieldTypes {
        if !elabTyClosedOwn(ft, depth + 1, own) { return false }
      }
      return true
    }
    TyFunc => {
      // A function value is its singleton `Fn#d`, or any member of its set, when its
      // signature is closed but for its members' own type parameters and holes, at any depth.
      const d = elabFnIdOf(t)
      let ds: i32[] = []
      if d >= 0 { ds = [d] } else { ds = elabFnSetOf(t) }
      let fresh = false
      const own2 = own.slice(0, own.length)
      for m in ds {
        if nodeAt(m) is FuncDecl && !i32ListHas(own, m) {
          own2.push(m)
          fresh = true
        }
      }
      if fresh && elabTyClosedOwn(t, depth + 1, own2) { return true }
      for pt in x.fnParamTypes {
        if !elabTyClosedOwn(pt, depth + 1, own) { return false }
      }
      return elabTyClosedOwn(x.fnRet, depth + 1, own)
    }
    TyUnion => {
      for m in x.uMembers {
        if !elabTyClosedOwn(m, depth + 1, own) { return false }
      }
      return true
    }
    TyPrim | TyErr | TyLit | TyNeg => {
      return true
    }
  }
}

// `elabFnSetTy` (in `check_fn_tag_facts`) maps a function type to an id into `fnSets`: a read of
// a function's name or a lambda literal types its value at an index only that function has (its
// singleton `Fn#d`), and a join of two sets is a fresh index.
// Each interned set, its members ascending; `fnSetByKey` finds one by its spelling.
let fnSets: i32[][] = []
let fnSetByKey: {[string]: i32} = Map()
// The fresh index each joined pair of function types took, by `a,b`.
let fnJoinMemo: {[string]: i32} = Map()
// By re-pointed `let` node: the set of every function it may hold, or -1 when one is not a
// function.
let fnLetSet: {[i32]: i32} = Map()
let fnSlotSet: {[i32]: i32} = Map()

// Whether a value of function type `t` read now still decides `t`'s set. Only an open signature
// needs one, since a closed one keys an instance by its spelling, and a quiet probe's types do
// not stand.
export function elabFnValWanted(t: i32): boolean {
  if !stampsStand() { return false }
  if t < 0 { return false }
  tyHasTyVar(t)
}

// The id of the set holding `ms`, which is ascending and duplicate-free.
function fnSetIntern(ms: i32[]): i32 {
  let key = ""
  for m in ms { key = key + i32ToStr(m) + "," }
  const have = fnSetByKey[key] ?? -1
  if have >= 0 { return have }
  fnSets.push(ms)
  fnSetByKey[key] = fnSets.length - 1
  fnSets.length - 1
}

// The members of sets `a` and `b` (either -1 for none), ascending and once each.
function fnSetUnion(a: i32, b: i32): i32[] {
  const out: i32[] = []
  const xs = if a >= 0 { fnSets[a] } else { out }
  const ys = if b >= 0 { fnSets[b] } else { out }
  let i = 0
  let j = 0
  const ms: i32[] = []
  while i < xs.length || j < ys.length {
    if j >= ys.length || (i < xs.length && xs[i] < ys[j]) {
      ms.push(xs[i])
      i = i + 1
    } else if i >= xs.length || ys[j] < xs[i] {
      ms.push(ys[j])
      j = j + 1
    } else {
      ms.push(xs[i])
      i = i + 1
      j = j + 1
    }
  }
  ms
}

// Whether set `s` holds a function that declares type parameters: a `let` holding one keeps its
// initializer's generic type, which a write to it is checked against.
function fnSetHasGeneric(s: i32): boolean {
  if s < 0 || s >= fnSets.length { return false }
  for d in fnSets[s] {
    const f = nodeAt(d)
    if f is FuncDecl && f.fnTyParams.length > 0 { return true }
  }
  false
}

// Notes a value of function type `t` as one of function `d`, the declaration or lambda it reads.
export function elabFnValNote(t: i32, d: i32) {
  if d < 0 || !elabFnValWanted(t) { return 0 }
  const one: i32[] = [d]
  elabFnSetTy[t] = fnSetIntern(
    fnSetUnion(elabFnSetTy[t] ?? -1, fnSetIntern(one)),
  )
  0
}

// The functions a value of type `t` may be, ascending; [] when `t` carries no set.
export function elabFnSetOf(t: i32): i32[] {
  const none: i32[] = []
  const s = elabFnSetTy[t] ?? -1
  if s < 0 { return none }
  fnSets[s]
}

// The function `t` is the singleton type of, or -1.
export function elabFnIdOf(t: i32): i32 {
  const ms = elabFnSetOf(t)
  if ms.length != 1 { return -1 }
  ms[0]
}

// The type a join of function types `a` and `b` into `j` gives its value: `j` itself when both
// carry one set, else a fresh index with `j`'s signature, holding the union when each side
// carries a set and none when one side may be any function, so `j`'s own set is not widened. A
// side that is no value yet (-1) leaves `j` as the other side made it.
export function elabFnJoinTy(j: i32, a: i32, b: i32): i32 {
  if j < 0 || j >= T.tys.length || a < 0 || b < 0 { return j }
  const jf = T.tys[j]
  if !(jf is TyFunc) { return j }
  const sa = elabFnSetTy[a] ?? -1
  const sb = elabFnSetTy[b] ?? -1
  if sa < 0 && sb < 0 { return j }
  if sa == sb && (elabFnSetTy[j] ?? -1) == sa { return j }
  const key = i32ToStr(a) + "," + i32ToStr(b)
  const memo = fnJoinMemo[key] ?? -1
  if memo >= 0 && memo < T.tys.length {
    const mf = T.tys[memo]
    if (
      mf is TyFunc
      && mf.fnRet == jf.fnRet
      && mf.fnParamTypes == jf.fnParamTypes
    ) {
      return memo
    }
  }
  const ps: i32[] = []
  for p in jf.fnParamTypes { ps.push(p) }
  const g: Ty = { fnParamTypes: ps, fnRet: jf.fnRet }
  T.tys.push(g)
  const fresh = T.tys.length - 1
  if sa >= 0 && sb >= 0 { elabFnSetTy[fresh] = fnSetIntern(fnSetUnion(sa, sb)) }
  fnJoinMemo[key] = fresh
  fresh
}

// The set of every function the `let` node `bd`, binding `nm`, may hold: its initialiser and
// each value its own scope writes to it, read from the source; -1 when one is not a function.
function fnLetSetOf(bd: i32, nm: string): i32 {
  const have = fnLetSet[bd] ?? -2
  if have != -2 { return have }
  let s = -1
  const ts = cwLetFnTargets(bd, nm)
  if ts.length > 0 && ts[0] >= 0 { s = fnSetIntern(fnSetSorted(ts)) }
  fnLetSet[bd] = s
  s
}

// The functions the `let` node `bd`, binding `nm`, may hold, ascending; [] when one is not a
// function.
export function elabFnLetMembers(bd: i32, nm: string): i32[] {
  const none: i32[] = []
  const s = fnLetSetOf(bd, nm)
  if s < 0 { return none }
  fnSets[s]
}

// The type a `let` node `bd`, binding `nm` and inferred `t`, gives its reads: `t` carrying the
// set of every function written to it as well as its initialiser's, as an `if`'s arms join.
export function elabFnLetTy(bd: i32, nm: string, t: i32): i32 {
  const n = nodeAt(bd)
  if !(n is LetDecl) || n.letKw != "let" || t < 0 || t >= T.tys.length {
    return t
  }
  const tf = T.tys[t]
  if !(tf is TyFunc) { return t }
  const s = elabFnSetTy[t] ?? -1
  if s < 0 { return t }
  if i32ListHas(fnLetVeto, bd) { return t }
  const w = fnLetSetOf(bd, nm)
  if w < 0 || w == s || fnSetHasGeneric(s) || fnSetHasGeneric(w) { return t }
  const key = "let" + i32ToStr(bd) + "," + i32ToStr(t)
  const memo = fnJoinMemo[key] ?? -1
  if memo >= 0 && memo < T.tys.length { return memo }
  const ps: i32[] = []
  for p in tf.fnParamTypes { ps.push(p) }
  const g: Ty = { fnParamTypes: ps, fnRet: tf.fnRet }
  T.tys.push(g)
  const fresh = T.tys.length - 1
  elabFnSetTy[fresh] = fnSetIntern(fnSetUnion(s, w))
  fnJoinMemo[key] = fresh
  if !fnTagEtaRan {
    fnLetWide.push(fresh)
    fnLetWideAt.push(bd)
  }
  fresh
}

// The type value type `t`, pinned into a slot of the container the receiver node `recv` names,
// gives that slot: `t` joined with every function the binding's own scope writes into its slots,
// as a list literal's elements join, so a read before a write sees the same slot type as one after.
export function elabSlotJoinTy(recv: i32, t: i32): i32 {
  if recv < 0 || t < 0 || t >= T.tys.length { return t }
  let r = recv
  let rn = nodeAt(r)
  while rn is Paren {
    r = rn.parInner
    rn = nodeAt(r)
  }
  if !(rn is Ident) { return t }
  const bd = identDeclOf(r)
  if bd < 0 || !(nodeAt(bd) is LetDecl) { return t }
  const tf = T.tys[t]
  if !(tf is TyFunc) { return t }
  const s = elabFnSetTy[t] ?? -1
  if s < 0 || i32ListHas(fnLetVeto, bd) { return t }
  const w = fnSlotSetOf(bd, rn.identName)
  if w < 0 || w == s || fnSetHasGeneric(s) || fnSetHasGeneric(w) { return t }
  const u = fnSetIntern(fnSetUnion(s, w))
  if u == s { return t }
  const key = "slot" + i32ToStr(bd) + "," + i32ToStr(t)
  const memo = fnJoinMemo[key] ?? -1
  if memo >= 0 && memo < T.tys.length { return memo }
  const ps: i32[] = []
  for p in tf.fnParamTypes { ps.push(p) }
  const g: Ty = { fnParamTypes: ps, fnRet: tf.fnRet }
  T.tys.push(g)
  const fresh = T.tys.length - 1
  elabFnSetTy[fresh] = u
  fnJoinMemo[key] = fresh
  if !fnTagEtaRan {
    fnSlotWide.push(fresh)
    fnSlotWideAt.push(bd)
  }
  fresh
}

// The set of every function the `let` node `bd`, binding `nm`, writes into its slots; -1 when
// one is not a function or there is none.
function fnSlotSetOf(bd: i32, nm: string): i32 {
  const have = fnSlotSet[bd] ?? -2
  if have != -2 { return have }
  let s = -1
  const ts = cwLetSlotFnTargets(bd, nm)
  if ts.length > 0 && ts[0] >= 0 { s = fnSetIntern(fnSetSorted(ts)) }
  fnSlotSet[bd] = s
  s
}

// The ids `ts` without repeats, ascending.
function fnSetSorted(ts: i32[]): i32[] {
  const ms: i32[] = []
  for t in ts {
    if !i32ListHas(ms, t) {
      ms.push(t)
      let at = ms.length - 1
      while at > 0 && ms[at - 1] > t {
        ms[at] = ms[at - 1]
        at = at - 1
      }
      ms[at] = t
    }
  }
  ms
}

// The type node `ix` has in the running instance, while one is recorded, else the type the
// check recorded; -1 for none.
export function elabLiveTyOf(ix: i32): i32 {
  let t = -1
  if elabCapLive() { t = elabCapTy[ix] ?? -1 }
  if t < 0 { t = nodeTyIxOf(ix) }
  t
}

// The function a call through callee node `callFn` reaches by its value's singleton type, or -1.
export function elabCalleeFnId(callFn: i32): i32 {
  elabFnIdOf(elabLiveTyOf(callFn))
}

// The calls through a value of a set of two or more functions, once each in the order first
// seen; by call node, the set's id, its parameter types' spelling and whether the members give
// the call different results (D3975).
let fnTagCallIxs: i32[] = []
let fnTagCallSet: {[i32]: i32} = Map()
let fnTagCallKey: {[i32]: string} = Map()
let fnTagCallSplit: {[i32]: boolean} = Map()
let fnTagCallRs: {[i32]: i32[]} = Map()
// By call node: the refusal a call whose members disagree owes when its set stays a closure.
let fnTagCallMsg: {[i32]: string} = Map()
let fnTagCallMsgAt: {[i32]: i32} = Map()
// By leaf node of a tagged set's value: the member whose id it emits.
let fnTagLeaf: {[i32]: i32} = Map()
// By function declaration: one whose result is a tagged set's value.
let fnTagRet: {[i32]: boolean} = Map()
// By call node: a direct call of each member at the call's arguments, in set order.
let fnTagArms: {[i32]: i32[]} = Map()
// By call node and set id: the member calls of a generic call whose instances see another tagged
// set than the one its first note recorded.
let fnTagArmsBy: {[string]: i32[]} = Map()

// Whether call `ix` names the one member of set `s` by its own name: a direct call, not a call
// through a value of the set.
function fnTagSelfCall(ix: i32, s: i32): boolean {
  const c = nodeAt(ix)
  if !(c is Call) { return false }
  const ds = fnTagMembers(s)
  if ds.length != 1 || c.callFn < 0 || c.callFn >= P.nodes.length {
    return false
  }
  const n = nodeAt(c.callFn)
  const f = nodeAt(ds[0])
  if !(n is Ident) || !(f is FuncDecl) { return false }
  n.identName == f.fnName
}

// Notes the call `ix` through a value of set `s` at parameter types spelled `key`, `split`
// when its members give it different results; clears any refusal an earlier pass recorded.
export function fnTagCallNote(
  ix: i32,
  s: i32,
  key: string,
  split: boolean,
  rs: i32[],
) {
  if fnTagSelfCall(ix, s) { return 0 }
  if !fnTagCallSet.has(ix) { fnTagCallIxs.push(ix) }
  fnTagCallSet[ix] = s
  fnTagCallKey[ix] = key
  fnTagCallSplit[ix] = split
  fnTagCallRs[ix] = rs
  fnTagCallMsg[ix] = ""
  fnTagCallMsgAt[ix] = -1
  0
}

// Records the refusal `msg` at `at` that call `ix` owes unless its set is tagged.
export function fnTagCallRefusal(ix: i32, msg: string, at: i32) {
  fnTagCallMsg[ix] = msg
  fnTagCallMsgAt[ix] = at
  0
}

// Every call `fnTagCallNote` recorded, in the order first seen.
export function fnTagCalls(): i32[] { fnTagCallIxs }

// The set id call `ix` goes through, or -1.
export function fnTagCallSetOf(ix: i32): i32 { fnTagCallSet[ix] ?? -1 }

// Whether call `ix`'s members give it different results.
export function fnTagCallSplits(ix: i32): boolean {
  fnTagCallSplit[ix] ?? false
}

// What each member of call `ix`'s set returns there, in set order.
export function fnTagCallRsOf(ix: i32): i32[] {
  const none: i32[] = []
  fnTagCallRs[ix] ?? none
}

// The refusal call `ix` owes when its set is not tagged, "" for none, and where it lands.
export function fnTagCallMsgOf(ix: i32): string { fnTagCallMsg[ix] ?? "" }
export function fnTagCallMsgAtOf(ix: i32): i32 { fnTagCallMsgAt[ix] ?? -1 }

// The set id type `t` carries, or -1.
export function fnTagSetOfTy(t: i32): i32 {
  if t < 0 { return -1 }
  elabFnSetTy[t] ?? -1
}

// Whether a value of type `t` holds one of two or more declared functions, chosen where it is made.
export function fnTagChoiceOfTy(t: i32): boolean {
  const ds = fnTagMembers(fnTagSetOfTy(t))
  if ds.length < 2 { return false }
  for d in ds {
    const f = nodeAt(d)
    if !(f is FuncDecl) { return false }
  }
  true
}

// Whether the value at `site`, of type `t`, is a choice: one of two or more declared functions,
// or a one-member `if` or `match`, directly or through the `const` or `let` it initialises.
export function fnTagChoiceAt(site: i32, t: i32): boolean {
  if fnTagChoiceOfTy(t) { return true }
  const ds = fnTagMembers(fnTagSetOfTy(t))
  if ds.length != 1 || !(nodeAt(ds[0]) is FuncDecl) { return false }
  let x = fnTagPeel(site)
  if x < 0 { return false }
  const n = nodeAt(x)
  if n is Ident {
    const ld = identDeclOf(x)
    if ld < 0 { return false }
    const l = nodeAt(ld)
    if !(l is LetDecl) { return false }
    x = fnTagPeel(l.letInit)
  }
  if x < 0 { return false }
  const v = nodeAt(x)
  v is IfStmt || v is MatchExpr
}

// The node `ix` names through parentheses.
function fnTagPeel(ix: i32): i32 {
  if ix < 0 { return ix }
  const e = nodeAt(ix)
  if e is Paren { return fnTagPeel(e.parInner) }
  ix
}

// A choice delivered where a closed function type is expected is built there as a closure over
// the value, chosen once, when its set is tagged: one check notes the sites, and the next builds
// them (`fnTagEtaAgain`).
let fnTagEscapes: i32[] = []
let fnTagEtaSites: i32[] = []
let fnTagEtaRan = false

// The widened `let` and slot types of this check and their `let` nodes; the `let`s whose widened
// set the decision left untagged, which the next check gives their initialiser's type.
let fnLetWide: i32[] = []
let fnLetWideAt: i32[] = []
let fnSlotWide: i32[] = []
let fnSlotWideAt: i32[] = []
let fnLetVeto: i32[] = []

// Forgets every fact keyed by a type index, which a restart of the check re-mints from an empty
// arena: a stale entry would give another type a set. A call through a set is one only in the
// check that last typed it, so its note goes too: a callee the next check types closed is a
// closure call, and the decision must not tag a set on its account.
export function fnTyFactsReset() {
  elabFnSetTy = Map()
  fnTagCallIxs = []
  fnTagCallSet = Map()
  fnTagCallKey = Map()
  fnTagCallSplit = Map()
  fnTagCallRs = Map()
  fnTagCallMsg = Map()
  fnTagCallMsgAt = Map()
  fnJoinMemo = Map()
  fnLetWide = []
  fnLetWideAt = []
  fnSlotWide = []
  fnSlotWideAt = []
  0
}

// Forgets the sites of an earlier program; once per `checkProgram`.
export function fnTagEtaReset() {
  fnTagEtaSites = []
  fnTagEtaRan = false
  fnTagEscapes = []
  fnLetWide = []
  fnLetWideAt = []
  fnSlotWide = []
  fnSlotWideAt = []
  fnLetVeto = []
}

// Notes delivery `site` of a choice for the decision that may build it.
export function fnTagEscapeNote(site: i32) {
  if !fnTagEtaRan { fnTagEscapes.push(site) }
}

// The deliveries noted this check, which the decision then forgets.
export function fnTagEscapesTake(): i32[] {
  const out = fnTagEscapes
  fnTagEscapes = []
  out
}

// Whether delivery `site` is built as a closure over its value.
export function fnTagEtaAt(site: i32): boolean {
  fnTagEtaRan && i32ListHas(fnTagEtaSites, site)
}

// Asks for delivery `site` to be built; true when it is new.
export function fnTagEtaWant(site: i32): boolean {
  if fnTagEtaRan || i32ListHas(fnTagEtaSites, site) { return false }
  fnTagEtaSites.push(site)
  true
}

// Whether `t` is the type a `let` written with other functions than its initialiser gives its reads.
export function fnLetIsWide(t: i32): boolean { i32ListHas(fnLetWide, t) }

// Whether the program is checked once more, at most once: to build the sites asked for, or to
// give a `let` whose widened set stayed untagged its initialiser's type.
export function fnTagEtaAgain(): boolean {
  if fnTagEtaRan { return false }
  let i = 0
  while i < fnLetWide.length && i < fnLetWideAt.length {
    if !fnTagTyIsTagged(fnLetWide[i]) { fnLetVeto.push(fnLetWideAt[i]) }
    i = i + 1
  }
  i = 0
  while i < fnSlotWide.length && i < fnSlotWideAt.length {
    if !fnTagTyIsTagged(fnSlotWide[i]) { fnLetVeto.push(fnSlotWideAt[i]) }
    i = i + 1
  }
  if fnTagEtaSites.length == 0 && fnLetVeto.length == 0 { return false }
  fnTagEtaRan = true
  true
}

// The members of set `s`, ascending.
export function fnTagMembers(s: i32): i32[] {
  const none: i32[] = []
  if s < 0 || s >= fnSets.length { return none }
  fnSets[s]
}

// Whether type `t` is a list of a tagged set's ids, whose cell is the i32 list.
export function fnTagListTy(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const a = T.tys[t]
  if a is TyArray { return fnTagTyIsTagged(a.aElem) }
  false
}

// Whether type `t` holds a tagged set's ids: such a list or map, or a record with a field that is one
// or holds one, at most `depth` records deep.
export function fnTagHoldsTy(t: i32, depth: i32): boolean {
  if depth <= 0 || t < 0 || t >= T.tys.length { return false }
  const o = T.tys[t]
  match o {
    TyArray => {
      return fnTagTyIsTagged(o.aElem)
    }
    TyObj => {
      for f in o.objFieldTypes {
        if fnTagTyIsTagged(f) || fnTagHoldsTy(f, depth - 1) { return true }
      }
      return false
    }
    TyMap => {
      return fnTagTyIsTagged(o.mVal)
    }
    // No other kind holds ids as a container.
    TyPrim | TyErr | TyFunc | TyUnion | TyNullable | TyVar | TyLit | TyNeg => {
      return false
    }
  }
}

// Whether set `s` is tagged.
export function fnTagSetIsTagged(s: i32): boolean { fnTagged[s] ?? false }

// The member whose id leaf node `ix` emits, or -1.
export function fnTagLeafId(ix: i32): i32 {
  fnTagLeaf[ix] ?? (fnTagLeaf[nodeSrc[ix] ?? -1] ?? -1)
}

// The direct calls call `ix` dispatches between, one per member in set order; [] when its set
// is not tagged.
export function fnTagCallArms(ix: i32): i32[] {
  const none: i32[] = []
  if !fnTagSetIsTagged(fnTagCallSetOf(ix)) { return none }
  fnTagArms[ix] ?? none
}

function fnTagArmsKey(ix: i32, s: i32): string {
  i32ToStr(ix) + "," + i32ToStr(s)
}

// The member calls built for call `ix` at tagged set `s`; [] for none, or when `s` is untagged.
export function fnTagArmsAt(ix: i32, s: i32): i32[] {
  const none: i32[] = []
  if s < 0 || !fnTagSetIsTagged(s) { return none }
  if s == fnTagCallSetOf(ix) { return fnTagArms[ix] ?? none }
  fnTagArmsBy[fnTagArmsKey(ix, s)] ?? none
}

// Records the member calls `arms` call `ix` dispatches between at set `s`.
export function fnTagArmsAtSet(ix: i32, s: i32, arms: i32[]) {
  if s == fnTagCallSetOf(ix) {
    fnTagArms[ix] = arms
  } else {
    fnTagArmsBy[fnTagArmsKey(ix, s)] = arms
  }
  0
}

// Records set `s` as tagged, with leaf `leaves[k]` naming member `ids[k]`.
export function fnTagMark(s: i32, leaves: i32[], ids: i32[]) {
  fnTagged[s] = true
  let k = 0
  while k < leaves.length {
    fnTagLeaf[leaves[k]] = ids[k]
    k = k + 1
  }
  0
}

// Records that function declaration `d` returns a value of a tagged set.
export function fnTagRetMark(d: i32) {
  fnTagRet[d] = true
  0
}

// Whether function declaration `d` returns the id of a tagged set's member.
export function fnTagRetIsTagged(d: i32): boolean { fnTagRet[d] ?? false }

// Records call `nc`, an instance's copy of tagged call `tpl` at set `s`, as dispatching between
// `arms`; a set other than the one `tpl` is noted at is the instance's own, with no split.
export function fnTagCallCopy(nc: i32, tpl: i32, s: i32, arms: i32[]) {
  if s < 0 { return 0 }
  const none: i32[] = []
  if s != fnTagCallSetOf(tpl) {
    fnTagCallNote(nc, s, "", false, none)
    fnTagArms[nc] = arms
    return 0
  }
  fnTagCallNote(
    nc,
    s,
    fnTagCallKey[tpl] ?? "",
    fnTagCallSplit[tpl] ?? false,
    fnTagCallRs[tpl] ?? none,
  )
  fnTagArms[nc] = arms
  0
}

// Forgets every tagging decision, before the checker's last pass makes them again.
export function fnTagUndecide() {
  fnTagged = Map()
  fnTagLeaf = Map()
  fnTagRet = Map()
  0
}

// Clears every per-program elaboration table; a compile's rounds each start from none.
export function elabCapReset() {
  elabCapOn = false
  elabCapQuiet = 0
  elabCapTy = Map()
  elabCallIx = []
  elabCallN = []
  elabCallT = []
  elabCallD = []
  elabCallDecl = Map()
  elabCapKey = -1
  elabEncl = Map()
  elabSnapIx = Map()
  elabSnapNames = []
  elabSnapTys = []
  elabSnapSlot = []
  elabSnapConst = []
  elabSnapFnDecl = []
  elabSnapFnAlias = []
  elabHoleRowDecl = []
  elabHoleRowFrom = []
  elabHoleRowN = []
  elabHoleRowT = []
  elabFnSetTy = Map()
  fnSets = []
  fnSetByKey = Map()
  fnJoinMemo = Map()
  fnLetSet = Map()
  fnSlotSet = Map()
  fnTagCallIxs = []
  fnTagCallSet = Map()
  fnTagCallKey = Map()
  fnTagCallSplit = Map()
  fnTagCallRs = Map()
  fnTagCallMsg = Map()
  fnTagCallMsgAt = Map()
  fnTagged = Map()
  fnTagLeaf = Map()
  fnTagRet = Map()
  fnTagArms = Map()
  fnTagArmsBy = Map()
  0
}
