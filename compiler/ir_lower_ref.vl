// `ir_lower_ref.vl` — the IR lowering of reference values and list reads (ir-design-2026-11.md
// §5.3, I2's list half). A list read writes its operands, then legacy's own guard and
// `array.get`; a bounds check lowers as nothing, fused into the read after it (rule 8). Scratch
// slots come from the shared lazy list frame, and a loop opens legacy's header hoists, which a
// read asks `liveHoistRow` for. Holds the copy of legacy's list-read decision the shared
// predicate replaces.

import { Index, OP_INDEX_GET, WhileStmt, nodeAt } from "./ast"
import { RListGet, Rhs, SBoundsCheck } from "./ir"
import { irLFn, irLMiss, irLOpnd, irLSkip } from "./ir_lower"
import {
  emitListIdxGuard,
  emitListIdxGuardHoisted,
  idxCellReadIsNull,
  liveHoistRow,
  loopHoistClose,
  loopHoistOpen,
  scalarListBack,
  scalarListUsed,
  scalarListWrap,
  svDstOfKind,
} from "./wasmEmit"
import {
  exprNulScalarListKind,
  exprNulStrArray,
  exprPackedRow,
  exprRefArray,
  exprStringArray,
} from "./emit_classify"
import { scalarListElemKind } from "./emit_value_sites"
import { listIdxKindOf, listIdxWrapSlot } from "./emit_union_casts"
import { twoListUseMsg } from "./emit_fn_ret_kinds"
import { fbArrayGet } from "./emit_bytes"

// Why legacy does not lower list read `idxIx` on its plain guarded path, or "" when it does:
// the decision `emitIndex` makes before `emitIndexScalarList`'s unhoisted, unviewed arm.
export function listIdxPlainWhy(idxIx: i32, fnIx: i32): string {
  const nd = nodeAt(idxIx)
  if !(nd is Index) { return "index node" }
  if idxCellReadIsNull(idxIx, fnIx) { return "index cell null" }
  if twoListUseMsg(nd.idxArr, OP_INDEX_GET, fnIx) != "" {
    return "index two lists"
  }
  if exprNulScalarListKind(nd.idxArr, fnIx) != null {
    return "index nullable list"
  }
  if exprRefArray(nd.idxArr, fnIx) { return "index ref list" }
  if exprNulStrArray(nd.idxArr, fnIx) || exprStringArray(nd.idxArr, fnIx) {
    return "index str list"
  }
  const ek = scalarListElemKind(nd.idxArr, fnIx)
  if ek == null { return "index string" }
  if !scalarListUsed(ek) { return "index uncollected list" }
  if svDstOfKind(ek) >= 0 { return "index view" }
  return ""
}

// `RListGet`: the index, then legacy's guard over the loop's hoisted header when one is live (the
// receiver is not read), else the receiver too and the wrapper's guard; then the backing's read.
function lowerList(r: Rhs): i32 {
  if !(r is RListGet) { return irLMiss("list length") }
  const nd = nodeAt(r.lgAt)
  if !(nd is Index) { return irLMiss("list read node") }
  const fnIx = irLFn().irAt
  const ek = scalarListElemKind(nd.idxArr, fnIx)
  if ek == null { return irLMiss("list read element") }
  const row = exprPackedRow(nd.idxArr, fnIx)
  const hz = liveHoistRow(nd.idxArr, listIdxKindOf(ek), row)
  if hz >= 0 {
    irLSkip(r.lgV)
    irLOpnd(r.lgIx)
    emitListIdxGuardHoisted(hz, nd.idxIndex)
  } else {
    irLOpnd(r.lgV)
    irLOpnd(r.lgIx)
    emitListIdxGuard(
      listIdxWrapSlot(listIdxKindOf(ek), row),
      scalarListWrap(ek, row),
    )
  }
  fbArrayGet(scalarListBack(ek, row))
  return 0
}

// The list-header hoists of the loop statement at `at`, opened as legacy's loop opens them.
function loopOpen(at: i32): i32 {
  if at < 0 { return 0 }
  const s = nodeAt(at)
  if !(s is WhileStmt) { return 0 }
  return loopHoistOpen(s.whileCond, s.whileBody, irLFn().irAt, -1, -1)
}
// A bounds check is fused into the `RListGet` after it, which writes the guard; its operand
// reads consume nothing, so the temps it names stay pending for that read.
function lowerBounds(_n: SBoundsCheck, _pending: i32[]): i32 { return 0 }

export function irLowerRefList(r: Rhs): i32 { return lowerList(r) }

export function irLowerRefBounds(n: SBoundsCheck, pending: i32[]): i32 {
  return lowerBounds(n, pending)
}

export function irLowerRefLoopOpen(at: i32): i32 { return loopOpen(at) }

export function irLowerRefLoopClose(n: i32): i32 { return loopHoistClose(n) }
