import { mfCallbackLocal } from "./emit_union_casts"

// `ir_lower_ref.vl` — the IR lowering of reference values and list reads (ir-design-2026-11.md
// §5.3, I2's list half). A list read writes its operands, then legacy's own guard and
// `array.get`, through the read arm and the arm decision legacy shares (`scalarListGetTail`,
// `idxArmOf`); a bounds check lowers as nothing, fused into the read after it (rule 8). Scratch
// slots come from the shared lazy list frame, and a loop opens legacy's header hoists.

import { fbRefAsNonNull, fbStrLen } from "./emit_bytes"
import { memberLengthArmOf } from "./emit_plan_union"
import { unwrapParen } from "./emit_base"
import {
  BinExpr,
  Call,
  ForRange,
  Index,
  Member,
  Node,
  P,
  WhileStmt,
  nodeAt,
} from "./ast"
import { fbDrop } from "./emit_bytes"
import { storageReadEnter, storageReadLeave } from "./emit_elab"
import {
  OImm,
  PStaged,
  RCoerce,
  RListCat,
  RListClear,
  RListEq,
  RListGet,
  RListLen,
  RListPop,
  RListPush,
  RListPushMany,
  RListSlice,
  RListStage,
  RMapFilter,
  RMapFilterHead,
  RStrOp,
  Rhs,
  SBoundsCheck,
  SListSet,
} from "./ir"
import {
  LoopOpened,
  irGetIdxBegin,
  irGetIdxEnd,
  irLAt,
  irLFn,
  irLIndexFrom,
  irLIndexRow,
  irLMakeClo,
  irLMiss,
  irLOpnd,
  irLReadAgain,
  irLRecvOpnd,
  irLSkip,
  irLoopHoistOpen,
} from "./ir_lower"
import {
  arrLenHoistOf,
  arrLenTail,
  arrSlicePlanOf,
  arrSliceTail,
  catWidenTail,
  clearLenTail,
  clearPlanOf,
  coerceTail,
  emitArrLenHeld,
  emitClosureValue,
  emitEqNonNullCore,
  emitListGetViewSync,
  eqRouteOf,
  fcpBackingTail,
  fcpLenTail,
  fcpSpillTail,
  forRangeStaticStep,
  fromCpTail,
  idxArmOf,
  idxCellReadIsNull,
  idxStoreHoistOf,
  idxStoreTail,
  listCatOperandTail,
  listCatTail,
  listEqOperandTail,
  listEqTail,
  listEqXTail,
  listFitGrowLenClose,
  listFitGrowLenOpen,
  listFitGrowLenRowOf,
  listGetStageEnter,
  listGetStageRestore,
  listOpRecvHeld,
  listOpStageBase,
  loopHoistClose,
  mapFilterPlanOf,
  mfLoopTail,
  mfRecvTail,
  nullReadDstOwnOf,
  popAnyPlanOf,
  popRefTail,
  popScalarTail,
  pushAppendTail,
  pushManyOpen,
  pushManyRecvOf,
  pushManyRecvTail,
  pushManyTail,
  pushPlainWhy,
  pushValueTail,
  rangeProofClose,
  rangeProofOpen,
  rawStrGetTail,
  rawStrHoistOf,
  refListGetTail,
  refListHoistOf,
  scalarListGetTail,
  scalarListHoistOf,
  scalarListUsed,
  sliceRecvTail,
  stageListRecvTail,
  strAccAppendTail,
  strBytesTail,
  strCatTail,
  strCpAtTail,
  strCpLenTail,
  strEqFirstOf,
  strEqLitForm,
  strEqLitHead,
  strEqLitOf,
  strEqLitTail,
  strEqNegTail,
  strFromBytesTail,
  strInPlaceMode,
  strIndexOfTail,
  strIsCharBoundaryTail,
  strListGetTail,
  strListHoistOf,
  strListReadsNonNull,
  strOrderTail,
  strSiteCatTail,
  strSliceTail,
} from "./wasmEmit"
import { eqOperandRecovers } from "./emit_plan_union"
import { idxStorePlanOf, pushPlanOf } from "./emit_plan_list"
import { scalarListElemKind } from "./emit_value_sites"
import { exprNullableRefArray, refListSlotOfExpr } from "./emit_classify"
import { rlRowsMinted } from "./emit_state"
import { callSpillsFcpArg, exprPopBits } from "./emit_fn_scans"

// Why the IR does not lower list read `idxIx`, or "" when it does: legacy's own arm decision
// (`idxArmOf`) took a scalar list, collected and not a view, a string or `(string | null)` list,
// or a ref list whose read keeps no nullable niche and reads no view.
export function listIdxPlainWhy(idxIx: i32, fnIx: i32): string {
  const nd = nodeAt(idxIx)
  if !(nd is Index) { return "index node" }
  if idxCellReadIsNull(idxIx, fnIx) && nullReadDstOwnOf(idxIx, fnIx) >= 0 {
    return "index cell null"
  }
  const arm = idxArmOf(nd, fnIx)
  if arm == "ref" { return refReadWhy(nd, fnIx) }
  if arm == "string" || arm == "str" || arm == "nulstr" { return "" }
  if arm != "scalar" { return "index " + arm }
  const ek = scalarListElemKind(nd.idxArr, fnIx)
  if ek == null || !scalarListUsed(ek) { return "index uncollected list" }
  return ""
}

function refReadWhy(nd: Index, fnIx: i32): string {
  if !rlRowsMinted() || exprNullableRefArray(nd.idxArr, fnIx) {
    return "index ref receiver"
  }
  if refListSlotOfExpr(nd.idxArr, fnIx) < 0 { return "index ref slot" }
  return ""
}

// `RListGet`: legacy's read arm, scalar or ref, its receiver and index the read's operands. A
// receiver a live loop hoist holds is consumed without being written.
function lowerList(r: Rhs): i32 {
  if r is RListLen { return lowerLen(r) }
  if r is RStrOp { return lowerStr(r) }
  if r is RListEq { return lowerListEq(r) }
  if r is RListCat { return lowerListCat(r) }
  if r is RCoerce {
    irLOpnd(r.cvV)
    return coerceTail(r.cvAt, irLFn().irAt)
  }
  if r is RListPush { return lowerPush(r, true) }
  if r is RListPushMany { return lowerPushMany(r, true) }
  if r is RListPop { return lowerPop(r, true) }
  if r is RMapFilter { return lowerMapFilter(r) }
  if r is RListSlice { return lowerListSlice(r) }
  if !(r is RListGet) { return irLMiss("list rhs") }
  const from = irLIndexFrom(r.lgAt, irLAt())
  // A read the builder built at its storage is lowered at it, as legacy writes it there.
  const mark = storageReadEnter(if r.lgStored { r.lgAt } else { -1 })
  const got = lowerGet(r)
  storageReadLeave(mark)
  irLIndexRow(r.lgAt, from)
  return got
}

// `RListGet`'s read, its element-read row banked around it by `lowerList`.
function lowerGet(r: RListGet): i32 {
  const nd = nodeAt(r.lgAt)
  if !(nd is Index) { return irLMiss("list read node") }
  const fnIx = irLFn().irAt
  const arm = idxArmOf(nd, fnIx)
  if arm == "string" {
    const sz = rawStrHoistOf(nd.idxArr)
    irLRecvOpnd(r.lgV, nd.idxArr, sz >= 0, r.lgAgain)
    irLRecvOpnd(r.lgIx, nd.idxIndex, false, r.lgAgain)
    return rawStrGetTail(sz)
  }
  // A `(string | null)` element is recovered non-null only where the checker types it so.
  if arm == "str" || arm == "nulstr" {
    const lz = strListHoistOf(nd)
    irLRecvOpnd(r.lgV, nd.idxArr, lz >= 0, r.lgAgain)
    irLRecvOpnd(r.lgIx, nd.idxIndex, false, r.lgAgain)
    return strListGetTail(nd, lz, strListReadsNonNull(r.lgAt, arm == "nulstr"))
  }
  if arm == "ref" {
    const rslot = refListSlotOfExpr(nd.idxArr, fnIx)
    const rz = refListHoistOf(nd, rslot)
    irLRecvOpnd(r.lgV, nd.idxArr, rz >= 0, r.lgAgain)
    irLRecvOpnd(r.lgIx, nd.idxIndex, false, r.lgAgain)
    return refListGetTail(nd, r.lgAt, fnIx, rslot, rz)
  }
  const ek = scalarListElemKind(nd.idxArr, fnIx)
  if ek == null { return irLMiss("list read element") }
  const hz = scalarListHoistOf(nd, ek, fnIx)
  irLRecvOpnd(r.lgV, nd.idxArr, hz >= 0, r.lgAgain)
  irLRecvOpnd(r.lgIx, nd.idxIndex, false, r.lgAgain)
  return scalarListGetTail(nd, ek, fnIx, hz)
}

// `RListPush`: the receiver held in its local, staged as legacy stages it, or already staged by
// its `RListStage`; then the value and legacy's append. `want` leaves the new length.
function lowerPush(r: RListPush, want: boolean): i32 {
  const fnIx = irLFn().irAt
  const pp = pushPlanOf(r.lpAt, fnIx)
  if pp == null { return irLMiss("push plan") }
  let lIdx = listOpRecvHeld(pp.ppRecv, fnIx, ".push")
  if lIdx == -2 { return irLMiss("push receiver") }
  const v = r.lpV
  if v is PStaged {
    if lIdx >= 0 { return irLMiss("push stage disagrees") }
    lIdx = pp.ppSlot.base + 3
  } else if lIdx >= 0 {
    irLSkip(v)
  } else if (exprPopBits(pp.ppArg, fnIx) & 512) != 0 {
    // A late receiver is staged after the value (`pushLateRhs`).
    irLOpnd(r.lpX)
    pushValueTail(pp, fnIx)
    irLOpnd(v)
    stageListRecvTail(pp.ppRecv, fnIx, pp.ppSlot.base)
    return pushAppendTail(r.lpAt, pp, pp.ppSlot.base + 3, want)
  } else {
    irLOpnd(v)
    stageListRecvTail(pp.ppRecv, fnIx, pp.ppSlot.base)
    lIdx = pp.ppSlot.base + 3
  }
  irLOpnd(r.lpX)
  pushValueTail(pp, fnIx)
  return pushAppendTail(r.lpAt, pp, lIdx, want)
}

// `RListPushMany`: legacy's plan asked before the receiver (`pushManyOpen`), the receiver and its
// stage, the run, then legacy's bulk append (`pushManyTail`). `want` leaves the new length.
function lowerPushMany(r: RListPushMany, want: boolean): i32 {
  const fnIx = irLFn().irAt
  const recv = pushManyRecvOf(r.pmAt)
  if recv < 0 { return irLMiss("push many node") }
  const p = pushManyOpen(r.pmAt, fnIx)
  if p == null { return -1 }
  irLOpnd(r.pmV)
  pushManyRecvTail(p, recv, fnIx)
  irLOpnd(r.pmL)
  return pushManyTail(p, want)
}

// `RListStage`: the receiver of push `rsgAt` read and staged as legacy stages it, ahead of the
// push's value; legacy must stage this receiver early, or the push is legacy's.
function lowerListStage(r: RListStage): i32 {
  const fnIx = irLFn().irAt
  const pp = pushPlanOf(r.rsgAt, fnIx)
  if pp == null { return irLMiss("push plan") }
  if (
    listOpRecvHeld(pp.ppRecv, fnIx, ".push") != -1
    || pushPlainWhy(pp, fnIx) != ""
  ) {
    return irLMiss("push stage disagrees")
  }
  irLOpnd(r.rsgV)
  return stageListRecvTail(pp.ppRecv, fnIx, pp.ppSlot.base)
}

// `SListSet`: the receiver (or its live hoist), index and value, then legacy's park, guard and
// `array.set`; the bounds check before it lowers as nothing.
export function irLowerRefListSet(n: SListSet, at: i32): i32 {
  const a = nodeAt(at)
  if !(a is BinExpr) { return irLMiss("store node") }
  const t = nodeAt(a.binLeft)
  if !(t is Index) { return irLMiss("store target") }
  const st = idxStorePlanOf(t, irLFn().irAt)
  if st == null { return irLMiss("store plan") }
  const hz = idxStoreHoistOf(t, st)
  if hz >= 0 { irLSkip(n.lsV) } else { irLOpnd(n.lsV) }
  irLOpnd(n.lsIx)
  irLOpnd(n.lsSrc)
  idxStoreTail(t, st, hz)
  return 0
}

// `RListPop`: the receiver held or staged as for a push, then legacy's scalar or ref pop tail, at a
// value position when `want`.
function lowerPop(r: RListPop, want: boolean): i32 {
  if r.lqIx.length > 0 {
    const sv = listGetStageEnter(r.lqAt)
    const got = lowerListGetCall(r, want)
    listGetStageRestore(sv)
    return got
  }
  const fnIx = irLFn().irAt
  const pq = popAnyPlanOf(r.lqAt, fnIx)
  if pq == null { return irLMiss("pop plan") }
  let lIdx = listOpRecvHeld(pq.pqRecv, fnIx, ".pop")
  if lIdx == -2 { return irLMiss("pop receiver") }
  if lIdx >= 0 {
    irLSkip(r.lqV)
  } else {
    irLOpnd(r.lqV)
    const sb = listOpStageBase(pq.pqBase, pq.pqRefSlot)
    stageListRecvTail(pq.pqRecv, fnIx, sb)
    lIdx = sb + 3
  }
  // A statement drops what the tail left, as legacy's statement caller does.
  const got = if pq.pqElemRef { popRefTail(r.lqAt, lIdx, pq.pqWrap, pq.pqBack, -1, pq.pqRefSlot, fnIx) } else { popScalarTail(r.lqAt, pq.pqRecv, lIdx, pq.pqWrap, pq.pqBack, -1, want, fnIx) }
  if got < 0 { return -1 }
  if !want && got == 0 { fbDrop() }
  return 0
}

// `RListPop` with an index, a `.get(i)`: the receiver as for a pop, the view sync, then legacy's
// tail, which writes the index from the call; the index operand is consumed without being written.
// The tail leaves `T | null` as at a value; a statement drops it.
function lowerListGetCall(r: RListPop, want: boolean): i32 {
  const fnIx = irLFn().irAt
  const pq = popAnyPlanOf(r.lqAt, fnIx)
  if pq == null { return irLMiss("get plan") }
  const c = nodeAt(r.lqAt)
  if !(c is Call) || c.callFn < 0 || c.callArgs.length != 1 {
    return irLMiss("get call")
  }
  const callee = nodeAt(c.callFn)
  if !(callee is Member) { return irLMiss("get call") }
  let lIdx = listOpRecvHeld(pq.pqRecv, fnIx, ".get")
  if lIdx == -2 { return irLMiss("get receiver") }
  if lIdx >= 0 {
    irLSkip(r.lqV)
  } else {
    irLOpnd(r.lqV)
    const sb = listOpStageBase(pq.pqBase, pq.pqRefSlot)
    stageListRecvTail(pq.pqRecv, fnIx, sb)
    lIdx = sb + 3
  }
  const ek = scalarListElemKind(callee.memObj, fnIx)
  emitListGetViewSync(
    lIdx,
    if ek == "i32" { null } else { ek },
    callee.memObj,
    fnIx,
  )
  // Legacy's tail reads the index at each use: the builder's operand where it may be read again.
  const hooked = irGetIdxBegin(r.lqIx[0])
  if !hooked { irLSkip(r.lqIx[0]) }
  const gi = c.callArgs[0]
  const got = if pq.pqElemRef { popRefTail(r.lqAt, lIdx, pq.pqWrap, pq.pqBack, gi, pq.pqRefSlot, fnIx) } else { popScalarTail(r.lqAt, pq.pqRecv, lIdx, pq.pqWrap, pq.pqBack, gi, true, fnIx) }
  if hooked { irGetIdxEnd() }
  if got < 0 { return -1 }
  if !want && got == 0 { fbDrop() }
  return 0
}

// `RListClear`: the receiver held or staged as for a pop, then legacy's length reset.
function lowerClear(r: RListClear): i32 {
  const fnIx = irLFn().irAt
  const p = clearPlanOf(r.lkAt, fnIx)
  if p.clFail != "" { return irLMiss("clear plan") }
  let lIdx = listOpRecvHeld(p.clRecv, fnIx, ".clear")
  if lIdx == -2 { return irLMiss("clear receiver") }
  if lIdx >= 0 {
    irLSkip(r.lkV)
  } else {
    irLOpnd(r.lkV)
    const sb = listOpStageBase(p.clBase, p.clRefSlot)
    stageListRecvTail(p.clRecv, fnIx, sb)
    lIdx = sb + 3
  }
  return clearLenTail(p, lIdx)
}

// A list op in statement position.
export function irLowerRefEffect(r: Rhs): i32 {
  if r is RListPush { return lowerPush(r, false) }
  if r is RListPushMany { return lowerPushMany(r, false) }
  if r is RListStage { return lowerListStage(r) }
  if r is RMapFilterHead { return lowerMapFilterHead(r) }
  if r is RListPop { return lowerPop(r, false) }
  if r is RListClear { return lowerClear(r) }
  if r is RStrOp && r.soOp == "acc" { return lowerStr(r) }
  return irLMiss("effect outside I1")
}

// `RMapFilter`: legacy's plan and callback slot where its arm takes them, the receiver and its
// tail, the callback's closure value (built here for a capture-free function), then the loop.
function lowerMapFilter(r: RMapFilter): i32 {
  const fnIx = irLFn().irAt
  const p = mapFilterPlanOf(r.hfAt, fnIx)
  if p.mfFail != "" { return irLMiss("map plan") }
  const cL = mfCallbackLocal()
  // A headed call's list and its store belong to its `RMapFilterHead`.
  if !(r.hfV is OImm) {
    irLOpnd(r.hfV)
    mfRecvTail(p, fnIx)
  }
  if r.hfEnv.length > 0 {
    // A capturing callback: its closure from the captures, as `RMakeClo` writes it.
    const c = nodeAt(r.hfAt)
    const cb = if c is Call && c.callArgs.length == 1 { unwrapParen(c.callArgs[0]) } else { -1 }
    if cb < 0 { return irLMiss("map callback") }
    irLMakeClo({ mcFn: p.mfCbFe, mcEnv: r.hfEnv, mcAt: cb })
  } else if r.hfC is OImm {
    emitClosureValue(p.mfCbFe, fnIx)
  } else {
    irLOpnd(r.hfC)
  }
  return mfLoopTail(p, cL)
}

// `RMapFilterHead`: legacy's plan and callback slot asked as `lowerMapFilter` asks them, then the
// list and its store into the call's source local, ahead of the callback's statements.
function lowerMapFilterHead(r: RMapFilterHead): i32 {
  const fnIx = irLFn().irAt
  const p = mapFilterPlanOf(r.mhAt, fnIx)
  if p.mfFail != "" { return irLMiss("map plan") }
  mfCallbackLocal()
  irLOpnd(r.mhV)
  return mfRecvTail(p, fnIx)
}

// `RListSlice`: legacy's plan, the receiver and its tail, the bounds, then legacy's copy.
function lowerListSlice(r: RListSlice): i32 {
  const fnIx = irLFn().irAt
  const p = arrSlicePlanOf(r.scAt, fnIx)
  if p.slFail != "" { return irLMiss("slice plan") }
  // `arrSliceTail` pops the bounds the plan counts, so the IR's must be that many.
  if r.scArgs.length != p.slArgs.length { return irLMiss("slice arity") }
  irLOpnd(r.scV)
  sliceRecvTail(p, fnIx)
  for a in r.scArgs { irLOpnd(a) }
  return arrSliceTail(p)
}

// `RListEq`: each list and its own recovery, then legacy's list compare.
function lowerListEq(r: RListEq): i32 {
  const e = nodeAt(r.qeAt)
  if !(e is BinExpr) { return irLMiss("list compare node") }
  const fnIx = irLFn().irAt
  irLOpnd(r.qeL)
  listEqOperandTail(e.binLeft, fnIx)
  irLOpnd(r.qeR)
  listEqOperandTail(e.binRight, fnIx)
  // Two lists stored apart compare by value across their storages (`listEqXTail`).
  if eqRouteOf(e, r.qeAt, fnIx) == "xrep" { return listEqXTail(e, fnIx) }
  return listEqTail(e, r.qeAt, fnIx)
}

// The list argument node of `fromCodePoints` call `e`, or -1.
function fcpArgOf(e: Node): i32 {
  return if e is Call && e.callArgs.length == 1 { unwrapParen(e.callArgs[0]) } else { -1 }
}

// `RListCat`: each list and its own recovery, then legacy's concat.
function lowerListCat(r: RListCat): i32 {
  const e = nodeAt(r.ljAt)
  if !(e is BinExpr) { return irLMiss("list concat node") }
  const fnIx = irLFn().irAt
  irLOpnd(r.ljL)
  if r.ljWiden == 1 {
    if catWidenTail(e.binLeft, r.ljAt, fnIx) < 0 { return -1 }
  } else {
    listCatOperandTail(e.binLeft, r.ljAt, fnIx)
  }
  irLOpnd(r.ljR)
  if r.ljWiden == 2 {
    if catWidenTail(e.binRight, r.ljAt, fnIx) < 0 { return -1 }
  } else {
    listCatOperandTail(e.binRight, r.ljAt, fnIx)
  }
  return listCatTail(r.ljAt, fnIx)
}

// An append site's tail, at the mode the builder read; a site the scan does not arm is a miss.
function siteTail(r: RStrOp, fnIx: i32): i32 {
  const mode = strInPlaceMode(r.soAt, fnIx)
  if mode <= 0 { return irLMiss("string append site") }
  return strSiteCatTail(r.soArgs.length, mode, r.soAt)
}

// The live loop hoist holding the header of method call `c`'s string receiver, or -1.
function strCallHoistOf(c: Call): i32 {
  if c.callFn < 0 || c.callFn >= P.nodes.length { return -1 }
  const m = nodeAt(c.callFn)
  return if m is Member { rawStrHoistOf(m.memObj) } else { -1 }
}

// `RStrOp`: its operands, then legacy's operator tail. An equality operand is recovered after
// it is pushed, as legacy recovers a narrowed nullable read.
function lowerStr(r: RStrOp): i32 {
  const e = nodeAt(r.soAt)
  const fnIx = irLFn().irAt
  if r.soOp != "eq" && r.soOp != "charcode" {
    for a in r.soArgs { irLOpnd(a) }
  }
  return match r.soOp {
    "concat" => strCatTail(r.soArgs.length)
    "site" => siteTail(r, fnIx)
    "acc" => if strInPlaceMode(r.soAt, fnIx) < 0 { strAccAppendTail(r.soAt, fnIx) } else { irLMiss("string accumulator") }
    "slice" => strSliceTail()
    "cplen" => strCpLenTail()
    "cpat" => strCpAtTail()
    "charbound" => strIsCharBoundaryTail()
    "bytes" => strBytesTail()
    "indexof" => strIndexOfTail(false)
    "includes" => strIndexOfTail(true)
    "lt" => if e is BinExpr { strOrderTail(e) } else { irLMiss("string operator node") }
    "eq" => {
      if !(e is BinExpr) || r.soArgs.length != 2 {
        return irLMiss("string operator node")
      }
      const lit = strEqLitOf(r.soAt, fnIx)
      irLOpnd(r.soArgs[0])
      if eqOperandRecovers(strEqFirstOf(e, lit), fnIx) { fbRefAsNonNull() }
      if lit >= 0 {
        // The literal is the IR's operand, written where its form takes it, or never.
        const f = strEqLitForm(lit)
        strEqLitHead(lit, f)
        if f == 0 || f == 3 {
          irLOpnd(r.soArgs[1])
        } else {
          irLSkip(r.soArgs[1])
        }
        strEqLitTail(f)
      } else {
        irLOpnd(r.soArgs[1])
        if eqOperandRecovers(e.binRight, fnIx) { fbRefAsNonNull() }
        emitEqNonNullCore(r.soAt, fnIx)
      }
      strEqNegTail(e)
    }
    "fromcp" => fromCpTail()
    "frombytes" => strFromBytesTail()
    "fromcps" => {
      // A list legacy spills is read once, into the spill slot (`callSpillsFcpArg`).
      if callSpillsFcpArg(r.soAt) { return fcpSpillTail() }
      fcpBackingTail()
      // The list's second read: a global's read written again, a local's variable read again.
      if !irLReadAgain(fcpArgOf(e)) { irLOpnd(r.soArgs[0]) }
      fcpLenTail()
    }
    "charcode" => {
      // A receiver a live loop hoist holds is consumed without being written, as `s[i]`'s is.
      const hz = if e is Call { strCallHoistOf(e) } else { -1 }
      if hz >= 0 { irLSkip(r.soArgs[0]) } else { irLOpnd(r.soArgs[0]) }
      irLOpnd(r.soArgs[1])
      rawStrGetTail(hz)
    }
    "len" | "at" => irLMiss("string operator " + r.soOp)
  }
}

// `RListLen`: legacy's `.length` arm, its receiver the operand; a live loop hoist's cached `len`
// answers it without the receiver.
function lowerLen(r: RListLen): i32 {
  const m = nodeAt(r.llAt)
  if !(m is Member) { return irLMiss("list length node") }
  // Outside a pushing arm's region, the length is its grow row's once that is filled.
  const g = listFitGrowLenRowOf(m, irLFn().irAt)
  if g >= 0 { listFitGrowLenOpen(g) }
  const rc = lowerLenOf(r, m)
  if g >= 0 && listFitGrowLenClose(g) < 0 {
    return irLMiss("list fit grow length")
  }
  return rc
}

// The receiver's own `.length`: a live hoist's, or the receiver and legacy's tail.
function lowerLenOf(r: RListLen, m: Member): i32 {
  const hz = arrLenHoistOf(m, irLFn().irAt)
  if hz >= 0 {
    irLSkip(r.llV)
    return emitArrLenHeld(hz)
  }
  irLOpnd(r.llV)
  // An atom's `.length` reads the member string the builder decoded it to (`atomStr`).
  if memberLengthArmOf(m, r.llAt, irLFn().irAt) == "atomStr" {
    fbStrLen()
    return 0
  }
  return arrLenTail(m, irLFn().irAt)
}

// The list-header hoists of the loop statement at `at`, and a range loop's proof, opened as
// legacy's loop opens them.
function loopOpen(at: i32): LoopOpened {
  const none: LoopOpened = { loHoists: 0, loProofs: 0 }
  if at < 0 { return none }
  const s = nodeAt(at)
  // A range loop's hoists then its proof open after its bounds (`emitForRangeStmt`).
  if s is ForRange {
    const h = irLoopHoistOpen(-1, s.frBody, at, -1)
    if h < 0 { return { loHoists: -1, loProofs: 0 } }
    const p = rangeProofOpen(s, at, forRangeStaticStep(s), false)
    return { loHoists: h, loProofs: p }
  }
  // A labelled block opens no loop, so it hoists nothing (`emitLabelBlock`).
  if !(s is WhileStmt) || s.whileBlk != 0 { return none }
  return {
    loHoists: irLoopHoistOpen(s.whileCond, s.whileBody, -1, -1),
    loProofs: 0,
  }
}

// Closes what `loopOpen` opened: its hoists, then its proofs, as legacy closes them.
function loopClose(n: LoopOpened): i32 {
  loopHoistClose(n.loHoists)
  return rangeProofClose(n.loProofs)
}
// A bounds check is fused into the `RListGet` after it, which writes the guard; its operand
// reads consume nothing, so the temps it names stay pending for that read.
function lowerBounds(_n: SBoundsCheck, _pending: i32[]): i32 { return 0 }

export function irLowerRefList(r: Rhs): i32 { return lowerList(r) }

export function irLowerRefBounds(n: SBoundsCheck, pending: i32[]): i32 {
  return lowerBounds(n, pending)
}

export function irLowerRefLoopOpen(at: i32): LoopOpened { return loopOpen(at) }

export function irLowerRefLoopClose(n: LoopOpened): i32 { return loopClose(n) }
