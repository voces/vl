import { mfCallbackLocal } from "./emit_union_casts"

// `ir_lower_ref.vl` — the IR lowering of reference values and list reads (ir-design-2026-11.md
// §5.3, I2's list half). A list read writes its operands, then legacy's own guard and
// `array.get`, through the read arm and the arm decision legacy shares (`scalarListGetTail`,
// `idxArmOf`); a bounds check lowers as nothing, fused into the read after it (rule 8). Scratch
// slots come from the shared lazy list frame, and a loop opens legacy's header hoists.

import { fbRefAsNonNull } from "./emit_bytes"
import { BinExpr, Call, Index, Member, P, WhileStmt, nodeAt } from "./ast"
import { fbDrop } from "./emit_bytes"
import {
  OImm,
  RListEq,
  RListGet,
  RListLen,
  RListPop,
  RListPush,
  RListSlice,
  RMapFilter,
  RStrOp,
  Rhs,
  SBoundsCheck,
  SListSet,
} from "./ir"
import {
  irLAt,
  irLFn,
  irLIndexRow,
  irLMiss,
  irLOpnd,
  irLSkip,
  irLoopHoistOpen,
} from "./ir_lower"
import {
  arrLenHoistOf,
  arrLenTail,
  arrSlicePlanOf,
  arrSliceTail,
  emitArrLenHeld,
  emitClosureValue,
  emitEqNonNullCore,
  fcpBackingTail,
  fcpLenTail,
  fromCpTail,
  idxArmOf,
  idxCellReadIsNull,
  idxStoreHoistOf,
  idxStoreTail,
  listElemStaysNullable,
  listEqOperandTail,
  listEqTail,
  listOpRecvHeld,
  listOpStageBase,
  loopHoistClose,
  mapFilterPlanOf,
  mfLoopTail,
  mfRecvTail,
  popAnyPlanOf,
  popRefTail,
  popScalarTail,
  pushAppendTail,
  pushValueTail,
  rawStrGetTail,
  rawStrHoistOf,
  refListGetTail,
  refListHoistOf,
  scalarListGetTail,
  scalarListHoistOf,
  scalarListUsed,
  sliceRecvTail,
  stageListRecvTail,
  strAccAppendTail,
  strCatTail,
  strCpLenTail,
  strEqFirstOf,
  strEqLitForm,
  strEqLitHead,
  strEqLitOf,
  strEqLitTail,
  strEqNegTail,
  strInPlaceMode,
  strIndexOfTail,
  strListGetTail,
  strListHoistOf,
  strOrderTail,
  strSiteCatTail,
  strSliceTail,
  svDstOfKind,
} from "./wasmEmit"
import { eqOperandRecovers } from "./emit_plan_union"
import { idxStorePlanOf, pushPlanOf } from "./emit_plan_list"
import { scalarListElemKind } from "./emit_value_sites"
import { exprNullableRefArray, refListSlotOfExpr } from "./emit_classify"
import { rvMayView } from "./emit_rep"
import { rlRowsMinted } from "./emit_state"

// Why the IR does not lower list read `idxIx`, or "" when it does: legacy's own arm decision
// (`idxArmOf`) took a scalar list, collected and not a view, or a ref list whose read keeps no
// nullable niche and reads no view.
export function listIdxPlainWhy(idxIx: i32, fnIx: i32): string {
  const nd = nodeAt(idxIx)
  if !(nd is Index) { return "index node" }
  if idxCellReadIsNull(idxIx, fnIx) { return "index cell null" }
  const arm = idxArmOf(nd, fnIx)
  if arm == "ref" { return refReadWhy(nd, fnIx) }
  if arm == "string" || arm == "str" { return "" }
  if arm != "scalar" { return "index " + arm }
  const ek = scalarListElemKind(nd.idxArr, fnIx)
  if ek == null || !scalarListUsed(ek) { return "index uncollected list" }
  if svDstOfKind(ek) >= 0 { return "index view" }
  return ""
}

function refReadWhy(nd: Index, fnIx: i32): string {
  if !rlRowsMinted() || exprNullableRefArray(nd.idxArr, fnIx) {
    return "index ref receiver"
  }
  if listElemStaysNullable(nd.idxArr, fnIx) {
    return "index ref nullable element"
  }
  const rslot = refListSlotOfExpr(nd.idxArr, fnIx)
  if rslot < 0 || rvMayView(rslot) { return "index ref view" }
  return ""
}

// `RListGet`: legacy's read arm, scalar or ref, its receiver and index the read's operands. A
// receiver a live loop hoist holds is consumed without being written.
function lowerList(r: Rhs): i32 {
  if r is RListLen { return lowerLen(r) }
  if r is RStrOp { return lowerStr(r) }
  if r is RListEq { return lowerListEq(r) }
  if r is RListPush { return lowerPush(r, true) }
  if r is RListPop { return lowerPop(r, true) }
  if r is RMapFilter { return lowerMapFilter(r) }
  if r is RListSlice { return lowerListSlice(r) }
  if !(r is RListGet) { return irLMiss("list rhs") }
  const from = irLAt()
  const got = lowerGet(r)
  irLIndexRow(r.lgAt, from)
  return got
}

// `RListGet`'s read, its element-read row banked around it by `lowerList`.
function lowerGet(r: RListGet): i32 {
  const nd = nodeAt(r.lgAt)
  if !(nd is Index) { return irLMiss("list read node") }
  const fnIx = irLFn().irAt
  const arm = idxArmOf(nd, fnIx)
  if arm == "string" {
    const sz = rawStrHoistOf(nd.idxArr)
    if sz >= 0 { irLSkip(r.lgV) } else { irLOpnd(r.lgV) }
    irLOpnd(r.lgIx)
    return rawStrGetTail(sz)
  }
  if arm == "str" {
    const lz = strListHoistOf(nd)
    if lz >= 0 { irLSkip(r.lgV) } else { irLOpnd(r.lgV) }
    irLOpnd(r.lgIx)
    return strListGetTail(nd, lz, true)
  }
  if arm == "ref" {
    const rslot = refListSlotOfExpr(nd.idxArr, fnIx)
    const rz = refListHoistOf(nd, rslot)
    if rz >= 0 { irLSkip(r.lgV) } else { irLOpnd(r.lgV) }
    irLOpnd(r.lgIx)
    return refListGetTail(nd, r.lgAt, fnIx, rslot, rz)
  }
  const ek = scalarListElemKind(nd.idxArr, fnIx)
  if ek == null { return irLMiss("list read element") }
  const hz = scalarListHoistOf(nd, ek, fnIx)
  if hz >= 0 { irLSkip(r.lgV) } else { irLOpnd(r.lgV) }
  irLOpnd(r.lgIx)
  return scalarListGetTail(nd, ek, fnIx, hz)
}

// `RListPush`: the receiver held in its local or staged as legacy stages it, then the value and
// legacy's append; `want` leaves the new length.
function lowerPush(r: RListPush, want: boolean): i32 {
  const fnIx = irLFn().irAt
  const pp = pushPlanOf(r.lpAt, fnIx)
  if pp == null { return irLMiss("push plan") }
  let lIdx = listOpRecvHeld(pp.ppRecv, fnIx, ".push")
  if lIdx == -2 { return irLMiss("push receiver") }
  if lIdx >= 0 {
    irLSkip(r.lpV)
  } else {
    irLOpnd(r.lpV)
    stageListRecvTail(pp.ppRecv, fnIx, pp.ppSlot.base)
    lIdx = pp.ppSlot.base + 3
  }
  irLOpnd(r.lpX)
  pushValueTail(pp, fnIx)
  return pushAppendTail(r.lpAt, pp, lIdx, want)
}

// `SListSet`: the receiver (or its live hoist), index and value, then legacy's park, guard and
// `array.set`; the bounds check before it lowers as nothing.
export function irLowerRefListSet(n: SListSet, at: i32): i32 {
  const a = nodeAt(at)
  if !(a is BinExpr) { return irLMiss("store node") }
  const t = nodeAt(a.binLeft)
  if !(t is Index) { return irLMiss("store target") }
  const st = idxStorePlanOf(t, irLFn().irAt)
  if st == null { return irLMiss("store plan") }
  const hz = idxStoreHoistOf(t, st)
  if hz >= 0 { irLSkip(n.lsV) } else { irLOpnd(n.lsV) }
  irLOpnd(n.lsIx)
  irLOpnd(n.lsSrc)
  idxStoreTail(t, st, hz)
  return 0
}

// `RListPop`: the receiver held or staged as for a push, then legacy's scalar or ref pop tail, at a
// value position when `want`.
function lowerPop(r: RListPop, want: boolean): i32 {
  const fnIx = irLFn().irAt
  const pq = popAnyPlanOf(r.lqAt, fnIx)
  if pq == null { return irLMiss("pop plan") }
  let lIdx = listOpRecvHeld(pq.pqRecv, fnIx, ".pop")
  if lIdx == -2 { return irLMiss("pop receiver") }
  if lIdx >= 0 {
    irLSkip(r.lqV)
  } else {
    irLOpnd(r.lqV)
    const sb = listOpStageBase(pq.pqBase, pq.pqRefSlot)
    stageListRecvTail(pq.pqRecv, fnIx, sb)
    lIdx = sb + 3
  }
  // A statement drops what the tail left, as legacy's statement caller does.
  const got = if pq.pqElemRef { popRefTail(r.lqAt, lIdx, pq.pqWrap, pq.pqBack, -1, pq.pqRefSlot, fnIx) } else { popScalarTail(r.lqAt, pq.pqRecv, lIdx, pq.pqWrap, pq.pqBack, -1, want, fnIx) }
  if got < 0 { return -1 }
  if !want && got == 0 { fbDrop() }
  return 0
}

// A list op in statement position.
export function irLowerRefEffect(r: Rhs): i32 {
  if r is RListPush { return lowerPush(r, false) }
  if r is RListPop { return lowerPop(r, false) }
  if r is RStrOp && r.soOp == "acc" { return lowerStr(r) }
  return irLMiss("effect outside I1")
}

// `RMapFilter`: legacy's plan and callback slot where its arm takes them, the receiver and its
// tail, the callback's closure value (built here for a capture-free function), then the loop.
function lowerMapFilter(r: RMapFilter): i32 {
  const fnIx = irLFn().irAt
  const p = mapFilterPlanOf(r.hfAt, fnIx)
  if p.mfFail != "" { return irLMiss("map plan") }
  const cL = mfCallbackLocal()
  irLOpnd(r.hfV)
  mfRecvTail(p, fnIx)
  if r.hfC is OImm { emitClosureValue(p.mfCbFe, fnIx) } else { irLOpnd(r.hfC) }
  return mfLoopTail(p, cL)
}

// `RListSlice`: legacy's plan, the receiver and its tail, the bounds, then legacy's copy.
function lowerListSlice(r: RListSlice): i32 {
  const fnIx = irLFn().irAt
  const p = arrSlicePlanOf(r.scAt, fnIx)
  if p.slFail != "" { return irLMiss("slice plan") }
  irLOpnd(r.scV)
  sliceRecvTail(p, fnIx)
  for a in r.scArgs { irLOpnd(a) }
  return arrSliceTail(p)
}

// `RListEq`: each list and its own recovery, then legacy's list compare.
function lowerListEq(r: RListEq): i32 {
  const e = nodeAt(r.qeAt)
  if !(e is BinExpr) { return irLMiss("list compare node") }
  const fnIx = irLFn().irAt
  irLOpnd(r.qeL)
  listEqOperandTail(e.binLeft, fnIx)
  irLOpnd(r.qeR)
  listEqOperandTail(e.binRight, fnIx)
  return listEqTail(e, r.qeAt, fnIx)
}

// An append site's tail, at the mode the builder read; a site the scan does not arm is a miss.
function siteTail(r: RStrOp, fnIx: i32): i32 {
  const mode = strInPlaceMode(r.soAt, fnIx)
  if mode <= 0 { return irLMiss("string append site") }
  return strSiteCatTail(r.soArgs.length, mode, r.soAt)
}

// The live loop hoist holding the header of method call `c`'s string receiver, or -1.
function strCallHoistOf(c: Call): i32 {
  if c.callFn < 0 || c.callFn >= P.nodes.length { return -1 }
  const m = nodeAt(c.callFn)
  return if m is Member { rawStrHoistOf(m.memObj) } else { -1 }
}

// `RStrOp`: its operands, then legacy's operator tail. An equality operand is recovered after
// it is pushed, as legacy recovers a narrowed nullable read.
function lowerStr(r: RStrOp): i32 {
  const e = nodeAt(r.soAt)
  const fnIx = irLFn().irAt
  if r.soOp != "eq" && r.soOp != "charcode" {
    for a in r.soArgs { irLOpnd(a) }
  }
  return match r.soOp {
    "concat" => strCatTail(r.soArgs.length)
    "site" => siteTail(r, fnIx)
    "acc" => if strInPlaceMode(r.soAt, fnIx) < 0 { strAccAppendTail(r.soAt, fnIx) } else { irLMiss("string accumulator") }
    "slice" => strSliceTail()
    "cplen" => strCpLenTail()
    "indexof" => strIndexOfTail(false)
    "includes" => strIndexOfTail(true)
    "lt" => if e is BinExpr { strOrderTail(e) } else { irLMiss("string operator node") }
    "eq" => {
      if !(e is BinExpr) || r.soArgs.length != 2 {
        return irLMiss("string operator node")
      }
      const lit = strEqLitOf(r.soAt, fnIx)
      irLOpnd(r.soArgs[0])
      if eqOperandRecovers(strEqFirstOf(e, lit), fnIx) { fbRefAsNonNull() }
      if lit >= 0 {
        // The literal is the IR's operand, written where its form takes it, or never.
        const f = strEqLitForm(lit)
        strEqLitHead(lit, f)
        if f == 0 || f == 3 {
          irLOpnd(r.soArgs[1])
        } else {
          irLSkip(r.soArgs[1])
        }
        strEqLitTail(f)
      } else {
        irLOpnd(r.soArgs[1])
        if eqOperandRecovers(e.binRight, fnIx) { fbRefAsNonNull() }
        emitEqNonNullCore(r.soAt, fnIx)
      }
      strEqNegTail(e)
    }
    "fromcp" => fromCpTail()
    "fromcps" => {
      fcpBackingTail()
      irLOpnd(r.soArgs[0])
      fcpLenTail()
    }
    "charcode" => {
      // A receiver a live loop hoist holds is consumed without being written, as `s[i]`'s is.
      const hz = if e is Call { strCallHoistOf(e) } else { -1 }
      if hz >= 0 { irLSkip(r.soArgs[0]) } else { irLOpnd(r.soArgs[0]) }
      irLOpnd(r.soArgs[1])
      rawStrGetTail(hz)
    }
    "len" | "at" => irLMiss("string operator " + r.soOp)
  }
}

// `RListLen`: legacy's `.length` arm, its receiver the operand; a live loop hoist's cached `len`
// answers it without the receiver.
function lowerLen(r: RListLen): i32 {
  const m = nodeAt(r.llAt)
  if !(m is Member) { return irLMiss("list length node") }
  const hz = arrLenHoistOf(m, irLFn().irAt)
  if hz >= 0 {
    irLSkip(r.llV)
    return emitArrLenHeld(hz)
  }
  irLOpnd(r.llV)
  return arrLenTail(m, irLFn().irAt)
}

// The list-header hoists of the loop statement at `at`, opened as legacy's loop opens them.
function loopOpen(at: i32): i32 {
  if at < 0 { return 0 }
  const s = nodeAt(at)
  if !(s is WhileStmt) { return 0 }
  return irLoopHoistOpen(s.whileCond, s.whileBody, -1, -1)
}
// A bounds check is fused into the `RListGet` after it, which writes the guard; its operand
// reads consume nothing, so the temps it names stay pending for that read.
function lowerBounds(_n: SBoundsCheck, _pending: i32[]): i32 { return 0 }

export function irLowerRefList(r: Rhs): i32 { return lowerList(r) }

export function irLowerRefBounds(n: SBoundsCheck, pending: i32[]): i32 {
  return lowerBounds(n, pending)
}

export function irLowerRefLoopOpen(at: i32): i32 { return loopOpen(at) }

export function irLowerRefLoopClose(n: i32): i32 { return loopHoistClose(n) }
