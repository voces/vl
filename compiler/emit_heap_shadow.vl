// The heap-identity shadow (rep ADT stage 4a): groups each heap table's rows by the rep id of their
// arena types and counts the merges a rep-keyed `heapOf` would make, split by whether the merged
// struct rows store the same layout, a field's element compared by its type's rep id. A different
// layout is named by class: a function field's storage, or a hole or generic instance. Armed with
// the rep shadow (`$VL_REP_SHADOW`); unarmed it is one boolean test, and it moves no emitted byte.

import { i32ToStr } from "./ast"
import { repABNote } from "./emit_nullable_rets"
import { repRowAtTyVar, repShadowOn } from "./emit_rep"
import { tyRepId } from "./emit_ty_seal"
import {
  FC_CLOSURE,
  FC_I32,
  FC_I32_LIST,
  FC_NUL_CLOSURE,
  FC_NUL_LIT_UNION,
  FC_STR,
  mvValTyIx,
  rlElemTyIx,
  sFieldCount,
  sFieldElemName,
  sFieldElemTyIx,
  sFieldStart,
  sFieldTypes,
  sNames,
  sTyIx,
  unTyIx,
} from "./emit_state"

// Struct row `si`'s layout spelling: each field's code and element, in order. An element with a
// recorded type is spelled by its rep id, so two rows naming twin elements spell alike; an atom
// code's literal set is not spelled, since an atom's code is global to its text.
function hsRowLayout(si: i32): string {
  let out = ""
  let fi = 0
  while fi < sFieldCount[si] {
    const r = sFieldStart[si] + fi
    const c = sFieldTypes[r]
    const et = if r < sFieldElemTyIx.length { sFieldElemTyIx[r] } else { -1 }
    const atom = c == FC_I32
      || c == FC_I32_LIST
      || c == FC_NUL_LIT_UNION
      || c == FC_STR
    const rep = if et >= 0 { "#" + i32ToStr(tyRepId(et)) } else { sFieldElemName[r] }
    const el = if atom { "" } else { rep }
    out = out + i32ToStr(c) + ":" + el + ";"
    fi = fi + 1
  }
  return out
}

// Whether struct rows `a` and `b` differ at a field one stores as a closure.
function hsFnFieldDiffers(a: i32, b: i32): boolean {
  if sFieldCount[a] != sFieldCount[b] { return false }
  let fi = 0
  while fi < sFieldCount[a] {
    const ca = sFieldTypes[sFieldStart[a] + fi]
    const cb = sFieldTypes[sFieldStart[b] + fi]
    if ca != cb && (hsClosureCode(ca) || hsClosureCode(cb)) { return true }
    fi = fi + 1
  }
  return false
}

function hsClosureCode(c: i32): boolean {
  return c == FC_CLOSURE || c == FC_NUL_CLOSURE
}

// The class a different-layout merge of struct rows `a` and `b` falls in, else "unnamed".
function hsDiffClass(a: i32, b: i32): string {
  if hsFnFieldDiffers(a, b) { return "function field" }
  if repRowAtTyVar(sTyIx[a]) || repRowAtTyVar(sTyIx[b]) {
    return "hole or generic instance"
  }
  return "unnamed"
}

// Notes, for heap table `table` of `n` rows typed by `tys`, each row a rep id has already met: a
// merge, with the same layout or a different one where `layouts` spells the rows.
function hsGroup(table: string, tys: i32[], n: i32, layouts: string[]) {
  const byId: {[i32]: i32} = Map()
  let i = 0
  while i < n && i < tys.length {
    const t = tys[i]
    if t < 0 {
      repABNote("heap", table, "row with no type")
    } else {
      const id = tyRepId(t)
      const first = byId.get(id) ?? -1
      if first < 0 {
        byId.set(id, i)
      } else if layouts.length == 0 || layouts[first] == layouts[i] {
        repABNote("heap", table, "merge same-layout")
      } else {
        const cls = if table == "struct" { hsDiffClass(first, i) } else { "unnamed" }
        repABNote("heap", table, "merge DIFFERENT-layout: " + cls)
      }
    }
    repABNote("heap", table, "rows")
    i = i + 1
  }
  return 0
}

// Every heap table's rows, once the module is final.
export function heapShadowSweep() {
  if !repShadowOn { return 0 }
  const lay: string[] = []
  let si = 0
  while (
    si < sNames.length
    && si < sFieldStart.length
    && si < sFieldCount.length
  ) {
    lay.push(hsRowLayout(si))
    si = si + 1
  }
  hsGroup("struct", sTyIx, lay.length, lay)
  const none: string[] = []
  hsGroup("reflist", rlElemTyIx, rlElemTyIx.length, none)
  hsGroup("mapval", mvValTyIx, mvValTyIx.length, none)
  hsGroup("union", unTyIx, unTyIx.length, none)
  return 0
}
