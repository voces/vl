// The heap-identity shadow (rep ADT stage 4a): groups each heap table's rows by the rep id of their
// arena types and counts the merges a rep-keyed `heapOf` would make, split by whether the merged
// struct rows store the same layout. Armed with the rep shadow (`$VL_REP_SHADOW`); unarmed it is
// one boolean test, and it writes only its own buckets, so it moves no emitted byte.

import { i32ToStr } from "./ast"
import { repABNote } from "./emit_nullable_rets"
import { repShadowOn } from "./emit_rep"
import { tyRepId } from "./emit_ty_seal"
import {
  mvValTyIx,
  rlElemTyIx,
  sFieldCount,
  sFieldElemName,
  sFieldStart,
  sFieldTypes,
  sNames,
  sTyIx,
  unTyIx,
} from "./emit_state"

// Struct row `si`'s layout spelling: each field's code and element name, in order.
function hsRowLayout(si: i32): string {
  let out = ""
  let fi = 0
  while fi < sFieldCount[si] {
    const r = sFieldStart[si] + fi
    out = out + i32ToStr(sFieldTypes[r]) + ":" + sFieldElemName[r] + ";"
    fi = fi + 1
  }
  return out
}

// Notes, for heap table `table` of `n` rows typed by `tys`, each row a rep id has already met: a
// merge, with the same layout or a different one where `layouts` spells the rows.
function hsGroup(table: string, tys: i32[], n: i32, layouts: string[]) {
  const byId: {[i32]: i32} = Map()
  let i = 0
  while i < n && i < tys.length {
    const t = tys[i]
    if t < 0 {
      repABNote("heap", table, "row with no type")
    } else {
      const id = tyRepId(t)
      const first = byId.get(id) ?? -1
      if first < 0 {
        byId.set(id, i)
      } else if layouts.length == 0 || layouts[first] == layouts[i] {
        repABNote("heap", table, "merge same-layout")
      } else {
        repABNote("heap", table, "merge DIFFERENT-layout")
      }
    }
    repABNote("heap", table, "rows")
    i = i + 1
  }
  return 0
}

// Every heap table's rows, once the module is final.
export function heapShadowSweep() {
  if !repShadowOn { return 0 }
  const lay: string[] = []
  let si = 0
  while (
    si < sNames.length
    && si < sFieldStart.length
    && si < sFieldCount.length
  ) {
    lay.push(hsRowLayout(si))
    si = si + 1
  }
  hsGroup("struct", sTyIx, lay.length, lay)
  const none: string[] = []
  hsGroup("reflist", rlElemTyIx, rlElemTyIx.length, none)
  hsGroup("mapval", mvValTyIx, mvValTyIx.length, none)
  hsGroup("union", unTyIx, unTyIx.length, none)
  return 0
}
