// `check_set_bind.vl` — which function sets reach each un-annotated parameter, per call, at check
// time: a call's instantiation of the parameter's `BK_ARROW` bounds, storage-free
// (`refactor-notes/2026-11-16-store-set-bind-shadow.md`). Built from the check's hand rows
// (`fnParamHandNote`), closed over parameters handed on to another un-annotated callee. A shadow:
// `setBindDiffLine` compares it with the elaboration's per-instance notes; no decision reads it.
import {
  ArrayLit,
  Call,
  ForIn,
  FuncDecl,
  Ident,
  Index,
  LetDecl,
  LoopVar,
  Member,
  P,
  Param,
  Paren,
  fnNameIsLambda,
  i32ToStr,
  nodeAt,
  nodeChildren,
} from "./ast"
import {
  fnParamHandArgsOf,
  fnParamHandFromsOf,
  fnParamHandSets,
  fnTagMembers,
  fnTagSetOfTy,
} from "./check_elab_cap"
import { nodeTyIxOf } from "./check_node_tys"
import { T, TyArray, TyFunc, tyAt, tyElemOf, tyFieldTyOf } from "./check_types"
import { identFnDeclOf } from "./check_scopes"
import {
  mintFactCallOf,
  mintFactRows,
  mintFactSetOf,
  mintRetParamsOf,
} from "./check_mint"
import { fnTagCheckLen } from "./check_fn_tag"
import { handBackHoleIx, handBackIx, handBackShared } from "./check_hand_back"
import { parenPeelIx } from "./check_places"
import { cwIxBuild, cwIxParent } from "./check_write_scan"
import { i32ListHas, strListHas } from "./listutil"
import { declOrigOf, identDeclOf, nodeSrc } from "./symbols"

// One row per (call, callee, parameter position) a set reaches: the call node, the callee
// declaration, the position, the set ids, and the caller's parameter the argument reads (-1 when
// the argument carries its set itself).
let sbCall: i32[] = []
let sbFn: i32[] = []
let sbParam: i32[] = []
let sbSets: i32[][] = []
// Beside `sbSets`: the argument types the row hands, for a callee reading a path into one.
let sbTys: i32[][] = []
let sbFromFn: i32[] = []
let sbFromParam: i32[] = []
// Every declaration, in arena order, as the last build found them.
let sbDecls: i32[] = []
// By `decl|position`: the union of the sets every row for it carries.
let sbSetsOf: {[string]: i32[]} = Map()
// By `decl|position`: the union of the argument types every row for it hands.
let sbTysOf: {[string]: i32[]} = Map()

// One row per declaration handing back its parameter: every value it returns reads it.
let hbFn: i32[] = []
let hbParam: i32[] = []

function sbKey(d: i32, i: i32): string {
  return i32ToStr(d) + "|" + i32ToStr(i)
}

// The sets reaching parameter `i` of declaration `d` across every call, [] for none.
export function setBindSetsOf(d: i32, i: i32): i32[] {
  return sbSetsOf[sbKey(d, i)] ?? []
}

// The call node argument `a` is handed at, -1 when its parent is no call.
function sbCallOf(a: i32): i32 {
  let p = if a >= 0 && a < cwIxParent.length { cwIxParent[a] } else { -1 }
  while p >= 0 && p < P.nodes.length && !(nodeAt(p) is Call) {
    const pn = nodeAt(p)
    if !(pn is Paren) { return -1 }
    p = if p < cwIxParent.length { cwIxParent[p] } else { -1 }
  }
  return p
}

// The position of the parameter of `d` that argument `a` reads, -1 when it reads none. A `$`
// parameter is none: the check minted it for an adapter it built (`fvaAdapt`, a list copy's
// element map), which holds the source's closure, not a set.
function sbParamIndexIn(d: i32, a: i32): i32 {
  if d < 0 || d >= P.nodes.length || a < 0 || a >= P.nodes.length { return -1 }
  const dn = nodeAt(d)
  if !(dn is FuncDecl) || !(nodeAt(a) is Ident) { return -1 }
  const r = identDeclOf(a)
  let i = 0
  while i < dn.fnParams.length {
    if dn.fnParams[i] == r {
      const pn = nodeAt(dn.fnParams[i])
      const minted = pn is Param && pn.parName.length > 0 && pn.parName[0] == 36
      return if minted { -1 } else { i }
    }
    i = i + 1
  }
  return -1
}

// Adds the sets of `from` to `into`; true when it gained one.
function sbUnion(into: i32[], from: i32[]): boolean {
  let grew = false
  for s in from {
    if !i32ListHas(into, s) {
      into.push(s)
      grew = true
    }
  }
  return grew
}

// Adds a row: call `c` hands set `set` (-1 for none) to parameter `i` of `d`, or the value of
// parameter `q` of the enclosing declaration `fr` when `q` is not -1.
function sbRowAdd(c: i32, d: i32, i: i32, set: i32, ty: i32, fr: i32, q: i32) {
  sbCall.push(c)
  sbFn.push(d)
  sbParam.push(i)
  sbSets.push(if set >= 0 { [set] } else { [] })
  sbTys.push(if q < 0 && ty >= 0 { [ty] } else { [] })
  sbFromFn.push(if q >= 0 { fr } else { -1 })
  sbFromParam.push(q)
  return 0
}

// The declaration whose body holds node `x`, -1 at module scope.
function sbEnclosingFn(x: i32): i32 {
  let p = if x >= 0 && x < cwIxParent.length { cwIxParent[x] } else { -1 }
  while p >= 0 && p < P.nodes.length {
    if nodeAt(p) is FuncDecl { return p }
    p = if p < cwIxParent.length { cwIxParent[p] } else { -1 }
  }
  return -1
}

// The list literal a `const` binding read at `x` holds, else -1.
function sbConstListLit(x: i32): i32 {
  const v = parenPeelIx(x)
  if v >= 0 && v < P.nodes.length && nodeAt(v) is ArrayLit { return v }
  if v < 0 || v >= P.nodes.length || !(nodeAt(v) is Ident) { return -1 }
  const ld = identDeclOf(v)
  const ln = if ld >= 0 && ld < P.nodes.length { nodeAt(ld) } else { nodeAt(v) }
  if !(ln is LetDecl) || ln.letKw != "const" || ln.letInit < 0 { return -1 }
  const li = parenPeelIx(ln.letInit)
  return if li >= 0 && nodeAt(li) is ArrayLit { li } else { -1 }
}

// The list literal of declared functions callee `f` reads one element of: `fs[i]`, or the
// element variable of a `for` over the list; -1 for neither.
function sbElemCalleeList(f: i32): i32 {
  const cf = nodeAt(f)
  if cf is Index { return sbConstListLit(cf.idxArr) }
  if !(cf is Ident) { return -1 }
  const vd = identDeclOf(f)
  const vn = if vd >= 0 && vd < P.nodes.length { nodeAt(vd) } else { cf }
  if (
    !(vn is LoopVar)
    || vn.lvSlot != 0
    || vn.lvLoop < 0
    || vn.lvLoop >= P.nodes.length
  ) {
    return -1
  }
  const lp = nodeAt(vn.lvLoop)
  return if lp is ForIn { sbConstListLit(lp.fiIter) } else { -1 }
}

// A call through an element of a list literal of declared functions, `fs[i](…)` or `f(…)` in
// `for f in fs`, hands each argument to that position's parameter of every element.
function sbElemCallRows(c: i32, n: Call) {
  const li = sbElemCalleeList(parenPeelIx(n.callFn))
  if li < 0 { return 0 }
  const lit = nodeAt(li)
  if !(lit is ArrayLit) { return 0 }
  const fr = sbEnclosingFn(c)
  for e in lit.arrElems {
    const ed = if e >= 0 && e < P.nodes.length && nodeAt(e) is Ident { identFnDeclOf(e) } else { -1 }
    const en = if ed >= 0 { nodeAt(ed) } else { nodeAt(c) }
    if en is FuncDecl {
      let j = 0
      while j < n.callArgs.length && j < en.fnParams.length {
        const pn = nodeAt(en.fnParams[j])
        if pn is Param && pn.parType < 0 {
          const a = parenPeelIx(n.callArgs[j])
          const set = fnTagSetOfTy(nodeTyIxOf(a))
          const q = if set < 0 { sbParamIndexIn(fr, a) } else { -1 }
          const ty = nodeTyIxOf(a)
          if set >= 0 || q >= 0 || ty >= 0 {
            sbRowAdd(c, ed, j, set, ty, fr, q)
          }
        }
        j = j + 1
      }
    }
  }
  return 0
}

// Calls through a parameter of their enclosing declaration: the call, that declaration, the
// position, and the sets already handed on to their members.
let tcCall: i32[] = []
let tcFn: i32[] = []
let tcParam: i32[] = []
let tcDone: i32[][] = []

// Notes call `n` at `c` when its callee is a parameter of the declaration it is in.
function sbThroughNote(c: i32, n: Call) {
  const f = parenPeelIx(n.callFn)
  const pd = if f >= 0 && nodeAt(f) is Ident { identDeclOf(f) } else { -1 }
  if pd < 0 || pd >= P.nodes.length || !(nodeAt(pd) is Param) { return 0 }
  const owner = if pd < cwIxParent.length { cwIxParent[pd] } else { -1 }
  const q = sbParamIndexIn(owner, f)
  if q < 0 { return 0 }
  tcCall.push(c)
  tcFn.push(owner)
  tcParam.push(q)
  tcDone.push([])
  return 0
}

// Hands each call through a parameter's arguments to every member of each set now reaching
// that parameter; true when it added a row.
function sbThroughExpand(): boolean {
  let added = false
  let t = 0
  while t < tcCall.length {
    const n = nodeAt(tcCall[t])
    for st in setBindSetsOf(tcFn[t], tcParam[t]) {
      if n is Call && st >= 0 && !i32ListHas(tcDone[t], st) {
        tcDone[t].push(st)
        for m in fnTagMembers(st) {
          if sbArgRows(tcCall[t], n, m, tcFn[t]) { added = true }
        }
      }
    }
    t = t + 1
  }
  return added
}

// Adds a row per un-annotated parameter of declaration `m` that call `n` at `c`, in `fr`,
// hands an argument; true when it added one.
function sbArgRows(c: i32, n: Call, m: i32, fr: i32): boolean {
  const mn = if m >= 0 && m < P.nodes.length { nodeAt(m) } else { n }
  if !(mn is FuncDecl) { return false }
  let added = false
  let j = 0
  while j < n.callArgs.length && j < mn.fnParams.length {
    const pn = nodeAt(mn.fnParams[j])
    if pn is Param && pn.parType < 0 {
      const a = parenPeelIx(n.callArgs[j])
      const ty = nodeTyIxOf(a)
      const set = fnTagSetOfTy(ty)
      const q = if set < 0 { sbParamIndexIn(fr, a) } else { -1 }
      if set >= 0 || q >= 0 || ty >= 0 {
        sbRowAdd(c, m, j, set, ty, fr, q)
        added = true
      }
    }
    j = j + 1
  }
  return added
}

// A call of a local `const` bound to a lambda, `t(x)`, hands each argument to the lambda.
function sbConstLambdaCallRows(c: i32, n: Call) {
  const f = parenPeelIx(n.callFn)
  if f < 0 || !(nodeAt(f) is Ident) { return 0 }
  const ld = identDeclOf(f)
  const ln = if ld >= 0 && ld < P.nodes.length { nodeAt(ld) } else { n }
  if !(ln is LetDecl) || ln.letKw != "const" || ln.letInit < 0 { return 0 }
  const li = parenPeelIx(ln.letInit)
  const lam = if li >= 0 && li < P.nodes.length { nodeAt(li) } else { n }
  if !(lam is FuncDecl) || !fnNameIsLambda(lam.fnName) { return 0 }
  sbArgRows(c, n, li, sbEnclosingFn(c))
  return 0
}

// List methods whose callback takes the receiver's element first.
const SB_ELEM_CBS = [
  "map", "filter", "forEach", "find", "findIndex", "some", "every",
]

// Calls `recv.m(cb)` of such a method with a declared function or lambda callback: the call,
// the callback's declaration, and the sets already handed to it.
let cbCall: i32[] = []
let cbFn: i32[] = []
let cbDone: i32[][] = []

// Notes call `n` at `c` when it is such a method call.
function sbCallbackNote(c: i32, n: Call) {
  const cf = nodeAt(parenPeelIx(n.callFn))
  if (
    !(cf is Member)
    || n.callArgs.length < 1
    || !strListHas(SB_ELEM_CBS, cf.memProp)
  ) {
    return 0
  }
  const a = parenPeelIx(n.callArgs[0])
  const an = if a >= 0 && a < P.nodes.length { nodeAt(a) } else { n }
  const fd = if an is FuncDecl { a } else if an is Ident { identFnDeclOf(a) } else { -1 }
  if fd < 0 || fd >= P.nodes.length { return 0 }
  const fdn = nodeAt(fd)
  if !(fdn is FuncDecl) || fdn.fnParams.length < 1 { return 0 }
  const pn = nodeAt(fdn.fnParams[0])
  if !(pn is Param) || pn.parType >= 0 { return 0 }
  cbCall.push(c)
  cbFn.push(fd)
  cbDone.push([])
  return 0
}

// The types receiver `r` can have in the program: its own, when closed, else each argument type
// a path from a parameter of the enclosing declaration reaches.
function sbRecvTys(r: i32, fr: i32): i32[] {
  const out: i32[] = []
  const steps: string[] = []
  let v = parenPeelIx(r)
  let depth = 0
  while depth < 16 && v >= 0 && v < P.nodes.length {
    depth = depth + 1
    const vn = nodeAt(v)
    if vn is Index {
      steps.push("[]")
      v = parenPeelIx(vn.idxArr)
    } else if vn is Member {
      steps.push(vn.memProp)
      v = parenPeelIx(vn.memObj)
    } else if vn is Ident {
      const q = sbParamIndexIn(fr, v)
      if q < 0 { break }
      for t in sbTysOf[sbKey(fr, q)] ?? [] { out.push(sbTyAtPath(t, steps)) }
      return out
    } else {
      break
    }
  }
  out.push(nodeTyIxOf(parenPeelIx(r)))
  return out
}

// Hands each element set a noted method call's receiver can hold to its callback's first
// parameter; true when it added a row.
function sbCallbackExpand(): boolean {
  let added = false
  let k = 0
  while k < cbCall.length {
    const n = nodeAt(cbCall[k])
    const cf = if n is Call { nodeAt(parenPeelIx(n.callFn)) } else { n }
    if cf is Member {
      for t in sbRecvTys(cf.memObj, sbEnclosingFn(cbCall[k])) {
        const tt = if t >= 0 && t < T.tys.length { tyAt(t) } else { tyAt(0) }
        const et = if tt is TyArray { tyElemOf(tt) } else { -1 }
        const st = fnTagSetOfTy(et)
        if st >= 0 && !i32ListHas(cbDone[k], st) {
          cbDone[k].push(st)
          sbRowAdd(cbCall[k], cbFn[k], 0, st, et, -1, -1)
          added = true
        }
      }
    }
    k = k + 1
  }
  return added
}

// Builds the rows from the tables the last check left.
export function setBindBuild() {
  sbCall = []
  sbFn = []
  sbParam = []
  sbSets = []
  tcCall = []
  tcFn = []
  tcParam = []
  tcDone = []
  cbCall = []
  cbFn = []
  cbDone = []
  sbTys = []
  sbTysOf = Map()
  sbFromFn = []
  sbFromParam = []
  sbDecls = []
  sbSetsOf = Map()
  hbFn = []
  hbParam = []
  cwIxBuild()
  // Direct rows, and each forwarded row with the caller's parameter it reads.
  // The checked tree only: a declaration the elaboration copied is the original's instance.
  const ck = fnTagCheckLen()
  const end = if ck >= 0 && ck < P.nodes.length { ck } else { P.nodes.length }
  let d = 0
  while d < end {
    const dn = nodeAt(d)
    if dn is FuncDecl {
      sbDecls.push(d)
      let i = 0
      while i < dn.fnParams.length {
        const hs = fnParamHandSets(d, i)
        const froms = fnParamHandFromsOf(d, i)
        const args = fnParamHandArgsOf(d, i)
        let k = 0
        while k < hs.length {
          const a = if k < args.length { args[k] } else { -1 }
          const fr = if k < froms.length { froms[k] } else { -1 }
          const q = if hs[k] < 0 { sbParamIndexIn(fr, a) } else { -1 }
          const c = sbCallOf(a)
          const ty = nodeTyIxOf(a)
          if hs[k] >= 0 || q >= 0 || ty >= 0 {
            sbRowAdd(c, d, i, hs[k], ty, fr, q)
          }
          k = k + 1
        }
        i = i + 1
      }
    }
    if dn is Call {
      sbElemCallRows(d, dn)
      sbThroughNote(d, dn)
      sbConstLambdaCallRows(d, dn)
      sbCallbackNote(d, dn)
    }
    d = d + 1
  }
  // Closes the forwarded rows: each takes what reaches the parameter it reads, to a fixpoint.
  let grew = true
  let rounds = 0
  while grew && rounds <= sbCall.length {
    grew = false
    rounds = rounds + 1
    let r = 0
    while r < sbCall.length {
      const fk = if sbFromParam[r] >= 0 { sbKey(sbFromFn[r], sbFromParam[r]) } else { "" }
      if fk != "" && sbUnion(sbSets[r], sbSetsOf[fk] ?? []) { grew = true }
      if fk != "" && sbUnion(sbTys[r], sbTysOf[fk] ?? []) { grew = true }
      const key = sbKey(sbFn[r], sbParam[r])
      const have = sbSetsOf[key] ?? []
      if sbUnion(have, sbSets[r]) { grew = true }
      sbSetsOf[key] = have
      const tys = sbTysOf[key] ?? []
      if sbUnion(tys, sbTys[r]) { grew = true }
      sbTysOf[key] = tys
      r = r + 1
    }
    if sbThroughExpand() { grew = true }
    if sbCallbackExpand() { grew = true }
  }
  setBindHandBacks()
  return 0
}

// Notes each declaration handing back a parameter (`check_hand_back.vl`) that some call binds
// to a function: a set reaches it, or an argument of function type. An inline list-method
// callback is no such declaration.
function setBindHandBacks() {
  for d in sbDecls {
    const dn = nodeAt(d)
    if dn is FuncDecl && dn.fnBody >= 0 {
      const own = handBackIx(dn)
      const one = if own >= 0 { own } else { handBackHoleIx(dn, 0) }
      const ats = if one >= 0 { [one] } else { handBackShared(d, dn) }
      // An inline lambda handed to a list method runs inside the method's loop, no call of it
      // stands anywhere to take the value back.
      const inline = fnNameIsLambda(dn.fnName) && i32ListHas(cbFn, d)
      for at in ats {
        if !inline && sbFnReaches(d, at) {
          hbFn.push(d)
          hbParam.push(at)
        }
      }
    }
  }
  return 0
}

// Whether some call binds parameter `i` of `d` to a function.
function sbFnReaches(d: i32, i: i32): boolean {
  if setBindSetsOf(d, i).length > 0 { return true }
  for t in sbTysOf[sbKey(d, i)] ?? [] {
    if t >= 0 && t < T.tys.length && tyAt(t) is TyFunc { return true }
  }
  return false
}

// Each call through a parameter of `d` in its body, as `[call, set, ...]` over the sets reaching
// that parameter.
function setBindCallsIn(d: i32, out: string[]) {
  const dn = nodeAt(d)
  if !(dn is FuncDecl) || dn.fnBody < 0 { return 0 }
  const xs: i32[] = [dn.fnBody]
  while xs.length > 0 {
    const x = xs.pop()
    if x >= 0 && x < P.nodes.length {
      const n = nodeAt(x)
      if n is Call {
        const q = sbParamIndexIn(d, parenPeelIx(n.callFn))
        if q < 0 { sbPathCallKeys(d, x, n, out) }
        if q >= 0 {
          for s in setBindSetsOf(d, q) {
            if s >= 0 { out.push("P" + sbKey(d, q) + "|" + i32ToStr(s)) }
          }
        }
      }
      for c in nodeChildren(x) { xs.push(c) }
    }
  }
  return 0
}

// One line comparing these rows with the elaboration's notes: calls through a set
// (`mintFactNote`) and hand-backs (`mintRetNote`), each as both / only here / only there.
// "" when neither side has a row.
export function setBindDiffLine(): string {
  setBindBuild()
  const mine: string[] = []
  for d in sbDecls { setBindCallsIn(d, mine) }
  const theirs: string[] = []
  for r in mintFactRows() { theirs.push(sbFactKey(r)) }
  const mineHb: string[] = []
  let h = 0
  while h < hbFn.length {
    mineHb.push(sbKey(hbFn[h], hbParam[h]))
    h = h + 1
  }
  const theirsHb: string[] = []
  for d in sbDecls {
    for i in mintRetParamsOf(d) { theirsHb.push(sbKey(d, i)) }
  }
  if mine.length + theirs.length + mineHb.length + theirsHb.length == 0 {
    return ""
  }
  return "setbind calls "
    + sbCmp(mine, theirs)
    + " handback "
    + sbCmp(mineHb, theirsHb)
    + " rows "
    + i32ToStr(sbCall.length)
}

// `both/onlyMine/onlyTheirs` over two lists of keys, each counted once.
function sbCmp(mine: string[], theirs: string[]): string {
  const inTheirs: {[string]: boolean} = Map()
  for k in theirs { inTheirs[k] = true }
  const seen: {[string]: boolean} = Map()
  let both = 0
  let onlyMine = 0
  for k in mine {
    if !(seen[k] ?? false) {
      seen[k] = true
      if inTheirs[k] ?? false {
        both = both + 1
      } else {
        onlyMine = onlyMine + 1
      }
    }
  }
  let onlyTheirs = 0
  for k in theirs {
    if !(seen[k] ?? false) {
      seen[k] = true
      onlyTheirs = onlyTheirs + 1
    }
  }
  return i32ToStr(both) + "/" + i32ToStr(onlyMine) + "/" + i32ToStr(onlyTheirs)
}

// The checked node minted node `x` copies, through every copy, else `x`.
function sbSrcOf(x: i32): i32 {
  let y = x
  let n = 0
  while n < 64 {
    const s = nodeSrc[y] ?? -1
    if s < 0 || s == y { return y }
    y = s
    n = n + 1
  }
  return y
}

// The declaration minted declaration `d` copies, else `d`.
function sbOrigDecl(d: i32): i32 {
  const s = sbSrcOf(d)
  if s != d { return s }
  const o = declOrigOf(d)
  return if o >= 0 { sbSrcOf(o) } else { d }
}

// Fact row `r` at the grain of these rows: `P<decl>|<position>|<set>` for a call through a
// parameter, else `C<call>|<set>`.
function sbFactKey(r: i32): string {
  const c = sbSrcOf(mintFactCallOf(r))
  const set = i32ToStr(mintFactSetOf(r))
  if c >= 0 && c < P.nodes.length {
    const n = nodeAt(c)
    if n is Call {
      const f = parenPeelIx(n.callFn)
      const pd = if f >= 0 && nodeAt(f) is Ident { identDeclOf(f) } else { -1 }
      if pd >= 0 && pd < P.nodes.length && nodeAt(pd) is Param {
        const owner = if pd < cwIxParent.length { cwIxParent[pd] } else { -1 }
        const q = sbParamIndexIn(owner, f)
        if q >= 0 { return "P" + sbKey(sbOrigDecl(owner), q) + "|" + set }
      }
    }
  }
  return "C" + i32ToStr(c) + "|" + set
}

// The callee of call `n` at `x` in `d`'s body read through a path from a parameter of `d`: a
// local `const` alias, an element `[i]` or a field `.f`, any number deep. Pushes `C<call>|<set>`
// for each set the path reaches in each argument type handed to that parameter.
function sbPathCallKeys(d: i32, x: i32, n: Call, out: string[]) {
  const steps: string[] = []
  let v = parenPeelIx(n.callFn)
  let depth = 0
  while depth < 16 && v >= 0 && v < P.nodes.length {
    depth = depth + 1
    const vn = nodeAt(v)
    if vn is Index {
      steps.push("[]")
      v = parenPeelIx(vn.idxArr)
    } else if vn is Member {
      steps.push(vn.memProp)
      v = parenPeelIx(vn.memObj)
    } else if vn is Ident {
      const q = sbParamIndexIn(d, v)
      if q >= 0 {
        if steps.length == 0 && depth == 1 { return 0 }
        for t in sbTysOf[sbKey(d, q)] ?? [] {
          const s = fnTagSetOfTy(sbTyAtPath(t, steps))
          if s >= 0 { out.push("C" + i32ToStr(x) + "|" + i32ToStr(s)) }
        }
        return 0
      }
      const ld = identDeclOf(v)
      const ln = if ld >= 0 && ld < P.nodes.length { nodeAt(ld) } else { vn }
      if !(ln is LetDecl) || ln.letKw != "const" || ln.letInit < 0 { return 0 }
      v = parenPeelIx(ln.letInit)
    } else {
      return 0
    }
  }
  return 0
}

// Type `t` read through `steps`, outermost last: `[]` an element, else a field; -1 off the type.
function sbTyAtPath(t: i32, steps: string[]): i32 {
  let cur = t
  let k = steps.length - 1
  while k >= 0 && cur >= 0 && cur < T.tys.length {
    const ct = tyAt(cur)
    if steps[k] == "[]" {
      cur = if ct is TyArray { tyElemOf(ct) } else { -1 }
    } else {
      cur = tyFieldTyOf(cur, steps[k])
    }
    k = k - 1
  }
  return cur
}
