// Calls that retire a narrowing: a parameter only ever called by name, and the note a
// diagnostic gains when a read meets the type a call retired it to.
// Does not import the checker.
import {
  BinExpr,
  Call,
  FuncDecl,
  Ident,
  IsExpr,
  NullLit,
  P,
  Param,
  elseIfLink,
  i32ToStr,
  nodeAt,
  nodeSpineChildren,
} from "./ast"
import { callArgPlaces, callDeclFnIx, calleeNameOf } from "./check_callee"
import { crSpans, nodeLineOf } from "./check_capture_loss"
import {
  CR_ASK_EFFECTS,
  CR_ASK_FREE,
  CR_ASK_ONLY_CALLED,
  CR_ASK_SHAPES,
  crAliasWr,
  crAskDecl,
  crAskOn,
  crAskPop,
  crAskPush,
  crAskUse,
  crOpCall,
  crRdIx,
  crRdRet,
  crRetCalls,
  crRetLoops,
  crRetNames,
  crRetNarTys,
  crRetWideTys,
} from "./check_capture_rows"
import { crOpOf, crPocOpen, crSubtreeMentions } from "./check_capture_walks"
import { readsLitConst } from "./check_num_lit_state"
import { isFloatLitExpr, litTreeOps } from "./check_num_lits"
import {
  LIST_EVERY_STEP,
  keyIsListEvery,
  parenPeelIx,
  placeKeyOf,
} from "./check_places"
import { tyToStr } from "./check_types"
import {
  fnBoundNames,
  fnWriteEffects,
  fnWriteFreePaths,
  fnWriteShapes,
  placeRootOf,
  wePartTextOf,
} from "./check_write_effects"

// Whether the nested function `fnIx` tests `name` itself (`name is T`, `name != null`), and so
// reads it at its declared type rather than keeping the narrowing live where it is written.
export function crBodyTests(fnIx: i32, name: string): boolean {
  const fd = nodeAt(fnIx)
  if fd is FuncDecl { return crSubtreeTests(fd.fnBody, name) }
  false
}

function crSubtreeTests(ix: i32, name: string): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if n is IsExpr {
    if isIdentNamed(n.isObj, name) { return true }
  } else if n is BinExpr {
    if n.binOp == "==" || n.binOp == "!=" {
      if isIdentNamed(n.binLeft, name) || isIdentNamed(n.binRight, name) {
        return true
      }
    }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      if crSubtreeTests(kids[k], name) { return true }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  false
}

// Whether the node at `ix` is an `Ident` reading `name`; false for an out-of-range index.
export function isIdentNamed(ix: i32, name: string): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if n is Ident { return n.identName == name }
  false
}

// The answer to a banked write question (`crAskQs`) about the declaration `d`: a verdict
// ("y"/"n", "?" opaque, "@" or "-" a set that does or does not call a parameter), then the
// parts of the set some narrowing test in `uses` (`crAskUses`) could hit.
export function crAskAnswer(
  kind: i32,
  d: i32,
  p: i32,
  uses: {[string]: boolean},
): string[] {
  if kind == CR_ASK_ONLY_CALLED {
    if crParamOnlyCalled(d, p) { return ["y"] }
    return ["n"]
  }
  const s = crAskSet(kind, d, p)
  if s.opaque { return ["?"] }
  const out = ["-"]
  if s.at { out[0] = "@" }
  for id in s.parts {
    const w = crAskPartText(wePartTextOf(id))
    if crAskPartUsed(kind, w, uses) { out.push(w) }
  }
  out
}

// Record that a narrowing of the place keyed `key` tested a call's write shapes: its root, and
// each step under the kind of cell it reads (`a` list, `m` map, "" either), as `shapesHitKey`
// matches them; a subscript step also under "[".
export function crAskUseShape(key: string, steps: string[], tags: string[]) {
  if !crAskOn { return 0 }
  crAskUse("r" + placeRootOf(key))
  let s = 0
  while s < steps.length {
    const st = steps[s]
    let k = ""
    if s < tags.length && tags[s].length > 1 { k = tags[s].slice(1, 2) }
    crAskUse("s" + st + "\t" + k)
    if st.length > 0 && st[0] == '[' { crAskUse("s[\t" + k) }
    s = s + 1
  }
  0
}

// Record a narrowing test of a call's write paths against the place key or sub-path `p`: every
// run of its steps, since a summary's part may be handed on under a prefix (`a.` + part).
export function crAskUsePath(p: string) {
  if !crAskOn { return 0 }
  const cuts: i32[] = [0]
  let i = 1
  while i < p.length {
    if p[i] == '.' || p[i] == '[' { cuts.push(i) }
    i = i + 1
  }
  cuts.push(p.length)
  let a = 0
  while a + 1 < cuts.length {
    let from = cuts[a]
    if from < p.length && p[from] == '.' { from = from + 1 }
    let b = a + 1
    while b < cuts.length {
      crAskUse("p" + p.slice(from, cuts[b]))
      b = b + 1
    }
    a = a + 1
  }
  0
}

// Whether the spelled part `w` of a `kind` summary could hit a test recorded in `uses`.
function crAskPartUsed(
  kind: i32,
  w: string,
  uses: {[string]: boolean},
): boolean {
  if w.length == 0 || w[0] == '@' { return true }
  if kind != CR_ASK_SHAPES { return uses.has("p" + w) }
  if w[0] == '=' { return uses.has("r" + w.slice(1, w.length)) }
  const appends = w[0] == '+'
  let s = w
  if appends || w[0] == '-' { s = s.slice(1, s.length) }
  let k = ""
  let h = s.length - 2
  while h >= 0 && !(s[h] == ']' && s[h + 1] == '#') { h = h - 1 }
  if h >= 0 {
    if h + 3 <= s.length { k = s.slice(h + 2, h + 3) }
    s = s.slice(0, h + 1)
  }
  if appends { return crAskStepUsed(LIST_EVERY_STEP, k, uses) }
  if crAskStepUsed(s, k, uses) { return true }
  if s.length > 0 && s[0] == '[' && crAskStepUsed(LIST_EVERY_STEP, k, uses) {
    return true
  }
  s == "[]" && crAskStepUsed("[", k, uses)
}

// Whether step `st` is recorded under a cell kind that may alias kind `k` ("" aliases any).
function crAskStepUsed(
  st: string,
  k: string,
  uses: {[string]: boolean},
): boolean {
  const pre = "s" + st + "\t"
  if uses.has(pre) { return true }
  if k != "" { return uses.has(pre + k) }
  uses.has(pre + "a") || uses.has(pre + "m")
}

// A part's spelling with each cell tag's element type (`#a<T>`, `#m<V>`) spelled out.
function crAskPartText(s: string): string {
  let out = ""
  let i = 0
  while i < s.length {
    if s[i] == '#' && i + 2 < s.length && (s[i + 1] == 'a' || s[i + 1] == 'm') {
      let j = i + 2
      let v = 0
      while j < s.length && s[j] >= '0' && s[j] <= '9' {
        v = v * 10 + (s[j] - '0')
        j = j + 1
      }
      if j > i + 2 {
        out = out + s.slice(i, i + 2) + "<" + tyToStr(v) + ">"
        i = j
      } else {
        out = out + s.slice(i, i + 1)
        i = i + 1
      }
    } else {
      out = out + s.slice(i, i + 1)
      i = i + 1
    }
  }
  out
}

function crAskSet(kind: i32, d: i32, p: i32) {
  if kind == CR_ASK_EFFECTS { return fnWriteEffects(d, p) }
  if kind == CR_ASK_FREE { return fnWriteFreePaths(d) }
  fnWriteShapes(d)
}

// Whether parameter `pi` of the declaration `d` is only ever called by name in its body — not
// stored, passed, returned, shadowed, or mentioned inside a nested function.
export function crParamOnlyCalled(d: i32, pi: i32): boolean {
  crAskDecl(CR_ASK_ONLY_CALLED, d, pi)
  const fd = nodeAt(d)
  if fd is FuncDecl {
    if pi >= fd.fnParams.length { return false }
    const p = nodeAt(fd.fnParams[pi])
    if p is Param {
      const bound: string[] = []
      fnBoundNames(d, bound)
      let n = 0
      let b = 0
      while b < bound.length {
        if bound[b] == p.parName { n = n + 1 }
        b = b + 1
      }
      if n != 1 { return false }
      if crPocOpen.length > 16 { return false }
      crPocOpen.push(d * 64 + pi)
      crAskPush(d)
      const ok = crParamUsesOnlyCall(fd.fnBody, p.parName)
      crAskPop()
      crPocOpen.pop()
      return ok
    }
  }
  false
}

// Whether every use of the parameter `pname` in the subtree calls it, or hands it straight to a
// declared function whose own parameter there is only ever called — never stores, returns or
// captures it (D2461 review, the `s1` refusal).
function crParamUsesOnlyCall(ix: i32, pname: string): boolean {
  if ix < 0 || ix >= P.nodes.length { return true }
  const n = nodeAt(ix)
  if n is Ident { return n.identName != pname }
  if n is FuncDecl { return !crSubtreeMentions(n.fnBody, pname) }
  if n is Call {
    let calleeOk = false
    if n.callFn >= 0 {
      const cf = nodeAt(n.callFn)
      if cf is Ident { calleeOk = cf.identName == pname }
    }
    if !calleeOk && !crParamUsesOnlyCall(n.callFn, pname) { return false }
    const d = callDeclFnIx(n, ix)
    const places = callArgPlaces(n, ix)
    const off = places.length - n.callArgs.length
    let a = 0
    while a < n.callArgs.length {
      const an = n.callArgs[a]
      if isIdentNamed(an, pname) {
        if d < 0 || !crParamOnlyCalledOpen(d, a + off) { return false }
      } else if !crParamUsesOnlyCall(an, pname) {
        return false
      }
      a = a + 1
    }
    return true
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let k = 0
    while k < kids.length {
      if !crParamUsesOnlyCall(kids[k], pname) { return false }
      k = k + 1
    }
    cur = elseIfLink(cur)
  }
  true
}

function crParamOnlyCalledOpen(d: i32, pi: i32): boolean {
  let i = 0
  while i < crPocOpen.length {
    if crPocOpen[i] == d * 64 + pi { return true }
    i = i + 1
  }
  crParamOnlyCalled(d, pi)
}

// The note a diagnostic at node `at` gains when a statement still being checked read a name at
// the type a call retired it to, and the diagnostic spans that read or names that type; ""
// otherwise.
export function crMisuseNote(msg: string, at: i32): string {
  let i = crRdRet.length - 1
  while i >= 0 {
    const r = crRdRet[i]
    // An element entry (`v[*]`) is named as its list narrowed whole (`v` to `K[]`).
    let nm = crRetNames[r]
    let narText = tyToStr(crRetNarTys[r])
    if keyIsListEvery(nm) && nm.indexOf(".") < 0 {
      const root = placeRootOf(nm)
      narText = narText
        + mapBracketsText(
        (nm.length - root.length) / LIST_EVERY_STEP.length,
      )
      nm = root
    }
    const hit = crSpans(at, crRdIx[i])
      || (crRetWideTys[r] >= 0
      && msg.indexOf(tyToStr(crRetWideTys[r])) >= 0)
    if hit && msg.indexOf("'" + nm + "' is no longer") < 0 {
      let where = ""
      if crRetLoops[r] { where = " in the loop around this read" }
      return " — '"
        + nm
        + "' is no longer narrowed to "
        + narText
        + ": "
        + crCallDesc(crRetCalls[r], true)
        + where
        + " may reassign it; re-test '"
        + nm
        + "' after "
        + crAfterWord(crRetCalls[r])
    }
    i = i - 1
  }
  ""
}

// How a note names what ended a narrowing, after "re-test it after".
function crAfterWord(ix: i32): string {
  if (crAliasWr[ix] ?? false) || crIsPlainAssign(ix) { return "the assignment" }
  "the call"
}

// Whether `ix` is an assignment no declared operator dispatched, so a diagnostic names it as one.
function crIsPlainAssign(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length || (crOpCall[ix] ?? false) { return false }
  const n = nodeAt(ix)
  if n is BinExpr { return n.binOp == "=" }
  false
}

// How a diagnostic names the call at `ix`, a declared operator being a call too; a callee with
// no name (`fs[0]()`) is named by its line alone.
export function crCallDesc(ix: i32, withLine: boolean): string {
  if (crAliasWr[ix] ?? false) || crIsPlainAssign(ix) {
    const an = nodeAt(ix)
    let d = "the assignment"
    if an is BinExpr {
      const ak = placeKeyOf(an.binLeft)
      if ak != "" { d = "the assignment to '" + ak + "'" }
    }
    if withLine { d = d + " on line " + i32ToStr(nodeLineOf(ix)) }
    return d
  }
  let d = "the call"
  const nm = calleeNameOf(ix)
  if nm != "?" { d = "the call to '" + nm + "'" }
  if ix >= 0 && ix < P.nodes.length {
    if !(nodeAt(ix) is Call) {
      const op = crOpOf(ix)
      if op != "" { d = "the operator '" + op + "'" }
    }
  }
  if withLine { d = d + " on line " + i32ToStr(nodeLineOf(ix)) }
  d
}

// Whether the expression at `ix` adapts in a join: a number or `null` literal, an operator tree
// of numbers, a literal `const`, or an assignment, whose arm yields no value to join.
export function leafIsLit(ix: i32, depth: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const x = parenPeelIx(ix)
  if x < 0 || x >= P.nodes.length { return false }
  if litTreeOps(x, depth) >= 0 || isFloatLitExpr(x) || crIsPlainAssign(x) {
    return true
  }
  if readsLitConst(x) { return true }
  nodeAt(x) is NullLit
}

// `[]` once per list level, `depth` of them.
function mapBracketsText(depth: i32): string {
  let text = ""
  let k = 0
  while k < depth {
    text = text + "[]"
    k = k + 1
  }
  text
}
