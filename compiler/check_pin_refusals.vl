// The pin solvers' refusals, queued until the driver reports them after the last check pass.
// Each row names the solver that owes it, so a solver's re-check drops only its own rows and the
// driver raises them grouped by solver, each group in queue order.

// The solvers that queue a refusal: a literal binding's type, a record's adopted width, and an
// uncalled export's parameter (D3817).
export type PinSolver = "lbi" | "recAd" | "expParam"

export let pinRefSolver: PinSolver[] = []
export let pinRefMsg: string[] = []
export let pinRefAt: i32[] = []

// Queues refusal `msg` at node `at`, owed by solver `s`.
export function pinRefuse(s: PinSolver, msg: string, at: i32) {
  pinRefSolver.push(s)
  pinRefMsg.push(msg)
  pinRefAt.push(at)
  0
}

// Whether solver `s` has a refusal queued at node `at`.
export function pinRefusedAt(s: PinSolver, at: i32): boolean {
  let i = 0
  while i < pinRefAt.length {
    if pinRefAt[i] == at && pinRefSolver[i] == s { return true }
    i = i + 1
  }
  false
}

// Drops solver `s`'s rows, keeping the others in their order.
export function pinRefDrop(s: PinSolver) {
  const ss: PinSolver[] = []
  const ms: string[] = []
  const ats: i32[] = []
  let i = 0
  while i < pinRefAt.length {
    if pinRefSolver[i] != s {
      ss.push(pinRefSolver[i])
      ms.push(pinRefMsg[i])
      ats.push(pinRefAt[i])
    }
    i = i + 1
  }
  pinRefSolver = ss
  pinRefMsg = ms
  pinRefAt = ats
  0
}
