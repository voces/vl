// Function-value identity (architecture-target §2.2, option A): the `Fn#d` set a concrete
// function value has, as the elaboration's type of the node holding it. A read of a declaration or
// a lambda is `{d}`, a written `let` the union of its writes, a value `if` or `match` the union of
// its tails, and anything else (a parameter, a field, a call result) is open.

import {
  ArrayLit,
  BinExpr,
  Call,
  FieldInit,
  FuncDecl,
  Ident,
  IfStmt,
  Index,
  LetDecl,
  MatchExpr,
  Member,
  ObjLit,
  P,
  Param,
  Spread,
  i32ToStr,
  nodeAt,
} from "./ast"
import { T, TyArray, TyFunc, TyMap, TyNullable, TyObj } from "./check_types"
import { nodeTyFrozenOf } from "./check_node_tys"
import { cwIxBuild, cwSlotPath } from "./check_write_scan"
import { recEnclosingFn } from "./check_fit_rules"
import { tyHasTyVar } from "./tyquery"
import { identDeclOf, nodeSrc } from "./symbols"
import { wrDstDecl } from "./check_decl_scan"
import { valueTailSplit } from "./check_num_adopt"
import { elabFnSetTy, fnTagged } from "./check_fn_tag_facts"
import { elabFnSetOf, elabFnSetTyMint } from "./check_elab_cap"
import { parenPeelIx } from "./check_places"
import {
  elabHeldValTy,
  elabIdentityTy,
  elabSlotTyAt,
  elabSpecBaseOf,
  elabSpecChildCount,
  elabSpecDeclAt,
  elabSpecDeclsOf,
  elabSpecInst,
  elabSpecMintedCount,
  elabSpecParamsOf,
} from "./emit_elab"
import { idShadowModeOf, idShadowRow } from "./id_shadow_state"

// Each `let` node's written values, built once per compile from `wrDstDecl`.
let idWrites: {[i32]: i32[]} = Map()
let idWritesBuilt = false
let idLetMemo: {[i32]: i32[]} = Map()
const idLetBusy: {[i32]: boolean} = Map()
// Each specialization decision's call and the argument-keyed instance it reached (-1 for none).
let idSpecCalls: i32[] = []
let idSpecKeys: i32[] = []
let idSpecGroups: string[] = []

// The first source node of the copies `x` descends from; `x` itself when it is no copy.
export function idCanon(x: i32): i32 {
  let at = x
  let n = 0
  while n < 64 {
    const s = nodeSrc[at] ?? -1
    if s < 0 || s == at { return at }
    at = s
    n = n + 1
  }
  at
}

export function idWritesBuild() {
  if idWritesBuilt { return 0 }
  idWritesBuilt = true
  for rhs in wrDstDecl.keys() {
    const bd = wrDstDecl[rhs] ?? -1
    if bd < 0 { continue }
    const have = idWrites[bd] ?? []
    have.push(rhs)
    idWrites[bd] = have
  }
  0
}

// The union of ascending sets `a` and `b`.
export function idUnion(a: i32[], b: i32[]): i32[] {
  const out: i32[] = []
  let i = 0
  let j = 0
  while i < a.length || j < b.length {
    if j >= b.length || (i < a.length && a[i] < b[j]) {
      out.push(a[i])
      i = i + 1
    } else if i >= a.length || b[j] < a[i] {
      out.push(b[j])
      j = j + 1
    } else {
      out.push(a[i])
      i = i + 1
      j = j + 1
    }
  }
  out
}

// The functions value node `ix0` may be, ascending: [d] for a read of declaration or lambda
// `d`, the union of every written value for a read of a `let`, and of every tail for a value
// `if` or `match`; [] when some part may be any function (a parameter, a field, a call).
export function idSetOf(ix0: i32, depth: i32): i32[] {
  const none: i32[] = []
  if depth > 32 { return none }
  const ix = parenPeelIx(ix0)
  if ix < 0 || ix >= P.nodes.length { return none }
  const n = nodeAt(ix)
  if n is FuncDecl {
    const one: i32[] = [idCanon(ix)]
    return one
  }
  if n is Ident {
    let d = identDeclOf(ix)
    if d < 0 { d = identDeclOf(idCanon(ix)) }
    if d < 0 || d >= P.nodes.length { return none }
    const dn = nodeAt(d)
    if dn is FuncDecl {
      const one: i32[] = [idCanon(d)]
      return one
    }
    if dn is LetDecl { return idLetSet(d, depth + 1) }
    return none
  }
  if n is IfStmt || n is MatchExpr { return idTailsSet(ix, depth) }
  idAnyFunction(ix)
}

// Every other value node (a call, a field, an index, a parameter's read) may be any function
// of its type, so it carries no set.
function idAnyFunction(_ix: i32): i32[] {
  const none: i32[] = []
  none
}

function idTailsSet(ix: i32, depth: i32): i32[] {
  const none: i32[] = []
  const spine: i32[] = []
  const leaves: i32[] = []
  valueTailSplit(ix, spine, leaves)
  if leaves.length == 0 { return none }
  let acc: i32[] = []
  for l in leaves {
    const s = idSetOf(l, depth + 1)
    if s.length == 0 { return none }
    acc = idUnion(acc, s)
  }
  acc
}

export function idLetSet(bd: i32, depth: i32): i32[] {
  const none: i32[] = []
  const memo = idLetMemo[bd] ?? none
  if memo.length > 0 { return memo }
  if idLetBusy[bd] ?? false { return none }
  idWritesBuild()
  const ws = idWrites[bd] ?? none
  if ws.length == 0 { return none }
  idLetBusy[bd] = true
  let acc: i32[] = []
  for w in ws {
    const s = idSetOf(w, depth + 1)
    if s.length == 0 {
      idLetBusy[bd] = false
      return none
    }
    acc = idUnion(acc, s)
  }
  idLetBusy[bd] = false
  idLetMemo[bd] = acc
  acc
}

// Forgets the write index and every memo, at the start of a compile's elaboration.
export function elabFnIdReset() {
  idWritesBuilt = false
  idWrites = Map()
  idLetMemo = Map()
  idSlotsBuilt = false
  idSlotW = []
  idSlotWKey = []
  idSlotWTy = []
  idSlotWPos = []
  idSlotWTop = []
  idSlotWHolder = []
  idSlotWSteps = []
  idSlotSets = Map()
  idSlotOpen = Map()
  0
}

// Each function-typed write into a slot (a list element, a record field, a map value): the value
// node, its slot's key, the slot's checked type and the write's position kind.
let idSlotsBuilt = false
let idSlotW: i32[] = []
let idSlotWKey: string[] = []
let idSlotWTy: i32[] = []
let idSlotWPos: string[] = []
// Per write: the outermost node above it (a literal or the value itself), its binding (-1 for
// none) and the steps from that node down to the write.
let idSlotWTop: i32[] = []
let idSlotWHolder: i32[] = []
let idSlotWSteps: string[][] = []
// Per slot key, the union of its writes' sets, and whether some write may be any function.
let idSlotSets: {[string]: i32[]} = Map()
let idSlotOpen: {[string]: boolean} = Map()
// Per value node inside a list or record literal: the literal and the step to it.
let idLitUp: {[i32]: i32} = Map()
let idLitStep: {[i32]: string} = Map()
// Per node written by a `let` initializer, `.push`, `.set` or `=`: the place it lands at.
let idTopHolder: {[i32]: i32} = Map()
let idTopPath: {[i32]: string[]} = Map()

function idFnTy(t: i32): boolean {
  let c = t
  while c >= 0 && c < T.tys.length && T.tys[c] is TyNullable {
    const n = T.tys[c]
    c = if n is TyNullable { n.nInner } else { -1 }
  }
  c >= 0 && c < T.tys.length && T.tys[c] is TyFunc
}

// The type one step `st` (a field name, or "[]" for an element or map value) below type `t`.
function idStepTy(t0: i32, st: string): i32 {
  let t = t0
  while t >= 0 && t < T.tys.length && T.tys[t] is TyNullable {
    const n = T.tys[t]
    t = if n is TyNullable { n.nInner } else { -1 }
  }
  if t < 0 || t >= T.tys.length { return -1 }
  const o = T.tys[t]
  if st == "[]" && o is TyArray { return o.aElem }
  if st == "[]" && o is TyMap { return o.mVal }
  if o is TyObj {
    let j = 0
    while j < o.objFieldNames.length && j < o.objFieldTypes.length {
      if o.objFieldNames[j] == st { return o.objFieldTypes[j] }
      j = j + 1
    }
  }
  -1
}

function idSlotAdd(w: i32, ty: i32, pos: string) {
  if !idFnTy(ty) { return 0 }
  idSlotW.push(w)
  idSlotWTy.push(ty)
  idSlotWPos.push(pos)
  idSlotWKey.push("")
  idSlotWTop.push(-1)
  idSlotWHolder.push(-1)
  const none: string[] = []
  idSlotWSteps.push(none)
  0
}

// Notes `v`, written by a binding's initializer or into the place `place` reaches through
// `extra` (a "[]" step, or none), as landing at that place.
function idTopNote(v: i32, place: i32, extra: string) {
  const path: string[] = []
  const r = cwSlotPath(place, path)
  if r < 0 { return 0 }
  const d = identDeclOf(r)
  if d < 0 { return 0 }
  if extra != "" { path.push(extra) }
  idTopHolder[v] = d
  idTopPath[v] = path
  0
}

// The key of the slot write `i` lands in: a named binding's place (`B<decl>/<steps>`) when the
// literals around it are written to one, else the outermost literal's (`L<node>/<steps>`).
function idSlotKeyOfWrite(i: i32): string {
  const w = idSlotW[i]
  const rev: string[] = []
  let u = w
  let guard = 0
  while idLitUp.has(u) && guard < 32 {
    rev.push(idLitStep[u] ?? "")
    u = idLitUp[u] ?? -1
    guard = guard + 1
  }
  let k = ""
  const steps: string[] = []
  const d = idTopHolder[u] ?? -1
  if d >= 0 {
    k = "B" + i32ToStr(idCanon(d))
    for st in idTopPath[u] ?? [] {
      k = k + "/" + st
      steps.push(st)
    }
  } else {
    k = "L" + i32ToStr(u)
  }
  let j = rev.length - 1
  while j >= 0 {
    k = k + "/" + rev[j]
    steps.push(rev[j])
    j = j - 1
  }
  idSlotWTop[i] = u
  idSlotWHolder[i] = d
  idSlotWSteps[i] = steps
  k
}

// Builds every slot write and each slot's set, once per compile.
export function idSlotsBuild() {
  if idSlotsBuilt { return 0 }
  idSlotsBuilt = true
  idLitUp = Map()
  idLitStep = Map()
  idTopHolder = Map()
  idTopPath = Map()
  cwIxBuild()
  const end = P.nodes.length
  let ix = 0
  while ix < end {
    const n = nodeAt(ix)
    if n is ArrayLit {
      const lt = nodeTyFrozenOf(ix)
      const et = idStepTy(lt, "[]")
      for e in n.arrElems {
        if e < 0 || e >= end { continue }
        idLitUp[e] = ix
        idLitStep[e] = "[]"
        idSlotAdd(e, et, "list")
      }
    } else if n is ObjLit {
      const ot = nodeTyFrozenOf(ix)
      for f in n.objFields {
        const fi = if f >= 0 && f < end { nodeAt(f) } else { null }
        if fi is FieldInit && fi.fiValue >= 0 {
          idLitUp[fi.fiValue] = ix
          idLitStep[fi.fiValue] = fi.fiName
          idSlotAdd(fi.fiValue, idStepTy(ot, fi.fiName), "field")
        }
      }
    } else if n is LetDecl && n.letInit >= 0 {
      idTopHolder[n.letInit] = idCanon(ix)
      const none: string[] = []
      idTopPath[n.letInit] = none
    } else if n is Call {
      const f = nodeAt(parenPeelIx(n.callFn))
      if f is Member && (f.memProp == "push" || f.memProp == "set") {
        const at = if f.memProp == "push" { 0 } else { 1 }
        if at < n.callArgs.length {
          const v = n.callArgs[at]
          idTopNote(v, f.memObj, "[]")
          const pos = if f.memProp == "push" { "push" } else { "set" }
          idSlotAdd(v, idStepTy(nodeTyFrozenOf(f.memObj), "[]"), pos)
        }
      }
    } else if n is BinExpr && n.binOp == "=" && n.binCompound == "" {
      const l = nodeAt(parenPeelIx(n.binLeft))
      if !(l is Ident) {
        idTopNote(n.binRight, n.binLeft, "")
        let lt = -1
        if l is Index { lt = idStepTy(nodeTyFrozenOf(l.idxArr), "[]") }
        if l is Member { lt = idStepTy(nodeTyFrozenOf(l.memObj), l.memProp) }
        if lt < 0 { lt = nodeTyFrozenOf(n.binLeft) }
        idSlotAdd(n.binRight, lt, "store")
      }
    }
    ix = ix + 1
  }
  let i = 0
  while i < idSlotW.length {
    const key = idSlotKeyOfWrite(i)
    idSlotWKey[i] = key
    const w = idSlotW[i]
    const none: i32[] = []
    const s = if nodeAt(w) is Spread { none } else { idSetOf(w, 0) }
    if s.length == 0 { idSlotOpen[key] = true }
    idSlotSets[key] = idUnion(idSlotSets[key] ?? [], s)
    i = i + 1
  }
  0
}

export function idSlotWriteCount(): i32 {
  idSlotsBuild()
  idSlotW.length
}

// The value node, slot key, slot type and position kind of slot write `i`.
export function idSlotWriteAt(i: i32): i32 { idSlotW[i] }
export function idSlotWriteKey(i: i32): string { idSlotWKey[i] }
export function idSlotWriteTy(i: i32): i32 { idSlotWTy[i] }
export function idSlotWritePos(i: i32): string { idSlotWPos[i] }

// The closed type the slot of write `i` is held at in its enclosing function's frame: the binding's
// slot fact, or the held type of the outermost literal, walked down the steps; -1 for none.
export function idSlotWriteHeldTy(i: i32): i32 {
  const w = idSlotW[i]
  const f = recEnclosingFn(w)
  const d = idSlotWHolder[i]
  const steps = idSlotWSteps[i]
  let t = -1
  if d >= 0 {
    t = elabSlotTyAt(d, [], f)
  } else {
    const u = idSlotWTop[i]
    if u == w { return -1 }
    t = elabHeldValTy(u, f)
  }
  let j = 0
  while j < steps.length && t >= 0 {
    t = idStepTy(t, steps[j])
    j = j + 1
  }
  t
}

// The functions slot `key` may hold, ascending: the union of its writes' sets; [] where some
// write may be any function (a parameter, a call result, a spread).
export function idSlotSetOf(key: string): i32[] {
  idSlotsBuild()
  if idSlotOpen[key] ?? false { return [] }
  idSlotSets[key] ?? []
}

// The values written to `let` node `bd`, its initialiser included.
export function idWritesOf(bd: i32): i32[] {
  idWritesBuild()
  idWrites[bd] ?? []
}

// Every `let` node some value is written to.
export function idWrittenLets(): i32[] {
  idWritesBuild()
  const out: i32[] = []
  for bd in idWrites.keys() { out.push(bd) }
  out
}

// The type value `x` holds in frame `fnIx` with its identity: `elabIdentityTy`'s, and for a
// concrete function type carrying no set, that signature carrying `x`'s `Fn#d` set (`idSetOf`).
// It prints as the structural type; it is that type unchanged where the set is open.
export function elabIdentityFnTy(x: i32, fnIx: i32): i32 {
  const t = elabIdentityTy(x, fnIx)
  if t < 0 || t >= T.tys.length || !(T.tys[t] is TyFunc) { return t }
  if (elabFnSetTy[t] ?? -1) >= 0 || tyHasTyVar(t) { return t }
  const s = idSetOf(x, 0)
  if s.length == 0 { return t }
  elabFnSetTyMint(t, s)
}

// Forgets the specialization decisions, at the start of a compile's elaboration.
export function elabSpecReset() {
  idSpecCalls = []
  idSpecKeys = []
  idSpecGroups = []
  0
}

// The declaration specialized argument `ax` is in frame `fnIx`, from its identity type: -1 where
// that type carries no singleton. A tagged set is never specialized (D15010), so it is -2.
export function elabSpecArgDecl(ax: i32, fnIx: i32): i32 {
  const t = elabIdentityFnTy(ax, fnIx)
  if t < 0 { return -1 }
  const sid = elabFnSetTy[t] ?? -1
  if sid >= 0 && (fnTagged[sid] ?? false) { return -2 }
  if tyHasTyVar(t) { return -1 }
  const s = elabFnSetOf(t)
  if s.length != 1 { return -1 }
  idCanon(s[0])
}

// Mono's callback specialization at call `call` of declaration `decl` in frame `fnIx`: `names[p]`
// is the function it bakes for argument `args[p]` ("" for none). Keys and checks the elaboration's
// instance at those arguments' identities, and answers the decision's index.
export function elabSpecDemand(
  call: i32,
  fnIx: i32,
  decl: i32,
  args: i32[],
  names: string[],
): i32 {
  const ps: i32[] = []
  const ds: i32[] = []
  let why = ""
  let p = 0
  while p < args.length && p < names.length {
    if names[p] != "" {
      const d = elabSpecArgDecl(args[p], fnIx)
      if d == -2 { why = "tagged" }
      if d == -1 && why == "" { why = "open" }
      if d >= 0 && why == "" && !idDeclNamed(d, names[p]) { why = "other" }
      ps.push(p)
      ds.push(d)
    }
    p = p + 1
  }
  const base = if why == "" { elabSpecBaseOf(call, fnIx, decl) } else { -2 }
  if why == "" && base < -1 { why = "nobase" }
  const k = if why == "" { elabSpecInst(decl, base, fnIx, ps, ds) } else { -1 }
  if why == "" && k < 0 { why = "nokey" }
  idShadowRow("speckey " + (if why == "" { "keyed" } else { why }))
  idSpecCalls.push(call)
  idSpecKeys.push(k)
  idSpecGroups.push("")
  idSpecCalls.length - 1
}

// Names the instance mono gave decision `i` (`elabSpecDemand`'s answer): its registry key or slot.
export function elabSpecMonoGroup(i: i32, g: string) {
  if i >= 0 && i < idSpecGroups.length { idSpecGroups[i] = g }
  0
}

// Whether declaration `d` is the function mono names `name`.
function idDeclNamed(d: i32, name: string): boolean {
  if d < 0 || d >= P.nodes.length { return false }
  const n = nodeAt(d)
  n is FuncDecl && n.fnName == name
}

// One `specgroup` row once mono has run: its distinct instances over the keyed decisions, the
// elaboration's, and the distinct pairs; the grouping agrees exactly when all three are equal.
export function elabSpecGroupRow() {
  if idShadowModeOf() == 0 { return 0 }
  const mono: {[string]: boolean} = Map()
  const elab: {[i32]: boolean} = Map()
  const pairs: {[string]: boolean} = Map()
  let nm = 0
  let ne = 0
  let np = 0
  let i = 0
  while i < idSpecGroups.length && i < idSpecKeys.length {
    const k = idSpecKeys[i]
    if k >= 0 {
      const m = idSpecGroups[i]
      if !(mono[m] ?? false) {
        mono[m] = true
        nm = nm + 1
      }
      if !(elab[k] ?? false) {
        elab[k] = true
        ne = ne + 1
      }
      const pk = m + "#" + i32ToStr(k)
      if !(pairs[pk] ?? false) {
        pairs[pk] = true
        np = np + 1
      }
    }
    i = i + 1
  }
  idShadowRow(
    "specgroup mono="
      + i32ToStr(nm)
      + " elab="
      + i32ToStr(ne)
      + " pairs="
      + i32ToStr(np)
      + " minted="
      + i32ToStr(elabSpecMintedCount())
      + " children="
      + i32ToStr(elabSpecChildCount()),
  )
  0
}

// The parameter position whose argument call `c` calls inside argument-keyed instance `k`: its
// callee is that specialized parameter, or a binding only ever holding it. -1 for any other call.
export function elabSpecParamCalledAt(c: i32, k: i32): i32 {
  const j = idSpecSlotAt(c, k)
  if j < 0 { -1 } else { elabSpecParamsOf(k)[j] }
}

// The key decision `at` (an `elabSpecDemand` answer) reached; -1 where it declined.
export function elabSpecKeyOf(at: i32): i32 {
  if at >= 0 && at < idSpecKeys.length { idSpecKeys[at] } else { -1 }
}

// The slot of instance `k`'s key whose parameter call `c` calls through, or -1.
function idSpecSlotAt(c: i32, k: i32): i32 {
  const d = elabSpecDeclAt(k)
  const cn = if c >= 0 && c < P.nodes.length { nodeAt(c) } else { null }
  if d < 0 || !(cn is Call) { return -1 }
  const cf = parenPeelIx(cn.callFn)
  let pd = if cf >= 0 { identDeclOf(cf) } else { -1 }
  if pd < 0 && cf >= 0 { pd = identDeclOf(idCanon(cf)) }
  if pd >= 0 && pd < P.nodes.length && nodeAt(pd) is LetDecl {
    pd = idParamAliased(pd, 0)
  }
  const dn = nodeAt(d)
  if pd < 0 || !(dn is FuncDecl) || !(nodeAt(pd) is Param) { return -1 }
  const ps = elabSpecParamsOf(k)
  const ds = elabSpecDeclsOf(k)
  let j = 0
  while j < ps.length && j < ds.length {
    const p = ps[j]
    if p < dn.fnParams.length && idCanon(dn.fnParams[p]) == idCanon(pd) {
      return j
    }
    j = j + 1
  }
  -1
}

// The parameter every value written to binding `bd` reads, through bindings that only ever hold
// one another, or -1: a binding only ever holding a parameter is that parameter.
function idParamAliased(bd: i32, depth: i32): i32 {
  if depth > 16 { return -1 }
  let out = -1
  for w in idWritesOf(bd) {
    const x = parenPeelIx(w)
    let pd = if x >= 0 && x < P.nodes.length && nodeAt(x) is Ident { identDeclOf(x) } else { -1 }
    if pd >= 0 && pd < P.nodes.length && nodeAt(pd) is LetDecl {
      pd = idParamAliased(pd, depth + 1)
    }
    if pd < 0 || !(nodeAt(pd) is Param) || (out >= 0 && pd != out) { return -1 }
    out = pd
  }
  out
}
