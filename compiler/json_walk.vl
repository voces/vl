// `json_walk.vl` — the per-target-type derive of a shape walk for `is` / `as` over a
// JSON-shaped union: a generator that writes the walk as VL source, plus the site
// rewrite that routes the test through it. Design: `docs/serde-design.md` §"Deep
// `is` / `as` over a `Json` value".
//
// `r is string[]` over `r: Json` is not an arm test — a `Json[]` of strings is not a
// `string[]` in the heap — so the design rules it a runtime shape walk plus a
// conversion. Generating VL source rather than wasm means the emitter serves every
// target rep and delivery position it already serves (D965). Two functions per target,
// deduped by (target spelling, receiver spelling): `__vlJsonIs_<k>` is the predicate
// `r is T` becomes, `__vlJsonGet_<k>` the builder bound once at the top of the arm so
// the narrowed value is one converted copy. Each test closes `} else { return <fail> }`.

import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  BreakStmt,
  Call,
  CharLit,
  ContinueStmt,
  ErrExpr,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  ImportDecl,
  Index,
  IsExpr,
  LetDecl,
  LoopVar,
  MatchExpr,
  Member,
  Node,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  Program,
  RetStmt,
  Spread,
  StrLit,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  arenaEpochBump,
  arenaSetNode,
  elseIfLink,
  i32ToStr,
  mkBlock,
  mkBool,
  mkCall,
  mkIdent,
  mkIf,
  mkIndex,
  mkLet,
  mkMember,
  mkNum,
  mkStr,
  nodeAt,
  nodeToks,
  nodeValueSpineChildren,
  valueIfAdd,
} from "./ast"
import { tErr } from "./check_relate_core"
import { i32ListHas, strListAppend } from "./listutil"
import { parseProgram } from "./parser"
import { vcDgPush, vcLoadToks, vcParseBlocked } from "./tok_load"
import {
  jwSiteNode,
  jwSiteTgt,
  jwTgtRecv,
  jwTgtRootTy,
  jwTgtSpell,
  jwTgtTy,
} from "./check_side_rows"
import { jsonSelfRef, jsonUnionMembers } from "./check_json_shape"
import {
  PrimName,
  TyArray,
  TyErr,
  TyFunc,
  TyLit,
  TyMap,
  TyNeg,
  TyNullable,
  TyObj,
  TyPrim,
  TyUnion,
  TyVar,
  tyAt,
  tyElemOf,
  tyToStr,
  tyValOf,
} from "./check_types"
import { isNullTy } from "./tyquery"

// ── generator state ──────────────────────────────────────────────────────────

// Module-level rather than threaded: the recursion carries the two arguments that
// vary (the type and the source name), and the four that do not — build mode, the
// failure expression, the receiver union and its two container arm spellings — are
// constant for a whole function body.
let jwCtr = 0
let jwBuild = false
let jwFail = "false"
let jwRecvTy = -1
let jwArrSpell = ""
let jwMapSpell = ""
// The types the walk is inside, the target being generated, and the recursive types other than
// the target it calls, each walked by a function pair of its own.
let jwOpen: i32[] = []
let jwTgtK = 0
let jwRecTys: i32[] = []

function jwFresh(p: string): string {
  jwCtr = jwCtr + 1
  p + i32ToStr(jwCtr)
}

// The receiver union's array (`want` 0) or map (`want` 1) arm, spelled. Read off the
// arena rather than spelled by hand: nothing privileges the name `Json`, and a merged
// module's alias is `Json$mN`.
function jwRecvArmSpell(recvTy: i32, want: i32): string {
  if recvTy < 0 { return "" }
  const ms = jsonUnionMembers(recvTy)
  let i = 0
  while i < ms.length {
    const m = tyAt(ms[i])
    if m is TyArray {
      if want == 0 {
        if jsonSelfRef(tyElemOf(m), recvTy) { return tyToStr(ms[i]) }
      }
    } else if m is TyMap {
      if want == 1 {
        if jsonSelfRef(tyValOf(m), recvTy) { return tyToStr(ms[i]) }
      }
    }
    i = i + 1
  }
  ""
}

// A default value of `ty`, spelled as VL source. Two consumers: the builder's failure
// `return`, and the pre-declared accumulator every container case needs so the value
// survives the `if` that guards it. Every JSON shape has one, which is why the builder
// never needs a nullable carrier.
function jwDefault(ty: i32): string {
  if ty < 0 { return "null" }
  if jsonSelfRef(ty, jwRecvTy) { return "null" }
  const t = tyAt(ty)
  match t {
    TyPrim => {
      const p = t.primName
      if p == "string" { return "\"\"" }
      if p == "boolean" { return "false" }
      if p == "f64" { return "0.0" }
      if p == "i32" { return "0" }
      if p == "i64" { return "0" }
      "null"
    }
    TyArray => "[]"
    TyMap => "Map()"
    TyObj => {
      const fn = t.objFieldNames
      const ft = t.objFieldTypes
      let s = "{"
      let i = 0
      while i < fn.length {
        if i > 0 { s = s + ", " }
        s = s + fn[i] + ": " + jwDefault(ft[i])
        i = i + 1
      }
      s + "}"
    }
    // A nullable defaults to null; the checker refuses every other shape before here.
    TyNullable | TyFunc | TyUnion | TyNeg | TyVar | TyLit | TyErr => "null"
  }
}

// The nullable inner of `ty` when `ty` is `X | null`, else -1. The checker's shape
// predicate refuses every wider union, so this is the only union shape the generator
// can meet.
function jwNullableInner(ty: i32): i32 {
  if ty < 0 { return -1 }
  const t = tyAt(ty)
  match t {
    TyNullable => t.nInner
    TyUnion => {
      const ms = t.uMembers
      if ms.length == 2 {
        if isNullTy(ms[0]) { return ms[1] }
        if isNullTy(ms[1]) { return ms[0] }
      }
      -1
    }
    // Not `X | null`.
    TyPrim | TyFunc | TyObj | TyArray | TyMap | TyNeg | TyVar | TyLit | TyErr => -1
  }
}

// The container guard: `if <src> is <spell> { <inner> } else { return <fail> }`. An
// empty inner would print an empty block, so it collapses to the negated leaf form
// instead — same meaning, and a shape the checker and the formatter both accept.
function jwGuard(out: string[], src: string, spell: string, inner: string[]) {
  if inner.length == 0 {
    out.push("if !(" + src + " is " + spell + ") { return " + jwFail + " }")
    return 0
  }
  out.push("if " + src + " is " + spell + " {")
  strListAppend(out, inner)
  out.push("} else { return " + jwFail + " }")
  0
}

// The walk: appends to `out` the statements testing `src` (a name bound to a `Json`
// value) against `ty` and, in build mode, binding the converted value; returns the
// name holding it, or "" in check mode. `src` is always a name and never an
// expression, because re-binding a narrowed value to a fresh `const` loses its rep.
function jwWalk(ty: i32, src: string, out: string[]): string {
  // The JSON union itself is the wildcard leaf: it matches anything and is taken by
  // reference — no walk, no copy (`docs/serde-design.md`, the "Deep" clause).
  if jsonSelfRef(ty, jwRecvTy) { return jwWildcard(src) }
  // A type the walk is already inside is walked by its own function, called (D1198).
  if i32ListHas(jwOpen, ty) { return jwWalkRec(ty, src, out) }
  jwOpen.push(ty)
  const r = jwWalkIn(ty, src, out)
  jwOpen.pop()
  r
}

// A call of the function pair walking recursive type `ty`: the target's own, else one generated
// for `ty`. The builder is called only once its predicate held, so the call cannot fail.
function jwWalkRec(ty: i32, src: string, out: string[]): string {
  const root = ty == jwTgtTy[jwTgtK]
  if !root && !i32ListHas(jwRecTys, ty) { jwRecTys.push(ty) }
  const pn = if root { jwPredName(jwTgtK) } else { jwRecPredName(jwTgtK, ty) }
  if !jwBuild {
    out.push("if !" + pn + "(" + src + ") { return " + jwFail + " }")
    return ""
  }
  const gn = if root { jwWalkerName(jwTgtK) } else { jwRecGetName(jwTgtK, ty) }
  const g = jwFresh("__vjr")
  out.push("if !" + pn + "(" + src + ") { return " + jwFail + " }")
  out.push("const " + g + " = " + gn + "(" + src + ")")
  g
}

// `jwWalk` at a type it is not yet inside.
function jwWalkIn(ty: i32, src: string, out: string[]): string {
  const nin = jwNullableInner(ty)
  if nin >= 0 {
    // S3: an absent key and an explicit JSON `null` are the same fact here — a map
    // read answers `null` for both — and both match `T | null`.
    const inner: string[] = []
    const iv = jwWalk(nin, src, inner)
    if jwBuild {
      const g = jwFresh("__vjn")
      out.push("let " + g + ": " + tyToStr(ty) + " = null")
      out.push("if " + src + " != null {")
      strListAppend(out, inner)
      out.push(g + " = " + iv)
      out.push("}")
      return g
    }
    if inner.length == 0 { return "" }
    out.push("if " + src + " != null {")
    strListAppend(out, inner)
    out.push("}")
    return ""
  }
  const t = tyAt(ty)
  match t {
    TyPrim => jwWalkPrim(t.primName, ty, src, out)
    TyArray => jwWalkArray(ty, tyElemOf(t), src, out)
    TyMap => jwWalkMap(ty, tyValOf(t), src, out)
    TyObj => jwWalkObj(ty, t.objFieldNames, t.objFieldTypes, src, out)
    // Unreachable: `jsonShapeBad` refuses every other arena shape at the `is` site, so
    // the generator is never asked for one. A `return <fail>` rather than silence, so a
    // shape that slips past the checker fails loudly.
    TyNullable | TyFunc | TyUnion | TyNeg | TyVar | TyLit | TyErr => {
      out.push("return " + jwFail)
      ""
    }
  }
}

function jwWildcard(src: string): string {
  if jwBuild { return src }
  ""
}

function jwWalkPrim(p: PrimName, ty: i32, src: string, out: string[]): string {
  if p == "i32" || p == "i64" {
    // S2: an integer target takes an integral, in-range JSON number and nothing else —
    // the same predicate the exact `as?` conversion applies (DECISIONS.md §"Numeric
    // `as` to an INTEGER target is exact-or-fail under the trio"), so the two cannot
    // drift apart.
    const c = jwFresh("__vjc")
    const inner: string[] = []
    inner.push("const " + c + " = " + src + " as? " + p)
    if jwBuild {
      const g = jwFresh("__vji")
      out.push("let " + g + ": " + p + " = 0")
      inner.push(
        "if "
          + c
          + " != null { "
          + g
          + " = "
          + c
          + " } else { return "
          + jwFail
          + " }",
      )
      jwGuard(out, src, "f64", inner)
      return g
    }
    inner.push("if " + c + " == null { return " + jwFail + " }")
    jwGuard(out, src, "f64", inner)
    return ""
  }
  if p == "null" {
    out.push("if " + src + " != null { return " + jwFail + " }")
    if jwBuild { return "null" }
    return ""
  }
  if !jwBuild {
    out.push("if !(" + src + " is " + p + ") { return " + jwFail + " }")
    return ""
  }
  const g = jwFresh("__vjp")
  out.push("let " + g + ": " + p + " = " + jwDefault(ty))
  out.push(
    "if "
      + src
      + " is "
      + p
      + " { "
      + g
      + " = "
      + src
      + " } else { return "
      + jwFail
      + " }",
  )
  g
}

function jwWalkArray(ty: i32, elem: i32, src: string, out: string[]): string {
  const inner: string[] = []
  const iv = jwFresh("__vje")
  const ix = jwFresh("__vjx")
  inner.push("let " + ix + " = 0")
  inner.push("while " + ix + " < " + src + ".length {")
  inner.push("const " + iv + " = " + src + "[" + ix + "]")
  const ev = jwWalk(elem, iv, inner)
  let g = ""
  if jwBuild {
    g = jwFresh("__vja")
    inner.push(g + ".push(" + ev + ")")
  }
  inner.push(ix + " = " + ix + " + 1")
  inner.push("}")
  if jwBuild { out.push("const " + g + ": " + tyToStr(ty) + " = []") }
  jwGuard(out, src, jwArrSpell, inner)
  g
}

function jwWalkMap(ty: i32, val: i32, src: string, out: string[]): string {
  const inner: string[] = []
  const kv = jwFresh("__vjk")
  const iv = jwFresh("__vjv")
  inner.push("for " + kv + " in " + src + " {")
  inner.push("const " + iv + " = " + src + "[" + kv + "]")
  const ev = jwWalk(val, iv, inner)
  let g = ""
  if jwBuild {
    g = jwFresh("__vjm")
    inner.push(g + "[" + kv + "] = " + ev)
  }
  inner.push("}")
  if jwBuild { out.push("const " + g + ": " + tyToStr(ty) + " = Map()") }
  jwGuard(out, src, jwMapSpell, inner)
  g
}

function jwWalkObj(
  ty: i32,
  fn: string[],
  ft: i32[],
  src: string,
  out: string[],
): string {
  const inner: string[] = []
  const vals: string[] = []
  let i = 0
  while i < fn.length {
    const rv = jwFresh("__vjf")
    inner.push("const " + rv + " = " + src + "[\"" + fn[i] + "\"]")
    vals.push(jwWalk(ft[i], rv, inner))
    i = i + 1
  }
  let g = ""
  if jwBuild {
    g = jwFresh("__vjo")
    let lit = "{"
    let j = 0
    while j < fn.length {
      if j > 0 { lit = lit + ", " }
      lit = lit + fn[j] + ": " + vals[j]
      j = j + 1
    }
    lit = lit + "}"
    out.push("let " + g + ": " + tyToStr(ty) + " = " + jwDefault(ty))
    inner.push(g + " = " + lit)
  }
  jwGuard(out, src, jwMapSpell, inner)
  g
}

// ── the generated source ─────────────────────────────────────────────────────

// A predicate and a builder rather than one function returning `T | null`: the arm
// would then bind a nullable narrowed to non-null, whose delivery is a standing
// clause-1 defect (D1197).
function jwWalkerName(k: i32): string { "__vlJsonGet_" + i32ToStr(k) }
function jwPredName(k: i32): string { "__vlJsonIs_" + i32ToStr(k) }
function jwRecGetName(k: i32, ty: i32): string {
  jwWalkerName(k) + "_" + i32ToStr(ty)
}
function jwRecPredName(k: i32, ty: i32): string {
  jwPredName(k) + "_" + i32ToStr(ty)
}

// The predicate `pn` and builder `gn` walking type `ty`, spelled `spell`, from receiver spelling
// `recv`.
function jwPairSource(
  ty: i32,
  recv: string,
  spell: string,
  pn: string,
  gn: string,
): string {
  jwBuild = false
  jwFail = "false"
  const chk: string[] = []
  jwWalk(ty, "v", chk)
  const head = "function " + pn + "(v: " + recv + "): boolean {\n"
  const pred = head + jwJoin(chk) + "true\n}\n"
  jwBuild = true
  jwFail = jwDefault(ty)
  const bld: string[] = []
  const val = jwWalk(ty, "v", bld)
  pred
    + "function "
    + gn
    + "(v: "
    + recv
    + "): "
    + spell
    + " {\n"
    + jwJoin(bld)
    + val
    + "\n}\n"
}

function jwJoin(lines: string[]): string {
  let s = ""
  let i = 0
  while i < lines.length {
    s = s + lines[i] + "\n"
    i = i + 1
  }
  s
}

// The whole fragment: one predicate + one builder per recorded target.
function jwGenerateSource(): string {
  let src = ""
  jwTgtK = 0
  jwOpen = []
  jwRecTys = []
  let k = 0
  while k < jwTgtSpell.length {
    // The root type, not the parameter: the walk's tests and its wildcard leaf are
    // about the JSON tree, while the parameter is only what the site can hand it.
    jwRecvTy = jwTgtRootTy[k]
    jwArrSpell = jwRecvArmSpell(jwRecvTy, 0)
    jwMapSpell = jwRecvArmSpell(jwRecvTy, 1)
    const tgt = jwTgtTy[k]
    const recv = jwTgtRecv[k]
    const spell = jwTgtSpell[k]
    jwTgtK = k
    jwRecTys = []
    src = src + jwPairSource(tgt, recv, spell, jwPredName(k), jwWalkerName(k))
    let r = 0
    while r < jwRecTys.length {
      const rt = jwRecTys[r]
      src = src
        + jwPairSource(
        rt,
        recv,
        tyToStr(rt),
        jwRecPredName(k, rt),
        jwRecGetName(k, rt),
      )
      r = r + 1
    }
    k = k + 1
  }
  // Every `$` in the text came from a merge-mangled type name, and the lexer cannot take
  // one; it travels as `__jwmangle__` and `jwRestoreMangling` undoes it on the tokens.
  jwReplaceAll(src, "$", JW_DOLLAR)
}

// ── the merge-mangling escape ────────────────────────────────────────────────

// A module build renames `Json` → `Json$m1`, and `tyToStr` renders that name, which
// is what makes the fragment resolve in the merged scope. `$` is not an identifier
// character, so the generator writes a lexable stand-in and the driver restores the
// `$` on the token stream, which `TypeRef.tyName` and the spelling tree both read.
const JW_DOLLAR = "__jwmangle__"

function jwReplaceAll(s: string, from: string, to: string): string {
  let out = ""
  let i = 0
  while i < s.length {
    let hit = false
    if i + from.length <= s.length {
      if s.slice(i, i + from.length) == from { hit = true }
    }
    if hit {
      out = out + to
      i = i + from.length
    } else {
      out = out + s.slice(i, i + 1)
      i = i + 1
    }
  }
  out
}

// Put the `$` back into every token of the generated fragment. `from` is the index the
// fragment's tokens start at, so nothing the user wrote is touched.
function jwRestoreMangling(from: i32): i32 {
  let i = from
  while i < P.toks.length {
    const tk = P.toks[i]
    if tk.text.length >= JW_DOLLAR.length {
      tk.text = jwReplaceAll(tk.text, JW_DOLLAR, "$")
    }
    i = i + 1
  }
  0
}

// ── the site rewrite ─────────────────────────────────────────────────────────

// `r is T` becomes `__vlJsonIs_k(r)` in place — the node index is overwritten, so
// every parent slot pointing at the `IsExpr` keeps pointing at the call. Where the
// receiver is a narrowable place and the test governs a branch, the arm also gets
// `const __vljvN = __vlJsonGet_k(r)` prepended and every read of the place rewritten.

// The place a node spells (`r`, `o.p`, `xs[0]`, `m[k]`), or "" for anything that is
// not a stable place. The same grammar the checker's `placeKeyOf` spells, cut to what
// this rewrite has to match.
function jwPlaceKey(ix: i32): string {
  if ix < 0 { return "" }
  const n = nodeAt(ix)
  match n {
    Ident => n.identName
    Paren => jwPlaceKey(n.parInner)
    Member => {
      const b = jwPlaceKey(n.memObj)
      if b == "" { return "" }
      b + "." + n.memProp
    }
    Index => {
      const b = jwPlaceKey(n.idxArr)
      if b == "" { return "" }
      const k = jwIndexKey(n.idxIndex)
      if k == "" { return "" }
      b + "[" + k + "]"
    }
    // Not a stable place.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => ""
  }
}

function jwIndexKey(ix: i32): string {
  if ix < 0 { return "" }
  const n = nodeAt(ix)
  match n {
    NumLit => n.numText
    StrLit => "\"" + n.strText + "\""
    Ident => n.identName
    // Not a literal or name index.
    CharLit | BoolLit | NullLit | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => ""
  }
}

// The root identifier of a place key — what a shadowing declaration would have to be
// named.
function jwKeyRoot(key: string): string {
  let i = 0
  while i < key.length {
    const c = key[i]
    if c == '.' { return key.slice(0, i) }
    if c == '[' { return key.slice(0, i) }
    i = i + 1
  }
  key
}

function jwSetTok(ix: i32, tok: i32): i32 {
  if ix >= 0 {
    if ix < nodeToks.length { nodeToks[ix] = tok }
  }
  ix
}

// A fresh copy of a place expression — the builder call needs its own subtree,
// because the original is now the predicate call's argument.
function jwCopyPlace(ix: i32, tok: i32): i32 {
  if ix < 0 { return -1 }
  const n = nodeAt(ix)
  match n {
    Ident => jwSetTok(mkIdent(n.identName, n.pos), tok)
    Paren => jwCopyPlace(n.parInner, tok)
    Member => {
      const b = jwCopyPlace(n.memObj, tok)
      if b < 0 { return -1 }
      jwSetTok(mkMember(b, n.memProp, n.pos), tok)
    }
    Index => {
      const a = jwCopyPlace(n.idxArr, tok)
      if a < 0 { return -1 }
      const i = jwCopyIndex(n.idxIndex, tok)
      if i < 0 { return -1 }
      jwSetTok(mkIndex(a, i, n.pos), tok)
    }
    // Not a place `jwPlaceKey` spells.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => -1
  }
}

function jwCopyIndex(ix: i32, tok: i32): i32 {
  if ix < 0 { return -1 }
  const n = nodeAt(ix)
  match n {
    NumLit => jwSetTok(mkNum(n.numText, n.pos), tok)
    StrLit => jwSetTok(mkStr(n.strText, n.pos), tok)
    Ident => jwSetTok(mkIdent(n.identName, n.pos), tok)
    // Not an index `jwIndexKey` spells.
    CharLit | BoolLit | NullLit | Unary | BinExpr | Call | Member | OptMember | Paren | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => -1
  }
}

// Replace every occurrence of the place `key` under `ix` with `name`, in place. A
// matched node is overwritten and not descended into — `o.p.q` matches at `o.p` and
// becomes `<name>.q`. A child `nodeValueChildren` does not name loses a substitution,
// which the second check pass reports as a type error rather than dropping silently.
function jwSubst(ix: i32, key: string, name: string) {
  if ix < 0 { return 0 }
  // A closure that writes the place reads it unnarrowed, as the checker types it there.
  if jwIsWriter(ix, key, jwKeyRoot(key)) { return 0 }
  if jwPlaceKey(ix) == key {
    const nd: Node = { identName: name, pos: -1 }
    arenaSetNode(ix, nd)
    return 0
  }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    const ks = nodeValueSpineChildren(cur)
    let i = 0
    while i < ks.length {
      jwSubst(ks[i], key, name)
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

// What substituting a block or statement found. `JW_FAILED`: it is not a block.
// `JW_RAN`: it ran to its end with the place still narrowed. `JW_ENDED`: the narrowing ended in it.
// `JW_SHADOWED`: a binding of the root's name hides the place to the end of the enclosing block.
const JW_FAILED = 0
const JW_RAN = 1
const JW_ENDED = 2
const JW_SHADOWED = 3

// A token past every real one: a cut that substitutes every read.
const JW_NO_CUT = 2147483647

// Substitutes the place in block `blk`'s statements up to the first that rebinds or writes it, or
// calls what may, where the narrowing ends: a `place = e` or `let root = e` still reads `e` under
// it, an `if` substitutes its test and each arm the same way, a block nested anywhere is scoped,
// and a loop that writes it reads it unnarrowed. The reads after keep the declared type.
function jwSubstScoped(blk: i32, key: string, root: string, name: string): i32 {
  const b = if blk >= 0 { nodeAt(blk) } else { null }
  if !(b is Block) { return JW_FAILED }
  for st in b.blkStmts {
    if !jwArmDisturbs(st, key, root) {
      jwSubst(st, key, name)
    } else {
      const r = jwSubstAtWrite(st, key, root, name)
      if r != JW_RAN { return r }
    }
  }
  JW_RAN
}

// `jwSubstScoped` for statement `st`, which rebinds or writes the place or holds a block that does.
function jwSubstAtWrite(st: i32, key: string, root: string, name: string): i32 {
  const sn = nodeAt(st)
  if sn is BinExpr && sn.binOp == "=" {
    const lk = jwPlaceKey(sn.binLeft)
    if lk == key || lk == root {
      jwSubstUntilCut(sn.binRight, key, root, name)
      return JW_ENDED
    }
  } else if sn is LetDecl && sn.letName == root {
    jwSubstUntilCut(sn.letInit, key, root, name)
    return JW_SHADOWED
  } else if sn is IfStmt {
    // A test that ends the narrowing leaves both arms to the place.
    if jwCutTok(sn.ifCond, key, root) >= 0 {
      jwSubstUntilCut(sn.ifCond, key, root, name)
      return JW_ENDED
    }
    jwSubstBefore(sn.ifCond, key, name, JW_NO_CUT)
    const t = jwSubstScoped(sn.ifThen, key, root, name)
    let e = JW_RAN
    if sn.ifElse >= 0 {
      if nodeAt(sn.ifElse) is IfStmt {
        e = jwSubstAtWrite(sn.ifElse, key, root, name)
      } else {
        e = jwSubstScoped(sn.ifElse, key, root, name)
      }
    }
    if t == JW_FAILED || e == JW_FAILED { return JW_FAILED }
    if t == JW_ENDED || e == JW_ENDED { return JW_ENDED }
    return JW_RAN
  } else if sn is Block {
    const r = jwSubstScoped(st, key, root, name)
    if r == JW_SHADOWED { return JW_RAN }
    return r
  } else if sn is ForIn {
    // A loop variable named after the root hides the place in the body.
    if sn.fiVar == root || sn.fiVar2 == root {
      jwSubstUntilCut(sn.fiIter, key, root, name)
      return JW_RAN
    }
    return JW_ENDED
  } else if sn is ForRange {
    if sn.frVar == root {
      jwSubstUntilCut(sn.frFrom, key, root, name)
      jwSubstUntilCut(sn.frTo, key, root, name)
      jwSubstUntilCut(sn.frStep, key, root, name)
      return JW_RAN
    }
    return JW_ENDED
  } else if sn is WhileStmt {
    return JW_ENDED
  }
  // A write nested in `st`, or a call the checker ended the narrowing at: the reads evaluated
  // before the first are the copy's. With neither, `st` only holds a scoped binding.
  if jwSubstUntilCut(st, key, root, name) { return JW_ENDED }
  JW_RAN
}

// `jwSubstBefore` of `ix` up to its first write or retiring call; whether it had one.
function jwSubstUntilCut(
  ix: i32,
  key: string,
  root: string,
  name: string,
): boolean {
  const cut = jwCutTok(ix, key, root)
  if cut < 0 {
    jwSubstBefore(ix, key, name, JW_NO_CUT)
    return false
  }
  jwSubstBefore(ix, key, name, cut)
  true
}

// The checker's retirements (`crRows.retCalls`, `crRows.retNames`), handed to `jwExpand`: the
// calls that ended a narrowing of a place, by the place's text.
let jwRetCalls: i32[] = []
let jwRetNames: string[] = []

// What `jwArmWalk` asks of a subtree. Each asks whether the place is rebound or written; they differ
// in what a closure and a call answer.
const JW_DISTURBS = 0
const JW_WRITES_DEEP = 1

// Does the arm rebind or write the place, or call what the checker ended its narrowing at?
// Either ends the narrowing, so a blanket substitution past it would be wrong.
function jwArmDisturbs(ix: i32, key: string, root: string): boolean {
  jwArmWalk(ix, key, root, JW_DISTURBS)
}

// `ask` over the subtree at `ix`. A closure's own writes run at its call, so for `JW_DISTURBS`
// its definition counts only by naming a parameter after the root, and the checker's retiring
// call counts instead; `JW_WRITES_DEEP` walks into closures too.
function jwArmWalk(ix: i32, key: string, root: string, ask: i32): boolean {
  if ix < 0 { return false }
  const n = nodeAt(ix)
  if n is FuncDecl {
    let p = 0
    while p < n.fnParams.length {
      const pn = nodeAt(n.fnParams[p])
      if pn is Param {
        if pn.parName == root { return true }
      }
      p = p + 1
    }
    if ask == JW_DISTURBS { return false }
  } else if n is Call {
    if ask == JW_DISTURBS && jwCallRetires(ix, key, root) { return true }
  } else if n is LetDecl {
    if n.letName == root { return true }
  } else if n is ForIn {
    if n.fiVar == root { return true }
    if n.fiVar2 == root { return true }
  } else if n is ForRange {
    if n.frVar == root { return true }
  } else if n is BinExpr {
    if n.binOp == "=" {
      const lk = jwPlaceKey(n.binLeft)
      if lk == key { return true }
      if lk == root { return true }
    }
  }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    const ks = nodeValueSpineChildren(cur)
    let i = 0
    while i < ks.length {
      if jwArmWalk(ks[i], key, root, ask) { return true }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  false
}

// Whether `ix` is a closure that writes the place, whose body the checker types unnarrowed.
function jwIsWriter(ix: i32, key: string, root: string): boolean {
  ix >= 0 && nodeAt(ix) is FuncDecl && jwArmWalk(ix, key, root, JW_WRITES_DEEP)
}

// Whether the checker ended the narrowing of the place at call `ix`.
function jwCallRetires(ix: i32, key: string, root: string): boolean {
  let i = 0
  while i < jwRetCalls.length {
    if jwRetCalls[i] == ix && (jwRetNames[i] == key || jwRetNames[i] == root) {
      return true
    }
    i = i + 1
  }
  false
}

// The token before which `ix`'s reads of the place still run narrowed, or -1: the end of the first
// call outside closures the checker ended the narrowing at, or just past the right-hand side of
// the first assignment to the place, which is read before the write.
function jwCutTok(ix: i32, key: string, root: string): i32 {
  if ix < 0 { return -1 }
  const n = nodeAt(ix)
  if n is FuncDecl { return -1 }
  if n is Call && jwCallRetires(ix, key, root) { return nodeToks[ix] }
  if n is BinExpr && n.binOp == "=" {
    const lk = jwPlaceKey(n.binLeft)
    if lk == key || lk == root { return nodeToks[ix] + 1 }
  }
  let best = -1
  for c in jwScopedKids(ix, root) {
    const t = jwCutTok(c, key, root)
    if t >= 0 && (best < 0 || t < best) { best = t }
  }
  best
}

// The children of `ix` that can name the place: a block's statements up to a binding of the
// root's name and its initializer, a loop's iterable or bounds when its variable is so named,
// and every child of anything else, along an `else if` spine.
function jwScopedKids(ix: i32, root: string): i32[] {
  const out: i32[] = []
  const n = nodeAt(ix)
  if n is Block {
    for st in n.blkStmts {
      const d = nodeAt(st)
      if d is LetDecl && d.letName == root {
        out.push(d.letInit)
        return out
      }
      out.push(st)
    }
    return out
  }
  if n is ForIn && (n.fiVar == root || n.fiVar2 == root) { return [n.fiIter] }
  if n is ForRange && n.frVar == root { return [n.frFrom, n.frTo, n.frStep] }
  let cur = ix
  while cur >= 0 {
    for c in nodeValueSpineChildren(cur) { out.push(c) }
    cur = elseIfLink(cur)
  }
  out
}

// `jwSubst` of the reads that end before token `cut`, which run before the narrowing ends there.
// An assignment's target stays the place, and a nested binding of the root's name is scoped. A
// closure made before the cut reads the place narrowed, as the checker types it; one after does not.
function jwSubstBefore(ix: i32, key: string, name: string, cut: i32) {
  if ix < 0 { return 0 }
  const root = jwKeyRoot(key)
  if jwIsWriter(ix, key, root) { return 0 }
  if nodeAt(ix) is FuncDecl {
    if nodeToks[ix] < cut { jwSubst(ix, key, name) }
    return 0
  }
  if jwPlaceKey(ix) == key {
    if nodeToks[ix] < cut { arenaSetNode(ix, { identName: name, pos: -1 }) }
    return 0
  }
  const n = nodeAt(ix)
  if n is BinExpr && n.binOp == "=" {
    const lk = jwPlaceKey(n.binLeft)
    if lk == key || lk == root {
      return jwSubstBefore(n.binRight, key, name, cut)
    }
  }
  for c in jwScopedKids(ix, root) { jwSubstBefore(c, key, name, cut) }
  0
}

// Where does the site sit in `c0`? 1 = a positive position (the then arm sees the
// narrowing), -1 = under an odd number of `!` at the top (the else arm sees it), 0 =
// nowhere the narrowing reaches. `&&` propagates only the positive answer: the else
// of `a && (r is T)` proves nothing about `r`.
function jwPolarity(c0: i32, siteIx: i32): i32 {
  if c0 < 0 { return 0 }
  if c0 == siteIx { return 1 }
  const c = nodeAt(c0)
  match c {
    Paren => jwPolarity(c.parInner, siteIx)
    Unary => {
      if c.unOp == "!" {
        const p = jwPolarity(c.unArg, siteIx)
        if p == 1 { return -1 }
        if p == -1 { return 1 }
        return 0
      }
      0
    }
    BinExpr => {
      if c.binOp == "&&" {
        if jwPolarity(c.binLeft, siteIx) == 1 { return 1 }
        if jwPolarity(c.binRight, siteIx) == 1 { return 1 }
        return 0
      }
      0
    }
    // No other condition shape carries the narrowing to an arm.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Call | Member | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => 0
  }
}

// Prepend `stmt` to `blk`'s statement list, in place. The list is mutated through
// `.push` / `.pop` rather than replaced, so no field write is needed on a narrowed arm.
// The `&&` nodes after `siteIx` whose left operand holds the site's test, and the `||` nodes whose
// left operand holds its negation: the right operand of each runs only with the test passed.
function jwNarrowedOperands(siteIx: i32): i32[] {
  const out: i32[] = []
  let c = siteIx + 1
  while c < P.nodes.length {
    const n = nodeAt(c)
    if n is BinExpr {
      if n.binOp == "&&" && jwPolarity(n.binLeft, siteIx) == 1 { out.push(c) }
      if n.binOp == "||" && jwPolarity(n.binLeft, siteIx) == -1 { out.push(c) }
    }
    c = c + 1
  }
  out
}

// Rewrites the right operand `e` of `&&` or `||` node `bin` to `if true { const v = <get>(place)
// e[place → v] } else { false }`, so it reads a converted copy of the place `recvIx` names.
function jwWrapOperand(
  bin: i32,
  recvIx: i32,
  key: string,
  k: i32,
  tok: i32,
): boolean {
  const b = nodeAt(bin)
  if !(b is BinExpr) { return false }
  jwVarCtr = jwVarCtr + 1
  const vname = "__vljv" + i32ToStr(jwVarCtr)
  const thenB = jwSetTok(mkBlock([b.binRight], -1), tok)
  if jwSubstScoped(thenB, key, jwKeyRoot(key), vname) == JW_FAILED {
    return false
  }
  const cp = jwCopyPlace(recvIx, tok)
  if cp < 0 { return false }
  const gid = jwSetTok(mkIdent(jwWalkerName(k), -1), tok)
  const gcall = jwSetTok(mkCall(gid, [cp], -1), tok)
  if (
    !jwPrependStmt(thenB, jwSetTok(mkLet("const", vname, -1, gcall, -1), tok))
  ) {
    return false
  }
  const elseB = jwSetTok(mkBlock([jwSetTok(mkBool(0, -1), tok)], -1), tok)
  const cond = jwSetTok(mkBool(1, -1), tok)
  const wrapped = valueIfAdd(jwSetTok(mkIf(cond, thenB, elseB, b.pos), tok))
  arenaSetNode(
    bin,
    {
      binOp: b.binOp,
      binLeft: b.binLeft,
      binRight: wrapped,
      pos: b.pos,
      binCompound: b.binCompound,
      binTpl: b.binTpl,
      binRegion: b.binRegion,
      binIdent: b.binIdent,
    },
  )
  true
}

function jwPrependStmt(blk: i32, stmt: i32): boolean {
  jwInsertStmt(blk, 0, stmt)
}

// Puts statement `stmt` at index `at` of block `blk`, as a new block node in its slot.
function jwInsertStmt(blk: i32, at: i32, stmt: i32): boolean {
  if blk < 0 { return false }
  const b = nodeAt(blk)
  if !(b is Block) { return false }
  const out: i32[] = []
  let i = 0
  while i < b.blkStmts.length {
    if i == at { out.push(stmt) }
    out.push(b.blkStmts[i])
    i = i + 1
  }
  if at >= b.blkStmts.length { out.push(stmt) }
  arenaSetNode(blk, { blkStmts: out, pos: b.pos })
  true
}

// The block the narrowing governs for the innermost conditional enclosing the site,
// or -1 when the test is used as a plain boolean.
function jwArmBlockOf(siteIx: i32): i32 {
  let c = siteIx + 1
  while c < P.nodes.length {
    const n = nodeAt(c)
    if n is IfStmt {
      const p = jwPolarity(n.ifCond, siteIx)
      if p == 1 { return n.ifThen }
      if p == -1 {
        if n.ifElse >= 0 {
          const e = nodeAt(n.ifElse)
          if e is Block { return n.ifElse }
        }
        return -1
      }
    } else if n is WhileStmt {
      // A loop body gets no binding: `checkWhileStmt` carries only null strips into a
      // loop body, never an `is T` pin, which would reject the assignment flipping it.
      const p = jwPolarity(n.whileCond, siteIx)
      if p != 0 { return -1 }
    }
    c = c + 1
  }
  -1
}

let jwVarCtr = 0

// Rewrite one recorded site. "" on success, otherwise a message that stops the compile
// loudly — a deep `is` that cannot be routed must never fall through to the emitter,
// which would answer `false` for every value (D1035).
function jwRewriteSite(siteIx: i32, k: i32): string {
  if siteIx < 0 || siteIx >= P.nodes.length {
    return "internal: deep `is` site is out of range"
  }
  const n = nodeAt(siteIx)
  if n is IsExpr {
    const recvIx = n.isObj
    const tok = nodeToks[siteIx]
    const arm = jwArmBlockOf(siteIx)
    const key = jwPlaceKey(recvIx)
    // The narrowed binding, prepended to the arm. Only a stable place can carry one; a
    // call result has none, so the test there is a plain boolean.
    if arm >= 0 && key != "" {
      const root = jwKeyRoot(key)
      jwVarCtr = jwVarCtr + 1
      const vname = "__vljv" + i32ToStr(jwVarCtr)
      if jwSubstScoped(arm, key, root, vname) == JW_FAILED {
        return "internal: deep `is` arm is not a block"
      }
      const cp = jwCopyPlace(recvIx, tok)
      if cp < 0 { return "internal: deep `is` receiver has no copyable place" }
      const gid = jwSetTok(mkIdent(jwWalkerName(k), -1), tok)
      const gargs: i32[] = []
      gargs.push(cp)
      const gcall = jwSetTok(mkCall(gid, gargs, -1), tok)
      const letIx = jwSetTok(mkLet("const", vname, -1, gcall, -1), tok)
      if !jwPrependStmt(arm, letIx) {
        return "internal: deep `is` arm is not a block"
      }
    }
    // Each operand an `&&` evaluates only once the test passed, or an `||` once its negation
    // failed, reads its own converted copy.
    if key != "" {
      for op in jwNarrowedOperands(siteIx) {
        if !jwWrapOperand(op, recvIx, key, k, tok) {
          return "internal: deep `is` operand could not be rewritten"
        }
      }
    }
    const fid = jwSetTok(mkIdent(jwPredName(k), n.pos), tok)
    const args: i32[] = []
    args.push(recvIx)
    const names: string[] = []
    const call: Node = {
      callFn: fid,
      callArgs: args,
      callArgNames: names,
      pos: n.pos,
    }
    arenaSetNode(siteIx, call)
    return ""
  }
  "internal: deep `is` site is not an `is` expression"
}

// Rewrite every recorded site; returns the number of sites that refused. Each refusal
// is raised as a positioned type error at its own `is` site rather than returned as a
// string, because a rewrite refusal is a fact about the program the author wrote.
function jwRewriteAll(): i32 {
  jwVarCtr = 0
  let bad = 0
  let s = 0
  while s < jwSiteNode.length {
    const e = jwRewriteSite(jwSiteNode[s], jwSiteTgt[s])
    if e != "" {
      tErr(e, jwSiteNode[s])
      bad = bad + 1
    }
    s = s + 1
  }
  bad
}

// Append the parsed fragment's declarations to the program root.
function jwSplice(root: i32, frag: i32): boolean {
  if root < 0 || frag < 0 { return false }
  const f = nodeAt(frag)
  if f is Program {
    const r = nodeAt(root)
    if r is Program {
      let i = 0
      while i < f.progStmts.length {
        r.progStmts.push(f.progStmts[i])
        i = i + 1
      }
      return true
    }
  }
  false
}

// Generates the walkers for the recorded targets, parses them onto the token stream, splices
// them into program `root` and rewrites every site; the first generated token, or -1 when there
// is nothing to generate or a diagnostic stopped it. Every node the author wrote keeps its index.
export function jwExpand(root: i32, retCalls: i32[], retNames: string[]): i32 {
  jwRetCalls = retCalls
  jwRetNames = retNames
  // The stream grows before the arena does, so a replay must not read the banked tree off it.
  arenaEpochBump()
  const gen = jwGenerateSource()
  if gen == "" { return -1 }
  P.pos = P.toks.length
  const genTok = P.toks.length
  vcLoadToks(gen)
  jwRestoreMangling(genTok)
  const frag = parseProgram()
  if vcParseBlocked() { return -1 }
  if !jwSplice(root, frag) {
    vcDgPush(P.diags.length, 1, 0, 0, 0)
    P.diags.push(
      { msg: "internal: deep `is` walkers could not be spliced", at: -1 },
    )
    return -1
  }
  // A refusal is a positioned type error on its own `is` site.
  if jwRewriteAll() > 0 { return -1 }
  genTok
}
