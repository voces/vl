// A computed `match` scrutinee is evaluated once (D1991): the lowered chain tests the
// scrutinee at every arm, so `hoistMatchScrutinees` binds one that is neither a literal nor a
// place to `const $scrut<match>` ahead of the statement holding the match, or where the match
// stands when that would reorder or skip an evaluation (D2038). A computed `?.` receiver is
// bound the same way, to `const $om<read>`, so the emitter may test it and read it again
// (D5300). It rewrites the node arena before the checker walks it and reads no type, so it
// imports only `./ast`, `./fmt_util`, `./check_places` and `./symbols`.
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  BoolLit,
  Call,
  CharLit,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  Index,
  IsExpr,
  LetDecl,
  MatchExpr,
  Member,
  Node,
  NullLit,
  NumLit,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  Program,
  RetStmt,
  Spread,
  StrLit,
  Unary,
  WhileStmt,
  addNode,
  adoptNodeTok,
  arenaSetNode,
  elseIfLink,
  i32ToStr,
  mkBlock,
  mkBool,
  mkCall,
  mkIdent,
  mkIf,
  mkIndex,
  mkLet,
  mkMember,
  mkNull,
  mkOptMember,
  mkParen,
  nodeAt,
  nodeSpineChildren,
  nodeValueChildren,
  valueIfAdd,
} from "./ast"
import { nodePos } from "./fmt_util"
import { placeKeyOf } from "./check_places"
import { IDENT_BUILTIN, identSet } from "./symbols"

// The matches found by the walk, innermost first, each beside a copy of its ancestor path.
let hmsMatches: i32[] = []
let hmsPaths: i32[][] = []
// The matches whose scrutinee is a place, read again at every arm rather than bound.
let hmsPlaceMatches: i32[] = []
// Every name the program can rebind — a `let`, a parameter, a loop variable — by spelling.
let hmsRebindable: {[string]: boolean} = Map()

// Whether scrutinee `ix` may be read once per arm: a literal, or a place `placeKeyOf` keys.
function matchScrutInPlace(ix: i32) {
  if matchLitOrLambda(ix) { return true }
  placeKeyOf(ix) != ""
}

// A literal (possibly negated or parenthesised) or a lambda: a value whose evaluation can
// move past the scrutinee's without either observing the other.
function matchLitOrLambda(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if n is Paren { return matchLitOrLambda(n.parInner) }
  if n is Unary { return n.unOp == "-" && matchLitOrLambda(n.unArg) }
  matchLeafIsLitOrLambda(ix)
}

// The leaves `matchLitOrLambda` accepts once parentheses and a minus are peeled.
function matchLeafIsLitOrLambda(ix: i32): boolean {
  const n = nodeAt(ix)
  n is NumLit
    || n is StrLit
    || n is CharLit
    || n is BoolLit
    || n is NullLit
    || n is FuncDecl
}

// Binds every computed scrutinee under `rootIx` (see the section head), then gives each arm
// test and payload read of every bound or place scrutinee its own read node (D14538). Returns
// the count bound.
export function hoistMatchScrutinees(rootIx: i32) {
  hmsMatches = []
  hmsPaths = []
  hmsPlaceMatches = []
  hmsRebindable = Map()
  const anc: i32[] = []
  hmsWalk(rootIx, anc)
  let done = 0
  let k = 0
  while k < hmsMatches.length {
    if hoistMatchScrutAt(hmsMatches[k], hmsPaths[k]) { done = done + 1 }
    else if hmsBindOptInPlace(hmsMatches[k], hmsPaths[k]) { done = done + 1 }
    else if hmsBindMatchInPlace(hmsMatches[k], hmsPaths[k]) { done = done + 1 }
    k = k + 1
  }
  for m in hmsPlaceMatches { hmsSplitPlaceReads(m) }
  hmsMatches = []
  hmsPaths = []
  hmsPlaceMatches = []
  hmsRebindable = Map()
  done
}

// Points match `m`'s arm tests and payload reads at copies of its place scrutinee.
function hmsSplitPlaceReads(m: i32) {
  const n = nodeAt(m)
  if n is MatchExpr {
    if placeKeyOf(n.matchScrut) != "" {
      hmsPointArms(n, n.matchScrut, n.matchScrut)
    }
  }
  0
}

// Post-order over the value children, so an inner match is recorded before the one holding it.
// The node is read once and every kind test below asks that copy.
function hmsWalk(ix: i32, anc: i32[]) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if hmsInertLeaf(n) { return 0 }
  if n is IfStmt { return hmsWalkIfChain(ix, anc) }
  anc.push(ix)
  hmsWalkEach(nodeValueChildren(ix), anc)
  anc.pop()
  if hmsNotedKind(n) {
    hmsNoteRebindable(n)
    hmsRecordMatch(ix, anc)
  }
  0
}

// An `else if` chain is walked along its spine, each link staying on the path (D1990). A link
// is an `if`, which binds no name and is never hoisted, so only the path is restored after.
function hmsWalkIfChain(ix: i32, anc: i32[]) {
  let cur = ix
  let links = 0
  while cur >= 0 {
    anc.push(cur)
    links = links + 1
    const next = elseIfLink(cur)
    const kids = if next >= 0 { nodeSpineChildren(cur) } else { nodeValueChildren(cur) }
    hmsWalkEach(kids, anc)
    cur = next
  }
  while links > 0 {
    anc.pop()
    links = links - 1
  }
  0
}

function hmsWalkEach(kids: i32[], anc: i32[]) {
  let i = 0
  while i < kids.length {
    hmsWalk(kids[i], anc)
    i = i + 1
  }
  0
}

// The kinds `hmsNoteRebindable` or `hmsRecordMatch` can act on; every other node is a no-op
// for both.
function hmsNotedKind(n: Node): boolean {
  n is LetDecl
    || n is FuncDecl
    || n is ForRange
    || n is ForIn
    || n is MatchExpr
    || n is OptMember
}

// A name or literal leaf: no value child, binds no name and is never hoisted, so the walk
// would record nothing at it and leave the path as it found it.
function hmsInertLeaf(n: Node): boolean {
  n is Ident
    || n is NumLit
    || n is StrLit
    || n is CharLit
    || n is BoolLit
    || n is NullLit
}

// Records match `ix` with a copy of its ancestor path when its scrutinee is computed, and a
// `?.` read whose receiver is computed and no link of a longer chain; a match whose scrutinee
// is in place is recorded apart, for its arm reads to be split.
function hmsRecordMatch(ix: i32, anc: i32[]) {
  const n = nodeAt(ix)
  if n is MatchExpr {
    if matchScrutInPlace(n.matchScrut) { hmsPlaceMatches.push(ix) }
  }
  if hmsHoistable(ix) {
    const path: i32[] = []
    let j = 0
    while j < anc.length {
      path.push(anc[j])
      j = j + 1
    }
    hmsMatches.push(ix)
    hmsPaths.push(path)
  }
  0
}

// Whether node `ix` is a `?.` read with a computed receiver, or else a match whose
// scrutinee is computed.
function hmsHoistable(ix: i32): boolean {
  const n = nodeAt(ix)
  if n is OptMember { return hmsOptRecvComputed(n.omObj) }
  hmsMatchComputed(ix)
}

// Whether node `ix` is a match whose scrutinee is neither a literal nor a place.
function hmsMatchComputed(ix: i32): boolean {
  const n = nodeAt(ix)
  if n is MatchExpr { return !matchScrutInPlace(n.matchScrut) }
  false
}

// Whether `?.` receiver `ix`, parentheses peeled, is neither in place nor another `?.` read.
function hmsOptRecvComputed(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if n is Paren { return hmsOptRecvComputed(n.parInner) }
  if n is OptMember { return false }
  !matchScrutInPlace(ix)
}

// Records the names node `n` binds that a later write could rebind: a `let`, a parameter,
// a loop variable. One kind per helper, since each reads a different field.
function hmsNoteRebindable(n: Node) {
  hmsNoteLet(n)
  hmsNoteParams(n)
  hmsNoteRangeVar(n)
  hmsNoteForInVars(n)
}

function hmsNoteLet(n: Node) {
  if n is LetDecl {
    if n.letKw != "const" { hmsRebindable[n.letName] = true }
  }
  0
}

function hmsNoteParams(n: Node) {
  if n is FuncDecl {
    let i = 0
    while i < n.fnParams.length {
      const pix = n.fnParams[i]
      if pix >= 0 && pix < P.nodes.length {
        const pn = nodeAt(pix)
        if pn is Param { hmsRebindable[pn.parName] = true }
      }
      i = i + 1
    }
  }
  0
}

function hmsNoteRangeVar(n: Node) {
  if n is ForRange { hmsRebindable[n.frVar] = true }
  0
}

function hmsNoteForInVars(n: Node) {
  if n is ForIn {
    hmsRebindable[n.fiVar] = true
    hmsRebindable[n.fiVar2] = true
  }
  0
}

// Whether reading `ix` before the scrutinee is the same as reading it after: a bare name no
// `let`, parameter or loop binds, so a declared function, a `const` or a builtin (D2038).
function hmsStableName(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if n is Ident { return !hmsRebindable.has(n.identName) }
  false
}

// A callee the scrutinee cannot change: a stable name, or a method on a stable name.
function hmsStableCallee(ix: i32): boolean {
  if hmsStableName(ix) { return true }
  const n = nodeAt(ix)
  if n is Member { return hmsStableName(n.memObj) }
  false
}

// Climbs from match `m` through ancestors that evaluate it first and unconditionally, then
// binds its scrutinee before the statement reached, or inside the enclosing match arm. False,
// leaving the match as parsed, when a step would reorder or skip an evaluation.
function hoistMatchScrutAt(m: i32, anc: i32[]): boolean {
  let cur = m
  let k = anc.length - 1
  while k >= 0 {
    const p = anc[k]
    const pn = nodeAt(p)
    if pn is Program { return hmsInsertBefore(p, cur, m) }
    if pn is Block {
      if pn.blkStmts.length < 2 && !hmsBlockWalked(anc, k) { return false }
      return hmsInsertBefore(p, cur, m)
    }
    if pn is MatchExpr {
      if pn.matchScrut != cur {
        if !hmsValueWalked(anc, k) { return false }
        return hmsWrapArm(p, cur, m)
      }
    } else {
      if !hmsStepOk(p, cur) { return false }
    }
    cur = p
    k = k - 1
  }
  false
}

// A `?.` read whose receiver cannot move ahead of its statement is bound where it stands:
// `(if true { const $om<m> = <receiver>; $om<m>?.p } else { null })` evaluates the receiver
// once, in source order (D5331). Declined when the read is a callee, an index base, an
// assignment target or a link of a longer chain, whose meaning the wrap would change.
function hmsBindOptInPlace(m: i32, anc: i32[]): boolean {
  const n = nodeAt(m)
  if !(n is OptMember) { return false }
  if anc.length > 0 {
    const pn = nodeAt(anc[anc.length - 1])
    if pn is Member || pn is OptMember { return false }
    if pn is Call {
      if pn.callFn == m { return false }
    }
    if pn is Index {
      if pn.idxArr == m { return false }
    }
    if pn is BinExpr {
      if pn.binLeft == m && pn.binOp == "=" { return false }
    }
  }
  if n is OptMember {
    const sp = nodePos(n.omObj)
    const name = "$om" + i32ToStr(m)
    const decl = mkLet("const", name, -1, n.omObj, sp)
    adoptNodeTok(decl, n.omObj)
    const ref = mkIdent(name, sp)
    adoptNodeTok(ref, n.omObj)
    const read = mkOptMember(ref, n.omProp, n.omDot, n.pos)
    adoptNodeTok(read, m)
    const thenStmts: i32[] = [decl, read]
    const thenB = mkBlock(thenStmts, sp)
    const elseStmts: i32[] = [mkNull("null", n.pos)]
    const elseB = mkBlock(elseStmts, n.pos)
    const ifn = valueIfAdd(mkIf(mkBool(1, n.pos), thenB, elseB, n.pos))
    adoptNodeTok(ifn, m)
    const wrap: Node = { parInner: ifn, pos: n.pos }
    arenaSetNode(m, wrap)
    return true
  }
  false
}

// A computed scrutinee that cannot move ahead of its statement is bound where its match stands:
// just before it in a block that holds it, else as `if true { const $scrut<m> = <scrutinee>;
// match $scrut<m> {…} } else { __trap__() }`, the value form of a block. Either way it is
// evaluated once, in source order, at the match's own type (D2038).
function hmsBindMatchInPlace(m: i32, anc: i32[]): boolean {
  if !(nodeAt(m) is MatchExpr) { return false }
  if anc.length > 0 {
    const p = anc[anc.length - 1]
    if nodeAt(p) is Block { return hmsInsertBefore(p, m, m) }
  }
  const decl = hmsBindMatch(m)
  if decl < 0 { return false }
  const pos = nodePos(m)
  const inner = addNode(nodeAt(m))
  adoptNodeTok(inner, m)
  const thenStmts: i32[] = [decl, inner]
  const thenB = mkBlock(thenStmts, pos)
  const trapFn = mkIdent("__trap__", pos)
  identSet(trapFn, IDENT_BUILTIN)
  const none: i32[] = []
  const elseStmts: i32[] = [mkCall(trapFn, none, pos)]
  const elseB = mkBlock(elseStmts, pos)
  const ifn = valueIfAdd(mkIf(mkBool(1, -1), thenB, elseB, pos))
  adoptNodeTok(ifn, m)
  const wrap: Node = { parInner: ifn, pos: pos }
  arenaSetNode(m, wrap)
  true
}

// Whether parent `p` evaluates child `cur` unconditionally, and after nothing but literals,
// lambdas, and a callee, receiver or index base no write can rebind.
function hmsStepOk(p: i32, cur: i32): boolean {
  const pn = nodeAt(p)
  if pn is LetDecl { return pn.letInit == cur }
  if pn is IfStmt { return pn.ifCond == cur }
  if pn is ForIn { return pn.fiIter == cur }
  if pn is Call { return hmsCallArgOk(pn, cur) }
  if pn is BinExpr {
    const op = pn.binOp
    // A `??` evaluates its left operand first and always, its default only on a null.
    if op == "??" { return pn.binLeft == cur }
    if op == "&&" || op == "||" { return false }
    // An assignment's target is not moved ahead of its value.
    if op == "=" { return pn.binRight == cur && nodeAt(pn.binLeft) is Ident }
    if pn.binLeft == cur { return true }
    return matchLitOrLambda(pn.binLeft)
  }
  if pn is Index { return pn.idxArr == cur || hmsStableName(pn.idxArr) }
  if pn is ArrayLit { return hmsPriorLits(pn.arrElems, cur) }
  if pn is ObjLit { return hmsPriorFieldLits(pn.objFields, cur) }
  hmsSingleChildParent(p)
}

// A parent with one value child, evaluated first: nothing else of it can run before the child.
function hmsSingleChildParent(p: i32): boolean {
  const pn = nodeAt(p)
  pn is Paren
    || pn is Unary
    || pn is AsExpr
    || pn is IsExpr
    || pn is Member
    || pn is OptMember
    || pn is Spread
    || pn is FieldInit
    || pn is RetStmt
}

// A call evaluates its callee, then its arguments in order; named arguments are reordered by
// the checker, so a call carrying one is declined, as is a callee the scrutinee could rebind.
function hmsCallArgOk(c: Call, cur: i32): boolean {
  if c.callFn == cur { return true }
  let i = 0
  while i < c.callArgNames.length {
    if c.callArgNames[i] != "" { return false }
    i = i + 1
  }
  if !hmsStableCallee(c.callFn) { return false }
  hmsPriorLits(c.callArgs, cur)
}

// Whether every item of `items` before `cur` is a literal or a lambda (false if `cur` is absent).
function hmsPriorLits(items: i32[], cur: i32): boolean {
  let i = 0
  while i < items.length {
    if items[i] == cur { return true }
    if !matchLitOrLambda(items[i]) { return false }
    i = i + 1
  }
  false
}

// `hmsPriorLits` over an object literal's `FieldInit`s, reading each field's value.
function hmsPriorFieldLits(fields: i32[], cur: i32): boolean {
  let i = 0
  while i < fields.length {
    if fields[i] == cur { return true }
    const vals = nodeValueChildren(fields[i])
    let j = 0
    while j < vals.length {
      if !matchLitOrLambda(vals[j]) { return false }
      j = j + 1
    }
    i = i + 1
  }
  false
}

// Whether the emitter allocates the locals of Block `anc[k]` (`collectLocals` reaches it), so a
// binding added to a one-statement block does not become an arm prelude it refuses.
function hmsBlockWalked(anc: i32[], k: i32): boolean {
  if k < 1 { return false }
  const pn = nodeAt(anc[k - 1])
  if pn is FuncDecl { return true }
  if pn is IfStmt { return hmsValueWalked(anc, k - 1) }
  if pn is MatchExpr { return hmsValueWalked(anc, k - 1) }
  hmsLoopBodyWalked(anc, k)
}

// Whether Block `anc[k]` is the body of a loop that is itself a walked statement.
function hmsLoopBodyWalked(anc: i32[], k: i32): boolean {
  if k < 2 { return false }
  const pn = nodeAt(anc[k - 1])
  const loop = pn is WhileStmt || pn is ForRange || pn is ForIn
  loop && hmsHolderWalked(anc, k - 2)
}

// Whether `anc[j]` is the program or a walked block: a statement it holds is walked.
function hmsHolderWalked(anc: i32[], j: i32): boolean {
  const h = nodeAt(anc[j])
  h is Program || (h is Block && hmsBlockWalked(anc, j))
}

// Whether the emitter walks the arms of the `if` or `match` at `anc[j]`: a statement of a walked
// block, the initializer of a local, a `return` operand, or an `else` / arm of one that is.
function hmsValueWalked(anc: i32[], j: i32): boolean {
  // Climbs an `else if` chain by a loop, not by recursion (D1990).
  let k = j
  while k >= 1 {
    const step = hmsValueStep(anc, k)
    if step != 1 { return step == 2 }
    k = k - 1
  }
  false
}

// One step of `hmsValueWalked` at `anc[k]`: 1 when it is its parent's value (a parenthesis,
// an `else` link, a match arm) so the parent decides, 2 when the parent walks it, -1 when not.
function hmsValueStep(anc: i32[], k: i32): i32 {
  const e = anc[k]
  const pn = nodeAt(anc[k - 1])
  if pn is Paren { return 1 }
  if pn is IfStmt {
    if pn.ifElse == e { return 1 }
    return -1
  }
  if pn is MatchExpr {
    if pn.matchScrut != e { return 1 }
    return -1
  }
  if hmsCarrierWalked(anc, k - 1) { return 2 }
  -1
}

// Whether `anc[i]` holds its child as a walked statement, or is a local's initializer or a
// `return` operand in a walked block — a module global's initializer is not walked.
function hmsCarrierWalked(anc: i32[], i: i32): boolean {
  if hmsHolderWalked(anc, i) { return true }
  const c = nodeAt(anc[i])
  if !(c is LetDecl || c is RetStmt) || i < 1 { return false }
  nodeAt(anc[i - 1]) is Block && hmsBlockWalked(anc, i - 1)
}

// Inserts match `m`'s scrutinee binding into Block or Program `bIx`, just before `stmtIx`.
function hmsInsertBefore(bIx: i32, stmtIx: i32, m: i32): boolean {
  const stmts = nodeValueChildren(bIx)
  let at = -1
  let i = 0
  while i < stmts.length {
    if stmts[i] == stmtIx { at = i }
    i = i + 1
  }
  if at < 0 { return false }
  const decl = hmsBind(m)
  if decl < 0 { return false }
  const out: i32[] = []
  let j = 0
  while j < stmts.length {
    if j == at { out.push(decl) }
    out.push(stmts[j])
    j = j + 1
  }
  const b = nodeAt(bIx)
  if b is Program {
    const np: Node = { progStmts: out, pos: b.pos }
    arenaSetNode(bIx, np)
    return true
  }
  const nb: Node = { blkStmts: out, pos: nodePos(bIx) }
  arenaSetNode(bIx, nb)
  true
}

// Replaces arm body `bodyIx` of match `outer` with `{ const $scrut… = …; <body> }`.
function hmsWrapArm(outer: i32, bodyIx: i32, m: i32): boolean {
  const o = nodeAt(outer)
  if o is MatchExpr {
    let at = -1
    let i = 0
    while i < o.matchBodies.length {
      if o.matchBodies[i] == bodyIx { at = i }
      i = i + 1
    }
    if at < 0 { return false }
    const decl = hmsBind(m)
    if decl < 0 { return false }
    const stmts: i32[] = [decl, bodyIx]
    const blk = mkBlock(stmts, -1)
    adoptNodeTok(blk, bodyIx)
    const bodies: i32[] = []
    let j = 0
    while j < o.matchBodies.length {
      if j == at { bodies.push(blk) } else { bodies.push(o.matchBodies[j]) }
      j = j + 1
    }
    const no: Node = {
      matchScrut: o.matchScrut,
      matchPats: o.matchPats,
      matchBinds: o.matchBinds,
      matchArmStart: o.matchArmStart,
      matchArmCount: o.matchArmCount,
      matchBodies: bodies,
      pos: o.pos,
    }
    arenaSetNode(outer, no)
    return true
  }
  false
}

// Mints `const $om<m> = <receiver>` and points the `?.` read `m` at it. Returns the declaration.
function hmsBindOptRecv(m: i32, n: OptMember) {
  const recv = n.omObj
  const name = "$om" + i32ToStr(m)
  const sp = nodePos(recv)
  const decl = mkLet("const", name, -1, recv, sp)
  adoptNodeTok(decl, recv)
  const ref = mkIdent(name, sp)
  adoptNodeTok(ref, recv)
  const no: Node = { omObj: ref, omProp: n.omProp, omDot: n.omDot, pos: n.pos }
  arenaSetNode(m, no)
  decl
}

// Binds hoisted node `m`, a `?.` read or a match, to a `const`. Returns the declaration, or -1.
function hmsBind(m: i32) {
  const n = nodeAt(m)
  if n is OptMember { return hmsBindOptRecv(m, n) }
  hmsBindMatch(m)
}

// Mints `const $scrut<m> = <scrutinee>` and points match `m` — its scrutinee, its type
// patterns and its payload reads, each through a read of its own — at the binding instead.
// Returns the declaration, or -1.
function hmsBindMatch(m: i32) {
  const n = nodeAt(m)
  if n is MatchExpr {
    const scrut = n.matchScrut
    const name = "$scrut" + i32ToStr(m)
    const sp = nodePos(scrut)
    const decl = mkLet("const", name, -1, scrut, sp)
    adoptNodeTok(decl, scrut)
    const ref = mkIdent(name, sp)
    adoptNodeTok(ref, scrut)
    hmsPointArms(n, scrut, ref)
    const nm: Node = {
      matchScrut: ref,
      matchPats: n.matchPats,
      matchBinds: n.matchBinds,
      matchArmStart: n.matchArmStart,
      matchArmCount: n.matchArmCount,
      matchBodies: n.matchBodies,
      pos: n.pos,
    }
    arenaSetNode(m, nm)
    return decl
  }
  -1
}

// Points every type pattern of match `n` testing node `from`, and every payload read rooted at
// it, at a fresh copy of the read `src`, so no two reads share a node and a per-node fact (a
// read's type, its narrowing) is the read's own.
function hmsPointArms(n: MatchExpr, from: i32, src: i32) {
  for pat in n.matchPats {
    const pn = nodeAt(pat)
    if pn is IsExpr {
      if pn.isObj == from {
        const np: Node = {
          isObj: hmsCopyRead(src),
          isVariant: pn.isVariant,
          pos: pn.pos,
          isNeg: pn.isNeg,
        }
        arenaSetNode(pat, np)
      }
    }
  }
  for bx in n.matchBinds {
    if bx >= 0 { hmsRedirectBinds(bx, from, src) }
  }
  0
}

// Points each payload `const x = <scrut>.p.x` of clause block `bx` at a copy of `src` instead
// of `from`.
function hmsRedirectBinds(bx: i32, from: i32, src: i32) {
  const lets = nodeValueChildren(bx)
  let i = 0
  while i < lets.length {
    const d = nodeAt(lets[i])
    if d is LetDecl { hmsRedirectRoot(d.letInit, from, src) }
    i = i + 1
  }
  0
}

// Re-roots the member chain at `ix` from node `from` onto a copy of `src`.
function hmsRedirectRoot(ix: i32, from: i32, src: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is Member {
    if n.memObj == from {
      const nm: Node = {
        memObj: hmsCopyRead(src),
        memProp: n.memProp,
        pos: n.pos,
      }
      arenaSetNode(ix, nm)
      return 0
    }
    return hmsRedirectRoot(n.memObj, from, src)
  }
  0
}

// A new node reading the place `ix` reads: a name, a field, a `?.` link or a literal subscript
// copied link by link, each keeping its source's position and token. Any other node is
// returned as it is, as a scrutinee read again at every arm only when it is such a place.
function hmsCopyRead(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return ix }
  const n = nodeAt(ix)
  let c = ix
  if n is Ident {
    c = mkIdent(n.identName, n.pos)
  } else if n is Paren {
    c = mkParen(hmsCopyRead(n.parInner), n.pos)
  } else if n is Member {
    c = mkMember(hmsCopyRead(n.memObj), n.memProp, n.pos)
  } else if n is OptMember {
    c = mkOptMember(hmsCopyRead(n.omObj), n.omProp, n.omDot, n.pos)
  } else if n is Index {
    c = mkIndex(hmsCopyRead(n.idxArr), hmsCopyLeaf(n.idxIndex), n.pos)
  }
  if c != ix { adoptNodeTok(c, ix) }
  c
}

// A copy of the literal subscript `ix`, or `ix` itself when it is not a number or string.
function hmsCopyLeaf(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return ix }
  const n = nodeAt(ix)
  if !(n is NumLit || n is StrLit) { return ix }
  const c = addNode(n)
  adoptNodeTok(c, ix)
  c
}
