// ── per-callsite monomorphization ────────────────────────────────────────────

// A direct call to a generic resolves to a concrete instance: a clone whose generic
// annotations become the call's concrete type names, keyed by `(decl, pinned-param-
// names)` and registered before the body is walked so a recursive self-call at the
// same shape hits the registry.

import { collectValuedReturnsIn } from "./emit_query"

// D943 — the lifted slots `monoPinBodyLambdas` minted for the instance being built. A
// clone's `fnParent` cannot be set at clone time (its own `FuncDecl` does not exist
// yet), so it would inherit the template's parent and give every instance one env
// layout. Recorded here and re-pointed the moment the instance is lifted.
let monoLamMintedSlots: i32[] = []

// The arena shape `monoRebuild`'s four whole-program passes are a pure function of:
// `P.nodes`, `fnStmts` and `fnParent` grow, and `monoArenaTick` counts what lands IN PLACE,
// which no length can see. Every in-place write in this module calls `monoArenaTouch` or
// carries an `arena-tick exempt:` line; `tests/vl_mono_arena_tick_test.ts` enforces that.
let monoArenaTick = 0
let monoRebuiltStamp = 0 - 1

function monoArenaStamp() {
  P.nodes.length + fnStmts.length + fnParent.length + monoArenaTick
}

// Record an in-place write to a node field or to a `fnStmts`/`fnParent` slot: no length
// moves, so the stamp needs the count to see it. Every such write in this module calls it.
function monoArenaTouch() {
  monoArenaTick = monoArenaTick + 1
  0
}

// D1046 — is this the first instance of the generic being built? Read by the nested
// named-function arm alone: at `count == 0` the instance reuses the template's own
// slot, so template and clone would be two children of one frame under one name and
// the call would answer the unsubstituted template.
let monoInstIsFirst = false

// D1046 — the lifted slot a named nested template is replaced in, keyed by the
// template's own node. The first instance overwrites `fnStmts[slot]`, which breaks the
// "scan `fnStmts` for this node" lookup `monoLamNodeIsTemplate` and the capture-only
// rung both use; a -1 there shares one env struct across two pins.
const monoNamedTmplNode: i32[] = []
const monoNamedTmplSlot: i32[] = []

// The lifted slot holding node `fnIx`: the plain scan, plus the replacement table for a
// named template whose slot now holds its first instance. One home, because two call
// sites ask the same question with the same loop.
function monoSlotOfLamNode(fnIx: i32) {
  let fe = 0 - 1
  let k = 0
  while k < fnStmts.length {
    if fnStmts[k] == fnIx { fe = k }
    k = k + 1
  }
  if fe >= 0 { return fe }
  let r = 0
  while r < monoNamedTmplNode.length {
    if monoNamedTmplNode[r] == fnIx { return monoNamedTmplSlot[r] }
    r = r + 1
  }
  -1
}

// Is `nm` a source function name rather than the emitter's synthesized lambda name?
// `collectFns` rewrites an anonymous lambda's empty name to `__lambda_N` before this
// pass, so `fnName != ""` is true of every lifted lambda and is not the test. Same rule
// as `criFnIsAnonLambda`, asked of a name rather than of a slot.
function monoFnNameIsSourceNamed(nm: string) {
  if nm == "" { return false }
  if nm.length >= 8 && nm.slice(0, 8) == "__lambda" { return false }
  true
}

// The function-type name of argument `argIx`, preferring the checker's recorded type:
// for an un-annotated lambda argument it inferred the param types from the generic
// param's substituted expected type, which the syntactic build below cannot recover.
// The gate is the arena (`nodeTyIsFunc`), and the struct part is nominalized once here.
function monoArgFnTypeName(argIx: i32, _fnIx: i32) {
  const ax = unwrapParen(argIx)
  const an = P.nodes[ax]

  if nodeTyIsFunc(ax) {
    const cn = nodeTyName(ax)
    if cn != "" { return nominalizeFnTypeOfTy(nodeTyIxOf(ax)) }
  }
  let fe = -1
  if an is FuncDecl { fe = fnStmtsPosOf(ax) }
  else if an is Ident { fe = fnIndexOf(an.identName) }
  if fe < 0 || fe >= fnStmts.length { return "" }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    let nm = "("
    let i = 0
    while i < fn.fnParams.length {
      const p = P.nodes[fn.fnParams[i]]
      if p is Param {
        if p.parType < 0 { return "" }
        const pn = tyNameOf(p.parType)
        if pn == "" { return "" }
        if i > 0 { nm = nm + "," }
        nm = nm + pn
      }
      i = i + 1
    }
    const rn = cloRetTypeName(fe)
    if rn == "" { return "" }
    return nm + ")=>" + rn
  }
  ""
}

// D970 — does this function's return set disagree with `reIx`, the type of the one
// return expression the mint above derives from? Conservative by construction: false
// whenever it cannot see the returns, so a single-return instance keeps its mint.
function monoRetJoinDisagrees(fnNodeIx: i32, reIx: i32): boolean {
  if reIx < 0 { return false }
  if fnNodeIx < 0 { return false }
  const f = P.nodes[fnNodeIx]
  if f is FuncDecl {
    const rets: i32[] = []
    collectValuedReturnsIn(f.fnBody, rets)
    let i = 0
    while i < rets.length {
      const rt = nodeTyIxOf(rets[i])
      if rt >= 0 {
        // Concrete disagreement only. A return whose type is or contains a type
        // variable is per-call-site, and declining the mint for it turns the
        // deferred-join family from a loud refusal into invalid wasm.
        if !tyHasTyVar(rt) {
          if rt != reIx { return true }
        }
      }
      i = i + 1
    }
  }
  false
}

// A struct or struct-array annotation name usable as a monomorphization pin while the
// locals and struct-classification tables are unbuilt: the bare struct `P`, or `P[]`.
// "" for anything else. One level of `[]`; `n >= 3` excludes the degenerate `"[]"`.
function monoStructAnnName(name: string) {
  if isSName(name) { return name }
  const n = name.length
  if n >= 3 && nameIsArray(name) {
    if isSName(arrElemNameRaw(name)) { return name }
  }
  ""
}

// Is `name` still the module's binding when read from inside `fnIx` (-1 = module scope)?
// False when that body binds it or takes a parameter of it — the shadow test, which is not
// the same question as `fnIx >= 0` (D703).
function monoModuleNameVisible(name: string, fnIx: i32) {
  if fnIx < 0 { return true }
  if paramTypeNode(fnIx, name) >= 0 { return false }
  const shf = P.nodes[fnIx]
  if shf is FuncDecl { return parentLetOf(shf.fnBody, name) < 0 }
  false
}

// The module-scope `LetDecl` for `name` as seen from `fnIx`, or -1. Module scope has two
// storage classes: a top-level block's binding is a start-function local, absent from
// `monoProgStmts`, so `moduleLocalLetOfUnique` is the other table (D1596).
function monoModuleLetOf(name: string, fnIx: i32) {
  if !monoModuleNameVisible(name, fnIx) { return -1 }
  let i = 0
  while i < monoProgStmts.length {
    const s = P.nodes[monoProgStmts[i]]
    if s is LetDecl {
      if s.letName == name { return monoProgStmts[i] }
    }
    i = i + 1
  }
  moduleLocalLetOfUnique(emitRootIx, name)
}

// Does the module-block binding at `letIx` carry `want`, the emit name of what the checker
// recorded for a call site? Both of the binding's spellings answer: an alias puts `Box` on
// the annotation and the inline shape on the initializer, and only one renders as `want`.
function monoModuleLetTyIs(letIx: i32, want: string) {
  if want == "" { return false }
  const gd = P.nodes[letIx]
  if gd is LetDecl {
    if gd.letType >= 0 {
      if tyNameOf(gd.letType) == want { return true }
    }
    if gd.letInit >= 0 {
      if tyToEmitName(nodeTyIxOf(gd.letInit)) == want { return true }
    }
  }
  false
}

// The pin a module-block binding gives, or "" — its annotation, else its initializer's own
// answer. "" rather than a third fall-through state, so a candidate that names nothing
// cannot stop `monoArgTyName`'s ladder.
function monoModuleLetPin(letIx: i32, fnIx: i32) {
  const gd = P.nodes[letIx]
  if gd is LetDecl {
    if gd.letType >= 0 { return monoAnnPinName(tyNameOf(gd.letType)) }
    if gd.letInit >= 0 {
      const inner = monoArgTyName(gd.letInit, fnIx)
      if inner != "i32" { return inner }
    }
  }
  ""
}

// The pin for the call site `siteIx` when the module frame binds `name` in more than one
// block, or "". The first-wins table declines there; the candidate carrying the type the
// checker recorded for the site is the one it denotes, and a set of candidates that all pin
// one spelling has no disagreement left to decline over (D1598).
function monoModuleDupPin(name: string, fnIx: i32, siteIx: i32) {
  if !monoModuleNameVisible(name, fnIx) { return "" }
  const cands: i32[] = []
  moduleLocalLetAll(emitRootIx, name, cands)
  if cands.length < 2 { return "" }
  const want = tyToEmitName(nodeTyIxOf(siteIx))
  let i = 0
  while i < cands.length {
    if monoModuleLetTyIs(cands[i], want) {
      const dp = monoModuleLetPin(cands[i], fnIx)
      if dp != "" { return dp }
    }
    i = i + 1
  }
  const agreed = monoModuleLetPin(cands[0], fnIx)
  if agreed == "" { return "" }
  let j = 1
  while j < cands.length {
    if monoModuleLetPin(cands[j], fnIx) != agreed { return "" }
    j = j + 1
  }
  agreed
}

// The one home for "which annotation name can serve as a monomorphization pin". Both
// callers exist because mid-mono the `expr*` rep cascade cannot classify a binding at
// all (`buildLocals` is post-mono), so the annotation is the only truth; both sit behind
// `fnIx >= 0`. "" means no pin from the annotation, and the cascade answers instead.
function monoAnnPinName(name: string) {
  const r = monoStructAnnName(name)
  if r != "" { return r }
  // A union-typed annotation (`a: Cat | Dog`, or an alias): bind `T` to the union name
  // so the instance's param and return ride the union box. `isUName` covers a
  // registered inline union and a `type … = … | …` alias.
  if isUName(name) { return name }
  // …and its list rung (D1082): `isUName` is false for an array name, so `first<T>(xs:
  // T[])` over a `const xs: Shape[]` had no arm at all. The pin is the caller's own
  // spelling, safe because the same program through a non-generic `firstS` runs.
  if nameIsArray(name) {
    if isUName(arrElemNameRaw(name)) { return name }
  }
  // A declared union arm (`Circle` in `type Shape = Circle | Sq`) — the kind-8 variant,
  // whose slot is `(ref $uVarHeap[vi])`. `monoStructAnnName` declines it (no struct row)
  // and `isUName` declines it (an arm is not the union), so without this rung the
  // `"i32"` catch-all declares an i32 parameter over a `(ref $type)` value (D23).
  if variantIndexOf(name) >= 0 { return name }
  // …and the list rung of that same arm (D37). `monoStructAnnName`'s list rung asks
  // `isSName("Circle")` and `variantIndexOf("Circle[]")` is false for an array name, so
  // `Circle[]` is claimed by neither. The pin is again the caller's own spelling.
  if nameIsArray(name) {
    if variantIndexOf(arrElemNameRaw(name)) >= 0 { return name }
  }
  // A bare inline object shape (`{r: i32}`). `isSName` cannot answer by construction:
  // `internInlineShapeTy` dedups an inline shape onto the declared row of that layout and
  // pushes no `sNames` entry (D53). After the variant arms and before the map arm, since
  // `nameIsShapeSpanEnds` is brace-span-not-second and a map spelling stays below.
  if nameIsShapeSpanEnds(name) { return name }
  const rl = monoCompositeListAnnName(name)
  if rl != "" { return rl }
  // A literal-union alias array (`K[]`), the array sibling of the `isUName` arm above and
  // subsumed by the union-alias list rung at the top of this ladder (D1082) — a litunion
  // alias is in `unNames` too. Kept as the rung whose absence a whole family witnessed.
  if nameIsArray(name) {
    const luElem = arrElemNameRaw(name)
    if luElem != "" && isUName(luElem) && nameIsLitUnionType(luElem) {
      return name
    }
  }
  // A `boolean[]` annotation. Its rep is the i32 list exactly (`nameIsI32Array`), so the
  // cascade cannot spell it and the pin has to be a name. Only a genuine `boolean` leaf
  // is claimed; the other i32-backed list spellings keep the cascade's answer.
  if arrElemIs(name, "boolean") { return name }
  // A bare map or Set annotation (`{[K]: V}`). The pin is the whole spelling, character
  // for character what `nodeTyMapName` hands the cascade, so the annotation channel and
  // the recorded-type channel name one instance and cannot mint two. A map-first union is
  // a variant box, and `nameIsBareMap` is the one home of that subtraction.
  if nameIsBareMap(name) { return name }
  // A canonical scalar or scalar-list annotation. The cascade reaches these through the
  // checker's recorded type or a `param*` probe, and both go blind in one position: a
  // generic body's own binding, whose `const y: T = x` carries the substituted annotation
  // and no recorded type while `buildLocals` has yet to run.
  const rs = monoScalarAnnName(name)
  if rs != "" { return rs }
  // A nullable spelling, whose `| null` the pin has to carry.
  monoNulAnnName(name)
}

// A nullable annotation whose non-null base is a spelling `monoAnnPinName` already
// claims, echoed back whole — else "". The nullability rides the pin because the pin is
// the instance's parameter annotation, while every other channel answers about the rep,
// whose nullable is its non-null base by design. The base must echo back unchanged.
function monoNulAnnName(name: string) {
  const base = nullablePartOf(name)
  if base == "" { return "" }
  if monoAnnPinName(base) == base { return name }
  ""
}

// A canonical scalar-rep annotation spelling (`i32` / `i64` / `f32` / `f64` / `boolean`
// / `string`) or a list over one, echoed back — else "". Exact spellings only, and that
// is the safety property: the pin becomes the instance's parameter annotation, so a name
// that is not already the rep's own spelling would rename the rep.
function monoScalarAnnName(name: string) {
  let leaf = name
  if nameIsArray(name) { leaf = arrElemNameRaw(name) }
  if leaf == "i32" { return name }
  if leaf == "i64" { return name }
  if leaf == "f32" { return name }
  if leaf == "f64" { return name }
  if leaf == "boolean" { return name }
  if leaf == "string" { return name }
  ""
}

// The annotation name of an annotated local or parameter whose type is a list over a
// composite element — a nested list, a paren group, an inline shape — or "". The
// `expr*` cascade cannot name these: it reads the expression, and mid-mono the locals
// table is unbuilt, so a nested list pins one dimension short of the checker's type.
function monoCompositeListAnnName(name: string) {
  if !nameIsArray(name) { return "" }
  const elem = arrElemNameRaw(name)
  if elem == "" { return "" }
  if nameIsArray(elem) { return name }
  if nameIsParenSpanEnds(elem) { return name }
  if nameIsBraceSpanEnds(elem) { return name }
  ""
}

// True when the type-annotation node `annIx` is a function-value pin in either spelling
// `monoArgTyName` mints — the bare closure's `$fnsig` marker, or a nullable function
// type. One predicate, so the gate, the name and the banked type agree.
function monoAnnIsCloPin(annIx: i32) {
  if annIx < 0 { return false }
  if sigKeyPinPayload(tyNameOf(annIx)) != "" { return true }
  tyNulFuncInner(nodeTyIxOf(annIx)) >= 0
}

// The type-annotation node of a binding of `fnIx` whose annotation is already a
// monomorphized function-value pin, or -1. The node rather than the name, because both
// halves of the pin live on it: `tyNameOf` is the instance-key spelling and `nodeTyIxOf`
// the `TyFunc` the outer instantiation banked. Param before local; a forwarder has both.
function monoCloPinAnnNodeOf(identName: string, fnIx: i32): i32 {
  if fnIx < 0 { return -1 }
  const ptn = paramTypeNode(fnIx, identName)
  if monoAnnIsCloPin(ptn) { return ptn }
  const ctxFn = P.nodes[fnIx]
  if ctxFn is FuncDecl {
    const li = parentLetOf(ctxFn.fnBody, identName)
    if li >= 0 {
      const ld = P.nodes[li]
      if ld is LetDecl {
        if monoAnnIsCloPin(ld.letType) { return ld.letType }
      }
    }
  }
  -1
}

// `monoCloPinAnnNodeOf` over an EXPRESSION — the Ident unwrap, in one place, so the gate
// and the type-banking helper below cannot ask the question of different nodes.
function monoCloPinAnnNodeOfExpr(ax: i32, fnIx: i32): i32 {
  if ax < 0 { return -1 }
  const n = P.nodes[ax]
  if n is Ident { return monoCloPinAnnNodeOf(n.identName, fnIx) }
  -1
}

// The arena type to bank beside the pin `monoArgTyName` chose for `ix` — the argument's
// own recorded type, except where the pin came from a binding's annotation, in which case
// it is that annotation's type. One home for the `pinTys` entry, so a pin's name and type
// can never be sourced from two different nodes.
export function monoArgPinTyIx(ix: i32, fnIx: i32) {
  const ax = unwrapParen(ix)
  const own = nodeTyIxOf(ax)
  // The node's own recorded type wins wherever it already names a function value (bare
  // or nullable); the annotation channel exists only for the clone whose node carries `T`.
  if own >= 0 && nodeTyIsFunc(ax) { return own }
  if tyNulFuncInner(own) >= 0 { return own }
  const pn = monoCloPinAnnNodeOfExpr(ax, fnIx)
  if pn >= 0 { return nodeTyIxOf(pn) }
  own
}

// True when the spelling `narrow` is a top-level member of the union or nullable spelling
// `wide` — what `wide` narrows to, and not a second rendering of it. Membership is the
// whole safety property of the narrowed pin. `unionArmsOf` resolves an alias to its
// member set; a non-union splits to one atom and is declined. See DECISIONS.md.
function monoNameNarrowsFrom(narrow: string, wide: string) {
  if narrow == "" { return false }
  if narrow == wide { return false }
  if nullablePartOf(wide) == narrow { return true }
  const arms: string[] = []
  unionArmsOf(wide, arms)
  if arms.length < 2 { return false }
  let ai = 0
  while ai < arms.length {
    if arms[ai] == narrow { return true }
    ai = ai + 1
  }
  false
}

// The pin a narrowed argument at `ax` wants, given the pin `wide` the annotation ladder
// chose — else "" (the ladder's answer stands). A pin becomes the instance's parameter
// annotation, so it is safe exactly where a non-generic function carrying that annotation
// already lowers the same program. DECISIONS.md has the channel ruling.
function monoNarrowedPinName(ax: i32, wide: string) {
  if wide == "" { return "" }
  const nt = nodeTyIxOf(ax)
  // A type whose render softens its literals is not a name this test can compare: it
  // reaches the membership test looking like a match on both sides, and the pin then
  // drops from the interned atom to a string ref. `tyRenderSoftensLits` is the home for
  // that hazard, and a litunion argument's pin is claimed by the litunion rungs anyway.
  if tyRenderSoftensLits(nt) { return "" }
  const n = tyToEmitName(nt)
  if !monoNameNarrowsFrom(n, wide) { return "" }
  if monoAnnPinName(n) != n { return "" }
  n
}

// The union name a pin can carry for the node at `ix`, or "". The render, then the
// registry: `tyToEmitName` spells a declared alias as its member set while
// `monoAnnPinName`'s `isUName` rung reads the alias column, so `unRowOfCanon` keys the
// registry on the type's canonical id instead of on a spelling. D1516.
function monoUnionPinName(ix: i32): string {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const r = monoAnnPinName(tyToEmitName(ty))
  if r != "" { return r }
  const ur = unRowOfCanon(ty)
  if ur >= 0 && ur < unNames.length { return monoAnnPinName(unNames[ur]) }
  ""
}

// `monoArgTyName` at a monomorphization pin — the ladder's answer, narrowed to what the
// checker recorded for this node where that is one of the annotation's own members.
// Separate from `monoArgTyName` because `wasmEmit`'s `monoStaticIsResult` also asks that
// one and const-folds on it; narrowing there would fold a guard this pass cannot decide.
function monoArgPinName(ix: i32, fnIx: i32) {
  const w = monoArgTyName(ix, fnIx)
  const n = monoNarrowedPinName(unwrapParen(ix), w)
  if n != "" { return n }
  w
}

export function monoArgTyName(ix: i32, fnIx: i32) {
  const cax = unwrapParen(ix)
  // The third channel, read before both arms below because both need it: an instance's
  // own `x: T` parameter or `const y: T = x` local carries the pin as its annotation, and
  // neither other channel can see it. This is what a generic forwarder hands its inner call.
  const cloPinNode = monoCloPinAnnNodeOfExpr(cax, fnIx)
  // D941 — the fourth channel, the third one's sibling: the instance's own parameter
  // annotation (`paramTypeNode`), gated to a generic application. Every other channel asks
  // the argument node, and a clone shares its leaf expressions, so a forwarded `e`'s
  // recorded type is still the template's. Placed here because arms below `return ""`.
  if cax >= 0 {
    const gaN = P.nodes[cax]
    if gaN is Ident {
      const gaPt = paramTypeNode(fnIx, gaN.identName)
      if gaPt >= 0 {
        const gaAnn = tyNameOf(gaPt)
        if annGenAppSpanEnds(gaAnn) { return gaAnn }
      }
    }
  }
  // D1041 — a fallible numeric `as?` argument (`idn(d as? i32)`) pins at its own recorded
  // `T | null`. Every other channel here asks a binding, and a cast written inline at the
  // call site is none of those. Routed through `monoAnnPinName` so the pin is a spelling
  // the annotation ladder already claims.
  if cax >= 0 {
    const ncqN = P.nodes[cax]
    if ncqN is AsExpr {
      if ncqN.asMode == "null" {
        const ncq = monoAnnPinName(tyToEmitName(nodeTyIxOf(cax)))
        if ncq != "" { return ncq }
      }
    }
  }
  // A nullable function value (kind 19), before the bare-closure arm below and pinned
  // differently on purpose: a bare closure pins the `$fnsig` marker, while
  // `((i32) => i32) | null` is a parameter annotation the emitter already lowers end to
  // end. `tyToEmitName` groups the arrow, which is what makes the pin round-trip.
  let nulFnTy = nodeTyIxOf(cax)
  // A forwarder's own binding again: its node carries `T`, its annotation carries the pin,
  // and for a nullable closure that pin is already the spelling this arm returns.
  if tyNulFuncInner(nulFnTy) < 0 && cloPinNode >= 0 {
    nulFnTy = nodeTyIxOf(cloPinNode)
  }
  if tyNulFuncInner(nulFnTy) >= 0 {
    const nulFnName = tyToEmitName(nulFnTy)
    if nulFnName != "" { return nulFnName }
  }
  // The arena asks the closure question, because `exprIsClosure` cannot ask it here: that
  // predicate resolves through tables `buildLocals` fills post-mono. `nodeTyIsFunc` is the
  // checker's answer and needs no emit-side table. The gates are OR'd, not swapped, since
  // without `cloPinNode` a forwarder's `gid(x)` falls to the same catch-all.
  if exprIsClosure(ix, fnIx) || nodeTyIsFunc(cax) || cloPinNode >= 0 {
    // A function-value argument pins its param as a closure (kind 14). The pinned name
    // carries the callee's `$fnsig` key so the instance's value-call ref-casts to the
    // exact signature.
    const ce = P.nodes[cax]
    if ce is Ident {
      const cfe = fnIndexOf(ce.identName)
      if cfe >= 0 {
        const ck = fnSigKeyOf(cfe)
        if ck != "" { return "=>" + ck }
      }
    }
    // Every other function value — a closure local or param, a struct field, a list or map
    // element, a lambda literal, a call result — keys off the argument's own recorded
    // function type. The named route stays first and unchanged; "" is the loud floor, since
    // a pin that cannot name the signature must not fall through to the i32 catch-all.
    const ak = sigKeyOfTy(nodeTyIxOf(cax))
    if ak != "" { return "=>" + ak }
    // Last: the pin an instance's OWN binding already carries (a generic forwarder).
    if cloPinNode >= 0 { return tyNameOf(cloPinNode) }
    return ""
  }
  // A call argument whose callee has a concrete return annotation takes that annotation.
  // Needed for a generic call used as an argument (`box(box(7))`): `buildFnMap` is
  // post-mono, so `exprStruct` cannot classify the inner call and the type param would
  // default to i32. The instance's already-substituted return annotation resolves it.
  const argN = P.nodes[unwrapParen(ix)]
  if argN is Call {
    const argCallee = P.nodes[argN.callFn]
    if argCallee is Ident {
      const acfe = fnIndexOf(argCallee.identName)
      if acfe >= 0 {
        const acfn = P.nodes[fnStmts[acfe]]
        if acfn is FuncDecl {
          if acfn.fnRet >= 0 {
            // The declared spelling again — this arm tells a concrete return from a
            // parametric one, and a shadowed parameter reads as concrete once canon
            // has resolved it.
            const arn = monoDeclAnnName(
              acfn.fnRet,
              tyNameOf(acfn.fnRet),
              acfn.fnTyParams,
            )
            if arn != "" && !monoAnnHasTyParam(arn, acfn.fnTyParams) {
              return arn
            }
          } else {
            // …and an inferred return is as good a pin as an annotated one:
            // `inferRetNameOf` is the checker's own record, routed through
            // `monoAnnPinName` so the pin is one that ladder claims.
            const irn = inferRetNameOf(argCallee.identName)
            if irn != "" {
              const irp = monoAnnPinName(irn)
              if irp != "" { return irp }
            }
          }
        }
      }
    }
  }
  // An Ident argument bound to a generic-call result (`const inner = box(7); box(inner)`):
  // resolve via its un-annotated `let` init, the local's type table being unbuilt mid-mono.
  // Only a resolved non-i32 type is adopted; a param or non-let ident falls through.
  if argN is Ident {
    if fnIx >= 0 {
      const ctxFn = P.nodes[fnIx]
      if ctxFn is FuncDecl {
        const li = parentLetOf(ctxFn.fnBody, argN.identName)
        if li >= 0 {
          const ld = P.nodes[li]
          if ld is LetDecl {
            // A struct- or struct-array-typed annotated local: read its annotation
            // name directly. `buildLocals` is post-mono, so the `exprStruct` and
            // `exprRefArray` cases below would default the type param to i32.
            if ld.letType >= 0 {
              // A composite-element list local (`xs: i32[][]`, `(i32|null)[]`) is
              // among the spellings `monoAnnPinName` claims: the cascade below either
              // declines it or answers one dimension short.
              const r = monoAnnPinName(tyNameOf(ld.letType))
              if r != "" { return r }
            }
            if ld.letType < 0 && ld.letInit >= 0 {
              // An empty list literal has no element for the recursion to read, and
              // the recursion answers anyway (D764). The checker pinned the binding
              // from its destination, so read the argument reference's recorded type.
              const eln = P.nodes[ld.letInit]
              if eln is ArrayLit {
                if eln.arrElems.length == 0 {
                  const epn = monoAnnPinName(tyToEmitName(nodeTyIxOf(cax)))
                  if epn != "" { return epn }
                }
              }
              const innerTy = monoArgTyName(ld.letInit, fnIx)
              if innerTy != "" && innerTy != "i32" { return innerTy }
              // A refusal propagates: `""` here is one of this ladder's explicit
              // floors, and falling through hands the question back to a cascade that
              // is post-mono blind for a local and answers `"i32"`.
              if innerTy == "" { return "" }
            }
          }
        }
      }
      // A struct-typed param argument (`g(v)` inside a generic body where `v: P`): same as
      // the annotated-local case — read the param annotation, the locals table being unbuilt.
      const ptn = paramTypeNode(fnIx, argN.identName)
      if ptn >= 0 {
        const pt = P.nodes[ptn]
        if pt is TypeRef {
          // The annotated-local arm's param twin — a generic body passing its own
          // `xs: i32[][]` / `boolean[]` / `P` parameter on to a second generic call, the
          // shape a generic forwarder has. One home, so the two cannot drift.
          const r = monoAnnPinName(pt.tyName)
          if r != "" { return r }
        }
      }
    }
    // The module-scope twin of the two arms above, arm for arm. `parentLetOf` is
    // function-scoped and every arm above sits behind `fnIx >= 0`, so a generic call whose
    // argument is a top-level binding reaches none of them; `monoModuleLetOf` declines on a
    // shadow test rather than on `fnIx >= 0`, so a global is readable inside a function too.
    const gli = monoModuleLetOf(argN.identName, fnIx)
    if gli >= 0 {
      const gd = P.nodes[gli]
      if gd is LetDecl {
        if gd.letType >= 0 {
          // The global's annotation, through the one pin membership list — the same
          // call the annotated-local and param arms make, so a generic call pins its
          // instance identically wherever its argument's binding lives.
          const rg = monoAnnPinName(tyNameOf(gd.letType))
          if rg != "" { return rg }
        }
        // The un-annotated global, the other half of the local arm's pair, whose type
        // only its initializer knows. The recursion is the local arm's verbatim,
        // including its two rules on an `"i32"` answer and on a `""` refusal.
        if gd.letType < 0 && gd.letInit >= 0 {
          // The empty-literal rung's module-scope twin (D764) — see the local arm for the
          // ablation and the witness. A rung added to one scope and not the other is the
          // asymmetry this ladder exists to make unstateable.
          const geln = P.nodes[gd.letInit]
          if geln is ArrayLit {
            if geln.arrElems.length == 0 {
              const gepn = monoAnnPinName(tyToEmitName(nodeTyIxOf(cax)))
              if gepn != "" { return gepn }
            }
          }
          const ginner = monoArgTyName(gd.letInit, fnIx)
          if ginner != "" && ginner != "i32" { return ginner }
          if ginner == "" { return "" }
        }
      }
    } else {
      const dpn = monoModuleDupPin(argN.identName, fnIx, cax)
      if dpn != "" { return dpn }
    }
  }
  // An indexed element argument (`id(xs[0])`): the array's own name resolves above through
  // the annotation arms, and the element is that name minus one `[]`. The element goes
  // through `monoAnnPinName`, the same home the array is named through — the two ends of
  // one cut must claim the same spelling set. The peel is `listElemNameOf`.
  if argN is Index {
    const arrTy = monoArgTyName(argN.idxArr, fnIx)
    const an = arrTy.length
    if an >= 3 && nameIsArray(arrTy) {
      const r = monoAnnPinName(listElemNameOf(arrTy))
      if r != "" { return r }
    }
  }
  // A struct-field argument (`id(o.inner)`): resolve the receiver's struct from its
  // annotation, then read the field's struct type name off the struct table (a
  // nested-struct field is code 15, whose `sFieldElemName` is its target struct name).
  // `structIndexOfExpr(o.inner)` would default to i32, the locals table being unbuilt.
  if argN is Member {
    const recvTy = monoArgTyName(argN.memObj, fnIx)
    const rsi = structIndexByName(recvTy)
    if rsi >= 0 {
      const fi = sFieldIndex(rsi, argN.memProp)
      if fi >= 0 && sFieldTypeAt(rsi, fi) == 15 {
        const fnm = sFieldElemNameAt(rsi, fi)
        if isSName(fnm) { return fnm }
      }
    }
    // D1516 — the union-valued field, whose companion column is a member set rather than a
    // struct name, so the code-15 rung above cannot carry it. Asked here, gated to a union
    // so no struct / list / scalar pin is touched, and through `monoAnnPinName` so the
    // answer is a spelling an annotated parameter already lowers.
    if nodeTyIsUnionish(cax) {
      const mun = monoUnionPinName(cax)
      if mun != "" { return mun }
    }
  }
  // A declared litunion argument pins the parameter to the alias, ahead of the string and
  // scalar arms. For a litunion the spelling is the rep: an alias is an interned i32 atom,
  // an inline member set softens to the string ref, and `litUnionAliasNameOfTy` is the one
  // home of that distinction. Without this arm the pin loses the type entirely.
  const luAl = litUnionAliasNameOfTy(nodeTyIxOf(unwrapParen(ix)))
  if luAl != "" { return luAl }
  // The array sibling of the arm above, and it has to sit here: the collection arms spell a
  // litunion array by its rep and `nameIsI32Array` accepts a litunion `K[]`, so `exprArray`
  // pins `i32[]` and binds every `T` mentioning the element to plain i32. See
  // `monoAnnPinName`'s litunion-array arm — the two channels must claim the same shape.
  const luArrTy = nodeTyIxOf(unwrapParen(ix))
  if tyIsLitUnionArray(luArrTy) {
    const luArrT = T.tys[luArrTy]
    if luArrT is TyArray {
      const luElAl = litUnionAliasNameOfTy(luArrT.aElem)
      if luElAl != "" { return luElAl + "[]" }
    }
  }
  // A map or Set argument pins its param as that map — the whole `{[K]:V}` spelling an
  // annotated parameter carries. Before the collection arms, since `exprArray`'s catch-all
  // would otherwise name a map an array; and its arm-nominal form first, since
  // `tyToEmitName` spells a declared union arm structurally and the two mint two (D88).
  const mnArm = nodeMapArmNominalName(unwrapParen(ix))
  if mnArm != "" { return mnArm }
  const mn = nodeTyMapName(unwrapParen(ix))
  if mn != "" { return mn }
  // The string twin of the arm above, blind in the same place for the same reason:
  // `exprString`'s Ident arm reads `declaredString`, a post-mono locals table.
  // `nodeTyIsStringPrim` reads the `TyPrim` variant and its `primName` directly, and being
  // `TyPrim`-only is the narrowing to watch — a literal union canon-softens to `string`.
  if nodeTyIsStringPrim(unwrapParen(ix)) { return "string" }
  if exprString(ix, fnIx) { return "string" }
  if exprStringArray(ix, fnIx) { return "string[]" }
  if exprF64Array(ix, fnIx) { return "f64[]" }
  // The i64 and f32 list arms sit beside the f64 one: the scalar cascade below already
  // names every scalar rep, so without these an `i64[]` / `f32[]` argument falls through
  // to `exprArray`'s catch-all and pins `i32[]`, emitting an instance whose functype reads
  // the i32 list while the caller hands it the i64 or f32 one.
  if exprI64Array(ix, fnIx) { return "i64[]" }
  if exprF32Array(ix, fnIx) { return "f32[]" }
  if exprRefArray(ix, fnIx) {
    // A struct/union-element array: only a literal argument names its element type
    // cheaply; other shapes have no channel here.
    const nd = P.nodes[ix]
    if nd is ArrayLit {
      // A nested list literal over a `boolean` leaf: `arrLitElemName`'s nested-list
      // rung has no boolean member, so `[[true]]` pins `i32[][]`. `nodeTyName` renders
      // the checker's whole array type, which is the pin this site wants.
      const nlt = nodeTyName(ix)
      // The arena: two `TyArray` hops answer directly what two grammar cuts over a render
      // asked. The render is still the pin returned below; only the question moved.
      if nodeTyNestedElemIsBoolPrim(ix) { return nlt }
      return arrLitElemName(ix) + "[]"
    }
    return ""
  }
  if exprArray(ix, fnIx) {
    // A `boolean[]` shares the i32 list rep exactly, so the rep cascade cannot spell it —
    // and a pin is a name, not a rep. The instance's parameter annotation is the only
    // boolean-ness left in a monomorphized body, and `listElemIsBool` recovers the print
    // formatting from it. Only a genuine `boolean` leaf: `tyArrayElemPrimName` is `TyPrim`-only.
    if nodeTyArrayElemIsBoolPrim(ix) { return "boolean[]" }
    return "i32[]"
  }
  if exprUnion(ix, fnIx) {
    // D1516 — the union floor owes the arena one question first, exactly as the struct
    // floor below already asks it: every arm above resolves a union from a binding, so a
    // projection has no channel at all. At the floor, so it re-pins nothing the ladder
    // resolved, and through `monoAnnPinName`, the one pin membership list.
    const upn = monoUnionPinName(unwrapParen(ix))
    if upn != "" { return upn }
    return ""
  }
  if exprNullableStruct(ix, fnIx) { return "" }
  // The variant table, asked before the struct one. `collectS` skips a `type X = {…}` that
  // is a union member, so `type Shape = Circle | Sq` deletes `Circle`'s `sNames` row and
  // mints a variant row. `exprVariantIndex` is `structIndexOfExpr`'s storage-class twin,
  // arm for arm and each leg kind-gated, so the two cannot both answer (D57).
  const avi = exprVariantIndex(ix, fnIx)
  if avi >= 0 && avi < uVariants.length {
    const avn = monoAnnPinName(uVariants[avi])
    if avn != "" { return avn }
  }
  if exprStruct(ix, fnIx) {
    const si = structIndexOfExpr(ix, fnIx)
    if si >= 0 { return sNames[si] }
    // No `sNames` row, but a good spelling — the checker's recorded shape, routed through
    // the one pin membership list, which claims a bare inline object shape (D703). The row
    // goes missing because `collectS` skips a `type X = {…}` that is a union member. At the
    // floor, and `tyToEmitName` rather than `nodeTyName`: `tyToStr` flattens an alias field.
    const shp = monoAnnPinName(tyToEmitName(nodeTyIxOf(unwrapParen(ix))))
    if shp != "" { return shp }
    return ""
  }
  // f32 before f64 — the order `exprIsF32`'s own header states, and which every cell, slot
  // and assign ladder obeys. `exprIsF64` over-claims a mixed f32/float-literal argument
  // (`fv * 1.0` is both), so asking f64 first binds `T` to f64 and the f64 result reaches a
  // site that classifies the call f32. A genuine f64 operand still binds f64 here.
  if exprIsF32(ix, fnIx) { return "f32" }
  if exprIsF64(ix, fnIx) { return "f64" }
  if exprIsI64(ix, fnIx) { return "i64" }
  if exprIsBool(ix, fnIx) { return "boolean" }
  // The `"i32"` catch-all is the defect, not the missing arm (D23): a cascade answering
  // `i32` for a rep it did not recognise mints a wrong instance silently, since the pin
  // becomes the instance's parameter annotation. `""` is the loud floor and beats a wrong
  // instance. Asked last, and narrow: a floor fires only where the answer would be `"i32"`.
  if exprNullableVariant(ix, fnIx) { return "" }
  if exprNullableRefArray(ix, fnIx) { return "" }
  if exprU8Array(ix, fnIx) { return "" }
  "i32"
}

// Build the type-level binding column (`T` ⇒ this instance's concrete type) the way the
// checker does: `bindGenWalk` over each parameter's declared type against the type the
// instance pinned that position at. `tyCol` is positional over `params`, -1 meaning
// "nothing known"; an all -1 column binds nothing and the caller falls back to the names.
function monoBindCols(params: i32[], tyCol: i32[], bN: string[], bT: i32[]) {
  let bi = 0
  while bi < params.length {
    const pp = P.nodes[params[bi]]
    if pp is Param {
      let at = -1
      if bi < tyCol.length { at = tyCol[bi] }
      bindGenWalk(nodeTyIxOf(pp.parType), at, bN, bT)
    }
    bi = bi + 1
  }
  0
}

// Substitute a `LetDecl` annotation `letType` through the instance binding, returning a
// fresh `TypeRef` when a type param substitutes (`T[]` → `f64[]`), else the original node
// index — so a generic body's `const out: T[] = []` lowers against the instance's concrete
// element type, reusing the concrete annotated path rather than per-rep usage inference.
function monoSubstLetType(
  letType: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  if letType < 0 { return letType }
  const tn = P.nodes[letType]
  if tn is TypeRef {
    if monoAnnMentionsTyParam(letType, tn.tyName, typarams) {
      const sub = monoSubstAnn(tn.tyName, typarams, tvN, tvV)
      if sub != "" && sub != tn.tyName {
        // The substituted type, not a re-parse of the substituted name; the name handed
        // to the synthesis is unchanged. Gated on completeness, since `substTyDeep`
        // leaves a parameter it could not bind in place and `tyHasTyVar` sees that.
        let sty = -1
        const origLet = nodeTyIxOf(letType)
        if origLet >= 0 {
          const s2 = substTyDeep(origLet, bN, bT)
          if s2 >= 0 && s2 != origLet {
            if !tyHasTyVar(s2) { sty = s2 }
          }
        }
        return synthTypeRefTy(sub, tn.pos, sty)
      }
    }
  }
  letType
}

// Clone a monomorphized instance's body, substituting every `LetDecl` type-param
// annotation through the binding. Only the statement spine is rebuilt; every leaf
// expression, a nested lambda included, is shared, so no new function node is created.
// Returns the same node index when nothing in the subtree changed.
function monoCloneBody(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  outName: string,
  outType: string,
  outTyIx: i32,
  bN: string[],
  bT: i32[],
) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Block {
    const ns: i32[] = []
    let changed = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoCloneBody(
        n.blkStmts[i],
        typarams,
        tvN,
        tvV,
        outName,
        outType,
        outTyIx,
        bN,
        bT,
      )
      ns.push(cs)
      if cs != n.blkStmts[i] { changed = true }
      i = i + 1
    }
    if !changed { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is LetDecl {
    let nt = monoSubstLetType(n.letType, typarams, tvN, tvV, bN, bT)
    // The inferred-list-return local (`const out = []`): annotate its empty build with the
    // pinned element type, per instance. Clones only this `LetDecl` and its enclosing
    // Block, never the shared original.
    if nt < 0 {
      if outName != "" {
        if n.letName == outName {
          // The out type row is threaded down beside its spelling, so the substituted
          // annotation is minted from the type. Every spelling reaching here is a
          // composite, and `nameToTy` does not hash-cons one.
          nt = synthTypeRefTy(outType, -1, outTyIx)
        }
      }
    }
    if nt == n.letType { return ix }
    return mkLet(n.letKw, n.letName, nt, n.letInit, n.pos)
  }
  if n is WhileStmt {
    const cb = monoCloneBody(
      n.whileBody,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    if cb == n.whileBody { return ix }
    return mkWhile(n.whileCond, cb, n.whileLabel, n.pos)
  }
  if n is IfStmt {
    const ct = monoCloneBody(
      n.ifThen,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    const ce = monoCloneBody(
      n.ifElse,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    if ct == n.ifThen && ce == n.ifElse { return ix }
    return mkIf(n.ifCond, ct, ce, n.pos)
  }
  if n is ForRange {
    const cb = monoCloneBody(
      n.frBody,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    if cb == n.frBody { return ix }
    return mkForRange(n.frVar, n.frFrom, n.frTo, n.frStep, cb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const cb = monoCloneBody(
      n.fiBody,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    if cb == n.fiBody { return ix }
    return mkForIn(n.fiVar, n.fiIter, cb, n.fiLabel, n.pos)
  }
  if n is RetStmt {
    // The return value may be a block or `if` expression carrying its own `LetDecl`s.
    const ca = monoCloneBody(
      n.retArg,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  if n is Paren {
    const ci = monoCloneBody(
      n.parInner,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    if ci == n.parInner { return ix }
    return mkParen(ci, n.pos)
  }
  // A pure expression / other statement carries no `LetDecl` annotation to rewrite — share.
  ix
}

// Whether an inline `.map` callback PRESERVES the element type — its tail expression is
// arithmetic / concatenation over the element (`x => x * 2`, `s => s + "!"`), so the result
// element type equals the source element. Lets the monomorphizer set a concrete map-result
// return annotation, since the inferred-return path has no f64/string-array map-result form.
function monoLambdaPreservesElem(argIx: i32) {
  const fnNodeIx = unwrapParen(argIx)
  const a = P.nodes[fnNodeIx]
  if a is FuncDecl {
    const tail = fnRetExprOf(fnNodeIx)
    if tail >= 0 {
      const t = P.nodes[unwrapParen(tail)]
      if t is BinExpr {
        const op = t.binOp
        return op == "+" || op == "-" || op == "*" || op == "/"
      }
    }
  }
  false
}

// The element type of `recvIx` when it is (a paren around) a parameter reference whose
// pinned type is an array — looked up in the instance's (pNames → pElems) map; "" for
// anything else. Pins a `.map`/`.filter` callback's element from this instance's receiver.
function monoRecvParamElem(
  recvIx: i32,
  pNames: string[],
  pElems: string[],
  pElemTys: i32[],
  outTy: i32[],
) {
  const r = P.nodes[unwrapParen(recvIx)]
  if r is Ident {
    let i = 0
    while i < pNames.length {
      if pNames[i] == r.identName {
        // The element row rides out beside the element name, from the column built
        // parallel to `pElems`, so the caller never has to recover the row by re-parsing
        // the name this returns.
        if i < pElemTys.length { outTy.push(pElemTys[i]) }
        return pElems[i]
      }
      i = i + 1
    }
  }
  ""
}

// Clone an inline `.map`/`.filter` callback lambda with its single un-annotated parameter
// pinned to `elemType`, lift the clone into `fnStmts`, and return its node index — or -1
// when the argument is not a cloneable un-annotated 1-param lambda. The body is shared:
// the emitter re-derives every operand type from the now-concrete parameter per function.
function monoCloneLambdaPinned(argIx: i32, elemType: string, elemTyIx: i32) {
  const a = P.nodes[unwrapParen(argIx)]
  if a is FuncDecl {
    if a.fnParams.length == 1 {
      const p0 = P.nodes[a.fnParams[0]]
      if p0 is Param {
        if p0.parType < 0 {
          const np = mkParam(
            p0.parName,
            synthTypeRefTy(elemType, -1, elemTyIx),
            p0.parDefault,
            p0.parOpt,
            p0.pos,
          )
          // The pinned element row is handed over rather than re-parsed out of the
          // element name: `pElemTys` is built beside `pElems` from the same pin, so the
          // row reaches this mint without the name being turned back into a type.

          const nm = "__lambda_" + i32ToStr(lambdaCtr)
          lambdaCtr = lambdaCtr + 1
          const noTP: string[] = []
          const ps: i32[] = [np]
          const clone = mkFunc(nm, noTP, ps, a.fnRet, a.fnBody, a.pos)
          fnStmts.push(clone)
          fnParent.push(-1)
          fnDispNames.push("")
          fnValUsed = true
          return clone
        }
      }
    }
  }
  -1
}

// ── a lambda declared inside a generic body is a template (D426) ─────────────

// `collectFns` runs before `monomorphize` and lifts `const g = (x: T[]) => …` once, with
// the enclosing function's `T` still on its parameters, so one lifted slot serves every
// instance at the unsubstituted type. The two sites below close that: substitute at the
// pin, and stop emitting the template (the prune at the end of `monomorphize`).

// One annotation node, substituted through this instance's binding: a fresh `TypeRef`
// when a type parameter substitutes (`T[]` → `f64[]`), or -1 for "nothing to do" — the
// annotation is absent, already concrete, or names a type parameter this instance could
// not bind. The substituted type rides along, gated on `tyHasTyVar` as at every such site.
function monoSubstAnnNode(
  pty: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  if pty < 0 { return -1 }
  const tn = P.nodes[pty]
  if tn is TypeRef {
    // The RAW spelling where a type parameter is shadowed by a declared alias — the same
    // read every other substitution site in this file takes, for `monoDeclAnnName`'s reason.
    const ann = monoDeclAnnName(pty, tn.tyName, typarams)
    if monoAnnHasTyParam(ann, typarams) {
      const sub = monoSubstAnn(ann, typarams, tvN, tvV)
      // -2, not -1: the annotation does name a type parameter and the substitution
      // produced no new spelling for it, which the caller must tell apart from an
      // already-concrete one: the prune must not stub a template still called by name.
      if sub == "" { return -2 }
      if sub == tn.tyName { return -2 }
      let sty = -1
      const orig = nodeTyIxOf(pty)
      if orig >= 0 {
        const s2 = substTyDeep(orig, bN, bT)
        if s2 >= 0 && s2 != orig {
          if !tyHasTyVar(s2) { sty = s2 }
        }
      }
      return synthTypeRefTy(sub, tn.pos, sty)
    }
  }
  -1
}

// Membership in one of the two lambda-template ledgers. Linear, and that is the right shape: a
// program holds a handful of such templates, and a set would be a hash table for three entries.
function monoI32ListHas(xs: i32[], v: i32) {
  let i = 0
  while i < xs.length {
    if xs[i] == v { return true }
    i = i + 1
  }
  false
}

function monoNoteLamNode(xs: i32[], v: i32) {
  if !monoI32ListHas(xs, v) { xs.push(v) }
  0
}

// D1116 — the lifted slots minted while walking one lambda's body belong to that lambda's
// clone, not to the enclosing instance: a nested clone's free names resolve up the chain
// through the lambda that encloses it, and `captureValKind` types an env field by that
// chain. Re-point the run from `mark` on, then retire each entry so nothing undoes it.
function monoReparentNestedLams(mark: i32, parentSlot: i32) {
  let k = mark
  let wrote = false
  while k < monoLamMintedSlots.length {
    const s = monoLamMintedSlots[k]
    if s >= 0 && s < fnParent.length {
      fnParent[s] = parentSlot
      wrote = true
    }
    // arena-tick exempt: this module's own scratch list of slots already re-pointed, read by no pass.
    monoLamMintedSlots[k] = -1
    k = k + 1
  }
  if wrote {
    monoArenaTouch()
    invalidateFnChildIndex()
  }
  0
}

// The lexical frame a lifted function's slot records (`fnParent`), found from its arena node.
// -1 when the node holds no lifted slot, which is the value `collectFns` itself pushes for a
// module-scope lift.
function monoLamParentOf(fnIx: i32) {
  let i = 0
  while i < fnStmts.length {
    if fnStmts[i] == fnIx {
      if i < fnParent.length { return fnParent[i] }
      return -1
    }
    i = i + 1
  }
  -1
}

// Clone the lifted lambda at `fnIx` with every type-param-mentioning parameter and return
// annotation substituted through this instance's binding, lift the clone into `fnStmts`,
// and return its node index — or -1 when nothing substitutes. The body is shared with the
// original: the emitter re-derives every operand type from the now-concrete parameter.
function monoCloneLambdaSubst(
  fnIx: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  const a = P.nodes[fnIx]
  if a is FuncDecl {
    // A nested generic declaration carries pins of its own and is instantiated by
    // `monoInstantiate` at its own call sites; only a lambda that inherited the enclosing
    // frame's type parameters is this pass's business.
    if a.fnTyParams.length > 0 { return -1 }
    // Not a template at all — every annotation is concrete, so one lifted function is
    // correct at every pin. Returned before either ledger is touched: the prune reads them
    // to decide whether a template is still referenced, and a lambda that never became a
    // template must not appear in either.
    if !monoLamNodeIsTemplate(fnIx, typarams) { return -1 }
    const ps: i32[] = []
    let any = false
    let i = 0
    while i < a.fnParams.length {
      const p = P.nodes[a.fnParams[i]]
      if p is Param {
        const nt = monoSubstAnnNode(p.parType, typarams, tvN, tvV, bN, bT)
        if nt >= 0 {
          ps.push(mkParam(p.parName, nt, p.parDefault, p.parOpt, p.pos))
          any = true
        } else if nt == -2 {
          // The annotation names a type parameter this instance cannot substitute. The
          // template stays, this instance keeps calling it, and the `checkParams` floor
          // refuses loudly — which is why the prune has to be told.
          monoNoteLamNode(monoLamShared, fnIx)
          return -1
        } else {
          // Unchanged — share the original `Param` node, so a lambda with one generic and
          // one concrete parameter mints exactly one node.
          ps.push(a.fnParams[i])
        }
      } else {
        monoNoteLamNode(monoLamShared, fnIx)
        return -1
      }
      i = i + 1
    }
    let nret = a.fnRet
    const rt = monoSubstAnnNode(a.fnRet, typarams, tvN, tvV, bN, bT)
    if rt >= 0 {
      nret = rt
      any = true
    } else if rt == -2 {
      monoNoteLamNode(monoLamShared, fnIx)
      return -1
    }
    // D943 — `any` asks whether a signature changed, and a capture-only template changes
    // none. The clone still has to happen: its purpose here is a fresh lifted slot, since
    // `fnEnvIdx` is parallel to `fnStmts` and one slot means one env struct for every
    // instance. `() => string` capturing a `T` substitutes nothing and needs its own env.
    let capOnly = false
    if !any {
      const feC = monoSlotOfLamNode(fnIx)
      if feC >= 0 {
        if captureCountOf(feC) > 0 { capOnly = true }
      }
    }
    // D1220 — a body spelling is the third reason to clone, and the two rungs above read
    // only the signature: `() => gv is T` takes no parameter, annotates no return and
    // captures nothing. Sharing one body then answers the first pin's spelling at every
    // pin. `monoLamNodeIsTemplate`'s fourth rung asks the same question and must agree.
    let bodyTP = false
    if !any && !capOnly {
      if monoNodeNamesTyParam(a.fnBody, typarams) { bodyTP = true }
    }
    if !any && !capOnly && !bodyTP {
      monoNoteLamNode(monoLamShared, fnIx)
      return -1
    }
    // An un-annotated return that rides the type parameter, annotated at the pin. The
    // checker records an anonymous lambda's inferred return under its node index and the
    // clone is a node it never saw, so the return expression's own recorded type is the
    // fact, substituted through the same binding. Gated on the type carrying a variable.
    if nret < 0 {
      const rex = fnRetExprOf(fnIx)
      if rex >= 0 {
        const rty = nodeTyIxOf(rex)
        if rty >= 0 {
          if tyHasTyVar(rty) {
            const rs = substTyDeep(rty, bN, bT)
            if rs >= 0 && rs != rty {
              if !tyHasTyVar(rs) {
                const rnm = tyToEmitName(rs)
                if rnm != "" { nret = synthTypeRefTy(rnm, -1, rs) }
              }
            }
          }
        }
      }
    }
    // D1046 — a nested named function keeps its name. An anonymous lambda is reached
    // through the value the clone is written into, so a minted `__lambda_N` is invisible;
    // a nested `function id(a: T): T` is reached by name through the frame chain, and
    // renaming it would leave every call in the instance body resolving to nothing.
    let nm = a.fnName
    if !monoFnNameIsSourceNamed(nm) {
      nm = "__lambda_" + i32ToStr(lambdaCtr)
      lambdaCtr = lambdaCtr + 1
    }
    const noTP: string[] = []
    // D951 — an `is T` inside the lambda's body. The body is otherwise shared with the
    // template, which is right for every operand the emitter re-derives from the
    // now-concrete parameter and wrong for an `is`, whose check type is a spelling the
    // body carries. Copy-on-write, so a lambda with no such spelling keeps sharing.
    const nbodyF = monoFoldTyParamLayout(a.fnBody, typarams, tvN, tvV)
    // D1116 — a lambda nested inside this one is a template too, and `monoPinBodyLambdas`
    // walks only the instance body's spine, stopping at a `FuncDecl` initializer.
    // Recursing here rather than teaching that walk a `FuncDecl` arm keeps the two facts a
    // clone owns together: the body substitution above and the frame its clones hang off.
    const mark = monoLamMintedSlots.length
    const nbody = monoPinBodyLambdas(nbodyF, typarams, tvN, tvV, bN, bT)
    // The lambda twin of the named clone's rule: a bare `return` in the body is void, so the
    // return-expression pin above must not give this instance a result (D1600).
    let cloneRet = nret
    if a.fnRet < 0 && blockHasBareReturn(a.fnBody) { cloneRet = -1 }
    const clone = mkFunc(nm, noTP, ps, cloneRet, nbody, a.pos)
    // D1046 — the first instance of a named nested function replaces the template's slot
    // rather than pushing beside it: the by-name lookup takes the first child of the
    // frame, so two same-named children mean the call answers the unsubstituted template.
    // Later instances push and are re-pointed at their own frame by the caller.
    if monoFnNameIsSourceNamed(a.fnName) && monoInstIsFirst {
      const tSlot = monoSlotOfLamNode(fnIx)
      if tSlot >= 0 {
        fnStmts[tSlot] = clone
        monoArenaTouch()
        monoNamedTmplNode.push(fnIx)
        monoNamedTmplSlot.push(tSlot)
        monoReparentNestedLams(mark, tSlot)
        fnValUsed = true
        monoNoteLamNode(monoLamPinned, fnIx)
        return clone
      }
    }
    fnStmts.push(clone)
    // The original's frame, not module scope. The clone shares the body, so its free names
    // have to resolve up the same scope chain or a lambda that both captures and annotates
    // `T` loses its environment. (`monoCloneLambdaPinned` pushes -1 because a `.map`
    // callback is rebuilt from an argument position, not from a lifted slot of its own.)
    fnParent.push(monoLamParentOf(fnIx))
    const mySlot = fnStmts.length - 1
    monoReparentNestedLams(mark, mySlot)
    monoLamMintedSlots.push(mySlot)
    fnDispNames.push("")
    fnValUsed = true
    monoNoteLamNode(monoLamPinned, fnIx)
    return clone
  }
  -1
}

// Per-instance lambda monomorphization for a lambda bound in a generic body — the
// annotated sibling of `monoPinMapLambdas`. Walks the instance's statement spine and, at
// a `LetDecl` whose initializer is a lifted lambda still mentioning a type parameter,
// substitutes at this pin and repoints the binding at the clone. Copy-on-write.
function monoPinBodyLambdas(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  if ix < 0 { return ix }
  if typarams.length == 0 { return ix }
  const n = P.nodes[ix]
  if n is Block {
    const ns: i32[] = []
    let changed = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoPinBodyLambdas(n.blkStmts[i], typarams, tvN, tvV, bN, bT)
      ns.push(cs)
      if cs != n.blkStmts[i] { changed = true }
      i = i + 1
    }
    if !changed { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is LetDecl {
    if n.letInit >= 0 {
      const iv = P.nodes[n.letInit]
      if iv is FuncDecl {
        const cl = monoCloneLambdaSubst(n.letInit, typarams, tvN, tvV, bN, bT)
        if cl < 0 { return ix }
        return mkLet(n.letKw, n.letName, n.letType, cl, n.pos)
      }
    }
    const ci = monoPinBodyLambdas(n.letInit, typarams, tvN, tvV, bN, bT)
    if ci == n.letInit { return ix }
    return mkLet(n.letKw, n.letName, n.letType, ci, n.pos)
  }
  // D1046 — a nested named `function` statement is the declaration form of the same
  // thing, and `collectFns` lifts it exactly like a lambda. The statement itself emits
  // nothing (`wasmEmit.emitStmt`'s `FuncDecl` arm), so the node returned is immaterial —
  // the lifted slot is the whole effect, and the statement is returned unchanged.
  if n is FuncDecl {
    if monoFnNameIsSourceNamed(n.fnName) {
      monoCloneLambdaSubst(ix, typarams, tvN, tvV, bN, bT)
    }
    return ix
  }
  if n is RetStmt {
    const ca = monoPinBodyLambdas(n.retArg, typarams, tvN, tvV, bN, bT)
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  // D943 — an object literal's field value is a position a lambda is written in:
  // `return { actual: value, show: () => … }` is the shape a generic builder has, a struct
  // carrying both the `T` value and a closure over it. Recurses as well as rewriting, so a
  // lambda nested deeper inside the literal is reached too.
  if n is ObjLit {
    const fs: i32[] = []
    let fchanged = false
    let fi = 0
    while fi < n.objFields.length {
      const fnode = P.nodes[n.objFields[fi]]
      let outF = n.objFields[fi]
      if fnode is FieldInit {
        const fv = P.nodes[fnode.fiValue]
        let nv = fnode.fiValue
        if fv is FuncDecl {
          const fcl = monoCloneLambdaSubst(
            fnode.fiValue,
            typarams,
            tvN,
            tvV,
            bN,
            bT,
          )
          if fcl >= 0 { nv = fcl }
        } else {
          nv = monoPinBodyLambdas(fnode.fiValue, typarams, tvN, tvV, bN, bT)
        }
        if nv != fnode.fiValue {
          outF = mkFieldInit(fnode.fiName, nv, fnode.pos)
          fchanged = true
        }
      }
      fs.push(outF)
      fi = fi + 1
    }
    if !fchanged { return ix }
    return mkObjLit(fs, n.pos)
  }
  if n is WhileStmt {
    const cb = monoPinBodyLambdas(n.whileBody, typarams, tvN, tvV, bN, bT)
    if cb == n.whileBody { return ix }
    return mkWhile(n.whileCond, cb, n.whileLabel, n.pos)
  }
  if n is IfStmt {
    const ct = monoPinBodyLambdas(n.ifThen, typarams, tvN, tvV, bN, bT)
    const ce = monoPinBodyLambdas(n.ifElse, typarams, tvN, tvV, bN, bT)
    if ct == n.ifThen && ce == n.ifElse { return ix }
    return mkIf(n.ifCond, ct, ce, n.pos)
  }
  if n is ForRange {
    const cb = monoPinBodyLambdas(n.frBody, typarams, tvN, tvV, bN, bT)
    if cb == n.frBody { return ix }
    return mkForRange(n.frVar, n.frFrom, n.frTo, n.frStep, cb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const cb = monoPinBodyLambdas(n.fiBody, typarams, tvN, tvV, bN, bT)
    if cb == n.fiBody { return ix }
    return mkForIn(n.fiVar, n.fiIter, cb, n.fiLabel, n.pos)
  }
  if n is Paren {
    const ci = monoPinBodyLambdas(n.parInner, typarams, tvN, tvV, bN, bT)
    if ci == n.parInner { return ix }
    return mkParen(ci, n.pos)
  }
  ix
}

// The type parameters of every enclosing lifted frame of `fe`, appended to `out`. The
// chain is `fnParent`; each frame's original declaration carries the `<T>`, because
// `fnStmts[p]` may already hold that generic's first instance. Bounded by the function
// count, so it terminates even should `fnParent` ever contain a cycle.
function monoEnclosingTyParams(fe: i32, out: string[]) {
  let p = -1
  if fe < fnParent.length { p = fnParent[fe] }
  let guard = 0
  while p >= 0 && guard <= fnStmts.length {
    let nd = -1
    if p < monoOrigNode.length { nd = monoOrigNode[p] }
    else if p < fnStmts.length { nd = fnStmts[p] }
    if nd >= 0 {
      const fn = P.nodes[nd]
      if fn is FuncDecl {
        let i = 0
        while i < fn.fnTyParams.length {
          out.push(fn.fnTyParams[i])
          i = i + 1
        }
      }
    }
    if p < fnParent.length { p = fnParent[p] } else { p = -1 }
    guard = guard + 1
  }
  0
}

// Does the subtree at `ix` carry a spelling `monoFoldTyParamLayout` substitutes — an `is`
// whose check type mentions a type parameter, or a `T.field` layout constant? Those are
// the two places a type parameter reaches the emitter as source text. Walked through
// `nodeChildren` rather than a second copy of the fold's arm ladder, which would drift.
function monoNodeNamesTyParam(ix: i32, typarams: string[]) {
  if ix < 0 || ix >= P.nodes.length { return false }
  if typarams.length == 0 { return false }
  const n = P.nodes[ix]
  if n is IsExpr {
    if monoAnnHasTyParam(n.isVariant, typarams) { return true }
  }
  if n is Member {
    const mo = P.nodes[n.memObj]
    if mo is Ident {
      if monoTyParamOf(mo.identName, typarams) != "" { return true }
    }
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if monoNodeNamesTyParam(kids[i], typarams) { return true }
    i = i + 1
  }
  false
}

function monoLamNodeIsTemplate(fnIx: i32, typarams: string[]) {
  if typarams.length == 0 { return false }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    if fn.fnTyParams.length > 0 { return false }
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param {
        if p.parType >= 0 {
          const ann = monoDeclAnnName(p.parType, tyNameOf(p.parType), typarams)
          if monoAnnHasTyParam(ann, typarams) { return true }
        }
      }
      i = i + 1
    }
    if fn.fnRet >= 0 {
      const rann = monoDeclAnnName(fn.fnRet, tyNameOf(fn.fnRet), typarams)
      if monoAnnHasTyParam(rann, typarams) { return true }
    }
    // D943 — a capture is part of a lambda's effective signature, and the two checks above
    // read only the written one: `show: () => string` inside `mk<T>` takes no parameter and
    // returns a concrete type while capturing `value: T`. One lifted slot means one env
    // struct, so it is asked as "does it capture at all" — an extra clone is a correct one.
    const feIx = monoSlotOfLamNode(fnIx)
    if feIx >= 0 {
      if captureCountOf(feIx) > 0 { return true }
    }
    // D1220 — the fourth rung: a type parameter named in the body. The three above read the
    // written signature and the capture count, and `() => gv is T` mentions `T` in none of
    // them — only in the `is` spelling, which `monoFoldTyParamLayout` substitutes per pin.
    // Broad on purpose: an extra clone is a correct clone, only larger.
    if monoNodeNamesTyParam(fn.fnBody, typarams) { return true }
  }
  false
}

// Is the lifted slot `fe` a lambda template — an annotation still naming a type parameter
// of an enclosing generic frame? Every instantiation of that frame mints its own copy, so
// nothing in the module refers to this slot and the prune at the end of `monomorphize`
// stubs it. Without this rung the template is emitted whether or not an instance exists.
function monoLamSlotIsTyParamTemplate(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return false }
  const tps: string[] = []
  monoEnclosingTyParams(fe, tps)
  monoLamNodeIsTemplate(fnStmts[fe], tps)
}

// Has any enclosing frame of lifted slot `fe` been instantiated? A template whose generic
// no call site ever pinned has no live reference: the generic's own slot is stubbed by the
// arm above in this same loop, and the body that named the lambda goes with it. Bounded
// by the function count, like every other `fnParent` walk here.
function monoLamFrameInstantiated(fe: i32) {
  let p = -1
  if fe < fnParent.length { p = fnParent[fe] }
  let guard = 0
  while p >= 0 && guard <= fnStmts.length {
    if monoInstantiatedAny(p) { return true }
    if p < fnParent.length { p = fnParent[p] } else { p = -1 }
    guard = guard + 1
  }
  false
}

// Per-instance lambda monomorphization for `.map`/`.filter`. An inline callback's
// un-annotated param defaults to i32 at emit, correct only for the i32 shape, so when
// this instance pins the receiver param to a non-i32 element the callback is cloned with
// its param pinned to that element and the call rebuilt to reference the clone.
function monoPinMapLambdas(
  ix: i32,
  pNames: string[],
  pElems: string[],
  pElemTys: i32[],
) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Block {
    const ns: i32[] = []
    let changed = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoPinMapLambdas(n.blkStmts[i], pNames, pElems, pElemTys)
      ns.push(cs)
      if cs != n.blkStmts[i] { changed = true }
      i = i + 1
    }
    if !changed { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is RetStmt {
    const ca = monoPinMapLambdas(n.retArg, pNames, pElems, pElemTys)
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  if n is LetDecl {
    const ci = monoPinMapLambdas(n.letInit, pNames, pElems, pElemTys)
    if ci == n.letInit { return ix }
    return mkLet(n.letKw, n.letName, n.letType, ci, n.pos)
  }
  if n is WhileStmt {
    const cb = monoPinMapLambdas(n.whileBody, pNames, pElems, pElemTys)
    if cb == n.whileBody { return ix }
    return mkWhile(n.whileCond, cb, n.whileLabel, n.pos)
  }
  if n is IfStmt {
    const ct = monoPinMapLambdas(n.ifThen, pNames, pElems, pElemTys)
    const ce = monoPinMapLambdas(n.ifElse, pNames, pElems, pElemTys)
    if ct == n.ifThen && ce == n.ifElse { return ix }
    return mkIf(n.ifCond, ct, ce, n.pos)
  }
  if n is ForRange {
    const cb = monoPinMapLambdas(n.frBody, pNames, pElems, pElemTys)
    if cb == n.frBody { return ix }
    return mkForRange(n.frVar, n.frFrom, n.frTo, n.frStep, cb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const cb = monoPinMapLambdas(n.fiBody, pNames, pElems, pElemTys)
    if cb == n.fiBody { return ix }
    return mkForIn(n.fiVar, n.fiIter, cb, n.fiLabel, n.pos)
  }
  if n is Paren {
    const ci = monoPinMapLambdas(n.parInner, pNames, pElems, pElemTys)
    if ci == n.parInner { return ix }
    return mkParen(ci, n.pos)
  }
  if n is Call {
    let newCallee = n.callFn
    const callee = P.nodes[n.callFn]
    // A `<paramRecv>.map/.filter(<lambda>)` over a concrete non-i32 element: pin the callback.
    if callee is Member {
      const recvNew = monoPinMapLambdas(callee.memObj, pNames, pElems, pElemTys)
      if recvNew != callee.memObj {
        newCallee = mkMember(recvNew, callee.memProp, callee.pos)
      }
      if callee.memProp == "map" || callee.memProp == "filter" {
        if n.callArgs.length == 1 {
          const elemTyOut: i32[] = []
          const elem = monoRecvParamElem(
            callee.memObj,
            pNames,
            pElems,
            pElemTys,
            elemTyOut,
          )
          if elem != "" && elem != "i32" {
            let elemTy = -1
            if elemTyOut.length > 0 { elemTy = elemTyOut[0] }
            const cloned = monoCloneLambdaPinned(n.callArgs[0], elem, elemTy)
            if cloned >= 0 {
              const oneArg: i32[] = [cloned]
              return mkCallN(newCallee, oneArg, n.callArgNames, n.pos)
            }
          }
        }
      }
    }
    const nargs: i32[] = []
    let changed = newCallee != n.callFn
    let ai = 0
    while ai < n.callArgs.length {
      const cca = monoPinMapLambdas(n.callArgs[ai], pNames, pElems, pElemTys)
      nargs.push(cca)
      if cca != n.callArgs[ai] { changed = true }
      ai = ai + 1
    }
    if !changed { return ix }
    return mkCallN(newCallee, nargs, n.callArgNames, n.pos)
  }
  ix
}

// Rebuild the name→index map, the voidness/return-kind inference and `collectA`'s rep rows
// after a new instance lands in `fnStmts`: a pinned `string[]`/`f64` annotation forces types
// the original generic name never did. All four read the arena and nothing else, so an
// unmoved stamp means the state they would produce is the state already in hand.
function monoRebuild() {
  const stamp = monoArenaStamp()
  if stamp == monoRebuiltStamp { return 0 }
  if collectA(monoProgStmts) < 0 { return -1 }
  if buildFnMap(monoProgStmts) < 0 { return -1 }
  computeVoidFns()
  computeRetInference()
  monoRebuiltStamp = stamp
  0
}

// The parameter an un-annotated `return <local>` list is built from: a
// `<retName>.push(<param>[<idx>])` statement anywhere in `blockIx`. The built list shares
// the indexed param's array type, so the monomorphizer types the un-annotated return as
// that param's pinned type. "" = none found.
function monoListSrcParam(blockIx: i32, retName: string) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      const r = monoListSrcParamStmt(stmts[i], retName)
      if r != "" { return r }
      i = i + 1
    }
  }
  ""
}

function monoListSrcParamStmt(ix: i32, retName: string) {
  const s = P.nodes[ix]
  if s is Block { return monoListSrcParam(ix, retName) }
  if s is WhileStmt { return monoListSrcParam(s.whileBody, retName) }
  if s is ForRange { return monoListSrcParam(s.frBody, retName) }
  if s is ForIn { return monoListSrcParam(s.fiBody, retName) }
  if s is IfStmt {
    const rt = monoListSrcParam(s.ifThen, retName)
    if rt != "" { return rt }
    if s.ifElse >= 0 { return monoListSrcParamStmt(s.ifElse, retName) }
    return ""
  }
  // A `<retName>.push(<param>[<idx>])` statement: the param is the list's element source.
  if s is Call {
    const callee = P.nodes[s.callFn]
    if callee is Member {
      if callee.memProp == "push" {
        const recv = P.nodes[callee.memObj]
        if recv is Ident {
          if recv.identName == retName {
            if s.callArgs.length == 1 {
              const arg = P.nodes[s.callArgs[0]]
              if arg is Index {
                const ia = P.nodes[arg.idxArr]
                if ia is Ident { return ia.identName }
              }
            }
          }
        }
      }
    }
  }
  ""
}

// Callback specialization: rewrite every call through a closure-typed param in a cloned
// instance body into a direct call to the concrete non-capturing function this instance
// carries. The closure value is still passed, so non-call uses keep working;
// a param with `cbFnNames == ""` leaves its calls as `call_ref`.
function monoBakeCallback(
  ix: i32,
  cbParamNames: string[],
  cbFnNames: string[],
) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Block {
    const ns: i32[] = []
    let changed = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoBakeCallback(n.blkStmts[i], cbParamNames, cbFnNames)
      ns.push(cs)
      if cs != n.blkStmts[i] { changed = true }
      i = i + 1
    }
    if !changed { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is RetStmt {
    const ca = monoBakeCallback(n.retArg, cbParamNames, cbFnNames)
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  if n is LetDecl {
    const ci = monoBakeCallback(n.letInit, cbParamNames, cbFnNames)
    if ci == n.letInit { return ix }
    return mkLet(n.letKw, n.letName, n.letType, ci, n.pos)
  }
  if n is WhileStmt {
    const cb = monoBakeCallback(n.whileBody, cbParamNames, cbFnNames)
    if cb == n.whileBody { return ix }
    return mkWhile(n.whileCond, cb, n.whileLabel, n.pos)
  }
  if n is IfStmt {
    const ct = monoBakeCallback(n.ifThen, cbParamNames, cbFnNames)
    const ce = monoBakeCallback(n.ifElse, cbParamNames, cbFnNames)
    if ct == n.ifThen && ce == n.ifElse { return ix }
    return mkIf(n.ifCond, ct, ce, n.pos)
  }
  if n is ForRange {
    const cb = monoBakeCallback(n.frBody, cbParamNames, cbFnNames)
    if cb == n.frBody { return ix }
    return mkForRange(n.frVar, n.frFrom, n.frTo, n.frStep, cb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const cb = monoBakeCallback(n.fiBody, cbParamNames, cbFnNames)
    if cb == n.fiBody { return ix }
    return mkForIn(n.fiVar, n.fiIter, cb, n.fiLabel, n.pos)
  }
  if n is Paren {
    const ci = monoBakeCallback(n.parInner, cbParamNames, cbFnNames)
    if ci == n.parInner { return ix }
    return mkParen(ci, n.pos)
  }
  if n is Call {
    // A call whose callee names a specialized closure param `f(...)` → direct call `cbFn(...)`;
    // its arguments may themselves contain such calls (`f(g(x))`), so recurse there too.
    let newCallee = n.callFn
    const callee = P.nodes[n.callFn]
    if callee is Ident {
      let bk = 0
      while bk < cbParamNames.length {
        if cbFnNames[bk] != "" && callee.identName == cbParamNames[bk] {
          newCallee = mkIdent(cbFnNames[bk], callee.pos)
        }
        bk = bk + 1
      }
    }
    const nargs: i32[] = []
    let changed = newCallee != n.callFn
    let ai = 0
    while ai < n.callArgs.length {
      const cca = monoBakeCallback(n.callArgs[ai], cbParamNames, cbFnNames)
      nargs.push(cca)
      if cca != n.callArgs[ai] { changed = true }
      ai = ai + 1
    }
    if !changed { return ix }
    return mkCallN(newCallee, nargs, n.callArgNames, n.pos)
  }
  if n is BinExpr {
    // Descend into a plain assignment or arithmetic node (`acc = f(acc, x)`, the
    // reduce/fold shape). A compound-assignment node is left intact — rebuilding it
    // through `mkBinary` would drop its surface tag, and its call stays a `call_ref`.
    if n.binCompound != "" { return ix }
    const cl = monoBakeCallback(n.binLeft, cbParamNames, cbFnNames)
    const cr = monoBakeCallback(n.binRight, cbParamNames, cbFnNames)
    if cl == n.binLeft && cr == n.binRight { return ix }
    return mkBinary(n.binOp, cl, cr, n.pos)
  }
  ix
}

// Whether `name` resolves to a lifted slot the pre-pass flagged generic — the condition
// under which `monoWalk` reaches `monoInstantiate` and renames a callee `Ident` in place.
// An appended instance slot (past the frozen `monoGen` length) is concrete.
function monoCalleeIsGeneric(name: string) {
  const fe = fnIndexOf(name)
  if fe < 0 { return false }
  if fe >= monoGen.length { return false }
  monoGen[fe] == 1
}

// ── the `is` node's per-instance twin ────────────────────────────────────────

// Four walkers re-mint or substitute an `IsExpr`, and all go through here: minting an
// `is` has a second half the `mk*` maker does not do. `isVarTyIx` — the check type the
// checker banked at the original — is keyed by node and sized at `checkProgram` entry, so
// a freshly minted node reads -1 for ever unless it is banked, demoting `emitIs` to names.
function monoMkIsExprLike(ix: i32, io: i32, variant: string) {
  const n = P.nodes[ix]
  if n is IsExpr {
    if n.isNeg == 1 { return mkIsExprNeg(io, variant, n.pos) }
    return mkIsExpr(io, variant, n.pos)
  }
  -1
}
// Re-parent onto the rewritten receiver `io`: the same test, so the banked row carries.
function monoReIsExpr(ix: i32, io: i32) {
  const n = P.nodes[ix]
  if n is IsExpr {
    const nx = monoMkIsExprLike(ix, io, n.isVariant)
    recordClonedIsVarTyIx(nx, isVarTyIxOf(ix))
    return nx
  }
  ix
}
// D951 — `is T` against the type parameter itself. Under monomorphization `T` is concrete
// per instance, so substituting the spelling makes `y is T` at `T := i32` the same program
// as `y is i32` and the whole existing ladder applies unchanged. The banked row must come
// from the new spelling: the original's is the declaration's `TyVar`, which renders empty.
function monoSubstIsExpr(ix: i32, io: i32, variant: string) {
  const n = P.nodes[ix]
  if n is IsExpr {
    const nx = monoMkIsExprLike(ix, io, variant)
    recordClonedIsVarTy(nx, variant)
    return nx
  }
  ix
}

// Give an instance its own copy of every direct call to a generic — the `Call` node and
// its callee `Ident` — so the per-instance rename lands on nodes no sibling instance can
// see. Instances otherwise share the original's body arena, so one `Ident` served every
// instance and the last shape to instantiate won. Clone-if-changed over `monoWalk`'s walk.
function monoCloneGenericCalls(ix: i32) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Call {
    let newCallee = n.callFn
    const callee = P.nodes[n.callFn]
    if callee is Ident {
      if monoCalleeIsGeneric(callee.identName) {
        newCallee = mkIdent(callee.identName, callee.pos)
      }
    } else {
      newCallee = monoCloneGenericCalls(n.callFn)
    }
    let changed = newCallee != n.callFn
    const nargs: i32[] = []
    let ai = 0
    while ai < n.callArgs.length {
      const ca = monoCloneGenericCalls(n.callArgs[ai])
      nargs.push(ca)
      if ca != n.callArgs[ai] { changed = true }
      ai = ai + 1
    }
    if !changed { return ix }
    return mkCallN(newCallee, nargs, n.callArgNames, n.pos)
  }
  if n is Block {
    const ns: i32[] = []
    let bchanged = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoCloneGenericCalls(n.blkStmts[i])
      ns.push(cs)
      if cs != n.blkStmts[i] { bchanged = true }
      i = i + 1
    }
    if !bchanged { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is LetDecl {
    const ci = monoCloneGenericCalls(n.letInit)
    if ci == n.letInit { return ix }
    return mkLet(n.letKw, n.letName, n.letType, ci, n.pos)
  }
  if n is RetStmt {
    const ca2 = monoCloneGenericCalls(n.retArg)
    if ca2 == n.retArg { return ix }
    return mkReturn(ca2, n.pos)
  }
  if n is IfStmt {
    const cc = monoCloneGenericCalls(n.ifCond)
    const ct = monoCloneGenericCalls(n.ifThen)
    const ce = monoCloneGenericCalls(n.ifElse)
    if cc == n.ifCond && ct == n.ifThen && ce == n.ifElse { return ix }
    return mkIf(cc, ct, ce, n.pos)
  }
  if n is WhileStmt {
    const wc = monoCloneGenericCalls(n.whileCond)
    const wb = monoCloneGenericCalls(n.whileBody)
    if wc == n.whileCond && wb == n.whileBody { return ix }
    return mkWhile(wc, wb, n.whileLabel, n.pos)
  }
  if n is ForRange {
    const ff = monoCloneGenericCalls(n.frFrom)
    const ft = monoCloneGenericCalls(n.frTo)
    const fs = monoCloneGenericCalls(n.frStep)
    const fb = monoCloneGenericCalls(n.frBody)
    if ff == n.frFrom && ft == n.frTo && fs == n.frStep && fb == n.frBody {
      return ix
    }
    return mkForRange(n.frVar, ff, ft, fs, fb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const fi = monoCloneGenericCalls(n.fiIter)
    const fbi = monoCloneGenericCalls(n.fiBody)
    if fi == n.fiIter && fbi == n.fiBody { return ix }
    return mkForIn(n.fiVar, fi, fbi, n.fiLabel, n.pos)
  }
  if n is BinExpr {
    // A compound assignment desugars to `target = (target op value)` with the target node
    // shared between the read and the write, so its limbs cannot be rebuilt independently:
    // re-synthesize the whole form through the maker that re-establishes that sharing. The
    // prefix `++`/`--` form has no value limb but does have a target, so it is rebuilt too.
    if n.binCompound != "" {
      const ct = monoCloneGenericCalls(n.binLeft)
      if n.binCompound == "++" || n.binCompound == "--" {
        if ct == n.binLeft { return ix }
        return mkPreIncr(n.binCompound, ct, n.pos)
      }
      const inner = P.nodes[n.binRight]
      if inner is BinExpr {
        const iv = monoCloneGenericCalls(inner.binRight)
        if iv == inner.binRight && ct == n.binLeft { return ix }
        return mkCompoundAssign(n.binCompound, ct, iv, n.pos)
      }
      return ix
    }
    const bl = monoCloneGenericCalls(n.binLeft)
    const br = monoCloneGenericCalls(n.binRight)
    if bl == n.binLeft && br == n.binRight { return ix }
    return mkBinary(n.binOp, bl, br, n.pos)
  }
  if n is Unary {
    // A postfix `x++`/`x--` rides a `Unary` over the assignment whose operand is the
    // mutated target — left whole for the compound form's reason. Nothing to clone in it
    // either way: the parser accepts only an identifier there, and an `Ident` holds no call.
    if n.unOp == "p+" || n.unOp == "p-" { return ix }
    const ua = monoCloneGenericCalls(n.unArg)
    if ua == n.unArg { return ix }
    return mkUnary(n.unOp, ua, n.pos)
  }
  if n is Paren {
    const pi = monoCloneGenericCalls(n.parInner)
    if pi == n.parInner { return ix }
    return mkParen(pi, n.pos)
  }
  if n is Member {
    const mo = monoCloneGenericCalls(n.memObj)
    if mo == n.memObj { return ix }
    return mkMember(mo, n.memProp, n.pos)
  }
  if n is OptMember {
    const oo = monoCloneGenericCalls(n.omObj)
    if oo == n.omObj { return ix }
    return mkOptMember(oo, n.omProp, n.pos)
  }
  if n is Index {
    const xa = monoCloneGenericCalls(n.idxArr)
    const xi = monoCloneGenericCalls(n.idxIndex)
    if xa == n.idxArr && xi == n.idxIndex { return ix }
    return mkIndex(xa, xi, n.pos)
  }
  if n is IsExpr {
    const io = monoCloneGenericCalls(n.isObj)
    if io == n.isObj { return ix }
    return monoReIsExpr(ix, io)
  }
  if n is AsExpr {
    const ao = monoCloneGenericCalls(n.asObj)
    if ao == n.asObj { return ix }
    return mkAsExpr(ao, n.asTy, n.asMode, n.pos)
  }
  if n is ArrayLit {
    const es: i32[] = []
    let echanged = false
    let ei = 0
    while ei < n.arrElems.length {
      const ce = monoCloneGenericCalls(n.arrElems[ei])
      es.push(ce)
      if ce != n.arrElems[ei] { echanged = true }
      ei = ei + 1
    }
    if !echanged { return ix }
    return mkArrayLit(es, n.pos)
  }
  if n is ObjLit {
    const fl: i32[] = []
    let ochanged = false
    let oi = 0
    while oi < n.objFields.length {
      let nf = n.objFields[oi]
      const f = P.nodes[nf]
      if f is FieldInit {
        const cv = monoCloneGenericCalls(f.fiValue)
        if cv != f.fiValue {
          nf = mkFieldInit(f.fiName, cv, f.pos)
          ochanged = true
        }
      }
      fl.push(nf)
      oi = oi + 1
    }
    if !ochanged { return ix }
    return mkObjLit(fl, n.pos)
  }
  ix
}

// ── the per-instance layout fold: `T.size` / `T.<field>` ─────────────────────

// A generic body may read the layout of one of its type parameters — the stride a row
// accessor multiplies by, and the field offsets it adds. The checker types those members
// `i32` and leaves the `Member` node standing, because the constant does not exist until a
// binding does, and the binding is this pass's. Clone-if-changed, like every rung here.

// ── the two questions `dispatchRewrite` asks of a hole, re-asked at the pin ──

// `dispatchRewrite` runs before monomorphization, so inside a generic body its `BinExpr`
// arm asks both questions of an operand whose type is still a type parameter, and both
// degrade to no on a hole. One rung, and it must live here: the pinned type exists nowhere
// else. The two arms below are separately load-bearing — do not collapse them.

// The pinned type row of a body expression that reads a monomorphized parameter, or -1.
// Two gates: the name must match a parameter of the instance, and the checker's recorded
// type at that node must still carry a type variable. A local that shadows the parameter
// is typed concretely, so it fails the second gate and the pin is not applied to it.
function monoPinnedOperandTy(ix: i32, pNames: string[], pTys: i32[]) {
  if ix < 0 { return -1 }
  const e = P.nodes[ix]
  if e is Ident {
    if !tyHasTyVar(nodeTyIxOf(ix)) { return -1 }
    let i = 0
    while i < pNames.length {
      if pNames[i] == e.identName {
        if i < pTys.length { return pTys[i] }
        return -1
      }
      i = i + 1
    }
  }
  -1
}

// `drwWalk`'s `BinExpr` arm, re-run over one instance body with the pin in hand. The two
// rewrites are the same two `drwWalk` makes, so a pinned cell reaches exactly the lowering
// its direct twin reaches. The field-closure dispatch route is deliberately not here: it
// needs the emitter's struct table row, which cannot be asked for from a type.
function monoPinBinOps(ix: i32, pNames: string[], pTys: i32[]) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is BinExpr {
    // A compound assignment shares its target node between the read and the write, so its
    // limbs cannot be rebuilt independently — left whole, exactly as
    // `monoFoldTyParamLayout` leaves it.
    if n.binCompound != "" { return ix }
    const bl = monoPinBinOps(n.binLeft, pNames, pTys)
    const br = monoPinBinOps(n.binRight, pNames, pTys)
    const plt = monoPinnedOperandTy(n.binLeft, pNames, pTys)
    if plt >= 0 {
      // D512: the pin provably admits no null, so `??` is the identity on its left
      // operand. `tyExcludesNull` is the same predicate `nodeTyExcludesNull` asks of a
      // node, shared so the two homes cannot disagree.
      if n.binOp == "??" {
        if tyExcludesNull(plt) { return bl }
      }
      // D511: an object pin with a free `self`-function named for the operator.
      if drwDispatchOp(n.binOp) {
        const pot = T.tys[plt]
        if pot is TyObj {
          if drwSelfFnOf(n.binOp, 2) >= 0 {
            const oargs: i32[] = []
            oargs.push(bl)
            oargs.push(br)
            return mkCall(mkIdent(n.binOp, -1), oargs, -1)
          }
        }
      }
    }
    if bl == n.binLeft && br == n.binRight { return ix }
    return mkBinary(n.binOp, bl, br, n.pos)
  }
  if n is Block {
    const ns: i32[] = []
    let bchanged = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoPinBinOps(n.blkStmts[i], pNames, pTys)
      ns.push(cs)
      if cs != n.blkStmts[i] { bchanged = true }
      i = i + 1
    }
    if !bchanged { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is LetDecl {
    const ci = monoPinBinOps(n.letInit, pNames, pTys)
    if ci == n.letInit { return ix }
    return mkLet(n.letKw, n.letName, n.letType, ci, n.pos)
  }
  if n is RetStmt {
    const ca = monoPinBinOps(n.retArg, pNames, pTys)
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  if n is IfStmt {
    const cc = monoPinBinOps(n.ifCond, pNames, pTys)
    const ct = monoPinBinOps(n.ifThen, pNames, pTys)
    const ce = monoPinBinOps(n.ifElse, pNames, pTys)
    if cc == n.ifCond && ct == n.ifThen && ce == n.ifElse { return ix }
    return mkIf(cc, ct, ce, n.pos)
  }
  if n is WhileStmt {
    const wc = monoPinBinOps(n.whileCond, pNames, pTys)
    const wb = monoPinBinOps(n.whileBody, pNames, pTys)
    if wc == n.whileCond && wb == n.whileBody { return ix }
    return mkWhile(wc, wb, n.whileLabel, n.pos)
  }
  if n is ForRange {
    const ff = monoPinBinOps(n.frFrom, pNames, pTys)
    const ft = monoPinBinOps(n.frTo, pNames, pTys)
    const fs = monoPinBinOps(n.frStep, pNames, pTys)
    const fb = monoPinBinOps(n.frBody, pNames, pTys)
    if ff == n.frFrom && ft == n.frTo && fs == n.frStep && fb == n.frBody {
      return ix
    }
    return mkForRange(n.frVar, ff, ft, fs, fb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const fi = monoPinBinOps(n.fiIter, pNames, pTys)
    const fbi = monoPinBinOps(n.fiBody, pNames, pTys)
    if fi == n.fiIter && fbi == n.fiBody { return ix }
    return mkForIn(n.fiVar, fi, fbi, n.fiLabel, n.pos)
  }
  if n is Call {
    const cf = monoPinBinOps(n.callFn, pNames, pTys)
    let changed = cf != n.callFn
    const nargs: i32[] = []
    let ai = 0
    while ai < n.callArgs.length {
      const ca2 = monoPinBinOps(n.callArgs[ai], pNames, pTys)
      nargs.push(ca2)
      if ca2 != n.callArgs[ai] { changed = true }
      ai = ai + 1
    }
    // D1063 — `drwWalk`'s member-call arm, re-run over one instance body with the pin in
    // hand. `dispatchRewrite` meets `x.tag()` while `x` is still a type parameter and has
    // to answer for every instance at once, so where instantiations disagree it defers.
    // Field first, the checker's own precedence; otherwise the free `self`-function answers.
    const pcallee = P.nodes[n.callFn]
    if pcallee is Member {
      const precvTy = monoPinnedOperandTy(pcallee.memObj, pNames, pTys)
      if precvTy >= 0 && tyFieldTyOf(precvTy, pcallee.memProp) < 0 {
        // The site's own alias, not the plain property: the module merge mangles a free
        // `self`-function and leaves the call's property plain, and `ix` is the node the
        // merge walk banked its answer on.
        const puName = ufcsAliasAtSite(ix, pcallee.memProp)
        if drwSelfFnOf(puName, nargs.length + 1) >= 0 {
          const puArgs: i32[] = []
          puArgs.push(pcallee.memObj)
          let pu = 0
          while pu < nargs.length {
            puArgs.push(nargs[pu])
            pu = pu + 1
          }
          // The injected receiver is an unnamed slot-0 positional; an all-positional call
          // keeps its empty name list so `hasNamedArgs` stays false downstream.
          const puNames: string[] = []
          if hasNamedArgs(n.callArgNames) {
            puNames.push("")
            let pn = 0
            while pn < n.callArgNames.length {
              puNames.push(n.callArgNames[pn])
              pn = pn + 1
            }
          }
          return mkCallN(mkIdent(puName, -1), puArgs, puNames, n.pos)
        }
      }
    }
    if !changed { return ix }
    return mkCallN(cf, nargs, n.callArgNames, n.pos)
  }
  if n is Unary {
    // A postfix `x++`/`x--` rides a `Unary` over the assignment whose operand is the
    // mutated target — left whole for the compound form's reason.
    if n.unOp == "p+" || n.unOp == "p-" { return ix }
    const ua = monoPinBinOps(n.unArg, pNames, pTys)
    if ua == n.unArg { return ix }
    return mkUnary(n.unOp, ua, n.pos)
  }
  if n is Paren {
    const pi = monoPinBinOps(n.parInner, pNames, pTys)
    if pi == n.parInner { return ix }
    return mkParen(pi, n.pos)
  }
  if n is Member {
    const mo = monoPinBinOps(n.memObj, pNames, pTys)
    if mo == n.memObj { return ix }
    return mkMember(mo, n.memProp, n.pos)
  }
  if n is OptMember {
    const oo = monoPinBinOps(n.omObj, pNames, pTys)
    if oo == n.omObj { return ix }
    return mkOptMember(oo, n.omProp, n.pos)
  }
  if n is Index {
    const ia = monoPinBinOps(n.idxArr, pNames, pTys)
    const ii = monoPinBinOps(n.idxIndex, pNames, pTys)
    if ia == n.idxArr && ii == n.idxIndex { return ix }
    return mkIndex(ia, ii, n.pos)
  }
  if n is IsExpr {
    const io = monoPinBinOps(n.isObj, pNames, pTys)
    if io == n.isObj { return ix }
    return monoReIsExpr(ix, io)
  }
  if n is AsExpr {
    const ao = monoPinBinOps(n.asObj, pNames, pTys)
    if ao == n.asObj { return ix }
    return mkAsExpr(ao, n.asTy, n.asMode, n.pos)
  }
  if n is ArrayLit {
    const es: i32[] = []
    let echanged = false
    let ei = 0
    while ei < n.arrElems.length {
      const ce = monoPinBinOps(n.arrElems[ei], pNames, pTys)
      es.push(ce)
      if ce != n.arrElems[ei] { echanged = true }
      ei = ei + 1
    }
    if !echanged { return ix }
    return mkArrayLit(es, n.pos)
  }
  if n is ObjLit {
    const fl: i32[] = []
    let ochanged = false
    let oi = 0
    while oi < n.objFields.length {
      let nf = n.objFields[oi]
      const f = P.nodes[nf]
      if f is FieldInit {
        const cv = monoPinBinOps(f.fiValue, pNames, pTys)
        if cv != f.fiValue {
          nf = mkFieldInit(f.fiName, cv, f.pos)
          ochanged = true
        }
      }
      fl.push(nf)
      oi = oi + 1
    }
    if !ochanged { return ix }
    return mkObjLit(fl, n.pos)
  }
  ix
}

function monoFoldTyParamLayout(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Member {
    const mo = P.nodes[n.memObj]
    if mo is Ident {
      if monoTyParamOf(mo.identName, typarams) != "" {
        const bind = monoBindOf(tvN, tvV, mo.identName)
        if bind == "" {
          emitFail(
            "emitProgram: monomorphize: `" +
              mo.identName +
              "." +
              n.memProp +
              "` needs `" +
              mo.identName +
              "` bound by a parameter — a layout constant is per-instance",
          )
          return ix
        }
        const v = flatConstOfNameProp(bind, n.memProp)
        if v == -1 {
          emitFail(
            "emitProgram: monomorphize: `" +
              mo.identName +
              "` is bound to `" +
              bind +
              "`, which is not a `flat` type, so it has no byte layout",
          )
          return ix
        }
        if v == -2 {
          emitFail(
            "emitProgram: monomorphize: `flat type " +
              bind +
              "` (bound to `" +
              mo.identName +
              "`) has no field '" +
              n.memProp +
              "' — its layout members are `.size` and one offset per declared field",
          )
          return ix
        }
        return mkNum(i32ToStr(v), n.pos)
      }
    }
    const mc = monoFoldTyParamLayout(n.memObj, typarams, tvN, tvV)
    if mc == n.memObj { return ix }
    return mkMember(mc, n.memProp, n.pos)
  }
  if n is Block {
    const ns: i32[] = []
    let bchanged = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoFoldTyParamLayout(n.blkStmts[i], typarams, tvN, tvV)
      ns.push(cs)
      if cs != n.blkStmts[i] { bchanged = true }
      i = i + 1
    }
    if !bchanged { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is LetDecl {
    const ci = monoFoldTyParamLayout(n.letInit, typarams, tvN, tvV)
    if ci == n.letInit { return ix }
    return mkLet(n.letKw, n.letName, n.letType, ci, n.pos)
  }
  if n is RetStmt {
    const ca = monoFoldTyParamLayout(n.retArg, typarams, tvN, tvV)
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  if n is IfStmt {
    const cc = monoFoldTyParamLayout(n.ifCond, typarams, tvN, tvV)
    const ct = monoFoldTyParamLayout(n.ifThen, typarams, tvN, tvV)
    const ce = monoFoldTyParamLayout(n.ifElse, typarams, tvN, tvV)
    if cc == n.ifCond && ct == n.ifThen && ce == n.ifElse { return ix }
    return mkIf(cc, ct, ce, n.pos)
  }
  if n is WhileStmt {
    const wc = monoFoldTyParamLayout(n.whileCond, typarams, tvN, tvV)
    const wb = monoFoldTyParamLayout(n.whileBody, typarams, tvN, tvV)
    if wc == n.whileCond && wb == n.whileBody { return ix }
    return mkWhile(wc, wb, n.whileLabel, n.pos)
  }
  if n is ForRange {
    const ff = monoFoldTyParamLayout(n.frFrom, typarams, tvN, tvV)
    const ft = monoFoldTyParamLayout(n.frTo, typarams, tvN, tvV)
    const fs = monoFoldTyParamLayout(n.frStep, typarams, tvN, tvV)
    const fb = monoFoldTyParamLayout(n.frBody, typarams, tvN, tvV)
    if ff == n.frFrom && ft == n.frTo && fs == n.frStep && fb == n.frBody {
      return ix
    }
    return mkForRange(n.frVar, ff, ft, fs, fb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const fi = monoFoldTyParamLayout(n.fiIter, typarams, tvN, tvV)
    const fbi = monoFoldTyParamLayout(n.fiBody, typarams, tvN, tvV)
    if fi == n.fiIter && fbi == n.fiBody { return ix }
    return mkForIn(n.fiVar, fi, fbi, n.fiLabel, n.pos)
  }
  if n is Call {
    const cf = monoFoldTyParamLayout(n.callFn, typarams, tvN, tvV)
    let changed = cf != n.callFn
    const nargs: i32[] = []
    let ai = 0
    while ai < n.callArgs.length {
      const ca2 = monoFoldTyParamLayout(n.callArgs[ai], typarams, tvN, tvV)
      nargs.push(ca2)
      if ca2 != n.callArgs[ai] { changed = true }
      ai = ai + 1
    }
    if !changed { return ix }
    return mkCallN(cf, nargs, n.callArgNames, n.pos)
  }
  if n is BinExpr {
    // A compound assignment shares its target node between the read and the write, so
    // its limbs cannot be rebuilt independently — re-synthesize the whole form through
    // the maker that re-establishes that sharing, exactly as `monoCloneGenericCalls` does.
    if n.binCompound != "" {
      const ct2 = monoFoldTyParamLayout(n.binLeft, typarams, tvN, tvV)
      if n.binCompound == "++" || n.binCompound == "--" {
        if ct2 == n.binLeft { return ix }
        return mkPreIncr(n.binCompound, ct2, n.pos)
      }
      const inner = P.nodes[n.binRight]
      if inner is BinExpr {
        const iv = monoFoldTyParamLayout(inner.binRight, typarams, tvN, tvV)
        if iv == inner.binRight && ct2 == n.binLeft { return ix }
        return mkCompoundAssign(n.binCompound, ct2, iv, n.pos)
      }
      return ix
    }
    const bl = monoFoldTyParamLayout(n.binLeft, typarams, tvN, tvV)
    const br = monoFoldTyParamLayout(n.binRight, typarams, tvN, tvV)
    if bl == n.binLeft && br == n.binRight { return ix }
    return mkBinary(n.binOp, bl, br, n.pos)
  }
  if n is Unary {
    // A postfix `x++`/`x--` rides a `Unary` over the assignment whose operand is
    // the mutated target — left whole for the compound form's reason.
    if n.unOp == "p+" || n.unOp == "p-" { return ix }
    const ua = monoFoldTyParamLayout(n.unArg, typarams, tvN, tvV)
    if ua == n.unArg { return ix }
    return mkUnary(n.unOp, ua, n.pos)
  }
  if n is Paren {
    const pi = monoFoldTyParamLayout(n.parInner, typarams, tvN, tvV)
    if pi == n.parInner { return ix }
    return mkParen(pi, n.pos)
  }
  if n is OptMember {
    const oo = monoFoldTyParamLayout(n.omObj, typarams, tvN, tvV)
    if oo == n.omObj { return ix }
    return mkOptMember(oo, n.omProp, n.pos)
  }
  if n is Index {
    const xa = monoFoldTyParamLayout(n.idxArr, typarams, tvN, tvV)
    const xi = monoFoldTyParamLayout(n.idxIndex, typarams, tvN, tvV)
    if xa == n.idxArr && xi == n.idxIndex { return ix }
    return mkIndex(xa, xi, n.pos)
  }
  if n is IsExpr {
    const io = monoFoldTyParamLayout(n.isObj, typarams, tvN, tvV)
    // D951 — the check spelling is substituted only when it mentions a type parameter, the
    // `monoAnnHasTyParam`-then-`monoSubstAnn` contract every other substitution site keeps.
    // A concrete `is {v: i32}` must return verbatim: `monoSubstAnn`'s object arm rebuilds a
    // shape spelling from its parts, and a rebuilt spelling is a second intern key.
    if monoAnnHasTyParam(n.isVariant, typarams) {
      const sub = monoSubstAnn(n.isVariant, typarams, tvN, tvV)
      if sub != "" && sub != n.isVariant { return monoSubstIsExpr(ix, io, sub) }
    }
    if io == n.isObj { return ix }
    return monoReIsExpr(ix, io)
  }
  if n is AsExpr {
    const ao = monoFoldTyParamLayout(n.asObj, typarams, tvN, tvV)
    if ao == n.asObj { return ix }
    return mkAsExpr(ao, n.asTy, n.asMode, n.pos)
  }
  if n is ArrayLit {
    const es: i32[] = []
    let echanged = false
    let ei = 0
    while ei < n.arrElems.length {
      const ce = monoFoldTyParamLayout(n.arrElems[ei], typarams, tvN, tvV)
      es.push(ce)
      if ce != n.arrElems[ei] { echanged = true }
      ei = ei + 1
    }
    if !echanged { return ix }
    return mkArrayLit(es, n.pos)
  }
  if n is ObjLit {
    const fl: i32[] = []
    let ochanged = false
    let oi = 0
    while oi < n.objFields.length {
      let nf = n.objFields[oi]
      const f = P.nodes[nf]
      if f is FieldInit {
        const cv = monoFoldTyParamLayout(f.fiValue, typarams, tvN, tvV)
        if cv != f.fiValue {
          nf = mkFieldInit(f.fiName, cv, f.pos)
          ochanged = true
        }
      }
      fl.push(nf)
      oi = oi + 1
    }
    if !ochanged { return ix }
    return mkObjLit(fl, n.pos)
  }
  ix
}

// Whether a specialization callback is baked for any param — gates the body rewrite and
// the key extension below.
function monoAnyBakedCallback(cbFnNames: string[]) {
  let i = 0
  while i < cbFnNames.length {
    if cbFnNames[i] != "" { return true }
    i = i + 1
  }
  false
}

// The pin column for one instance's parameter list, built in a single parallel pass keyed
// by param index — a per-parameter fact belongs beside the parameters, not coded into one
// of their strings. The bridge from the marker is `pinKindOfName` + `sigKeyPinPayload`.
function monoBuildPinCol(pinned: string[], kinds: i32[], pays: string[]) {
  let i = 0
  while i < pinned.length {
    kinds.push(pinKindOfName(pinned[i]))
    pays.push(sigKeyPinPayload(pinned[i]))
    i = i + 1
  }
  0
}

// D988 — the key suffix an anonymous-shape pin needs, or "" for every other pin. A hole
// parameter pins the argument's type name, and two object literals with the same field
// names share one synthetic row whatever their field types are, so both key the same
// instance. The rendering is the right grain — keying on the type index mints per site.
function monoAnonPinDiscrim(pin: string, tyIx: i32): string {
  if tyIx < 0 { return "" }
  if pin.length < 5 { return "" }
  if pin[0] != "#"[0] { return "" }
  const rendered = tyToEmitName(tyIx)
  if rendered == "" { return "" }
  "=" + rendered
}

// D1042 — the emitter-vocabulary spelling of a name `monoSubstAnn` produced, for the one
// shape where the two can disagree: a union. `monoSubstAnn` substitutes into the declared
// annotation text, so a literal member stays literal, while every other producer of a
// union key goes through `canonEmitTypeNames`. Gated on being a union.
function monoPinUnionName(rs: string): string {
  const atoms: string[] = []
  splitUnionAtoms(rs, atoms)
  if atoms.length < 2 { return rs }
  const c = canonEmitName(rs)
  if c == "" { return rs }
  c
}

// D1042 — register a union that exists only because a pin minted it here. `collectU`
// runs before `monomorphize` and nothing re-runs it, so a `T | E` return at a concrete `T`
// has no row and every consumer of the box hits its floor. `registerInlineUnion` self-gates
// on `isUName`, which keeps one row per union — a box's tags are that row's, positionally.
function monoRegisterPinUnion(name: string) {
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  if atoms.length < 2 { return 0 }
  if isUName(name) { return 0 }
  const before = uVariants.length
  if registerInlineUnion(monoProgStmts, name) < 0 { return -1 }
  // Re-rank only when a variant is pushed: `assignTags` ranks variants globally and a value
  // union pushes none, so unconditional re-ranking would be quadratic.
  if uVariants.length != before { return assignTags() }
  0
}

// The instance-creation core shared by `monoInstantiate` (call-driven) and
// `monoInstanceFor` (annotation-driven): clone or reuse the instance of generic `origFe`
// for the already-built `pinned` names and point `calleeIx` at it. `annotateI32` annotates
// an i32-pinned param too; `cbFnNames` bakes a concrete callback in. Returns 0, or -1.
function monoMakeInstance(
  origFe: i32,
  pinned: string[],
  pinKinds: i32[],
  pinPays: string[],
  pinTys: i32[],
  tvN: string[],
  tvV: string[],
  calleeIx: i32,
  annotateI32: boolean,
  cbFnNames: string[],
) {
  // The pin columns are positional and nothing downstream can tell a misaligned one from a
  // correct one — param j would silently read param k's type. Checked once, loudly, here
  // rather than bounds-guarding each read: a guard turns misalignment into a silently wrong
  // type, and a short-but-nonempty column is exactly what a bounds guard cannot see.
  if pinTys.length != pinned.length {
    return emitFail(
      "emitProgram: monomorphize: pin type column is not parallel to the pins",
    )
  }
  const fn = P.nodes[monoOrigNode[origFe]]
  if fn is FuncDecl {
    const params = fn.fnParams
    let key = i32ToStr(origFe) + "#"
    let pk = 0
    while pk < pinned.length {
      key = key + pinned[pk] + monoAnonPinDiscrim(pinned[pk], pinTys[pk]) + ","
      pk = pk + 1
    }
    // The baked-callback identities extend the key, so two calls passing the same pinned
    // types but different non-capturing callbacks get distinct instances. No baked
    // callback → no `@` suffix → the key is exactly the pre-specialization one.
    let ck = 0
    while ck < cbFnNames.length {
      if cbFnNames[ck] != "" { key = key + "@" + cbFnNames[ck] + "," }
      ck = ck + 1
    }
    // A closure-pinned param flips the module's function-value machinery on
    // (the instance body `call_ref`s through it; the argument side builds the
    // fat pointer) — the same flag a lifted lambda flips in `liftFnsInExpr`.
    let pv = 0
    while pv < pinKinds.length {
      if pinKinds[pv] == PIN_SIGKEY { fnValUsed = true }
      pv = pv + 1
    }
    // Registry hit: point this call site at the existing instance.
    let k = 0
    while k < monoKeys.length {
      if monoKeys[k] == key {
        const cal = P.nodes[calleeIx]
        if cal is Ident {
          // A registry hit on a capturing lambda in the binding's own slot must stay a
          // `call_ref`: renaming the callee would drop the captured env. A reassigned
          // binding must too, since every later write would be invisible.
          let keepCallRef = false
          if monoInstFe[k] == origFe && cal.identName != monoInstName[k] {
            if captureCountOf(origFe) > 0 { keepCallRef = true }
            else if monoNameIsAssigned(cal.identName) { keepCallRef = true }
          }
          if !keepCallRef {
            if cal.identName != monoInstName[k] {
              cal.identName = monoInstName[k]
              monoArenaTouch()
              // R4 writer 5 of 8 (`compiler/symbols.vl`; census in `perf-program.md`).
              sidNoteNodeName(calleeIx)
            }
          }
        }
        // A value use reaching an instance a direct call already built. The call path
        // spells an i32 pin as the hole it is, leaving the value floor to reject a
        // function this program has pinned monomorphic — order-dependence nobody holds.
        if annotateI32 {
          const hfn = P.nodes[fnStmts[monoInstFe[k]]]
          if hfn is FuncDecl {
            const hps = hfn.fnParams
            if hps.length == pinned.length {
              let hp = 0
              while hp < hps.length {
                const hpp = P.nodes[hps[hp]]
                if hpp is Param {
                  if hpp.parType < 0 {
                    // The synthesis is the whole write: `synthTypeRef` records
                    // the type under the same pin this column holds. Equivalent
                    // to the clone arm only while this caller's column is all -1.
                    hpp.parType = synthTypeRef(pinned[hp], -1)
                    monoArenaTouch()
                  }
                }
                hp = hp + 1
              }
            }
          }
        }
        return 0
      }
      k = k + 1
    }
    // New shape: clone the original declaration with pinned annotations. An un-annotated
    // param pinned at plain i32 keeps `parType = -1` — the emitter's default kind, and
    // zero new arena nodes on the all-i32 path.
    let count = 0
    let k2 = 0
    while k2 < monoInstOrig.length {
      if monoInstOrig[k2] == origFe { count = count + 1 }
      k2 = k2 + 1
    }
    const nps: i32[] = []
    // The pinned params as arena indices, one row per entry of `params` (-1 = no
    // resolvable type). This is the column the speculative-inference windows below take:
    // the pin is resolved once, here at the clone, and never re-resolved from its spelling.
    const pinnedTyIx: i32[] = []
    let pj = 0
    while pj < params.length {
      let pinTy = -1
      const p3 = P.nodes[params[pj]]
      if p3 is Param {
        let nt = -1
        // Whether `nt` is a node this loop SYNTHESIZED (and which therefore already
        // carries its recorded type) or the original declaration's own annotation node.
        let synthed = false
        if p3.parType >= 0 {
          // The pinned name differs from the written annotation exactly when
          // a type param substituted through it (bare `T`, `T[]`, or a
          // composite like `Box<T>`); a concrete annotation keeps its node.
          if pinned[pj] == tyNameOf(p3.parType) {
            nt = p3.parType
          } else {
            nt = synthTypeRefFb(pinned[pj], -1, pinTys[pj])
            synthed = true
          }
        } else if annotateI32 || pinned[pj] != "i32" {
          nt = synthTypeRefFb(pinned[pj], -1, pinTys[pj])
          synthed = true
        }
        // The pinned concrete param type is recorded on the instance's annotation node,
        // and `pinTy` is that index. A synthesized node already carries it; the original
        // declaration's node carries the checker's generic-frame resolution instead.
        if nt >= 0 {
          if synthed {
            pinTy = nodeTyIxOf(nt)
          } else {
            // The node often already holds the answer, this arm being reached only when
            // the pinned name is the written annotation. The few that differ carry the
            // generic body's type-param frame, which `tyHasTyVar` separates.
            const already = nodeTyIxOf(nt)
            if already >= 0 && !tyHasTyVar(already) {
              pinTy = already
            } else {
              pinTy = recordClonedNodeTy(nt, pinned[pj], pinKinds[pj])
            }
          }
        } else {
          // The one arm that mints no annotation node: an un-annotated param pinned at plain
          // i32 (`nt` stays -1 by design, so the all-i32 path adds zero arena nodes).
          pinTy = i32TyIx()
        }
        // D681 — an anon pin's type is its row's, not the placeholder's: `#anonN`
        // resolves to nothing, so the node records a field-less `TyObj` while this
        // column is what the re-check windows declare the parameters as.
        const anonTy = anonHandleTyIx(pinned[pj])
        if anonTy >= 0 { pinTy = anonTy }
        nps.push(mkParam(p3.parName, nt, p3.parDefault, p3.parOpt, -1))
        // D926 — and the `??` owner mark, which is keyed by arena node and so does not
        // survive a clone on its own. See `anonLeafCarryParamMark`.
        anonLeafCarryParamMark(params[pj], nps[nps.length - 1])
      }
      pinnedTyIx.push(pinTy)
      pj = pj + 1
    }
    // The body's binding column, built from `pinnedTyIx` except at a function-type
    // parameter, where it takes the argument's own arena row. A pin name substitutes each
    // type parameter's bound name, and a literal union's bound name is the softened
    // `string` — so one instance spelled `U[]` two ways, atom-backed and string-ref-backed.

    // Not everywhere: taking `pinTys` at every position reddens the litunion-ordering
    // family, because a value parameter's pin name carries a nominal fact a row does not.
    const letTyCol: i32[] = []
    let lj = 0
    while lj < params.length {
      let lt = -1
      if lj < pinnedTyIx.length { lt = pinnedTyIx[lj] }
      if lj < pinned.length {
        if annArrowAt(pinned[lj]) >= 1 || pinKinds[lj] == PIN_SIGKEY {
          if lj < pinTys.length && pinTys[lj] >= 0 { lt = pinTys[lj] }
        }
      }
      letTyCol.push(lt)
      lj = lj + 1
    }
    const letBN: string[] = []
    const letBT: i32[] = []
    monoBindCols(params, letTyCol, letBN, letBT)
    // Substitute a type-param-riding RETURN annotation through the binding —
    // bare `T` / `T[]`, an application (`Box<T>`), or an inline object shape
    // (`{first:B,second:A}`); a concrete annotation passes through unchanged.
    let nret = fn.fnRet
    // A hole-built return list local to annotate in the cloned instance body, so its `[]`
    // build classifies per element type. Captured from the return trace below and threaded
    // into `monoCloneBody`, which clones and annotates just that `LetDecl` per instance.
    let monoOutName = ""
    let monoOutType = ""
    // The arena row for `monoOutType`, carried beside the spelling so the body clone mints
    // from the type instead of re-parsing the print. -1 where no producer ran, which
    // `synthTypeRefTy` treats exactly as name resolution.
    let monoOutTypeIx = -1
    if fn.fnRet >= 0 {
      // The parameter pin's rule, applied to the RETURN for the same reason: a shadowed
      // return annotation is canon'd out of the arena before this read.
      const rn = monoDeclAnnName(fn.fnRet, tyNameOf(fn.fnRet), fn.fnTyParams)
      if monoAnnHasTyParam(rn, fn.fnTyParams) {
        const rs = monoSubstAnn(rn, fn.fnTyParams, tvN, tvV)
        if rs == "" {
          return emitFail(
            "emitProgram: monomorphize: a return type parameter of `" +
              fn.fnName +
              "` is not bound by any parameter",
          )
        }
        // The substituted type, not a re-parse of the substituted name, which would
        // mint a structurally identical `Ty` row. Gated on completeness: `tyHasTyVar`
        // separates a partial substitution from a full one.
        let retTy = -1
        const origRet = nodeTyIxOf(fn.fnRet)
        if origRet >= 0 {
          const bN: string[] = []
          const bT: i32[] = []
          // The same column the parameter slot and the body's bindings take, and that
          // agreement is the invariant: the registry is keyed on `pinned` alone, so a
          // result sourced elsewhere makes the instance a function the key cannot see.
          monoBindCols(params, letTyCol, bN, bT)
          const sub2 = substTyDeep(origRet, bN, bT)
          if sub2 >= 0 {
            if sub2 != origRet {
              // `substTyDeep`'s union arm dedupes and collapses, so a `T | string` at
              // `T := string` normalises the way the annotation path does. No corpus
              // program grades this one.
              if !tyHasTyVar(sub2) { retTy = sub2 }
            }
          }
        }
        // D1042 — a union the pin mints is spelled the way the direct spelling is. `rs`
        // substitutes the bound name into the declared text, so `T | "err"` arrives
        // literal, while every other producer of that key softens it to `i32|string`.
        const rsC = monoPinUnionName(rs)
        nret = synthTypeRefTy(rsC, -1, retTy)
        // And register it: `collectU`, the only pass that mints union rows, runs before
        // this one. Registering under the canon'd key reuses the row a direct spelling
        // minted — a union's box tags are positional over its member set.
        if monoRegisterPinUnion(rsC) < 0 { return -1 }
      }
    }
    // An un-annotated return whose return expression is a value-call through a
    // closure-pinned param takes that signature's result kind as a concrete annotation:
    // the emitter's return-kind inference has no expression form for a `call_ref` result,
    // so the instance's functype rides the normal annotation tables instead.
    if nret < 0 {
      const rx2 = fnRetExprOf(monoOrigNode[origFe])
      if rx2 >= 0 {
        const rxe = P.nodes[rx2]
        if rxe is Call {
          const rcal = P.nodes[rxe.callFn]
          if rcal is Ident {
            let pq = 0
            while pq < params.length {
              const pp = P.nodes[params[pq]]
              if pp is Param {
                if pp.parName == rcal.identName {
                  const pn = pinned[pq]
                  // The bound is the paren arm's own: a `(…)`-opening function-type
                  // spelling is never two characters. The pin arm beside it reads the
                  // column rather than the name's first two.
                  if pn.length > 2 {
                    if pinKinds[pq] == PIN_SIGKEY {
                      // An un-annotated closure param's sig-key pin: only its
                      // f64 result kind has no expression-form return inference.
                      // The payload decodes through `sigKeyRetKind`.
                      if sigKeyRetKind(pinPays[pq]) == "f64" {
                        nret = synthTypeRef("f64", -1)
                      }
                    } else if nameIsParenOpen(pn) {
                      // An annotated function-type param pin: the un-annotated
                      // HOF return flows through the callback, so it is the
                      // callback's return type. A closure result stays `nret = -1`.
                      const retName = normTypeAtom(annRetNameOf(pn))
                      // The return row comes off the pin's own type, not from a
                      // second parse of the name cut out of `pn`. The gate is
                      // unchanged; only the recorded row is.
                      let retTyIx = -1
                      if pinTys[pq] >= 0 {
                        const pft = T.tys[pinTys[pq]]
                        if pft is TyFunc { retTyIx = pft.fnRet }
                      }
                      if retName != "" && annArrowAt(retName) < 0 {
                        nret = synthTypeRefTy(retName, -1, retTyIx)
                      }
                    }
                  }
                }
              }
              pq = pq + 1
            }
          }
          // `return <param>.map/filter(<lambda>)` over a param pinned to a non-i32
          // array: type the return as the concrete result list. `.filter` preserves the
          // element; `.map` preserves it for an element-wise callback. i32 keeps -1.
          if rcal is Member {
            if rcal.memProp == "map" || rcal.memProp == "filter" {
              if rxe.callArgs.length == 1 {
                const mrecv = P.nodes[rcal.memObj]
                if mrecv is Ident {
                  let pqm = 0
                  while pqm < params.length {
                    const ppm = P.nodes[params[pqm]]
                    if ppm is Param {
                      if ppm.parName == mrecv.identName {
                        // `listElemNameOf` adds one naive grouping-paren strip
                        // over the cut this site wants: a `(…)`-wrapped element
                        // is the only shape the two disagree on.
                        const srcElem = listElemNameOf(pinned[pqm])
                        if srcElem != "" && srcElem != "i32" {
                          // Both arms produce the receiver's own list type, so
                          // `srcElem + "[]"` is `pinned[pqm]` cut apart and put
                          // back together, landing on a fresh arena row each time.
                          if rcal.memProp == "filter" {
                            nret = synthTypeRefTy(
                              srcElem + "[]",
                              -1,
                              pinTys[pqm],
                            )
                          } else if monoLambdaPreservesElem(rxe.callArgs[0]) {
                            nret = synthTypeRefTy(
                              srcElem + "[]",
                              -1,
                              pinTys[pqm],
                            )
                          }
                        }
                      }
                    }
                    pqm = pqm + 1
                  }
                }
              }
            }
          }
        }
        if rxe is Index {
          // `return param[i]` where the param pinned to an f64 array yields an f64
          // element — synthesize the concrete `f64` return, the un-annotated-return kind
          // inference having no f64 form for it. i32 and string keep `nret = -1`.
          const ria = P.nodes[rxe.idxArr]
          if ria is Ident {
            let pqi = 0
            while pqi < params.length {
              const ppi = P.nodes[params[pqi]]
              if ppi is Param {
                if ppi.parName == ria.identName {
                  // `nameIsF64Array` is the home for this question. Both it and the
                  // sibling twenty lines up (`listElemNameOf` for the `.map`/`.filter`
                  // element) are projections of one value: the pinned array's element name.
                  if nameIsF64Array(pinned[pqi]) {
                    nret = synthTypeRef("f64", -1)
                  }
                }
              }
              pqi = pqi + 1
            }
          }
        }
        if rxe is Ident {
          // `return <local>` where the local is a hole-built list: the list shares the
          // indexed param's array type, so type the return as that param's pinned type.
          // No source param found → keep `nret = -1`.
          const srcParam = monoListSrcParam(fn.fnBody, rxe.identName)
          if srcParam != "" {
            let pli = 0
            while pli < params.length {
              const ppl = P.nodes[params[pli]]
              if ppl is Param {
                if ppl.parName == srcParam {
                  if pinned[pli] != "" {
                    // The argument type is handed over instead of re-parsed out
                    // of the spelling, which would mint a second arena row.
                    // `pinTys[pli]` of -1 falls back to exactly name resolution.
                    nret = synthTypeRefTy(pinned[pli], -1, pinTys[pli])
                    monoOutName = rxe.identName
                    monoOutType = pinned[pli]
                    monoOutTypeIx = pinTys[pli]
                  }
                }
              }
              pli = pli + 1
            }
          } else {
            // The pass-through trace found no `out.push(param[idx])` source — the list
            // is built from a non-trivial expression. Re-check the body for this shape
            // so the checker's own list-element inference resolves the local.
            const listTyIx: i32[] = []
            const listTy = monoInferListElem(
              monoOrigNode[origFe],
              pinnedTyIx,
              rxe.identName,
              listTyIx,
            )
            if listTy != "" {
              let ltIx = -1
              if listTyIx.length > 0 { ltIx = listTyIx[0] }
              nret = synthTypeRefTy(listTy, -1, ltIx)
              monoOutName = rxe.identName
              monoOutType = listTy
              monoOutTypeIx = ltIx
            } else {
              // Not an inferred list local — try a scalar one whose type derives from a
              // hole-pinned param. The return-kind inference runs before locals are
              // collected. "" for i32 / boolean / composite.
              const scTyIx: i32[] = []
              const scTy = monoInferLocalScalar(
                monoOrigNode[origFe],
                pinnedTyIx,
                rxe.identName,
                scTyIx,
              )
              if scTy != "" {
                let scIx = -1
                if scTyIx.length > 0 { scIx = scTyIx[0] }
                nret = synthTypeRefTy(scTy, -1, scIx)
              }
            }
          }
        }
      }
    }
    // D592 — the ladder's fall-through, asked of the return expression rather than of its
    // shape. Every arm above matches one spelling, and a return the whitelist does not name
    // keeps `nret = -1`, so the functype result falls to `retAnnKindChain`'s `"i32"` seed.
    // Last, so every arm above keeps its answer.
    if nret < 0 {
      const reTyIx: i32[] = []
      const reTy = monoInferRetExprTy(
        monoOrigNode[origFe],
        pinnedTyIx,
        letBN,
        letBT,
        fnRetExprOf(monoOrigNode[origFe]),
        reTyIx,
      )
      if reTy != "" {
        let reIx = -1
        if reTyIx.length > 0 { reIx = reTyIx[0] }
        // D592 — a struct return is annotated by the name of an interned row, never by
        // the shape's printed spelling. `monoRetRowName` asks the emitter's own table
        // which row this arena type is; no row, no mint.
        let mintName = reTy
        let mint = true
        // Bound-checked rather than trusted: an unguarded `T.tys[-1]` is a compiler
        // trap, which the `emitFail does not halt` discipline exists for. A -1 keeps
        // the printed-name route.
        if reIx >= 0 {
          const rrt = T.tys[reIx]
          if rrt is TyObj {
            mintName = monoRetRowName(reIx)
            if mintName == "" { mint = false }
          }
        }
        // D970 — a multi-return function is not described by one return expression, so
        // `reTy` names the tail while the result is the join. Declining leaves the
        // instance to the return-inference path.
        if mint {
          if monoRetJoinDisagrees(monoOrigNode[origFe], reIx) { mint = false }
        }
        if mint { nret = synthTypeRefTy(mintName, -1, reIx) }
      }
    }
    // D1521 — a multi-return instance is not described by one arm, whichever arm the
    // ladder above named. It overrides the ladder rather than filling its -1: the shape
    // whitelist reaches its own answer and that answer is still one arm. A still-holey arm
    // declines the whole set, and `monoRegisterPinUnion` makes the minted name resolvable.
    if fn.fnRet < 0 {
      const jTy: i32[] = []
      const jun = monoInferRetSetUnionName(
        monoOrigNode[origFe],
        pinnedTyIx,
        letBN,
        letBT,
        jTy,
      )
      if jun != "" {
        if monoRegisterPinUnion(jun) < 0 { return -1 }
        let jIx = -1
        if jTy.length > 0 { jIx = jTy[0] }
        nret = synthTypeRefTy(jun, -1, jIx)
      }
    }
    let instName = fn.fnName
    let instFe = origFe
    if count > 0 { instName = fn.fnName + "$" + i32ToStr(count) }
    const noTyParams: string[] = []
    // Substitute type-param annotations in the body's `LetDecl`s for this instance (a
    // `const out: T[]` becomes `const out: f64[]`); shares the body wholesale when it has
    // no such annotation.
    const instBody0 = monoCloneBody(
      fn.fnBody,
      fn.fnTyParams,
      tvN,
      tvV,
      monoOutName,
      monoOutType,
      monoOutTypeIx,
      letBN,
      letBT,
    )
    // D426 — substitute a bound lambda's own annotations at this pin, and mint the lambda
    // per instance. `monoCloneBody` above shares every leaf expression including a nested
    // lambda, which is right for a concrete lambda and wrong for one written at `T`.
    // Copy-on-write: a body with no such lambda is the same node index.
    monoLamMintedSlots = []
    monoInstIsFirst = count == 0
    const instBody0L = monoPinBodyLambdas(
      instBody0,
      fn.fnTyParams,
      tvN,
      tvV,
      letBN,
      letBT,
    )
    // Pin any `.map`/`.filter` callback lambda whose receiver param this instance bound to
    // a non-i32 element: the shared body's un-annotated lambda would otherwise emit as i32.
    // Build the param→element map from the pinned param names, then clone and pin per
    // instance; i32 shapes are left as they are.
    const pElemNames: string[] = []
    const pElemTypes: string[] = []
    // The element row column, parallel to `pElemTypes`. `listElemNameOf` cuts the element
    // out of the pin's spelling; this reads it off the pin's type, so the callback's pinned
    // annotation is minted from a row. -1 where the pin is not a recorded array.
    const pElemTys: i32[] = []
    let pe = 0
    while pe < params.length {
      const pep = P.nodes[params[pe]]
      if pep is Param {
        pElemNames.push(pep.parName)
      } else {
        pElemNames.push("")
      }
      pElemTypes.push(listElemNameOf(pinned[pe]))
      let peTy = -1
      if pinTys[pe] >= 0 {
        const pet = T.tys[pinTys[pe]]
        if pet is TyArray { peTy = pet.aElem }
      }
      pElemTys.push(peTy)
      pe = pe + 1
    }
    const instBody1 = monoPinMapLambdas(
      instBody0L,
      pElemNames,
      pElemTypes,
      pElemTys,
    )
    // Bake any non-capturing concrete callback into a direct call (`pElemNames` already
    // holds the per-position param names, parallel to `cbFnNames`). No baked callback → no
    // rewrite → the body is the same node `monoPinMapLambdas` produced.
    let instBody2 = instBody1
    if monoAnyBakedCallback(cbFnNames) {
      instBody2 = monoBakeCallback(instBody1, pElemNames, cbFnNames)
    }
    // Per-instance copies of the direct generic calls this body makes, so instantiating
    // them rewrites only this instance's callee `Ident`s. No generic call → the same node.
    const instBody3 = monoCloneGenericCalls(instBody2)
    // Per-instance layout constants for the type parameters this body reads
    // (`i * T.size`) — folded HERE because the binding is what makes them exist.
    const instBody4 = monoFoldTyParamLayout(instBody3, fn.fnTyParams, tvN, tvV)
    // The two questions `dispatchRewrite` asks of a hole, re-asked at the pin. Last in the
    // chain, so it sees the body every rung above produced; copy-on-write, so a body with
    // no such operator is the same node index.
    const instBody = monoPinBinOps(instBody4, pElemNames, pinnedTyIx)
    // A bare `return` makes the template void whatever its tail's type is, so drop the pins
    // above and let `computeVoidFns` classify the clone from its own body (D1600).
    let instRet = nret
    if fn.fnRet < 0 && blockHasBareReturn(fn.fnBody) { instRet = -1 }
    const nfn = mkFunc(instName, noTyParams, nps, instRet, instBody, -1)
    // D926 — the return-row twin of the param mark above. `monoOrigNode[origFe]` is the
    // template's own `FuncDecl`, which is what `anonLeafMarkRetMoved` marked.
    anonLeafCarryRetMark(monoOrigNode[origFe], nfn)
    if count == 0 {
      // First instance: keep the bare name and the original's wasm index.
      fnStmts[origFe] = nfn
      monoArenaTouch()
    } else {
      // D971 — a lifted capturing instance takes its env as a leading `structref` param,
      // so a by-name call to it is sound. What is not is the rename folding a call into
      // the initializer's instance when the binding is reassigned.
      const cal3 = P.nodes[calleeIx]
      if cal3 is Ident {
        if cal3.identName != fn.fnName && monoNameIsAssigned(cal3.identName) {
          return emitFail(
            "emitProgram: the reassigned function binding `" +
              cal3.identName +
              "` is called at more than one argument type — one binding holds one closure " +
              "signature, and the values written to it want two. Annotate the parameters, or " +
              "bind a separate value per type",
          )
        }
      }
      fnStmts.push(nfn)
      fnParent.push(-1)
      fnDispNames.push("")
      instFe = fnStmts.length - 1
      // D943 — the clones' frame is this instance, not the template. `captureValKind`
      // types an env field by resolving the capture in its enclosing frame, so until this
      // runs the clone reads `value: T` and every instance mints the same env layout.
      let mls = 0
      let mlsWrote = false
      while mls < monoLamMintedSlots.length {
        const msl = monoLamMintedSlots[mls]
        if msl >= 0 && msl < fnParent.length {
          fnParent[msl] = instFe
          monoArenaTouch()
          mlsWrote = true
        }
        mls = mls + 1
      }
      if mlsWrote { invalidateFnChildIndex() }
      monoLamMintedSlots = []
      const cal2 = P.nodes[calleeIx]
      // R4 writer 6 of 8 (`compiler/symbols.vl`; census in `perf-program.md`).
      if cal2 is Ident {
        cal2.identName = instName
        monoArenaTouch()
        sidNoteNodeName(calleeIx)
      }
    }
    // REGISTER before walking the body, so a recursive self-call at the same
    // shape resolves here instead of recursing (the host's discipline).
    monoKeys.push(key)
    monoInstOrig.push(origFe)
    monoInstName.push(instName)
    monoInstFe.push(instFe)
    if monoRebuild() < 0 { return -1 }
    // Walk this instance's body — a nested generic call instantiates its own callee
    // against this instance's concrete annotations, and the callee rename lands on the
    // instance's own `Call` spine rather than on nodes its siblings share.
    if monoWalkFnBody(nfn) < 0 { return -1 }
    if monoRebuild() < 0 { return -1 }
    return 0
  }
  0
}

// The param type names of a function-type name (`(f64, f64) => f64` → ["f64", "f64"]),
// appended to `out`; false when `name` is not a function type or is malformed. A thin
// reading of `emit_base.annFnDecompose`, whose answer conflates "not a function type"
// with "a function type whose return name is empty" — its stated contract.
function monoFnTypeAnnParamsName(name: string, out: string[]) {
  annFnDecompose(name, out) != ""
}

// Materialize or reuse the instance of generic `origFe` for an annotated function-typed
// binding, pinning each parameter to the annotation's param type name and pointing
// `letInitIx` at it. Unlike the call-driven path this carries the value's concrete type
// independent of any call, so a binding that escapes is `call_ref`'d at that type.
function monoInstanceFor(origFe: i32, pinnedNames: string[], letInitIx: i32) {
  const fn = P.nodes[monoOrigNode[origFe]]
  if fn is FuncDecl {
    const params = fn.fnParams
    if params.length != pinnedNames.length { return 0 }
    const tvN: string[] = []
    const tvV: string[] = []
    let i = 0
    // Every parameter is read, in one of three ways: an un-annotated hole is filled from
    // the boundary; a type parameter is bound by it, which also substitutes the return;
    // a concrete annotation must agree with the boundary's name or this declines.
    while i < params.length {
      const p = P.nodes[params[i]]
      if p is Param {
        if p.parType >= 0 {
          // The declared spelling, so a parameter whose annotation names a type parameter
          // is read as that parameter rather than as whatever an alias of the same name
          // canon'd to — `monoInstantiate`'s rule, for the same reason.
          const ann = monoDeclAnnName(
            p.parType,
            tyNameOf(p.parType),
            fn.fnTyParams,
          )
          if monoAnnHasTyParam(ann, fn.fnTyParams) {
            monoBindFromAnn(ann, pinnedNames[i], fn.fnTyParams, tvN, tvV)
          } else if normTypeAtom(ann) != normTypeAtom(pinnedNames[i]) {
            return 0
          }
        }
      }
      i = i + 1
    }
    // Post-condition on the bindings, and it needs its own pass because `monoBindFromAnn`
    // is first-use-wins: substituting them back through every type-param-riding annotation
    // must reproduce the boundary. `pairT<T>(a: T, b: T)` reaching `(i32, string) => i32`
    // binds `T` from `a` and then disagrees at `b`. Declining hands it to the value floor.
    let v = 0
    while v < params.length {
      const pv = P.nodes[params[v]]
      if pv is Param {
        if pv.parType >= 0 {
          const annV = monoDeclAnnName(
            pv.parType,
            tyNameOf(pv.parType),
            fn.fnTyParams,
          )
          if monoAnnHasTyParam(annV, fn.fnTyParams) {
            const sub = monoSubstAnn(annV, fn.fnTyParams, tvN, tvV)
            if sub == "" { return 0 }
            if normTypeAtom(sub) != normTypeAtom(pinnedNames[v]) { return 0 }
          }
        }
      }
      v = v + 1
    }
    const pinned: string[] = []
    // No argument node on this path (an annotation-driven binding), so nothing is known —
    // an all -1 column is exactly today's behaviour.
    const pinTys: i32[] = []
    let j = 0
    while j < pinnedNames.length {
      pinned.push(pinnedNames[j])
      pinTys.push(-1)
      j = j + 1
    }
    // The annotation-driven binding path (`const c: (f64,f64)=>f64 = add`) bakes no callback — the
    // value escapes its call sites, so its body keeps the `call_ref`. Empty → no key/body change.
    const noCb: string[] = []
    const pinKinds: i32[] = []
    const pinPays: string[] = []
    monoBuildPinCol(pinned, pinKinds, pinPays)
    return monoMakeInstance(
      origFe,
      pinned,
      pinKinds,
      pinPays,
      pinTys,
      tvN,
      tvV,
      letInitIx,
      true,
      noCb,
    )
  }
  0
}

// The field names and field type-names of the struct type `tname` names, appended in
// parallel to `outNames` / `outTexts`; false when `tname` names no struct. A declared
// alias is read off the `TypeDecl`'s own `FieldDef` nodes, so each field type arrives as
// an arena `TypeRef`; an inline shape falls back to `annObjFieldSplit`.
function monoStructFieldTypes(
  tname: string,
  outNames: string[],
  outTexts: string[],
) {
  if tname == "" { return false }
  let i = 0
  while i < monoProgStmts.length {
    const s = P.nodes[monoProgStmts[i]]
    if s is TypeDecl {
      if s.tdName == tname {
        const fs = s.tdFields
        let j = 0
        while j < fs.length {
          const fd = P.nodes[fs[j]]
          if fd is FieldDef {
            outNames.push(fd.fdName)
            outTexts.push(tyNameOf(fd.fdType))
          }
          j = j + 1
        }
        return true
      }
    }
    i = i + 1
  }
  annObjFieldSplit(tname, outNames, outTexts) == 1
}

// The `fnStmts` slot of the function an `Ident` names — the one resolver every question
// this pass asks about a named function goes through. `fnIndexOfInScope` is the language's
// innermost-scope rule for a name a `FuncDecl` carries; `identClosureFeSid` covers an
// arrow lambda, which parses to a nameless `FuncDecl` and carries its name on the binding.
function monoFnFeOfIdent(identIx: i32, name: string, ctx: i32) {
  const fe = fnIndexOfInScope(name, ctx)
  if fe >= 0 { return fe }
  identClosureFeSid(sidOfNode(identIx), ctx)
}

// Coerce a generic function value (or a composite of them) flowing into the expected type
// named by `tname`: materialize the instance for an `Ident` naming a generic, or recurse
// into an array literal's elements and an object literal's field values against their
// declared types. The checker has already proved the instantiation valid; this emits it.
function monoCoerceFnValueName(exprIx: i32, tname: string, ctx: i32) {
  if exprIx < 0 { return 0 }
  const e = P.nodes[exprIx]
  if e is ObjLit {
    // A function-valued struct field. The composite arms are mutually recursive with the
    // `Ident` arm below, so a generic function nested any depth down a literal
    // materializes at the type its own slot declares.
    const fnames: string[] = []
    const ftexts: string[] = []
    if monoStructFieldTypes(tname, fnames, ftexts) {
      const flds = e.objFields
      let k = 0
      while k < flds.length {
        const f = P.nodes[flds[k]]
        if f is FieldInit {
          let d = 0
          while d < fnames.length {
            if fnames[d] == f.fiName {
              if (
                monoCoerceFnValueName(f.fiValue, normTypeAtom(ftexts[d]), ctx) <
                0
              ) {
                return -1
              }
            }
            d = d + 1
          }
        }
        k = k + 1
      }
    }
    return 0
  }
  if e is ArrayLit {
    if nameIsClosureArray(tname) {
      // The `[]` cut stays raw here rather than `listElemNameOf`, whose naive paren
      // strip would mangle a non-wrapped function-type element (`(i32)=>(i32)` →
      // `i32)=>(i32`). `nameIsClosureArray` implies `nameIsArray`.
      const elemName = normTypeAtom(arrElemNameRaw(tname))
      const es = e.arrElems
      let k = 0
      while k < es.length {
        if monoCoerceFnValueName(es[k], elemName, ctx) < 0 { return -1 }
        k = k + 1
      }
    }
    return 0
  }
  if e is Paren { return monoCoerceFnValueName(e.parInner, tname, ctx) }
  if e is IfStmt {
    // An if-expression in value position. The expected type reaches every arm unchanged —
    // each arm independently produces the whole value — so the recursion is per-arm, not
    // per-element as it is for the composite literals. A `match` needs no limb: the checker
    // lowers an exhaustive one to an if/else chain in place.
    if monoCoerceFnValueName(e.ifThen, tname, ctx) < 0 { return -1 }
    return monoCoerceFnValueName(e.ifElse, tname, ctx)
  }
  if e is Block {
    // An arm's VALUE is its LAST statement, so that is the only position the expected type reaches.
    const bs = e.blkStmts
    if bs.length == 0 { return 0 }
    return monoCoerceFnValueName(bs[bs.length - 1], tname, ctx)
  }
  if e is Ident {
    // A bare function name, or a value binding holding a generic function (`const add =
    // (a,b) => a + b`, or `const g = named`) — resolve the binding to its lifted slot so an
    // escaping lambda binding materializes at the boundary type too.
    const gfe = monoFnFeOfIdent(exprIx, e.identName, ctx)
    if gfe >= 0 && gfe < monoGen.length {
      if monoGen[gfe] == 1 {
        const pnames: string[] = []
        if monoFnTypeAnnParamsName(tname, pnames) {
          return monoInstanceFor(gfe, pnames, exprIx)
        }
      }
    }
  }
  0
}

// Is `name` ever the target of an assignment anywhere in the arena? An arena scan rather
// than a scope walk, so it is coarse by name: a homonym in another frame answers true for
// both. That direction is the safe one — it declines a callee fold and leaves the
// `call_ref` the annotation already guarantees a signature for.
function monoNameIsAssigned(name: string) {
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is BinExpr {
      if nd.binOp == "=" {
        const tg = P.nodes[nd.binLeft]
        if tg is Ident {
          if tg.identName == name { return true }
        }
      }
    }
    i = i + 1
  }
  false
}

// `monoCoerceFnValueName` keyed on an expected TYPE-annotation node (`-1` / a non-function type is a
// no-op). `ctx` is the enclosing function (-1 = top level), for resolving a value binding.
function monoCoerceFnValue(exprIx: i32, expectedTyIx: i32, ctx: i32) {
  if expectedTyIx < 0 { return 0 }
  return monoCoerceFnValueName(exprIx, tyNameOf(expectedTyIx), ctx)
}

// The written type-annotation node of parameter `i` of the function occupying `fnStmts`
// slot `fe` — its original declaration, before monomorphization may replace the slot — or
// -1. Lets a call site read the concrete function type a callback parameter declares.
// Callers resolve `fe` through `monoFnFeOfIdent`, so the answer is spelling-independent.
function monoFnParamTypeAt(fe: i32, i: i32) {
  const declIx = monoFnDeclNodeAt(fe)
  if declIx < 0 { return -1 }
  const fn = P.nodes[declIx]
  if fn is FuncDecl {
    const ps = fn.fnParams
    if i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param { return p.parType }
    }
  }
  -1
}

// The declaration node whose parameter annotations `monoFnParamTypeAt` reads — the
// captured original for a template slot, the slot itself for an appended instance (which
// has no separate original and carries the pinned annotations). `monoOrigNode` is only as
// long as the declaration count; indexing past that end traps the compiler. -1 otherwise.
function monoFnDeclNodeAt(fe: i32) {
  if fe < 0 { return -1 }
  if fe >= fnStmts.length { return -1 }
  if fe < monoOrigNode.length { return monoOrigNode[fe] }
  fnStmts[fe]
}

// Does parameter `i` of the declaration at `fe` carry an annotation that mentions that
// declaration's own type parameters — `g: (U, U) => R` on `hof<U, R>`, or a plain `a: U`?
// `monoWalk`'s coercion loop must ask this: handing a type-variable-bearing parameter type
// to `monoCoerceFnValue` mints an instance spelled `U`, which no valtype ladder lowers (D58).
function monoFnParamAnnRidesTyParam(fe: i32, i: i32) {
  const pty = monoFnParamTypeAt(fe, i)
  if pty < 0 { return false }
  const declIx = monoFnDeclNodeAt(fe)
  if declIx < 0 { return false }
  const fn = P.nodes[declIx]
  if fn is FuncDecl {
    if fn.fnTyParams.length == 0 { return false }
    const ann = monoDeclAnnName(pty, tyNameOf(pty), fn.fnTyParams)
    return monoAnnHasTyParam(ann, fn.fnTyParams)
  }
  false
}

// Does this call hand a generic function value to a parameter whose annotation is an arrow
// riding the callee's own type parameters? The trigger for the pre-binding pass in
// `monoInstantiate`, asked so that pass changes nothing elsewhere: the two binding orders
// can only disagree when one parameter says `U = T` and another says `U = i32`.
function monoCallGenFnToTyParamArrow(
  params: i32[],
  args: i32[],
  typarams: string[],
  ctx: i32,
) {
  if typarams.length == 0 { return false }
  let i = 0
  while i < args.length && i < params.length {
    const p = P.nodes[params[i]]
    if p is Param {
      if p.parType >= 0 {
        const ann = monoDeclAnnName(p.parType, tyNameOf(p.parType), typarams)
        if annArrowAt(ann) >= 1 && monoAnnHasTyParam(ann, typarams) {
          const ax = unwrapParen(args[i])
          const av = P.nodes[ax]
          if av is Ident {
            const gfe = monoFnFeOfIdent(ax, av.identName, ctx)
            if gfe >= 0 && gfe < monoGen.length {
              if monoGen[gfe] == 1 { return true }
            }
          }
        }
      }
    }
    i = i + 1
  }
  false
}

// Instantiate (or reuse) the instance of generic `origFe` for the call at
// `callIx` (whose enclosing function is `ctx`, -1 = top level), and point the
// call site at it. Returns 0, or -1 via `emitFail`.
function monoInstantiate(origFe: i32, callIx: i32, ctx: i32) {
  const c = P.nodes[callIx]
  const fn = P.nodes[monoOrigNode[origFe]]
  if c is Call {
    if fn is FuncDecl {
      const args = c.callArgs
      const params = fn.fnParams
      if args.length != params.length {
        return emitFail(
          "emitProgram: monomorphize: wrong number of arguments calling `" +
            fn.fnName +
            "`",
        )
      }
      // Pin each parameter: an un-annotated param takes its argument's type
      // name; a type-param-riding annotation binds the type param (first use
      // wins, later uses take the binding); a concrete annotation is kept.
      const tvN: string[] = []
      const tvV: string[] = []
      const pinned: string[] = []
      // The arena type each pinned param denotes, parallel to `pinned`. Sourced from the
      // argument's recorded type and consumed only as a fallback where the pinned name
      // does not resolve. -1 = nothing known.
      const pinTys: i32[] = []
      // Pre-bind from the value arguments, and only when a generic function value is on
      // its way into an arrow parameter riding these type parameters (D58): the main
      // loop binds at first use, and `hof<U, R>(g: (U, U) => R, …)` uses `U` first at `g`.

      // The gate keeps the order change inert: where the argument is a concrete function
      // the two orders agree, so they differ only when one answer is a type variable.
      if monoCallGenFnToTyParamArrow(params, args, fn.fnTyParams, ctx) {
        let pb = 0
        while pb < args.length {
          const pbp = P.nodes[params[pb]]
          if pbp is Param {
            if pbp.parType >= 0 {
              const pbAnn = monoDeclAnnName(
                pbp.parType,
                tyNameOf(pbp.parType),
                fn.fnTyParams,
              )
              // The ARROW parameters are the ones whose binding is in question; every other
              // annotation reads its type off the argument the call actually passes.
              if annArrowAt(pbAnn) < 1 {
                if monoAnnHasTyParam(pbAnn, fn.fnTyParams) {
                  const pbConc = monoArgPinName(args[pb], ctx)
                  if pbConc != "" {
                    monoBindFromAnn(pbAnn, pbConc, fn.fnTyParams, tvN, tvV)
                  }
                }
              }
            }
          }
          pb = pb + 1
        }
      }
      let i = 0
      while i < args.length {
        const p = P.nodes[params[i]]
        if p is Param {
          if p.parType < 0 {
            // A parameter the checker already decided is not a hole, so the instance
            // pins the parameter's own type. `recordedParamPinName` is that one answer,
            // shared with `synthParamAnnots`; "" keeps the argument-derived pin.
            let an = recordedParamPinName(params[i])
            if an == "" { an = monoArgPinName(args[i], ctx) }
            if an == "" {
              return emitFail(
                "emitProgram: monomorphize: unsupported argument type for `" +
                  p.parName +
                  "` in a call to `" +
                  fn.fnName +
                  "`",
              )
            }
            pinned.push(an)
            pinTys.push(monoArgPinTyIx(args[i], ctx))
          } else {
            // The declared spelling where the annotation is a type parameter, the
            // arena's canon'd one everywhere else. Without it a parameter whose name
            // shadows a type alias arrives resolved and pins the alias's body type.
            const ann = monoDeclAnnName(
              p.parType,
              tyNameOf(p.parType),
              fn.fnTyParams,
            )
            const tp = monoTyParamOf(ann, fn.fnTyParams)
            if tp == "" {
              // A composite annotation riding type params (`Box<T>`): bind them by
              // matching the pattern against the argument's concrete type name, then
              // pin the substituted annotation. A concrete annotation pins unchanged.
              if monoAnnHasTyParam(ann, fn.fnTyParams) {
                // A function-type param (`f: (A, T) => A`) binds from the closure
                // argument's function-type name; any other composite (`Box<T>`, `{a:T}`)
                // from its concrete value-type name.
                let anC = ""
                if annArrowAt(ann) >= 1 {
                  anC = monoArgFnTypeName(args[i], ctx)
                } else {
                  anC = monoArgPinName(args[i], ctx)
                }
                if anC == "" {
                  return emitFail(
                    "emitProgram: monomorphize: unsupported argument type for `" +
                      p.parName +
                      "` in a call to `" +
                      fn.fnName +
                      "`",
                  )
                }
                monoBindFromAnn(ann, anC, fn.fnTyParams, tvN, tvV)
                const pinC = monoSubstAnn(ann, fn.fnTyParams, tvN, tvV)
                if pinC == "" {
                  return emitFail(
                    "emitProgram: monomorphize: unsupported argument type for `" +
                      p.parName +
                      "` in a call to `" +
                      fn.fnName +
                      "`",
                  )
                }
                // The coercion `monoWalk` deferred, since at that point the pin names
                // would be the type variables themselves. `pinC` is the substituted
                // spelling, the concrete function type that parameter takes.
                if annArrowAt(ann) >= 1 {
                  if monoCoerceFnValueName(args[i], pinC, ctx) < 0 { return -1 }
                }
                pinned.push(pinC)
                pinTys.push(monoArgPinTyIx(args[i], ctx))
              } else {
                pinned.push(ann)
                pinTys.push(monoArgPinTyIx(args[i], ctx))
              }
            } else {
              const an2 = monoArgPinName(args[i], ctx)
              if an2 == "" {
                return emitFail(
                  "emitProgram: monomorphize: unsupported argument type for `" +
                    p.parName +
                    "` in a call to `" +
                    fn.fnName +
                    "`",
                )
              }
              let bind = an2
              if ann != tp {
                // `T[]` param: the argument must be an array, and its element binds
                // `T`. `arrElemNameRaw` is the cut paired with `nameIsArray`, raw
                // because a composite element's grouping parens are part of the binding.
                if !nameIsArray(an2) {
                  return emitFail(
                    "emitProgram: monomorphize: expected an array argument for `" +
                      p.parName +
                      "` in a call to `" +
                      fn.fnName +
                      "`",
                  )
                }
                bind = arrElemNameRaw(an2)
              }
              const b = monoBindOf(tvN, tvV, tp)
              if b == "" {
                tvN.push(tp)
                tvV.push(bind)
              } else {
                bind = b
              }
              if ann != tp {
                pinned.push(bind + "[]")
                pinTys.push(monoArgPinTyIx(args[i], ctx))
              } else {
                pinned.push(bind)
                pinTys.push(monoArgPinTyIx(args[i], ctx))
              }
            }
          }
        }
        i = i + 1
      }
      // Callback specialization: for each closure-valued argument that is a known,
      // non-capturing, non-generic function, record the name so this instance bakes a
      // direct call and keys on its identity. Anything else leaves "" and a `call_ref`.
      const cbFnNames: string[] = []
      let ci = 0
      while ci < args.length {
        cbFnNames.push(monoSpecializableCallbackName(args[ci], ctx))
        ci = ci + 1
      }
      const pinKinds: i32[] = []
      const pinPays: string[] = []
      monoBuildPinCol(pinned, pinKinds, pinPays)
      return monoMakeInstance(
        origFe,
        pinned,
        pinKinds,
        pinPays,
        pinTys,
        tvN,
        tvV,
        c.callFn,
        false,
        cbFnNames,
      )
    }
  }
  0
}

// The callback name to bake for a closure-valued argument, or "" when it is not
// specializable: the argument must resolve to a known function that captures nothing and
// is itself non-generic, so a direct by-name call (which passes the null env a
// non-capturing callee wants) is valid. Anything else keeps the per-element `call_ref`.
function monoSpecializableCallbackName(argIx: i32, ctx: i32) {
  if !exprIsClosure(argIx, ctx) { return "" }
  const ax = unwrapParen(argIx)
  const an = P.nodes[ax]
  let fe = -1
  // The Ident arm is scope-aware, like the call and function-value paths: the flat
  // `fnIndexOf` hands every frame the module's first function of this name, so the two
  // soundness gates below would be asked about the wrong function whenever two frames
  // declare a same-named callback.
  if an is FuncDecl { fe = fnStmtsPosOf(ax) }
  else if an is Ident { fe = fnIndexOfInScope(an.identName, ctx) }
  if fe < 0 || fe >= fnStmts.length { return "" }
  if captureCountOf(fe) > 0 { return "" }
  if fe < monoGen.length {
    if monoGen[fe] == 1 { return "" }
  }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    // The bake is by name and the clone is top-level: `monoBakeCallback` rewrites the
    // callback param's call into a by-name call inside a fresh function pushed with
    // `fnParent = -1`, so the name is re-resolved with no enclosing frame. Decline rather
    // than bake a name that does not mean what the caller meant; `__lambda_N` is unique.
    if fe != fnIndexOf(fn.fnName) { return "" }
    return fn.fnName
  }
  ""
}

// Does the non-generic function at `fe` take a closure-typed parameter — is it a concrete
// higher-order function, a candidate for callback specialization? A `<T>` generic is
// excluded; its callbacks are already baked by `monoInstantiate` + `monoBakeCallback`.
function feHasClosureParam(fe: i32) {
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if fn.fnTyParams.length > 0 { return false }
    let i = 0
    while i < fn.fnParams.length {
      const p = P.nodes[fn.fnParams[i]]
      if p is Param {
        if p.parType >= 0 {
          if tyIsFuncType(p.parType) { return true }
        }
      }
      i = i + 1
    }
  }
  false
}

// Whether the program defines any concrete higher-order function — the gate that lets the
// mono pass run for callback specialization even with no `<T>` generic. The compiler
// itself has none, so the pass stays skipped for it and the all-i32 native fixpoint holds.
function monoHasConcreteHOFParam() {
  let fe = 0
  while fe < fnStmts.length {
    if fe < monoGen.length {
      if monoGen[fe] == 0 {
        if feHasClosureParam(fe) { return true }
      }
    }
    fe = fe + 1
  }
  false
}

// Callback specialization for a concrete (non-generic) higher-order function: clone it
// with a non-capturing callback baked in as a direct call, append it as `<name>$cbN`, and
// point the call site at it. Keyed purely on callback identity. Unlike a generic template
// the original is kept, so it still serves any non-bakeable caller. Returns 0, or -1.
function monoSpecializeConcrete(callIx: i32, fe: i32, ctx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const fn = P.nodes[fnStmts[fe]]
    if fn is FuncDecl {
      const params = fn.fnParams
      const args = c.callArgs
      if args.length != params.length { return 0 }
      // Only an annotated return is specialized. An un-annotated one is inferred through
      // the callback param's call, and baking that re-derives it via a path that does
      // not re-establish a nullable or union rep on the appended function.
      if fn.fnRet < 0 { return 0 }
      // The baked callback (and its param NAME) per position — "" where the argument is not a
      // non-capturing concrete function (a capturing lambda / generic / non-closure stays call_ref).
      const cbFnNames: string[] = []
      const cbParamNames: string[] = []
      let i = 0
      while i < args.length {
        const p = P.nodes[params[i]]
        if p is Param {
          cbParamNames.push(p.parName)
        } else {
          cbParamNames.push("")
        }
        cbFnNames.push(monoSpecializableCallbackName(args[i], ctx))
        i = i + 1
      }
      if !monoAnyBakedCallback(cbFnNames) { return 0 }
      // Both renames below point the call site at a specialization resolved from the
      // binding's initializer, faithful only while the binding still holds it. There is
      // no instance to keep, so declining simply leaves the `call_ref`.
      const spCal = P.nodes[c.callFn]
      if spCal is Ident {
        if spCal.identName != fn.fnName && monoNameIsAssigned(spCal.identName) {
          return 0
        }
      }
      // Key on the callee plus each baked callback identity, so `reduce(xs, add, …)` and
      // `reduce(xs, mul, …)` get distinct specializations. The `C` prefix keeps these out
      // of the generic keyspace, which always carries a `#`.
      let key = "C" + i32ToStr(fe)
      let kc = 0
      while kc < cbFnNames.length {
        if cbFnNames[kc] != "" { key = key + "@" + cbFnNames[kc] }
        kc = kc + 1
      }
      // Registry hit: a prior call already specialized this (callee, callback-set) — reuse it.
      let r = 0
      while r < monoKeys.length {
        if monoKeys[r] == key {
          const cal = P.nodes[c.callFn]
          // R4 writer 7 of 8 (`compiler/symbols.vl`; census in `perf-program.md`).
          if cal is Ident {
            cal.identName = monoInstName[r]
            monoArenaTouch()
            sidNoteNodeName(c.callFn)
          }
          return 0
        }
        r = r + 1
      }
      // Fresh specialization. `$cbN` is disambiguated by how many concrete specializations this
      // callee already has (its prior `monoInstOrig` entries).
      let count = 0
      let kk = 0
      while kk < monoInstOrig.length {
        if monoInstOrig[kk] == fe { count = count + 1 }
        kk = kk + 1
      }
      const instBody = monoBakeCallback(fn.fnBody, cbParamNames, cbFnNames)
      const nps: i32[] = []
      let pj = 0
      while pj < params.length {
        const p3 = P.nodes[params[pj]]
        if p3 is Param {
          nps.push(
            mkParam(p3.parName, p3.parType, p3.parDefault, p3.parOpt, p3.pos),
          )
          // D926 — as at the generic clone: the mark is arena-node keyed.
          anonLeafCarryParamMark(params[pj], nps[nps.length - 1])
        }
        pj = pj + 1
      }
      const noTP: string[] = []
      const specName = fn.fnName + "$cb" + i32ToStr(count)
      const nfn = mkFunc(specName, noTP, nps, fn.fnRet, instBody, fn.pos)
      // D926 — as above. The ORIGINAL declaration is kept here, so both it and the
      // specialization carry the mark and both signatures follow the merge.
      anonLeafCarryRetMark(fnStmts[fe], nfn)
      fnStmts.push(nfn)
      fnParent.push(-1)
      fnDispNames.push("")
      const instFe = fnStmts.length - 1
      // The in-place rename below lands on nodes this specialization may share. That
      // sharing is not divergent: a concrete declaration has all its parameters
      // annotated, so every specialization writes the same name.

      // What the sharing costs is the revisit: the body below is walked once per
      // specialization and once by the main loop, so a nested generic landing on a count>0
      // instance is re-read under its instance name (see `monoFnParamTypeAt`).
      const cal2 = P.nodes[c.callFn]
      // R4 writer 8 of 8 (`compiler/symbols.vl`; census in `perf-program.md`).
      if cal2 is Ident {
        cal2.identName = specName
        monoArenaTouch()
        sidNoteNodeName(c.callFn)
      }
      monoKeys.push(key)
      monoInstOrig.push(fe)
      monoInstName.push(specName)
      monoInstFe.push(instFe)
      if monoRebuild() < 0 { return -1 }
      // Walk the ORIGINAL body under this specialization's context so a nested generic call it
      // contains instantiates (idempotent via the registry — the main loop also walks the original).
      if monoWalk(fn.fnBody, nfn) < 0 { return -1 }
      if monoRebuild() < 0 { return -1 }
    }
  }
  0
}

// Walk the statement/expression tree at `ix` (inside function `ctx`, -1 = top level) and
// instantiate every direct call to a generic function. Arguments are walked before their
// call is classified, so an inner generic call's instance — and its now-concrete return
// kind — is in place when the outer call's argument types are read.
function monoWalk(ix: i32, ctx: i32) {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is Call {
    const args = n.callArgs
    let i = 0
    while i < args.length {
      if monoWalk(args[i], ctx) < 0 { return -1 }
      i = i + 1
    }
    const callee = P.nodes[n.callFn]
    if callee is Ident {
      // A generic function value passed as an argument to a concrete function-typed
      // parameter: materialize the instance for that declared function type. Only where
      // the declaration is concrete — the rest is deferred to `monoInstantiate`.
      const dfe = monoFnFeOfIdent(n.callFn, callee.identName, ctx)
      let ca = 0
      while ca < args.length {
        const pty = monoFnParamTypeAt(dfe, ca)
        if pty >= 0 {
          if !monoFnParamAnnRidesTyParam(dfe, ca) {
            if monoCoerceFnValue(args[ca], pty, ctx) < 0 { return -1 }
          }
        }
        ca = ca + 1
      }
      // Scope-aware, and that is load-bearing: `wasmEmit` lowers this same call through
      // `fnIndexOfInScopeChain`, so on a shared name the flat `fnIndexOf` disagrees and
      // leaves a nested `<T>` template for the prune to stub while the emitter calls it.
      let fe = fnIndexOfInScope(callee.identName, ctx)
      if fe < 0 {
        // A direct call through a value binding to a generic named function: resolve it
        // to the lifted slot and monomorphize per call site. Named functions only, and
        // re-read rather than reused from `dfe`, the coercion loop between having run.
        const afe = identClosureFeSid(sidOfNode(n.callFn), ctx)
        if afe >= 0 {
          if !criFnIsAnonLambda(afe) {
            // The fold below rewrites `f(x)` into a by-name call to the initializer's
            // instance, faithful only while the binding still holds it — hence the
            // restriction to an annotated binding, whose `$fnsig` the `call_ref` needs.
            if identFnTypeAnnName(callee.identName, ctx) == "" { fe = afe }
            else if !monoNameIsAssigned(callee.identName) { fe = afe }
          } else if identFnTypeAnnName(callee.identName, ctx) == "" {
            // A lambda bound to an un-annotated `const`: its params are inference holes,
            // so monomorphize it per call exactly like a named generic function. An
            // annotated binding is contextually pinned and excluded.
            fe = afe
          }
        }
      }
      if fe >= 0 && fe < monoGen.length {
        if monoGen[fe] == 1 { return monoInstantiate(fe, ix, ctx) }
        // A CONCRETE callee: specialize it per non-capturing callback (no-op if none) — the
        // concrete analogue of `monoInstantiate`'s callback baking.
        return monoSpecializeConcrete(ix, fe, ctx)
      }
      return 0
    }
    return monoWalk(n.callFn, ctx)
  }
  if n is Block {
    const bs = n.blkStmts
    let i2 = 0
    while i2 < bs.length {
      if monoWalk(bs[i2], ctx) < 0 { return -1 }
      i2 = i2 + 1
    }
    return 0
  }
  if n is LetDecl {
    // An annotated function-typed binding to a generic named function: materialize the
    // instance for the annotation's param types and point the binding at it, so the value
    // carries that concrete type independent of any call — it may escape where call-driven
    // monomorphization cannot reach.
    if monoCoerceFnValue(n.letInit, n.letType, ctx) < 0 { return -1 }
    return monoWalk(n.letInit, ctx)
  }
  if n is IfStmt {
    if monoWalk(n.ifCond, ctx) < 0 { return -1 }
    if monoWalk(n.ifThen, ctx) < 0 { return -1 }
    return monoWalk(n.ifElse, ctx)
  }
  if n is WhileStmt {
    if monoWalk(n.whileCond, ctx) < 0 { return -1 }
    return monoWalk(n.whileBody, ctx)
  }
  if n is ForRange {
    if monoWalk(n.frFrom, ctx) < 0 { return -1 }
    if monoWalk(n.frTo, ctx) < 0 { return -1 }
    if monoWalk(n.frStep, ctx) < 0 { return -1 }
    return monoWalk(n.frBody, ctx)
  }
  if n is ForIn {
    if monoWalk(n.fiIter, ctx) < 0 { return -1 }
    return monoWalk(n.fiBody, ctx)
  }
  if n is RetStmt {
    // A generic function value RETURNED where the enclosing function declares a concrete function
    // return type (`function mk(): (f64,f64)=>f64 { return add }`): materialize the instance for
    // that return type so the returned value carries it.
    if ctx >= 0 {
      const cf = P.nodes[ctx]
      if cf is FuncDecl {
        if monoCoerceFnValue(n.retArg, cf.fnRet, ctx) < 0 { return -1 }
      }
    }
    return monoWalk(n.retArg, ctx)
  }
  if n is BinExpr {
    // Assignment to a function-typed binding (`let f: (i32,i32)=>i32 = mul; f = add`). The
    // declared type is the same boundary the `LetDecl` arm reads, so a generic reaching it
    // through a later `=` materializes identically. "" is a no-op.
    if n.binOp == "=" {
      const tgt = P.nodes[n.binLeft]
      if tgt is Ident {
        const atn = identFnTypeAnnName(tgt.identName, ctx)
        if atn != "" {
          if monoCoerceFnValueName(n.binRight, atn, ctx) < 0 { return -1 }
        }
      }
    }
    if monoWalk(n.binLeft, ctx) < 0 { return -1 }
    return monoWalk(n.binRight, ctx)
  }
  if n is Unary { return monoWalk(n.unArg, ctx) }
  if n is Paren { return monoWalk(n.parInner, ctx) }
  if n is Member { return monoWalk(n.memObj, ctx) }
  if n is OptMember { return monoWalk(n.omObj, ctx) }
  if n is Index {
    if monoWalk(n.idxArr, ctx) < 0 { return -1 }
    return monoWalk(n.idxIndex, ctx)
  }
  if n is IsExpr { return monoWalk(n.isObj, ctx) }
  if n is AsExpr { return monoWalk(n.asObj, ctx) }
  if n is ArrayLit {
    const es = n.arrElems
    let i3 = 0
    while i3 < es.length {
      if monoWalk(es[i3], ctx) < 0 { return -1 }
      i3 = i3 + 1
    }
    return 0
  }
  if n is ObjLit {
    const fs = n.objFields
    let i4 = 0
    while i4 < fs.length {
      const f = P.nodes[fs[i4]]
      if f is FieldInit {
        if monoWalk(f.fiValue, ctx) < 0 { return -1 }
      }
      i4 = i4 + 1
    }
    return 0
  }
  // A nested `FuncDecl`'s body is walked through its own `fnStmts` slot (lambda-lifted);
  // every other node kind has no call-bearing children. `MatchExpr` never
  // reaches here: the checker lowers every exhaustive `match` to an if/else chain and
  // overwrites the arena slot in place, so by emit time its arms sit in `IfStmt` limbs.
  0
}

// Walk function `fnIx`'s own body, coercing its implicit return first. A bare-expression
// body parses to a synthetic one-statement `Block` with no `RetStmt`, so `monoWalk`'s
// `RetStmt` arm has nothing to read; the value of a body block is its last statement,
// which is what `monoCoerceFnValueName`'s `Block` arm walks to.
function monoWalkFnBody(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    if monoCoerceFnValue(fn.fnBody, fn.fnRet, fnIx) < 0 { return -1 }
    return monoWalk(fn.fnBody, fnIx)
  }
  0
}

// Is `name` part of the module's wasm ABI — the public name, or the internal target of a
// staged export alias? The driver fills `reExpName`/`reExpTarget` before `emitProgram`
// runs, so both are populated by the time the prune reads them. Both are consulted: the
// module path's public name may differ from its mangled target.
function monoNameIsExported(name: string) {
  let i = 0
  while i < reExpTarget.length {
    if reExpTarget[i] == name { return true }
    i = i + 1
  }
  let j = 0
  while j < reExpName.length {
    if reExpName[j] == name { return true }
    j = j + 1
  }
  false
}

// The `fnStmts` position `emitExportSection` would resolve `name` to: the first slot
// holding a `FuncDecl` of that name. The mirroring is load-bearing — `monoNameIsExported`
// answers about a name, but two slots can carry one name and only one is the ABI entry.
// The other is ordinary dead code that must keep taking the silent no-op stub.

// Prior iterations of the prune loop only ever replace a slot with a same-named stub, so
// the answer does not depend on how far the prune has walked.
function monoFirstFnIndexNamed(name: string): i32 {
  let i = 0
  while i < fnStmts.length {
    const f = P.nodes[fnStmts[i]]
    if f is FuncDecl {
      if f.fnName == name { return i }
    }
    i = i + 1
  }
  -1
}

// The public name an ABI entry publishes `name` under — for the diagnostic below, so it
// names what the user wrote. In module mode a merged name is mangled and a re-export may
// rename it, so the raw `fnName` is not something the source contains. Falls back to
// `name`.
function monoExportPublicName(name: string): string {
  let i = 0
  while i < reExpTarget.length {
    if reExpTarget[i] == name { return reExpName[i] }
    i = i + 1
  }
  name
}

// Did `monomorphize` pin the generic declaration at lifted position `origFe` from at least
// one call site? Every instantiation records a row, the count-0 one included, so this is
// the rename-immune answer, asked after the pass has rewritten callee identifiers to
// instance names — which is why counting `Ident`s cannot answer it.

// A template nothing instantiated still emits its body at the i32 default, and that body
// is only accidentally valid, so every value-floor exemption handing one out as a closure
// has to demand this first.
export function monoInstantiatedAny(origFe: i32) {
  let k = 0
  while k < monoInstOrig.length {
    if monoInstOrig[k] == origFe { return true }
    k = k + 1
  }
  false
}

// The distinct concrete parameter spellings every instance pinned for the generic
// declaration at `origFe`, comma-joined — or "" when no call site pinned it. The
// diagnostic half of `monoInstantiatedAny`. `monoInstFe` can name an appended slot, so
// the bound is `fnStmts.length`.
export function monoPinnedSigsOf(origFe: i32) {
  const sigs: string[] = []
  let k = 0
  while k < monoInstOrig.length {
    if monoInstOrig[k] == origFe {
      const ife = monoInstFe[k]
      if ife >= 0 && ife < fnStmts.length {
        const fn = P.nodes[fnStmts[ife]]
        if fn is FuncDecl {
          let sig = "("
          const ps = fn.fnParams
          let i = 0
          while i < ps.length {
            if i > 0 { sig = sig + ", " }
            const p = P.nodes[ps[i]]
            if p is Param {
              if p.parType >= 0 {
                sig = sig + tyNameOf(p.parType)
              } else {
                sig = sig + "i32"
              }
            }
            i = i + 1
          }
          // Two instances can render the same spelling (their keys differ in a baked CALLBACK,
          // not in a parameter type), and a repeated signature reads as a compiler bug.
          pushUniqueAtom(sigs, sig + ")")
        }
      }
    }
    k = k + 1
  }
  let out = ""
  let j = 0
  while j < sigs.length {
    if j > 0 { out = out + ", " }
    out = out + sigs[j]
    j = j + 1
  }
  out
}

// Which of `names` is referenced as a function value — an `Ident` that is not some
// `Call`'s callee — anywhere in the node arena. Returns an `i32[]` parallel to `names`.
// One arena pass however many names are asked about. This is the soundness gate the
// un-annotated-param prune needs: such a function is an ordinary first-class value.
function monoNamesUsedAsValue(names: string[]): i32[] {
  const hit: i32[] = []
  let h = 0
  while h < names.length {
    hit.push(0)
    h = h + 1
  }
  if names.length == 0 { return hit }
  const isCallee: i32[] = []
  let i = 0
  while i < P.nodes.length {
    isCallee.push(0)
    i = i + 1
  }
  let j = 0
  while j < P.nodes.length {
    const cn = P.nodes[j]
    if cn is Call {
      const cf = cn.callFn
      // arena-tick exempt: `isCallee` is a local declared in this function.
      if cf >= 0 && cf < isCallee.length { isCallee[cf] = 1 }
    }
    j = j + 1
  }
  let k = 0
  while k < P.nodes.length {
    if isCallee[k] == 0 {
      const idn = P.nodes[k]
      if idn is Ident {
        let m = 0
        while m < names.length {
          // arena-tick exempt: `hit` is this function's own out-parameter list.
          if names[m] == idn.identName { hit[m] = 1 }
          m = m + 1
        }
      }
    }
    k = k + 1
  }
  hit
}

// The lifted-function position of the generic named function the module-level binding at
// `letIx` aliases, when handing that template out as this binding's closure value is sound
// — else -1. Three gates, each load-bearing: an un-annotated-param named function,
// instantiated at least once, and never referenced as a value.
export function monoGenericAliasFe(letIx: i32) {
  if letIx < 0 { return -1 }
  const d = P.nodes[letIx]
  if d is LetDecl {
    const fe = fieldValueFeOf(d.letInit)
    if fe < 0 { return -1 }
    if !fnHasUnannotatedParam(fe) { return -1 }
    if criFnIsAnonLambda(fe) { return -1 }
    if !monoInstantiatedAny(fe) { return -1 }
    const one: string[] = []
    one.push(d.letName)
    const used = monoNamesUsedAsValue(one)
    if used[0] == 1 { return -1 }
    return fe
  }
  -1
}

// The `fnStmts` slot of the lambda a lifted lambda's own binding already holds — the
// binding's initializer — when this lambda reached its slot through an assignment
// (`f = (a) => …`), or -1. One binding owns one closure cell carrying one functype, so
// every lambda written into it has to be lowered at the same signature.

// Exactly one assignment, or -1: a lambda literal written into two different bindings has
// no single signature to adopt. The frame comes from `fnParent`, which is what
// `identClosureFeSid` wants for a function-scoped `let`.
function monoAssignedPeerFe(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const node = fnStmts[fe]
  let tgt = -1
  let seen = 0
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is BinExpr {
      if nd.binOp == "=" && nd.binRight == node {
        const lt = P.nodes[nd.binLeft]
        if lt is Ident {
          tgt = nd.binLeft
          seen = seen + 1
        }
      }
    }
    i = i + 1
  }
  if seen != 1 || tgt < 0 { return -1 }
  let ctx = -1
  if fe < fnParent.length {
    const pp = fnParent[fe]
    if pp >= 0 && pp < fnStmts.length { ctx = fnStmts[pp] }
  }
  const peer = identClosureFeSid(sidOfNode(tgt), ctx)
  if peer == fe { return -1 }
  peer
}

// The concrete parameter spellings a lifted slot's declaration carries, appended to `out`
// — an instance's pins, read the way `monoPinnedSigsOf` reads them, with `"i32"` for the
// hole a count-0 all-i32 clone deliberately leaves un-annotated. false when the slot is
// not a function declaration at all.
function monoSlotParamPins(fe: i32, out: string[]) {
  if fe < 0 || fe >= fnStmts.length { return false }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param {
        if p.parType >= 0 {
          out.push(tyNameOf(p.parType))
        } else {
          out.push("i32")
        }
      } else {
        return false
      }
      i = i + 1
    }
    return true
  }
  false
}

// The monomorphization pass: snapshot which lifted functions are generic, then walk every
// top-level statement in program order and every non-generic function body; instance
// bodies are walked as they are created. Usage-gated: a program with no generic
// declaration and no concrete higher-order function returns immediately.
export function monomorphize(stmts: i32[]) {
  monoArenaTick = 0
  monoRebuiltStamp = 0 - 1
  monoGen = []
  monoOrigNode = []
  monoKeys = []
  monoInstOrig = []
  monoInstName = []
  monoInstFe = []
  monoProgStmts = stmts
  monoLamPinned = []
  monoLamShared = []
  let any = false
  let fe = 0
  while fe < fnStmts.length {
    monoOrigNode.push(fnStmts[fe])
    if monoIsGenericDecl(fnStmts[fe]) {
      monoGen.push(1)
      any = true
    } else {
      monoGen.push(0)
    }
    fe = fe + 1
  }
  // The pass also runs for callback specialization of a concrete higher-order function.
  // Gated on the program actually defining one, so a generic-free, HOF-free program (the
  // compiler itself) skips the pass entirely.
  if !any {
    if monoHasConcreteHOFParam() { any = true }
  }
  if !any { return 0 }
  // Top-level statements first, in source order (global inits + start stmts).
  let i = 0
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    if s is FuncDecl {
    } else if s is LetDecl {
      // Walk the `LetDecl` node, not just its init, so the annotated-function-typed
      // binding materialization in `monoWalk`'s `LetDecl` arm reaches a top-level binding
      // too; the arm still recurses into the init.
      if monoWalk(stmts[i], -1) < 0 { return -1 }
    } else if nodeIsTypeDecl(stmts[i]) {
    } else if s is UnionDecl {
    } else {
      if monoWalk(stmts[i], -1) < 0 { return -1 }
    }
    i = i + 1
  }
  // Then every non-generic lifted function's body. A generic original's body is only ever
  // walked through an instance; an instance appended during this loop extends `fnStmts`,
  // but its body is walked on creation — `monoGen` is frozen at the pre-pass length.
  let fe2 = 0
  const nDecl = monoGen.length
  while fe2 < nDecl {
    if monoGen[fe2] == 0 {
      if monoWalkFnBody(fnStmts[fe2]) < 0 { return -1 }
    }
    fe2 = fe2 + 1
  }
  // The lambda half of that loop. `monoGen == 1` covers two carriers alike only on paper: a
  // named generic is reached only through `monoInstantiate`, while a lifted anonymous lambda
  // is instantiated only when a call goes through its own binding. Walked here, after the
  // two loops, because instantiation is settled only once every call site has been seen.
  let fe3 = 0
  while fe3 < nDecl {
    if monoGen[fe3] == 1 && criFnIsAnonLambda(fe3) {
      if !monoInstantiatedAny(fe3) {
        // The binding's signature first, where this lambda got its slot from an `f = …`
        // write: pinning it from its peer is what makes the two lambdas one cell. The
        // cascade's catch-all instead puts an i32 parameter under an f64-typed cell.
        const peer = monoAssignedPeerFe(fe3)
        if peer >= 0 && peer < nDecl && monoInstantiatedAny(peer) {
          const pins: string[] = []
          if monoSlotParamPins(peer, pins) {
            const own = P.nodes[fnStmts[fe3]]
            if own is FuncDecl {
              if own.fnParams.length == pins.length {
                if monoInstanceFor(fe3, pins, fnStmts[fe3]) < 0 { return -1 }
              }
            }
          }
        }
        // `monoInstanceFor` declines silently on a boundary it cannot reproduce, so the
        // walk is gated on the outcome rather than on having tried — a declined pin
        // still needs its body walked.
        if !monoInstantiatedAny(fe3) {
          if monoWalkFnBody(fnStmts[fe3]) < 0 { return -1 }
        }
      }
    }
    fe3 = fe3 + 1
  }
  // Prune the un-instantiated `<T>` generics into a concrete no-op stub (same name, no
  // params, void body). The first instance replaces the slot, so a slot still equal to its
  // captured original has no caller; importing a module for some of its generics pulls in
  // all of them, so this is routine.

  // An exported `<T>` is a reject, not a stub: the stub keeps the name, so the export
  // section would publish a `() -> void` ABI. Three gates narrow the hole half — not an
  // anon lambda, not exported, and not used as a value.
  const cndFe: i32[] = []
  const cndNm: string[] = []
  let gc = 0
  while gc < nDecl {
    if fnStmts[gc] == monoOrigNode[gc] {
      const cfn = P.nodes[fnStmts[gc]]
      if cfn is FuncDecl {
        if cfn.fnTyParams.length == 0 && monoGen[gc] == 1 && cfn.fnName != "" {
          if !criFnIsAnonLambda(gc) {
            if !monoNameIsExported(cfn.fnName) {
              cndFe.push(gc)
              cndNm.push(cfn.fnName)
            }
          }
        }
      }
    }
    gc = gc + 1
  }
  const cndVal = monoNamesUsedAsValue(cndNm)
  let gp = 0
  while gp < nDecl {
    if fnStmts[gp] == monoOrigNode[gp] {
      const gfn = P.nodes[fnStmts[gp]]
      if gfn is FuncDecl {
        let prune = false
        if gfn.fnTyParams.length > 0 {
          // The slot is still the captured template and is the one the export section
          // resolves to, so the stub below would publish its name at `() -> void`.
          // Reject loudly instead, under the public name.
          let isAbiSlot = false
          if monoNameIsExported(gfn.fnName) {
            if monoFirstFnIndexNamed(gfn.fnName) == gp { isAbiSlot = true }
          }
          if isAbiSlot {
            const pubNm = monoExportPublicName(gfn.fnName)
            return emitFail(
              "emitProgram: the exported generic function `" +
                pubNm +
                "` is never instantiated, so there is no concrete signature to export " +
                "(a wasm export names one functype and `" +
                pubNm +
                "` names none) — call it in this module, or export a concrete wrapper",
            )
          }
          prune = true
        } else {
          let ci = 0
          while ci < cndFe.length {
            if cndFe[ci] == gp && cndVal[ci] == 0 { prune = true }
            ci = ci + 1
          }
          // D426 — the lambda template, the `<T>` arm above one frame down. Each
          // instance mints its own copy with the pin substituted. Gate (1) is inverted
          // here, the property being decided by the annotation rather than by the slot.
          if !prune {
            if criFnIsAnonLambda(gp) && monoLamSlotIsTyParamTemplate(gp) {
              // Two ledgers, both load-bearing: stub the template only when a clone
              // actually replaced it, or when no enclosing frame is instantiated. A
              // declined template is one an instance body still calls by name.
              const lnd = fnStmts[gp]
              if !monoI32ListHas(monoLamShared, lnd) {
                if monoI32ListHas(monoLamPinned, lnd) { prune = true }
                else if !monoLamFrameInstantiated(gp) { prune = true }
              }
            }
          }
        }
        if prune {
          const noTP: string[] = []
          const noPs: i32[] = []
          fnStmts[gp] = mkFunc(
            gfn.fnName,
            noTP,
            noPs,
            -1,
            mkBlock([], gfn.pos),
            gfn.pos,
          )
          monoArenaTouch()
        }
      }
    }
    gp = gp + 1
  }
  0
}

// Does the annotation node `ix` mention any of `typarams`? The parser's spelling tree
// answers where it survives, and the string form where it does not. `tsMentionsAnyName`
// visits every kid of every node, so it cannot have a missing arm; `monoAnnHasTyParam`
// re-parses the render and needs one arm per shape, a missing one being silent.

// The name form stays for nodes with no tree: `annTsOf` answers -1 once
// `canonEmitTypeNames` rewrites a name in place, and answering false there would skip the
// substitution and let the type parameter survive into the instance.
function monoAnnMentionsTyParam(ix: i32, ann: string, typarams: string[]) {
  const root = annTsOf(ix)
  if root >= 0 { return tsMentionsAnyName(root, typarams) }
  monoAnnHasTyParam(ann, typarams)
}
