// ── Per-callsite monomorphization (host: toWasm.ts `instantiate`) ────────────
// A GENERIC lifted function — explicit `<T>` type params, or any UN-ANNOTATED
// parameter (an inference hole the checker pins per call site) — has no single
// wasm signature, so each DIRECT call resolves to a concrete INSTANCE: a clone
// whose generic annotations are replaced by the call's concrete type NAMES.
// Instances are keyed by `(decl, pinned-param-names)` and registered BEFORE the
// body is walked, so a recursive self-call at the same shape hits the registry
// instead of looping. THE INVARIANT IS FUNCTION-INDEX STABILITY: the first
// instance REPLACES the original's `fnStmts` slot, each later DISTINCT shape
// APPENDS `name$N`, and a program with no generic call creates none. See
// `docs/internals/monomorphization-design.md` for the host oracle and the two
// deliberate divergences (eager pre-pass; clones share the body arena nodes).

// PREFER the checker's recorded function type: for an UN-annotated lambda arg it inferred the
// param types from the generic param's substituted expected type at the call site —
// `mapArr([1,2,3], (x) => x*2)` types `f` as `(i32) => i32`, which the syntactic build below
// CANNOT recover. Used only when it yields a complete `(params)=>ret` name; anything else falls
// through. The checker renders a struct part STRUCTURALLY, so NOMINALIZE it once here and every
// downstream site (`R[]` validation, ref-list interning, the binding type) keys on the declared
// name rather than each re-bridging the shape.
//
// THE GATE IS THE ARENA, not a render: "is this a function type" is `nodeTyIsFunc`, and
// `nominalizeFnTypeOfTy` walks the `TyFunc` the deleted name-side twin used to walk through its
// own rendering. B201 in `docs/internals/destringify-types-program.md` is why the arena and not
// the mono layer's usual spelling, and grades the lockstep that made the swap a replacement.

// A struct or struct-ARRAY annotation NAME usable as a monomorphization pin during the mono
// pass (when the locals/struct-classification tables are unbuilt): the bare struct `P` (`T`
// binds it), or a struct array `P[]` (`T[]` binds its element). "" for anything else (a scalar
// / list annotation already resolves through the `expr*` classifiers below). One level of `[]`
// — a deeper `P[][]` stays out of scope (falls through to the existing behavior).
//
// The `[]` test + cut are `emit_base`'s two homes (`nameIsArray` / `arrElemNameRaw`, #1175).
// `n >= 3` stays in front of the test: it excludes the degenerate `"[]"`, whose raw cut is ""
// and which `isSName("")` would answer for — not a widening this site asks.
// D970 — does this function's RETURN SET disagree with `reIx`, the type of the ONE return
// expression the mint above is derived from? Conservative by construction: false whenever it
// cannot see the returns, so every single-return instance keeps today's mint byte for byte.
import { collectValuedReturnsIn } from "./emit_query"

// D943 — THE LIFTED SLOTS `monoPinBodyLambdas` MINTED FOR THE INSTANCE BEING BUILT. A clone's
// `fnParent` cannot be set at clone time: the instance's own `FuncDecl` does not exist yet
// (its body is what the walk is producing), so the clone inherits the TEMPLATE's parent and
// its captures then type against `value: T` — one env layout for every instance, which is
// the whole defect. Recorded here and re-pointed the moment the instance is lifted.
let monoLamMintedSlots: i32[] = []

// D1046 — IS THIS THE FIRST INSTANCE OF THE GENERIC BEING BUILT? Set beside
// `monoLamMintedSlots` at the one `monoPinBodyLambdas` call site, and read by the
// NESTED NAMED FUNCTION arm alone, which needs it for a reason the anonymous-lambda
// arm does not have: a lambda is reached through the BINDING the clone is written
// into, so template and clone can coexist, while a named nested function is called
// BY NAME through the lexical frame chain (`nestedFnDeclaredIn`, first match wins).
// At `count == 0` the instance REUSES the template's own slot (`fnStmts[origFe] =
// nfn`), so template and clone would be two children of one frame under one name
// and the call would answer the unsubstituted template. The first instance
// therefore REPLACES the template's lifted slot instead of pushing beside it.
let monoInstIsFirst = false

// D1046 — the lifted slot a NAMED nested template was replaced in, keyed by the
// template's own node. The first instance overwrites `fnStmts[slot]` (above), which
// breaks the "scan `fnStmts` for this node" lookup that `monoLamNodeIsTemplate` and
// the capture-only rung both use to find a template's slot — and that lookup answering
// -1 at the SECOND instance turns a capture-only template into "not a template",
// silently sharing one env struct across two pins, which is D943 exactly.
const monoNamedTmplNode: i32[] = []
const monoNamedTmplSlot: i32[] = []

// The lifted slot holding node `fnIx` — the plain scan, plus the replacement table for
// a named template whose slot now holds its first instance. One home, because two
// call sites asked the same question with the same loop and only one of them would
// have been fixed.
function monoSlotOfLamNode(fnIx: i32) {
  let fe = 0 - 1
  let k = 0
  while k < fnStmts.length {
    if fnStmts[k] == fnIx { fe = k }
    k = k + 1
  }
  if fe >= 0 { return fe }
  let r = 0
  while r < monoNamedTmplNode.length {
    if monoNamedTmplNode[r] == fnIx { return monoNamedTmplSlot[r] }
    r = r + 1
  }
  -1
}

// Is `nm` a SOURCE function name rather than the emitter's synthesized lambda name?
// `collectFns` rewrites an anonymous lambda's empty name to `__lambda_N` BEFORE
// monomorphize runs, so `fnName != ""` is true of every lifted lambda and is not the
// test — reading it as one made every capturing lambda take the named path and lose
// its per-instance env (measured: `function k<T>(x: T) { const via = () => x; … }`
// went from `runs` to invalid wasm). Same rule as `criFnIsAnonLambda`, asked of a name
// rather than of a slot.
function monoFnNameIsSourceNamed(nm: string) {
  if nm == "" { return false }
  if nm.length >= 8 && nm.slice(0, 8) == "__lambda" { return false }
  true
}

function monoArgFnTypeName(argIx: i32, _fnIx: i32) {
  const ax = unwrapParen(argIx)
  const an = P.nodes[ax]

  if nodeTyIsFunc(ax) {
    const cn = nodeTyName(ax)
    if cn != "" { return nominalizeFnTypeOfTy(nodeTyIxOf(ax)) }
  }
  let fe = -1
  if an is FuncDecl { fe = fnStmtsPosOf(ax) }
  else if an is Ident { fe = fnIndexOf(an.identName) }
  if fe < 0 || fe >= fnStmts.length { return "" }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    let nm = "("
    let i = 0
    while i < fn.fnParams.length {
      const p = P.nodes[fn.fnParams[i]]
      if p is Param {
        if p.parType < 0 { return "" }
        const pn = tyNameOf(p.parType)
        if pn == "" { return "" }
        if i > 0 { nm = nm + "," }
        nm = nm + pn
      }
      i = i + 1
    }
    const rn = cloRetTypeName(fe)
    if rn == "" { return "" }
    return nm + ")=>" + rn
  }
  ""
}

function monoRetJoinDisagrees(fnNodeIx: i32, reIx: i32): boolean {
  if reIx < 0 { return false }
  if fnNodeIx < 0 { return false }
  const f = P.nodes[fnNodeIx]
  if f is FuncDecl {
    const rets: i32[] = []
    collectValuedReturnsIn(f.fnBody, rets)
    let i = 0
    while i < rets.length {
      const rt = nodeTyIxOf(rets[i])
      if rt >= 0 {
        // CONCRETE disagreement only. A return whose type is (or contains) a type VARIABLE
        // is per-call-site — `pick(a, b, c) { if a { return b }; c }` returns two TyVars —
        // and declining the mint for it turns the deferred-join family from a loud refusal
        // into invalid wasm (measured: `relay(x) { pick(x, "s", true) }`). Only a genuine
        // multi-arm CONCRETE join is this row's defect.
        if !tyHasTyVar(rt) {
          if rt != reIx { return true }
        }
      }
      i = i + 1
    }
  }
  false
}

function monoStructAnnName(name: string) {
  if isSName(name) { return name }
  const n = name.length
  if n >= 3 && nameIsArray(name) {
    if isSName(arrElemNameRaw(name)) { return name }
  }
  ""
}

// The annotation NAME of an ANNOTATED local / parameter whose type is a list over a COMPOSITE
// element — a nested list (`i32[][]`), a paren group (`(i32|null)[]`), an inline shape
// (`{a:i32}[]`) — or "". The `expr*` cascade cannot name these: it reads the EXPRESSION, and
// mid-mono the locals table is unbuilt, so a nested list falls to `exprArray`'s catch-all and
// pins one dimension short of what the CHECKER typed. Element test = the three GROUP grammars
// (`nameIsArray` / `nameIsParenSpanEnds` / `nameIsBraceSpanEnds`); a SCALAR-element list is
// `monoScalarAnnName`'s half of the same partition.

// The MODULE-scope `LetDecl` for `name`, or -1. Declines by a SHADOW TEST — a `let`/`const` of
// this name anywhere in the body, or a parameter of it — never on `fnIx >= 0`, which conflated
// "this name is a local, read its annotation" with "this name is not a local at all" and left a
// global-argument generic call with no annotation channel (D703).
//
// MODULE SCOPE HAS TWO STORAGE CLASSES and the flat scan over `monoProgStmts` is one: a binding
// inside a top-level block is a start-function LOCAL, absent from that list, so every pin
// channel declined and the `"i32"` catch-all declared an i32 parameter over a `(ref $type)`
// argument (D1596). `moduleLocalLetOfUnique` is the other class's table, and UNIQUE because it
// is first-wins over a walk with no notion of which block the call site sits in — answering for
// a duplicated name hands one block's rep to another block's call, a `runs -> not-runs`.
function monoModuleLetOf(name: string, fnIx: i32) {
  if fnIx >= 0 {
    if paramTypeNode(fnIx, name) >= 0 { return -1 }
    const shf = P.nodes[fnIx]
    if shf is FuncDecl {
      if parentLetOf(shf.fnBody, name) >= 0 { return -1 }
    } else {
      return -1
    }
  }
  let i = 0
  while i < monoProgStmts.length {
    const s = P.nodes[monoProgStmts[i]]
    if s is LetDecl {
      if s.letName == name { return monoProgStmts[i] }
    }
    i = i + 1
  }
  moduleLocalLetOfUnique(emitRootIx, name)
}

// THE ONE HOME for "which annotation NAME can serve as a monomorphization pin". The
// annotated-LOCAL and PARAM arms of `monoArgTyName` each carried this ladder verbatim, so a
// spelling added to one and not the other silently answered for a local and not for the
// parameter a generic FORWARDER hands on — which is how a `boolean[]` argument reached the
// inner instance as `i32[]` while the direct call was correct.
//
// Both callers exist because mid-mono the `expr*` rep cascade cannot classify a binding at
// all (`buildLocals` is post-mono), so the ANNOTATION is the only truth; both sit behind
// `fnIx >= 0`. "" means "no pin from the annotation" and the cascade answers instead.
function monoAnnPinName(name: string) {
  const r = monoStructAnnName(name)
  if r != "" { return r }
  // A UNION-typed annotation (`a: Cat | Dog`, or an alias): bind `T` to the union NAME so
  // the instance's param/return ride the union box. `isUName` covers a registered inline
  // union and a `type … = … | …` alias (both in `unNames`).
  if isUName(name) { return name }
  // …AND ITS **LIST** RUNG (D1082) — the THIRD instance in this ladder of a bare rung whose
  // array complement was missing, after the union-ARM pair below and the struct pair in
  // `monoStructAnnName`, which has had both rungs from the start. `first<T>(xs: T[])` over a
  // `const xs: Shape[]` refused `monomorphize: expected an array argument` — about an argument
  // the checker had already proved is an array of the right element — because `isUName` is
  // false for an array name and every other arm declines a nominal union element, so the
  // cascade's `"i32"` catch-all answered. One hole, two messages, the other being
  // `unsupported argument type` at module scope and at a forwarded parameter.
  //
  // The pin is the caller's OWN spelling, safe because the identical program through a
  // NON-generic `firstS(xs: Shape[])` runs. It SUBSUMES the literal-union `K[]` rung further
  // down — a litunion alias is in `unNames` too — now stated as the special case it always was.
  if nameIsArray(name) {
    if isUName(arrElemNameRaw(name)) { return name }
  }
  // A declared union ARM (`Circle`, a member of `type Shape = Circle | Sq`) — the kind-8
  // VARIANT, whose slot is `(ref $uVarHeap[vi])`. `monoStructAnnName` above declines it BY
  // CONSTRUCTION (a variant has no struct row, which is the gate `nulVariantIndexOf` applies),
  // `isUName` declines it because an arm is not the union, and every channel below answers
  // about the REP — so the argument fell to the `"i32"` catch-all and the instance declared an
  // i32 parameter over a `(ref $type)` value: `vl check` rc 0, `type mismatch` at load (D23).
  //
  // The pin is the arm's OWN spelling, which is `monoScalarAnnName`'s exact-name safety property
  // read straight: `x: Circle` is an annotation a NON-generic function already lowers end to
  // end. It ALSO gives `monoNulAnnName` its `Circle | null` for free — that helper delegates its
  // base to this ladder so there is ONE membership list, and the niche's
  // `(ref null $uVarHeap[vi])` cell is one an annotated parameter already lowers too.
  if variantIndexOf(name) >= 0 { return name }
  // …AND THE **LIST** RUNG OF THAT SAME ARM (silent-class-inventory D37). `monoStructAnnName`
  // is the STRUCT twin of this pair and has BOTH rungs, because a `S[]` argument is as ordinary
  // a pin as an `S` one. The arm rung above took only the first, so `Circle[]` was claimed by
  // NEITHER — `monoStructAnnName`'s list rung asks `isSName("Circle")`, false by the very
  // construction its own header names, and `variantIndexOf("Circle[]")` is false because the
  // name is an array. Both declines are correct in isolation; together they left a spelling
  // with no home, and the `"i32"` catch-all pinned an i32 over a `(ref $rlWrap)` list.
  //
  // The pin is again the caller's OWN spelling: `acc: Circle[]` is an annotation a NON-generic
  // function already lowers end to end (the ref-list layer types the backing through
  // `rlElemVariantHeap`). NOT reachable by widening `monoCompositeListAnnName`, whose question
  // is a COMPOSITE element; `Circle` is a bare NOMINAL name that function does not consult.
  if nameIsArray(name) {
    if variantIndexOf(arrElemNameRaw(name)) >= 0 { return name }
  }
  // A BARE INLINE OBJECT SHAPE (`{r: i32}`), whose complement has sat one line down since
  // `monoCompositeListAnnName` was written: that function claims a shape ELEMENT (`{r: i32}[]`)
  // and the bare spelling one container in was claimed by NOTHING — the same `P` / `P[]` pair
  // `monoStructAnnName` holds both rungs of, missing its first. `isSName` cannot answer BY
  // CONSTRUCTION: `internInlineShapeTy` dedups an inline shape onto the DECLARED row of that
  // layout and pushes no `sNames` entry (silent-class-inventory D53/D111), so a
  // `const c: { r: i32 }` fell to the `"i32"` catch-all and declared an i32 over a `(ref $S)`.
  //
  // The pin is the caller's OWN spelling, which a NON-generic parameter already lowers end to
  // end via `paramStructIndex`'s inline-shape rung and `repSlotOfTy`'s structural→declared
  // bridge. AFTER the variant arms and BEFORE the map arm: `nameIsShapeSpanEnds` is
  // `BRACE-SPAN · NOT2ND`, so a map spelling stays with `nameIsBareMap` below.
  if nameIsShapeSpanEnds(name) { return name }
  const rl = monoCompositeListAnnName(name)
  if rl != "" { return rl }
  // A LITERAL-UNION ALIAS ARRAY (`K[]`), the array sibling of the `isUName` arm above. The BARE
  // alias has been claimed since the alias-pin arm was written; `K[]` never was, and the ARRAY
  // is the shape a `std:array` generic takes. Declining cost both scopes: at MODULE scope the
  // cascade fell to `exprArray`, which spells the REP and pinned `i32[]`, so `indexOf<T>` over a
  // `K[]` bound `T := i32` and the bare member literal lowered as the string ref it is — check
  // clean, `type mismatch` at load; inside a FUNCTION every rep classifier is post-mono blind,
  // so the same call reached the `"i32"` catch-all and took the loud `expected an array
  // argument`, which is the receiver failing and takes the documented remedy down with it.
  //
  // The pin is the caller's OWN spelling, which a NON-generic `self: K[]` / `needle: K` already
  // lowers. SUBSUMED by the union-alias LIST rung at the top of this ladder (D1082) — a litunion
  // alias is in `unNames` — and kept only as the rung whose absence this family witnessed.
  if nameIsArray(name) {
    const luElem = arrElemNameRaw(name)
    if luElem != "" && isUName(luElem) && nameIsLitUnionType(luElem) {
      return name
    }
  }
  // A `boolean[]` annotation. Its REP is the i32 list exactly (`nameIsI32Array`), so the
  // cascade cannot spell it and the pin is a NAME — the same reason the `exprArray` arm
  // reads the checker's element name. Only a genuine `boolean` LEAF is claimed; the other
  // i32-backed list spellings keep the cascade's answer (see that arm).
  if arrElemIs(name, "boolean") { return name }
  // A BARE map / Set annotation (`{[K]: V}`). The pin is the WHOLE spelling, which is
  // character-for-character what `nodeTyMapName` hands the cascade for an argument the
  // CHECKER typed — so the annotation channel and the recorded-type channel name ONE
  // instance and cannot mint two. A map-FIRST union (`{[string]: i32} | boolean`) is a
  // variant BOX rather than a map, and `nameIsBareMap` is the one home of that subtraction.
  if nameIsBareMap(name) { return name }
  // A canonical SCALAR / scalar-LIST annotation. The cascade below reaches these through
  // the CHECKER's recorded type or a `param*` annotation probe, and both channels go blind
  // in exactly one position: a generic body's own binding. An instance's `const y: T = x`
  // carries the substituted annotation and NO recorded type, and `buildLocals` is post-mono
  // so `declaredString` / `declaredF64Array` / their siblings are empty — the argument fell
  // to the `"i32"` catch-all and the instance declared an i32 parameter over a body doing
  // string / f64-list / map work (check-clean INVALID WASM). The annotation is the only
  // truth there, which is the same rule the four arms above already stand on.
  const rs = monoScalarAnnName(name)
  if rs != "" { return rs }
  // A NULLABLE spelling, whose `| null` the pin has to CARRY.
  monoNulAnnName(name)
}

// A nullable annotation (`string | null`, `{[K]: V} | null`, `S[] | null`) whose NON-NULL base
// is a spelling `monoAnnPinName` already claims, echoed back WHOLE — else "". `nullablePartOf`
// is `emit_base`'s depth-aware `| null` split.
//
// The nullability has to ride the pin because the pin IS the instance's parameter annotation.
// Every OTHER channel answers about the REP, and a nullable's rep is its non-null base by
// design: `paramString` claims a `string | null` parameter on purpose, so the cascade named the
// argument `string`, the instance declared a NON-NULL parameter, and the caller handed it the
// nullable ref — `vl check` clean, INVALID WASM. The i32-list niche loses the same information
// one column over: pinned `i32[]`, an actual `null` argument TRAPS inside the instance.
// Delegating the base keeps ONE membership list and inherits the EXACT-NAME rule that makes a
// pin safe; the base must echo back UNCHANGED, since a RENAMED base names a different rep.
function monoNulAnnName(name: string) {
  const base = nullablePartOf(name)
  if base == "" { return "" }
  if monoAnnPinName(base) == base { return name }
  ""
}

// A canonical SCALAR-rep annotation spelling (`i32` / `i64` / `f32` / `f64` / `boolean` /
// `string`) or a list over one, echoed back — else "".
//
// EXACT spellings only, and that is the safety property rather than a shortcut: the pin
// becomes the instance's parameter ANNOTATION, so a name that is not already the rep's own
// spelling would rename the rep. An ALIAS (`type S = string`), a nullable (`string | null`),
// a union and every composite are therefore declined here and keep the cascade's answer.
function monoScalarAnnName(name: string) {
  let leaf = name
  if nameIsArray(name) { leaf = arrElemNameRaw(name) }
  if leaf == "i32" { return name }
  if leaf == "i64" { return name }
  if leaf == "f32" { return name }
  if leaf == "f64" { return name }
  if leaf == "boolean" { return name }
  if leaf == "string" { return name }
  ""
}

function monoCompositeListAnnName(name: string) {
  if !nameIsArray(name) { return "" }
  const elem = arrElemNameRaw(name)
  if elem == "" { return "" }
  if nameIsArray(elem) { return name }
  if nameIsParenSpanEnds(elem) { return name }
  if nameIsBraceSpanEnds(elem) { return name }
  ""
}

// True when the type-annotation node `annIx` is a FUNCTION-VALUE pin in either of the two
// spellings `monoArgTyName` mints — the bare closure's `$fnsig` marker (`"=>i>i"`) or a
// nullable function type (`((i32) => i32) | null`). One predicate, so the gate, the name and
// the banked type all agree about what counts as a pin.
function monoAnnIsCloPin(annIx: i32) {
  if annIx < 0 { return false }
  if sigKeyPinPayload(tyNameOf(annIx)) != "" { return true }
  tyNulFuncInner(nodeTyIxOf(annIx)) >= 0
}

// The type-ANNOTATION NODE of a binding whose annotation is already a monomorphized
// FUNCTION-VALUE PIN (`monoAnnIsCloPin`) — a parameter or annotated local of `fnIx` — or -1.
//
// An instance's body is a CLONE whose `T`-typed annotations were REWRITTEN to the pin, and a
// pin is not a type SPELLING: `nameToTy` resolves it to nothing, so the clone's Ident nodes
// carry no `TyFunc` and the arena route (`sigKeyOfTy`) answers "" for them. A generic FORWARDER
// is exactly that shape. THE NODE rather than the name, because both halves of the pin live on
// it and must come from ONE place: `tyNameOf` is the instance-key spelling and `nodeTyIxOf` is
// the `TyFunc` the OUTER instantiation banked there — the row the inner instance's parameter
// must carry, or `checkParams`' `tyIsFuncType` rung rejects a parameter this pass just pinned
// as a closure. PARAM before LOCAL, and both, because a forwarder hands on either. NOT folded
// into `monoAnnPinName`: `monoArgTyName`'s closure arm claimed every name that could reach it.
function monoCloPinAnnNodeOf(identName: string, fnIx: i32): i32 {
  if fnIx < 0 { return -1 }
  const ptn = paramTypeNode(fnIx, identName)
  if monoAnnIsCloPin(ptn) { return ptn }
  const ctxFn = P.nodes[fnIx]
  if ctxFn is FuncDecl {
    const li = parentLetOf(ctxFn.fnBody, identName)
    if li >= 0 {
      const ld = P.nodes[li]
      if ld is LetDecl {
        if monoAnnIsCloPin(ld.letType) { return ld.letType }
      }
    }
  }
  -1
}

// `monoCloPinAnnNodeOf` over an EXPRESSION — the Ident unwrap, in one place, so the gate
// and the type-banking helper below cannot ask the question of different nodes.
function monoCloPinAnnNodeOfExpr(ax: i32, fnIx: i32): i32 {
  if ax < 0 { return -1 }
  const n = P.nodes[ax]
  if n is Ident { return monoCloPinAnnNodeOf(n.identName, fnIx) }
  -1
}

// The ARENA TYPE to BANK beside the pin `monoArgTyName` chose for `ix` — the argument's own
// recorded type, except where the pin came from a binding's ANNOTATION rather than from the
// argument node (`monoCloPinAnnNodeOf`), in which case it is that annotation's type.
//
// One home for the `pinTys` entry, so the NAME and the TYPE of a pin can never be sourced
// from two different nodes. Every other pin keeps `nodeTyIxOf(arg)` exactly as before.
export function monoArgPinTyIx(ix: i32, fnIx: i32) {
  const ax = unwrapParen(ix)
  const own = nodeTyIxOf(ax)
  // The node's OWN recorded type wins wherever it already names a function value (bare or
  // nullable) — the annotation channel exists only for the clone whose node carries `T`.
  if own >= 0 && nodeTyIsFunc(ax) { return own }
  if tyNulFuncInner(own) >= 0 { return own }
  const pn = monoCloPinAnnNodeOfExpr(ax, fnIx)
  if pn >= 0 { return nodeTyIxOf(pn) }
  own
}

// True when the SPELLING `narrow` is a top-level MEMBER of the union / nullable spelling
// `wide` — i.e. `narrow` is what `wide` NARROWS TO, and not a second RENDERING of it.
//
// THE MEMBERSHIP TEST IS THE WHOLE SAFETY PROPERTY of the narrowed pin (DECISIONS.md, "which
// channel owns a NARROWED argument's type"). The checker's recorded type on an argument node
// knows the narrow and is unreliable for exactly the shapes the annotation arms cover — a
// literal union SOFTENS to `string`, a nominal `P` renders structurally, a closure renders an
// arrow where the pin needs a `$fnsig` marker. None of those is a MEMBER of the annotation's own
// spelling, so membership admits the narrow and excludes every one of them by construction
// rather than by a list of exceptions; pinning the node's render unconditionally loses `runs`.
//
// `unionArmsOf` resolves an alias to its member set; a non-union splits to ONE atom, declined.
function monoNameNarrowsFrom(narrow: string, wide: string) {
  if narrow == "" { return false }
  if narrow == wide { return false }
  if nullablePartOf(wide) == narrow { return true }
  const arms: string[] = []
  unionArmsOf(wide, arms)
  if arms.length < 2 { return false }
  let ai = 0
  while ai < arms.length {
    if arms[ai] == narrow { return true }
    ai = ai + 1
  }
  false
}

// The pin a NARROWED argument at `ax` wants, given the pin `wide` the annotation ladder chose
// — else "" (the ladder's answer stands).
//
// A pin BECOMES the instance's parameter annotation, so it is safe exactly where a NON-GENERIC
// function carrying that annotation already lowers the same program end to end
// (`monoScalarAnnName`'s exact-name rule). That rule picks the NARROWED spelling here:
// `takeC(x: Circle)` called with a `Circle | null` narrowed by `is` runs today — the call
// boundary emits the `ref.as_non_null` — and the same twin runs for every rep in the grid.
// Pinning the WIDE spelling is equally legal as an annotation but lands the instance's RESULT
// on a rep the checker does not believe in — silent scalar cells, plus `runs` cells lost to a
// loud `field access but no struct type declared` (DECISIONS.md, "which channel owns a
// NARROWED argument's type"). `monoAnnPinName(n) == n` is `monoNulAnnName`'s UNCHANGED-echo rule.
function monoNarrowedPinName(ax: i32, wide: string) {
  if wide == "" { return "" }
  const nt = nodeTyIxOf(ax)
  // A TYPE WHOSE RENDER SOFTENS ITS LITERALS IS NOT A NAME THIS TEST CAN COMPARE, and it
  // reaches the membership test looking like a match on BOTH sides. Measured with a probe
  // on `type K = "a" | "b"` + `idg(k)`: the argument's own type renders `string`, and
  // `unionArmsOf("K")` answers the member set `string|string` — two softened arms — so
  // `string` IS a member of `K` by the spelling and the pin dropped from the interned ATOM
  // to a string ref (`expected i32, found (ref $type)`, check-clean invalid wasm, the one
  // cell option (c) regressed before this gate). `tyRenderSoftensLits` is this compiler's
  // home for exactly that hazard — `monoStaticIsResult` declines its own name compare on it
  // for the same reason — and a litunion argument's pin is claimed by the litunion rungs of
  // `monoArgTyName` anyway, so declining here takes nothing away.
  if tyRenderSoftensLits(nt) { return "" }
  const n = tyToEmitName(nt)
  if !monoNameNarrowsFrom(n, wide) { return "" }
  if monoAnnPinName(n) != n { return "" }
  n
}

// The union NAME a pin can carry for the node at `ix`, or "". THE RENDER, THEN THE REGISTRY:
// `tyToEmitName` spells a declared alias as its MEMBER SET while `monoAnnPinName`'s union rung
// (`isUName`) reads `unNames` — the ALIAS column — so for a `type Val = i32 | string`-typed read
// the two spellings never met and the pin came back empty. `unRowOfCanon` keys the registry on
// the type's canonical id instead of on a spelling, which is the same hand-over
// `anonUnionFieldName` makes on the struct-field side; the name handed back is the registry's
// own, and it still goes through `monoAnnPinName` so the pin stays inside the one membership
// list. D1516.
function monoUnionPinName(ix: i32): string {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const r = monoAnnPinName(tyToEmitName(ty))
  if r != "" { return r }
  const ur = unRowOfCanon(ty)
  if ur >= 0 && ur < unNames.length { return monoAnnPinName(unNames[ur]) }
  ""
}

// `monoArgTyName` AT A MONOMORPHIZATION PIN — the ladder's answer, narrowed to what the
// CHECKER recorded for this argument node where that is one of the annotation's own members.
//
// SEPARATE FROM `monoArgTyName` BECAUSE THAT FUNCTION HAS A SECOND CONSUMER. `wasmEmit`'s
// `monoStaticIsResult` asks it for the receiver of an `is` test and const-folds on the
// answer; narrowing there would fold a guard the mono pass has no business deciding. The
// pin is the only question the narrow belongs to, so it is the only caller that asks it.
function monoArgPinName(ix: i32, fnIx: i32) {
  const w = monoArgTyName(ix, fnIx)
  const n = monoNarrowedPinName(unwrapParen(ix), w)
  if n != "" { return n }
  w
}

export function monoArgTyName(ix: i32, fnIx: i32) {
  const cax = unwrapParen(ix)
  // THE THIRD CHANNEL, read before both arms below because both need it: an instance's own
  // `x: T` parameter / `const y: T = x` local carries the pin as its ANNOTATION, and neither
  // other channel can see it — `exprIsClosure` reads the post-mono locals table, and the
  // Ident's recorded type is still the ORIGINAL's `T` (a clone shares its leaf expression
  // nodes). This is what a generic FORWARDER hands its inner call.
  const cloPinNode = monoCloPinAnnNodeOfExpr(cax, fnIx)
  // D941 — THE FOURTH CHANNEL, and it is the third one's sibling. That channel reads the
  // INSTANCE's own parameter annotation (`paramTypeNode`) behind a `monoAnnIsCloPin` gate,
  // written for a function-valued forwarder and never widened past it — which is why a RAW `T`
  // forward runs and a generic STRUCT carrier does not. `outer<T>(e: Expectation<T>)` forwarding
  // to `inner(e)` refused `monomorphize: unsupported argument type`, because every other channel
  // asks the ARGUMENT NODE and a clone shares its leaf expressions, so `e`'s recorded type is
  // still the template's `Expectation<T>`. The instance's own `Param` HAS been substituted, so
  // the answer was one read away.
  //
  // GATED TO A GENERIC APPLICATION, the shape with no other home: pinned by its own SPELLING,
  // the same argument `monoAnnPinName`'s variant rung makes. Placed here rather than at the
  // bottom because several arms below `return ""` outright and never reached a last resort.
  if cax >= 0 {
    const gaN = P.nodes[cax]
    if gaN is Ident {
      const gaPt = paramTypeNode(fnIx, gaN.identName)
      if gaPt >= 0 {
        const gaAnn = tyNameOf(gaPt)
        if annGenAppSpanEnds(gaAnn) { return gaAnn }
      }
    }
  }
  // D1041 — A FALLIBLE NUMERIC `as?` ARGUMENT (`idn(d as? i32)`) pins at its own recorded
  // `T | null`. Every other channel in this cascade asks a BINDING (a param annotation, a
  // `let` init, a callee's return), and a cast that is written inline at the call site is none
  // of those — so the pin fell off the end and the instance was refused, while the identical
  // program through a `T | null`-returning CALL runs. The name goes through `monoAnnPinName`
  // for the reason the arms below give: the pin must be a spelling the annotation ladder
  // already claims — `i32|null` is its value-union rung — not any render this happens to make.
  if cax >= 0 {
    const ncqN = P.nodes[cax]
    if ncqN is AsExpr {
      if ncqN.asMode == "null" {
        const ncq = monoAnnPinName(tyToEmitName(nodeTyIxOf(cax)))
        if ncq != "" { return ncq }
      }
    }
  }
  // A NULLABLE FUNCTION VALUE (`((i32) => i32) | null`, kind 19), BEFORE the bare-closure arm
  // below, and the two are pinned differently on purpose. A bare closure pins the `$fnsig`
  // MARKER (`"=>i>i"`) — a key, not a spelling, minted because a bare function type had no
  // annotation form. A NULLABLE one does: `((i32) => i32) | null` is a parameter annotation the
  // emitter already lowers end to end (`checkParams`' `nulCloFlag` rung → kind 19, the
  // `(ref null $cloStruct)` cell, `ref.is_null` narrowing at the call). Pinning that SPELLING
  // keeps the family on the path that already works instead of widening the marker vocabulary
  // to carry a nullability bit — the marker has five readers and #1805 declined exactly that.
  //
  // `tyToEmitName` is the render that GROUPS the arrow, which is what makes the pin round-trip:
  // ungrouped it re-parses as a function RETURNING `i32 | null`. `nodeTyName` answers "" for
  // this shape, which is how the function-scoped cells reached the `"i32"` catch-all.
  let nulFnTy = nodeTyIxOf(cax)
  // A forwarder's own binding again: its node carries `T`, its annotation carries the pin,
  // and for a NULLABLE closure that pin is already the spelling this arm returns.
  if tyNulFuncInner(nulFnTy) < 0 && cloPinNode >= 0 {
    nulFnTy = nodeTyIxOf(cloPinNode)
  }
  if tyNulFuncInner(nulFnTy) >= 0 {
    const nulFnName = tyToEmitName(nulFnTy)
    if nulFnName != "" { return nulFnName }
  }
  // THE ARENA ASKS THE CLOSURE QUESTION, because `exprIsClosure` CANNOT ask it here: that
  // predicate resolves an Ident through `declaredSlotOf`/`localIsRef` (and a field through
  // `memberIsClosure`) — tables `buildLocals` fills POST-mono — so mid-pass it answered "not a
  // closure" for every function-valued argument that is not a bare top-level function NAME. A
  // `const a: (i32) => i32` local handed to `gid(a)` fell past this arm and past every arm below
  // it (the annotation ladder declines a closure spelling by design) onto the `"i32"` catch-all,
  // so the instance declared an i32 parameter and result over a body carrying a
  // `(ref $cloStruct)`: `vl check` clean, INVALID WASM — the whole of #1823, all four reps.
  //
  // `nodeTyIsFunc` is the CHECKER's answer and needs no emit-side table. The gates are OR'd, not
  // swapped: `exprIsClosure` still claims the shapes the checker did not type, and `cloPinNode`
  // joins them because without it a forwarder's `gid(x)` fell to the same catch-all.
  if exprIsClosure(ix, fnIx) || nodeTyIsFunc(cax) || cloPinNode >= 0 {
    // A FUNCTION-VALUE argument pins its param as a CLOSURE (kind 14). The
    // pinned name carries the callee's `$fnsig` KEY (`"=>ii>i"`) so the
    // instance's value-call (`fn(a, b)`) ref-casts to the EXACT signature.
    const ce = P.nodes[cax]
    if ce is Ident {
      const cfe = fnIndexOf(ce.identName)
      if cfe >= 0 {
        const ck = fnSigKeyOf(cfe)
        if ck != "" { return "=>" + ck }
      }
    }
    // EVERY OTHER function VALUE — a closure local/param, a struct field, a list or map
    // element, a lambda literal, a call result — keys off the argument's own recorded FUNCTION
    // TYPE. `sigKeyOfTy` is the `$fnsig` producer that takes a `TyFunc` (the arm-for-arm twin of
    // the name-side `annSigKey`), so this mints the SAME key the named-function route above
    // produces for the same signature — one key vocabulary, and the instance's `call_ref` casts
    // to the same interned functype either way.
    //
    // The named route stays FIRST and unchanged: `fnSigKeyOf` reads the DECLARATION, which is
    // what the working cells are pinned by today. "" is still the loud floor (`monoInstantiate`
    // fails the call) for a signature outside the value-call ABI — a pin that cannot name the
    // signature must not fall through to the cascade, whose catch-all is the i32 this whole arm
    // exists to prevent.
    const ak = sigKeyOfTy(nodeTyIxOf(cax))
    if ak != "" { return "=>" + ak }
    // Last: the pin an instance's OWN binding already carries (a generic forwarder).
    if cloPinNode >= 0 { return tyNameOf(cloPinNode) }
    return ""
  }
  // A CALL ARGUMENT whose callee has a CONCRETE return annotation takes that annotation as
  // its type. Needed for a generic call used as an argument (`box(box(7))`): `monoWalk`
  // instantiates the inner call FIRST, but during monomorphization the instance's `fRetKind` /
  // struct tables are not built yet (buildFnMap is post-mono), so `exprStruct` /
  // `structIndexOfExpr` cannot classify it and the type param would wrongly default to i32.
  // Reading the instance's (already-substituted) return annotation resolves the nested bind.
  const argN = P.nodes[unwrapParen(ix)]
  if argN is Call {
    const argCallee = P.nodes[argN.callFn]
    if argCallee is Ident {
      const acfe = fnIndexOf(argCallee.identName)
      if acfe >= 0 {
        const acfn = P.nodes[fnStmts[acfe]]
        if acfn is FuncDecl {
          if acfn.fnRet >= 0 {
            // The DECLARED spelling again — this arm's whole job is to tell a CONCRETE
            // return from a parametric one, and a shadowed parameter reads as concrete
            // once canon has resolved it.
            const arn = monoDeclAnnName(
              acfn.fnRet,
              tyNameOf(acfn.fnRet),
              acfn.fnTyParams,
            )
            if arn != "" && !monoAnnHasTyParam(arn, acfn.fnTyParams) {
              return arn
            }
          } else {
            // ...AND AN *INFERRED* RETURN IS AS GOOD A PIN AS AN ANNOTATED ONE. This rung read
            // `fnRet >= 0` only, so `function f(c) { if c { return 1 }  "s" }` — whose union
            // return the checker infers perfectly well — handed nothing to an UN-ANNOTATED
            // parameter and fell through to the loud `monomorphize: unsupported argument type`.
            // Writing `: i32 | string` on `f` makes the identical program run, which is what
            // says the type was known all along and only this channel could not see it.
            //
            // `inferRetNameOf` is the checker's own record of that type — the same registry
            // `inferRetBearsNull` reads for the void fixpoint. Routed through `monoAnnPinName`
            // so the pin is one the annotation ladder already claims (a union NAME is its
            // `isUName` rung) rather than any spelling the inference happens to produce.
            const irn = inferRetNameOf(argCallee.identName)
            if irn != "" {
              const irp = monoAnnPinName(irn)
              if irp != "" { return irp }
            }
          }
        }
      }
    }
  }
  // An IDENT argument bound to a generic-call result (`const inner = box(7); box(inner)`):
  // resolve via its un-annotated `let` INIT, since the local's type table isn't built during
  // monomorphization either. Only adopt a resolved non-i32 type (an i32 local takes the i32
  // default below anyway); a param / non-let ident has no `parentLetOf` and falls through.
  if argN is Ident {
    if fnIx >= 0 {
      const ctxFn = P.nodes[fnIx]
      if ctxFn is FuncDecl {
        const li = parentLetOf(ctxFn.fnBody, argN.identName)
        if li >= 0 {
          const ld = P.nodes[li]
          if ld is LetDecl {
            // A STRUCT- or struct-ARRAY-typed ANNOTATED local (`const p: P`, `const xs: P[]`):
            // read its annotation name directly. During monomorphization the locals table isn't
            // built (buildLocals is post-mono), so the `exprStruct`/`exprRefArray` cases below
            // can't classify it, defaulting the type param to i32 (`id(p).x` → "field access
            // receiver is not a struct"; `first(xs)` → "expected an array argument"). The
            // annotation is the reliable source — the struct DECL table (`sNames`) IS built here.
            if ld.letType >= 0 {
              // A COMPOSITE-ELEMENT list local (`xs: i32[][]`, `(i32|null)[]`, `{a:i32}[]`)
              // is among the spellings `monoAnnPinName` claims: the same
              // annotation-is-the-truth rule, for the list spellings the cascade below
              // either declines (`exprRefArray`, literal-only) or answers one dimension
              // short (`exprArray`'s `i32[]` catch-all).
              const r = monoAnnPinName(tyNameOf(ld.letType))
              if r != "" { return r }
            }
            if ld.letType < 0 && ld.letInit >= 0 {
              // AN EMPTY LIST LITERAL HAS NO ELEMENT FOR THE RECURSION TO READ, AND THE
              // RECURSION ANSWERS ANYWAY (silent-class-inventory D764). `const c = []` handed to
              // `idg<T>(x: T): T` recurses into the `[]`, every element-naming arm declines, and
              // `exprArray`'s catch-all pins `i32[]` — so the instance is cloned with an i32-LIST
              // parameter and result and every read off the RESULT binding then refuses with a
              // DIFFERENT message, which is why the message was never the family.
              //
              // THE TYPE IS NOT MISSING, ONLY UNREADABLE FROM THE LITERAL: the checker has
              // already pinned the binding from its destination and says so in its own
              // diagnostics, so this reads the ARGUMENT REFERENCE's recorded type — the one node
              // carrying that pin at this point in the pass. GATED ON THE EMPTY LITERAL, which is
              // the ablation, and routed THROUGH `monoAnnPinName`, the one pin membership list.
              const eln = P.nodes[ld.letInit]
              if eln is ArrayLit {
                if eln.arrElems.length == 0 {
                  const epn = monoAnnPinName(tyToEmitName(nodeTyIxOf(cax)))
                  if epn != "" { return epn }
                }
              }
              const innerTy = monoArgTyName(ld.letInit, fnIx)
              if innerTy != "" && innerTy != "i32" { return innerTy }
              // A REFUSAL PROPAGATES. `""` here is not "nothing known" — it is one of this
              // ladder's explicit FLOORS (`exprUnion`, `exprNullableStruct`, and the three
              // at the bottom), i.e. "this init has a REF rep no pin can name". Falling
              // through hands the question back to the Ident cascade, which is post-mono
              // blind for a local (`buildLocals` has not run) and therefore answers `"i32"`
              // — re-entering, one binding later, exactly the wrong-instance failure the
              // floor exists to prevent. Witness: `const xs = o.xs` over a `P[] | null`
              // FIELD, the `nulreflist` half of silent-class-inventory D23.
              if innerTy == "" { return "" }
            }
          }
        }
      }
      // A STRUCT-typed PARAM argument (`g(v)` inside a generic body where `v: P`): same as the
      // annotated-local case — read the param annotation, the locals table being unbuilt here.
      const ptn = paramTypeNode(fnIx, argN.identName)
      if ptn >= 0 {
        const pt = P.nodes[ptn]
        if pt is TypeRef {
          // The annotated-local arm's PARAM twin — a generic body passing its own
          // `xs: i32[][]` / `boolean[]` / `P` parameter on to a second generic call, which
          // is the shape a generic FORWARDER is. One home, so the two cannot drift.
          const r = monoAnnPinName(pt.tyName)
          if r != "" { return r }
        }
      }
    }
    // THE MODULE-SCOPE TWIN of the two arms above, arm for arm — the annotated binding and
    // the un-annotated one — because the SCOPE axis is not a type axis and the ladder had
    // been split along it three times — four, counting a binding inside a top-level BLOCK
    // (D1596), which `monoModuleLetOf` now reaches by its second rung.
    //
    // `parentLetOf` is function-scoped and every arm above sits behind `fnIx >= 0`, so a
    // generic call whose argument is a top-level binding reached NONE of them while the
    // identical program moved into a `function main()` body did. This arm used to close that
    // for the composite-element list question alone, then for the nullable one; D703 makes it
    // the whole ladder in both halves, and `monoModuleLetOf` now declines on the SHADOW test
    // rather than on `fnIx >= 0`, so a global is readable from inside a function too.
    const gli = monoModuleLetOf(argN.identName, fnIx)
    if gli >= 0 {
      const gd = P.nodes[gli]
      if gd is LetDecl {
        if gd.letType >= 0 {
          // THE GLOBAL'S ANNOTATION, THROUGH THE ONE PIN MEMBERSHIP LIST — the same call the
          // annotated-LOCAL and PARAM arms above make, so a generic call pins its instance
          // identically wherever its argument's binding happens to live.
          //
          // THIS WAS TWO RUNGS OF THAT LADDER, ADDED ONE DEFECT AT A TIME, each with a paragraph
          // explaining why only its own question needed the other scope, both resting on the
          // claim that the remaining spellings have a module-scope story through the classifier
          // tables. The UNION spelling did not: `type U = i32 | string` + a module-scope
          // `const a: U` was the loud `monomorphize: unsupported argument type` while `isUName`
          // — one line, three arms up — names it, and the same program with `a` as a LOCAL
          // compiled. Delegating to `monoAnnPinName` makes that asymmetry unstateable rather than
          // fixed once more: a spelling added to the pin list is added to both scopes at once.
          const rg = monoAnnPinName(tyNameOf(gd.letType))
          if rg != "" { return rg }
        }
        // THE UN-ANNOTATED GLOBAL, the other half of the local arm's pair — `const c = [lv1]`
        // at module scope, whose type only its INITIALIZER knows. The local arm has recursed
        // into `letInit` since it was written; this one had no such rung, so a top-level
        // inferred binding handed to a generic reached `exprRefArray`'s non-literal floor and
        // took the loud reject, while the identical program with the binding ANNOTATED
        // (`const c: i32[][][] = [lv1]`) or moved INTO a function ran.
        //
        // The recursion is the local arm's verbatim, INCLUDING its two rules: an `"i32"`
        // answer is not adopted (the catch-all would be the pin either way), and `""` is a
        // REFUSAL that propagates rather than a "nothing known" that falls through — see that
        // arm's header for the witness, which is the same one at either scope.
        if gd.letType < 0 && gd.letInit >= 0 {
          // THE EMPTY-LITERAL RUNG'S MODULE-SCOPE TWIN (D764) — see the local arm for the
          // ablation and the witness. Added here at the same time for the reason D703 gives
          // about this very pair: a rung added to one scope and not the other is the
          // asymmetry that ladder's header exists to make unstateable.
          const geln = P.nodes[gd.letInit]
          if geln is ArrayLit {
            if geln.arrElems.length == 0 {
              const gepn = monoAnnPinName(tyToEmitName(nodeTyIxOf(cax)))
              if gepn != "" { return gepn }
            }
          }
          const ginner = monoArgTyName(gd.letInit, fnIx)
          if ginner != "" && ginner != "i32" { return ginner }
          if ginner == "" { return "" }
        }
      }
    }
  }
  // An INDEXED ELEMENT argument (`id(xs[0])` where `xs: P[]` / `{[K]:V}[]` / `i64[]`): the
  // array's own name resolves above through the annotation arms, and the ELEMENT is that name
  // minus one `[]`. The locals table is unbuilt mid-mono, so the `expr*` cascade below cannot
  // classify the element read and would take the `"i32"` catch-all.
  //
  // The element goes through `monoAnnPinName`, the SAME home the array itself is named through,
  // and that shared home is the invariant: the two ends of one cut must claim the same spelling
  // set. A narrower element test — `isSName`, say — resolves a struct element while the map, Set
  // and scalar elements the array arm ALREADY named fall to the catch-all, declaring an i32
  // parameter over a map / i64 / list body (check-clean INVALID WASM). The `[]` test is
  // `nameIsArray` and the peel is `listElemNameOf` — the cut PLUS one grouping-paren layer,
  // since a composite element carries its own parens. `an >= 3` excludes the degenerate `"[]"`.
  if argN is Index {
    const arrTy = monoArgTyName(argN.idxArr, fnIx)
    const an = arrTy.length
    if an >= 3 && nameIsArray(arrTy) {
      const r = monoAnnPinName(listElemNameOf(arrTy))
      if r != "" { return r }
    }
  }
  // A struct-FIELD argument (`id(o.inner)` where `o: Outer` and `inner: Inner`): resolve the
  // receiver's struct from its annotation, then read the field's struct type-name off the struct
  // table (a nested-struct field is code 15, whose `sFieldElemName` IS its target struct name).
  // The locals table is unbuilt mid-mono, so `structIndexOfExpr(o.inner)` below defaults to i32.
  if argN is Member {
    const recvTy = monoArgTyName(argN.memObj, fnIx)
    const rsi = structIndexByName(recvTy)
    if rsi >= 0 {
      const fi = sFieldIndex(rsi, argN.memProp)
      if fi >= 0 && sFieldTypeAt(rsi, fi) == 15 {
        const fnm = sFieldElemNameAt(rsi, fi)
        if isSName(fnm) { return fnm }
      }
    }
    // D1516 — THE UNION-VALUED FIELD, whose companion column is a member SET and not a struct
    // name, so the code-15 rung above cannot carry it. The union floor's own arena rung would
    // answer, but a field read whose OWNER has a declared row does not reach it: an arm between
    // here and there claims the read first and returns "". Asked HERE, gated to a union
    // (`nodeTyIsUnionish`) so no struct / list / scalar pin is touched, and through
    // `monoAnnPinName` so the answer is a spelling an annotated parameter already lowers.
    if nodeTyIsUnionish(cax) {
      const mun = monoUnionPinName(cax)
      if mun != "" { return mun }
    }
  }
  // A DECLARED LITUNION argument pins the parameter to the ALIAS, ahead of the string /
  // scalar arms. For a litunion the spelling IS the rep: an alias is an interned i32 ATOM,
  // an inline member set softens to the string ref (`litUnionAliasNameOfTy` is the one home
  // of that distinction and answers "" for the inline form, which then falls through to
  // `exprString` exactly as before). Without this arm a `K`-typed argument reached the
  // `"i32"` catch-all at the bottom, and that arm mints NO annotation node by design — so
  // the instance's parameter lost its type entirely (`paramTypeNode` → -1): the wasm
  // parameter took the i32 default while every consumer in the body still classified the
  // name as a string. A bare `print(u)` printed the raw atom id, and a `const r: K = u`
  // lowered a string→atom widen over that i32 parameter — INVALID WASM.
  const luAl = litUnionAliasNameOfTy(nodeTyIxOf(unwrapParen(ix)))
  if luAl != "" { return luAl }
  // THE ARRAY SIBLING of the arm above, and it has to sit HERE rather than below: the
  // collection arms spell a litunion array by its REP, and `nameIsI32Array` accepts a litunion
  // `K[]`, so `exprArray`'s catch-all pins `i32[]` and binds every `T` mentioning the element
  // to plain i32. That is the same "the pin lost the type entirely" failure the arm above
  // records, one container out: `indexOf<T>(self: T[], needle: T)` over a `K[]` declared
  // `needle` an i32 while the caller pushed the member literal's string ref — `vl check` rc 0
  // and a module the engine refuses. See `monoAnnPinName`'s litunion-array arm, which is this
  // question asked of the ANNOTATION for the function-scoped spelling the rep classifiers
  // cannot see mid-pass; the two channels must claim the same shape or the two scopes pin one
  // call two ways.
  const luArrTy = nodeTyIxOf(unwrapParen(ix))
  if tyIsLitUnionArray(luArrTy) {
    const luArrT = T.tys[luArrTy]
    if luArrT is TyArray {
      const luElAl = litUnionAliasNameOfTy(luArrT.aElem)
      if luElAl != "" { return luElAl + "[]" }
    }
  }
  // A MAP / SET argument pins its param as that map — the whole `{[K]:V}` spelling an annotated
  // parameter carries, so the instance lowers through the already-working annotated-map path.
  // Without it a map argument fell to the `"i32"` default and declared an i32 over a map body.
  // BEFORE the collection arms, because `exprArray`'s catch-all would otherwise name a map an
  // array. Reads `nodeTyMapName`, not `exprMap`, whose Ident arm needs the POST-mono `declaredMap`.
  //
  // …AND ITS ARM-NOMINAL FORM FIRST, because the two channels DID mint two instances
  // (silent-class-inventory D88): `tyToEmitName` spells a declared union ARM structurally, so
  // the clone's annotation resolved to a fresh anonymous arena index, `variantRowOfTy` declined
  // it and `collectA` minted a SECOND mv slot against the caller's variant heap — check-clean
  // INVALID WASM. `nodeMapArmNominalName` is the map-VALUE twin of `arrElemNominalOfTy` (D33),
  // the same rung one container over; `collectU` runs long before this pass, so it answers here.
  const mnArm = nodeMapArmNominalName(unwrapParen(ix))
  if mnArm != "" { return mnArm }
  const mn = nodeTyMapName(unwrapParen(ix))
  if mn != "" { return mn }
  // The STRING twin of the arm above, and blind in the same place for the same reason:
  // `exprString`'s Ident arm reads `declaredString`, another POST-mono locals table, so a
  // `const s: string` LOCAL / a `string` FIELD read / a `s ?? d` result fell to the `"i32"`
  // catch-all while a `string` PARAM and a bare literal both resolved. The checker typed the
  // read before the mono pass ran, and `nodeTyIsStringPrim` reads the `TyPrim` variant and its
  // `primName` DIRECTLY — the render this used to build and character-compare is gone
  // (`docs/internals/destringify-types-program.md` grades the lockstep and its inverted control).
  //
  // `TyPrim`-ONLY, and that is the narrowing to watch if a caller is ever added: a literal union
  // canon-softens to the spelling `string` at several positions in this compiler, and the
  // softened answer has been right at one site and wrong at another. Here the two never diverge,
  // because a litunion argument is claimed by the litunion rungs above this one.
  if nodeTyIsStringPrim(unwrapParen(ix)) { return "string" }
  if exprString(ix, fnIx) { return "string" }
  if exprStringArray(ix, fnIx) { return "string[]" }
  if exprF64Array(ix, fnIx) { return "f64[]" }
  // The i64 / f32 list arms sit beside the f64 one: the SCALAR cascade below already names
  // every scalar rep (`i64`, `f32`), so without these an `i64[]` / `f32[]` argument falls
  // through to the `exprArray` catch-all and pins `i32[]` — binding `T` to i32 and emitting
  // an instance whose functype reads the i32 list while the caller hands it the i64/f32 one.
  if exprI64Array(ix, fnIx) { return "i64[]" }
  if exprF32Array(ix, fnIx) { return "f32[]" }
  if exprRefArray(ix, fnIx) {
    // A struct/union-element array: only a LITERAL argument names its element
    // type cheaply; other shapes are out of scope for now.
    const nd = P.nodes[ix]
    if nd is ArrayLit {
      // A NESTED list literal over a `boolean` LEAF. `arrLitElemName`'s nested-list rung
      // names the inner list by its leaf (`string[]` / `f64[]` / `i64[]`, else `i32[]`) and
      // has no boolean member, so `[[true]]` pinned `i32[][]` and the instance printed its
      // elements as 0/1. `nodeTyName` renders the checker's whole array type (its `TyArray`
      // arm) and that IS the pin this site wants. Deliberately NOT fixed in
      // `arrLitElemName`: that name is a ref-list INTERNING key, and renaming a row is a rep
      // decision, while the pin is not.
      const nlt = nodeTyName(ix)
      // THE ARENA. This was two grammar CUTS over a render — `arrElemNameRaw` twice across
      // `nodeTyName(ix)` — asking what two `TyArray` hops answer directly. The render is still
      // needed (it IS the pin returned below), but the QUESTION no longer goes through it.
      if nodeTyNestedElemIsBoolPrim(ix) { return nlt }
      return arrLitElemName(ix) + "[]"
    }
    return ""
  }
  if exprArray(ix, fnIx) {
    // A `boolean[]` shares the i32 list REP exactly (`nameIsI32Array`'s own note), so the rep
    // cascade cannot SPELL it — and a pin is a NAME, not a rep. The instance's parameter
    // annotation is the only boolean-ness left in a monomorphized body (the clone carries no
    // recorded node type), and it is what `listElemIsBool` recovers the element's PRINT
    // formatting from; pinned `i32[]`, a `boolean[]` argument printed its elements as 0/1. The
    // CHECKER's element name is the source, exactly as the map arm above reads `nodeTyMapName`.
    // THE ARENA answers it: `nodeTyArrayElemIsBoolPrim` replaced a `tyToStructStr` render whose
    // only consumer was this compare (B82 in `docs/internals/destringify-types-program.md`).
    //
    // STILL ONLY A GENUINE `boolean` LEAF. The other i32-backed spellings (`nameIsI32Array`
    // also accepts a litunion `K[]`, `(boolean|null)[]`, `(K|null)[]`) keep the `i32[]` answer
    // — `tyArrayElemPrimName` is `TyPrim`-only, so the structural form inherits that narrowness.
    if nodeTyArrayElemIsBoolPrim(ix) { return "boolean[]" }
    return "i32[]"
  }
  if exprUnion(ix, fnIx) {
    // D1516 — THE UNION FLOOR OWES THE ARENA ONE QUESTION FIRST, exactly as the STRUCT floor
    // below already asks it. Every arm above resolves a union from a BINDING — an annotation,
    // a callee's return, a global's init — so a PROJECTION had no channel at all: `xs[0]`
    // reached the array arm only when the array's own name resolved, and a struct FIELD read
    // or a map read reached nothing. The checker typed the read long before this pass ran.
    //
    // AT THE FLOOR, so it re-pins nothing the ladder resolved, and THROUGH `monoAnnPinName`,
    // the one pin membership list — a render that list does not claim keeps the loud floor
    // rather than becoming a wrong instance. That is also what keeps the softening hazard
    // `monoNarrowedPinName` records out: a litunion is claimed by the two rungs above this
    // one, and `monoAnnPinName` answers "" for a spelling no annotation could carry.
    const upn = monoUnionPinName(unwrapParen(ix))
    if upn != "" { return upn }
    return ""
  }
  if exprNullableStruct(ix, fnIx) { return "" }
  // THE VARIANT TABLE, ASKED BEFORE THE STRUCT ONE — D57's root, one layer out. `collectS`
  // SKIPS a `type X = {…}` that is a union member, so `type Shape = Circle | Sq` DELETES
  // `Circle`'s `sNames` row and mints a VARIANT row instead. `structIndexOfExpr` has legs that
  // are NOT kind-gated, so with an exact layout TWIN in the module a `Circle` argument resolved
  // to the twin's struct row and this arm pinned its NAME — two heap types for one shape,
  // never merged because DECISIONS.md keeps that seam NOMINAL (silent-class-inventory D75, D82
  // one position over). WITHOUT the twin the leg answers -1 and this arm's `return ""` is the
  // loud floor (D63), so the twin is what routes around the floor.
  //
  // `exprVariantIndex` IS `structIndexOfExpr`'s STORAGE-CLASS TWIN, arm for arm, each leg
  // kind-gated so the two cannot both answer for one binding. The pin goes through
  // `monoAnnPinName`, never `uVariants[avi]` raw, so a spelling we would RENAME is never a pin.
  const avi = exprVariantIndex(ix, fnIx)
  if avi >= 0 && avi < uVariants.length {
    const avn = monoAnnPinName(uVariants[avi])
    if avn != "" { return avn }
  }
  if exprStruct(ix, fnIx) {
    const si = structIndexOfExpr(ix, fnIx)
    if si >= 0 { return sNames[si] }
    // NO `sNames` ROW, BUT A PERFECTLY GOOD SPELLING — the checker's recorded SHAPE, routed
    // through the one pin membership list, which claims a bare inline object shape
    // (`nameIsShapeSpanEnds`). D703. The row goes missing for a reason that has nothing to do
    // with the argument: `collectS` SKIPS a `type X = {…}` that is a union member, so declaring
    // `type Shape = Circle | Sq` deletes `Circle`'s struct row and an un-annotated
    // `const c = { r: 7 }` whose only layout match WAS `Circle` resolves to nothing. Ablated,
    // the generic-ness is scenery — the same three declarations through a NON-generic
    // `idg(x: {r: i32})` run, which is what makes the pin safe (`paramStructIndex`'s
    // inline-shape rung, D53). AT THE FLOOR, so it can re-pin nothing the ladder resolved.
    // `tyToEmitName`, THE CANONICAL RENDER, not `nodeTyName`'s spaced one: `tyToStr` FLATTENS
    // an alias field (`{a: K0 | boolean}` spells its members) and a flattened field classifies
    // as no field code at all — the choice `structIndexOfExpr`'s closure-call fallback also makes.
    const shp = monoAnnPinName(tyToEmitName(nodeTyIxOf(unwrapParen(ix))))
    if shp != "" { return shp }
    return ""
  }
  // f32 BEFORE f64 — the order `exprIsF32`'s own header states ("Checked BEFORE
  // `exprIsF64` at every dispatch") and which every cell/slot/assign ladder obeys.
  // `exprIsF64` OVER-CLAIMS a mixed f32/float-literal argument: `fv * 1.0` is
  // `exprIsF32` (the literal adapts down to the f32 operand) AND `exprIsF64` (the
  // literal is a genuine `.` literal). Asking f64 first bound `T` to f64, so
  // `id(fv * 1.0)` monomorphized as `(param f64) (result f64)` — the argument was
  // correctly promoted into it (`f32.mul` · `f64.promote_f32`) and then the f64 RESULT
  // was handed to a site that classifies the call f32 off the checker's `nodeTyIx`
  // (`__print_f32__`, an f32 slot, an f32 parameter). `vl check` clean, INVALID WASM.
  // A BARE float literal is not `exprIsF32`, and a GENUINE f64 operand (`dv * 1.0`,
  // `fv + dv`) makes `exprIsF32` false through `binMixHardF64` — so every genuine f64
  // instantiation still binds f64 here, unchanged.
  if exprIsF32(ix, fnIx) { return "f32" }
  if exprIsF64(ix, fnIx) { return "f64" }
  if exprIsI64(ix, fnIx) { return "i64" }
  if exprIsBool(ix, fnIx) { return "boolean" }
  // THE `"i32"` CATCH-ALL IS THE DEFECT, NOT THE MISSING ARM (silent-class-inventory D23). A
  // cascade that answers `i32` for a rep it did not recognise mints a wrong INSTANCE silently:
  // the pin BECOMES the instance's parameter annotation, so an unrecognised REF rep declares an
  // i32 parameter over a body and a caller both carrying a `(ref …)` — `vl check` rc 0 and a
  // `type mismatch` at load. `""` is the LOUD floor (`monoInstantiate` fails the call, naming
  // the parameter and the callee), and it beats a wrong instance even where a pin could
  // eventually be found. Asked LAST, so every arm that CAN name a shape still names it.
  //
  // The three floored here are the reps whose cell is a `(ref …)` no arm above spells: a
  // `Circle | null` with no annotation to read, an `S[] | null` through a struct FIELD read
  // (no annotation channel at all), and the PACKED `u8[]` `exprArray`'s i32-list arm declines.
  // NARROW ON PURPOSE — a floor fires only where the answer would otherwise be `"i32"`.
  if exprNullableVariant(ix, fnIx) { return "" }
  if exprNullableRefArray(ix, fnIx) { return "" }
  if exprU8Array(ix, fnIx) { return "" }
  "i32"
}

// Build the TYPE-LEVEL binding column (`T` ⇒ this instance's concrete type) the way the CHECKER
// does: `bindGenWalk` over each parameter's DECLARED type against the concrete type the instance
// pinned that position at. `monoBindFromAnn` is the hand-written STRING twin filling `tvN`/`tvV`;
// this fills the arena-index pair `substTyDeep` consumes, so a substitution HANDS the type over
// instead of re-parsing the substituted spelling through `nameToTy` — which does not hash-cons,
// so every re-parse of a composite mints a duplicate row.
//
// `tyCol` is POSITIONAL over `params`, -1 meaning "nothing known here"; `bindGenWalk` declines a
// -1, so an all -1 column binds nothing and the caller falls back to the name path. That
// fallback is `pinTys`'s only: `pinnedTyIx` is essentially never -1, so the `LetDecl` site
// substitutes on every entry, kept safe by the `tyHasTyVar` gate at the substitution. The bounds
// guard below is belt-and-braces — `monoMakeInstance`'s loud lockstep check is the contract.
function monoBindCols(params: i32[], tyCol: i32[], bN: string[], bT: i32[]) {
  let bi = 0
  while bi < params.length {
    const pp = P.nodes[params[bi]]
    if pp is Param {
      let at = -1
      if bi < tyCol.length { at = tyCol[bi] }
      bindGenWalk(nodeTyIxOf(pp.parType), at, bN, bT)
    }
    bi = bi + 1
  }
  0
}

// Substitute a `LetDecl` annotation `letType` (a `TypeRef`) through the instance binding,
// returning a fresh `TypeRef` node when a type param substitutes (`T[]` → `f64[]`), else
// the original node index. So a generic body's `const out: T[] = []` / `const x: T` lowers
// against the instance's CONCRETE element type — reusing the (already-working) concrete
// annotated path for EVERY element type, not the per-rep usage inference.
function monoSubstLetType(
  letType: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  if letType < 0 { return letType }
  const tn = P.nodes[letType]
  if tn is TypeRef {
    if monoAnnMentionsTyParam(letType, tn.tyName, typarams) {
      const sub = monoSubstAnn(tn.tyName, typarams, tvN, tvV)
      if sub != "" && sub != tn.tyName {
        // THE SUBSTITUTED TYPE, not a re-parse of the substituted NAME — the return site's
        // hand-over (see `substTyDeep` there) applied to the body's annotated locals. The NAME
        // handed to the synthesis is unchanged (`sub`), so every name-consumer downstream reads
        // exactly the spelling it reads today; only the recorded TYPE improves.
        //
        // GATED ON COMPLETENESS, for the reason the return site records: `substTyDeep` rebuilds
        // only what CHANGED, so a type param it could not bind is left in place and is
        // indistinguishable at the result from a full substitution. A partly-substituted type
        // recorded on a local's annotation is simply wrong. `tyHasTyVar` separates the two and
        // fails toward the name path (its depth bound answers TRUE), so an unknown keeps
        // today's behaviour rather than guessing.
        let sty = -1
        const origLet = nodeTyIxOf(letType)
        if origLet >= 0 {
          const s2 = substTyDeep(origLet, bN, bT)
          if s2 >= 0 && s2 != origLet {
            if !tyHasTyVar(s2) { sty = s2 }
          }
        }
        return synthTypeRefTy(sub, tn.pos, sty)
      }
    }
  }
  letType
}

// Clone a monomorphized instance's BODY, substituting every `LetDecl` type-param
// annotation through the binding. Only the STATEMENT SPINE (blocks, control-flow, the
// `LetDecl`s themselves) is rebuilt; every leaf expression — INCLUDING a nested lambda —
// is SHARED unchanged, so no new function node is created (a clone would not be re-lifted,
// `collectFns` having already run) and a `T`-independent body shares its arena wholesale.
// Returns the SAME node index when nothing in the subtree changed, so an instance with no
// annotated body local keeps sharing the original body and the module is unchanged. A
// lambda that annotates a type param (`(x: T) => …`) is left un-substituted — that case
// is out of scope and stays as it was.
function monoCloneBody(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  outName: string,
  outType: string,
  outTyIx: i32,
  bN: string[],
  bT: i32[],
) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Block {
    const ns: i32[] = []
    let changed = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoCloneBody(
        n.blkStmts[i],
        typarams,
        tvN,
        tvV,
        outName,
        outType,
        outTyIx,
        bN,
        bT,
      )
      ns.push(cs)
      if cs != n.blkStmts[i] { changed = true }
      i = i + 1
    }
    if !changed { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is LetDecl {
    let nt = monoSubstLetType(n.letType, typarams, tvN, tvV, bN, bT)
    // The inferred-list-return local (`const out = []`, element a hole so #543's synthesis is
    // skipped): annotate its empty build with the pinned element type, per instance. Clones
    // ONLY this `LetDecl` (and its enclosing Block), never the shared original.
    if nt < 0 {
      if outName != "" {
        if n.letName == outName {
          // The instance's OUT type row is threaded down beside its spelling, so the
          // substituted annotation is minted from the type rather than from a
          // re-parse of the type's print. `monoOutType` is set at exactly two
          // producers and BOTH now hold the row (`pinTys[pli]`, and the list
          // inferrer's `outTy` hand-back), so there is nothing left to recover by
          // parsing.
          //
          // Every spelling reaching here is a COMPOSITE — measured over the three
          // corpus files that reach it, `i32[]`, `boolean[]`, `f64[]`, `string[]`,
          // `P[]`, 12 firings — and a composite never resolves back to the row it
          // was printed from, because `nameToTy` does not hash-cons. The arena grew
          // by one row on every one of those 12 firings.
          nt = synthTypeRefTy(outType, -1, outTyIx)
        }
      }
    }
    if nt == n.letType { return ix }
    return mkLet(n.letKw, n.letName, nt, n.letInit, n.pos)
  }
  if n is WhileStmt {
    const cb = monoCloneBody(
      n.whileBody,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    if cb == n.whileBody { return ix }
    return mkWhile(n.whileCond, cb, n.whileLabel, n.pos)
  }
  if n is IfStmt {
    const ct = monoCloneBody(
      n.ifThen,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    const ce = monoCloneBody(
      n.ifElse,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    if ct == n.ifThen && ce == n.ifElse { return ix }
    return mkIf(n.ifCond, ct, ce, n.pos)
  }
  if n is ForRange {
    const cb = monoCloneBody(
      n.frBody,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    if cb == n.frBody { return ix }
    return mkForRange(n.frVar, n.frFrom, n.frTo, n.frStep, cb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const cb = monoCloneBody(
      n.fiBody,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    if cb == n.fiBody { return ix }
    return mkForIn(n.fiVar, n.fiIter, cb, n.fiLabel, n.pos)
  }
  if n is RetStmt {
    // The return value may be a block / `if`-EXPRESSION carrying its own `LetDecl`s.
    const ca = monoCloneBody(
      n.retArg,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  if n is Paren {
    const ci = monoCloneBody(
      n.parInner,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    if ci == n.parInner { return ix }
    return mkParen(ci, n.pos)
  }
  // A pure expression / other statement carries no `LetDecl` annotation to rewrite — share.
  ix
}

// Whether an inline `.map` callback PRESERVES the element type — its tail expression is
// arithmetic / concatenation over the element (`x => x * 2`, `s => s + "!"`), so the result
// element type equals the source element. Lets the monomorphizer set a concrete map-result
// return annotation, since the inferred-return path has no f64/string-array map-result form.
function monoLambdaPreservesElem(argIx: i32) {
  const fnNodeIx = unwrapParen(argIx)
  const a = P.nodes[fnNodeIx]
  if a is FuncDecl {
    const tail = fnRetExprOf(fnNodeIx)
    if tail >= 0 {
      const t = P.nodes[unwrapParen(tail)]
      if t is BinExpr {
        const op = t.binOp
        return op == "+" || op == "-" || op == "*" || op == "/"
      }
    }
  }
  false
}

// The element type of `recvIx` when it is (a paren around) a PARAMETER reference whose pinned
// type is an array — looked up in the instance's (pNames → pElems) map. "" otherwise. Used to
// pin a `.map`/`.filter` callback's element from the concrete receiver of THIS instance.
function monoRecvParamElem(
  recvIx: i32,
  pNames: string[],
  pElems: string[],
  pElemTys: i32[],
  outTy: i32[],
) {
  const r = P.nodes[unwrapParen(recvIx)]
  if r is Ident {
    let i = 0
    while i < pNames.length {
      if pNames[i] == r.identName {
        // The ELEMENT ROW rides out beside the element name, from the column built
        // parallel to `pElems`. One lookup answers both, so the caller never has to
        // recover the row by re-parsing the name this returns.
        if i < pElemTys.length { outTy.push(pElemTys[i]) }
        return pElems[i]
      }
      i = i + 1
    }
  }
  ""
}

// Clone an INLINE `.map`/`.filter` callback lambda with its single un-annotated parameter
// PINNED to `elemType`, lift the clone into `fnStmts`, and return its node index — or -1 when
// the argument is not a cloneable un-annotated 1-param lambda (a named-function callback, an
// already-annotated param, or a different arity all ride their existing paths). The body is
// SHARED with the original: the emitter re-derives every operand type from the (now concrete)
// parameter per function, so one body lowers correctly under each pinned param.
function monoCloneLambdaPinned(argIx: i32, elemType: string, elemTyIx: i32) {
  const a = P.nodes[unwrapParen(argIx)]
  if a is FuncDecl {
    if a.fnParams.length == 1 {
      const p0 = P.nodes[a.fnParams[0]]
      if p0 is Param {
        if p0.parType < 0 {
          const np = mkParam(
            p0.parName,
            synthTypeRefTy(elemType, -1, elemTyIx),
            p0.parDefault,
            p0.parOpt,
            p0.pos,
          )
          // The pinned ELEMENT row is handed over rather than re-parsed out of the
          // element name. `pElemTys` is built beside `pElems` from the same pin
          // (`T.tys[pinTys[pe]].aElem`), so the row reaches this mint without the
          // name ever being turned back into a type.

          const nm = "__lambda_" + i32ToStr(lambdaCtr)
          lambdaCtr = lambdaCtr + 1
          const noTP: string[] = []
          const ps: i32[] = [np]
          const clone = mkFunc(nm, noTP, ps, a.fnRet, a.fnBody, a.pos)
          fnStmts.push(clone)
          fnParent.push(-1)
          fnDispNames.push("")
          fnValUsed = true
          return clone
        }
      }
    }
  }
  -1
}

// ── D426: a lambda declared inside a generic body is a TEMPLATE ──────────────
//
// `collectFns` runs BEFORE `monomorphize` and lifts `const g = (x: T[]) => …` exactly once,
// with the enclosing function's `T` still written on its parameters. `monoMakeInstance`
// rewrites the GENERIC's own annotations per pin, but the lifted lambda is a slot of its own
// that no instance owned, so ONE function served every instance at the unsubstituted type —
// its `$fnsig` key and its functype built from `T[]`, which lowers to the i32 default. The
// three sites below close that on the producer side: substitute at the pin
// (`monoCloneLambdaSubst`, driven by `monoPinBodyLambdas`) and stop emitting the template
// (`monoLamSlotIsTyParamTemplate`, read by the prune at the end of `monomorphize`). D426
// shipped only the FLOOR — `emitProgram: parameter `T[]` still names an unsubstituted type
// parameter` — and its own close called that a price; it stays for shapes this cannot reach.

// One annotation node, substituted through this instance's binding: a fresh `TypeRef` when a
// type parameter substitutes (`T[]` → `f64[]`), or -1 for "nothing to do" — the annotation is
// absent, is already concrete, or names a type parameter this instance could not bind.
//
// The SUBSTITUTED TYPE rides along rather than a re-parse of the substituted NAME, and it is
// gated the way `monoSubstLetType` and the return site gate theirs: `substTyDeep` rebuilds
// only what CHANGED, so a parameter it could not bind is left in place and is
// indistinguishable at the result from a full substitution. `tyHasTyVar` separates the two
// and fails toward the name path.
function monoSubstAnnNode(
  pty: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  if pty < 0 { return -1 }
  const tn = P.nodes[pty]
  if tn is TypeRef {
    // The RAW spelling where a type parameter is shadowed by a declared alias — the same
    // read every other substitution site in this file takes, for `monoDeclAnnName`'s reason.
    const ann = monoDeclAnnName(pty, tn.tyName, typarams)
    if monoAnnHasTyParam(ann, typarams) {
      const sub = monoSubstAnn(ann, typarams, tvN, tvV)
      // -2, NOT -1: the annotation DOES name a type parameter and the substitution produced no
      // new spelling for it (an UNBOUND parameter — `<T, U>` with only `T` bound by the
      // signature — or an identity). The caller has to tell that apart from "already concrete",
      // because a template it then leaves in place is one an instance body still refers to by
      // name, and the prune must not stub that.
      if sub == "" { return -2 }
      if sub == tn.tyName { return -2 }
      let sty = -1
      const orig = nodeTyIxOf(pty)
      if orig >= 0 {
        const s2 = substTyDeep(orig, bN, bT)
        if s2 >= 0 && s2 != orig {
          if !tyHasTyVar(s2) { sty = s2 }
        }
      }
      return synthTypeRefTy(sub, tn.pos, sty)
    }
  }
  -1
}

// Membership in one of the two lambda-template ledgers. Linear, and that is the right shape: a
// program holds a handful of such templates, and a set would be a hash table for three entries.
function monoI32ListHas(xs: i32[], v: i32) {
  let i = 0
  while i < xs.length {
    if xs[i] == v { return true }
    i = i + 1
  }
  false
}

function monoNoteLamNode(xs: i32[], v: i32) {
  if !monoI32ListHas(xs, v) { xs.push(v) }
  0
}

// D1116 — THE LIFTED SLOTS MINTED WHILE WALKING ONE LAMBDA'S BODY BELONG TO THAT LAMBDA'S
// CLONE, not to the enclosing instance. `monoMakeInstance` re-points every slot still standing
// in `monoLamMintedSlots` at the instance function, which is right for a lambda bound directly
// in the instance body and wrong one frame down: a nested clone's free names resolve up the
// chain THROUGH the lambda that encloses it, and `captureValKind` types an env field by that
// chain. Re-point the run from `mark` on, then retire each entry (-1, which the instance loop
// already skips) so the outer pass cannot undo it.
function monoReparentNestedLams(mark: i32, parentSlot: i32) {
  let k = mark
  while k < monoLamMintedSlots.length {
    const s = monoLamMintedSlots[k]
    if s >= 0 && s < fnParent.length { fnParent[s] = parentSlot }
    monoLamMintedSlots[k] = -1
    k = k + 1
  }
  0
}

// The lexical frame a lifted function's slot records (`fnParent`), found from its arena node.
// -1 when the node holds no lifted slot, which is the value `collectFns` itself pushes for a
// module-scope lift.
function monoLamParentOf(fnIx: i32) {
  let i = 0
  while i < fnStmts.length {
    if fnStmts[i] == fnIx {
      if i < fnParent.length { return fnParent[i] }
      return -1
    }
    i = i + 1
  }
  -1
}

// Clone the lifted lambda at `fnIx` with every type-param-mentioning parameter and return
// annotation SUBSTITUTED through this instance's binding, lift the clone into `fnStmts`, and
// return its node index — or -1 when nothing substitutes (a concrete lambda is correct at
// every pin and every instance keeps sharing it, so the all-concrete path emits what it
// always did).
//
// The BODY is SHARED with the original, exactly as `monoCloneLambdaPinned` shares it: the
// emitter re-derives every operand type from the (now concrete) parameter per function, so
// one body lowers correctly under each pin.
function monoCloneLambdaSubst(
  fnIx: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  const a = P.nodes[fnIx]
  if a is FuncDecl {
    // A NESTED GENERIC declaration carries pins of its own and is instantiated by
    // `monoInstantiate` at its own call sites; only a lambda that inherited the enclosing
    // frame's type parameters is this pass's business.
    if a.fnTyParams.length > 0 { return -1 }
    // NOT A TEMPLATE AT ALL — every annotation is concrete, so one lifted function is correct
    // at every pin and every instance keeps sharing it. Returned BEFORE either ledger is
    // touched: the prune reads them to decide whether a template is still referenced, and a
    // lambda that was never a template must not appear in either.
    if !monoLamNodeIsTemplate(fnIx, typarams) { return -1 }
    const ps: i32[] = []
    let any = false
    let i = 0
    while i < a.fnParams.length {
      const p = P.nodes[a.fnParams[i]]
      if p is Param {
        const nt = monoSubstAnnNode(p.parType, typarams, tvN, tvV, bN, bT)
        if nt >= 0 {
          ps.push(mkParam(p.parName, nt, p.parDefault, p.parOpt, p.pos))
          any = true
        } else if nt == -2 {
          // The annotation names a type parameter this instance cannot substitute. The
          // template stays, this instance keeps calling it, and the `checkParams` floor
          // refuses the program loudly — which is the honest answer, and the reason the
          // prune must be told.
          monoNoteLamNode(monoLamShared, fnIx)
          return -1
        } else {
          // Unchanged — share the original `Param` node, so a lambda with one generic and
          // one concrete parameter mints exactly one node.
          ps.push(a.fnParams[i])
        }
      } else {
        monoNoteLamNode(monoLamShared, fnIx)
        return -1
      }
      i = i + 1
    }
    let nret = a.fnRet
    const rt = monoSubstAnnNode(a.fnRet, typarams, tvN, tvV, bN, bT)
    if rt >= 0 {
      nret = rt
      any = true
    } else if rt == -2 {
      monoNoteLamNode(monoLamShared, fnIx)
      return -1
    }
    // D943 — `any` ASKS WHETHER A SIGNATURE CHANGED, and a capture-only template changes
    // none. The clone still has to happen: its purpose here is a fresh LIFTED SLOT, because
    // `fnEnvIdx` is parallel to `fnStmts` and one slot means one env struct for every
    // instance. `() => string` capturing a `T` substitutes nothing and needs its own env at
    // each `T`.
    let capOnly = false
    if !any {
      const feC = monoSlotOfLamNode(fnIx)
      if feC >= 0 {
        if captureCountOf(feC) > 0 { capOnly = true }
      }
    }
    // D1220 — A BODY SPELLING IS THE THIRD REASON TO CLONE, and the two above only read the
    // signature. `() => gv is T` takes no parameter, annotates no return and captures
    // nothing, so both rungs above answer no — while `monoFoldTyParamLayout` below has an
    // `is T` to substitute. Sharing one body across instances then answers the FIRST pin's
    // spelling at every pin: silently wrong, not invalid wasm. This is the same question
    // `monoLamNodeIsTemplate`'s fourth rung asks, and the two must agree or the prune stubs
    // a template no clone replaced.
    let bodyTP = false
    if !any && !capOnly {
      if monoNodeNamesTyParam(a.fnBody, typarams) { bodyTP = true }
    }
    if !any && !capOnly && !bodyTP {
      monoNoteLamNode(monoLamShared, fnIx)
      return -1
    }
    // AN UN-ANNOTATED RETURN THAT RIDES THE TYPE PARAMETER, annotated at the pin. The checker
    // records an anonymous lambda's inferred return under its NODE index, and the clone is a
    // node the checker never saw — but the generic template has no row either (the recorder
    // skips a lambda inside a generic body), so there is nothing to carry over and the
    // classifier is left re-deriving the rep from a body whose every type is a variable. For
    // `(x: T | null) => x` at `T := i32[]` it settled on the plain list and declared
    // `(result (ref $list))` over a body handing back `(ref null $list)` — check-clean invalid
    // wasm, the one shape the substitution alone moved from loud to silent.
    //
    // The RETURN EXPRESSION's own recorded type is the fact, substituted through the same
    // binding as the parameters — D592's fall-through move, one frame down. GATED ON THE TYPE
    // ACTUALLY CARRYING A VARIABLE, so an already-concrete return keeps today's inference.
    if nret < 0 {
      const rex = fnRetExprOf(fnIx)
      if rex >= 0 {
        const rty = nodeTyIxOf(rex)
        if rty >= 0 {
          if tyHasTyVar(rty) {
            const rs = substTyDeep(rty, bN, bT)
            if rs >= 0 && rs != rty {
              if !tyHasTyVar(rs) {
                const rnm = tyToEmitName(rs)
                if rnm != "" { nret = synthTypeRefTy(rnm, -1, rs) }
              }
            }
          }
        }
      }
    }
    // D1046 — A NESTED NAMED FUNCTION KEEPS ITS NAME. An anonymous lambda is reached
    // through the value the clone is written into, so a minted `__lambda_N` is
    // invisible; a nested `function id(a: T): T` is reached BY NAME through the frame
    // chain, so renaming it would leave every call in the instance body resolving to
    // nothing.
    let nm = a.fnName
    if !monoFnNameIsSourceNamed(nm) {
      nm = "__lambda_" + i32ToStr(lambdaCtr)
      lambdaCtr = lambdaCtr + 1
    }
    const noTP: string[] = []
    // D951 — AN `is T` INSIDE THE LAMBDA'S BODY. The body is otherwise shared with the
    // template (this function's header), which is right for every operand the emitter
    // RE-DERIVES from the now-concrete parameter — and wrong for an `is`, whose check type is
    // a SPELLING the body carries rather than a type anything re-derives. Substituted through
    // the same copy-on-write walker the enclosing instance body uses, so a lambda with no
    // type-parameter spelling in it returns the SAME node index and keeps sharing.
    const nbodyF = monoFoldTyParamLayout(a.fnBody, typarams, tvN, tvV)
    // D1116 — A LAMBDA NESTED INSIDE THIS ONE IS A TEMPLATE TOO, and `monoPinBodyLambdas`
    // walks only the INSTANCE body's spine, which reaches `const g = …` and stops at its
    // FuncDecl. `const g = () => { const h = () => v; h() }` therefore minted a fresh slot for
    // `g` per instance and left `h` on the one lifted slot every instance shares — D943's env
    // defect exactly, one frame down: at `T := i32` `h`'s env is `(struct (field i32))` and the
    // `T := string` instance emits `struct.new` of a string ref into it.
    //
    // Recursing here rather than teaching `monoPinBodyLambdas` a FuncDecl-initializer arm is
    // what keeps the two facts a clone owns together: the body substitution above and the
    // frame the nested clones hang off (`monoReparentNestedLams`, below the push).
    const mark = monoLamMintedSlots.length
    const nbody = monoPinBodyLambdas(nbodyF, typarams, tvN, tvV, bN, bT)
    const clone = mkFunc(nm, noTP, ps, nret, nbody, a.pos)
    // D1046 — THE FIRST INSTANCE OF A NAMED NESTED FUNCTION REPLACES THE TEMPLATE'S
    // SLOT rather than pushing beside it. See `monoInstIsFirst`: the by-name lookup
    // takes the FIRST child of the frame, and at `count == 0` the instance reuses the
    // template's frame, so two same-named children means the call answers the
    // unsubstituted template — a silently wrong callee rather than a loud one.
    // Later instances push and are re-pointed at their own frame by the caller.
    if monoFnNameIsSourceNamed(a.fnName) && monoInstIsFirst {
      const tSlot = monoSlotOfLamNode(fnIx)
      if tSlot >= 0 {
        fnStmts[tSlot] = clone
        monoNamedTmplNode.push(fnIx)
        monoNamedTmplSlot.push(tSlot)
        monoReparentNestedLams(mark, tSlot)
        fnValUsed = true
        monoNoteLamNode(monoLamPinned, fnIx)
        return clone
      }
    }
    fnStmts.push(clone)
    // THE ORIGINAL'S FRAME, not module scope. The clone shares the body, so its free names
    // have to resolve up the SAME scope chain or a lambda that both captures and annotates
    // `T` would lose its environment. (`monoCloneLambdaPinned` pushes -1 because a
    // `.map` callback is rebuilt from an ARGUMENT position, not from a lifted slot that has
    // a frame of its own.)
    fnParent.push(monoLamParentOf(fnIx))
    const mySlot = fnStmts.length - 1
    monoReparentNestedLams(mark, mySlot)
    monoLamMintedSlots.push(mySlot)
    fnDispNames.push("")
    fnValUsed = true
    monoNoteLamNode(monoLamPinned, fnIx)
    return clone
  }
  -1
}

// Per-instance lambda monomorphization for a lambda BOUND IN a generic body — the annotated
// sibling of `monoPinMapLambdas`. Walks the instance's statement spine and, at a `LetDecl`
// whose initializer is a lifted lambda whose annotations still mention a type parameter,
// substitutes at this pin and repoints the binding at the clone. Copy-on-write, so a body
// with no such lambda returns the same node index and a program without this shape emits
// exactly what it always did.
//
// BOUND, stated rather than discovered later: only a `LetDecl` INITIALIZER is rewritten. A
// lambda written at a type parameter in an ARGUMENT position (`apply((x: T[]) => …, a)`) is
// refused before this by the generic-HOF parameter floor — a different message and a
// different mechanism — and a lambda RETURNED from a generic body is the closure-result
// slice this file's `nret` ladder also excludes.
function monoPinBodyLambdas(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  if ix < 0 { return ix }
  if typarams.length == 0 { return ix }
  const n = P.nodes[ix]
  if n is Block {
    const ns: i32[] = []
    let changed = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoPinBodyLambdas(n.blkStmts[i], typarams, tvN, tvV, bN, bT)
      ns.push(cs)
      if cs != n.blkStmts[i] { changed = true }
      i = i + 1
    }
    if !changed { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is LetDecl {
    if n.letInit >= 0 {
      const iv = P.nodes[n.letInit]
      if iv is FuncDecl {
        const cl = monoCloneLambdaSubst(n.letInit, typarams, tvN, tvV, bN, bT)
        if cl < 0 { return ix }
        return mkLet(n.letKw, n.letName, n.letType, cl, n.pos)
      }
    }
    const ci = monoPinBodyLambdas(n.letInit, typarams, tvN, tvV, bN, bT)
    if ci == n.letInit { return ix }
    return mkLet(n.letKw, n.letName, n.letType, ci, n.pos)
  }
  // D1046 — A NESTED NAMED `function` STATEMENT IS THE DECLARATION FORM OF THE SAME
  // THING, and it was the one statement kind this walk had no arm for. `collectFns`
  // lifts it exactly like a lambda, so one lifted slot served every instance at the
  // UNSUBSTITUTED type — loud at `checkParams` when a PARAMETER names `T` (the message
  // still says "a lambda"), and check-clean INVALID WASM in the two spellings that
  // floor never reads: a return-only `T`, and a fully concrete signature that CAPTURES
  // a `T`-typed local (D943's defect at the named spelling).
  //
  // THE STATEMENT ITSELF EMITS NOTHING (`wasmEmit.emitStmt`'s `FuncDecl` arm), so the
  // node this returns is immaterial — the lifted SLOT is the whole effect. The
  // statement is returned unchanged so the spine stays shared when nothing was minted.
  if n is FuncDecl {
    if monoFnNameIsSourceNamed(n.fnName) {
      monoCloneLambdaSubst(ix, typarams, tvN, tvV, bN, bT)
    }
    return ix
  }
  if n is RetStmt {
    const ca = monoPinBodyLambdas(n.retArg, typarams, tvN, tvV, bN, bT)
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  // D943 — AN OBJECT LITERAL'S FIELD VALUE IS A POSITION A LAMBDA IS WRITTEN IN, and the
  // bound above ("only a `LetDecl` INITIALIZER is rewritten") left it out. `return { actual:
  // value, show: () => … }` is the shape a generic BUILDER has — a struct carrying both the
  // `T` value and a closure over it — and its lambda was never reached, so every instance
  // shared one lifted slot and therefore one env struct. Recurses as well as rewriting, so a
  // lambda nested deeper inside the literal is reached too.
  if n is ObjLit {
    const fs: i32[] = []
    let fchanged = false
    let fi = 0
    while fi < n.objFields.length {
      const fnode = P.nodes[n.objFields[fi]]
      let outF = n.objFields[fi]
      if fnode is FieldInit {
        const fv = P.nodes[fnode.fiValue]
        let nv = fnode.fiValue
        if fv is FuncDecl {
          const fcl = monoCloneLambdaSubst(
            fnode.fiValue,
            typarams,
            tvN,
            tvV,
            bN,
            bT,
          )
          if fcl >= 0 { nv = fcl }
        } else {
          nv = monoPinBodyLambdas(fnode.fiValue, typarams, tvN, tvV, bN, bT)
        }
        if nv != fnode.fiValue {
          outF = mkFieldInit(fnode.fiName, nv, fnode.pos)
          fchanged = true
        }
      }
      fs.push(outF)
      fi = fi + 1
    }
    if !fchanged { return ix }
    return mkObjLit(fs, n.pos)
  }
  if n is WhileStmt {
    const cb = monoPinBodyLambdas(n.whileBody, typarams, tvN, tvV, bN, bT)
    if cb == n.whileBody { return ix }
    return mkWhile(n.whileCond, cb, n.whileLabel, n.pos)
  }
  if n is IfStmt {
    const ct = monoPinBodyLambdas(n.ifThen, typarams, tvN, tvV, bN, bT)
    const ce = monoPinBodyLambdas(n.ifElse, typarams, tvN, tvV, bN, bT)
    if ct == n.ifThen && ce == n.ifElse { return ix }
    return mkIf(n.ifCond, ct, ce, n.pos)
  }
  if n is ForRange {
    const cb = monoPinBodyLambdas(n.frBody, typarams, tvN, tvV, bN, bT)
    if cb == n.frBody { return ix }
    return mkForRange(n.frVar, n.frFrom, n.frTo, n.frStep, cb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const cb = monoPinBodyLambdas(n.fiBody, typarams, tvN, tvV, bN, bT)
    if cb == n.fiBody { return ix }
    return mkForIn(n.fiVar, n.fiIter, cb, n.fiLabel, n.pos)
  }
  if n is Paren {
    const ci = monoPinBodyLambdas(n.parInner, typarams, tvN, tvV, bN, bT)
    if ci == n.parInner { return ix }
    return mkParen(ci, n.pos)
  }
  ix
}

// The type parameters of every ENCLOSING lifted frame of `fe`, appended to `out`. The chain is
// `fnParent`; each frame's ORIGINAL declaration is the one that carries the `<T>`, because
// `fnStmts[p]` may already hold that generic's FIRST instance, whose annotations are concrete
// by construction. Bounded by the function count, so it terminates even were `fnParent` ever
// to contain a cycle (the same bound `parentBindingFrameOf` takes).
function monoEnclosingTyParams(fe: i32, out: string[]) {
  let p = -1
  if fe < fnParent.length { p = fnParent[fe] }
  let guard = 0
  while p >= 0 && guard <= fnStmts.length {
    let nd = -1
    if p < monoOrigNode.length { nd = monoOrigNode[p] }
    else if p < fnStmts.length { nd = fnStmts[p] }
    if nd >= 0 {
      const fn = P.nodes[nd]
      if fn is FuncDecl {
        let i = 0
        while i < fn.fnTyParams.length {
          out.push(fn.fnTyParams[i])
          i = i + 1
        }
      }
    }
    if p < fnParent.length { p = fnParent[p] } else { p = -1 }
    guard = guard + 1
  }
  0
}

// Is the lifted slot `fe` a lambda TEMPLATE — an annotation still naming a type parameter of
// an enclosing generic frame? Every instantiation of that frame mints its own copy
// (`monoCloneLambdaSubst`), so this slot is to the lambda what an un-instantiated `<T>` decl is
// to a named generic: no concrete signature, and nothing in the module refers to it. The prune
// at the end of `monomorphize` stubs it for the same reason it stubs those. WITHOUT THIS THE
// SUBSTITUTION BUYS NOTHING: the template is emitted whether or not an instance exists, since
// a generic that is never CALLED still has its lambda lifted and `checkParams` reaches the slot
// directly. The two rungs are one landing.
// Does the subtree at `ix` carry a SPELLING that `monoFoldTyParamLayout` substitutes — an `is`
// whose check type mentions a type parameter, or a `T.field` layout constant? Those are the two
// places a type parameter reaches the emitter as source TEXT. Walked through `nodeChildren`
// rather than a second copy of the fold's arm ladder, which would drift.
function monoNodeNamesTyParam(ix: i32, typarams: string[]) {
  if ix < 0 || ix >= P.nodes.length { return false }
  if typarams.length == 0 { return false }
  const n = P.nodes[ix]
  if n is IsExpr {
    if monoAnnHasTyParam(n.isVariant, typarams) { return true }
  }
  if n is Member {
    const mo = P.nodes[n.memObj]
    if mo is Ident {
      if monoTyParamOf(mo.identName, typarams) != "" { return true }
    }
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if monoNodeNamesTyParam(kids[i], typarams) { return true }
    i = i + 1
  }
  false
}

function monoLamNodeIsTemplate(fnIx: i32, typarams: string[]) {
  if typarams.length == 0 { return false }
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    if fn.fnTyParams.length > 0 { return false }
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param {
        if p.parType >= 0 {
          const ann = monoDeclAnnName(p.parType, tyNameOf(p.parType), typarams)
          if monoAnnHasTyParam(ann, typarams) { return true }
        }
      }
      i = i + 1
    }
    if fn.fnRet >= 0 {
      const rann = monoDeclAnnName(fn.fnRet, tyNameOf(fn.fnRet), typarams)
      if monoAnnHasTyParam(rann, typarams) { return true }
    }
    // D943 — A CAPTURE IS PART OF A LAMBDA'S EFFECTIVE SIGNATURE, and the two checks above only
    // read the WRITTEN one. `show: () => string` inside `mk<T>` takes no parameter and returns a
    // concrete type, so it was shared across instances — while it CAPTURES `value: T`. One
    // lifted slot means ONE env struct (`fnEnvIdx` is parallel to `fnStmts`), so the first
    // instantiation's layout is the only one there is: at `T := i32` the env is minted
    // `(struct (field i32))` and the `T := string` instance then emits `struct.new` of a string
    // ref into that i32 field — check-clean invalid wasm, visible in the disassembly as both
    // `mk` instances building the same env type.
    //
    // ASKED AS "DOES IT CAPTURE AT ALL", not "does a capture mention `T`": the captures are
    // recorded by NAME (`capNamesFlat`), and being broad is SAFE in the direction that matters
    // — an extra clone is a correct clone, only larger, and the corpus lost no `runs` cell.
    const feIx = monoSlotOfLamNode(fnIx)
    if feIx >= 0 {
      if captureCountOf(feIx) > 0 { return true }
    }
    // D1220 — THE FOURTH RUNG: A TYPE PARAMETER NAMED IN THE BODY. The three above read the
    // written signature and the capture count, and a lambda can mention `T` in none of them:
    // `() => gv is T` has no parameters, an inferred return and no captures. Its only mention
    // of `T` is the `is` SPELLING, which `monoFoldTyParamLayout` substitutes per pin — so one
    // shared body answers the first instantiation's spelling at every instantiation and the
    // program is check-clean SILENTLY WRONG. Broad in the direction D943 argued for: an extra
    // clone is a correct clone, only larger.
    if monoNodeNamesTyParam(fn.fnBody, typarams) { return true }
  }
  false
}

function monoLamSlotIsTyParamTemplate(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return false }
  const tps: string[] = []
  monoEnclosingTyParams(fe, tps)
  monoLamNodeIsTemplate(fnStmts[fe], tps)
}

// Was any ENCLOSING frame of lifted slot `fe` instantiated? A template whose generic no call
// site ever pinned has no live reference: the generic's own slot is stubbed by the arm above in
// this same loop, and the body that named the lambda goes with it. Bounded by the function
// count, like every other `fnParent` walk here.
function monoLamFrameInstantiated(fe: i32) {
  let p = -1
  if fe < fnParent.length { p = fnParent[fe] }
  let guard = 0
  while p >= 0 && guard <= fnStmts.length {
    if monoInstantiatedAny(p) { return true }
    if p < fnParent.length { p = fnParent[p] } else { p = -1 }
    guard = guard + 1
  }
  false
}

// Per-instance lambda monomorphization for `.map`/`.filter`. The shared definition body of an
// un-annotated function is checked ONCE with the element as a hole, so an inline callback's
// un-annotated param defaults to i32 at emit (`checkParams`) — correct only for the i32 shape.
// When THIS instance pins the receiver param to a NON-i32 element (`self: f64[]`), clone the
// callback with its param pinned to the element type (`monoCloneLambdaPinned`) and rebuild the
// call to reference the clone, cloning the enclosing spine so sibling instances are untouched.
// The i32 shape (element "i32") is left as-is, so the golden i32 path is untouched.
function monoPinMapLambdas(
  ix: i32,
  pNames: string[],
  pElems: string[],
  pElemTys: i32[],
) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Block {
    const ns: i32[] = []
    let changed = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoPinMapLambdas(n.blkStmts[i], pNames, pElems, pElemTys)
      ns.push(cs)
      if cs != n.blkStmts[i] { changed = true }
      i = i + 1
    }
    if !changed { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is RetStmt {
    const ca = monoPinMapLambdas(n.retArg, pNames, pElems, pElemTys)
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  if n is LetDecl {
    const ci = monoPinMapLambdas(n.letInit, pNames, pElems, pElemTys)
    if ci == n.letInit { return ix }
    return mkLet(n.letKw, n.letName, n.letType, ci, n.pos)
  }
  if n is WhileStmt {
    const cb = monoPinMapLambdas(n.whileBody, pNames, pElems, pElemTys)
    if cb == n.whileBody { return ix }
    return mkWhile(n.whileCond, cb, n.whileLabel, n.pos)
  }
  if n is IfStmt {
    const ct = monoPinMapLambdas(n.ifThen, pNames, pElems, pElemTys)
    const ce = monoPinMapLambdas(n.ifElse, pNames, pElems, pElemTys)
    if ct == n.ifThen && ce == n.ifElse { return ix }
    return mkIf(n.ifCond, ct, ce, n.pos)
  }
  if n is ForRange {
    const cb = monoPinMapLambdas(n.frBody, pNames, pElems, pElemTys)
    if cb == n.frBody { return ix }
    return mkForRange(n.frVar, n.frFrom, n.frTo, n.frStep, cb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const cb = monoPinMapLambdas(n.fiBody, pNames, pElems, pElemTys)
    if cb == n.fiBody { return ix }
    return mkForIn(n.fiVar, n.fiIter, cb, n.fiLabel, n.pos)
  }
  if n is Paren {
    const ci = monoPinMapLambdas(n.parInner, pNames, pElems, pElemTys)
    if ci == n.parInner { return ix }
    return mkParen(ci, n.pos)
  }
  if n is Call {
    let newCallee = n.callFn
    const callee = P.nodes[n.callFn]
    // A `<paramRecv>.map/.filter(<lambda>)` over a concrete NON-i32 element: pin the callback.
    if callee is Member {
      const recvNew = monoPinMapLambdas(callee.memObj, pNames, pElems, pElemTys)
      if recvNew != callee.memObj {
        newCallee = mkMember(recvNew, callee.memProp, callee.pos)
      }
      if callee.memProp == "map" || callee.memProp == "filter" {
        if n.callArgs.length == 1 {
          const elemTyOut: i32[] = []
          const elem = monoRecvParamElem(
            callee.memObj,
            pNames,
            pElems,
            pElemTys,
            elemTyOut,
          )
          if elem != "" && elem != "i32" {
            let elemTy = -1
            if elemTyOut.length > 0 { elemTy = elemTyOut[0] }
            const cloned = monoCloneLambdaPinned(n.callArgs[0], elem, elemTy)
            if cloned >= 0 {
              const oneArg: i32[] = [cloned]
              return mkCallN(newCallee, oneArg, n.callArgNames, n.pos)
            }
          }
        }
      }
    }
    // Otherwise recurse into the arguments (a map call may be nested in one).
    const nargs: i32[] = []
    let changed = newCallee != n.callFn
    let ai = 0
    while ai < n.callArgs.length {
      const cca = monoPinMapLambdas(n.callArgs[ai], pNames, pElems, pElemTys)
      nargs.push(cca)
      if cca != n.callArgs[ai] { changed = true }
      ai = ai + 1
    }
    if !changed { return ix }
    return mkCallN(newCallee, nargs, n.callArgNames, n.pos)
  }
  ix
}

// Rebuild the name→index map and the voidness/return-kind inference after a new
// instance lands in `fnStmts`, so later argument classification sees its
// concrete signature. Also re-runs `collectA` (a pinned `string[]`/`f64`
// annotation may force list/array types the original generic name never did).
function monoRebuild() {
  if collectA(monoProgStmts) < 0 { return -1 }
  if buildFnMap(monoProgStmts) < 0 { return -1 }
  computeVoidFns()
  computeRetInference()
  0
}

// The PARAMETER an un-annotated `return <local>` list is built from: a
// `<retName>.push(<param>[<idx>])` statement anywhere in `blockIx` (descending into
// while / if / for bodies). The built list shares the indexed param's array type, so the
// monomorphizer types the un-annotated return as that param's pinned type. "" = none found.
function monoListSrcParam(blockIx: i32, retName: string) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      const r = monoListSrcParamStmt(stmts[i], retName)
      if r != "" { return r }
      i = i + 1
    }
  }
  ""
}

function monoListSrcParamStmt(ix: i32, retName: string) {
  const s = P.nodes[ix]
  if s is Block { return monoListSrcParam(ix, retName) }
  if s is WhileStmt { return monoListSrcParam(s.whileBody, retName) }
  if s is ForRange { return monoListSrcParam(s.frBody, retName) }
  if s is ForIn { return monoListSrcParam(s.fiBody, retName) }
  if s is IfStmt {
    const rt = monoListSrcParam(s.ifThen, retName)
    if rt != "" { return rt }
    if s.ifElse >= 0 { return monoListSrcParamStmt(s.ifElse, retName) }
    return ""
  }
  // A `<retName>.push(<param>[<idx>])` statement: the param is the list's element source.
  if s is Call {
    const callee = P.nodes[s.callFn]
    if callee is Member {
      if callee.memProp == "push" {
        const recv = P.nodes[callee.memObj]
        if recv is Ident {
          if recv.identName == retName {
            if s.callArgs.length == 1 {
              const arg = P.nodes[s.callArgs[0]]
              if arg is Index {
                const ia = P.nodes[arg.idxArr]
                if ia is Ident { return ia.identName }
              }
            }
          }
        }
      }
    }
  }
  ""
}

// CALLBACK SPECIALIZATION (devirtualization): rewrite every call THROUGH a closure-typed param
// `<cbParamNames[k]>(args)` in a cloned instance body into a DIRECT call to the concrete
// non-capturing function `<cbFnNames[k]>` it was instantiated with. The per-element `call_ref`
// through the fat pointer becomes a `call $fn` (the emitter's direct-call path pushes the null
// env a non-capturing callee wants), which is a large win on the native host for the
// allocation-free fold/reduce/search family. The closure VALUE is still passed (the param stays
// in the list), so non-call uses of the callback — returning it, threading it through a
// recursive self-call — keep working through it; only the call positions are redirected.
// Mirrors `monoPinMapLambdas`' clone-if-changed spine so sibling instances (and the shared
// original body) are never mutated. A param with `cbFnNames == ""` (capturing / generic / not a
// known function) leaves its calls as `call_ref`, so nothing about that program changes.
function monoBakeCallback(
  ix: i32,
  cbParamNames: string[],
  cbFnNames: string[],
) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Block {
    const ns: i32[] = []
    let changed = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoBakeCallback(n.blkStmts[i], cbParamNames, cbFnNames)
      ns.push(cs)
      if cs != n.blkStmts[i] { changed = true }
      i = i + 1
    }
    if !changed { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is RetStmt {
    const ca = monoBakeCallback(n.retArg, cbParamNames, cbFnNames)
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  if n is LetDecl {
    const ci = monoBakeCallback(n.letInit, cbParamNames, cbFnNames)
    if ci == n.letInit { return ix }
    return mkLet(n.letKw, n.letName, n.letType, ci, n.pos)
  }
  if n is WhileStmt {
    const cb = monoBakeCallback(n.whileBody, cbParamNames, cbFnNames)
    if cb == n.whileBody { return ix }
    return mkWhile(n.whileCond, cb, n.whileLabel, n.pos)
  }
  if n is IfStmt {
    const ct = monoBakeCallback(n.ifThen, cbParamNames, cbFnNames)
    const ce = monoBakeCallback(n.ifElse, cbParamNames, cbFnNames)
    if ct == n.ifThen && ce == n.ifElse { return ix }
    return mkIf(n.ifCond, ct, ce, n.pos)
  }
  if n is ForRange {
    const cb = monoBakeCallback(n.frBody, cbParamNames, cbFnNames)
    if cb == n.frBody { return ix }
    return mkForRange(n.frVar, n.frFrom, n.frTo, n.frStep, cb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const cb = monoBakeCallback(n.fiBody, cbParamNames, cbFnNames)
    if cb == n.fiBody { return ix }
    return mkForIn(n.fiVar, n.fiIter, cb, n.fiLabel, n.pos)
  }
  if n is Paren {
    const ci = monoBakeCallback(n.parInner, cbParamNames, cbFnNames)
    if ci == n.parInner { return ix }
    return mkParen(ci, n.pos)
  }
  if n is Call {
    // A call whose callee names a specialized closure param `f(...)` → direct call `cbFn(...)`;
    // its arguments may themselves contain such calls (`f(g(x))`), so recurse there too.
    let newCallee = n.callFn
    const callee = P.nodes[n.callFn]
    if callee is Ident {
      let bk = 0
      while bk < cbParamNames.length {
        if cbFnNames[bk] != "" && callee.identName == cbParamNames[bk] {
          newCallee = mkIdent(cbFnNames[bk], callee.pos)
        }
        bk = bk + 1
      }
    }
    const nargs: i32[] = []
    let changed = newCallee != n.callFn
    let ai = 0
    while ai < n.callArgs.length {
      const cca = monoBakeCallback(n.callArgs[ai], cbParamNames, cbFnNames)
      nargs.push(cca)
      if cca != n.callArgs[ai] { changed = true }
      ai = ai + 1
    }
    if !changed { return ix }
    return mkCallN(newCallee, nargs, n.callArgNames, n.pos)
  }
  if n is BinExpr {
    // Descend into a plain assignment / arithmetic node (`acc = f(acc, x)`, the reduce/fold
    // shape). A COMPOUND-assignment node (`acc += f(x)`, `binCompound != ""`) is left intact —
    // rebuilding it through `mkBinary` would drop its surface tag, and its callback call simply
    // stays a `call_ref` (sound, just unspecialized — a rare shape).
    if n.binCompound != "" { return ix }
    const cl = monoBakeCallback(n.binLeft, cbParamNames, cbFnNames)
    const cr = monoBakeCallback(n.binRight, cbParamNames, cbFnNames)
    if cl == n.binLeft && cr == n.binRight { return ix }
    return mkBinary(n.binOp, cl, cr, n.pos)
  }
  ix
}

// Whether `name` resolves to a lifted slot the pre-pass flagged GENERIC — exactly the condition
// under which `monoWalk` reaches `monoInstantiate` and a callee `Ident` gets renamed IN PLACE to an
// instance name. An appended instance slot (`at$1`, past the frozen `monoGen` length) is concrete.
function monoCalleeIsGeneric(name: string) {
  const fe = fnIndexOf(name)
  if fe < 0 { return false }
  if fe >= monoGen.length { return false }
  monoGen[fe] == 1
}

// ── the `is` node's per-instance twin ────────────────────────────────────────────────────────
// Three body walkers re-mint an `IsExpr` when its RECEIVER moved (`monoCloneGenericCalls`,
// `monoFoldTyParamLayout`, `monoPinBinOps`), and a fourth SUBSTITUTES its check spelling (D951).
// All four go through here, because minting an `is` node has a second half the `mk*` maker does
// not do: `isVarTyIx` — the CHECK TYPE the checker banked at the original — is keyed by node and
// sized at `checkProgram` entry, so a freshly minted node reads -1 for ever unless it is banked.
// `isVarTyIxOf` is what `emitIs`'s whole ladder reads (`isArmTagOfTy`, `tyIsLitUnion`,
// `nulNicheIsTestImpossible`, `repIsRowMatchTy`, `isVariantSpelling`), so dropping it silently
// demotes a re-parented test to the NAME path.
function monoMkIsExprLike(ix: i32, io: i32, variant: string) {
  const n = P.nodes[ix]
  if n is IsExpr {
    if n.isNeg == 1 { return mkIsExprNeg(io, variant, n.pos) }
    return mkIsExpr(io, variant, n.pos)
  }
  -1
}
// Re-parent onto the rewritten receiver `io`: SAME test, so the original's banked row carries.
function monoReIsExpr(ix: i32, io: i32) {
  const n = P.nodes[ix]
  if n is IsExpr {
    const nx = monoMkIsExprLike(ix, io, n.isVariant)
    recordClonedIsVarTyIx(nx, isVarTyIxOf(ix))
    return nx
  }
  ix
}
// D951 — `is T` AGAINST THE TYPE PARAMETER ITSELF. Under monomorphization `T` is CONCRETE per
// instance, so `y is T` is the same question every other per-instance `is` asks. Substituting the
// SPELLING here makes `y is T` at `T := i32` the SAME PROGRAM as `y is i32` — one rewrite, and
// the entire existing ladder (the nullable niche arms, the litunion arms, the struct/variant tag
// compare, the narrow push) applies unchanged, so every instantiation agrees with its hand-written
// concrete spelling BY CONSTRUCTION rather than by a second implementation that has to be kept in
// step. The banked row must come from the NEW spelling: the original's is the declaration's
// `TyVar`, which renders as the empty string and is exactly what made the two rungs below answer
// wrongly (`monoStaticIsResult` folded to `i32.const 0`; the union-variant floor refused loudly).
function monoSubstIsExpr(ix: i32, io: i32, variant: string) {
  const n = P.nodes[ix]
  if n is IsExpr {
    const nx = monoMkIsExprLike(ix, io, variant)
    recordClonedIsVarTy(nx, variant)
    return nx
  }
  ix
}

// Give an instance its OWN copy of every direct call to a generic — the `Call` node and its
// callee `Ident` — so the per-instance rename `monoWalk`/`monoMakeInstance` perform lands on
// nodes no sibling instance can see. Instances otherwise SHARE the original's body arena (only
// the `LetDecl` spine is rebuilt, per `monoCloneBody`), so a body containing `at(xs, 0)` handed
// that one `Ident` to every instance: the LAST shape to instantiate `at` won and the earlier
// instances called the wrong element type's `at` — a `vl check`-clean invalid module. The file
// header flags the same aliasing for a RECURSIVE generic: a self-call is that case.
//
// Clone-if-changed over `monoWalk`'s EXACT traversal, so every position a rename can reach is
// covered and a body with no generic call returns the SAME node index. The FIRST instance clones
// too, keeping `monoOrigNode`'s body pristine; leaves stay shared, and a COMPOUND assignment is
// left intact because `mkBinary` would drop its surface tag.
function monoCloneGenericCalls(ix: i32) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Call {
    let newCallee = n.callFn
    const callee = P.nodes[n.callFn]
    if callee is Ident {
      if monoCalleeIsGeneric(callee.identName) {
        newCallee = mkIdent(callee.identName, callee.pos)
      }
    } else {
      newCallee = monoCloneGenericCalls(n.callFn)
    }
    let changed = newCallee != n.callFn
    const nargs: i32[] = []
    let ai = 0
    while ai < n.callArgs.length {
      const ca = monoCloneGenericCalls(n.callArgs[ai])
      nargs.push(ca)
      if ca != n.callArgs[ai] { changed = true }
      ai = ai + 1
    }
    if !changed { return ix }
    return mkCallN(newCallee, nargs, n.callArgNames, n.pos)
  }
  if n is Block {
    const ns: i32[] = []
    let bchanged = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoCloneGenericCalls(n.blkStmts[i])
      ns.push(cs)
      if cs != n.blkStmts[i] { bchanged = true }
      i = i + 1
    }
    if !bchanged { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is LetDecl {
    const ci = monoCloneGenericCalls(n.letInit)
    if ci == n.letInit { return ix }
    return mkLet(n.letKw, n.letName, n.letType, ci, n.pos)
  }
  if n is RetStmt {
    const ca2 = monoCloneGenericCalls(n.retArg)
    if ca2 == n.retArg { return ix }
    return mkReturn(ca2, n.pos)
  }
  if n is IfStmt {
    const cc = monoCloneGenericCalls(n.ifCond)
    const ct = monoCloneGenericCalls(n.ifThen)
    const ce = monoCloneGenericCalls(n.ifElse)
    if cc == n.ifCond && ct == n.ifThen && ce == n.ifElse { return ix }
    return mkIf(cc, ct, ce, n.pos)
  }
  if n is WhileStmt {
    const wc = monoCloneGenericCalls(n.whileCond)
    const wb = monoCloneGenericCalls(n.whileBody)
    if wc == n.whileCond && wb == n.whileBody { return ix }
    return mkWhile(wc, wb, n.whileLabel, n.pos)
  }
  if n is ForRange {
    const ff = monoCloneGenericCalls(n.frFrom)
    const ft = monoCloneGenericCalls(n.frTo)
    const fs = monoCloneGenericCalls(n.frStep)
    const fb = monoCloneGenericCalls(n.frBody)
    if ff == n.frFrom && ft == n.frTo && fs == n.frStep && fb == n.frBody {
      return ix
    }
    return mkForRange(n.frVar, ff, ft, fs, fb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const fi = monoCloneGenericCalls(n.fiIter)
    const fbi = monoCloneGenericCalls(n.fiBody)
    if fi == n.fiIter && fbi == n.fiBody { return ix }
    return mkForIn(n.fiVar, fi, fbi, n.fiLabel, n.pos)
  }
  if n is BinExpr {
    // A COMPOUND assignment (`acc += at(xs, 1)`) desugars to `target = (target op value)` with the
    // TARGET node SHARED between the read and the write, so its limbs cannot be rebuilt
    // independently — re-synthesize the whole form from its parts through the maker that
    // re-establishes that sharing, cloning the TARGET once and (for `op=`) the VALUE limb.
    //
    // The target carries a generic call whenever it is not a bare local: `vals[idx(xs, 0)] += 5`,
    // `++vals[idx(xs, 0)]`. Leaving it shared handed ONE callee `Ident` to every instance, so the
    // last element type to instantiate won and the earlier instances called the wrong shape — the
    // same aliasing `monoCloneGenericCalls` exists to break, in the two positions its first pass
    // did not reach. The PREFIX `++`/`--` form (`mkPreIncr`, `binCompound` `"++"`/`"--"`) has no
    // value limb — its `1` is synthesized — but it does have a target, so it is rebuilt too.
    // (POSTFIX `x++` is a different shape and cannot carry one; see the `Unary` arm.)
    if n.binCompound != "" {
      const ct = monoCloneGenericCalls(n.binLeft)
      if n.binCompound == "++" || n.binCompound == "--" {
        if ct == n.binLeft { return ix }
        return mkPreIncr(n.binCompound, ct, n.pos)
      }
      const inner = P.nodes[n.binRight]
      if inner is BinExpr {
        const iv = monoCloneGenericCalls(inner.binRight)
        if iv == inner.binRight && ct == n.binLeft { return ix }
        return mkCompoundAssign(n.binCompound, ct, iv, n.pos)
      }
      return ix
    }
    const bl = monoCloneGenericCalls(n.binLeft)
    const br = monoCloneGenericCalls(n.binRight)
    if bl == n.binLeft && br == n.binRight { return ix }
    return mkBinary(n.binOp, bl, br, n.pos)
  }
  if n is Unary {
    // A POSTFIX `x++`/`x--` rides a `Unary` over the assignment whose operand IS the mutated
    // target — leave it whole for the same reason the compound form is re-synthesized. Nothing to
    // clone inside it either way: the parser accepts a postfix target only when it is an
    // IDENTIFIER ("postfix `++` target must be an identifier"), and an `Ident` holds no call.
    if n.unOp == "p+" || n.unOp == "p-" { return ix }
    const ua = monoCloneGenericCalls(n.unArg)
    if ua == n.unArg { return ix }
    return mkUnary(n.unOp, ua, n.pos)
  }
  if n is Paren {
    const pi = monoCloneGenericCalls(n.parInner)
    if pi == n.parInner { return ix }
    return mkParen(pi, n.pos)
  }
  if n is Member {
    const mo = monoCloneGenericCalls(n.memObj)
    if mo == n.memObj { return ix }
    return mkMember(mo, n.memProp, n.pos)
  }
  if n is OptMember {
    const oo = monoCloneGenericCalls(n.omObj)
    if oo == n.omObj { return ix }
    return mkOptMember(oo, n.omProp, n.pos)
  }
  if n is Index {
    const xa = monoCloneGenericCalls(n.idxArr)
    const xi = monoCloneGenericCalls(n.idxIndex)
    if xa == n.idxArr && xi == n.idxIndex { return ix }
    return mkIndex(xa, xi, n.pos)
  }
  if n is IsExpr {
    const io = monoCloneGenericCalls(n.isObj)
    if io == n.isObj { return ix }
    return monoReIsExpr(ix, io)
  }
  if n is AsExpr {
    const ao = monoCloneGenericCalls(n.asObj)
    if ao == n.asObj { return ix }
    return mkAsExpr(ao, n.asTy, n.asMode, n.pos)
  }
  if n is ArrayLit {
    const es: i32[] = []
    let echanged = false
    let ei = 0
    while ei < n.arrElems.length {
      const ce = monoCloneGenericCalls(n.arrElems[ei])
      es.push(ce)
      if ce != n.arrElems[ei] { echanged = true }
      ei = ei + 1
    }
    if !echanged { return ix }
    return mkArrayLit(es, n.pos)
  }
  if n is ObjLit {
    const fl: i32[] = []
    let ochanged = false
    let oi = 0
    while oi < n.objFields.length {
      let nf = n.objFields[oi]
      const f = P.nodes[nf]
      if f is FieldInit {
        const cv = monoCloneGenericCalls(f.fiValue)
        if cv != f.fiValue {
          nf = mkFieldInit(f.fiName, cv, f.pos)
          ochanged = true
        }
      }
      fl.push(nf)
      oi = oi + 1
    }
    if !ochanged { return ix }
    return mkObjLit(fl, n.pos)
  }
  ix
}

// ── the per-instance layout fold: `T.size` / `T.<field>` (webcraft P1.2) ─────
// A generic body may read the LAYOUT of one of its type parameters — the stride a
// generic row accessor multiplies by (`self.base + i * T.size`) and the field
// offsets it adds. The checker types those members `i32` and leaves the `Member`
// node standing (`typecheck.flatMemberFold` answer 3), because the constant does
// not exist until a BINDING does, and the binding is this pass's.
//
// Clone-if-changed over `monoCloneGenericCalls`' traversal, and for its reason:
// instances SHARE the original's expression arena, so folding in place would hand
// every instance the LAST binding's constants — a `Rows<Node>` addressed at another
// type's stride, a silent wrong ADDRESS rather than a loud failure. Every failure
// here is loud and names the binding, because the checker could not: it saw `T`.

// ── the two questions `dispatchRewrite` had to ask of a HOLE, re-asked at the PIN ──
// `dispatchRewrite` runs BEFORE monomorphization, so inside a GENERIC body its `BinExpr` arm
// asks both of its questions of an operand whose type is still a type parameter. Both degrade
// to "no" on a hole and both answers are wrong once the hole is pinned: D511 — `nodeTyIsObj` is
// false of a `TyVar`, so an operator OVERLOAD is not dispatched and `a ^ b` falls to the numeric
// tail, `i32.xor` over two `(ref $type)`; D512 — `nodeTyExcludesNull` is false of a `TyVar`, so
// the `??` node reaches the emitter's own reject where the DIRECT spelling of the same program
// runs. ONE RUNG, because it is one mechanism, and it must live here: the pinned type exists
// nowhere else. ONE RUNG IS NOT ONE EDIT — the two arms below are SEPARATELY load-bearing, so
// do not collapse them. COPY-ON-WRITE like every per-instance rung here. The pin is read off
// `pinnedTyIx`, never re-parsed from its SPELLING (`nameToTy` does not hash-cons). THE ARM SET
// IS `monoFoldTyParamLayout`'s, ARM FOR ARM: a missing arm in a walker of this shape is SILENT.

// The PINNED type row of a body expression that reads a monomorphized PARAMETER, or -1.
//
// TWO gates, and the second is the scope test the leak this closes never had: the name
// must match a parameter of the instance, AND the checker's recorded type at that node
// must still carry a type VARIABLE. A local that SHADOWS the parameter is typed
// concretely by the checker, so it fails the second gate and the pin is not applied to
// it — which a bare name match (the shape of `declaredStructIndex`) cannot distinguish.
function monoPinnedOperandTy(ix: i32, pNames: string[], pTys: i32[]) {
  if ix < 0 { return -1 }
  const e = P.nodes[ix]
  if e is Ident {
    if !tyHasTyVar(nodeTyIxOf(ix)) { return -1 }
    let i = 0
    while i < pNames.length {
      if pNames[i] == e.identName {
        if i < pTys.length { return pTys[i] }
        return -1
      }
      i = i + 1
    }
  }
  -1
}

// `drwWalk`'s `BinExpr` arm, re-run over ONE instance body with the pin in hand. The two
// rewrites are the SAME two `drwWalk` makes — the `??` fold to the left operand and the
// `op(a, b)` self-function dispatch — so a pinned cell reaches exactly the lowering its
// DIRECT twin reaches, which is what the rows are graded against.
//
// The FIELD-closure dispatch route (`(a."op")(b)`) is deliberately NOT here: it needs the
// emitter's struct TABLE row, not a type, and `structIndexOfExpr` cannot be asked for one
// from a pin. `binOpDefinedFor`'s `objOpDispatchTy` does defer such a receiver, so that
// combination stays exactly as invalid as it is today — no cell moves either way, and it
// is named as residue rather than left to be discovered.
function monoPinBinOps(ix: i32, pNames: string[], pTys: i32[]) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is BinExpr {
    // A COMPOUND assignment shares its TARGET node between the read and the write, so its
    // limbs cannot be rebuilt independently — left whole, exactly as `monoFoldTyParamLayout`
    // leaves it. `a ^= b` over an overload is not a form the direct spelling lowers either.
    if n.binCompound != "" { return ix }
    const bl = monoPinBinOps(n.binLeft, pNames, pTys)
    const br = monoPinBinOps(n.binRight, pNames, pTys)
    const plt = monoPinnedOperandTy(n.binLeft, pNames, pTys)
    if plt >= 0 {
      // D512: the pin PROVABLY admits no null, so `??` is the identity on its left
      // operand — `tyExcludesNull` is the same predicate `nodeTyExcludesNull` asks of a
      // node, shared so the two homes cannot disagree about which operands make a `??`
      // redundant.
      if n.binOp == "??" {
        if tyExcludesNull(plt) { return bl }
      }
      // D511: an OBJECT pin with a free `self`-function named for the operator.
      if drwDispatchOp(n.binOp) {
        const pot = T.tys[plt]
        if pot is TyObj {
          if drwSelfFnOf(n.binOp, 2) >= 0 {
            const oargs: i32[] = []
            oargs.push(bl)
            oargs.push(br)
            return mkCall(mkIdent(n.binOp, -1), oargs, -1)
          }
        }
      }
    }
    if bl == n.binLeft && br == n.binRight { return ix }
    return mkBinary(n.binOp, bl, br, n.pos)
  }
  if n is Block {
    const ns: i32[] = []
    let bchanged = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoPinBinOps(n.blkStmts[i], pNames, pTys)
      ns.push(cs)
      if cs != n.blkStmts[i] { bchanged = true }
      i = i + 1
    }
    if !bchanged { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is LetDecl {
    const ci = monoPinBinOps(n.letInit, pNames, pTys)
    if ci == n.letInit { return ix }
    return mkLet(n.letKw, n.letName, n.letType, ci, n.pos)
  }
  if n is RetStmt {
    const ca = monoPinBinOps(n.retArg, pNames, pTys)
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  if n is IfStmt {
    const cc = monoPinBinOps(n.ifCond, pNames, pTys)
    const ct = monoPinBinOps(n.ifThen, pNames, pTys)
    const ce = monoPinBinOps(n.ifElse, pNames, pTys)
    if cc == n.ifCond && ct == n.ifThen && ce == n.ifElse { return ix }
    return mkIf(cc, ct, ce, n.pos)
  }
  if n is WhileStmt {
    const wc = monoPinBinOps(n.whileCond, pNames, pTys)
    const wb = monoPinBinOps(n.whileBody, pNames, pTys)
    if wc == n.whileCond && wb == n.whileBody { return ix }
    return mkWhile(wc, wb, n.whileLabel, n.pos)
  }
  if n is ForRange {
    const ff = monoPinBinOps(n.frFrom, pNames, pTys)
    const ft = monoPinBinOps(n.frTo, pNames, pTys)
    const fs = monoPinBinOps(n.frStep, pNames, pTys)
    const fb = monoPinBinOps(n.frBody, pNames, pTys)
    if ff == n.frFrom && ft == n.frTo && fs == n.frStep && fb == n.frBody {
      return ix
    }
    return mkForRange(n.frVar, ff, ft, fs, fb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const fi = monoPinBinOps(n.fiIter, pNames, pTys)
    const fbi = monoPinBinOps(n.fiBody, pNames, pTys)
    if fi == n.fiIter && fbi == n.fiBody { return ix }
    return mkForIn(n.fiVar, fi, fbi, n.fiLabel, n.pos)
  }
  if n is Call {
    const cf = monoPinBinOps(n.callFn, pNames, pTys)
    let changed = cf != n.callFn
    const nargs: i32[] = []
    let ai = 0
    while ai < n.callArgs.length {
      const ca2 = monoPinBinOps(n.callArgs[ai], pNames, pTys)
      nargs.push(ca2)
      if ca2 != n.callArgs[ai] { changed = true }
      ai = ai + 1
    }
    // D1063 — `drwWalk`'s MEMBER-CALL arm, re-run over ONE instance body with the pin in hand,
    // exactly as the `BinExpr` arm above re-runs its two. `dispatchRewrite` runs BEFORE
    // monomorphization, so it meets `x.tag()` while `x` is still a type parameter and has to
    // answer for every instance at once. Where the instantiations DISAGREE — one receiver
    // carrying a callable field of that name, another taking the free `self`-function — no
    // single answer is right and `drwAnyInstanceTakesField` DEFERS. This is where that deferred
    // question is answered, per instance, off the pin the instance was built from.
    //
    // FIELD FIRST, the checker's own precedence and the same predicate `drwAnyInstanceTakesField`
    // asks of the call-site argument types (`tyFieldTyOf`): a callable field wins and the member
    // call stays, so `exprIsClosure` lowers it as a `call_ref`; otherwise the free `self`-function
    // answers and the call is rebuilt as the plain direct call. COPY-ON-WRITE like every rung here.
    const pcallee = P.nodes[n.callFn]
    if pcallee is Member {
      const precvTy = monoPinnedOperandTy(pcallee.memObj, pNames, pTys)
      if precvTy >= 0 && tyFieldTyOf(precvTy, pcallee.memProp) < 0 {
        // The site's own alias, not the plain property: the module merge mangles a free
        // `self`-function and leaves the call's property plain, and `ix` is the node the
        // merge walk banked its answer on.
        const puName = ufcsAliasAtSite(ix, pcallee.memProp)
        if drwSelfFnOf(puName, nargs.length + 1) >= 0 {
          const puArgs: i32[] = []
          puArgs.push(pcallee.memObj)
          let pu = 0
          while pu < nargs.length {
            puArgs.push(nargs[pu])
            pu = pu + 1
          }
          // The injected receiver is an UNNAMED slot-0 positional; an all-positional call
          // keeps its empty name list so `hasNamedArgs` stays false downstream.
          const puNames: string[] = []
          if hasNamedArgs(n.callArgNames) {
            puNames.push("")
            let pn = 0
            while pn < n.callArgNames.length {
              puNames.push(n.callArgNames[pn])
              pn = pn + 1
            }
          }
          return mkCallN(mkIdent(puName, -1), puArgs, puNames, n.pos)
        }
      }
    }
    if !changed { return ix }
    return mkCallN(cf, nargs, n.callArgNames, n.pos)
  }
  if n is Unary {
    // A POSTFIX `x++`/`x--` rides a `Unary` over the assignment whose operand IS the
    // mutated target — left whole for the compound form's reason.
    if n.unOp == "p+" || n.unOp == "p-" { return ix }
    const ua = monoPinBinOps(n.unArg, pNames, pTys)
    if ua == n.unArg { return ix }
    return mkUnary(n.unOp, ua, n.pos)
  }
  if n is Paren {
    const pi = monoPinBinOps(n.parInner, pNames, pTys)
    if pi == n.parInner { return ix }
    return mkParen(pi, n.pos)
  }
  if n is Member {
    const mo = monoPinBinOps(n.memObj, pNames, pTys)
    if mo == n.memObj { return ix }
    return mkMember(mo, n.memProp, n.pos)
  }
  if n is OptMember {
    const oo = monoPinBinOps(n.omObj, pNames, pTys)
    if oo == n.omObj { return ix }
    return mkOptMember(oo, n.omProp, n.pos)
  }
  if n is Index {
    const ia = monoPinBinOps(n.idxArr, pNames, pTys)
    const ii = monoPinBinOps(n.idxIndex, pNames, pTys)
    if ia == n.idxArr && ii == n.idxIndex { return ix }
    return mkIndex(ia, ii, n.pos)
  }
  if n is IsExpr {
    const io = monoPinBinOps(n.isObj, pNames, pTys)
    if io == n.isObj { return ix }
    return monoReIsExpr(ix, io)
  }
  if n is AsExpr {
    const ao = monoPinBinOps(n.asObj, pNames, pTys)
    if ao == n.asObj { return ix }
    return mkAsExpr(ao, n.asTy, n.asMode, n.pos)
  }
  if n is ArrayLit {
    const es: i32[] = []
    let echanged = false
    let ei = 0
    while ei < n.arrElems.length {
      const ce = monoPinBinOps(n.arrElems[ei], pNames, pTys)
      es.push(ce)
      if ce != n.arrElems[ei] { echanged = true }
      ei = ei + 1
    }
    if !echanged { return ix }
    return mkArrayLit(es, n.pos)
  }
  if n is ObjLit {
    const fl: i32[] = []
    let ochanged = false
    let oi = 0
    while oi < n.objFields.length {
      let nf = n.objFields[oi]
      const f = P.nodes[nf]
      if f is FieldInit {
        const cv = monoPinBinOps(f.fiValue, pNames, pTys)
        if cv != f.fiValue {
          nf = mkFieldInit(f.fiName, cv, f.pos)
          ochanged = true
        }
      }
      fl.push(nf)
      oi = oi + 1
    }
    if !ochanged { return ix }
    return mkObjLit(fl, n.pos)
  }
  ix
}

function monoFoldTyParamLayout(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Member {
    const mo = P.nodes[n.memObj]
    if mo is Ident {
      if monoTyParamOf(mo.identName, typarams) != "" {
        const bind = monoBindOf(tvN, tvV, mo.identName)
        if bind == "" {
          emitFail(
            "emitProgram: monomorphize: `" +
              mo.identName +
              "." +
              n.memProp +
              "` needs `" +
              mo.identName +
              "` bound by a parameter — a layout constant is per-instance",
          )
          return ix
        }
        const v = flatConstOfNameProp(bind, n.memProp)
        if v == -1 {
          emitFail(
            "emitProgram: monomorphize: `" +
              mo.identName +
              "` is bound to `" +
              bind +
              "`, which is not a `flat` type, so it has no byte layout",
          )
          return ix
        }
        if v == -2 {
          emitFail(
            "emitProgram: monomorphize: `flat type " +
              bind +
              "` (bound to `" +
              mo.identName +
              "`) has no field '" +
              n.memProp +
              "' — its layout members are `.size` and one offset per declared field",
          )
          return ix
        }
        return mkNum(i32ToStr(v), n.pos)
      }
    }
    const mc = monoFoldTyParamLayout(n.memObj, typarams, tvN, tvV)
    if mc == n.memObj { return ix }
    return mkMember(mc, n.memProp, n.pos)
  }
  if n is Block {
    const ns: i32[] = []
    let bchanged = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoFoldTyParamLayout(n.blkStmts[i], typarams, tvN, tvV)
      ns.push(cs)
      if cs != n.blkStmts[i] { bchanged = true }
      i = i + 1
    }
    if !bchanged { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is LetDecl {
    const ci = monoFoldTyParamLayout(n.letInit, typarams, tvN, tvV)
    if ci == n.letInit { return ix }
    return mkLet(n.letKw, n.letName, n.letType, ci, n.pos)
  }
  if n is RetStmt {
    const ca = monoFoldTyParamLayout(n.retArg, typarams, tvN, tvV)
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  if n is IfStmt {
    const cc = monoFoldTyParamLayout(n.ifCond, typarams, tvN, tvV)
    const ct = monoFoldTyParamLayout(n.ifThen, typarams, tvN, tvV)
    const ce = monoFoldTyParamLayout(n.ifElse, typarams, tvN, tvV)
    if cc == n.ifCond && ct == n.ifThen && ce == n.ifElse { return ix }
    return mkIf(cc, ct, ce, n.pos)
  }
  if n is WhileStmt {
    const wc = monoFoldTyParamLayout(n.whileCond, typarams, tvN, tvV)
    const wb = monoFoldTyParamLayout(n.whileBody, typarams, tvN, tvV)
    if wc == n.whileCond && wb == n.whileBody { return ix }
    return mkWhile(wc, wb, n.whileLabel, n.pos)
  }
  if n is ForRange {
    const ff = monoFoldTyParamLayout(n.frFrom, typarams, tvN, tvV)
    const ft = monoFoldTyParamLayout(n.frTo, typarams, tvN, tvV)
    const fs = monoFoldTyParamLayout(n.frStep, typarams, tvN, tvV)
    const fb = monoFoldTyParamLayout(n.frBody, typarams, tvN, tvV)
    if ff == n.frFrom && ft == n.frTo && fs == n.frStep && fb == n.frBody {
      return ix
    }
    return mkForRange(n.frVar, ff, ft, fs, fb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const fi = monoFoldTyParamLayout(n.fiIter, typarams, tvN, tvV)
    const fbi = monoFoldTyParamLayout(n.fiBody, typarams, tvN, tvV)
    if fi == n.fiIter && fbi == n.fiBody { return ix }
    return mkForIn(n.fiVar, fi, fbi, n.fiLabel, n.pos)
  }
  if n is Call {
    const cf = monoFoldTyParamLayout(n.callFn, typarams, tvN, tvV)
    let changed = cf != n.callFn
    const nargs: i32[] = []
    let ai = 0
    while ai < n.callArgs.length {
      const ca2 = monoFoldTyParamLayout(n.callArgs[ai], typarams, tvN, tvV)
      nargs.push(ca2)
      if ca2 != n.callArgs[ai] { changed = true }
      ai = ai + 1
    }
    if !changed { return ix }
    return mkCallN(cf, nargs, n.callArgNames, n.pos)
  }
  if n is BinExpr {
    // A COMPOUND assignment shares its TARGET node between the read and the write,
    // so its limbs cannot be rebuilt independently — re-synthesize the whole form
    // through the maker that re-establishes that sharing, exactly as
    // `monoCloneGenericCalls` does.
    if n.binCompound != "" {
      const ct2 = monoFoldTyParamLayout(n.binLeft, typarams, tvN, tvV)
      if n.binCompound == "++" || n.binCompound == "--" {
        if ct2 == n.binLeft { return ix }
        return mkPreIncr(n.binCompound, ct2, n.pos)
      }
      const inner = P.nodes[n.binRight]
      if inner is BinExpr {
        const iv = monoFoldTyParamLayout(inner.binRight, typarams, tvN, tvV)
        if iv == inner.binRight && ct2 == n.binLeft { return ix }
        return mkCompoundAssign(n.binCompound, ct2, iv, n.pos)
      }
      return ix
    }
    const bl = monoFoldTyParamLayout(n.binLeft, typarams, tvN, tvV)
    const br = monoFoldTyParamLayout(n.binRight, typarams, tvN, tvV)
    if bl == n.binLeft && br == n.binRight { return ix }
    return mkBinary(n.binOp, bl, br, n.pos)
  }
  if n is Unary {
    // A POSTFIX `x++`/`x--` rides a `Unary` over the assignment whose operand IS
    // the mutated target — left whole for the compound form's reason.
    if n.unOp == "p+" || n.unOp == "p-" { return ix }
    const ua = monoFoldTyParamLayout(n.unArg, typarams, tvN, tvV)
    if ua == n.unArg { return ix }
    return mkUnary(n.unOp, ua, n.pos)
  }
  if n is Paren {
    const pi = monoFoldTyParamLayout(n.parInner, typarams, tvN, tvV)
    if pi == n.parInner { return ix }
    return mkParen(pi, n.pos)
  }
  if n is OptMember {
    const oo = monoFoldTyParamLayout(n.omObj, typarams, tvN, tvV)
    if oo == n.omObj { return ix }
    return mkOptMember(oo, n.omProp, n.pos)
  }
  if n is Index {
    const xa = monoFoldTyParamLayout(n.idxArr, typarams, tvN, tvV)
    const xi = monoFoldTyParamLayout(n.idxIndex, typarams, tvN, tvV)
    if xa == n.idxArr && xi == n.idxIndex { return ix }
    return mkIndex(xa, xi, n.pos)
  }
  if n is IsExpr {
    const io = monoFoldTyParamLayout(n.isObj, typarams, tvN, tvV)
    // D951 — the check spelling is substituted only when it MENTIONS a type parameter, the
    // `monoAnnHasTyParam`-then-`monoSubstAnn` contract every other substitution site keeps. A
    // concrete `is {v: i32}` inside a generic body must return VERBATIM: `monoSubstAnn`'s object
    // arm rebuilds a shape spelling from its parts, and a rebuilt spelling is a second intern key.
    if monoAnnHasTyParam(n.isVariant, typarams) {
      const sub = monoSubstAnn(n.isVariant, typarams, tvN, tvV)
      if sub != "" && sub != n.isVariant { return monoSubstIsExpr(ix, io, sub) }
    }
    if io == n.isObj { return ix }
    return monoReIsExpr(ix, io)
  }
  if n is AsExpr {
    const ao = monoFoldTyParamLayout(n.asObj, typarams, tvN, tvV)
    if ao == n.asObj { return ix }
    return mkAsExpr(ao, n.asTy, n.asMode, n.pos)
  }
  if n is ArrayLit {
    const es: i32[] = []
    let echanged = false
    let ei = 0
    while ei < n.arrElems.length {
      const ce = monoFoldTyParamLayout(n.arrElems[ei], typarams, tvN, tvV)
      es.push(ce)
      if ce != n.arrElems[ei] { echanged = true }
      ei = ei + 1
    }
    if !echanged { return ix }
    return mkArrayLit(es, n.pos)
  }
  if n is ObjLit {
    const fl: i32[] = []
    let ochanged = false
    let oi = 0
    while oi < n.objFields.length {
      let nf = n.objFields[oi]
      const f = P.nodes[nf]
      if f is FieldInit {
        const cv = monoFoldTyParamLayout(f.fiValue, typarams, tvN, tvV)
        if cv != f.fiValue {
          nf = mkFieldInit(f.fiName, cv, f.pos)
          ochanged = true
        }
      }
      fl.push(nf)
      oi = oi + 1
    }
    if !ochanged { return ix }
    return mkObjLit(fl, n.pos)
  }
  ix
}

// Whether a specialization callback was baked for ANY param (the instance has at least one
// `cbFnNames[k] != ""`) — gates the body rewrite + key extension below.
function monoAnyBakedCallback(cbFnNames: string[]) {
  let i = 0
  while i < cbFnNames.length {
    if cbFnNames[i] != "" { return true }
    i = i + 1
  }
  false
}

// The instance-creation core shared by `monoInstantiate` (call-driven) and `monoInstanceFor`
// (annotation-driven): given the already-built `pinned` param-type names (and any `tvN`/`tvV`
// type-param bindings), clone-or-reuse the instance of generic `origFe` and point the value site
// at it. `calleeIx` is the `Ident` node (a call callee, or a binding init) rewritten to the
// instance name on a registry hit / a `count > 0` append. `annotateI32` annotates an i32-pinned
// param too (so the materialized closure passes the value floor) — `monoInstantiate` keeps it
// false so the all-i32 call path is untouched. `cbFnNames` (parallel to params, "" = none) bakes
// a non-capturing concrete callback into the instance as a direct call — see `monoBakeCallback`.
// Returns 0, or -1 via `emitFail`.
// THE PIN COLUMN for one instance's parameter list, built in a single parallel pass keyed by
// param index — a per-parameter FACT belongs beside the parameters, not coded into one of their
// strings. The bridge from the legacy marker is `pinKindOfName` + `sigKeyPinPayload`, its home.
function monoBuildPinCol(pinned: string[], kinds: i32[], pays: string[]) {
  let i = 0
  while i < pinned.length {
    kinds.push(pinKindOfName(pinned[i]))
    pays.push(sigKeyPinPayload(pinned[i]))
    i = i + 1
  }
  0
}

// D988 — THE KEY SUFFIX AN ANONYMOUS-SHAPE PIN NEEDS, or "" for every other pin.
//
// A hole parameter pins the ARGUMENT's type NAME, and an object literal's name is the synthetic
// row name `collectAnonShapes` minted (`#anon0`). That name is per struct ROW, and two literals
// with the same field NAMES share a row whatever their field types are — so `hole({f: () =>
// "ok"})` and `hole({f: () => 7})` pin the same `#anon0`, key the same instance, and ONE `hole`
// is emitted for two receivers whose closure fields have different result types. Its single
// `call_indirect` then signature-checks the receiver the body did not resolve, and it TRAPS.
//
// THE ARENA ALREADY KNOWS THEY DIFFER — the pin's own type column says so. THE RENDERING IS THE
// RIGHT GRAIN, not the type INDEX: same-shape literals have distinct arena rows, so keying on
// the index mints an instance per call site. Scoped to `#anon` pins; a NAMED type is one row.
function monoAnonPinDiscrim(pin: string, tyIx: i32): string {
  if tyIx < 0 { return "" }
  if pin.length < 5 { return "" }
  if pin[0] != "#"[0] { return "" }
  const rendered = tyToEmitName(tyIx)
  if rendered == "" { return "" }
  "=" + rendered
}

// D1042 — THE EMITTER-VOCABULARY SPELLING of a name `monoSubstAnn` produced, for the ONE shape
// where the two can disagree: a UNION.
//
// `monoSubstAnn` is a STRING substitution into the DECLARED annotation text, so its result
// carries whatever the source wrote — a literal member stays a literal (`T | "err"` at
// `T := i32` → `i32|"err"`). Every other producer of a union key has been through
// `canonEmitTypeNames`, which at `RC_ROOT` softens a literal member to its base scalar, so the
// direct spelling of that union is keyed `i32|string`. `canonEmitName` is that rewrite applied
// to a whole render — the same move `collectTyReachRegister` makes for an ARENA-derived key.
//
// GATED ON BEING A UNION, and the gate is what leaves every other pin alone. `splitUnionAtoms`
// stops at a top-level `=>`, so only a genuine top-level union is ever re-rendered.
function monoPinUnionName(rs: string): string {
  const atoms: string[] = []
  splitUnionAtoms(rs, atoms)
  if atoms.length < 2 { return rs }
  const c = canonEmitName(rs)
  if c == "" { return rs }
  c
}

// D1042 — REGISTER a union that exists only because a generic was PINNED here.
//
// The union registry is minted by `collectU`, which the pass table orders BEFORE
// `monomorphize`, and nothing re-runs it afterwards — `collectA#2` rescans annotations for
// shapes, not for unions. So a `T | E` return at a concrete `T` had no row under EITHER
// spelling and every consumer of the box (the atom test, the `is` tag, the coerce ladder) hit
// its loud floor. `registerInlineUnion` self-gates on `isUName`, so a union any earlier
// producer registered is a no-op; that gating is also what keeps ONE row per union, since a
// box's tags are the row's POSITIONALLY — reuse is the correctness condition, not a saving.
//
// TAGS ARE RE-RANKED WHEN, AND ONLY WHEN, A VARIANT LANDED: `assignTags` ranks variants
// GLOBALLY, and a VALUE union pushes none. Unconditional re-ranking would be quadratic.
function monoRegisterPinUnion(name: string) {
  const atoms: string[] = []
  splitUnionAtoms(name, atoms)
  if atoms.length < 2 { return 0 }
  if isUName(name) { return 0 }
  const before = uVariants.length
  if registerInlineUnion(monoProgStmts, name) < 0 { return -1 }
  if uVariants.length != before { return assignTags() }
  0
}

function monoMakeInstance(
  origFe: i32,
  pinned: string[],
  pinKinds: i32[],
  pinPays: string[],
  pinTys: i32[],
  tvN: string[],
  tvV: string[],
  calleeIx: i32,
  annotateI32: boolean,
  cbFnNames: string[],
) {
  // The pin columns are positional and nothing downstream can tell a MISALIGNED one from a
  // correct one — param j would silently read param k's type. Checked once, loudly, here,
  // rather than bounds-guarding each read: a guard on the read turns misalignment into a
  // silently WRONG type, while the sibling `pinned[pj]` on the same line traps. Two reads
  // off one index must not have opposite failure policies, and a SHORT-BUT-NONEMPTY column
  // is exactly the case a bounds guard cannot see.
  if pinTys.length != pinned.length {
    return emitFail(
      "emitProgram: monomorphize: pin type column is not parallel to the pins",
    )
  }
  const fn = P.nodes[monoOrigNode[origFe]]
  if fn is FuncDecl {
    const params = fn.fnParams
    let key = i32ToStr(origFe) + "#"
    let pk = 0
    while pk < pinned.length {
      key = key + pinned[pk] + monoAnonPinDiscrim(pinned[pk], pinTys[pk]) + ","
      pk = pk + 1
    }
    // The baked-callback identities extend the key, so two calls passing the SAME pinned types but
    // DIFFERENT non-capturing callbacks (`reduce(xs, add, …)` vs `reduce(xs, mul, …)`) get distinct
    // instances — each body bakes its own direct call. No baked callback → no `@` suffix → the key
    // (and the resulting instance) is exactly the pre-specialization one.
    let ck = 0
    while ck < cbFnNames.length {
      if cbFnNames[ck] != "" { key = key + "@" + cbFnNames[ck] + "," }
      ck = ck + 1
    }
    // A closure-pinned param flips the module's function-value machinery on
    // (the instance body `call_ref`s through it; the argument side builds the
    // fat pointer) — the same flag a lifted lambda flips in `liftFnsInExpr`.
    let pv = 0
    while pv < pinKinds.length {
      if pinKinds[pv] == PIN_SIGKEY { fnValUsed = true }
      pv = pv + 1
    }
    // Registry hit: point this call site at the existing instance.
    let k = 0
    while k < monoKeys.length {
      if monoKeys[k] == key {
        const cal = P.nodes[calleeIx]
        if cal is Ident {
          // A registry hit on a CAPTURING lambda in the binding's OWN slot (a count-0 instance,
          // `monoInstFe == origFe`) must stay a `call_ref` through that binding — renaming the
          // callee to the lifted instance name would make a by-name call that drops the captured
          // env. A non-capturing instance keeps the by-name rename (a null env is fine), so the
          // named-function path is untouched.
          //
          // THE SIBLING ARM THIS LADDER LACKED (#1821): the binding is REASSIGNED. The rename
          // folds `v(10)` into a by-name call to the INITIALIZER's instance, faithful only while
          // the binding still holds that initializer — a later `v = (n) => n + 2` is invisible
          // and every call after the FIRST answers the first lambda. `monoWalk`'s named-function
          // fold already guards on this (`monoNameIsAssigned`); the anon-lambda arm did not.
          // Silent wrong ANSWER, not invalid wasm. Only the count-0 rung needs the arena scan.
          let keepCallRef = false
          if monoInstFe[k] == origFe && cal.identName != monoInstName[k] {
            if captureCountOf(origFe) > 0 { keepCallRef = true }
            else if monoNameIsAssigned(cal.identName) { keepCallRef = true }
          }
          if !keepCallRef {
            if cal.identName != monoInstName[k] {
              cal.identName = monoInstName[k]
              // R4 writer 5 of 8 (`compiler/symbols.vl`; census in `perf-program.md`).
              sidNoteNodeName(calleeIx)
            }
          }
        }
        // A VALUE use (`annotateI32`) reaching an instance a DIRECT CALL already built. The call
        // path spells an i32 pin as the hole it was — `parType = -1`, the emitter's default kind,
        // zero new arena nodes — which changes nothing for a CALL but leaves
        // `fnHasUnannotatedParam` true, so the emit-time value floor rejects a function this very
        // program has already pinned monomorphic. Write the pin onto the shared slot: the pinned
        // name IS the kind the slot already lowers at, so every call through it is unchanged, and
        // the value now carries the ONE signature the floor requires. ORDER-INDEPENDENCE is the
        // point — without it `add(1, 2)` BEFORE `apply(add, …)` rejects while the same two lines
        // in the other order compile, which is not a rule anyone can hold.
        if annotateI32 {
          const hfn = P.nodes[fnStmts[monoInstFe[k]]]
          if hfn is FuncDecl {
            const hps = hfn.fnParams
            if hps.length == pinned.length {
              let hp = 0
              while hp < hps.length {
                const hpp = P.nodes[hps[hp]]
                if hpp is Param {
                  if hpp.parType < 0 {
                    // The synthesis IS the whole write: `synthTypeRef` records the new
                    // node's type under the same pin this column holds (`monoBuildPinCol`
                    // is `pinKinds`' only producer and computes it with `pinKindOfName`),
                    // and this arm needs no index of its own.
                    // The NAME path, not the fallback the clone arm below takes. Equivalent
                    // today rather than by construction: this arm is gated on `annotateI32`,
                    // which only `monoInstanceFor` passes true, and that caller's column is
                    // all -1. If a call-driven path ever sets it, route this through
                    // `synthTypeRefFb` too — otherwise the recorded type would depend on
                    // which call site materialized the instance first, which is the
                    // ORDER-INDEPENDENCE this block exists to keep.
                    hpp.parType = synthTypeRef(pinned[hp], -1)
                  }
                }
                hp = hp + 1
              }
            }
          }
        }
        return 0
      }
      k = k + 1
    }
    // New shape: clone the ORIGINAL declaration with pinned annotations. An
    // un-annotated param pinned at plain i32 keeps `parType = -1` (the
    // emitter's default kind — zero new arena nodes on the all-i32 path).
    let count = 0
    let k2 = 0
    while k2 < monoInstOrig.length {
      if monoInstOrig[k2] == origFe { count = count + 1 }
      k2 = k2 + 1
    }
    const nps: i32[] = []
    // The pinned params as ARENA INDICES, one row per entry of `params` (-1 = no resolvable
    // type). This is the column the speculative-inference windows below take: the pin is
    // resolved ONCE, here at the clone, and never re-resolved from its spelling.
    const pinnedTyIx: i32[] = []
    let pj = 0
    while pj < params.length {
      let pinTy = -1
      const p3 = P.nodes[params[pj]]
      if p3 is Param {
        let nt = -1
        // Whether `nt` is a node this loop SYNTHESIZED (and which therefore already
        // carries its recorded type) or the original declaration's own annotation node.
        let synthed = false
        if p3.parType >= 0 {
          // The pinned name differs from the written annotation exactly when
          // a type param substituted through it (bare `T`, `T[]`, or a
          // composite like `Box<T>`); a concrete annotation keeps its node.
          if pinned[pj] == tyNameOf(p3.parType) {
            nt = p3.parType
          } else {
            nt = synthTypeRefFb(pinned[pj], -1, pinTys[pj])
            synthed = true
          }
        } else if annotateI32 || pinned[pj] != "i32" {
          nt = synthTypeRefFb(pinned[pj], -1, pinTys[pj])
          synthed = true
        }
        // C1 endgame: the pinned CONCRETE param type is recorded on the instance's annotation
        // node so the emitter's structural classifiers cover this monomorphized param (not just
        // the name fallback), and `pinTy` is that index — banked, because the speculative
        // inference windows below are index-fed from exactly here and re-resolve nothing.
        //
        // A SYNTHESIZED node ALREADY CARRIES IT: `synthTypeRef` calls `recordClonedNodeTy` on
        // the way out with the same (node, name, pin) triple `monoBuildPinCol` computed, so a
        // recorder call here would resolve it twice — and `nameToTy` does not hash-cons, so the
        // second resolution of a COMPOSITE spelling appends an identical `T.tys` row and answers
        // with ITS index. The node is the one home. The ORIGINAL declaration's node
        // (`nt = p3.parType`) is a different case: it carries the CHECKER's resolution taken in
        // the generic body's type-param frame, so the pin the instance needs is recorded here.
        if nt >= 0 {
          if synthed {
            pinTy = nodeTyIxOf(nt)
          } else {
            // THE NODE OFTEN ALREADY HOLDS THE ANSWER. This arm is reached only when
            // `pinned[pj] == tyNameOf(p3.parType)` — the pinned name IS the written annotation —
            // so the checker's recorded type for that node is usually the pin itself, and
            // `recordClonedNodeTy` re-parses the spelling to re-derive it. Since `nameToTy` is
            // not hash-consed, that mint is a duplicate row, and over the corpus nearly every
            // call re-derives a type that renders IDENTICALLY to the one already on the node.
            //
            // The few that DO differ are the case the header above describes and are why the
            // call cannot simply be deleted: the original declaration's node carries the
            // checker's resolution taken in the GENERIC BODY'S type-param frame. `tyHasTyVar`
            // separates the two populations completely — the counts are in
            // `docs/internals/destringify-types-program.md`.
            const already = nodeTyIxOf(nt)
            if already >= 0 && !tyHasTyVar(already) {
              pinTy = already
            } else {
              pinTy = recordClonedNodeTy(nt, pinned[pj], pinKinds[pj])
            }
          }
        } else {
          // The one arm that mints no annotation node: an un-annotated param pinned at plain
          // i32 (`nt` stays -1 by design, so the all-i32 path adds zero arena nodes).
          pinTy = i32TyIx()
        }
        // D681/R1 — AN ANON PIN'S TYPE IS ITS ROW'S, NOT THE PLACEHOLDER'S. `pinTy` above is
        // whatever the pin's NAME resolved to, and `#anonN` resolves to nothing: the node
        // records `objPinTyIx()`, a field-less `TyObj`. This column is what the speculative
        // re-check windows `declare` the parameters as and bind the type parameters to, so a
        // `{}` pin makes `const xs: T[]; return xs[0]` re-check as `{}` — inventory D641,
        // where the row the return needs is interned and the re-check never names its shape.
        // The row's own arena type is the concrete answer the name stands for.
        const anonTy = anonHandleTyIx(pinned[pj])
        if anonTy >= 0 { pinTy = anonTy }
        nps.push(mkParam(p3.parName, nt, p3.parDefault, p3.parOpt, -1))
        // D926 — AND THE `??` OWNER MARK, which is keyed by ARENA NODE and so does not
        // survive a clone on its own. See `anonLeafCarryParamMark`.
        anonLeafCarryParamMark(params[pj], nps[nps.length - 1])
      }
      pinnedTyIx.push(pinTy)
      pj = pj + 1
    }
    // THE BODY'S binding column, built from `pinnedTyIx` — the column the clone loop above just
    // resolved — EXCEPT at a FUNCTION-TYPE parameter, where it takes the argument's own arena row
    // (`pinTys`). `pinnedTyIx` is the pin re-resolved from the pin's NAME, and a pin name comes
    // from `monoSubstAnn`, which substitutes each type parameter's BOUND NAME; a literal union's
    // bound name is the SOFTENED `string`, so `f: (T, i32) => U` over a `"a" | "b"`-returning
    // callback binds `U := string` while the argument's `TyFunc` binds `U := "a" | "b"`. ONE
    // INSTANCE THEN SPELLED `U[]` TWO WAYS — an atom-backed list in the RETURN annotation, a
    // string-ref-backed one in the body — `vl check` rc 0 and the engine refusing it at load.
    //
    // AND NOT EVERYWHERE, which was measured rather than reasoned: taking `pinTys` at EVERY
    // position reddens the litunion-ORDERING family, because a VALUE parameter's pin NAME carries
    // the nominal fact (`nameToTy("K")` answers the REGISTERED alias) an arena row does not.
    const letTyCol: i32[] = []
    let lj = 0
    while lj < params.length {
      let lt = -1
      if lj < pinnedTyIx.length { lt = pinnedTyIx[lj] }
      if lj < pinned.length {
        if annArrowAt(pinned[lj]) >= 1 || pinKinds[lj] == PIN_SIGKEY {
          if lj < pinTys.length && pinTys[lj] >= 0 { lt = pinTys[lj] }
        }
      }
      letTyCol.push(lt)
      lj = lj + 1
    }
    const letBN: string[] = []
    const letBT: i32[] = []
    monoBindCols(params, letTyCol, letBN, letBT)
    // Substitute a type-param-riding RETURN annotation through the binding —
    // bare `T` / `T[]`, an application (`Box<T>`), or an inline object shape
    // (`{first:B,second:A}`); a concrete annotation passes through unchanged.
    let nret = fn.fnRet
    // A hole-built return list local to annotate in the cloned instance body (so its `[]`
    // build classifies per element type — f64/struct as well as i32/string). Captured from
    // the return trace below, threaded into `monoCloneBody` which clones+annotates just
    // that `LetDecl` per instance (never the shared original).
    let monoOutName = ""
    let monoOutType = ""
    // The arena row for `monoOutType`, carried beside the spelling so the body clone
    // mints from the type instead of re-parsing the print. -1 where no producer ran,
    // which `synthTypeRefTy` treats exactly as today's name resolution.
    let monoOutTypeIx = -1
    if fn.fnRet >= 0 {
      // The parameter pin's rule, applied to the RETURN for the same reason: a shadowed
      // return annotation is canon'd out of the arena before this read.
      const rn = monoDeclAnnName(fn.fnRet, tyNameOf(fn.fnRet), fn.fnTyParams)
      if monoAnnHasTyParam(rn, fn.fnTyParams) {
        const rs = monoSubstAnn(rn, fn.fnTyParams, tvN, tvV)
        if rs == "" {
          return emitFail(
            "emitProgram: monomorphize: a return type parameter of `" +
              fn.fnName +
              "` is not bound by any parameter",
          )
        }
        // THE SUBSTITUTED TYPE, not a re-parse of the substituted NAME. `synthTypeRef` is
        // `synthTypeRefTy(…, -1)` and -1 resolves the name — minting a structurally identical
        // `Ty` row, `nameToTy` not being hash-consed. This one site was the largest single
        // remaining source of those re-parses (`docs/internals/destringify-types-program.md`).
        //
        // The answer is computed the way the CHECKER would: `monoBindFromAnn` / `monoSubstAnn`
        // are hand-written STRING twins of `bindGenWalk` / `substTyDeep`, and the ARGUMENT types
        // those need are already in `pinTys`. GATED ON COMPLETENESS, and the gate is what makes
        // it safe rather than merely agreeable — `substTyDeep` rebuilds only what CHANGED, so a
        // parameter it could not bind is left in place and NOT reported, indistinguishable at the
        // result from a full substitution. `tyHasTyVar` separates them and fails toward the name
        // path (its depth bound returns TRUE), so an unknown keeps master's behaviour.
        let retTy = -1
        const origRet = nodeTyIxOf(fn.fnRet)
        if origRet >= 0 {
          const bN: string[] = []
          const bT: i32[] = []
          // THE SAME COLUMN THE PARAMETER SLOT AND THE BODY'S BINDINGS TAKE, and that agreement
          // is the invariant, not a preference. `letTyCol` is `pinnedTyIx` — the pin re-resolved
          // from the pin's NAME — with the function-type exception this file's own header
          // explains. `pinTys` is the ARGUMENT NODE's arena row, and the instance registry is
          // keyed on `pinned` (the NAMES) alone: sourcing the RESULT from a column the key does
          // not carry made the instance a function of something the key cannot see, so two call
          // sites keying to ONE instance could demand two different ones and whichever the
          // walker reached first won.
          //
          // The witness is one program with its DECLARATION ORDER SWAPPED: a narrowed and an
          // un-narrowed caller of the same `idg`, running one way round and a module the engine
          // refuses the other. See DECISIONS.md.
          monoBindCols(params, letTyCol, bN, bT)
          const sub2 = substTyDeep(origRet, bN, bT)
          if sub2 >= 0 {
            if sub2 != origRet {
              // THE DEGENERATE-UNION FOLD IS UPSTREAM NOW, and this comment used to claim a union
              // EXCLUSION that no longer exists at this site — read the code, not this paragraph's
              // history. #1481 shipped a regression here: `substTyDeep` did not NORMALISE the
              // union it rebuilt while the annotation path did, so `T | string` at `T := string`
              // substituted to a two-member union of identical members while `nameToTy` collapsed
              // it to plain `string` — recording a union box on a binding whose instance returns a
              // bare ref. #1483 excluded unions here; #1485 fixed it at the ROOT (`substTyDeep`'s
              // union arm dedupes and collapses) and REMOVED the exclusion, leaving `tyHasTyVar`.
              //
              // THE CORPUS CANNOT GRADE THIS ONE: no corpus program has a generic whose return
              // union COLLAPSES under its binding, so a render-comparing dual run reads it as
              // cosmetic when for a union the recorded TYPE is what picks the box.
              if !tyHasTyVar(sub2) { retTy = sub2 }
            }
          }
        }
        // D1042 — A UNION THE PIN MINTS IS SPELLED, AND REGISTERED, THE WAY THE DIRECT
        // SPELLING IS. `rs` is `monoSubstAnn`'s render, which substitutes the type
        // parameter's BOUND NAME into the DECLARED annotation text — so `T | "err"` at
        // `T := i32` arrives here as `i32|"err"`, the literal member verbatim. Every
        // other producer of that union's key has been through `canonEmitTypeNames`,
        // which softens a literal member to its base scalar at `RC_ROOT`
        // (`canonEmitNameAt`'s `litMemberTy` arm), and so spells it `i32|string`. Two
        // spellings of ONE union is the whole of this row's second ingredient: adding a
        // direct `function f(bad: boolean): i32 | "err"` to the same module registered
        // `i32|string` and the clone still asked for `i32|"err"`.
        const rsC = monoPinUnionName(rs)
        nret = synthTypeRefTy(rsC, -1, retTy)
        // And REGISTER it: `collectU` — the only pass that mints union rows — runs
        // BEFORE `monomorphize`, so a union that exists only because a generic was
        // pinned has no row at all (`unionRowOf` is -1 for both spellings, this row's
        // first ingredient). Registering under the canon'd key REUSES the row a direct
        // spelling already minted rather than adding a second one: a union's box tags
        // are POSITIONAL over its member set, so two rows for one type is a value boxed
        // under one tag slice and read under the other.
        if monoRegisterPinUnion(rsC) < 0 { return -1 }
      }
    }
    // An UN-ANNOTATED return whose return expression is a value-call THROUGH a
    // closure-pinned param takes that signature's RESULT kind as a concrete
    // annotation (`"…>d"` → `f64`): the emitter's return-kind inference has no
    // expression form for a `call_ref` result, so the instance's functype and
    // its callers' classification ride the normal annotation tables instead.
    if nret < 0 {
      const rx2 = fnRetExprOf(monoOrigNode[origFe])
      if rx2 >= 0 {
        const rxe = P.nodes[rx2]
        if rxe is Call {
          const rcal = P.nodes[rxe.callFn]
          if rcal is Ident {
            let pq = 0
            while pq < params.length {
              const pp = P.nodes[params[pq]]
              if pp is Param {
                if pp.parName == rcal.identName {
                  const pn = pinned[pq]
                  // The bound is the PAREN arm's own (a `(…)`-opening function-type
                  // spelling is never two characters); the pin arm beside it no longer
                  // needs one, reading the column rather than the name's first two.
                  if pn.length > 2 {
                    if pinKinds[pq] == PIN_SIGKEY {
                      // An UN-annotated closure param's sig-key pin: only its f64 result kind
                      // has no expression-form return inference, so type it concretely here.
                      // The pin's PAYLOAD is a `$fnsig` key — it rides the column beside the
                      // kind, and its result decodes through the shared seam (`sigKeyRetKind`),
                      // not a raw token-char compare.
                      if sigKeyRetKind(pinPays[pq]) == "f64" {
                        nret = synthTypeRef("f64", -1)
                      }
                    } else if nameIsParenOpen(pn) {
                      // An ANNOTATED function-type param pin (`(i32)=>string|null`): the un-annotated
                      // HOF return flows THROUGH the callback (`return g(x)`), so it IS the callback's
                      // return type. Extract that (everything past the top-level `=>`) and pin the
                      // instance's return to it — so a UNION (`i32|string`) / NULLABLE (`string|null`)
                      // / string / i64 result lowers and the caller's `is` / `??` classifies it. The
                      // f64-only branch above missed every non-f64 result (the union case emitted
                      // INVALID WASM, the nullable case a clean `??` reject). A closure-RESULT
                      // (`(i32)=>((i32)=>i32)`) is left as `nret = -1` — closure-returning HOFs are a
                      // separate slice.
                      // `annRetNameOf` (`emit_base`, #1147) IS this arm's `annArrowAt` + slice pair,
                      // its `at < 1` bail the `arrowAt > 0` gate spelled the other way round. The
                      // peel is `normTypeAtom`, the paren-WRAP home riding `tyGroupWrapsWhole`.
                      const retName = normTypeAtom(annRetNameOf(pn))
                      // THE RETURN ROW COMES OFF THE PIN'S OWN TYPE, not from a second
                      // parse of the name this arm just cut out of `pn`. `pinTys[pq]` is
                      // the pinned param's arena row and it is a `TyFunc` at every reach,
                      // so `fnRet` IS the callback result this arm extracts textually above.
                      //
                      // The GATE is unchanged — `annRetNameOf` + `annArrowAt` still decide
                      // whether this arm fires and what the annotation is SPELLED as. Only
                      // the recorded row changes, so the closure-result partition this arm
                      // excludes stays exactly as it was, and the nominal names were already
                      // lost by the re-parse (`Cat|Dog` renders structurally on BOTH sides),
                      // so handing the row over is not a nominal regression — the spelling
                      // still rides on the node's own name. What goes away is a duplicate row.
                      let retTyIx = -1
                      if pinTys[pq] >= 0 {
                        const pft = T.tys[pinTys[pq]]
                        if pft is TyFunc { retTyIx = pft.fnRet }
                      }
                      if retName != "" && annArrowAt(retName) < 0 {
                        nret = synthTypeRefTy(retName, -1, retTyIx)
                      }
                    }
                  }
                }
              }
              pq = pq + 1
            }
          }
          // `return <param>.map/filter(<lambda>)` over a param this instance pinned to a
          // NON-i32 array: type the un-annotated return as the concrete result list. The
          // inferred-return path has no f64/string-array map/filter-result form, so set it
          // here — `.filter` preserves the element; `.map` preserves it for an element-wise
          // arithmetic/concat callback (`monoLambdaPreservesElem`). i32 keeps `nret = -1`,
          // its inference already handling it, so that path is untouched.
          if rcal is Member {
            if rcal.memProp == "map" || rcal.memProp == "filter" {
              if rxe.callArgs.length == 1 {
                const mrecv = P.nodes[rcal.memObj]
                if mrecv is Ident {
                  let pqm = 0
                  while pqm < params.length {
                    const ppm = P.nodes[params[pqm]]
                    if ppm is Param {
                      if ppm.parName == mrecv.identName {
                        // `listElemNameOf` (`emit_base`) adds ONE naive grouping-paren strip
                        // over the `nameIsArray` gate + trailing-`[]` cut this file used to
                        // spell privately — a `(…)`-wrapped element, which a pinned ELEMENT
                        // name cannot carry, is the only shape the two disagree on. Measured
                        // at both call sites: 362 corpus reaches, 0 disagreements, comparator
                        // firing on 362/362 under inversion.
                        const srcElem = listElemNameOf(pinned[pqm])
                        if srcElem != "" && srcElem != "i32" {
                          // BOTH ARMS PRODUCE THE RECEIVER'S OWN LIST TYPE — `.filter`
                          // preserves the element by definition, and the `.map` arm is
                          // gated on `monoLambdaPreservesElem`. So `srcElem + "[]"` is
                          // `pinned[pqm]` rebuilt: the spelling is CUT apart by
                          // `listElemNameOf` and then CONCATENATED back together, and the
                          // row for it was in `pinTys[pqm]` the whole time.
                          //
                          // The reconstruction is string-identical to the pin it came from
                          // and renders identically to it, while landing on a DIFFERENT
                          // arena row every time, because `nameToTy` does not hash-cons a
                          // composite spelling.
                          if rcal.memProp == "filter" {
                            nret = synthTypeRefTy(
                              srcElem + "[]",
                              -1,
                              pinTys[pqm],
                            )
                          } else if monoLambdaPreservesElem(rxe.callArgs[0]) {
                            nret = synthTypeRefTy(
                              srcElem + "[]",
                              -1,
                              pinTys[pqm],
                            )
                          }
                        }
                      }
                    }
                    pqm = pqm + 1
                  }
                }
              }
            }
          }
        }
        if rxe is Index {
          // `return param[i]` where the param pinned to an f64 array yields an f64
          // element — synthesize the concrete `f64` return (the un-annotated-return kind
          // inference has no f64 form for an indexed un-annotated array param). i32/string
          // returns keep `nret = -1`, their inference handling them, so those are untouched.
          const ria = P.nodes[rxe.idxArr]
          if ria is Ident {
            let pqi = 0
            while pqi < params.length {
              const ppi = P.nodes[params[pqi]]
              if ppi is Param {
                if ppi.parName == ria.identName {
                  // `nameIsF64Array` (`emit_base`) is the home; this site hand-wrote its
                  // body as a whole-spelling equality (`pinned[pqi] == "f64[]"`) 20 lines
                  // below a sibling that already asks the SAME question structurally
                  // (`listElemNameOf(pinned[pqm])` for the `.map`/`.filter` element). Both
                  // are projections of ONE value — the pinned array's ELEMENT name.
                  if nameIsF64Array(pinned[pqi]) {
                    nret = synthTypeRef("f64", -1)
                  }
                }
              }
              pqi = pqi + 1
            }
          }
        }
        if rxe is Ident {
          // `return <local>` where the local is a hole-built list (`const out = [];
          // out.push(self[i])`): the list shares the indexed param's array type, so type
          // the un-annotated return as that param's pinned type. This lowers a fully
          // un-annotated `reverse(self)` end-to-end (the un-annotated-return kind inference
          // can't see a mono instance's inferred list local). No source param found → keep
          // `nret = -1`, so a plain scalar/local return is untouched.
          const srcParam = monoListSrcParam(fn.fnBody, rxe.identName)
          if srcParam != "" {
            let pli = 0
            while pli < params.length {
              const ppl = P.nodes[params[pli]]
              if ppl is Param {
                if ppl.parName == srcParam {
                  if pinned[pli] != "" {
                    // THE ARGUMENT TYPE IS HANDED OVER instead of re-parsed out of the
                    // spelling. `synthTypeRef(name, -1)` reaches `recordClonedNodeTyKnown`,
                    // whose `-1` arm runs `nameToTy(name)`: it takes the printed type
                    // `i32[]` and parses a type back out of it. `pinTys` is this instance's
                    // ARGUMENT type column, checked parallel to `pinned` at the top of
                    // `monoMakeInstance` — so the type is already in hand on this line.
                    //
                    // The re-parse does not merely cost a parse, it MINTS A SECOND ARENA
                    // ROW, `nameToTy` not being hash-consed — and the arena row count is the
                    // only evidence available, since the emitted module is the same either
                    // way. `pinTys[pli]` of -1 falls through to exactly today's name
                    // resolution, so any site this column does not cover is unchanged.
                    nret = synthTypeRefTy(pinned[pli], -1, pinTys[pli])
                    monoOutName = rxe.identName
                    monoOutType = pinned[pli]
                    monoOutTypeIx = pinTys[pli]
                  }
                }
              }
              pli = pli + 1
            }
          } else {
            // The pass-through trace found no `out.push(param[idx])` source — the list is
            // built from a NON-TRIVIAL expression over the element (`out.push(self[i] * 2)`).
            // Re-check the body for THIS shape (params pinned concretely) so the checker's
            // own list-element inference resolves the local; that lifts the element-hole
            // ceiling generically (any pushed expression, not just a bare index). "" when it
            // is not an inferred list / stays generic → `nret` stays -1, path untouched.
            //
            // The inferrer hands the ARENA ROW back beside the render, so the annotation is
            // minted from the type it resolved rather than from a re-parse of that type's
            // printed form: `monoInferListElem` returns `tyToStructStr(lt)`, a PRINT of `lt`,
            // and `nameToTy` on that print landed on a NEW row every firing — a composite
            // spelling does not resolve back to the row it was printed from.
            const listTyIx: i32[] = []
            const listTy = monoInferListElem(
              monoOrigNode[origFe],
              pinnedTyIx,
              rxe.identName,
              listTyIx,
            )
            if listTy != "" {
              let ltIx = -1
              if listTyIx.length > 0 { ltIx = listTyIx[0] }
              nret = synthTypeRefTy(listTy, -1, ltIx)
              monoOutName = rxe.identName
              monoOutType = listTy
              monoOutTypeIx = ltIx
            } else {
              // Not an inferred LIST local — try a SCALAR one (`const t = self[i]; return t`,
              // or a `let acc = ""; acc = acc + self[i]; return acc` fold) whose type derives
              // from a hole-pinned param. The return-kind inference runs before locals are
              // collected and the typed-IR is stale for a hole-derived node, so type the
              // un-annotated return from a re-check with the params pinned concretely. "" for
              // i32 / boolean / non-scalar locals → `nret` stays -1, that path untouched.
              //
              // The inferrer hands the ARENA ROW back beside the name, so the annotation is
              // minted from the type it already resolved rather than from a re-parse of its
              // printed form. Here the round trip always landed back on the row it started
              // from — a bare primitive resolves to the canonical row — so unlike the array
              // spelling above this minted no duplicate; what goes away is the round trip.
              const scTyIx: i32[] = []
              const scTy = monoInferLocalScalar(
                monoOrigNode[origFe],
                pinnedTyIx,
                rxe.identName,
                scTyIx,
              )
              if scTy != "" {
                let scIx = -1
                if scTyIx.length > 0 { scIx = scTyIx[0] }
                nret = synthTypeRefTy(scTy, -1, scIx)
              }
            }
          }
        }
      }
    }
    // D592 — THE LADDER'S FALL-THROUGH, asked of the return EXPRESSION rather than of its
    // SHAPE. Every arm above matches one spelling: a `Call` through a pinned param, an
    // `Index` whose receiver is a param pinned to `f64[]`, an `Ident` naming a local. A
    // return the whitelist does not name keeps `nret = -1`, the instance's functype result
    // falls to `retAnnKindChain`'s `"i32"` seed, and a body returning a `(ref $string)` is
    // emitted under `(result i32)` — `vl check` rc 0, then a load-time type mismatch. D592's
    // witness is `const xs: T[] = [self]; return xs[0]`: ONE TOKEN, declaring `: T`, makes
    // the identical body run.
    //
    // LAST, so every arm above keeps its answer and this only sees returns nothing named.
    // `monoInferRetExprTy` re-checks the body with the params pinned and reads the return
    // expression's own resolved type, filtered to the reps the i32 default gets WRONG.
    if nret < 0 {
      const reTyIx: i32[] = []
      const reTy = monoInferRetExprTy(
        monoOrigNode[origFe],
        pinnedTyIx,
        letBN,
        letBT,
        fnRetExprOf(monoOrigNode[origFe]),
        reTyIx,
      )
      if reTy != "" {
        let reIx = -1
        if reTyIx.length > 0 { reIx = reTyIx[0] }
        // D592/R3 — A STRUCT RETURN IS ANNOTATED BY THE NAME OF AN INTERNED ROW, NEVER BY THE
        // SHAPE'S PRINTED SPELLING, and that one distinction IS the refusal this row recorded.
        // The naive struct arm minted `tyToStructStr`'s `{x: i32}`: `retTRFlag` reads the node's
        // recorded type and answers "struct", `retStructIndex` is then handed a name no shape
        // table claims, and `fbValtype` reports `emitProgram: ref valtype with no interned
        // shape`. `monoRetRowName` asks the emitter's own table which ROW this arena type is and
        // hands back that row's name — `V`, not `{x: i32}` — so consumers that read the
        // annotation TEXTUALLY resolve it too, not only those reading the arena sidecar.
        //
        // NO ROW, NO MINT. A shape the table does not claim is one the functype cannot name, and
        // `nret = -1` is the honest answer. Not a shape whitelist: it is the same question the
        // emitter is about to ask, asked before the annotation exists instead of after.
        let mintName = reTy
        let mint = true
        // BOUND-CHECKED rather than trusted: the arm above pushes its row whenever it names
        // a type, so `reIx < 0` is unreachable from a struct answer — and an unguarded
        // `T.tys[-1]` is a compiler TRAP, not a wrong answer, which is the failure mode this
        // file's `emitFail does not halt` discipline exists for. A -1 keeps exactly today's
        // route: `synthTypeRefTy` re-resolves the printed name.
        if reIx >= 0 {
          const rrt = T.tys[reIx]
          if rrt is TyObj {
            mintName = monoRetRowName(reIx)
            if mintName == "" { mint = false }
          }
        }
        // D970 — A MULTI-RETURN FUNCTION IS NOT DESCRIBED BY ONE RETURN EXPRESSION. `reTy`
        // comes from `fnRetExprOf(...)`, the return expression SINGULAR, so for
        // `function pick(b) { if b { return 1 }; "s" }` it names `string` — the tail — while
        // the function's actual result is the join `i32 | string`. Minting that pins the
        // instance's `fnRet` to one arm; `emitReturnValue` then takes its plain-emit arm while
        // the FUNCTYPE (computed independently by `criClassify`) says the union box, so the
        // returns go out UNBOXED under a box result: `vl check` rc 0, invalid wasm.
        //
        // THE SAME MISTAKE D626 NAMED, one rung over — an inferred return read off the return
        // EXPRESSION rather than the whole return SET. Declining is this site's own stated
        // fallback for "cannot name it" (`nret = -1`), and it leaves the instance to the
        // return-inference path that already handles a union result.
        if mint {
          if monoRetJoinDisagrees(monoOrigNode[origFe], reIx) { mint = false }
        }
        if mint { nret = synthTypeRefTy(mintName, -1, reIx) }
      }
    }
    // D1521 — A MULTI-RETURN INSTANCE IS NOT DESCRIBED BY ONE ARM, whichever arm the ladder
    // above named. `monoRetJoinDisagrees` says so and then hands the instance to "the
    // return-inference path that already handles a union result" — true only where that path
    // has a ROW, and for an un-annotated PARAMETER it never does: A20 calls the declaration
    // generic, so the functype takes one arm's rep while the other returns raw.
    //
    // OVERRIDES THE LADDER RATHER THAN FILLING ITS `-1`: the shape whitelist reaches its own
    // answer for an `f64`/`string` arm and that answer is still one arm. The set IS nameable
    // here because the parameters are bound; a still-holey arm declines the whole set, which
    // keeps D970's deferred-join family on its old path. `monoRegisterPinUnion` makes the
    // minted name resolvable — `collectU` ran before this pass and nothing re-runs it.
    if fn.fnRet < 0 {
      const jTy: i32[] = []
      const jun = monoInferRetSetUnionName(
        monoOrigNode[origFe],
        pinnedTyIx,
        letBN,
        letBT,
        jTy,
      )
      if jun != "" {
        if monoRegisterPinUnion(jun) < 0 { return -1 }
        let jIx = -1
        if jTy.length > 0 { jIx = jTy[0] }
        nret = synthTypeRefTy(jun, -1, jIx)
      }
    }
    let instName = fn.fnName
    let instFe = origFe
    if count > 0 { instName = fn.fnName + "$" + i32ToStr(count) }
    const noTyParams: string[] = []
    // Substitute type-param annotations in the body's `LetDecl`s for this instance (a
    // `const out: T[]` becomes `const out: f64[]`); shares the body wholesale when it has
    // no such annotation.
    const instBody0 = monoCloneBody(
      fn.fnBody,
      fn.fnTyParams,
      tvN,
      tvV,
      monoOutName,
      monoOutType,
      monoOutTypeIx,
      letBN,
      letBT,
    )
    // D426 — substitute a BOUND lambda's own annotations at this pin, and mint the lambda per
    // instance. `monoCloneBody` above rebuilds the statement spine and shares every leaf
    // expression including a nested lambda; that sharing is exactly right for a concrete
    // lambda and exactly wrong for one whose parameters are written at `T`, since `collectFns`
    // has already lifted it and the one lifted function then served every instance at the
    // unsubstituted type. Copy-on-write: a body with no such lambda is the same node index.
    monoLamMintedSlots = []
    monoInstIsFirst = count == 0
    const instBody0L = monoPinBodyLambdas(
      instBody0,
      fn.fnTyParams,
      tvN,
      tvV,
      letBN,
      letBT,
    )
    // Pin any `.map`/`.filter` callback lambda whose receiver param this instance bound to a
    // NON-i32 element (`self: f64[]` ⇒ the `(x) => …` callback's `x` is f64): the shared
    // body's un-annotated lambda would otherwise emit as i32. Build the param→element map
    // from the pinned param names, then clone+pin per instance; i32 shapes are left as-is,
    // so that path is untouched.
    const pElemNames: string[] = []
    const pElemTypes: string[] = []
    // The ELEMENT ROW column, parallel to `pElemTypes`. `listElemNameOf` cuts the
    // element out of the pin's SPELLING; this reads it off the pin's TYPE, so the
    // callback's pinned annotation can be minted from a row instead of a re-parse.
    // -1 wherever the pin is not a recorded array, which degrades to today's path.
    const pElemTys: i32[] = []
    let pe = 0
    while pe < params.length {
      const pep = P.nodes[params[pe]]
      if pep is Param {
        pElemNames.push(pep.parName)
      } else {
        pElemNames.push("")
      }
      pElemTypes.push(listElemNameOf(pinned[pe]))
      let peTy = -1
      if pinTys[pe] >= 0 {
        const pet = T.tys[pinTys[pe]]
        if pet is TyArray { peTy = pet.aElem }
      }
      pElemTys.push(peTy)
      pe = pe + 1
    }
    const instBody1 = monoPinMapLambdas(
      instBody0L,
      pElemNames,
      pElemTypes,
      pElemTys,
    )
    // Bake any non-capturing concrete callback into a DIRECT call (`pElemNames` already holds the
    // per-position param NAMES, parallel to `cbFnNames`). No baked callback → no rewrite → the body
    // is the same node `monoPinMapLambdas` produced, exactly as before specialization existed.
    let instBody2 = instBody1
    if monoAnyBakedCallback(cbFnNames) {
      instBody2 = monoBakeCallback(instBody1, pElemNames, cbFnNames)
    }
    // Per-instance copies of the direct generic calls this body makes, so instantiating THEM
    // rewrites only this instance's callee `Ident`s (a shared one made the last shape win for
    // every instance — see `monoCloneGenericCalls`). No generic call → the same node → no change.
    const instBody3 = monoCloneGenericCalls(instBody2)
    // Per-instance layout constants for the type parameters this body reads
    // (`i * T.size`) — folded HERE because the binding is what makes them exist.
    const instBody4 = monoFoldTyParamLayout(instBody3, fn.fnTyParams, tvN, tvV)
    // The two questions `dispatchRewrite` had to ask of a HOLE, re-asked at the PIN
    // (D511/D512). Last in the chain, so it sees the body every rung above produced;
    // copy-on-write, so a body with no such operator is the same node index.
    const instBody = monoPinBinOps(instBody4, pElemNames, pinnedTyIx)
    const nfn = mkFunc(instName, noTyParams, nps, nret, instBody, -1)
    // D926 — the return-row twin of the param mark above. `monoOrigNode[origFe]` is the
    // template's own `FuncDecl`, which is what `anonLeafMarkRetMoved` marked.
    anonLeafCarryRetMark(monoOrigNode[origFe], nfn)
    if count == 0 {
      // First instance: keep the bare name and the original's wasm index.
      fnStmts[origFe] = nfn
    } else {
      // D971 — A CAPTURING LAMBDA AT A SECOND TYPE NEEDED NOTHING BUT THIS REFUSAL REMOVED. It
      // read: "the binding holds ONE closure whose funcref is the first-type instance, so a
      // second-type call can be neither a `call_ref` through it (wrong functype) nor a by-name
      // call (drops the env)". The `call_ref` half is right; the by-name half is FALSE, since a
      // lifted capturing instance takes its env as a LEADING `structref` param `emitDirectCall`
      // already pushes. THE ARM THE SIBLING LADDER HAS AND THIS ONE LACKED (#1827, #1821's shape
      // one rung over): the rename folds a call into a by-name call to the APPENDED instance of
      // the binding's INITIALIZER, faithful only while the binding still holds it, so every call
      // at a SECOND shape answered the FIRST lambda — a silent WRONG ANSWER. A REJECT and not a
      // `keepCallRef`: one closure cell carries ONE functype, so there is nothing to keep calling.
      // The `!= fn.fnName` test is in front because a function's OWN name is never an assignment
      // target, so a plain second-type call keeps its rename and the two answers must agree.
      const cal3 = P.nodes[calleeIx]
      if cal3 is Ident {
        if cal3.identName != fn.fnName && monoNameIsAssigned(cal3.identName) {
          return emitFail(
            "emitProgram: the reassigned function binding `" +
              cal3.identName +
              "` is called at more than one argument type — one binding holds one closure " +
              "signature, and the values written to it want two. Annotate the parameters, or " +
              "bind a separate value per type",
          )
        }
      }
      fnStmts.push(nfn)
      fnParent.push(-1)
      fnDispNames.push("")
      instFe = fnStmts.length - 1
      // D943 — the clones' frame is THIS instance, not the template. `captureValKind` types
      // an env field by resolving the capture in its enclosing frame, so until this runs the
      // clone reads `value: T` and every instance mints the same env layout.
      let mls = 0
      while mls < monoLamMintedSlots.length {
        const msl = monoLamMintedSlots[mls]
        if msl >= 0 && msl < fnParent.length { fnParent[msl] = instFe }
        mls = mls + 1
      }
      monoLamMintedSlots = []
      const cal2 = P.nodes[calleeIx]
      // R4 writer 6 of 8 (`compiler/symbols.vl`; census in `perf-program.md`).
      if cal2 is Ident {
        cal2.identName = instName
        sidNoteNodeName(calleeIx)
      }
    }
    // REGISTER before walking the body, so a recursive self-call at the same
    // shape resolves here instead of recursing (the host's discipline).
    monoKeys.push(key)
    monoInstOrig.push(origFe)
    monoInstName.push(instName)
    monoInstFe.push(instFe)
    if monoRebuild() < 0 { return -1 }
    // Walk THIS INSTANCE's body — a nested generic call instantiates its own callee against this
    // instance's concrete annotations, and the callee rename lands on the instance's own `Call`
    // spine (`monoCloneGenericCalls`) rather than on nodes its siblings share.
    if monoWalkFnBody(nfn) < 0 { return -1 }
    if monoRebuild() < 0 { return -1 }
    return 0
  }
  0
}

// The param type NAMES of a function-type NAME (`(f64, f64) => f64` → ["f64", "f64"]), appended to
// `out`. Mirrors `paramCloSigKey`'s parse of the canonical `(params) => ret` name. false when `name`
// is not a function type or is malformed.
//
// A thin reading of `emit_base.annFnDecompose` — the home for the `annArrowAt >= 1` +
// `ann[0] == '('` + `ann[fa - 1] == ')'` triple, the `slice(1, fa - 1)` param cut and the
// `inner.length > 0` split guard (including the empty-param guard whose reason is recorded
// there). The one axis where the two readings differ is the ANSWER: the home returns the RETURN
// name and so conflates "not a function type" with "a function type whose return name is EMPTY",
// where the hand-written copy answered `true` for the latter. That conflation is the home's stated
// contract and what its other three callers already read; a lockstep probe over the corpus and the
// fuzz corpus found the two readings apart nowhere, with an inverted control proving it wired.
function monoFnTypeAnnParamsName(name: string, out: string[]) {
  annFnDecompose(name, out) != ""
}

// Materialize (or reuse) the instance of generic `origFe` for an ANNOTATED function-typed binding
// (`const c: (f64, f64) => f64 = add`): pin each parameter to the annotation's param type NAME and
// create the instance (annotating an i32 param too, so the binding's closure value passes the
// value floor), pointing the binding init `letInitIx` at it. Unlike the call-driven
// `monoInstantiate` this carries the value its concrete type INDEPENDENT of any call, so a binding
// that ESCAPES is `call_ref`'d at the type its annotation pinned. Returns 0, or -1 via `emitFail`.
//
// Every parameter is read, in one of three ways, and the reading is what keeps the path sound: an
// UN-ANNOTATED hole is filled from the boundary; a TYPE PARAMETER (`x: T`, `xs: T[]`) is BOUND by
// it (`monoBindFromAnn`), which also substitutes the return; a CONCRETE annotation must AGREE with
// the boundary's name or this declines. The old all-un-annotated gate made a PARTLY annotated
// function worse as a value than an un-annotated one, and left `f<T>(x: T)` under no floor at all.
function monoInstanceFor(origFe: i32, pinnedNames: string[], letInitIx: i32) {
  const fn = P.nodes[monoOrigNode[origFe]]
  if fn is FuncDecl {
    const params = fn.fnParams
    if params.length != pinnedNames.length { return 0 }
    const tvN: string[] = []
    const tvV: string[] = []
    let i = 0
    while i < params.length {
      const p = P.nodes[params[i]]
      if p is Param {
        if p.parType >= 0 {
          // The declared spelling, so a parameter whose annotation names a type PARAMETER is read
          // as that parameter rather than as whatever an alias of the same name canon'd to —
          // `monoInstantiate`'s rule, for the same reason.
          const ann = monoDeclAnnName(
            p.parType,
            tyNameOf(p.parType),
            fn.fnTyParams,
          )
          if monoAnnHasTyParam(ann, fn.fnTyParams) {
            monoBindFromAnn(ann, pinnedNames[i], fn.fnTyParams, tvN, tvV)
          } else if normTypeAtom(ann) != normTypeAtom(pinnedNames[i]) {
            return 0
          }
        }
      }
      i = i + 1
    }
    // POST-CONDITION on the bindings, and it needs its own pass because `monoBindFromAnn` is
    // FIRST-USE-WINS: substituting them back through every type-param-riding annotation must
    // REPRODUCE the boundary. `pairT<T>(a: T, b: T)` reaching `(i32, string) => i32` binds T to
    // i32 from `a` and then silently disagrees at `b`; without this it materialized an instance
    // the second position contradicts. Declining hands it to the value floor, which is a
    // diagnostic rather than a value emitted at a shape half the boundary denies.
    let v = 0
    while v < params.length {
      const pv = P.nodes[params[v]]
      if pv is Param {
        if pv.parType >= 0 {
          const annV = monoDeclAnnName(
            pv.parType,
            tyNameOf(pv.parType),
            fn.fnTyParams,
          )
          if monoAnnHasTyParam(annV, fn.fnTyParams) {
            const sub = monoSubstAnn(annV, fn.fnTyParams, tvN, tvV)
            if sub == "" { return 0 }
            if normTypeAtom(sub) != normTypeAtom(pinnedNames[v]) { return 0 }
          }
        }
      }
      v = v + 1
    }
    const pinned: string[] = []
    // No argument node on this path (an annotation-driven binding), so nothing is known —
    // an all -1 column is exactly today's behaviour.
    const pinTys: i32[] = []
    let j = 0
    while j < pinnedNames.length {
      pinned.push(pinnedNames[j])
      pinTys.push(-1)
      j = j + 1
    }
    // The annotation-driven binding path (`const c: (f64,f64)=>f64 = add`) bakes no callback — the
    // value escapes its call sites, so its body keeps the `call_ref`. Empty → no key/body change.
    const noCb: string[] = []
    const pinKinds: i32[] = []
    const pinPays: string[] = []
    monoBuildPinCol(pinned, pinKinds, pinPays)
    return monoMakeInstance(
      origFe,
      pinned,
      pinKinds,
      pinPays,
      pinTys,
      tvN,
      tvV,
      letInitIx,
      true,
      noCb,
    )
  }
  0
}

// The field NAMES and field TYPE-NAMES of the struct type `tname` names, appended in parallel to
// `outNames` / `outTexts`; false when `tname` names no struct at all.
//
// TWO spellings reach here and they resolve differently. A DECLARED alias (`type Box = {…}`) is
// read off the `TypeDecl`'s own `FieldDef` nodes, so each field's type arrives as an arena
// `TypeRef` that `tyNameOf` names exactly as the annotation spelled it — no round-trip through
// the type-name grammar. An INLINE shape (`const b: {op: (i32,i32)=>i32} = …`) has no declaration
// to read and falls back to the shape layer's own field scanner (`annObjFieldSplit`, which is
// depth-aware over the generic-application brackets a field type can carry).
function monoStructFieldTypes(
  tname: string,
  outNames: string[],
  outTexts: string[],
) {
  if tname == "" { return false }
  let i = 0
  while i < monoProgStmts.length {
    const s = P.nodes[monoProgStmts[i]]
    if s is TypeDecl {
      if s.tdName == tname {
        const fs = s.tdFields
        let j = 0
        while j < fs.length {
          const fd = P.nodes[fs[j]]
          if fd is FieldDef {
            outNames.push(fd.fdName)
            outTexts.push(tyNameOf(fd.fdType))
          }
          j = j + 1
        }
        return true
      }
    }
    i = i + 1
  }
  annObjFieldSplit(tname, outNames, outTexts) == 1
}

// The `fnStmts` slot of the function an `Ident` NAMES — the ONE resolver every question this pass
// asks about a named function goes through, whichever spelling declared it. `identIx` is the
// `Ident` node (read for its sid), `name` its text, `ctx` the enclosing function node (-1 = top
// level). Two halves, both load-bearing:
//   * `fnIndexOfInScope` — the language's innermost-scope rule for a name a `FuncDecl` CARRIES;
//     the flat `fnIndexOf` returns the FIRST slot with that name, resolving a nested homonym to
//     the wrong frame (#1265) while `wasmEmit` lowers the same reference through the chain.
//   * `identClosureFeSid` — an arrow lambda parses to a NAMELESS `FuncDecl`, so a `const`/`let`
//     holding one carries the name on the BINDING and has no entry in the name map at all.
// Without the second half a receiver spelled `const hof = (g: (i32,i32) => i32, …) => …` presents
// no parameter list, the declared callback type never reaches `monoCoerceFnValue`, and the value
// floor refuses the very function value the `function hof(…)` spelling takes.
function monoFnFeOfIdent(identIx: i32, name: string, ctx: i32) {
  const fe = fnIndexOfInScope(name, ctx)
  if fe >= 0 { return fe }
  identClosureFeSid(sidOfNode(identIx), ctx)
}

// Coerce a generic function VALUE (or a composite of them) flowing into the expected type NAMED by
// `tname`. If `exprIx` is an `Ident` naming a generic (un-annotated-param) function and `tname` is a
// CONCRETE function type, materialize the instance for its param types and point the `Ident` at it
// (`monoInstanceFor`). If `exprIx` is an ARRAY LITERAL and `tname` is a closure-array type
// (`((i32,i32)=>i32)[]`), recurse into each element against the element function type; if it is an
// OBJECT LITERAL and `tname` names a declared struct, recurse into each field value against that
// field's declared type. The single coercion shared by every typed boundary a generic function value
// reaches — an annotated binding, a concrete function-typed call ARGUMENT, an annotated RETURN, an
// ARRAY element, a struct FIELD — so the value carries its concrete type wherever it escapes. The
// checker (`genericFnAssignable`) has already proved the instantiation valid; this only emits it.
function monoCoerceFnValueName(exprIx: i32, tname: string, ctx: i32) {
  if exprIx < 0 { return 0 }
  const e = P.nodes[exprIx]
  if e is ObjLit {
    // A function-valued struct FIELD (`type Box = {op: (i32,i32)=>i32}`, `const b: Box = {op: add}`).
    // The composite arms are mutually recursive with the `Ident` arm below, so a generic function
    // nested any depth down a literal (a field holding an array of them, an array of literals)
    // materializes at the type its own slot declares.
    const fnames: string[] = []
    const ftexts: string[] = []
    if monoStructFieldTypes(tname, fnames, ftexts) {
      const flds = e.objFields
      let k = 0
      while k < flds.length {
        const f = P.nodes[flds[k]]
        if f is FieldInit {
          let d = 0
          while d < fnames.length {
            if fnames[d] == f.fiName {
              if (
                monoCoerceFnValueName(f.fiValue, normTypeAtom(ftexts[d]), ctx) <
                0
              ) {
                return -1
              }
            }
            d = d + 1
          }
        }
        k = k + 1
      }
    }
    return 0
  }
  if e is ArrayLit {
    if nameIsClosureArray(tname) {
      // The `[]` cut stays RAW here (not `listElemNameOf`): that home strips one
      // NAIVE paren layer, which would mangle a non-wrapped function-type element
      // (`(i32)=>(i32)` → `i32)=>(i32`), while `normTypeAtom`'s balanced walk
      // declines it. The peel question and the cut question are separate — and the
      // RAW cut now HAS a home (`emit_base.arrElemNameRaw`, #1175, exported for
      // exactly this caller, which is named in its header). This comment asked for it;
      // it exists, so the hand-written cut goes. `nameIsClosureArray` implies
      // `nameIsArray`, so the home's "" decline is unreachable here.
      const elemName = normTypeAtom(arrElemNameRaw(tname))
      const es = e.arrElems
      let k = 0
      while k < es.length {
        if monoCoerceFnValueName(es[k], elemName, ctx) < 0 { return -1 }
        k = k + 1
      }
    }
    return 0
  }
  if e is Paren { return monoCoerceFnValueName(e.parInner, tname, ctx) }
  if e is IfStmt {
    // An if-EXPRESSION in value position (`const f: (i32,i32)=>i32 = if c { add } else { mul }`).
    // The expected type reaches EVERY arm unchanged — each arm independently produces the whole
    // value — so the recursion is per-arm, not per-element as it is for the composite literals.
    // A `match` in value position needs no limb of its own: the checker lowers an exhaustive
    // `match` to an if/else chain IN PLACE, so by emit time its arms are these arms.
    if monoCoerceFnValueName(e.ifThen, tname, ctx) < 0 { return -1 }
    return monoCoerceFnValueName(e.ifElse, tname, ctx)
  }
  if e is Block {
    // An arm's VALUE is its LAST statement, so that is the only position the expected type reaches.
    const bs = e.blkStmts
    if bs.length == 0 { return 0 }
    return monoCoerceFnValueName(bs[bs.length - 1], tname, ctx)
  }
  if e is Ident {
    // A bare function NAME, or a VALUE BINDING holding a generic function (`const add = (a,b) =>
    // a + b`, or `const g = named`) — resolve the binding to its lifted slot so an escaping lambda
    // binding materializes at the boundary type too, not just a by-name generic function.
    const gfe = monoFnFeOfIdent(exprIx, e.identName, ctx)
    if gfe >= 0 && gfe < monoGen.length {
      if monoGen[gfe] == 1 {
        const pnames: string[] = []
        if monoFnTypeAnnParamsName(tname, pnames) {
          return monoInstanceFor(gfe, pnames, exprIx)
        }
      }
    }
  }
  0
}

// Is `name` ever the TARGET of an assignment (`name = …`) anywhere in the arena? An arena scan
// rather than a scope walk, so it is coarse by NAME: a homonym in another frame answers true for
// both. That direction is the safe one — it declines a callee fold and leaves the `call_ref` the
// annotation already guarantees a signature for, where the opposite error silently drops a write.
function monoNameIsAssigned(name: string) {
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is BinExpr {
      if nd.binOp == "=" {
        const tg = P.nodes[nd.binLeft]
        if tg is Ident {
          if tg.identName == name { return true }
        }
      }
    }
    i = i + 1
  }
  false
}

// `monoCoerceFnValueName` keyed on an expected TYPE-annotation node (`-1` / a non-function type is a
// no-op). `ctx` is the enclosing function (-1 = top level), for resolving a value binding.
function monoCoerceFnValue(exprIx: i32, expectedTyIx: i32, ctx: i32) {
  if expectedTyIx < 0 { return 0 }
  return monoCoerceFnValueName(exprIx, tyNameOf(expectedTyIx), ctx)
}

// The written type-annotation node of parameter `i` of the function occupying `fnStmts` slot `fe`
// (its ORIGINAL declaration, before monomorphization may replace the slot), or -1. Lets a call site
// read the concrete function type a callback parameter declares, to coerce a generic function
// argument. Callers resolve `fe` through `monoFnFeOfIdent`, so the answer is the same for every
// spelling of the declaring function.
//
// `monoOrigNode` is captured in the PRE-pass and is only as long as the declaration count, while
// the name map `monoRebuild` refreshes DOES carry the appended instance slots (`at$1`). A name
// resolving past `monoOrigNode`'s end read out of bounds, trapping the whole compiler with no
// diagnostic — the crash `monoWalk` reaches whenever it revisits a `Call` whose callee an earlier
// walk already renamed. An appended slot has no separate "original": its declaration IS
// `fnStmts[fe]`, and its params carry the PINNED annotations, the concrete type this is for.
function monoFnParamTypeAt(fe: i32, i: i32) {
  const declIx = monoFnDeclNodeAt(fe)
  if declIx < 0 { return -1 }
  const fn = P.nodes[declIx]
  if fn is FuncDecl {
    const ps = fn.fnParams
    if i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param { return p.parType }
    }
  }
  -1
}

// The DECLARATION node whose parameter annotations `monoFnParamTypeAt` reads — the captured
// ORIGINAL for a template slot, the slot itself for an APPENDED instance (which has no
// separate original and carries the pinned annotations). Split out of that function so a
// caller can ask about the declaration's TYPE PARAMETERS through the same resolution rather
// than re-deriving it, and so the `monoOrigNode`-length bound its header describes is stated
// once. -1 for a slot outside `fnStmts`.
function monoFnDeclNodeAt(fe: i32) {
  if fe < 0 { return -1 }
  if fe >= fnStmts.length { return -1 }
  if fe < monoOrigNode.length { return monoOrigNode[fe] }
  fnStmts[fe]
}

// Does parameter `i` of the declaration at `fe` carry an annotation that mentions that
// declaration's OWN type parameters — `g: (U, U) => R` on `hof<U, R>`, or a plain `a: U`?
//
// THE QUESTION `monoWalk`'S COERCION LOOP HAD TO ASK AND DID NOT (`silent-class-inventory` D58).
// That loop hands the receiver's DECLARED parameter type to `monoCoerceFnValue` so a generic
// function argument materializes at it — sound when the declaration is CONCRETE
// (`apply(f: (i32,i32)=>i32)`), and nonsense when it is not: `monoFnTypeAnnParamsName` split
// `(U, U) => R` into the pin names `["U", "U"]` and `monoInstanceFor` minted an instance of the
// argument whose parameters are spelled `U` — a type VARIABLE of a different function, which no
// valtype ladder can lower, at EVERY instantiation. A receiver with no type parameters answers
// false here, so every concrete call keeps its coercion untouched.
function monoFnParamAnnRidesTyParam(fe: i32, i: i32) {
  const pty = monoFnParamTypeAt(fe, i)
  if pty < 0 { return false }
  const declIx = monoFnDeclNodeAt(fe)
  if declIx < 0 { return false }
  const fn = P.nodes[declIx]
  if fn is FuncDecl {
    if fn.fnTyParams.length == 0 { return false }
    const ann = monoDeclAnnName(pty, tyNameOf(pty), fn.fnTyParams)
    return monoAnnHasTyParam(ann, fn.fnTyParams)
  }
  false
}

// Does this call hand a GENERIC function VALUE to a parameter whose annotation is an ARROW
// riding the callee's own type parameters (`hof(opT, a, b)` into `hof<U, R>(g: (U,U)=>R, …)`)?
// The trigger for the pre-binding pass in `monoInstantiate`, and it is asked so that pass
// changes NOTHING anywhere else: the two binding orders can only disagree when one parameter
// says `U = T` (a type variable read off a generic argument's own declaration) and another
// says `U = i32`, and the generic argument is the only way the first answer exists.
function monoCallGenFnToTyParamArrow(
  params: i32[],
  args: i32[],
  typarams: string[],
  ctx: i32,
) {
  if typarams.length == 0 { return false }
  let i = 0
  while i < args.length && i < params.length {
    const p = P.nodes[params[i]]
    if p is Param {
      if p.parType >= 0 {
        const ann = monoDeclAnnName(p.parType, tyNameOf(p.parType), typarams)
        if annArrowAt(ann) >= 1 && monoAnnHasTyParam(ann, typarams) {
          const ax = unwrapParen(args[i])
          const av = P.nodes[ax]
          if av is Ident {
            const gfe = monoFnFeOfIdent(ax, av.identName, ctx)
            if gfe >= 0 && gfe < monoGen.length {
              if monoGen[gfe] == 1 { return true }
            }
          }
        }
      }
    }
    i = i + 1
  }
  false
}

// Instantiate (or reuse) the instance of generic `origFe` for the call at
// `callIx` (whose enclosing function is `ctx`, -1 = top level), and point the
// call site at it. Returns 0, or -1 via `emitFail`.
function monoInstantiate(origFe: i32, callIx: i32, ctx: i32) {
  const c = P.nodes[callIx]
  const fn = P.nodes[monoOrigNode[origFe]]
  if c is Call {
    if fn is FuncDecl {
      const args = c.callArgs
      const params = fn.fnParams
      if args.length != params.length {
        return emitFail(
          "emitProgram: monomorphize: wrong number of arguments calling `" +
            fn.fnName +
            "`",
        )
      }
      // Pin each parameter: an un-annotated param takes its argument's type
      // name; a type-param-riding annotation binds the type param (first use
      // wins, later uses take the binding); a concrete annotation is kept.
      const tvN: string[] = []
      const tvV: string[] = []
      const pinned: string[] = []
      // The ARENA TYPE each pinned param denotes, parallel to `pinned` — a per-parameter
      // FACT beside the parameters, the same shape `pinKinds` / `cbFnNames` take. Sourced
      // from the ARGUMENT's recorded type, and consumed only as a FALLBACK where the pinned
      // NAME does not resolve (`recordClonedNodeTyFb`). -1 = nothing known.
      const pinTys: i32[] = []
      // PRE-BIND FROM THE VALUE ARGUMENTS, and only when a generic function VALUE is on its
      // way into an arrow parameter that rides these type parameters (`silent-class-inventory`
      // D58). The main loop binds a type parameter at its FIRST use in declaration order, and
      // `hof<U, R>(g: (U, U) => R, a: U, b: U)` uses `U` first at `g` — where the only thing to
      // read it off is the ARGUMENT's own function type, which for a generic argument is that
      // argument's declaration verbatim. So `U` bound to `T`, the instance emitted `a: T`, and
      // the parameter ladder refused a type variable at every instantiation.
      //
      // GATED, AND THE GATE IS WHAT KEEPS THE ORDER CHANGE INERT. Where the argument is a
      // concrete function the two orders agree — the checker has already proved the call
      // well-typed — so they can only differ when one of them is a type VARIABLE, which is
      // exactly what `monoCallGenFnToTyParamArrow` looks for.
      if monoCallGenFnToTyParamArrow(params, args, fn.fnTyParams, ctx) {
        let pb = 0
        while pb < args.length {
          const pbp = P.nodes[params[pb]]
          if pbp is Param {
            if pbp.parType >= 0 {
              const pbAnn = monoDeclAnnName(
                pbp.parType,
                tyNameOf(pbp.parType),
                fn.fnTyParams,
              )
              // The ARROW parameters are the ones whose binding is in question; every other
              // annotation reads its type off the argument the call actually passes.
              if annArrowAt(pbAnn) < 1 {
                if monoAnnHasTyParam(pbAnn, fn.fnTyParams) {
                  const pbConc = monoArgPinName(args[pb], ctx)
                  if pbConc != "" {
                    monoBindFromAnn(pbAnn, pbConc, fn.fnTyParams, tvN, tvV)
                  }
                }
              }
            }
          }
          pb = pb + 1
        }
      }
      let i = 0
      while i < args.length {
        const p = P.nodes[params[i]]
        if p is Param {
          if p.parType < 0 {
            // A parameter the CHECKER already decided is not a hole, so the instance pins
            // the PARAMETER's own type rather than re-deriving one from the argument.
            // `recordedParamPinName` is that one answer, shared with `synthParamAnnots`
            // (which runs after this pass and would otherwise mint a different name from
            // the same recorded type). "" is the faithful "still an open hole", which keeps
            // the argument-derived pin — and with it every byte of today's generic path.
            let an = recordedParamPinName(params[i])
            if an == "" { an = monoArgPinName(args[i], ctx) }
            if an == "" {
              return emitFail(
                "emitProgram: monomorphize: unsupported argument type for `" +
                  p.parName +
                  "` in a call to `" +
                  fn.fnName +
                  "`",
              )
            }
            pinned.push(an)
            pinTys.push(monoArgPinTyIx(args[i], ctx))
          } else {
            // The DECLARED spelling where the annotation IS a type parameter
            // (`monoDeclAnnName`), the arena's canon'd one everywhere else. Without it a
            // parameter whose name shadows a type CANON REWRITES — `type Id = i32` +
            // `function ident<Id>(v: Id)` — arrived here already resolved to `i32`, matched
            // no type parameter, and pinned the ALIAS's body type while the call passed
            // something else.
            const ann = monoDeclAnnName(
              p.parType,
              tyNameOf(p.parType),
              fn.fnTyParams,
            )
            const tp = monoTyParamOf(ann, fn.fnTyParams)
            if tp == "" {
              // A COMPOSITE annotation riding type params (`Box<T>` — a
              // generic-alias application argument): bind them by matching the
              // pattern against the argument's concrete type name, then pin
              // the substituted annotation. A fully concrete annotation pins
              // unchanged.
              if monoAnnHasTyParam(ann, fn.fnTyParams) {
                // A FUNCTION-TYPE param (`f: (A, T) => A`) binds from the closure
                // argument's function-type NAME (`(i32, i32) => i32`); any other
                // composite (`Box<T>`, `{a:T}`) from its concrete value-type name.
                let anC = ""
                if annArrowAt(ann) >= 1 {
                  anC = monoArgFnTypeName(args[i], ctx)
                } else {
                  anC = monoArgPinName(args[i], ctx)
                }
                if anC == "" {
                  return emitFail(
                    "emitProgram: monomorphize: unsupported argument type for `" +
                      p.parName +
                      "` in a call to `" +
                      fn.fnName +
                      "`",
                  )
                }
                monoBindFromAnn(ann, anC, fn.fnTyParams, tvN, tvV)
                const pinC = monoSubstAnn(ann, fn.fnTyParams, tvN, tvV)
                if pinC == "" {
                  return emitFail(
                    "emitProgram: monomorphize: unsupported argument type for `" +
                      p.parName +
                      "` in a call to `" +
                      fn.fnName +
                      "`",
                  )
                }
                // THE COERCION `monoWalk` DEFERRED. Its loop skips a parameter whose
                // annotation rides these type parameters, because at that point the pin
                // names would be the type variables themselves; `pinC` is the SUBSTITUTED
                // spelling, which is the concrete function type that parameter actually
                // takes, so the generic argument materializes at it here instead. A
                // non-generic argument is a no-op (`monoCoerceFnValueName`'s `monoGen`
                // gate), so this is inert on everything but D58's shape.
                if annArrowAt(ann) >= 1 {
                  if monoCoerceFnValueName(args[i], pinC, ctx) < 0 { return -1 }
                }
                pinned.push(pinC)
                pinTys.push(monoArgPinTyIx(args[i], ctx))
              } else {
                pinned.push(ann)
                pinTys.push(monoArgPinTyIx(args[i], ctx))
              }
            } else {
              const an2 = monoArgPinName(args[i], ctx)
              if an2 == "" {
                return emitFail(
                  "emitProgram: monomorphize: unsupported argument type for `" +
                    p.parName +
                    "` in a call to `" +
                    fn.fnName +
                    "`",
                )
              }
              let bind = an2
              if ann != tp {
                // `T[]` param: the argument must be an array; its element binds T.
                // The ARRAY grammar's TEST and CUT, both at their home in `tyname.vl`.
                // `nameIsArray` carries the `length >= 2` bound AND the `']'` half of
                // the two-character suffix, so the array question is asked whole here
                // rather than as a leading-bracket compare that a name ending `[` alone
                // would satisfy; `arrElemNameRaw` is the paired cut (`name` minus those
                // two characters), RAW because a composite element's grouping parens
                // are part of the binding — `listElemNameOf` would strip a layer T must
                // keep.
                if !nameIsArray(an2) {
                  return emitFail(
                    "emitProgram: monomorphize: expected an array argument for `" +
                      p.parName +
                      "` in a call to `" +
                      fn.fnName +
                      "`",
                  )
                }
                bind = arrElemNameRaw(an2)
              }
              const b = monoBindOf(tvN, tvV, tp)
              if b == "" {
                tvN.push(tp)
                tvV.push(bind)
              } else {
                bind = b
              }
              if ann != tp {
                pinned.push(bind + "[]")
                pinTys.push(monoArgPinTyIx(args[i], ctx))
              } else {
                pinned.push(bind)
                pinTys.push(monoArgPinTyIx(args[i], ctx))
              }
            }
          }
        }
        i = i + 1
      }
      // CALLBACK SPECIALIZATION: for each closure-valued argument that is a KNOWN, NON-CAPTURING,
      // NON-GENERIC function (a top-level name `add`, or an in-place lifted lambda literal), record
      // the function's name so this instance bakes a direct call to it (`monoBakeCallback`) and keys
      // on its identity (so `reduce(xs, add, …)` and `reduce(xs, mul, …)` get distinct instances).
      // A capturing callback (needs its live env), a generic one (needs its own instantiation), or
      // any non-resolvable closure value leaves "" → the param keeps its `call_ref`, unchanged.
      const cbFnNames: string[] = []
      let ci = 0
      while ci < args.length {
        cbFnNames.push(monoSpecializableCallbackName(args[ci], ctx))
        ci = ci + 1
      }
      const pinKinds: i32[] = []
      const pinPays: string[] = []
      monoBuildPinCol(pinned, pinKinds, pinPays)
      return monoMakeInstance(
        origFe,
        pinned,
        pinKinds,
        pinPays,
        pinTys,
        tvN,
        tvV,
        c.callFn,
        false,
        cbFnNames,
      )
    }
  }
  0
}

// The callback name to BAKE for a closure-valued argument, or "" when it is not specializable.
// Specializable iff the argument is a closure VALUE resolving to a known function (a bare top-level
// name, or an in-place lifted lambda literal) that CAPTURES NOTHING and is itself NON-GENERIC — so a
// direct by-name `call` (which passes the null env a non-capturing callee wants) is valid. Anything
// else (a capturing lambda, a generic function, a closure read from a binding/union/HOF result, a
// non-closure argument) returns "" and keeps the per-element `call_ref`.
function monoSpecializableCallbackName(argIx: i32, ctx: i32) {
  if !exprIsClosure(argIx, ctx) { return "" }
  const ax = unwrapParen(argIx)
  const an = P.nodes[ax]
  let fe = -1
  // The Ident arm is SCOPE-AWARE, like the CALL and function-VALUE paths: the flat
  // `fnIndexOf` hands every frame the module's FIRST function of this name, so the two
  // soundness gates below (`captureCountOf`, `monoGen`) were being asked about the WRONG
  // function whenever two frames declare a same-named callback.
  if an is FuncDecl { fe = fnStmtsPosOf(ax) }
  else if an is Ident { fe = fnIndexOfInScope(an.identName, ctx) }
  if fe < 0 || fe >= fnStmts.length { return "" }
  if captureCountOf(fe) > 0 { return "" }
  if fe < monoGen.length {
    if monoGen[fe] == 1 { return "" }
  }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    // THE BAKE IS BY NAME, AND THE CLONE IS TOP-LEVEL. `monoBakeCallback` rewrites the callback
    // param's call (`f(x)`) into a by-NAME call (`inner(x)`) inside a fresh function pushed with
    // `fnParent = -1`, so that name is re-resolved with NO enclosing frame — by the flat
    // first-wins map. When the caller's own scope resolves the name to a DIFFERENT function (each
    // of two makers declaring its own nested `inner`), the baked body calls the wrong one, and
    // the registry key (`"C<fe>@<name>"`) makes the two frames share that one specialization on
    // top: `apply(inner, 10)` in the second maker returned the FIRST maker's answer at rc 0,
    // while the closure argument it built carried the right funcref all along.
    //
    // Decline rather than bake a name that does not mean what the caller meant: the argument keeps
    // its `call_ref` through the general HOF path, correct by construction because the closure
    // value is already scope-resolved. A lifted `__lambda_N` name is unique, so it never declines.
    if fe != fnIndexOf(fn.fnName) { return "" }
    return fn.fnName
  }
  ""
}

// Does the NON-generic function at `fe` take a closure-typed parameter (`f: (i32,i32)=>i32`)? —
// i.e. is it a concrete higher-order function, a candidate for callback specialization. A `<T>`
// generic is excluded (its callbacks are already baked via `monoInstantiate` + `monoBakeCallback`).
function feHasClosureParam(fe: i32) {
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if fn.fnTyParams.length > 0 { return false }
    let i = 0
    while i < fn.fnParams.length {
      const p = P.nodes[fn.fnParams[i]]
      if p is Param {
        if p.parType >= 0 {
          if tyIsFuncType(p.parType) { return true }
        }
      }
      i = i + 1
    }
  }
  false
}

// Whether the program defines ANY concrete higher-order function — the gate that lets the mono
// pass run for callback specialization even when the program has no `<T>` generic. The compiler
// itself has none (it is closure-free imperative code), so this stays false for it, the pass stays
// skipped, and the all-i32 native fixpoint is left exactly as it was.
function monoHasConcreteHOFParam() {
  let fe = 0
  while fe < fnStmts.length {
    if fe < monoGen.length {
      if monoGen[fe] == 0 {
        if feHasClosureParam(fe) { return true }
      }
    }
    fe = fe + 1
  }
  false
}

// CALLBACK SPECIALIZATION for a CONCRETE (non-generic) HOF. A concrete `reduce(self: i32[], f:
// (i32,i32)=>i32, init)` never goes through `monoInstantiate` (it is not type-parameterized), so its
// body keeps the per-element `call_ref` through `f`. When a call passes a non-capturing concrete
// callback, clone the function with that callback BAKED in as a direct call (`monoBakeCallback`),
// append it as a fresh `<name>$cbN`, and point the call site at it — the concrete analogue of what
// `monoMakeInstance` does for generics, keyed purely on the callback identity (the params carry their
// own annotations, so there is no type pinning / return inference). Unlike a generic template, the
// ORIGINAL concrete function is KEPT (its slot is never replaced): it still serves any non-bakeable
// caller (a capturing lambda, a closure read from a binding/union). The closure VALUE is still passed
// (the param stays), so a callback used in a non-call position keeps working. No bakeable callback →
// returns 0 having changed nothing. Returns 0, or -1 via `emitFail`.
function monoSpecializeConcrete(callIx: i32, fe: i32, ctx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    const fn = P.nodes[fnStmts[fe]]
    if fn is FuncDecl {
      const params = fn.fnParams
      const args = c.callArgs
      if args.length != params.length { return 0 }
      // Only an ANNOTATED return is specialized. An UN-annotated return is inferred THROUGH the
      // callback param's call (`function applyN(g, x) { return g(x) }`): baking that `g(x)` into a
      // direct `maybeName(x)` re-derives the return via a different inference path, which doesn't
      // re-establish a nullable/union rep on the appended function (so a downstream `?? d` / `is`
      // narrow fails). The annotation pins the rep independent of the body, so it survives the bake.
      // The fold/reduce/search HOFs worth specializing annotate their return anyway; the un-annotated
      // case is the thin `return g(x)` wrapper, which barely benefits. (The generic path has the same
      // un-annotated-return limitation — a shared follow-up.)
      if fn.fnRet < 0 { return 0 }
      // The baked callback (and its param NAME) per position — "" where the argument is not a
      // non-capturing concrete function (a capturing lambda / generic / non-closure stays call_ref).
      const cbFnNames: string[] = []
      const cbParamNames: string[] = []
      let i = 0
      while i < args.length {
        const p = P.nodes[params[i]]
        if p is Param {
          cbParamNames.push(p.parName)
        } else {
          cbParamNames.push("")
        }
        cbFnNames.push(monoSpecializableCallbackName(args[i], ctx))
        i = i + 1
      }
      if !monoAnyBakedCallback(cbFnNames) { return 0 }
      // #1821'S SIBLING RUNG, and the reason the fix is not one line: both renames below (the
      // registry hit and the fresh specialization) point the call site at a specialization of the
      // callee `fe` RESOLVED FROM THE BINDING'S INITIALIZER. That is faithful only while the
      // binding still holds it — `let r = reduce1` / `r = reduce2` / `r(xs, add, 0)` answered
      // `reduce1`'s bake for EVERY call, at rc 0 from `vl check --codegen` and from the runtime.
      // Unlike `monoInstantiate`'s rung there is no instance to keep: the ORIGINAL concrete
      // function is never replaced (see the header), so declining simply leaves the `call_ref`
      // through the binding, which is what a written cell requires.
      //
      // Placed AFTER the bakeable-callback gate, so the only call it can decline is one that would
      // really have been specialized: a call BY NAME names the declaration rather than a binding
      // and never reaches it, which is why every existing specialization is untouched.
      const spCal = P.nodes[c.callFn]
      if spCal is Ident {
        if spCal.identName != fn.fnName && monoNameIsAssigned(spCal.identName) {
          return 0
        }
      }
      // Key on the callee + each baked callback identity, so `reduce(xs, add, …)` and `reduce(xs,
      // mul, …)` get distinct specializations. The `C` prefix keeps these out of the generic keyspace
      // (which always carries a `#`), so the two registries share storage without colliding.
      let key = "C" + i32ToStr(fe)
      let kc = 0
      while kc < cbFnNames.length {
        if cbFnNames[kc] != "" { key = key + "@" + cbFnNames[kc] }
        kc = kc + 1
      }
      // Registry hit: a prior call already specialized this (callee, callback-set) — reuse it.
      let r = 0
      while r < monoKeys.length {
        if monoKeys[r] == key {
          const cal = P.nodes[c.callFn]
          // R4 writer 7 of 8 (`compiler/symbols.vl`; census in `perf-program.md`).
          if cal is Ident {
            cal.identName = monoInstName[r]
            sidNoteNodeName(c.callFn)
          }
          return 0
        }
        r = r + 1
      }
      // Fresh specialization. `$cbN` is disambiguated by how many concrete specializations this
      // callee already has (its prior `monoInstOrig` entries).
      let count = 0
      let kk = 0
      while kk < monoInstOrig.length {
        if monoInstOrig[kk] == fe { count = count + 1 }
        kk = kk + 1
      }
      const instBody = monoBakeCallback(fn.fnBody, cbParamNames, cbFnNames)
      const nps: i32[] = []
      let pj = 0
      while pj < params.length {
        const p3 = P.nodes[params[pj]]
        if p3 is Param {
          nps.push(
            mkParam(p3.parName, p3.parType, p3.parDefault, p3.parOpt, p3.pos),
          )
          // D926 — as at the generic clone: the mark is arena-node keyed.
          anonLeafCarryParamMark(params[pj], nps[nps.length - 1])
        }
        pj = pj + 1
      }
      const noTP: string[] = []
      const specName = fn.fnName + "$cb" + i32ToStr(count)
      const nfn = mkFunc(specName, noTP, nps, fn.fnRet, instBody, fn.pos)
      // D926 — as above. The ORIGINAL declaration is kept here, so both it and the
      // specialization carry the mark and both signatures follow the merge.
      anonLeafCarryRetMark(fnStmts[fe], nfn)
      fnStmts.push(nfn)
      fnParent.push(-1)
      fnDispNames.push("")
      const instFe = fnStmts.length - 1
      // The in-place rename below is the same write `monoMakeInstance` performs, and it lands on
      // nodes this specialization may SHARE — with the original declaration, with a sibling
      // specialization of it, and (for the call site) with every instance of a generic caller,
      // since the per-instance call-spine copy only copies calls to GENERIC callees. Unlike the
      // generic case (#1220) that sharing is NOT divergent: a concrete declaration has no type
      // params and ALL its parameters annotated (`monoIsGenericDecl` is exactly the negation), so
      // every specialization walks the same body against the same pins and writes the same name.
      //
      // What the sharing DID cost is the REVISIT: the body below is walked once per specialization
      // AND once by the main loop, so a nested generic that landed on a count>0 instance was
      // re-read under its instance name and indexed `monoOrigNode` out of bounds (see
      // `monoFnParamTypeAt`). Pinned by the `mono-concrete-hof-instance-revisit` generics case.
      const cal2 = P.nodes[c.callFn]
      // R4 writer 8 of 8 (`compiler/symbols.vl`; census in `perf-program.md`).
      if cal2 is Ident {
        cal2.identName = specName
        sidNoteNodeName(c.callFn)
      }
      monoKeys.push(key)
      monoInstOrig.push(fe)
      monoInstName.push(specName)
      monoInstFe.push(instFe)
      if monoRebuild() < 0 { return -1 }
      // Walk the ORIGINAL body under this specialization's context so a nested generic call it
      // contains instantiates (idempotent via the registry — the main loop also walks the original).
      if monoWalk(fn.fnBody, nfn) < 0 { return -1 }
      if monoRebuild() < 0 { return -1 }
    }
  }
  0
}

// Walk the statement/expression tree at `ix` (inside function `ctx`, -1 = top
// level) and instantiate every direct call to a generic function. Arguments are
// walked BEFORE their call is classified, so an inner generic call's instance
// (and its now-concrete return kind) is in place when the outer call's argument
// types are read.
function monoWalk(ix: i32, ctx: i32) {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is Call {
    const args = n.callArgs
    let i = 0
    while i < args.length {
      if monoWalk(args[i], ctx) < 0 { return -1 }
      i = i + 1
    }
    const callee = P.nodes[n.callFn]
    if callee is Ident {
      // A generic function value passed as an ARGUMENT to a concrete function-typed PARAMETER
      // (`apply(add)` where `apply(f: (i32,i32)=>i32)`): materialize the instance for the
      // parameter's declared function type so the argument closure carries it. The RECEIVER's own
      // definition form is not an axis — `monoFnFeOfIdent` reaches a `function` declaration and an
      // arrow bound to a `const`/`let` alike, and each declares its parameters the same way.
      // Resolved ONCE for the whole argument list rather than per argument.
      //
      // ONLY WHERE THE DECLARATION IS CONCRETE. A parameter type that mentions the
      // receiver's OWN type parameters is not a function type yet — coercing to it pins the
      // argument's instance at the type VARIABLE's spelling (`monoFnParamAnnRidesTyParam`'s
      // header has the measurement). Those are deferred to `monoInstantiate`, which coerces
      // at the SUBSTITUTED annotation once the call's concrete arguments have bound it.
      const dfe = monoFnFeOfIdent(n.callFn, callee.identName, ctx)
      let ca = 0
      while ca < args.length {
        const pty = monoFnParamTypeAt(dfe, ca)
        if pty >= 0 {
          if !monoFnParamAnnRidesTyParam(dfe, ca) {
            if monoCoerceFnValue(args[ca], pty, ctx) < 0 { return -1 }
          }
        }
        ca = ca + 1
      }
      // SCOPE-AWARE, and that is load-bearing (#1265). The flat `fnIndexOf` returns the FIRST
      // `fnStmts` slot carrying the name, but `wasmEmit`'s by-name call path lowers this same call
      // through `fnIndexOfInScopeChain` — the language's own innermost-scope rule. When a nested
      // generic shares its name with a top-level function the two resolvers DISAGREE: this pass
      // looked at the top-level slot, saw nothing to instantiate, and left the nested `<T>`
      // template un-instantiated, so the prune below stubbed it to `() -> void` while the emitter
      // lowered the call against the NESTED slot, passing `(env, i32)` to a no-arg stub. INVALID
      // WASM at rc 0 from `vl check`, on every arrangement of the homonym; a nested generic with a
      // UNIQUE name never had it, since the resolvers diverge only on the shared name.
      //
      // `fnIndexOfInScope` is `emit_classify`'s deliberate twin of that chain walk, so this now
      // mirrors the call lowering exactly; at module scope it is `fnIndexOf` verbatim.
      let fe = fnIndexOfInScope(callee.identName, ctx)
      if fe < 0 {
        // A direct call through a VALUE binding to a generic NAMED function (`const g = add;
        // g(3, 4)`): resolve `g` to `add`'s lifted slot and monomorphize per call site, exactly
        // as a by-name call. NAMED functions only — a lambda bound to a closure-typed local
        // (`const f: (i32) => i32 = (x) => …`) is contextually pinned and `call_ref`'d, never
        // monomorphized (`criFnIsAnonLambda` excludes it; the emit-time value floor and the
        // LetDecl direct-call exemption keep the two paths sound).
        //
        // This is `monoFnFeOfIdent`'s second half, re-read rather than reused from `dfe` above:
        // the coercion loop between them materializes instances, and the callee binding may be
        // one of the arguments it rewrote. The fold below is a REWRITE, so it reads the slot as
        // of now; `dfe` only had to answer a parameter-list question that instances do not move.
        const afe = identClosureFeSid(sidOfNode(n.callFn), ctx)
        if afe >= 0 {
          if !criFnIsAnonLambda(afe) {
            // The fold below REWRITES `f(x)` into a by-name call to the INITIALIZER's instance,
            // which is only faithful while the binding still holds that initializer. A binding
            // that is ASSIGNED does not, and the fold made every later assignment invisible —
            // `let f: (i32,i32)=>i32 = sub; f = mul; f(3,4)` answered `sub`'s result at rc 0 from
            // both `vl check` and the emitter. Restricted to an ANNOTATED binding, whose
            // annotation guarantees the `$fnsig` the surviving `call_ref` resolves through; an
            // un-annotated one has no such guarantee and keeps the fold.
            if identFnTypeAnnName(callee.identName, ctx) == "" { fe = afe }
            else if !monoNameIsAssigned(callee.identName) { fe = afe }
          } else if identFnTypeAnnName(callee.identName, ctx) == "" {
            // A lambda bound to an UN-annotated `const` (`const add = (a, b) => a + b`): its params
            // are inference holes — monomorphize it per call exactly like a named generic function.
            // The slot-replacement keeps the binding's closure funcref pointing at the instance, so a
            // CAPTURING lambda's env still rides through the `call_ref`. An ANNOTATED binding
            // (`const f: (i32)=>i32 = …`) is contextually pinned and excluded.
            fe = afe
          }
        }
      }
      if fe >= 0 && fe < monoGen.length {
        if monoGen[fe] == 1 { return monoInstantiate(fe, ix, ctx) }
        // A CONCRETE callee: specialize it per non-capturing callback (no-op if none) — the
        // concrete analogue of `monoInstantiate`'s callback baking.
        return monoSpecializeConcrete(ix, fe, ctx)
      }
      return 0
    }
    return monoWalk(n.callFn, ctx)
  }
  if n is Block {
    const bs = n.blkStmts
    let i2 = 0
    while i2 < bs.length {
      if monoWalk(bs[i2], ctx) < 0 { return -1 }
      i2 = i2 + 1
    }
    return 0
  }
  if n is LetDecl {
    // An ANNOTATED function-typed binding to a generic NAMED function (`const c: (f64,f64)=>f64 =
    // add`): materialize the instance for the ANNOTATION's param types and point the binding at it,
    // so the value carries that concrete type independent of any call — it may ESCAPE (be passed,
    // returned, stored) where call-driven monomorphization can't reach. The annotation also governs
    // its calls (the checker pins them), so the instance the binding holds matches every use.
    if monoCoerceFnValue(n.letInit, n.letType, ctx) < 0 { return -1 }
    return monoWalk(n.letInit, ctx)
  }
  if n is IfStmt {
    if monoWalk(n.ifCond, ctx) < 0 { return -1 }
    if monoWalk(n.ifThen, ctx) < 0 { return -1 }
    return monoWalk(n.ifElse, ctx)
  }
  if n is WhileStmt {
    if monoWalk(n.whileCond, ctx) < 0 { return -1 }
    return monoWalk(n.whileBody, ctx)
  }
  if n is ForRange {
    if monoWalk(n.frFrom, ctx) < 0 { return -1 }
    if monoWalk(n.frTo, ctx) < 0 { return -1 }
    if monoWalk(n.frStep, ctx) < 0 { return -1 }
    return monoWalk(n.frBody, ctx)
  }
  if n is ForIn {
    if monoWalk(n.fiIter, ctx) < 0 { return -1 }
    return monoWalk(n.fiBody, ctx)
  }
  if n is RetStmt {
    // A generic function value RETURNED where the enclosing function declares a concrete function
    // return type (`function mk(): (f64,f64)=>f64 { return add }`): materialize the instance for
    // that return type so the returned value carries it.
    if ctx >= 0 {
      const cf = P.nodes[ctx]
      if cf is FuncDecl {
        if monoCoerceFnValue(n.retArg, cf.fnRet, ctx) < 0 { return -1 }
      }
    }
    return monoWalk(n.retArg, ctx)
  }
  if n is BinExpr {
    // ASSIGNMENT to a function-typed binding (`let f: (i32,i32)=>i32 = mul; f = add`). The
    // declared type is the same boundary the LetDecl arm reads, so a generic reaching it through
    // a later `=` materializes identically to one reaching it through the initializer — the
    // binding has ONE declared type and every write to it is that type. `identFnTypeAnnName`
    // resolves the target's written annotation; "" (no annotation, or not a function type) is a
    // no-op and leaves the walk exactly as it was.
    if n.binOp == "=" {
      const tgt = P.nodes[n.binLeft]
      if tgt is Ident {
        const atn = identFnTypeAnnName(tgt.identName, ctx)
        if atn != "" {
          if monoCoerceFnValueName(n.binRight, atn, ctx) < 0 { return -1 }
        }
      }
    }
    if monoWalk(n.binLeft, ctx) < 0 { return -1 }
    return monoWalk(n.binRight, ctx)
  }
  if n is Unary { return monoWalk(n.unArg, ctx) }
  if n is Paren { return monoWalk(n.parInner, ctx) }
  if n is Member { return monoWalk(n.memObj, ctx) }
  if n is OptMember { return monoWalk(n.omObj, ctx) }
  if n is Index {
    if monoWalk(n.idxArr, ctx) < 0 { return -1 }
    return monoWalk(n.idxIndex, ctx)
  }
  if n is IsExpr { return monoWalk(n.isObj, ctx) }
  if n is AsExpr { return monoWalk(n.asObj, ctx) }
  if n is ArrayLit {
    const es = n.arrElems
    let i3 = 0
    while i3 < es.length {
      if monoWalk(es[i3], ctx) < 0 { return -1 }
      i3 = i3 + 1
    }
    return 0
  }
  if n is ObjLit {
    const fs = n.objFields
    let i4 = 0
    while i4 < fs.length {
      const f = P.nodes[fs[i4]]
      if f is FieldInit {
        if monoWalk(f.fiValue, ctx) < 0 { return -1 }
      }
      i4 = i4 + 1
    }
    return 0
  }
  // A nested FuncDecl's body is walked through its own `fnStmts` slot (it was
  // lambda-lifted); every other node kind has no call-bearing children.
  //
  // `MatchExpr` is the one kind that LOOKS like an exception — its arm bodies are ordinary
  // expressions, and neither this walk nor the per-instance call-spine copy has a limb for it. It
  // never reaches here: the checker lowers every exhaustive `match` to an if/else chain and
  // OVERWRITES the arena slot in place (`typecheck.desugarMatchAt`), so by emit time a generic
  // call in an arm sits in an `IfStmt` limb both traversals do cover. Measured: a generic called ONLY
  // from a match arm instantiates (it would otherwise be pruned to a no-op stub and emit an
  // arity-mismatched call), and the same arm at two element types gets two instances.
  0
}

// Walk function `fnIx`'s own body, coercing its IMPLICIT return first. A bare-expression body
// (`const mk = (): (i32, i32) => i32 => padd`) parses to a synthetic one-statement `Block` with no
// `RetStmt` at all (`parseFuncBodyAndBuild`), so `monoWalk`'s `RetStmt` arm has nothing to read and
// the declared return type reached the value at NO point — the same declaration written
// `=> { return padd }` was coerced and accepted. The value of a body block is its LAST statement,
// which is exactly what `monoCoerceFnValueName`'s `Block` arm walks to, so handing it the whole
// body covers the braced trailing-expression form by the same rule. A `RetStmt` tail matches no arm
// there, so an explicit `return` is still coerced once, by the `RetStmt` arm.
function monoWalkFnBody(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    if monoCoerceFnValue(fn.fnBody, fn.fnRet, fnIx) < 0 { return -1 }
    return monoWalk(fn.fnBody, fnIx)
  }
  0
}

// Is `name` part of the module's wasm ABI — the public name or the internal target of a
// staged export alias? The driver fills `reExpName`/`reExpTarget` BEFORE `emitProgram` runs
// (single-source: an `EXPORT FUNCTION IDENT` token scan; module mode: the merged, mangled
// targets), so both tables are populated by the time the monomorphizer's prune reads them.
// The comparison is by NAME because `emitExportSection` resolves the export section the same
// way. Both tables are consulted: the single-source path pushes the same string into each,
// and the module path's public name may differ from its mangled target.
function monoNameIsExported(name: string) {
  let i = 0
  while i < reExpTarget.length {
    if reExpTarget[i] == name { return true }
    i = i + 1
  }
  let j = 0
  while j < reExpName.length {
    if reExpName[j] == name { return true }
    j = j + 1
  }
  false
}

// The `fnStmts` position `emitExportSection` would resolve `name` to: the FIRST slot holding a
// `FuncDecl` of that name. Mirrors that resolver exactly, and the mirroring is load-bearing —
// `monoNameIsExported` answers about a NAME, but two slots can carry one name and only one of
// them is the ABI entry. A nested `function outer<T>(x: T) { … }` is lambda-lifted into `fnStmts`
// UNMANGLED, so an `export function outer(n: i32): i32` elsewhere in the same file gives the
// name two carriers: the concrete export at a lower index, and an un-instantiated generic
// homonym at a higher one. The export section takes the first, so the second is ordinary dead
// code that must keep taking the silent no-op stub. Measured — a name-only gate rejected that
// program, moving a CORRECT cell backward to a reject, which is why this scan exists.
//
// Prior iterations of this same loop only ever REPLACE a slot with a same-named stub, so the
// answer does not depend on how far the prune has walked.
function monoFirstFnIndexNamed(name: string): i32 {
  let i = 0
  while i < fnStmts.length {
    const f = P.nodes[fnStmts[i]]
    if f is FuncDecl {
      if f.fnName == name { return i }
    }
    i = i + 1
  }
  -1
}

// The PUBLIC name an ABI entry publishes `name` under — for the diagnostic below, so it names
// what the user WROTE. In module mode a declaration's merged name is mangled (`id$m1`) and a
// re-export may rename it on the way out (`export { id as identity } from "./lib"`), so the raw
// `fnName` is not something the source contains. Falls back to `name` (the single-source path,
// where both tables hold the same string, and any name the tables do not carry).
function monoExportPublicName(name: string): string {
  let i = 0
  while i < reExpTarget.length {
    if reExpTarget[i] == name { return reExpName[i] }
    i = i + 1
  }
  name
}

// Did `monomorphize` pin the generic declaration at lifted position `origFe` from at least one
// call site? Every instantiation records a row — INCLUDING the count-0 one that reuses the
// original slot (`monoInstFe == origFe`) — so this is the rename-immune answer to "is this
// template's parameter shape backed by a real argument list", asked AFTER the pass has rewritten
// callee identifiers to instance names (which is why counting `Ident`s cannot answer it).
//
// A generic template that NOTHING instantiated still emits its body at the i32 DEFAULT, and that
// body is only accidentally valid: `function add(a, b) { return a + b }` lowers, while
// `function exclaim(s) { return s + "!" }` emits a string-concat helper call over an i32
// parameter — `vl check` rc 0, INVALID WASM (this is #1254 mechanism B, whose prune declines
// exactly when the name is taken as a VALUE). So every value-floor exemption that hands such a
// template out as a closure has to demand this first.
export function monoInstantiatedAny(origFe: i32) {
  let k = 0
  while k < monoInstOrig.length {
    if monoInstOrig[k] == origFe { return true }
    k = k + 1
  }
  false
}

// The distinct concrete parameter spellings every instance `monomorphize` pinned for the generic
// declaration at `origFe`, comma-joined — `"(i32, i32), (f64, f64)"` — or "" when no call site
// pinned it. The DIAGNOSTIC half of `monoInstantiatedAny`: a value site that has to decline a
// generic function can name the signatures the program itself already proves it wants, which is
// the annotation the user has to write. Read off each instance DECLARATION's parameters, so an
// all-i32 clone (which keeps `parType = -1` for byte-identity) still renders as `i32`.
//
// `monoInstFe` can name an APPENDED instance slot, which is why the bound is `fnStmts.length` and
// not `monoOrigNode.length` — the pre-pass column is only as long as the declaration count, and
// indexing it past that end traps the whole compiler with no diagnostic.
export function monoPinnedSigsOf(origFe: i32) {
  const sigs: string[] = []
  let k = 0
  while k < monoInstOrig.length {
    if monoInstOrig[k] == origFe {
      const ife = monoInstFe[k]
      if ife >= 0 && ife < fnStmts.length {
        const fn = P.nodes[fnStmts[ife]]
        if fn is FuncDecl {
          let sig = "("
          const ps = fn.fnParams
          let i = 0
          while i < ps.length {
            if i > 0 { sig = sig + ", " }
            const p = P.nodes[ps[i]]
            if p is Param {
              if p.parType >= 0 {
                sig = sig + tyNameOf(p.parType)
              } else {
                sig = sig + "i32"
              }
            }
            i = i + 1
          }
          // Two instances can render the same spelling (their keys differ in a baked CALLBACK,
          // not in a parameter type), and a repeated signature reads as a compiler bug.
          pushUniqueAtom(sigs, sig + ")")
        }
      }
    }
    k = k + 1
  }
  let out = ""
  let j = 0
  while j < sigs.length {
    if j > 0 { out = out + ", " }
    out = out + sigs[j]
    j = j + 1
  }
  out
}

// Which of `names` is referenced as a function VALUE — i.e. appears as an `Ident` that is NOT
// some `Call`'s callee — anywhere in the node arena. Returns an `i32[]` parallel to `names`
// (1 = value-referenced). ONE arena pass regardless of how many names are asked about: the
// callee positions are marked first (a `Call` names its callee by NODE, `callFn`), then every
// remaining `Ident` is compared against the (small) candidate list.
//
// This is the soundness gate the un-annotated-param prune below needs and the `<T>` prune does
// not. A `<T>` decl is only ever reached by instantiation, but a NAMED un-annotated-param
// function is an ordinary first-class value: `const g = f`, `hof(f, 3)`, `return f` all hand a
// funcref out WITHOUT going through `monoInstantiate` for some of those spellings, so its slot
// can still equal its captured original while the program very much uses it. Conservative by
// construction: a same-named LOCAL also matches and merely declines the prune, never regresses.
export function monoNamesUsedAsValue(names: string[]): i32[] {
  const hit: i32[] = []
  let h = 0
  while h < names.length {
    hit.push(0)
    h = h + 1
  }
  if names.length == 0 { return hit }
  const isCallee: i32[] = []
  let i = 0
  while i < P.nodes.length {
    isCallee.push(0)
    i = i + 1
  }
  let j = 0
  while j < P.nodes.length {
    const cn = P.nodes[j]
    if cn is Call {
      const cf = cn.callFn
      if cf >= 0 && cf < isCallee.length { isCallee[cf] = 1 }
    }
    j = j + 1
  }
  let k = 0
  while k < P.nodes.length {
    if isCallee[k] == 0 {
      const idn = P.nodes[k]
      if idn is Ident {
        let m = 0
        while m < names.length {
          if names[m] == idn.identName { hit[m] = 1 }
          m = m + 1
        }
      }
    }
    k = k + 1
  }
  hit
}

// The lifted-function position of the GENERIC (un-annotated-param) NAMED function that the
// MODULE-LEVEL binding at `letIx` aliases, when handing that template out as this binding's
// closure value is sound — else -1. The module-scope twin of the function-body exemption in
// `emitLetDeclStmt`, over a wider region: a global is visible everywhere, so "used only as a
// direct-call callee" must hold PROGRAM-WIDE. `monoWalk` resolves `f(args)` through the binding
// and monomorphizes per call site, so the closure this binding stores is never what a
// differently-typed call goes through — it is dead, or `call_ref`'d at its slot's one shape.
//
// THREE gates, each load-bearing: (1) an un-annotated-param NAMED function — an ANNOTATED binding
// materializes at `monoCoerceFnValue` and a lifted anonymous lambda is excluded by
// `criFnIsAnonLambda`; (2) INSTANTIATED at least once (`monoInstantiatedAny`), since an uncalled
// template emits at the i32 default; (3) never referenced as a VALUE, conservatively.
export function monoGenericAliasFe(letIx: i32) {
  if letIx < 0 { return -1 }
  const d = P.nodes[letIx]
  if d is LetDecl {
    const fe = fieldValueFeOf(d.letInit)
    if fe < 0 { return -1 }
    if !fnHasUnannotatedParam(fe) { return -1 }
    if criFnIsAnonLambda(fe) { return -1 }
    if !monoInstantiatedAny(fe) { return -1 }
    const one: string[] = []
    one.push(d.letName)
    const used = monoNamesUsedAsValue(one)
    if used[0] == 1 { return -1 }
    return fe
  }
  -1
}

// The monomorphization pass: snapshot which lifted functions are generic, then
// walk every top-level statement (program order — a `const ys = get([…])` pins
// `get` before a later `first(ys)` reads its return kind) and every NON-generic
// function body; instance bodies are walked as they are created. Usage-gated:
// a program with no generic declaration returns immediately.

// The `fnStmts` slot of the lambda a lifted lambda's own binding ALREADY holds — the binding's
// INITIALIZER — when this lambda reached its slot through an ASSIGNMENT (`f = (a) => …`), or -1.
//
// One binding owns ONE closure cell and that cell carries ONE functype, so every lambda written
// into it has to be lowered at the same signature. Only the INITIALIZER is ever reached by a
// call: `monoWalk` resolves `f(1.5)` through `identClosureFeSid`, which reads the `LetDecl`'s
// init and knows nothing about later writes. The assigned lambda therefore arrived at the
// emitter un-pinned, took the i32 default, and the cell's own `call_indirect` refused it.
//
// EXACTLY ONE assignment, or -1: a lambda literal written into two different bindings has no
// single signature to adopt, and guessing one is how a trap becomes a wrong answer. The frame
// comes from `fnParent`, which is what `identClosureFeSid` wants for a function-scoped `let`.
function monoAssignedPeerFe(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const node = fnStmts[fe]
  let tgt = -1
  let seen = 0
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is BinExpr {
      if nd.binOp == "=" && nd.binRight == node {
        const lt = P.nodes[nd.binLeft]
        if lt is Ident {
          tgt = nd.binLeft
          seen = seen + 1
        }
      }
    }
    i = i + 1
  }
  if seen != 1 || tgt < 0 { return -1 }
  let ctx = -1
  if fe < fnParent.length {
    const pp = fnParent[fe]
    if pp >= 0 && pp < fnStmts.length { ctx = fnStmts[pp] }
  }
  const peer = identClosureFeSid(sidOfNode(tgt), ctx)
  if peer == fe { return -1 }
  peer
}

// The concrete parameter SPELLINGS a lifted slot's declaration carries, appended to `out` —
// an instance's pins, read the way `monoPinnedSigsOf` reads them, with `"i32"` for the hole a
// count-0 all-i32 clone deliberately leaves un-annotated. false when the slot is not a
// function declaration at all (nothing appended that a caller could mistake for a pin).
function monoSlotParamPins(fe: i32, out: string[]) {
  if fe < 0 || fe >= fnStmts.length { return false }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param {
        if p.parType >= 0 {
          out.push(tyNameOf(p.parType))
        } else {
          out.push("i32")
        }
      } else {
        return false
      }
      i = i + 1
    }
    return true
  }
  false
}

export function monomorphize(stmts: i32[]) {
  monoGen = []
  monoOrigNode = []
  monoKeys = []
  monoInstOrig = []
  monoInstName = []
  monoInstFe = []
  monoProgStmts = stmts
  monoLamPinned = []
  monoLamShared = []
  let any = false
  let fe = 0
  while fe < fnStmts.length {
    monoOrigNode.push(fnStmts[fe])
    if monoIsGenericDecl(fnStmts[fe]) {
      monoGen.push(1)
      any = true
    } else {
      monoGen.push(0)
    }
    fe = fe + 1
  }
  // The pass also runs for callback specialization of a CONCRETE higher-order function (no `<T>`
  // generic needed). Gated on the program actually defining one, so a generic-free, HOF-free
  // program (the compiler itself) still skips the pass entirely and is left exactly as it was.
  if !any {
    if monoHasConcreteHOFParam() { any = true }
  }
  if !any { return 0 }
  // Top-level statements first, in source order (global inits + start stmts).
  let i = 0
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    if s is FuncDecl {
    } else if s is LetDecl {
      // Walk the LetDecl NODE (not just its init) so the annotated-function-typed-binding
      // materialization in `monoWalk`'s `LetDecl` arm reaches a TOP-LEVEL binding too; the arm
      // still recurses into the init, so the existing behavior is unchanged for every other let.
      if monoWalk(stmts[i], -1) < 0 { return -1 }
    } else if nodeIsTypeDecl(stmts[i]) {
    } else if s is UnionDecl {
    } else {
      if monoWalk(stmts[i], -1) < 0 { return -1 }
    }
    i = i + 1
  }
  // Then every non-generic lifted function's body. (A generic original's body
  // is only ever walked through an instance; an instance appended during this
  // loop extends `fnStmts`, but its body was already walked on creation —
  // `monoGen` is frozen at the pre-pass length, and appended slots are past it.)
  let fe2 = 0
  const nDecl = monoGen.length
  while fe2 < nDecl {
    if monoGen[fe2] == 0 {
      if monoWalkFnBody(fnStmts[fe2]) < 0 { return -1 }
    }
    fe2 = fe2 + 1
  }
  // THE LAMBDA HALF OF THAT LOOP, and the arm it lacked (#1827). `monoGen == 1` covers two
  // carriers that are only alike on paper. A NAMED generic is reached ONLY through
  // `monoInstantiate`, so "the instance walks the body" is exact for it. A lifted ANONYMOUS
  // LAMBDA is not: it is instantiated only when a call goes through its own binding, and a lambda
  // that is merely `call_ref`'d reaches no such call site — passed to a higher-order function,
  // read back through a REASSIGNED binding, or never called at all. Its body was therefore walked
  // by NOTHING, so a generic it forwards to was never instantiated and the prune below stubbed
  // that generic to `() -> void` while the lambda went on calling it: `vl check` rc 0, INVALID WASM.
  //
  // Walked HERE, after the two loops above, because "was this lambda instantiated" is only settled
  // once every call site has been seen. Walking one lambda can instantiate another, which is why
  // the guard is re-read per iteration rather than collected up front. USAGE-GATED to a no-op.
  let fe3 = 0
  while fe3 < nDecl {
    if monoGen[fe3] == 1 && criFnIsAnonLambda(fe3) {
      if !monoInstantiatedAny(fe3) {
        // THE BINDING'S SIGNATURE FIRST, where this lambda got its slot from an `f = …`
        // write. Pinning it from its peer is what makes the two lambdas one cell: pinned by
        // the cascade's own catch-all instead, `f = (a) => g(a)` after `let f = (a) => g(a)`
        // and `f(1.5)` declared an i32 parameter under a cell the initializer's f64 instance
        // typed — `call_indirect type mismatch` at runtime. The i32 rep only ever agreed by
        // accident.
        const peer = monoAssignedPeerFe(fe3)
        if peer >= 0 && peer < nDecl && monoInstantiatedAny(peer) {
          const pins: string[] = []
          if monoSlotParamPins(peer, pins) {
            const own = P.nodes[fnStmts[fe3]]
            if own is FuncDecl {
              if own.fnParams.length == pins.length {
                if monoInstanceFor(fe3, pins, fnStmts[fe3]) < 0 { return -1 }
              }
            }
          }
        }
        // `monoInstanceFor` DECLINES silently on a boundary it cannot reproduce (a concrete
        // annotation the pin contradicts, a first-use-wins binding the second position
        // denies), so the walk is gated on the OUTCOME rather than on having tried — a
        // declined pin must still get its body walked, or the generic it forwards to is the
        // `() -> void` stub again.
        if !monoInstantiatedAny(fe3) {
          if monoWalkFnBody(fnStmts[fe3]) < 0 { return -1 }
        }
      }
    }
    fe3 = fe3 + 1
  }
  // PRUNE the un-instantiated `<T>` generics into a concrete no-op STUB (same name, no params,
  // void body). `monoInstantiate` REPLACES the slot on the FIRST instance, so a slot still equal
  // to its captured original was never called and nothing references it — importing a module for
  // SOME of its generics pulls in ALL of them, so this is routine. #1254 mechanism B extends it
  // to a NAMED un-annotated-param function, whose hole otherwise takes the i32 default while the
  // body's operators lower from the other operand: check-clean INVALID WASM.
  //
  // #1260 — AN EXPORTED `<T>` IS A REJECT, NOT A STUB: the stub keeps the NAME, so the export
  // section published a `() -> void` ABI and an importer's `id(1)` got `undefined`. THREE gates
  // narrow the hole half — not an anon lambda (`call_ref`'d, never instantiated), not EXPORTED
  // (an exported hole often lowers fine today and stubbing it would move a working cell BACKWARD
  // — the loud reject that shape wants is STILL OPEN), and not used as a VALUE.
  const cndFe: i32[] = []
  const cndNm: string[] = []
  let gc = 0
  while gc < nDecl {
    if fnStmts[gc] == monoOrigNode[gc] {
      const cfn = P.nodes[fnStmts[gc]]
      if cfn is FuncDecl {
        if cfn.fnTyParams.length == 0 && monoGen[gc] == 1 && cfn.fnName != "" {
          if !criFnIsAnonLambda(gc) {
            if !monoNameIsExported(cfn.fnName) {
              cndFe.push(gc)
              cndNm.push(cfn.fnName)
            }
          }
        }
      }
    }
    gc = gc + 1
  }
  const cndVal = monoNamesUsedAsValue(cndNm)
  let gp = 0
  while gp < nDecl {
    if fnStmts[gp] == monoOrigNode[gp] {
      const gfn = P.nodes[fnStmts[gp]]
      if gfn is FuncDecl {
        let prune = false
        if gfn.fnTyParams.length > 0 {
          // #1260: the slot is still the captured template, so nothing instantiated it — and it
          // IS the slot the export section resolves to, so the stub below would publish its name
          // at `() -> void`. Reject loudly instead, under the name the export actually publishes.
          // Both halves of the gate are needed: the name must be in the ABI tables, AND this slot
          // must be the carrier `emitExportSection` picks (a lifted nested homonym is not).
          let isAbiSlot = false
          if monoNameIsExported(gfn.fnName) {
            if monoFirstFnIndexNamed(gfn.fnName) == gp { isAbiSlot = true }
          }
          if isAbiSlot {
            const pubNm = monoExportPublicName(gfn.fnName)
            return emitFail(
              "emitProgram: the exported generic function `" +
                pubNm +
                "` is never instantiated, so there is no concrete signature to export " +
                "(a wasm export names one functype and `" +
                pubNm +
                "` names none) — call it in this module, or export a concrete wrapper",
            )
          }
          prune = true
        } else {
          let ci = 0
          while ci < cndFe.length {
            if cndFe[ci] == gp && cndVal[ci] == 0 { prune = true }
            ci = ci + 1
          }
          // D426 — THE LAMBDA TEMPLATE, which is the `<T>` arm above one frame down. A lambda
          // lifted out of a generic body still spells its parameters at the enclosing `T`, and
          // `collectFns` lifted it ONCE, before any pin existed. Each instance now mints its own
          // copy with the pin substituted (`monoCloneLambdaSubst`), so this slot has exactly the
          // property the arm above prunes on: no concrete signature, and no reference left.
          //
          // Gate (1) of that arm — NOT an anonymous lambda — is the one this deliberately
          // inverts, and the reason it can is that the property is decided by the ANNOTATION
          // rather than by whether anything instantiated the slot. A lifted `(x) => x * 2` has
          // no `T` in it and is never claimed here; a lifted `(x: T[]) => …` has no lowering at
          // all, for the same reason an un-instantiated `<T>` decl has none.
          if !prune {
            if criFnIsAnonLambda(gp) && monoLamSlotIsTyParamTemplate(gp) {
              // TWO LEDGERS, AND BOTH ARE LOAD-BEARING. Stub the template only when a clone
              // actually replaced it, or when no enclosing frame was instantiated at all.
              // A template a clone DECLINED (`monoLamShared`) is one an instance body still
              // calls by name, and a template the walk never reached is in neither list —
              // stubbing either would leave `const g = <() -> void stub>` and a silently
              // wrong answer where the `checkParams` floor gives a loud one.
              const lnd = fnStmts[gp]
              if !monoI32ListHas(monoLamShared, lnd) {
                if monoI32ListHas(monoLamPinned, lnd) { prune = true }
                else if !monoLamFrameInstantiated(gp) { prune = true }
              }
            }
          }
        }
        if prune {
          const noTP: string[] = []
          const noPs: i32[] = []
          fnStmts[gp] = mkFunc(
            gfn.fnName,
            noTP,
            noPs,
            -1,
            mkBlock([], gfn.pos),
            gfn.pos,
          )
        }
      }
    }
    gp = gp + 1
  }
  0
}

// Does the annotation node `ix` mention any of `typarams`? The parser's SPELLING TREE answers
// where it survives, and the string form answers where it does not.
//
// `monoAnnHasTyParam` re-parses the RENDERED annotation: `splitUnionAtoms` on a quote- and
// depth-aware scan, then per-shape arms for map, function, array and object. Every shape needs
// its own arm, and a missing one is SILENT — the map arm's header records what that cost.
// `tsMentionsAnyName` visits every kid of every node, so it cannot have a missing arm, and it
// compares each leaf WHOLE (its own header: "`T`, `T[]`, `Box<T>` and `{a: T}` all mention `T`").
//
// The name form STAYS for nodes with no tree: `annTsOf` answers -1 once `canonEmitTypeNames`
// rewrites a name in place, and answering FALSE there would skip the substitution entirely and
// let the type parameter survive into the instance — the exact defect above.
function monoAnnMentionsTyParam(ix: i32, ann: string, typarams: string[]) {
  const root = annTsOf(ix)
  if root >= 0 { return tsMentionsAnyName(root, typarams) }
  monoAnnHasTyParam(ann, typarams)
}
