// `emit_mono.vl` — the emitter's per-callsite monomorphizer: the eager pre-pass that
// clones a generic lifted function (explicit `<T>` params, or an un-annotated
// inference hole the checker pins per call site) into one concrete instance per
// distinct call-site shape (`monomorphize` → `monoWalk` → `monoInstantiate` →
// `monoMakeInstance`), plus the callback baking and lambda pinning that
// specialization needs. It consults the classifiers, re-runs the collection passes
// after minting (`monoRebuild`), and writes no bytes.
//
// Function-index stability is the invariant: the first instance replaces the
// original's `fnStmts` slot, each later distinct shape appends `name$N`, and a
// program with no generic call creates none. The host oracle and the two deliberate
// divergences: `docs/internals/monomorphization-design.md`.

import {
  annGenAppSpanEnds,
  arrElemIs,
  arrElemNameRaw,
  listElemNameOf,
  nameIsArray,
  nameIsBraceSpanEnds,
  nameIsParenOpen,
  nameIsParenSpanEnds,
  splitUnionAtoms,
} from "./tyname"
import {
  T,
  TyArray,
  TyFunc,
  TyObj,
  bindGenWalk,
  blockHasBareReturn,
  canonEmitName,
  flatConstOfNameProp,
  i32TyIx,
  inferRetNameOf,
  isVarTyIxOf,
  litUnionAliasNameOfTy,
  monoInferListElem,
  monoInferLocalScalar,
  monoInferRetExprTy,
  monoInferRetSetUnionName,
  nameIsLitUnionType,
  nodeTyArrayElemIsBoolPrim,
  nodeTyIsFunc,
  nodeTyIsStringPrim,
  nodeTyIsUnionish,
  nodeTyIxOf,
  nodeTyMapName,
  nodeTyName,
  nodeTyNestedElemIsBoolPrim,
  recordClonedIsVarTy,
  recordClonedIsVarTyIx,
  recordClonedNodeTy,
  substTyDeep,
  tyExcludesNull,
  tyFieldTyOf,
  tyHasTyVar,
  tyIsLitUnionArray,
  tyRenderSoftensLits,
  tyToEmitName,
} from "./typecheck"
import {
  ArrayLit,
  AsExpr,
  BinExpr,
  Block,
  Call,
  FieldDef,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  Index,
  IsExpr,
  LetDecl,
  Member,
  ObjLit,
  OptMember,
  P,
  Param,
  Paren,
  RetStmt,
  TypeDecl,
  TypeRef,
  Unary,
  UnionDecl,
  WhileStmt,
  annTsOf,
  hasNamedArgs,
  i32ToStr,
  mkArrayLit,
  mkAsExpr,
  mkBinary,
  mkBlock,
  mkCall,
  mkCallN,
  mkCompoundAssign,
  mkFieldInit,
  mkForIn,
  mkForRange,
  mkFunc,
  mkIdent,
  mkIf,
  mkIndex,
  mkIsExpr,
  mkIsExprNeg,
  mkLet,
  mkMember,
  mkNum,
  mkObjLit,
  mkOptMember,
  mkParam,
