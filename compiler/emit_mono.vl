  mkParam,
  mkParen,
  mkPreIncr,
  mkReturn,
  mkUnary,
  mkWhile,
} from "./ast"
import { PIN_SIGKEY } from "./ast"
// R4 writers 5-8 of 8 live in this file: monomorphization rewrites a call's callee
// NAME in place, on a node the arena already holds. See `compiler/symbols.vl`.
import { sidNoteNodeName, sidOfNode } from "./symbols"
import {
  annArrowAt,
