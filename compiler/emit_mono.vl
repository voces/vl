// ── per-callsite monomorphization ────────────────────────────────────────────

// A direct call to a generic resolves to a concrete instance: a clone whose generic
// annotations become the call's concrete type names, keyed by `(decl, pinned-param-
// names)` and registered before the body is walked so a recursive self-call at the
// same shape hits the registry.

import { i32ListHas, strListHas, strListIndexOf } from "./listutil"
import { strContains } from "./strutil"
import {
  flattenVariantsInto,
  nonNullTy,
  tyEmitPrimOf,
  tyExcludesNull,
  tyHasTyVar,
  tyHasTyVarWasCapped,
  tyIsNumericBox,
  tyReachesHole,
  tyStepElem,
} from "./tyquery"
import {
  isValueUnionTyOr,
  nameIsLitUnionType,
  nulNumScalarUnionName,
} from "./check_ty_rep"
import { tyIsWriteLandRead } from "./check_hole_pins"
import { valueUnionRetName } from "./check_ret_names"
import {
  holeNamesTpJoin,
  tvElseBase,
  tvElseTested,
  tyIsArmedDeferredJoin,
  tyIsTpJoinUnion,
} from "./check_tp_join"
import { numUnionMinted, tyIsNumUnion } from "./check_union_mint"

// D943 — the lifted slots `monoPinBodyLambdas` minted for the instance being built. A
// clone's `fnParent` cannot be set at clone time (its own `FuncDecl` does not exist
// yet), so it would inherit the template's parent and give every instance one env
// layout. Recorded here and re-pointed the moment the instance is lifted.
let monoLamMintedSlots: i32[] = []
// Every lifted slot a lambda clone took for the instance being built, nested clones included.
// Never retired, since the instance walks each clone's body once it is registered (D2553).
let monoLamCloneSlots: i32[] = []

// The arena shape `monoRebuild`'s two whole-program passes are a pure function of:
// `P.nodes`, `fnStmts` and `fnParent` grow, and `monoArenaTick` counts what lands IN PLACE,
// which no length can see. Every in-place write in this module calls `monoArenaTouch` or
// carries an `arena-tick exempt:` line; `tests/vl_mono_arena_tick_test.ts` enforces that.
let monoArenaTick = 0
let monoRebuiltStamp = 0 - 1

// `monoProgStmts` indexed by the interned name of each module-scope `LetDecl`, first
// occurrence winning — `monoModuleLetOf`'s answer whenever the name is one of them. A miss
// stays -1, the fall-through to `moduleLocalLetOfUnique`. Rebuilt at the one write to
// `monoProgStmts`, so it carries no row from an earlier compile.
let monoProgLetBySid: i32[] = []

function monoArenaStamp() {
  P.nodes.length + fnStmts.length + fnParent.length + monoArenaTick
}

// Record an in-place write to a node field or to a `fnStmts`/`fnParent` slot: no length
// moves, so the stamp needs the count to see it. Every such write in this module calls it,
// and it drops the capture memo `monomorphize` runs under for the same reason.
function monoArenaTouch() {
  monoArenaTick = monoArenaTick + 1
  capMemoNoteEdit()
}

// D1046 — is this the first instance of the generic being built? Read by the nested
// named-function arm alone: at `count == 0` the instance reuses the template's own
// slot, so template and clone would be two children of one frame under one name and
// the call would answer the unsubstituted template.
let monoInstIsFirst = false

// The lifted slot a named nested template is replaced in, keyed by the template's own
// node: the first instance overwrites `fnStmts[slot]`, which breaks the "scan `fnStmts`
// for this node" lookup, and a -1 there shares one env struct across two pins. Reset per
// program, since a node index names a different function in the next one (D1820).
let monoNamedTmplNode: i32[] = []
let monoNamedTmplSlot: i32[] = []

// The lifted slot holding node `fnIx`: the plain scan, plus the replacement table for a
// named template whose slot now holds its first instance. One home, because two call
// sites ask the same question with the same loop.
function monoSlotOfLamNode(fnIx: i32) {
  let fe = 0 - 1
  let k = 0
  while k < fnStmts.length {
    if fnStmts[k] == fnIx { fe = k }
    k = k + 1
  }
  if fe >= 0 { return fe }
  let r = 0
  while r < monoNamedTmplNode.length {
    if monoNamedTmplNode[r] == fnIx { return monoNamedTmplSlot[r] }
    r = r + 1
  }
  -1
}

// Is `nm` a source function name rather than the emitter's synthesized lambda name?
// `collectFns` rewrites an anonymous lambda's empty name to `__lambda_N` before this
// pass, so `fnName != ""` is true of every lifted lambda and is not the test. Same rule
// as `criFnIsAnonLambda`, asked of a name rather than of a slot.
function monoFnNameIsSourceNamed(nm: string) {
  if nm == "" { return false }
  if nm.length >= 8 && nm.slice(0, 8) == "__lambda" { return false }
  true
}

// The function-type name of argument `argIx`, preferring the checker's recorded type:
// for an un-annotated lambda argument it inferred the param types from the generic
// param's substituted expected type, which the syntactic build below cannot recover.
// The gate is the arena (`nodeTyIsFunc`), and the struct part is nominalized once here.
function monoArgFnTypeName(argIx: i32, fnIx: i32) {
  const ax = unwrapParen(argIx)
  const an = P.nodes[ax]

  if nodeTyIsFunc(ax) {
    const cn = nodeTyName(ax)
    if cn != "" { return nominalizeFnTypeOfTy(nodeTyIxOf(ax)) }
    // A type riding the instance's parameters names nothing until substituted (D4647).
    const pt = monoExactPinTyOf(nodeTyIxOf(ax), fnIx)
    if pt >= 0 && !tyHasTyVar(pt) { return nominalizeFnTypeOfTy(pt) }
  }
  let fe = -1
  if an is FuncDecl { fe = fnStmtsPosOf(ax) }
  else if an is Ident { fe = fnIndexOfAt(sidOfNode(ax), fnIx, ax) }
  if fe < 0 || fe >= fnStmts.length { return "" }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    let nm = "("
    let i = 0
    while i < fn.fnParams.length {
      const p = P.nodes[fn.fnParams[i]]
      if p is Param {
        if p.parType < 0 { return "" }
        const pn = tyNameOf(p.parType)
        if pn == "" { return "" }
        if i > 0 { nm = nm + "," }
        nm = nm + pn
      }
      i = i + 1
    }
    const rn = cloRetTypeName(fe)
    if rn == "" { return "" }
    return nm + ")=>" + rn
  }
  ""
}

// The union of list types `ty` spelled member by member, a list of records by its row's name;
// "" when a member has no name.
function monoListUnionRowName(ty: i32): string {
  const t = T.tys[ty]
  if t is TyUnion {
    let nm = ""
    let i = 0
    while i < t.uMembers.length {
      const m = t.uMembers[i]
      let mn = monoRetListRowName(m)
      // A literal's `#anon` row names no type, so the member keeps its shape (D5083).
      if mn == "" || strContains(mn, "#anon") { mn = tyToEmitName(m) }
      if mn == "" { return "" }
      if i > 0 { nm = nm + "|" }
      nm = nm + mn
      i = i + 1
    }
    return nm
  }
  ""
}

// D970 — does this function's return set disagree with `reIx`, the type of the one
// return expression the mint above derives from? Conservative by construction: false
// whenever it cannot see the returns, so a single-return instance keeps its mint.
function monoRetJoinDisagrees(fnNodeIx: i32, reIx: i32): boolean {
  if reIx < 0 { return false }
  if fnNodeIx < 0 { return false }
  const f = P.nodes[fnNodeIx]
  if f is FuncDecl {
    const rets: i32[] = []
    collectValuedReturns(f.fnBody, rets)
    let i = 0
    while i < rets.length {
      const rt = nodeTyIxOf(rets[i])
      if rt >= 0 {
        // Concrete disagreement only. A return whose type is or contains a type
        // variable is per-call-site, and declining the mint for it turns the
        // deferred-join family from a loud refusal into invalid wasm.
        if !tyHasTyVar(rt) {
          if rt != reIx { return true }
        }
      }
      i = i + 1
    }
  }
  false
}

// A struct or struct-array annotation name usable as a monomorphization pin while the
// locals and struct-classification tables are unbuilt: the bare struct `P`, or `P[]`.
// "" for anything else. One level of `[]`; `n >= 3` excludes the degenerate `"[]"`.
function monoStructAnnName(name: string) {
  if isSName(name) { return name }
  const n = name.length
  if n >= 3 && nameIsArray(name) {
    if isSName(arrElemNameRaw(name)) { return name }
  }
  ""
}

// Is `name` still the module's binding when read from inside `fnIx` (-1 = module scope)?
// False when that body binds it or takes a parameter of it — the shadow test, which is not
// the same question as `fnIx >= 0` (D703).
function monoModuleNameVisible(name: string, fnIx: i32) {
  if fnIx < 0 { return true }
  if paramTypeNode(fnIx, name) >= 0 { return false }
  const shf = P.nodes[fnIx]
  if shf is FuncDecl { return parentLetOf(shf.fnBody, name) < 0 }
  false
}

// The module-scope `LetDecl` for `name` as seen from `fnIx`, or -1, through
// `monoProgLetBySid`. Module scope has two storage classes: a top-level block's binding is
// a start-function local, absent from `monoProgStmts`, so `moduleLocalLetOfUnique` is the
// other table (D1596).
function monoModuleLetOf(name: string, fnIx: i32) {
  if !monoModuleNameVisible(name, fnIx) { return -1 }
  const hit = sidArrGet(monoProgLetBySid, sidLookup(name))
  if hit >= 0 { return hit }
  moduleLocalLetOfUnique(emitRootIx, name)
}

// Does the module-block binding at `letIx` carry `want`, the emit name of what the checker
// recorded for a call site? Both of the binding's spellings answer: an alias puts `Box` on
// the annotation and the inline shape on the initializer, and only one renders as `want`.
function monoModuleLetTyIs(letIx: i32, want: string) {
  if want == "" { return false }
  const gd = P.nodes[letIx]
  if gd is LetDecl {
    if gd.letType >= 0 {
      if tyNameOf(gd.letType) == want { return true }
    }
    if gd.letInit >= 0 {
      if tyToEmitName(nodeTyIxOf(gd.letInit)) == want { return true }
    }
  }
  false
}

// The pin a module-block binding gives, or "" — its annotation, else its initializer's own
// answer. "" rather than a third fall-through state, so a candidate that names nothing
// cannot stop `monoArgTyName`'s ladder.
function monoModuleLetPin(letIx: i32, fnIx: i32) {
  const gd = P.nodes[letIx]
  if gd is LetDecl {
    if gd.letType >= 0 { return monoAnnPinName(tyNameOf(gd.letType)) }
    if gd.letInit >= 0 {
      const inner = monoArgTyName(gd.letInit, fnIx)
      if inner != "i32" { return inner }
    }
  }
  ""
}

// The pin for the call site `siteIx` when the module frame binds `name` in more than one
// block, or "". The first-wins table declines there; the candidate carrying the type the
// checker recorded for the site is the one it denotes, and a set of candidates that all pin
// one spelling has no disagreement left to decline over (D1598).
function monoModuleDupPin(name: string, fnIx: i32, siteIx: i32) {
  if !monoModuleNameVisible(name, fnIx) { return "" }
  const cands: i32[] = []
  moduleLocalLetAll(emitRootIx, name, cands)
  if cands.length < 2 { return "" }
  const want = tyToEmitName(nodeTyIxOf(siteIx))
  let i = 0
  while i < cands.length {
    if monoModuleLetTyIs(cands[i], want) {
      const dp = monoModuleLetPin(cands[i], fnIx)
      if dp != "" { return dp }
    }
    i = i + 1
  }
  const agreed = monoModuleLetPin(cands[0], fnIx)
  if agreed == "" { return "" }
  let j = 1
  while j < cands.length {
    if monoModuleLetPin(cands[j], fnIx) != agreed { return "" }
    j = j + 1
  }
  agreed
}

// The one home for "which annotation name can serve as a monomorphization pin". Both
// callers exist because mid-mono the `expr*` rep cascade cannot classify a binding at
// all (`buildLocals` is post-mono), so the annotation is the only truth; both sit behind
// `fnIx >= 0`. "" means no pin from the annotation, and the cascade answers instead.
function monoAnnPinName(name: string) {
  const r = monoStructAnnName(name)
  if r != "" { return r }
  // A union-typed annotation (`a: Cat | Dog`, or an alias): bind `T` to the union name
  // so the instance's param and return ride the union box. The union key answers; an
  // alias keys as the member set its declaration's row records.
  if isUName(name) { return name }
  // …and its list rung (D1082): `isUName` is false for an array name, so `first<T>(xs:
  // T[])` over a `const xs: Shape[]` had no arm at all. The pin is the caller's own
  // spelling, safe because the same program through a non-generic `firstS` runs.
  if nameIsArray(name) {
    if isUName(arrElemNameRaw(name)) { return name }
  }
  // A declared union arm (`Circle` in `type Shape = Circle | Sq`) — the kind-8 variant,
  // whose slot is `(ref $uVarHeap[vi])`. `monoStructAnnName` declines it (no struct row)
  // and `isUName` declines it (an arm is not the union), so without this rung the
  // `"i32"` catch-all declares an i32 parameter over a `(ref $type)` value (D23).
  if variantIndexOf(name) >= 0 { return name }
  // …and the list rung of that same arm (D37). `monoStructAnnName`'s list rung asks
  // `isSName("Circle")` and `variantIndexOf("Circle[]")` is false for an array name, so
  // `Circle[]` is claimed by neither. The pin is again the caller's own spelling.
  if nameIsArray(name) {
    if variantIndexOf(arrElemNameRaw(name)) >= 0 { return name }
  }
  // A bare inline object shape (`{r: i32}`). `isSName` cannot answer by construction:
  // `internInlineShapeTy` dedups an inline shape onto the declared row of that layout and
  // pushes no `sNames` entry (D53). After the variant arms and before the map arm, since
  // `nameIsShapeSpanEnds` is brace-span-not-second and a map spelling stays below.
  if nameIsShapeSpanEnds(name) { return name }
  const rl = monoCompositeListAnnName(name)
  if rl != "" { return rl }
  // A literal-union alias array (`K[]`), the array sibling of the `isUName` arm above and
  // subsumed by the union-alias list rung at the top of this ladder (D1082) — a litunion
  // alias is in `unNames` too. Kept as the rung whose absence a whole family witnessed.
  if nameIsArray(name) {
    const luElem = arrElemNameRaw(name)
    const luTy = if luElem != "" && isUName(luElem) { cUserTypes.get(luElem) ?? -1 } else { -1 }
    if luTy >= 0 && tyIsLitUnion(luTy) { return name }
  }
  // A `boolean[]` annotation. Its rep is the i32 list exactly (`nameIsI32Array`), so the
  // cascade cannot spell it and the pin has to be a name. Only a genuine `boolean` leaf
  // is claimed; the other i32-backed list spellings keep the cascade's answer.
  if arrElemIs(name, "boolean") { return name }
  // A bare map or Set annotation (`{[K]: V}`). The pin is the whole spelling, character
  // for character what `nodeTyMapName` hands the cascade, so the annotation channel and
  // the recorded-type channel name one instance and cannot mint two. A map-first union is
  // a variant box, and `nameIsBareMap` is the one home of that subtraction.
  if nameIsBareMap(name) { return name }
  // A canonical scalar or scalar-list annotation. The cascade reaches these through the
  // checker's recorded type or a `param*` probe, and both go blind in one position: a
  // generic body's own binding, whose `const y: T = x` carries the substituted annotation
  // and no recorded type while `buildLocals` has yet to run.
  const rs = monoScalarAnnName(name)
  if rs != "" { return rs }
  // A nullable spelling, whose `| null` the pin has to carry.
  monoNulAnnName(name)
}

// The pin of an instance's own list-union annotation `name` that no row holds yet: the pin
// substituted `V[] | i32[]` to `string[] | i32[]` after `collectU` ran, so it is registered
// here, as a pinned return is, else "". `ty` is the annotation's recorded type (D4931).
function monoInstUnionAnnPin(name: string, ty: i32): string {
  if !tyIsListUnion(ty) { return "" }
  const c = monoPinUnionName(name)
  if monoRegisterPinUnion(c, ty) < 0 { return "" }
  monoAnnPinName(c)
}

// A nullable annotation whose non-null base is a spelling `monoAnnPinName` already
// claims, echoed back whole — else "". The nullability rides the pin because the pin is
// the instance's parameter annotation, while every other channel answers about the rep,
// whose nullable is its non-null base by design. The base must echo back unchanged.
function monoNulAnnName(name: string) {
  const base = nullablePartOf(name)
  if base == "" { return "" }
  if monoAnnPinName(base) == base { return name }
  ""
}

// A canonical scalar-rep annotation spelling (`i32` / `i64` / `f32` / `f64` / `boolean`
// / `string`) or a list over one, or `u8[]`, echoed back — else "". Exact spellings only:
// the pin becomes the instance's parameter annotation, so a name that is not already the
// rep's own spelling would rename the rep. A bare `u8` is storage and never a pin.
function monoScalarAnnName(name: string) {
  let leaf = name
  if nameIsArray(name) { leaf = arrElemNameRaw(name) }
  if leaf == "i32" { return name }
  if leaf == "i64" { return name }
  if leaf == "f32" { return name }
  if leaf == "f64" { return name }
  if leaf == "boolean" { return name }
  if leaf == "string" { return name }
  if leaf == "u8" && leaf != name { return name }
  // A vector pins bare only: a list of them has no rep.
  if leaf == "v128" && leaf == name { return name }
  ""
}

// The annotation name of an annotated local or parameter whose type is a list over a
// composite element — a nested list, a paren group, an inline shape — or "". The
// `expr*` cascade cannot name these: it reads the expression, and mid-mono the locals
// table is unbuilt, so a nested list pins one dimension short of the checker's type.
function monoCompositeListAnnName(name: string) {
  if !nameIsArray(name) { return "" }
  const elem = arrElemNameRaw(name)
  if elem == "" { return "" }
  if nameIsArray(elem) { return name }
  if nameIsParenSpanEnds(elem) { return name }
  if nameIsBraceSpanEnds(elem) { return name }
  ""
}

// True when the type-annotation node `annIx` is a function-value pin in either spelling
// `monoArgTyName` mints — the bare closure's `$fnsig` marker, or a nullable function
// type. One predicate, so the gate, the name and the banked type agree.
function monoAnnIsCloPin(annIx: i32) {
  if annIx < 0 { return false }
  if sigKeyPinPayload(tyNameOf(annIx)) != "" { return true }
  tyNulFuncInner(nodeTyIxOf(annIx)) >= 0
}

// The type-annotation node of a binding of `fnIx` whose annotation is already a
// monomorphized function-value pin, or -1. The node rather than the name, because both
// halves of the pin live on it: `tyNameOf` is the instance-key spelling and `nodeTyIxOf`
// the `TyFunc` the outer instantiation banked. Param before local; a forwarder has both.
function monoCloPinAnnNodeOf(identName: string, fnIx: i32): i32 {
  if fnIx < 0 { return -1 }
  const ptn = paramTypeNode(fnIx, identName)
  if monoAnnIsCloPin(ptn) { return ptn }
  const ctxFn = P.nodes[fnIx]
  if ctxFn is FuncDecl {
    const li = parentLetOf(ctxFn.fnBody, identName)
    if li >= 0 {
      const ld = P.nodes[li]
      if ld is LetDecl {
        if monoAnnIsCloPin(ld.letType) { return ld.letType }
      }
    }
  }
  -1
}

// `monoCloPinAnnNodeOf` over an EXPRESSION — the Ident unwrap, in one place, so the gate
// and the type-banking helper below cannot ask the question of different nodes.
function monoCloPinAnnNodeOfExpr(ax: i32, fnIx: i32): i32 {
  if ax < 0 { return -1 }
  const n = P.nodes[ax]
  if n is Ident { return monoCloPinAnnNodeOf(n.identName, fnIx) }
  -1
}

// The arena type to bank beside the pin `monoArgTyName` chose for `ix` — the argument's
// own recorded type, except where the pin came from a binding's annotation, in which case
// it is that annotation's type. One home for the `pinTys` entry, so a pin's name and type
// can never be sourced from two different nodes.
export function monoArgPinTyIx(ix: i32, fnIx: i32) {
  const ax = unwrapParen(ix)
  const own = nodeTyIxOf(ax)
  // The node's own recorded type wins wherever it already names a function value (bare
  // or nullable); the annotation channel exists only for the clone whose node carries `T`.
  if own >= 0 && nodeTyIsFunc(ax) { return own }
  if tyNulFuncInner(own) >= 0 { return own }
  const pn = monoCloPinAnnNodeOfExpr(ax, fnIx)
  if pn >= 0 { return nodeTyIxOf(pn) }
  own
}

// True when the spelling `narrow` is a top-level member of the union or nullable spelling
// `wide` — what `wide` narrows to, and not a second rendering of it. Membership is the
// whole safety property of the narrowed pin. `unionArmsOf` resolves an alias to its
// member set; a non-union splits to one atom and is declined. See DECISIONS.md.
function monoNameNarrowsFrom(narrow: string, wide: string) {
  if narrow == "" { return false }
  if narrow == wide { return false }
  if nullablePartOf(wide) == narrow { return true }
  const arms: string[] = []
  unionArmsOf(wide, arms)
  if arms.length < 2 { return false }
  let ai = 0
  while ai < arms.length {
    if arms[ai] == narrow { return true }
    ai = ai + 1
  }
  false
}

// Whether `narrow` is a niche-repped `boolean | null` or `string | null` whose arms are all arms
// of the union `wide`: the argument's read converts the box to that niche, so the pin is it (D2590).
function monoNicheNarrowsFrom(
  narrow: string,
  narrowTy: i32,
  wide: string,
): boolean {
  const base = nullablePartOf(narrow)
  if base != "boolean" && base != "string" { return false }
  monoArmsNarrowFrom(narrow, narrowTy, wide)
}

// Whether every arm of the union `narrow` (arena type `narrowTy`) is an arm of the wider `wide`.
function monoArmsNarrowFrom(
  narrow: string,
  narrowTy: i32,
  wide: string,
): boolean {
  if narrow == wide { return false }
  const na: string[] = []
  unionArmsOfTy(narrow, narrowTy, na)
  const wa: string[] = []
  unionArmsOf(wide, wa)
  if wa.length <= na.length { return false }
  let i = 0
  while i < na.length {
    let hit = false
    let j = 0
    while j < wa.length {
      if wa[j] == na[i] { hit = true }
      j = j + 1
    }
    if !hit { return false }
    i = i + 1
  }
  true
}

// Whether arena type `ty` renders with more than one top-level arm: a union or a nullable.
function monoTyIsUnionShaped(ty: i32): boolean {
  if ty < 0 { return false }
  const t = T.tys[ty]
  t is TyUnion || t is TyNullable
}

// The pin a narrowed argument at `ax` wants, given the pin `wide` the annotation ladder
// chose — else "" (the ladder's answer stands). A pin becomes the instance's parameter
// annotation, so it is safe exactly where a non-generic function carrying that annotation
// already lowers the same program. DECISIONS.md has the channel ruling.
function monoNarrowedPinName(ax: i32, fnIx: i32, wide: string) {
  if wide == "" { return "" }
  let nt = nodeTyIxOf(ax)
  // A generic body records a read narrowed to one list as `T[]`, which the pins name.
  if nt >= 0 && tyHasTyVar(nt) {
    const ps = pinSubOperandTyOf(nt, fnIx)
    if ps >= 0 { nt = ps }
  }
  // A type whose render softens its literals is not a name this test can compare: it
  // reaches the membership test looking like a match on both sides, and the pin then
  // drops from the interned atom to a string ref. `tyRenderSoftensLits` is the home for
  // that hazard, and a litunion argument's pin is claimed by the litunion rungs anyway.
  if tyRenderSoftensLits(nt) { return monoNarrowedLitPinName(nt, wide) }
  const n = tyToEmitName(nt)
  if monoNameNarrowsFrom(n, wide) || monoNicheNarrowsFrom(n, nt, wide) {
    if monoAnnPinName(n) == n { return n }
    return ""
  }
  // A union narrowed to a smaller union of its own arms, which no row may hold yet (D4965).
  // A type that is no union has one arm, which the membership test above already asked.
  if monoTyIsUnionShaped(nt) && monoArmsNarrowFrom(n, nt, wide) {
    const nu = monoInstUnionAnnPin(n, nt)
    if nu != "" { return nu }
  }
  // The NOMINAL spelling of the same arm: the two sides of the membership test render
  // differently, since `tyToEmitName` spells a narrowed object structurally (`{r:i32}`)
  // while a union carries its arms' declared names, so the test missed on the SPELLING and
  // not on the type. This is the equality the variant tables are built under (D1754).
  const nom = nominalStructNameOfTy(nt)
  if nom == "" { return monoNarrowedNulRecPinName(nt, n, wide) }
  if !monoNameNarrowsFrom(nom, wide) { return "" }
  if monoAnnPinName(nom) != nom { return "" }
  nom
}

// The narrowed pin of a nullable record (`Circle | null` out of `Circle | string | null`): its
// render `n`, when the record's nominal name and `null` are both arms of `wide`, which the
// whole-spelling membership test above cannot see (D3099). "" otherwise.
function monoNarrowedNulRecPinName(nt: i32, n: string, wide: string): string {
  if nt < 0 { return "" }
  const t = T.tys[nt]
  if t is TyNullable {
    const inom = nominalStructNameOfTy(t.nInner)
    if inom == "" { return "" }
    // `wide` already `Circle | null` is no wider: the ladder's answer stands.
    if nullablePartOf(wide) == inom { return "" }
    if !monoNameNarrowsFrom(inom, wide) { return "" }
    if !monoNameNarrowsFrom("null", wide) { return "" }
    if monoAnnPinName(n) == n { return n }
  }
  ""
}

// The narrowed pin of a literal-union argument: its alias, when that alias is a member of the
// union `wide` the ladder chose, so `T` pins at the atom the checker typed the argument at,
// not at the box that holds it (D3098). "" otherwise.
function monoNarrowedLitPinName(nt: i32, wide: string): string {
  const kn = litUnionAliasNameOfTy(nt)
  if kn == "" { return "" }
  if !monoNameNarrowsFrom(kn, wide) { return "" }
  if monoAnnPinName(kn) != kn { return "" }
  kn
}

// The pin of a `for-in` variable read at `ix` in frame `fnIx` that the checker typed as a
// nominal record: the record's name, or "" for any other read.
function monoLoopVarRecordPin(ix: i32, fnIx: i32): string {
  if ix < 0 { return "" }
  const n = P.nodes[ix]
  if !(n is Ident) { return "" }
  if readLoopNodeOf(ix, n.identName, fnIx) < 0 { return "" }
  const nom = nominalStructNameOfTy(nodeTyIxOf(ix))
  if nom == "" { return "" }
  monoAnnPinName(nom)
}

// The union name a pin can carry for the node at `ix`, or "". The render, then the
// registry: `tyToEmitName` spells a declared alias as its member set while
// `monoAnnPinName`'s `isUName` rung reads the alias's key, so `unRowOfCanon` keys the
// registry on the type's canonical id instead of on a spelling. D1516.
function monoUnionPinName(ix: i32): string {
  const ty = nodeTyIxOf(ix)
  if ty < 0 { return "" }
  const r = monoAnnPinName(tyToEmitName(ty))
  if r != "" { return r }
  const ur = unRowOfCanon(ty)
  if ur >= 0 && ur < unNames.length { return monoAnnPinName(unNames[ur]) }
  // An inferred value union nothing spells (an if-expression argument's join) has no row
  // until a pin mints one, as a binding of the same join registers its own (D2824).
  const vn = valueUnionRetName(ty)
  if vn != "" && monoRegisterPinUnion(vn, ty) >= 0 {
    const vr = monoAnnPinName(vn)
    if vr != "" { return vr }
  }
  monoNulUnionPinName(ty)
}

// The `T | null` half of the question above, and the one arm whose pin the membership list
// cannot supply. A nullable value union renders FLAT (`i32|string|null`): the registry keys
// the union and not its nullable, and `nullablePartOf` splits exactly two parts so no rung
// peels the `null` off it — while the ARENA holds both halves (D1882).
function monoNulUnionPinName(ty: i32): string {
  const t = T.tys[ty]
  if t is TyNullable {
    if t.nInner < 0 { return "" }
    // The arena's own union row under the null is what makes the pin safe: it is the same
    // registered union an annotated parameter names, so the instance lowers the program a
    // non-generic function carrying that annotation already lowers.
    if unRowOfCanon(t.nInner) < 0 { return "" }
    // And the pin is the FLAT render, not `<alias>|null`. The alias spelling gives the
    // instance the right cell and no unbox: `unionNameOfIdentSid` answers on the flattened
    // member set alone, which is what canon writes for an annotated `V | null`.
    return tyToEmitName(ty)
  }
  ""
}

// The pin an argument wants when the ladder answered only the non-null part of the
// `T | null` the checker recorded for it — an else-less `if`, whose ladder answer is the
// `then` arm while the join carries the null, or a nullable read. Delivering that at the
// non-null spelling puts a `(ref null $H)` in a `(ref $H)` cell (D1766).
function monoNicheWidenedPinName(ax: i32, chosen: string): string {
  if chosen == "" { return "" }
  const nt = nodeTyIxOf(ax)
  if nt < 0 { return "" }
  const n = tyToEmitName(nt)
  if n == "" { return monoElemlessNulListPinName(nt, chosen) }
  if n == chosen { return "" }
  if nullablePartOf(n) != chosen { return "" }
  if monoAnnPinName(n) != n { return "" }
  n
}

// The widened pin of an element-less `[] | null`, which has no render: nothing decided its
// element, so the ladder `chosen` is the default `i32[]` and the pin keeps the `null` (D6120).
function monoElemlessNulListPinName(nt: i32, chosen: string): string {
  if nt < 0 || nt >= T.tys.length || chosen != "i32[]" { return "" }
  const t = T.tys[nt]
  if !(t is TyNullable) || t.nInner < 0 || t.nInner >= T.tys.length {
    return ""
  }
  const l = T.tys[t.nInner]
  if !(l is TyArray) || l.aElem >= 0 { return "" }
  if monoAnnPinName("i32[]|null") != "i32[]|null" { return "" }
  "i32[]|null"
}

// The pin an un-annotated list binding takes from the declared union-element destination its
// literal is built for (`letRefListDestSlot`), or "": its checked type names the literal's own
// element, and an instance pinned there would receive the destination's list (D2747).
function monoDestListPinName(letIx: i32, fnIx: i32): string {
  if monoDestPinOff { return "" }
  const s = letRefListDestSlot(letIx, fnIx)
  if s < 0 || s >= rlElemName.length { return "" }
  let en = rlElemName[s]
  if s < rlElemTyIx.length {
    const ur = unRowOfCanon(rlElemTyIx[s])
    if ur >= 0 && ur < unNames.length { en = unNames[ur] }
  }
  if en == "" { return "" }
  monoAnnPinName(en + "[]")
}

// `monoDestListPinName` of the binding a closure at `fnIx` captures as `name`: the nearest
// enclosing frame's `let`, or "" once a frame binds the name as a parameter.
function monoCapturedDestListPin(name: string, fnIx: i32): string {
  let pp = fnStmtsPosOf(fnIx)
  let steps = 0
  while pp >= 0 && pp < fnParent.length && steps < 64 {
    pp = fnParent[pp]
    if pp < 0 || pp >= fnStmts.length { return "" }
    const fx = fnStmts[pp]
    const fn = P.nodes[fx]
    if fn is FuncDecl {
      const li = parentLetOf(fn.fnBody, name)
      if li >= 0 { return monoDestListPinName(li, fx) }
      if paramIndexOf(fx, name) >= 0 { return "" }
    }
    steps = steps + 1
  }
  ""
}

// The annotation pin of the enclosing frame's PARAMETER a closure at `fnIx` captures as `name`,
// or "" once a frame binds it as a local. A lambda lifted out of an instance reads its capture
// at the instance's substituted annotation, as a direct call in the instance's body does (D3063).
function monoCapturedParamPin(name: string, fnIx: i32): string {
  let pp = fnStmtsPosOf(fnIx)
  let steps = 0
  while pp >= 0 && pp < fnParent.length && steps < 64 {
    pp = fnParent[pp]
    if pp < 0 || pp >= fnStmts.length { return "" }
    const fx = fnStmts[pp]
    const fn = P.nodes[fx]
    if fn is FuncDecl {
      if parentLetOf(fn.fnBody, name) >= 0 { return "" }
      if paramIndexOf(fx, name) >= 0 {
        const ptn = paramTypeNode(fx, name)
        if ptn < 0 { return "" }
        const pt = P.nodes[ptn]
        if pt is TypeRef { return monoAnnPinName(pt.tyName) }
        return ""
      }
    }
    steps = steps + 1
  }
  ""
}

// Whether shape spelling `sp` resolves to no row or to an anonymous one. A declared record
// sharing its field names can claim it by the lenient field-set scan, and then the instance
// would read the argument at that record's layout (D3123).
function monoSpelledShapeStaysAnon(sp: string): boolean {
  const si = structIndexOfTypeName(sp)
  if si < 0 || si >= sNames.length { return true }
  const nm = sNames[si]
  nm.length >= 5 && nm.slice(0, 5) == "#anon"
}

// Composite annotation `ann` substituted with each `#anonN` binding spelled by its row's shape,
// where that shape resolves back to the same row, else `pinC`. A handle inside a record spelling
// resolves to nothing, and the field-set scan then claims a declared record (D3144).
function monoSubstAnonShapes(
  ann: string,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  pinC: string,
): string {
  const vs: string[] = []
  let changed = false
  let i = 0
  while i < tvV.length {
    let v = tvV[i]
    if v.length >= 5 && v.slice(0, 5) == "#anon" {
      const rt = anonHandleTyIx(v)
      if rt >= 0 && !tyHasTyVar(rt) {
        const sp = tyToEmitName(rt)
        if (
          sp != ""
          && monoSpelledShapeStaysAnon(sp)
          && structIndexOfTypeName(sp) == structIndexOfTypeName(v)
        ) {
          v = sp
          changed = true
        }
      }
    }
    vs.push(v)
    i = i + 1
  }
  if !changed { return pinC }
  const sub = monoSubstAnn(ann, typarams, tvN, vs)
  if sub == "" { return pinC }
  sub
}

// Whether the spelled shape of record argument `argIx`, typed `ty`, loses a literal: a literal
// anywhere in the type, or in a field of the literal it is, whose own type may have widened one.
function monoAnonArgSoftens(argIx: i32, ty: i32): boolean {
  if tyHasLitDeep(ty, 8) { return true }
  const ax = unwrapParen(argIx)
  if ax < 0 { return false }
  const o = P.nodes[ax]
  if !(o is ObjLit) { return false }
  let i = 0
  while i < o.objFields.length {
    const f = P.nodes[o.objFields[i]]
    if f is FieldInit {
      if tyHasLitDeep(nodeTyIxOf(unwrapParen(f.fiValue)), 8) { return true }
    }
    i = i + 1
  }
  false
}

// `monoArgTyName` at a monomorphization pin — the ladder's answer, narrowed to what the
// checker recorded for this node where that is one of the annotation's own members.
// Separate from `monoArgTyName` because `wasmEmit`'s `monoStaticIsResult` also asks that
// one and const-folds on it; narrowing there would fold a guard this pass cannot decide.
function monoArgPinName(ix: i32, fnIx: i32) {
  const w = monoArgTyName(ix, fnIx)
  // A bare `null` typed by its destination (DV-402) pins the declared record's nullable name,
  // as a binding annotated with it does; its structural render would intern another row.
  if P.nodes[unwrapParen(ix)] is NullLit {
    const nn = nulRecNominalName(nodeTyIxOf(unwrapParen(ix)))
    if nn != "" { return nn }
  }
  // An argument the checker typed the `null` unit type pins it, the `nulnone` cell, whether a
  // bare `null` or a `null`-typed read; a `null[]` pins its own spelling, not the i32 list (D4687).
  if nodeTyIsNullType(unwrapParen(ix)) { return "null" }
  if nodeArrayElemIsNullUnit(unwrapParen(ix)) { return "null[]" }
  const n = monoNarrowedPinName(unwrapParen(ix), fnIx, w)
  if n != "" { return n }
  const wd = monoNicheWidenedPinName(unwrapParen(ix), w)
  if wd != "" { return wd }
  // A list of nullable records pins the declared struct's row its binding is interned under.
  const nrl = nulRecListNominalName(nodeTyIxOf(unwrapParen(ix)))
  if nrl != "" { return nrl }
  const drl = monoDeclRecListPinName(unwrapParen(ix), w)
  if drl != "" { return drl }
  w
}

// `S[]` for a list or `readonly` view argument whose element is declared record `S` itself and
// whose pin `w` is the floor's structural render of it, else "". The render softens literal
// fields and unfolds a recursive record, so its rows do not twin the declared ones (D3792). A
// view shares its list's rep and admits no wider row, so it pins the same (D3793).
function monoDeclRecListPinName(ax: i32, w: string): string {
  if ax < 0 { return "" }
  const ty = nodeTyIxOf(ax)
  if ty < 0 || w != tyToEmitName(ty) { return "" }
  const t = T.tys[ty]
  if !(t is TyArray) { return "" }
  const nm = structNameOfTy(tyArrayElemIx(ty))
  if nm == "" || structIndexOfTypeName(nm) < 0 { return "" }
  nm + "[]"
}

// Whether struct row `si` declares field `prop` nullable. A clone's `q.next` is recorded against
// the template's gradual `q`, so only the struct row knows the field is nullable (D3301).
function monoFieldDeclNullable(si: i32, prop: string): boolean {
  if si < 0 || si >= sTyIx.length { return false }
  const ft = tyFieldTyOf(sTyIx[si], prop)
  if ft < 0 || ft >= T.tys.length { return false }
  T.tys[ft] is TyNullable
}

// The initializer of the local an if-expression's then arm yields, when that local is declared
// in the arm's own prelude and the join's recorded type is still a type parameter, or -1.
function monoArmTailLocalInit(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = P.nodes[ix]
  if !(n is IfStmt) { return -1 }
  if !tyHasTyVar(nodeTyIxOf(ix)) { return -1 }
  if n is IfStmt {
    const b = P.nodes[n.ifThen]
    if b is Block {
      const k = b.blkStmts.length
      if k < 1 { return -1 }
      const tvIx = unwrapParen(b.blkStmts[k - 1])
      if tvIx < 0 { return -1 }
      // A tail that is itself an `if` yields its own then arm's local (D2825).
      const inner = monoArmTailLocalInit(tvIx)
      if inner >= 0 { return inner }
      const tv = P.nodes[tvIx]
      if tv is Ident {
        let i = k - 2
        while i >= 0 {
          const d = P.nodes[b.blkStmts[i]]
          if d is LetDecl {
            if d.letName == tv.identName { return d.letInit }
          }
          i = i - 1
        }
      }
    }
  }
  -1
}

// The pin spelling of type `ty`: an alias through the annotation ladder, as the hole rung
// spells it, else its render.
function monoI32AtomPinName(ty: i32): string {
  const an = monoAnnPinName(tyToEmitName(ty))
  if an != "" { return an }
  tyToEmitName(ty)
}

// The union pin of a `??` at `ix` whose recorded join is a value union, or "".
function monoCoalJoinPinName(ix: i32): string {
  if ix < 0 { return "" }
  const n = P.nodes[ix]
  if !(n is BinExpr) { return "" }
  if n.binOp != "??" { return "" }
  const t = nodeTyIxOf(ix)
  if t < 0 || !(T.tys[t] is TyUnion) || isValueUnionTyOr(t) != 1 { return "" }
  monoUnionPinName(ix)
}

// Whether `ix` is an `Ident` the checker resolved to a declaration other than a function's: a
// parameter, a binding or a loop variable, which shadows any function of its name.
function monoIdentReadsValue(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length || !(P.nodes[ix] is Ident) { return false }
  const d = identDeclOf(ix)
  if d < 0 || d >= P.nodes.length { return false }
  !(P.nodes[d] is FuncDecl)
}

// The rep rungs of `monoArgTyName`, after every binding and projection arm declined: the
// argument's own recorded type, then the collection, union, record and scalar cascades.
// `cax` is `ix` with its grouping parens peeled. "" is the loud floor, `"i32"` the last rung.
function monoArgTyNameRep(ix: i32, fnIx: i32, cax: i32): string {
  const lup = monoArgLitUnionPin(ix)
  if lup != "" { return lup }
  // An empty list literal has no element for the collection arms to read; the body's pushes
  // pinned its recorded row at the call (D2218). A record element no spelling names takes the
  // row its field set matches, and a pinned element neither names is the loud floor, since
  // the cascade below reads the literal and would pin `i32[]`.
  const ealN = P.nodes[cax]
  if ealN is ArrayLit {
    if ealN.arrElems.length == 0 && !tyHasTyVar(nodeTyIxOf(cax)) {
      const ealTy = nodeTyIxOf(cax)
      const ealPin = monoAnnPinName(tyToEmitName(ealTy))
      if ealPin != "" { return ealPin }
      const ealEl = tyRefArrElemOf(ealTy)
      const ealRow = structRowOfObjFieldSet(ealEl)
      if ealRow >= 0 { return sNames[ealRow] + "[]" }
      if ealEl >= 0 { return "" }
    }
  }
  // A map or Set argument pins its param as that map — the whole `{[K]:V}` spelling an
  // annotated parameter carries. Before the collection arms, since `exprArray`'s catch-all
  // would otherwise name a map an array; and its arm-nominal form first, since
  // `tyToEmitName` spells a declared union arm structurally and the two mint two (D88).
  const mnArm = nodeMapArmNominalName(unwrapParen(ix))
  if mnArm != "" { return mnArm }
  const mn = nodeTyMapName(unwrapParen(ix))
  if mn != "" { return mn }
  // The string twin of the arm above, blind in the same place for the same reason:
  // `exprString`'s Ident arm reads `declaredString`, a post-mono locals table.
  // `nodeTyIsStringPrim` reads the `TyPrim` variant and its `primName` directly, and being
  // `TyPrim`-only is the narrowing to watch — a literal union canon-softens to `string`.
  if nodeTyIsStringPrim(unwrapParen(ix)) { return "string" }
  // A `??` joining into a value union is built as that union's box; the string and scalar
  // rungs below would pin its left side's type.
  const cjp = monoCoalJoinPinName(cax)
  if cjp != "" { return cjp }
  if exprString(ix, fnIx) { return "string" }
  if exprStringArray(ix, fnIx) {
    // A `(string | null)[]` shares the string list's rep exactly, so the rep cascade cannot
    // spell it — and a pin is a NAME, not a rep. The arena's render is the pin, so a bare `T`
    // bound from this list keeps its `| null` and its parameter stays nullable (D1897).
    if nodeTyArrayElemIsNullable(unwrapParen(ix)) {
      const snp = monoAnnPinName(tyToEmitName(nodeTyIxOf(unwrapParen(ix))))
      if snp != "" { return snp }
    }
    return "string[]"
  }
  if exprF64Array(ix, fnIx) { return "f64[]" }
  // The i64 and f32 list arms sit beside the f64 one: the scalar cascade below already
  // names every scalar rep, so without these an `i64[]` / `f32[]` argument falls through
  // to `exprArray`'s catch-all and pins `i32[]`, emitting an instance whose functype reads
  // the i32 list while the caller hands it the i64 or f32 one.
  if exprI64Array(ix, fnIx) { return "i64[]" }
  if exprF32Array(ix, fnIx) { return "f32[]" }
  if exprU8Array(ix, fnIx) { return "u8[]" }
  if exprRefArray(ix, fnIx) {
    // A struct/union-element array: only a literal argument names its element type
    // cheaply; other shapes have no channel here.
    const nd = P.nodes[ix]
    if nd is ArrayLit {
      // A nested list literal over a `boolean` leaf: `arrLitElemName`'s nested-list
      // rung has no boolean member, so `[[true]]` pins `i32[][]`. `nodeTyName` renders
      // the checker's whole array type, which is the pin this site wants.
      const nlt = nodeTyName(ix)
      // The arena: two `TyArray` hops answer directly what two grammar cuts over a render
      // asked. The render is still the pin returned below; only the question moved.
      if nodeTyNestedElemIsBoolPrim(ix) { return nlt }
      // A spread copy pins the row it is built at, its source's (D2938).
      const spn = spreadLitSrcRowName(ix, fnIx)
      if spn != "" { return arrElemSuffixed(spn) }
      return arrElemSuffixed(arrLitElemName(ix))
    }
    // The arena, for every other shape: a call or projection reaches this floor with a type
    // the checker recorded and no literal to read an element off. The same question the
    // nullable-struct floor below asks, through the same membership list (D1755).
    const rap = monoAnnPinName(tyToEmitName(nodeTyIxOf(unwrapParen(ix))))
    if rap != "" { return rap }
    return ""
  }
  if exprArray(ix, fnIx) {
    // A `boolean[]` shares the i32 list rep exactly, so the rep cascade cannot spell it —
    // and a pin is a name, not a rep. The instance's parameter annotation is the only
    // boolean-ness left in a monomorphized body, and `listElemIsBool` recovers the print
    // formatting from it. Only a genuine `boolean` leaf: `tyArrayElemPrimName` is `TyPrim`-only.
    if nodeTyArrayElemIsBoolPrim(ix) { return "boolean[]" }
    return "i32[]"
  }
  if exprUnion(ix, fnIx) {
    // D1516 — the union floor owes the arena one question first, exactly as the struct
    // floor below already asks it: every arm above resolves a union from a binding, so a
    // projection has no channel at all. At the floor, so it re-pins nothing the ladder
    // resolved, and through `monoAnnPinName`, the one pin membership list.
    const upn = monoUnionPinName(unwrapParen(ix))
    if upn != "" { return upn }
    return ""
  }
  if exprNullableStruct(ix, fnIx) {
    // The nullable-struct floor owes the arena the same question D1516 gave the union floor
    // above it: every arm before this resolves a binding, so an if-expression or any other
    // projection reaches the floor with a type the checker recorded and no channel to spell
    // it. Through `monoAnnPinName`, the one pin membership list, so `""` still refuses (D1755).
    const nsp = monoAnnPinName(tyToEmitName(nodeTyIxOf(unwrapParen(ix))))
    if nsp != "" { return nsp }
    return ""
  }
  // The wider nullable, which the struct floor above does not claim: a map read (`m[k]` and
  // its `m.get(k)` spelling) is an i32-repped NICHE, so the scalar cascade below names the
  // non-null half and the instance's parameter loses its `| null`. Same question, same
  // membership list, one rung on (D1753).
  if nodeTyIsNullable(unwrapParen(ix)) {
    const nulPin = monoAnnPinName(tyToEmitName(nodeTyIxOf(unwrapParen(ix))))
    if nulPin != "" { return nulPin }
  }
  // A boxed union no binding arm resolves, a `for` walk's variable among them, pins at its
  // recorded union: the variant and scalar rungs below would pin one member's rep (D3071).
  if nodeTyIsUnionish(cax) && numLitUnionBaseName(nodeTyIxOf(cax)) == "" {
    const wun = monoUnionPinName(cax)
    if wun != "" { return wun }
  }
  // A walk variable the checker typed as a record: the struct and variant rungs below read its
  // rep from the locals table, which mid-mono has none, and would pin `i32` (D3139).
  const wrp = monoLoopVarRecordPin(cax, fnIx)
  if wrp != "" { return wrp }
  // The variant table, asked before the struct one. `collectS` skips a `type X = {…}` that
  // is a union member, so `type Shape = Circle | Sq` deletes `Circle`'s `sNames` row and
  // mints a variant row. `exprVariantIndex` is `structIndexOfExpr`'s storage-class twin,
  // arm for arm and each leg kind-gated, so the two cannot both answer (D57).
  const avi = exprVariantIndex(ix, fnIx)
  if avi >= 0 && avi < uVariants.length {
    const avn = monoAnnPinName(uVariants[avi])
    if avn != "" { return avn }
  }
  if exprStruct(ix, fnIx) {
    const si = structIndexOfExpr(ix, fnIx)
    if si >= 0 { return sNames[si] }
    // No `sNames` row, but a good spelling — the checker's recorded shape, routed through
    // the one pin membership list, which claims a bare inline object shape (D703). The row
    // goes missing because `collectS` skips a `type X = {…}` that is a union member. At the
    // floor, and `tyToEmitName` rather than `nodeTyName`: `tyToStr` flattens an alias field.
    const shp = monoAnnPinName(tyToEmitName(nodeTyIxOf(unwrapParen(ix))))
    if shp != "" { return shp }
    return ""
  }
  // f32 before f64 — the order `exprIsF32`'s own header states, and which every cell, slot
  // and assign ladder obeys. `exprIsF64` over-claims a mixed f32/float-literal argument
  // (`fv * 1.0` is both), so asking f64 first binds `T` to f64 and the f64 result reaches a
  // site that classifies the call f32. A genuine f64 operand still binds f64 here.
  if exprIsV128(ix, fnIx) { return "v128" }
  if exprIsF32(ix, fnIx) { return "f32" }
  if exprIsF64(ix, fnIx) { return "f64" }
  if exprIsI64(ix, fnIx) { return "i64" }
  if exprIsBool(ix, fnIx) { return "boolean" }
  // The `"i32"` catch-all is the defect, not the missing arm (D23): a cascade answering
  // `i32` for a rep it did not recognise mints a wrong instance silently, since the pin
  // becomes the instance's parameter annotation. `""` is the loud floor and beats a wrong
  // instance. Asked last, and narrow: a floor fires only where the answer would be `"i32"`.
  if exprNullableVariant(ix, fnIx) { return "" }
  if exprNullableRefArray(ix, fnIx) { return "" }
  "i32"
}

// The pin a litunion or litunion-list argument `ix` takes, "" for any other argument.
function monoArgLitUnionPin(ix: i32): string {
  // A declared litunion argument pins the parameter to the alias, ahead of the string and
  // scalar arms. For a litunion the spelling is the rep, and `litUnionAliasNameOfTy` names
  // the alias. Without this arm the pin loses the type entirely.
  const luTy = nodeTyIxOf(unwrapParen(ix))
  const luAl = litUnionAliasNameOfTy(luTy)
  if luAl != "" { return luAl }
  // The array sibling, and it has to sit here: the collection arms spell a litunion array by
  // its rep and `nameIsI32Array` accepts a litunion `K[]`, so `exprArray` pins `i32[]` and
  // binds every `T` mentioning the element to plain i32. See `monoAnnPinName`'s
  // litunion-array arm — the two channels must claim the same shape.
  const luIsArr = tyIsLitUnionArray(luTy)
  if luIsArr {
    const luArrT = T.tys[luTy]
    if luArrT is TyArray {
      const luElAl = litUnionAliasNameOfTy(luArrT.aElem)
      if luElAl != "" { return luElAl + "[]" }
    }
  }
  // An inline member set has no alias, so it, or a list of it (a one-member set's included),
  // pins at its kept spelling; without the rung the hole parameter carries a raw width (D1545).
  if luIsArr || tyIsLitUnion(luTy) {
    const luInl = tyToEmitName(luTy)
    if luInl != "" { return luInl }
  }
  // A lone string literal with no alias is a string value, so an atom-repped one (a literal
  // field read) pins the `string` instance and widens at the call (D7440).
  if tyIsOneStrLit(luTy) { return "string" }
  ""
}

// A projected union's pin at the name of the union row its canon matches, the spelling an
// annotated parameter or a call return pins at, or "" when the union has no row. The checker
// types a projection structurally, so its render keys no row or pool set (D5380). A type that
// names a type parameter or hole is read through the enclosing instance's pins first.
function monoProjectedUnionRowPin(cax: i32, fnIx: i32): string {
  let ty = nodeTyIxOf(cax)
  if ty < 0 { return "" }
  if tyHasTyVar(ty) {
    ty = monoPinSubTyOf(ty, fnIx)
    if ty < 0 || ty >= T.tys.length { return "" }
    if tyHasTyVar(ty) || tyIsLitUnion(ty) { return "" }
    const st = T.tys[ty]
    if !(st is TyUnion) { return "" }
    if st.uMembers.length < 2 { return "" }
  } else if !nodeTyIsUnionish(cax) {
    return ""
  }
  const ur = unRowOfCanon(ty)
  if ur < 0 || ur >= unNames.length { return "" }
  monoAnnPinName(unNames[ur])
}

// The projection rungs of `monoArgTyName`: an indexed element and a record field, named
// from the pin of what they project. Falls to `monoArgTyNameRep` where neither answers.
function monoArgTyNameProjected(ix: i32, fnIx: i32, cax: i32): string {
  const argN = P.nodes[unwrapParen(ix)]
  // An indexed element argument (`id(xs[0])`): the array's own name resolves above through
  // the annotation arms, and the element is that name minus one `[]`. The element goes
  // through `monoAnnPinName`, the same home the array is named through — the two ends of
  // one cut must claim the same spelling set. The peel is `listElemNameOf`.
  if argN is Index {
    // An element of a captured list: its recorded type, or the enclosing instance's pin of the
    // type parameter it names, where the capture's own name rungs know only its default (D3831).
    const cl = P.nodes[unwrapParen(argN.idxArr)]
    if cl is Ident && fnIx >= 0 {
      if monoNameIsCapture(fnIx, cl.identName) {
        let ep = nodeTyIxOf(unwrapParen(ix))
        // The cell of a written capture is read through an index the rewrite minted untyped.
        if ep < 0 { ep = tyArrayElemIx(nodeTyIxOf(unwrapParen(argN.idxArr))) }
        if ep >= 0 && tyHasTyVar(ep) { ep = monoPinSubTyOf(ep, fnIx) }
        if ep >= 0 && !tyHasTyVar(ep) && !tyIsLitUnion(ep) {
          const en = monoAnnPinName(monoPinAnnSpelling(ep))
          if en != "" { return en }
        }
      }
    }
    const eur = monoProjectedUnionRowPin(cax, fnIx)
    if eur != "" { return eur }
    // The array NAME cannot carry a literal-union element: such an array reps as the
    // interned-atom i32 list, so an INFERRED one is named `i32[]` and this arm would pin the
    // atom's raw width. The element's own recorded type is exact, so it is left to the litunion
    // rungs below, which spell an alias and an inline set apart (D1756).
    if !tyIsLitUnion(nodeTyIxOf(unwrapParen(ix))) {
      const arrTy = monoArgTyName(argN.idxArr, fnIx)
      const an = arrTy.length
      if an >= 3 && nameIsArray(arrTy) {
        const r = monoAnnPinName(listElemNameOf(arrTy))
        if r != "" { return r }
      }
    }
  }
  // A struct-field argument (`id(o.inner)`): resolve the receiver's struct from its
  // annotation, then read the field's struct type name off the struct table (a
  // nested-struct field is code 15, whose `sFieldElemName` is its target struct name).
  // `structIndexOfExpr(o.inner)` would default to i32, the locals table being unbuilt.
  if argN is Member {
    const recvTy = monoArgTyName(argN.memObj, fnIx)
    let rsi = structIndexByName(recvTy)
    // A nullable receiver is read only where it is narrowed, so its record is the base's.
    if rsi < 0 && nullablePartOf(recvTy) != "" {
      rsi = structIndexByName(nullablePartOf(recvTy))
    }
    if rsi >= 0 {
      const fi = sFieldIndex(rsi, argN.memProp)
      if fi >= 0 && sFieldTypeAt(rsi, fi) == FC_STRUCT {
        const fnm = sFieldElemNameAt(rsi, fi)
        // A nullable record field shares code 15 with a bare one; its pin keeps the `| null`
        // the field declares, or the instance's parameter is non-null and the call casts (D3301).
        if (
          isSName(fnm)
          && (nodeTyIsNullableStruct(cax)
            || monoFieldDeclNullable(rsi, argN.memProp))
        ) {
          return monoAnnPinName(fnm + "|null")
        }
        if isSName(fnm) { return fnm }
      }
    }
    // D1516 — the union-valued field, whose companion column is a member set rather than a
    // struct name, so the code-15 rung above cannot carry it. Asked here, gated to a union
    // so no struct / list / scalar pin is touched, and through `monoAnnPinName` so the
    // answer is a spelling an annotated parameter already lowers.
    const fur = monoProjectedUnionRowPin(cax, fnIx)
    if fur != "" { return fur }
    if nodeTyIsUnionish(cax) {
      const mun = monoUnionPinName(cax)
      if mun != "" { return mun }
    }
  }
  monoArgTyNameRep(ix, fnIx, cax)
}

// The binding rungs of `monoArgTyName`: a call argument's callee return, then an `Ident`
// argument's local, captured, parameter or module binding. "" refuses; falls to
// `monoArgTyNameProjected` where none answers.
function monoArgTyNameBound(ix: i32, fnIx: i32, cax: i32): string {
  // A call argument whose callee has a concrete return annotation takes that annotation.
  // Needed for a generic call used as an argument (`box(box(7))`): `buildFnMap` is
  // post-mono, so `exprStruct` cannot classify the inner call and the type param would
  // default to i32. The instance's already-substituted return annotation resolves it.
  const argN = P.nodes[unwrapParen(ix)]
  if argN is Call {
    const argCallee = P.nodes[argN.callFn]
    if argCallee is Ident {
      // Scope-aware, as the closure pin above: a nested namesake is not the flat map's first.
      const acx = argN.callFn
      let acfe = fnIndexOfInScopeAt(
        sidOfNode(acx),
        argCallee.identName,
        fnIx,
        acx,
      )
      if acfe < 0 { acfe = fnIndexOfAt(sidOfNode(acx), fnIx, acx) }
      if acfe >= 0 {
        const acfn = P.nodes[fnStmts[acfe]]
        if acfn is FuncDecl {
          if acfn.fnRet >= 0 {
            // The declared spelling again — this arm tells a concrete return from a
            // parametric one, and a shadowed parameter reads as concrete once canon
            // has resolved it.
            const arn = monoDeclAnnName(
              acfn.fnRet,
              tyNameOf(acfn.fnRet),
              acfn.fnTyParams,
            )
            if arn != "" && !monoAnnHasTyParam(arn, acfn.fnTyParams) {
              return arn
            }
          } else {
            // …and an inferred return is as good a pin as an annotated one:
            // `inferRetNameOf` is the checker's own record, routed through
            // `monoAnnPinName` so the pin is one that ladder claims.
            const irn = inferRetNameOf(
              inferRetFnKey(fnStmts[acfe], argCallee.identName),
            )
            if irn != "" {
              const irp = monoAnnPinName(irn)
              if irp != "" { return irp }
            }
          }
        }
      }
    }
  }
  // An Ident argument bound to a generic-call result (`const inner = box(7); box(inner)`):
  // resolve via its un-annotated `let` init, the local's type table being unbuilt mid-mono.
  // Only a resolved non-i32 type is adopted; a param or non-let ident falls through.
  if argN is Ident {
    if fnIx >= 0 {
      const ctxFn = P.nodes[fnIx]
      if ctxFn is FuncDecl {
        const li = parentLetOfAt(ctxFn.fnBody, sidOfNode(cax), cax)
        if li >= 0 {
          const ld = P.nodes[li]
          if ld is LetDecl {
            // A struct- or struct-array-typed annotated local: read its annotation
            // name directly. `buildLocals` is post-mono, so the `exprStruct` and
            // `exprRefArray` cases below would default the type param to i32.
            if ld.letType >= 0 {
              // A composite-element list local (`xs: i32[][]`, `(i32|null)[]`) is
              // among the spellings `monoAnnPinName` claims: the cascade below either
              // declines it or answers one dimension short.
              const r = monoAnnPinName(tyNameOf(ld.letType))
              if r != "" { return r }
              const ru = monoInstUnionAnnPin(
                tyNameOf(ld.letType),
                nodeTyIxOf(ld.letType),
              )
              if ru != "" { return ru }
            }
            if ld.letType < 0 && ld.letInit >= 0 {
              const ldp = monoDestListPinName(li, fnIx)
              if ldp != "" { return ldp }
              // An empty list literal has no element for the recursion to read, and
              // the recursion answers anyway (D764). The checker pinned the binding
              // from its destination, so read the argument reference's recorded type.
              const eln = P.nodes[ld.letInit]
              if eln is ArrayLit {
                if eln.arrElems.length == 0 {
                  const epn = monoAnnPinName(tyToEmitName(nodeTyIxOf(cax)))
                  if epn != "" { return epn }
                }
              }
              const innerTy = monoArgTyName(ld.letInit, fnIx)
              if innerTy != "" && innerTy != "i32" { return innerTy }
              // A refusal propagates: `""` here is one of this ladder's explicit
              // floors, and falling through hands the question back to a cascade that
              // is post-mono blind for a local and answers `"i32"`.
              if innerTy == "" { return "" }
            }
          }
        }
        if li < 0 && paramIndexOf(fnIx, argN.identName) < 0 {
          const cdp = monoCapturedDestListPin(argN.identName, fnIx)
          if cdp != "" { return cdp }
          const cpp = monoCapturedParamPin(argN.identName, fnIx)
          if cpp != "" { return cpp }
        }
      }
      // A struct-typed param argument (`g(v)` inside a generic body where `v: P`): same as
      // the annotated-local case — read the param annotation, the locals table being unbuilt.
      const ptn = paramTypeNode(fnIx, argN.identName)
      if ptn >= 0 {
        const pt = P.nodes[ptn]
        if pt is TypeRef {
          // The annotated-local arm's param twin — a generic body passing its own
          // `xs: i32[][]` / `boolean[]` / `P` parameter on to a second generic call, the
          // shape a generic forwarder has. One home, so the two cannot drift.
          const r = monoAnnPinName(pt.tyName)
          if r != "" { return r }
          const ru = monoInstUnionAnnPin(pt.tyName, nodeTyIxOf(ptn))
          if ru != "" { return ru }
        }
      }
    }
    // The module-scope twin of the two arms above, arm for arm. `parentLetOf` is
    // function-scoped and every arm above sits behind `fnIx >= 0`, so a generic call whose
    // argument is a top-level binding reaches none of them; `monoModuleLetOf` declines on a
    // shadow test rather than on `fnIx >= 0`, so a global is readable inside a function too.
    const gli = monoModuleLetOf(argN.identName, fnIx)
    if gli >= 0 {
      const gd = P.nodes[gli]
      if gd is LetDecl {
        if gd.letType >= 0 {
          // The global's annotation, through the one pin membership list — the same
          // call the annotated-local and param arms make, so a generic call pins its
          // instance identically wherever its argument's binding lives.
          const rg = monoAnnPinName(tyNameOf(gd.letType))
          if rg != "" { return rg }
        }
        // The un-annotated global, the other half of the local arm's pair, whose type
        // only its initializer knows. The recursion is the local arm's verbatim,
        // including its two rules on an `"i32"` answer and on a `""` refusal.
        if gd.letType < 0 && gd.letInit >= 0 {
          const gdp = monoDestListPinName(gli, -1)
          if gdp != "" { return gdp }
          // The empty-literal rung's module-scope twin (D764) — see the local arm for the
          // ablation and the witness. A rung added to one scope and not the other is the
          // asymmetry this ladder exists to make unstateable.
          const geln = P.nodes[gd.letInit]
          if geln is ArrayLit {
            if geln.arrElems.length == 0 {
              const gepn = monoAnnPinName(tyToEmitName(nodeTyIxOf(cax)))
              if gepn != "" { return gepn }
            }
          }
          const ginner = monoArgTyName(gd.letInit, fnIx)
          if ginner != "" && ginner != "i32" { return ginner }
          if ginner == "" { return "" }
        }
      }
    } else {
      const dpn = monoModuleDupPin(argN.identName, fnIx, cax)
      if dpn != "" { return dpn }
    }
  }
  monoArgTyNameProjected(ix, fnIx, cax)
}

export function monoArgTyName(ix: i32, fnIx: i32) {
  const cax = unwrapParen(ix)
  // A literal the checker retyped at a hole parameter's demand pins at that type (D5840).
  const hlp = holeLitPinOf(cax)
  if hlp >= 0 {
    const hlpName = monoI32AtomPinName(hlp)
    if hlpName != "" { return hlpName }
  }
  // A node the generic body shares, typed at a hole this instance pins to a boolean or a literal
  // union, which the rep cascade below would name `i32` (D2919, D2942).
  const hbt = holeOperandI32PinTyOf(cax, fnIx)
  if hbt >= 0 {
    const hbn = monoAnnPinName(tyToEmitName(hbt))
    if hbn != "" { return hbn }
  }
  // An `i32` niche, a nullable literal union or `boolean | null`: the annotation's name and the
  // scalar cascade both name its raw `i32`, or its non-null half (D2998, D2985).
  const nluTy = argNichePinTyOf(cax, fnIx)
  if nluTy >= 0 {
    const nluName = tyToEmitName(nluTy)
    if nluName != "" { return nluName }
  }
  // A value typed at a hole this instance pins to `string | null` that is no bare name, a join
  // among them: it keeps the niche (D3016), so the callee is picked at the nullable string.
  if cax >= 0 && !(P.nodes[cax] is Ident) {
    const hsn = holeNulStringPinTyOf(cax, fnIx)
    if hsn >= 0 {
      const hsnName = tyToEmitName(hsn)
      if hsnName != "" { return hsnName }
    }
  }
  // A for-in loop variable records the type parameter, so it pins at its list's element at
  // this instance (D3015). A flat literal union keys as the alias arm below keys it, its `i32`
  // atom, never a softened string, so a result stored into a `T` slot agrees.
  const lvPin = loopVarArgPinTyOf(cax, fnIx)
  if lvPin >= 0 {
    const lvName = if tyIsLitUnion(lvPin) { litUnionAliasNameOfTy(lvPin) } else { monoI32AtomPinName(lvPin) }
    if lvName != "" { return lvName }
  }
  // …and a list literal of them, whose element the cascade names the same way.
  const nluEl = litAtomPinElemTyOf(cax, fnIx)
  if nluEl >= 0 {
    const nluElName = monoI32AtomPinName(nluEl)
    if nluElName != "" { return arrElemSuffixed(nluElName) }
  }
  // The third channel, read before both arms below because both need it: an instance's
  // own `x: T` parameter or `const y: T = x` local carries the pin as its annotation, and
  // neither other channel can see it. This is what a generic forwarder hands its inner call.
  const cloPinNode = monoCloPinAnnNodeOfExpr(cax, fnIx)
  // D941 — the fourth channel, the third one's sibling: the instance's own parameter
  // annotation (`paramTypeNode`), gated to a generic application. Every other channel asks
  // the argument node, and a clone shares its leaf expressions, so a forwarded `e`'s
  // recorded type is still the template's. Placed here because arms below `return ""`.
  if cax >= 0 {
    const gaN = P.nodes[cax]
    if gaN is Ident {
      const gaPt = paramTypeNode(fnIx, gaN.identName)
      if gaPt >= 0 {
        const gaAnn = tyNameOf(gaPt)
        if annGenAppSpanEnds(gaAnn) { return gaAnn }
      }
    }
  }
  // D1041 — a fallible numeric `as?` argument (`idn(d as? i32)`) pins at its own recorded
  // `T | null`. Every other channel here asks a binding, and a cast written inline at the
  // call site is none of those. Routed through `monoAnnPinName` so the pin is a spelling
  // the annotation ladder already claims.
  if cax >= 0 {
    const ncqN = P.nodes[cax]
    if ncqN is AsExpr {
      if ncqN.asMode == "null" {
        const ncq = monoAnnPinName(tyToEmitName(nodeTyIxOf(cax)))
        if ncq != "" { return ncq }
      }
    }
  }
  // A nullable function value (kind 19), before the bare-closure arm below and pinned
  // differently on purpose: a bare closure pins the `$fnsig` marker, while
  // `((i32) => i32) | null` is a parameter annotation the emitter already lowers end to
  // end. `tyToEmitName` groups the arrow, which is what makes the pin round-trip.
  let nulFnTy = nodeTyIxOf(cax)
  // A forwarder's own binding again: its node carries `T`, its annotation carries the pin,
  // and for a nullable closure that pin is already the spelling this arm returns.
  if tyNulFuncInner(nulFnTy) < 0 && cloPinNode >= 0 {
    nulFnTy = nodeTyIxOf(cloPinNode)
  }
  if tyNulFuncInner(nulFnTy) >= 0 {
    const nulFnName = tyToEmitName(nulFnTy)
    if nulFnName != "" { return nulFnName }
  }
  // The arena asks the closure question, because `exprIsClosure` cannot ask it here: that
  // predicate resolves through tables `buildLocals` fills post-mono. `nodeTyIsFunc` is the
  // checker's answer and needs no emit-side table. The gates are OR'd, not swapped, since
  // without `cloPinNode` a forwarder's `gid(x)` falls to the same catch-all.
  const valRead = monoIdentReadsValue(cax)
  // A read that resolves to a value binding is not the function its name may also spell.
  let cloArg = false
  if valRead {
    cloArg = identIsBoundClosure(monoIdentNameOf(cax), fnIx)
  } else {
    cloArg = exprIsClosure(ix, fnIx)
  }
  if cloArg || nodeTyIsFunc(cax) || cloPinNode >= 0 {
    // A function-value argument pins its param as a closure (kind 14). The pinned name
    // carries the callee's `$fnsig` key so the instance's value-call ref-casts to the
    // exact signature.
    const ce = P.nodes[cax]
    if ce is Ident && !valRead {
      // Scope-aware, for the reason the direct-call resolution below already is: a per-pin
      // clone shares its template's NAME, so the flat map answers the template's signature
      // in every instance and one pin key serves them all (D1795).
      let cfe = fnIndexOfInScopeAt(sidOfNode(cax), ce.identName, fnIx, cax)
      if cfe < 0 { cfe = fnIndexOfAt(sidOfNode(cax), fnIx, cax) }
      if cfe >= 0 {
        const ck = fnSigKeyOf(cfe)
        if ck != "" { return "=>" + ck }
      }
    }
    // Every other function value — a closure local or param, a struct field, a list or map
    // element, a lambda literal, a call result — keys off the argument's own recorded
    // function type. The named route stays first and unchanged; "" is the loud floor, since
    // a pin that cannot name the signature must not fall through to the i32 catch-all.
    const ak = sigKeyOfTy(nodeTyIxOf(cax))
    if ak != "" { return "=>" + ak }
    // Last: the pin an instance's OWN binding already carries (a generic forwarder).
    if cloPinNode >= 0 { return tyNameOf(cloPinNode) }
    return ""
  }
  // An if-expression whose join is still a type parameter and whose then arm's value is a
  // local of that arm's own prelude pins at that local's initializer: mid-mono no locals
  // table exists, so no other channel resolves the arm's value (D2821).
  const armInit = monoArmTailLocalInit(cax)
  if armInit >= 0 { return monoArgTyName(armInit, fnIx) }
  monoArgTyNameBound(ix, fnIx, cax)
}

// `aN`/`aT` then each binding of `hN`/`hT` whose name `aN` lacks, into `outN`/`outT`.
function monoJoinBinding(
  aN: string[],
  aT: i32[],
  hN: string[],
  hT: i32[],
  outN: string[],
  outT: i32[],
) {
  let i = 0
  while i < aN.length && i < aT.length {
    outN.push(aN[i])
    outT.push(aT[i])
    i = i + 1
  }
  let j = 0
  while j < hN.length && j < hT.length {
    if !monoStrListHas(aN, hN[j]) {
      outN.push(hN[j])
      outT.push(hT[j])
    }
    j = j + 1
  }
  0
}

// The type-level binding column (`T` ⇒ concrete type), built as the checker does: `bindGenWalk`
// of each signature type (`declTys`, positional) against its pin (`tyCol`, -1 = nothing known).
// A hole binds only at a closed pin that can hold a function and no literal: its pin name
// cannot key such a call's result, and softens a literal.
function monoBindCols(
  params: i32[],
  declTys: i32[],
  tyCol: i32[],
  bN: string[],
  bT: i32[],
) {
  let bi = 0
  while bi < params.length {
    const pp = P.nodes[params[bi]]
    if pp is Param {
      let at = -1
      if bi < tyCol.length { at = tyCol[bi] }
      let decl = nodeTyIxOf(pp.parType)
      if bi < declTys.length && declTys[bi] >= 0 && !tyHasTyVar(decl) {
        decl = declTys[bi]
      }
      if pp.parType < 0 {
        if (
          at >= 0
          && (!tyMayHoldFn(at, 0) || tyHasLitDeep(at, 8) || tyHasTyVar(at))
        ) {
          at = -1
        }
      }
      bindGenWalk(decl, at, bN, bT)
      bindGenUnionShapedArmInto(decl, at, bN, bT)
    }
    bi = bi + 1
  }
  0
}

// The parameter types generic `origFe`'s signature declares, where the checker typed it as a
// function of `n` parameters; else empty. A shared annotation node is re-typed by canon's
// scope-blind rename and by a diagonal instance, so a type parameter shadowing a declared
// name reads as one only here.
function monoDeclParamTys(origFe: i32, n: i32): i32[] {
  const out: i32[] = []
  if origFe < 0 || origFe >= monoOrigNode.length { return out }
  const sig = nodeTyIxOf(monoOrigNode[origFe])
  if sig < 0 || sig >= T.tys.length { return out }
  const ft = T.tys[sig]
  if !(ft is TyFunc) || ft.fnParamTypes.length != n { return out }
  for pt in ft.fnParamTypes { out.push(pt) }
  out
}

// Whether the generic being instantiated declares a lambda. A lambda reading a `(T | null)[]`
// element reads a wrong heap when `T` is a generic record that itself holds a `(P | null)[]`,
// so that refuses while this is set (D2525).
let monoCurHasLam = false

// Whether the generic at `fnStmts` position `slot` is the frame of any other lifted function.
function monoFnDeclaresLambda(slot: i32): boolean {
  if fnChildHead.length != fnStmts.length { buildFnChildIndex() }
  if slot < 0 || slot >= fnChildHead.length { return false }
  fnChildHead[slot] >= 0
}

// Refuses an instance whose `(T | null)[]` annotation binds `T` where `T | null` is a niche
// rather than a box or a nullable reference: a string, boolean, literal-union or function
// element. Those instances read the element at the template's rep (D2525).
function monoNicheNulListCheck(
  ann: string,
  typarams: string[],
  tvN: string[],
  tvV: string[],
) {
  if !nameIsArray(ann) { return 0 }
  const tp = nullablePartOf(normTypeAtom(arrElemNameRaw(ann)))
  if tp == "" { return 0 }
  let isParam = false
  let i = 0
  while i < typarams.length {
    if typarams[i] == tp { isParam = true }
    i = i + 1
  }
  if !isParam { return 0 }
  const b = normTypeAtom(monoBindOf(tvN, tvV, tp))
  if b == "" { return 0 }
  if (
    b == "string"
    || b == "boolean"
    || nameIsLitUnionType(b)
    || annArrowAt(b) >= 0
    || (monoCurHasLam && gaeAppHasNulParamListField(b))
  ) {
    return emitFail(
      "emitProgram: a nullable-"
        + b
        + " list element has no rep; use a non-null element type",
    )
  }
  0
}

// Substitute a `LetDecl` annotation `letType` through the instance binding, returning a
// fresh `TypeRef` when a type param substitutes (`T[]` → `f64[]`), else the original node
// index — so a generic body's `const out: T[] = []` lowers against the instance's concrete
// element type, reusing the concrete annotated path rather than per-rep usage inference.
function monoSubstLetType(
  letType: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  if letType < 0 { return letType }
  const tn = P.nodes[letType]
  if tn is TypeRef {
    if monoAnnMentionsTyParam(letType, tn.tyName, typarams) {
      monoNicheNulListCheck(tn.tyName, typarams, tvN, tvV)
      const sub = monoSubstAnn(tn.tyName, typarams, tvN, tvV)
      if sub != "" && sub != tn.tyName {
        // The substituted type, not a re-parse of the substituted name; the name handed
        // to the synthesis is unchanged. Gated on completeness, since `substTyDeep`
        // leaves a parameter it could not bind in place and `tyHasTyVar` sees that.
        let sty = -1
        const origLet = nodeTyIxOf(letType)
        if origLet >= 0 {
          const s2 = substTyDeep(origLet, bN, bT)
          if s2 >= 0 && s2 != origLet {
            if !tyHasTyVar(s2) { sty = s2 }
          }
        }
        const subC = monoPinMintedUnion(sub, sty, unTyKeyTagLet())
        // A union takes the type its registered spelling names, the one an assignment's
        // `letUnionNameOf` resolves against the registry, not the substitution's own row (D2676).
        const subAtoms: string[] = []
        unionSetAtomsOf(subC, subAtoms)
        if subAtoms.length >= 2 { return synthTypeRefTy(subC, tn.pos, -1) }
        return synthTypeRefTy(subC, tn.pos, sty)
      }
    }
  }
  letType
}

// The annotation an un-annotated binding of an if-join takes at this pin when the join's two
// list types stay apart there: the union the checker re-checked the body at (D2832).
function monoApartJoinAnn(init: i32, bN: string[], bT: i32[]): i32 {
  if init < 0 { return -1 }
  const sj = tpIfJoinPinTy(unwrapParen(init), bN, bT)
  if sj < 0 || listUnionSharedRep(sj) >= 0 { return -1 }
  let name = tpIfJoinPinName(sj)
  if name == "" { name = monoListUnionRowName(sj) }
  if name == "" || monoRegisterPinUnion(name, sj) < 0 { return -1 }
  synthTypeRefTy(name, -1, sj)
}

// The annotation an un-annotated binding of an empty list literal takes at this pin when a later
// `push` pinned its element to a type parameter: that list at the pin, spelled as the written
// annotation is, since the template builds the literal at the default `i32` element (D3100).
function monoPushedListAnn(init: i32, bN: string[], bT: i32[]): i32 {
  if init < 0 { return -1 }
  const u = unwrapParen(init)
  if u < 0 || u >= P.nodes.length { return -1 }
  const lit = P.nodes[u]
  if !(lit is ArrayLit) { return -1 }
  if lit.arrElems.length > 0 { return -1 }
  const rt = nodeTyIxOf(u)
  if rt < 0 || rt >= T.tys.length || !tyHasTyVar(rt) { return -1 }
  if monoListLeaf(rt)[1] == 0 { return -1 }
  const sj = substTyDeep(rt, bN, bT)
  if sj < 0 || sj >= T.tys.length || tyHasTyVar(sj) { return -1 }
  const sl = monoListLeaf(sj)
  if sl[1] == 0 { return -1 }
  if !(T.tys[sl[0]] is TyUnion) {
    return synthTypeRefTy(monoListSpelling(tyToStr(sj), sj), -1, sj)
  }
  const name = tpIfJoinPinName(sl[0])
  if name == "" || monoRegisterPinUnion(name, sl[0]) < 0 { return -1 }
  let spell = "(" + name + ")"
  let d = 0
  while d < sl[1] {
    spell = spell + "[]"
    d = d + 1
  }
  synthTypeRefTy(spell, -1, sj)
}

// The innermost element of list type `ty` beside how many lists wrap it: `[ty, 0]` for a type
// that is not a list, and a leaf of -1 when a list's element is still open.
function monoListLeaf(ty: i32): i32[] {
  let t = ty
  let d = 0
  let more = true
  while more && d < 8 {
    more = false
    if t >= 0 && t < T.tys.length {
      const a = T.tys[t]
      if a is TyArray {
        t = a.aElem
        d = d + 1
        more = true
      }
    }
  }
  if t < 0 || t >= T.tys.length { return [-1, 0] }
  [t, d]
}

// The instance's closure-pinned parameters, name beside concrete type. Module state around
// the `monoCloneBody` call, like `monoInstIsFirst`: the shared body carries the checker's
// inference hole for such a parameter, so only the frame being cloned names the closure.
let monoCloPinNames: string[] = []
let monoCloPinTys: i32[] = []

// The concrete function type expression `ix` names by reading a closure-pinned parameter,
// or -1. Matched on the parameter's name, like the inferred-return-list rung beside it,
// with the shadow guard that name matching needs.
function monoCloPinTyOfExpr(ix: i32): i32 {
  if ix < 0 { return -1 }
  const rd = unwrapParen(ix)
  if rd < 0 || rd >= P.nodes.length { return -1 }
  const e = P.nodes[rd]
  if e is Ident {
    // A read the checker typed is not this parameter: a body-local binding shadowing the
    // name resolves to its own concrete type, and only the un-annotated parameter is left
    // the inference hole. Without this test the name match reached a shadow and annotated
    // an i32 list as a closure one — check-clean invalid wasm.
    const rt = nodeTyIxOf(rd)
    if rt >= 0 {
      const rtt = T.tys[rt]
      if !(rtt is TyVar) { return -1 }
    }
    let i = 0
    while i < monoCloPinNames.length {
      if monoCloPinNames[i] == e.identName { return monoCloPinTys[i] }
      i = i + 1
    }
  }
  -1
}

// One field's type for the shape annotation below: the pinned closure where the value reads
// one, else the type the checker recorded. -1 declines the whole annotation, since a shape
// missing one field's type is not a shape.
function monoCloPinFieldTy(ix: i32): i32 {
  const pt = monoCloPinTyOfExpr(ix)
  if pt >= 0 { return pt }
  // A literal-typed value widens to its base scalar, the rep the field stores: an annotation
  // naming the literal itself is a type the field's own value does not lower as.
  const wt = nodeTyWidenedRepTy(ix)
  if wt >= 0 { return wt }
  nodeTyIxOf(ix)
}

// The initializer node a container rung may read, or -1: this instance must bind a pin at
// all, and the node must be in range. The shared entry of the two rungs below.
function monoCloPinInitNode(initIx: i32): i32 {
  if initIx < 0 { return -1 }
  if monoCloPinNames.length == 0 { return -1 }
  const rd = unwrapParen(initIx)
  if rd < 0 || rd >= P.nodes.length { return -1 }
  rd
}

// The array annotation an un-annotated LIST literal over closure-pinned parameters owes:
// `[a]` becomes `((i32) => i32)[]`. Without it the element types i32 and the list's read is
// not a callable. -1 when any element does not pin, since one literal is one row (D1664).
function monoCloPinListAnn(initIx: i32): i32 {
  const rd = monoCloPinInitNode(initIx)
  if rd < 0 { return -1 }
  const e = P.nodes[rd]
  if e is ArrayLit {
    if e.arrElems.length < 1 { return -1 }
    let ety = -1
    let i = 0
    while i < e.arrElems.length {
      const et = monoCloPinTyOfExpr(e.arrElems[i])
      if et < 0 { return -1 }
      if ety < 0 { ety = et }
      else if ety != et { return -1 }
      i = i + 1
    }
    const en = tyToEmitName(ety)
    if en == "" { return -1 }
    return synthTypeRef("(" + en + ")[]", 0 - 1)
  }
  -1
}

// Its object-literal twin, a rung of its own because the annotation is built from a
// different grammar — a field list, each field spelled in turn, not one element type. At
// least one field must pin, or an unrelated literal gains an annotation it never had.
function monoCloPinShapeAnn(initIx: i32): i32 {
  const rd = monoCloPinInitNode(initIx)
  if rd < 0 { return -1 }
  const e = P.nodes[rd]
  if e is ObjLit {
    if e.objFields.length < 1 { return -1 }
    let anyPin = false
    let txt = "{"
    const fns: string[] = []
    const fts: i32[] = []
    let j = 0
    while j < e.objFields.length {
      const f = P.nodes[e.objFields[j]]
      if f is FieldInit {
        if monoCloPinTyOfExpr(f.fiValue) >= 0 { anyPin = true }
        const fty = monoCloPinFieldTy(f.fiValue)
        if fty < 0 { return -1 }
        const ftn = tyToEmitName(fty)
        if ftn == "" { return -1 }
        if j > 0 { txt = txt + ", " }
        txt = txt + f.fiName + ": " + ftn
        fns.push(f.fiName)
        fts.push(fty)
      } else {
        return -1
      }
      j = j + 1
    }
    if !anyPin { return -1 }
    // The shape's type is handed over with its spelling, so its closure fields keep their
    // signatures rather than resolving through a parse of the text. The type is minted
    // here, so it may share the row of a rep-equal shape interned first.
    const sty = mkObjTy(fns, fts)
    structTyMarkAliasable(sty)
    return synthTypeRefTy(txt + "}", 0 - 1, sty)
  }
  -1
}

// The links of the `else if` chain headed by the `if` at `ix`, outermost first. A rewriter
// maps each link's condition and then arm in this order, then the last link's else
// (`monoIfChainElse`), and `monoIfChainRebuild` reassembles them — the node order of the
// recursive form, at no stack depth (D1990).
function monoIfChainLinks(ix: i32): i32[] {
  const links: i32[] = []
  let cur = ix
  while cur >= 0 {
    const c = P.nodes[cur]
    const at = cur
    cur = -1
    if c is IfStmt {
      links.push(at)
      if c.ifElse >= 0 && P.nodes[c.ifElse] is IfStmt { cur = c.ifElse }
    }
  }
  links
}

// The else of the chain's last link: a block, or -1 when it has none.
function monoIfChainElse(links: i32[]): i32 {
  const c = P.nodes[links[links.length - 1]]
  if c is IfStmt { return c.ifElse }
  -1
}

// Rebuilds the chain innermost-first from each link's rewritten condition and then arm and the
// rewritten tail else `ce`, keeping a link whose parts are all unchanged.
function monoIfChainRebuild(
  links: i32[],
  ccs: i32[],
  cts: i32[],
  ce0: i32,
): i32 {
  let ce = ce0
  let li = links.length - 1
  while li >= 0 {
    const c = P.nodes[links[li]]
    if c is IfStmt {
      if ccs[li] == c.ifCond && cts[li] == c.ifThen && ce == c.ifElse {
        ce = links[li]
      } else {
        ce = mkIf(ccs[li], cts[li], ce, c.pos)
        // The rebuilt link answers the join its original did, which a value `if` is typed by.
        const ot = nodeTyIxOf(links[li])
        if ot >= 0 { nodeTyRecord(ce, ot) }
      }
    }
    li = li - 1
  }
  ce
}

// `monoIfChainRebuild` for the per-instance walk: a link whose recorded join names a type
// parameter this instance binds is re-made answering the pinned join, since a value `if`'s
// blocktype is read off that type and the template's names the parameter itself (D2876).
function monoIfChainRebuildPinned(
  links: i32[],
  ccs: i32[],
  cts: i32[],
  ce0: i32,
  bN: string[],
  bT: i32[],
  sink: boolean,
): i32 {
  let ce = ce0
  let li = links.length - 1
  while li >= 0 {
    const at = links[li]
    const c = P.nodes[at]
    if c is IfStmt {
      // Only where every arm's value is the join or one of its members: a hole arm absorbs
      // the checker's join, so a sibling can hold another type (a literal `5`).
      const raw = nodeTyIxOf(at)
      let pty = -1
      // Only a binding the return reads: a sink or a tail re-joins its arms itself. Recorded,
      // not returned: the rebuild goes on and the failure stops the build (D2915).
      if (
        !sink
        && monoPinLetReaches
        && monoHoleJoinDropsArm(at, raw, monoPinnedTyOf(at, bN, bT), bN, bT)
      ) {
        emitFail(
          "emitProgram: a join of a `??` with a type parameter drops a member of that parameter at this instance",
        )
      }
      // A join the checker kept apart as `T | C` is read at the pin wherever it goes (D2906), and
      // so is a `??` over one, whose result the checker re-joins without the mark (D3568).
      const tpu = tyIsTpJoinUnion(raw) || monoCoalOverTpJoin(c.ifCond, c.ifThen)
      if monoIfArmsAllTy(at, raw, bN, bT) {
        pty = monoPinnedTyOf(at, bN, bT)
        // Such a join is a union at the pin only as a box registered here.
        if tpu { pty = monoPinUnionBoxed(pty, false) }
      } else if sink || tpu {
        pty = monoIfArmsPinJoin(at, raw, bN, bT)
      } else if monoHoleJoinPinsString(raw, at, bN, bT) {
        // A hole join the pin makes a string is built as one, its atom arms widened (D3291).
        pty = monoHoleJoinPinTy(at, bN, bT)
      }
      // Arms with no pinned join of their own (a record arm) read the recorded union (D3520).
      if pty < 0 && (tpu || monoTyIsUnionOrNulUnion(raw)) {
        pty = monoPinUnionBoxed(monoPinnedTyOf(at, bN, bT), true)
      }
      if tpu && links[0] == monoTailIf && monoNulJoinMixesNumbers(raw, bN, bT) {
        // A join that leaves the body (a tail) is read by its caller without its `null` at these
        // pins, so the box this instance would build has nothing to land in; recorded, not returned.
        emitFailAt(
          "emitProgram: a join of type parameters pinned at two number types beside a null has no box at this instance",
          at,
        )
      }
      const retype = pty >= 0
        && pty != raw
        && (tpu || monoPinKeepsMembers(raw, pty))
      if (
        ccs[li] == c.ifCond
        && cts[li] == c.ifThen
        && ce == c.ifElse
        && !retype
      ) {
        ce = at
      } else {
        ce = mkIf(ccs[li], cts[li], ce, c.pos)
        // A link re-made only for its parts answers its template's join, which the pin reads.
        if retype { monoPinRecordTy(ce, pty) }
        else if raw >= 0 { nodeTyRecord(ce, raw) }
      }
    }
    li = li - 1
  }
  ce
}

// Whether join `raw` carries a null and its members pin at two different number types, one of
// them non-null, alone or inside a union: the concrete join is order-dependent there (D3363).
function monoNulJoinMixesNumbers(raw: i32, bN: string[], bT: i32[]): boolean {
  if raw < 0 || raw >= T.tys.length || !(T.tys[raw] is TyNullable) {
    return false
  }
  const ms: i32[] = []
  flattenVariantsInto(raw, ms)
  let first = ""
  let mixed = false
  let bare = false
  for m in ms {
    if m >= 0 && m < T.tys.length && T.tys[m] is TyVar {
      const s = substTyDeep(m, bN, bT)
      const ns: i32[] = []
      flattenVariantsInto(nonNullTy(s), ns)
      for x in ns {
        const n = tyPrimNameOf(x) ?? ""
        if n == "i32" || n == "i64" || n == "f32" || n == "f64" {
          if !tyBearsNull(s) { bare = true }
          if first == "" { first = n }
          else if first != n { mixed = true }
        }
      }
    }
  }
  mixed && bare
}

// Whether the `if` chain at `at`, typed at inference hole `raw`, is pinned at `string` or
// `string | null`: the rep its arms' own atoms would otherwise leave it at is not the pin's.
function monoHoleJoinPinsString(
  raw: i32,
  at: i32,
  bN: string[],
  bT: i32[],
): boolean {
  if raw < 0 || raw >= T.tys.length { return false }
  const rt = T.tys[raw]
  if !(rt is TyVar) { return false }
  if rt.tvName.length > 0 && rt.tvName[0] != "?"[0] { return false }
  const p = monoHoleJoinPinTy(at, bN, bT)
  if p < 0 || p >= T.tys.length || tyHasTyVar(p) { return false }
  const pt = T.tys[p]
  const str = tyPrimNameOf(p) == "string"
    || (pt is TyNullable && tyPrimNameOf(pt.nInner) == "string")
  // A literal's element or field joins at the literal's own row, which widens its arms.
  str && !monoPinInLit && monoHoleJoinHasAtomArm(at, bN, bT)
}

// Whether some arm value of the `if` chain at `at` is a literal union at the pin, the arm a
// `string` join widens.
function monoHoleJoinHasAtomArm(at: i32, bN: string[], bT: i32[]): boolean {
  let cur = at
  while cur >= 0 {
    const c = P.nodes[cur]
    cur = -1
    if c is IfStmt {
      if monoArmPinsLitUnion(ifArmValueExpr(c.ifThen), bN, bT) { return true }
      if c.ifElse >= 0 {
        if P.nodes[c.ifElse] is IfStmt {
          cur = c.ifElse
        } else if monoArmPinsLitUnion(ifArmValueExpr(c.ifElse), bN, bT) {
          return true
        }
      }
    }
  }
  false
}

// Whether arm value `v` is typed, at the pin, at a literal union or its nullable.
function monoArmPinsLitUnion(v: i32, bN: string[], bT: i32[]): boolean {
  if v < 0 { return false }
  const t = monoHoleJoinPinTy(v, bN, bT)
  t >= 0 && t < T.tys.length && !tyHasTyVar(t) && tyIsLitUnion(nonNullTy(t))
}

// The pinned type of join `at`, through a hole instance's own hole binding where the
// parameters' binding leaves it open.
function monoHoleJoinPinTy(at: i32, bN: string[], bT: i32[]): i32 {
  const p = monoPinnedTyOf(at, bN, bT)
  if (p >= 0 && !tyHasTyVar(p)) || monoPinHoleN.length == 0 { return p }
  const jN: string[] = []
  const jT: i32[] = []
  monoJoinBinding(bN, bT, monoPinHoleN, monoPinHoleT, jN, jT)
  const s = substTyDeep(nodeTyIxOf(at), jN, jT)
  if s < 0 || tyHasTyVar(s) { return p }
  s
}

// Whether `ty` names a type parameter and every arm value of the `if` chain at `ix` is typed
// `ty` too (or never completes), an arm whose value is itself an `if` answering for its own.
function monoIfArmsAllTy(ix: i32, ty: i32, bN: string[], bT: i32[]): boolean {
  if ty < 0 || ty >= T.tys.length || !tyHasTyVar(ty) { return false }
  let cur = ix
  while cur >= 0 {
    const c = P.nodes[cur]
    cur = -1
    if c is IfStmt {
      if !monoArmTailIsTy(c.ifThen, ty, bN, bT) { return false }
      if c.ifElse < 0 { return false }
      if P.nodes[c.ifElse] is IfStmt { cur = c.ifElse }
      else if !monoArmTailIsTy(c.ifElse, ty, bN, bT) { return false }
    }
  }
  true
}

// The join a chain whose recorded join is a bare type parameter takes at the binding `bN`/`bT`
// when an arm holds another type (`5` beside `t`): its arms' pinned types joined, a union only
// as a value union registered here. -1 when an arm has no concrete pinned type (D2893).
function monoIfArmsPinJoin(ix: i32, raw: i32, bN: string[], bT: i32[]): i32 {
  if raw < 0 || raw >= T.tys.length { return -1 }
  // A concrete join (`5` first) is re-asked only where an arm's own type names a parameter.
  if !(T.tys[raw] is TyVar) && !monoIfArmHasTyVar(ix) { return -1 }
  const ts: i32[] = []
  monoPinArmLits = []
  const got = monoChainPinnedTys(ix, bN, bT, ts)
  if got < 0 { return -1 }
  let j = joinPinnedArmLit(ts, monoPinArmLits)
  if j < 0 || j >= T.tys.length || tyHasTyVar(j) { return -1 }
  // A nested arm joins into its enclosing box, which only a union join builds.
  if got == 1 && !(T.tys[j] is TyUnion) { return -1 }
  if T.tys[j] is TyUnion && monoPinRetTy >= 0 && monoPinLetReaches {
    // A join the body returns is the return's own box, whose tags are positional (D2912).
    if !monoTySameMembers(j, monoPinRetTy) { return -1 }
    j = monoPinRetTy
  }
  if monoTyIsUnionOrNulUnion(j) {
    const name = valueUnionRetName(j)
    if name == "" || monoRegisterPinUnion(name, j) < 0 { return -1 }
  }
  j
}

// Whether an `if` join the checker typed as an inference hole `raw` (a `??` result absorbing a
// type parameter) is pinned at `pty` while its arms' own pinned types join wider: the
// parameter's member is lost there, and building it would be invalid (D2915).
function monoHoleJoinDropsArm(
  at: i32,
  raw: i32,
  pty: i32,
  bN: string[],
  bT: i32[],
): boolean {
  if raw < 0 || raw >= T.tys.length || pty < 0 || pty >= T.tys.length {
    return false
  }
  const rt = T.tys[raw]
  if !(rt is TyVar) { return false }
  if rt.tvName.length > 0 && rt.tvName[0] != "?"[0] { return false }
  if !monoIfArmHasTyVar(at) { return false }
  const ts: i32[] = []
  monoPinArmLits = []
  if monoChainPinnedTys(at, bN, bT, ts) < 0 { return false }
  const j = joinPinnedArmLit(ts, monoPinArmLits)
  // Only a box: a scalar pin is re-joined by the return set, and a box is built at `pty`.
  T.tys[pty] is TyUnion
    && j >= 0
    && j < T.tys.length
    && !tyHasTyVar(j)
    && !assignable(j, pty)
}

// `j`, its value-union box registered first when it is a union whose box has a name; a union
// with a record arm is named only when `refArm` (an `if` whose arms have no pinned join).
function monoPinUnionBoxed(j: i32, refArm: boolean): i32 {
  if j < 0 || j >= T.tys.length || !monoTyIsUnionOrNulUnion(j) { return j }
  let name = valueUnionRetName(j)
  // Such a union is named as a binding of it is (`monoTpJoinBindAnn`).
  if name == "" && refArm && monoTyHoldsRefArm(j) {
    name = monoPinUnionName(tyToEmitName(j))
  }
  if name != "" { monoRegisterPinUnion(name, j) }
  j
}

// Whether some arm value along the `if` chain at `ix` is typed with a type parameter.
function monoIfArmHasTyVar(ix: i32): boolean {
  let cur = ix
  while cur >= 0 {
    const c = P.nodes[cur]
    cur = -1
    if c is IfStmt {
      if monoArmTyHasTyVar(c.ifThen) { return true }
      if c.ifElse >= 0 {
        if P.nodes[c.ifElse] is IfStmt { cur = c.ifElse }
        else if monoArmTyHasTyVar(c.ifElse) { return true }
      }
    }
  }
  false
}

function monoArmTyHasTyVar(blockIx: i32): boolean {
  const v = ifArmValueExpr(blockIx)
  if v < 0 { return false }
  const vt = nodeTyIxOf(v)
  vt >= 0 && vt < T.tys.length && tyHasTyVar(vt)
}

// Whether `monoArmPinnedTy` is inside a nested arm's own chain.
let monoArmNested = false

// Appends the pinned types of every arm along the `if` chain at `ix` to `out`: 0, 1 when an arm
// is itself an `if`, or -1 when an arm has none or the chain has no `else`.
function monoChainPinnedTys(ix: i32, bN: string[], bT: i32[], out: i32[]): i32 {
  let nested = 0
  let cur = ix
  while cur >= 0 {
    const c = P.nodes[cur]
    cur = -1
    if c is IfStmt {
      const rt = monoArmPinnedTy(c.ifThen, bN, bT, out)
      if rt < 0 || c.ifElse < 0 { return -1 }
      // A `??` desugars to `if x != null { x } …` over one shared `x`, whose recorded type is
      // the nullable operand's: past its own test that arm cannot be null (D3568).
      if (
        rt == 0
        && out.length > 0
        && monoArmIsTestedNonNull(c.ifCond, c.ifThen)
      ) {
        out.push(nonNullTy(out.pop() ?? -1))
      }
      if rt == 1 { nested = 1 }
      if P.nodes[c.ifElse] is IfStmt {
        cur = c.ifElse
      } else {
        const re = monoArmPinnedTy(c.ifElse, bN, bT, out)
        if re < 0 { return -1 }
        if re == 1 { nested = 1 }
      }
    }
  }
  nested
}

// Whether the link `cond`/`thenIx` is a desugared `??` whose operand is a join kept apart.
function monoCoalOverTpJoin(cond: i32, thenIx: i32): boolean {
  if !monoArmIsTestedNonNull(cond, thenIx) { return false }
  tyIsTpJoinUnion(nodeTyIxOf(unwrapParen(ifArmValueExpr(thenIx))))
}

// Whether `cond` is `x != null` and the then arm `thenIx` yields that same `x` node.
function monoArmIsTestedNonNull(cond: i32, thenIx: i32): boolean {
  const cn = P.nodes[unwrapParen(cond)]
  if !(cn is BinExpr) || cn.binOp != "!=" { return false }
  if !(P.nodes[unwrapParen(cn.binRight)] is NullLit) { return false }
  const x = unwrapParen(cn.binLeft)
  const v = unwrapParen(ifArmValueExpr(thenIx))
  if x < 0 || v < 0 { return false }
  x == v
}

// Appends the pinned type of arm block `blockIx`'s tail value to `out`; 0, 1 for an arm that is
// an `if`, or -1 when it has none. An arm that never completes adds nothing.
function monoArmPinnedTy(
  blockIx: i32,
  bN: string[],
  bT: i32[],
  out: i32[],
): i32 {
  const v = ifArmValueExpr(blockIx)
  if v < 0 { return -1 }
  // An arm whose value is an `if` adds its own arms, as the union lowering joins them (1). One
  // level only: a deeper nest is left to its template type.
  if P.nodes[unwrapParen(v)] is IfStmt {
    if monoArmNested { return -1 }
    monoArmNested = true
    const rc = monoChainPinnedTys(unwrapParen(v), bN, bT, out)
    monoArmNested = false
    if rc < 0 { return -1 }
    return 1
  }
  const vt = nodeTyIxOf(v)
  if vt < 0 || vt >= T.tys.length { return -1 }
  const t = T.tys[vt]
  if t is TyPrim && t.primName == "never" { return 0 }
  const pv = monoPinArmSubst(vt, bN, bT)
  if pv < 0 { return -1 }
  out.push(pv)
  monoPinArmLits.push(joinArmIsLit(v))
  0
}

// Per type `monoChainPinnedTys` appends, whether that arm's value is a literal; reset by the
// caller with its list, so the pinned join adapts a literal arm and keeps runtime ones apart.
let monoPinArmLits: boolean[] = []

// `ty` at the binding `bN`/`bT` widened by the parameters' union-arm bindings, a member no
// argument bound dropped; -1 when a type parameter remains.
function monoPinArmSubst(ty: i32, bN: string[], bT: i32[]): i32 {
  let xN = bN
  let xT = bT
  if monoPinArmBN.length > bN.length && monoPinArmExtends(bN, bT) {
    xN = monoPinArmBN
    xT = monoPinArmBT
  }
  let p = substTyDeep(ty, xN, xT)
  if p >= 0 && tyHasTyVar(p) { p = monoDropUnboundMembers(p) }
  if p < 0 || tyHasTyVar(p) { return -1 }
  p
}

// A union whose open members are declared type parameters this instance left unbound, which no
// argument supplied and so no value holds (`U` of `u: U | string` at a `string`): its other
// members joined. -1 for any other type still naming a parameter.
function monoDropUnboundMembers(ty: i32): i32 {
  const u = T.tys[ty]
  if !(u is TyUnion) { return -1 }
  const rest: i32[] = []
  let i = 0
  while i < u.uMembers.length {
    const m = u.uMembers[i]
    if m < 0 || m >= T.tys.length { return -1 }
    const mt = T.tys[m]
    if mt is TyVar {
      if mt.tvName.length == 0 || mt.tvName[0] == "?"[0] { return -1 }
    } else if tyHasTyVar(m) {
      return -1
    } else {
      rest.push(m)
    }
    i = i + 1
  }
  joinPinnedArmTys(rest)
}

// Whether the tail value of arm block `blockIx` is typed `ty`, or is a call that never returns,
// or is the join at the binding `bN`/`bT` (a narrowed parameter, `x` in the `else` of `x is S`).
function monoArmTailIsTy(
  blockIx: i32,
  ty: i32,
  bN: string[],
  bT: i32[],
): boolean {
  const v = ifArmValueExpr(blockIx)
  if v < 0 { return false }
  const vt = nodeTyIxOf(v)
  if vt == ty { return true }
  if vt < 0 || vt >= T.tys.length { return false }
  const t = T.tys[vt]
  if t is TyPrim && t.primName == "never" { return true }
  if monoTySameOrVar(vt, ty) { return true }
  // A member of a union join, which the pinned union still holds apart.
  const u = T.tys[ty]
  if u is TyUnion {
    let i = 0
    while i < u.uMembers.length {
      if monoTySameOrVar(vt, u.uMembers[i]) { return true }
      i = i + 1
    }
  }
  if !tyHasTyVar(vt) { return false }
  const pv = substTyDeep(vt, bN, bT)
  const pj = substTyDeep(ty, bN, bT)
  if pv < 0 || pj < 0 || tyHasTyVar(pv) || tyHasTyVar(pj) { return false }
  tyEq(pv, pj)
}

// Whether `a` and `b` are one type: one index, one type parameter's name, or equal.
function monoTySameOrVar(a: i32, b: i32): boolean {
  if a == b { return true }
  if a < 0 || b < 0 || a >= T.tys.length || b >= T.tys.length { return false }
  const ta = T.tys[a]
  const tb = T.tys[b]
  if ta is TyVar {
    if tb is TyVar { return ta.tvName == tb.tvName }
    return false
  }
  if tb is TyVar { return false }
  tyEq(a, b)
}

// Whether pinned `pty` keeps every member union `raw` has: a pin that merges two members
// (`boolean | i32`, `T[] | i32[]` at `i32`) is left to its arms, which still tell them apart.
function monoPinKeepsMembers(raw: i32, pty: i32): boolean {
  const r = T.tys[raw]
  if r is TyUnion {
    const p = T.tys[pty]
    if p is TyUnion { return p.uMembers.length == r.uMembers.length }
    return false
  }
  true
}

// The operand children of expression `ix` a copy-on-write rewrite descends into, in the
// order `monoExprRebuild` takes them back. A compound assignment names its target once and
// its value limb, since the target node is shared between the read and the write; a postfix
// `x++` has none. Empty for a leaf and for every statement kind, which the walkers own.
function monoExprKids(ix: i32): i32[] {
  const out: i32[] = []
  if ix < 0 { return out }
  const n = P.nodes[ix]
  match n {
    Call => {
      out.push(n.callFn)
      let ai = 0
      while ai < n.callArgs.length {
        out.push(n.callArgs[ai])
        ai = ai + 1
      }
    }
    BinExpr => {
      out.push(n.binLeft)
      if n.binCompound == "" {
        out.push(n.binRight)
      } else if n.binCompound != "++" && n.binCompound != "--" {
        const inner = P.nodes[n.binRight]
        if inner is BinExpr { out.push(inner.binRight) }
      }
    }
    Unary => {
      if n.unOp != "p+" && n.unOp != "p-" { out.push(n.unArg) }
    }
    Paren => {
      out.push(n.parInner)
    }
    Member => {
      out.push(n.memObj)
    }
    OptMember => {
      out.push(n.omObj)
    }
    Index => {
      out.push(n.idxArr)
      out.push(n.idxIndex)
    }
    IsExpr => {
      out.push(n.isObj)
    }
    AsExpr => {
      out.push(n.asObj)
    }
    Spread => {
      out.push(n.spdArg)
    }
    ArrayLit => {
      return n.arrElems
    }
    ObjLit => {
      let fi = 0
      while fi < n.objFields.length {
        const f = P.nodes[n.objFields[fi]]
        if f is FieldInit { out.push(f.fiValue) } else { out.push(-1) }
        fi = fi + 1
      }
    }
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | ErrExpr | TypeRef | BreakStmt | ContinueStmt => {
      // A leaf.
    }
    LetDecl | Param | FuncDecl | IfStmt | WhileStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | ForRange | ForIn | MatchExpr | ImportDecl => {
      // A statement, declaration or lambda: the walker that asked owns its children.
    }
  }
  out
}

// Expression `ix` rebuilt over `kids`, parallel to `monoExprKids(ix)`; `ix` itself when no
// child changed. The rebuilt node answers the checked type `ix` did, substituted through the
// instance binding `bN`/`bT`, since its emission reads the recorded type (D2551).
function monoExprRebuild(ix: i32, kids: i32[], bN: string[], bT: i32[]): i32 {
  const old = monoExprKids(ix)
  if old.length != kids.length { return ix }
  let changed = false
  let i = 0
  while i < kids.length {
    if kids[i] != old[i] { changed = true }
    i = i + 1
  }
  if !changed { return ix }
  const nx = monoExprRemake(ix, kids)
  if nx != ix { monoPinRecordTy(nx, monoPinnedTyOf(ix, bN, bT)) }
  nx
}

// Record `ty` as the type rebuilt node `nx` answers. A nullable scalar spelled nowhere
// (`x.pop()` at `f64`) also gets its box row here, since the pass that registers one from an
// expression's type ran before the pin minted this one.
function monoPinRecordTy(nx: i32, ty: i32) {
  nodeTyRecord(nx, ty)
  const nun = nulNumScalarUnionName(ty)
  if nun != "" { monoRegisterPinUnion(nun, ty) }
  0
}

// The recorded type of `ix` at the instance binding `bN`/`bT`: substituted where that leaves
// no type variable, else as recorded. -1 when the node has none.
// The instance's remainder of an `is` else over a type parameter's list (`mkTvElseRemTy`), or -1
// when `ty` is not one or the instance leaves nothing to subtract.
function monoElseRemainderAt(ty: i32, bN: string[], bT: i32[]): i32 {
  if tvElseBase.length == 0 { return -1 }
  const base = tvElseBase.get(ty)
  const tested = tvElseTested.get(ty)
  if base == null || tested == null { return -1 }
  const sb = substTyDeep(base, bN, bT)
  const sx = substTyDeep(tested, bN, bT)
  if sb < 0 || sx < 0 || tyHasTyVar(sb) || tyHasTyVar(sx) { return -1 }
  subtractTy(sb, sx)
}

function monoPinnedTyOf(ix: i32, bN: string[], bT: i32[]): i32 {
  const ty = nodeTyIxOf(ix)
  if ty < 0 || ty >= T.tys.length { return ty }
  if !tyHasTyVar(ty) { return ty }
  const rem = monoElseRemainderAt(ty, bN, bT)
  if rem >= 0 { return rem }
  let st = substTyDeep(ty, bN, bT)
  if (st < 0 || tyHasTyVar(st)) && monoPinHoleN.length > 0 {
    // A hole instance's list literal, element read and call of a function value are typed at
    // its holes, which `bN` does not name (D3066). A method's result is the receiver's to answer.
    const hn = P.nodes[unwrapParen(ix)]
    let byHole = hn is ArrayLit || hn is Index
    if hn is Call { byHole = monoCallsFnValue(unwrapParen(ix), 0) }
    if byHole {
      const jN: string[] = []
      const jT: i32[] = []
      monoJoinBinding(bN, bT, monoPinHoleN, monoPinHoleT, jN, jT)
      st = substTyDeep(ty, jN, jT)
      // A record list's rows are the literal's own, which a pin re-type does not collect.
      if monoListElemHoldsObj(st) { return ty }
    }
  }
  if st < 0 || tyHasTyVar(st) { return ty }
  st
}

// Whether call `ix` calls a function value: a name, or a call of one (`k()()`), typed as a
// function. A method call is not one.
function monoCallsFnValue(ix: i32, depth: i32): boolean {
  if ix < 0 || depth > 8 { return false }
  const n = P.nodes[ix]
  if !(n is Call) { return false }
  const cf = unwrapParen(n.callFn)
  if cf < 0 { return false }
  const cft = nodeTyIxOf(cf)
  if cft < 0 || cft >= T.tys.length || !(T.tys[cft] is TyFunc) { return false }
  if P.nodes[cf] is Ident { return true }
  monoCallsFnValue(cf, depth + 1)
}

// Whether list type `t`'s element is a record, nullable or as a union member.
function monoListElemHoldsObj(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const lt = T.tys[t]
  if !(lt is TyArray) { return false }
  const e = nonNullTy(lt.aElem)
  if e < 0 || e >= T.tys.length { return false }
  if monoTyIsObj(e) { return true }
  const et = T.tys[e]
  if !(et is TyUnion) { return false }
  let i = 0
  while i < et.uMembers.length {
    if monoTyIsObj(et.uMembers[i]) { return true }
    i = i + 1
  }
  false
}

// Whether `t` is a record type.
function monoTyIsObj(t: i32): boolean {
  t >= 0 && t < T.tys.length && T.tys[t] is TyObj
}

// A fresh node for expression `ix` over `kids` (parallel to `monoExprKids(ix)`), or `ix`
// for a kind it cannot remake. It answers the narrowing retirements `ix` did (D2390's banks).
// Records no type: the caller decides which one the new node answers.
function monoExprRemake(ix: i32, kids: i32[]): i32 {
  const nx = monoExprMake(ix, kids)
  if nx != ix { recordClonedCallRetire(ix, nx) }
  monoKeepTplHole(ix, nx)
  nx
}

// A copy of call `ix` with callee `callee` and arguments `args`, keeping its argument names
// and position, which resolves its member target and overload set as `ix` does (D4030).
// Every per-instance copy of a call is made here.
function monoRemintCall(ix: i32, callee: i32, args: i32[]): i32 {
  const n = P.nodes[ix]
  if n is Call {
    return ufcsSiteCarry(mkCallN(callee, args, n.callArgNames, n.pos), ix)
  }
  -1
}

// `monoRemintCall` for a pass that rewrites only the call's parts: the copy answers the
// template's type, so it carries the type recorded on `ix`.
function monoRemintCallTpl(ix: i32, callee: i32, args: i32[]): i32 {
  const nc = monoRemintCall(ix, callee, args)
  nodeTyCarry(nc, ix)
  nc
}

// A list literal a pass re-makes for its items alone: the copy answers the template's type, so
// it carries the type recorded on `ix`.
function monoRemakeListLitTpl(ix: i32, es: i32[], pos: i32): i32 {
  const nx = monoCopyOf(ix, mkArrayLit(es, pos))
  nodeTyCarry(nx, ix)
  nx
}

// `monoExprRemake`'s node maker. A call keeps its explicit type arguments, and an `is` its
// banked row.
function monoExprMake(ix: i32, kids: i32[]): i32 {
  const n = P.nodes[ix]
  if n is Ident { return monoCopyOf(ix, mkIdent(n.identName, n.pos)) }
  if n is Call {
    const args: i32[] = []
    let ai = 1
    while ai < kids.length {
      args.push(kids[ai])
      ai = ai + 1
    }
    const nc = monoRemintCall(ix, kids[0], args)
    const tas = callTyArgsOf(ix)
    if tas.length > 0 { setCallTyArgs(nc, tas, callTyArgEndsOf(ix)) }
    return nc
  }
  if n is BinExpr {
    if n.binCompound == "++" || n.binCompound == "--" {
      return mkPreIncr(n.binCompound, kids[0], n.pos)
    }
    if n.binCompound != "" {
      // A compound whose right side a rewrite respelled from `target op value` offers no value
      // kid (`monoExprKids`), so it is kept as it is (D3993).
      if kids.length < 2 { return ix }
      return mkCompoundAssign(n.binCompound, kids[0], kids[1], n.pos)
    }
    const nb = mkBinary(n.binOp, kids[0], kids[1], n.pos)
    if n.binRegion != 0 { markArithRegion(nb) }
    return nb
  }
  if n is Unary { return mkUnary(n.unOp, kids[0], n.pos) }
  if n is Paren { return mkParen(kids[0], n.pos) }
  if n is Member { return mkMember(kids[0], n.memProp, n.pos) }
  if n is OptMember { return mkOptMember(kids[0], n.omProp, n.omDot, n.pos) }
  if n is Index { return mkIndex(kids[0], kids[1], n.pos) }
  if n is IsExpr { return monoReIsExpr(ix, kids[0]) }
  if n is AsExpr { return mkAsExpr(kids[0], n.asTy, n.asMode, n.pos) }
  if n is Spread { return mkSpread(kids[0], n.pos) }
  if n is ArrayLit { return monoCopyOf(ix, mkArrayLit(kids, n.pos)) }
  if n is ObjLit {
    const fs: i32[] = []
    let fi = 0
    while fi < n.objFields.length {
      let nf = n.objFields[fi]
      const f = P.nodes[nf]
      if f is FieldInit {
        if kids[fi] != f.fiValue { nf = mkFieldInit(f.fiName, kids[fi], f.pos) }
      }
      fs.push(nf)
      fi = fi + 1
    }
    return monoCopyOf(ix, mkObjLit(fs, n.pos))
  }
  ix
}

// Clone a monomorphized instance's body, substituting every `LetDecl` type-param
// annotation through the binding. Only the statement spine is rebuilt; every leaf
// expression, a nested lambda included, is shared, so no new function node is created.
// Returns the same node index when nothing in the subtree changed.
function monoCloneBody(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  outName: string,
  outType: string,
  outTyIx: i32,
  bN: string[],
  bT: i32[],
) {
  const r = monoCloneBodyRaw(
    ix,
    typarams,
    tvN,
    tvV,
    outName,
    outType,
    outTyIx,
    bN,
    bT,
  )
  // A rebuilt statement keeps the narrowings its original's calls ended (D2390).
  if r != ix { recordClonedCallRetire(ix, r) }
  monoKeepTplHole(ix, r)
  monoNoteCallTpl(ix, r)
  r
}

// The template call each cloned call copies, followed back to the first, so a clone reads the
// checker's binding of the call it stands for (D6743).
let monoCallTpl: {[i32]: i32} = Map()

function monoNoteCallTpl(ix: i32, nx: i32) {
  if nx != ix && ix >= 0 && nx >= 0 && P.nodes[nx] is Call {
    // arena-tick exempt: a clone-to-template side map read only by monoHoleGenFnTy, never by a pass.
    monoCallTpl[nx] = monoCallTplOf(ix)
  }
  0
}

// The call whose bind row answers for call `ix`: `ix`, or the template a clone of it copies.
function monoCallTplOf(ix: i32): i32 { monoCallTpl[ix] ?? ix }

// A rebuilt interpolation hole stays one, which is what renders an atom by its member (D2984).
function monoKeepTplHole(ix: i32, nx: i32) {
  if nx != ix && nx >= 0 && nodeIsTplHole(ix) { mkTplHole(nx) }
  0
}

// The annotation an un-annotated binding of a join the checker kept apart (`T | i32`) takes:
// the join at this pin, so the binding's slot is its own and not one a same-named binding
// declared elsewhere in the body (D2906). -1 otherwise.
function monoTpJoinBindAnn(init: i32, bN: string[], bT: i32[]): i32 {
  if init < 0 { return -1 }
  // A call's result is its callee's rep (D3358), whose box is registered below all the same.
  const isCall = P.nodes[unwrapParen(init)] is Call
  const t = nodeTyIxOf(unwrapParen(init))
  if !tyIsTpJoinUnion(t) { return -1 }
  const st = substTyDeep(t, bN, bT)
  if st < 0 || st >= T.tys.length || tyHasTyVar(st) { return -1 }
  if T.tys[st] is TyUnion && monoListsLitMixed(st) {
    if isCall { return -1 }
    // A literal union's list shares a list rep with another member's, so the box's tags could
    // not tell the two lists apart (D2760).
    emitFailAt(
      "emitProgram: a join of lists with a literal-union element and another element has no lowering at this instance",
      init,
    )
    return -1
  }
  let nm = monoPinUnionName(tyToEmitName(st))
  // A literal union is spelled by its alias, whose rep is the atom; its render is `string`.
  if tyIsLitUnion(nonNullTy(st)) { nm = monoI32AtomPinName(st) }
  if nm == "" { return -1 }
  if monoTyIsUnionOrNulUnion(st) && monoRegisterPinUnion(nm, st) < 0 {
    return -1
  }
  if isCall { return -1 }
  synthTypeRefTy(nm, -1, st)
}

// Whether initializer `init`, typed at a union over a type parameter, is at the pin a union of
// lists mixing a literal-union element with another (D2760).
function monoInitListsLitMixed(init: i32, bN: string[], bT: i32[]): boolean {
  if init < 0 { return false }
  const t = nodeTyIxOf(unwrapParen(init))
  if t < 0 || t >= T.tys.length || !(T.tys[t] is TyUnion) || !tyHasTyVar(t) {
    return false
  }
  const st = substTyDeep(t, bN, bT)
  st >= 0 && st < T.tys.length && T.tys[st] is TyUnion && monoListsLitMixed(st)
}

// Whether `p` is a list or a union of lists whose elements join a literal union with another
// type, the element no instance boxes (D2760).
function monoListsLitMixed(p: i32): boolean {
  if p < 0 || p >= T.tys.length || tyHasTyVar(p) { return false }
  const lists: i32[] = []
  flattenVariantsInto(p, lists)
  const elems: i32[] = []
  for m in lists {
    if m < 0 || m >= T.tys.length { return false }
    const mt = T.tys[m]
    if !(mt is TyArray) { return false }
    flattenVariantsInto(mt.aElem, elems)
  }
  let lit = false
  let other = false
  for e in elems {
    if e < 0 || e >= T.tys.length { return false }
    const et = T.tys[e]
    if tyIsLitUnion(e) || (et is TyLit && et.litKind == "str") { lit = true }
    else if !tyBearsNull(e) { other = true }
  }
  lit && other
}

// Whether `t` is a union or a nullable union, the two shapes a value-union box holds; a
// nullable literal union is a niche, not a box.
function monoTyIsUnionOrNulUnion(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const tt = T.tys[t]
  if tt is TyNullable {
    const inr = tt.nInner
    return inr >= 0
      && inr < T.tys.length
      && T.tys[inr] is TyUnion
      && !tyIsLitUnion(inr)
      && !monoTyAllStringy(inr)
  }
  tt is TyUnion
}

// Whether every member of union `u` is a string literal or a literal union: its nullable is
// the `string | null` niche, not a box.
function monoTyAllStringy(u: i32): boolean {
  const ms: i32[] = []
  flattenVariantsInto(u, ms)
  for m in ms {
    if m < 0 || m >= T.tys.length { return false }
    const mt = T.tys[m]
    let s = tyIsLitUnion(m)
    if mt is TyLit { s = mt.litKind == "str" }
    if !s { return false }
  }
  true
}

// Registers the box of list literal `ix`'s element at its pinned list type `pty` when its template
// element is a join the checker kept apart, so the build finds the box row: 0, or -1 on failure.
function monoTpJoinListElemBox(ix: i32, pty: i32): i32 {
  const t = nodeTyIxOf(ix)
  if t < 0 || t >= T.tys.length || pty < 0 || pty >= T.tys.length { return 0 }
  const tt = T.tys[t]
  if !(tt is TyArray) || !tyIsTpJoinUnion(tt.aElem) { return 0 }
  const pl = T.tys[pty]
  if !(pl is TyArray) || pl.aElem < 0 { return 0 }
  if !(T.tys[pl.aElem] is TyUnion) || tyIsLitUnion(pl.aElem) { return 0 }
  const en = valueUnionRetName(pl.aElem)
  if en == "" { return 0 }
  monoRegisterPinUnion(en, pl.aElem)
}

// The annotation an un-annotated list literal of a join the checker kept apart (`[t, 5]` at
// `(T | i32)[]`) takes where its element is a box at this pin: the build reads its element rep
// off the binding (D2906). -1 otherwise.
function monoTpJoinListLitAnn(initIx: i32, bN: string[], bT: i32[]): i32 {
  if initIx < 0 { return -1 }
  const ix = unwrapParen(initIx)
  if ix < 0 || !(P.nodes[ix] is ArrayLit) { return -1 }
  const t = nodeTyIxOf(ix)
  if t < 0 || t >= T.tys.length { return -1 }
  const tt = T.tys[t]
  if !(tt is TyArray) || !tyIsTpJoinUnion(tt.aElem) { return -1 }
  const st = substTyDeep(t, bN, bT)
  if st < 0 || st >= T.tys.length || tyHasTyVar(st) { return -1 }
  const sl = T.tys[st]
  if !(sl is TyArray) || sl.aElem < 0 { return -1 }
  if !(T.tys[sl.aElem] is TyUnion) || tyIsLitUnion(sl.aElem) { return -1 }
  const en = valueUnionRetName(sl.aElem)
  if en == "" || monoRegisterPinUnion(en, sl.aElem) < 0 { return -1 }
  const nm = monoListSpelling(tyToEmitName(st), st)
  if nm == "" { return -1 }
  synthTypeRefTy(nm, -1, st)
}

// The annotation an un-annotated list literal typed at the instance's holes takes, where its
// element is a union, a nullable or a list: nothing else types such a local's build (D2898). -1
// otherwise.
function monoHoleListLitAnn(initIx: i32): i32 {
  if initIx < 0 || monoCgcHoleN.length == 0 { return -1 }
  const ix = unwrapParen(initIx)
  if ix < 0 || !(P.nodes[ix] is ArrayLit) { return -1 }
  const t = nodeTyIxOf(ix)
  if t < 0 || !tyHasTyVar(t) { return -1 }
  const ht = substTyDeep(t, monoCgcHoleN, monoCgcHoleT)
  if ht < 0 || tyHasTyVar(ht) { return -1 }
  const lt = T.tys[ht]
  if !(lt is TyArray) || lt.aElem < 0 { return -1 }
  const et = T.tys[lt.aElem]
  const nul = et is TyNullable
  const box = et is TyUnion && !tyIsLitUnion(lt.aElem)
  if !box && !nul && !(et is TyArray) { return -1 }
  const nm = monoListSpelling(tyToEmitName(ht), ht)
  if nm == "" { return -1 }
  monoHoleListLitTy = -1
  if nul { monoHoleListLitTy = ht }
  synthTypeRefTy(nm, -1, ht)
}

// The instance type `monoHoleListLitAnn`'s last annotation gave a nullable element, whose
// literal is re-made at that type: the build reads its element rep off the literal, and the
// template's casts the null away (D2899). -1 for any other element.
let monoHoleListLitTy = -1

// The list literal `initIx` re-made at `monoHoleListLitTy`, or `initIx` when there is none.
function monoHoleListLitCopy(initIx: i32): i32 {
  const t = monoHoleListLitTy
  monoHoleListLitTy = -1
  if t < 0 { return initIx }
  const ix = unwrapParen(initIx)
  if ix < 0 { return initIx }
  const n = P.nodes[ix]
  if n is ArrayLit {
    const nx = monoCopyOf(ix, mkArrayLit(n.arrElems, n.pos))
    nodeTyRecord(nx, t)
    return nx
  }
  initIx
}

// A for-in's list literal typed at the instance's holes, re-made at the instance type where
// `monoHoleListLitAnn` would annotate it as a binding: no binding types its build (D3014).
function monoHoleIterLitCopy(iterIx: i32): i32 {
  if monoHoleListLitAnn(iterIx) < 0 { return iterIx }
  const ix = unwrapParen(iterIx)
  if ix < 0 { return iterIx }
  const n = P.nodes[ix]
  if n is ArrayLit {
    const nx = monoCopyOf(ix, mkArrayLit(n.arrElems, n.pos))
    nodeTyRecord(nx, substTyDeep(nodeTyIxOf(ix), monoCgcHoleN, monoCgcHoleT))
    monoHoleListLitTy = -1
    return nx
  }
  iterIx
}

// An un-annotated binding of `Map<K, V>()` / `Set<T>()` whose type arguments name a type
// parameter: the constructor's arguments become the binding's annotation, substituted for
// this instance exactly as a written `{[K]: V}` would be. -1 when there is nothing to pin.
function monoCollCtorAnn(
  initIx: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
): i32 {
  if initIx < 0 { return -1 }
  const ix = unwrapParen(initIx)
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const c = P.nodes[ix]
  if c is Call {
    const f = P.nodes[c.callFn]
    if f is Ident {
      const tas = callTyArgsOf(ix)
      let name = ""
      if f.identName == "Map" && tas.length == 2 {
        name = "{[" + tyNameOf(tas[0]) + "]:" + tyNameOf(tas[1]) + "}"
      } else if f.identName == "Set" && tas.length == 1 {
        name = "{[" + tyNameOf(tas[0]) + "]:boolean}"
      } else if tas.length > 0 {
        name = monoTyArgCallRetName(f.identName, tas)
      }
      if name == "" { return -1 }
      if !monoAnnHasTyParam(name, typarams) { return -1 }
      const sub = monoSubstAnn(name, typarams, tvN, tvV)
      if sub == "" { return -1 }
      return synthTypeRefTy(sub, c.pos, -1)
    }
  }
  -1
}

// The declared return spelling of the generic `callee`, its type parameters replaced by the
// call's written type arguments (`make<T>()` against `(): T[]` is `T[]`), or "".
function monoTyArgCallRetName(callee: string, tas: i32[]): string {
  const dIx = uniqueGenericDeclNamed(callee, tas.length)
  if dIx < 0 { return "" }
  const d = P.nodes[dIx]
  if d is FuncDecl {
    if d.fnRet < 0 { return "" }
    const argNames: string[] = []
    let i = 0
    while i < tas.length {
      argNames.push(tyNameOf(tas[i]))
      i = i + 1
    }
    const ret = monoDeclAnnName(d.fnRet, tyNameOf(d.fnRet), d.fnTyParams)
    return monoSubstAnn(ret, d.fnTyParams, d.fnTyParams, argNames)
  }
  ""
}

function monoCloneBodyRaw(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  outName: string,
  outType: string,
  outTyIx: i32,
  bN: string[],
  bT: i32[],
) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Block {
    const ns: i32[] = []
    let changed = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoCloneBody(
        n.blkStmts[i],
        typarams,
        tvN,
        tvV,
        outName,
        outType,
        outTyIx,
        bN,
        bT,
      )
      ns.push(cs)
      if cs != n.blkStmts[i] { changed = true }
      i = i + 1
    }
    if !changed { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is LetDecl {
    return monoCloneLetDecl(
      n,
      ix,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
  }
  if n is WhileStmt {
    const cb = monoCloneBody(
      n.whileBody,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    if cb == n.whileBody { return ix }
    return mkWhileAs(n, n.whileCond, cb)
  }
  if n is IfStmt {
    return monoCloneIfChain(
      ix,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
  }
  if n is ForRange {
    const cb = monoCloneBody(
      n.frBody,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    if cb == n.frBody { return ix }
    return mkForRange(
      n.frVar,
      n.frFrom,
      n.frTo,
      n.frStep,
      n.frExcl,
      cb,
      n.frLabel,
      n.pos,
    )
  }
  if n is ForIn {
    const cb = monoCloneBody(
      n.fiBody,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    const ci = monoHoleIterLitCopy(n.fiIter)
    if cb == n.fiBody && ci == n.fiIter { return ix }
    return mkForIn(n.fiVar, n.fiVar2, ci, cb, n.fiLabel, n.pos)
  }
  if n is RetStmt {
    // The return value may be a block or `if` expression carrying its own `LetDecl`s.
    const ca = monoCloneBody(
      n.retArg,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  if n is Paren {
    const ci = monoCloneBody(
      n.parInner,
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    )
    if ci == n.parInner { return ix }
    return mkParen(ci, n.pos)
  }
  // A pure expression / other statement carries no `LetDecl` annotation to rewrite — share.
  ix
}

// `monoCloneBodyRaw`'s arm for the binding `n` at `ix`: its instance annotation.
function monoCloneLetDecl(
  n: LetDecl,
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  outName: string,
  outType: string,
  outTyIx: i32,
  bN: string[],
  bT: i32[],
): i32 {
  let nt = monoSubstLetType(n.letType, typarams, tvN, tvV, bN, bT)
  // The inferred-list-return local (`const out = []`): annotate its empty build with the
  // pinned element type, per instance. Clones only this `LetDecl` and its enclosing
  // Block, never the shared original.
  if nt < 0 {
    if outName != "" {
      if n.letName == outName {
        // The out type row is threaded down beside its spelling, so the substituted
        // annotation is minted from the type. Every spelling reaching here is a
        // composite, and `nameToTy` does not hash-cons one.
        nt = synthTypeRefTy(outType, -1, outTyIx)
      }
    }
  }
  // The closure-pin rungs, for the same reason and at the same moment: an un-annotated
  // container over a pinned parameter has no other source for its element type (D1664).
  if nt < 0 { nt = monoCollCtorAnn(n.letInit, typarams, tvN, tvV) }
  if nt < 0 { nt = monoCloPinListAnn(n.letInit) }
  if nt < 0 { nt = monoCloPinShapeAnn(n.letInit) }
  if nt < 0 && monoInitListsLitMixed(n.letInit, bN, bT) {
    emitFailAt(
      "emitProgram: a join of lists with a literal-union element and another element has no lowering at this instance",
      n.letInit,
    )
  }
  if nt < 0 { nt = monoApartJoinAnn(n.letInit, bN, bT) }
  if nt < 0 { nt = monoTpJoinListLitAnn(n.letInit, bN, bT) }
  if nt < 0 { nt = monoTpJoinBindAnn(n.letInit, bN, bT) }
  if nt < 0 { nt = monoPushedListAnn(n.letInit, bN, bT) }
  let ninit = n.letInit
  if nt < 0 {
    nt = monoHoleListLitAnn(n.letInit)
    if nt >= 0 { ninit = monoHoleListLitCopy(n.letInit) }
  }
  if nt == n.letType { return ix }
  return monoCopyOf(ix, mkLet(n.letKw, n.letName, nt, ninit, n.pos))
}

// `monoCloneBodyRaw`'s arm for the `if` chain at `ix`.
function monoCloneIfChain(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  outName: string,
  outType: string,
  outTyIx: i32,
  bN: string[],
  bT: i32[],
): i32 {
  // An `else if` chain is rewritten along its spine, so its depth costs no stack (D1990).
  const links = monoIfChainLinks(ix)
  const ccs: i32[] = []
  const cts: i32[] = []
  let k = 0
  while k < links.length {
    const c = P.nodes[links[k]]
    if c is IfStmt {
      ccs.push(c.ifCond)
      cts.push(
        monoCloneBody(
          c.ifThen,
          typarams,
          tvN,
          tvV,
          outName,
          outType,
          outTyIx,
          bN,
          bT,
        ),
      )
    }
    k = k + 1
  }
  return monoIfChainRebuild(
    links,
    ccs,
    cts,
    monoCloneBody(
      monoIfChainElse(links),
      typarams,
      tvN,
      tvV,
      outName,
      outType,
      outTyIx,
      bN,
      bT,
    ),
  )
}

// Whether an inline `.map` callback PRESERVES the element type — its tail expression is
// arithmetic / concatenation over the element (`x => x * 2`, `s => s + "!"`), so the result
// element type equals the source element. Lets the monomorphizer set a concrete map-result
// return annotation, since the inferred-return path has no f64/string-array map-result form.
function monoLambdaPreservesElem(argIx: i32) {
  const fnNodeIx = unwrapParen(argIx)
  const a = P.nodes[fnNodeIx]
  if a is FuncDecl {
    const tail = fnRetExprOf(fnNodeIx)
    if tail >= 0 {
      const t = P.nodes[unwrapParen(tail)]
      if t is BinExpr {
        const op = t.binOp
        return op == "+" || op == "-" || op == "*" || op == "/"
      }
    }
  }
  false
}

// The element type of `recvIx` when it is (a paren around) a parameter reference whose
// pinned type is an array — looked up in the instance's (pNames → pElems) map; "" for
// anything else. Pins a `.map`/`.filter` callback's element from this instance's receiver.
function monoRecvParamElem(
  recvIx: i32,
  pNames: string[],
  pElems: string[],
  pElemTys: i32[],
  outTy: i32[],
) {
  const r = P.nodes[unwrapParen(recvIx)]
  if r is Ident {
    let i = 0
    while i < pNames.length {
      if pNames[i] == r.identName {
        // The element row rides out beside the element name, from the column built
        // parallel to `pElems`, so the caller never has to recover the row by re-parsing
        // the name this returns.
        if i < pElemTys.length { outTy.push(pElemTys[i]) }
        return pElems[i]
      }
      i = i + 1
    }
  }
  ""
}

// The element an `is K[]` arm reads its receiver `recvIx` at, when the instance pinned that
// receiver's element to `pinEl`, which can never be `K`'s: the arm reads an empty `K[]` in its
// place (D4993). -1 when the read is the receiver's own list.
function monoFitArmElem(recvIx: i32, pinEl: i32): i32 {
  if pinEl < 0 { return -1 }
  const t = nodeTyIxOf(unwrapParen(recvIx))
  if t < 0 || t >= T.tys.length || tyHasTyVar(t) { return -1 }
  const a = T.tys[t]
  if !(a is TyArray) || !tyLeavesDisjoint(pinEl, a.aElem) { return -1 }
  a.aElem
}

// The name a callback parameter pinned at arm element `el` is annotated with: a record's
// interned row, a primitive's own name, or "" where `el` is -1 or neither.
function monoFitArmElemName(el: i32): string {
  if el < 0 || el >= T.tys.length { return "" }
  if T.tys[el] is TyObj { return monoRetRowName(el) }
  tyPrimNameOf(el) ?? ""
}

// Clone an inline `.map`/`.filter` callback lambda with its single un-annotated parameter
// pinned to `elemType`, lift the clone into `fnStmts`, and return its node index — or -1
// when the argument is not a cloneable un-annotated 1-param lambda. The body is shared:
// the emitter re-derives every operand type from the now-concrete parameter per function.
function monoCloneLambdaPinned(argIx: i32, elemType: string, elemTyIx: i32) {
  const a = P.nodes[unwrapParen(argIx)]
  if a is FuncDecl {
    if a.fnParams.length == 1 {
      const p0 = P.nodes[a.fnParams[0]]
      if p0 is Param {
        if p0.parType < 0 {
          const np = mkParam(
            p0.parName,
            synthTypeRefTy(elemType, -1, elemTyIx),
            p0.parDefault,
            p0.parOpt,
            p0.parRest,
            p0.pos,
          )
          identFrom(np, a.fnParams[0])
          // The pinned element row is handed over rather than re-parsed out of the
          // element name: `pElemTys` is built beside `pElems` from the same pin, so the
          // row reaches this mint without the name being turned back into a type.

          const nm = "__lambda_" + i32ToStr(lambdaCtr)
          lambdaCtr = lambdaCtr + 1
          const noTP: string[] = []
          const ps: i32[] = [np]
          const clone = mkFunc(nm, noTP, ps, a.fnRet, a.fnBody, a.pos)
          identOrigNote(clone, unwrapParen(argIx))
          recordClonedCallRetire(unwrapParen(argIx), clone)
          fnStmts.push(clone)
          fnParent.push(-1)
          fnDispNames.push("")
          fnValUsed = true
          fnNestUsed = true
          return clone
        }
      }
    }
  }
  -1
}

// ── a lambda declared inside a generic body is a template (D426) ─────────────

// `collectFns` runs before `monomorphize` and lifts `const g = (x: T[]) => …` once, with
// the enclosing function's `T` still on its parameters, so one lifted slot serves every
// instance at the unsubstituted type. The two sites below close that: substitute at the
// pin, and stop emitting the template (the prune at the end of `monomorphize`).

// One annotation node, substituted through this instance's binding: a fresh `TypeRef`
// when a type parameter substitutes (`T[]` → `f64[]`), or -1 for "nothing to do" — the
// annotation is absent, already concrete, or names a type parameter this instance could
// not bind. The substituted type rides along, gated on `tyHasTyVar` as at every such site.
function monoSubstAnnNode(
  pty: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  if pty < 0 { return -1 }
  const tn = P.nodes[pty]
  if tn is TypeRef {
    // The RAW spelling where a type parameter is shadowed by a declared alias — the same
    // read every other substitution site in this file takes, for `monoDeclAnnName`'s reason.
    const ann = monoDeclAnnName(pty, tn.tyName, typarams)
    if monoAnnHasTyParam(ann, typarams) {
      const sub = monoSubstAnn(ann, typarams, tvN, tvV)
      // -2, not -1: the annotation does name a type parameter and the substitution
      // produced no new spelling for it, which the caller must tell apart from an
      // already-concrete one: the prune must not stub a template still called by name.
      if sub == "" { return -2 }
      if sub == tn.tyName { return -2 }
      let sty = -1
      const orig = nodeTyIxOf(pty)
      if orig >= 0 {
        const s2 = substTyDeep(orig, bN, bT)
        if s2 >= 0 && s2 != orig {
          if !tyHasTyVar(s2) { sty = s2 }
        }
      }
      return synthTypeRefTy(sub, tn.pos, sty)
    }
  }
  -1
}

function monoNoteLamNode(xs: i32[], v: i32) {
  if !i32ListHas(xs, v) { xs.push(v) }
  0
}

// D1116 — the lifted slots minted while walking one lambda's body belong to that lambda's
// clone, not to the enclosing instance: a nested clone's free names resolve up the chain
// through the lambda that encloses it, and `captureValKind` types an env field by that
// chain. Re-point the run from `mark` on, then retire each entry so nothing undoes it.
function monoReparentNestedLams(mark: i32, parentSlot: i32) {
  let k = mark
  let wrote = false
  while k < monoLamMintedSlots.length {
    const s = monoLamMintedSlots[k]
    if s >= 0 && s < fnParent.length {
      buildFnMapNoteFnSlotWrite()
      fnParent[s] = parentSlot
      wrote = true
    }
    // arena-tick exempt: this module's own scratch list of slots already re-pointed, read by no pass.
    monoLamMintedSlots[k] = -1
    k = k + 1
  }
  if wrote {
    monoArenaTouch()
    invalidateFnChildIndex()
  }
  0
}

// The lexical frame a lifted function's slot records (`fnParent`), found from its arena node.
// -1 when the node holds no lifted slot, which is the value `collectFns` itself pushes for a
// module-scope lift.
function monoLamParentOf(fnIx: i32) {
  let i = 0
  while i < fnStmts.length {
    if fnStmts[i] == fnIx {
      if i < fnParent.length { return fnParent[i] }
      return -1
    }
    i = i + 1
  }
  -1
}

// A synthesized annotation for un-annotated parameter `pi` of lambda `fnIx`, at the instance
// binding `bN`/`bT`: its inferred type substituted, where that names the type parameter and
// leaves none. -1 for an annotated parameter or one whose type needs no pin.
function monoLamParamPinAnn(
  fnIx: i32,
  pi: i32,
  parType: i32,
  bN: string[],
  bT: i32[],
) {
  if parType >= 0 { return -1 }
  const lty = nodeTyIxOf(fnIx)
  if lty < 0 || lty >= T.tys.length { return -1 }
  const lt = T.tys[lty]
  if lt is TyFunc {
    if pi >= lt.fnParamTypes.length { return -1 }
    const pty = lt.fnParamTypes[pi]
    if pty < 0 || !tyHasTyVar(pty) { return -1 }
    let st = substTyDeep(pty, bN, bT)
    // A type variable of another declaration (the generic initializing the binding) is
    // pinned by the calls the lambda's value reaches in this instance (D7181).
    if st >= 0 && tyHasTyVar(st) { st = monoLamReachParamTy(fnIx, pi, bN, bT) }
    if st < 0 || tyHasTyVar(st) { return -1 }
    const nm = monoPinAnnSpelling(st)
    if nm == "" { return -1 }
    return synthTypeRefTy(nm, -1, st)
  }
  -1
}

// Parameter `pi`'s type, or with `pi` -1 the result's, in the one call type lambda `fnIx`'s
// value reaches at instance binding `bN`/`bT` (`vrCalleeTy`); -1 when it reaches no one type.
function monoLamReachParamTy(fnIx: i32, pi: i32, bN: string[], bT: i32[]): i32 {
  if !vrIndexed(fnIx) { return -1 }
  const ct = vrCalleeTy(fnIx, "", bN)
  if ct < 0 || ct >= T.tys.length { return -1 }
  const f = T.tys[ct]
  if f is TyFunc {
    if pi < 0 { return substTyDeep(f.fnRet, bN, bT) }
    if pi < f.fnParamTypes.length {
      return substTyDeep(f.fnParamTypes[pi], bN, bT)
    }
  }
  -1
}

// The annotation spelling of a pinned lambda type `t`: a list by `monoListSpelling`, which names
// a nullable record element by its row; a literal union by its alias, which a render softens to
// `string` (D3098); any other type as `tyToEmitName` renders it.
function monoPinAnnSpelling(t: i32): string {
  // A record bound apart from its row by a function field's type is still spelled by the row.
  const tw = monoFnFieldTwinRow.get(t) ?? ""
  if tw != "" { return tw }
  if tyIsLitUnion(t) {
    const ln = litUnionAliasNameOfTy(t)
    if ln != "" && monoAnnPinName(ln) == ln { return ln }
  }
  const nm = tyToEmitName(t)
  if nm != "" && t >= 0 && t < T.tys.length && T.tys[t] is TyArray {
    return monoListSpelling(nm, t)
  }
  nm
}

// Clone the lifted lambda at `fnIx` with every type-param-mentioning parameter and return
// annotation substituted through this instance's binding, lift the clone into `fnStmts`,
// and return its node index — or -1 when nothing substitutes. The body is shared with the
// original: the emitter re-derives every operand type from the now-concrete parameter.
function monoCloneLambdaSubst(
  fnIx: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN0: string[],
  bT0: i32[],
) {
  const a = P.nodes[fnIx]
  if a is FuncDecl {
    let bN = bN0
    let bT = bT0
    if monoPinHoleN.length > 0 {
      bN = []
      bT = []
      monoJoinBinding(bN0, bT0, monoPinHoleN, monoPinHoleT, bN, bT)
    }
    // A nested generic declaration carries pins of its own and is instantiated by
    // `monoInstantiate` at its own call sites; only a lambda that inherited the enclosing
    // frame's type parameters is this pass's business.
    if a.fnTyParams.length > 0 { return -1 }
    // Not a template at all — every annotation is concrete, so one lifted function is
    // correct at every pin. Returned before either ledger is touched: the prune reads them
    // to decide whether a template is still referenced, and a lambda that never became a
    // template must not appear in either.
    if !monoLamNodeIsTemplateCore(fnIx, typarams) { return -1 }
    const ps: i32[] = []
    const psAny = monoLamSubstParams(a, fnIx, typarams, tvN, tvV, bN, bT, ps)
    if psAny < 0 { return -1 }
    let any = psAny > 0
    let nret = a.fnRet
    const rt = monoSubstAnnNode(a.fnRet, typarams, tvN, tvV, bN, bT)
    if rt >= 0 {
      nret = rt
      any = true
    } else if rt == -2 {
      monoNoteLamNode(monoLamShared, fnIx)
      return -1
    }
    // D943 — `any` asks whether a signature changed, and a capture-only template changes
    // none. The clone still has to happen: its purpose here is a fresh lifted slot, since
    // `fnEnvIdx` is parallel to `fnStmts` and one slot means one env struct for every
    // instance. `() => string` capturing a `T` substitutes nothing and needs its own env.
    let capOnly = false
    if !any {
      const feC = monoSlotOfLamNode(fnIx)
      if feC >= 0 {
        if captureCountOf(feC) > 0 { capOnly = true }
      }
    }
    // D1220 — a body spelling is the third reason to clone, and the two rungs above read
    // only the signature: `() => gv is T` takes no parameter, annotates no return and
    // captures nothing. Sharing one body then answers the first pin's spelling at every
    // pin. `monoLamNodeIsTemplate`'s fourth rung asks the same question and must agree.
    let bodyTP = false
    if !any && !capOnly {
      if monoNodeNamesTyParam(a.fnBody, typarams) { bodyTP = true }
    }
    if !any && !capOnly && !bodyTP {
      monoNoteLamNode(monoLamShared, fnIx)
      return -1
    }
    // An un-annotated return that rides the type parameter, annotated at the pin. The
    // checker records an anonymous lambda's inferred return under its node index and the
    // clone is a node it never saw, so the return expression's own recorded type is the
    // fact, substituted through the same binding. Gated on the type carrying a variable.
    if nret < 0 {
      nret = monoLamPinRetAnn(fnIx, nret, bN, bT)
      if nret == -2 { return -1 }
    }
    // D1046 — a nested named function keeps its name. An anonymous lambda is reached
    // through the value the clone is written into, so a minted `__lambda_N` is invisible;
    // a nested `function id(a: T): T` is reached by name through the frame chain, and
    // renaming it would leave every call in the instance body resolving to nothing.
    let nm = a.fnName
    if !monoFnNameIsSourceNamed(nm) {
      nm = "__lambda_" + i32ToStr(lambdaCtr)
      lambdaCtr = lambdaCtr + 1
    }
    const noTP: string[] = []
    // D951 — an `is T` inside the lambda's body. The body is otherwise shared with the
    // template, which is right for every operand the emitter re-derives from the
    // now-concrete parameter and wrong for an `is`, whose check type is a spelling the
    // body carries. Copy-on-write, so a lambda with no such spelling keeps sharing.
    const nbodyF = monoFoldTyParamLayout(a.fnBody, typarams, tvN, tvV)
    // D1116 — a lambda nested inside this one is a template too, and `monoPinBodyLambdas`
    // walks only the instance body's spine, stopping at a `FuncDecl` initializer.
    // Recursing here rather than teaching that walk a `FuncDecl` arm keeps the two facts a
    // clone owns together: the body substitution above and the frame its clones hang off.
    const mark = monoLamMintedSlots.length
    const nbodyL = monoPinBodyLambdas(nbodyF, typarams, tvN, tvV, bN, bT)
    // A generic call in the body is instantiated by rewriting its callee in place, so each
    // clone takes its own copy, as an instance body does (D2553).
    const nbody = monoLamCloneGenericCalls(nbodyL, typarams, tvN, tvV, bN, bT)
    // The lambda twin of the named clone's rule: a bare `return` in the body is void, so the
    // return-expression pin above must not give this instance a result (D1600).
    let cloneRet = nret
    if a.fnRet < 0 && blockHasBareReturn(a.fnBody) { cloneRet = -1 }
    const clone = mkFunc(nm, noTP, ps, cloneRet, nbody, a.pos)
    identOrigNote(clone, fnIx)
    // The clone is a value too, typed at this pin where the template's type substitutes.
    const cty = monoPinnedTyOf(fnIx, bN, bT)
    if cty >= 0 && !tyHasTyVar(cty) { nodeTyRecord(clone, cty) }
    // A lifted clone answers what its template did, the captures it widened included (D2402).
    recordClonedCallRetire(fnIx, clone)
    return monoLamInstallClone(a, fnIx, clone, mark)
  }
  -1
}

// `monoCloneLambdaSubst`'s body step: copies the direct generic calls in `nbodyL` for this
// instance (`typarams`/`tvN`/`tvV`, binding `bN`/`bT`), then restores the enclosing copy's
// state. Returns the copied body, or `nbodyL` when it makes no generic call.
function monoLamCloneGenericCalls(
  nbodyL: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  const svCgcP = monoCgcTyParams
  const svCgcN = monoCgcTvN
  const svCgcV = monoCgcTvV
  monoCgcTyParams = typarams
  monoCgcTvN = tvN
  monoCgcTvV = tvV
  const svCgcBN = monoCgcBN
  const svCgcBT = monoCgcBT
  monoCgcBN = bN
  monoCgcBT = bT
  const nbody = monoCloneGenericCalls(nbodyL)
  monoCgcBN = svCgcBN
  monoCgcBT = svCgcBT
  monoCgcTyParams = svCgcP
  monoCgcTvN = svCgcN
  monoCgcTvV = svCgcV
  nbody
}

// `monoCloneLambdaSubst`'s parameter step: appends to `ps` each parameter of the lambda `a` at
// `fnIx`, substituted through this instance where its annotation or inferred type rides a type
// parameter. Returns 1 when one changed, 0 when none did, and -1, after noting the template
// shared, when one cannot be substituted.
function monoLamSubstParams(
  a: FuncDecl,
  fnIx: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
  ps: i32[],
) {
  let any = 0
  let i = 0
  while i < a.fnParams.length {
    const p = P.nodes[a.fnParams[i]]
    if p is Param {
      const nt = monoSubstAnnNode(p.parType, typarams, tvN, tvV, bN, bT)
      if nt >= 0 {
        ps.push(
          monoCopyOf(
            a.fnParams[i],
            mkParam(p.parName, nt, p.parDefault, p.parOpt, p.parRest, p.pos),
          ),
        )
        any = 1
      } else if nt == -2 {
        // The annotation names a type parameter this instance cannot substitute. The
        // template stays, this instance keeps calling it, and the `checkParams` floor
        // refuses loudly — which is why the prune has to be told.
        monoNoteLamNode(monoLamShared, fnIx)
        return -1
      } else {
        // An un-annotated parameter the checker inferred at the type parameter (a `.filter`
        // callback over a `T[]`) is annotated at this pin, since nothing else lowers it.
        const ipn = monoLamParamPinAnn(fnIx, i, p.parType, bN, bT)
        if ipn >= 0 {
          ps.push(
            monoCopyOf(
              a.fnParams[i],
              mkParam(p.parName, ipn, p.parDefault, p.parOpt, p.parRest, p.pos),
            ),
          )
          any = 1
        } else {
          // Unchanged — share the original `Param` node, so a lambda with one generic
          // and one concrete parameter mints exactly one node.
          ps.push(a.fnParams[i])
        }
      }
    } else {
      monoNoteLamNode(monoLamShared, fnIx)
      return -1
    }
    i = i + 1
  }
  any
}

// `monoCloneLambdaSubst`'s return step for the un-annotated lambda at `fnIx`: the return
// annotation its recorded return type takes through binding `bN`/`bT`, or `nret` when none
// applies. Returns -2 when the pinned union cannot be registered.
function monoLamPinRetAnn(fnIx: i32, nret: i32, bN: string[], bT: i32[]) {
  const rex = fnRetExprOf(fnIx)
  let rty = -1
  if rex >= 0 { rty = nodeTyIxOf(rex) }
  // A tail `if` or `match` is no return expression: the template's checked signature
  // holds its join, as the named clone's does.
  if rex < 0 { rty = monoLamCheckedRet(fnIx) }
  // A join kept apart over the body's parameters (D3520), or one holding a concrete arm
  // beside a hole (`string | _`, D3125), is the signature whatever the last arm's own
  // type: callers re-join it at the pin the same way.
  const kept = monoLamCheckedRet(fnIx)
  const keptJoin = kept >= 0
    && (tyIsTpJoinUnion(kept) || tyIsArmedDeferredJoin(kept))
  if keptJoin { rty = kept }
  if rty >= 0 && tyHasTyVar(rty) {
    let rs = substTyDeep(rty, bN, bT)
    if rs >= 0 && tyHasTyVar(rs) {
      const rr = monoLamReachParamTy(fnIx, -1, bN, bT)
      if rr >= 0 { rs = rr }
    }
    if monoRetReadsHoleParam(rex, fnIx) { rs = monoHoleTy(rs) }
    if rs >= 0 && rs != rty {
      const litGate = rex < 0 && monoTyHasLitMember(rs) && !keptJoin
      if !tyHasTyVar(rs) && !litGate {
        const rnm = monoPinAnnSpelling(rs)
        // The box a kept-apart join returns is registered here, as an instance return's is.
        if (
          rnm != ""
          && keptJoin
          && monoTyIsUnionOrNulUnion(rs)
          && !monoTyHoldsRefArm(rs)
        ) {
          if monoRegisterPinUnion(rnm, rs) < 0 { return -2 }
        }
        if rnm != "" { return synthTypeRefTy(rnm, -1, rs) }
      }
    }
  }
  nret
}

// `monoCloneLambdaSubst`'s last step: lifts `clone`, the instance of the lambda template `a`
// at `fnIx`, into its own `fnStmts` slot and re-parents the lambdas minted since `mark`.
// Returns `clone`.
function monoLamInstallClone(a: FuncDecl, fnIx: i32, clone: i32, mark: i32) {
  // D1046 — the first instance of a named nested function replaces the template's slot
  // rather than pushing beside it: the by-name lookup takes the first child of the
  // frame, so two same-named children mean the call answers the unsubstituted template.
  // Later instances push and are re-pointed at their own frame by the caller.
  if monoFnNameIsSourceNamed(a.fnName) && monoInstIsFirst {
    const tSlot = monoSlotOfLamNode(fnIx)
    if tSlot >= 0 {
      buildFnMapNoteFnStmtWrite(tSlot, clone)
      fnStmts[tSlot] = clone
      monoArenaTouch()
      monoNamedTmplNode.push(fnIx)
      monoNamedTmplSlot.push(tSlot)
      monoReparentNestedLams(mark, tSlot)
      fnValUsed = true
      fnNestUsed = true
      monoNoteLamNode(monoLamPinned, fnIx)
      return clone
    }
  }
  fnStmts.push(clone)
  // The original's frame, not module scope. The clone shares the body, so its free names
  // have to resolve up the same scope chain or a lambda that both captures and annotates
  // `T` loses its environment. (`monoCloneLambdaPinned` pushes -1 because a `.map`
  // callback is rebuilt from an argument position, not from a lifted slot of its own.)
  fnParent.push(monoLamParentOf(fnIx))
  const mySlot = fnStmts.length - 1
  const tmplSlot = monoSlotOfLamNode(fnIx)
  monoCloneKeepsHoles(tmplSlot, mySlot, clone)
  lfNoteClone(mySlot, tmplSlot)
  monoReparentNestedLams(mark, mySlot)
  monoLamMintedSlots.push(mySlot)
  monoLamCloneSlots.push(mySlot)
  fnDispNames.push("")
  fnValUsed = true
  fnNestUsed = true
  monoNoteLamNode(monoLamPinned, fnIx)
  clone
}

// A clone at `slot` of the lambda at `tmplSlot` whose own parameters are still holes is
// instantiated per call, as its template is: the capture that made it a template does not
// pin them (D2854). Slots appended since the snapshot are concrete instances.
function monoCloneKeepsHoles(tmplSlot: i32, slot: i32, clone: i32) {
  if tmplSlot < 0 || tmplSlot >= monoGen.length || monoGen[tmplSlot] != 1 {
    return 0
  }
  if !monoIsGenericDecl(clone) { return 0 }
  while monoGen.length < slot {
    monoOrigNode.push(fnStmts[monoGen.length])
    monoGen.push(0)
  }
  if monoGen.length == slot {
    monoOrigNode.push(clone)
    monoGen.push(1)
  }
  0
}

// Per-instance lambda monomorphization for a generic body: every lambda literal still naming
// a type parameter is substituted at this pin, in any position (D2551). Copy-on-write, and a
// rebuilt node answers the narrowing retirements its original did (D2390's banks).
function monoPinBodyLambdas(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  const r = monoPinBodyLambdasRaw(ix, typarams, tvN, tvV, bN, bT)
  if r != ix { recordClonedCallRetire(ix, r) }
  r
}

function monoPinBodyLambdasRaw(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  if ix < 0 { return ix }
  // Whether the parent delivers this value where a union at the pin lowers (`monoPinSink`).
  const sink = monoPinSink
  monoPinSink = false
  const n = P.nodes[ix]
  if n is Block {
    const ns: i32[] = []
    let changed = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoPinBodyLambdas(n.blkStmts[i], typarams, tvN, tvV, bN, bT)
      ns.push(cs)
      if cs != n.blkStmts[i] { changed = true }
      i = i + 1
    }
    if !changed { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is LetDecl {
    monoPinSink = n.letType < 0 && !(monoPinUnsafeNames.get(n.letName) ?? false)
    const savedReach = monoPinLetReaches
    monoPinLetReaches = monoPinReachNames.get(n.letName) ?? false
    const ci = monoPinValueLambda(n.letInit, typarams, tvN, tvV, bN, bT)
    monoPinLetReaches = savedReach
    monoPinSink = false
    // A binding inside an expression (an `if` arm's prelude), which the statement clone does
    // not reach, has its annotation substituted here.
    const nt = monoSubstLetType(n.letType, typarams, tvN, tvV, bN, bT)
    if ci == n.letInit && nt == n.letType { return ix }
    return monoCopyOf(ix, mkLet(n.letKw, n.letName, nt, ci, n.pos))
  }
  // D1046 — a nested named `function` statement is the declaration form of the same
  // thing, and `collectFns` lifts it exactly like a lambda. The statement itself emits
  // nothing (`wasmEmit.emitStmt`'s `FuncDecl` arm), so the node returned is immaterial —
  // the lifted slot is the whole effect, and the statement is returned unchanged.
  if n is FuncDecl {
    if monoFnNameIsSourceNamed(n.fnName) {
      monoCloneLambdaSubst(ix, typarams, tvN, tvV, bN, bT)
      return ix
    }
    // An anonymous lambda reached here is a block's tail value (D2525).
    const acl = monoCloneLambdaSubst(ix, typarams, tvN, tvV, bN, bT)
    if acl >= 0 { return acl }
    return ix
  }
  if n is RetStmt {
    const ca = monoPinValueLambda(n.retArg, typarams, tvN, tvV, bN, bT)
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  if n is WhileStmt {
    const cc = monoPinValueLambda(n.whileCond, typarams, tvN, tvV, bN, bT)
    const cb = monoPinBodyLambdas(n.whileBody, typarams, tvN, tvV, bN, bT)
    if cc == n.whileCond && cb == n.whileBody { return ix }
    return mkWhileAs(n, cc, cb)
  }
  if n is IfStmt {
    // An `else if` chain is rewritten along its spine, so its depth costs no stack (D1990).
    const links = monoIfChainLinks(ix)
    const ccs: i32[] = []
    const cts: i32[] = []
    let k = 0
    while k < links.length {
      const c = P.nodes[links[k]]
      if c is IfStmt {
        ccs.push(monoPinValueLambda(c.ifCond, typarams, tvN, tvV, bN, bT))
        cts.push(monoPinBodyLambdas(c.ifThen, typarams, tvN, tvV, bN, bT))
      }
      k = k + 1
    }
    return monoIfChainRebuildPinned(
      links,
      ccs,
      cts,
      monoPinBodyLambdas(
        monoIfChainElse(links),
        typarams,
        tvN,
        tvV,
        bN,
        bT,
      ),
      bN,
      bT,
      sink,
    )
  }
  if n is ForRange {
    const ff = monoPinValueLambda(n.frFrom, typarams, tvN, tvV, bN, bT)
    const ft = monoPinValueLambda(n.frTo, typarams, tvN, tvV, bN, bT)
    const fs = monoPinValueLambda(n.frStep, typarams, tvN, tvV, bN, bT)
    const cb = monoPinBodyLambdas(n.frBody, typarams, tvN, tvV, bN, bT)
    if ff == n.frFrom && ft == n.frTo && fs == n.frStep && cb == n.frBody {
      return ix
    }
    return mkForRange(n.frVar, ff, ft, fs, n.frExcl, cb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const fi = monoPinValueLambda(n.fiIter, typarams, tvN, tvV, bN, bT)
    const cb = monoPinBodyLambdas(n.fiBody, typarams, tvN, tvV, bN, bT)
    if fi == n.fiIter && cb == n.fiBody { return ix }
    return mkForIn(n.fiVar, n.fiVar2, fi, cb, n.fiLabel, n.pos)
  }
  const ks = monoExprKids(ix)
  // A read of a binding typed at a join the checker kept apart takes the join at this pin: the
  // binding's name can be declared again elsewhere in the body at another type (D2906).
  // So does a read of a place holding a written type-parameter value: the member it reads at
  // is the pin's (D3240).
  if (
    n is Ident
    && (tyIsTpJoinUnion(nodeTyIxOf(ix)) || tyIsWriteLandRead(nodeTyIxOf(ix)))
  ) {
    return monoPinRetype(ix, bN, bT)
  }
  if ks.length == 0 { return ix }
  const nks: i32[] = []
  const inLit = monoPinInLit
  monoPinInLit = n is ArrayLit || n is ObjLit
  const kidSink = monoPinSinkKids(ix) || (sink && n is Paren)
  const eqPin = monoEqOfTpJoin(ix)
  let ki = 0
  while ki < ks.length {
    monoPinSink = kidSink
    const kv = monoPinValueLambda(ks[ki], typarams, tvN, tvV, bN, bT)
    monoPinSink = false
    if eqPin && kv >= 0 && P.nodes[kv] is Ident && tyHasTyVar(nodeTyIxOf(kv)) {
      // The compare picks the join's arm by the other side's type, which is the pin's.
      nks.push(monoPinRetype(kv, bN, bT))
    } else if n is Call {
      nks.push(monoPinFnValueTy(kv, ks[ki], bN, bT))
    } else if ki == 0 && (n is Member || n is Index) {
      nks.push(monoPinRecvName(monoPinRecvLit(kv, ks[ki], bN, bT), bN, bT))
    } else {
      nks.push(kv)
    }
    ki = ki + 1
  }
  monoPinInLit = inLit
  let rb = monoExprRebuild(ix, nks, bN, bT)
  // A record literal holding a gradual join is re-made so its own row can be minted at the pin.
  if rb == ix && n is ObjLit && monoObjHoldsGradual(ix) {
    rb = monoExprRemake(ix, monoExprKids(ix))
  }
  if rb == ix {
    rb = monoPinRetype(ix, bN, bT)
  } else if n is ObjLit {
    monoTpJoinObjTy(ix, rb, bN, bT)
  } else if n is AsExpr && tyIsGradualUnion(nodeTyIxOf(n.asObj)) {
    // A cast re-made over a re-typed operand keeps the template's result at the pin: an `as?`
    // is nullable at every pin, as over a bare parameter (D2754).
    const apt = monoPinnedTyOf(ix, bN, bT)
    if apt >= 0 { monoPinRecordTy(rb, apt) }
    const rbn = P.nodes[rb]
    if rbn is AsExpr {
      const opt = nodeTyIxOf(rbn.asObj)
      if (
        opt >= 0
        && opt < T.tys.length
        && !(T.tys[opt] is TyUnion)
        && !tyHasTyVar(opt)
      ) {
        // arena-tick exempt: a per-program mark the cast's lowering reads.
        monoGradualAsScalar[rb] = true
      }
    }
  }
  if sink { rb = monoPinCoalJoin(ix, rb, bN, bT) }
  if numUnionMinted { rb = monoNumUnionOpPin(ix, rb, bN, bT) }
  rb
}

// An operator operand's type at the pin: its pinned type, or, for a name typed at a hole the
// parameters' binding leaves open, the hole instance's own binding of it. A derived hole is
// left as pinned.
function monoNumOperandPinTy(ix: i32, bN: string[], bT: i32[]): i32 {
  const p = monoPinnedTyOf(ix, bN, bT)
  if p < 0 || p >= T.tys.length || !tyHasTyVar(p) { return p }
  const id = P.nodes[unwrapParen(ix)]
  if !(id is Ident) { return p }
  const t = T.tys[p]
  if !(t is TyVar) { return p }
  if t.tvName.length > 1 && t.tvName[1] == "#"[0] { return p }
  // The binding read directly, not substituted: re-joining a pinned union mints rows.
  const b = monoHoleBindingOf(t.tvName)
  // An operator reaches a nullable number only past the check that excluded its `null`.
  if b >= 0 && tyIsNumericBox(b) { return nonNullTy(b) }
  if b >= 0 { return b }
  // A parameter read past its `null` test is typed at the narrowing's own hole: the
  // parameter's hole answers for it, and for an un-annotated local it initialises.
  const pb = monoHoleBindingOf(
    monoParamHoleName(monoAliasedParam(id.identName)),
  )
  if pb >= 0 && tyIsNumericBox(pb) && tyBearsNull(pb) { return nonNullTy(pb) }
  p
}

// The hole binding of the instance being built for hole `name`, -1 for none.
function monoHoleBindingOf(name: string): i32 {
  if name == "" { return -1 }
  let i = 0
  while i < monoPinHoleN.length && i < monoPinHoleT.length {
    if monoPinHoleN[i] == name { return monoPinHoleT[i] }
    i = i + 1
  }
  -1
}

// The name an un-annotated local `name` of the instance being built is initialised from, when
// that initialiser is a bare name, followed to a name no such local declares; `name` otherwise.
function monoAliasedParam(name: string): string {
  let cur = name
  let hops = 0
  while hops < 4 {
    const nx = monoLocalInitName(monoInstBody, cur)
    if nx == "" { return cur }
    cur = nx
    hops = hops + 1
  }
  cur
}

// The bare name the un-annotated `let`/`const` `name` under `ix` is initialised from, or "".
function monoLocalInitName(ix: i32, name: string): string {
  const todo: i32[] = [ix]
  while todo.length > 0 {
    const at = todo.pop() ?? -1
    if at >= 0 && at < P.nodes.length {
      const n = P.nodes[at]
      if n is LetDecl {
        if n.letName == name && n.letType < 0 && n.letInit >= 0 {
          const iv = P.nodes[unwrapParen(n.letInit)]
          if iv is Ident { return iv.identName }
          return ""
        }
      }
      for k in nodeChildren(at) {
        if k >= 0 { todo.push(k) }
      }
    }
  }
  ""
}

// The hole an un-annotated parameter `name` of the instance being built is typed at, or "".
function monoParamHoleName(name: string): string {
  let i = 0
  while i < monoInstParams.length {
    const pn = P.nodes[monoInstParams[i]]
    if pn is Param {
      if pn.parName == name {
        if pn.parType >= 0 { return "" }
        const pt = nodeTyIxOf(monoInstParams[i])
        if pt < 0 || pt >= T.tys.length { return "" }
        const ptv = T.tys[pt]
        if ptv is TyVar { return ptv.tvName }
        return ""
      }
    }
    i = i + 1
  }
  ""
}

// `monoNumUnionOpPin` for a compound assignment `rb` rebuilt from `ix`: its operator node.
function monoNumUnionCompoundPin(
  ix: i32,
  rb: i32,
  bN: string[],
  bT: i32[],
): i32 {
  const n = P.nodes[rb]
  if !(n is BinExpr) { return rb }
  const inner = P.nodes[n.binRight]
  if !(inner is BinExpr) { return rb }
  const lt = monoNumOperandPinTy(inner.binLeft, bN, bT)
  const rt = monoNumOperandPinTy(inner.binRight, bN, bT)
  if !tyIsNumUnion(lt) && !tyIsNumUnion(rt) { return rb }
  const nu = numUnionResultTy(inner, lt, rt)
  if nu < 0 || nu == nodeTyIxOf(n.binRight) { return rb }
  let nx = rb
  if nx == ix { nx = monoExprRemake(ix, monoExprKids(ix)) }
  const nn = P.nodes[nx]
  if !(nn is BinExpr) { return rb }
  monoPinRecordTy(nn.binRight, nu)
  if tyIsNumUnion(nu) {
    const vn = valueUnionRetName(nu)
    if vn != "" { monoRegisterPinUnion(vn, nu) }
  }
  nx
}

// An operator whose operand this instance types as a numeric union answers the union of its
// member results (`numUnionResultTy`), which the template, typed at a parameter, cannot name.
function monoNumUnionOpPin(ix: i32, rb: i32, bN: string[], bT: i32[]): i32 {
  if rb < 0 || rb >= P.nodes.length { return rb }
  const n = P.nodes[rb]
  let nu = -1
  if n is BinExpr {
    // A compound assignment's operator node is not a kid: it is re-typed inside the rebuild.
    if (
      n.binOp == "="
      && n.binCompound != ""
      && n.binCompound != "++"
      && n.binCompound != "--"
    ) {
      return monoNumUnionCompoundPin(ix, rb, bN, bT)
    }
    if n.binOp == "=" || n.binOp == "??" || n.binOp == "&&" || n.binOp == "||" {
      return rb
    }
    const lt = monoNumOperandPinTy(n.binLeft, bN, bT)
    const rt = monoNumOperandPinTy(n.binRight, bN, bT)
    if !tyIsNumUnion(lt) && !tyIsNumUnion(rt) { return rb }
    nu = numUnionResultTy(n, lt, rt)
  } else if n is Unary {
    if n.unOp != "-" { return rb }
    const at = monoNumOperandPinTy(n.unArg, bN, bT)
    if !tyIsNumUnion(at) { return rb }
    nu = at
  } else {
    return rb
  }
  if nu < 0 || nu == nodeTyIxOf(rb) { return rb }
  let nx = rb
  if nx == ix { nx = monoExprRemake(ix, monoExprKids(ix)) }
  monoPinRecordTy(nx, nu)
  if tyIsNumUnion(nu) {
    const vn = valueUnionRetName(nu)
    if vn != "" { monoRegisterPinUnion(vn, nu) }
  }
  nx
}

// Whether `ix` is an object literal with a field typed at a union holding a type parameter.
function monoObjHoldsGradual(ix: i32): boolean {
  if ix < 0 { return false }
  const u = unwrapParen(ix)
  if u < 0 || !(P.nodes[u] is ObjLit) { return false }
  const t = nodeTyIxOf(u)
  if t < 0 || t >= T.tys.length { return false }
  monoTyHoldsGradual(t, 0)
}

// Whether record or list type `t` holds, at any depth, a field or element typed at a union
// holding a type parameter.
function monoTyHoldsGradual(t: i32, depth: i32): boolean {
  if t < 0 || t >= T.tys.length || depth > 8 { return false }
  const o = T.tys[t]
  if o is TyObj {
    for ft in o.objFieldTypes {
      if monoTyIsUnionOrNulUnion(ft) && tyHasTyVar(ft) { return true }
      if monoTyHoldsGradual(ft, depth + 1) { return true }
    }
    return false
  }
  // A list answers for its element; any other kind has no element and answers false.
  monoTyHoldsGradual(tyArrayElemIx(t), depth + 1)
}

// An object literal `ix` rebuilt as `rb` whose recorded type holds a field typed at a join the
// checker kept apart is re-typed at the pin: its row is interned from its own field types (D2906).
function monoTpJoinObjTy(ix: i32, rb: i32, bN: string[], bT: i32[]) {
  const t = nodeTyIxOf(ix)
  if t < 0 || t >= T.tys.length { return 0 }
  if !(T.tys[t] is TyObj) || !monoTyHoldsGradual(t, 0) { return 0 }
  const pty = monoPinnedTyOf(ix, bN, bT)
  if pty >= 0 && pty != t {
    monoPinRecordTy(rb, pty)
    // arena-tick exempt: a per-program mark the post-monomorphization shape pass reads.
    monoGradualObjLits[rb] = true
    monoGradualObjList.push(rb)
  }
  0
}

// Whether `ix` is an `==` / `!=` with an operand typed at a join the checker kept apart.
function monoEqOfTpJoin(ix: i32): boolean {
  const n = P.nodes[ix]
  if n is BinExpr {
    if n.binOp != "==" && n.binOp != "!=" { return false }
    return tyIsTpJoinUnion(nodeTyIxOf(n.binLeft))
      || tyIsTpJoinUnion(nodeTyIxOf(n.binRight))
  }
  false
}

// `monoIfArmsPinJoin` for a `??` at `ix`, rebuilt as `rb`: where its sides' pinned types join
// to other than the template's recorded join (`t ?? 5` at a `string | null` pin), a node
// answering that join. `rb` unchanged otherwise.
function monoPinCoalJoin(ix: i32, rb: i32, bN: string[], bT: i32[]): i32 {
  const n = P.nodes[ix]
  if !(n is BinExpr) { return rb }
  if n.binOp != "??" || n.binCompound != "" { return rb }
  const raw = nodeTyIxOf(ix)
  if raw < 0 || raw >= T.tys.length { return rb }
  const lt = nodeTyIxOf(n.binLeft)
  const rt = nodeTyIxOf(n.binRight)
  if lt < 0 || rt < 0 || lt >= T.tys.length || rt >= T.tys.length { return rb }
  if !tyHasTyVar(raw) && !tyHasTyVar(lt) && !tyHasTyVar(rt) { return rb }
  const pl = monoPinArmSubst(lt, bN, bT)
  const pr = monoPinArmSubst(rt, bN, bT)
  if pl < 0 || pr < 0 { return rb }
  // A literal default that is a member of the pinned literal-union operand keeps that union,
  // as the concrete `??` types it, so the result stays the operand's atom (D3423).
  const pnn = nonNullTy(pl)
  const dl = litTyOfExpr(n.binRight)
  const keepsLit = tyIsLitUnion(pnn) && dl >= 0 && assignable(dl, pnn)
  const ts: i32[] = [pnn, pr]
  let j = joinPinnedArmTys(ts)
  if keepsLit { j = pnn }
  if j < 0 || j >= T.tys.length || tyHasTyVar(j) { return rb }
  if (
    !keepsLit
    && T.tys[j] is TyUnion
    && monoPinRetTy >= 0
    && monoPinLetReaches
  ) {
    if !monoTySameMembers(j, monoPinRetTy) { return rb }
    j = monoPinRetTy
  }
  const cur = nodeTyIxOf(rb)
  if cur == j || (cur >= 0 && tyEq(cur, j)) { return rb }
  if !keepsLit && T.tys[j] is TyUnion {
    const name = valueUnionRetName(j)
    if name == "" || monoRegisterPinUnion(name, j) < 0 { return rb }
  }
  let nx = rb
  if nx == ix { nx = monoExprRemake(ix, monoExprKids(ix)) }
  if nx == ix { return rb }
  monoPinRecordTy(nx, j)
  nx
}

// The type parameter of `typarams` the checked return of generic `origFe` is, bare, or "".
function monoCheckedRetTyParam(origFe: i32, typarams: string[]): string {
  if origFe < 0 || origFe >= monoOrigNode.length { return "" }
  const ft = nodeTyIxOf(monoOrigNode[origFe])
  if ft < 0 || ft >= T.tys.length { return "" }
  const f = T.tys[ft]
  if !(f is TyFunc) { return "" }
  const r = f.fnRet
  if r < 0 || r >= T.tys.length { return "" }
  const nm = monoSoleTyVarName(r)
  let i = 0
  while i < typarams.length {
    if nm != "" && typarams[i] == nm { return nm }
    i = i + 1
  }
  ""
}

// The name of the one type variable `r` is: a bare variable, or a join whose every member is
// that same variable (`T | T`, the checker's join of two bindings of `T`, D2186). "" otherwise.
function monoSoleTyVarName(r: i32): string {
  const rv = T.tys[r]
  match rv {
    TyVar => {
      return rv.tvName
    }
    TyUnion => {
      let nm = ""
      let i = 0
      while i < rv.uMembers.length {
        const m = rv.uMembers[i]
        if m < 0 || m >= T.tys.length { return "" }
        const mv = T.tys[m]
        if !(mv is TyVar) { return "" }
        if nm != "" && mv.tvName != nm { return "" }
        nm = mv.tvName
        i = i + 1
      }
      return nm
    }
    TyPrim | TyErr | TyObj | TyFunc | TyNullable | TyArray | TyMap | TyLit | TyNeg => {
      // Concrete, or a variable under a constructor: not the parameter itself.
      return ""
    }
  }
}

// Whether an instance's checked result `ty` is a list, or a union whose every member is one.
function monoRetIsListOrListJoin(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = T.tys[ty]
  match t {
    TyArray => {
      return true
    }
    TyUnion => {
      if t.uMembers.length == 0 { return false }
      let i = 0
      while i < t.uMembers.length {
        const m = t.uMembers[i]
        if m < 0 || m >= T.tys.length || !(T.tys[m] is TyArray) { return false }
        i = i + 1
      }
      return true
    }
    TyPrim | TyErr | TyFunc | TyObj | TyNullable | TyVar | TyLit | TyNeg | TyMap => {
      // A scalar, record, map or closure result has its own rung above, or none is owed.
      return false
    }
  }
}

// `rty` read at an instance whose un-annotated parameters are holes the checker typed as its
// own type variables: each hole binds to its column in `tyCol`, since no annotation names it
// for `monoBindCols` to walk (D2605).
function monoHoleRetSubst(
  rty: i32,
  ft: TyFunc,
  params: i32[],
  tyCol: i32[],
): i32 {
  const hN: string[] = []
  const hT: i32[] = []
  let i = 0
  while i < params.length && i < ft.fnParamTypes.length && i < tyCol.length {
    const pp = P.nodes[params[i]]
    if pp is Param {
      if pp.parType < 0 { bindGenWalk(ft.fnParamTypes[i], tyCol[i], hN, hT) }
    }
    i = i + 1
  }
  if hN.length == 0 { return rty }
  substTyDeep(rty, hN, hT)
}

// Whether the per-instance walk is at an operand of a list or object literal.
let monoPinInLit = false

// Whether the value the per-instance walk visits next is delivered where a join that is a union
// at the pin lowers as the union (a `print` argument, or a binding every read of which is
// one): elsewhere the instance reads it at the template's type (D2893).
let monoPinSink = false

// The names the instance body reads anywhere but as such a sink, set before its walk.
let monoPinUnsafeNames: {[string]: boolean} = Map()

// The instance binding with each parameter's union-arm binding appended (`U` of `u: U | string`
// at an `f64`), which the join of an arm typed `U | string` needs; set before the body walk.
let monoPinArmBN: string[] = []
let monoPinArmBT: i32[] = []

function monoPinArmBinds(params: i32[], tyCol: i32[], bN: string[], bT: i32[]) {
  const xN: string[] = []
  const xT: i32[] = []
  let i = 0
  while i < bN.length {
    xN.push(bN[i])
    xT.push(bT[i])
    i = i + 1
  }
  let bi = 0
  while bi < params.length && bi < tyCol.length {
    const pp = P.nodes[params[bi]]
    if pp is Param {
      bindGenUnionArmInto(nodeTyIxOf(pp.parType), tyCol[bi], xN, xT)
    }
    bi = bi + 1
  }
  monoPinArmBN = xN
  monoPinArmBT = xT
  0
}

// Whether `monoPinArmBN`/`monoPinArmBT` begin with exactly the binding `bN`/`bT`.
function monoPinArmExtends(bN: string[], bT: i32[]): boolean {
  let i = 0
  while i < bN.length {
    if (
      i >= monoPinArmBN.length
      || monoPinArmBN[i] != bN[i]
      || monoPinArmBT[i] != bT[i]
    ) {
      return false
    }
    i = i + 1
  }
  true
}

// Whether the value-atom box `rty` an instance's return would be annotated with cannot carry a
// join its body `body` binds (`monoPinBodyJoinUncovered`), read as the walk will read it.
function monoPinBoxUncovered(
  body: i32,
  rty: i32,
  params: i32[],
  tyCol: i32[],
  bN: string[],
  bT: i32[],
): boolean {
  monoPinReachNames = Map()
  monoPinNoteReach(body)
  // A reaching name declared twice is not told apart by name, so the box is kept.
  if monoPinReachShadowed(body) {
    monoPinReachNames = Map()
    return false
  }
  monoPinArmBinds(params, tyCol, bN, bT)
  monoPinUnsafeNames = Map()
  monoPinRetBox = !tyBearsNull(rty)
  monoPinNoteUnsafeBody(body)
  monoPinRetBox = false
  monoPinBodyJoinUncovered(body, rty, bN, bT)
}

// Whether a name in `monoPinReachNames` is declared more than once under `body`.
function monoPinReachShadowed(body: i32): boolean {
  const seen: {[string]: i32} = Map()
  monoPinCountDecls(body, seen) > 0
}

// Counts every `let`/`const` declaration name under `ix` into `seen`; how many reaching names
// it finds declared a second time.
function monoPinCountDecls(ix: i32, seen: {[string]: i32}): i32 {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  let dup = 0
  if n is LetDecl {
    const c = (seen.get(n.letName) ?? 0) + 1
    // arena-tick exempt: a per-call name count the box decision reads, no pass's input.
    seen[n.letName] = c
    if c > 1 && (monoPinReachNames.get(n.letName) ?? false) { dup = 1 }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      dup = dup + monoPinCountDecls(kids[i], seen)
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  dup
}

// The bindings whose value reaches the instance's return: a name the body returns, and a name
// such a binding is initialized from. Only these can put a join's rep into the return box.
let monoPinReachNames: {[string]: boolean} = Map()

// Whether the binding whose initializer the per-instance walk is in reaches the return.
let monoPinLetReaches = false

function monoPinNoteReach(body: i32) {
  const b = P.nodes[body]
  if b is Block {
    if b.blkStmts.length > 0 {
      monoPinNoteReachExpr(b.blkStmts[b.blkStmts.length - 1])
    }
  }
  monoPinNoteReturns(body)
  // Follow initializers that are bare names until a round adds none; each adds a name.
  let grew = true
  while grew { grew = monoPinReachStep(body) }
  0
}

// Records a bare name `ix` hands out as reaching the return.
function monoPinNoteReachExpr(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const u = unwrapParen(ix)
  if u < 0 || u >= P.nodes.length { return 0 }
  const n = P.nodes[u]
  // arena-tick exempt: a per-instance name set the box decision reads, no pass's input.
  if n is Ident { monoPinReachNames[n.identName] = true }
  0
}

// Records the operand of every `return` under `ix` outside a nested function.
function monoPinNoteReturns(ix: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  if n is FuncDecl { return 0 }
  if n is RetStmt { return monoPinNoteReachExpr(n.retArg) }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      monoPinNoteReturns(kids[i])
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

// One pass adding the name a reaching binding is initialized from; whether it added any.
function monoPinReachStep(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = P.nodes[ix]
  if n is FuncDecl { return false }
  let grew = false
  if n is LetDecl {
    if (monoPinReachNames.get(n.letName) ?? false) && n.letInit >= 0 {
      const u = unwrapParen(n.letInit)
      if u >= 0 && u < P.nodes.length {
        const iu = P.nodes[u]
        if iu is Ident {
          if !(monoPinReachNames.get(iu.identName) ?? false) {
            // arena-tick exempt: a per-instance name set the box decision reads, no pass's input.
            monoPinReachNames[iu.identName] = true
            grew = true
          }
        }
      }
    }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      if monoPinReachStep(kids[i]) { grew = true }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  grew
}

// Whether a binding under `ix` (outside a nested function) that reaches the return joins, at the
// binding `bN`/`bT`, other than its template type where the instance cannot re-type it to the
// return box `retTy` (read outside a sink, or other members): the box would carry the wrong
// rep, so it is withheld and the return refuses (D2912).
function monoPinBodyJoinUncovered(
  ix: i32,
  retTy: i32,
  bN: string[],
  bT: i32[],
): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = P.nodes[ix]
  if n is FuncDecl { return false }
  if n is LetDecl {
    if (
      n.letType < 0
      && n.letInit >= 0
      && (monoPinReachNames.get(n.letName) ?? false)
    ) {
      const init = unwrapParen(n.letInit)
      // A join the checker kept apart is typed at its union in the template, so every read of
      // the binding already takes the substituted box (D2906).
      if (
        init >= 0
        && init < P.nodes.length
        && !tyIsTpJoinUnion(nodeTyIxOf(init))
      ) {
        const j = monoJoinPinnedAt(init, bN, bT)
        if j != -1 {
          if j < -1 { return true }
          const isUnsafe = monoPinUnsafeNames.get(n.letName) ?? false
          if (
            isUnsafe
            || !(T.tys[j] is TyUnion)
            || !monoTySameMembers(j, retTy)
          ) {
            return true
          }
        }
      }
    }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      if monoPinBodyJoinUncovered(kids[i], retTy, bN, bT) { return true }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  false
}

// The join of value join `ix` (an `if`, a `??`, a `match`) at the binding `bN`/`bT` when it
// differs from its template type there; -1 when it agrees or `ix` is no join, and -2 when an
// arm has no pinned type to tell.
function monoJoinPinnedAt(ix: i32, bN: string[], bT: i32[]): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = P.nodes[ix]
  const ts: i32[] = []
  monoPinArmLits = []
  if n is IfStmt {
    if monoChainPinnedTys(ix, bN, bT, ts) < 0 { return -2 }
  } else if monoIsCoalesce(ix) {
    const b = P.nodes[ix]
    if b is BinExpr {
      const pl = monoPinArmSubst(nodeTyIxOf(b.binLeft), bN, bT)
      const pr = monoPinArmSubst(nodeTyIxOf(b.binRight), bN, bT)
      if pl < 0 || pr < 0 { return -2 }
      ts.push(nonNullTy(pl))
      ts.push(pr)
    }
  } else {
    return monoMatchPinnedAt(ix)
  }
  let j = joinPinnedArmTys(ts)
  if P.nodes[ix] is IfStmt { j = joinPinnedArmLit(ts, monoPinArmLits) }
  const pj = monoPinnedTyOf(ix, bN, bT)
  if j < 0 || pj < 0 || tyHasTyVar(pj) { return -2 }
  if j == pj || tyEq(j, pj) || monoTySameMembers(j, pj) { return -1 }
  j
}

function monoIsCoalesce(ix: i32): boolean {
  const n = P.nodes[ix]
  if n is BinExpr { return n.binOp == "??" && n.binCompound == "" }
  false
}

// A `match` over a type parameter's values is not re-typed per pin: -2 when its recorded type
// names one, else -1.
function monoMatchPinnedAt(ix: i32): i32 {
  const n = P.nodes[ix]
  if n is MatchExpr {
    const t = nodeTyIxOf(ix)
    if t >= 0 && t < T.tys.length && tyHasTyVar(t) { return -2 }
  }
  -1
}

// Whether the instance being walked returns an annotated union box, so a binding its body
// returns by name is delivered as that union too (D2912).
let monoPinRetBox = false
// The last statement of the generic being instantiated, whose value its caller reads.
let monoTailIf = -1

// That box's type during the instance's body walk, else -1.
let monoPinRetTy = -1

// The hole binding of the instance whose body `monoPinBodyLambdas` walks; empty outside it.
let monoPinHoleN: string[] = []
// The parameters of the instance being built (`monoParamHoleName`).
let monoInstParams: i32[] = []
// The template body of the instance being built (`monoAliasedParam`).
let monoInstBody = -1
let monoPinHoleT: i32[] = []

// Whether unions `a` and `b` hold the same members, in any order.
function monoTySameMembers(a: i32, b: i32): boolean {
  const ta = T.tys[a]
  const tb = T.tys[b]
  if ta is TyUnion {
    if tb is TyUnion {
      if ta.uMembers.length != tb.uMembers.length { return false }
      let i = 0
      while i < ta.uMembers.length {
        let hit = false
        let k = 0
        while k < tb.uMembers.length && !hit {
          if tyEq(ta.uMembers[i], tb.uMembers[k]) { hit = true }
          k = k + 1
        }
        if !hit { return false }
        i = i + 1
      }
      return true
    }
  }
  false
}

// Records in `monoPinUnsafeNames` every name read under `ix` outside a sink.
function monoPinNoteUnsafe(ix: i32) {
  let cur = ix
  while cur >= 0 && cur < P.nodes.length {
    const n = P.nodes[cur]
    if n is Ident {
      // arena-tick exempt: a per-instance name set the body walk reads, no pass's input.
      monoPinUnsafeNames[n.identName] = true
      return 0
    }
    // A nested function's returns are its own, not the instance's.
    const savedRB = monoPinRetBox
    if n is FuncDecl { monoPinRetBox = false }
    const safe = monoPinSinkKids(cur) || monoPinIsBoxReturn(cur)
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      const k = kids[i]
      if k >= 0 && k < P.nodes.length {
        if !(safe && P.nodes[unwrapParen(k)] is Ident) { monoPinNoteUnsafe(k) }
      }
      i = i + 1
    }
    monoPinRetBox = savedRB
    cur = elseIfLink(cur)
  }
  0
}

// `monoPinNoteUnsafe` over an instance body, whose tail name is its return (`monoPinRetBox`).
function monoPinNoteUnsafeBody(body: i32) {
  const b = P.nodes[body]
  if b is Block {
    if monoPinRetBox && b.blkStmts.length > 0 {
      const last = b.blkStmts.length - 1
      if P.nodes[unwrapParen(b.blkStmts[last])] is Ident {
        let i = 0
        while i < last {
          monoPinNoteUnsafe(b.blkStmts[i])
          i = i + 1
        }
        return 0
      }
    }
  }
  monoPinNoteUnsafe(body)
}

// Whether `ix` hands its operand out as the instance's union-box return: a `return x`.
function monoPinIsBoxReturn(ix: i32): boolean {
  if !monoPinRetBox { return false }
  const n = P.nodes[ix]
  if n is RetStmt { return true }
  false
}

// Whether the operands of expression `ix` are sinks: a `print` call's. An `==` is not one,
// since its other operand is still read at the template's type.
function monoPinSinkKids(ix: i32): boolean {
  const n = P.nodes[ix]
  if n is Call {
    const f = P.nodes[n.callFn]
    if f is Ident { return f.identName == "print" }
  }
  false
}

// Expression `ix`, whose operands the walk left unchanged, re-made when its recorded type
// names a type parameter this instance binds: its emission and the instance's inferred
// return read that type, and the template's is the parameter itself. `ix` when it does not.
function monoPinRetype(ix: i32, bN: string[], bT: i32[]): i32 {
  // An object literal takes its row from its destination, and a list literal inside another
  // literal from the enclosing one's row; neither is named by the literal's own recorded type.
  const n = P.nodes[ix]
  if n is ObjLit { return ix }
  if n is ArrayLit && monoPinInLit { return ix }
  const pty = monoPinnedTyOf(ix, bN, bT)
  if pty < 0 || pty == nodeTyIxOf(ix) { return ix }
  if n is ArrayLit && monoTpJoinListElemBox(ix, pty) < 0 { return ix }
  // A join the checker kept apart is a union at the pin only as a box registered here.
  if tyIsTpJoinUnion(nodeTyIxOf(ix)) { monoPinUnionBoxed(pty, false) }
  const nx = monoExprRemake(ix, monoExprKids(ix))
  if nx != ix { monoPinRecordTy(nx, pty) }
  nx
}

// The annotation spelling of the list type `ty` the checker rendered as `render`: a record
// element, nullable or not, by its row's name (`(P|null)[]`); any other element in the parser's
// union spelling. A nullable record with no row is left as rendered.
function monoListSpelling(render: string, ty: i32): string {
  let t = ty
  let suffix = ""
  while (
    t >= 0
    && t < T.tys.length
    && T.tys[t] is TyArray
    && suffix.length < 128
  ) {
    const ta = T.tys[t]
    if ta is TyArray { t = ta.aElem }
    suffix = suffix + "[]"
  }
  if suffix != "" && t >= 0 && t < T.tys.length {
    const te = T.tys[t]
    if te is TyNullable {
      const inner = te.nInner
      if inner >= 0 && inner < T.tys.length && T.tys[inner] is TyObj {
        const rn = monoRetRowName(inner)
        if rn != "" { return "(" + rn + "|null)" + suffix }
        // A record with no row of its own (a generic application) keeps the render.
        return render
      }
    }
  }
  const rl = monoRetListRowName(ty)
  if rl != "" { return rl }
  monoUnspacedUnions(render)
}

// A checker render in the parser's spelling of a union: `(string | null)[]` becomes
// `(string|null)[]`, which the annotation tables read as the niche list it is. A render holding
// a string literal is returned as is, since its quotes may hold the separator.
function monoUnspacedUnions(s: string): string {
  let out = ""
  let i = 0
  while i < s.length {
    if s[i] == '"' { return s }
    if i + 2 < s.length && s[i] == ' ' && s[i + 1] == '|' && s[i + 2] == ' ' {
      out = out + "|"
      i = i + 3
    } else {
      out = out + s.slice(i, i + 1)
      i = i + 1
    }
  }
  out
}

// A name read as a receiver of a list whose element can be null (`xs[i]` at `(string | null)[]`),
// re-typed at the pin: the read recovers a non-null element unless the receiver's recorded type
// says otherwise. Any other name keeps the template's type, which its binding answers for.
function monoPinRecvName(cur: i32, bN: string[], bT: i32[]): i32 {
  if cur < 0 || !(P.nodes[cur] is Ident) { return cur }
  const ipt = monoPinnedTyOf(cur, bN, bT)
  if ipt < 0 || ipt >= T.tys.length { return cur }
  const it = T.tys[ipt]
  if !(it is TyArray) { return cur }
  if !tyBearsNull(it.aElem) { return cur }
  monoPinRetype(cur, bN, bT)
}

// A list literal read as a receiver (`[r].map(…)`, `[r][0]`) and typed at the type parameter,
// re-typed at the pin: an inline `.map`/`.filter` and an element read take its element rep off
// that type (D2554). `cur` is the walk's rewrite of `orig`; anything else is returned as is.
function monoPinRecvLit(cur: i32, orig: i32, bN: string[], bT: i32[]): i32 {
  if orig < 0 || !(P.nodes[orig] is ArrayLit) { return cur }
  const aty = nodeTyIxOf(orig)
  const pty = monoPinnedTyOf(orig, bN, bT)
  if pty < 0 || pty == aty { return cur }
  let nx = cur
  if nx == orig { nx = monoExprRemake(orig, monoExprKids(orig)) }
  nodeTyRecord(nx, pty)
  nx
}

// A call's callee or argument `cur` (the walk's rewrite of `orig`) answering its function type
// at this pin. A value call's `$fnsig`, and a function argument's pin, are keyed off the
// recorded type, and a template's names the type parameter, which keys no signature (D2552).
function monoPinFnValueTy(cur: i32, orig: i32, bN: string[], bT: i32[]): i32 {
  const ty = nodeTyIxOf(orig)
  if ty < 0 || ty >= T.tys.length { return cur }
  if !(T.tys[ty] is TyFunc) { return cur }
  const st = monoPinnedTyOf(orig, bN, bT)
  if st == ty { return cur }
  let nx = cur
  if nx == orig { nx = monoExprRemake(orig, monoExprKids(orig)) }
  if nx == orig { return cur }
  nodeTyRecord(nx, st)
  nx
}

// Whether `ty`, or a member of it as a union or nullable, is a literal or a literal union: a
// checked signature's join names the literal member, which no arm's own rep holds.
function monoTyHasLitMember(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  if tyIsLitUnion(ty) || T.tys[ty] is TyLit { return true }
  if tyBearsNull(ty) {
    const nn = nonNullTy(ty)
    if nn >= 0 && nn != ty && monoTyHasLitMember(nn) { return true }
  }
  monoUnionHasLitMember(ty)
}

function monoUnionHasLitMember(ty: i32): boolean {
  const t = T.tys[ty]
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if monoTyHasLitMember(t.uMembers[i]) { return true }
      i = i + 1
    }
  }
  false
}

// The return type in lambda `fnIx`'s recorded function type, or -1.
function monoLamCheckedRet(fnIx: i32): i32 {
  const ft = nodeTyIxOf(fnIx)
  if ft < 0 || ft >= T.tys.length { return -1 }
  const f = T.tys[ft]
  if f is TyFunc { return f.fnRet }
  -1
}

// `monoPinBodyLambdas` over a value position, where a lambda literal of either kind is the
// value itself: its per-instance clone when it is a template, else the walk below it.
function monoPinValueLambda(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  if ix < 0 { return ix }
  if P.nodes[ix] is FuncDecl {
    const cl = monoCloneLambdaSubst(ix, typarams, tvN, tvV, bN, bT)
    if cl >= 0 { return cl }
    return ix
  }
  monoPinBodyLambdas(ix, typarams, tvN, tvV, bN, bT)
}

// The type parameters of every enclosing lifted frame of `fe`, appended to `out`. The
// chain is `fnParent`; each frame's original declaration carries the `<T>`, because
// `fnStmts[p]` may already hold that generic's first instance. Bounded by the function
// count, so it terminates even should `fnParent` ever contain a cycle.
function monoEnclosingTyParams(fe: i32, out: string[]) {
  let p = -1
  if fe < fnParent.length { p = fnParent[fe] }
  let guard = 0
  while p >= 0 && guard <= fnStmts.length {
    let nd = -1
    if p < monoOrigNode.length { nd = monoOrigNode[p] }
    else if p < fnStmts.length { nd = fnStmts[p] }
    if nd >= 0 {
      const fn = P.nodes[nd]
      if fn is FuncDecl {
        let i = 0
        while i < fn.fnTyParams.length {
          out.push(fn.fnTyParams[i])
          i = i + 1
        }
      }
    }
    if p < fnParent.length { p = fnParent[p] } else { p = -1 }
    guard = guard + 1
  }
  0
}

// Does the subtree at `ix` carry a spelling `monoFoldTyParamLayout` substitutes — an `is`
// whose check type mentions a type parameter, or a `T.field` layout constant? Those are
// the two places a type parameter reaches the emitter as source text. Walked through
// `nodeChildren` rather than a second copy of the fold's arm ladder, which would drift.
function monoNodeNamesTyParam(ix: i32, typarams: string[]) {
  if ix < 0 || ix >= P.nodes.length { return false }
  if typarams.length == 0 { return false }
  const n = P.nodes[ix]
  if n is IsExpr {
    if monoAnnHasTyParam(n.isVariant, typarams) { return true }
  }
  if n is Member {
    const mo = P.nodes[n.memObj]
    if mo is Ident {
      if monoTyParamOf(mo.identName, typarams) != "" { return true }
    }
  }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      if monoNodeNamesTyParam(kids[i], typarams) { return true }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  false
}

// The PRUNE's face, which decides whether a lifted slot is dead. A frame that declares no
// type parameter is never instantiated, so its one lifted slot is the only one and stubbing
// it leaves a live `call_indirect` pointing at a stub. The instantiation's face is the core
// below, which this guard must not reach.
function monoLamNodeIsTemplate(fnIx: i32, typarams: string[]) {
  if typarams.length == 0 { return false }
  monoLamNodeIsTemplateCore(fnIx, typarams)
}

// A nested function is a per-instance template when its own annotations name a type
// parameter, when it captures (its env type is the instance's), or when its body names one.
// Asked with no `typarams` guard from inside an instantiation: an un-annotated
// `function o(n)` pins its parameter without declaring a `<T>` (D1780).
function monoLamNodeIsTemplateCore(fnIx: i32, typarams: string[]) {
  const fn = P.nodes[fnIx]
  if fn is FuncDecl {
    if fn.fnTyParams.length > 0 { return false }
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param {
        if p.parType >= 0 {
          const ann = monoDeclAnnName(p.parType, tyNameOf(p.parType), typarams)
          if monoAnnHasTyParam(ann, typarams) { return true }
        }
      }
      i = i + 1
    }
    if fn.fnRet >= 0 {
      const rann = monoDeclAnnName(fn.fnRet, tyNameOf(fn.fnRet), typarams)
      if monoAnnHasTyParam(rann, typarams) { return true }
    }
    // D943 — a capture is part of a lambda's effective signature, and the two checks above
    // read only the written one: `show: () => string` inside `mk<T>` takes no parameter and
    // returns a concrete type while capturing `value: T`. One lifted slot means one env
    // struct, so it is asked as "does it capture at all" — an extra clone is a correct one.
    const feIx = monoSlotOfLamNode(fnIx)
    if feIx >= 0 {
      if captureCountOf(feIx) > 0 { return true }
    }
    // D1220 — the fourth rung: a type parameter named in the body. The three above read the
    // written signature and the capture count, and `() => gv is T` mentions `T` in none of
    // them — only in the `is` spelling, which `monoFoldTyParamLayout` substitutes per pin.
    // Broad on purpose: an extra clone is a correct clone, only larger.
    if monoNodeNamesTyParam(fn.fnBody, typarams) { return true }
    // The fifth: an un-annotated parameter the checker inferred at a type variable, such as
    // `(x) => x` over a `T[]` — its type is the instance's, as a written `x: T` would be.
    const lty = nodeTyIxOf(fnIx)
    if lty >= 0 && lty < T.tys.length {
      const lt = T.tys[lty]
      if lt is TyFunc {
        let pi = 0
        while pi < ps.length && pi < lt.fnParamTypes.length {
          const pp = P.nodes[ps[pi]]
          if pp is Param {
            if pp.parType < 0 && tyHasTyVar(lt.fnParamTypes[pi]) { return true }
          }
          pi = pi + 1
        }
      }
    }
  }
  false
}

// Is the lifted slot `fe` a lambda template — an annotation still naming a type parameter
// of an enclosing generic frame? Every instantiation of that frame mints its own copy, so
// nothing in the module refers to this slot and the prune at the end of `monomorphize`
// stubs it. Without this rung the template is emitted whether or not an instance exists.
function monoLamSlotIsTyParamTemplate(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return false }
  const tps: string[] = []
  monoEnclosingTyParams(fe, tps)
  monoLamNodeIsTemplate(fnStmts[fe], tps)
}

// Is the lifted slot `fe` a lambda template of a hole function: its frame declares no `<T>`
// but has instances, and its own type names the frame's holes. Each instance clones it at
// its pin, so a template no instance shares is dead (D3083).
function monoLamSlotIsHoleTemplate(fe: i32) {
  if fe < 0 || fe >= fnStmts.length || fe >= fnParent.length { return false }
  // A lambda nested in a lambda is cloned with it, so its frame is the nearest named one.
  let p = fnParent[fe]
  let guard = 0
  while (
    p >= 0
    && p < fnParent.length
    && criFnIsAnonLambda(p)
    && guard <= fnStmts.length
  ) {
    p = fnParent[p]
    guard = guard + 1
  }
  if p < 0 || p >= monoOrigNode.length || !monoInstantiatedAny(p) {
    return false
  }
  const pf = P.nodes[monoOrigNode[p]]
  if !(pf is FuncDecl) { return false }
  if pf.fnTyParams.length > 0 { return false }
  const none: string[] = []
  monoLamNodeIsTemplateCore(fnStmts[fe], none)
}

// Has any enclosing frame of lifted slot `fe` been instantiated? A template whose generic
// no call site ever pinned has no live reference: the generic's own slot is stubbed by the
// arm above in this same loop, and the body that named the lambda goes with it. Bounded
// by the function count, like every other `fnParent` walk here.
function monoLamFrameInstantiated(fe: i32) {
  let p = -1
  if fe < fnParent.length { p = fnParent[fe] }
  let guard = 0
  while p >= 0 && guard <= fnStmts.length {
    if monoInstantiatedAny(p) { return true }
    if p < fnParent.length { p = fnParent[p] } else { p = -1 }
    guard = guard + 1
  }
  false
}

// Per-instance lambda monomorphization for `.map`/`.filter`. An inline callback's
// un-annotated param defaults to i32 at emit, correct only for the i32 shape, so when
// this instance pins the receiver param to a non-i32 element the callback is cloned with
// its param pinned to that element and the call rebuilt to reference the clone.
function monoPinMapLambdas(
  ix: i32,
  pNames: string[],
  pElems: string[],
  pElemTys: i32[],
) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Block {
    const ns: i32[] = []
    let changed = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoPinMapLambdas(n.blkStmts[i], pNames, pElems, pElemTys)
      ns.push(cs)
      if cs != n.blkStmts[i] { changed = true }
      i = i + 1
    }
    if !changed { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is RetStmt {
    const ca = monoPinMapLambdas(n.retArg, pNames, pElems, pElemTys)
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  if n is LetDecl {
    const ci = monoPinMapLambdas(n.letInit, pNames, pElems, pElemTys)
    if ci == n.letInit { return ix }
    return monoCopyOf(ix, mkLet(n.letKw, n.letName, n.letType, ci, n.pos))
  }
  if n is WhileStmt {
    const cb = monoPinMapLambdas(n.whileBody, pNames, pElems, pElemTys)
    if cb == n.whileBody { return ix }
    return mkWhileAs(n, n.whileCond, cb)
  }
  if n is IfStmt {
    // An `else if` chain is rewritten along its spine, so its depth costs no stack (D1990).
    const links = monoIfChainLinks(ix)
    const ccs: i32[] = []
    const cts: i32[] = []
    let k = 0
    while k < links.length {
      const c = P.nodes[links[k]]
      if c is IfStmt {
        ccs.push(c.ifCond)
        cts.push(monoPinMapLambdas(c.ifThen, pNames, pElems, pElemTys))
      }
      k = k + 1
    }
    return monoIfChainRebuild(
      links,
      ccs,
      cts,
      monoPinMapLambdas(monoIfChainElse(links), pNames, pElems, pElemTys),
    )
  }
  if n is ForRange {
    const cb = monoPinMapLambdas(n.frBody, pNames, pElems, pElemTys)
    if cb == n.frBody { return ix }
    return mkForRange(
      n.frVar,
      n.frFrom,
      n.frTo,
      n.frStep,
      n.frExcl,
      cb,
      n.frLabel,
      n.pos,
    )
  }
  if n is ForIn {
    const cb = monoPinMapLambdas(n.fiBody, pNames, pElems, pElemTys)
    if cb == n.fiBody { return ix }
    return mkForIn(n.fiVar, n.fiVar2, n.fiIter, cb, n.fiLabel, n.pos)
  }
  if n is Paren {
    const ci = monoPinMapLambdas(n.parInner, pNames, pElems, pElemTys)
    if ci == n.parInner { return ix }
    return mkParen(ci, n.pos)
  }
  // A list literal's items and a spread's source are value positions like a call's
  // arguments, so a callback under `[...p.filter(f)]` is pinned too (D2334).
  if n is ArrayLit {
    const es: i32[] = []
    let echanged = false
    let ei = 0
    while ei < n.arrElems.length {
      const ce = monoPinMapLambdas(n.arrElems[ei], pNames, pElems, pElemTys)
      es.push(ce)
      if ce != n.arrElems[ei] { echanged = true }
      ei = ei + 1
    }
    if !echanged { return ix }
    return monoRemakeListLitTpl(ix, es, n.pos)
  }
  if n is Spread {
    const sa = monoPinMapLambdas(n.spdArg, pNames, pElems, pElemTys)
    if sa == n.spdArg { return ix }
    return mkSpread(sa, n.pos)
  }
  if n is Call {
    let newCallee = n.callFn
    const callee = P.nodes[n.callFn]
    // A `<paramRecv>.map/.filter(<lambda>)` over a concrete non-i32 element: pin the callback.
    if callee is Member {
      const recvNew = monoPinMapLambdas(callee.memObj, pNames, pElems, pElemTys)
      if recvNew != callee.memObj {
        newCallee = mkMember(recvNew, callee.memProp, callee.pos)
      }
      if callee.memProp == "map" || callee.memProp == "filter" {
        if n.callArgs.length == 1 {
          const elemTyOut: i32[] = []
          let elem = monoRecvParamElem(
            callee.memObj,
            pNames,
            pElems,
            pElemTys,
            elemTyOut,
          )
          let elemTy = -1
          if elemTyOut.length > 0 { elemTy = elemTyOut[0] }
          const armEl = monoFitArmElem(callee.memObj, elemTy)
          const armName = monoFitArmElemName(armEl)
          if armName != "" {
            elem = armName
            elemTy = armEl
          }
          if elem != "" && elem != "i32" {
            const cloned = monoCloneLambdaPinned(n.callArgs[0], elem, elemTy)
            if cloned >= 0 {
              const oneArg: i32[] = [cloned]
              return monoRemintCallTpl(ix, newCallee, oneArg)
            }
          }
        }
      }
    }
    const nargs: i32[] = []
    let changed = newCallee != n.callFn
    let ai = 0
    while ai < n.callArgs.length {
      const cca = monoPinMapLambdas(n.callArgs[ai], pNames, pElems, pElemTys)
      nargs.push(cca)
      if cca != n.callArgs[ai] { changed = true }
      ai = ai + 1
    }
    if !changed { return ix }
    return monoRemintCallTpl(ix, newCallee, nargs)
  }
  ix
}

// Rebuild the name→index map and `collectA`'s rep rows after a new instance lands in
// `fnStmts`: a pinned `string[]`/`f64` annotation forces types the original generic name never
// did. Both read the arena alone, so an unmoved stamp means that state is in hand; `collectA`
// resumes here alone, where only this module edits. The return inference waits for the settle.
function monoRebuild() {
  const stamp = monoArenaStamp()
  if stamp == monoRebuiltStamp { return 0 }
  caResumeArmed = true
  const caRc = collectA(monoProgStmts)
  caResumeArmed = false
  if caRc < 0 { return -1 }
  fmResumeArmed = true
  const bfmRc = buildFnMap(monoProgStmts)
  fmResumeArmed = false
  if bfmRc < 0 { return -1 }
  capMemoNoteEdit()
  monoRetPending = true
  monoRebuiltStamp = stamp
  0
}

// Set by a rebuild, whose `buildFnMap` re-seeds the return rows; cleared by `monoRetSettle`.
let monoRetPending = false

// Re-derive voidness and the inferred return kinds once, after the walk, rather than per
// instance: both are whole-program fixpoints, so per instance they cost instances x functions.
// They read capture sets and edit no body, so one run shares one capture memo (D2771).
function monoRetSettle() {
  if !monoRetPending { return 0 }
  monoRetPending = false
  capMemoNoteEdit()
  const savedArmed = capMemoArmed
  capMemoArmed = true
  computeVoidFns()
  computeRetInference()
  capMemoArmed = savedArmed
  0
}

// The parameter an un-annotated `return <local>` list is built from: a
// `<retName>.push(<param>[<idx>])` statement anywhere in `blockIx`. The built list shares
// the indexed param's array type, so the monomorphizer types the un-annotated return as
// that param's pinned type. "" = none found.
function monoListSrcParam(blockIx: i32, retName: string) {
  const b = P.nodes[blockIx]
  if b is Block {
    const stmts = b.blkStmts
    let i = 0
    while i < stmts.length {
      const r = monoListSrcParamStmt(stmts[i], retName)
      if r != "" { return r }
      i = i + 1
    }
  }
  ""
}

function monoListSrcParamStmt(ix: i32, retName: string) {
  const s = P.nodes[ix]
  if s is Block { return monoListSrcParam(ix, retName) }
  if s is WhileStmt { return monoListSrcParam(s.whileBody, retName) }
  if s is ForRange { return monoListSrcParam(s.frBody, retName) }
  if s is ForIn { return monoListSrcParam(s.fiBody, retName) }
  if s is IfStmt {
    const rt = monoListSrcParam(s.ifThen, retName)
    if rt != "" { return rt }
    if s.ifElse >= 0 { return monoListSrcParamStmt(s.ifElse, retName) }
    return ""
  }
  // A `<retName>.push(<param>[<idx>])` statement: the param is the list's element source.
  if s is Call {
    const callee = P.nodes[s.callFn]
    if callee is Member {
      if callee.memProp == "push" {
        const recv = P.nodes[callee.memObj]
        if recv is Ident {
          if recv.identName == retName {
            if s.callArgs.length == 1 {
              const arg = P.nodes[s.callArgs[0]]
              if arg is Index {
                const ia = P.nodes[arg.idxArr]
                if ia is Ident { return ia.identName }
              }
            }
          }
        }
      }
    }
  }
  ""
}

// Callback specialization: rewrite a call through a closure-typed param into a direct call
// to the non-capturing function this instance carries; `cbFnNames == ""` leaves it a
// `call_ref`. `fnDeclIx` is the ORIGINAL `FuncDecl` this walk descends from, or -1 where no
// single root names the body — a lambda-pinned generic clone, which skips the shadow check.
function monoBakeCallback(
  ix: i32,
  cbParamNames: string[],
  cbFnNames: string[],
  fnDeclIx: i32,
) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Block {
    const ns: i32[] = []
    let changed = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoBakeCallback(
        n.blkStmts[i],
        cbParamNames,
        cbFnNames,
        fnDeclIx,
      )
      ns.push(cs)
      if cs != n.blkStmts[i] { changed = true }
      i = i + 1
    }
    if !changed { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is RetStmt {
    const ca = monoBakeCallback(n.retArg, cbParamNames, cbFnNames, fnDeclIx)
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  if n is LetDecl {
    const ci = monoBakeCallback(n.letInit, cbParamNames, cbFnNames, fnDeclIx)
    if ci == n.letInit { return ix }
    return monoCopyOf(ix, mkLet(n.letKw, n.letName, n.letType, ci, n.pos))
  }
  if n is WhileStmt {
    const cb = monoBakeCallback(n.whileBody, cbParamNames, cbFnNames, fnDeclIx)
    if cb == n.whileBody { return ix }
    return mkWhileAs(n, n.whileCond, cb)
  }
  if n is IfStmt {
    // An `else if` chain is rewritten along its spine, so its depth costs no stack (D1990).
    const links = monoIfChainLinks(ix)
    const ccs: i32[] = []
    const cts: i32[] = []
    let k = 0
    while k < links.length {
      const c = P.nodes[links[k]]
      if c is IfStmt {
        ccs.push(c.ifCond)
        cts.push(monoBakeCallback(c.ifThen, cbParamNames, cbFnNames, fnDeclIx))
      }
      k = k + 1
    }
    return monoIfChainRebuild(
      links,
      ccs,
      cts,
      monoBakeCallback(
        monoIfChainElse(links),
        cbParamNames,
        cbFnNames,
        fnDeclIx,
      ),
    )
  }
  if n is ForRange {
    const cb = monoBakeCallback(n.frBody, cbParamNames, cbFnNames, fnDeclIx)
    if cb == n.frBody { return ix }
    return mkForRange(
      n.frVar,
      n.frFrom,
      n.frTo,
      n.frStep,
      n.frExcl,
      cb,
      n.frLabel,
      n.pos,
    )
  }
  if n is ForIn {
    const cb = monoBakeCallback(n.fiBody, cbParamNames, cbFnNames, fnDeclIx)
    if cb == n.fiBody { return ix }
    return mkForIn(n.fiVar, n.fiVar2, n.fiIter, cb, n.fiLabel, n.pos)
  }
  if n is Paren {
    const ci = monoBakeCallback(n.parInner, cbParamNames, cbFnNames, fnDeclIx)
    if ci == n.parInner { return ix }
    return mkParen(ci, n.pos)
  }
  if n is Call {
    // A call whose callee names a specialized closure param `f(...)` → direct call `cbFn(...)`;
    // its arguments may themselves contain such calls, so recurse there too. Skipped when a
    // block still open here shadows the param's name with a different value (D2325).
    let newCallee = n.callFn
    const callee = P.nodes[n.callFn]
    if callee is Ident {
      if (
        !fnBlockShadowsAt(fnDeclIx, sidOfNode(n.callFn), n.callFn)
        && monoReadsOwnParam(fnDeclIx, callee.identName, n.callFn)
      ) {
        let bk = 0
        while bk < cbParamNames.length {
          if cbFnNames[bk] != "" && callee.identName == cbParamNames[bk] {
            newCallee = mkIdent(cbFnNames[bk], callee.pos)
            identFromDecl(newCallee, monoFnDeclNamed(cbFnNames[bk]))
          }
          bk = bk + 1
        }
      }
    }
    const nargs: i32[] = []
    let changed = newCallee != n.callFn
    let ai = 0
    while ai < n.callArgs.length {
      const cca = monoBakeCallback(
        n.callArgs[ai],
        cbParamNames,
        cbFnNames,
        fnDeclIx,
      )
      nargs.push(cca)
      if cca != n.callArgs[ai] { changed = true }
      ai = ai + 1
    }
    if !changed { return ix }
    return monoRemintCallTpl(ix, newCallee, nargs)
  }
  if n is BinExpr {
    // Descend into a plain assignment or arithmetic node (`acc = f(acc, x)`, the
    // reduce/fold shape). A compound-assignment node is left intact — rebuilding it
    // through `mkBinary` would drop its surface tag, and its call stays a `call_ref`.
    if n.binCompound != "" { return ix }
    const cl = monoBakeCallback(n.binLeft, cbParamNames, cbFnNames, fnDeclIx)
    const cr = monoBakeCallback(n.binRight, cbParamNames, cbFnNames, fnDeclIx)
    if cl == n.binLeft && cr == n.binRight { return ix }
    return mkBinary(n.binOp, cl, cr, n.pos)
  }
  ix
}

// Whether the callee identifier at `calleeIx` resolves to a lifted slot the pre-pass flagged
// generic — the condition under which `monoWalk` reaches `monoInstantiate` and renames a callee
// `Ident` in place. An appended instance slot (past the frozen `monoGen` length) is concrete.
function monoCalleeIsGeneric(calleeIx: i32) {
  const fe = fnIndexOfNode(calleeIx)
  if fe < 0 { return false }
  if fe >= monoGen.length { return false }
  monoGen[fe] == 1
}

// ── the `is` node's per-instance twin ────────────────────────────────────────

// Four walkers re-mint or substitute an `IsExpr`, and all go through here: minting an
// `is` has a second half the `mk*` maker does not do. `isVarTyIx` — the check type the
// checker banked at the original — is keyed by node and sized at `checkProgram` entry, so
// a freshly minted node reads -1 for ever unless it is banked, demoting `emitIs` to names.
function monoMkIsExprLike(ix: i32, io: i32, variant: string) {
  const n = P.nodes[ix]
  if n is IsExpr {
    if n.isNeg == 1 { return mkIsExprNeg(io, variant, n.pos) }
    return mkIsExpr(io, variant, n.pos)
  }
  -1
}
// Re-parent onto the rewritten receiver `io`: the same test, so the banked row carries.
function monoReIsExpr(ix: i32, io: i32) {
  const n = P.nodes[ix]
  if n is IsExpr {
    const nx = monoMkIsExprLike(ix, io, n.isVariant)
    recordClonedIsVarTyIx(nx, isVarTyIxOf(ix))
    return nx
  }
  ix
}
// D951 — `is T` against the type parameter itself. Under monomorphization `T` is concrete
// per instance, so substituting the spelling makes `y is T` at `T := i32` the same program
// as `y is i32` and the whole existing ladder applies unchanged. The banked row must come
// from the new spelling: the original's is the declaration's `TyVar`, which renders empty.
function monoSubstIsExpr(ix: i32, io: i32, variant: string) {
  const n = P.nodes[ix]
  if n is IsExpr {
    // A parameter bound to a literal's `#anon` row banks the list of the row's shape as the
    // check type, which is the arm an inferred union holds for it (D5083).
    const nx = monoMkIsExprLike(ix, io, variant)
    const aty = monoAnonRowListTy(variant)
    if aty >= 0 {
      recordClonedIsVarTyIx(nx, aty)
    } else {
      recordClonedIsVarTy(nx, variant)
    }
    return nx
  }
  ix
}

// The list type over a literal's `#anon` row's shape that `name` spells (`#anon0[]` is
// `{x:i32}[]`); -1 for any other name, the bare row and a row with no recorded type included.
function monoAnonRowListTy(name: string): i32 {
  let base = name
  let depth = 0
  while (
    base.length > 2
    && base[base.length - 1] == ']'
    && base[base.length - 2] == '['
  ) {
    base = base.slice(0, base.length - 2)
    depth = depth + 1
  }
  if depth == 0 || base.length < 5 || base[0] != '#' { return -1 }
  const si = structIndexByName(base)
  if si < 0 || si >= sTyIx.length || sTyIx[si] < 0 { return -1 }
  let ty = sTyIx[si]
  while depth > 0 {
    ty = mkArrayTy(ty)
    depth = depth - 1
  }
  ty
}

// The instance `monoCloneGenericCalls` is copying: its template's type parameters and their
// bindings, so an explicit type argument naming one (`make<T>()`) is substituted per instance.
let monoCgcTyParams: string[] = []
let monoCgcTvN: string[] = []
let monoCgcTvV: string[] = []
// The re-made list literals `monoLitReachesPinDefaultClash` answered for: the emitter refuses
// each rather than build it untyped or print D2816's value.
export let monoClashLits: i32[] = []

// Whether list literal `ix` is one of `monoClashLits`.
export function monoIsClashLit(ix: i32): boolean {
  monoSeenHas(monoClashLits, ix)
}
// The instance's exact bindings when it is keyed by its exact pins, so a type argument naming a
// type parameter records the exact pinned type rather than its spelling; empty otherwise.
// The instance's type-parameter bindings as arena types, read by the D2816 clash rung.
let monoCgcBN: string[] = []
let monoCgcBT: i32[] = []
let monoCgcSubN: string[] = []
let monoCgcSubT: i32[] = []
// The lambda bindings whose calls the instance body copies (`monoInstLamNames`): a call
// through one is instantiated per call like a generic's.
let monoCgcLamNames: string[] = []
// The callee names of those copies. An instance's call through one is by name even at the
// lambda's first instance, since the value path reads the template's element and result kinds.
let monoLamCallCallees: i32[] = []
// The module's own top-level lambda bindings, which an instance body calls as it calls its own.
let monoProgLamNames: string[] = []
// The instance's hole parameters bound to their pins, as `monoHoleRetSubst` binds them.
let monoCgcHoleN: string[] = []
let monoCgcHoleT: i32[] = []

// The type a copied call through a lambda binding answers at this instance: its recorded type
// substituted through the instance's binding, then its holes; the recorded type when a
// variable stays.
function monoLamCallTy(t: i32): i32 {
  if t < 0 || !tyHasTyVar(t) { return t }
  const st = monoHoleTy(substTyDeep(t, monoCgcBN, monoCgcBT))
  if st < 0 || tyHasTyVar(st) { return t }
  st
}

// Whether lambda `fnIx`, bound by a `const` of the instance body that only calls it directly,
// returns a hole parameter of the instance or a field chain off one, which its env stores at
// the pin. Any other lambda keeps its inferred return: a value read of its binding, or a call
// from inside another lambda, sees the template's signature (D2878).
function monoRetReadsHoleParam(rex: i32, fnIx: i32): boolean {
  if rex < 0 || !i32ListHas(monoCgcLamDeclX, fnIx) { return false }
  let at = unwrapParen(rex)
  let hops = 0
  while at >= 0 && hops < 16 {
    const n = P.nodes[at]
    if n is Member {
      at = unwrapParen(n.memObj)
    } else if n is Ident {
      if monoFnBindsParam(fnIx, n.identName) { return false }
      return monoStrListHas(monoCgcHoleParams, n.identName)
    } else {
      return false
    }
    hops = hops + 1
  }
  false
}

// The lambdas the instance body binds by an un-annotated `const`, once, and reads only as the
// callee of a direct call outside any lambda (`monoCollectLamDecls`).
let monoCgcLamDeclX: i32[] = []

// Appends to the table each such lambda under `body`, whose binder counts are `bn`/`bc`.
function monoCollectLamDecls(ix: i32, body: i32, bn: string[], bc: i32[]) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  if n is LetDecl {
    if n.letKw == "const" && n.letType < 0 && n.letInit >= 0 {
      const li = unwrapParen(n.letInit)
      if (
        li >= 0
        && P.nodes[li] is FuncDecl
        && monoBinderCount(bn, bc, n.letName) == 1
        && monoNameOnlyCalled(body, n.letName, false)
      ) {
        monoCgcLamDeclX.push(li)
      }
    }
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    monoCollectLamDecls(kids[i], body, bn, bc)
    i = i + 1
  }
  0
}

// Whether every read of `name` under `ix` is the callee of a direct call outside any lambda;
// `inLam` is whether `ix` is inside one.
function monoNameOnlyCalled(ix: i32, name: string, inLam: boolean): boolean {
  if ix < 0 || ix >= P.nodes.length { return true }
  const n = P.nodes[ix]
  if n is Ident { return n.identName != name }
  let skip = -1
  if n is Call {
    const cal = P.nodes[n.callFn]
    if cal is Ident {
      if cal.identName == name {
        if inLam { return false }
        skip = n.callFn
      }
    }
  }
  const lam = inLam || n is FuncDecl
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if kids[i] != skip && !monoNameOnlyCalled(kids[i], name, lam) {
      return false
    }
    i = i + 1
  }
  true
}

// The instance's un-annotated parameter names, beside `monoCgcHoleN`.
let monoCgcHoleParams: string[] = []

// `t` with the instance's holes substituted, when it still names a variable; `t` otherwise.
function monoHoleTy(t: i32): i32 {
  if t < 0 || !tyHasTyVar(t) || monoCgcHoleN.length == 0 { return t }
  substTyDeep(t, monoCgcHoleN, monoCgcHoleT)
}

// The names of the un-annotated parameters in `params` that `body` binds nowhere again.
function monoHoleParamNames(params: i32[], body: i32): string[] {
  const bn: string[] = []
  const bc: i32[] = []
  monoBinderCounts(body, bn, bc)
  const out: string[] = []
  let i = 0
  while i < params.length {
    const pp = P.nodes[params[i]]
    if pp is Param {
      if pp.parType < 0 && monoBinderCount(bn, bc, pp.parName) == 0 {
        out.push(pp.parName)
      }
    }
    i = i + 1
  }
  out
}

// Binds, into `hN`/`hT`, each hole parameter of the generic at `origFe` to its column in
// `tyCol`, as `monoHoleRetSubst` does for the return.
function monoHoleBinding(
  origFe: i32,
  params: i32[],
  tyCol: i32[],
  hN: string[],
  hT: i32[],
) {
  if origFe < 0 || origFe >= monoOrigNode.length { return 0 }
  const ftIx = nodeTyIxOf(monoOrigNode[origFe])
  if ftIx < 0 || ftIx >= T.tys.length { return 0 }
  const ft = T.tys[ftIx]
  if ft is TyFunc {
    let i = 0
    while i < params.length && i < ft.fnParamTypes.length && i < tyCol.length {
      const pp = P.nodes[params[i]]
      if pp is Param {
        if pp.parType < 0 { bindGenWalk(ft.fnParamTypes[i], tyCol[i], hN, hT) }
      }
      i = i + 1
    }
  }
  0
}

// Appends to `out` each name an un-annotated `let`/`const` under `ix` binds to a lambda with a
// hole parameter, which is instantiated per call, to one whose type names a hole of this
// instance's (a capture: D2900), or to a name already in `out`.
function monoLamBoundNames(ix: i32, out: string[]) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  if n is LetDecl {
    if n.letType < 0 && n.letInit >= 0 {
      const iv = P.nodes[unwrapParen(n.letInit)]
      if iv is FuncDecl {
        const li = unwrapParen(n.letInit)
        const capHole = monoCgcHoleN.length > 0 && monoLamTyNamesHoleValue(li)
        if monoIsGenericDecl(li) || capHole { monoNoteName(out, n.letName) }
      } else if iv is Ident {
        if monoStrListHas(out, iv.identName) { monoNoteName(out, n.letName) }
      }
    }
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    monoLamBoundNames(kids[i], out)
    i = i + 1
  }
  0
}

// Whether `name`, read in frame `fx`, is a parameter of `fx` or of a frame enclosing it before a
// frame that declares a nested function of that name.
function monoNameIsParamOnChain(name: string, fx: i32): boolean {
  let f = fx
  let guard = 0
  while f >= 0 && f < P.nodes.length && guard <= fnStmts.length {
    if monoFnBindsParam(f, name) { return true }
    const slot = fnStmtsPosOf(f)
    if slot < 0 || slot >= fnParent.length { return false }
    if nestedFnDeclaredIn(name, slot) >= 0 { return false }
    const ps = fnParent[slot]
    if ps < 0 || ps >= fnStmts.length { return false }
    f = fnStmts[ps]
    guard = guard + 1
  }
  false
}

// The template slot of the generic function the flow table says read `at` names through its
// aliases (`fnFlowReadGenFn`); -1 for none.
function monoReadGenFnFe(at: i32): i32 {
  const d = fnFlowReadGenFn(at)
  if d < 0 { return -1 }
  const fe = fnStmtsPosOf(d)
  if fe < 0 || fe >= monoGen.length || monoGen[fe] != 1 { return -1 }
  fe
}

// The un-annotated `let` that a chain of un-annotated, never-written aliases read at `at` in frame
// `ctx` ends at, when that `let` is written or holds a hole lambda (`let f = g; f = h; const a =
// f`): [the node naming it, that node's frame, 1 when it is written]. [-1, -1, 0] for any other
// chain, and for a name that is that `let` itself.
function monoAliasLetEnd(at: i32, ctx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1, 0]
  let ax = at
  let fr = ctx
  let hops = 0
  while hops < MONO_ALIAS_CHAIN_MAX {
    const lf = monoReadLetFrame(ax, fr)
    if lf[1] < 0 { return none }
    const d = P.nodes[lf[1]]
    if !(d is LetDecl) || d.letType >= 0 || d.letInit < 0 { return none }
    if d.letKw == "let" {
      const written = monoLetWrittenIn(lf)
      let lam = false
      if !written && monoNestedBodyOf(d.letInit) >= 0 {
        const ls = fnStmtsPosOf(d.letInit)
        lam = ls >= 0 && criFnIsAnonLambda(ls)
      }
      if written || lam {
        if hops == 0 { return none }
        let w = 0
        if written { w = 1 }
        const out: i32[] = [ax, fr, w]
        return out
      }
    }
    if monoIdentNameOf(d.letInit) == "" { return none }
    ax = d.letInit
    fr = lf[0]
    hops = hops + 1
  }
  none
}

// Renames the initializer of `const alias = tpl`, the alias read at `at` in frame `ctx`, to
// instance `inst`, so the alias's value is a closure over this frame's captures. The calls through
// the alias are renamed to their own instances; the first one names the value.
function monoRenameGenAliasInit(at: i32, ctx: i32, tpl: string, inst: string) {
  const lf = monoReadLetFrame(at, ctx)
  if lf[1] < 0 { return 0 }
  const d = P.nodes[lf[1]]
  if !(d is LetDecl) || d.letInit < 0 { return 0 }
  if (
    (d.letKw != "const" && monoLetIsAssigned(d.letName, lf[1]))
    || d.letType >= 0
  ) {
    return 0
  }
  const iv = P.nodes[d.letInit]
  if !(iv is Ident) { return 0 }
  // An alias of an alias renames the link that names the generic (D3894).
  if iv.identName != tpl {
    if iv.identName == d.letName { return 0 }
    return monoRenameGenAliasInit(d.letInit, ctx, tpl, inst)
  }
  collectANoteIdentRename(iv.identName)
  iv.identName = inst
  monoArenaTouch()
  sidNoteNodeName(d.letInit, monoFnDeclNamed(inst))
  0
}

// The names instance body `body` binds once, by an un-annotated binding never written, to a generic function
// read by name: a call through one is renamed to the instance it reaches, which must be this
// instance's own copy of the call (D3887).
let monoCgcGenAliasNames: string[] = []

function monoInstGenAliasNames(body: i32): string[] {
  const bn: string[] = []
  const bc: i32[] = []
  monoBinderCounts(body, bn, bc)
  const out: string[] = []
  // An alias of an alias is found once its target is, so a pass that adds a name runs again.
  let grew = true
  let pass = 0
  while grew && pass < MONO_ALIAS_CHAIN_MAX {
    grew = false
    const stack: i32[] = [body]
    while stack.length > 0 {
      const ix = stack.pop() ?? -1
      if ix >= 0 && ix < P.nodes.length {
        const d = P.nodes[ix]
        if d is LetDecl {
          if (
            (d.letKw == "const" || !monoLetIsAssigned(d.letName, ix))
            && d.letType < 0
            && d.letInit >= 0
            && P.nodes[d.letInit] is Ident
            && (monoCalleeIsGeneric(d.letInit)
              || monoStrListHas(out, monoIdentNameOf(d.letInit)))
            && monoBinderCount(bn, bc, d.letName) <= 1
            && !monoStrListHas(out, d.letName)
          ) {
            out.push(d.letName)
            grew = true
          }
        }
        // A nested function's body is its own instance's, copied there.
        if !(d is FuncDecl) || ix == body {
          for k in nodeChildren(ix) { stack.push(k) }
        }
      }
    }
    pass = pass + 1
  }
  out
}

// The lambda names whose calls instance body `body` copies: the module's and its own, less
// any name the body binds twice or shadows. A copied call is a node with no source position,
// so a name that needs one to pick its binding keeps its calls shared, as before.
function monoInstLamNames(body: i32): string[] {
  const bn: string[] = []
  const bc: i32[] = []
  monoBinderCounts(body, bn, bc)
  monoCgcLamDeclX = []
  monoCollectLamDecls(body, body, bn, bc)
  const own: string[] = []
  monoLamBoundNames(body, own)
  const out: string[] = []
  let k = 0
  while k < monoProgLamNames.length {
    const pn = monoProgLamNames[k]
    if monoBinderCount(bn, bc, pn) == 0 && !monoStrListHas(own, pn) {
      out.push(pn)
    }
    k = k + 1
  }
  k = 0
  while k < own.length {
    if monoBinderCount(bn, bc, own[k]) <= 1 { out.push(own[k]) }
    k = k + 1
  }
  out
}

// Whether lambda `li`'s type names a type variable, its result is not a function (a call of a
// returned function is typed by no copy) and its return is pinned at the holes, so a copied
// call's type is the rep the lambda returns (`monoRetReadsHoleParam`).
function monoLamTyNamesHoleValue(li: i32): boolean {
  const t = nodeTyIxOf(li)
  if t < 0 || !tyHasTyVar(t) { return false }
  const rex = fnRetExprOf(li)
  if rex < 0 || !monoRetReadsHoleParam(rex, li) { return false }
  const ft = T.tys[t]
  if ft is TyFunc {
    if ft.fnRet < 0 { return false }
    return !(T.tys[ft.fnRet] is TyFunc)
  }
  false
}

// How many binders `bn`/`bc` counted for `name`.
function monoBinderCount(bn: string[], bc: i32[], name: string): i32 {
  let i = 0
  while i < bn.length && i < bc.length {
    if bn[i] == name { return bc[i] }
    i = i + 1
  }
  0
}

// Counts, per name, the bindings under `ix` that resolve by position: `let`/`const`, loop
// variables and nested named functions.
function monoBinderCounts(ix: i32, bn: string[], bc: i32[]) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = P.nodes[ix]
  if n is LetDecl { monoBinderBump(bn, bc, n.letName) }
  if n is ForRange { monoBinderBump(bn, bc, n.frVar) }
  if n is ForIn {
    monoBinderBump(bn, bc, n.fiVar)
    if n.fiVar2 != "" { monoBinderBump(bn, bc, n.fiVar2) }
  }
  if n is FuncDecl {
    if monoFnNameIsSourceNamed(n.fnName) { monoBinderBump(bn, bc, n.fnName) }
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    monoBinderCounts(kids[i], bn, bc)
    i = i + 1
  }
  0
}

function monoBinderBump(bn: string[], bc: i32[], name: string) {
  let i = 0
  while i < bn.length && i < bc.length {
    if bn[i] == name {
      // arena-tick exempt: a count local to one instance's name filter, read by no pass.
      bc[i] = bc[i] + 1
      return 0
    }
    i = i + 1
  }
  bn.push(name)
  bc.push(1)
  0
}

function monoNoteName(xs: string[], v: string) {
  if !monoStrListHas(xs, v) { xs.push(v) }
  0
}

function monoStrListHas(xs: string[], v: string): boolean {
  let i = 0
  while i < xs.length {
    if xs[i] == v { return true }
    i = i + 1
  }
  false
}

// The explicit type-argument nodes of a cloned call, each substituted under the instance
// being copied; an argument naming no type parameter is shared unchanged.
function monoSubstTyArgNodes(tas: i32[]): i32[] {
  const out: i32[] = []
  let i = 0
  while i < tas.length {
    const sub = monoSubstAnnNode(
      tas[i],
      monoCgcTyParams,
      monoCgcTvN,
      monoCgcTvV,
      monoCgcSubN,
      monoCgcSubT,
    )
    if sub >= 0 { out.push(sub) } else { out.push(tas[i]) }
    i = i + 1
  }
  out
}

// Whether an instance already minted in this pass carries the name `nm`.
function monoInstNameTaken(nm: string): boolean {
  for n in monoInstName {
    if n == nm { return true }
  }
  false
}

// The bindings the instance enclosing nested function `origFe` holds for type parameters
// `own` does not redeclare, appended to `outN`/`outT`: that of `callFrame`, else of the
// template's frame, else the nearest enclosing instance's. Nothing for a function that
// shadows an enclosing parameter, which a by-name binding cannot tell apart (D3840).
function monoEnclosingPinRow(
  origFe: i32,
  callFrame: i32,
  own: string[],
  outN: string[],
  outT: i32[],
) {
  if origFe < 0 || origFe >= fnParent.length { return 0 }
  let pos = fnParent[origFe]
  if callFrame >= 0 { pos = callFrame }
  let guard = 0
  while pos >= 0 && guard <= fnStmts.length {
    const row = monoPinSubRow.get(pos) ?? -1
    if row >= 0 && row < monoPinSubN.length {
      const ns = monoPinSubN[row]
      const ts = monoPinSubT[row]
      let i = 0
      while i < ns.length && i < ts.length {
        if (
          !strListHas(own, ns[i])
          && !strListHas(outN, ns[i])
          && !tyHasTyVar(ts[i])
        ) {
          outN.push(ns[i])
          outT.push(ts[i])
        }
        i = i + 1
      }
      return 0
    }
    if pos >= fnParent.length { return 0 }
    pos = fnParent[pos]
    guard = guard + 1
  }
  0
}

// The declared type parameters a nested generic redeclares, renamed apart: each row of the
// enclosing declarer's `T` becomes `T__sh<slot>`, which that declarer's instances also bind, so
// a read typed at the outer `T` inside the nested one takes the outer pin (D3840). Parallel
// columns: the declarer's slot, the parameter's name, and its alias.
let monoShAliasSlot: i32[] = []
let monoShAliasName: string[] = []
let monoShAliasTo: string[] = []

// Renames apart every declared type parameter a nested generic among the first `nDecl` slots
// redeclares. -1 when a row belongs to both functions, which no alias can split.
function monoShadowRename(nDecl: i32): i32 {
  monoShAliasSlot = []
  monoShAliasName = []
  monoShAliasTo = []
  let fe = 0
  while fe < nDecl && fe < fnParent.length {
    const f = P.nodes[fnStmts[fe]]
    if f is FuncDecl {
      if f.fnTyParams.length > 0 && monoNestedShadowsOuter(fe) {
        for tp in f.fnTyParams {
          let p = fnParent[fe]
          let guard = 0
          while p >= 0 && p < fnParent.length && guard <= fnStmts.length {
            const pf = P.nodes[fnStmts[p]]
            if pf is FuncDecl {
              if strListHas(pf.fnTyParams, tp) {
                if monoShadowRenameDecl(p, fe, tp) < 0 { return -1 }
              }
            }
            p = fnParent[p]
            guard = guard + 1
          }
        }
      }
    }
    fe = fe + 1
  }
  0
}

// Renames declarer `d`'s rows of type parameter `name` apart from those of nested generic
// `inner`, which redeclares it. -1, with the failure recorded, when the two share a row.
function monoShadowRenameDecl(d: i32, inner: i32, name: string): i32 {
  let k = 0
  while k < monoShAliasSlot.length {
    if monoShAliasSlot[k] == d && monoShAliasName[k] == name { return 0 }
    k = k + 1
  }
  const own = monoTyParamRows(fnStmts[d], name)
  const theirs = monoTyParamRows(fnStmts[inner], name)
  for r in own {
    if i32ListHas(theirs, r) {
      return emitFail(
        "emitProgram: a nested generic that redeclares its enclosing function's type parameter shares that parameter's type with it — rename the nested one",
      )
    }
  }
  const alias = name + "__sh" + i32ToStr(d)
  for r in own { tyVarRenameRow(r, alias) }
  monoShAliasSlot.push(d)
  monoShAliasName.push(name)
  monoShAliasTo.push(alias)
  0
}

// The type variable rows named `name` that the annotations of function node `fx` resolve to,
// its nested functions' included except those redeclaring `name`.
function monoTyParamRows(fx: i32, name: string): i32[] {
  const out: i32[] = []
  const stack: i32[] = [fx]
  while stack.length > 0 {
    const cur = stack.pop() ?? -1
    if cur >= 0 && cur < P.nodes.length {
      const nd = P.nodes[cur]
      let enter = true
      if nd is FuncDecl {
        if cur != fx && strListHas(nd.fnTyParams, name) { enter = false }
      } else if nd is TypeRef {
        monoTyVarRowsNamed(nodeTyIxOf(cur), name, out, 0)
      }
      if enter {
        for c in nodeChildren(cur) { stack.push(c) }
      }
    }
  }
  out
}

// Appends to `out` the type variable rows named `name` that type `t` holds. Bounded by depth.
function monoTyVarRowsNamed(t: i32, name: string, out: i32[], depth: i32) {
  if t < 0 || t >= T.tys.length || depth > 16 { return 0 }
  const ty = T.tys[t]
  match ty {
    TyVar => {
      if ty.tvName == name && !i32ListHas(out, t) { out.push(t) }
    }
    TyArray => {
      monoTyVarRowsNamed(ty.aElem, name, out, depth + 1)
    }
    TyNullable => {
      monoTyVarRowsNamed(ty.nInner, name, out, depth + 1)
    }
    TyMap => {
      monoTyVarRowsNamed(ty.mKey, name, out, depth + 1)
      monoTyVarRowsNamed(ty.mVal, name, out, depth + 1)
    }
    TyUnion => {
      for m in ty.uMembers { monoTyVarRowsNamed(m, name, out, depth + 1) }
    }
    TyObj => {
      for ft in ty.objFieldTypes {
        monoTyVarRowsNamed(ft, name, out, depth + 1)
      }
    }
    TyFunc => {
      for pt in ty.fnParamTypes { monoTyVarRowsNamed(pt, name, out, depth + 1) }
      monoTyVarRowsNamed(ty.fnRet, name, out, depth + 1)
    }
    TyPrim | TyLit | TyNeg | TyErr => {}
  }
  0
}

// Binds, beside each of instance `origFe`'s own parameters in `ns`/`ts`, the alias
// `monoShadowRename` gave its rows.
function monoShAliasBind(origFe: i32, ns: string[], ts: i32[]) {
  let k = 0
  while k < monoShAliasSlot.length {
    if monoShAliasSlot[k] == origFe && !strListHas(ns, monoShAliasTo[k]) {
      let i = 0
      const n0 = ns.length
      while i < n0 && i < ts.length {
        if ns[i] == monoShAliasName[k] {
          ns.push(monoShAliasTo[k])
          ts.push(ts[i])
          i = n0
        }
        i = i + 1
      }
    }
    k = k + 1
  }
  0
}

// The enclosing-frame instance `monoInstantiate` hands `monoMakeInstance` for a capturing nested
// generic called from it, consumed (and cleared) where the key is built; -1 for none.
let monoCallFrameSlot = 0 - 1
// Callee identifiers resolved through a `let` alias chain: their calls are never re-spelled to
// the lambda's instance, since the alias may hold another value at run time (D3849).
let monoNoRename: i32[] = []
// Callee identifiers that read a `let`/`const`, keyed to that binding, once renamed to an instance.
let monoAliasCallDecl: {[i32]: i32} = Map()

// Notes callee `calleeIx` before its rename to an instance, when it reads a binding.
function monoAliasCallNote(calleeIx: i32) {
  if monoAliasCallDecl.has(calleeIx) { return 0 }
  const d = identDeclOf(calleeIx)
  if d >= 0 && d < P.nodes.length && P.nodes[d] is LetDecl {
    monoAliasCallDecl.set(calleeIx, d)
  }
  0
}

// The binding callee `calleeIx` read before a rename pointed it at an instance, else -1.
export function monoAliasDeclOf(calleeIx: i32): i32 {
  monoAliasCallDecl.get(calleeIx) ?? -1
}
// Per template slot, the frame-keyed instances minted while its slot still holds the template;
// they leave the slot to the template frame's own first instance.
let monoFramedPushes: {[i32]: i32} = Map()

// The instance of nested function `fe`'s enclosing frame that `ctx` is, when that is not the
// template's own frame: a capturing nested generic needs one instance per enclosing instance,
// whose env holds that instance's captures (D3826), and a call from a function or lambda
// nested deeper in it takes it too, carrying the captures through its own env (D3827).
function monoNestedCallFrame(fe: i32, ctx: i32): i32 {
  if fe < 0 || fe >= fnParent.length || ctx < 0 { return -1 }
  const p0 = fnParent[fe]
  if p0 < 0 || captureCountOf(fe) == 0 { return -1 }
  let sl = fnStmtsPosOf(ctx)
  if sl < 0 || sl >= fnInstOrigin.length || sl >= fnParent.length { return -1 }
  // A recursive call from a frame-keyed instance keeps that instance's frame.
  if fnInstOrigin[sl] == fe { sl = fnParent[sl] }
  if sl < 0 || sl == p0 || sl >= fnInstOrigin.length { return -1 }
  if fnInstOrigin[sl] == p0 { return sl }
  let up = sl
  let guard = 0
  while up >= 0 && up < fnParent.length && guard <= fnStmts.length {
    up = fnParent[up]
    if up == p0 || up == fe { return -1 }
    // Inside an instance of the nested generic itself: that instance's frame is the answer.
    if up >= 0 && up < fnInstOrigin.length && fnInstOrigin[up] == fe {
      const own = fnParent[up]
      if own >= 0 && own < fnInstOrigin.length && fnInstOrigin[own] == p0 {
        return own
      }
      return -1
    }
    if up >= 0 && up < fnInstOrigin.length && fnInstOrigin[up] == p0 {
      return up
    }
    guard = guard + 1
  }
  -1
}

// Whether nested function `fe` declares a type parameter an enclosing function declares too.
// Type variables are substituted by name, so its instance cannot tell its own `T` from the
// enclosing one; such a function is left to the shared path (D3832).
function monoNestedShadowsOuter(fe: i32): boolean {
  if fe < 0 || fe >= monoOrigNode.length { return false }
  const f = P.nodes[monoOrigNode[fe]]
  if !(f is FuncDecl) { return false }
  let p = -1
  if fe < fnParent.length { p = fnParent[fe] }
  let guard = 0
  while p >= 0 && p < monoOrigNode.length && guard <= fnStmts.length {
    const pf = P.nodes[monoOrigNode[p]]
    if pf is FuncDecl {
      for tp in f.fnTyParams {
        if strListHas(pf.fnTyParams, tp) { return true }
      }
    }
    if p >= fnParent.length { return false }
    p = fnParent[p]
    guard = guard + 1
  }
  false
}

// The instance-key suffix `monoInstantiate` hands `monoMakeInstance` for a call with explicit
// type arguments, consumed (and cleared) where the key is built.
let monoKeyExtra = ""
// The same call's explicit bindings as arena types, consumed beside `monoKeyExtra`: the type
// column a body annotation substitutes through, which the parameters alone cannot bind for a
// type parameter no parameter mentions (D2676).
let monoExplicitBN: string[] = []
let monoExplicitBT: i32[] = []
// Which arguments of the direct call being instantiated are object literals, consumed beside
// `monoKeyExtra`: only a literal's own type is certain of its field values (D2762).
let monoPinArgLit: boolean[] = []

// Binds `typarams` to the call's explicit type arguments (their canonical spellings) in `tvN`
// / `tvV`. Answers the key suffix: the bindings of the parameters no value parameter mentions,
// the ones the pins cannot tell apart (`make<i32>()` and `make<string>()` pin nothing).
function monoBindExplicitTyArgs(
  callIx: i32,
  typarams: string[],
  params: i32[],
  tvN: string[],
  tvV: string[],
): string {
  monoExplicitBN = []
  monoExplicitBT = []
  const tas = callTyArgsOf(callIx)
  if tas.length != typarams.length { return "" }
  let extra = ""
  let i = 0
  while i < tas.length {
    let nm = tyNameOf(tas[i])
    if nm != "" {
      const at = nodeTyIxOf(tas[i])
      // A lone string literal argument binds the literal, which the name softens (D7340).
      const lit = oneStrLitSpelling(at)
      if lit != "" && nm == "string" { nm = lit }
      if at >= 0 && tyHasTyVar(at) && tyHasTyVarWasCapped() {
        emitFail(
          "emitProgram: monomorphize: a type argument nested past 20000 levels or with more than 100000 distinct parts cannot be pinned",
        )
      }
      if at >= 0 && !tyHasTyVar(at) {
        monoExplicitBN.push(typarams[i])
        monoExplicitBT.push(at)
      }
      tvN.push(typarams[i])
      tvV.push(nm)
      const one: string[] = [typarams[i]]
      if !monoParamsMention(params, one) {
        extra = extra + typarams[i] + "=" + nm + ";"
      }
    }
    i = i + 1
  }
  extra
}

// The spelling an inferred call binds a type parameter to when no parameter names it and no
// type argument is written. Only a body local can name such a parameter and it holds no value
// of it, and an `is` arm reading it at another type reads an empty list, so no read tells (D4911;
// DECISIONS.md §"An unbound type parameter defaults at the call").
const MONO_UNBOUND_TY_PARAM_DEFAULT = "i32"

// Binds each of `typarams` that is still unbound in `tvN`, that no annotation in `params` names
// and that reaches no spelling the default would answer (`monoTyParamReachesSpelling`) to the
// default, in the pin columns and the arena bindings, and keys the instance on it as an
// explicit type argument would, so `opT(a)` and `opT<i32, i32>(a)` share one instance.
function monoDefaultUnboundTyParams(
  typarams: string[],
  params: i32[],
  tvN: string[],
  tvV: string[],
  body: i32,
) {
  for tp in typarams {
    const one: string[] = [tp]
    const seen: i32[] = []
    if (
      monoBindOf(tvN, tvV, tp) == ""
      && !monoParamsMention(params, one)
      && !monoTyParamReachesSpelling(body, one, seen)
    ) {
      monoBindTyParamDefault(tp, tvN, tvV)
    }
  }
  0
}

// Whether a binding of `names` could reach an `is` check type or a `T.field` layout constant,
// in the subtree at `ix` or in a generic it calls with a type argument naming them or an
// argument whose type has a type variable. Those spellings would answer the default, so a
// parameter that reaches one stays unbound. `seen` holds the callees already walked.
function monoTyParamReachesSpelling(
  ix: i32,
  names: string[],
  seen: i32[],
): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  if monoNodeNamesTyParam(ix, names) { return true }
  if monoListIsUnhandable(ix, names, ix) { return true }
  monoTyParamCallReaches(ix, names, seen)
}

// Whether an `is K[]` under `ix` tests a receiver whose type names one of `names` and whose arm
// reads it where it cannot be handed an empty `K[]` in place of the default's (D4911): a field,
// whose region reads it through another place of the same name.
function monoListIsUnhandable(ix: i32, names: string[], body: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = P.nodes[ix]
  if n is IsExpr {
    const kTy = isVarTyIxOf(ix)
    const rTy = nodeTyIxOf(n.isObj)
    if (
      kTy >= 0
      && kTy < T.tys.length
      && T.tys[kTy] is TyArray
      && rTy >= 0
      && rTy < T.tys.length
      && monoAnnHasTyParam(tyToStr(rTy), names)
    ) {
      const r = P.nodes[unwrapParen(n.isObj)]
      if r is Member && narrowRegionReads(body, ix, r.memProp, true) == 2 {
        return true
      }
    }
  }
  for k in nodeChildren(ix) {
    if monoListIsUnhandable(k, names, body) { return true }
  }
  false
}

// Where `isIx` sits under `ix`: 0 not there, 2 when a region it narrows reads `name` (an `if`
// or `while` body or else, the right of an `&&`/`||`, and the block's later statements after an
// `if` whose condition negates the test), 3 for that negated `if` before its block is read,
// else 1. A later `is` over the same receiver is not a read.
export function narrowRegionReads(
  ix: i32,
  isIx: i32,
  name: string,
  field: boolean,
): i32 {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  if ix == isIx { return 1 }
  const n = P.nodes[ix]
  if n is IfStmt {
    const c = narrowRegionReads(n.ifCond, isIx, name, field)
    if c == 0 {
      const t = narrowRegionReads(n.ifThen, isIx, name, field)
      if t != 0 { return t }
      return narrowRegionReads(n.ifElse, isIx, name, field)
    }
    if (
      c == 2
      || nodeReadsName(n.ifThen, name, field)
      || nodeReadsName(n.ifElse, name, field)
    ) {
      return 2
    }
    return if condNegates(n.ifCond, isIx) { 3 } else { 1 }
  }
  if n is WhileStmt {
    const c = narrowRegionReads(n.whileCond, isIx, name, field)
    if c == 0 { return narrowRegionReads(n.whileBody, isIx, name, field) }
    if c == 2 || nodeReadsName(n.whileBody, name, field) { return 2 }
    return if condNegates(n.whileCond, isIx) { 3 } else { 1 }
  }
  if n is BinExpr && (n.binOp == "&&" || n.binOp == "||") {
    const c = narrowRegionReads(n.binLeft, isIx, name, field)
    if c == 0 { return narrowRegionReads(n.binRight, isIx, name, field) }
    if c == 2 || nodeReadsName(n.binRight, name, field) { return 2 }
    return c
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    const k = narrowRegionReads(kids[i], isIx, name, field)
    if k == 3 && n is Block {
      let j = i + 1
      while j < kids.length {
        if nodeReadsName(kids[j], name, field) { return 2 }
        j = j + 1
      }
      return 1
    }
    if k != 0 { return k }
    i = i + 1
  }
  0
}

// Whether the condition `ix` holds the test `isIx` under an odd number of negations, counting
// `!` and a `!is` itself.
function condNegates(ix: i32, isIx: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = P.nodes[ix]
  if ix == isIx { return n is IsExpr && n.isNeg != 0 }
  if n is Unary && n.unOp == "!" { return !condNegates(n.unArg, isIx) }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if nodeContains(kids[i], isIx) { return condNegates(kids[i], isIx) }
    i = i + 1
  }
  false
}

// Whether node `target` is `ix` or lies under it.
export function nodeContains(ix: i32, target: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  if ix == target { return true }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if nodeContains(kids[i], target) { return true }
    i = i + 1
  }
  false
}

// Whether `name` is read anywhere under `ix`, as an identifier or, for a `field`, a member; the
// receiver of an `is` is not a read.
function nodeReadsName(ix: i32, name: string, field: boolean): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = P.nodes[ix]
  if field && n is Member && n.memProp == name { return true }
  if !field && n is Ident && n.identName == name { return true }
  if n is IsExpr {
    const r = P.nodes[unwrapParen(n.isObj)]
    if !field && r is Ident && r.identName == name { return false }
    if field && r is Member && r.memProp == name {
      return nodeReadsName(r.memObj, name, field)
    }
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if nodeReadsName(kids[i], name, field) { return true }
    i = i + 1
  }
  false
}

// `monoTyParamReachesSpelling`'s walk over the generic calls in the subtree at `ix`.
function monoTyParamCallReaches(
  ix: i32,
  names: string[],
  seen: i32[],
): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = P.nodes[ix]
  if n is Call {
    const cf = P.nodes[n.callFn]
    if cf is Ident {
      const fe = fnIndexOf(cf.identName)
      if fe >= 0 && fe < fnStmts.length && !i32ListHas(seen, fe) {
        const g = P.nodes[fnStmts[fe]]
        if g is FuncDecl {
          if g.fnTyParams.length > 0 && monoCallMayBind(ix, n.callArgs, names) {
            seen.push(fe)
            if monoTyParamReachesSpelling(g.fnBody, g.fnTyParams, seen) {
              return true
            }
          }
        }
      }
    }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      if monoTyParamCallReaches(kids[i], names, seen) { return true }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  false
}

// Whether the call `callIx` can hand a binding of `names` to its callee: a written type
// argument naming one, or an argument whose type is unknown or has a type variable.
function monoCallMayBind(callIx: i32, args: i32[], names: string[]): boolean {
  for ta in callTyArgsOf(callIx) {
    if monoAnnHasTyParam(tyNameOf(ta), names) { return true }
  }
  for a in args {
    const at = nodeTyIxOf(a)
    if at < 0 || tyHasTyVar(at) { return true }
  }
  false
}

// Binds each of `typarams` that `ann`, the annotation of `params[at]`, names and the argument
// left unbound: to the checker's binding at `callIx` (`{ v: 1.5 }` for `CN<T> | null`), else to
// the default (`V[] | string` called with a string, D4913). One another parameter names, or that
// reaches a spelling the default would answer, stays unbound.
function monoDefaultAnnTyParams(
  ann: string,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  body: i32,
  params: i32[],
  at: i32,
  callIx: i32,
) {
  const others: i32[] = []
  let k = 0
  while k < params.length {
    if k != at { others.push(params[k]) }
    k = k + 1
  }
  for tp in typarams {
    const one: string[] = [tp]
    const seen: i32[] = []
    if (
      monoBindOf(tvN, tvV, tp) == ""
      && monoAnnHasTyParam(ann, one)
      && !monoParamsMention(others, one)
      && !monoTyParamReachesSpelling(body, one, seen)
    ) {
      const bt = callBindTyOf(callIx, tp)
      const sp = if bt >= 0 && bt < T.tys.length && !tyHasTyVar(bt) { monoPinAnnSpelling(bt) } else { "" }
      if sp == "" {
        monoBindTyParamDefault(tp, tvN, tvV)
      } else {
        tvN.push(tp)
        tvV.push(sp)
        if !strListHas(monoExplicitBN, tp) {
          monoExplicitBN.push(tp)
          monoExplicitBT.push(bt)
        }
      }
    }
  }
  0
}

// Whether the annotation node `annIx` is typed as a union or a nullable.
function monoAnnIsUnion(annIx: i32): boolean {
  const t = nodeTyIxOf(annIx)
  if t < 0 || t >= T.tys.length { return false }
  const ty = T.tys[t]
  (ty is TyUnion && ty.uMembers.length > 1) || ty is TyNullable
}

function monoBindTyParamDefault(tp: string, tvN: string[], tvV: string[]) {
  const dt = primTyOfName(MONO_UNBOUND_TY_PARAM_DEFAULT)
  tvN.push(tp)
  tvV.push(MONO_UNBOUND_TY_PARAM_DEFAULT)
  if dt >= 0 && !strListHas(monoExplicitBN, tp) {
    monoExplicitBN.push(tp)
    monoExplicitBT.push(dt)
  }
  monoKeyExtra = monoKeyExtra + tp + "=" + MONO_UNBOUND_TY_PARAM_DEFAULT + ";"
  0
}

// Whether any parameter annotation in `params` names one of `typarams`.
function monoParamsMention(params: i32[], typarams: string[]): boolean {
  let i = 0
  while i < params.length {
    const p = P.nodes[params[i]]
    if p is Param {
      if p.parType >= 0 {
        if monoAnnHasTyParam(tyNameOf(p.parType), typarams) { return true }
      }
    }
    i = i + 1
  }
  false
}

// Give an instance its own copy of every direct call to a generic or to a hole lambda's
// binding — the `Call` node and its callee `Ident` — so the per-instance rename lands on nodes
// no sibling instance can see; one shared `Ident` let the last shape to instantiate win
// (D2854). Clone-if-changed over `monoWalk`'s walk.
function monoCloneGenericCalls(ix: i32) {
  const nx = monoCloneGenericCallsRaw(ix)
  // A rebuilt node keeps the narrowings its original's calls ended (D2390).
  if nx != ix { recordClonedCallRetire(ix, nx) }
  monoKeepTplHole(ix, nx)
  monoNoteCallTpl(ix, nx)
  if nx == ix || ix < 0 || nx < 0 { return nx }
  if P.nodes[nx] is ArrayLit && monoLitReachesPinDefaultClash(ix, nx) {
    monoClashLits.push(nx)
    return nx
  }
  // A re-made node answers the type its template did, which a later pin substitutes, unless
  // its re-make recorded its own: a list literal's rep is read off that type (D2849).
  if nodeTyIxOf(nx) < 0 {
    const t = monoCgcTplTy(ix)
    if t >= 0 { nodeTyRecord(nx, t) }
  }
  nx
}

// Template node `ix`'s recorded type, with the instance's holes read where that leaves no type
// variable, since no later pin substitutes a hole's. -1 where `ix` records none.
function monoCgcTplTy(ix: i32): i32 {
  const t = nodeTyIxOf(ix)
  if t >= 0 && tyHasTyVar(t) && monoCgcHoleN.length > 0 {
    const ht = substTyDeep(t, monoCgcHoleN, monoCgcHoleT)
    if ht >= 0 && !tyHasTyVar(ht) { return ht }
  }
  t
}

// Whether re-made list literal `nx`, whose template is `tpl` and typed `T[][]`, holds a generic
// call whose returned value is a `??` over a list with a list-literal default this instance
// builds as `T`'s pinned list: a boolean default where `T` is a number, or the reverse (D2816).
// Such a literal stays untyped, as before D2849, and the emitter refuses it.
function monoLitReachesPinDefaultClash(tpl: i32, nx: i32): boolean {
  const b = monoLitElemPin(nodeTyIxOf(tpl))
  if b == "" { return false }
  const a = P.nodes[nx]
  if !(a is ArrayLit) { return false }
  const seen: i32[] = []
  let i = 0
  while i < a.arrElems.length {
    if monoRetReachesClash(unwrapParen(a.arrElems[i]), b, seen, 0) {
      return true
    }
    i = i + 1
  }
  false
}

// The pin of `X` where `lt` is `X[][]`: `X` itself when a primitive (the instance already
// substituted it), else its binding when a type parameter of the instance being copied, or "".
function monoLitElemPin(lt: i32): string {
  if lt < 0 || lt >= T.tys.length { return "" }
  const o = T.tys[lt]
  if !(o is TyArray) || o.aElem < 0 { return "" }
  const m = T.tys[o.aElem]
  if !(m is TyArray) || m.aElem < 0 { return "" }
  // Already substituted by the instance's retype: the pin is the element itself.
  const mp = tyPrimNameOf(m.aElem)
  if mp != null { return mp }
  const v = T.tys[m.aElem]
  if !(v is TyVar) { return "" }
  let j = 0
  while j < monoCgcBN.length && j < monoCgcBT.length {
    if monoCgcBN[j] == v.tvName {
      const bp = tyPrimNameOf(monoCgcBT[j])
      if bp != null { return bp }
      return ""
    }
    j = j + 1
  }
  let i = 0
  while i < monoCgcTvN.length && i < monoCgcTvV.length {
    if monoCgcTvN[i] == v.tvName { return monoCgcTvV[i] }
    i = i + 1
  }
  ""
}

// Whether value `ix` is a `??` whose default clashes with pin `b`, or a call to a generic whose
// returned value is, through any chain of such calls.
function monoRetReachesClash(
  ix: i32,
  b: string,
  seen: i32[],
  depth: i32,
): boolean {
  if ix < 0 || ix >= P.nodes.length || depth > 16 { return false }
  const n = P.nodes[ix]
  if n is BinExpr {
    if n.binOp == "??" { return monoCoalDefaultClashesPin(n, b) }
    return false
  }
  if !(n is Call) { return false }
  const c = P.nodes[n.callFn]
  if !(c is Ident) { return false }
  if !monoCalleeIsGeneric(n.callFn) { return false }
  const fe = fnIndexOfNode(n.callFn)
  if fe < 0 || fe >= fnStmts.length || monoSeenHas(seen, fe) { return false }
  seen.push(fe)
  const f = P.nodes[fnStmts[fe]]
  if !(f is FuncDecl) { return false }
  const rets: i32[] = []
  collectValuedReturns(f.fnBody, rets)
  const body = P.nodes[f.fnBody]
  if body is Block {
    if body.blkStmts.length > 0 {
      rets.push(body.blkStmts[body.blkStmts.length - 1])
    }
  }
  let i = 0
  while i < rets.length {
    let r = rets[i]
    const rn = P.nodes[r]
    if rn is RetStmt { r = rn.retArg }
    if monoRetReachesClash(unwrapParen(r), b, seen, depth + 1) { return true }
    i = i + 1
  }
  false
}

// Whether `xs` holds `v`.
function monoSeenHas(xs: i32[], v: i32): boolean {
  let i = 0
  while i < xs.length {
    if xs[i] == v { return true }
    i = i + 1
  }
  false
}

// Whether `??` node `n`, over a list typed by a type parameter, has a list-literal default
// whose element is boolean where pin `b` is a number, or a number where `b` is boolean.
function monoCoalDefaultClashesPin(n: BinExpr, b: string): boolean {
  const lt = nodeTyIxOf(n.binLeft)
  if lt < 0 || !tyHasTyVar(lt) { return false }
  const d = P.nodes[unwrapParen(n.binRight)]
  if !(d is ArrayLit) { return false }
  if d.arrElems.length == 0 { return false }
  const et = nodeTyIxOf(d.arrElems[0])
  if et < 0 { return false }
  const dp = tyPrimNameOf(et)
  if dp == null { return false }
  const dNum = dp == "i32" || dp == "i64" || dp == "f32" || dp == "f64"
  const bNum = b == "i32" || b == "i64" || b == "f32" || b == "f64"
  (dp == "boolean" && bNum) || (dNum && b == "boolean")
}

// A fresh copy of the capture-cell read `ix` (`name[0]`), carrying its recorded types.
function monoCopyCellRead(ix: i32): i32 {
  const n = P.nodes[ix]
  if !(n is Index) { return ix }
  const a = P.nodes[n.idxArr]
  if !(a is Ident) { return ix }
  const ai = mkIdent(a.identName, a.pos)
  lfNoteMinted(ai, n.idxArr)
  identFrom(ai, n.idxArr)
  if nodeTyIxOf(n.idxArr) >= 0 { nodeTyRecord(ai, nodeTyIxOf(n.idxArr)) }
  const ri = mkIndex(ai, n.idxIndex, n.pos)
  if nodeTyIxOf(ix) >= 0 { nodeTyRecord(ri, nodeTyIxOf(ix)) }
  ri
}

// `monoCloneGenericCallsRaw`'s `Call` arm: a generic, alias, lambda or cell callee
// renamed for this instance, the arguments walked, and the type arguments substituted.
// Returns `ix` when nothing changed and the call carries no type arguments.
function monoCloneGenericCallArm(ix: i32, n: Call): i32 {
  let newCallee = n.callFn
  const callee = P.nodes[n.callFn]
  let lamCall = false
  let cellCall = false
  if callee is Ident {
    if monoCalleeIsGeneric(n.callFn) {
      newCallee = mkIdent(callee.identName, callee.pos)
      lfNoteMinted(newCallee, n.callFn)
      identFrom(newCallee, n.callFn)
    } else if monoStrListHas(monoCgcGenAliasNames, callee.identName) {
      // A call through an alias never written (`const`, or an unwritten `let`) of a generic
      // function is renamed per instance too.
      newCallee = mkIdent(callee.identName, callee.pos)
      lfNoteMinted(newCallee, n.callFn)
      identFrom(newCallee, n.callFn)
    } else if monoStrListHas(monoCgcLamNames, callee.identName) {
      newCallee = mkIdent(callee.identName, callee.pos)
      lfNoteMinted(newCallee, n.callFn)
      identFrom(newCallee, n.callFn)
      monoLamCallCallees.push(newCallee)
      lamCall = true
    }
  } else {
    newCallee = monoCloneGenericCalls(n.callFn)
    // A call through a capture cell is retyped per instance, so it takes its own nodes (D3939).
    if newCallee == n.callFn && monoCellReadName(n.callFn) != "" {
      newCallee = monoCopyCellRead(n.callFn)
      cellCall = newCallee != n.callFn
    }
  }
  let changed = newCallee != n.callFn
  const nargs: i32[] = []
  let ai = 0
  while ai < n.callArgs.length {
    const ca = monoCloneGenericCalls(n.callArgs[ai])
    nargs.push(ca)
    if ca != n.callArgs[ai] { changed = true }
    ai = ai + 1
  }
  const tas = callTyArgsOf(ix)
  if !changed && tas.length == 0 { return ix }
  const nc = monoRemintCall(ix, newCallee, nargs)
  // A call through a copied cell read keeps the call's recorded type.
  if cellCall && nodeTyIxOf(ix) >= 0 { nodeTyRecord(nc, nodeTyIxOf(ix)) }
  if lamCall {
    // A value call is typed by its own record, which the copy carries (D2854).
    const lt = monoLamCallTy(nodeTyIxOf(ix))
    if lt >= 0 { nodeTyRecord(nc, lt) }
  }
  if tas.length > 0 {
    const noEnds: i32[] = []
    setCallTyArgs(nc, monoSubstTyArgNodes(tas), noEnds)
  }
  nc
}

function monoCloneGenericCallsRaw(ix: i32) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Call { return monoCloneGenericCallArm(ix, n) }
  if n is Block {
    const ns: i32[] = []
    let bchanged = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoCloneGenericCalls(n.blkStmts[i])
      ns.push(cs)
      if cs != n.blkStmts[i] { bchanged = true }
      i = i + 1
    }
    if !bchanged { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is LetDecl {
    let ci = monoCloneGenericCalls(n.letInit)
    // The alias's read of the generic is this instance's own, renamed with its calls (D3887).
    if (
      ci == n.letInit
      && n.letInit >= 0
      && monoStrListHas(monoCgcGenAliasNames, n.letName)
    ) {
      const iv = P.nodes[n.letInit]
      if iv is Ident {
        ci = mkIdent(iv.identName, iv.pos)
        lfNoteMinted(ci, n.letInit)
        identFrom(ci, n.letInit)
      }
    }
    if ci == n.letInit { return ix }
    return monoCopyOf(ix, mkLet(n.letKw, n.letName, n.letType, ci, n.pos))
  }
  if n is RetStmt {
    const ca2 = monoCloneGenericCalls(n.retArg)
    if ca2 == n.retArg { return ix }
    return mkReturn(ca2, n.pos)
  }
  if n is IfStmt {
    // An `else if` chain is rewritten along its spine, so its depth costs no stack (D1990).
    const links = monoIfChainLinks(ix)
    const ccs: i32[] = []
    const cts: i32[] = []
    let k = 0
    while k < links.length {
      const c = P.nodes[links[k]]
      if c is IfStmt {
        ccs.push(monoCloneGenericCalls(c.ifCond))
        cts.push(monoCloneGenericCalls(c.ifThen))
      }
      k = k + 1
    }
    return monoIfChainRebuild(
      links,
      ccs,
      cts,
      monoCloneGenericCalls(monoIfChainElse(links)),
    )
  }
  if n is WhileStmt {
    const wc = monoCloneGenericCalls(n.whileCond)
    const wb = monoCloneGenericCalls(n.whileBody)
    if wc == n.whileCond && wb == n.whileBody { return ix }
    return mkWhileAs(n, wc, wb)
  }
  if n is ForRange {
    const ff = monoCloneGenericCalls(n.frFrom)
    const ft = monoCloneGenericCalls(n.frTo)
    const fs = monoCloneGenericCalls(n.frStep)
    const fb = monoCloneGenericCalls(n.frBody)
    if ff == n.frFrom && ft == n.frTo && fs == n.frStep && fb == n.frBody {
      return ix
    }
    return mkForRange(n.frVar, ff, ft, fs, n.frExcl, fb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const fi = monoCloneGenericCalls(n.fiIter)
    const fbi = monoCloneGenericCalls(n.fiBody)
    if fi == n.fiIter && fbi == n.fiBody { return ix }
    return mkForIn(n.fiVar, n.fiVar2, fi, fbi, n.fiLabel, n.pos)
  }
  if n is BinExpr { return monoCloneGenericBinArm(ix, n) }
  if n is Unary {
    // A postfix `x++`/`x--` rides a `Unary` over the assignment whose operand is the
    // mutated target — left whole for the compound form's reason. Nothing to clone in it
    // either way: the parser accepts only an identifier there, and an `Ident` holds no call.
    if n.unOp == "p+" || n.unOp == "p-" { return ix }
    const ua = monoCloneGenericCalls(n.unArg)
    if ua == n.unArg { return ix }
    return mkUnary(n.unOp, ua, n.pos)
  }
  if n is Paren {
    const pi = monoCloneGenericCalls(n.parInner)
    if pi == n.parInner { return ix }
    return mkParen(pi, n.pos)
  }
  if n is Member {
    const mo = monoCloneGenericCalls(n.memObj)
    if mo == n.memObj { return ix }
    return mkMember(mo, n.memProp, n.pos)
  }
  if n is OptMember {
    const oo = monoCloneGenericCalls(n.omObj)
    if oo == n.omObj { return ix }
    return mkOptMember(oo, n.omProp, n.omDot, n.pos)
  }
  if n is Index {
    const xa = monoCloneGenericCalls(n.idxArr)
    const xi = monoCloneGenericCalls(n.idxIndex)
    if xa == n.idxArr && xi == n.idxIndex { return ix }
    return mkIndex(xa, xi, n.pos)
  }
  if n is IsExpr {
    const io = monoCloneGenericCalls(n.isObj)
    if io == n.isObj { return ix }
    return monoReIsExpr(ix, io)
  }
  if n is AsExpr {
    const ao = monoCloneGenericCalls(n.asObj)
    if ao == n.asObj { return ix }
    return mkAsExpr(ao, n.asTy, n.asMode, n.pos)
  }
  // A spread's source is an operand like any other (D2334).
  if n is Spread {
    const sa = monoCloneGenericCalls(n.spdArg)
    if sa == n.spdArg { return ix }
    return mkSpread(sa, n.pos)
  }
  if n is ArrayLit {
    const es: i32[] = []
    let echanged = false
    let ei = 0
    while ei < n.arrElems.length {
      const ce = monoCloneGenericCalls(n.arrElems[ei])
      es.push(ce)
      if ce != n.arrElems[ei] { echanged = true }
      ei = ei + 1
    }
    if !echanged { return ix }
    return monoCopyOf(ix, mkArrayLit(es, n.pos))
  }
  if n is ObjLit { return monoCloneGenericObjArm(ix, n) }
  // A generic function read as a value (a list element, a field, a binding) is renamed to
  // its instance per enclosing instance, so it gets its own node, typed at this instance (D3909).
  if n is Ident {
    if (
      monoCalleeIsGeneric(ix)
      || monoStrListHas(monoCgcGenAliasNames, n.identName)
      || monoStrListHas(monoCgcLamNames, n.identName)
    ) {
      const vi = mkIdent(n.identName, n.pos)
      lfNoteMinted(vi, ix)
      identFrom(vi, ix)
      const vt = monoLamCallTy(nodeTyIxOf(ix))
      if vt >= 0 { nodeTyRecord(vi, vt) }
      return vi
    }
  }
  ix
}

// `monoCloneGenericCallsRaw`'s arm for the binary or assignment `n` at `ix`.
function monoCloneGenericBinArm(ix: i32, n: BinExpr): i32 {
  // A compound assignment desugars to `target = (target op value)` with the target node
  // shared between the read and the write, so its limbs cannot be rebuilt independently:
  // re-synthesize the whole form through the maker that re-establishes that sharing. The
  // prefix `++`/`--` form has no value limb but does have a target, so it is rebuilt too.
  if n.binCompound != "" {
    const ct = monoCloneGenericCalls(n.binLeft)
    if n.binCompound == "++" || n.binCompound == "--" {
      if ct == n.binLeft { return ix }
      return mkPreIncr(n.binCompound, ct, n.pos)
    }
    const inner = P.nodes[n.binRight]
    if inner is BinExpr {
      const iv = monoCloneGenericCalls(inner.binRight)
      if iv == inner.binRight && ct == n.binLeft { return ix }
      return mkCompoundAssign(n.binCompound, ct, iv, n.pos)
    }
    return ix
  }
  const bl = monoCloneGenericCalls(n.binLeft)
  const br = monoCloneGenericCalls(n.binRight)
  if bl == n.binLeft && br == n.binRight { return ix }
  mkBinary(n.binOp, bl, br, n.pos)
}

// `monoCloneGenericCallsRaw`'s arm for the object literal `n` at `ix`.
function monoCloneGenericObjArm(ix: i32, n: ObjLit): i32 {
  const fl: i32[] = []
  let ochanged = false
  let oi = 0
  while oi < n.objFields.length {
    let nf = n.objFields[oi]
    const f = P.nodes[nf]
    if f is FieldInit {
      const cv = monoCloneGenericCalls(f.fiValue)
      if cv != f.fiValue {
        nf = mkFieldInit(f.fiName, cv, f.pos)
        ochanged = true
      }
    }
    fl.push(nf)
    oi = oi + 1
  }
  if !ochanged { return ix }
  monoCopyOf(ix, mkObjLit(fl, n.pos))
}

// ── the per-instance layout fold: `T.size` / `T.<field>` ─────────────────────

// A generic body may read the layout of one of its type parameters — the stride a row
// accessor multiplies by, and the field offsets it adds. The checker types those members
// `i32` and leaves the `Member` node standing, because the constant does not exist until a
// binding does, and the binding is this pass's. Clone-if-changed, like every rung here.

// ── the two questions `dispatchRewrite` asks of a hole, re-asked at the pin ──

// `dispatchRewrite` runs before monomorphization, so inside a generic body its `BinExpr`
// arm asks both questions of an operand whose type is still a type parameter, and both
// degrade to no on a hole. One rung, and it must live here: the pinned type exists nowhere
// else. The two arms below are separately load-bearing — do not collapse them.

// The pinned type row of a body expression that reads a monomorphized parameter, or -1.
// Two gates: the name must match a parameter of the instance, and the checker's recorded
// type at that node must still carry a type variable. A local that shadows the parameter
// is typed concretely, so it fails the second gate and the pin is not applied to it.
function monoPinnedOperandTy(ix: i32, pNames: string[], pTys: i32[]) {
  if ix < 0 { return -1 }
  const e = P.nodes[ix]
  if e is Ident {
    if !tyHasTyVar(nodeTyIxOf(ix)) { return -1 }
    let i = 0
    while i < pNames.length {
      if pNames[i] == e.identName {
        if i < pTys.length { return pTys[i] }
        return -1
      }
      i = i + 1
    }
  }
  -1
}

// `pNames`/`pTys` without `name` into `outN`/`outT`: a binding of that name shadows the parameter.
function monoPinDrop(
  name: string,
  pNames: string[],
  pTys: i32[],
  outN: string[],
  outT: i32[],
) {
  let i = 0
  while i < pNames.length {
    if pNames[i] != name {
      outN.push(pNames[i])
      if i < pTys.length { outT.push(pTys[i]) } else { outT.push(-1) }
    }
    i = i + 1
  }
  0
}

// `v == null` / `v != null` (either side) over a pinned parameter whose pin proves non-null, as
// the boolean literal it always yields; -1 for any other compare.
function monoDeadNullTest(n: BinExpr, pNames: string[], pTys: i32[]): i32 {
  const l = unwrapParen(n.binLeft)
  const r = unwrapParen(n.binRight)
  if l < 0 || r < 0 { return -1 }
  let opIx = -1
  if P.nodes[r] is NullLit && !(P.nodes[l] is NullLit) { opIx = l }
  if P.nodes[l] is NullLit && !(P.nodes[r] is NullLit) { opIx = r }
  if opIx < 0 { return -1 }
  const pt = monoPinnedOperandTy(opIx, pNames, pTys)
  if pt < 0 { return -1 }
  if !tyProvesNonNull(pt) { return -1 }
  if n.binOp == "!=" { return mkBool(1, n.pos) }
  mkBool(0, n.pos)
}

// The template `FuncDecl` of the instance `monoPinBinOps` rewrites, whose scope gives a minted
// `self`-function call its defaults (-1 outside), and the instance's argument types beside the
// pinned ones (-1 where unknown).
let monoPinCtx = -1
let monoPinArgTys: i32[] = []

// `monoPinBinOps`'s `BinExpr` arm: the operator rewrites themselves, over operands already
// walked. Returns `ix` when nothing changed, else the rewritten node.
function monoPinBin(ix: i32, n: BinExpr, pNames: string[], pTys: i32[]): i32 {
  // A compound assignment shares its target node between the read and the write, so its
  // limbs cannot be rebuilt independently — left whole, exactly as
  // `monoFoldTyParamLayout` leaves it.
  if n.binCompound != "" { return ix }
  const bl = monoPinBinOps(n.binLeft, pNames, pTys)
  const br = monoPinBinOps(n.binRight, pNames, pTys)
  const plt = monoPinnedOperandTy(n.binLeft, pNames, pTys)
  if plt >= 0 {
    // D512: the pin provably admits no null, so `??` is the identity on its left
    // operand. `tyExcludesNull` is the same predicate `nodeTyExcludesNull` asks of a
    // node, shared so the two homes cannot disagree.
    if n.binOp == "??" {
      if tyExcludesNull(plt) { return bl }
    }
  }
  // D2802: the direct twin's dead null test. A pinned parameter read has no effect, so a
  // pin that admits no null answers `== null` false and `!= null` true.
  if n.binOp == "==" || n.binOp == "!=" {
    const dnt = monoDeadNullTest(n, pNames, pTys)
    if dnt >= 0 { return dnt }
  }
  if plt >= 0 {
    // D511: an object pin with a free `self`-function named for the operator. The name is
    // receiver-keyed (`+@Vec3`), so a generic body's `a + b` at a concrete object pin
    // resolves from the pinned left type to that type's own operator (B14 generalized).
    if drwDispatchOp(n.binOp) {
      const pot = T.tys[plt]
      if pot is TyObj {
        const opFn = opSelfFnNameForRecv(n.binOp, plt)
        if opFn != "" {
          const oargs: i32[] = []
          oargs.push(bl)
          oargs.push(br)
          const opCallee = mkIdent(opFn, -1)
          identFromDecl(opCallee, monoFnDeclNamed(opFn))
          return mkCall(opCallee, oargs, -1)
        }
      }
    }
  }
  if bl == n.binLeft && br == n.binRight { return ix }
  return mkBinary(n.binOp, bl, br, n.pos)
}

// `monoPinBinOps`'s `Block` arm: each statement walked under the pins still in scope.
// Returns `ix` when no statement changed.
function monoPinBlock(ix: i32, n: Block, pNames: string[], pTys: i32[]): i32 {
  const ns: i32[] = []
  let bchanged = false
  // A local that shadows a parameter ends the parameter's pin for the rest of the block.
  let bNames = pNames
  let bTys = pTys
  let i = 0
  while i < n.blkStmts.length {
    const cs = monoPinBinOps(n.blkStmts[i], bNames, bTys)
    ns.push(cs)
    if cs != n.blkStmts[i] { bchanged = true }
    const sd = P.nodes[n.blkStmts[i]]
    if sd is LetDecl {
      const dN: string[] = []
      const dT: i32[] = []
      monoPinDrop(sd.letName, bNames, bTys, dN, dT)
      bNames = dN
      bTys = dT
    }
    i = i + 1
  }
  if !bchanged { return ix }
  mkBlock(ns, n.pos)
}

// `drwWalk`'s member-call arm for a receiver typed by a type parameter, which it
// leaves to each instance: built-in, then field, then the `self`-function, asked of the
// argument's own type (`memberRungOnTy`, D2517) — a `Set`'s pin name spells its map rep.
// An unpinned deferred call takes the function. Returns -1 when no rung rewrites the call.
function monoPinMemberCall(
  ix: i32,
  n: Call,
  pcallee: Member,
  nargs: i32[],
  pNames: string[],
  pTys: i32[],
): i32 {
  const precvTy = monoPinnedOperandTy(pcallee.memObj, pNames, pTys)
  let precvArgTy = precvTy
  if monoPinArgTys.length == pTys.length {
    const pat = monoPinnedOperandTy(pcallee.memObj, pNames, monoPinArgTys)
    if pat >= 0 && !tyHasTyVar(pat) { precvArgTy = pat }
  }
  let prung = MC_RUNG_BUILTIN
  if precvArgTy >= 0 { prung = memberRungOnTy(precvArgTy, pcallee.memProp) }
  else if drwMemberDeferred(ix) { prung = 0 }
  // A map's `get` is the read `m[k]`, as `drwWalk` spells it on a concrete map (D1522),
  // over a receiver node that carries the pinned map type the read lowers by.
  if prung == MC_RUNG_BUILTIN && precvTy >= 0 && pcallee.memProp == "get" {
    const pro = P.nodes[pcallee.memObj]
    if nargs.length == 1 && tyIsMap(precvTy) && pro is Ident {
      const prIx = mkIdent(pro.identName, pro.pos)
      identFrom(prIx, pcallee.memObj)
      nodeTyRecord(prIx, precvTy)
      const pmg = mkIndex(prIx, nargs[0], n.pos)
      nodeTyCarry(pmg, ix)
      return pmg
    }
  }
  if prung == 0 {
    // The site's own alias, not the plain property: the module merge mangles a free
    // `self`-function and leaves the call's property plain, and `ix` is the node the
    // merge walk banked its answer on.
    let puName = ufcsAliasAtSite(ix, pcallee.memProp)
    // An overloaded name picks its candidate by this instance's receiver (`ovPinCheck`).
    const puRow = ovSiteSetOf(ix)
    if puRow >= 0 && precvArgTy >= 0 {
      const puPick = ovPickFor(puRow, precvArgTy)
      if puPick != "" && puPick != "*" { puName = puPick }
    }
    if drwSelfFnOf(puName, nargs.length + 1) >= 0 {
      const puArgs: i32[] = []
      puArgs.push(pcallee.memObj)
      let pu = 0
      while pu < nargs.length {
        puArgs.push(nargs[pu])
        pu = pu + 1
      }
      // The injected receiver is an unnamed slot-0 positional; an all-positional call
      // keeps its empty name list so `hasNamedArgs` stays false downstream.
      const puNames: string[] = []
      if hasNamedArgs(n.callArgNames) {
        puNames.push("")
        let pn = 0
        while pn < n.callArgNames.length {
          puNames.push(n.callArgNames[pn])
          pn = pn + 1
        }
      }
      const puFn = mkIdent(puName, -1)
      identFromDecl(puFn, monoFnDeclNamed(puName))
      noteCallOrigin(puFn, ix)
      const puCall = mkCallN(puFn, puArgs, puNames, n.pos)
      drwFillDefaults(puCall, monoPinCtx)
      nodeTyCarry(puCall, ix)
      return puCall
    }
  }
  -1
}

// `monoPinBinOps`'s `Call` arm: the callee and arguments walked, then the member-call
// rungs. Returns `ix` when nothing changed.
function monoPinCall(ix: i32, n: Call, pNames: string[], pTys: i32[]): i32 {
  const cf = monoPinBinOps(n.callFn, pNames, pTys)
  let changed = cf != n.callFn
  const nargs: i32[] = []
  let ai = 0
  while ai < n.callArgs.length {
    const ca2 = monoPinBinOps(n.callArgs[ai], pNames, pTys)
    nargs.push(ca2)
    if ca2 != n.callArgs[ai] { changed = true }
    ai = ai + 1
  }
  const pcallee = P.nodes[n.callFn]
  if pcallee is Member {
    const mc = monoPinMemberCall(ix, n, pcallee, nargs, pNames, pTys)
    if mc >= 0 { return mc }
  }
  if !changed { return ix }
  monoRemintCallTpl(ix, cf, nargs)
}

// `drwWalk`'s `BinExpr` arm, re-run over one instance body with the pin in hand. The two
// rewrites are the same two `drwWalk` makes, so a pinned cell reaches exactly the lowering
// its direct twin reaches. The field-closure dispatch route is deliberately not here: it
// needs the emitter's struct table row, which cannot be asked for from a type.
function monoPinBinOps(ix: i32, pNames: string[], pTys: i32[]) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is BinExpr { return monoPinBin(ix, n, pNames, pTys) }
  if n is Block { return monoPinBlock(ix, n, pNames, pTys) }
  if n is LetDecl {
    const ci = monoPinBinOps(n.letInit, pNames, pTys)
    if ci == n.letInit { return ix }
    return monoCopyOf(ix, mkLet(n.letKw, n.letName, n.letType, ci, n.pos))
  }
  if n is RetStmt {
    const ca = monoPinBinOps(n.retArg, pNames, pTys)
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  if n is IfStmt {
    // An `else if` chain is rewritten along its spine, so its depth costs no stack (D1990).
    const links = monoIfChainLinks(ix)
    const ccs: i32[] = []
    const cts: i32[] = []
    let k = 0
    while k < links.length {
      const c = P.nodes[links[k]]
      if c is IfStmt {
        ccs.push(monoPinBinOps(c.ifCond, pNames, pTys))
        cts.push(monoPinBinOps(c.ifThen, pNames, pTys))
      }
      k = k + 1
    }
    return monoIfChainRebuild(
      links,
      ccs,
      cts,
      monoPinBinOps(monoIfChainElse(links), pNames, pTys),
    )
  }
  if n is WhileStmt {
    const wc = monoPinBinOps(n.whileCond, pNames, pTys)
    const wb = monoPinBinOps(n.whileBody, pNames, pTys)
    if wc == n.whileCond && wb == n.whileBody { return ix }
    return mkWhileAs(n, wc, wb)
  }
  if n is ForRange {
    const ff = monoPinBinOps(n.frFrom, pNames, pTys)
    const ft = monoPinBinOps(n.frTo, pNames, pTys)
    const fs = monoPinBinOps(n.frStep, pNames, pTys)
    const frN: string[] = []
    const frT: i32[] = []
    monoPinDrop(n.frVar, pNames, pTys, frN, frT)
    const fb = monoPinBinOps(n.frBody, frN, frT)
    if ff == n.frFrom && ft == n.frTo && fs == n.frStep && fb == n.frBody {
      return ix
    }
    return mkForRange(n.frVar, ff, ft, fs, n.frExcl, fb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const fi = monoPinBinOps(n.fiIter, pNames, pTys)
    const fiN: string[] = []
    const fiT: i32[] = []
    monoPinDrop(n.fiVar, pNames, pTys, fiN, fiT)
    const fi2N: string[] = []
    const fi2T: i32[] = []
    monoPinDrop(n.fiVar2, fiN, fiT, fi2N, fi2T)
    const fbi = monoPinBinOps(n.fiBody, fi2N, fi2T)
    if fi == n.fiIter && fbi == n.fiBody { return ix }
    return mkForIn(n.fiVar, n.fiVar2, fi, fbi, n.fiLabel, n.pos)
  }
  if n is Call { return monoPinCall(ix, n, pNames, pTys) }
  if n is Unary {
    // A postfix `x++`/`x--` rides a `Unary` over the assignment whose operand is the
    // mutated target — left whole for the compound form's reason.
    if n.unOp == "p+" || n.unOp == "p-" { return ix }
    const ua = monoPinBinOps(n.unArg, pNames, pTys)
    if ua == n.unArg { return ix }
    return mkUnary(n.unOp, ua, n.pos)
  }
  if n is Paren {
    const pi = monoPinBinOps(n.parInner, pNames, pTys)
    if pi == n.parInner { return ix }
    return mkParen(pi, n.pos)
  }
  if n is Member {
    const mo = monoPinBinOps(n.memObj, pNames, pTys)
    if mo == n.memObj { return ix }
    return mkMember(mo, n.memProp, n.pos)
  }
  if n is OptMember {
    const oo = monoPinBinOps(n.omObj, pNames, pTys)
    if oo == n.omObj { return ix }
    return mkOptMember(oo, n.omProp, n.omDot, n.pos)
  }
  if n is Index {
    const ia = monoPinBinOps(n.idxArr, pNames, pTys)
    const ii = monoPinBinOps(n.idxIndex, pNames, pTys)
    if ia == n.idxArr && ii == n.idxIndex { return ix }
    return mkIndex(ia, ii, n.pos)
  }
  if n is IsExpr {
    const io = monoPinBinOps(n.isObj, pNames, pTys)
    if io == n.isObj { return ix }
    return monoReIsExpr(ix, io)
  }
  if n is AsExpr {
    const ao = monoPinBinOps(n.asObj, pNames, pTys)
    if ao == n.asObj { return ix }
    return mkAsExpr(ao, n.asTy, n.asMode, n.pos)
  }
  // A spread's source is an operand like any other (D2334).
  if n is Spread {
    const sa = monoPinBinOps(n.spdArg, pNames, pTys)
    if sa == n.spdArg { return ix }
    return mkSpread(sa, n.pos)
  }
  if n is ArrayLit {
    const es: i32[] = []
    let echanged = false
    let ei = 0
    while ei < n.arrElems.length {
      const ce = monoPinBinOps(n.arrElems[ei], pNames, pTys)
      es.push(ce)
      if ce != n.arrElems[ei] { echanged = true }
      ei = ei + 1
    }
    if !echanged { return ix }
    return monoRemakeListLitTpl(ix, es, n.pos)
  }
  if n is ObjLit {
    const fl: i32[] = []
    let ochanged = false
    let oi = 0
    while oi < n.objFields.length {
      let nf = n.objFields[oi]
      const f = P.nodes[nf]
      if f is FieldInit {
        const cv = monoPinBinOps(f.fiValue, pNames, pTys)
        if cv != f.fiValue {
          nf = mkFieldInit(f.fiName, cv, f.pos)
          ochanged = true
        }
      }
      fl.push(nf)
      oi = oi + 1
    }
    if !ochanged { return ix }
    return monoCopyOf(ix, mkObjLit(fl, n.pos))
  }
  ix
}

// The layout constant `T.size` / `T.<field>` at `ix`, for a type parameter `mo` read through
// member `n`: the byte layout of the `flat` type a parameter binds it to, in `tvN`/`tvV`, as a
// number literal. An unbound, non-`flat` or field-less read fails loudly and answers `ix`.
function monoLayoutConstOf(
  ix: i32,
  n: Member,
  mo: Ident,
  tvN: string[],
  tvV: string[],
): i32 {
  const bind = monoBindOf(tvN, tvV, mo.identName)
  if bind == "" {
    emitFail(
      "emitProgram: monomorphize: `"
        + mo.identName
        + "."
        + n.memProp
        + "` needs `"
        + mo.identName
        + "` bound by a parameter — a layout constant is per-instance",
    )
    return ix
  }
  const v = flatConstOfNameProp(bind, n.memProp)
  if v == -1 {
    emitFail(
      "emitProgram: monomorphize: `"
        + mo.identName
        + "` is bound to `"
        + bind
        + "`, which is not a `flat` type, so it has no byte layout",
    )
    return ix
  }
  if v == -2 {
    emitFail(
      "emitProgram: monomorphize: `flat type "
        + bind
        + "` (bound to `"
        + mo.identName
        + "`) has no field '"
        + n.memProp
        + "' — its layout members are `.size` and one offset per declared field",
    )
    return ix
  }
  return mkNum(i32ToStr(v), n.pos)
}

// `monoFoldTyParamLayout`'s arm for the binary `n` at `ix`. A compound assignment shares its
// target node between the read and the write, so its limbs cannot be rebuilt independently:
// the whole form is re-synthesized through the maker that re-establishes that sharing.
function monoFoldLayoutBin(
  ix: i32,
  n: BinExpr,
  typarams: string[],
  tvN: string[],
  tvV: string[],
): i32 {
  if n.binCompound != "" {
    const ct2 = monoFoldTyParamLayout(n.binLeft, typarams, tvN, tvV)
    if n.binCompound == "++" || n.binCompound == "--" {
      if ct2 == n.binLeft { return ix }
      return mkPreIncr(n.binCompound, ct2, n.pos)
    }
    const inner = P.nodes[n.binRight]
    if inner is BinExpr {
      const iv = monoFoldTyParamLayout(inner.binRight, typarams, tvN, tvV)
      if iv == inner.binRight && ct2 == n.binLeft { return ix }
      return mkCompoundAssign(n.binCompound, ct2, iv, n.pos)
    }
    return ix
  }
  const bl = monoFoldTyParamLayout(n.binLeft, typarams, tvN, tvV)
  const br = monoFoldTyParamLayout(n.binRight, typarams, tvN, tvV)
  if bl == n.binLeft && br == n.binRight { return ix }
  return mkBinary(n.binOp, bl, br, n.pos)
}

function monoFoldTyParamLayout(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
) {
  if ix < 0 { return ix }
  const n = P.nodes[ix]
  if n is Member {
    const mo = P.nodes[n.memObj]
    if mo is Ident {
      if monoTyParamOf(mo.identName, typarams) != "" {
        return monoLayoutConstOf(ix, n, mo, tvN, tvV)
      }
    }
    const mc = monoFoldTyParamLayout(n.memObj, typarams, tvN, tvV)
    if mc == n.memObj { return ix }
    return mkMember(mc, n.memProp, n.pos)
  }
  if n is Block {
    const ns: i32[] = []
    let bchanged = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoFoldTyParamLayout(n.blkStmts[i], typarams, tvN, tvV)
      ns.push(cs)
      if cs != n.blkStmts[i] { bchanged = true }
      i = i + 1
    }
    if !bchanged { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is LetDecl {
    const ci = monoFoldTyParamLayout(n.letInit, typarams, tvN, tvV)
    if ci == n.letInit { return ix }
    return monoCopyOf(ix, mkLet(n.letKw, n.letName, n.letType, ci, n.pos))
  }
  if n is RetStmt {
    const ca = monoFoldTyParamLayout(n.retArg, typarams, tvN, tvV)
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  if n is IfStmt {
    // An `else if` chain is rewritten along its spine, so its depth costs no stack (D1990).
    const links = monoIfChainLinks(ix)
    const ccs: i32[] = []
    const cts: i32[] = []
    let k = 0
    while k < links.length {
      const c = P.nodes[links[k]]
      if c is IfStmt {
        ccs.push(monoFoldTyParamLayout(c.ifCond, typarams, tvN, tvV))
        cts.push(monoFoldTyParamLayout(c.ifThen, typarams, tvN, tvV))
      }
      k = k + 1
    }
    return monoIfChainRebuild(
      links,
      ccs,
      cts,
      monoFoldTyParamLayout(monoIfChainElse(links), typarams, tvN, tvV),
    )
  }
  if n is WhileStmt {
    const wc = monoFoldTyParamLayout(n.whileCond, typarams, tvN, tvV)
    const wb = monoFoldTyParamLayout(n.whileBody, typarams, tvN, tvV)
    if wc == n.whileCond && wb == n.whileBody { return ix }
    return mkWhileAs(n, wc, wb)
  }
  if n is ForRange {
    const ff = monoFoldTyParamLayout(n.frFrom, typarams, tvN, tvV)
    const ft = monoFoldTyParamLayout(n.frTo, typarams, tvN, tvV)
    const fs = monoFoldTyParamLayout(n.frStep, typarams, tvN, tvV)
    const fb = monoFoldTyParamLayout(n.frBody, typarams, tvN, tvV)
    if ff == n.frFrom && ft == n.frTo && fs == n.frStep && fb == n.frBody {
      return ix
    }
    return mkForRange(n.frVar, ff, ft, fs, n.frExcl, fb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const fi = monoFoldTyParamLayout(n.fiIter, typarams, tvN, tvV)
    const fbi = monoFoldTyParamLayout(n.fiBody, typarams, tvN, tvV)
    if fi == n.fiIter && fbi == n.fiBody { return ix }
    return mkForIn(n.fiVar, n.fiVar2, fi, fbi, n.fiLabel, n.pos)
  }
  if n is Call { return monoFoldLayoutCall(ix, n, typarams, tvN, tvV) }
  if n is BinExpr { return monoFoldLayoutBin(ix, n, typarams, tvN, tvV) }
  if n is Unary {
    // A postfix `x++`/`x--` rides a `Unary` over the assignment whose operand is
    // the mutated target — left whole for the compound form's reason.
    if n.unOp == "p+" || n.unOp == "p-" { return ix }
    const ua = monoFoldTyParamLayout(n.unArg, typarams, tvN, tvV)
    if ua == n.unArg { return ix }
    return mkUnary(n.unOp, ua, n.pos)
  }
  if n is Paren {
    const pi = monoFoldTyParamLayout(n.parInner, typarams, tvN, tvV)
    if pi == n.parInner { return ix }
    return mkParen(pi, n.pos)
  }
  if n is OptMember {
    const oo = monoFoldTyParamLayout(n.omObj, typarams, tvN, tvV)
    if oo == n.omObj { return ix }
    return mkOptMember(oo, n.omProp, n.omDot, n.pos)
  }
  if n is Index {
    const xa = monoFoldTyParamLayout(n.idxArr, typarams, tvN, tvV)
    const xi = monoFoldTyParamLayout(n.idxIndex, typarams, tvN, tvV)
    if xa == n.idxArr && xi == n.idxIndex { return ix }
    return mkIndex(xa, xi, n.pos)
  }
  if n is IsExpr {
    const io = monoFoldTyParamLayout(n.isObj, typarams, tvN, tvV)
    // D951 — the check spelling is substituted only when it mentions a type parameter, the
    // `monoAnnHasTyParam`-then-`monoSubstAnn` contract every other substitution site keeps.
    // A concrete `is {v: i32}` must return verbatim: `monoSubstAnn`'s object arm rebuilds a
    // shape spelling from its parts, and a rebuilt spelling is a second intern key.
    if monoAnnHasTyParam(n.isVariant, typarams) {
      const sub = monoSubstAnn(n.isVariant, typarams, tvN, tvV)
      if sub != "" && sub != n.isVariant { return monoSubstIsExpr(ix, io, sub) }
    }
    if io == n.isObj { return ix }
    return monoReIsExpr(ix, io)
  }
  if n is AsExpr {
    const ao = monoFoldTyParamLayout(n.asObj, typarams, tvN, tvV)
    if ao == n.asObj { return ix }
    return mkAsExpr(ao, n.asTy, n.asMode, n.pos)
  }
  // A spread's source is an operand like any other (D2334).
  if n is Spread {
    const sa = monoFoldTyParamLayout(n.spdArg, typarams, tvN, tvV)
    if sa == n.spdArg { return ix }
    return mkSpread(sa, n.pos)
  }
  if n is ArrayLit {
    const es: i32[] = []
    let echanged = false
    let ei = 0
    while ei < n.arrElems.length {
      const ce = monoFoldTyParamLayout(n.arrElems[ei], typarams, tvN, tvV)
      es.push(ce)
      if ce != n.arrElems[ei] { echanged = true }
      ei = ei + 1
    }
    if !echanged { return ix }
    const nl = mkArrayLit(es, n.pos)
    nodeTyCarry(nl, ix)
    return nl
  }
  if n is ObjLit { return monoFoldLayoutObj(ix, n, typarams, tvN, tvV) }
  ix
}

// `monoFoldTyParamLayout`'s arm for the call `n` at `ix`.
function monoFoldLayoutCall(
  ix: i32,
  n: Call,
  typarams: string[],
  tvN: string[],
  tvV: string[],
): i32 {
  const cf = monoFoldTyParamLayout(n.callFn, typarams, tvN, tvV)
  let changed = cf != n.callFn
  const nargs: i32[] = []
  let ai = 0
  while ai < n.callArgs.length {
    const ca2 = monoFoldTyParamLayout(n.callArgs[ai], typarams, tvN, tvV)
    nargs.push(ca2)
    if ca2 != n.callArgs[ai] { changed = true }
    ai = ai + 1
  }
  if !changed { return ix }
  monoRemintCallTpl(ix, cf, nargs)
}

// `monoFoldTyParamLayout`'s arm for the object literal `n` at `ix`.
function monoFoldLayoutObj(
  ix: i32,
  n: ObjLit,
  typarams: string[],
  tvN: string[],
  tvV: string[],
): i32 {
  const fl: i32[] = []
  let ochanged = false
  let oi = 0
  while oi < n.objFields.length {
    let nf = n.objFields[oi]
    const f = P.nodes[nf]
    if f is FieldInit {
      const cv = monoFoldTyParamLayout(f.fiValue, typarams, tvN, tvV)
      if cv != f.fiValue {
        nf = mkFieldInit(f.fiName, cv, f.pos)
        ochanged = true
      }
    }
    fl.push(nf)
    oi = oi + 1
  }
  if !ochanged { return ix }
  mkObjLit(fl, n.pos)
}

// Whether a specialization callback is baked for any param — gates the body rewrite and
// the key extension below.
function monoAnyBakedCallback(cbFnNames: string[]) {
  let i = 0
  while i < cbFnNames.length {
    if cbFnNames[i] != "" { return true }
    i = i + 1
  }
  false
}

// The pin column for one instance's parameter list, built in a single parallel pass keyed
// by param index — a per-parameter fact belongs beside the parameters, not coded into one
// of their strings. The bridge from the marker is `pinKindOfName` + `sigKeyPinPayload`.
function monoBuildPinCol(pinned: string[], kinds: i32[], pays: string[]) {
  let i = 0
  while i < pinned.length {
    kinds.push(pinKindOfName(pinned[i]))
    pays.push(sigKeyPinPayload(pinned[i]))
    i = i + 1
  }
  0
}

// Whether the subtree at `ix` mentions the identifier `name` anywhere: a read, an alias, a copy
// or a capture of it. Deeper than `depth` 400 answers true, so a miss is never guessed.
function monoSubtreeNamesIdent(ix: i32, name: string, depth: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  if depth > 400 { return true }
  const n = P.nodes[ix]
  if n is Ident { return n.identName == name }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if monoSubtreeNamesIdent(kids[i], name, depth + 1) { return true }
    i = i + 1
  }
  false
}

// The `Ident` named `name` at source position `pos` in the subtree of `ix`, or -1.
function monoIdentAtPosIn(ix: i32, name: string, pos: i32, depth: i32): i32 {
  if ix < 0 || ix >= P.nodes.length || depth > 400 { return -1 }
  const n = P.nodes[ix]
  if n is Ident {
    if n.identName == name && n.pos == pos { return ix }
    return -1
  }
  for k in nodeChildren(ix) {
    const r = monoIdentAtPosIn(k, name, pos, depth + 1)
    if r >= 0 { return r }
  }
  -1
}

// Whether `ty` is a record type with no type variable left in it.
function monoConcreteObjTy(ty: i32): boolean {
  if ty < 0 { return false }
  T.tys[ty] is TyObj && !tyHasTyVar(ty)
}

// A record type an instance binds in place of its anonymous row's own (see
// `monoObjDiffersInFnFieldsOnly`), to the row's handle, so a pin spelled from it names that row.
let monoFnFieldTwinRow: {[i32]: string} = Map()

// Whether concrete record `a` and record `b` name the same fields, in any order, and every field
// on which their types differ is a function type in `a` against a function type or a hole in
// `b`, a record differing so in turn, or anything against a bare hole in `b`, with at least one
// such field reaching a function. A hole parameter's row holds `_` at each field read (D3175).
function monoObjDiffersInFnFieldsOnly(a: i32, b: i32): boolean {
  monoObjDiffersInFnFieldsAt(a, b, 4)
}

function monoObjDiffersInFnFieldsAt(a: i32, b: i32, depth: i32): boolean {
  if depth <= 0 || !monoConcreteObjTy(a) || b < 0 || a == b { return false }
  const ta = T.tys[a]
  const tb = T.tys[b]
  if !(ta is TyObj) || !(tb is TyObj) { return false }
  const n = ta.objFieldNames.length
  if tb.objFieldNames.length != n || ta.objFieldTypes.length != n {
    return false
  }
  if tb.objFieldTypes.length != n { return false }
  let differs = false
  let i = 0
  while i < n {
    const fa = ta.objFieldTypes[i]
    const fb = tyFieldTyOf(b, ta.objFieldNames[i])
    if fa < 0 || fb < 0 { return false }
    if !tyEq(fa, fb) {
      if T.tys[fb] is TyVar {
        if tyReachesFuncD(fa, 12) { differs = true }
      } else if T.tys[fa] is TyFunc && T.tys[fb] is TyFunc {
        differs = true
      } else if monoObjDiffersInFnFieldsAt(fa, fb, depth - 1) {
        differs = true
      } else {
        return false
      }
    } else if tyHasTyVar(fb) {
      return false
    }
    i = i + 1
  }
  differs
}

// The declared record type pin `pin` names where record `ty` differs from it only in function
// fields, or -1. A literal claims a declared record by its field names, so an instance keyed and
// bound by that name alone would call the declared record's closures at their types (D3177).
function monoDeclFnFieldTwin(pin: string, ty: i32): i32 {
  const dt = cUserTypes[pin] ?? -1
  if dt < 0 || !monoObjDiffersInFnFieldsOnly(ty, dt) { return -1 }
  dt
}

// D988 — the key suffix an anonymous-shape pin, or a declared-record twin, needs; "" for every
// other pin. A hole parameter pins the argument's type name, and two object literals with the
// same field names share one synthetic row whatever their field types are, so both key the same
// instance. The rendering is the right grain — keying on the type index mints per site.
function monoAnonPinDiscrim(pin: string, tyIx: i32): string {
  if tyIx < 0 { return "" }
  if monoDeclFnFieldTwin(pin, tyIx) >= 0 {
    return "=" + tyCanonKey(tyIx, TY_WALK_DEPTH)
  }
  if pin.length < 5 { return "" }
  if pin[0] != "#"[0] { return "" }
  const rendered = tyToEmitName(tyIx)
  if rendered == "" { return "" }
  "=" + rendered
}

// The key suffix a function-value pin needs, or "". The pin is the value's `$fnsig` key, which
// `i32`, `boolean` and a literal union share, so an instance typed at one would serve the others
// and read their results at its own type (D3167). Keyed by the value's checked type instead.
function monoSigPinDiscrim(pin: string, tyIx: i32): string {
  if tyIx < 0 || tyIx >= T.tys.length { return "" }
  if sigKeyPinPayload(pin) == "" { return "" }
  if !(T.tys[tyIx] is TyFunc) || tyHasTyVar(tyIx) { return "" }
  "=" + tyCanonKey(tyIx, TY_WALK_DEPTH)
}

// D1042 — the emitter-vocabulary spelling of a name `monoSubstAnn` produced, for the shapes
// where the two can disagree: a union, and a list of a grouped element (`(T | string)[]`).
// `monoSubstAnn` substitutes into the declared annotation text, so a literal member stays
// literal and a collapsed group keeps its parens, while a direct annotation is canon'd.
function monoPinUnionName(rs: string): string {
  const atoms: string[] = []
  unionSetAtomsOf(rs, atoms)
  if atoms.length < 2 && !monoNameIsGroupedList(rs) { return rs }
  const c = canonEmitName(rs)
  if c == "" { return rs }
  c
}

// Whether `name` is a list whose element is one parenthesised group (`(A | B)[]`, `(string)[]`).
function monoNameIsGroupedList(name: string): boolean {
  const e = arrElemNameRaw(name)
  e != "" && peelGroupParens(e) != e
}

// The spelling a parameter or local annotation of type `ty` takes when a pin substitutes into a
// union holding a map or a record (`V | {[K]: i32}` at `V := {[K]: boolean}`), registered under
// the canon key a direct spelling reuses (D2657). One that collapses at the pin is spelled as
// its survivor (D7044). `shTag` names the shadow root.
function monoPinMintedUnion(name: string, ty: i32, shTag: i32): string {
  const pun = parenUnionArrElemName(name)
  let pc = ""
  if pun != "" {
    pc = monoPinUnionName(pun)
    const pcAtoms: string[] = []
    unionSetAtomsOf(pc, pcAtoms)
    if pcAtoms.length < 2 { return monoPinUnionName(name) }
  } else if monoPinUnionCollapses(name) || monoNameIsGroupedList(name) {
    return monoPinUnionName(name)
  }
  if !monoTyHoldsRefArm(ty) || unNameBound(name) { return name }
  // A list of such a union registers its element union, as a direct `(A | B)[]` does (D2678).
  if pun != "" {
    monoShStage(unTyKeyTagParamList(), tyStepElem(ty))
    if monoRegisterPinUnion(pc, -1) < 0 { return name }
    return "(" + pc + ")[]"
  }
  const atoms: string[] = []
  unionSetAtomsOf(name, atoms)
  if atoms.length < 2 { return name }
  const c = monoPinUnionName(name)
  monoShStage(shTag, ty)
  if monoRegisterPinUnion(c, -1) < 0 { return name }
  c
}

// Whether union spelling `name` names one atom once canon'd, as `T | string` does at `T := K`.
function monoPinUnionCollapses(name: string): boolean {
  const atoms: string[] = []
  unionSetAtomsOf(name, atoms)
  if atoms.length < 2 { return false }
  const cAtoms: string[] = []
  unionSetAtomsOf(monoPinUnionName(name), cAtoms)
  cAtoms.length < 2
}

// The type-key shadow's stage for the next `monoRegisterPinUnion`: the root's tag (0 for none)
// and the type that root hands over. Written only while the shadow is armed.
let monoShTag = 0
let monoShTy = -1

function monoShStage(tag: i32, ty: i32) {
  if unABOn() == 0 { return 0 }
  monoShTag = tag
  monoShTy = ty
  0
}

// A parameter's pins are classified once the instance's binding is whole: while
// `monoShParNode` names the annotation being pinned, each pin is held here instead.
let monoShParNode = -1
const monoShPendTag: i32[] = []
const monoShPendName: string[] = []
const monoShPendNode: i32[] = []

// Hands the pins held since `from` to the shadow, then drops them. Each is typed by its
// annotation under `monoShBindingOf`'s binding of `params` at `pinTys`; a list pin by that
// type's element.
function monoShPendFlush(
  from: i32,
  params: i32[],
  pinTys: i32[],
  bN: string[],
  bT: i32[],
) {
  const xN: string[] = []
  const xT: i32[] = []
  if monoShPendTag.length > from {
    monoShBindingOf(params, pinTys, bN, bT, xN, xT)
  }
  let i = from
  while i < monoShPendTag.length {
    let ty = substTyDeep(nodeTyIxOf(monoShPendNode[i]), xN, xT)
    if ty >= 0 && tyHasTyVar(ty) { ty = -1 }
    if monoShPendTag[i] == unTyKeyTagParamList() { ty = tyStepElem(ty) }
    unTyKeyShadow(monoShPendTag[i], monoShPendName[i], ty)
    i = i + 1
  }
  while monoShPendTag.length > from {
    monoShPendTag.pop()
    monoShPendName.pop()
    monoShPendNode.pop()
  }
  0
}

// Fills `xN`/`xT` with `bN`/`bT` completed by the union-arm binding each argument in `pinTys`
// gives its parameter's one open member (`T` of `T | i32 | null`), which the instance's own
// binding leaves unbound when that member is a bare type parameter.
function monoShBindingOf(
  params: i32[],
  pinTys: i32[],
  bN: string[],
  bT: i32[],
  xN: string[],
  xT: i32[],
) {
  let j = 0
  while j < bN.length && j < bT.length {
    xN.push(bN[j])
    xT.push(bT[j])
    j = j + 1
  }
  let i = 0
  while i < params.length && i < pinTys.length {
    const pp = P.nodes[params[i]]
    if pp is Param {
      let d = nodeTyIxOf(pp.parType)
      if d >= 0 && d < T.tys.length {
        const dt = T.tys[d]
        if dt is TyNullable { d = dt.nInner }
      }
      bindGenUnionArmInto(d, pinTys[i], xN, xT)
    }
    i = i + 1
  }
  0
}

// The return type the shadow is handed: `retTy`, or where that is -1 the declared `origRet`
// under `monoShBindingOf`'s binding; -1 when a type variable is still open. Armed only.
function monoShRetTy(
  retTy: i32,
  origRet: i32,
  params: i32[],
  pinTys: i32[],
  bN: string[],
  bT: i32[],
): i32 {
  if unABOn() == 0 || retTy >= 0 || origRet < 0 { return retTy }
  const xN: string[] = []
  const xT: i32[] = []
  monoShBindingOf(params, pinTys, bN, bT, xN, xT)
  const t = substTyDeep(origRet, xN, xT)
  if t < 0 || tyHasTyVar(t) { return -1 }
  t
}

// Offers the row `name` names to the shadow under root `shTag` (0 for none): held while a
// parameter is being pinned, else compared with the staged type `ty` at once. Returns 0.
function monoShOffer(shTag: i32, name: string, ty: i32) {
  if shTag <= 0 { return 0 }
  if monoShParNode >= 0 {
    monoShPendTag.push(shTag)
    monoShPendName.push(name)
    monoShPendNode.push(monoShParNode)
    return 0
  }
  unTyKeyShadow(shTag, name, ty)
}

// The type binding `bN`/`bT` gives type parameter `tp`, or -1.
function monoBoundTyOf(tp: string, bN: string[], bT: i32[]): i32 {
  if unABOn() == 0 { return -1 }
  const i = strListIndexOf(bN, tp)
  if i < 0 || i >= bT.length { return -1 }
  bT[i]
}

// Whether union `ty` has a literal-union arm beside a non-literal one (`K | i32`), as a member
// or as the run of string literals an alias renders back to.
function monoTyHoldsLitUnionArm(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const n = T.tys[ty]
  if n is TyNullable { return monoTyHoldsLitUnionArm(n.nInner) }
  const t = T.tys[ty]
  if !(t is TyUnion) { return false }
  if mixedLitRunAliasOf(t.uMembers) != "" { return true }
  for m in t.uMembers {
    if tyIsLitUnion(m) { return true }
  }
  false
}

// A registry hit serves this call's pins from an instance built for others: a parameter whose
// recorded pin is a different type is marked -2, so no test answers from either (D2684).
function monoPoisonSharedPins(instFe: i32, pinTys: i32[]) {
  if instFe < 0 || instFe >= fnStmts.length { return 0 }
  const fd = P.nodes[fnStmts[instFe]]
  if fd is FuncDecl {
    let j = 0
    while j < fd.fnParams.length && j < pinTys.length {
      const pn = P.nodes[fd.fnParams[j]]
      if pn is Param {
        if pn.parType >= 0 && pinTys[j] >= 0 {
          // Only two different MAP pins conflict: a `null` argument holds no map, so a map pin
          // arriving after one takes its place.
          const was = monoParamPinTy.get(pn.parType) ?? -1
          if was >= 0 && monoTyHoldsMap(pinTys[j]) && !tyEq(was, pinTys[j]) {
            if monoTyHoldsMap(was) {
              monoParamPinTy.set(pn.parType, -2)
            } else {
              monoParamPinTy.set(pn.parType, pinTys[j])
            }
          }
        }
      }
      j = j + 1
    }
  }
  0
}

// Whether the union or nullable `ty` has a map among its members.
function monoTyHoldsMap(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const flat: i32[] = []
  flattenVariantsInto(ty, flat)
  let i = 0
  while i < flat.length {
    const m = flat[i]
    if m >= 0 && m < T.tys.length {
      if T.tys[m] is TyMap { return true }
    }
    i = i + 1
  }
  false
}

// Whether the union or nullable `ty` has a map or a record among its members: the arms a
// union box holds under a registered row, where a value atom's tag needs none.
function monoTyHoldsRefArm(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const lt = T.tys[ty]
  if lt is TyArray { return monoTyHoldsRefArm(lt.aElem) }
  const flat: i32[] = []
  flattenVariantsInto(ty, flat)
  let i = 0
  while i < flat.length {
    const m = flat[i]
    if m >= 0 && m < T.tys.length {
      if monoTyIsRefArm(m) { return true }
    }
    i = i + 1
  }
  false
}

// Whether the member type at `m` boxes under a registered row: a map, a record, or a list of
// references (its reflist slot). Every other kind rides a value atom's tag or is not a member.
function monoTyIsRefArm(m: i32): boolean {
  const mt = T.tys[m]
  match mt {
    TyMap | TyObj => {
      return true
    }
    TyArray => {
      return monoTyIsRefElem(mt.aElem)
    }
    TyPrim | TyErr | TyFunc | TyUnion | TyNullable | TyVar | TyLit | TyNeg => {
      return false
    }
  }
}

// Whether list element `e` is a reference other than a string: a record, map, list or union.
function monoTyIsRefElem(e: i32): boolean {
  if e < 0 || e >= T.tys.length { return false }
  const et = T.tys[e]
  match et {
    TyMap | TyObj | TyArray | TyUnion | TyNullable => {
      return true
    }
    TyPrim | TyErr | TyFunc | TyVar | TyLit | TyNeg => {
      return false
    }
  }
}

// D1042 — register a union `name` (rendering `ty`, or -1) that exists only because a pin minted
// it here. `collectU` runs before `monomorphize` and nothing re-runs it, so a `T | E` return at a
// concrete `T` has no row and every consumer of the box hits its floor. The registration self-gates
// on the union key's row, which keeps one row per union — a box's tags are that row's, positionally.
function monoRegisterPinUnion(name: string, ty: i32) {
  const shTag = monoShTag
  monoShTag = 0
  const shTy = monoShTy
  monoShTy = -1
  const atoms: string[] = []
  unionSetAtomsOf(name, atoms)
  if atoms.length < 2 { return 0 }
  if unNameBound(name) { return monoShOffer(shTag, name, shTy) }
  const before = uVariants.length
  let rty = ty
  if rty < 0 { rty = shTy }
  if registerInlineUnionOfTy(monoProgStmts, name, rty) < 0 { return -1 }
  monoShOffer(shTag, name, shTy)
  // Re-rank only when a variant is pushed: `assignTags` ranks variants globally and a value
  // union pushes none, so unconditional re-ranking would be quadratic.
  if uVariants.length != before { return assignTags() }
  0
}

// Per template slot: 1 when its body tests a value of a type parameter, directly or through a
// generic it calls with one, 0 when not, -1 or absent when not yet asked. A slot on the walk's
// stack holds -2 - n, n its visit number: asked, or answered "no" pending its cycle's root.
let monoExactMemo: i32[] = []
// The walk's stack of slots, its next visit number, and the lowest visit number of a slot on the
// stack the current walk has read (Tarjan's lowlink), so a cycle settles once at its root.
let monoExactStack: i32[] = []
let monoExactNext = 0
let monoExactLow = 0

// Whether generic `fe` is keyed by its exact pins: its body has an `is`, `as` or `match` over a
// value whose type names a type parameter, or passes such a value to a generic that has.
function monoNeedsExactKey(fe: i32): boolean {
  if fe < 0 || fe >= monoOrigNode.length { return false }
  while monoExactMemo.length <= fe { monoExactMemo.push(-1) }
  const m = monoExactMemo[fe]
  if m >= 0 { return m == 1 }
  if m <= -2 {
    // On the stack: a provisional "no" until the cycle through it settles.
    if -2 - m < monoExactLow { monoExactLow = -2 - m }
    return false
  }
  const me = monoExactNext
  monoExactNext = me + 1
  const outerLow = monoExactLow
  monoExactLow = me
  // arena-tick exempt: a memo of the template's body, which no rebuild pass reads.
  monoExactMemo[fe] = -2 - me
  monoExactStack.push(fe)
  let r = false
  const fn = P.nodes[monoOrigNode[fe]]
  if fn is FuncDecl { r = monoTestsTyVar(fn.fnBody) }
  const low = monoExactLow
  monoExactLow = outerLow
  if r {
    // A "yes" is final, and every "no" pending above it may have read it as a "no".
    monoExactUnwind(fe, 1, -1)
  } else if low >= me {
    // The root of its cycle: its walk read nothing below it on the stack, so all of it is "no".
    monoExactUnwind(fe, 0, 0)
  } else if low < outerLow {
    monoExactLow = low
  }
  r
}

// Pops the walk's stack down to and including `fe`, settling `fe` to `mine` and every slot above
// it to `rest`: 0 for a cycle that settled "no", -1 to re-ask after a "yes".
function monoExactUnwind(fe: i32, mine: i32, rest: i32) {
  while monoExactStack.length > 0 {
    const top = monoExactStack[monoExactStack.length - 1]
    monoExactStack.pop()
    let v = rest
    if top == fe { v = mine }
    // arena-tick exempt: the same memo.
    if top >= 0 && top < monoExactMemo.length { monoExactMemo[top] = v }
    if top == fe { return 0 }
  }
  0
}

// Whether the node recorded at `ix` has a type naming a type parameter.
function monoTyVarTyped(ix: i32): boolean {
  const t = nodeTyIxOf(unwrapParen(ix))
  t >= 0 && tyHasTyVar(t)
}

// `monoNeedsExactKey`'s walk over one subtree, nested lambdas included.
function monoTestsTyVar(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = P.nodes[ix]
  if n is IsExpr {
    if monoTyVarTyped(n.isObj) { return true }
  }
  if n is AsExpr {
    if monoTyVarTyped(n.asObj) { return true }
  }
  if n is MatchExpr {
    if monoTyVarTyped(n.matchScrut) { return true }
  }
  if n is Call {
    const cf = P.nodes[n.callFn]
    if cf is Ident {
      if monoCalleeIsGeneric(n.callFn) {
        let passes = callTyArgsOf(ix).length > 0
        let a = 0
        while a < n.callArgs.length && !passes {
          passes = monoTyVarTyped(n.callArgs[a])
          a = a + 1
        }
        // A callee still being asked is on this walk's own cycle and answers nothing new.
        if passes && monoNeedsExactKey(fnIndexOfNode(n.callFn)) { return true }
      }
    }
  }
  // An `else if` chain is walked along its spine, so its depth costs no stack (D1990).
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      if monoTestsTyVar(kids[i]) { return true }
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  false
}

// Whether `ty` is a union with a type-parameter member and a concrete member besides `null`,
// the shape the checker's binding walk passes over (`monoAnnIsOpenUnion`'s arena twin).
function monoTyIsOpenUnion(ty: i32): boolean {
  const ms: i32[] = []
  flattenVariantsInto(ty, ms)
  if ms.length < 2 { return false }
  let i = 0
  while i < ms.length {
    if ms[i] >= 0 && !tyHasTyVar(ms[i]) && tyEmitPrimOf(ms[i]) != "null" {
      return true
    }
    i = i + 1
  }
  false
}

// Binds the type parameters of `fn` to the exact types this instance is pinned at into `outN`
// / `outT`: the explicit type arguments first, then each parameter's pin. False, and nothing
// bound, when some parameter's pin is unknown or still names a type variable.
function monoExactBind(
  params: i32[],
  typarams: string[],
  pinTys: i32[],
  exBN: string[],
  exBT: i32[],
  outN: string[],
  outT: i32[],
): boolean {
  let e = 0
  while e < exBN.length && e < exBT.length {
    outN.push(exBN[e])
    outT.push(exBT[e])
    e = e + 1
  }
  // Two passes, a union annotation's last: its type-parameter member binds only what no other
  // parameter binds, as the pin's spelling does (`monoPreBindPastUnionRest`).
  let pass = 0
  while pass < 2 {
    let j = 0
    while j < params.length && j < pinTys.length {
      const p = P.nodes[params[j]]
      if p is Param {
        if p.parType >= 0 {
          const gt = nodeTyIxOf(p.parType)
          if (
            gt >= 0
            && tyHasTyVar(gt)
            && (monoTyIsOpenUnion(gt) == (pass == 1))
          ) {
            if pinTys[j] < 0 || tyHasTyVar(pinTys[j]) {
              return monoExactClear(outN, outT)
            }
            exactBindWalk(gt, pinTys[j], outN, outT)
          }
        }
      }
      j = j + 1
    }
    pass = pass + 1
  }
  let k = 0
  while k < typarams.length {
    let bound = false
    let b = 0
    while b < outN.length {
      if outN[b] == typarams[k] { bound = true }
      b = b + 1
    }
    if !bound { return monoExactClear(outN, outT) }
    k = k + 1
  }
  true
}

// Empties a partial binding, so an instance with a pin it cannot bind exactly keeps its shared
// key; always false.
function monoExactClear(outN: string[], outT: i32[]): boolean {
  while outN.length > 0 { outN.pop() }
  while outT.length > 0 { outT.pop() }
  false
}

// The pin `t` read inside function `ctx`: where it names a type parameter of the instance `ctx`
// is, or is lifted inside, that instance's exact binding substituted, else its parameters'
// pinned types; else `t` itself.
function monoExactPinTyOf(t: i32, ctx: i32): i32 {
  if t < 0 || !tyHasTyVar(t) { return t }
  const row = monoExactSubRowOf(ctx)
  if row >= 0 && row < monoExactSubN.length {
    const st = substTyDeep(t, monoExactSubN[row], monoExactSubT[row])
    if st >= 0 && !tyHasTyVar(st) { return st }
  }
  monoPinSubTyOf(t, ctx)
}

// `t` with the pinned binding of the instance `ctx` is, or is lifted inside, substituted, a
// type parameter's or a hole's; `t` itself where no instance binds every one it names.
function monoPinSubTyOf(t: i32, ctx: i32): i32 {
  if ctx < 0 { return t }
  let pos = fnStmtsPosOf(ctx)
  let guard = 0
  // A nested generic's instance binds its own parameters only; what it leaves open is the
  // enclosing instance's to bind, one frame up (D3831).
  let cur = t
  while pos >= 0 && guard <= fnStmts.length {
    const row = monoPinSubRow.get(pos) ?? -1
    if row >= 0 && row < monoPinSubN.length {
      const st = substTyDeep(cur, monoPinSubN[row], monoPinSubT[row])
      if st < 0 { return t }
      if !tyHasTyVar(st) { return st }
      cur = st
    }
    // A hole instance binds its holes, which the argument's recorded type may name directly.
    const hrow = monoHoleSubRow.get(pos) ?? -1
    if hrow >= 0 && hrow < monoHoleSubN.length {
      let ht = holePinReadOf(cur, monoHoleSubN[hrow], monoHoleSubT[hrow])
      if ht < 0 {
        ht = substTyDeep(cur, monoHoleSubN[hrow], monoHoleSubT[hrow])
      }
      if ht < 0 || tyHasTyVar(ht) { return t }
      return ht
    }
    if pos >= fnParent.length { return t }
    pos = fnParent[pos]
    guard = guard + 1
  }
  t
}

// `monoExactPinTyOf` over each pin of one call.
function monoExactPinTys(pinTys: i32[], ctx: i32) {
  let i = 0
  while i < pinTys.length {
    // arena-tick exempt: the caller's own pin column, not an arena node.
    pinTys[i] = monoExactPinTyOf(pinTys[i], ctx)
    i = i + 1
  }
  0
}

// Writes the instance walk's scoped staging back to its declared values at compile start, so
// no binding, pin or callee frame of an earlier program's walk is read by this one.
export function monoStateReset() {
  monoCallFrameSlot = 0 - 1
  monoCellAliasListOk = 0 - 1
  monoCgcGenAliasNames = []
  monoCurHasLam = false
  monoDestPinOff = false
  monoInstBody = -1
  monoInstIsFirst = false
  monoInstParams = []
  monoLastInstFe = 0 - 1
  monoPinArmBN = []
  monoPinArmBT = []
  monoPinHoleN = []
  monoPinHoleT = []
  monoPinInLit = false
  monoPinLetReaches = false
  monoSigCallRet = 0 - 2
  monoTailIf = -1
  structTyAliasableReset()
  0
}

// Empties the instance-binding tables, which `monomorphize` fills and the classifiers read.
export function monoSubTablesReset() {
  monoExactSubRow = Map()
  monoExactSubN = []
  monoExactSubT = []
  monoHoleSubRow = Map()
  monoHoleSubN = []
  monoHoleSubT = []
  monoPinSubRow = Map()
  monoPinSubN = []
  monoPinSubT = []
  monoArgInstFe = Map()
  monoOpenArgCall = 0 - 1
  monoOpenArgCallee = 0 - 1
  0
}

// The module-scope call being instantiated and its callee, whose open-typed arguments are read
// at the instance the callee reaches (`monoArgInstFe`); -1 for none.
let monoOpenArgCall = 0 - 1
let monoOpenArgCallee = 0 - 1

// Records each argument of `monoOpenArgCall` whose recorded type names a type variable as read
// at instance slot `instFe`, when `calleeIx` is that call's callee; consumes the call.
function monoNoteOpenArgs(calleeIx: i32, instFe: i32) {
  if monoOpenArgCall < 0 || calleeIx != monoOpenArgCallee { return 0 }
  const c = P.nodes[monoOpenArgCall]
  monoOpenArgCall = 0 - 1
  monoOpenArgCallee = 0 - 1
  if c is Call {
    for a in c.callArgs {
      const t = nodeTyIxOf(a)
      if t >= 0 && tyHasTyVar(t) { monoArgInstFe.set(a, instFe) }
    }
  }
  0
}

// Per template slot: how many of its instances are being walked, one inside another.
let monoActiveDepth: i32[] = []
const MONO_NEST_MAX = 32

// The instance-creation core shared by `monoInstantiate` (call-driven) and
// `monoInstanceFor` (annotation-driven): clone or reuse the instance of generic `origFe`
// for the already-built `pinned` names and point `calleeIx` at it. `annotateI32` annotates
// an i32-pinned param too; `cbFnNames` bakes a concrete callback in. Returns 0, or -1.
function monoMakeInstance(
  origFe: i32,
  pinned: string[],
  pinKinds: i32[],
  pinPays: string[],
  pinTys: i32[],
  tvN: string[],
  tvV: string[],
  calleeIx: i32,
  annotateI32: boolean,
  cbFnNames: string[],
) {
  // A `K | (L | null)` pin softens without its null, so the instance keeps the nesting (D3504).
  const foldWas = substNullFoldOffFor(pinTys)
  const rc = monoMakeInstanceGo(
    origFe,
    pinned,
    pinKinds,
    pinPays,
    pinTys,
    tvN,
    tvV,
    calleeIx,
    annotateI32,
    cbFnNames,
  )
  substNullFoldRestore(foldWas)
  rc
}

// The instance registry key, `key` extended by the pins, the exact types a type-testing body
// binds (pushed onto `exSubN`/`exSubT`) and the baked-callback identities. Returns the key.
function monoMakeInstanceKey(
  key: string,
  origFe: i32,
  params: i32[],
  pinned: string[],
  pinTys: i32[],
  tps: string[],
  exBN: string[],
  exBT: i32[],
  exSubN: string[],
  exSubT: i32[],
  cbFnNames: string[],
) {
  let pk = 0
  while pk < pinned.length {
    key = key
      + pinned[pk]
      + monoAnonPinDiscrim(pinned[pk], pinTys[pk])
      + monoSigPinDiscrim(pinned[pk], pinTys[pk])
      + ","
    pk = pk + 1
  }
  // A body testing a value of a type parameter is keyed by the exact types, which a pin's
  // spelling can merge (a Set and its boolean map), so each instance binds them to one.
  if monoNeedsExactKey(origFe) {
    if (monoExactBind(params, tps, pinTys, exBN, exBT, exSubN, exSubT)) {
      monoShAliasBind(origFe, exSubN, exSubT)
      let xk = 0
      while xk < exSubN.length {
        key = key
          + "~"
          + exSubN[xk]
          + "="
          + tyCanonKey(exSubT[xk], TY_WALK_DEPTH)
          + ";"
        xk = xk + 1
      }
    }
  }
  // The baked-callback identities extend the key, so two calls passing the same pinned
  // types but different non-capturing callbacks get distinct instances. No baked
  // callback → no `@` suffix → the key is exactly the pre-specialization one.
  let ck = 0
  while ck < cbFnNames.length {
    if cbFnNames[ck] != "" { key = key + "@" + cbFnNames[ck] + "," }
    ck = ck + 1
  }
  key
}

// The registry lookup for an instance `key`: on a hit, points the call site at the existing
// instance (renaming the callee unless it must stay a `call_ref`) and fills the hole
// annotations a value use needs. True on a hit, false when the shape is new.
function monoMakeInstanceHit(
  key: string,
  origFe: i32,
  pinned: string[],
  pinTys: i32[],
  calleeIx: i32,
  annotateI32: boolean,
) {
  let k = 0
  while k < monoKeys.length {
    if monoKeys[k] == key {
      monoLastInstFe = monoInstFe[k]
      monoNoteOpenArgs(calleeIx, monoInstFe[k])
      monoPoisonSharedPins(monoInstFe[k], pinTys)
      const cal = P.nodes[calleeIx]
      if cal is Ident {
        // A registry hit on a capturing lambda in the binding's own slot must stay a
        // `call_ref`: renaming the callee would drop the captured env. A reassigned
        // binding must too, since every later write would be invisible.
        let keepCallRef = false
        if monoInstFe[k] == origFe && cal.identName != monoInstName[k] {
          if captureCountOf(origFe) > 0 {
            keepCallRef = true
          } else if monoReadIsAssigned(cal.identName, calleeIx) {
            keepCallRef = true
          }
        }
        if !keepCallRef {
          if (
            cal.identName != monoInstName[k]
            && !i32ListHas(monoNoRename, calleeIx)
          ) {
            monoAliasCallNote(calleeIx)
            collectANoteIdentRename(cal.identName)
            cal.identName = monoInstName[k]
            monoArenaTouch()
            // R4 writer 5 of 8 (`compiler/symbols.vl`; census in `perf-program.md`).
            let instDecl = fnStmts[monoInstFe[k]]
            if identAuditDrop == IDENT_DROP_MONO_CALLEE { instDecl = -1 }
            sidNoteNodeName(calleeIx, instDecl)
          }
        }
      }
      // A value use reaching an instance a direct call already built. The call path
      // spells an i32 pin as the hole it is, leaving the value floor to reject a
      // function this program has pinned monomorphic — order-dependence nobody holds.
      if annotateI32 {
        const hfn = P.nodes[fnStmts[monoInstFe[k]]]
        if hfn is FuncDecl {
          const hps = hfn.fnParams
          if hps.length == pinned.length {
            let hp = 0
            while hp < hps.length {
              const hpp = P.nodes[hps[hp]]
              if hpp is Param {
                if hpp.parType < 0 {
                  // The synthesis is the whole write: `synthTypeRef` records
                  // the type under the same pin this column holds. Equivalent
                  // to the clone arm only while this caller's column is all -1.
                  hpp.parType = synthTypeRef(pinned[hp], -1)
                  monoArenaTouch()
                }
              }
              hp = hp + 1
            }
          }
        }
      }
      return true
    }
    k = k + 1
  }
  false
}

// The instance's parameters, cloned with each one's pinned annotation: pushes one cloned
// `Param` per declared parameter onto `nps` and its resolved arena row (-1 for none) onto
// `pinnedTyIx`, one row per entry of `params`. 0 on success, -1 when a record argument's
// fields name a row of another field kind.
function monoMakeInstanceParams(
  fn: FuncDecl,
  params: i32[],
  pinned: string[],
  pinKinds: i32[],
  pinTys: i32[],
  tps: string[],
  tvN: string[],
  tvV: string[],
  exBN: string[],
  exBT: i32[],
  annotateI32: boolean,
  argLit: boolean[],
  nps: i32[],
  pinnedTyIx: i32[],
) {
  let pj = 0
  while pj < params.length {
    let pinTy = -1
    const p3 = P.nodes[params[pj]]
    if p3 is Param {
      let nt = -1
      // Whether `nt` is a node this loop SYNTHESIZED (and which therefore already
      // carries its recorded type) or the original declaration's own annotation node.
      let synthed = false
      if p3.parType >= 0 {
        // The pinned name differs from the written annotation exactly when
        // a type param substituted through it (bare `T`, `T[]`, or a
        // composite like `Box<T>`); a concrete annotation keeps its node.
        if pinned[pj] == tyNameOf(p3.parType) {
          nt = p3.parType
        } else {
          monoNicheNulListCheck(tyNameOf(p3.parType), tps, tvN, tvV)
          // The argument's type is one member of a union parameter; the explicit type
          // arguments substituted through the annotation name the union itself (D2679).
          let gateTy = pinTys[pj]
          if !monoTyHoldsRefArm(gateTy) && exBN.length > 0 {
            const pst = substTyDeep(nodeTyIxOf(p3.parType), exBN, exBT)
            if pst >= 0 && !tyHasTyVar(pst) { gateTy = pst }
          }
          if unABOn() > 0 { monoShParNode = p3.parType }
          const pinName = monoPinMintedUnion(
            pinned[pj],
            gateTy,
            unTyKeyTagParam(),
          )
          nt = synthTypeRefFb(pinName, -1, pinTys[pj])
          // A literal-union arm beside a scalar (`T | i32` at `T := K`) boxes under a row too,
          // and no direct spelling minted one (D5310).
          if monoTyHoldsLitUnionArm(nodeTyIxOf(nt)) {
            monoShStage(unTyKeyTagArm(), nodeTyIxOf(nt))
            monoRegisterPinUnion(pinName, -1)
          }
          monoShParNode = -1
          if pinTys[pj] >= 0 { monoParamPinTy.set(nt, pinTys[pj]) }
          synthed = true
        }
      } else if annotateI32 || pinned[pj] != "i32" {
        nt = synthTypeRefFb(pinned[pj], -1, pinTys[pj])
        synthed = true
      }
      // The pinned concrete param type is recorded on the instance's annotation node,
      // and `pinTy` is that index. A synthesized node already carries it; the original
      // declaration's node carries the checker's generic-frame resolution instead.
      if nt >= 0 {
        if synthed {
          pinTy = nodeTyIxOf(nt)
        } else {
          // The node often already holds the answer, this arm being reached only when
          // the pinned name is the written annotation. The few that differ carry the
          // generic body's type-param frame, which `tyHasTyVar` separates.
          const already = nodeTyIxOf(nt)
          if already >= 0 && !tyHasTyVar(already) {
            pinTy = already
          } else {
            pinTy = recordClonedNodeTy(nt, pinned[pj], pinKinds[pj])
          }
        }
      } else {
        // The one arm that mints no annotation node: an un-annotated param pinned at plain
        // i32 (`nt` stays -1 by design, so the all-i32 path adds zero arena nodes).
        pinTy = i32TyIx()
      }
      // D681 — an anon pin's type is its row's, not the placeholder's: `#anonN`
      // resolves to nothing, so the node records a field-less `TyObj` while this
      // column is what the re-check windows declare the parameters as.
      const anonTy = anonHandleTyIx(pinned[pj])
      if anonTy >= 0 { pinTy = anonTy }
      // A row first typed through a hole keeps it; the argument's closed type binds it instead.
      if (
        anonTy >= 0
        && tyHasTyVar(anonTy)
        && pinTys[pj] >= 0
        && !tyHasTyVar(pinTys[pj])
      ) {
        pinTy = pinTys[pj]
      }
      // The row keeps one function type per field, so a record differing only there (the
      // instance key already tells them apart) binds its own, or every callee typed from
      // the binding reads the row's first signature (D3110).
      if anonTy >= 0 && monoObjDiffersInFnFieldsOnly(pinTys[pj], anonTy) {
        pinTy = pinTys[pj]
        monoFnFieldTwinRow.set(pinTy, pinned[pj])
      } else if (
        anonTy < 0
        && monoDeclFnFieldTwin(pinned[pj], pinTys[pj]) >= 0
      ) {
        pinTy = pinTys[pj]
        monoFnFieldTwinRow.set(pinTy, pinned[pj])
      }
      let isLit = pj < argLit.length && argLit[pj]
      const agree = anonRowKindsAgree(pinned[pj], pinTys[pj])
      if !isLit && anonTy >= 0 { isLit = agree == 1 }
      // A record spelled by its fields names the first row of its layout, which can hold
      // another code-0 kind; the instance would read that row while its caller builds its own.
      if (
        anonTy >= 0
        && agree == 0
        && pinned[pj][0] != "#"[0]
        && monoSubtreeNamesIdent(fn.fnBody, p3.parName, 0)
      ) {
        return emitFail(
          "emitProgram: a record argument's fields name a row that holds another field kind, and a record is shared rather than converted",
        )
      }
      if anonTy >= 0 && nt >= 0 && isLit && monoConcreteObjTy(pinTys[pj]) {
        monoAnonParamPinTy.set(nt, pinTys[pj])
      }
      nps.push(
        monoCopyOf(
          params[pj],
          mkParam(p3.parName, nt, p3.parDefault, p3.parOpt, p3.parRest, -1),
        ),
      )
      // D926 — and the `??` owner mark, which is keyed by arena node and so does not
      // survive a clone on its own. See `anonLeafCarryParamMark`.
      anonLeafCarryParamMark(params[pj], nps[nps.length - 1])
    }
    pinnedTyIx.push(pinTy)
    pj = pj + 1
  }
  0
}

// The return annotation substituted through the binding where it names a type parameter,
// first of the return rungs. Takes and returns `nret` (-1 for none); -2 when a return type
// parameter is unbound or the pinned union could not be registered. `pinTys` feeds only the shadow.
function monoMakeInstanceRetAnn(
  fn: FuncDecl,
  nret: i32,
  tps: string[],
  tvN: string[],
  tvV: string[],
  letBN: string[],
  letBT: i32[],
  pinTys: i32[],
) {
  if fn.fnRet >= 0 {
    // The parameter pin's rule, applied to the RETURN for the same reason: a shadowed
    // return annotation is canon'd out of the arena before this read.
    const rn = monoDeclAnnName(fn.fnRet, tyNameOf(fn.fnRet), tps)
    if monoAnnHasTyParam(rn, tps) {
      const rs = monoSubstAnn(rn, tps, tvN, tvV)
      if rs == "" {
        emitFail(
          "emitProgram: monomorphize: a return type parameter of `"
            + fn.fnName
            + "` is not bound by any parameter",
        )
        return -2
      }
      // The substituted type, not a re-parse of the substituted name, which would
      // mint a structurally identical `Ty` row. Gated on completeness: `tyHasTyVar`
      // separates a partial substitution from a full one.
      let retTy = -1
      const origRet = nodeTyIxOf(fn.fnRet)
      if origRet >= 0 {
        // The body's own binding column, and that agreement is the invariant: the registry
        // is keyed on the pins, so a result sourced elsewhere makes the instance a function
        // the key cannot see.
        const sub2 = substTyDeep(origRet, letBN, letBT)
        if sub2 >= 0 {
          if sub2 != origRet {
            // `substTyDeep`'s union arm dedupes and collapses, so a `T | string` at
            // `T := string` normalises the way the annotation path does. No corpus
            // program grades this one.
            if !tyHasTyVar(sub2) { retTy = sub2 }
          }
        }
      }
      // A result bound to one inline literal is a scalar lone literal, so its string (D7340).
      if retTy >= 0 && rs[0] == '"' && tyIsOneStrLit(retTy) {
        const ru = T.tys[retTy]
        if ru is TyUnion { retTy = ru.uMembers[0] }
      }
      // D1042 — a union the pin mints is spelled the way the direct spelling is. `rs`
      // substitutes the bound name into the declared text, so `T | "err"` arrives
      // literal, while every other producer of that key softens it to `i32|string`.
      // A grouped union (`(T | string)`) keys the union itself, as the direct spelling does.
      let rsG = rs
      const rsP = peelGroupParens(rs)
      if unionSetMemberCount(rsP) > 1 { rsG = rsP }
      const rsC = monoPinUnionName(rsG)
      nret = synthTypeRefTy(rsC, -1, retTy)
      // And register it: `collectU`, the only pass that mints union rows, runs before
      // this one. Registering under the canon'd key reuses the row a direct spelling
      // minted — a union's box tags are positional over its member set.
      monoShStage(
        unTyKeyTagRet(),
        monoShRetTy(retTy, origRet, fn.fnParams, pinTys, letBN, letBT),
      )
      if monoRegisterPinUnion(rsC, -1) < 0 { return -2 }
    }
  }
  nret
}

// The return rungs read off the template's return expression while no annotation is known
// (a closure-pinned value-call, a `.map`/`.filter` or index over a pinned list, a returned
// local), then `monoMakeInstanceRetJoin`'s, whose result it returns. Pushes the returned
// hole-built local's name and type onto `outS` and its arena row onto `outIx`.
function monoMakeInstanceRetExpr(
  fn: FuncDecl,
  origFe: i32,
  nret: i32,
  params: i32[],
  pinned: string[],
  pinTys: i32[],
  pinKinds: i32[],
  pinPays: string[],
  pinnedTyIx: i32[],
  letTyCol: i32[],
  letBN: string[],
  letBT: i32[],
  outS: string[],
  outIx: i32[],
  twoOut: i32[],
) {
  // A hole-built return list local to annotate in the cloned instance body, so its `[]`
  // build classifies per element type. Captured from the return trace below and threaded
  // into `monoCloneBody`, which clones and annotates just that `LetDecl` per instance.
  let monoOutName = ""
  let monoOutType = ""
  // The arena row for `monoOutType`, carried beside the spelling so the body clone mints
  // from the type instead of re-parsing the print. -1 where no producer ran, which
  // `synthTypeRefTy` treats exactly as name resolution.
  let monoOutTypeIx = -1
  // An un-annotated return whose return expression is a value-call through a
  // closure-pinned param takes that signature's result kind as a concrete annotation:
  // the emitter's return-kind inference has no expression form for a `call_ref` result,
  // so the instance's functype rides the normal annotation tables instead.
  if nret < 0 {
    const rx2 = fnRetExprOf(monoOrigNode[origFe])
    if rx2 >= 0 {
      const rxe = P.nodes[rx2]
      if rxe is Call {
        const rcal = P.nodes[rxe.callFn]
        if rcal is Ident {
          nret = monoRetOfClosureCall(
            rcal,
            params,
            pinned,
            pinKinds,
            pinPays,
            pinTys,
            nret,
          )
        }
        // `return <param>.map/filter(<lambda>)` over a param pinned to a non-i32
        // array: type the return as the concrete result list. `.filter` preserves the
        // element; `.map` preserves it for an element-wise callback. i32 keeps -1.
        if rcal is Member {
          if rcal.memProp == "map" || rcal.memProp == "filter" {
            if rxe.callArgs.length == 1 {
              const mrecv = P.nodes[rcal.memObj]
              if mrecv is Ident {
                nret = monoRetOfListMethod(
                  rxe,
                  rcal.memProp,
                  mrecv,
                  params,
                  pinned,
                  pinTys,
                  nret,
                )
              }
            }
          }
        }
      }
      if rxe is Index {
        // `return param[i]` where the param pinned to an f64 array yields an f64
        // element — synthesize the concrete `f64` return, the un-annotated-return kind
        // inference having no f64 form for it. i32 and string keep `nret = -1`.
        const ria = P.nodes[rxe.idxArr]
        if ria is Ident {
          let pqi = 0
          while pqi < params.length {
            const ppi = P.nodes[params[pqi]]
            if ppi is Param {
              if ppi.parName == ria.identName {
                // `nameIsF64Array` is the home for this question. Both it and the
                // sibling twenty lines up (`listElemNameOf` for the `.map`/`.filter`
                // element) are projections of one value: the pinned array's element name.
                if nameIsF64Array(pinned[pqi]) {
                  nret = synthTypeRef("f64", -1)
                }
              }
            }
            pqi = pqi + 1
          }
        }
      }
      if rxe is Ident {
        // `return <local>` where the local is a hole-built list: the list shares the
        // indexed param's array type, so type the return as that param's pinned type.
        // No source param found → keep `nret = -1`.
        const srcParam = monoListSrcParam(fn.fnBody, rxe.identName)
        if srcParam != "" {
          let pli = 0
          while pli < params.length {
            const ppl = P.nodes[params[pli]]
            if ppl is Param {
              if ppl.parName == srcParam {
                if pinned[pli] != "" {
                  // The argument type is handed over instead of re-parsed out
                  // of the spelling, which would mint a second arena row.
                  // `pinTys[pli]` of -1 falls back to exactly name resolution.
                  nret = synthTypeRefTy(pinned[pli], -1, pinTys[pli])
                  monoOutName = rxe.identName
                  monoOutType = pinned[pli]
                  monoOutTypeIx = pinTys[pli]
                }
              }
            }
            pli = pli + 1
          }
        } else {
          // The pass-through trace found no `out.push(param[idx])` source — the list
          // is built from a non-trivial expression. Re-check the body for this shape
          // so the checker's own list-element inference resolves the local.
          const listTyIx: i32[] = []
          let listTy = monoInferListElem(
            monoOrigNode[origFe],
            pinnedTyIx,
            rxe.identName,
            listTyIx,
          )
          if listTy != "" {
            let ltIx = -1
            if listTyIx.length > 0 { ltIx = listTyIx[0] }
            listTy = monoListSpelling(listTy, ltIx)
            // A list of records is spelled the way the shape interner keys its row, as the
            // return-expression arm below spells one; the check's render keeps its spaces (D4683).
            const lLeafD = monoListLeaf(ltIx)
            const lLeaf = lLeafD[0]
            if lLeafD[1] > 0 && lLeaf >= 0 && T.tys[lLeaf] is TyObj {
              const lrn = monoRetListRowName(ltIx)
              if lrn != "" { listTy = lrn }
            }
            nret = synthTypeRefTy(listTy, -1, ltIx)
            monoOutName = rxe.identName
            monoOutType = listTy
            monoOutTypeIx = ltIx
          } else {
            // Not an inferred list local — try a scalar one whose type derives from a
            // hole-pinned param. The return-kind inference runs before locals are
            // collected. "" for i32 / boolean / composite.
            const scTyIx: i32[] = []
            const scTy = monoInferLocalScalar(
              monoOrigNode[origFe],
              pinnedTyIx,
              rxe.identName,
              scTyIx,
            )
            if scTy != "" {
              let scIx = -1
              if scTyIx.length > 0 { scIx = scTyIx[0] }
              nret = synthTypeRefTy(scTy, -1, scIx)
            }
          }
        }
      }
    }
  }
  outS.push(monoOutName)
  outS.push(monoOutType)
  outIx.push(monoOutTypeIx)
  monoMakeInstanceRetJoin(
    fn,
    origFe,
    nret,
    params,
    letTyCol,
    letBN,
    letBT,
    pinnedTyIx,
    twoOut,
  )
}

// The return a value-call through the closure-pinned param `rcal` takes; else `nret`.
function monoRetOfClosureCall(
  rcal: Ident,
  params: i32[],
  pinned: string[],
  pinKinds: i32[],
  pinPays: string[],
  pinTys: i32[],
  nret: i32,
): i32 {
  let pq = 0
  while pq < params.length {
    const pp = P.nodes[params[pq]]
    if pp is Param {
      if pp.parName == rcal.identName {
        const pn = pinned[pq]
        // The bound is the paren arm's own: a `(…)`-opening function-type
        // spelling is never two characters. The pin arm beside it reads the
        // column rather than the name's first two.
        if pn.length > 2 {
          if pinKinds[pq] == PIN_SIGKEY {
            // An un-annotated closure param's sig-key pin: only its
            // f64 result kind has no expression-form return inference.
            // The payload decodes through `sigKeyRetKind`.
            if sigKeyRetKind(pinPays[pq]) == "f64" {
              nret = synthTypeRef("f64", -1)
            }
          } else if nameIsParenOpen(pn) {
            // An annotated function-type param pin: the un-annotated
            // HOF return flows through the callback, so it is the
            // callback's return type. A closure result stays `nret = -1`.
            const retName = normTypeAtom(annRetNameOf(pn))
            // The return row comes off the pin's own type, not from a
            // second parse of the name cut out of `pn`. The gate is
            // unchanged; only the recorded row is.
            let retTyIx = -1
            if pinTys[pq] >= 0 {
              const pft = T.tys[pinTys[pq]]
              if pft is TyFunc { retTyIx = pft.fnRet }
            }
            if retName != "" && annArrowAt(retName) < 0 {
              nret = synthTypeRefTy(retName, -1, retTyIx)
            }
          }
        }
      }
    }
    pq = pq + 1
  }
  nret
}

// The list type `rxe`, a `.map`/`.filter` over the param `recv`, returns; else `nret`.
function monoRetOfListMethod(
  rxe: Call,
  prop: string,
  recv: Ident,
  params: i32[],
  pinned: string[],
  pinTys: i32[],
  nret: i32,
): i32 {
  let pqm = 0
  while pqm < params.length {
    const ppm = P.nodes[params[pqm]]
    if ppm is Param {
      if ppm.parName == recv.identName {
        // `listElemNameOf` adds one naive grouping-paren strip
        // over the cut this site wants: a `(…)`-wrapped element
        // is the only shape the two disagree on.
        const srcElem = listElemNameOf(pinned[pqm])
        if srcElem != "" && srcElem != "i32" {
          // Both arms produce the receiver's own list type, so
          // `srcElem + "[]"` is `pinned[pqm]` cut apart and put
          // back together, landing on a fresh arena row each time.
          if prop == "filter" {
            nret = synthTypeRefTy(srcElem + "[]", -1, pinTys[pqm])
          } else if monoLambdaPreservesElem(rxe.callArgs[0]) {
            nret = synthTypeRefTy(srcElem + "[]", -1, pinTys[pqm])
          }
        }
      }
    }
    pqm = pqm + 1
  }
  nret
}

// The return rungs read off the template's return expressions: the tail expression's own
// type where no shape rung named one, then the join over every return. Takes and returns
// the return annotation node (`nret`, -1 for none), -2 when a pinned union could not be
// registered; pushes the two-list result type (-1 for none) onto `twoOut` on success.
function monoMakeInstanceRetJoin(
  fn: FuncDecl,
  origFe: i32,
  nret: i32,
  params: i32[],
  letTyCol: i32[],
  letBN: string[],
  letBT: i32[],
  pinnedTyIx: i32[],
  twoOut: i32[],
) {
  // D592 — the ladder's fall-through, asked of the return expression rather than of its
  // shape. Every arm above matches one spelling, and a return the whitelist does not name
  // keeps `nret = -1`, so the functype result falls to `retAnnKindChain`'s `"i32"` seed.
  // Last, so every arm above keeps its answer.
  if nret < 0 {
    const reTyIx: i32[] = []
    const reTy = monoInferRetExprTy(
      monoOrigNode[origFe],
      pinnedTyIx,
      letBN,
      letBT,
      fnRetExprOf(monoOrigNode[origFe]),
      reTyIx,
    )
    if reTy != "" {
      let reIx = -1
      if reTyIx.length > 0 { reIx = reTyIx[0] }
      // D592 — a struct return is annotated by the name of an interned row, never by
      // the shape's printed spelling. `monoRetRowName` asks the emitter's own table
      // which row this arena type is; no row, no mint.
      let mintName = reTy
      let mint = true
      // Bound-checked rather than trusted: an unguarded `T.tys[-1]` is a compiler
      // trap, which the `emitFail does not halt` discipline exists for. A -1 keeps
      // the printed-name route.
      if reIx >= 0 {
        const rrt = T.tys[reIx]
        if rrt is TyObj {
          mintName = monoRetRowName(reIx)
          // A literal holding a join the checker kept apart has no row of its own before the
          // pin: its shape spelling mints one (D2906).
          if (
            mintName == ""
            && origFe >= 0
            && origFe < monoOrigNode.length
            && monoObjHoldsGradual(fnRetExprOf(monoOrigNode[origFe]))
          ) {
            mintName = tyToStructStr(reIx)
          }
          if mintName == "" { mint = false }
        }
        // A list of records is spelled by the element's row name for the same reason (D2300).
        if rrt is TyArray {
          const lrn = monoRetListRowName(reIx)
          if lrn != "" { mintName = lrn }
        }
      }
      // D970 — a multi-return function is not described by one return expression, so
      // `reTy` names the tail while the result is the join. Declining leaves the
      // instance to the return-inference path.
      if mint {
        if monoRetJoinDisagrees(monoOrigNode[origFe], reIx) { mint = false }
      }
      if mint { nret = synthTypeRefTy(mintName, -1, reIx) }
    }
  }
  // D1521 — a multi-return instance is not described by one arm, whichever arm the
  // ladder above named. It overrides the ladder rather than filling its -1: the shape
  // whitelist reaches its own answer and that answer is still one arm. A still-holey arm
  // declines the whole set, and `monoRegisterPinUnion` makes the minted name resolvable.
  let twoListTy = -1
  if fn.fnRet < 0 {
    const jTy: i32[] = []
    const jDecl = monoOrigNode[origFe]
    // A return naming a parameter's hole (`[t]` beside `[1]`) reads it at the holes' binding,
    // as a type parameter's return reads the pin (D4900).
    const jhN: string[] = []
    const jhT: i32[] = []
    monoHoleBinding(origFe, params, letTyCol, jhN, jhT)
    let jBN = letBN
    let jBT = letBT
    if jhN.length > 0 {
      jBN = []
      jBT = []
      monoJoinBinding(letBN, letBT, jhN, jhT, jBN, jBT)
    }
    const jl = monoInferRetSetListTy(jDecl, pinnedTyIx, jBN, jBT)
    // Two list types stored alike (`boolean[]`, `i32[]`) build as one of them; any other
    // pair builds the union box and is refused at a use that needs one list.
    let sharedRep = -1
    if jl >= 0 && T.tys[jl] is TyUnion {
      sharedRep = listUnionSharedRep(jl)
      if sharedRep < 0 { twoListTy = jl }
    }
    let jun = ""
    if sharedRep < 0 {
      jun = monoInferRetSetUnionName(jDecl, pinnedTyIx, letBN, letBT, jTy)
      // A list of records has no value atom, so the union is spelled by each list's row (D2782).
      if jun == "" && twoListTy >= 0 {
        jun = monoListUnionRowName(twoListTy)
        if jun != "" { jTy.push(twoListTy) }
      }
    } else {
      // The list the checker types the call as, where it is one of the members.
      let pick = sharedRep
      const dft = nodeTyIxOf(jDecl)
      if dft >= 0 && dft < T.tys.length {
        const dfn = T.tys[dft]
        if dfn is TyFunc {
          const cr = substTyDeep(dfn.fnRet, letBN, letBT)
          if cr >= 0 && cr < T.tys.length && !tyHasTyVar(cr) {
            if T.tys[cr] is TyArray { pick = cr }
          }
        }
      }
      const srn = tyToEmitName(pick)
      if srn != "" { nret = synthTypeRefTy(srn, -1, pick) }
    }
    if jun != "" {
      let jIx = -1
      if jTy.length > 0 { jIx = jTy[0] }
      if monoRegisterPinUnion(jun, jIx) < 0 { return -2 }
      nret = synthTypeRefTy(jun, -1, jIx)
    } else if jl >= 0 && T.tys[jl] is TyArray {
      let jln = monoRetListRowName(jl)
      if jln == "" { jln = tyToEmitName(jl) }
      if jln != "" { nret = synthTypeRefTy(jln, -1, jl) }
    }
  }
  twoOut.push(twoListTy)
  nret
}

// The return pins read off the template's checked signature, last of the return rungs: a
// bare type-parameter result, a gradual union holding one, and a nullable, list or value-box
// join no earlier rung named. Takes and returns the instance's return annotation node
// (`nret`, -1 for none); -2 when a pinned union could not be registered.
function monoMakeInstanceRetChecked(
  fn: FuncDecl,
  origFe: i32,
  nret: i32,
  params: i32[],
  letTyCol: i32[],
  tps: string[],
  tvN: string[],
  tvV: string[],
  letBN: string[],
  letBT: i32[],
) {
  // An inferred return the checker typed as a bare type parameter is the `: T` annotation's
  // twin: the pin's own spelling, which names a record or map by the argument's row.
  if nret < 0 && fn.fnRet < 0 {
    const tpRet = monoCheckedRetTyParam(origFe, tps)
    if tpRet != "" {
      const tpSub = monoSubstAnn(tpRet, tps, tvN, tvV)
      if tpSub != "" && tpSub != tpRet {
        const tpName = monoPinUnionName(tpSub)
        monoShStage(unTyKeyTagTpSub(), monoBoundTyOf(tpRet, letBN, letBT))
        if monoRegisterPinUnion(tpName, -1) < 0 { return -2 }
        nret = synthTypeRefTy(tpName, -1, -1)
      }
    }
  }
  // A return typed at a union holding a type parameter is that union at the pin, as a bare
  // `T` return is the pin's own spelling (D2906).
  const gNeed = nret < 0 && fn.fnRet < 0
  let gfx = -1
  if (
    (gNeed || !monoGradualRetPinned)
    && origFe >= 0
    && origFe < monoOrigNode.length
  ) {
    gfx = nodeTyIxOf(monoOrigNode[origFe])
  }
  if gfx >= 0 && gfx < T.tys.length {
    const gft = T.tys[gfx]
    // Any union return holding a type parameter (`T[] | i32[]`) is a box a record field can
    // carry, so the literal's row is minted at the pin (D4930).
    if gft is TyFunc && gft.fnRet >= 0 && gft.fnRet < T.tys.length {
      if T.tys[gft.fnRet] is TyUnion && tyHasTyVar(gft.fnRet) {
        monoGradualRetPinned = true
      }
    }
    if gft is TyFunc && tyIsGradualUnion(gft.fnRet) {
      monoGradualRetPinned = true
      if gNeed {
        let grt = substTyDeep(gft.fnRet, letBN, letBT)
        // A join kept apart over parameter holes is bound by the holes' binding (D3333).
        if grt >= 0 && tyHasTyVar(grt) {
          grt = monoHoleRetSubst(gft.fnRet, gft, params, letTyCol)
        }
        if (
          grt >= 0
          && grt < T.tys.length
          && !tyHasTyVar(grt)
          && T.tys[grt] is TyUnion
        ) {
          const gnm = monoPinUnionName(tyToEmitName(grt))
          if gnm != "" {
            if monoRegisterPinUnion(gnm, grt) < 0 { return -2 }
            nret = synthTypeRefTy(gnm, -1, grt)
          }
        }
      }
    }
  }
  // D2037 — a body that can fall off the end returns `T | null`, a `null` no return
  // expression carries, so every rung above names too little. The template's checked
  // signature holds the join; a concrete nullable one pins the instance as an annotation.
  let nretBearsNull = false
  if nret >= 0 {
    const nrt = nodeTyIxOf(nret)
    if nrt >= 0 && nrt < T.tys.length { nretBearsNull = tyBearsNull(nrt) }
  }
  if fn.fnRet < 0 && !nretBearsNull {
    let ftIx = -1
    if origFe >= 0 && origFe < monoOrigNode.length {
      ftIx = nodeTyIxOf(monoOrigNode[origFe])
    }
    if ftIx >= 0 && ftIx < T.tys.length {
      const ft = T.tys[ftIx]
      if ft is TyFunc {
        // A join naming the type parameter (`T | null`, or a bare `T` bound to a nullable
        // type) is read at this instance's binding, as the body's own nodes are.
        let rty = ft.fnRet
        if rty >= 0 && tyHasTyVar(rty) {
          rty = substTyDeep(rty, letBN, letBT)
          if rty >= 0 && tyHasTyVar(rty) {
            rty = monoHoleRetSubst(rty, ft, params, letTyCol)
          }
          if rty >= 0 && tyHasTyVar(rty) { rty = -1 }
        }
        // A list, or a join of lists, that no rung above named takes the checked type
        // too: unpinned, the result falls to the scalar `i32` seed over a list (D2217).
        const rtyList = rty >= 0 && nret < 0 && monoRetIsListOrListJoin(rty)
        // A union of value atoms no rung named is its box, for the same reason (D2895). A
        // union with a record, map or reference-list arm is left out: annotating it breaks
        // complement narrowing of the caller's un-annotated binding.
        const rtyBox = rty >= 0
          && nret < 0
          && T.tys[rty] is TyUnion
          && !tyIsLitUnion(rty)
          && !monoTyHoldsRefArm(rty)
          && !monoPinBoxUncovered(
          fn.fnBody,
          rty,
          params,
          letTyCol,
          letBN,
          letBT,
        )
        if rty >= 0 && (tyBearsNull(rty) || rtyList || rtyBox) {
          const rnm = monoPinUnionName(tyToEmitName(rty))
          if rnm != "" {
            if monoRegisterPinUnion(rnm, rty) < 0 { return -2 }
            nret = synthTypeRefTy(rnm, -1, rty)
          }
        }
      }
    }
  }
  nret
}

// The instance body cloned at this pin with its lambdas pinned: `monoCloneBody` at the
// binding (joined with the holes' binding where a join names a hole), then the reach and
// unsafe-name notes and `monoPinBodyLambdas`. The `monoOut*` triple names the hole-built
// return local to annotate ("" / -1 for none). Restores every pin global it sets.
function monoMakeInstanceBodyPinned(
  fn: FuncDecl,
  origFe: i32,
  first: boolean,
  nret: i32,
  params: i32[],
  letTyCol: i32[],
  tps: string[],
  tvN: string[],
  tvV: string[],
  letBN: string[],
  letBT: i32[],
  instHoleN: string[],
  instHoleT: i32[],
  monoOutName: string,
  monoOutType: string,
  monoOutTypeIx: i32,
) {
  // A join the checker kept apart over a parameter hole names the hole, which only the holes'
  // binding binds: the body's walks read both (D3333).
  let bodyBN = letBN
  let bodyBT = letBT
  if holeNamesTpJoin(instHoleN) {
    bodyBN = []
    bodyBT = []
    monoJoinBinding(letBN, letBT, instHoleN, instHoleT, bodyBN, bodyBT)
  }
  monoTailIf = blockLastStmt(fn.fnBody)
  const svPinFn = njSetPinFn(monoOrigNode[origFe])
  const instBody0 = monoCloneBody(
    fn.fnBody,
    tps,
    tvN,
    tvV,
    monoOutName,
    monoOutType,
    monoOutTypeIx,
    bodyBN,
    bodyBT,
  )
  // D426 — substitute a bound lambda's own annotations at this pin, and mint the lambda
  // per instance. `monoCloneBody` above shares every leaf expression including a nested
  // lambda, which is right for a concrete lambda and wrong for one written at `T`.
  // Copy-on-write: a body with no such lambda is the same node index.
  monoLamMintedSlots = []
  monoLamCloneSlots = []
  monoInstIsFirst = first
  monoCgcLamNames = monoInstLamNames(instBody0)
  monoCgcGenAliasNames = monoInstGenAliasNames(instBody0)
  monoPinUnsafeNames = Map()
  monoPinRetBox = false
  if fn.fnRet < 0 && nret >= 0 {
    const nrb = nodeTyIxOf(nret)
    // A null-bearing box is left out: its caller reads the call at the template's type.
    monoPinRetBox = nrb >= 0
      && nrb < T.tys.length
      && T.tys[nrb] is TyUnion
      && !tyBearsNull(nrb)
  }
  monoPinArmBinds(params, letTyCol, letBN, letBT)
  monoPinReachNames = Map()
  monoPinNoteReach(instBody0)
  if monoPinReachShadowed(instBody0) {
    monoPinRetBox = false
    monoPinReachNames = Map()
  }
  monoPinNoteUnsafeBody(instBody0)
  if monoPinRetBox { monoPinRetTy = nodeTyIxOf(nret) }
  monoPinRetBox = false
  // A hole instance's lambdas, list literals and reads are typed at its holes, which its
  // parameters' binding does not name: they pin through the holes' binding too (D3083, D3066).
  const svHoleN = monoPinHoleN
  const svHoleT = monoPinHoleT
  monoPinHoleN = instHoleN
  monoPinHoleT = instHoleT
  const svParams = monoInstParams
  monoInstParams = params
  const svBody = monoInstBody
  monoInstBody = fn.fnBody
  const instBody0L = monoPinBodyLambdas(
    instBody0,
    tps,
    tvN,
    tvV,
    bodyBN,
    bodyBT,
  )
  monoPinHoleN = svHoleN
  monoInstParams = svParams
  monoInstBody = svBody
  njSetPinFn(svPinFn)
  monoPinHoleT = svHoleT
  monoPinRetTy = -1
  instBody0L
}

// The instance body's per-pin rewrites after its lambdas are pinned: the `.map`/`.filter`
// callbacks, baked callbacks, per-instance generic-call copies, layout constants and the
// hole operators, in that order. Each rung is copy-on-write, so a body none of them touches
// comes back as `instBody0L` itself.
function monoMakeInstanceBodyRewrite(
  instBody0L: i32,
  origFe: i32,
  params: i32[],
  pinned: string[],
  pinTys: i32[],
  pinnedTyIx: i32[],
  cbFnNames: string[],
  tps: string[],
  tvN: string[],
  tvV: string[],
  exSubN: string[],
  exSubT: i32[],
  letBN: string[],
  letBT: i32[],
) {
  // Pin any `.map`/`.filter` callback lambda whose receiver param this instance bound to
  // a non-i32 element: the shared body's un-annotated lambda would otherwise emit as i32.
  // Build the param→element map from the pinned param names, then clone and pin per
  // instance; i32 shapes are left as they are.
  const pElemNames: string[] = []
  const pElemTypes: string[] = []
  // The element row column, parallel to `pElemTypes`. `listElemNameOf` cuts the element
  // out of the pin's spelling; this reads it off the pin's type, so the callback's pinned
  // annotation is minted from a row. -1 where the pin is not a recorded array.
  const pElemTys: i32[] = []
  let pe = 0
  while pe < params.length {
    const pep = P.nodes[params[pe]]
    if pep is Param {
      pElemNames.push(pep.parName)
    } else {
      pElemNames.push("")
    }
    pElemTypes.push(listElemNameOf(pinned[pe]))
    let peTy = -1
    if pinTys[pe] >= 0 {
      const pet = T.tys[pinTys[pe]]
      if pet is TyArray { peTy = pet.aElem }
    }
    pElemTys.push(peTy)
    pe = pe + 1
  }
  const instBody1 = monoPinMapLambdas(
    instBody0L,
    pElemNames,
    pElemTypes,
    pElemTys,
  )
  // Bake any non-capturing concrete callback into a direct call (`pElemNames` already
  // holds the per-position param names, parallel to `cbFnNames`). No baked callback → no
  // rewrite → the body is the same node `monoPinMapLambdas` produced.
  let instBody2 = instBody1
  if monoAnyBakedCallback(cbFnNames) {
    // -1: `instBody1` is already a lambda-pinned clone (`monoPinBodyLambdas`/
    // `monoPinMapLambdas`), not the original `fn.fnBody` — no single root names its
    // block structure, so the shadow guard cannot be asked here (see the -1 contract
    // on `monoBakeCallback`, D2325).
    instBody2 = monoBakeCallback(instBody1, pElemNames, cbFnNames, -1)
  }
  // Per-instance copies of the direct generic calls this body makes, so instantiating
  // them rewrites only this instance's callee `Ident`s. No generic call → the same node.
  monoCgcTyParams = tps
  monoCgcTvN = tvN
  monoCgcTvV = tvV
  monoCgcSubN = exSubN
  monoCgcSubT = exSubT
  monoCgcBN = letBN
  monoCgcBT = letBT
  const instBody3 = monoCloneGenericCalls(instBody2)
  monoCgcLamNames = []
  monoCgcLamDeclX = []
  monoCgcHoleN = []
  monoCgcHoleT = []
  monoCgcHoleParams = []
  monoCgcBN = []
  monoCgcBT = []
  monoCgcTyParams = []
  monoCgcTvN = []
  monoCgcTvV = []
  monoCgcSubN = []
  monoCgcSubT = []
  // Per-instance layout constants for the type parameters this body reads
  // (`i * T.size`) — folded HERE because the binding is what makes them exist.
  const instBody4 = monoFoldTyParamLayout(instBody3, tps, tvN, tvV)
  // The two questions `dispatchRewrite` asks of a hole, re-asked at the pin. Last in the
  // chain, so it sees the body every rung above produced; copy-on-write, so a body with
  // no such operator is the same node index.
  monoPinCtx = monoOrigNode[origFe]
  monoPinArgTys = pinTys
  const instBody = monoPinBinOps(instBody4, pElemNames, pinnedTyIx)
  monoPinCtx = -1
  monoPinArgTys = []
  instBody
}

// A later instance of `fn`: appends `nfn` as a new function slot under its frame, refuses a
// reassigned binding called at a second signature, and renames the callee to `instName`.
// Returns the new slot's index, or -1 once `emitFail` has recorded the refusal.
function monoMakeInstanceLater(
  fn: FuncDecl,
  nfn: i32,
  origFe: i32,
  calleeIx: i32,
  callFrame: i32,
  instName: string,
) {
  // D971 — a lifted capturing instance takes its env as a leading `structref` param,
  // so a by-name call to it is sound. What is not is the rename folding a call into
  // the initializer's instance when the binding is reassigned.
  const cal3 = P.nodes[calleeIx]
  // A call by the generic's own name is never a binding's, so it skips the write scan (D4607).
  if cal3 is Ident && cal3.identName != fn.fnName {
    // A binding written anywhere on its alias chain holds one signature as surely as one
    // written itself (D3858).
    const written = monoNameWrittenAt(cal3.identName, calleeIx)
      || i32ListHas(monoNoRename, calleeIx)
    if (written && !monoWrittenLetSigCall && calleeIx != monoWriteCoercedCall) {
      // A frame-keyed instance differs by its enclosing instance, not its argument type.
      if callFrame >= 0 {
        return emitFail(
          "emitProgram: the reassigned function binding `"
            + cal3.identName
            + "` holds a nested generic that captures its enclosing generic's values, at "
            + "more than one instance of it — one binding holds one closure signature. Bind "
            + "a separate value per instance, or call the nested function by its name",
        )
      }
      // A binding never written itself is a copy of one that is, and is named as one.
      let what = "the reassigned function binding `" + cal3.identName + "` is"
      let wants = "the values written to it want two"
      if !monoNameWrittenAt(cal3.identName, calleeIx) {
        // The copy is split with the binding it copies, one slot per call signature (D5171).
        const cd = identDeclOf(calleeIx)
        if cd >= 0 && cd < P.nodes.length && P.nodes[cd] is LetDecl {
          fsAsk(cd)
        }
        what = "the function binding `"
          + cal3.identName
          + "`, a copy of a reassigned binding, is"
        wants = "its calls want two"
      }
      return emitFail(
        "emitProgram: "
          + what
          + " called at more than one argument type — one binding holds one closure "
          + "signature, and "
          + wants
          + ". Annotate the parameters, or bind a separate value per type",
      )
    }
  }
  fnStmts.push(nfn)
  // A nested template's later instance keeps the template's frame, so its captures
  // resolve where the first instance's do and its env fields take their real types (D2749).
  let instParent = -1
  if origFe < fnParent.length { instParent = fnParent[origFe] }
  if callFrame >= 0 { instParent = callFrame }
  fnParent.push(instParent)
  if callFrame >= 0 { invalidateFnChildIndex() }
  fnDispNames.push("")
  const instFe = fnStmts.length - 1
  // D943 — the clones' frame is this instance, not the template. `captureValKind`
  // types an env field by resolving the capture in its enclosing frame, so until this
  // runs the clone reads `value: T` and every instance mints the same env layout.
  let mls = 0
  let mlsWrote = false
  while mls < monoLamMintedSlots.length {
    const msl = monoLamMintedSlots[mls]
    if msl >= 0 && msl < fnParent.length {
      buildFnMapNoteFnSlotWrite()
      fnParent[msl] = instFe
      monoArenaTouch()
      mlsWrote = true
    }
    mls = mls + 1
  }
  if mlsWrote { invalidateFnChildIndex() }
  monoLamMintedSlots = []
  const cal2 = P.nodes[calleeIx]
  // A call through a never-written alias of a capturing nested generic, keyed on its frame:
  // the alias's own value is that instance's closure, whose env holds this frame's captures.
  if (
    cal2 is Ident
    && callFrame >= 0
    && callFrame < fnStmts.length
    && cal2.identName != fn.fnName
  ) {
    const actx = fnStmts[callFrame]
    monoRenameGenAliasInit(calleeIx, actx, fn.fnName, instName)
  }
  // R4 writer 6 of 8 (`compiler/symbols.vl`; census in `perf-program.md`).
  if cal2 is Ident && !i32ListHas(monoNoRename, calleeIx) {
    monoAliasCallNote(calleeIx)
    collectANoteIdentRename(cal2.identName)
    cal2.identName = instName
    monoArenaTouch()
    let instDecl = fnStmts[instFe]
    if identAuditDrop == IDENT_DROP_MONO_CALLEE { instDecl = -1 }
    sidNoteNodeName(calleeIx, instDecl)
  }
  instFe
}

// The instance's return annotation node (-1 for none), from the rungs in order: the
// substituted annotation, the return expression, the join over every return and the
// checked signature. -2 on a recorded failure. Pushes the hole-built return local's name
// and type onto `outS`, and its arena row then the two-list result type onto `outIx`.
function monoMakeInstanceRet(
  fn: FuncDecl,
  origFe: i32,
  params: i32[],
  pinned: string[],
  pinKinds: i32[],
  pinPays: string[],
  pinTys: i32[],
  pinnedTyIx: i32[],
  letTyCol: i32[],
  tps: string[],
  tvN: string[],
  tvV: string[],
  letBN: string[],
  letBT: i32[],
  outS: string[],
  outIx: i32[],
) {
  // Substitute a type-param-riding RETURN annotation through the binding —
  // bare `T` / `T[]`, an application (`Box<T>`), or an inline object shape
  // (`{first:B,second:A}`); a concrete annotation passes through unchanged.
  let nret = fn.fnRet
  if nret >= 0 { monoNicheNulListCheck(tyNameOf(nret), tps, tvN, tvV) }
  nret = monoMakeInstanceRetAnn(fn, nret, tps, tvN, tvV, letBN, letBT, pinTys)
  if nret < -1 { return -2 }
  const twoOut: i32[] = []
  nret = monoMakeInstanceRetExpr(
    fn,
    origFe,
    nret,
    params,
    pinned,
    pinTys,
    pinKinds,
    pinPays,
    pinnedTyIx,
    letTyCol,
    letBN,
    letBT,
    outS,
    outIx,
    twoOut,
  )
  if nret < -1 { return -2 }
  nret = monoMakeInstanceRetChecked(
    fn,
    origFe,
    nret,
    params,
    letTyCol,
    tps,
    tvN,
    tvV,
    letBN,
    letBT,
  )
  if nret < -1 { return -2 }
  outIx.push(twoOut[0])
  nret
}

// Rebuilds the closure-pinned parameter column this instance binds (`monoCloPinNames` and
// `monoCloPinTys`), read by the body clone's container rung. Rebuilt per instance, since
// the pin is what differs between them.
function monoMakeInstanceCloPins(
  params: i32[],
  pinKinds: i32[],
  pinTys: i32[],
) {
  monoCloPinNames = []
  monoCloPinTys = []
  let cp = 0
  while cp < params.length {
    const cpp = P.nodes[params[cp]]
    if cpp is Param {
      if cp < pinKinds.length && cp < pinTys.length {
        if pinKinds[cp] == PIN_SIGKEY && pinTys[cp] >= 0 {
          const cpt = T.tys[pinTys[cp]]
          if cpt is TyFunc {
            monoCloPinNames.push(cpp.parName)
            monoCloPinTys.push(pinTys[cp])
          }
        }
      }
    }
    cp = cp + 1
  }
}

// Records a new instance under `key` in the registry, with the side tables keyed by its
// slot `instFe`: the two-list result type and the exact, pin and hole binding rows.
function monoMakeInstanceRegister(
  key: string,
  origFe: i32,
  instName: string,
  instFe: i32,
  twoListTy: i32,
  exSubN: string[],
  exSubT: i32[],
  letBN: string[],
  letBT: i32[],
  instHoleN: string[],
  instHoleT: i32[],
) {
  monoKeys.push(key)
  monoInstOrig.push(origFe)
  monoInstName.push(instName)
  monoInstFe.push(instFe)
  monoLastInstFe = instFe
  if twoListTy >= 0 { monoTwoListRet.set(instName, twoListTy) }
  if exSubN.length > 0 {
    monoExactSubRow.set(instFe, monoExactSubN.length)
    monoExactSubN.push(exSubN)
    monoExactSubT.push(exSubT)
  }
  if letBN.length > 0 {
    monoPinSubRow.set(instFe, monoPinSubN.length)
    monoPinSubN.push(letBN)
    monoPinSubT.push(letBT)
  }
  if instHoleN.length > 0 {
    monoHoleSubRow.set(instFe, monoHoleSubN.length)
    monoHoleSubN.push(instHoleN)
    monoHoleSubT.push(instHoleT)
  }
  while fnInstOrigin.length <= instFe { fnInstOrigin.push(-1) }
  if instFe != origFe {
    fnInstOrigin[instFe] = origFe
    monoArenaTouch()
  }
}

// Walks a registered instance's body and its lambda clones' bodies, so their own generic
// calls instantiate at this instance's types, under the nesting bound. 0 on success, -1 on
// a recorded failure.
function monoMakeInstanceWalk(
  fn: FuncDecl,
  origFe: i32,
  nfn: i32,
  calleeIx: i32,
  lamClones: i32[],
) {
  // A nested walk of one template here mints a new pin, since a repeated pin hits the
  // registry; past the bound the pins grow without end, as in `f<T>` calling `f<T[]>` (D2721).
  while monoActiveDepth.length <= origFe { monoActiveDepth.push(0) }
  if monoActiveDepth[origFe] >= MONO_NEST_MAX {
    return emitFailAt(
      "emitProgram: monomorphize: `"
        + fn.fnName
        + "` instantiates itself at a new type on every call, so it has no finite set of instances",
      calleeIx,
    )
  }
  // arena-tick exempt: a walk counter, which no rebuild pass reads.
  monoActiveDepth[origFe] = monoActiveDepth[origFe] + 1
  // Walk this instance's body — a nested generic call instantiates its own callee
  // against this instance's concrete annotations, and the callee rename lands on the
  // instance's own `Call` spine rather than on nodes its siblings share.
  const walked = monoWalkFnBody(nfn)
  // arena-tick exempt: the same counter.
  monoActiveDepth[origFe] = monoActiveDepth[origFe] - 1
  if walked < 0 { return -1 }
  // A clone's body is walked beside its instance's: its generic calls are its own copies,
  // and the template's walk pinned the template's (D2553).
  let lci = 0
  while lci < lamClones.length {
    const ls = lamClones[lci]
    if ls >= 0 && ls < fnStmts.length {
      if monoWalkFnBody(fnStmts[ls]) < 0 { return -1 }
    }
    lci = lci + 1
  }
  if monoRebuild() < 0 { return -1 }
  0
}

// The body's binding column, one row per entry of `params`: `pinnedTyIx` except at a
// function-type or closure-pinned parameter, which takes the argument's own row from
// `pinTys` (-1 where neither has one).
function monoMakeInstanceLetTyCol(
  params: i32[],
  pinned: string[],
  pinKinds: i32[],
  pinTys: i32[],
  pinnedTyIx: i32[],
) {
  // The body's binding column, built from `pinnedTyIx` except at a function-type
  // parameter, where it takes the argument's own arena row. A pin name substitutes each
  // type parameter's bound name, and a literal union's bound name is the softened
  // `string` — so one instance spelled `U[]` two ways, atom-backed and string-ref-backed.

  // Not everywhere: taking `pinTys` at every position reddens the litunion-ordering
  // family, because a value parameter's pin name carries a nominal fact a row does not.
  const letTyCol: i32[] = []
  let lj = 0
  while lj < params.length {
    let lt = -1
    if lj < pinnedTyIx.length { lt = pinnedTyIx[lj] }
    if lj < pinned.length {
      if annArrowAt(pinned[lj]) >= 1 || pinKinds[lj] == PIN_SIGKEY {
        if lj < pinTys.length && pinTys[lj] >= 0 { lt = pinTys[lj] }
      }
    }
    letTyCol.push(lt)
    lj = lj + 1
  }
  letTyCol
}

// The name of a later instance of `fn`: its name with the next free `$<n>` suffix past
// `count` instances (one more when the template's slot is free, which it then records).
function monoMakeInstanceLaterName(
  fn: FuncDecl,
  origFe: i32,
  count: i32,
  slotFree: boolean,
) {
  let suffix = count
  if slotFree {
    suffix = count + 1
    monoFramedPushes.set(origFe, count + 1)
  }
  let instName = fn.fnName + "$" + i32ToStr(suffix)
  // Two nested generics of one name in different functions count their instances apart,
  // so a suffix the other already minted is skipped: the renamed call would reach it (D3830).
  while monoInstNameTaken(instName) {
    suffix = suffix + 1
    instName = fn.fnName + "$" + i32ToStr(suffix)
  }
  instName
}

// The head of an instance's registry key: the template's slot, the pending `monoKeyExtra`
// (consumed here), and the call frame when the instance is frame-keyed.
function monoMakeInstanceKeyHead(origFe: i32, callFrame: i32): string {
  let key = i32ToStr(origFe) + "#" + monoKeyExtra
  monoKeyExtra = ""
  if callFrame >= 0 { key = key + "^" + i32ToStr(callFrame) }
  key
}

// A closure-pinned param flips the module's function-value machinery on (the instance body
// `call_ref`s through it; the argument side builds the fat pointer), as a lifted lambda does.
function monoPinKindsNoteFnVal(pinKinds: i32[]) {
  let pv = 0
  while pv < pinKinds.length {
    if pinKinds[pv] == PIN_SIGKEY { fnValUsed = true }
    pv = pv + 1
  }
  0
}

// How many instances of the template at `origFe` exist so far.
function monoInstanceCount(origFe: i32): i32 {
  let count = 0
  let k2 = 0
  while k2 < monoInstOrig.length {
    if monoInstOrig[k2] == origFe { count = count + 1 }
    k2 = k2 + 1
  }
  count
}

// Binds the instance's hole parameters into `monoCgcHoleN`/`monoCgcHoleT` (fresh rows) and
// names its un-annotated parameters in `monoCgcHoleParams`, for the body clone to read.
function monoMakeInstanceHoles(
  origFe: i32,
  params: i32[],
  letTyCol: i32[],
  body: i32,
) {
  monoCgcHoleN = []
  monoCgcHoleT = []
  monoHoleBinding(origFe, params, letTyCol, monoCgcHoleN, monoCgcHoleT)
  monoCgcHoleParams = monoHoleParamNames(params, body)
  0
}

// The instance's declared result: `nret`, or -1 when a bare `return` makes the template void
// whatever its tail's type is, or its result is never consumed — `computeVoidFns` then
// classifies the clone from its own body (D1600).
function monoMakeInstanceRetIx(fn: FuncDecl, origFe: i32, nret: i32): i32 {
  let instRet = nret
  if fn.fnRet < 0 && blockHasBareReturn(fn.fnBody) { instRet = -1 }
  if fnResultUnconsumed(monoOrigNode[origFe]) { instRet = -1 }
  instRet
}

// Installs the first instance `nfn` in the template's own slot: it keeps the bare name and
// the original's wasm index.
function monoMakeInstanceFirst(
  origFe: i32,
  nfn: i32,
  calleeIx: i32,
  instName: string,
) {
  buildFnMapNoteFnStmtWrite(origFe, nfn)
  fnStmts[origFe] = nfn
  monoArenaTouch()
  monoLamCallByName(calleeIx, origFe, instName)
  0
}

// An instance's registry key, and the type-parameter bindings the key names.
type MonoInstKey = {
  key: string,
  tps: string[],
  exBN: string[],
  exBT: i32[],
  exSubN: string[],
  exSubT: i32[],
  argLit: boolean[],
}

// The key of `fn`'s instance at these pins, taking over the staged explicit bindings.
function monoMakeInstanceKeyOf(
  fn: FuncDecl,
  origFe: i32,
  callFrame: i32,
  pinned: string[],
  pinTys: i32[],
  tvN: string[],
  tvV: string[],
  cbFnNames: string[],
): MonoInstKey {
  // A nested generic's instance binds what its enclosing instance binds too, so a signature
  // or a capture naming the enclosing type parameter lowers at that pin (D3829, D3831).
  const tps: string[] = []
  for tp in fn.fnTyParams { tps.push(tp) }
  const outerN: string[] = []
  const outerT: i32[] = []
  monoEnclosingPinRow(origFe, callFrame, fn.fnTyParams, outerN, outerT)
  monoCurHasLam = monoFnDeclaresLambda(origFe)
  let key = monoMakeInstanceKeyHead(origFe, callFrame)
  const exBN = monoExplicitBN
  const exBT = monoExplicitBT
  key = key + monoBindEnclosingPins(outerN, outerT, tps, exBN, exBT, tvN, tvV)
  const argLit = monoPinArgLit
  monoExplicitBN = []
  monoExplicitBT = []
  monoPinArgLit = []
  // The exact-type binding the key names, read again by the body rewrite.
  const exSubN: string[] = []
  const exSubT: i32[] = []
  key = monoMakeInstanceKey(
    key,
    origFe,
    fn.fnParams,
    pinned,
    pinTys,
    tps,
    exBN,
    exBT,
    exSubN,
    exSubT,
    cbFnNames,
  )
  const k: MonoInstKey = {
    key: key,
    tps: tps,
    exBN: exBN,
    exBT: exBT,
    exSubN: exSubN,
    exSubT: exSubT,
    argLit: argLit,
  }
  k
}

// Binds each enclosing pin that has a spelling, and returns the key text naming them.
function monoBindEnclosingPins(
  outerN: string[],
  outerT: i32[],
  tps: string[],
  exBN: string[],
  exBT: i32[],
  tvN: string[],
  tvV: string[],
): string {
  let key = ""
  let on = 0
  while on < outerN.length {
    const osp = monoPinAnnSpelling(outerT[on])
    if osp != "" {
      tps.push(outerN[on])
      exBN.push(outerN[on])
      exBT.push(outerT[on])
      tvN.push(outerN[on])
      tvV.push(osp)
      key = key + "|" + outerN[on] + "=" + tyCanonKey(outerT[on], TY_WALK_DEPTH)
    }
    on = on + 1
  }
  key
}

// The instance `FuncDecl` of `fn` named `instName`, over params `nps` and body `instBody`.
function monoMakeInstanceFunc(
  fn: FuncDecl,
  origFe: i32,
  nret: i32,
  instBody: i32,
  instName: string,
  nps: i32[],
): i32 {
  const noTyParams: string[] = []
  const instRet = monoMakeInstanceRetIx(fn, origFe, nret)
  if instBody != fn.fnBody { bodyRebuiltFrom.set(instBody, fn.fnBody) }
  const nfn = mkFunc(instName, noTyParams, nps, instRet, instBody, -1)
  // D926 — the return-row twin of the param mark. `monoOrigNode[origFe]` is the template's
  // own `FuncDecl`, which is what `anonLeafMarkRetMoved` marked.
  anonLeafCarryRetMark(monoOrigNode[origFe], nfn)
  nfn
}

// Installs instance `nfn` and returns its function slot, -1 on a refusal.
function monoMakeInstanceInstall(
  fn: FuncDecl,
  nfn: i32,
  origFe: i32,
  calleeIx: i32,
  callFrame: i32,
  instName: string,
  first: boolean,
): i32 {
  if first {
    monoMakeInstanceFirst(origFe, nfn, calleeIx, instName)
    return origFe
  }
  monoMakeInstanceLater(fn, nfn, origFe, calleeIx, callFrame, instName)
}

// Refuses a pin type column not parallel to the pins: -1, else 0.
function monoPinColsMisalignedFail(pinned: string[], pinTys: i32[]): i32 {
  // The pin columns are positional and nothing downstream can tell a misaligned one from a
  // correct one — param j would silently read param k's type. Checked once, loudly, here
  // rather than bounds-guarding each read: a guard turns misalignment into a silently wrong
  // type, and a short-but-nonempty column is exactly what a bounds guard cannot see.
  if pinTys.length != pinned.length {
    return emitFail(
      "emitProgram: monomorphize: pin type column is not parallel to the pins",
    )
  }
  0
}

// `monoMakeInstance` itself.
function monoMakeInstanceGo(
  origFe: i32,
  pinned: string[],
  pinKinds: i32[],
  pinPays: string[],
  pinTys: i32[],
  tvN: string[],
  tvV: string[],
  calleeIx: i32,
  annotateI32: boolean,
  cbFnNames: string[],
) {
  const callFrame = monoCallFrameSlot
  monoCallFrameSlot = -1
  if monoPinColsMisalignedFail(pinned, pinTys) < 0 { return -1 }
  // `origFe` needs no bound of its own: every caller reaches here past `fe < monoGen.length`,
  // and `monomorphize` pushes `monoGen` and `monoOrigNode` in one loop and never appends to
  // either again, so that test is `monoOrigNode`'s length wearing another name.
  const fn = P.nodes[monoOrigNode[origFe]]
  if fn is FuncDecl {
    const params = fn.fnParams
    const k = monoMakeInstanceKeyOf(
      fn,
      origFe,
      callFrame,
      pinned,
      pinTys,
      tvN,
      tvV,
      cbFnNames,
    )
    monoPinKindsNoteFnVal(pinKinds)
    // Registry hit: point this call site at the existing instance.
    if (
      monoMakeInstanceHit(k.key, origFe, pinned, pinTys, calleeIx, annotateI32)
    ) {
      return 0
    }
    // New shape: clone the original declaration with pinned annotations. An un-annotated
    // param pinned at plain i32 keeps `parType = -1` — the emitter's default kind, and
    // zero new arena nodes on the all-i32 path.
    const count = monoInstanceCount(origFe)
    const nps: i32[] = []
    // The pinned params as arena indices, one row per entry of `params` (-1 = no
    // resolvable type). This is the column the speculative-inference windows below take:
    // the pin is resolved once, here at the clone, and never re-resolved from its spelling.
    const pinnedTyIx: i32[] = []
    const shAt = monoShPendTag.length
    const paramsOk = monoMakeInstanceParams(
      fn,
      params,
      pinned,
      pinKinds,
      pinTys,
      k.tps,
      tvN,
      tvV,
      k.exBN,
      k.exBT,
      annotateI32,
      k.argLit,
      nps,
      pinnedTyIx,
    )
    if paramsOk < 0 {
      monoShPendFlush(shAt, [], [], [], [])
      return -1
    }
    const letTyCol = monoMakeInstanceLetTyCol(
      params,
      pinned,
      pinKinds,
      pinTys,
      pinnedTyIx,
    )
    const letBN: string[] = k.exBN
    const letBT: i32[] = k.exBT
    monoBindCols(
      params,
      monoDeclParamTys(origFe, params.length),
      letTyCol,
      letBN,
      letBT,
    )
    monoShAliasBind(origFe, letBN, letBT)
    monoShPendFlush(shAt, params, pinTys, letBN, letBT)
    // The hole-built return local the body clone annotates (name, type, row) and the two-list type.
    const retOutS: string[] = []
    const retOutIx: i32[] = []
    const nret = monoMakeInstanceRet(
      fn,
      origFe,
      params,
      pinned,
      pinKinds,
      pinPays,
      pinTys,
      pinnedTyIx,
      letTyCol,
      k.tps,
      tvN,
      tvV,
      letBN,
      letBT,
      retOutS,
      retOutIx,
    )
    if nret < -1 { return -1 }
    const twoListTy = retOutIx[1]
    let instName = fn.fnName
    // A frame-keyed instance never takes the template's slot, whose frame is the template's.
    const slotFree = count == (monoFramedPushes.get(origFe) ?? 0)
    const first = slotFree && callFrame < 0
    if !first {
      instName = monoMakeInstanceLaterName(fn, origFe, count, slotFree)
    }
    monoMakeInstanceCloPins(params, pinKinds, pinTys)
    // Substitute type-param annotations in the body's `LetDecl`s for this instance (a
    // `const out: T[]` becomes `const out: f64[]`); shares the body wholesale when it has
    // no such annotation.
    monoMakeInstanceHoles(origFe, params, letTyCol, fn.fnBody)
    const instHoleN = monoCgcHoleN
    const instHoleT = monoCgcHoleT
    const instBody0L = monoMakeInstanceBodyPinned(
      fn,
      origFe,
      first,
      nret,
      params,
      letTyCol,
      k.tps,
      tvN,
      tvV,
      letBN,
      letBT,
      instHoleN,
      instHoleT,
      retOutS[0],
      retOutS[1],
      retOutIx[0],
    )
    const lamClones = monoLamCloneSlots
    monoLamCloneSlots = []
    const instBody = monoMakeInstanceBodyRewrite(
      instBody0L,
      origFe,
      params,
      pinned,
      pinTys,
      pinnedTyIx,
      cbFnNames,
      k.tps,
      tvN,
      tvV,
      k.exSubN,
      k.exSubT,
      letBN,
      letBT,
    )
    const nfn = monoMakeInstanceFunc(fn, origFe, nret, instBody, instName, nps)
    const instFe = monoMakeInstanceInstall(
      fn,
      nfn,
      origFe,
      calleeIx,
      callFrame,
      instName,
      first,
    )
    if instFe < 0 { return -1 }
    // REGISTER before walking the body, so a recursive self-call at the same
    // shape resolves here instead of recursing (the host's discipline).
    monoMakeInstanceRegister(
      k.key,
      origFe,
      instName,
      instFe,
      twoListTy,
      k.exSubN,
      k.exSubT,
      letBN,
      letBT,
      instHoleN,
      instHoleT,
    )
    monoNoteOpenArgs(calleeIx, instFe)
    if monoRebuild() < 0 { return -1 }
    return monoMakeInstanceWalk(fn, origFe, nfn, calleeIx, lamClones)
  }
  0
}

// The param type names of a function-type name (`(f64, f64) => f64` → ["f64", "f64"]),
// appended to `out`; false when `name` is not a function type or is malformed. A thin
// reading of `emit_base.annFnDecompose`, whose answer conflates "not a function type"
// with "a function type whose return name is empty" — its stated contract.
function monoFnTypeAnnParamsName(name: string, out: string[]) {
  annFnDecompose(name, out) != ""
}

// The parameter types of the concrete function type `t` (the value's recorded type, or the
// destination's), when it has `n` of them and names no type variable; empty otherwise.
function monoFnValueParamTys(t: i32, n: i32): i32[] {
  const out: i32[] = []
  if t < 0 || tyHasTyVar(t) { return out }
  const ft = T.tys[t]
  if ft is TyFunc {
    if ft.fnParamTypes.length != n { return out }
    let i = 0
    while i < n {
      out.push(ft.fnParamTypes[i])
      i = i + 1
    }
  }
  out
}

// Set while a literal is delivered at an annotation with no adapter between them; the return
// type `monoInstanceFor` must then reproduce, or "" for any return.
let monoInstanceExactRet = false
let monoInstanceRetName = ""

// Materialize or reuse the instance of generic `origFe` for an annotated function-typed
// binding, pinning each parameter to the annotation's param type name and pointing
// `letInitIx` at it. Unlike the call-driven path this carries the value's concrete type
// independent of any call, so a binding that escapes is `call_ref`'d at that type.
function monoInstanceFor(
  origFe: i32,
  pinnedNames: string[],
  letInitIx: i32,
  expTy: i32,
) {
  const fn = P.nodes[monoOrigNode[origFe]]
  if fn is FuncDecl {
    const params = fn.fnParams
    if params.length != pinnedNames.length { return 0 }
    const tvN: string[] = []
    const tvV: string[] = []
    let i = 0
    // Every parameter is read, in one of three ways: an un-annotated hole is filled from
    // the boundary; a type parameter is bound by it, which also substitutes the return;
    // a concrete annotation must agree with the boundary's name or this declines.
    while i < params.length {
      const p = P.nodes[params[i]]
      if p is Param {
        if p.parType >= 0 {
          // The declared spelling, so a parameter whose annotation names a type parameter
          // is read as that parameter rather than as whatever an alias of the same name
          // canon'd to — `monoInstantiate`'s rule, for the same reason.
          const ann = monoDeclAnnName(
            p.parType,
            tyNameOf(p.parType),
            fn.fnTyParams,
          )
          if monoAnnHasTyParam(ann, fn.fnTyParams) {
            monoBindFromAnn(ann, pinnedNames[i], fn.fnTyParams, tvN, tvV)
          } else if normTypeAtom(ann) != normTypeAtom(pinnedNames[i]) {
            return 0
          }
        }
      }
      i = i + 1
    }
    // Post-condition on the bindings, and it needs its own pass because `monoBindFromAnn`
    // is first-use-wins: substituting them back through every type-param-riding annotation
    // must reproduce the boundary. `pairT<T>(a: T, b: T)` reaching `(i32, string) => i32`
    // binds `T` from `a` and then disagrees at `b`. Declining hands it to the value floor.
    let v = 0
    while v < params.length {
      const pv = P.nodes[params[v]]
      if pv is Param {
        if pv.parType >= 0 {
          const annV = monoDeclAnnName(
            pv.parType,
            tyNameOf(pv.parType),
            fn.fnTyParams,
          )
          if monoAnnHasTyParam(annV, fn.fnTyParams) {
            const sub = monoSubstAnn(annV, fn.fnTyParams, tvN, tvV)
            if sub == "" { return 0 }
            if normTypeAtom(sub) != normTypeAtom(pinnedNames[v]) { return 0 }
          }
        }
      }
      v = v + 1
    }
    if monoInstanceExactRet {
      if fn.fnRet < 0 || monoInstanceRetName == "" { return 0 }
      let rs = monoDeclAnnName(fn.fnRet, tyNameOf(fn.fnRet), fn.fnTyParams)
      if monoAnnHasTyParam(rs, fn.fnTyParams) {
        rs = monoSubstAnn(rs, fn.fnTyParams, tvN, tvV)
      }
      if normTypeAtom(rs) != monoInstanceRetName { return 0 }
    }
    // A type parameter the boundary binds nothing defaults as at an inferred call, so the
    // binding's instance is the direct call's.
    monoDefaultUnboundTyParams(fn.fnTyParams, params, tvN, tvV, fn.fnBody)
    const pinned: string[] = []
    // No argument node on this path: the pins are the parameter types of the function type the
    // checker recorded for the value, where it has one, so an exact instance keys on them (D2755).
    const pinTys: i32[] = []
    let vty = monoFnValueParamTys(nodeTyIxOf(letInitIx), pinnedNames.length)
    if vty.length == 0 { vty = monoFnValueParamTys(expTy, pinnedNames.length) }
    let j = 0
    while j < pinnedNames.length {
      pinned.push(pinnedNames[j])
      if j < vty.length { pinTys.push(vty[j]) } else { pinTys.push(-1) }
      j = j + 1
    }
    // The annotation-driven binding path (`const c: (f64,f64)=>f64 = add`) bakes no callback — the
    // value escapes its call sites, so its body keeps the `call_ref`. Empty → no key/body change.
    const noCb: string[] = []
    const pinKinds: i32[] = []
    const pinPays: string[] = []
    monoBuildPinCol(pinned, pinKinds, pinPays)
    return monoMakeInstance(
      origFe,
      pinned,
      pinKinds,
      pinPays,
      pinTys,
      tvN,
      tvV,
      letInitIx,
      true,
      noCb,
    )
  }
  0
}

// Coerces `v`, the element or field at slot `path` of literal `lit`, at the one signature the
// flow table pins that slot at in frame `ctx`; a nested literal reads its own slots instead.
function monoCoerceLitPart(v: i32, lit: i32, path: string[], ctx: i32) {
  const nm = monoSlotPinName(lit, path, ctx)
  if nm == "" && !monoFlowIsLit(unwrapParen(v)) { return 0 }
  monoCoerceFnValueName(v, nm, ctx, -1)
}

// The `fnStmts` slot of the function an `Ident` names — the one resolver every question
// this pass asks about a named function goes through. `fnIndexOfInScope` is the language's
// innermost-scope rule for a name a `FuncDecl` carries; `identClosureFeSid` covers an
// arrow lambda, which parses to a nameless `FuncDecl` and carries its name on the binding.
function monoFnFeOfIdent(identIx: i32, name: string, ctx: i32) {
  const fe = fnIndexOfInScopeAt(sidOfNode(identIx), name, ctx, identIx)
  if fe >= 0 { return fe }
  identClosureFeAt(sidOfNode(identIx), ctx, identIx)
}

// Coerce a generic function value (or a composite of them) flowing into the expected type
// named by `tname`: materialize the instance for an `Ident` naming a generic. A list or
// record literal ignores `tname`: each element or field value takes the flow table's pin
// for its own slot. The checker has already proved the instantiation valid; this emits it.
function monoCoerceFnValueName(
  exprIx: i32,
  tname: string,
  ctx: i32,
  expTy: i32,
) {
  if exprIx < 0 { return 0 }
  const e = P.nodes[exprIx]
  if e is ObjLit {
    for fx in e.objFields {
      const f = P.nodes[fx]
      if f is FieldInit {
        const path: string[] = ["f." + f.fiName]
        if monoCoerceLitPart(f.fiValue, exprIx, path, ctx) < 0 { return -1 }
      }
    }
    return 0
  }
  if e is ArrayLit {
    for x in e.arrElems {
      const path: string[] = ["e"]
      if monoCoerceLitPart(x, exprIx, path, ctx) < 0 { return -1 }
    }
    return 0
  }
  if e is Paren { return monoCoerceFnValueName(e.parInner, tname, ctx, expTy) }
  // A read through a written `let`'s capture cell is read as that `let` (D3939).
  if e is Index {
    const cn = monoCellReadName(exprIx)
    if cn != "" { monoCoerceWrittenCell(exprIx, ctx, tname) }
    return 0
  }
  if e is IfStmt {
    // An if-expression in value position. The expected type reaches every arm unchanged —
    // each arm independently produces the whole value — so the recursion is per-arm, not
    // per-element as it is for the composite literals. A `match` needs no limb: the checker
    // lowers an exhaustive one to an if/else chain in place.
    if monoCoerceFnValueName(e.ifThen, tname, ctx, expTy) < 0 { return -1 }
    return monoCoerceFnValueName(e.ifElse, tname, ctx, expTy)
  }
  if e is Block {
    // An arm's VALUE is its LAST statement, so that is the only position the expected type reaches.
    const bs = e.blkStmts
    if bs.length == 0 { return 0 }
    return monoCoerceFnValueName(bs[bs.length - 1], tname, ctx, expTy)
  }
  if e is Ident {
    // A bare function name, or a value binding holding a generic function (`const add =
    // (a,b) => a + b`, or `const g = named`) — resolve the binding to its lifted slot so an
    // escaping lambda binding materializes at the boundary type too.
    // A reassigned `let` is read as itself: the generic functions written into it take this type.
    if monoCoerceWrittenLetValues(exprIx, ctx, tname) { return 0 }
    // An alias of a capture cell's read delivers that cell (D3948).
    if monoCoerceAliasOfCell(exprIx, ctx, tname) { return 0 }
    let gfe = monoFnFeOfIdent(exprIx, e.identName, ctx)
    // A chain of never-written aliases of a generic delivers that generic (D3894, D3902).
    if gfe < 0 { gfe = monoReadGenFnFe(exprIx) }
    // An alias a call renamed to one instance of a generic still delivers the generic (D3905).
    if (
      gfe >= 0
      && gfe < fnInstOrigin.length
      && fnInstOrigin[gfe] >= 0
      && e.identName != monoSlotName(gfe)
    ) {
      const go = fnInstOrigin[gfe]
      if go < monoGen.length && monoGen[go] == 1 { gfe = go }
    }
    if gfe >= 0 && gfe < monoGen.length {
      if monoGen[gfe] == 1 {
        const pnames: string[] = []
        // A nullable function slot (`((t: T) => void) | null`) takes the function's instance (D3932).
        if (
          monoFnTypeAnnParamsName(peelGroupParens(nonNulBaseOf(tname)), pnames)
        ) {
          // A capturing nested generic's value is this frame's instance, as a call is (D3902).
          monoCallFrameSlot = monoNestedCallFrame(gfe, ctx)
          monoInstanceRetName = ""
          if monoInstanceExactRet {
            monoInstanceRetName = normTypeAtom(
              annRetNameOf(peelGroupParens(tname)),
            )
          }
          const vr = monoInstanceFor(gfe, pnames, exprIx, expTy)
          monoCallFrameSlot = -1
          return vr
        }
      }
    }
  }
  0
}

// Set while `monoCallWrittenLet` instances a binding's seed only to read the call's signature:
// the binding's one signature is checked there, per binding.
let monoWrittenLetSigCall = false

// For the read at `at` in frame `ctx`: `[frame, declaration]` of the written, un-annotated `let`
// it names when every value of it names a declared generic, which each take their own instance;
// `[-1, -1]` otherwise. A lambda written in is one body, shared across the enclosing instances,
// so it keeps its own path.
function monoWrittenGenLetFrame(at: i32, ctx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1]
  if !(P.nodes[at] is Ident) { return none }
  if monoWritesOf("n:", identDeclOf(at)).length == 0 { return none }
  const lf = monoReadLetFrame(at, ctx)
  if lf[1] < 0 { return none }
  const d = P.nodes[lf[1]]
  if !(d is LetDecl) || d.letType >= 0 || d.letKw != "let" { return none }
  if !monoLetWrittenIn(lf) { return none }
  if d.letInit < 0 { return none }
  // An `if` seed is each of its arms, the first of which seeds the binding's signature.
  if (
    !monoNamesDeclaredGeneric(d.letInit, lf[0])
    && !(P.nodes[unwrapParen(d.letInit)] is IfStmt
      && monoValueNamesGenerics(d.letInit, lf[0], 0)
      && monoLetSeedGenFe(d.letInit, lf[0]) >= 0)
  ) {
    return none
  }
  for w in monoWritesOf("n:", lf[1]) {
    const wn = P.nodes[w]
    if wn is BinExpr {
      if monoFrameHolds(lf[0], w) {
        let wf = monoTopFrameOf(w)
        if lf[0] >= 0 { wf = monoFrameOfNode(w, lf[0]) }
        if (
          !monoValueNamesGenerics(wn.binRight, wf, 0)
          && !monoNamesGenericInstance(wn.binRight, wf)
        ) {
          return none
        }
      }
    }
  }
  if monoGeneratedCellElem(d.letInit) >= 0 { return none }
  lf
}

// Whether value `v`, read in frame `ctx`, names a declared generic function, directly, through
// the checker's adapter lambda, or in every arm of an `if` expression that hands on a value: an
// arm ending in a call that never returns hands on none (D4013, D6990).
function monoValueNamesGenerics(v: i32, ctx: i32, depth: i32): boolean {
  if v < 0 || depth > MONO_ALIAS_CHAIN_MAX { return false }
  if monoNamesDeclaredGeneric(v, ctx) { return true }
  if monoNamesDeclaredGeneric(monoAdapterCallee(v), ctx) { return true }
  const x = unwrapParen(v)
  if x < 0 { return false }
  const n = P.nodes[x]
  if !(n is IfStmt) { return false }
  const tn = monoArmEndsNever(n.ifThen)
  const en = monoArmEndsNever(n.ifElse)
  if tn && en { return false }
  (tn || monoArmNamesGenerics(n.ifThen, ctx, depth + 1))
    && (en || monoArmNamesGenerics(n.ifElse, ctx, depth + 1))
}

// Whether `if` arm block `arm` ends in a call that never returns.
function monoArmEndsNever(arm: i32): boolean {
  if arm < 0 || arm >= P.nodes.length { return false }
  const b = P.nodes[arm]
  if !(b is Block) || b.blkStmts.length == 0 { return false }
  callIsNever(b.blkStmts[b.blkStmts.length - 1])
}

// Whether `if` arm `arm` (a block, or an `else if`) names declared generics in its value.
function monoArmNamesGenerics(arm: i32, ctx: i32, depth: i32): boolean {
  if arm < 0 { return false }
  const tv = ifArmValueExpr(arm)
  monoValueNamesGenerics(if tv >= 0 { tv } else { arm }, ctx, depth)
}

// The callee of `v` when it is the checker's adapter lambda `($fp0, …) => g($fp0, …)`, which a
// generic `g` written into a `let` becomes once the checker pins it; -1 otherwise.
function monoAdapterCallee(v: i32): i32 {
  const f = P.nodes[unwrapParen(v)]
  if !(f is FuncDecl) || f.fnParams.length == 0 { return -1 }
  const b = P.nodes[f.fnBody]
  if !(b is Block) || b.blkStmts.length != 1 { return -1 }
  const c = P.nodes[b.blkStmts[0]]
  if !(c is Call) || c.callArgs.length != f.fnParams.length { return -1 }
  let i = 0
  while i < f.fnParams.length {
    const p = P.nodes[f.fnParams[i]]
    if !(p is Param) || p.parName.slice(0, 3) != "$fp" { return -1 }
    if monoIdentNameOf(unwrapParen(c.callArgs[i])) != p.parName { return -1 }
    i = i + 1
  }
  c.callFn
}

// For call `ix` in frame `ctx` through an un-annotated binding of an `if` naming generic
// functions in every arm (`monoIfBindingOf`): instances each arm at the one signature the flow
// table pins the binding at, else at the one this call takes the first arm at (D6991).
function monoCallIfBound(ix: i32, ctx: i32): i32 {
  const n = P.nodes[ix]
  if !(n is Call) || n.callFn < 0 || !(P.nodes[n.callFn] is Ident) { return 0 }
  const lf = monoIfBindingOf(n.callFn, ctx)
  if lf[1] < 0 { return 0 }
  const d = P.nodes[lf[1]]
  if !(d is LetDecl) { return 0 }
  const iv = unwrapParen(d.letInit)
  const g0 = monoFirstArmGenName(iv, lf[0], 0)
  if g0 < 0 { return 0 }
  let ct = monoSlotPinName(lf[1], [], lf[0])
  if ct == "" {
    ct = monoSeedCallSig(
      monoFnFeOfIdent(g0, monoIdentNameOf(g0), lf[0]),
      ix,
      ctx,
    )
    if ct == "!" { return -1 }
    if ct == "" { return 0 }
  }
  if monoCoerceFnValueName(iv, ct, lf[0], -1) < 0 { return -1 }
  monoRetypeIfInit(d.letInit, g0, n.callFn, lf[0])
}

// For value `at` in frame `ctx` delivered past a return that is an `if` naming generic functions
// in every arm, or a read of an `if`-bound binding (`monoIfBindingOf`): instances each arm at the
// one signature the flow table pins the binding, or the first arm's read, at, and types each call
// taking that pin at it (D7001, D7011). No pin leaves the value to the emitter's refusal.
function monoIfBoundRetAtPin(at: i32, ctx: i32): i32 {
  if at < 0 { return 0 }
  const lf = monoIfBindingOf(at, ctx)
  let init = at
  if lf[1] >= 0 {
    const d = P.nodes[lf[1]]
    if !(d is LetDecl) { return 0 }
    init = d.letInit
  } else if !(P.nodes[at] is IfStmt) || !monoValueNamesGenerics(at, ctx, 0) {
    return 0
  }
  const iv = unwrapParen(init)
  const fr = if lf[1] >= 0 { lf[0] } else { ctx }
  const g0 = monoFirstArmGenName(iv, fr, 0)
  if g0 < 0 { return 0 }
  const key = if lf[1] >= 0 { lf[1] } else { g0 }
  const noPath: string[] = []
  const ct = monoSlotPinName(key, noPath, fr)
  if ct == "" { return monoAskRetCopies(fr, key, ctx) }
  if monoCoerceFnValueName(iv, ct, fr, -1) < 0 { return -1 }
  monoRetypeIfInit(init, g0, at, fr)
  monoRetypePinCalls(key, noPath)
}

// The frame and declaration `[fr, d]` of the binding read `rd` in frame `ctx` names, through a
// chain of copies, when each is un-annotated and never written and the last one's initializer is
// an `if` naming generic functions in every arm; `[-1, -1]` otherwise.
function monoIfBindingOf(rd: i32, ctx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1]
  if rd < 0 || !(P.nodes[rd] is Ident) { return none }
  let r = rd
  let lf = monoReadLetFrame(r, ctx)
  let hops = 0
  while lf[1] >= 0 && hops < MONO_ALIAS_CHAIN_MAX {
    const ld = P.nodes[lf[1]]
    if !(ld is LetDecl) || ld.letType >= 0 || ld.letInit < 0 { return none }
    if fnFlowDeclWritten(r) { return none }
    if !(P.nodes[ld.letInit] is Ident) { break }
    r = ld.letInit
    lf = monoReadLetFrame(r, lf[0])
    hops = hops + 1
  }
  if lf[1] < 0 { return none }
  const d = P.nodes[lf[1]]
  if !(d is LetDecl) || d.letType >= 0 || d.letInit < 0 { return none }
  const iv = unwrapParen(d.letInit)
  if iv < 0 || !(P.nodes[iv] is IfStmt) { return none }
  if !monoValueNamesGenerics(iv, lf[0], 0) { return none }
  lf
}

// For call `n` (node `ix`, in frame `ctx`) of an `if` naming generic functions in every arm:
// instances each arm at the type this call takes the first arm at, as a call through a binding
// of it does.
function monoCallIfValue(n: Call, ix: i32, ctx: i32): i32 {
  const iv = unwrapParen(n.callFn)
  if iv < 0 || !(P.nodes[iv] is IfStmt) { return 0 }
  if !monoValueNamesGenerics(iv, ctx, 0) { return 0 }
  const g0 = monoFirstArmGenName(iv, ctx, 0)
  if g0 < 0 { return 0 }
  const ct = monoSeedCallSig(
    monoFnFeOfIdent(g0, monoIdentNameOf(g0), ctx),
    ix,
    ctx,
  )
  if ct == "!" { return -1 }
  if ct == "" { return 0 }
  if monoCoerceFnValueName(iv, ct, ctx, -1) < 0 { return -1 }
  monoRetypeIfInit(n.callFn, g0, n.callFn, ctx)
}

// The function type call `ix` in frame `ctx` takes an instance of seed `g` at, the call never
// renamed to it; "" when it takes none, and "!" once a refusal is recorded.
function monoSeedCallSig(g: i32, ix: i32, ctx: i32): string {
  const n = P.nodes[ix]
  if g < 0 || !(n is Call) { return "" }
  monoNoRename.push(n.callFn)
  monoLastInstFe = -1
  monoWrittenLetSigCall = true
  const ir = monoInstantiate(g, ix, ctx)
  monoWrittenLetSigCall = false
  if ir < 0 { return "!" }
  if monoLastInstFe < 0 { return "" }
  monoSigFnTyName(monoSlotSig(monoLastInstFe))
}

// Records on the `if` initializer `init` of a binding, and on its read `at`, the concrete type
// of the instance its first arm's name `g0` (`monoFirstArmGenName`) now names in frame `ctx`,
// where the checker left either open.
function monoRetypeIfInit(init: i32, g0: i32, at: i32, ctx: i32): i32 {
  if g0 < 0 { return 0 }
  const inst = monoFnFeOfIdent(g0, monoIdentNameOf(g0), ctx)
  if inst < 0 || inst >= fnStmts.length { return 0 }
  const it = monoPinSubTyOf(nodeTyIxOf(g0), fnStmts[inst])
  if !monoTyConcreteFn(it) { return 0 }
  const iv = unwrapParen(init)
  if iv >= 0 { nodeTyRecord(iv, it) }
  nodeTyRecord(init, it)
  const rt = nodeTyIxOf(at)
  if rt < 0 || tyHasTyVar(rt) { nodeTyRecord(at, it) }
  0
}

// The name node of the declared generic the first arm of value `v` names, through nested `if`
// arms and the checker's adapter lambda; -1 when it names none.
function monoFirstArmGenName(v: i32, ctx: i32, depth: i32): i32 {
  const x = unwrapParen(v)
  if x < 0 || depth > MONO_ALIAS_CHAIN_MAX { return -1 }
  const n = P.nodes[x]
  if n is IfStmt {
    const tv = ifArmValueExpr(n.ifThen)
    return monoFirstArmGenName(
      if tv >= 0 { tv } else { n.ifThen },
      ctx,
      depth + 1,
    )
  }
  let g = x
  if !monoNamesDeclaredGeneric(g, ctx) { g = unwrapParen(monoAdapterCallee(x)) }
  if g < 0 || !monoNamesDeclaredGeneric(g, ctx) { return -1 }
  g
}

// For call `ix` in frame `ctx` through a written, un-annotated `let`: coerces the generic
// functions its initializer and writes name at the one signature the flow table pins the binding
// at, else at the instance this call takes; -1 when another call takes another type (refused).
function monoCallWrittenLet(ix: i32, ctx: i32): i32 {
  const n = P.nodes[ix]
  if !(n is Call) { return 0 }
  const lf = monoWrittenGenLetFrame(n.callFn, ctx)
  if lf[1] < 0 { return 0 }
  const d = P.nodes[lf[1]]
  if !(d is LetDecl) { return 0 }
  const g0 = monoFirstArmGenName(d.letInit, lf[0], 0)
  let ct = monoSlotPinName(lf[1], [], lf[0])
  // With no single pin the call takes the instance its arguments make of the seed; the call is
  // never renamed to it, since a write may have replaced the value.
  if ct == "" {
    ct = monoSeedCallSig(monoLetSeedGenFe(d.letInit, lf[0]), ix, ctx)
    if ct == "!" { return -1 }
    if ct == "" { return 0 }
  }
  const prev = monoSigCallRet
  monoSigCallRet = nodeTyIxOf(ix)
  monoCellSigByCall = true
  monoCoerceWrittenLetValues(n.callFn, ctx, ct)
  monoCellSigByCall = false
  monoSigCallRet = prev
  // An `if` seed leaves the binding's type open, as a name seed does not.
  if P.nodes[unwrapParen(d.letInit)] is IfStmt {
    monoRetypeIfInit(d.letInit, g0, n.callFn, lf[0])
  }
  0
}

// The `let` bindings being coerced, so a cycle of copies ends.
const monoWrittenLetBusy: i32[] = []

// For the capture cell read at `at` (`d[0]`) that a captured, written `let` becomes: its seed
// and each live `d[0] = v` take function type `tname`, the cell is retyped to the instance, and
// answers true (D3939). An annotated cell is taken only when its annotation names a type
// parameter, whose writes every instance shares deliver at that instance's type (D3957).
function monoCoerceWrittenCell(at: i32, ctx: i32, tname: string): boolean {
  if annArrowAt(tname) < 1 { return false }
  const lf = monoCoercibleLet(at, ctx)
  if lf[1] < 0 { return false }
  const d = P.nodes[lf[1]]
  if !(d is LetDecl) { return false }
  if d.letType >= 0 && !monoCellTyIsOpen(lf[1]) { return false }
  monoCellSigByCall = false
  const seed = monoGeneratedCellElem(d.letInit)
  if seed < 0 { return false }
  const name = d.letName
  monoWrittenLetBusy.push(lf[1])
  monoLastInstFe = -1
  const took = monoCellValueTake(seed, tname, lf[0])
  if took == 1 { monoBindSigFail(name, lf[1]) }
  if took == 2 { monoCellValueFail(name) }
  if monoLastInstFe >= 0 && monoLastInstFe < fnStmts.length {
    const it = monoPinSubTyOf(
      monoCellElemTyOf(d.letInit, seed),
      fnStmts[monoLastInstFe],
    )
    if monoTyConcreteFn(it) {
      monoRetypeCell(lf[1], seed, it, monoCellReadsIn(lf[0], lf[1]))
    }
  }
  for i in monoWritesOf("c:", lf[1]) {
    const nd = P.nodes[i]
    const wf = monoLetWriteFrame(lf, i)
    if nd is BinExpr && wf.length == 1 {
      const wt = monoCellValueTake(nd.binRight, tname, wf[0])
      if wt == 1 {
        if wf[0] == lf[0] || !monoFrameIsGenericInstance(lf[0]) {
          monoBindSigFail(name, lf[1])
        } else {
          monoCellWriterSigFail(name)
        }
      } else if wt == 2 {
        monoCellValueFail(name)
      }
    }
  }
  monoWrittenLetBusy.pop()
  true
}

// The declared generic function the capture cell read at `at` (`d[0]`) is seeded with by name, as
// a slot; -1 for any other seed.
function monoCellSeedGenFe(at: i32, ctx: i32): i32 {
  const lf = monoReadLetFrame(at, ctx)
  if lf[1] < 0 { return -1 }
  const d = P.nodes[lf[1]]
  if !(d is LetDecl) || d.letType >= 0 || d.letKw != "let" { return -1 }
  const cel = monoGeneratedCellElem(d.letInit)
  if cel < 0 { return -1 }
  const seed = unwrapParen(cel)
  if seed < 0 { return -1 }
  const sn = P.nodes[seed]
  if !(sn is Ident) { return -1 }
  let fe = monoFnFeOfIdent(seed, sn.identName, lf[0])
  // A seed an earlier call renamed to one instance is still the generic's.
  if fe >= 0 && fe < fnInstOrigin.length && fnInstOrigin[fe] >= 0 {
    fe = fnInstOrigin[fe]
  }
  if (
    fe < 0
    || fe >= monoGen.length
    || monoGen[fe] != 1
    || criFnIsAnonLambda(fe)
  ) {
    return -1
  }
  fe
}

// The hole lambda the capture cell read at `at` (`d[0]`) is seeded with, as a slot; -1 for any
// other seed. Read off the seed itself, since the binding's writes make its alias chain decline.
function monoCellSeedLamFe(at: i32, ctx: i32): i32 {
  const lf = monoReadLetFrame(at, ctx)
  if lf[1] < 0 { return -1 }
  const d = P.nodes[lf[1]]
  if !(d is LetDecl) || d.letType >= 0 || d.letKw != "let" { return -1 }
  const cel = monoGeneratedCellElem(d.letInit)
  if cel < 0 { return -1 }
  const seed = unwrapParen(cel)
  if seed < 0 { return -1 }
  const fe = monoLamValueFe(seed, lf[0])
  if fe < 0 || fe >= monoGen.length || monoGen[fe] != 1 { return -1 }
  fe
}

// Whether the capture cell read at `at` (`d[0]`) is seeded with a lambda literal, whose call
// arguments rather than the callee's recorded type give its signature; a lambda reached by name
// is instanced per use instead.
function monoCellSeedIsLamLit(at: i32, ctx: i32): boolean {
  const lf = monoReadLetFrame(at, ctx)
  if lf[1] < 0 { return false }
  const d = P.nodes[lf[1]]
  if !(d is LetDecl) { return false }
  const cel = monoGeneratedCellElem(d.letInit)
  if cel < 0 { return false }
  const seed = unwrapParen(cel)
  seed >= 0 && P.nodes[seed] is FuncDecl
}

// A function type spelling whose parameters are the pins of signature `sig` (`p1,p2,;`), returning
// `void` where no return is known. "" for an empty signature.
function monoSigFnTyName(sig: string): string {
  monoSigFnTyNameRet(sig, "void")
}

// `monoSigFnTyName` returning `ret`, for an exact-return instance (`monoInstanceExactRet`).
function monoSigFnTyNameRet(sig: string, ret: string): string {
  if sig == "" { return "" }
  let out = "("
  let first = true
  for pn in monoSigPins(sig) {
    if !first { out = out + "," }
    out = out + pn
    first = false
  }
  out + ")=>" + ret
}

// `monoSigFnTyNameRet` with each function-value pin (`=>k`, which names only a wasm signature)
// spelled as function type `fty`'s parameter at its position, so the spelling parses as a type;
// the result is `fty`'s.
function monoSigFnTyNameAt(sig: string, fty: TyFunc): string {
  const pins = monoSigPins(sig)
  const ps = fty.fnParamTypes
  // The rendered result, then each function-value pin's parameter type, through one render.
  const names: string[] = []
  let k = -1
  while k < ps.length {
    let s = ""
    if k < 0 || (pins.length == ps.length && monoPinIsFnSig(pins[k])) {
      s = tyToEmitName(if k < 0 { fty.fnRet } else { ps[k] })
    }
    names.push(s)
    k = k + 1
  }
  if pins.length != ps.length { return monoSigFnTyNameRet(sig, names[0]) }
  let out = "("
  k = 0
  while k < pins.length {
    if k > 0 { out = out + "," }
    let pn = pins[k]
    if names[k + 1] != "" { pn = "(" + names[k + 1] + ")" }
    out = out + pn
    k = k + 1
  }
  out + ")=>" + names[0]
}

// Whether pin `pn` is a function value's, which names only a wasm signature (`=>k`).
function monoPinIsFnSig(pn: string): boolean {
  pn.length >= 2 && pn.slice(0, 2) == "=>"
}

// For a name read at `at` in frame `ctx` that a chain of un-annotated aliases never written
// after their initializer ends at a capture cell's read (`const r = k[0]`): coerces that cell at
// `tname` as `monoCoerceWrittenCell` does, and answers true when it finds one.
function monoCoerceAliasOfCell(at: i32, ctx: i32, tname: string): boolean {
  if annArrowAt(tname) < 1 { return false }
  const ar = monoAliasCellRead(at, ctx)
  if ar[0] < 0 { return false }
  monoCoerceWrittenCell(ar[0], ar[1], tname)
}

// Whether node `v`, read in frame `ctx`, is a name `monoAliasCellRead` resolves to a cell.
function monoNamesCellAlias(v: i32, ctx: i32): boolean {
  const x = unwrapParen(v)
  if x < 0 { return false }
  const cn = monoCellReadName(x)
  if cn != "" { return monoReadsGeneratedCell(x, ctx) }
  P.nodes[x] is Ident && monoAliasCellRead(x, ctx)[0] >= 0
}

// The list literal a `const` initializes, walked while its reads are all element calls.
let monoCellAliasListOk = 0 - 1

// Whether node `v` is a program's list literal holding an alias of a capture cell's read.
function monoListInitHoldsCellAlias(v: i32, ctx: i32): boolean {
  if v < 0 { return false }
  const lit = P.nodes[v]
  if !(lit is ArrayLit) || lit.pos < 0 || !monoListMayHoldFn(v) { return false }
  for e in lit.arrElems {
    if monoNamesCellAlias(e, ctx) { return true }
  }
  false
}

// Whether the list literal at `v` may hold a function at this instance: its type is open or
// names one. A list of a closed non-function type holds no binding a call could follow.
function monoListMayHoldFn(v: i32): boolean {
  const t = nodeTyIxOf(v)
  t < 0 || tyHasTyVar(t) || tyMayHoldFn(t, 0)
}

// The element a literal index spelled `text` names in a list of `len` elements, by value in any
// base the lexer keeps (`0`, `00`, `0x0`); -1 for a fraction, an exponent, or out of range.
function monoListLitIndex(text: string, len: i32): i32 {
  if text.length == 0 || text.length > 12 { return -1 }
  const hex = text.length > 1 && (text[1] == "x"[0] || text[1] == "X"[0])
  for ch in text {
    if ch == "."[0] || ch == "-"[0] { return -1 }
    if !hex && (ch == "e"[0] || ch == "E"[0]) { return -1 }
  }
  const v = parseI32(text)
  if v < 0 || v >= len { return -1 }
  v
}

// The element count of the list literal at node `v`; -1 for any other node.
function monoListLitLength(v: i32): i32 {
  if v < 0 { return -1 }
  const lit = P.nodes[v]
  if lit is ArrayLit { return lit.arrElems.length }
  -1
}

// Whether the read `ix` under frame `fx` (-1 for the module) is of the binding declared at
// `decl`.
function monoReadIsBinding(ix: i32, fx: i32, decl: i32): boolean {
  let fr = monoTopFrameOf(ix)
  if fx >= 0 { fr = monoFrameOfNode(ix, fx) }
  monoReadLetFrame(ix, fr)[1] == decl
}

// Whether every read in frame `fx`'s body of the list `name` declared at `decl`, of `len`
// elements, is the callee of a call of one element at a literal index that names one, or the
// target of an element write.
function monoListOnlyCalled(
  fx: i32,
  name: string,
  decl: i32,
  len: i32,
): boolean {
  const stack: i32[] = []
  const called: i32[] = []
  if fx >= 0 {
    const b = monoNestedBodyOf(fx)
    if b < 0 { return false }
    stack.push(b)
  } else {
    for st in monoProgStmts { stack.push(st) }
  }
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      const n = P.nodes[ix]
      if n is Call {
        const c = P.nodes[n.callFn]
        if c is Index {
          const a = P.nodes[c.idxArr]
          const k = P.nodes[c.idxIndex]
          if a is Ident && k is NumLit {
            if a.identName == name && monoListLitIndex(k.numText, len) >= 0 {
              called.push(c.idxArr)
            }
          }
        }
      }
      // An element write is typed at the list's element type, which the pin gives it.
      if n is BinExpr {
        if n.binOp == "=" {
          const wl = P.nodes[n.binLeft]
          if wl is Index {
            const wa = P.nodes[wl.idxArr]
            if wa is Ident {
              if wa.identName == name { called.push(wl.idxArr) }
            }
          }
        }
      }
      if n is Ident {
        if (
          n.identName == name
          && !i32ListHas(called, ix)
          && monoReadIsBinding(ix, fx, decl)
        ) {
          return false
        }
      }
      const body = monoNestedBodyOf(ix)
      if body >= 0 { stack.push(body) }
      for ch in nodeChildren(ix) { stack.push(ch) }
    }
  }
  true
}

// For a callee `fs[k]` whose list `fs` a `const` initializes with a literal whose element `k`
// is an alias of a capture cell's read: that read as `[read, frame]`; `[-1, -1]` otherwise.
function monoListElemCellRead(callee: i32, ctx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1]
  const el = monoListElemOf(callee, ctx)
  if el[0] < 0 { return none }
  const e = el[0]
  // The cell itself placed in the list (`[k]`) is its own read (D3977).
  const cn = monoCellReadName(e)
  if cn != "" {
    if !monoReadsGeneratedCell(e, el[1]) { return none }
    const out: i32[] = [e, el[1]]
    return out
  }
  if !(P.nodes[e] is Ident) { return none }
  monoAliasCellRead(e, el[1])
}

// For a callee `fs[k]` whose list `fs` a `const` initializes with a literal: element `k` and the
// list's frame, as `[element, frame]`; `[-1, -1]` for any other callee.
function monoListElemOf(callee: i32, ctx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1]
  const c = P.nodes[callee]
  if !(c is Index) { return none }
  const a = P.nodes[c.idxArr]
  const k = P.nodes[c.idxIndex]
  if !(a is Ident) || !(k is NumLit) { return none }
  const lf = monoReadLetFrame(c.idxArr, ctx)
  if lf[1] < 0 { return none }
  const d = P.nodes[lf[1]]
  if !(d is LetDecl) || d.letKw != "const" || d.letInit < 0 { return none }
  const lit = P.nodes[d.letInit]
  if !(lit is ArrayLit) || lit.pos < 0 { return none }
  const at = monoListLitIndex(k.numText, lit.arrElems.length)
  if at < 0 { return none }
  const out: i32[] = [unwrapParen(lit.arrElems[at]), lf[0]]
  out
}

// The hole lambda list element `e` names in frame `ctx` through never-written un-annotated
// bindings, as a slot; -1 for a literal, an annotated binding on the way, or anything else.
function monoListElemHoleLamFe(e: i32, ctx: i32): i32 {
  const x = unwrapParen(e)
  if x < 0 || monoIdentNameOf(x) == "" { return -1 }
  const fe = monoLamValueFe(x, ctx)
  if fe < 0 || fe >= monoGen.length || monoGen[fe] != 1 || !monoLamIsHole(fe) {
    return -1
  }
  if !monoWriteNamesLam(x, fe, ctx) { return -1 }
  fe
}

// The declared generic function list element `e` names in frame `ctx`, as a slot; -1 otherwise.
function monoListElemGenFe(e: i32, ctx: i32): i32 {
  const x = unwrapParen(e)
  if x < 0 { return -1 }
  const nm = monoIdentNameOf(x)
  if nm == "" { return -1 }
  // A written `let` holds its latest write, which no pin of the list can follow (D3978).
  const lf = monoReadLetFrame(x, ctx)
  if lf[1] >= 0 {
    const d = P.nodes[lf[1]]
    if d is LetDecl {
      if d.letKw != "const" && monoLetWrittenIn(lf) { return -1 }
    }
  }
  if monoNamesDeclaredGeneric(x, ctx) { return monoFnFeOfIdent(x, nm, ctx) }
  monoReadGenFnFe(x)
}

// The declared generic function seed `v` of a written `let` names in frame `ctx`, or the one its
// first `if` arm names, as a slot; -1 otherwise.
function monoLetSeedGenFe(v: i32, ctx: i32): i32 {
  const fe = monoListElemGenFe(v, ctx)
  if fe >= 0 { return fe }
  const x = unwrapParen(v)
  if x < 0 || !(P.nodes[x] is IfStmt) { return -1 }
  const g = monoFirstArmGenName(x, ctx, 0)
  if g < 0 { return -1 }
  monoFnFeOfIdent(g, monoIdentNameOf(g), ctx)
}

// ── reads of a literal slot that holds one generic ──────────────────────────────────────────
// A read of an element or field of an un-annotated `const` literal nothing mutates, whose slot
// the flow table says holds one generic and no write, is rewritten to that generic's name where
// the name is in scope, so each read takes its own instance (fn-value-flow-design.md §(f)).
let mfrParent: {[i32]: i32} = Map()
let mfrUses: {[i32]: i32[]} = Map()
let mfrNameCount: {[string]: i32} = Map()
let mfrGen: {[i32]: boolean} = Map()
let mfrCand: {[i32]: boolean} = Map()
let mfrVals: {[i32]: i32[]} = Map()
let mfrValsState: {[i32]: i32} = Map()
let mfrDirty: {[i32]: boolean} = Map()
let mfrAnnLits: {[i32]: i32[]} = Map()
let mfrAnnLets: i32[] = []
let mfrCalled: i32[] = []
let mfrKeptIndex: i32[] = []
let mfrKeptTop: i32[] = []

// Rewrites, in the program `stmts` and the bodies in `fnStmts`, every such read; -1 never.
function monoFlowReads(stmts: i32[]): i32 {
  mfrParent = Map()
  mfrUses = Map()
  mfrNameCount = Map()
  mfrGen = Map()
  mfrCand = Map()
  mfrVals = Map()
  mfrValsState = Map()
  mfrDirty = Map()
  mfrAnnLits = Map()
  mfrAnnLets = []
  mfrCalled = []
  mfrKeptIndex = []
  mfrKeptTop = []
  const lets: i32[] = []
  const direct: i32[] = []
  const seen: {[i32]: boolean} = Map()
  const roots: i32[] = []
  for s in stmts { roots.push(s) }
  for f in fnStmts { roots.push(f) }
  for root in roots {
    const stack: i32[] = [root]
    while stack.length > 0 {
      const ix = stack.pop()
      if ix >= 0 && ix < P.nodes.length && !(seen[ix] ?? false) {
        // arena-tick exempt: a side table of this pass, not the arena
        seen[ix] = true
        monoFlowReadsNote(ix, lets, direct)
        const kids = nodeChildren(ix)
        let k = kids.length - 1
        while k >= 0 {
          const ch = kids[k]
          if ch >= 0 {
            // arena-tick exempt: a side table of this pass, not the arena
            mfrParent[ch] = ix
            stack.push(ch)
          }
          k = k - 1
        }
      }
    }
  }
  monoFlowReadsAll(lets)
  for a in mfrAnnLets { monoFlowAnnLits(a) }
  for x in direct {
    const n = P.nodes[x]
    if n is Index {
      monoFlowDirectSet(
        x,
        unwrapParen(n.idxArr),
        monoFlowElemAt(unwrapParen(n.idxArr), n.idxIndex),
      )
    } else if n is Member {
      monoFlowDirectSet(
        x,
        unwrapParen(n.memObj),
        monoFlowFieldOf(unwrapParen(n.memObj), n.memProp),
      )
    }
  }
  0
}

// Banks for annotated binding `a` the literals its initializer may be: a call of a concrete
// function returning only literals, when every call of it initializes a binding annotated
// alike, so each literal is delivered at that one type and its generics can be pinned there.
function monoFlowAnnLits(a: i32) {
  const an = P.nodes[a]
  if !(an is LetDecl) || an.letType < 0 { return 0 }
  const c = unwrapParen(an.letInit)
  if c < 0 { return 0 }
  const cn = P.nodes[c]
  if !(cn is Call) { return 0 }
  const f = unwrapParen(cn.callFn)
  if f < 0 || !(P.nodes[f] is Ident) { return 0 }
  const fd = identDeclOf(f)
  if fd < 0 { return 0 }
  const fn = P.nodes[fd]
  if !(fn is FuncDecl) || fn.fnTyParams.length > 0 { return 0 }
  const want = tyNameOf(an.letType)
  for u in mfrUses[fd] ?? [] {
    const uc = mfrParent[u] ?? -1
    if uc < 0 { return 0 }
    const ucn = P.nodes[uc]
    if !(ucn is Call) || ucn.callFn != u { return 0 }
    let h = mfrParent[uc] ?? -1
    while h >= 0 && P.nodes[h] is Paren { h = mfrParent[h] ?? -1 }
    if h < 0 { return 0 }
    const hn = P.nodes[h]
    if !(hn is LetDecl) || hn.letType < 0 || tyNameOf(hn.letType) != want {
      return 0
    }
    if unwrapParen(hn.letInit) != uc { return 0 }
  }
  const vals = monoFlowDeclVals(fd)
  // arena-tick exempt: a side table of this pass, not the arena
  if vals.length > 0 { mfrAnnLits[a] = vals }
  0
}

// The literals `monoFlowAnnLits` banked for the annotated binding declared at `a`.
function monoFlowAnnLitsOf(a: i32): i32[] { mfrAnnLits[a] ?? [] }

// Rewrites read `x` of element or field `el` of literal `host` to the generic `el` names, when
// every element or field value of `host` is a name, so dropping the literal drops no effect.
function monoFlowDirectSet(x: i32, host: i32, el: i32) {
  const g = monoFlowLeafGen(el)
  if g < 0 || monoFlowIsWrite(x) { return 0 }
  const hn = P.nodes[host]
  if hn is ArrayLit {
    for e in hn.arrElems {
      if !(P.nodes[unwrapParen(e)] is Ident) { return 0 }
    }
  } else if hn is ObjLit {
    for fi in hn.objFields {
      const f = P.nodes[fi]
      if !(f is FieldInit) { return 0 }
      if !(P.nodes[unwrapParen(f.fiValue)] is Ident) { return 0 }
    }
  } else {
    return 0
  }
  monoFlowReadSet(x, g)
  0
}

// Whether `s` declares a named function whose value has no one signature: type parameters, or an
// un-annotated parameter (a hole function, D6603).
function monoFlowTyParamGen(s: i32): boolean {
  const fn = P.nodes[s]
  if !(fn is FuncDecl) || fn.fnName == "" { return false }
  fn.fnTyParams.length > 0 || monoFlowHasHoleParam(s)
}

// Whether function declaration `s` has an un-annotated parameter.
function monoFlowHasHoleParam(s: i32): boolean {
  const fn = P.nodes[s]
  if !(fn is FuncDecl) { return false }
  for pi in fn.fnParams {
    const p = P.nodes[pi]
    if p is Param {
      if p.parType < 0 { return true }
    }
  }
  false
}

// The un-annotated `const` holding hole lambda `v` as its whole initializer, when no other
// declaration shares its name; -1 otherwise (D6603).
function monoFlowLamLeaf(v: i32): i32 {
  const n = P.nodes[v]
  if !(n is FuncDecl) || !monoFlowHasHoleParam(v) { return -1 }
  let p = mfrParent[v] ?? -1
  while p >= 0 && P.nodes[p] is Paren { p = mfrParent[p] ?? -1 }
  if p < 0 { return -1 }
  const pd = P.nodes[p]
  if !(pd is LetDecl) || pd.letKw != "const" || pd.letType >= 0 { return -1 }
  if unwrapParen(pd.letInit) != v { return -1 }
  if (mfrNameCount[pd.letName] ?? 0) != 1 { return -1 }
  p
}

// The name a read rewritten to leaf `g` (`monoFlowLeafGen`) spells: a function's or a `const`'s.
function monoFlowLeafName(g: i32): string {
  const gd = P.nodes[g]
  if gd is FuncDecl { return gd.fnName }
  if gd is LetDecl { return gd.letName }
  emitFail("monoFlowLeafName: a flow leaf is a function or a `const` lambda")
  ""
}

// Banks node `ix` for `monoFlowReads`: a name read, a declared name, a candidate binding, a
// read straight out of a literal.
function monoFlowReadsNote(ix: i32, lets: i32[], direct: i32[]) {
  const n = P.nodes[ix]
  if n is Index {
    if P.nodes[unwrapParen(n.idxArr)] is ArrayLit { direct.push(ix) }
  } else if n is Member {
    if P.nodes[unwrapParen(n.memObj)] is ObjLit { direct.push(ix) }
  } else if n is Ident {
    const d = identDeclOf(ix)
    if d >= 0 {
      const us = mfrUses[d] ?? []
      us.push(ix)
      // arena-tick exempt: a side table of this pass, not the arena
      mfrUses[d] = us
    }
  } else if n is LetDecl {
    monoFlowReadsName(n.letName)
    if n.letType < 0 && n.letInit >= 0 {
      // arena-tick exempt: a side table of this pass, not the arena
      mfrCand[ix] = true
      lets.push(ix)
    } else if n.letInit >= 0 {
      mfrAnnLets.push(ix)
    }
  } else if n is FuncDecl {
    monoFlowReadsName(n.fnName)
    // arena-tick exempt: a side table of this pass, not the arena
    if monoFlowTyParamGen(ix) { mfrGen[ix] = true }
  } else if n is Param {
    monoFlowReadsName(n.parName)
    if n.parType < 0 && n.parDefault < 0 && n.parOpt == 0 && n.parRest == 0 {
      // arena-tick exempt: a side table of this pass, not the arena
      mfrCand[ix] = true
      lets.push(ix)
    }
  } else if n is ForIn {
    monoFlowReadsName(n.fiVar)
    monoFlowReadsName(n.fiVar2)
  }
  0
}

function monoFlowReadsName(nm: string) {
  // arena-tick exempt: a side table of this pass, not the arena
  if nm != "" { mfrNameCount[nm] = (mfrNameCount[nm] ?? 0) + 1 }
  0
}

// The generic function value node `v` names, as its declaration, when no other
// declaration shares its name, or when `v` is the checker's adapter lambda calling one; -1
// otherwise.
function monoFlowLeafGen(v: i32): i32 {
  if v < 0 { return -1 }
  const n = P.nodes[v]
  if n is FuncDecl {
    const cf = monoAdapterCallee(v)
    if cf < 0 { return monoFlowLamLeaf(v) }
    const c = unwrapParen(cf)
    if c < 0 || !(P.nodes[c] is Ident) { return -1 }
    return monoFlowLeafGen(c)
  }
  if !(n is Ident) { return -1 }
  // A chain of un-annotated `const` aliases names what its last initializer names (D5061).
  let r = v
  let hops = 0
  while hops <= MONO_ALIAS_CHAIN_MAX {
    const rn = P.nodes[r]
    if !(rn is Ident) { return -1 }
    const g = identDeclOf(r)
    if g < 0 { return -1 }
    const ad = P.nodes[g]
    if !(ad is LetDecl) {
      if !(mfrGen[g] ?? false) { return -1 }
      if (mfrNameCount[rn.identName] ?? 0) != 1 { return -1 }
      return g
    }
    if ad.letKw != "const" || ad.letType >= 0 || ad.letInit < 0 { return -1 }
    r = unwrapParen(ad.letInit)
    if r < 0 { return -1 }
    if P.nodes[r] is FuncDecl { return monoFlowLamLeaf(r) }
    hops = hops + 1
  }
  -1
}

// Whether the slot at `path` of binding `d` holds generic `g` alone, unwritten: each source the
// flow table records is `g` or an adapter lambda calling it.
function monoFlowSrcIs(d: i32, path: string[], g: i32): boolean {
  const srcs = fnFlowDeclPathSrcs(d, path)
  if srcs.length == 0 { return false }
  for x in srcs {
    if x != g && monoFlowLeafGen(x) != g { return false }
  }
  true
}

// Whether generic `g` is among the sources of `d`'s slot at `path`.
function monoFlowSrcHas(d: i32, path: string[], g: i32): boolean {
  for x in fnFlowDeclPathSrcs(d, path) {
    if x == g || monoFlowLeafGen(x) == g { return true }
  }
  false
}

// Whether node `v` is a list or record literal.
function monoFlowIsLit(v: i32): boolean {
  if v < 0 { return false }
  const n = P.nodes[v]
  n is ArrayLit || n is ObjLit
}

// The right-hand side when name read `u` is the whole target of a plain `=`, -1 otherwise.
function monoFlowWholeWrite(u: i32): i32 {
  const p = mfrParent[u] ?? -1
  if p < 0 { return -1 }
  const pn = P.nodes[p]
  if pn is BinExpr {
    if pn.binOp == "=" && pn.binLeft == u { return pn.binRight }
  }
  -1
}

// Appends to `out` every literal value node `x` may evaluate to: a list or record literal, the
// values of a candidate binding it names, or a literal-index or field read of those; false when
// it may evaluate to anything else.
function monoFlowValsOf(x: i32, out: i32[]): boolean {
  if x < 0 { return false }
  const v = unwrapParen(x)
  if v < 0 { return false }
  const n = P.nodes[v]
  if n is ArrayLit {
    if n.pos < 0 { return false }
    out.push(v)
    return true
  }
  if n is ObjLit {
    out.push(v)
    return true
  }
  if n is Ident {
    const d = identDeclOf(v)
    if d < 0 || !(mfrCand[d] ?? false) { return false }
    const dv = monoFlowDeclVals(d)
    if dv.length == 0 { return false }
    for y in dv { out.push(y) }
    return true
  }
  if n is Call {
    const c = unwrapParen(n.callFn)
    if c < 0 || !(P.nodes[c] is Ident) { return false }
    const fd = identDeclOf(c)
    if fd < 0 { return false }
    const fn = P.nodes[fd]
    if !(fn is FuncDecl) || fn.fnTyParams.length > 0 { return false }
    const rv = monoFlowDeclVals(fd)
    if rv.length == 0 { return false }
    for y in rv { out.push(y) }
    return true
  }
  const base: i32[] = []
  if n is Index {
    if !monoFlowValsOf(n.idxArr, base) { return false }
    for b in base {
      const el = monoFlowElemAt(b, n.idxIndex)
      if !monoFlowIsLit(el) { return false }
      out.push(el)
    }
    return true
  }
  let obj = -1
  let prop = ""
  if n is Member {
    obj = n.memObj
    prop = n.memProp
  } else if n is OptMember {
    obj = n.omObj
    prop = n.omProp
  } else {
    return false
  }
  if !monoFlowValsOf(obj, base) { return false }
  for b in base {
    const fv = monoFlowFieldOf(b, prop)
    if !monoFlowIsLit(fv) { return false }
    out.push(fv)
  }
  true
}

// The literals candidate binding `d` may hold, from its initializer and every whole `=` to it,
// or that function `d` returns; empty when it may be anything else or depends on itself.
function monoFlowDeclVals(d: i32): i32[] {
  const st = mfrValsState[d] ?? 0
  if st == 2 { return mfrVals[d] ?? [] }
  if st != 0 { return [] }
  // arena-tick exempt: a side table of this pass, not the arena
  mfrValsState[d] = 1
  const out: i32[] = []
  const ok = monoFlowRetVals(d, out)
    || monoFlowLetVals(d, out)
    || monoFlowParamVals(d, out)
  if !ok {
    // arena-tick exempt: a side table of this pass, not the arena
    mfrValsState[d] = 3
    return []
  }
  // arena-tick exempt: a side table of this pass, not the arena
  mfrVals[d] = out
  // arena-tick exempt: a side table of this pass, not the arena
  mfrValsState[d] = 2
  out
}

// Appends to `out` the literals binding `d` holds, from its initializer and every whole `=` to
// it; false when `d` is no `let` or `const`, or any of them may be anything else.
function monoFlowLetVals(d: i32, out: i32[]): boolean {
  const dn = P.nodes[d]
  if !(dn is LetDecl) || !monoFlowValsOf(dn.letInit, out) { return false }
  for u in mfrUses[d] ?? [] {
    const w = monoFlowWholeWrite(u)
    if w >= 0 && !monoFlowValsOf(w, out) { return false }
  }
  true
}

// Appends to `out` the literals un-annotated parameter `d` holds, from the argument every call
// of its function passes there and every whole `=` to it; false when the function is reached
// other than by a direct positional call this pass sees, or any of them may be anything else.
function monoFlowParamVals(d: i32, out: i32[]): boolean {
  if !(P.nodes[d] is Param) { return false }
  const fx = mfrParent[d] ?? -1
  if fx < 0 { return false }
  const fn = P.nodes[fx]
  if !(fn is FuncDecl) || fn.fnName == "" || monoNameIsExported(fn.fnName) {
    return false
  }
  let k = 0 - 1
  let i = 0
  while i < fn.fnParams.length {
    if fn.fnParams[i] == d { k = i }
    i = i + 1
  }
  // A `self` first parameter admits a method spelling, whose callee is no name read.
  const p0 = P.nodes[fn.fnParams[0]]
  if k < 0 || (p0 is Param && p0.parName == "self") { return false }
  const calls = mfrUses[fx] ?? []
  if calls.length == 0 { return false }
  for u in calls {
    const c = mfrParent[u] ?? -1
    if c < 0 { return false }
    const cn = P.nodes[c]
    if !(cn is Call) || cn.callFn != u || hasNamedArgs(cn.callArgNames) {
      return false
    }
    if cn.callArgs.length != fn.fnParams.length { return false }
    for a in cn.callArgs {
      if P.nodes[a] is Spread { return false }
    }
    if !monoFlowValsOf(cn.callArgs[k], out) { return false }
  }
  for u in mfrUses[d] ?? [] {
    const w = monoFlowWholeWrite(u)
    if w >= 0 && !monoFlowValsOf(w, out) { return false }
  }
  true
}

// Appends to `out` the literals function `d` returns, when every `return` in its body, outside
// nested functions, returns a list or record literal and its last statement is one of them or a
// literal; false otherwise.
function monoFlowRetVals(d: i32, out: i32[]): boolean {
  const dn = P.nodes[d]
  if !(dn is FuncDecl) { return false }
  const body = dn.fnBody
  if body < 0 { return false }
  const b = P.nodes[body]
  if !(b is Block) || b.blkStmts.length == 0 { return false }
  const last = unwrapParen(b.blkStmts[b.blkStmts.length - 1])
  if monoFlowIsLit(last) {
    if !monoFlowValsOf(last, out) { return false }
  } else if last < 0 || !(P.nodes[last] is RetStmt) {
    return false
  }
  const stack: i32[] = [body]
  while stack.length > 0 {
    const x = stack.pop()
    const xn = P.nodes[x]
    if xn is RetStmt {
      if xn.retArg < 0 { return false }
      const a = unwrapParen(xn.retArg)
      if !monoFlowIsLit(a) || !monoFlowValsOf(a, out) { return false }
    } else if !(xn is FuncDecl) {
      for k in nodeChildren(x) {
        if k >= 0 { stack.push(k) }
      }
    }
  }
  true
}

// The outermost literal whose tree holds literal `v`.
function monoFlowLitRoot(v: i32): i32 {
  let r = v
  let x = v
  let p = mfrParent[x] ?? -1
  while p >= 0 {
    const pn = P.nodes[p]
    if pn is ArrayLit || pn is ObjLit { r = p }
    else if !(pn is FieldInit || pn is Paren || pn is Spread) { break }
    x = p
    p = mfrParent[x] ?? -1
  }
  r
}

// Plans and applies the rewrites of every candidate binding in `lets`. A binding is rewritten
// only when each of its reads is planned and no binding sharing one of its literal trees
// declined, since a declined read may mutate a value the others read or let it escape.
function monoFlowReadsAll(lets: i32[]) {
  const hosts = monoFlowReadsRound(lets)
  if hosts.length == 0 { return 0 }
  // Each list a spread expanded into holds no spread now, so its holders are planned again.
  const again: i32[] = []
  for d in lets {
    let holds = false
    for v in mfrVals[d] ?? [] {
      const r = monoFlowLitRoot(v)
      for h in hosts {
        if h == r { holds = true }
      }
    }
    if holds { again.push(d) }
  }
  // arena-tick exempt: a side table of this pass, not the arena
  for h in hosts { mfrDirty[h] = false }
  monoFlowReadsRound(again)
  0
}

// One planning round of `monoFlowReadsAll` over `lets`; the roots of the list literals its
// spreads expand into.
function monoFlowReadsRound(lets: i32[]): i32[] {
  const pr: i32[] = []
  const pl: i32[] = []
  const ps: i32[] = []
  const planned: i32[] = []
  for d in lets {
    const vals = monoFlowDeclVals(d)
    if vals.length > 0 {
      const reads: i32[] = []
      const loops: i32[] = []
      const spreads: i32[] = []
      let ok = true
      for u in mfrUses[d] ?? [] {
        if ok && !monoFlowUsePlan(d, u, vals, reads, loops, spreads) {
          ok = false
        }
      }
      if ok {
        planned.push(d)
        monoFlowTagPairs(pr, d, reads)
        monoFlowTagPairs(pl, d, loops)
        monoFlowTagPairs(ps, d, spreads)
      } else {
        // arena-tick exempt: a side table of this pass, not the arena
        for v in vals { mfrDirty[monoFlowLitRoot(v)] = true }
      }
    }
  }
  // A binding some read, loop or spread of which keeps reading through the literal.
  const through: i32[] = []
  let i = 0
  while i < pr.length {
    if monoFlowDeclClean(pr[i]) && !monoFlowReadSet(pr[i + 1], pr[i + 2]) {
      through.push(pr[i])
    }
    i = i + 3
  }
  i = 0
  while i < pl.length {
    if monoFlowDeclClean(pl[i]) && !monoFlowLoopSet(pl[i + 1], pl[i + 2]) {
      through.push(pl[i])
    }
    i = i + 3
  }
  i = 0
  while i < ps.length {
    through.push(ps[i])
    i = i + 3
  }
  monoFlowNoteInert(planned, through)
  i = 0
  const hosts: i32[] = []
  while i < ps.length {
    if monoFlowDeclClean(ps[i]) {
      const h = monoFlowSpreadSet(ps[i + 1], ps[i + 2])
      if h >= 0 { hosts.push(monoFlowLitRoot(h)) }
    }
    i = i + 3
  }
  hosts
}

// Appends each pair of `pairs` to `out` as a triple led by binding `d`.
function monoFlowTagPairs(out: i32[], d: i32, pairs: i32[]) {
  let i = 0
  while i + 1 < pairs.length {
    out.push(d)
    out.push(pairs[i])
    out.push(pairs[i + 1])
    i = i + 2
  }
  0
}

// Whether every literal tree binding `d` may hold is clear of a decline by another binding.
function monoFlowDeclClean(d: i32): boolean {
  for v in mfrVals[d] ?? [] {
    if mfrDirty[monoFlowLitRoot(v)] ?? false { return false }
  }
  true
}

// The one generic every node in `vs` names: -1 when none names one, -2 when they disagree.
function monoFlowCommonGen(vs: i32[]): i32 {
  let g = -1
  let first = true
  for v in vs {
    const vg = monoFlowLeafGen(v)
    if !first && vg != g { return -2 }
    g = vg
    first = false
  }
  g
}

// Plans read `u` of binding `d`, which may hold any literal in `vals`, appending `[read, gen]`
// to `reads`, `[loop, gen]` to `loops` or `[spread, list]` to `spreads`; false for a read that
// may mutate the value, or let it escape where its slots are not read by name.
function monoFlowUsePlan(
  d: i32,
  u: i32,
  vals: i32[],
  reads: i32[],
  loops: i32[],
  spreads: i32[],
): boolean {
  if monoFlowWholeWrite(u) >= 0 { return true }
  let cur = u
  let cv: i32[] = vals
  const path: string[] = []
  let p = mfrParent[cur] ?? -1
  while p >= 0 {
    const pn = P.nodes[p]
    let prop = ""
    let isField = false
    if pn is Member {
      isField = pn.memObj == cur
      prop = pn.memProp
    } else if pn is OptMember {
      isField = pn.omObj == cur
      prop = pn.omProp
    }
    if pn is Paren {
      cur = p
    } else if pn is Index && pn.idxArr == cur {
      const next: i32[] = []
      for v in cv {
        let el = monoFlowElemAt(v, pn.idxIndex)
        if el < 0 { el = monoFlowKeptIndexElem(v, p) }
        if el < 0 { return false }
        next.push(el)
      }
      cv = next
      path.push("e")
      cur = p
    } else if isField {
      let lists = 0
      for v in cv {
        if P.nodes[v] is ArrayLit { lists = lists + 1 }
      }
      if lists > 0 {
        return lists == cv.length && prop == "length" && !monoFlowIsWrite(p)
      }
      const next: i32[] = []
      for v in cv {
        const fv = monoFlowFieldOf(v, prop)
        if fv < 0 { return false }
        next.push(fv)
      }
      cv = next
      path.push("f." + prop)
      cur = p
    } else {
      break
    }
    p = mfrParent[cur] ?? -1
  }
  let lits = 0
  for v in cv {
    if monoFlowIsLit(v) { lits = lits + 1 }
  }
  if lits > 0 {
    if lits != cv.length || p < 0 { return false }
    return monoFlowContainerUse(d, p, cur, cv, path, loops, spreads)
  }
  if monoFlowIsWrite(cur) { return false }
  const g = monoFlowCommonGen(cv)
  if g == -1 { return true }
  if g < 0 { return false }
  // A list's elements share one slot, so a literal-index read of it, unwritten, names its own
  // element even where another element names another generic (D6795).
  if path.length > 0 && path[path.length - 1] == "e" {
    if !monoFlowSrcHas(d, path, g) { return false }
  } else if !monoFlowSrcIs(d, path, g) {
    return false
  }
  reads.push(cur)
  reads.push(g)
  true
}

// Plans node `cur`, a read of binding `d` at `path` that may be any literal in `cv`, used by its
// parent `p`: a binding or whole `=` whose own reads are planned, a null test, a `for … in` over
// lists whose elements all name one generic, or a spread of one list literal.
function monoFlowContainerUse(
  d: i32,
  p: i32,
  cur: i32,
  cv: i32[],
  path: string[],
  loops: i32[],
  spreads: i32[],
): boolean {
  monoFlowAliasUse(p, cur)
    || monoFlowArgUse(p, cur)
    || monoFlowBinUse(p, cur)
    || monoFlowLoopUse(d, p, cur, cv, path, loops)
    || monoFlowSpreadUse(p, cv, spreads)
}

// Whether `p` is a candidate binding initialized by `cur` whose literals are known.
function monoFlowAliasUse(p: i32, cur: i32): boolean {
  const pn = P.nodes[p]
  if !(pn is LetDecl) { return false }
  pn.letInit == cur && (mfrCand[p] ?? false) && monoFlowDeclVals(p).length > 0
}

// Whether `p` calls a function passing `cur` to a candidate parameter whose literals are known.
function monoFlowArgUse(p: i32, cur: i32): boolean {
  const pn = P.nodes[p]
  if !(pn is Call) || pn.callFn == cur { return false }
  const c = unwrapParen(pn.callFn)
  if c < 0 || !(P.nodes[c] is Ident) { return false }
  const fd = identDeclOf(c)
  if fd < 0 { return false }
  const fn = P.nodes[fd]
  if !(fn is FuncDecl) { return false }
  let i = 0
  while i < pn.callArgs.length && i < fn.fnParams.length {
    if pn.callArgs[i] == cur {
      const d = fn.fnParams[i]
      return (mfrCand[d] ?? false) && monoFlowDeclVals(d).length > 0
    }
    i = i + 1
  }
  false
}

// Whether `p` writes `cur` whole into a candidate binding whose literals are known, or compares
// `cur` against `null`.
function monoFlowBinUse(p: i32, cur: i32): boolean {
  const pn = P.nodes[p]
  if !(pn is BinExpr) { return false }
  if pn.binOp == "=" && pn.binRight == cur {
    const l = unwrapParen(pn.binLeft)
    if l < 0 || !(P.nodes[l] is Ident) { return false }
    const ld = identDeclOf(l)
    return ld >= 0 && (mfrCand[ld] ?? false) && monoFlowDeclVals(ld).length > 0
  }
  if pn.binOp == "==" || pn.binOp == "!=" {
    const o = if pn.binLeft == cur { pn.binRight } else { pn.binLeft }
    return P.nodes[unwrapParen(o)] is NullLit
  }
  false
}

// Whether `p` is a `for … in` over `cur` whose lists in `cv` all hold one generic that the slot
// of `d` at `path` holds alone; appends `[loop, gen]` to `loops` when so.
function monoFlowLoopUse(
  d: i32,
  p: i32,
  cur: i32,
  cv: i32[],
  path: string[],
  loops: i32[],
): boolean {
  const pn = P.nodes[p]
  if !(pn is ForIn) { return false }
  if pn.fiIter != cur || pn.fiVar2 != "" { return false }
  let g = -1
  for v in cv {
    const vg = monoFlowElemsGen(v)
    if vg < 0 || (g >= 0 && vg != g) { return false }
    g = vg
  }
  const ep: string[] = []
  for k in path { ep.push(k) }
  ep.push("e")
  if !monoFlowSrcIs(d, ep, g) { return false }
  loops.push(p)
  loops.push(g)
  true
}

// Whether `p` spreads the one list literal in `cv`, each element naming a generic, into a list
// literal; appends `[spread, list]` to `spreads` when so.
function monoFlowSpreadUse(p: i32, cv: i32[], spreads: i32[]): boolean {
  if !(P.nodes[p] is Spread) || cv.length != 1 { return false }
  const host = mfrParent[p] ?? -1
  const vn = P.nodes[cv[0]]
  if host < 0 || !(P.nodes[host] is ArrayLit) || !(vn is ArrayLit) {
    return false
  }
  for e in vn.arrElems {
    if monoFlowLeafGen(unwrapParen(e)) < 0 { return false }
  }
  spreads.push(p)
  spreads.push(cv[0])
  true
}

// The element of list literal `v` the literal index `k` reads, -1 when `v` is no list literal
// free of spreads or `k` is not a literal index inside it.
function monoFlowElemAt(v: i32, k: i32): i32 {
  const ln = P.nodes[v]
  const kn = P.nodes[k]
  if !(ln is ArrayLit) || !(kn is NumLit) { return -1 }
  for e in ln.arrElems {
    if P.nodes[e] is Spread { return -1 }
  }
  const at = monoListLitIndex(kn.numText, ln.arrElems.length)
  if at < 0 { return -1 }
  unwrapParen(ln.arrElems[at])
}

// The value record literal `v` gives field `name`, -1 when `v` is no record literal free of
// spreads or holds no such field.
function monoFlowFieldOf(v: i32, name: string): i32 {
  const on = P.nodes[v]
  if !(on is ObjLit) { return -1 }
  let out = -1
  for fi in on.objFields {
    const f = P.nodes[fi]
    if f is FieldInit {
      if f.fiName == name { out = unwrapParen(f.fiValue) }
    } else {
      return -1
    }
  }
  out
}

// The one generic every element of list literal `v` names, -1 when they differ or any does not.
function monoFlowElemsGen(v: i32): i32 {
  const ln = P.nodes[v]
  if !(ln is ArrayLit) || ln.arrElems.length == 0 { return -1 }
  let g = -1
  for e in ln.arrElems {
    const eg = monoFlowLeafGen(unwrapParen(e))
    if eg < 0 || (g >= 0 && eg != g) { return -1 }
    g = eg
  }
  g
}

// Whether node `x` is the target of an assignment, plain or compound.
function monoFlowIsWrite(x: i32): boolean {
  const p = mfrParent[x] ?? -1
  if p < 0 { return false }
  const pn = P.nodes[p]
  if pn is BinExpr {
    if pn.binLeft != x { return false }
    const op = pn.binOp
    if op == "==" || op == "!=" || op == "<=" || op == ">=" { return false }
    return op.length > 0 && op.slice(op.length - 1, op.length) == "="
  }
  pn is Unary && (pn.unOp == "++" || pn.unOp == "--")
}

// Whether node `x` lies in the body of the function declaring generic `g`, or `g` is declared at
// module scope: where the name `g` declares is in scope.
function monoFlowInScope(x: i32, g: i32): boolean {
  let o = mfrParent[g] ?? -1
  while o >= 0 && !(P.nodes[o] is FuncDecl) { o = mfrParent[o] ?? -1 }
  if o < 0 { return true }
  let y = mfrParent[x] ?? -1
  while y >= 0 && y != o { y = mfrParent[y] ?? -1 }
  y == o
}

// The element of list literal `v` that computed-index read `ix` gives, when every element names
// one generic and `ix` is the callee of a call `monoFlowCallStmtOf` places, so a copy of the read
// can run first for its index and its bounds check (D7182); -1 otherwise.
function monoFlowKeptIndexElem(v: i32, ix: i32): i32 {
  if v < 0 || ix < 0 { return -1 }
  const xn = P.nodes[ix]
  if !(xn is Index) || P.nodes[unwrapParen(xn.idxIndex)] is NumLit { return -1 }
  const ln = P.nodes[v]
  if !(ln is ArrayLit) || monoFlowElemsGen(v) < 0 { return -1 }
  for e in ln.arrElems {
    if P.nodes[e] is Spread { return -1 }
  }
  if monoFlowCallStmtOf(ix) < 0 { return -1 }
  if !i32ListHas(mfrKeptIndex, ix) { mfrKeptIndex.push(ix) }
  unwrapParen(ln.arrElems[0])
}

// The statement holding the call whose callee is read `ix`, when nothing in that statement runs
// before the call but reads of names and literals, so a copy of the read can run as the
// statement before it (D7385); -1 otherwise. A block's or the start function's statement.
function monoFlowCallStmtOf(ix: i32): i32 {
  let c = mfrParent[ix] ?? -1
  while c >= 0 && P.nodes[c] is Paren { c = mfrParent[c] ?? -1 }
  if c < 0 { return -1 }
  const cn = P.nodes[c]
  if !(cn is Call) || unwrapParen(cn.callFn) != ix { return -1 }
  let x = c
  while monoFlowPosIn(monoFlowStmtListOf(x), x) < 0 {
    const p = mfrParent[x] ?? -1
    if p < 0 || !monoFlowRunsFirstIn(p, x) { return -1 }
    x = p
  }
  x
}

// Whether child `x` of node `p` is evaluated, every time `p` is, after only reads of names and
// literals among `p`'s other operands.
function monoFlowRunsFirstIn(p: i32, x: i32): boolean {
  const pn = P.nodes[p]
  if pn is Paren { return true }
  if pn is LetDecl { return pn.letInit == x }
  if pn is RetStmt { return pn.retArg == x }
  if pn is IfStmt { return pn.ifCond == x }
  if pn is Unary { return pn.unArg == x }
  if pn is BinExpr {
    if pn.binLeft == x { return true }
    const op = pn.binOp
    if op == "&&" || op == "||" || op == "??" { return false }
    return pn.binRight == x && monoFlowNameOrLit(pn.binLeft)
  }
  monoFlowArgRunsFirst(p, x)
}

// `monoFlowRunsFirstIn` for the one parent kind left, a call `p` with `x` among its arguments;
// false for every other parent, whose operands are not all known to run before `x`.
function monoFlowArgRunsFirst(p: i32, x: i32): boolean {
  const pn = P.nodes[p]
  if !(pn is Call) { return false }
  if hasNamedArgs(pn.callArgNames) || !monoFlowNameOrLit(pn.callFn) {
    return false
  }
  for a in pn.callArgs {
    if a == x { return true }
    if !monoFlowNameOrLit(a) { return false }
  }
  false
}

// Whether `e` is a name read or a literal, which no other evaluation can change or trap.
function monoFlowNameOrLit(e: i32): boolean {
  const u = unwrapParen(e)
  if u < 0 { return false }
  const n = P.nodes[u]
  n is Ident
    || n is NumLit
    || n is StrLit
    || n is CharLit
    || n is BoolLit
    || n is NullLit
}

// The statement list a statement `c` would sit in: its block's, or at module scope the start
// function's `startStmts`, whose ordinals are source positions, so the program's own list is
// left alone; empty when the parent is neither.
function monoFlowStmtListOf(c: i32): i32[] {
  const o = mfrParent[c] ?? -1
  if o < 0 { return startStmts }
  const on = P.nodes[o]
  if !(on is Block) { return [] }
  on.blkStmts
}

// The position of `c` in `xs`, or -1.
function monoFlowPosIn(xs: i32[], c: i32): i32 {
  let at = xs.length - 1
  while at >= 0 && xs[at] != c { at = at - 1 }
  at
}

// Runs a copy of computed-index read `x` as the statement before the one holding its call;
// false when `monoFlowCallStmtOf` finds none. A module-scope copy is walked from `mfrKeptTop`.
function monoFlowKeepIndex(x: i32): boolean {
  const c = monoFlowCallStmtOf(x)
  if c < 0 { return false }
  const xn = P.nodes[x]
  if !(xn is Index) { return false }
  const xs = monoFlowStmtListOf(c)
  const at = monoFlowPosIn(xs, c)
  if at < 0 { return false }
  const kept = mkIndex(xn.idxArr, xn.idxIndex, xn.pos)
  monoFlowInsertAt(xs, at, kept)
  if (mfrParent[c] ?? -1) < 0 {
    monoFlowInsertAt(startStmtOrd, at, startStmtOrd[at])
    mfrKeptTop.push(kept)
  }
  true
}

// Inserts `v` into `xs` in place at position `at`, which is in range.
function monoFlowInsertAt(xs: i32[], at: i32, v: i32) {
  xs.push(xs[xs.length - 1])
  let k = xs.length - 2
  while k > at {
    xs[k] = xs[k - 1]
    k = k - 1
  }
  xs[at] = v
  monoArenaTouch()
}

// Rewrites read node `x` in place to a name read of generic `g`, where that name is in scope;
// false when it is not.
function monoFlowReadSet(x: i32, g: i32): boolean {
  const nm = monoFlowLeafName(g)
  if nm == "" || !monoFlowInScope(x, g) { return false }
  if i32ListHas(mfrKeptIndex, x) && !monoFlowKeepIndex(x) { return false }
  const n: Node = { identName: nm, pos: nodePos(x) }
  if monoFlowCalledAt(x) && !i32ListHas(mfrCalled, g) { mfrCalled.push(g) }
  arenaSetNode(x, n)
  sidNoteNodeName(x, g)
  monoArenaTouch()
  true
}

// Notes as inert each name of a generic in the literals the clean bindings of `planned` hold,
// unless a binding in `through` holds the same literal tree: every read of the rest now names
// the generic itself, so no call reaches one of those names (D6661).
function monoFlowNoteInert(planned: i32[], through: i32[]) {
  const kept: i32[] = []
  for d in through {
    for v in mfrVals[d] ?? [] { kept.push(monoFlowLitRoot(v)) }
  }
  for d in planned {
    if monoFlowDeclClean(d) {
      for v in mfrVals[d] ?? [] {
        if !i32ListHas(kept, monoFlowLitRoot(v)) { monoFlowNoteInertIn(v, 0) }
      }
    }
  }
  0
}

// Whether read `u` is the callee of the call holding it.
function monoFlowCalledAt(u: i32): boolean {
  const c = mfrParent[u] ?? -1
  if c < 0 { return false }
  const cn = P.nodes[c]
  cn is Call && unwrapParen(cn.callFn) == u
}

// Whether generic `g` is called by name, as written or through a rewritten read: an uncalled
// one has only its default body, which need not be valid (D6660).
function monoFlowGenCalled(g: i32): boolean {
  if i32ListHas(mfrCalled, g) { return true }
  for u in mfrUses[g] ?? [] {
    if monoFlowCalledAt(u) { return true }
  }
  false
}

// Notes each element or field of a literal `v`, through nested literals, that names a called generic.
function monoFlowNoteInertIn(v: i32, depth: i32) {
  const x = unwrapParen(v)
  if x < 0 || depth > 8 { return 0 }
  const n = P.nodes[x]
  if n is ArrayLit {
    for e in n.arrElems { monoFlowNoteInertIn(e, depth + 1) }
    return 0
  }
  if n is ObjLit {
    for fi in n.objFields {
      const f = P.nodes[fi]
      if f is FieldInit { monoFlowNoteInertIn(f.fiValue, depth + 1) }
    }
    return 0
  }
  monoFlowNoteInertLeaf(x)
}

// Notes value `x` inert when it names a called generic; any other value is left as it is.
function monoFlowNoteInertLeaf(x: i32) {
  if !(P.nodes[x] is Ident) { return 0 }
  const g = monoFlowLeafGen(x)
  if g >= 0 && monoFlowGenCalled(g) && !i32ListHas(monoInertCalled, x) {
    if !i32ListHas(monoInertValues, x) { monoInertValues.push(x) }
    monoInertCalled.push(x)
  }
  0
}

// Rewrites each read of loop `fl`'s binding to generic `g`, unless a read writes it; false when
// a read is left reading the loop's element.
function monoFlowLoopSet(fl: i32, g: i32): boolean {
  const us = mfrUses[fl] ?? []
  for u in us {
    if monoFlowIsWrite(u) { return false }
  }
  let all = true
  for u in us {
    if !monoFlowReadSet(u, g) { all = false }
  }
  all
}

// Replaces spread `sp` in its host list literal by one name read per element of list literal
// `v`, each naming the generic that element names; the host, or -1 when it is left alone.
function monoFlowSpreadSet(sp: i32, v: i32): i32 {
  const hx = mfrParent[sp] ?? -1
  if hx < 0 || v < 0 { return -1 }
  const host = P.nodes[hx]
  const src = P.nodes[v]
  if !(host is ArrayLit) || !(src is ArrayLit) { return -1 }
  for se in src.arrElems {
    const g = monoFlowLeafGen(unwrapParen(se))
    if g >= 0 && !monoFlowInScope(sp, g) { return -1 }
  }
  const out: i32[] = []
  for e in host.arrElems {
    if e == sp {
      for se in src.arrElems {
        const x = unwrapParen(se)
        const g = monoFlowLeafGen(x)
        if g >= 0 {
          const gnm = monoFlowLeafName(g)
          if gnm != "" {
            const nx = mkIdent(gnm, nodePos(sp))
            sidNoteNodeName(nx, g)
            nodeTyRecord(nx, nodeTyIxOf(x))
            // arena-tick exempt: a side table of this pass, not the arena
            mfrParent[nx] = hx
            out.push(nx)
          }
        }
      }
    } else {
      out.push(e)
    }
  }
  host.arrElems = out
  monoArenaTouch()
  hx
}

// Gives the un-annotated `const` list declared at `at` in frame `ctx` the one function type the
// flow table pins its element slot at (`monoDeclPathPins`), as an annotation: its elements and
// each value a write `d[k] = v` stores are instanced at it. Two pins are refused unless the flow
// reads already point each read at one generic; no pin leaves the list alone.
function monoPinListElems(d: LetDecl, at: i32, ctx: i32): i32 {
  if d.letInit < 0 || d.letKw != "const" { return 0 }
  const lit = P.nodes[d.letInit]
  if !(lit is ArrayLit) { return 0 }
  const rt = nodeTyIxOf(d.letInit)
  if rt >= 0 && rt < T.tys.length && T.tys[rt] is TyArray && !tyHasTyVar(rt) {
    return 0
  }
  const lf: i32[] = [ctx, at]
  const path: string[] = ["e"]
  const pins = monoDeclPathPins(lf, path)
  if pins.length > 1 {
    if fnFlowDeclKidSrc(at, "e") >= 0 { return 0 }
    return monoGenericListFail(d.letInit)
  }
  if pins.length != 1 { return 0 }
  // A pin taken at this instance's own template is this instance's alone, and a generic's
  // instances share `d`: its elements are instanced here and its reads typed per instance.
  const shared = monoFrameIsGenericInstance(ctx)
    && monoDeclPathPinsPerInstance(at, path)
  const ann = monoSigFnTyName(pins[0] + ";")
  let ft = -1
  for e in lit.arrElems {
    monoLastInstFe = -1
    const holeLam = monoListElemHoleLamFe(e, ctx) >= 0
    const et0 = nodeTyIxOf(e)
    let armFt = -1
    if shared && ft < 0 { armFt = monoValueAtAnnTy(e, ann) }
    if monoCoerceFnValueName(e, ann, ctx, -1) < 0 { return -1 }
    if holeLam && monoLastInstFe < 0 {
      if monoNoteBindDeliveryAt(e, ann, ctx) < 0 { return -1 }
    }
    if ft < 0 && monoLastInstFe >= 0 {
      const st = monoPinSubTyOf(nodeTyIxOf(e), fnStmts[monoLastInstFe])
      if monoTyClosedFn(st) { ft = st }
    }
    const et = nodeTyIxOf(e)
    if ft < 0 && monoTyClosedFn(et) { ft = et }
    // An instance whose pins bind none of the holes its recorded type names: read `ann`'s
    // parameters, as a shared list's hole functions do at this instance's own pin.
    if ft < 0 && (holeLam || shared) { ft = monoHoleLamAtAnnTy(et0, ann) }
    // An element joining hole functions has no one instance: each arm's result at `ann` (D7840).
    if ft < 0 { ft = armFt }
  }
  // A pin that is itself a function value names only a wasm signature, so a hole function's
  // instance there keeps its hole: the slot's pinned parameter types and the element's result
  // at them give the type, as a list literal handed to the parameter gets it (D6886).
  if ft < 0 { ft = monoListSlotPinnedFnTy(at, lit.arrElems) }
  if !monoTyClosedFn(ft) { return 0 }
  const fty = T.tys[ft]
  if !(fty is TyFunc) { return 0 }
  if shared {
    monoRetypeSlotReads(ctx, at, "e", ft)
    return 0
  }
  // The pin's own parameter spelling, from which each instance is built, in the canonical
  // `(p)=>r` form a pin spelling is compared in (D6602).
  const lt = mkArrayTy(ft)
  const fnm = monoSigFnTyNameAt(pins[0] + ";", fty)
  d.letType = synthTypeRefTy("(" + fnm + ")[]", -1, lt)
  monoArenaTouch()
  nodeTyRecord(d.letInit, lt)
  for e in lit.arrElems {
    const et = nodeTyIxOf(e)
    if et < 0 || tyHasTyVar(et) { nodeTyRecord(e, ft) }
  }
  for w in monoWritesOf("e:", at) {
    const wb = P.nodes[w]
    const wf = monoLetWriteFrame(lf, w)
    if wb is BinExpr && wf.length == 1 {
      if monoPinWrittenLam(wb.binRight, ann, wf[0]) < 0 { return -1 }
      if monoCoerceFnValueName(wb.binRight, ann, wf[0], -1) < 0 { return -1 }
    }
  }
  0
}

// Whether `t` is a function type reaching neither a type variable nor an inference hole.
function monoTyClosedFn(t: i32): boolean {
  monoTyConcreteFn(t) && !tyReachesHole(t, 16)
}

// The function type every element of `elems` takes at the closed parameter types the flow table
// pins slot `e` of declaration `at` at, with the elements' one result there; -1 when the pins,
// an element or the results do not close or agree.
function monoListSlotPinnedFnTy(at: i32, elems: i32[]): i32 {
  const qs: i32[] = []
  const ePath: string[] = ["e"]
  if !fnFlowDeclPathAgreedPinTys(at, ePath, qs) { return -1 }
  for q in qs {
    if tyHasTyVar(q) { return -1 }
  }
  let ft = -1
  for el in elems {
    // An element naming no one declaration (a `let` written twice) has its own type's result.
    const ex = monoOpenFnArgDecl(el)
    let r = -1
    if ex >= 0 {
      r = monoFnDeclRetAt(ex, qs)
    } else {
      r = monoFnTyRetAt(nodeTyIxOf(el), qs)
    }
    if r < 0 { return -1 }
    const et = mkFuncTy(qs, r)
    if ft >= 0 && sigKeyOfTy(et) != sigKeyOfTy(ft) { return -1 }
    ft = et
  }
  ft
}

// The function type a hole lambda typed `et` takes when instanced at the parameters `ann` spells:
// those parameters and `et`'s own result, or -1 when that result is still open.
function monoHoleLamAtAnnTy(et: i32, ann: string): i32 {
  if et < 0 || et >= T.tys.length { return -1 }
  const f = T.tys[et]
  if !(f is TyFunc) || f.fnRet < 0 || tyHasTyVar(f.fnRet) { return -1 }
  const at = nameToTy(ann)
  if at < 0 || at >= T.tys.length { return -1 }
  const a = T.tys[at]
  if !(a is TyFunc) || a.fnParamTypes.length != f.fnParamTypes.length {
    return -1
  }
  const ft = mkFuncTy(a.fnParamTypes, f.fnRet)
  if !monoTyConcreteFn(ft) { return -1 }
  ft
}

// The function type value `v` takes at the parameters `ann` spells, when `v` is a function or an
// `if` joining functions whose results there are closed and agree; -1 otherwise.
function monoValueAtAnnTy(v: i32, ann: string): i32 {
  const at = nameToTy(ann)
  if at < 0 || at >= T.tys.length { return -1 }
  const a = T.tys[at]
  if !(a is TyFunc) || tyHasTyVar(at) { return -1 }
  const r = monoValueRetAt(v, a.fnParamTypes, 0)
  if r < 0 { return -1 }
  const ft = mkFuncTy(a.fnParamTypes, r)
  if !monoTyClosedFn(ft) { return -1 }
  ft
}

// The closed result of value `v` called at the parameter types `qs`, through the arms of an
// `if` that does not end in a call that never returns; -1 when one stays open or two disagree.
function monoValueRetAt(v: i32, qs: i32[], depth: i32): i32 {
  const x = unwrapParen(v)
  if x < 0 || x >= P.nodes.length || depth > MONO_ALIAS_CHAIN_MAX { return -1 }
  const n = P.nodes[x]
  if !(n is IfStmt) {
    const lx = monoOpenFnArgDecl(x)
    if lx >= 0 { return monoFnDeclRetAt(lx, qs) }
    return monoFnTyRetAt(nodeTyIxOf(x), qs)
  }
  if n.ifElse < 0 { return -1 }
  let r = -1
  for arm in [n.ifThen, n.ifElse] {
    if !monoArmEndsNever(arm) {
      const tv = ifArmValueExpr(arm)
      const ar = monoValueRetAt(if tv >= 0 { tv } else { arm }, qs, depth + 1)
      if ar < 0 { return -1 }
      if r >= 0 && !tySameSpelled(ar, r, TY_WALK_DEPTH) { return -1 }
      r = ar
    }
  }
  r
}

// Pins a lambda literal `v` with an un-annotated parameter, written in frame `wf` into a list
// element or record field of function type `ann`, at that type, as its own contextual type
// would; -1 when it cannot take it (refused).
function monoPinWrittenLam(v: i32, ann: string, wf: i32): i32 {
  const x = unwrapParen(v)
  if x < 0 || !(P.nodes[x] is FuncDecl) { return 0 }
  const lfe = monoLamValueFe(x, wf)
  if (
    lfe < 0
    || lfe >= monoGen.length
    || monoGen[lfe] != 1
    || !monoLamIsHole(lfe)
  ) {
    return 0
  }
  if monoCellLamTake(lfe, x, ann, wf) == 0 { return 0 }
  emitFailAt(
    "emitProgram: a lambda written into an element or field holding a generic function cannot "
      + "take the type the calls through it give it — annotate its parameters",
    x,
  )
}

// Instances each generic function a field of the un-annotated `const` record declared at `at` in
// frame `ctx` holds, and each value a write `d.f = v` stores there, at the one signature the flow
// table pins that field at (`monoDeclPathPins`); a field pinned at none or at two is left alone.
function monoPinRecordFields(d: LetDecl, at: i32, ctx: i32): i32 {
  if d.letInit < 0 || d.letKw != "const" { return 0 }
  const lit = P.nodes[d.letInit]
  if !(lit is ObjLit) { return 0 }
  for fi in lit.objFields {
    const f = P.nodes[fi]
    if f is FieldInit {
      if monoPinRecordField(at, f.fiName, f.fiValue, ctx) < 0 { return -1 }
    }
  }
  0
}

// Types each read of slot `slot` ("f.<name>" a field, "e" an element) in frame `fx` of the
// binding declared at `at` at the pinned function type `ft` where the checker left it open, so a
// call through it has a signature when its value is no one function (D5061). A generic's
// instances share the read node, so there the type is kept per instance (D5079).
function monoRetypeSlotReads(fx: i32, at: i32, slot: string, ft: i32) {
  const d = P.nodes[at]
  if !(d is LetDecl) { return 0 }
  const shared = fx >= 0 && monoFrameIsGenericInstance(fx)
  const nodes = monoFrameNodes(fx)
  const aliases: i32[] = []
  for ix in nodes {
    if monoIsSlotRead(ix, slot, d.letName, fx, at) {
      const rt = nodeTyIxOf(ix)
      if rt < 0 || tyHasTyVar(rt) {
        if shared {
          monoNoteFieldReadTy(ix, fx, ft)
        } else {
          nodeTyRecord(ix, ft)
        }
      }
    }
    const n = P.nodes[ix]
    if shared && n is LetDecl {
      if n.letType < 0 && n.letInit >= 0 {
        if n.letKw == "const" || !monoLetWrittenIn([fx, ix]) {
          aliases.push(ix)
        }
      }
    }
  }
  // A read of a never-written alias of such a read, or of an alias of that, is the read
  // (D5079, D7283).
  const done: i32[] = []
  let grew = true
  while grew {
    grew = false
    for al in aliases {
      const ad = P.nodes[al]
      if ad is LetDecl && !i32ListHas(done, al) {
        if monoFieldReadTyIn(unwrapParen(ad.letInit), fx) >= 0 {
          done.push(al)
          grew = true
          for ix in nodes {
            if monoReadsBinding(ix, ad.letName, fx, al) {
              monoNoteFieldReadTy(ix, fx, ft)
            }
          }
        }
      }
    }
  }
  0
}

// Whether node `ix` reads slot `slot` (`monoRetypeSlotReads`) of the binding `nm` declared at
// `decl`, in frame `fx`.
function monoIsSlotRead(
  ix: i32,
  slot: string,
  nm: string,
  fx: i32,
  decl: i32,
): boolean {
  if slot == "e" { return monoIsElemRead(ix, nm, fx, decl) }
  const n = P.nodes[ix]
  n is Member
    && "f." + n.memProp == slot
    && monoReadsBinding(n.memObj, nm, fx, decl)
}

// Whether node `ix` indexes the binding `nm` declared at `decl`, in frame `fx`.
function monoIsElemRead(ix: i32, nm: string, fx: i32, decl: i32): boolean {
  const n = P.nodes[ix]
  n is Index && monoReadsBinding(n.idxArr, nm, fx, decl)
}

// Whether `v` is a read of the binding `nm` declared at `decl`, in frame `fx`.
function monoReadsBinding(v: i32, nm: string, fx: i32, decl: i32): boolean {
  const o = unwrapParen(v)
  if o < 0 { return false }
  const on = P.nodes[o]
  if !(on is Ident) { return false }
  on.identName == nm && monoReadIsBinding(o, fx, decl)
}

// Every node of frame `fx`'s body, nested function bodies included, or of the program's
// statements when `fx` is -1.
function monoFrameNodes(fx: i32): i32[] {
  const out: i32[] = []
  const stack: i32[] = []
  if fx >= 0 {
    const b = monoNestedBodyOf(fx)
    if b < 0 { return out }
    stack.push(b)
  } else {
    for st in monoProgStmts { stack.push(st) }
  }
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      out.push(ix)
      const body = monoNestedBodyOf(ix)
      if body >= 0 { stack.push(body) }
      for ch in nodeChildren(ix) { stack.push(ch) }
    }
  }
  out
}

// Records `ft` as the type of read `rd` in instance `fx` (`monoFieldReadTys`).
function monoNoteFieldReadTy(rd: i32, fx: i32, ft: i32) {
  if monoFieldReadTyIn(rd, fx) >= 0 { return 0 }
  const ps = monoFieldReadTys.get(rd) ?? []
  ps.push(fx)
  ps.push(ft)
  monoFieldReadTys.set(rd, ps)
  0
}

// `monoPinRecordFields` for the field `name` initialized with `val`.
function monoPinRecordField(at: i32, name: string, val: i32, ctx: i32): i32 {
  const lf: i32[] = [ctx, at]
  const path: string[] = ["f." + name]
  const pins = monoDeclPathPins(lf, path)
  if pins.length != 1 { return 0 }
  const ann = monoSigFnTyName(pins[0] + ";")
  monoLastInstFe = -1
  const holeLam = monoListElemHoleLamFe(val, ctx) >= 0
  const vt0 = nodeTyIxOf(val)
  if monoCoerceFnValueName(val, ann, ctx, -1) < 0 { return -1 }
  if holeLam && monoLastInstFe < 0 {
    if monoNoteBindDeliveryAt(val, ann, ctx) < 0 { return -1 }
  }
  if monoLastInstFe < 0 { return 0 }
  let ft = monoPinSubTyOf(nodeTyIxOf(val), fnStmts[monoLastInstFe])
  if !monoTyConcreteFn(ft) && holeLam { ft = monoHoleLamAtAnnTy(vt0, ann) }
  if !monoTyConcreteFn(ft) { return 0 }
  const vt = nodeTyIxOf(val)
  // A generic's instances share `val`, so its type stays open there (D5079).
  if (vt < 0 || tyHasTyVar(vt)) && !monoFrameIsGenericInstance(ctx) {
    nodeTyRecord(val, ft)
  }
  monoRetypeSlotReads(ctx, at, "f." + name, ft)
  for w in monoWritesOf("f:", at) {
    const wb = P.nodes[w]
    const wf = monoLetWriteFrame(lf, w)
    if wb is BinExpr && wf.length == 1 {
      const m = P.nodes[wb.binLeft]
      if m is Member {
        if m.memProp == name {
          if monoPinWrittenLam(wb.binRight, ann, wf[0]) < 0 { return -1 }
          if monoCoerceFnValueName(wb.binRight, ann, wf[0], -1) < 0 {
            return -1
          }
        }
      }
    }
  }
  monoArenaTouch()
  0
}

// ── where a generic function value can reach ────────────────────────────────────────────────
// One question, asked of the tree before the walk rewrites it (`value_reach.vl`): a value whose
// every destination drops it, holds it where no function is read back, or hands it to such a
// place is inert (D6881, D7000, D7002).

// Notes inert each name of a generic function in the program `stmts` and the bodies in
// `fnStmts` whose value reaches nothing that calls or observes it (`vrInert`).
function monoInertReach(stmts: i32[]) {
  vrReset(stmts, true, false)
  const roots: i32[] = []
  for s in stmts { roots.push(s) }
  for f in fnStmts { roots.push(f) }
  monoReachIndex(roots)
}

// Types each list or record literal whose function element or field the walk left open at the
// one call type the value reaches (`vrCalleeTy`), so its slot's signature is the one those calls
// make (D7103).
function monoReachLitTys() {
  for a in vrLits {
    const at = nodeTyIxOf(a)
    if at >= 0 && at < T.tys.length {
      monoReachListTy(a, T.tys[at])
      monoReachRecTy(a, T.tys[at])
    }
  }
  0
}

// The list half of `monoReachLitTys`: literal `a` of type `t`, when `t` is a list.
function monoReachListTy(a: i32, t: Ty) {
  if t is TyArray {
    const ct = monoReachSlotTy(a, t.aElem, "e,")
    if ct >= 0 { nodeTyRecord(a, mkArrayTy(ct)) }
  }
  0
}

// The record half of `monoReachLitTys`: literal `a` of type `t`, when `t` is a record.
function monoReachRecTy(a: i32, t: Ty) {
  if t is TyObj {
    const fts: i32[] = []
    let moved = false
    let i = 0
    while i < t.objFieldTypes.length {
      const ct = monoReachSlotTy(
        a,
        t.objFieldTypes[i],
        "f:" + t.objFieldNames[i] + ",",
      )
      if ct >= 0 {
        fts.push(ct)
        moved = true
      } else {
        fts.push(t.objFieldTypes[i])
      }
      i = i + 1
    }
    if moved { nodeTyRecord(a, mkObjTy(t.objFieldNames, fts)) }
  }
  0
}

// The call type literal `a`'s slot at `path`, of open function type `st`, reaches, recorded on
// each reached callee still open; -1 when the slot is no such function or reaches no one type.
function monoReachSlotTy(a: i32, st: i32, path: string): i32 {
  if st < 0 || st >= T.tys.length || !(T.tys[st] is TyFunc) { return -1 }
  const pr = pinResolvedFnTy(st)
  if !tyHasTyVar(st) || (pr >= 0 && !tyHasTyVar(pr)) { return -1 }
  const ct = vrCalleeTy(a, path, monoFrameTyParamsOf(a))
  if ct < 0 { return -1 }
  for c in vrCalls(a, path) {
    const cn = P.nodes[c]
    if cn is Call {
      const ft = nodeTyIxOf(cn.callFn)
      if ft >= 0 && (tyHasTyVar(ft) || tyReachesHole(ft, 16)) {
        nodeTyRecord(cn.callFn, ct)
      }
    }
  }
  ct
}

// The type parameters the generic frames enclosing node `a` declare, which each instance binds.
function monoFrameTyParamsOf(a: i32): string[] {
  const out: string[] = []
  let f = vrFrameOf(a)
  while f >= 0 {
    const fn = P.nodes[f]
    if fn is FuncDecl {
      for tp in fn.fnTyParams { out.push(tp) }
    }
    f = vrFrameOf(f)
  }
  out
}

// Adds to `monoInertReach`'s index the subtrees under `roots` not yet in it, such as an
// instance's body the walk is about to enter, and notes their inert names (D6930).
function monoReachIndex(roots: i32[]) {
  const cands: i32[] = []
  vrIndex(roots, cands)
  for x in cands {
    if monoCalleeIsGeneric(x) && vrInert(x, "") { monoReachNote(x, false) }
  }
  0
}

// Notes value `x` inert, and with `kept` served by its function's own closure, which nothing
// here calls (D6660, D6931).
function monoReachNote(x: i32, kept: boolean) {
  if !i32ListHas(monoInertValues, x) { monoInertValues.push(x) }
  if kept && !i32ListHas(monoInertCalled, x) { monoInertCalled.push(x) }
  monoFlowNoteInertLeaf(x)
}

// Appends block `b`'s last statement to `out`; nothing for an empty block or a non-block.
function monoBlockTailInto(b: i32, out: i32[]) {
  if b < 0 || b >= P.nodes.length { return 0 }
  const n = P.nodes[b]
  if n is Block {
    if n.blkStmts.length > 0 { out.push(n.blkStmts[n.blkStmts.length - 1]) }
  }
  0
}

// The refusal for a list of generic functions whose calls give it no one function type.
function monoGenericListFail(at: i32): i32 {
  emitFailAt(
    "emitProgram: a list holding a generic function is called through its elements at more than "
      + "one type, so its elements have no one instance — annotate the "
      + "list's element type",
    at,
  )
}

// The refusal for an alias of a capture cell's read stored in a list, at node `at`.
function monoCellAliasListFail(at: i32): i32 {
  emitFailAt(
    "emitProgram: an alias of a captured, reassigned function binding is stored in a list, "
      + "whose calls the binding's one signature cannot follow — store the binding's value in "
      + "an annotated local first, or call it directly",
    at,
  )
}

// The capture cell read `[read, frame]` that the name read at `at` in frame `ctx` reaches through
// a chain of un-annotated aliases never written after their initializer; `[-1, -1]` for none.
function monoAliasCellRead(at: i32, ctx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1]
  let ax = at
  let fr = ctx
  let hops = 0
  while hops < MONO_ALIAS_CHAIN_MAX {
    const lf = monoReadLetFrame(ax, fr)
    if lf[1] < 0 { return none }
    const d = P.nodes[lf[1]]
    if !(d is LetDecl) || d.letType >= 0 || d.letInit < 0 { return none }
    if d.letKw != "const" && monoLetWrittenIn(lf) { return none }
    const iv = unwrapParen(d.letInit)
    if iv < 0 { return none }
    const cn = monoCellReadName(iv)
    if cn != "" {
      if !monoReadsGeneratedCell(iv, lf[0]) { return none }
      const out: i32[] = [iv, lf[0]]
      return out
    }
    if !(P.nodes[iv] is Ident) { return none }
    ax = iv
    fr = lf[0]
    hops = hops + 1
  }
  none
}

// For an un-annotated `let` read at `at` that an `=` writes: takes `tname` against the join of
// the pins the binding's value flows to (`monoLetPinTake`), then instances each named generic
// function its initializer or a live write names at that type, and answers true; false for any
// other read, which keeps its value (D3930).
function monoCoerceWrittenLetValues(at: i32, ctx: i32, tname: string): boolean {
  // Asked of every value read, so the cheap tests come first.
  if annArrowAt(tname) < 1 { return false }
  if !fnFlowDeclWritten(at) { return false }
  const lf = monoCoercibleLet(at, ctx)
  if lf[1] < 0 { return false }
  const d = P.nodes[lf[1]]
  if !(d is LetDecl) || d.letType >= 0 { return false }
  const byCall = monoCellSigByCall
  monoCellSigByCall = false
  const take = monoLetPinTake(lf, tname, byCall)
  if take == MONO_PIN_REFUSE {
    monoBindSigFail(d.letName, lf[1])
    return true
  }
  if take == MONO_PIN_KEEP { return true }
  monoWrittenLetBusy.push(lf[1])
  monoLastInstFe = -1
  monoCoerceNamedGeneric(d.letInit, tname, lf[0])
  for i in monoWritesOf("n:", lf[1]) {
    const nd = P.nodes[i]
    const wf = monoLetWriteFrame(lf, i)
    if nd is BinExpr && wf.length == 1 {
      monoCoerceNamedGeneric(nd.binRight, tname, wf[0])
      // The binding's own call is the type a hole lambda literal written to it is called at.
      if byCall { monoLamLitTake(nd.binRight, tname, wf[0]) }
    }
  }
  monoWrittenLetBusy.pop()
  true
}

// `monoLetPinTake`'s answers: coerce the binding's values at the delivery's type, keep them at
// the wider join, or refuse the binding (`monoBindSigFail`).
const MONO_PIN_COERCE = 0
const MONO_PIN_KEEP = 1
const MONO_PIN_REFUSE = 2

// How the written `let` `lf` takes a delivery at function type `tname`, in any delivery order: it
// is held at the join (`monoSigJoin`) of its pins (`monoLetPins`), which must be one of them.
// Differing pins join only when nothing is returned, and only the binding's own call (`byCall`),
// which converts its argument, may arrive at a list the join widens.
function monoLetPinTake(lf: i32[], tname: string, byCall: boolean): i32 {
  const sig = monoFnNameSig(tname)
  if sig == "" { return MONO_PIN_COERCE }
  const pins = monoLetPins(lf)
  if pins.length == 0 { return MONO_PIN_COERCE }
  let join = pins[0]
  let i = 1
  while i < pins.length {
    join = monoSigJoin(join, pins[i])
    if join == "" { return MONO_PIN_REFUSE }
    i = i + 1
  }
  if !strListHas(pins, join) { return MONO_PIN_REFUSE }
  const quiet = monoSigRetVoid(tname)
  if pins.length > 1 && !quiet { return MONO_PIN_REFUSE }
  if sig == join { return MONO_PIN_COERCE }
  if byCall && quiet && monoSigJoin(sig, join) == join { return MONO_PIN_KEEP }
  MONO_PIN_REFUSE
}

// The pins (`fnFlowDeclPathPinSigs`) of the written `let` `lf`, in the walk its frame's instance
// stands for; empty when the table answers none.
function monoLetPins(lf: i32[]): string[] {
  const path: string[] = []
  monoDeclPathPins(lf, path)
}

// `monoLetPins` for the slot `path` derives from the binding (`fnFlowDeclPathPinSigs`).
function monoDeclPathPins(lf: i32[], path: string[]): string[] {
  const dead: {[i32]: boolean} = Map()
  monoDeclPathKeys(lf, path, false, dead)
}

// `monoDeclPathPins` leaving out the pins taken in a function nested in the binding's frame that
// never runs (`monoWriteFrameDead`).
function monoDeclLivePathPins(lf: i32[], path: string[]): string[] {
  const dead: {[i32]: boolean} = Map()
  for f in fnFlowDeclPathPinFns(lf[1], path) {
    // arena-tick exempt: dead is this function's local table, not the arena
    if f >= 0 && f != lf[0] && monoWriteFrameDead(f, lf[0]) { dead[f] = true }
  }
  monoDeclPathKeys(lf, path, false, dead)
}

// `monoDeclPathPins`, or the returns annotations pin the slot at (`fnFlowDeclPathPinRets`) when
// `rets`.
function monoDeclPathKeys(
  lf: i32[],
  path: string[],
  rets: boolean,
  dead: {[i32]: boolean},
): string[] {
  let pins = monoDeclPathKeysIn(lf[1], path, -1, -1, rets, dead)
  if pins.length == 1 && pins[0] == FF_PIN_DECLINE {
    const it = monoFrameInstTmpl(lf[0])
    // A hole instance's parameters are spelled at its hole binding.
    const hrow = monoHoleSubRow.get(fnStmtsPosOf(it[0])) ?? -1
    if hrow >= 0 && hrow < monoHoleSubN.length {
      fnFlowStageInstHoles(monoHoleSubN[hrow], monoHoleSubT[hrow])
    }
    pins = monoDeclPathKeysIn(lf[1], path, it[0], it[1], rets, dead)
    const noN: string[] = []
    const noT: i32[] = []
    fnFlowStageInstHoles(noN, noT)
  }
  if pins.length == 1 && pins[0] == FF_PIN_DECLINE {
    const none: string[] = []
    return none
  }
  pins
}

// Whether the flow table pins slot `path` of declaration `d` only at an instance's own template,
// so the pin `monoDeclPathPins` gives differs from one instance to another.
function monoDeclPathPinsPerInstance(d: i32, path: string[]): boolean {
  const dead: {[i32]: boolean} = Map()
  const pins = monoDeclPathKeysIn(d, path, -1, -1, false, dead)
  pins.length == 1 && pins[0] == FF_PIN_DECLINE
}

function monoDeclPathKeysIn(
  d: i32,
  path: string[],
  inst: i32,
  tmpl: i32,
  rets: boolean,
  dead: {[i32]: boolean},
): string[] {
  if rets { return fnFlowDeclPathPinRets(d, path, inst, tmpl) }
  fnFlowDeclPathPinSigs(d, path, inst, tmpl, dead)
}

// The frame and declaration (`monoReadLetFrame`) of the `let` read at `at` in frame `ctx`, when
// no coercion of that binding is already under way; `[-1, -1]` otherwise.
function monoCoercibleLet(at: i32, ctx: i32): i32[] {
  const none: i32[] = [-1, -1]
  const lf = monoReadLetFrame(at, ctx)
  if lf[1] < 0 || i32ListHas(monoWrittenLetBusy, lf[1]) { return none }
  const d = P.nodes[lf[1]]
  if !(d is LetDecl) || d.letKw != "let" { return none }
  lf
}

// The frame write `i` runs in, as a one-element list, when it is an `=` to the binding `lf`
// (`monoReadLetFrame`) names or to one of its fields or elements, in a frame that holds it and can
// run; empty otherwise. A write in a closure nothing names never runs, so it delivers nothing.
function monoLetWriteFrame(lf: i32[], i: i32): i32[] {
  const none: i32[] = []
  const nd = P.nodes[i]
  if !(nd is BinExpr) || !monoFrameHolds(lf[0], i) { return none }
  const tg = P.nodes[nd.binLeft]
  let lhs = nd.binLeft
  if tg is Member { lhs = tg.memObj }
  else if tg is Index && monoCellReadName(nd.binLeft) == "" { lhs = tg.idxArr }
  let wf = lf[0]
  if lf[0] >= 0 {
    wf = monoFrameOfNode(i, lf[0])
  } else {
    wf = monoTopFrameOf(i)
  }
  if wf != lf[0] && monoWriteFrameDead(wf, lf[0]) { return none }
  if monoReadLetFrame(lhs, wf)[1] != lf[1] { return none }
  const out: i32[] = [wf]
  out
}

// Whether the capture cell declared at `di` holds, in its generic template (an instance's copy
// reads its `declOrigOf`), a type that names a type parameter.
function monoCellTyIsOpen(di: i32): boolean {
  const o = declOrigOf(di)
  const d = P.nodes[if o >= 0 { o } else { di }]
  if !(d is LetDecl) { return false }
  const el = monoGeneratedCellElem(d.letInit)
  el >= 0 && tyHasTyVar(monoCellElemTyOf(d.letInit, el))
}

// `monoCoerceFnValueName` for a value naming a declared generic function; a hole lambda's
// binding keeps its own signature rules (D3857).
function monoCoerceNamedGeneric(v: i32, tname: string, ctx: i32) {
  if !monoNamesDeclaredGeneric(v, ctx) && !monoValueNamesGenerics(v, ctx, 0) {
    return 0
  }
  monoCoerceFnValueName(unwrapParen(v), tname, ctx, -1)
}

// Whether value node `v`, read in frame `ctx`, names a declared generic function by name.
function monoNamesDeclaredGeneric(v: i32, ctx: i32): boolean {
  if v < 0 { return false }
  const x = unwrapParen(v)
  if x < 0 { return false }
  const n = P.nodes[x]
  if !(n is Ident) { return false }
  const fe = monoFnFeOfIdent(x, n.identName, ctx)
  fe >= 0 && fe < monoGen.length && monoGen[fe] == 1 && !criFnIsAnonLambda(fe)
}

// Whether value node `v`, read in frame `ctx`, names an instance of a declared generic, as a
// value an earlier coercion renamed does.
function monoNamesGenericInstance(v: i32, ctx: i32): boolean {
  if v < 0 { return false }
  const x = unwrapParen(v)
  if x < 0 { return false }
  const n = P.nodes[x]
  if !(n is Ident) { return false }
  const fe = monoFnFeOfIdent(x, n.identName, ctx)
  if fe < 0 || fe >= fnInstOrigin.length || fnInstOrigin[fe] < 0 {
    return false
  }
  const o = fnInstOrigin[fe]
  o < monoGen.length && monoGen[o] == 1 && !criFnIsAnonLambda(o)
}

// The slot value node `v`, read in frame `ctx`, names by a hole lambda's own name or one of its
// instances' names, as a delivery renames it; -1 for any other node.
function monoLamInstanceNamed(v: i32, ctx: i32): i32 {
  const n = P.nodes[v]
  if !(n is Ident) { return -1 }
  const fe = monoFnFeOfIdent(v, n.identName, ctx)
  if fe < 0 { return -1 }
  let o = fe
  if fe < fnInstOrigin.length && fnInstOrigin[fe] >= 0 { o = fnInstOrigin[fe] }
  if !criFnIsAnonLambda(o) { return -1 }
  fe
}

// Per capture-cell value node naming a generic, the parameter list it is instanced at,
// normalized. A node asked again at another list is one value two types want.
let monoCellCoercedSig: {[i32]: string} = Map()

// A value written into a capture cell at function type `tname`, in frame `ctx`, is one of: a
// generic or instance by name, an alias or another cell resolving to one, a hole lambda (its own
// rules), a parameter, or a value whose type names no type variable. 0 when it is, 1 when one
// node is wanted at two types, 2 for anything else, which the cell cannot take (D3939).
function monoCellValueTake(v: i32, tname: string, ctx: i32): i32 {
  monoCellValueTakeAt(v, tname, ctx, 0)
}

// `monoCellValueTake` `depth` aliases down.
function monoCellValueTakeAt(v: i32, tname: string, ctx: i32, depth: i32): i32 {
  const x = unwrapParen(v)
  if x < 0 { return 2 }
  const n = P.nodes[x]
  if n is IfStmt {
    const a = monoCellValueTakeAt(n.ifThen, tname, ctx, depth)
    if a != 0 { return a }
    return monoCellValueTakeAt(n.ifElse, tname, ctx, depth)
  }
  if n is Block {
    if n.blkStmts.length == 0 { return 2 }
    return monoCellValueTakeAt(
      n.blkStmts[n.blkStmts.length - 1],
      tname,
      ctx,
      depth,
    )
  }
  if monoNamesDeclaredGeneric(x, ctx) || monoNamesGenericInstance(x, ctx) {
    if !monoCellSigOne(x, tname) { return 1 }
    monoCoerceNamedGeneric(x, tname, ctx)
    return 0
  }
  // A hole lambda holds one signature, whichever instance or cell writes it.
  const lfe = monoLamValueFe(x, ctx)
  if lfe >= 0 {
    // A hole lambda written as a literal is pinned at this type, as a call through the cell pins
    // it (D3950); the pin annotates it in place, so its parameters are read as first seen.
    if P.nodes[x] is FuncDecl && monoLamIsHole(lfe) {
      if !monoCellSigOne(monoOrigNode[lfe], tname) { return 1 }
      if lfe < monoGen.length && monoGen[lfe] == 1 {
        return monoCellLamTake(lfe, x, tname, ctx)
      }
      return 0
    }
    // One reached by name keeps its binding's rules (D3857), with one signature per lambda.
    const key = monoLamSigKey(lfe)
    if !monoCellSigOne(key, tname) { return 1 }
    // A lambda with every parameter annotated has its own type to compare.
    if key == fnStmts[lfe] {
      return monoCellConcreteTake(nodeTyIxOf(fnStmts[lfe]), tname, 0)
    }
    return 0
  }
  // A hole lambda that a delivery at a pin renamed to its instance holds that instance's
  // signature, so taking the write again agrees or wants a second type (D4843).
  const ife = monoLamInstanceNamed(x, ctx)
  if ife >= 0 {
    const had = monoSlotSig(ife)
    if had == "" { return 2 }
    if had == monoFnNameSig(tname) + ";" { return 0 }
    return 1
  }
  // Another cell's read delivers that cell at this type (D3949).
  const src = monoCellReadName(x)
  if src != "" && monoReadsGeneratedCell(x, ctx) {
    monoCoerceWrittenCell(x, ctx, tname)
    return 0
  }
  const nm = monoIdentNameOf(x)
  if nm != "" && monoReadGenFnFe(x) >= 0 {
    if !monoCellSigOne(x, tname) { return 1 }
    if monoCoerceFnValueName(x, tname, ctx, -1) < 0 { return 2 }
    return 0
  }
  // A parameter holds a value its caller already built at this instance's type, which a
  // concrete parameter type has to be.
  if nm != "" && monoNameIsParamOnChain(nm, ctx) {
    // Narrowed or not, a nullable parameter keeps its representation, as a local does below.
    if nonNulBaseOf(tname) == tname && monoParamDeclNullable(nm, ctx) {
      return 2
    }
    return monoCellConcreteTake(nodeTyIxOf(x), tname, 0)
  }
  // An un-annotated alias never written after its initializer is that initializer.
  if nm != "" && depth < MONO_ALIAS_CHAIN_MAX {
    const lf = monoReadLetFrame(x, ctx)
    if lf[1] >= 0 {
      const d = P.nodes[lf[1]]
      if d is LetDecl {
        const fixed = d.letKw == "const" || !monoLetIsAssigned(nm, lf[1])
        if d.letType < 0 && d.letInit >= 0 && fixed {
          return monoCellValueTakeAt(d.letInit, tname, lf[0], depth + 1)
        }
      }
    }
  }
  // A read a test narrowed from a nullable binding keeps that binding's representation.
  if (
    nm != ""
    && nonNulBaseOf(tname) == tname
    && monoReadDeclNullable(x, ctx)
  ) {
    return 2
  }
  monoCellConcreteTake(nodeTyIxOf(x), tname, 2)
}

// Whether the parameter `name` that frame `fx` or the nearest enclosing frame binds is declared
// with a nullable annotation.
function monoParamDeclNullable(name: string, fx: i32): boolean {
  let f = fx
  let guard = 0
  while f >= 0 && f < P.nodes.length && guard <= fnStmts.length {
    const fn = P.nodes[f]
    if fn is FuncDecl {
      for pi in fn.fnParams {
        const pn = P.nodes[pi]
        if pn is Param {
          if pn.parName == name {
            if pn.parType < 0 { return false }
            const ann = tyNameOf(pn.parType)
            return nonNulBaseOf(ann) != ann
          }
        }
      }
    }
    const slot = fnStmtsPosOf(f)
    if slot < 0 || slot >= fnParent.length { return false }
    const ps = fnParent[slot]
    if ps < 0 || ps >= fnStmts.length { return false }
    f = fnStmts[ps]
    guard = guard + 1
  }
  false
}

// Whether the binding the name read at `at` in frame `ctx` reads is declared with a nullable
// annotation.
function monoReadDeclNullable(at: i32, ctx: i32): boolean {
  const lf = monoReadLetFrame(at, ctx)
  if lf[1] < 0 { return false }
  const d = P.nodes[lf[1]]
  if !(d is LetDecl) || d.letType < 0 { return false }
  const ann = tyNameOf(d.letType)
  nonNulBaseOf(ann) != ann
}

// The node a lambda slot's signature is recorded on: a lambda with an un-annotated parameter is
// one lambda in every instance of its enclosing generic, so its declaration; any other its own.
function monoLamSigKey(lfe: i32): i32 {
  const own = fnStmts[lfe]
  if lfe >= monoOrigNode.length { return own }
  const orig = P.nodes[monoOrigNode[lfe]]
  if orig is FuncDecl {
    for pi in orig.fnParams {
      const pn = P.nodes[pi]
      if pn is Param {
        if pn.parType < 0 { return monoOrigNode[lfe] }
      }
    }
  }
  own
}

// Lambda slots seen with an un-annotated parameter; a pin annotates it in place, so the first
// answer is kept.
let monoHoleLamSlots: {[i32]: boolean} = Map()

// Whether lambda slot `lfe` declares an un-annotated parameter, as first read.
function monoLamIsHole(lfe: i32): boolean {
  if monoHoleLamSlots.get(lfe) ?? false { return true }
  if lfe < 0 || lfe >= monoOrigNode.length { return false }
  const orig = P.nodes[monoOrigNode[lfe]]
  if orig is FuncDecl {
    for pi in orig.fnParams {
      const pn = P.nodes[pi]
      if pn is Param {
        if pn.parType < 0 {
          monoHoleLamSlots.set(lfe, true)
          return true
        }
      }
    }
  }
  false
}

// Whether the read `d[0]` at `at` in frame `ctx` is of a capture cell the rewrite built rather
// than of a list the program declared.
function monoReadsGeneratedCell(at: i32, ctx: i32): boolean {
  const lf = monoReadLetFrame(at, ctx)
  if lf[1] < 0 { return false }
  const d = P.nodes[lf[1]]
  if !(d is LetDecl) { return false }
  monoGeneratedCellElem(d.letInit) >= 0
}

// What `monoCellValueTake` answers for a value of type `t` delivered at function type `tname`:
// 0 for a concrete function type with `tname`'s parameters (nullable where `tname` is), or a
// primitive such as `null`; 1 for a function type with others; `open` for a type naming a type
// variable; 2 for any other type.
function monoCellConcreteTake(t: i32, tname: string, open: i32): i32 {
  if t < 0 || t >= T.tys.length || tyHasTyVar(t) { return open }
  let ft = t
  const nt = T.tys[t]
  if nt is TyNullable {
    // A nullable value, even one a test narrowed, is stored only where the cell admits null.
    if nonNulBaseOf(tname) == tname { return 2 }
    ft = nt.nInner
  }
  if ft < 0 || ft >= T.tys.length { return 2 }
  const f = T.tys[ft]
  if f is TyPrim { return 0 }
  if !(f is TyFunc) { return 2 }
  // A function type with no parameters has the empty parameter list, which is no refusal.
  if annArrowAt(peelGroupParens(nonNulBaseOf(tname))) < 1 { return 1 }
  const has = monoConcreteFnTyName(ft)
  if has == "" || monoFnNameSig(has) != monoFnNameSig(tname) { return 1 }
  0
}

// Pins hole lambda `lfe`, the value at node `x` in frame `ctx`, at function type `tname`, where
// nothing has yet: 0 when the lambda the cell holds then has that signature (and it is the last
// instance), 1 when it holds another, 2 when it cannot take the type.
function monoCellLamTake(lfe: i32, x: i32, tname: string, ctx: i32): i32 {
  const pnames: string[] = []
  if !monoFnTypeAnnParamsName(peelGroupParens(nonNulBaseOf(tname)), pnames) {
    return 2
  }
  monoCellLamTakeAt(lfe, x, pnames, ctx)
}

// `monoCellLamTake` at the parameter pin names `pnames`.
function monoCellLamTakeAt(lfe: i32, x: i32, pnames: string[], ctx: i32): i32 {
  let want = ""
  for pn in pnames { want = want + normTypeAtom(pn) + "," }
  const had = monoInstantiatedAny(lfe)
  if !had {
    monoLastInstFe = -1
    monoCallFrameSlot = monoNestedCallFrame(lfe, ctx)
    const r = monoInstanceFor(lfe, pnames, x, -1)
    monoCallFrameSlot = -1
    if r < 0 || monoLastInstFe < 0 { return 2 }
  }
  const pins: string[] = []
  if !monoSlotParamPins(lfe, pins) { return 2 }
  let got = ""
  for pn in pins { got = got + normTypeAtom(pn) + "," }
  if got != want {
    if had { return 1 }
    return 2
  }
  // The cell is retyped to the lambda it holds.
  monoLastInstFe = lfe
  0
}

// The parameter list `p1,p2,` of the function type spelled `tname`, normalized; "" for no
// function type.
function monoFnNameSig(tname: string): string {
  const parts: string[] = []
  if annFnDecompose(peelGroupParens(nonNulBaseOf(tname)), parts) == "" {
    return ""
  }
  let sig = ""
  for pt in parts { sig = sig + normTypeAtom(pt) + "," }
  sig
}

// The result type of the call whose signature is being recorded; -2 outside one, where a
// signature's own function type spells its result.
let monoSigCallRet = 0 - 2

// Whether the signature recorded now, of function type `tname`, returns nothing: only then may it
// join another, since an argument converted to the joined type would come back unconverted.
function monoSigRetVoid(tname: string): boolean {
  const rt = monoSigCallRet
  if rt == -2 {
    const parts: string[] = []
    return normTypeAtom(
      annFnDecompose(peelGroupParens(nonNulBaseOf(tname)), parts),
    )
      == "void"
  }
  if rt < 0 || rt >= T.tys.length { return false }
  const t = T.tys[rt]
  if t is TyPrim { return t.primName == "void" }
  false
}

// Set by a call through a written `let` just before it coerces the `let` at the call's type;
// cleared by that coercion.
let monoCellSigByCall = false

// Records the value node `v` a capture cell takes at the parameter list of function type
// `tname`; false when it already holds another.
function monoCellSigOne(v: i32, tname: string): boolean {
  const sig = monoFnNameSig(tname)
  if sig == "" { return true }
  const had = monoCellCoercedSig.get(v) ?? ""
  if had != "" && had != sig { return false }
  monoCellCoercedSig.set(v, sig)
  true
}

// The parameter list both `a` and `b` (`p1,p2,`) pass their values as, pin by pin
// (`monoPinJoin`); "" when some pair has none.
function monoSigJoin(a: string, b: string): string {
  const pa = monoSigPins(a)
  const pb = monoSigPins(b)
  if pa.length != pb.length { return "" }
  let out = ""
  let i = 0
  while i < pa.length {
    const j = monoPinJoin(pa[i], pb[i])
    if j == "" { return "" }
    out = out + j + ","
    i = i + 1
  }
  out
}

// The pin a value of pin `p` and one of pin `q` are both passed as: either, when equal; `string`
// for a string literal union and `string`; a union of primitives with a string member, for it
// and `string`, since its box carries any string. "" otherwise.
function monoPinJoin(p: string, q: string): string {
  if p == q { return p }
  const wp = monoPinWidened(p)
  if wp == monoPinWidened(q) { return wp }
  if p == "string" && monoPinCarriesString(q) { return q }
  if q == "string" && monoPinCarriesString(p) { return p }
  ""
}

// Whether pin `pin` names a declared union of primitives and literals, not all string literals,
// with a string or string literal member: its box carries any string as that member.
function monoPinCarriesString(pin: string): boolean {
  const ty = cUserTypes.get(pin) ?? -1
  if ty < 0 || ty >= T.tys.length || tyIsLitUnion(ty) { return false }
  const u = T.tys[ty]
  if !(u is TyUnion) { return false }
  let str = false
  for m in u.uMembers {
    const base = tyScalarBasePrim(m)
    if base == null { return false }
    if base == "string" { str = true }
  }
  str
}

// Whether function node `fx` is an instance of a generic function, or the generic itself.
function monoFrameIsGenericInstance(fx: i32): boolean {
  const slot = fnStmtsPosOf(fx)
  if slot < 0 { return false }
  if slot < fnInstOrigin.length && fnInstOrigin[slot] >= 0 { return true }
  slot < monoGen.length && monoGen[slot] == 1
}

// A value written into a capture cell that is neither a generic by name, an alias of one, a hole
// lambda nor of a settled type has no instance this pass can give the cell's type.
function monoCellValueFail(nm: string): i32 {
  emitFail(
    "emitProgram: the captured binding `"
      + nm
      + "` is written with a function value whose type at this binding is not settled — write "
      + "the generic function by name, or annotate the binding's type",
  )
}

// A closure lifted once for every instance of its enclosing generic writes one value into
// each instance's capture cell, so it cannot hold a generic at a type that differs per instance.
function monoCellWriterSigFail(nm: string): i32 {
  emitFail(
    "emitProgram: the captured binding `"
      + nm
      + "` is written with a function inside a closure that every instance of the "
      + "enclosing generic function shares, and the instances want it at different types. "
      + "Write it in the enclosing function's own body, or bind a separate value per type",
  )
}

// Whether a plain write `x = …` in frame `lf[0]` targets the binding `lf` (`[frame,
// declaration]`).
function monoLetWrittenIn(lf: i32[]): boolean {
  for w in monoWritesOf("n:", lf[1]) {
    if monoFrameHolds(lf[0], w) { return true }
  }
  false
}

// Whether the binding `name` read at node `at` is written: by binding where the read resolves to
// a `let`, else by name anywhere.
function monoNameWrittenAt(name: string, at: i32): boolean {
  const lf = monoReadLetFrame(at, monoTopFrameOf(at))
  if lf[1] < 0 { return monoReadIsAssigned(name, at) }
  monoLetWrittenIn(lf)
}

// Whether the binding declared at `d`, a source declaration (`monoDeclCanon`), is the target of
// an assignment anywhere in the arena. A write whose target resolved to no declaration counts
// against every binding of its name, and `d` -1 asks after the name alone: both are the safe
// direction, which declines a callee fold and keeps the `call_ref`.
function monoDeclIsAssigned(name: string, d: i32): boolean {
  let i = 0
  while i < P.nodes.length {
    const nd = P.nodes[i]
    if nd is BinExpr {
      if nd.binOp == "=" {
        const tg = P.nodes[nd.binLeft]
        if tg is Ident {
          if tg.identName == name {
            if d < 0 { return true }
            const td = identDeclOf(nd.binLeft)
            if td < 0 || td >= P.nodes.length || monoDeclCanon(td) == d {
              return true
            }
          }
        }
      }
    }
    i = i + 1
  }
  false
}

// Whether the binding the read of `name` at `at` resolves to is assigned (`monoDeclIsAssigned`).
function monoReadIsAssigned(name: string, at: i32): boolean {
  monoDeclIsAssigned(name, monoReadDecl(name, at))
}

// Whether the `let` at `li`, which binds `name`, is assigned (`monoDeclIsAssigned`).
function monoLetIsAssigned(name: string, li: i32): boolean {
  if li < 0 { return monoDeclIsAssigned(name, -1) }
  monoDeclIsAssigned(name, monoDeclCanon(li))
}

// `monoCoerceFnValueName` keyed on an expected TYPE-annotation node (`-1` / a non-function type is a
// no-op). `ctx` is the enclosing function (-1 = top level), for resolving a value binding.
function monoCoerceFnValue(exprIx: i32, expectedTyIx: i32, ctx: i32) {
  if expectedTyIx < 0 { return 0 }
  return monoCoerceFnValueName(
    exprIx,
    tyNameOf(expectedTyIx),
    ctx,
    nodeTyIxOf(expectedTyIx),
  )
}

// The written type-annotation node of parameter `i` of the function occupying `fnStmts`
// slot `fe` — its original declaration, before monomorphization may replace the slot — or
// -1. Lets a call site read the concrete function type a callback parameter declares.
// Callers resolve `fe` through `monoFnFeOfIdent`, so the answer is spelling-independent.
function monoFnParamTypeAt(fe: i32, i: i32) {
  const declIx = monoFnDeclNodeAt(fe)
  if declIx < 0 { return -1 }
  const fn = P.nodes[declIx]
  if fn is FuncDecl {
    const ps = fn.fnParams
    if i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param { return p.parType }
    }
  }
  -1
}

// The declaration node whose parameter annotations `monoFnParamTypeAt` reads — the
// captured original for a template slot, the slot itself for an appended instance (which
// has no separate original and carries the pinned annotations). `monoOrigNode` is only as
// long as the declaration count; indexing past that end traps the compiler. -1 otherwise.
function monoFnDeclNodeAt(fe: i32) {
  if fe < 0 { return -1 }
  if fe >= fnStmts.length { return -1 }
  if fe < monoOrigNode.length { return monoOrigNode[fe] }
  fnStmts[fe]
}

// Does parameter `i` of the declaration at `fe` carry an annotation that mentions that
// declaration's own type parameters — `g: (U, U) => R` on `hof<U, R>`, or a plain `a: U`?
// `monoWalk`'s coercion loop must ask this: handing a type-variable-bearing parameter type
// to `monoCoerceFnValue` mints an instance spelled `U`, which no valtype ladder lowers (D58).
function monoFnParamAnnRidesTyParam(fe: i32, i: i32) {
  const pty = monoFnParamTypeAt(fe, i)
  if pty < 0 { return false }
  const declIx = monoFnDeclNodeAt(fe)
  if declIx < 0 { return false }
  const fn = P.nodes[declIx]
  if fn is FuncDecl {
    if fn.fnTyParams.length == 0 { return false }
    const ann = monoDeclAnnName(pty, tyNameOf(pty), fn.fnTyParams)
    return monoAnnHasTyParam(ann, fn.fnTyParams)
  }
  false
}

// The `fnStmts` slot of the lambda the `let` at the end of call `ix`'s alias chain
// (`monoAliasLetEnd`) is seeded with, in frame `ctx`; -1 when the callee is no such alias.
function monoAliasLetLamFe(ix: i32, ctx: i32): i32 {
  const c = P.nodes[ix]
  if !(c is Call) { return -1 }
  const wl = monoAliasLetEnd(c.callFn, ctx)
  if wl[0] < 0 { return -1 }
  identClosureFeAt(sidOfNode(wl[0]), wl[1], wl[0])
}

// Coerces each function named as a positional argument of call `n` at the parameter type the
// callee value's declared concrete function type gives it, where `dfe`, the callee's slot, declares
// none; a type naming a type variable or a hole is left to the instance that pins it.
function monoCoerceAtValueParams(n: Call, dfe: i32, ctx: i32): i32 {
  for nm in n.callArgNames {
    if nm != "" { return 0 }
  }
  const ct = nodeTyIxOf(n.callFn)
  if ct < 0 || ct >= T.tys.length { return 0 }
  const f = T.tys[ct]
  if !(f is TyFunc) { return 0 }
  const parts: string[] = []
  const ann = tyNameOf(monoCalleeAnnNode(n.callFn, ctx))
  // An un-annotated callee (a list element, a field, a loop variable) spells its recorded type.
  const own = ann == ""
  if !own && !monoFnTypeAnnParamsName(ann, parts) { return 0 }
  let i = 0
  while (
    i < n.callArgs.length
    && i < f.fnParamTypes.length
    && (own || i < parts.length)
  ) {
    const pt = f.fnParamTypes[i]
    if (
      pt >= 0
      && pt < T.tys.length
      && T.tys[pt] is TyFunc
      && !tyHasTyVar(pt)
      && !tyReachesHole(pt, 8)
      && P.nodes[unwrapParen(n.callArgs[i])] is Ident
      && monoFnParamTypeAt(dfe, i) < 0
    ) {
      const pn = if own { monoPinAnnSpelling(pt) } else { parts[i] }
      if monoCoerceFnValueName(n.callArgs[i], pn, ctx, pt) < 0 { return -1 }
    }
    i = i + 1
  }
  0
}

// The annotation node the callee `Ident` at `callee` is declared with, as a parameter or a local
// of function `fnIx` or as a module global, or -1.
function monoCalleeAnnNode(callee: i32, fnIx: i32): i32 {
  const cx = unwrapParen(callee)
  if cx < 0 || cx >= P.nodes.length { return -1 }
  const c = P.nodes[cx]
  if !(c is Ident) { return -1 }
  let li = globalLetOfIn(fnIx, c.identName, cx)
  if fnIx >= 0 {
    const ptn = paramTypeNode(fnIx, c.identName)
    if ptn >= 0 { return ptn }
    const fn = P.nodes[fnIx]
    if fn is FuncDecl {
      const fl = parentLetOf(fn.fnBody, c.identName)
      if fl >= 0 { li = fl }
    }
  }
  if li < 0 { return -1 }
  const ld = P.nodes[li]
  if ld is LetDecl { return ld.letType }
  -1
}

// Call `n` through a list element, a `for` variable over a list or a `const` joining functions
// by `if`, each element a named function: instances every element and types the callee at the
// one closed type their parameters' own calls and the arguments' results give it (D7183). 0 when
// none applies, -1 on a failure.
function monoOpenCallAtElems(n: Call, ctx: i32): i32 {
  const elems = monoCalleeElems(n.callFn)
  if elems.length == 0 { return 0 }
  const rows: i32[][] = []
  for el in elems {
    const pts = monoElemParamTys(el, n.callArgs, ctx)
    if pts.length != n.callArgs.length { return 0 }
    rows.push(pts)
  }
  // A parameter an element never reads takes the type a sibling's calls give it.
  let j = 0
  while j < n.callArgs.length {
    let fill = -1
    for pts in rows {
      if pts[j] >= 0 { fill = pts[j] }
    }
    if fill < 0 { return 0 }
    for pts in rows {
      // arena-tick exempt: a local list of parameter types, not an arena row.
      if pts[j] < 0 { pts[j] = fill }
    }
    j = j + 1
  }
  let ft = -1
  let k = 0
  while k < elems.length {
    const r = monoFnDeclRetAt(monoOpenFnArgDecl(elems[k]), rows[k])
    if r < 0 { return 0 }
    const et = mkFuncTy(rows[k], r)
    if !monoTyClosedFn(et) { return 0 }
    if ft >= 0 && sigKeyOfTy(et) != sigKeyOfTy(ft) { return 0 }
    ft = et
    k = k + 1
  }
  const nm = monoConcreteFnTyName(ft)
  if nm == "" { return 0 }
  for el in elems {
    if monoCoerceFnValueName(el, nm, ctx, ft) < 0 { return -1 }
  }
  nodeTyRecord(n.callFn, ft)
  0
}

// The function values callee `c` reads: a list literal's through an index or a `for` variable,
// or a `const`'s, an `if` element giving each of its arm values; empty for any other callee.
function monoCalleeElems(c: i32): i32[] {
  const none: i32[] = []
  const x = unwrapParen(c)
  if x < 0 || x >= P.nodes.length { return none }
  const n = P.nodes[x]
  if n is Index { return monoConstListElems(n.idxArr) }
  if !(n is Ident) { return none }
  const d = identDeclOf(x)
  if d < 0 || d >= P.nodes.length { return none }
  const dn = P.nodes[d]
  if dn is ForIn && dn.fiVar == n.identName {
    return monoConstListElems(dn.fiIter)
  }
  if !(dn is LetDecl) || dn.letKw != "const" || dn.letType >= 0 { return none }
  const ix = unwrapParen(dn.letInit)
  if ix < 0 || ix >= P.nodes.length || !(P.nodes[ix] is IfStmt) { return none }
  const out: i32[] = []
  if !monoPushArmValues(ix, out) { return none }
  out
}

// Pushes the value `v` gives onto `out`, each arm's for an `if` with an else; false when an arm
// gives none.
function monoPushArmValues(v: i32, out: i32[]): boolean {
  const x = unwrapParen(v)
  if x < 0 || x >= P.nodes.length { return false }
  const i = P.nodes[x]
  if !(i is IfStmt) {
    out.push(x)
    return true
  }
  if i.ifElse < 0 { return false }
  for arm in [i.ifThen, i.ifElse] {
    const a = ifArmValueExpr(arm)
    if a < 0 || !monoPushArmValues(a, out) { return false }
  }
  true
}

// The elements of the un-annotated `const` list literal `v` names; empty otherwise.
function monoConstListElems(v: i32): i32[] {
  const none: i32[] = []
  const x = unwrapParen(v)
  if x < 0 || x >= P.nodes.length || !(P.nodes[x] is Ident) { return none }
  const d = identDeclOf(x)
  if d < 0 || d >= P.nodes.length { return none }
  const dn = P.nodes[d]
  if !(dn is LetDecl) || dn.letKw != "const" || dn.letType >= 0 { return none }
  const lx = unwrapParen(dn.letInit)
  if lx < 0 || lx >= P.nodes.length { return none }
  const l = P.nodes[lx]
  if !(l is ArrayLit) { return none }
  const out: i32[] = []
  for e in l.arrElems {
    if !monoPushArmValues(e, out) { return none }
  }
  out
}

// The closed parameter types the named function `el` takes called with `args`: a generic
// argument's at the types the parameter's own calls agree on, -1 for a parameter the body never
// reads, any other argument's own type; empty when one is open.
function monoElemParamTys(el: i32, args: i32[], ctx: i32): i32[] {
  const none: i32[] = []
  const x = unwrapParen(el)
  if x < 0 || !(P.nodes[x] is Ident) { return none }
  const fx = monoOpenFnArgDecl(x)
  if fx < 0 { return none }
  const f = P.nodes[fx]
  if !(f is FuncDecl) || f.fnParams.length != args.length { return none }
  const pts: i32[] = []
  let j = 0
  while j < args.length {
    let pt = -1
    if monoNamesDeclaredGeneric(args[j], ctx) {
      const qs: i32[] = []
      const noPath: string[] = []
      const ax = monoOpenFnArgDecl(args[j])
      if ax >= 0 && fnFlowDeclPathAgreedPinTys(f.fnParams[j], noPath, qs) {
        const r = monoFnDeclRetAt(ax, qs)
        if r >= 0 { pt = mkFuncTy(qs, r) }
      } else if !monoSubtreeReads(f.fnBody, f.fnParams[j]) {
        pts.push(-1)
        j = j + 1
        continue
      }
    } else {
      pt = nodeTyIxOf(unwrapParen(args[j]))
    }
    if pt < 0 || pt >= T.tys.length || tyHasTyVar(pt) { return none }
    pts.push(pt)
    j = j + 1
  }
  pts
}

// Whether the subtree at `ix` reads the declaration `d`.
function monoSubtreeReads(ix: i32, d: i32): boolean {
  const stack: i32[] = [ix]
  while stack.length > 0 {
    const x = stack.pop() ?? -1
    if x >= 0 && x < P.nodes.length {
      if P.nodes[x] is Ident && identDeclOf(x) == d { return true }
      for c in nodeChildren(x) { stack.push(c) }
    }
  }
  false
}

// The refusal for a call `monoGenArgAtOpenParam` names, at node `ix` (D3956); the split may
// give each function the call reaches a parameter per type its argument is called at (D7183).
function monoGenArgOpenFail(ix: i32): i32 {
  fsAskOpenCall(ix)
  emitFailAt(
    "emitProgram: a generic function is passed to a function value whose parameter type "
      + "names a type parameter this closure does not bind, so no instance of it can be "
      + "chosen — call the function value from the generic function's own body, or pass "
      + "a function of a concrete type",
    ix,
  )
}

// Whether call `n`, through a function value, hands a declared generic function to a parameter
// whose recorded type names a type variable, which leaves the generic with no instance.
function monoGenArgAtOpenParam(n: Call, ctx: i32): boolean {
  const ct = nodeTyIxOf(n.callFn)
  if ct < 0 || ct >= T.tys.length { return false }
  const f = T.tys[ct]
  if !(f is TyFunc) { return false }
  let i = 0
  while i < n.callArgs.length && i < f.fnParamTypes.length {
    const pt = f.fnParamTypes[i]
    if (
      pt >= 0
      && pt < T.tys.length
      && tyHasTyVar(pt)
      && monoNamesDeclaredGeneric(n.callArgs[i], ctx)
    ) {
      return true
    }
    i = i + 1
  }
  false
}

// Does this call hand a generic function value to a parameter whose annotation is an arrow
// riding the callee's own type parameters? The trigger for the pre-binding pass in
// `monoInstantiate`, asked so that pass changes nothing elsewhere: the two binding orders
// can only disagree when one parameter says `U = T` and another says `U = i32`.
function monoCallGenFnToTyParamArrow(
  params: i32[],
  args: i32[],
  typarams: string[],
  ctx: i32,
) {
  if typarams.length == 0 { return false }
  let i = 0
  while i < args.length && i < params.length {
    const p = P.nodes[params[i]]
    if p is Param {
      if p.parType >= 0 {
        const ann = monoDeclAnnName(p.parType, tyNameOf(p.parType), typarams)
        if annArrowAt(ann) >= 1 && monoAnnHasTyParam(ann, typarams) {
          const ax = unwrapParen(args[i])
          const av = P.nodes[ax]
          if av is Ident {
            const gfe = monoFnFeOfIdent(ax, av.identName, ctx)
            if gfe >= 0 && gfe < monoGen.length {
              if monoGen[gfe] == 1 { return true }
            }
          }
        }
        // A list of functions riding the type parameters, handed a literal of generics (D3913).
        if nameIsClosureArray(ann) && monoAnnHasTyParam(ann, typarams) {
          if monoLitHoldsGenericFn(args[i], 0) { return true }
        }
      }
    }
    i = i + 1
  }
  false
}

// A call whose callee is a call (`a(x)(x)`, `a(x)(x)(x)`), whose recorded types are the
// template's: the callee and the call are typed at this instance's own (D3912, D3922).
function monoTypeCallOfCall(ix: i32, ctx: i32) {
  const n = P.nodes[ix]
  if !(n is Call) { return 0 }
  const cx = unwrapParen(n.callFn)
  if cx < 0 || !(P.nodes[cx] is Call) { return 0 }
  const ct = monoCallValueTy(cx, ctx, 0)
  if ct >= 0 { nodeTyRecord(cx, ct) }
  const t = monoCallValueTy(ix, ctx, 0)
  if t >= 0 { nodeTyRecord(ix, t) }
  0
}

// The type call `ix` yields at this instance: the result of the function type a call it calls
// yields, or else a named callee's declared return (`monoNamedCallTy`); -1 when unknown.
function monoCallValueTy(ix: i32, ctx: i32, depth: i32): i32 {
  if ix < 0 || depth > 16 { return -1 }
  const n = P.nodes[ix]
  if !(n is Call) { return -1 }
  const cx = unwrapParen(n.callFn)
  if cx < 0 { return -1 }
  if P.nodes[cx] is Call {
    const ct = monoCallValueTy(cx, ctx, depth + 1)
    if ct < 0 || ct >= T.tys.length { return -1 }
    const f = T.tys[ct]
    if f is TyFunc {
      if f.fnRet >= 0 && !tyHasTyVar(f.fnRet) { return f.fnRet }
    }
    return -1
  }
  monoNamedCallTy(cx, ctx)
}

// The declared return of the function callee `cx` names in frame `ctx`; -1 when it is no name, a
// parameter or local shadows it, or the type still names a type variable.
function monoNamedCallTy(cx: i32, ctx: i32): i32 {
  const c = P.nodes[cx]
  if !(c is Ident) { return -1 }
  if monoNameShadowedAt(c.identName, cx, ctx) { return -1 }
  const fe = fnIndexOfInScopeAt(sidOfNode(cx), c.identName, ctx, cx)
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const fn = P.nodes[fnStmts[fe]]
  if !(fn is FuncDecl) || fn.fnRet < 0 { return -1 }
  const rt = nodeTyIxOf(fn.fnRet)
  if rt < 0 || tyHasTyVar(rt) { return -1 }
  rt
}

// Whether list literal `ix` holds a generic function value, at any list depth.
function monoLitHoldsGenericFn(ix: i32, depth: i32): boolean {
  const x = unwrapParen(ix)
  if x < 0 || depth > 8 { return false }
  const n = P.nodes[x]
  if n is ArrayLit {
    for e in n.arrElems {
      if (
        monoCalleeIsGeneric(unwrapParen(e))
        || monoLitHoldsGenericFn(e, depth + 1)
      ) {
        return true
      }
    }
  }
  false
}

// The call's argument value nodes paired with the declaration's parameters: a named call
// (`f(b: 1, a: 2)`) binds by name, so `callArgs[i]` is not parameter `i`'s argument (D2344).
// A positional call, or a named one that does not bind every slot, keeps its source order.
function monoArgsInParamOrder(callIx: i32, declIx: i32): i32[] {
  const c = P.nodes[callIx]
  if c is Call {
    if !hasNamedArgs(c.callArgNames) { return c.callArgs }
    if declIx < 0 { return c.callArgs }
    const fn = P.nodes[declIx]
    if fn is FuncDecl {
      const pNames: string[] = []
      let i = 0
      while i < fn.fnParams.length {
        const p = P.nodes[fn.fnParams[i]]
        if p is Param { pNames.push(p.parName) }
        i = i + 1
      }
      const slots = orderArgsByParamNames(pNames, c.callArgs, c.callArgNames)
      if slots.length != fn.fnParams.length { return c.callArgs }
      let k = 0
      while k < slots.length {
        if slots[k] < 0 { return c.callArgs }
        k = k + 1
      }
      return slots
    }
    return c.callArgs
  }
  const none: i32[] = []
  none
}

// Whether argument `ax` is an empty list literal, which names no element to bind a `T` from.
function monoArgIsEmptyLit(ax: i32): boolean {
  const n = P.nodes[unwrapParen(ax)]
  if n is ArrayLit { return n.arrElems.length == 0 }
  false
}

// Whether pin type `t` is a function type.
function monoPinIsFnTy(t: i32): boolean {
  t >= 0 && t < T.tys.length && T.tys[t] is TyFunc
}

// A binding of `fn`'s body annotated with one type parameter and seeded from a parameter of
// another, where the two bind different function instances, asks the split to give the
// binding the parameter's type (D6703), and fails; 0 when no binding does.
function monoLetTyParamMisfit(
  fn: FuncDecl,
  params: i32[],
  tvN: string[],
  tvV: string[],
  pinTys: i32[],
): i32 {
  const stack: i32[] = [fn.fnBody]
  while stack.length > 0 {
    const ix = stack.pop()
    if ix >= 0 && ix < P.nodes.length {
      const n = P.nodes[ix]
      if n is LetDecl && n.letType >= 0 && n.letInit >= 0 {
        let j = 0
        while j < params.length && j < pinTys.length {
          if monoLetSeedMisfits(fn, n, params[j], pinTys[j], tvN, tvV) {
            fsAskTyParam(params[j])
            return emitFail(
              "emitProgram: monomorphize: `"
                + n.letName
                + "` is seeded from a parameter of another type parameter, and the two take"
                + " different instances in a call to `"
                + fn.fnName
                + "`",
            )
          }
          j += 1
        }
      }
      for c in nodeChildren(ix) { stack.push(c) }
    }
  }
  0
}

// Whether binding `n`, annotated bare with a type parameter of `fn`, is seeded by a read of
// parameter `pd`, annotated bare with another, pinned at function type `pinTy`, and the two
// type parameters bind different instances; or `pd` is un-annotated and the binding's type
// parameter took the unbound default (D6760).
function monoLetSeedMisfits(
  fn: FuncDecl,
  n: LetDecl,
  pd: i32,
  pinTy: i32,
  tvN: string[],
  tvV: string[],
): boolean {
  const v = unwrapParen(n.letInit)
  if v < 0 || !(P.nodes[v] is Ident) || identDeclOf(v) != pd { return false }
  if n.letType < 0 || n.letType >= P.nodes.length { return false }
  const tn = P.nodes[n.letType]
  const pn = P.nodes[pd]
  if !(tn is TypeRef) || !(pn is Param) { return false }
  if pn.parType < 0 {
    return strListHas(fn.fnTyParams, tn.tyName)
      && monoBindOf(tvN, tvV, tn.tyName) == MONO_UNBOUND_TY_PARAM_DEFAULT
      && (pinTy < 0 || monoPinIsFnTy(pinTy))
  }
  const pt = P.nodes[pn.parType]
  if !(pt is TypeRef) || pt.tyName == tn.tyName { return false }
  if (
    !strListHas(fn.fnTyParams, tn.tyName)
    || !strListHas(fn.fnTyParams, pt.tyName)
  ) {
    return false
  }
  const x = monoBindOf(tvN, tvV, tn.tyName)
  x != "" && x != monoBindOf(tvN, tvV, pt.tyName) && monoPinIsFnTy(pinTy)
}

// Binds, ahead of `monoInstantiate`'s first-use loop, each type parameter whose first use is
// an empty list literal (`f([], d)`), from its first use that names an element: that loop
// would bind it to the literal's `i32[]` default, which the checker never inferred (D2607).
function monoPreBindPastEmptyLit(
  params: i32[],
  args: i32[],
  typarams: string[],
  ctx: i32,
  tvN: string[],
  tvV: string[],
) {
  const seen: {[string]: i32} = Map()
  let i = 0
  while i < args.length && i < params.length {
    const tp = monoParamBareTyParam(params[i], typarams)
    if tp != "" && !seen.has(tp) {
      // arena-tick exempt: a local dedupe map, not the arena.
      seen[tp] = 1
      if monoBindOf(tvN, tvV, tp) == "" && monoArgIsEmptyLit(args[i]) {
        monoBindFromLaterArg(tp, i + 1, params, args, typarams, ctx, tvN, tvV)
      }
    }
    i = i + 1
  }
  0
}

// Binds `tp` from the first argument at or after `from` whose parameter rides it bare and
// which is not an empty list literal. Binds nothing when no such argument names an element.
function monoBindFromLaterArg(
  tp: string,
  from: i32,
  params: i32[],
  args: i32[],
  typarams: string[],
  ctx: i32,
  tvN: string[],
  tvV: string[],
) {
  let j = from
  while j < args.length && j < params.length {
    const pj = P.nodes[params[j]]
    if pj is Param {
      if (
        monoParamBareTyParam(params[j], typarams) == tp
        && !monoArgIsEmptyLit(args[j])
      ) {
        const annj = monoDeclAnnName(pj.parType, tyNameOf(pj.parType), typarams)
        const an = monoArgPinName(args[j], ctx)
        if an == "" { return 0 }
        let bind = an
        if annj != tp {
          if !nameIsArray(an) { return 0 }
          bind = listElemNameOf(an)
        }
        tvN.push(tp)
        tvV.push(bind)
        return 0
      }
    }
    j = j + 1
  }
  0
}

// Whether parameter annotation `ann` at argument `act` binds only after the call's others: a
// union the checker's walk passes over, or one whose argument leaves its type parameter free.
function monoPinDefers(ann: string, act: string, typarams: string[]): boolean {
  monoAnnIsOpenUnion(ann, typarams)
    || monoUnionLeavesOpenFree(ann, act, typarams)
}

// Per parameter of the call being instantiated: the argument's own spelling where the union
// parameter's substituted spelling cannot hold it, else "" (`monoPreBindPastUnionRest`).
let monoUnionRestPin: string[] = []

// Where some parameter's annotation is a union over a type parameter (`u: T | string`), binds
// every other type-parameter annotation from its argument first, so the union only fills a
// type parameter nothing else binds, as the checker's inference does (D2734).
function monoPreBindPastUnionRest(
  params: i32[],
  args: i32[],
  typarams: string[],
  ctx: i32,
  tvN: string[],
  tvV: string[],
) {
  monoUnionRestPin = []
  let z = 0
  while z < params.length {
    monoUnionRestPin.push("")
    z = z + 1
  }
  const anns: string[] = []
  const acts: string[] = []
  let any = false
  let i = 0
  while i < params.length && i < args.length {
    let ann = ""
    let act = ""
    const p = P.nodes[params[i]]
    if p is Param {
      if p.parType >= 0 {
        ann = monoDeclAnnName(p.parType, tyNameOf(p.parType), typarams)
        if annArrowAt(ann) >= 1 || !monoAnnHasTyParam(ann, typarams) {
          ann = ""
        }
      }
    }
    // Only a union annotation can defer, so only its argument is spelled here: a pin name
    // renders the whole argument type, which a wide type makes dear.
    if ann != "" && unionMemberCount(ann) > 1 {
      act = monoPreBindArgName(args[i], ctx)
      if act != "" && monoPinDefers(ann, act, typarams) { any = true }
    }
    anns.push(ann)
    acts.push(act)
    i = i + 1
  }
  if !any { return 0 }
  let a = 0
  while a < anns.length {
    // arena-tick exempt: the call's own argument-name column, not an arena node.
    if anns[a] != "" && acts[a] == "" {
      acts[a] = monoPreBindArgName(args[a], ctx)
    }
    a = a + 1
  }
  let j = 0
  while j < anns.length {
    if anns[j] != "" && acts[j] != "" {
      if !monoPinDefers(anns[j], acts[j], typarams) {
        monoBindFromAnn(anns[j], acts[j], typarams, tvN, tvV)
      }
    }
    j = j + 1
  }
  // A union parameter whose spelling, at the bindings above, cannot hold its argument is pinned
  // at the argument's own type, as an un-annotated parameter is, so the two reps agree.
  let k = 0
  while k < anns.length {
    if anns[k] != "" && acts[k] != "" {
      if monoAnnIsOpenUnion(anns[k], typarams) {
        const sub = monoSubstAnn(anns[k], typarams, tvN, tvV)
        if (
          sub != ""
          && !monoAtomsCover(canonEmitName(sub), canonEmitName(acts[k]))
        ) {
          // arena-tick exempt: the call's own pin column, not an arena node.
          monoUnionRestPin[k] = acts[k]
        }
      }
    }
    k = k + 1
  }
  monoBindBareArenaPins(params, args, typarams, ctx)
  0
}

// Adds to the call's arena bindings (`monoExplicitBN`/`monoExplicitBT`) each type parameter a
// bare `T` parameter binds from its argument's type, so a union parameter over `T` is minted at
// the bound type exactly as an explicit type argument mints it (D2734).
function monoBindBareArenaPins(
  params: i32[],
  args: i32[],
  typarams: string[],
  ctx: i32,
) {
  let i = 0
  while i < params.length && i < args.length {
    const p = P.nodes[params[i]]
    if p is Param {
      if p.parType >= 0 {
        const ann = monoDeclAnnName(p.parType, tyNameOf(p.parType), typarams)
        const tp = monoTyParamOf(ann, typarams)
        if tp != "" && tp == ann && !strListHas(monoExplicitBN, tp) {
          const at = monoExactPinTyOf(monoArgPinTyIx(args[i], ctx), ctx)
          if at >= 0 && !tyHasTyVar(at) {
            monoExplicitBN.push(tp)
            monoExplicitBT.push(at)
          }
        }
      }
    }
    i = i + 1
  }
  0
}

// The pin name of argument `ax` for the pre-bind: a bare `null` names no type a parameter could
// bind from, whatever its default pin.
function monoPreBindArgName(ax: i32, ctx: i32): string {
  if P.nodes[unwrapParen(ax)] is NullLit { return "null" }
  monoArgPinName(ax, ctx)
}

// Whether every atom of union spelling `inner` is an atom of `outer`.
function monoAtomsCover(outer: string, inner: string): boolean {
  const os: string[] = []
  unionSetAtomsOf(outer, os)
  const ins: string[] = []
  unionSetAtomsOf(inner, ins)
  let i = 0
  while i < ins.length {
    let hit = false
    let j = 0
    while j < os.length && !hit {
      if normTypeAtom(os[j]) == normTypeAtom(ins[i]) { hit = true }
      j = j + 1
    }
    if !hit { return false }
    i = i + 1
  }
  true
}

// Instantiate (or reuse) the instance of generic `origFe` for the call at
// `callIx` (whose enclosing function is `ctx`, -1 = top level), and point the
// call site at it. Returns 0, or -1 via `emitFail`.
function monoInstantiate(origFe: i32, callIx: i32, ctx: i32) {
  const saved = monoDestPinOff
  monoDestPinOff = monoCalleeHasTyParamArrow(origFe)
  const c = P.nodes[callIx]
  if ctx < 0 && c is Call {
    monoOpenArgCall = callIx
    monoOpenArgCallee = c.callFn
  }
  const r = monoInstantiateCall(origFe, callIx, ctx)
  monoOpenArgCall = 0 - 1
  monoOpenArgCallee = 0 - 1
  monoDestPinOff = saved
  r
}

// Whether the generic at `origFe` declares a function-typed parameter that mentions one of its
// type parameters: a lambda argument there is built at the type the checker bound, so a list
// argument may not be re-pinned at its destination's list (D2747).
function monoCalleeHasTyParamArrow(origFe: i32): boolean {
  if origFe < 0 || origFe >= monoOrigNode.length { return false }
  const fn = P.nodes[monoOrigNode[origFe]]
  if fn is FuncDecl {
    let i = 0
    while i < fn.fnParams.length {
      const p = P.nodes[fn.fnParams[i]]
      if p is Param {
        if p.parType >= 0 {
          const ann = monoDeclAnnName(
            p.parType,
            tyNameOf(p.parType),
            fn.fnTyParams,
          )
          if annArrowAt(ann) >= 1 && monoAnnHasTyParam(ann, fn.fnTyParams) {
            return true
          }
        }
      }
      i = i + 1
    }
  }
  false
}

// Whether parameter `pIx` is annotated as a list whose spelling names one of `typarams`.
function monoParamIsTyParamList(pIx: i32, typarams: string[]): boolean {
  const p = P.nodes[pIx]
  if p is Param {
    if p.parType < 0 { return false }
    const ann = monoDeclAnnName(p.parType, tyNameOf(p.parType), typarams)
    return nameIsArray(ann) && monoAnnHasTyParam(ann, typarams)
  }
  false
}

// What a pattern `ann` riding an object shape binds against for argument `argIx` pinned `anC`:
// the argument's own type spelled by its fields where `anC` is a declared name, which a shape
// pattern cannot pair fields with (D3674). The arena type, not the name, since a field-set scan
// can name a record the argument is not (D3146). `anC` everywhere else.
function monoArgBindSpelling(ann: string, anC: string, argIx: i32): string {
  if ann.indexOf("{") < 0 || anC.indexOf("{") >= 0 || anC.indexOf("#") >= 0 {
    return anC
  }
  const sp = tyToEmitName(nodeTyIxOf(unwrapParen(argIx)))
  if sp == "" || sp.indexOf("{") < 0 { return anC }
  sp
}

// The one place a generic `argIx` handed to hole `pIx` of call `callIx` gets its signature: the
// checker's binding, else the generic instanced at the one flow pin of its read past the call
// (D5612), delivered concretely so the callee can forward it. "" when none closes; `tyOut[0]`
// takes the pin's type. Two pins ask for a parameter per pin and set `monoHoleGenTwoPins` (D6280).
let monoHoleGenTwoPins = false
// Whether that read's flow slot holds two pins, whoever's calls took them.
let monoHoleGenManyPins = false
function monoHoleGenFnPin(
  callIx: i32,
  pIx: i32,
  argIx: i32,
  ctx: i32,
  tyOut: i32[],
): string {
  monoHoleGenTwoPins = false
  monoHoleGenManyPins = false
  const bt = monoHoleGenFnTy(callIx, pIx, argIx, ctx)
  const fl = monoHoleGenFnFlowDecl(argIx, ctx)
  if bt >= 0 {
    // The checker's binding stands; the open function values its pin call hands on still take
    // that binding's parameter types (D6532).
    const an = monoFnPinAt(argIx, ctx, bt, -1, tyOut)
    if an != "" && fl[1] >= 0 { monoPinOpenCallLams(fl[1], bt) }
    return an
  }
  const ft = monoHoleGenFnFlowTy(argIx, fl)
  // The plan decides whether the hole is called at two types; the flow pins may stop at a
  // recursive forward before they reach both (D6091).
  if ft < 0 && fl[1] >= 0 {
    fsAsk(pIx)
    const noPath: string[] = []
    monoHoleGenManyPins = monoDeclPathPins(fl, noPath).length > 1
    monoHoleGenTwoPins = monoHoleGenManyPins
      && monoHoleOwnCallsDiffer(fl[1], pIx)
  }
  monoFnPinAt(argIx, ctx, ft, fl[1], tyOut)
}

// Whether two of the calls pinning the slot of `d` call the hole `pIx` itself, at different
// parameter types; pins taken downstream of it, by a binding or another callee, do not count.
function monoHoleOwnCallsDiffer(d: i32, pIx: i32): boolean {
  const noPath: string[] = []
  let first: i32[] = []
  let seen = false
  for cx in fnFlowDeclPathPinCalls(d, noPath) {
    const c = P.nodes[cx]
    if c is Call {
      const f = unwrapParen(c.callFn)
      if f >= 0 && P.nodes[f] is Ident && identDeclOf(f) == pIx {
        const tys = fnFlowDeclPathPinTysAt(d, noPath, cx)
        if tys.length > 0 {
          if !seen {
            first = tys
            seen = true
          } else if !monoI32sSame(first, tys) {
            return true
          }
        }
      }
    }
  }
  false
}

function monoI32sSame(a: i32[], b: i32[]): boolean {
  if a.length != b.length { return false }
  let i = 0
  while i < a.length {
    if a[i] != b[i] { return false }
    i += 1
  }
  true
}

// `monoHoleGenFnPin` for any other open function value: a binding holding an un-annotated
// lambda or a value typed at a hole function's signature, or a call returning one, at the one
// closed pin the flow table gives it past the call (D6002), else at `bindTy`, the checker's
// binding of the hole at this call (-1 for none, D6112). "" when none closes.
function monoOpenFnFlowPin(
  argIx: i32,
  ctx: i32,
  bindTy: i32,
  tyOut: i32[],
): string {
  const ax = unwrapParen(argIx)
  if ax < 0 { return "" }
  const vt = nodeTyIxOf(ax)
  if vt < 0 || vt >= T.tys.length || !(T.tys[vt] is TyFunc) || !tyHasTyVar(vt) {
    return ""
  }
  let fl = monoReadLetFrame(ax, ctx)
  if fl[1] < 0 {
    if !(P.nodes[ax] is Call) { return "" }
    fl = [ctx, ax]
  }
  const ft = monoHoleGenFnFlowTy(argIx, fl)
  if ft < 0 && bindTy >= 0 && monoTyConcreteFn(bindTy) {
    return monoFnPinAt(argIx, ctx, bindTy, -1, tyOut)
  }
  monoFnPinAt(argIx, ctx, ft, fl[1], tyOut)
}

// `argIx` delivered at the concrete function type `bt`, and its pin name; each call taking the
// flow pin of `flowDecl` (-1 for none) whose callee the checker left open is typed at it.
function monoFnPinAt(
  argIx: i32,
  ctx: i32,
  bt: i32,
  flowDecl: i32,
  tyOut: i32[],
): string {
  const nm = monoConcreteFnTyName(bt)
  if nm == "" { return "" }
  if monoCoerceFnValueName(argIx, nm, ctx, bt) < 0 { return "" }
  // A hole lambda literal no call instances, as one handed to a parameter nothing reads, takes
  // the pin itself; one already instanced keeps its instance (D6301).
  monoLamLitTake(argIx, nm, ctx)
  if flowDecl >= 0 {
    const noPath: string[] = []
    monoRetypePinCalls(flowDecl, noPath)
    monoPinOpenCallLams(flowDecl, bt)
  }
  // arena-tick exempt: a caller-owned out-parameter, not the arena.
  tyOut[0] = bt
  const sk = sigKeyOfTy(bt)
  if sk != "" { return "=>" + sk }
  const an = monoArgFnTypeName(argIx, ctx)
  if an != "" { return an }
  nm
}

// Each hole lambda literal handed to the one call pinning the slot of `d` open takes the parameter
// type of `bt`, the concrete function type that call is delivered at (D6543).
function monoPinOpenCallLams(d: i32, bt: i32) {
  const noPath: string[] = []
  const tys: i32[] = []
  const cx = fnFlowDeclPathOnlyPinCall(d, noPath, tys)
  if cx < 0 || bt < 0 || bt >= T.tys.length { return 0 }
  const c = P.nodes[cx]
  const bf = T.tys[bt]
  if !(c is Call) || !(bf is TyFunc) { return 0 }
  if bf.fnParamTypes.length != c.callArgs.length { return 0 }
  const fns = fnFlowDeclPathPinFns(d, noPath)
  if fns.length != 1 { return 0 }
  let j = 0
  while j < c.callArgs.length {
    const nm = monoConcreteFnTyName(bf.fnParamTypes[j])
    const ax = unwrapParen(c.callArgs[j])
    if (
      nm != ""
      && ax >= 0
      && P.nodes[ax] is Ident
      && monoOpenFnArgDecl(ax) >= 0
    ) {
      monoCoerceFnValueName(ax, nm, fns[0], bf.fnParamTypes[j])
    } else if nm != "" {
      monoLamLitTake(c.callArgs[j], nm, fns[0])
    }
    j = j + 1
  }
  // A callee the checker left open takes `bt`, so a hole function named as an argument is
  // delivered at that parameter type (D6532).
  const cf = unwrapParen(c.callFn)
  const ct = nodeTyIxOf(cf)
  if (
    cf >= 0
    && ct >= 0
    && ct < T.tys.length
    && T.tys[ct] is TyFunc
    && tyHasTyVar(ct)
    && monoWritesTypedAt(d, bf.fnParamTypes)
  ) {
    nodeTyRecord(cf, bt)
  }
  0
}

// The frame and binding (`monoReadLetFrame`) whose flow-table slot holds generic `argIx` read in
// frame `ctx`: the read itself in `ctx` unless it names a `let`; `[-1, -1]` when `argIx` does not
// name a generic.
function monoHoleGenFnFlowDecl(argIx: i32, ctx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1]
  const ax = unwrapParen(argIx)
  if ax < 0 { return none }
  if (
    !monoNamesDeclaredGeneric(ax, ctx)
    && !monoCalleeIsGeneric(ax)
    && monoReadGenFnFe(ax) < 0
  ) {
    return none
  }
  const lf = monoReadLetFrame(ax, ctx)
  if lf[1] >= 0 { return lf }
  const out: i32[] = [ctx, ax]
  out
}

// Generic `argIx`'s signature instanced at slot `lf`'s one closed flow pin as the direct call
// binds it: closed arguments, then an empty list's element at `i32` (D6542); with no closed pin,
// the call's un-annotated lambdas at what the rest bind (D6543). -1 for no pin, two, a parameter
// that does not fit, or a type variable left open.
function monoHoleGenFnFlowTy(argIx: i32, lf: i32[]): i32 {
  if lf[1] < 0 { return -1 }
  const noPath: string[] = []
  const pins = monoDeclPathPins(lf, noPath)
  let ps: i32[] = []
  let cx = -1
  if pins.length == 1 {
    ps = fnFlowDeclPathPinTysOf(lf[1], noPath, pins[0])
  } else if pins.length == 0 {
    cx = fnFlowDeclPathOnlyPinCall(lf[1], noPath, ps)
    if cx < 0 { return -1 }
  } else {
    return -1
  }
  const vt = nodeTyIxOf(unwrapParen(argIx))
  if vt < 0 || vt >= T.tys.length || ps.length == 0 || !tyHasTyVar(vt) {
    return -1
  }
  const vf = T.tys[vt]
  if !(vf is TyFunc) || vf.fnParamTypes.length != ps.length { return -1 }
  const gN: string[] = []
  const gT: i32[] = []
  let j = 0
  while j < ps.length {
    if !tyHasTyVar(ps[j]) { bindGenWalk(vf.fnParamTypes[j], ps[j], gN, gT) }
    j = j + 1
  }
  j = 0
  while j < ps.length {
    const pa = T.tys[vf.fnParamTypes[j]]
    if pa is TyArray && monoPinIsEmptyListHole(ps[j]) && pa.aElem >= 0 {
      const pe = T.tys[pa.aElem]
      if pe is TyVar && bindOf(gN, gT, pe.tvName) < 0 {
        gN.push(pe.tvName)
        gT.push(i32TyIx())
      }
    }
    j = j + 1
  }
  if cx >= 0 {
    monoHoleGenBindLamArgs(vf, cx, ps, gN, gT)
    monoHoleGenBindFnArgs(argIx, vf, cx, ps, gN, gT)
  }
  j = 0
  while j < ps.length {
    if tyHasTyVar(ps[j]) { bindGenWalk(vf.fnParamTypes[j], ps[j], gN, gT) }
    j = j + 1
  }
  const inst = substTyDeep(vt, gN, gT)
  if !monoTyConcreteFn(inst) { return -1 }
  inst
}

// Binds, into `gN`/`gT`, each un-annotated lambda argument of pin call `cx` (pinned open at `ps`)
// at the result its body gives under the other arguments' bindings (`holeLamRetAt`, D6543).
function monoHoleGenBindLamArgs(
  vf: TyFunc,
  cx: i32,
  ps: i32[],
  gN: string[],
  gT: i32[],
) {
  const c = P.nodes[cx]
  if !(c is Call) || c.callArgs.length != ps.length { return 0 }
  let j = 0
  while j < ps.length {
    const lx = unwrapParen(c.callArgs[j])
    const p = vf.fnParamTypes[j]
    const pf = T.tys[p]
    if lx >= 0 && P.nodes[lx] is FuncDecl && pf is TyFunc && tyHasTyVar(ps[j]) {
      const noN: string[] = []
      const noT: i32[] = []
      const r = holeLamRetAt(lx, substTyDeep(p, gN, gT), noN, noT)
      if r >= 0 { bindGenWalk(pf.fnRet, r, gN, gT) }
    }
    j = j + 1
  }
  0
}

// Binds, into `gN`/`gT`, each parameter of hole function `argIx` that pin call `cx` hands an open
// function (a hole function's name, or an un-annotated lambda) at the type its own body calls it
// with: the one closed pin of that parameter's slot, returning what the argument's body gives
// there (D6532).
function monoHoleGenBindFnArgs(
  argIx: i32,
  vf: TyFunc,
  cx: i32,
  ps: i32[],
  gN: string[],
  gT: i32[],
) {
  const c = P.nodes[cx]
  const ax = unwrapParen(argIx)
  if !(c is Call) || c.callArgs.length != ps.length || ax < 0 { return 0 }
  if !(P.nodes[ax] is Ident) { return 0 }
  const dx = monoOpenFnArgDecl(ax)
  if dx < 0 { return 0 }
  const fd = P.nodes[dx]
  if !(fd is FuncDecl) || fd.fnParams.length != ps.length { return 0 }
  let j = 0
  while j < ps.length {
    const pv = vf.fnParamTypes[j]
    const lx = monoOpenFnArgDecl(c.callArgs[j])
    if lx >= 0 && tyHasTyVar(ps[j]) && monoTyLeftOpen(pv, gN, gT) {
      const qs: i32[] = []
      const noPath: string[] = []
      let closed = fnFlowDeclPathAgreedPinTys(fd.fnParams[j], noPath, qs)
      for q in qs {
        if tyHasTyVar(q) { closed = false }
      }
      if closed {
        const r = monoFnDeclRetAt(lx, qs)
        if r >= 0 { bindGenWalk(pv, mkFuncTy(qs, r), gN, gT) }
      }
    }
    j = j + 1
  }
  0
}

// The pin of a list literal of open function values (`[h]`) handed to
// un-annotated parameter `i` of `decl`: a list of the function type its body calls an element at,
// the one agreed pin of the parameter's element slot, with the elements' own result there; ""
// when the list, the pin or the result does not close (D6601).
function monoOpenFnListPin(
  decl: i32,
  argIx: i32,
  i: i32,
  ctx: i32,
  tyOut: i32[],
): string {
  if decl < 0 || decl >= P.nodes.length { return "" }
  const dn = P.nodes[decl]
  if !(dn is FuncDecl) || i < 0 || i >= dn.fnParams.length { return "" }
  const ax = unwrapParen(argIx)
  if ax < 0 { return "" }
  const at = nodeTyIxOf(ax)
  if at < 0 || at >= T.tys.length { return "" }
  const la = T.tys[at]
  if !(la is TyArray) || la.aElem < 0 || la.aElem >= T.tys.length { return "" }
  if !(T.tys[la.aElem] is TyFunc) || !tyHasTyVar(la.aElem) { return "" }
  const al = P.nodes[ax]
  if !(al is ArrayLit) || al.arrElems.length == 0 { return "" }
  const ft = monoListSlotPinnedFnTy(dn.fnParams[i], al.arrElems)
  if ft < 0 || sigKeyOfTy(ft) == "" { return "" }
  // Each element is delivered at that type, a hole function's name as a direct argument is
  // (`monoFnPinAt`).
  const nm = monoConcreteFnTyName(ft)
  if nm != "" {
    for el in al.arrElems {
      const ex = unwrapParen(el)
      if ex < 0 { return "" }
      if P.nodes[ex] is Ident {
        if monoCoerceFnValueName(ex, nm, ctx, ft) < 0 { return "" }
      } else {
        monoLamLitTake(ex, nm, ctx)
      }
    }
  }
  const lt = mkArrayTy(ft)
  // arena-tick exempt: a caller-owned out-parameter, not the arena.
  tyOut[0] = lt
  monoConcreteFnPinName(lt)
}

// The closed result of function declaration `lx` called at the closed parameter types `qs`: its
// body's result for an un-annotated return, its declared return under the parameters' binding
// otherwise; -1 when either stays open.
function monoFnDeclRetAt(lx: i32, qs: i32[]): i32 {
  const noN: string[] = []
  const noT: i32[] = []
  const r = holeLamRetAt(lx, mkFuncTy(qs, i32TyIx()), noN, noT)
  if r >= 0 { return r }
  monoFnTyRetAt(nodeTyIxOf(lx), qs)
}

// The closed result of function type `lt` called at the closed parameter types `qs`, its
// declared result under the parameters' binding; -1 when it stays open or `lt` is no function.
function monoFnTyRetAt(lt: i32, qs: i32[]): i32 {
  if lt < 0 || lt >= T.tys.length { return -1 }
  const lf = T.tys[lt]
  if !(lf is TyFunc) || lf.fnParamTypes.length != qs.length || lf.fnRet < 0 {
    return -1
  }
  const hN: string[] = []
  const hT: i32[] = []
  let k = 0
  while k < qs.length {
    bindGenWalk(lf.fnParamTypes[k], qs[k], hN, hT)
    k = k + 1
  }
  const dr = substTyDeep(lf.fnRet, hN, hT)
  if dr < 0 || tyHasTyVar(dr) { return -1 }
  dr
}

// Whether `pv` still has a type variable `gN`/`gT` leave unbound.
function monoTyLeftOpen(pv: i32, gN: string[], gT: i32[]): boolean {
  tyHasTyVar(substTyDeep(pv, gN, gT))
}

// The function declaration an open function argument `a` names: an un-annotated lambda, or an
// identifier naming a hole function or a `const` holding a lambda; -1 for anything else.
function monoOpenFnArgDecl(a: i32): i32 {
  const x = unwrapParen(a)
  if x < 0 { return -1 }
  const n = P.nodes[x]
  if n is FuncDecl { return x }
  if !(n is Ident) { return -1 }
  const d = identDeclOf(x)
  if d < 0 || d >= P.nodes.length { return -1 }
  const dn = P.nodes[d]
  if dn is FuncDecl { return d }
  if !(dn is LetDecl) || dn.letKw != "const" { return -1 }
  const lx = unwrapParen(dn.letInit)
  if lx < 0 || !(P.nodes[lx] is FuncDecl) { return -1 }
  lx
}

// Whether flow pin `t` is a list whose element is an inference hole, as `[]` pins.
function monoPinIsEmptyListHole(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const a = T.tys[t]
  if a is TyArray { return a.aElem < 0 || tyIsParamHole(a.aElem) }
  false
}

// The concrete function type the checker bound hole parameter `pIx` to at call `callIx`, when
// `argIx` (in frame `ctx`) is a generic function: named, through never-written aliases, an `if`
// naming one in every arm, or a value typed at a foreign generic's open signature, as a call
// returning one is (D5401); -1 otherwise.
function monoHoleGenFnTy(callIx: i32, pIx: i32, argIx: i32, ctx: i32): i32 {
  const ax = unwrapParen(argIx)
  if ax < 0 { return -1 }
  if (
    !monoCalleeIsGeneric(ax)
    && monoReadGenFnFe(ax) < 0
    && !tyIsForeignGenericSig(nodeTyIxOf(ax))
    && !(P.nodes[ax] is IfStmt && monoValueNamesGenerics(ax, ctx, 0))
  ) {
    return -1
  }
  const pt = nodeTyIxOf(pIx)
  if pt < 0 || pt >= T.tys.length { return -1 }
  const pv = T.tys[pt]
  if !(pv is TyVar) { return -1 }
  let bc = callIx
  if !callBindHas(callIx) { bc = monoCallTplOf(callIx) }
  const bt = callBindTyOf(bc, pv.tvName)
  if bt < 0 || bt >= T.tys.length || tyHasTyVar(bt) { return -1 }
  if !(T.tys[bt] is TyFunc) { return -1 }
  bt
}

// Whether parameter `pIx` of `fn`, handed the parameter read `argIx` pinned at function type
// `pinTy`, is called in `fn`'s body with a closed argument the pin's parameter does not take, as
// a recursion handing two such parameters back in swapped positions does (D6202).
function monoFwdFnPinMisfits(
  fn: FuncDecl,
  pIx: i32,
  argIx: i32,
  pinTy: i32,
): boolean {
  if !monoReadsParam(argIx) || pinTy < 0 || pinTy >= T.tys.length {
    return false
  }
  const pf = T.tys[pinTy]
  if !(pf is TyFunc) { return false }
  const stack: i32[] = [fn.fnBody]
  while stack.length > 0 {
    const ix = stack.pop()
    if ix >= 0 && ix < P.nodes.length {
      const n = P.nodes[ix]
      if (
        n is Call
        && n.callFn >= 0
        && n.callFn < P.nodes.length
        && P.nodes[n.callFn] is Ident
        && identDeclOf(n.callFn) == pIx
        && monoCallArgsMisfit(n, pf)
      ) {
        return true
      }
      for c in nodeChildren(ix) { stack.push(c) }
    }
  }
  false
}

// Whether call `n` passes as many arguments as `pf` takes and one of them, closed, is a type
// unrelated to `pf`'s parameter at its position (`monoArgRelated`).
function monoCallArgsMisfit(n: Call, pf: TyFunc): boolean {
  if n.callArgs.length != pf.fnParamTypes.length { return false }
  let k = 0
  while k < n.callArgs.length {
    const at = nodeTyIxOf(n.callArgs[k])
    if at >= 0 && !tyHasTyVar(at) && !monoArgRelated(at, pf.fnParamTypes[k]) {
      return true
    }
    k = k + 1
  }
  false
}

// Whether argument type `at` fits parameter type `pt` or one of `pt`'s members fits `at`, as a
// member literal read at its widened type does (`"y"` as `string` against `"x" | "y" | null`).
function monoArgRelated(at: i32, pt: i32): boolean {
  if assignable(at, pt) { return true }
  const ms: i32[] = []
  flattenVariantsInto(pt, ms)
  for m in ms {
    if m >= 0 && assignable(m, at) { return true }
  }
  false
}

// Whether hole parameter `pIx` of `fn`, pinned at function type `pinTy`, is copied (`b = a`,
// `let b = a`, through further copies) into a binding that `fn`'s body calls with a closed
// argument the pin does not take; the split plan gives the parameter one per type (D6520).
function monoHoleCopyCallsMisfit(fn: FuncDecl, pIx: i32, pinTy: i32): boolean {
  if pinTy < 0 || pinTy >= T.tys.length { return false }
  const pf = T.tys[pinTy]
  if !(pf is TyFunc) { return false }
  const copies: i32[] = [pIx]
  const nodes: i32[] = []
  const stack: i32[] = [fn.fnBody]
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      nodes.push(ix)
      for c in nodeChildren(ix) { stack.push(c) }
    }
  }
  let grew = true
  let rounds = 0
  while grew && rounds < MONO_ALIAS_CHAIN_MAX {
    grew = false
    rounds = rounds + 1
    for ix in nodes {
      const d = monoCopyDeclOf(ix, copies)
      if d >= 0 && !i32ListHas(copies, d) {
        copies.push(d)
        grew = true
      }
    }
  }
  if copies.length == 1 { return false }
  for ix in nodes {
    const n = P.nodes[ix]
    if n is Call {
      const f = unwrapParen(n.callFn)
      if f >= 0 && P.nodes[f] is Ident {
        const d = identDeclOf(f)
        if d != pIx && i32ListHas(copies, d) && monoCallArgsMisfit(n, pf) {
          return true
        }
      }
    }
  }
  false
}

// The `let` node `ix` copies a read of one of `from` into (`b = a`, `let b = a`); -1 otherwise.
function monoCopyDeclOf(ix: i32, from: i32[]): i32 {
  const n = P.nodes[ix]
  if n is LetDecl {
    const v = unwrapParen(n.letInit)
    if v >= 0 && P.nodes[v] is Ident && i32ListHas(from, identDeclOf(v)) {
      return ix
    }
    return -1
  }
  if !(n is BinExpr) || n.binOp != "=" { return -1 }
  const v = unwrapParen(n.binRight)
  if v < 0 || !(P.nodes[v] is Ident) || !i32ListHas(from, identDeclOf(v)) {
    return -1
  }
  if !(P.nodes[n.binLeft] is Ident) { return -1 }
  const d = identDeclOf(n.binLeft)
  if d >= 0 && d < P.nodes.length && P.nodes[d] is LetDecl { return d }
  -1
}

// Whether argument `argIx` reads a parameter of the function it is in.
function monoReadsParam(argIx: i32): boolean {
  const ax = unwrapParen(argIx)
  if ax < 0 || !(P.nodes[ax] is Ident) { return false }
  const d = identDeclOf(ax)
  d >= 0 && d < P.nodes.length && P.nodes[d] is Param
}

// The refusal `monoFwdFnPinMisfits` answers when the split plan cannot give the parameter a
// slot per type.
function monoFwdFnPinFail(par: string, callee: string): i32 {
  emitFail(
    "emitProgram: monomorphize: a function parameter handed on to `"
      + par
      + "` in a call to `"
      + callee
      + "` is called there at a type it does not take",
  )
}

// The refusal for a generic parameter `par` of `callee` whose reads the flow pins at two types
// no split separates, as a copy into a binding called at another type does (D6423). Recorded
// without halting, so the compile still asks for every split it reaches.
function monoHoleManyPinsFail(par: string, callee: string): i32 {
  emitFail(
    "emitProgram: monomorphize: parameter `"
      + par
      + "` of `"
      + callee
      + "` is called at two function types that no parameter per type separates",
  )
}

// The pin for the parameter of template `oDecl` handed `argIx` when the argument, or each element
// of its list literal, is hole functions whose value reaches nothing (`vrInert`): the
// stub's `() -> void` (D6881, D7002), a called one's closure taken unread (D6931, D7000). ""
// otherwise; `tyOut[0]` takes the type.
function monoInertParamStubPin(oDecl: i32, argIx: i32, tyOut: i32[]): string {
  if oDecl < 0 || argIx < 0 || argIx >= P.nodes.length { return "" }
  const fes: i32[] = []
  const at: i32[] = []
  const ax = unwrapParen(argIx)
  if ax < 0 { return "" }
  const al = P.nodes[ax]
  let list = false
  if al is ArrayLit {
    if al.arrElems.length == 0 { return "" }
    for e in al.arrElems {
      if !monoInertArgFns(e, fes, at, 0) { return "" }
    }
    list = true
  } else if !monoInertArgFns(argIx, fes, at, 0) {
    return ""
  }
  if fes.length == 0 { return "" }
  const kept: boolean[] = []
  let j = 0
  while j < fes.length {
    if !vrInert(at[j], "") { return "" }
    const g = monoFlowLeafGen(at[j])
    const k = (g >= 0 && monoFlowGenCalled(g))
      || !vrReadsInert(monoOrigNode[fes[j]])
    if !k && monoInstantiatedAny(fes[j]) { return "" }
    kept.push(k)
    j = j + 1
  }
  const noPs: i32[] = []
  let st = mkFuncTy(noPs, TY_VOID)
  let nm = ""
  if list {
    st = mkArrayTy(st)
    nm = monoConcreteFnPinName(st)
  } else {
    const sk = sigKeyOfTy(st)
    if sk != "" { nm = "=>" + sk }
  }
  if nm == "" { return "" }
  j = 0
  while j < fes.length {
    monoReachNote(at[j], kept[j])
    if !kept[j] {
      monoInertArgAt.push(at[j])
      monoInertArgFe.push(fes[j])
    }
    j = j + 1
  }
  // arena-tick exempt: the caller's out-parameter, not an arena row any pass reads.
  tyOut[0] = st
  nm
}

// Appends to `fes` each hole function value `v` can be, and to `at` the name reading it: `v`
// names one, is an un-annotated `const` binding whose initializer can only be such, is an `if`
// whose arms can only be such, or calls a function every value it returns can be (D6911). False
// when some value it can be is none of those.
function monoInertArgFns(v: i32, fes: i32[], at: i32[], depth: i32): boolean {
  if v < 0 || v >= P.nodes.length { return false }
  const x = unwrapParen(v)
  if x < 0 || depth > 8 { return false }
  const n = P.nodes[x]
  if n is Call {
    const cd = monoCalleeDeclOf(n)
    if cd < 0 { return false }
    return monoRetValueFns(cd, fes, at, depth + 1)
  }
  // An `if` is each of its arms' values; an arm ending in a call that never returns has none.
  if n is IfStmt {
    if n.ifElse < 0 { return false }
    const tn = monoArmEndsNever(n.ifThen)
    const en = monoArmEndsNever(n.ifElse)
    if tn && en { return false }
    const arms: i32[] = []
    if !tn { monoBlockTailInto(n.ifThen, arms) }
    if P.nodes[n.ifElse] is IfStmt { arms.push(n.ifElse) }
    else if !en { monoBlockTailInto(n.ifElse, arms) }
    let want = 2
    if tn || en { want = 1 }
    if arms.length != want { return false }
    for a in arms {
      if !monoInertArgFns(a, fes, at, depth + 1) { return false }
    }
    return true
  }
  if !(n is Ident) { return false }
  if monoCalleeIsGeneric(x) {
    const fe = fnIndexOfNode(x)
    if fe < 0 || fe >= monoOrigNode.length { return false }
    fes.push(fe)
    at.push(x)
    return true
  }
  const d = identDeclOf(x)
  if d < 0 || d >= P.nodes.length { return false }
  const ld = P.nodes[d]
  if (
    !(ld is LetDecl)
    || ld.letKw != "const"
    || ld.letType >= 0
    || ld.letInit < 0
  ) {
    return false
  }
  monoInertArgFns(ld.letInit, fes, at, depth + 1)
}

// `monoInertArgFns` over every value function declaration `fd` returns: each `return`'s
// argument in its own frame, and its body's last statement when that is no `return`.
function monoRetValueFns(fd: i32, fes: i32[], at: i32[], depth: i32): boolean {
  const f = P.nodes[fd]
  if !(f is FuncDecl) || f.fnBody < 0 { return false }
  const b = P.nodes[f.fnBody]
  if !(b is Block) || b.blkStmts.length == 0 { return false }
  const tail = b.blkStmts[b.blkStmts.length - 1]
  if !(P.nodes[tail] is RetStmt) && !monoInertArgFns(tail, fes, at, depth) {
    return false
  }
  const stack: i32[] = [f.fnBody]
  while stack.length > 0 {
    const ix = stack.pop()
    if ix >= 0 && ix < P.nodes.length {
      const n = P.nodes[ix]
      if n is RetStmt && vrFrameOf(ix) == fd {
        if !monoInertArgFns(n.retArg, fes, at, depth) { return false }
      }
      for ch in nodeChildren(ix) { stack.push(ch) }
    }
  }
  true
}

// Each argument `monoInertParamStubPin` pinned at the stub, and the function it names.
let monoInertArgAt: i32[] = []
let monoInertArgFe: i32[] = []

// The refusal for each `monoInertParamStubPin` argument whose function the prune did not stub:
// another use instanced or read it, so the pinned `() -> void` is not its signature.
function monoInertArgsStubbed(): i32 {
  let i = 0
  while i < monoInertArgAt.length {
    if !i32ListHas(monoStubSlots, monoInertArgFe[i]) {
      const n = P.nodes[monoInertArgAt[i]]
      let nm = ""
      if n is Ident { nm = n.identName }
      return emitFailAt(
        "emitProgram: monomorphize: `"
          + nm
          + "` is handed to a parameter nothing calls and is also used where it needs a "
          + "signature, so the two uses have no one type — annotate its parameters",
        monoInertArgAt[i],
      )
    }
    i = i + 1
  }
  0
}

// The refusal for a parameter `par` of `callee` no argument pin closes.
function monoArgTyFail(par: string, callee: string): i32 {
  emitFail(
    "emitProgram: monomorphize: unsupported argument type for `"
      + par
      + "` in a call to `"
      + callee
      + "`",
  )
}

// The refusal for generic `argIx` handed to a hole its calls use at two types, where no split
// gave the hole a parameter per type: the value floor's, naming the signatures (D6280).
function monoHoleTwoPinsFail(argIx: i32, par: string, callee: string): i32 {
  const ax = unwrapParen(argIx)
  let fe = monoReadGenFnFe(ax)
  if fe < 0 && ax >= 0 && P.nodes[ax] is Ident {
    const d = identDeclOf(ax)
    if d >= 0 && P.nodes[d] is FuncDecl { fe = fnStmtsPosOf(d) }
  }
  if fe < 0 { return monoArgTyFail(par, callee) }
  emitFailAt(genericFnValueRejectMsg(fe), ax)
}

// Set while the call being instantiated has such a parameter (`monoCalleeHasTyParamArrow`).
let monoDestPinOff = false

function monoInstantiateCall(origFe: i32, callIx: i32, ctx: i32) {
  const c = P.nodes[callIx]
  const fn = P.nodes[monoOrigNode[origFe]]
  if c is Call {
    if fn is FuncDecl {
      const args = monoArgsInParamOrder(callIx, monoOrigNode[origFe])
      const params = fn.fnParams
      if args.length != params.length {
        return emitFail(
          "emitProgram: monomorphize: wrong number of arguments calling `"
            + fn.fnName
            + "`",
        )
      }
      // Pin each parameter: an un-annotated param takes its argument's type
      // name; a type-param-riding annotation binds the type param (first use
      // wins, later uses take the binding); a concrete annotation is kept.
      const tvN: string[] = []
      const tvV: string[] = []
      // A call's explicit type arguments bind first, so every later binding reads them.
      monoKeyExtra = monoBindExplicitTyArgs(
        callIx,
        fn.fnTyParams,
        fn.fnParams,
        tvN,
        tvV,
      )
      const pinned: string[] = []
      // The arena type each pinned param denotes, parallel to `pinned`. Sourced from the
      // argument's recorded type and consumed only as a fallback where the pinned name
      // does not resolve. -1 = nothing known.
      const pinTys: i32[] = []
      // Pre-bind from the value arguments, and only when a generic function value is on
      // its way into an arrow parameter riding these type parameters (D58): the main
      // loop binds at first use, and `hof<U, R>(g: (U, U) => R, …)` uses `U` first at `g`.

      // The gate keeps the order change inert: where the argument is a concrete function
      // the two orders agree, so they differ only when one answer is a type variable.
      if monoCallGenFnToTyParamArrow(params, args, fn.fnTyParams, ctx) {
        monoPreBindNonArrowArgs(fn, params, args, ctx, tvN, tvV)
      }
      monoPreBindPastEmptyLit(params, args, fn.fnTyParams, ctx, tvN, tvV)
      if monoTwoListArgFail(fn, params, args, ctx) < 0 { return -1 }
      monoPreBindPastUnionRest(params, args, fn.fnTyParams, ctx, tvN, tvV)
      let oDecl = -1
      if origFe >= 0 && origFe < monoOrigNode.length {
        oDecl = monoOrigNode[origFe]
      }
      let i = 0
      while i < args.length {
        const p = P.nodes[params[i]]
        if p is Param {
          if p.parType < 0 {
            const hr = monoPinHoleParam(
              p,
              fn,
              params,
              args,
              i,
              callIx,
              ctx,
              oDecl,
              pinned,
              pinTys,
            )
            if hr < 0 { return hr }
          } else {
            const pr = monoPinAnnotatedParam(
              p,
              fn,
              params,
              args,
              i,
              callIx,
              ctx,
              tvN,
              tvV,
              pinned,
              pinTys,
              oDecl,
            )
            if pr < 0 { return pr }
          }
        }
        i = i + 1
      }
      // Callback specialization: for each closure-valued argument that is a known,
      // non-capturing, non-generic function, record the name so this instance bakes a
      // direct call and keys on its identity. Anything else leaves "" and a `call_ref`.
      const cbFnNames: string[] = []
      let ci = 0
      while ci < args.length {
        cbFnNames.push(monoSpecializableCallbackName(args[ci], ctx))
        ci = ci + 1
      }
      monoDefaultUnboundTyParams(
        fn.fnTyParams,
        fn.fnParams,
        tvN,
        tvV,
        fn.fnBody,
      )
      if monoLetTyParamMisfit(fn, params, tvN, tvV, pinTys) < 0 { return -1 }
      callBindShadowNote(callIx, fn.fnName, fn.fnTyParams, tvN, tvV)
      monoExactPinTys(pinTys, ctx)
      const pinKinds: i32[] = []
      const pinPays: string[] = []
      monoBuildPinCol(pinned, pinKinds, pinPays)
      monoPinArgLit = []
      let li = 0
      while li < args.length {
        monoPinArgLit.push(P.nodes[unwrapParen(args[li])] is ObjLit)
        li = li + 1
      }
      monoCallFrameSlot = monoNestedCallFrame(origFe, ctx)
      return monoMakeInstance(
        origFe,
        pinned,
        pinKinds,
        pinPays,
        pinTys,
        tvN,
        tvV,
        c.callFn,
        false,
        cbFnNames,
      )
    }
  }
  0
}

// Binds `fn`'s type parameters from the concrete arguments at its non-arrow annotations.
function monoPreBindNonArrowArgs(
  fn: FuncDecl,
  params: i32[],
  args: i32[],
  ctx: i32,
  tvN: string[],
  tvV: string[],
) {
  let pb = 0
  while pb < args.length {
    const pbp = P.nodes[params[pb]]
    if pbp is Param {
      if pbp.parType >= 0 {
        const pbAnn = monoDeclAnnName(
          pbp.parType,
          tyNameOf(pbp.parType),
          fn.fnTyParams,
        )
        // The ARROW parameters are the ones whose binding is in question; every other
        // annotation reads its type off the argument the call actually passes.
        if annArrowAt(pbAnn) < 1 {
          if monoAnnHasTyParam(pbAnn, fn.fnTyParams) {
            const pbConc = monoArgPinName(args[pb], ctx)
            if pbConc != "" {
              monoBindFromAnn(pbAnn, pbConc, fn.fnTyParams, tvN, tvV)
            }
          }
        }
      }
    }
    pb = pb + 1
  }
}

// Refuses an argument of two list types at a type-parameter list parameter of `fn`: -1, else 0.
function monoTwoListArgFail(
  fn: FuncDecl,
  params: i32[],
  args: i32[],
  ctx: i32,
): i32 {
  // A value of two list types handed to a parameter a type parameter spells binds no one
  // `T`, as the same function spelled without a type parameter cannot (D2766).
  let ta = 0
  while ta < args.length {
    const tat = twoListValueTy(args[ta], ctx)
    if (
      tat >= 0
      && ta < params.length
      && monoParamIsTyParamList(params[ta], fn.fnTyParams)
    ) {
      return emitFailAt(
        "argument "
          + i32ToStr(ta + 1)
          + ": "
          + tyToStr(tat)
          + " is two list types, not one list — narrow with `is` first",
        args[ta],
      )
    }
    ta = ta + 1
  }
  0
}

// Pins un-annotated `p`, `fn`'s `i`th parameter, into `pinned`/`pinTys`: -1 on a refusal, else 0.
function monoPinHoleParam(
  p: Param,
  fn: FuncDecl,
  params: i32[],
  args: i32[],
  i: i32,
  callIx: i32,
  ctx: i32,
  oDecl: i32,
  pinned: string[],
  pinTys: i32[],
): i32 {
  // A parameter the checker already decided is not a hole, so the instance
  // pins the parameter's own type. `recordedParamPinName` is that one answer,
  // shared with `synthParamAnnots`; "" keeps the argument-derived pin.
  let an = recordedParamPinName(params[i])
  let anTy = -1
  // One copy of the parameter cannot hold a generic its body calls at two instances;
  // the split plan gives it one per instance (D6210). The walk goes on, so every such
  // parameter is asked in one compile.
  if an == "" && holeFnSplitHas(params[i]) {
    fsAsk(params[i])
    emitFailAt(
      "emitProgram: monomorphize: `"
        + p.parName
        + "` is called at two instances of the function handed to it in a call to `"
        + fn.fnName
        + "`",
      args[i],
    )
  }
  if an == "" {
    const pinTy: i32[] = [0 - 1]
    an = monoHoleGenFnPin(callIx, params[i], args[i], ctx, pinTy)
    anTy = pinTy[0]
    if an == "" && monoHoleGenTwoPins {
      return monoHoleTwoPinsFail(args[i], p.parName, fn.fnName)
    }
  }
  if an == "" {
    const cpTy: i32[] = [0 - 1]
    an = monoHoleLitCopyPin(callIx, oDecl, args, i, ctx, cpTy)
    anTy = cpTy[0]
  }
  if an == "" {
    const llTy: i32[] = [0 - 1]
    an = monoHoleLeafLitPin(oDecl, args, i, ctx, llTy)
    anTy = llTy[0]
  }
  if an == "" {
    const flTy: i32[] = [0 - 1]
    an = monoOpenFnListPin(oDecl, args[i], i, ctx, flTy)
    anTy = flTy[0]
  }
  if an == "" {
    const inTy: i32[] = [0 - 1]
    an = monoInertParamStubPin(oDecl, args[i], inTy)
    anTy = inTy[0]
  }
  if an == "" { an = monoArgPinName(args[i], ctx) }
  if an == "" {
    const lamTy: i32[] = [0 - 1]
    an = monoHoleLamArgPin(callIx, oDecl, args, i, ctx, lamTy)
    if an != "" { anTy = lamTy[0] }
  }
  if an == "" {
    const pinTy: i32[] = [0 - 1]
    an = monoOpenFnFlowPin(
      args[i],
      ctx,
      monoHoleParamBindTy(callIx, oDecl, i),
      pinTy,
    )
    anTy = pinTy[0]
  }
  if an == "" {
    // A name handed through an identity call into a binding can take a slot per type.
    if P.nodes[args[i]] is Ident {
      fsAsk(args[i])
      fsAsk(params[i])
    }
    return monoArgTyFail(p.parName, fn.fnName)
  }
  pinned.push(an)
  if anTy < 0 { anTy = monoArgPinTyIx(args[i], ctx) }
  pinTys.push(anTy)
  if monoFwdFnPinMisfits(fn, params[i], args[i], anTy) {
    // The plan gives the parameter one per type its calls take (D6202).
    fsAsk(params[i])
    return monoFwdFnPinFail(p.parName, fn.fnName)
  }
  if monoHoleCopyCallsMisfit(fn, params[i], anTy) {
    fsAsk(params[i])
    return monoHoleManyPinsFail(p.parName, fn.fnName)
  }
  0
}

// `monoInstantiateCall`'s pin for the annotated parameter `p`, the `i`th of `fn`'s, given
// argument `args[i]`: binds the type parameters the annotation rides into `tvN`/`tvV` and pushes
// the parameter's pin onto `pinned` and its arena type onto `pinTys`, `decl` the declaration whose
// body is read for a literal argument's demand. Returns 0, or the failure.
function monoPinAnnotatedParam(
  p: Param,
  fn: FuncDecl,
  params: i32[],
  args: i32[],
  i: i32,
  callIx: i32,
  ctx: i32,
  tvN: string[],
  tvV: string[],
  pinned: string[],
  pinTys: i32[],
  decl: i32,
) {
  // The declared spelling where the annotation is a type parameter, the
  // arena's canon'd one everywhere else. Without it a parameter whose name
  // shadows a type alias arrives resolved and pins the alias's body type.
  const ann = monoDeclAnnName(p.parType, tyNameOf(p.parType), fn.fnTyParams)
  const tp = monoTyParamOf(ann, fn.fnTyParams)
  if tp == "" {
    // A composite annotation riding type params (`Box<T>`): bind them by
    // matching the pattern against the argument's concrete type name, then
    // pin the substituted annotation. A concrete annotation pins unchanged.
    if monoAnnHasTyParam(ann, fn.fnTyParams) {
      const cr = monoPinTyParamComposite(
        p,
        fn,
        ann,
        params,
        args,
        i,
        callIx,
        ctx,
        tvN,
        tvV,
        pinned,
        pinTys,
      )
      if cr < 0 { return cr }
    } else {
      pinned.push(ann)
      pinTys.push(monoArgPinTyIx(args[i], ctx))
    }
  } else {
    let an2 = ""
    let an2Ty = -1
    let genPin = false
    if ann == tp {
      const pinTy: i32[] = [0 - 1]
      an2 = monoHoleGenFnPin(callIx, params[i], args[i], ctx, pinTy)
      an2Ty = pinTy[0]
      if an2 == "" && monoHoleGenTwoPins {
        return monoHoleTwoPinsFail(args[i], p.parName, fn.fnName)
      }
      genPin = an2 != ""
      if an2 == "" {
        an2 = monoHoleLeafLitPin(decl, args, i, ctx, pinTy)
        an2Ty = pinTy[0]
      }
      // A type parameter only this parameter names binds where an un-annotated one would (D6910).
      if an2 == "" && monoBindOf(tvN, tvV, tp) == "" {
        an2 = monoInertParamStubPin(decl, args[i], pinTy)
        an2Ty = pinTy[0]
      }
      if an2 == "" && monoHoleGenManyPins {
        // The plan gives a parameter handed to closed function types one per type (D6741).
        fsAsk(params[i])
        monoHoleManyPinsFail(p.parName, fn.fnName)
      }
    }
    if an2 == "" { an2 = monoArgPinName(args[i], ctx) }
    if an2 == "" && ann == tp {
      const pinTy: i32[] = [0 - 1]
      an2 = monoOpenFnFlowPin(args[i], ctx, -1, pinTy)
      an2Ty = pinTy[0]
    }
    if an2Ty < 0 { an2Ty = monoArgPinTyIx(args[i], ctx) }
    if an2 == "" {
      if ann == tp && P.nodes[args[i]] is Ident {
        fsAsk(args[i])
        fsAsk(params[i])
      }
      return monoArgTyFail(p.parName, fn.fnName)
    }
    if ann == tp && monoFwdFnPinMisfits(fn, params[i], args[i], an2Ty) {
      fsAsk(params[i])
      return monoFwdFnPinFail(p.parName, fn.fnName)
    }
    if ann == tp && monoHoleCopyCallsMisfit(fn, params[i], an2Ty) {
      fsAsk(params[i])
      fsAskTyParam(params[i])
      return monoHoleManyPinsFail(p.parName, fn.fnName)
    }
    // A parameter handed on keeps its own pin as a generic does (D6202).
    if ann == tp && monoReadsParam(args[i]) { genPin = true }
    let bind = an2
    if ann != tp {
      // `T[]` param: the argument must be an array, and its element binds
      // `T`. The binding is the UNGROUPED element, because a bare `T` param pins it
      // verbatim and `(S|null)` is a spelling nothing interns; every `[]` put back on
      // it goes through `arrElemSuffixed` (D1896).
      if !nameIsArray(an2) {
        return emitFail(
          "emitProgram: monomorphize: expected an array argument for `"
            + p.parName
            + "` in a call to `"
            + fn.fnName
            + "`",
        )
      }
      bind = listElemNameOf(an2)
    }
    const b = monoBindOf(tvN, tvV, tp)
    if b == "" {
      tvN.push(tp)
      tvV.push(bind)
    } else if genPin && b != an2 && monoPinIsFnTy(an2Ty) {
      // A generic handed to a second `T` parameter called at another type keeps its own pin
      // when `T` is read nowhere else, and is refused when it is (D6090).
      if !monoTyParamOnlyBareParams(fn, tp) {
        fsAskTyParam(params[i])
        return emitFail(
          "emitProgram: monomorphize: a generic function handed to two parameters of type `"
            + tp
            + "` in a call to `"
            + fn.fnName
            + "` is called at two types, and `"
            + tp
            + "` takes one",
        )
      }
    } else {
      bind = b
    }
    if ann != tp {
      pinned.push(arrElemSuffixed(bind))
      pinTys.push(monoArgPinTyIx(args[i], ctx))
    } else {
      pinned.push(bind)
      pinTys.push(an2Ty)
    }
  }
  0
}

// Pins parameter `p`'s composite annotation `ann` riding type params: -1 on a refusal, else 0.
function monoPinTyParamComposite(
  p: Param,
  fn: FuncDecl,
  ann: string,
  params: i32[],
  args: i32[],
  i: i32,
  callIx: i32,
  ctx: i32,
  tvN: string[],
  tvV: string[],
  pinned: string[],
  pinTys: i32[],
): i32 {
  // A function-type param (`f: (A, T) => A`) binds from the closure
  // argument's function-type name; any other composite (`Box<T>`, `{a:T}`)
  // from its concrete value-type name.
  let anC = ""
  // The argument's own `#anonN` row, kept as the parameter's pin where its spelled
  // shape would resolve to a declared record sharing the field names.
  let anRowPin = ""
  if annArrowAt(ann) >= 1 {
    anC = monoArgFnTypeName(args[i], ctx)
    // A generic function value takes the type the value arguments bound (D3913).
    if monoCalleeIsGeneric(unwrapParen(args[i])) {
      const pre = monoSubstAnn(ann, fn.fnTyParams, tvN, tvV)
      if pre != "" { anC = pre }
    }
  } else {
    anC = monoArgPinName(args[i], ctx)
    // An anonymous row's `#anonN` has no fields to match the pattern against;
    // the checker's spelled shape does, unless the render softens a literal (D3123).
    const anTy = nodeTyIxOf(unwrapParen(args[i]))
    if (
      anC.length >= 5
      && anC.slice(0, 5) == "#anon"
      && !monoAnonArgSoftens(args[i], anTy)
    ) {
      const anSp = monoAnnPinName(tyToEmitName(anTy))
      if anSp != "" {
        if !monoSpelledShapeStaysAnon(anSp) { anRowPin = anC }
        anC = anSp
      }
    }
    if anC == "" && monoLitHoldsGenericFn(args[i], 0) {
      anC = monoSubstAnn(ann, fn.fnTyParams, tvN, tvV)
    }
  }
  if anC == "" { return monoArgTyFail(p.parName, fn.fnName) }
  monoBindFromAnn(
    ann,
    monoArgBindSpelling(ann, anC, args[i]),
    fn.fnTyParams,
    tvN,
    tvV,
  )
  if monoAnnIsUnion(p.parType) {
    monoDefaultAnnTyParams(
      ann,
      fn.fnTyParams,
      tvN,
      tvV,
      fn.fnBody,
      params,
      i,
      callIx,
    )
  }
  let pinC = monoSubstAnn(ann, fn.fnTyParams, tvN, tvV)
  if i < monoUnionRestPin.length && monoUnionRestPin[i] != "" {
    pinC = monoUnionRestPin[i]
  }
  if anRowPin != "" && pinC != "" { pinC = anRowPin }
  if anRowPin == "" && pinC != "" {
    pinC = monoSubstAnonShapes(ann, fn.fnTyParams, tvN, tvV, pinC)
  }
  if pinC == "" { return monoArgTyFail(p.parName, fn.fnName) }
  // The coercion `monoWalk` deferred, since at that point the pin names
  // would be the type variables themselves. `pinC` is the substituted
  // spelling, the concrete function type that parameter takes.
  if annArrowAt(ann) >= 1 || nameIsClosureArray(pinC) {
    if monoCoerceFnValueName(args[i], pinC, ctx, -1) < 0 { return -1 }
  }
  pinned.push(pinC)
  // A generic function value's own type still rides its type variables, so
  // it names no row this pin denotes; the substituted spelling is the answer.
  let pinCTy = monoExactPinTyOf(monoArgPinTyIx(args[i], ctx), ctx)
  if pinCTy >= 0 && tyHasTyVar(pinCTy) { pinCTy = -1 }
  pinTys.push(pinCTy)
  0
}

// The callback name to bake for a closure-valued argument, or "" when it is not
// specializable: the argument must resolve to a known function that captures nothing and
// is itself non-generic, so a direct by-name call (which passes the null env a
// non-capturing callee wants) is valid. Anything else keeps the per-element `call_ref`.
function monoSpecializableCallbackName(argIx: i32, ctx: i32) {
  if !exprIsClosure(argIx, ctx) { return "" }
  const ax = unwrapParen(argIx)
  const an = P.nodes[ax]
  let fe = -1
  // The Ident arm is scope-aware, like the call and function-value paths: the flat
  // `fnIndexOf` hands every frame the module's first function of this name, so the two
  // soundness gates below would be asked about the wrong function whenever two frames
  // declare a same-named callback.
  if an is FuncDecl {
    fe = fnStmtsPosOf(ax)
  } else if an is Ident {
    fe = fnIndexOfInScopeAt(sidOfNode(ax), an.identName, ctx, ax)
  }
  if fe < 0 || fe >= fnStmts.length { return "" }
  if captureCountOf(fe) > 0 { return "" }
  if fe < monoGen.length {
    if monoGen[fe] == 1 { return "" }
  }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    // The bake is by name and the clone is top-level: `monoBakeCallback` rewrites the
    // callback param's call into a by-name call inside a fresh function pushed with
    // `fnParent = -1`, so the name is re-resolved with no enclosing frame. Decline rather
    // than bake a name that does not mean what the caller meant; `__lambda_N` is unique.
    if fe != fnIndexOf(fn.fnName) { return "" }
    return fn.fnName
  }
  ""
}

// Does the non-generic function at `fe` take a closure-typed parameter — is it a concrete
// higher-order function, a candidate for callback specialization? Excludes a `<T>` generic, whose
// callbacks `monoBakeCallback` bakes, and, with no lambda to prune, an un-annotated return,
// which `monoSpecializeConcrete` declines before reading any argument.
function feHasClosureParam(fe: i32) {
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if fn.fnTyParams.length > 0 { return false }
    if fn.fnRet < 0 && !fnNestUsed { return false }
    let i = 0
    while i < fn.fnParams.length {
      const p = P.nodes[fn.fnParams[i]]
      if p is Param {
        if p.parType >= 0 {
          if tyIsFuncType(p.parType) { return true }
        }
      }
      i = i + 1
    }
  }
  false
}

// Whether the program defines any concrete higher-order function — the gate that lets the
// mono pass run for callback specialization even with no `<T>` generic. The compiler
// itself has none, so the pass stays skipped for it and the all-i32 native fixpoint holds.
function monoHasConcreteHOFParam() {
  let fe = 0
  while fe < fnStmts.length {
    if fe < monoGen.length {
      if monoGen[fe] == 0 {
        if feHasClosureParam(fe) { return true }
      }
    }
    fe = fe + 1
  }
  false
}

// Callback specialization for a concrete (non-generic) higher-order function: clone it
// with a non-capturing callback baked in as a direct call, append it as `<name>$cbN`, and
// point the call site at it. Keyed purely on callback identity. Unlike a generic template
// the original is kept, so it still serves any non-bakeable caller. Returns 0, or -1.
function monoSpecializeConcrete(callIx: i32, fe: i32, ctx: i32) {
  const c = P.nodes[callIx]
  if c is Call {
    // The one read of `fnStmts[fe]` this function needs — kept in `fnDeclIx` rather than
    // re-indexed below, so a second unguarded read of the same fall-through parameter does
    // not open a second sentinel-index hit (D2325).
    const fnDeclIx = fnStmts[fe]
    const fn = P.nodes[fnDeclIx]
    if fn is FuncDecl {
      const params = fn.fnParams
      const args = monoArgsInParamOrder(callIx, fnDeclIx)
      if args.length != params.length { return 0 }
      // Only an annotated return is specialized. An un-annotated one is inferred through
      // the callback param's call, and baking that re-derives it via a path that does
      // not re-establish a nullable or union rep on the appended function.
      if fn.fnRet < 0 { return 0 }
      // The baked callback (and its param NAME) per position — "" where the argument is not a
      // non-capturing concrete function (a capturing lambda / generic / non-closure stays call_ref).
      const cbFnNames: string[] = []
      const cbParamNames: string[] = []
      let i = 0
      while i < args.length {
        const p = P.nodes[params[i]]
        if p is Param {
          cbParamNames.push(p.parName)
        } else {
          cbParamNames.push("")
        }
        cbFnNames.push(monoSpecializableCallbackName(args[i], ctx))
        i = i + 1
      }
      if !monoAnyBakedCallback(cbFnNames) { return 0 }
      // Both renames below point the call site at a specialization resolved from the
      // binding's initializer, faithful only while the binding still holds it. There is
      // no instance to keep, so declining simply leaves the `call_ref`.
      const spCal = P.nodes[c.callFn]
      if spCal is Ident {
        if (
          spCal.identName != fn.fnName
          && monoReadIsAssigned(spCal.identName, c.callFn)
        ) {
          return 0
        }
      }
      // Key on the callee plus each baked callback identity, so `reduce(xs, add, …)` and
      // `reduce(xs, mul, …)` get distinct specializations. The `C` prefix keeps these out
      // of the generic keyspace, which always carries a `#`.
      let key = "C" + i32ToStr(fe)
      let kc = 0
      while kc < cbFnNames.length {
        if cbFnNames[kc] != "" { key = key + "@" + cbFnNames[kc] }
        kc = kc + 1
      }
      // Registry hit: a prior call already specialized this (callee, callback-set) — reuse it.
      let r = 0
      while r < monoKeys.length {
        if monoKeys[r] == key {
          const cal = P.nodes[c.callFn]
          // R4 writer 7 of 8 (`compiler/symbols.vl`; census in `perf-program.md`).
          if cal is Ident {
            collectANoteIdentRename(cal.identName)
            cal.identName = monoInstName[r]
            monoArenaTouch()
            sidNoteNodeName(c.callFn, fnStmts[monoInstFe[r]])
          }
          return 0
        }
        r = r + 1
      }
      // Fresh specialization. `$cbN` is disambiguated by how many concrete specializations this
      // callee already has (its prior `monoInstOrig` entries).
      let count = 0
      let kk = 0
      while kk < monoInstOrig.length {
        if monoInstOrig[kk] == fe { count = count + 1 }
        kk = kk + 1
      }
      // `fnDeclIx` is the ORIGINAL declaration `fn.fnBody` descends from, so the shadow
      // guard walks the same tree the position names (D2325).
      const instBody = monoBakeCallback(
        fn.fnBody,
        cbParamNames,
        cbFnNames,
        fnDeclIx,
      )
      const nps: i32[] = []
      let pj = 0
      while pj < params.length {
        const p3 = P.nodes[params[pj]]
        if p3 is Param {
          nps.push(
            mkParam(
              p3.parName,
              p3.parType,
              p3.parDefault,
              p3.parOpt,
              p3.parRest,
              p3.pos,
            ),
          )
          identFrom(nps[nps.length - 1], params[pj])
          // D926 — as at the generic clone: the mark is arena-node keyed.
          anonLeafCarryParamMark(params[pj], nps[nps.length - 1])
        }
        pj = pj + 1
      }
      const noTP: string[] = []
      const specName = fn.fnName + "$cb" + i32ToStr(count)
      const nfn = mkFunc(specName, noTP, nps, fn.fnRet, instBody, fn.pos)
      // D926 — as above. The ORIGINAL declaration is kept here, so both it and the
      // specialization carry the mark and both signatures follow the merge.
      anonLeafCarryRetMark(fnStmts[fe], nfn)
      fnStmts.push(nfn)
      fnParent.push(-1)
      fnDispNames.push("")
      const instFe = fnStmts.length - 1
      // The in-place rename below lands on nodes this specialization may share. That
      // sharing is not divergent: a concrete declaration has all its parameters
      // annotated, so every specialization writes the same name.

      // What the sharing costs is the revisit: the body below is walked once per
      // specialization and once by the main loop, so a nested generic landing on a count>0
      // instance is re-read under its instance name (see `monoFnParamTypeAt`).
      const cal2 = P.nodes[c.callFn]
      // R4 writer 8 of 8 (`compiler/symbols.vl`; census in `perf-program.md`).
      if cal2 is Ident {
        collectANoteIdentRename(cal2.identName)
        cal2.identName = specName
        monoArenaTouch()
        sidNoteNodeName(c.callFn, fnStmts[instFe])
      }
      monoKeys.push(key)
      monoInstOrig.push(fe)
      monoInstName.push(specName)
      monoInstFe.push(instFe)
      if monoRebuild() < 0 { return -1 }
      // Walk the ORIGINAL body under this specialization's context so a nested generic call it
      // contains instantiates (idempotent via the registry — the main loop also walks the original).
      if monoWalk(fn.fnBody, nfn) < 0 { return -1 }
      if monoRebuild() < 0 { return -1 }
    }
  }
  0
}

// `copy`, a fresh node standing for `orig`, after it takes `orig`'s binding identity.
function monoCopyOf(orig: i32, copy: i32) {
  identFrom(copy, orig)
  copy
}

// The declaration of the function a minted callee names: a registered instance, else the one
// function declared under `name`; -1 when none is, or when two are and the name cannot choose.
function monoFnDeclNamed(name: string) {
  const inst = monoInstDeclOf(name)
  if inst >= 0 { return inst }
  fnDeclNamed(name)
}

// The declaration of the instance registered as `name`, or -1 when none is.
function monoInstDeclOf(name: string) {
  let i = monoInstName.length - 1
  while i >= 0 {
    if (
      monoInstName[i] == name
      && monoInstFe[i] >= 0
      && monoInstFe[i] < fnStmts.length
    ) {
      return fnStmts[monoInstFe[i]]
    }
    i = i - 1
  }
  -1
}

// Points `calleeIx`, an instance's own copy of a call through a lambda binding, at the
// lambda's instance `instName` by name, as a later instance's call is. A capturing lambda
// keeps its value call, whose env the name would drop; so does a reassigned binding.
function monoLamCallByName(calleeIx: i32, origFe: i32, instName: string) {
  if !i32ListHas(monoLamCallCallees, calleeIx) { return 0 }
  if i32ListHas(monoNoRename, calleeIx) { return 0 }
  if !criFnIsAnonLambda(origFe) || captureCountOf(origFe) > 0 { return 0 }
  const cal = P.nodes[calleeIx]
  if cal is Ident {
    if (
      cal.identName == instName
      || monoReadIsAssigned(cal.identName, calleeIx)
    ) {
      return 0
    }
    collectANoteIdentRename(cal.identName)
    cal.identName = instName
    monoArenaTouch()
    sidNoteNodeName(calleeIx, monoFnDeclNamed(instName))
  }
  0
}

// The lifted lambda the call at callee `calleeIx` inside frame `ctx` reaches through a capture:
// the read's declaration is an un-annotated `const` of an enclosing function's frame holding a
// lambda. -1 otherwise, and for a binding of `ctx` itself or of the module.
function monoCapturedLamFe(calleeIx: i32, ctx: i32): i32 {
  if ctx < 0 { return -1 }
  const e = identDeclOf(calleeIx)
  if e < 0 || e >= P.nodes.length || !(P.nodes[e] is LetDecl) { return -1 }
  const df = monoDeclFrameIn(e, ctx)
  if df[0] < 0 || df[0] == ctx { return -1 }
  const d = P.nodes[df[1]]
  if !(d is LetDecl) { return -1 }
  if d.letKw != "const" || d.letType >= 0 { return -1 }
  const fe = fieldValueFeOfIn(d.letInit, df[0])
  if fe < 0 || !criFnIsAnonLambda(fe) { return -1 }
  fe
}

// Whether `name` read in function `fx` is bound by neither its parameters nor its body's lets.
function monoNameIsCapture(fx: i32, name: string): boolean {
  const f = P.nodes[fx]
  if f is FuncDecl {
    if monoFnBindsParam(fx, name) { return false }
    return parentLetOf(f.fnBody, name) < 0
  }
  false
}

// The source declaration that declaration `d` is a rewrite's copy of, or `d` itself.
function monoDeclCanon(d: i32): i32 {
  const o = declOrigOf(d)
  if o >= 0 { return o }
  d
}

// The source declaration the read `at` resolves to, when `at` is an `Ident` spelling `name`
// that the checker resolved to a node; -1 when it is not, so the caller falls back to the name.
function monoReadDecl(name: string, at: i32): i32 {
  if at < 0 || at >= P.nodes.length { return -1 }
  const n = P.nodes[at]
  if n is Ident {
    if n.identName != name { return -1 }
    const d = identDeclOf(at)
    if d < 0 || d >= P.nodes.length { return -1 }
    return monoDeclCanon(d)
  }
  -1
}

// Whether the read of `name` at `at` is a parameter of function `fx`: by the binding the read
// resolves to, else by name.
function monoFnBindsParamAt(fx: i32, name: string, at: i32): boolean {
  const d = monoReadDecl(name, at)
  if d < 0 { return monoFnBindsParam(fx, name) }
  const f = P.nodes[fx]
  if f is FuncDecl {
    for p in f.fnParams {
      if monoDeclCanon(p) == d { return true }
    }
  }
  false
}

// Whether the read of `name` at `at` can be a parameter of function `fx` (-1: of whichever
// function is being copied): false only where it resolves to some other binding, such as a loop
// variable of the name (D2114).
function monoReadsOwnParam(fx: i32, name: string, at: i32): boolean {
  if fx >= 0 { return monoFnBindsParamAt(fx, name, at) }
  const d = monoReadDecl(name, at)
  d < 0 || P.nodes[d] is Param
}

// Whether function `fx` declares a parameter named `name`.
function monoFnBindsParam(fx: i32, name: string): boolean {
  const f = P.nodes[fx]
  if f is FuncDecl {
    let i = 0
    while i < f.fnParams.length {
      const p = P.nodes[f.fnParams[i]]
      if p is Param {
        if p.parName == name { return true }
      }
      i = i + 1
    }
  }
  false
}

// The lifted lambda the binding read at `at` in frame `ctx` holds, where the flow table names a
// chain of un-annotated aliases ending at a hole lambda's `const` (`fnFlowAliasLam`); `viaLet`
// counts a `let` already behind. -1 for none, a loud refusal past the table's longest chain.
function monoAliasLamFe(at: i32, ctx: i32, viaLet: boolean): i32 {
  monoChainLamFe(fnFlowAliasLam(at, viaLet), at, ctx)
}

// `monoAliasLamFe` for the capture cell read at `at` (`d[0]`): the rewrite turns a captured
// `let d = c` that is written after capture into `let d = [c]` and each read into `d[0]` (D3845).
function monoCellLamFe(at: i32, ctx: i32): i32 {
  monoChainLamFe(fnFlowCellLam(at), at, ctx)
}

// The lifted lambda of the binding `e` a flow-table chain answer names, as frame `ctx` or the
// frame enclosing it that declares it holds it; -1 for none.
function monoChainLamFe(e: i32, at: i32, ctx: i32): i32 {
  if e == FF_CHAIN_LONG {
    return emitFailAt(
      "emitProgram: a call through a chain of more than "
        + i32ToStr(MONO_ALIAS_CHAIN_MAX)
        + " un-annotated aliases of a lambda has no signature to lower at — annotate the lambda's parameters",
      at,
    )
  }
  const c = monoDeclCopyIn(e, ctx)
  if c < 0 { return -1 }
  const d = P.nodes[c]
  if !(d is LetDecl) || d.letInit < 0 { return -1 }
  const ls = fnStmtsPosOf(d.letInit)
  if ls < 0 || !criFnIsAnonLambda(ls) { return -1 }
  ls
}

// The declaration standing for the flow table's pre-mono declaration `e` in frame `ctx` or the
// nearest enclosing frame declaring it, since an instance declares its own copy of each of its
// template's; `e` itself at module scope, and -1 past eight frames.
function monoDeclCopyIn(e: i32, ctx: i32): i32 { monoDeclFrameIn(e, ctx)[1] }

// `monoDeclCopyIn` as `[frame, declaration]`, the frame -1 at module scope; `[-1, -1]` for none.
function monoDeclFrameIn(e: i32, ctx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1]
  if e < 0 || e >= P.nodes.length { return none }
  if fnFlowDeclFn(e) == -1 {
    const top: i32[] = [0 - 1, e]
    return top
  }
  let fx = ctx
  let hops = 0
  while hops < 8 && fx >= 0 {
    const c = monoBodyDeclCopy(monoNestedBodyOf(fx), e)
    if c >= 0 {
      const out: i32[] = [fx, c]
      return out
    }
    const slot = fnStmtsPosOf(fx)
    if slot < 0 || slot >= fnParent.length { return none }
    const ps = fnParent[slot]
    if ps < 0 || ps >= fnStmts.length { return none }
    fx = fnStmts[ps]
    hops = hops + 1
  }
  none
}

// `[frame, declaration]` of the `let` the read at `at` (a name, or a capture cell's `d[0]`)
// names by declaration, in frame `ctx` or the nearest enclosing frame holding its copy;
// `[-1, -1]` for a read of anything else, such as a parameter.
function monoReadLetFrame(at: i32, ctx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1]
  if at < 0 || at >= P.nodes.length { return none }
  let r = at
  const rn = P.nodes[at]
  if rn is Index {
    if monoCellReadName(at) == "" { return none }
    r = rn.idxArr
  }
  if !(P.nodes[r] is Ident) { return none }
  const e = identDeclOf(r)
  if e < 0 || e >= P.nodes.length || !(P.nodes[e] is LetDecl) { return none }
  monoDeclFrameIn(e, ctx)
}

// Per body `monoBodyDeclCopy` has indexed at arena stamp `monoBodyDeclStamp`: its row, and per
// row each `let`'s visit order, and the first `let` copying each original declaration.
let monoBodyDeclStamp = 0 - 1
let monoBodyDeclRow: {[i32]: i32} = Map()
let monoBodyDeclPos: {[i32]: i32}[] = []
let monoBodyDeclByOrig: {[i32]: i32}[] = []

// The `let` in `body`, outside the functions nested in it, that is or copies declaration `e`;
// the first such in one walk of the body, which is indexed once per arena stamp.
function monoBodyDeclCopy(body: i32, e: i32): i32 {
  if body < 0 { return -1 }
  let eo = declOrigOf(e)
  if eo < 0 { eo = e }
  const stamp = monoArenaStamp()
  if stamp != monoBodyDeclStamp {
    monoBodyDeclStamp = stamp
    monoBodyDeclRow = Map()
    monoBodyDeclPos = []
    monoBodyDeclByOrig = []
  }
  let row = monoBodyDeclRow[body] ?? -1
  if row < 0 {
    row = monoBodyDeclPos.length
    // arena-tick exempt: this function's own index of the arena, read by no pass.
    monoBodyDeclRow[body] = row
    const pos: {[i32]: i32} = Map()
    const byOrig: {[i32]: i32} = Map()
    let n = 0
    const stack: i32[] = [body]
    while stack.length > 0 {
      const cur = stack.pop() ?? -1
      if cur >= 0 && cur < P.nodes.length {
        if P.nodes[cur] is LetDecl {
          // arena-tick exempt: a local index under construction.
          pos[cur] = n
          n = n + 1
          const o = declOrigOf(cur)
          // arena-tick exempt: a local index under construction.
          if o >= 0 && (byOrig[o] ?? -1) < 0 { byOrig[o] = cur }
        }
        for k in nodeChildren(cur) { stack.push(k) }
      }
    }
    monoBodyDeclPos.push(pos)
    monoBodyDeclByOrig.push(byOrig)
  }
  const pos = monoBodyDeclPos[row]
  let best = -1
  let bestAt = 0
  for c in [e, eo, monoBodyDeclByOrig[row][eo] ?? -1] {
    const at = pos[c] ?? -1
    if c >= 0 && at >= 0 && (best < 0 || at < bestAt) {
      best = c
      bestAt = at
    }
  }
  best
}

// Whether node `ix` is a read `d[0]` of the binding declared at `cd`, a copy of it included.
function monoReadsCell(ix: i32, cd: i32): boolean {
  if monoCellReadName(ix) == "" { return false }
  const r = P.nodes[ix]
  if !(r is Index) { return false }
  const e = identDeclOf(r.idxArr)
  e >= 0 && e < P.nodes.length && monoDeclCanon(e) == monoDeclCanon(cd)
}

// The cell a read `cell[0]` at node `ix` names, or "" for any other node.
function monoCellReadName(ix: i32): string {
  if ix < 0 || ix >= P.nodes.length { return "" }
  const n = P.nodes[ix]
  if n is Index {
    const a = P.nodes[n.idxArr]
    const k = P.nodes[n.idxIndex]
    if a is Ident && k is NumLit {
      if k.numText == "0" { return a.identName }
    }
  }
  ""
}

// The function type the capture cell read `at` (`cell[0]`) is called at in frame `ctx`: the one
// signature the flow table pins the cell's element at; "" for none or two.
function monoCellPinName(at: i32, ctx: i32): string {
  if !monoIsCellRead(at) { return "" }
  const r = P.nodes[at]
  if !(r is Index) { return "" }
  const cp: string[] = ["e"]
  monoSlotPinName(identDeclOf(r.idxArr), cp, ctx)
}

// The cell half of `monoWalk` for call `n` at `ix` in frame `ctx` through the capture cell
// read at node `at` in frame `cctx` (the call's own callee, or the read an alias of it is
// initialized with): -1 on a refusal, 1 when the call is settled, 0 to walk on.
function monoCellCall(
  n: Call,
  ix: i32,
  at: i32,
  cctx: i32,
  ctx: i32,
  viaAlias: boolean,
): i32 {
  // A call in a function nothing names never runs, so it asks nothing of the cell (D3864).
  const cellFr = monoReadLetFrame(at, cctx)[0]
  const live = cellFr < 0 || !monoWriteFrameDead(ctx, cellFr)
  const cfe = monoCellLamFe(at, cctx)
  if !viaAlias && cfe >= 0 && cfe < monoGen.length && monoGen[cfe] == 1 {
    monoLastInstFe = -1
    const rc = monoInstantiate(cfe, ix, ctx)
    monoNoteBindCall(at, cctx, ix)
    if rc < 0 { return -1 }
    return 1
  }
  // A cell seeded with a named generic is called at the instance this call's arguments take
  // of the seed, since retyping the cell rewrites the callee's recorded type; any other cell
  // at the one signature the flow table pins its element at in this frame (D3939, D3957).
  let ctn = ""
  const sfe = monoCellSeedGenFe(at, cctx)
  if sfe < 0 { ctn = monoCellPinName(at, ctx) }
  // An alias is a value the cell's writes may have replaced, so its call is never renamed.
  if viaAlias { monoNoRename.push(n.callFn) }
  if sfe >= 0 {
    monoLastInstFe = -1
    if monoWritesCoercedFirstCall("c:", at, cctx) {
      monoWriteCoercedCall = n.callFn
    }
    const sr = monoInstantiate(sfe, ix, ctx)
    monoWriteCoercedCall = -1
    if sr < 0 { return -1 }
    ctn = monoSigFnTyName(monoSlotSig(monoLastInstFe))
  }
  // A hole lambda seed is pinned by this call's arguments, which the callee's recorded type
  // need not agree with, and a generic written beside it takes the lambda's signature (D3951).
  const lfe = monoCellSeedLamFe(at, cctx)
  if (
    sfe < 0
    && live
    && (ctn == "" || monoCellSeedIsLamLit(at, cctx))
    && lfe >= 0
    && lfe < monoGen.length
    && monoGen[lfe] == 1
  ) {
    monoLastInstFe = -1
    if monoInstantiate(lfe, ix, ctx) < 0 { return -1 }
    monoNoteBindCall(at, cctx, ix)
    ctn = monoSigFnTyName(monoSlotSig(monoLastInstFe))
  }
  const prev = monoSigCallRet
  monoSigCallRet = nodeTyIxOf(ix)
  if ctn != "" && (live || sfe >= 0) { monoCoerceWrittenCell(at, cctx, ctn) }
  // One cell holds one signature: a second call type is the binding conflict, refused.
  let rc = 0
  if ctn != "" && sfe >= 0 { rc = monoNoteBindDeliveryAt(at, ctn, cctx) }
  monoSigCallRet = prev
  if rc < 0 { return -1 }
  0
}

// The callee of the call `monoWalk` is instancing through a written `let` whose writes it then
// instances at the same signature, so that instance need not be the generic's first; -1 for none.
let monoWriteCoercedCall = -1

// Whether the `let` (`key` `n:`) or capture cell (`c:`) read at `at` in frame `ctx` is written
// and no call has given it a signature yet: its writes then take this call's.
function monoWritesCoercedFirstCall(key: string, at: i32, ctx: i32): boolean {
  const lf = monoReadLetFrame(at, ctx)
  if lf[1] < 0 || monoWritesOf(key, lf[1]).length == 0 { return false }
  // A write of another binding of the name does not make this one written (D4016).
  if key == "n:" && !monoLetWrittenIn(lf) { return false }
  (monoBindCallSigs.get(lf[1]) ?? "") == ""
}

// The longest alias chain a walk here follows before refusing, as long as the flow table's.
const MONO_ALIAS_CHAIN_MAX = 64

// The hole lambda the value at node `vx`, read in frame `fx`, is: a lambda literal, or a name
// bound through un-annotated `const` and `let` bindings to one. -1 for anything else.
function monoLamValueFe(vx: i32, fx: i32): i32 {
  const v = P.nodes[vx]
  if v is FuncDecl {
    const ls = fnStmtsPosOf(vx)
    if ls >= 0 && criFnIsAnonLambda(ls) { return ls }
    return -1
  }
  let nm = monoIdentNameOf(vx)
  let ax = vx
  // A read through the rewrite's capture cell, `d[0]`, is a read of `d` (D3850).
  if nm == "" { nm = monoCellReadName(vx) }
  let fr = fx
  let hops = 0
  while nm != "" && hops < MONO_ALIAS_CHAIN_MAX {
    const sfe = identClosureFeAt(sidOf(nm), fr, ax)
    if sfe >= 0 {
      if criFnIsAnonLambda(sfe) { return sfe }
      return -1
    }
    const lf = monoReadLetFrame(ax, fr)
    if lf[1] < 0 { return -1 }
    const d = P.nodes[lf[1]]
    if !(d is LetDecl) { return -1 }
    if d.letType >= 0 || d.letInit < 0 { return -1 }
    const il = monoNestedBodyOf(d.letInit)
    if il >= 0 {
      const ls = fnStmtsPosOf(d.letInit)
      if ls >= 0 && criFnIsAnonLambda(ls) { return ls }
      return -1
    }
    // The rewrite's cell `let d = [v]` holds `v`.
    let init = d.letInit
    const cellEl = monoGeneratedCellElem(init)
    if cellEl >= 0 { init = cellEl }
    nm = monoIdentNameOf(init)
    if nm == "" { nm = monoCellReadName(init) }
    ax = init
    fr = lf[0]
    hops = hops + 1
  }
  -1
}

// The one element of the capture cell the rewrite builds (`[v]`, no source position) at node
// `ix`, or -1 for any other node.
function monoGeneratedCellElem(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const lit = P.nodes[ix]
  if lit is ArrayLit {
    if lit.pos < 0 && lit.arrElems.length == 1 { return lit.arrElems[0] }
  }
  -1
}

// The innermost function node among `root` and the functions lifted out of it whose body holds
// node `ix`; `root` itself when none of them does.
function monoFrameOfNode(ix: i32, root: i32): i32 {
  let best = root
  for k in monoLiftedDescendants(fnStmtsPosOf(root)) {
    const kb = monoNestedBodyOf(fnStmts[k])
    if kb >= 0 && monoSubtreeHolds(kb, ix) { best = fnStmts[k] }
  }
  best
}

// The module-scope function statement holding each node (`monoProgTopOf`), banked on the arena
// stamp and the statement count: one walk answers every query between two edits (D4942).
let monoProgTop: i32[] = []
let monoProgHeldStamp = 0 - 1

// Per node: the first module-scope function statement whose subtree holds it, -1 when only
// another statement does, -2 when none does; rebuilt when the arena stamp moves.
function monoProgTopOf(ix: i32): i32 {
  const stamp = monoArenaStamp() + monoProgStmts.length
  if stamp != monoProgHeldStamp {
    const top: i32[] = []
    while top.length < P.nodes.length { top.push(-2) }
    for st in monoProgStmts {
      if P.nodes[st] is FuncDecl { monoProgTopMark(top, st, st) }
    }
    for st in monoProgStmts { monoProgTopMark(top, st, -1) }
    monoProgTop = top
    monoProgHeldStamp = stamp
  }
  if ix < 0 || ix >= monoProgTop.length { return -2 }
  monoProgTop[ix]
}

// Marks every node `root`'s subtree reaches, entering function bodies, that no earlier walk
// marked, as held by `owner`.
function monoProgTopMark(top: i32[], root: i32, owner: i32) {
  const stack: i32[] = [root]
  while stack.length > 0 {
    const cur = stack.pop() ?? -1
    if cur >= 0 && cur < top.length && top[cur] == -2 {
      // arena-tick exempt: top is the caller's fresh table, not the arena
      top[cur] = owner
      const b = monoNestedBodyOf(cur)
      if b >= 0 { stack.push(b) }
      for k in nodeChildren(cur) { stack.push(k) }
    }
  }
  0
}

// Whether node `ix` lies in the program, entering function bodies (`monoSubtreeHolds` over every
// statement of `monoProgStmts`).
function monoProgHolds(ix: i32): boolean { monoProgTopOf(ix) != -2 }

// Whether node `ix` lies in the subtree at `root`, entering function bodies.
function monoSubtreeHolds(root: i32, ix: i32): boolean {
  const stack: i32[] = [root]
  while stack.length > 0 {
    const cur = stack.pop() ?? -1
    if cur == ix { return true }
    if cur >= 0 && cur < P.nodes.length {
      const b = monoNestedBodyOf(cur)
      if b >= 0 { stack.push(b) }
      for k in nodeChildren(cur) { stack.push(k) }
    }
  }
  false
}

// The program's assignments, as node indices, by the declaration (`monoDeclCanon`) they write:
// `x = v`, a cell's `d[0] = v`, a field's `d.f = v`, an element's `d[k] = v`. Banked on an arena
// prefix, so an instance body cloned during the pass, whose targets read the template's
// declaration, joins the next time it is asked.
let monoDeclWrites: {[i32]: i32[]} = Map()
let monoCellWrites: {[i32]: i32[]} = Map()
let monoFieldWrites: {[i32]: i32[]} = Map()
let monoElemWrites: {[i32]: i32[]} = Map()
let monoLetWritesSeen = 0
// Every declaration written, in the order of its first write: `d` for `monoDeclWrites`, `-1 - d`
// for `monoCellWrites`.
let monoWriteOrder: i32[] = []

// Indexes the assignments the arena gained since the last call. A target that resolved to no
// declaration is not indexed.
function monoLetWritesExtend() {
  let i = monoLetWritesSeen
  while i < P.nodes.length {
    const wn = P.nodes[i]
    if wn is BinExpr {
      if wn.binOp == "=" {
        const tg = P.nodes[wn.binLeft]
        if tg is Ident {
          const d = identDeclOf(wn.binLeft)
          if d >= 0 && d < P.nodes.length {
            const k = monoDeclCanon(d)
            if !monoDeclWrites.has(k) { monoWriteOrder.push(k) }
            const wl = monoDeclWrites.get(k) ?? []
            wl.push(i)
            monoDeclWrites.set(k, wl)
          }
        } else if monoCellReadName(wn.binLeft) != "" && tg is Index {
          const d = identDeclOf(tg.idxArr)
          if d >= 0 && d < P.nodes.length {
            const k = monoDeclCanon(d)
            if !monoCellWrites.has(k) { monoWriteOrder.push(0 - 1 - k) }
            const wl = monoCellWrites.get(k) ?? []
            wl.push(i)
            monoCellWrites.set(k, wl)
          }
        } else if tg is Member && P.nodes[tg.memObj] is Ident {
          const d = identDeclOf(tg.memObj)
          if d >= 0 && d < P.nodes.length {
            const k = monoDeclCanon(d)
            const wl = monoFieldWrites.get(k) ?? []
            wl.push(i)
            monoFieldWrites.set(k, wl)
          }
        }
        monoElemWriteNote(wn.binLeft, i)
      }
    }
    i = i + 1
  }
  monoLetWritesSeen = P.nodes.length
  0
}

// Banks write `i` to target `lhs` in `monoElemWrites` when `lhs` is `d[k]`: `d[0] = v` counts
// too, since `d` may be a list literal and not a capture cell.
function monoElemWriteNote(lhs: i32, i: i32) {
  const tg = P.nodes[lhs]
  if !(tg is Index) || !(P.nodes[tg.idxArr] is Ident) { return 0 }
  const d = identDeclOf(tg.idxArr)
  if d < 0 || d >= P.nodes.length { return 0 }
  const k = monoDeclCanon(d)
  const wl = monoElemWrites.get(k) ?? []
  wl.push(i)
  monoElemWrites.set(k, wl)
  0
}

// The writes `monoWriteOrder` entry `k` names.
function monoWriteListAt(k: i32): i32[] {
  const none: i32[] = []
  if k < 0 { return monoCellWrites.get(0 - 1 - k) ?? none }
  monoDeclWrites.get(k) ?? none
}

// The writes of the binding declared at `d` (`key` `n:`), of its capture cell (`c:`), of its
// fields (`f:`), or of its elements (`e:`).
function monoWritesOf(key: string, d: i32): i32[] {
  monoLetWritesExtend()
  const none: i32[] = []
  if d < 0 || d >= P.nodes.length { return none }
  if key == "c:" { return monoCellWrites.get(monoDeclCanon(d)) ?? none }
  if key == "f:" { return monoFieldWrites.get(monoDeclCanon(d)) ?? none }
  if key == "e:" { return monoElemWrites.get(monoDeclCanon(d)) ?? none }
  monoDeclWrites.get(monoDeclCanon(d)) ?? none
}

// The lambda a call through callee `calleeIx` reaches, where the flow table says its chain of
// un-annotated `const` aliases ends at a lambda's un-annotated `const` binding
// (`fnFlowRespellLam`), possibly in an enclosing frame (D3825); -1 for none. A non-capturing
// lambda's call is pointed at the lambda's own function, which no binding can shadow.
function monoRespellLamFe(calleeIx: i32, ctx: i32): i32 {
  const cal = P.nodes[calleeIx]
  if !(cal is Ident) { return -1 }
  if identClosureFeAt(sidOfNode(calleeIx), ctx, calleeIx) >= 0 { return -1 }
  const sf = monoDeclFrameIn(fnFlowRespellLam(calleeIx), ctx)
  if sf[1] < 0 { return -1 }
  const sd = P.nodes[sf[1]]
  if !(sd is LetDecl) || sd.letInit < 0 { return -1 }
  const fe = fieldValueFeOfIn(sd.letInit, sf[0])
  if fe < 0 || !criFnIsAnonLambda(fe) { return -1 }
  if captureCountOf(fe) > 0 { return fe }
  const name = monoSlotName(fe)
  if name == "" || name == cal.identName { return fe }
  collectANoteIdentRename(cal.identName)
  cal.identName = name
  monoArenaTouch()
  sidNoteNodeName(calleeIx, fnStmts[fe])
  fe
}

// Walk the statement/expression tree at `ix` (inside function `ctx`, -1 = top level) and
// instantiate every direct call to a generic function. Arguments are walked before their
// call is classified, so an inner generic call's instance — and its now-concrete return
// kind — is in place when the outer call's argument types are read.
function monoWalk(ix: i32, ctx: i32) {
  if ix < 0 { return 0 }
  const n = P.nodes[ix]
  if n is Call {
    const args = n.callArgs
    let i = 0
    while i < args.length {
      if monoWalk(args[i], ctx) < 0 { return -1 }
      i = i + 1
    }
    if monoNotePushDeliveries(n, ctx) < 0 { return -1 }
    if monoGenArgAtOpenParam(n, ctx) && monoOpenCallAtElems(n, ctx) < 0 {
      return -1
    }
    const callee = P.nodes[n.callFn]
    if callee is Index && monoGenArgAtOpenParam(n, ctx) {
      return monoGenArgOpenFail(ix)
    }
    if callee is Ident { return monoWalkIdentCall(n, callee, ix, ctx) }
    // A call of a list element that is an alias of a capture cell's read is a call through it.
    const le = monoListElemCellRead(n.callFn, ctx)
    if le[0] >= 0 {
      if monoCellCall(n, ix, le[0], le[1], ctx, true) < 0 { return -1 }
    }
    // A call through the capture cell of a `let` alias of a hole lambda (D3845).
    if monoCellReadName(n.callFn) != "" {
      const cr = monoCellCall(n, ix, n.callFn, ctx, ctx, false)
      if cr < 0 { return -1 }
      if cr == 1 { return 0 }
    }
    if monoCallIfValue(n, ix, ctx) < 0 { return -1 }
    if monoCoerceAtValueParams(n, -1, ctx) < 0 { return -1 }
    if monoWalk(n.callFn, ctx) < 0 { return -1 }
    monoTypeCallOfCall(ix, ctx)
    return 0
  }
  if n is Block {
    const bs = n.blkStmts
    let i2 = 0
    while i2 < bs.length {
      if monoWalk(bs[i2], ctx) < 0 { return -1 }
      i2 = i2 + 1
    }
    return 0
  }
  if n is LetDecl { return monoWalkLetDecl(n, ix, ctx) }
  if n is IfStmt {
    if monoWalk(n.ifCond, ctx) < 0 { return -1 }
    if monoWalk(n.ifThen, ctx) < 0 { return -1 }
    return monoWalk(n.ifElse, ctx)
  }
  if n is WhileStmt {
    if monoWalk(n.whileCond, ctx) < 0 { return -1 }
    return monoWalk(n.whileBody, ctx)
  }
  if n is ForRange {
    if monoWalk(n.frFrom, ctx) < 0 { return -1 }
    if monoWalk(n.frTo, ctx) < 0 { return -1 }
    if monoWalk(n.frStep, ctx) < 0 { return -1 }
    return monoWalk(n.frBody, ctx)
  }
  if n is ForIn {
    if monoWalk(n.fiIter, ctx) < 0 { return -1 }
    return monoWalk(n.fiBody, ctx)
  }
  if n is RetStmt {
    // A generic function value RETURNED where the enclosing function declares a concrete function
    // return type (`function mk(): (f64,f64)=>f64 { return add }`): materialize the instance for
    // that return type so the returned value carries it.
    if ctx >= 0 {
      const cf = P.nodes[ctx]
      if cf is FuncDecl {
        if monoCoerceFnValue(n.retArg, cf.fnRet, ctx) < 0 { return -1 }
        if cf.fnRet < 0 && monoCoerceRetAtPin(n.retArg, ctx) < 0 { return -1 }
      }
    }
    return monoWalk(n.retArg, ctx)
  }
  if n is BinExpr {
    // Assignment to a function-typed binding (`let f: (i32,i32)=>i32 = mul; f = add`). The
    // declared type is the same boundary the `LetDecl` arm reads, so a generic reaching it
    // through a later `=` materializes identically. "" is a no-op.
    if n.binOp == "=" {
      const tgt = P.nodes[n.binLeft]
      if tgt is Ident {
        let atn = identFnTypeAnnName(tgt.identName, ctx)
        // An un-annotated local's write delivers at the one signature the flow table pins the
        // binding at in this frame (D3957), a hole lambda literal written there included; one
        // written at two types is left to the binding's own two-signature refusal.
        let byPin = false
        if atn == "" {
          atn = monoPlacePinName(n.binLeft, "", ctx)
          byPin = true
        }
        if atn != "" {
          if monoCoerceFnValueName(n.binRight, atn, ctx, -1) < 0 { return -1 }
          if byPin { monoLamLitTake(n.binRight, atn, ctx) }
          if !byPin && monoDeliverCallAt(n.binRight, atn) < 0 { return -1 }
        }
      }
      // A store into an element or a field of a binding delivers at the one signature the flow
      // table pins that slot at in this frame (D3909), and a capture cell's store at the cell's
      // element pin, a value read through another cell included.
      if tgt is Index {
        let sn = monoPlacePinName(n.binLeft, "", ctx)
        if monoIsCellRead(n.binLeft) { sn = monoCellPinName(n.binLeft, ctx) }
        const wl = unwrapParen(n.binRight)
        if (
          monoIsCellRead(n.binLeft)
          && sn != ""
          && wl >= 0
          && P.nodes[wl] is FuncDecl
        ) {
          // A lambda written to a captured binding, like one written to a plain one, leaves a
          // second type to the binding's own refusal.
          if monoCoerceFnValueName(n.binRight, sn, ctx, -1) < 0 { return -1 }
          monoLamLitTake(n.binRight, sn, ctx)
        } else if monoDeliverAtPin(n.binRight, sn, ctx) < 0 {
          return -1
        }
      }
      if tgt is Member {
        const sn = monoPlacePinName(n.binLeft, "", ctx)
        if sn != "" {
          if monoCoerceFnValueName(n.binRight, sn, ctx, -1) < 0 { return -1 }
        }
      }
    }
    if monoWalk(n.binLeft, ctx) < 0 { return -1 }
    return monoWalk(n.binRight, ctx)
  }
  if n is Unary { return monoWalk(n.unArg, ctx) }
  if n is Paren { return monoWalk(n.parInner, ctx) }
  if n is Member { return monoWalk(n.memObj, ctx) }
  if n is OptMember { return monoWalk(n.omObj, ctx) }
  if n is Index {
    if monoWalk(n.idxArr, ctx) < 0 { return -1 }
    return monoWalk(n.idxIndex, ctx)
  }
  if n is IsExpr { return monoWalk(n.isObj, ctx) }
  if n is AsExpr { return monoWalk(n.asObj, ctx) }
  // A spread's source is an operand like any other (D2334).
  if n is Spread { return monoWalk(n.spdArg, ctx) }
  if n is ArrayLit {
    const es = n.arrElems
    let i3 = 0
    while i3 < es.length {
      // An alias of a capture cell's read in a program's list is called through the list, which
      // the cell path does not follow, so it cannot be held to the cell's one signature.
      if (
        n.pos >= 0
        && ix != monoCellAliasListOk
        && monoListMayHoldFn(ix)
        && monoNamesCellAlias(es[i3], ctx)
      ) {
        return monoCellAliasListFail(es[i3])
      }
      if monoWalk(es[i3], ctx) < 0 { return -1 }
      i3 = i3 + 1
    }
    return 0
  }
  if n is ObjLit {
    const fs = n.objFields
    let i4 = 0
    while i4 < fs.length {
      const f = P.nodes[fs[i4]]
      if f is FieldInit {
        if monoWalk(f.fiValue, ctx) < 0 { return -1 }
      }
      i4 = i4 + 1
    }
    return 0
  }
  // A nested `FuncDecl`'s body is walked through its own `fnStmts` slot (lambda-lifted);
  // every other node kind has no call-bearing children. `MatchExpr` never
  // reaches here: the checker lowers every exhaustive `match` to an if/else chain and
  // overwrites the arena slot in place, so by emit time its arms sit in `IfStmt` limbs.
  0
}

// `monoWalk`'s arm for the binding `n` at node `ix` in frame `ctx`.
function monoWalkLetDecl(n: LetDecl, ix: i32, ctx: i32): i32 {
  // A list holding an alias of a capture cell's read is followed only where every read of it
  // is a call of one element (`fs[0](…)`), which is taken through the cell.
  if monoListInitHoldsCellAlias(n.letInit, ctx) {
    if (
      n.letKw != "const"
      || !monoListOnlyCalled(ctx, n.letName, ix, monoListLitLength(n.letInit))
    ) {
      return monoCellAliasListFail(n.letInit)
    }
    monoCellAliasListOk = n.letInit
  }
  // An un-annotated list of function values takes the one type the calls through its elements
  // give it, as an annotation would (D3977).
  if n.letType < 0 {
    if monoPinListElems(n, ix, ctx) < 0 { return -1 }
  }
  if (
    n.letType < 0
    && n.letKw == "const"
    && n.letInit >= 0
    && P.nodes[n.letInit] is ObjLit
  ) {
    if monoPinRecordFields(n, ix, ctx) < 0 { return -1 }
  }
  // An annotated function-typed binding to a generic named function: materialize the
  // instance for the annotation's param types and point the binding at it, so the value
  // carries that concrete type independent of any call — it may escape where call-driven
  // monomorphization cannot reach.
  if monoCoerceFnValue(n.letInit, n.letType, ctx) < 0 { return -1 }
  // So is each literal a call in the initializer returns (`monoFlowAnnLits`).
  // Each instance there must return the slot's own type, since nothing adapts it on the way.
  monoInstanceExactRet = true
  for lit in monoFlowAnnLitsOf(ix) {
    if monoCoerceFnValue(lit, n.letType, monoTopFrameOf(lit)) < 0 {
      monoInstanceExactRet = false
      return -1
    }
  }
  monoInstanceExactRet = false
  if monoNoteBindDelivery(n.letInit, n.letType, ctx, -1) < 0 { return -1 }
  return monoWalk(n.letInit, ctx)
}

// `monoWalk`'s arm for a call `n` (node `ix`, in frame `ctx`) whose callee is the identifier
// `callee`, its arguments already walked: coerces generic values at concrete parameters, then
// instantiates the generic it resolves to, through any alias, or specializes a concrete one.
// Returns what `monoWalk` returns for the call.
function monoWalkIdentCall(n: Call, callee: Ident, ix: i32, ctx: i32) {
  // A generic function value passed as an argument to a concrete function-typed
  // parameter: materialize the instance for that declared function type. Only where
  // the declaration is concrete — the rest is deferred to `monoInstantiate`.
  const dfe = monoFnFeOfIdent(n.callFn, callee.identName, ctx)
  const pargs = monoArgsInParamOrder(ix, monoFnDeclNodeAt(dfe))
  let ca = 0
  while ca < pargs.length {
    const pty = monoFnParamTypeAt(dfe, ca)
    if pty >= 0 {
      if !monoFnParamAnnRidesTyParam(dfe, ca) {
        if monoCoerceFnValue(pargs[ca], pty, ctx) < 0 { return -1 }
        if monoNoteBindDelivery(pargs[ca], pty, ctx, ix) < 0 { return -1 }
      }
    }
    ca = ca + 1
  }
  if monoCoerceAtValueParams(n, dfe, ctx) < 0 { return -1 }
  // An alias of a `let` calls the lambda that `let` is seeded with, as the binding itself does.
  if (
    dfe < 0
    && monoGenArgAtOpenParam(n, ctx)
    && monoAliasLetLamFe(ix, ctx) < 0
  ) {
    return monoGenArgOpenFail(ix)
  }
  // A call through a written, un-annotated `let` holding generic functions instances each one
  // written at the call's type, which one binding holds one of (D3979).
  if monoCallWrittenLet(ix, ctx) < 0 { return -1 }
  if monoCallIfBound(ix, ctx) < 0 { return -1 }
  // A call through an alias of a capture cell's read is a call through that cell (D3948).
  if dfe < 0 {
    const ar = monoAliasCellRead(n.callFn, ctx)
    if ar[0] >= 0 {
      if monoCellCall(n, ix, ar[0], ar[1], ctx, true) < 0 { return -1 }
    }
  }
  // Scope-aware and positioned, as `wasmEmit` resolves this call: the flat `fnIndexOf`
  // would hand a nested `<T>` template to the prune while the emitter calls it, and a
  // binding in scope at the call must shadow a namesake nested in another frame (D2759).
  let fe = fnIndexOfInScopeAt(
    sidOfNode(n.callFn),
    callee.identName,
    ctx,
    n.callFn,
  )
  const direct = fe >= 0
  let wlName = callee.identName
  let wlAt = n.callFn
  let wlFr = ctx
  if fe < 0 {
    // A call through a `const` alias of a lambda's `const` binding calls that lambda, and is
    // instantiated per call alike (D2896).
    let afe = monoRespellLamFe(n.callFn, ctx)
    // A direct call through a value binding to a generic named function: resolve it
    // to the lifted slot and monomorphize per call site. Named functions only, and
    // re-read rather than reused from `dfe`, the coercion loop between having run.
    if afe < 0 { afe = identClosureFeAt(sidOfNode(n.callFn), ctx, n.callFn) }
    // An alias renamed to one frame instance of a generic still calls the generic: each
    // call through it takes its own instance (D3887).
    if afe >= 0 && afe < fnInstOrigin.length && fnInstOrigin[afe] >= 0 {
      const ao = fnInstOrigin[afe]
      if ao < monoGen.length && monoGen[ao] == 1 { afe = ao }
    }
    // The initializer's lambda, which a reassigned binding need not hold at this call: the
    // call keeps its `call_ref` and only the lambda is pinned (D3849, D3858).
    if afe >= 0 && monoReadIsAssigned(callee.identName, n.callFn) {
      monoNoRename.push(n.callFn)
    }
    if afe < 0 { afe = monoCapturedLamFe(n.callFn, ctx) }
    // A chain of aliases ending at a generic function by name is a call to it (D3894).
    if afe < 0 { afe = monoReadGenFnFe(n.callFn) }
    if afe < 0 {
      afe = monoAliasLamFe(n.callFn, ctx, false)
      // The call would be re-spelled to the lambda's own name, which a parameter or local
      // here may rebind: it keeps its `call_ref` through the alias then (D3861).
      if afe >= 0 && monoNameShadowedAt(monoSlotName(afe), n.callFn, ctx) {
        monoNoRename.push(n.callFn)
      }
      // A `const`-only chain is re-spelled above unless that name is rebound here; then
      // the lambda is pinned through the chain and the call keeps its `call_ref` (D3861).
      if afe < 0 {
        const cfe = monoAliasLamFe(n.callFn, ctx, true)
        if cfe >= 0 {
          afe = cfe
          monoNoRename.push(n.callFn)
        }
      }
      // The chain names the lambda it is initialized with. Where a link is written, that
      // need not be the value the alias holds at this call, so the call keeps its
      // `call_ref` and only the lambda is pinned (D3849); an unwritten chain always holds it.
      if afe >= 0 && fnFlowReadWritten(n.callFn) { monoNoRename.push(n.callFn) }
    }
    // An alias of a `let` calls what the `let` holds: an unwritten one its hole lambda, and a
    // written one the value last written to it, so the seed is pinned at this call, which
    // keeps its `call_ref`, and the writes take that signature (D3961).
    if afe < 0 {
      const wl = monoAliasLetEnd(n.callFn, ctx)
      if wl[0] >= 0 {
        afe = identClosureFeAt(sidOfNode(wl[0]), wl[1], wl[0])
        if afe >= 0 && afe < fnInstOrigin.length && fnInstOrigin[afe] >= 0 {
          afe = fnInstOrigin[afe]
        }
        if afe >= 0 && wl[2] == 1 {
          monoNoRename.push(n.callFn)
          wlName = monoIdentNameOf(wl[0])
          wlAt = wl[0]
          wlFr = wl[1]
        }
      }
    }
    if afe >= 0 {
      if !criFnIsAnonLambda(afe) {
        // The fold below rewrites `f(x)` into a by-name call to the initializer's
        // instance, faithful only while the binding still holds it — hence the
        // restriction to an annotated binding, whose `$fnsig` the `call_ref` needs.
        if identFnTypeAnnName(callee.identName, ctx) == "" { fe = afe }
        else if !monoReadIsAssigned(callee.identName, n.callFn) { fe = afe }
      } else if identFnTypeAnnName(callee.identName, ctx) == "" {
        // A lambda bound to an un-annotated `const`: its params are inference holes,
        // so monomorphize it per call exactly like a named generic function. An
        // annotated binding is contextually pinned and excluded.
        fe = afe
      }
    }
  }
  if fe >= 0 && fe < monoGen.length {
    if monoGen[fe] == 1 {
      monoLastInstFe = -1
      if !direct && monoWritesCoercedFirstCall("n:", wlAt, wlFr) {
        monoWriteCoercedCall = n.callFn
      }
      const ri = monoInstantiate(fe, ix, ctx)
      monoWriteCoercedCall = -1
      monoNoteBindCall(n.callFn, ctx, ix)
      // The call keeps its `call_ref` through a written `let`, so each generic written to it
      // takes the instance's signature, as a delivery of the binding does (D3961).
      if ri >= 0 && !direct && monoLastInstFe >= 0 {
        const ctn = monoSigFnTyName(monoSlotSig(monoLastInstFe))
        if ctn != "" {
          const prev = monoSigCallRet
          monoSigCallRet = nodeTyIxOf(ix)
          monoCellSigByCall = true
          monoCoerceWrittenLetValues(wlAt, wlFr, ctn)
          monoCellSigByCall = false
          monoSigCallRet = prev
        }
      }
      return ri
    }
    // A CONCRETE callee: specialize it per non-capturing callback (no-op if none) — the
    // concrete analogue of `monoInstantiate`'s callback baking.
    return monoSpecializeConcrete(ix, fe, ctx)
  }
  return 0
}

// Walk function `fnIx`'s own body, coercing its implicit return first. A bare-expression
// body parses to a synthetic one-statement `Block` with no `RetStmt`, so `monoWalk`'s
// `RetStmt` arm has nothing to read; the value of a body block is its last statement,
// which is what `monoCoerceFnValueName`'s `Block` arm walks to.
function monoWalkFnBody(fnIx: i32) {
  const fn = P.nodes[fnIx]
  if !vrIndexed(fnIx) {
    const one: i32[] = [fnIx]
    monoReachIndex(one)
  }
  if fn is FuncDecl {
    if monoCoerceFnValue(fn.fnBody, fn.fnRet, fnIx) < 0 { return -1 }
    if monoNoteRetDeliveries(fn, fnIx) < 0 { return -1 }
    // A body's value is delivered past the return like a `return`'s argument (D6340).
    if fn.fnRet < 0 && fn.fnBody >= 0 {
      const b = P.nodes[fn.fnBody]
      if b is Block && b.blkStmts.length > 0 {
        const tail = b.blkStmts[b.blkStmts.length - 1]
        if monoCoerceRetAtPin(tail, fnIx) < 0 { return -1 }
      }
    }
    return monoWalk(fn.fnBody, fnIx)
  }
  0
}

// Each binding function `fn` (node `fnIx`) returns, by `return` or as its body's value, is
// delivered at its annotated function-typed result (D3862).
function monoNoteRetDeliveries(fn: FuncDecl, fnIx: i32) {
  if fn.fnRet < 0 { return 0 }
  monoNoteRetDeliveriesAt(fn, fnIx, tyNameOf(fn.fnRet))
}

// `monoDeliverCallRets` for `at` when it is a call of a function declared by name; 0 otherwise.
function monoDeliverCallAt(at: i32, ann: string): i32 {
  const c = unwrapParen(at)
  if c < 0 { return 0 }
  const cn = P.nodes[c]
  if !(cn is Call) { return 0 }
  const cf = unwrapParen(cn.callFn)
  if cf < 0 || !(P.nodes[cf] is Ident) { return 0 }
  const fd = identDeclOf(cf)
  if fd < 0 { return 0 }
  monoDeliverCallRets(c, ann, fd)
}

// Per un-annotated concrete function node, the function type its calls' results are delivered at.
let monoRetDeliveredAt: {[i32]: i32} = Map()

// A call `at` of un-annotated concrete function `fd` delivered at function type `ann` delivers
// each of `fd`'s returns there, as an annotated result would, when one of them is a hole lambda;
// a second type is refused, since the one value `fd` returns has one signature (D6522).
function monoDeliverCallRets(at: i32, ann: string, fd: i32): i32 {
  const fn = P.nodes[fd]
  if !(fn is FuncDecl) || fn.fnRet >= 0 || fn.fnTyParams.length > 0 { return 0 }
  for p in fn.fnParams {
    const pn = P.nodes[p]
    if pn is Param {
      if pn.parType < 0 { return 0 }
    }
  }
  const at2 = nameToTy(ann)
  if at2 < 0 { return 0 }
  if !monoRetsReachHoleLam(fd, []) { return 0 }
  const rets = monoFnRetArgs(fn)
  const prev = monoRetDeliveredAt[fd] ?? -1
  if prev == at2 { return 0 }
  if prev >= 0 {
    return emitFailAt(
      "emitProgram: `"
        + fn.fnName
        + "` returns one function value and its calls deliver it at "
        + "two function types, and one function value has one signature — return a separate "
        + "function for each type",
      at,
    )
  }
  // arena-tick exempt: a side table keyed by declaration, not an arena scan
  monoRetDeliveredAt[fd] = at2
  for r in rets {
    if monoNoteBindDeliveryCall(r, ann, fd, -1) < 0 { return -1 }
  }
  0
}

// Whether function `fd` returns a hole lambda, directly or through a call of a function that
// does; `seen` holds the functions already asked.
function monoRetsReachHoleLam(fd: i32, seen: i32[]): boolean {
  if fd < 0 || i32ListHas(seen, fd) { return false }
  const fn = P.nodes[fd]
  if !(fn is FuncDecl) { return false }
  seen.push(fd)
  for r in monoFnRetArgs(fn) {
    const x = unwrapParen(r)
    const fe = monoLamValueFe(x, fd)
    if fe >= 0 && fe < monoGen.length && monoGen[fe] == 1 && monoLamIsHole(fe) {
      return true
    }
    if x >= 0 {
      const cn = P.nodes[x]
      if cn is Call {
        const cf = unwrapParen(cn.callFn)
        if (
          cf >= 0
          && P.nodes[cf] is Ident
          && monoRetsReachHoleLam(identDeclOf(cf), seen)
        ) {
          return true
        }
      }
    }
  }
  false
}

// The values `fn` returns: its body's last statement and each `return`'s argument, a nested
// function's own excluded.
function monoFnRetArgs(fn: FuncDecl): i32[] {
  const out: i32[] = []
  const b = P.nodes[fn.fnBody]
  if b is Block {
    if b.blkStmts.length > 0 { out.push(b.blkStmts[b.blkStmts.length - 1]) }
  }
  const stack: i32[] = [fn.fnBody]
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      const n = P.nodes[ix]
      if n is RetStmt { out.push(n.retArg) }
      if !(n is FuncDecl) {
        for k in nodeChildren(ix) { stack.push(k) }
      }
    }
  }
  out
}

// `monoNoteRetDeliveries` at the function type spelled `ann` in place of `fn`'s own result.
function monoNoteRetDeliveriesAt(fn: FuncDecl, fnIx: i32, ann: string) {
  const parts: string[] = []
  if annFnDecompose(ann, parts) == "" { return 0 }
  for r in monoFnRetArgs(fn) {
    if monoNoteBindDeliveryCall(r, ann, fnIx, -1) < 0 { return -1 }
  }
  0
}

// The `fnStmts` position `emitExportSection` would resolve `name` to: the first slot
// holding a `FuncDecl` of that name. The mirroring is load-bearing — `monoNameIsExported`
// answers about a name, but two slots can carry one name and only one is the ABI entry.
// The other is ordinary dead code that must keep taking the silent no-op stub.

// Prior iterations of the prune loop only ever replace a slot with a same-named stub, so
// the answer does not depend on how far the prune has walked.
function monoFirstFnIndexNamed(name: string): i32 {
  let i = 0
  while i < fnStmts.length {
    const f = P.nodes[fnStmts[i]]
    if f is FuncDecl {
      if f.fnName == name { return i }
    }
    i = i + 1
  }
  -1
}

// The public name an ABI entry publishes `name` under — for the diagnostic below, so it
// names what the user wrote. In module mode a merged name is mangled and a re-export may
// rename it, so the raw `fnName` is not something the source contains. Falls back to
// `name`.
function monoExportPublicName(name: string): string {
  let i = 0
  while i < reExpTarget.length {
    if reExpTarget[i] == name { return reExpName[i] }
    i = i + 1
  }
  name
}

// Did `monomorphize` pin the generic declaration at lifted position `origFe` from at least
// one call site? Every instantiation records a row, the count-0 one included, so this is
// the rename-immune answer, asked after the pass has rewritten callee identifiers to
// instance names — which is why counting `Ident`s cannot answer it.

// A template nothing instantiated still emits its body at the i32 default, and that body
// is only accidentally valid, so every value-floor exemption handing one out as a closure
// has to demand this first.
export function monoInstantiatedAny(origFe: i32) {
  let k = 0
  while k < monoInstOrig.length {
    if monoInstOrig[k] == origFe { return true }
    k = k + 1
  }
  false
}

// The value-floor reject text for the generic function at lifted position `fe`: names the
// function and its un-annotated parameters, and — from `monoPinnedSigsOf` — the concrete
// signatures the program's own call sites already pin it at, the annotation to write.
export function genericFnValueRejectMsg(fe: i32) {
  let nm = "<anonymous>"
  let holes = ""
  let nHoles = 0
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if fn.fnName != "" { nm = fn.fnName }
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param {
        if p.parType < 0 {
          if holes != "" { holes = holes + ", " }
          holes = holes + "`" + p.parName + "`"
          nHoles = nHoles + 1
        }
      }
      i = i + 1
    }
  }
  let head = "emitProgram: cannot take the generic function `"
    + nm
    + "` as a value — a function value carries ONE signature, and "
  if nHoles == 1 {
    head = head
      + "parameter "
      + holes
      + " is un-annotated (it would default to i32). "
  } else {
    head = head
      + "parameters "
      + holes
      + " are un-annotated (they would default to i32). "
  }
  const sigs = monoPinnedSigsOf(fe)
  if sigs == "" {
    return head
      + "No call site pins `"
      + nm
      + "`, so there is no inferred signature to adopt — annotate the parameter"
      + pluralS(nHoles)
      + ", or call `"
      + nm
      + "` directly by name"
  }
  head
    + "Call sites pin `"
    + nm
    + "` at "
    + sigs
    + " — annotate the parameter"
    + pluralS(nHoles)
    + " with the signature this value needs, or call `"
    + nm
    + "` directly by name"
}

// `"s"` for a plural count, `""` for exactly one — kept out of the message builder so the
// two branches cannot disagree about the diagnostic's own agreement.
function pluralS(n: i32) {
  if n == 1 { return "" }
  "s"
}

// The distinct concrete parameter spellings every instance pinned for the generic
// declaration at `origFe`, comma-joined — or "" when no call site pinned it. The
// diagnostic half of `monoInstantiatedAny`. `monoInstFe` can name an appended slot, so
// the bound is `fnStmts.length`.
export function monoPinnedSigsOf(origFe: i32) {
  const sigs: string[] = []
  let k = 0
  while k < monoInstOrig.length {
    if monoInstOrig[k] == origFe {
      const ife = monoInstFe[k]
      if ife >= 0 && ife < fnStmts.length {
        const fn = P.nodes[fnStmts[ife]]
        if fn is FuncDecl {
          let sig = "("
          const ps = fn.fnParams
          let i = 0
          while i < ps.length {
            if i > 0 { sig = sig + ", " }
            const p = P.nodes[ps[i]]
            if p is Param {
              if p.parType >= 0 {
                sig = sig + tyNameOf(p.parType)
              } else {
                sig = sig + "i32"
              }
            }
            i = i + 1
          }
          // Two instances can render the same spelling (their keys differ in a baked CALLBACK,
          // not in a parameter type), and a repeated signature reads as a compiler bug.
          pushUniqueAtom(sigs, sig + ")")
        }
      }
    }
    k = k + 1
  }
  let out = ""
  let j = 0
  while j < sigs.length {
    if j > 0 { out = out + ", " }
    out = out + sigs[j]
    j = j + 1
  }
  out
}

// Which of `names` is referenced as a function value (an `Ident` that is not a `Call`'s callee)
// in the arena: 1 when a reference is not in `monoInertValues`, 2 when every one is, else 0,
// parallel to `names`; the un-annotated-param prune needs it. With `cmpCalls`, an `==`/`!=`
// operand counts as no use, since a comparison calls nothing.
function monoNamesUsedAsValue(names: string[], cmpCalls: boolean): i32[] {
  const hit: i32[] = []
  let h = 0
  while h < names.length {
    hit.push(0)
    h = h + 1
  }
  if names.length == 0 { return hit }
  const isCallee: i32[] = []
  let i = 0
  while i < P.nodes.length {
    isCallee.push(0)
    i = i + 1
  }
  let j = 0
  while j < P.nodes.length {
    const cn = P.nodes[j]
    if cn is Call {
      const cf = cn.callFn
      // arena-tick exempt: `isCallee` is a local declared in this function.
      if cf >= 0 && cf < isCallee.length { isCallee[cf] = 1 }
    }
    // A name write's value: the written-binding passes instance it or refuse it (D3939).
    if cn is BinExpr && cn.binOp == "=" && P.nodes[cn.binLeft] is Ident {
      const rv = unwrapParen(cn.binRight)
      // arena-tick exempt: `isCallee` is a local declared in this function.
      if rv >= 0 && rv < isCallee.length { isCallee[rv] = 2 }
    }
    if cmpCalls && cn is BinExpr && (cn.binOp == "==" || cn.binOp == "!=") {
      const lo = unwrapParen(cn.binLeft)
      const ro = unwrapParen(cn.binRight)
      // arena-tick exempt: `isCallee` is a local declared in this function.
      if lo >= 0 && lo < isCallee.length { isCallee[lo] = 1 }
      // arena-tick exempt: `isCallee` is a local declared in this function.
      if ro >= 0 && ro < isCallee.length { isCallee[ro] = 1 }
    }
    j = j + 1
  }
  let dead: i32[] = []
  let k = 0
  while k < P.nodes.length {
    if isCallee[k] != 1 {
      const idn = P.nodes[k]
      if idn is Ident {
        let m = 0
        while m < names.length {
          if names[m] == idn.identName && hit[m] != 1 {
            let mark = 1
            if isCallee[k] == 2 || i32ListHas(monoInertValues, k) { mark = 2 }
            // A template body no slot emits holds no use (D6930); built on the first such read.
            if mark == 1 && dead.length == 0 { dead = monoUnemittedNodes() }
            if mark == 1 && dead[k] == 1 { mark = hit[m] }
            // arena-tick exempt: `hit` is this function's own out-parameter list.
            hit[m] = mark
          }
          m = m + 1
        }
      }
    }
    k = k + 1
  }
  hit
}

// Per node, 1 when only the body of a generic template no slot emits holds it: one whose first
// instance replaced its slot, or an unreplaced `<T>` template the prune stubs. 0 for every node
// an emitted slot or a module statement reaches, and for every node no template holds.
function monoUnemittedNodes(): i32[] {
  const mark: i32[] = []
  while mark.length < P.nodes.length { mark.push(0) }
  const slots: {[i32]: i32} = Map()
  // arena-tick exempt: `slots` is this function's own count, not the arena.
  for f in fnStmts { slots[f] = (slots[f] ?? 0) + 1 }
  const roots: i32[] = []
  let gc = 0
  while gc < monoOrigNode.length && gc < monoGen.length && gc < fnStmts.length {
    const o = monoOrigNode[gc]
    if monoGen[gc] == 1 && o >= 0 && o < P.nodes.length {
      const f = P.nodes[o]
      if f is FuncDecl {
        const n = slots[o] ?? 0
        if n == 0 || (n == 1 && fnStmts[gc] == o && f.fnTyParams.length > 0) {
          roots.push(o)
        }
      }
    }
    gc = gc + 1
  }
  if roots.length == 0 { return mark }
  // arena-tick exempt: `mark` is this function's own table, not the arena.
  for o in roots { mark[o] = 3 }
  for o in roots { monoMarkReach(mark, o, 1) }
  for f in fnStmts { monoMarkReach(mark, f, 2) }
  for st in monoProgStmts { monoMarkReach(mark, st, 2) }
  let i = 0
  while i < mark.length {
    // arena-tick exempt: `mark` is this function's own table, not the arena.
    if mark[i] == 3 { mark[i] = 1 }
    i = i + 1
  }
  mark
}

// Marks `v` every node `root` reaches, entering function bodies, that holds a lower mark; a dead
// template root (3) is entered only as its own root.
function monoMarkReach(mark: i32[], root: i32, v: i32) {
  if root < 0 || root >= mark.length || (mark[root] == 3 && v == 2) { return 0 }
  const stack: i32[] = [root]
  while stack.length > 0 {
    const cur = stack.pop() ?? -1
    if cur >= 0 && cur < mark.length && (cur == root || mark[cur] < v) {
      if mark[cur] != 3 || cur == root {
        // arena-tick exempt: `mark` is the caller's own table, not the arena.
        if mark[cur] != 3 { mark[cur] = v }
        const b = monoNestedBodyOf(cur)
        if b >= 0 { stack.push(b) }
        for ch in nodeChildren(cur) { stack.push(ch) }
      }
    }
  }
  0
}

// The lifted-function position of the generic named function the module-level binding at
// `letIx` aliases, when handing that template out as this binding's closure value is sound
// — else -1. Three gates, each load-bearing: an un-annotated-param named function,
// instantiated at least once, and never referenced as a value.
export function monoGenericAliasFe(letIx: i32) {
  if letIx < 0 { return -1 }
  const d = P.nodes[letIx]
  if d is LetDecl {
    const fe = fieldValueFeOf(d.letInit)
    if fe < 0 { return -1 }
    if !fnHasUnannotatedParam(fe) { return -1 }
    if criFnIsAnonLambda(fe) { return -1 }
    if !monoInstantiatedAny(fe) { return -1 }
    const one: string[] = []
    one.push(d.letName)
    const used = monoNamesUsedAsValue(one, true)
    if used[0] != 0 { return -1 }
    return fe
  }
  -1
}

// Instantiates the un-annotated lambda in slot `fe` at the one signature the flow table pins its
// class at, so a peer's cell type is not met with the hole's i32 default. A lambda the checker
// typed concretely keeps that signature: a pin names no result, so its instance would return the
// body's own type. 0 when the table pins none, -1 on a failed mint.
function monoPinLamFromFlow(fe: i32): i32 {
  if fe < 0 || fe >= fnStmts.length { return 0 }
  const lt = nodeTyIxOf(fnStmts[fe])
  if lt >= 0 && lt < T.tys.length && T.tys[lt] is TyFunc && !tyHasTyVar(lt) {
    return 0
  }
  monoPinLamAtTys(fe, fnFlowLamPin(fnStmts[fe]), false)
}

// The instance the last `monoMakeInstance` minted or hit; -1 before one.
let monoLastInstFe = 0 - 1
// Per binding node a call goes through, the `;`-joined signatures the calls take.
let monoBindCallSigs: {[i32]: string} = Map()

// Records the signature of call `ix` just lowered through the binding read at `at` in frame
// `ctx`, on that binding and on every binding its initializer chain names.
function monoNoteBindCall(at: i32, ctx: i32, ix: i32) {
  if monoLastInstFe < 0 { return 0 }
  const prev = monoSigCallRet
  monoSigCallRet = nodeTyIxOf(ix)
  monoNoteBindSig(at, ctx, monoSlotSig(monoLastInstFe), monoSigRetVoid(""))
  monoSigCallRet = prev
  0
}

// A binding read at `at` in frame `ctx` and delivered where annotation `tyNode` is a function
// type with concrete parameters is called at that signature by whoever receives it (D3862).
// `callIx` is the call it is an argument of, or -1 for any other position.
function monoNoteBindDelivery(at: i32, tyNode: i32, ctx: i32, callIx: i32) {
  if tyNode < 0 { return 0 }
  monoNoteBindDeliveryCall(at, tyNameOf(tyNode), ctx, callIx)
}

// `monoNoteBindDelivery` at the function type spelled `ann`: a list's element type, for a
// `push` or an element store, has a type and no annotation node (D3867).
function monoNoteBindDeliveryAt(at: i32, ann: string, ctx: i32) {
  monoNoteBindDeliveryCall(at, ann, ctx, -1)
}

// `monoNoteBindDeliveryAt` where the delivery is an argument of call `callIx`, or -1.
function monoNoteBindDeliveryCall(at: i32, ann: string, ctx: i32, callIx: i32) {
  if at < 0 { return 0 }
  let name = monoIdentNameOf(at)
  if name == "" { name = monoCellReadName(at) }
  if name == "" {
    if P.nodes[unwrapParen(at)] is Call { return monoDeliverCallAt(at, ann) }
    return monoDeliverLamLit(at, ann, ctx, callIx)
  }
  const parts: string[] = []
  if annFnDecompose(ann, parts) == "" { return 0 }
  let sig = ""
  for pt in parts {
    if pt == "" { return 0 }
    sig = sig + pt + ","
  }
  monoDeliveredArgs.push(monoReadNameNode(at))
  // A hole lambda the name reaches that nothing has pinned yet takes the signature in place,
  // as its own contextual type would pin it (D3852).
  const fe = monoLamValueFe(at, ctx)
  if (
    fe >= 0
    && fe < monoGen.length
    && monoGen[fe] == 1
    && !monoInstantiatedAny(fe)
  ) {
    if monoInstanceFor(fe, monoSigPins(sig + ";"), fnStmts[fe], -1) < 0 {
      return -1
    }
  } else if (
    fe >= 0
    && fe < monoGen.length
    && monoGen[fe] == 1
    && monoSlotSig(fe) != sig + ";"
    && monoWriteNamesLam(at, fe, ctx)
  ) {
    // One pinned at another signature: the delivered name takes the instance at this one, minted
    // by the first such delivery and found by every later one (D3867, D3881).
    if monoInstanceFor(fe, monoSigPins(sig + ";"), at, -1) < 0 { return -1 }
  }
  monoNoteBindSig(at, ctx, sig + ";", monoSigRetVoid(ann))
}

// A hole lambda written as a literal where function type `ann` is delivered is pinned there in
// place, as a capture cell's literal is. One literal wanted at two types takes an instance per
// type where it is an argument of call `callIx`, and is refused elsewhere (D5881, D5931).
function monoDeliverLamLit(at: i32, ann: string, ctx: i32, callIx: i32): i32 {
  if monoLamLitTake(at, ann, ctx) == 1 {
    const x = unwrapParen(at)
    const pnames: string[] = []
    const lfe = monoLamValueFe(x, ctx)
    if (
      callIx >= 0
      && monoFnTypeAnnParamsName(peelGroupParens(nonNulBaseOf(ann)), pnames)
      && monoHoleLamArgAgain(callIx, lfe, x, pnames) >= 0
    ) {
      return 0
    }
    return emitFailAt(
      "emitProgram: this lambda is handed on at two different function types, and one lambda "
        + "literal has one signature — bind it once per type, or annotate its parameters",
      unwrapParen(at),
    )
  }
  0
}

// `monoCellLamTake` for the hole lambda literal at `at`, or 0 for anything else, including one
// its context already typed, which keeps that signature and its result.
function monoLamLitTake(at: i32, ann: string, ctx: i32): i32 {
  const x = unwrapParen(at)
  if x < 0 || !(P.nodes[x] is FuncDecl) { return 0 }
  if monoTyConcreteFn(nodeTyIxOf(x)) { return 0 }
  const lfe = monoLamValueFe(x, ctx)
  if lfe < 0 || lfe >= monoGen.length || monoGen[lfe] != 1 { return 0 }
  if !monoLamIsHole(lfe) { return 0 }
  monoCellLamTake(lfe, x, ann, ctx)
}

// The pin of hole lambda `args[i]` handed to un-annotated parameter `i` of generic `decl`: the
// function type the body hands that parameter to, through a call of another parameter or on
// through another generic, with the lambda instanced at it in place, or an instance of its own
// replacing the argument of call `callIx` where another type pinned it first; "" for none (D5931).
function monoHoleLamArgPin(
  callIx: i32,
  decl: i32,
  args: i32[],
  i: i32,
  ctx: i32,
  tyOut: i32[],
): string {
  const x = unwrapParen(args[i])
  if x < 0 || !(P.nodes[x] is FuncDecl) { return "" }
  const lfe = monoLamValueFe(x, ctx)
  if (
    lfe < 0
    || lfe >= monoGen.length
    || monoGen[lfe] != 1
    || !monoLamIsHole(lfe)
  ) {
    return ""
  }
  let bt = monoHoleArgDemandTy(decl, args, i, ctx)
  // A hole parameter the body calls takes the instance the checker bound at this call (D5935).
  if bt < 0 { bt = monoHoleParamBindTy(callIx, decl, i) }
  if bt < 0 || !monoTyConcreteFn(bt) { return "" }
  const sk = sigKeyOfTy(bt)
  const bf = T.tys[bt]
  if sk == "" || !(bf is TyFunc) { return "" }
  const pnames: string[] = []
  for pt in bf.fnParamTypes {
    const pn = monoLamPinName(pt, 8)
    if pn == "" { return "" }
    pnames.push(pn)
  }
  let r = monoCellLamTakeAt(lfe, x, pnames, ctx)
  if r == 1 {
    const nx = monoHoleLamArgAgain(callIx, lfe, x, pnames)
    if nx >= 0 {
      args[i] = nx
      monoArenaTouch()
      r = 0
    }
  }
  if r == 1 {
    emitFailAt(
      "emitProgram: this lambda is handed on at two different function types, and one lambda "
        + "literal has one signature — bind it once per type, or annotate its parameters",
      x,
    )
    return ""
  }
  if r != 0 { return "" }
  // arena-tick exempt: a caller-owned out-parameter, not the arena.
  tyOut[0] = bt
  "=>" + sk
}

// The concrete function type the checker bound un-annotated parameter `i` of `decl` to at call
// `callIx`; -1 for none.
function monoHoleParamBindTy(callIx: i32, decl: i32, i: i32): i32 {
  if decl < 0 || decl >= P.nodes.length { return -1 }
  const dn = P.nodes[decl]
  if !(dn is FuncDecl) || i < 0 || i >= dn.fnParams.length { return -1 }
  const pt = nodeTyIxOf(dn.fnParams[i])
  if pt < 0 || pt >= T.tys.length { return -1 }
  const pv = T.tys[pt]
  if !(pv is TyVar) { return -1 }
  const bt = callBindTyOf(callIx, pv.tvName)
  if bt < 0 || bt >= T.tys.length || !(T.tys[bt] is TyFunc) { return -1 }
  bt
}

// Hole lambda `lfe`, the literal `x` among the arguments of call `callIx`, instanced at the
// parameter pins `pnames` beside the instance another type took first: that instance's node,
// which replaces the argument, or -1 when none could be made.
function monoHoleLamArgAgain(
  callIx: i32,
  lfe: i32,
  x: i32,
  pnames: string[],
): i32 {
  if callIx < 0 || callIx >= P.nodes.length { return -1 }
  const c = P.nodes[callIx]
  if !(c is Call) { return -1 }
  let k = 0
  while k < c.callArgs.length && unwrapParen(c.callArgs[k]) != x { k = k + 1 }
  if k >= c.callArgs.length { return -1 }
  monoLastInstFe = -1
  const r = monoInstanceFor(lfe, pnames, x, -1)
  const fe = monoLastInstFe
  if r < 0 || fe < 0 || fe >= fnStmts.length || fe == lfe { return -1 }
  c.callArgs[k] = fnStmts[fe]
  monoArenaTouch()
  fnStmts[fe]
}

// The type the body of generic `decl` hands its un-annotated parameter `i` to, with the other
// parameters typed by this call's `args`; -1 for none, or two that differ.
function monoHoleArgDemandTy(decl: i32, args: i32[], i: i32, ctx: i32): i32 {
  if decl < 0 || decl >= P.nodes.length { return -1 }
  const dn = P.nodes[decl]
  if !(dn is FuncDecl) || i >= dn.fnParams.length { return -1 }
  const pNames: string[] = []
  const pTys: i32[] = []
  let j = 0
  while j < dn.fnParams.length && j < args.length {
    const pj = P.nodes[dn.fnParams[j]]
    if pj is Param {
      pNames.push(pj.parName)
      if j == i {
        pTys.push(-1)
      } else {
        pTys.push(monoArgPinTyIx(args[j], ctx))
      }
    }
    j = j + 1
  }
  if pNames.length != dn.fnParams.length { return -1 }
  monoHoleLamDemandTy(decl, pNames[i], pNames, pTys, 0)
}

// The pin of literal `args[i]` of call `callIx` where the checker made it a copy per type a
// forwarder's callers retyped it at: the copy at the type this instance's body hands it to,
// which replaces the argument in the instance's own call; "" where no copy answers (D5880).
function monoHoleLitCopyPin(
  callIx: i32,
  decl: i32,
  args: i32[],
  i: i32,
  ctx: i32,
  tyOut: i32[],
): string {
  const x = unwrapParen(args[i])
  if x < 0 { return "" }
  const cps = holeLitCopiesOf(x)
  if cps.length == 0 { return "" }
  const d = monoHoleArgDemandTy(decl, args, i, ctx)
  if d < 0 || tyHasTyVar(d) { return "" }
  const c = P.nodes[callIx]
  if !(c is Call) { return "" }
  let k = 0
  while k < c.callArgs.length && c.callArgs[k] != args[i] { k = k + 1 }
  if k >= c.callArgs.length { return "" }
  for cp in cps {
    const pt = holeLitPinOf(cp)
    if pt >= 0 && tySameSpelled(pt, d, TY_WALK_DEPTH) {
      const nm = monoArgPinName(cp, ctx)
      if nm == "" { return "" }
      c.callArgs[k] = cp
      args[i] = cp
      monoArenaTouch()
      // arena-tick exempt: a caller-owned out-parameter, not the arena.
      tyOut[0] = pt
      return nm
    }
  }
  ""
}

// The pin of a list or record literal `args[i]` the checker did not retype, a hole among its
// leaves: the type of another rep the body of generic `decl` hands that parameter to, so the
// instance takes it there as the direct call does; "" otherwise (D5930).
function monoHoleLeafLitPin(
  decl: i32,
  args: i32[],
  i: i32,
  ctx: i32,
  tyOut: i32[],
): string {
  const x = unwrapParen(args[i])
  if x < 0 || !(P.nodes[x] is ArrayLit || P.nodes[x] is ObjLit) { return "" }
  if holeLitPinOf(x) >= 0 || holeLitCopiesOf(x).length > 0 { return "" }
  const d = monoHoleArgDemandTy(decl, args, i, ctx)
  if d < 0 || tyHasTyVar(d) { return "" }
  let dv = T.tys[d]
  if dv is TyNullable {
    if dv.nInner < 0 { return "" }
    dv = T.tys[dv.nInner]
  }
  if P.nodes[x] is ArrayLit && !(dv is TyArray) { return "" }
  if P.nodes[x] is ObjLit && !(dv is TyObj) { return "" }
  const own = nodeTyIxOf(x)
  if (
    own >= 0
    && !tyHasTyVar(own)
    && assignable(own, d)
    && assignable(d, own)
  ) {
    return ""
  }
  const nm = monoI32AtomPinName(d)
  if nm == "" { return "" }
  // arena-tick exempt: a caller-owned out-parameter, not the arena.
  tyOut[0] = d
  nm
}

// The one function type the body of `decl` hands its parameter `target` to, where `pNames`'
// parameters have the types `pTys` (-1 unknown); -1 for none, or two that differ.
function monoHoleLamDemandTy(
  decl: i32,
  target: string,
  pNames: string[],
  pTys: i32[],
  depth: i32,
): i32 {
  if depth > 4 || decl < 0 { return -1 }
  const dn = P.nodes[decl]
  if !(dn is FuncDecl) || dn.fnBody < 0 { return -1 }
  const got: i32[] = [0 - 1]
  const stack: i32[] = [dn.fnBody]
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    // An absent child (an `if` with no `else`, a bare `return`) is -1.
    if ix < 0 || ix >= P.nodes.length { continue }
    const c = P.nodes[ix]
    if c is Call {
      const t = monoHoleLamCallDemand(c, target, pNames, pTys, depth)
      if t >= 0 {
        if got[0] >= 0 && !tySameSpelled(got[0], t, TY_WALK_DEPTH) { return -1 }
        // arena-tick exempt: a local accumulator, not the arena.
        got[0] = t
      }
    }
    for k in nodeChildren(ix) { stack.push(k) }
  }
  got[0]
}

// What call `c` in a body with parameters `pNames: pTys` hands `target` at, or -1.
function monoHoleLamCallDemand(
  c: Call,
  target: string,
  pNames: string[],
  pTys: i32[],
  depth: i32,
): i32 {
  if c.callFn < 0 || c.callFn >= P.nodes.length { return -1 }
  const cf = P.nodes[c.callFn]
  if !(cf is Ident) { return -1 }
  let k = 0
  while k < c.callArgs.length && monoIdentNameOf(c.callArgs[k]) != target {
    k = k + 1
  }
  if k >= c.callArgs.length { return -1 }
  let j = 0
  while j < pNames.length && pNames[j] != cf.identName { j = j + 1 }
  if j < pNames.length {
    const pt = pTys[j]
    if pt < 0 || pt >= T.tys.length { return -1 }
    const f = T.tys[pt]
    if !(f is TyFunc) || k >= f.fnParamTypes.length { return -1 }
    return f.fnParamTypes[k]
  }
  const fe = fnIndexOf(cf.identName)
  if fe < 0 || fe >= monoOrigNode.length { return -1 }
  const g = P.nodes[monoOrigNode[fe]]
  if !(g is FuncDecl) || g.fnParams.length != c.callArgs.length { return -1 }
  const gNames: string[] = []
  const gTys: i32[] = []
  let q = 0
  while q < g.fnParams.length {
    const gp = P.nodes[g.fnParams[q]]
    if !(gp is Param) { return -1 }
    gNames.push(gp.parName)
    const an = monoIdentNameOf(c.callArgs[q])
    let at = -1
    let r = 0
    while r < pNames.length {
      if pNames[r] == an { at = pTys[r] }
      r = r + 1
    }
    gTys.push(at)
    q = q + 1
  }
  monoHoleLamDemandTy(monoOrigNode[fe], gNames[k], gNames, gTys, depth + 1)
}

// Each argument of `xs.push(…)`, and the value of `m.set(k, v)`, is delivered at the one signature
// the flow table pins the list's element or the map's value slot at in this frame (D3867, D3881).
function monoNotePushDeliveries(n: Call, ctx: i32) {
  const cf = P.nodes[n.callFn]
  if !(cf is Member) { return 0 }
  if cf.memProp == "set" && n.callArgs.length == 2 {
    const sv = monoPlacePinName(cf.memObj, "v", ctx)
    return monoDeliverAtPin(n.callArgs[1], sv, ctx)
  }
  if cf.memProp != "push" { return 0 }
  const en = monoPlacePinName(cf.memObj, "e", ctx)
  for pa in n.callArgs {
    if monoDeliverAtPin(pa, en, ctx) < 0 { return -1 }
  }
  0
}

// Deliver value `v` at the function type `pin` names: a generic it names takes that instance, and
// a hole lambda it reads takes one per signature it is delivered at; nothing when `pin` is "".
function monoDeliverAtPin(v: i32, pin: string, ctx: i32) {
  if pin == "" { return 0 }
  if monoCoerceFnValueName(v, pin, ctx, -1) < 0 { return -1 }
  monoNoteBindDeliveryAt(v, pin, ctx)
}

// The binding place `e` (`fs`, `fs[0]`, `r.f`, `gs[0][0]`) is rooted at, with each derived slot
// step from it pushed onto `path` (`e` an element, `v` a map value, `f.<name>` a field); -1 when
// the root is no name, or is a capture cell's read, which the cell path delivers.
function monoPlaceRoot(e: i32, path: string[], depth: i32): i32 {
  if depth > 16 { return -1 }
  const x = unwrapParen(e)
  if x < 0 { return -1 }
  const n = P.nodes[x]
  if n is Index {
    if monoIsCellRead(x) { return -1 }
    const d = monoPlaceRoot(n.idxArr, path, depth + 1)
    path.push(fnFlowElemKind(n.idxArr))
    return d
  }
  if n is Member {
    const d = monoPlaceRoot(n.memObj, path, depth + 1)
    path.push("f." + n.memProp)
    return d
  }
  monoPlaceNameDecl(x)
}

// Whether `x` reads a capture cell, `cell[0]` of a binding the capture rewrite declared, and not
// element 0 of a list the program declared.
function monoIsCellRead(x: i32): boolean {
  if monoCellReadName(x) == "" { return false }
  const r = P.nodes[x]
  if !(r is Index) { return false }
  const di = identDeclOf(r.idxArr)
  if di < 0 || di >= P.nodes.length { return false }
  const d = P.nodes[di]
  d is LetDecl && monoGeneratedCellElem(d.letInit) >= 0
}

// The declaration the name `x` reads; -1 for any other node, which roots no binding place.
function monoPlaceNameDecl(x: i32): i32 {
  if !(P.nodes[x] is Ident) { return -1 }
  identDeclOf(x)
}

// The function type a value stored into place `e`, or into its slot `kid` when not "", delivers
// at in frame `ctx`: the one signature the flow table pins that slot at; "" for none or two.
function monoPlacePinName(e: i32, kid: string, ctx: i32): string {
  const path: string[] = []
  const d = monoPlaceRoot(e, path, 0)
  if d < 0 { return "" }
  if kid != "" { path.push(kid) }
  monoSlotPinName(d, path, ctx)
}

// The function type the slot `path` derives from binding or literal `d` delivers at in frame
// `ctx`: the one signature the flow table pins it at (`monoDeclPathPins`), returning the one
// return annotations give it, else `void`; "" for no signature or two.
function monoSlotPinName(d: i32, path: string[], ctx: i32): string {
  const lf: i32[] = [ctx, d]
  const pins = monoDeclPathPins(lf, path)
  if pins.length != 1 { return "" }
  const noDead: {[i32]: boolean} = Map()
  const rets = monoDeclPathKeys(lf, path, true, noDead)
  if rets.length != 1 || rets[0] == FF_PIN_DECLINE {
    return monoSigFnTyName(pins[0] + ";")
  }
  monoSigFnTyNameRet(pins[0] + ";", rets[0])
}

// The spelling of `ty` when it is a function type with no hole, else "".
function monoConcreteFnTyName(ty: i32): string {
  if ty < 0 || ty >= T.tys.length || !(T.tys[ty] is TyFunc) { return "" }
  monoConcreteFnPinName(ty)
}

// The pin spelling of `ty` when it is a function type or a list of one, with no hole, else "".
function monoConcreteFnPinName(ty: i32): string {
  if ty < 0 || ty >= T.tys.length || tyHasTyVar(ty) { return "" }
  const t = T.tys[ty]
  if t is TyArray && !monoPinIsFnTy(t.aElem) { return "" }
  if !(t is TyArray) && !(t is TyFunc) { return "" }
  tyToEmitName(ty)
}

// The name function slot `fe` is declared or bound under, "" when it has none.
function monoSlotName(fe: i32): string {
  if fe < 0 || fe >= fnStmts.length { return "" }
  const f = P.nodes[fnStmts[fe]]
  if f is FuncDecl { return f.fnName }
  ""
}

// Whether `name`, read at `at` in frame `ctx`, is a parameter or local of `ctx` or of a function
// enclosing it, and so not the module-scope binding of that name.
function monoNameShadowedAt(name: string, at: i32, ctx: i32): boolean {
  if name == "" { return false }
  const sid = sidOf(name)
  let fx = ctx
  let hops = 0
  while hops < 16 && fx >= 0 {
    if monoFnBindsParam(fx, name) { return true }
    const f = P.nodes[fx]
    if f is FuncDecl {
      if bodyLetReadAtSid(f.fnBody, sid, at) >= 0 { return true }
    }
    const slot = fnStmtsPosOf(fx)
    if slot < 0 || slot >= fnParent.length { return false }
    const ps = fnParent[slot]
    if ps < 0 || ps >= fnStmts.length { return false }
    fx = fnStmts[ps]
    hops = hops + 1
  }
  false
}

// The name nodes `monoNoteBindDelivery` recorded: each is a call of what it reads.
let monoDeliveredArgs: i32[] = []

// Records signature `sig` on the binding read at `at` (a name or a capture cell's `d[0]`) in
// frame `ctx`, and on every binding its initializer chain names.
function monoNoteBindSig(at: i32, ctx: i32, sig: string, quiet: boolean) {
  if sig == "" { return 0 }
  let ax = at
  let fr = ctx
  let hops = 0
  while hops < 8 {
    const lf = monoReadLetFrame(ax, fr)
    if lf[1] < 0 { return 0 }
    const d = P.nodes[lf[1]]
    if !(d is LetDecl) { return 0 }
    // A call in a function nothing names never runs.
    // A module-scope binding's call in an unnamed module-scope function still counts: that
    // function is lowered, and with it the call (D3868).
    if hops == 0 && lf[0] >= 0 && monoWriteFrameDead(ctx, lf[0]) { return 0 }
    const had = monoBindCallSigs.get(lf[1]) ?? ""
    monoBindCallSigs.set(lf[1], monoSigListAdd(had, sig, quiet))
    if d.letInit < 0 { return 0 }
    let iv = d.letInit
    const ce = monoGeneratedCellElem(iv)
    if ce >= 0 { iv = ce }
    ax = iv
    fr = lf[0]
    hops = hops + 1
  }
  0
}

// Holds each reassigned binding a hole lambda reaches at the one signature the flow table pins
// it at, since a call at another traps (D3857): its initializer delivers there, as its writes
// already do. A binding pinned at two signatures is refused. -1 on a refusal.
function monoBindingsAtPin(nDecl: i32): i32 {
  monoLetWritesExtend()
  const seen: {[i32]: boolean} = Map()
  const order: i32[] = []
  for k in monoWriteOrder { order.push(k) }
  for k in order {
    // Locating a write's frame walks the program, so a binding that cannot hold a lambda is
    // passed over before any of its writes is located.
    let kd = k
    if k < 0 { kd = 0 - 1 - k }
    if monoBindingMayHoldLam(kd) {
      for i in monoWriteListAt(k) {
        const nd = P.nodes[i]
        if nd is BinExpr {
          const wf = monoTopFrameOf(i)
          const lf = monoReadLetFrame(nd.binLeft, wf)
          if lf[1] >= 0 && !(seen[lf[1]] ?? false) {
            // arena-tick exempt: seen is this function's local table, not the arena
            seen[lf[1]] = true
            if monoBindingAtPin(lf, nDecl) < 0 { return -1 }
          }
        }
      }
    }
  }
  0
}

// Whether the binding declared at `k` may hold a hole lambda: an un-annotated `let` whose
// initializer or some write's value is a lambda literal or a name read, the only values
// `monoLamValueFe` resolves to one. A necessary condition, read without locating any frame.
function monoBindingMayHoldLam(k: i32): boolean {
  if k < 0 || k >= P.nodes.length { return false }
  const d = P.nodes[k]
  if !(d is LetDecl) { return false }
  if d.letKw != "let" || d.letType >= 0 || d.letInit < 0 { return false }
  let iv = d.letInit
  const ce = monoGeneratedCellElem(iv)
  if ce >= 0 { iv = ce }
  if monoValueMayNameLam(iv) { return true }
  for key in ["n:", "c:"] {
    for i in monoWritesOf(key, k) {
      const nd = P.nodes[i]
      if nd is BinExpr && monoValueMayNameLam(nd.binRight) { return true }
    }
  }
  false
}

// Whether the value at `vx` is a lambda literal or a name or capture-cell read.
function monoValueMayNameLam(vx: i32): boolean {
  P.nodes[vx] is FuncDecl
    || monoIdentNameOf(vx) != ""
    || monoCellReadName(vx) != ""
}

// `monoBindingsAtPin` for the binding `lf` (`[frame, declaration]`).
function monoBindingAtPin(lf: i32[], nDecl: i32): i32 {
  const d = P.nodes[lf[1]]
  if !(d is LetDecl) { return 0 }
  if d.letKw != "let" || d.letType >= 0 || d.letInit < 0 { return 0 }
  let iv = d.letInit
  const ce = monoGeneratedCellElem(iv)
  if ce >= 0 { iv = ce }
  let lam = monoLamValueFe(iv, lf[0]) >= 0
  for key in ["n:", "c:"] {
    for i in monoWritesOf(key, lf[1]) {
      const nd = P.nodes[i]
      const wf = monoLetWriteFrame(lf, i)
      if nd is BinExpr && wf.length == 1 {
        if monoLamValueFe(nd.binRight, wf[0]) >= 0 { lam = true }
      }
    }
  }
  if !lam { return 0 }
  // A captured binding lives in a cell, so its slot is the cell element.
  const path: string[] = []
  if ce >= 0 { path.push("e") }
  // A call in a function nothing names never runs, so its pin does not count.
  let pins = monoDeclPathPins(lf, path)
  if pins.length > 1 { pins = monoDeclLivePathPins(lf, path) }
  if pins.length > 1 { return monoBindSigFail(d.letName, lf[1]) }
  // One read by name is renamed to the instance at the pin, as a write by name is.
  if (
    pins.length == 1
    && monoWriteNamesLam(iv, monoLamValueFe(iv, lf[0]), lf[0])
  ) {
    if monoRenameInitAt(lf[1], lf[0], pins[0] + ";", nDecl) < 0 {
      return monoBindSigFail(d.letName, lf[1])
    }
    return monoRetypePinCalls(lf[1], path)
  }
  if monoDeliverAtPin(iv, monoSlotPinName(lf[1], path, lf[0]), lf[0]) < 0 {
    return -1
  }
  if pins.length == 1 { monoRetypePinCalls(lf[1], path) }
  0
}

// For the binding `d` held at its one pin: each call taking that pin whose callee the checker left
// an open type, as one past an inferred return is, is typed at its own arguments and result,
// which are the pin's (D5062). In a body a generic's instances share, those types are closed, so
// the signature is every instance's (D5970).
function monoRetypePinCalls(d: i32, path: string[]): i32 {
  for cx in fnFlowDeclPathPinCalls(d, path) {
    const c = P.nodes[cx]
    if c is Call {
      const cf = unwrapParen(c.callFn)
      const ct = nodeTyIxOf(cf)
      const rt = nodeTyIxOf(cx)
      if (
        cf >= 0
        && ct >= 0
        && ct < T.tys.length
        && T.tys[ct] is TyFunc
        && tyHasTyVar(ct)
        && rt >= 0
      ) {
        let ps: i32[] = []
        for a in c.callArgs {
          const at = nodeTyIxOf(a)
          if at >= 0 && !tyHasTyVar(at) { ps.push(at) }
        }
        let r = rt
        // A call at the enclosing generic's own type parameter takes the pin's closed types
        // when every walk agrees on them (D6003).
        if ps.length != c.callArgs.length || tyHasTyVar(r) {
          ps = fnFlowDeclPathPinTysAt(d, path, cx)
          r = monoPinCallRet(c.callArgs, ps, rt)
        }
        if (
          r >= 0
          && ps.length == c.callArgs.length
          && monoWritesTypedAt(d, ps)
        ) {
          nodeTyRecord(cf, mkFuncTy(ps, r))
        }
      }
    }
  }
  0
}

// Result type `rt` of a call with arguments `args` pinned at the closed parameter types `pt`: each
// argument typed by a bare type variable binds it to its pin. -1 when `pt` does not cover the
// arguments, an argument disagrees with its pin, or the result stays open.
function monoPinCallRet(args: i32[], pt: i32[], rt: i32): i32 {
  if pt.length != args.length { return -1 }
  const bN: string[] = []
  const bT: i32[] = []
  let i = 0
  while i < args.length {
    const at = nodeTyIxOf(args[i])
    if at < 0 || at >= T.tys.length || pt[i] < 0 { return -1 }
    const a = T.tys[at]
    if a is TyVar {
      bN.push(a.tvName)
      bT.push(pt[i])
    } else if tyHasTyVar(at) || at != pt[i] {
      return -1
    }
    i = i + 1
  }
  let r = rt
  if tyHasTyVar(r) { r = substTyDeep(r, bN, bT) }
  if r < 0 || tyHasTyVar(r) { return -1 }
  r
}

// For a value `v` an un-annotated function returns in frame `ctx`: a declared generic is delivered
// at the one signature the flow table pins the read at, past the return, and each call taking
// that pin is typed at it (D5360). No pin, or two, leaves the value to the emitter's refusal.
function monoCoerceRetAtPin(v: i32, ctx: i32): i32 {
  if v < 0 { return 0 }
  const x = unwrapParen(v)
  if x < 0 { return 0 }
  if (
    monoIfBindingOf(x, ctx)[1] >= 0
    || P.nodes[x] is IfStmt && monoValueNamesGenerics(x, ctx, 0)
  ) {
    return monoIfBoundRetAtPin(x, ctx)
  }
  if !monoNamesDeclaredGeneric(x, ctx) && monoReadGenFnFe(x) < 0 { return 0 }
  const noPath: string[] = []
  // An alias of one is pinned at its own binding, which the flow table keys the read by (D5400).
  let d = x
  let fr = ctx
  const it = monoFrameInstTmpl(ctx)
  const lf = monoReadLetFrame(x, ctx)
  if lf[1] >= 0 {
    d = lf[1]
    fr = lf[0]
  } else {
    // A read in an instance body is banked under the template's read, at the same position.
    const xn = P.nodes[x]
    if it[1] >= 0 && xn is Ident {
      const tr = monoIdentAtPosIn(it[1], xn.identName, xn.pos, 0)
      if tr >= 0 { d = tr }
    }
  }
  const nm = monoSlotPinName(d, noPath, fr)
  if nm == "" { return monoAskRetCopies(fr, d, ctx) }
  if monoCoerceFnValueName(x, nm, ctx, -1) < 0 { return -1 }
  monoRetypePinCalls(d, noPath)
}

// For a value keyed `d` in frame `fr` that frame `ctx` returns with no one pin: two pins past
// the return ask for a copy of the function per result pin (D5531). An instance asks for its
// template, which is what the plan copies.
function monoAskRetCopies(fr: i32, d: i32, ctx: i32): i32 {
  const noPath: string[] = []
  const it = monoFrameInstTmpl(ctx)
  let asked = ctx
  if it[0] == ctx && it[1] >= 0 { asked = it[1] }
  if monoDeclPathPins([fr, d], noPath).length > 1 { fsAsk(asked) }
  0
}

// Whether every write of the binding `d` the checker gave a closed function type takes the
// parameters `ps`; one typed at another call's arguments would be delivered at the wrong
// signature, so the call is left open and refused.
function monoWritesTypedAt(d: i32, ps: i32[]): boolean {
  for key in ["n:", "c:"] {
    for i in monoWritesOf(key, d) {
      const nd = P.nodes[i]
      if nd is BinExpr {
        const wt = nodeTyIxOf(nd.binRight)
        if wt >= 0 && wt < T.tys.length && !tyHasTyVar(wt) {
          const w = T.tys[wt]
          if w is TyFunc {
            if w.fnParamTypes.length != ps.length { return false }
            let j = 0
            while j < ps.length {
              if !tyEq(w.fnParamTypes[j], ps[j]) { return false }
              j = j + 1
            }
          }
        }
      }
    }
  }
  true
}

// Whether frame `wf`, at or below frame `top`, is a function nothing names below `top` — so
// never called — or lies inside one. -1 (module scope) and `top` itself are live.
function monoWriteFrameDead(wf: i32, top: i32): boolean {
  let fx = wf
  let guard = 0
  while fx >= 0 && fx != top && guard <= fnStmts.length {
    const slot = fnStmtsPosOf(fx)
    if slot < 0 || slot >= fnParent.length { return false }
    const ps = fnParent[slot]
    // A module-scope function: dead when no statement names it and the host cannot call it.
    if ps < 0 { return monoTopFnUnnamed(fx) }
    if ps >= fnStmts.length { return false }
    const parent = fnStmts[ps]
    const f = P.nodes[fx]
    let nm = ""
    if f is FuncDecl { nm = f.fnName }
    // A lambda is named by the `const` it initializes.
    const pb = monoNestedBodyOf(parent)
    if pb < 0 { return false }
    if nm == "" || criFnIsAnonLambda(slot) { nm = monoConstNameOfInit(pb, fx) }
    if nm == "" { return false }
    if !monoSubtreeNamesIdent(pb, nm, 0) { return true }
    fx = parent
    guard = guard + 1
  }
  false
}

// The function node holding node `ix` that a module-scope function is, or a function lifted
// inside one; -1 for a node of the module's own statements.
function monoTopFrameOf(ix: i32): i32 {
  const st = monoProgTopOf(ix)
  if st < 0 { return -1 }
  monoFrameOfNode(ix, st)
}

// Whether module-scope function node `fx` is named by no statement of the program and is no
// export, so nothing calls it; a lambda is named by the `const` it initializes.
function monoTopFnUnnamed(fx: i32): boolean {
  const f = P.nodes[fx]
  let nm = ""
  if f is FuncDecl { nm = f.fnName }
  if nm != "" && monoNameIsExported(nm) { return false }
  if nm == "" || criFnIsAnonLambda(fnStmtsPosOf(fx)) {
    nm = ""
    for st in monoProgStmts {
      if nm == "" { nm = monoConstNameOfInit(st, fx) }
    }
    if nm == "" || monoNameIsExported(nm) { return false }
  }
  !monoProgNamesIdent(nm)
}

// The identifiers the program's statements name (`monoSubtreeNamesIdent` over each), and whether
// a walk passed its depth bound, which answers every name; banked like `monoProgTop` (D4942).
let monoProgNames: {[string]: boolean} = Map()
let monoProgNamesDeep = false
let monoProgNamesStamp = 0 - 1

// Whether some statement of the program mentions the identifier `nm`.
function monoProgNamesIdent(nm: string): boolean {
  const stamp = monoArenaStamp() + monoProgStmts.length
  if stamp != monoProgNamesStamp {
    const names: {[string]: boolean} = Map()
    let deep = false
    const ixs: i32[] = []
    const depths: i32[] = []
    for st in monoProgStmts {
      ixs.push(st)
      depths.push(0)
    }
    while ixs.length > 0 {
      const ix = ixs.pop() ?? -1
      const d = depths.pop() ?? 0
      if ix >= 0 && ix < P.nodes.length {
        const n = P.nodes[ix]
        if d > 400 {
          deep = true
        } else if n is Ident {
          // arena-tick exempt: names is this function's fresh table, not the arena
          names[n.identName] = true
        } else {
          for k in nodeChildren(ix) {
            ixs.push(k)
            depths.push(d + 1)
          }
        }
      }
    }
    monoProgNames = names
    monoProgNamesDeep = deep
    monoProgNamesStamp = stamp
  }
  monoProgNamesDeep || (monoProgNames[nm] ?? false)
}

// Whether the binding `lf` (`[frame, declaration]`) is written, directly or through its capture
// cell, in code that can run: a write in a function nothing names cannot.
function monoLetWrittenLive(lf: i32[]): boolean {
  const top = lf[0]
  for key in ["n:", "c:"] {
    for i in monoWritesOf(key, lf[1]) {
      if monoFrameHolds(top, i) {
        let wf = monoTopFrameOf(i)
        if top >= 0 { wf = monoFrameOfNode(i, top) }
        if !monoWriteFrameDead(wf, top) { return true }
      }
    }
  }
  false
}

// The name of the un-annotated `const` in the subtree at `ix` whose initializer is `init`, or "".
function monoConstNameOfInit(ix: i32, init: i32): string {
  const stack: i32[] = [ix]
  while stack.length > 0 {
    const cur = stack.pop() ?? -1
    if cur >= 0 && cur < P.nodes.length {
      const bn = monoConstInitName(cur, init)
      if bn != "" { return bn }
      if !(P.nodes[cur] is FuncDecl) || cur == ix {
        for k in nodeChildren(cur) { stack.push(k) }
      }
    }
  }
  ""
}

// Instantiates the lambda binding node `li` (declared in frame `fx`) is initialized with, by
// name, at signature `target`, renaming the initializer and retyping a capture cell it seeds.
// -1 when that lambda cannot take the signature; 0 otherwise, including no such initializer.
function monoRenameInitAt(li: i32, fx: i32, target: string, nDecl: i32): i32 {
  const bd = P.nodes[li]
  if !(bd is LetDecl) { return 0 }
  if bd.letInit < 0 { return 0 }
  let iv = bd.letInit
  const ce = monoGeneratedCellElem(iv)
  if ce >= 0 { iv = ce }
  const fe = monoLamValueFe(iv, fx)
  if fe < 0 || fe >= nDecl || !monoWriteNamesLam(iv, fe, fx) { return 0 }
  if monoInstantiatedAny(fe) && monoSlotSig(fe) == target { return 0 }
  monoLastInstFe = -1
  if monoInstanceFor(fe, monoSigPins(target), iv, -1) < 0 { return -1 }
  if !monoSigListHas(monoLamInstSigs(fe), target) { return -1 }
  // A capture cell it seeds holds that instance, so it takes that instance's type.
  if ce >= 0 && monoLastInstFe >= 0 {
    const it = monoPinSubTyOf(
      monoCellElemTyOf(bd.letInit, ce),
      fnStmts[monoLastInstFe],
    )
    if monoTyConcreteFn(it) {
      nodeTyRecord(ce, it)
      nodeTyRecord(bd.letInit, mkArrayTy(it))
    }
  }
  0
}

// Whether the written value `vx`, read in frame `fx`, names the lambda in slot `fe` through
// bindings never written after their initializer: a name an instance at another signature can
// take the place of.
function monoWriteNamesLam(vx: i32, fe: i32, fx: i32): boolean {
  if monoIdentNameOf(vx) == "" || fe < 0 || fe >= monoOrigNode.length {
    return false
  }
  // Through bindings never written after their initializer (`const d2 = c`).
  let at = vx
  let fr = fx
  let hops = 0
  while hops < 8 {
    const lf = monoReadLetFrame(at, fr)
    if lf[1] < 0 { return false }
    const d = P.nodes[lf[1]]
    if !(d is LetDecl) { return false }
    if d.letType >= 0 || d.letInit < 0 { return false }
    if d.letKw != "const" && monoLetWrittenLive(lf) { return false }
    if d.letInit == monoOrigNode[fe] { return true }
    if !(P.nodes[d.letInit] is Ident) { return false }
    at = d.letInit
    fr = lf[0]
    hops = hops + 1
  }
  false
}

// The first-instance signature of lambda slot `fe`, as `p1,p2,;`.
function monoSlotSig(fe: i32): string {
  const pins: string[] = []
  if !monoSlotParamPins(fe, pins) { return "" }
  let out = ""
  for pn in pins { out = out + pn + "," }
  out + ";"
}

// The parameter pins one `p1,p2,;` signature spells.
function monoSigPins(sig: string): string[] {
  const out: string[] = []
  let st = 0
  let i = 0
  while i < sig.length {
    if sig[i] == ","[0] {
      out.push(sig.slice(st, i))
      st = i + 1
    }
    i = i + 1
  }
  out
}

// The parameter signatures the instances of lambda slot `fe` take, each as `p1,p2,;`; "" for
// a lambda no instance pinned.
function monoLamInstSigs(fe: i32): string {
  if !monoInstantiatedAny(fe) { return "" }
  let out = monoSlotSig(fe)
  let k = 0
  while k < monoInstOrig.length && k < monoInstFe.length {
    if monoInstOrig[k] == fe && monoInstFe[k] != fe {
      const one = monoSlotSig(monoInstFe[k])
      if one != "" && !monoSigListHas(out, one) { out = out + one }
    }
    k = k + 1
  }
  out
}

// Signature list `all` with `one` added. When `quiet` (the call returns nothing), one joining an
// entry (`monoSigJoin`) at either of the two is one signature, held at the join: a call at the
// other passes its value as the join's.
function monoSigListAdd(all: string, one: string, quiet: boolean): string {
  let out = ""
  let st = 0
  let i = 0
  let met = false
  while i < all.length {
    if all[i] == ";"[0] {
      const e = all.slice(st, i + 1)
      let j = ""
      if !met && quiet {
        const sj = monoSigJoin(e, one)
        if sj != "" { j = sj + ";" }
      }
      if e == one || j == e {
        met = true
        out = out + e
      } else if j != "" && j == one {
        met = true
        out = out + one
      } else {
        out = out + e
      }
      st = i + 1
    }
    i = i + 1
  }
  if met { return out }
  all + one
}

// Whether the `;`-joined signature list `all` holds `one`.
function monoSigListHas(all: string, one: string): boolean {
  let i = 0
  while i + one.length <= all.length {
    if all.slice(i, i + one.length) == one && (i == 0 || all[i - 1] == ";"[0]) {
      return true
    }
    i = i + 1
  }
  false
}

// Refuses `let` `decl` for holding functions called at two signatures, and asks the driver
// to give it an instance record (`fn_split.vl`), which replaces this compile when it builds.
function monoBindSigFail(nm: string, decl: i32): i32 {
  fsAsk(decl)
  fnFlowSigFailNote(nm)
  emitFail(
    "emitProgram: the reassigned function binding `"
      + nm
      + "` holds functions called at more than one argument type — one binding holds one closure "
      + "signature, and the values written to it want two. Annotate the parameters, or "
      + "bind a separate value per type",
  )
}

// Instantiate the un-annotated lambda in slot `fe` at the concrete parameter types the checker
// recorded for it (a callback's contextual type), so a generic its body calls is pinned there
// rather than at the hole's default (D3820). 0 when it declines, -1 on a failed mint.
function monoPinLamFromCheckedTy(fe: i32) {
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if !monoSubtreeCallsGeneric(fn.fnBody, fnStmts[fe], 0) { return 0 }
    const tys = monoFnValueParamTys(nodeTyIxOf(fnStmts[fe]), fn.fnParams.length)
    // A callback of a built-in `.map` / `.filter` is called at its element's own spelling; one
    // handed to a function takes that function's parameter type, keyed by its render (D3834).
    return monoPinLamAtTys(fe, tys, monoIsBuiltinCallback(fnStmts[fe]))
  }
  0
}

// Instantiates the lambda in slot `fe` at parameter types `tys`, each pinned by its declared
// record's name, else its render (`builtin`: the spelling a built-in callback's element takes).
// 0 when the count differs or a type cannot be pinned, -1 on a failed mint.
function monoPinLamAtTys(fe: i32, tys: i32[], builtin: boolean): i32 {
  if fe < 0 || fe >= fnStmts.length { return 0 }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    if tys.length == 0 || tys.length != fn.fnParams.length { return 0 }
    const pins: string[] = []
    let i = 0
    while i < tys.length {
      if !monoLamPinTyPlain(tys[i], 8) { return 0 }
      let nm = ""
      if builtin {
        nm = monoLamPinName(tys[i], 8)
      } else {
        nm = structNameOfTy(tys[i])
        if nm == "" { nm = tyToEmitName(tys[i]) }
      }
      if nm == "" { return 0 }
      pins.push(nm)
      i = i + 1
    }
    return monoInstanceFor(fe, pins, fnStmts[fe], -1)
  }
  0
}

// The lambda nodes passed straight to a built-in `.map` or `.filter`, found on first use.
let monoBuiltinCbLams: {[i32]: i32} = Map()
let monoBuiltinCbLamsBuilt = false

// Whether lambda node `lam` is the callback of a built-in `.map` or `.filter` call.
function monoIsBuiltinCallback(lam: i32): boolean {
  if !monoBuiltinCbLamsBuilt {
    monoBuiltinCbLamsBuilt = true
    monoBuiltinCbLams = Map()
    const stack: i32[] = []
    for st in monoProgStmts { stack.push(st) }
    while stack.length > 0 {
      const ix = stack.pop() ?? -1
      if ix >= 0 && ix < P.nodes.length {
        const n = P.nodes[ix]
        if n is Call {
          const cf = P.nodes[n.callFn]
          if cf is Member {
            if (
              (cf.memProp == "map" || cf.memProp == "filter")
              && n.callArgs.length == 1
            ) {
              // arena-tick exempt: this module's own lookup table, not the arena.
              monoBuiltinCbLams[unwrapParen(n.callArgs[0])] = 1
            }
          }
        }
        for k in nodeChildren(ix) { stack.push(k) }
      }
    }
  }
  (monoBuiltinCbLams[lam] ?? 0) == 1
}

// The annotation spelling a `monoLamPinTyPlain` type pins a lambda parameter at: a declared
// record by its name at any list depth, and a generic record's instance by its application,
// so the element keeps the name its annotation would give it (D3834).
function monoLamPinName(ty: i32, depth: i32): string {
  if ty < 0 || ty >= T.tys.length || depth <= 0 { return "" }
  const t = T.tys[ty]
  if t is TyArray {
    const en = monoLamPinName(t.aElem, depth - 1)
    if en == "" { return "" }
    return en + "[]"
  }
  const sn = structNameOfTy(ty)
  if sn != "" { return sn }
  // A generic record's instance by its application (`Box<A>`), which names its arguments.
  const ga = genAppNameOfTy(ty)
  if ga != "" { return ga }
  const ir = monoInlineRecPinName(ty, depth)
  if ir != "" { return ir }
  tyToEmitName(ty)
}

// An inline record whose fields name declared records, spelled as its row is interned (`{v:A}`),
// which the render (`{v:{x:i32}}`) does not reach; "" for any other type or no such row (D3875).
function monoInlineRecPinName(ty: i32, depth: i32): string {
  const t = T.tys[ty]
  if !(t is TyObj) { return "" }
  let sp = "{"
  let i = 0
  while i < t.objFieldNames.length && i < t.objFieldTypes.length {
    const fp = monoLamPinName(t.objFieldTypes[i], depth - 1)
    if fp == "" { return "" }
    if i > 0 { sp = sp + "," }
    sp = sp + t.objFieldNames[i] + ":" + fp
    i = i + 1
  }
  sp = sp + "}"
  if structIndexByName(sp) < 0 { return "" }
  sp
}

// Whether `ty` is a primitive, a record, or a list of those: the types whose name alone is
// the pin. A literal union, a value union, a nullable or a function value carries a rep the
// name does not, so a lambda at one keeps the template path.
function monoLamPinTyPlain(ty: i32, depth: i32): boolean {
  if ty < 0 || ty >= T.tys.length || depth <= 0 { return false }
  const t = T.tys[ty]
  match t {
    TyPrim | TyObj => {
      return true
    }
    TyArray => {
      return monoLamPinTyPlain(t.aElem, depth - 1)
    }
    TyLit | TyUnion | TyNullable | TyFunc | TyMap | TyVar | TyNeg | TyErr => {}
  }
  false
}

// Whether the subtree at `ix`, read in frame `ctx`, calls a named generic or hole function by
// name. A nested function is its own slot and is not entered. False past the depth floor.
function monoSubtreeCallsGeneric(ix: i32, ctx: i32, depth: i32): boolean {
  if ix < 0 || ix >= P.nodes.length || depth > 256 { return false }
  const n = P.nodes[ix]
  if n is FuncDecl { return false }
  if n is Call {
    const cf = P.nodes[n.callFn]
    if cf is Ident {
      const fe = fnIndexOfInScopeAt(
        sidOfNode(n.callFn),
        cf.identName,
        ctx,
        n.callFn,
      )
      if (
        fe >= 0
        && fe < monoGen.length
        && monoGen[fe] == 1
        && !criFnIsAnonLambda(fe)
      ) {
        return true
      }
    }
  }
  for k in nodeChildren(ix) {
    if monoSubtreeCallsGeneric(k, ctx, depth + 1) { return true }
  }
  false
}

// Whether node `ix` lies in the body of function node `fx` (the program, for -1), or in the
// body of a function lifted out of it at any depth.
function monoFrameHolds(fx: i32, ix: i32): boolean {
  if fx < 0 { return monoProgHolds(ix) }
  const body = monoNestedBodyOf(fx)
  if body < 0 { return false }
  if monoSubtreeHolds(body, ix) { return true }
  for k in monoLiftedDescendants(fnStmtsPosOf(fx)) {
    const kb = monoNestedBodyOf(fnStmts[k])
    if kb >= 0 && monoSubtreeHolds(kb, ix) { return true }
  }
  false
}

// The `fnStmts` positions of the functions lifted out of the one at `slot`, at any depth,
// parents before children; read off the frame child index.
function monoLiftedDescendants(slot: i32): i32[] {
  const out: i32[] = []
  if slot < 0 { return out }
  if fnChildHead.length != fnStmts.length { buildFnChildIndex() }
  const stack: i32[] = [slot]
  while stack.length > 0 {
    const p = stack.pop() ?? -1
    if p >= 0 && p < fnChildHead.length {
      let c = fnChildHead[p]
      while c >= 0 && c < fnChildNext.length && out.length <= fnStmts.length {
        out.push(c)
        stack.push(c)
        c = fnChildNext[c]
      }
    }
  }
  out
}

// A parameter pin spelled as its value's type: a string literal union holds strings, so an
// instance at it and one at `string` are one signature.
function monoPinWidened(pin: string): string {
  if nameIsLitUnionType(pin) { return "string" }
  pin
}

// The concrete parameter spellings a lifted slot's declaration carries, appended to `out`
// — an instance's pins, read the way `monoPinnedSigsOf` reads them, with `"i32"` for the
// hole a count-0 all-i32 clone deliberately leaves un-annotated. false when the slot is
// not a function declaration at all.
function monoSlotParamPins(fe: i32, out: string[]) {
  if fe < 0 || fe >= fnStmts.length { return false }
  const fn = P.nodes[fnStmts[fe]]
  if fn is FuncDecl {
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = P.nodes[ps[i]]
      if p is Param {
        if p.parType >= 0 {
          out.push(tyNameOf(p.parType))
        } else {
          out.push("i32")
        }
      } else {
        return false
      }
      i = i + 1
    }
    return true
  }
  false
}

// The monomorphization pass: snapshot which lifted functions are generic, then walk every
// top-level statement in program order and every non-generic function body; instance
// bodies are walked as they are created. Usage-gated: a program with no generic
// declaration and no concrete higher-order function returns immediately.
export function monomorphize(stmts: i32[]) {
  monoArenaTick = 0
  monoClashLits = []
  monoCallTpl = Map()
  monoLamCallCallees = []
  monoProgLamNames = []
  monoRebuiltStamp = 0 - 1
  monoRetPending = false
  monoBodyDeclStamp = 0 - 1
  monoGen = []
  monoOrigNode = []
  fnPosIndexDrop()
  monoKeys = []
  monoInstOrig = []
  monoInstName = []
  monoInstFe = []
  monoParamPinTy = Map()
  monoAnonParamPinTy = Map()
  monoFramedPushes = Map()
  monoBindCallSigs = Map()
  monoRetDeliveredAt = Map()
  monoCellCoercedSig = Map()
  monoSigCallRet = -2
  monoHoleLamSlots = Map()
  monoBuiltinCbLamsBuilt = false
  monoDeliveredArgs = []
  monoStubSlots = []
  monoInertValues = []
  monoInertCalled = []
  monoInertArgAt = []
  monoInertArgFe = []
  monoFieldReadTys = Map()
  monoLastInstFe = -1
  monoFnFieldTwinRow = Map()
  monoTwoListRet = Map()
  monoSubTablesReset()
  monoGradualObjLits = Map()
  monoGradualObjList = []
  monoGradualAsScalar = Map()
  monoGradualRetPinned = false
  monoExactMemo = []
  monoActiveDepth = []
  monoExactStack = []
  monoExactNext = 0
  monoExactLow = 0
  monoProgStmts = stmts
  monoProgHeldStamp = 0 - 1
  monoProgNamesStamp = 0 - 1
  monoProgTop = []
  monoProgNames = Map()
  monoProgNamesDeep = false
  monoNoRename = []
  monoAliasCallDecl = Map()
  monoDeclWrites = Map()
  monoWriteOrder = []
  monoCellWrites = Map()
  monoFieldWrites = Map()
  monoElemWrites = Map()
  monoLetWritesSeen = 0
  monoLetWritesExtend()
  // The index follows the table it answers for, at the write and not at a build point:
  // between the two there is no reader, so `monoModuleLetOf` cannot see an empty column.
  monoProgLetBySid = []
  let mi = 0
  while mi < stmts.length {
    const ms = P.nodes[stmts[mi]]
    if ms is LetDecl {
      if ms.letType < 0 && ms.letInit >= 0 {
        const mv = P.nodes[unwrapParen(ms.letInit)]
        if mv is FuncDecl && monoIsGenericDecl(unwrapParen(ms.letInit)) {
          monoNoteName(monoProgLamNames, ms.letName)
        }
      }
      // First occurrence wins: a later module binding sharing the name keeps the slot.
      const msid = sidOfNode(stmts[mi])
      if sidArrGet(monoProgLetBySid, msid) < 0 {
        sidArrPut(monoProgLetBySid, msid, stmts[mi])
      }
    }
    mi = mi + 1
  }
  monoLamPinned = []
  monoLamShared = []
  monoNamedTmplNode = []
  monoNamedTmplSlot = []
  let any = false
  let fe = 0
  while fe < fnStmts.length {
    monoOrigNode.push(fnStmts[fe])
    if monoIsGenericDecl(fnStmts[fe]) {
      monoGen.push(1)
      any = true
    } else {
      monoGen.push(0)
    }
    fe = fe + 1
  }
  // The pass also runs for callback specialization of a concrete higher-order function.
  // Gated on the program actually defining one, so a generic-free, HOF-free program (the
  // compiler itself) skips the pass entirely.
  if !any {
    if monoHasConcreteHOFParam() { any = true }
  }
  if !any { return 0 }
  // The flow table reads the tree before the walk rewrites it.
  fnFlowTableBuild(stmts)
  if monoShadowRename(fnStmts.length) < 0 { return -1 }
  monoFlowReads(stmts)
  monoInertReach(stmts)
  // Top-level statements first, in source order (global inits + start stmts).
  let i = 0
  while i < stmts.length {
    const s = P.nodes[stmts[i]]
    if s is FuncDecl {
    } else if s is LetDecl {
      // Walk the `LetDecl` node, not just its init, so the annotated-function-typed
      // binding materialization in `monoWalk`'s `LetDecl` arm reaches a top-level binding
      // too; the arm still recurses into the init.
      if monoWalk(stmts[i], -1) < 0 { return -1 }
    } else if nodeIsTypeDecl(stmts[i]) {
    } else if s is UnionDecl {
    } else {
      if monoWalk(stmts[i], -1) < 0 { return -1 }
    }
    i = i + 1
  }
  for k in mfrKeptTop {
    if monoWalk(k, -1) < 0 { return -1 }
  }
  // Then every non-generic lifted function's body. A generic original's body is only ever
  // walked through an instance; an instance appended during this loop extends `fnStmts`,
  // but its body is walked on creation — `monoGen` is frozen at the pre-pass length.
  let fe2 = 0
  const nDecl = monoGen.length
  while fe2 < nDecl {
    if monoGen[fe2] == 0 {
      if monoWalkFnBody(fnStmts[fe2]) < 0 { return -1 }
    }
    fe2 = fe2 + 1
  }
  // Lambdas the flow table pins come first: the table's classes already span every binding a
  // lambda is written into, so one pass settles a chain of them (D3851).
  let pe = 0
  while pe < nDecl {
    if monoGen[pe] == 1 && criFnIsAnonLambda(pe) && !monoInstantiatedAny(pe) {
      if monoPinLamFromFlow(pe) < 0 { return -1 }
    }
    pe = pe + 1
  }
  // The lambda half of that loop. `monoGen == 1` covers two carriers alike only on paper: a
  // named generic is reached only through `monoInstantiate`, while a lifted anonymous lambda
  // is instantiated only when a call goes through its own binding. Walked here, after the
  // two loops, because instantiation is settled only once every call site has been seen.
  let fe3 = 0
  while fe3 < nDecl {
    if monoGen[fe3] == 1 && criFnIsAnonLambda(fe3) {
      if !monoInstantiatedAny(fe3) {
        if monoPinLamFromCheckedTy(fe3) < 0 { return -1 }
        // `monoInstanceFor` declines silently on a boundary it cannot reproduce, so the
        // walk is gated on the outcome rather than on having tried — a declined pin
        // still needs its body walked.
        if !monoInstantiatedAny(fe3) {
          if monoWalkFnBody(fnStmts[fe3]) < 0 { return -1 }
        }
      }
    }
    fe3 = fe3 + 1
  }
  monoReachLitTys()
  // Settled before the prune, as the walk left it, and again after, in case the prune minted.
  monoRetSettle()
  const prc = monoPruneTemplates(nDecl)
  if prc < 0 { return prc }
  monoRetSettle()
  prc
}

// `monomorphize`'s last stage, over the first `nDecl` slots: retypes the cells an instantiated
// hole lambda seeds, then stubs every template no instance replaced and nothing reaches. Refuses
// an exported generic and an unpinned lambda stored as an element; returns 0 or that failure.
function monoPruneTemplates(nDecl: i32) {
  // Prune the un-instantiated `<T>` generics into a concrete no-op stub (same name, no
  // params, void body). The first instance replaces the slot, so a slot still equal to its
  // captured original has no caller; importing a module for some of its generics pulls in
  // all of them, so this is routine.

  // An exported `<T>` is a reject, not a stub: the stub keeps the name, so the export
  // section would publish a `() -> void` ABI. Three gates narrow the hole half — not an
  // anon lambda, not exported, and not used as a value.
  const cndFe: i32[] = []
  const cndNm: string[] = []
  let gc = 0
  while gc < nDecl {
    if fnStmts[gc] == monoOrigNode[gc] {
      const cfn = P.nodes[fnStmts[gc]]
      if cfn is FuncDecl {
        if cfn.fnTyParams.length == 0 && monoGen[gc] == 1 && cfn.fnName != "" {
          if !criFnIsAnonLambda(gc) {
            if !monoNameIsExported(cfn.fnName) {
              cndFe.push(gc)
              cndNm.push(cfn.fnName)
            }
          }
        }
      }
    }
    gc = gc + 1
  }
  const cndVal = monoNamesUsedAsValue(cndNm, false)
  const deadLams = monoUnreadLamSlots(nDecl)
  // A capture cell an instantiated hole lambda seeds takes the instance's function type. One no
  // call or peer pinned, stored as a list element or in such a cell, has no type for the element
  // but the hole's `i32` default, so it is refused rather than stored there (D3851).
  if monoBindingsAtPin(nDecl) < 0 { return -1 }
  let pass = 0
  while pass < 2 {
    let rl = 0
    while rl < nDecl {
      if (
        monoGen[rl] == 1
        && criFnIsAnonLambda(rl)
        && fnStmts[rl] != monoOrigNode[rl]
      ) {
        monoRetypeLamCells(rl, pass == 1)
      }
      rl = rl + 1
    }
    pass = pass + 1
  }
  let sl = 0
  while sl < nDecl {
    if monoGen[sl] == 1 && criFnIsAnonLambda(sl) {
      const unpinned = fnStmts[sl] == monoOrigNode[sl]
        && !monoInstantiatedAny(sl)
      if unpinned && monoLamStoredAsElement(sl) {
        return emitFail(
          "emitProgram: a lambda with an un-annotated parameter is stored in a list, or in a variable a nested function writes, and no call fixes its parameter types — annotate its parameters",
        )
      }
    }
    sl = sl + 1
  }

  const memberProps = monoMemberPropNames()
  let gp = 0
  while gp < nDecl {
    if fnStmts[gp] == monoOrigNode[gp] {
      const gfn = P.nodes[fnStmts[gp]]
      if gfn is FuncDecl {
        let prune = false
        if gfn.fnTyParams.length > 0 {
          // The slot is still the captured template and is the one the export section
          // resolves to, so the stub below would publish its name at `() -> void`.
          // Reject loudly instead, under the public name.
          let isAbiSlot = false
          if monoNameIsExported(gfn.fnName) {
            if monoFirstFnIndexNamed(gfn.fnName) == gp { isAbiSlot = true }
          }
          if isAbiSlot {
            const pubNm = monoExportPublicName(gfn.fnName)
            // The checker's wording (D3817), for an export it cannot see: a re-export, or one
            // only a shadowing name calls.
            let tp = "T"
            if gfn.fnTyParams.length > 0 { tp = gfn.fnTyParams[0] }
            return emitFail(
              "emitProgram: exported function `"
                + pubNm
                + "` is generic over `"
                + tp
                + "` and nothing in the program calls it; the host calls it, so its signature must be explicit. Give its parameters concrete types, or export a concrete wrapper",
            )
          }
          prune = true
        } else {
          let ci = 0
          while ci < cndFe.length {
            if cndFe[ci] == gp && cndVal[ci] == 0 { prune = true }
            // Every value of a hole function no call instances is one nothing calls, so the
            // stub serves it as it does an uncalled `<T>` generic's (D6830).
            if cndFe[ci] == gp && cndVal[ci] == 2 && !monoInstantiatedAny(gp) {
              prune = true
            }
            ci = ci + 1
          }
          // A hole lambda no call pinned and no read reaches has nothing to lower at (D3832).
          if !prune && i32ListHas(deadLams, gp) { prune = true }
          // A nested function nothing names never runs, and its calls through a binding may
          // take a signature the live ones do not (D3864).
          if !prune && monoNestedFnDead(gp, memberProps) { prune = true }
          // D426 — the lambda template, the `<T>` arm above one frame down. Each
          // instance mints its own copy with the pin substituted. Gate (1) is inverted
          // here, the property being decided by the annotation rather than by the slot.
          if !prune {
            if criFnIsAnonLambda(gp) && monoLamSlotIsHoleTemplate(gp) {
              const hnd = fnStmts[gp]
              if (
                i32ListHas(monoLamPinned, hnd)
                && !i32ListHas(monoLamShared, hnd)
              ) {
                prune = true
              }
            }
          }
          if !prune {
            if criFnIsAnonLambda(gp) && monoLamSlotIsTyParamTemplate(gp) {
              // Two ledgers, both load-bearing: stub the template only when a clone
              // actually replaced it, or when no enclosing frame is instantiated. A
              // declined template is one an instance body still calls by name.
              const lnd = fnStmts[gp]
              if !i32ListHas(monoLamShared, lnd) {
                if i32ListHas(monoLamPinned, lnd) { prune = true }
                else if !monoLamFrameInstantiated(gp) { prune = true }
              }
            }
          }
        }
        if prune {
          const noTP: string[] = []
          const noPs: i32[] = []
          buildFnMapNoteFnSlotWrite()
          monoStubSlots.push(gp)
          fnStmts[gp] = mkFunc(
            gfn.fnName,
            noTP,
            noPs,
            -1,
            mkBlock([], gfn.pos),
            gfn.pos,
          )
          monoArenaTouch()
        }
      }
    }
    gp = gp + 1
  }
  monoInertArgsStubbed()
}

// Whether the nested function or `const`-bound lambda in slot `gp` is never called: it, or a
// function between it and its module-scope function, is not named in its parent's body, and no
// member call anywhere spells that name, which a `self`-function call would. A module-scope
// function's own deadness is not asked: a specialised copy shares its nested slots.
function monoNestedFnDead(gp: i32, memberProps: {[string]: i32}): boolean {
  let slot = gp
  let guard = 0
  while slot >= 0 && slot < fnParent.length && guard <= fnStmts.length {
    const ps = fnParent[slot]
    if ps < 0 || ps >= fnStmts.length { return false }
    const fx = fnStmts[slot]
    const pb = monoNestedBodyOf(fnStmts[ps])
    if pb < 0 { return false }
    let nm = ""
    const f = P.nodes[fx]
    if f is FuncDecl { nm = f.fnName }
    if criFnIsAnonLambda(slot) { nm = monoConstNameOfInit(pb, fx) }
    else if (memberProps[nm] ?? 0) == 1 { return false }
    if nm == "" { return false }
    if !monoSubtreeNamesIdent(pb, nm, 0) { return true }
    slot = ps
    guard = guard + 1
  }
  false
}

// The property names member accesses spell anywhere in the program; one walk.
function monoMemberPropNames(): {[string]: i32} {
  const out: {[string]: i32} = Map()
  const stack: i32[] = []
  for st in monoProgStmts { stack.push(st) }
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      const pn = monoMemberPropOf(ix)
      // arena-tick exempt: `out` is this function's own result table, not the arena.
      if pn != "" { out[pn] = 1 }
      for k in nodeChildren(ix) { stack.push(k) }
    }
  }
  out
}

// The property member access `ix` spells, or "" for any other node.
function monoMemberPropOf(ix: i32): string {
  const n = P.nodes[ix]
  if n is Member { return n.memProp }
  monoOptMemberPropOf(ix)
}

// The property optional member access `ix` spells, or "" for any other node.
function monoOptMemberPropOf(ix: i32): string {
  const n = P.nodes[ix]
  if n is OptMember { return n.omProp }
  ""
}

// Whether the lambda in slot `fe`, bound by an un-annotated `const`, is named as an element of
// a list or capture cell in its enclosing frame, and every such list is bound to a name that is
// unread (`monoFrameNameUnread`): no call can go through it.
function monoLamStoredAsElement(fe: i32): boolean {
  let pf = -1
  if fe < fnParent.length { pf = fnParent[fe] }
  const stack: i32[] = []
  let frame = -1
  if pf >= 0 && pf < fnStmts.length { frame = fnStmts[pf] }
  if pf >= 0 && pf < fnStmts.length {
    const b = monoNestedBodyOf(fnStmts[pf])
    if b < 0 { return false }
    stack.push(b)
  } else {
    for st in monoProgStmts { stack.push(st) }
  }
  const node = fnStmts[fe]
  let name = ""
  const lits: i32[] = []
  const lets: i32[] = []
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      const nd = P.nodes[ix]
      const bn = monoConstInitName(ix, node)
      if bn != "" { name = bn }
      if nd is ArrayLit { lits.push(ix) }
      else if nd is LetDecl { lets.push(ix) }
      const body = monoNestedBodyOf(ix)
      if body >= 0 { stack.push(body) }
      for k in nodeChildren(ix) { stack.push(k) }
    }
  }
  if name == "" { return false }
  let stored = false
  for lx in lits {
    let holds = false
    for el in monoArrayElems(lx) {
      // By name, or through a binding that holds it (D3864).
      if monoIdentNameOf(el) == name || monoLamValueFe(el, frame) == fe {
        holds = true
      }
    }
    if holds {
      stored = true
      let owner = ""
      for ld in lets {
        const d = P.nodes[ld]
        if d is LetDecl {
          if d.letInit == lx { owner = d.letName }
        }
      }
      if owner == "" || !monoFrameNameUnread(fe, owner, false) { return false }
    }
  }
  stored
}

// Retypes each capture cell in the instantiated lambda `fe`'s frame that still carries a
// hole-typed function, at that instance's type where it binds every hole: the cells `fe` seeds
// by name, or with `anyElem` any such cell, one seeded through another binding (D3851).
function monoRetypeLamCells(fe: i32, anyElem: boolean) {
  let pf = -1
  if fe < fnParent.length { pf = fnParent[fe] }
  const stack: i32[] = []
  if pf >= 0 && pf < fnStmts.length {
    const b = monoNestedBodyOf(fnStmts[pf])
    if b < 0 { return 0 }
    stack.push(b)
  } else {
    for st in monoProgStmts { stack.push(st) }
  }
  let node = fnStmts[fe]
  if fe < monoOrigNode.length { node = monoOrigNode[fe] }
  let name = ""
  const lets: i32[] = []
  const reads: i32[] = []
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      const bn = monoConstInitName(ix, node)
      if bn != "" { name = bn }
      if P.nodes[ix] is LetDecl { lets.push(ix) }
      if monoCellReadName(ix) != "" { reads.push(ix) }
      const body = monoNestedBodyOf(ix)
      if body >= 0 { stack.push(body) }
      for k in nodeChildren(ix) { stack.push(k) }
    }
  }
  if name == "" { return 0 }
  for lx in lets {
    const ld = P.nodes[lx]
    if ld is LetDecl {
      const ce = monoGeneratedCellElem(ld.letInit)
      let et = -1
      if ce >= 0 { et = monoCellElemTyOf(ld.letInit, ce) }
      if et >= 0 && (anyElem || monoIdentNameOf(ce) == name) && tyHasTyVar(et) {
        const it = monoPinSubTyOf(et, fnStmts[fe])
        if (
          it >= 0
          && it < T.tys.length
          && !tyHasTyVar(it)
          && T.tys[it] is TyFunc
        ) {
          monoRetypeCell(lx, ce, it, reads)
        }
      } else if anyElem && ce >= 0 && (et < 0 || nodeTyIxOf(ld.letInit) < 0) {
        // A cell seeded from another cell's read and recorded with no type takes that cell's.
        let st = et
        if !monoTyConcreteFn(st) { st = monoCellTyNamed(lets, ce) }
        if st >= 0 { monoRetypeCell(lx, ce, st, reads) }
      }
    }
  }
  0
}

// The reads `d[0]` of the capture cell declared at `cd` in frame `fx` (-1 for module scope),
// nested bodies included.
function monoCellReadsIn(fx: i32, cd: i32): i32[] {
  const out: i32[] = []
  const stack: i32[] = []
  if fx >= 0 {
    const b = monoNestedBodyOf(fx)
    if b < 0 { return out }
    stack.push(b)
  } else {
    for st in monoProgStmts { stack.push(st) }
  }
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      if monoReadsCell(ix, cd) { out.push(ix) }
      const body = monoNestedBodyOf(ix)
      if body >= 0 { stack.push(body) }
      for k in nodeChildren(ix) { stack.push(k) }
    }
  }
  out
}

// Records function type `ft` on the capture cell declared at `cd`, its element `elem`, and each
// read of it among `reads` that has no concrete type of its own.
function monoRetypeCell(cd: i32, elem: i32, ft: i32, reads: i32[]) {
  const d = P.nodes[cd]
  if !(d is LetDecl) { return 0 }
  nodeTyRecord(elem, ft)
  nodeTyRecord(d.letInit, mkArrayTy(ft))
  for r in reads {
    if monoReadsCell(r, cd) {
      const rt = nodeTyIxOf(r)
      if rt < 0 || tyHasTyVar(rt) { nodeTyRecord(r, ft) }
    }
  }
  0
}

// The concrete function type the capture cell declared among `lets` that `at` reads (`d[0]`)
// holds, or -1.
function monoCellTyNamed(lets: i32[], at: i32): i32 {
  if monoCellReadName(at) == "" { return -1 }
  for lx in lets {
    const ld = P.nodes[lx]
    if ld is LetDecl {
      const ce = monoGeneratedCellElem(ld.letInit)
      if ce >= 0 && monoReadsCell(at, lx) {
        const t = monoCellElemTyOf(ld.letInit, ce)
        if monoTyConcreteFn(t) { return t }
      }
    }
  }
  -1
}

// Whether `t` is a function type with no type variable left in it.
function monoTyConcreteFn(t: i32): boolean {
  t >= 0 && t < T.tys.length && !tyHasTyVar(t) && T.tys[t] is TyFunc
}

// The element type of capture cell `cell` (a one-element list literal holding `elem`): the
// list's recorded element type, else the element's own.
function monoCellElemTyOf(cell: i32, elem: i32): i32 {
  const ct = nodeTyIxOf(cell)
  if ct >= 0 && ct < T.tys.length {
    const t = T.tys[ct]
    if t is TyArray { return t.aElem }
  }
  nodeTyIxOf(elem)
}

// The elements of list literal node `ix`, or none for any other node.
function monoArrayElems(ix: i32): i32[] {
  if ix < 0 || ix >= P.nodes.length {
    const none: i32[] = []
    return none
  }
  const nd = P.nodes[ix]
  if nd is ArrayLit { return nd.arrElems }
  const none: i32[] = []
  none
}

// The lifted slots below `nDecl` holding an un-instantiated hole lambda that is the initializer
// of an un-annotated `const` no name in its frame reads. Its parameter has no type but the `i32`
// default, at which its body need not validate; nothing calls or passes it, so it is stubbed.
// The frame is searched by name, nested functions included, so a shadowing read keeps it.
function monoUnreadLamSlots(nDecl: i32): i32[] {
  const out: i32[] = []
  let fe = 0
  while fe < nDecl {
    if (
      monoGen[fe] == 1
      && criFnIsAnonLambda(fe)
      && fnStmts[fe] == monoOrigNode[fe]
    ) {
      if !monoInstantiatedAny(fe) && monoLamUnread(fe) { out.push(fe) }
    }
    fe = fe + 1
  }
  out
}

// Whether the lambda in slot `fe` initializes an un-annotated `const` that nothing in its
// enclosing frame (the program, at top level) reads by name.
function monoLamUnread(fe: i32): boolean { monoFrameNameUnread(fe, "", false) }

// Whether nothing in the enclosing frame of the lambda in slot `fe` reads `target`, or the
// lambda's own `const` binding for "", but to seed or write bindings that are unread in turn.
// With `calls`, whether no call goes through it or a binding it seeds or writes.
function monoFrameNameUnread(fe: i32, target: string, calls: boolean): boolean {
  const roots: i32[] = []
  let pf = -1
  if fe < fnParent.length { pf = fnParent[fe] }
  if pf >= 0 && pf < fnStmts.length {
    const f = P.nodes[fnStmts[pf]]
    if f is FuncDecl { roots.push(f.fnBody) } else { return false }
  } else {
    for st in monoProgStmts { roots.push(st) }
  }
  // The template's node, which the binding's initializer names once an instance takes the slot.
  let node = fnStmts[fe]
  if fe < monoOrigNode.length { node = monoOrigNode[fe] }
  let name = ""
  // Each walked node carries the names a nearer scope rebinds there, as `|a|b|`.
  const stack: i32[] = []
  const stackSh: string[] = []
  for r in roots {
    stack.push(r)
    stackSh.push("|")
  }
  const seen: i32[] = []
  const seenSh: string[] = []
  let top = -1
  if pf >= 0 && pf < fnStmts.length { top = fnStmts[pf] }
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    const sh = stackSh.pop() ?? "|"
    if ix >= 0 && ix < P.nodes.length {
      // Asking about calls, a function nothing names never makes one.
      const dead = calls
        && P.nodes[ix] is FuncDecl
        && monoWriteFrameDead(ix, top)
      if !dead {
        seen.push(ix)
        seenSh.push(sh)
        const bn = monoConstInitName(ix, node)
        if bn != "" { name = bn }
        monoScopedKids(ix, sh, i32ListHas(roots, ix), stack, stackSh)
      }
    }
  }
  if name == "" { return false }
  // A read that only initializes another un-annotated binding nothing reads does not keep the
  // lambda: `const d1 = c` with `d1` unread leaves `c` as uncalled as before (D3850).
  const aliasInit: i32[] = []
  // A write's target is no read of it, and its value is read only as far as the target is.
  const lhs: i32[] = []
  const writeVal: i32[] = []
  const writeTo: string[] = []
  const callees: i32[] = []
  for ix in seen {
    const ai = monoAliasInitOf(ix)
    if ai >= 0 { aliasInit.push(ai) }
    const nd = P.nodes[ix]
    if i32ListHas(monoDeliveredArgs, ix) { callees.push(ix) }
    if nd is Call {
      // A call through `v`, `v[i]` or a cell's `v[0]` goes through `v`.
      const cf = P.nodes[nd.callFn]
      if cf is Index {
        callees.push(cf.idxArr)
      } else {
        callees.push(nd.callFn)
      }
    } else if nd is BinExpr {
      if nd.binOp == "=" {
        let tname = monoIdentNameOf(nd.binLeft)
        let tnode = nd.binLeft
        if tname == "" {
          tname = monoCellReadName(nd.binLeft)
          const li = P.nodes[nd.binLeft]
          if li is Index { tnode = li.idxArr }
        }
        if tname != "" {
          lhs.push(tnode)
          let wv = monoReadNameNode(nd.binRight)
          if wv < 0 { wv = nd.binRight }
          writeVal.push(wv)
          writeTo.push(tname)
        }
      }
    }
  }
  const visiting: string[] = []
  if target != "" { name = target }
  // A read of a frame-level binding that a nearer binding shadows reads that one (D3843).
  const rootNames: string[] = []
  for r in roots { monoRootDeclNames(r, rootNames) }
  const reads: i32[] = []
  let i = 0
  while i < seen.length {
    const nm = monoIdentNameOf(seen[i])
    if (
      nm == ""
      || !strListHas(rootNames, nm)
      || !strContains(seenSh[i], "|" + nm + "|")
    ) {
      reads.push(seen[i])
    }
    i = i + 1
  }
  if calls {
    return !monoNameCalled(
      name,
      reads,
      aliasInit,
      lhs,
      writeVal,
      writeTo,
      callees,
      visiting,
    )
  }
  monoNameUnread(name, reads, aliasInit, lhs, writeVal, writeTo, visiting)
}

// Pushes the children of node `ix`, walked under shadow list `sh`, each with the list it is
// walked under: a function adds its name and parameters, a loop its variables, and a block
// below the frame's root each name its statements declare, from that statement on.
function monoScopedKids(
  ix: i32,
  sh: string,
  root: boolean,
  stack: i32[],
  stackSh: string[],
) {
  const n = P.nodes[ix]
  let inner = sh
  if n is FuncDecl {
    inner = monoShAdd(inner, n.fnName)
    for q in n.fnParams {
      const qp = P.nodes[q]
      if qp is Param { inner = monoShAdd(inner, qp.parName) }
    }
    stack.push(n.fnBody)
    stackSh.push(inner)
  } else if n is ForIn {
    stack.push(n.fiIter)
    stackSh.push(sh)
    stack.push(n.fiBody)
    stackSh.push(monoShAdd(monoShAdd(sh, n.fiVar), n.fiVar2))
    return 0
  } else if n is ForRange {
    inner = monoShAdd(sh, n.frVar)
  } else if n is Block {
    if !root {
      let run = sh
      for st in n.blkStmts {
        stack.push(st)
        stackSh.push(run)
        run = monoShAdd(run, monoStmtDeclName(st))
      }
      return 0
    }
  }
  for k in nodeChildren(ix) {
    stack.push(k)
    stackSh.push(inner)
  }
  0
}

// Appends the names root `r` of a frame declares: a statement's own, or each statement's of a
// function body's block.
function monoRootDeclNames(r: i32, out: string[]) {
  const n = P.nodes[r]
  if n is Block {
    for st in n.blkStmts { out.push(monoStmtDeclName(st)) }
    return 0
  }
  out.push(monoStmtDeclName(r))
  0
}

// Shadow list `sh` with `nm` added; "" adds nothing.
function monoShAdd(sh: string, nm: string): string {
  if nm == "" { return sh }
  sh + nm + "|"
}

// The name statement `st` declares in its block: a `let`'s, else a function's, else "".
function monoStmtDeclName(st: i32): string {
  if st < 0 || st >= P.nodes.length { return "" }
  const d = P.nodes[st]
  if d is LetDecl { return d.letName }
  monoFnDeclName(st)
}

// The name of function declaration `st`, or "" for any other statement.
function monoFnDeclName(st: i32): string {
  const d = P.nodes[st]
  if d is FuncDecl { return d.fnName }
  ""
}

// Whether a call among `seen` goes through `name`, or through a binding a read of `name` seeds
// or is written into. `visiting` is the path walked; past 64 links it answers "called".
function monoNameCalled(
  name: string,
  seen: i32[],
  aliasInit: i32[],
  lhs: i32[],
  writeVal: i32[],
  writeTo: string[],
  callees: i32[],
  visiting: string[],
): boolean {
  if strListHas(visiting, name) { return false }
  if visiting.length > 64 { return true }
  visiting.push(name)
  for ix in seen {
    if monoIdentNameOf(ix) == name && !i32ListHas(lhs, ix) {
      if i32ListHas(callees, ix) { return true }
      let owner = ""
      if i32ListHas(aliasInit, ix) {
        owner = monoAliasOwnerName(ix, seen)
      } else {
        let w = 0
        while w < writeVal.length {
          if writeVal[w] == ix { owner = writeTo[w] }
          w = w + 1
        }
      }
      if owner != "" {
        if (
          monoNameCalled(
            owner,
            seen,
            aliasInit,
            lhs,
            writeVal,
            writeTo,
            callees,
            visiting,
          )
        ) {
          return true
        }
      }
    }
  }
  visiting.pop()
  false
}

// The name node the initializer of the un-annotated binding node `ix` reads when it is a bare
// name or a cell read, or -1.
function monoAliasInitOf(ix: i32): i32 {
  const nd = P.nodes[ix]
  if nd is LetDecl {
    if nd.letType < 0 && nd.letInit >= 0 {
      // The rewrite's capture cell `[v]` holds `v` (D3851).
      let init = nd.letInit
      const ce = monoGeneratedCellElem(init)
      if ce >= 0 { init = ce }
      return monoReadNameNode(init)
    }
  }
  -1
}

// The name node a read `v` or a cell read `v[0]` at `ix` reads, or -1 for any other node.
function monoReadNameNode(ix: i32): i32 {
  if monoIdentNameOf(ix) != "" { return ix }
  if ix < 0 || ix >= P.nodes.length || monoCellReadName(ix) == "" { return -1 }
  const n = P.nodes[ix]
  if n is Index { return n.idxArr }
  -1
}

// Whether nothing among `seen` reads `name` except as the initializer of a binding that is
// itself unread by the same test. `visiting` is the path walked; past 64 links it answers "read".
function monoNameUnread(
  name: string,
  seen: i32[],
  aliasInit: i32[],
  lhs: i32[],
  writeVal: i32[],
  writeTo: string[],
  visiting: string[],
): boolean {
  // A binding read only along a cycle back to itself is read by nothing outside it.
  if strListHas(visiting, name) { return true }
  if visiting.length > 64 { return false }
  visiting.push(name)
  for ix in seen {
    if monoIdentNameOf(ix) == name && !i32ListHas(lhs, ix) {
      let owner = ""
      if i32ListHas(aliasInit, ix) {
        owner = monoAliasOwnerName(ix, seen)
      } else {
        let w = 0
        while w < writeVal.length {
          if writeVal[w] == ix { owner = writeTo[w] }
          w = w + 1
        }
      }
      if owner == "" { return false }
      if (
        !monoNameUnread(owner, seen, aliasInit, lhs, writeVal, writeTo, visiting)
      ) {
        return false
      }
    }
  }
  // Off the path again: a second read reaching the same binding is no cycle.
  visiting.pop()
  true
}

// The name of the binding among `seen` whose initializer is node `init`, or "".
function monoAliasOwnerName(init: i32, seen: i32[]): string {
  for ix in seen {
    const nd = P.nodes[ix]
    if nd is LetDecl {
      let li = nd.letInit
      const ce = monoGeneratedCellElem(li)
      if ce >= 0 { li = ce }
      if li >= 0 && (li == init || monoReadNameNode(li) == init) {
        return nd.letName
      }
    }
  }
  ""
}

// The name of the un-annotated `const` node `ix` declares with initializer `init`, or "".
function monoConstInitName(ix: i32, init: i32): string {
  const nd = P.nodes[ix]
  if nd is LetDecl {
    if nd.letInit == init && nd.letKw == "const" && nd.letType < 0 {
      return nd.letName
    }
  }
  ""
}

// The body of function node `ix`, which `nodeChildren` does not enter; -1 for any other node.
function monoNestedBodyOf(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const nd = P.nodes[ix]
  if nd is FuncDecl { return nd.fnBody }
  -1
}

// The name identifier node `ix` reads, or "" for any other node.
function monoIdentNameOf(ix: i32): string {
  if ix < 0 || ix >= P.nodes.length { return "" }
  const nd = P.nodes[ix]
  if nd is Ident { return nd.identName }
  ""
}

// Does the annotation node `ix` mention any of `typarams`? The parser's spelling tree
// answers where it survives, and the string form where it does not. `tsMentionsAnyName`
// visits every kid of every node, so it cannot have a missing arm; `monoAnnHasTyParam`
// re-parses the render and needs one arm per shape, a missing one being silent.

// The name form stays for nodes with no tree: `annTsOf` answers -1 once
// `canonEmitTypeNames` rewrites a name in place, and answering false there would skip the
// substitution and let the type parameter survive into the instance.
function monoAnnMentionsTyParam(ix: i32, ann: string, typarams: string[]) {
  const root = annTsOf(ix)
  if root >= 0 { return tsMentionsAnyName(root, typarams) }
  monoAnnHasTyParam(ann, typarams)
}

// The spelling of a list type whose innermost element is a record, by that record's row name
// (`Circle[]`, `Circle[][]`), or "" when the leaf has no row: `monoRetRowName` decides the leaf.
function monoRetListRowName(ty: i32): string {
  let t = ty
  let suffix = ""
  let peeling = true
  while peeling && t >= 0 && t < T.tys.length && suffix.length < 128 {
    const tt = T.tys[t]
    if tt is TyArray {
      suffix = suffix + "[]"
      t = tt.aElem
    } else {
      peeling = false
    }
  }
  if suffix == "" || t < 0 || t >= T.tys.length { return "" }
  const rn = monoRetRowName(t)
  if rn == "" { return "" }
  rn + suffix
}
