} from "./ast"
import { PIN_SIGKEY } from "./ast"
// Monomorphization rewrites a call's callee name on a node the arena already holds;
// `compiler/symbols.vl` is the discipline that in-place write follows.
import { sidNoteNodeName, sidOfNode } from "./symbols"
import {
  annArrowAt,
  annFnDecompose,
  annObjFieldSplit,
  annRetNameOf,
