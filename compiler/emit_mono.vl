  fnTagSetOfTy,
  fnTagSetTy,
  fnTagTyIsTagged,
} from "./check_elab_cap"

// D943 — the lifted slots `monoPinBodyLambdas` minted for the instance being built. A
// clone's `fnParent` cannot be set at clone time (its own `FuncDecl` does not exist
// yet), so it would inherit the template's parent and give every instance one env
// layout. Recorded here and re-pointed the moment the instance is lifted.
let monoLamMintedSlots: i32[] = []
// Every lifted slot a lambda clone took for the instance being built, nested clones included.
// Never retired, since the instance walks each clone's body once it is registered (D2553).
let monoLamCloneSlots: i32[] = []

// `monoProgStmts` indexed by the interned name of each module-scope `LetDecl`, first
// occurrence winning — `monoModuleLetOf`'s answer whenever the name is one of them. A miss
// stays -1, the fall-through to `moduleLocalLetOfUnique`. Rebuilt at the one write to
// `monoProgStmts`, so it carries no row from an earlier compile.
let monoProgLetBySid: i32[] = []

// The arena's size, a memo key for the walks below that cache a whole-arena answer.
function monoArenaStamp() { P.nodes.length + fnStmts.length + fnParent.length }

// D1046 — is this the first instance of the generic being built? Read by the nested
// named-function arm alone: at `count == 0` the instance reuses the template's own
// slot, so template and clone would be two children of one frame under one name and
// the call would answer the unsubstituted template.
let monoInstIsFirst = false

// The lifted slot a named nested template is replaced in, keyed by the template's own
// node: the first instance overwrites `fnStmts[slot]`, which breaks the "scan `fnStmts`
// for this node" lookup, and a -1 there shares one env struct across two pins. Reset per
// program, since a node index names a different function in the next one (D1820).
let monoNamedTmplNode: i32[] = []
let monoNamedTmplSlot: i32[] = []

// The lifted slot holding node `fnIx`: the plain scan, plus the replacement table for a
// named template whose slot now holds its first instance, and a hole template's slot its
// first instance took over (D15032). One home, because two call sites ask the same question.
function monoSlotOfLamNode(fnIx: i32) {
  let fe = 0 - 1
  let k = 0
  while k < fnStmts.length {
    if fnStmts[k] == fnIx { fe = k }
    k = k + 1
  }
  if fe >= 0 { return fe }
  let r = 0
  while r < monoNamedTmplNode.length {
    if monoNamedTmplNode[r] == fnIx { return monoNamedTmplSlot[r] }
    r = r + 1
  }
  let o = 0
  while o < monoOrigNode.length && o < fnStmts.length {
    if monoOrigNode[o] == fnIx { return o }
    o = o + 1
  }
  -1
}

// Is `nm` a source function name rather than the emitter's synthesized lambda name?
// `collectFns` rewrites an anonymous lambda's empty name to `__lambda_N` before this
// pass, so `fnName != ""` is true of every lifted lambda and is not the test. Same rule
// as `criFnIsAnonLambda`, asked of a name rather than of a slot.
function monoFnNameIsSourceNamed(nm: string) {
  if nm == "" { return false }
  if nm.length >= 8 && nm.slice(0, 8) == "__lambda" { return false }
  true
}

// The function-type name of argument `argIx`, preferring the checker's recorded type:
// for an un-annotated lambda argument it inferred the param types from the generic
// param's substituted expected type, which the syntactic build below cannot recover.
// The gate is the arena (`nodeTyIsFunc`); a closed type is spelled by the naming rule.
function monoArgFnTypeName(argIx: i32, fnIx: i32) {
  const ax = unwrapParen(argIx)
  if ax < 0 { return "" }
  const an = nodeAt(ax)

  if nodeTyIsFunc(ax) {
    const cn = nodeTyName(ax)
    if cn != "" { return monoPinSpellShaped(nodeTyIxOf(ax)) }
    // A type riding the instance's parameters names nothing until substituted (D4647).
    const pt = monoNodeTyAt(ax, fnIx)
    if pt >= 0 && !tyHasTyVar(pt) { return monoPinSpellShaped(pt) }
  }
  // A hole parameter handed on reads the function type its instance pinned it at (D10132).
  if an is Ident && tyHasTyVar(nodeTyIxOf(ax)) {
    const ht = monoNodeTyAt(ax, fnIx)
    if monoTyClosedFn(ht) { return monoPinSpellShaped(ht) }
  }
  let fe = -1
  if an is FuncDecl { fe = fnStmtsPosOf(ax) }
  else if an is Ident { fe = fnIndexOfAt(sidOfNode(ax), fnIx, ax) }
  if fe < 0 || fe >= fnStmts.length { return "" }
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    let nm = "("
    let i = 0
    while i < fn.fnParams.length {
      const p = nodeAt(fn.fnParams[i])
      if p is Param {
        if p.parType < 0 { return "" }
        const pn = tyNameOf(p.parType)
        if pn == "" { return "" }
        if i > 0 { nm = nm + "," }
        nm = nm + pn
      }
      i = i + 1
    }
    // Only a declared result names the instance's; an inferred kind is the template's.
    if fn.fnRet < 0 { return "" }
    let rn = tyNameOf(fn.fnRet)
    if rn == "" { return "" }
    // A declared `never` result lowers as `void` (D1972).
    if rn == "never" { rn = "void" }
    return nm + ")=>" + rn
  }
  ""
}

// The union of list types `ty` spelled member by member, a list of records by its row's name;
// "" when a member has no name.
function monoListUnionRowName(ty: i32): string {
  const t = tyAt(ty)
  if t is TyUnion {
    let nm = ""
    let i = 0
    while i < t.uMembers.length {
      const m = t.uMembers[i]
      let mn = monoRetListRowName(m)
      // A literal's `#anon` row names no type, so the member keeps its shape (D5083).
      if mn == "" || strContains(mn, "#anon") { mn = monoPinSpellShaped(m) }
      if mn == "" { return "" }
      if i > 0 { nm = nm + "|" }
      nm = nm + mn
      i = i + 1
    }
    return nm
  }
  ""
}

// Is the read `readIx` still of the module's binding inside `fnIx` (-1 = module scope)? False
// when that body's `let` is the read's declaration or the read is of one of its parameters —
// the shadow test, which is not the same question as `fnIx >= 0` (D703).
function monoModuleNameVisible(readIx: i32, fnIx: i32) {
  if fnIx < 0 { return true }
  if paramTypeNodeOfRead(fnIx, readIx) >= 0 { return false }
  const shf = nodeAt(fnIx)
  if shf is FuncDecl { return fnLetOfRead(fnIx, readIx) < 0 }
  false
}

// The module-scope `LetDecl` the read `readIx` names as seen from `fnIx`, or -1, through
// `monoProgLetBySid`. Module scope has two storage classes: a top-level block's binding is
// a start-function local, absent from `monoProgStmts`, so `moduleLocalLetOfUnique` is the
// other table (D1596).
function monoModuleLetOf(readIx: i32, fnIx: i32) {
  if !monoModuleNameVisible(readIx, fnIx) { return -1 }
  const name = sidText(sidOfNode(readIx))
  const hit = sidArrGet(monoProgLetBySid, sidLookup(name))
  if hit >= 0 { return hit }
  moduleLocalLetOfUnique(emitRootIx, name)
}

// Whether arena type `ty` is a list itself (`TyArray`), not a union of lists; false for -1.
function monoTyIsList(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  tyAt(ty) is TyArray
}

// The one home for "which annotation can serve as a monomorphization pin": `name`, the caller's
// spelling of the pin, echoed back when its type `ty` has one, else "" (the rep cascade then
// answers). Mid-mono the `expr*` cascade cannot classify a binding (`buildLocals` is post-mono),
// so the type is the only truth. A name with no type, or an empty one, is no pin.
function monoAnnPinName(name: string, ty: i32) {
  if name == "" || !monoAnnPinOkTy(ty) { return "" }
  name
}

// Whether type `ty` has a pin: a union or a list of one the registry keys, a record with a row
// (declared, variant or inline), a list of records, scalars or composites, a bare map, a scalar
// with a value rep, or a nullable of any of these. `void`, `null`, `never`, a bare `u8`, a
// function and a type variable have none.
function monoAnnPinOkTy(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  if unionRowKeyAB(79, ty) >= 0 { return true }
  const t = tyAt(ty)
  match t {
    TyObj => {
      return monoRecordPinOk(ty)
    }
    TyNullable => {
      return monoAnnPinOkTy(t.nInner)
    }
    TyPrim => {
      return monoPrimHasRep(t.primName) || t.primName == "v128"
    }
    // A map, an alias of one, or a union of twin maps: the bare map's whole spelling.
    TyMap | TyUnion => {
      return tyIsBareMap(ty)
    }
    TyArray => {
      return monoListPinOk(t.aElem)
    }
    // A function, a lone literal, an open or error type.
    TyFunc | TyLit | TyVar | TyErr | TyNeg => {
      return false
    }
  }
}

// Whether a list over element type `e` has a pin: a list of a keyed union, of records with a row,
// of lists or of a type its spelling groups in parentheses, or of a scalar with a value rep.
// `boolean[]` shares the i32 list rep, so only its pin carries its boolean-ness; `u8[]` is bytes.
function monoListPinOk(e: i32): boolean {
  if e < 0 || e >= T.tys.length { return false }
  if unionRowKeyAB(80, e) >= 0 { return true }
  const et = tyAt(e)
  match et {
    TyObj => {
      return monoRecordPinOk(e)
    }
    TyArray | TyUnion | TyNullable | TyFunc => {
      return true
    }
    TyPrim => {
      return monoPrimHasRep(et.primName) || et.primName == "u8"
    }
    // A map, a lone literal, an open or error element: no list pin.
    TyMap | TyLit | TyVar | TyErr | TyNeg => {
      return false
    }
  }
}

// Whether scalar `pn` has a value rep a pin can name: `i32`, `i64`, `f32`, `f64`, `boolean` or
// `string`.
function monoPrimHasRep(pn: string): boolean {
  pn == "i32"
    || pn == "i64"
    || pn == "f32"
    || pn == "f64"
    || pn == "boolean"
    || pn == "string"
}

// Whether record `ty` has a row to pin at: an inline record always (it is spelled by its shape),
// a declared one when a struct row or a union arm's variant row holds it (D23, D53).
function monoRecordPinOk(ty: i32): boolean {
  const nom = nominalStructNameOfTy(ty)
  if nom == "" || structRowOfRecordTy(ty) >= 0 { return true }
  let v = 0
  while v < uVarTyIx.length {
    const vt = uVarTyIx[v]
    if vt >= 0 && tySame(vt, ty) && nominalStructNameOfTy(vt) == nom {
      return true
    }
    v = v + 1
  }
  false
}

// The closed function type an instance's read `ax` takes there, where its own recorded type is not
// a function (a forwarder's `x: T` holding a function value): the elaboration's type for it at
// that instance; -1 otherwise.
function monoCloPinTyOf(ax: i32, fnIx: i32): i32 {
  if ax < 0 || !(nodeAt(ax) is Ident) || nodeTyIsFunc(ax) { return -1 }
  const t = elabNodeTyAt(ax, fnIx)
  if t < 0 || t >= T.tys.length || tyHasTyVar(t) { return -1 }
  if tyAt(t) is TyFunc || tyNulFuncInner(t) >= 0 { t } else { -1 }
}

// The type argument `ix` is pinned at in frame `fnIx`: `null` or the row it is built at where the
// pin names a row (`monoArgRowArmTy`), else its type (`elabNodeTyOrChecked`), else its open checked type.
export function monoArgPinTyAt(ix: i32, fnIx: i32): i32 {
  const ax = unwrapParen(ix)
  if ax < 0 || ax >= P.nodes.length { return -1 }
  if monoReadsUnfilledNull(ax) || monoParamPinnedNull(ax, fnIx) {
    return TY_NULL
  }
  const rr = monoArgRowArmTy(ax)
  if rr >= 0 { return rr }
  const t = elabNodeTyOrChecked(ax, fnIx)
  if t >= 0 { t } else { nodeTyIxOf(ax) }
}

// The row a literal or copy argument `ax` is built at where that is not its type: the variant pinned
// for an unadopted literal, the record the record solve built a list or record literal at
// (D15181), or a record copy's; -1.
function monoArgRowArmTy(ax: i32): i32 {
  if ax < 0 || ax >= P.nodes.length { return -1 }
  const ov = litRetArmRow(ax)
  if ov >= 0 && ov < uVarTyIx.length { return uVarTyIx[ov] }
  const n = nodeAt(ax)
  const brt = if n is ArrayLit || n is ObjLit { nodeRepTyIxOf(ax) } else { 0 - 1 }
  if (
    brt >= 0
    && brt < T.tys.length
    && !tySame(brt, nodeTyIxOf(ax))
    && tyHoldsObj(brt, 8)
  ) {
    return brt
  }
  const rr = elabArgBuiltRep(ax, elabWalkTop())
  if rr >= 0 { return rr }
  const cpy = recCopyTyOf(ax)
  if cpy >= 0 && cpy < T.tys.length && monoRecordNominalPin(cpy) != "" {
    cpy
  } else {
    -1
  }
}

// True when type `nTy` is a top-level member of the union or nullable `wTy`: what `wTy` narrows
// to, and not `wTy` itself. Membership is the whole safety property of the narrowed pin. An arm
// matches by shape and declared record name. A side with no type is no member. See DECISIONS.md.
function monoTyNarrowsFrom(nTy: i32, wTy: i32): boolean {
  if nTy < 0 || wTy < 0 { return false }
  const nom = nominalStructNameOfTy(nTy)
  if tySame(nTy, wTy) && nominalStructNameOfTy(wTy) == nom { return false }
  const arms: i32[] = []
  const wt = tyAt(wTy)
  if wt is TyNullable { arms.push(wt.nInner) }
  flattenVariantsInto(wTy, arms)
  // `flattenVariantsInto` gives a nullable two arms at least, so its whole inner is the extra one.
  if arms.length < 2 { return false }
  for a in arms {
    if tySame(a, nTy) && nominalStructNameOfTy(a) == nom { return true }
  }
  false
}

// Whether `narrowTy` is a niche-repped `boolean | null` or `string | null` whose arms
// (`unionTyArms`) are all arms of the wider union `wTy`, and fewer: the argument's read converts
// the box to that niche, so the pin is it (D2590). A side with no type or no arms is not.
function monoNicheNarrowsFrom(narrowTy: i32, wTy: i32): boolean {
  if !monoTyIsNulBoolOrStr(narrowTy) || wTy < 0 { return false }
  const na: string[] = []
  const nts: i32[] = []
  if !unionTyArms(narrowTy, na, nts) { return false }
  const wa: string[] = []
  const wts: i32[] = []
  if !unionTyArms(wTy, wa, wts) || wa.length <= na.length { return false }
  for a in na {
    if !strListHas(wa, a) { return false }
  }
  true
}

// Whether `ty` is a `boolean | null` or a `string | null` nullable.
function monoTyIsNulBoolOrStr(ty: i32): boolean {
  if ty < 0 { return false }
  const t = tyAt(ty)
  if t is TyNullable {
    const p = primNameOf(t.nInner)
    return p == "boolean" || p == "string"
  }
  false
}

// Whether the spelling of type `ty` holds a brace: an inline record or a map anywhere in it,
// through lists, nullables, unions and function signatures. A declared record spells its name, and
// so does a declared union below the top; `top` opens the top-level union's members.
function monoTyMentionsBrace(ty: i32, top: boolean): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  match t {
    TyObj => {
      return nominalStructNameOfTy(ty) == ""
    }
    TyMap => {
      return true
    }
    TyArray => {
      return monoTyMentionsBrace(t.aElem, false)
    }
    TyNullable => {
      return monoTyMentionsBrace(t.nInner, top)
    }
    TyUnion => {
      if !top && unionAliasDeclNameOfTy(ty) != "" { return false }
      for m in t.uMembers {
        if monoTyMentionsBrace(m, false) { return true }
      }
      return false
    }
    TyFunc => {
      for q in t.fnParamTypes {
        if monoTyMentionsBrace(q, false) { return true }
      }
      return monoTyMentionsBrace(t.fnRet, false)
    }
    // A scalar, a literal, an open or error type spells no brace.
    TyPrim | TyLit | TyVar | TyErr | TyNeg => {
      return false
    }
  }
}

// The number of arms union type `ty` has: its keyed arms (`unionTyArms`), else its flattened
// variants; -1 for no type.
function monoTyArmCount(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  const atoms: string[] = []
  const tys: i32[] = []
  if unionTyArms(ty, atoms, tys) { return atoms.length }
  const flat: i32[] = []
  flattenVariantsInto(ty, flat)
  flat.length
}

// The pin a narrowed argument at `ax` wants, given the pin `wide` (type `wTy`, or -1) the
// annotation ladder chose — else "" (the ladder's answer stands). A pin becomes the instance's parameter
// annotation, so it is safe exactly where a non-generic function carrying that annotation
// already lowers the same program. DECISIONS.md has the channel ruling.
function monoNarrowedPinName(ax: i32, fnIx: i32, wide: string, wTy: i32) {
  if wide == "" { return "" }
  let nt = nodeTyIxOf(ax)
  // A generic body records a read narrowed to one list as `T[]`, which the pins name.
  if nt >= 0 && tyHasTyVar(nt) {
    const ps = elabClosedTyAt(ax, fnIx)
    if ps >= 0 { nt = ps }
  }
  // A type whose render softens its literals is not a name this test can compare: it
  // reaches the membership test looking like a match on both sides, and the pin then
  // drops from the interned atom to a string ref. `tyRenderSoftensLits` is the home for
  // that hazard, and a litunion argument's pin is claimed by the litunion rungs anyway.
  if tyRenderSoftensLits(nt) { return monoNarrowedLitPinName(nt, wTy) }
  // A nullable record has two arms, so it is a proper arm subset of `wide` only past two arms;
  // the nominal rung answers it only once its names have matched.
  if (
    nt >= 0
    && tyAt(nt) is TyNullable
    && tyWrapsRecord(nt)
    && !monoTyMentionsBrace(wTy, true)
    && monoTyArmCount(wTy) <= 2
    && !monoNulRecNamesNarrow(nt, wTy)
  ) {
    return monoNarrowedNominalPinName(nt, "", wTy)
  }
  const n = monoPinSpellShaped(nt)
  if monoTyNarrowsFrom(nt, wTy) || monoNicheNarrowsFrom(nt, wTy) {
    if monoAnnPinName(n, nt) == n { return n }
    return ""
  }
  // The NOMINAL spelling of the same arm: a union names its record arms by declaration, so a
  // narrowed object pins at that name, the equality the variant tables are built under (D1754).
  monoNarrowedNominalPinName(nt, n, wTy)
}

// The NOMINAL spelling of the narrowed arm `nt` (render `n`) when it is an arm of `wTy`, else
// the nullable-record rung's answer, else "".
function monoNarrowedNominalPinName(nt: i32, n: string, wTy: i32): string {
  const nom = nominalStructNameOfTy(nt)
  if nom == "" { return monoNarrowedNulRecPinName(nt, n, wTy) }
  if !monoTyNarrowsFrom(nt, wTy) { return "" }
  if monoAnnPinName(nom, nt) != nom { return "" }
  nom
}

// The narrowed pin of a nullable record (`Circle | null` out of `Circle | string | null`): its
// render `n`, when the record and `null` are both arms of `wTy`, which the whole-type
// membership test above cannot see (D3099). "" otherwise.
function monoNarrowedNulRecPinName(nt: i32, n: string, wTy: i32): string {
  if !monoNulRecNamesNarrow(nt, wTy) { return "" }
  if monoAnnPinName(n, nt) == n { return n }
  ""
}

// Whether `nt` is a nullable declared record whose record and `null` are both arms of `wTy`, and
// `wTy` is not already that nullable (whose ladder answer stands).
function monoNulRecNamesNarrow(nt: i32, wTy: i32): boolean {
  if nt < 0 || wTy < 0 { return false }
  const t = tyAt(nt)
  if t is TyNullable {
    if nominalStructNameOfTy(t.nInner) == "" { return false }
    const wt = tyAt(wTy)
    if wt is TyNullable {
      const inom = nominalStructNameOfTy(t.nInner)
      if (
        tySame(wt.nInner, t.nInner)
        && nominalStructNameOfTy(wt.nInner) == inom
      ) {
        return false
      }
    }
    return monoTyNarrowsFrom(t.nInner, wTy) && monoTyNarrowsFrom(TY_NULL, wTy)
  }
  false
}

// The narrowed pin of a literal-union argument: its alias, when that alias is a member of the
// union `wTy` the ladder chose, so `T` pins at the atom the checker typed the argument at,
// not at the box that holds it (D3098). "" otherwise.
function monoNarrowedLitPinName(nt: i32, wTy: i32): string {
  const kn = litUnionAliasNameOfTy(nt)
  if kn == "" { return "" }
  if !monoTyNarrowsFrom(nt, wTy) { return "" }
  if monoAnnPinName(kn, nt) != kn { return "" }
  kn
}

// The pin of a `for-in` variable read at `ix` in frame `fnIx` that the checker typed as a
// record: the record's name, a closed inline record's shape (D9641), or "" for any other read.
function monoLoopVarRecordPin(ix: i32, fnIx: i32): string {
  if ix < 0 { return "" }
  const n = nodeAt(ix)
  if !(n is Ident) { return "" }
  if readLoopNodeOf(ix, fnIx) < 0 { return "" }
  const t = nodeTyIxOf(ix)
  const nom = nominalStructNameOfTy(t)
  if nom != "" { return monoAnnPinName(nom, t) }
  if t < 0 || t >= T.tys.length || !(tyAt(t) is TyObj) || monoTyOpen(t) {
    return ""
  }
  monoAnnPinNameOfTy(t)
}

// Registers the row of value union `ty`, returning its name, or "" when it is no value union or
// registering it failed.
function monoRegisterValueUnion(ty: i32): string {
  const vn = valueUnionRetName(ty)
  if vn == "" || monoRegisterPinUnion(vn, ty) < 0 { return "" }
  vn
}

// The pin an argument wants when the ladder answered only the non-null part (`chosen`, of type
// `cTy` or -1) of the `T | null` the checker recorded: an else-less `if`, whose ladder answer is
// the `then` arm, or a nullable read. Delivering that at the non-null spelling puts a
// `(ref null $H)` in a `(ref $H)` cell (D1766).
function monoNicheWidenedPinName(ax: i32, chosen: string, cTy: i32): string {
  if chosen == "" { return "" }
  const nt = nodeTyIxOf(ax)
  if nt < 0 { return "" }
  // A record renders with no `null` arm, so it never widens; skipping its render is D2780's.
  if monoTyIsObj(nt) { return "" }
  // Nor does a list, whose render closes on `[]`; and a nullable record's non-null part is
  // its brace span, which a `chosen` holding no brace cannot be (D9330).
  if tyAt(nt) is TyArray { return "" }
  if tyWrapsRecord(nt) && !strContains(chosen, "{") { return "" }
  const n = monoPinSpellShaped(nt)
  if n == "" { return monoElemlessNulListPinName(nt, chosen) }
  if n == chosen { return "" }
  // It widens only when the node's type is the nullable of the type the ladder chose.
  const ntt = tyAt(nt)
  if !(ntt is TyNullable) || cTy < 0 || !tySame(ntt.nInner, cTy) { return "" }
  if monoAnnPinName(n, nt) != n { return "" }
  n
}

// The widened pin of an element-less `[] | null`, which has no render: nothing decided its
// element, so the ladder `chosen` is the default `i32[]` and the pin keeps the `null` (D6120).
function monoElemlessNulListPinName(nt: i32, chosen: string): string {
  if nt < 0 || nt >= T.tys.length || chosen != "i32[]" { return "" }
  const t = tyAt(nt)
  if !(t is TyNullable) || t.nInner < 0 || t.nInner >= T.tys.length {
    return ""
  }
  const l = tyAt(t.nInner)
  if !(l is TyArray) || l.aElem >= 0 { return "" }
  if monoAnnPinName("i32[]|null", nt) != "i32[]|null" { return "" }
  "i32[]|null"
}

// Whether record type `ty` is stored at no row or at an anonymous one, so that spelling it by
// its shape names no declared record's layout (D3123).
function monoSpelledShapeStaysAnon(ty: i32): boolean {
  const si = structRowOfRecordTy(ty)
  si < 0 || sIsAnonRow(si)
}

// The pin for a list literal of type `lt` whose record element has no committed name, as a
// generic constructor's result has none before its instance exists: the list's own spelling
// through the pin membership list, else "" (D8321).
function monoAnonListPinName(lt: i32): string {
  const el = tyRefArrElemOf(lt)
  if el < 0 || !(tyAt(el) is TyObj) { return "" }
  monoAnnPinNameOfTy(lt)
}

// Whether the spelled shape of record argument `argIx`, typed `ty`, loses a literal: a literal
// anywhere in the type, or in a field of the literal it is, whose own type may have widened one.
function monoAnonArgSoftens(argIx: i32, ty: i32): boolean {
  if tyHasLitDeep(ty, 8) { return true }
  const ax = unwrapParen(argIx)
  if ax < 0 { return false }
  const o = nodeAt(ax)
  if !(o is ObjLit) { return false }
  let i = 0
  while i < o.objFields.length {
    const f = nodeAt(o.objFields[i])
    if f is FieldInit {
      if tyHasLitDeep(nodeTyIxOf(unwrapParen(f.fiValue)), 8) { return true }
    }
    i = i + 1
  }
  false
}

// `monoArgTyName` at a monomorphization pin — the ladder's answer, narrowed to what the
// checker recorded for this node where that is one of the annotation's own members.
// Separate from `monoArgTyName` because `wasmEmit`'s `monoStaticIsResult` also asks that
// one and const-folds on it; narrowing there would fold a guard this pass cannot decide.
function monoArgPinName(ix: i32, fnIx: i32, tyOut: i32[]) {
  const w = monoArgTyName(ix, fnIx, tyOut)
  // A bare `null` typed by its destination (DV-402) pins the declared record's nullable name,
  // as a binding annotated with it does; its structural render would intern another row.
  if nodeAt(unwrapParen(ix)) is NullLit {
    const nn = nulRecNominalName(nodeTyIxOf(unwrapParen(ix)))
    if nn != "" {
      tyOut[0] = nodeTyIxOf(unwrapParen(ix))
      return nn
    }
  }
  // An argument the checker typed the `null` unit type pins it, the `nulnone` cell, whether a
  // bare `null` or a `null`-typed read; a `null[]` pins its own spelling, not the i32 list (D4687).
  if (
    nodeTyIsNullType(unwrapParen(ix))
    || monoReadsUnfilledNull(unwrapParen(ix))
    || monoParamPinnedNull(unwrapParen(ix), fnIx)
  ) {
    // An instance's own parameter pinned at `null`, handed on: the node still records `T` (D8280).
    tyOut[0] = TY_NULL
    return "null"
  }
  // The rungs below rename the ladder's answer, so the type it handed back is not theirs.
  const wTy = tyOut[0]
  tyOut[0] = -1
  if nodeArrayElemIsNullUnit(unwrapParen(ix)) { return "null[]" }
  const n = monoNarrowedPinName(unwrapParen(ix), fnIx, w, wTy)
  if n != "" { return n }
  const wd = monoNicheWidenedPinName(unwrapParen(ix), w, wTy)
  if wd != "" { return wd }
  // A list of nullable records pins the declared struct's row its binding is interned under.
  const nrl = nulRecListNominalName(nodeTyIxOf(unwrapParen(ix)))
  if nrl != "" { return nrl }
  tyOut[0] = wTy
  w
}

// Whether `ax` reads a `let x = null` binding no write filled. By emit time every scope has
// closed, so its only value is `null` and the binding reps `nullref` (D8280).
function monoReadsUnfilledNull(ax: i32): boolean {
  if ax < 0 || !(nodeAt(ax) is Ident) { return false }
  const d = identDeclOf(ax)
  if d < 0 || d >= P.nodes.length || !(nodeAt(d) is LetDecl) { return false }
  tyIsUnfilledNullHole(nodeTyIxOf(ax))
}

function tyIsUnfilledNullHole(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const t = tyAt(ty)
  if t is TyNullable { return t.nInner < 0 }
  false
}

// Whether a hole parameter's pin, resolved to `named` from its spelling, lost the string-literal
// members of `arg`, the value union the argument holds: `named` softened them to `string`.
function monoPinKeepsInlineLits(named: i32, arg: i32): boolean {
  if named < 0 || arg < 0 || named >= T.tys.length || arg >= T.tys.length {
    return false
  }
  if tyHasLitDeep(named, 3) { return false }
  const a = tyAt(monoPeelNullable(arg))
  if !(a is TyUnion) || tyIsLitUnion(monoPeelNullable(arg)) { return false }
  if !(tyAt(monoPeelNullable(named)) is TyUnion) { return false }
  let lit = false
  for m in a.uMembers {
    const mt = tyAt(m)
    if mt is TyLit {
      if mt.litKind != "str" { return false }
      lit = true
    }
  }
  lit
}

// Whether a pin's row spelling `named` denotes another type than the closed record `arg` it
// stores, or than a list of such records at the same depth: the two share the row (a record with
// no row of its own whose `null` fields land in nullable ones is stored in that row), which keys
// a field by its storage, so the parameter takes the argument's type.
function monoPinRowNamesOtherTy(named: i32, arg: i32): boolean {
  if named < 0 || arg < 0 || named >= T.tys.length || arg >= T.tys.length {
    return false
  }
  if tyHasTyVar(arg) || tyEq(named, arg) { return false }
  const na = tyAt(named)
  const aa = tyAt(arg)
  if na is TyArray && aa is TyArray {
    return monoPinRowNamesOtherTy(na.aElem, aa.aElem)
  }
  if !(aa is TyObj) { return false }
  repRowId(named) == repRowId(arg)
}

// Whether pin type `named` is the `string` a string literal or a union of them, `arg`, spells, in
// a function `fn` whose signature names no literal.
function monoPinSoftensLit(named: i32, arg: i32, fn: FuncDecl): boolean {
  if arg < 0 || named < 0 || primNameOf(named) != "string" { return false }
  (tyIsOneStrLit(arg) || tyIsLitUnion(arg)) && !monoSigNamesLit(fn)
}

// Whether `fn`'s written result or a parameter annotation names a literal, under a union.
function monoSigNamesLit(fn: FuncDecl): boolean {
  if fn.fnRet >= 0 && tyHasLitLeaf(nodeTyIxOf(fn.fnRet), 4) { return true }
  for p in fn.fnParams {
    const pn = nodeAt(p)
    if (
      pn is Param
      && pn.parType >= 0
      && tyHasLitLeaf(nodeTyIxOf(pn.parType), 4)
    ) {
      return true
    }
  }
  false
}

// `ty`'s inner type when it is a filled nullable, else `ty`.
function monoPeelNullable(ty: i32): i32 {
  const t = tyAt(ty)
  if t is TyNullable {
    if t.nInner >= 0 && t.nInner < T.tys.length { return t.nInner }
  }
  ty
}

// Whether `ax` reads a parameter of instance `fnIx` whose annotation is the `null` type.
function monoParamPinnedNull(ax: i32, fnIx: i32): boolean {
  if ax < 0 || fnIx < 0 { return false }
  const n = nodeAt(ax)
  if !(n is Ident) { return false }
  const ptn = paramTypeNodeOfRead(fnIx, ax)
  if ptn < 0 { return false }
  nodeTyIxOf(ptn) == TY_NULL
}

// The initializer of the local an if-expression's then arm yields, when that local is declared
// in the arm's own prelude and the join's recorded type is still a type parameter, or -1.
function monoArmTailLocalInit(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const n = nodeAt(ix)
  if !(n is IfStmt) { return -1 }
  if !tyHasTyVar(nodeTyIxOf(ix)) { return -1 }
  if n is IfStmt {
    const b = nodeAt(n.ifThen)
    if b is Block {
      const k = b.blkStmts.length
      if k < 1 { return -1 }
      const tvIx = unwrapParen(b.blkStmts[k - 1])
      if tvIx < 0 { return -1 }
      // A tail that is itself an `if` yields its own then arm's local (D2825).
      const inner = monoArmTailLocalInit(tvIx)
      if inner >= 0 { return inner }
      const tv = nodeAt(tvIx)
      if tv is Ident {
        let i = k - 2
        while i >= 0 {
          const d = nodeAt(b.blkStmts[i])
          if d is LetDecl {
            if d.letName == tv.identName { return d.letInit }
          }
          i = i - 1
        }
      }
    }
  }
  -1
}

// The annotation ladder's pin for type `ty`, by its render, or "" when no rung takes it.
function monoAnnPinNameOfTy(ty: i32): string {
  monoAnnPinName(monoPinSpellShaped(ty), ty)
}

// The pin of a read of an un-annotated literal binding the record solve builds at another
// record (`recBuildTyOf`): the instance is the one its storage is, else "".
function monoBuildTyPin(cax: i32, tyOut: i32[]): string {
  if cax < 0 || !(nodeAt(cax) is Ident) { return "" }
  const d = recFreshDeclOf(cax)
  if d < 0 { return "" }
  const bt = recBuildTyOf(d)
  if bt < 0 { return "" }
  const p = monoClosedTyPin(bt)
  if p != "" { tyOut[0] = bt }
  p
}

// The pin spelling of type `ty` under the naming rule, a record with no row by its fields.
function monoI32AtomPinName(ty: i32): string { monoPinSpellShaped(ty) }

// The pin of closed checker type `ty`, its alias and nominal identity kept: a litunion by
// its alias or kept spelling, a record or nullable record by its declared name, a union by
// its registry row, else its render.
function monoClosedTyPin(ty: i32): string {
  const n = monoClosedTyName(ty)
  if n != "" { return n }
  monoI32AtomPinName(ty)
}

// `monoClosedTyPin` less its render fallback: "" when no declared name or row spells `ty`.
function monoClosedTyName(ty: i32): string {
  if ty < 0 || ty >= T.tys.length { return "" }
  const lu = monoLitUnionPinOfTy(ty)
  if lu != "" { return lu }
  const t = tyAt(ty)
  match t {
    TyObj => {
      const si = structRowRecordingTy(ty)
      if si < 0 || si >= sNames.length || sNames[si].slice(0, 1) == "#" {
        return ""
      }
      return monoAnnPinName(sNames[si], ty)
    }
    TyUnion | TyNullable => {
      // A union of non-literal members is its flattened members in order, which its render
      // spells; an alias row matched by member set names another union's tags (D3129).
      if !tyIsUnionish(ty) || (t is TyUnion && !monoUnionHasLitMember(ty)) {
        return ""
      }
      const ur = unRowOfTyKey(ty)
      if ur >= 0 && ur < unNames.length {
        const un = monoAnnPinName(unNames[ur], ty)
        if un != "" { return un }
      }
      if t is TyNullable {
        const inm = monoClosedTyName(t.nInner)
        if inm != "" { return monoAnnPinName(inm + "|null", ty) }
      }
      return ""
    }
    TyArray => {
      const en = monoClosedTyName(t.aElem)
      if en == "" { return "" }
      if strContains(en, "|") && !tyIsArray(t.aElem) {
        return monoAnnPinName("(" + en + ")[]", ty)
      }
      return monoAnnPinName(en + "[]", ty)
    }
    // A scalar, function, map or open type has no declared name to keep.
    TyPrim | TyErr | TyFunc | TyMap | TyVar | TyLit | TyNeg => {}
  }
  ""
}

// Whether `ix` is an `Ident` the checker resolved to a declaration other than a function's: a
// parameter, a binding or a loop variable, which shadows any function of its name.
function monoIdentReadsValue(ix: i32): boolean {
  if ix < 0 || ix >= P.nodes.length || !(nodeAt(ix) is Ident) { return false }
  const d = identDeclOf(ix)
  if d < 0 || d >= P.nodes.length { return false }
  !(nodeAt(d) is FuncDecl)
}

// The pin of a map whose key or value nothing types (an empty `Map()` handed to a bare
// parameter): the closed map the elaboration binds it at (D1887). "" for any other type.
function monoHoleMapPinName(t: i32): string {
  const c = elabHoleMapClosed(t)
  if c < 0 { "" } else { monoPinSpellShaped(c) }
}

// The rep rungs of `monoArgTyName`, after every binding and projection arm declined: the
// argument's own recorded type, then the collection, union, record and scalar cascades.
// `cax` is `ix` with its grouping parens peeled. "" is the loud floor.
function monoArgTyNameRep(ix: i32, fnIx: i32, cax: i32, tyOut: i32[]): string {
  const lup = monoArgLitUnionPin(ix, fnIx)
  if lup != "" { return lup }
  // An empty list literal has no element for the collection arms to read; the body's pushes
  // pinned its recorded row at the call (D2218). A pinned element no spelling names is the loud
  // floor, since the cascade below reads the literal and would pin `i32[]`.
  const ealN = nodeAt(cax)
  if ealN is ArrayLit {
    if ealN.arrElems.length == 0 && !tyHasTyVar(nodeTyIxOf(cax)) {
      const ealTy = nodeTyIxOf(cax)
      const ealPin = monoAnnPinNameOfTy(ealTy)
      if ealPin != "" {
        tyOut[0] = ealTy
        return ealPin
      }
      if tyRefArrElemOf(ealTy) >= 0 { return "" }
    }
  }
  // A map or Set argument pins its param as that map — the whole `{[K]:V}` spelling an
  // annotated parameter carries. Before the collection arms, since `exprArray`'s catch-all
  // would otherwise name a map an array.
  const hm = monoHoleMapPinName(nodeTyIxOf(unwrapParen(ix)))
  if hm != "" {
    tyOut[0] = elabHoleMapClosed(nodeTyIxOf(unwrapParen(ix)))
    return hm
  }
  const mn = nodeTyMapName(unwrapParen(ix))
  if mn != "" { return mn }
  // The string twin of the arm above, blind in the same place for the same reason:
  // `exprString`'s Ident arm reads `declaredString`, a post-mono locals table.
  // `nodeTyIsStringPrim` reads the `TyPrim` variant and its `primName` directly, and being
  // `TyPrim`-only is the narrowing to watch — a literal union canon-softens to `string`.
  if nodeTyIsStringPrim(unwrapParen(ix)) { return "string" }
  if exprString(ix, fnIx) { return "string" }
  if exprStringArray(ix, fnIx) {
    // A `(string | null)[]` shares the string list's rep exactly, so the rep cascade cannot
    // spell it — and a pin is a NAME, not a rep. The arena's render is the pin, so a bare `T`
    // bound from this list keeps its `| null` and its parameter stays nullable (D1897).
    if nodeTyArrayElemIsNullable(unwrapParen(ix)) {
      const snp = monoAnnPinNameOfTy(nodeTyIxOf(unwrapParen(ix)))
      if snp != "" { return snp }
    }
    return "string[]"
  }
  if exprF64Array(ix, fnIx) { return "f64[]" }
  // The i64 and f32 list arms sit beside the f64 one: the scalar cascade below already
  // names every scalar rep, so without these an `i64[]` / `f32[]` argument falls through
  // to `exprArray`'s catch-all and pins `i32[]`, emitting an instance whose functype reads
  // the i32 list while the caller hands it the i64 or f32 one.
  if exprI64Array(ix, fnIx) { return "i64[]" }
  if exprF32Array(ix, fnIx) { return "f32[]" }
  if exprU8Array(ix, fnIx) { return "u8[]" }
  if exprRefArray(ix, fnIx) {
    // A struct/union-element array: only a literal argument names its element type
    // cheaply; other shapes have no channel here.
    const nd = nodeAt(ix)
    if nd is ArrayLit {
      // A nested list literal over a `boolean` leaf: `arrLitElemName`'s nested-list
      // rung has no boolean member, so `[[true]]` pins `i32[][]`. `nodeTyName` renders
      // the checker's whole array type, which is the pin this site wants; two `TyArray` hops
      // ask the question, so the render is built only for the pin.
      if nodeTyNestedElemIsBoolPrim(ix) { return nodeTyName(ix) }
      // A spread copy is built at its source's row (D2938), which no type here names.
      if spreadLitSrcRowName(ix, fnIx) != "" {
        emitFail(
          "emitProgram: a generic call's spread-copy argument has no pin for its source's row",
        )
        return ""
      }
      const aen = arrLitElemName(ix, fnIx)
      if aen == "" { return monoAnonListPinName(nodeTyIxOf(ix)) }
      // The pin is the literal's own list type, which keys the instance; its text follows.
      const lt = nodeTyIxOf(ix)
      const ls = monoPinSpellShaped(lt)
      if ls != "" {
        tyOut[0] = lt
        return ls
      }
      // An open element type (a hole function, a type parameter) has no spelling: its element
      // name, a row handle or a function's, is the pin until the callee instance types it (D16022).
      if !tyHasTyVar(lt) && !tyHasInferHole(lt, 0) {
        emitFail(
          "emitProgram: monomorphize: a closed record-list literal argument has no pin spelling (D16022)",
        )
        return ""
      }
      return arrElemSuffixed(aen)
    }
    // The arena, for every other shape: a call or projection reaches this floor with a type
    // the checker recorded and no literal to read an element off. The same question the
    // nullable-struct floor below asks, through the same membership list (D1755).
    const rap = monoAnnPinNameOfTy(nodeTyIxOf(unwrapParen(ix)))
    if rap != "" { return rap }
    return ""
  }
  if exprArray(ix, fnIx) {
    // A `boolean[]` shares the i32 list rep exactly, so the rep cascade cannot spell it —
    // and a pin is a name, not a rep. The instance's parameter annotation is the only
    // boolean-ness left in a monomorphized body, and `listElemIsBool` recovers the print
    // formatting from it. Only a genuine `boolean` leaf: `tyArrayElemPrimName` is `TyPrim`-only.
    if nodeTyArrayElemIsBoolPrim(ix) { return "boolean[]" }
    return "i32[]"
  }
  // A union no arm above resolved has no pin; the elaboration closes projections upstream.
  if exprUnion(ix, fnIx) { return "" }
  if exprNullableStruct(ix, fnIx) {
    // The nullable-struct floor owes the arena the same question D1516 gave the union floor
    // above it: every arm before this resolves a binding, so an if-expression or any other
    // projection reaches the floor with a type the checker recorded and no channel to spell
    // it. Through `monoAnnPinName`, the one pin membership list, so `""` still refuses (D1755).
    const nsp = monoAnnPinNameOfTy(nodeTyIxOf(unwrapParen(ix)))
    if nsp != "" { return nsp }
    return ""
  }
  // The wider nullable, which the struct floor above does not claim: a map read (`m[k]` and
  // its `m.get(k)` spelling) is an i32-repped NICHE, so the scalar cascade below names the
  // non-null half and the instance's parameter loses its `| null`. Same question, same
  // membership list, one rung on (D1753).
  if nodeTyIsNullable(unwrapParen(ix)) {
    const nulPin = monoAnnPinNameOfTy(nodeTyIxOf(unwrapParen(ix)))
    if nulPin != "" { return nulPin }
  }
  // A walk variable the checker typed as a record: the struct and variant rungs below read its
  // rep from the locals table, which mid-mono has none, and would pin `i32` (D3139).
  const wrp = monoLoopVarRecordPin(cax, fnIx)
  if wrp != "" { return wrp }
  // An object literal the checker built as a union member pins that member's row (D8021).
  if nodeAt(cax) is ObjLit {
    const ovr = litArmRowOf(cax, fnIx, nodeRepTyIxOf(cax))
    if ovr >= 0 && ovr < uVariants.length {
      const ovn = monoAnnPinName(
        uVariants[ovr],
        if ovr < uVarTyIx.length { uVarTyIx[ovr] } else { -1 },
      )
      if ovn != "" { return ovn }
    }
  }
  // The variant table, asked before the struct one. `collectS` skips a `type X = {…}` that
  // is a union member, so `type Shape = Circle | Sq` deletes `Circle`'s `sNames` row and
  // mints a variant row. `exprVariantIndex` is `structIndexOfExpr`'s storage-class twin,
  // arm for arm and each leg kind-gated, so the two cannot both answer (D57).
  const avi = exprVariantIndex(ix, fnIx)
  if avi >= 0 && avi < uVariants.length {
    const avn = monoAnnPinName(
      uVariants[avi],
      if avi < uVarTyIx.length { uVarTyIx[avi] } else { -1 },
    )
    if avn != "" { return avn }
  }
  if exprStruct(ix, fnIx) {
    const olv = litRetArmRow(unwrapParen(cax))
    if olv >= 0 && olv < uVariants.length {
      const olp = monoAnnPinName(
        uVariants[olv],
        if olv < uVarTyIx.length { uVarTyIx[olv] } else { -1 },
      )
      if olp != "" { return olp }
    }
    // The row the argument's checked record type is stored at; the type-blind classifier is
    // not asked before mono.
    const si = structRowOfRecordTy(nonNullTy(nodeTyIxOf(unwrapParen(ix))))
    // A call's return row is read before the literal it builds has a row of its own, so a
    // declared row boxing a field the checker typed bare is pinned at the argument's own shape.
    if (
      si >= 0
      && nodeAt(cax) is Call
      && monoRowBoxesBareField(si, nodeTyIxOf(cax))
    ) {
      const own = internOwnShapeOfTy(nodeTyIxOf(cax))
      if own != "" { return own }
    }
    if si >= 0 {
      tyOut[0] = if si < sTyIx.length { sTyIx[si] } else { -1 }
      return sNames[si]
    }
    // No `sNames` row, but a good spelling — the checker's recorded shape, routed through
    // the one pin membership list, which claims a bare inline object shape (D703). The row
    // goes missing because `collectS` skips a `type X = {…}` that is a union member. At the
    // floor, and `tyToEmitName` rather than `nodeTyName`: `tyToStr` flattens an alias field.
    const shp = monoAnnPinNameOfTy(nodeTyIxOf(unwrapParen(ix)))
    if shp != "" { return shp }
    return ""
  }
  // f32 before f64 — the order `exprIsF32`'s own header states, and which every cell, slot
  // and assign ladder obeys. `exprIsF64` over-claims a mixed f32/float-literal argument
  // (`fv * 1.0` is both), so asking f64 first binds `T` to f64 and the f64 result reaches a
  // site that classifies the call f32. A genuine f64 operand still binds f64 here.
  if exprIsV128(ix, fnIx) { return "v128" }
  if exprIsF32(ix, fnIx) { return "f32" }
  if exprIsF64(ix, fnIx) { return "f64" }
  if exprIsI64(ix, fnIx) { return "i64" }
  if exprIsBool(ix, fnIx) { return "boolean" }
  // No `i32` catch-all (D23): a pin is the instance's parameter annotation, so a rep the cascade
  // did not recognise is the loud floor `""`. An argument typed a bare type variable, or a list of
  // one, that no instance closes takes the type the elaboration gives the unbound variable.
  if exprNullableVariant(ix, fnIx) { return "" }
  if exprNullableRefArray(ix, fnIx) { return "" }
  const ot = nodeTyIxOf(cax)
  const oo = if ot >= 0 && ot < T.tys.length { tyAt(ot) } else { null }
  const oe = if oo is TyArray && oo.aElem >= 0 && oo.aElem < T.tys.length { tyAt(oo.aElem) } else { null }
  const v = if oo is TyVar { oo.tvName } else if oe is TyVar { oe.tvName } else { "" }
  if v == "" { return "" }
  const ut = elabUnboundTpTy(-1, fnIx, v)
  const up = monoPinAnnSpelling(ut)
  if up != "" { tyOut[0] = ut }
  up
}

// Whether row `si` boxes, as a union or nullable, a field record type `ty` holds as a bare
// scalar or literal; false when either side is not a record or names a type parameter.
function monoRowBoxesBareField(si: i32, ty: i32): boolean {
  if si < 0 || si >= sTyIx.length || ty < 0 || ty >= T.tys.length {
    return false
  }
  const o = tyAt(ty)
  if !(o is TyObj) || tyHasTyVar(ty) { return false }
  for nm in o.objFieldNames {
    const lt = tyFieldTyOf(ty, nm)
    const rt = tyFieldTyOf(sTyIx[si], nm)
    if (
      lt >= 0
      && rt >= 0
      && lt < T.tys.length
      && rt < T.tys.length
      && !tyHasTyVar(rt)
    ) {
      const l = tyAt(lt)
      const r = tyAt(rt)
      if (l is TyPrim || l is TyLit) && (r is TyUnion || r is TyNullable) {
        return true
      }
    }
  }
  false
}

// The pin a litunion or litunion-list argument `ix` takes, "" for any other argument.
function monoArgLitUnionPin(ix: i32, fnIx: i32): string {
  monoLitUnionPinOfTy(nodeTyAt(unwrapParen(ix), fnIx))
}

// The pin of litunion or litunion-list type `luTy`, "" for any other type.
function monoLitUnionPinOfTy(luTy: i32): string {
  // A declared litunion pins the parameter to the alias, ahead of the string and scalar
  // arms. For a litunion the spelling is the rep, and `litUnionAliasNameOfTy` names the
  // alias. Without this arm the pin loses the type entirely.
  const luAl = litUnionAliasNameOfTy(luTy)
  if luAl != "" { return luAl }
  // The array sibling, and it has to sit here: the collection arms spell a litunion array by
  // its rep and `nameIsI32Array` accepts a litunion `K[]`, so `exprArray` pins `i32[]` and
  // binds every `T` mentioning the element to plain i32. See `monoAnnPinName`'s
  // litunion-array arm — the two channels must claim the same shape.
  const luIsArr = tyIsLitUnionArray(luTy)
  if luIsArr && luTy >= 0 {
    const luArrT = tyAt(luTy)
    if luArrT is TyArray {
      const luElAl = litUnionAliasNameOfTy(luArrT.aElem)
      if luElAl != "" { return luElAl + "[]" }
    }
  }
  // An inline member set has no alias, so it, or a list of it (a one-member set's included),
  // pins at its kept spelling; without the rung the hole parameter carries a raw width (D1545).
  if luIsArr || tyIsLitUnion(luTy) {
    const luInl = monoPinSpellShaped(luTy)
    if luInl != "" { return luInl }
  }
  // A lone string literal with no alias is a string value, so an atom-repped one (a literal
  // field read) pins the `string` instance and widens at the call (D7440).
  if tyIsOneStrLit(luTy) { return "string" }
  ""
}

// The projection rungs of `monoArgTyName`: an indexed element and a record field, named
// from the pin of what they project. Falls to `monoArgTyNameRep` where neither answers.
function monoArgTyNameProjected(
  ix: i32,
  fnIx: i32,
  cax: i32,
  tyOut: i32[],
): string {
  const argN = nodeAt(unwrapParen(ix))
  // An indexed element argument (`id(xs[0])`): the array's own name resolves above through
  // the annotation arms, and the element pins at the list's element type, spelled by the naming
  // rule and claimed through `monoAnnPinName`, the same home the array is named through.
  if argN is Index {
    // The array NAME cannot carry a literal-union element: such an array reps as the
    // interned-atom i32 list, so an INFERRED one is named `i32[]` and this arm would pin the
    // atom's raw width. The element's own recorded type is exact, so it is left to the litunion
    // rungs below, which spell an alias and an inline set apart (D1756).
    if !tyIsLitUnion(nodeTyIxOf(unwrapParen(ix))) {
      const arrOut: i32[] = [0 - 1]
      const arrTy = monoArgTyName(argN.idxArr, fnIx, arrOut)
      // The list's type: the one its pin named, else the indexed node's own.
      const lt = if arrOut[0] >= 0 { arrOut[0] } else { elabNodeTyOrChecked(argN.idxArr, fnIx) }
      if arrTy.length >= 3 && monoTyIsList(lt) {
        const at = tyAt(lt)
        const aet = if at is TyArray { at.aElem } else { -1 }
        const r = monoAnnPinName(monoPinSpellShaped(aet), aet)
        if r != "" {
          tyOut[0] = tyArrayElemIx(lt)
          return r
        }
      }
    }
  }
  // A struct-field argument (`id(o.inner)`): resolve the receiver's struct from its pinned
  // type, then read the field's recorded record type off the struct table (a nested-struct
  // field is code 15).
  // `structIndexOfExpr(o.inner)` would default to i32, the locals table being unbuilt.
  if argN is Member {
    const recvOut: i32[] = [0 - 1]
    monoArgTyName(argN.memObj, fnIx, recvOut)
    const rsi = structRowOfValueTy(recvOut[0])
    if rsi >= 0 {
      const fi = sFieldIndex(rsi, argN.memProp)
      if fi >= 0 && sFieldTypeAt(rsi, fi) == FC_STRUCT {
        // The field's recorded record type, when a struct row holds it: the pin is its type,
        // spelled by the naming rule.
        const fet = sFieldElemTyIxAt(rsi, fi)
        const et = if fet >= 0 { nonNullTy(fet) } else { -1 }
        if et >= 0 && structRowOfRecordTy(et) >= 0 {
          tyOut[0] = et
          return monoPinSpellShaped(et)
        }
      }
    }
    // A union-valued field, whose companion column is a member set rather than a struct name.
  }
  monoArgTyNameRep(ix, fnIx, cax, tyOut)
}

// The binding rungs of `monoArgTyName`: a build row's pin, then an `Ident` argument's local,
// parameter or module binding. "" refuses; falls to
// `monoArgTyNameProjected` where none answers.
function monoArgTyNameBound(
  ix: i32,
  fnIx: i32,
  cax: i32,
  tyOut: i32[],
): string {
  const bp = monoBuildTyPin(cax, tyOut)
  if bp != "" { return bp }
  const argN = nodeAt(unwrapParen(ix))
  // An Ident argument bound to a generic-call result (`const inner = box(7); box(inner)`):
  // resolve via its un-annotated `let` init, the local's type table being unbuilt mid-mono.
  // Only a resolved non-i32 type is adopted; a param or non-let ident falls through.
  if argN is Ident {
    if fnIx >= 0 {
      const ctxFn = nodeAt(fnIx)
      if ctxFn is FuncDecl {
        const li = parentLetOfAt(ctxFn.fnBody, sidOfNode(cax), cax)
        if li >= 0 {
          const ld = nodeAt(li)
          if ld is LetDecl {
            // A struct- or struct-array-typed annotated local: read its annotation
            // name directly. `buildLocals` is post-mono, so the `exprStruct` and
            // `exprRefArray` cases below would default the type param to i32.
            if ld.letType >= 0 {
              // A composite-element list local (`xs: i32[][]`, `(i32|null)[]`) is
              // among the spellings `monoAnnPinName` claims: the cascade below either
              // declines it or answers one dimension short.
              const r = monoAnnPinName(
                tyNameOf(ld.letType),
                nodeTyIxOf(ld.letType),
              )
              if r != "" {
                tyOut[0] = monoPinClosedOrNone(
                  monoPinSubTyOf(nodeTyIxOf(ld.letType), fnIx),
                )
                return r
              }
            }
            if ld.letType < 0 && ld.letInit >= 0 {
              // A record or list of records holding a tagged set's ids pins at the row its own
              // type is built at, which a render of the closed type, dropping the set, does not
              // name (D15561).
              let tt = nodeTyIxOf(li)
              let tsuf = ""
              while (
                tt >= 0
                && tt < T.tys.length
                && tyAt(tt) is TyArray
                && tsuf.length < 16
              ) {
                tt = tyArrayElemIx(tt)
                tsuf = tsuf + "[]"
              }
              if (
                tt >= 0
                && tt < T.tys.length
                && tyAt(tt) is TyObj
                && fnTagHoldsTy(tt, 8)
              ) {
                let tsi = structRowRecordingTy(tt)
                if tsi < 0 { tsi = repRowOfTyStruct(tt, sNames.length) }
                if tsi >= 0 && tsi < sNames.length { return sNames[tsi] + tsuf }
              }
              // A binding pins at the closed type its cell holds, the type its rep is read from; the
              // initializer answers only where that type names no pin (D14440).
              const lrp = monoClosedTyPin(letBindTy(li, fnIx))
              if lrp != "" {
                tyOut[0] = letBindTy(li, fnIx)
                return lrp
              }
              const innerTy = monoArgTyName(ld.letInit, fnIx, tyOut)
              if innerTy != "" && innerTy != "i32" { return innerTy }
              tyOut[0] = -1
              // A refusal propagates: `""` here is one of this ladder's explicit
              // floors, and falling through hands the question back to a cascade that
              // is post-mono blind for a local and answers `"i32"`.
              if innerTy == "" { return "" }
            }
          }
        }
      }
      // A struct-typed param argument (`g(v)` inside a generic body where `v: P`): same as
      // the annotated-local case — read the param annotation, the locals table being unbuilt.
      const ptn = paramTypeNodeOfRead(fnIx, cax)
      if ptn >= 0 {
        const pt = nodeAt(ptn)
        if pt is TypeRef {
          // The annotated-local arm's param twin — a generic body passing its own
          // `xs: i32[][]` / `boolean[]` / `P` parameter on to a second generic call, the
          // shape a generic forwarder has. One home, so the two cannot drift.
          const r = monoAnnPinName(pt.tyName, nodeTyIxOf(ptn))
          if r != "" {
            tyOut[0] = monoPinClosedOrNone(
              monoPinSubTyOf(nodeTyIxOf(ptn), fnIx),
            )
            return r
          }
        }
      }
    }
    // The module-scope twin of the two arms above, arm for arm. `parentLetOf` is
    // function-scoped and every arm above sits behind `fnIx >= 0`, so a generic call whose
    // argument is a top-level binding reaches none of them; `monoModuleLetOf` declines on a
    // shadow test rather than on `fnIx >= 0`, so a global is readable inside a function too.
    const gli = monoModuleLetOf(cax, fnIx)
    if gli >= 0 {
      const gd = nodeAt(gli)
      if gd is LetDecl {
        if gd.letType >= 0 {
          // The global's annotation, through the one pin membership list — the same
          // call the annotated-local and param arms make, so a generic call pins its
          // instance identically wherever its argument's binding lives.
          const rg = monoAnnPinName(
            tyNameOf(gd.letType),
            nodeTyIxOf(gd.letType),
          )
          if rg != "" {
            tyOut[0] = monoPinClosedOrNone(
              monoPinSubTyOf(nodeTyIxOf(gd.letType), fnIx),
            )
            return rg
          }
        }
        // The un-annotated global, the other half of the local arm's pair, whose type
        // only its initializer knows. The recursion is the local arm's verbatim,
        // including its two rules on an `"i32"` answer and on a `""` refusal.
        if gd.letType < 0 && gd.letInit >= 0 {
          const ginner = monoArgTyName(gd.letInit, fnIx, tyOut)
          if ginner != "" && ginner != "i32" { return ginner }
          tyOut[0] = -1
          if ginner == "" { return "" }
        }
      }
    }
  }
  monoArgTyNameProjected(ix, fnIx, cax, tyOut)
}

// The pin argument `ix` binds its parameter at, at instance `fnIx`: its closed type's, else
// the cascade's for a type that does not decide it.
export function monoArgTyName(ix: i32, fnIx: i32, tyOut: i32[]) {
  tyOut[0] = -1
  const tr = monoArgClosedPinTy(ix, fnIx)
  const t = tr[0]
  const rec = tr[1] == 1
  if t >= 0 {
    // A value union nothing spells gets its row here, which the instance's boxes read tags from.
    if (
      !rec
      && !tyMayHoldFn(t, 0)
      && !(tyAt(t) is TyUnion && numLitUnionBaseName(t) != "")
      && tyIsUnionish(t)
      && unRowOfCanonFolded(t) < 0
    ) {
      monoRegisterValueUnion(t)
    }
    const tp = if rec { monoRecordNominalPin(t) } else { monoPinOfClosedTy(t) }
    if tp != "" {
      tyOut[0] = monoClosedPinOwnTy(t, rec)
      return tp
    }
  }
  monoArgTyNameCascade(ix, fnIx, tyOut)
}

// `[type, record]`: the closed type argument `ix` is pinned from at instance `fnIx`, and 1 where it
// is pinned as a record (`monoRecordNominalPin`); `[-1, 0]` where its type does not decide the pin.
// A record read narrowed below its place, or any read the instance alone narrows, is pinned from
// the type its place holds.
export function monoArgClosedPinTy(ix: i32, fnIx: i32): i32[] {
  const none: i32[] = [0 - 1, 0]
  const cax = unwrapParen(ix)
  if cax < 0 || cax >= P.nodes.length { return none }
  let t = monoArgClosedTyIn(cax, fnIx, monoArgPinTyAt(cax, fnIx))
  if t < 0 { t = elabArgBuiltTy(cax) }
  if t < 0 || t >= T.tys.length { return none }
  // A record is handed as the reference it is stored as: a narrowed record read takes the type its
  // place holds; a structural record waits on its build row (a4cf's row-key fact).
  if tyHoldsObj(t, 8) {
    if !monoReadIsNarrowed(cax, fnIx) { return [t, 1] }
    const rh = monoPlaceHeldTy(cax, fnIx)
    if rh < 0 || rh >= T.tys.length || tyHasTyVar(rh) { return none }
    return [rh, 1]
  }
  // A read the checker narrowed converts at the read and pins at its own type; one only the
  // instance types narrower than its place is handed the place's held type.
  if monoReadIsNarrowed(cax, fnIx) && readNarrowedStoreAt(cax, fnIx) < 0 {
    const held = monoPlaceHeldTy(cax, fnIx)
    if (
      held < 0
      || held >= T.tys.length
      || tyHasTyVar(held)
      || tyHoldsObj(held, 8)
    ) {
      return none
    }
    return [held, 0]
  }
  [t, 0]
}

// The pin of closed record-bearing type `ty` by its declared names: a declared record or a generic
// application by its name, any other type by its nominal render without spaces; "" where a
// record in it is spelled only by its fields.
function monoRecordNominalPin(ty: i32): string {
  const t = tyAt(ty)
  if t is TyObj {
    const sn = structNameOfTy(ty)
    if sn != "" {
      // Same-shape declared records are one type, so they share the row's declared name.
      const rr = repRowOfTyStruct(ty, sNames.length)
      if (
        rr >= 0
        && rr < sNames.length
        && structNameOfTy(sTyIx[rr]) == sNames[rr]
      ) {
        return sNames[rr]
      }
      return sn
    }
    return genAppNameOfTy(ty)
  }
  if monoTyHasFieldRecord(ty, 24) { return "" }
  const raw = tyToNominalName(ty)
  let out = ""
  let i = 0
  while i < raw.length {
    const c = raw.slice(i, i + 1)
    if c != " " { out = out + c }
    i = i + 1
  }
  out
}

// Whether closed type `t` holds, at any depth, a record no declared or application name spells:
// the record its nominal render spells by its fields.
function monoTyHasFieldRecord(t: i32, depth: i32): boolean {
  if depth <= 0 || t < 0 || t >= T.tys.length { return false }
  if nomNameOfTy(t) != "" || unionAliasDeclNameOfTy(t) != "" { return false }
  const o = tyAt(t)
  match o {
    TyObj => {
      if structNameOfTy(t) == "" && genAppNameOfTy(t) == "" { return true }
      if structNameOfTy(t) != "" { return false }
      for f in o.objFieldTypes {
        if monoTyHasFieldRecord(f, depth - 1) { return true }
      }
      return false
    }
    TyArray => {
      return monoTyHasFieldRecord(o.aElem, depth - 1)
    }
    TyNullable => {
      return monoTyHasFieldRecord(o.nInner, depth - 1)
    }
    TyUnion => {
      for m in o.uMembers {
        if monoTyHasFieldRecord(m, depth - 1) { return true }
      }
      return false
    }
    TyMap => {
      return monoTyHasFieldRecord(o.mKey, depth - 1)
        || monoTyHasFieldRecord(o.mVal, depth - 1)
    }
    TyFunc => {
      for p in o.fnParamTypes {
        if monoTyHasFieldRecord(p, depth - 1) { return true }
      }
      return monoTyHasFieldRecord(o.fnRet, depth - 1)
    }
    TyPrim | TyErr | TyVar | TyLit | TyNeg => {
      return false
    }
  }
}

// The pin of closed type `ty`, which holds no record, as mono keys an instance: a function-
// bearing type by `monoFnTyPin`, a union of numeric literals by its base scalar, any other by
// `monoClosedTyPin`; "" where the key has no token for a part.
function monoPinOfClosedTy(ty: i32): string {
  if ty < 0 || ty >= T.tys.length { return "" }
  if tyMayHoldFn(ty, 0) { return monoFnTyPin(ty) }
  if tyAt(ty) is TyUnion {
    const nb = numLitUnionBaseName(ty)
    if nb != "" { return nb }
  }
  monoClosedTyPin(ty)
}

// The closed record type argument `x` is built at in frame `ctx`: the checker's recorded build
// (`recArgBuiltTyIn` over the last pass's table), else its per-instance stamp; -1 for neither.
function monoArgBuildTy(x: i32, ctx: i32): i32 {
  if x < 0 || x >= P.nodes.length { return -1 }
  const b = recArgBuiltTyIn(x, nodeTyIxOf(x), recBuildTable())
  if b >= 0 && b < T.tys.length && !tyHasTyVar(b) && tyHoldsObj(b, 8) {
    return b
  }
  const st = elabStampAt(x, ctx)
  if st >= 0 && st < T.tys.length && !tyHasTyVar(st) && tyHoldsObj(st, 8) {
    st
  } else {
    -1
  }
}

// The pin of closed record-bearing type `ty`: its declared name, else the row recorded for it,
// else the declared row of the same type, else its render.
function monoRecordRowPin(ty: i32): string {
  const r = monoRecordNominalPin(ty)
  if r != "" { return r }
  const si = structRowRecordingTy(ty)
  if si >= 0 && si < sNames.length { return sNames[si] }
  if tyAt(ty) is TyObj {
    const rr = repRowOfTyStruct(ty, sNames.length)
    if (
      rr >= 0
      && rr < sNames.length
      && rr < sTyIx.length
      && tySame(sTyIx[rr], ty)
    ) {
      return sNames[rr]
    }
  }
  monoClosedTyPin(ty)
}

// The pin of closed function-bearing type `ty`: a function by its `$fnsig` key, a nullable
// function by its render, a container of them through `monoClosedTyPin`; "" when the key has
// no token for a part.
function monoFnTyPin(ty: i32): string {
  if tyAt(ty) is TyFunc {
    const k = sigKeyOfTy(ty)
    if k == "" { return "" }
    return "=>" + k
  }
  if tyNulFuncInner(ty) >= 0 { return monoPinSpellShaped(ty) }
  monoClosedTyPin(ty)
}

// Whether `ix` reads a place at a type other than the one the place holds: a binding, field or
// element whose held type is union-shaped and differs from the type recorded at the read.
function monoReadIsNarrowed(ix: i32, fnIx: i32): boolean {
  const rt = nodeTyAt(ix, fnIx)
  if rt < 0 || rt >= T.tys.length { return false }
  const held = monoPlaceHeldTy(ix, fnIx)
  if held < 0 || held >= T.tys.length { return false }
  if !(tyAt(held) is TyUnion || tyAt(held) is TyNullable) { return false }
  !tySame(held, rt)
}

// The type the place `ix` reads holds: a binding's declared or initializer type, a field's type
// on its receiver, a list element's type; -1 for an expression that is not a place.
function monoPlaceHeldTy(ix: i32, fnIx: i32): i32 {
  const n = nodeAt(ix)
  if n is Ident { return unionTyIxOfIdentAt(sidOfNode(ix), fnIx, ix) }
  if n is Member { return tyFieldTyOf(nodeTyAt(n.memObj, fnIx), n.memProp) }
  monoElemPlaceHeldTy(ix, fnIx)
}

// The element type the list an `xs[i]` read indexes holds; -1 for any other expression.
function monoElemPlaceHeldTy(ix: i32, fnIx: i32): i32 {
  const n = nodeAt(ix)
  if n is Index { return tyArrayElemIx(nodeTyAt(n.idxArr, fnIx)) }
  -1
}

// The binding, projection and rep rungs, for an argument whose type does not decide its pin.
function monoArgTyNameCascade(ix: i32, fnIx: i32, tyOut: i32[]) {
  const cax = unwrapParen(ix)
  // An instance's own `x: T` parameter or `const y: T = x` local carries a function pin as its
  // annotation, which neither gate below can see: a generic forwarder hands it its inner call.
  const cloPinTy = monoCloPinTyOf(cax, fnIx)
  // The arena asks the closure question, because `exprIsClosure` cannot ask it here: that
  // predicate resolves through tables `buildLocals` fills post-mono. `nodeTyIsFunc` is the
  // checker's answer and needs no emit-side table. The gates are OR'd, not swapped, since
  // without `cloPinTy` a forwarder's `gid(x)` falls to the same catch-all.
  const valRead = monoIdentReadsValue(cax)
  // A read that resolves to a value binding is not the function its name may also spell.
  let cloArg = false
  if valRead {
    cloArg = identIsBoundClosure(cax, fnIx)
  } else {
    cloArg = exprIsClosure(ix, fnIx)
  }
  if cloArg || nodeTyIsFunc(cax) || cloPinTy >= 0 {
    // A function-value argument pins its param as a closure (kind 14) at a named function's
    // declared `$fnsig` key, so the instance's value-call ref-casts to the exact signature. A
    // generic one has no one signature the call fixes, so it is refused at the read.
    const ce = if cax >= 0 && !valRead { nodeAt(cax) } else { nodeAt(0) }
    if cax >= 0 && !valRead && ce is Ident {
      let cfe = fnIndexOfInScopeAt(sidOfNode(cax), ce.identName, fnIx, cax)
      if cfe < 0 { cfe = fnIndexOfAt(sidOfNode(cax), fnIx, cax) }
      const dt = if cfe >= 0 && cfe < fnStmts.length { nodeTyIxOf(fnStmts[cfe]) } else { -1 }
      if (
        cfe >= 0
        && (cfe < monoGen.length && monoGen[cfe] == 1 || dt < 0 || tyHasTyVar(dt))
      ) {
        emitFailAt(
          "emitProgram: a generic function taken as a value reaches no call that fixes its type "
            + "— annotate the destination's function type",
          cax,
        )
        return ""
      }
      if dt >= 0 && tyAt(dt) is TyFunc {
        const k = sigKeyOfTy(dt)
        if k != "" { return "=>" + k }
      }
    }
    // Any other function value is the loud floor: it must not fall through to the i32 catch-all.
    return ""
  }
  // An if-expression whose join is still a type parameter and whose then arm's value is a
  // local of that arm's own prelude pins at that local's initializer: mid-mono no locals
  // table exists, so no other channel resolves the arm's value (D2821).
  const armInit = monoArmTailLocalInit(cax)
  if armInit >= 0 { return monoArgTyName(armInit, fnIx, tyOut) }
  monoArgTyNameBound(ix, fnIx, cax, tyOut)
}

// `aN`/`aT` then each binding of `hN`/`hT` whose name `aN` lacks, into `outN`/`outT`.
function monoJoinBinding(
  aN: string[],
  aT: i32[],
  hN: string[],
  hT: i32[],
  outN: string[],
  outT: i32[],
) {
  let i = 0
  while i < aN.length && i < aT.length {
    outN.push(aN[i])
    outT.push(aT[i])
    i = i + 1
  }
  let j = 0
  while j < hN.length && j < hT.length {
    if !monoStrListHas(aN, hN[j]) {
      outN.push(hN[j])
      outT.push(hT[j])
    }
    j = j + 1
  }
  0
}

// The type-level binding column (`T` ⇒ concrete type), built as the checker does: `bindGenWalk`
// of each signature type (`declTys`, positional) against its pin (`tyCol`, -1 = nothing known).
// A hole binds only at a closed pin that can hold a function and no literal: its pin name
// cannot key such a call's result, and softens a literal.
function monoBindCols(
  call: i32,
  params: i32[],
  declTys: i32[],
  tyCol: i32[],
  bN: string[],
  bT: i32[],
) {
  let bi = 0
  while bi < params.length {
    const pp = nodeAt(params[bi])
    if pp is Param {
      let at = -1
      if bi < tyCol.length { at = tyCol[bi] }
      const decl = monoParamPatTy(params, bi, declTys)
      if pp.parType < 0 {
        if (
          at >= 0
          && (!tyMayHoldFn(at, 0) || tyHasLitDeep(at, 8) || tyHasTyVar(at))
        ) {
          at = -1
        }
      }
      bindGenWalk(decl, at, bN, bT)
      bindGenUnionShapedArmInto(decl, at, bN, bT)
    }
    bi = bi + 1
  }
  // A union over a bare type parameter binds only what no other parameter did (D2734), at the
  // elaboration's binding for the call.
  let ui = 0
  while ui < params.length && ui < tyCol.length {
    const up = nodeAt(params[ui])
    if up is Param && tyCol[ui] >= 0 && !tyHasTyVar(tyCol[ui]) {
      elabBindUnionArmsFromCall(
        call,
        monoParamPatTy(params, ui, declTys),
        bN,
        bT,
      )
    }
    ui = ui + 1
  }
  0
}

// The parameter types generic `origFe`'s signature declares, where the checker typed it as a
// function of `n` parameters; else empty. A shared annotation node is re-typed by canon's
// scope-blind rename and by a diagonal instance, so a type parameter shadowing a declared
// name reads as one only here.
function monoDeclParamTys(origFe: i32, n: i32): i32[] {
  if origFe < 0 || origFe >= monoOrigNode.length { return [] }
  monoDeclParamTysOf(monoOrigNode[origFe], n)
}

// `monoDeclParamTys` of the generic declared at node `decl`.
function monoDeclParamTysOf(decl: i32, n: i32): i32[] {
  const out: i32[] = []
  if decl < 0 { return out }
  const sig = nodeTyIxOf(decl)
  if sig < 0 || sig >= T.tys.length { return out }
  const ft = tyAt(sig)
  if !(ft is TyFunc) || ft.fnParamTypes.length != n { return out }
  for pt in ft.fnParamTypes { out.push(pt) }
  out
}

// Parameter `i`'s type as a binding pattern: its annotation's, unless that names no type
// parameter and the signature's (`declTys`, from `monoDeclParamTys`) is known. -1 when neither is.
function monoParamPatTy(params: i32[], i: i32, declTys: i32[]): i32 {
  if i < 0 || i >= params.length { return -1 }
  const p = nodeAt(params[i])
  if !(p is Param) { return -1 }
  const pt = nodeTyIxOf(p.parType)
  if i < declTys.length && declTys[i] >= 0 && !tyHasTyVar(pt) {
    return declTys[i]
  }
  pt
}

// Substitute a `LetDecl` annotation `letType` through the instance binding, returning a
// fresh `TypeRef` when a type param substitutes (`T[]` → `f64[]`), else the original node
// index — so a generic body's `const out: T[] = []` lowers against the instance's concrete
// element type, reusing the concrete annotated path rather than per-rep usage inference.
function monoSubstLetType(
  letIx: i32,
  letType: i32,
  typarams: string[],
  bN: string[],
  bT: i32[],
) {
  if letType < 0 { return letType }
  // A copy of a parameter takes the type the elaboration closes that parameter at.
  const ct = elabCopyTyOwn(letIx)
  if ct >= 0 && tyAt(ct) is TyFunc {
    return monoSynthPinRef(monoPinOfClosedTy(ct), ct)
  }
  const tn = nodeAt(letType)
  if tn is TypeRef {
    if monoAnnMentionsTyParam(letType, typarams) {
      // The let's type substituted at the instance, spelled by the naming rule with an anonymous
      // record by its fields: its `#anonN` handle inside a union names no type the registry can
      // key (D12641). A binding that stays open keeps its annotation.
      let sty = -1
      // A loop value's carrier keeps its open type beside its annotation (`monoAnnOpenTyNote`).
      const ot = nodeTyIxOf(letType)
      const origLet = if ot >= 0 { ot } else { monoAnnOpenTyOf(letType) }
      if origLet >= 0 {
        const s2 = monoSubstInst(origLet, bN, bT)
        if s2 >= 0 && s2 != origLet {
          if !tyHasTyVar(s2) { sty = s2 }
        }
      }
      const sub = if sty >= 0 { monoPinSpellNoAnon(sty) } else { "" }
      if sub != "" && sub != tn.tyName {
        const subC = monoPinMintedUnion(sub, sty, sty, unTyKeyTagLet())
        // Spelled by the registered union an assignment's `letUnionNameOf` resolves (D2676), and
        // typed at the substitution, never by parsing that spelling back: an arm may be spelled
        // by its row label, which names no type.
        return synthTypeRefTy(subC, tn.pos, sty)
      }
    }
  }
  letType
}

// The links of the `else if` chain headed by the `if` at `ix`, outermost first. A rewriter
// maps each link's condition and then arm in this order, then the last link's else
// (`monoIfChainElse`), and `monoIfChainRebuild` reassembles them — the node order of the
// recursive form, at no stack depth (D1990).
function monoIfChainLinks(ix: i32): i32[] {
  const links: i32[] = []
  let cur = ix
  while cur >= 0 {
    const c = nodeAt(cur)
    const at = cur
    cur = -1
    if c is IfStmt {
      links.push(at)
      if c.ifElse >= 0 && nodeAt(c.ifElse) is IfStmt { cur = c.ifElse }
    }
  }
  links
}

// The else of the chain's last link: a block, or -1 when it has none.
function monoIfChainElse(links: i32[]): i32 {
  const c = nodeAt(links[links.length - 1])
  if c is IfStmt { return c.ifElse }
  -1
}

// Rebuilds the chain innermost-first from each link's rewritten condition and then arm and the
// rewritten tail else `ce`, keeping a link whose parts are all unchanged.
function monoIfChainRebuild(
  links: i32[],
  ccs: i32[],
  cts: i32[],
  ce0: i32,
): i32 {
  let ce = ce0
  let li = links.length - 1
  while li >= 0 {
    const c = nodeAt(links[li])
    if c is IfStmt {
      if ccs[li] == c.ifCond && cts[li] == c.ifThen && ce == c.ifElse {
        ce = links[li]
      } else {
        ce = mkIf(ccs[li], cts[li], ce, c.pos)
        nodeSrcNote(ce, links[li])
        // The rebuilt link answers the join its original did, which a value `if` is typed by.
        const ot = nodeTyIxOf(links[li])
        if ot >= 0 { nodeTyRecord(ce, ot) }
      }
    }
    li = li - 1
  }
  ce
}

// `monoIfChainRebuild` for the per-instance walk: a link whose recorded join names a type
// parameter this instance binds is re-made answering the pinned join, since a value `if`'s
// blocktype is read off that type and the template's names the parameter itself (D2876).
function monoIfChainRebuildPinned(
  links: i32[],
  ccs: i32[],
  cts: i32[],
  ce0: i32,
  bN: string[],
  bT: i32[],
  sink: boolean,
): i32 {
  let ce = ce0
  let li = links.length - 1
  while li >= 0 {
    const at = links[li]
    const c = nodeAt(at)
    if c is IfStmt {
      // Only where every arm's value is the join or one of its members: a hole arm absorbs
      // the checker's join, so a sibling can hold another type (a literal `5`).
      const raw = nodeTyIxOf(at)
      let pty = -1
      // Only a binding the return reads: a sink or a tail re-joins its arms itself. Recorded,
      // not returned: the rebuild goes on and the failure stops the build (D2915).
      // A `??` join over a type parameter pinned narrower than the instance's elaborated join loses
      // a member; the template's join keeps the arm since D14649, so this refusal stays loud (D2915).
      if !sink && monoPinLetReaches && raw >= 0 && raw < T.tys.length {
        const rv = tyAt(raw)
        const pin = monoPinnedTyOf(at, bN, bT)
        const ej = elabNodeTy(at, elabWalkTop())
        if (
          rv is TyVar
          && rv.tvName.length > 0
          && rv.tvName[0] == "?"[0]
          && pin >= 0
          && pin < T.tys.length
          && tyAt(pin) is TyUnion
          && ej >= 0
          && elabTyClosed(ej, 0)
          && !assignable(ej, pin)
        ) {
          emitFail(
            "emitProgram: a join of a `??` with a type parameter drops a member of that parameter at this instance",
          )
        }
      }
      // A join the checker kept apart as `T | C` is read at the pin wherever it goes (D2906), and
      // so is a `??` over one, whose result the checker re-joins without the mark (D3568).
      // The instance's elaborated join, where it is closed and is not the template's own.
      const et = elabNodeTy(at, elabWalkTop())
      if et >= 0 && et != raw && elabTyClosed(et, 0) {
        pty = monoPinUnionBoxed(et, true)
      }
      const retype = pty >= 0
      if (
        ccs[li] == c.ifCond
        && cts[li] == c.ifThen
        && ce == c.ifElse
        && !retype
      ) {
        ce = at
      } else {
        ce = mkIf(ccs[li], cts[li], ce, c.pos)
        nodeSrcNote(ce, at)
        // A link re-made only for its parts answers its template's join, which the pin reads.
        if retype { monoPinRecordTy(ce, pty) }
        else if raw >= 0 { nodeTyRecord(ce, raw) }
      }
    }
    li = li - 1
  }
  ce
}

// `j`, its value-union box registered first when it is a union whose box has a name; a union
// with a record arm is named only when `refArm` (an `if` whose arms have no pinned join).
function monoPinUnionBoxed(j: i32, refArm: boolean): i32 {
  if j < 0 || j >= T.tys.length || !monoTyIsUnionOrNulUnion(j) { return j }
  let name = valueUnionRetName(j)
  // Such a union is named as a binding of it is (`monoRegisterElabJoinRows`).
  if name == "" && refArm && monoTyHoldsRefArm(j) {
    name = monoPinSpellShaped(j)
  }
  if name != "" { monoRegisterPinUnion(name, j) }
  j
}

// The walk type of node `ix` at the instance, where it closes; -1 otherwise.
function monoClosedWalkTy(ix: i32): i32 {
  const w = elabWalkTy(ix)
  if w >= 0 && w < T.tys.length && !tyHasTyVar(w) { w } else { -1 }
}

// The operand children of expression `ix` a copy-on-write rewrite descends into, in the
// order `monoExprRebuild` takes them back. A compound assignment names its target once and
// its value limb, since the target node is shared between the read and the write; a postfix
// `x++` has none. Empty for a leaf and for every statement kind, which the walkers own.
function monoExprKids(ix: i32): i32[] {
  const out: i32[] = []
  if ix < 0 { return out }
  const n = nodeAt(ix)
  match n {
    Call => {
      out.push(n.callFn)
      let ai = 0
      while ai < n.callArgs.length {
        out.push(n.callArgs[ai])
        ai = ai + 1
      }
    }
    BinExpr => {
      out.push(n.binLeft)
      if n.binCompound == "" {
        out.push(n.binRight)
      } else if n.binCompound != "++" && n.binCompound != "--" {
        const inner = nodeAt(n.binRight)
        if inner is BinExpr { out.push(inner.binRight) }
      }
    }
    Unary => {
      if n.unOp != "p+" && n.unOp != "p-" { out.push(n.unArg) }
    }
    Paren => {
      out.push(n.parInner)
    }
    Member => {
      out.push(n.memObj)
    }
    OptMember => {
      out.push(n.omObj)
    }
    Index => {
      out.push(n.idxArr)
      out.push(n.idxIndex)
    }
    IsExpr => {
      out.push(isExprKid(n))
    }
    AsExpr => {
      out.push(n.asObj)
    }
    Spread => {
      out.push(n.spdArg)
    }
    ArrayLit => {
      return n.arrElems
    }
    ObjLit => {
      let fi = 0
      while fi < n.objFields.length {
        const f = nodeAt(n.objFields[fi])
        if f is FieldInit { out.push(f.fiValue) } else { out.push(-1) }
        fi = fi + 1
      }
    }
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | ErrExpr | TypeRef | BreakStmt | ContinueStmt => {
      // A leaf.
    }
    LetDecl | Param | FuncDecl | IfStmt | WhileStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | ForRange | ForIn | MatchExpr | ImportDecl | LoopVar => {
      // A statement, declaration or lambda: the walker that asked owns its children.
    }
  }
  out
}

// Expression `ix` rebuilt over `kids`, parallel to `monoExprKids(ix)`; `ix` itself when no
// child changed. The rebuilt node answers the checked type `ix` did, substituted through the
// instance binding `bN`/`bT`, since its emission reads the recorded type (D2551).
function monoExprRebuild(ix: i32, kids: i32[], bN: string[], bT: i32[]): i32 {
  const old = monoExprKids(ix)
  if old.length != kids.length { return ix }
  let changed = false
  let i = 0
  while i < kids.length {
    if kids[i] != old[i] { changed = true }
    i = i + 1
  }
  if !changed { return ix }
  const nx = monoExprRemake(ix, kids)
  if nx != ix && nx >= 0 && nx < P.nodes.length {
    // Not the store's type: an open pin defers to emit's `scopeTyAt` read, and pinning the
    // store's closed type on the re-made node breaks hole instances (D15259).
    monoPinRecordTy(nx, monoPinnedTyOf(ix, bN, bT))
    const a = nodeAt(nx)
    const o = nodeAt(ix)
    if (
      a is BinExpr
      && o is BinExpr
      && a.binCompound != ""
      && a.binRight != o.binRight
    ) {
      monoPinRecordTy(a.binRight, monoPinnedTyOf(o.binRight, bN, bT))
    }
  }
  nx
}

// Compound assignment `n` reminted over `target` and `value`. Its minted inner operator
// copies `n`'s, so it answers that node's checked type.
function monoRemintCompound(n: BinExpr, target: i32, value: i32): i32 {
  const nc = mkCompoundAssign(n.binCompound, target, value, n.pos)
  if nc < 0 || nc >= P.nodes.length { return nc }
  const a = nodeAt(nc)
  if a is BinExpr {
    nodeTyCarry(a.binRight, n.binRight)
    nodeSrcNote(a.binRight, n.binRight)
  }
  nc
}

// Record `ty` as the type rebuilt node `nx` answers. A nullable scalar spelled nowhere
// (`x.pop()` at `f64`) also gets its box row here, since the pass that registers one from an
// expression's type ran before the pin minted this one.
function monoPinRecordTy(nx: i32, ty: i32) {
  nodeTyRecord(nx, ty)
  const nun = nulNumScalarUnionName(ty)
  if nun != "" { monoRegisterPinUnion(nun, nulNumScalarUnionRowTy(ty)) }
  0
}

// The recorded type of `ix` at the instance binding `bN`/`bT`: substituted where that leaves
// no type variable, else as recorded. -1 when the node has none. Arithmetic over a gradual
// union (`T | i32`) records its concrete view, so the instance's own check answers it.
function monoPinnedTyOf(ix: i32, bN: string[], bT: i32[]): i32 {
  const ty = nodeTyIxOf(ix)
  if ty < 0 || ty >= T.tys.length { return ty }
  // Where this function settles a type, the instance's elaboration of the node answers it when
  // closed (`elabInstNodeTy`); the reads below only decide whether it settles one.
  const wk = elabWalkTop()
  const inst0 = if wk >= 0 { elabInstNodeTy(ix, wk) } else { -1 }
  const inst = if inst0 >= 0 && inst0 < T.tys.length && !tyHasTyVar(inst0) { inst0 } else { -1 }
  if !tyHasTyVar(ty) {
    const an = nodeAt(unwrapParen(ix))
    let arith = an is Unary && an.unOp == "-"
    if an is BinExpr { arith = an.binCompound == "" && binArithOp(an.binOp) }
    if !arith { return ty }
    const et = elabWalkTy(ix)
    if et < 0 || et >= T.tys.length || tyHasTyVar(et) { return ty }
    return if inst >= 0 { inst } else { et }
  }
  // Where mono's pin closes, the elaboration's closed type at the instance answers: its narrowing,
  // else its walk type. A list of numeric literals stays at mono's base list, which `filled`
  // can build (D3540); the list layer keeps a literal union apart from its base (D611).
  const nt = elabWalkNarrowedTy(ix)
  const wt = elabWalkTy(ix)
  let et = if nt >= 0 && nt < T.tys.length && !tyHasTyVar(nt) { nt } else { -1 }
  if et < 0 && wt >= 0 && wt < T.tys.length && !tyHasTyVar(wt) { et = wt }
  const ea = if et >= 0 { tyAt(et) } else { null }
  const eu = if ea is TyArray && ea.aElem >= 0 { tyAt(ea.aElem) } else { null }
  if eu is TyUnion {
    let lits = eu.uMembers.length > 0
    for m in eu.uMembers {
      const mt = tyAt(m)
      if !(mt is TyLit) || mt.litKind == "str" { lits = false }
    }
    if lits { et = -1 }
  }
  // An `is` else over a type parameter's list reads its remainder at the instance (`mkTvElseRemTy`);
  // with no closed remainder there the program is refused rather than read unsubtracted.
  if tvElseBase.get(ty) != null {
    if et >= 0 { return if inst >= 0 { inst } else { et } }
    emitFail(
      "monoPinnedTyOf: an `is` else's remainder has no closed type at this instance",
    )
    return ty
  }
  let st = monoSubstInst(ty, bN, bT)
  // A read the instance narrowed is typed at its narrowing, not at its storage's substitution.
  if st >= 0 && !tyHasTyVar(st) && et >= 0 {
    return if inst >= 0 { inst } else { et }
  }
  if (st < 0 || tyHasTyVar(st)) && monoPinHoleN.length > 0 {
    // A hole instance's list literal, element read and call of a function value are typed at
    // its holes, which `bN` does not name (D3066): the instance's elaboration answers, and the
    // holes' binding where it has none. A method's result is the receiver's to answer.
    const hn = nodeAt(unwrapParen(ix))
    let byHole = hn is ArrayLit || hn is Index
    if hn is Call { byHole = monoCallsFnValue(unwrapParen(ix), 0) }
    if byHole {
      st = elabWalkTy(ix)
      if st < 0 {
        const jN: string[] = []
        const jT: i32[] = []
        monoJoinBinding(bN, bT, monoPinHoleN, monoPinHoleT, jN, jT)
        st = monoSubstInst(ty, jN, jT)
      }
      // A record list's rows are the literal's own, which a pin re-type does not collect.
      if monoListElemHoldsObj(st) { return ty }
    }
  }
  if st < 0 || tyHasTyVar(st) { return ty }
  if inst >= 0 { inst }
  else if et >= 0 { et }
  else { st }
}

// Whether call `ix` calls a function value: a name, or a call of one (`k()()`), typed as a
// function. A method call is not one.
function monoCallsFnValue(ix: i32, depth: i32): boolean {
  if ix < 0 || depth > 8 { return false }
  const n = nodeAt(ix)
  if !(n is Call) { return false }
  const cf = unwrapParen(n.callFn)
  if cf < 0 { return false }
  const cft = nodeTyIxOf(cf)
  if cft < 0 || cft >= T.tys.length || !(tyAt(cft) is TyFunc) { return false }
  if nodeAt(cf) is Ident { return true }
  monoCallsFnValue(cf, depth + 1)
}

// Whether list type `t`'s element is a record, nullable or as a union member.
function monoListElemHoldsObj(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const lt = tyAt(t)
  if !(lt is TyArray) { return false }
  const e = nonNullTy(lt.aElem)
  if e < 0 || e >= T.tys.length { return false }
  if monoTyIsObj(e) { return true }
  const et = tyAt(e)
  if !(et is TyUnion) { return false }
  let i = 0
  while i < et.uMembers.length {
    if monoTyIsObj(et.uMembers[i]) { return true }
    i = i + 1
  }
  false
}

// Whether `t` is a record type.
function monoTyIsObj(t: i32): boolean {
  t >= 0 && t < T.tys.length && tyAt(t) is TyObj
}

// A fresh node for expression `ix` over `kids` (parallel to `monoExprKids(ix)`), or `ix`
// for a kind it cannot remake. It answers the narrowing retirements `ix` did (D2390's banks)
// and the narrowings it read under.
// Records no type: the caller decides which one the new node answers.
function monoExprRemake(ix: i32, kids: i32[]): i32 {
  const nx = monoExprMake(ix, kids)
  if nx != ix {
    nodeSrcNote(nx, ix)
    recordClonedCallRetire(ix, nx)
    narrowedFromTyCopy(ix, nx)
    elabNarrowedCarry(ix, nx)
  }
  monoKeepTplHole(ix, nx)
  nx
}

// A copy of call `ix` with callee `callee` and arguments `args`, keeping its argument names
// and position, which resolves its member target and overload set as `ix` does (D4030).
// Every per-instance copy of a call is made here.
function monoRemintCall(ix: i32, callee: i32, args: i32[]): i32 {
  const n = nodeAt(ix)
  if n is Call {
    const nc = ufcsSiteCarry(mkCallN(callee, args, n.callArgNames, n.pos), ix)
    monoNoteCallTpl(ix, nc)
    nodeSrcNote(nc, ix)
    return nc
  }
  -1
}

// `monoRemintCall` for a pass that rewrites only the call's parts: the copy answers the
// template's type, so it carries the type recorded on `ix`.
function monoRemintCallTpl(ix: i32, callee: i32, args: i32[]): i32 {
  const nc = monoRemintCall(ix, callee, args)
  nodeTyCarry(nc, ix)
  nc
}

// A list literal a pass re-makes for its items alone: the copy answers the template's type, so
// it carries the type recorded on `ix`.
function monoRemakeListLitTpl(ix: i32, es: i32[], pos: i32): i32 {
  const nx = monoCopyOf(ix, mkArrayLit(es, pos))
  nodeTyCarry(nx, ix)
  nx
}

// `monoExprRemake`'s node maker. A call keeps its explicit type arguments, and an `is` its
// banked row.
function monoExprMake(ix: i32, kids: i32[]): i32 {
  const n = nodeAt(ix)
  match n {
    Ident => {
      return monoCopyOf(ix, mkIdent(n.identName, n.pos))
    }
    Call => {
      const args: i32[] = []
      let ai = 1
      while ai < kids.length {
        args.push(kids[ai])
        ai = ai + 1
      }
      const nc = monoRemintCall(ix, kids[0], args)
      const tas = callTyArgsOf(ix)
      if tas.length > 0 { setCallTyArgs(nc, tas, callTyArgEndsOf(ix)) }
      return nc
    }
    BinExpr => {
      if n.binCompound == "++" || n.binCompound == "--" {
        return mkPreIncr(n.binCompound, kids[0], n.pos)
      }
      if n.binCompound != "" {
        // A compound whose right side a rewrite respelled from `target op value` offers no value
        // kid (`monoExprKids`), so it is kept as it is (D3993).
        if kids.length < 2 { return ix }
        return monoRemintCompound(n, kids[0], kids[1])
      }
      const nb = mkBinary(n.binOp, kids[0], kids[1], n.pos)
      if n.binRegion != 0 { markArithRegion(nb) }
      nodeSrcNote(nb, ix)
      return nb
    }
    Unary => {
      const nu = mkUnary(n.unOp, kids[0], n.pos)
      nodeSrcNote(nu, ix)
      return nu
    }
    Paren => {
      return mkParen(kids[0], n.pos)
    }
    Member => {
      return mkMember(kids[0], n.memProp, n.pos)
    }
    OptMember => {
      return mkOptMember(kids[0], n.omProp, n.omDot, n.pos)
    }
    Index => {
      const ni = mkIndex(kids[0], kids[1], n.pos)
      nodeSrcNote(ni, ix)
      return ni
    }
    IsExpr => {
      return monoReIsExpr(ix, kids[0])
    }
    AsExpr => {
      const na = mkAsExpr(kids[0], n.asTy, n.asMode, n.pos)
      nodeSrcNote(na, ix)
      return na
    }
    Spread => {
      return mkSpread(kids[0], n.pos)
    }
    ArrayLit => {
      return monoCopyOf(ix, mkArrayLit(kids, n.pos))
    }
    ObjLit => {
      const fs: i32[] = []
      let fi = 0
      while fi < n.objFields.length {
        let nf = n.objFields[fi]
        const f = nodeAt(nf)
        if f is FieldInit {
          if kids[fi] != f.fiValue {
            nf = mkFieldInit(f.fiName, kids[fi], f.pos)
          }
        }
        fs.push(nf)
        fi = fi + 1
      }
      return monoCopyOf(ix, mkObjLit(fs, n.pos))
    }
    // no other kind offers `monoExprKids` a kid, so none is remade
    NumLit | StrLit | CharLit | BoolLit | NullLit | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | IfStmt | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Block | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | ForRange | ForIn | MatchExpr | ImportDecl | LoopVar => {}
  }
  ix
}

// Clone a monomorphized instance's body, substituting every `LetDecl` type-param
// annotation through the binding. Only the statement spine is rebuilt; every leaf
// expression, a nested lambda included, is shared, so no new function node is created.
// Returns the same node index when nothing in the subtree changed.
function monoCloneBody(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  const r = monoCloneBodyRaw(ix, typarams, tvN, tvV, bN, bT)
  // A rebuilt statement keeps the narrowings its original's calls ended (D2390).
  if r != ix { recordClonedCallRetire(ix, r) }
  monoKeepTplHole(ix, r)
  monoNoteCallTpl(ix, r)
  r
}

// The template call each cloned call copies, followed back to the first, so a clone reads the
// checker's binding of the call it stands for (D6743).
let monoCallTpl: {[i32]: i32} = Map()

function monoNoteCallTpl(ix: i32, nx: i32) {
  if nx != ix && ix >= 0 && nx >= 0 && nodeAt(nx) is Call {
    monoCallTpl[nx] = monoCallTplOf(ix)
    const cn = nodeAt(ix)
    const tSet = if cn is Call { monoTagSetAt(ix, cn.callFn) } else { -1 }
    let tArms = fnTagArmsAt(ix, tSet)
    if tArms.length == 0 { tArms = fnTagArmsAt(monoCallTplOf(ix), tSet) }
    if tArms.length > 0 && fnTagCallArms(nx).length == 0 {
      fnTagCallCopy(nx, ix, tSet, tArms)
    }
  }
  0
}

// The call whose bind row answers for call `ix`: `ix`, or the template a clone of it copies.
function monoCallTplOf(ix: i32): i32 {
  const t = monoCallTpl[ix] ?? ix
  // An operator's dispatch call answers from the operator node the checker bound.
  const o = drwOpCallOrigin(t)
  if o >= 0 { o } else { t }
}

// A rebuilt interpolation hole stays one, which is what renders an atom by its member (D2984).
function monoKeepTplHole(ix: i32, nx: i32) {
  if nx != ix && nx >= 0 && nodeIsTplHole(ix) { mkTplHole(nx) }
  0
}

// Registers the box of each kept-apart join an instance types as a value union, read off the
// elaboration's per-instance types, so a function no instance clones (nested in one) has its
// join's rep too (D4046).
function monoRegisterElabJoinRows() {
  for ix in elabNodeTys.keys() {
    const t = if ix >= 0 && ix < P.nodes.length { nodeTyIxOf(ix) } else { -1 }
    // An if-join the checker kept apart (D2832) is a union of lists at an instance that binds
    // its arms apart, one row per such union unless the lists share one rep.
    const apart = (tpIfJoinAt.get(ix) ?? -1) >= 0
    // A template `??` whose own type is no union can still join to one at an instance, a join
    // that exists only at the instance.
    let coal = false
    if t >= 0 {
      const ce = nodeAt(ix)
      if ce is BinExpr {
        coal = ce.binOp == "??" && !monoTyIsUnionOrNulUnion(t)
      }
      // So can a field read whose receiver is a union only at the instance, when its members hold
      // the field as two records (`a.h` with `a` bound to `K | J`).
      if ce is Member { coal = !monoTyIsUnionOrNulUnion(t) }
    }
    if (t >= 0 && tyIsTpJoinUnion(t)) || apart || coal {
      const ps = elabNodeTys[ix] ?? []
      let i = 1
      while i < ps.length {
        const st = ps[i]
        const closed = st >= 0 && st < T.tys.length && !tyHasTyVar(st)
        if (
          closed
          && apart
          && tyUnionAllLists(st)
          && listUnionSharedRep(st) < 0
        ) {
          let name = tpIfJoinPinName(st)
          if name == "" { name = monoListUnionRowName(st) }
          if name != "" { monoRegisterPinUnion(name, st) }
        } else if (
          closed
          && t >= 0
          && (tyIsTpJoinUnion(t) || coal)
          && monoTyIsUnionOrNulUnion(st)
        ) {
          let nm = monoPinSpellShaped(st)
          // A literal union is spelled by its alias, whose rep is the atom; its render is `string`.
          if tyIsLitUnion(nonNullTy(st)) { nm = monoI32AtomPinName(st) }
          if nm != "" { monoRegisterPinUnion(nm, st) }
        }
        i = i + 2
      }
    }
  }
  0
}

// Whether node `ix` is a `??` whose instance type `st` is a union its template type `t` is not,
// a join that exists only at the instance.
// Whether `t` is a union or a nullable union, the two shapes a value-union box holds; a
// nullable literal union is a niche, not a box.
function monoTyIsUnionOrNulUnion(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const tt = tyAt(t)
  if tt is TyNullable {
    const inr = tt.nInner
    return inr >= 0
      && inr < T.tys.length
      && tyAt(inr) is TyUnion
      && !tyIsLitUnion(inr)
      && !monoTyAllStringy(inr)
  }
  tt is TyUnion
}

// Whether every member of union `u` is a string literal or a literal union: its nullable is
// the `string | null` niche, not a box.
function monoTyAllStringy(u: i32): boolean {
  const ms: i32[] = []
  flattenVariantsInto(u, ms)
  for m in ms {
    if m < 0 || m >= T.tys.length { return false }
    const mt = tyAt(m)
    let s = tyIsLitUnion(m)
    if mt is TyLit { s = mt.litKind == "str" }
    if !s { return false }
  }
  true
}

// Registers the box of list literal `ix`'s element at its pinned list type `pty` when its template
// element is a join the checker kept apart, so the build finds the box row: 0, or -1 on failure.
function monoTpJoinListElemBox(ix: i32, pty: i32): i32 {
  const t = nodeTyIxOf(ix)
  if t < 0 || t >= T.tys.length || pty < 0 || pty >= T.tys.length { return 0 }
  const tt = tyAt(t)
  if !(tt is TyArray) || !tyIsTpJoinUnion(tt.aElem) { return 0 }
  const pl = tyAt(pty)
  if !(pl is TyArray) || pl.aElem < 0 { return 0 }
  if !(tyAt(pl.aElem) is TyUnion) || tyIsLitUnion(pl.aElem) { return 0 }
  const en = valueUnionRetName(pl.aElem)
  if en == "" { return 0 }
  monoRegisterPinUnion(en, pl.aElem)
}

function monoCloneBodyRaw(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  if ix < 0 { return ix }
  const n = nodeAt(ix)
  match n {
    Block => {
      const ns: i32[] = []
      let changed = false
      let i = 0
      while i < n.blkStmts.length {
        const cs = monoCloneBody(n.blkStmts[i], typarams, tvN, tvV, bN, bT)
        ns.push(cs)
        if cs != n.blkStmts[i] { changed = true }
        i = i + 1
      }
      if !changed { return ix }
      return mkBlock(ns, n.pos)
    }
    LetDecl => {
      return monoCloneLetDecl(n, ix, typarams, bN, bT)
    }
    WhileStmt => {
      const cb = monoCloneBody(n.whileBody, typarams, tvN, tvV, bN, bT)
      if cb == n.whileBody { return ix }
      return mkWhileAs(n, n.whileCond, cb)
    }
    IfStmt => {
      return monoCloneIfChain(ix, typarams, tvN, tvV, bN, bT)
    }
    ForRange => {
      const cb = monoCloneBody(n.frBody, typarams, tvN, tvV, bN, bT)
      if cb == n.frBody { return ix }
      return mkForRange(
        n.frVar,
        n.frFrom,
        n.frTo,
        n.frStep,
        n.frExcl,
        cb,
        n.frLabel,
        n.pos,
      )
    }
    ForIn => {
      const cb = monoCloneBody(n.fiBody, typarams, tvN, tvV, bN, bT)
      if cb == n.fiBody { return ix }
      return mkForInCopy(n, n.fiIter, cb)
    }
    RetStmt => {
      // The return value may be a block or `if` expression carrying its own `LetDecl`s.
      const ca = monoCloneBody(n.retArg, typarams, tvN, tvV, bN, bT)
      const cl = if ca == n.retArg { monoRetBoundLitCopy(ca) } else { ca }
      if cl == n.retArg { return ix }
      return mkReturn(cl, n.pos)
    }
    Paren => {
      const ci = monoCloneBody(n.parInner, typarams, tvN, tvV, bN, bT)
      if ci == n.parInner { return ix }
      return mkParen(ci, n.pos)
    }
    // a pure expression or other statement carries no `LetDecl` annotation to rewrite: share
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Call | Member | OptMember | ErrExpr | Param | TypeRef | FuncDecl | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  ix
}

// The instance's own copy of returned list literal `x` when it is open at a function and every
// element reads a binding, which the instance's walk records at the bindings' types; `x` otherwise.
function monoRetBoundLitCopy(x: i32): i32 {
  if x < 0 || x >= P.nodes.length { return x }
  const lx = unwrapParen(x)
  if lx < 0 || lx >= P.nodes.length { return x }
  const l = nodeAt(lx)
  if !(l is ArrayLit) || l.arrElems.length == 0 { return x }
  const t = nodeTyIxOf(lx)
  if !monoTyOpen(t) || !tyMayHoldFn(t, 0) { return x }
  for e in l.arrElems {
    const ex = unwrapParen(e)
    if ex < 0 || !(nodeAt(ex) is Ident) { return x }
  }
  const cx = monoCopyOf(lx, mkArrayLit(l.arrElems, l.pos))
  nodeTyRecord(cx, t)
  cx
}

// Annotation `nt` of binding `n` at `ix` in the instance being walked, or, for a binding a
// desugar minted (`$`-named), the elaboration's type for it where that closes the template's
// union to one non-union type. A union stays spelled as `nt`, which keeps its declared rows.
function monoMintedLetAnn(n: LetDecl, ix: i32, nt: i32): i32 {
  if nt < 0 || n.letName.slice(0, 1) != "$" { return nt }
  const et = elabWalkTy(ix)
  if et < 0 || et >= T.tys.length || tyHasTyVar(et) || et == nodeTyIxOf(nt) {
    return nt
  }
  if tyIsUnionish(et) || !tyIsUnionish(nodeTyIxOf(nt)) { return nt }
  synthTypeRefOfTy(et, -1)
}

// `monoCloneBodyRaw`'s arm for the binding `n` at `ix`: its instance annotation.
function monoCloneLetDecl(
  n: LetDecl,
  ix: i32,
  typarams: string[],
  bN: string[],
  bT: i32[],
): i32 {
  const nt = monoMintedLetAnn(
    n,
    ix,
    monoSubstLetType(ix, n.letType, typarams, bN, bT),
  )
  if nt == n.letType { return ix }
  const ninit = monoCtorInitCopy(n.letInit, nt)
  return monoCopyOf(ix, mkLet(n.letKw, n.letName, nt, ninit, n.pos))
}

// A `Map()` or `Set()` initialiser of a binding this instance annotates `nt` is re-made at that
// annotation's map type, so the constructor builds the map its receivers read; else `initIx`.
function monoCtorInitCopy(initIx: i32, nt: i32): i32 {
  if initIx < 0 || initIx >= P.nodes.length || nt < 0 { return initIx }
  const ix = unwrapParen(initIx)
  if ix < 0 || ix >= P.nodes.length { return initIx }
  const c = nodeAt(ix)
  if !(c is Call) || c.callArgs.length != 0 || c.callFn < 0 { return initIx }
  const f = nodeAt(c.callFn)
  if (
    !(f is Ident)
    || (f.identName != "Map" && f.identName != "Set")
    || identDeclOf(c.callFn) >= 0
  ) {
    return initIx
  }
  const t = nodeTyIxOf(nt)
  if t < 0 || t >= T.tys.length || tyHasTyVar(t) || !(tyAt(t) is TyMap) {
    return initIx
  }
  const nx = monoCopyOf(ix, mkCall(c.callFn, c.callArgs, c.pos))
  nodeTyRecord(nx, t)
  nx
}

// `monoCloneBodyRaw`'s arm for the `if` chain at `ix`.
function monoCloneIfChain(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
): i32 {
  // An `else if` chain is rewritten along its spine, so its depth costs no stack (D1990).
  const links = monoIfChainLinks(ix)
  const ccs: i32[] = []
  const cts: i32[] = []
  let k = 0
  while k < links.length {
    const c = nodeAt(links[k])
    if c is IfStmt {
      ccs.push(c.ifCond)
      cts.push(monoCloneBody(c.ifThen, typarams, tvN, tvV, bN, bT))
    }
    k = k + 1
  }
  return monoIfChainRebuild(
    links,
    ccs,
    cts,
    monoCloneBody(monoIfChainElse(links), typarams, tvN, tvV, bN, bT),
  )
}

// The closed element type the elaboration gives receiver `recvIx` at the instance being walked,
// where the receiver is (a paren around) a reference to one of the parameters `pNames`; -1 for any
// other receiver or an open element.
function monoRecvParamElemTy(recvIx: i32, pNames: string[]): i32 {
  const r0 = unwrapParen(recvIx)
  if r0 < 0 || r0 >= P.nodes.length { return -1 }
  const r = nodeAt(r0)
  if !(r is Ident) || !strListHas(pNames, r.identName) { return -1 }
  const t = elabNodeTy(r0, elabWalkTop())
  if t < 0 || t >= T.tys.length { return -1 }
  const a = tyAt(t)
  if !(a is TyArray) || a.aElem < 0 || tyHasTyVar(a.aElem) { return -1 }
  a.aElem
}

// The element an `is K[]` arm reads its receiver `recvIx` at, when the instance pinned that
// receiver's element to `pinEl`, which can never be `K`'s: the arm reads an empty `K[]` in its
// place (D4993). -1 when the read is the receiver's own list.
function monoFitArmElem(recvIx: i32, pinEl: i32): i32 {
  if pinEl < 0 { return -1 }
  const t = nodeTyIxOf(unwrapParen(recvIx))
  if t < 0 || t >= T.tys.length || tyHasTyVar(t) { return -1 }
  const a = tyAt(t)
  if !(a is TyArray) || !tyLeavesDisjoint(pinEl, a.aElem) { return -1 }
  a.aElem
}

// The name a callback parameter pinned at arm element `el` is annotated with: a record's
// interned row, a primitive's own name, or "" where `el` is -1 or neither.
function monoFitArmElemName(el: i32): string {
  if el < 0 || el >= T.tys.length { return "" }
  if tyAt(el) is TyObj { return monoRetRowName(el) }
  tyPrimNameOf(el) ?? ""
}

// Clone an inline `.map`/`.filter` callback lambda with its single un-annotated parameter
// pinned to `elemType`, lift the clone into `fnStmts`, and return its node index — or -1
// when the argument is not a cloneable un-annotated 1-param lambda. The body is shared:
// the emitter re-derives every operand type from the now-concrete parameter per function.
function monoCloneLambdaPinned(argIx: i32, elemType: string, elemTyIx: i32) {
  const a = nodeAt(unwrapParen(argIx))
  if a is FuncDecl {
    if a.fnParams.length == 1 {
      const p0 = nodeAt(a.fnParams[0])
      if p0 is Param {
        if p0.parType < 0 {
          const np = mkParam(
            p0.parName,
            synthTypeRefTy(elemType, -1, elemTyIx),
            p0.parDefault,
            p0.parOpt,
            p0.parRest,
            p0.pos,
          )
          identFrom(np, a.fnParams[0])
          const nm = "__lambda_" + i32ToStr(lambdaCtr)
          lambdaCtr = lambdaCtr + 1
          const noTP: string[] = []
          const ps: i32[] = [np]
          const clone = mkFunc(nm, noTP, ps, a.fnRet, a.fnBody, a.pos)
          recordClonedCallRetire(unwrapParen(argIx), clone)
          fnTagLeafCarry(clone, unwrapParen(argIx))
          voidCtxLambdaCarry(clone, unwrapParen(argIx))
          fnStmts.push(clone)
          fnParent.push(-1)
          // The row records the callback at the signature its element type closes, in the
          // instance whose body is walked.
          if !cadInBaked {
            const pinSlot = fnStmts.length - 1
            const pinSig = monoCadSigOf(
              pinSlot,
              [elemTyIx],
              monoCadCheckedRet(unwrapParen(argIx)),
            )
            monoCadRowWrite(
              elabSrcDecl(unwrapParen(argIx)),
              cadInstTop(),
              pinSig,
              pinSlot,
            )
          }
          fnDispNames.push("")
          fnValUsed = true
          fnNestUsed = true
          return clone
        }
      }
    }
  }
  -1
}

// ── a lambda declared inside a generic body is a template (D426) ─────────────

// `collectFns` runs before `monomorphize` and lifts `const g = (x: T[]) => …` once, with
// the enclosing function's `T` still on its parameters, so one lifted slot serves every
// instance at the unsubstituted type. The two sites below close that: substitute at the
// pin, and stop emitting the template (the prune at the end of `monomorphize`).

// One annotation node, substituted through this instance's binding: a fresh `TypeRef` spelled
// from the substituted type (`T[]` → `f64[]`), -1 for an absent or concrete annotation, or -2
// for one naming a type parameter this instance substitutes no new type for.
function monoSubstAnnNode(
  pty: i32,
  typarams: string[],
  bN: string[],
  bT: i32[],
) {
  if pty < 0 { return -1 }
  const tn = nodeAt(pty)
  if tn is TypeRef {
    if monoAnnHasTyParam(pty, -1, typarams) {
      let sty = -1
      const orig = nodeTyIxOf(pty)
      if orig >= 0 {
        const s2 = monoSubstInst(orig, bN, bT)
        if s2 >= 0 && s2 != orig {
          if !tyHasTyVar(s2) { sty = s2 }
        }
      }
      // Else the instance's own binding types it.
      if sty < 0 { sty = monoInstBindTyOf(orig) }
      // -2, not -1: the annotation does name a type parameter and no new type substitutes
      // for it, which the caller must tell apart from an already-concrete one.
      if sty < 0 { return -2 }
      const sub = monoPinSpellShaped(sty)
      if sub == "" { return -2 }
      return synthTypeRefTy(sub, tn.pos, sty)
    }
  }
  -1
}

function monoNoteLamNode(xs: i32[], v: i32) {
  if !i32ListHas(xs, v) { xs.push(v) }
  0
}

// D1116 — the lifted slots minted while walking one lambda's body belong to that lambda's
// clone, not to the enclosing instance: a nested clone's free names resolve up the chain
// through the lambda that encloses it, and `captureValKind` types an env field by that
// chain. Re-point the run from `mark` on, then retire each entry so nothing undoes it.
function monoReparentNestedLams(mark: i32, parentSlot: i32) {
  let k = mark
  let wrote = false
  while k < monoLamMintedSlots.length {
    const s = monoLamMintedSlots[k]
    if s >= 0 && s < fnParent.length {
      buildFnMapNoteFnSlotWrite()
      fnParent[s] = parentSlot
      wrote = true
    }
    monoLamMintedSlots[k] = -1
    k = k + 1
  }
  if wrote { invalidateFnChildIndex() }
  0
}

// The lexical frame a lifted function's slot records (`fnParent`), found from its arena node.
// -1 when the node holds no lifted slot, which is the value `collectFns` itself pushes for a
// module-scope lift.
function monoLamParentOf(fnIx: i32) {
  let i = 0
  while i < fnStmts.length {
    if fnStmts[i] == fnIx {
      if i < fnParent.length { return fnParent[i] }
      return -1
    }
    i = i + 1
  }
  -1
}

// A synthesized annotation for un-annotated parameter `pi` of lambda `fnIx`, at the instance
// binding `bN`/`bT`: its inferred type substituted, where that names the type parameter and
// leaves none. -1 for an annotated parameter or one whose type needs no pin.
function monoLamParamPinAnn(
  fnIx: i32,
  pi: i32,
  parType: i32,
  bN: string[],
  bT: i32[],
) {
  if parType >= 0 { return -1 }
  const lty = nodeTyIxOf(fnIx)
  if lty < 0 || lty >= T.tys.length { return -1 }
  const lt = tyAt(lty)
  if lt is TyFunc {
    if pi >= lt.fnParamTypes.length { return -1 }
    const pty = lt.fnParamTypes[pi]
    if pty < 0 || !tyHasTyVar(pty) { return -1 }
    let st = monoSubstInst(pty, bN, bT)
    // A type variable of another declaration (the generic initializing the binding) is
    // pinned by the elaboration's typing of the lambda in this instance (D7181).
    if st >= 0 && tyHasTyVar(st) {
      st = elabLamParamTy(fnIx, pi, lt.fnParamTypes.length)
    } else if st >= 0 {
      // Where the binding pins it, the elaboration's type for the parameter at this instance;
      // the binding's only where it has none (a hole function of a tagged set, at its index).
      const et = elabLamInstParamTy(fnIx, pi, lt.fnParamTypes.length)
      if et >= 0 { st = et }
    }
    if st < 0 || tyHasTyVar(st) || !tyIsEmitRepresentable(st) { return -1 }
    return synthTypeRefOfTy(st, -1)
  }
  -1
}

// The annotation spelling of a pinned lambda type `t`: a list by `monoListSpelling`, which names
// a nullable record element by its row; a literal union by its alias (D3098); any other type by
// the naming rule (`monoPinSpellOf`).
function monoPinAnnSpelling(t: i32): string {
  // A record bound apart from its row by a function field's type is still spelled by the row.
  const tw = monoFnFieldTwinRow.get(t) ?? ""
  if tw != "" { return tw }
  if tyIsLitUnion(t) {
    const ln = litUnionAliasNameOfTy(t)
    if ln != "" && monoAnnPinName(ln, t) == ln { return ln }
  }
  const nm = monoPinSpellOf(t)
  if nm != "" && t >= 0 && t < T.tys.length && tyAt(t) is TyArray {
    return monoListSpelling(nm, t)
  }
  nm
}

// Clone the lifted lambda at `fnIx` with every type-param-mentioning parameter and return
// annotation substituted through this instance's binding, lift the clone into `fnStmts`,
// and return its node index — or -1 when nothing substitutes. The body is shared with the
// original: the emitter re-derives every operand type from the now-concrete parameter.
function monoCloneLambdaSubst(
  fnIx: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN0: string[],
  bT0: i32[],
) {
  const a = nodeAt(fnIx)
  if a is FuncDecl {
    let bN = bN0
    let bT = bT0
    if monoPinHoleN.length > 0 {
      bN = []
      bT = []
      monoJoinBinding(bN0, bT0, monoPinHoleN, monoPinHoleT, bN, bT)
    }
    // A lambda the elaboration keyed under this instance takes that key's pins too (M5).
    const lN: string[] = []
    const lT: i32[] = []
    if elabLamPinsUnderWalk(elabSrcDecl(fnIx), lN, lT) {
      const jN: string[] = []
      const jT: i32[] = []
      monoJoinBinding(bN, bT, lN, lT, jN, jT)
      bN = jN
      bT = jT
    }
    // A nested generic declaration carries pins of its own and is instantiated by
    // `monoInstantiate` at its own call sites; only a lambda that inherited the enclosing
    // frame's type parameters is this pass's business.
    if a.fnTyParams.length > 0 { return -1 }
    // Not a template at all — every annotation is concrete, so one lifted function is
    // correct at every pin. Returned before either ledger is touched: the prune reads them
    // to decide whether a template is still referenced, and a lambda that never became a
    // template must not appear in either.
    if !monoLamNodeIsTemplateCore(fnIx, typarams) { return -1 }
    const ps: i32[] = []
    const psAny = monoLamSubstParams(a, fnIx, typarams, bN, bT, ps)
    if psAny < 0 { return -1 }
    let any = psAny > 0
    let nret = a.fnRet
    const rt = monoSubstAnnNode(a.fnRet, typarams, bN, bT)
    if rt >= 0 {
      nret = rt
      any = true
    } else if rt == -2 {
      monoNoteLamNode(monoLamShared, fnIx)
      return -1
    }
    // D943 — `any` asks whether a signature changed, and a capture-only template changes
    // none. The clone still has to happen: its purpose here is a fresh lifted slot, since
    // `fnEnvIdx` is parallel to `fnStmts` and one slot means one env struct for every
    // instance. `() => string` capturing a `T` substitutes nothing and needs its own env.
    let capOnly = false
    if !any {
      const feC = monoSlotOfLamNode(fnIx)
      if feC >= 0 {
        if captureCountOf(feC) > 0 { capOnly = true }
      }
    }
    // D1220 — a body spelling is the third reason to clone, and the two rungs above read
    // only the signature: `() => gv is T` takes no parameter, annotates no return and
    // captures nothing. Sharing one body then answers the first pin's spelling at every
    // pin. `monoLamNodeIsTemplate`'s fourth rung asks the same question and must agree.
    let bodyTP = false
    if !any && !capOnly {
      if monoNodeNamesTyParam(a.fnBody, typarams) { bodyTP = true }
    }
    if !any && !capOnly && !bodyTP {
      monoNoteLamNode(monoLamShared, fnIx)
      return -1
    }
    // An un-annotated return that rides the type parameter, annotated at the pin. The
    // checker records an anonymous lambda's inferred return under its node index and the
    // clone is a node it never saw, so the return expression's own recorded type is the
    // fact, substituted through the same binding. Gated on the type carrying a variable.
    if nret < 0 {
      nret = monoLamPinRetAnn(fnIx, nret)
      if nret == -2 { return -1 }
    }
    // D1046 — a nested named function keeps its name. An anonymous lambda is reached
    // through the value the clone is written into, so a minted `__lambda_N` is invisible;
    // a nested `function id(a: T): T` is reached by name through the frame chain, and
    // renaming it would leave every call in the instance body resolving to nothing.
    let nm = a.fnName
    if !monoFnNameIsSourceNamed(nm) {
      nm = "__lambda_" + i32ToStr(lambdaCtr)
      lambdaCtr = lambdaCtr + 1
    }
    const noTP: string[] = []
    // D951 — an `is T` inside the lambda's body. The body is otherwise shared with the
    // template, which is right for every operand the emitter re-derives from the
    // now-concrete parameter and wrong for an `is`, whose check type is a spelling the
    // body carries. Copy-on-write, so a lambda with no such spelling keeps sharing.
    const nbodyF = monoFoldTyParamLayout(a.fnBody, typarams, tvN, tvV)
    // D1116 — a lambda nested inside this one is a template too, and `monoPinBodyLambdas`
    // walks only the instance body's spine, stopping at a `FuncDecl` initializer.
    // Recursing here rather than teaching that walk a `FuncDecl` arm keeps the two facts a
    // clone owns together: the body substitution above and the frame its clones hang off.
    const mark = monoLamMintedSlots.length
    const nbodyL = monoPinBodyLambdas(nbodyF, typarams, tvN, tvV, bN, bT)
    // A generic call in the body is instantiated by rewriting its callee in place, so each
    // clone takes its own copy, as an instance body does (D2553).
    const nbody = monoLamCloneGenericCalls(nbodyL, typarams, tvN, tvV)
    // The lambda twin of the named clone's rule: a bare `return` in the body is void, so the
    // return-expression pin above must not give this instance a result (D1600).
    let cloneRet = nret
    if a.fnRet < 0 && blockHasBareReturn(a.fnBody) { cloneRet = -1 }
    const clone = mkFunc(nm, noTP, ps, cloneRet, nbody, a.pos)
    monoLamCloneTmpl[clone] = fnIx
    // The clone is a value too, typed at this pin where the template's type substitutes.
    const cty = monoPinnedTyOf(fnIx, bN, bT)
    // Where the pin leaves it open, the elaboration's closed type for the template under the walk.
    const wk = elabWalkTop()
    const ety = if cty >= 0 && !tyHasTyVar(cty) { cty } else if wk >= 0 { elabNodeTy(fnIx, wk) } else { -1 }
    if (
      ety >= 0
      && ety < T.tys.length
      && !tyHasTyVar(ety)
      && (ety == cty || elabTyClosed(ety, 0))
    ) {
      nodeTyRecord(clone, ety)
    }
    // A lifted clone answers what its template did, the captures it widened included (D2402).
    recordClonedCallRetire(fnIx, clone)
    return monoLamInstallClone(a, fnIx, clone, mark)
  }
  -1
}

// `monoCloneLambdaSubst`'s body step: copies the direct generic calls in `nbodyL` for this
// instance (`typarams`/`tvN`/`tvV`), then restores the enclosing copy's
// state. Returns the copied body, or `nbodyL` when it makes no generic call.
function monoLamCloneGenericCalls(
  nbodyL: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
) {
  const svCgcP = monoCgcTyParams
  const svCgcN = monoCgcTvN
  const svCgcV = monoCgcTvV
  monoCgcTyParams = typarams
  monoCgcTvN = tvN
  monoCgcTvV = tvV
  const nbody = monoCloneGenericCalls(nbodyL)
  monoCgcTyParams = svCgcP
  monoCgcTvN = svCgcN
  monoCgcTvV = svCgcV
  nbody
}

// `monoCloneLambdaSubst`'s parameter step: appends to `ps` each parameter of the lambda `a` at
// `fnIx`, substituted through this instance where its annotation or inferred type rides a type
// parameter. Returns 1 when one changed, 0 when none did, and -1, after noting the template
// shared, when one cannot be substituted.
function monoLamSubstParams(
  a: FuncDecl,
  fnIx: i32,
  typarams: string[],
  bN: string[],
  bT: i32[],
  ps: i32[],
) {
  let any = 0
  let i = 0
  while i < a.fnParams.length {
    const p = nodeAt(a.fnParams[i])
    if p is Param {
      const nt0 = monoSubstAnnNode(p.parType, typarams, bN, bT)
      // A parameter whose annotation rides a type parameter, or whose inferred type mono pins,
      // takes the elaboration's type for it at this instance where that type is closed.
      const lt = elabNodeTy(fnIx, elabWalkTop())
      const lo = if lt >= 0 && lt < T.tys.length { tyAt(lt) } else { null }
      const et = if lo is TyFunc && i < lo.fnParamTypes.length { lo.fnParamTypes[i] } else { -1 }
      const etShut = et >= 0
        && et < T.tys.length
        && !tyHasTyVar(et)
        && !tyReachesHole(et, 16)
      const tn = if p.parType >= 0 && p.parType < P.nodes.length { nodeAt(p.parType) } else { null }
      const tpos = if tn is TypeRef { tn.pos } else { p.pos }
      if nt0 >= 0 && !etShut {
        return emitFailAt(
          "emitProgram: internal: parameter `"
            + p.parName
            + "` of a lambda rides a type parameter the elaboration leaves open at this instance",
          a.fnParams[i],
        )
      }
      const nt = if etShut && nt0 >= 0 { synthTypeRefOfTy(et, tpos) } else { nt0 }
      if etShut && nt0 >= 0 && !tySame(et, nodeTyIxOf(nt0)) {
        return emitFailAt(
          "emitProgram: internal: parameter `"
            + p.parName
            + "` of a lambda is substituted at another type than the elaboration's",
          a.fnParams[i],
        )
      }
      if nt >= 0 {
        ps.push(
          monoCopyOf(
            a.fnParams[i],
            mkParam(p.parName, nt, p.parDefault, p.parOpt, p.parRest, p.pos),
          ),
        )
        any = 1
      } else if nt == -2 {
        // The annotation names a type parameter this instance cannot substitute. The
        // template stays, this instance keeps calling it, and the `checkParams` floor
        // refuses loudly — which is why the prune has to be told.
        monoNoteLamNode(monoLamShared, fnIx)
        return -1
      } else {
        // An un-annotated parameter the checker inferred at the type parameter (a `.filter`
        // callback over a `T[]`) is annotated at this pin, since nothing else lowers it.
        // The elaboration's closed type where mono pins one; mono's own pin where it is open.
        const ipn0 = monoLamParamPinAnn(fnIx, i, p.parType, bN, bT)
        const ipn = if ipn0 >= 0 && etShut { synthTypeRefOfTy(et, p.pos) } else { ipn0 }
        if ipn >= 0 {
          ps.push(
            monoCopyOf(
              a.fnParams[i],
              mkParam(p.parName, ipn, p.parDefault, p.parOpt, p.parRest, p.pos),
            ),
          )
          any = 1
        } else {
          // Unchanged — share the original `Param` node, so a lambda with one generic
          // and one concrete parameter mints exactly one node.
          ps.push(a.fnParams[i])
        }
      }
    } else {
      monoNoteLamNode(monoLamShared, fnIx)
      return -1
    }
    i = i + 1
  }
  any
}

// `monoCloneLambdaSubst`'s return step for the un-annotated lambda at `fnIx`: the return
// annotation the instance's elaboration closes its recorded return type at, or `nret` when none
// applies. Returns -2 when the pinned union cannot be registered.
function monoLamPinRetAnn(fnIx: i32, nret: i32) {
  const rex = fnRetExprOfChecked(fnIx)
  let rty = -1
  if rex >= 0 { rty = nodeTyIxOf(rex) }
  // A tail `if` or `match` is no return expression: the template's checked signature
  // holds its join, as the named clone's does.
  if rex < 0 { rty = monoLamCheckedRet(fnIx) }
  // A join kept apart over the body's parameters (D3520), or one holding a concrete arm
  // beside a hole (`string | _`, D3125), is the signature whatever the last arm's own
  // type: callers re-join it at the pin the same way.
  const kept = monoLamCheckedRet(fnIx)
  const keptJoin = kept >= 0
    && (tyIsTpJoinUnion(kept) || tyIsArmedDeferredJoin(kept))
  if keptJoin { rty = kept }
  // Returns of a value and of `null`: the signature is the value's type or null, whichever
  // the return expression read is.
  const nulJoin = !keptJoin
    && rty >= 0
    && kept >= 0
    && tyHasTyVar(kept)
    && tyBearsNull(kept)
  if nulJoin && isNullTy(rty) { rty = nonNullTy(kept) }
  if rty >= 0 && tyHasTyVar(rty) {
    // The instance's elaboration types the lambda's result; `er` is that answer at a hole
    // instance, which alone registers the result's box and lifts the literal-member gate.
    const ea = monoLamElabRet(fnIx)
    const er = if monoPinHoleN.length > 0 && !monoLamRetFromKids { ea } else { -1 }
    // A result typed at another generic's variable is not this instance's to pin: the clone
    // keeps it open, as it keeps a parameter of that type, and is instanced at its calls (D15032).
    const rs = if er < 0 && tyVarOwnedByOtherGeneric(rty, monoInstOwn) { rty } else { ea }
    if rs >= 0 && rs != rty {
      const litGate = rex < 0 && monoTyHasLitMember(rs) && !keptJoin && er < 0
      if !tyHasTyVar(rs) && !litGate {
        const rnm = monoPinAnnSpelling(rs)
        // The box a kept-apart join returns is registered here, as an instance return's is.
        if (
          (keptJoin || nulJoin || er >= 0)
          && monoRegisterValuePin(rnm, rs) < 0
        ) {
          return -2
        }
        if rnm != "" { return synthTypeRefOfTy(rs, -1) }
      }
    }
  }
  nret
}

// Lambda `fnIx`'s return at the instance being built, closed: the instance's elaboration of it,
// else the one its own instances there agree on; -1 when none closes it.
function monoLamElabRet(fnIx: i32): i32 {
  monoLamRetFromKids = false
  const et = elabWalkTy(fnIx)
  let open = false
  if et >= 0 {
    const ft = tyAt(et)
    if ft is TyFunc && ft.fnRet >= 0 {
      if !tyHasTyVar(ft.fnRet) { return ft.fnRet }
      open = true
    }
  }
  const kr = elabWalkKidRet(fnIx)
  monoLamRetFromKids = open && kr >= 0
  kr
}
// Whether `monoLamElabRet`'s last answer closed a result the instance's own signature kept open.
let monoLamRetFromKids = false

// `monoCloneLambdaSubst`'s last step: lifts `clone`, the instance of the lambda template `a`
// at `fnIx`, into its own `fnStmts` slot and re-parents the lambdas minted since `mark`.
// Returns `clone`.
function monoLamInstallClone(a: FuncDecl, fnIx: i32, clone: i32, mark: i32) {
  // A lambda member of a tagged set is its id wherever an instance of it is read.
  fnTagLeafCarry(clone, fnIx)
  voidCtxLambdaCarry(clone, fnIx)
  // D1046 — the first instance of a named nested function replaces the template's slot
  // rather than pushing beside it: the by-name lookup takes the first child of the
  // frame, so two same-named children mean the call answers the unsubstituted template.
  // Later instances push and are re-pointed at their own frame by the caller.
  if monoFnNameIsSourceNamed(a.fnName) && monoInstIsFirst {
    const tSlot = monoSlotOfLamNode(fnIx)
    if tSlot >= 0 {
      buildFnMapNoteFnStmtWrite(tSlot, clone)
      fnStmts[tSlot] = clone
      monoNamedTmplNode.push(fnIx)
      monoNamedTmplSlot.push(tSlot)
      monoReparentNestedLams(mark, tSlot)
      fnValUsed = true
      fnNestUsed = true
      monoNoteLamNode(monoLamPinned, fnIx)
      return clone
    }
  }
  fnStmts.push(clone)
  // The original's frame, not module scope. The clone shares the body, so its free names
  // have to resolve up the same scope chain or a lambda that both captures and annotates
  // `T` loses its environment. (`monoCloneLambdaPinned` pushes -1 because a `.map`
  // callback is rebuilt from an argument position, not from a lifted slot of its own.)
  fnParent.push(monoLamParentOf(fnIx))
  const mySlot = fnStmts.length - 1
  const tmplSlot = monoSlotOfLamNode(fnIx)
  monoCloneKeepsHoles(tmplSlot, mySlot, clone)
  monoCadNoteLamClone(clone, mySlot)
  lfNoteClone(mySlot, tmplSlot)
  monoReparentNestedLams(mark, mySlot)
  monoLamMintedSlots.push(mySlot)
  monoLamCloneSlots.push(mySlot)
  fnDispNames.push("")
  fnValUsed = true
  fnNestUsed = true
  monoNoteLamNode(monoLamPinned, fnIx)
  clone
}

// A clone at `slot` of the lambda at `tmplSlot` whose own parameters are still holes is
// instantiated per call, as its template is: the capture that made it a template does not
// pin them (D2854). Slots appended since the snapshot are concrete instances.
function monoCloneKeepsHoles(tmplSlot: i32, slot: i32, clone: i32) {
  if tmplSlot < 0 || tmplSlot >= monoGen.length || monoGen[tmplSlot] != 1 {
    return 0
  }
  if !monoIsGenericDecl(clone) { return 0 }
  while monoGen.length < slot {
    monoOrigNode.push(fnStmts[monoGen.length])
    monoGen.push(0)
  }
  if monoGen.length == slot {
    monoOrigNode.push(clone)
    monoGen.push(1)
  }
  0
}

// Per-instance lambda monomorphization for a generic body: every lambda literal still naming
// a type parameter is substituted at this pin, in any position (D2551). Copy-on-write, and a
// rebuilt node answers the narrowing retirements its original did (D2390's banks).
function monoPinBodyLambdas(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  const r = monoPinBodyLambdasRaw(ix, typarams, tvN, tvV, bN, bT)
  if r != ix { recordClonedCallRetire(ix, r) }
  r
}

function monoPinBodyLambdasRaw(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  if ix < 0 { return ix }
  // Whether the parent delivers this value where a union at the pin lowers (`monoPinSink`).
  const sink = monoPinSink
  monoPinSink = false
  const n = nodeAt(ix)
  if n is Block {
    const ns: i32[] = []
    let changed = false
    let i = 0
    while i < n.blkStmts.length {
      const cs = monoPinBodyLambdas(n.blkStmts[i], typarams, tvN, tvV, bN, bT)
      ns.push(cs)
      if cs != n.blkStmts[i] { changed = true }
      i = i + 1
    }
    if !changed { return ix }
    return mkBlock(ns, n.pos)
  }
  if n is LetDecl {
    monoPinSink = n.letType < 0 && !(monoPinUnsafeNames.get(n.letName) ?? false)
    const savedReach = monoPinLetReaches
    monoPinLetReaches = monoPinReachNames.get(n.letName) ?? false
    const ci = monoPinValueLambda(n.letInit, typarams, tvN, tvV, bN, bT)
    monoPinLetReaches = savedReach
    monoPinSink = false
    // A binding inside an expression (an `if` arm's prelude), which the statement clone does
    // not reach, has its annotation substituted here.
    const nt = monoMintedLetAnn(
      n,
      ix,
      monoSubstLetType(ix, n.letType, typarams, bN, bT),
    )
    if ci == n.letInit && nt == n.letType { return ix }
    return monoCopyOf(ix, mkLet(n.letKw, n.letName, nt, ci, n.pos))
  }
  // D1046 — a nested named `function` statement is the declaration form of the same
  // thing, and `collectFns` lifts it exactly like a lambda. The statement itself emits
  // nothing (`wasmEmit.emitStmt`'s `FuncDecl` arm), so the node returned is immaterial —
  // the lifted slot is the whole effect, and the statement is returned unchanged.
  if n is FuncDecl {
    if monoFnNameIsSourceNamed(n.fnName) {
      monoCloneLambdaSubst(ix, typarams, tvN, tvV, bN, bT)
      return ix
    }
    // An anonymous lambda reached here is a block's tail value (D2525).
    const acl = monoCloneLambdaSubst(ix, typarams, tvN, tvV, bN, bT)
    if acl >= 0 { return acl }
    return ix
  }
  if n is RetStmt {
    const ca = monoPinValueLambda(n.retArg, typarams, tvN, tvV, bN, bT)
    if ca == n.retArg { return ix }
    return mkReturn(ca, n.pos)
  }
  if n is WhileStmt {
    const cc = monoPinValueLambda(n.whileCond, typarams, tvN, tvV, bN, bT)
    const cb = monoPinBodyLambdas(n.whileBody, typarams, tvN, tvV, bN, bT)
    if cc == n.whileCond && cb == n.whileBody { return ix }
    return mkWhileAs(n, cc, cb)
  }
  if n is IfStmt {
    // An `else if` chain is rewritten along its spine, so its depth costs no stack (D1990).
    const links = monoIfChainLinks(ix)
    const ccs: i32[] = []
    const cts: i32[] = []
    let k = 0
    while k < links.length {
      const c = nodeAt(links[k])
      if c is IfStmt {
        ccs.push(monoPinValueLambda(c.ifCond, typarams, tvN, tvV, bN, bT))
        cts.push(monoPinBodyLambdas(c.ifThen, typarams, tvN, tvV, bN, bT))
      }
      k = k + 1
    }
    return monoIfChainRebuildPinned(
      links,
      ccs,
      cts,
      monoPinBodyLambdas(
        monoIfChainElse(links),
        typarams,
        tvN,
        tvV,
        bN,
        bT,
      ),
      bN,
      bT,
      sink,
    )
  }
  if n is ForRange {
    const ff = monoPinValueLambda(n.frFrom, typarams, tvN, tvV, bN, bT)
    const ft = monoPinValueLambda(n.frTo, typarams, tvN, tvV, bN, bT)
    const fs = monoPinValueLambda(n.frStep, typarams, tvN, tvV, bN, bT)
    const cb = monoPinBodyLambdas(n.frBody, typarams, tvN, tvV, bN, bT)
    if ff == n.frFrom && ft == n.frTo && fs == n.frStep && cb == n.frBody {
      return ix
    }
    return mkForRange(n.frVar, ff, ft, fs, n.frExcl, cb, n.frLabel, n.pos)
  }
  if n is ForIn {
    const fi = monoPinValueLambda(n.fiIter, typarams, tvN, tvV, bN, bT)
    const cb = monoPinBodyLambdas(n.fiBody, typarams, tvN, tvV, bN, bT)
    if fi == n.fiIter && cb == n.fiBody { return ix }
    return mkForInCopy(n, fi, cb)
  }
  const ks = monoExprKids(ix)
  // A read of a binding typed at a join the checker kept apart takes the join at this pin: the
  // binding's name can be declared again elsewhere in the body at another type (D2906).
  // So does a read of a place holding a written type-parameter value: the member it reads at
  // is the pin's (D3240).
  if (
    n is Ident
    && (tyIsTpJoinUnion(nodeTyIxOf(ix)) || tyIsWriteLandRead(nodeTyIxOf(ix)))
  ) {
    return monoPinRetype(ix, bN, bT)
  }
  if ks.length == 0 { return ix }
  const nks: i32[] = []
  const inLit = monoPinInLit
  monoPinInLit = n is ArrayLit || n is ObjLit
  const kidSink = monoPinSinkKids(ix) || (sink && n is Paren)
  const eqPin = monoEqOfTpJoin(ix)
  let ki = 0
  while ki < ks.length {
    monoPinSink = kidSink
    const kv = monoPinValueLambda(ks[ki], typarams, tvN, tvV, bN, bT)
    monoPinSink = false
    if eqPin && kv >= 0 && nodeAt(kv) is Ident && tyHasTyVar(nodeTyIxOf(kv)) {
      // The compare picks the join's arm by the other side's type, which is the pin's.
      nks.push(monoPinRetype(kv, bN, bT))
    } else if n is Call {
      nks.push(monoPinFnValueTy(kv, ks[ki], bN, bT))
    } else if ki == 0 && (n is Member || n is Index) {
      nks.push(monoPinRecvName(monoPinRecvLit(kv, ks[ki], bN, bT), bN, bT))
    } else {
      nks.push(kv)
    }
    ki = ki + 1
  }
  monoPinInLit = inLit
  let rb = monoExprRebuild(ix, nks, bN, bT)
  // A record literal holding a gradual join is re-made so its own row can be minted at the pin.
  if rb == ix && n is ObjLit && monoObjHoldsGradual(ix) {
    rb = monoExprRemake(ix, monoExprKids(ix))
  }
  if rb == ix {
    rb = monoPinRetype(ix, bN, bT)
  } else if n is ObjLit {
    monoTpJoinObjTy(ix, rb, bN, bT)
  } else if n is AsExpr && rb >= 0 && tyIsGradualUnion(nodeTyIxOf(n.asObj)) {
    // A cast re-made over a re-typed operand keeps the template's result at the pin: an `as?`
    // is nullable at every pin, as over a bare parameter (D2754).
    const apt = monoPinnedTyOf(ix, bN, bT)
    if apt >= 0 { monoPinRecordTy(rb, apt) }
    const rbn = nodeAt(rb)
    if rbn is AsExpr {
      const opt = nodeTyIxOf(rbn.asObj)
      if (
        opt >= 0
        && opt < T.tys.length
        && !(tyAt(opt) is TyUnion)
        && !tyHasTyVar(opt)
      ) {
        monoGradualAsScalar[rb] = true
      }
    }
  }
  if n is BinExpr && n.binOp == "??" && monoPinHoleN.length > 0 {
    monoHoleCoalUnion(ix)
  }
  if n is BinExpr && n.binOp == "??" { rb = monoPinCoalListDefault(ix, rb) }
  // A `??` the checker kept apart is read at the pin wherever it goes, as its `if` is (D2846).
  if sink || (tpIfJoinAt.get(ix) ?? -1) >= 0 { rb = monoPinCoalJoin(ix, rb) }
  if numUnionMinted { rb = monoNumUnionOpPin(ix, rb) }
  rb
}

// An operator operand's type at the instance: the walk type, narrowed where the walk narrows it,
// else -1. An operator reaches a nullable number only past the check that excluded its `null`.
function monoNumOperandPinTy(ix: i32): i32 {
  const n = elabWalkNarrowedTy(ix)
  const w = if n >= 0 && n < T.tys.length && !tyHasTyVar(n) { n } else { elabWalkTy(ix) }
  if w < 0 || w >= T.tys.length || tyHasTyVar(w) || tyReachesHole(w, 16) {
    return -1
  }
  if tyIsNumericBox(w) && tyBearsNull(w) { nonNullTy(w) } else { w }
}

// An operator whose operand this instance types as a numeric union answers the union of its
// member results (`numUnionResultTy`), which the template, typed at a parameter, cannot name.
function monoNumUnionOpPin(ix: i32, rb: i32): i32 {
  if rb < 0 || rb >= P.nodes.length { return rb }
  const n = nodeAt(rb)
  let nu = -1
  if n is BinExpr {
    if n.binOp == "=" || n.binOp == "??" || n.binOp == "&&" || n.binOp == "||" {
      return rb
    }
    const lt = monoNumOperandPinTy(n.binLeft)
    const rt = monoNumOperandPinTy(n.binRight)
    if !tyIsNumUnion(lt) && !tyIsNumUnion(rt) { return rb }
    nu = numUnionResultTy(n, lt, rt)
  } else if n is Unary {
    if n.unOp != "-" { return rb }
    const at = monoNumOperandPinTy(n.unArg)
    if !tyIsNumUnion(at) { return rb }
    nu = at
  } else {
    return rb
  }
  if nu < 0 || nu == nodeTyIxOf(rb) { return rb }
  let nx = rb
  if nx == ix { nx = monoExprRemake(ix, monoExprKids(ix)) }
  monoPinRecordTy(nx, nu)
  if tyIsNumUnion(nu) {
    const vn = valueUnionRetName(nu)
    if vn != "" { monoRegisterPinUnion(vn, nu) }
  }
  nx
}

// Whether `ix` is an object literal with a field typed at a union holding a type parameter.
function monoObjHoldsGradual(ix: i32): boolean {
  if ix < 0 { return false }
  const u = unwrapParen(ix)
  if u < 0 || !(nodeAt(u) is ObjLit) { return false }
  const t = nodeTyIxOf(u)
  if t < 0 || t >= T.tys.length { return false }
  monoTyHoldsGradual(t, 0)
}

// Whether record or list type `t` holds, at any depth, a field or element typed at a union
// holding a type parameter.
function monoTyHoldsGradual(t: i32, depth: i32): boolean {
  if t < 0 || t >= T.tys.length || depth > 8 { return false }
  const o = tyAt(t)
  if o is TyObj {
    for ft in o.objFieldTypes {
      if monoTyIsUnionOrNulUnion(ft) && tyHasTyVar(ft) { return true }
      if monoTyHoldsGradual(ft, depth + 1) { return true }
    }
    return false
  }
  // A list answers for its element; any other kind has no element and answers false.
  monoTyHoldsGradual(tyArrayElemIx(t), depth + 1)
}

// An object literal `ix` rebuilt as `rb` whose recorded type holds a field typed at a join the
// checker kept apart is re-typed at the pin: its row is interned from its own field types (D2906).
function monoTpJoinObjTy(ix: i32, rb: i32, bN: string[], bT: i32[]) {
  const t = nodeTyIxOf(ix)
  if t < 0 || t >= T.tys.length { return 0 }
  if !(tyAt(t) is TyObj) || !monoTyHoldsGradual(t, 0) { return 0 }
  const pty = monoPinnedTyOf(ix, bN, bT)
  if pty >= 0 && pty != t {
    monoPinRecordTy(rb, pty)
    monoGradualObjLits[rb] = true
    monoGradualObjList.push(rb)
  }
  0
}

// Whether `ix` is an `==` / `!=` with an operand typed at a join the checker kept apart.
function monoEqOfTpJoin(ix: i32): boolean {
  const n = nodeAt(ix)
  if n is BinExpr {
    if n.binOp != "==" && n.binOp != "!=" { return false }
    return tyIsTpJoinUnion(nodeTyIxOf(n.binLeft))
      || tyIsTpJoinUnion(nodeTyIxOf(n.binRight))
  }
  false
}

// Registers the numeric box a hole instance's `??` at `ix` reads at the instance's holes, which
// no template type spells when the function has several pins (D9913). A join with a reference
// member is left to the `??` lowering's own refusal.
function monoHoleCoalUnion(ix: i32) {
  const t = nodeTyIxOf(ix)
  if t < 0 || t >= T.tys.length || !(tyAt(t) is TyVar) { return 0 }
  const j = holePinReadOf(t, monoPinHoleN, monoPinHoleT)
  if j < 0 || j >= T.tys.length || tyHasTyVar(j) || !tyIsNumericBox(j) {
    return 0
  }
  const name = valueUnionRetName(j)
  if name == "" { return 0 }
  monoRegisterPinUnion(name, j)
}

// A `??` at `ix`, rebuilt as `rb`, whose default is an open list literal: a copy whose default
// is built at the pinned operand's non-null list type, so both arms are one list row. `rb`
// unchanged where the operand's pinned type is not a closed list.
function monoPinCoalListDefault(ix: i32, rb: i32): i32 {
  const n = nodeAt(ix)
  const r = nodeAt(rb)
  if !(n is BinExpr) || !(r is BinExpr) { return rb }
  if n.binCompound != "" || r.binCompound != "" { return rb }
  const rx = r.binRight
  if rx < 0 || !(nodeAt(rx) is ArrayLit) || !monoTyOpen(nodeTyIxOf(rx)) {
    return rb
  }
  const lt = nodeTyIxOf(n.binLeft)
  if lt < 0 || lt >= T.tys.length { return rb }
  const pl = monoClosedWalkTy(n.binLeft)
  if pl < 0 && monoPinHoleN.length > 0 {
    emitFailAt(
      "emitProgram: internal: the left operand of a `??` with a list default has no closed type in this hole instance",
      n.binLeft,
    )
    return rb
  }
  if pl < 0 || pl >= T.tys.length || tyHasTyVar(pl) { return rb }
  const pnn = nonNullTy(pl)
  if pnn < 0 || pnn >= T.tys.length || !(tyAt(pnn) is TyArray) { return rb }
  const nr = monoExprRemake(rx, monoExprKids(rx))
  if nr == rx { return rb }
  monoPinRecordTy(nr, pnn)
  const nb = monoExprRemake(rb, [r.binLeft, nr])
  if nb == rb { return rb }
  nodeTyCarry(nb, rb)
  nb
}

// For a `??` at `ix`, rebuilt as `rb`: where its sides' pinned types join to other than the
// template's recorded join (`t ?? 5` at a `string | null` pin), a node answering that join. `rb`
// unchanged otherwise.
function monoPinCoalJoin(ix: i32, rb: i32): i32 {
  const n = nodeAt(ix)
  if !(n is BinExpr) { return rb }
  if n.binOp != "??" || n.binCompound != "" { return rb }
  const raw = nodeTyIxOf(ix)
  if raw < 0 || raw >= T.tys.length { return rb }
  const lt = nodeTyIxOf(n.binLeft)
  const rt = nodeTyIxOf(n.binRight)
  if lt < 0 || rt < 0 || lt >= T.tys.length || rt >= T.tys.length { return rb }
  if !tyHasTyVar(raw) && !tyHasTyVar(lt) && !tyHasTyVar(rt) { return rb }
  const pl = monoClosedWalkTy(n.binLeft)
  const pr = monoClosedWalkTy(n.binRight)
  if pl < 0 || pr < 0 { return rb }
  // A literal default that is a member of the pinned literal-union operand keeps that union,
  // as the concrete `??` types it, so the result stays the operand's atom (D3423).
  const pnn = nonNullTy(pl)
  const dl = litTyOfExpr(n.binRight)
  const keepsLit = tyIsLitUnion(pnn) && dl >= 0 && assignable(dl, pnn)
  const ts: i32[] = [pnn, pr]
  // An operand pinned at `null` always takes the default, as the concrete `??` types it.
  let j = if isNullTy(pl) { pr } else { joinPinnedArmTys(ts) }
  if keepsLit { j = pnn }
  if j < 0 || j >= T.tys.length || tyHasTyVar(j) { return rb }
  const cur = nodeTyIxOf(rb)
  if cur == j || (cur >= 0 && tyEq(cur, j)) { return rb }
  if !keepsLit && tyAt(j) is TyUnion {
    // A kept-apart union of lists has its row from `monoRegisterElabJoinRows`.
    const listRow = (tpIfJoinAt.get(ix) ?? -1) >= 0 && tyUnionAllLists(j)
    const name = valueUnionRetName(j)
    if !listRow && (name == "" || monoRegisterPinUnion(name, j) < 0) {
      return rb
    }
  }
  let nx = rb
  if nx == ix { nx = monoExprRemake(ix, monoExprKids(ix)) }
  if nx == ix { return rb }
  monoPinRecordTy(nx, j)
  nx
}

// Whether the per-instance walk is at an operand of a list or object literal.
let monoPinInLit = false

// Whether the value the per-instance walk visits next is delivered where a join that is a union
// at the pin lowers as the union (a `print` argument, or a binding every read of which is
// one): elsewhere the instance reads it at the template's type (D2893).
let monoPinSink = false

// The names the instance body reads anywhere but as such a sink, set before its walk.
let monoPinUnsafeNames: {[string]: boolean} = Map()

// Notes in `monoPinReachNames` each `let` of template function `td` whose value reaches one of its
// returns (`elabValueReturnsFrom`).
function monoPinNoteReach(td: i32) {
  const tn = if td >= 0 && td < P.nodes.length { nodeAt(td) } else { null }
  if tn is FuncDecl { monoPinNoteReachLets(tn.fnBody, td) }
  0
}

function monoPinNoteReachLets(ix: i32, td: i32) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is FuncDecl { return 0 }
  if n is LetDecl && elabValueReturnsFrom(ix, td) {
    monoPinReachNames[n.letName] = true
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      monoPinNoteReachLets(kids[i], td)
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  0
}

// Whether a name in `monoPinReachNames` is declared more than once under `body`.
function monoPinReachShadowed(body: i32): boolean {
  const seen: {[string]: i32} = Map()
  monoPinCountDecls(body, seen) > 0
}

// Counts every `let`/`const` declaration name under `ix` into `seen`; how many reaching names
// it finds declared a second time.
function monoPinCountDecls(ix: i32, seen: {[string]: i32}): i32 {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  let dup = 0
  if n is LetDecl {
    const c = (seen.get(n.letName) ?? 0) + 1
    seen[n.letName] = c
    if c > 1 && (monoPinReachNames.get(n.letName) ?? false) { dup = 1 }
  }
  let cur = ix
  while cur >= 0 {
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      dup = dup + monoPinCountDecls(kids[i], seen)
      i = i + 1
    }
    cur = elseIfLink(cur)
  }
  dup
}

// The names of the template's bindings whose value reaches its return. Only these can put a
// join's rep into the return box.
let monoPinReachNames: {[string]: boolean} = Map()

// Whether the binding whose initializer the per-instance walk is in reaches the return.
let monoPinLetReaches = false

// Whether the instance being walked returns an annotated union box, so a binding its body
// returns by name is delivered as that union too (D2912).
let monoPinRetBox = false

// The hole binding of the instance whose body `monoPinBodyLambdas` walks; empty outside it.
let monoPinHoleN: string[] = []
let monoPinHoleT: i32[] = []

// Records in `monoPinUnsafeNames` every name read under `ix` outside a sink.
function monoPinNoteUnsafe(ix: i32) {
  let cur = ix
  while cur >= 0 && cur < P.nodes.length {
    const n = nodeAt(cur)
    if n is Ident {
      monoPinUnsafeNames[n.identName] = true
      return 0
    }
    // A nested function's returns are its own, not the instance's.
    const savedRB = monoPinRetBox
    if n is FuncDecl { monoPinRetBox = false }
    const safe = monoPinSinkKids(cur) || monoPinIsBoxReturn(cur)
    const kids = nodeSpineChildren(cur)
    let i = 0
    while i < kids.length {
      const k = kids[i]
      if k >= 0 && k < P.nodes.length {
        if !(safe && nodeAt(unwrapParen(k)) is Ident) { monoPinNoteUnsafe(k) }
      }
      i = i + 1
    }
    monoPinRetBox = savedRB
    cur = elseIfLink(cur)
  }
  0
}

// `monoPinNoteUnsafe` over an instance body, whose tail name is its return (`monoPinRetBox`).
function monoPinNoteUnsafeBody(body: i32) {
  const b = nodeAt(body)
  if b is Block {
    if monoPinRetBox && b.blkStmts.length > 0 {
      const last = b.blkStmts.length - 1
      if nodeAt(unwrapParen(b.blkStmts[last])) is Ident {
        let i = 0
        while i < last {
          monoPinNoteUnsafe(b.blkStmts[i])
          i = i + 1
        }
        return 0
      }
    }
  }
  monoPinNoteUnsafe(body)
}

// Whether `ix` hands its operand out as the instance's union-box return: a `return x`.
function monoPinIsBoxReturn(ix: i32): boolean {
  if !monoPinRetBox { return false }
  const n = nodeAt(ix)
  if n is RetStmt { return true }
  false
}

// Whether the operands of expression `ix` are sinks: a `print` call's. An `==` is not one,
// since its other operand is still read at the template's type.
function monoPinSinkKids(ix: i32): boolean {
  const n = nodeAt(ix)
  if n is Call && n.callFn >= 0 {
    const f = nodeAt(n.callFn)
    if f is Ident { return f.identName == "print" }
  }
  false
}

// Expression `ix`, whose operands the walk left unchanged, re-made when its recorded type
// names a type parameter this instance binds: its emission and the instance's inferred
// return read that type, and the template's is the parameter itself. `ix` when it does not.
function monoPinRetype(ix: i32, bN: string[], bT: i32[]): i32 {
  // An object literal takes its row from its destination, and a list literal inside another
  // literal from the enclosing one's row; neither is named by the literal's own recorded type.
  const n = nodeAt(ix)
  if n is ObjLit { return ix }
  if n is ArrayLit && monoPinInLit { return ix }
  // Not the store's type: an open pin defers to emit's `scopeTyAt` read, and pinning the
  // store's closed type on the re-made node breaks hole instances (D15259).
  const pty = monoPinnedTyOf(ix, bN, bT)
  if pty < 0 || pty == nodeTyIxOf(ix) { return ix }
  if n is ArrayLit && monoTpJoinListElemBox(ix, pty) < 0 { return ix }
  // A join the checker kept apart is a union at the pin only as a box registered here.
  if tyIsTpJoinUnion(nodeTyIxOf(ix)) { monoPinUnionBoxed(pty, false) }
  const nx = monoExprRemake(ix, monoExprKids(ix))
  if nx != ix { monoPinRecordTy(nx, pty) }
  nx
}

// The annotation spelling of the list type `ty`, whose pin spelling is `render`: a record
// element, nullable or not, by its row's name (`(P|null)[]`); any other element as `render`. A
// nullable record with no row is left as `render`.
function monoListSpelling(render: string, ty: i32): string {
  let t = ty
  let suffix = ""
  while (
    t >= 0
    && t < T.tys.length
    && tyAt(t) is TyArray
    && suffix.length < 128
  ) {
    const ta = tyAt(t)
    if ta is TyArray { t = ta.aElem }
    suffix = suffix + "[]"
  }
  if suffix != "" && t >= 0 && t < T.tys.length {
    const te = tyAt(t)
    if te is TyNullable {
      const inner = te.nInner
      if inner >= 0 && inner < T.tys.length && tyAt(inner) is TyObj {
        const rn = monoRetRowName(inner)
        if rn != "" { return "(" + rn + "|null)" + suffix }
        // A record with no row of its own (a generic application) keeps the render.
        return render
      }
    }
  }
  const rl = monoRetListRowName(ty)
  if rl != "" { return rl }
  render
}

// A name read as a receiver of a list whose element can be null (`xs[i]` at `(string | null)[]`),
// re-typed at the pin: the read recovers a non-null element unless the receiver's recorded type
// says otherwise. Any other name keeps the template's type, which its binding answers for.
function monoPinRecvName(cur: i32, bN: string[], bT: i32[]): i32 {
  if cur < 0 || !(nodeAt(cur) is Ident) { return cur }
  const ipt = monoPinnedTyOf(cur, bN, bT)
  if ipt < 0 || ipt >= T.tys.length { return cur }
  const it = tyAt(ipt)
  if !(it is TyArray) { return cur }
  if !tyBearsNull(it.aElem) { return cur }
  monoPinRetype(cur, bN, bT)
}

// A list literal read as a receiver (`[r].map(…)`, `[r][0]`) and typed at the type parameter,
// re-typed at the pin: an inline `.map`/`.filter` and an element read take its element rep off
// that type (D2554). `cur` is the walk's rewrite of `orig`; anything else is returned as is.
function monoPinRecvLit(cur: i32, orig: i32, bN: string[], bT: i32[]): i32 {
  if orig < 0 || !(nodeAt(orig) is ArrayLit) { return cur }
  const aty = nodeTyIxOf(orig)
  const pty = monoPinnedTyOf(orig, bN, bT)
  if pty < 0 || pty == aty { return cur }
  let nx = cur
  if nx == orig { nx = monoExprRemake(orig, monoExprKids(orig)) }
  nodeTyRecord(nx, pty)
  nx
}

// A call's callee or argument `cur` (the walk's rewrite of `orig`) answering its function type
// at this pin. A value call's `$fnsig`, and a function argument's pin, are keyed off the
// recorded type, and a template's names the type parameter, which keys no signature (D2552).
function monoPinFnValueTy(cur: i32, orig: i32, bN: string[], bT: i32[]): i32 {
  const ty = nodeTyIxOf(orig)
  if ty < 0 || ty >= T.tys.length { return cur }
  if !(tyAt(ty) is TyFunc) { return cur }
  const st = monoPinnedTyOf(orig, bN, bT)
  // A read of a binding choosing open generics is coerced per delivery, so each instance
  // takes a read of its own even where the pin leaves its type open (D9220).
  if st == ty && !(tyHasTyVar(ty) && monoArgIsOpenFnChoice(orig, 0)) {
    return cur
  }
  let nx = cur
  if nx == orig { nx = monoExprRemake(orig, monoExprKids(orig)) }
  if nx == orig { return cur }
  nodeTyRecord(nx, st)
  nx
}

// Whether `ty`, or a member of it as a union or nullable, is a literal or a literal union: a
// checked signature's join names the literal member, which no arm's own rep holds.
function monoTyHasLitMember(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  if tyIsLitUnion(ty) || tyAt(ty) is TyLit { return true }
  if tyBearsNull(ty) {
    const nn = nonNullTy(ty)
    if nn >= 0 && nn != ty && monoTyHasLitMember(nn) { return true }
  }
  monoUnionHasLitMember(ty)
}

function monoUnionHasLitMember(ty: i32): boolean {
  const t = tyAt(ty)
  if t is TyUnion {
    let i = 0
    while i < t.uMembers.length {
      if monoTyHasLitMember(t.uMembers[i]) { return true }
      i = i + 1
    }
  }
  false
}

// The return type in lambda `fnIx`'s recorded function type, or -1.
function monoLamCheckedRet(fnIx: i32): i32 {
  const ft = nodeTyIxOf(fnIx)
  if ft < 0 || ft >= T.tys.length { return -1 }
  const f = tyAt(ft)
  if f is TyFunc { return f.fnRet }
  -1
}

// `monoPinBodyLambdas` over a value position, where a lambda literal of either kind is the
// value itself: its per-instance clone when it is a template, else the walk below it.
function monoPinValueLambda(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  bN: string[],
  bT: i32[],
) {
  if ix < 0 { return ix }
  if nodeAt(ix) is FuncDecl {
    const cl = monoCloneLambdaSubst(ix, typarams, tvN, tvV, bN, bT)
    if cl >= 0 { return cl }
    return ix
  }
  monoPinBodyLambdas(ix, typarams, tvN, tvV, bN, bT)
}

// The type parameters of every enclosing lifted frame of `fe`, appended to `out`. The
// chain is `fnParent`; each frame's original declaration carries the `<T>`, because
// `fnStmts[p]` may already hold that generic's first instance. Bounded by the function
// count, so it terminates even should `fnParent` ever contain a cycle.
function monoEnclosingTyParams(fe: i32, out: string[]) {
  let p = -1
  if fe < fnParent.length { p = fnParent[fe] }
  let guard = 0
  while p >= 0 && guard <= fnStmts.length {
    let nd = -1
    if p < monoOrigNode.length { nd = monoOrigNode[p] }
    else if p < fnStmts.length { nd = fnStmts[p] }
    if nd >= 0 {
      const fn = nodeAt(nd)
      if fn is FuncDecl {
        let i = 0
        while i < fn.fnTyParams.length {
          out.push(fn.fnTyParams[i])
          i = i + 1
        }
      }
    }
    if p < fnParent.length { p = fnParent[p] } else { p = -1 }
    guard = guard + 1
  }
  0
}

// The PRUNE's face, which decides whether a lifted slot is dead. A frame that declares no
// type parameter is never instantiated, so its one lifted slot is the only one and stubbing
// it leaves a live `call_indirect` pointing at a stub. The instantiation's face is the core
// below, which this guard must not reach.
function monoLamNodeIsTemplate(fnIx: i32, typarams: string[]) {
  if typarams.length == 0 { return false }
  monoLamNodeIsTemplateCore(fnIx, typarams)
}

// A nested function is a per-instance template when its own annotations name a type
// parameter, when it captures (its env type is the instance's), or when its body names one.
// Asked with no `typarams` guard from inside an instantiation: an un-annotated
// `function o(n)` pins its parameter without declaring a `<T>` (D1780).
function monoLamNodeIsTemplateCore(fnIx: i32, typarams: string[]) {
  const fn = nodeAt(fnIx)
  if fn is FuncDecl {
    if fn.fnTyParams.length > 0 { return false }
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = nodeAt(ps[i])
      if p is Param {
        if p.parType >= 0 {
          if monoAnnHasTyParam(p.parType, -1, typarams) { return true }
        }
      }
      i = i + 1
    }
    if fn.fnRet >= 0 {
      if monoAnnHasTyParam(fn.fnRet, -1, typarams) { return true }
    }
    // D943 — a capture is part of a lambda's effective signature, and the two checks above
    // read only the written one: `show: () => string` inside `mk<T>` takes no parameter and
    // returns a concrete type while capturing `value: T`. One lifted slot means one env
    // struct, so it is asked as "does it capture at all" — an extra clone is a correct one.
    const feIx = monoSlotOfLamNode(fnIx)
    if feIx >= 0 {
      if captureCountOf(feIx) > 0 { return true }
    }
    // D1220 — the fourth rung: a type parameter named in the body. The three above read the
    // written signature and the capture count, and `() => gv is T` mentions `T` in none of
    // them — only in the `is` spelling, which `monoFoldTyParamLayout` substitutes per pin.
    // Broad on purpose: an extra clone is a correct clone, only larger.
    if monoNodeNamesTyParam(fn.fnBody, typarams) { return true }
    // The fifth: an un-annotated parameter the checker inferred at a type variable, such as
    // `(x) => x` over a `T[]` — its type is the instance's, as a written `x: T` would be.
    const lty = nodeTyIxOf(fnIx)
    if lty >= 0 && lty < T.tys.length {
      const lt = tyAt(lty)
      if lt is TyFunc {
        let pi = 0
        while pi < ps.length && pi < lt.fnParamTypes.length {
          const pp = nodeAt(ps[pi])
          if pp is Param {
            if pp.parType < 0 && tyHasTyVar(lt.fnParamTypes[pi]) { return true }
          }
          pi = pi + 1
        }
      }
    }
  }
  false
}

// Is the lifted slot `fe` a lambda template — an annotation still naming a type parameter
// of an enclosing generic frame? Every instantiation of that frame mints its own copy, so
// nothing in the module refers to this slot and the prune at the end of `monomorphize`
// stubs it. Without this rung the template is emitted whether or not an instance exists.
function monoLamSlotIsTyParamTemplate(fe: i32) {
  if fe < 0 || fe >= fnStmts.length { return false }
  const tps: string[] = []
  monoEnclosingTyParams(fe, tps)
  monoLamNodeIsTemplate(fnStmts[fe], tps)
}

// Is the lifted slot `fe` a lambda template of a hole function: its frame declares no `<T>`
// but has instances, and its own type names the frame's holes. Each instance clones it at
// its pin, so a template no instance shares is dead (D3083).
function monoLamSlotIsHoleTemplate(fe: i32) {
  if fe < 0 || fe >= fnStmts.length || fe >= fnParent.length { return false }
  // A lambda nested in a lambda is cloned with it, so its frame is the nearest named one.
  let p = fnParent[fe]
  let guard = 0
  while (
    p >= 0
    && p < fnParent.length
    && criFnIsAnonLambda(p)
    && guard <= fnStmts.length
  ) {
    p = fnParent[p]
    guard = guard + 1
  }
  if p < 0 || p >= monoOrigNode.length || !monoInstantiatedAny(p) {
    return false
  }
  const pf = nodeAt(monoOrigNode[p])
  if !(pf is FuncDecl) { return false }
  if pf.fnTyParams.length > 0 { return false }
  const none: string[] = []
  monoLamNodeIsTemplateCore(fnStmts[fe], none)
}

// Has any enclosing frame of lifted slot `fe` been instantiated? A template whose generic
// no call site ever pinned has no live reference: the generic's own slot is stubbed by the
// arm above in this same loop, and the body that named the lambda goes with it. Bounded
// by the function count, like every other `fnParent` walk here.
function monoLamFrameInstantiated(fe: i32) {
  let p = -1
  if fe < fnParent.length { p = fnParent[fe] }
  let guard = 0
  while p >= 0 && guard <= fnStmts.length {
    if monoInstantiatedAny(p) { return true }
    if p < fnParent.length { p = fnParent[p] } else { p = -1 }
    guard = guard + 1
  }
  false
}

// Per-instance lambda monomorphization for `.map`/`.filter`. An inline callback's
// un-annotated param defaults to i32 at emit, correct only for the i32 shape, so when
// this instance pins the receiver param to a non-i32 element the callback is cloned with
// its param pinned to that element and the call rebuilt to reference the clone.
function monoPinMapLambdas(ix: i32, pNames: string[]) {
  if ix < 0 { return ix }
  const n = nodeAt(ix)
  match n {
    Block => {
      const ns: i32[] = []
      let changed = false
      let i = 0
      while i < n.blkStmts.length {
        const cs = monoPinMapLambdas(n.blkStmts[i], pNames)
        ns.push(cs)
        if cs != n.blkStmts[i] { changed = true }
        i = i + 1
      }
      if !changed { return ix }
      return mkBlock(ns, n.pos)
    }
    RetStmt => {
      const ca = monoPinMapLambdas(n.retArg, pNames)
      if ca == n.retArg { return ix }
      return mkReturn(ca, n.pos)
    }
    LetDecl => {
      const ci = monoPinMapLambdas(n.letInit, pNames)
      if ci == n.letInit { return ix }
      return monoCopyOf(ix, mkLet(n.letKw, n.letName, n.letType, ci, n.pos))
    }
    WhileStmt => {
      const cb = monoPinMapLambdas(n.whileBody, pNames)
      if cb == n.whileBody { return ix }
      return mkWhileAs(n, n.whileCond, cb)
    }
    IfStmt => {
      // An `else if` chain is rewritten along its spine, so its depth costs no stack (D1990).
      const links = monoIfChainLinks(ix)
      const ccs: i32[] = []
      const cts: i32[] = []
      let k = 0
      while k < links.length {
        const c = nodeAt(links[k])
        if c is IfStmt {
          ccs.push(c.ifCond)
          cts.push(monoPinMapLambdas(c.ifThen, pNames))
        }
        k = k + 1
      }
      return monoIfChainRebuild(
        links,
        ccs,
        cts,
        monoPinMapLambdas(monoIfChainElse(links), pNames),
      )
    }
    ForRange => {
      const cb = monoPinMapLambdas(n.frBody, pNames)
      if cb == n.frBody { return ix }
      return mkForRange(
        n.frVar,
        n.frFrom,
        n.frTo,
        n.frStep,
        n.frExcl,
        cb,
        n.frLabel,
        n.pos,
      )
    }
    ForIn => {
      const cb = monoPinMapLambdas(n.fiBody, pNames)
      if cb == n.fiBody { return ix }
      return mkForInCopy(n, n.fiIter, cb)
    }
    Paren => {
      const ci = monoPinMapLambdas(n.parInner, pNames)
      if ci == n.parInner { return ix }
      return mkParen(ci, n.pos)
    }
    // A list literal's items and a spread's source are value positions like a call's
    // arguments, so a callback under `[...p.filter(f)]` is pinned too (D2334).
    ArrayLit => {
      const es: i32[] = []
      let echanged = false
      let ei = 0
      while ei < n.arrElems.length {
        const ce = monoPinMapLambdas(n.arrElems[ei], pNames)
        es.push(ce)
        if ce != n.arrElems[ei] { echanged = true }
        ei = ei + 1
      }
      if !echanged { return ix }
      return monoRemakeListLitTpl(ix, es, n.pos)
    }
    Spread => {
      const sa = monoPinMapLambdas(n.spdArg, pNames)
      if sa == n.spdArg { return ix }
      return mkSpread(sa, n.pos)
    }
    Call => {
      if n.callFn < 0 { return ix }
      let newCallee = n.callFn
      const callee = nodeAt(n.callFn)
      // A `<paramRecv>.map/.filter(<lambda>)` over a concrete non-i32 element: pin the callback.
      if callee is Member {
        const recvNew = monoPinMapLambdas(callee.memObj, pNames)
        if recvNew != callee.memObj {
          newCallee = mkMember(recvNew, callee.memProp, callee.pos)
        }
        if callee.memProp == "map" || callee.memProp == "filter" {
          if n.callArgs.length == 1 {
            // The callback's element is the parameter the elaboration typed it with at this
            // instance, else the one signature it instanced it at, else the receiver's own.
            const cbx = unwrapParen(n.callArgs[0])
            let cbt = elabInstNodeTy(cbx, elabWalkTop())
            if cbt < 0 { cbt = elabValueInstSig(cbx) }
            const cbf = if cbt >= 0 { tyAt(cbt) } else { tyAt(0) }
            let elemTy = if cbf is TyFunc && cbf.fnParamTypes.length > 0 { cbf.fnParamTypes[0] } else { monoRecvParamElemTy(callee.memObj, pNames) }
            let elem = if elemTy >= 0 { monoPinAnnSpelling(elemTy) } else { "" }
            const armEl = monoFitArmElem(callee.memObj, elemTy)
            const armName = monoFitArmElemName(armEl)
            if armName != "" {
              elem = armName
              elemTy = armEl
            }
            if elem != "" && elem != "i32" {
              const cloned = monoCloneLambdaPinned(n.callArgs[0], elem, elemTy)
              if cloned >= 0 {
                const oneArg: i32[] = [cloned]
                return monoRemintCallTpl(ix, newCallee, oneArg)
              }
            }
          }
        }
      }
      const nargs: i32[] = []
      let changed = newCallee != n.callFn
      let ai = 0
      while ai < n.callArgs.length {
        const cca = monoPinMapLambdas(n.callArgs[ai], pNames)
        nargs.push(cca)
        if cca != n.callArgs[ai] { changed = true }
        ai = ai + 1
      }
      if !changed { return ix }
      return monoRemintCallTpl(ix, newCallee, nargs)
    }
    // every other kind is shared as it is: this pass does not descend into it
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | BinExpr | Member | OptMember | ErrExpr | Param | TypeRef | FuncDecl | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | FieldInit | ObjLit | Index | UnionDecl | IsExpr | AsExpr | MatchExpr | ImportDecl | LoopVar => {}
  }
  ix
}

// The argument-keyed instance of the specialization `monoMakeInstance` is building, which its
// bake reads; -1 outside one.
let monoBakeSpecK = -1

// The key of the keyed decision whose `monoMakeInstance` comes next, which `monoMakeInstanceGo`
// takes and clears; -1 for any other build.
let monoSpecGoK = -1

// Extend the name→index map over the instances minted since the last call, which the walk
// resolves by name before collection runs.
function monoRegisterInstance() {
  fmResumeArmed = true
  const bfmRc = buildFnMap(monoProgStmts)
  fmResumeArmed = false
  if bfmRc < 0 { return -1 }
  capMemoNoteEdit()
  0
}

// Callback specialization: rewrite a call through a closure-typed param into a direct call to the
// function `cbFnNames` bakes for it ("" leaves a `call_ref`). The elaboration's argument-keyed
// instance `specK` alone picks the calls; with -1 nothing is baked and every call keeps its `call_ref`.
function monoBakeCallback(ix: i32, cbFnNames: string[], specK: i32) {
  if ix < 0 { return ix }
  const n = nodeAt(ix)
  match n {
    Block => {
      const ns: i32[] = []
      let changed = false
      let i = 0
      while i < n.blkStmts.length {
        const cs = monoBakeCallback(n.blkStmts[i], cbFnNames, specK)
        ns.push(cs)
        if cs != n.blkStmts[i] { changed = true }
        i = i + 1
      }
      if !changed { return ix }
      return mkBlock(ns, n.pos)
    }
    RetStmt => {
      const ca = monoBakeCallback(n.retArg, cbFnNames, specK)
      if ca == n.retArg { return ix }
      return mkReturn(ca, n.pos)
    }
    LetDecl => {
      const ci = monoBakeCallback(n.letInit, cbFnNames, specK)
      if ci == n.letInit { return ix }
      return monoCopyOf(ix, mkLet(n.letKw, n.letName, n.letType, ci, n.pos))
    }
    WhileStmt => {
      const cb = monoBakeCallback(n.whileBody, cbFnNames, specK)
      if cb == n.whileBody { return ix }
      return mkWhileAs(n, n.whileCond, cb)
    }
    IfStmt => {
      // An `else if` chain is rewritten along its spine, so its depth costs no stack (D1990).
      const links = monoIfChainLinks(ix)
      const ccs: i32[] = []
      const cts: i32[] = []
      let k = 0
      while k < links.length {
        const c = nodeAt(links[k])
        if c is IfStmt {
          ccs.push(c.ifCond)
          cts.push(monoBakeCallback(c.ifThen, cbFnNames, specK))
        }
        k = k + 1
      }
      return monoIfChainRebuild(
        links,
        ccs,
        cts,
        monoBakeCallback(monoIfChainElse(links), cbFnNames, specK),
      )
    }
    ForRange => {
      const cb = monoBakeCallback(n.frBody, cbFnNames, specK)
      if cb == n.frBody { return ix }
      return mkForRange(
        n.frVar,
        n.frFrom,
        n.frTo,
        n.frStep,
        n.frExcl,
        cb,
        n.frLabel,
        n.pos,
      )
    }
    ForIn => {
      const cb = monoBakeCallback(n.fiBody, cbFnNames, specK)
      if cb == n.fiBody { return ix }
      return mkForInCopy(n, n.fiIter, cb)
    }
    Paren => {
      const ci = monoBakeCallback(n.parInner, cbFnNames, specK)
      if ci == n.parInner { return ix }
      const np = mkParen(ci, n.pos)
      nodeTyCarry(np, ix)
      return np
    }
    Call => {
      // A call whose callee names a specialized closure param `f(...)` → direct call `cbFn(...)`;
      // its arguments may themselves contain such calls, so recurse there too.
      let newCallee = n.callFn
      if n.callFn < 0 { return ix }
      const callee = nodeAt(n.callFn)
      // The elaboration's instance names the parameter a call calls through; a call it does not
      // answer there is no baked call.
      const kp = if specK >= 0 { elabSpecParamCalledAt(idCanon(ix), specK) } else { -1 }
      if (
        kp >= 0
        && kp < cbFnNames.length
        && cbFnNames[kp] != ""
        && callee is Ident
      ) {
        newCallee = mkIdent(cbFnNames[kp], callee.pos)
        identFromDecl(newCallee, elabSpecDeclFor(specK, kp))
      }
      const nargs: i32[] = []
      let changed = newCallee != n.callFn
      let ai = 0
      while ai < n.callArgs.length {
        const cca = monoBakeCallback(n.callArgs[ai], cbFnNames, specK)
        nargs.push(cca)
        if cca != n.callArgs[ai] { changed = true }
        ai = ai + 1
      }
      if !changed { return ix }
      return monoRemintCallTpl(ix, newCallee, nargs)
    }
    BinExpr => {
      // Descend into a plain assignment or arithmetic node (`acc = f(acc, x)`, the
      // reduce/fold shape). A compound-assignment node is left intact — rebuilding it
      // through `mkBinary` would drop its surface tag, and its call stays a `call_ref`.
      // The copy answers the template's type, which a `??` reads its niche off (D7452).
      if n.binCompound != "" { return ix }
      const cl = monoBakeCallback(n.binLeft, cbFnNames, specK)
      const cr = monoBakeCallback(n.binRight, cbFnNames, specK)
      if cl == n.binLeft && cr == n.binRight { return ix }
      const nb = mkBinary(n.binOp, cl, cr, n.pos)
      nodeTyCarry(nb, ix)
      if n.binRegion != 0 { markArithRegion(nb) }
      return nb
    }
    // every other kind is shared as it is: a callback call under it stays a `call_ref`
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | Unary | Member | OptMember | ErrExpr | Param | TypeRef | FuncDecl | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | FieldInit | ObjLit | ArrayLit | Index | UnionDecl | IsExpr | AsExpr | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  ix
}

// Whether the callee identifier at `calleeIx` resolves to a lifted slot the pre-pass flagged
// generic — the condition under which `monoWalk` reaches `monoInstantiate` and renames a callee
// `Ident` in place. An appended instance slot (past the frozen `monoGen` length) is concrete.
function monoCalleeIsGeneric(calleeIx: i32) {
  const fe = fnIndexOfNode(calleeIx)
  if fe < 0 { return false }
  if fe >= monoGen.length { return false }
  monoGen[fe] == 1
}

// Whether callee `calleeIx` names an un-annotated `const`, through at most eight such links, whose
// initializer names a function `monoCalleeIsGeneric` takes (D6320).
function monoCalleeConstAliasGeneric(calleeIx: i32): boolean {
  let at = calleeIx
  let depth = 0
  while depth < 8 && at >= 0 && at < P.nodes.length && nodeAt(at) is Ident {
    const d = identDeclOf(at)
    if d < 0 || d >= P.nodes.length { return false }
    const ln = nodeAt(d)
    if (
      !(ln is LetDecl)
      || ln.letKw != "const"
      || ln.letType >= 0
      || ln.letInit < 0
    ) {
      return false
    }
    at = unwrapParen(ln.letInit)
    if (
      at >= 0
      && at < P.nodes.length
      && nodeAt(at) is Ident
      && monoCalleeIsGeneric(at)
    ) {
      return true
    }
    depth = depth + 1
  }
  false
}

// ── the `is` node's per-instance twin ────────────────────────────────────────

// Four walkers re-mint or substitute an `IsExpr`, and all go through here: minting an
// `is` has a second half the `mk*` maker does not do. `isVarTyIx` — the check type the
// checker banked at the original — is keyed by node and sized at `checkProgram` entry, so
// a freshly minted node reads -1 for ever unless it is banked, demoting `emitIs` to names.
function monoMkIsExprLike(ix: i32, io: i32, variant: string) {
  const n = nodeAt(ix)
  if n is IsExpr {
    if n.isNeg == 1 { return mkIsExprNeg(io, variant, n.pos) }
    return mkIsExpr(io, variant, n.pos)
  }
  -1
}
// Re-parent onto the rewritten child `io` (the receiver, or the minted content check holding it):
// the same test, so the banked row carries.
function monoReIsExpr(ix: i32, io: i32) {
  const n = nodeAt(ix)
  if n is IsExpr {
    const nx = monoMkIsExprLike(
      ix,
      if n.isFit >= 0 { isFitObjOf(io) } else { io },
      n.isVariant,
    )
    if n.isFit >= 0 { isFitSet(nx, io) }
    // Under an instance, its own check of the shared test; else the column.
    const k = elabWalkTop()
    const kt = elabIsTyIn(ix, k)
    const kp = elabIsPatTyIn(ix, k)
    const tt = if kt >= 0 && !tyHasTyVar(kt) { kt } else { isVarTyIxOf(ix) }
    const pt = if kp >= 0 && !tyHasTyVar(kp) { kp } else { isPatTyIxOf(ix) }
    recordClonedIsVarTyIx(nx, tt)
    if pt >= 0 { isPatTyIxPut(nx, pt) }
    const lu = luIsTyOf(ix)
    if lu >= 0 { luIsTyPut(nx, lu) }
    monoIsCopyNote(nx, ix)
    return nx
  }
  ix
}
// The instance's exact type-parameter bindings while `monoFoldTyParamLayout` folds its body;
// empty outside it, and for an instance not keyed by its exact pins.
let monoFoldSubN: string[] = []
let monoFoldSubT: i32[] = []
// D951 — `is T` against the type parameter itself. Under monomorphization `T` is concrete
// per instance, so substituting the spelling makes `y is T` at `T := i32` the same program
// as `y is i32` and the whole existing ladder applies unchanged. The banked row must come
// from the new spelling: the original's is the declaration's `TyVar`, which renders empty.
function monoSubstIsExpr(ix: i32, io: i32, variant: string) {
  const n = nodeAt(ix)
  if n is IsExpr {
    // A parameter bound to a literal's `#anon` row banks the list of the row's shape as the
    // check type, which is the arm an inferred union holds for it (D5083).
    const nx = monoMkIsExprLike(ix, io, variant)
    const aty = monoAnonRowListTy(
      variant,
      substTyDeep(isVarTyIxOf(ix), monoFoldSubN, monoFoldSubT),
    )
    // Else the tested type under the instance's exact bindings, never its substituted spelling.
    const sub = if aty >= 0 { aty } else { substTyDeep(isVarTyIxOf(ix), monoFoldSubN, monoFoldSubT) }
    if sub >= 0 && !tyHasTyVar(sub) { recordClonedIsVarTyIx(nx, sub) }
    // The type is this instance's own check of the shared test (D15710), whether or not its
    // spelling parses back; an encloser's parameter left unbound keeps a type variable.
    const rec = elabIsPatTyIn(ix, elabWalkTop())
    if rec >= 0 && !tyHasTyVar(rec) {
      recordClonedIsVarTyIx(nx, rec)
    } else if aty < 0 && (sub < 0 || tyHasTyVar(sub)) {
      emitFail(
        "emitProgram: monomorphize: an `is` test at an instance has no closed tested type",
      )
    }
    // The substituted spelling's own type is the minted test's pattern type.
    if isVarTyIxOf(nx) >= 0 { isPatTyIxPut(nx, isVarTyIxOf(nx)) }
    // A list-union rewrite's test keeps its mark at the arm the instance names (D14084).
    if luIsTyOf(ix) >= 0 && isVarTyIxOf(nx) >= 0 {
      luIsTyPut(nx, isVarTyIxOf(nx))
    }
    return nx
  }
  ix
}

// The list type over the shape of a literal's `#anon` row, at the list depth of `listTy` (a list
// type, open or closed): `name` spells that row's handle with one `[]` per level (`#anon0[]` is
// `{x:i32}[]`). -1 for a `listTy` that is no list, a name that is no row handle, and a row with no
// recorded type. The depth is the type's; the name is read only as the handle.
function monoAnonRowListTy(name: string, listTy: i32): i32 {
  let depth = 0
  let t = listTy
  while t >= 0 && t < T.tys.length {
    const a = tyAt(t)
    if !(a is TyArray) { break }
    t = a.aElem
    depth = depth + 1
  }
  if depth == 0 || name.length < 2 * depth + 5 { return -1 }
  const base = name.slice(0, name.length - 2 * depth)
  if base[0] != '#' { return -1 }
  const si = structIndexByName(base)
  if si < 0 || si >= sTyIx.length || sTyIx[si] < 0 { return -1 }
  let ty = sTyIx[si]
  while depth > 0 {
    ty = mkArrayTy(ty)
    depth = depth - 1
  }
  ty
}

// The instance `monoCloneGenericCalls` is copying: its template's type parameters and their
// bindings, so an explicit type argument naming one (`make<T>()`) is substituted per instance.
let monoCgcTyParams: string[] = []
let monoCgcTvN: string[] = []
let monoCgcTvV: string[] = []
// The re-made list literals `monoLitReachesPinDefaultClash` answered for: the emitter refuses
// each rather than build it untyped or print D2816's value.
export let monoClashLits: i32[] = []

// Whether list literal `ix` is one of `monoClashLits`.
export function monoIsClashLit(ix: i32): boolean {
  monoSeenHas(monoClashLits, ix)
}
// The instance's exact bindings when it is keyed by its exact pins, so a type argument naming a
// type parameter records the exact pinned type rather than its spelling; empty otherwise.
let monoCgcSubN: string[] = []
let monoCgcSubT: i32[] = []
// The lambda bindings whose calls the instance body copies (`monoInstLamNames`): a call
// through one is instantiated per call like a generic's.
let monoCgcLamNames: string[] = []
// The callee names of those copies. An instance's call through one is by name even at the
// lambda's first instance, since the value path reads the template's element and result kinds.
let monoLamCallCallees: i32[] = []
// The module's own top-level lambda bindings, which an instance body calls as it calls its own.
let monoProgLamNames: string[] = []
// The instance's hole parameters as its key or specialization binds them, for the body clone.
let monoCgcHoleN: string[] = []
let monoCgcHoleT: i32[] = []

// The type copied call `ix` through a lambda binding answers at this instance: the instance's
// elaboration at a hole instance, or where its recorded type `t` is open and the elaboration
// closes it; `t` otherwise.
function monoLamCallTy(ix: i32, t: i32): i32 {
  const wk = elabWalkTop()
  const i0 = if wk >= 0 { elabInstNodeTy(ix, wk) } else { -1 }
  const inst = if i0 >= 0 && i0 < T.tys.length && !tyHasTyVar(i0) { i0 } else { -1 }
  const e = if monoCgcHoleN.length > 0 { elabWalkTy(ix) } else { -1 }
  if e >= 0 { return if inst >= 0 { inst } else { e } }
  if t < 0 || !tyHasTyVar(t) { return t }
  const w = elabWalkTy(ix)
  if inst >= 0 { inst }
  else if w >= 0 && w < T.tys.length && !tyHasTyVar(w) { w }
  else { t }
}

// The lambdas the instance body binds by an un-annotated `const`, once, and reads only as the
// callee of a direct call outside any lambda (`monoCollectLamDecls`).
let monoCgcLamDeclX: i32[] = []

// Appends to the table each such lambda under `body`, whose binder counts are `bn`/`bc`.
function monoCollectLamDecls(ix: i32, body: i32, bn: string[], bc: i32[]) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is LetDecl {
    if n.letKw == "const" && n.letType < 0 && n.letInit >= 0 {
      const li = unwrapParen(n.letInit)
      if (
        li >= 0
        && nodeAt(li) is FuncDecl
        && monoBinderCount(bn, bc, n.letName) == 1
        && monoNameOnlyCalled(body, n.letName, false)
      ) {
        monoCgcLamDeclX.push(li)
      }
    }
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    monoCollectLamDecls(kids[i], body, bn, bc)
    i = i + 1
  }
  0
}

// Whether every read of `name` under `ix` is the callee of a direct call outside any lambda;
// `inLam` is whether `ix` is inside one.
function monoNameOnlyCalled(ix: i32, name: string, inLam: boolean): boolean {
  if ix < 0 || ix >= P.nodes.length { return true }
  const n = nodeAt(ix)
  if n is Ident { return n.identName != name }
  let skip = -1
  if n is Call && n.callFn >= 0 {
    const cal = nodeAt(n.callFn)
    if cal is Ident {
      if cal.identName == name {
        if inLam { return false }
        skip = n.callFn
      }
    }
  }
  const lam = inLam || n is FuncDecl
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if kids[i] != skip && !monoNameOnlyCalled(kids[i], name, lam) {
      return false
    }
    i = i + 1
  }
  true
}

// Appends to `out` each name an un-annotated `let`/`const` under `ix` binds to a lambda with a
// hole parameter, which is instantiated per call, to one whose type names a hole of this
// instance's (a capture: D2900), or to a name already in `out`.
function monoLamBoundNames(ix: i32, out: string[]) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is LetDecl {
    if n.letType < 0 && n.letInit >= 0 {
      const iv = nodeAt(unwrapParen(n.letInit))
      if iv is FuncDecl {
        const li = unwrapParen(n.letInit)
        const capHole = monoCgcHoleN.length > 0 && monoLamTyNamesHoleValue(li)
        if monoIsGenericDecl(li) || capHole { monoNoteName(out, n.letName) }
      } else if iv is Ident {
        if monoStrListHas(out, iv.identName) { monoNoteName(out, n.letName) }
      }
    }
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    monoLamBoundNames(kids[i], out)
    i = i + 1
  }
  0
}

// The template slot of the generic function the flow table says read `at` names through its
// aliases (`cboxReadGenFn`); -1 for none.
function monoReadGenFnFe(at: i32): i32 {
  const d = cboxReadGenFn(at)
  if d < 0 { return -1 }
  const fe = fnStmtsPosOf(d)
  if fe < 0 || fe >= monoGen.length || monoGen[fe] != 1 { return -1 }
  fe
}

// The un-annotated `let` that a chain of un-annotated, never-written aliases read at `at` in frame
// `ctx` ends at, when that `let` is written or holds a hole lambda (`let f = g; f = h; const a =
// f`): [the node naming it, that node's frame, 1 when it is written]. [-1, -1, 0] for any other
// chain, and for a name that is that `let` itself.
function monoAliasLetEnd(at: i32, ctx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1, 0]
  let ax = at
  let fr = ctx
  let hops = 0
  while hops < MONO_ALIAS_CHAIN_MAX {
    const lf = monoReadLetFrame(ax, fr)
    if lf[1] < 0 { return none }
    const d = nodeAt(lf[1])
    if !(d is LetDecl) || d.letType >= 0 || d.letInit < 0 { return none }
    if d.letKw == "let" {
      const written = monoLetWrittenIn(lf)
      let lam = false
      if !written && monoNestedBodyOf(d.letInit) >= 0 {
        const ls = fnStmtsPosOf(d.letInit)
        lam = ls >= 0 && criFnIsAnonLambda(ls)
      }
      if written || lam {
        if hops == 0 { return none }
        let w = 0
        if written { w = 1 }
        const out: i32[] = [ax, fr, w]
        return out
      }
    }
    if monoIdentNameOf(d.letInit) == "" { return none }
    ax = d.letInit
    fr = lf[0]
    hops = hops + 1
  }
  none
}

// Renames the initializer of `const alias = tpl`, the alias read at `at` in frame `ctx`, to
// instance `inst`, so the alias's value is a closure over this frame's captures. The calls through
// the alias are renamed to their own instances; the first one names the value.
function monoRenameGenAliasInit(at: i32, ctx: i32, tpl: string, inst: string) {
  const lf = monoReadLetFrame(at, ctx)
  if lf[1] < 0 { return 0 }
  const d = nodeAt(lf[1])
  if !(d is LetDecl) || d.letInit < 0 { return 0 }
  if (
    (d.letKw != "const" && monoLetIsAssigned(d.letName, lf[1]))
    || d.letType >= 0
  ) {
    return 0
  }
  const iv = nodeAt(d.letInit)
  if !(iv is Ident) { return 0 }
  // An alias of an alias renames the link that names the generic (D3894).
  if iv.identName != tpl {
    if iv.identName == d.letName { return 0 }
    return monoRenameGenAliasInit(d.letInit, ctx, tpl, inst)
  }
  iv.identName = inst
  monoNoteRenamed(d.letInit, monoSlotOfDecl(monoFnDeclNamed(inst)))
  sidNoteNodeName(d.letInit, monoFnDeclNamed(inst))
  0
}

// The names instance body `body` binds once, by an un-annotated binding never written, to a generic function
// read by name: a call through one is renamed to the instance it reaches, which must be this
// instance's own copy of the call (D3887).
let monoCgcGenAliasNames: string[] = []
// The bindings among them that are the aliases, and the clone walk's scope over those names: a
// `+name` once an alias binds it, `-name` once another binding of it does (D4302).
let monoCgcGenAliasDecls: i32[] = []
let monoCgcAliasScope: string[] = []

// Whether the annotation at `t` spells a function type, which a binding of a generic's value
// holds one instance of per enclosing instance (D3926).
function monoAnnIsFnTy(t: i32): boolean {
  const ty = nodeTyIxOf(t)
  ty >= 0 && ty < T.tys.length && tyAt(ty) is TyFunc
}

function monoInstGenAliasNames(body: i32): string[] {
  const bn: string[] = []
  const bc: i32[] = []
  monoBinderCounts(body, bn, bc)
  const ln: string[] = []
  const lc: i32[] = []
  monoLetBinderCounts(body, ln, lc)
  const out: string[] = []
  monoCgcGenAliasDecls = []
  // An alias of an alias is found once its target is, so a pass that adds a name runs again.
  let grew = true
  let pass = 0
  while grew && pass < MONO_ALIAS_CHAIN_MAX {
    grew = false
    const stack: i32[] = [body]
    while stack.length > 0 {
      const ix = stack.pop() ?? -1
      if ix >= 0 && ix < P.nodes.length {
        const d = nodeAt(ix)
        if d is LetDecl {
          if (
            (d.letKw == "const" || !monoLetIsAssigned(d.letName, ix))
            && (d.letType < 0 || monoAnnIsFnTy(d.letType))
            && d.letInit >= 0
            && nodeAt(d.letInit) is Ident
            && (monoCalleeIsGeneric(d.letInit)
              || monoStrListHas(out, monoIdentNameOf(d.letInit)))
            && monoBinderCount(bn, bc, d.letName)
              == monoBinderCount(ln, lc, d.letName)
            && !i32ListHas(monoCgcGenAliasDecls, ix)
          ) {
            monoCgcGenAliasDecls.push(ix)
            if !monoStrListHas(out, d.letName) { out.push(d.letName) }
            grew = true
          }
        }
        // A nested function's body is its own instance's, copied there.
        if !(d is FuncDecl) || ix == body {
          for k in nodeChildren(ix) { stack.push(k) }
        }
      }
    }
    pass = pass + 1
  }
  out
}

// The lambda names whose calls instance body `body` copies: the module's and its own, less
// any name the body binds twice or shadows. A copied call is a node with no source position,
// so a name that needs one to pick its binding keeps its calls shared, as before.
function monoInstLamNames(body: i32): string[] {
  const bn: string[] = []
  const bc: i32[] = []
  monoBinderCounts(body, bn, bc)
  monoCgcLamDeclX = []
  monoCollectLamDecls(body, body, bn, bc)
  const own: string[] = []
  monoLamBoundNames(body, own)
  const out: string[] = []
  let k = 0
  while k < monoProgLamNames.length {
    const pn = monoProgLamNames[k]
    if monoBinderCount(bn, bc, pn) == 0 && !monoStrListHas(own, pn) {
      out.push(pn)
    }
    k = k + 1
  }
  k = 0
  while k < own.length {
    if monoBinderCount(bn, bc, own[k]) <= 1 { out.push(own[k]) }
    k = k + 1
  }
  out
}

// Whether lambda `li`, bound by a `const` the instance only calls directly, has a template return
// naming a type variable that the elaboration types closed, and not a function, in this instance,
// so a copied call's type is the rep the lambda returns. A value read of the binding sees the
// template's signature (D2878).
function monoLamTyNamesHoleValue(li: i32): boolean {
  const t = nodeTyIxOf(li)
  if t < 0 || !tyHasTyVar(t) { return false }
  if !i32ListHas(monoCgcLamDeclX, li) { return false }
  const ft = tyAt(t)
  if !(ft is TyFunc) || ft.fnRet < 0 || !tyHasTyVar(ft.fnRet) { return false }
  const e = elabWalkTy(li)
  if e < 0 || e >= T.tys.length { return false }
  const ef = tyAt(e)
  if ef is TyFunc {
    return ef.fnRet >= 0 && !tyHasTyVar(ef.fnRet) && !(tyAt(ef.fnRet) is TyFunc)
  }
  false
}

// How many binders `bn`/`bc` counted for `name`.
function monoBinderCount(bn: string[], bc: i32[], name: string): i32 {
  let i = 0
  while i < bn.length && i < bc.length {
    if bn[i] == name { return bc[i] }
    i = i + 1
  }
  0
}

// Counts, per name, the bindings under `ix` that resolve by position: `let`/`const`, loop
// variables and nested named functions.
function monoBinderCounts(ix: i32, bn: string[], bc: i32[]) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is LetDecl { monoBinderBump(bn, bc, n.letName) }
  if n is ForRange { monoBinderBump(bn, bc, n.frVar) }
  if n is ForIn {
    monoBinderBump(bn, bc, n.fiVar)
    if n.fiVar2 != "" { monoBinderBump(bn, bc, n.fiVar2) }
  }
  if n is FuncDecl {
    if monoFnNameIsSourceNamed(n.fnName) { monoBinderBump(bn, bc, n.fnName) }
  }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    monoBinderCounts(kids[i], bn, bc)
    i = i + 1
  }
  0
}

// Records statement `st` in the clone walk's scope when it binds a name an alias holds.
function monoCgcAliasScopeNote(st: i32) {
  if st < 0 || st >= P.nodes.length { return 0 }
  const d = nodeAt(st)
  if !(d is LetDecl) || !monoStrListHas(monoCgcGenAliasNames, d.letName) {
    return 0
  }
  if i32ListHas(monoCgcGenAliasDecls, st) {
    monoCgcAliasScope.push("+" + d.letName)
  } else {
    monoCgcAliasScope.push("-" + d.letName)
  }
  0
}

// `monoBinderCounts` over `let` and `const` bindings alone.
function monoLetBinderCounts(ix: i32, bn: string[], bc: i32[]) {
  if ix < 0 || ix >= P.nodes.length { return 0 }
  const n = nodeAt(ix)
  if n is LetDecl { monoBinderBump(bn, bc, n.letName) }
  for k in nodeChildren(ix) { monoLetBinderCounts(k, bn, bc) }
  0
}

// Whether a read of `name` in the clone walk reaches an alias `monoInstGenAliasNames` found: the
// innermost binding of it the walk has passed is one, or none is in scope.
function monoCgcAliasActive(name: string): boolean {
  if !monoStrListHas(monoCgcGenAliasNames, name) { return false }
  let i = monoCgcAliasScope.length - 1
  while i >= 0 {
    const m = monoCgcAliasScope[i]
    if m == "+" + name { return true }
    if m == "-" + name { return false }
    i = i - 1
  }
  true
}

function monoBinderBump(bn: string[], bc: i32[], name: string) {
  let i = 0
  while i < bn.length && i < bc.length {
    if bn[i] == name {
      bc[i] = bc[i] + 1
      return 0
    }
    i = i + 1
  }
  bn.push(name)
  bc.push(1)
  0
}

function monoNoteName(xs: string[], v: string) {
  if !monoStrListHas(xs, v) { xs.push(v) }
  0
}

function monoStrListHas(xs: string[], v: string): boolean {
  let i = 0
  while i < xs.length {
    if xs[i] == v { return true }
    i = i + 1
  }
  false
}

// The explicit type-argument nodes of a cloned call, each substituted under the instance
// being copied; an argument naming no type parameter is shared unchanged.
function monoSubstTyArgNodes(tas: i32[]): i32[] {
  const out: i32[] = []
  let i = 0
  while i < tas.length {
    const sub = monoSubstAnnNode(
      tas[i],
      monoCgcTyParams,
      monoCgcSubN,
      monoCgcSubT,
    )
    if sub >= 0 { out.push(sub) } else { out.push(tas[i]) }
    i = i + 1
  }
  out
}

// Whether an instance already minted in this pass carries the name `nm`.
function monoInstNameTaken(nm: string): boolean {
  for n in monoInstName {
    if n == nm { return true }
  }
  false
}

// The bindings the instance enclosing nested function `origFe` holds for type parameters
// `own` does not redeclare, appended to `outN`/`outT`: that of `callFrame`, else of the
// template's frame, else the nearest enclosing instance's. Nothing for a function that
// shadows an enclosing parameter, which a by-name binding cannot tell apart (D3840).
function monoEnclosingPinRow(
  origFe: i32,
  callFrame: i32,
  own: string[],
  outN: string[],
  outT: i32[],
) {
  if origFe < 0 || origFe >= fnParent.length { return 0 }
  let pos = fnParent[origFe]
  if callFrame >= 0 { pos = callFrame }
  let guard = 0
  while pos >= 0 && guard <= fnStmts.length {
    const row = elabKeyAtPos(pos)
    if row >= 0 && row < ekNames.length {
      const ns = ekNames[row]
      const ts = ekTys[row]
      let i = 0
      while i < ns.length && i < ts.length {
        if (
          !strListHas(own, ns[i])
          && !strListHas(outN, ns[i])
          && !tyHasTyVar(ts[i])
        ) {
          outN.push(ns[i])
          outT.push(ts[i])
        }
        i = i + 1
      }
      return 0
    }
    if pos >= fnParent.length { return 0 }
    pos = fnParent[pos]
    guard = guard + 1
  }
  0
}

// The declared type parameters a nested generic redeclares, renamed apart: each row of the
// enclosing declarer's `T` becomes `T__sh<slot>`, which that declarer's instances also bind, so
// a read typed at the outer `T` inside the nested one takes the outer pin (D3840). Parallel
// columns: the declarer's slot, the parameter's name, and its alias.
let monoShAliasSlot: i32[] = []
let monoShAliasName: string[] = []
let monoShAliasTo: string[] = []

// Renames apart every declared type parameter a nested generic among the first `nDecl` slots
// redeclares. -1 when a row belongs to both functions, which no alias can split.
function monoShadowRename(nDecl: i32): i32 {
  monoShAliasSlot = []
  monoShAliasName = []
  monoShAliasTo = []
  tyParamShadowReset()
  let fe = 0
  while fe < nDecl && fe < fnParent.length {
    const f = nodeAt(fnStmts[fe])
    if f is FuncDecl {
      if f.fnTyParams.length > 0 && monoNestedShadowsOuter(fe) {
        for tp in f.fnTyParams {
          let p = fnParent[fe]
          let guard = 0
          while p >= 0 && p < fnParent.length && guard <= fnStmts.length {
            const pf = nodeAt(fnStmts[p])
            if pf is FuncDecl {
              if strListHas(pf.fnTyParams, tp) {
                if monoShadowRenameDecl(p, fe, tp) < 0 { return -1 }
              }
            }
            p = fnParent[p]
            guard = guard + 1
          }
        }
      }
    }
    fe = fe + 1
  }
  0
}

// Renames declarer `d`'s rows of type parameter `name` apart from those of nested generic
// `inner`, which redeclares it. -1, with the failure recorded, when the two share a row.
function monoShadowRenameDecl(d: i32, inner: i32, name: string): i32 {
  let k = 0
  while k < monoShAliasSlot.length {
    if monoShAliasSlot[k] == d && monoShAliasName[k] == name { return 0 }
    k = k + 1
  }
  if d < 0 || d >= fnStmts.length || inner < 0 || inner >= fnStmts.length {
    return emitFail(
      "emitProgram: monomorphize: shadow rename names no function slot",
    )
  }
  const own = monoTyParamRows(fnStmts[d], name)
  const theirs = monoTyParamRows(fnStmts[inner], name)
  for r in own {
    if i32ListHas(theirs, r) {
      return emitFail(
        "emitProgram: a nested generic that redeclares its enclosing function's type parameter shares that parameter's type with it — rename the nested one",
      )
    }
  }
  const alias = name + "__sh" + i32ToStr(d)
  for r in own { tyVarRenameRow(r, alias) }
  elabAliasNote(alias, name, fnStmts[d])
  monoShAliasSlot.push(d)
  monoShAliasName.push(name)
  monoShAliasTo.push(alias)
  tyParamShadowNote(alias, name)
  0
}

// The type variable rows named `name` that the annotations of function node `fx` resolve to,
// its nested functions' included except those redeclaring `name`.
function monoTyParamRows(fx: i32, name: string): i32[] {
  const out: i32[] = []
  const stack: i32[] = [fx]
  while stack.length > 0 {
    const cur = stack.pop() ?? -1
    if cur >= 0 && cur < P.nodes.length {
      const nd = nodeAt(cur)
      let enter = true
      if nd is FuncDecl {
        if cur != fx && strListHas(nd.fnTyParams, name) { enter = false }
      } else if nd is TypeRef {
        monoTyVarRowsNamed(nodeTyIxOf(cur), name, out, 0)
      }
      if enter {
        for c in nodeChildren(cur) { stack.push(c) }
      }
    }
  }
  out
}

// Appends to `out` the type variable rows named `name` that type `t` holds. Bounded by depth.
function monoTyVarRowsNamed(t: i32, name: string, out: i32[], depth: i32) {
  if t < 0 || t >= T.tys.length || depth > 16 { return 0 }
  const ty = tyAt(t)
  match ty {
    TyVar => {
      if ty.tvName == name && !i32ListHas(out, t) { out.push(t) }
    }
    TyArray => {
      monoTyVarRowsNamed(ty.aElem, name, out, depth + 1)
    }
    TyNullable => {
      monoTyVarRowsNamed(ty.nInner, name, out, depth + 1)
    }
    TyMap => {
      monoTyVarRowsNamed(ty.mKey, name, out, depth + 1)
      monoTyVarRowsNamed(ty.mVal, name, out, depth + 1)
    }
    TyUnion => {
      for m in ty.uMembers { monoTyVarRowsNamed(m, name, out, depth + 1) }
    }
    TyObj => {
      for ft in ty.objFieldTypes {
        monoTyVarRowsNamed(ft, name, out, depth + 1)
      }
    }
    TyFunc => {
      for pt in ty.fnParamTypes { monoTyVarRowsNamed(pt, name, out, depth + 1) }
      monoTyVarRowsNamed(ty.fnRet, name, out, depth + 1)
    }
    TyPrim | TyLit | TyNeg | TyErr => {}
  }
  0
}

// Binds, beside each of instance `origFe`'s own parameters in `ns`/`ts`, the alias
// `monoShadowRename` gave its rows.
function monoShAliasBind(origFe: i32, ns: string[], ts: i32[]) {
  let k = 0
  while k < monoShAliasSlot.length {
    if monoShAliasSlot[k] == origFe && !strListHas(ns, monoShAliasTo[k]) {
      let i = 0
      const n0 = ns.length
      while i < n0 && i < ts.length {
        if ns[i] == monoShAliasName[k] {
          ns.push(monoShAliasTo[k])
          ts.push(ts[i])
          i = n0
        }
        i = i + 1
      }
    }
    k = k + 1
  }
  0
}

// The enclosing-frame instance `monoInstantiate` hands `monoMakeInstance` for a capturing nested
// generic called from it, consumed (and cleared) where the key is built; -1 for none.
let monoCallFrameSlot = 0 - 1
// The call node the next `monoMakeInstance` builds for, or -1; consumed by it.
let monoMakeCallIx = 0 - 1
// Callee identifiers resolved through a `let` alias chain: their calls are never re-spelled to
// the lambda's instance, since the alias may hold another value at run time (D3849).
let monoNoRename: i32[] = []
// Reads a bundle hands whole: each signature instances the binding afresh, which no write
// forces, so they are kept from rename without being taken as a reassigned binding's (D15597).
let monoBundleReads: i32[] = []
// Callee identifiers that read a `let`/`const`, keyed to that binding, once renamed to an instance.
let monoAliasCallDecl: {[i32]: i32} = Map()
// A re-pointed `let` handed to a generic arrow parameter, keyed `<frame>:<decl>`, to the function
// type its values are handed on at; a second type asks for a slot per type (D9006).
let monoWrittenLetHanded: {[string]: i32} = Map()

// Notes callee `calleeIx` before its rename to an instance, when it reads a binding.
function monoAliasCallNote(calleeIx: i32) {
  if monoAliasCallDecl.has(calleeIx) { return 0 }
  const d = identDeclOf(calleeIx)
  if d >= 0 && d < P.nodes.length && nodeAt(d) is LetDecl {
    monoAliasCallDecl.set(calleeIx, d)
  }
  0
}

// The binding callee `calleeIx` read before a rename pointed it at an instance, else -1.
export function monoAliasDeclOf(calleeIx: i32): i32 {
  monoAliasCallDecl.get(calleeIx) ?? -1
}
// Per template slot, the frame-keyed instances minted while its slot still holds the template;
// they leave the slot to the template frame's own first instance.
let monoFramedPushes: {[i32]: i32} = Map()

// The instance of nested function `fe`'s enclosing frame that `ctx` is, when that is not the
// template's own frame: a capturing nested generic needs one instance per enclosing instance,
// whose env holds that instance's captures (D3826), and a call from a function or lambda
// nested deeper in it takes it too, carrying the captures through its own env (D3827).
function monoNestedCallFrame(fe: i32, ctx: i32): i32 {
  if fe < 0 || fe >= fnParent.length || ctx < 0 { return -1 }
  const p0 = fnParent[fe]
  if p0 < 0 || captureCountOf(fe) == 0 { return -1 }
  let sl = fnStmtsPosOf(ctx)
  if sl < 0 || sl >= fnInstOrigin.length || sl >= fnParent.length { return -1 }
  // A recursive call from a frame-keyed instance keeps that instance's frame.
  if fnInstOrigin[sl] == fe { sl = fnParent[sl] }
  if sl < 0 || sl == p0 || sl >= fnInstOrigin.length { return -1 }
  if fnInstOrigin[sl] == p0 { return sl }
  let up = sl
  let guard = 0
  while up >= 0 && up < fnParent.length && guard <= fnStmts.length {
    up = fnParent[up]
    if up == p0 || up == fe { return -1 }
    // Inside an instance of the nested generic itself: that instance's frame is the answer.
    if up >= 0 && up < fnInstOrigin.length && fnInstOrigin[up] == fe {
      const own = fnParent[up]
      if own >= 0 && own < fnInstOrigin.length && fnInstOrigin[own] == p0 {
        return own
      }
      return -1
    }
    if up >= 0 && up < fnInstOrigin.length && fnInstOrigin[up] == p0 {
      return up
    }
    guard = guard + 1
  }
  -1
}

// Whether nested function `fe` declares a type parameter an enclosing function declares too.
// Type variables are substituted by name, so its instance cannot tell its own `T` from the
// enclosing one; such a function is left to the shared path (D3832).
function monoNestedShadowsOuter(fe: i32): boolean {
  if fe < 0 || fe >= monoOrigNode.length { return false }
  const f = nodeAt(monoOrigNode[fe])
  if !(f is FuncDecl) { return false }
  let p = -1
  if fe < fnParent.length { p = fnParent[fe] }
  let guard = 0
  while p >= 0 && p < monoOrigNode.length && guard <= fnStmts.length {
    const pf = nodeAt(monoOrigNode[p])
    if pf is FuncDecl {
      for tp in f.fnTyParams {
        if strListHas(pf.fnTyParams, tp) { return true }
      }
    }
    if p >= fnParent.length { return false }
    p = fnParent[p]
    guard = guard + 1
  }
  false
}

// The instance-key suffix `monoInstantiate` hands `monoMakeInstance` for a call with explicit
// type arguments, consumed (and cleared) where the key is built.
let monoKeyExtra = ""
// Each binding `monoKeyExtra` names, beside it: the type parameter, its type (-1 for none) and its
// text in the key.
let monoKeyExtraN: string[] = []
let monoKeyExtraT: i32[] = []
let monoKeyExtraS: string[] = []
// The same call's explicit bindings as arena types, consumed beside `monoKeyExtra`: the type
// column a body annotation substitutes through, which the parameters alone cannot bind for a
// type parameter no parameter mentions (D2676).
let monoExplicitBN: string[] = []
let monoExplicitBT: i32[] = []
// Which arguments of the direct call being instantiated are object literals, consumed beside
// `monoKeyExtra`: only a literal's own type is certain of its field values (D2762).
let monoPinArgLit: boolean[] = []

// Binds `typarams` to the call's explicit type arguments (their canonical spellings) in `tvN`
// / `tvV`, and stages as the key suffix the bindings of the parameters no value parameter
// mentions, the ones the pins cannot tell apart (`make<i32>()` and `make<string>()` pin nothing).
function monoBindExplicitTyArgs(
  callIx: i32,
  typarams: string[],
  params: i32[],
  tvN: string[],
  tvV: string[],
  tvT: i32[],
): i32 {
  monoExplicitBN = []
  monoExplicitBT = []
  monoKeyExtra = ""
  monoKeyExtraN = []
  monoKeyExtraT = []
  monoKeyExtraS = []
  const tas = callTyArgsOf(callIx)
  if tas.length != typarams.length { return 0 }
  let i = 0
  while i < tas.length {
    let nm = tyNameOf(tas[i])
    if nm != "" {
      const at = nodeTyIxOf(tas[i])
      // A lone string literal argument binds the literal, which the name softens (D7340).
      const lit = oneStrLitSpelling(at)
      if lit != "" && nm == "string" { nm = lit }
      if at >= 0 && tyHasTyVar(at) && tyHasTyVarWasCapped() {
        emitFail(
          "emitProgram: monomorphize: a type argument nested past 20000 levels or with more than 100000 distinct parts cannot be pinned",
        )
      }
      if at >= 0 && !tyHasTyVar(at) {
        monoExplicitBN.push(typarams[i])
        monoExplicitBT.push(at)
      }
      tvN.push(typarams[i])
      tvV.push(nm)
      // A lone string literal binds at its own literal type, the type its spelling names.
      if at >= 0 && !tyHasTyVar(at) { monoTvTyLast(tvN, tvT, at) }
      const one: string[] = [typarams[i]]
      if !elabParamsMention(params, one) {
        monoKeyExtraAdd(typarams[i], at, nm)
      }
    }
    i = i + 1
  }
  0
}

// Adds binding `tp` = `sp`, of type `t` (-1 for none), to the pending key suffix `monoKeyExtra`.
function monoKeyExtraAdd(tp: string, t: i32, sp: string) {
  monoKeyExtra = monoKeyExtra + tp + "=" + sp + ";"
  monoKeyExtraN.push(tp)
  monoKeyExtraT.push(t)
  monoKeyExtraS.push(tp + "=" + sp + ";")
  0
}

// Binds each type parameter of a call whose uses the checker joined over numeric widening at the
// number it joined them to, ahead of the arguments, as a written type argument binds (D2459).
function monoPreBindNumJoin(
  callIx: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  tvT: i32[],
) {
  const tc = monoCallTplOf(callIx)
  if !callNumJoined(tc) { return 0 }
  for tp in typarams {
    const t = if !strListHas(tvN, tp) { elabCallBindTy(tc, tp) } else { -1 }
    if t >= 0 && primNameOf(t) != null {
      tvN.push(tp)
      tvV.push(monoPinSpellShaped(t))
      monoTvTyLast(tvN, tvT, t)
    }
  }
  0
}

// Binds each of `typarams` that is still unbound in `tvN` and that the declaration owning `body`
// defaults (`elabTpDefaulted`) to the default, in the pin columns and the arena bindings, and keys
// the instance on it as an explicit type argument would, so `opT(a)` and `opT<i32, i32>(a)` share
// one instance.
function monoDefaultUnboundTyParams(
  typarams: string[],
  tvN: string[],
  tvV: string[],
  tvT: i32[],
  body: i32,
  callIx: i32,
) {
  for tp in typarams {
    if !strListHas(tvN, tp) && elabTpDefaulted(body, tp) {
      monoBindTyParamElab(callIx, tp, tvN, tvV, tvT)
    }
  }
  0
}

// Binds each of `typarams` that the annotation of `params[at]` names and the argument
// left unbound: to the checker's binding at `callIx` (`{ v: 1.5 }` for `CN<T> | null`), else to
// the default (`V[] | string` called with a string, D4913). One another parameter names, or that
// reaches a spelling the default would answer, stays unbound.
function monoDefaultAnnTyParams(
  typarams: string[],
  tvN: string[],
  tvV: string[],
  tvT: i32[],
  body: i32,
  params: i32[],
  at: i32,
  callIx: i32,
) {
  const others: i32[] = []
  let k = 0
  while k < params.length {
    if k != at { others.push(params[k]) }
    k = k + 1
  }
  let atAnn = -1
  if params[at] >= 0 {
    const pa = nodeAt(params[at])
    if pa is Param { atAnn = pa.parType }
  }
  for tp in typarams {
    const one: string[] = [tp]
    const seen: i32[] = []
    if (
      !strListHas(tvN, tp)
      && monoAnnHasTyParam(atAnn, -1, one)
      && !elabParamsMention(others, one)
      && !elabTyParamReachesSpelling(body, one, seen)
    ) {
      const bt = callBindRepTyOf(callIx, tp)
      const sp = if bt >= 0 && bt < T.tys.length && !tyHasTyVar(bt) { monoPinAnnSpelling(bt) } else { "" }
      if sp == "" {
        monoBindTyParamElab(callIx, tp, tvN, tvV, tvT)
      } else {
        tvN.push(tp)
        tvV.push(sp)
        monoTvTyLast(tvN, tvT, bt)
        if !strListHas(monoExplicitBN, tp) {
          monoExplicitBN.push(tp)
          monoExplicitBT.push(bt)
        }
      }
    }
  }
  0
}

// Whether the annotation node `annIx` is typed as a union or a nullable.
function monoAnnIsUnion(annIx: i32): boolean {
  const t = nodeTyIxOf(annIx)
  if t < 0 || t >= T.tys.length { return false }
  const ty = tyAt(t)
  (ty is TyUnion && ty.uMembers.length > 1) || ty is TyNullable
}

// Binds each type parameter of `fn` still unbound that the elaboration's instance for call
// `callIx` binds to the type of the parameter it is inferred from (`elabCallSeedBind`), as that
// parameter is bound here: its own type parameter's binding, or its pin when un-annotated.
function monoBindSeededTyParams(
  fn: FuncDecl,
  decl: i32,
  callIx: i32,
  pinned: string[],
  pinTys: i32[],
  tvN: string[],
  tvV: string[],
  tvT: i32[],
  specK: i32,
) {
  for tp in fn.fnTyParams {
    // A call in a cloned body answers from the template call the elaboration keyed (D15495).
    const et = if !strListHas(tvN, tp) { elabCallSeedBind(decl, monoCallTplOf(callIx), tp) } else { -1 }
    const pd = if et >= 0 { elabTyParamSeedParam(fn, tp) } else { -1 }
    const j = i32ListIndexOf(fn.fnParams, pd)
    let nm = ""
    let t = -1
    const ann = if j >= 0 { monoParamBareTyParam(fn.fnParams[j], fn.fnTyParams) } else { "" }
    if ann != "" {
      nm = monoBindOf(tvN, tvV, ann)
      t = monoBindTyOf(tvN, tvT, ann)
    } else if j >= 0 && monoParamUnannotated(fn.fnParams[j]) {
      nm = if j < pinned.length { pinned[j] } else { "" }
      t = if j < pinTys.length { pinTys[j] } else { -1 }
    }
    // At an argument-keyed instance the type is its base instance's binding; mono keeps the spelling.
    const kt = if nm != "" && specK >= 0 { elabSpecBindOf(specK, tp) } else { -1 }
    if kt >= 0 { t = kt }
    if nm != "" {
      if idShadowModeOf() > 0 {
        elabSeedShadow(monoCallTplOf(callIx), decl, tp, t)
      }
      tvN.push(tp)
      tvV.push(nm)
      monoTvTyLast(tvN, tvT, t)
      if t >= 0 && !strListHas(monoExplicitBN, tp) {
        monoExplicitBN.push(tp)
        monoExplicitBT.push(t)
      }
      monoKeyExtraAdd(tp, t, nm)
    }
  }
  0
}

// Whether parameter node `p` carries no annotation.
function monoParamUnannotated(p: i32): boolean {
  const pn = nodeAt(p)
  pn is Param && pn.parType < 0
}

// Binds type parameter `tp`, which call `callIx` (-1 for none) leaves unbound, to the type the
// elaboration gives it there (`elabUnboundTpTy`), spelled as an explicit type argument.
function monoBindTyParamElab(
  callIx: i32,
  tp: string,
  tvN: string[],
  tvV: string[],
  tvT: i32[],
) {
  const dt = elabUnboundTpTy(-1, -1, tp)
  const dn = monoPinAnnSpelling(dt)
  const e0 = elabUnboundTpTy(
    if callIx >= 0 { monoCallTplOf(callIx) } else { -1 },
    -1,
    tp,
  )
  const s0 = if e0 == TY_NEVER { "never" } else { monoPinAnnSpelling(e0) }
  // A binding with no spelling binds the default.
  const eb = if s0 == "" { dt } else { e0 }
  const sp = if s0 == "" { dn } else { s0 }
  tvN.push(tp)
  // `never` resolves in a result position alone, so an instance's annotations spell the
  // default where it binds, whose rep `never` takes inside a list or record (D15530).
  tvV.push(if eb == TY_NEVER { dn } else { sp })
  monoTvTyLast(tvN, tvT, eb)
  if eb >= 0 && !strListHas(monoExplicitBN, tp) {
    monoExplicitBN.push(tp)
    monoExplicitBT.push(eb)
  }
  monoKeyExtraAdd(tp, eb, sp)
  0
}

// The tagged set call `ix` dispatches through in the instance being walked: the one its callee
// carries there when the checker built that set's member calls, -1 when the instance types the
// callee with none, and the one it is noted at outside an instance.
function monoTagSetAt(ix: i32, callFn: i32): i32 {
  // The set this instance's own call goes through, as the elaboration noted it (M4).
  const own = elabCallSetIn(ix)
  if own >= 0 && fnTagSetIsTagged(own) && fnTagArmsAt(ix, own).length > 0 {
    return own
  }
  const t = elabWalkTy(callFn)
  if t < 0 {
    const noted = fnTagCallSetOf(ix)
    const ms = mintCallSoleSet(ix)
    if noted < 0 && fnTagSetIsTagged(ms) { return ms }
    return noted
  }
  const s = fnTagSetOfTy(t)
  if s >= 0 && fnTagArmsAt(ix, s).length > 0 { return s }
  // A callee read off a list or record the instance types at its rep (an element's i32 id) is
  // the set its template's facts name; one the instance types as a closure is not.
  if s >= 0 || tyAt(t) is TyFunc { return -1 }
  const tpl = monoCallTplOf(ix)
  const ms = mintCallSoleSet(tpl)
  if fnTagSetIsTagged(ms) && fnTagArmsAt(tpl, ms).length > 0 { return ms }
  -1
}

// Give an instance its own copy of every direct call to a generic or to a hole lambda's
// binding — the `Call` node and its callee `Ident` — so the per-instance rename lands on nodes
// no sibling instance can see; one shared `Ident` let the last shape to instantiate win
// (D2854). Clone-if-changed over `monoWalk`'s walk.
function monoCloneGenericCalls(ix: i32) {
  const nx = monoCloneGenericCallsRaw(ix)
  // A rebuilt node keeps the narrowings its original's calls ended (D2390).
  if nx != ix { recordClonedCallRetire(ix, nx) }
  monoKeepTplHole(ix, nx)
  monoNoteCallTpl(ix, nx)
  if nx == ix || ix < 0 || nx < 0 { return nx }
  if nodeAt(nx) is ArrayLit && monoLitReachesPinDefaultClash(ix, nx) {
    monoClashLits.push(nx)
    return nx
  }
  // A re-made node answers the type its template did, which a later pin substitutes, unless
  // its re-make recorded its own: a list literal's rep is read off that type (D2849). At a hole
  // instance an open type is the elaboration's where that closes it, as no pin substitutes a hole's.
  if nodeTyIxOf(nx) < 0 {
    const t = nodeTyIxOf(ix)
    const e = if t >= 0 && tyHasTyVar(t) && monoCgcHoleN.length > 0 { elabWalkTy(ix) } else { -1 }
    if e >= 0 && !tyHasTyVar(e) { nodeTyRecord(nx, e) }
    else if t >= 0 { nodeTyRecord(nx, t) }
  }
  nx
}

// Whether re-made list literal `nx`, whose template is `tpl` and typed `T[][]`, holds a generic
// call whose returned value is a `??` over a list with a list-literal default this instance
// builds as `T`'s pinned list: a boolean default where `T` is a number, or the reverse (D2816).
// Such a literal stays untyped, as before D2849, and the emitter refuses it.
function monoLitReachesPinDefaultClash(tpl: i32, nx: i32): boolean {
  // The pin of `X` where the elaboration types the template `X[][]` at the instance being walked.
  const lt = elabNodeTy(tpl, elabWalkTop())
  const o = if lt >= 0 && lt < T.tys.length && !tyHasTyVar(lt) { tyAt(lt) } else { null }
  const m = if o is TyArray && o.aElem >= 0 { tyAt(o.aElem) } else { null }
  const b = if m is TyArray && m.aElem >= 0 { tyPrimNameOf(m.aElem) ?? "" } else { "" }
  if b == "" { return false }
  const a = nodeAt(nx)
  if !(a is ArrayLit) { return false }
  const seen: i32[] = []
  let i = 0
  while i < a.arrElems.length {
    if monoRetReachesClash(unwrapParen(a.arrElems[i]), b, seen, 0) {
      return true
    }
    i = i + 1
  }
  false
}

// Whether value `ix` is a `??` whose default clashes with pin `b`, or a call to a generic whose
// returned value is, through any chain of such calls.
function monoRetReachesClash(
  ix: i32,
  b: string,
  seen: i32[],
  depth: i32,
): boolean {
  if ix < 0 || ix >= P.nodes.length || depth > 16 { return false }
  const n = nodeAt(ix)
  if n is BinExpr {
    if n.binOp == "??" { return monoCoalDefaultClashesPin(n, b) }
    return false
  }
  if !(n is Call) || n.callFn < 0 { return false }
  const c = nodeAt(n.callFn)
  if !(c is Ident) { return false }
  if !monoCalleeIsGeneric(n.callFn) { return false }
  const fe = fnIndexOfNode(n.callFn)
  if fe < 0 || fe >= fnStmts.length || monoSeenHas(seen, fe) { return false }
  seen.push(fe)
  const f = nodeAt(fnStmts[fe])
  if !(f is FuncDecl) { return false }
  const rets: i32[] = []
  collectValuedReturns(f.fnBody, rets)
  if f.fnBody < 0 { return false }
  const body = nodeAt(f.fnBody)
  if body is Block {
    if body.blkStmts.length > 0 {
      rets.push(body.blkStmts[body.blkStmts.length - 1])
    }
  }
  let i = 0
  while i < rets.length {
    let r = rets[i]
    const rn = nodeAt(r)
    if rn is RetStmt { r = rn.retArg }
    if monoRetReachesClash(unwrapParen(r), b, seen, depth + 1) { return true }
    i = i + 1
  }
  false
}

// Whether `xs` holds `v`.
function monoSeenHas(xs: i32[], v: i32): boolean {
  let i = 0
  while i < xs.length {
    if xs[i] == v { return true }
    i = i + 1
  }
  false
}

// Whether `??` node `n`, over a list typed by a type parameter, has a list-literal default
// whose element is boolean where pin `b` is a number, or a number where `b` is boolean.
function monoCoalDefaultClashesPin(n: BinExpr, b: string): boolean {
  const lt = nodeTyIxOf(n.binLeft)
  if lt < 0 || !tyHasTyVar(lt) { return false }
  const d = nodeAt(unwrapParen(n.binRight))
  if !(d is ArrayLit) { return false }
  if d.arrElems.length == 0 { return false }
  const et = nodeTyIxOf(d.arrElems[0])
  if et < 0 { return false }
  const dp = tyPrimNameOf(et)
  if dp == null { return false }
  const dNum = dp == "i32" || dp == "i64" || dp == "f32" || dp == "f64"
  const bNum = b == "i32" || b == "i64" || b == "f32" || b == "f64"
  (dp == "boolean" && bNum) || (dNum && b == "boolean")
}

// A fresh copy of the capture-cell read `ix` (`name[0]`), carrying its recorded types.
function monoCopyCellRead(ix: i32): i32 {
  const n = nodeAt(ix)
  if !(n is Index) { return ix }
  const a = nodeAt(n.idxArr)
  if !(a is Ident) { return ix }
  const ai = mkIdent(a.identName, a.pos)
  lfNoteMinted(ai, n.idxArr)
  identFrom(ai, n.idxArr)
  if nodeTyIxOf(n.idxArr) >= 0 { nodeTyRecord(ai, nodeTyIxOf(n.idxArr)) }
  const ri = mkIndex(ai, n.idxIndex, n.pos)
  if nodeTyIxOf(ix) >= 0 { nodeTyRecord(ri, nodeTyIxOf(ix)) }
  ri
}

// `monoCloneGenericCallsRaw`'s `Call` arm: a generic, alias, lambda or cell callee
// renamed for this instance, the arguments walked, and the type arguments substituted.
// Returns `ix` when nothing changed and the call carries no type arguments.
function monoCloneGenericCallArm(ix: i32, n: Call): i32 {
  let newCallee = n.callFn
  if n.callFn < 0 { return ix }
  const callee = nodeAt(n.callFn)
  let lamCall = false
  let cellCall = false
  if callee is Ident {
    if monoCalleeIsGeneric(n.callFn) {
      newCallee = mkIdent(callee.identName, callee.pos)
      lfNoteMinted(newCallee, n.callFn)
      identFrom(newCallee, n.callFn)
    } else if (
      monoCgcAliasActive(callee.identName)
      || monoCalleeConstAliasGeneric(n.callFn)
    ) {
      // A call through an alias never written (`const`, or an unwritten `let`) of a generic
      // function is renamed per instance too, a module one as well as one in this body.
      newCallee = mkIdent(callee.identName, callee.pos)
      lfNoteMinted(newCallee, n.callFn)
      identFrom(newCallee, n.callFn)
    } else if monoStrListHas(monoCgcLamNames, callee.identName) {
      newCallee = mkIdent(callee.identName, callee.pos)
      lfNoteMinted(newCallee, n.callFn)
      identFrom(newCallee, n.callFn)
      monoLamCallCallees.push(newCallee)
      lamCall = true
    } else if monoCalleeElems(n.callFn, -1).length > 0 {
      // A call through list elements records its callee's type per instance (D12702): the
      // elaboration's at the hole instance being built, else the template's.
      newCallee = monoCopyOf(n.callFn, mkIdent(callee.identName, callee.pos))
      lfNoteMinted(newCallee, n.callFn)
      const ce = elabWalkTy(n.callFn)
      nodeTyRecord(newCallee, if ce >= 0 { ce } else { nodeTyIxOf(n.callFn) })
    }
  } else {
    newCallee = monoCloneGenericCalls(n.callFn)
    // A call through a capture cell is retyped per instance, so it takes its own nodes (D3939).
    if newCallee == n.callFn && monoIsCellRead(n.callFn) {
      newCallee = monoCopyCellRead(n.callFn)
      cellCall = newCallee != n.callFn
    }
  }
  let changed = newCallee != n.callFn
  // A tagged call's member calls are each a generic call of this instance too, at the set its
  // callee carries in this instance.
  const tagSet = monoTagSetAt(ix, n.callFn)
  const tagArms = fnTagArmsAt(ix, tagSet)
  if (
    tagSet != fnTagCallSetOf(ix)
    && tagArms.length + fnTagCallArms(ix).length > 0
  ) {
    changed = true
  }
  const nArms: i32[] = []
  for ta in tagArms {
    const na = monoCloneGenericCalls(ta)
    nArms.push(na)
    if na != ta { changed = true }
  }
  const nargs: i32[] = []
  let ai = 0
  while ai < n.callArgs.length {
    const ca = monoCloneGenericCalls(n.callArgs[ai])
    nargs.push(ca)
    if ca != n.callArgs[ai] { changed = true }
    ai = ai + 1
  }
  const tas = callTyArgsOf(ix)
  if !changed && tas.length == 0 { return ix }
  const nc = monoRemintCall(ix, newCallee, nargs)
  if tagArms.length > 0 { fnTagCallCopy(nc, ix, tagSet, nArms) }
  // A call through a copied cell read keeps the call's recorded type.
  if cellCall && nodeTyIxOf(ix) >= 0 { nodeTyRecord(nc, nodeTyIxOf(ix)) }
  if lamCall {
    // A value call is typed by its own record, which the copy carries (D2854).
    const lt = monoLamCallTy(ix, nodeTyIxOf(ix))
    if lt >= 0 { nodeTyRecord(nc, lt) }
  }
  if tas.length > 0 {
    const noEnds: i32[] = []
    setCallTyArgs(nc, monoSubstTyArgNodes(tas), noEnds)
  }
  nc
}

function monoCloneGenericCallsRaw(ix: i32) {
  if ix < 0 { return ix }
  const n = nodeAt(ix)
  match n {
    Call => {
      return monoCloneGenericCallArm(ix, n)
    }
    Block => {
      const ns: i32[] = []
      let bchanged = false
      const scope0 = monoCgcAliasScope.length
      let i = 0
      while i < n.blkStmts.length {
        const cs = monoCloneGenericCalls(n.blkStmts[i])
        ns.push(cs)
        if cs != n.blkStmts[i] { bchanged = true }
        monoCgcAliasScopeNote(n.blkStmts[i])
        i = i + 1
      }
      while monoCgcAliasScope.length > scope0 { monoCgcAliasScope.pop() }
      if !bchanged { return ix }
      return mkBlock(ns, n.pos)
    }
    LetDecl => {
      let ci = monoCloneGenericCalls(n.letInit)
      // The alias's read of the generic is this instance's own, renamed with its calls (D3887).
      if (
        ci == n.letInit
        && n.letInit >= 0
        && i32ListHas(monoCgcGenAliasDecls, ix)
      ) {
        const iv = nodeAt(n.letInit)
        if iv is Ident {
          ci = mkIdent(iv.identName, iv.pos)
          lfNoteMinted(ci, n.letInit)
          monoCopyOf(n.letInit, ci)
        }
      }
      if ci == n.letInit { return ix }
      return monoCopyOf(ix, mkLet(n.letKw, n.letName, n.letType, ci, n.pos))
    }
    RetStmt => {
      const ca2 = monoCloneGenericCalls(n.retArg)
      if ca2 == n.retArg { return ix }
      return mkReturn(ca2, n.pos)
    }
    IfStmt => {
      // An `else if` chain is rewritten along its spine, so its depth costs no stack (D1990).
      const links = monoIfChainLinks(ix)
      const ccs: i32[] = []
      const cts: i32[] = []
      let k = 0
      while k < links.length {
        const c = nodeAt(links[k])
        if c is IfStmt {
          ccs.push(monoCloneGenericCalls(c.ifCond))
          cts.push(monoCloneGenericCalls(c.ifThen))
        }
        k = k + 1
      }
      return monoIfChainRebuild(
        links,
        ccs,
        cts,
        monoCloneGenericCalls(monoIfChainElse(links)),
      )
    }
    WhileStmt => {
      const wc = monoCloneGenericCalls(n.whileCond)
      const wb = monoCloneGenericCalls(n.whileBody)
      if wc == n.whileCond && wb == n.whileBody { return ix }
      return mkWhileAs(n, wc, wb)
    }
    ForRange => {
      const ff = monoCloneGenericCalls(n.frFrom)
      const ft = monoCloneGenericCalls(n.frTo)
      const fs = monoCloneGenericCalls(n.frStep)
      const fb = monoCloneGenericCalls(n.frBody)
      if ff == n.frFrom && ft == n.frTo && fs == n.frStep && fb == n.frBody {
        return ix
      }
      return mkForRange(n.frVar, ff, ft, fs, n.frExcl, fb, n.frLabel, n.pos)
    }
    ForIn => {
      const fi = monoCloneGenericCalls(n.fiIter)
      const fbi = monoCloneGenericCalls(n.fiBody)
      if fi == n.fiIter && fbi == n.fiBody { return ix }
      return mkForInCopy(n, fi, fbi)
    }
    BinExpr => {
      return monoCloneGenericBinArm(ix, n)
    }
    Unary => {
      // A postfix `x++`/`x--` rides a `Unary` over the assignment whose operand is the
      // mutated target — left whole for the compound form's reason. Nothing to clone in it
      // either way: the parser accepts only an identifier there, and an `Ident` holds no call.
      if n.unOp == "p+" || n.unOp == "p-" { return ix }
      const ua = monoCloneGenericCalls(n.unArg)
      if ua == n.unArg { return ix }
      return mkUnary(n.unOp, ua, n.pos)
    }
    Paren => {
      const pi = monoCloneGenericCalls(n.parInner)
      if pi == n.parInner { return ix }
      return mkParen(pi, n.pos)
    }
    // A read re-made over a cloned call keeps its source, so each instance's own type for it
    // is read there, not the template's (D15607).
    Member => {
      const mo = monoCloneGenericCalls(n.memObj)
      if mo == n.memObj { return ix }
      const nm = mkMember(mo, n.memProp, n.pos)
      nodeSrcNote(nm, ix)
      return nm
    }
    OptMember => {
      const oo = monoCloneGenericCalls(n.omObj)
      if oo == n.omObj { return ix }
      return mkOptMember(oo, n.omProp, n.omDot, n.pos)
    }
    Index => {
      const xa = monoCloneGenericCalls(n.idxArr)
      const xi = monoCloneGenericCalls(n.idxIndex)
      if xa == n.idxArr && xi == n.idxIndex { return ix }
      return mkIndex(xa, xi, n.pos)
    }
    IsExpr => {
      const io = monoCloneGenericCalls(isExprKid(n))
      if io == isExprKid(n) { return ix }
      return monoReIsExpr(ix, io)
    }
    AsExpr => {
      const ao = monoCloneGenericCalls(n.asObj)
      if ao == n.asObj { return ix }
      const na = mkAsExpr(ao, n.asTy, n.asMode, n.pos)
      nodeSrcNote(na, ix)
      return na
    }
    // A spread's source is an operand like any other (D2334).
    Spread => {
      const sa = monoCloneGenericCalls(n.spdArg)
      if sa == n.spdArg { return ix }
      return mkSpread(sa, n.pos)
    }
    ArrayLit => {
      const es: i32[] = []
      let echanged = false
      let ei = 0
      while ei < n.arrElems.length {
        const ce = monoCloneGenericCalls(n.arrElems[ei])
        es.push(ce)
        if ce != n.arrElems[ei] { echanged = true }
        ei = ei + 1
      }
      if !echanged { return ix }
      return monoCopyOf(ix, mkArrayLit(es, n.pos))
    }
    ObjLit => {
      return monoCloneGenericObjArm(ix, n)
    }
    // A generic function read as a value (a list element, a field, a binding) is renamed to
    // its instance per enclosing instance, so it gets its own node, typed at this instance (D3909).
    Ident => {
      if (
        monoCalleeIsGeneric(ix)
        || monoCgcAliasActive(n.identName)
        || monoStrListHas(monoCgcLamNames, n.identName)
      ) {
        const vi = mkIdent(n.identName, n.pos)
        lfNoteMinted(vi, ix)
        monoCopyOf(ix, vi)
        // A value nothing calls stays one in each instance's copy (D9590).
        if i32ListHas(mfrInertValues, ix) { mfrInertValues.push(vi) }
        if i32ListHas(monoHeldInert, ix) { monoHeldInert.push(vi) }
        if i32ListHas(monoArgInert, ix) { monoArgInert.push(vi) }
        elabValueSlotCopy(ix, vi)
        vrGenericCandCopy(ix, vi)
        if i32ListHas(monoInertCalled, ix) { monoInertCalled.push(vi) }
        const vt = monoLamCallTy(ix, nodeTyIxOf(ix))
        if vt >= 0 { nodeTyRecord(vi, vt) }
        return vi
      }
    }
    // every other kind is shared as it is: no generic call under it is cloned here
    NumLit | StrLit | CharLit | BoolLit | NullLit | ErrExpr | Param | TypeRef | FuncDecl | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | MatchExpr | ImportDecl | LoopVar => {}
  }
  ix
}

// `monoCloneGenericCallsRaw`'s arm for the binary or assignment `n` at `ix`.
function monoCloneGenericBinArm(ix: i32, n: BinExpr): i32 {
  // A compound assignment desugars to `target = (target op value)` with the target node
  // shared between the read and the write, so its limbs cannot be rebuilt independently:
  // re-synthesize the whole form through the maker that re-establishes that sharing. The
  // prefix `++`/`--` form has no value limb but does have a target, so it is rebuilt too.
  if n.binCompound != "" {
    const ct = monoCloneGenericCalls(n.binLeft)
    if n.binCompound == "++" || n.binCompound == "--" {
      if ct == n.binLeft { return ix }
      return mkPreIncr(n.binCompound, ct, n.pos)
    }
    const inner = nodeAt(n.binRight)
    if inner is BinExpr {
      const iv = monoCloneGenericCalls(inner.binRight)
      if iv == inner.binRight && ct == n.binLeft { return ix }
      return monoRemintCompound(n, ct, iv)
    }
    return ix
  }
  const bl = monoCloneGenericCalls(n.binLeft)
  const br = monoCloneGenericCalls(n.binRight)
  if bl == n.binLeft && br == n.binRight { return ix }
  // The copy keeps the operator, so it answers the checked type of the node it re-makes.
  const nb = mkBinary(n.binOp, bl, br, n.pos)
  nodeSrcNote(nb, ix)
  nodeTyCarry(nb, ix)
  nb
}

// `monoCloneGenericCallsRaw`'s arm for the object literal `n` at `ix`.
function monoCloneGenericObjArm(ix: i32, n: ObjLit): i32 {
  const fl: i32[] = []
  let ochanged = false
  let oi = 0
  while oi < n.objFields.length {
    let nf = n.objFields[oi]
    const f = nodeAt(nf)
    if f is FieldInit {
      const cv = monoCloneGenericCalls(f.fiValue)
      if cv != f.fiValue {
        nf = mkFieldInit(f.fiName, cv, f.pos)
        ochanged = true
      }
    }
    fl.push(nf)
    oi = oi + 1
  }
  if !ochanged { return ix }
  monoCopyOf(ix, mkObjLit(fl, n.pos))
}

// ── the per-instance layout fold: `T.size` / `T.<field>` ─────────────────────

// A generic body may read the layout of one of its type parameters — the stride a row
// accessor multiplies by, and the field offsets it adds. The checker types those members
// `i32` and leaves the `Member` node standing, because the constant does not exist until a
// binding does, and the binding is this pass's. Clone-if-changed, like every rung here.

// ── the two questions `dispatchRewrite` asks of a hole, re-asked at the pin ──

// `dispatchRewrite` runs before monomorphization, so inside a generic body its `BinExpr`
// arm asks both questions of an operand whose type is still a type parameter, and both
// degrade to no on a hole. One rung, and it must live here: the pinned type exists nowhere
// else. The two arms below are separately load-bearing — do not collapse them.

// The type of a body read of a monomorphized parameter (the name matches one, and the checked
// type is still open, so a shadowing local is not one), else -1: the elaboration's type at the
// read in the instance being walked, else the parameter's pin `pTys[i]`, which stands where that
// type is open or missing (a hole function list's id rep).
function monoPinnedOperandTy(ix: i32, pNames: string[], pTys: i32[]) {
  if ix < 0 { return -1 }
  const e = nodeAt(ix)
  if e is Ident {
    if !tyHasTyVar(nodeTyIxOf(ix)) { return -1 }
    let i = 0
    while i < pNames.length {
      if pNames[i] == e.identName {
        const top = elabWalkTop()
        const et = if top >= 0 { elabNodeTy(ix, top) } else { -1 }
        if (
          et >= 0
          && et < T.tys.length
          && elabTyClosed(et, 0)
          && !tyHasTyVar(et)
          && !tyHasHole(et)
        ) {
          return et
        }
        if i < pTys.length { return pTys[i] }
        return -1
      }
      i = i + 1
    }
  }
  -1
}

// Whether `ix` is a chain of list-element and field reads ending at a pinned parameter, each
// element read over a list; a map read can miss, so a read through a map is not one (D9915).
function monoPinnedReadGate(ix: i32, pNames: string[], pTys: i32[]): boolean {
  const u = unwrapParen(ix)
  if u < 0 { return false }
  const e = nodeAt(u)
  if e is Index {
    const at = elabNodeTy(e.idxArr, elabWalkTop())
    if at < 0 || at >= T.tys.length || !(tyAt(at) is TyArray) { return false }
    return monoPinnedReadGate(e.idxArr, pNames, pTys)
  }
  if e is Member { return monoPinnedReadGate(e.memObj, pNames, pTys) }
  monoPinnedOperandTy(u, pNames, pTys) >= 0
}

// `pNames`/`pTys` without `name` into `outN`/`outT`: a binding of that name shadows the parameter.
function monoPinDrop(
  name: string,
  pNames: string[],
  pTys: i32[],
  outN: string[],
  outT: i32[],
) {
  let i = 0
  while i < pNames.length {
    if pNames[i] != name {
      outN.push(pNames[i])
      if i < pTys.length { outT.push(pTys[i]) } else { outT.push(-1) }
    }
    i = i + 1
  }
  0
}

// `v == null` / `v != null` (either side) over a pinned parameter whose pin proves non-null, as
// the boolean literal it always yields; -1 for any other compare.
function monoDeadNullTest(n: BinExpr, pNames: string[], pTys: i32[]): i32 {
  const l = unwrapParen(n.binLeft)
  const r = unwrapParen(n.binRight)
  if l < 0 || r < 0 { return -1 }
  let opIx = -1
  if nodeAt(r) is NullLit && !(nodeAt(l) is NullLit) { opIx = l }
  if nodeAt(l) is NullLit && !(nodeAt(r) is NullLit) { opIx = r }
  if opIx < 0 { return -1 }
  const pt = monoPinnedOperandTy(opIx, pNames, pTys)
  if pt < 0 { return -1 }
  if !tyProvesNonNull(pt) { return -1 }
  if n.binOp == "!=" { return mkBool(1, n.pos) }
  mkBool(0, n.pos)
}

// The template `FuncDecl` of the instance `monoPinBinOps` rewrites, whose scope gives a minted
// `self`-function call its defaults (-1 outside), and the instance's argument types beside the
// pinned ones (-1 where unknown).
let monoPinCtx = -1
let monoPinArgTys: i32[] = []

// `monoPinBinOps`'s `BinExpr` arm: the operator rewrites themselves, over operands already
// walked. Returns `ix` when nothing changed, else the rewritten node.
function monoPinBin(ix: i32, n: BinExpr, pNames: string[], pTys: i32[]): i32 {
  // A compound assignment shares its target node between the read and the write, so its
  // limbs cannot be rebuilt independently — left whole, exactly as
  // `monoFoldTyParamLayout` leaves it.
  if n.binCompound != "" { return ix }
  const bl = monoPinBinOps(n.binLeft, pNames, pTys)
  const br = monoPinBinOps(n.binRight, pNames, pTys)
  const plt = monoPinnedOperandTy(n.binLeft, pNames, pTys)
  if plt >= 0 {
    // D512: the pin provably admits no null, so `??` is the identity on its left
    // operand. `tyExcludesNull` is the same predicate `nodeTyExcludesNull` asks of a
    // node, shared so the two homes cannot disagree.
    if n.binOp == "??" {
      if tyExcludesNull(plt) { return bl }
    }
  }
  // The same fold over a list element or record field of a pinned parameter (D9915).
  if n.binOp == "??" && plt < 0 {
    const prt = if monoPinnedReadGate(n.binLeft, pNames, pTys) { elabNodeTy(n.binLeft, elabWalkTop()) } else { -1 }
    if tyExcludesNull(prt) { return bl }
  }
  // D2802: the direct twin's dead null test. A pinned parameter read has no effect, so a
  // pin that admits no null answers `== null` false and `!= null` true.
  if n.binOp == "==" || n.binOp == "!=" {
    const dnt = monoDeadNullTest(n, pNames, pTys)
    if dnt >= 0 { return dnt }
  }
  if plt >= 0 {
    // D511: an object pin with a free `self`-function named for the operator. The name is
    // receiver-keyed (`+@Vec3`), so a generic body's `a + b` at a concrete object pin
    // resolves from the pinned left type to that type's own operator (B14 generalized).
    if drwDispatchOp(n.binOp) {
      const pot = tyAt(plt)
      if pot is TyObj {
        const opFn = opSelfFnNameForRecv(n.binOp, plt)
        if opFn != "" {
          const oargs: i32[] = []
          oargs.push(bl)
          oargs.push(br)
          const opCallee = mkIdent(opFn, -1)
          identFromDecl(opCallee, monoFnDeclNamed(opFn))
          return mkCall(opCallee, oargs, -1)
        }
      }
    }
  }
  if bl == n.binLeft && br == n.binRight { return ix }
  // The copy keeps the operator, so it answers the checked type of the node it re-makes.
  const nb = mkBinary(n.binOp, bl, br, n.pos)
  nodeSrcNote(nb, ix)
  nodeTyCarry(nb, ix)
  nb
}

// `monoPinBinOps`'s `Block` arm: each statement walked under the pins still in scope.
// Returns `ix` when no statement changed.
function monoPinBlock(ix: i32, n: Block, pNames: string[], pTys: i32[]): i32 {
  const ns: i32[] = []
  let bchanged = false
  // A local that shadows a parameter ends the parameter's pin for the rest of the block.
  let bNames = pNames
  let bTys = pTys
  let i = 0
  while i < n.blkStmts.length {
    const cs = monoPinBinOps(n.blkStmts[i], bNames, bTys)
    ns.push(cs)
    if cs != n.blkStmts[i] { bchanged = true }
    const sd = nodeAt(n.blkStmts[i])
    if sd is LetDecl {
      const dN: string[] = []
      const dT: i32[] = []
      monoPinDrop(sd.letName, bNames, bTys, dN, dT)
      bNames = dN
      bTys = dT
    }
    i = i + 1
  }
  if !bchanged { return ix }
  mkBlock(ns, n.pos)
}

// `drwWalk`'s member-call arm for a receiver typed by a type parameter, which it
// leaves to each instance: built-in, then field, then the `self`-function, asked of the
// argument's own type (`memberRungOnTy`, D2517) — a `Set`'s pin name spells its map rep.
// An unpinned deferred call takes the function. Returns -1 when no rung rewrites the call.
function monoPinMemberCall(
  ix: i32,
  n: Call,
  pcallee: Member,
  nargs: i32[],
  pNames: string[],
  pTys: i32[],
): i32 {
  const precvTy = monoPinnedOperandTy(pcallee.memObj, pNames, pTys)
  let precvArgTy = precvTy
  if monoPinArgTys.length == pTys.length {
    const pat = monoPinnedOperandTy(pcallee.memObj, pNames, monoPinArgTys)
    if pat >= 0 && !tyHasTyVar(pat) { precvArgTy = pat }
  }
  let prung = MC_RUNG_BUILTIN
  if precvArgTy >= 0 { prung = memberRungOnTy(precvArgTy, pcallee.memProp) }
  else if drwMemberDeferred(ix) { prung = 0 }
  // A map's `get` is the read `m[k]`, as `drwWalk` spells it on a concrete map (D1522),
  // over a receiver node that carries the pinned map type the read lowers by.
  if prung == MC_RUNG_BUILTIN && precvTy >= 0 && pcallee.memProp == "get" {
    const pro = nodeAt(pcallee.memObj)
    if nargs.length == 1 && tyIsMap(precvTy) && pro is Ident {
      const prIx = mkIdent(pro.identName, pro.pos)
      identFrom(prIx, pcallee.memObj)
      nodeTyRecord(prIx, precvTy)
      const pmg = mkIndex(prIx, nargs[0], n.pos)
      nodeTyCarry(pmg, ix)
      // A map of a tagged set's ids reads `F | null` at the pinned map's value, not the call's
      // open type, so the read is boxed as the id it is.
      if monoTagMapTy(precvTy) {
        const pm = tyAt(precvTy)
        if pm is TyMap {
          nodeTyRecord(pmg, mkNullableTy(pm.mVal))
          // The collect pass that boxes a function map's read (D15139) has run; this read is
          // minted after it, so it asks for its box itself.
          collectFnTagMapReadBox(pmg)
        }
      }
      return pmg
    }
  }
  // Any other receiver the instance's elaboration types as a map (`a.g`, a local copy) reads
  // the same way, as its `a.g[k]` spelling already does (D15153).
  if prung == MC_RUNG_BUILTIN && pcallee.memProp == "get" && nargs.length == 1 {
    if tyIsMap(elabWalkTy(pcallee.memObj)) {
      const pmg2 = mkIndex(pcallee.memObj, nargs[0], n.pos)
      nodeTyCarry(pmg2, ix)
      return pmg2
    }
  }
  if prung == 0 {
    // The site's own alias, not the plain property: the module merge mangles a free
    // `self`-function and leaves the call's property plain, and `ix` is the node the
    // merge walk banked its answer on.
    let puName = ufcsAliasAtSite(ix, pcallee.memProp)
    // An overloaded name picks its candidate by this instance's receiver (`ovPinCheck`).
    const puRow = ovSiteSetOf(ix)
    let puDecl = drwSelfDeclAt(ix, nargs.length + 1)
    if puRow >= 0 && precvArgTy >= 0 {
      const puPick = ovPickFor(puRow, precvArgTy)
      if puPick != "" && puPick != "*" {
        puName = puPick
        puDecl = -2
      }
    }
    if puDecl >= 0 { puName = binderNameAt(puDecl) }
    let puOk = puDecl >= 0
    if puDecl == -2 { puOk = drwSelfFnOf(puName, nargs.length + 1) >= 0 }
    if puOk {
      const puArgs: i32[] = []
      puArgs.push(pcallee.memObj)
      let pu = 0
      while pu < nargs.length {
        puArgs.push(nargs[pu])
        pu = pu + 1
      }
      // The injected receiver is an unnamed slot-0 positional; an all-positional call
      // keeps its empty name list so `hasNamedArgs` stays false downstream.
      const puNames: string[] = []
      if hasNamedArgs(n.callArgNames) {
        puNames.push("")
        let pn = 0
        while pn < n.callArgNames.length {
          puNames.push(n.callArgNames[pn])
          pn = pn + 1
        }
      }
      const puFn = mkIdent(puName, -1)
      // A `self` lambda is the binding itself; a declared function, this pass's copy of it.
      if puDecl >= 0 && memberMethodOf(ix) != puDecl {
        identFromDecl(puFn, puDecl)
      } else {
        identFromDecl(puFn, monoFnDeclNamed(puName))
      }
      noteCallOrigin(puFn, ix)
      const puCall = mkCallN(puFn, puArgs, puNames, n.pos)
      nodeSrcNote(puCall, ix)
      drwFillDefaults(puCall, monoPinCtx)
      nodeTyCarry(puCall, ix)
      return puCall
    }
  }
  -1
}

// `monoPinBinOps`'s `Call` arm: the callee and arguments walked, then the member-call
// rungs. Returns `ix` when nothing changed.
function monoPinCall(ix: i32, n: Call, pNames: string[], pTys: i32[]): i32 {
  const cf = monoPinBinOps(n.callFn, pNames, pTys)
  let changed = cf != n.callFn
  const nargs: i32[] = []
  let ai = 0
  while ai < n.callArgs.length {
    const ca2 = monoPinBinOps(n.callArgs[ai], pNames, pTys)
    nargs.push(ca2)
    if ca2 != n.callArgs[ai] { changed = true }
    ai = ai + 1
  }
  if n.callFn >= 0 {
    const pcallee = nodeAt(n.callFn)
    if pcallee is Member {
      const mc = monoPinMemberCall(ix, n, pcallee, nargs, pNames, pTys)
      if mc >= 0 {
        // The lowered direct call answers from the member call the checker bound.
        monoNoteCallTpl(ix, mc)
        return mc
      }
    }
  }
  if !changed { return ix }
  monoRemintCallTpl(ix, cf, nargs)
}

// `drwWalk`'s `BinExpr` arm, re-run over one instance body with the pin in hand. The two
// rewrites are the same two `drwWalk` makes, so a pinned cell reaches exactly the lowering
// its direct twin reaches. The field-closure dispatch route is deliberately not here: it
// needs the emitter's struct table row, which cannot be asked for from a type.
function monoPinBinOps(ix: i32, pNames: string[], pTys: i32[]) {
  if ix < 0 { return ix }
  const n = nodeAt(ix)
  match n {
    BinExpr => {
      // A `??` folded to its operand at an interpolation hole stays the hole (D4166).
      const r = monoPinBin(ix, n, pNames, pTys)
      monoKeepTplHole(ix, r)
      return r
    }
    Block => {
      return monoPinBlock(ix, n, pNames, pTys)
    }
    LetDecl => {
      const ci = monoPinBinOps(n.letInit, pNames, pTys)
      if ci == n.letInit { return ix }
      return monoCopyOf(ix, mkLet(n.letKw, n.letName, n.letType, ci, n.pos))
    }
    RetStmt => {
      const ca = monoPinBinOps(n.retArg, pNames, pTys)
      if ca == n.retArg { return ix }
      return mkReturn(ca, n.pos)
    }
    IfStmt => {
      // An `else if` chain is rewritten along its spine, so its depth costs no stack (D1990).
      const links = monoIfChainLinks(ix)
      const ccs: i32[] = []
      const cts: i32[] = []
      let k = 0
      while k < links.length {
        const c = nodeAt(links[k])
        if c is IfStmt {
          ccs.push(monoPinBinOps(c.ifCond, pNames, pTys))
          cts.push(monoPinBinOps(c.ifThen, pNames, pTys))
        }
        k = k + 1
      }
      return monoIfChainRebuild(
        links,
        ccs,
        cts,
        monoPinBinOps(monoIfChainElse(links), pNames, pTys),
      )
    }
    WhileStmt => {
      const wc = monoPinBinOps(n.whileCond, pNames, pTys)
      const wb = monoPinBinOps(n.whileBody, pNames, pTys)
      if wc == n.whileCond && wb == n.whileBody { return ix }
      return mkWhileAs(n, wc, wb)
    }
    ForRange => {
      const ff = monoPinBinOps(n.frFrom, pNames, pTys)
      const ft = monoPinBinOps(n.frTo, pNames, pTys)
      const fs = monoPinBinOps(n.frStep, pNames, pTys)
      const frN: string[] = []
      const frT: i32[] = []
      monoPinDrop(n.frVar, pNames, pTys, frN, frT)
      const fb = monoPinBinOps(n.frBody, frN, frT)
      if ff == n.frFrom && ft == n.frTo && fs == n.frStep && fb == n.frBody {
        return ix
      }
      return mkForRange(n.frVar, ff, ft, fs, n.frExcl, fb, n.frLabel, n.pos)
    }
    ForIn => {
      const fi = monoPinBinOps(n.fiIter, pNames, pTys)
      const fiN: string[] = []
      const fiT: i32[] = []
      monoPinDrop(n.fiVar, pNames, pTys, fiN, fiT)
      const fi2N: string[] = []
      const fi2T: i32[] = []
      monoPinDrop(n.fiVar2, fiN, fiT, fi2N, fi2T)
      const fbi = monoPinBinOps(n.fiBody, fi2N, fi2T)
      if fi == n.fiIter && fbi == n.fiBody { return ix }
      return mkForInCopy(n, fi, fbi)
    }
    Call => {
      return monoPinCall(ix, n, pNames, pTys)
    }
    Unary => {
      // A postfix `x++`/`x--` rides a `Unary` over the assignment whose operand is the
      // mutated target — left whole for the compound form's reason.
      if n.unOp == "p+" || n.unOp == "p-" { return ix }
      const ua = monoPinBinOps(n.unArg, pNames, pTys)
      if ua == n.unArg { return ix }
      return mkUnary(n.unOp, ua, n.pos)
    }
    Paren => {
      const pi = monoPinBinOps(n.parInner, pNames, pTys)
      if pi == n.parInner { return ix }
      return mkParen(pi, n.pos)
    }
    Member => {
      const mo = monoPinBinOps(n.memObj, pNames, pTys)
      if mo == n.memObj { return ix }
      return mkMember(mo, n.memProp, n.pos)
    }
    OptMember => {
      const oo = monoPinBinOps(n.omObj, pNames, pTys)
      if oo == n.omObj { return ix }
      return mkOptMember(oo, n.omProp, n.omDot, n.pos)
    }
    Index => {
      const ia = monoPinBinOps(n.idxArr, pNames, pTys)
      const ii = monoPinBinOps(n.idxIndex, pNames, pTys)
      if ia == n.idxArr && ii == n.idxIndex { return ix }
      return mkIndex(ia, ii, n.pos)
    }
    IsExpr => {
      const io = monoPinBinOps(isExprKid(n), pNames, pTys)
      if io == isExprKid(n) { return ix }
      return monoReIsExpr(ix, io)
    }
    AsExpr => {
      const ao = monoPinBinOps(n.asObj, pNames, pTys)
      if ao == n.asObj { return ix }
      const na = mkAsExpr(ao, n.asTy, n.asMode, n.pos)
      nodeSrcNote(na, ix)
      return na
    }
    // A spread's source is an operand like any other (D2334).
    Spread => {
      const sa = monoPinBinOps(n.spdArg, pNames, pTys)
      if sa == n.spdArg { return ix }
      return mkSpread(sa, n.pos)
    }
    ArrayLit => {
      const es: i32[] = []
      let echanged = false
      let ei = 0
      while ei < n.arrElems.length {
        const ce = monoPinBinOps(n.arrElems[ei], pNames, pTys)
        es.push(ce)
        if ce != n.arrElems[ei] { echanged = true }
        ei = ei + 1
      }
      if !echanged { return ix }
      return monoRemakeListLitTpl(ix, es, n.pos)
    }
    ObjLit => {
      const fl: i32[] = []
      let ochanged = false
      let oi = 0
      while oi < n.objFields.length {
        let nf = n.objFields[oi]
        const f = nodeAt(nf)
        if f is FieldInit {
          const cv = monoPinBinOps(f.fiValue, pNames, pTys)
          if cv != f.fiValue {
            nf = mkFieldInit(f.fiName, cv, f.pos)
            ochanged = true
          }
        }
        fl.push(nf)
        oi = oi + 1
      }
      if !ochanged { return ix }
      const nol = monoCopyOf(ix, mkObjLit(fl, n.pos))
      nodeTyCarry(nol, ix)
      return nol
    }
    // every other kind is shared as it is: no operator under it is pinned here
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | ErrExpr | Param | TypeRef | FuncDecl | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | MatchExpr | ImportDecl | LoopVar => {}
  }
  ix
}

// The layout constant `T.size` / `T.<field>` at `ix`, for a type parameter `mo` read through
// member `n`: the byte layout of the `flat` type the instance being built binds it to, as a
// number literal. Both folds run inside `monoMakeInstanceGo`, whose binding `tvN` names. An
// unbound, untyped, non-`flat` or field-less read fails loudly and answers `ix`.
function monoLayoutConstOf(ix: i32, n: Member, mo: Ident, tvN: string[]): i32 {
  if !strListHas(tvN, mo.identName) {
    emitFail(
      "emitProgram: monomorphize: `"
        + mo.identName
        + "."
        + n.memProp
        + "` needs `"
        + mo.identName
        + "` bound by a parameter — a layout constant is per-instance",
    )
    return ix
  }
  const bt = monoBindTyOf(monoInstBindN, monoInstBindT, mo.identName)
  if bt < 0 {
    return emitFail(
      "emitProgram: monomorphize: the layout constant `"
        + mo.identName
        + "."
        + n.memProp
        + "` reached an instance that binds `"
        + mo.identName
        + "` to no type",
    )
  }
  // Every call pins `T.member` against its binding (`flatLayoutPinMsg`), so a miss is a floor.
  const v = flatConstOfTyProp(bt, n.memProp)
  if v < 0 {
    emitFail(
      "emitProgram: monomorphize: the layout constant `"
        + mo.identName
        + "."
        + n.memProp
        + "` reached an instance at `"
        + tyToStr(bt)
        + "`, which the call's pin refuses",
    )
    return ix
  }
  return mkNumTyped(i32ToStr(v), n.pos, TY_I32)
}

// `monoFoldTyParamLayout`'s arm for the binary `n` at `ix`. A compound assignment shares its
// target node between the read and the write, so its limbs cannot be rebuilt independently:
// the whole form is re-synthesized through the maker that re-establishes that sharing.
function monoFoldLayoutBin(
  ix: i32,
  n: BinExpr,
  typarams: string[],
  tvN: string[],
  tvV: string[],
): i32 {
  if n.binCompound != "" {
    const ct2 = monoFoldTyParamLayout(n.binLeft, typarams, tvN, tvV)
    if n.binCompound == "++" || n.binCompound == "--" {
      if ct2 == n.binLeft { return ix }
      return mkPreIncr(n.binCompound, ct2, n.pos)
    }
    const inner = nodeAt(n.binRight)
    if inner is BinExpr {
      const iv = monoFoldTyParamLayout(inner.binRight, typarams, tvN, tvV)
      if iv == inner.binRight && ct2 == n.binLeft { return ix }
      return monoRemintCompound(n, ct2, iv)
    }
    return ix
  }
  const bl = monoFoldTyParamLayout(n.binLeft, typarams, tvN, tvV)
  const br = monoFoldTyParamLayout(n.binRight, typarams, tvN, tvV)
  if bl == n.binLeft && br == n.binRight { return ix }
  // The copy keeps the operator, so it answers the checked type of the node it re-makes.
  const nb = mkBinary(n.binOp, bl, br, n.pos)
  nodeSrcNote(nb, ix)
  nodeTyCarry(nb, ix)
  nb
}

// The body at `ix` with each type parameter's layout reads folded to this instance's constants.
// A rebuilt node carries the checked type of the node it replaces: the fold keeps every value's type.
function monoFoldTyParamLayout(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
): i32 {
  const r = monoFoldLayoutAt(ix, typarams, tvN, tvV)
  if r != ix && nodeTyIxOf(r) < 0 { nodeTyCarry(r, ix) }
  r
}

// `monoFoldTyParamLayout`'s rebuild of the one node at `ix`.
function monoFoldLayoutAt(
  ix: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
): i32 {
  if ix < 0 { return ix }
  const n = nodeAt(ix)
  match n {
    Member => {
      const mo = nodeAt(n.memObj)
      if mo is Ident {
        if (
          strListHas(typarams, mo.identName)
          && !gaeParamShadowed(mo.identName)
        ) {
          return monoLayoutConstOf(ix, n, mo, tvN)
        }
      }
      const mc = monoFoldTyParamLayout(n.memObj, typarams, tvN, tvV)
      if mc == n.memObj { return ix }
      return mkMember(mc, n.memProp, n.pos)
    }
    Block => {
      const ns: i32[] = []
      let bchanged = false
      let i = 0
      while i < n.blkStmts.length {
        const cs = monoFoldTyParamLayout(n.blkStmts[i], typarams, tvN, tvV)
        ns.push(cs)
        if cs != n.blkStmts[i] { bchanged = true }
        i = i + 1
      }
      if !bchanged { return ix }
      return mkBlock(ns, n.pos)
    }
    LetDecl => {
      const ci = monoFoldTyParamLayout(n.letInit, typarams, tvN, tvV)
      if ci == n.letInit { return ix }
      return monoCopyOf(ix, mkLet(n.letKw, n.letName, n.letType, ci, n.pos))
    }
    RetStmt => {
      const ca = monoFoldTyParamLayout(n.retArg, typarams, tvN, tvV)
      if ca == n.retArg { return ix }
      return mkReturn(ca, n.pos)
    }
    IfStmt => {
      // An `else if` chain is rewritten along its spine, so its depth costs no stack (D1990).
      const links = monoIfChainLinks(ix)
      const ccs: i32[] = []
      const cts: i32[] = []
      let k = 0
      while k < links.length {
        const c = nodeAt(links[k])
        if c is IfStmt {
          ccs.push(monoFoldTyParamLayout(c.ifCond, typarams, tvN, tvV))
          cts.push(monoFoldTyParamLayout(c.ifThen, typarams, tvN, tvV))
        }
        k = k + 1
      }
      return monoIfChainRebuild(
        links,
        ccs,
        cts,
        monoFoldTyParamLayout(monoIfChainElse(links), typarams, tvN, tvV),
      )
    }
    WhileStmt => {
      const wc = monoFoldTyParamLayout(n.whileCond, typarams, tvN, tvV)
      const wb = monoFoldTyParamLayout(n.whileBody, typarams, tvN, tvV)
      if wc == n.whileCond && wb == n.whileBody { return ix }
      return mkWhileAs(n, wc, wb)
    }
    ForRange => {
      const ff = monoFoldTyParamLayout(n.frFrom, typarams, tvN, tvV)
      const ft = monoFoldTyParamLayout(n.frTo, typarams, tvN, tvV)
      const fs = monoFoldTyParamLayout(n.frStep, typarams, tvN, tvV)
      const fb = monoFoldTyParamLayout(n.frBody, typarams, tvN, tvV)
      if ff == n.frFrom && ft == n.frTo && fs == n.frStep && fb == n.frBody {
        return ix
      }
      return mkForRange(n.frVar, ff, ft, fs, n.frExcl, fb, n.frLabel, n.pos)
    }
    ForIn => {
      const fi = monoFoldTyParamLayout(n.fiIter, typarams, tvN, tvV)
      const fbi = monoFoldTyParamLayout(n.fiBody, typarams, tvN, tvV)
      if fi == n.fiIter && fbi == n.fiBody { return ix }
      return mkForInCopy(n, fi, fbi)
    }
    Call => {
      return monoFoldLayoutCall(ix, n, typarams, tvN, tvV)
    }
    BinExpr => {
      return monoFoldLayoutBin(ix, n, typarams, tvN, tvV)
    }
    Unary => {
      // A postfix `x++`/`x--` rides a `Unary` over the assignment whose operand is
      // the mutated target — left whole for the compound form's reason.
      if n.unOp == "p+" || n.unOp == "p-" { return ix }
      const ua = monoFoldTyParamLayout(n.unArg, typarams, tvN, tvV)
      if ua == n.unArg { return ix }
      return mkUnary(n.unOp, ua, n.pos)
    }
    Paren => {
      const pi = monoFoldTyParamLayout(n.parInner, typarams, tvN, tvV)
      if pi == n.parInner { return ix }
      return mkParen(pi, n.pos)
    }
    OptMember => {
      const oo = monoFoldTyParamLayout(n.omObj, typarams, tvN, tvV)
      if oo == n.omObj { return ix }
      return mkOptMember(oo, n.omProp, n.omDot, n.pos)
    }
    Index => {
      const xa = monoFoldTyParamLayout(n.idxArr, typarams, tvN, tvV)
      const xi = monoFoldTyParamLayout(n.idxIndex, typarams, tvN, tvV)
      if xa == n.idxArr && xi == n.idxIndex { return ix }
      return mkIndex(xa, xi, n.pos)
    }
    IsExpr => {
      const io = monoFoldTyParamLayout(isExprKid(n), typarams, tvN, tvV)
      // A test naming a type parameter takes the instance's own check of it (D951, D15710),
      // spelled by the naming rule; a concrete test returns verbatim. A type parameter the
      // instance holds no typed binding for is one its encloser leaves unbound, so its test
      // stays refused (D4551).
      if monoAnnHasTyParam(ix, isVarTyIxOf(ix), typarams) {
        let bound = true
        for tp in typarams {
          const bq = strListIndexOf(monoInstBindN, tp)
          const bt = if bq >= 0 && bq < monoInstBindT.length { monoInstBindT[bq] } else { -1 }
          if monoAnnHasTyParam(ix, isVarTyIxOf(ix), [tp]) && bt < 0 {
            bound = false
          }
        }
        if !bound {
          emitFail("emitProgram: `is` names a type that is not a union variant")
          return ix
        }
        const er = elabIsPatTyIn(ix, elabWalkTop())
        const sub = if er >= 0 && !tyHasTyVar(er) { monoPinSpellShaped(er) } else { "" }
        if sub != "" && sub != n.isVariant {
          return monoSubstIsExpr(ix, io, sub)
        }
      }
      if io == isExprKid(n) { return ix }
      return monoReIsExpr(ix, io)
    }
    AsExpr => {
      const ao = monoFoldTyParamLayout(n.asObj, typarams, tvN, tvV)
      if ao == n.asObj { return ix }
      const na = mkAsExpr(ao, n.asTy, n.asMode, n.pos)
      nodeSrcNote(na, ix)
      return na
    }
    // A spread's source is an operand like any other (D2334).
    Spread => {
      const sa = monoFoldTyParamLayout(n.spdArg, typarams, tvN, tvV)
      if sa == n.spdArg { return ix }
      return mkSpread(sa, n.pos)
    }
    ArrayLit => {
      const es: i32[] = []
      let echanged = false
      let ei = 0
      while ei < n.arrElems.length {
        const ce = monoFoldTyParamLayout(n.arrElems[ei], typarams, tvN, tvV)
        es.push(ce)
        if ce != n.arrElems[ei] { echanged = true }
        ei = ei + 1
      }
      if !echanged { return ix }
      return mkArrayLit(es, n.pos)
    }
    ObjLit => {
      return monoFoldLayoutObj(ix, n, typarams, tvN, tvV)
    }
    // every other kind is shared as it is: no layout read under it is folded here
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | ErrExpr | Param | TypeRef | FuncDecl | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | MatchExpr | ImportDecl | LoopVar => {}
  }
  ix
}

// `monoFoldTyParamLayout`'s arm for the call `n` at `ix`.
function monoFoldLayoutCall(
  ix: i32,
  n: Call,
  typarams: string[],
  tvN: string[],
  tvV: string[],
): i32 {
  const cf = monoFoldTyParamLayout(n.callFn, typarams, tvN, tvV)
  let changed = cf != n.callFn
  const nargs: i32[] = []
  let ai = 0
  while ai < n.callArgs.length {
    const ca2 = monoFoldTyParamLayout(n.callArgs[ai], typarams, tvN, tvV)
    nargs.push(ca2)
    if ca2 != n.callArgs[ai] { changed = true }
    ai = ai + 1
  }
  if !changed { return ix }
  monoRemintCallTpl(ix, cf, nargs)
}

// `monoFoldTyParamLayout`'s arm for the object literal `n` at `ix`.
function monoFoldLayoutObj(
  ix: i32,
  n: ObjLit,
  typarams: string[],
  tvN: string[],
  tvV: string[],
): i32 {
  const fl: i32[] = []
  let ochanged = false
  let oi = 0
  while oi < n.objFields.length {
    let nf = n.objFields[oi]
    const f = nodeAt(nf)
    if f is FieldInit {
      const cv = monoFoldTyParamLayout(f.fiValue, typarams, tvN, tvV)
      if cv != f.fiValue {
        nf = mkFieldInit(f.fiName, cv, f.pos)
        ochanged = true
      }
    }
    fl.push(nf)
    oi = oi + 1
  }
  if !ochanged { return ix }
  mkObjLit(fl, n.pos)
}

// Whether a specialization callback is baked for any param — gates the body rewrite and
// the key extension below.
function monoAnyBakedCallback(cbFnNames: string[]) {
  let i = 0
  while i < cbFnNames.length {
    if cbFnNames[i] != "" { return true }
    i = i + 1
  }
  false
}

// The pin column for one instance's parameter list, built in a single parallel pass keyed
// by param index — a per-parameter fact belongs beside the parameters, not coded into one
// of their strings. A record of tagged-set ids reads its kind off its layout, any other pin
// off its marker (`pinKindOfName`).
function monoBuildPinCol(pinned: string[], pinTys: i32[], kinds: i32[]) {
  let i = 0
  while i < pinned.length {
    const lk = monoTagRecordPinKind(
      if i < pinTys.length { pinTys[i] } else { -1 },
    )
    kinds.push(if lk >= 0 { lk } else { pinKindOfName(pinned[i]) })
    i = i + 1
  }
  0
}

// The pin kind of a pin at record type `ty` that holds tagged-set ids, read off the layout its
// stored fields have: `PIN_ANON` when a row holds that layout, else `PIN_NONE`; -1 for a type
// that is no such record.
function monoTagRecordPinKind(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return -1 }
  const o = tyAt(ty)
  if !(o is TyObj) { return -1 }
  const codes: i32[] = []
  const texts: string[] = []
  if monoTagMapRepTy(ty, codes, texts) < 0 { return -1 }
  if layoutFirstRowOf(o.objFieldNames, codes, ty) >= 0 {
    PIN_ANON
  } else {
    PIN_NONE
  }
}

// Whether the subtree at `ix` mentions the identifier `name` anywhere: a read, an alias, a copy
// or a capture of it. Deeper than `depth` 400 answers true, so a miss is never guessed.
function monoSubtreeNamesIdent(ix: i32, name: string, depth: i32): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  if depth > 400 { return true }
  const n = nodeAt(ix)
  if n is Ident { return n.identName == name }
  const kids = nodeChildren(ix)
  let i = 0
  while i < kids.length {
    if monoSubtreeNamesIdent(kids[i], name, depth + 1) { return true }
    i = i + 1
  }
  false
}

// The `Ident` named `name` at source position `pos` in the subtree of `ix`, or -1.
function monoIdentAtPosIn(ix: i32, name: string, pos: i32, depth: i32): i32 {
  if ix < 0 || ix >= P.nodes.length || depth > 400 { return -1 }
  const n = nodeAt(ix)
  if n is Ident {
    if n.identName == name && n.pos == pos { return ix }
    return -1
  }
  for k in nodeChildren(ix) {
    const r = monoIdentAtPosIn(k, name, pos, depth + 1)
    if r >= 0 { return r }
  }
  -1
}

// Whether `ty` is a record type with no type variable left in it.
function monoConcreteObjTy(ty: i32): boolean {
  if ty < 0 { return false }
  tyAt(ty) is TyObj && !tyHasTyVar(ty)
}

// A record type an instance binds in place of its anonymous row's own (see
// `monoObjDiffersInFnFieldsOnly`), to the row's handle, so a pin spelled from it names that row.
let monoFnFieldTwinRow: {[i32]: string} = Map()

// Whether concrete record `a` and record `b` name the same fields, in any order, and every field
// on which their types differ is a function type in `a` against a function type or a hole in
// `b`, a record differing so in turn, or anything against a bare hole in `b`, with at least one
// such field reaching a function. A hole parameter's row holds `_` at each field read (D3175).
function monoObjDiffersInFnFieldsOnly(a: i32, b: i32): boolean {
  monoObjDiffersInFnFieldsAt(a, b, 4)
}

function monoObjDiffersInFnFieldsAt(a: i32, b: i32, depth: i32): boolean {
  if depth <= 0 || !monoConcreteObjTy(a) || b < 0 || a == b { return false }
  const ta = tyAt(a)
  const tb = tyAt(b)
  if !(ta is TyObj) || !(tb is TyObj) { return false }
  const n = ta.objFieldNames.length
  if tb.objFieldNames.length != n || ta.objFieldTypes.length != n {
    return false
  }
  if tb.objFieldTypes.length != n { return false }
  let differs = false
  let i = 0
  while i < n {
    const fa = ta.objFieldTypes[i]
    const fb = tyFieldTyOf(b, ta.objFieldNames[i])
    if fa < 0 || fb < 0 { return false }
    if !tyEq(fa, fb) {
      if tyAt(fb) is TyVar {
        if tyReachesFuncD(fa, 12) { differs = true }
      } else if tyAt(fa) is TyFunc && tyAt(fb) is TyFunc {
        differs = true
      } else if monoObjDiffersInFnFieldsAt(fa, fb, depth - 1) {
        differs = true
      } else {
        return false
      }
    } else if tyHasTyVar(fb) {
      return false
    }
    i = i + 1
  }
  differs
}

// The declared record type pin `pin` names where record `ty` differs from it only in function
// fields, or -1. A literal claims a declared record by its field names, so an instance keyed and
// bound by that name alone would call the declared record's closures at their types (D3177).
function monoDeclFnFieldTwin(pin: string, ty: i32): i32 {
  const dt = cUserTypes[pin] ?? -1
  if dt < 0 || !monoObjDiffersInFnFieldsOnly(ty, dt) { return -1 }
  dt
}

// The argument's exact type extends the key where the pin's own type `own` (the argument's, -1
// for none) cannot tell two argument types apart: it holds a record no declared name spells, or a
// map, as a list, nullable or union member; or the argument differs from it only in function
// fields, which share one row (D988, D3177). The canonical key is the grain, not the type index.
function monoAnonPinDiscrim(tyIx: i32, own: i32): string {
  if tyIx < 0 { return "" }
  const pinTy = if own >= 0 { own } else { tyIx }
  let open = monoObjDiffersInFnFieldsOnly(tyIx, pinTy)
  const walk: i32[] = [pinTy]
  let steps = 0
  while !open && walk.length > 0 && steps < 64 {
    steps = steps + 1
    const c = walk.pop() ?? -1
    if c >= 0 && c < T.tys.length {
      const t = tyAt(c)
      match t {
        TyObj => {
          if nominalStructNameOfTy(c) == "" { open = true }
        }
        TyMap => {
          open = true
        }
        TyArray => {
          walk.push(t.aElem)
        }
        TyNullable => {
          walk.push(t.nInner)
        }
        TyUnion => {
          for m in t.uMembers { walk.push(m) }
        }
        TyPrim | TyErr | TyFunc | TyVar | TyLit | TyNeg => {}
      }
    }
  }
  if !open { return "" }
  const canon = tyCanonKey(tyIx, TY_WALK_DEPTH)
  if canon == "" { return "" }
  "=" + canon
}

// A pin holding a tagged function set keys apart from a closure of the same signature: its value
// is a member's id, and its calls go to each member directly.
function monoSetPinDiscrim(tyIx: i32): string {
  if fnTagTyIsTagged(tyIx) { return "#set" + i32ToStr(fnTagSetOfTy(tyIx)) }
  // A list of a tagged set's ids, spelled by its `i32` storage, keys by the set too, so two sets'
  // lists take two instances (per-instance-identity-2026-11.md, M1).
  let t = tyIx
  let sfx = ""
  let depth = 0
  while t >= 0 && t < T.tys.length && depth < 8 {
    const a = tyAt(t)
    if !(a is TyArray) { break }
    sfx = sfx + "[]"
    t = a.aElem
    depth = depth + 1
  }
  // A map of the set's ids keys by the set as a list of them does.
  if depth == 0 && t >= 0 && t < T.tys.length && monoTagMapTy(t) {
    const mm = tyAt(t)
    if mm is TyMap { return "#set" + i32ToStr(fnTagSetOfTy(mm.mVal)) + "{}" }
  }
  // A record holding one keys by each field's sets; a record nested in it pins nowhere.
  const ro = if depth == 0 && t >= 0 && t < T.tys.length && fnTagHoldsTy(t, 8) { tyAt(t) } else { null }
  if ro is TyObj {
    let rk = "#set{"
    for f in ro.objFieldTypes {
      rk = rk
        + (if f >= 0 && f < T.tys.length && tyAt(f) is TyObj { "" } else { monoSetPinDiscrim(f) })
        + ","
    }
    return rk + "}"
  }
  if depth == 0 || !fnTagTyIsTagged(t) { return "" }
  "#set" + i32ToStr(fnTagSetOfTy(t)) + sfx
}

// A pin of a string-literal union keys apart from its base `string`, whose spelling a pin shares:
// the union is lowered as an interned atom, so the two instances have different reps.
function monoLitUnionPinDiscrim(tyIx: i32): string {
  if !tyIsLitUnion(tyIx) { return "" }
  "#lit" + tyToStr(tyIx)
}

// The type of argument `ax` where it is a tagged function set, else -1.
function monoArgTaggedSetTy(ax: i32): i32 {
  const x = unwrapParen(ax)
  if x < 0 { return -1 }
  const t = nodeTyIxOf(x)
  if fnTagTyIsTagged(t) || fnTagListTy(t) { return t }
  // A parameter handed on holds the set its instance binds it to.
  const it = elabWalkTy(x)
  if it >= 0 && (fnTagTyIsTagged(it) || fnTagListTy(it) || monoTagMapTy(it)) {
    return it
  }
  -1
}

// Whether the elaboration's binding `bt` of a hole is a closed type other than `i32`, which the
// rep cascade's `i32` floor would pin wrongly.
function monoFloorDisagrees(bt: i32): boolean {
  if bt < 0 || bt >= T.tys.length || tyHasTyVar(bt) || tyReachesHole(bt, 16) {
    return false
  }
  !tySame(bt, TY_I32)
}

// The type a map `t` of a tagged set's ids, or a record holding one, is stored at: the map's
// stored type, or the record of its fields' stored types; -1 for anything else, and for a record
// with a field the naming rule cannot spell or a nested record holding a set. A record's fields'
// stored field codes and spellings are appended to `codes` and `texts`.
export function monoTagMapRepTy(t: i32, codes: i32[], texts: string[]): i32 {
  if t < 0 || t >= T.tys.length { return -1 }
  const m = tyAt(t)
  if m is TyMap { return mapStoredTyOf(t) }
  if !(m is TyObj) || !fnTagHoldsTy(t, 8) { return -1 }
  const sts: i32[] = []
  let i = 0
  while i < m.objFieldNames.length && i < m.objFieldTypes.length {
    const f = m.objFieldTypes[i]
    let sp = monoPinOfClosedTy(f)
    let st = f
    const none: i32[] = []
    const noneS: string[] = []
    if fnTagTyIsTagged(f) {
      sp = "i32"
      st = TY_I32
    } else if fnTagListTy(f) {
      sp = fnTagListRepName(f)
      st = fnTagRepTyOf(f)
    } else if monoTagMapTy(f) {
      sp = monoPinSpellShaped(monoTagMapRepTy(f, none, noneS))
      st = mapStoredTyOf(f)
    } else if (
      f >= 0
      && f < T.tys.length
      && tyAt(f) is TyObj
      && fnTagHoldsTy(f, 8)
    ) {
      sp = ""
    }
    if sp == "" { return -1 }
    codes.push(fieldCodeOfTy(st))
    texts.push(sp)
    sts.push(st)
    i = i + 1
  }
  mkObjTy(m.objFieldNames, sts)
}

// Whether `t` is a map whose values are a tagged set's ids.
function monoTagMapTy(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const m = tyAt(t)
  m is TyMap && fnTagTyIsTagged(m.mVal)
}

// How the canon name of a pin of type `ty` can differ from its spelling: 1 for a union of two
// members or more, or one whose arms (`unionTyArms`) number two or more (a union of twin maps keys
// one arm and is still canon'd to its one map, D15540); 2 for a list whose element its spelling
// groups in parentheses (a union, a nullable or a function); 0 otherwise, and for no type.
function monoPinCanonKind(ty: i32): i32 {
  if ty < 0 || ty >= T.tys.length { return 0 }
  const t = tyAt(ty)
  if t is TyUnion {
    if t.uMembers.length >= 2 { return 1 }
  }
  if t is TyArray {
    if t.aElem >= 0 && t.aElem < T.tys.length {
      const e = tyAt(t.aElem)
      if e is TyUnion || e is TyNullable || e is TyFunc { return 2 }
    }
  }
  const atoms: string[] = []
  const tys: i32[] = []
  if unionTyArms(ty, atoms, tys) && atoms.length >= 2 { return 1 }
  0
}

// Whether a pin of type `ty` canons to a union of two atoms or more: a union by
// `monoPinCanonKind` that no declared or literal-union alias names, since a canon alias is one atom.
function monoPinCanonIsUnion(ty: i32): boolean {
  monoPinCanonKind(ty) == 1
    && unionAliasDeclNameOfTy(ty) == ""
    && litUnionAliasNameOfTy(ty) == ""
}

// The spelling an annotation pinned at `ty` takes when a pin substitutes into a union holding a
// map or a record (`V | {[K]: i32}` at `V := {[K]: boolean}`), registered under the canon key a
// direct spelling reuses (D2657) and typed by `own`, the whole annotation (-1: `ty`). One that
// collapses at the pin is spelled as its survivor (D7044). `shTag` names the shadow root.
function monoPinMintedUnion(
  name: string,
  ty: i32,
  own: i32,
  shTag: i32,
): string {
  // A list whose element is a union boxes each element, whether the union is spelled inline or
  // named by an alias: one set, one row. A nullable `boolean`, `string` or literal union element
  // is a niche, not a box.
  const lt = if ty >= 0 && ty < T.tys.length { tyAt(ty) } else { tyAt(0) }
  const le = if lt is TyArray { lt.aElem } else { -1 }
  const lu = if le >= 0 && le < T.tys.length { tyAt(le) } else { tyAt(0) }
  let boxEl = lu is TyUnion
  if lu is TyNullable {
    const ni = lu.nInner
    boxEl = !(ni == TY_BOOL || ni == TY_STR || tyIsLitUnion(ni))
  }
  const pun = if boxEl { monoPinSpellShaped(le) } else { "" }
  // The whole annotation at the pin is a union or a nullable, or it collapsed to one member.
  const wt = if own >= 0 { monoAnnPinTy(own) } else { ty }
  const wtt = if wt >= 0 && wt < T.tys.length { tyAt(wt) } else { tyAt(0) }
  const wu = wt >= 0 && (wtt is TyUnion || wtt is TyNullable)
  if pun != "" {
    if !monoPinCanonIsUnion(le) { return name }
  } else if !wu || monoPinCanonKind(wt) == 2 {
    return name
  }
  if !monoTyHoldsRefArm(ty) || unNameBound(name) { return name }
  // A list of such a union registers its element union, as a direct `(A | B)[]` does (D2678).
  if pun != "" {
    monoShStage(unTyKeyTagParamList(), tyStepElem(ty))
    // The registered type is the whole annotation's (`own`) at the rep its spelling collapses to.
    const elemTy = if own >= 0 { monoAnnPinTy(tyStepElem(own)) } else { tyStepElem(ty) }
    if monoRegisterPinUnion(pun, elemTy) < 0 { return name }
    return "(" + pun + ")[]"
  }
  if !wu { return name }
  monoShStage(shTag, ty)
  monoRegisterPinUnion(name, if own >= 0 { monoAnnPinTy(own) } else { ty })
  name
}

// The type-key shadow's stage for the next `monoRegisterPinUnion`: the root's tag (0 for none)
// and the type that root hands over. Written only while the shadow is armed.
let monoShTag = 0
let monoShTy = -1

function monoShStage(tag: i32, ty: i32) {
  if unABOn() == 0 { return 0 }
  monoShTag = tag
  monoShTy = ty
  0
}

// A parameter's pins are classified once the instance's binding is whole: while
// `monoShParNode` names the annotation being pinned, each pin is held here instead.
let monoShParNode = -1
const monoShPendTag: i32[] = []
const monoShPendName: string[] = []
const monoShPendNode: i32[] = []

// Hands the pins held since `from` to the shadow, then drops them. Each is typed by its
// annotation; a list pin by that type's element.
function monoShPendFlush(from: i32) {
  let i = from
  while i < monoShPendTag.length {
    let ty = nodeTyIxOf(monoShPendNode[i])
    if ty >= 0 && tyHasTyVar(ty) { ty = -1 }
    if monoShPendTag[i] == unTyKeyTagParamList() { ty = tyStepElem(ty) }
    unTyKeyShadow(monoShPendTag[i], monoShPendName[i], ty)
    i = i + 1
  }
  while monoShPendTag.length > from {
    monoShPendTag.pop()
    monoShPendName.pop()
    monoShPendNode.pop()
  }
  0
}

// Offers the row `name` names to the shadow under root `shTag` (0 for none): held while a
// parameter is being pinned, else compared with the staged type `ty` at once. Returns 0.
function monoShOffer(shTag: i32, name: string, ty: i32) {
  if shTag <= 0 { return 0 }
  if monoShParNode >= 0 {
    monoShPendTag.push(shTag)
    monoShPendName.push(name)
    monoShPendNode.push(monoShParNode)
    return 0
  }
  unTyKeyShadow(shTag, name, ty)
}

// Whether union `ty` has a literal-union arm beside a non-literal one (`K | i32`), as a member
// or as the run of string literals an alias renders back to.
function monoTyHoldsLitUnionArm(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const n = tyAt(ty)
  if n is TyNullable { return monoTyHoldsLitUnionArm(n.nInner) }
  const t = tyAt(ty)
  if !(t is TyUnion) { return false }
  if mixedLitRunAliasOf(t.uMembers) != "" { return true }
  for m in t.uMembers {
    if tyIsLitUnion(m) { return true }
  }
  false
}

// Whether the union or nullable `ty` has a map or a record among its members: the arms a
// union box holds under a registered row, where a value atom's tag needs none.
function monoTyHoldsRefArm(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  const lt = tyAt(ty)
  if lt is TyArray { return monoTyHoldsRefArm(lt.aElem) }
  const flat: i32[] = []
  flattenVariantsInto(ty, flat)
  let i = 0
  while i < flat.length {
    const m = flat[i]
    if m >= 0 && m < T.tys.length {
      if monoTyIsRefArm(m) { return true }
    }
    i = i + 1
  }
  false
}

// Whether the member type at `m` boxes under a registered row: a map, a record, or a list of
// references (its reflist slot). Every other kind rides a value atom's tag or is not a member.
function monoTyIsRefArm(m: i32): boolean {
  const mt = tyAt(m)
  match mt {
    TyMap | TyObj => {
      return true
    }
    TyArray => {
      return monoTyIsRefElem(mt.aElem)
    }
    TyPrim | TyErr | TyFunc | TyUnion | TyNullable | TyVar | TyLit | TyNeg => {
      return false
    }
  }
}

// Whether list element `e` is a reference other than a string: a record, map, list or union.
function monoTyIsRefElem(e: i32): boolean {
  if e < 0 || e >= T.tys.length { return false }
  const et = tyAt(e)
  match et {
    TyMap | TyObj | TyArray | TyUnion | TyNullable => {
      return true
    }
    TyPrim | TyErr | TyFunc | TyVar | TyLit | TyNeg => {
      return false
    }
  }
}

// D1042 — register a union `name` (rendering `ty`, or -1) that exists only because a pin minted
// it here. `collectU` runs before `monomorphize` and nothing re-runs it, so a `T | E` return at a
// concrete `T` has no row and every consumer of the box hits its floor. The registration self-gates
// on the union key's row, which keeps one row per union — a box's tags are that row's, positionally.
function monoRegisterPinUnion(name: string, ty: i32) {
  const shTag = monoShTag
  monoShTag = 0
  const shTy = monoShTy
  monoShTy = -1
  // A pin minted at a union or a nullable needs a box row; any other pin registers nothing.
  const ut = if ty >= 0 && ty < T.tys.length { tyAt(ty) } else { tyAt(0) }
  if ty < 0 || !(ut is TyUnion || ut is TyNullable) { return 0 }
  // A union type already holding a row binds this spelling to it; only a new type mints one.
  if (
    unNameBound(name)
    || (unRowOfTyKey(ty) >= 0 && unNameAdoptTyKeyRow(name, ty))
  ) {
    return monoShOffer(shTag, name, shTy)
  }
  const before = uVariants.length
  if registerInlineUnionOfTy(monoProgStmts, name, ty) < 0 { return -1 }
  monoShOffer(shTag, name, shTy)
  // Re-rank only when a variant is pushed: `assignTags` ranks variants globally and a value
  // union pushes none, so unconditional re-ranking would be quadratic.
  if uVariants.length != before { return assignTags() }
  0
}

// Registers the value union `ty` a pin minted under its pin spelling `name`, the row `collectU`
// never saw, for an instance's return and its parameters alike (D1042, D15170). 0 when `ty` is no
// value union, or a union holding a map or record arm, whose spelling registers elsewhere; -1 failed.
function monoRegisterValuePin(name: string, ty: i32): i32 {
  if name == "" || !monoTyIsUnionOrNulUnion(ty) || monoTyHoldsRefArm(ty) {
    return 0
  }
  monoRegisterPinUnion(name, ty)
}

// Binds `typarams` into `outN` / `outT`: the explicit type arguments first, then each other one
// at the elaboration's binding for call key `callKey`. False, and nothing bound, when the call has
// no key or one of them stays open there.
function monoExactBind(
  callKey: i32,
  typarams: string[],
  exBN: string[],
  exBT: i32[],
  outN: string[],
  outT: i32[],
): boolean {
  let e = 0
  while e < exBN.length && e < exBT.length {
    outN.push(exBN[e])
    outT.push(exBT[e])
    e = e + 1
  }
  if callKey < 0 || callKey >= ekNames.length || callKey >= ekTys.length {
    return monoExactClear(outN, outT)
  }
  for tp in typarams {
    if !strListHas(outN, tp) {
      const at = strListIndexOf(ekNames[callKey], tp)
      const t = if at >= 0 && at < ekTys[callKey].length { ekTys[callKey][at] } else { -1 }
      if t < 0 || t >= T.tys.length || tyHasTyVar(t) {
        return monoExactClear(outN, outT)
      }
      outN.push(tp)
      outT.push(t)
    }
  }
  true
}

// Empties a partial binding, so an instance with a pin it cannot bind exactly keeps its shared
// key; always false.
function monoExactClear(outN: string[], outT: i32[]): boolean {
  while outN.length > 0 { outN.pop() }
  while outT.length > 0 { outT.pop() }
  false
}

// Node `x`'s type in instance `ctx`, as the elaboration recorded it; the node's own checked type
// where the elaboration leaves it open.
function monoNodeTyAt(x: i32, ctx: i32): i32 {
  const t = elabNodeTyAt(x, ctx)
  if t >= 0 { t } else { nodeTyIxOf(x) }
}

// `t` with the pinned binding of the instance `ctx` is, or is lifted inside, substituted, a
// type parameter's or a hole's; `t` itself where no instance binds every one it names.
function monoPinSubTyOf(t: i32, ctx: i32): i32 {
  if ctx < 0 { return t }
  const st = elabInstTyAt(t, ctx)
  if st >= 0 { st } else { t }
}

// `monoPinSubTyOf` over each pin of one call.
function monoExactPinTys(pinTys: i32[], ctx: i32) {
  let i = 0
  while i < pinTys.length {
    pinTys[i] = monoPinSubTyOf(pinTys[i], ctx)
    i = i + 1
  }
  0
}

// Writes the instance walk's scoped staging back to its declared values at compile start, so
// no binding, pin or callee frame of an earlier program's walk is read by this one.
export function monoStateReset() {
  cadRowReset()
  monoCallFrameSlot = 0 - 1
  monoCellAliasListOk = 0 - 1
  monoCgcGenAliasNames = []
  monoCgcGenAliasDecls = []
  monoCgcAliasScope = []
  monoChoiceBindDecl = []
  monoChoiceBindFr = []
  monoChoiceBindTy = []
  monoChoiceBindGen = []
  monoDestPinOff = false
  monoElemTakenSig = Map()
  monoElemAtSet = Map()
  monoTopStmts = []
  monoInstIsFirst = false
  monoInstRetWidenTy = 0 - 1
  monoInstanceRetTy = 0 - 1
  monoLastInstFe = 0 - 1
  monoMakeCallIx = 0 - 1
  monoOpenLamD = []
  monoOpenLamT = []
  monoOpenLamDefer = 0 - 1
  monoOpenLamOwner = 0 - 1
  monoOpenLamMark = 0
  monoPinCtx = -1
  monoPinHoleN = []
  monoPinHoleT = []
  monoPinInLit = false
  monoPinLetReaches = false
  monoShParNode = -1
  monoShTy = -1
  monoWriteCoercedCall = -1
  structTyAliasableReset()
  0
}

// Empties the instance-binding tables, which `monomorphize` fills and the classifiers read.
export function monoSubTablesReset() {
  monoInstOwn = ""
  monoArgInstFe = Map()
  monoRenamedFe = Map()
  monoOpenArgCall = 0 - 1
  monoOpenArgCallee = 0 - 1
  0
}

// The module-scope call being instantiated and its callee, whose open-typed arguments are read
// at the instance the callee reaches (`monoArgInstFe`); -1 for none.
let monoOpenArgCall = 0 - 1
let monoOpenArgCallee = 0 - 1

// Records each argument of `monoOpenArgCall` whose recorded type names a type variable as read
// at instance slot `instFe`, when `calleeIx` is that call's callee; consumes the call.
function monoNoteOpenArgs(calleeIx: i32, instFe: i32) {
  if monoOpenArgCall < 0 || calleeIx != monoOpenArgCallee { return 0 }
  const c = nodeAt(monoOpenArgCall)
  monoOpenArgCall = 0 - 1
  monoOpenArgCallee = 0 - 1
  if c is Call {
    for a in c.callArgs {
      const t = nodeTyIxOf(a)
      if t >= 0 && tyHasTyVar(t) { monoArgInstFe.set(a, instFe) }
    }
  }
  0
}

// Per template slot: how many of its instances are being walked, one inside another.
let monoActiveDepth: i32[] = []
const MONO_NEST_MAX = 32

// The instance-creation core shared by `monoInstantiate` (call-driven) and
// `monoInstanceFor` (annotation-driven): clone or reuse the instance of generic `origFe`
// for the already-built `pinned` names and point `calleeIx` at it. `annotateI32` annotates
// an i32-pinned param too; `cbFnNames` bakes a concrete callback in. Returns 0, or -1.
function monoMakeInstance(
  origFe: i32,
  pinned: string[],
  pinKinds: i32[],
  pinTys: i32[],
  pinOwn: i32[],
  tvN: string[],
  tvV: string[],
  tvT: i32[],
  calleeIx: i32,
  annotateI32: boolean,
  cbFnNames: string[],
) {
  // A `K | (L | null)` pin softens without its null, so the instance keeps the nesting (D3504).
  const foldWas = substNullFoldOffFor(pinTys)
  const ownWas = monoInstOwn
  monoInstOwn = monoTemplateOwner(origFe)
  const bindNWas = monoInstBindN
  const bindTWas = monoInstBindT
  monoInstBindN = tvN
  monoInstBindT = tvT
  // The deliveries inside the instance's body are its own, not the one being built.
  const widenWas = monoInstanceWidenRet
  monoInstanceWidenRet = false
  const bakedWas = cadInBaked
  cadInBaked = monoCadBaked(cbFnNames)
  const rc = monoMakeInstanceGo(
    origFe,
    pinned,
    pinKinds,
    pinTys,
    pinOwn,
    tvN,
    tvV,
    calleeIx,
    annotateI32,
    cbFnNames,
  )
  substNullFoldRestore(foldWas)
  monoInstOwn = ownWas
  monoInstBindN = bindNWas
  monoInstBindT = bindTWas
  monoInstanceWidenRet = widenWas
  cadInBaked = bakedWas
  rc
}

// The owner key of the template `monoMakeInstance` is instantiating: its bindings (`letBN`,
// `exSubN`) substitute only that generic's own type variables.
let monoInstOwn = ""
// The type-parameter binding of the instance `monoMakeInstance` is building, by type: names
// `monoInstBindN`, types `monoInstBindT` (-1 where unbound).
let monoInstBindN: string[] = []
let monoInstBindT: i32[] = []

// Type `t` under the binding of the instance being built, or -1 when that leaves it open.
function monoInstBindTyOf(t: i32): i32 {
  if t < 0 { return -1 }
  const s = substTyDeepOf(t, monoInstBindN, monoInstBindT, monoInstOwn)
  if s >= 0 && !tyHasTyVar(s) { s } else { -1 }
}

// `substTyDeep` of an instance binding of the template being instantiated (D9190).
function monoSubstInst(t: i32, bN: string[], bT: i32[]): i32 {
  substTyDeepOf(t, bN, bT, monoInstOwn)
}

// The owner key of template slot `origFe`'s type parameters: its name when it is the top-level
// declaration so named, else "" (a nested template's instance binds by name, as before).
function monoTemplateOwner(origFe: i32): string {
  if origFe < 0 || origFe >= monoOrigNode.length { return "" }
  topFnOwnerOf(monoOrigNode[origFe])
}

// The pin segment of an instance key: per pin, `heads[pk]` and the argument type's
// discriminators. `heads` is the pin spelling, or for the typed key the pin's resolved type;
// `pinOwn` is each pin's own type, the parameter's substituted annotation.
function monoKeyPinSeg(
  heads: string[],
  pinned: string[],
  pinTys: i32[],
  pinOwn: i32[],
  bound: boolean[],
  exact: boolean,
): string {
  let seg = ""
  let pk = 0
  while pk < pinned.length {
    // A function pin reaches the key spelled by its type (`monoPinRespell`). Its `$fnsig` key is
    // shared by `i32`, `boolean` and a literal union, so one keyed by it is refused (D3167).
    const pt = pinTys[pk]
    if (
      sigKeyPinPayload(pinned[pk]) != ""
      && pt >= 0
      && pt < T.tys.length
      && tyAt(pt) is TyFunc
      && !tyHasTyVar(pt)
    ) {
      emitFail(
        "emitProgram: monomorphize: a function pin reached the instance key as its signature key, which several types share",
      )
    }
    // A parameter annotated with a union naming a type parameter is pinned at that annotation
    // under the key's bindings, which already fix it; the argument's exact type and its
    // literal-union rep add nothing (D15109).
    const unionPin = pk < bound.length && bound[pk]
    // A pin built around records is keyed by its own type's row class (`typeRowClassOf`): pins
    // whose records share a row build one instance, whatever their names or spellings (D15262).
    const rowCls = typeRowClassOf(pinOwn[pk])
    if rowCls != "" {
      seg = seg + "#row" + rowCls + monoSetPinDiscrim(pinTys[pk]) + ","
      pk = pk + 1
      continue
    }
    seg = seg
      + heads[pk]
      + (if unionPin || monoPinExactFree(exact, pinTys[pk]) { "" } else { monoAnonPinDiscrim(pinTys[pk], if pk < pinOwn.length { pinOwn[pk] } else { -1 }) })
      + monoSetPinDiscrim(pinTys[pk])
      + (if unionPin { "" } else { monoLitUnionPinDiscrim(pinTys[pk]) })
      + ","
    // The exact-type segment stays where the elaboration spells the binding exactly, and on a
    // function-holding pin, whose record twins differ only in a field function (D988).

    pk = pk + 1
  }
  seg
}

// Whether a pin of type `t` needs no exact-type segment: its body tests no type parameter
// (`exact` false) and `t` holds no function, whose field functions are instances of their own
// (D988), so a Set and its boolean map, which share a rep, build one instance (D15171).
function monoPinExactFree(exact: boolean, t: i32): boolean {
  !exact && t >= 0 && t < T.tys.length && !tyMayHoldFn(t, 0)
}

// Per parameter of `fn`, whether its annotation is a union that names one of its type
// parameters: such a pin is the substituted annotation, which the key's bindings fix.
function monoUnionTyParamPins(fn: FuncDecl): boolean[] {
  const out: boolean[] = []
  for pIx in fn.fnParams {
    const p = nodeAt(pIx)
    out.push(
      p is Param
        && p.parType >= 0
        && monoAnnIsUnion(p.parType)
        && monoAnnHasTyParam(p.parType, -1, fn.fnTyParams),
    )
  }
  out
}

// The instance registry key, `key` extended by the exact types a type-testing body binds
// (pushed onto `exSubN`/`exSubT`) and the baked-callback identities. Returns the key.
function monoMakeInstanceKey(
  key: string,
  origFe: i32,
  callKey: i32,
  tps: string[],
  exBN: string[],
  exBT: i32[],
  exSubN: string[],
  exSubT: i32[],
  cbFnNames: string[],
) {
  // A body testing a value of a type parameter is keyed by the exact types, which a pin's
  // spelling can merge (a Set and its boolean map), so each instance binds them to one.
  if elabTestsTyVar(monoOrigNode[origFe]) {
    if (monoExactBind(callKey, tps, exBN, exBT, exSubN, exSubT)) {
      monoShAliasBind(origFe, exSubN, exSubT)
      let xk = 0
      while xk < exSubN.length {
        key = key
          + "~"
          + exSubN[xk]
          + "="
          + tyCanonKey(exSubT[xk], TY_WALK_DEPTH)
          + ";"
        xk = xk + 1
      }
    }
  }
  // The baked-callback identities extend the key, so two calls passing the same pinned
  // types but different non-capturing callbacks get distinct instances. No baked
  // callback → no `@` suffix → the key is exactly the pre-specialization one.
  let ck = 0
  while ck < cbFnNames.length {
    if cbFnNames[ck] != "" { key = key + "@" + cbFnNames[ck] + "," }
    ck = ck + 1
  }
  key
}

// The registry lookup for an instance `key`: on a hit, points the call site at the existing
// instance (renaming the callee unless it must stay a `call_ref`) and fills the hole
// annotations a value use needs. True on a hit, false when the shape is new.
function monoMakeInstanceHit(
  key: string,
  origFe: i32,
  pinned: string[],
  pinTys: i32[],
  calleeIx: i32,
  annotateI32: boolean,
) {
  let k = 0
  while k < monoKeys.length {
    if monoKeys[k] == key {
      monoLastInstFe = monoInstFe[k]
      monoArmRowNote(calleeIx, monoInstFe[k])
      monoNoteOpenArgs(calleeIx, monoInstFe[k])
      const cal = nodeAt(calleeIx)
      if cal is Ident {
        // A registry hit on a capturing lambda in the binding's own slot must stay a
        // `call_ref`: renaming the callee would drop the captured env. A reassigned
        // binding must too, since every later write would be invisible.
        let keepCallRef = false
        if monoInstFe[k] == origFe && cal.identName != monoInstName[k] {
          if captureCountOf(origFe) > 0 {
            keepCallRef = true
          } else if monoReadIsAssigned(cal.identName, calleeIx) {
            keepCallRef = true
          }
        }
        if !keepCallRef {
          if (
            cal.identName != monoInstName[k]
            && !i32ListHas(monoNoRename, calleeIx)
          ) {
            monoAliasCallNote(calleeIx)
            cal.identName = monoInstName[k]
            monoNoteRenamed(calleeIx, monoInstFe[k])
            // R4 writer 5 of 8 (`compiler/symbols.vl`; census in `perf-program.md`).
            let instDecl = fnStmts[monoInstFe[k]]
            if identAuditDrop == IDENT_DROP_MONO_CALLEE { instDecl = -1 }
            sidNoteNodeName(calleeIx, instDecl)
          }
        }
      }
      // A value use reaching an instance a direct call already built. The call path
      // spells an i32 pin as the hole it is, leaving the value floor to reject a
      // function this program has pinned monomorphic — order-dependence nobody holds.
      if annotateI32 {
        const hfn = nodeAt(fnStmts[monoInstFe[k]])
        if hfn is FuncDecl {
          const hps = hfn.fnParams
          if hps.length == pinned.length {
            let hp = 0
            while hp < hps.length {
              const hpp = nodeAt(hps[hp])
              if hpp is Param {
                if hpp.parType < 0 {
                  // The synthesis is the whole write, typed by the pin's own type as the
                  // clone arm types it. Equivalent to the clone arm only while this
                  // caller's column is all -1.
                  const hty = if hp < pinTys.length { pinTys[hp] } else { -1 }
                  hpp.parType = monoSynthPinRef(pinned[hp], hty)
                }
              }
              hp = hp + 1
            }
          }
        }
      }
      return true
    }
    k = k + 1
  }
  false
}

// The parameter annotation for pin `name`, typed by `ty`, the type the pin denotes. A closed `ty`
// spells the node itself (`monoPinSpellOf`). Only an open `ty` reads the name: a list of a
// literal's `#anon` row takes the row's list (D4710), and any other closes in the spelling.
function monoSynthPinRef(name: string, ty: i32): i32 {
  if ty >= 0 && !tyHasTyVar(ty) {
    const sp = monoPinSpellOf(ty)
    return synthTypeRefTy(if sp != "" { sp } else { name }, -1, ty)
  }
  const alt = monoAnonRowListTy(name, ty)
  if alt >= 0 { return synthTypeRefOfTy(alt, -1) }
  synthTypeRefFb(name, -1, ty)
}

// The instance's parameters, cloned with each one's pinned annotation: pushes one cloned
// `Param` per declared parameter onto `nps` and its resolved arena row (-1 for none) onto
// `pinnedTyIx`, one row per entry of `params`. 0 on success, -1 when a record argument's
// fields name a row of another field kind.
function monoMakeInstanceParams(
  fn: FuncDecl,
  params: i32[],
  pinned: string[],
  pinKinds: i32[],
  pinTys: i32[],
  pinOwn: i32[],
  exBN: string[],
  exBT: i32[],
  annotateI32: boolean,
  argLit: boolean[],
  nps: i32[],
  pinnedTyIx: i32[],
) {
  let pj = 0
  while pj < params.length {
    let pinTy = -1
    const p3 = nodeAt(params[pj])
    if p3 is Param {
      let nt = -1
      // Whether `nt` is a node this loop SYNTHESIZED (and which therefore already
      // carries its recorded type) or the original declaration's own annotation node.
      let synthed = false
      if p3.parType >= 0 {
        // The pinned name differs from the written annotation exactly when
        // a type param substituted through it (bare `T`, `T[]`, or a
        // composite like `Box<T>`); a concrete annotation keeps its node.
        if fnTagTyIsTagged(pinTys[pj]) {
          // A type parameter bound to a tagged set is the set itself, as at a hole.
          nt = synthTypeRefTy(pinned[pj], -1, pinTys[pj])
          synthed = true
        } else if pinned[pj] == tyNameOf(p3.parType) {
          nt = p3.parType
        } else {
          // The argument's type is one member of a union parameter; the annotation substituted
          // at the instance names the union itself: the parameter's own type where its bindings
          // are inferred, else the written type arguments substituted through it (D2679).
          let gateTy = pinTys[pj]
          const ownTy = if pj < pinOwn.length { pinOwn[pj] } else { -1 }
          if !monoTyHoldsRefArm(gateTy) && ownTy >= 0 && !tyHasTyVar(ownTy) {
            gateTy = ownTy
          } else if !monoTyHoldsRefArm(gateTy) && exBN.length > 0 {
            const pst = monoSubstInst(nodeTyIxOf(p3.parType), exBN, exBT)
            if pst >= 0 && !tyHasTyVar(pst) { gateTy = pst }
          }
          if unABOn() > 0 { monoShParNode = p3.parType }
          const pinName = monoPinMintedUnion(
            pinned[pj],
            gateTy,
            if pj < pinOwn.length { pinOwn[pj] } else { -1 },
            unTyKeyTagParam(),
          )
          nt = monoSynthPinRef(
            pinName,
            if pj < pinOwn.length { pinOwn[pj] } else { -1 },
          )
          if monoPinRowNamesOtherTy(nodeTyIxOf(nt), pinTys[pj]) {
            nt = anonPinLitCarry(nt, synthTypeRefTy(pinName, -1, pinTys[pj]))
          }
          // A string literal or literal-union pin keeps the spelling `string` and takes the literal
          // as its type, the instance the elaboration keys, unless the signature names a literal
          // whose atoms the body would then read.
          if monoPinSoftensLit(nodeTyIxOf(nt), pinTys[pj], fn) {
            nt = anonPinLitCarry(nt, synthTypeRefTy(pinName, -1, pinTys[pj]))
          }
          // A literal-union arm beside a scalar (`T | i32` at `T := K`) boxes under a row too,
          // and no direct spelling minted one (D5310).
          if monoTyHoldsLitUnionArm(nodeTyIxOf(nt)) {
            monoShStage(unTyKeyTagArm(), nodeTyIxOf(nt))
            monoRegisterPinUnion(pinName, nodeTyIxOf(nt))
          }
          monoShParNode = -1
          if pinTys[pj] >= 0 { monoParamPinTy.set(nt, pinTys[pj]) }
          synthed = true
        }
      } else if (
        fnTagTyIsTagged(pinTys[pj])
        || monoTagMapTy(pinTys[pj])
        || pinTys[pj] >= 0
          && pinTys[pj] < T.tys.length
          && tyAt(pinTys[pj]) is TyObj
          && monoTagMapRepTy(pinTys[pj], [], []) >= 0
      ) {
        // A tagged set's parameter is the set itself, not a closure of its signature; a map or
        // record of its ids is that map or record.
        nt = synthTypeRefTy(pinned[pj], -1, pinTys[pj])
        synthed = true
      } else if annotateI32 || pinned[pj] != "i32" {
        nt = monoSynthPinRef(pinned[pj], monoPinWidenTy(pinTys[pj]))
        // The pin name renders inline literal members as `string`; a union box holding them
        // keeps the argument's own members, which its narrowed reads are keyed on (D8181).
        if (
          monoPinKeepsInlineLits(nodeTyIxOf(nt), pinTys[pj])
          || monoPinRowNamesOtherTy(nodeTyIxOf(nt), pinTys[pj])
          || monoPinSoftensLit(nodeTyIxOf(nt), pinTys[pj], fn)
        ) {
          nt = anonPinLitCarry(nt, synthTypeRefTy(pinned[pj], -1, pinTys[pj]))
        }
        synthed = true
      }
      // A bundle's parameter is known by its pin type; a same-shaped record can share its row.
      const bs = elabDeliveredBundleSigs(pinTys[pj])
      if nt >= 0 && bs.length > 0 { bundleParamNote(nt, bs) }
      // The pinned concrete param type is recorded on the instance's annotation node,
      // and `pinTy` is that index. A synthesized node already carries it; the original
      // declaration's node carries the checker's generic-frame resolution instead.
      if nt >= 0 {
        if synthed {
          pinTy = nodeTyIxOf(nt)
        } else {
          // The node often already holds the answer, this arm being reached only when
          // the pinned name is the written annotation. The few that differ carry the
          // generic body's type-param frame, which `tyHasTyVar` separates.
          const already = nodeTyIxOf(nt)
          if already >= 0 && !tyHasTyVar(already) {
            pinTy = already
          } else {
            const own = if pj < pinOwn.length { pinOwn[pj] } else { -1 }
            const rty = if own >= 0 && !tyHasTyVar(own) { own } else { pinTys[pj] }
            pinTy = recordClonedNodeTyKnown(nt, pinKinds[pj], rty)
          }
        }
      } else {
        // The one arm that mints no annotation node: an un-annotated param pinned at plain
        // i32 (`nt` stays -1 by design, so the all-i32 path adds zero arena nodes).
        pinTy = i32TyIx()
      }
      // A value union with a literal member that the pin minted (`T | "a"` at `T := i32`) has no
      // row `collectU` registered, so it is registered under the pin's spelling, as an instance
      // return's is (D1042, D15170).
      if (
        nt >= 0
        && pinTy >= 0
        && !tyHasTyVar(pinTy)
        && monoTyHasLitMember(pinTy)
      ) {
        const unm = monoPinAnnSpelling(pinTy)
        if monoRegisterValuePin(unm, pinTy) < 0 { return -1 }
        if (
          unm != ""
          && unm != pinned[pj]
          && monoTyIsUnionOrNulUnion(pinTy)
          && !monoTyHoldsRefArm(pinTy)
        ) {
          nt = synthTypeRefTy(unm, -1, pinTy)
        }
      }
      // D681 — an anon pin's type is its row's, not the placeholder's: `#anonN`
      // resolves to nothing, so the node records a field-less `TyObj` while this
      // column is what the re-check windows declare the parameters as.
      const anonTy = anonHandleTyIx(pinned[pj], pinTys[pj])
      if anonTy >= 0 { pinTy = anonTy }
      // A row first typed through a hole keeps it; the argument's closed type binds it instead.
      if (
        anonTy >= 0
        && tyHasTyVar(anonTy)
        && pinTys[pj] >= 0
        && !tyHasTyVar(pinTys[pj])
      ) {
        pinTy = pinTys[pj]
      }
      // The row keeps one function type per field, so a record differing only there (the
      // instance key already tells them apart) binds its own, or every callee typed from
      // the binding reads the row's first signature (D3110).
      if anonTy >= 0 && monoObjDiffersInFnFieldsOnly(pinTys[pj], anonTy) {
        pinTy = pinTys[pj]
        monoFnFieldTwinRow.set(pinTy, pinned[pj])
      } else if (
        anonTy < 0
        && monoDeclFnFieldTwin(pinned[pj], pinTys[pj]) >= 0
      ) {
        pinTy = pinTys[pj]
        monoFnFieldTwinRow.set(pinTy, pinned[pj])
      }
      let isLit = pj < argLit.length && argLit[pj]
      const agree = anonRowKindsAgree(pinned[pj], pinTys[pj])
      if !isLit && anonTy >= 0 { isLit = agree == 1 }
      // A record spelled by its fields names the first row of its layout, which can hold
      // another code-0 kind; the instance would read that row while its caller builds its own.
      if (
        anonTy >= 0
        && agree == 0
        && pinned[pj][0] != "#"[0]
        && monoSubtreeNamesIdent(fn.fnBody, p3.parName, 0)
      ) {
        return emitFail(
          "emitProgram: a record argument's fields name a row that holds another field kind, and a record is shared rather than converted",
        )
      }
      if anonTy >= 0 && nt >= 0 && isLit && monoConcreteObjTy(pinTys[pj]) {
        monoAnonParamPinTy.set(nt, pinTys[pj])
      }
      nps.push(
        monoCopyOf(
          params[pj],
          mkParam(p3.parName, nt, p3.parDefault, p3.parOpt, p3.parRest, -1),
        ),
      )
    }
    pinnedTyIx.push(pinTy)
    pj = pj + 1
  }
  0
}

// The instance body cloned at this pin with its lambdas pinned: `monoCloneBody` at the
// binding (joined with the holes' binding where a join names a hole), then the reach and
// unsafe-name notes and `monoPinBodyLambdas`. Restores every pin global it sets.
function monoMakeInstanceBodyPinned(
  fn: FuncDecl,
  origFe: i32,
  first: boolean,
  nret: i32,
  tps: string[],
  tvN: string[],
  tvV: string[],
  letBN: string[],
  letBT: i32[],
  instHoleN: string[],
  instHoleT: i32[],
) {
  // A join the checker kept apart over a parameter hole names the hole, which only the holes'
  // binding binds: the body's walks read both (D3333).
  let bodyBN = letBN
  let bodyBT = letBT
  if holeNamesTpJoin(instHoleN) {
    bodyBN = []
    bodyBT = []
    monoJoinBinding(letBN, letBT, instHoleN, instHoleT, bodyBN, bodyBT)
  }
  const svPinFn = njSetPinFn(monoOrigNode[origFe])
  const instBody0 = monoCloneBody(fn.fnBody, tps, tvN, tvV, bodyBN, bodyBT)
  // D426 — substitute a bound lambda's own annotations at this pin, and mint the lambda
  // per instance. `monoCloneBody` above shares every leaf expression including a nested
  // lambda, which is right for a concrete lambda and wrong for one written at `T`.
  // Copy-on-write: a body with no such lambda is the same node index.
  monoLamMintedSlots = []
  monoLamCloneSlots = []
  monoInstIsFirst = first
  monoCgcLamNames = monoInstLamNames(instBody0)
  monoCgcGenAliasNames = monoInstGenAliasNames(instBody0)
  monoCgcAliasScope = []
  monoPinUnsafeNames = Map()
  monoPinRetBox = false
  if fn.fnRet < 0 && nret >= 0 {
    const nrb = nodeTyIxOf(nret)
    // A null-bearing box is left out: its caller reads the call at the template's type.
    monoPinRetBox = nrb >= 0
      && nrb < T.tys.length
      && tyAt(nrb) is TyUnion
      && !tyBearsNull(nrb)
  }
  monoPinReachNames = Map()
  monoPinNoteReach(monoOrigNode[origFe])
  if monoPinReachShadowed(instBody0) {
    monoPinRetBox = false
    monoPinReachNames = Map()
  }
  monoPinNoteUnsafeBody(instBody0)
  monoPinRetBox = false
  // A hole instance's lambdas, list literals and reads are typed at its holes, which its
  // parameters' binding does not name: they pin through the holes' binding too (D3083, D3066).
  const svHoleN = monoPinHoleN
  const svHoleT = monoPinHoleT
  monoPinHoleN = instHoleN
  monoPinHoleT = instHoleT
  const instBody0L = monoPinBodyLambdas(
    instBody0,
    tps,
    tvN,
    tvV,
    bodyBN,
    bodyBT,
  )
  monoPinHoleN = svHoleN
  njSetPinFn(svPinFn)
  monoPinHoleT = svHoleT
  instBody0L
}

// The instance body's per-pin rewrites after its lambdas are pinned: the `.map`/`.filter`
// callbacks, baked callbacks, per-instance generic-call copies, layout constants and the
// hole operators, in that order. Each rung is copy-on-write, so a body none of them touches
// comes back as `instBody0L` itself.
function monoMakeInstanceBodyRewrite(
  instBody0L: i32,
  origFe: i32,
  params: i32[],
  pinTys: i32[],
  pinnedTyIx: i32[],
  cbFnNames: string[],
  tps: string[],
  tvN: string[],
  tvV: string[],
  exSubN: string[],
  exSubT: i32[],
) {
  // Pin any `.map`/`.filter` callback lambda whose receiver param the elaboration types at a
  // non-i32 element in this instance: the shared body's un-annotated lambda would otherwise
  // emit as i32. i32 shapes are left as they are.
  const pElemNames: string[] = []
  let pe = 0
  while pe < params.length {
    const pep = nodeAt(params[pe])
    if pep is Param {
      pElemNames.push(pep.parName)
    } else {
      pElemNames.push("")
    }
    pe = pe + 1
  }
  const instBody1 = monoPinMapLambdas(instBody0L, pElemNames)
  // Bake any non-capturing concrete callback into a direct call. No baked callback → no
  // rewrite → the body is the same node `monoPinMapLambdas` produced.
  let instBody2 = instBody1
  if monoAnyBakedCallback(cbFnNames) {
    instBody2 = monoBakeCallback(instBody1, cbFnNames, monoBakeSpecK)
  }
  // Per-instance copies of the direct generic calls this body makes, so instantiating
  // them rewrites only this instance's callee `Ident`s. No generic call → the same node.
  monoCgcTyParams = tps
  monoCgcTvN = tvN
  monoCgcTvV = tvV
  monoCgcSubN = exSubN
  monoCgcSubT = exSubT
  const instBody3 = monoCloneGenericCalls(instBody2)
  monoCgcLamNames = []
  monoCgcLamDeclX = []
  monoCgcHoleN = []
  monoCgcHoleT = []
  monoCgcTyParams = []
  monoCgcTvN = []
  monoCgcTvV = []
  monoCgcSubN = []
  monoCgcSubT = []
  // Per-instance layout constants for the type parameters this body reads
  // (`i * T.size`) — folded HERE because the binding is what makes them exist.
  monoFoldSubN = exSubN
  monoFoldSubT = exSubT
  const instBody4 = monoFoldTyParamLayout(instBody3, tps, tvN, tvV)
  monoFoldSubN = []
  monoFoldSubT = []
  // The two questions `dispatchRewrite` asks of a hole, re-asked at the pin. Last in the
  // chain, so it sees the body every rung above produced; copy-on-write, so a body with
  // no such operator is the same node index.
  monoPinCtx = monoOrigNode[origFe]
  monoPinArgTys = pinTys
  const instBody = monoPinBinOps(instBody4, pElemNames, pinnedTyIx)
  monoPinCtx = -1
  monoPinArgTys = []
  instBody
}

// A later instance of `fn`: appends `nfn` as a new function slot under its frame, refuses a
// reassigned binding called at a second signature, and renames the callee to `instName`.
// Returns the new slot's index, or -1 once `emitFail` has recorded the refusal.
function monoMakeInstanceLater(
  fn: FuncDecl,
  nfn: i32,
  origFe: i32,
  calleeIx: i32,
  callFrame: i32,
  instName: string,
) {
  // D971 — a lifted capturing instance takes its env as a leading `structref` param,
  // so a by-name call to it is sound. What is not is the rename folding a call into
  // the initializer's instance when the binding is reassigned.
  const cal3 = nodeAt(calleeIx)
  // A call by the generic's own name is never a binding's, so it skips the write scan (D4607).
  if cal3 is Ident && cal3.identName != fn.fnName {
    // A binding written anywhere on its alias chain holds one signature as surely as one
    // written itself (D3858).
    // A lambda dispatch arm's instances are each frame's row entry, not one binding's.
    const written = monoArmLamFe(calleeIx, cal3) < 0
      && (monoNameWrittenAt(cal3.identName, calleeIx)
      || i32ListHas(monoNoRename, calleeIx)
      && !i32ListHas(monoBundleReads, calleeIx))
    if (written && calleeIx != monoWriteCoercedCall) {
      // A frame-keyed instance differs by its enclosing instance, not its argument type.
      if callFrame >= 0 {
        return emitFail(
          "emitProgram: the reassigned function binding `"
            + cal3.identName
            + "` holds a nested generic that captures its enclosing generic's values, at "
            + "more than one instance of it — one binding holds one closure signature. Bind "
            + "a separate value per instance, or call the nested function by its name",
        )
      }
      // A binding never written itself is a copy of one that is, and is named as one.
      let what = "the reassigned function binding `" + cal3.identName + "` is"
      let wants = "the values written to it want two"
      if !monoNameWrittenAt(cal3.identName, calleeIx) {
        what = "the function binding `"
          + cal3.identName
          + "`, a copy of a reassigned binding, is"
        wants = "its calls want two"
      }
      return emitFail(
        "emitProgram: "
          + what
          + " called at more than one argument type — one binding holds one closure "
          + "signature, and "
          + wants
          + ". Annotate the parameters, or bind a separate value per type",
      )
    }
  }
  if origFe >= 0 && origFe < monoOrigNode.length {
    fnTagLeafCarry(nfn, monoOrigNode[origFe])
    voidCtxLambdaCarry(nfn, monoOrigNode[origFe])
  }
  fnStmts.push(nfn)
  // A nested template's later instance keeps the template's frame, so its captures
  // resolve where the first instance's do and its env fields take their real types (D2749).
  let instParent = -1
  if origFe < fnParent.length { instParent = fnParent[origFe] }
  if callFrame >= 0 { instParent = callFrame }
  fnParent.push(instParent)
  if callFrame >= 0 { invalidateFnChildIndex() }
  fnDispNames.push("")
  const instFe = fnStmts.length - 1
  // D943 — the clones' frame is this instance, not the template. `captureValKind`
  // types an env field by resolving the capture in its enclosing frame, so until this
  // runs the clone reads `value: T` and every instance mints the same env layout.
  let mls = 0
  let mlsWrote = false
  while mls < monoLamMintedSlots.length {
    const msl = monoLamMintedSlots[mls]
    if msl >= 0 && msl < fnParent.length {
      buildFnMapNoteFnSlotWrite()
      fnParent[msl] = instFe
      mlsWrote = true
    }
    mls = mls + 1
  }
  if mlsWrote { invalidateFnChildIndex() }
  monoLamMintedSlots = []
  if calleeIx < 0 { return instFe }
  const cal2 = nodeAt(calleeIx)
  // A call through a never-written alias of a capturing nested generic, keyed on its frame:
  // the alias's own value is that instance's closure, whose env holds this frame's captures.
  if (
    cal2 is Ident
    && callFrame >= 0
    && callFrame < fnStmts.length
    && cal2.identName != fn.fnName
  ) {
    const actx = fnStmts[callFrame]
    monoRenameGenAliasInit(calleeIx, actx, fn.fnName, instName)
  }
  // R4 writer 6 of 8 (`compiler/symbols.vl`; census in `perf-program.md`).
  if cal2 is Ident && !i32ListHas(monoNoRename, calleeIx) {
    monoAliasCallNote(calleeIx)
    cal2.identName = instName
    monoNoteRenamed(calleeIx, instFe)
    let instDecl = fnStmts[instFe]
    if identAuditDrop == IDENT_DROP_MONO_CALLEE { instDecl = -1 }
    sidNoteNodeName(calleeIx, instDecl)
  }
  instFe
}

// The instance's return annotation node: `elabRetOf` substituted through its binding, or the
// rep `retRep` its returned parameter is delivered at (`elabCallArgRep`) where that is a bundle's
// or a wider record; the declared node where it names no type parameter; -1 for none, -2 when a
// union it mints cannot be registered. `ELAB_REP_NO_ROW` is a recorded failure.
function monoInstanceRet(
  fn: FuncDecl,
  ek: i32,
  tps: string[],
  retRep: i32,
): i32 {
  if fn.fnRet >= 0 && !monoAnnHasTyParam(fn.fnRet, -1, tps) { return fn.fnRet }
  // The failure is recorded and the walk goes on at the result's own type (emitFail does not halt).
  if retRep == ELAB_REP_NO_ROW {
    emitFail(
      "emitProgram: monomorphize: the elaboration records no reach of `"
        + fn.fnName
        + "` by the call building it, so the rep its returned parameter takes is unknown",
    )
  }
  // A parameter delivered as a bundle's record and returned whole is returned as that record.
  if fn.fnRet < 0 && retRep >= 0 && elabIsBundleTy(retRep) {
    const brow = bundleRecordRowOfTy(retRep)
    if brow >= 0 && brow < sNames.length { return synthTypeRefOfTy(retRep, -1) }
  }
  let r = elabRetOf(ek)
  // A parameter delivered at a wider record than its type is returned at that record.
  if r >= 0 && retRep >= 0 && recRepWidens(r, retRep) { r = retRep }
  if r < 0 {
    if fn.fnRet < 0 { return -1 }
    return emitFail(
      "emitProgram: monomorphize: a return type parameter of `"
        + fn.fnName
        + "` is not bound by any parameter",
    )
      - 1
  }
  monoClosedRecordOwnRow(r)
  const nm = monoInstanceRetSpelling(r)
  if nm == "" { return -1 }
  if monoRegisterPinUnion(nm, r) < 0 { return -2 }
  if registerTyReachUnions(monoProgStmts, r) < 0 { return -2 }
  // A literal union spelled by its alias carries the alias's row, whose rep the name promises.
  const at = if tyIsLitUnion(r) { litUnionAliasTyOfLitTexts(tyLitMemberTexts(r)) } else { -1 }
  synthTypeRefTy(nm, -1, if at >= 0 { at } else { r })
}

// The source node of argument `a`, peeled: an instance copy's argument maps to its template's,
// the node the checker's tables key.
function monoArgSrcOf(a: i32): i32 {
  let x = unwrapParen(a)
  let guard = 0
  while x >= 0 && guard < 16 && (nodeSrc[x] ?? -1) >= 0 {
    x = nodeSrc[x] ?? -1
    guard = guard + 1
  }
  x
}

// Gives closed undeclared record type `r` a row of its own, keyed by the type, when it has none:
// a row matched by field names alone may be another type's that boxes a field `r` stores bare.
function monoClosedRecordOwnRow(r: i32) {
  if r < 0 || r >= T.tys.length || !(tyAt(r) is TyObj) || tyHasTyVar(r) {
    return
  }
  if structNameOfTy(r) != "" || repRowOfTyStruct(r, sScanLim()) >= 0 { return }
  internOwnShapeOfTy(r)
}

// The spelling of instance return `r`: a literal union by its alias, which a render softens to
// `string`; a primitive by its own name, `never` included; anything else by the naming rule, and
// by its arena name only where the rule has no spelling.
function monoInstanceRetSpelling(r: i32): string {
  if tyIsLitUnion(r) { return monoPinAnnSpelling(r) }
  const p = tyAt(r)
  if p is TyPrim { return p.primName }
  const sp = monoPinSpellShaped(r)
  if sp != "" { return sp }
  arenaEmitName(r)
}

// Result type `r` where it is two lists no one rep stores, else -1.
function monoTwoListOf(r: i32): i32 {
  if r < 0 || !tyUnionAllLists(r) { return -1 }
  if listUnionSharedRep(r) >= 0 { return -1 }
  r
}

// Records a new instance under `key` in the registry, with the side tables keyed by its
// slot `instFe`: the two-list result type.
function monoMakeInstanceRegister(
  key: string,
  origFe: i32,
  instName: string,
  instFe: i32,
  twoListTy: i32,
) {
  monoKeys.push(key)
  monoInstOrig.push(origFe)
  monoInstName.push(instName)
  monoInstFe.push(instFe)
  monoLastInstFe = instFe
  if twoListTy >= 0 { monoTwoListRet.set(instFe, twoListTy) }
  while fnInstOrigin.length <= instFe { fnInstOrigin.push(-1) }
  if instFe != origFe { fnInstOrigin[instFe] = origFe }
}

// Walks a registered instance's body and its lambda clones' bodies, so their own generic
// calls instantiate at this instance's types, under the nesting bound. 0 on success, -1 on
// a recorded failure.
function monoMakeInstanceWalk(
  fn: FuncDecl,
  origFe: i32,
  nfn: i32,
  calleeIx: i32,
  lamClones: i32[],
) {
  // A nested walk of one template here mints a new pin, since a repeated pin hits the
  // registry; past the bound the pins grow without end, as in `f<T>` calling `f<T[]>` (D2721).
  while monoActiveDepth.length <= origFe { monoActiveDepth.push(0) }
  if monoActiveDepth[origFe] >= MONO_NEST_MAX {
    return emitFailAt(
      "emitProgram: monomorphize: `"
        + fn.fnName
        + "` instantiates itself at a new type on every call, so it has no finite set of instances",
      calleeIx,
    )
  }
  monoActiveDepth[origFe] = monoActiveDepth[origFe] + 1
  // Walk this instance's body — a nested generic call instantiates its own callee
  // against this instance's concrete annotations, and the callee rename lands on the
  // instance's own `Call` spine rather than on nodes its siblings share.
  const walked = monoWalkFnBody(nfn)
  monoActiveDepth[origFe] = monoActiveDepth[origFe] - 1
  if walked < 0 { return -1 }
  // A clone's body is walked beside its instance's: its generic calls are its own copies,
  // and the template's walk pinned the template's (D2553).
  // A clone still generic in its own parameters goes last, and only while no walk has
  // instantiated it: walking it renames in place the calls its instances copy (D13660).
  let pass = 0
  while pass < 2 {
    let lci = 0
    while lci < lamClones.length {
      const ls = lamClones[lci]
      if ls >= 0 && ls < fnStmts.length {
        const gen = ls < monoGen.length && monoGen[ls] == 1
        if gen == (pass == 1) && !(gen && monoInstantiatedAny(ls)) {
          if monoWalkFnBody(fnStmts[ls]) < 0 { return -1 }
        }
      }
      lci = lci + 1
    }
    pass = pass + 1
  }
  if monoRegisterInstance() < 0 { return -1 }
  0
}

// The body's binding column, one row per entry of `params`: `pinnedTyIx` except at a
// function-type or closure-pinned parameter, which takes the argument's own row from
// `pinTys` (-1 where neither has one).
function monoMakeInstanceLetTyCol(
  params: i32[],
  pinned: string[],
  pinKinds: i32[],
  pinTys: i32[],
  pinnedTyIx: i32[],
) {
  // The body's binding column, built from `pinnedTyIx` except at a function-type
  // parameter, where it takes the argument's own arena row. A pin name substitutes each
  // type parameter's bound name, and a literal union's bound name is the softened
  // `string` — so one instance spelled `U[]` two ways, atom-backed and string-ref-backed.

  // Not everywhere: taking `pinTys` at every position reddens the litunion-ordering
  // family, because a value parameter's pin name carries a nominal fact a row does not.
  const letTyCol: i32[] = []
  let lj = 0
  while lj < params.length {
    let lt = -1
    if lj < pinnedTyIx.length { lt = pinnedTyIx[lj] }
    if lj < pinned.length && lj < pinTys.length && pinTys[lj] >= 0 {
      if tyIxIsFunc(pinTys[lj]) || pinKinds[lj] == PIN_SIGKEY {
        lt = pinTys[lj]
      }
      // A pin spelling renders a nested Set as its boolean map, so where the argument's row
      // differs from the parsed pin only so, the column takes the row (D10540).
      if (
        lt >= 0
        && lt != pinTys[lj]
        && !tySameSet(pinTys[lj], lt, TY_WALK_DEPTH)
        && tySameSpelled(pinTys[lj], lt, TY_WALK_DEPTH)
      ) {
        lt = pinTys[lj]
      }
    }
    letTyCol.push(lt)
    lj = lj + 1
  }
  letTyCol
}

// The name of a later instance of `fn`: its name with the next free `$<n>` suffix past
// `count` instances (one more when the template's slot is free, which it then records).
function monoMakeInstanceLaterName(
  fn: FuncDecl,
  origFe: i32,
  count: i32,
  slotFree: boolean,
) {
  let suffix = count
  if slotFree {
    suffix = count + 1
    monoFramedPushes.set(origFe, count + 1)
  }
  let instName = fn.fnName + "$" + i32ToStr(suffix)
  // Two nested generics of one name in different functions count their instances apart,
  // so a suffix the other already minted is skipped: the renamed call would reach it (D3830).
  while monoInstNameTaken(instName) {
    suffix = suffix + 1
    instName = fn.fnName + "$" + i32ToStr(suffix)
  }
  instName
}

// The head of an instance's registry key: the template's slot, the pending `monoKeyExtra`
// (consumed here), and the call frame when the instance is frame-keyed.
function monoMakeInstanceKeyHead(origFe: i32, callFrame: i32): string {
  let key = i32ToStr(origFe) + "#" + monoKeyExtra
  monoKeyExtra = ""
  monoKeyExtraN = []
  monoKeyExtraT = []
  monoKeyExtraS = []
  if callFrame >= 0 { key = key + "^" + i32ToStr(callFrame) }
  key
}

// A closure-pinned param flips the module's function-value machinery on (the instance body
// `call_ref`s through it; the argument side builds the fat pointer), as a lifted lambda does.
function monoPinKindsNoteFnVal(pinKinds: i32[]) {
  let pv = 0
  while pv < pinKinds.length {
    if pinKinds[pv] == PIN_SIGKEY { fnValUsed = true }
    pv = pv + 1
  }
  0
}

// How many instances of the template at `origFe` exist so far.
function monoInstanceCount(origFe: i32): i32 {
  let count = 0
  let k2 = 0
  while k2 < monoInstOrig.length {
    if monoInstOrig[k2] == origFe { count = count + 1 }
    k2 = k2 + 1
  }
  count
}

// Hands the body clone the instance's hole binding `holeN`/`holeT` in `monoCgcHoleN`/`monoCgcHoleT`.
function monoMakeInstanceHoles(holeN: string[], holeT: i32[]) {
  monoCgcHoleN = holeN
  monoCgcHoleT = holeT
  0
}

// The instance's declared result: `nret`, or -1 when a bare `return` makes the template void
// whatever its tail's type is, or its result is never consumed — `computeVoidFns` then
// classifies the clone from its own body (D1600).
function monoMakeInstanceRetIx(fn: FuncDecl, origFe: i32, nret: i32): i32 {
  let instRet = nret
  if fn.fnRet < 0 && blockHasBareReturn(fn.fnBody) { instRet = -1 }
  if fnResultUnconsumed(monoOrigNode[origFe]) { instRet = -1 }
  instRet
}

// Installs the first instance `nfn` in the template's own slot: it keeps the bare name and
// the original's wasm index.
function monoMakeInstanceFirst(
  origFe: i32,
  nfn: i32,
  calleeIx: i32,
  instName: string,
) {
  buildFnMapNoteFnStmtWrite(origFe, nfn)
  fnTagLeafCarry(nfn, monoOrigNode[origFe])
  voidCtxLambdaCarry(nfn, monoOrigNode[origFe])
  fnStmts[origFe] = nfn
  monoLamCallByName(calleeIx, origFe, instName)
  0
}

// An instance's registry key, and the type-parameter bindings the key names.
type MonoInstKey = {
  key: string,
  tps: string[],
  exBN: string[],
  exBT: i32[],
  exSubN: string[],
  exSubT: i32[],
  argLit: boolean[],
  pinAt: i32,
  pinEnd: i32,
  extraAt: i32,
  extraEnd: i32,
  extraN: string[],
  extraT: i32[],
  extraS: string[],
}

// The key of `fn`'s instance at these pins, taking over the staged explicit bindings.
function monoMakeInstanceKeyOf(
  fn: FuncDecl,
  origFe: i32,
  callFrame: i32,
  callKey: i32,
  pinned: string[],
  pinTys: i32[],
  pinOwn: i32[],
  tvN: string[],
  tvV: string[],
  cbFnNames: string[],
): MonoInstKey {
  // A nested generic's instance binds what its enclosing instance binds too, so a signature
  // or a capture naming the enclosing type parameter lowers at that pin (D3829, D3831).
  const tps: string[] = []
  for tp in fn.fnTyParams { tps.push(tp) }
  const outerN: string[] = []
  const outerT: i32[] = []
  monoEnclosingPinRow(origFe, callFrame, fn.fnTyParams, outerN, outerT)
  const extraAt = i32ToStr(origFe).length + 1
  const extraEnd = extraAt + monoKeyExtra.length
  const extraN = monoKeyExtraN
  const extraT = monoKeyExtraT
  const extraS = monoKeyExtraS
  let key = monoMakeInstanceKeyHead(origFe, callFrame)
  const exBN = monoExplicitBN
  const exBT = monoExplicitBT
  key = key + monoBindEnclosingPins(outerN, outerT, tps, exBN, exBT, tvN, tvV)
  const argLit = monoPinArgLit
  monoExplicitBN = []
  monoExplicitBT = []
  monoPinArgLit = []
  // The exact-type binding the key names, read again by the body rewrite.
  const exSubN: string[] = []
  const exSubT: i32[] = []
  const pinAt = key.length
  key = key
    + monoKeyPinSeg(
    pinned,
    pinned,
    pinTys,
    pinOwn,
    monoUnionTyParamPins(fn),
    elabTestsTyVar(monoOrigNode[origFe]),
  )
  const pinEnd = key.length
  key = monoMakeInstanceKey(
    key,
    origFe,
    callKey,
    tps,
    exBN,
    exBT,
    exSubN,
    exSubT,
    cbFnNames,
  )
  const k: MonoInstKey = {
    key: key,
    tps: tps,
    exBN: exBN,
    exBT: exBT,
    exSubN: exSubN,
    exSubT: exSubT,
    argLit: argLit,
    pinAt: pinAt,
    pinEnd: pinEnd,
    extraAt: extraAt,
    extraEnd: extraEnd,
    extraN: extraN,
    extraT: extraT,
    extraS: extraS,
  }
  k
}

// `k.key` with each pin's spelling replaced by its kind and the canonical key of the type the
// clone resolved it to, so two spellings of one type (`i32|string`, `string|i32`) share an
// instance. A pin the clone resolved no type for is refused.
function monoTypedInstKey(
  origFe: i32,
  k: MonoInstKey,
  pinned: string[],
  pinKinds: i32[],
  pinTys: i32[],
  pinOwn: i32[],
  pinnedTyIx: i32[],
): string {
  const heads: string[] = []
  let pk = 0
  while pk < pinned.length {
    let pin = ""
    if pk < pinnedTyIx.length && pk < pinKinds.length {
      if pinnedTyIx[pk] >= 0 {
        pin = i32ToStr(pinKinds[pk])
          + ":"
          + tyCanonKey(pinnedTyIx[pk], TY_WALK_DEPTH)
      }
    }
    // A function value's pin is keyed by its closed function type.
    const ht = monoSigPinHeadTy(
      if pk < pinTys.length { pinTys[pk] } else { -1 },
    )
    if ht >= 0 && pk < pinKinds.length {
      const np = i32ToStr(pinKinds[pk]) + ":" + tyCanonKey(ht, TY_WALK_DEPTH)
      pin = np
    }
    if pin == "" {
      emitFail(
        "emitProgram: monomorphize: a pinned parameter has no resolved type to key its instance by",
      )
      return ""
    }
    heads.push(pin)
    pk = pk + 1
  }
  const fd = nodeAt(monoOrigNode[origFe])
  const none: boolean[] = []
  const seg = monoKeyPinSeg(
    heads,
    pinned,
    pinTys,
    pinOwn,
    if fd is FuncDecl { monoUnionTyParamPins(fd) } else { none },
    elabTestsTyVar(monoOrigNode[origFe]),
  )
  if !(fd is FuncDecl) {
    return k.key.slice(0, k.pinAt) + seg + k.key.slice(k.pinEnd, k.key.length)
  }
  k.key.slice(0, k.extraAt)
    + monoTypedExtra(k, fd, pinnedTyIx)
    + k.key.slice(k.extraEnd, k.pinAt)
    + seg
    + monoTypedTail(k, fd, pinnedTyIx)
}

// The canonical type a pinned parameter whose annotation's type mentions `tp` binds it to, else "":
// the binding the pins already name. Read off the annotation's type, never its spelling.
function monoPinnedTyParamCanon(
  fd: FuncDecl,
  tp: string,
  pinnedTyIx: i32[],
): string {
  let i = 0
  while i < fd.fnParams.length && i < pinnedTyIx.length {
    const p = nodeAt(fd.fnParams[i])
    const pt = pinnedTyIx[i]
    if p is Param && p.parType >= 0 && pt >= 0 {
      const at = nodeTyIxOf(p.parType)
      const a = if at >= 0 && at < T.tys.length { tyAt(at) } else { null }
      if a is TyVar && a.tvName == tp { return tyCanonKey(pt, TY_WALK_DEPTH) }
      if a is TyArray && tyAt(pt) is TyArray {
        const ae = tyArrayElemIx(at)
        const e = if ae >= 0 { tyAt(ae) } else { null }
        if e is TyVar && e.tvName == tp {
          return tyCanonKey(tyArrayElemIx(pt), TY_WALK_DEPTH)
        }
      }
      // An annotation naming `tp` inside another type (`CN<T> | null`) binds it by the checker's
      // walk of the annotation against the pin.
      if a != null && tyHasTyVar(at) {
        const bn: string[] = []
        const bt: i32[] = []
        bindGenWalk(at, pt, bn, bt)
        let j = 0
        while j < bn.length && j < bt.length {
          if bn[j] == tp && bt[j] >= 0 && !tyHasTyVar(bt[j]) {
            return tyCanonKey(bt[j], TY_WALK_DEPTH)
          }
          j = j + 1
        }
      }
    }
    i = i + 1
  }
  ""
}

// The key's explicit and defaulted bindings, each by its canonical type, leaving out one the
// pins already name, so `f<i32>(x)` and `f(x)` at an `i32` pin share an instance. A binding with
// no closed type keeps its text: the type parameter it names is the enclosing instance's.
function monoTypedExtra(
  k: MonoInstKey,
  fd: FuncDecl,
  pinnedTyIx: i32[],
): string {
  let out = ""
  let i = 0
  while i < k.extraN.length && i < k.extraT.length && i < k.extraS.length {
    const t = k.extraT[i]
    if t < 0 || t >= T.tys.length || tyHasTyVar(t) {
      out = out + k.extraS[i]
    } else {
      const c = tyCanonKey(t, TY_WALK_DEPTH)
      if (
        monoPinnedTyParamCanon(fd, k.extraN[i], pinnedTyIx) != c
        && monoKeyExactCanon(k, k.extraN[i]) != c
      ) {
        out = out + k.extraN[i] + "=" + c + ";"
      }
    }
    i = i + 1
  }
  out
}

// The canonical type the key's exact-type binding (`~tp=t;`) names for `tp`, else "".
function monoKeyExactCanon(k: MonoInstKey, tp: string): string {
  const tail = k.key.slice(k.pinEnd, k.key.length)
  const want = "~" + tp + "="
  let i = 0
  while i + want.length <= tail.length {
    if tail.slice(i, i + want.length) == want {
      let j = i + want.length
      while j < tail.length && tail[j] != ';' { j = j + 1 }
      return tail.slice(i + want.length, j)
    }
    i = i + 1
  }
  ""
}

// The key's text past its pins, leaving out an exact-type binding (`~tp=t;`) that names the
// binding the pins already give `tp`.
function monoTypedTail(
  k: MonoInstKey,
  fd: FuncDecl,
  pinnedTyIx: i32[],
): string {
  const tail = k.key.slice(k.pinEnd, k.key.length)
  let out = ""
  let i = 0
  while i < tail.length {
    if tail[i] == '~' {
      let j = i + 1
      while j < tail.length && tail[j] != ';' { j = j + 1 }
      const seg = tail.slice(i + 1, j)
      let eq = 0
      while eq < seg.length && seg[eq] != '=' { eq = eq + 1 }
      const tp = seg.slice(0, eq)
      const t = seg.slice(eq + 1, seg.length)
      if eq >= seg.length || monoPinnedTyParamCanon(fd, tp, pinnedTyIx) != t {
        out = out + tail.slice(i, j + 1)
      }
      i = j + 1
    } else {
      out = out + tail.slice(i, i + 1)
      i = i + 1
    }
  }
  out
}

// `t` when it is a closed function type that pins as a wasm signature, else -1.
function monoSigPinHeadTy(t: i32): i32 {
  if monoPinTyIsFnSig(t) && monoTyClosedFn(t) { t } else { -1 }
}

// Typed instance key → the registry row of the instance first minted under it.
let monoTypedKeys: {[string]: i32} = Map()

// Instance slot → the instance its function is elaborated at, and its parameter pins.
let monoInstEk: {[i32]: i32} = Map()
let monoInstPins: {[i32]: i32[]} = Map()

// Binds each enclosing pin that has a spelling, and returns the key text naming them.
function monoBindEnclosingPins(
  outerN: string[],
  outerT: i32[],
  tps: string[],
  exBN: string[],
  exBT: i32[],
  tvN: string[],
  tvV: string[],
): string {
  let key = ""
  let on = 0
  while on < outerN.length {
    const osp = monoPinAnnSpelling(outerT[on])
    if osp != "" {
      tps.push(outerN[on])
      exBN.push(outerN[on])
      exBT.push(outerT[on])
      tvN.push(outerN[on])
      tvV.push(osp)
      key = key + "|" + outerN[on] + "=" + tyCanonKey(outerT[on], TY_WALK_DEPTH)
    }
    on = on + 1
  }
  key
}

// The instance `FuncDecl` of `fn` named `instName`, over params `nps` and body `instBody`.
function monoMakeInstanceFunc(
  fn: FuncDecl,
  origFe: i32,
  nret: i32,
  instBody: i32,
  instName: string,
  nps: i32[],
): i32 {
  const noTyParams: string[] = []
  const instRet = monoMakeInstanceRetIx(fn, origFe, nret)
  if instBody != fn.fnBody { bodyRebuiltFrom.set(instBody, fn.fnBody) }
  const nfn = mkFunc(instName, noTyParams, nps, instRet, instBody, -1)
  // The instance is anchored at its template's name, so a refusal raised while its body is lowered
  // names the template, not the parser's last token (D15155). Only the anchor: a declaring-name
  // token would rename the instance in the name section.
  if origFe >= 0 && origFe < monoOrigNode.length {
    const tpl = monoOrigNode[origFe]
    adoptNodeTok(nfn, tpl)
    const nt = declNameTokOf(tpl)
    if nt >= 0 && nfn < nodeToks.length { nodeToks[nfn] = nt }
  }
  nfn
}

// Installs instance `nfn` and returns its function slot, -1 on a refusal.
function monoMakeInstanceInstall(
  fn: FuncDecl,
  nfn: i32,
  origFe: i32,
  calleeIx: i32,
  callFrame: i32,
  instName: string,
  first: boolean,
): i32 {
  if first {
    monoMakeInstanceFirst(origFe, nfn, calleeIx, instName)
    return origFe
  }
  monoMakeInstanceLater(fn, nfn, origFe, calleeIx, callFrame, instName)
}

// Refuses a pin type column not parallel to the pins: -1, else 0.
function monoPinColsMisalignedFail(
  pinned: string[],
  pinTys: i32[],
  pinOwn: i32[],
): i32 {
  // The pin columns are positional and nothing downstream can tell a misaligned one from a
  // correct one — param j would silently read param k's type. Checked once, loudly, here
  // rather than bounds-guarding each read: a guard turns misalignment into a silently wrong
  // type, and a short-but-nonempty column is exactly what a bounds guard cannot see.
  if pinTys.length != pinned.length || pinOwn.length != pinned.length {
    return emitFail(
      "emitProgram: monomorphize: pin type column is not parallel to the pins",
    )
  }
  0
}

// `monoMakeInstance` itself.
function monoMakeInstanceGo(
  origFe: i32,
  pinned: string[],
  pinKinds: i32[],
  pinTys: i32[],
  pinOwn: i32[],
  tvN: string[],
  tvV: string[],
  calleeIx: i32,
  annotateI32: boolean,
  cbFnNames: string[],
) {
  const callFrame = monoCallFrameSlot
  monoCallFrameSlot = -1
  const specK = monoSpecGoK
  monoSpecGoK = -1
  // The delivery this build answers, read in the instance being walked before this one's.
  const cadDel = cadDelivery
  cadDelivery = -1
  const cadEncl = cadInstTop()
  const makeCall = monoMakeCallIx
  monoMakeCallIx = -1
  const retWidenKey = monoInstRetWidenKey
  const retWidenTy = monoInstRetWidenTy
  const retWiden = retWidenTy >= 0
  monoInstRetWidenKey = ""
  monoInstRetWidenTy = 0 - 1
  if monoPinColsMisalignedFail(pinned, pinTys, pinOwn) < 0 { return -1 }
  // Every caller bounds `origFe` by `monoGen`, which `monoOrigNode` stays parallel to.
  if origFe < 0 || origFe >= monoOrigNode.length {
    return emitFail(
      "emitProgram: monomorphize: instance origin is not a template slot",
    )
  }
  const fn = nodeAt(monoOrigNode[origFe])
  if fn is FuncDecl {
    const params = fn.fnParams
    const tplCall = if makeCall >= 0 { monoCallTplOf(makeCall) } else { -1 }
    // A call's instance is keyed by the elaboration's key for that call plus the pinned reps, not
    // by the pins' spelling (architecture-target §3.4, the call half).
    const valueHalf = elabDeclIsValue(monoOrigNode[origFe])
    const callKey = if tplCall >= 0 && !valueHalf { elabWalkKeyOf(tplCall, true, monoOrigNode[origFe]) } else { -1 }
    const k = monoMakeInstanceKeyOf(
      fn,
      origFe,
      callFrame,
      callKey,
      pinned,
      pinTys,
      pinOwn,
      tvN,
      tvV,
      cbFnNames,
    )
    if retWiden { k.key = k.key + "=>" + retWidenKey }
    // Mono's own spelling, which the typed fallback below slices at `k`'s recorded offsets.
    const spelledKey = k.key
    // A lambda's instance is keyed by the instance it is nested in and its own pinned reps
    // (architecture-target §3.4, the lambda key); one made outside any instance keeps mono's key.
    const lamTop = if callKey < 0 && monoCadIsLam(monoOrigNode[origFe]) { elabWalkTop() } else { -1 }
    // A function delivered as a value is keyed, call and value alike, by the elaboration's key for
    // the instance (architecture-target §3.4, the value half); one with none keeps mono's spelling.
    const valueKey = if callKey < 0 && lamTop < 0 && (valueHalf || tplCall < 0) { instKeyValueTime(tplCall, calleeIx, monoOrigNode[origFe], pinTys) } else { -1 }
    // A lambda built inside an instance binds at the elaboration's key for it there.
    const lamKey = if lamTop >= 0 { elabLamKeyOf(monoOrigNode[origFe]) } else { -1 }
    // Where nothing keys the build, the instance whose closed signature its pins are binds it: an
    // un-annotated function's, else a generic's at those parameter types (a value read out of a
    // container, which no delivery keys).
    const holePinKey = if callKey < 0 && valueKey < 0 && lamKey < 0 { elabHoleKeyAtPins(monoOrigNode[origFe], pinTys) } else { -1 }
    const pinKey = if callKey < 0 && valueKey < 0 && lamKey < 0 && holePinKey < 0 { elabMemberKeyAtTys(pinTys, monoOrigNode[origFe]) } else { holePinKey }
    // Else a declaration the checker closed has one type, its signature, which binds the build
    // where every pin is that signature's parameter.
    const closedSig = if callKey < 0 && lamTop < 0 && valueKey < 0 && pinKey < 0 { elabClosedSigAtPins(monoOrigNode[origFe], pinTys) } else { -1 }
    const shValKey = if valueKey >= 0 { valueKey } else if lamKey >= 0 { lamKey } else { pinKey }
    const shPath = if callKey >= 0 { "call" } else if lamTop >= 0 { "lam" } else if valueKey >= 0 { "value" } else if pinKey >= 0 { "pins" } else if closedSig >= 0 { "sig" } else { "spelled" }
    if callKey >= 0 {
      const pinSets: string[] = []
      for pt in pinTys { pinSets.push(monoSetPinDiscrim(pt)) }
      k.key = instKeyCanon(
        origFe,
        callKey,
        pinTys,
        pinSets,
        callFrame,
        cbFnNames,
      )
        + (if retWiden { "=>" + retWidenKey } else { "" })
    } else if lamTop >= 0 {
      const pinSets: string[] = []
      for pt in pinTys { pinSets.push(monoSetPinDiscrim(pt)) }
      k.key = "L"
        + instKeyCanon(origFe, lamTop, pinTys, pinSets, -1, cbFnNames)
        + (if retWiden { "=>" + retWidenKey } else { "" })
    } else if valueKey >= 0 {
      const pinSets: string[] = []
      for pt in pinTys { pinSets.push(monoSetPinDiscrim(pt)) }
      k.key = "V"
        + instKeyCanon(
        origFe,
        valueKey,
        pinTys,
        pinSets,
        callFrame,
        cbFnNames,
      )
        + (if retWiden { "=>" + retWidenKey } else { "" })
    } else if pinKey >= 0 {
      // A build nothing else keys binds at the elaboration's instance whose closed signature its
      // pins are, as a value read of it would.
      const pinSets: string[] = []
      for pt in pinTys { pinSets.push(monoSetPinDiscrim(pt)) }
      k.key = "V"
        + instKeyCanon(
        origFe,
        pinKey,
        pinTys,
        pinSets,
        callFrame,
        cbFnNames,
      )
        + (if retWiden { "=>" + retWidenKey } else { "" })
    } else if closedSig >= 0 {
      const pinSets: string[] = []
      for pt in pinTys { pinSets.push(monoSetPinDiscrim(pt)) }
      k.key = "S"
        + instKeyCanon(
        origFe,
        closedSig,
        pinTys,
        pinSets,
        callFrame,
        cbFnNames,
      )
        + (if retWiden { "=>" + retWidenKey } else { "" })
    } else {
      k.key = spelledKey
    }
    monoPinKindsNoteFnVal(pinKinds)
    // Registry hit: point this call site at the existing instance.
    // A keyed decision reuses the instance the (S1) map holds for its key.
    const sSlot = elabSpecSlotOfKey(specK)
    let hitAt = k.key
    let rs = 0
    while sSlot >= 0 && rs < monoKeys.length && rs < monoInstFe.length {
      if monoInstFe[rs] == sSlot {
        hitAt = monoKeys[rs]
        break
      }
      rs = rs + 1
    }
    if (
      monoMakeInstanceHit(hitAt, origFe, pinned, pinTys, calleeIx, annotateI32)
    ) {
      if idShadowModeOf() > 0 {
        elabInstShadow(
          "hit",
          shPath,
          callKey,
          shValKey,
          tplCall,
          monoOrigNode[origFe],
          monoInstEk.get(monoLastInstFe) ?? -1,
        )
      }
      return monoCadNoteInstance(
        origFe,
        monoLastInstFe,
        cadDel,
        cadEncl,
        cbFnNames,
      )
    }
    // New shape: clone the original declaration with pinned annotations. An un-annotated
    // param pinned at plain i32 keeps `parType = -1` — the emitter's default kind, and
    // zero new arena nodes on the all-i32 path.
    const count = monoInstanceCount(origFe)
    const nps: i32[] = []
    // The pinned params as arena indices, one row per entry of `params` (-1 = no
    // resolvable type). This is the column the speculative-inference windows below take:
    // the pin is resolved once, here at the clone, and never re-resolved from its spelling.
    const pinnedTyIx: i32[] = []
    const shAt = monoShPendTag.length
    const paramsOk = monoMakeInstanceParams(
      fn,
      params,
      pinned,
      pinKinds,
      pinTys,
      pinOwn,
      k.exBN,
      k.exBT,
      annotateI32,
      k.argLit,
      nps,
      pinnedTyIx,
    )
    if paramsOk < 0 {
      monoShPendFlush(shAt)
      return -1
    }
    // A spelling missed but the resolved pin types name an instance already minted: reuse it,
    // dropping the clone's staged writes.
    const instKey = k.key
    k.key = spelledKey
    const typedKey = monoTypedInstKey(
      origFe,
      k,
      pinned,
      pinKinds,
      pinTys,
      pinOwn,
      pinnedTyIx,
    )
    k.key = instKey
    const typedRow = monoTypedKeys.get(typedKey) ?? -1
    const typedFe = if typedRow >= 0 && typedRow < monoInstFe.length { monoInstFe[typedRow] } else { -1 }
    // The instance registered under the typed key serves this request only where the two name the
    // same elaborated instance when both are known: one rep can carry two types whose bodies differ.
    const reqKey = if callKey >= 0 { callKey } else if valueKey >= 0 { valueKey } else { pinKey }
    const hitKey = if typedFe >= 0 { monoInstEk.get(typedFe) ?? -1 } else { -1 }
    if (
      typedFe >= 0
      && (reqKey < 0
        || hitKey < 0
        || elabInstSpelling(hitKey) == elabInstSpelling(reqKey))
    ) {
      monoShPendFlush(shAt)
      if (
        monoMakeInstanceHit(
          monoKeys[typedRow],
          origFe,
          pinned,
          pinTys,
          calleeIx,
          annotateI32,
        )
      ) {
        if idShadowModeOf() > 0 {
          elabInstShadow(
            "typedhit",
            shPath,
            callKey,
            shValKey,
            tplCall,
            monoOrigNode[origFe],
            hitKey,
          )
        }
        return monoCadNoteInstance(
          origFe,
          monoLastInstFe,
          cadDel,
          cadEncl,
          cbFnNames,
        )
      }
      return emitFail(
        "emitProgram: monomorphize: a typed instance key names no registered instance",
      )
    }
    const letTyCol = monoMakeInstanceLetTyCol(
      params,
      pinned,
      pinKinds,
      pinTys,
      pinnedTyIx,
    )
    const letBN: string[] = k.exBN
    const letBT: i32[] = k.exBT
    // The hole binding, made once: the return rungs, the body clone and the registry read it.
    const holeN: string[] = []
    const holeT: i32[] = []
    // The binding is the call or value key's (`elabCallKeyBinding`). The rebuild below is the
    // residue: no key, or a parameter still open or reaching a hole at the key.
    const fromKey = elabCallKeyBinding(
      if callKey >= 0 { callKey } else { shValKey },
      tplCall,
      monoOrigNode[origFe],
      params,
      letTyCol,
      k.tps,
      letBN,
      letBT,
      holeN,
      holeT,
    )
    if !fromKey {
      monoBindCols(
        tplCall,
        params,
        monoDeclParamTys(origFe, params.length),
        letTyCol,
        letBN,
        letBT,
      )
    }
    monoShAliasBind(origFe, letBN, letBT)
    monoShPendFlush(shAt)
    let shHole = if fromKey { "key" } else { "none" }
    if (
      !fromKey
      && elabSpecHoleBind(monoOrigNode[origFe], params, specK, holeN, holeT)
    ) {
      shHole = "spec"
    }
    // The worklist instance this one is: demanded here, its body checked once at this binding.
    const ekN0: string[] = []
    const ekT0: i32[] = []
    monoJoinBinding(letBN, letBT, holeN, holeT, ekN0, ekT0)
    // A type-testing body's instance is demanded at the exact binding its key names, not the
    // rep its pin spells, which merges a literal-typed record field with its base (D4088).
    const ekN1: string[] = []
    const ekT1: i32[] = []
    monoJoinBinding(k.exSubN, k.exSubT, ekN0, ekT0, ekN1, ekT1)
    const ekN: string[] = []
    const ekT: i32[] = []
    elabLamInheritedOwn(monoOrigNode[origFe], ekN1, ekT1, ekN, ekT)
    const ctk = instKeyCallTime(
      tplCall,
      calleeIx,
      monoOrigNode[origFe],
      pinnedTyIx,
    )
    const ekDemand = elabDemand(
      monoOrigNode[origFe],
      ekN,
      ekT,
      pinnedTyIx,
      tplCall,
      retWidenTy,
    )
    const ek = ekDemand
    if idShadowModeOf() > 0 {
      elabInstShadow(
        "build",
        shPath
          + "/"
          + (if fromKey { "keyed" } else { "unkeyed-"
          + elabCallKeyDecline(if callKey >= 0 { callKey } else { shValKey }, params) })
          + "/hole-"
          + shHole
          + (if elabWalkTop() >= 0 { "/inst" } else { "/root" })
          + (if monoCadIsLam(monoOrigNode[origFe]) { "/lam" } else { "/named" })
          + (if tplCall >= 0 && !valueHalf { "/call" } else { "/val" }),
        callKey,
        shValKey,
        tplCall,
        monoOrigNode[origFe],
        ek,
      )
    }
    // The parameter the body hands back whole, and the rep its call delivers it at (`-1` the type).
    const retParam = elabRetParamOf(monoOrigNode[origFe])
    const retRep = if retParam >= 0 && tplCall >= 0 { elabCallArgRep(tplCall, ek, elabWalkTop(), retParam) } else { -1 }
    // Everything this build mints is demanded under this instance.
    elabWalkPush(ek)
    cadWalkFn.push(0 - 3)
    if makeCall >= 0 && makeCall == monoOpenLamOwner {
      monoOpenLamOwner = -1
      monoOpenLamFlush(monoOpenLamMark)
    }
    const nret = monoInstanceRet(fn, ek, k.tps, retRep)
    if nret < -1 { return monoBuildPop() - 1 }
    // A widened delivery's result is the one the elaboration records for this instance.
    if retWiden && !tySame(elabRetOf(ek), retWidenTy) {
      monoBuildPop()
      return emitFail(
        "emitProgram: monomorphize: the elaboration records no widened result for a delivery built returning it",
      )
    }
    const nretW = if retWiden { synthTypeRefOfTy(retWidenTy, -1) } else { nret }
    const twoListTy = monoTwoListOf(elabRetOf(ek))
    let instName = fn.fnName
    // A frame-keyed instance never takes the template's slot, whose frame is the template's; nor
    // does a maker's twin where the template itself returns the tagged set's id.
    const slotFree = count == (monoFramedPushes.get(origFe) ?? 0)
    const first = slotFree
      && callFrame < 0
      && !(retWiden && fnTagRetIsTagged(monoOrigNode[origFe]))
    if !first {
      instName = monoMakeInstanceLaterName(fn, origFe, count, slotFree)
    }
    // Substitute type-param annotations in the body's `LetDecl`s for this instance (a
    // `const out: T[]` becomes `const out: f64[]`); shares the body wholesale when it has
    // no such annotation.
    monoMakeInstanceHoles(holeN, holeT)
    const instBody0L = monoMakeInstanceBodyPinned(
      fn,
      origFe,
      first,
      nret,
      k.tps,
      tvN,
      tvV,
      letBN,
      letBT,
      holeN,
      holeT,
    )
    const lamClones = monoLamCloneSlots
    monoLamCloneSlots = []
    const instBody = monoMakeInstanceBodyRewrite(
      instBody0L,
      origFe,
      params,
      pinTys,
      pinnedTyIx,
      cbFnNames,
      k.tps,
      tvN,
      tvV,
      k.exSubN,
      k.exSubT,
    )
    const nfn = monoMakeInstanceFunc(fn, origFe, nretW, instBody, instName, nps)
    if retWiden { monoRetWidenFns[nfn] = true }
    cadWalkFn[cadWalkFn.length - 1] = nfn
    cadPatchPending(nfn)
    const instFe = monoMakeInstanceInstall(
      fn,
      nfn,
      origFe,
      calleeIx,
      callFrame,
      instName,
      first,
    )
    if instFe < 0 { return monoBuildPop() - 1 }
    // REGISTER before walking the body, so a recursive self-call at the same
    // shape resolves here instead of recursing (the host's discipline).
    if !monoTypedKeys.has(typedKey) {
      monoTypedKeys.set(typedKey, monoKeys.length)
    }
    monoMakeInstanceRegister(k.key, origFe, instName, instFe, twoListTy)
    elabSlotNote(instFe, ek)
    monoInstEk[instFe] = ek
    instKeyNote(
      origFe,
      fn.fnName,
      ek,
      ctk,
      pinnedTyIx,
      callFrame,
      cbFnNames,
      instFe,
    )
    if repShadowOn && tplCall >= 0 {
      repABNote(
        "instKey",
        "half",
        if valueHalf { "value " + fn.fnName } else { "call" },
      )
    }
    monoInstPins[instFe] = pinnedTyIx
    monoCadNoteInstance(origFe, instFe, cadDel, cadEncl, cbFnNames)
    monoArmRowNote(calleeIx, instFe)
    monoNoteOpenArgs(calleeIx, instFe)
    if monoRegisterInstance() < 0 { return monoBuildPop() - 1 }
    const walked = monoMakeInstanceWalk(fn, origFe, nfn, calleeIx, lamClones)
    monoBuildPop()
    return walked
  }
  0
}

// The pins of function type `t`'s parameters (a nullable one's function arm), appended to `out`;
// false when `t` is no function type.
function monoFnTyPinNames(t: i32, out: string[]): boolean {
  if t < 0 || t >= T.tys.length { return false }
  const ft = if tyNulFuncInner(t) >= 0 { tyNulFuncInner(t) } else { t }
  if ft < 0 || ft >= T.tys.length { return false }
  const f = tyAt(ft)
  if f is TyFunc {
    for p in f.fnParamTypes { out.push(monoPinAnnSpelling(p)) }
    return true
  }
  false
}

// The parameter types of the concrete function type `t` (the value's recorded type, or the
// destination's), when it has `n` of them and names no type variable; empty otherwise.
function monoFnValueParamTys(t: i32, n: i32): i32[] {
  const out: i32[] = []
  if t < 0 || tyHasTyVar(t) { return out }
  const ft = tyAt(t)
  if ft is TyFunc {
    if ft.fnParamTypes.length != n { return out }
    let i = 0
    while i < n {
      out.push(ft.fnParamTypes[i])
      i = i + 1
    }
  }
  out
}

// `monoFnValueParamTys` at `t`'s own arity: empty unless `t` is a function type with no hole.
function monoFnTyParamTys(t: i32): i32[] {
  if t >= 0 && t < T.tys.length {
    const ft = tyAt(t)
    if ft is TyFunc { return monoFnValueParamTys(t, ft.fnParamTypes.length) }
  }
  const none: i32[] = []
  none
}

// The result `monoInstanceFor` must reproduce while a widened return is delivered, or -1 for any.
let monoInstanceRetTy = 0 - 1
// The instances built returning a result their template's only converts to (D9282): a generic
// value they return is built at that result too.
let monoRetWidenFns: {[i32]: boolean} = Map()

// Set while a generic is delivered past a return at the flow table's pin: an instance whose
// result only converts to the pin's result is built returning the pin's (D9282).
let monoInstanceWidenRet = false

// The spelling a widened result keys its instance by: an emit name softens a literal union to its
// base, which would key two results with different reps alike (D14941).
let monoInstRetWidenKey = ""
// The result the next instance `monoMakeInstance` builds is returned at, when that delivery's
// own result only converts to it; -1 for the substituted result.
let monoInstRetWidenTy = 0 - 1

// Whether `ty` is a record no declaration names: an inline record, spelled by its shape.
function monoTyIsInlineRecord(ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length { return false }
  tyAt(ty) is TyObj && nominalStructNameOfTy(ty) == ""
}

// The result type of function type `t` (a nullable one's function arm), or -1.
function monoFnTyRet(t: i32): i32 {
  if t < 0 || t >= T.tys.length { return -1 }
  const nt = nonNullTy(t)
  if nt < 0 || nt >= T.tys.length { return -1 }
  const f = tyAt(nt)
  if f is TyFunc { return f.fnRet }
  -1
}

// Whether boundary spelling `nm` names the closed type `ty`, compared on the arena, so a record
// spelled by its shape matches the alias a parameter declares it by.
function monoPinNamesTy(pty: i32, ty: i32): boolean {
  if ty < 0 || ty >= T.tys.length || tyHasTyVar(ty) { return false }
  pty >= 0 && pty < T.tys.length && tyEq(pty, ty)
}

// Materialize or reuse the instance of generic `origFe` for a function-typed binding at pins
// `pinnedNames`, pointing `letInitIx` at it, so an escaping binding is `call_ref`'d at that type.
// `deliveryTys` are the delivery's parameter types where the caller holds them, else [];
// `pinTyCol` the types the pins are spelled from, which are never parsed back from the names.
function monoInstanceFor(
  origFe: i32,
  pinnedNames: string[],
  letInitIx: i32,
  expTy: i32,
  deliveryTys: i32[],
  pinTyCol: i32[],
) {
  // A value a call through its set already instanced keeps that instance.
  if (monoElemAtSet[letInitIx] ?? false) && !monoTysHoldSet(deliveryTys) {
    return 0
  }
  const fn = nodeAt(monoOrigNode[origFe])
  if fn is FuncDecl {
    const params = fn.fnParams
    if params.length != pinnedNames.length { return 0 }
    // No argument node on this path: the pins are the parameter types of the function type the
    // checker recorded for the value, else the destination's, else the delivery's (D2755).
    let vty = monoFnValueParamTys(nodeTyIxOf(letInitIx), pinnedNames.length)
    // A destination or delivery handing a tagged set pins the set, which the value's own
    // recorded type does not name.
    const ety = monoFnValueParamTys(expTy, pinnedNames.length)
    if monoTysHoldSet(ety) { vty = ety }
    if deliveryTys.length == pinnedNames.length && monoTysHoldSet(deliveryTys) {
      vty = deliveryTys
    }
    if vty.length == 0 { vty = monoFnValueParamTys(expTy, pinnedNames.length) }
    if vty.length == 0 && deliveryTys.length == pinnedNames.length {
      vty = deliveryTys
    }
    const pinTys: i32[] = []
    let j = 0
    while j < pinnedNames.length {
      let pt = if j < vty.length { vty[j] } else { -1 }
      // Else the type the caller spelled the pin from.
      if (
        pt < 0
        && j < pinTyCol.length
        && pinTyCol[j] >= 0
        && !tyHasTyVar(pinTyCol[j])
      ) {
        pt = pinTyCol[j]
      }
      pinTys.push(pt)
      j = j + 1
    }
    const declTys = monoDeclParamTysOf(monoOrigNode[origFe], params.length)
    const tvN: string[] = []
    const tvV: string[] = []
    const tvT: i32[] = []
    let i = 0
    // Every parameter is read, in one of three ways: an un-annotated hole is filled from
    // the boundary; a type parameter is bound by its pin's type, which also substitutes the
    // return; a concrete annotation's type must be the boundary's or this declines.
    while i < params.length {
      const p = nodeAt(params[i])
      if p is Param {
        if p.parType >= 0 {
          if monoAnnHasTyParam(p.parType, -1, fn.fnTyParams) {
            if pinTys[i] < 0 { return 0 }
            monoBindArenaFullTys(
              monoParamPatTy(params, i, declTys),
              pinTys[i],
              fn.fnTyParams,
              tvN,
              tvV,
              tvT,
            )
          } else if !monoPinNamesTy(pinTys[i], nodeTyIxOf(p.parType)) {
            return 0
          }
        }
      }
      i = i + 1
    }
    // Post-condition on the bindings, and it needs its own pass because binding is
    // first-use-wins: substituting them back through every type-param-riding parameter must
    // reproduce its pin. `pairT<T>(a: T, b: T)` reaching `(i32, string) => i32` binds `T` from
    // `a` and then disagrees at `b`. Declining hands it to the value floor.
    const own = topFnOwnerOf(monoOrigNode[origFe])
    let v = 0
    while v < params.length {
      const pv = nodeAt(params[v])
      if pv is Param {
        if pv.parType >= 0 {
          if monoAnnHasTyParam(pv.parType, -1, fn.fnTyParams) {
            const pat = monoParamPatTy(params, v, declTys)
            const sub = substTyDeepOf(pat, tvN, tvT, own)
            if sub < 0 || tyHasTyVar(sub) || !tyEq(sub, pinTys[v]) { return 0 }
          }
        }
      }
      v = v + 1
    }
    if (monoInstanceWidenRet && fn.fnRet >= 0 && monoInstanceRetTy >= 0) {
      // A result that only converts to the slot's own result is returned at it (D9282), and
      // keyed by that result's type.
      let want = monoFnTyRet(expTy)
      if want < 0 { want = monoInstanceRetTy }
      const rsTy = substTyDeepOf(nodeTyIxOf(fn.fnRet), tvN, tvT, own)
      if (
        rsTy >= 0
        && want >= 0
        && !tyEq(rsTy, want)
        && elabWidenedRet(rsTy, want) >= 0
      ) {
        monoInstRetWidenKey = tyToStr(want)
        monoInstRetWidenTy = want
      }
    }
    // A type parameter the boundary binds nothing defaults as at an inferred call, so the
    // binding's instance is the direct call's.
    monoDefaultUnboundTyParams(fn.fnTyParams, tvN, tvV, tvT, fn.fnBody, -1)
    const pinned: string[] = []
    let pj = 0
    for pn in pinnedNames {
      // An inline record pin is the instance's parameter type, so it takes the naming rule's
      // spelling of its type, the one the record's shape is interned under (D9381).
      const ipt = if pj < pinTys.length { pinTys[pj] } else { -1 }
      if monoTyIsInlineRecord(ipt) {
        pinned.push(monoPinSpellShaped(ipt))
      } else {
        // A declared function's hole function parameter is keyed by its `=>` signature, as a
        // call's argument keys it, so a delivery and a call at one signature share the instance.
        let fk = ""
        if !monoCadIsLam(monoOrigNode[origFe]) {
          fk = monoHoleFnPinSpell(params[pj], pinTys[pj])
        }
        pinned.push(if fk != "" { fk } else { pn })
      }
      pj = pj + 1
    }
    // The annotation-driven binding path (`const c: (f64,f64)=>f64 = add`) bakes no callback — the
    // value escapes its call sites, so its body keeps the `call_ref`. Empty → no key/body change.
    const noCb: string[] = []
    const pinKinds: i32[] = []
    monoBuildPinCol(pinned, pinTys, pinKinds)
    // Each pin's own type: a concrete annotation's, else the boundary's, which a type parameter's
    // substituted annotation is checked against above.
    const pinOwn: i32[] = []
    let oj = 0
    while oj < params.length {
      const po = nodeAt(params[oj])
      let ot = pinTys[oj]
      if po is Param {
        if (
          po.parType >= 0
          && !monoAnnHasTyParam(po.parType, -1, fn.fnTyParams)
        ) {
          ot = nodeTyIxOf(po.parType)
        }
      }
      pinOwn.push(ot)
      oj = oj + 1
    }
    monoPinRespell(pinned, pinTys, params, pinOwn)
    cadDelivery = if cadDeliveryAt >= 0 { cadDeliveryAt } else { letInitIx }
    instKeyDstSet(expTy, deliveryTys)
    const made = monoMakeInstance(
      origFe,
      pinned,
      pinKinds,
      pinTys,
      pinOwn,
      tvN,
      tvV,
      tvT,
      letInitIx,
      true,
      noCb,
    )
    cadDelivery = -1
    instKeyDstSet(-1, [])
    return made
  }
  0
}

// The `=>` pin of un-annotated parameter `par` pinned at the closed function type `pt`; "" for an
// annotated parameter, or a `pt` that is open or tagged.
function monoHoleFnPinSpell(par: i32, pt: i32): string {
  const p = nodeAt(par)
  if !(p is Param) || p.parType >= 0 { return "" }
  if (
    pt < 0
    || pt >= T.tys.length
    || !monoTyClosedFn(pt)
    || fnTagTyIsTagged(pt)
  ) {
    return ""
  }
  monoFnTyPin(pt)
}

// Coerces `v`, the element or field at slot `path` of literal `lit`, at the one signature the
// flow table pins that slot at in frame `ctx`; a nested literal reads its own slots instead.
function monoCoerceLitPart(v: i32, lit: i32, path: string[], ctx: i32) {
  const tys: i32[] = []
  const st = elabStampAt(unwrapParen(v), ctx)
  if monoTyClosedFn(st) { return monoCoerceFnValueTys(v, ctx, st, tys, st) }
  const ft: i32[] = []
  const nm = monoSlotPinNameTys(lit, path, ctx, tys, ft)
  if nm == "" && !monoFlowIsLit(unwrapParen(v)) { return 0 }
  monoCoerceFnValueTys(v, ctx, -1, tys, if ft.length == 1 { ft[0] } else { -1 })
}

// Record that the identifier at `identIx` now names the instance at slot `fe` (-1: none).
function monoNoteRenamed(identIx: i32, fe: i32) {
  if identIx >= 0 && fe >= 0 { monoRenamedFe[identIx] = fe }
  0
}

// The slot `monoNoteRenamed` recorded for `identIx`, while that slot still declares `name`; -1
// otherwise. A just-minted instance is named here before the function map covers it.
function monoRenamedFeOf(identIx: i32, name: string): i32 {
  const fe = monoRenamedFe.get(identIx) ?? -1
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const d = nodeAt(fnStmts[fe])
  if d is FuncDecl {
    if d.fnName == name { return fe }
  }
  -1
}

// The `fnStmts` slot of declaration node `decl`, or -1.
function monoSlotOfDecl(decl: i32): i32 {
  if decl < 0 { return -1 }
  fnStmtsPosOf(decl)
}

// The `fnStmts` slot of the function an `Ident` names — the one resolver every question
// this pass asks about a named function goes through. `fnIndexOfInScopeSid` is the language's
// innermost-scope rule for a name a `FuncDecl` carries; `identClosureFeOfRead` covers an
// arrow lambda, which parses to a nameless `FuncDecl` and carries its name on the binding.
function monoFnFeOfIdent(identIx: i32, name: string, ctx: i32) {
  const rf = monoRenamedFeOf(identIx, name)
  if rf >= 0 { return rf }
  const armFe = elabArmFeOf(identIx, name)
  if armFe >= 0 { return armFe }
  const fe = fnIndexOfInScopeAt(sidOfNode(identIx), name, ctx, identIx)
  if fe >= 0 { return fe }
  identClosureFeOfRead(identIx, ctx)
}

// Coerce a generic function value (or a composite of them) flowing into the expected function
// type `expTy`: materialize the instance for an `Ident` naming a generic. A list or record
// literal ignores `expTy`: each element or field value takes the flow table's pin for its own
// slot. The checker has already proved the instantiation valid; this emits it.
function monoCoerceFnValueName(exprIx: i32, ctx: i32, expTy: i32) {
  const none: i32[] = []
  monoCoerceFnValueTys(exprIx, ctx, expTy, none, expTy)
}

// `monoCoerceFnValueName` where the caller holds the slot pin's parameter types `delTys` (the
// flow table's, `monoPinFnParamTys`); an instance with no recorded type takes them. `tnameTy` is
// the slot's function type, which the instance's pins are spelled from.
function monoCoerceFnValueTys(
  exprIx: i32,
  ctx: i32,
  expTy: i32,
  delTys: i32[],
  tnameTy: i32,
) {
  if exprIx < 0 { return 0 }
  const e = nodeAt(exprIx)
  match e {
    ObjLit => {
      for fx in e.objFields {
        const f = nodeAt(fx)
        if f is FieldInit {
          const path: string[] = ["f." + f.fiName]
          if monoCoerceLitPart(f.fiValue, exprIx, path, ctx) < 0 { return -1 }
        }
      }
      return 0
    }
    ArrayLit => {
      for x in e.arrElems {
        const path: string[] = ["e"]
        if monoCoerceLitPart(x, exprIx, path, ctx) < 0 { return -1 }
      }
      return 0
    }
    Paren => {
      return monoCoerceFnValueTys(e.parInner, ctx, expTy, delTys, tnameTy)
    }
    // A read through a written `let`'s capture cell is read as that `let` (D3939).
    Index => {
      const cn = monoCellReadName(exprIx)
      if cn != "" { monoCoerceWrittenCell(exprIx, ctx, delTys, tnameTy) }
      return 0
    }
    IfStmt => {
      // An if-expression in value position. The expected type reaches every arm unchanged —
      // each arm independently produces the whole value — so the recursion is per-arm, not
      // per-element as it is for the composite literals. A `match` needs no limb: the checker
      // lowers an exhaustive one to an if/else chain in place.
      if (monoCoerceFnValueTys(e.ifThen, ctx, expTy, delTys, tnameTy) < 0) {
        return -1
      }
      return monoCoerceFnValueTys(e.ifElse, ctx, expTy, delTys, tnameTy)
    }
    Block => {
      // An arm's VALUE is its LAST statement, so that is the only position the expected type reaches.
      const bs = e.blkStmts
      if bs.length == 0 { return 0 }
      const tail = bs[bs.length - 1]
      const tv = monoArmTailValue(exprIx)
      if tv == tail {
        return monoCoerceFnValueTys(tail, ctx, expTy, delTys, tnameTy)
      }
      // A tail reading the block's own `const` delivers its initialiser, and both take its type.
      if monoCoerceFnValueTys(tv, ctx, expTy, delTys, tnameTy) < 0 { return -1 }
      monoRetypeChoiceRead(tv, unwrapParen(tail))
      monoRetypeChoiceRead(tv, identDeclOf(unwrapParen(tail)))
      return 0
    }
    Ident => {
      // A bare function name, or a value binding holding a generic function (`const add =
      // (a,b) => a + b`, or `const g = named`) — resolve the binding to its lifted slot so an
      // escaping lambda binding materializes at the boundary type too.
      // A reassigned `let` is read as itself: the generic functions written into it take this type.
      if monoCoerceWrittenLetTys(exprIx, ctx, delTys, tnameTy, []) { return 0 }
      // So is one annotated with a function type: every write to it took that type (D4303).
      if monoAnnWrittenLetAt(exprIx, ctx) { return 0 }
      // An alias of a capture cell's read delivers that cell (D3948).
      if monoCoerceAliasOfCell(exprIx, ctx, delTys, tnameTy) { return 0 }
      // So does an alias of a reassigned `let` deliver that `let` (D9010).
      if monoCoerceAliasOfWrittenLet(exprIx, ctx, delTys, tnameTy) { return 0 }
      // A binding of an `if` choosing open functions delivers that `if` (D9080).
      const cb = monoCoerceChoiceBinding(exprIx, ctx, expTy, delTys, tnameTy)
      if cb != 0 { return if cb < 0 { -1 } else { 0 } }
      let gfe = monoFnFeOfIdent(exprIx, e.identName, ctx)
      // A chain of never-written aliases of a generic delivers that generic (D3894, D3902).
      if gfe < 0 { gfe = monoReadGenFnFe(exprIx) }
      // An alias a call renamed to one instance of a generic still delivers the generic (D3905).
      if (
        gfe >= 0
        && gfe < fnInstOrigin.length
        && fnInstOrigin[gfe] >= 0
        && e.identName != monoSlotName(gfe)
      ) {
        const go = fnInstOrigin[gfe]
        if go < monoGen.length && monoGen[go] == 1 { gfe = go }
      }
      // A maker delivered at a closed function type is its instance at that type's result.
      if monoIsMakerFe(gfe) {
        const dt = if expTy >= 0 { expTy } else { tnameTy }
        return monoMakerTwin(gfe, exprIx, monoFnTyRet(dt), delTys, ctx)
      }
      if gfe >= 0 && gfe < monoGen.length {
        if monoGen[gfe] == 1 {
          const pnames: string[] = []
          // A nullable function slot (`((t: T) => void) | null`) takes the function's instance (D3932).
          if (monoFnTyPinNames(tnameTy, pnames)) {
            // A capturing nested generic's value is this frame's instance, as a call is (D3902).
            monoCallFrameSlot = monoNestedCallFrame(gfe, ctx)
            monoInstanceRetTy = if monoInstanceWidenRet { monoFnTyRet(tnameTy) } else { -1 }
            const vr = monoInstanceFor(
              gfe,
              pnames,
              exprIx,
              expTy,
              delTys,
              monoFnTyParamTys(
                if tyNulFuncInner(tnameTy) >= 0 { tyNulFuncInner(tnameTy) } else { tnameTy },
              ),
            )
            monoCallFrameSlot = -1
            return vr
          }
        }
      }
    }
    // every other kind names no generic function value, so nothing is instanced
    NumLit | StrLit | CharLit | BoolLit | NullLit | Unary | BinExpr | Call | Member | OptMember | ErrExpr | LetDecl | Param | TypeRef | FuncDecl | WhileStmt | BreakStmt | ContinueStmt | RetStmt | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | IsExpr | AsExpr | ForRange | ForIn | MatchExpr | ImportDecl | Spread | LoopVar => {}
  }
  0
}

// Whether slot `fe`'s template is a maker (`fvaIsMaker`): one delivered at a closed function type
// is built at that type's result, as the elaboration's wide twin of it is.
function monoIsMakerFe(fe: i32): boolean {
  fe >= 0 && fe < monoOrigNode.length && fvaIsMaker(monoOrigNode[fe])
}

// Builds maker `fe`'s instance at closed function result `ret`, the elaboration's wide twin of it,
// and points the read `at` at it. 0, or -1 on a failure.
function monoMakerTwin(
  fe: i32,
  at: i32,
  ret: i32,
  delTys: i32[],
  ctx: i32,
): i32 {
  if (
    ret < 0
    || ret >= T.tys.length
    || tyHasTyVar(ret)
    || !(tyAt(ret) is TyFunc)
  ) {
    return 0
  }
  // Only a twin the elaboration banked: mono mirrors its key, never mints one of its own.
  if (
    !elabMakerRowHas(monoOrigNode[fe], ret)
    || !elabMakerOpen(monoOrigNode[fe])
    || !elabMakerTwinHeld(monoOrigNode[fe], ret)
  ) {
    return 0
  }
  monoInstRetWidenKey = tyToStr(ret)
  monoInstRetWidenTy = ret
  // A maker capturing its encloser's locals is this frame's instance, as a call is.
  monoCallFrameSlot = monoNestedCallFrame(fe, ctx)
  const none: string[] = []
  const r = monoInstanceFor(fe, none, at, mkFuncTy([], ret), delTys, [])
  monoCallFrameSlot = -1
  monoInstRetWidenTy = 0 - 1
  r
}

// Whether each written, un-annotated `let` holds only named functions `monoIsGenericDecl`
// instances, by the elaboration's set of the values written to it (`elabBindingFnSet`; empty is
// no). Read once before the walk, which retypes the values that set is read from.
let monoWrittenLetGen: {[i32]: boolean} = Map()

function monoWrittenLetGenSnap() {
  monoWrittenLetGen = Map()
  monoLetWritesExtend()
  for d in monoDeclWrites.keys() {
    const n = nodeAt(d)
    if n is LetDecl {
      if n.letType < 0 && n.letKw == "let" {
        const ms = elabBindingFnSet(d)
        let gen = ms.length > 0
        for m in ms {
          const mn = nodeAt(m)
          if !(mn is FuncDecl) || !monoIsGenericDecl(m) {
            gen = false
          } else if mn.fnName == "" || mn.fnName.slice(0, 8) == "__lambda" {
            gen = false
          }
        }
        monoWrittenLetGen[d] = gen
      }
    }
  }
}

// For the read at `at` in frame `ctx`: `[frame, declaration]` of the written, un-annotated `let`
// it names when every value of it names a function that needs instancing, which each take their
// own instance; `[-1, -1]` otherwise. A lambda written in is one body, shared across the
// enclosing instances, so it keeps its own path.
function monoWrittenGenLetFrame(at: i32, ctx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1]
  if !(nodeAt(at) is Ident) { return none }
  if monoWritesOf("n:", identDeclOf(at)).length == 0 { return none }
  const lf = monoReadLetFrame(at, ctx)
  if lf[1] < 0 { return none }
  const d = nodeAt(lf[1])
  if !(d is LetDecl) || d.letType >= 0 || d.letKw != "let" { return none }
  if !monoLetWrittenIn(lf) { return none }
  if d.letInit < 0 { return none }
  const src = nodeSrc[lf[1]] ?? -1
  const srcKey = if src >= 0 { monoDeclCanon(src) } else { -1 }
  if (
    !(monoWrittenLetGen[monoDeclCanon(lf[1])]
      ?? (monoWrittenLetGen[srcKey] ?? false))
  ) {
    return none
  }
  if monoGeneratedCellElem(d.letInit) >= 0 { return none }
  lf
}

// Whether value `v`, read in frame `ctx`, names a declared generic function, directly, through
// the checker's adapter lambda, or in every arm of an `if` expression that hands on a value: an
// arm ending in a call that never returns hands on none (D4013, D6990).
function monoValueNamesGenerics(v: i32, ctx: i32, depth: i32): boolean {
  if v < 0 || depth > MONO_ALIAS_CHAIN_MAX { return false }
  if monoNamesDeclaredGeneric(v, ctx) { return true }
  if monoNamesDeclaredGeneric(monoAdapterCallee(v), ctx) { return true }
  const x = unwrapParen(v)
  if x < 0 { return false }
  const n = nodeAt(x)
  if !(n is IfStmt) { return false }
  const tn = monoArmEndsNever(n.ifThen)
  const en = monoArmEndsNever(n.ifElse)
  if tn && en { return false }
  (tn || monoArmNamesGenerics(n.ifThen, ctx, depth + 1))
    && (en || monoArmNamesGenerics(n.ifElse, ctx, depth + 1))
}

// Whether `if` arm block `arm` ends in a call that never returns.
function monoArmEndsNever(arm: i32): boolean {
  if arm < 0 || arm >= P.nodes.length { return false }
  const b = nodeAt(arm)
  if !(b is Block) || b.blkStmts.length == 0 { return false }
  callIsNever(b.blkStmts[b.blkStmts.length - 1])
}

// Whether `if` arm `arm` (a block, or an `else if`) names declared generics in its value.
function monoArmNamesGenerics(arm: i32, ctx: i32, depth: i32): boolean {
  if arm < 0 { return false }
  const tv = monoArmTailValue(arm)
  if monoArmWrittenLetSeed(tv, ctx) >= 0 { return true }
  monoValueNamesGenerics(if tv >= 0 { tv } else { arm }, ctx, depth)
}

// The initialiser of the written `let` arm tail `tv` reads in frame `ctx`, when every value
// written to it names a declared generic (`monoWrittenGenLetFrame`): the arm delivers that
// binding, whose seed fixes its signature (D13103). -1 otherwise.
function monoArmWrittenLetSeed(tv: i32, ctx: i32): i32 {
  if tv < 0 || tv >= P.nodes.length { return -1 }
  const x = unwrapParen(tv)
  if x < 0 || x >= P.nodes.length || !(nodeAt(x) is Ident) { return -1 }
  const lf = monoWrittenGenLetFrame(x, ctx)
  if lf[1] < 0 { return -1 }
  const d = nodeAt(lf[1])
  if d is LetDecl { return d.letInit }
  -1
}

// The callee of `v` when it is the checker's adapter lambda `($fp0, …) => g($fp0, …)`, which a
// generic `g` written into a `let` becomes once the checker pins it; -1 otherwise.
function monoAdapterCallee(v: i32): i32 {
  const f = nodeAt(unwrapParen(v))
  if !(f is FuncDecl) || f.fnParams.length == 0 || f.fnBody < 0 { return -1 }
  const b = nodeAt(f.fnBody)
  if !(b is Block) || b.blkStmts.length != 1 { return -1 }
  const c = nodeAt(b.blkStmts[0])
  if !(c is Call) || c.callArgs.length != f.fnParams.length { return -1 }
  let i = 0
  while i < f.fnParams.length {
    const p = nodeAt(f.fnParams[i])
    if !(p is Param) || p.parName.slice(0, 3) != "$fp" { return -1 }
    if monoIdentNameOf(unwrapParen(c.callArgs[i])) != p.parName { return -1 }
    i = i + 1
  }
  c.callFn
}

// For call `ix` in frame `ctx` through an un-annotated binding of an `if` naming generic
// functions in every arm (`monoIfBindingOf`): instances each arm at the one signature the flow
// table pins the binding at, else at the one this call takes the first arm at (D6991).
function monoCallIfBound(ix: i32, ctx: i32): i32 {
  const n = nodeAt(ix)
  if !(n is Call) || n.callFn < 0 || !(nodeAt(n.callFn) is Ident) { return 0 }
  const lf = monoIfBindingOf(n.callFn, ctx)
  if lf[1] < 0 { return 0 }
  const d = nodeAt(lf[1])
  if !(d is LetDecl) { return 0 }
  if fnTagTyIsTagged(nodeTyIxOf(d.letInit)) { return 0 }
  const iv = unwrapParen(d.letInit)
  const g0 = monoFirstArmGenName(iv, lf[0], 0)
  // A binding a first use coerced names instances now, so its generic is the one noted then.
  const k0 = monoChoiceBindIx(lf)
  const gfe = if g0 >= 0 { monoFnFeOfIdent(g0, monoIdentNameOf(g0), lf[0]) } else if k0 >= 0 { monoChoiceBindGen[k0] } else { -1 }
  if gfe < 0 { return 0 }
  const dTys: i32[] = []
  const dFt: i32[] = []
  const ct = monoSlotPinNameTys(lf[1], [], lf[0], dTys, dFt)
  if ct == "" { return 0 }
  // The binding holds one value, so a call at another type is refused and split (D9120).
  const et = if dFt.length == 1 { dFt[0] } else { -1 }
  const seen = monoChoiceBindNote(
    lf,
    if monoTyConcreteFn(et) { tyToStr(et) } else { ct },
    gfe,
  )
  if seen < 0 { return -1 }
  if seen > 0 {
    monoRetypeChoiceRead(d.letInit, n.callFn)
    return 0
  }
  if monoCoerceFnValueTys(iv, lf[0], -1, dTys, dFt[0]) < 0 { return -1 }
  monoRetypeIfInit(d.letInit, g0, n.callFn, lf[0])
}

// For value `at` in frame `ctx` delivered past a return that is an `if` naming generic functions
// in every arm, or a read of an `if`-bound binding (`monoIfBindingOf`): instances each arm at the
// one signature the flow table pins the binding, or the first arm's read, at, and types each call
// taking that pin at it (D7001, D7011). No pin leaves the value to the emitter's refusal.
function monoIfBoundRetAtPin(at: i32, ctx: i32): i32 {
  if at < 0 { return 0 }
  const lf = monoIfBindingOf(at, ctx)
  let init = at
  if lf[1] >= 0 {
    const d = nodeAt(lf[1])
    if !(d is LetDecl) { return 0 }
    init = d.letInit
  } else if !(nodeAt(at) is IfStmt) || !monoValueNamesGenerics(at, ctx, 0) {
    return 0
  }
  // A tagged function set is an id dispatched on, never one instance (`fnTagDecide`).
  if fnTagTyIsTagged(nodeTyIxOf(init)) { return 0 }
  const iv = unwrapParen(init)
  const fr = if lf[1] >= 0 { lf[0] } else { ctx }
  const g0 = monoFirstArmGenName(iv, fr, 0)
  if g0 < 0 { return 0 }
  let key = if lf[1] >= 0 { lf[1] } else { g0 }
  const noPath: string[] = []
  // An inline `if` in an instance body is banked under the template's read, at the same position.
  const it = monoFrameInstTmpl(ctx)
  const gn = nodeAt(g0)
  if (
    lf[1] < 0
    && it[1] >= 0
    && gn is Ident
    && monoDeclPathPins([fr, key], noPath).length == 0
  ) {
    const tr = monoIdentAtPosIn(it[1], gn.identName, gn.pos, 0)
    if tr >= 0 { key = tr }
  }
  const cTys: i32[] = []
  const cFt: i32[] = []
  const ct = monoSlotPinNameTys(key, noPath, fr, cTys, cFt)
  if ct == "" { return 0 }
  if monoCoerceFnValueTys(iv, fr, -1, cTys, cFt[0]) < 0 { return -1 }
  monoRetypeIfInit(init, g0, at, fr)
  monoRetypePinCalls(key, noPath)
}

// The frame and declaration `[fr, d]` of the binding read `rd` in frame `ctx` names, through a
// chain of copies, when each is un-annotated and never written and the last one's initializer is
// an `if` naming generic functions in every arm; `[-1, -1]` otherwise.
function monoIfBindingOf(rd: i32, ctx: i32): i32[] {
  monoIfBindingWalk(rd, ctx, false)
}

// `monoIfBindingOf`, also answering for an `if` whose arms name un-annotated functions
// (`monoArgIsOpenFnChoice`) when `open` is set.
function monoIfBindingWalk(rd: i32, ctx: i32, open: boolean): i32[] {
  const none: i32[] = [0 - 1, 0 - 1]
  if rd < 0 || !(nodeAt(rd) is Ident) { return none }
  let r = rd
  let lf = monoReadLetFrame(r, ctx)
  let hops = 0
  while lf[1] >= 0 && hops < MONO_ALIAS_CHAIN_MAX {
    const ld = nodeAt(lf[1])
    if !(ld is LetDecl) || ld.letType >= 0 || ld.letInit < 0 { return none }
    if cboxDeclWritten(r) { return none }
    if !(nodeAt(ld.letInit) is Ident) { break }
    r = ld.letInit
    lf = monoReadLetFrame(r, lf[0])
    hops = hops + 1
  }
  if lf[1] < 0 { return none }
  const d = nodeAt(lf[1])
  if !(d is LetDecl) || d.letType >= 0 || d.letInit < 0 { return none }
  const iv = unwrapParen(d.letInit)
  if iv < 0 || !(nodeAt(iv) is IfStmt) { return none }
  if monoValueNamesGenerics(iv, lf[0], 0) { return lf }
  // Its arms name instances once a first use coerced it, and it is still the same choice.
  if monoChoiceBindIx(lf) >= 0 { return lf }
  if open && monoArgIsOpenFnChoice(iv, 0) { return lf }
  none
}

// Each choice binding coerced, keyed by declaration and frame, with the function type it is coerced
// at and the generic its first arm named (-1 when none), for the compile.
let monoChoiceBindDecl: i32[] = []
let monoChoiceBindFr: i32[] = []
let monoChoiceBindTy: string[] = []
let monoChoiceBindGen: i32[] = []

// The row of choice binding `lf` (`[frame, declaration]`) in the coerced-binding registry, or -1.
function monoChoiceBindIx(lf: i32[]): i32 {
  let k = 0
  while k < monoChoiceBindDecl.length {
    if monoChoiceBindDecl[k] == lf[1] && monoChoiceBindFr[k] == lf[0] {
      return k
    }
    k = k + 1
  }
  -1
}

// Notes that the choice binding `lf` (`[frame, declaration]`), its first arm naming generic `gen`,
// is coerced at function type `key`: 0 the first time, 1 when it already is at `key`, and -1 at
// another type, refused (D9120, D9121).
function monoChoiceBindNote(lf: i32[], key: string, gen: i32): i32 {
  const k = monoChoiceBindIx(lf)
  if k >= 0 {
    if monoChoiceBindTy[k] == key { return 1 }
    emitFail(
      "emitProgram: a binding of an `if` choosing generic functions is delivered at two function types — annotate the binding",
    )
    return -1
  }
  monoChoiceBindDecl.push(lf[1])
  monoChoiceBindFr.push(lf[0])
  monoChoiceBindTy.push(key)
  monoChoiceBindGen.push(gen)
  0
}

// For read `at` (frame `ctx`) of a never-written binding of an `if` choosing open functions,
// delivered at function type `tnameTy` (`expTy`, or -1): instances each arm there as the inline
// `if` is, and types binding and read at it. A second delivery at another type is refused and
// split (`monoChoiceBindNote`). Answers 1 once coerced, 0 for no such read, -1 on a failure.
function monoCoerceChoiceBinding(
  at: i32,
  ctx: i32,
  expTy: i32,
  delTys: i32[],
  tnameTy: i32,
): i32 {
  const lf = monoIfBindingWalk(at, ctx, true)
  if lf[1] < 0 { return 0 }
  const d = nodeAt(lf[1])
  if !(d is LetDecl) { return 0 }
  // A choice of a tagged set is its member's id, delivered as it is (D15063).
  if fnTagTyIsTagged(nodeTyIxOf(d.letInit)) { return 0 }
  const xt = expTy
  const et = if monoTyConcreteFn(expTy) { expTy } else { tnameTy }
  const pTys = delTys
  const iv = unwrapParen(d.letInit)
  const g0 = monoFirstArmGenName(iv, lf[0], 0)
  const seen = monoChoiceBindNote(
    lf,
    if et >= 0 { tyToStr(et) } else { "" },
    if g0 >= 0 { monoFnFeOfIdent(g0, monoIdentNameOf(g0), lf[0]) } else { -1 },
  )
  if seen < 0 { return -1 }
  if seen > 0 {
    monoRetypeChoiceRead(d.letInit, at)
    return 1
  }
  if monoCoerceFnValueTys(d.letInit, lf[0], xt, pTys, tnameTy) < 0 { return -1 }
  if monoTyConcreteFn(et) {
    nodeTyRecord(iv, et)
    nodeTyRecord(d.letInit, et)
  } else {
    monoRetypeIfInit(d.letInit, monoFirstArmGenName(iv, lf[0], 0), at, lf[0])
  }
  monoRetypeChoiceRead(d.letInit, at)
  1
}

// Records on read `at` the concrete type a choice's initializer `init` holds after coercion, where
// the checker left the read open.
function monoRetypeChoiceRead(init: i32, at: i32): i32 {
  const it = nodeTyIxOf(unwrapParen(init))
  if !monoTyConcreteFn(it) { return 0 }
  const rt = nodeTyIxOf(at)
  if rt < 0 || tyHasTyVar(rt) { nodeTyRecord(at, it) }
  0
}

// Refuses call `n` (node `ix`, in frame `ctx`) through an `if` naming generic functions in every
// arm, which no instance signature is derived for here; 0 for any other call, -1 once refused.
function monoCallIfValue(n: Call, ix: i32, ctx: i32): i32 {
  const iv = unwrapParen(n.callFn)
  if iv < 0 || !(nodeAt(iv) is IfStmt) { return 0 }
  if !monoValueNamesGenerics(iv, ctx, 0) { return 0 }
  const g0 = monoFirstArmGenName(iv, ctx, 0)
  if g0 < 0 { return 0 }
  emitFailAt(
    "emitProgram: a call through an `if` naming generic functions in every arm has no signature to instance them at",
    ix,
  )
  -1
}

// Records on the `if` initializer `init` of a binding, and on its read `at`, the concrete type
// of the instance its first arm's name `g0` (`monoFirstArmGenName`) now names in frame `ctx`,
// where the checker left either open.
function monoRetypeIfInit(init: i32, g0: i32, at: i32, ctx: i32): i32 {
  if g0 < 0 { return 0 }
  const inst = monoFnFeOfIdent(g0, monoIdentNameOf(g0), ctx)
  if inst < 0 || inst >= fnStmts.length { return 0 }
  const it = monoNodeTyAt(g0, fnStmts[inst])
  if !monoTyConcreteFn(it) { return 0 }
  const iv = unwrapParen(init)
  if iv >= 0 { nodeTyRecord(iv, it) }
  nodeTyRecord(init, it)
  const rt = nodeTyIxOf(at)
  if rt < 0 || tyHasTyVar(rt) { nodeTyRecord(at, it) }
  0
}

// The name node of the declared generic the first arm of value `v` names, through nested `if`
// arms and the checker's adapter lambda; -1 when it names none.
function monoFirstArmGenName(v: i32, ctx: i32, depth: i32): i32 {
  const x = unwrapParen(v)
  if x < 0 || depth > MONO_ALIAS_CHAIN_MAX { return -1 }
  const n = nodeAt(x)
  if n is IfStmt {
    const tv = monoArmTailValue(n.ifThen)
    const ws = monoArmWrittenLetSeed(tv, ctx)
    if ws >= 0 { return monoFirstArmGenName(ws, ctx, depth + 1) }
    return monoFirstArmGenName(
      if tv >= 0 { tv } else { n.ifThen },
      ctx,
      depth + 1,
    )
  }
  let g = x
  if !monoNamesDeclaredGeneric(g, ctx) {
    const ac = monoAdapterCallee(x)
    g = if ac >= 0 { unwrapParen(ac) } else { -1 }
  }
  if g < 0 || !monoNamesDeclaredGeneric(g, ctx) { return -1 }
  g
}

// For call `ix` in frame `ctx` through a written, un-annotated `let`: coerces the generic
// functions its initializer and writes name at the instance this call takes; -1 when another call
// takes another type (refused).
function monoCallWrittenLet(ix: i32, ctx: i32): i32 {
  const n = nodeAt(ix)
  if !(n is Call) { return 0 }
  const lf = monoWrittenGenLetFrame(n.callFn, ctx)
  if lf[1] < 0 { return 0 }
  const d = nodeAt(lf[1])
  if !(d is LetDecl) { return 0 }
  const g0 = monoFirstArmGenName(d.letInit, lf[0], 0)
  const dTys: i32[] = []
  // The binding's writes are instanced at the one signature the elaboration delivers it at, its
  // result unpinned.
  const fts: i32[] = []
  const pins = monoDeclPathKeys(lf, [], false, fts)
  if pins.length != 1 { return 0 }
  for t in monoPinFnParamTys(lf[1], [], pins[0]) { dTys.push(t) }
  monoCellSigByCall = true
  monoCoerceWrittenLetTys(n.callFn, ctx, dTys, fts[0], [])
  monoCellSigByCall = false
  // An `if` seed leaves the binding's type open, as a name seed does not.
  if nodeAt(unwrapParen(d.letInit)) is IfStmt {
    monoRetypeIfInit(d.letInit, g0, n.callFn, lf[0])
  }
  0
}

// The `let` bindings being coerced, so a cycle of copies ends.
const monoWrittenLetBusy: i32[] = []

// For the capture cell read at `at` (`d[0]`) that a captured, written `let` becomes: its seed
// and each live `d[0] = v` take function type `tnameTy`, the cell is retyped to the instance, and
// answers true (D3939). An annotated cell is taken only when its annotation names a type
// parameter, whose writes every instance shares deliver at that instance's type (D3957).
function monoCoerceWrittenCell(
  at: i32,
  ctx: i32,
  tys: i32[],
  tnameTy: i32,
): boolean {
  if tnameTy < 0 || tnameTy >= T.tys.length || !(tyAt(tnameTy) is TyFunc) {
    return false
  }
  const lf = monoCoercibleLet(at, ctx)
  if lf[1] < 0 { return false }
  const d = nodeAt(lf[1])
  if !(d is LetDecl) { return false }
  if d.letType >= 0 && !monoCellTyIsOpen(lf[1]) { return false }
  // A cell of a tagged set holds an id, which a call dispatches per member at its own types.
  if fnTagTyIsTagged(fnLetReadTyOf(lf[1])) { return false }
  monoCellSigByCall = false
  const seed = monoGeneratedCellElem(d.letInit)
  if seed < 0 { return false }
  const name = d.letName
  monoWrittenLetBusy.push(lf[1])
  monoLastInstFe = -1
  const took = monoCellValueTakeAt(seed, lf[0], 0, tys, tnameTy)
  if took == 1 { emitFail(MONO_BIND_SIG_PRE + name + MONO_BIND_SIG_POST) }
  if took == 2 { monoCellValueFail(name) }
  // The cell takes the one closed type the elaboration delivers the binding at.
  if monoLastInstFe >= 0 && monoLastInstFe < fnStmts.length {
    const it = monoSlotDeliveryTy(lf, [], false)
    if it >= 0 {
      monoRetypeCell(lf[1], seed, it, monoCellReadsIn(lf[0], lf[1]))
    }
  }
  for i in monoWritesOf("c:", lf[1]) {
    const nd = nodeAt(i)
    const wf = monoLetWriteFrame(lf, i)
    if nd is BinExpr && wf.length == 1 {
      const wt = monoCellValueTakeAt(nd.binRight, wf[0], 0, tys, tnameTy)
      if wt == 1 {
        if wf[0] == lf[0] || !monoFrameIsGenericInstance(lf[0]) {
          emitFail(MONO_BIND_SIG_PRE + name + MONO_BIND_SIG_POST)
        } else {
          monoCellWriterSigFail(name)
        }
      } else if wt == 2 {
        monoCellValueFail(name)
      }
    }
  }
  monoWrittenLetBusy.pop()
  true
}

// The declared generic function the capture cell read at `at` (`d[0]`) is seeded with by name, as
// a slot; -1 for any other seed.
function monoCellSeedGenFe(at: i32, ctx: i32): i32 {
  const lf = monoReadLetFrame(at, ctx)
  if lf[1] < 0 { return -1 }
  const d = nodeAt(lf[1])
  if !(d is LetDecl) || d.letType >= 0 || d.letKw != "let" { return -1 }
  const cel = monoGeneratedCellElem(d.letInit)
  if cel < 0 { return -1 }
  const seed = unwrapParen(cel)
  if seed < 0 { return -1 }
  const sn = nodeAt(seed)
  if !(sn is Ident) { return -1 }
  let fe = monoFnFeOfIdent(seed, sn.identName, lf[0])
  // A seed an earlier call renamed to one instance is still the generic's.
  if fe >= 0 && fe < fnInstOrigin.length && fnInstOrigin[fe] >= 0 {
    fe = fnInstOrigin[fe]
  }
  if (
    fe < 0
    || fe >= monoGen.length
    || monoGen[fe] != 1
    || criFnIsAnonLambda(fe)
  ) {
    return -1
  }
  fe
}

// A function type spelling whose parameters are the pins of signature `sig` (`p1,p2,;`), returning
// `void` where no return is known. "" for an empty signature.
function monoSigFnTyName(sig: string): string {
  monoSigFnTyNameRet(sig, "void")
}

// `monoSigFnTyName` returning `ret`.
function monoSigFnTyNameRet(sig: string, ret: string): string {
  if sig == "" { return "" }
  let out = "("
  let first = true
  for pn in monoSigPins(sig) {
    if !first { out = out + "," }
    out = out + pn
    first = false
  }
  out + ")=>" + ret
}

// Whether type `t` pins as a function value's wasm signature (`=>k`): a function type whose
// signature key has a token for every part.
function monoPinTyIsFnSig(t: i32): boolean {
  t >= 0 && t < T.tys.length && tyAt(t) is TyFunc && sigKeyOfTy(t) != ""
}

// For a name read at `at` in frame `ctx` that a chain of un-annotated aliases never written
// after their initializer ends at a capture cell's read (`const r = k[0]`): coerces that cell at
// `tnameTy` as `monoCoerceWrittenCell` does, and answers true when it finds one.
function monoCoerceAliasOfCell(
  at: i32,
  ctx: i32,
  tys: i32[],
  tnameTy: i32,
): boolean {
  const ar = monoAliasCellRead(at, ctx)
  if ar[0] < 0 { return false }
  monoCoerceWrittenCell(ar[0], ar[1], tys, tnameTy)
}

// For a name read at `at` in frame `ctx` that a chain of un-annotated aliases never written
// after their initializer ends at a reassigned `let`: coerces that `let`'s values at `tnameTy` as
// `monoCoerceWrittenLetTys` does, and answers true when it finds one.
function monoCoerceAliasOfWrittenLet(
  at: i32,
  ctx: i32,
  tys: i32[],
  tnameTy: i32,
): boolean {
  // Asked of every value read, so a name that is no alias leaves first.
  if !(nodeAt(at) is Ident) { return false }
  const d0 = identDeclOf(at)
  if d0 < 0 || d0 >= P.nodes.length { return false }
  const n0 = nodeAt(d0)
  if !(n0 is LetDecl) || n0.letInit < 0 { return false }
  const i0 = unwrapParen(n0.letInit)
  if i0 < 0 || !(nodeAt(i0) is Ident) { return false }
  let ax = at
  let fr = ctx
  let hops = 0
  while hops < MONO_ALIAS_CHAIN_MAX {
    const lf = monoReadLetFrame(ax, fr)
    if lf[1] < 0 { return false }
    const d = nodeAt(lf[1])
    if !(d is LetDecl) || d.letType >= 0 || d.letInit < 0 { return false }
    const iv = unwrapParen(d.letInit)
    if iv < 0 || !(nodeAt(iv) is Ident) { return false }
    if d.letKw != "const" && monoLetWrittenIn(lf) { return false }
    if monoCoerceWrittenLetTys(iv, lf[0], tys, tnameTy, []) { return true }
    ax = iv
    fr = lf[0]
    hops = hops + 1
  }
  false
}

// Whether node `v`, read in frame `ctx`, is a name `monoAliasCellRead` resolves to a cell.
function monoNamesCellAlias(v: i32, ctx: i32): boolean {
  const x = unwrapParen(v)
  if x < 0 { return false }
  const cn = monoCellReadName(x)
  if cn != "" { return monoReadsGeneratedCell(x, ctx) }
  nodeAt(x) is Ident && monoAliasCellRead(x, ctx)[0] >= 0
}

// The list literal a `const` initializes, walked while its reads are all element calls.
let monoCellAliasListOk = 0 - 1

// Whether node `v` is a program's list literal holding an alias of a capture cell's read.
function monoListInitHoldsCellAlias(v: i32, ctx: i32): boolean {
  if v < 0 { return false }
  const lit = nodeAt(v)
  if !(lit is ArrayLit) || lit.pos < 0 || !monoListMayHoldFn(v) { return false }
  for e in lit.arrElems {
    if monoNamesCellAlias(e, ctx) { return true }
  }
  false
}

// Whether the list literal at `v` may hold a function at this instance: its type is open or
// names one. A list of a closed non-function type holds no binding a call could follow.
function monoListMayHoldFn(v: i32): boolean {
  const t = nodeTyIxOf(v)
  t < 0 || tyHasTyVar(t) || tyMayHoldFn(t, 0)
}

// The element a literal index spelled `text` names in a list of `len` elements, by value in any
// base the lexer keeps (`0`, `00`, `0x0`); -1 for a fraction, an exponent, or out of range.
function monoListLitIndex(text: string, len: i32): i32 {
  if text.length == 0 || text.length > 12 { return -1 }
  const hex = text.length > 1 && (text[1] == "x"[0] || text[1] == "X"[0])
  for ch in text {
    if ch == "."[0] || ch == "-"[0] { return -1 }
    if !hex && (ch == "e"[0] || ch == "E"[0]) { return -1 }
  }
  const v = parseI32(text)
  if v < 0 || v >= len { return -1 }
  v
}

// The element count of the list literal at node `v`; -1 for any other node.
function monoListLitLength(v: i32): i32 {
  if v < 0 { return -1 }
  const lit = nodeAt(v)
  if lit is ArrayLit { return lit.arrElems.length }
  -1
}

// Whether the read `ix` under frame `fx` (-1 for the module) is of the binding declared at
// `decl`.
function monoReadIsBinding(ix: i32, fx: i32, decl: i32): boolean {
  let fr = monoTopFrameOf(ix)
  if fx >= 0 { fr = monoFrameOfNode(ix, fx) }
  // A read in a lambda a module-scope `const` holds is in the lambda's frame (D9102).
  if fx < 0 && fr < 0 {
    const df = elabDeclFnOf(decl)
    const b = monoNestedBodyOf(df)
    if df >= 0 && b >= 0 && monoSubtreeHolds(b, ix) {
      fr = monoFrameOfNode(ix, df)
    }
  }
  monoReadLetFrame(ix, fr)[1] == decl
}

// Whether every read in frame `fx`'s body of the list `name` declared at `decl`, of `len`
// elements, is the callee of a call of one element at a literal index that names one, or the
// target of an element write.
function monoListOnlyCalled(
  fx: i32,
  name: string,
  decl: i32,
  len: i32,
): boolean {
  const stack: i32[] = []
  const called: i32[] = []
  if fx >= 0 {
    const b = monoNestedBodyOf(fx)
    if b < 0 { return false }
    stack.push(b)
  } else {
    for st in monoProgStmts { stack.push(st) }
  }
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if n is Call && n.callFn >= 0 {
        const c = nodeAt(n.callFn)
        if c is Index {
          const a = nodeAt(c.idxArr)
          const k = nodeAt(c.idxIndex)
          if a is Ident && k is NumLit {
            if a.identName == name && monoListLitIndex(k.numText, len) >= 0 {
              called.push(c.idxArr)
            }
          }
        }
      }
      // An element write is typed at the list's element type, which the pin gives it.
      if n is BinExpr {
        if n.binOp == "=" {
          const wl = nodeAt(n.binLeft)
          if wl is Index {
            const wa = nodeAt(wl.idxArr)
            if wa is Ident {
              if wa.identName == name { called.push(wl.idxArr) }
            }
          }
        }
      }
      if n is Ident {
        if (
          n.identName == name
          && !i32ListHas(called, ix)
          && monoReadIsBinding(ix, fx, decl)
        ) {
          return false
        }
      }
      const body = monoNestedBodyOf(ix)
      if body >= 0 { stack.push(body) }
      for ch in nodeChildren(ix) { stack.push(ch) }
    }
  }
  true
}

// For a callee `fs[k]` whose list `fs` a `const` initializes with a literal whose element `k`
// is an alias of a capture cell's read: that read as `[read, frame]`; `[-1, -1]` otherwise.
function monoListElemCellRead(callee: i32, ctx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1]
  const el = monoListElemOf(callee, ctx)
  if el[0] < 0 { return none }
  const e = el[0]
  // The cell itself placed in the list (`[k]`) is its own read (D3977).
  const cn = monoCellReadName(e)
  if cn != "" {
    if !monoReadsGeneratedCell(e, el[1]) { return none }
    const out: i32[] = [e, el[1]]
    return out
  }
  if !(nodeAt(e) is Ident) { return none }
  monoAliasCellRead(e, el[1])
}

// For a callee `fs[k]` whose list `fs` a `const` initializes with a literal: element `k` and the
// list's frame, as `[element, frame]`; `[-1, -1]` for any other callee.
function monoListElemOf(callee: i32, ctx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1]
  const c = nodeAt(callee)
  if !(c is Index) { return none }
  const a = nodeAt(c.idxArr)
  const k = nodeAt(c.idxIndex)
  if !(a is Ident) || !(k is NumLit) { return none }
  const lf = monoReadLetFrame(c.idxArr, ctx)
  if lf[1] < 0 { return none }
  const d = nodeAt(lf[1])
  if !(d is LetDecl) || d.letKw != "const" || d.letInit < 0 { return none }
  const lit = nodeAt(d.letInit)
  if !(lit is ArrayLit) || lit.pos < 0 { return none }
  const at = monoListLitIndex(k.numText, lit.arrElems.length)
  if at < 0 { return none }
  const out: i32[] = [unwrapParen(lit.arrElems[at]), lf[0]]
  out
}

// The hole lambda list element `e` names in frame `ctx` through never-written un-annotated
// bindings, as a slot; -1 for a literal, an annotated binding on the way, or anything else.
function monoListElemHoleLamFe(e: i32, ctx: i32): i32 {
  const x = unwrapParen(e)
  if x < 0 || monoIdentNameOf(x) == "" { return -1 }
  const fe = monoLamValueFe(x, ctx)
  if fe < 0 || fe >= monoGen.length || monoGen[fe] != 1 || !monoLamIsHole(fe) {
    return -1
  }
  if !monoWriteNamesLam(x, fe, ctx) { return -1 }
  fe
}

// ── reads of a literal slot that holds one generic ──────────────────────────────────────────
// A read of an element or field of an un-annotated `const` literal nothing mutates, whose slot
// the flow table says holds one generic and no write, is rewritten to that generic's name where
// the name is in scope, so each read takes its own instance (fn-value-flow-design.md §(f)).
let mfrParent: i32[] = []
let mfrUses: {[i32]: i32[]} = Map()
let mfrNameCount: {[string]: i32} = Map()
let mfrGen: {[i32]: boolean} = Map()
let mfrCand: {[i32]: boolean} = Map()
// The roots of each binding the planner asked about, filled only by `monoFlowDeclVals` from the
// elaboration's values; the root sweep and tie bookkeeping read it for planned bindings alone.
let mfrPlannedRoots: {[i32]: i32[]} = Map()
let mfrPlannedRootsState: {[i32]: i32} = Map()
let mfrDirty: {[i32]: boolean} = Map()
let mfrCalled: i32[] = []
let mfrKeptIndex: i32[] = []
let mfrKeptTop: i32[] = []
// Each read rewritten from an element of a `let` list to a generic's name, to that `let` (D9980).
let mfrAliasWrites: {[i32]: i32[]} = Map()
// Pairs `[a, b]` of literal roots read as one: a pushed list and a list it is spread into, or two
// maps one binding is handed.
let mfrTied: i32[] = []
// The positions in `mfrTied` of the pairs whose second root is a copy a spread makes of the first.
let mfrTiedCopy: {[i32]: boolean} = Map()
// Bindings every read of which names their one generic and every spread of which is expanded, so
// no call reaches their element slot (D9595).
let mfrSpreadDone: i32[] = []
// Bindings a planned read slices, whose literal the slice's calls then reach through its slot.
let mfrSliced: i32[] = []
// The calls whose callee read `monoFlowReadSet` rewrote to name a generic.
let mfrSetCalls: i32[] = []
// Each read `monoFlowReadSet` rewrote, and each call through one: what goes through no slot now.
let mfrRepointed: i32[] = []
// Pairs `[binding, use]` of reads `monoFlowUsePlan` found naming no generic only because a value
// they read is an alias of a literal slot this round may rewrite to one (D9652).
let mfrPending: i32[] = []
// The written `let`s `monoFlowLetLeaf` is resolving, so a cycle of writes between two of them ends.
let mfrLetBusy: {[i32]: boolean} = Map()
let mfrLetDepth = 0

// The parent `monoFlowReads`' walk recorded for node `x`, or -1.
function mfrParentOf(x: i32): i32 { sidArrGet(mfrParent, x) }

// Rewrites, in the program `stmts` and the bodies in `fnStmts`, every such read; -1 never.
function monoFlowReads(stmts: i32[]): i32 {
  mfrParent = []
  mfrParent = __array_new__(P.nodes.length, -1)
  mfrUses = Map()
  mfrNameCount = Map()
  mfrGen = Map()
  mfrCand = Map()
  mfrPlannedRoots = Map()
  mfrPlannedRootsState = Map()
  mfrDirty = Map()
  mfrCalled = []
  mfrKeptIndex = []
  mfrKeptTop = []
  mfrAliasWrites = Map()
  mfrTied = []
  mfrTiedCopy = Map()
  mfrSpreadDone = []
  mfrSliced = []
  mfrSetCalls = []
  mfrRepointed = []
  elabValueSlotOmitSet(mfrRepointed)
  mfrPending = []
  mfrLetBusy = Map()
  mfrLetDepth = 0
  const lets: i32[] = []
  const calls: i32[] = []
  const seen: boolean[] = __array_new__(P.nodes.length, false)
  const roots: i32[] = []
  for s in stmts { roots.push(s) }
  for f in fnStmts { roots.push(f) }
  for root in roots {
    const stack: i32[] = [root]
    while stack.length > 0 {
      const ix = stack.pop()
      if ix >= 0 && ix < P.nodes.length && !(ix < seen.length && seen[ix]) {
        while seen.length <= ix { seen.push(false) }
        seen[ix] = true
        monoFlowReadsNote(ix, lets, calls)
        const kids = nodeChildren(ix)
        let k = kids.length - 1
        while k >= 0 {
          const ch = kids[k]
          if ch >= 0 {
            sidArrPut(mfrParent, ch, ix)
            stack.push(ch)
          }
          k = k - 1
        }
      }
    }
  }
  monoFlowReadsAll(lets)
  for d in lets {
    monoFlowLetCalls(d)
    monoFlowConstCallArgs(d)
  }
  for d in lets { monoFlowMapNoteAliasWrites(d) }
  monoFlowAdmitChain(calls)
  0
}

// Rewrites each callee read the chain walk resolves to one function (`mfrChainFns`) to that
// function, so each call instances it at its own arguments: an element or field read, or a name a
// `let` or `const` declares, resolving to a generic or a function with an un-annotated parameter,
// declared at module scope under a name nothing else in the program declares.
function monoFlowAdmitChain(calls: i32[]) {
  // The chain walk reads the write index; build it here rather than rely on an earlier reader.
  cwIxBuild()
  const none: i32[] = []
  for c in calls {
    const cn = nodeAt(c)
    const cf = if cn is Call { unwrapParen(cn.callFn) } else { -1 }
    const fn0 = if cf >= 0 && cf < P.nodes.length { nodeAt(cf) } else { null }
    const d = if fn0 is Ident { identDeclOf(cf) } else { -1 }
    const shaped = fn0 is Index
      || fn0 is Member
      || (d >= 0 && d < P.nodes.length && nodeAt(d) is LetDecl)
    const es = if shaped && !i32ListHas(mfrSetCalls, c) { mfrChainFns(cf) } else { none }
    const g = if es.length == 1 { es[0] } else { -1 }
    const gn = if g >= 0 && g < P.nodes.length { nodeAt(g) } else { null }
    if (
      gn is FuncDecl
      && recEnclosingFn(g) < 0
      && (mfrNameCount[gn.fnName] ?? 0) == 1
    ) {
      let open = gn.fnTyParams.length > 0
      for p in gn.fnParams {
        const pn = nodeAt(p)
        if pn is Param && pn.parType < 0 { open = true }
      }
      if open { monoFlowReadSet(cf, g) }
    }
  }
  0
}

// Rewrites each read of written `let` `d`, or of a `const` copy, to the one generic it holds
// (`monoFlowLetLeaf`) when every read is a call, copy, argument or list literal argument and some
// call passes a lambda or some read is handed on, so each specialises it for its own use (D9853).
// Calls alone keep the slot per call type; the values written are noted inert.
function monoFlowLetCalls(d: i32) {
  const dn = nodeAt(d)
  if !(dn is LetDecl) || dn.letKw == "const" { return 0 }
  const us = mfrUses[d] ?? []
  const calls: i32[] = []
  let writes = 0
  let listed = false
  for u in us {
    if monoFlowIsWrite(u) {
      writes = writes + 1
    } else if monoFlowListArgRead(u) || monoFlowHandedNarrowed(u) {
      calls.push(u)
      listed = true
    } else if monoFlowCopyHanded(u, calls) {
      listed = true
    } else if !monoFlowCallReads(u, calls, 0) {
      return 0
    }
  }
  if writes == 0 { return 0 }
  let lam = listed
  for u in calls {
    if monoFlowCallPassesLambda(u) { lam = true }
  }
  if !lam { return 0 }
  let g = monoFlowLetLeaf(d)
  const stored: i32[] = []
  if g == -1 { g = monoFlowLetMapLeaf(d, stored) }
  if g < 0 || !(nodeAt(g) is FuncDecl) { return 0 }
  for u in calls {
    if !monoFlowInScope(u, g) { return 0 }
  }
  for u in calls { monoFlowReadSet(u, g) }
  // The rewritten reads hand `g` on, so the map's stored values are called through no slot.
  if stored.length > 0 && !i32ListHas(mfrCalled, g) { mfrCalled.push(g) }
  for v in stored { monoFlowNoteInertLeaf(v) }
  monoFlowNoteInertLeaf(unwrapParen(dn.letInit))
  for u in us {
    const w = monoFlowWholeWrite(u)
    if w >= 0 { monoFlowNoteInertLeaf(unwrapParen(w)) }
  }
  0
}

// The one generic written `let` `d` holds when its initializer and every write to it is a
// read, narrowed non-null, of an un-annotated `const` bound to a map read whose stored values all
// name it, so every read of `d` names it too (D10384), with those values pushed onto `stored`;
// -1 otherwise.
function monoFlowLetMapLeaf(d: i32, stored: i32[]): i32 {
  const dn = nodeAt(d)
  if !(dn is LetDecl) { return -1 }
  const srcs: i32[] = []
  for w in cwBindingWrittenValues(cwKeyOfDecl(d)) { srcs.push(unwrapParen(w)) }
  if srcs.length == 0 { return -1 }
  let g = -1
  for s in srcs {
    if s < 0 || !(nodeAt(s) is Ident) { return -1 }
    const t = nodeTyIxOf(s)
    if t < 0 || t >= T.tys.length || !(tyAt(t) is TyFunc) { return -1 }
    const sd = identDeclOf(s)
    if sd < 0 { return -1 }
    const sn = nodeAt(sd)
    if !(sn is LetDecl) || sn.letKw != "const" || sn.letType >= 0 { return -1 }
    const base: i32[] = []
    const init = unwrapParen(sn.letInit)
    if init < 0 || !(nodeAt(init) is Index) { return -1 }
    const ib = nodeAt(init)
    if !(ib is Index) || !monoFlowValsOf(ib.idxArr, base) { return -1 }
    if base.length == 0 || monoFlowMapCount(base) != base.length { return -1 }
    const vs: i32[] = []
    for b in base {
      if !mfrLitsMapStored(b, vs) { return -1 }
    }
    if vs.length == 0 { return -1 }
    for v in vs {
      const vg = monoFlowLeafGen(v)
      if vg < 0 || (g >= 0 && vg != g) { return -1 }
      g = vg
      if !i32ListHas(stored, v) { stored.push(v) }
    }
  }
  g
}

// Rewrites to generic `g` each read of the un-annotated, unwritten binding `d` bound, directly
// or through such bindings, to a call always returning `g` (`monoFlowCallLeaf`), when every read
// is an argument of a call, so each callee instances `g` at its own type; the call still runs
// and what it returns is noted inert.
function monoFlowConstCallArgs(d: i32) {
  const us = mfrUses[d] ?? []
  if us.length == 0 { return 0 }
  for u in us {
    if !monoFlowHandedNarrowed(u) { return 0 }
  }
  const init = monoFlowBoundCall(d)
  if init < 0 { return 0 }
  const g = monoFlowCallLeaf(init)
  if g < 0 { return 0 }
  for u in us {
    if !monoFlowInScope(u, g) { return 0 }
  }
  for u in us { monoFlowReadSet(u, g) }
  monoFlowNoteInertLeaf(init)
}

// The call the un-annotated, unwritten binding `d` is initialized by, directly or through a
// chain of such bindings; -1 when the chain reaches anything else.
function monoFlowBoundCall(d: i32): i32 {
  let b = d
  let hops = 0
  while hops < MONO_ALIAS_CHAIN_MAX {
    if b < 0 || b >= P.nodes.length { return -1 }
    const bn = nodeAt(b)
    if !(bn is LetDecl) || bn.letType >= 0 || bn.letInit < 0 { return -1 }
    for u in mfrUses[b] ?? [] {
      if monoFlowIsWrite(u) { return -1 }
    }
    const x = unwrapParen(bn.letInit)
    if x >= 0 && nodeAt(x) is Call { return x }
    if x < 0 || !(nodeAt(x) is Ident) { return -1 }
    b = identDeclOf(x)
    hops = hops + 1
  }
  -1
}

// Whether read `u` is an element of a list literal handed as an argument (`run([v], 2)`).
function monoFlowListArgRead(u: i32): boolean {
  let lit = mfrParentOf(u)
  while lit >= 0 && nodeAt(lit) is Paren { lit = mfrParentOf(lit) }
  if lit < 0 { return false }
  const ln = nodeAt(lit)
  if !(ln is ArrayLit) { return false }
  let held = false
  for e in ln.arrElems {
    if unwrapParen(e) == u { held = true }
  }
  let c = mfrParentOf(lit)
  let x = lit
  while c >= 0 && nodeAt(c) is Paren {
    x = c
    c = mfrParentOf(c)
  }
  if !held || c < 0 { return false }
  const cn = nodeAt(c)
  cn is Call && cn.callFn != x && i32ListHas(cn.callArgs, x)
}

// Whether the call whose callee is read `u` passes an anonymous function as an argument.
function monoFlowCallPassesLambda(u: i32): boolean {
  const c = mfrParentOf(u)
  if c < 0 { return false }
  const cn = nodeAt(c)
  if !(cn is Call) { return false }
  for a in cn.callArgs {
    const an = nodeAt(unwrapParen(a))
    if an is FuncDecl {
      const nm = an.fnName
      if nm == "" || (nm.length >= 8 && nm.slice(0, 8) == "__lambda") {
        return true
      }
    }
  }
  false
}

// Appends to `calls` read `u` when it is a callee, or every such read of the un-annotated `const`
// `u` wholly initializes; false when some read along the way is neither.
function monoFlowCallReads(u: i32, calls: i32[], depth: i32): boolean {
  if monoFlowCalledAt(u) {
    calls.push(u)
    return true
  }
  if depth >= MONO_ALIAS_CHAIN_MAX { return false }
  let p = mfrParentOf(u)
  while p >= 0 && nodeAt(p) is Paren { p = mfrParentOf(p) }
  if p < 0 || !(mfrCand[p] ?? false) { return false }
  const pn = nodeAt(p)
  if !(pn is LetDecl) || pn.letKw != "const" || unwrapParen(pn.letInit) != u {
    return false
  }
  for r in mfrUses[p] ?? [] {
    if !monoFlowCallReads(r, calls, depth + 1) { return false }
  }
  true
}

// Appends to `calls` each read of the un-annotated `const` read `u` wholly initializes, when every
// one is handed on as an argument or list literal argument or is a call (`monoFlowCallReads`) and
// one at least is handed on (D10380); false otherwise, with `calls` unchanged.
function monoFlowCopyHanded(u: i32, calls: i32[]): boolean {
  let p = mfrParentOf(u)
  while p >= 0 && nodeAt(p) is Paren { p = mfrParentOf(p) }
  if p < 0 || !(mfrCand[p] ?? false) { return false }
  const pn = nodeAt(p)
  if !(pn is LetDecl) || pn.letKw != "const" || unwrapParen(pn.letInit) != u {
    return false
  }
  const got: i32[] = []
  let handed = false
  for r in mfrUses[p] ?? [] {
    if monoFlowListArgRead(r) || monoFlowHandedNarrowed(r) {
      got.push(r)
      handed = true
    } else if !monoFlowCallReads(r, got, 1) {
      return false
    }
  }
  if !handed { return false }
  for r in got { calls.push(r) }
  true
}

// Whether `s` declares a named function whose value has no one signature: type parameters, or an
// un-annotated parameter (a hole function, D6603).
function monoFlowTyParamGen(s: i32): boolean {
  const fn = nodeAt(s)
  if !(fn is FuncDecl) || fn.fnName == "" { return false }
  fn.fnTyParams.length > 0 || monoFlowHasHoleParam(s)
}

// Whether function declaration `s` has an un-annotated parameter.
function monoFlowHasHoleParam(s: i32): boolean {
  const fn = nodeAt(s)
  if !(fn is FuncDecl) { return false }
  for pi in fn.fnParams {
    const p = nodeAt(pi)
    if p is Param {
      if p.parType < 0 { return true }
    }
  }
  false
}

// The un-annotated `const` holding hole lambda `v` as its whole initializer, when no other
// declaration shares its name; -1 otherwise (D6603).
function monoFlowLamLeaf(v: i32): i32 {
  const n = nodeAt(v)
  if !(n is FuncDecl) || !monoFlowHasHoleParam(v) { return -1 }
  let p = mfrParentOf(v)
  while p >= 0 && nodeAt(p) is Paren { p = mfrParentOf(p) }
  if p < 0 { return -1 }
  const pd = nodeAt(p)
  if !(pd is LetDecl) || pd.letKw != "const" || pd.letType >= 0 { return -1 }
  if unwrapParen(pd.letInit) != v { return -1 }
  if (mfrNameCount[pd.letName] ?? 0) != 1 { return -1 }
  p
}

// The module-level generic every `return` of the function call `c` names, read bare or through
// another such call, when its last statement is one of them; -1 otherwise. A binding of the call
// still runs it (D9481, D10381).
function monoFlowCallLeaf(c: i32): i32 { monoFlowCallLeafAt(c, 0) }

function monoFlowCallLeafAt(c: i32, depth: i32): i32 {
  if depth > MONO_ALIAS_CHAIN_MAX || c < 0 || c >= P.nodes.length { return -1 }
  const cn = nodeAt(c)
  if !(cn is Call) { return -1 }
  const f = unwrapParen(cn.callFn)
  if f < 0 || !(nodeAt(f) is Ident) { return -1 }
  const fd = identDeclOf(f)
  if fd < 0 { return -1 }
  const fnd = nodeAt(fd)
  if !(fnd is FuncDecl) || fnd.fnTyParams.length > 0 || fnd.fnBody < 0 {
    return -1
  }
  let g = -1
  const ops = monoFlowRetOperands(fnd.fnBody)
  if ops.length == 0 { return -1 }
  for a in ops {
    if a >= 0 && nodeAt(a) is Call {
      const cg = monoFlowCallLeafAt(a, depth + 1)
      if cg < 0 || (g >= 0 && g != cg) { return -1 }
      g = cg
      continue
    }
    if a < 0 || !(nodeAt(a) is Ident) { return -1 }
    const an = nodeAt(a)
    const ad = identDeclOf(a)
    if ad < 0 || !(nodeAt(ad) is FuncDecl) || !(mfrGen[ad] ?? false) {
      return -1
    }
    if (mfrParentOf(ad)) >= 0 { return -1 }
    if an is Ident && (mfrNameCount[an.identName] ?? 0) != 1 { return -1 }
    if g >= 0 && g != ad { return -1 }
    g = ad
  }
  g
}

// The operand of each `return` in function body `body`, and its trailing value when that is a
// name; `[-1]` when the body ends in neither a `return` nor a name.
function monoFlowRetOperands(body: i32): i32[] {
  const out: i32[] = []
  const b = nodeAt(body)
  if !(b is Block) || b.blkStmts.length == 0 {
    out.push(-1)
    return out
  }
  const last = b.blkStmts[b.blkStmts.length - 1]
  if nodeAt(last) is Ident {
    out.push(last)
  } else if !(nodeAt(last) is RetStmt) {
    out.push(-1)
    return out
  }
  const stack: i32[] = [body]
  while stack.length > 0 {
    const x = stack.pop()
    const xn = nodeAt(x)
    if xn is RetStmt {
      out.push(unwrapParen(xn.retArg))
    } else if !(xn is FuncDecl) {
      for k in nodeChildren(x) {
        if k >= 0 { stack.push(k) }
      }
    }
  }
  out
}

// The name a read rewritten to leaf `g` (`monoFlowLeafGen`) spells: a function's or a `const`'s.
function monoFlowLeafName(g: i32): string {
  const gd = nodeAt(g)
  if gd is FuncDecl { return gd.fnName }
  if gd is LetDecl { return gd.letName }
  emitFail("monoFlowLeafName: a flow leaf is a function or a `const` lambda")
  ""
}

// Banks node `ix` for `monoFlowReads`: a name read, a declared name, a candidate binding, a
// read straight out of a literal.
function monoFlowReadsNote(ix: i32, lets: i32[], calls: i32[]) {
  const n = nodeAt(ix)
  if n is Call {
    monoFlowSliceAsSpread(ix, n.pos)
    calls.push(ix)
  } else if n is Ident {
    const d = identDeclOf(ix)
    if d >= 0 {
      const us = mfrUses[d] ?? []
      us.push(ix)
      mfrUses[d] = us
    }
  } else if n is LetDecl {
    monoFlowReadsName(n.letName)
    if n.letType < 0 && n.letInit >= 0 && !fnTagListTy(nodeTyIxOf(n.letInit)) {
      mfrCand[ix] = true
      lets.push(ix)
    }
  } else if n is FuncDecl {
    monoFlowReadsName(n.fnName)
    if monoFlowTyParamGen(ix) { mfrGen[ix] = true }
  } else if n is Param {
    monoFlowReadsName(n.parName)
    if n.parType < 0 && n.parDefault < 0 && n.parOpt == 0 && n.parRest == 0 {
      mfrCand[ix] = true
      lets.push(ix)
    }
  } else if n is ForIn {
    monoFlowReadsName(n.fiVar)
    monoFlowReadsName(n.fiVar2)
  }
  0
}

// Rewrites call `ix` to `[...xs]` when it is a whole `xs.slice(0)` copy of a list of functions,
// the copy the flow table takes it for, so a generic it holds expands as a spread's does (D10190).
function monoFlowSliceAsSpread(ix: i32, pos: i32) {
  const recv = wholeSliceRecv(ix)
  if recv < 0 { return 0 }
  const sp = mkSpread(recv, pos)
  adoptNodeTok(sp, recv)
  nodeTyRecord(sp, nodeTyIxOf(recv))
  const lit: Node = { arrElems: [sp], pos: pos }
  arenaSetNode(ix, lit)
  0
}

function monoFlowReadsName(nm: string) {
  if nm != "" { mfrNameCount[nm] = (mfrNameCount[nm] ?? 0) + 1 }
  0
}

// The generic function value node `v` names, as its declaration, when no other
// declaration shares its name, or when `v` is the checker's adapter lambda calling one; -1
// otherwise.
function monoFlowLeafGen(v: i32): i32 {
  if v < 0 { return -1 }
  const n = nodeAt(v)
  if n is FuncDecl {
    const cf = monoAdapterCallee(v)
    if cf < 0 { return monoFlowLamLeaf(v) }
    const c = unwrapParen(cf)
    if c < 0 || !(nodeAt(c) is Ident) { return -1 }
    return monoFlowLeafGen(c)
  }
  if n is Call { return monoFlowCallLeaf(v) }
  if !(n is Ident) { return -1 }
  // A chain of un-annotated `const` aliases names what its last initializer names (D5061).
  let r = v
  let hops = 0
  while hops <= MONO_ALIAS_CHAIN_MAX {
    const rn = nodeAt(r)
    if !(rn is Ident) { return -1 }
    const g = identDeclOf(r)
    if g < 0 { return -1 }
    const ad = nodeAt(g)
    if !(ad is LetDecl) {
      if !(mfrGen[g] ?? false) { return -1 }
      if (mfrNameCount[rn.identName] ?? 0) != 1 { return -1 }
      return g
    }
    if ad.letType >= 0 || ad.letInit < 0 { return -1 }
    if ad.letKw != "const" { return monoFlowLetLeaf(g) }
    r = unwrapParen(ad.letInit)
    if r < 0 { return -1 }
    if nodeAt(r) is FuncDecl { return monoFlowLamLeaf(r) }
    if !(nodeAt(r) is Ident) { return monoFlowCallLeaf(r) }
    hops = hops + 1
  }
  -1
}

// The generic un-annotated `let` `d` holds when its initializer and every write to it
// (`cwBindingWrittenValues`) name that one generic, so any read of it names it too (D9791); -1
// otherwise. Inside a cycle of such writes a `let` already being resolved answers -3.
function monoFlowLetLeaf(d: i32): i32 {
  const dn = nodeAt(d)
  if !(dn is LetDecl) || dn.letType >= 0 || dn.letInit < 0 { return -1 }
  if mfrLetBusy[d] ?? false { return -3 }
  mfrLetBusy[d] = true
  mfrLetDepth = mfrLetDepth + 1
  let g = monoFlowLeafGen(unwrapParen(dn.letInit))
  for w in cwBindingWrittenValues(cwKeyOfDecl(d)) {
    if g != -1 && w != dn.letInit {
      const wg = monoFlowLeafGen(unwrapParen(w))
      if g == -3 { g = wg }
      else if wg != -3 && wg != g { g = -1 }
    }
  }
  mfrLetDepth = mfrLetDepth - 1
  mfrLetBusy[d] = false
  if mfrLetDepth == 0 && g < 0 { return -1 }
  g
}

// Whether the slot at `path` of binding `d` holds generic `g` alone, unwritten: each source the
// flow table records is `g` or an adapter lambda calling it.
function monoFlowSrcIs(d: i32, path: string[], g: i32): boolean {
  const srcs = elabSlotSrcFns(d, path)
  if srcs.length == 0 { return false }
  for x in srcs {
    if x != g && monoFlowLeafGen(x) != g { return false }
  }
  true
}

// Whether generic `g` is among the sources of `d`'s slot at `path`.
function monoFlowSrcHas(d: i32, path: string[], g: i32): boolean {
  for x in elabSlotSrcFns(d, path) {
    if x == g || monoFlowLeafGen(x) == g { return true }
  }
  false
}

// Whether node `v` is a list or record literal.
function monoFlowIsLit(v: i32): boolean {
  if v < 0 { return false }
  const n = nodeAt(v)
  n is ArrayLit || n is ObjLit
}

// The right-hand side when name read `u` is the whole target of a plain `=`, -1 otherwise.
function monoFlowWholeWrite(u: i32): i32 {
  const p = mfrParentOf(u)
  if p < 0 { return -1 }
  const pn = nodeAt(p)
  if pn is BinExpr {
    if pn.binOp == "=" && pn.binLeft == u { return pn.binRight }
  }
  -1
}

// The un-annotated `const` that call `v`, a `Map()` naming no declared `Map`, initializes; -1
// otherwise. Its values are what the binding's own writes store (`monoFlowMapVals`).
function monoFlowMapOwner(v: i32): i32 {
  if v < 0 || v >= P.nodes.length { return -1 }
  const c = nodeAt(v)
  if !(c is Call) || c.callArgs.length != 0 || c.callFn < 0 { return -1 }
  const f = nodeAt(c.callFn)
  if !(f is Ident) || f.identName != "Map" || identDeclOf(c.callFn) >= 0 {
    return -1
  }
  let p = mfrParentOf(v)
  while p >= 0 && nodeAt(p) is Paren { p = mfrParentOf(p) }
  if p < 0 { return -1 }
  const d = nodeAt(p)
  if !(d is LetDecl) || d.letKw != "const" || d.letType >= 0 { return -1 }
  if unwrapParen(d.letInit) != v { return -1 }
  p
}

// The value a write through map expression `x` stores, `x[k] = v` or `x.set(k, v)`; -1 otherwise.
function monoFlowStoreOf(x: i32): i32 {
  const q = mfrParentOf(x)
  if q < 0 { return -1 }
  const qn = nodeAt(q)
  const w = mfrParentOf(q)
  if w < 0 { return -1 }
  const wn = nodeAt(w)
  if qn is Index && qn.idxArr == x {
    if wn is BinExpr && wn.binOp == "=" && wn.binLeft == q {
      return wn.binRight
    }
    return -1
  }
  if !(qn is Member) || qn.memObj != x || qn.memProp != "set" { return -1 }
  if !(wn is Call) || wn.callFn != q || hasNamedArgs(wn.callArgNames) {
    return -1
  }
  if wn.callArgs.length != 2 { return -1 }
  wn.callArgs[1]
}

// The binding named by the map a write stores value `v` into, `t[k] = v` or `t.set(k, v)`;
// -1 otherwise.
function monoFlowStoreTarget(v: i32): i32 {
  let x = v
  while (mfrParentOf(x)) >= 0 && nodeAt(mfrParentOf(x)) is Paren {
    x = mfrParentOf(x)
  }
  const p = mfrParentOf(x)
  if p < 0 { return -1 }
  const pn = nodeAt(p)
  let tgt = -1
  if pn is BinExpr && pn.binOp == "=" && pn.binRight == x {
    const l = nodeAt(unwrapParen(pn.binLeft))
    if l is Index { tgt = unwrapParen(l.idxArr) }
  } else if pn is Call && pn.callArgs.length == 2 && pn.callArgs[1] == x {
    const f = nodeAt(unwrapParen(pn.callFn))
    if f is Member && f.memProp == "set" { tgt = unwrapParen(f.memObj) }
  }
  if tgt < 0 || !(nodeAt(tgt) is Ident) { return -1 }
  identDeclOf(tgt)
}

// The first `Map()` candidate binding `d` holds (`monoFlowAliasMaps`), tying every other one to it;
// -1 when it holds none.
function monoFlowAliasMap(d: i32): i32 {
  const ms = monoFlowAliasMaps(d)
  if ms.length == 0 { return -1 }
  for m in ms { monoFlowTie(ms[0], m, false) }
  ms[0]
}

// The `Map()` values candidate binding `d`, an un-annotated parameter or `const` other than their
// owner, holds, from its literal roots (`mfrLitsOf`); empty when it may hold anything else. A
// write through `d` stores into each (D9480).
function monoFlowAliasMaps(d: i32): i32[] {
  if d < 0 || d >= P.nodes.length || !(mfrCand[d] ?? false) { return [] }
  const dn = nodeAt(d)
  if dn is LetDecl && dn.letKw != "const" { return [] }
  const vs: i32[] = []
  if !mfrLitsOf(d, vs) { return [] }
  for v in vs {
    const o = monoFlowMapOwner(v)
    if o < 0 || o == d { return [] }
  }
  vs
}

// The candidate binding read `x` of a map is handed to whole, the parameter of a direct call
// or a `const` it initializes; -1 when it is used otherwise.
function monoFlowMapHandOn(x: i32): i32 {
  const p = mfrParentOf(x)
  if p < 0 { return -1 }
  const pn = nodeAt(p)
  if pn is LetDecl {
    if pn.letInit == x && (mfrCand[p] ?? false) { return p }
    return -1
  }
  if !(pn is Call) || pn.callFn == x || hasNamedArgs(pn.callArgNames) {
    return -1
  }
  const c = unwrapParen(pn.callFn)
  if c < 0 || !(nodeAt(c) is Ident) { return -1 }
  const fd = identDeclOf(c)
  if fd < 0 || !(nodeAt(fd) is FuncDecl) { return -1 }
  const fn = nodeAt(fd)
  if !(fn is FuncDecl) { return -1 }
  let i = 0
  while i < pn.callArgs.length && i < fn.fnParams.length {
    if pn.callArgs[i] == x {
      const pd = fn.fnParams[i]
      if mfrCand[pd] ?? false { return pd }
      return -1
    }
    i = i + 1
  }
  -1
}

// Appends to `out` the value each write into map `mv` (`monoFlowMapOwner`) stores: a literal or
// a read naming a generic as written, anything else as its elaboration roots; false when one is
// unknown, or when a binding it is handed to may hold another map. Notes the writes through any
// other handle (`monoFlowAliasStored`), whose pins instance what they store (D9651, D9440).
function monoFlowMapVals(mv: i32, out: i32[]): boolean {
  const d = monoFlowMapOwner(mv)
  if d < 0 { return false }
  const via: i32[] = [d]
  let i = 0
  while i < via.length {
    for u in mfrUses[via[i]] ?? [] {
      let x = u
      while (mfrParentOf(x)) >= 0 && nodeAt(mfrParentOf(x)) is Paren {
        x = mfrParentOf(x)
      }
      if monoFlowStoreOf(x) < 0 {
        const h = monoFlowMapHandOn(x)
        if h >= 0 && !i32ListHas(via, h) {
          if !i32ListHas(monoFlowAliasMaps(h), mv) { return false }
          via.push(h)
        }
      }
    }
    i = i + 1
  }
  const vals: i32[] = []
  const ats: i32[] = []
  const writes: i32[] = []
  const r = cwSlotWrittenValues(cwKeyOfDecl(d), ["[]"], vals, ats)
  for w in vals {
    const b = monoFlowStoreTarget(w)
    if b >= 0 && b != d { writes.push(w) }
  }
  mfrAliasWrites[d] = writes
  if r < 0 { return false }
  for w in vals {
    const sv = unwrapParen(w)
    if monoFlowIsLit(sv) || monoFlowLeafGen(sv) >= 0 { out.push(sv) }
    else if mfrLitsExprOf(sv, out) < 0 { return false }
  }
  true
}

// Notes the writes through the aliases of the map candidate `d` initializes, when no read of it
// asked already, so the map's pin instances what they store too (D9651).
function monoFlowMapNoteAliasWrites(d: i32) {
  if mfrAliasWrites.has(d) { return 0 }
  const dn = nodeAt(d)
  if !(dn is LetDecl) { return 0 }
  const mv = unwrapParen(dn.letInit)
  if monoFlowMapOwner(mv) != d { return 0 }
  const held: i32[] = []
  monoFlowMapVals(mv, held)
  0
}

// The values a write through a parameter or `const` the map declared at `at` is handed to stores,
// as `monoFlowMapVals` found them.
function monoFlowAliasStored(at: i32): i32[] { mfrAliasWrites[at] ?? [] }

// How many of `cv` are maps `monoFlowMapOwner` knows.
function monoFlowMapCount(cv: i32[]): i32 {
  let k = 0
  for v in cv {
    if monoFlowMapOwner(v) >= 0 { k = k + 1 }
  }
  k
}

// Whether `p` compares `cur` against `null`.
function monoFlowNullTest(p: i32, cur: i32): boolean {
  const pn = nodeAt(p)
  if !(pn is BinExpr) || (pn.binOp != "==" && pn.binOp != "!=") { return false }
  const o = if pn.binLeft == cur { pn.binRight } else { pn.binLeft }
  nodeAt(unwrapParen(o)) is NullLit
}

// Appends to `out` the literals expression `x` may evaluate to: a candidate binding's or loop
// variable's (`monoFlowDeclVals`), else the elaboration's roots (`mfrLitsExprOf`), where a function
// counts only when a map read gives it; false when it may evaluate to anything else.
function monoFlowValsOf(x: i32, out: i32[]): boolean {
  const v = if x < 0 { -1 } else { unwrapParen(x) }
  if v < 0 { return false }
  if nodeAt(v) is Ident {
    const d = identDeclOf(v)
    if d < 0 || loopVarLoop(d) < 0 && !(mfrCand[d] ?? false) { return false }
    const dv = monoFlowDeclVals(d)
    for y in dv { out.push(y) }
    return dv.length > 0
  }
  const ev: i32[] = []
  const r = mfrLitsExprOf(v, ev)
  if r < 0 || ev.length == 0 { return false }
  for e in ev {
    if r == 1 && !monoFlowIsLit(e) && monoFlowMapOwner(e) < 0 { return false }
  }
  for e in ev { out.push(e) }
  true
}

// The elaboration's roots of binding or function `d` (`mfrLitsOf`): empty when unknown, or when
// a root is no container and `d` reached a function other than through a map read. A `.slice()`
// copy mono rewrote to a minted spread literal holds that literal in place of its receiver's roots.
function monoFlowDeclVals(d: i32): i32[] {
  const st = mfrPlannedRootsState[d] ?? 0
  if st == 2 { return mfrPlannedRoots[d] ?? [] }
  if st != 0 { return [] }
  mfrPlannedRootsState[d] = 3
  let ev: i32[] = []
  if !mfrLitsOf(d, ev) { return [] }
  const dn = nodeAt(d)
  if dn is LetDecl {
    const iv = unwrapParen(dn.letInit)
    const il = if iv >= 0 { nodeAt(iv) } else { null }
    if (
      il is ArrayLit
      && il.arrElems.length == 1
      && il.arrElems[0] >= cwIxCoveredLen()
    ) {
      const sp = nodeAt(il.arrElems[0])
      if sp is Spread {
        const rv: i32[] = []
        if mfrLitsExprOf(sp.spdArg, rv) < 0 { return [] }
        const kept: i32[] = [iv]
        for v in ev {
          if !i32ListHas(rv, v) && !i32ListHas(kept, v) { kept.push(v) }
        }
        ev = kept
      }
    }
  }
  for v in ev {
    if !monoFlowIsLit(v) && monoFlowMapOwner(v) < 0 && mfrLitsDirectFn(d) {
      return []
    }
  }
  mfrPlannedRoots[d] = ev
  mfrPlannedRootsState[d] = 2
  ev
}

// The outermost literal whose tree holds literal `v`, or the `Map()` a write stores that tree in.
function monoFlowLitRoot(v: i32): i32 {
  let r = v
  let x = v
  let p = mfrParentOf(x)
  while p >= 0 {
    const pn = nodeAt(p)
    if pn is ArrayLit || pn is ObjLit { r = p }
    else if !(pn is FieldInit || pn is Paren || pn is Spread) { break }
    x = p
    p = mfrParentOf(x)
  }
  // A value a map write stores shares the map's tree: a read of either reads the other.
  const d = if p >= 0 { monoFlowStoreTarget(x) } else { -1 }
  if d < 0 { return r }
  const am = monoFlowAliasMap(d)
  if am >= 0 { return am }
  const dn = nodeAt(d)
  if !(dn is LetDecl) { return r }
  const mv = unwrapParen(dn.letInit)
  if monoFlowMapOwner(mv) != d { return r }
  mv
}

// Plans and applies the rewrites of every candidate binding in `lets`. A binding is rewritten
// only when each of its reads is planned and no binding sharing one of its literal trees
// declined, since a declined read may mutate a value the others read or let it escape.
function monoFlowReadsAll(lets: i32[]) {
  const hosts = monoFlowReadsRound(lets)
  if hosts.length == 0 { return 0 }
  // Each list a spread expanded into holds no spread now, so its holders are planned again.
  const again: i32[] = []
  for d in lets {
    let holds = false
    for v in mfrPlannedRoots[d] ?? [] {
      const r = monoFlowLitRoot(v)
      for h in hosts {
        if h == r { holds = true }
      }
    }
    if holds { again.push(d) }
  }
  for h in hosts { mfrDirty[h] = false }
  monoFlowReadsRound(again)
  0
}

// One planning round of `monoFlowReadsAll` over `lets`; the roots of the list literals its
// spreads expand into.
function monoFlowReadsRound(lets: i32[]): i32[] {
  const pr: i32[] = []
  const pl: i32[] = []
  const ps: i32[] = []
  const planned: i32[] = []
  for d in lets {
    const vals = monoFlowDeclVals(d)
    if vals.length > 0 {
      const reads: i32[] = []
      const loops: i32[] = []
      const spreads: i32[] = []
      let ok = true
      for u in mfrUses[d] ?? [] {
        if ok && !monoFlowUsePlan(d, u, vals, reads, loops, spreads) {
          ok = false
        }
      }
      if ok {
        planned.push(d)
        monoFlowTagPairs(pr, d, reads)
        monoFlowTagPairs(pl, d, loops)
        monoFlowTagPairs(ps, d, spreads)
      } else {
        for v in vals { mfrDirty[monoFlowLitRoot(v)] = true }
      }
    }
  }
  // Tied roots decline together (D9482), but a list a spread copies keeps its plan when only the
  // copy declines: its values are then what the copy is built from (D9595).
  let spreadMoved = true
  while spreadMoved {
    spreadMoved = false
    let si = 0
    while si + 1 < mfrTied.length {
      const a = mfrTied[si]
      const b = mfrTied[si + 1]
      const da = mfrDirty[a] ?? false
      const db = mfrDirty[b] ?? false
      if da != db && !(db && (mfrTiedCopy[si] ?? false)) {
        mfrDirty[a] = true
        mfrDirty[b] = true
        spreadMoved = true
      }
      si = si + 2
    }
  }
  const copied: i32[] = []
  let i = 0
  while i + 1 < mfrTied.length {
    if (mfrTiedCopy[i] ?? false) && (mfrDirty[mfrTied[i + 1]] ?? false) {
      copied.push(mfrTied[i])
    }
    i = i + 2
  }
  // A binding some read, loop or spread of which keeps reading through the literal.
  const through: i32[] = []
  i = 0
  while i < pr.length {
    if monoFlowDeclClean(pr[i]) && !monoFlowReadSet(pr[i + 1], pr[i + 2]) {
      through.push(pr[i])
    }
    i = i + 3
  }
  i = 0
  while i < pl.length {
    if monoFlowDeclClean(pl[i]) && !monoFlowLoopSet(pl[i + 1], pl[i + 2]) {
      through.push(pl[i])
    }
    i = i + 3
  }
  monoFlowReplanPending(planned, through)
  for d in planned {
    if i32ListHas(mfrSliced, d) && !i32ListHas(through, d) { through.push(d) }
  }
  const viaReads: i32[] = []
  for t in through { viaReads.push(t) }
  i = 0
  while i < ps.length {
    through.push(ps[i])
    i = i + 3
  }
  monoFlowNoteInert(planned, through, copied)
  i = 0
  const hosts: i32[] = []
  const unset: i32[] = []
  while i < ps.length {
    let h = -1
    if monoFlowDeclClean(ps[i]) { h = monoFlowSpreadSet(ps[i + 1], ps[i + 2]) }
    if h >= 0 { hosts.push(monoFlowLitRoot(h)) } else { unset.push(ps[i]) }
    i = i + 3
  }
  i = 0
  while i < ps.length {
    const d = ps[i]
    if (
      !i32ListHas(viaReads, d)
      && !i32ListHas(unset, d)
      && !i32ListHas(mfrSpreadDone, d)
    ) {
      mfrSpreadDone.push(d)
    }
    i = i + 3
  }
  hosts
}

// Plans again, after this round's rewrites, each read of `mfrPending` whose clean binding is in
// `planned`: a read now naming a generic is rewritten to it, and one that cannot be keeps its
// binding in `through`, so the names its literal holds stay values a slot call reaches (D9652).
function monoFlowReplanPending(planned: i32[], through: i32[]) {
  const pend = mfrPending
  mfrPending = []
  let i = 0
  while i + 1 < pend.length {
    const d = pend[i]
    if i32ListHas(planned, d) && monoFlowDeclClean(d) {
      const reads: i32[] = []
      const loops: i32[] = []
      const spreads: i32[] = []
      const ok = monoFlowUsePlan(
        d,
        pend[i + 1],
        monoFlowDeclVals(d),
        reads,
        loops,
        spreads,
      )
      let kept = !ok || loops.length > 0 || spreads.length > 0
      let k = 0
      while k + 1 < reads.length {
        if !monoFlowReadSet(reads[k], reads[k + 1]) { kept = true }
        k = k + 2
      }
      if kept || mfrPending.length > 0 { through.push(d) }
      mfrPending = []
    }
    i = i + 2
  }
  0
}

// Whether `v` is an element or field read, or names an un-annotated `const` whose alias chain
// ends at one, so a rewrite later in the round may make it name a generic (D10390).
function monoFlowAliasOfRead(v: i32): boolean {
  if v >= 0 && (nodeAt(v) is Index || nodeAt(v) is Member) { return true }
  let r = v
  let hops = 0
  while hops <= MONO_ALIAS_CHAIN_MAX {
    if r < 0 || !(nodeAt(r) is Ident) { return false }
    const g = identDeclOf(r)
    if g < 0 { return false }
    const ad = nodeAt(g)
    if (
      !(ad is LetDecl)
      || ad.letKw != "const"
      || ad.letType >= 0
      || ad.letInit < 0
    ) {
      return false
    }
    r = unwrapParen(ad.letInit)
    if r < 0 { return false }
    const rn = nodeAt(r)
    if rn is Index || rn is Member { return true }
    hops = hops + 1
  }
  false
}

// Appends each pair of `pairs` to `out` as a triple led by binding `d`.
function monoFlowTagPairs(out: i32[], d: i32, pairs: i32[]) {
  let i = 0
  while i + 1 < pairs.length {
    out.push(d)
    out.push(pairs[i])
    out.push(pairs[i + 1])
    i = i + 2
  }
  0
}

// Whether every literal tree binding `d` may hold is clear of a decline by another binding.
function monoFlowDeclClean(d: i32): boolean {
  for v in mfrPlannedRoots[d] ?? [] {
    if mfrDirty[monoFlowLitRoot(v)] ?? false { return false }
  }
  true
}

// The one generic every node in `vs` names: -1 when none names one, -2 when they disagree.
function monoFlowCommonGen(vs: i32[]): i32 {
  let g = -1
  let first = true
  for v in vs {
    const vg = monoFlowLeafGen(v)
    if !first && vg != g { return -2 }
    g = vg
    first = false
  }
  g
}

// Plans read `u` of binding `d`, which may hold any literal in `vals`, appending `[read, gen]`
// to `reads`, `[loop, gen]` to `loops` or `[spread, list]` to `spreads`; false for a read that
// may mutate the value, or let it escape where its slots are not read by name.
function monoFlowUsePlan(
  d: i32,
  u: i32,
  vals: i32[],
  reads: i32[],
  loops: i32[],
  spreads: i32[],
): boolean {
  const top: string[] = []
  monoFlowUsePlanAt(d, u, vals, top, reads, loops, spreads)
}

// `monoFlowUsePlan` for a read `u` of the slot at `pre` of binding `d`, which may hold any
// literal in `vals`.
function monoFlowUsePlanAt(
  d: i32,
  u: i32,
  vals: i32[],
  pre: string[],
  reads: i32[],
  loops: i32[],
  spreads: i32[],
): boolean {
  if monoFlowWholeWrite(u) >= 0 { return pre.length == 0 }
  let cur = u
  let cv: i32[] = vals
  const path: string[] = []
  for k in pre { path.push(k) }
  // A value read out of a map may be absent, so its reads are never rewritten whole.
  let viaMap = false
  for v in vals {
    if monoFlowMapOwner(monoFlowLitRoot(v)) >= 0 { viaMap = true }
  }
  // Set once a computed index reads a row of a nested literal: every row is then a candidate.
  let rows = false
  let p = mfrParentOf(cur)
  while p >= 0 {
    const pn = nodeAt(p)
    let prop = ""
    let isField = false
    if pn is Member {
      isField = pn.memObj == cur
      prop = pn.memProp
    } else if pn is OptMember {
      isField = pn.omObj == cur
      prop = pn.omProp
      if viaMap { return false }
    }
    const maps = monoFlowMapCount(cv)
    if maps > 0 && maps != cv.length { return false }
    if pn is Paren {
      cur = p
    } else if maps > 0 && (pn is Index && pn.idxArr == cur || isField) {
      if monoFlowStoreOf(cur) >= 0 { return true }
      if isField && prop != "get" { return monoFlowMapQuery(prop, p) }
      let rd = p
      if isField {
        rd = mfrParentOf(p)
        if rd < 0 { return false }
        const rn = nodeAt(rd)
        if !(rn is Call) || rn.callFn != p || rn.callArgs.length != 1 {
          return false
        }
      } else if monoFlowIsWrite(p) {
        return false
      }
      const next: i32[] = []
      for b in cv {
        if !mfrLitsMapStored(b, next) { return false }
      }
      cv = next
      path.push("v")
      viaMap = true
      cur = rd
    } else if pn is Index && pn.idxArr == cur {
      // An element write through the list's own name or an alias stores a value its reads count,
      // so it is planned only when every value the list holds names one generic (D10340).
      if path.length == 0 && cv.length == 1 && monoFlowElemWriteOf(cur) >= 0 {
        const ow = monoFlowListOwner(cv[0])
        return ow >= 0
          && i32ListHas(monoFlowListNames(ow), d)
          && monoFlowElemsGen(cv[0]) >= 0
      }
      const next: i32[] = []
      for v in cv {
        let el = monoFlowElemAt(v, pn.idxIndex)
        if el < 0 { el = monoFlowKeptIndexElem(v, p) }
        if el < 0 && monoFlowRowLeaves(v, p, next) { rows = true }
        else if el < 0 { return false }
        else { next.push(el) }
      }
      cv = next
      path.push("e")
      cur = p
    } else if isField {
      let lists = 0
      for v in cv {
        if nodeAt(v) is ArrayLit { lists = lists + 1 }
      }
      if lists > 0 {
        // A push through the list's own name or an alias appends a value its reads already count
        // (D9441, D10341).
        if prop == "push" && path.length == 0 && cv.length == 1 {
          const pv = monoFlowPushOf(cur)
          const ow = monoFlowListOwner(cv[0])
          if pv >= 0 && ow >= 0 && i32ListHas(monoFlowListNames(ow), d) {
            return monoFlowLeafGen(unwrapParen(pv)) >= 0
          }
        }
        // A slice of the list copies its values into a list whose calls keep its slot (D10082).
        if prop == "slice" && path.length == 0 && lists == cv.length {
          const sc = mfrParentOf(p)
          if sc < 0 { return false }
          const scn = nodeAt(sc)
          if !(scn is Call) || scn.callFn != p { return false }
          if !i32ListHas(mfrSliced, d) { mfrSliced.push(d) }
          return true
        }
        return lists == cv.length && prop == "length" && !monoFlowIsWrite(p)
      }
      const next: i32[] = []
      for v in cv {
        const fv = monoFlowFieldOf(v, prop)
        if fv < 0 { return false }
        next.push(fv)
      }
      cv = next
      path.push("f." + prop)
      cur = p
    } else {
      break
    }
    p = mfrParentOf(cur)
  }
  // A read through a computed row index is rewritten only as a callee whose copy runs first, so
  // its bound checks still run (D9900).
  if rows && (monoFlowMapCount(cv) > 0 || monoFlowCallStmtOf(cur) < 0) {
    return false
  }
  if monoFlowMapCount(cv) > 0 {
    if p < 0 { return false }
    if monoFlowNullTest(p, cur) { return true }
    // A map handed whole to a binding whose own writes and reads are its owner's (D9440).
    const h = monoFlowMapHandOn(cur)
    return cv.length == 1 && h >= 0 && i32ListHas(monoFlowAliasMaps(h), cv[0])
  }
  let lits = 0
  for v in cv {
    if monoFlowIsLit(v) { lits = lits + 1 }
  }
  if lits > 0 {
    if lits != cv.length || p < 0 { return false }
    return monoFlowContainerUse(d, p, cur, cv, path, reads, loops, spreads)
  }
  if monoFlowIsWrite(cur) { return false }
  // A slot holding a `const` read of a map holds what that read gives (D9792).
  if path.length > 0 && !viaMap {
    const ex: i32[] = []
    if monoFlowAliasReadVals(cv, ex) {
      cv = ex
      viaMap = true
    }
  }
  const whole = path.length == 0 || path[path.length - 1] == "v"
  if viaMap && whole {
    // Only a call, or an argument, its null test has narrowed may read a maybe-absent value as
    // the generic.
    if p >= 0 && monoFlowWholeUse(p, cur) { return true }
    if (
      path.length > 0
      || !(monoFlowCalledAt(cur) || monoFlowHandedNarrowed(cur))
    ) {
      return false
    }
  }
  const g = monoFlowCommonGen(cv)
  if g == -1 {
    for v in cv {
      if monoFlowAliasOfRead(v) {
        mfrPending.push(d)
        mfrPending.push(u)
        return true
      }
    }
    return true
  }
  if g < 0 { return false }
  if viaMap {
    // A hole function read out of a map keeps the slot its pin types (D9064).
    const gn = nodeAt(g)
    if !(gn is FuncDecl) || gn.fnTyParams.length == 0 { return false }
    if !monoFlowHeldIs(d, path, g) { return false }
  } else if path.length > 0 && path[path.length - 1] == "e" {
    // A list's elements share one slot, so a literal-index read of it, unwritten, names its own
    // element even where another element names another generic (D6795).
    if (
      !monoFlowSrcHas(d, path, g)
      && !monoFlowHeldIs(d, path, g)
      && !monoFlowSpreadSrcElem(d, path, cur, g)
      && !monoFlowAliasSrcElem(d, path, cur, g)
    ) {
      return false
    }
  } else if !monoFlowSrcIs(d, path, g) && !monoFlowHeldIs(d, path, g) {
    return false
  }
  if rows && !i32ListHas(mfrKeptIndex, cur) { mfrKeptIndex.push(cur) }
  reads.push(cur)
  reads.push(g)
  true
}

// Whether `cur` reads, by index, an element naming generic `g` of the one list literal `d` owns,
// every element of it when it grows, and `d` is spread: the flow table joins a spread list's slot with its copy's, whose
// writes and other values then reach no read of `d` (D9595).
function monoFlowSpreadSrcElem(
  d: i32,
  path: string[],
  cur: i32,
  g: i32,
): boolean {
  if path.length != 1 { return false }
  const xn = nodeAt(cur)
  if !(xn is Index) { return false }
  const vs = monoFlowDeclVals(d)
  if vs.length != 1 || monoFlowListOwner(vs[0]) != d { return false }
  if monoFlowListGrows(vs[0], 0) {
    if monoFlowElemsGen(vs[0]) != g { return false }
  } else if monoFlowLeafGen(monoFlowElemAt(vs[0], xn.idxIndex)) != g {
    return false
  }
  if !i32ListHas(elabSlotHeldFns(d, path), g) { return false }
  for u in mfrUses[d] ?? [] {
    const p = mfrParentOf(u)
    if p >= 0 && nodeAt(p) is Spread { return true }
  }
  false
}

// Whether `cur` reads, by a literal index, an element of the one ungrown list literal `d` owns
// that is a `const` alias naming generic `g`: the flow table joins every slot listing the alias,
// whose writes and other values then reach no read of `d` (D10081).
function monoFlowAliasSrcElem(
  d: i32,
  path: string[],
  cur: i32,
  g: i32,
): boolean {
  if path.length != 1 { return false }
  const xn = nodeAt(cur)
  if !(xn is Index) { return false }
  const vs = monoFlowDeclVals(d)
  if (
    vs.length != 1
    || monoFlowListOwner(vs[0]) != d
    || monoFlowListGrows(vs[0], 0)
  ) {
    return false
  }
  const el = monoFlowElemAt(vs[0], xn.idxIndex)
  if el < 0 || !(nodeAt(el) is Ident) || monoFlowLeafGen(el) != g {
    return false
  }
  const ad = identDeclOf(el)
  if ad < 0 { return false }
  const an = nodeAt(ad)
  an is LetDecl && an.letKw == "const"
}

// The closed function types slot `path` of `d` is delivered at, as pin keys, leaving out the
// calls whose callee read `monoFlowReadSet` points at a generic; empty when it points at none.
function monoFlowSlotPins(d: i32, path: string[], fts: i32[]): string[] {
  const out: string[] = []
  if mfrSetCalls.length == 0 { return out }
  for t in elabSlotDeliveriesOmitting(d, path, -1, mfrSetCalls) {
    const ft = tyAt(t)
    if ft is TyFunc {
      const sg = pinSigOf(ft.fnParamTypes)
      if !strListHas(out, sg) {
        out.push(sg)
        fts.push(t)
      }
    }
  }
  out
}

// Whether `p` uses value `cur` whole where its own reads are planned or it is tested for `null`.
function monoFlowWholeUse(p: i32, cur: i32): boolean {
  monoFlowAliasUse(p, cur)
    || monoFlowArgUse(p, cur)
    || monoFlowBinUse(p, cur)
    || monoFlowListedUse(p, cur)
}

// Whether `p` is a list literal, or a record literal's field, initializing an un-annotated
// `const` candidate and holding `cur`.
function monoFlowListedUse(p: i32, cur: i32): boolean {
  const pn = nodeAt(p)
  let lit = p
  if pn is FieldInit {
    if pn.fiValue != cur { return false }
    lit = mfrParentOf(p)
    if lit < 0 || !(nodeAt(lit) is ObjLit) { return false }
  } else if !(pn is ArrayLit) || !i32ListHas(pn.arrElems, cur) {
    return false
  }
  let q = mfrParentOf(lit)
  let x = lit
  while q >= 0 && nodeAt(q) is Paren {
    x = q
    q = mfrParentOf(q)
  }
  if q < 0 || !(mfrCand[q] ?? false) { return false }
  const qn = nodeAt(q)
  qn is LetDecl && qn.letKw == "const" && qn.letInit == x
}

// Appends to `out` the generics each of `cv` gives when every one is a read of an un-annotated
// `const` candidate whose values, read out of a map, all name a generic; false otherwise.
function monoFlowAliasReadVals(cv: i32[], out: i32[]): boolean {
  if cv.length == 0 { return false }
  for v in cv {
    if v < 0 || !(nodeAt(v) is Ident) { return false }
    const d = identDeclOf(v)
    if d < 0 || !(mfrCand[d] ?? false) { return false }
    const dn = nodeAt(d)
    if !(dn is LetDecl) || dn.letKw != "const" { return false }
    const vs = monoFlowDeclVals(d)
    if vs.length == 0 { return false }
    for y in vs {
      if monoFlowLeafGen(y) < 0 { return false }
      if monoFlowMapOwner(monoFlowLitRoot(y)) < 0 { return false }
      out.push(y)
    }
  }
  true
}

// Whether member `prop` of a map, used at `p`, reads none of its values: a key test, the length,
// the keys, or a removal.
function monoFlowMapQuery(prop: string, p: i32): boolean {
  if monoFlowIsWrite(p) { return false }
  prop == "has"
    || prop == "length"
    || prop == "delete"
    || prop == "clear"
    || prop == "keys"
}

// Whether every function the slot at `path` of binding `d` can hold, written or not, is `g`.
function monoFlowHeldIs(d: i32, path: string[], g: i32): boolean {
  const srcs = elabSlotHeldFns(d, path)
  if srcs.length == 0 { return false }
  for x in srcs {
    if x != g && monoFlowLeafGen(x) != g { return false }
  }
  true
}

// Whether every function the slot at `path` of binding `d` can hold, written or not, is one
// generic, as a written `let` holding it only ever is (D9791).
function monoFlowHeldOneGen(d: i32, path: string[]): boolean {
  const srcs = elabSlotHeldFns(d, path)
  if srcs.length == 0 { return false }
  const g = if mfrGen[srcs[0]] ?? false { srcs[0] } else { monoFlowLeafGen(srcs[0]) }
  g >= 0 && monoFlowHeldIs(d, path, g)
}

// Plans node `cur`, a read of binding `d` at `path` that may be any literal in `cv`, used by its
// parent `p`: a binding, a whole `=` or a `return` whose own reads are planned, a null test, a
// `for … in` over lists whose elements all name one generic or over lists of lists, or a spread of
// one list literal.
function monoFlowContainerUse(
  d: i32,
  p: i32,
  cur: i32,
  cv: i32[],
  path: string[],
  reads: i32[],
  loops: i32[],
  spreads: i32[],
): boolean {
  monoFlowAliasUse(p, cur)
    || (path.length == 0 && monoFlowRetUse(p, cur))
    || monoFlowArgUse(p, cur)
    || monoFlowBinUse(p, cur)
    || monoFlowLoopUse(d, p, cur, cv, path, loops)
    || monoFlowRowLoopUse(d, p, cur, cv, path, reads, loops, spreads)
    || monoFlowSpreadUse(p, cv, spreads)
}

// Whether `p` returns `cur`, a binding local to the function, whole from a function whose
// returned literals are known (D9763).
function monoFlowRetUse(p: i32, cur: i32): boolean {
  const pn = nodeAt(p)
  if !(pn is RetStmt) || pn.retArg != cur { return false }
  const f = monoFlowEnclosingFn(p)
  if f < 0 { return false }
  const scratch: i32[] = []
  monoFlowRetLocalLists(f, cur, scratch) && monoFlowDeclVals(f).length > 0
}

// The function declaration enclosing node `x`; -1 at the top level.
function monoFlowEnclosingFn(x: i32): i32 {
  let f = mfrParentOf(x)
  while f >= 0 && !(nodeAt(f) is FuncDecl) { f = mfrParentOf(f) }
  f
}

// Appends to `out` the literals binding `a` names, when it is declared inside function `f` and
// every literal it holds is a list literal; false otherwise. A module binding returned whole is
// left to the plans that read it elsewhere (D6700).
function monoFlowRetLocalLists(f: i32, a: i32, out: i32[]): boolean {
  if a < 0 || !(nodeAt(a) is Ident) { return false }
  const d = identDeclOf(a)
  if d < 0 || monoFlowEnclosingFn(d) != f { return false }
  const vals: i32[] = []
  if !monoFlowValsOf(a, vals) { return false }
  for v in vals {
    if !(nodeAt(v) is ArrayLit) { return false }
  }
  for v in vals { out.push(v) }
  true
}

// Whether `p` is a `for … in` over `cur` whose lists in `cv` each hold only list literals, and
// each read of its row is planned as a read of `d` at `path` and `e` (D9760).
function monoFlowRowLoopUse(
  d: i32,
  p: i32,
  cur: i32,
  cv: i32[],
  path: string[],
  reads: i32[],
  loops: i32[],
  spreads: i32[],
): boolean {
  const pn = nodeAt(p)
  if !(pn is ForIn) || pn.fiIter != cur || pn.fiVar2 != "" { return false }
  const rows: i32[] = []
  for v in cv {
    const vn = nodeAt(v)
    if !(vn is ArrayLit) || monoFlowListGrows(v, 0) { return false }
    for e in vn.arrElems {
      const ex = unwrapParen(e)
      if ex < 0 || !(nodeAt(ex) is ArrayLit) { return false }
      rows.push(ex)
    }
  }
  if rows.length == 0 { return false }
  const ep: string[] = []
  for k in path { ep.push(k) }
  ep.push("e")
  for w in mfrUses[pn.fiDecl1] ?? [] {
    if monoFlowIsWrite(w) { return false }
    if !monoFlowUsePlanAt(d, w, rows, ep, reads, loops, spreads) {
      return false
    }
  }
  true
}

// Whether `p` is a candidate binding initialized by `cur` whose literals are known.
function monoFlowAliasUse(p: i32, cur: i32): boolean {
  const pn = nodeAt(p)
  if !(pn is LetDecl) { return false }
  pn.letInit == cur && (mfrCand[p] ?? false) && monoFlowDeclVals(p).length > 0
}

// Whether `p` calls a function passing `cur` to a candidate parameter whose literals are known.
function monoFlowArgUse(p: i32, cur: i32): boolean {
  const pn = nodeAt(p)
  if !(pn is Call) || pn.callFn == cur { return false }
  const c = unwrapParen(pn.callFn)
  if c < 0 || !(nodeAt(c) is Ident) { return false }
  const fd = identDeclOf(c)
  if fd < 0 { return false }
  const fn = nodeAt(fd)
  if !(fn is FuncDecl) { return false }
  let i = 0
  while i < pn.callArgs.length && i < fn.fnParams.length {
    if pn.callArgs[i] == cur {
      const d = fn.fnParams[i]
      return (mfrCand[d] ?? false) && monoFlowDeclVals(d).length > 0
    }
    i = i + 1
  }
  false
}

// Whether `p` writes `cur` whole into a candidate binding whose literals are known, or compares
// `cur` against `null`.
function monoFlowBinUse(p: i32, cur: i32): boolean {
  const pn = nodeAt(p)
  if !(pn is BinExpr) { return false }
  if pn.binOp == "=" && pn.binRight == cur {
    const l = unwrapParen(pn.binLeft)
    if l < 0 || !(nodeAt(l) is Ident) { return false }
    const ld = identDeclOf(l)
    return ld >= 0 && (mfrCand[ld] ?? false) && monoFlowDeclVals(ld).length > 0
  }
  if pn.binOp == "==" || pn.binOp == "!=" {
    const o = if pn.binLeft == cur { pn.binRight } else { pn.binLeft }
    return nodeAt(unwrapParen(o)) is NullLit
  }
  false
}

// Whether `p` is a `for … in` over `cur` whose lists in `cv` all hold one generic that the slot
// of `d` at `path` holds alone; appends `[loop, gen]` to `loops` when so.
function monoFlowLoopUse(
  d: i32,
  p: i32,
  cur: i32,
  cv: i32[],
  path: string[],
  loops: i32[],
): boolean {
  const pn = nodeAt(p)
  if !(pn is ForIn) { return false }
  if pn.fiIter != cur || pn.fiVar2 != "" { return false }
  let g = -1
  for v in cv {
    const vg = monoFlowElemsGen(v)
    if vg < 0 || (g >= 0 && vg != g) { return false }
    g = vg
  }
  const ep: string[] = []
  for k in path { ep.push(k) }
  ep.push("e")
  if !monoFlowSrcIs(d, ep, g) { return false }
  loops.push(p)
  loops.push(g)
  true
}

// Whether `p` spreads the one list literal in `cv`, each element naming a generic, into a list
// literal; appends `[spread, list]` to `spreads` when so.
function monoFlowSpreadUse(p: i32, cv: i32[], spreads: i32[]): boolean {
  if !(nodeAt(p) is Spread) || cv.length != 1 { return false }
  if monoFlowListGrows(cv[0], 0) {
    // A pushed list is not expanded: the host's reads name its one generic (D9482).
    const hx = mfrParentOf(p)
    if hx < 0 || !(nodeAt(hx) is ArrayLit) { return false }
    return monoFlowPushedSpreadSrc(p) == cv[0] && monoFlowElemsGen(cv[0]) >= 0
  }
  const host = mfrParentOf(p)
  const vn = nodeAt(cv[0])
  if host < 0 || !(nodeAt(host) is ArrayLit) || !(vn is ArrayLit) {
    return false
  }
  for e in vn.arrElems {
    if monoFlowLeafGen(unwrapParen(e)) < 0 { return false }
  }
  spreads.push(p)
  spreads.push(cv[0])
  true
}

// The element of list literal `v` the literal index `k` reads, -1 when `v` is no list literal
// free of spreads or `k` is not a literal index inside it.
function monoFlowElemAt(v: i32, k: i32): i32 {
  const ln = nodeAt(v)
  const kn = nodeAt(k)
  if !(ln is ArrayLit) || !(kn is NumLit) { return -1 }
  // A holder of a tagged set's ids is read by its call's member arms, never resolved here.
  if fnTagHoldsTy(nodeTyIxOf(v), 4) { return -1 }
  for e in ln.arrElems {
    if nodeAt(e) is Spread { return -1 }
  }
  const at = monoListLitIndex(kn.numText, ln.arrElems.length)
  if at < 0 { return -1 }
  unwrapParen(ln.arrElems[at])
}

// The value record literal `v` gives field `name`, -1 when `v` is no record literal free of
// spreads or holds no such field.
function monoFlowFieldOf(v: i32, name: string): i32 {
  const on = nodeAt(v)
  if !(on is ObjLit) { return -1 }
  if fnTagHoldsTy(nodeTyIxOf(v), 4) { return -1 }
  let out = -1
  for fi in on.objFields {
    const f = nodeAt(fi)
    if f is FieldInit {
      if f.fiName == name { out = unwrapParen(f.fiValue) }
    } else {
      return -1
    }
  }
  out
}

// The one generic every element of list literal `v` names, -1 when they differ or any does not.
// Values its owner pushes count as elements.
function monoFlowElemsGen(v: i32): i32 {
  const ln = nodeAt(v)
  if !(ln is ArrayLit) { return -1 }
  const es = monoFlowElemLeaves(v, 0)
  if es.length == 0 { return -1 }
  let g = -1
  for e in es {
    const eg = monoFlowLeafGen(e)
    if eg < 0 || (g >= 0 && eg != g) { return -1 }
    g = eg
  }
  g
}

// The values list literal `v` holds: its elements, the values its owner pushes or writes, and in place of a
// spread of a pushed list (`monoFlowPushedSpreadSrc`) that list's own values (D9482).
function monoFlowElemLeaves(v: i32, depth: i32): i32[] {
  const out: i32[] = []
  const ln = nodeAt(v)
  if !(ln is ArrayLit) || depth > 8 { return out }
  for e in ln.arrElems {
    const x = unwrapParen(e)
    const sv = monoFlowPushedSpreadSrc(x)
    if sv >= 0 {
      for y in monoFlowElemLeaves(sv, depth + 1) { out.push(y) }
    } else {
      out.push(x)
    }
  }
  const pushes: i32[] = []
  if !monoFlowListWritten(v, out, pushes) { return [] }
  out
}

// The list literal spread `x` expands when that list grows (`monoFlowListGrows`), so its length
// is known only when it runs; -1 for any other node. Each such pair is noted in `mfrTied`.
function monoFlowPushedSpreadSrc(x: i32): i32 { monoFlowGrownSpreadSrc(x, 0) }

// Whether list literal `v`'s owner pushes into it or it spreads such a list.
function monoFlowListGrows(v: i32, depth: i32): boolean {
  const ln = nodeAt(v)
  if !(ln is ArrayLit) || depth > 8 { return false }
  const written: i32[] = []
  const pushes: i32[] = []
  if !monoFlowListWritten(v, written, pushes) || pushes.length > 0 {
    return true
  }
  for e in ln.arrElems {
    if monoFlowGrownSpreadSrc(unwrapParen(e), depth + 1) >= 0 { return true }
  }
  false
}

// `monoFlowPushedSpreadSrc` at nesting `depth`.
function monoFlowGrownSpreadSrc(x: i32, depth: i32): i32 {
  if x < 0 { return -1 }
  const sn = nodeAt(x)
  if !(sn is Spread) { return -1 }
  const a = unwrapParen(sn.spdArg)
  if a < 0 || !(nodeAt(a) is Ident) { return -1 }
  const d = identDeclOf(a)
  if d < 0 || !(mfrCand[d] ?? false) { return -1 }
  const vs = monoFlowDeclVals(d)
  if vs.length != 1 || monoFlowListOwner(vs[0]) != d { return -1 }
  if !monoFlowListGrows(vs[0], depth) { return -1 }
  monoFlowTie(monoFlowLitRoot(vs[0]), monoFlowLitRoot(x), true)
  vs[0]
}

// Notes roots `a` and `b` in `mfrTied`, once; `copy` when `b` is a list a spread copies `a` into.
function monoFlowTie(a: i32, b: i32, copy: boolean) {
  let i = 0
  while i + 1 < mfrTied.length {
    if mfrTied[i] == a && mfrTied[i + 1] == b { return 0 }
    i = i + 2
  }
  if copy { mfrTiedCopy[mfrTied.length] = true }
  mfrTied.push(a)
  mfrTied.push(b)
  0
}

// The un-annotated `const`, or `let` never assigned whole, that list literal `v` initializes; -1
// otherwise.
function monoFlowListOwner(v: i32): i32 {
  if v < 0 || v >= P.nodes.length || !(nodeAt(v) is ArrayLit) { return -1 }
  let p = mfrParentOf(v)
  while p >= 0 && nodeAt(p) is Paren { p = mfrParentOf(p) }
  if p < 0 { return -1 }
  const d = nodeAt(p)
  if !(d is LetDecl) || d.letType >= 0 { return -1 }
  if unwrapParen(d.letInit) != v { return -1 }
  if d.letKw != "const" {
    for u in mfrUses[p] ?? [] {
      if monoFlowWholeWrite(u) >= 0 { return -1 }
    }
  }
  p
}

// The value a one-argument `x.push(…)` on read `x` appends; -1 otherwise.
function monoFlowPushOf(x: i32): i32 {
  const q = mfrParentOf(x)
  if q < 0 { return -1 }
  const qn = nodeAt(q)
  if !(qn is Member) || qn.memObj != x || qn.memProp != "push" { return -1 }
  const w = mfrParentOf(q)
  if w < 0 { return -1 }
  const wn = nodeAt(w)
  if !(wn is Call) || wn.callFn != q || hasNamedArgs(wn.callArgNames) {
    return -1
  }
  if wn.callArgs.length != 1 || nodeAt(wn.callArgs[0]) is Spread { return -1 }
  wn.callArgs[0]
}

// The owner `d` of a list literal and each un-annotated `const` naming it whole, directly or
// through another such `const`, which hold the same list (D10341).
function monoFlowListNames(d: i32): i32[] {
  const out: i32[] = [d]
  let i = 0
  while i < out.length && out.length <= MONO_ALIAS_CHAIN_MAX {
    for u in mfrUses[out[i]] ?? [] {
      let p = mfrParentOf(u)
      while p >= 0 && nodeAt(p) is Paren { p = mfrParentOf(p) }
      if p >= 0 && !i32ListHas(out, p) {
        const pn = nodeAt(p)
        if pn is LetDecl && pn.letKw == "const" && pn.letType < 0 {
          if unwrapParen(pn.letInit) == u { out.push(p) }
        }
      }
    }
    i = i + 1
  }
  out
}

// Every value written into list literal `v`'s element slot after its literal, onto `out`, with
// each `.push` argument onto `pushes` too (`cwSlotWrittenAfter` on its owner); false when the write
// index cannot answer. A literal with no owner is written nowhere.
function monoFlowListWritten(v: i32, out: i32[], pushes: i32[]): boolean {
  const d = monoFlowListOwner(v)
  if d < 0 { return true }
  const vals: i32[] = []
  const ats: i32[] = []
  if !cwSlotWrittenAfter(cwKeyOfDecl(d), ["[]"], vals, ats) { return false }
  let i = 0
  while i < vals.length {
    const x = unwrapParen(vals[i])
    out.push(x)
    let c = mfrParentOf(vals[i])
    while c >= 0 && nodeAt(c) is Paren { c = mfrParentOf(c) }
    const cn = if c >= 0 { nodeAt(c) } else { null }
    const f = if cn is Call { nodeAt(unwrapParen(cn.callFn)) } else { null }
    if f is Member && f.memProp == "push" { pushes.push(x) }
    i = i + 1
  }
  true
}

// The value a plain `=` stores into an element of read `x`, as `x[k] = v`; -1 otherwise.
function monoFlowElemWriteOf(x: i32): i32 {
  const q = mfrParentOf(x)
  if q < 0 { return -1 }
  const qn = nodeAt(q)
  if !(qn is Index) || qn.idxArr != x { return -1 }
  const w = mfrParentOf(q)
  if w < 0 { return -1 }
  const wn = nodeAt(w)
  if !(wn is BinExpr) || wn.binOp != "=" || wn.binLeft != q { return -1 }
  wn.binRight
}

// Whether node `x` is the target of an assignment, plain or compound.
function monoFlowIsWrite(x: i32): boolean {
  const p = mfrParentOf(x)
  if p < 0 { return false }
  const pn = nodeAt(p)
  if pn is BinExpr {
    if pn.binLeft != x { return false }
    const op = pn.binOp
    if op == "==" || op == "!=" || op == "<=" || op == ">=" { return false }
    return op.length > 0 && op.slice(op.length - 1, op.length) == "="
  }
  pn is Unary && (pn.unOp == "++" || pn.unOp == "--")
}

// Whether node `x` lies in the body of the function declaring generic `g`, or `g` is declared at
// module scope: where the name `g` declares is in scope.
function monoFlowInScope(x: i32, g: i32): boolean {
  let o = mfrParentOf(g)
  while o >= 0 && !(nodeAt(o) is FuncDecl) { o = mfrParentOf(o) }
  if o < 0 { return true }
  let y = mfrParentOf(x)
  while y >= 0 && y != o { y = mfrParentOf(y) }
  y == o
}

// The element of list literal `v` that computed-index read `ix` gives, when the read's type names
// one generic function (`elabFnSetOf`) and `ix` is the callee of a call `monoFlowCallStmtOf`
// places, so a copy of the read can run first for its index and its bounds check (D7182); -1
// otherwise.
function monoFlowKeptIndexElem(v: i32, ix: i32): i32 {
  if v < 0 || ix < 0 { return -1 }
  const xn = nodeAt(ix)
  if !(xn is Index) { return -1 }
  const ln = nodeAt(v)
  if !(ln is ArrayLit) { return -1 }
  // A literal index past a literal's elements reads what a push appended (D9441), or what a
  // spread of a pushed list holds (D9482). A spread of any other list is expanded first.
  if !monoFlowListGrows(v, 0) && nodeAt(unwrapParen(xn.idxIndex)) is NumLit {
    return -1
  }
  const leaves = monoFlowElemLeaves(v, 0)
  const held = elabFnSetOf(nodeTyIxOf(ix))
  if held.length != 1 || !monoIsGenericDecl(held[0]) || leaves.length == 0 {
    return -1
  }
  if monoFlowCallStmtOf(ix) < 0 { return -1 }
  if !i32ListHas(mfrKeptIndex, ix) { mfrKeptIndex.push(ix) }
  leaves[0]
}

// Pushes onto `out` every row list literal `v` holds, for computed-index read `ix` of it that is
// no write; false, pushing nothing, when `v` is no list literal or any value it holds is no list.
function monoFlowRowLeaves(v: i32, ix: i32, out: i32[]): boolean {
  const xn = nodeAt(ix)
  if !(xn is Index) || !(nodeAt(v) is ArrayLit) || monoFlowIsWrite(ix) {
    return false
  }
  if nodeAt(unwrapParen(xn.idxIndex)) is NumLit { return false }
  const leaves = monoFlowElemLeaves(v, 0)
  if leaves.length == 0 { return false }
  for e in leaves {
    if !(nodeAt(e) is ArrayLit) { return false }
  }
  for e in leaves { out.push(e) }
  true
}

// The statement holding the call whose callee is read `ix`, when nothing in that statement runs
// before the call but reads of names and literals, so a copy of the read can run as the
// statement before it (D7385); -1 otherwise. A block's or the start function's statement.
function monoFlowCallStmtOf(ix: i32): i32 {
  let c = mfrParentOf(ix)
  while c >= 0 && nodeAt(c) is Paren { c = mfrParentOf(c) }
  if c < 0 { return -1 }
  const cn = nodeAt(c)
  if !(cn is Call) || unwrapParen(cn.callFn) != ix { return -1 }
  let x = c
  while monoFlowPosIn(monoFlowStmtListOf(x), x) < 0 {
    const p = mfrParentOf(x)
    // A module global's initializer runs in the start function at its declaration (D9483).
    if p < 0 && monoFlowPosIn(globalStmts, x) >= 0 { return x }
    if p < 0 || !monoFlowRunsFirstIn(p, x) { return -1 }
    x = p
  }
  x
}

// Whether child `x` of node `p` is evaluated, every time `p` is, after only `monoFlowInert`
// operands of `p`.
function monoFlowRunsFirstIn(p: i32, x: i32): boolean {
  const pn = nodeAt(p)
  if pn is Paren { return true }
  if pn is LetDecl { return pn.letInit == x }
  if pn is RetStmt { return pn.retArg == x }
  if pn is IfStmt { return pn.ifCond == x }
  if pn is Unary { return pn.unArg == x }
  if pn is Member { return pn.memObj == x }
  if pn is BinExpr {
    if pn.binLeft == x { return true }
    const op = pn.binOp
    if op == "&&" || op == "||" || op == "??" { return false }
    return pn.binRight == x && monoFlowInert(pn.binLeft, 0)
  }
  monoFlowArgRunsFirst(p, x)
}

// `monoFlowRunsFirstIn` for the one parent kind left, a call `p` with `x` among its arguments;
// false for every other parent, whose operands are not all known to run before `x`.
function monoFlowArgRunsFirst(p: i32, x: i32): boolean {
  const pn = nodeAt(p)
  if !(pn is Call) { return false }
  if hasNamedArgs(pn.callArgNames) || !monoFlowInert(pn.callFn, 0) {
    return false
  }
  for a in pn.callArgs {
    if a == x { return true }
    if !monoFlowInert(a, 0) { return false }
  }
  false
}

// Whether evaluating `e` writes nothing and calls only generics whose bodies write and call
// nothing, so a read run ahead of it is observed only by which trap fires first (D10342).
function monoFlowInert(e: i32, depth: i32): boolean {
  const x = unwrapParen(e)
  if x < 0 || depth > 8 { return false }
  const n = nodeAt(x)
  if n is Member { return monoFlowInert(n.memObj, depth + 1) }
  if n is BinExpr && n.binOp != "=" {
    return monoFlowInert(n.binLeft, depth + 1)
      && monoFlowInert(n.binRight, depth + 1)
  }
  if !(n is Call) { return exprEffectFree(x) }
  if hasNamedArgs(n.callArgNames) { return false }
  const c = unwrapParen(n.callFn)
  if c < 0 || !exprEffectFree(c) { return false }
  let g = monoFlowLeafGen(c)
  const cn = nodeAt(c)
  if cn is Index {
    const a = unwrapParen(cn.idxArr)
    const ad = if a >= 0 && nodeAt(a) is Ident { identDeclOf(a) } else { -1 }
    if ad >= 0 {
      const vs = monoFlowDeclVals(ad)
      if vs.length == 1 { g = monoFlowElemsGen(vs[0]) }
    }
  }
  if g < 0 { return false }
  const fd = nodeAt(g)
  if !(fd is FuncDecl) || fd.fnBody < 0 { return false }
  const body = nodeAt(fd.fnBody)
  if !(body is Block) { return false }
  for s in body.blkStmts {
    if !exprEffectFree(s) { return false }
  }
  for a in n.callArgs {
    if !monoFlowInert(a, depth + 1) { return false }
  }
  true
}

// The statement list a statement `c` would sit in: its block's, or at module scope the start
// function's `startStmts`, whose ordinals are source positions, so the program's own list is
// left alone; empty when the parent is neither.
function monoFlowStmtListOf(c: i32): i32[] {
  const o = mfrParentOf(c)
  if o < 0 { return startStmts }
  const on = nodeAt(o)
  if !(on is Block) { return [] }
  on.blkStmts
}

// The position of `c` in `xs`, or -1.
function monoFlowPosIn(xs: i32[], c: i32): i32 {
  let at = xs.length - 1
  while at >= 0 && xs[at] != c { at = at - 1 }
  at
}

// Runs a copy of computed-index read `x` as the statement before the one holding its call;
// false when `monoFlowCallStmtOf` finds none. A module-scope copy is walked from `mfrKeptTop`.
function monoFlowKeepIndex(x: i32): boolean {
  const c = monoFlowCallStmtOf(x)
  if c < 0 { return false }
  const xn = nodeAt(x)
  if !(xn is Index) { return false }
  const gat = monoFlowPosIn(globalStmts, c)
  if gat >= 0 && (mfrParentOf(c)) < 0 {
    // Before a global's initializer: a start statement ordered just before its position.
    const ord = globalStmtOrd[gat] - 1
    let si = 0
    while si < startStmtOrd.length && startStmtOrd[si] <= ord { si = si + 1 }
    const gk = mkIndex(xn.idxArr, xn.idxIndex, xn.pos)
    if si < startStmts.length {
      monoFlowInsertAt(startStmts, si, gk)
      monoFlowInsertAt(startStmtOrd, si, ord)
    } else {
      startStmts.push(gk)
      startStmtOrd.push(ord)
    }
    mfrKeptTop.push(gk)
    return true
  }
  const xs = monoFlowStmtListOf(c)
  const at = monoFlowPosIn(xs, c)
  if at < 0 { return false }
  const kept = mkIndex(xn.idxArr, xn.idxIndex, xn.pos)
  monoFlowInsertAt(xs, at, kept)
  if (mfrParentOf(c)) < 0 {
    monoFlowInsertAt(startStmtOrd, at, startStmtOrd[at])
    mfrKeptTop.push(kept)
  }
  true
}

// Inserts `v` into `xs` in place at position `at`, which is in range.
function monoFlowInsertAt(xs: i32[], at: i32, v: i32) {
  xs.push(xs[xs.length - 1])
  let k = xs.length - 2
  while k > at {
    xs[k] = xs[k - 1]
    k = k - 1
  }
  xs[at] = v
}

// Rewrites read node `x` in place to a name read of generic `g`, where the elaboration names `g` and
// that name is in scope; false when either fails.
function monoFlowReadSet(x: i32, g: i32): boolean {
  const call = if monoFlowCalledAt(x) { mfrParentOf(x) } else { -1 }
  if repShadowOn { mfrShadowNote(x, g, call) }
  // The generic is the elaboration's; the walkers that chose `g` only gate which reads are asked.
  if !mfrElabNames(x, g, call) { return false }
  // A read of a tagged set is its member id, which no name read can carry.
  if fnTagTyIsTagged(nodeTyIxOf(x)) { return false }
  const nm = monoFlowLeafName(g)
  if nm == "" || !monoFlowInScope(x, g) { return false }
  if i32ListHas(mfrKeptIndex, x) && !monoFlowKeepIndex(x) { return false }
  // A read of a hole list parameter handed on uncalled keeps the element its caller's literal
  // instanced: a name read carries no instance, so it would hand on the generic's first (D15611).
  const xi = nodeAt(x)
  if xi is Index && !monoFlowCalledAt(x) {
    const bd = identDeclOf(unwrapParen(xi.idxArr))
    const bn = if bd >= 0 && bd < P.nodes.length { nodeAt(bd) } else { null }
    if bn is Param && bn.parType < 0 { return false }
  }
  const n: Node = { identName: nm, pos: nodePos(x) }
  const called = monoFlowCalledAt(x)
  const used = called || monoFlowHandedNarrowed(x)
  arenaSetNode(x, n)
  sidNoteNodeName(x, g)
  if used && !i32ListHas(mfrCalled, g) { mfrCalled.push(g) }
  if called { mfrSetCalls.push(mfrParentOf(x)) }
  mfrRepointed.push(x)
  if called { mfrRepointed.push(mfrParentOf(x)) }
  monoFlowAliasCallsSet(x, g)
  true
}

// Rewrites to generic `g` each call of the un-annotated binding that rewritten read `x` wholly
// initializes, when every use of it is such a call, so it is never written: its checked type is
// the slot's, not the generic's, so each call names `g` and `x` is noted inert (D9901).
function monoFlowAliasCallsSet(x: i32, g: i32) {
  let p = mfrParentOf(x)
  while p >= 0 && nodeAt(p) is Paren { p = mfrParentOf(p) }
  if p < 0 { return 0 }
  const pn = nodeAt(p)
  if !(pn is LetDecl) || pn.letType >= 0 { return 0 }
  if unwrapParen(pn.letInit) != x { return 0 }
  const calls: i32[] = []
  for r in mfrUses[p] ?? [] {
    if !monoFlowCallReads(r, calls, 1) { return 0 }
  }
  if calls.length == 0 { return 0 }
  for u in calls {
    if !monoFlowInScope(u, g) { return 0 }
  }
  for u in calls { monoFlowReadSet(u, g) }
  monoFlowNoteInertLeaf(x)
  0
}

// Notes as inert each name of a generic in the literals the clean bindings of `planned` hold,
// unless a binding in `through` holds the same literal tree or it is a root in `copied`: every
// read of the rest now names the generic itself, so no call reaches one of those names (D6661).
function monoFlowNoteInert(planned: i32[], through: i32[], copied: i32[]) {
  const kept: i32[] = []
  for r in copied { kept.push(r) }
  for d in through {
    for v in mfrPlannedRoots[d] ?? [] { kept.push(monoFlowLitRoot(v)) }
  }
  for d in planned {
    if monoFlowDeclClean(d) {
      for v in mfrPlannedRoots[d] ?? [] {
        if !i32ListHas(kept, monoFlowLitRoot(v)) { monoFlowNoteInertIn(v, 0) }
      }
    }
  }
  0
}

// Whether read `u` is the callee of the call holding it.
function monoFlowCalledAt(u: i32): boolean {
  const c = mfrParentOf(u)
  if c < 0 { return false }
  const cn = nodeAt(c)
  cn is Call && unwrapParen(cn.callFn) == u
}

// Whether read `u` is an argument of the call holding it, typed a function its null test narrowed.
function monoFlowHandedNarrowed(u: i32): boolean {
  const c = mfrParentOf(u)
  if c < 0 { return false }
  const cn = nodeAt(c)
  const t = nodeTyIxOf(u)
  cn is Call
    && i32ListHas(cn.callArgs, u)
    && t >= 0
    && t < T.tys.length
    && tyAt(t) is TyFunc
}

// Whether generic `g` is called by name, as written or through a rewritten read: an uncalled
// one has only its default body, which need not be valid (D6660).
function monoFlowGenCalled(g: i32): boolean {
  if i32ListHas(mfrCalled, g) { return true }
  for u in mfrUses[g] ?? [] {
    if monoFlowCalledAt(u) { return true }
  }
  false
}

// Notes each element or field of a literal `v`, or value a map `v` holds, through nested literals,
// that names a called generic.
function monoFlowNoteInertIn(v: i32, depth: i32) {
  const x = unwrapParen(v)
  if x < 0 || depth > 8 { return 0 }
  const n = nodeAt(x)
  if monoFlowMapOwner(x) >= 0 {
    const held: i32[] = []
    if monoFlowMapVals(x, held) {
      for h in held { monoFlowNoteInertIn(h, depth + 1) }
    }
    return 0
  }
  if n is ArrayLit {
    for e in n.arrElems { monoFlowNoteInertIn(e, depth + 1) }
    const written: i32[] = []
    const pushes: i32[] = []
    monoFlowListWritten(x, written, pushes)
    for e in written { monoFlowNoteInertIn(e, depth + 1) }
    return 0
  }
  if n is ObjLit {
    for fi in n.objFields {
      const f = nodeAt(fi)
      if f is FieldInit { monoFlowNoteInertIn(f.fiValue, depth + 1) }
    }
    return 0
  }
  monoFlowNoteInertLeaf(x)
}

// Notes value `x` inert when it names a called generic; any other value is left as it is.
function monoFlowNoteInertLeaf(x: i32) {
  // A call written as the element still runs; what it returns is a value nothing calls (D9592).
  if nodeAt(x) is Call {
    const cg = monoFlowCallLeaf(x)
    if cg >= 0 && monoFlowGenCalled(cg) { monoFlowNoteCallRets(x) }
    return 0
  }
  if !(nodeAt(x) is Ident) { return 0 }
  const g = monoFlowLeafGen(x)
  if g >= 0 && monoFlowGenCalled(g) && !i32ListHas(monoInertCalled, x) {
    if !i32ListHas(mfrInertValues, x) { mfrInertValues.push(x) }
    monoInertCalled.push(x)
    monoFlowNoteInertRets(x)
  }
  0
}

// Notes inert each `return` operand of the function whose one call initializes the `const` chain
// read `x` names (`monoFlowCallLeaf`), each link read once, so `x` is all that reads the result
// (D9481).
function monoFlowNoteInertRets(x: i32) {
  let r = x
  let hops = 0
  while hops <= MONO_ALIAS_CHAIN_MAX {
    if !(nodeAt(r) is Ident) { return 0 }
    const d = identDeclOf(r)
    if d < 0 { return 0 }
    const dn = nodeAt(d)
    if !(dn is LetDecl) || dn.letKw != "const" || dn.letType >= 0 { return 0 }
    if (mfrUses[d] ?? []).length != 1 { return 0 }
    r = unwrapParen(dn.letInit)
    if r < 0 { return 0 }
    if nodeAt(r) is Call { return monoFlowNoteCallRets(r) }
    hops = hops + 1
  }
  0
}

// Notes inert each `return` operand of the function call `r` runs, when it always returns one
// generic (`monoFlowCallLeaf`) and nothing else calls that function.
function monoFlowNoteCallRets(r: i32) {
  const rn = nodeAt(r)
  if !(rn is Call) || monoFlowCallLeaf(r) < 0 { return 0 }
  const fd = identDeclOf(unwrapParen(rn.callFn))
  if fd < 0 || fd >= P.nodes.length { return 0 }
  if (mfrUses[fd] ?? []).length != 1 { return 0 }
  const fnd = nodeAt(fd)
  if !(fnd is FuncDecl) { return 0 }
  for a in monoFlowRetOperands(fnd.fnBody) {
    if !i32ListHas(mfrInertValues, a) { mfrInertValues.push(a) }
    if !i32ListHas(monoInertCalled, a) { monoInertCalled.push(a) }
    // A returned call's own returns are what reaches the caller (D10381).
    if nodeAt(a) is Call { monoFlowNoteCallRets(a) }
  }
  0
}

// Rewrites each read of loop `fl`'s binding to generic `g`, unless a read writes it; false when
// a read is left reading the loop's element.
function monoFlowLoopSet(fl: i32, g: i32): boolean {
  const fln = nodeAt(fl)
  if !(fln is ForIn) { return false }
  const us = mfrUses[fln.fiDecl1] ?? []
  for u in us {
    if monoFlowIsWrite(u) { return false }
  }
  let all = true
  for u in us {
    if !monoFlowReadSet(u, g) { all = false }
  }
  all
}

// Replaces spread `sp` in its host list literal by one name read per element of list literal
// `v`, each naming the generic that element names; the host, or -1 when it is left alone.
function monoFlowSpreadSet(sp: i32, v: i32): i32 {
  const hx = mfrParentOf(sp)
  if hx < 0 || v < 0 { return -1 }
  const host = nodeAt(hx)
  const src = nodeAt(v)
  if !(host is ArrayLit) || !(src is ArrayLit) { return -1 }
  for se in src.arrElems {
    const g = monoFlowLeafGen(unwrapParen(se))
    if g >= 0 && !monoFlowInScope(sp, g) { return -1 }
  }
  const out: i32[] = []
  for e in host.arrElems {
    if e == sp {
      for se in src.arrElems {
        const x = unwrapParen(se)
        const g = monoFlowLeafGen(x)
        if g >= 0 {
          const gnm = monoFlowLeafName(g)
          if gnm != "" {
            const nx = mkIdent(gnm, nodePos(sp))
            sidNoteNodeName(nx, g)
            nodeTyRecord(nx, nodeTyIxOf(x))
            sidArrPut(mfrParent, nx, hx)
            out.push(nx)
          }
        }
      }
    } else {
      out.push(e)
    }
  }
  host.arrElems = out
  hx
}

// Gives the un-annotated list at `at` in frame `ctx` the function type the flow table pins its
// element slot at, as an annotation; its elements, element writes and re-pointed list literals are
// instanced at it. Two pins refuse unless each read already points at one generic; no pin, a
// re-point to anything but a list literal, or a capture cell leaves the list alone.
function monoPinListElems(d: LetDecl, at: i32, ctx: i32): i32 {
  if (
    d.letInit < 0
    || monoGeneratedCellElem(d.letInit) >= 0
    || fnTagListTy(nodeTyIxOf(d.letInit))
    || fnTagListTy(elabNodeTyAt(d.letInit, ctx))
  ) {
    return 0
  }
  const lit = nodeAt(d.letInit)
  if !(lit is ArrayLit) { return 0 }
  const lf: i32[] = [ctx, at]
  const repoints = monoLetRepointLits(d, lf)
  if repoints.length == 1 && repoints[0] < 0 { return 0 }
  if monoPinListRecords(d, lf, repoints) < 0 { return -1 }
  // A list this instance closes needs no pin: the elaboration's type here, else the checker's.
  const rtE = elabNodeTyAt(d.letInit, ctx)
  const rt = if rtE >= 0 && rtE < T.tys.length && tyAt(rtE) is TyArray && !tyHasTyVar(rtE) { rtE } else { nodeTyIxOf(d.letInit) }
  if rt >= 0 && rt < T.tys.length && tyAt(rt) is TyArray && !tyHasTyVar(rt) {
    return 0
  }
  // A literal of maps takes the elaboration's closed slot fact, its open elements and the reads of
  // its maps' values typed at it, where nothing calls those values or each element names a map
  // already pinned at the fact's element.
  const ce = tyArrayElemIx(nodeTyIxOf(d.letInit))
  if (
    repoints.length == 0
    && ce >= 0
    && ce < T.tys.length
    && tyAt(ce) is TyMap
  ) {
    const lt = elabSlotTyAt(at, [], ctx)
    const et = tyArrayElemIx(lt)
    let spread = false
    let pinned = lit.arrElems.length > 0
    for e in lit.arrElems {
      if nodeAt(e) is Spread { spread = true }
      const bd = if nodeAt(e) is Ident { monoReadLetFrame(e, ctx)[1] } else { -1 }
      const b = if bd >= 0 { nodeAt(bd) } else { null }
      if (
        !(b is LetDecl)
        || b.letType < 0
        || !tySame(elabSlotTyAt(bd, [], ctx), et)
      ) {
        pinned = false
      }
    }
    if (
      (pinned || elabSlotUncalled(at, ["e", "v"]))
      && !spread
      && et >= 0
      && et < T.tys.length
      && tyAt(et) is TyMap
      && !monoTyOpen(lt)
    ) {
      d.letType = synthTypeRefOfTy(lt, -1)
      nodeTyRecord(d.letInit, lt)
      for e in lit.arrElems {
        if monoTyOpen(nodeTyIxOf(e)) { nodeTyRecord(e, et) }
      }
      if pinned { monoRetypeMapReads(ctx, at, et, tyMapValOf(et), "[]") }
      return 0
    }
  }
  if repoints.length == 0 {
    const nr = monoPinNestedListElems(d, lf, lit)
    if nr != 0 { return if nr < 0 { -1 } else { 0 } }
  }
  const path: string[] = ["e"]
  let pinFts: i32[] = []
  const rawPins = monoDeclPathKeys(lf, path, false, pinFts)
  let pins = rawPins
  let omit = false
  if pins.length > 1 {
    // Pushed functions whose every read now names its generic are called through no slot (D9441).
    const pushed = monoMethodStoredArgs(at, lf, "push", 1, "")
    if pushed.length > 0 {
      if elabSlotUncalledOmitting(at, path, mfrRepointed) {
        return monoUncalledListElems(d, at, lf, lit)
      }
    }
    if pushed.length == 0 && monoSpreadHostInert(at, lit) { return 0 }
    // A list read only by name and spread, whose spreads now hold its generic, shares the pins of
    // the lists that spread it but no call through its own slot (D9595).
    if i32ListHas(mfrSpreadDone, at) { return 0 }
    // Calls whose read the flow pass pointed at its generic go through no slot (D9595), and a
    // sliced list's copies reach its literal through the calls left (D10082).
    const liveFts: i32[] = []
    const live = monoFlowSlotPins(at, path, liveFts)
    const sliced = live.length > 0 && i32ListHas(mfrSliced, at)
    if !sliced && monoFlowHeldOneGen(at, path) { return 0 }
    if live.length != 1 { return monoGenericListFail(d.letInit) }
    pins = live
    pinFts = liveFts
    omit = true
  }
  if (
    pins.length == 0
    && repoints.length == 0
    && elabSlotUncalledOmitting(at, path, mfrRepointed)
  ) {
    return monoUncalledListElems(d, at, lf, lit)
  }
  if pins.length != 1 { return 0 }
  // A pin taken at this instance's own template is this instance's alone, and a generic's
  // instances share `d` (D9660): its elements are instanced here and its reads typed per
  // instance.
  const shared = monoFrameIsGenericInstance(ctx)
    && monoDeclPathPinsPerInstance(at, path)
  const ann = monoSigFnTyName(pins[0] + ";")
  const dTys: i32[] = []
  // Stores whose results at the pin disagree share no element rep.
  const pinFt = if pinFts.length == 1 { pinFts[0] } else { -1 }
  if !monoListStoresAgree(lit, repoints, at, pinFt) { return 0 }
  // The element type is the one the elaboration delivers the slot at, else its slot type here.
  let ft = monoSlotDeliveryTy(lf, path, omit)
  if ft < 0 {
    const st = elabSlotTyAt(at, path, ctx)
    if monoTyClosedFn(st) { ft = st }
  }
  // Elements agreeing on another result than the delivered one keep theirs, so a write of the
  // delivered type is refused where it is made.
  const elemVals: i32[][] = []
  for e in lit.arrElems { elemVals.push([e, ctx]) }
  const own = monoValsOwnFnTy(elemVals, pinFt)
  if ft >= 0 && own >= 0 && sigKeyOfTy(own) != sigKeyOfTy(ft) { ft = own }
  for e in lit.arrElems {
    monoLastInstFe = -1
    const holeLam = monoListElemHoleLamFe(e, ctx) >= 0
    if monoCoerceFnValueTys(e, ctx, -1, dTys, ft) < 0 { return -1 }
    if holeLam && monoLastInstFe < 0 {
      if monoNoteBindDeliveryAt(e, ann, ctx, ft) < 0 { return -1 }
    }
  }
  // An empty literal that `push` fills is instanced where its pushed functions are.
  if lit.arrElems.length == 0 && !shared {
    const pushed = monoMethodStoredArgs(at, lf, "push", 1, "")
    if pushed.length > 0 {
      const pt = monoStoredSlotFnTy(lf, path, pushed)
      if pt < 0 { return monoStoredSlotDecline(pt) }
      ft = pt
      monoRetypeMethodReads(ctx, at, "pop", mkNullableTy(ft))
    }
  }
  // A list the elaboration delivers at no one closed type, an open generic's, is left as checked.
  if !monoTyClosedFn(ft) { return 0 }
  const fty = tyAt(ft)
  if !(fty is TyFunc) { return 0 }
  if shared {
    monoRetypeSlotReads(ctx, at, "e", ft)
    return 0
  }
  // The pin's own parameter spelling, from which each instance is built, in the canonical
  // `(p)=>r` form a pin spelling is compared in (D6602).
  const lt = mkArrayTy(ft)
  d.letType = synthTypeRefOfTy(lt, -1)
  nodeTyRecord(d.letInit, lt)
  for e in lit.arrElems {
    const et = nodeTyIxOf(e)
    if et < 0 || tyHasTyVar(et) { nodeTyRecord(e, ft) }
  }
  let ri = 0
  while ri + 1 < repoints.length {
    const rl = nodeAt(repoints[ri])
    if rl is ArrayLit {
      nodeTyRecord(repoints[ri], lt)
      for e in rl.arrElems {
        if monoCoerceFnValueTys(e, repoints[ri + 1], -1, dTys, ft) < 0 {
          return -1
        }
        const et = nodeTyIxOf(e)
        if et < 0 || tyHasTyVar(et) { nodeTyRecord(e, ft) }
      }
    }
    ri = ri + 2
  }
  for w in monoWritesOf("e:", at) {
    const wb = nodeAt(w)
    const wf = monoLetWriteFrame(lf, w)
    if wb is BinExpr && wf.length == 1 {
      if monoPinWrittenLam(wb.binRight, wf[0], ft) < 0 { return -1 }
      if monoCoerceFnValueTys(wb.binRight, wf[0], -1, dTys, ft) < 0 {
        return -1
      }
    }
  }
  0
}

// Gives the un-annotated list `d` (`lf`) of list literals of functions, written nowhere, the
// function type the flow table pins the inner element at, as `monoPinListElems` does one level
// down (D9173): 1 when pinned, 0 when left alone, -1 when an instance is refused.
function monoPinNestedListElems(d: LetDecl, lf: i32[], lit: ArrayLit): i32 {
  const ctx = lf[0]
  const at = lf[1]
  if lit.arrElems.length == 0 || monoWritesOf("e:", at).length > 0 { return 0 }
  // A generic's instances share `d`, unless this instance took its own copy (D9662).
  if monoFrameIsGenericInstance(ctx) && !monoInstOwns(ctx, at) { return 0 }
  // Its elements reading bindings already pinned take their type, as inline literals would (D9661).
  const lits: i32[] = [d.letInit]
  const bt = monoBoundFnListElemsTy(lits, ctx)
  if bt >= 0 {
    const blt = mkArrayTy(bt)
    d.letType = synthTypeRefOfTy(blt, -1)
    nodeTyRecord(d.letInit, blt)
    return 1
  }
  const inner: i32[] = []
  const vals: i32[] = []
  for e in lit.arrElems {
    const x = unwrapParen(e)
    if x < 0 || x >= P.nodes.length { return 0 }
    const il = nodeAt(x)
    if !(il is ArrayLit) || il.arrElems.length == 0 { return 0 }
    inner.push(x)
    for v in il.arrElems { vals.push(v) }
  }
  const pins = monoDeclPathPins(lf, ["e", "e"])
  if pins.length != 1 {
    // A slot nothing calls, or one whose every read now names its generic (D9711), takes the
    // type its functions hold at no call, as the flat list does.
    const held: i32[][] = []
    for v in vals { held.push([v, ctx]) }
    if pins.length == 0 && !elabSlotUncalled(at, ["e", "e"]) { return 0 }
    if (
      pins.length > 1
      && !elabSlotUncalledOmitting(at, ["e", "e"], mfrRepointed)
    ) {
      return 0
    }
    // It is annotated at the type `monoUncalledSlotFnTy` gives the functions it holds.
    const uft = monoUncalledSlotFnTy(at, ["e", "e"], held)
    if uft < 0 { return 0 }
    const uit = mkArrayTy(uft)
    const ult = mkArrayTy(uit)
    d.letType = synthTypeRefOfTy(ult, -1)
    nodeTyRecord(d.letInit, ult)
    for x in inner { nodeTyRecord(x, uit) }
    for vw in held {
      if !monoTyClosedFn(nodeTyIxOf(vw[0])) { nodeTyRecord(vw[0], uft) }
    }
    return 1
  }
  const dTys: i32[] = []
  // The inner element's type is the elaboration's slot fact, at this frame's instance.
  const ft = elabSlotTyAt(at, ["e", "e"], ctx)
  if ft < 0 || ft >= T.tys.length || !monoTyClosedFn(ft) { return 0 }
  for v in vals {
    if monoCoerceFnValueTys(v, ctx, -1, dTys, ft) < 0 { return -1 }
  }
  const fty = tyAt(ft)
  if !(fty is TyFunc) { return 0 }
  const it = mkArrayTy(ft)
  const lt = mkArrayTy(it)
  d.letType = synthTypeRefOfTy(lt, -1)
  nodeTyRecord(d.letInit, lt)
  for x in inner { nodeTyRecord(x, it) }
  for v in vals {
    const et = nodeTyIxOf(v)
    if et < 0 || tyHasTyVar(et) { nodeTyRecord(v, ft) }
  }
  1
}

// Annotates the un-annotated list `d` (`lf`) of record literals, whose element the checker left
// open at a record of functions, with the type the elaboration gives it (`monoHeldRecordListAt`)
// over its elements, its `repoints` and its element writes (D9140); 0 left alone, -1 refused.
function monoPinListRecords(d: LetDecl, lf: i32[], repoints: i32[]): i32 {
  const stored: i32[][] = []
  for w in monoWritesOf("e:", lf[1]) {
    const wb = nodeAt(w)
    const wf = monoLetWriteFrame(lf, w)
    if wb is BinExpr && wf.length == 1 { stored.push([wb.binRight, wf[0]]) }
  }
  const nt = monoHeldRecordListAt(d.letInit, lf, repoints, stored)
  if nt == -2 { return -1 }
  if nt < 0 { return 0 }
  d.letType = synthTypeRefOfTy(nt, -1)
  monoRetypeMapReads(lf[0], lf[1], nt, tyArrayElemIx(nt), "")
  0
}

// The list type the record-list literal `lx` of frame `lf` is built at: the elaboration's slot
// fact for the elements of `lf`'s binding or result (`elabSlotTyAt`), or in a generic instance its
// stamp, recorded on `lx`, the re-pointed literals and `writes`' values. -1
// left alone, -2 refused. A binding and a function's result read it alike (D15294).
function monoHeldRecordListAt(
  lx: i32,
  lf: i32[],
  repoints: i32[],
  writes: i32[][],
): i32 {
  const ctx = lf[0]
  if lx < 0 || lx >= P.nodes.length { return -1 }
  const lit = nodeAt(lx)
  if !(lit is ArrayLit) || lit.arrElems.length == 0 { return -1 }
  const gen = ctx >= 0 && monoFrameIsGenericInstance(ctx)
  const et = tyArrayElemIx(nodeTyIxOf(lx))
  if et < 0 || et >= T.tys.length || !monoTyOpen(et) { return -1 }
  if !(tyAt(et) is TyObj) { return -1 }
  const stored: i32[][] = []
  for e in lit.arrElems { stored.push([e, ctx]) }
  let ri = 0
  while ri + 1 < repoints.length {
    const rl = nodeAt(repoints[ri])
    if rl is ArrayLit {
      for e in rl.arrElems { stored.push([e, repoints[ri + 1]]) }
    }
    ri = ri + 2
  }
  for w in writes { stored.push(w) }
  // A generic instance's literal reads the type its instance stamped; another frame's has none.
  if (
    gen
    && (repoints.length > 0 || writes.length > 0 || !monoNodeOwnedBy(lx, ctx))
  ) {
    return -1
  }
  const at = if gen { elabNodeRepAt(lx, ctx) } else { -1 }
  const nv = if gen {
    if at >= 0 && at < T.tys.length { tyArrayElemIx(at) } else { -1 }
  } else {
    elabSlotTyAt(lf[1], ["e"], ctx)
  }
  if !gen && nv >= 0 && !monoHeldReadsBuiltAt(stored, nv) { return -1 }
  if nv < 0 || nv == et || monoTyOpen(nv) { return -1 }
  if !tyIsEmitRepresentable(nv) { return -1 }
  const dTys: i32[] = []
  for st in stored {
    if monoHeldValueAt(st[0], nv, st[1], dTys, 0) < 0 { return -2 }
  }
  structTyMarkAliasable(nv)
  const nt = mkArrayTy(nv)
  nodeTyRecord(lx, nt)
  ri = 0
  while ri + 1 < repoints.length {
    nodeTyRecord(repoints[ri], nt)
    ri = ri + 2
  }
  nt
}

// Builds value `v`, written in frame `wf`, at the closed type `t` the elaboration gives its holder
// (`elabHeldClosedTy`): a literal records `t` and its parts theirs, a function is instanced at
// its signature or noted reached for its stub. -1 when an instance is refused.
function monoHeldValueAt(
  v: i32,
  t: i32,
  wf: i32,
  dTys: i32[],
  depth: i32,
): i32 {
  const x = unwrapParen(v)
  if x < 0 || x >= P.nodes.length || t < 0 || t >= T.tys.length || depth > 8 {
    return 0
  }
  const n = nodeAt(x)
  const tt = tyAt(t)
  if n is ObjLit && tt is TyObj {
    // A record re-typed here is built at its closed row, not at the one its open type keyed.
    if monoTyOpen(nodeTyIxOf(x)) {
      monoSupersededObjTys.push(nodeTyIxOf(x))
      monoGradualObjList.push(x)
    }
    monoRecordOpen(x, t, wf)
    for fx in n.objFields {
      const f = nodeAt(fx)
      if f is FieldInit {
        let k = 0
        while k < tt.objFieldNames.length {
          if tt.objFieldNames[k] == f.fiName {
            if (
              monoHeldValueAt(
                f.fiValue,
                tt.objFieldTypes[k],
                wf,
                dTys,
                depth + 1,
              )
              < 0
            ) {
              return -1
            }
          }
          k = k + 1
        }
      }
    }
    return 0
  }
  if n is ArrayLit && tt is TyArray {
    monoRecordOpen(x, t, wf)
    for e in n.arrElems {
      if monoHeldValueAt(e, tt.aElem, wf, dTys, depth + 1) < 0 { return -1 }
    }
    return 0
  }
  if tt is TyFunc && !monoTyClosedFn(nodeTyIxOf(x)) {
    if monoCoerceFnValueTys(x, wf, -1, dTys, t) < 0 { return -1 }
    if n is Ident {
      if !i32ListHas(monoHeldInert, x) { monoHeldInert.push(x) }
      monoReachNote(x, true)
    }
    monoRecordOpen(x, t, wf)
    return 0
  }
  // A read of another binding is built at the type that binding is built at.
  if !(tt is TyFunc) && n is Ident { monoClosedReadTy(x, wf, true) }
  0
}

// Whether each record literal of `stored` whose field reads another binding finds that binding built
// at the field's type in record type `t`, so the record and the binding it reads agree.
function monoHeldReadsBuiltAt(stored: i32[][], t: i32): boolean {
  const o = if t >= 0 && t < T.tys.length { tyAt(t) } else { null }
  if !(o is TyObj) { return true }
  for st in stored {
    const x = unwrapParen(st[0])
    const n = if x >= 0 && x < P.nodes.length { nodeAt(x) } else { null }
    if n is ObjLit {
      for fx in n.objFields {
        const f = nodeAt(fx)
        if f is FieldInit {
          const v = unwrapParen(f.fiValue)
          let i = 0
          while i < o.objFieldNames.length {
            const ft = o.objFieldTypes[i]
            if (
              o.objFieldNames[i] == f.fiName
              && v >= 0
              && nodeAt(v) is Ident
              && ft >= 0
              && ft < T.tys.length
              && !(tyAt(ft) is TyFunc)
            ) {
              const bt = monoClosedReadTy(v, st[1], false)
              if bt < 0 || !tySame(bt, ft) { return false }
            }
            i = i + 1
          }
        }
      }
    }
  }
  true
}

// Records the list literal of record literals `rx` the un-annotated function `fnIx` returns, by
// `return` or as its body's value, at the type a binding of it reads (`monoHeldRecordListAt`); a
// tagged list keeps its ids. -1 when refused.
function monoPinReturnedList(rx: i32, fnIx: i32): i32 {
  if rx < 0 || rx >= P.nodes.length { return 0 }
  const lx = unwrapParen(rx)
  if lx < 0 || lx >= P.nodes.length || !(nodeAt(lx) is ArrayLit) { return 0 }
  if fnTagListTy(nodeTyIxOf(lx)) || fnTagListTy(elabNodeTyAt(lx, fnIx)) {
    return 0
  }
  const none: i32[] = []
  const noWrites: i32[][] = []
  const nt = monoHeldRecordListAt(lx, [fnIx, fnIx], none, noWrites)
  if nt == -2 { -1 } else { 0 }
}

// The list literals the `let` `d` (`lf`, `monoReadLetFrame`) is re-pointed to, each followed by
// the frame it is evaluated in; a re-point to another list binding gives that binding's literal
// (`monoRepointBindingLit`). `[-1]` when a re-pointing write stores anything else.
function monoLetRepointLits(d: LetDecl, lf: i32[]): i32[] {
  const out: i32[] = []
  if d.letKw != "let" { return out }
  for w in monoWritesOf("n:", lf[1]) {
    const wn = nodeAt(w)
    const wf = monoLetWriteFrame(lf, w)
    if wn is BinExpr && wf.length == 1 {
      const v = unwrapParen(wn.binRight)
      const bl = monoRepointBindingLit(v, wf[0], lf[1])
      if bl.length == 2 {
        out.push(bl[0])
        out.push(bl[1])
      } else if v < 0 || !(nodeAt(v) is ArrayLit) {
        const no: i32[] = [0 - 1]
        return no
      } else {
        out.push(v)
        out.push(wf[0])
      }
    }
  }
  out
}

// The list literal initialising the list binding the `Ident` at `v` names (read in frame
// `ctx`), and that declaration's frame, when nothing writes the binding or its elements and it is
// not the binding `self`; `[]` otherwise (D9170).
function monoRepointBindingLit(v: i32, ctx: i32, self: i32): i32[] {
  const none: i32[] = []
  if v < 0 || v >= P.nodes.length || !(nodeAt(v) is Ident) { return none }
  const sf = monoReadLetFrame(v, ctx)
  if sf[1] < 0 || sf[1] == self { return none }
  const sd = nodeAt(sf[1])
  if !(sd is LetDecl) || sd.letInit < 0 { return none }
  const li = unwrapParen(sd.letInit)
  if li < 0 || !(nodeAt(li) is ArrayLit) || monoGeneratedCellElem(li) >= 0 {
    return none
  }
  if (
    monoWritesOf("n:", sf[1]).length > 0
    || monoWritesOf("e:", sf[1]).length > 0
  ) {
    return none
  }
  const out: i32[] = [li, sf[0]]
  out
}

// Whether list literal `lit` declared at `at` spreads a list and holds otherwise only inert
// values, unwritten and pushed into by no one, so it takes the type of the lists it spreads
// (D9482).
function monoSpreadHostInert(at: i32, lit: ArrayLit): boolean {
  if monoWritesOf("e:", at).length > 0 || monoWritesOf("n:", at).length > 0 {
    return false
  }
  let spreads = 0
  for e in lit.arrElems {
    if nodeAt(e) is Spread {
      spreads = spreads + 1
    } else if (
      !(vrValueInert(unwrapParen(e)) || elabValueSlotUncalled(unwrapParen(e)))
    ) {
      return false
    }
  }
  spreads > 0
}

// Annotates the list `d` declared at `at`, literal `lit`, whose element slot nothing calls, at
// the type `monoUncalledSlotFnTy` gives its elements and the values written into it (D9100).
function monoUncalledListElems(
  d: LetDecl,
  at: i32,
  lf: i32[],
  lit: ArrayLit,
): i32 {
  const vals: i32[][] = []
  for e in lit.arrElems {
    if nodeAt(e) is Spread { return 0 }
    vals.push([e, lf[0]])
  }
  for w in monoWritesOf("e:", at) {
    const wb = nodeAt(w)
    const wf = monoLetWriteFrame(lf, w)
    if !(wb is BinExpr) || wf.length != 1 { return 0 }
    vals.push([wb.binRight, wf[0]])
  }
  const pushed = monoMethodStoredArgs(at, lf, "push", 1, "")
  for pv in pushed { vals.push(pv) }
  if vals.length == 0 { return 0 }
  const ft = monoUncalledSlotFnTy(at, ["e"], vals)
  if ft < 0 { return 0 }
  const lt = mkArrayTy(ft)
  d.letType = synthTypeRefOfTy(lt, -1)
  nodeTyRecord(d.letInit, lt)
  for e in lit.arrElems {
    if !monoTyClosedFn(nodeTyIxOf(e)) { nodeTyRecord(e, ft) }
  }
  for pv in pushed { monoRecordOpen(pv[0], ft, pv[1]) }
  0
}

// Whether `t` is a function type reaching neither a type variable nor an inference hole.
function monoTyClosedFn(t: i32): boolean {
  monoTyConcreteFn(t) && !tyReachesHole(t, 16)
}

// The one closed function type the elaboration delivers slot `path` of binding frame `lf` at,
// leaving out the calls the flow rewrite repointed when `omit`; -1 for none, two, or an open one.
function monoSlotDeliveryTy(lf: i32[], path: string[], omit: boolean): i32 {
  let k = -1
  if !omit && elabSlotPerInstance(lf[1], path) {
    const it = monoFrameInstTmpl(lf[0])
    k = if it[0] >= 0 { elabKeyAt(it[0]) } else { -1 }
    if k < 0 { return -1 }
  }
  const ts = if omit { elabSlotDeliveriesOmitting(lf[1], path, -1, mfrSetCalls) } else { elabSlotDeliveries(lf[1], path, k) }
  let one = -1
  for t in ts {
    if tyAt(t) is TyFunc {
      if one >= 0 && !tySame(one, t) { return -1 }
      one = t
    }
  }
  if !monoTyClosedFn(one) { return -1 }
  one
}

// Whether the functions list literal `lit`, the list literals of `repoints` and the element writes
// of the binding declared at `at` store give one result at the parameters of the slot's pinned
// function type `pinFt`, where they close there.
function monoListStoresAgree(
  lit: ArrayLit,
  repoints: i32[],
  at: i32,
  pinFt: i32,
): boolean {
  const vals: i32[] = []
  for e in lit.arrElems { vals.push(e) }
  let ri = 0
  while ri + 1 < repoints.length {
    const rl = nodeAt(repoints[ri])
    if rl is ArrayLit {
      for e in rl.arrElems { vals.push(e) }
    }
    ri = ri + 2
  }
  for w in monoWritesOf("e:", at) {
    const wb = nodeAt(w)
    if wb is BinExpr { vals.push(wb.binRight) }
  }
  let pre = -1
  for v in vals {
    const r = monoValueAtAnnTy(v, pinFt)
    if r >= 0 && pre >= 0 && sigKeyOfTy(r) != sigKeyOfTy(pre) { return false }
    if r >= 0 { pre = r }
  }
  true
}

// The one function type the values of `vals` take at the parameters of pinned function type
// `pinFt`, where their results close: -1 when none closes, -2 when two disagree.
function monoValsOwnFnTy(vals: i32[][], pinFt: i32): i32 {
  let own = -1
  for vw in vals {
    const r = monoValueAtAnnTy(vw[0], pinFt)
    if r >= 0 && own >= 0 && sigKeyOfTy(r) != sigKeyOfTy(own) { return -2 }
    if r >= 0 { own = r }
  }
  own
}

// The function type value `v` takes at the parameters of function type `at`, when `v` is a function or an
// `if` joining functions whose results there are closed and agree; -1 otherwise.
function monoValueAtAnnTy(v: i32, at: i32): i32 {
  if at < 0 || at >= T.tys.length { return -1 }
  const a = tyAt(at)
  if !(a is TyFunc) || tyHasTyVar(at) { return -1 }
  const r = monoValueRetAt(v, a.fnParamTypes, 0)
  if r < 0 { return -1 }
  const ft = mkFuncTy(a.fnParamTypes, r)
  if !monoTyClosedFn(ft) { return -1 }
  ft
}

// The closed result of value `v` called at the parameter types `qs`, through the arms of an
// `if` that does not end in a call that never returns; -1 when one stays open or two disagree.
function monoValueRetAt(v: i32, qs: i32[], depth: i32): i32 {
  const x = unwrapParen(v)
  if x < 0 || x >= P.nodes.length || depth > MONO_ALIAS_CHAIN_MAX { return -1 }
  const n = nodeAt(x)
  if !(n is IfStmt) {
    const lx = elabOpenFnArgDecl(x)
    if lx >= 0 { return elabFnDeclRetAt(monoLamTypedTemplate(lx), qs) }
    // A re-pointed `let` of un-annotated functions gives the result they all agree on (D9001).
    const hr = holeFnArgRetAtParams(x, qs)
    if hr >= 0 { return hr }
    return elabFnTyRetAt(nodeTyIxOf(x), qs)
  }
  if n.ifElse < 0 { return -1 }
  let r = -1
  for arm in [n.ifThen, n.ifElse] {
    if !monoArmEndsNever(arm) {
      const tv = ifArmValueExpr(arm)
      const ar = monoValueRetAt(if tv >= 0 { tv } else { arm }, qs, depth + 1)
      if ar < 0 { return -1 }
      if r >= 0 && !tySameSpelled(ar, r, TY_WALK_DEPTH) { return -1 }
      r = ar
    }
  }
  r
}

// Pins a lambda literal `v` with an un-annotated parameter, written in frame `wf` into a list
// element or record field of function type `annTy`, at that type, as its own
// contextual type would; -1 when it cannot take it (refused). The checker refuses a call that
// gives it a type it does not take, at each instance of a generic body too (D12238).
function monoPinWrittenLam(v: i32, wf: i32, annTy: i32): i32 {
  const x = unwrapParen(v)
  if x < 0 || !(nodeAt(x) is FuncDecl) { return 0 }
  const lfe = monoLamValueFe(x, wf)
  if (
    lfe < 0
    || lfe >= monoGen.length
    || monoGen[lfe] != 1
    || !monoLamIsHole(lfe)
  ) {
    return 0
  }
  if monoCellLamTake(lfe, x, wf, [], annTy) == 0 { return 0 }
  emitFailAt(
    "emitProgram: a lambda written into an element or field holding a generic function cannot "
      + "take the type the calls through it give it — annotate its parameters",
    x,
  )
}

// Instances each generic function a field of the un-annotated `const` record declared at `at` in
// frame `ctx` holds, and each value a write `d.f = v` stores there, at the one signature the flow
// table pins that field at (`monoDeclPathPins`); a field pinned at none or at two is left alone.
function monoPinRecordFields(d: LetDecl, at: i32, ctx: i32): i32 {
  if d.letInit < 0 || d.letKw != "const" { return 0 }
  const lit = nodeAt(d.letInit)
  if !(lit is ObjLit) { return 0 }
  for fi in lit.objFields {
    const f = nodeAt(fi)
    if f is FieldInit {
      // A field holding a tagged set's member id needs no pin.
      if (
        fnTagTyIsTagged(nodeTyIxOf(f.fiValue))
        || fnTagHoldsTy(nodeTyIxOf(f.fiValue), 4)
      ) {
        continue
      }
      if monoPinRecordField(at, f.fiName, f.fiValue, ctx) < 0 { return -1 }
    }
  }
  0
}

// Types each read of slot `slot` ("f.<name>" a field, "e" an element) in frame `fx` of the
// binding declared at `at` at the pinned function type `ft` where the checker left it open, so a
// call through it has a signature when its value is no one function (D5061). A generic's
// instances share the read node, so there the type is kept per instance (D5079).
function monoRetypeSlotReads(fx: i32, at: i32, slot: string, ft: i32) {
  const d = nodeAt(at)
  if !(d is LetDecl) { return 0 }
  const shared = fx >= 0 && monoFrameIsGenericInstance(fx)
  const nodes = monoFrameNodes(fx)
  const aliases: i32[] = []
  for ix in nodes {
    if monoIsSlotRead(ix, slot, d.letName, fx, at) {
      const rt = nodeTyIxOf(ix)
      if rt < 0 || tyHasTyVar(rt) {
        if shared {
          monoNoteFieldReadTy(ix, fx, ft)
        } else {
          nodeTyRecord(ix, ft)
        }
      }
    }
    const n = nodeAt(ix)
    if shared && n is LetDecl {
      if n.letType < 0 && n.letInit >= 0 {
        if n.letKw == "const" || !monoLetWrittenIn([fx, ix]) {
          aliases.push(ix)
        }
      }
    }
  }
  // A read of a never-written alias of such a read, or of an alias of that, is the read
  // (D5079, D7283).
  const done: i32[] = []
  let grew = true
  while grew {
    grew = false
    for al in aliases {
      const ad = nodeAt(al)
      if ad is LetDecl && !i32ListHas(done, al) {
        if monoFieldReadTyIn(unwrapParen(ad.letInit), fx) >= 0 {
          done.push(al)
          grew = true
          for ix in nodes {
            if monoReadsBinding(ix, ad.letName, fx, al) {
              monoNoteFieldReadTy(ix, fx, ft)
            }
          }
        }
      }
    }
  }
  0
}

// Whether node `ix` reads slot `slot` (`monoRetypeSlotReads`) of the binding `nm` declared at
// `decl`, in frame `fx`.
function monoIsSlotRead(
  ix: i32,
  slot: string,
  nm: string,
  fx: i32,
  decl: i32,
): boolean {
  if slot == "e" { return monoIsElemRead(ix, nm, fx, decl) }
  const n = nodeAt(ix)
  n is Member
    && "f." + n.memProp == slot
    && monoReadsBinding(n.memObj, nm, fx, decl)
}

// Whether node `ix` indexes the binding `nm` declared at `decl`, in frame `fx`.
function monoIsElemRead(ix: i32, nm: string, fx: i32, decl: i32): boolean {
  const n = nodeAt(ix)
  n is Index && monoReadsBinding(n.idxArr, nm, fx, decl)
}

// Whether `v` is a read of the binding `nm` declared at `decl`, in frame `fx`.
function monoReadsBinding(v: i32, nm: string, fx: i32, decl: i32): boolean {
  const o = unwrapParen(v)
  if o < 0 { return false }
  const on = nodeAt(o)
  if !(on is Ident) { return false }
  on.identName == nm && monoReadIsBinding(o, fx, decl)
}

// Every node of frame `fx`'s body, nested function bodies included, or of the program's
// statements when `fx` is -1.
function monoFrameNodes(fx: i32): i32[] {
  const out: i32[] = []
  const stack: i32[] = []
  if fx >= 0 {
    const b = monoNestedBodyOf(fx)
    if b < 0 { return out }
    stack.push(b)
  } else {
    for st in monoProgStmts { stack.push(st) }
  }
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      out.push(ix)
      const body = monoNestedBodyOf(ix)
      if body >= 0 { stack.push(body) }
      for ch in nodeChildren(ix) { stack.push(ch) }
    }
  }
  out
}

// Records `ft` as the type of read `rd` in instance `fx` (`monoFieldReadTys`).
function monoNoteFieldReadTy(rd: i32, fx: i32, ft: i32) {
  if monoFieldReadTyIn(rd, fx) >= 0 { return 0 }
  const ps = monoFieldReadTys.get(rd) ?? []
  ps.push(fx)
  ps.push(ft)
  monoFieldReadTys.set(rd, ps)
  0
}

// Each binding the elaboration found holding a returned record of members whole in a slot is typed
// at that record before the walk, in the binding's own frame, whatever the walk reaches (B2).
function monoSlotRecordsApply(): i32 {
  const done: i32[] = []
  let i = 0
  while i < elabSlotRecCount() {
    const at = elabSlotRecDeclAt(i)
    const dn = if at >= 0 && at < P.nodes.length { nodeAt(at) } else { null }
    if dn is LetDecl && !i32ListHas(done, at) {
      done.push(at)
      if dn.letType < 0 && dn.letInit >= 0 {
        if monoPinSlotRecords(dn, at, monoTopFrameOf(at)) < 0 { return -1 }
      }
    }
    i = i + 1
  }
  0
}

// Types each field of the un-annotated record literal `d` binds at `at` in frame `ctx` that holds a
// returned record of members whole (`elabSlotFieldRecord`) at that record's row, with the literal
// and the field's reads; -1 where no row is minted for it.
function monoPinSlotRecords(d: LetDecl, at: i32, ctx: i32): i32 {
  const lx = unwrapParen(d.letInit)
  const lit = if lx >= 0 && lx < P.nodes.length { nodeAt(lx) } else { null }
  if lit is ArrayLit { return monoPinSlotRecordList(d, lit, lx, at, ctx) }
  if lit is Call { return monoPinSlotRecordMap(d, lx, at, ctx) }
  const ot = nodeTyIxOf(lx)
  if !(lit is ObjLit) || ot < 0 || ot >= T.tys.length { return 0 }
  const o = tyAt(ot)
  if !(o is TyObj) { return 0 }
  const tys: i32[] = []
  for t in o.objFieldTypes { tys.push(t) }
  let any = false
  for fi in lit.objFields {
    const f = nodeAt(fi)
    if f is FieldInit {
      const sigs = elabSlotFieldRecord(at, f.fiName)
      let k = 0
      while k < o.objFieldNames.length && o.objFieldNames[k] != f.fiName {
        k = k + 1
      }
      if sigs.length >= 2 && k < tys.length {
        const bt = monoBundleRecordAt(bundleRecordTyOf(sigs), f.fiValue)
        if bt < 0 { return -1 }
        nodeTyRecord(unwrapParen(f.fiValue), bt)
        monoRetypeSlotReads(ctx, at, "f." + f.fiName, bt)
        tys[k] = bt
        any = true
      }
    }
  }
  if any {
    const rt = mkObjTy(o.objFieldNames, tys)
    monoClosedRecordOwnRow(rt)
    monoSupersededObjTys.push(ot)
    nodeTyRecord(lx, rt)
    monoGradualObjList.push(lx)
  }
  0
}

// `monoPinSlotRecords` for the list literal `lit` at `lx`: its elements, the list and its element
// reads take the record its slot holds, and the binding the list of it.
function monoPinSlotRecordList(
  d: LetDecl,
  lit: ArrayLit,
  lx: i32,
  at: i32,
  ctx: i32,
): i32 {
  const sigs = elabSlotFieldRecord(at, "[]")
  if sigs.length < 2 { return 0 }
  const bt = monoBundleRecordAt(bundleRecordTyOf(sigs), lx)
  if bt < 0 { return -1 }
  const row = bundleRecordRowOfTy(bt)
  if row < 0 || row >= sNames.length { return 0 }
  for e in lit.arrElems { nodeTyRecord(unwrapParen(e), bt) }
  const lt = mkArrayTy(bt)
  d.letType = synthTypeRefOfTy(lt, -1)
  nodeTyRecord(lx, lt)
  monoRetypeSlotReads(ctx, at, "e", bt)
  0
}

// `monoPinSlotRecords` for the fresh `Map()` at `lx`: the map and the binding take a map of the
// record its value slot holds, and its index and `get` reads that record or null.
function monoPinSlotRecordMap(d: LetDecl, lx: i32, at: i32, ctx: i32): i32 {
  const sigs = elabSlotFieldRecord(at, "[]")
  const ot = nodeTyIxOf(lx)
  if sigs.length < 2 || ot < 0 || ot >= T.tys.length { return 0 }
  const om = tyAt(ot)
  if !(om is TyMap) { return 0 }
  const bt = monoBundleRecordAt(bundleRecordTyOf(sigs), lx)
  if bt < 0 { return -1 }
  const mt = mkMapTy(om.mKey, bt, 0)
  if !tyIsEmitRepresentable(mt) { return 0 }
  d.letType = synthTypeRefOfTy(mt, -1)
  nodeTyRecord(lx, mt)
  const nt = mkNullableTy(bt)
  monoRetypeSlotReads(ctx, at, "e", nt)
  monoRetypeMethodReads(ctx, at, "get", nt)
  0
}

// `monoPinRecordFields` for the field `name` initialized with `val`.
function monoPinRecordField(at: i32, name: string, val: i32, ctx: i32): i32 {
  const lf: i32[] = [ctx, at]
  const path: string[] = ["f." + name]
  const fts: i32[] = []
  const pins = monoDeclPathKeys(lf, path, false, fts)
  if pins.length != 1 { return 0 }
  const ann = monoSigFnTyName(pins[0] + ";")
  const annTy = fts[0]
  const dTys = monoPinFnParamTys(at, path, pins[0])
  monoLastInstFe = -1
  const holeLam = monoListElemHoleLamFe(val, ctx) >= 0
  if monoCoerceFnValueTys(val, ctx, -1, dTys, annTy) < 0 { return -1 }
  if holeLam && monoLastInstFe < 0 {
    if monoNoteBindDeliveryAt(val, ann, ctx, annTy) < 0 { return -1 }
  }
  // The field's type is the elaboration's slot fact; a field it has none for is left as checked.
  const ft = elabSlotTyAt(at, path, ctx)
  if !monoTyConcreteFn(ft) { return 0 }
  const vt = nodeTyIxOf(val)
  // A generic's instances share `val`, so its type stays open there (D5079).
  if (vt < 0 || tyHasTyVar(vt)) && !monoFrameIsGenericInstance(ctx) {
    nodeTyRecord(val, ft)
  }
  monoRetypeSlotReads(ctx, at, "f." + name, ft)
  for w in monoWritesOf("f:", at) {
    const wb = nodeAt(w)
    const wf = monoLetWriteFrame(lf, w)
    if wb is BinExpr && wf.length == 1 {
      const m = nodeAt(wb.binLeft)
      if m is Member {
        if m.memProp == name {
          if monoPinWrittenLam(wb.binRight, wf[0], annTy) < 0 { return -1 }
          if (monoCoerceFnValueTys(wb.binRight, wf[0], -1, dTys, annTy) < 0) {
            return -1
          }
        }
      }
    }
  }
  0
}

// Types each field of the un-annotated `const` record declared at `at` in frame `ctx` whose value
// the checker left open at a map or list of functions (`monoPinFieldContainer`), and the record
// and its reads with them (D9061, D9062).
function monoPinFieldContainers(d: LetDecl, at: i32, ctx: i32): i32 {
  if d.letInit < 0 { return 0 }
  const lit = nodeAt(d.letInit)
  if !(lit is ObjLit) || (ctx >= 0 && monoFrameIsGenericInstance(ctx)) {
    return 0
  }
  const pinned: string[] = []
  const recs: string[] = []
  const recTys: i32[] = []
  if !monoLetWritesClosed(d, at, ctx) { return 0 }
  const rt = monoPinObjFields(d.letInit, at, ctx, "", pinned, recs, recTys)
  if rt == -2 { return -1 }
  if rt < 0 || !monoLetWritesAt(d, at, ctx, rt) { return 0 }
  // Each record literal a write stores takes the slot fact `monoLetWritesAt` compared.
  if d.letKw != "const" {
    const st = elabSlotTyAt(at, [], ctx)
    for w in monoLetWholeWrites(at) {
      const wb = nodeAt(w)
      if wb is BinExpr && wb.binOp == "=" {
        monoRecordObjLitAt(unwrapParen(wb.binRight), st, ctx)
      }
    }
  }
  monoSupersededObjTys.push(nodeTyIxOf(d.letInit))
  nodeTyRecord(d.letInit, rt)
  monoGradualObjList.push(d.letInit)
  // A `const` alias of the record, or of an alias, is the record (`const v = r`); an alias of a
  // nested record field is that record, at the field's path (`const v = w.f`).
  const nodes = monoFrameNodes(ctx)
  const decls: i32[] = [at]
  let i = 0
  while i < decls.length {
    const dd = nodeAt(decls[i])
    if dd is LetDecl {
      for ix in nodes {
        if (
          monoTyOpen(nodeTyIxOf(ix))
          && monoReadsBinding(ix, dd.letName, ctx, decls[i])
        ) {
          nodeTyRecord(ix, rt)
        }
        const a = nodeAt(ix)
        if (
          a is LetDecl
          && a.letKw == "const"
          && a.letType < 0
          && a.letInit >= 0
          && !i32ListHas(decls, ix)
        ) {
          if (
            monoReadsBinding(unwrapParen(a.letInit), dd.letName, ctx, decls[i])
          ) {
            decls.push(ix)
          }
        }
      }
    }
    i = i + 1
  }
  0
}

// Types the record literal `rx` an un-annotated function returns in frame `ctx` at its closed type
// at the instance (`elabHeldValTy`) with each function field's slot set (`idSlotHeldTy`), nested
// record literals included, so the inferred result is that record and not the checker's open one.
// A generic instance's copy takes the held type alone: no slot is keyed by the copy (D15297).
function monoPinReturnedObj(rx: i32, ctx: i32) {
  if rx < 0 { return 0 }
  const lx = unwrapParen(rx)
  if lx < 0 || !(nodeAt(lx) is ObjLit) { return 0 }
  const ht = elabHeldValTy(lx, ctx)
  if monoFrameIsGenericInstance(ctx) {
    if ht >= 0 && monoNodeOwnedBy(lx, ctx) { monoRecordObjLitAt(lx, ht, ctx) }
    return 0
  }
  const rt = idSlotHeldTy(lx, ht, "L" + i32ToStr(lx))
  if rt >= 0 { return monoRecordObjLitAt(lx, rt, ctx) }
  monoObjLitFieldsPin(lx, ctx)
  0
}

// Types the reads in frame `ctx` through each field of the record `rt` held by the binding
// declared at `at`: a container of functions by its slot, any other field by its held paths.
function monoRetypeRecFieldReads(ctx: i32, at: i32, rt: i32) {
  if rt < 0 || rt >= T.tys.length { return 0 }
  const o = tyAt(rt)
  if o is TyObj {
    const pinned: string[] = []
    let k = 0
    while k < o.objFieldNames.length && k < o.objFieldTypes.length {
      const ft = o.objFieldTypes[k]
      const et = monoContainerElemTy(ft)
      if et >= 0 && et < T.tys.length && tyAt(et) is TyFunc {
        monoRetypeMapReads(ctx, at, ft, et, o.objFieldNames[k])
      } else {
        monoHeldRecPaths(at, ctx, ft, o.objFieldNames[k], pinned, 1)
      }
      k = k + 1
    }
  }
  0
}

// The closed type of the binding the identifier `vx` in frame `ctx` reads, recorded on it when
// `rec`; -1 for any other expression or a binding still open.
function monoClosedReadTy(vx: i32, ctx: i32, rec: boolean): i32 {
  if !(nodeAt(vx) is Ident) { return -1 }
  const bd = monoReadLetFrame(vx, ctx)[1]
  if bd < 0 { return -1 }
  const b = nodeAt(bd)
  if !(b is LetDecl) { return -1 }
  const bt = monoLetTyIx(b)
  if bt < 0 || bt >= T.tys.length || monoTyOpen(bt) { return -1 }
  if rec { nodeTyRecord(vx, bt) }
  bt
}

// Pins the open fields of record literal `lx` in frame `ctx`, which took no closed type: a
// field reading a closed binding is recorded at it, an open inline list of functions takes its
// element slot's pin (D9254, D9301), and a nested record literal is walked in turn.
function monoObjLitFieldsPin(lx: i32, ctx: i32) {
  const lit = nodeAt(lx)
  const ot = nodeTyIxOf(lx)
  if !(lit is ObjLit) || ot < 0 || ot >= T.tys.length { return 0 }
  const o = tyAt(ot)
  if !(o is TyObj) { return 0 }
  for fi in lit.objFields {
    const f = nodeAt(fi)
    const k = if f is FieldInit { strListIndexOf(o.objFieldNames, f.fiName) } else { -1 }
    if (
      f is FieldInit
      && k >= 0
      && k < o.objFieldTypes.length
      && monoTyOpen(o.objFieldTypes[k])
    ) {
      const vx = unwrapParen(f.fiValue)
      if vx < 0 || vx >= P.nodes.length {
        continue
      } else if nodeAt(vx) is ObjLit {
        monoObjLitFieldsPin(vx, ctx)
      } else if nodeAt(vx) is ArrayLit {
        if monoTyOpen(nodeTyIxOf(vx)) {
          monoPinFieldContainer(lx, ctx, f.fiName, vx)
        }
      } else {
        monoClosedReadTy(vx, ctx, true)
      }
    }
  }
  0
}

// The record type literal `lx` takes at dotted path `pre` of the record declared at `at`: open
// container fields typed by `monoPinFieldContainer` (paths onto `pinned`), nested records typed in
// turn (paths and types onto `recs`, `recTys`) (D9103). -1 when no field is typed, -2 when
// instancing a value is refused.
function monoPinObjFields(
  lx: i32,
  at: i32,
  ctx: i32,
  pre: string,
  pinned: string[],
  recs: string[],
  recTys: i32[],
): i32 {
  const lit = nodeAt(lx)
  if !(lit is ObjLit) { return -1 }
  const ot = nodeTyIxOf(lx)
  if ot < 0 || ot >= T.tys.length { return -1 }
  const o = tyAt(ot)
  if !(o is TyObj) { return -1 }
  const tys: i32[] = []
  for t in o.objFieldTypes { tys.push(t) }
  let any = false
  for fi in lit.objFields {
    const f = nodeAt(fi)
    if f is FieldInit {
      let k = 0
      while k < o.objFieldNames.length && o.objFieldNames[k] != f.fiName {
        k = k + 1
      }
      if k < tys.length && monoTyOpen(tys[k]) {
        let path = f.fiName
        if pre != "" { path = pre + "." + f.fiName }
        const nt = monoPinFieldValue(
          at,
          ctx,
          path,
          f.fiValue,
          pinned,
          recs,
          recTys,
        )
        if nt == -2 { return -2 }
        if nt >= 0 {
          tys[k] = nt
          any = true
        }
      }
    }
  }
  if !any { return -1 }
  // The record's type is the elaboration's slot fact; a record whose generic is called at two
  // signatures has none, and keeps the type its fields give (D15494).
  const st = elabSlotTyAt(at, monoSlotPath(pre, []), ctx)
  if st >= 0 { st } else { mkObjTy(o.objFieldNames, tys) }
}

// The type field path `path` of the record declared at `at` takes from its value `v`: a nested
// record literal's or record binding's (`monoPinObjFields`), or a container's
// (`monoPinFieldContainer`), its path pushed onto `pinned`; -1 left alone, -2 refused.
function monoPinFieldValue(
  at: i32,
  ctx: i32,
  path: string,
  v: i32,
  pinned: string[],
  recs: string[],
  recTys: i32[],
): i32 {
  const vx = unwrapParen(v)
  if vx < 0 || vx >= P.nodes.length { return -1 }
  const vn = nodeAt(vx)
  if vn is ObjLit {
    const nt = monoPinObjFields(vx, at, ctx, path, pinned, recs, recTys)
    if nt < 0 { return nt }
    monoSupersededObjTys.push(nodeTyIxOf(vx))
    nodeTyRecord(vx, nt)
    monoGradualObjList.push(vx)
    recs.push(path)
    recTys.push(nt)
    return nt
  }
  const bd = monoReadLetFrame(vx, ctx)[1]
  if bd >= 0 && vn is Ident {
    const b = nodeAt(bd)
    if b is LetDecl {
      const lt = monoLetTyIx(b)
      if lt >= 0 && lt < T.tys.length && tyAt(lt) is TyObj && !monoTyOpen(lt) {
        // The field's type is the elaboration's slot fact; with none, the binding's (D15494).
        const st = elabSlotTyAt(at, monoSlotPath(path, []), ctx)
        const bt = if st >= 0 { st } else { lt }
        nodeTyRecord(vx, bt)
        recs.push(path)
        recTys.push(bt)
        monoHeldRecPaths(at, ctx, bt, path, pinned, 0)
        return bt
      }
    }
  }
  const nt = monoPinFieldContainer(at, ctx, path, v)
  if nt >= 0 { pinned.push(path) }
  nt
}

// Types the reads in frame `ctx`, through path `pre` of the record declared at `at`, of each map
// or list of functions record type `t` holds, through nested records, and pushes each such path
// onto `pinned`, so an alias's reads are typed too.
function monoHeldRecPaths(
  at: i32,
  ctx: i32,
  t: i32,
  pre: string,
  pinned: string[],
  depth: i32,
) {
  if depth > 8 || t < 0 || t >= T.tys.length { return 0 }
  const o = tyAt(t)
  if !(o is TyObj) { return 0 }
  let k = 0
  while k < o.objFieldNames.length && k < o.objFieldTypes.length {
    const ft = o.objFieldTypes[k]
    const path = pre + "." + o.objFieldNames[k]
    const et = monoContainerElemTy(ft)
    if et >= 0 && et < T.tys.length && tyAt(et) is TyFunc {
      monoRetypeMapReads(ctx, at, ft, et, path)
      pinned.push(path)
    } else {
      monoHeldRecPaths(at, ctx, ft, path, pinned, depth + 1)
    }
    k = k + 1
  }
  0
}

// The type of field `name` of record type `t`; -1 when `t` is no record or has no such field.
function monoObjFieldTy(t: i32, name: string): i32 {
  if t < 0 || t >= T.tys.length { return -1 }
  const o = tyAt(t)
  if !(o is TyObj) { return -1 }
  let k = 0
  while k < o.objFieldNames.length {
    if o.objFieldNames[k] == name && k < o.objFieldTypes.length {
      return o.objFieldTypes[k]
    }
    k = k + 1
  }
  -1
}

// The type field `fld` of the record declared at `at` takes from its value `v`, a map or list of
// functions: a binding's, which that binding's own walk typed, or, for a map or list literal or a
// call, the one its pins give the field's slot, its writes instanced; the reads through the field
// are typed with it. -1 when the field is left alone, -2 when instancing a value is refused.
function monoPinFieldContainer(at: i32, ctx: i32, fld: string, v: i32): i32 {
  const vx = unwrapParen(v)
  const vt = nodeTyIxOf(vx)
  const et = monoContainerElemTy(vt)
  if vx < 0 || vt < 0 || vt >= T.tys.length || et < 0 || et >= T.tys.length {
    return -1
  }
  const c = tyAt(vt)
  // The field's type is the elaboration's slot fact; a container whose generic is called at two
  // signatures has none, and keeps the type mono derives (D15494).
  const st = elabSlotTyAt(at, monoSlotPath(fld, []), ctx)
  const bd = monoReadLetFrame(vx, ctx)[1]
  if bd >= 0 || !monoTyOpen(et) {
    let lt = vt
    if bd >= 0 {
      const b = nodeAt(bd)
      if !(b is LetDecl) { return -1 }
      lt = monoLetTyIx(b)
    }
    if monoContainerElemTy(lt) < 0 || monoTyOpen(lt) { return -1 }
    const bt = if st >= 0 { st } else { lt }
    const bet = monoContainerElemTy(bt)
    nodeTyRecord(vx, bt)
    monoRetypeMapReads(ctx, at, bt, bet, fld)
    return bt
  }
  if c is TyMap {
    const mt = monoPinMapSlot(vx, at, ctx, fld)
    if mt < 0 || st < 0 { return mt }
    return st
  }
  const lit = nodeAt(vx)
  if !(lit is ArrayLit) || !(tyAt(et) is TyFunc) { return -1 }
  const lf: i32[] = [ctx, at]
  const vals: i32[][] = []
  for e in lit.arrElems { vals.push([e, ctx]) }
  for s in monoMapStoredValues(at, lf, fld) { vals.push(s) }
  for s in monoMethodStoredArgs(at, lf, "push", 1, fld) { vals.push(s) }
  const lt = monoStoredSlotFnTy(lf, monoSlotPath(fld, ["e"]), vals)
  if lt < 0 { return lt }
  const nt = if st >= 0 { st } else { mkArrayTy(lt) }
  nodeTyRecord(vx, nt)
  monoRetypeMapReads(ctx, at, nt, monoContainerElemTy(nt), fld)
  nt
}

// The type binding `b` holds: its annotation's, which a pin may have given it, else its
// initializer's; -1 when it has neither.
function monoLetTyIx(b: LetDecl): i32 {
  if b.letType >= 0 { return nodeTyIxOf(b.letType) }
  if b.letInit >= 0 { return nodeTyIxOf(b.letInit) }
  -1
}

// The value type of map type `t`, or the element type of list type `t`; -1 for any other type.
function monoContainerElemTy(t: i32): i32 {
  if t < 0 || t >= T.tys.length { return -1 }
  const mv = tyMapValOf(t)
  if mv >= 0 { return mv }
  tyArrayElemIx(t)
}

// Annotates the un-annotated `const` map at `at`, whose value the checker left open at a function or
// a list or record of them, with the function types the flow table pins those slots at, and
// instances each function a write stores at its slot's (D4579). A slot pinned at none or at two,
// or a stored container that is no literal, leaves the map alone.
function monoPinMapValues(d: LetDecl, at: i32, ctx: i32): i32 {
  if d.letInit < 0 || monoOpenMapValTy(d.letInit) < 0 { return 0 }
  if !monoLetWritesClosed(d, at, ctx) { return 0 }
  // `monoPinMapSlot` instances the stored values and types the map and its reads; the binding's
  // annotation is the elaboration's slot fact, and a map it has none for keeps none.
  const et = elabSlotTyAt(at, [], ctx)
  const nt = monoPinMapSlot(d.letInit, at, ctx, "")
  if nt < 0 { return monoStoredSlotDecline(nt) }
  if et < 0 { return 0 }
  if !tyEq(et, nt) {
    emitFail(
      "monoPinMapValues: the map's stored functions close at another type than its slot fact",
    )
    return -1
  }
  if !monoLetWritesAt(d, at, ctx, et) { return 0 }
  d.letType = synthTypeRefOfTy(et, -1)
  0
}

// Whether the binding `d` declared at `at` in frame `ctx` holds only its initializer's value, as a
// `const` does, or each write of it stores a read of a binding already typed closed (D9101).
function monoLetWritesClosed(d: LetDecl, at: i32, ctx: i32): boolean {
  if d.letKw == "const" { return true }
  // A holder the elaboration closed is written at its fact; only an unfacted one reads its writes.
  const sf = elabSlotTyAt(at, [], ctx)
  if sf >= 0 && sf < T.tys.length && !monoTyOpen(sf) { return true }
  for w in monoLetWholeWrites(at) {
    // The type each write stores is the elaboration's: a record literal's identity type, or the
    // pre-walk type of the binding a read names.
    const wb = nodeAt(w)
    let t = -1
    if wb is BinExpr && wb.binOp == "=" {
      const rx = unwrapParen(wb.binRight)
      const fr = monoStoreFrame(w, ctx)
      if rx >= 0 && rx < P.nodes.length && nodeAt(rx) is ObjLit {
        t = elabIdentityTy(rx, fr)
        if t < 0 { t = nodeTyFrozenOf(rx) }
      } else if rx >= 0 && rx < P.nodes.length && nodeAt(rx) is Ident {
        const bd = monoReadLetFrame(rx, fr)[1]
        const b = if bd >= 0 { nodeAt(bd) } else { null }
        if b is LetDecl {
          t = nodeTyFrozenOf(if b.letType >= 0 { b.letType } else { b.letInit })
        }
      }
    }
    if (
      monoLetWriteFreshMap(w) < 0
      && !monoLetWriteHasListLit(w)
      && (t < 0 || t >= T.tys.length || monoTyOpen(t))
    ) {
      return false
    }
  }
  true
}

// Whether the `let` declared at `at` holds values of type `t`: its slot fact is `t`, which the
// elaboration closes only where every write agrees. A fresh `Map()` write is recorded at `t`.
function monoLetWritesAt(d: LetDecl, at: i32, ctx: i32, t: i32): boolean {
  if d.letKw == "const" { return true }
  const et = elabSlotTyAt(at, [], ctx)
  if et < 0 || !tySame(et, t) { return false }
  if t < T.tys.length && tyAt(t) is TyMap {
    for w in monoLetWholeWrites(at) {
      const fx = monoLetWriteFreshMap(w)
      if fx >= 0 { nodeTyRecord(fx, t) }
    }
  }
  true
}

// Whether write `w` stores a record literal with a list literal field, which the binding's own
// pin types (`monoLetWriteFieldLits`) and `monoLetWritesAt` then compares (D9301).
function monoLetWriteHasListLit(w: i32): boolean {
  const wb = nodeAt(w)
  if !(wb is BinExpr) || wb.binOp != "=" { return false }
  const rx = unwrapParen(wb.binRight)
  if rx < 0 || rx >= P.nodes.length { return false }
  const lit = nodeAt(rx)
  if !(lit is ObjLit) { return false }
  for fi in lit.objFields {
    const f = nodeAt(fi)
    if f is FieldInit {
      const vx = unwrapParen(f.fiValue)
      if vx >= 0 && vx < P.nodes.length && nodeAt(vx) is ArrayLit {
        return true
      }
    }
  }
  false
}

// The right side of write `w` when it is a `Map()` call with no arguments, else -1 (D9182).
function monoLetWriteFreshMap(w: i32): i32 {
  const wb = nodeAt(w)
  if !(wb is BinExpr) || wb.binOp != "=" { return -1 }
  const rx = unwrapParen(wb.binRight)
  if rx < 0 || rx >= P.nodes.length { return -1 }
  const c = nodeAt(rx)
  if !(c is Call) || c.callArgs.length != 0 || c.callFn < 0 { return -1 }
  const f = nodeAt(c.callFn)
  if !(f is Ident) || f.identName != "Map" || identDeclOf(c.callFn) >= 0 {
    return -1
  }
  rx
}

// Records closed type `t` on record literal `lx` in frame `ctx`, and on each open field its field
// type: a nested literal in turn, a read of a binding as read at it, an inline list by its pin.
function monoRecordObjLitAt(lx: i32, t: i32, ctx: i32) {
  if lx < 0 || lx >= P.nodes.length || t < 0 || t >= T.tys.length { return 0 }
  const lit = nodeAt(lx)
  const ot = nodeTyIxOf(lx)
  if !(lit is ObjLit) || ot < 0 || ot >= T.tys.length || !monoTyOpen(ot) {
    return 0
  }
  const o = tyAt(ot)
  const ct = tyAt(t)
  if !(o is TyObj) || !(ct is TyObj) { return 0 }
  for fi in lit.objFields {
    const f = nodeAt(fi)
    const k = if f is FieldInit { strListIndexOf(o.objFieldNames, f.fiName) } else { -1 }
    const ck = if f is FieldInit { strListIndexOf(ct.objFieldNames, f.fiName) } else { -1 }
    if f is FieldInit && k >= 0 && ck >= 0 && monoTyOpen(o.objFieldTypes[k]) {
      const vx = unwrapParen(f.fiValue)
      const ft = ct.objFieldTypes[ck]
      if vx >= 0 && vx < P.nodes.length && nodeAt(vx) is ObjLit {
        monoRecordObjLitAt(vx, ft, ctx)
      } else if vx >= 0 && vx < P.nodes.length && nodeAt(vx) is ArrayLit {
        if monoTyOpen(nodeTyIxOf(vx)) {
          monoPinFieldContainer(lx, ctx, f.fiName, vx)
        }
        // A shared list of values, not functions, takes the field's type in this frame (D15551).
        const et = monoContainerElemTy(ft)
        if (
          !monoNodeOwnedBy(vx, ctx)
          && !monoTyOpen(ft)
          && !(et >= 0 && tyAt(et) is TyFunc)
        ) {
          nodeTyRecordIn(ctx, vx, ft)
        }
      } else if vx >= 0 && vx < P.nodes.length && nodeAt(vx) is Ident {
        // A read the instance shares with the other copies takes the type in this frame only.
        if monoNodeOwnedBy(vx, ctx) {
          nodeTyRecord(vx, ft)
        } else {
          nodeTyRecordIn(ctx, vx, ft)
        }
      }
    }
  }
  monoSupersededObjTys.push(ot)
  nodeTyRecord(lx, t)
  if monoFrameIsGenericInstance(ctx) { monoGradualObjFrame[lx] = ctx }
  monoGradualObjList.push(lx)
  0
}

// The writes `d = v` of the binding declared at `at`, its capture cell's included.
function monoLetWholeWrites(at: i32): i32[] {
  const out: i32[] = []
  for w in monoWritesOf("n:", at) { out.push(w) }
  for w in monoWritesOf("c:", at) { out.push(w) }
  out
}

// The value type of the map (no set) the expression `mx` takes, when that type is open; -1
// otherwise.
function monoOpenMapValTy(mx: i32): i32 {
  const rt = nodeTyIxOf(mx)
  if rt < 0 || rt >= T.tys.length { return -1 }
  const mt = tyAt(rt)
  if !(mt is TyMap) || mt.mSet != 0 { return -1 }
  const vty = mt.mVal
  if vty < 0 || vty >= T.tys.length || !monoTyOpen(vty) { return -1 }
  vty
}

// The map type the map expression `mx` takes, the initializer of the `const` declared at `at` or,
// with `fld`, that binding's field `fld` (D9062), as `monoPinMapValues` gives it; its writes
// are instanced and its reads typed. -1 when the map is
// left alone, -2 when instancing a value is refused.
function monoPinMapSlot(mx: i32, at: i32, ctx: i32, fld: string): i32 {
  const d = nodeAt(at)
  if !(d is LetDecl) { return -1 }
  const vty = monoOpenMapValTy(mx)
  if vty < 0 { return -1 }
  const mt = tyAt(nodeTyIxOf(mx))
  if !(mt is TyMap) { return -1 }
  if monoMapValueUnpinnedCall(d.letName, fld, ctx, at) { return -1 }
  const lf: i32[] = [ctx, at]
  const stored = monoMapStoredValues(at, lf, fld)
  const v = tyAt(vty)
  let nv = -1
  if v is TyFunc {
    const ft = monoStoredSlotFnTy(lf, monoSlotPath(fld, ["v"]), stored)
    if ft < 0 { return ft }
    nv = ft
  } else if (
    v is TyArray
    && v.aElem >= 0
    && v.aElem < T.tys.length
    && tyAt(v.aElem) is TyArray
  ) {
    // A list of lists of functions takes the elaboration's slot fact whole.
    const wv = tyMapValOf(elabSlotTyAt(at, monoSlotPath(fld, []), ctx))
    const wl = tyArrayElemIx(tyArrayElemIx(wv))
    if wl < 0 || !monoTyClosedFn(wl) {
      emitFailAt(
        "emitProgram: internal: a map of lists of function lists has no closed slot fact",
        at,
      )
      return -2
    }
    for s in stored {
      const lit = nodeAt(unwrapParen(s[0]))
      if !(lit is ArrayLit) { return -1 }
      for e in lit.arrElems {
        if !(nodeAt(unwrapParen(e)) is ArrayLit) { return -1 }
        monoRecordOpen(unwrapParen(e), tyArrayElemIx(wv), s[1])
      }
      monoRecordOpen(unwrapParen(s[0]), wv, s[1])
    }
    nv = wv
  } else if v is TyArray {
    if v.aElem < 0 || v.aElem >= T.tys.length || !(tyAt(v.aElem) is TyFunc) {
      return -1
    }
    const elems: i32[][] = []
    // A stored call is read at what its function returns (D9502).
    let called = -1
    for s in stored {
      const sx = unwrapParen(s[0])
      if sx < 0 || sx >= P.nodes.length { return -1 }
      const lit = nodeAt(sx)
      if lit is Call {
        monoCloseRetFnTy(sx, s[1])
        const ct = nodeTyIxOf(sx)
        const cet = tyArrayElemIx(ct)
        if monoTyOpen(ct) || cet < 0 || !(tyAt(cet) is TyFunc) { return -1 }
        if called >= 0 && !tyEq(called, ct) { return -1 }
        called = ct
      } else if lit is ArrayLit {
        for e in lit.arrElems { elems.push([e, s[1]]) }
      } else {
        return -1
      }
    }
    if called >= 0 && elems.length == 0 {
      nv = called
    } else {
      const ft = monoStoredSlotFnTy(lf, monoSlotPath(fld, ["v", "e"]), elems)
      if ft < 0 { return ft }
      nv = mkArrayTy(ft)
      if called >= 0 && !tyEq(called, nv) { return -1 }
    }
    for s in stored { monoRecordOpen(unwrapParen(s[0]), nv, s[1]) }
  } else if v is TyObj {
    nv = monoPinStoredRecords(lf, monoSlotPath(fld, ["v"]), v, stored)
    if nv < 0 { return nv }
  } else {
    return -1
  }
  const nt = mkMapTy(mt.mKey, nv, 0)
  nodeTyRecord(mx, nt)
  monoRetypeMapReads(ctx, at, nt, nv, fld)
  // A binding that holds the map holds it at the same type, and its reads are the map's: a `const`
  // bound to a held binding, to a constant-index element or a field of a held literal's value, or a
  // `let` every write of which stores a held binding.
  if fld == "" {
    const nodes = monoFrameNodes(ctx)
    const held: i32[] = [at]
    let grew = true
    while grew {
      grew = false
      for ix in nodes {
        const a = nodeAt(ix)
        // An un-annotated function every return of which reads a held binding returns the map,
        // and its calls' reads are the map's.
        if (
          a is FuncDecl
          && a.fnRet < 0
          && a.fnName != ""
          && !i32ListHas(held, ix)
        ) {
          let rets = 0
          let rok = true
          for rx in monoFrameNodes(ix) {
            const r = nodeAt(rx)
            if r is RetStmt {
              rets = rets + 1
              // A bare `return` returns no map.
              let hit = false
              for h in held {
                const hn = nodeAt(h)
                if (
                  hn is LetDecl
                  && r.retArg >= 0
                  && monoReadsBinding(r.retArg, hn.letName, ix, h)
                ) {
                  hit = true
                }
              }
              if !hit { rok = false }
            }
          }
          if rets > 0 && rok {
            monoRetypeMapReads(ctx, ix, nt, nv, "()")
            held.push(ix)
            grew = true
          }
        }
        if (
          a is LetDecl
          && a.letType < 0
          && a.letInit >= 0
          && !i32ListHas(held, ix)
        ) {
          // Peel the init's element and field steps to the binding it starts from, then replay
          // them on literals, from that binding's, to the binding the last step reads.
          const steps: i32[] = []
          let x = unwrapParen(a.letInit)
          while (
            x >= 0
            && x < P.nodes.length
            && (nodeAt(x) is Index || nodeAt(x) is Member)
          ) {
            steps.push(x)
            const xn = nodeAt(x)
            x = if xn is Index { unwrapParen(xn.idxArr) } else if xn is Member { unwrapParen(xn.memObj) } else { -1 }
          }
          let src = if x >= 0 && x < P.nodes.length && nodeAt(x) is Ident { monoReadLetFrame(x, ctx)[1] } else { -1 }
          let si = steps.length - 1
          while si >= 0 && src >= 0 {
            // `src` is a binding here, or, after an inner literal, that literal's node.
            const sd = nodeAt(src)
            const cur = if sd is LetDecl && sd.letInit >= 0 { nodeAt(unwrapParen(sd.letInit)) } else { sd }
            const st = nodeAt(steps[si])
            let sv = -1
            if st is Index && cur is ArrayLit {
              const k = nodeAt(unwrapParen(st.idxIndex))
              const e = if k is NumLit { monoListLitIndex(k.numText, cur.arrElems.length) } else { -1 }
              sv = if e >= 0 { unwrapParen(cur.arrElems[e]) } else { -1 }
            } else if st is Member && cur is ObjLit {
              for fx in cur.objFields {
                const f = nodeAt(fx)
                if f is FieldInit && f.fiName == st.memProp {
                  sv = unwrapParen(f.fiValue)
                }
              }
            }
            const vn = if sv >= 0 && sv < P.nodes.length { nodeAt(sv) } else { null }
            src = if vn is Ident { monoReadLetFrame(sv, ctx)[1] } else if si > 0 && (vn is ArrayLit || vn is ObjLit) { sv } else { -1 }
            si = si - 1
          }
          // A bare read names a held binding as its frame resolves it, or calls a held function.
          let ok = src >= 0 && i32ListHas(held, src)
          for h in held {
            const hn = nodeAt(h)
            if (
              steps.length == 0
              && hn is LetDecl
              && x >= 0
              && monoReadsBinding(x, hn.letName, ctx, h)
            ) {
              ok = true
            }
            // A call of a held function returns the map.
            if (
              steps.length == 0
              && hn is FuncDecl
              && x >= 0
              && monoReadsSlotOf(x, hn.fnName, "()", ctx, h)
            ) {
              ok = true
            }
          }
          if ok && a.letKw != "const" {
            for w in monoLetWholeWrites(ix) {
              const wb = nodeAt(w)
              const rx = if wb is BinExpr { unwrapParen(wb.binRight) } else { -1 }
              let wok = false
              for h in held {
                const hn = nodeAt(h)
                if (
                  hn is LetDecl
                  && rx >= 0
                  && monoReadsBinding(rx, hn.letName, ctx, h)
                ) {
                  wok = true
                }
              }
              if !wok { ok = false }
            }
          }
          if ok {
            a.letType = synthTypeRefOfTy(nt, -1)
            nodeTyRecord(a.letInit, nt)
            monoRetypeMapReads(ctx, ix, nt, nv, "")
            held.push(ix)
            grew = true
          }
        }
      }
    }
  }
  nt
}

// The record type the record literals of `stored` (each beside its write's frame), held at slot
// `path` of the binding `lf` declares, take when each open function field of `v` is given the
// one type the flow table pins it at. -1 when a field is pinned at none or two, or a stored value is no record literal; -2 when instancing is refused.
function monoPinStoredRecords(
  lf: i32[],
  path: string[],
  v: TyObj,
  stored: i32[][],
): i32 {
  const fts: i32[] = []
  const recVals: i32[][] = []
  const listLits: i32[][] = []
  let k = 0
  while k < v.objFieldNames.length {
    const name = v.objFieldNames[k]
    let fty = v.objFieldTypes[k]
    const lfv = monoStoredFnListLits(stored, name, fty)
    if lfv.length > 0 {
      // A field holding an inline list of functions takes its element slot's pin (D9301).
      const elems: i32[][] = []
      for fv in lfv {
        const lit = nodeAt(unwrapParen(fv[0]))
        if lit is ArrayLit {
          for e in lit.arrElems { elems.push([e, fv[1]]) }
        }
      }
      const fpath: string[] = []
      for p in path { fpath.push(p) }
      fpath.push("f." + name)
      fpath.push("e")
      const ft = monoStoredSlotFnTy(lf, fpath, elems)
      if ft < 0 { return ft }
      fty = mkArrayTy(ft)
      for fv in lfv { listLits.push([unwrapParen(fv[0]), fty, fv[1]]) }
    } else if (
      monoTyOpen(fty)
      && fty >= 0
      && fty < T.tys.length
      && !(tyAt(fty) is TyFunc)
    ) {
      // A field the elaboration closes takes its slot fact, recorded on each stored value (D9183).
      const fvals = monoMapStoredFields(stored, name)
      if fvals.length != stored.length { return -1 }
      const fpath: string[] = []
      for p in path { fpath.push(p) }
      fpath.push("f." + name)
      fty = elabSlotTyAt(lf[1], fpath, lf[0])
      if fty < 0 || fty >= T.tys.length || monoTyOpen(fty) { return -1 }
      for fv in fvals {
        // Walk state: a value reading a binding whose rep is not yet closed at this point of the
        // walk waits for it; the fact names the type, not the binding's rep (D9183).
        const vx = unwrapParen(fv[0])
        const reads: i32[] = []
        if vx >= 0 && vx < P.nodes.length && nodeAt(vx) is Ident {
          reads.push(vx)
        }
        const vl = if vx >= 0 && vx < P.nodes.length { nodeAt(vx) } else { null }
        if vl is ObjLit {
          for fi in vl.objFields {
            const f = nodeAt(fi)
            const fx = if f is FieldInit { unwrapParen(f.fiValue) } else { -1 }
            if fx >= 0 && fx < P.nodes.length && nodeAt(fx) is ObjLit {
              return -1
            }
            if fx >= 0 && fx < P.nodes.length && nodeAt(fx) is Ident {
              reads.push(fx)
            }
          }
        }
        for rx in reads {
          const bd = monoReadLetFrame(rx, fv[1])[1]
          const b = if bd >= 0 { nodeAt(bd) } else { null }
          if (
            b is LetDecl
            && monoTyOpen(
              nodeTyIxOf(if b.letType >= 0 { b.letType } else { b.letInit }),
            )
          ) {
            return -1
          }
        }
        recVals.push([fv[0], fv[1], fty])
      }
    } else if monoTyOpen(fty) {
      if fty < 0 || fty >= T.tys.length { return -1 }
      const fvals = monoMapStoredFields(stored, name)
      if fvals.length != stored.length { return -1 }
      const fpath: string[] = []
      for p in path { fpath.push(p) }
      fpath.push("f." + name)
      fty = monoStoredSlotFnTy(lf, fpath, fvals)
      if fty < 0 { return fty }
    }
    if !tyIsEmitRepresentable(fty) { return -1 }
    fts.push(fty)
    k = k + 1
  }
  for fv in recVals {
    const vx = unwrapParen(fv[0])
    if vx >= 0 && vx < P.nodes.length && nodeAt(vx) is ObjLit {
      monoRecordObjLitAt(vx, fv[2], fv[1])
    } else if vx >= 0 && vx < P.nodes.length && nodeAt(vx) is Ident {
      nodeTyRecord(vx, fv[2])
    }
  }
  for ll in listLits { monoRecordOpen(ll[0], ll[1], ll[2]) }
  // The record's type is the elaboration's slot fact; a map whose generic is called at two
  // signatures has none, and keeps the type its fields give (D15494).
  const st = elabSlotTyAt(lf[1], path, lf[0])
  const nv = if st >= 0 { st } else { mkObjTy(v.objFieldNames, fts) }
  structTyMarkAliasable(nv)
  for s in stored {
    const sx = unwrapParen(s[0])
    if (
      (recVals.length > 0 || listLits.length > 0)
      && monoTyOpen(nodeTyIxOf(sx))
    ) {
      monoSupersededObjTys.push(nodeTyIxOf(sx))
      monoGradualObjList.push(sx)
    }
    monoRecordOpen(sx, nv, s[1])
  }
  nv
}

// Slot `path` of a binding, or of its field `fld` when `fld` is not "", dotted for a nested one.
function monoSlotPath(fld: string, path: string[]): string[] {
  const out: string[] = []
  let s = 0
  let k = 0
  while fld != "" && k <= fld.length {
    if k == fld.length || fld.slice(k, k + 1) == "." {
      out.push("f." + fld.slice(s, k))
      s = k + 1
    }
    k = k + 1
  }
  for p in path { out.push(p) }
  out
}

// The index of the last `.` in field path `fld`, or -1 for a single field.
function monoPathLastDot(fld: string): i32 {
  let k = fld.length - 1
  while k >= 0 && fld.slice(k, k + 1) != "." { k = k - 1 }
  k
}

// A pin's answer for a slot `monoStoredSlotFnTy` gave no type: -1 refused, 0 declined.
function monoStoredSlotDecline(r: i32): i32 {
  if r == -2 { return -1 }
  0
}

// Whether type `t` reaches a type variable or an inference hole outside a tagged function set,
// whose values are member ids and so need no pin.
function monoTyOpen(t: i32): boolean {
  if t < 0 { return true }
  if !tyHasTyVar(t) && !tyReachesHole(t, 16) { return false }
  if !fnTagTyIsTagged(t) && !fnTagHoldsTy(t, 4) { return true }
  monoTyOpenUntagged(t, 4)
}

// `monoTyOpen` within a type holding a tagged set: a list or record is open when a part other
// than the set is, at most `depth` levels deep.
function monoTyOpenUntagged(t: i32, depth: i32): boolean {
  if t < 0 { return true }
  if fnTagTyIsTagged(t) { return false }
  if !tyHasTyVar(t) && !tyReachesHole(t, 16) { return false }
  if depth <= 0 { return true }
  const a = tyAt(t)
  match a {
    TyArray => {
      return monoTyOpenUntagged(a.aElem, depth - 1)
    }
    TyObj => {
      for f in a.objFieldTypes {
        if monoTyOpenUntagged(f, depth - 1) { return true }
      }
      return false
    }
    // Any other open kind is open as a whole.
    TyPrim | TyErr | TyFunc | TyUnion | TyNullable | TyMap | TyVar | TyLit | TyNeg => {
      return true
    }
  }
}

// Records `t` as the type of node `x` where the checker left it open, outside a generic's
// instances, which share the node (D5079). A function nested in a generic shares its body with
// its copies in the other instances, so the record is this frame's own.
function monoRecordOpen(x: i32, t: i32, wf: i32) {
  if x >= 0 && monoFrameSharesBody(wf) {
    if monoTyOpen(nodeTyIxIn(x, wf)) { nodeTyRecordIn(wf, x, t) }
    return 0
  }
  if x >= 0 && monoTyOpen(nodeTyIxOf(x)) && monoNodeOwnedBy(x, wf) {
    nodeTyRecord(x, t)
  }
  0
}

// Whether node `x` belongs to frame `wf` alone: any frame but a generic one, whose instances
// each own a copy of the body (`nodeSrc`), so the template's own node is shared.
function monoNodeOwnedBy(x: i32, wf: i32): boolean {
  !monoFrameIsGenericInstance(wf) || (nodeSrc[x] ?? -1) >= 0
}

// The value of field `name`, an open list of functions `fty`, in each record literal of `stored`
// when every one of them is a list literal, with its write's frame; empty otherwise.
function monoStoredFnListLits(
  stored: i32[][],
  name: string,
  fty: i32,
): i32[][] {
  const none: i32[][] = []
  if fty < 0 || fty >= T.tys.length || !monoTyOpen(fty) { return none }
  const et = tyArrayElemIx(fty)
  if et < 0 || et >= T.tys.length || !(tyAt(et) is TyFunc) { return none }
  const fvals = monoMapStoredFields(stored, name)
  if fvals.length == 0 || fvals.length != stored.length { return none }
  for fv in fvals {
    const x = unwrapParen(fv[0])
    if x < 0 || x >= P.nodes.length || !(nodeAt(x) is ArrayLit) { return none }
  }
  fvals
}

// The value of field `name` in each stored record literal of `stored`, with its write's frame;
// a stored value that is no record literal, or lacks the field, is left out.
function monoMapStoredFields(stored: i32[][], name: string): i32[][] {
  const out: i32[][] = []
  for s in stored {
    const lit = nodeAt(unwrapParen(s[0]))
    if lit is ObjLit {
      for fi in lit.objFields {
        const f = nodeAt(fi)
        if f is FieldInit && f.fiName == name { out.push([f.fiValue, s[1]]) }
      }
    }
  }
  out
}

// The one function type the flow table pins slot `path` of the binding `lf` declares at, which every
// function of `vals` (each beside its write's frame) is instanced at, with that pin's spelling
// pushed onto `spell`; -1 when the slot is pinned at none or two or a function does not close or
// agree, -2 when instancing one is refused.
function monoStoredSlotFnTy(lf0: i32[], path: string[], vals: i32[][]): i32 {
  let lf = lf0
  let pinFts: i32[] = []
  let pins = monoDeclPathKeys(lf, path, false, pinFts)
  // A generic instance's copy of a literal keys no slot of its own: its template's slots do.
  const src = nodeSrc[lf0[1]] ?? -1
  if pins.length == 0 && src >= 0 {
    lf = [lf0[0], src]
    pins = monoDeclPathKeys(lf, path, false, pinFts)
  }
  const at = lf[1]
  if pins.length == 0 && elabSlotUncalled(at, path) {
    return monoUncalledSlotFnTy(at, path, vals)
  }
  // Functions whose every read now names its generic are called through no slot.
  if pins.length > 1 && elabSlotUncalledOmitting(at, path, mfrRepointed) {
    return monoUncalledSlotFnTy(at, path, vals)
  }
  let omit = false
  if pins.length > 1 {
    const liveFts: i32[] = []
    const live = monoFlowSlotPins(at, path, liveFts)
    if live.length == 1 {
      pins = live
      pinFts = liveFts
      omit = true
    }
  }
  if pins.length != 1 { return -1 }
  const ann = monoSlotPinAnn(lf, path, pins[0], "void")
  // The slot's type is the one the elaboration delivers it at; each value is instanced there.
  let ft = monoSlotDeliveryTy(lf, path, omit)
  if ft < 0 {
    emitFailAt(
      "emitProgram: internal: a function slot pinned at one signature has no one closed type the elaboration delivers it at",
      at,
    )
    return -2
  }
  // The delivery is the slot's type, not each value's: values whose results at the pin disagree
  // share no rep, and values agreeing on another result than the delivered one keep theirs, so a
  // write of the delivered type is refused where it is made.
  const own = monoValsOwnFnTy(
    vals,
    if pinFts.length == 1 { pinFts[0] } else { -1 },
  )
  if own == -2 { return -1 }
  if own >= 0 && sigKeyOfTy(own) != sigKeyOfTy(ft) { ft = own }
  const dTys: i32[] = []
  for vw in vals {
    const val = vw[0]
    const wf = vw[1]
    monoLastInstFe = -1
    const holeLam = monoListElemHoleLamFe(val, wf) >= 0
    if monoPinWrittenLam(val, wf, ft) < 0 { return -2 }
    if monoCoerceFnValueTys(val, wf, -1, dTys, ft) < 0 { return -2 }
    if holeLam && monoLastInstFe < 0 {
      if monoNoteBindDeliveryAt(val, ann, wf, ft) < 0 { return -2 }
    }
  }
  const fty = tyAt(ft)
  if !(fty is TyFunc) { return -1 }
  for vw in vals { monoRecordOpen(vw[0], ft, vw[1]) }
  ft
}

// The type slot `path` of the binding declared at `at`, which nothing calls, holds its functions
// `vals` at (`elabUncalledSlotTy`). The functions are not
// instanced, so each is served by the stub an uncalled function gets. -1 where the elaboration
// has none, or a held value's checked type is no function type.
function monoUncalledSlotFnTy(at: i32, path: string[], vals: i32[][]): i32 {
  for vw in vals {
    const vt = nodeTyIxOf(vw[0])
    if vt < 0 || vt >= T.tys.length || !(tyAt(vt) is TyFunc) { return -1 }
  }
  const ft = elabUncalledSlotTy(at, path)
  if !monoTyClosedFn(ft) { return -1 }
  if !tyIsEmitRepresentable(ft) { return -1 }
  for vw in vals {
    const x = unwrapParen(vw[0])
    if x >= 0 && nodeAt(x) is Ident && !monoTyClosedFn(nodeTyIxOf(x)) {
      elabValueSlotNote(x, at, path)
      monoReachNote(x, true)
    }
  }
  ft
}

// Types each read in frame `ctx` of the map or list `nt` held by the binding declared at `at` (or
// its field `fld`) at `nt`, and at `ft` each read of a value, a `const` bound to one (nullable for
// a map), a `??` over one, and a `for` loop's value (D9063), where the checker left them open or
// guessed another function (`monoFnReadTyStale`).
function monoRetypeMapReads(ctx: i32, at: i32, nt: i32, ft: i32, fld: string) {
  const d = nodeAt(at)
  // A function holder's reads are of its calls (`()`).
  const dn = if d is LetDecl { d.letName } else if d is FuncDecl { d.fnName } else { "" }
  if dn == "" { return 0 }
  const isMap = nt >= 0 && nt < T.tys.length && tyAt(nt) is TyMap
  let rt = ft
  if isMap { rt = mkNullableTy(ft) }
  const nodes = monoFrameNodes(ctx)
  const aliases: i32[] = []
  const loops: i32[] = []
  // Every node reading the slot's value, whose calls take the value's result.
  const reads: i32[] = []
  for ix in nodes {
    // A parenthesised `??` is typed at both nodes.
    const n = nodeAt(unwrapParen(ix))
    const ty = nodeTyIxOf(ix)
    if monoIsMapValueRead(ix, dn, fld, ctx, at) { reads.push(ix) }
    if n is LetDecl && n.letKw == "const" && n.letType < 0 && n.letInit >= 0 {
      if monoIsMapValueRead(unwrapParen(n.letInit), dn, fld, ctx, at) {
        aliases.push(ix)
      }
    }
    if n is ForIn && monoReadsSlotOf(n.fiIter, dn, fld, ctx, at) {
      loops.push(ix)
    }
    const stale = monoFnReadTyStale(ty, ft, ctx)
    if stale && monoIsMapValueRead(ix, dn, fld, ctx, at) {
      nodeTyRecord(ix, rt)
      monoRetypeRecMemberReads(ctx, nodes, ix, ft, 0)
    } else if stale && n is BinExpr && n.binOp == "??" {
      const rty = nodeTyIxOf(n.binRight)
      if monoIsMapValueRead(unwrapParen(n.binLeft), dn, fld, ctx, at) {
        if monoTyOpen(rty) || sigKeyOfTy(rty) == sigKeyOfTy(ft) {
          nodeTyRecord(ix, ft)
          // An open list literal fallback is built at the value it stands in for.
          const rx = unwrapParen(n.binRight)
          if rx >= 0 && nodeAt(rx) is ArrayLit { monoRecordOpen(rx, ft, ctx) }
        }
        reads.push(unwrapParen(ix))
      }
    } else if monoTyOpen(ty) && monoReadsSlotOf(ix, dn, fld, ctx, at) {
      nodeTyRecord(ix, nt)
    }
  }
  // A `const` bound to a read of an alias is one too.
  let ai = 0
  while ai < aliases.length {
    const a = nodeAt(aliases[ai])
    if a is LetDecl {
      for ix in nodes {
        const b = nodeAt(ix)
        if (
          b is LetDecl
          && b.letKw == "const"
          && b.letType < 0
          && b.letInit >= 0
          && monoReadsBinding(unwrapParen(b.letInit), a.letName, ctx, aliases[ai])
        ) {
          aliases.push(ix)
        }
      }
    }
    ai = ai + 1
  }
  // A read of a `const` bound to a value read is that value, nullable unless narrowed.
  for ax in aliases {
    const a = nodeAt(ax)
    if a is LetDecl {
      for ix in nodes {
        const ty = nodeTyIxOf(ix)
        const rd = monoReadsBinding(ix, a.letName, ctx, ax)
        if rd { reads.push(ix) }
        if monoFnReadTyStale(ty, ft, ctx) && rd {
          if ty >= 0 && tyAt(ty) is TyNullable {
            nodeTyRecord(ix, rt)
          } else {
            nodeTyRecord(ix, ft)
          }
        }
      }
      // A record value's own function containers are read through the alias (D9183).
      if ft >= 0 && ft < T.tys.length && tyAt(ft) is TyObj {
        monoRetypeRecFieldReads(ctx, ax, ft)
      }
    }
  }
  // A loop's value is a map's second binding and a list's first.
  for lx in loops {
    const l = nodeAt(lx)
    if l is ForIn {
      let vd = l.fiDecl1
      if isMap { vd = l.fiDecl2 }
      if vd >= 0 {
        for ix in nodes {
          if nodeAt(ix) is Ident && identDeclOf(ix) == vd {
            reads.push(ix)
            if monoFnReadTyStale(nodeTyIxOf(ix), ft, ctx) {
              nodeTyRecord(ix, ft)
            }
          }
        }
      }
    }
  }
  monoRetypeCallsAt(nodes, reads, ft)
  0
}

// Types each read `root.f` among `nodes` in frame `ctx`, where `root` holds record `rt`, at the
// field's type: through nested records, and for a map or list of functions the reads of its
// values and the `const`s bound to one (D9252, D9253).
function monoRetypeRecMemberReads(
  ctx: i32,
  nodes: i32[],
  root: i32,
  rt: i32,
  depth: i32,
) {
  if depth > 8 || rt < 0 || rt >= T.tys.length || !(tyAt(rt) is TyObj) {
    return 0
  }
  for ix in nodes {
    const m = nodeAt(ix)
    if (
      m is Member
      && unwrapParen(m.memObj) == root
      && monoTyOpen(nodeTyIxOf(ix))
    ) {
      const fty = monoObjFieldTy(rt, m.memProp)
      if fty >= 0 && !monoTyOpen(fty) {
        nodeTyRecord(ix, fty)
        const et = monoContainerElemTy(fty)
        if et >= 0 && et < T.tys.length && tyAt(et) is TyFunc {
          monoRetypeHeldFnReads(ctx, nodes, ix, fty, et)
        } else {
          monoRetypeRecMemberReads(ctx, nodes, ix, fty, depth + 1)
        }
      }
    }
  }
  0
}

// Types each read among `nodes` in frame `ctx` of a value of the container node `holder`, a map
// or list `ct` of functions `ft`, and each read of a `const` bound to one, where still stale.
function monoRetypeHeldFnReads(
  ctx: i32,
  nodes: i32[],
  holder: i32,
  ct: i32,
  ft: i32,
) {
  let rt = ft
  if tyAt(ct) is TyMap { rt = mkNullableTy(ft) }
  const aliases: i32[] = []
  for ix in nodes {
    const n = nodeAt(ix)
    let rd = false
    if n is Index { rd = unwrapParen(n.idxArr) == holder }
    if !rd {
      const recv = monoMethodCallRecv(ix, "get")
      rd = recv >= 0 && unwrapParen(recv) == holder
    }
    if rd && monoFnReadTyStale(nodeTyIxOf(ix), ft, ctx) { nodeTyRecord(ix, rt) }
    if n is LetDecl && n.letKw == "const" && n.letType < 0 && n.letInit >= 0 {
      const ii = unwrapParen(n.letInit)
      if ii >= 0 && ii < P.nodes.length {
        const iv = nodeAt(ii)
        if iv is Index && unwrapParen(iv.idxArr) == holder { aliases.push(ix) }
      }
    }
  }
  for ax in aliases {
    const a = nodeAt(ax)
    if a is LetDecl {
      for ix in nodes {
        const ty = nodeTyIxOf(ix)
        if (
          monoFnReadTyStale(ty, ft, ctx)
          && monoReadsBinding(ix, a.letName, ctx, ax)
        ) {
          if ty >= 0 && ty < T.tys.length && tyAt(ty) is TyNullable {
            nodeTyRecord(ix, rt)
          } else {
            nodeTyRecord(ix, ft)
          }
        }
      }
    }
  }
  0
}

// Types each call in `nodes` through one of `reads`, a value now typed `ft` — a function, or a
// record read possibly null whose field it calls — at the function's result, and the `?.` guard
// around it at that result or null, where the checker guessed another result (D9064, D9065).
// A field callee takes the field's type too, or a same-named field of another record keys it.
function monoRetypeCallsAt(nodes: i32[], reads: i32[], ft: i32) {
  if ft < 0 || ft >= T.tys.length { return 0 }
  const retyped: i32[] = []
  for ix in nodes {
    const c = nodeAt(ix)
    if c is Call && c.callFn >= 0 {
      const cf = unwrapParen(c.callFn)
      const pt = monoCalleeFnTyThrough(cf, reads, ft)
      if pt >= 0 && cf >= 0 && cf < P.nodes.length {
        const p = tyAt(pt)
        if nodeAt(cf) is Member && !tyEq(nodeTyIxOf(cf), pt) {
          nodeTyRecord(cf, pt)
        }
        const ct = nodeTyIxOf(ix)
        if p is TyFunc && ct >= 0 && ct < T.tys.length && !tyEq(ct, p.fnRet) {
          nodeTyRecord(ix, p.fnRet)
          retyped.push(ix)
        }
      }
    }
  }
  if retyped.length == 0 { return 0 }
  const guards: i32[] = []
  for ix in nodes {
    const g = nodeAt(ix)
    const gt = nodeTyIxOf(ix)
    if g is IfStmt && gt >= 0 && gt < T.tys.length && tyAt(gt) is TyNullable {
      const b = nodeAt(g.ifThen)
      if (
        b is Block
        && b.blkStmts.length == 1
        && i32ListHas(retyped, b.blkStmts[0])
      ) {
        nodeTyRecord(ix, mkNullableTy(nodeTyIxOf(b.blkStmts[0])))
        guards.push(ix)
      }
    }
  }
  // A `??` over such a guard whose default has the call's type has that type.
  for ix in nodes {
    const q = nodeAt(ix)
    if q is BinExpr && q.binOp == "??" {
      const l = unwrapParen(q.binLeft)
      if i32ListHas(guards, l) {
        const lt = tyAt(nodeTyIxOf(l))
        const rt = nodeTyIxOf(q.binRight)
        if (
          lt is TyNullable
          && rt >= 0
          && tyEq(lt.nInner, rt)
          && !tyEq(nodeTyIxOf(ix), rt)
        ) {
          nodeTyRecord(ix, rt)
        }
      }
    }
  }
  0
}

// The function type of callee `cf` when `cf` is one of `reads` typed function type `ft`, or
// reads a closed function field of one typed `ft` or `ft | null`; -1 otherwise.
function monoCalleeFnTyThrough(cf: i32, reads: i32[], ft: i32): i32 {
  if cf < 0 || cf >= P.nodes.length || ft < 0 || ft >= T.tys.length {
    return -1
  }
  const f = tyAt(ft)
  if f is TyFunc {
    return if nodeTyIxOf(cf) == ft && i32ListHas(reads, cf) { ft } else { -1 }
  }
  const m = nodeAt(cf)
  if (
    !(f is TyObj)
    || !(m is Member)
    || !i32ListHas(reads, unwrapParen(m.memObj))
  ) {
    return -1
  }
  let rt = nodeTyIxOf(unwrapParen(m.memObj))
  if rt < 0 || rt >= T.tys.length { return -1 }
  const rn = tyAt(rt)
  if rn is TyNullable { rt = rn.nInner }
  if rt != ft { return -1 }
  const k = strListIndexOf(f.objFieldNames, m.memProp)
  if k < 0 || k >= f.objFieldTypes.length { return -1 }
  const pt = f.objFieldTypes[k]
  if pt < 0 || pt >= T.tys.length { return -1 }
  if tyAt(pt) is TyFunc && monoTyClosedFn(pt) { return pt }
  -1
}

// Whether `v` reads the binding `name` declared at `at`, or, when `fld` is not "", its field `fld`
// (`[]`: one of its elements).
function monoReadsSlotOf(
  v: i32,
  name: string,
  fld: string,
  ctx: i32,
  at: i32,
): boolean {
  if fld == "" { return monoReadsBinding(v, name, ctx, at) }
  const o = unwrapParen(v)
  // The step `()` reads a call of the function declared at `at`.
  if fld == "()" {
    const c = if o >= 0 && o < P.nodes.length { nodeAt(o) } else { null }
    const cf = if c is Call { c.callFn } else { -1 }
    const fn = if cf >= 0 && cf < P.nodes.length { nodeAt(cf) } else { null }
    return fn is Ident && fn.identName == name && identDeclOf(cf) == at
  }
  // The step `[]` reads an element of the list binding.
  if fld == "[]" {
    const ix = if o >= 0 && o < P.nodes.length { nodeAt(o) } else { null }
    return ix is Index && monoReadsBinding(ix.idxArr, name, ctx, at)
  }
  if o < 0 || o >= P.nodes.length { return false }
  const m = nodeAt(o)
  if !(m is Member) { return false }
  const dot = monoPathLastDot(fld)
  if dot < 0 {
    return m.memProp == fld && monoReadsBinding(m.memObj, name, ctx, at)
  }
  m.memProp == fld.slice(dot + 1, fld.length)
    && monoReadsSlotOf(m.memObj, name, fld.slice(0, dot), ctx, at)
}

// Whether a read typed `ty` of a value the slot type `ft` now types needs retyping: it is open, or,
// outside a generic's shared instances, a function whose result the checker guessed otherwise.
function monoFnReadTyStale(ty: i32, ft: i32, ctx: i32): boolean {
  if monoTyOpen(ty) { return true }
  if ty >= T.tys.length || monoFrameIsGenericInstance(ctx) { return false }
  let t = ty
  const tn = tyAt(ty)
  if tn is TyNullable { t = tn.nInner }
  t >= 0
    && t < T.tys.length
    && tyAt(t) is TyFunc
    && sigKeyOfTy(t) != sigKeyOfTy(ft)
}

// Types each call `d.<method>(…)` in frame `ctx` on the binding declared at `at` at `t`, where the
// checker left it open.
function monoRetypeMethodReads(ctx: i32, at: i32, method: string, t: i32) {
  const d = nodeAt(at)
  if !(d is LetDecl) { return 0 }
  for ix in monoFrameNodes(ctx) {
    const n = nodeAt(ix)
    if n is Call && n.callFn >= 0 && monoTyOpen(nodeTyIxOf(ix)) {
      const cf = nodeAt(n.callFn)
      if (
        cf is Member
        && cf.memProp == method
        && monoReadsBinding(cf.memObj, d.letName, ctx, at)
      ) {
        nodeTyRecord(ix, t)
      }
    }
  }
  0
}

// Whether node `ix` reads a value of the map or list the binding `name` declared at `at` holds
// (`monoReadsSlotOf`), `d[k]` or `d.get(k)`.
function monoIsMapValueRead(
  ix: i32,
  name: string,
  fld: string,
  ctx: i32,
  at: i32,
): boolean {
  if ix < 0 || ix >= P.nodes.length { return false }
  const n = nodeAt(ix)
  if n is Index { return monoReadsSlotOf(n.idxArr, name, fld, ctx, at) }
  const recv = monoMethodCallRecv(ix, "get")
  recv >= 0 && monoReadsSlotOf(recv, name, fld, ctx, at)
}

// The receiver of node `ix` when it is a call of method `method` (any method at ""), else -1.
function monoMethodCallRecv(ix: i32, method: string): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const c = nodeAt(ix)
  if !(c is Call) || c.callFn < 0 || c.callFn >= P.nodes.length { return -1 }
  const cf = nodeAt(c.callFn)
  if !(cf is Member) || (method != "" && cf.memProp != method) { return -1 }
  cf.memObj
}

// Whether a method of a value of the map binding `name` declared at `at`, or of a `const` bound
// to one, is called on a receiver typed nullable, as a `?.` call's guarded arm is, other than a
// record field's: the flow table pins no such call, so a slot type taken from the pins could miss it.
function monoMapValueUnpinnedCall(
  name: string,
  fld: string,
  ctx: i32,
  at: i32,
): boolean {
  const nodes = monoFrameNodes(ctx)
  const aliases: i32[] = []
  for ix in nodes {
    const a = nodeAt(ix)
    if a is LetDecl && a.letInit >= 0 {
      if monoIsMapValueRead(unwrapParen(a.letInit), name, fld, ctx, at) {
        aliases.push(ix)
      }
    }
  }
  for ix in nodes {
    const recv = monoMethodCallRecv(ix, "")
    if recv >= 0 {
      const o = unwrapParen(recv)
      const ot = nodeTyIxOf(o)
      if (ot < 0 || ot >= T.tys.length) {
        if monoIsMapValueRead(o, name, fld, ctx, at) { return true }
        for ax in aliases {
          const a = nodeAt(ax)
          if a is LetDecl && monoReadsBinding(o, a.letName, ctx, ax) {
            return true
          }
        }
      }
    }
  }
  false
}

// Each value stored into the map declared at `lf`'s declaration, with the frame its write is
// in: the right side of `d[k] = v` and the last argument of `d.set(k, v)`, or of `d.f[k] = v`
// and `d.f.set(k, v)` for its field `fld` when that is not "".
function monoMapStoredValues(at: i32, lf: i32[], fld: string): i32[][] {
  const out: i32[][] = []
  if fld == "" {
    for w in monoWritesOf("e:", at) {
      const wb = nodeAt(w)
      const wf = monoLetWriteFrame(lf, w)
      if wb is BinExpr && wf.length == 1 { out.push([wb.binRight, wf[0]]) }
    }
  } else {
    const d = nodeAt(at)
    if !(d is LetDecl) { return out }
    for ix in monoFrameNodes(lf[0]) {
      const w = nodeAt(ix)
      if w is BinExpr && w.binOp == "=" {
        const tg = nodeAt(unwrapParen(w.binLeft))
        if (
          tg is Index
          && monoReadsSlotOf(tg.idxArr, d.letName, fld, lf[0], at)
        ) {
          const sf = monoStoreFrame(ix, lf[0])
          if sf == lf[0] || !monoWriteFrameDead(sf, lf[0]) {
            out.push([w.binRight, sf])
          }
        }
      }
    }
  }
  for s in monoMethodStoredArgs(at, lf, "set", 2, fld) { out.push(s) }
  if fld == "" {
    for v in monoFlowAliasStored(at) {
      const sf = monoStoreFrame(v, lf[0])
      if sf == lf[0] || !monoWriteFrameDead(sf, lf[0]) { out.push([v, sf]) }
    }
  }
  out
}

// The frame node `ix` runs in, under frame `fx` (-1 for the module).
function monoStoreFrame(ix: i32, fx: i32): i32 {
  if fx >= 0 { return monoFrameOfNode(ix, fx) }
  monoTopFrameOf(ix)
}

// The last argument of each call `d.<method>(…)` with `nargs` arguments on the binding `lf`
// declares, or on its field `fld` when that is not "", with the frame the call is in.
function monoMethodStoredArgs(
  at: i32,
  lf: i32[],
  method: string,
  nargs: i32,
  fld: string,
): i32[][] {
  const out: i32[][] = []
  const d = nodeAt(at)
  if !(d is LetDecl) { return out }
  for ix in monoFrameNodes(lf[0]) {
    const n = nodeAt(ix)
    if n is Call && n.callArgs.length == nargs && n.callFn >= 0 {
      const cf = nodeAt(n.callFn)
      if cf is Member && cf.memProp == method {
        if monoReadsSlotOf(cf.memObj, d.letName, fld, lf[0], at) {
          out.push([n.callArgs[nargs - 1], monoStoreFrame(ix, lf[0])])
        }
      }
    }
  }
  out
}

// ── where a generic function value can reach ────────────────────────────────────────────────
// One question, asked of the tree before the walk rewrites it (`value_reach.vl`): a value whose
// every destination drops it, holds it where no function is read back, or hands it to such a
// place is inert (D6881, D7000, D7002).

// The program and roots `monoInertReach` indexed, for `monoValsReachNoCall`'s own index.
let monoReachStmts: i32[] = []
let monoReachRoots: i32[] = []

// Notes inert each name of a generic function in the program `stmts` and the bodies in
// `fnStmts` whose value reaches nothing that calls or observes it (`vrInert`).
function monoInertReach(stmts: i32[]) {
  vrResetFor("mono", stmts, true, false)
  const roots: i32[] = []
  for s in stmts { roots.push(s) }
  for f in fnStmts { roots.push(f) }
  monoReachStmts = stmts
  monoReachRoots = roots
  monoReachIndex(roots)
}

// Adds to `monoInertReach`'s index the subtrees under `roots` not yet in it, such as an
// instance's body the walk is about to enter, and notes which of their reads name a generic
// function, for `vrValueInert` (D6930).
function monoReachIndex(roots: i32[]) {
  const cands: i32[] = []
  vrIndex(roots, cands)
  for x in cands {
    if monoCalleeIsGeneric(x) {
      vrNoteGenericCand(x)
      if vrInertFor("mono", x, "") { monoFlowNoteInertLeaf(x) }
    }
  }
  0
}

// Notes value `x` inert, and with `kept` served by its function's own closure, which nothing
// here calls (D6660, D6931).
function monoReachNote(x: i32, kept: boolean) {
  if kept && !i32ListHas(monoInertCalled, x) { monoInertCalled.push(x) }
  monoFlowNoteInertLeaf(x)
}

// Appends block `b`'s last statement to `out`; nothing for an empty block or a non-block.
function monoBlockTailInto(b: i32, out: i32[]) {
  if b < 0 || b >= P.nodes.length { return 0 }
  const n = nodeAt(b)
  if n is Block {
    if n.blkStmts.length > 0 { out.push(n.blkStmts[n.blkStmts.length - 1]) }
  }
  0
}

// The refusal for a list of generic functions whose calls give it no one function type.
function monoGenericListFail(at: i32): i32 {
  emitFailAt(
    "emitProgram: a list holding a generic function is called through its elements at more than "
      + "one type, so its elements have no one instance — annotate the "
      + "list's element type",
    at,
  )
}

// The refusal for an alias of a capture cell's read stored in a list, at node `at`.
function monoCellAliasListFail(at: i32): i32 {
  emitFailAt(
    "emitProgram: an alias of a captured, reassigned function binding is stored in a list, "
      + "whose calls the binding's one signature cannot follow — store the binding's value in "
      + "an annotated local first, or call it directly",
    at,
  )
}

// The capture cell read `[read, frame]` that the name read at `at` in frame `ctx` reaches through
// a chain of un-annotated aliases never written after their initializer; `[-1, -1]` for none.
function monoAliasCellRead(at: i32, ctx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1]
  let ax = at
  let fr = ctx
  let hops = 0
  while hops < MONO_ALIAS_CHAIN_MAX {
    const lf = monoReadLetFrame(ax, fr)
    if lf[1] < 0 { return none }
    const d = nodeAt(lf[1])
    if !(d is LetDecl) || d.letType >= 0 || d.letInit < 0 { return none }
    const iv = unwrapParen(d.letInit)
    if iv < 0 { return none }
    const cn = monoCellReadName(iv)
    if cn == "" && !(nodeAt(iv) is Ident) { return none }
    if d.letKw != "const" && monoLetWrittenIn(lf) { return none }
    if cn != "" {
      if !monoReadsGeneratedCell(iv, lf[0]) { return none }
      const out: i32[] = [iv, lf[0]]
      return out
    }
    if !(nodeAt(iv) is Ident) { return none }
    ax = iv
    fr = lf[0]
    hops = hops + 1
  }
  none
}

// Whether read `at` names a reassigned `let` annotated with a function type: the binding already
// holds a function of that type, whichever write it took, and the check admitted the delivery.
function monoAnnWrittenLetAt(at: i32, ctx: i32): boolean {
  if !cboxDeclWritten(at) { return false }
  const lf = monoCoercibleLet(at, ctx)
  if lf[1] < 0 { return false }
  const d = nodeAt(lf[1])
  if !(d is LetDecl) || d.letType < 0 { return false }
  const lt = nodeTyIxOf(d.letType)
  lt >= 0 && lt < T.tys.length && tyAt(lt) is TyFunc
}

// For an un-annotated `let` read at `at` that an `=` writes: instances each named generic
// function its initializer or a live write names at type `tnameTy0` (at `delTys0`, the slot's
// parameter types, when not empty), and answers true; false for any other read, which keeps its
// value (D3930). `call`, when `[ix, frame]`, is a call through the read whose key gives the type.
function monoCoerceWrittenLetTys(
  at: i32,
  ctx: i32,
  delTys0: i32[],
  tnameTy0: i32,
  call: i32[],
): boolean {
  // Asked of every value read, so the cheap tests come first.
  if (
    call.length == 0
    && (tnameTy0 < 0 || tnameTy0 >= T.tys.length || !(tyAt(tnameTy0) is TyFunc))
  ) {
    return false
  }
  if !cboxDeclWritten(at) { return false }
  const lf = monoCoercibleLet(at, ctx)
  if lf[1] < 0 { return false }
  const d = nodeAt(lf[1])
  if !(d is LetDecl) || d.letType >= 0 { return false }
  // A read of the set of every function written is a tagged id, which a call dispatches per
  // member at its own types, so it has no one signature to take.
  if fnTagTyIsTagged(nodeTyIxOf(at)) { return false }
  let delTys = delTys0
  let tnameTy = tnameTy0
  if call.length == 2 {
    // The one signature the elaboration instanced the binding's members at through this read, or
    // through the call's own callee when the read is an alias's initializer (D3961).
    const wit = monoFrameInstTmpl(ctx)
    let ks = elabValueInstKey(
      at,
      if wit[0] >= 0 { elabKeyAt(wit[0]) } else { -1 },
    )
    const cn = nodeAt(call[0])
    const cf = if cn is Call { unwrapParen(cn.callFn) } else { -1 }
    if ks.length == 0 && cf >= 0 && cf != at {
      const cit = monoFrameInstTmpl(call[1])
      ks = elabValueInstKey(
        cf,
        if cit[0] >= 0 { elabKeyAt(cit[0]) } else { -1 },
      )
    }
    let kst = -1
    for k in ks {
      const kt = elabKeySig(k)
      kst = if kt < 0 || kst >= 0 && !tySame(kst, kt) { -2 } else if kst == -2 { -2 } else { kt }
    }
    const kf = if kst >= 0 && kst < T.tys.length { tyAt(kst) } else { null }
    if !(kf is TyFunc) { return false }
    delTys = kf.fnParamTypes
    tnameTy = kst
  }
  const byCall = monoCellSigByCall
  monoCellSigByCall = false
  monoWrittenLetBusy.push(lf[1])
  monoLastInstFe = -1
  monoCoerceNamedGenericTys(d.letInit, lf[0], delTys, tnameTy)
  for i in monoWritesOf("n:", lf[1]) {
    const nd = nodeAt(i)
    const wf = monoLetWriteFrame(lf, i)
    if nd is BinExpr && wf.length == 1 {
      monoCoerceNamedGenericTys(nd.binRight, wf[0], delTys, tnameTy)
      // The binding's own call is the type a hole lambda literal written to it is called at.
      if byCall { monoLamLitTakeTys(nd.binRight, wf[0], delTys, tnameTy) }
    }
  }
  monoWrittenLetBusy.pop()
  true
}

// The closed pins the written `let` `lf` is delivered at, at the slot `path` derives from it.
function monoDeclPathPins(lf: i32[], path: string[]): string[] {
  monoDeclPathKeys(lf, path, false, [])
}

// `monoDeclPathPins`, or the returns written destinations deliver the slot at (`elabSlotAnnRets`)
// when `rets`. Pushes onto `fts` the delivery function type each pin is spelled from.
function monoDeclPathKeys(
  lf: i32[],
  path: string[],
  rets: boolean,
  fts: i32[],
): string[] {
  let pins = monoDeclPathKeysIn(lf[1], path, -1, rets, fts)
  if pins.length == 1 && pins[0] == PIN_DECLINE {
    const it = monoFrameInstTmpl(lf[0])
    pins = monoDeclPathKeysIn(lf[1], path, it[0], rets, fts)
  }
  if pins.length == 1 && pins[0] == PIN_DECLINE {
    const none: string[] = []
    return none
  }
  pins
}

// Whether the flow table pins slot `path` of declaration `d` only at an instance's own template,
// so the pin `monoDeclPathPins` gives differs from one instance to another.
function monoDeclPathPinsPerInstance(d: i32, path: string[]): boolean {
  const pins = monoDeclPathKeysIn(d, path, -1, false, [])
  pins.length == 1 && pins[0] == PIN_DECLINE
}

function monoDeclPathKeysIn(
  d: i32,
  path: string[],
  inst: i32,
  rets: boolean,
  fts: i32[],
): string[] {
  // The closed function types the elaboration delivers the slot at, or with `rets` the results
  // written destinations deliver it at, asked in instance `inst` where the instances deliver it
  // differently.
  const decline: string[] = [PIN_DECLINE]
  if inst < 0 && elabSlotPerInstance(d, path) { return decline }
  const k = if inst >= 0 { elabKeyAt(inst) } else { -1 }
  if inst >= 0 && k < 0 { return decline }
  const out: string[] = []
  if rets {
    for t in elabSlotAnnRets(d, path, k) {
      const one: i32[] = [t]
      const sg = pinSigOf(one)
      const r = sg.slice(0, sg.length - 1)
      if !strListHas(out, r) { out.push(r) }
    }
    return out
  }
  for t in elabSlotDeliveries(d, path, k) {
    const ft = tyAt(t)
    if ft is TyFunc {
      const sg = pinSigOf(ft.fnParamTypes)
      if !strListHas(out, sg) {
        out.push(sg)
        fts.push(t)
      }
    }
  }
  out
}

// The frame and declaration (`monoReadLetFrame`) of the `let` read at `at` in frame `ctx`, when
// no coercion of that binding is already under way; `[-1, -1]` otherwise.
function monoCoercibleLet(at: i32, ctx: i32): i32[] {
  const none: i32[] = [-1, -1]
  const lf = monoReadLetFrame(at, ctx)
  if lf[1] < 0 || i32ListHas(monoWrittenLetBusy, lf[1]) { return none }
  const d = nodeAt(lf[1])
  if !(d is LetDecl) || d.letKw != "let" { return none }
  lf
}

// The frame write `i` runs in, as a one-element list, when it is an `=` to the binding `lf`
// (`monoReadLetFrame`) names or to one of its fields or elements, in a frame that holds it and can
// run; empty otherwise. A write in a closure nothing names never runs, so it delivers nothing.
function monoLetWriteFrame(lf: i32[], i: i32): i32[] {
  const none: i32[] = []
  const nd = nodeAt(i)
  if !(nd is BinExpr) || !monoFrameHolds(lf[0], i) { return none }
  const tg = nodeAt(nd.binLeft)
  let lhs = nd.binLeft
  if tg is Member { lhs = tg.memObj }
  else if tg is Index && monoCellReadName(nd.binLeft) == "" { lhs = tg.idxArr }
  let wf = lf[0]
  if lf[0] >= 0 {
    wf = monoFrameOfNode(i, lf[0])
  } else {
    wf = monoTopFrameOf(i)
  }
  if wf != lf[0] && monoWriteFrameDead(wf, lf[0]) { return none }
  if monoReadLetFrame(lhs, wf)[1] != lf[1] { return none }
  const out: i32[] = [wf]
  out
}

// Whether the capture cell declared at `di` holds, in its generic template (an instance's copy
// reads its `declOrigOf`), a type that names a type parameter.
function monoCellTyIsOpen(di: i32): boolean {
  const o = declOrigOf(di)
  const d = nodeAt(if o >= 0 { o } else { di })
  if !(d is LetDecl) { return false }
  const el = monoGeneratedCellElem(d.letInit)
  el >= 0 && tyHasTyVar(monoCellElemTyOf(d.letInit, el))
}

// `monoCoerceFnValueName` for a value naming a declared generic function, at the slot pin's
// parameter types `delTys` where held, at function type `tnameTy`; a hole
// lambda's binding keeps its own signature rules (D3857).
function monoCoerceNamedGenericTys(
  v: i32,
  ctx: i32,
  delTys: i32[],
  tnameTy: i32,
) {
  if !monoNamesDeclaredGeneric(v, ctx) && !monoValueNamesGenerics(v, ctx, 0) {
    return 0
  }
  monoCoerceFnValueTys(unwrapParen(v), ctx, -1, delTys, tnameTy)
}

// Whether value node `v`, read in frame `ctx`, names a declared generic function by name.

function monoNamesDeclaredGeneric(v: i32, ctx: i32): boolean {
  if v < 0 { return false }
  const x = unwrapParen(v)
  if x < 0 { return false }
  const n = nodeAt(x)
  if !(n is Ident) { return false }
  const fe = monoFnFeOfIdent(x, n.identName, ctx)
  fe >= 0 && fe < monoGen.length && monoGen[fe] == 1 && !criFnIsAnonLambda(fe)
}

// Whether value node `v`, read in frame `ctx`, names an instance of a declared generic, as a
// value an earlier coercion renamed does.
function monoNamesGenericInstance(v: i32, ctx: i32): boolean {
  if v < 0 { return false }
  const x = unwrapParen(v)
  if x < 0 { return false }
  const n = nodeAt(x)
  if !(n is Ident) { return false }
  const fe = monoFnFeOfIdent(x, n.identName, ctx)
  if fe < 0 || fe >= fnInstOrigin.length || fnInstOrigin[fe] < 0 {
    return false
  }
  const o = fnInstOrigin[fe]
  o < monoGen.length && monoGen[o] == 1 && !criFnIsAnonLambda(o)
}

// The slot value node `v`, read in frame `ctx`, names by a hole lambda's own name or one of its
// instances' names, as a delivery renames it; -1 for any other node.
function monoLamInstanceNamed(v: i32, ctx: i32): i32 {
  const n = nodeAt(v)
  if !(n is Ident) { return -1 }
  const fe = monoFnFeOfIdent(v, n.identName, ctx)
  if fe < 0 { return -1 }
  let o = fe
  if fe < fnInstOrigin.length && fnInstOrigin[fe] >= 0 { o = fnInstOrigin[fe] }
  if !criFnIsAnonLambda(o) { return -1 }
  fe
}

// Per capture-cell value node naming a generic, the function type it is instanced at. A node
// asked again at other parameter types is one value two types want.
let monoCellCoercedSig: {[i32]: i32} = Map()

// A value written into a capture cell at function type `tnameTy`, in frame `ctx`, `depth` aliases
// down, is one of: a generic or instance by name, an alias or another cell resolving to one, a hole
// lambda (its own rules), a parameter, or a value whose type names no type variable. 0 when it is,
// 1 when one node is wanted at two types, 2 for anything else, which the cell cannot take (D3939).
function monoCellValueTakeAt(
  v: i32,
  ctx: i32,
  depth: i32,
  tys: i32[],
  tnameTy: i32,
): i32 {
  const x = unwrapParen(v)
  if x < 0 { return 2 }
  const n = nodeAt(x)
  if n is IfStmt {
    const a = monoCellValueTakeAt(n.ifThen, ctx, depth, tys, tnameTy)
    if a != 0 { return a }
    return monoCellValueTakeAt(n.ifElse, ctx, depth, tys, tnameTy)
  }
  if n is Block {
    if n.blkStmts.length == 0 { return 2 }
    return monoCellValueTakeAt(
      n.blkStmts[n.blkStmts.length - 1],
      ctx,
      depth,
      tys,
      tnameTy,
    )
  }
  if monoNamesDeclaredGeneric(x, ctx) || monoNamesGenericInstance(x, ctx) {
    if !monoCellSigOne(x, tnameTy) { return 1 }
    monoCoerceNamedGenericTys(x, ctx, tys, tnameTy)
    return 0
  }
  // A hole lambda holds one signature, whichever instance or cell writes it.
  const lfe = monoLamValueFe(x, ctx)
  if lfe >= 0 {
    // A hole lambda written as a literal is pinned at this type, as a call through the cell pins
    // it (D3950); the pin annotates it in place, so its parameters are read as first seen.
    if nodeAt(x) is FuncDecl && monoLamIsHole(lfe) {
      if !monoCellSigOne(monoOrigNode[lfe], tnameTy) { return 1 }
      if lfe < monoGen.length && monoGen[lfe] == 1 {
        return monoCellLamTake(lfe, x, ctx, tys, tnameTy)
      }
      return 0
    }
    // One reached by name keeps its binding's rules (D3857), with one signature per lambda.
    const key = monoLamSigKey(lfe)
    if !monoCellSigOne(key, tnameTy) { return 1 }
    // A lambda with every parameter annotated has its own type to compare.
    if key == fnStmts[lfe] {
      return monoCellConcreteTake(nodeTyIxOf(fnStmts[lfe]), 0, tnameTy)
    }
    return 0
  }
  // A hole lambda that a delivery at a pin renamed to its instance holds that instance's
  // signature, so taking the write again agrees or wants a second type (D4843).
  const ife = monoLamInstanceNamed(x, ctx)
  if ife >= 0 {
    if !monoSlotIsFn(ife) { return 2 }
    const had = mkFuncTy(monoInstParamPinTys(ife), TY_VOID)
    if monoFnTyParamsSame(had, tnameTy) { return 0 }
    return 1
  }
  // Another cell's read delivers that cell at this type (D3949).
  const src = monoCellReadName(x)
  if src != "" && monoReadsGeneratedCell(x, ctx) {
    monoCoerceWrittenCell(x, ctx, tys, tnameTy)
    return 0
  }
  const nm = monoIdentNameOf(x)
  if nm != "" && monoReadGenFnFe(x) >= 0 {
    if !monoCellSigOne(x, tnameTy) { return 1 }
    if monoCoerceFnValueTys(x, ctx, -1, tys, tnameTy) < 0 { return 2 }
    return 0
  }
  // An un-annotated alias never written after its initializer is that initializer.
  if nm != "" && depth < MONO_ALIAS_CHAIN_MAX {
    const lf = monoReadLetFrame(x, ctx)
    if lf[1] >= 0 {
      const d = nodeAt(lf[1])
      if d is LetDecl {
        const fixed = d.letKw == "const" || !monoLetIsAssigned(nm, lf[1])
        if d.letType < 0 && d.letInit >= 0 && fixed {
          return monoCellValueTakeAt(d.letInit, lf[0], depth + 1, tys, tnameTy)
        }
      }
    }
  }
  // A read a test narrowed from a nullable binding keeps that binding's representation.
  monoCellConcreteTake(nodeTyIxOf(x), 2, tnameTy)
}

// The node a lambda slot's signature is recorded on: a lambda with an un-annotated parameter is
// one lambda in every instance of its enclosing generic, so its declaration; any other its own.
function monoLamSigKey(lfe: i32): i32 {
  const own = fnStmts[lfe]
  if lfe >= monoOrigNode.length { return own }
  const orig = nodeAt(monoOrigNode[lfe])
  if orig is FuncDecl {
    for pi in orig.fnParams {
      const pn = nodeAt(pi)
      if pn is Param {
        if pn.parType < 0 { return monoOrigNode[lfe] }
      }
    }
  }
  own
}

// Lambda slots seen with an un-annotated parameter; a pin annotates it in place, so the first
// answer is kept.
let monoHoleLamSlots: {[i32]: boolean} = Map()

// Whether lambda slot `lfe` declares an un-annotated parameter, as first read.
function monoLamIsHole(lfe: i32): boolean {
  if monoHoleLamSlots.get(lfe) ?? false { return true }
  if lfe < 0 || lfe >= monoOrigNode.length { return false }
  const orig = nodeAt(monoOrigNode[lfe])
  if orig is FuncDecl {
    for pi in orig.fnParams {
      const pn = nodeAt(pi)
      if pn is Param {
        if pn.parType < 0 {
          monoHoleLamSlots.set(lfe, true)
          return true
        }
      }
    }
  }
  false
}

// Whether the read `d[0]` at `at` in frame `ctx` is of a capture cell the rewrite built rather
// than of a list the program declared.
function monoReadsGeneratedCell(at: i32, ctx: i32): boolean {
  const lf = monoReadLetFrame(at, ctx)
  if lf[1] < 0 { return false }
  const d = nodeAt(lf[1])
  if !(d is LetDecl) { return false }
  monoGeneratedCellElem(d.letInit) >= 0
}

// What `monoCellValueTakeAt` answers for a value of type `t` delivered at function type `cellTy`:
// 0 for a concrete function type with `cellTy`'s parameters (nullable where `cellTy` is), or a
// primitive such as `null`; 1 for a function type with others; `open` for a type naming a type
// variable; 2 for any other type.
function monoCellConcreteTake(t: i32, open: i32, cellTy: i32): i32 {
  if t < 0 || t >= T.tys.length || tyHasTyVar(t) { return open }
  let ft = t
  const nt = tyAt(t)
  if nt is TyNullable {
    // A nullable value, even one a test narrowed, is stored only where the cell admits null.
    if (
      cellTy < 0
      || cellTy >= T.tys.length
      || !(tyAt(cellTy) is TyNullable) && tyNulFuncInner(cellTy) < 0
    ) {
      return 2
    }
    ft = nt.nInner
  }
  if ft < 0 || ft >= T.tys.length { return 2 }
  const f = tyAt(ft)
  if f is TyPrim { return 0 }
  if !(f is TyFunc) { return 2 }
  if monoConcreteFnTyName(ft) == "" || !monoFnTyParamsSame(ft, cellTy) {
    return 1
  }
  0
}

// Pins hole lambda `lfe`, the value at node `x` in frame `ctx`, at function type `ft`, where
// nothing has yet: 0 when the lambda the cell holds then has that signature (and it is the last
// instance), 1 when it holds another, 2 when it cannot take the type.
function monoCellLamTake(
  lfe: i32,
  x: i32,
  ctx: i32,
  delTys: i32[],
  ft: i32,
): i32 {
  const pnames: string[] = []
  if !monoFnTyPinNames(ft, pnames) { return 2 }
  monoCellLamTakeAt(
    lfe,
    x,
    pnames,
    ctx,
    delTys,
    monoFnTyParamTys(
      if tyNulFuncInner(ft) >= 0 { tyNulFuncInner(ft) } else { ft },
    ),
  )
}

// `monoCellLamTake` at the parameter pin names `pnames`, of types `pinTys`. The lambda the cell
// then holds takes the signature when its parameters' types are `pinTys`, position by position (a
// parameter with no annotation is the all-i32 clone's `i32`); a type missing on either side does not.
function monoCellLamTakeAt(
  lfe: i32,
  x: i32,
  pnames: string[],
  ctx: i32,
  delTys: i32[],
  pinTys: i32[],
): i32 {
  const had = monoInstantiatedAny(lfe)
  if !had {
    monoLastInstFe = -1
    monoCallFrameSlot = monoNestedCallFrame(lfe, ctx)
    const r = monoInstanceFor(lfe, pnames, x, -1, delTys, pinTys)
    monoCallFrameSlot = -1
    if r < 0 || monoLastInstFe < 0 { return 2 }
  }
  if lfe < 0 || lfe >= fnStmts.length { return 2 }
  const fn = nodeAt(fnStmts[lfe])
  if !(fn is FuncDecl) { return 2 }
  let same = fn.fnParams.length == pinTys.length
  let i = 0
  while same && i < fn.fnParams.length {
    const p = nodeAt(fn.fnParams[i])
    if !(p is Param) { return 2 }
    const pt = if p.parType >= 0 { nodeTyIxOf(p.parType) } else { TY_I32 }
    same = pt >= 0 && pinTys[i] >= 0 && tySame(pt, pinTys[i])
    i = i + 1
  }
  if !same {
    if had { return 1 }
    return 2
  }
  // The cell is retyped to the lambda it holds.
  monoLastInstFe = lfe
  0
}

// Whether function types `a` and `b` (a nullable one's function arm) take the same parameter types.
function monoFnTyParamsSame(a: i32, b: i32): boolean {
  if a < 0 || b < 0 || a >= T.tys.length || b >= T.tys.length { return false }
  const fa = tyAt(if tyNulFuncInner(a) >= 0 { tyNulFuncInner(a) } else { a })
  const fb = tyAt(if tyNulFuncInner(b) >= 0 { tyNulFuncInner(b) } else { b })
  if fa is TyFunc {
    if fb is TyFunc {
      if fa.fnParamTypes.length != fb.fnParamTypes.length { return false }
      let i = 0
      while i < fa.fnParamTypes.length {
        if !tySame(fa.fnParamTypes[i], fb.fnParamTypes[i]) { return false }
        i = i + 1
      }
      return true
    }
  }
  false
}

// Set by a call through a written `let` just before it coerces the `let` at the call's type;
// cleared by that coercion.
let monoCellSigByCall = false

// Records the value node `v` a capture cell takes at function type `ft`; false when it already
// holds one with other parameter types.
function monoCellSigOne(v: i32, ft: i32): boolean {
  // Only a function type is recorded.
  if !monoFnTyParamsSame(ft, ft) { return true }
  const had = monoCellCoercedSig.get(v) ?? -1
  if had >= 0 { return monoFnTyParamsSame(had, ft) }
  monoCellCoercedSig.set(v, ft)
  true
}

// Whether function node `fx` is an instance of a generic function, or the generic itself.
function monoFrameIsGenericInstance(fx: i32): boolean {
  const slot = fnStmtsPosOf(fx)
  if slot < 0 { return false }
  if slot < fnInstOrigin.length && fnInstOrigin[slot] >= 0 { return true }
  slot < monoGen.length && monoGen[slot] == 1
}

// A value written into a capture cell that is neither a generic by name, an alias of one, a hole
// lambda nor of a settled type has no instance this pass can give the cell's type.
function monoCellValueFail(nm: string): i32 {
  emitFail(
    "emitProgram: the captured binding `"
      + nm
      + "` is written with a function value whose type at this binding is not settled — write "
      + "the generic function by name, or annotate the binding's type",
  )
}

// A closure lifted once for every instance of its enclosing generic writes one value into
// each instance's capture cell, so it cannot hold a generic at a type that differs per instance.
function monoCellWriterSigFail(nm: string): i32 {
  emitFail(
    "emitProgram: the captured binding `"
      + nm
      + "` is written with a function inside a closure that every instance of the "
      + "enclosing generic function shares, and the instances want it at different types. "
      + "Write it in the enclosing function's own body, or bind a separate value per type",
  )
}

// Whether a plain write `x = …` in frame `lf[0]` targets the binding `lf` (`[frame,
// declaration]`).
function monoLetWrittenIn(lf: i32[]): boolean {
  for w in monoWritesOf("n:", lf[1]) {
    if monoFrameHolds(lf[0], w) { return true }
  }
  false
}

// Whether the binding `name` read at node `at` is written: by binding where the read resolves to
// a `let`, else by name anywhere.
function monoNameWrittenAt(name: string, at: i32): boolean {
  const lf = monoReadLetFrame(at, monoTopFrameOf(at))
  if lf[1] < 0 { return monoReadIsAssigned(name, at) }
  monoLetWrittenIn(lf)
}

// Whether the binding declared at `d`, a source declaration (`monoDeclCanon`), is the target of
// an assignment anywhere in the arena. A write whose target resolved to no declaration counts
// against every binding of its name, and `d` -1 asks after the name alone: both are the safe
// direction, which declines a callee fold and keeps the `call_ref`.
function monoDeclIsAssigned(name: string, d: i32): boolean {
  let i = 0
  while i < P.nodes.length {
    const nd = nodeAt(i)
    if nd is BinExpr {
      if nd.binOp == "=" {
        const tg = nodeAt(nd.binLeft)
        if tg is Ident {
          if tg.identName == name {
            if d < 0 { return true }
            const td = identDeclOf(nd.binLeft)
            if td < 0 || td >= P.nodes.length || monoDeclCanon(td) == d {
              return true
            }
          }
        }
      }
    }
    i = i + 1
  }
  false
}

// Whether the binding the read of `name` at `at` resolves to is assigned (`monoDeclIsAssigned`).
function monoReadIsAssigned(name: string, at: i32): boolean {
  monoDeclIsAssigned(name, monoReadDecl(name, at))
}

// Whether the `let` at `li`, which binds `name`, is assigned (`monoDeclIsAssigned`).
function monoLetIsAssigned(name: string, li: i32): boolean {
  if li < 0 { return monoDeclIsAssigned(name, -1) }
  monoDeclIsAssigned(name, monoDeclCanon(li))
}

// `monoCoerceFnValueName` keyed on an expected TYPE-annotation node (`-1` / a non-function type is a
// no-op). `ctx` is the enclosing function (-1 = top level), for resolving a value binding.
function monoCoerceFnValue(exprIx: i32, expectedTyIx: i32, ctx: i32) {
  if expectedTyIx < 0 { return 0 }
  // An annotation naming the enclosing instance's type parameters is delivered at what they bound.
  const at = nodeTyIxOf(expectedTyIx)
  return monoCoerceFnValueTys(
    exprIx,
    ctx,
    at,
    monoFnTyParamTys(monoPinSubTyOf(at, ctx)),
    monoPinSubTyOf(at, ctx),
  )
}

// The written type-annotation node of parameter `i` of the function occupying `fnStmts`
// slot `fe` — its original declaration, before monomorphization may replace the slot — or
// -1. Lets a call site read the concrete function type a callback parameter declares.
// Callers resolve `fe` through `monoFnFeOfIdent`, so the answer is spelling-independent.
function monoFnParamTypeAt(fe: i32, i: i32) {
  const declIx = monoFnDeclNodeAt(fe)
  if declIx < 0 { return -1 }
  const fn = nodeAt(declIx)
  if fn is FuncDecl {
    const ps = fn.fnParams
    if i < ps.length {
      const p = nodeAt(ps[i])
      if p is Param { return p.parType }
    }
  }
  -1
}

// The declaration node whose parameter annotations `monoFnParamTypeAt` reads — the
// captured original for a template slot, the slot itself for an appended instance (which
// has no separate original and carries the pinned annotations). `monoOrigNode` is only as
// long as the declaration count; indexing past that end traps the compiler. -1 otherwise.
function monoFnDeclNodeAt(fe: i32) {
  if fe < 0 { return -1 }
  if fe >= fnStmts.length { return -1 }
  if fe < monoOrigNode.length { return monoOrigNode[fe] }
  fnStmts[fe]
}

// Does parameter `i` of the declaration at `fe` carry an annotation that mentions that
// declaration's own type parameters — `g: (U, U) => R` on `hof<U, R>`, or a plain `a: U`?
// `monoWalk`'s coercion loop must ask this: handing a type-variable-bearing parameter type
// to `monoCoerceFnValue` mints an instance spelled `U`, which no valtype ladder lowers (D58).
function monoFnParamAnnRidesTyParam(fe: i32, i: i32) {
  const pty = monoFnParamTypeAt(fe, i)
  if pty < 0 { return false }
  const declIx = monoFnDeclNodeAt(fe)
  if declIx < 0 { return false }
  const fn = nodeAt(declIx)
  if fn is FuncDecl {
    if fn.fnTyParams.length == 0 { return false }
    return monoAnnHasTyParam(pty, -1, fn.fnTyParams)
  }
  false
}

// The `fnStmts` slot of the lambda the `let` at the end of call `ix`'s alias chain
// (`monoAliasLetEnd`) is seeded with, in frame `ctx`; -1 when the callee is no such alias.
function monoAliasLetLamFe(ix: i32, ctx: i32): i32 {
  const c = nodeAt(ix)
  if !(c is Call) { return -1 }
  const wl = monoAliasLetEnd(c.callFn, ctx)
  if wl[0] < 0 { return -1 }
  identClosureFeOfRead(wl[0], wl[1])
}

// Coerces each function named as a positional argument of call `n`, where the callee's pinned
// type takes a bundle there, at each of the bundle's signatures (D14841).
function monoCoerceBundleArgs(n: Call, ctx: i32): i32 {
  const an = monoCalleeAnnNode(n.callFn, ctx)
  const at = if an >= 0 { nodeTyIxOf(an) } else { -1 }
  if at < 0 || at >= T.tys.length || elabDeliveredBundles().length == 0 {
    return 0
  }
  const f = tyAt(at)
  if !(f is TyFunc) { return 0 }
  let i = 0
  while i < n.callArgs.length && i < f.fnParamTypes.length {
    const bs = elabDeliveredBundleSigs(f.fnParamTypes[i])
    if bs.length > 0 && nodeAt(unwrapParen(n.callArgs[i])) is Ident {
      // The read stays the generic, so each signature instances it afresh.
      monoNoRename.push(unwrapParen(n.callArgs[i]))
      monoBundleReads.push(unwrapParen(n.callArgs[i]))
      for sg in bs {
        if (monoCoerceFnValueName(n.callArgs[i], ctx, sg) < 0) { return -1 }
      }
    }
    i = i + 1
  }
  0
}

// Coerces each function named as a positional argument of call `n` at the parameter type the
// callee value's concrete function type gives it, declared or as the elaboration types it in this
// instance, where `dfe`, the callee's slot, declares none; a type naming a type variable or a hole
// is left to the instance that pins it.
function monoCoerceAtValueParams(n: Call, dfe: i32, ctx: i32): i32 {
  for nm in n.callArgNames {
    if nm != "" { return 0 }
  }
  if monoCoerceBundleArgs(n, ctx) < 0 { return -1 }
  let ct = nodeTyIxOf(n.callFn)
  if ct < 0 || ct >= T.tys.length { return 0 }
  // An open callee reads the type the elaboration gives it in this instance, and spells its
  // parameters from that type (D15480).
  let fromElab = false
  if tyHasTyVar(ct) || tyReachesHole(ct, 8) {
    const et = elabNodeTyAt(n.callFn, ctx)
    if et >= 0 && et < T.tys.length && !tyHasTyVar(et) {
      ct = et
      fromElab = true
    }
  }
  const f = tyAt(ct)
  if !(f is TyFunc) { return 0 }
  const an = monoCalleeAnnNode(n.callFn, ctx)
  // An un-annotated callee (a list element, a field, a loop variable) spells its recorded type.
  const own = tyNameOf(an) == "" || fromElab
  // An annotated callee's arity is its annotation's, which is a function type and not its nullable.
  const at = nodeTyIxOf(an)
  const af = if at >= 0 && at < T.tys.length { tyAt(at) } else { tyAt(0) }
  const nparts = if af is TyFunc { af.fnParamTypes.length } else { -1 }
  if !own && nparts < 0 { return 0 }
  let i = 0
  while (
    i < n.callArgs.length
    && i < f.fnParamTypes.length
    && (own || i < nparts)
  ) {
    const pt = f.fnParamTypes[i]
    if (
      pt >= 0
      && pt < T.tys.length
      && tyAt(pt) is TyFunc
      && !tyHasTyVar(pt)
      && !tyReachesHole(pt, 8)
      && nodeAt(unwrapParen(n.callArgs[i])) is Ident
      && monoFnParamTypeAt(dfe, i) < 0
    ) {
      if monoCoerceFnValueName(n.callArgs[i], ctx, pt) < 0 { return -1 }
    }
    i = i + 1
  }
  0
}

// Whether `n` is a `.map` / `.filter` whose receiver is a call, or an index into one.
function monoListCbRecvIsCall(n: Call): boolean {
  if n.callFn < 0 || n.callArgs.length != 1 { return false }
  const m = nodeAt(n.callFn)
  if !(m is Member) || (m.memProp != "map" && m.memProp != "filter") {
    return false
  }
  let r = unwrapParen(m.memObj)
  while r >= 0 {
    const rn = nodeAt(r)
    if !(rn is Index) { break }
    r = unwrapParen(rn.idxArr)
  }
  r >= 0 && nodeAt(r) is Call
}

// A generic function named as the callback of `.map` / `.filter` over a list of a closed element
// takes its instance at that element, as a lambda's contextual type pins it (D8944).
function monoCoerceListCbArg(n: Call, ix: i32, ctx: i32): i32 {
  if n.callFn < 0 || n.callArgs.length != 1 { return 0 }
  const m = nodeAt(n.callFn)
  if !(m is Member) || (m.memProp != "map" && m.memProp != "filter") {
    return 0
  }
  const a = n.callArgs[0]
  const ax = unwrapParen(a)
  // An `if` choosing a function per arm is instanced arm by arm (D9072).
  const choice = ax >= 0 && nodeAt(ax) is IfStmt
  const lam = ax >= 0 && nodeAt(ax) is FuncDecl
  if ax < 0 || (!(nodeAt(ax) is Ident) && !choice && !lam) { return 0 }
  // Inside a generic instance the receiver is read at that instance's binding. An open receiver
  // takes the closed type the elaboration gives the value, where it gives one.
  let rt = elabIdentityTy(m.memObj, ctx)
  if rt < 0 { rt = monoNodeTyAt(m.memObj, ctx) }
  if rt < 0 || monoTyOpen(rt) {
    const ew = elabWrittenValueTy(0 - 1, m.memObj, elabWalkTop())
    if ew >= 0 { rt = ew }
  }
  if rt < 0 || rt >= T.tys.length { return 0 }
  const lt = tyAt(rt)
  // A tagged set element is closed: the callback's instance takes the set, as a direct call's does.
  if (
    !(lt is TyArray)
    || lt.aElem < 0
    || tyHasTyVar(lt.aElem) && !fnTagTyIsTagged(lt.aElem)
  ) {
    return 0
  }
  monoRecordPinnedRecv(m.memObj, rt, ctx, 0)
  if lam {
    monoListCbLamAt(a, lt.aElem, ctx)
    // A `.map` whose lambda returns a function gives a list of that function's type (D9171).
    if m.memProp == "map" && monoTyOpen(nodeTyIxOf(ix)) {
      const lr = monoValueRetAt(a, [lt.aElem], 0)
      if monoTyClosedFn(lr) { nodeTyRecord(ix, mkArrayTy(lr)) }
    }
    return 0
  }
  const qs: i32[] = [lt.aElem]
  // A generic or hole function named as the callback takes the signature of the instance the
  // elaboration made for it at the element, else its closed identity type; else its result is
  // derived here.
  let et = elabCbArgSig(a)
  if et < 0 {
    const it = elabIdentityFnTy(ax, ctx)
    const closed = it >= 0
      && it < T.tys.length
      && !tyHasTyVar(it)
      && elabTyClosed(it, 0)
    if closed && tyAt(it) is TyFunc { et = it }
  }
  const ef = if et >= 0 { tyAt(et) } else { tyAt(0) }
  let r = TY_BOOL
  if ef is TyFunc { r = ef.fnRet }
  else if m.memProp == "map" { r = monoValueRetAt(a, qs, 0) }
  if r < 0 || tyHasTyVar(r) { return 0 }
  const ft = if et >= 0 { et } else { mkFuncTy(qs, r) }
  // A named generic handed a tagged set's elements takes its instance at the set itself, as a
  // direct call hands it on (`monoPinHoleParam`).
  if fnTagTyIsTagged(lt.aElem) {
    const an = nodeAt(ax)
    if !(an is Ident) { return 0 }
    const gfe = monoFnFeOfIdent(ax, an.identName, ctx)
    if gfe < 0 || gfe >= monoGen.length || monoGen[gfe] != 1 { return 0 }
    const pn: string[] = [tyToStr(lt.aElem)]
    if monoInstanceFor(gfe, pn, ax, ft, qs, [lt.aElem]) < 0 { return -1 }
  } else {
    if monoCoerceFnValueName(a, ctx, ft) < 0 { return -1 }
  }
  // A `.map` the checker left open, its element a hole function's, gives a list of that result.
  if m.memProp == "map" && monoTyOpen(nodeTyIxOf(ix)) {
    nodeTyRecord(ix, mkArrayTy(r))
  }
  // The choice's own type is what its closure value is built and called at.
  if choice && tyHasTyVar(nodeTyIxOf(ax)) {
    nodeTyRecord(ax, ft)
    nodeTyRecord(a, ft)
  }
  0
}

// Records the pinned list type `t` on a receiver read `recv` and on each un-annotated binding it
// reads through, where the checker left them open, so a binding holds the type it is called at.
function monoRecordPinnedRecv(recv: i32, t: i32, wf: i32, depth: i32) {
  const x = unwrapParen(recv)
  if x < 0 || x >= P.nodes.length || depth > 8 || !(nodeAt(x) is Ident) {
    return 0
  }
  // A read of an annotated binding or parameter types itself per instance; only an open binding
  // takes the pin.
  const dl = identDeclOf(x)
  if dl < 0 || dl >= P.nodes.length { return 0 }
  const d = nodeAt(dl)
  if !(d is LetDecl) || d.letType >= 0 || d.letInit < 0 { return 0 }
  if !monoTyOpen(nodeTyIxOf(dl)) { return 0 }
  monoRecordOpen(x, t, wf)
  if x != recv { monoRecordOpen(recv, t, wf) }
  monoRecordOpen(dl, t, wf)
  monoRecordPinnedRecv(d.letInit, t, wf, depth + 1)
}

// A stored call `ix` of an un-annotated function whose open type holds a function records its
// closed type at the instance (`elabHeldValTy`), so the container holding it has a shape (D9504).
function monoCloseRetFnTy(ix: i32, ctx: i32) {
  const t0 = nodeTyIxOf(ix)
  if !monoTyOpen(t0) || !tyMayHoldFn(t0, 0) { return 0 }
  if !(nodeAt(ix) is Call) || monoRetSlotsSplit(ix) { return 0 }
  const t = elabHeldValTy(ix, ctx)
  if t >= 0 && !monoTyOpen(t) { monoRecordOpen(ix, t, ctx) }
  0
}

// Whether the call at `ix` returns a list literal whose element slot is pinned at more than one
// signature, each read of it then delivered apart.
function monoRetSlotsSplit(ix: i32): boolean {
  const c = nodeAt(ix)
  if !(c is Call) { return false }
  const fd = monoCalleeDeclOf(c)
  if fd < 0 { return false }
  const fn = nodeAt(fd)
  if !(fn is FuncDecl) { return false }
  for r in monoFnRetArgs(fn) {
    const rx = if r >= 0 { monoRetListLitOf(r) } else { -1 }
    if rx >= 0 && monoDeclPathPins([fd, rx], ["e"]).length > 1 { return true }
  }
  false
}

// The list literal returned value `r` is, or initialises as the un-annotated `const` or `let`
// it names that nothing writes whole (D9716); -1 otherwise.
function monoRetListLitOf(r: i32): i32 {
  const x = unwrapParen(r)
  if x < 0 || x >= P.nodes.length { return -1 }
  if nodeAt(x) is ArrayLit { return x }
  if !(nodeAt(x) is Ident) { return -1 }
  const d = identDeclOf(x)
  if d < 0 || d >= P.nodes.length { return -1 }
  const dn = nodeAt(d)
  if !(dn is LetDecl) || dn.letType >= 0 || dn.letInit < 0 { return -1 }
  const ix = unwrapParen(dn.letInit)
  if ix < 0 || !(nodeAt(ix) is ArrayLit) || monoWritesOf("n:", d).length > 0 {
    return -1
  }
  if dn.letKw != "const" && monoWritesOf("c:", d).length > 0 { return -1 }
  ix
}

// The hole lambda `at` handed to `.map` / `.filter` over a list of functions of closed type `el`
// takes its instance with its element parameter at `el` (D9093); 0 either way, since a lambda
// that cannot take it keeps the instance it had.
function monoListCbLamAt(at: i32, el: i32, ctx: i32): i32 {
  const x = unwrapParen(at)
  if x < 0 || x >= P.nodes.length { return 0 }
  const fd = nodeAt(x)
  if !(fd is FuncDecl) || fd.fnParams.length != 1 { return 0 }
  if !monoTyConcreteFn(el) || monoTyConcreteFn(nodeTyIxOf(x)) { return 0 }
  const lfe = monoLamValueFe(x, ctx)
  if lfe < 0 || lfe >= monoGen.length || monoGen[lfe] != 1 { return 0 }
  if !monoLamIsHole(lfe) { return 0 }
  const fs = monoPinAnnSpelling(el)
  if fs == "" { return 0 }
  const pnames: string[] = [fs]
  monoCellLamTakeAt(lfe, x, pnames, ctx, [], [el])
  0
}

// The annotation node the callee `Ident` at `callee` is declared with, as a parameter or a local
// of function `fnIx` or as a module global, or -1.
function monoCalleeAnnNode(callee: i32, fnIx: i32): i32 {
  const cx = unwrapParen(callee)
  if cx < 0 || cx >= P.nodes.length { return -1 }
  const c = nodeAt(cx)
  if !(c is Ident) { return -1 }
  let li = globalLetOfRead(fnIx, cx)
  if fnIx >= 0 {
    const ptn = paramTypeNodeOfRead(fnIx, cx)
    if ptn >= 0 { return ptn }
    const fl = fnLetOfRead(fnIx, cx)
    if fl >= 0 { li = fl }
  }
  if li < 0 { return -1 }
  const ld = nodeAt(li)
  if ld is LetDecl { return ld.letType }
  -1
}

// Call `n` (node `ix`) through a list element, a `for` variable over a list or a `const` joining functions
// by `if`, or an `if` called in place, each element a named function: instances every element
// and types the callee at the one closed type their parameters' own calls and the arguments'
// results give it (D7183, D7848). 1 when it typed the callee, 0 when none applies, -1 on a failure.
function monoOpenCallAtElems(n: Call, ix: i32, ctx: i32): i32 {
  const elems = monoCalleeElems(n.callFn, ctx)
  if elems.length == 0 { return 0 }
  const rows: i32[][] = []
  const own: i32[] = []
  for el in elems {
    const pts = monoElemParamTys(el, elems, n.callArgs, ctx, own)
    if pts.length != n.callArgs.length { return 0 }
    rows.push(pts)
  }
  // A parameter an element never reads takes the type a sibling's calls give it, else the type
  // another position handed the same read takes, since the two hold one value (D13200).
  let j = 0
  while j < n.callArgs.length {
    let fill = -1
    for pts in rows {
      if pts[j] >= 0 { fill = pts[j] }
    }
    if fill < 0 { return 0 }
    for pts in rows {
      if pts[j] < 0 { pts[j] = fill }
    }
    // A function one element takes at its set is taken there by every element.
    const st = monoElemArgSetTy(n.callArgs[j])
    let atSet = false
    for pts in rows {
      if st >= 0 && pts[j] == st { atSet = true }
    }
    if atSet {
      for pts in rows { pts[j] = st }
    }
    j = j + 1
  }
  let ft = -1
  let k = 0
  const hN: string[] = []
  const hT: i32[] = []
  monoOneInstHoleBinds(hN, hT)
  while k < elems.length {
    const r = monoFnDeclRetAtUnder(
      monoElemFnDecl(elems[k], ctx),
      rows[k],
      hN,
      hT,
    )
    if r < 0 { return 0 }
    const et = mkFuncTy(rows[k], r)
    if !monoTyClosedFn(et) && !monoElemSetFnTy(rows[k], r) { return 0 }
    // Elements typed from their own pins alone must agree on a function argument's parameter
    // types too, which the ABI key does not read.
    if (
      ft >= 0
      && (sigKeyOfTy(et) != sigKeyOfTy(ft) || (own.length > 0 && !tySame(et, ft)))
    ) {
      return 0
    }
    ft = et
    k = k + 1
  }
  if monoElemSetFnTy(rows[0], monoFnTyRet(ft)) {
    return monoElemsAtSet(n, ix, elems, rows, ft, ctx)
  }
  const nm = monoConcreteFnTyName(ft)
  if nm == "" { return 0 }
  // An element holds one instance, so a call that coerces it to another instance than an earlier
  // call through it did cannot be served by the one value (D10701).
  for el in elems {
    if monoElemTakenSig.has(el) && monoElemTakenSig[el] != nm {
      return emitFailAt(
        "emitProgram: a function this call reaches through a list or join is already taken at another function type by an earlier call through it",
        n.callFn,
      )
    }
  }
  for el in elems {
    // A hole lambda element is pinned in place at the call's type, as a delivered literal is.
    if monoLamLitTakeTys(el, ctx, [], ft) != 0 {
      return emitFailAt(
        "emitProgram: a lambda this call reaches through a list cannot take the call's function type",
        el,
      )
    }
    if monoCoerceFnValueName(el, ctx, ft) < 0 { return -1 }
    monoElemTakenSig[el] = nm
  }
  nodeTyRecord(n.callFn, ft)
  1
}

// `monoOpenCallAtElems` where a parameter takes a tagged set: each element is its own instance
// at the rows' types, keyed by the set as a direct call's is. 1 when it typed the callee, else 0.
function monoElemsAtSet(
  n: Call,
  ix: i32,
  elems: i32[],
  rows: i32[][],
  ft: i32,
  ctx: i32,
): i32 {
  let k = 0
  while k < elems.length {
    const x = unwrapParen(elems[k])
    if x < 0 || !(nodeAt(x) is Ident) { return 0 }
    const xn = nodeAt(x)
    const fe = if xn is Ident { monoFnFeOfIdent(x, xn.identName, ctx) } else { -1 }
    if fe < 0 || fe >= monoGen.length || monoGen[fe] != 1 { return 0 }
    // A function also delivered elsewhere, as to a closed function slot, shares that value with
    // this element (D14428).
    if monoFnReadElsewhere(identDeclOf(x)) { return 0 }
    const pins: string[] = []
    for pt in rows[k] {
      pins.push(
        if fnTagTyIsTagged(pt) { tyToStr(pt) } else { monoClosedTyPin(pt) },
      )
    }
    if monoInstanceFor(fe, pins, x, -1, rows[k], rows[k]) < 0 { return -1 }
    monoElemAtSet[x] = true
    k = k + 1
  }
  nodeTyRecord(n.callFn, ft)
  // The call reads the result the elements give at the set, which the check left open.
  const rt = monoFnTyRet(ft)
  if rt >= 0 && !tySame(rt, nodeTyIxOf(ix)) { nodeTyRecord(ix, rt) }
  1
}

// Whether callee `c` is a `for` variable over a list literal written in the loop's header, so
// each instance of the enclosing function walks its own copy of the elements.
function monoForInlineElems(c: i32): boolean {
  const x = unwrapParen(c)
  if x < 0 || x >= P.nodes.length || !(nodeAt(x) is Ident) { return false }
  const d = identDeclOf(x)
  const lp = loopVarLoop(d)
  if lp < 0 || lp >= P.nodes.length { return false }
  const dn = nodeAt(lp)
  if !(dn is ForIn) || dn.fiDecl1 != d { return false }
  const it = unwrapParen(dn.fiIter)
  it >= 0 && it < P.nodes.length && nodeAt(it) is ArrayLit
}

// Whether callee `c` is a `for` variable over a list literal written in the loop's header with a
// generic function among its elements (D13100).
function monoForInlineGenElems(c: i32, ctx: i32): boolean {
  if !monoForInlineElems(c) { return false }
  for el in monoCalleeElems(c, ctx) {
    if monoNamesDeclaredGeneric(el, ctx) { return true }
  }
  false
}

// The function values callee `c` reads: a list literal's through an index, a `for` variable or
// an element `const`, or an `if`'s, as the callee itself (D7848) or a `const`'s, an `if` element
// giving each of its arm values; empty for any other callee. A `for` variable read in generic
// instance `ctx` reads the instance's own copy of the loop's list (-1 for none).
function monoCalleeElems(c: i32, ctx: i32): i32[] {
  const none: i32[] = []
  const x = unwrapParen(c)
  if x < 0 || x >= P.nodes.length { return none }
  const n = nodeAt(x)
  if n is Index { return monoConstListElems(n.idxArr) }
  if n is IfStmt {
    const arms: i32[] = []
    if !monoPushArmValues(x, arms) { return none }
    return arms
  }
  if !(n is Ident) { return none }
  const d = identDeclOf(x)
  if d < 0 || d >= P.nodes.length { return none }
  const dn = nodeAt(d)
  const lp = loopVarLoop(d)
  if lp >= 0 && lp < P.nodes.length {
    const fl = nodeAt(lp)
    if !(fl is ForIn) || fl.fiDecl1 != d { return none }
    const own = nodeAt(monoNestedLoopCopy(ctx, monoInstDeclCopy(ctx, lp)))
    if own is ForIn { return monoConstListElems(own.fiIter) }
    return monoConstListElems(fl.fiIter)
  }
  if !(dn is LetDecl) || dn.letKw != "const" || dn.letType >= 0 { return none }
  const ix = unwrapParen(dn.letInit)
  if ix < 0 || ix >= P.nodes.length { return none }
  // A `const` bound to an element read holds that list's elements (D12704).
  const ixn = nodeAt(ix)
  if ixn is Index { return monoConstListElems(ixn.idxArr) }
  if !(ixn is IfStmt) { return none }
  const out: i32[] = []
  if !monoPushArmValues(ix, out) { return none }
  out
}

// Pushes the value `v` gives onto `out`, each arm's for an `if` with an else; false when an arm
// gives none.
function monoPushArmValues(v: i32, out: i32[]): boolean {
  const x = unwrapParen(v)
  if x < 0 || x >= P.nodes.length { return false }
  const i = nodeAt(x)
  if !(i is IfStmt) {
    out.push(x)
    return true
  }
  if i.ifElse < 0 { return false }
  for arm in [i.ifThen, i.ifElse] {
    // An `else if` arm is the nested `if` itself, with no block around it.
    const a = if nodeAt(arm) is IfStmt { arm } else { monoArmTailValue(arm) }
    if a < 0 || !monoPushArmValues(a, out) { return false }
  }
  true
}

// The value arm block `arm` gives: its last statement, or where that reads an un-annotated
// `const` the block itself declares, that `const`'s initialiser (D12840).
function monoArmTailValue(arm: i32): i32 {
  const v = ifArmValueExpr(arm)
  if v < 0 || v >= P.nodes.length { return v }
  const x = unwrapParen(v)
  if x < 0 || x >= P.nodes.length || !(nodeAt(x) is Ident) { return v }
  const d0 = identDeclOf(x)
  const b = nodeAt(arm)
  if d0 < 0 || d0 >= P.nodes.length || !(b is Block) { return v }
  // An instance's copy of the block holds its own copy of a template's `const` the read names.
  let d = -1
  for s in b.blkStmts {
    if d < 0 && (s == d0 || monoSameLetDecl(s, d0)) { d = s }
  }
  if d < 0 { return v }
  const ld = nodeAt(d)
  if (
    !(ld is LetDecl)
    || ld.letKw != "const"
    || ld.letType >= 0
    || ld.letInit < 0
  ) {
    return v
  }
  ld.letInit
}

// The elements of list literal `v`, or of the un-annotated `const` one `v` names, through
// further such `const`s naming it (D7844), and the function names the program stores into that
// `const`'s list (D12700); empty otherwise.
function monoConstListElems(v: i32): i32[] {
  const none: i32[] = []
  const lx = unwrapParen(v)
  if lx < 0 || lx >= P.nodes.length { return none }
  const b = monoConstListBase(lx)
  const ln = if b >= 0 { nodeAt(b) } else { nodeAt(lx) }
  const l = if ln is LetDecl { nodeAt(unwrapParen(ln.letInit)) } else { ln }
  if !(l is ArrayLit) { return none }
  const out: i32[] = []
  for e in l.arrElems {
    if !monoPushArmValues(e, out) { return none }
  }
  if b >= 0 {
    monoLetWritesExtend()
    for s in monoListStores.get(monoDeclCanon(b)) ?? none {
      const vals: i32[] = []
      if monoPushArmValues(s, vals) && monoAllFnValues(vals) {
        for x in vals { out.push(x) }
      }
    }
  }
  out
}

// Whether every node of `xs` is an identifier or a function literal.
function monoAllFnValues(xs: i32[]): boolean {
  for x in xs {
    const n = nodeAt(x)
    if !(n is Ident) && !(n is FuncDecl) { return false }
  }
  true
}

// The function type a call through each list or join element node coerces it to, by node.
let monoElemTakenSig: {[i32]: string} = Map()

// The declaration of the function element `el` names in frame `ctx`: the generic itself when an
// earlier call through the same join already instanced the element (D7842), else
// `elabOpenFnArgDecl`'s.
function monoElemFnDecl(el: i32, ctx: i32): i32 {
  const x = unwrapParen(el)
  if x >= 0 && x < P.nodes.length {
    const n = nodeAt(x)
    if n is Ident {
      const fe = monoFnFeOfIdent(x, n.identName, ctx)
      if fe >= 0 && fe < fnInstOrigin.length && fnInstOrigin[fe] >= 0 {
        const go = fnInstOrigin[fe]
        if go < monoOrigNode.length && nodeAt(monoOrigNode[go]) is FuncDecl {
          return monoOrigNode[go]
        }
      }
    }
  }
  elabOpenFnArgDecl(el)
}

// The closed parameter types the named function `el` takes called with `args` at instance `ctx`,
// each argument naming a function: at the types its calls agree on, else its own calls apart from
// other `elems`' with 1 pushed on `own` (D13202), else its tagged set; empty when one is open.
function monoElemParamTys(
  el: i32,
  elems: i32[],
  args: i32[],
  ctx: i32,
  own: i32[],
): i32[] {
  const none: i32[] = []
  const x = unwrapParen(el)
  if x < 0 || !(nodeAt(x) is Ident || nodeAt(x) is FuncDecl) { return none }
  const fx = monoElemFnDecl(x, ctx)
  if fx < 0 { return none }
  const f = nodeAt(fx)
  if !(f is FuncDecl) || f.fnParams.length != args.length { return none }
  // With a function argument named or forwarded, the element's value parameters bind first at
  // the instance, so the function parameter's calls that pass one are read at the type it hands
  // (D10700); a forwarded one's pins are still read without that binding (D12701).
  let named = false
  for a in args {
    if monoElemArgNamesFn(a, ctx) { named = true }
  }
  const bNames: string[] = []
  const bTys: i32[] = []
  // An element nested in a hole function reads that function's parameters at the types its one
  // instance gives them (D12880).
  if named { monoOneInstHoleBinds(bNames, bTys) }
  const sibs: i32[] = []
  for e in elems {
    const ex = monoElemFnDecl(unwrapParen(e), ctx)
    if ex >= 0 && ex != fx && !i32ListHas(sibs, ex) { sibs.push(ex) }
  }
  const pts: i32[] = []
  let j = 0
  while j < args.length {
    let pt = -1
    const axs = monoElemArgFns(args[j], ctx)
    if axs.length > 0 {
      const qs: i32[] = []
      const noSkip: i32[] = []
      const p = f.fnParams[j]
      // When the shared slot's pins disagree, this element's own are read without its siblings'.
      let got = axs[0] >= 0
        && monoElemFnPinTys(p, args[j], bNames, bTys, noSkip, ctx, qs)
      if axs[0] >= 0 && !got {
        got = monoElemFnPinTys(p, args[j], bNames, bTys, sibs, ctx, qs)
        if got { own.push(1) }
      }
      if got {
        // Every function a parameter can hold is taken at the one instance the pins give.
        let one = true
        for ax in axs {
          const r = elabFnDeclRetAt(monoLamTypedTemplate(ax), qs)
          const at = if r >= 0 { mkFuncTy(qs, r) } else { -1 }
          if at < 0 || (pt >= 0 && sigKeyOfTy(at) != sigKeyOfTy(pt)) {
            one = false
          }
          if one { pt = at }
        }
        // With no one instance, a function the late decision made an id is taken at its set.
        if !one {
          pt = monoElemArgSetTy(args[j])
          if pt < 0 { return none }
        }
      } else if monoElemArgSetTy(args[j]) >= 0 {
        // A function the late decision made an id is taken at its set, as a direct call does.
        pt = monoElemArgSetTy(args[j])
      }
    }
    if pt < 0 || pt >= T.tys.length || tyHasTyVar(pt) && !fnTagTyIsTagged(pt) {
      return none
    }
    pts.push(pt)
    j = j + 1
  }
  pts
}

// The type of the tagged set argument `a` is a member, value or bound parameter of, or -1.
function monoElemArgSetTy(a: i32): i32 {
  const x = unwrapParen(a)
  if x < 0 { return -1 }
  if fnTagTyIsTagged(nodeTyIxOf(x)) { return nodeTyIxOf(x) }
  const ls = fnTagLeafSetOf(x)
  if ls >= 0 && fnTagSetIsTagged(ls) { return fnTagSetTy(ls) }
  // A parameter handed on holds the set its instance binds it to.
  const it = elabWalkTy(x)
  if fnTagTyIsTagged(it) { return it }
  -1
}

// The program's top-level statements, and each declared function's reads that are neither a
// callee nor a list element or `if` arm.
let monoTopStmts: i32[] = []
let monoFnValReads: {[i32]: i32[]} = Map()
let monoFnValReadsBuilt = false

// Whether declared function `d` is read as a value other than as a callee, a list element or an
// `if` arm.
function monoFnReadElsewhere(d: i32): boolean {
  if !monoFnValReadsBuilt {
    monoFnValReadsBuilt = true
    const xs: i32[] = []
    const ps: i32[] = []
    for st in monoTopStmts {
      xs.push(st)
      ps.push(-1)
    }
    while xs.length > 0 {
      const x = xs.pop() ?? -1
      const p = ps.pop() ?? -1
      if x >= 0 && x < P.nodes.length {
        const pn = if p >= 0 { nodeAt(p) } else { nodeAt(x) }
        const callee = p >= 0 && pn is Call && pn.callFn == x
        const elem = pn is ArrayLit || pn is IfStmt || pn is Block
        if nodeAt(x) is Ident && !callee && !elem {
          const xd = identDeclOf(x)
          if xd >= 0 && xd < P.nodes.length && nodeAt(xd) is FuncDecl {
            const at = monoFnValReads[xd] ?? []
            at.push(x)
            monoFnValReads[xd] = at
          }
        }
        for c in nodeChildren(x) {
          xs.push(c)
          ps.push(x)
        }
      }
    }
  }
  (monoFnValReads[d] ?? []).length > 0
}

// The element values `monoElemsAtSet` instanced at a tagged set, by node.
let monoElemAtSet: {[i32]: boolean} = Map()

// Whether some type of `ts` is a tagged set's.
function monoTysHoldSet(ts: i32[]): boolean {
  for t in ts {
    if fnTagTyIsTagged(t) { return true }
  }
  false
}

// Whether parameter types `ps` and result `r` are closed but for at least one tagged set.
function monoElemSetFnTy(ps: i32[], r: i32): boolean {
  let set = false
  for p in ps {
    if fnTagTyIsTagged(p) { set = true }
    else if p < 0 || tyHasTyVar(p) { return false }
  }
  set && r >= 0 && !tyHasTyVar(r)
}
const monoNoNames: string[] = []
const monoNoTys: i32[] = []

// Appends to `bNames`/`bTys` each hole type variable every instance binds to one type, and not
// already bound there: the instances so far, else the type every call agrees on. A hole two
// instances or two calls bind apart is left open.
function monoOneInstHoleBinds(bNames: string[], bTys: i32[]): i32 {
  const seen: {[string]: i32} = Map()
  for fe in monoInstFe {
    const ek = if fe >= 0 && fe < fnStmts.length { elabKeyAt(fnStmts[fe]) } else { -1 }
    const ns = if ek >= 0 && ek < ekNames.length { ekNames[ek] } else { monoNoNames }
    const ts = if ek >= 0 && ek < ekTys.length { ekTys[ek] } else { monoNoTys }
    let k = 0
    while k < ns.length && k < ts.length {
      if ns[k].length == 0 || ns[k][0] != '?' {
        k = k + 1
        continue
      }
      const t = ts[k]
      const prev = seen.get(ns[k]) ?? -1
      if t < 0 {
        seen[ns[k]] = -2
      } else if prev == -1 {
        seen[ns[k]] = t
      } else if prev >= 0 && sigKeyOfTy(prev) != sigKeyOfTy(t) {
        seen[ns[k]] = -2
      }
      k = k + 1
    }
  }
  for nm in seen.keys() {
    const t = seen.get(nm) ?? -1
    if t >= 0 && !tyHasTyVar(t) && !monoStrListHas(bNames, nm) {
      bNames.push(nm)
      bTys.push(t)
    }
  }
  // A hole no instance has bound yet takes the type every call of its function binds it to, so
  // an instance the walk reaches later binds it too (D12940).
  const cN: string[] = []
  const cT: i32[] = []
  callBindAgreedHoles(cN, cT)
  let c = 0
  while c < cN.length {
    if !seen.has(cN[c]) && !monoStrListHas(bNames, cN[c]) {
      bNames.push(cN[c])
      bTys.push(cT[c])
    }
    c = c + 1
  }
  0
}

// The declared functions argument `a` of a call through elements hands an element's function
// parameter: what an un-annotated parameter holds, or the generic or hole lambda it names; empty
// for a value argument.
function monoElemArgFns(a: i32, ctx: i32): i32[] {
  if monoElemArgNamesFn(a, ctx) { return [elabOpenFnArgDecl(a)] }
  []
}

// Whether argument `a` names its function itself, a generic or a hole lambda, rather than a
// parameter holding one; only such a function is taken at the pins its element's values bind.
function monoElemArgNamesFn(a: i32, ctx: i32): boolean {
  monoNamesDeclaredGeneric(a, ctx) || monoIsHoleLamArg(a)
}

// The one instance list element parameter `par`, handed `arg`, takes from the pins not taken in
// the functions `skip`: the pins' agreed types, or under the element's value bindings, pushed
// onto `qs` only when one of them answers.
function monoElemFnPinTys(
  par: i32,
  arg: i32,
  bNames: string[],
  bTys: i32[],
  skip: i32[],
  ctx: i32,
  qs: i32[],
): boolean {
  const got: i32[] = []
  // An instance's clone of the element reads its calls at the template's parameter.
  const p = nodeSrc[par] ?? par
  const ok = elabValueAgreedCallTys(p, skip, got)
    || (monoElemArgNamesFn(arg, ctx)
    && monoElemPinTysUnder(p, bNames, bTys, skip, got))
  if ok {
    for t in got { qs.push(t) }
  }
  ok
}

// The one closed parameter list every call of parameter `par` takes once the element's value
// parameters' holes `bNames` are bound to `bTys`, pushed onto `qs`; only `par`'s own calls count,
// none of them in a sibling element; false when there is no call, one stays open, or two disagree.
function monoElemPinTysUnder(
  par: i32,
  bNames: string[],
  bTys: i32[],
  _skip: i32[],
  qs: i32[],
): boolean {
  if bNames.length == 0 { return false }
  // Each call through the parameter, at its arguments' types; a read of it that is no
  // call's callee could hand it to another call, so none answers.
  const lists: i32[][] = []
  for cx in elabBindingCalls(par) {
    const cn = if cx >= 0 && cx < P.nodes.length { nodeAt(cx) } else { nodeAt(0) }
    if !(cn is Call) { return false }
    const tys: i32[] = []
    for a in cn.callArgs {
      // An argument the check left open takes the type every instance agrees on.
      const at = nodeTyIxOf(a)
      const et = if tyHasTyVar(at) { elabNodeTyAgreed(a) } else { -1 }
      tys.push(if et >= 0 { et } else { at })
    }
    lists.push(tys)
  }
  if lists.length == 0 { return false }
  let key = ""
  let got: i32[] = []
  for tys in lists {
    const sub: i32[] = []
    for t in tys {
      const st = substTyDeep(t, bNames, bTys)
      if st < 0 || tyHasTyVar(st) { return false }
      sub.push(st)
    }
    const k = pinSigOf(sub)
    if key != "" && k != key { return false }
    key = k
    got = sub
  }
  for t in got { qs.push(t) }
  true
}

// What call `n`, through list elements or `if` arms, hands as un-annotated parameters or hole
// lambdas: 2 when a parameter's type still holds a hole, 1 when each such one's is closed or the
// call hands only lambdas, 0 when it hands none.
function monoElemsParamArgs(n: Call): i32 {
  if monoCalleeElems(n.callFn, -1).length == 0 { return 0 }
  let out = 0
  for a in n.callArgs {
    const x = unwrapParen(a)
    if monoIsHoleLamArg(x) { out = 1 }
    if x >= 0 && x < P.nodes.length && nodeAt(x) is Ident {
      const d = identDeclOf(x)
      if d >= 0 && d < P.nodes.length {
        const dn = nodeAt(d)
        if dn is Param && dn.parType < 0 {
          if tyHasTyVar(nodeTyIxOf(x)) { return 2 }
          out = 1
        }
      }
    }
  }
  out
}

// Whether argument `a` is a lambda literal whose type still holds a hole, or a `const` alias of
// one (D7846).
function monoIsHoleLamArg(a: i32): boolean {
  const x = unwrapParen(a)
  if x < 0 || x >= P.nodes.length || !tyHasTyVar(nodeTyIxOf(x)) { return false }
  if nodeAt(x) is FuncDecl { return true }
  if !(nodeAt(x) is Ident) { return false }
  const d = identDeclOf(x)
  d >= 0
    && d < P.nodes.length
    && nodeAt(d) is LetDecl
    && elabOpenFnArgDecl(x) >= 0
}

// The refusal for a call `monoGenArgAtOpenParam` names, at node `ix` (D3956, D7183).
function monoGenArgOpenFail(ix: i32): i32 {
  emitFailAt(
    "emitProgram: a generic function is passed to a function value whose parameter type "
      + "names a type parameter this closure does not bind, so no instance of it can be "
      + "chosen — call the function value from the generic function's own body, or pass "
      + "a function of a concrete type",
    ix,
  )
}

// Whether call `n`, through a function value, hands a declared generic function to a parameter
// whose recorded type names a type variable, which leaves the generic with no instance.
function monoGenArgAtOpenParam(n: Call, ctx: i32): boolean {
  const ct = nodeTyIxOf(n.callFn)
  if ct < 0 || ct >= T.tys.length { return false }
  const f = tyAt(ct)
  if !(f is TyFunc) { return false }
  let i = 0
  while i < n.callArgs.length && i < f.fnParamTypes.length {
    const pt = f.fnParamTypes[i]
    if (
      pt >= 0
      && pt < T.tys.length
      && tyHasTyVar(pt)
      && monoNamesDeclaredGeneric(n.callArgs[i], ctx)
    ) {
      return true
    }
    i = i + 1
  }
  false
}

// Whether annotation node `annIx` is typed as a function or a nullable function: a slot a
// function value is delivered to.
function monoAnnIsFnSlot(annIx: i32): boolean {
  nodeTyIsFunc(annIx) || nodeTyIsNulFunc(annIx)
}

// Does this call hand a generic function value to a parameter whose annotation is an arrow
// riding the callee's own type parameters? The trigger for the pre-binding pass in
// `monoInstantiate`, asked so that pass changes nothing elsewhere: the two binding orders
// can only disagree when one parameter says `U = T` and another says `U = i32`.
function monoCallGenFnToTyParamArrow(
  params: i32[],
  args: i32[],
  typarams: string[],
  ctx: i32,
) {
  if typarams.length == 0 { return false }
  let i = 0
  while i < args.length && i < params.length {
    const p = nodeAt(params[i])
    if p is Param {
      if p.parType >= 0 {
        if (
          monoAnnIsFnSlot(p.parType)
          && monoAnnHasTyParam(p.parType, -1, typarams)
        ) {
          const ax = unwrapParen(args[i])
          if ax >= 0 {
            const av = nodeAt(ax)
            if av is Ident {
              const gfe = monoFnFeOfIdent(ax, av.identName, ctx)
              if gfe >= 0 && gfe < monoGen.length {
                if monoGen[gfe] == 1 { return true }
              }
              if monoHandLetRead(ax, ctx)[0] >= 0 { return true }
            }
            if monoArgIsOpenFnChoice(ax, 0) || monoArgCallsBackGeneric(ax) {
              return true
            }
          }
        }
        // A list of functions riding the type parameters, handed a literal of generics (D3913).
        if (
          nodeTyIsClosureArray(p.parType)
          && monoAnnHasTyParam(p.parType, -1, typarams)
        ) {
          if monoLitHoldsGenericFn(args[i], 0) { return true }
        }
      }
    }
    i = i + 1
  }
  false
}

// A call whose callee is a call (`a(x)(x)`, `a(x)(x)(x)`), whose recorded types are the
// template's: the callee and the call are typed at this instance's own (D3912, D3922).
function monoTypeCallOfCall(ix: i32, ctx: i32) {
  const n = nodeAt(ix)
  if !(n is Call) { return 0 }
  const cx = unwrapParen(n.callFn)
  if cx < 0 || !(nodeAt(cx) is Call) { return 0 }
  const ct = monoCallValueTy(cx, ctx, 0)
  if ct >= 0 { nodeTyRecord(cx, ct) }
  const t = monoCallValueTy(ix, ctx, 0)
  if t >= 0 { nodeTyRecord(ix, t) }
  0
}

// The type call `ix` yields at this instance: the result of the function type a call it calls
// yields, or else a named callee's declared return (`monoNamedCallTy`); -1 when unknown.
function monoCallValueTy(ix: i32, ctx: i32, depth: i32): i32 {
  if ix < 0 || depth > 16 { return -1 }
  const n = nodeAt(ix)
  if !(n is Call) { return -1 }
  const cx = unwrapParen(n.callFn)
  if cx < 0 { return -1 }
  if nodeAt(cx) is Call {
    const ct = monoCallValueTy(cx, ctx, depth + 1)
    if ct < 0 || ct >= T.tys.length { return -1 }
    const f = tyAt(ct)
    if f is TyFunc {
      if f.fnRet >= 0 && !tyHasTyVar(f.fnRet) { return f.fnRet }
    }
    return -1
  }
  monoNamedCallTy(cx, ctx)
}

// The declared return of the function callee `cx` names in frame `ctx`; -1 when it is no name, a
// parameter or local shadows it, or the type still names a type variable.
function monoNamedCallTy(cx: i32, ctx: i32): i32 {
  const c = nodeAt(cx)
  if !(c is Ident) { return -1 }
  if monoNameShadowedAt(c.identName, cx, ctx) { return -1 }
  const fe = fnIndexOfInScopeAt(sidOfNode(cx), c.identName, ctx, cx)
  if fe < 0 || fe >= fnStmts.length { return -1 }
  const fn = nodeAt(fnStmts[fe])
  if !(fn is FuncDecl) || fn.fnRet < 0 { return -1 }
  const rt = nodeTyIxOf(fn.fnRet)
  if rt < 0 || tyHasTyVar(rt) { return -1 }
  rt
}

// Whether list literal `ix` holds a generic function value, at any list depth, the checker's
// adapter lambda around one, or a value the checker typed as a function still open (D10250).
function monoLitHoldsGenericFn(ix: i32, depth: i32): boolean {
  const x = unwrapParen(ix)
  if x < 0 || depth > 8 { return false }
  const n = nodeAt(x)
  if n is ArrayLit {
    for e in n.arrElems {
      const ac = monoAdapterCallee(e)
      const et = nodeTyIxOf(unwrapParen(e))
      if (
        monoCalleeIsGeneric(unwrapParen(e))
        || (ac >= 0 && monoCalleeIsGeneric(unwrapParen(ac)))
        || (et >= 0 && et < T.tys.length && tyAt(et) is TyFunc && tyHasTyVar(et))
        || monoLitHoldsGenericFn(e, depth + 1)
      ) {
        return true
      }
    }
  }
  false
}

// The call's argument value nodes paired with the declaration's parameters: a named call
// (`f(b: 1, a: 2)`) binds by name, so `callArgs[i]` is not parameter `i`'s argument (D2344).
// A positional call, or a named one that does not bind every slot, keeps its source order.
function monoArgsInParamOrder(callIx: i32, declIx: i32): i32[] {
  const c = nodeAt(callIx)
  if c is Call {
    if !hasNamedArgs(c.callArgNames) { return c.callArgs }
    if declIx < 0 { return c.callArgs }
    const fn = nodeAt(declIx)
    if fn is FuncDecl {
      const pNames: string[] = []
      let i = 0
      while i < fn.fnParams.length {
        const p = nodeAt(fn.fnParams[i])
        if p is Param { pNames.push(p.parName) }
        i = i + 1
      }
      const slots = orderArgsByParamNames(pNames, c.callArgs, c.callArgNames)
      if slots.length != fn.fnParams.length { return c.callArgs }
      let k = 0
      while k < slots.length {
        if slots[k] < 0 { return c.callArgs }
        k = k + 1
      }
      return slots
    }
    return c.callArgs
  }
  const none: i32[] = []
  none
}

// Whether argument `ax` is an empty list literal, which names no element to bind a `T` from.
function monoArgIsEmptyLit(ax: i32): boolean {
  const n = nodeAt(unwrapParen(ax))
  if n is ArrayLit { return n.arrElems.length == 0 }
  false
}

// Whether pin type `t` is a function type.
function monoPinIsFnTy(t: i32): boolean {
  t >= 0 && t < T.tys.length && tyAt(t) is TyFunc
}

// Binds, ahead of `monoInstantiate`'s first-use loop, each type parameter whose first use is
// an empty list literal (`f([], d)`), from its first use that names an element: that loop
// would bind it to the literal's `i32[]` default, which the checker never inferred (D2607).
function monoPreBindPastEmptyLit(
  origFe: i32,
  callIx: i32,
  params: i32[],
  args: i32[],
  typarams: string[],
  tvN: string[],
  tvV: string[],
  tvT: i32[],
) {
  const seen: {[string]: i32} = Map()
  let i = 0
  while i < args.length && i < params.length {
    const tp = monoParamBareTyParam(params[i], typarams)
    if tp != "" && !seen.has(tp) {
      seen[tp] = 1
      if !strListHas(tvN, tp) && monoArgIsEmptyLit(args[i]) {
        const et = monoElabBindTy(origFe, callIx, tp)
        const sp = if et >= 0 { monoPinNominalSpelling(et) } else { "" }
        if sp != "" {
          tvN.push(tp)
          tvV.push(sp)
          monoTvTyLast(tvN, tvT, et)
        }
      }
    }
    i = i + 1
  }
  0
}

// The closed type the elaboration binds type parameter `tp` to at call `callIx` of the template
// in slot `origFe`, under the instance being walked; -1 for a call it did not key, a value
// declaration, or a binding that stays open.
function monoElabBindTy(origFe: i32, callIx: i32, tp: string): i32 {
  if origFe < 0 || origFe >= monoOrigNode.length { return -1 }
  const d = monoOrigNode[origFe]
  const tc = monoCallTplOf(callIx)
  if tc < 0 || elabDeclIsValue(d) { return -1 }
  const k = elabWalkKeyOf(tc, true, d)
  if k < 0 || k >= ekNames.length || k >= ekTys.length { return -1 }
  let i = 0
  while i < ekNames[k].length && i < ekTys[k].length {
    if ekNames[k][i] == tp {
      const t = ekTys[k][i]
      if t < 0 || t >= T.tys.length || tyHasTyVar(t) { return -1 }
      return t
    }
    i = i + 1
  }
  -1
}

// The index in `ms` of the one member naming a type parameter in `typarams`, or -1 when none or
// several do.
function monoTyOpenMember(ms: i32[], typarams: string[]): i32 {
  let open = -1
  let i = 0
  while i < ms.length {
    let names = false
    for tp in typarams {
      if tyMentionsTyVarNamed(ms[i], tp, 24) { names = true }
    }
    if names {
      if open >= 0 { return -1 }
      open = i
    }
    i = i + 1
  }
  open
}

// Whether declared parameter type `dt` is a union with one type-parameter member and a concrete
// member besides `null`. Its binding yields to every other parameter's, since the checker binds a
// type parameter from a nullable (`T | null`) in order but from such a union not at all.
function monoDeclIsOpenUnion(dt: i32, typarams: string[]): boolean {
  const ms: i32[] = []
  flattenVariantsInto(dt, ms)
  if ms.length < 2 { return false }
  const open = monoTyOpenMember(ms, typarams)
  if open < 0 { return false }
  let i = 0
  while i < ms.length {
    if i != open && ms[i] != TY_NULL { return true }
    i = i + 1
  }
  false
}

// Whether every member of argument type `at` is a concrete member of union `dt`, so its one
// type-parameter member is left free (`T | null` at `null`) and should bind elsewhere first.
function monoDeclLeavesOpenFree(dt: i32, at: i32, typarams: string[]): boolean {
  const ms: i32[] = []
  flattenVariantsInto(dt, ms)
  if ms.length < 2 { return false }
  const open = monoTyOpenMember(ms, typarams)
  if open < 0 { return false }
  const as: i32[] = []
  flattenVariantsInto(at, as)
  for a in as {
    let covered = false
    let j = 0
    while j < ms.length && !covered {
      if j != open && a >= 0 && ms[j] >= 0 && tySame(ms[j], a) {
        covered = true
      }
      j = j + 1
    }
    if !covered { return false }
  }
  true
}

// Whether declared parameter type `dt` at argument type `at` binds only after the call's others:
// a union the checker's walk passes over, or one whose argument leaves its type parameter free.
function monoPinDefers(dt: i32, at: i32, typarams: string[]): boolean {
  monoDeclIsOpenUnion(dt, typarams) || monoDeclLeavesOpenFree(dt, at, typarams)
}

// Per parameter of the call being instantiated: the argument's own spelling where the union
// parameter's substituted spelling cannot hold it, else "" (`monoPreBindPastUnionRest`).
let monoUnionRestPin: string[] = []

// Where some parameter's annotation is a union over a type parameter (`u: T | string`), binds
// every other type-parameter annotation from its argument first, so the union only fills a
// type parameter nothing else binds, as the checker's inference does (D2734). `decl` holds the
// generic's declared parameter types (`monoDeclParamTys`).
function monoPreBindPastUnionRest(
  origFe: i32,
  callIx: i32,
  params: i32[],
  args: i32[],
  typarams: string[],
  ctx: i32,
  tvN: string[],
  tvV: string[],
  tvT: i32[],
  decl: i32[],
) {
  monoUnionRestPin = []
  let z = 0
  while z < params.length {
    monoUnionRestPin.push("")
    z = z + 1
  }
  const anns: string[] = []
  const acts: string[] = []
  // Per parameter: its declared type where its annotation is a union over a type parameter,
  // else -1, and its argument's pinned type wherever `acts` spells one.
  const dts: i32[] = []
  const ats: i32[] = []
  let any = false
  let i = 0
  while i < params.length && i < args.length {
    let ann = ""
    let act = ""
    let isUnion = false
    let dt = -1
    let at = -1
    const p = nodeAt(params[i])
    if p is Param {
      if p.parType >= 0 {
        ann = monoDeclAnnName(p.parType, tyNameOf(p.parType), typarams)
        if (
          nodeTyIsFunc(p.parType)
          || !monoAnnHasTyParam(p.parType, -1, typarams)
        ) {
          ann = ""
        }
        const pt = nodeTyIxOf(p.parType)
        if pt >= 0 && pt < T.tys.length {
          const ptt = tyAt(pt)
          isUnion = ptt is TyUnion || ptt is TyNullable
        }
      }
    }
    // Only a union annotation can defer, so only its argument is spelled here: a pin name
    // renders the whole argument type, which a wide type makes dear.
    if ann != "" && isUnion {
      if i < decl.length { dt = decl[i] }
      const pa: i32[] = [at]
      act = monoPreBindArg(callIx, args, i, ctx, pa)
      if act != "" {
        at = pa[0]
        if monoPinDefers(dt, at, typarams) { any = true }
      }
    }
    anns.push(ann)
    acts.push(act)
    dts.push(dt)
    ats.push(at)
    i = i + 1
  }
  if !any { return 0 }
  let a = 0
  while a < anns.length {
    if anns[a] != "" && acts[a] == "" {
      const pa: i32[] = [ats[a]]
      acts[a] = monoPreBindArg(callIx, args, a, ctx, pa)
      ats[a] = pa[0]
    }
    a = a + 1
  }
  let j = 0
  while j < anns.length {
    if anns[j] != "" && acts[j] != "" {
      if !monoPinDefers(dts[j], ats[j], typarams) {
        let pt = -1
        if j < decl.length { pt = decl[j] }
        if pt < 0 {
          const pp = nodeAt(params[j])
          if pp is Param { pt = nodeTyIxOf(pp.parType) }
        }
        const n0 = tvN.length
        monoBindArenaFullTys(pt, ats[j], typarams, tvN, tvV, tvT)
        // Each binding the walk adds takes the elaboration's binding for the call where that is closed.
        let ek = n0
        while ek < tvN.length && ek < tvT.length {
          const et = elabCallBindTy(monoCallTplOf(callIx), tvN[ek])
          const esp = if et >= 0 && et < T.tys.length && !tyHasTyVar(et) && !tyReachesHole(et, 16) { monoPinAnnSpelling(et) } else { "" }
          if esp != "" {
            tvT[ek] = et
            if ek < tvV.length { tvV[ek] = esp }
          }
          ek = ek + 1
        }
      }
    }
    j = j + 1
  }
  // A union parameter whose spelling, at the bindings above, cannot hold its argument is pinned
  // at the argument's own type, as an un-annotated parameter is, so the two reps agree.
  let k = 0
  while k < anns.length {
    if anns[k] != "" && acts[k] != "" {
      if monoDeclIsOpenUnion(dts[k], typarams) {
        // A union whose substituted type holds the argument by its checked type, or by the type
        // its pin reads at, does hold it: a literal spells its base.
        const st = substTyDeep(dts[k], tvN, tvT)
        if st >= 0 && !tyHasTyVar(st) {
          const lt = litTyOfExpr(args[k])
          const at = if lt >= 0 { lt } else { nodeTyIxOf(unwrapParen(args[k])) }
          const holds = at >= 0 && !tyHasTyVar(at) && assignable(at, st)
          const pinHolds = ats[k] >= 0
            && !tyHasTyVar(ats[k])
            && assignable(ats[k], st)
          if !holds && !pinHolds { monoUnionRestPin[k] = acts[k] }
        }
      }
    }
    k = k + 1
  }
  // Each type parameter a bare `T` parameter binds joins the call's arena bindings at the
  // elaboration's binding, so a union parameter over `T` is minted there as an explicit type
  // argument mints it (D2734).
  let b = 0
  while b < params.length && b < args.length {
    const bp = nodeAt(params[b])
    if bp is Param && bp.parType >= 0 {
      const bpt = nodeTyIxOf(bp.parType)
      const tp = monoTyParamOfTy(bpt, typarams)
      const bare = tp != ""
        && bpt >= 0
        && bpt < T.tys.length
        && tyAt(bpt) is TyVar
      if bare && !strListHas(monoExplicitBN, tp) {
        const et = monoElabBindTy(origFe, callIx, tp)
        if et >= 0 {
          monoExplicitBN.push(tp)
          monoExplicitBT.push(et)
        }
      }
    }
    b = b + 1
  }
  0
}

// The pin name of call `callIx`'s argument `i` for the pre-bind, read inside function `ctx`, with
// its pinned type written to `ty[0]` when the name is not "". A bare `null` is its checked type,
// which no parameter could bind from, whatever its recorded pin.
function monoPreBindArg(
  callIx: i32,
  args: i32[],
  i: i32,
  ctx: i32,
  ty: i32[],
): string {
  const ax = args[i]
  const x = unwrapParen(ax)
  if x >= 0 && x < P.nodes.length && nodeAt(x) is NullLit {
    ty[0] = nodeTyIxOf(x)
    return tyToStr(ty[0])
  }
  // A generic function handed on pins at the function type the call's instance closes it to.
  if (
    x >= 0
    && x < P.nodes.length
    && nodeAt(x) is Ident
    && monoCalleeIsGeneric(x)
  ) {
    const et = elabCallParamTy(monoCallTplOf(callIx), i)
    const en = if et >= 0 && et < T.tys.length { tyAt(et) } else { null }
    const ft = if en is TyNullable { en.nInner } else { et }
    const sk = if ft >= 0 && ft < T.tys.length && tyAt(ft) is TyFunc && !tyHasTyVar(ft) { sigKeyOfTy(ft) } else { "" }
    if sk != "" {
      ty[0] = ft
      return "=>" + sk
    }
  }
  const nm = monoArgPinName(ax, ctx, [0 - 1])
  if nm != "" { ty[0] = elabNodeTyOrChecked(ax, ctx) }
  nm
}

// Instantiate (or reuse) the instance of generic `origFe` for the call at
// `callIx` (whose enclosing function is `ctx`, -1 = top level), and point the
// call site at it. Returns 0, or -1 via `emitFail`.
function monoInstantiate(origFe: i32, callIx: i32, ctx: i32) {
  const saved = monoDestPinOff
  monoDestPinOff = monoCalleeHasTyParamArrow(origFe)
  const c = nodeAt(callIx)
  if ctx < 0 && c is Call {
    monoOpenArgCall = callIx
    monoOpenArgCallee = c.callFn
  }
  // A refusal raised while this call is monomorphized is anchored at the call (D15154).
  const savedStmt = emitCurStmtIx
  emitCurStmtIx = callIx
  const r = monoInstantiateCall(origFe, callIx, ctx)
  emitCurStmtIx = savedStmt
  monoOpenArgCall = 0 - 1
  monoOpenArgCallee = 0 - 1
  monoDestPinOff = saved
  r
}

// Whether the generic at `origFe` declares a function-typed parameter that mentions one of its
// type parameters: a lambda argument there is built at the type the checker bound, so a list
// argument may not be re-pinned at its destination's list (D2747).
function monoCalleeHasTyParamArrow(origFe: i32): boolean {
  if origFe < 0 || origFe >= monoOrigNode.length { return false }
  const fn = nodeAt(monoOrigNode[origFe])
  if fn is FuncDecl {
    let i = 0
    while i < fn.fnParams.length {
      const p = nodeAt(fn.fnParams[i])
      if p is Param {
        if p.parType >= 0 {
          if (
            nodeTyIsFunc(p.parType)
            && monoAnnHasTyParam(p.parType, -1, fn.fnTyParams)
          ) {
            return true
          }
        }
      }
      i = i + 1
    }
  }
  false
}

// Whether parameter `pIx` is annotated as a list whose spelling names one of `typarams`.
function monoParamIsTyParamList(pIx: i32, typarams: string[]): boolean {
  const p = nodeAt(pIx)
  if p is Param {
    if p.parType < 0 { return false }
    return monoTyIsList(nodeTyIxOf(p.parType))
      && monoAnnHasTyParam(p.parType, -1, typarams)
  }
  false
}

// The one place a generic `argIx` handed to hole `pIx` of call `callIx` gets its signature: the
// checker's binding, else the generic instanced at the one type its read is delivered at past the
// call (D5612), delivered concretely so the callee can forward it. "" when none closes; `tyOut[0]`
// takes that type. Two such types ask for a parameter per type and set `monoHoleGenTwoPins` (D6280).
let monoHoleGenTwoPins = false
// Whether that read's flow slot holds two pins, whoever's calls took them.
let monoHoleGenManyPins = false
function monoHoleGenFnPin(
  callIx: i32,
  pIx: i32,
  argIx: i32,
  ctx: i32,
  tyOut: i32[],
): string {
  monoHoleGenTwoPins = false
  monoHoleGenManyPins = false
  const bt = monoHoleGenFnTy(callIx, pIx, argIx, ctx)
  const fl = monoHoleGenFnFlowDecl(argIx, ctx)
  if bt >= 0 {
    // The checker's binding stands; the open function values its pin call hands on still take
    // that binding's parameter types (D6532).
    const an = monoFnPinAt(argIx, ctx, bt, -1, tyOut)
    if an != "" && fl[1] >= 0 { monoPinOpenCallLamsAt(fl[1], bt) }
    return an
  }
  // The instance a generic's slot delivery fixes is the elaboration's (`elabHoleGenFlowTy`).
  let ft = elabHoleGenFlowTy(argIx, elabHoleGenFlowHolder(argIx))
  if ft < 0 { ft = monoChoiceArmFlowTy(argIx, ctx, 0) }
  // The elaboration's binding of an un-annotated parameter handed a declared generic, where the
  // calls through the result fix it (D5530), in the instance frame `ctx` stands for.
  const cn = nodeAt(callIx)
  const pn = nodeAt(pIx)
  const gd = identFnDeclOf(unwrapParen(argIx))
  const gn = if gd >= 0 && gd < P.nodes.length { nodeAt(gd) } else { nodeAt(0) }
  const ai = if cn is Call { i32ListIndexOf(cn.callArgs, argIx) } else { -1 }
  if (
    ft < 0
    && ai >= 0
    && pn is Param
    && pn.parType < 0
    && gn is FuncDecl
    && gn.fnTyParams.length > 0
  ) {
    const it = monoFrameInstTmpl(ctx)
    const from = if it[0] >= 0 { elabKeyAt(it[0]) } else { -1 }
    const et = elabCallParamTyFrom(monoCallTplOf(callIx), ai, from)
    if monoTyClosedFn(et) { ft = et }
  }
  // Whether the hole is called at two types; the deliveries may stop at a recursive forward
  // before they reach both (D6091).
  if ft < 0 && fl[1] >= 0 {
    const noPath: string[] = []
    monoHoleGenManyPins = monoDeclPathPins(fl, noPath).length > 1
    monoHoleGenTwoPins = monoHoleGenManyPins
      && monoHoleOwnCallsDiffer(fl[1], pIx)
  }
  monoFnPinAt(argIx, ctx, ft, fl[1], tyOut)
}

// For an `if` argument `argIx` read in frame `ctx`, every arm naming a generic, the closed type
// the first arm whose read has one delivery takes there, as that read handed alone would;
// -1 for any other argument or when no arm's read has one (D13282).
function monoChoiceArmFlowTy(argIx: i32, ctx: i32, depth: i32): i32 {
  const ax = unwrapParen(argIx)
  if ax < 0 || depth > MONO_ALIAS_CHAIN_MAX { return -1 }
  const n = nodeAt(ax)
  if !(n is IfStmt) || n.ifElse < 0 { return -1 }
  if depth == 0 && !monoValueNamesGenerics(ax, ctx, 0) { return -1 }
  for arm in [n.ifThen, n.ifElse] {
    if !monoArmEndsNever(arm) {
      const tv = monoArmTailValue(arm)
      const v = if tv >= 0 { tv } else { arm }
      let t = monoChoiceArmFlowTy(v, ctx, depth + 1)
      if t < 0 { t = elabHoleGenFlowTy(v, elabHoleGenFlowHolder(v)) }
      if t >= 0 { return t }
    }
  }
  -1
}

// Whether two calls of the hole `pIx` itself take different parameter types, as every instance
// agrees on them; calls downstream of it, through a binding or another callee, do not count. The
// slot `_d` the hole's argument fills names no call of `pIx` the hole's own rows do not.
function monoHoleOwnCallsDiffer(_d: i32, pIx: i32): boolean {
  let first: i32[] = []
  let seen = false
  for cx in elabBindingCalls(pIx) {
    const c = if cx >= 0 { nodeAt(cx) } else { nodeAt(0) }
    if c is Call {
      const f = unwrapParen(c.callFn)
      if f >= 0 && nodeAt(f) is Ident && identDeclOf(f) == pIx {
        const tys = elabCallArgTysAgreed(cx)
        if tys.length > 0 {
          if !seen {
            first = tys
            seen = true
          } else if !monoI32sSame(first, tys) {
            return true
          }
        }
      }
    }
  }
  false
}

function monoI32sSame(a: i32[], b: i32[]): boolean {
  if a.length != b.length { return false }
  let i = 0
  while i < a.length {
    if a[i] != b[i] { return false }
    i += 1
  }
  true
}

// `argIx` delivered at the concrete function type `bt`, and its pin name; each call taking the
// flow pin of `flowDecl` (-1 for none) whose callee the checker left open is typed at it.
function monoFnPinAt(
  argIx: i32,
  ctx: i32,
  bt: i32,
  flowDecl: i32,
  tyOut: i32[],
): string {
  const nm = monoConcreteFnTyName(bt)
  if nm == "" { return "" }
  if monoCoerceFnValueName(argIx, ctx, bt) < 0 { return "" }
  // A hole lambda literal no call instances, as one handed to a parameter nothing reads, takes
  // the pin itself; one already instanced keeps its instance (D6301).
  monoLamLitTakeTys(argIx, ctx, [], bt)
  if flowDecl >= 0 {
    const noPath: string[] = []
    monoRetypePinCalls(flowDecl, noPath)
    monoPinOpenCallLamsAt(flowDecl, bt)
  }
  tyOut[0] = bt
  const sk = sigKeyOfTy(bt)
  if sk != "" { return "=>" + sk }
  const an = monoArgFnTypeName(argIx, ctx)
  if an != "" { return an }
  nm
}

// The pin of argument `args[i]` of call `callIx` (in frame `ctx`) whose type the checker left
// open, at `t`, the closed type the elaboration answers its parameter with: a literal the checker
// copied per type takes its copy there (D5880), anything else is delivered by `monoElabDeliver`;
// "" when `t` is no answer or the argument is not one it reaches.
function monoElabPin(
  callIx: i32,
  args: i32[],
  i: i32,
  t: i32,
  ctx: i32,
): string {
  const x = unwrapParen(args[i])
  if x < 0 || t < 0 || t >= T.tys.length || tyHasTyVar(t) { return "" }
  const cps = holeLitCopiesOf(x)
  if cps.length > 0 { return monoElabLitCopy(callIx, args, i, cps, t, ctx) }
  if !monoTyOpen(nodeTyIxOf(x)) {
    const cn = monoClosedTyName(t)
    if cn != "" { return cn }
    if tyMayHoldFn(t, 0) || tyHoldsObj(t, 8) || tyIsUnionish(t) { return "" }
    return monoI32AtomPinName(t)
  }
  if !monoElabDeliver(x, t, ctx, false, false) {
    return monoElabFreshLitPin(x, t)
  }
  if nodeAt(x) is FuncDecl && tyAt(t) is TyFunc {
    if !monoElabLamArg(callIx, args, i, ctx, t) { return "" }
  } else {
    monoElabDeliver(x, t, ctx, false, true)
  }
  if tyAt(t) is TyFunc {
    const sk = sigKeyOfTy(t)
    if sk != "" { return "=>" + sk }
    const an = monoArgFnTypeName(x, ctx)
    if an != "" { return an }
    return monoConcreteFnTyName(t)
  }
  monoClosedTyPin(t)
}

// The pin of list or record literal `x` passed straight to a parameter the elaboration closes
// at `t`: the literal is built at its destination, as at any delivery (D5930). "" for any other
// argument, one that already has the type `t`, or a `t` of another shape.
function monoElabFreshLitPin(x: i32, t: i32): string {
  const n = nodeAt(x)
  if !(n is ArrayLit || n is ObjLit) { return "" }
  const own = nodeTyIxOf(x)
  if own >= 0 && !tyHasTyVar(own) && assignable(own, t) && assignable(t, own) {
    return ""
  }
  let tv = tyAt(t)
  if tv is TyNullable {
    if tv.nInner < 0 || tv.nInner >= T.tys.length { return "" }
    tv = tyAt(tv.nInner)
  }
  if n is ArrayLit && !(tv is TyArray) { return "" }
  if n is ObjLit && !(tv is TyObj) { return "" }
  monoI32AtomPinName(t)
}

// Hole lambda literal `args[i]` of call `callIx` delivered at function type `annTy`: one wanted
// at two types takes an instance per type, which replaces it in the call and in `args`; false
// when it is refused.
function monoElabLamArg(
  callIx: i32,
  args: i32[],
  i: i32,
  ctx: i32,
  annTy: i32,
): boolean {
  const c = nodeAt(callIx)
  if !(c is Call) { return false }
  let k = 0
  while k < c.callArgs.length && c.callArgs[k] != args[i] { k = k + 1 }
  if monoDeliverLamLit(args[i], ctx, callIx, annTy) != 0 { return false }
  if k < c.callArgs.length { args[i] = c.callArgs[k] }
  true
}

// The copy among `cps` of literal `args[i]` the checker pinned at `t`, put in its place in call
// `callIx`, and its pin; "" when no copy is pinned there.
function monoElabLitCopy(
  callIx: i32,
  args: i32[],
  i: i32,
  cps: i32[],
  t: i32,
  ctx: i32,
): string {
  const c = nodeAt(callIx)
  if !(c is Call) { return "" }
  let k = 0
  while k < c.callArgs.length && c.callArgs[k] != args[i] { k = k + 1 }
  if k >= c.callArgs.length { return "" }
  for cp in cps {
    const pt = holeLitPinOf(cp)
    if pt >= 0 && tySameSpelled(pt, t, TY_WALK_DEPTH) {
      const nm = monoArgPinName(cp, ctx, [0 - 1])
      if nm == "" { return "" }
      c.callArgs[k] = cp
      args[i] = cp
      return nm
    }
  }
  ""
}

// Whether `x` takes closed type `t`: a function value there, or a list or record literal of
// values or closed bindings' reads, each part at its own slot's type; with `go`, delivers each
// function value there and retypes each literal the checker left open. A literal inside an
// instance (`inst`) shares the node with its template and is not retyped.
function monoElabDeliver(
  ax: i32,
  t: i32,
  ctx: i32,
  inst: boolean,
  go: boolean,
): boolean {
  const x = unwrapParen(ax)
  if x < 0 || x >= P.nodes.length || t < 0 || t >= T.tys.length { return false }
  const xt = nodeTyIxOf(x)
  if !monoTyOpen(xt) { return true }
  const n = nodeAt(x)
  const tt = tyAt(t)
  if tt is TyFunc {
    const nm = monoConcreteFnTyName(t)
    if nm == "" || inst && !(n is Ident) { return false }
    if go && n is FuncDecl { monoLamLitTakeTys(x, ctx, [], t) }
    if go && !(n is FuncDecl) { monoCoerceFnValueName(x, ctx, t) }
    return true
  }
  const li = inst || monoFrameIsGenericInstance(ctx)
  // A value `if` takes `t` at each arm's value, as each arm produces the whole value (D15301).
  if n is IfStmt {
    const tv = ifArmValueExpr(n.ifThen)
    const ev = ifArmValueExpr(n.ifElse)
    if tv < 0 || ev < 0 { return false }
    if (
      !monoElabDeliver(tv, t, ctx, li, go)
      || !monoElabDeliver(ev, t, ctx, li, go)
    ) {
      return false
    }
    if go && !li { nodeTyRecord(x, t) }
    return true
  }
  if n is ArrayLit && tt is TyArray {
    for e in n.arrElems {
      if !monoElabDeliver(e, tt.aElem, ctx, li, go) { return false }
    }
    if go && !li { nodeTyRecord(x, t) }
    return true
  }
  if !(n is ArrayLit) && !(n is ObjLit) {
    const bt = monoClosedReadTy(x, ctx, false)
    if bt >= 0 && tySameSpelled(bt, t, TY_WALK_DEPTH) {
      if go && !li { nodeTyRecord(x, bt) }
      return true
    }
    return false
  }
  if !(n is ObjLit) || !(tt is TyObj) { return false }
  for fi in n.objFields {
    const f = nodeAt(fi)
    if !(f is FieldInit) { return false }
    let k = 0
    while k < tt.objFieldNames.length && tt.objFieldNames[k] != f.fiName {
      k = k + 1
    }
    if k >= tt.objFieldTypes.length { return false }
    if !monoElabDeliver(f.fiValue, tt.objFieldTypes[k], ctx, li, go) {
      return false
    }
  }
  if go && !li {
    monoSupersededObjTys.push(xt)
    nodeTyRecord(x, t)
    monoGradualObjList.push(x)
  }
  true
}

// The open-call lambda pins a call's hole parameters hand on, queued while the call pins so each
// lambda's instance is demanded under the instance the call builds: flushed once that instance is
// demanded, or when the call returns without one. `Defer` is the call queuing, -1 for none.
let monoOpenLamD: i32[] = []
let monoOpenLamT: i32[] = []
let monoOpenLamDefer = 0 - 1
let monoOpenLamOwner = 0 - 1
let monoOpenLamMark = 0

// `monoPinOpenCallLams`, queued while a call is pinning its parameters.
function monoPinOpenCallLamsAt(d: i32, bt: i32) {
  if monoOpenLamDefer < 0 { return monoPinOpenCallLams(d, bt) }
  monoOpenLamD.push(d)
  monoOpenLamT.push(bt)
  0
}

// Pins the queued entries from `mark` on, in queue order, and drops them.
function monoOpenLamFlush(mark: i32) {
  const ds: i32[] = []
  const ts: i32[] = []
  while monoOpenLamD.length > mark {
    ds.push(monoOpenLamD.pop() ?? -1)
    ts.push(monoOpenLamT.pop() ?? -1)
  }
  let i = ds.length - 1
  while i >= 0 {
    monoPinOpenCallLams(ds[i], ts[i])
    i = i - 1
  }
  0
}

// Each hole lambda literal handed to the one call pinning the slot of `d` open takes the parameter
// type of `bt`, the concrete function type that call is delivered at (D6543).
function monoPinOpenCallLams(d: i32, bt: i32) {
  // The one call the value's forward climb reaches.
  const cx = elabValueOnlyCall(d)
  if cx < 0 || bt < 0 || bt >= T.tys.length { return 0 }
  const c = nodeAt(cx)
  const bf = tyAt(bt)
  if !(c is Call) || !(bf is TyFunc) { return 0 }
  if bf.fnParamTypes.length != c.callArgs.length { return 0 }
  // The frame making the one pin call, where its lambda arguments are instanced.
  const fn0 = monoTopFrameOf(cx)
  let j = 0
  while j < c.callArgs.length {
    const nm = monoConcreteFnTyName(bf.fnParamTypes[j])
    const ax = unwrapParen(c.callArgs[j])
    if (
      nm != ""
      && ax >= 0
      && nodeAt(ax) is Ident
      && elabOpenFnArgDecl(ax) >= 0
    ) {
      monoCoerceFnValueName(ax, fn0, bf.fnParamTypes[j])
    } else if nm != "" {
      monoLamLitTakeTys(c.callArgs[j], fn0, [], bf.fnParamTypes[j])
    }
    j = j + 1
  }
  // A callee the checker left open takes `bt`, so a hole function named as an argument is
  // delivered at that parameter type (D6532).
  const cf = unwrapParen(c.callFn)
  const ct = nodeTyIxOf(cf)
  if (
    cf >= 0
    && ct >= 0
    && ct < T.tys.length
    && tyAt(ct) is TyFunc
    && tyHasTyVar(ct)
    && monoWritesTypedAt(d, bf.fnParamTypes)
  ) {
    nodeTyRecord(cf, bt)
  }
  0
}

// The frame and binding (`monoReadLetFrame`) whose deliveries are those of generic `argIx` read in
// frame `ctx`: the read itself in `ctx` unless it names a `let`; `[-1, -1]` when `argIx` does not
// name a generic.
function monoHoleGenFnFlowDecl(argIx: i32, ctx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1]
  const ax = unwrapParen(argIx)
  if ax < 0 { return none }
  if (
    !monoNamesDeclaredGeneric(ax, ctx)
    && !monoCalleeIsGeneric(ax)
    && monoReadGenFnFe(ax) < 0
  ) {
    return none
  }
  const lf = monoReadLetFrame(ax, ctx)
  if lf[1] >= 0 { return lf }
  const out: i32[] = [ctx, ax]
  out
}

// The lambda an instance cloned as `lx` at a type still open, which carries no type of its own;
// `lx` itself otherwise.
function monoLamTypedTemplate(lx: i32): i32 {
  if lx < 0 || nodeTyIxOf(lx) >= 0 { return lx }
  monoLamCloneTmpl.get(lx) ?? lx
}

// `elabFnDeclRetAtUnder` of the lambda `lx0` an instance cloned, read at its template.
function monoFnDeclRetAtUnder(
  lx0: i32,
  qs: i32[],
  bN: string[],
  bT: i32[],
): i32 {
  elabFnDeclRetAtUnder(monoLamTypedTemplate(lx0), qs, bN, bT)
}

// Whether argument `a` is an open function value: an un-annotated lambda, a hole function or a
// binding of one typed open, or a hole or bare type-parameter parameter instance `fnIx` binds to
// named generics only (D10382, D15575).
function monoArgIsOpenFnValue(a: i32, fnIx: i32): boolean {
  const x = unwrapParen(a)
  if x < 0 || !(nodeAt(x) is Ident) { return false }
  if elabOpenFnArgDecl(x) >= 0 { return tyHasTyVar(nodeTyIxOf(x)) }
  const d = identDeclOf(x)
  if fnIx < 0 || d < 0 || d >= P.nodes.length { return false }
  const dn = nodeAt(d)
  if !(dn is Param) { return false }
  if dn.parType >= 0 && !(tyAt(nodeTyIxOf(x)) is TyVar) { return false }
  const t = elabInstTyAt(nodeTyIxOf(x), fnIx)
  const s = if t >= 0 { elabFnSetOf(t) } else { [] }
  for m in s {
    const f = if m >= 0 && m < P.nodes.length { nodeAt(m) } else { nodeAt(0) }
    if !(f is FuncDecl) || f.fnTyParams.length == 0 { return false }
  }
  s.length > 0
}

// Whether argument `a` is a call, or an un-annotated `const` of one, every value of which is a
// generic function its callee returns (`const v = mk()`, `function mk() { id }`), typed open.
function monoArgCallsBackGeneric(a: i32): boolean {
  const x = unwrapParen(a)
  if x < 0 || !tyHasTyVar(nodeTyIxOf(x)) { return false }
  let c = x
  let hops = 0
  while c >= 0 && nodeAt(c) is Ident && hops < MONO_ALIAS_CHAIN_MAX {
    const d = identDeclOf(c)
    if d < 0 || d >= P.nodes.length { return false }
    const dn = nodeAt(d)
    if !(dn is LetDecl) || dn.letKw != "const" || dn.letType >= 0 {
      return false
    }
    c = unwrapParen(dn.letInit)
    hops = hops + 1
  }
  if c < 0 || !(nodeAt(c) is Call) { return false }
  const fes: i32[] = []
  const at: i32[] = []
  monoInertArgFns(c, fes, at, 0) && fes.length > 0
}

// Whether argument `a` is an `if` whose arms each name a function, one of them generic or
// un-annotated, so it takes the type the value arguments bind as either function would (D9005).
function monoArgIsOpenFnChoice(a: i32, depth: i32): boolean {
  const x = unwrapParen(a)
  if x < 0 || depth > MONO_ALIAS_CHAIN_MAX { return false }
  const n = nodeAt(x)
  // A never-written, un-annotated binding of one is that `if` (D9080).
  if n is Ident {
    const d = identDeclOf(x)
    if d < 0 || d >= P.nodes.length { return false }
    const dn = nodeAt(d)
    if !(dn is LetDecl) || dn.letType >= 0 || dn.letInit < 0 { return false }
    if cboxDeclWritten(x) { return false }
    return monoArgIsOpenFnChoice(dn.letInit, depth + 1)
  }
  if !(n is IfStmt) || n.ifElse < 0 { return false }
  let open = false
  for arm in [n.ifThen, n.ifElse] {
    if !monoArmEndsNever(arm) {
      const tv = ifArmValueExpr(arm)
      const v = unwrapParen(if tv >= 0 { tv } else { arm })
      if v < 0 { return false }
      if monoCalleeIsGeneric(v) || monoArgIsOpenFnValue(v, -1) { open = true }
      else if monoArgIsOpenFnChoice(v, depth + 1) { open = true }
      else if !(nodeAt(v) is Ident) || fnIndexOfNode(v) < 0 { return false }
    }
  }
  open
}

// The concrete function type the checker bound hole parameter `pIx` to at call `callIx`, when
// `argIx` (in frame `ctx`) is a generic function: named, through never-written aliases, an `if`
// naming one in every arm, or a value typed at a foreign generic's open signature, as a call
// returning one is (D5401); -1 otherwise.
function monoHoleGenFnTy(callIx: i32, pIx: i32, argIx: i32, ctx: i32): i32 {
  const ax = unwrapParen(argIx)
  if ax < 0 { return -1 }
  if (
    !monoCalleeIsGeneric(ax)
    && monoReadGenFnFe(ax) < 0
    && !tyIsForeignGenericSig(nodeTyIxOf(ax))
    && !(nodeAt(ax) is IfStmt && monoValueNamesGenerics(ax, ctx, 0))
  ) {
    return -1
  }
  const pt = nodeTyIxOf(pIx)
  if pt < 0 || pt >= T.tys.length { return -1 }
  const pv = tyAt(pt)
  if !(pv is TyVar) { return -1 }
  let bc = callIx
  if !callBindHas(callIx) { bc = monoCallTplOf(callIx) }
  const bt = callBindTyOf(bc, pv.tvName)
  if bt < 0 || bt >= T.tys.length || tyHasTyVar(bt) { return -1 }
  if !(tyAt(bt) is TyFunc) { return -1 }
  bt
}

// Whether parameter `pIx` of `fn`, handed the parameter read `argIx` pinned at function type
// `pinTy`, is called in `fn`'s body with a closed argument the pin's parameter does not take, as
// a recursion handing two such parameters back in swapped positions does (D6202).
function monoFwdFnPinMisfits(
  fn: FuncDecl,
  pIx: i32,
  argIx: i32,
  pinTy: i32,
): boolean {
  if !monoReadsParam(argIx) || pinTy < 0 || pinTy >= T.tys.length {
    return false
  }
  const pf = tyAt(pinTy)
  if !(pf is TyFunc) { return false }
  const stack: i32[] = [fn.fnBody]
  while stack.length > 0 {
    const ix = stack.pop()
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if (
        n is Call
        && n.callFn >= 0
        && n.callFn < P.nodes.length
        && nodeAt(n.callFn) is Ident
        && identDeclOf(n.callFn) == pIx
        && monoCallArgsMisfit(n, pf)
      ) {
        return true
      }
      for c in nodeChildren(ix) { stack.push(c) }
    }
  }
  false
}

// Whether call `n` passes as many arguments as `pf` takes and one of them, closed, is a type
// unrelated to `pf`'s parameter at its position (`monoArgRelated`).
function monoCallArgsMisfit(n: Call, pf: TyFunc): boolean {
  if n.callArgs.length != pf.fnParamTypes.length { return false }
  let k = 0
  while k < n.callArgs.length {
    const at = nodeTyIxOf(n.callArgs[k])
    if at >= 0 && !tyHasTyVar(at) && !monoArgRelated(at, pf.fnParamTypes[k]) {
      return true
    }
    k = k + 1
  }
  false
}

// Whether argument type `at` fits parameter type `pt` or one of `pt`'s members fits `at`, as a
// member literal read at its widened type does (`"y"` as `string` against `"x" | "y" | null`).
function monoArgRelated(at: i32, pt: i32): boolean {
  if assignable(at, pt) { return true }
  const ms: i32[] = []
  flattenVariantsInto(pt, ms)
  for m in ms {
    if m >= 0 && assignable(m, at) { return true }
  }
  false
}

// Whether hole parameter `pIx` of `fn`, pinned at function type `pinTy`, is copied (`b = a`,
// `let b = a`, through further copies) into a binding that `fn`'s body calls with a closed
// argument the pin does not take; the split plan gives the parameter one per type (D6520).
function monoHoleCopyCallsMisfit(fn: FuncDecl, pIx: i32, pinTy: i32): boolean {
  if pinTy < 0 || pinTy >= T.tys.length { return false }
  const pf = tyAt(pinTy)
  if !(pf is TyFunc) { return false }
  const copies: i32[] = [pIx]
  const nodes: i32[] = []
  const stack: i32[] = [fn.fnBody]
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      nodes.push(ix)
      for c in nodeChildren(ix) { stack.push(c) }
    }
  }
  let grew = true
  let rounds = 0
  while grew && rounds < MONO_ALIAS_CHAIN_MAX {
    grew = false
    rounds = rounds + 1
    for ix in nodes {
      const d = monoCopyDeclOf(ix, copies)
      if d >= 0 && !i32ListHas(copies, d) {
        copies.push(d)
        grew = true
      }
    }
  }
  if copies.length == 1 { return false }
  for ix in nodes {
    const n = nodeAt(ix)
    if n is Call {
      const f = unwrapParen(n.callFn)
      if f >= 0 && nodeAt(f) is Ident {
        const d = identDeclOf(f)
        if d != pIx && i32ListHas(copies, d) && monoCallArgsMisfit(n, pf) {
          return true
        }
      }
    }
  }
  false
}

// The `let` node `ix` copies a read of one of `from` into (`b = a`, `let b = a`); -1 otherwise.
function monoCopyDeclOf(ix: i32, from: i32[]): i32 {
  const n = nodeAt(ix)
  if n is LetDecl {
    const v = unwrapParen(n.letInit)
    if v >= 0 && nodeAt(v) is Ident && i32ListHas(from, identDeclOf(v)) {
      return ix
    }
    return -1
  }
  if !(n is BinExpr) || n.binOp != "=" { return -1 }
  const v = unwrapParen(n.binRight)
  if v < 0 || !(nodeAt(v) is Ident) || !i32ListHas(from, identDeclOf(v)) {
    return -1
  }
  if !(nodeAt(n.binLeft) is Ident) { return -1 }
  const d = identDeclOf(n.binLeft)
  if d >= 0 && d < P.nodes.length && nodeAt(d) is LetDecl { return d }
  -1
}

// Whether argument `argIx` reads a parameter of the function it is in.
function monoReadsParam(argIx: i32): boolean {
  const ax = unwrapParen(argIx)
  if ax < 0 || !(nodeAt(ax) is Ident) { return false }
  const d = identDeclOf(ax)
  d >= 0 && d < P.nodes.length && nodeAt(d) is Param
}

// The refusal `monoFwdFnPinMisfits` answers when the split plan cannot give the parameter a
// slot per type.
function monoFwdFnPinFail(par: string, callee: string): i32 {
  emitFail(
    "emitProgram: monomorphize: a function parameter handed on to `"
      + par
      + "` in a call to `"
      + callee
      + "` is called there at a type it does not take",
  )
}

// The refusal for a generic parameter `par` of `callee` whose reads the flow pins at two types
// no split separates, as a copy into a binding called at another type does (D6423). Recorded
// without halting, so the compile still asks for every split it reaches.
function monoHoleManyPinsFail(par: string, callee: string): i32 {
  emitFail(
    "emitProgram: monomorphize: parameter `"
      + par
      + "` of `"
      + callee
      + "` is called at two function types that no parameter per type separates",
  )
}

// The pin for the parameter of template `oDecl` handed `argIx` when the argument, or each element
// of its list literal, is hole functions whose value reaches nothing (`vrInert`): the
// stub's `() -> void` (D6881, D7002), a called one's closure taken unread (D6931, D7000). ""
// otherwise; `tyOut[0]` takes the type.
function monoInertParamStubPin(oDecl: i32, argIx: i32, tyOut: i32[]): string {
  if oDecl < 0 || argIx < 0 || argIx >= P.nodes.length { return "" }
  const fes: i32[] = []
  const at: i32[] = []
  const ax = unwrapParen(argIx)
  if ax < 0 { return "" }
  const al = nodeAt(ax)
  let list = false
  // A list of list literals is each row's functions, at the stub's list of lists (D9765).
  let rows = false
  if al is ArrayLit {
    if al.arrElems.length == 0 { return "" }
    rows = nodeAt(unwrapParen(al.arrElems[0])) is ArrayLit
    for e in al.arrElems {
      const ex = unwrapParen(e)
      if ex < 0 { return "" }
      const il = nodeAt(ex)
      if rows && il is ArrayLit {
        if il.arrElems.length == 0 { return "" }
        for ie in il.arrElems {
          if !monoInertArgFns(ie, fes, at, 0) { return "" }
        }
      } else if rows || !monoInertArgFns(e, fes, at, 0) {
        return ""
      }
    }
    list = true
  } else if !monoInertArgFns(argIx, fes, at, 0) {
    return ""
  }
  if fes.length == 0 { return "" }
  const kept: boolean[] = []
  let j = 0
  while j < fes.length {
    if !vrInertFor("mono", at[j], "") { return "" }
    const g = monoFlowLeafGen(at[j])
    const k = (g >= 0 && monoFlowGenCalled(g))
      || !vrReadsInert(monoOrigNode[fes[j]])
    if !k && monoInstantiatedAny(fes[j]) { return "" }
    kept.push(k)
    j = j + 1
  }
  const noPs: i32[] = []
  let st = mkFuncTy(noPs, TY_VOID)
  let nm = ""
  if rows {
    st = mkArrayTy(st)
    nm = monoConcreteFnPinName(st)
    st = mkArrayTy(st)
    if nm != "" { nm = nm + "[]" }
  } else if list {
    st = mkArrayTy(st)
    nm = monoConcreteFnPinName(st)
  } else {
    const sk = sigKeyOfTy(st)
    if sk != "" { nm = "=>" + sk }
  }
  if nm == "" { return "" }
  j = 0
  while j < fes.length {
    if !i32ListHas(monoArgInert, at[j]) { monoArgInert.push(at[j]) }
    monoReachNote(at[j], kept[j])
    if !kept[j] {
      monoInertArgAt.push(at[j])
      monoInertArgFe.push(fes[j])
    }
    j = j + 1
  }
  tyOut[0] = st
  nm
}

// Appends to `fes` each hole function value `v` can be, and to `at` the name reading it: `v`
// names one, is an un-annotated `const` binding whose initializer can only be such, is an `if`
// whose arms can only be such, or calls a function every value it returns can be (D6911). False
// when some value it can be is none of those.
function monoInertArgFns(v: i32, fes: i32[], at: i32[], depth: i32): boolean {
  if v < 0 || v >= P.nodes.length { return false }
  const x = unwrapParen(v)
  if x < 0 || depth > 8 { return false }
  const n = nodeAt(x)
  if n is Call {
    const cd = monoCalleeDeclOf(n)
    if cd < 0 { return false }
    return monoRetValueFns(cd, fes, at, depth + 1)
  }
  // An `if` is each of its arms' values; an arm ending in a call that never returns has none.
  if n is IfStmt {
    if n.ifElse < 0 { return false }
    const tn = monoArmEndsNever(n.ifThen)
    const en = monoArmEndsNever(n.ifElse)
    if tn && en { return false }
    const arms: i32[] = []
    if !tn { monoBlockTailInto(n.ifThen, arms) }
    if nodeAt(n.ifElse) is IfStmt { arms.push(n.ifElse) }
    else if !en { monoBlockTailInto(n.ifElse, arms) }
    let want = 2
    if tn || en { want = 1 }
    if arms.length != want { return false }
    for a in arms {
      if !monoInertArgFns(a, fes, at, depth + 1) { return false }
    }
    return true
  }
  if !(n is Ident) { return false }
  if monoCalleeIsGeneric(x) {
    const fe = fnIndexOfNode(x)
    if fe < 0 || fe >= monoOrigNode.length { return false }
    fes.push(fe)
    at.push(x)
    return true
  }
  const d = identDeclOf(x)
  if d < 0 || d >= P.nodes.length { return false }
  const ld = nodeAt(d)
  if (
    !(ld is LetDecl)
    || ld.letKw != "const"
    || ld.letType >= 0
    || ld.letInit < 0
  ) {
    return false
  }
  monoInertArgFns(ld.letInit, fes, at, depth + 1)
}

// `monoInertArgFns` over every value function declaration `fd` returns: each `return`'s
// argument in its own frame, and its body's last statement when that is no `return`.
function monoRetValueFns(fd: i32, fes: i32[], at: i32[], depth: i32): boolean {
  const f = nodeAt(fd)
  if !(f is FuncDecl) || f.fnBody < 0 { return false }
  const b = nodeAt(f.fnBody)
  if !(b is Block) || b.blkStmts.length == 0 { return false }
  const tail = b.blkStmts[b.blkStmts.length - 1]
  if !(nodeAt(tail) is RetStmt) && !monoInertArgFns(tail, fes, at, depth) {
    return false
  }
  const stack: i32[] = [f.fnBody]
  while stack.length > 0 {
    const ix = stack.pop()
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if n is RetStmt && vrFrameOf(ix) == fd {
        if !monoInertArgFns(n.retArg, fes, at, depth) { return false }
      }
      for ch in nodeChildren(ix) { stack.push(ch) }
    }
  }
  true
}

// Each argument `monoInertParamStubPin` pinned at the stub, and the function it names.
let monoInertArgAt: i32[] = []
let monoInertArgFe: i32[] = []

// The refusal for each `monoInertParamStubPin` argument whose function the prune did not stub:
// another use instanced or read it, so the pinned `() -> void` is not its signature.
function monoInertArgsStubbed(): i32 {
  let i = 0
  while i < monoInertArgAt.length {
    if !i32ListHas(monoStubSlots, monoInertArgFe[i]) {
      const n = nodeAt(monoInertArgAt[i])
      let nm = ""
      if n is Ident { nm = n.identName }
      return emitFailAt(
        "emitProgram: monomorphize: `"
          + nm
          + "` is handed to a parameter nothing calls and is also used where it needs a "
          + "signature, so the two uses have no one type — annotate its parameters",
        monoInertArgAt[i],
      )
    }
    i = i + 1
  }
  0
}

// Coerces the called field of a record literal no binding holds (`{ f: g, n: 1 }.f(x)`) at the
// signature the elaboration stamps that field's value with, so each literal gets its own (D15113).
function monoPinLitFieldCall(c: Call, ctx: i32): i32 {
  if c.callFn < 0 || c.callFn >= P.nodes.length { return 0 }
  const cf = nodeAt(c.callFn)
  if !(cf is Member) { return 0 }
  const ox = unwrapParen(cf.memObj)
  if ox < 0 { return 0 }
  const lit = nodeAt(ox)
  if !(lit is ObjLit) { return 0 }
  for fx in lit.objFields {
    const f = nodeAt(fx)
    if f is FieldInit && f.fiName == cf.memProp {
      const path: string[] = ["f." + f.fiName]
      return monoCoerceLitPart(f.fiValue, ox, path, ctx)
    }
  }
  0
}

// The refusal for a parameter `par` of `callee` no argument pin closes.
function monoArgTyFail(par: string, callee: string): i32 {
  emitFail(
    "emitProgram: monomorphize: unsupported argument type for `"
      + par
      + "` in a call to `"
      + callee
      + "`",
  )
}

// The refusal for generic `argIx` handed to a hole its calls use at two types, where no split
// gave the hole a parameter per type: the value floor's, naming the signatures (D6280).
function monoHoleTwoPinsFail(argIx: i32, par: string, callee: string): i32 {
  const ax = unwrapParen(argIx)
  let fe = monoReadGenFnFe(ax)
  if fe < 0 && ax >= 0 && nodeAt(ax) is Ident {
    const d = identDeclOf(ax)
    if d >= 0 && nodeAt(d) is FuncDecl { fe = fnStmtsPosOf(d) }
  }
  if fe < 0 { return monoArgTyFail(par, callee) }
  emitFailAt(genericFnValueRejectMsg(fe), ax)
}

// Set while the call being instantiated has such a parameter (`monoCalleeHasTyParamArrow`).
let monoDestPinOff = false

function monoInstantiateCall(origFe: i32, callIx: i32, ctx: i32) {
  const svDefer = monoOpenLamDefer
  const svOwner = monoOpenLamOwner
  const svMark = monoOpenLamMark
  monoOpenLamDefer = callIx
  monoOpenLamMark = monoOpenLamD.length
  const mark = monoOpenLamMark
  const r = monoInstantiateCallIn(origFe, callIx, ctx)
  monoOpenLamDefer = -1
  monoOpenLamOwner = -1
  monoOpenLamFlush(mark)
  monoOpenLamDefer = svDefer
  monoOpenLamOwner = svOwner
  monoOpenLamMark = svMark
  r
}

function monoInstantiateCallIn(origFe: i32, callIx: i32, ctx: i32) {
  const c = nodeAt(callIx)
  const fn = nodeAt(monoOrigNode[origFe])
  if c is Call {
    if fn is FuncDecl {
      const args = monoArgsInParamOrder(callIx, monoOrigNode[origFe])
      const params = fn.fnParams
      if args.length != params.length {
        return emitFail(
          "emitProgram: monomorphize: wrong number of arguments calling `"
            + fn.fnName
            + "`",
        )
      }
      // Pin each parameter: an un-annotated param takes its argument's type
      // name; a type-param-riding annotation binds the type param (first use
      // wins, later uses take the binding); a concrete annotation is kept.
      const tvN: string[] = []
      const tvV: string[] = []
      // The arena type of each binding where its producer holds one, index-aligned with `tvN`
      // (`monoTvTyLast`); a binding pushed by spelling alone has -1 or no entry.
      const tvT: i32[] = []
      // A call's explicit type arguments bind first, so every later binding reads them.
      monoBindExplicitTyArgs(callIx, fn.fnTyParams, fn.fnParams, tvN, tvV, tvT)
      monoPreBindNumJoin(callIx, fn.fnTyParams, tvN, tvV, tvT)
      const pinned: string[] = []
      // The arena type each pinned param denotes, parallel to `pinned`. Sourced from the
      // argument's recorded type and consumed only as a fallback where the pinned name
      // does not resolve. -1 = nothing known.
      const pinTys: i32[] = []
      // Each pin's own type, the parameter's substituted annotation, parallel to `pinned`; -2 at an
      // un-annotated parameter until `monoPinOwnClose` fills it from `pinTys`.
      const pinOwn: i32[] = []
      // Pre-bind from the value arguments, and only when a generic function value is on
      // its way into an arrow parameter riding these type parameters (D58): the main
      // loop binds at first use, and `hof<U, R>(g: (U, U) => R, …)` uses `U` first at `g`.

      // The gate keeps the order change inert: where the argument is a concrete function
      // the two orders agree, so they differ only when one answer is a type variable.
      const declTys = monoDeclParamTys(origFe, params.length)
      if monoCallGenFnToTyParamArrow(params, args, fn.fnTyParams, ctx) {
        monoPreBindNonArrowArgs(origFe, callIx, fn, params, args, tvN, tvV, tvT)
      }
      monoPreBindPastEmptyLit(
        origFe,
        callIx,
        params,
        args,
        fn.fnTyParams,
        tvN,
        tvV,
        tvT,
      )
      if monoTwoListArgFail(fn, params, args, ctx) < 0 { return -1 }
      monoPreBindPastUnionRest(
        origFe,
        callIx,
        params,
        args,
        fn.fnTyParams,
        ctx,
        tvN,
        tvV,
        tvT,
        declTys,
      )
      monoDefaultTyParamsOnlyGenFns(
        fn,
        params,
        args,
        ctx,
        tvN,
        tvV,
        tvT,
        callIx,
      )
      monoPreBindTaggedSets(callIx, fn, args, tvN, tvV, tvT)
      let oDecl = -1
      if origFe >= 0 && origFe < monoOrigNode.length {
        oDecl = monoOrigNode[origFe]
      }
      let i = 0
      while i < args.length {
        const p = nodeAt(params[i])
        if p is Param {
          if p.parType < 0 {
            const hr = monoPinHoleParam(
              p,
              fn,
              fnStmts[origFe],
              params,
              args,
              i,
              callIx,
              ctx,
              pinned,
              pinTys,
            )
            if hr < 0 { return hr }
            if hr > 0 { return 0 }
            while pinOwn.length < pinned.length { pinOwn.push(-2) }
          } else {
            const pr = monoPinAnnotatedParam(
              p,
              fn,
              params,
              args,
              i,
              callIx,
              ctx,
              tvN,
              tvV,
              tvT,
              pinned,
              pinTys,
              pinOwn,
              oDecl,
            )
            if pr < 0 { return pr }
          }
        }
        i = i + 1
      }
      // Callback specialization: a known, non-capturing, non-generic function argument is
      // baked into this instance as a direct call, keyed on its identity; anything else is a
      // `call_ref`. `monoSpecializableCallbackName` alone decides it.
      const cbFnNames: string[] = []
      let ci = 0
      while ci < args.length {
        cbFnNames.push(
          monoSpecializableCallbackName(callIx, fn.fnName, args[ci], ctx),
        )
        ci = ci + 1
      }
      const specAt = if monoAnyBakedCallback(cbFnNames) { elabSpecDemand(callIx, ctx, monoOrigNode[origFe], args, cbFnNames) } else { -1 }
      monoBindSeededTyParams(
        fn,
        monoOrigNode[origFe],
        callIx,
        pinned,
        pinTys,
        tvN,
        tvV,
        tvT,
        elabSpecKeyOf(specAt),
      )
      monoDefaultUnboundTyParams(
        fn.fnTyParams,
        tvN,
        tvV,
        tvT,
        fn.fnBody,
        callIx,
      )
      callBindShadowNote(callIx, fn.fnName, fn.fnTyParams, tvN, tvV)
      // The elaboration's binding replaces a closed one of another representation; one of the
      // same representation keeps mono's spelling, and one mono left open stays mono's.
      for tp in fn.fnTyParams {
        const et = monoElabBindTy(origFe, callIx, tp)
        let j = 0
        while et >= 0 && j < tvN.length && j < tvV.length && j < tvT.length {
          const mt = tvT[j]
          if (
            tvN[j] == tp
            && mt >= 0
            && mt < T.tys.length
            && !tyHasTyVar(mt)
            && !tySame(mt, et)
            && repCanonId(mt) != repCanonId(et)
          ) {
            const sp = monoPinNominalSpelling(et)
            if sp != "" {
              tvT[j] = et
              tvV[j] = sp
            }
          }
          j = j + 1
        }
      }
      monoExactPinTys(pinTys, ctx)
      monoPinOwnClose(pinOwn, pinTys, ctx)
      if repShadowOn {
        let pk = 0
        while pk < pinned.length && pk < pinTys.length {
          monoPinSpellNote("param", pinned[pk], pinTys[pk])
          pk = pk + 1
        }
        let tk = 0
        while tk < tvV.length && tk < tvT.length {
          monoPinSpellNote("typaram", tvV[tk], tvT[tk])
          tk = tk + 1
        }
      }
      const pinKinds: i32[] = []
      monoBuildPinCol(pinned, pinTys, pinKinds)
      monoPinRespell(pinned, pinTys, params, pinOwn)
      monoPinArgLit = []
      let li = 0
      while li < args.length {
        monoPinArgLit.push(nodeAt(unwrapParen(args[li])) is ObjLit)
        li = li + 1
      }
      monoCallFrameSlot = monoNestedCallFrame(origFe, ctx)
      monoMakeCallIx = callIx
      monoOpenLamOwner = callIx
      monoOpenLamDefer = -1
      const specKeys0 = monoKeys.length
      const specKWas = monoBakeSpecK
      monoBakeSpecK = elabSpecKeyOf(specAt)
      monoSpecGoK = monoBakeSpecK
      const made = monoMakeInstance(
        origFe,
        pinned,
        pinKinds,
        pinTys,
        pinOwn,
        tvN,
        tvV,
        tvT,
        c.callFn,
        false,
        cbFnNames,
      )
      monoBakeSpecK = specKWas
      monoSpecGoK = -1
      const specFe = if monoKeys.length > specKeys0 { monoInstFe[specKeys0] } else { monoLastInstFe }
      elabSpecMonoGroup(specAt, i32ToStr(specFe))
      elabSpecMonoSlot(specAt, specFe)
      return made
    }
  }
  0
}

// Binds `fn`'s type parameters each non-arrow annotation of call `callIx` mentions, ahead of the
// first-use loop, at the elaboration's binding for the call (D58).
function monoPreBindNonArrowArgs(
  origFe: i32,
  callIx: i32,
  fn: FuncDecl,
  params: i32[],
  args: i32[],
  tvN: string[],
  tvV: string[],
  tvT: i32[],
) {
  let pb = 0
  while pb < args.length && pb < params.length {
    const pbp = nodeAt(params[pb])
    // The ARROW parameters are the ones whose binding is in question, and a literal of generics
    // takes the type the others bind (D10250).
    if (
      pbp is Param
      && pbp.parType >= 0
      && !monoAnnIsFnSlot(pbp.parType)
      && !monoLitHoldsGenericFn(args[pb], 0)
    ) {
      for tp in fn.fnTyParams {
        if (!strListHas(tvN, tp) && monoAnnHasTyParam(pbp.parType, -1, [tp])) {
          const et = monoElabBindTy(origFe, callIx, tp)
          const sp = if et >= 0 { monoPinNominalSpelling(et) } else { "" }
          if sp != "" {
            tvN.push(tp)
            tvV.push(sp)
            monoTvTyLast(tvN, tvT, et)
          }
        }
      }
    }
    pb = pb + 1
  }
}

// Default-binds each type parameter of `fn` still unbound whose every mentioning parameter is
// a function slot handed a generic function value, as `monoDefaultUnboundTyParams` does for one
// no parameter names: no argument closes it, and those values are instanced at whatever binds.
function monoDefaultTyParamsOnlyGenFns(
  fn: FuncDecl,
  params: i32[],
  args: i32[],
  ctx: i32,
  tvN: string[],
  tvV: string[],
  tvT: i32[],
  callIx: i32,
) {
  for tp in fn.fnTyParams {
    const one: string[] = [tp]
    if !strListHas(tvN, tp) {
      let named = 0
      let open = true
      let i = 0
      while i < args.length && i < params.length {
        const p = nodeAt(params[i])
        if p is Param {
          if p.parType >= 0 {
            if monoAnnHasTyParam(p.parType, -1, one) {
              named = named + 1
              if !monoAnnIsFnSlot(p.parType) || !monoArgIsGenFn(args[i], ctx) {
                open = false
              }
            }
          }
        }
        i = i + 1
      }
      const seen: i32[] = []
      if (
        named > 0
        && open
        && !monoRetMentions(fn, one)
        && !elabTyParamReachesSpelling(fn.fnBody, one, seen)
      ) {
        monoBindTyParamElab(callIx, tp, tvN, tvV, tvT)
      }
    }
  }
  0
}

// Binds each type parameter that alone annotates a parameter handed a tagged set to the set
// itself, as a hole handed one is pinned: the instance calls each member directly.
function monoPreBindTaggedSets(
  callIx: i32,
  fn: FuncDecl,
  args: i32[],
  tvN: string[],
  tvV: string[],
  tvT: i32[],
) {
  let i = 0
  while i < args.length && i < fn.fnParams.length {
    const p = nodeAt(fn.fnParams[i])
    const at = monoArgTaggedSetTy(args[i])
    const js = if at >= 0 { fnTagCallJoinOf(monoCallTplOf(callIx), i) } else { -1 }
    const st = if fnTagSetIsTagged(js) && js != fnTagSetOfTy(at) { fnTagSetTy(js) } else { at }
    if (p is Param && st >= 0 && p.parType >= 0) {
      const tn = nodeAt(p.parType)
      if (
        tn is TypeRef
        && strListHas(fn.fnTyParams, tn.tyName)
        && !strListHas(tvN, tn.tyName)
      ) {
        tvN.push(tn.tyName)
        tvV.push(tyToStr(st))
        monoTvTyLast(tvN, tvT, st)
      }
    }
    i = i + 1
  }
  0
}

// Whether argument `argIx` names a generic function, directly or through `const` aliases.
function monoArgIsGenFn(argIx: i32, ctx: i32): boolean {
  const ax = unwrapParen(argIx)
  if ax < 0 { return false }
  const av = nodeAt(ax)
  if !(av is Ident) { return false }
  const gfe = monoFnFeOfIdent(ax, av.identName, ctx)
  if gfe >= 0 && gfe < monoGen.length && monoGen[gfe] == 1 { return true }
  monoReadGenFnFe(ax) >= 0
}

// Whether `fn`'s return annotation names one of `typarams`; without one, whether the inferred
// return has any type variable or is unknown.
function monoRetMentions(fn: FuncDecl, typarams: string[]): boolean {
  if fn.fnRet < 0 {
    const rt = inferRetTyIxOf(fn.fnName)
    return rt < 0 || tyHasTyVar(rt)
  }
  monoAnnHasTyParam(fn.fnRet, -1, typarams)
}

// Refuses an argument of two list types at a type-parameter list parameter of `fn`: -1, else 0.
function monoTwoListArgFail(
  fn: FuncDecl,
  params: i32[],
  args: i32[],
  ctx: i32,
): i32 {
  // A value of two list types handed to a parameter a type parameter spells binds no one
  // `T`, as the same function spelled without a type parameter cannot (D2766).
  let ta = 0
  while ta < args.length {
    const tat = twoListValueTy(args[ta], ctx)
    if (
      tat >= 0
      && ta < params.length
      && monoParamIsTyParamList(params[ta], fn.fnTyParams)
    ) {
      return emitFailAt(
        "argument "
          + i32ToStr(ta + 1)
          + ": "
          + tyToStr(tat)
          + " is two list types, not one list — narrow with `is` first",
        args[ta],
      )
    }
    ta = ta + 1
  }
  0
}

// The slot built for bundle field `k` of `sigs` from the lambda literal `x` read in function
// `fnIx`, as the row records it; -1 where the row holds none.
export function monoBundleFe(x: i32, fnIx: i32, sigs: i32[], k: i32): i32 {
  if k < 0 || k >= sigs.length { return -1 }
  monoCadRowFe(elabSrcDecl(unwrapParen(x)), monoCadInstOf(fnIx), sigs[k])
}

// The slot built for the function read `x` in function `fnIx` at signature `sig`, as the row
// records it; -1 where the row holds none.
export function monoBundleReadFe(x: i32, fnIx: i32, sig: i32): i32 {
  const r = unwrapParen(x)
  const fe = monoCadRowFe(r, monoCadInstOf(fnIx), sig)
  if fe >= 0 || r < 0 || !(nodeAt(r) is Ident) { return fe }
  // A `const` bound to a lambda reads the closure the row keeps at the lambda, under this
  // instance or, for one lifted out of every instance, under none (D15597).
  const d = identDeclOf(r)
  const dn = if d >= 0 && d < P.nodes.length { nodeAt(d) } else { nodeAt(r) }
  if !(dn is LetDecl) || dn.letKw != "const" { return -1 }
  const v = unwrapParen(dn.letInit)
  if v < 0 || !(nodeAt(v) is FuncDecl) { return -1 }
  const own = monoCadRowFe(v, monoCadInstOf(fnIx), sig)
  if own >= 0 { return own }
  const free = monoCadRowFe(v, -1, sig)
  if free >= 0 || cadCloneInst.has(v) { return free }
  // A lambda no encloser instance clones has one instance per signature, which every encloser
  // instance shares: the row keeps it under the instance its slot's frame names (D15600).
  const slot = monoSlotOfLamNode(v)
  const pf = if slot >= 0 && slot < fnParent.length { fnParent[slot] } else { -1 }
  if pf < 0 || pf >= fnStmts.length { return -1 }
  monoCadRowFe(v, monoCadInstOf(fnStmts[pf]), sig)
}

// The delivery token for the function value read `read` in function `fnIx` returns: the closure
// the row records as built for that read in `fnIx`'s instance at `fnIx`'s declared result; -1
// where `fnIx` declares no closed function result or the row holds none.
export function monoTokenFe(read: i32, fnIx: i32): i32 {
  if fnIx < 0 || fnIx >= P.nodes.length { return -1 }
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) || fn.fnRet < 0 { return -1 }
  const rt = nodeTyIxOf(fn.fnRet)
  if rt < 0 || rt >= T.tys.length || tyHasTyVar(rt) || !(tyAt(rt) is TyFunc) {
    return -1
  }
  monoCadRowFe(read, monoCadInstOf(fnIx), rt)
}

// `monoTokenFe` for a read `fnIx` hands back as its value, the only read a token stands for
// where the read is also a tagged set's member; -1 for any other read.
export function monoTokenReturnedFe(read: i32, fnIx: i32): i32 {
  const tk = monoTokenFe(read, fnIx)
  if tk < 0 || fnIx < 0 || fnIx >= P.nodes.length { return -1 }
  const fn = nodeAt(fnIx)
  if !(fn is FuncDecl) { return -1 }
  const vs: i32[] = []
  collectRetValues(fn.fnBody, vs)
  if i32ListHas(vs, read) || i32ListHas(vs, unwrapParen(read)) {
    tk
  } else {
    -1
  }
}

// The slot the row answers for (`site`, `inst`, `sig`), or -1.
function monoCadRowFe(site: i32, inst: i32, sig: i32): i32 {
  const rows = cadBySite.get(site) ?? []
  for r in rows {
    if cadInst[r] == inst && monoCadSigSame(cadSig[r], sig) { return cadFe[r] }
  }
  -1
}

// `monoPinHoleParam`'s bundle: where the callee's instance calls the hole lambda literal `arg`,
// its argument `i`, at the two or more signatures the elaboration answers, builds the lambda at each and pins the parameter
// at the anonymous record holding one closure per signature. 0, -1 on a failure, or 1 where the
// argument is no bundle.
function monoBundlePin(
  arg: i32,
  i: i32,
  callIx: i32,
  ctx: i32,
  pinned: string[],
  pinTys: i32[],
): i32 {
  const sigs = elabCallBundleSigs(monoCallTplOf(callIx), i)
  if sigs.length < 2 { return 1 }
  // The record the elaboration delivers the argument at; a closure taking a bundle is no bundle.
  const bt = elabCallArgRep(monoCallTplOf(callIx), -1, elabWalkTop(), i)
  if bt == ELAB_REP_NO_ROW {
    return emitFailAt(
      "emitProgram: monomorphize: a bundle argument's call has no delivered rep",
      arg,
    )
  }
  if !elabPinIsBundleOf(bt, sigs) { return 1 }
  const at = pinTys.length
  const rc = monoBundlePinArg(arg, i, callIx, ctx, sigs, bt, pinned, pinTys)
  // The record each parameter key is pinned at, read by a hand of that parameter.
  const key = elabCallParamKey(monoCallTplOf(callIx), i)
  if rc == 0 && key >= 0 && pinTys.length == at + 1 {
    monoBundleKeyTys[key] = pinTys[at]
  }
  rc
}

// `monoBundlePin` once the callee takes record `bt` of `sigs`: the record argument `arg` builds or
// hands on. 0, -1 on a failure, or 1 where the argument is no bundle.
function monoBundlePinArg(
  arg: i32,
  i: i32,
  callIx: i32,
  ctx: i32,
  sigs: i32[],
  bt: i32,
  pinned: string[],
  pinTys: i32[],
): i32 {
  const x = unwrapParen(arg)
  // A call returning a record at these signatures hands it whole (D15144).
  const ar = elabCallArgRecordSigs(monoCallTplOf(callIx), i)
  if ar.length > 0 && monoSigsSame(ar, sigs) {
    if monoBundleRecordAt(bt, arg) < 0 { return -1 }
    const brow = bundleRecordRowOfTy(bt)
    if brow < 0 || brow >= sNames.length { return -1 }
    pinned.push(sNames[brow])
    pinTys.push(bt)
    return 0
  }
  if x >= 0 && nodeAt(x) is Ident {
    const fw = monoBundleHandOnPin(callIx, i, sigs, pinned, pinTys)
    if fw != 1 { return fw }
    return monoBundleNamedPin(x, sigs, bt, ctx, pinned, pinTys)
  }
  // A choice of such reads hands the record its taken arm builds (D15450).
  if x >= 0 && nodeAt(x) is IfStmt {
    const lv: i32[] = []
    tailValueLeaves(x, lv)
    const pk: string[] = []
    const pt: i32[] = []
    for l in lv {
      if !(nodeAt(l) is Ident) { return 1 }
      const r = monoBundleNamedPin(l, sigs, bt, ctx, pk, pt)
      if r != 0 { return r }
    }
    if pk.length == 0 { return 1 }
    pinned.push(pk[0])
    pinTys.push(pt[0])
    return 0
  }
  if x < 0 || !(nodeAt(x) is FuncDecl) { return 1 }
  const lfe = monoLamValueFe(x, ctx)
  if (
    lfe < 0
    || lfe >= monoGen.length
    || monoGen[lfe] != 1
    || !monoLamIsHole(lfe)
  ) {
    return 1
  }
  for s in sigs {
    const f = tyAt(s)
    if !(f is TyFunc) { return 1 }
    const pn: string[] = []
    for pt in f.fnParamTypes { pn.push(monoPinOfClosedTy(pt)) }
    if monoInstanceFor(lfe, pn, x, s, f.fnParamTypes, f.fnParamTypes) < 0 {
      return -1
    }
  }
  monoClosedRecordOwnRow(bt)
  const row = bundleRecordRowOfTy(bt)
  if row < 0 || row >= sNames.length {
    return emitFailAt(
      "emitProgram: monomorphize: a lambda called at two signatures has no row for its closures",
      x,
    )
  }
  pinned.push(sNames[row])
  pinTys.push(bt)
  0
}

// `monoBundlePin` for call `callIx`'s argument `i` handing a parameter whole, its own or a
// captured one, pinned at a record of `sigs`: the record is handed on as it is, so the
// callee's parameter is pinned at its type. 0, or 1 where the argument hands no such parameter.
function monoBundleHandOnPin(
  callIx: i32,
  i: i32,
  sigs: i32[],
  pinned: string[],
  pinTys: i32[],
): i32 {
  const owner = elabCallHandOwner(monoCallTplOf(callIx), i)
  const bt = if owner >= 0 { monoBundleKeyTys.get(owner) ?? -1 } else { -1 }
  const bs = elabDeliveredBundleSigs(bt)
  if bs.length == 0 || !monoSigsSame(bs, sigs) { return 1 }
  const pr = bundleRecordRowOfTy(bt)
  if pr < 0 || pr >= sNames.length { return 1 }
  pinned.push(sNames[pr])
  pinTys.push(bt)
  0
}

// Whether signature lists `a` and `b` hold the same types in the same order.
function monoSigsSame(a: i32[], b: i32[]): boolean {
  if a.length != b.length { return false }
  let j = 0
  while j < a.length {
    if !tySame(a[j], b[j]) { return false }
    j = j + 1
  }
  true
}

// `monoBundlePin` for a generic named by read `x`, or a function nested in this frame, handed to
// a parameter called at each of `sigs`: its instance at each is built, and the parameter pinned at
// their record. 0, -1 on a failure, or 1 where the read is neither or the split plan is in force.
function monoBundleNamedPin(
  x: i32,
  sigs: i32[],
  bt: i32,
  ctx: i32,
  pinned: string[],
  pinTys: i32[],
): i32 {
  const nested = identClosureFeOfRead(x, ctx) >= 0
  if !monoCalleeIsGeneric(x) && !nested { return 1 }
  const d = identDeclOf(x)
  for sg in sigs {
    const sf = tyAt(sg)
    if tyHasTyVar(sg) || !(sf is TyFunc) { return 1 }
    if !nested && elabMemberKeyAt(d, sf.fnParamTypes) < 0 {
      return emitFailAt(
        "emitProgram: monomorphize: a generic handed as a bundle has no instance at one of its "
          + "signatures",
        x,
      )
    }
  }
  if monoBundleRecordAt(bt, x) < 0 { return -1 }
  const row = bundleRecordRowOfTy(bt)
  if row < 0 || row >= sNames.length { return -1 }
  // The read stays the generic, so each signature instances it afresh.
  monoNoRename.push(x)
  monoBundleReads.push(x)
  for sg in sigs {
    if monoCoerceFnValueName(x, ctx, sg) < 0 { return -1 }
  }
  pinned.push(sNames[row])
  pinTys.push(bt)
  0
}

// Gives bundle record `bt` its row; `bt`, or -1 where no row is minted for it.
function monoBundleRecordAt(bt: i32, at: i32): i32 {
  monoClosedRecordOwnRow(bt)
  const row = bundleRecordRowOfTy(bt)
  if row < 0 || row >= sNames.length {
    emitFailAt(
      "emitProgram: monomorphize: a lambda called at two signatures has no row for its closures",
      at,
    )
    return -1
  }
  bt
}

// `monoPinHoleParam`'s closure bundle: where call `callIx` delivers its argument `i`, the hole
// lambda `arg`, as the closure taking its own parameter's bundle (`elabCallArgRep`), pins the
// parameter at that closure. 0, -1 on a failure, or 1 where the argument is no such lambda.
function monoClosureBundlePin(
  callIx: i32,
  i: i32,
  arg: i32,
  ctx: i32,
  pinned: string[],
  pinTys: i32[],
): i32 {
  // A reassigned binding holds the lambda last written to it, so no one closure.
  const ax = unwrapParen(arg)
  if (
    ax >= 0
    && nodeAt(ax) is Ident
    && monoReadIsAssigned(monoIdentNameOf(ax), ax)
  ) {
    return 1
  }
  const lfe = monoLamValueFe(ax, ctx)
  if (
    lfe < 0
    || lfe >= monoGen.length
    || monoGen[lfe] != 1
    || !monoLamIsHole(lfe)
  ) {
    return 1
  }
  const lam = monoOrigNode[lfe]
  const ln = nodeAt(lam)
  if !(ln is FuncDecl) || ln.fnParams.length != 1 { return 1 }
  const inst: i32[] = [0 - 1]
  const sigs = elabLamParamSigs(elabSrcDecl(lam), 0, inst)
  if sigs.length < 2 { return 1 }
  const ft = elabCallArgRep(monoCallTplOf(callIx), -1, elabWalkTop(), i)
  const f = if ft >= 0 && ft < T.tys.length { tyAt(ft) } else { null }
  if !(f is TyFunc) || f.fnParamTypes.length != 1 { return 1 }
  if monoBundleRecordAt(f.fnParamTypes[0], arg) < 0 { return -1 }
  const tyOut: i32[] = [0 - 1]
  const an = monoFnPinAt(arg, ctx, ft, -1, tyOut)
  if an == "" {
    return emitFailAt(
      "emitProgram: monomorphize: a lambda called at two signatures cannot be built as a closure "
        + "taking their bundle",
      arg,
    )
  }
  pinned.push(an)
  pinTys.push(ft)
  0
}

// Pins un-annotated `p`, `fn`'s `i`th parameter, into `pinned`/`pinTys`: -1 on a refusal, else 0.
function monoPinHoleParam(
  p: Param,
  fn: FuncDecl,
  decl: i32,
  params: i32[],
  args: i32[],
  i: i32,
  callIx: i32,
  ctx: i32,
  pinned: string[],
  pinTys: i32[],
): i32 {
  // A parameter the checker already decided is not a hole: the instance pins it at the
  // elaboration's type for it, or its own where the function binds nothing; "" keeps the
  // argument-derived pin.
  // A bundle handed to a parameter bound to one closure hands the member at its type.
  const hm = elabCallHandMember(monoCallTplOf(callIx), i)
  if hm >= -1 { bundleHandMemberNote(args[i], hm) }
  // A lambda the callee calls at two or more signatures is handed as a bundle (D14841).
  const bun = monoBundlePin(args[i], i, callIx, ctx, pinned, pinTys)
  if bun != 1 { return bun }
  // A hole lambda that calls its own parameter at two or more signatures, handed to a parameter
  // the callee only calls, is a closure taking that parameter's bundle.
  const cbun = monoClosureBundlePin(callIx, i, args[i], ctx, pinned, pinTys)
  if cbun != 1 { return cbun }
  // A tagged set's value, or a list or map of its ids, is handed on as the elaboration binds the
  // hole, pinned by the i32 list or map it is stored as. A closed function type bound to an
  // argument holding a set in this frame (a parameter forwarding a `Fn#d`, or an element or field
  // of a holder of them) takes the set's id rep (D15612).
  let bound = elabCallParamBoundTy(monoCallTplOf(callIx), decl, i)
  const bx = unwrapParen(args[i])
  if (
    bound >= 0
    && bound < T.tys.length
    && !fnTagTyIsTagged(bound)
    && tyAt(bound) is TyFunc
    && !tyHasTyVar(bound)
    && bx >= 0
    && (nodeAt(bx) is Ident || nodeAt(bx) is Index || nodeAt(bx) is Member)
  ) {
    const held = elabNodeTyAt(bx, ctx)
    if fnTagTyIsTagged(held) { bound = held }
  }
  const setTy = if fnTagTyIsTagged(bound) || fnTagListTy(bound) || monoTagMapTy(bound) { bound } else { 0 - 1 }
  if setTy >= 0 {
    const rn = if monoTagMapTy(setTy) { monoPinSpellShaped(monoTagMapRepTy(setTy, [], [])) } else { fnTagListRepName(setTy) }
    pinned.push(if rn != "" { rn } else { tyToStr(setTy) })
    pinTys.push(setTy)
    return 0
  }
  // A record holding one is the record the elaboration binds, keyed by its sets (D15638).
  const trn = if bound >= 0 && bound < T.tys.length && tyAt(bound) is TyObj { monoPinSpellShaped(monoTagMapRepTy(bound, [], [])) } else { "" }
  if trn != "" {
    pinned.push(trn)
    pinTys.push(bound)
    return 0
  }
  // A map of records holding a tagged set's ids is pinned at its binding's stamped rep.
  const hx = unwrapParen(args[i])
  const hd = if hx >= 0 && hx < P.nodes.length && nodeAt(hx) is Ident { identDeclOf(hx) } else { -1 }
  const hrep = if hd >= 0 { heldRepOf(hd) } else { -1 }
  const hrm = if hrep >= 0 && hrep < T.tys.length { tyAt(hrep) } else { null }
  if (
    hrm is TyMap
    && hrm.mVal >= 0
    && hrm.mVal < T.tys.length
    && tyAt(hrm.mVal) is TyObj
  ) {
    const hn = monoPinOfClosedTy(hrep)
    if hn != "" {
      pinned.push(hn)
      pinTys.push(hrep)
      return 0
    }
  }
  // A record the elaboration delivers the hole at is the instance's row: the key names it beside
  // the hole's own binding, which the instance is walked at (D15173).
  const drow = elabCallParamRowTy(monoCallTplOf(callIx), i)
  if drow >= 0 {
    const drn = monoRecordRowPin(drow)
    if drn != "" {
      pinned.push(drn)
      pinTys.push(drow)
      return 0
    }
  }
  const pt0 = nodeTyIxOf(params[i])
  // The parameter's type at this call is the elaboration's where it closes: mono's rungs below only
  // spell it, and a spelling of another type is refused. Where it does not close, mono's own rungs
  // answer.
  const elTy = elabCallHoleParamTy(monoCallTplOf(callIx), i, params[i])
  const et = callArgRepTy(
    monoCallTplOf(callIx),
    i,
    elabCallParamTy(monoCallTplOf(callIx), i),
  )
  let an = ""
  let anTy = -1
  let guessed = false
  if elTy >= 0 {
    const ept = elabCallParamTy(monoCallTplOf(callIx), i)
    const dt = if ept >= 0 { ept } else { pt0 }
    if pt0 >= 0 && !tyHasTyVar(pt0) && dt >= 0 {
      an = monoClosedTyPin(dt)
      if an != "" { anTy = dt }
    }
    // A literal handed to a parameter the body's own annotation decides delivers its open
    // functions at the slots the flow table pins, as at an annotated parameter (D9610).
    if an != "" && monoFlowIsLit(unwrapParen(args[i])) {
      if monoCoerceFnValueName(args[i], ctx, anTy) < 0 { return -1 }
    }
  } else {
    // The elaboration closes every parameter the checker typed closed, so a closed type here is
    // one its fact lost, not one to pin from.
    if et >= 0 && et < T.tys.length && !tyHasTyVar(et) {
      return emitFailAt(
        "emitProgram: internal: parameter `"
          + p.parName
          + "` of `"
          + fn.fnName
          + "` has a closed type the elaboration does not answer at this call",
        args[i],
      )
    }
    if pt0 >= 0 && !tyHasTyVar(pt0) && !tyReachesHole(pt0, 16) {
      return emitFailAt(
        "emitProgram: internal: parameter `"
          + p.parName
          + "` of `"
          + fn.fnName
          + "` is typed closed but the elaboration does not answer it at this call",
        args[i],
      )
    }
  }
  if an == "" {
    const pinTy: i32[] = [0 - 1]
    an = monoHoleGenFnPin(callIx, params[i], args[i], ctx, pinTy)
    anTy = pinTy[0]
    if an == "" && monoHoleGenTwoPins {
      return monoHoleTwoPinsFail(args[i], p.parName, fn.fnName)
    }
  }
  if elTy >= 0 {
    if an == "" {
      an = monoElabPin(callIx, args, i, et, ctx)
      if an != "" { anTy = et }
    }
    // A closed type holding no record is spelled as mono keys it; a record argument at the row
    // the checker recorded it built at, else its literal's stamp, else the type (D14532, D14739,
    // D14754, D14720).
    const etShut = et >= 0 && et < T.tys.length && !tyHasTyVar(et)
    if an == "" && etShut && !tyHoldsObj(et, 8) {
      an = monoPinOfClosedTy(et)
      if an != "" { anTy = et }
    }
    if an == "" && etShut {
      const bt = monoArgBuildTy(unwrapParen(args[i]), ctx)
      const rt = if bt >= 0 { bt } else { et }
      an = monoRecordRowPin(rt)
      if an != "" { anTy = rt }
    }
    if anTy < 0 { anTy = monoArgPinTyAt(args[i], ctx) }
    const elPin = if tyHoldsObj(elTy, 8) { monoRecordRowPin(elTy) } else { monoPinOfClosedTy(elTy) }
    if an == "" || (elPin != an && !(anTy >= 0 && tySame(anTy, elTy))) {
      return emitFailAt(
        "emitProgram: internal: parameter `"
          + p.parName
          + "` of `"
          + fn.fnName
          + "` is pinned at another type than the elaboration's at this call",
        args[i],
      )
    }
    anTy = elTy
  } else {
    // A record the elaboration leaves open is pinned at the row its own type is built at.
    if an == "" && et < 0 {
      const rt = nodeTyIxOf(unwrapParen(args[i]))
      if rt >= 0 && rt < T.tys.length && tyAt(rt) is TyObj {
        const si = structRowRecordingTy(rt)
        if si >= 0 && si < sNames.length {
          an = sNames[si]
          anTy = rt
        }
      }
    }
    // An argument the elaboration closes in this frame's instance, at a call it keys no parameter
    // type for (a set member's dispatch arm, a hole function handed on), pins at that type.
    if an == "" {
      const it = elabNodeTyAt(unwrapParen(args[i]), ctx)
      if it >= 0 && it < T.tys.length && !tyHasTyVar(it) {
        an = if tyHoldsObj(it, 8) { monoRecordRowPin(it) } else { monoPinOfClosedTy(it) }
        if an != "" { anTy = it }
      }
    }
    if an == "" {
      // Kept for an argument the elaboration leaves open at this call.
      an = monoArgPinName(args[i], ctx, [0 - 1])
      // The rep cascade's `i32` floor is not a pin for a hole the elaboration binds to another
      // closed type: that demand would key an instance no call has.
      if an == "i32" && monoFloorDisagrees(setTy) {
        return emitFailAt(
          "emitProgram: internal: parameter `"
            + p.parName
            + "` of `"
            + fn.fnName
            + "` would be pinned at the `i32` floor, but the elaboration binds it to "
            + tyToStr(setTy),
          args[i],
        )
      }
      // The rep cascade's `i32` floor is a guess for a value the checker left open and that holds
      // no function: no instance is demanded here. The rung above spells a frame type that closes
      // it, so such a type reaching here is refused.
      const ox = unwrapParen(args[i])
      const oxTy = if ox >= 0 { nodeTyIxOf(ox) } else { -1 }
      if (
        an == "i32"
        && ox >= 0
        && !(nodeAt(ox) is FuncDecl)
        && monoTyOpen(oxTy)
        && !tyMayHoldFn(oxTy, 0)
      ) {
        const ct = monoArgClosedTyIn(args[i], ctx, -1)
        if ct >= 0 && !tyMayHoldFn(ct, 0) {
          return emitFailAt(
            "emitProgram: internal: parameter `"
              + p.parName
              + "` of `"
              + fn.fnName
              + "` takes a value this frame closes that no pin spells",
            args[i],
          )
        }
        if ct < 0 {
          an = ""
          guessed = true
        }
      }
      // A hole function's pin is typed at its closed signature, else the elaboration's default
      // fill (`elabHoleFnClosed`); left open where neither pins as a wasm signature.
      if anTy < 0 {
        const vt = monoArgPinTyAt(args[i], ctx)
        if vt >= 0 && vt < T.tys.length && tyAt(vt) is TyFunc {
          const ct = if monoTyClosedFn(vt) { vt } else { elabHoleFnClosed(vt) }
          if monoPinTyIsFnSig(ct) && monoTyClosedFn(ct) { anTy = ct }
        }
      }
    }
    // An argument open in this frame at a call no instance elaborates at a closed type: no
    // instance is demanded here.
    if an == "" && guessed { return 1 }
    if an == "" { return monoArgTyFail(p.parName, fn.fnName) }
    if anTy < 0 { anTy = monoArgPinTyAt(args[i], ctx) }
  }
  pinned.push(an)
  pinTys.push(anTy)
  if monoFwdFnPinMisfits(fn, params[i], args[i], anTy) {
    return monoFwdFnPinFail(p.parName, fn.fnName)
  }
  if monoHoleCopyCallsMisfit(fn, params[i], anTy) {
    return monoHoleManyPinsFail(p.parName, fn.fnName)
  }
  0
}

// The closed type of argument `ax` inside function `ctx`. Where its pin type `pinTy` is closed:
// the type its call delivers it at (`elabArgDeliveredTy`), else the pin for a number literal, else
// its identity type where that is closed, else the pin. Otherwise the elaboration's type for it at
// the instance `ctx`; -1 where neither closes it.
function monoArgClosedTyIn(ax: i32, ctx: i32, pinTy: i32): i32 {
  const x = unwrapParen(ax)
  if pinTy >= 0 && pinTy < T.tys.length && !tyHasTyVar(pinTy) {
    let src = x
    let guard = 0
    while src >= cwIxCoveredLen() && guard < 64 {
      src = nodeSrc[src] ?? -1
      guard = guard + 1
    }
    const from = if ctx >= 0 { elabKeyAt(ctx) } else { elabWalkTop() }
    const dt = if src >= 0 { elabArgDeliveredTy(src, from) } else { -1 }
    if dt >= 0 { return dt }
    if x < 0 || nodeAt(x) is NumLit { return pinTy }
    const it = elabIdentityFnTy(x, ctx)
    if it >= 0 && it < T.tys.length && !tyHasTyVar(it) && !tyHasHole(it) {
      return it
    }
    return pinTy
  }
  const t = elabNodeTyAt(x, ctx)
  if t >= 0 && t < T.tys.length && !tyHasTyVar(t) { return t }
  -1
}

// `monoInstantiateCall`'s pin for the annotated parameter `p`, the `i`th of `fn`'s, given
// argument `args[i]`: binds the annotation's type parameters into `tvN`/`tvV`, pushes the pin onto
// `pinned`, the argument's type onto `pinTys` and the pin's own type onto `pinOwn`. `decl` is the
// declaration whose body is read for a literal argument's demand. Returns 0, or the failure.
function monoPinAnnotatedParam(
  p: Param,
  fn: FuncDecl,
  params: i32[],
  args: i32[],
  i: i32,
  callIx: i32,
  ctx: i32,
  tvN: string[],
  tvV: string[],
  tvT: i32[],
  pinned: string[],
  pinTys: i32[],
  pinOwn: i32[],
  decl: i32,
) {
  // The declared spelling where the annotation is a type parameter, the
  // arena's canon'd one everywhere else. Without it a parameter whose name
  // shadows a type alias arrives resolved and pins the alias's body type.
  const ann = monoDeclAnnName(p.parType, tyNameOf(p.parType), fn.fnTyParams)
  const pty = nodeTyIxOf(p.parType)
  const tp = monoTyParamOfTy(pty, fn.fnTyParams)
  // Whether the annotation is the type parameter itself, not a list of it.
  const tpBare = tp != ""
    && pty >= 0
    && pty < T.tys.length
    && tyAt(pty) is TyVar
  // A list of a type parameter in a mixed instance, handed a literal holding a held binding, pins at
  // the elaboration's type for it as a composite annotation does, not through the instance's (D15210).
  if tp != "" && !tpBare {
    const tpl = monoCallTplOf(callIx)
    const row = callBindRowOf(tpl)
    if row >= 0 && callBindRepMixedAt(row) && cbaArgHoldsHeld(tpl, i) {
      const mpt = elabCallParamTy(tpl, i)
      const mpn = if mpt >= 0 && !tyHasTyVar(mpt) { monoClosedTyPin(mpt) } else { "" }
      if mpn != "" {
        pinned.push(mpn)
        pinTys.push(mpt)
        pinOwn.push(mpt)
        return 0
      }
    }
  }
  if tp == "" {
    // A composite annotation riding type params (`Box<T>`): bind them by
    // matching the pattern against the argument's concrete type name, then
    // pin the substituted annotation. A concrete annotation pins unchanged.
    const ept = monoElabCompositeTy(p, fn, decl, callIx, i)
    const en = if ept >= 0 { monoClosedTyPin(ept) } else { "" }
    if en != "" {
      monoBindArenaFullTys(
        nodeTyIxOf(p.parType),
        ept,
        fn.fnTyParams,
        tvN,
        tvV,
        tvT,
      )
      pinned.push(en)
      pinTys.push(ept)
      pinOwn.push(ept)
    } else if monoAnnHasTyParam(p.parType, -1, fn.fnTyParams) {
      const cr = monoPinTyParamComposite(
        p,
        fn,
        params,
        args,
        i,
        callIx,
        ctx,
        tvN,
        tvV,
        tvT,
        pinned,
        pinTys,
        pinOwn,
        decl,
      )
      if cr < 0 { return cr }
    } else {
      // An argument stored at a wider record pins the instance at that rep (D14532).
      const ar = recArgRepOf(monoArgSrcOf(args[i]))
      const arp = if ar >= 0 { monoClosedTyPin(ar) } else { "" }
      if arp != "" {
        pinned.push(arp)
        pinTys.push(ar)
        pinOwn.push(ar)
      } else {
        pinned.push(ann)
        pinTys.push(monoArgPinTyAt(args[i], ctx))
        pinOwn.push(nodeTyIxOf(p.parType))
      }
    }
  } else {
    // A generic the instance calls at two or more signatures is handed as a bundle, as it is to a
    // hole (D15575).
    if tpBare {
      const bun = monoBundlePin(args[i], i, callIx, ctx, pinned, pinTys)
      if bun != 1 {
        while pinOwn.length < pinned.length {
          pinOwn.push(pinTys[pinOwn.length])
        }
        return bun
      }
    }
    // A tagged set handed to a parameter its own type parameter alone annotates is pinned at
    // the set, as a hole handed one is; one several arguments share, at the set the elaboration
    // joined theirs to.
    const argSet = if tpBare { monoArgTaggedSetTy(args[i]) } else { -1 }
    const js = if argSet >= 0 { fnTagCallJoinOf(monoCallTplOf(callIx), i) } else { -1 }
    const setTy = if fnTagSetIsTagged(js) && js != fnTagSetOfTy(argSet) { fnTagSetTy(js) } else { argSet }
    if setTy >= 0 {
      pinned.push(tyToStr(setTy))
      pinTys.push(setTy)
      pinOwn.push(setTy)
      return 0
    }
    // A list of a tagged set's ids handed to `T[]` is pinned at the i32 list it is stored as.
    const listSet = if !tpBare { monoArgTaggedSetTy(args[i]) } else { -1 }
    if listSet >= 0 && fnTagListTy(listSet) && fnTagListRepName(listSet) != "" {
      pinned.push(fnTagListRepName(listSet))
      pinTys.push(listSet)
      pinOwn.push(listSet)
      return 0
    }
    let an2 = ""
    let an2Ty = -1
    // The type the argument ladder spelled `an2` from, where it is not `an2Ty`'s default.
    const an2Own: i32[] = [0 - 1]
    let genPin = false
    if tpBare {
      const pinTy: i32[] = [0 - 1]
      // A type parameter read only as whole parameter annotations: the elaboration closes each
      // parameter at the instances it alone carries, for a declared generic or a hole lambda (D15604).
      const own = if tyParamIsBareOnly(decl, tp) { elabCallParamTyOwn(monoCallTplOf(callIx), i) } else { -1 }
      if (
        own >= 0
        && tyAt(own) is TyFunc
        && (monoNamesDeclaredGeneric(args[i], ctx) || monoIsHoleLamArg(args[i]))
      ) {
        an2 = monoFnPinAt(args[i], ctx, own, -1, pinTy)
        monoHoleGenTwoPins = false
        monoHoleGenManyPins = false
      } else {
        an2 = monoHoleGenFnPin(callIx, params[i], args[i], ctx, pinTy)
      }
      an2Ty = pinTy[0]
      if an2 == "" && monoHoleGenTwoPins {
        return monoHoleTwoPinsFail(args[i], p.parName, fn.fnName)
      }
      genPin = an2 != ""
      // A list or record literal, or an argument built at a wider record than its type, takes
      // the elaboration's answer for the parameter at its rep; any other is pinned by what it holds.
      const ax = unwrapParen(args[i])
      const pet = elabCallParamTy(monoCallTplOf(callIx), i)
      const et = callArgRepTy(monoCallTplOf(callIx), i, pet)
      if (
        an2 == ""
        && ax >= 0
        && (nodeAt(ax) is ArrayLit || nodeAt(ax) is ObjLit || et != pet)
      ) {
        an2 = monoElabPin(callIx, args, i, et, ctx)
        if an2 != "" { an2Ty = et }
      }
      // A type parameter only this parameter names binds where an un-annotated one would (D6910).
      if an2 == "" && !strListHas(tvN, tp) {
        an2 = monoInertParamStubPin(decl, args[i], pinTy)
        an2Ty = pinTy[0]
      }
      if an2 == "" && monoHoleGenManyPins {
        monoHoleManyPinsFail(p.parName, fn.fnName)
      }
    }
    // A list argument built at a wider record than its type pins at that rep (D14733).
    if an2 == "" && !tpBare {
      const lpt = elabCallParamTy(monoCallTplOf(callIx), i)
      const lrt = callArgRepTy(monoCallTplOf(callIx), i, lpt)
      if lrt != lpt {
        an2 = monoElabPin(callIx, args, i, lrt, ctx)
        if an2 != "" { an2Ty = lrt }
      }
    }
    // A function the call hands back to a closed function type: the elaboration binds it there,
    // ahead of the template's own signature. A binding of another type parameter seeded from this
    // parameter is built at the template's, so there the elaboration's answer comes second.
    const eftFirst = tpBare && !elabParamSeedsOtherTyParam(fn, params[i], tp)
    const eft = if tpBare { elabCallParamTy(monoCallTplOf(callIx), i) } else { 0 - 1 }
    const eftFn = eft >= 0
      && eft < T.tys.length
      && tyAt(eft) is TyFunc
      && !tyHasTyVar(eft)
    if an2 == "" && eftFn && eftFirst {
      an2 = monoElabPin(callIx, args, i, eft, ctx)
      if an2 != "" { an2Ty = eft }
    }
    if an2 == "" { an2 = monoArgPinName(args[i], ctx, an2Own) }
    if an2 == "" && eftFn && !eftFirst {
      an2 = monoElabPin(callIx, args, i, eft, ctx)
      if an2 != "" { an2Ty = eft }
    }
    if an2Ty < 0 { an2Ty = monoArgPinTyAt(args[i], ctx) }
    if an2 == "" { return monoArgTyFail(p.parName, fn.fnName) }
    if tpBare && monoFwdFnPinMisfits(fn, params[i], args[i], an2Ty) {
      return monoFwdFnPinFail(p.parName, fn.fnName)
    }
    if tpBare && monoHoleCopyCallsMisfit(fn, params[i], an2Ty) {
      return monoHoleManyPinsFail(p.parName, fn.fnName)
    }
    // A parameter handed on keeps its own pin as a generic does (D6202).
    if tpBare && monoReadsParam(args[i]) { genPin = true }
    // The argument's type, read at the instance `ctx` where its own is open. It stays open, and the
    // binding is by the pin's spelling alone, for a hole-typed function value no instance closes and
    // a record whose fields hold one.
    let bind = an2
    let bindTy = monoArgClosedTyIn(args[i], ctx, an2Ty)
    if !tpBare {
      // `T[]` param: the argument is a list by its type and its element binds `T`, spelled by the
      // naming rule from the element's type (D1896); an empty `[]` (its literal default) stays open.
      // A list by its closed type, else by its open pin type's shape (an empty `[]` stays `T[]`).
      const lt = if bindTy >= 0 { bindTy } else { an2Ty }
      if lt < 0 || lt >= T.tys.length || !(tyAt(lt) is TyArray) {
        return emitFail(
          "emitProgram: monomorphize: expected an array argument for `"
            + p.parName
            + "` in a call to `"
            + fn.fnName
            + "`",
        )
      }
      const elemTy = tyArrayElemIx(lt)
      bind = monoPinSpellShaped(elemTy)
      bindTy = tyArrayElemIx(bindTy)
    }
    const b = monoBindOf(tvN, tvV, tp)
    const bound = strListHas(tvN, tp)
    // A `T` an earlier parameter bound: the type it is bound at, or -1 for a spelling alone.
    const boundTy = if bound { monoBindTyOf(tvN, tvT, tp) } else { -1 }
    if !bound {
      tvN.push(tp)
      tvV.push(bind)
      monoTvTyLast(tvN, tvT, bindTy)
    } else if (
      genPin
      && monoPinIsFnTy(an2Ty)
      && !(boundTy >= 0 && an2Ty >= 0 && tyEq(boundTy, an2Ty))
    ) {
      // A generic handed to a second `T` parameter called at another type: a bare-only `T` is
      // split per parameter by the check, or tagged as one set, so `T` takes one here (D6090).
      return emitFail(
        "emitProgram: monomorphize: a generic function handed to two parameters of type `"
          + tp
          + "` in a call to `"
          + fn.fnName
          + "` is called at two types, and `"
          + tp
          + "` takes one",
      )
    } else {
      bind = b
    }
    if !tpBare {
      // A `T[]` pin is the list of the element type `T` binds, spelled from that type; a `T`
      // bound by an explicit argument's spelling alone takes the argument's own closed list type.
      const pet = if bound { boundTy } else { bindTy }
      const plt = if pet >= 0 { mkArrayTy(pet) } else if an2Ty >= 0 && !tyHasTyVar(an2Ty) { an2Ty } else { -1 }
      const pls = if plt >= 0 { monoPinSpellShaped(plt) } else { "" }
      if pls == "" {
        return emitFail(
          "emitProgram: monomorphize: a `T[]` parameter's list type has no closed spelling",
        )
      }
      pinned.push(pls)
      pinTys.push(monoArgPinTyAt(args[i], ctx))
      const lpat = monoParamPatTy(
        params,
        i,
        monoDeclParamTysOf(decl, params.length),
      )
      pinOwn.push(
        monoClosedSlotTyAt(
          lpat,
          topFnOwnerOf(decl),
          tvN,
          monoPinOwnTvAtRep(tvN, tvV, tvT),
        ),
      )
    } else {
      // A `T` an earlier parameter bound pins this one at that binding's type, not the argument's.
      pinned.push(bind)
      pinTys.push(if boundTy >= 0 { boundTy } else { an2Ty })
      // The type the ladder spelled the pin from, at the rep its spelling collapses to.
      const ownAt = if bind == an2 && an2Own[0] >= 0 { an2Own[0] } else { an2Ty }
      pinOwn.push(if boundTy >= 0 { boundTy } else { monoAnnPinTy(ownAt) })
    }
  }
  0
}

// Binds the type parameters arrow annotation `annIx` names that are still unbound to the
// parameter type the elaboration gives argument `i` of call `callIx`, as an un-annotated
// function handed to `(T) => R` binds `R` (D8943), or to `((T) => R) | null`.
function monoBindArrowRet(
  annIx: i32,
  callIx: i32,
  i: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  tvT: i32[],
) {
  monoBindArenaFullTys(
    nodeTyIxOf(annIx),
    elabCallParamTy(monoCallTplOf(callIx), i),
    typarams,
    tvN,
    tvV,
    tvT,
  )
}

// The pin spelling of `t` a typed binding takes: a declared record or union by its name, as the
// written annotation would spell it, so `Tbl<Tex>` and a `@flat` row keep their identity; a list
// or literal union as `monoPinAnnSpelling` spells it.
function monoPinNominalSpelling(t: i32): string {
  if t < 0 || t >= T.tys.length || tyAt(t) is TyArray || tyIsLitUnion(t) {
    return monoPinAnnSpelling(t)
  }
  const tw = monoFnFieldTwinRow.get(t) ?? ""
  if tw != "" { return tw }
  const nm = tyToNominalName(t)
  if nm != "" { return nm }
  monoPinAnnSpelling(t)
}

// `monoBindArenaFull` of list parameter `pt` at a list literal `ax` whose own type is still open
// (`[xs[0], inc]` at `((U) => U)[]`): each closed element's type binds the element pattern in
// turn, so `inc` binds `U` where the open read cannot. 0.
function monoBindListLitElems(
  pt: i32,
  ax: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  tvT: i32[],
) {
  const a = unwrapParen(ax)
  if pt < 0 || pt >= T.tys.length || a < 0 || !(tyAt(pt) is TyArray) {
    return 0
  }
  const an = nodeAt(a)
  if !(an is ArrayLit) { return 0 }
  const pe = tyArrayElemIx(pt)
  let k = 0
  while k < an.arrElems.length {
    const el = an.arrElems[k]
    if el >= 0 && !(nodeAt(el) is Spread) {
      const et = nodeTyIxOf(unwrapParen(el))
      if et >= 0 && !tyHasTyVar(et) {
        monoBindArenaFullTys(pe, et, typarams, tvN, tvV, tvT)
      }
    }
    k = k + 1
  }
  0
}

// Binds each of `typarams` still unbound that declared parameter type `pt` names to what
// `bindGenWalkFull` pairs it with in argument type `at`, through unions and generic applications,
// spelled by `monoPinNominalSpelling` with its type beside it in `tvT`. A parameter bound to
// `never` takes `void`, as a `never` function value lowers. 0.
function monoBindArenaFullTys(
  pt: i32,
  at: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  tvT: i32[],
) {
  if pt < 0 || at < 0 || at >= T.tys.length { return 0 }
  const rN: string[] = []
  const rT: i32[] = []
  bindGenWalkFull(pt, at, rN, rT)
  let k = 0
  while k < rN.length {
    if rT[k] == TY_NEVER { rT[k] = TY_VOID }
    if strListHas(typarams, rN[k]) && !strListHas(tvN, rN[k]) {
      if !tyHasTyVar(rT[k]) {
        const sp = monoPinNominalSpelling(rT[k])
        if sp != "" {
          tvN.push(rN[k])
          tvV.push(sp)
          monoTvTyLast(tvN, tvT, rT[k])
        }
      }
    }
    k = k + 1
  }
  0
}

// Binds each type parameter of `typarams` still unbound in `tvN`/`tvV` that stands as a union arm
// of parameter type `pt`, where argument pin `at` is known, at the call's elaboration binding. 0.
function monoBindInnerArmPins(
  call: i32,
  pt: i32,
  at: i32,
  typarams: string[],
  tvN: string[],
  tvV: string[],
  tvT: i32[],
) {
  if pt < 0 || at < 0 || at >= T.tys.length { return 0 }
  const rN: string[] = []
  const rT: i32[] = []
  elabBindUnionArmsFromCall(call, pt, rN, rT)
  monoPushPins(rN, rT, typarams, tvN, tvV, tvT)
}

// Pushes each binding of `rN`/`rT` that names one of `typarams` still unbound in `tvN`/`tvV`
// and is closed, spelled as a pin. 0.
function monoPushPins(
  rN: string[],
  rT: i32[],
  typarams: string[],
  tvN: string[],
  tvV: string[],
  tvT: i32[],
) {
  let k = 0
  while k < rN.length {
    if strListHas(typarams, rN[k]) && !strListHas(tvN, rN[k]) {
      const sp = monoPinAnnSpelling(rT[k])
      if sp != "" && !tyHasTyVar(rT[k]) {
        tvN.push(rN[k])
        tvV.push(sp)
        monoTvTyLast(tvN, tvT, rT[k])
      }
    }
    k = k + 1
  }
  0
}

// The arena type of `tp`'s first binding in `tvN`/`tvT`; -1 for a binding by spelling alone.
function monoBindTyOf(tvN: string[], tvT: i32[], tp: string): i32 {
  let k = 0
  while k < tvN.length {
    if tvN[k] == tp { return if k < tvT.length { tvT[k] } else { -1 } }
    k = k + 1
  }
  -1
}

// Records `t` as the arena type of the binding just pushed onto `tvN`, padding `tvT` with -1 for
// the bindings before it pushed by spelling alone, so `tvT` stays index-aligned with `tvN`. 0.
function monoTvTyLast(tvN: string[], tvT: i32[], t: i32) {
  while tvT.length < tvN.length - 1 { tvT.push(0 - 1) }
  if tvT.length == tvN.length - 1 { tvT.push(t) }
  0
}

// Appends to `hN`/`hT` each type parameter whose first binding in `tvN` carries a closed type in
// `tvT`. One first bound by spelling alone is left out, never read off its spelling. 0.
function monoTypedBinds(tvN: string[], tvT: i32[], hN: string[], hT: i32[]) {
  const seen: string[] = []
  let k = 0
  while k < tvN.length {
    if !strListHas(seen, tvN[k]) {
      seen.push(tvN[k])
      const t = if k < tvT.length { tvT[k] } else { -1 }
      if t >= 0 && t < T.tys.length && !tyHasTyVar(t) {
        hN.push(tvN[k])
        hT.push(t)
      }
    }
    k = k + 1
  }
  0
}

// The slot type `patTy` declared in the generic `own` names, under the typed bindings of
// `tvN`/`tvT`; -1 when it has no type or a type variable stays open.
function monoClosedSlotTyAt(
  patTy: i32,
  own: string,
  tvN: string[],
  tvT: i32[],
): i32 {
  if patTy < 0 || patTy >= T.tys.length { return -1 }
  const hN: string[] = []
  const hT: i32[] = []
  monoTypedBinds(tvN, tvT, hN, hT)
  const s = substTyDeepOf(patTy, hN, hT, own)
  if s < 0 || s >= T.tys.length || tyHasTyVar(s) { return -1 }
  s
}

// The parameter types of the function slot declared `patTy` in the generic `own` names, a
// nullable slot by its function, under the typed bindings of `tvN`/`tvT`; empty when one stays
// open, so the delivery's spelling answers.
function monoSlotParamTysAt(
  patTy: i32,
  own: string,
  tvN: string[],
  tvT: i32[],
): i32[] {
  const none: i32[] = []
  let s = monoClosedSlotTyAt(patTy, own, tvN, tvT)
  if s < 0 { return none }
  const nf = tyNulFuncInner(s)
  if nf >= 0 { s = nf }
  monoFnTyParamTys(s)
}

// The read `[read, frame]` of the written `let` of generics (`monoWrittenGenLetFrame`) that the
// name read at `at` in frame `ctx` is, or reaches through a chain of un-annotated aliases never
// written after their initializer (D9130); `[-1, -1]` for none.
function monoHandLetRead(at: i32, ctx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1]
  if at < 0 || !(nodeAt(at) is Ident) { return none }
  let ax = at
  let fr = ctx
  let hops = 0
  while hops < MONO_ALIAS_CHAIN_MAX {
    if monoWrittenGenLetFrame(ax, fr)[1] >= 0 {
      const out: i32[] = [ax, fr]
      return out
    }
    const lf = monoReadLetFrame(ax, fr)
    if lf[1] < 0 { return none }
    const d = nodeAt(lf[1])
    if !(d is LetDecl) || d.letType >= 0 || d.letInit < 0 { return none }
    if d.letKw != "const" && monoLetWrittenIn(lf) { return none }
    const iv = unwrapParen(d.letInit)
    if iv < 0 || !(nodeAt(iv) is Ident) { return none }
    ax = iv
    fr = lf[0]
    hops = hops + 1
  }
  none
}

// Hands the re-pointed `let` read at `arg` to arrow parameter `p` of `fn`: every function it may
// hold is instanced at the parameter's type the value arguments bind (D9001). 1 when that type
// closed, 0 when it did not, -1 when an earlier delivery took another type.
function monoHandWrittenLet(
  p: Param,
  fn: FuncDecl,
  arg: i32,
  ctx: i32,
  tvN: string[],
  tvV: string[],
  tvT: i32[],
  patTy: i32,
  own: string,
  callIx: i32,
  argI: i32,
): i32 {
  const at = unwrapParen(arg)
  const lf = monoWrittenGenLetFrame(at, ctx)
  if monoParamTyOpenAt(p.parType, fn.fnTyParams, tvN) {
    monoBindArrowRet(p.parType, callIx, argI, fn.fnTyParams, tvN, tvV, tvT)
  }
  // The functions are instanced at the type the elaboration gives the parameter at this call;
  // the checker refuses a binding whose functions give two results there (D9003).
  const ept = elabCallParamTy(monoCallTplOf(callIx), argI)
  if !monoTyClosedFn(ept) {
    return emitFailAt(
      "emitProgram: internal: a reassigned function binding handed to a function parameter has no closed elaborated parameter type",
      at,
    )
  }
  const key = i32ToStr(lf[0]) + ":" + i32ToStr(lf[1])
  const was = monoWrittenLetHanded.get(key) ?? -1
  if was >= 0 && !tySame(was, ept) {
    const d = nodeAt(lf[1])
    let nm = ""
    if d is LetDecl { nm = d.letName }
    return emitFail(MONO_BIND_SIG_PRE + nm + MONO_BIND_SIG_POST)
  }
  monoWrittenLetHanded[key] = ept
  monoCoerceWrittenLetTys(
    at,
    ctx,
    monoSlotParamTysAt(patTy, own, tvN, tvT),
    ept,
    [],
  )
  1
}

// The closed type the elaboration gives composite parameter `p` of `fn` (declaration `decl`) at
// argument `i` of call `callIx`, which its pin takes; -1 where the composite path still decides:
// an annotation or a type holding a function, a body testing a type parameter, or a type
// parameter spelled as a builtin or a declared record.
function monoElabCompositeTy(
  p: Param,
  fn: FuncDecl,
  decl: i32,
  callIx: i32,
  i: i32,
): i32 {
  const at = nodeTyIxOf(p.parType)
  if (
    !monoAnnHasTyParam(p.parType, -1, fn.fnTyParams)
    || nodeTyIsFunc(p.parType)
    || monoAnnIsFnSlot(p.parType)
    || tyMayHoldFn(at, 0)
    || elabTestsTyVar(decl)
  ) {
    return -1
  }
  for tp in fn.fnTyParams {
    if gaeParamShadowed(tp) || structIndexByName(tp) >= 0 { return -1 }
  }
  const ept = elabCallParamTy(monoCallTplOf(callIx), i)
  if ept < 0 || tyHasTyVar(ept) || tyMayHoldFn(ept, 0) { return -1 }
  // A body reading a type parameter's layout (`T.size`) or testing it reads the parameter's pin
  // by its spelling (`Rows<TValue>`), which the composite path keeps and this type's may not.
  for tp in fn.fnTyParams {
    const one: string[] = [tp]
    const seen: i32[] = []
    if (
      monoAnnHasTyParam(p.parType, -1, one)
      && elabTyParamReachesSpelling(fn.fnBody, one, seen)
    ) {
      return -1
    }
  }
  ept
}

// Pins parameter `p`'s composite annotation riding type params: -1 on a refusal, else 0.
function monoPinTyParamComposite(
  p: Param,
  fn: FuncDecl,
  params: i32[],
  args: i32[],
  i: i32,
  callIx: i32,
  ctx: i32,
  tvN: string[],
  tvV: string[],
  tvT: i32[],
  pinned: string[],
  pinTys: i32[],
  pinOwn: i32[],
  decl: i32,
): i32 {
  const patTy = monoParamPatTy(
    params,
    i,
    monoDeclParamTysOf(decl, params.length),
  )
  const own = topFnOwnerOf(decl)
  // A bundle handed to a function-typed parameter hands the member at its type.
  const hm = elabCallHandMember(monoCallTplOf(callIx), i)
  if hm >= -1 { bundleHandMemberNote(args[i], hm) }
  // Whether a rung below answers the argument's type: a function-type param (`f: (A, T) => A`)
  // binds from the closure argument's function type, any other composite (`Box<T>`, `{a:T}`) from
  // its concrete value type.
  let anC = false
  // The argument's own `#anonN` row, kept as the parameter's pin where its spelled
  // shape would resolve to a declared record sharing the field names.
  let anRowPin = ""
  const annIsFn = nodeTyIsFunc(p.parType)
  // A nullable function slot takes a function value as a function slot does; only its
  // argument's own spelling is read as any other composite's (D9820).
  const annFnSlot = monoAnnIsFnSlot(p.parType)
  if annFnSlot {
    // An alias of a written `let` hands that `let`, whatever its initializer names (D9130).
    const ax = unwrapParen(args[i])
    const wl = monoHandLetRead(ax, ctx)
    // A generic function value takes the type the value arguments bound (D3913), and so does
    // an un-annotated lambda or alias of one (D8981).
    if (
      (wl[0] < 0 || wl[0] == ax)
      && (monoCalleeIsGeneric(ax)
        || monoArgIsOpenFnValue(args[i], ctx)
        || monoArgIsOpenFnChoice(args[i], 0)
        || monoArgCallsBackGeneric(args[i]))
    ) {
      if monoParamTyOpenAt(p.parType, fn.fnTyParams, tvN) {
        monoBindArrowRet(p.parType, callIx, i, fn.fnTyParams, tvN, tvV, tvT)
      }
      anC = !monoParamTyOpenAt(p.parType, fn.fnTyParams, tvN)
    } else if wl[0] >= 0 {
      const hr = monoHandWrittenLet(
        p,
        fn,
        wl[0],
        wl[1],
        tvN,
        tvV,
        tvT,
        patTy,
        own,
        callIx,
        i,
      )
      if hr < 0 { return hr }
      if hr > 0 { anC = !monoParamTyOpenAt(p.parType, fn.fnTyParams, tvN) }
    }
  }
  // The argument's own function-type name, where the slot's binding above names none: a generic
  // function value takes the type the call binds, not its template's.
  if annIsFn && !anC { anC = monoArgFnTypeName(args[i], ctx) != "" }
  // Else the closed parameter type the call key binds; a list read takes it in the arm below.
  if annIsFn && !anC && !(nodeAt(unwrapParen(args[i])) is Index) {
    anC = monoTyClosedFn(elabCallParamTy(monoCallTplOf(callIx), i))
  }
  if !annIsFn && !anC {
    const an = monoArgPinName(args[i], ctx, [0 - 1])
    anC = an != ""
    // An anonymous row's `#anonN` has no fields to match the pattern against;
    // the checker's spelled shape does, unless the render softens a literal (D3123).
    const anTy = nodeTyIxOf(unwrapParen(args[i]))
    if (
      an.length >= 5
      && an.slice(0, 5) == "#anon"
      && !monoAnonArgSoftens(args[i], anTy)
      && monoAnnPinNameOfTy(anTy) != ""
      && !monoSpelledShapeStaysAnon(anTy)
    ) {
      anRowPin = an
    }
    if !anC && monoLitHoldsGenericFn(args[i], 0) {
      anC = !monoParamTyOpenAt(p.parType, fn.fnTyParams, tvN)
    }
  }
  // A read out of a list its pin annotated, at any depth, takes the element type (D10310).
  let atTy = monoPinSubTyOf(monoArgPinTyAt(args[i], ctx), ctx)
  if annFnSlot && !anC && nodeAt(unwrapParen(args[i])) is Index {
    const ept = elabCallParamTy(monoCallTplOf(callIx), i)
    if monoTyClosedFn(ept) {
      anC = true
      atTy = ept
    }
  }
  // An argument typed at this parameter with the callee's own type parameters still open, as an
  // empty `Map()` or `[]` is, binds them by the call's instance, else at the default (D14735).
  const openArg = !annIsFn && monoTyMentionsTyParam(atTy, fn.fnTyParams)
  if !anC && !openArg { return monoArgTyFail(p.parName, fn.fnName) }
  monoBindInnerArmPins(
    monoCallTplOf(callIx),
    nodeTyIxOf(p.parType),
    monoPinSubTyOf(monoArgPinTyAt(args[i], ctx), ctx),
    fn.fnTyParams,
    tvN,
    tvV,
    tvT,
  )
  monoBindArenaFullTys(patTy, atTy, fn.fnTyParams, tvN, tvV, tvT)
  if tyHasTyVar(atTy) {
    monoBindListLitElems(patTy, args[i], fn.fnTyParams, tvN, tvV, tvT)
  }
  if openArg {
    monoBindArenaFullTys(
      patTy,
      elabCallParamTy(monoCallTplOf(callIx), i),
      fn.fnTyParams,
      tvN,
      tvV,
      tvT,
    )
    for tp in fn.fnTyParams {
      if !strListHas(tvN, tp) && tyMentionsTyVarNamed(patTy, tp, 16) {
        monoBindTyParamElab(callIx, tp, tvN, tvV, tvT)
      }
    }
  }
  if monoAnnIsUnion(p.parType) {
    monoDefaultAnnTyParams(
      fn.fnTyParams,
      tvN,
      tvV,
      tvT,
      fn.fnBody,
      params,
      i,
      callIx,
    )
  }
  // The parameter's type closed under the instance's typed bindings, spelled by the naming rule;
  // a slot that stays open has no pin.
  const po = monoClosedSlotTyAt(
    patTy,
    own,
    tvN,
    monoPinOwnTvAtRep(tvN, tvV, tvT),
  )
  let pinC = if po >= 0 { monoPinSpellShaped(po) } else { "" }
  const pinPlain = pinC
  if i < monoUnionRestPin.length && monoUnionRestPin[i] != "" {
    pinC = monoUnionRestPin[i]
  }
  if anRowPin != "" && pinC != "" { pinC = anRowPin }
  if pinC == "" { return monoArgTyFail(p.parName, fn.fnName) }
  // The coercion `monoWalk` deferred, since at that point the pin names
  // would be the type variables themselves. `pinC` is the substituted
  // spelling, the concrete function type that parameter takes.
  if annFnSlot || (pinC == pinPlain && tyIsClosureArray(po)) {
    const delTys = monoSlotParamTysAt(patTy, own, tvN, tvT)
    // The parameter's type substituted, which `pinC` spells unless a rest or row pin replaced it.
    const pinCTy = if pinC == pinPlain { substTyDeepOf(patTy, tvN, tvT, own) } else { -1 }
    const pinCFt = if pinCTy >= 0 && !tyHasTyVar(pinCTy) { pinCTy } else { -1 }
    if monoCoerceFnValueTys(args[i], ctx, -1, delTys, pinCFt) < 0 { return -1 }
  }
  // The pin spells its own type where that closes and nothing replaced the substitution.
  const poSp = if pinC == pinPlain && po >= 0 { monoPinSpellOf(po) } else { "" }
  pinned.push(if poSp != "" { poSp } else { pinC })
  // A generic function value's own type still rides its type variables, so
  // it names no row this pin denotes; the substituted spelling is the answer.
  let pinCTy = monoPinSubTyOf(monoArgPinTyAt(args[i], ctx), ctx)
  // A record literal argument is delivered at the record its instance's elaboration builds it at.
  const litAx = unwrapParen(args[i])
  if litAx >= 0 && nodeAt(litAx) is ObjLit {
    const lr = litRepTyAt(litAx, ctx)
    if lr >= 0 && lr < T.tys.length && !tyHasTyVar(lr) { pinCTy = lr }
  }
  if pinCTy >= 0 && tyHasTyVar(pinCTy) { pinCTy = -1 }
  // A function-type slot whose argument's own type stays open is pinned at its annotation
  // under the typed bindings, when that closes.
  if pinCTy < 0 && annIsFn { pinCTy = monoClosedSlotTyAt(patTy, own, tvN, tvT) }
  pinTys.push(pinCTy)
  pinOwn.push(po)
  0
}

// The one decision of callback specialization: the function call `callIx` (to `selfName`) bakes
// for its argument `argIx` as a direct call, or "" to keep the `call_ref`. Baked only for a known,
// non-capturing, non-generic function whose name means it at top level, on a call not made
// through a written binding of another name (architecture-target §3.4).
function monoSpecializableCallbackName(
  callIx: i32,
  selfName: string,
  argIx: i32,
  ctx: i32,
) {
  const ax = unwrapParen(argIx)
  if ax < 0 { return "" }
  const an = nodeAt(ax)
  let fe = -1
  // The Ident arm is scope-aware, like the call and function-value paths: the flat
  // `fnIndexOf` hands every frame the module's first function of this name, so the two
  // soundness gates below would be asked about the wrong function whenever two frames
  // declare a same-named callback.
  if an is FuncDecl {
    fe = fnStmtsPosOf(ax)
  } else if an is Ident {
    fe = monoRenamedFeOf(ax, an.identName)
    if fe < 0 { fe = fnIndexOfInScopeAt(sidOfNode(ax), an.identName, ctx, ax) }
  }
  if fe < 0 || fe >= fnStmts.length { return "" }
  if !exprIsClosure(argIx, ctx) { return "" }
  if captureCountOf(fe) > 0 { return "" }
  if fe < monoGen.length {
    if monoGen[fe] == 1 { return "" }
  }
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    // The bake is by name and the clone is top-level: `monoBakeCallback` rewrites the
    // callback param's call into a by-name call inside a fresh function pushed with
    // `fnParent = -1`, so the name is re-resolved with no enclosing frame. Decline rather
    // than bake a name that does not mean what the caller meant; `__lambda_N` is unique.
    if fe != fnIndexOf(fn.fnName) { return "" }
    // A call through a written binding bakes none: the binding holds one instance, and each
    // baked callback would key its own (D12219).
    const cl = nodeAt(callIx)
    if cl is Call {
      const cfx = cl.callFn
      if (
        cfx >= 0
        && cfx < P.nodes.length
        && nodeAt(cfx) is Ident
        && monoIdentNameOf(cfx) != selfName
        && monoNameWrittenAt(monoIdentNameOf(cfx), cfx)
      ) {
        return ""
      }
    }
    if idShadowModeOf() == 0 { return fn.fnName }
    return idShadowSpec(ax, fnStmts[fe], fn.fnName, elabIdentityFnTy(ax, ctx))
  }
  ""
}

// Does the non-generic function at `fe` take a closure-typed parameter — is it a concrete
// higher-order function, a candidate for callback specialization? Excludes a `<T>` generic, whose
// callbacks `monoBakeCallback` bakes, and, with no lambda to prune, an un-annotated return,
// which `monoSpecializeConcrete` declines before reading any argument.
function feHasClosureParam(fe: i32) {
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    if fn.fnTyParams.length > 0 { return false }
    if fn.fnRet < 0 && !fnNestUsed { return false }
    let i = 0
    while i < fn.fnParams.length {
      const p = nodeAt(fn.fnParams[i])
      if p is Param {
        if p.parType >= 0 {
          if tyIsFuncType(p.parType) { return true }
        }
      }
      i = i + 1
    }
  }
  false
}

// Whether the program defines any concrete higher-order function — the gate that lets the
// mono pass run for callback specialization even with no `<T>` generic. The compiler
// itself has none, so the pass stays skipped for it and the all-i32 native fixpoint holds.
function monoHasConcreteHOFParam() {
  let fe = 0
  while fe < fnStmts.length {
    if fe < monoGen.length {
      if monoGen[fe] == 0 {
        if feHasClosureParam(fe) { return true }
      }
    }
    fe = fe + 1
  }
  false
}

// Callback specialization for a concrete (non-generic) higher-order function: clone it
// with a non-capturing callback baked in as a direct call, append it as `<name>$cbN`, and
// point the call site at it. Keyed purely on callback identity. Unlike a generic template
// the original is kept, so it still serves any non-bakeable caller. Returns 0, or -1.
function monoSpecializeConcrete(callIx: i32, fe: i32, ctx: i32) {
  const c = nodeAt(callIx)
  if c is Call && c.callFn >= 0 {
    // The one read of `fnStmts[fe]` this function needs — kept in `fnDeclIx` rather than
    // re-indexed below, so a second unguarded read of the same fall-through parameter does
    // not open a second sentinel-index hit (D2325).
    const fnDeclIx = fnStmts[fe]
    const fn = nodeAt(fnDeclIx)
    if fn is FuncDecl {
      const params = fn.fnParams
      const args = monoArgsInParamOrder(callIx, fnDeclIx)
      if args.length != params.length { return 0 }
      // Only an annotated return is specialized. An un-annotated one is inferred through
      // the callback param's call, and baking that re-derives it via a path that does
      // not re-establish a nullable or union rep on the appended function.
      if fn.fnRet < 0 { return 0 }
      // The baked callback per position — "" where the argument is not a non-capturing
      // concrete function (a capturing lambda / generic / non-closure stays call_ref).
      const cbFnNames: string[] = []
      let i = 0
      while i < args.length {
        cbFnNames.push(
          monoSpecializableCallbackName(callIx, fn.fnName, args[i], ctx),
        )
        i = i + 1
      }
      if !monoAnyBakedCallback(cbFnNames) { return 0 }
      const specAt = elabSpecDemand(callIx, ctx, fnDeclIx, args, cbFnNames)
      // Key on the callee plus each baked callback identity, so `reduce(xs, add, …)` and
      // `reduce(xs, mul, …)` get distinct specializations. The `C` prefix keeps these out
      // of the generic keyspace, which always carries a `#`.
      let key = "C" + i32ToStr(fe)
      let kc = 0
      while kc < cbFnNames.length {
        if cbFnNames[kc] != "" { key = key + "@" + cbFnNames[kc] }
        kc = kc + 1
      }
      elabSpecMonoGroup(specAt, key)
      // A decision the elaboration declines to key is not specialized: the call keeps its callee.
      const specK = elabSpecKeyOf(specAt)
      if specK < 0 { return 0 }
      // Registry hit: the instance the (S1) map holds for the decision's key.
      const slot = elabSpecSlotOfKey(specK)
      let r = 0
      while slot >= 0 && r < monoKeys.length {
        if monoInstFe[r] == slot {
          const cal = nodeAt(c.callFn)
          // R4 writer 7 of 8 (`compiler/symbols.vl`; census in `perf-program.md`).
          if cal is Ident {
            cal.identName = monoInstName[r]
            monoNoteRenamed(c.callFn, monoInstFe[r])
            sidNoteNodeName(c.callFn, fnStmts[monoInstFe[r]])
          }
          elabSpecMonoSlot(specAt, monoInstFe[r])
          return 0
        }
        r = r + 1
      }
      // Fresh specialization. `$cbN` is disambiguated by how many concrete specializations this
      // callee already has (its prior `monoInstOrig` entries).
      let count = 0
      let kk = 0
      while kk < monoInstOrig.length {
        if monoInstOrig[kk] == fe { count = count + 1 }
        kk = kk + 1
      }
      const instBody = monoBakeCallback(fn.fnBody, cbFnNames, specK)
      const nps: i32[] = []
      let pj = 0
      while pj < params.length {
        const p3 = nodeAt(params[pj])
        if p3 is Param {
          nps.push(
            mkParam(
              p3.parName,
              p3.parType,
              p3.parDefault,
              p3.parOpt,
              p3.parRest,
              p3.pos,
            ),
          )
          identFrom(nps[nps.length - 1], params[pj])
        }
        pj = pj + 1
      }
      const noTP: string[] = []
      const specName = fn.fnName + "$cb" + i32ToStr(count)
      const nfn = mkFunc(specName, noTP, nps, fn.fnRet, instBody, fn.pos)
      fnStmts.push(nfn)
      fnParent.push(-1)
      fnDispNames.push("")
      const instFe = fnStmts.length - 1
      // The in-place rename below lands on nodes this specialization may share. That
      // sharing is not divergent: a concrete declaration has all its parameters
      // annotated, so every specialization writes the same name.

      // What the sharing costs is the revisit: the body below is walked once per
      // specialization and once by the main loop, so a nested generic landing on a count>0
      // instance is re-read under its instance name (see `monoFnParamTypeAt`).
      const cal2 = nodeAt(c.callFn)
      // R4 writer 8 of 8 (`compiler/symbols.vl`; census in `perf-program.md`).
      if cal2 is Ident {
        cal2.identName = specName
        monoNoteRenamed(c.callFn, instFe)
        sidNoteNodeName(c.callFn, fnStmts[instFe])
      }
      monoKeys.push(key)
      monoInstOrig.push(fe)
      monoInstName.push(specName)
      monoInstFe.push(instFe)
      elabSpecMonoSlot(specAt, instFe)
      if monoRegisterInstance() < 0 { return -1 }
      // Walk the ORIGINAL body under this specialization's context so a nested generic call it
      // contains instantiates (idempotent via the registry — the main loop also walks the original).
      if monoWalk(fn.fnBody, nfn) < 0 { return -1 }
      if monoRegisterInstance() < 0 { return -1 }
    }
  }
  0
}

// `copy`, a fresh node standing for `orig`, after it takes `orig`'s binding identity.
function monoCopyOf(orig: i32, copy: i32) {
  nodeSrcNote(copy, orig)
  identFrom(copy, orig)
  copy
}

// The declaration of the function a minted callee names: a registered instance, else the one
// function declared under `name`; -1 when none is, or when two are and the name cannot choose.
function monoFnDeclNamed(name: string) {
  const inst = monoInstDeclOf(name)
  if inst >= 0 { return inst }
  fnDeclNamed(name)
}

// The declaration of the instance registered as `name`, or -1 when none is.
function monoInstDeclOf(name: string) {
  let i = monoInstName.length - 1
  while i >= 0 {
    if (
      monoInstName[i] == name
      && monoInstFe[i] >= 0
      && monoInstFe[i] < fnStmts.length
    ) {
      return fnStmts[monoInstFe[i]]
    }
    i = i - 1
  }
  -1
}

// Points `calleeIx`, an instance's own copy of a call through a lambda binding, at the
// lambda's instance `instName` by name, as a later instance's call is. A capturing lambda
// keeps its value call, whose env the name would drop; so does a reassigned binding.
function monoLamCallByName(calleeIx: i32, origFe: i32, instName: string) {
  if !i32ListHas(monoLamCallCallees, calleeIx) { return 0 }
  if i32ListHas(monoNoRename, calleeIx) { return 0 }
  if !criFnIsAnonLambda(origFe) || captureCountOf(origFe) > 0 { return 0 }
  const cal = nodeAt(calleeIx)
  if cal is Ident {
    if (
      cal.identName == instName
      || monoReadIsAssigned(cal.identName, calleeIx)
    ) {
      return 0
    }
    cal.identName = instName
    monoNoteRenamed(calleeIx, monoSlotOfDecl(monoFnDeclNamed(instName)))
    sidNoteNodeName(calleeIx, monoFnDeclNamed(instName))
  }
  0
}

// The lifted lambda the call at callee `calleeIx` inside frame `ctx` reaches through a capture:
// the read's declaration is an un-annotated `const` of an enclosing function's frame holding a
// lambda. -1 otherwise, and for a binding of `ctx` itself or of the module.
function monoCapturedLamFe(calleeIx: i32, ctx: i32): i32 {
  if ctx < 0 { return -1 }
  const e = identDeclOf(calleeIx)
  if e < 0 || e >= P.nodes.length || !(nodeAt(e) is LetDecl) { return -1 }
  const df = monoDeclFrameIn(e, ctx)
  if df[0] < 0 || df[0] == ctx { return -1 }
  const d = nodeAt(df[1])
  if !(d is LetDecl) { return -1 }
  if d.letKw != "const" || d.letType >= 0 { return -1 }
  const fe = fieldValueFeOfIn(d.letInit, df[0])
  if fe < 0 || !criFnIsAnonLambda(fe) { return -1 }
  fe
}

// The source declaration that declaration `d` is a rewrite's copy of, or `d` itself.
function monoDeclCanon(d: i32): i32 {
  const o = declOrigOf(d)
  if o >= 0 { return o }
  d
}

// The source declaration the read `at` resolves to, when `at` is an `Ident` spelling `name`
// that the checker resolved to a node; -1 when it is not, so the caller falls back to the name.
function monoReadDecl(name: string, at: i32): i32 {
  if at < 0 || at >= P.nodes.length { return -1 }
  const n = nodeAt(at)
  if n is Ident {
    if n.identName != name { return -1 }
    const d = identDeclOf(at)
    if d < 0 || d >= P.nodes.length { return -1 }
    return monoDeclCanon(d)
  }
  -1
}

// Whether function `fx` declares a parameter named `name`.
function monoFnBindsParam(fx: i32, name: string): boolean {
  const f = nodeAt(fx)
  if f is FuncDecl {
    let i = 0
    while i < f.fnParams.length {
      const p = nodeAt(f.fnParams[i])
      if p is Param {
        if p.parName == name { return true }
      }
      i = i + 1
    }
  }
  false
}

// The lifted lambda the binding read at `at` in frame `ctx` holds, where the flow table names a
// chain of un-annotated aliases ending at a hole lambda's `const` (`lamChainOf`); `viaLet`
// counts a `let` already behind. -1 for none, a loud refusal past the longest chain.
function monoAliasLamFe(at: i32, ctx: i32, viaLet: boolean): i32 {
  monoChainLamFe(lamChainOf(at, viaLet), at, ctx)
}

// `monoAliasLamFe` for the capture cell read at `at` (`d[0]`): the rewrite turns a captured
// `let d = c` that is written after capture into `let d = [c]` and each read into `d[0]` (D3845).
function monoCellLamFe(at: i32, ctx: i32): i32 {
  monoChainLamFe(lamCellOf(at), at, ctx)
}

// The lifted lambda of the binding `e` a chain answer (`check_lam_chain.vl`) names, as frame `ctx` or the
// frame enclosing it that declares it holds it; -1 for none.
function monoChainLamFe(e: i32, at: i32, ctx: i32): i32 {
  if e == LC_CHAIN_LONG {
    return emitFailAt(
      "emitProgram: a call through a chain of more than "
        + i32ToStr(MONO_ALIAS_CHAIN_MAX)
        + " un-annotated aliases of a lambda has no signature to lower at — annotate the lambda's parameters",
      at,
    )
  }
  const c = monoDeclCopyIn(e, ctx)
  if c < 0 { return -1 }
  const d = nodeAt(c)
  if !(d is LetDecl) || d.letInit < 0 { return -1 }
  const ls = fnStmtsPosOf(d.letInit)
  if ls < 0 || !criFnIsAnonLambda(ls) { return -1 }
  ls
}

// The declaration standing for the flow table's pre-mono declaration `e` in frame `ctx` or the
// nearest enclosing frame declaring it, since an instance declares its own copy of each of its
// template's; `e` itself at module scope, and -1 past eight frames.
function monoDeclCopyIn(e: i32, ctx: i32): i32 { monoDeclFrameIn(e, ctx)[1] }

// `monoDeclCopyIn` as `[frame, declaration]`, the frame -1 at module scope; `[-1, -1]` for none.
function monoDeclFrameIn(e: i32, ctx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1]
  if e < 0 || e >= P.nodes.length { return none }
  if elabDeclFnOf(e) == -1 {
    const top: i32[] = [0 - 1, e]
    return top
  }
  let fx = ctx
  let hops = 0
  while hops < 8 && fx >= 0 {
    const c = monoBodyDeclCopy(monoNestedBodyOf(fx), e)
    if c >= 0 {
      const out: i32[] = [fx, c]
      return out
    }
    const slot = fnStmtsPosOf(fx)
    if slot < 0 || slot >= fnParent.length { return none }
    const ps = fnParent[slot]
    if ps < 0 || ps >= fnStmts.length { return none }
    fx = fnStmts[ps]
    hops = hops + 1
  }
  none
}

// `[frame, declaration]` of the `let` the read at `at` (a name, or a capture cell's `d[0]`)
// names by declaration, in frame `ctx` or the nearest enclosing frame holding its copy;
// `[-1, -1]` for a read of anything else, such as a parameter.
function monoReadLetFrame(at: i32, ctx: i32): i32[] {
  const none: i32[] = [0 - 1, 0 - 1]
  if at < 0 || at >= P.nodes.length { return none }
  let r = at
  const rn = nodeAt(at)
  if rn is Index {
    if monoCellReadName(at) == "" { return none }
    r = rn.idxArr
  }
  if !(nodeAt(r) is Ident) { return none }
  const e = identDeclOf(r)
  if e < 0 || e >= P.nodes.length || !(nodeAt(e) is LetDecl) { return none }
  monoDeclFrameIn(e, ctx)
}

// Per body `monoBodyDeclCopy` has indexed at arena stamp `monoBodyDeclStamp`: its row, and per
// row each `let`'s visit order, and the first `let` copying each original declaration.
let monoBodyDeclStamp = 0 - 1
let monoBodyDeclRow: {[i32]: i32} = Map()
let monoBodyDeclPos: {[i32]: i32}[] = []
let monoBodyDeclByOrig: {[i32]: i32}[] = []

// The `let` in `body`, outside the functions nested in it, that is or copies declaration `e`;
// the first such in one walk of the body, which is indexed once per arena stamp.
function monoBodyDeclCopy(body: i32, e: i32): i32 {
  if body < 0 { return -1 }
  let eo = declOrigOf(e)
  if eo < 0 { eo = e }
  const stamp = monoArenaStamp()
  if stamp != monoBodyDeclStamp {
    monoBodyDeclStamp = stamp
    monoBodyDeclRow = Map()
    monoBodyDeclPos = []
    monoBodyDeclByOrig = []
  }
  let row = monoBodyDeclRow[body] ?? -1
  if row < 0 {
    row = monoBodyDeclPos.length
    monoBodyDeclRow[body] = row
    const pos: {[i32]: i32} = Map()
    const byOrig: {[i32]: i32} = Map()
    let n = 0
    const stack: i32[] = [body]
    while stack.length > 0 {
      const cur = stack.pop() ?? -1
      if cur >= 0 && cur < P.nodes.length {
        if nodeAt(cur) is LetDecl {
          pos[cur] = n
          n = n + 1
          const o = declOrigOf(cur)
          if o >= 0 && (byOrig[o] ?? -1) < 0 { byOrig[o] = cur }
        }
        for k in nodeChildren(cur) { stack.push(k) }
      }
    }
    monoBodyDeclPos.push(pos)
    monoBodyDeclByOrig.push(byOrig)
  }
  const pos = monoBodyDeclPos[row]
  let best = -1
  let bestAt = 0
  for c in [e, eo, monoBodyDeclByOrig[row][eo] ?? -1] {
    const at = pos[c] ?? -1
    if c >= 0 && at >= 0 && (best < 0 || at < bestAt) {
      best = c
      bestAt = at
    }
  }
  best
}

// Whether node `ix` is a read `d[0]` of the binding declared at `cd`, a copy of it included.
function monoReadsCell(ix: i32, cd: i32): boolean {
  if monoCellReadName(ix) == "" { return false }
  const r = nodeAt(ix)
  if !(r is Index) { return false }
  const e = identDeclOf(r.idxArr)
  e >= 0 && e < P.nodes.length && monoDeclCanon(e) == monoDeclCanon(cd)
}

// The cell a read `cell[0]` at node `ix` names, or "" for any other node.
function monoCellReadName(ix: i32): string {
  if ix < 0 || ix >= P.nodes.length { return "" }
  const n = nodeAt(ix)
  if n is Index {
    const a = nodeAt(n.idxArr)
    const k = nodeAt(n.idxIndex)
    if a is Ident && k is NumLit {
      if k.numText == "0" { return a.identName }
    }
  }
  ""
}

// The function type the capture cell read `at` (`cell[0]`) is called at in frame `ctx`: the one
// signature the flow table pins the cell's element at; "" for none or two. Pushes the pin's
// parameter types onto `tys` as `monoSlotPinNameTys` does.
function monoCellPinNameTys(at: i32, ctx: i32, tys: i32[], ft: i32[]): string {
  if !monoIsCellRead(at) { return "" }
  const r = nodeAt(at)
  if !(r is Index) { return "" }
  const cp: string[] = ["e"]
  monoSlotPinNameTys(identDeclOf(r.idxArr), cp, ctx, tys, ft)
}

// The cell half of `monoWalk` for call `n` at `ix` in frame `ctx` through the capture cell
// read at node `at` in frame `cctx` (the call's own callee, or the read an alias of it is
// initialized with): -1 on a refusal, 1 when the call is settled, 0 to walk on.
function monoCellCall(
  n: Call,
  ix: i32,
  at: i32,
  cctx: i32,
  ctx: i32,
  viaAlias: boolean,
): i32 {
  // A call in a function nothing names never runs, so it asks nothing of the cell (D3864).
  const cellFr = monoReadLetFrame(at, cctx)[0]
  const live = cellFr < 0 || !monoWriteFrameDead(ctx, cellFr)
  const cfe = monoCellLamFe(at, cctx)
  if !viaAlias && cfe >= 0 && cfe < monoGen.length && monoGen[cfe] == 1 {
    monoLastInstFe = -1
    const rc = monoInstantiate(cfe, ix, ctx)
    if monoSlotIsFn(monoLastInstFe) { monoNoteBindSig(at, cctx) }
    if rc < 0 { return -1 }
    return 1
  }
  // A cell seeded with a named generic is called at the instance this call's arguments take
  // of the seed, since retyping the cell rewrites the callee's recorded type (D3939, D3957).
  let ctnOk = false
  let ctnTys: i32[] = []
  let ctnTy = -1
  const sfe = monoCellSeedGenFe(at, cctx)
  // An alias is a value the cell's writes may have replaced, so its call is never renamed.
  if viaAlias { monoNoRename.push(n.callFn) }
  if sfe >= 0 {
    monoLastInstFe = -1
    if monoWritesCoercedFirstCall("c:", at, cctx) {
      monoWriteCoercedCall = n.callFn
    }
    const sr = monoInstantiate(sfe, ix, ctx)
    monoWriteCoercedCall = -1
    if sr < 0 { return -1 }
    ctnOk = monoSlotIsFn(monoLastInstFe)
    ctnTys = monoInstParamPinTys(monoLastInstFe)
    // The cell takes the instance's type: its recorded one, else its pins and elaborated result.
    const ifd = fnStmts[monoLastInstFe]
    ctnTy = nodeTyIxOf(ifd)
    const fd = nodeAt(ifd)
    if (
      (ctnTy < 0 || !(tyAt(ctnTy) is TyFunc))
      && fd is FuncDecl
      && fd.fnParams.length == ctnTys.length
    ) {
      const r = elabRetOf(elabKeyAt(ifd))
      ctnTy = if r >= 0 { mkFuncTy(ctnTys, r) } else { -1 }
    }
  }
  if ctnOk && (live || sfe >= 0) {
    monoCoerceWrittenCell(at, cctx, ctnTys, ctnTy)
  }
  // The cell's call reaches it by name, which the coercion above retyped; one reaching no name
  // has no binding to note the signature on.
  if (
    ctnOk
    && sfe >= 0
    && at >= 0
    && monoIdentNameOf(at) == ""
    && monoCellReadName(at) == ""
  ) {
    emitFail(
      "emitProgram: monomorphize: a seeded cell's call reaches no binding to note its signature on",
    )
    return -1
  }
  0
}

// The callee of the call `monoWalk` is instancing through a written `let` whose writes it then
// instances at the same signature, so that instance need not be the generic's first; -1 for none.
let monoWriteCoercedCall = -1

// Whether the `let` (`key` `n:`) or capture cell (`c:`) read at `at` in frame `ctx` is written
// and no call has gone through it yet (`monoBindCalled`): its writes then take this call's.
function monoWritesCoercedFirstCall(key: string, at: i32, ctx: i32): boolean {
  const lf = monoReadLetFrame(at, ctx)
  if lf[1] < 0 || monoWritesOf(key, lf[1]).length == 0 { return false }
  // A write of another binding of the name does not make this one written (D4016).
  if key == "n:" && !monoLetWrittenIn(lf) { return false }
  !(monoBindCalled.get(lf[1]) ?? false)
}

// The longest alias chain a walk here follows before refusing, as long as the flow table's.
const MONO_ALIAS_CHAIN_MAX = 64

// The hole lambda the value at node `vx`, read in frame `fx`, is: a lambda literal, or a name
// bound through un-annotated `const` and `let` bindings to one. -1 for anything else.
function monoLamValueFe(vx: i32, fx: i32): i32 {
  const v = nodeAt(vx)
  if v is FuncDecl {
    const ls = fnStmtsPosOf(vx)
    if ls >= 0 && criFnIsAnonLambda(ls) { return ls }
    return -1
  }
  let nm = monoIdentNameOf(vx)
  let ax = vx
  // A read through the rewrite's capture cell, `d[0]`, is a read of `d` (D3850).
  if nm == "" { nm = monoCellReadName(vx) }
  let fr = fx
  let hops = 0
  while nm != "" && hops < MONO_ALIAS_CHAIN_MAX {
    const sfe = identClosureFeOfRead(monoCellReadIdent(ax), fr)
    if sfe >= 0 {
      if criFnIsAnonLambda(sfe) { return sfe }
      return -1
    }
    const lf = monoReadLetFrame(ax, fr)
    if lf[1] < 0 { return -1 }
    const d = nodeAt(lf[1])
    if !(d is LetDecl) { return -1 }
    if d.letType >= 0 || d.letInit < 0 { return -1 }
    const il = monoNestedBodyOf(d.letInit)
    if il >= 0 {
      const ls = fnStmtsPosOf(d.letInit)
      if ls >= 0 && criFnIsAnonLambda(ls) { return ls }
      return -1
    }
    // The rewrite's cell `let d = [v]` holds `v`.
    let init = d.letInit
    const cellEl = monoGeneratedCellElem(init)
    if cellEl >= 0 { init = cellEl }
    nm = monoIdentNameOf(init)
    if nm == "" { nm = monoCellReadName(init) }
    ax = init
    fr = lf[0]
    hops = hops + 1
  }
  -1
}

// The name node `ix` reads: itself, or a capture cell read's (`d[0]`) cell binding, whose
// declaration the checker recorded on that read (`monoIsCellRead`).
function monoCellReadIdent(ix: i32): i32 {
  const n = nodeAt(ix)
  if n is Index { return n.idxArr }
  ix
}

// The one element of the capture cell the rewrite builds (`[v]`, no source position) at node
// `ix`, or -1 for any other node.
function monoGeneratedCellElem(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const lit = nodeAt(ix)
  if lit is ArrayLit {
    if lit.pos < 0 && lit.arrElems.length == 1 { return lit.arrElems[0] }
  }
  -1
}

// The innermost function node among `root` and the functions lifted out of it whose body holds
// node `ix`; `root` itself when none of them does.
function monoFrameOfNode(ix: i32, root: i32): i32 {
  let best = root
  for k in monoLiftedDescendants(fnStmtsPosOf(root)) {
    const kb = monoNestedBodyOf(fnStmts[k])
    if kb >= 0 && monoSubtreeHolds(kb, ix) { best = fnStmts[k] }
  }
  best
}

// The module-scope function statement holding each node (`monoProgTopOf`), banked on the arena
// stamp and the statement count: one walk answers every query between two edits (D4942).
let monoProgTop: i32[] = []
let monoProgHeldStamp = 0 - 1
// Whether that walk marked a node more than `MONO_PROG_DEPTH` below its statement.
let monoProgTopDeep = false
const MONO_PROG_DEPTH = 400

// Per node: the first module-scope function statement whose subtree holds it, -1 when only
// another statement does, -2 when none does; rebuilt when the arena stamp moves.
function monoProgTopOf(ix: i32): i32 {
  const stamp = monoArenaStamp() + monoProgStmts.length
  if stamp != monoProgHeldStamp {
    const top: i32[] = __array_new__(P.nodes.length, -2)
    let deep = false
    for st in monoProgStmts {
      if nodeAt(st) is FuncDecl {
        if monoProgTopMark(top, st, st) { deep = true }
      }
    }
    for st in monoProgStmts {
      if monoProgTopMark(top, st, -1) { deep = true }
    }
    monoProgTop = top
    monoProgTopDeep = deep
    monoProgHeldStamp = stamp
  }
  if ix < 0 || ix >= monoProgTop.length { return -2 }
  monoProgTop[ix]
}

// Marks every node `root`'s subtree reaches, entering function bodies (a function's body is
// its last child), that no earlier walk marked, as held by `owner`; whether one it marked lies
// more than `MONO_PROG_DEPTH` below `root`.
function monoProgTopMark(top: i32[], root: i32, owner: i32): boolean {
  const stack: i32[] = [root]
  const depths: i32[] = [0]
  let deep = false
  while stack.length > 0 {
    const cur = stack.pop() ?? -1
    const d = depths.pop() ?? 0
    if cur >= 0 && cur < top.length && top[cur] == -2 {
      top[cur] = owner
      if d > MONO_PROG_DEPTH { deep = true }
      let k = nodeChildrenPush(cur, stack)
      while k > 0 {
        depths.push(d + 1)
        k = k - 1
      }
    }
  }
  deep
}

// Whether node `ix` lies in the program, entering function bodies (`monoSubtreeHolds` over every
// statement of `monoProgStmts`).
function monoProgHolds(ix: i32): boolean { monoProgTopOf(ix) != -2 }

// Whether node `ix` lies in the subtree at `root`, entering function bodies (a function's body
// is its last child).
function monoSubtreeHolds(root: i32, ix: i32): boolean {
  const stack: i32[] = [root]
  while stack.length > 0 {
    const cur = stack.pop() ?? -1
    if cur == ix { return true }
    if cur >= 0 && cur < P.nodes.length { nodeChildrenPush(cur, stack) }
  }
  false
}

// The program's assignments, as node indices, by the declaration (`monoDeclCanon`) they write:
// `x = v`, a cell's `d[0] = v`, a field's `d.f = v`, an element's `d[k] = v`. Banked on an arena
// prefix, so an instance body cloned during the pass, whose targets read the template's
// declaration, joins the next time it is asked.
let monoDeclWrites: {[i32]: i32[]} = Map()
let monoCellWrites: {[i32]: i32[]} = Map()
let monoFieldWrites: {[i32]: i32[]} = Map()
let monoElemWrites: {[i32]: i32[]} = Map()
// The values stored into an un-annotated `const` list literal, by the declaration
// (`monoDeclCanon`) holding the literal: `.push` arguments and `d[k] = v` values.
let monoListStores: {[i32]: i32[]} = Map()
let monoLetWritesSeen = 0
// Every declaration written, in the order of its first write: `d` for `monoDeclWrites`, `-1 - d`
// for `monoCellWrites`.
let monoWriteOrder: i32[] = []

// Indexes the assignments the arena gained since the last call. A target that resolved to no
// declaration is not indexed.
function monoLetWritesExtend() {
  let i = monoLetWritesSeen
  while i < P.nodes.length {
    const wn = nodeAt(i)
    if wn is BinExpr {
      if wn.binOp == "=" {
        const tg = nodeAt(wn.binLeft)
        if tg is Ident {
          const d = identDeclOf(wn.binLeft)
          if d >= 0 && d < P.nodes.length {
            const k = monoDeclCanon(d)
            if !monoDeclWrites.has(k) { monoWriteOrder.push(k) }
            const wl = monoDeclWrites.get(k) ?? []
            wl.push(i)
            monoDeclWrites.set(k, wl)
          }
        } else if monoCellReadName(wn.binLeft) != "" && tg is Index {
          const d = identDeclOf(tg.idxArr)
          if d >= 0 && d < P.nodes.length {
            const k = monoDeclCanon(d)
            if !monoCellWrites.has(k) { monoWriteOrder.push(0 - 1 - k) }
            const wl = monoCellWrites.get(k) ?? []
            wl.push(i)
            monoCellWrites.set(k, wl)
          }
        } else if tg is Member && nodeAt(tg.memObj) is Ident {
          const d = identDeclOf(tg.memObj)
          if d >= 0 && d < P.nodes.length {
            const k = monoDeclCanon(d)
            const wl = monoFieldWrites.get(k) ?? []
            wl.push(i)
            monoFieldWrites.set(k, wl)
          }
        }
        monoElemWriteNote(wn.binLeft, i)
        if tg is Index { monoListStoreNote(tg.idxArr, wn.binRight) }
      }
    } else if wn is Call && wn.callFn >= 0 {
      const cf = nodeAt(wn.callFn)
      if cf is Member && cf.memProp == "push" {
        for a in wn.callArgs { monoListStoreNote(cf.memObj, a) }
      }
    }
    i = i + 1
  }
  monoLetWritesSeen = P.nodes.length
  0
}

// Banks value `v` stored into list `recv` in `monoListStores` when `recv` names, through
// un-annotated `const` aliases, the `const` a list literal initializes.
function monoListStoreNote(recv: i32, v: i32) {
  const b = monoConstListBase(recv)
  if b < 0 { return 0 }
  const k = monoDeclCanon(b)
  const wl = monoListStores.get(k) ?? []
  wl.push(v)
  monoListStores.set(k, wl)
  0
}

// The un-annotated `const` holding the list literal `v` names through further such `const`s, or
// -1 when `v` names none.
function monoConstListBase(v: i32): i32 {
  let lx = unwrapParen(v)
  let hops = 0
  let d = -1
  while lx >= 0 && lx < P.nodes.length && nodeAt(lx) is Ident && hops < 16 {
    d = identDeclOf(lx)
    if d < 0 || d >= P.nodes.length { return -1 }
    const dn = nodeAt(d)
    if !(dn is LetDecl) || dn.letKw != "const" || dn.letType >= 0 { return -1 }
    lx = unwrapParen(dn.letInit)
    hops = hops + 1
  }
  if lx < 0 || lx >= P.nodes.length || !(nodeAt(lx) is ArrayLit) { return -1 }
  d
}

// Banks write `i` to target `lhs` in `monoElemWrites` when `lhs` is `d[k]`: `d[0] = v` counts
// too, since `d` may be a list literal and not a capture cell.
function monoElemWriteNote(lhs: i32, i: i32) {
  const tg = nodeAt(lhs)
  if !(tg is Index) || !(nodeAt(tg.idxArr) is Ident) { return 0 }
  const d = identDeclOf(tg.idxArr)
  if d < 0 || d >= P.nodes.length { return 0 }
  const k = monoDeclCanon(d)
  const wl = monoElemWrites.get(k) ?? []
  wl.push(i)
  monoElemWrites.set(k, wl)
  0
}

// The writes `monoWriteOrder` entry `k` names.
function monoWriteListAt(k: i32): i32[] {
  const none: i32[] = []
  if k < 0 { return monoCellWrites.get(0 - 1 - k) ?? none }
  monoDeclWrites.get(k) ?? none
}

// The writes of the binding declared at `d` (`key` `n:`), of its capture cell (`c:`), of its
// fields (`f:`), or of its elements (`e:`).
function monoWritesOf(key: string, d: i32): i32[] {
  monoLetWritesExtend()
  const none: i32[] = []
  if d < 0 || d >= P.nodes.length { return none }
  if key == "c:" { return monoCellWrites.get(monoDeclCanon(d)) ?? none }
  if key == "f:" { return monoFieldWrites.get(monoDeclCanon(d)) ?? none }
  if key == "e:" { return monoElemWrites.get(monoDeclCanon(d)) ?? none }
  monoDeclWrites.get(monoDeclCanon(d)) ?? none
}

// The lambda a call through callee `calleeIx` reaches, where the flow table says its chain of
// un-annotated `const` aliases ends at a lambda's un-annotated `const` binding
// (`lamRespellOf`), possibly in an enclosing frame (D3825); -1 for none. A non-capturing
// lambda's call is pointed at the lambda's own function, which no binding can shadow.
function monoRespellLamFe(calleeIx: i32, ctx: i32): i32 {
  const cal = nodeAt(calleeIx)
  if !(cal is Ident) { return -1 }
  if identClosureFeOfRead(calleeIx, ctx) >= 0 { return -1 }
  const sf = monoDeclFrameIn(lamRespellOf(calleeIx), ctx)
  if sf[1] < 0 { return -1 }
  const sd = nodeAt(sf[1])
  if !(sd is LetDecl) || sd.letInit < 0 { return -1 }
  const fe = fieldValueFeOfIn(sd.letInit, sf[0])
  if fe < 0 || !criFnIsAnonLambda(fe) { return -1 }
  if captureCountOf(fe) > 0 { return fe }
  const name = monoSlotName(fe)
  if name == "" || name == cal.identName { return fe }
  cal.identName = name
  monoNoteRenamed(calleeIx, fe)
  sidNoteNodeName(calleeIx, fnStmts[fe])
  fe
}

// Instances each element of list literal `ix` (elements `es`, frame `ctx`) that names a generic
// function at the literal's element type, when a non-generic sibling closed it (D10790).
function monoCoerceListLitElems(ix: i32, es: i32[], ctx: i32): i32 {
  const lt = nodeTyIxOf(ix)
  if lt < 0 || lt >= T.tys.length { return 0 }
  const l = tyAt(lt)
  if !(l is TyArray) { return 0 }
  // An open record or list literal element beside a closed one holding a function is built at
  // the element type the checker joined them into (D15331).
  const et = l.aElem
  if (
    et >= 0
    && et < T.tys.length
    && !monoTyOpen(et)
    && !(tyAt(et) is TyFunc)
    && tyMayHoldFn(et, 0)
  ) {
    for e in es {
      const en = nodeAt(unwrapParen(e))
      if (
        (en is ObjLit || en is ArrayLit)
        && monoElabDeliver(e, et, ctx, false, false)
      ) {
        monoElabDeliver(e, et, ctx, false, true)
      }
    }
    return 0
  }
  if !monoTyConcreteFn(l.aElem) { return 0 }
  // A literal of generics alone is closed by the functions its binding's writes add.
  let closed = elabFnListClosedLit(ix)
  for e in es {
    if !monoNamesDeclaredGeneric(e, ctx) { closed = true }
  }
  if !closed { return 0 }
  const nm = monoConcreteFnTyName(l.aElem)
  if nm == "" { return 0 }
  for e in es {
    if monoNamesDeclaredGeneric(e, ctx) {
      if monoCoerceFnValueName(e, ctx, l.aElem) < 0 { return -1 }
    }
  }
  0
}

// Instances the generic functions the arms of `if` value `n` (node `ix`, frame `ctx`) name at
// the `if`'s function type, when a non-generic arm closed it (D10790).
function monoCoerceIfArms(n: IfStmt, ix: i32, ctx: i32): i32 {
  // Inside an instance the join is its own instance's: a hole parameter's arm is open in the
  // template and the instance's type of the value is closed (D15462).
  const t0 = nodeTyIxOf(ix)
  if n.ifElse < 0 { return 0 }
  const tv = ifArmValueExpr(n.ifThen)
  const ev = ifArmValueExpr(n.ifElse)
  // A record or list literal arm the checker left open beside the closed join is built at the
  // join's type (D15331).
  if (
    tv >= 0
    && ev >= 0
    && t0 >= 0
    && t0 < T.tys.length
    && !monoTyOpen(t0)
    && !(tyAt(t0) is TyFunc)
    && tyMayHoldFn(t0, 0)
  ) {
    for a in [tv, ev] {
      const an = nodeAt(unwrapParen(a))
      if (
        (an is ObjLit || an is ArrayLit)
        && monoElabDeliver(a, t0, ctx, false, false)
      ) {
        monoElabDeliver(a, t0, ctx, false, true)
      }
    }
    return 0
  }
  const t = if monoTyConcreteFn(t0) { t0 } else { elabWalkTy(ix) }
  if !monoTyConcreteFn(t) { return 0 }
  if monoNamesDeclaredGeneric(tv, ctx) == monoNamesDeclaredGeneric(ev, ctx) {
    return 0
  }
  const nm = monoConcreteFnTyName(t)
  if nm == "" { return 0 }
  if monoCoerceFnValueName(ix, ctx, t) < 0 { return -1 }
  0
}

// Walk the statement/expression tree at `ix` (inside function `ctx`, -1 = top level) and
// instantiate every direct call to a generic function. Arguments are walked before their
// call is classified, so an inner generic call's instance — and its now-concrete return
// kind — is in place when the outer call's argument types are read.
function monoWalk(ix: i32, ctx: i32) {
  if ix < 0 { return 0 }
  const n = nodeAt(ix)
  match n {
    Call => {
      if monoPinLitFieldCall(n, ctx) < 0 { return -1 }
      // A call through a tagged function set is each member's direct call (`fnTagDecide`); a
      // call an instance makes through its parameter is noted only as that instance's fact.
      let tagArms = fnTagCallArms(ix)
      if tagArms.length == 0 {
        const ms = mintCallSoleSet(ix)
        if fnTagSetIsTagged(ms) { tagArms = fnTagArmsAt(ix, ms) }
      }
      if tagArms.length > 0 {
        if monoWalk(n.callFn, ctx) < 0 { return -1 }
        for ta in tagArms {
          if monoWalk(ta, ctx) < 0 { return -1 }
        }
        return 0
      }
      const args = n.callArgs
      let i = 0
      while i < args.length {
        if monoWalk(args[i], ctx) < 0 { return -1 }
        i = i + 1
      }
      if monoNotePushDeliveries(n, ctx) < 0 { return -1 }
      let elemsTyped = 0
      const paramArgs = monoElemsParamArgs(n)
      if (
        monoGenArgAtOpenParam(n, ctx)
        || paramArgs > 0
        || monoForInlineGenElems(n.callFn, ctx)
      ) {
        elemsTyped = monoOpenCallAtElems(n, ix, ctx)
        if elemsTyped < 0 { return -1 }
      }
      if n.callFn < 0 { return 0 }
      const callee = nodeAt(n.callFn)
      // An `if` called in place asks the split as a binding of it does (D7848).
      const calleeIf = nodeAt(unwrapParen(n.callFn)) is IfStmt
      if (
        elemsTyped == 0
        && (callee is Index || calleeIf)
        && monoGenArgAtOpenParam(n, ctx)
      ) {
        return monoGenArgOpenFail(ix)
      }
      if callee is Ident {
        return monoWalkIdentCall(n, callee, ix, ctx, elemsTyped)
      }
      // A call of a list element that is an alias of a capture cell's read is a call through it.
      const le = monoListElemCellRead(n.callFn, ctx)
      if le[0] >= 0 {
        if monoCellCall(n, ix, le[0], le[1], ctx, true) < 0 { return -1 }
      }
      // A call through the capture cell of a `let` alias of a hole lambda (D3845).
      if monoCellReadName(n.callFn) != "" {
        const cr = monoCellCall(n, ix, n.callFn, ctx, ctx, false)
        if cr < 0 { return -1 }
        if cr == 1 { return 0 }
      }
      // An `if` callee its elements' calls already typed takes no seed instance (D7848).
      if elemsTyped == 0 && monoCallIfValue(n, ix, ctx) < 0 { return -1 }
      // A callback over a call's result reads it at the instance that call takes (D9550).
      const cbRecvCall = monoListCbRecvIsCall(n)
      if cbRecvCall && monoWalk(n.callFn, ctx) < 0 { return -1 }
      if monoCoerceListCbArg(n, ix, ctx) < 0 { return -1 }
      if monoCoerceAtValueParams(n, -1, ctx) < 0 { return -1 }
      if !cbRecvCall && monoWalk(n.callFn, ctx) < 0 { return -1 }
      monoTypeCallOfCall(ix, ctx)
      return 0
    }
    Block => {
      const bs = n.blkStmts
      let i2 = 0
      while i2 < bs.length {
        if monoWalk(bs[i2], ctx) < 0 { return -1 }
        i2 = i2 + 1
      }
      return 0
    }
    LetDecl => {
      return monoWalkLetDecl(n, ix, ctx)
    }
    IfStmt => {
      if monoWalk(n.ifCond, ctx) < 0 { return -1 }
      if monoWalk(n.ifThen, ctx) < 0 { return -1 }
      if monoWalk(n.ifElse, ctx) < 0 { return -1 }
      return monoCoerceIfArms(n, ix, ctx)
    }
    WhileStmt => {
      if monoWalk(n.whileCond, ctx) < 0 { return -1 }
      return monoWalk(n.whileBody, ctx)
    }
    ForRange => {
      if monoWalk(n.frFrom, ctx) < 0 { return -1 }
      if monoWalk(n.frTo, ctx) < 0 { return -1 }
      if monoWalk(n.frStep, ctx) < 0 { return -1 }
      return monoWalk(n.frBody, ctx)
    }
    ForIn => {
      if monoWalk(n.fiIter, ctx) < 0 { return -1 }
      return monoWalk(n.fiBody, ctx)
    }
    RetStmt => {
      // A generic function value RETURNED where the enclosing function declares a concrete function
      // return type (`function mk(): (f64,f64)=>f64 { return add }`): materialize the instance for
      // that return type so the returned value carries it.
      if ctx >= 0 {
        const cf = nodeAt(ctx)
        if cf is FuncDecl {
          const widen = monoRetWidenFns.get(ctx) ?? false
          if widen { monoInstanceWidenRet = true }
          const rc = monoCoerceFnValue(n.retArg, cf.fnRet, ctx)
          if widen { monoInstanceWidenRet = false }
          if rc < 0 { return -1 }
          if cf.fnRet < 0 && monoCoerceRetAtPin(n.retArg, ctx) < 0 { return -1 }
          if cf.fnRet < 0 {
            monoPinReturnedObj(n.retArg, ctx)
            if monoPinReturnedList(n.retArg, ctx) < 0 { return -1 }
          }
        }
      }
      return monoWalk(n.retArg, ctx)
    }
    BinExpr => {
      // Assignment to a function-typed binding (`let f: (i32,i32)=>i32 = mul; f = add`). The
      // declared type is the same boundary the `LetDecl` arm reads, so a generic reaching it
      // through a later `=` materializes identically. "" is a no-op.
      if n.binOp == "=" {
        const tgt = nodeAt(n.binLeft)
        if tgt is Ident {
          let atn = identFnTypeAnnNameOfRead(n.binLeft, ctx)
          // An un-annotated local's write delivers at the one signature the flow table pins the
          // binding at in this frame (D3957), a hole lambda literal written there included; one
          // written at two types is left to the binding's own two-signature refusal.
          let byPin = false
          const atTys: i32[] = []
          // The function type `atn` is spelled from.
          const atFt: i32[] = []
          const ast = elabStampAt(unwrapParen(n.binRight), ctx)
          if atn == "" && monoTyClosedFn(ast) {
            atn = monoConcreteFnTyName(ast)
            atFt.push(ast)
            byPin = true
          } else if atn == "" {
            atn = monoPlacePinNameTys(n.binLeft, "", ctx, atTys, atFt)
            byPin = true
          } else {
            for t in monoFnTyParamTys(nodeTyIxOf(n.binLeft)) { atTys.push(t) }
            atFt.push(monoPinSubTyOf(nodeTyIxOf(n.binLeft), ctx))
          }
          const att = if atFt.length == 1 { atFt[0] } else { -1 }
          if atn != "" {
            if monoCoerceFnValueTys(n.binRight, ctx, -1, atTys, att) < 0 {
              return -1
            }
            if byPin { monoLamLitTakeTys(n.binRight, ctx, [], att) }
            if !byPin && monoDeliverCallAt(n.binRight, atn, att) < 0 {
              return -1
            }
          }
          // A literal written whole delivers its functions at the binding's slots (D9670).
          const it = nodeTyIxOf(n.binLeft)
          if monoDeliverLitAtPlace(n.binRight, n.binLeft, "", it, ctx) < 0 {
            return -1
          }
        }
        // A store into an element or a field of a binding delivers at the one signature the flow
        // table pins that slot at in this frame (D3909), and a capture cell's store at the cell's
        // element pin, a value read through another cell included.
        if tgt is Index {
          const snTys: i32[] = []
          const snFt: i32[] = []
          let sn = ""
          if monoIsCellRead(n.binLeft) {
            sn = monoCellPinNameTys(n.binLeft, ctx, snTys, snFt)
          } else {
            sn = monoPlacePinNameTys(n.binLeft, "", ctx, snTys, snFt)
          }
          if sn == "" {
            sn = monoConcreteFnTyName(nodeTyIxOf(n.binLeft))
            if sn != "" {
              for t in monoFnTyParamTys(nodeTyIxOf(n.binLeft)) { snTys.push(t) }
              snFt.push(nodeTyIxOf(n.binLeft))
            }
          }
          const snt = if snFt.length == 1 { snFt[0] } else { -1 }
          // A function whose result there is not the element's is refused, not stored (D9093),
          // whether the element's own closed type or a pin names the signature (D15190).
          const ent = nodeTyIxOf(n.binLeft)
          const vt = if sn == "" || monoConcreteFnTyName(ent) == "" { -1 } else { monoValueAtAnnTy(n.binRight, snt) }
          if vt >= 0 && sigKeyOfTy(vt) != sigKeyOfTy(ent) {
            return emitFailAt(
              "emitProgram: the function written to this element returns another type than "
                + "the element's, at the arguments its calls pass — a list holds functions of "
                + "one type",
              ix,
            )
          }
          const wl = unwrapParen(n.binRight)
          if (
            monoIsCellRead(n.binLeft)
            && sn != ""
            && wl >= 0
            && nodeAt(wl) is FuncDecl
          ) {
            // A lambda written to a captured binding, like one written to a plain one, leaves a
            // second type to the binding's own refusal.
            if monoCoerceFnValueTys(n.binRight, ctx, -1, snTys, snt) < 0 {
              return -1
            }
            monoLamLitTakeTys(n.binRight, ctx, [], snt)
          } else if monoDeliverAtPinTys(n.binRight, sn, ctx, snTys, snt) < 0 {
            return -1
          }
          const lt = nodeTyIxOf(n.binLeft)
          if monoDeliverLitAtPlace(n.binRight, n.binLeft, "", lt, ctx) < 0 {
            return -1
          }
        }
        if tgt is Member {
          const snTys: i32[] = []
          const mst = elabStampAt(unwrapParen(n.binRight), ctx)
          const snFt: i32[] = []
          const sn = if monoTyClosedFn(mst) { monoConcreteFnTyName(mst) } else { monoPlacePinNameTys(n.binLeft, "", ctx, snTys, snFt) }
          if sn != "" {
            const sst = if monoTyClosedFn(mst) { mst } else { -1 }
            const snt = if sst >= 0 { sst } else if snFt.length == 1 { snFt[0] } else { -1 }
            if monoCoerceFnValueTys(n.binRight, ctx, sst, snTys, snt) < 0 {
              return -1
            }
          }
          const mt = nodeTyIxOf(n.binLeft)
          if monoDeliverLitAtPlace(n.binRight, n.binLeft, "", mt, ctx) < 0 {
            return -1
          }
        }
      }
      if monoWalk(n.binLeft, ctx) < 0 { return -1 }
      if monoWalk(n.binRight, ctx) < 0 { return -1 }
      // A `??` default is an arm of the join: a hole or generic function there is instanced at
      // the join's function type, as an `if` arm is (D15463).
      if n.binOp == "??" {
        const ct0 = nodeTyIxOf(ix)
        const ct = if monoTyConcreteFn(ct0) { ct0 } else { elabWalkTy(ix) }
        const cn = if monoTyConcreteFn(ct) { monoConcreteFnTyName(ct) } else { "" }
        if cn != "" && monoCoerceFnValueName(n.binRight, ctx, ct) < 0 {
          return -1
        }
      }
      return 0
    }
    Unary => {
      return monoWalk(n.unArg, ctx)
    }
    Paren => {
      return monoWalk(n.parInner, ctx)
    }
    Member => {
      return monoWalk(n.memObj, ctx)
    }
    OptMember => {
      return monoWalk(n.omObj, ctx)
    }
    Index => {
      if monoWalk(n.idxArr, ctx) < 0 { return -1 }
      return monoWalk(n.idxIndex, ctx)
    }
    IsExpr => {
      return monoWalk(isExprKid(n), ctx)
    }
    AsExpr => {
      return monoWalk(n.asObj, ctx)
    }
    // A spread's source is an operand like any other (D2334).
    Spread => {
      return monoWalk(n.spdArg, ctx)
    }
    ArrayLit => {
      const es = n.arrElems
      let i3 = 0
      while i3 < es.length {
        // An alias of a capture cell's read in a program's list is called through the list, which
        // the cell path does not follow, so it cannot be held to the cell's one signature.
        if (
          n.pos >= 0
          && ix != monoCellAliasListOk
          && monoListMayHoldFn(ix)
          && monoNamesCellAlias(es[i3], ctx)
        ) {
          return monoCellAliasListFail(es[i3])
        }
        if monoWalk(es[i3], ctx) < 0 { return -1 }
        i3 = i3 + 1
      }
      if monoCoerceListLitElems(ix, es, ctx) < 0 { return -1 }
      return 0
    }
    ObjLit => {
      const fs = n.objFields
      let i4 = 0
      while i4 < fs.length {
        const f = nodeAt(fs[i4])
        if f is FieldInit {
          if monoWalk(f.fiValue, ctx) < 0 { return -1 }
        }
        i4 = i4 + 1
      }
      return 0
    }
    // A nested `FuncDecl`'s body is walked through its own `fnStmts` slot (lambda-lifted);
    // every other node kind has no call-bearing children. `MatchExpr` never
    // reaches here: the checker lowers every exhaustive `match` to an if/else chain and
    // overwrites the arena slot in place, so by emit time its arms sit in `IfStmt` limbs.
    NumLit | StrLit | CharLit | BoolLit | NullLit | Ident | ErrExpr | Param | TypeRef | FuncDecl | BreakStmt | ContinueStmt | Program | FieldDef | TypeDecl | FieldInit | UnionDecl | MatchExpr | ImportDecl | LoopVar => {}
  }
  0
}

// `monoWalk`'s arm for the binding `n` at node `ix` in frame `ctx`.
function monoWalkLetDecl(n: LetDecl, ix: i32, ctx: i32): i32 {
  // A list holding an alias of a capture cell's read is followed only where every read of it
  // is a call of one element (`fs[0](…)`), which is taken through the cell.
  if monoListInitHoldsCellAlias(n.letInit, ctx) {
    if (
      n.letKw != "const"
      || !monoListOnlyCalled(ctx, n.letName, ix, monoListLitLength(n.letInit))
    ) {
      return monoCellAliasListFail(n.letInit)
    }
    monoCellAliasListOk = n.letInit
  }
  // An un-annotated list of function values takes the one type the calls through its elements
  // give it, as an annotation would (D3977).
  if n.letType < 0 {
    if monoPinListElems(n, ix, ctx) < 0 { return -1 }
  }
  if n.letType < 0 && n.letInit >= 0 && nodeAt(n.letInit) is ObjLit {
    if n.letKw == "const" {
      if monoPinRecordFields(n, ix, ctx) < 0 { return -1 }
    }
    if monoPinFieldContainers(n, ix, ctx) < 0 { return -1 }
  }
  // So does an un-annotated map of function values (D4579).
  if n.letType < 0 {
    if monoPinMapValues(n, ix, ctx) < 0 { return -1 }
  }
  // An annotated function-typed binding to a generic named function: materialize the
  // instance for the annotation's param types and point the binding at it, so the value
  // carries that concrete type independent of any call — it may escape where call-driven
  // monomorphization cannot reach.
  if monoCoerceFnValue(n.letInit, n.letType, ctx) < 0 { return -1 }
  if monoNoteBindDelivery(n.letInit, n.letType, ctx, -1) < 0 { return -1 }
  if monoWalk(n.letInit, ctx) < 0 { return -1 }
  monoCloseListCbBindReads(n, ix, ctx)
  // A field a call initialises reads at the instance the walk just gave that call (D9714).
  if monoObjLitOpenCallField(n) {
    if monoPinFieldContainers(n, ix, ctx) < 0 { return -1 }
  }
  0
}

// Types each open read of the un-annotated `let` `n` (node `at`) at its initialiser's type, where
// that is a `.map` the walk just closed over a list of hole functions (D9766).
function monoCloseListCbBindReads(n: LetDecl, at: i32, ctx: i32) {
  if n.letType >= 0 || n.letInit < 0 { return 0 }
  if ctx >= 0 && monoFrameIsGenericInstance(ctx) { return 0 }
  const x = unwrapParen(n.letInit)
  if x < 0 || x >= P.nodes.length { return 0 }
  const c = nodeAt(x)
  if !(c is Call) || c.callFn < 0 { return 0 }
  const m = nodeAt(c.callFn)
  if !(m is Member) || m.memProp != "map" { return 0 }
  const t = nodeTyIxOf(x)
  if t < 0 || monoTyOpen(t) { return 0 }
  if monoTyOpen(nodeTyIxOf(at)) { nodeTyRecord(at, t) }
  for ix in monoFrameNodes(ctx) {
    if monoTyOpen(nodeTyIxOf(ix)) && monoReadsBinding(ix, n.letName, ctx, at) {
      nodeTyRecord(ix, t)
    }
  }
  0
}

// Whether the un-annotated `let` `n` is initialised by a record literal still open at a field a
// call initialises.
function monoObjLitOpenCallField(n: LetDecl): boolean {
  if n.letType >= 0 || n.letInit < 0 { return false }
  const lit = nodeAt(n.letInit)
  if !(lit is ObjLit) || !monoTyOpen(nodeTyIxOf(n.letInit)) { return false }
  for fi in lit.objFields {
    const f = nodeAt(fi)
    if f is FieldInit {
      const vx = unwrapParen(f.fiValue)
      if vx >= 0 && nodeAt(vx) is Call { return true }
    }
  }
  false
}

// The template slot of the lambda a dispatch arm's nameless callee `cf` is bound to, or -1.
function monoArmLamFe(cf: i32, callee: Ident): i32 {
  if callee.identName != "" { return -1 }
  const d = identDeclOf(cf)
  if d < 0 || d >= P.nodes.length || !(nodeAt(d) is FuncDecl) { return -1 }
  fnStmtsPosOf(d)
}

// `monoWalk`'s arm for a call `n` (node `ix`, in frame `ctx`) whose callee is the identifier
// `callee`, its arguments already walked: coerces generic values at concrete parameters, then
// instantiates the generic it resolves to, through any alias, or specializes a concrete one;
// `elemsTyped` is 1 when the callee's elements already took the call's type.
function monoWalkIdentCall(
  n: Call,
  callee: Ident,
  ix: i32,
  ctx: i32,
  elemsTyped: i32,
) {
  // A generic function value passed as an argument to a concrete function-typed
  // parameter: materialize the instance for that declared function type. Only where
  // the declaration is concrete — the rest is deferred to `monoInstantiate`.
  const dfe = monoFnFeOfIdent(n.callFn, callee.identName, ctx)
  const pargs = monoArgsInParamOrder(ix, monoFnDeclNodeAt(dfe))
  let ca = 0
  while ca < pargs.length {
    const pty = monoFnParamTypeAt(dfe, ca)
    if pty >= 0 {
      if !monoFnParamAnnRidesTyParam(dfe, ca) {
        if monoCoerceFnValue(pargs[ca], pty, ctx) < 0 { return -1 }
        if monoNoteBindDelivery(pargs[ca], pty, ctx, ix) < 0 { return -1 }
      }
    }
    ca = ca + 1
  }
  if monoCoerceAtValueParams(n, dfe, ctx) < 0 { return -1 }
  // An alias of a `let` calls the lambda that `let` is seeded with, as the binding itself does.
  if (
    dfe < 0
    && elemsTyped == 0
    && monoGenArgAtOpenParam(n, ctx)
    && monoAliasLetLamFe(ix, ctx) < 0
    && monoArmLamFe(n.callFn, callee) < 0
  ) {
    return monoGenArgOpenFail(ix)
  }
  // A call through a written, un-annotated `let` holding generic functions instances each one
  // written at the call's type, which one binding holds one of (D3979).
  if monoCallWrittenLet(ix, ctx) < 0 { return -1 }
  if monoCallIfBound(ix, ctx) < 0 { return -1 }
  // A call through an alias of a capture cell's read is a call through that cell (D3948).
  if dfe < 0 {
    const ar = monoAliasCellRead(n.callFn, ctx)
    if ar[0] >= 0 {
      if monoCellCall(n, ix, ar[0], ar[1], ctx, true) < 0 { return -1 }
    }
  }
  // Scope-aware and positioned, as `wasmEmit` resolves this call: the flat `fnIndexOf`
  // would hand a nested `<T>` template to the prune while the emitter calls it, and a
  // binding in scope at the call must shadow a namesake nested in another frame (D2759).
  let fe = fnIndexOfInScopeAt(
    sidOfNode(n.callFn),
    callee.identName,
    ctx,
    n.callFn,
  )
  const direct = fe >= 0
  let armLam = false
  let wlName = callee.identName
  let wlAt = n.callFn
  let wlFr = ctx
  if fe < 0 {
    // A dispatch arm calls its member by declaration: a lambda's arm names no function, so
    // it takes the lambda's own template slot and is instantiated per call as a name is.
    let afe = monoArmLamFe(n.callFn, callee)
    if afe >= 0 && !i32ListHas(monoLamCallCallees, n.callFn) {
      monoLamCallCallees.push(n.callFn)
    }
    // Its instance is answered by the row per frame, so the arm node every instance shares is
    // never renamed.
    if afe >= 0 {
      armLam = true
      monoNoRename.push(n.callFn)
    }
    // A call through a `const` alias of a lambda's `const` binding calls that lambda, and is
    // instantiated per call alike (D2896).
    if afe < 0 { afe = monoRespellLamFe(n.callFn, ctx) }
    // A direct call through a value binding to a generic named function: resolve it
    // to the lifted slot and monomorphize per call site. Named functions only, and
    // re-read rather than reused from `dfe`, the coercion loop between having run.
    if afe < 0 { afe = identClosureFeOfRead(n.callFn, ctx) }
    // An alias renamed to one frame instance of a generic still calls the generic: each
    // call through it takes its own instance (D3887).
    if afe >= 0 && afe < fnInstOrigin.length && fnInstOrigin[afe] >= 0 {
      const ao = fnInstOrigin[afe]
      if ao < monoGen.length && monoGen[ao] == 1 { afe = ao }
    }
    // The initializer's lambda, which a reassigned binding need not hold at this call: the
    // call keeps its `call_ref` and only the lambda is pinned (D3849, D3858).
    if afe >= 0 && monoReadIsAssigned(callee.identName, n.callFn) {
      monoNoRename.push(n.callFn)
    }
    if afe < 0 { afe = monoCapturedLamFe(n.callFn, ctx) }
    // A chain of aliases ending at a generic function by name is a call to it (D3894).
    if afe < 0 { afe = monoReadGenFnFe(n.callFn) }
    if afe < 0 {
      afe = monoAliasLamFe(n.callFn, ctx, false)
      // The call would be re-spelled to the lambda's own name, which a parameter or local
      // here may rebind: it keeps its `call_ref` through the alias then (D3861).
      if afe >= 0 && monoNameShadowedAt(monoSlotName(afe), n.callFn, ctx) {
        monoNoRename.push(n.callFn)
      }
      // A `const`-only chain is re-spelled above unless that name is rebound here; then
      // the lambda is pinned through the chain and the call keeps its `call_ref` (D3861).
      if afe < 0 {
        const cfe = monoAliasLamFe(n.callFn, ctx, true)
        if cfe >= 0 {
          afe = cfe
          monoNoRename.push(n.callFn)
        }
      }
      // The chain names the lambda it is initialized with. Where a link is written, that
      // need not be the value the alias holds at this call, so the call keeps its
      // `call_ref` and only the lambda is pinned (D3849); an unwritten chain always holds it.
      if afe >= 0 && cboxReadWritten(n.callFn) { monoNoRename.push(n.callFn) }
    }
    // An alias of a `let` calls what the `let` holds: an unwritten one its hole lambda, and a
    // written one the value last written to it, so the seed is pinned at this call, which
    // keeps its `call_ref`, and the writes take that signature (D3961).
    if afe < 0 {
      const wl = monoAliasLetEnd(n.callFn, ctx)
      if wl[0] >= 0 {
        afe = identClosureFeOfRead(wl[0], wl[1])
        if afe >= 0 && afe < fnInstOrigin.length && fnInstOrigin[afe] >= 0 {
          afe = fnInstOrigin[afe]
        }
        if afe >= 0 && wl[2] == 1 {
          monoNoRename.push(n.callFn)
          wlName = monoIdentNameOf(wl[0])
          wlAt = wl[0]
          wlFr = wl[1]
        }
      }
    }
    if afe >= 0 {
      if !criFnIsAnonLambda(afe) {
        // The fold below rewrites `f(x)` into a by-name call to the initializer's
        // instance, faithful only while the binding still holds it — hence the
        // restriction to an annotated binding, whose `$fnsig` the `call_ref` needs.
        if identFnTypeAnnNameOfRead(n.callFn, ctx) == "" { fe = afe }
        else if !monoReadIsAssigned(callee.identName, n.callFn) { fe = afe }
      } else if identFnTypeAnnNameOfRead(n.callFn, ctx) == "" {
        // A lambda bound to an un-annotated `const`: its params are inference holes,
        // so monomorphize it per call exactly like a named generic function. An
        // annotated binding is contextually pinned and excluded.
        fe = afe
      }
    }
  }
  if fe >= 0 && fe < monoGen.length {
    if monoGen[fe] == 1 {
      monoLastInstFe = -1
      if !direct && monoWritesCoercedFirstCall("n:", wlAt, wlFr) {
        monoWriteCoercedCall = n.callFn
      }
      // The row answers a lambda arm's instance per frame, keyed by the arm's callee read: two
      // calls of one lambda at one signature can take different instances (a callback baked in).
      if armLam {
        monoArmCall = ix
        monoArmCtx = ctx
      }
      const ri = monoInstantiate(fe, ix, ctx)
      monoWriteCoercedCall = -1
      monoArmCall = -1
      if monoSlotIsFn(monoLastInstFe) { monoNoteBindSig(n.callFn, ctx) }
      // The call keeps its `call_ref` through a written `let`, so each generic written to it
      // takes the signature the elaboration instanced it at through this call (D3961).
      if ri >= 0 && !direct && monoLastInstFe >= 0 {
        monoCellSigByCall = true
        monoCoerceWrittenLetTys(wlAt, wlFr, [], -1, [ix, ctx])
        monoCellSigByCall = false
      }
      return ri
    }
    // A maker call whose binding calls the result at one closed signature is the maker's
    // instance at that result; a result the tag decision tags stays the set's id.
    if (
      monoIsMakerFe(fe)
      && ix >= 0
      && ix < P.nodes.length
      && !fnTagTyIsTagged(nodeTyIxOf(ix))
      && !fnTagRetIsTagged(monoOrigNode[fe])
    ) {
      const ms = elabMakerCallSig(ix)
      const mc = nodeAt(ix)
      // A call in an instanced body is one node for every instance; it keeps its path.
      const shared = ctx >= 0 && monoCadInstOf(ctx) >= 0
      if (
        ms >= 0
        && mc is Call
        && !shared
        && elabMakerTwinHeld(monoOrigNode[fe], ms)
        && elabMakerOpen(monoOrigNode[fe])
      ) {
        if monoMakerTwin(fe, mc.callFn, ms, [], ctx) < 0 { return -1 }
        nodeTyRecord(ix, ms)
        return 0
      }
    }
    // A CONCRETE callee: specialize it per non-capturing callback (no-op if none) — the
    // concrete analogue of `monoInstantiate`'s callback baking.
    return monoSpecializeConcrete(ix, fe, ctx)
  }
  return 0
}

// Walk function `fnIx`'s own body, coercing its implicit return first. A bare-expression
// body parses to a synthetic one-statement `Block` with no `RetStmt`, so `monoWalk`'s
// `RetStmt` arm has nothing to read; the value of a body block is its last statement,
// which is what `monoCoerceFnValueName`'s `Block` arm walks to.
function monoWalkFnBody(fnIx: i32) {
  // What the body demands is demanded under the instance it is.
  elabWalkPush(elabKeyAt(fnIx))
  cadWalkFn.push(monoCadInstOf(fnIx))
  if monoFrameSharesBody(fnIx) { nodeTyInstFrameNote(fnIx) }
  const was = nodeTyInstEnter(fnIx)
  const r = monoWalkFnBodyIn(fnIx)
  nodeTyInstEnter(was)
  monoBuildPop()
  r
}

// Leaves the build or walk in progress: pops both its instance stacks; 0.
function monoBuildPop(): i32 {
  cadWalkFn.pop()
  elabWalkPop()
}

function monoWalkFnBodyIn(fnIx: i32) {
  const fn = nodeAt(fnIx)
  if !vrIndexed(fnIx) {
    const one: i32[] = [fnIx]
    monoReachIndex(one)
  }
  if fn is FuncDecl {
    const widen = monoRetWidenFns.get(fnIx) ?? false
    if widen { monoInstanceWidenRet = true }
    const bc = monoCoerceFnValue(fn.fnBody, fn.fnRet, fnIx)
    if widen { monoInstanceWidenRet = false }
    if bc < 0 { return -1 }
    if monoNoteRetDeliveries(fn, fnIx) < 0 { return -1 }
    // A body's value is delivered past the return like a `return`'s argument (D6340).
    if fn.fnRet < 0 && fn.fnBody >= 0 {
      const b = nodeAt(fn.fnBody)
      if b is Block && b.blkStmts.length > 0 {
        const tail = b.blkStmts[b.blkStmts.length - 1]
        if monoCoerceRetAtPin(tail, fnIx) < 0 { return -1 }
        if monoPinReturnedList(tail, fnIx) < 0 { return -1 }
      }
    }
    return monoWalk(fn.fnBody, fnIx)
  }
  0
}

// Each binding function `fn` (node `fnIx`) returns, by `return` or as its body's value, is
// delivered at its annotated function-typed result (D3862).
function monoNoteRetDeliveries(fn: FuncDecl, fnIx: i32) {
  if fn.fnRet < 0 { return 0 }
  monoNoteRetDeliveriesAt(fn, fnIx, tyNameOf(fn.fnRet), nodeTyIxOf(fn.fnRet))
}

// `monoDeliverCallRets` for `at` when it is a call of a function declared by name; 0 otherwise.
function monoDeliverCallAt(at: i32, ann: string, annTy: i32): i32 {
  const c = unwrapParen(at)
  if c < 0 { return 0 }
  const cn = nodeAt(c)
  if !(cn is Call) { return 0 }
  const cf = unwrapParen(cn.callFn)
  if cf < 0 || !(nodeAt(cf) is Ident) { return 0 }
  const fd = identDeclOf(cf)
  if fd < 0 { return 0 }
  monoDeliverCallRets(c, ann, fd, annTy)
}

// Per un-annotated concrete function node, the function type its calls' results are delivered at.
let monoRetDeliveredAt: {[i32]: i32} = Map()

// A call `at` of un-annotated concrete function `fd` delivered at function type `ann` delivers
// each of `fd`'s returns there, as an annotated result would, when one of them is a hole lambda;
// a second type is refused, since the one value `fd` returns has one signature (D6522).
function monoDeliverCallRets(at: i32, ann: string, fd: i32, annTy: i32): i32 {
  const fn = nodeAt(fd)
  if !(fn is FuncDecl) || fn.fnRet >= 0 || fn.fnTyParams.length > 0 { return 0 }
  for p in fn.fnParams {
    const pn = nodeAt(p)
    if pn is Param {
      if pn.parType < 0 { return 0 }
    }
  }
  const at2 = annTy
  if at2 < 0 { return 0 }
  if !monoRetsReachHoleLam(fd, []) { return 0 }
  const rets = monoFnRetArgs(fn)
  const prev = monoRetDeliveredAt[fd] ?? -1
  // The same function type can sit at two indices, so a second delivery is compared as a type.
  if prev >= 0 && (prev == at2 || tySame(prev, at2)) { return 0 }
  if prev >= 0 {
    return emitFailAt(
      "emitProgram: `"
        + fn.fnName
        + "` returns one function value and its calls deliver it at "
        + "two function types, and one function value has one signature — return a separate "
        + "function for each type",
      at,
    )
  }
  monoRetDeliveredAt[fd] = at2
  for r in rets {
    if monoNoteBindDeliveryCall(r, ann, fd, -1, annTy) < 0 { return -1 }
  }
  0
}

// Whether function `fd` returns a hole lambda, directly or through a call of a function that
// does; `seen` holds the functions already asked.
function monoRetsReachHoleLam(fd: i32, seen: i32[]): boolean {
  if fd < 0 || i32ListHas(seen, fd) { return false }
  const fn = nodeAt(fd)
  if !(fn is FuncDecl) { return false }
  seen.push(fd)
  for r in monoFnRetArgs(fn) {
    const x = unwrapParen(r)
    const fe = monoLamValueFe(x, fd)
    if fe >= 0 && fe < monoGen.length && monoGen[fe] == 1 && monoLamIsHole(fe) {
      return true
    }
    if x >= 0 {
      const cn = nodeAt(x)
      if cn is Call {
        const cf = unwrapParen(cn.callFn)
        if (
          cf >= 0
          && nodeAt(cf) is Ident
          && monoRetsReachHoleLam(identDeclOf(cf), seen)
        ) {
          return true
        }
      }
    }
  }
  false
}

// The values `fn` returns: its body's last statement and each `return`'s argument, a nested
// function's own excluded.
function monoFnRetArgs(fn: FuncDecl): i32[] {
  const out: i32[] = []
  if fn.fnBody < 0 { return out }
  const b = nodeAt(fn.fnBody)
  if b is Block {
    if b.blkStmts.length > 0 { out.push(b.blkStmts[b.blkStmts.length - 1]) }
  }
  const stack: i32[] = [fn.fnBody]
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      const n = nodeAt(ix)
      if n is RetStmt { out.push(n.retArg) }
      if !(n is FuncDecl) {
        for k in nodeChildren(ix) { stack.push(k) }
      }
    }
  }
  out
}

// `monoNoteRetDeliveries` at the function type spelled `ann` (from `annTy`) in place of `fn`'s
// own result.
function monoNoteRetDeliveriesAt(
  fn: FuncDecl,
  fnIx: i32,
  ann: string,
  annTy: i32,
) {
  if annTy < 0 || annTy >= T.tys.length || !(tyAt(annTy) is TyFunc) { return 0 }
  for r in monoFnRetArgs(fn) {
    if monoNoteBindDeliveryCall(r, ann, fnIx, -1, annTy) < 0 { return -1 }
  }
  0
}

// The `fnStmts` position `emitExportSection` would resolve `name` to: the first slot
// holding a `FuncDecl` of that name. The mirroring is load-bearing — `monoNameIsExported`
// answers about a name, but two slots can carry one name and only one is the ABI entry.
// The other is ordinary dead code that must keep taking the silent no-op stub.

// Prior iterations of the prune loop only ever replace a slot with a same-named stub, so
// the answer does not depend on how far the prune has walked.
function monoFirstFnIndexNamed(name: string): i32 {
  let i = 0
  while i < fnStmts.length {
    const f = nodeAt(fnStmts[i])
    if f is FuncDecl {
      if f.fnName == name { return i }
    }
    i = i + 1
  }
  -1
}

// The public name an ABI entry publishes `name` under — for the diagnostic below, so it
// names what the user wrote. In module mode a merged name is mangled and a re-export may
// rename it, so the raw `fnName` is not something the source contains. Falls back to
// `name`.
function monoExportPublicName(name: string): string {
  let i = 0
  while i < reExpTarget.length {
    if reExpTarget[i] == name { return reExpName[i] }
    i = i + 1
  }
  name
}

// Did `monomorphize` pin the generic declaration at lifted position `origFe` from at least
// one call site? Every instantiation records a row, the count-0 one included, so this is
// the rename-immune answer, asked after the pass has rewritten callee identifiers to
// instance names — which is why counting `Ident`s cannot answer it.

// A template nothing instantiated still emits its body at the i32 default, and that body
// is only accidentally valid, so every value-floor exemption handing one out as a closure
// has to demand this first.
export function monoInstantiatedAny(origFe: i32) {
  let k = 0
  while k < monoInstOrig.length {
    if monoInstOrig[k] == origFe { return true }
    k = k + 1
  }
  false
}

// The value-floor reject text for the generic function at lifted position `fe`: names the
// function and its un-annotated parameters, and — from `monoPinnedSigsOf` — the concrete
// signatures the program's own call sites already pin it at, the annotation to write.
export function genericFnValueRejectMsg(fe: i32) {
  let nm = "<anonymous>"
  let holes = ""
  let nHoles = 0
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    if fn.fnName != "" { nm = fn.fnName }
    const ps = fn.fnParams
    let i = 0
    while i < ps.length {
      const p = nodeAt(ps[i])
      if p is Param {
        if p.parType < 0 {
          if holes != "" { holes = holes + ", " }
          holes = holes + "`" + p.parName + "`"
          nHoles = nHoles + 1
        }
      }
      i = i + 1
    }
  }
  let head = "emitProgram: cannot take the generic function `"
    + nm
    + "` as a value — a function value carries ONE signature, and "
  if nHoles == 1 {
    head = head
      + "parameter "
      + holes
      + " is un-annotated (it would default to i32). "
  } else {
    head = head
      + "parameters "
      + holes
      + " are un-annotated (they would default to i32). "
  }
  const sigs = monoPinnedSigsOf(fe)
  if sigs == "" {
    return head
      + "No call site pins `"
      + nm
      + "`, so there is no inferred signature to adopt — annotate the parameter"
      + pluralS(nHoles)
      + ", or call `"
      + nm
      + "` directly by name"
  }
  head
    + "Call sites pin `"
    + nm
    + "` at "
    + sigs
    + " — annotate the parameter"
    + pluralS(nHoles)
    + " with the signature this value needs, or call `"
    + nm
    + "` directly by name"
}

// `"s"` for a plural count, `""` for exactly one — kept out of the message builder so the
// two branches cannot disagree about the diagnostic's own agreement.
function pluralS(n: i32) {
  if n == 1 { return "" }
  "s"
}

// The distinct concrete parameter spellings every instance pinned for the generic
// declaration at `origFe`, comma-joined — or "" when no call site pinned it. The
// diagnostic half of `monoInstantiatedAny`. `monoInstFe` can name an appended slot, so
// the bound is `fnStmts.length`.
export function monoPinnedSigsOf(origFe: i32) {
  const sigs: string[] = []
  let k = 0
  while k < monoInstOrig.length {
    if monoInstOrig[k] == origFe {
      const ife = monoInstFe[k]
      if ife >= 0 && ife < fnStmts.length {
        const fn = nodeAt(fnStmts[ife])
        if fn is FuncDecl {
          let sig = "("
          const ps = fn.fnParams
          let i = 0
          while i < ps.length {
            if i > 0 { sig = sig + ", " }
            const p = nodeAt(ps[i])
            if p is Param {
              if p.parType >= 0 {
                sig = sig + tyNameOf(p.parType)
              } else {
                sig = sig + "i32"
              }
            }
            i = i + 1
          }
          // Two instances can render the same spelling (their keys differ in a baked CALLBACK,
          // not in a parameter type), and a repeated signature reads as a compiler bug.
          pushUniqueAtom(sigs, sig + ")")
        }
      }
    }
    k = k + 1
  }
  let out = ""
  let j = 0
  while j < sigs.length {
    if j > 0 { out = out + ", " }
    out = out + sigs[j]
    j = j + 1
  }
  out
}

// Which of `names` is referenced as a function value (an `Ident` that is not a `Call`'s callee)
// in the arena: 1 when a reference is not `vrValueInert`, 2 when every one is, else 0,
// parallel to `names`; the un-annotated-param prune needs it. With `cmpCalls`, an `==`/`!=`
// operand counts as no use, since a comparison calls nothing.
function monoNamesUsedAsValue(names: string[], cmpCalls: boolean): i32[] {
  const hit: i32[] = []
  let h = 0
  while h < names.length {
    hit.push(0)
    h = h + 1
  }
  if names.length == 0 { return hit }
  const isCallee: i32[] = []
  let i = 0
  while i < P.nodes.length {
    isCallee.push(0)
    i = i + 1
  }
  let j = 0
  while j < P.nodes.length {
    const cn = nodeAt(j)
    if cn is Call {
      const cf = cn.callFn
      if cf >= 0 && cf < isCallee.length { isCallee[cf] = 1 }
    }
    // A name write's value: the written-binding passes instance it or refuse it (D3939).
    if cn is BinExpr && cn.binOp == "=" && nodeAt(cn.binLeft) is Ident {
      const rv = unwrapParen(cn.binRight)
      if rv >= 0 && rv < isCallee.length { isCallee[rv] = 2 }
    }
    if cmpCalls && cn is BinExpr && (cn.binOp == "==" || cn.binOp == "!=") {
      const lo = unwrapParen(cn.binLeft)
      const ro = unwrapParen(cn.binRight)
      if lo >= 0 && lo < isCallee.length { isCallee[lo] = 1 }
      if ro >= 0 && ro < isCallee.length { isCallee[ro] = 1 }
    }
    j = j + 1
  }
  let dead: i32[] = []
  let k = 0
  while k < P.nodes.length {
    if isCallee[k] != 1 {
      const idn = nodeAt(k)
      if idn is Ident {
        let m = 0
        while m < names.length {
          if names[m] == idn.identName && hit[m] != 1 {
            let mark = 1
            if isCallee[k] == 2 || vrValueInert(k) || elabValueSlotUncalled(k) {
              mark = 2
            }
            // A template body no slot emits holds no use (D6930); built on the first such read.
            if mark == 1 && dead.length == 0 { dead = monoUnemittedNodes() }
            if mark == 1 && dead[k] == 1 { mark = hit[m] }
            hit[m] = mark
          }
          m = m + 1
        }
      }
    }
    k = k + 1
  }
  hit
}

// Per node, 1 when only the body of a generic template no slot emits holds it: one whose first
// instance replaced its slot, or an unreplaced `<T>` template the prune stubs. 0 for every node
// an emitted slot or a module statement reaches, and for every node no template holds.
function monoUnemittedNodes(): i32[] {
  const mark: i32[] = __array_new__(P.nodes.length, 0)
  const slots: {[i32]: i32} = Map()
  for f in fnStmts { slots[f] = (slots[f] ?? 0) + 1 }
  const roots: i32[] = []
  let gc = 0
  while gc < monoOrigNode.length && gc < monoGen.length && gc < fnStmts.length {
    const o = monoOrigNode[gc]
    if monoGen[gc] == 1 && o >= 0 && o < P.nodes.length {
      const f = nodeAt(o)
      if f is FuncDecl {
        const n = slots[o] ?? 0
        if n == 0 || (n == 1 && fnStmts[gc] == o && f.fnTyParams.length > 0) {
          roots.push(o)
        }
      }
    }
    gc = gc + 1
  }
  if roots.length == 0 { return mark }
  for o in roots { mark[o] = 3 }
  for o in roots { monoMarkReach(mark, o, 1) }
  for f in fnStmts { monoMarkReach(mark, f, 2) }
  for st in monoProgStmts { monoMarkReach(mark, st, 2) }
  let i = 0
  while i < mark.length {
    if mark[i] == 3 { mark[i] = 1 }
    i = i + 1
  }
  mark
}

// Marks `v` every node `root` reaches, entering function bodies, that holds a lower mark; a dead
// template root (3) is entered only as its own root.
function monoMarkReach(mark: i32[], root: i32, v: i32) {
  if root < 0 || root >= mark.length || (mark[root] == 3 && v == 2) { return 0 }
  const stack: i32[] = [root]
  while stack.length > 0 {
    const cur = stack.pop() ?? -1
    if cur >= 0 && cur < mark.length && (cur == root || mark[cur] < v) {
      if mark[cur] != 3 || cur == root {
        if mark[cur] != 3 { mark[cur] = v }
        const b = monoNestedBodyOf(cur)
        if b >= 0 { stack.push(b) }
        for ch in nodeChildren(cur) { stack.push(ch) }
      }
    }
  }
  0
}

// The lifted-function position of the generic named function the module-level binding at
// `letIx` aliases, when handing that template out as this binding's closure value is sound
// — else -1. Three gates, each load-bearing: an un-annotated-param named function,
// instantiated at least once, and never referenced as a value.
export function monoGenericAliasFe(letIx: i32) {
  if letIx < 0 { return -1 }
  const d = nodeAt(letIx)
  if d is LetDecl {
    const fe = fieldValueFeOf(d.letInit)
    if fe < 0 { return -1 }
    if !fnHasUnannotatedParam(fe) { return -1 }
    if criFnIsAnonLambda(fe) { return -1 }
    if !monoInstantiatedAny(fe) { return -1 }
    const one: string[] = []
    one.push(d.letName)
    const used = monoNamesUsedAsValue(one, true)
    if used[0] != 0 { return -1 }
    return fe
  }
  -1
}

// Instantiates the un-annotated lambda in slot `fe` at the one signature the flow table pins its
// class at, so a peer's cell type is not met with the hole's i32 default. A lambda the checker
// typed concretely keeps that signature: a pin names no result, so its instance would return the
// body's own type. 0 when the table pins none, -1 on a failed mint.
function monoPinLamFromFlow(fe: i32): i32 {
  if fe < 0 || fe >= fnStmts.length { return 0 }
  const lt = nodeTyIxOf(fnStmts[fe])
  if lt >= 0 && lt < T.tys.length && tyAt(lt) is TyFunc && !tyHasTyVar(lt) {
    return 0
  }
  monoPinLamAtTys(fe, elabDeclOnePin(fnStmts[fe]), false)
}

// The instance the last `monoMakeInstance` minted or hit; -1 before one.
let monoLastInstFe = 0 - 1
// The binding nodes a call has gone through.
let monoBindCalled: {[i32]: boolean} = Map()

// A binding read at `at` in frame `ctx` and delivered where annotation `tyNode` is a function
// type with concrete parameters is called at that signature by whoever receives it (D3862).
// `callIx` is the call it is an argument of, or -1 for any other position.
function monoNoteBindDelivery(at: i32, tyNode: i32, ctx: i32, callIx: i32) {
  if tyNode < 0 { return 0 }
  monoNoteBindDeliveryCall(
    at,
    tyNameOf(tyNode),
    ctx,
    callIx,
    nodeTyIxOf(tyNode),
  )
}

// `monoNoteBindDelivery` at the function type spelled `ann` (from `annTy`, else -1): a list's
// element type, for a `push` or an element store, has a type and no annotation node (D3867).
function monoNoteBindDeliveryAt(at: i32, ann: string, ctx: i32, annTy: i32) {
  monoNoteBindDeliveryCall(at, ann, ctx, -1, annTy)
}

// `monoNoteBindDeliveryAt` where the delivery is an argument of call `callIx`, or -1.
function monoNoteBindDeliveryCall(
  at: i32,
  ann: string,
  ctx: i32,
  callIx: i32,
  annTy: i32,
) {
  if at < 0 { return 0 }
  let name = monoIdentNameOf(at)
  if name == "" { name = monoCellReadName(at) }
  if name == "" {
    if nodeAt(unwrapParen(at)) is Call {
      return monoDeliverCallAt(at, ann, annTy)
    }
    return monoDeliverLamLit(at, ctx, callIx, annTy)
  }
  // The destination's function type, its parameters spelled by the naming rule; a nullable one
  // delivers no signature here.
  const df = if annTy >= 0 && annTy < T.tys.length { tyAt(annTy) } else { tyAt(0) }
  if !(df is TyFunc) { return 0 }
  let sig = ""
  for pt in df.fnParamTypes {
    const ps = monoPinSpellShaped(pt)
    if ps == "" { return 0 }
    sig = sig + ps + ","
  }
  // The instance the elaboration made for the delivered value names its signature, where it made
  // one; a value it instanced at several stays at the destination's (D12234).
  const vt = elabValueInstSig(at)
  const vf = if vt >= 0 { tyAt(vt) } else { tyAt(0) }
  let sigTys: i32[] = monoFnTyParamTys(
    if tyNulFuncInner(annTy) >= 0 { tyNulFuncInner(annTy) } else { annTy },
  )
  if vf is TyFunc && vf.fnParamTypes.length == df.fnParamTypes.length {
    let es = ""
    for p in vf.fnParamTypes {
      const n = monoPinAnnSpelling(p)
      es = if n == "" || es == "-" { "-" } else { es + n + "," }
    }
    if es != "-" {
      sig = es
      sigTys = vf.fnParamTypes
    }
  }
  monoDeliveredArgs.push(monoReadNameNode(at))
  // A hole lambda the name reaches that nothing has pinned yet takes the signature in place,
  // as its own contextual type would pin it (D3852).
  const fe = monoLamValueFe(at, ctx)
  if (
    fe >= 0
    && fe < monoGen.length
    && monoGen[fe] == 1
    && !monoInstantiatedAny(fe)
  ) {
    if (
      monoInstanceFor(fe, monoSigPins(sig + ";"), fnStmts[fe], -1, [], sigTys)
      < 0
    ) {
      return -1
    }
  } else if (
    fe >= 0
    && fe < monoGen.length
    && monoGen[fe] == 1
    && !monoSlotParamsAre(fe, sigTys)
    && monoWriteNamesLam(at, fe, ctx)
  ) {
    // One pinned at another signature: the delivered name takes the instance at this one, minted
    // by the first such delivery and found by every later one (D3867, D3881).
    if monoInstanceFor(fe, monoSigPins(sig + ";"), at, -1, [], sigTys) < 0 {
      return -1
    }
  }
  monoNoteBindSig(at, ctx)
}

// A hole lambda written as a literal where function type `annTy` is delivered is pinned there in
// place, as a capture cell's literal is. One literal wanted at two types takes an instance per
// type where it is an argument of call `callIx`, and is refused elsewhere (D5881, D5931).
function monoDeliverLamLit(at: i32, ctx: i32, callIx: i32, annTy: i32): i32 {
  // The literal is pinned at the signature the elaboration gives it: its own type at this frame,
  // else the one signature it instanced it at, else the slot it is written into; the destination's
  // spelling where none closes. Only the parameters are taken; the result stays the destination's.
  const lx = unwrapParen(at)
  let lt = elabIdentityTy(lx, ctx)
  const ltf = if lt >= 0 { tyAt(lt) } else { tyAt(0) }
  if !(ltf is TyFunc) || tyHasTyVar(lt) || tyReachesHole(lt, 16) {
    lt = elabValueInstSig(lx)
  }
  if lt < 0 {
    const wt = elabWrittenSlotTy(lx, ctx)
    const wf = if wt >= 0 { tyAt(wt) } else { tyAt(0) }
    if wf is TyFunc && !tyHasTyVar(wt) && !tyReachesHole(wt, 16) { lt = wt }
  }
  // The literal takes its own signature where its parameters agree in number with the
  // destination's function type and each has a spelling; else the destination's.
  const dt = if tyNulFuncInner(annTy) >= 0 { tyNulFuncInner(annTy) } else { annTy }
  const df = if dt >= 0 && dt < T.tys.length { tyAt(dt) } else { tyAt(0) }
  const lf = if lt >= 0 { tyAt(lt) } else { tyAt(0) }
  let tnameTy = annTy
  if (
    df is TyFunc
    && lf is TyFunc
    && lf.fnParamTypes.length == df.fnParamTypes.length
  ) {
    let spelt = true
    for pt in lf.fnParamTypes {
      if monoPinAnnSpelling(pt) == "" { spelt = false }
    }
    if spelt { tnameTy = lt }
  }
  const none: i32[] = []
  if monoLamLitTakeTys(at, ctx, none, tnameTy) == 1 {
    const x = unwrapParen(at)
    // The pins are the signature's parameters, spelled by the naming rule.
    const pnames: string[] = []
    const tt = if tyNulFuncInner(tnameTy) >= 0 { tyNulFuncInner(tnameTy) } else { tnameTy }
    const tf = if tt >= 0 && tt < T.tys.length { tyAt(tt) } else { tyAt(0) }
    let pinsOk = tf is TyFunc
    if tf is TyFunc {
      for pt in tf.fnParamTypes {
        const ps = monoPinSpellShaped(pt)
        if ps == "" { pinsOk = false }
        pnames.push(ps)
      }
    }
    const lfe = monoLamValueFe(x, ctx)
    if (
      callIx >= 0
      && pinsOk
      && monoHoleLamArgAgain(callIx, lfe, x, pnames, monoFnTyParamTys(tnameTy))
        >= 0
    ) {
      return 0
    }
    return emitFailAt(
      "emitProgram: this lambda is handed on at two different function types, and one lambda "
        + "literal has one signature — bind it once per type, or annotate its parameters",
      unwrapParen(at),
    )
  }
  0
}

// `monoCellLamTake` for the hole lambda literal at `at` at function type `annTy`, called at the
// parameter types `delTys` where the caller holds them; 0 for anything else, including one its
// context already typed, which keeps that signature and its result.
function monoLamLitTakeTys(at: i32, ctx: i32, delTys: i32[], annTy: i32): i32 {
  const x = unwrapParen(at)
  if x < 0 || !(nodeAt(x) is FuncDecl) { return 0 }
  if monoTyConcreteFn(nodeTyIxOf(x)) { return 0 }
  const lfe = monoLamValueFe(x, ctx)
  if lfe < 0 || lfe >= monoGen.length || monoGen[lfe] != 1 { return 0 }
  if !monoLamIsHole(lfe) { return 0 }
  monoCellLamTake(lfe, x, ctx, delTys, annTy)
}

// Hole lambda `lfe`, the literal `x` among the arguments of call `callIx`, instanced at the
// parameter pins `pnames` beside the instance another type took first: that instance's node,
// which replaces the argument, or -1 when none could be made.
function monoHoleLamArgAgain(
  callIx: i32,
  lfe: i32,
  x: i32,
  pnames: string[],
  pinTys: i32[],
): i32 {
  if callIx < 0 || callIx >= P.nodes.length { return -1 }
  const c = nodeAt(callIx)
  if !(c is Call) { return -1 }
  let k = 0
  while k < c.callArgs.length && unwrapParen(c.callArgs[k]) != x { k = k + 1 }
  if k >= c.callArgs.length { return -1 }
  monoLastInstFe = -1
  const r = monoInstanceFor(lfe, pnames, x, -1, [], pinTys)
  const fe = monoLastInstFe
  if r < 0 || fe < 0 || fe >= fnStmts.length || fe == lfe { return -1 }
  c.callArgs[k] = fnStmts[fe]
  fnStmts[fe]
}

// Each argument of `xs.push(…)` is delivered at the one signature the flow table pins the list's
// element at in this frame (D3867); the value of `m.set(k, v)` at the type the checker stamped.
function monoNotePushDeliveries(n: Call, ctx: i32) {
  if n.callFn < 0 { return 0 }
  const cf = nodeAt(n.callFn)
  if !(cf is Member) { return 0 }
  const ot = nodeTyIxOf(cf.memObj)
  if cf.memProp == "set" && n.callArgs.length == 2 {
    if monoDeliverAtPin(n.callArgs[1], "", ctx, -1) < 0 { return -1 }
    return monoDeliverLitAtPlace(
      n.callArgs[1],
      cf.memObj,
      "v",
      monoMapValTy(ot),
      ctx,
    )
  }
  if cf.memProp != "push" { return 0 }
  const enTys: i32[] = []
  const enFt: i32[] = []
  const en = monoPlacePinNameTys(cf.memObj, "e", ctx, enTys, enFt)
  for pa in n.callArgs {
    const ent = if enFt.length == 1 { enFt[0] } else { -1 }
    if monoDeliverAtPinTys(pa, en, ctx, enTys, ent) < 0 { return -1 }
    if monoDeliverLitAtPlace(pa, cf.memObj, "e", monoListElemTy(ot), ctx) < 0 {
      return -1
    }
  }
  0
}

// The element type of list type `t`, else -1.
function monoListElemTy(t: i32): i32 {
  if t < 0 || t >= T.tys.length { return -1 }
  const l = tyAt(t)
  if l is TyArray { return l.aElem }
  -1
}

// The value type of map type `t`, else -1.
function monoMapValTy(t: i32): i32 {
  if t < 0 || t >= T.tys.length { return -1 }
  const m = tyAt(t)
  if m is TyMap { return m.mVal }
  -1
}

// `monoDeliverLitAt` for a list or record literal `v` stored into place `e`, or into its slot
// `kid` when not "", whose type there is `ty`; nothing for any other value.
function monoDeliverLitAtPlace(
  v: i32,
  e: i32,
  kid: string,
  ty: i32,
  ctx: i32,
): i32 {
  const x = unwrapParen(v)
  if x < 0 || !(nodeAt(x) is ArrayLit || nodeAt(x) is ObjLit) { return 0 }
  const path: string[] = []
  const d = monoPlaceRoot(e, path, 0)
  if kid != "" { path.push(kid) }
  monoDeliverLitAt(x, d, path, ty, ctx, 0)
}

// Each function list or record literal `v` holds, at slot `path` of binding `d` (-1 for none)
// whose type is `ty`, is delivered at the one signature the flow table pins its slot at, else
// at the slot's own function type when that has no hole (D9340).
function monoDeliverLitAt(
  v: i32,
  d: i32,
  path: string[],
  ty: i32,
  ctx: i32,
  depth: i32,
): i32 {
  const x = unwrapParen(v)
  if x < 0 || depth > TY_WALK_DEPTH { return 0 }
  const n = nodeAt(x)
  if n is ArrayLit {
    const et = monoListElemTy(ty)
    for el in n.arrElems {
      if !(nodeAt(unwrapParen(el)) is Spread) {
        const p = monoPathWith(path, "e")
        if monoDeliverLitAt(el, d, p, et, ctx, depth + 1) < 0 { return -1 }
      }
    }
    return 0
  }
  if n is ObjLit {
    for fx in n.objFields {
      const f = nodeAt(fx)
      if f is FieldInit {
        const p = monoPathWith(path, "f." + f.fiName)
        const ft = tyFieldTyOf(ty, f.fiName)
        if monoDeliverLitAt(f.fiValue, d, p, ft, ctx, depth + 1) < 0 {
          return -1
        }
      }
    }
    return 0
  }
  if depth == 0 { return 0 }
  let pin = ""
  const pinTys: i32[] = []
  const pinFt: i32[] = []
  if d >= 0 { pin = monoSlotPinNameTys(d, path, ctx, pinTys, pinFt) }
  if pin == "" {
    pin = monoConcreteFnTyName(ty)
    if pin != "" {
      for t in monoFnTyParamTys(ty) { pinTys.push(t) }
      pinFt.push(ty)
    }
  }
  monoDeliverAtPinTys(
    x,
    pin,
    ctx,
    pinTys,
    if pinFt.length > 0 { pinFt[0] } else { -1 },
  )
}

// A copy of slot path `path` with step `kid` appended.
function monoPathWith(path: string[], kid: string): string[] {
  const p: string[] = []
  for s in path { p.push(s) }
  p.push(kid)
  p
}

// Deliver value `v` at the function type `pin` names: a generic it names takes that instance, and
// a hole lambda it reads takes one per signature it is delivered at; nothing when `pin` is "".
function monoDeliverAtPin(v: i32, pin: string, ctx: i32, pinTy: i32) {
  const none: i32[] = []
  monoDeliverAtPinTys(v, pin, ctx, none, pinTy)
}

// `monoDeliverAtPin` where the caller holds the pin's parameter types `tys`; `pinTy` is the
// function type `pin` is spelled from.
function monoDeliverAtPinTys(
  v: i32,
  pin: string,
  ctx: i32,
  tys: i32[],
  pinTy: i32,
) {
  const st = elabStampAt(unwrapParen(v), ctx)
  if monoTyClosedFn(st) {
    const sn = monoConcreteFnTyName(st)
    const sTys: i32[] = []
    if monoCoerceFnValueTys(v, ctx, st, sTys, st) < 0 { return -1 }
    return monoNoteBindDeliveryAt(v, sn, ctx, st)
  }
  if pin == "" { return 0 }
  if monoCoerceFnValueTys(v, ctx, -1, tys, pinTy) < 0 { return -1 }
  monoNoteBindDeliveryAt(v, pin, ctx, pinTy)
}

// The binding place `e` (`fs`, `fs[0]`, `r.f`, `gs[0][0]`) is rooted at, with each derived slot
// step from it pushed onto `path` (`e` an element, `v` a map value, `f.<name>` a field); -1 when
// the root is no name, or is a capture cell's read, which the cell path delivers.
function monoPlaceRoot(e: i32, path: string[], depth: i32): i32 {
  if depth > 16 { return -1 }
  const x = unwrapParen(e)
  if x < 0 { return -1 }
  const n = nodeAt(x)
  if n is Index {
    if monoIsCellRead(x) { return -1 }
    const d = monoPlaceRoot(n.idxArr, path, depth + 1)
    path.push(elemSlotKind(n.idxArr))
    return d
  }
  if n is Member {
    const d = monoPlaceRoot(n.memObj, path, depth + 1)
    path.push("f." + n.memProp)
    return d
  }
  monoPlaceNameDecl(x)
}

// Whether `x` reads a capture cell, `cell[0]` of a binding the capture rewrite declared, and not
// element 0 of a list the program declared.
function monoIsCellRead(x: i32): boolean {
  if monoCellReadName(x) == "" { return false }
  const r = nodeAt(x)
  if !(r is Index) { return false }
  const di = identDeclOf(r.idxArr)
  if di < 0 || di >= P.nodes.length { return false }
  const d = nodeAt(di)
  d is LetDecl && monoGeneratedCellElem(d.letInit) >= 0
}

// The declaration the name `x` reads; -1 for any other node, which roots no binding place.
function monoPlaceNameDecl(x: i32): i32 {
  if !(nodeAt(x) is Ident) { return -1 }
  identDeclOf(x)
}

// The function type a value stored into place `e`, or into its slot `kid` when not "", delivers
// at in frame `ctx`: the one signature the flow table pins that slot at; "" for none or two.
// Pushes the pin's parameter types onto `tys` as `monoSlotPinNameTys` does.
function monoPlacePinNameTys(
  e: i32,
  kid: string,
  ctx: i32,
  tys: i32[],
  ft: i32[],
): string {
  const path: string[] = []
  const d = monoPlaceRoot(e, path, 0)
  if d < 0 { return "" }
  if kid != "" { path.push(kid) }
  monoSlotPinNameTys(d, path, ctx, tys, ft)
}

// The function type slot `path` of binding or literal `d` delivers at in frame `ctx`: its one flow
// pin (`monoDeclPathPins`), returning the one return annotations give it, else `void`; "" for none
// or two. Pushes onto `tys` the pin's parameter types where held (`monoPinFnParamTys`), and onto
// `ft` the delivery function type the spelling is derived from.
function monoSlotPinNameTys(
  d: i32,
  path: string[],
  ctx: i32,
  tys: i32[],
  ft: i32[],
): string {
  const lf: i32[] = [ctx, d]
  const fts: i32[] = []
  const pins = monoDeclPathKeys(lf, path, false, fts)
  if pins.length != 1 || fts.length != 1 { return "" }
  ft.push(fts[0])
  for t in monoPinFnParamTys(d, path, pins[0]) { tys.push(t) }
  monoSlotPinAnn(lf, path, pins[0], monoSlotRetName(lf, path))
}

// The function type spelling pin `sig` of slot `path` of binding frame `lf` names, returning
// `ret`, spelled from the closed parameter types the pin is taken at: a function-value pin (`=>k`)
// by its concrete function type, any other by the naming rule (D9381, D9431).
function monoSlotPinAnn(
  lf: i32[],
  path: string[],
  sig: string,
  ret: string,
): string {
  const fts = monoPinFnParamTys(lf[1], path, sig)
  if sig != "" && fts.length == 0 {
    emitFail(
      "emitProgram: monomorphize: a slot's pin list has no closed parameter types to spell",
    )
    return ""
  }
  let out = "("
  let k = 0
  while k < fts.length {
    if k > 0 { out = out + "," }
    if fts.length > 0 && monoPinTyIsFnSig(fts[k]) {
      out = out + "(" + monoConcreteFnTyName(fts[k]) + ")"
    } else if fts.length > 0 && monoConcreteNulFnTyName(fts[k]) != "" {
      out = out + monoConcreteNulFnTyName(fts[k])
    } else {
      out = out + monoPinSpellShaped(fts[k])
    }
    k = k + 1
  }
  out + ")=>" + ret
}

// `monoSlotPinNameTys` with a function-value pin left as its wasm signature, which a hole lambda
// delivered at the slot takes its closure signature from.
function monoSlotSigName(d: i32, path: string[], ctx: i32): string {
  const lf: i32[] = [ctx, d]
  const pins = monoDeclPathPins(lf, path)
  if pins.length != 1 { return "" }
  monoSigFnTyNameRet(pins[0] + ";", monoSlotRetName(lf, path))
}

// The one return annotations give slot `path` of binding frame `lf`, else `void`.
function monoSlotRetName(lf: i32[], path: string[]): string {
  const rets = monoDeclPathKeys(lf, path, true, [])
  if rets.length == 1 && rets[0] != PIN_DECLINE { return rets[0] }
  "void"
}

// The parameter types of the closed function type slot `path` of `d` is delivered at whose pin key
// is `sig`, when every function-value pin among them is a function type with no hole; empty
// otherwise.
function monoPinFnParamTys(d: i32, path: string[], sig: string): i32[] {
  const none: i32[] = []
  let tys: i32[] = none
  for t in elabSlotDeliveries(d, path, -1) {
    const ft = tyAt(t)
    if (ft is TyFunc && tys.length == 0 && pinSigOf(ft.fnParamTypes) == sig) {
      tys = ft.fnParamTypes
    }
  }
  let k = 0
  while k < tys.length {
    if monoPinTyIsFnSig(tys[k]) && monoConcreteFnTyName(tys[k]) == "" {
      return none
    }
    k = k + 1
  }
  tys
}

// The types the elaboration gives instance `fe`'s parameters at its key, when each closes and every
// function type among them has no hole; empty otherwise.
function monoInstParamPinTys(fe: i32): i32[] {
  const none: i32[] = []
  if fe < 0 || fe >= fnStmts.length { return none }
  const fd = nodeAt(fnStmts[fe])
  if !(fd is FuncDecl) { return none }
  const k = elabKeyAt(fnStmts[fe])
  if k < 0 { return none }
  const out: i32[] = []
  let i = 0
  while i < fd.fnParams.length {
    const t = elabParamTyOwnAt(k, i)
    if t < 0 || t >= T.tys.length || tyHasTyVar(t) { return none }
    if tyAt(t) is TyFunc && !monoTyClosedFn(t) { return none }
    out.push(t)
    i = i + 1
  }
  out
}

// The spelling of `ty` when it is a function type with no hole, else "".
function monoConcreteFnTyName(ty: i32): string {
  if ty < 0 || ty >= T.tys.length || !(tyAt(ty) is TyFunc) { return "" }
  monoConcreteFnPinName(ty)
}

// The pin spelling of `ty` when it is a nullable function type with no hole, else "" (D9821).
function monoConcreteNulFnTyName(ty: i32): string {
  if ty < 0 || ty >= T.tys.length || tyNulFuncInner(ty) < 0 || tyHasTyVar(ty) {
    return ""
  }
  monoI32AtomPinName(ty)
}

// The pin spelling of `ty` when it is a function type or a list of one, with no hole, else "".
function monoConcreteFnPinName(ty: i32): string {
  if ty < 0 || ty >= T.tys.length || tyHasTyVar(ty) { return "" }
  const t = tyAt(ty)
  if t is TyArray && !monoPinIsFnTy(t.aElem) { return "" }
  if !(t is TyArray) && !(t is TyFunc) { return "" }
  monoPinSpellShaped(ty)
}

// The name function slot `fe` is declared or bound under, "" when it has none.
function monoSlotName(fe: i32): string {
  if fe < 0 || fe >= fnStmts.length { return "" }
  const f = nodeAt(fnStmts[fe])
  if f is FuncDecl { return f.fnName }
  ""
}

// Whether `name`, read at `at` in frame `ctx`, is a parameter or local of `ctx` or of a function
// enclosing it, and so not the module-scope binding of that name.
function monoNameShadowedAt(name: string, at: i32, ctx: i32): boolean {
  if name == "" { return false }
  const sid = sidOf(name)
  let fx = ctx
  let hops = 0
  while hops < 16 && fx >= 0 {
    if monoFnBindsParam(fx, name) { return true }
    const f = nodeAt(fx)
    if f is FuncDecl {
      if bodyLetReadAtSid(f.fnBody, sid, at) >= 0 { return true }
    }
    const slot = fnStmtsPosOf(fx)
    if slot < 0 || slot >= fnParent.length { return false }
    const ps = fnParent[slot]
    if ps < 0 || ps >= fnStmts.length { return false }
    fx = fnStmts[ps]
    hops = hops + 1
  }
  false
}

// The name nodes `monoNoteBindDelivery` recorded: each is a call of what it reads.
let monoDeliveredArgs: i32[] = []

// Marks the binding read at `at` (a name or a capture cell's `d[0]`) in frame `ctx`, and every
// binding its initializer chain names, as called, when the call has signature `sig`.
function monoNoteBindSig(at: i32, ctx: i32) {
  let ax = at
  let fr = ctx
  let hops = 0
  while hops < 8 {
    const lf = monoReadLetFrame(ax, fr)
    if lf[1] < 0 { return 0 }
    const d = nodeAt(lf[1])
    if !(d is LetDecl) { return 0 }
    // A call in a function nothing names never runs.
    // A module-scope binding's call in an unnamed module-scope function still counts: that
    // function is lowered, and with it the call (D3868).
    if hops == 0 && lf[0] >= 0 && monoWriteFrameDead(ctx, lf[0]) { return 0 }
    monoBindCalled.set(lf[1], true)
    if d.letInit < 0 { return 0 }
    let iv = d.letInit
    const ce = monoGeneratedCellElem(iv)
    if ce >= 0 { iv = ce }
    ax = iv
    fr = lf[0]
    hops = hops + 1
  }
  0
}

// Holds each reassigned binding a hole lambda reaches at the one signature the flow table pins
// it at, since a call at another traps (D3857): its initializer delivers there, as its writes
// already do. A binding pinned at two signatures is refused. -1 on a refusal.
function monoBindingsAtPin(nDecl: i32): i32 {
  monoLetWritesExtend()
  const seen: {[i32]: boolean} = Map()
  const order: i32[] = []
  for k in monoWriteOrder { order.push(k) }
  for k in order {
    // Locating a write's frame walks the program, so a binding that cannot hold a lambda is
    // passed over before any of its writes is located.
    let kd = k
    if k < 0 { kd = 0 - 1 - k }
    if monoBindingMayHoldLam(kd) {
      for i in monoWriteListAt(k) {
        const nd = nodeAt(i)
        if nd is BinExpr {
          const wf = monoTopFrameOf(i)
          const lf = monoReadLetFrame(nd.binLeft, wf)
          if lf[1] >= 0 && !(seen[lf[1]] ?? false) {
            seen[lf[1]] = true
            if monoBindingAtPin(lf, nDecl) < 0 { return -1 }
          }
        }
      }
    }
  }
  0
}

// Whether the binding declared at `k` may hold a hole lambda: an un-annotated `let` whose
// initializer or some write's value is a lambda literal or a name read, the only values
// `monoLamValueFe` resolves to one. A necessary condition, read without locating any frame.
function monoBindingMayHoldLam(k: i32): boolean {
  if k < 0 || k >= P.nodes.length { return false }
  const d = nodeAt(k)
  if !(d is LetDecl) { return false }
  if d.letKw != "let" || d.letType >= 0 || d.letInit < 0 { return false }
  let iv = d.letInit
  const ce = monoGeneratedCellElem(iv)
  if ce >= 0 { iv = ce }
  if monoValueMayNameLam(iv) { return true }
  for key in ["n:", "c:"] {
    for i in monoWritesOf(key, k) {
      const nd = nodeAt(i)
      if nd is BinExpr && monoValueMayNameLam(nd.binRight) { return true }
    }
  }
  false
}

// Whether the value at `vx` is a lambda literal or a name or capture-cell read.
function monoValueMayNameLam(vx: i32): boolean {
  nodeAt(vx) is FuncDecl
    || monoIdentNameOf(vx) != ""
    || monoCellReadName(vx) != ""
}

// `monoBindingsAtPin` for the binding `lf` (`[frame, declaration]`).
function monoBindingAtPin(lf: i32[], nDecl: i32): i32 {
  const d = nodeAt(lf[1])
  if !(d is LetDecl) { return 0 }
  // A binding of a tagged set holds the id, and each call dispatches to its member's instance.
  if fnTagTyIsTagged(fnLetReadTyOf(lf[1])) { return 0 }
  if d.letKw != "let" || d.letType >= 0 || d.letInit < 0 { return 0 }
  let iv = d.letInit
  const ce = monoGeneratedCellElem(iv)
  if ce >= 0 { iv = ce }
  // So does one no write widens, whose reads are its initialiser's type (D15433).
  if fnLetReadTyOf(lf[1]) < 0 && fnTagTyIsTagged(nodeTyIxOf(iv)) { return 0 }
  let lam = monoLamValueFe(iv, lf[0]) >= 0
  for key in ["n:", "c:"] {
    for i in monoWritesOf(key, lf[1]) {
      const nd = nodeAt(i)
      // Locating the write's frame walks the program, so a value that names no lambda and a
      // binding already known to hold one skip it.
      if !lam && nd is BinExpr && monoValueMayNameLam(nd.binRight) {
        const wf = monoLetWriteFrame(lf, i)
        if wf.length == 1 && monoLamValueFe(nd.binRight, wf[0]) >= 0 {
          lam = true
        }
      }
    }
  }
  if !lam { return 0 }
  // A captured binding lives in a cell, so its slot is the cell element.
  const path: string[] = []
  if ce >= 0 { path.push("e") }
  const fts: i32[] = []
  const pins = monoDeclPathKeys(lf, path, false, fts)
  const pinTy = if fts.length == 1 { fts[0] } else { -1 }
  if pins.length > 1 {
    return emitFail(MONO_BIND_SIG_PRE + d.letName + MONO_BIND_SIG_POST)
  }
  // One read by name is renamed to the instance at the pin, as a write by name is.
  if (
    pins.length == 1
    && monoWriteNamesLam(iv, monoLamValueFe(iv, lf[0]), lf[0])
  ) {
    if monoRenameInitAt(lf[1], lf[0], pins[0] + ";", pinTy, nDecl) < 0 {
      return emitFail(MONO_BIND_SIG_PRE + d.letName + MONO_BIND_SIG_POST)
    }
    return monoRetypePinCalls(lf[1], path)
  }
  if (
    monoDeliverAtPin(iv, monoSlotSigName(lf[1], path, lf[0]), lf[0], pinTy)
    < 0
  ) {
    return -1
  }
  if pins.length == 1 { monoRetypePinCalls(lf[1], path) }
  0
}

// For the binding `d` held at its one pin: each call taking that pin whose callee the checker left
// an open type, as one past an inferred return is, is typed at its own arguments and result,
// which are the pin's (D5062). In a body a generic's instances share, those types are closed, so
// the signature is every instance's (D5970).
function monoRetypePinCalls(d: i32, path: string[]): i32 {
  const calls = elabSlotSetCalls(d, path)
  for cx in calls {
    const c = if cx >= 0 { nodeAt(cx) } else { nodeAt(0) }
    if c is Call && fnTagCallArms(cx).length == 0 {
      const cf = unwrapParen(c.callFn)
      const ct = nodeTyIxOf(cf)
      const rt = nodeTyIxOf(cx)
      if (
        cf >= 0
        && ct >= 0
        && ct < T.tys.length
        && tyAt(ct) is TyFunc
        && tyHasTyVar(ct)
        && rt >= 0
      ) {
        let ps: i32[] = []
        for a in c.callArgs {
          const at = nodeTyIxOf(a)
          if at >= 0 && !tyHasTyVar(at) { ps.push(at) }
        }
        let r = rt
        // A call at the enclosing generic's own type parameter takes the closed types every
        // instance gives its arguments, when they agree (D6003).
        if ps.length != c.callArgs.length || tyHasTyVar(r) {
          ps = elabCallArgTysAgreed(cx)
          r = monoPinCallRet(c.callArgs, ps, rt)
        }
        if (
          r >= 0
          && ps.length == c.callArgs.length
          && monoWritesTypedAt(d, ps)
        ) {
          nodeTyRecord(cf, mkFuncTy(ps, r))
        }
      }
    }
  }
  0
}

// Result type `rt` of a call with arguments `args` pinned at the closed parameter types `pt`: each
// argument typed by a bare type variable binds it to its pin. -1 when `pt` does not cover the
// arguments, an argument disagrees with its pin, or the result stays open.
function monoPinCallRet(args: i32[], pt: i32[], rt: i32): i32 {
  if pt.length != args.length { return -1 }
  const bN: string[] = []
  const bT: i32[] = []
  let i = 0
  while i < args.length {
    const at = nodeTyIxOf(args[i])
    if at < 0 || at >= T.tys.length || pt[i] < 0 { return -1 }
    const a = tyAt(at)
    if a is TyVar {
      bN.push(a.tvName)
      bT.push(pt[i])
    } else if tyHasTyVar(at) || at != pt[i] {
      return -1
    }
    i = i + 1
  }
  let r = rt
  if tyHasTyVar(r) { r = substTyDeep(r, bN, bT) }
  if r < 0 || tyHasTyVar(r) { return -1 }
  r
}

// For a value `v` an un-annotated function returns in frame `ctx`: a declared generic is delivered
// at the one signature the flow table pins the read at, past the return, and each call taking
// that pin is typed at it (D5360). No pin, or two, leaves the value to the emitter's refusal.
function monoCoerceRetAtPin(v: i32, ctx: i32): i32 {
  if v < 0 { return 0 }
  const x = unwrapParen(v)
  if x < 0 { return 0 }
  // A returned list or record literal delivers each function it holds at its own slot's pin
  // (D9410).
  // A returned value `if` or `match`: each arm's list literal, and the choice itself, is built at
  // the joined result holding a tagged set, as a returned literal is.
  if valueJoinAt(x) >= 0 {
    const it = monoFrameInstTmpl(ctx)
    const tmpl = if it[0] == ctx { it[1] } else { -1 }
    const spine: i32[] = []
    const leaves: i32[] = []
    valueTailSplit(x, spine, leaves)
    let jt = -1
    for t in leaves {
      const lt = if nodeAt(t) is ArrayLit || nodeAt(t) is ObjLit { elabRetTaggedJoinTy(t, ctx, tmpl) } else { -1 }
      if lt >= 0 {
        monoRecordJoinedLit(t, lt, ctx, 0)
        jt = lt
      }
    }
    if jt >= 0 {
      for sp in spine {
        if monoNodeOwnedBy(sp, ctx) {
          nodeTyRecord(sp, jt)
        } else {
          nodeTyRecordIn(ctx, sp, jt)
        }
      }
      if monoListElemTy(jt) >= 0 { return 0 }
    }
  }
  if nodeAt(x) is ArrayLit || nodeAt(x) is ObjLit {
    const ft = monoRetFnListTy(x, ctx)
    if ft == -2 { return -1 }
    if ft >= 0 { return 0 }
    const noPath: string[] = []
    return monoDeliverLitAt(x, x, noPath, nodeTyIxOf(x), ctx, 0)
  }
  if (
    monoIfBindingOf(x, ctx)[1] >= 0
    || nodeAt(x) is IfStmt && monoValueNamesGenerics(x, ctx, 0)
  ) {
    return monoIfBoundRetAtPin(x, ctx)
  }
  if !monoNamesDeclaredGeneric(x, ctx) && monoReadGenFnFe(x) < 0 { return 0 }
  const noPath: string[] = []
  // An alias of one is pinned at its own binding, which the flow table keys the read by (D5400).
  let d = x
  let fr = ctx
  const it = monoFrameInstTmpl(ctx)
  const lf = monoReadLetFrame(x, ctx)
  if lf[1] >= 0 {
    d = lf[1]
    fr = lf[0]
  } else {
    // A read in an instance body is banked under the template's read, at the same position.
    const xn = nodeAt(x)
    if it[1] >= 0 && xn is Ident {
      const tr = monoIdentAtPosIn(it[1], xn.identName, xn.pos, 0)
      if tr >= 0 { d = tr }
    }
  }
  const nmTys: i32[] = []
  const nmFt: i32[] = []
  const nm = monoSlotPinNameTys(d, noPath, fr, nmTys, nmFt)
  if nm == "" && monoSlotRetCount(d, fr) <= 1 {
    // The one call pinning it open, at un-annotated lambdas, binds it as a direct call would
    // (D9432).
    const ft = elabHoleGenFlowTy(x, d)
    if ft >= 0 {
      const tyOut: i32[] = [0 - 1]
      monoInstanceWidenRet = true
      const an = monoFnPinAt(x, ctx, ft, d, tyOut)
      monoInstanceWidenRet = false
      if an == "" { return -1 }
      return 0
    }
  }
  if nm == "" || monoSlotRetCount(d, fr) > 1 {
    // An alias's refused read is the generic its initializer names.
    let rd = x
    const dn = nodeAt(d)
    if lf[1] >= 0 && dn is LetDecl && dn.letInit >= 0 {
      rd = unwrapParen(dn.letInit)
    }
    return monoNoteRetCopyRead(fr, d, rd)
  }
  monoInstanceWidenRet = true
  const cr = monoCoerceFnValueTys(x, ctx, -1, nmTys, nmFt[0])
  monoInstanceWidenRet = false
  if cr < 0 { return -1 }
  monoRetypePinCalls(d, noPath)
}

// The element type the returned list literal `x` of functions, or of such lists, in frame `ctx`
// is instanced at and now records, from the one pin its innermost slot takes; -1 when it is no
// such list or the slot has none, -2 when instancing is refused (D9410, D9503).
function monoRetFnListTy(x: i32, ctx: i32): i32 {
  const l = nodeAt(x)
  const it = monoFrameInstTmpl(ctx)
  const tmpl = if it[0] == ctx { it[1] } else { -1 }
  const jt = if l is ArrayLit { elabRetTaggedJoinTy(x, ctx, tmpl) } else { -1 }
  if jt >= 0 {
    monoRecordJoinedLit(x, jt, ctx, 0)
    return monoListElemTy(jt)
  }
  if !(l is ArrayLit) || !monoTyOpen(nodeTyIxOf(x)) { return -1 }
  const ht = elabHeldValTy(x, ctx)
  const het = monoListElemTy(ht)
  if het >= 0 {
    // The type goes down the literal: each nested list or record literal, and each element left
    // open, takes its element type.
    const work: i32[][] = [[x, ht]]
    let wi = 0
    while wi < work.length {
      const wx = work[wi][0]
      const wt = work[wi][1]
      wi = wi + 1
      const wl = nodeAt(wx)
      if wl is ArrayLit && wt >= 0 {
        monoRecordInstOpen(wx, wt, ctx)
        const et = if monoTyOpen(nodeTyIxOf(wx)) { -1 } else { monoListElemTy(wt) }
        if et >= 0 {
          for e in wl.arrElems {
            const ex = unwrapParen(e)
            if ex >= 0 && ex < P.nodes.length && nodeAt(ex) is ArrayLit {
              work.push([ex, et])
            } else if ex >= 0 && ex < P.nodes.length && nodeAt(ex) is ObjLit {
              monoRecordObjLitAt(ex, et, ctx)
            } else if ex >= 0 {
              monoRecordInstOpen(ex, et, ctx)
            }
          }
        }
      }
    }
    if !monoTyOpen(nodeTyIxOf(x)) {
      if monoDeliverLitAt(x, -1, [], ht, ctx, 0) < 0 { return -2 }
      return het
    }
  }
  const lits: i32[] = [x]
  const et = monoRetLitElemTy(x, lits, ["e"], ctx, 0)
  if et < 0 { return et }
  monoRecordInstOpen(x, mkArrayTy(et), ctx)
  et
}

// Records returned literal `x`, and each list and record literal under it, at `t`, the joined
// result holding a tagged set, closed nodes included, so every literal the result returns is one
// build (D15226).
function monoRecordJoinedLit(x0: i32, t: i32, ctx: i32, depth: i32) {
  const x = unwrapParen(x0)
  if (
    x < 0
    || x >= P.nodes.length
    || t < 0
    || t >= T.tys.length
    || depth > TY_WALK_DEPTH
  ) {
    return 0
  }
  const n = nodeAt(x)
  const ct = tyAt(t)
  if n is ArrayLit && ct is TyArray {
    for e in n.arrElems { monoRecordJoinedLit(e, ct.aElem, ctx, depth + 1) }
  } else if n is ObjLit && ct is TyObj {
    for fi in n.objFields {
      const f = nodeAt(fi)
      const ck = if f is FieldInit { strListIndexOf(ct.objFieldNames, f.fiName) } else { -1 }
      if f is FieldInit && ck >= 0 {
        monoRecordJoinedLit(f.fiValue, ct.objFieldTypes[ck], ctx, depth + 1)
      }
    }
    const ot = nodeTyIxOf(x)
    if ot >= 0 && ot != t { monoSupersededObjTys.push(ot) }
    elabRestampNote(x)
    if monoFrameIsGenericInstance(ctx) { monoGradualObjFrame[x] = ctx }
    monoGradualObjList.push(x)
  } else if !(n is Ident && fnTagLeafJoin(x, identDeclOf(x), t)) {
    return 0
  }
  if monoNodeOwnedBy(x, ctx) {
    nodeTyRecord(x, t)
    elabRepRestamp(x, t)
  } else {
    nodeTyRecordIn(ctx, x, t)
  }
  0
}

// The element type of the list literals `lits`, the slot `path` of returned literal `x`: the
// pinned function type, or each element's own list type when every element is a list literal.
function monoRetLitElemTy(
  x: i32,
  lits: i32[],
  path: string[],
  ctx: i32,
  depth: i32,
): i32 {
  if depth > TY_WALK_DEPTH { return -1 }
  const bt = monoBoundFnListElemsTy(lits, ctx)
  if bt >= 0 { return bt }
  const vals: i32[][] = []
  const inner: i32[] = []
  for li in lits {
    const l = nodeAt(li)
    if !(l is ArrayLit) || l.arrElems.length == 0 { return -1 }
    for e in l.arrElems {
      const ex = unwrapParen(e)
      if ex < 0 || nodeAt(ex) is Spread { return -1 }
      if nodeAt(ex) is ArrayLit { inner.push(ex) }
      vals.push([e, ctx])
    }
  }
  if inner.length == 0 { return monoStoredSlotFnTy([ctx, x], path, vals) }
  if inner.length != vals.length { return -1 }
  const et = monoRetLitElemTy(x, inner, monoPathWith(path, "e"), ctx, depth + 1)
  if et < 0 { return et }
  const lt = mkArrayTy(et)
  for i in inner { monoRecordInstOpen(i, lt, ctx) }
  lt
}

// The one closed list-of-functions type every element of the list literals `lits` reads, each a
// `const` its own walk annotated at its pin, now recorded on each read in frame `ctx`; -1 when an
// element is anything else or two disagree.
function monoBoundFnListElemsTy(lits: i32[], ctx: i32): i32 {
  let t = -1
  const reads: i32[] = []
  for li in lits {
    const l = nodeAt(li)
    if !(l is ArrayLit) || l.arrElems.length == 0 { return -1 }
    for e in l.arrElems {
      const x = unwrapParen(e)
      if x < 0 || x >= P.nodes.length || !(nodeAt(x) is Ident) { return -1 }
      const dx = monoInstDeclCopy(ctx, identDeclOf(x))
      if dx < 0 || dx >= P.nodes.length { return -1 }
      const dn = nodeAt(dx)
      if !(dn is LetDecl) || dn.letKw != "const" || dn.letType < 0 { return -1 }
      const bt = nodeTyIxOf(dn.letType)
      if (
        bt < 0
        || bt >= T.tys.length
        || !(tyAt(bt) is TyArray)
        || monoTyOpen(bt)
        || !tyMayHoldFn(bt, 0)
        || (t >= 0 && !tyEq(t, bt))
      ) {
        return -1
      }
      // The const's slot fact answers its list type where the elaboration closes it.
      const sf = elabSlotTyAt(dx, [], ctx)
      t = if sf >= 0 && sf < T.tys.length && !tyHasTyVar(sf) && tyAt(sf) is TyArray { sf } else { bt }
      reads.push(x)
    }
  }
  for x in reads { monoRecordInstOpen(x, t, ctx) }
  t
}

// In frame `fx` of a nested declaration the elaboration built per encloser instance
// (`mintNestedPerEnclOf`), that copy's own `for` loop over the position of `lp`, whose elements
// that instance renames; `lp` itself otherwise (per-instance-identity-2026-11.md, M2).
function monoNestedLoopCopy(fx: i32, lp: i32): i32 {
  if fx < 0 || fx >= P.nodes.length || !mintNestedPerEnclOf(elabSrcDecl(fx)) {
    return lp
  }
  for q in monoFrameNodes(fx) {
    if q != lp && monoSameForIn(q, lp) { return q }
  }
  lp
}

// The copy generic instance `fx` took of its template's binding or `for` loop `d`
// (`monoCloneGenericCalls`), which a read the instance shares with its template still resolves
// to `d`; `d` itself otherwise.
function monoInstDeclCopy(fx: i32, d: i32): i32 {
  if d < 0 || d >= P.nodes.length || !monoFrameIsGenericInstance(fx) {
    return d
  }
  if monoInstOwns(fx, d) { return d }
  for ix in monoFrameNodes(fx) {
    if ix != d && (monoSameLetDecl(ix, d) || monoSameForIn(ix, d)) { return ix }
  }
  d
}

// Whether `a` and `b` are both bindings of one name at one position.
function monoSameLetDecl(a: i32, b: i32): boolean {
  const n = nodeAt(a)
  const m = nodeAt(b)
  n is LetDecl && m is LetDecl && n.letName == m.letName && n.pos == m.pos
}

// Whether `a` and `b` are both `for` loops over one variable at one position.
function monoSameForIn(a: i32, b: i32): boolean {
  const n = nodeAt(a)
  const m = nodeAt(b)
  n is ForIn && m is ForIn && n.fiVar == m.fiVar && n.pos == m.pos
}

// Whether node `x` belongs to generic instance `fx`'s own copy of its template's body.
function monoInstOwns(fx: i32, x: i32): boolean {
  if fx < 0 || x < 0 { return false }
  const it = monoFrameInstTmpl(fx)
  if it[0] != fx || it[1] < 0 || it[1] >= P.nodes.length { return false }
  const tn = nodeAt(it[1])
  tn is FuncDecl && !nodeContains(tn.fnBody, x)
}

// `monoRecordOpen`, also at a node of an instance's own copy of its template's body; a node
// the template's body still holds is shared with its other instances and is left open.
function monoRecordInstOpen(x: i32, t: i32, wf: i32) {
  const it = if wf >= 0 { monoFrameInstTmpl(wf) } else { [0 - 1, 0 - 1] }
  const tx = it[1]
  if (
    x >= 0
    && it[0] == wf
    && tx >= 0
    && tx < P.nodes.length
    && monoTyOpen(nodeTyIxOf(x))
  ) {
    const tn = nodeAt(tx)
    if tn is FuncDecl && !nodeContains(tn.fnBody, x) {
      nodeTyRecord(x, t)
      return 0
    }
  }
  monoRecordOpen(x, t, wf)
}

// Notes generic read `x` (keyed `d` in frame `fr`) when its frame returns it past two pins or two
// results, so it is refused even when another delivery already instanced the generic (D9380,
// D9383).
function monoNoteRetCopyRead(fr: i32, d: i32, x: i32): i32 {
  const noPath: string[] = []
  if (
    monoDeclPathPins([fr, d], noPath).length > 1
    || monoSlotRetCount(d, fr) > 1
  ) {
    if x >= 0 && !i32ListHas(monoRetCopyReads, x) { monoRetCopyReads.push(x) }
  }
  0
}

// How many distinct results the return annotations pin binding `d` at in frame `fr`, a declined
// walk not counting.
function monoSlotRetCount(d: i32, fr: i32): i32 {
  const noPath: string[] = []
  const seen: string[] = []
  for r in monoDeclPathKeys([fr, d], noPath, true, []) {
    if r != PIN_DECLINE && !strListHas(seen, r) { seen.push(r) }
  }
  seen.length
}

// Whether every write of the binding `d` the checker gave a closed function type takes the
// parameters `ps`; one typed at another call's arguments would be delivered at the wrong
// signature, so the call is left open and refused.
function monoWritesTypedAt(d: i32, ps: i32[]): boolean {
  for key in ["n:", "c:"] {
    for i in monoWritesOf(key, d) {
      const nd = nodeAt(i)
      if nd is BinExpr {
        const wt = nodeTyIxOf(nd.binRight)
        if wt >= 0 && wt < T.tys.length && !tyHasTyVar(wt) {
          const w = tyAt(wt)
          if w is TyFunc {
            if w.fnParamTypes.length != ps.length { return false }
            let j = 0
            while j < ps.length {
              if !tyEq(w.fnParamTypes[j], ps[j]) { return false }
              j = j + 1
            }
          }
        }
      }
    }
  }
  true
}

// Whether frame `wf`, at or below frame `top`, is a function nothing names below `top` — so
// never called — or lies inside one. -1 (module scope) and `top` itself are live.
function monoWriteFrameDead(wf: i32, top: i32): boolean {
  let fx = wf
  let guard = 0
  while fx >= 0 && fx != top && guard <= fnStmts.length {
    const slot = fnStmtsPosOf(fx)
    if slot < 0 || slot >= fnParent.length { return false }
    const ps = fnParent[slot]
    // A module-scope function: dead when no statement names it and the host cannot call it.
    if ps < 0 { return monoTopFnUnnamed(fx) }
    if ps >= fnStmts.length { return false }
    const parent = fnStmts[ps]
    const f = nodeAt(fx)
    let nm = ""
    if f is FuncDecl { nm = f.fnName }
    // A lambda is named by the `const` it initializes.
    const pb = monoNestedBodyOf(parent)
    if pb < 0 { return false }
    if nm == "" || criFnIsAnonLambda(slot) { nm = monoConstNameOfInit(pb, fx) }
    if nm == "" { return false }
    if !monoSubtreeNamesIdent(pb, nm, 0) { return true }
    fx = parent
    guard = guard + 1
  }
  false
}

// The function node holding node `ix` that a module-scope function is, or a function lifted
// inside one; -1 for a node of the module's own statements.
function monoTopFrameOf(ix: i32): i32 {
  const st = monoProgTopOf(ix)
  if st < 0 { return -1 }
  monoFrameOfNode(ix, st)
}

// Whether module-scope function node `fx` is named by no statement of the program and is no
// export, so nothing calls it; a lambda is named by the `const` it initializes.
function monoTopFnUnnamed(fx: i32): boolean {
  const f = nodeAt(fx)
  let nm = ""
  if f is FuncDecl { nm = f.fnName }
  if nm != "" && monoNameIsExported(nm) { return false }
  if nm == "" || criFnIsAnonLambda(fnStmtsPosOf(fx)) {
    nm = ""
    for st in monoProgStmts {
      if nm == "" { nm = monoConstNameOfInit(st, fx) }
    }
    if nm == "" || monoNameIsExported(nm) { return false }
  }
  !monoProgNamesIdent(nm)
}

// The identifiers the program's statements name (`monoSubtreeNamesIdent` over each), and whether
// a walk passed its depth bound, which answers every name; banked like `monoProgTop` (D4942).
let monoProgNames: {[string]: boolean} = Map()
let monoProgNamesDeep = false
let monoProgNamesStamp = 0 - 1

// Whether some statement of the program mentions the identifier `nm`.
function monoProgNamesIdent(nm: string): boolean {
  const stamp = monoArenaStamp() + monoProgStmts.length
  if stamp != monoProgNamesStamp {
    // The program's nodes are the ones `monoProgTop` holds, read off its walk at this stamp.
    monoProgTopOf(-1)
    const names: {[string]: boolean} = Map()
    const top = monoProgTop
    if !monoProgTopDeep {
      let ix = 0
      while ix < top.length {
        if top[ix] != -2 {
          const n = nodeAt(ix)
          if n is Ident { names[n.identName] = true }
        }
        ix = ix + 1
      }
    }
    monoProgNames = names
    monoProgNamesDeep = monoProgTopDeep
    monoProgNamesStamp = stamp
  }
  monoProgNamesDeep || (monoProgNames[nm] ?? false)
}

// Whether the binding `lf` (`[frame, declaration]`) is written, directly or through its capture
// cell, in code that can run: a write in a function nothing names cannot.
function monoLetWrittenLive(lf: i32[]): boolean {
  const top = lf[0]
  for key in ["n:", "c:"] {
    for i in monoWritesOf(key, lf[1]) {
      if monoFrameHolds(top, i) {
        let wf = monoTopFrameOf(i)
        if top >= 0 { wf = monoFrameOfNode(i, top) }
        if !monoWriteFrameDead(wf, top) { return true }
      }
    }
  }
  false
}

// The name of the un-annotated `const` in the subtree at `ix` whose initializer is `init`, or "".
function monoConstNameOfInit(ix: i32, init: i32): string {
  const stack: i32[] = [ix]
  while stack.length > 0 {
    const cur = stack.pop() ?? -1
    if cur >= 0 && cur < P.nodes.length {
      const bn = monoConstInitName(cur, init)
      if bn != "" { return bn }
      if !(nodeAt(cur) is FuncDecl) || cur == ix {
        for k in nodeChildren(cur) { stack.push(k) }
      }
    }
  }
  ""
}

// Instantiates the lambda binding node `li` (declared in frame `fx`) is initialized with, by
// name, at signature `target`, renaming the initializer and retyping a capture cell it seeds.
// -1 when that lambda cannot take the signature; 0 otherwise, including no such initializer.
function monoRenameInitAt(
  li: i32,
  fx: i32,
  target: string,
  targetTy: i32,
  nDecl: i32,
): i32 {
  const bd = nodeAt(li)
  if !(bd is LetDecl) { return 0 }
  if bd.letInit < 0 { return 0 }
  let iv = bd.letInit
  const ce = monoGeneratedCellElem(iv)
  if ce >= 0 { iv = ce }
  const fe = monoLamValueFe(iv, fx)
  if fe < 0 || fe >= nDecl || !monoWriteNamesLam(iv, fe, fx) { return 0 }
  const targetTys = monoFnTyParamTys(targetTy)
  if monoInstantiatedAny(fe) && monoSlotParamsAre(fe, targetTys) { return 0 }
  monoLastInstFe = -1
  if (monoInstanceFor(fe, monoSigPins(target), iv, -1, [], targetTys) < 0) {
    return -1
  }
  if monoLastInstFe < 0 || !monoSlotParamsAre(monoLastInstFe, targetTys) {
    emitFail(
      "monoRenameInitAt: the lambda this binding is initialized with has no instance at the signature it is called at",
    )
    return -1
  }
  // A capture cell it seeds holds that instance, so it takes that instance's type.
  if ce >= 0 && monoLastInstFe >= 0 {
    const it = monoPinSubTyOf(
      monoCellElemTyOf(bd.letInit, ce),
      fnStmts[monoLastInstFe],
    )
    if monoTyConcreteFn(it) {
      nodeTyRecord(ce, it)
      nodeTyRecord(bd.letInit, mkArrayTy(it))
    }
  }
  0
}

// Whether the written value `vx`, read in frame `fx`, names the lambda in slot `fe` through
// bindings never written after their initializer: a name an instance at another signature can
// take the place of.
function monoWriteNamesLam(vx: i32, fe: i32, fx: i32): boolean {
  if monoIdentNameOf(vx) == "" || fe < 0 || fe >= monoOrigNode.length {
    return false
  }
  // Through bindings never written after their initializer (`const d2 = c`).
  let at = vx
  let fr = fx
  let hops = 0
  while hops < 8 {
    const lf = monoReadLetFrame(at, fr)
    if lf[1] < 0 { return false }
    const d = nodeAt(lf[1])
    if !(d is LetDecl) { return false }
    if d.letType >= 0 || d.letInit < 0 { return false }
    if d.letKw != "const" && monoLetWrittenLive(lf) { return false }
    if d.letInit == monoOrigNode[fe] { return true }
    if !(nodeAt(d.letInit) is Ident) { return false }
    at = d.letInit
    fr = lf[0]
    hops = hops + 1
  }
  false
}

// Whether slot `fe` is a function whose parameters are all plain parameters.
function monoSlotIsFn(fe: i32): boolean {
  if fe < 0 || fe >= fnStmts.length { return false }
  const fn = nodeAt(fnStmts[fe])
  if !(fn is FuncDecl) { return false }
  for p in fn.fnParams {
    if !(nodeAt(p) is Param) { return false }
  }
  true
}

// Whether slot `fe`'s parameters are typed exactly `tys`, an un-annotated one as `i32`. A parameter
// whose annotation has no type is refused.
function monoSlotParamsAre(fe: i32, tys: i32[]): boolean {
  if !monoSlotIsFn(fe) { return false }
  const fn = nodeAt(fnStmts[fe])
  if !(fn is FuncDecl) { return false }
  if fn.fnParams.length != tys.length { return false }
  let i = 0
  while i < fn.fnParams.length {
    const p = nodeAt(fn.fnParams[i])
    const t = if p is Param && p.parType >= 0 { nodeTyIxOf(p.parType) } else { TY_I32 }
    if t < 0 {
      emitFail(
        "emitProgram: monomorphize: an instance's parameter annotation has no type to compare a signature with",
      )
      return false
    }
    if !tySame(t, tys[i]) { return false }
    i = i + 1
  }
  true
}

// The parameter pins one `p1,p2,;` signature spells.
function monoSigPins(sig: string): string[] {
  const out: string[] = []
  let st = 0
  let i = 0
  while i < sig.length {
    if sig[i] == ","[0] {
      out.push(sig.slice(st, i))
      st = i + 1
    }
    i = i + 1
  }
  out
}

// The refusal of a `let` whose values are called at two signatures; the binding's name goes
// between the two halves.
const MONO_BIND_SIG_PRE = "emitProgram: the reassigned function binding `"
const MONO_BIND_SIG_POST = "` holds functions called at more than one argument type — one binding holds one closure "
  + "signature, and the values written to it want two. Annotate the parameters, or "
  + "bind a separate value per type"

// Instantiate the un-annotated lambda in slot `fe` at the one closed parameter list the
// elaboration delivers it at (a callback's contextual type), so a generic its body calls is pinned
// there rather than at the hole's default (D3820). 0 when it declines, -1 on a failed mint.
function monoPinLamAtDelivery(fe: i32) {
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    const rowTy: i32[] = []
    const rowSp = monoCbFnListRowSpell(fnStmts[fe], rowTy)
    if rowSp != "" && fn.fnParams.length == 1 {
      return monoInstanceFor(fe, [rowSp], fnStmts[fe], -1, [], rowTy)
    }
    if !monoSubtreeCallsGeneric(fn.fnBody, fnStmts[fe], 0) { return 0 }
    const tys = elabLamDeliveredParams(fnStmts[fe], fn.fnParams.length)
    // A callback of a built-in `.map` / `.filter` is called at its element's own spelling; one
    // handed to a function takes that function's parameter type, keyed by its render (D3834).
    return monoPinLamAtTys(fe, tys, monoIsBuiltinCallback(fnStmts[fe]))
  }
  0
}

// The spelling of a row of the list of function lists a built-in callback `lam` walks, when its
// receiver names a binding the pass annotated at a closed `((...)=>...)[][]` (D9712), pushing
// the row's type onto `rowTy`; else "".
function monoCbFnListRowSpell(lam: i32, rowTy: i32[]): string {
  if !monoIsBuiltinCallback(lam) { return "" }
  const recv = unwrapParen(monoBuiltinCbRecv[lam] ?? -1)
  if recv < 0 || !(nodeAt(recv) is Ident) { return "" }
  const dx = identDeclOf(recv)
  if dx < 0 || dx >= P.nodes.length { return "" }
  const d = nodeAt(dx)
  if !(d is LetDecl) || d.letType < 0 { return "" }
  const lt = nodeTyIxOf(d.letType)
  if lt < 0 || lt >= T.tys.length || tyHasTyVar(lt) { return "" }
  const t = tyAt(lt)
  if !(t is TyArray) || t.aElem < 0 { return "" }
  const it = tyAt(t.aElem)
  if !(it is TyArray) || it.aElem < 0 || !(tyAt(it.aElem) is TyFunc) {
    return ""
  }
  const sp = tyNameOf(d.letType)
  if sp.length < 4 || sp.slice(sp.length - 2, sp.length) != "[]" { return "" }
  // The row is the binding's slot fact's element where the elaboration closes it.
  const st = elabSlotTyAt(dx, [], -1)
  const so = if st >= 0 && st < T.tys.length { tyAt(st) } else { null }
  const se = if so is TyArray && !tyHasTyVar(so.aElem) { monoPinAnnSpelling(so.aElem) } else { "" }
  rowTy.push(if se != "" && so is TyArray { so.aElem } else { t.aElem })
  if se != "" { se } else { sp.slice(0, sp.length - 2) }
}

// Instantiates the lambda in slot `fe` at parameter types `tys`, each pinned by its declared
// record's name, else its render (`builtin`: the spelling a built-in callback's element takes).
// 0 when the count differs or a type cannot be pinned, -1 on a failed mint.
function monoPinLamAtTys(fe: i32, tys: i32[], builtin: boolean): i32 {
  if fe < 0 || fe >= fnStmts.length { return 0 }
  const fn = nodeAt(fnStmts[fe])
  if fn is FuncDecl {
    if tys.length == 0 || tys.length != fn.fnParams.length { return 0 }
    const pins: string[] = []
    let i = 0
    while i < tys.length {
      if !monoLamPinTyPlain(tys[i], 8) { return 0 }
      let nm = ""
      if builtin {
        nm = monoLamPinName(tys[i], 8)
      } else {
        nm = structNameOfTy(tys[i])
        if nm == "" { nm = monoPinSpellShaped(tys[i]) }
      }
      if nm == "" { return 0 }
      pins.push(nm)
      i = i + 1
    }
    return monoInstanceFor(fe, pins, fnStmts[fe], -1, [], tys)
  }
  0
}

// The lambda nodes passed straight to a built-in `.map` or `.filter`, found on first use.
let monoBuiltinCbLams: {[i32]: i32} = Map()
let monoBuiltinCbLamsBuilt = false
// Per such lambda, the receiver of the call it is the callback of.
let monoBuiltinCbRecv: {[i32]: i32} = Map()

// Whether lambda node `lam` is the callback of a built-in `.map` or `.filter` call.
function monoIsBuiltinCallback(lam: i32): boolean {
  if !monoBuiltinCbLamsBuilt {
    monoBuiltinCbLamsBuilt = true
    monoBuiltinCbLams = Map()
    monoBuiltinCbRecv = Map()
    const stack: i32[] = []
    for st in monoProgStmts { stack.push(st) }
    while stack.length > 0 {
      const ix = stack.pop() ?? -1
      if ix >= 0 && ix < P.nodes.length {
        const n = nodeAt(ix)
        if n is Call && n.callFn >= 0 {
          const cf = nodeAt(n.callFn)
          if cf is Member {
            if (
              (cf.memProp == "map" || cf.memProp == "filter")
              && n.callArgs.length == 1
            ) {
              monoBuiltinCbLams[unwrapParen(n.callArgs[0])] = 1
              monoBuiltinCbRecv[unwrapParen(n.callArgs[0])] = cf.memObj
            }
          }
        }
        for k in nodeChildren(ix) { stack.push(k) }
      }
    }
  }
  (monoBuiltinCbLams[lam] ?? 0) == 1
}

// The annotation spelling a `monoLamPinTyPlain` type pins a lambda parameter at: a declared
// record by its name at any list depth, and a generic record's instance by its application,
// so the element keeps the name its annotation would give it (D3834).
function monoLamPinName(ty: i32, depth: i32): string {
  if ty < 0 || ty >= T.tys.length || depth <= 0 { return "" }
  const t = tyAt(ty)
  if t is TyArray {
    const en = monoLamPinName(t.aElem, depth - 1)
    if en == "" { return "" }
    return en + "[]"
  }
  const sn = structNameOfTy(ty)
  if sn != "" { return sn }
  // A generic record's instance by its application (`Box<A>`), which names its arguments.
  const ga = genAppNameOfTy(ty)
  if ga != "" { return ga }
  monoPinSpellShaped(ty)
}

// Whether `ty` is a primitive, a record, or a list of those: the types whose name alone is
// the pin. A literal union, a value union, a nullable or a function value carries a rep the
// name does not, so a lambda at one keeps the template path.
function monoLamPinTyPlain(ty: i32, depth: i32): boolean {
  if ty < 0 || ty >= T.tys.length || depth <= 0 { return false }
  const t = tyAt(ty)
  match t {
    TyPrim | TyObj => {
      return true
    }
    TyArray => {
      return monoLamPinTyPlain(t.aElem, depth - 1)
    }
    TyLit | TyUnion | TyNullable | TyFunc | TyMap | TyVar | TyNeg | TyErr => {}
  }
  false
}

// Whether the subtree at `ix`, read in frame `ctx`, calls a named generic or hole function by
// name. A nested function is its own slot and is not entered. False past the depth floor.
function monoSubtreeCallsGeneric(ix: i32, ctx: i32, depth: i32): boolean {
  if ix < 0 || ix >= P.nodes.length || depth > 256 { return false }
  const n = nodeAt(ix)
  if n is FuncDecl { return false }
  if n is Call && n.callFn >= 0 {
    const cf = nodeAt(n.callFn)
    if cf is Ident {
      const fe = fnIndexOfInScopeAt(
        sidOfNode(n.callFn),
        cf.identName,
        ctx,
        n.callFn,
      )
      if (
        fe >= 0
        && fe < monoGen.length
        && monoGen[fe] == 1
        && !criFnIsAnonLambda(fe)
      ) {
        return true
      }
    }
  }
  for k in nodeChildren(ix) {
    if monoSubtreeCallsGeneric(k, ctx, depth + 1) { return true }
  }
  false
}

// Whether node `ix` lies in the body of function node `fx` (the program, for -1), or in the
// body of a function lifted out of it at any depth.
function monoFrameHolds(fx: i32, ix: i32): boolean {
  if fx < 0 { return monoProgHolds(ix) }
  const body = monoNestedBodyOf(fx)
  if body < 0 { return false }
  if monoSubtreeHolds(body, ix) { return true }
  for k in monoLiftedDescendants(fnStmtsPosOf(fx)) {
    const kb = monoNestedBodyOf(fnStmts[k])
    if kb >= 0 && monoSubtreeHolds(kb, ix) { return true }
  }
  false
}

// The `fnStmts` positions of the functions lifted out of the one at `slot`, at any depth,
// parents before children; read off the frame child index.
function monoLiftedDescendants(slot: i32): i32[] {
  const out: i32[] = []
  if slot < 0 { return out }
  if fnChildHead.length != fnStmts.length { buildFnChildIndex() }
  const stack: i32[] = [slot]
  while stack.length > 0 {
    const p = stack.pop() ?? -1
    if p >= 0 && p < fnChildHead.length {
      let c = fnChildHead[p]
      while c >= 0 && c < fnChildNext.length && out.length <= fnStmts.length {
        out.push(c)
        stack.push(c)
        c = fnChildNext[c]
      }
    }
  }
  out
}

// The built-closure row: one entry per closure mono builds, keyed by its creation site, the
// instance whose body holds that site (-1 for none) and the closed signature it is built at,
// answering the emitted slot. Columns are parallel; `monoCadRowWrite` is the only writer.
let cadSite: i32[] = []
let cadInst: i32[] = []
let cadSig: i32[] = []
let cadFe: i32[] = []
// The row entries of each creation site, so a write scans only its own site's.
let cadBySite: {[i32]: i32[]} = Map()
// Writes whose key already answered another slot, writes whose signature did not close, and
// writes at no instance for a site declared inside a function mono instances.
let cadConflicts = 0
let cadUnkeyed = 0
let cadInstMissed = 0
// Each built slot's closed signature, minted once; -1 where it does not close.
let cadFeSig: {[i32]: i32} = Map()
// The instance being walked when each per-instance lambda clone is minted.
let cadCloneInst: {[i32]: i32} = Map()
// The value node a delivery asks `monoMakeInstance` to build a closure for, or -1; and the
// delivery node standing for a value `monoInstanceFor` is handed as a fresh read, or -1.
let cadDelivery = 0 - 1
let cadDeliveryAt = 0 - 1
// Whether the instance being built has a callback baked in, so what it mints is a call's
// specialization rather than a closure at a signature.
let cadInBaked = false
// The instance each build or walk in progress is, innermost last: its function node, -1 for
// a body in no instance, or -3 while a build has not yet made its node. Writes made pending are
// listed, so the build patches them once the node exists.
let cadWalkFn: i32[] = []
let cadPendRows: i32[] = []
let cadPendClones: i32[] = []
// The record type each elaboration parameter key is pinned at.
let monoBundleKeyTys: {[i32]: i32} = Map()

// The row's size, its conflicting writes and its unkeyed writes, for a self-check.
export function cadRowCount(): i32 { cadFe.length }

export function cadRowConflicts(): i32 { cadConflicts }

export function cadRowUnkeyed(): i32 { cadUnkeyed }

export function cadRowInstMissed(): i32 { cadInstMissed }

function cadRowReset() {
  cadSite = []
  cadInst = []
  cadSig = []
  cadFe = []
  cadBySite = Map()
  cadConflicts = 0
  cadUnkeyed = 0
  cadInstMissed = 0
  cadFeSig = Map()
  cadCloneInst = Map()
  cadDelivery = 0 - 1
  cadDeliveryAt = 0 - 1
  cadInBaked = false
  cadWalkFn = []
  cadPendRows = []
  cadPendClones = []
  monoBundleKeyTys = Map()
  bundleReset()
  0
}

// The instance the build or walk in progress is (`cadWalkFn`'s top), or -1 outside every one.
function cadInstTop(): i32 {
  if cadWalkFn.length > 0 { cadWalkFn[cadWalkFn.length - 1] } else { -1 }
}

// The function node of the instance function node `fnIx`'s body is read under, or -1: the row's
// instance column, as a reader in `fnIx` asks it.
export function monoCadInstOf(fnIx: i32): i32 {
  const slot = elabInstSlotAt(fnStmtsPosOf(fnIx))
  if slot >= 0 && slot < fnStmts.length { fnStmts[slot] } else { -1 }
}

// Gives the pending row writes and clone notes their instance `nfn`, once its build made it.
function cadPatchPending(nfn: i32) {
  for r in cadPendRows {
    if cadInst[r] == -3 { cadInst[r] = nfn }
  }
  cadPendRows = []
  for c in cadPendClones {
    if (cadCloneInst.get(c) ?? -1) == -3 { cadCloneInst[c] = nfn }
  }
  cadPendClones = []
  0
}

// The row's one writer: records that slot `fe` is the closure built for (`site`, `inst`, `sig`),
// the caller naming the instance. A key already answering another slot counts a conflict and
// keeps the first answer; -1 `sig` is unkeyed; -1 `inst` at a site inside an instanced function
// is counted, since a reader in an instance's body asks for that instance.
function monoCadRowWrite(site: i32, inst: i32, sig: i32, fe: i32) {
  if site < 0 || fe < 0 { return 0 }
  if sig < 0 {
    cadUnkeyed = cadUnkeyed + 1
    return 0
  }
  if inst == -1 && ftWithinInstancedFn(site) {
    cadInstMissed = cadInstMissed + 1
  }
  const rows = cadBySite.get(site) ?? []
  for r in rows {
    if cadInst[r] == inst && monoCadSigSame(cadSig[r], sig) {
      if cadFe[r] != fe { cadConflicts = cadConflicts + 1 }
      return 0
    }
  }
  if inst == -3 { cadPendRows.push(cadFe.length) }
  rows.push(cadFe.length)
  cadBySite[site] = rows
  cadSite.push(site)
  cadInst.push(inst)
  cadSig.push(sig)
  cadFe.push(fe)
  0
}

// The lambda dispatch arm call `monoWalkIdentCall` is instancing and its frame, or -1: the
// instance its callee takes is the one this call reaches, not one a walk of its body mints.
let monoArmCall = -1
let monoArmCtx = -1

// Records slot `fe`, the instance callee `calleeIx` takes, in the row when it is the arm being
// instanced: per frame, at the signature the arm is called at there. Once per arm.
function monoArmRowNote(calleeIx: i32, fe: i32) {
  if monoArmCall < 0 || fe < 0 { return 0 }
  const c = nodeAt(monoArmCall)
  if !(c is Call) || c.callFn != calleeIx { return 0 }
  const sig = elabArmSigAt(monoArmCall, monoArmCtx)
  monoCadRowWrite(calleeIx, monoCadInstOf(monoArmCtx), sig, fe)
  monoArmCall = -1
  0
}

// Whether two row signatures are one: the same type, with each tagged set the same set.
function monoCadSigSame(a: i32, b: i32): boolean {
  if !tySame(a, b) { return false }
  const fa = tyAt(a)
  const fb = tyAt(b)
  if fa is TyFunc {
    if fb is TyFunc {
      if fnTagSetOfTy(fa.fnRet) != fnTagSetOfTy(fb.fnRet) { return false }
      let i = 0
      while i < fa.fnParamTypes.length && i < fb.fnParamTypes.length {
        if (
          fnTagSetOfTy(fa.fnParamTypes[i])
          != fnTagSetOfTy(fb.fnParamTypes[i])
        ) {
          return false
        }
        i = i + 1
      }
    }
  }
  true
}

// The closed signature slot `fe` is built at, from its parameter types `ps` and result `ret`,
// minted on the slot's first ask; -1 where one of them is open.
function monoCadSigOf(fe: i32, ps: i32[], ret: i32): i32 {
  const have = cadFeSig.get(fe) ?? 0 - 2
  if have > -2 { return have }
  let ok = elabSigTyClosed(ret)
  for p in ps {
    if !elabSigTyClosed(p) { ok = false }
  }
  const s = if ok { mkFuncTy(ps.slice(0), ret) } else { -1 }
  cadFeSig[fe] = s
  s
}

// Whether arena node `d` is an anonymous lambda, whose value is a closure built where it is
// written.
function monoCadIsLam(d: i32): boolean {
  if d < 0 || d >= P.nodes.length { return false }
  const n = nodeAt(d)
  if n is FuncDecl {
    return n.fnName.length >= 8 && n.fnName.slice(0, 8) == "__lambda"
  }
  false
}

// Whether an instance keyed by callbacks `cbFnNames` has one baked in.
function monoCadBaked(cbFnNames: string[]): boolean {
  for cb in cbFnNames {
    if cb != "" { return true }
  }
  false
}

// An instance of template `origFe` at slot `fe`, keyed `key`, as the closure built for its
// lambda or for the delivery `delivery` read in instance `encl`; 0, recording it in the row.
// An instance with a callback baked in (`cbFnNames`) is a call's specialization, not a closure.
function monoCadNoteInstance(
  origFe: i32,
  fe: i32,
  delivery: i32,
  encl: i32,
  cbFnNames: string[],
) {
  if monoCadBaked(cbFnNames) { return 0 }
  const tpl = monoOrigNode[origFe]
  const lam = monoCadIsLam(tpl)
  if !lam && delivery < 0 { return 0 }
  // A lambda cloned inside a baked instance's body (-2) is that specialization's too. One never
  // cloned is the instance of the frame its slot hangs under.
  const pf = if fe < fnParent.length { fnParent[fe] } else { -1 }
  const lamInst = if !lam { -1 } else if cadCloneInst.has(tpl) { cadCloneInst.get(tpl) ?? -1 } else if pf >= 0 && pf < fnStmts.length { monoCadInstOf(fnStmts[pf]) } else { -1 }
  if lamInst < -1 { return 0 }
  let sig = cadFeSig.get(fe) ?? 0 - 2
  if sig < -1 {
    let ret = elabRetOf(monoInstEk.get(fe) ?? -1)
    if ret < 0 { ret = monoCadCheckedRet(tpl) }
    sig = monoCadSigOf(fe, monoInstPins.get(fe) ?? [], ret)
  }
  if lam { return monoCadRowWrite(elabSrcDecl(tpl), lamInst, sig, fe) }
  monoCadRowWrite(delivery, encl, sig, fe)
}

// A lambda template cloned per enclosing instance into slot `slot`: notes the instance being
// walked (-2 inside a baked instance), and records the clone in the row where its signature
// is already closed.
function monoCadNoteLamClone(clone: i32, slot: i32) {
  const inst = if cadInBaked { 0 - 2 } else { cadInstTop() }
  cadCloneInst[clone] = inst
  if inst == -3 { cadPendClones.push(clone) }
  if inst < -1 || !monoCadIsLam(clone) || monoIsGenericDecl(clone) { return 0 }
  const t = nodeTyIxOf(clone)
  let sig = -1
  if t >= 0 && t < T.tys.length && elabSigTyClosed(t) {
    if tyAt(t) is TyFunc { sig = t }
  }
  cadFeSig[slot] = sig
  monoCadRowWrite(elabSrcDecl(clone), inst, sig, slot)
}

// The result `d`'s checked function type names, where that is closed (a lambda returning
// nothing, which the elaboration leaves without a result); else -1.
function monoCadCheckedRet(d: i32): i32 {
  const t = nodeTyIxOf(d)
  if t < 0 || t >= T.tys.length { return -1 }
  const ft = tyAt(t)
  if ft is TyFunc {
    if elabSigTyClosed(ft.fnRet) { return ft.fnRet }
  }
  -1
}

// Builds, for each delivery the tag decision recorded as a closure from a tagged set
// (`fnCloCoerceTyIx`), the member's instance at the destination's parameters, banked for the
// emitter (`monoCloCoerceFe`); -1 when one cannot be built (D14884).
function monoCloCoerceBuild(): i32 {
  let ix = 0
  while ix < fnCloCoerceTyIx.length {
    const t = fnCloCoerceTyIx[ix]
    if t >= 0 {
      // A parameter read in a generic body carries its set only at the instance, recorded here.
      let cs = fnTagSetOfTy(nodeTyIxOf(ix))
      if cs < 0 { cs = fnCloCoerceSetAt.get(ix) ?? -1 }
      const fes: i32[] = []
      const fail = "emitProgram: monomorphize: a function delivered to a declared function type has no instance there"
      // A plain member is its own closure; a generic one's instance is at the destination's
      // parameters.
      for d in fnTagMembers(cs) {
        const gfe = fnStmtsPosOf(d)
        if (
          gfe >= 0
          && gfe < monoGen.length
          && monoGen[gfe] != 1
          && tySame(nodeTyIxOf(d), t)
        ) {
          fes.push(gfe)
          continue
        }
        const pnames: string[] = []
        if (
          gfe < 0
          || gfe >= monoGen.length
          || monoGen[gfe] != 1
          || monoConcreteFnTyName(t) == ""
        ) {
          return emitFailAt(fail, ix)
        }
        const tf = tyAt(t)
        if tf is TyFunc {
          for p in tf.fnParamTypes { pnames.push(monoPinSpellShaped(p)) }
        }
        // A fresh read stands for the member, so the pins are the destination's.
        const rd = mkIdent(monoSlotName(gfe), nodePos(ix))
        monoLastInstFe = -1
        const none: i32[] = []
        cadDeliveryAt = ix
        const made = monoInstanceFor(
          gfe,
          pnames,
          rd,
          t,
          none,
          monoFnTyParamTys(t),
        )
        cadDeliveryAt = -1
        if made < 0 { return -1 }
        if monoLastInstFe < 0 { return emitFailAt(fail, ix) }
        fes.push(monoLastInstFe)
      }
      if fes.length == 0 { return emitFailAt(fail, ix) }
      monoCloCoerceFe[ix] = fes[0]
      if fes.length > 1 { monoCloCoerceSetFes[ix] = fes }
    }
    ix = ix + 1
  }
  0
}

// The monomorphization pass: snapshot which lifted functions are generic, then walk every
// top-level statement in program order and every non-generic function body; instance
// bodies are walked as they are created. Usage-gated: a program with no generic
// declaration and no concrete higher-order function returns immediately.
export function monomorphize(stmts: i32[]) {
  monoTopStmts = stmts
  monoFnValReads = Map()
  monoFnValReadsBuilt = false
  monoCloCoerceFe = Map()
  monoCloCoerceSetFes = Map()
  monoClashLits = []
  monoCallTpl = Map()
  monoLamCallCallees = []
  monoProgLamNames = []
  monoBodyDeclStamp = 0 - 1
  monoGen = []
  monoOrigNode = []
  fnPosIndexDrop()
  monoKeys = []
  monoTypedKeys = Map()
  monoInstEk = Map()
  instKeyReset()
  monoInstPins = Map()
  monoInstOrig = []
  monoInstName = []
  monoInstFe = []
  monoParamPinTy = Map()
  monoAnonParamPinTy = Map()
  monoFramedPushes = Map()
  monoBindCalled = Map()
  monoRetDeliveredAt = Map()
  monoCellCoercedSig = Map()
  monoHoleLamSlots = Map()
  monoBuiltinCbLamsBuilt = false
  monoDeliveredArgs = []
  monoStubSlots = []
  monoRetCopyReads = []
  mfrInertValues = []
  monoHeldInert = []
  monoArgInert = []
  elabValueSlotReset()
  vrGenericCandClear()
  monoReachStmts = []
  monoReachRoots = []
  monoInertCalled = []
  monoInertArgAt = []
  monoInertArgFe = []
  monoFieldReadTys = Map()
  monoLastInstFe = -1
  monoFnFieldTwinRow = Map()
  monoTwoListRet = Map()
  monoSubTablesReset()
  monoGradualObjLits = Map()
  monoGradualObjList = []
  monoGradualObjFrame = Map()
  monoSupersededObjTys = []
  monoGradualAsScalar = Map()
  monoGradualRetPinned = false
  monoActiveDepth = []
  monoProgStmts = stmts
  monoRegisterElabJoinRows()
  monoProgHeldStamp = 0 - 1
  monoProgTopDeep = false
  monoProgNamesStamp = 0 - 1
  monoProgTop = []
  monoProgNames = Map()
  monoProgNamesDeep = false
  monoNoRename = []
  monoBundleReads = []
  monoArmCall = -1
  monoArmCtx = -1
  monoBakeSpecK = -1
  monoSpecGoK = -1
  monoAliasCallDecl = Map()
  monoRetWidenFns = Map()
  monoWrittenLetHanded = Map()
  monoDeclWrites = Map()
  monoWriteOrder = []
  monoCellWrites = Map()
  monoFieldWrites = Map()
  monoElemWrites = Map()
  monoListStores = Map()
  monoLamCloneTmpl = Map()
  monoLetWritesSeen = 0
  monoLetWritesExtend()
  // The index follows the table it answers for, at the write and not at a build point:
  // between the two there is no reader, so `monoModuleLetOf` cannot see an empty column.
  monoProgLetBySid = []
  let mi = 0
  while mi < stmts.length {
    const ms = nodeAt(stmts[mi])
    if ms is LetDecl {
      if ms.letType < 0 && ms.letInit >= 0 {
        const mv = nodeAt(unwrapParen(ms.letInit))
        if mv is FuncDecl && monoIsGenericDecl(unwrapParen(ms.letInit)) {
          monoNoteName(monoProgLamNames, ms.letName)
        }
      }
      // First occurrence wins: a later module binding sharing the name keeps the slot.
      const msid = sidOfNode(stmts[mi])
      if sidArrGet(monoProgLetBySid, msid) < 0 {
        sidArrPut(monoProgLetBySid, msid, stmts[mi])
      }
    }
    mi = mi + 1
  }
  monoLamPinned = []
  monoLamShared = []
  monoNamedTmplNode = []
  monoNamedTmplSlot = []
  let any = false
  let fe = 0
  while fe < fnStmts.length {
    monoOrigNode.push(fnStmts[fe])
    if monoIsGenericDecl(fnStmts[fe]) {
      monoGen.push(1)
      any = true
    } else {
      monoGen.push(0)
    }
    fe = fe + 1
  }
  // The pass also runs for callback specialization of a concrete higher-order function.
  // Gated on the program actually defining one, so a generic-free, HOF-free program (the
  // compiler itself) skips the pass entirely.
  if !any {
    if monoHasConcreteHOFParam() { any = true }
  }
  if !any { return 0 }
  if monoShadowRename(fnStmts.length) < 0 { return -1 }
  monoFlowReads(stmts)
  monoWrittenLetGenSnap()
  monoInertReach(stmts)
  if monoSlotRecordsApply() < 0 { return -1 }
  // The declarations before the walk: a clone that keeps holes pads `monoGen` past the instances
  // the walk appends, which are walked on creation and must not be walked again (D15601).
  const nPre = monoGen.length
  // Top-level statements first, in source order (global inits + start stmts).
  let i = 0
  while i < stmts.length {
    const s = nodeAt(stmts[i])
    if s is FuncDecl {
    } else if s is LetDecl {
      // Walk the `LetDecl` node, not just its init, so the annotated-function-typed
      // binding materialization in `monoWalk`'s `LetDecl` arm reaches a top-level binding
      // too; the arm still recurses into the init.
      if monoWalk(stmts[i], -1) < 0 { return -1 }
    } else if nodeIsTypeDecl(stmts[i]) {
    } else if s is UnionDecl {
    } else {
      if monoWalk(stmts[i], -1) < 0 { return -1 }
    }
    i = i + 1
  }
  for k in mfrKeptTop {
    if monoWalk(k, -1) < 0 { return -1 }
  }
  // Then every non-generic lifted function's body. A generic original's body is only ever
  // walked through an instance; an instance appended during this loop extends `fnStmts`,
  // but its body is walked on creation — `monoGen` is frozen at the pre-pass length.
  let fe2 = 0
  const nDecl = monoGen.length
  while fe2 < nPre {
    if monoGen[fe2] == 0 {
      if monoWalkFnBody(fnStmts[fe2]) < 0 { return -1 }
    }
    fe2 = fe2 + 1
  }
  if monoCloCoerceBuild() < 0 { return -1 }
  // Lambdas the flow table pins come first: the table's classes already span every binding a
  // lambda is written into, so one pass settles a chain of them (D3851).
  let pe = 0
  while pe < nDecl {
    if monoGen[pe] == 1 && criFnIsAnonLambda(pe) && !monoInstantiatedAny(pe) {
      if monoPinLamFromFlow(pe) < 0 { return -1 }
    }
    pe = pe + 1
  }
  // The lambda half of that loop. `monoGen == 1` covers two carriers alike only on paper: a
  // named generic is reached only through `monoInstantiate`, while a lifted anonymous lambda
  // is instantiated only when a call goes through its own binding. Walked here, after the
  // two loops, because instantiation is settled only once every call site has been seen.
  let fe3 = 0
  while fe3 < nDecl {
    if monoGen[fe3] == 1 && criFnIsAnonLambda(fe3) {
      if !monoInstantiatedAny(fe3) {
        if monoPinLamAtDelivery(fe3) < 0 { return -1 }
        // `monoInstanceFor` declines silently on a boundary it cannot reproduce, so the
        // walk is gated on the outcome rather than on having tried — a declined pin
        // still needs its body walked.
        if !monoInstantiatedAny(fe3) {
          if monoWalkFnBody(fnStmts[fe3]) < 0 { return -1 }
        }
      }
    }
    fe3 = fe3 + 1
  }
  const prc = monoPruneTemplates(nDecl)
  if prc < 0 { return prc }
  // Each un-annotated binding the walk left open takes the closed type the elaboration or its
  // initializer gives it.
  // Keyed by a walk of every body, not the write index: an instance clone's nodes postdate it.
  const bodyKeys: i32[] = __array_new__(P.nodes.length, -1)
  let bp = 0
  while bp < fnStmts.length {
    const bf = fnStmts[bp]
    const bd = if bf >= 0 && bf < P.nodes.length { nodeAt(bf) } else { null }
    const bk = if bd is FuncDecl { elabKeyAt(bf) } else { -1 }
    if bd is FuncDecl && bk >= 0 {
      const stack: i32[] = [bd.fnBody]
      while stack.length > 0 {
        const x = stack.pop()
        if x >= 0 && x < P.nodes.length && !(nodeAt(x) is FuncDecl) {
          bodyKeys[x] = bk
          for c in nodeChildren(x) { stack.push(c) }
        }
      }
    }
    bp = bp + 1
  }
  let ai = 0
  while ai < P.nodes.length {
    if monoBindingAdoptInit(ai, bodyKeys[ai]) < 0 { return -1 }
    ai = ai + 1
  }
  prc
}

// Records on node `i`, when it is an un-annotated binding the walk left open, the closed type the
// elaboration gives it at key `k`, else the one its initializer holds. Returns 0, or the refusal when the two
// disagree.
function monoBindingAdoptInit(i: i32, k: i32) {
  const d = nodeAt(i)
  if !(d is LetDecl) || d.letType >= 0 || d.letInit < 0 { return 0 }
  const bt = nodeTyIxOf(i)
  const it = monoInitHeldTy(d.letInit)
  if bt < 0 || it < 0 || !tyHasTyVar(bt) || tyHasTyVar(it) { return 0 }
  // The binding's type is the elaboration's where it closes there; the initializer's held type
  // answers only where it does not, and a disagreement is refused, never picked silently.
  const et = elabNodeTy(i, k)
  if (
    et >= 0
    && et < T.tys.length
    && elabTyClosed(et, 16)
    && !tyReachesHole(et, 16)
  ) {
    // A captured binding holds a one-element cell of the value the elaboration types.
    const cl = cboxCellLits[d.letInit]
      ?? (cboxCellLits[nodeSrc[d.letInit] ?? -1] ?? -1)
    const io = tyAt(it)
    if cl >= 0 && io is TyArray && tySame(io.aElem, et) {
      if monoSameTyCtor(bt, it) { nodeTyRecord(i, it) }
      return 0
    }
    if monoSameTyCtor(bt, it) && !tySame(et, it) {
      return emitFailAt(
        "emitProgram: internal: binding `"
          + d.letName
          + "` holds another type than the elaboration's",
        i,
      )
    }
    if monoSameTyCtor(bt, et) { nodeTyRecord(i, et) }
    return 0
  }
  if monoSameTyCtor(bt, it) { nodeTyRecord(i, it) }
  0
}

// The type initializer `init` holds: its recorded type, or for a read of a binding this pass already
// closed where the checker left the read open, that binding's type, recorded on the read.
function monoInitHeldTy(init: i32): i32 {
  const it = nodeTyIxOf(init)
  if it < 0 || !tyHasTyVar(it) { return it }
  const x = unwrapParen(init)
  if x < 0 || !(nodeAt(x) is Ident) { return it }
  const dl = identDeclOf(x)
  if dl < 0 || dl >= P.nodes.length || !(nodeAt(dl) is LetDecl) { return it }
  const dt = nodeTyIxOf(dl)
  if dt < 0 || tyHasTyVar(dt) || !monoSameTyCtor(it, dt) { return it }
  nodeTyRecord(x, dt)
  if x != init { nodeTyRecord(init, dt) }
  dt
}

// Whether types `a` and `b` have the same constructor, under any matching nullable layers: a
// function-typed binding never takes a record as its type, at any depth (a bundle is its rep).
function monoSameTyCtor(a: i32, b: i32): boolean {
  const x = tyAt(a)
  const y = tyAt(b)
  if x is TyNullable && y is TyNullable {
    return monoSameTyCtor(x.nInner, y.nInner)
  }
  (x is TyArray && y is TyArray)
    || (x is TyFunc && y is TyFunc)
    || (x is TyMap && y is TyMap)
    || (x is TyObj && y is TyObj)
}

// `monomorphize`'s last stage, over the first `nDecl` slots: retypes the cells an instantiated
// hole lambda seeds, then stubs every template no instance replaced and nothing reaches. Refuses
// an exported generic and an unpinned lambda stored as an element; returns 0 or that failure.
function monoPruneTemplates(nDecl: i32) {
  // Prune the un-instantiated `<T>` generics into a concrete no-op stub (same name, no
  // params, void body). The first instance replaces the slot, so a slot still equal to its
  // captured original has no caller; importing a module for some of its generics pulls in
  // all of them, so this is routine.

  // An exported `<T>` is a reject, not a stub: the stub keeps the name, so the export
  // section would publish a `() -> void` ABI. Three gates narrow the hole half — not an
  // anon lambda, not exported, and not used as a value.
  const cndFe: i32[] = []
  const cndNm: string[] = []
  let gc = 0
  while gc < nDecl {
    if fnStmts[gc] == monoOrigNode[gc] {
      const cfn = nodeAt(fnStmts[gc])
      if cfn is FuncDecl {
        if cfn.fnTyParams.length == 0 && monoGen[gc] == 1 && cfn.fnName != "" {
          if !criFnIsAnonLambda(gc) {
            if !monoNameIsExported(cfn.fnName) {
              cndFe.push(gc)
              cndNm.push(cfn.fnName)
            }
          }
        }
      }
    }
    gc = gc + 1
  }
  const cndVal = monoNamesUsedAsValue(cndNm, false)
  const deadLams = monoUnreadLamSlots(nDecl)
  // A capture cell an instantiated hole lambda seeds takes the instance's function type. One no
  // call or peer pinned, stored as a list element or in such a cell, has no type for the element
  // but the hole's `i32` default, so it is refused rather than stored there (D3851).
  if monoBindingsAtPin(nDecl) < 0 { return -1 }
  let pass = 0
  while pass < 2 {
    let rl = 0
    while rl < nDecl {
      if (
        monoGen[rl] == 1
        && criFnIsAnonLambda(rl)
        && fnStmts[rl] != monoOrigNode[rl]
      ) {
        monoRetypeLamCells(rl, pass == 1)
      }
      rl = rl + 1
    }
    pass = pass + 1
  }
  let sl = 0
  while sl < nDecl {
    if monoGen[sl] == 1 && criFnIsAnonLambda(sl) {
      const unpinned = fnStmts[sl] == monoOrigNode[sl]
        && !monoInstantiatedAny(sl)
      if unpinned && monoLamStoredAsElement(sl) {
        return emitFail(
          "emitProgram: a lambda with an un-annotated parameter is stored in a list, or in a variable a nested function writes, and no call fixes its parameter types — annotate its parameters",
        )
      }
    }
    sl = sl + 1
  }

  // `monoMemberPropNames`, built the first time `monoNestedFnDead` consults it.
  const memberProps: {[string]: i32}[] = []
  // A slot the built-closure row delivers is called through that closure (D15596).
  const built: {[i32]: boolean} = Map()
  for f in cadFe { built[f] = true }
  let gp = 0
  while gp < nDecl {
    if fnStmts[gp] == monoOrigNode[gp] {
      const gfn = nodeAt(fnStmts[gp])
      if gfn is FuncDecl {
        let prune = false
        if gfn.fnTyParams.length > 0 {
          // The slot is still the captured template and is the one the export section
          // resolves to, so the stub below would publish its name at `() -> void`.
          // Reject loudly instead, under the public name.
          let isAbiSlot = false
          if monoNameIsExported(gfn.fnName) {
            if monoFirstFnIndexNamed(gfn.fnName) == gp { isAbiSlot = true }
          }
          if isAbiSlot {
            const pubNm = monoExportPublicName(gfn.fnName)
            // The checker's wording (D3817), for an export the checker passes because a read of
            // it may reach a call, when none instances it (D12302).
            let tp = "T"
            if gfn.fnTyParams.length > 0 { tp = gfn.fnTyParams[0] }
            return emitFail(
              "emitProgram: exported function `"
                + pubNm
                + "` is generic over `"
                + tp
                + "` and nothing in the program calls it; the host calls it, so its signature must be explicit. Give its parameters concrete types, or export a concrete wrapper",
            )
          }
          prune = true
        } else {
          let ci = 0
          while ci < cndFe.length {
            if cndFe[ci] == gp && cndVal[ci] == 0 { prune = true }
            // Every value of a hole function no call instances is one nothing calls, so the
            // stub serves it as it does an uncalled `<T>` generic's (D6830).
            if cndFe[ci] == gp && cndVal[ci] == 2 && !monoInstantiatedAny(gp) {
              prune = true
            }
            ci = ci + 1
          }
          // A hole lambda no call pinned and no read reaches has nothing to lower at (D3832).
          if !prune && i32ListHas(deadLams, gp) { prune = true }
          // One no call goes through, however it is stored, never runs either (D12301).
          if (
            !prune
            && criFnIsAnonLambda(gp)
            && monoGen[gp] == 1
            && !monoInstantiatedAny(gp)
            && monoFrameNameUnread(gp, "", true)
          ) {
            prune = true
          }
          // A nested function nothing names never runs, and its calls through a binding may
          // take a signature the live ones do not (D3864).
          if (
            !prune
            && !(built.get(gp) ?? false)
            && monoNestedFnDead(gp, memberProps)
          ) {
            prune = true
          }
          // D426 — the lambda template, the `<T>` arm above one frame down. Each
          // instance mints its own copy with the pin substituted. Gate (1) is inverted
          // here, the property being decided by the annotation rather than by the slot.
          if !prune {
            if criFnIsAnonLambda(gp) && monoLamSlotIsHoleTemplate(gp) {
              const hnd = fnStmts[gp]
              if (
                i32ListHas(monoLamPinned, hnd)
                && !i32ListHas(monoLamShared, hnd)
              ) {
                prune = true
              }
            }
          }
          if !prune {
            if criFnIsAnonLambda(gp) && monoLamSlotIsTyParamTemplate(gp) {
              // Two ledgers, both load-bearing: stub the template only when a clone
              // actually replaced it, or when no enclosing frame is instantiated. A
              // declined template is one an instance body still calls by name.
              const lnd = fnStmts[gp]
              if !i32ListHas(monoLamShared, lnd) {
                if i32ListHas(monoLamPinned, lnd) { prune = true }
                else if !monoLamFrameInstantiated(gp) { prune = true }
              }
            }
          }
        }
        if prune {
          const noTP: string[] = []
          const noPs: i32[] = []
          buildFnMapNoteFnSlotWrite()
          monoStubSlots.push(gp)
          fnStmts[gp] = mkFunc(
            gfn.fnName,
            noTP,
            noPs,
            -1,
            mkBlock([], gfn.pos),
            gfn.pos,
          )
        }
      }
    }
    gp = gp + 1
  }
  monoInertArgsStubbed()
}

// Whether the nested function or `const`-bound lambda in slot `gp` is never called: it, or a
// function between it and its module-scope function, is not named in its parent's body, and no
// member call anywhere spells that name, which a `self`-function call would. A module-scope
// function's own deadness is not asked: a specialised copy shares its nested slots.
function monoNestedFnDead(gp: i32, memberProps: {[string]: i32}[]): boolean {
  let slot = gp
  let guard = 0
  while slot >= 0 && slot < fnParent.length && guard <= fnStmts.length {
    const ps = fnParent[slot]
    if ps < 0 || ps >= fnStmts.length { return false }
    const fx = fnStmts[slot]
    const pb = monoNestedBodyOf(fnStmts[ps])
    if pb < 0 { return false }
    let nm = ""
    const f = nodeAt(fx)
    if f is FuncDecl { nm = f.fnName }
    if criFnIsAnonLambda(slot) {
      nm = monoConstNameOfInit(pb, fx)
    } else {
      if memberProps.length == 0 { memberProps.push(monoMemberPropNames()) }
      if (memberProps[0][nm] ?? 0) == 1 { return false }
    }
    if nm == "" { return false }
    if !monoSubtreeNamesIdent(pb, nm, 0) { return true }
    slot = ps
    guard = guard + 1
  }
  false
}

// The property names member accesses spell anywhere in the program; one walk.
function monoMemberPropNames(): {[string]: i32} {
  const out: {[string]: i32} = Map()
  const stack: i32[] = []
  for st in monoProgStmts { stack.push(st) }
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      const pn = monoMemberPropOf(ix)
      if pn != "" { out[pn] = 1 }
      for k in nodeChildren(ix) { stack.push(k) }
    }
  }
  out
}

// The property member access `ix` spells, or "" for any other node.
function monoMemberPropOf(ix: i32): string {
  const n = nodeAt(ix)
  if n is Member { return n.memProp }
  monoOptMemberPropOf(ix)
}

// The property optional member access `ix` spells, or "" for any other node.
function monoOptMemberPropOf(ix: i32): string {
  const n = nodeAt(ix)
  if n is OptMember { return n.omProp }
  ""
}

// Whether the lambda in slot `fe`, bound by an un-annotated `const`, is named as an element of
// a list or capture cell in its enclosing frame, and every such list is bound to a name that is
// unread (`monoFrameNameUnread`): no call can go through it.
function monoLamStoredAsElement(fe: i32): boolean {
  let pf = -1
  if fe < fnParent.length { pf = fnParent[fe] }
  const stack: i32[] = []
  let frame = -1
  if pf >= 0 && pf < fnStmts.length { frame = fnStmts[pf] }
  if pf >= 0 && pf < fnStmts.length {
    const b = monoNestedBodyOf(fnStmts[pf])
    if b < 0 { return false }
    stack.push(b)
  } else {
    for st in monoProgStmts { stack.push(st) }
  }
  const node = fnStmts[fe]
  let name = ""
  const lits: i32[] = []
  const lets: i32[] = []
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      const nd = nodeAt(ix)
      const bn = monoConstInitName(ix, node)
      if bn != "" { name = bn }
      if nd is ArrayLit { lits.push(ix) }
      else if nd is LetDecl { lets.push(ix) }
      const body = monoNestedBodyOf(ix)
      if body >= 0 { stack.push(body) }
      for k in nodeChildren(ix) { stack.push(k) }
    }
  }
  if name == "" { return false }
  let stored = false
  for lx in lits {
    let holds = false
    for el in monoArrayElems(lx) {
      // By name, or through a binding that holds it (D3864).
      if monoIdentNameOf(el) == name || monoLamValueFe(el, frame) == fe {
        holds = true
      }
    }
    if holds {
      stored = true
      let owner = ""
      for ld in lets {
        const d = nodeAt(ld)
        if d is LetDecl {
          if d.letInit == lx { owner = d.letName }
        }
      }
      if owner == "" || !monoFrameNameUnread(fe, owner, false) { return false }
    }
  }
  stored
}

// Retypes each capture cell in the instantiated lambda `fe`'s frame that still carries a
// hole-typed function, at that instance's type where it binds every hole: the cells `fe` seeds
// by name, or with `anyElem` any such cell, one seeded through another binding (D3851).
function monoRetypeLamCells(fe: i32, anyElem: boolean) {
  let pf = -1
  if fe < fnParent.length { pf = fnParent[fe] }
  const stack: i32[] = []
  if pf >= 0 && pf < fnStmts.length {
    const b = monoNestedBodyOf(fnStmts[pf])
    if b < 0 { return 0 }
    stack.push(b)
  } else {
    for st in monoProgStmts { stack.push(st) }
  }
  let node = fnStmts[fe]
  if fe < monoOrigNode.length { node = monoOrigNode[fe] }
  let name = ""
  const lets: i32[] = []
  const reads: i32[] = []
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      const bn = monoConstInitName(ix, node)
      if bn != "" { name = bn }
      if nodeAt(ix) is LetDecl { lets.push(ix) }
      if monoCellReadName(ix) != "" { reads.push(ix) }
      const body = monoNestedBodyOf(ix)
      if body >= 0 { stack.push(body) }
      for k in nodeChildren(ix) { stack.push(k) }
    }
  }
  if name == "" { return 0 }
  for lx in lets {
    const ld = nodeAt(lx)
    if ld is LetDecl {
      const ce = monoGeneratedCellElem(ld.letInit)
      let et = -1
      if ce >= 0 { et = monoCellElemTyOf(ld.letInit, ce) }
      if et >= 0 && (anyElem || monoIdentNameOf(ce) == name) && tyHasTyVar(et) {
        const it = monoPinSubTyOf(et, fnStmts[fe])
        if (
          it >= 0
          && it < T.tys.length
          && !tyHasTyVar(it)
          && tyAt(it) is TyFunc
        ) {
          monoRetypeCell(lx, ce, it, reads)
        }
      } else if anyElem && ce >= 0 && (et < 0 || nodeTyIxOf(ld.letInit) < 0) {
        // A cell seeded from another cell's read and recorded with no type takes that cell's.
        if et >= 0 { monoRetypeCell(lx, ce, et, reads) }
      }
    }
  }
  0
}

// The reads `d[0]` of the capture cell declared at `cd` in frame `fx` (-1 for module scope),
// nested bodies included.
function monoCellReadsIn(fx: i32, cd: i32): i32[] {
  const out: i32[] = []
  const stack: i32[] = []
  if fx >= 0 {
    const b = monoNestedBodyOf(fx)
    if b < 0 { return out }
    stack.push(b)
  } else {
    for st in monoProgStmts { stack.push(st) }
  }
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    if ix >= 0 && ix < P.nodes.length {
      if monoReadsCell(ix, cd) { out.push(ix) }
      const body = monoNestedBodyOf(ix)
      if body >= 0 { stack.push(body) }
      for k in nodeChildren(ix) { stack.push(k) }
    }
  }
  out
}

// Records function type `ft` on the capture cell declared at `cd`, its element `elem`, and each
// read of it among `reads` that has no concrete type of its own.
function monoRetypeCell(cd: i32, elem: i32, ft: i32, reads: i32[]) {
  const d = nodeAt(cd)
  if !(d is LetDecl) { return 0 }
  nodeTyRecord(elem, ft)
  nodeTyRecord(d.letInit, mkArrayTy(ft))
  for r in reads {
    if monoReadsCell(r, cd) {
      const rt = nodeTyIxOf(r)
      if rt < 0 || tyHasTyVar(rt) { nodeTyRecord(r, ft) }
    }
  }
  0
}

// Whether `t` is a function type with no type variable left in it.
function monoTyConcreteFn(t: i32): boolean {
  t >= 0 && t < T.tys.length && !tyHasTyVar(t) && tyAt(t) is TyFunc
}

// The element type of capture cell `cell` (a one-element list literal holding `elem`): the
// list's recorded element type, else the element's own.
function monoCellElemTyOf(cell: i32, elem: i32): i32 {
  const ct = nodeTyIxOf(cell)
  if ct >= 0 && ct < T.tys.length {
    const t = tyAt(ct)
    if t is TyArray { return t.aElem }
  }
  nodeTyIxOf(elem)
}

// The elements of list literal node `ix`, or none for any other node.
function monoArrayElems(ix: i32): i32[] {
  if ix < 0 || ix >= P.nodes.length {
    const none: i32[] = []
    return none
  }
  const nd = nodeAt(ix)
  if nd is ArrayLit { return nd.arrElems }
  const none: i32[] = []
  none
}

// The lifted slots below `nDecl` holding an un-instantiated hole lambda that is the initializer
// of an un-annotated `const` no name in its frame reads. Its parameter has no type but the `i32`
// default, at which its body need not validate; nothing calls or passes it, so it is stubbed.
// The frame is searched by name, nested functions included, so a shadowing read keeps it.
function monoUnreadLamSlots(nDecl: i32): i32[] {
  const out: i32[] = []
  let fe = 0
  while fe < nDecl {
    if (
      monoGen[fe] == 1
      && criFnIsAnonLambda(fe)
      && fnStmts[fe] == monoOrigNode[fe]
    ) {
      if !monoInstantiatedAny(fe) && monoLamUnread(fe) { out.push(fe) }
    }
    fe = fe + 1
  }
  out
}

// Whether the lambda in slot `fe` initializes an un-annotated `const` that nothing in its
// enclosing frame (the program, at top level) reads by name.
function monoLamUnread(fe: i32): boolean { monoFrameNameUnread(fe, "", false) }

// Whether nothing in the enclosing frame of the lambda in slot `fe` reads `target`, or the
// lambda's own `const` binding for "", but to seed or write bindings that are unread in turn.
// With `calls`, whether no call goes through it or a binding it seeds or writes.
function monoFrameNameUnread(fe: i32, target: string, calls: boolean): boolean {
  const roots: i32[] = []
  let pf = -1
  if fe < fnParent.length { pf = fnParent[fe] }
  if pf >= 0 && pf < fnStmts.length {
    const f = nodeAt(fnStmts[pf])
    if f is FuncDecl { roots.push(f.fnBody) } else { return false }
  } else {
    for st in monoProgStmts { roots.push(st) }
  }
  // The template's node, which the binding's initializer names once an instance takes the slot.
  let node = fnStmts[fe]
  if fe < monoOrigNode.length { node = monoOrigNode[fe] }
  let name = ""
  // Each walked node carries the names a nearer scope rebinds there, as `|a|b|`.
  const stack: i32[] = []
  const stackSh: string[] = []
  for r in roots {
    stack.push(r)
    stackSh.push("|")
  }
  const seen: i32[] = []
  const seenSh: string[] = []
  let top = -1
  if pf >= 0 && pf < fnStmts.length { top = fnStmts[pf] }
  while stack.length > 0 {
    const ix = stack.pop() ?? -1
    const sh = stackSh.pop() ?? "|"
    if ix >= 0 && ix < P.nodes.length {
      // Asking about calls, a function nothing names never makes one.
      const dead = calls
        && nodeAt(ix) is FuncDecl
        && monoWriteFrameDead(ix, top)
      if !dead {
        seen.push(ix)
        seenSh.push(sh)
        const bn = monoConstInitName(ix, node)
        if bn != "" { name = bn }
        monoScopedKids(ix, sh, i32ListHas(roots, ix), stack, stackSh)
      }
    }
  }
  if name == "" { return false }
  // A read that only initializes another un-annotated binding nothing reads does not keep the
  // lambda: `const d1 = c` with `d1` unread leaves `c` as uncalled as before (D3850).
  const aliasInit: i32[] = []
  // A write's target is no read of it, and its value is read only as far as the target is.
  const lhs: i32[] = []
  const writeVal: i32[] = []
  const writeTo: string[] = []
  const callees: i32[] = []
  for ix in seen {
    const ai = monoAliasInitOf(ix)
    if ai >= 0 { aliasInit.push(ai) }
    const nd = nodeAt(ix)
    if i32ListHas(monoDeliveredArgs, ix) { callees.push(ix) }
    if nd is Call && nd.callFn >= 0 {
      // A call through `v`, `v[i]` or a cell's `v[0]` goes through `v`.
      const cf = nodeAt(nd.callFn)
      if cf is Index {
        callees.push(cf.idxArr)
      } else {
        callees.push(nd.callFn)
      }
    } else if nd is BinExpr {
      if nd.binOp == "=" {
        let tname = monoIdentNameOf(nd.binLeft)
        let tnode = nd.binLeft
        if tname == "" {
          tname = monoCellReadName(nd.binLeft)
          const li = nodeAt(nd.binLeft)
          if li is Index { tnode = li.idxArr }
        }
        if tname != "" {
          lhs.push(tnode)
          let wv = monoReadNameNode(nd.binRight)
          if wv < 0 { wv = nd.binRight }
          writeVal.push(wv)
          writeTo.push(tname)
        }
      }
    }
  }
  const visiting: string[] = []
  if target != "" { name = target }
  // A read of a frame-level binding that a nearer binding shadows reads that one (D3843).
  const rootNames: string[] = []
  for r in roots { monoRootDeclNames(r, rootNames) }
  const reads: i32[] = []
  let i = 0
  while i < seen.length {
    const nm = monoIdentNameOf(seen[i])
    if (
      nm == ""
      || !strListHas(rootNames, nm)
      || !strContains(seenSh[i], "|" + nm + "|")
    ) {
      reads.push(seen[i])
    }
    i = i + 1
  }
  if calls {
    return !monoNameCalled(
      name,
      reads,
      aliasInit,
      lhs,
      writeVal,
      writeTo,
      callees,
      visiting,
    )
  }
  monoNameUnread(name, reads, aliasInit, lhs, writeVal, writeTo, visiting)
}

// Pushes the children of node `ix`, walked under shadow list `sh`, each with the list it is
// walked under: a function adds its name and parameters, a loop its variables, and a block
// below the frame's root each name its statements declare, from that statement on.
function monoScopedKids(
  ix: i32,
  sh: string,
  root: boolean,
  stack: i32[],
  stackSh: string[],
) {
  const n = nodeAt(ix)
  let inner = sh
  if n is FuncDecl {
    inner = monoShAdd(inner, n.fnName)
    for q in n.fnParams {
      const qp = nodeAt(q)
      if qp is Param { inner = monoShAdd(inner, qp.parName) }
    }
    stack.push(n.fnBody)
    stackSh.push(inner)
  } else if n is ForIn {
    stack.push(n.fiIter)
    stackSh.push(sh)
    stack.push(n.fiBody)
    stackSh.push(monoShAdd(monoShAdd(sh, n.fiVar), n.fiVar2))
    return 0
  } else if n is ForRange {
    inner = monoShAdd(sh, n.frVar)
  } else if n is Block {
    if !root {
      let run = sh
      for st in n.blkStmts {
        stack.push(st)
        stackSh.push(run)
        run = monoShAdd(run, monoStmtDeclName(st))
      }
      return 0
    }
  }
  for k in nodeChildren(ix) {
    stack.push(k)
    stackSh.push(inner)
  }
  0
}

// Appends the names root `r` of a frame declares: a statement's own, or each statement's of a
// function body's block.
function monoRootDeclNames(r: i32, out: string[]) {
  const n = nodeAt(r)
  if n is Block {
    for st in n.blkStmts { out.push(monoStmtDeclName(st)) }
    return 0
  }
  out.push(monoStmtDeclName(r))
  0
}

// Shadow list `sh` with `nm` added; "" adds nothing.
function monoShAdd(sh: string, nm: string): string {
  if nm == "" { return sh }
  sh + nm + "|"
}

// The name statement `st` declares in its block: a `let`'s, else a function's, else "".
function monoStmtDeclName(st: i32): string {
  if st < 0 || st >= P.nodes.length { return "" }
  const d = nodeAt(st)
  if d is LetDecl { return d.letName }
  monoFnDeclName(st)
}

// The name of function declaration `st`, or "" for any other statement.
function monoFnDeclName(st: i32): string {
  const d = nodeAt(st)
  if d is FuncDecl { return d.fnName }
  ""
}

// Whether a call among `seen` goes through `name`, or through a binding a read of `name` seeds
// or is written into. `visiting` is the path walked; past 64 links it answers "called".
function monoNameCalled(
  name: string,
  seen: i32[],
  aliasInit: i32[],
  lhs: i32[],
  writeVal: i32[],
  writeTo: string[],
  callees: i32[],
  visiting: string[],
): boolean {
  if strListHas(visiting, name) { return false }
  if visiting.length > 64 { return true }
  visiting.push(name)
  for ix in seen {
    if monoIdentNameOf(ix) == name && !i32ListHas(lhs, ix) {
      if i32ListHas(callees, ix) { return true }
      let owner = ""
      if i32ListHas(aliasInit, ix) {
        owner = monoAliasOwnerName(ix, seen)
      } else {
        let w = 0
        while w < writeVal.length {
          if writeVal[w] == ix { owner = writeTo[w] }
          w = w + 1
        }
      }
      if owner != "" {
        if (
          monoNameCalled(
            owner,
            seen,
            aliasInit,
            lhs,
            writeVal,
            writeTo,
            callees,
            visiting,
          )
        ) {
          return true
        }
      }
    }
  }
  visiting.pop()
  false
}

// The name node the initializer of the un-annotated binding node `ix` reads when it is a bare
// name or a cell read, or -1.
function monoAliasInitOf(ix: i32): i32 {
  const nd = nodeAt(ix)
  if nd is LetDecl {
    if nd.letType < 0 && nd.letInit >= 0 {
      // The rewrite's capture cell `[v]` holds `v` (D3851).
      let init = nd.letInit
      const ce = monoGeneratedCellElem(init)
      if ce >= 0 { init = ce }
      return monoReadNameNode(init)
    }
  }
  -1
}

// The name node a read `v` or a cell read `v[0]` at `ix` reads, or -1 for any other node.
function monoReadNameNode(ix: i32): i32 {
  if monoIdentNameOf(ix) != "" { return ix }
  if ix < 0 || ix >= P.nodes.length || monoCellReadName(ix) == "" { return -1 }
  const n = nodeAt(ix)
  if n is Index { return n.idxArr }
  -1
}

// Whether nothing among `seen` reads `name` except as the initializer of a binding that is
// itself unread by the same test. `visiting` is the path walked; past 64 links it answers "read".
function monoNameUnread(
  name: string,
  seen: i32[],
  aliasInit: i32[],
  lhs: i32[],
  writeVal: i32[],
  writeTo: string[],
  visiting: string[],
): boolean {
  // A binding read only along a cycle back to itself is read by nothing outside it.
  if strListHas(visiting, name) { return true }
  if visiting.length > 64 { return false }
  visiting.push(name)
  for ix in seen {
    if monoIdentNameOf(ix) == name && !i32ListHas(lhs, ix) {
      let owner = ""
      if i32ListHas(aliasInit, ix) {
        owner = monoAliasOwnerName(ix, seen)
      } else {
        let w = 0
        while w < writeVal.length {
          if writeVal[w] == ix { owner = writeTo[w] }
          w = w + 1
        }
      }
      if owner == "" { return false }
      if (
        !monoNameUnread(owner, seen, aliasInit, lhs, writeVal, writeTo, visiting)
      ) {
        return false
      }
    }
  }
  // Off the path again: a second read reaching the same binding is no cycle.
  visiting.pop()
  true
}

// The name of the binding among `seen` whose initializer is node `init`, or "".
function monoAliasOwnerName(init: i32, seen: i32[]): string {
  for ix in seen {
    const nd = nodeAt(ix)
    if nd is LetDecl {
      let li = nd.letInit
      const ce = monoGeneratedCellElem(li)
      if ce >= 0 { li = ce }
      if li >= 0 && (li == init || monoReadNameNode(li) == init) {
        return nd.letName
      }
    }
  }
  ""
}

// The name of the un-annotated `const` node `ix` declares with initializer `init`, or "".
function monoConstInitName(ix: i32, init: i32): string {
  const nd = nodeAt(ix)
  if nd is LetDecl {
    if nd.letInit == init && nd.letKw == "const" && nd.letType < 0 {
      return nd.letName
    }
  }
  ""
}

// The body of function node `ix`, which `nodeChildren` does not enter; -1 for any other node.
function monoNestedBodyOf(ix: i32): i32 {
  if ix < 0 || ix >= P.nodes.length { return -1 }
  const nd = nodeAt(ix)
  if nd is FuncDecl { return nd.fnBody }
  -1
}

// The name identifier node `ix` reads, or "" for any other node.
function monoIdentNameOf(ix: i32): string {
  if ix < 0 || ix >= P.nodes.length { return "" }
  const nd = nodeAt(ix)
  if nd is Ident { return nd.identName }
  ""
}

// Does the annotation node `ix` mention any of `typarams`? The parser's spelling tree answers
// where it survives; where canon rewrote the name in place, `monoAnnHasTyParam` asks the node's
// type, since answering false there would let the type parameter survive into the instance.
function monoAnnMentionsTyParam(ix: i32, typarams: string[]) {
  const root = annTsOf(ix)
  if root >= 0 { return tsMentionsAnyName(root, typarams) }
  monoAnnHasTyParam(ix, -1, typarams)
}

// The spelling of a list type whose innermost element is a record, by that record's row name
// (`Circle[]`, `Circle[][]`), or "" when the leaf has no row: `monoRetRowName` decides the leaf.
function monoRetListRowName(ty: i32): string {
  let t = ty
  let suffix = ""
  let peeling = true
  while peeling && t >= 0 && t < T.tys.length && suffix.length < 128 {
    const tt = tyAt(t)
    if tt is TyArray {
      suffix = suffix + "[]"
      t = tt.aElem
    } else {
      peeling = false
    }
  }
  if suffix == "" || t < 0 || t >= T.tys.length { return "" }
  const rn = monoRetRowName(t)
  if rn == "" { return "" }
  rn + suffix
}
