import { cpCount } from "./strutil"

// `cli_util.vl` — pure string, format and glob helpers for the CLI: ANSI colouring,
// detab and visual width, line splitting, severity rank, `--exclude` glob matching,
// JSON escaping, module-mode detection and directory-walk predicates. State-free —
// it holds no `cli.vl` module global, so it is a leaf the CLI imports.

import { i32ToStr } from "./ast"
import {
  formatSrc,
  modCommitStr,
  modPendingKeyAt,
  srcReset,
  srcSetStr,
} from "./driver"

// Directories skipped when walking broadly: build output, deps, vendored trees.
export function cliSkipDir(name: string) {
  name == "node_modules" ||
    name == ".git" ||
    name == "dist" ||
    name == "reference"
}
// ── string helpers ─────────────────────────────────────────────────────────────
export function cliRepeat(s: string, n: i32) {
  let out = ""
  let i = 0
  while i < n {
    out = out + s
    i = i + 1
  }
  out
}
export function cliUpper(s: string) {
  const out: i32[] = []
  for cp in s {
    let c = cp
    if c >= 'a' && c <= 'z' { c = c - 32 }
    out.push(c)
  }
  fromCodePoints(out)
}
// Tabs → 4 columns so carets line up under tab-indented source (the shown line is
// detabbed to match).
export function cliDetab(s: string) {
  const out: i32[] = []
  for cp in s {
    if cp == '\t' {
      const pad = 4 - (out.length % 4)
      let p = 0
      while p < pad {
        out.push(' ')
        p = p + 1
      }
    } else {
      out.push(cp)
    }
  }
  fromCodePoints(out)
}
// The visual column the prefix `[0, n)` of `raw` ends at, after detabbing. `n` is a
// byte offset (the lexer's columns are byte columns) but the answer is a width, so it
// counts code points: the offset selecting the prefix and the number positioning the
// caret are different kinds of integer, and confusing them shifts the caret per byte.
export function cliVisualWidth(raw: string, n: i32) {
  let m = n
  if m > raw.length { m = raw.length }
  if m < 0 { m = 0 }
  cpCount(cliDetab(raw.slice(0, m)))
}
// `str::lines()` semantics: split on `\n`, drop a trailing `\r`, no trailing
// empty line for a final newline.
export function cliSplitLines(s: string) {
  const out: string[] = []
  // Slices, not a code-point buffer: `\n` and `\r` are ASCII, so splitting is a pure
  // offset operation and each piece is a range handed straight back to `slice`.
  let lineStart = 0
  let i = 0
  while i < s.length {
    if s[i] == '\n' {
      let line = s.slice(lineStart, i)
      if line.length > 0 && line[line.length - 1] == '\r' {
        line = line.slice(0, line.length - 1)
      }
      out.push(line)
      lineStart = i + 1
    }
    i = i + 1
  }
  if lineStart < s.length {
    let line = s.slice(lineStart, s.length)
    if line.length > 0 && line[line.length - 1] == '\r' {
      line = line.slice(0, line.length - 1)
    }
    out.push(line)
  }
  out
}
// ── severity model ───────────────────────────────────────────────────────────

// Low → high, so the rank is the index (hint = 0 … error = 3). An unknown lexeme
// falls back to `warning`, which still surfaces.
export function cliSevRank(s: string) {
  if s == "hint" { return 0 }
  if s == "info" { return 1 }
  if s == "warning" { return 2 }
  if s == "error" { return 3 }
  2
}
export function cliSevValid(s: string) {
  s == "hint" || s == "info" || s == "warning" || s == "error"
}
export function cliSevCode(s: string) {
  if s == "error" { return "31" }
  if s == "warning" { return "33" }
  "34"
}
// ANSI wrap, gated on color (so call sites stay branch-free).
export function cliAnsi(color: i32, code: string, s: string) {
  if color != 0 { return "\x1b[" + code + "m" + s + "\x1b[0m" }
  s
}
// ── JSON escaping (`check --json`) ──────────────────────────────────────────────
function cliHexDigit(v: i32) {
  if v < 10 { return '0' + v }
  'a' + (v - 10)
}
// Escape `s` for the inside of a JSON string literal: `"` and `\` get a
// backslash, `\n`/`\r`/`\t` their short forms, the remaining C0 controls
// `\u00XX`. Everything else (non-ASCII included) passes through — the host
// writes UTF-8.
export function cliJsonEsc(s: string) {
  const out: i32[] = []
  for c in s {
    if c == '"' || c == '\\' {
      out.push('\\')
      out.push(c)
    } else if c == '\n' {
      out.push('\\')
      out.push('n')
    } else if c == '\r' {
      out.push('\\')
      out.push('r')
    } else if c == '\t' {
      out.push('\\')
      out.push('t')
    } else if c < 32 {
      out.push('\\')
      out.push('u')
      out.push('0')
      out.push('0')
      out.push(cliHexDigit(c / 16))
      out.push(cliHexDigit(c % 16))
    } else {
      out.push(c)
    }
  }
  fromCodePoints(out)
}
export function cliPlural(n: i32, w: string) {
  let out = i32ToStr(n) + " " + w
  if n != 1 { out = out + "s" }
  out
}
// ── module-mode detection (mirror the host's cheap textual gate) ───────────────

// The gate exists four times in three languages and the four must agree: a host that
// does not arm the fetch loop leaves the guest asking for a module nobody will fetch,
// and the symptom is silence, not an error. `scripts/vl-host/src/main.rs` and
// `compiler/moduleGate.ts` mirror it; `tests/module_gate_agreement_test.ts` guards it.

// True if `line`'s first non-space token is `kw`, then optional whitespace, then `{`.
export function cliLineStartsKwBrace(line: string, kw: string) {
  let i = 0
  while i < line.length && (line[i] == ' ' || line[i] == '\t') { i = i + 1 }
  let k = 0
  while k < kw.length {
    if i + k >= line.length { return 0 }
    if line[i + k] != kw[k] { return 0 }
    k = k + 1
  }
  i = i + kw.length
  while i < line.length && (line[i] == ' ' || line[i] == '\t') { i = i + 1 }
  if i < line.length && line[i] == '{' { return 1 }
  0
}
// A module-dependency line: `import { … }`, or a re-export `export { … } from "…"` —
// both pull another module, so both must arm the fetch loop for `check` and `--fix`.
export function cliLineIsImport(line: string) {
  if cliLineStartsKwBrace(line, "import") != 0 { return 1 }
  if cliLineStartsKwBrace(line, "export") != 0 { return 1 }
  0
}
export function cliHasImports(s: string) {
  const lines = cliSplitLines(s)
  let i = 0
  while i < lines.length {
    if cliLineIsImport(lines[i]) != 0 { return 1 }
    i = i + 1
  }
  0
}
// True when `s` holds an interpolation hole `\{…}`, in either a `"…"` string or a
// `` `…` `` template: a hole desugars into `std:fmt`, which reaches the compiler only
// through the module fetch loop, so this arms module mode beside `cliLineIsImport`.
// The `\{` test sits inside the literal scans, so `\\{` reads as a backslash then a brace.
export function cliHasTplHole(s: string) {
  const n = s.length
  let i = 0
  while i < n {
    const c = s[i]
    if c == '/' && i + 1 < n && s[i + 1] == '/' {
      while i < n && s[i] != '\n' { i = i + 1 }
    } else if c == '"' || c == '\'' {
      const holes = c == '"'
      i = i + 1
      while i < n && s[i] != c {
        if s[i] == '\\' {
          if holes && i + 1 < n && s[i + 1] == '{' { return 1 }
          i = i + 1
        }
        i = i + 1
      }
      i = i + 1
    } else if c == '`' {
      i = i + 1
      while i < n && s[i] != '`' {
        if s[i] == '\\' {
          if i + 1 < n && s[i + 1] == '{' { return 1 }
          i = i + 1
        }
        i = i + 1
      }
      i = i + 1
    } else {
      i = i + 1
    }
  }
  0
}
// The module pipeline's arming test: an import/re-export edge, or a template hole
// (whose renderer is a `std:fmt` export — see `cliHasTplHole`).
export function cliNeedsModules(s: string) {
  if cliHasImports(s) != 0 { return 1 }
  cliHasTplHole(s)
}
// Match glob `pat` against `text`: `*` matches a run of non-`/` characters, `**` crosses
// separators, every other character is literal. A match succeeds when the rest of the
// text is empty or begins a new `/`-segment, so `tests` gates everything beneath it.
// An iterative row-per-token dynamic program: no backtracking, no wasm-stack recursion.
export function cliGlob(pat: string, text: string) {
  const n = text.length
  let row: i32[] = []
  let z = 0
  while z <= n {
    row.push(0)
    z = z + 1
  }
  row[0] = 1
  let pi = 0
  while pi < pat.length {
    const cur: i32[] = []
    let f = 0
    while f <= n {
      cur.push(0)
      f = f + 1
    }
    const pc = pat[pi]
    if pc == '*' && pi + 1 < pat.length && pat[pi + 1] == '*' {
      // `**` — zero or more of any character: carry the previous row's match forward
      // across every text position.
      let k = 0
      while k <= n {
        if row[k] != 0 { cur[k] = 1 }
        if k > 0 && cur[k - 1] != 0 { cur[k] = 1 }
        k = k + 1
      }
      pi = pi + 2
    } else if pc == '*' {
      // `*` — zero or more non-`/` characters: the carry stops at a separator.
      let k = 0
      while k <= n {
        if row[k] != 0 { cur[k] = 1 }
        if k > 0 && cur[k - 1] != 0 && text[k - 1] != '/' { cur[k] = 1 }
        k = k + 1
      }
      pi = pi + 1
    } else {
      // A literal: extend each match by exactly this character.
      let k = 1
      while k <= n {
        if row[k - 1] != 0 && text[k - 1] == pc { cur[k] = 1 }
        k = k + 1
      }
      pi = pi + 1
    }
    row = cur
  }
  // Anchor: the full pattern must land at the text end or a segment boundary.
  let k = 0
  while k <= n {
    if row[k] != 0 && (k >= n || text[k] == '/') { return true }
    k = k + 1
  }
  false
}
// Commit one (key, src, found) into the module table (the fetch protocol). It hands the
// strings over directly; the driver's code-point accumulators stay for the host channel
// (`modSrcLoad` stages UTF-32 words), and a caller already holding the string skips them.
export function cliModCommitOne(key: string, src: string, found: i32) {
  let body = ""
  if found != 0 { body = src }
  modCommitStr(key, body, found)
  0
}
// The k-th pending module key, read as a string from the driver's accessors.
export function cliPendingKey(k: i32) { modPendingKeyAt(k) }
// ── directory walk ──────────────────────────────────────────────────────────
// True when `name` ends in `.vl`.
export function cliEndsVl(name: string) {
  if name.length < 3 { return false }
  const a = name.length - 3
  name[a] == '.' && name[a + 1] == 'v' && name[a + 2] == 'l'
}
// True when `name` ends in `.test.vl` — the `vl test` discovery predicate. A suffix
// test, not a glob: `x.test.vl` and `a/b.test.vl` match, `test.vl` alone does not, so a
// file merely named `test.vl` stays an ordinary module.
export function cliEndsTestVl(name: string) {
  if name.length < 9 { return false }
  const a = name.length - 8
  name[a] == '.' &&
    name[a + 1] == 't' &&
    name[a + 2] == 'e' &&
    name[a + 3] == 's' &&
    name[a + 4] == 't' &&
    name[a + 5] == '.' &&
    name[a + 6] == 'v' &&
    name[a + 7] == 'l'
}
// True when `needle` occurs anywhere in `hay`; an empty needle always does. The
// `vl test -t` name filter — a naive scan, since test names are short strings and
// `cliGlob` is the tool when a pattern is wanted instead.
export function cliContains(hay: string, needle: string) {
  if needle.length == 0 { return true }
  if needle.length > hay.length { return false }
  let i = 0
  while i + needle.length <= hay.length {
    let j = 0
    let hit = true
    while j < needle.length {
      if hay[i + j] != needle[j] {
        hit = false
        j = needle.length
      } else {
        j = j + 1
      }
    }
    if hit { return true }
    i = i + 1
  }
  false
}
// `a` sorts strictly AFTER `b` (code-point lexicographic order).
export function cliStrGt(a: string, b: string) {
  let n = a.length
  if b.length < n { n = b.length }
  let i = 0
  while i < n {
    if a[i] != b[i] { return a[i] > b[i] }
    i = i + 1
  }
  a.length > b.length
}
// All but the last element of a stack, rebuilt: a bare `.pop()` is an emit gap in the
// native pipeline, and the driver uses the same idiom.
export function cliPopLast(xs: string[]) {
  const out: string[] = []
  let i = 0
  while i < xs.length - 1 {
    out.push(xs[i])
    i = i + 1
  }
  out
}
// ── fmt per-file ─────────────────────────────────────────────────────────────

// Format `src` through the AST formatter, single-file and purely syntactic. Returns a
// status: 0 formatted, with the output in `vcFmtOut` and already round-trip-verified;
// 1 the input does not lex or parse, so nothing is formatted and the parse diagnostics
// stay readable; 2 the output does not re-parse — the caller must keep the input bytes.
export function cliFormatNow(src: string): i32 {
  // `srcSetStr`, not a `srcPush(src[i])` loop: the loop spelling re-encodes every
  // non-ASCII character in the file being formatted. See `driver.srcSetStr`.
  srcReset()
  srcSetStr(src)
  const len = formatSrc()
  if len == -2 { return 2 }
  if len < 0 { return 1 }
  0
}
