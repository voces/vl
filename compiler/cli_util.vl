import { cpCount } from "./strutil"

// `cli_util.vl` — pure string/format/glob helpers for the CLI: ANSI colouring, detab /
// visual-width, line splitting, severity rank/validation, `--exclude` glob matching,
// and import-line detection. State-free (no `cli.vl` module global) — a leaf the CLI
// imports. Carved out of `cli.vl`.

import { i32ToStr } from "./ast"
import {
  formatSrc,
  modCommitStr,
  modPendingKeyAt,
  srcReset,
  srcSetStr,
} from "./driver"

// Directories skipped when walking broadly (build output, deps, vendored,
// retired ts-interpreter) — mirrors the host's former SKIP_DIRS.
export function cliSkipDir(name: string) {
  name == "node_modules" ||
    name == ".git" ||
    name == "dist" ||
    name == "reference"
}
// ── string helpers ─────────────────────────────────────────────────────────────
export function cliRepeat(s: string, n: i32) {
  let out = ""
  let i = 0
  while i < n {
    out = out + s
    i = i + 1
  }
  out
}
export function cliUpper(s: string) {
  const out: i32[] = []
  for cp in s {
    let c = cp
    if c >= 'a' && c <= 'z' { c = c - 32 }
    out.push(c)
  }
  fromCodePoints(out)
}
// Tabs → 4 columns so carets line up under tab-indented source (the shown line is
// detabbed to match). Mirrors the host's former `detab`.
export function cliDetab(s: string) {
  const out: i32[] = []
  for cp in s {
    if cp == '\t' {
      const pad = 4 - (out.length % 4)
      let p = 0
      while p < pad {
        out.push(' ')
        p = p + 1
      }
    } else {
      out.push(cp)
    }
  }
  fromCodePoints(out)
}
// The visual column the prefix `[0, n)` of `raw` ends at, after detabbing.
//
// `n` is a BYTE offset (it comes from the lexer's columns, which are byte columns since
// Stage 2c) but the answer is a COLUMN — a width — so it is counted in code points. This is
// the §R1 distinction: the offset that selects the prefix and the number that positions the
// caret are different kinds of integer, and only the first one cancels against `slice`.
// Getting this wrong puts the caret one column right per non-ASCII byte before the error.
export function cliVisualWidth(raw: string, n: i32) {
  let m = n
  if m > raw.length { m = raw.length }
  if m < 0 { m = 0 }
  cpCount(cliDetab(raw.slice(0, m)))
}
// `str::lines()` semantics: split on `\n`, drop a trailing `\r`, no trailing
// empty line for a final newline.
export function cliSplitLines(s: string) {
  const out: string[] = []
  // SLICES, NOT A CODE-POINT BUFFER. Splitting is a pure OFFSET operation — `\n` and `\r`
  // are ASCII, so they are found at the same places in either unit, and every piece is a
  // range of the input handed straight back to `slice`. Rebuilding each line through
  // `fromCodePoints` would have re-encoded every non-ASCII byte as its own character; a
  // slice cannot, because it never names a unit at all. It is also O(1) per line now.
  let lineStart = 0
  let i = 0
  while i < s.length {
    if s[i] == '\n' {
      let line = s.slice(lineStart, i)
      if line.length > 0 && line[line.length - 1] == '\r' {
        line = line.slice(0, line.length - 1)
      }
      out.push(line)
      lineStart = i + 1
    }
    i = i + 1
  }
  if lineStart < s.length {
    let line = s.slice(lineStart, s.length)
    if line.length > 0 && line[line.length - 1] == '\r' {
      line = line.slice(0, line.length - 1)
    }
    out.push(line)
  }
  out
}
// ── severity model (mirror the host's SEVERITIES / severity_rank) ──────────────
// Low → high, so the rank IS the index (hint=0 … error=3). An unknown lexeme
// falls back to `warning` (still surfaces).
export function cliSevRank(s: string) {
  if s == "hint" { return 0 }
  if s == "info" { return 1 }
  if s == "warning" { return 2 }
  if s == "error" { return 3 }
  2
}
export function cliSevValid(s: string) {
  s == "hint" || s == "info" || s == "warning" || s == "error"
}
export function cliSevCode(s: string) {
  if s == "error" { return "31" }
  if s == "warning" { return "33" }
  "34"
}
// ANSI wrap, gated on color (so call sites stay branch-free).
export function cliAnsi(color: i32, code: string, s: string) {
  if color != 0 { return "\x1b[" + code + "m" + s + "\x1b[0m" }
  s
}
// ── JSON escaping (`check --json`) ──────────────────────────────────────────────
function cliHexDigit(v: i32) {
  if v < 10 { return '0' + v }
  'a' + (v - 10)
}
// Escape `s` for the inside of a JSON string literal: `"` and `\` get a
// backslash, `\n`/`\r`/`\t` their short forms, the remaining C0 controls
// `\u00XX`. Everything else (non-ASCII included) passes through — the host
// writes UTF-8.
export function cliJsonEsc(s: string) {
  const out: i32[] = []
  for c in s {
    if c == '"' || c == '\\' {
      out.push('\\')
      out.push(c)
    } else if c == '\n' {
      out.push('\\')
      out.push('n')
    } else if c == '\r' {
      out.push('\\')
      out.push('r')
    } else if c == '\t' {
      out.push('\\')
      out.push('t')
    } else if c < 32 {
      out.push('\\')
      out.push('u')
      out.push('0')
      out.push('0')
      out.push(cliHexDigit(c / 16))
      out.push(cliHexDigit(c % 16))
    } else {
      out.push(c)
    }
  }
  fromCodePoints(out)
}
export function cliPlural(n: i32, w: string) {
  let out = i32ToStr(n) + " " + w
  if n != 1 { out = out + "s" }
  out
}
// ── module-mode detection (mirror the host's cheap textual gate) ───────────────
//
// THE GATE EXISTS FOUR TIMES, IN THREE LANGUAGES, and the four must agree — a
// host that does not arm the fetch loop leaves the guest asking for a module
// nobody will fetch, and the symptom is SILENCE rather than an error:
//   1. HERE                       `cliLineIsImport` / `cliHasTplHole` / `cliNeedsModules`
//   2. `scripts/vl-host/src/main.rs`  the inline gate in `stage_program` + `has_template_hole`
//   3. `compiler/moduleGate.ts`   the shared TS copy, imported by …
//   4. … `lsp/src/wasmChecker.ts` (VS Code LSP + browser playground) and
//      `tests/cases_wasm_test.ts` (the corpus oracle)
// 3 and 4 were two hand-maintained copies until they lost the `export {` arm
// #2182 added to 1 and 2; they are one module now. 1 and 2 cannot import it, so
// they stay MIRRORED — `tests/module_gate_agreement_test.ts` is the guard: it
// extracts THIS function's arm set from this source and fails when it drifts.
//
// True if `line`'s first non-space token is the keyword `kw` immediately followed
// (after optional whitespace) by `{`.
export function cliLineStartsKwBrace(line: string, kw: string) {
  let i = 0
  while i < line.length && (line[i] == ' ' || line[i] == '\t') { i = i + 1 }
  let k = 0
  while k < kw.length {
    if i + k >= line.length { return 0 }
    if line[i + k] != kw[k] { return 0 }
    k = k + 1
  }
  i = i + kw.length
  while i < line.length && (line[i] == ' ' || line[i] == '\t') { i = i + 1 }
  if i < line.length && line[i] == '{' { return 1 }
  0
}
// A module-dependency line: `import { … }` OR a RE-EXPORT `export { … } from "…"`
// (both pull another module, so both must arm the fetch loop for `check`/`--fix`).
export function cliLineIsImport(line: string) {
  if cliLineStartsKwBrace(line, "import") != 0 { return 1 }
  if cliLineStartsKwBrace(line, "export") != 0 { return 1 }
  0
}
export function cliHasImports(s: string) {
  const lines = cliSplitLines(s)
  let i = 0
  while i < lines.length {
    if cliLineIsImport(lines[i]) != 0 { return 1 }
    i = i + 1
  }
  0
}
// True when `s` holds a TEMPLATE LITERAL WITH A HOLE — the second construct (after
// an `import`/re-export line) that makes a file need the MODULE pipeline.
//
// WHY IT IS A GATE AT ALL: a hole desugars to a call into `std:fmt`, and `std:fmt`
// reaches the compiler only through the module FETCH LOOP, which every host arms
// from a cheap textual scan of the entry source before any lexing happens. So this
// predicate rides the same four-site mirror as `cliLineIsImport` above — here,
// `has_template_hole` in `scripts/vl-host/src/main.rs`, and `compiler/moduleGate.ts`
// for both TS consumers — under the same guard.
//
// IT IS A REAL SCAN, NOT `contains("`")`. A backtick in a `//` comment is ordinary
// and common — 2,409 of the corpus's own `.vl` files carry one — and arming module
// mode for those would change the compilation path of programs that have nothing to
// do with templates. Comments and quoted literals are therefore skipped, and a
// template opened in CODE arms the loop only if it actually holds a `${`: a
// hole-less `` `plain` `` needs no renderer and keeps the single-source path.
export function cliHasTplHole(s: string) {
  const n = s.length
  let i = 0
  while i < n {
    const c = s[i]
    if c == '/' && i + 1 < n && s[i + 1] == '/' {
      while i < n && s[i] != '\n' { i = i + 1 }
    } else if c == '"' || c == '\'' {
      i = i + 1
      while i < n && s[i] != c {
        if s[i] == '\\' { i = i + 1 }
        i = i + 1
      }
      i = i + 1
    } else if c == '`' {
      i = i + 1
      while i < n && s[i] != '`' {
        if s[i] == '\\' { i = i + 1 }
        else if s[i] == '$' && i + 1 < n && s[i + 1] == '{' { return 1 }
        i = i + 1
      }
      i = i + 1
    } else {
      i = i + 1
    }
  }
  0
}
// The module pipeline's arming test: an import/re-export edge, or a template hole
// (whose renderer is a `std:fmt` export — see `cliHasTplHole`).
export function cliNeedsModules(s: string) {
  if cliHasImports(s) != 0 { return 1 }
  cliHasTplHole(s)
}
// Match glob `pat` against `text`. `*` matches a run of non-`/` characters,
// `**` crosses separators, every other char is literal. A completed match
// succeeds when the remaining text is empty OR begins a new `/`-segment —
// encoding the host's `^<pat>(/.*)?$` anchoring, so `tests` gates `tests` and
// everything beneath it. Iterative O(|pat| × |text|) dynamic program — one
// row per pattern token, `row[t]` = "the tokens so far match text[0, t)" — so
// an adversarial `*a*a*a…` pattern stays polynomial (backtracking recursion
// is exponential there) and nothing recurses on the wasm call stack.
export function cliGlob(pat: string, text: string) {
  const n = text.length
  let row: i32[] = []
  let z = 0
  while z <= n {
    row.push(0)
    z = z + 1
  }
  row[0] = 1
  let pi = 0
  while pi < pat.length {
    const cur: i32[] = []
    let f = 0
    while f <= n {
      cur.push(0)
      f = f + 1
    }
    const pc = pat[pi]
    if pc == '*' && pi + 1 < pat.length && pat[pi + 1] == '*' {
      // `**` — zero+ of ANY character: carry the previous row's match forward
      // across every text position.
      let k = 0
      while k <= n {
        if row[k] != 0 { cur[k] = 1 }
        if k > 0 && cur[k - 1] != 0 { cur[k] = 1 }
        k = k + 1
      }
      pi = pi + 2
    } else if pc == '*' {
      // `*` — zero+ NON-`/` characters: the carry stops at a separator.
      let k = 0
      while k <= n {
        if row[k] != 0 { cur[k] = 1 }
        if k > 0 && cur[k - 1] != 0 && text[k - 1] != '/' { cur[k] = 1 }
        k = k + 1
      }
      pi = pi + 1
    } else {
      // A literal: extend each match by exactly this character.
      let k = 1
      while k <= n {
        if row[k - 1] != 0 && text[k - 1] == pc { cur[k] = 1 }
        k = k + 1
      }
      pi = pi + 1
    }
    row = cur
  }
  // Anchor: the full pattern must land at the text end or a segment boundary.
  let k = 0
  while k <= n {
    if row[k] != 0 && (k >= n || text[k] == '/') { return true }
    k = k + 1
  }
  false
}
// Commit one (key, src, found) into the module table (the fetch protocol).
// STAGE 2c: this hands the STRINGS over directly instead of re-pushing them element by
// element into the driver's code-point accumulators. The old spelling was the §Builders
// defect on the compiler's own PARSE path — `src[j]` became a byte while `modCommit`'s
// `fromCodePoints(modSrcAcc)` still meant code points, so every module of a graph compile
// was double-encoded before the lexer ever saw it, and `'é'` in a source file lexed as two
// characters. The accumulators still exist for the HOST channel (`modSrcLoad` stages UTF-32
// words); a caller that already holds the string has no reason to go through them, and now
// does not — which also removes two full copies of every module's source per compile.
export function cliModCommitOne(key: string, src: string, found: i32) {
  let body = ""
  if found != 0 { body = src }
  modCommitStr(key, body, found)
  0
}
// The k-th pending module key, read per-code-point from the driver's accessors.
// STAGE 2c: reads the key as a STRING rather than reassembling it from `modPendingAt`
// elements, which are bytes now and were being re-encoded one per character.
export function cliPendingKey(k: i32) { modPendingKeyAt(k) }
// ── directory walk ──────────────────────────────────────────────────────────
// True when `name` ends in `.vl`.
export function cliEndsVl(name: string) {
  if name.length < 3 { return false }
  const a = name.length - 3
  name[a] == '.' && name[a + 1] == 'v' && name[a + 2] == 'l'
}
// True when `name` ends in `.test.vl` — the `vl test` discovery predicate. A
// SUFFIX test, not a glob: `x.test.vl` and `a/b.test.vl` match, `test.vl` alone
// does not (the dot is required, so a file merely NAMED `test.vl` is an ordinary
// module, matching jest/vitest's `*.test.*`).
export function cliEndsTestVl(name: string) {
  if name.length < 9 { return false }
  const a = name.length - 8
  name[a] == '.' &&
    name[a + 1] == 't' &&
    name[a + 2] == 'e' &&
    name[a + 3] == 's' &&
    name[a + 4] == 't' &&
    name[a + 5] == '.' &&
    name[a + 6] == 'v' &&
    name[a + 7] == 'l'
}
// True when `needle` occurs anywhere in `hay` (an empty needle always does) —
// the `vl test -t` name filter. Naive O(|hay| × |needle|) scan: the corpus of
// test NAMES is short strings, and `cliGlob` is the tool when a pattern is
// wanted instead.
export function cliContains(hay: string, needle: string) {
  if needle.length == 0 { return true }
  if needle.length > hay.length { return false }
  let i = 0
  while i + needle.length <= hay.length {
    let j = 0
    let hit = true
    while j < needle.length {
      if hay[i + j] != needle[j] {
        hit = false
        j = needle.length
      } else {
        j = j + 1
      }
    }
    if hit { return true }
    i = i + 1
  }
  false
}
// `a` sorts strictly AFTER `b` (code-point lexicographic order).
export function cliStrGt(a: string, b: string) {
  let n = a.length
  if b.length < n { n = b.length }
  let i = 0
  while i < n {
    if a[i] != b[i] { return a[i] > b[i] }
    i = i + 1
  }
  a.length > b.length
}
// All but the last element of a stack (rebuild — a bare `.pop()` is an emit gap
// in the native pipeline; the driver uses the same idiom).
export function cliPopLast(xs: string[]) {
  const out: string[] = []
  let i = 0
  while i < xs.length - 1 {
    out.push(xs[i])
    i = i + 1
  }
  out
}
// ── fmt per-file (A-impl 3) ─────────────────────────────────────────────────────
// Format `src` via the AST formatter (format.vl / formatSrc), single-file and
// purely syntactic — no module resolution. Returns a STATUS the caller branches
// on (the formatted text itself is read from `vcFmtOut`):
//   0 — formatted; `vcFmtOut` holds the output (already round-trip-verified).
//   1 — the INPUT does not lex/parse; nothing was formatted (the parse
//       diagnostics stay readable via `diagCount`/`vcDiagMsg`/…).
//   2 — the round-trip gate tripped: the OUTPUT does not re-parse (a formatter
//       bug) — the caller must keep the original bytes and report loudly.
export function cliFormatNow(src: string): i32 {
  // `srcSetStr`, not a `srcPush(src[i])` loop — the THIRD copy of that loop, and the one
  // that outlived the other two by a full gate cycle: `vl check` was already correct while
  // `vl fmt` still re-encoded every non-ASCII character in the file it was formatting
  // (`—` came back as `â\u{80}\u{94}`). `scripts/lint-self.sh` caught it as "not formatted"
  // on 26 files at once, which is the only reason it was not shipped. Three writings of one
  // fact, and the third had no reason to exist: see `driver.srcSetStr`.
  srcReset()
  srcSetStr(src)
  const len = formatSrc()
  if len == -2 { return 2 }
  if len < 0 { return 1 }
  0
}
