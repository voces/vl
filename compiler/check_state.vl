// `check_state.vl` — the type-checker's LSP-query state: symbol-occurrence
// tables (`symOcc*`), redundant-annotation and dead-`??` findings, inlay hints,
// member and UFCS completion buffers, signature-help columns. A declarations-only
// leaf — the checker writes these, `check_query.vl` reads them.

// ── LSP symbol table (occurrences + binding types) ───────────────────────────

// Off by default (`symEnabled == 0`), and read only by the driver's query exports,
// so filling these cannot change `emitProgram`'s output. A binding is its declaring
// node index; an occurrence is one identifier appearance. `symDeclScope` pushes and
// pops in lockstep with `T.scopes`, so a use resolves to the binding the checker did.
export let symEnabled = 0
export let symOccTok: i32[] = []
export let symOccDecl: i32[] = []
export let symOccIsDecl: i32[] = []
// Parallel to `symOccTok`: the flow-narrowed type-arena index in force at this
// occurrence, or -1 when the binding's retained type is the answer. Per-occurrence
// because narrowing is flow-sensitive while `symBindType` holds one type per binding.
// Filled only under a live narrowing shadow; an ordinary use and a declaration store -1.
export let symOccTy: i32[] = []
// Find-references' result column: the occurrence indices of the binding under one
// cursor, in occurrence order. `symRefCursorLine`/`Col` is the cursor it answers for,
// -1 when unfilled — so the k-th result is an array read rather than a table scan, and
// a query at another cursor refills. Reset with the occurrence table it indexes.
export let symRefOcc: i32[] = []
export let symRefCursorLine = -1
export let symRefCursorCol = -1
export let symBindNode: i32[] = []
export let symBindType: i32[] = []
// Parallel to `symBindNode`: each binding's kind, for semantic-token coloring —
// 0 = variable, 1 = parameter, 2 = function. Types and properties are not recorded
// as bindings, so they never appear here. Read by occurrence via `symBindKindOf`.
export let symBindKind: i32[] = []
// Member-access node types for hover (`o.x` / `o?.y`): the property-name span
// (1-based line, 0-based `[col, endCol)`) and the resolved member type, keyed by the
// member node. That node's `nodeToks` entry is the property token, so the span pins
// the `.member` half rather than the receiver.
export let symMemNode: i32[] = []
export let symMemTy: i32[] = []
export let symMemLine: i32[] = []
export let symMemCol: i32[] = []
export let symMemEndCol: i32[] = []
// Scope-at-position (completion): every binding `symDecl` records also stamps the
// `[start, stop]` source span of the lexical scope it is visible in. `symVisKind` is
// 0 = variable, 1 = parameter, 2 = function. `symScopeAt` keeps the tightest-scoped
// binding per name; builtins, imports and types are the host's half, not recorded.
export let symVisName: string[] = []
export let symVisNode: i32[] = []
export let symVisKind: i32[] = []
export let symVisSL: i32[] = []
export let symVisSC: i32[] = []
export let symVisEL: i32[] = []
export let symVisEC: i32[] = []
// The last `symScopeAt` result, as parallel per-binding arrays the driver reads by
// index, so a name read and a type read for one index never clobber each other.
// `scopeResRaw` keeps the undemangled merge name and `scopeResTok` the decl-name
// token, which is how the driver drops a dep module's bindings from a merged program.
export let scopeResName: string[] = []
export let scopeResKind: i32[] = []
export let scopeResType: string[] = []
export let scopeResRaw: string[] = []
export let scopeResTok: i32[] = []
// ── Inlay hints (LSP): the inferred type at an UNANNOTATED declaration ─────────

// The inferred type at an unannotated declaration. Kind 0 is a value binding — its
// type, anchored at the name end; kind 1 is a function — its return type. The host
// keeps the source-scan filters it owns (skip an annotation the user wrote, honor the
// request range). A type still an inference hole or an error placeholder is skipped.
export let inlayKind: i32[] = []
export let inlayLine: i32[] = []
export let inlayCol: i32[] = []
export let inlayType: string[] = []
// The occurrence index each hint came from, so the driver can map the hint back to
// its owning module (`symOccModuleAt`). A multi-module compile records hints for
// every module, each with module-local line and col that would otherwise render
// against the entry.
export let inlayOcc: i32[] = []
// ── Redundant explicit type annotations (lint: lean on inference) ───────────────

// A `let x: T = init` whose annotation is exactly the type inference gives the
// initializer on its own: removing `: T` yields the identical type. The `LetDecl` arm
// types the init before consulting the annotation, so both are in hand there. A hole,
// error or `never` init is skipped, and an empty-collection init never renders equal.
export let redunSLine: i32[] = []   // replace-span start (just after the name) — line
export let redunSCol: i32[] = []    //                                          — col
export let redunELine: i32[] = []   // replace-span end (the initializer start) — line
export let redunECol: i32[] = []    //                                          — col
export let redunName: string[] = [] // the binding name (for the message)
export let redunType: string[] = [] // the inferred type (for the message)
export let redunTok: i32[] = []     // the name token — its module is the finding's owner.
// ── Dead `??` defaults (a `??` whose left operand can never be null) ────────────

// `x ?? d` over a left operand whose type admits no `null` yields `x` for every input,
// so the default is unreachable. The emitter folds the node away (`emit_rewrite.vl`)
// and the program runs, which is why this channel exists to say so. Positions are the
// `??` node's anchor; `rcoalTok` names the owning module.
export let rcoalLine: i32[] = []    // 1-based line of the `??` node's anchor token
export let rcoalCol: i32[] = []     // 0-based column
export let rcoalTok: i32[] = []     // the anchor token — its module owns the finding
export let rcoalType: string[] = [] // the left operand's rendered type (for the message)
// ── `is <literal>` over an operand whose union collapsed ─────────────────────

// A subsumed literal arm collapses, so `string | "err"` is the type `string` and an
// `is "err"` downstream compares against ordinary data. It fires only where a collapse
// is recorded for the operand's binding (`collBindName` in typecheck.vl), never off
// the operand's type, which after the collapse is indistinguishable from a `string`.
export let isvalLine: i32[] = []    // 1-based line of the `is` node's anchor token
export let isvalCol: i32[] = []     // 0-based column
export let isvalTok: i32[] = []     // the anchor token — its module owns the finding
export let isvalName: string[] = [] // the operand binding's name (for the message)
export let isvalType: string[] = [] // the operand's rendered COLLAPSED type
export let isvalLit: string[] = []  // the tested literal spelling, as written
// The `symMemTy` sentinel for a method-call callee whose member name is recorded for
// semantic tokens but whose type is not. Distinct from -1 (unresolved) so
// `symMemberIsMethod` can tell a recorded method apart while `symMemTypeStrAt` still
// treats it as un-typed.
export const SYM_MEM_METHOD = -2
// ── Member completion (LSP): the members of the receiver type under the cursor ──

// `symMemberScanAt(line, col)` resolves the binding under the cursor, reads its
// retained type, softens a nullable, and records each completable member: a `TyObj`'s
// identifier-named fields, or a `string`'s builtin methods. The results land in the
// `memc*` arrays. Arrays and maps expose no members here, matching the host.
export let memcName: string[] = []
export let memcType: string[] = []
export let memcIsFn: i32[] = []
// ── UFCS candidates (LSP): the free `self`-functions a receiver dispatches to ──

// The other half of what `x.` can offer, and the half no field scan sees: `x.f(a)`
// resolves against a free `function f(self: T, …)` whose name is in scope, so an
// un-imported one reports `no field 'f' on T` (D1230). The set is every `self`-function
// declared in the merged program, in scope or not; `ufcTok` is the decl-name token.
export let ufcName: string[] = []
export let ufcDetail: string[] = []
export let ufcTok: i32[] = []
export let ufcExported: i32[] = []
// ── Signature help (LSP): the callee's parameters as data ────────────────────

// The structural counterpart of `fnSigStr`'s rendered string: the columns a host
// would otherwise recover by parsing VL's type grammar. Filled by `symSigAt` at the
// callee name; a UFCS member call drops its `self` row, so argument index N is
// parameter index N at both spellings. `sigParName[i]`/`sigParDefault[i]` are "" when none.
export let sigParName: string[] = []
export let sigParType: string[] = []
export let sigParDefault: string[] = []
export let sigRet: string = ""
