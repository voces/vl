// `check_state.vl` — the type-checker's LSP-query state: symbol-occurrence
// tables (`symOcc*`), redundant-annotation and dead-`??` findings, inlay hints,
// member and UFCS completion buffers, signature-help columns. A declarations-only
// leaf — the checker writes these, `check_query.vl` reads them.

// ── LSP symbol table (occurrences + binding types) ───────────────────────────

// Off by default (`symEnabled == 0`), and read only by the driver's query exports,
// so filling these cannot change `emitProgram`'s output. A binding is its declaring
// node index; an occurrence is one identifier appearance. `symDeclScope` pushes and
// pops in lockstep with `T.frames`, so a use resolves to the binding the checker did.
export let symEnabled = 0
export let symOccTok: i32[] = []
export let symOccDecl: i32[] = []
export let symOccIsDecl: i32[] = []
// Parallel to `symOccTok`: the flow-narrowed type-arena index in force at this
// occurrence, or -1 when the binding's retained type is the answer. Per-occurrence
// because narrowing is flow-sensitive while `symBindType` holds one type per binding.
// Filled only under a live narrowing shadow; an ordinary use and a declaration store -1.
export let symOccTy: i32[] = []
// Find-references' result column: the occurrence indices of the binding under one
// cursor, in occurrence order. `symRefCursorLine`/`Col` is the cursor it answers for,
// -1 when unfilled — so the k-th result is an array read rather than a table scan, and
// a query at another cursor refills. Reset with the occurrence table it indexes.
export let symRefOcc: i32[] = []
export let symRefCursorLine = -1
export let symRefCursorCol = -1
export let symBindNode: i32[] = []
export let symBindType: i32[] = []
// Parallel to `symBindNode`: each binding's kind, for semantic-token coloring —
// 0 = variable, 1 = parameter, 2 = function. Types and properties are not recorded
// as bindings, so they never appear here. Read by occurrence via `symBindKindOf`.
export let symBindKind: i32[] = []
// Member-access node types for hover (`o.x` / `o?.y`): the property-name span
// (1-based line, 0-based `[col, endCol)`) and the resolved member type, keyed by the
// member node. That node's `nodeToks` entry is the property token, so the span pins
// the `.member` half rather than the receiver.
export let symMemNode: i32[] = []
export let symMemTy: i32[] = []
export let symMemLine: i32[] = []
export let symMemCol: i32[] = []
export let symMemEndCol: i32[] = []
// The member nodes among `symMemNode` that read a getter, so an editor can mark the property
// token as computed rather than stored.
export let symMemGetter: i32[] = []
// Parallel to `symMemGetter`: the getter's `FuncDecl` node, go-to-definition's target.
export let symMemGetterDecl: i32[] = []
// Scope-at-position (completion): every binding `symDecl` records also stamps the
// `[start, stop]` source span of the lexical scope it is visible in. `symVisKind` is
// 0 = variable, 1 = parameter, 2 = function. `symScopeAt` keeps the tightest-scoped
// binding per name; builtins, imports and types are the host's half, not recorded.
export let symVisName: string[] = []
export let symVisNode: i32[] = []
export let symVisKind: i32[] = []
export let symVisSL: i32[] = []
export let symVisSC: i32[] = []
export let symVisEL: i32[] = []
export let symVisEC: i32[] = []
// The last `symScopeAt` result, as parallel per-binding arrays the driver reads by
// index, so a name read and a type read for one index never clobber each other.
// `scopeResRaw` keeps the undemangled merge name and `scopeResTok` the decl-name
// token, which is how the driver drops a dep module's bindings from a merged program.
export let scopeResName: string[] = []
export let scopeResKind: i32[] = []
export let scopeResType: string[] = []
export let scopeResRaw: string[] = []
export let scopeResTok: i32[] = []
// The binding's exact-constant fields (`cqConstFields`), "" for any other binding.
export let scopeResConst: string[] = []
// ── Inlay hints (LSP): the inferred type at an UNANNOTATED declaration ─────────

// The inferred type at an unannotated declaration. Kind 0 is a value binding — its
// type, anchored at the name end; kind 1 is a function — its return type. The host
// keeps the source-scan filters it owns (skip an annotation the user wrote, honor the
// request range). A type still an inference hole or an error placeholder is skipped.
type InlayCols = {
  kind: i32[],
  line: i32[], // module-local, like `col`: `occ` names the module
  col: i32[],
  ty: string[],
  occ: i32[],  // the hint's occurrence, mapped to its module by `symOccModuleAt`
}
export const inlay: InlayCols = { kind: [], line: [], col: [], ty: [], occ: [] }
// ── Redundant explicit type annotations (lint: lean on inference) ───────────────

// A `let x: T = init` whose annotation is exactly the type inference gives the
// initializer on its own: removing `: T` yields the identical type. The `LetDecl` arm
// types the init before consulting the annotation, so both are in hand there. A hole,
// error or `never` init is skipped, and an empty-collection init never renders equal.
type RedunCols = {
  sLine: i32[],   // replace-span start (just after the name) — line
  sCol: i32[],    //                                          — col
  eLine: i32[],   // replace-span end (the initializer start) — line
  eCol: i32[],    //                                          — col
  name: string[], // the binding name (for the message)
  ty: string[],   // the inferred type (for the message)
  tok: i32[],     // the name token — its module is the finding's owner.
  ret: boolean[], // a function's return annotation, not a binding's
}
export const redun: RedunCols = {
  sLine: [],
  sCol: [],
  eLine: [],
  eCol: [],
  name: [],
  ty: [],
  tok: [],
  ret: [],
}
// The rows a check with errors withholds (`pinHintReport`), kept for a module whose own check
// has none; `redunHeldSwap` trades them with the reported rows.
export const redunHeld: RedunCols = {
  sLine: [],
  sCol: [],
  eLine: [],
  eCol: [],
  name: [],
  ty: [],
  tok: [],
  ret: [],
}
// ── Dead `??` defaults (a `??` whose left operand can never be null) ────────────

// `x ?? d` over a left operand whose type admits no `null` yields `x` for every input,
// so the default is unreachable; the emitter folds the node away (`emit_rewrite.vl`), so
// only this channel says so. The span is the `??` NODE's, clamped to its first line. A dead
// null test (`x == null` over a value proved non-null) and a deep record `==` share it.
type RcoalCols = {
  line: i32[],    // 1-based line of the `??` node's first token
  col: i32[],     // 0-based start column
  end: i32[],     // 0-based exclusive end column, on `line`
  tok: i32[],     // the anchor token — its module owns the finding
  ty: string[],   // the left operand's rendered type (for the message)
  msg: string[],  // the whole message; "" marks a dead `??` default
  why: string[],  // the narrowing fact proving the operand non-null, "" when its type does
  code: string[], // the finding's lint code
}
export const rcoal: RcoalCols = {
  line: [],
  col: [],
  end: [],
  tok: [],
  ty: [],
  msg: [],
  why: [],
  code: [],
}
// ── `is <literal>` over an operand whose union collapsed ─────────────────────

// A subsumed literal arm collapses, so `string | "err"` is the type `string` and an
// `is "err"` downstream compares against ordinary data. It fires only where a collapse
// is recorded for the operand's binding (`collBindName` in typecheck.vl), never off
// the operand's type, which after the collapse is indistinguishable from a `string`.
export let isvalLine: i32[] = []    // 1-based line of the `is` node's first token
export let isvalCol: i32[] = []     // 0-based start column
export let isvalEnd: i32[] = []     // 0-based exclusive end column, on `isvalLine`
export let isvalTok: i32[] = []     // the anchor token — its module owns the finding
export let isvalName: string[] = [] // the operand binding's name (for the message)
export let isvalType: string[] = [] // the operand's rendered COLLAPSED type
export let isvalLit: string[] = []  // the tested literal spelling, as written
export let isvalMsg: string[] = []  // a contained-arm finding's own message, "" for a collapse
// ── An uncalled entry export's parameter inferred from its body (D3817) ──────
// The annotated bindings whose annotation pinned such a parameter: never redundant.
export let expInfPinLets: i32[] = []
// The `symMemTy` sentinel for a method-call callee whose member name is recorded for
// semantic tokens but whose type is not. Distinct from -1 (unresolved) so
// `symMemberIsMethod` can tell a recorded method apart while `symMemTypeStrAt` still
// treats it as un-typed.
export const SYM_MEM_METHOD = -2
// ── Type-name completion (LSP) ───────────────────────────────────────────────

// The `type` NAMES offerable at the cursor: `tsc.name` the spelling, `tsc.detail` its
// rendered body (empty when the checker has no entry under that spelling — an IMPORTED
// type is one), `tsc.tok` the declaring name token, which is what carries its `///`.
type TscCols = { name: string[], detail: string[], tok: i32[] }
export const tsc: TscCols = { name: [], detail: [], tok: [] }

// ── Doc comments (LSP hover) ─────────────────────────────────────────────────

// Every retained `///` comment that stands on a line of its own, in source order:
// `docCmtLine` is its 1-based line, `docCmtText` the verbatim lexeme (`///` included),
// `docCmtMod` its owning module. A `//` comment is not recorded, which is the whole
// difference between the two spellings for `symDocAt`, which owns the presentation.
export let docCmtLine: i32[] = []
export let docCmtText: string[] = []
export let docCmtMod: i32[] = []

// ── Member completion (LSP): the members of the receiver type under the cursor ──

// `symMemberScanAt(line, col)` resolves the binding under the cursor, reads its
// retained type, softens a nullable, and records each completable member: a `TyObj`'s
// identifier-named fields, or a `string`'s builtin methods. The results land in the
// `memc` columns. Arrays and maps expose no members here, matching the host.
type MemcCols = {
  name: string[],
  ty: string[],
  isFn: i32[],
  tok: i32[],      // the declaring name token; -1 for a builtin or an unnamed receiver type
  isGetter: i32[], // 1 for a computed, read-only property
}
export const memc: MemcCols = {
  name: [],
  ty: [],
  isFn: [],
  tok: [],
  isGetter: [],
}
// ── UFCS candidates (LSP): the free `self`-functions a receiver dispatches to ──

// The other half of what `x.` can offer, and the half no field scan sees: `x.f(a)`
// resolves against a free `function f(self: T, …)` whose name is in scope, so an
// un-imported one reports `no field 'f' on T` (D1230). The set is every `self`-function
// declared in the merged program, in scope or not; `ufc.tok` is the decl-name token.
type UfcCols = {
  name: string[],
  detail: string[],
  tok: i32[],
  exported: i32[],
}
export const ufc: UfcCols = { name: [], detail: [], tok: [], exported: [] }
// ── Signature help (LSP): the callee's parameters as data ────────────────────

// The structural counterpart of `fnSigStr`'s rendered string: the columns a host
// would otherwise recover by parsing VL's type grammar. Filled by `symSigAt` at the
// callee name; a UFCS member call drops its `self` row, so argument index N is
// parameter index N at both spellings. `sigPar.name[i]`/`sigPar.dflt[i]` are "" when none.
type SigParCols = { name: string[], ty: string[], dflt: string[] }
export const sigPar: SigParCols = { name: [], ty: [], dflt: [] }
export let sigRet: string = ""

export function rcoalTruncate(n: i32) {
  while rcoal.line.length > n { rcoal.line.pop() }
  while rcoal.col.length > n { rcoal.col.pop() }
  while rcoal.end.length > n { rcoal.end.pop() }
  while rcoal.tok.length > n { rcoal.tok.pop() }
  while rcoal.ty.length > n { rcoal.ty.pop() }
  while rcoal.msg.length > n { rcoal.msg.pop() }
  while rcoal.why.length > n { rcoal.why.pop() }
  while rcoal.code.length > n { rcoal.code.pop() }
  0
}

export function isvalTruncate(n: i32) {
  while isvalLine.length > n { isvalLine.pop() }
  while isvalCol.length > n { isvalCol.pop() }
  while isvalEnd.length > n { isvalEnd.pop() }
  while isvalTok.length > n { isvalTok.pop() }
  while isvalName.length > n { isvalName.pop() }
  while isvalType.length > n { isvalType.pop() }
  while isvalLit.length > n { isvalLit.pop() }
  while isvalMsg.length > n { isvalMsg.pop() }
  0
}

export function redunTruncate(n: i32) {
  while redun.sLine.length > n { redun.sLine.pop() }
  while redun.sCol.length > n { redun.sCol.pop() }
  while redun.eLine.length > n { redun.eLine.pop() }
  while redun.eCol.length > n { redun.eCol.pop() }
  while redun.name.length > n { redun.name.pop() }
  while redun.ty.length > n { redun.ty.pop() }
  while redun.tok.length > n { redun.tok.pop() }
  while redun.ret.length > n { redun.ret.pop() }
  0
}

// Move every reported row to the withheld ones.
export function redunWithhold() {
  let i = 0
  while i < redun.name.length {
    redunHeld.sLine.push(redun.sLine[i])
    redunHeld.sCol.push(redun.sCol[i])
    redunHeld.eLine.push(redun.eLine[i])
    redunHeld.eCol.push(redun.eCol[i])
    redunHeld.name.push(redun.name[i])
    redunHeld.ty.push(redun.ty[i])
    redunHeld.tok.push(redun.tok[i])
    redunHeld.ret.push(redun.ret[i])
    i = i + 1
  }
  redunTruncate(0)
}

// Trade the reported rows with the withheld ones, around a read of a module whose own check
// would report them.
export function redunHeldSwap() {
  const a = redun.sLine
  redun.sLine = redunHeld.sLine
  redunHeld.sLine = a
  const b = redun.sCol
  redun.sCol = redunHeld.sCol
  redunHeld.sCol = b
  const c = redun.eLine
  redun.eLine = redunHeld.eLine
  redunHeld.eLine = c
  const d = redun.eCol
  redun.eCol = redunHeld.eCol
  redunHeld.eCol = d
  const e = redun.name
  redun.name = redunHeld.name
  redunHeld.name = e
  const f = redun.ty
  redun.ty = redunHeld.ty
  redunHeld.ty = f
  const g = redun.tok
  redun.tok = redunHeld.tok
  redunHeld.tok = g
  const h = redun.ret
  redun.ret = redunHeld.ret
  redunHeld.ret = h
  0
}
