// The syntax half of the record covariance write check (D2060): the widened-slot entries a
// covariant delivery records and how a path re-roots under a handle, which values are fresh
// (no other handle can see their slots), how a collection method treats its receiver's
// elements, every call that may reach a function, and the short renderings a refusal names.
// The checker records the slots and asks the questions; nothing here reads a type, the scope
// chain or the checker's diagnostics.
// This module imports `./ast`, `./check_places`, `./check_write_scan`, `./check_suggest`,
// `./check_capture_loss` and `./srcmap`.
import {
  ArrayLit,
  BinExpr,
  BoolLit,
  Call,
  CharLit,
  FieldInit,
  ForIn,
  ForRange,
  FuncDecl,
  Ident,
  IfStmt,
  Index,
  LetDecl,
  MatchExpr,
  Member,
  NullLit,
  NumLit,
  ObjLit,
  P,
  Param,
  RetStmt,
  StrLit,
  TypeRef,
  WhileStmt,
  i32ToStr,
  nodeAt,
  nodeChildren,
  nodeToks,
} from "./ast"
import { keyHasPrefix, placeKeyOf } from "./check_places"
import {
  CM_READS,
  CM_REMOVES,
  CM_REMOVES_ONE,
  CM_RETURNS,
  CM_STORES,
  CW_FR_UNKNOWN,
  CW_OCC_BIND,
  CW_OCC_CALL,
  CW_OCC_USE,
  CW_UP_CALLEE,
  CW_UP_LETINIT,
  collMethodKind,
  cwBoundOnce,
  cwCalleeDeclOf,
  cwFnTailStmt,
  cwFrameOfUse,
  cwIxKind,
  cwIxNode,
  cwIxUp,
  cwIxUpKind,
  cwKeyOfDecl,
  cwKeyOfRoot,
  cwKeySame,
  cwMethodCalls,
  cwOccNext,
  cwOccWalk,
  cwOccWalkSpelled,
  cwOccWalkUse,
  cwPeel,
  cwSelfDeclsNamed,
  cwUfcsDeclOf,
  rcwBlockTail,
} from "./check_write_scan"
import { demangleName } from "./check_suggest"
import { nodeLineOf } from "./check_capture_loss"
import { srcmapModOfTok, srcmapPathOf } from "./srcmap"
import { T, TyErr, TyObj, TyUnion, tyAt, tyToStr } from "./check_types"
import { tyHasTyVar } from "./tyquery"
import { containerElemClassDiffers, covarNonNullArms } from "./check_ty_relate"
import { isIdPart } from "./lexer"

// A widened slot entry carries the SOURCE's own type at that slot, `<path>=<ty>`, so a write of a
// value the source's field already accepts is told apart from one it does not.
export function rcwTyped(path: string, ty: i32): string {
  path + "=" + i32ToStr(ty)
}

// The path part of a slot entry, its `=<ty>` suffix dropped.
export function rcwPathOf(c: string): string {
  let i = 0
  while i < c.length {
    if c[i] == '=' { return c.slice(0, i) }
    i = i + 1
  }
  c
}

// The source type a slot entry carries, or -1 for an entry with none (a `*` entry).
export function rcwTyOf(c: string): i32 {
  let i = 0
  let at = -1
  while i < c.length {
    if c[i] == '=' { at = i + 1 }
    i = i + 1
  }
  if at < 0 || at >= c.length { return -1 }
  let v = 0
  i = at
  while i < c.length {
    const d = c[i] - '0'
    if c[i] == '!' { return v }
    if d < 0 || d > 9 { return -1 }
    v = v * 10 + d
    i = i + 1
  }
  v
}

// Where the next segment of `path` starts at or after `i`, or `path.length`.
function rcwSegEnd(path: string, i: i32): i32 {
  let j = i + 1
  while j < path.length {
    if path[j] == '.' || path[j] == '[' || path[j] == '*' { return j }
    j = j + 1
  }
  path.length
}

// Whether `s` begins with `pfx` at a segment boundary and is longer than it.
export function rcwStrictlyUnder(s: string, pfx: string): boolean {
  if s.length <= pfx.length { return false }
  if !keyHasPrefix(s, pfx) { return false }
  const c = s[pfx.length]
  c == '.' || c == '['
}

// The source type of the slot the value `val` is read from, when it is a place rooted at the
// handle `root` (a binding never reassigned) or a `const` bound once to such a place; else -1.
// A widened slot of the source only ever holds its source type, since every other store into
// it is refused, so the value read has that type whatever the wider slot declares.
export function rcwSourceSlotTy(
  val: i32,
  root: i32,
  covs: string[],
  depth: i32,
): i32 {
  if root < 0 || depth > 2 { return -1 }
  const v = cwPeel(val)
  if v < 0 || v >= P.nodes.length { return -1 }
  const rn = nodeAt(root)
  if rn is Ident {
    const rk = cwKeyOfRoot(root)
    const vn = nodeAt(v)
    if vn is Ident {
      if vn.identName == rn.identName { return -1 }
      if !cwBoundOnce(cwOccWalkUse(v)) { return -1 }
      const init = rcwConstInit(cwKeyOfRoot(v))
      if init < 0 { return -1 }
      return rcwSourceSlotTy(init, root, covs, depth + 1)
    }
    const key = placeKeyOf(v)
    if key == "" || !keyHasPrefix(key, rn.identName + ".") { return -1 }
    const head = cwPeel(rcwPlaceRoot(v))
    if head < 0 || head >= P.nodes.length || cwKeyOfRoot(head) != rk {
      return -1
    }
    if !cwBoundOnce(cwOccWalkUse(root)) { return -1 }
    const sub = key.slice(rn.identName.length, key.length)
    let i = 0
    while i < covs.length {
      if rcwPathOf(covs[i]) == sub && !rcwMixed(covs[i]) {
        return rcwTyOf(covs[i])
      }
      i = i + 1
    }
  }
  -1
}

// The identifier a member chain `a.b.c` roots at, or -1.
function rcwPlaceRoot(ix: i32): i32 {
  let cur = cwPeel(ix)
  let steps = 0
  while cur >= 0 && cur < P.nodes.length && steps < 64 {
    const n = nodeAt(cur)
    if n is Ident { return cur }
    if n is Member { cur = cwPeel(n.memObj) } else { return -1 }
    steps = steps + 1
  }
  -1
}

// The initializer of the `const` binding keyed `k` (`cwKeyOfRoot`), or -1.
function rcwConstInit(k: i32): i32 {
  if k == -1 { return -1 }
  const ow = cwOccWalk(k)
  while cwOccNext(ow) {
    const r = ow.row
    if cwIxKind[r] == CW_OCC_BIND {
      const b = nodeAt(cwIxNode[r])
      if b is LetDecl {
        if b.letKw == "const" { return b.letInit }
      }
      return -1
    }
  }
  -1
}

// The identifier node `v` is, when the handle a climb starts from is a bare name, else -1.
export function rcwRootIdent(v: i32): i32 {
  const p = cwPeel(v)
  if p < 0 || p >= P.nodes.length { return -1 }
  if nodeAt(p) is Ident { return p }
  -1
}

// The value a storing collection call writes: its last argument, or -1 when it has none.
export function rcwStoredArg(call: i32): i32 {
  const cn = nodeAt(call)
  if cn is Call {
    if cn.callArgs.length > 0 { return cn.callArgs[cn.callArgs.length - 1] }
  }
  -1
}

// The widened slots strictly below `at`, re-rooted at it: what a handle to the value at `at`
// could still write. A plain widened slot AT `at` contributes nothing — its value is a legal
// member of the wider type, and only a store into the slot itself is the hazard.
export function rcwUnder(covs: string[], at: string): string[] {
  const out: string[] = []
  let i = 0
  while i < covs.length {
    const c = covs[i]
    const deep = c.length > 0 && c[c.length - 1] == '*'
    let base = c
    if deep { base = c.slice(0, c.length - 1) }
    if at == "" {
      out.push(c)
    } else if rcwStrictlyUnder(base, at) {
      out.push(c.slice(at.length, c.length))
    } else if deep && (base == at || base == "" || rcwStrictlyUnder(at, base)) {
      out.push("*")
    }
    i = i + 1
  }
  out
}

// Every path of `covs` under the segment run `pfx`.
// `uniform` false marks each typed entry `!`: the prefixed slot also holds values that did not
// come from the source (another list element, an earlier store), which parametricity must not
// read as the source's own.
export function rcwPrefix(
  pfx: string,
  covs: string[],
  uniform: boolean,
): string[] {
  const out: string[] = []
  let i = 0
  while i < covs.length {
    const c = covs[i]
    if (
      uniform
      || c.length == 0
      || c[c.length - 1] == '*'
      || c[c.length - 1] == '!'
    ) {
      out.push(pfx + c)
    } else {
      out.push(pfx + c + "!")
    }
    i = i + 1
  }
  out
}

// Whether a typed slot entry also holds values from outside the source (see `rcwPrefix`).
export function rcwMixed(c: string): boolean {
  c.length > 0 && c[c.length - 1] == '!'
}

// The expressions whose value an expression IS: itself, or each operand of a `??`, or each
// arm's tail of an `if` used as a value. A worklist, so a long `else if` chain costs no stack.
function rcwBranches(ix: i32, out: i32[]) {
  const todo: i32[] = [ix]
  while todo.length > 0 {
    const p = cwPeel(todo.pop() ?? -1)
    if p >= 0 && p < P.nodes.length {
      if (
        !rcwPushIfArms(p, todo)
        && !rcwPushCoalOperands(p, todo)
        && !rcwPushMatchArms(p, todo)
      ) {
        out.push(p)
      }
    }
  }
  0
}

// When `p` is an `if` used as a value, queue its arms' tails (an `else if` link as itself).
function rcwPushIfArms(p: i32, todo: i32[]): boolean {
  const n = nodeAt(p)
  if n is IfStmt {
    todo.push(rcwBlockTail(n.ifThen))
    const el = n.ifElse
    if el >= 0 && el < P.nodes.length {
      if nodeAt(el) is IfStmt {
        todo.push(el)
      } else {
        todo.push(rcwBlockTail(el))
      }
    }
    return true
  }
  false
}

// When `p` is a `match` used as a value, queue each arm's tail.
function rcwPushMatchArms(p: i32, todo: i32[]): boolean {
  const n = nodeAt(p)
  if n is MatchExpr {
    let i = 0
    while i < n.matchBodies.length {
      todo.push(rcwBlockTail(n.matchBodies[i]))
      i = i + 1
    }
    return true
  }
  false
}

// When `p` is `a ?? b`, queue both operands: the value is one of them.
function rcwPushCoalOperands(p: i32, todo: i32[]): boolean {
  const n = nodeAt(p)
  if n is BinExpr {
    if n.binOp == "??" {
      todo.push(n.binLeft)
      todo.push(n.binRight)
      return true
    }
  }
  false
}

// A leaf that holds no slot any other handle can see: a scalar literal, a statement that is
// not a value, or an empty `Map()` / `Set()` just made.
export function rcwLeafVacuous(p: i32): boolean {
  const n = nodeAt(p)
  if (
    n is NumLit
    || n is StrLit
    || n is CharLit
    || n is BoolLit
    || n is NullLit
  ) {
    return true
  }
  if (
    n is LetDecl
    || n is RetStmt
    || n is WhileStmt
    || n is ForIn
    || n is ForRange
  ) {
    return true
  }
  // A function value is immutable: it holds no slot a store could go through.
  if n is FuncDecl { return true }
  rcwIsFreshCtor(p)
}

// An empty `Map()` / `Set()` made on the spot, by the builtin rather than a same-named binding.
function rcwIsFreshCtor(p: i32): boolean {
  const n = nodeAt(p)
  if n is Call {
    const cf = nodeAt(cwPeel(n.callFn))
    if cf is Ident {
      if (
        n.callArgs.length == 0
        && (cf.identName == "Map" || cf.identName == "Set")
      ) {
        return cwFrameOfUse(cwPeel(n.callFn)) == CW_FR_UNKNOWN
      }
    }
  }
  false
}
// A value with no identity of its own: every branch a vacuous leaf, or an object or list
// literal whose every part is one. Nothing else can hold a handle on it.
function rcwAllFresh(ix: i32, depth: i32): boolean {
  if depth > 64 { return false }
  const leaves: i32[] = []
  rcwBranches(ix, leaves)
  let li = 0
  while li < leaves.length {
    const p = leaves[li]
    const n = nodeAt(p)
    if n is ObjLit {
      let k = 0
      while k < n.objFields.length {
        const f = nodeAt(n.objFields[k])
        if f is FieldInit {
          if !rcwAllFresh(f.fiValue, depth + 1) { return false }
        } else {
          return false
        }
        k = k + 1
      }
    } else if n is ArrayLit {
      let e = 0
      while e < n.arrElems.length {
        if !rcwAllFresh(n.arrElems[e], depth + 1) { return false }
        e = e + 1
      }
    } else if !rcwLeafVacuous(p) {
      return false
    }
    li = li + 1
  }
  true
}

// Is the widened slot `c` owned by a fresh value at `src`? Then no other handle sees it and
// storing a wider value there is the literal's own business. Walks every segment but the last
// through literal parts, every branch and every element of each.
export function rcwSlotFresh(src: i32, c: string, i: i32, depth: i32): boolean {
  if depth > 64 { return false }
  if c.length > 0 && c[c.length - 1] == '*' { return rcwAllFresh(src, 0) }
  const e = rcwSegEnd(c, i)
  const leaves: i32[] = []
  rcwBranches(src, leaves)
  let li = 0
  while li < leaves.length {
    if !rcwLeafSlotFresh(leaves[li], c, i, e, depth) { return false }
    li = li + 1
  }
  true
}

// One branch of `rcwSlotFresh`: the segment `c[i..e]` taken from the leaf `p`.
function rcwLeafSlotFresh(
  p: i32,
  c: string,
  i: i32,
  e: i32,
  depth: i32,
): boolean {
  if rcwLeafVacuous(p) { return true }
  if rcwCallSlotFresh(p, c, i, depth) { return true }
  // `c[i..]` is the last segment: its owner is the node here, fresh when it is a literal.
  if e >= c.length { return rcwIsLiteralRecord(p) }
  if c[i] == '.' { return rcwFieldSlotFresh(p, c, i, e, depth) }
  rcwElemSlotFresh(p, c, e, depth)
}

// A direct call of a declared function every return of which is fresh at `c[i..]`: each call
// makes its value anew, so no other handle sees the slot either.
function rcwCallSlotFresh(p: i32, c: string, i: i32, depth: i32): boolean {
  const n = nodeAt(p)
  if !(n is Call) || depth > 64 { return false }
  const cf = cwPeel(n.callFn)
  if cf < 0 || !(nodeAt(cf) is Ident) { return false }
  const fx = cwCalleeDeclOf(n.callFn)
  if fx < 0 || fx >= P.nodes.length { return false }
  const fd = nodeAt(fx)
  if !(fd is FuncDecl) || fd.fnBody < 0 { return false }
  const tail = cwFnTailStmt(fx)
  if tail < 0 { return false }
  if !(nodeAt(tail) is RetStmt) && !rcwSlotFresh(tail, c, i, depth + 1) {
    return false
  }
  const stack: i32[] = [fd.fnBody]
  while stack.length > 0 {
    const x = stack.pop()
    if x >= 0 && x < P.nodes.length {
      const xn = nodeAt(x)
      if xn is RetStmt {
        if xn.retArg < 0 || !rcwSlotFresh(xn.retArg, c, i, depth + 1) {
          return false
        }
      } else if !(xn is FuncDecl) {
        for k in nodeChildren(x) { stack.push(k) }
      }
    }
  }
  true
}

// An object or list literal: a value made here, whose slots no other handle has seen.
function rcwIsLiteralRecord(p: i32): boolean {
  const n = nodeAt(p)
  n is ObjLit || n is ArrayLit
}

// The field segment `c[i..e]` of the literal `p`, followed into that field's value.
function rcwFieldSlotFresh(
  p: i32,
  c: string,
  i: i32,
  e: i32,
  depth: i32,
): boolean {
  const n = nodeAt(p)
  if n is ObjLit {
    const name = c.slice(i + 1, e)
    let k = 0
    while k < n.objFields.length {
      const f = nodeAt(n.objFields[k])
      if f is FieldInit {
        if f.fiName == name { return rcwSlotFresh(f.fiValue, c, e, depth + 1) }
      }
      k = k + 1
    }
  }
  false
}

// The element segment of the literal `p`, followed into every element.
function rcwElemSlotFresh(p: i32, c: string, e: i32, depth: i32): boolean {
  const n = nodeAt(p)
  if n is ArrayLit {
    let k = 0
    while k < n.arrElems.length {
      if !rcwSlotFresh(n.arrElems[k], c, e, depth + 1) { return false }
      k = k + 1
    }
    return true
  }
  false
}

// The collection methods by what they do to their receiver's element slots. A storing method
// writes a slot; an element-returning one hands a slot's value back; the read-only ones hand
// back nothing a store could go through. A method in none of the three is not followed.
export function rcwStoresElem(m: string): boolean {
  collMethodKind(m) == CM_STORES
}
export function rcwReturnsElem(m: string): boolean {
  const k = collMethodKind(m)
  k == CM_RETURNS || k == CM_REMOVES_ONE
}
export function rcwReadsOnly(m: string): boolean {
  const k = collMethodKind(m)
  k == CM_READS || k == CM_REMOVES
}

// The collection methods whose result is a list of the receiver's own elements.
export function rcwSameElems(m: string): boolean {
  m == "filter" || m == "slice" || m == "values"
}

// The `self`-functions a method spelling `.prop(…)` at `callee` may reach: the one the scope
// resolves, and every declaration whose name, merge suffix stripped, is `prop` and whose first
// parameter is `self`.
export function rcwSelfDeclsOf(prop: string, callee: i32): i32[] {
  const out: i32[] = []
  const d0 = cwUfcsDeclOf(callee)
  if d0 >= 0 { out.push(d0) }
  const named: i32[] = []
  cwSelfDeclsNamed(prop, named)
  for d in named {
    if d != d0 { out.push(d) }
  }
  out
}

// Whether the `FuncDecl` at `d` takes `self` first.
function rcwFirstParamIsSelf(d: i32): boolean {
  const fd = nodeAt(d)
  if fd is FuncDecl {
    if fd.fnParams.length == 0 { return false }
    const p0 = nodeAt(fd.fnParams[0])
    if p0 is Param { return p0.parName == "self" }
  }
  false
}

// The name of parameter `k` of `fnIx`, or "?".
export function rcwParamNameOf(fnIx: i32, k: i32): string {
  const fd = nodeAt(fnIx)
  if fd is FuncDecl {
    if k >= 0 && k < fd.fnParams.length {
      const pn = nodeAt(fd.fnParams[k])
      if pn is Param { return pn.parName }
    }
  }
  "?"
}

// The position of the parameter named `nm` in the function `fnIx`, or -1.
export function rcwParamIndexOf(fnIx: i32, nm: string): i32 {
  const fd = nodeAt(fnIx)
  if fd is FuncDecl {
    let i = 0
    while i < fd.fnParams.length {
      const pn = nodeAt(fd.fnParams[i])
      if pn is Param {
        if pn.parName == nm { return i }
      }
      i = i + 1
    }
  }
  -1
}

// A function's name for a message: its declared name, the `const` a lambda is bound to, or
// "a function literal".
export function rcwFnLabel(fnIx: i32): string {
  const fd = nodeAt(fnIx)
  if fd is FuncDecl {
    if fd.fnName != "" { return demangleName(fd.fnName) }
    if fnIx < cwIxUpKind.length && cwIxUpKind[fnIx] == CW_UP_LETINIT {
      const ld = nodeAt(cwIxUp[fnIx])
      if ld is LetDecl { return ld.letName }
    }
  }
  "a function literal"
}

// Every call that may reach the function `fnIx`, pushed as the call node times two plus 1 for a
// method spelling (`recv.f(…)`, receiver at parameter 0). Answers -1, or the node of a use the
// calls cannot be enumerated past: a lambda bound to nothing, or the function read as a value.
export function rcwCallSites(fnIx: i32, out: i32[]): i32 {
  if fnIx < 0 || fnIx >= P.nodes.length { return fnIx }
  const fd = nodeAt(fnIx)
  if fd is FuncDecl {
    let nm = fd.fnName
    let decl = fnIx
    if nm == "" {
      if fnIx >= cwIxUpKind.length || cwIxUpKind[fnIx] != CW_UP_LETINIT {
        return fnIx
      }
      const ld = nodeAt(cwIxUp[fnIx])
      if ld is LetDecl {
        nm = ld.letName
        decl = cwIxUp[fnIx]
      } else {
        return fnIx
      }
    }
    const b1 = rcwNamedCallSites(nm, fnIx, decl, out)
    if b1 >= 0 { return b1 }
    const plain = demangleName(nm)
    if plain != nm {
      const b2 = rcwNamedCallSites(plain, fnIx, decl, out)
      if b2 >= 0 { return b2 }
    }
    if fd.fnName != "" && rcwFirstParamIsSelf(fnIx) {
      const mcalls: i32[] = []
      cwMethodCalls(fnIx, mcalls)
      for occ in mcalls {
        const cn = nodeAt(occ)
        if cn is Call {
          const d = cwUfcsDeclOf(cn.callFn)
          if d < 0 || d == fnIx { out.push(occ * 2 + 1) }
        }
      }
    }
    return -1
  }
  fnIx
}

// The calls spelled `nm(…)` that may reach `fnIx` (one resolving elsewhere is skipped, one
// resolving nowhere kept), or the first read of the declaration `decl` that is not a call:
// `fnIx` itself, or the `const` a lambda is bound to.
function rcwNamedCallSites(nm: string, fnIx: i32, decl: i32, out: i32[]): i32 {
  let k = -1
  if decl != fnIx { k = cwKeyOfDecl(decl) }
  const ow = cwOccWalkSpelled(decl, nm)
  while cwOccNext(ow) {
    const r = ow.row
    const occ = cwIxNode[r]
    if cwIxKind[r] == CW_OCC_CALL {
      const cn = nodeAt(occ)
      if cn is Call {
        const d = cwCalleeDeclOf(cn.callFn)
        if d < 0 || d == fnIx { out.push(occ * 2) }
      }
    } else if (
      cwIxKind[r] == CW_OCC_USE
      && (k == -1 || cwKeySame(cwKeyOfRoot(occ), k))
    ) {
      if occ >= cwIxUpKind.length || cwIxUpKind[occ] != CW_UP_CALLEE {
        return occ
      }
    }
  }
  -1
}

// The slots of one question, as a memo key.
export function rcwKey(covs: string[]): string {
  let s = ""
  let i = 0
  while i < covs.length {
    s = s + covs[i] + ","
    i = i + 1
  }
  s
}

// The `LetDecl` the name use `u` initialises as its whole value (`const b = a`), or -1.
export function rcwPlainAlias(u: i32): i32 {
  if u < 0 || u >= cwIxUpKind.length || cwIxUpKind[u] != CW_UP_LETINIT {
    return -1
  }
  const up = cwIxUp[u]
  if up < 0 || up >= P.nodes.length { return -1 }
  if nodeAt(up) is LetDecl { return up }
  -1
}

// `line N`, with the file named when the node is in a different module from `src`.
export function rcwWhere(at: i32, src: i32): string {
  const ln = "line " + i32ToStr(nodeLineOf(at))
  const m = rcwModOf(at)
  if m >= 0 && m != rcwModOf(src) {
    const f = srcmapPathOf(m)
    if f != "" { return ln + " of " + f }
  }
  ln
}

// The module a node's anchor token belongs to, or -1.
export function rcwModOf(at: i32): i32 {
  if at < 0 || at >= nodeToks.length { return -1 }
  const tk = nodeToks[at]
  if tk < 0 { return -1 }
  srcmapModOfTok(tk)
}

// A call's callee as the source spells it, in backticks.
export function rcwCalleeText(callIx: i32): string {
  const cn = nodeAt(callIx)
  if cn is Call { return "`" + rcwExprText(cn.callFn, 0) + "`" }
  "a call"
}

// A short rendering of an expression for a message: names, member reads, calls and indexes.
export function rcwExprText(ix: i32, depth: i32): string {
  const p = cwPeel(ix)
  if p < 0 || p >= P.nodes.length || depth > 6 { return "an expression" }
  const n = nodeAt(p)
  if n is Ident { return demangleName(n.identName) }
  if n is Member {
    return rcwExprText(n.memObj, depth + 1) + "." + demangleName(n.memProp)
  }
  if n is Index { return rcwExprText(n.idxArr, depth + 1) + "[…]" }
  if n is Call { return rcwExprText(n.callFn, depth + 1) + "(…)" }
  if n is FuncDecl { return "a function literal" }
  "an expression"
}

// How the parameter annotation `ann` spells the type parameter `tp`: 0 not at all, 1 as `tp`,
// 2 as `tp[]`, 3 inside some other type this does not follow.
export function rcwParamSpellsTp(ann: i32, tp: string): i32 {
  if ann < 0 || ann >= P.nodes.length { return 0 }
  const a = nodeAt(ann)
  if a is TypeRef {
    if a.tyName == tp { return 1 }
    if a.tyName == tp + "[]" { return 2 }
    if rcwNameMentions(a.tyName, tp) { return 3 }
  }
  0
}

// Whether the type spelling `s` names `tp` as a whole word.
function rcwNameMentions(s: string, tp: string): boolean {
  let i = 0
  while i + tp.length <= s.length {
    if s.slice(i, i + tp.length) == tp {
      const before = i == 0 || !isIdPart(s[i - 1])
      const after = i + tp.length == s.length || !isIdPart(s[i + tp.length])
      if before && after { return true }
    }
    i = i + 1
  }
  false
}

// Whether a container's element pair changes storage — the pairs the container rule copies
// or refuses (`i32` into `f64`, a literal union into `string`, a record into a boxed union).
export function rcwContainerRuleDomain(se: i32, de: i32): boolean {
  if se < 0 || de < 0 || se >= T.tys.length || de >= T.tys.length {
    return false
  }
  // An element whose storage is not known yet (a type variable) is the container rule's,
  // which asks again at the call that pins it.
  if tyHasTyVar(de) || tyHasTyVar(se) { return true }
  if containerElemClassDiffers(se, de) { return true }
  const dt = tyAt(de)
  if tyAt(se) is TyObj {
    if dt is TyUnion { return covarNonNullArms(dt.uMembers) >= 2 }
  }
  false
}

// Whether `t` mentions a type variable or is an error type: a static type that does not say
// which values it holds.
export function rcwTyUnknown(t: i32): boolean {
  if t < 0 || t >= T.tys.length { return true }
  if tyAt(t) is TyErr { return true }
  tyHasTyVar(t)
}

// What to do instead: declare the source at the destination's type, when that type can be
// written (it names no type variable), else pass a copy or drop the write.
export function rcwFixHint(dstTy: i32): string {
  if tyHasTyVar(dstTy) { return "Pass a fresh copy, or drop the write" }
  "Declare the source as "
    + tyToStr(dstTy)
    + ", pass a fresh copy, or drop the write"
}
