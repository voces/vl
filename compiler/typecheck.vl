// A type-checker for a meaningful subset of VL, written in VL — the stage between the
// parser and the emitter. It consumes the parser's node arena (`P.nodes`) directly: it
// lexes nothing and parses nothing itself. Checker state lives in the global `T`, like
// the parser's `P`; types live in its flat arena (`check_types.vl`).
//
// This module is the node visitor: `checkNode` records each node's type and `checkNodeReal`
// dispatches every kind. The per-kind checkers (`check_operators.vl`, `check_calls.vl`,
// `check_statements.vl` and their neighbours) take the narrowed variant and sit below this
// module, so they recurse through `checkNodeHook`, which `checkProgramPass` installs.

import { identTyOf, narTyAtDepth } from "./check_nar_store"
import { identDepthOf, identFnDeclOf } from "./check_scopes"
